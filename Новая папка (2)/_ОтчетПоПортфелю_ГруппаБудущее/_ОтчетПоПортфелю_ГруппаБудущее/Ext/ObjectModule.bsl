
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчет по портфелю (Группа Будущее)",
		"0.24",
		"",
		Истина);
	
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Функция ПолучитьВыгрузкуСРазделителем(МассивСчетовДУ)
		
	ИмяПредопределенногоВарианта = РаботаСОтчетамиКлиентСервер.ПолучитьИмяПредопределенногоВариантаОтчета(ЭтотОбъект);
			
	Настройки = КомпоновщикНастроек.Настройки;
	Параметры = Настройки.ПараметрыДанных;
	
	Параметры.УстановитьЗначениеПараметра("Период",							НачалоДня(ЭтотОбъект.Период));
	Параметры.УстановитьЗначениеПараметра("Организация", 					ЭтотОбъект.Организация);	
	Параметры.УстановитьЗначениеПараметра("СчетаДоверительногоУправления", 	МассивСчетовДУ);
			
	ПолноеИмяОтчета = ЭтотОбъект.Метаданные().ПолноеИмя();
	СессияСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессиюКомпоновкиСКД(ЭтотОбъект, ПолноеИмяОтчета);	
	
	// Стандартная компоновка отчета	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(ЭтотОбъект.СхемаКомпоновкиДанных,  ЭтотОбъект.КомпоновщикНастроек.ПолучитьНастройки(),,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , , Истина);
	                          
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаРезультата);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);
		
	ТекстРезультата = Новый ТекстовыйДокумент;
	
	НоваяСтрока = "Дата;Признак портфеля;Вид имущества;Номер и дата договора;Наименование фонда;Тип актива;Эмитент / Контрагент;ИНН Контрагента / Эмитента;Рег. номер;ISIN;Краткое наименование инструмента;Полное наименование инструмента;Номинал;Валюта;Количество (без учета РЕПО);Сумма без НКД;НКД, руб.;Сумма с НКД, руб.;Дата погашения депозита;Текущая процентная ставка по депозиту;Вид процентной ставки по депозиту;Лучший рейтинг инструмента;Рейтинговое агентство инструмента;Лучший рейтинг эмитента;Рейтинговое агентство эмитента;Метод учета";
	
	ТекстРезультата.ДобавитьСтроку(НоваяСтрока);
	
	КоличествоКолонок = ТаблицаРезультата.Колонки.Количество() - 1;
	
	НомерКолонкиЦеннойБумаги = ТаблицаРезультата.Колонки.Индекс(ТаблицаРезультата.Колонки.Найти("ЦеннаяБумага"));
	
	Для Каждого СтрокаТаблицы Из ТаблицаРезультата Цикл
		
		НоваяСтрока = "";
		Для СчКолонок = 0 По КоличествоКолонок Цикл
			
			Если СчКолонок = НомерКолонкиЦеннойБумаги Тогда
				//	реализуем представление из СКД
				// ВЫБОР КОГДА ТипАктива = "Процентный своп" ТОГДА "СВОП," + ISIN + ", " + Формат(ДатаПогашенияДепозита, "ДФ=dd.MM.yyyy") ИНАЧЕ ЭмитентКонтрагент + " " + РегНомер КОНЕЦ
				Если СтрокаТаблицы.ТипАктива = "Процентный своп" Тогда
					ЗначениеЯчейки = "СВОП, " + СтрокаТаблицы.ISIN + ", " + Формат(СтрокаТаблицы.ДатаПогашенияДепозита, "ДФ=dd.MM.yyyy");
				Иначе	
					ЗначениеЯчейки = Строка(СтрокаТаблицы.ЭмитентКонтрагент) + " " + Строка(СтрокаТаблицы.РегНомер);
				КонецЕсли;
			Иначе				
				ЗначениеЯчейки = СокрЛП(СтрокаТаблицы.Получить(СчКолонок));
			КонецЕсли;
			
			
			НоваяСтрока = НоваяСтрока + ЗначениеЯчейки + ?(СчКолонок = КоличествоКолонок, "", ";");
		КонецЦикла;
		
		ТекстРезультата.ДобавитьСтроку(НоваяСтрока);
		
	КонецЦикла;
	
	// Завершаем сессию сбора статистики
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(ПолноеИмяОтчета, СессияСбораСтатистики); 	
	
	Возврат ТекстРезультата;
	
КонецФункции

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	МассивСчетовДУ = МассивСчетовДУДляОтчета();
	Если Не ПроверитьСчетаДоверительногоУправленияДляОтчета(МассивСчетовДУ) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ВФорматеCSV Тогда
		Если Не ПроверитьКаталог() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выгрузка отменена");
			СтандартнаяОбработка = Ложь;
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ИмяПредопределенногоВарианта = РаботаСОтчетамиКлиентСервер.ПолучитьИмяПредопределенногоВариантаОтчета(ЭтотОбъект);
			
	Настройки = КомпоновщикНастроек.Настройки;
	Параметры = Настройки.ПараметрыДанных;
	
	Параметры.УстановитьЗначениеПараметра("Период",							НачалоДня(ЭтотОбъект.Период));
	Параметры.УстановитьЗначениеПараметра("ПериодГраница",					Новый Граница(КонецДня(ЭтотОбъект.Период), ВидГраницы.Включая));
	Параметры.УстановитьЗначениеПараметра("Организация", 					ЭтотОбъект.Организация);	
	Параметры.УстановитьЗначениеПараметра("СчетаДоверительногоУправления", 	МассивСчетовДУ);
	
	Если ЭтотОбъект.ВФорматеCSV Тогда
		
		// Получаем выгрузку, сохраняем в файл
		
		СтандартнаяОбработка = Ложь;
		
		ТекстРезультата = ПолучитьВыгрузкуСРазделителем(МассивСчетовДУ);   	
	
		ИмяФайла = ЭтотОбъект.КаталогДанных + "\" + ПолучитьИмяФайла() + ".csv";
		
		ТекстРезультата.Записать(ИмяФайла, "windows-1251");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выгрузка завершена");
		
	Иначе
		
		// Выполняем программную компоновку
		РаботаСОтчетами.ВыполнитьКомпоновкуПрограммно(ЭтотОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка);	
		
	КонецЕсли;
		
КонецПроцедуры

Функция ПроверитьКаталог()
		
	ТекФайл = Новый Файл(ЭтотОбъект.КаталогДанных);
	Если Не ТекФайл.Существует() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Указанный каталог не существует");
		Возврат Ложь;
	КонецЕсли;
		   		
	Если Не ТекФайл.ЭтоКаталог() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Указан файл, а не каталог");
		Возврат Ложь;                                                               	
	КонецЕсли;
	
	Если ТекФайл.ПолучитьТолькоЧтение() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствует доступ к указанному каталогу");
		Возврат Ложь;                                                               	
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьИмяФайла()
	
	ИмяФайла = "Портфель ";
	
	Если ЭтотОбъект.ПоКлиенту Тогда
		Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период);
		ИмяФайла = ИмяФайла + СокрЛП(Клиент);
	Иначе
		ИмяФайла = ИмяФайла + СокрЛП(ЭтотОбъект.СчетДоверительногоУправления);
	КонецЕсли;
	
	ИмяФайла = ИмяФайла + "_" + Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy");
	
	
	Возврат ИмяФайла;
	
КонецФункции

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("ВариантОтчета");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");
	Возврат Настройки;

КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	ЭтотОбъект.Период = НачалоДня(НастройкиОтчета.Период.ДатаОкончания);
	
	РаботаСОтчетамиКлиентСервер.ЗаполнитьДополнительныеСвойстваВариантаОтчета(ЭтотОбъект, НастройкиОтчета.ВариантОтчета);
	
	МассивСчетовДУ = МассивСчетовДУДляОтчета();
	
	Если Не ПроверитьСчетаДоверительногоУправленияДляОтчета(МассивСчетовДУ) Тогда
		НастройкиОтчета.Вставить("Отказ");
		Возврат;
	КонецЕсли;		
		
	ТекстРезультата = ПолучитьВыгрузкуСРазделителем(МассивСчетовДУ);   	
	
	ИмяВремФайла = ПолучитьИмяВременногоФайла(".csv");
	
	ТекстРезультата.Записать(ИмяВремФайла, "windows-1251");
			
	АдресРезультатаВХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВремФайла), Новый УникальныйИдентификатор());
			
	НастройкиОтчета.Вставить("Результат", АдресРезультатаВХранилище);
	
	УдалитьФайлы(ИмяВремФайла);
	
КонецПроцедуры

Функция ПроверитьСчетаДоверительногоУправленияДляОтчета(МассивСчетовДУ)
	
	Отказ = Ложь;
	
	// Проверяем дату запрета редактирования проводок ЕПС
	Запрос = Новый Запрос;		
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Период", 								ЭтотОбъект.Период);	
	Запрос.УстановитьПараметр("Организация", 							ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", 			МассивСчетовДУ);
			
	Запрос.Текст = 
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления
	    |ПОМЕСТИТЬ _СчетаДоверительногоУправления
	    |ИЗ
	    |	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
	    |ГДЕ
	    |	СчетаДоверительногоУправления.Ссылка В(&СчетаДоверительногоУправления)";
		
	Запрос.Выполнить();
	
	Отказ = РаботаСОтчетами.ЕстьДатыЗапретаРедактированияСчетовДоверительногоУправленияДоДатыПроверки(Запрос.МенеджерВременныхТаблиц, ЭтотОбъект.Период, ЭтотОбъект.Организация, Перечисления.ГруппыЗапретаРедактирования.БэкОфис);
		
	// Проверяем наличие СЧА на дату отчета	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РегистрацияСтоимостиАктивов КАК РегистрацияСтоимостиАктивов
		|		ПО (РегистрацияСтоимостиАктивов.Организация = &Организация)
		|			И _СчетаДоверительногоУправления.СчетДоверительногоУправления = РегистрацияСтоимостиАктивов.СчетДоверительногоУправления
		|			И (РегистрацияСтоимостиАктивов.Проведен)
		|			И (НАЧАЛОПЕРИОДА(РегистрацияСтоимостиАктивов.Дата, ДЕНЬ) = &Период)
		|ГДЕ
		|	РегистрацияСтоимостиАктивов.СчетДоверительногоУправления ЕСТЬ NULL";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Для счета ДУ '%1' не зарегистрирована СЧА на дату отчета", Выборка.СчетДоверительногоУправления),,,, Отказ);
	КонецЦикла;
	
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отчет не сформирован");		
	КонецЕсли;   	
	
	Возврат Не Отказ;
	
КонецФункции

Функция МассивСчетовДУДляОтчета()
	
	Результат = Новый Массив;
	Если Не ЭтотОбъект.ПоКлиенту Тогда
		Результат.Добавить(ЭтотОбъект.СчетДоверительногоУправления);
	Иначе
		Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период);
		ТаблицаСчетовДУ = Справочники.СчетаДоверительногоУправления.СчетаДоверительногоУправленияНаДатуСАктивами(ЭтотОбъект.Период, Новый Структура("Клиент", Клиент));
		Если ТипЗнч(ТаблицаСчетовДУ) = Тип("ТаблицаЗначений") Тогда
			Результат = ТаблицаСчетовДУ.ВыгрузитьКолонку("СчетДоверительногоУправления");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
	
	
