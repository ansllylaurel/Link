&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ТаблицаИзменений = Неопределено Тогда
		ТаблицаИзменений = СоздатьТаблицуИзменений();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСформировать(Команда)
	
	ТаблицаИзменений = СформироватьТаблицуИзмененийНаСервере(Максимум);
	
	Если ТаблицаИзменений.Количество() = 0 Тогда
		Сообщить("Нет строк для отображения.");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыполнить(Команда)
	
	Если ТаблицаИзменений = Неопределено Или ТаблицаИзменений.Количество() = 0 Тогда
		Сообщить("Сначала нажмите «Сформировать».");
		Возврат;
	КонецЕсли;
	
	Если Вопрос("Выполнить замену наименований для отмеченных строк?", РежимДиалогаВопрос.ОКОтмена) <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьЗаменуНаСервере(ТаблицаИзменений);
	
	// после выполнения — пересобрать превью, чтобы стало наглядно, что осталось
	ТаблицаИзменений = СформироватьТаблицуИзмененийНаСервере(Максимум);
	
КонецПроцедуры

&НаСервере
Функция СоздатьТаблицуИзменений()
	
	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Заменять", Новый ОписаниеТипов("Булево"), "Заменять");
	Т.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.ДепозитарныеСчета"), "Раздел");
	Т.Колонки.Добавить("Было", Новый ОписаниеТипов("Строка"), "Было");
	Т.Колонки.Добавить("Станет", Новый ОписаниеТипов("Строка"), "Станет (редактируемо)");
	Т.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка"), "Причина/ошибка");
	
	Возврат Т;
	
КонецФункции

&НаСервере
Функция СформироватьТаблицуИзмененийНаСервере(Максимум)
	
	Т = СоздатьТаблицуИзменений();
	
	ОрганизацияРЭМ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ");
	Если Не ЗначениеЗаполнено(ОрганизацияРЭМ) Тогда
		Строка = Т.Добавить();
		Строка.Заменять = Ложь;
		Строка.Было = "";
		Строка.Станет = "";
		Строка.Причина = "Не найден именованный объект Организация_РЭМ.";
		Возврат Т;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитарныеСчета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДепозитарныеСчета КАК ДепозитарныеСчета
		|ГДЕ
		|	ДепозитарныеСчета.ПометкаУдаления = ЛОЖЬ
		|	И ДепозитарныеСчета.ТипСчета = &ТипСчета
		|	И ДепозитарныеСчета.Организация = &Организация";
	
	Запрос.УстановитьПараметр("ТипСчета",    Перечисления.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета);
	Запрос.УстановитьПараметр("Организация", ОрганизацияРЭМ);
	
	Счетчик = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Счетчик = Счетчик + 1;
		Если Максимум > 0 И Счетчик > Максимум Тогда
			Прервать;
		КонецЕсли;
		
		Строка = Т.Добавить();
		Строка.Заменять = Ложь;
		Строка.Ссылка = Выборка.Ссылка;
		
		Попытка
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			
			Строка.Было = Объект.Наименование;
			НовоеНаименование = Справочники.ДепозитарныеСчета.СформироватьНаименование(Объект);
			
			Если ПустаяСтрока(НовоеНаименование) Тогда
				Строка.Станет = "";
				Строка.Причина = "Пустое новое наименование (СформироватьНаименование вернуло пусто).";
				Продолжить;
			КонецЕсли;
			
			Строка.Станет = НовоеНаименование;
			
			Если Строка.Было <> Строка.Станет Тогда
				Строка.Заменять = Истина;
			Иначе
				Строка.Причина = "Уже соответствует.";
			КонецЕсли;
			
		Исключение
			Строка.Причина = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Т;
	
КонецФункции

&НаСервере
Процедура ВыполнитьЗаменуНаСервере(ТаблицаИзменений)
	
	Если ТаблицаИзменений = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Изменено = 0;
	Ошибок   = 0;
	
	Для Каждого Стр Из ТаблицаИзменений Цикл
		
		Если Не Стр.Заменять Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПустаяСтрока(Стр.Станет) Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			Объект = Стр.Ссылка.ПолучитьОбъект();
			Если Объект.Наименование <> Стр.Станет Тогда
				Объект.Наименование = Стр.Станет;
				Объект.Записать();
				Изменено = Изменено + 1;
			КонецЕсли;
		Исключение
			Ошибок = Ошибок + 1;
		КонецПопытки;
		
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		"Готово. Изменено: " + Изменено + ", ошибок: " + Ошибок + ".");
	
КонецПроцедуры