&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	ЗначениеОрг = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Если ЗначениеЗаполнено(ЗначениеОрг) Тогда
		Организация = ЗначениеОрг;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыборФайла(Команда)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "Файлы Excel (*.xlsx)|*.xlsx";
	Диалог.Заголовок = "Выберите файл реестра (xlsx)";
	Если Диалог.Выбрать() Тогда
		ПолноеИмяФайла = Диалог.ПолноеИмяФайла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите организацию.");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПолноеИмяФайла) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите файл реестра (xlsx).");
		Возврат;
	КонецЕсли;
	Успех = Отчет.СформироватьОтчет(Организация, ПолноеИмяФайла, ТабличныйДокумент, ДатаРеестра, ПИФ);
	Если Успех Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отчёт сформирован.");
	КонецЕсли;
КонецПроцедуры