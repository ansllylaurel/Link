Функция СведенияОВнешнейОбработке() Экспорт
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Сверка с реестром владельцев инвестиционных паев",
		"1.0",
		"Сверка данных пайщиков ПИФ с файлом реестра (xlsx). Дата и ПИФ берутся из файла. Вывод только расхождений: паспорт, адрес, р/с, счёт НРД (по общему количеству).",
		Истина);
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	Возврат РегистрационныеДанные;
КонецФункции

// Формирует отчёт сверки с реестром. Дата и ПИФ всегда читаются из файла xlsx.
// Параметры: Организация, ДвоичныеДанныеФайла, ПолноеИмяФайла, ДокументРезультат (табличный документ).
// Возврат: Истина при успехе; при ошибке — Ложь, текст в ДокументРезультат или выброс исключения при неверном формате.
Функция СформироватьОтчет(Организация, ДвоичныеДанныеФайла, ПолноеИмяФайла, ДокументРезультат) Экспорт
	
	ДокументРезультат.Очистить();
	
	// Проверяем расширение файла по имени
	Расширение = ВРег(СтрЗаменить(РаботаСФайламиКлиентСервер.ПолучитьРасширениеИмениФайла(ПолноеИмяФайла), ".", ""));
	Если Расширение <> "XLSX" Тогда
		ВызватьИсключение СтрШаблон("Допустим только формат xlsx. Указан: %1.", Расширение);
	КонецЕсли;
	
	// Сохраняем двоичные данные во временный файл
	ВременныйФайл = "";
	Попытка
		ВременныйФайл = ПолучитьИмяВременногоФайла("xlsx");
		ДвоичныеДанныеФайла.Записать(ВременныйФайл);
		
		ТаблицаФайла = Новый ТабличныйДокумент;
		ТаблицаФайла.Прочитать(ВременныйФайл, СпособЧтенияЗначенийТабличногоДокумента.Текст, ТипФайлаТабличногоДокумента.XLSX);
		
		// Удаляем временный файл
		УдалитьФайлы(ВременныйФайл);
		
	Исключение
		// В случае ошибки пытаемся удалить временный файл, если он был создан
		Если ЗначениеЗаполнено(ВременныйФайл) Тогда
			Попытка
				УдалитьФайлы(ВременныйФайл);
			Исключение
				// Игнорируем ошибку удаления
			КонецПопытки;
		КонецЕсли;
		
		ВызватьИсключение СтрШаблон("Ошибка чтения файла: %1. Проверьте, что файл имеет формат Excel (XLSX) и не поврежден.", ОписаниеОшибки());
	КонецПопытки;
	
	ДанныеИзФайла = ПрочитатьДанныеРеестраИзТабличногоДокумента(ТаблицаФайла);
	Если ТипЗнч(ДанныеИзФайла) = Тип("Строка") Тогда
		ВызватьИсключение ДанныеИзФайла;
	КонецЕсли;
	
	Данные1С = ПолучитьДанныеПайщиковИз1С(Организация, ДанныеИзФайла.ПИФ, ДанныеИзФайла.ДатаРеестра);
	Расхождения = СформироватьТаблицуРасхождений(ДанныеИзФайла.Таблица, Данные1С);
	ВывестиРасхожденияВТабличныйДокумент(Расхождения, ДокументРезультат, Организация, ДанныеИзФайла.ПИФ, ДанныеИзФайла.ДатаРеестра);
	
	Возврат Истина;
	
КонецФункции

// Читает из табличного документа (xlsx): дату реестра и ПИФ из шапки, таблицу пайщиков по заголовкам.
// Структура файла (по 1.xml, 2.xml): строка с "Дата и время, на которую составлен список: ДД.ММ.ГГГГ";
// строка с "Полное наименование фонда: <наименование>"; далее строка с "№ п/п" и "Лицо (Ф.И.О....)" — заголовки, затем данные.
Функция ПрочитатьДанныеРеестраИзТабличногоДокумента(ТаблицаФайла)
	
	Высота = ТаблицаФайла.ВысотаТаблицы;
	Ширина = ТаблицаФайла.ШиринаТаблицы;
	Если Высота = 0 Или Ширина = 0 Тогда
		Возврат "В файле нет данных.";
	КонецЕсли;
	
	ДатаРеестра = Неопределено;
	НаименованиеПИФ = "";
	НомерСтрокиЗаголовков = 0;
	
	МаксСтрПоиск = Мин(50, Высота); // Увеличили количество строк для поиска
	
	// Поиск даты и наименования ПИФ
	Для НомерСтроки = 1 По МаксСтрПоиск Цикл
		// Ищем в нескольких колонках, так как данные могут быть в разных колонках
		Для НомерКолонки = 1 По Мин(Ширина, 10) Цикл
			ТекстЯчейки = СокрЛП(ТаблицаФайла.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);
			Если Не ЗначениеЗаполнено(ТекстЯчейки) Тогда
				Продолжить;
			КонецЕсли;
			
			ТекстЯчейкиВерх = ВРег(ТекстЯчейки);
			
			// Поиск даты реестра (разные варианты написания)
			Если ДатаРеестра = Неопределено Тогда
				// Разные варианты фразы о дате составления списка
				Если СтрНайти(ТекстЯчейкиВерх, "СОСТАВЛЕН СПИСОК") > 0 Или
				   СтрНайти(ТекстЯчейкиВерх, "СОСТАВЛЕНА ВЫПИСКА") > 0 Или
				   СтрНайти(ТекстЯчейкиВерх, "ДАТА СОСТАВЛЕНИЯ") > 0 Или
				   СтрНайти(ТекстЯчейкиВерх, "НА КОТОРУЮ СОСТАВЛЕН") > 0 Тогда
					
					ДатаРеестра = ИзвлечьДатуИзСтрокиРеестра(ТекстЯчейки);
					Если ДатаРеестра <> Неопределено Тогда
						// Нашли дату, можно прервать поиск в этой строке
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			// Поиск наименования ПИФ
			Если Не ЗначениеЗаполнено(НаименованиеПИФ) Тогда
				Если СтрНайти(ТекстЯчейкиВерх, "ПОЛНОЕ НАИМЕНОВАНИЕ ФОНДА") > 0 Или
				   СтрНайти(ТекстЯчейкиВерх, "НАИМЕНОВАНИЕ ФОНДА") > 0 Или
				   СтрНайти(ТекстЯчейкиВерх, "ИНВЕСТИЦИОННЫЙ ФОНД") > 0 Тогда
					
					// Пробуем разные варианты разделителей
					ПозДвоеточие = СтрНайти(ТекстЯчейки, ":");
					ПозТире = СтрНайти(ТекстЯчейки, "-");
					
					Если ПозДвоеточие > 0 Тогда
						НаименованиеПИФ = СокрЛП(Сред(ТекстЯчейки, ПозДвоеточие + 1));
					ИначеЕсли ПозТире > 0 Тогда
						НаименованиеПИФ = СокрЛП(Сред(ТекстЯчейки, ПозТире + 1));
					Иначе
						// Если нет разделителя, берем всю строку после ключевых слов
						ПозФонда = СтрНайти(ТекстЯчейкиВерх, "ФОНДА");
						Если ПозФонда > 0 Тогда
							НаименованиеПИФ = СокрЛП(Сред(ТекстЯчейки, ПозФонда + 5));
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Поиск строки заголовков таблицы
	Для НомерСтроки = 1 По Высота Цикл
		ТекстЯчейкиA = СокрЛП(ТаблицаФайла.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);
		ТекстЯчейкиAВерх = ВРег(ТекстЯчейкиA);
		
		// Ищем заголовки таблицы
		Если СтрНайти(ТекстЯчейкиAВерх, "№") > 0 Или 
		   СтрНайти(ТекстЯчейкиAВерх, "П/П") > 0 Или
		   СтрНайти(ТекстЯчейкиAВерх, "N") > 0 Тогда
			
			// Проверяем соседние колонки на наличие заголовков ФИО
			Для НомерКолонки = 2 По Мин(Ширина, 15) Цикл
				ТекстКол = СокрЛП(ТаблицаФайла.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);
				ТекстКолВерх = ВРег(ТекстКол);
				
				Если СтрНайти(ТекстКолВерх, "ЛИЦО") > 0 Или 
				   СтрНайти(ТекстКолВерх, "Ф.И.О") > 0 Или
				   СтрНайти(ТекстКолВерх, "ФИО") > 0 Или
				   СтрНайти(ТекстКолВерх, "ИМЯ") > 0 Тогда
					
					НомерСтрокиЗаголовков = НомерСтроки;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если НомерСтрокиЗаголовков > 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Проверки
	Если ДатаРеестра = Неопределено Или Не ЗначениеЗаполнено(ДатаРеестра) Тогда
		Возврат "В файле не найдена строка с датой составления реестра. Ищите фразы типа: 'Дата и время, на которую составлен список: ДД.ММ.ГГГГ'.";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НаименованиеПИФ) Тогда
		Возврат "В файле не найдена строка с наименованием ПИФ. Ищите фразы типа: 'Полное наименование фонда: ...'.";
	КонецЕсли;
	
	// Поиск ПИФ: справочник по Наименование, затем регистр РеквизитыПИФ по ПолноеНаименованиеФонда
	ПИФ = Неопределено;
	КритерииПоиска = "";
	
	// 1. Справочник — точное совпадение по наименованию
	ПИФ = Справочники.ПаевыеИнвестиционныеФонды.НайтиПоНаименованию(НаименованиеПИФ, Истина);
	КритерииПоиска = "справочник ПаевыеИнвестиционныеФонды, Наименование (точное)";
	
	// 2. Справочник — без учета регистра
	Если Не ЗначениеЗаполнено(ПИФ) Тогда
		ПИФ = Справочники.ПаевыеИнвестиционныеФонды.НайтиПоНаименованию(НаименованиеПИФ, Ложь);
		КритерииПоиска = КритерииПоиска + "; Наименование (без учета регистра)";
	КонецЕсли;
	
	// 3. Справочник — по шаблону ПОДОБНО "%...%"
	Если Не ЗначениеЗаполнено(ПИФ) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ПаевыеИнвестиционныеФонды.Ссылка
			|ИЗ
			|	Справочник.ПаевыеИнвестиционныеФонды КАК ПаевыеИнвестиционныеФонды
			|ГДЕ
			|	ПаевыеИнвестиционныеФонды.Наименование ПОДОБНО &НаименованиеДляПоиска";
		Запрос.УстановитьПараметр("НаименованиеДляПоиска", "%" + НаименованиеПИФ + "%");
		Результат = Запрос.Выполнить();
		КритерииПоиска = КритерииПоиска + "; Наименование ПОДОБНО ""%" + НаименованиеПИФ + "%""";
		Если НЕ Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Если Выборка.Следующий() Тогда
				ПИФ = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// 4. Регистр сведений РеквизитыПИФ — по ПолноеНаименованиеФонда (в файле обычно полное наименование)
	Если Не ЗначениеЗаполнено(ПИФ) И ДатаРеестра <> Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	РеквизитыПИФСрез.ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд
			|ИЗ
			|	РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаРеестра, ) КАК РеквизитыПИФСрез
			|ГДЕ
			|	ВЫРАЗИТЬ(РеквизитыПИФСрез.ПолноеНаименованиеФонда КАК Строка(1000)) = &Наименование
			|	ИЛИ ВЫРАЗИТЬ(РеквизитыПИФСрез.ПолноеНаименованиеФонда КАК Строка(1000)) ПОДОБНО &НаименованиеПОДОБНО";
		Запрос.УстановитьПараметр("Наименование", НаименованиеПИФ);
		Запрос.УстановитьПараметр("НаименованиеПОДОБНО", "%" + НаименованиеПИФ + "%");
		Запрос.УстановитьПараметр("ДатаРеестра", ДатаРеестра);
		Результат = Запрос.Выполнить();
		КритерииПоиска = КритерииПоиска + "; регистр РеквизитыПИФ, ПолноеНаименованиеФонда (точное и ПОДОБНО)";
		Если НЕ Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Если Выборка.Следующий() Тогда
				ПИФ = Выборка.ПаевойИнвестиционныйФонд;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПИФ) Тогда
		Возврат СтрШаблон(
			"ПИФ не найден. Значение из файла: ""%1"". Критерии поиска: %2.",
			НаименованиеПИФ,
			КритерииПоиска);
	КонецЕсли;
	
	Если НомерСтрокиЗаголовков = 0 Тогда
		Возврат "В файле не найдена строка заголовков таблицы (№ п/п, Лицо (Ф.И.О.)).";
	КонецЕсли;
	
	СтрокаЗаголовков = НомерСтрокиЗаголовков;
	СтрокаВторогоРядаЗаголовков = СтрокаЗаголовков + 1;
	ПризнакДвеСтрокиЗаголовков = (СтрокаВторогоРядаЗаголовков <= Высота);
	
	Если ПризнакДвеСтрокиЗаголовков Тогда
		ТекстВторойСтроки = СокрЛП(ТаблицаФайла.Область(СтрокаВторогоРядаЗаголовков, 4, СтрокаВторогоРядаЗаголовков, 4).Текст);
		Если СтрНайти(ВРег(ТекстВторойСтроки), "ДАТА РОЖДЕНИЯ") = 0 Тогда
			ПризнакДвеСтрокиЗаголовков = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ПерваяСтрокаДанных = СтрокаЗаголовков + ?(ПризнакДвеСтрокиЗаголовков, 2, 1);
	
	// Определение колонок: при двух строках заголовков ФИО может быть только в первой строке — учитываем обе
	СтруктураКолонок = Новый Структура;
	
	Для НомерКолонки = 1 По Ширина Цикл
		ТекстСтрока1 = СокрЛП(ТаблицаФайла.Область(СтрокаЗаголовков, НомерКолонки, СтрокаЗаголовков, НомерКолонки).Текст);
		ТекстСтрока2 = "";
		Если ПризнакДвеСтрокиЗаголовков Тогда
			ТекстСтрока2 = СокрЛП(ТаблицаФайла.Область(СтрокаВторогоРядаЗаголовков, НомерКолонки, СтрокаВторогоРядаЗаголовков, НомерКолонки).Текст);
		КонецЕсли;
		Заголовок = СокрЛП(ТекстСтрока1 + " " + ТекстСтрока2);
		ЗаголовокВерх = ВРег(Заголовок);
		
		// ФИО (в двухстрочном заголовке часто только в первой строке: "Лицо (Ф.И.О./...)")
		Если СтрНайти(ЗаголовокВерх, "ЛИЦО") > 0 Или 
		   СтрНайти(ЗаголовокВерх, "Ф.И.О") > 0 Или
		   СтрНайти(ЗаголовокВерх, "ФИО") > 0 Или
		   СтрНайти(ЗаголовокВерх, "ИМЯ") > 0 Или
		   СтрНайти(ЗаголовокВерх, "НАИМЕНОВАН") > 0 Тогда
			СтруктураКолонок.Вставить("ФИО", НомерКолонки);
		
		// Паспорт
		ИначеЕсли СтрНайти(ЗаголовокВерх, "ДАННЫЕ О РЕГИСТРАЦИИ") > 0 Или 
				СтрНайти(ЗаголовокВерх, "УДОСТОВЕРЕН") > 0 Или
				СтрНайти(ЗаголовокВерх, "ПАСПОРТ") > 0 Или
				СтрНайти(ЗаголовокВерх, "ДОКУМЕНТ") > 0 Тогда
			СтруктураКолонок.Вставить("Паспорт", НомерКолонки);
		
		// Адрес
		ИначеЕсли СтрНайти(ЗаголовокВерх, "АДРЕС") > 0 Или 
				СтрНайти(ЗаголовокВерх, "МЕСТО ЖИТЕЛЬСТВА") > 0 Тогда
			СтруктураКолонок.Вставить("Адрес", НомерКолонки);
		
		// Банковские реквизиты
		ИначеЕсли СтрНайти(ЗаголовокВерх, "БАНКОВСКИЕ") > 0 Или 
				СтрНайти(ЗаголовокВерх, "РЕКВИЗИТЫ") > 0 Или
				СтрНайти(ЗаголовокВерх, "СЧЕТ") > 0 Тогда
			СтруктураКолонок.Вставить("БанковскиеРеквизиты", НомерКолонки);
		
		// Количество паев
		ИначеЕсли СтрНайти(ЗаголовокВерх, "КОЛИЧЕСТВО") > 0 Или 
				СтрНайти(ЗаголовокВерх, "ПАЕВ") > 0 Или
				СтрНайти(ЗаголовокВерх, "ЧИСЛО") > 0 Тогда
			СтруктураКолонок.Вставить("Количество", НомерКолонки);
		КонецЕсли;
	КонецЦикла;
	
	Если Не СтруктураКолонок.Свойство("ФИО") Тогда
		Возврат "В файле не найдена колонка с ФИО. Проверьте формат файла.";
	КонецЕсли;
	
	// Создаем таблицу для данных
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ФИО", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(500)));
	Таблица.Колонки.Добавить("СерияПаспорта", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	Таблица.Колонки.Добавить("НомерПаспорта", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	Таблица.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	Таблица.Колонки.Добавить("РасчетныйСчет", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 6)));
	
	// Чтение данных
	Для НомерСтроки = ПерваяСтрокаДанных По Высота Цикл
		ФИО = СокрЛП(ТаблицаФайла.Область(НомерСтроки, СтруктураКолонок.ФИО, НомерСтроки, СтруктураКолонок.ФИО).Текст);
		Если Не ЗначениеЗаполнено(ФИО) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.ФИО = ФИО;
		
		// Паспортные данные
		Если СтруктураКолонок.Свойство("Паспорт") Тогда
			ТекстПаспорта = СокрЛП(ТаблицаФайла.Область(НомерСтроки, СтруктураКолонок.Паспорт, НомерСтроки, СтруктураКолонок.Паспорт).Текст);
			РезультатПаспорт = ИзвлечьСерияИНомерПаспорта(ТекстПаспорта);
			НоваяСтрока.СерияПаспорта = РезультатПаспорт.Серия;
			НоваяСтрока.НомерПаспорта = РезультатПаспорт.Номер;
		Иначе
			НоваяСтрока.СерияПаспорта = "";
			НоваяСтрока.НомерПаспорта = "";
		КонецЕсли;
		
		// Адрес
		НоваяСтрока.Адрес = ?(СтруктураКолонок.Свойство("Адрес"), СокрЛП(ТаблицаФайла.Область(НомерСтроки, СтруктураКолонок.Адрес, НомерСтроки, СтруктураКолонок.Адрес).Текст), "");
		
		// Банковские реквизиты
		Если СтруктураКолонок.Свойство("БанковскиеРеквизиты") Тогда
			ТекстБанк = СокрЛП(ТаблицаФайла.Область(НомерСтроки, СтруктураКолонок.БанковскиеРеквизиты, НомерСтроки, СтруктураКолонок.БанковскиеРеквизиты).Текст);
			НоваяСтрока.РасчетныйСчет = ИзвлечьНомерРасчетногоСчета(ТекстБанк);
		Иначе
			НоваяСтрока.РасчетныйСчет = "";
		КонецЕсли;
		
		// Количество паев
		ЗначКол = 0;
		Если СтруктураКолонок.Свойство("Количество") Тогда
			ТекстКол = СокрЛП(ТаблицаФайла.Область(НомерСтроки, СтруктураКолонок.Количество, НомерСтроки, СтруктураКолонок.Количество).Текст);
			Если ЗначениеЗаполнено(ТекстКол) Тогда
				Попытка
					// Удаляем пробелы и заменяем запятую на точку
					ТекстДляЧисла = СтрЗаменить(СтрЗаменить(ТекстКол, " ", ""), ",", ".");
					ЗначКол = Число(ТекстДляЧисла);
				Исключение
					ЗначКол = 0;
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		НоваяСтрока.Количество = ЗначКол;
	КонецЦикла;
	
	// Если таблица пустая, возвращаем ошибку
	Если Таблица.Количество() = 0 Тогда
		Возврат "В файле не найдены данные пайщиков.";
	КонецЕсли;
	
	Возврат Новый Структура("Таблица, ДатаРеестра, ПИФ", Таблица, ДатаРеестра, ПИФ);
	
КонецФункции

Функция ИзвлечьДатуИзСтрокиРеестра(ТекстСтроки)
	
	Если Не ЗначениеЗаполнено(ТекстСтроки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Попробуем найти дату в формате ДД.ММ.ГГГГ или ДД.ММ.ГГ
	ТекстСтроки = СтрЗаменить(ТекстСтроки, Символы.Таб, " ");
	
	// Ищем последовательности с точками (формат ДД.ММ.ГГГГ)
	Для i = 1 По СтрДлина(ТекстСтроки) - 9 Цикл
		Часть = Сред(ТекстСтроки, i, 10);
		
		// Проверяем формат ДД.ММ.ГГГГ
		Если Сред(Часть, 3, 1) = "." И Сред(Часть, 6, 1) = "." Тогда
			Попытка
				День = Число(Лев(Часть, 2));
				Месяц = Число(Сред(Часть, 4, 2));
				Год = Число(Сред(Часть, 7, 4));
				
				Если День >= 1 И День <= 31 И Месяц >= 1 И Месяц <= 12 И Год >= 2000 И Год <= 2100 Тогда
					Возврат Дата(Год, Месяц, День);
				КонецЕсли;
			Исключение
				// Продолжаем поиск
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	// Ищем формат ДД.ММ.ГГ
	Для i = 1 По СтрДлина(ТекстСтроки) - 7 Цикл
		Часть = Сред(ТекстСтроки, i, 8);
		
		// Проверяем формат ДД.ММ.ГГ
		Если Сред(Часть, 3, 1) = "." И Сред(Часть, 6, 1) = "." Тогда
			Попытка
				День = Число(Лев(Часть, 2));
				Месяц = Число(Сред(Часть, 4, 2));
				Год2цифры = Число(Сред(Часть, 7, 2));
				Год = 2000 + Год2цифры;
				
				Если День >= 1 И День <= 31 И Месяц >= 1 И Месяц <= 12 И Год >= 2000 И Год <= 2100 Тогда
					Возврат Дата(Год, Месяц, День);
				КонецЕсли;
			Исключение
				// Продолжаем поиск
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	// Ищем дату словами - пробуем стандартную функцию Дата
	Слова = СтрРазделить(ТекстСтроки, " .,;:-", Ложь);
	
	Для Каждого Слово Из Слова Цикл
		Слово = СокрЛП(Слово);
		Если СтрДлина(Слово) >= 6 Тогда  // Минимум для даты: 6 символов (1.1.23)
			// Пробуем преобразовать как дату
			Попытка
				ПопыткаДаты = Дата(Слово);
				// Проверяем, что дата реалистичная (не 1900 год и т.д.)
				Если Год(ПопыткаДаты) >= 2000 И Год(ПопыткаДаты) <= 2100 Тогда
					Возврат ПопыткаДаты;
				КонецЕсли;
			Исключение
				// Продолжаем поиск
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	// Пробуем найти числа разделенные точками
	Для Каждого Слово Из Слова Цикл
		Слово = СокрЛП(Слово);
		Если СтрНайти(Слово, ".") > 0 Тогда
			Части = СтрРазделить(Слово, ".");
			Если Части.Количество() >= 3 Тогда
				Попытка
					ДеньСтрока = СокрЛП(Части[Части.НижняяГраница()]);
					МесяцСтрока = СокрЛП(Части[Части.НижняяГраница() + 1]);
					ГодСтрока = СокрЛП(Части[Части.НижняяГраница() + 2]);
					День = Число(ДеньСтрока);
					Месяц = Число(МесяцСтрока);
					// Год может быть с хвостом ("2025  20:00") — берём только цифры
					Если СтрДлина(ГодСтрока) >= 4 Тогда
						Год = Число(Лев(ГодСтрока, 4));
					ИначеЕсли СтрДлина(ГодСтрока) = 2 Тогда
						Год = 2000 + Число(ГодСтрока);
					Иначе
						Продолжить;
					КонецЕсли;
					
					// Проверяем корректность
					Если День >= 1 И День <= 31 И Месяц >= 1 И Месяц <= 12 И Год >= 2000 И Год <= 2100 Тогда
						Возврат Дата(Год, Месяц, День);
					КонецЕсли;
				Исключение
					// Продолжаем поиск
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Если ничего не нашли, ищем числовые последовательности
	ТолькоЦифрыИТочки = "";
	Для i = 1 По СтрДлина(ТекстСтроки) Цикл
		Символ = Сред(ТекстСтроки, i, 1);
		Если Найти("0123456789.", Символ) > 0 Тогда
			ТолькоЦифрыИТочки = ТолькоЦифрыИТочки + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ПустаяСтрока(ТолькоЦифрыИТочки) Тогда
		Части = СтрРазделить(ТолькоЦифрыИТочки, ".");
		Если Части.Количество() >= 3 Тогда
			НГ = Части.НижняяГраница();
			// Ищем последние 3 части, которые могут быть датой
			Для i = НГ По Части.ВГраница() - 2 Цикл
				Попытка
					ДеньСтрока = Части[i];
					МесяцСтрока = Части[i + 1];
					ГодСтрока = Части[i + 2];
					
					// Проверяем длину строк
					Если СтрДлина(ДеньСтрока) <= 0 Или СтрДлина(МесяцСтрока) <= 0 Или СтрДлина(ГодСтрока) <= 0 Тогда
						Продолжить;
					КонецЕсли;
					
					День = Число(ДеньСтрока);
					Месяц = Число(МесяцСтрока);
					Год = Число(ГодСтрока);
					
					// Корректируем год если нужно
					Если Год < 100 Тогда
						Год = 2000 + Год;
					КонецЕсли;
					
					// Проверяем что числа реалистичны для даты
					Если День >= 1 И День <= 31 И 
					   Месяц >= 1 И Месяц <= 12 И 
					   Год >= 2000 И Год <= 2100 Тогда
						Возврат Дата(Год, Месяц, День);
					КонецЕсли;
				Исключение
					// Не удалось преобразовать, продолжаем
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	// Пробуем еще один подход: ищем подстроку "01.01.2023" в любом месте
	Для Позиция = 1 По СтрДлина(ТекстСтроки) Цикл
		// Проверяем 10 символов начиная с позиции
		Если Позиция + 9 <= СтрДлина(ТекстСтроки) Тогда
			Подстрока = Сред(ТекстСтроки, Позиция, 10);
			
			// Проверяем паттерн даты
			Если Сред(Подстрока, 3, 1) = "." И Сред(Подстрока, 6, 1) = "." Тогда
				Попытка
					Число1 = Число(Сред(Подстрока, 1, 2));
					Число2 = Число(Сред(Подстрока, 4, 2));
					Число3 = Число(Сред(Подстрока, 7, 4));
					
					// Проверяем что это может быть дата
					Если Число1 >= 1 И Число1 <= 31 И 
					   Число2 >= 1 И Число2 <= 12 И 
					   Число3 >= 2000 Тогда
						Возврат Дата(Число3, Число2, Число1);
					КонецЕсли;
				Исключение
					// Не число, продолжаем
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		// Проверяем 8 символов (формат ДД.ММ.ГГ)
		Если Позиция + 7 <= СтрДлина(ТекстСтроки) Тогда
			Подстрока = Сред(ТекстСтроки, Позиция, 8);
			
			Если Сред(Подстрока, 3, 1) = "." И Сред(Подстрока, 6, 1) = "." Тогда
				Попытка
					Число1 = Число(Сред(Подстрока, 1, 2));
					Число2 = Число(Сред(Подстрока, 4, 2));
					Число3 = Число(Сред(Подстрока, 7, 2));
					
					Если Число1 >= 1 И Число1 <= 31 И 
					   Число2 >= 1 И Число2 <= 12 Тогда
						Год = 2000 + Число3;
						Если Год >= 2000 И Год <= 2100 Тогда
							Возврат Дата(Год, Число2, Число1);
						КонецЕсли;
					КонецЕсли;
				Исключение
					// Не число, продолжаем
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Последняя попытка: ищем 4 цифры подряд (год)
	Для i = 1 По СтрДлина(ТекстСтроки) - 3 Цикл
		ЧетыреЦифры = Сред(ТекстСтроки, i, 4);
		Попытка
			Год = Число(ЧетыреЦифры);
			Если Год >= 2000 И Год <= 2100 Тогда
				// Нашли год, ищем день и месяц вокруг
				// Можно искать назад и вперед от позиции года
				Возврат Дата(Год, 1, 1); // Возвращаем хотя бы 1 января найденного года
			КонецЕсли;
		Исключение
			// Продолжаем
		КонецПопытки;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ИзвлечьСерияИНомерПаспорта(ТекстПаспорта)
	Результат = Новый Структура("Серия, Номер", "", "");
	Если Не ЗначениеЗаполнено(ТекстПаспорта) Тогда
		Возврат Результат;
	КонецЕсли;
	Части = СтрРазделить(ТекстПаспорта, ",", Ложь);
	Для Инд = 0 По Части.ВГраница() Цикл
		Часть = СокрЛП(Части[Инд]);
		Если СтрДлина(Часть) <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Цифры = "";
		Для Поз = 1 По СтрДлина(Часть) Цикл
			Симв = Сред(Часть, Поз, 1);
			Если Найти("0123456789", Симв) > 0 Тогда
				Цифры = Цифры + Симв;
			КонецЕсли;
		КонецЦикла;
		Если СтрДлина(Цифры) >= 4 И СтрДлина(Цифры) <= 6 И Не ЗначениеЗаполнено(Результат.Серия) Тогда
			Результат.Серия = Лев(Цифры, Мин(4, СтрДлина(Цифры)));
			Если СтрДлина(Цифры) > 4 Тогда
				Результат.Номер = Сред(Цифры, 5);
			КонецЕсли;
		ИначеЕсли СтрДлина(Цифры) >= 6 И Не ЗначениеЗаполнено(Результат.Номер) Тогда
			Результат.Номер = Цифры;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ИзвлечьНомерРасчетногоСчета(ТекстБанковскихРеквизитов)
	Если Не ЗначениеЗаполнено(ТекстБанковскихРеквизитов) Тогда
		Возврат "";
	КонецЕсли;
	ПозРс = СтрНайти(ВРег(ТекстБанковскихРеквизитов), "Р/С ");
	Если ПозРс > 0 Тогда
		Часть = СокрЛП(Сред(ТекстБанковскихРеквизитов, ПозРс + 4));
		ЧастиРс = СтрРазделить(Часть, ";", Ложь);
		Часть = ?(ЧастиРс.Количество() > 0, СокрЛП(ЧастиРс[0]), "");
		ЧастиПробел = СтрРазделить(Часть, " ", Ложь);
		Часть = ?(ЧастиПробел.Количество() > 0, СокрЛП(ЧастиПробел[0]), "");
		ТолькоЦифры = Истина;
		Для Поз = 1 По Мин(20, СтрДлина(Часть)) Цикл
			Если Найти("0123456789", Сред(Часть, Поз, 1)) = 0 Тогда
				ТолькоЦифры = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СтрДлина(Часть) = 20 И ТолькоЦифры Тогда
			Возврат Часть;
		КонецЕсли;
	КонецЕсли;
	Поз = СтрНайти(ТекстБанковскихРеквизитов, "№ ");
	Если Поз > 0 Тогда
		Часть = СокрЛП(Сред(ТекстБанковскихРеквизитов, Поз + 2));
		Результат = "";
		Для Поз = 1 По Мин(20, СтрДлина(Часть)) Цикл
			Симв = Сред(Часть, Поз, 1);
			Если Найти("0123456789", Симв) > 0 Тогда
				Результат = Результат + Симв;
			ИначеЕсли ЗначениеЗаполнено(Результат) Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СтрДлина(Результат) = 20 Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ПолучитьДанныеПайщиковИз1С(Организация, ПИФ, ДатаРеестра)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Доли.Пайщик КАК Пайщик,
		|	Доли.КоличествоОстаток КАК Количество,
		|	Реквизиты.Фамилия КАК Фамилия,
		|	Реквизиты.Имя КАК Имя,
		|	Реквизиты.Отчество КАК Отчество,
		|	Реквизиты.СерияУдостоверенияЛичности КАК СерияПаспорта,
		|	Реквизиты.НомерУдостоверенияЛичности КАК НомерПаспорта,
		|	ВЫБОР КОГДА Реквизиты.АдресРегистрации ЕСТЬ NULL ИЛИ Реквизиты.АдресРегистрации = """"
		|		ТОГДА Реквизиты.АдресМестаЖительства ИНАЧЕ Реквизиты.АдресРегистрации КОНЕЦ КАК Адрес,
		|	Счета.НомерСчета КАК НомерСчета
		|ИЗ
		|	(ВЫБРАТЬ
		|		ДолиПайщиков.Пайщик КАК Пайщик,
		|		ДолиПайщиков.КоличествоОстаток КАК КоличествоОстаток
		|	ИЗ
		|		РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.Остатки(&ДатаРеестра, Организация = &Организация И ПаевойИнвестиционныйФонд = &ПИФ) КАК ДолиПайщиков) КАК Доли
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(&ДатаРеестра, Организация = &Организация И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК Реквизиты
		|	ПО Доли.Пайщик = Реквизиты.ЮрФизЛицо
		|	ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|		БанковскиеСчета.ЮрФизЛицо КАК ЮрФизЛицо,
		|		МАКСИМУМ(БанковскиеСчета.НомерСчета) КАК НомерСчета
		|	ИЗ
		|		Справочник.БанковскиеСчета КАК БанковскиеСчета
		|	ГДЕ
		|		БанковскиеСчета.ПометкаУдаления = ЛОЖЬ
		|		И БанковскиеСчета.Организация = &Организация
		|	СГРУППИРОВАТЬ ПО
		|		БанковскиеСчета.ЮрФизЛицо) КАК Счета
		|	ПО Доли.Пайщик = Счета.ЮрФизЛицо";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПИФ", ПИФ);
	Запрос.УстановитьПараметр("ДатаРеестра", ДатаРеестра);
	Попытка
		Возврат Запрос.Выполнить().Выгрузить();
	Исключение
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Доли.Пайщик КАК Пайщик,
			|	Доли.КоличествоОстаток КАК Количество,
			|	Реквизиты.Фамилия КАК Фамилия,
			|	Реквизиты.Имя КАК Имя,
			|	Реквизиты.Отчество КАК Отчество,
			|	Реквизиты.СерияУдостоверенияЛичности КАК СерияПаспорта,
			|	Реквизиты.НомерУдостоверенияЛичности КАК НомерПаспорта,
			|	ВЫБОР КОГДА Реквизиты.АдресРегистрации ЕСТЬ NULL ИЛИ Реквизиты.АдресРегистрации = """"
			|		ТОГДА Реквизиты.АдресМестаЖительства ИНАЧЕ Реквизиты.АдресРегистрации КОНЕЦ КАК Адрес,
			|	"""" КАК НомерСчета
			|ИЗ
			|	(ВЫБРАТЬ
			|		ДолиПайщиков.Пайщик КАК Пайщик,
			|		ДолиПайщиков.КоличествоОстаток КАК КоличествоОстаток
			|	ИЗ
			|		РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.Остатки(&ДатаРеестра, Организация = &Организация И ПаевойИнвестиционныйФонд = &ПИФ) КАК ДолиПайщиков) КАК Доли
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(&ДатаРеестра, Организация = &Организация И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК Реквизиты
			|	ПО Доли.Пайщик = Реквизиты.ЮрФизЛицо";
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("ПИФ", ПИФ);
		Запрос.УстановитьПараметр("ДатаРеестра", ДатаРеестра);
		Возврат Запрос.Выполнить().Выгрузить();
	КонецПопытки;
КонецФункции

Функция СформироватьТаблицуРасхождений(ТаблицаФайла, Данные1С)
	Расхождения = Новый ТаблицаЗначений;
	Расхождения.Колонки.Добавить("ФИО", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ВидРасхождения", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("Поле", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ВФайле", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("В1С", Новый ОписаниеТипов("Строка"));
	Словарь1С = Новый Соответствие;
	Для Каждого Строка1С Из Данные1С Цикл
		ФИО1С = СокрЛП(Строка(Строка1С.Фамилия) + " " + Строка(Строка1С.Имя) + " " + Строка(Строка1С.Отчество));
		Словарь1С.Вставить(ВРег(ФИО1С), Строка1С);
	КонецЦикла;
	СуммаКоличестваВФайле = 0;
	СуммаКоличестваВ1С = 0;
	Для Каждого СтрокаФайла Из ТаблицаФайла Цикл
		СуммаКоличестваВФайле = СуммаКоличестваВФайле + СтрокаФайла.Количество;
	КонецЦикла;
	Для Каждого Строка1С Из Данные1С Цикл
		СуммаКоличестваВ1С = СуммаКоличестваВ1С + Строка1С.Количество;
	КонецЦикла;
	Если СуммаКоличестваВФайле <> СуммаКоличестваВ1С Тогда
		Новая = Расхождения.Добавить();
		Новая.ФИО = "(итого по реестру)";
		Новая.ВидРасхождения = "Счет НРД (общее количество)";
		Новая.Поле = "Количество";
		Новая.ВФайле = Формат(СуммаКоличестваВФайле, "ЧГ=0");
		Новая.В1С = Формат(СуммаКоличестваВ1С, "ЧГ=0");
	КонецЕсли;
	Для Каждого СтрокаФайла Из ТаблицаФайла Цикл
		КлючФИО = ВРег(СокрЛП(СтрокаФайла.ФИО));
		Строка1С = Словарь1С.Получить(КлючФИО);
		Если Строка1С = Неопределено Тогда
			Новая = Расхождения.Добавить();
			Новая.ФИО = СтрокаФайла.ФИО;
			Новая.ВидРасхождения = "Нет в 1С";
			Новая.Поле = "—";
			Новая.ВФайле = "Есть в файле";
			Новая.В1С = "";
			Продолжить;
		КонецЕсли;
		ПаспортФайл = СокрЛП(СтрокаФайла.СерияПаспорта + " " + СтрокаФайла.НомерПаспорта);
		Паспорт1С = СокрЛП(Строка(Строка1С.СерияПаспорта) + " " + Строка(Строка1С.НомерПаспорта));
		Если ПаспортФайл <> Паспорт1С И (ЗначениеЗаполнено(ПаспортФайл) Или ЗначениеЗаполнено(Паспорт1С)) Тогда
			Новая = Расхождения.Добавить();
			Новая.ФИО = СтрокаФайла.ФИО;
			Новая.ВидРасхождения = "Паспорт";
			Новая.Поле = "Паспорт";
			Новая.ВФайле = ПаспортФайл;
			Новая.В1С = Паспорт1С;
		КонецЕсли;
		АдресФайл = СокрЛП(СтрокаФайла.Адрес);
		Адрес1С = СокрЛП(Строка(Строка1С.Адрес));
		Если АдресФайл <> Адрес1С И (ЗначениеЗаполнено(АдресФайл) Или ЗначениеЗаполнено(Адрес1С)) Тогда
			Новая = Расхождения.Добавить();
			Новая.ФИО = СтрокаФайла.ФИО;
			Новая.ВидРасхождения = "Адрес";
			Новая.Поле = "Адрес";
			Новая.ВФайле = АдресФайл;
			Новая.В1С = Адрес1С;
		КонецЕсли;
		РсФайл = СокрЛП(СтрокаФайла.РасчетныйСчет);
		Рс1С = СокрЛП(Строка(Строка1С.НомерСчета));
		Если РсФайл <> Рс1С И (ЗначениеЗаполнено(РсФайл) Или ЗначениеЗаполнено(Рс1С)) Тогда
			Новая = Расхождения.Добавить();
			Новая.ФИО = СтрокаФайла.ФИО;
			Новая.ВидРасхождения = "Расчетный счет";
			Новая.Поле = "Р/с";
			Новая.ВФайле = РсФайл;
			Новая.В1С = Рс1С;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Строка1С Из Данные1С Цикл
		ФИО1С = СокрЛП(Строка(Строка1С.Фамилия) + " " + Строка(Строка1С.Имя) + " " + Строка(Строка1С.Отчество));
		НайденВФайле = Ложь;
		Для Каждого СтрокаФайла Из ТаблицаФайла Цикл
			Если ВРег(СокрЛП(СтрокаФайла.ФИО)) = ВРег(ФИО1С) Тогда
				НайденВФайле = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не НайденВФайле Тогда
			Новая = Расхождения.Добавить();
			Новая.ФИО = ФИО1С;
			Новая.ВидРасхождения = "Нет в файле";
			Новая.Поле = "—";
			Новая.ВФайле = "";
			Новая.В1С = "Есть в 1С";
		КонецЕсли;
	КонецЦикла;
	Возврат Расхождения;
КонецФункции

Процедура ВывестиРасхожденияВТабличныйДокумент(Расхождения, ДокументРезультат, Организация, ПИФ, ДатаРеестра)
	ДокументРезультат.Очистить();
	ДокументРезультат.Область("R1C1:R1C5").Объединить();
	ДокументРезультат.Область("R1C1").Текст = "Сверка с реестром владельцев инвестиционных паев. Только расхождения.";
	ДокументРезультат.Область("R2C1").Текст = "Организация: " + Строка(Организация);
	ДокументРезультат.Область("R3C1").Текст = "ПИФ: " + Строка(ПИФ);
	ДокументРезультат.Область("R4C1").Текст = "Дата реестра: " + Формат(ДатаРеестра, "ДФ=dd.MM.yyyy");
	НомерСтроки = 6;
	ДокументРезультат.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C1").Текст = "ФИО";
	ДокументРезультат.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C2").Текст = "Вид расхождения";
	ДокументРезультат.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C3").Текст = "Поле";
	ДокументРезультат.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C4").Текст = "В файле";
	ДокументРезультат.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C5").Текст = "В 1С";
	НомерСтроки = 7;
	Для Каждого СтрокаРасх Из Расхождения Цикл
		ДокументРезультат.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C1").Текст = СтрокаРасх.ФИО;
		ДокументРезультат.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C2").Текст = СтрокаРасх.ВидРасхождения;
		ДокументРезультат.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C3").Текст = СтрокаРасх.Поле;
		ДокументРезультат.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C4").Текст = СтрокаРасх.ВФайле;
		ДокументРезультат.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C5").Текст = СтрокаРасх.В1С;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	Если Расхождения.Количество() = 0 Тогда
		ДокументРезультат.Область("R7C1").Текст = "Расхождений не обнаружено.";
	КонецЕсли;
КонецПроцедуры
