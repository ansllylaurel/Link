Функция СведенияОВнешнейОбработке() Экспорт
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Сверка с реестром владельцев инвестиционных паев",
		"1.0",
		"Сверка данных пайщиков ПИФ с файлом реестра (xlsx). Дата и ПИФ берутся из файла. Вывод только расхождений: паспорт, адрес, р/с, счёт НРД (по общему количеству).",
		Истина);
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	Возврат РегистрационныеДанные;
КонецФункции

Функция СформироватьОтчет(Организация, ДвоичныеДанныеФайла, ПолноеИмяФайла) Экспорт
	Результат = Новый Структура("Успех, ТекстОтчета", Ложь, "");
	
	Расширение = ВРег(СтрЗаменить(РаботаСФайламиКлиентСервер.ПолучитьРасширениеИмениФайла(ПолноеИмяФайла), ".", ""));
	Если Расширение <> "XLSX" Тогда
		ВызватьИсключение СтрШаблон("Допустим только формат xlsx. Указан: %1.", Расширение);
	КонецЕсли;
	
	ВременныйФайл = "";
	Попытка
		ВременныйФайл = ПолучитьИмяВременногоФайла("xlsx");
		ДвоичныеДанныеФайла.Записать(ВременныйФайл);
		
		ТаблицаФайла = Новый ТабличныйДокумент;
		ТаблицаФайла.Прочитать(ВременныйФайл, СпособЧтенияЗначенийТабличногоДокумента.Текст, ТипФайлаТабличногоДокумента.XLSX);
		
		УдалитьФайлы(ВременныйФайл);
		
	Исключение
		Если ЗначениеЗаполнено(ВременныйФайл) Тогда
			Попытка
				УдалитьФайлы(ВременныйФайл);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		ВызватьИсключение СтрШаблон("Ошибка чтения файла: %1. Проверьте, что файл имеет формат Excel (XLSX) и не поврежден.", ОписаниеОшибки());
	КонецПопытки;
	
	ДанныеИзФайла = ПрочитатьДанныеРеестраИзТабличногоДокумента(ТаблицаФайла);
	Если ТипЗнч(ДанныеИзФайла) = Тип("Строка") Тогда
		ВызватьИсключение ДанныеИзФайла;
	КонецЕсли;
	
	Данные1С = ПолучитьДанныеПайщиковИз1С(Организация, ДанныеИзФайла.ПИФ, ДанныеИзФайла.ДатаРеестра);
	Расхождения = СформироватьТаблицуРасхождений(ДанныеИзФайла.Таблица, Данные1С);
	Результат.ТекстОтчета = ПолучитьHTMLОтчетаОРасхождениях(Расхождения, Организация, ДанныеИзФайла.ПИФ, ДанныеИзФайла.ДатаРеестра, ДанныеИзФайла.Таблица, Данные1С);
	Результат.Успех = Истина;
	
	Возврат Результат;
	
КонецФункции

Функция ПрочитатьДанныеРеестраИзТабличногоДокумента(ТаблицаФайла)
	
	Высота = ТаблицаФайла.ВысотаТаблицы;
	Ширина = ТаблицаФайла.ШиринаТаблицы;
	Если Высота = 0 Или Ширина = 0 Тогда
		Возврат "В файле нет данных.";
	КонецЕсли;
	
	МинСтрок = 13;
	МинКолонок = 9;
	Если Высота < МинСтрок Или Ширина < МинКолонок Тогда
		Возврат СтрШаблон("Файл не соответствует формату реестра: ожидается не менее %1 строк и %2 колонок.", МинСтрок, МинКолонок);
	КонецЕсли;
	
	ТекстСтр7 = СокрЛП(ТаблицаФайла.Область(7, 1, 7, 1).Текст);
	Если ТекстСтр7 <> "Информация из реестра владельцев инвестиционных паев" Тогда
		Возврат "Файл не соответствует формату реестра: в 7-й строке ожидается текст ""Информация из реестра владельцев инвестиционных паев"".";
	КонецЕсли;
	
	ТекстСтр8 = СокрЛП(ТаблицаФайла.Область(8, 1, 8, 1).Текст);
	Если Не СтрНачинаетсяС(ТекстСтр8, "Дата и время, на которую составлен список:") Тогда
		Возврат "Файл не соответствует формату реестра: в 8-й строке ожидается текст, начинающийся с ""Дата и время, на которую составлен список:"".";
	КонецЕсли;
	
	ТекстСтр9 = СокрЛП(ТаблицаФайла.Область(9, 1, 9, 1).Текст);
	Если Не СтрНачинаетсяС(ТекстСтр9, "Полное наименование фонда:") Тогда
		Возврат "Файл не соответствует формату реестра: в 9-й строке ожидается текст, начинающийся с ""Полное наименование фонда:"".";
	КонецЕсли;
	
	ТекстR11C1 = СокрЛП(ТаблицаФайла.Область(11, 1, 11, 1).Текст);
	ТекстR12C1 = СокрЛП(ТаблицаФайла.Область(12, 1, 12, 1).Текст);
	ТекстЗаголовокПП = СокрЛП(ТекстR11C1 + " " + ТекстR12C1);
	Если СтрНайти(ВРег(ТекстЗаголовокПП), "№ П/П") = 0 Тогда
		Возврат "Файл не соответствует формату реестра: в области R11C1:R12C1 ожидается заголовок колонки (например, ""№ п/п"").";
	КонецЕсли;
	
	ДатаРеестра = ИзвлечьДатуИзСтрокиРеестра(ТекстСтр8);
	Если ДатаРеестра = Неопределено Или Не ЗначениеЗаполнено(ДатаРеестра) Тогда
		Возврат "В 8-й строке не удалось извлечь дату составления реестра (ожидается ДД.ММ.ГГГГ).";
	КонецЕсли;
	
	ПозДвоеточие = СтрНайти(ТекстСтр9, ":");
	НаименованиеПИФ = ?(ПозДвоеточие > 0, СокрЛП(Сред(ТекстСтр9, ПозДвоеточие + 1)), "");
	Если Не ЗначениеЗаполнено(НаименованиеПИФ) Тогда
		Возврат "В 9-й строке не найдено наименование фонда после ""Полное наименование фонда:"".";
	КонецЕсли;
	
	ПИФ = Неопределено;
	КритерииПоиска = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеквизитыПИФСрез.ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд
		|ИЗ
		|	РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаРеестра, ) КАК РеквизитыПИФСрез
		|ГДЕ
		|	(ВЫРАЗИТЬ(РеквизитыПИФСрез.ПолноеНаименованиеФонда КАК СТРОКА(1000))) = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", НаименованиеПИФ);
	Запрос.УстановитьПараметр("ДатаРеестра", ДатаРеестра);
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Если Выборка.Следующий() Тогда
			ПИФ = Выборка.ПаевойИнвестиционныйФонд;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПИФ) Тогда
		Возврат СтрШаблон(
			"ПИФ не найден. Значение из файла: ""%1"".",
			НаименованиеПИФ);
	КонецЕсли;
	
	ПерваяСтрокаДанных = 13;
	КолонкаФИО = 3;
	КолонкаПаспорт = 5;
	КолонкаАдрес = 6;
	КолонкаБанковскиеРеквизиты = 8;
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ТипЛица", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(2)));
	Таблица.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(500)));
	Таблица.Колонки.Добавить("СерияПаспорта", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	Таблица.Колонки.Добавить("НомерПаспорта", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	Таблица.Колонки.Добавить("ИНН", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(12)));
	Таблица.Колонки.Добавить("ОГРН", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(15)));
	Таблица.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	Таблица.Колонки.Добавить("РасчетныйСчет", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("ДатаГосРегистрации", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("ОрганГосРегистрации", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(500)));
	
	Для НомерСтроки = ПерваяСтрокаДанных По Высота Цикл
		Лицо = СокрЛП(ТаблицаФайла.Область(НомерСтроки, КолонкаФИО, НомерСтроки, КолонкаФИО).Текст);
		Если Не ЗначениеЗаполнено(Лицо) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстРегистрации = СокрЛП(ТаблицаФайла.Область(НомерСтроки, КолонкаПаспорт, НомерСтроки, КолонкаПаспорт).Текст);
		ПризнакЮЛ = (СтрНайти(ВРег(ТекстРегистрации), "ОГРН") = 1);
		
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Идентификатор = Лицо;
		
		Если ПризнакЮЛ Тогда
			НоваяСтрока.ТипЛица = "ЮЛ";
			НоваяСтрока.СерияПаспорта = "";
			НоваяСтрока.НомерПаспорта = "";
			ДанныеРегЮЛ = ИзвлечьРеквизитыРегистрацииЮЛ(ТекстРегистрации);
			НоваяСтрока.ИНН = ДанныеРегЮЛ.ИНН;
			НоваяСтрока.ОГРН = ДанныеРегЮЛ.ОГРН;
			НоваяСтрока.ДатаГосРегистрации = ДанныеРегЮЛ.ДатаРегистрации;
			НоваяСтрока.ОрганГосРегистрации = ДанныеРегЮЛ.ОрганРегистрации;
		Иначе
			НоваяСтрока.ТипЛица = "ФЛ";
			РезультатПаспорт = ИзвлечьСерияИНомерПаспорта(ТекстРегистрации);
			НоваяСтрока.СерияПаспорта = РезультатПаспорт.Серия;
			НоваяСтрока.НомерПаспорта = РезультатПаспорт.Номер;
			НоваяСтрока.ИНН = "";
			НоваяСтрока.ОГРН = "";
			ДанныеРегФЛ = ИзвлечьРеквизитыРегистрацииФЛ(ТекстРегистрации);
			НоваяСтрока.ДатаГосРегистрации = ДанныеРегФЛ.ДатаВыдачи;
			НоваяСтрока.ОрганГосРегистрации = ДанныеРегФЛ.ОрганВыдавший;
		КонецЕсли;
		
		НоваяСтрока.Адрес = СокрЛП(ТаблицаФайла.Область(НомерСтроки, КолонкаАдрес, НомерСтроки, КолонкаАдрес).Текст);
		
		ТекстБанк = СокрЛП(ТаблицаФайла.Область(НомерСтроки, КолонкаБанковскиеРеквизиты, НомерСтроки, КолонкаБанковскиеРеквизиты).Текст);
		НоваяСтрока.РасчетныйСчет = ИзвлечьНомерРасчетногоСчета(ТекстБанк);
	КонецЦикла;
	
	Если Таблица.Количество() = 0 Тогда
		Возврат "В файле не найдены данные пайщиков.";
	КонецЕсли;
	
	Возврат Новый Структура("Таблица, ДатаРеестра, ПИФ", Таблица, ДатаРеестра, ПИФ);
	
КонецФункции

Функция ИзвлечьДатуИзСтрокиРеестра(ТекстСтроки)
	Если Не ЗначениеЗаполнено(ТекстСтроки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТекстСтроки = СтрЗаменить(ТекстСтроки, Символы.Таб, " ");
	Для i = 1 По СтрДлина(ТекстСтроки) - 9 Цикл
		Часть = Сред(ТекстСтроки, i, 10);
		Если Сред(Часть, 3, 1) = "." И Сред(Часть, 6, 1) = "." Тогда
			Попытка
				День = Число(Лев(Часть, 2));
				Месяц = Число(Сред(Часть, 4, 2));
				Год = Число(Сред(Часть, 7, 4));
				Если День >= 1 И День <= 31 И Месяц >= 1 И Месяц <= 12 И Год >= 2000 И Год <= 2100 Тогда
					РезультатДаты = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Часть);
					Если РезультатДаты <> Неопределено Тогда
						Возврат РезультатДаты;
					КонецЕсли;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Для i = 1 По СтрДлина(ТекстСтроки) - 7 Цикл
		Часть = Сред(ТекстСтроки, i, 8);
		Если Сред(Часть, 3, 1) = "." И Сред(Часть, 6, 1) = "." Тогда
			Попытка
				День = Число(Лев(Часть, 2));
				Месяц = Число(Сред(Часть, 4, 2));
				Если День >= 1 И День <= 31 И Месяц >= 1 И Месяц <= 12 Тогда
					РезультатДаты = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Часть);
					Если РезультатДаты <> Неопределено И Год(РезультатДаты) >= 2000 И Год(РезультатДаты) <= 2100 Тогда
						Возврат РезультатДаты;
					КонецЕсли;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Слова = СтрРазделить(ТекстСтроки, " .,;:-", Ложь);
	Для Каждого Слово Из Слова Цикл
		Слово = СокрЛП(Слово);
		Если СтрДлина(Слово) >= 6 Тогда
			Попытка
				ПопыткаДаты = Дата(Слово);
				Если Год(ПопыткаДаты) >= 2000 И Год(ПопыткаДаты) <= 2100 Тогда
					Возврат ПопыткаДаты;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Слово Из Слова Цикл
		Слово = СокрЛП(Слово);
		Если СтрНайти(Слово, ".") > 0 Тогда
			Части = СтрРазделить(Слово, ".");
			Если Части.Количество() >= 3 Тогда
				Попытка
					ДеньСтрока = СокрЛП(Части[Части.НижняяГраница()]);
					МесяцСтрока = СокрЛП(Части[Части.НижняяГраница() + 1]);
					ГодСтрока = СокрЛП(Части[Части.НижняяГраница() + 2]);
					День = Число(ДеньСтрока);
					Месяц = Число(МесяцСтрока);
					Если СтрДлина(ГодСтрока) >= 4 Тогда
						Год = Число(Лев(ГодСтрока, 4));
					ИначеЕсли СтрДлина(ГодСтрока) = 2 Тогда
						Год = 2000 + Число(ГодСтрока);
					Иначе
						Продолжить;
					КонецЕсли;
					Если День >= 1 И День <= 31 И Месяц >= 1 И Месяц <= 12 И Год >= 2000 И Год <= 2100 Тогда
						Возврат Дата(Год, Месяц, День);
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ТолькоЦифрыИТочки = "";
	Для i = 1 По СтрДлина(ТекстСтроки) Цикл
		Символ = Сред(ТекстСтроки, i, 1);
		Если Найти("0123456789.", Символ) > 0 Тогда
			ТолькоЦифрыИТочки = ТолькоЦифрыИТочки + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ПустаяСтрока(ТолькоЦифрыИТочки) Тогда
		Части = СтрРазделить(ТолькоЦифрыИТочки, ".");
		Если Части.Количество() >= 3 Тогда
			НГ = Части.НижняяГраница();
			Для i = НГ По Части.ВГраница() - 2 Цикл
				Попытка
					ДеньСтрока = Части[i];
					МесяцСтрока = Части[i + 1];
					ГодСтрока = Части[i + 2];
					Если СтрДлина(ДеньСтрока) <= 0 Или СтрДлина(МесяцСтрока) <= 0 Или СтрДлина(ГодСтрока) <= 0 Тогда
						Продолжить;
					КонецЕсли;
					
					День = Число(ДеньСтрока);
					Месяц = Число(МесяцСтрока);
					Год = Число(ГодСтрока);
					Если Год < 100 Тогда
						Год = 2000 + Год;
					КонецЕсли;
					Если День >= 1 И День <= 31 И 
					   Месяц >= 1 И Месяц <= 12 И 
					   Год >= 2000 И Год <= 2100 Тогда
						Возврат Дата(Год, Месяц, День);
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(ТекстСтроки) Цикл
		Если Позиция + 9 <= СтрДлина(ТекстСтроки) Тогда
			Подстрока = Сред(ТекстСтроки, Позиция, 10);
			Если Сред(Подстрока, 3, 1) = "." И Сред(Подстрока, 6, 1) = "." Тогда
				Попытка
					Число1 = Число(Сред(Подстрока, 1, 2));
					Число2 = Число(Сред(Подстрока, 4, 2));
					Число3 = Число(Сред(Подстрока, 7, 4));
					Если Число1 >= 1 И Число1 <= 31 И 
					   Число2 >= 1 И Число2 <= 12 И 
					   Число3 >= 2000 Тогда
						Возврат Дата(Число3, Число2, Число1);
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		Если Позиция + 7 <= СтрДлина(ТекстСтроки) Тогда
			Подстрока = Сред(ТекстСтроки, Позиция, 8);
			
			Если Сред(Подстрока, 3, 1) = "." И Сред(Подстрока, 6, 1) = "." Тогда
				Попытка
					Число1 = Число(Сред(Подстрока, 1, 2));
					Число2 = Число(Сред(Подстрока, 4, 2));
					Число3 = Число(Сред(Подстрока, 7, 2));
					
					Если Число1 >= 1 И Число1 <= 31 И 
					   Число2 >= 1 И Число2 <= 12 Тогда
						Год = 2000 + Число3;
						Если Год >= 2000 И Год <= 2100 Тогда
							Возврат Дата(Год, Число2, Число1);
						КонецЕсли;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для i = 1 По СтрДлина(ТекстСтроки) - 3 Цикл
		ЧетыреЦифры = Сред(ТекстСтроки, i, 4);
		Попытка
			Год = Число(ЧетыреЦифры);
			Если Год >= 2000 И Год <= 2100 Тогда
				Возврат Дата(Год, 1, 1);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ИзвлечьСерияИНомерПаспорта(ТекстПаспорта)
	Результат = Новый Структура("Серия, Номер", "", "");
	Если Не ЗначениеЗаполнено(ТекстПаспорта) Тогда
		Возврат Результат;
	КонецЕсли;
	Части = СтрРазделить(ТекстПаспорта, ",", Ложь);
	Для Инд = 0 По Части.ВГраница() Цикл
		Часть = СокрЛП(Части[Инд]);
		Если СтрДлина(Часть) <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Цифры = РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(Часть, " ");
		Если Цифры = "0" Тогда
			Цифры = "";
		КонецЕсли;
		Если СтрДлина(Цифры) >= 4 И СтрДлина(Цифры) <= 6 И Не ЗначениеЗаполнено(Результат.Серия) Тогда
			Результат.Серия = Лев(Цифры, Мин(4, СтрДлина(Цифры)));
			Если СтрДлина(Цифры) > 4 Тогда
				Результат.Номер = Сред(Цифры, 5);
			КонецЕсли;
		ИначеЕсли СтрДлина(Цифры) >= 6 И Не ЗначениеЗаполнено(Результат.Номер) Тогда
			Результат.Номер = Цифры;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ИзвлечьНомерРасчетногоСчета(ТекстБанковскихРеквизитов)
	Если Не ЗначениеЗаполнено(ТекстБанковскихРеквизитов) Тогда
		Возврат "";
	КонецЕсли;
	ПозРс = СтрНайти(ВРег(ТекстБанковскихРеквизитов), "Р/С ");
	Если ПозРс > 0 Тогда
		Часть = СокрЛП(Сред(ТекстБанковскихРеквизитов, ПозРс + 4));
		ЧастиРс = СтрРазделить(Часть, ";", Ложь);
		Часть = ?(ЧастиРс.Количество() > 0, СокрЛП(ЧастиРс[0]), "");
		ЧастиПробел = СтрРазделить(Часть, " ", Ложь);
		Часть = ?(ЧастиПробел.Количество() > 0, СокрЛП(ЧастиПробел[0]), "");
		Цифры = РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(Часть, " ");
		Если Цифры <> "0" И СтрДлина(Цифры) = 20 Тогда
			Возврат Цифры;
		КонецЕсли;
	КонецЕсли;
	Поз = СтрНайти(ТекстБанковскихРеквизитов, "№ ");
	Если Поз > 0 Тогда
		Часть = СокрЛП(Сред(ТекстБанковскихРеквизитов, Поз + 2));
		Цифры = РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(Часть);
		Если Цифры <> "0" И СтрДлина(Цифры) = 20 Тогда
			Возврат Цифры;
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ИзвлечьИННИОГРНИзСтрокиРегистрации(ТекстРегистрации)
	Результат = Новый Структура("ИНН, ОГРН", "", "");
	Если Не ЗначениеЗаполнено(ТекстРегистрации) Тогда
		Возврат Результат;
	КонецЕсли;
	ТекстВерх = ВРег(ТекстРегистрации);
	ПозОГРН = СтрНайти(ТекстВерх, "ОГРН");
	Если ПозОГРН > 0 Тогда
		Хвост = СокрЛП(Сред(ТекстРегистрации, ПозОГРН + 4));
		ЦифрыОГРН = РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(Хвост);
		Если ЦифрыОГРН <> "0" И (СтрДлина(ЦифрыОГРН) = 13 Или СтрДлина(ЦифрыОГРН) = 15) Тогда
			Результат.ОГРН = ЦифрыОГРН;
		КонецЕсли;
	КонецЕсли;
	ПозИНН = СтрНайти(ТекстВерх, "ИНН:");
	Если ПозИНН = 0 Тогда
		ПозИНН = СтрНайти(ТекстВерх, "ИНН ");
		Если ПозИНН > 0 Тогда
			ПозИНН = ПозИНН + 3;
		КонецЕсли;
	Иначе
		ПозИНН = ПозИНН + 4;
	КонецЕсли;
	Если ПозИНН > 0 Тогда
		Хвост = СокрЛП(Сред(ТекстРегистрации, ПозИНН));
		ЦифрыИНН = РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(Хвост);
		Если ЦифрыИНН <> "0" И (СтрДлина(ЦифрыИНН) = 10 Или СтрДлина(ЦифрыИНН) = 12) Тогда
			Результат.ИНН = ЦифрыИНН;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ИзвлечьРеквизитыРегистрацииЮЛ(ТекстРегистрации)
	
	Результат = Новый Структура("ИНН, ОГРН, ДатаРегистрации, ОрганРегистрации", "", "", Неопределено, "");
	
	Если Не ЗначениеЗаполнено(ТекстРегистрации) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДанныеИННОГРН = ИзвлечьИННИОГРНИзСтрокиРегистрации(ТекстРегистрации);
	Результат.ИНН = ДанныеИННОГРН.ИНН;
	Результат.ОГРН = ДанныеИННОГРН.ОГРН;
	
	ДатаРег = ИзвлечьДатуИзСтрокиРеестра(ТекстРегистрации);
	Если ДатаРег <> Неопределено Тогда
		Результат.ДатаРегистрации = ДатаРег;
		
		СтрокаДата = Формат(ДатаРег, "ДФ=dd.MM.yyyy");
		ПозДата = СтрНайти(ТекстРегистрации, СтрокаДата);
		Если ПозДата > 0 Тогда
			НачалоОргана = ПозДата + СтрДлина(СтрокаДата);
			Пока НачалоОргана <= СтрДлина(ТекстРегистрации) Цикл
				Симв = Сред(ТекстРегистрации, НачалоОргана, 1);
				Если Симв <> " " И Симв <> "," Тогда
					Прервать;
				КонецЕсли;
				НачалоОргана = НачалоОргана + 1;
			КонецЦикла;
			
			Если НачалоОргана <= СтрДлина(ТекстРегистрации) Тогда
				Хвост = Сред(ТекстРегистрации, НачалоОргана);
				ХвостВерх = ВРег(Хвост);
				ПозИНН = СтрНайти(ХвостВерх, "ИНН");
				Если ПозИНН > 0 Тогда
					Результат.ОрганРегистрации = СокрЛП(Лев(Хвост, ПозИНН - 1));
				Иначе
					Результат.ОрганРегистрации = СокрЛП(Хвост);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИзвлечьРеквизитыРегистрацииФЛ(ТекстРегистрации)
	
	Результат = Новый Структура("ДатаВыдачи, ОрганВыдавший", Неопределено, "");
	
	Если Не ЗначениеЗаполнено(ТекстРегистрации) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДатаВыдачи = ИзвлечьДатуИзСтрокиРеестра(ТекстРегистрации);
	Если ДатаВыдачи = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.ДатаВыдачи = ДатаВыдачи;
	СтрокаДата = Формат(ДатаВыдачи, "ДФ=dd.MM.yyyy");
	ПозДата = СтрНайти(ТекстРегистрации, СтрокаДата);
	Если ПозДата > 0 Тогда
		НачалоОргана = ПозДата + СтрДлина(СтрокаДата);
		Пока НачалоОргана <= СтрДлина(ТекстРегистрации) Цикл
			Симв = Сред(ТекстРегистрации, НачалоОргана, 1);
			Если Симв <> " " И Симв <> "," Тогда
				Прервать;
			КонецЕсли;
			НачалоОргана = НачалоОргана + 1;
		КонецЦикла;
		Если НачалоОргана <= СтрДлина(ТекстРегистрации) Тогда
			Хвост = Сред(ТекстРегистрации, НачалоОргана);
			Результат.ОрганВыдавший = СокрЛП(Хвост);
			Для Поз = 1 По СтрДлина(Хвост) - 5 Цикл
				Если Сред(Хвост, Поз, 1) = "," Тогда
					ЧастьПосле = СокрЛП(Сред(Хвост, Поз + 1, 10));
					Если СтрДлина(ЧастьПосле) >= 8 И Сред(ЧастьПосле, 3, 1) = "." И Сред(ЧастьПосле, 6, 1) = "." Тогда
						Результат.ОрганВыдавший = СокрЛП(Лев(Хвост, Поз - 1));
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеПайщиковИз1С(Организация, ПИФ, ДатаРеестра)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Доли.Пайщик КАК Пайщик,
		|	ВЫБОР
		|		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|			ТОГДА ""ФЛ""
		|		ИНАЧЕ ""ЮЛ""
		|	КОНЕЦ КАК ТипЛица,
		|	ВЫБОР
		|		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|			ТОГДА СОКРЛП(РеквизитыФЛ.Фамилия + "" "" + РеквизитыФЛ.Имя + "" "" + РеквизитыФЛ.Отчество)
		|		ИНАЧЕ ЕСТЬNULL(РеквизитыЮЛАнкетные.ПолноеНаименованиеПоУставу, ЕСТЬNULL(РеквизитыЮЛ.ПолноеНаименованиеПоУставу, """"))
		|	КОНЕЦ КАК Идентификатор,
		|	ВЫБОР
		|		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|			ТОГДА РеквизитыФЛ.СерияУдостоверенияЛичности
		|		ИНАЧЕ NULL
		|	КОНЕЦ КАК СерияПаспорта,
		|	ВЫБОР
		|		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|			ТОГДА РеквизитыФЛ.НомерУдостоверенияЛичности
		|		ИНАЧЕ NULL
		|	КОНЕЦ КАК НомерПаспорта,
		|	ВЫБОР
		|		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|			ТОГДА РеквизитыФЛ.ИНН
		|		ИНАЧЕ ЕСТЬNULL(РеквизитыЮЛАнкетные.ИНН, РеквизитыЮЛ.ИНН)
		|	КОНЕЦ КАК ИНН,
		|	ВЫБОР
		|		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
		|			ТОГДА ЕСТЬNULL(РеквизитыЮЛАнкетные.ОГРН, РеквизитыЮЛ.ОГРН)
		|		ИНАЧЕ NULL
		|	КОНЕЦ КАК ОГРН,
		|	ВЫБОР
		|		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|			ТОГДА ВЫБОР
		|					КОГДА РеквизитыФЛ.АдресРегистрации ЕСТЬ NULL
		|							ИЛИ РеквизитыФЛ.АдресРегистрации = """"
		|						ТОГДА РеквизитыФЛ.АдресМестаЖительства
		|					ИНАЧЕ РеквизитыФЛ.АдресРегистрации
		|				КОНЕЦ
		|		ИНАЧЕ ЕСТЬNULL(РеквизитыЮЛАнкетные.ЮридическийАдрес, """")
		|	КОНЕЦ КАК Адрес,
		|	ВЫБОР
		|		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|			ТОГДА РеквизитыФЛ.ДатаВыдачиУдостоверенияЛичности
		|		ИНАЧЕ ЕСТЬNULL(РеквизитыЮЛАнкетные.ДатаВыдачиОГРН, РеквизитыЮЛ.ДатаВыдачиОГРН)
		|	КОНЕЦ КАК ДатаГосРегистрации,
		|	ВЫБОР
		|		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|			ТОГДА РеквизитыФЛ.ОрганВыдавшийУдостоверениеЛичности
		|		ИНАЧЕ ЕСТЬNULL(РеквизитыЮЛАнкетные.ОрганВыдавшийОГРН, РеквизитыЮЛ.ОрганВыдавшийОГРН)
		|	КОНЕЦ КАК ОрганГосРегистрации,
		|	Счета.НомерСчета КАК НомерСчета
		|ИЗ
		|	(ВЫБРАТЬ
		|		ДолиПайщиков.Пайщик КАК Пайщик,
		|		ДолиПайщиков.КоличествоОстаток КАК КоличествоОстаток
		|	ИЗ
		|		РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.Остатки(
		|				&ДатаРеестра,
		|				Организация = &Организация
		|					И ПаевойИнвестиционныйФонд = &ПИФ) КАК ДолиПайщиков) КАК Доли
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК Лица
		|		ПО Доли.Пайщик = Лица.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&ДатаРеестра,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФЛ
		|		ПО Доли.Пайщик = РеквизитыФЛ.ЮрФизЛицо
		|			И (Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаРеестра,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮЛ
		|		ПО Доли.Пайщик = РеквизитыЮЛ.ЮрФизЛицо
		|			И (Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ДатаРеестра,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮЛАнкетные
		|		ПО Доли.Пайщик = РеквизитыЮЛАнкетные.ЮрФизЛицо
		|			И (Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо))
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			БанковскиеСчета.ЮрФизЛицо КАК ЮрФизЛицо,
		|			МАКСИМУМ(БанковскиеСчета.НомерСчета) КАК НомерСчета
		|		ИЗ
		|			Справочник.БанковскиеСчета КАК БанковскиеСчета
		|		ГДЕ
		|			БанковскиеСчета.ПометкаУдаления = ЛОЖЬ
		|			И БанковскиеСчета.Организация = &Организация
		|		
		|		СГРУППИРОВАТЬ ПО
		|			БанковскиеСчета.ЮрФизЛицо) КАК Счета
		|		ПО Доли.Пайщик = Счета.ЮрФизЛицо
		|ГДЕ
		|	Доли.КоличествоОстаток > 0";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПИФ", ПИФ);
	Запрос.УстановитьПараметр("ДатаРеестра", ДатаРеестра);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция НормализоватьИдентификаторДляКлюча(Строка)
	Строка = СокрЛП(Строка(Строка));
	Строка = СтрЗаменить(Строка, Символы.ПС, " ");
	Строка = СтрЗаменить(Строка, Символы.Таб, " ");
	Пока СтрНайти(Строка, "  ") > 0 Цикл
		Строка = СтрЗаменить(Строка, "  ", " ");
	КонецЦикла;
	Возврат ВРег(СокрЛП(Строка));
КонецФункции

Функция ПолучитьКлючПоискаВ1С(ТипЛица, Идентификатор, ИНН)
	Идентификатор = НормализоватьИдентификаторДляКлюча(Идентификатор);
	ИНН = ВРег(СокрЛП(Строка(ИНН)));
	Если ТипЛица = "ФЛ" Тогда
		Возврат "ФЛ|" + Идентификатор;
	КонецЕсли;
	Если ЗначениеЗаполнено(ИНН) Тогда
		Возврат "ЮЛ|" + ИНН;
	КонецЕсли;
	Возврат "ЮЛ|НАИМ|" + Идентификатор;
КонецФункции

Функция СформироватьТаблицуРасхождений(ТаблицаФайла, Данные1С)
	// Сопоставление записей файла и 1С, формирование строк расхождений по реквизитам
	Расхождения = Новый ТаблицаЗначений;
	Расхождения.Колонки.Добавить("ТипЛица", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ВидРасхождения", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("Реквизит", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ЗначениеВФайле", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ЗначениеВ1С", Новый ОписаниеТипов("Строка"));
	Словарь1С = Новый Соответствие;
	Для Каждого Строка1С Из Данные1С Цикл
		Ключ = ПолучитьКлючПоискаВ1С(Строка1С.ТипЛица, Строка1С.Идентификатор, Строка1С.ИНН);
		Словарь1С.Вставить(Ключ, Строка1С);
		Если Строка1С.ТипЛица = "ЮЛ" И ЗначениеЗаполнено(Строка1С.Идентификатор) Тогда
			Словарь1С.Вставить("ЮЛ|НАИМ|" + НормализоватьИдентификаторДляКлюча(Строка1С.Идентификатор), Строка1С);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаФайла Из ТаблицаФайла Цикл
		Ключ = ПолучитьКлючПоискаВ1С(СтрокаФайла.ТипЛица, СтрокаФайла.Идентификатор, СтрокаФайла.ИНН);
		Строка1С = Словарь1С.Получить(Ключ);
		Если Строка1С = Неопределено И СтрокаФайла.ТипЛица = "ЮЛ" Тогда
			Строка1С = Словарь1С.Получить("ЮЛ|НАИМ|" + НормализоватьИдентификаторДляКлюча(СтрокаФайла.Идентификатор));
		КонецЕсли;
		Если Строка1С = Неопределено И СтрокаФайла.ТипЛица = "ФЛ" Тогда
			ИдентФайлНорм = НормализоватьИдентификаторДляКлюча(СтрокаФайла.Идентификатор);
			Для Каждого Строка1СОбход Из Данные1С Цикл
				Если Строка1СОбход.ТипЛица = "ФЛ" И НормализоватьИдентификаторДляКлюча(Строка1СОбход.Идентификатор) = ИдентФайлНорм Тогда
					Строка1С = Строка1СОбход;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Строка1С = Неопределено Тогда
			Новая = Расхождения.Добавить();
			Новая.ТипЛица = СтрокаФайла.ТипЛица;
			Новая.Идентификатор = СтрокаФайла.Идентификатор;
			Новая.ВидРасхождения = "Лицо из файла реестра не найдено в 1С";
			Новая.Реквизит = "—";
			Новая.ЗначениеВФайле = "Указано в файле реестра";
			Новая.ЗначениеВ1С = "—";
			Продолжить;
		КонецЕсли;
		Если СтрокаФайла.ТипЛица = "ФЛ" Тогда
			ПаспортФайл = СокрЛП(Строка(СтрокаФайла.СерияПаспорта) + " " + Строка(СтрокаФайла.НомерПаспорта));
			Паспорт1С = СокрЛП(Строка(Строка1С.СерияПаспорта) + " " + Строка(Строка1С.НомерПаспорта));
			Если ПаспортФайл <> Паспорт1С И (ЗначениеЗаполнено(ПаспортФайл) Или ЗначениеЗаполнено(Паспорт1С)) Тогда
				Новая = Расхождения.Добавить();
				Новая.ТипЛица = СтрокаФайла.ТипЛица;
				Новая.Идентификатор = СтрокаФайла.Идентификатор;
				Новая.ВидРасхождения = "Не совпадает";
				Новая.Реквизит = "Паспорт";
				Новая.ЗначениеВФайле = ПаспортФайл;
				Новая.ЗначениеВ1С = Паспорт1С;
			КонецЕсли;
		Иначе
			НаимФайл = СокрЛП(Строка(СтрокаФайла.Идентификатор));
			Наим1С = СокрЛП(Строка(Строка1С.Идентификатор));
			Если НаимФайл <> Наим1С И (ЗначениеЗаполнено(НаимФайл) Или ЗначениеЗаполнено(Наим1С)) Тогда
				Новая = Расхождения.Добавить();
				Новая.ТипЛица = СтрокаФайла.ТипЛица;
				Новая.Идентификатор = СтрокаФайла.Идентификатор;
				Новая.ВидРасхождения = "Не совпадает";
				Новая.Реквизит = "Наименование";
				Новая.ЗначениеВФайле = НаимФайл;
				Новая.ЗначениеВ1С = Наим1С;
			КонецЕсли;
			ИННФайл = СокрЛП(Строка(СтрокаФайла.ИНН));
			ИНН1С = СокрЛП(Строка(Строка1С.ИНН));
			Если ИННФайл <> ИНН1С И (ЗначениеЗаполнено(ИННФайл) Или ЗначениеЗаполнено(ИНН1С)) Тогда
				Новая = Расхождения.Добавить();
				Новая.ТипЛица = СтрокаФайла.ТипЛица;
				Новая.Идентификатор = СтрокаФайла.Идентификатор;
				Новая.ВидРасхождения = "Не совпадает";
				Новая.Реквизит = "ИНН";
				Новая.ЗначениеВФайле = ИННФайл;
				Новая.ЗначениеВ1С = ИНН1С;
			КонецЕсли;
			ОГРНФайл = СокрЛП(Строка(СтрокаФайла.ОГРН));
			ОГРН1С = СокрЛП(Строка(Строка1С.ОГРН));
			Если ОГРНФайл <> ОГРН1С И (ЗначениеЗаполнено(ОГРНФайл) Или ЗначениеЗаполнено(ОГРН1С)) Тогда
				Новая = Расхождения.Добавить();
				Новая.ТипЛица = СтрокаФайла.ТипЛица;
				Новая.Идентификатор = СтрокаФайла.Идентификатор;
				Новая.ВидРасхождения = "Не совпадает";
				Новая.Реквизит = "ОГРН";
				Новая.ЗначениеВФайле = ОГРНФайл;
				Новая.ЗначениеВ1С = ОГРН1С;
			КонецЕсли;
		КонецЕсли;
		АдресФайл = СокрЛП(Строка(СтрокаФайла.Адрес));
		Адрес1С = СокрЛП(Строка(Строка1С.Адрес));
		Если АдресФайл <> Адрес1С И (ЗначениеЗаполнено(АдресФайл) Или ЗначениеЗаполнено(Адрес1С)) Тогда
			Новая = Расхождения.Добавить();
			Новая.ТипЛица = СтрокаФайла.ТипЛица;
			Новая.Идентификатор = СтрокаФайла.Идентификатор;
			Новая.ВидРасхождения = "Не совпадает";
			Новая.Реквизит = "Адрес";
			Новая.ЗначениеВФайле = АдресФайл;
			Новая.ЗначениеВ1С = Адрес1С;
		КонецЕсли;
		РсФайл = СокрЛП(Строка(СтрокаФайла.РасчетныйСчет));
		Рс1С = СокрЛП(Строка(Строка1С.НомерСчета));
		Если РсФайл <> Рс1С И (ЗначениеЗаполнено(РсФайл) Или ЗначениеЗаполнено(Рс1С)) Тогда
			Новая = Расхождения.Добавить();
			Новая.ТипЛица = СтрокаФайла.ТипЛица;
			Новая.Идентификатор = СтрокаФайла.Идентификатор;
			Новая.ВидРасхождения = "Не совпадает";
			Новая.Реквизит = "Расчётный счёт";
			Новая.ЗначениеВФайле = РсФайл;
			Новая.ЗначениеВ1С = Рс1С;
		КонецЕсли;
		ДатаРегФайл = СтрокаФайла.ДатаГосРегистрации;
		ДатаРег1С = Строка1С.ДатаГосРегистрации;
		Если (ДатаРегФайл <> ДатаРег1С) И (ЗначениеЗаполнено(ДатаРегФайл) Или ЗначениеЗаполнено(ДатаРег1С)) Тогда
			Новая = Расхождения.Добавить();
			Новая.ТипЛица = СтрокаФайла.ТипЛица;
			Новая.Идентификатор = СтрокаФайла.Идентификатор;
			Новая.ВидРасхождения = "Не совпадает";
			Новая.Реквизит = "Дата гос. регистрации / выдачи документа";
			Новая.ЗначениеВФайле = ?(ЗначениеЗаполнено(ДатаРегФайл), Формат(ДатаРегФайл, "ДФ=dd.MM.yyyy"), "");
			Новая.ЗначениеВ1С = ?(ЗначениеЗаполнено(ДатаРег1С), Формат(ДатаРег1С, "ДФ=dd.MM.yyyy"), "");
		КонецЕсли;
		ОрганРегФайл = СокрЛП(Строка(СтрокаФайла.ОрганГосРегистрации));
		ОрганРег1С = СокрЛП(Строка(Строка1С.ОрганГосРегистрации));
		Если ОрганРегФайл <> ОрганРег1С И (ЗначениеЗаполнено(ОрганРегФайл) Или ЗначениеЗаполнено(ОрганРег1С)) Тогда
			Новая = Расхождения.Добавить();
			Новая.ТипЛица = СтрокаФайла.ТипЛица;
			Новая.Идентификатор = СтрокаФайла.Идентификатор;
			Новая.ВидРасхождения = "Не совпадает";
			Новая.Реквизит = "Орган, осуществивший регистрацию / выдавший документ";
			Новая.ЗначениеВФайле = ОрганРегФайл;
			Новая.ЗначениеВ1С = ОрганРег1С;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Строка1С Из Данные1С Цикл
		Ключ = ПолучитьКлючПоискаВ1С(Строка1С.ТипЛица, Строка1С.Идентификатор, Строка1С.ИНН);
		НайденВФайле = Ложь;
		Для Каждого СтрокаФайла Из ТаблицаФайла Цикл
			КлючФ = ПолучитьКлючПоискаВ1С(СтрокаФайла.ТипЛица, СтрокаФайла.Идентификатор, СтрокаФайла.ИНН);
			Если КлючФ = Ключ Тогда
				НайденВФайле = Истина;
				Прервать;
			КонецЕсли;
			Если СтрокаФайла.ТипЛица = "ЮЛ" И Строка1С.ТипЛица = "ЮЛ" Тогда
				Если ВРег(СокрЛП(Строка(СтрокаФайла.Идентификатор))) = ВРег(СокрЛП(Строка(Строка1С.Идентификатор))) Или
					(ЗначениеЗаполнено(СтрокаФайла.ИНН) И СокрЛП(Строка(СтрокаФайла.ИНН)) = СокрЛП(Строка(Строка1С.ИНН))) Тогда
					НайденВФайле = Истина;
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если Не НайденВФайле Тогда
			Новая = Расхождения.Добавить();
			Новая.ТипЛица = Строка1С.ТипЛица;
			Новая.Идентификатор = Строка1С.Идентификатор;
			Новая.ВидРасхождения = "Лицо из 1С отсутствует в файле реестра";
			Новая.Реквизит = "—";
			Новая.ЗначениеВФайле = "—";
			Новая.ЗначениеВ1С = "Указано в 1С";
		КонецЕсли;
	КонецЦикла;
	Возврат Расхождения;
КонецФункции

Функция ПреобразоватьРасхожденияВФорматОтчетаОРасхождениях(Расхождения, ТаблицаФайла, Данные1С)
	КлючевыеПоля = Новый Массив;
	КлючевыеПоля.Добавить("ТипЛица");
	КлючевыеПоля.Добавить("Идентификатор");
	СравниваемыеПоля = Новый Массив;
	СравниваемыеПоля.Добавить("Паспорт");
	СравниваемыеПоля.Добавить("Наименование");
	СравниваемыеПоля.Добавить("ИНН");
	СравниваемыеПоля.Добавить("ОГРН");
	СравниваемыеПоля.Добавить("Адрес");
	СравниваемыеПоля.Добавить("РасчетныйСчет");
	СравниваемыеПоля.Добавить("ДатаГосРегистрации");
	СравниваемыеПоля.Добавить("ОрганГосРегистрации");
	СоответствиеРеквизитПоле = Новый Соответствие;
	СоответствиеРеквизитПоле.Вставить("Паспорт", "Паспорт");
	СоответствиеРеквизитПоле.Вставить("Наименование", "Наименование");
	СоответствиеРеквизитПоле.Вставить("ИНН", "ИНН");
	СоответствиеРеквизитПоле.Вставить("ОГРН", "ОГРН");
	СоответствиеРеквизитПоле.Вставить("Адрес", "Адрес");
	СоответствиеРеквизитПоле.Вставить("Расчётный счёт", "РасчетныйСчет");
	СоответствиеРеквизитПоле.Вставить("Дата гос. регистрации / выдачи документа", "ДатаГосРегистрации");
	СоответствиеРеквизитПоле.Вставить("Орган, осуществивший регистрацию / выдавший документ", "ОрганГосРегистрации");
	НоваяЗапись = 1;
	ЗаписьУдалена = 2;
	ЗаписьИзменена = 3;
	УникальныеПары = Новый Соответствие;
	Для Каждого СтрокаРасх Из Расхождения Цикл
		КлючПара = СтрокаРасх.ТипЛица + "|" + НормализоватьИдентификаторДляКлюча(СтрокаРасх.Идентификатор);
		Если УникальныеПары.Получить(КлючПара) = Неопределено Тогда
			Вариант = 0;
			Если СтрокаРасх.ВидРасхождения = "Лицо из файла реестра не найдено в 1С" Тогда
				Вариант = НоваяЗапись;
			ИначеЕсли СтрокаРасх.ВидРасхождения = "Лицо из 1С отсутствует в файле реестра" Тогда
				Вариант = ЗаписьУдалена;
			ИначеЕсли СтрокаРасх.ВидРасхождения = "Не совпадает" Тогда
				Вариант = ЗаписьИзменена;
			КонецЕсли;
			УникальныеПары.Вставить(КлючПара, Новый Структура("ТипЛица, Идентификатор, ВариантРасхождения", СтрокаРасх.ТипЛица, СтрокаРасх.Идентификатор, Вариант));
		КонецЕсли;
	КонецЦикла;
	Словарь1С = Новый Соответствие;
	Для Каждого Строка1С Из Данные1С Цикл
		Ключ = ПолучитьКлючПоискаВ1С(Строка1С.ТипЛица, Строка1С.Идентификатор, Строка1С.ИНН);
		Словарь1С.Вставить(Ключ, Строка1С);
		Если Строка1С.ТипЛица = "ЮЛ" И ЗначениеЗаполнено(Строка1С.Идентификатор) Тогда
			Словарь1С.Вставить("ЮЛ|НАИМ|" + НормализоватьИдентификаторДляКлюча(Строка1С.Идентификатор), Строка1С);
		КонецЕсли;
	КонецЦикла;
	РасхожденияПоРеквизитам = Новый Соответствие;
	Для Каждого СтрокаРасх Из Расхождения Цикл
		КлючПара = СтрокаРасх.ТипЛица + "|" + НормализоватьИдентификаторДляКлюча(СтрокаРасх.Идентификатор);
		ИмяПоля = СоответствиеРеквизитПоле.Получить(СтрокаРасх.Реквизит);
		Если ИмяПоля = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Подзапись = РасхожденияПоРеквизитам.Получить(КлючПара);
		Если Подзапись = Неопределено Тогда
			Подзапись = Новый Структура;
			РасхожденияПоРеквизитам.Вставить(КлючПара, Подзапись);
		КонецЕсли;
		Подзапись.Вставить(ИмяПоля, Новый Структура("Тек, Нов", СтрокаРасх.ЗначениеВ1С, СтрокаРасх.ЗначениеВФайле));
	КонецЦикла;
	ТаблицаОтчета = Новый ТаблицаЗначений;
	ТаблицаОтчета.Колонки.Добавить("ТипЛица", Новый ОписаниеТипов("Строка"));
	ТаблицаОтчета.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	ТаблицаОтчета.Колонки.Добавить("ВариантРасхождения", Новый ОписаниеТипов("Число"));
	Для Каждого ИмяПоля Из СравниваемыеПоля Цикл
		ТаблицаОтчета.Колонки.Добавить("_Тек_" + ИмяПоля, Новый ОписаниеТипов("Строка"));
		ТаблицаОтчета.Колонки.Добавить("_Нов_" + ИмяПоля, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	СчетчикНовая = 0;
	СчетчикУдалена = 0;
	СчетчикИзменена = 0;
	Для Каждого ЭлементПары Из УникальныеПары Цикл
		Пара = ЭлементПары.Значение;
		СтрокаФайла = Неопределено;
		Для Каждого СтрокаФ Из ТаблицаФайла Цикл
			Если СтрокаФ.ТипЛица = Пара.ТипЛица И НормализоватьИдентификаторДляКлюча(СтрокаФ.Идентификатор) = НормализоватьИдентификаторДляКлюча(Пара.Идентификатор) Тогда
				СтрокаФайла = СтрокаФ;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Строка1С = Неопределено;
		Если СтрокаФайла <> Неопределено Тогда
			Ключ = ПолучитьКлючПоискаВ1С(СтрокаФайла.ТипЛица, СтрокаФайла.Идентификатор, СтрокаФайла.ИНН);
			Строка1С = Словарь1С.Получить(Ключ);
			Если Строка1С = Неопределено И СтрокаФайла.ТипЛица = "ЮЛ" Тогда
				Строка1С = Словарь1С.Получить("ЮЛ|НАИМ|" + НормализоватьИдентификаторДляКлюча(СтрокаФайла.Идентификатор));
			КонецЕсли;
		КонецЕсли;
		Если Строка1С = Неопределено И Пара.ВариантРасхождения = ЗаписьУдалена Тогда
			Для Каждого Строка1СОбход Из Данные1С Цикл
				Если Строка1СОбход.ТипЛица = Пара.ТипЛица И НормализоватьИдентификаторДляКлюча(Строка1СОбход.Идентификатор) = НормализоватьИдентификаторДляКлюча(Пара.Идентификатор) Тогда
					Строка1С = Строка1СОбход;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		НоваяСтрока = ТаблицаОтчета.Добавить();
		НоваяСтрока.ТипЛица = Пара.ТипЛица;
		НоваяСтрока.Идентификатор = Пара.Идентификатор;
		НоваяСтрока.ВариантРасхождения = Пара.ВариантРасхождения;
		Если Пара.ВариантРасхождения = НоваяЗапись Тогда
			СчетчикНовая = СчетчикНовая + 1;
		ИначеЕсли Пара.ВариантРасхождения = ЗаписьУдалена Тогда
			СчетчикУдалена = СчетчикУдалена + 1;
		Иначе
			СчетчикИзменена = СчетчикИзменена + 1;
		КонецЕсли;
		ПаспортТек = "";
		ПаспортНов = "";
		НаимТек = "";
		НаимНов = "";
		Если Строка1С <> Неопределено Тогда
			ПаспортТек = СокрЛП(Строка(Строка1С.СерияПаспорта) + " " + Строка(Строка1С.НомерПаспорта));
			НаимТек = СокрЛП(Строка(Строка1С.Идентификатор));
		КонецЕсли;
		Если СтрокаФайла <> Неопределено Тогда
			ПаспортНов = СокрЛП(Строка(СтрокаФайла.СерияПаспорта) + " " + Строка(СтрокаФайла.НомерПаспорта));
			НаимНов = СокрЛП(Строка(СтрокаФайла.Идентификатор));
		КонецЕсли;
		НоваяСтрока._Тек_Паспорт = ПаспортТек;
		НоваяСтрока._Нов_Паспорт = ПаспортНов;
		НоваяСтрока._Тек_Наименование = НаимТек;
		НоваяСтрока._Нов_Наименование = НаимНов;
		НоваяСтрока._Тек_ИНН = Строка(?(Строка1С = Неопределено, "", Строка1С.ИНН));
		НоваяСтрока._Нов_ИНН = Строка(?(СтрокаФайла = Неопределено, "", СтрокаФайла.ИНН));
		НоваяСтрока._Тек_ОГРН = Строка(?(Строка1С = Неопределено, "", Строка1С.ОГРН));
		НоваяСтрока._Нов_ОГРН = Строка(?(СтрокаФайла = Неопределено, "", СтрокаФайла.ОГРН));
		НоваяСтрока._Тек_Адрес = Строка(?(Строка1С = Неопределено, "", Строка1С.Адрес));
		НоваяСтрока._Нов_Адрес = Строка(?(СтрокаФайла = Неопределено, "", СтрокаФайла.Адрес));
		НоваяСтрока._Тек_РасчетныйСчет = Строка(?(Строка1С = Неопределено, "", Строка1С.НомерСчета));
		НоваяСтрока._Нов_РасчетныйСчет = Строка(?(СтрокаФайла = Неопределено, "", СтрокаФайла.РасчетныйСчет));
		НоваяСтрока._Тек_ДатаГосРегистрации = ?(Строка1С = Неопределено Или Не ЗначениеЗаполнено(Строка1С.ДатаГосРегистрации), "", Формат(Строка1С.ДатаГосРегистрации, "ДФ=dd.MM.yyyy"));
		НоваяСтрока._Нов_ДатаГосРегистрации = ?(СтрокаФайла = Неопределено Или Не ЗначениеЗаполнено(СтрокаФайла.ДатаГосРегистрации), "", Формат(СтрокаФайла.ДатаГосРегистрации, "ДФ=dd.MM.yyyy"));
		НоваяСтрока._Тек_ОрганГосРегистрации = Строка(?(Строка1С = Неопределено, "", Строка1С.ОрганГосРегистрации));
		НоваяСтрока._Нов_ОрганГосРегистрации = Строка(?(СтрокаФайла = Неопределено, "", СтрокаФайла.ОрганГосРегистрации));
		КлючПара = Пара.ТипЛица + "|" + НормализоватьИдентификаторДляКлюча(Пара.Идентификатор);
		Подзапись = РасхожденияПоРеквизитам.Получить(КлючПара);
		Если Подзапись <> Неопределено Тогда
			Для Каждого КлючИЗнач Из Подзапись Цикл
				ИмяПоля = КлючИЗнач.Ключ;
				ЗначТекНов = КлючИЗнач.Значение;
				НоваяСтрока["_Тек_" + ИмяПоля] = Строка(ЗначТекНов.Тек);
				НоваяСтрока["_Нов_" + ИмяПоля] = Строка(ЗначТекНов.Нов);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Результат = Новый Структура;
	Результат.Вставить("ЕстьРасхождения", (СчетчикНовая + СчетчикУдалена + СчетчикИзменена) > 0);
	Результат.Вставить("НоваяЗапись", СчетчикНовая);
	Результат.Вставить("ЗаписьУдалена", СчетчикУдалена);
	Результат.Вставить("ЗаписьИзменена", СчетчикИзменена);
	Результат.Вставить("Таблица", ТаблицаОтчета);
	Возврат Результат;
КонецФункции

Функция ПолучитьHTMLОтчетаОРасхождениях(Расхождения, Организация, ПИФ, ДатаРеестра, ТаблицаФайла, Данные1С)
	ФорматРасхождений = ПреобразоватьРасхожденияВФорматОтчетаОРасхождениях(Расхождения, ТаблицаФайла, Данные1С);
	КлючевыеПоля = Новый Массив;
	КлючевыеПоля.Добавить("ТипЛица");
	КлючевыеПоля.Добавить("Идентификатор");
	СравниваемыеПоля = Новый Массив;
	СравниваемыеПоля.Добавить("Паспорт");
	СравниваемыеПоля.Добавить("Наименование");
	СравниваемыеПоля.Добавить("ИНН");
	СравниваемыеПоля.Добавить("ОГРН");
	СравниваемыеПоля.Добавить("Адрес");
	СравниваемыеПоля.Добавить("РасчетныйСчет");
	СравниваемыеПоля.Добавить("ДатаГосРегистрации");
	СравниваемыеПоля.Добавить("ОрганГосРегистрации");
	HTMLОтчет = РаботаСОтчетами.ПодготовитьОтчетОРасхождениях(ФорматРасхождений, КлючевыеПоля, СравниваемыеПоля);
	ЗаголовокHTML = "<!DOCTYPE html><html><head><meta charset=""utf-8""><title>Сверка с реестром</title></head><body>";
	ЗаголовокHTML = ЗаголовокHTML + "<p>Организация: " + Строка(Организация) + "</p>";
	ЗаголовокHTML = ЗаголовокHTML + "<p>ПИФ: " + Строка(ПИФ) + "</p>";
	ЗаголовокHTML = ЗаголовокHTML + "<p>Дата реестра: " + Формат(ДатаРеестра, "ДФ=dd.MM.yyyy") + "</p>";
	Возврат ЗаголовокHTML + HTMLОтчет + "</body></html>";
КонецФункции