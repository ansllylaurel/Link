Функция НормализоватьИдентификаторДляКлюча(Строка)
	Строка = СокрЛП(Строка(Строка));
	Строка = СтрЗаменить(Строка, Символы.ПС, " ");
	Строка = СтрЗаменить(Строка, Символы.Таб, " ");
	Пока СтрНайти(Строка, "  ") > 0 Цикл
		Строка = СтрЗаменить(Строка, "  ", " ");
	КонецЦикла;
	Возврат ВРег(СокрЛП(Строка));
КонецФункции

Функция ПолучитьКлючПоискаВ1С(ТипЛица, Идентификатор, ИНН)
	Идентификатор = НормализоватьИдентификаторДляКлюча(Идентификатор);
	ИНН = ВРег(СокрЛП(Строка(ИНН)));
	Если ТипЛица = "ФЛ" Тогда
		Возврат "ФЛ|" + Идентификатор;
	КонецЕсли;
	Если ЗначениеЗаполнено(ИНН) Тогда
		Возврат "ЮЛ|" + ИНН;
	КонецЕсли;
	Возврат "ЮЛ|НАИМ|" + Идентификатор;
КонецФункции

Функция СформироватьТаблицуРасхождений(ТаблицаФайла, Данные1С)
	// Сопоставление записей файла и 1С, формирование строк расхождений по реквизитам
	Расхождения = Новый ТаблицаЗначений;
	Расхождения.Колонки.Добавить("ТипЛица", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ВидРасхождения", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("Реквизит", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ЗначениеВФайле", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ЗначениеВ1С", Новый ОписаниеТипов("Строка"));
	Словарь1С = Новый Соответствие;
	Для Каждого Строка1С Из Данные1С Цикл
		Ключ = ПолучитьКлючПоискаВ1С(Строка1С.ТипЛица, Строка1С.Идентификатор, Строка1С.ИНН);
		Словарь1С.Вставить(Ключ, Строка1С);
		Если Строка1С.ТипЛица = "ЮЛ" И ЗначениеЗаполнено(Строка1С.Идентификатор) Тогда
			Словарь1С.Вставить("ЮЛ|НАИМ|" + НормализоватьИдентификаторДляКлюча(Строка1С.Идентификатор), Строка1С);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаФайла Из ТаблицаФайла Цикл
		Ключ = ПолучитьКлючПоискаВ1С(СтрокаФайла.ТипЛица, СтрокаФайла.Идентификатор, СтрокаФайла.ИНН);
		Строка1С = Словарь1С.Получить(Ключ);
		Если Строка1С = Неопределено И СтрокаФайла.ТипЛица = "ЮЛ" Тогда
			Строка1С = Словарь1С.Получить("ЮЛ|НАИМ|" + НормализоватьИдентификаторДляКлюча(СтрокаФайла.Идентификатор));
		КонецЕсли;
		Если Строка1С = Неопределено И СтрокаФайла.ТипЛица = "ФЛ" Тогда
			ИдентФайлНорм = НормализоватьИдентификаторДляКлюча(СтрокаФайла.Идентификатор);
			Для Каждого Строка1СОбход Из Данные1С Цикл
				Если Строка1СОбход.ТипЛица = "ФЛ" И НормализоватьИдентификаторДляКлюча(Строка1СОбход.Идентификатор) = ИдентФайлНорм Тогда
					Строка1С = Строка1СОбход;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Строка1С = Неопределено Тогда
			Новая = Расхождения.Добавить();
			Новая.ТипЛица = СтрокаФайла.ТипЛица;
			Новая.Идентификатор = СтрокаФайла.Идентификатор;
			Новая.ВидРасхождения = "Лицо из файла реестра не найдено в 1С";
			Новая.Реквизит = "—";
			Новая.ЗначениеВФайле = "Указано в файле реестра";
			Новая.ЗначениеВ1С = "—";
			Продолжить;
		КонецЕсли;
		Если СтрокаФайла.ТипЛица = "ФЛ" Тогда
			ПаспортФайл = СокрЛП(Строка(СтрокаФайла.СерияПаспорта) + " " + Строка(СтрокаФайла.НомерПаспорта));
			Паспорт1С = СокрЛП(Строка(Строка1С.СерияПаспорта) + " " + Строка(Строка1С.НомерПаспорта));
			Если ПаспортФайл <> Паспорт1С И (ЗначениеЗаполнено(ПаспортФайл) Или ЗначениеЗаполнено(Паспорт1С)) Тогда
				Новая = Расхождения.Добавить();
				Новая.ТипЛица = СтрокаФайла.ТипЛица;
				Новая.Идентификатор = СтрокаФайла.Идентификатор;
				Новая.ВидРасхождения = "Не совпадает";
				Новая.Реквизит = "Паспорт";
				Новая.ЗначениеВФайле = ПаспортФайл;
				Новая.ЗначениеВ1С = Паспорт1С;
			КонецЕсли;
		Иначе
			НаимФайл = СокрЛП(Строка(СтрокаФайла.Идентификатор));
			Наим1С = СокрЛП(Строка(Строка1С.Идентификатор));
			Если НаимФайл <> Наим1С И (ЗначениеЗаполнено(НаимФайл) Или ЗначениеЗаполнено(Наим1С)) Тогда
				Новая = Расхождения.Добавить();
				Новая.ТипЛица = СтрокаФайла.ТипЛица;
				Новая.Идентификатор = СтрокаФайла.Идентификатор;
				Новая.ВидРасхождения = "Не совпадает";
				Новая.Реквизит = "Наименование";
				Новая.ЗначениеВФайле = НаимФайл;
				Новая.ЗначениеВ1С = Наим1С;
			КонецЕсли;
			ИННФайл = СокрЛП(Строка(СтрокаФайла.ИНН));
			ИНН1С = СокрЛП(Строка(Строка1С.ИНН));
			Если ИННФайл <> ИНН1С И (ЗначениеЗаполнено(ИННФайл) Или ЗначениеЗаполнено(ИНН1С)) Тогда
				Новая = Расхождения.Добавить();
				Новая.ТипЛица = СтрокаФайла.ТипЛица;
				Новая.Идентификатор = СтрокаФайла.Идентификатор;
				Новая.ВидРасхождения = "Не совпадает";
				Новая.Реквизит = "ИНН";
				Новая.ЗначениеВФайле = ИННФайл;
				Новая.ЗначениеВ1С = ИНН1С;
			КонецЕсли;
			ОГРНФайл = СокрЛП(Строка(СтрокаФайла.ОГРН));
			ОГРН1С = СокрЛП(Строка(Строка1С.ОГРН));
			Если ОГРНФайл <> ОГРН1С И (ЗначениеЗаполнено(ОГРНФайл) Или ЗначениеЗаполнено(ОГРН1С)) Тогда
				Новая = Расхождения.Добавить();
				Новая.ТипЛица = СтрокаФайла.ТипЛица;
				Новая.Идентификатор = СтрокаФайла.Идентификатор;
				Новая.ВидРасхождения = "Не совпадает";
				Новая.Реквизит = "ОГРН";
				Новая.ЗначениеВФайле = ОГРНФайл;
				Новая.ЗначениеВ1С = ОГРН1С;
			КонецЕсли;
		КонецЕсли;
		АдресФайл = СокрЛП(Строка(СтрокаФайла.Адрес));
		Адрес1С = СокрЛП(Строка(Строка1С.Адрес));
		Если АдресФайл <> Адрес1С И (ЗначениеЗаполнено(АдресФайл) Или ЗначениеЗаполнено(Адрес1С)) Тогда
			Новая = Расхождения.Добавить();
			Новая.ТипЛица = СтрокаФайла.ТипЛица;
			Новая.Идентификатор = СтрокаФайла.Идентификатор;
			Новая.ВидРасхождения = "Не совпадает";
			Новая.Реквизит = "Адрес";
			Новая.ЗначениеВФайле = АдресФайл;
			Новая.ЗначениеВ1С = Адрес1С;
		КонецЕсли;
		РсФайл = СокрЛП(Строка(СтрокаФайла.РасчетныйСчет));
		Рс1С = СокрЛП(Строка(Строка1С.НомерСчета));
		Если РсФайл <> Рс1С И (ЗначениеЗаполнено(РсФайл) Или ЗначениеЗаполнено(Рс1С)) Тогда
			Новая = Расхождения.Добавить();
			Новая.ТипЛица = СтрокаФайла.ТипЛица;
			Новая.Идентификатор = СтрокаФайла.Идентификатор;
			Новая.ВидРасхождения = "Не совпадает";
			Новая.Реквизит = "Расчётный счёт";
			Новая.ЗначениеВФайле = РсФайл;
			Новая.ЗначениеВ1С = Рс1С;
		КонецЕсли;
		ДатаРегФайл = СтрокаФайла.ДатаГосРегистрации;
		ДатаРег1С = Строка1С.ДатаГосРегистрации;
		Если (ДатаРегФайл <> ДатаРег1С) И (ЗначениеЗаполнено(ДатаРегФайл) Или ЗначениеЗаполнено(ДатаРег1С)) Тогда
			Новая = Расхождения.Добавить();
			Новая.ТипЛица = СтрокаФайла.ТипЛица;
			Новая.Идентификатор = СтрокаФайла.Идентификатор;
			Новая.ВидРасхождения = "Не совпадает";
			Новая.Реквизит = "Дата гос. регистрации / выдачи документа";
			Новая.ЗначениеВФайле = ?(ЗначениеЗаполнено(ДатаРегФайл), Формат(ДатаРегФайл, "ДФ=dd.MM.yyyy"), "");
			Новая.ЗначениеВ1С = ?(ЗначениеЗаполнено(ДатаРег1С), Формат(ДатаРег1С, "ДФ=dd.MM.yyyy"), "");
		КонецЕсли;
		ОрганРегФайл = СокрЛП(Строка(СтрокаФайла.ОрганГосРегистрации));
		ОрганРег1С = СокрЛП(Строка(Строка1С.ОрганГосРегистрации));
		Если ОрганРегФайл <> ОрганРег1С И (ЗначениеЗаполнено(ОрганРегФайл) Или ЗначениеЗаполнено(ОрганРег1С)) Тогда
			Новая = Расхождения.Добавить();
			Новая.ТипЛица = СтрокаФайла.ТипЛица;
			Новая.Идентификатор = СтрокаФайла.Идентификатор;
			Новая.ВидРасхождения = "Не совпадает";
			Новая.Реквизит = "Орган, осуществивший регистрацию / выдавший документ";
			Новая.ЗначениеВФайле = ОрганРегФайл;
			Новая.ЗначениеВ1С = ОрганРег1С;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Строка1С Из Данные1С Цикл
		Ключ = ПолучитьКлючПоискаВ1С(Строка1С.ТипЛица, Строка1С.Идентификатор, Строка1С.ИНН);
		НайденВФайле = Ложь;
		Для Каждого СтрокаФайла Из ТаблицаФайла Цикл
			КлючФ = ПолучитьКлючПоискаВ1С(СтрокаФайла.ТипЛица, СтрокаФайла.Идентификатор, СтрокаФайла.ИНН);
			Если КлючФ = Ключ Тогда
				НайденВФайле = Истина;
				Прервать;
			КонецЕсли;
			Если СтрокаФайла.ТипЛица = "ЮЛ" И Строка1С.ТипЛица = "ЮЛ" Тогда
				Если ВРег(СокрЛП(Строка(СтрокаФайла.Идентификатор))) = ВРег(СокрЛП(Строка(Строка1С.Идентификатор))) Или
					(ЗначениеЗаполнено(СтрокаФайла.ИНН) И СокрЛП(Строка(СтрокаФайла.ИНН)) = СокрЛП(Строка(Строка1С.ИНН))) Тогда
					НайденВФайле = Истина;
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если Не НайденВФайле Тогда
			Новая = Расхождения.Добавить();
			Новая.ТипЛица = Строка1С.ТипЛица;
			Новая.Идентификатор = Строка1С.Идентификатор;
			Новая.ВидРасхождения = "Лицо из 1С отсутствует в файле реестра";
			Новая.Реквизит = "—";
			Новая.ЗначениеВФайле = "—";
			Новая.ЗначениеВ1С = "Указано в 1С";
		КонецЕсли;
	КонецЦикла;
	Возврат Расхождения;
КонецФункции

Процедура ВывестиРасхожденияВТабличныйДокумент(Расхождения, ДокументРезультат, Организация, ПИФ, ДатаРеестра)
	// Заполнение табличного документа
	ДокументРезультат.Очистить();
	ДокументРезультат.Область("R1C1:R1C6").Объединить();
	ДокументРезультат.Область("R1C1").Текст = "Сверка с реестром владельцев инвестиционных паев. Только расхождения.";
	ДокументРезультат.Область("R2C1").Текст = "Организация: " + Строка(Организация);
	ДокументРезультат.Область("R3C1").Текст = "ПИФ: " + Строка(ПИФ);
	ДокументРезультат.Область("R4C1").Текст = "Дата реестра: " + Формат(ДатаРеестра, "ДФ=dd.MM.yyyy");
	НомерСтрокиЗаголовка = 6;
	ДокументРезультат.Область("R" + Формат(НомерСтрокиЗаголовка, "ЧГ=0") + "C1").Текст = "Тип лица";
	ДокументРезультат.Область("R" + Формат(НомерСтрокиЗаголовка, "ЧГ=0") + "C2").Текст = "Идентификатор лица";
	ДокументРезультат.Область("R" + Формат(НомерСтрокиЗаголовка, "ЧГ=0") + "C3").Текст = "Вид расхождения";
	ДокументРезультат.Область("R" + Формат(НомерСтрокиЗаголовка, "ЧГ=0") + "C4").Текст = "Реквизит";
	ДокументРезультат.Область("R" + Формат(НомерСтрокиЗаголовка, "ЧГ=0") + "C5").Текст = "Значение в файле";
	ДокументРезультат.Область("R" + Формат(НомерСтрокиЗаголовка, "ЧГ=0") + "C6").Текст = "Значение в 1С";
	НомерСтроки = 7;
	Для Каждого СтрокаРасх Из Расхождения Цикл
		ДокументРезультат.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C1").Текст = Строка(СтрокаРасх.ТипЛица);
		ДокументРезультат.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C2").Текст = Строка(СтрокаРасх.Идентификатор);
		ДокументРезультат.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C3").Текст = Строка(СтрокаРасх.ВидРасхождения);
		ДокументРезультат.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C4").Текст = Строка(СтрокаРасх.Реквизит);
		ДокументРезультат.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C5").Текст = Строка(СтрокаРасх.ЗначениеВФайле);
		ДокументРезультат.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C6").Текст = Строка(СтрокаРасх.ЗначениеВ1С);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	Если Расхождения.Количество() = 0 Тогда
		ДокументРезультат.Область("R7C1:R7C6").Объединить();
		ДокументРезультат.Область("R7C1").Текст = "Расхождений не обнаружено.";
	КонецЕсли;
	ДокументРезультат.АвтоМасштаб = Истина;
КонецПроцедуры
