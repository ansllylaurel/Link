		|	КОНЕЦ КАК УчетныйАктивЦБРФ,
		|	ПОДСТРОКА(ЕСТЬNULL(_ТаблицаЦБ.ЦеннаяБумага.УчетныйАктивЦБРФ.КодЦБРФ, """"), 16, 5) КАК КодЦБРФ,
		|	_ТаблицаЦБ.ЦеннаяБумага.Эмитент.ЮрФизЛицо КАК Эмитент,
