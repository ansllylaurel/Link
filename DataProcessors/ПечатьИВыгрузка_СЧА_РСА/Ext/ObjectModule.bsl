		КонецЦикла;	
	КонецЕсли;
	
	Для Сч = 1 По 6 Цикл
		
		Если Сч = 2 Или Сч = 3 Или Сч = 4 Тогда
			Продолжить;
		КонецЕсли;
	
		МассивРаздела = СформироватьМассивСтрок(Запрос.МенеджерВременныхТаблиц.Таблицы["_МассивРаздела21_" + СокрЛП(Сч)].ПолучитьДанные().Выгрузить());
		Результат.Вставить("МассивРаздела21_" + СокрЛП(Сч), МассивРаздела);
		
	КонецЦикла;
	
	Для Сч = 2 По 4 Цикл
		
		ТаблицаРазделаЦБ = ПолучитьТаблицуРазделаЦБ(ТаблицаЦБ, ПустаяТаблица, "Раздел", "Раздел21_" + СокрЛП(Сч));		
		МассивСтрокЦБ = СформироватьМассивСтрок(ТаблицаРазделаЦБ);  	
		Результат.Вставить("МассивРаздела21_" + СокрЛП(Сч), МассивСтрокЦБ);
		
	КонецЦикла;	
			
	МассивРаздела = СформироватьМассивСтрок(Запрос.МенеджерВременныхТаблиц.Таблицы["_МассивРаздела22"].ПолучитьДанные().Выгрузить());
	Результат.Вставить("МассивРаздела22", МассивРаздела);
	
	Результат.Вставить("ДатаОтчета", Формат(ПараметрыЗапроса.Период, "ДФ=dd.MM.yyyy"));
	Результат.Вставить("ДатаОтчетаДата", ПараметрыЗапроса.Период);
	
	ПараметрыЗапроса.Вставить("Подписант", Подписант);
	ЗаголовокИПодвал = ПолучитьПараметрыЗаголовкаИПодвала(ПараметрыЗапроса);
	
	ДобавитьОбщиеДанныеВСтруктуруРезультата(Результат, ЗаголовокИПодвал, Подписант);
		
	Возврат Результат;
	
КонецФункции

