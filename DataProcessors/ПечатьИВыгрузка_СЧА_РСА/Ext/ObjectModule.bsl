Функция ПодготовитьРезультатДляВыводаСЧАНСД_ПР(ТекДокумент, ТекстЗапроса, Подписант)
	
	Результат = Новый Структура;
	
	ПараметрыЗапроса = ПолучитьПараметрыЗапроса(ТекДокумент);
	
	Запрос = Новый Запрос;	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Период", 				 	  			ПараметрыЗапроса.Период);
	Запрос.УстановитьПараметр("ПериодГраница",			 	  			Новый Граница(КонецДня(ПараметрыЗапроса.Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", 				  			ПараметрыЗапроса.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 			ПараметрыЗапроса.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета", 					  			ПараметрыЗапроса.ВидУчета);
	Запрос.УстановитьПараметр("ЦельРасчета",				  			ПараметрыЗапроса.ЦельРасчетаСтоимостиОценки);
	Запрос.УстановитьПараметр("Ссылка",						  			ПараметрыЗапроса.Ссылка);
	Запрос.УстановитьПараметр("ВалютаДокумента",			  			ПараметрыЗапроса.ВалютаДокумента);
	Запрос.УстановитьПараметр("МНОВРазделеДенежныеСредства",  			ПараметрыЗапроса.МНОВРазделеДенежныеСредства); 
	Запрос.УстановитьПараметр("РезервыПоМНООтноситьКРасчетномуСчету",	ПараметрыЗапроса.РезервыПоМНООтноситьКРасчетномуСчету); 
	
	// Облигации гос. корпораций и ФГУП для НСД нужно отражать в разделе 9 ("Облигации российских хозяйственных обществ").
	// Используется общий с Инфинитумом запрос.
	Запрос.УстановитьПараметр("Раздел20Или9",  				  "Раздел9");
	
	Результат.Вставить("СДУ", ПараметрыЗапроса.СчетДоверительногоУправления.Наименование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаЦБ = Запрос.МенеджерВременныхТаблиц.Таблицы["_МассивРазделовЦБ"].ПолучитьДанные().Выгрузить();
	
	ПроверитьЦеныЦБ(ТаблицаЦБ);
	
	ПустаяТаблица = ТаблицаЦБ.СкопироватьКолонки();
	
	МассивРаздела1 = СформироватьМассивСтрок(Запрос.МенеджерВременныхТаблиц.Таблицы["_МассивРаздела1"].ПолучитьДанные().Выгрузить());
	Результат.Вставить("МассивРаздела1", МассивРаздела1);
	
	МассивРаздела2 = СформироватьМассивСтрок(Запрос.МенеджерВременныхТаблиц.Таблицы["_МассивРаздела2"].ПолучитьДанные().Выгрузить());
	Результат.Вставить("МассивРаздела2", МассивРаздела2);
	
	Для Сч = 4 По 19 Цикл
		Если Сч = 5 Тогда
			Продолжить;
		КонецЕсли;
		ТаблицаРазделаЦБ = ПолучитьТаблицуРазделаЦБ(ТаблицаЦБ, ПустаяТаблица, "Раздел", "Раздел" + СокрЛП(Сч));
		МассивСтрокЦБ = СформироватьМассивСтрок(ТаблицаРазделаЦБ);  	
		Результат.Вставить("МассивРаздела" + СокрЛП(Сч), МассивСтрокЦБ);
	КонецЦикла;
		
	ТаблицаРазделаЦБ = ПолучитьТаблицуРазделаЦБ(ТаблицаЦБ, ПустаяТаблица, "Раздел", "Раздел20");
	ТаблицаРазделаЦБ.Колонки.Добавить("ВидИмущества", Новый ОписаниеТипов("Строка"));
	
	Для Каждого ТекСтрока Из ТаблицаРазделаЦБ Цикл
		ТекСтрока.ВидИмущества = "Облигация " + ТекСтрока.ГосударственныйРегистрационныйНомер + " (" + ТекСтрока.НаименованиеЭмитента + ")";
	КонецЦикла;
	
	МассивСтрокЦБ = СформироватьМассивСтрок(ТаблицаРазделаЦБ);  	
	Результат.Вставить("МассивРаздела20", МассивСтрокЦБ);
	
	//Проверяем, нет ли необработанных разделов с ценными бумагами
	ТаблицаРазделаЦБ = ПолучитьТаблицуРазделаЦБ(ТаблицаЦБ, ПустаяТаблица, "Раздел", "РазделНеОпределен");		
	Если ТаблицаРазделаЦБ.Количество() > 0 Тогда
		Для Каждого ТекСтрокаТаблицы Из ТаблицаРазделаЦБ Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить раздел, в который должна выгружаться ценная бумага " + ТекСтрокаТаблицы.НаименованиеЭмитента + " " + ТекСтрокаТаблицы.КодISIN);
		КонецЦикла;	
	КонецЕсли;
	
	Для Сч = 1 По 6 Цикл
		Если Сч = 2 Или Сч = 3 Или Сч = 4 Тогда
			Продолжить;
		КонецЕсли;
		МассивРаздела = СформироватьМассивСтрок(Запрос.МенеджерВременныхТаблиц.Таблицы["_МассивРаздела21_" + СокрЛП(Сч)].ПолучитьДанные().Выгрузить());
		Результат.Вставить("МассивРаздела21_" + СокрЛП(Сч), МассивРаздела);
	КонецЦикла;
	
	Для Сч = 2 По 4 Цикл
		ТаблицаРазделаЦБ = ПолучитьТаблицуРазделаЦБ(ТаблицаЦБ, ПустаяТаблица, "Раздел", "Раздел21_" + СокрЛП(Сч));		
		МассивСтрокЦБ = СформироватьМассивСтрок(ТаблицаРазделаЦБ);  	
		Результат.Вставить("МассивРаздела21_" + СокрЛП(Сч), МассивСтрокЦБ);
	КонецЦикла;
			
	МассивРаздела = СформироватьМассивСтрок(Запрос.МенеджерВременныхТаблиц.Таблицы["_МассивРаздела22"].ПолучитьДанные().Выгрузить());
	Результат.Вставить("МассивРаздела22", МассивРаздела);
	
	Результат.Вставить("ДатаОтчета", Формат(ПараметрыЗапроса.Период, "ДФ=dd.MM.yyyy"));
	Результат.Вставить("ДатаОтчетаДата", ПараметрыЗапроса.Период);
	
	ПараметрыЗапроса.Вставить("Подписант", Подписант);
	ЗаголовокИПодвал = ПолучитьПараметрыЗаголовкаИПодвала(ПараметрыЗапроса);
	
	ДобавитьОбщиеДанныеВСтруктуруРезультата(Результат, ЗаголовокИПодвал, Подписант);
		
	Возврат Результат;
	
КонецФункции

