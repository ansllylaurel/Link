		|				ТОГДА ВЫБОР
		|						КОГДА ВЫРАЗИТЬ(_Обязательства.Основание КАК Документ.НачислениеЗадолженности).Контрагент = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.)
		|							ТОГДА ВЫРАЗИТЬ(_Обязательства.Основание КАК Документ.НачислениеЗадолженности).Брокер.ЮрФизЛицо
		|						ИНАЧЕ ВЫРАЗИТЬ(_Обязательства.Основание КАК Документ.НачислениеЗадолженности).Контрагент
		|					КОНЕЦ
		|		КОНЕЦ КАК Контрагент,
		|		СУММА(_Обязательства.СуммаРынокВВалютеУчета) КАК Сумма
		|	ИЗ
		|		_Обязательства КАК _Обязательства
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_Обязательства.ВидЗадолженности,
		|		_Обязательства.СубъектАналитики,
		|		ВЫБОР
		|			КОГДА _Обязательства.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))
		|					И _Обязательства.Контрагент = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.)
		|				ТОГДА ВЫБОР
		|						КОГДА ТИПЗНАЧЕНИЯ(_Обязательства.Основание) = ТИП(Документ.Сделка)
		|							ТОГДА ВЫРАЗИТЬ(_Обязательства.Основание КАК Документ.Сделка).Брокер.ЮрФизЛицо
		|						КОГДА ТИПЗНАЧЕНИЯ(_Обязательства.Основание) = ТИП(Документ.СделкаРЕПО)
		|							ТОГДА ВЫРАЗИТЬ(_Обязательства.Основание КАК Документ.СделкаРЕПО).Брокер.ЮрФизЛицо
		|						КОГДА ТИПЗНАЧЕНИЯ(_Обязательства.Основание) = ТИП(Документ.СделкаСВалютой)
		|							ТОГДА ВЫРАЗИТЬ(_Обязательства.Основание КАК Документ.СделкаСВалютой).Брокер.ЮрФизЛицо
		|					КОНЕЦ
		|			КОГДА _Обязательства.Контрагент <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.)
		|				ТОГДА _Обязательства.Контрагент
		|			КОГДА ТИПЗНАЧЕНИЯ(_Обязательства.Основание) = ТИП(Документ.Сделка)
		|				ТОГДА ВЫБОР
		|						КОГДА ВЫРАЗИТЬ(_Обязательства.Основание КАК Документ.Сделка).Контрагент = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.)
		|							ТОГДА ВЫРАЗИТЬ(_Обязательства.Основание КАК Документ.Сделка).Брокер.ЮрФизЛицо
		|						ИНАЧЕ ВЫРАЗИТЬ(_Обязательства.Основание КАК Документ.Сделка).Контрагент
		|					КОНЕЦ
		|			КОГДА ТИПЗНАЧЕНИЯ(_Обязательства.Основание) = ТИП(Документ.СделкаРЕПО)
		|				ТОГДА ВЫБОР
		|						КОГДА ВЫРАЗИТЬ(_Обязательства.Основание КАК Документ.СделкаРЕПО).Контрагент = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.)
		|							ТОГДА ВЫРАЗИТЬ(_Обязательства.Основание КАК Документ.СделкаРЕПО).Брокер.ЮрФизЛицо
		|						ИНАЧЕ ВЫРАЗИТЬ(_Обязательства.Основание КАК Документ.СделкаРЕПО).Контрагент
		|					КОНЕЦ
		|			КОГДА ТИПЗНАЧЕНИЯ(_Обязательства.Основание) = ТИП(Документ.СделкаСВалютой)
		|				ТОГДА ВЫРАЗИТЬ(_Обязательства.Основание КАК Документ.СделкаСВалютой).Брокер.ЮрФизЛицо
		|			КОГДА ТИПЗНАЧЕНИЯ(_Обязательства.Основание) = ТИП(Документ.НачислениеЗадолженности)
		|				ТОГДА ВЫБОР
		|						КОГДА ВЫРАЗИТЬ(_Обязательства.Основание КАК Документ.НачислениеЗадолженности).Контрагент = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.)
		|							ТОГДА ВЫРАЗИТЬ(_Обязательства.Основание КАК Документ.НачислениеЗадолженности).Брокер.ЮрФизЛицо
		|						ИНАЧЕ ВЫРАЗИТЬ(_Обязательства.Основание КАК Документ.НачислениеЗадолженности).Контрагент
		|					КОНЕЦ
		|		КОНЕЦ) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (ВЫБОР
		|				КОГДА ВложенныйЗапрос.Контрагент <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.)
		|					ТОГДА ВложенныйЗапрос.Контрагент
		|				КОГДА ТИПЗНАЧЕНИЯ(ВложенныйЗапрос.СубъектАналитики) = ТИП(Справочник.Договоры)
		|					ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.СубъектАналитики КАК Справочник.Договоры).Контрагент
		|				КОГДА ТИПЗНАЧЕНИЯ(ВложенныйЗапрос.СубъектАналитики) = ТИП(Справочник.ДоговорыБрокерскогоОбслуживания)
		|					ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.СубъектАналитики КАК Справочник.ДоговорыБрокерскогоОбслуживания).Контрагент
		|			КОНЕЦ = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Раздел15"",
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ВложенныйЗапрос.СубъектАналитики) = ТИП(Справочник.БанковскиеСчета)
		|			ТОГДА ""Резервы по р/счетам""
		|		КОГДА ТИПЗНАЧЕНИЯ(ВложенныйЗапрос.СубъектАналитики) = ТИП(Справочник.БрокерскиеКомпании)
		|			ТОГДА ""Резервы по брокерским счетам""
		|		КОГДА ТИПЗНАЧЕНИЯ(ВложенныйЗапрос.СубъектАналитики) = ТИП(Справочник.ДепозитныеВклады)
		|			ТОГДА ""Резервы по депозитным счетам""
		|		КОГДА ТИПЗНАЧЕНИЯ(ВложенныйЗапрос.СубъектАналитики) = ТИП(Документ.МНО)
		|			ТОГДА ""Резервы по сделкам МНО/НСО""
		|		ИНАЧЕ ""Резервы по сделкам РЕПО""
		|	КОНЕЦ,
		|	ВложенныйЗапрос.Сумма,
		|	""КредиторскаяЗадолженность"",
		|	NULL,
		|	NULL
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ПрочиеАктивы.СубъектАналитики КАК СубъектАналитики,
		|		СУММА(_ПрочиеАктивы.СуммаРезерваВВалютеУчета) КАК Сумма
		|	ИЗ
		|		_ПрочиеАктивы КАК _ПрочиеАктивы
		|	ГДЕ
		|		_ПрочиеАктивы.СуммаРезерваВВалютеУчета <> 0
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ПрочиеАктивы.СубъектАналитики
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		_КредиторскаяЗадолженность.СубъектАналитики,
		|		-СУММА(_КредиторскаяЗадолженность.СуммаРынокВВалютеУчета)
		|	ИЗ
		|		_КредиторскаяЗадолженность КАК _КредиторскаяЗадолженность
		|	ГДЕ
		|		ТИПЗНАЧЕНИЯ(_КредиторскаяЗадолженность.ВидЗадолженности) = ТИП(Справочник.Резервы)
		|		И _КредиторскаяЗадолженность.ВидЗадолженности <> ЗНАЧЕНИЕ(Справочник.Резервы.)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_КредиторскаяЗадолженность.СубъектАналитики) КАК ВложенныйЗапрос";

КонецПроцедуры   

Функция ДоработатьТекстЗапросаСЧАМСД_ПР(ТекстЗапроса) Экспорт
	
	// Запрос по ценным бумагам	
	ТекстЗапроса = ТекстЗапроса + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма, """") В (ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.ГосударственнаяКорпорация), ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.ФедеральноеГосударственноеУнитарноеПредприятие))
		|						ТОГДА ""Раздел20""
		|					КОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма, """") = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация)
		|						ТОГДА ""Раздел15""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная)
		|						ТОГДА ""Раздел4""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная)
		|						ТОГДА ""Раздел7""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Муниципальная)
		|						ТОГДА ""Раздел8""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная)
		|							И ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.РезидентРФ, ЛОЖЬ) = ЛОЖЬ
		|						ТОГДА ""Раздел17""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная)
		|						ТОГДА ""Раздел9""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Ипотечная)
		|						ТОГДА ""Раздел11""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|						ТОГДА ""Раздел17""
		|				КОНЕЦ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ВЫБОР
		|					КОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма, """") = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация)
		|						ТОГДА ""Раздел15""
		|					КОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.РезидентРФ, ЛОЖЬ) = ЛОЖЬ
		|						ТОГДА ""Раздел16""
		|					ИНАЧЕ ""Раздел10""
		|				КОНЕЦ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|			ТОГДА ""Раздел12""
		|		ИНАЧЕ ""РазделНеОпределен""
		|	КОНЕЦ КАК Раздел,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Акции).УчетныйАктивЦБРФ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Векселя).УчетныйАктивЦБРФ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).УчетныйАктивЦБРФ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).УчетныйАктивЦБРФ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Паи).УчетныйАктивЦБРФ
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.)
		|	КОНЕЦ КАК УчетныйАктивЦБРФ,
		|	_ТаблицаЦБ.ЦеннаяБумага.Эмитент.ЮрФизЛицо КАК Эмитент,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК НаименованиеЭмитента,
		|	_ТаблицаЦБ.Сумма КАК Сумма,
		|	ЕСТЬNULL(_ТаблицаЦБ.ЦеннаяБумага.ГосударственныйРегистрационныйНомер, """") КАК ГосударственныйРегистрационныйНомер,
		|	ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) КАК ВидЦБ,
		|	РеквизитыБиржи.КраткоеНаименованиеПоУставу КАК ИсточникЦены,
		|	_ТаблицаЦБ.Количество КАК Количество,
		|	_ТаблицаЦБ.Стоимость КАК Цена,
		|	ЕСТЬNULL(КодыВТорговыхСистемахISIN.Код, """") КАК ISIN,
		|	ЕСТЬNULL(КодыВТорговыхСистемахCFI.Код, """") КАК CFI,
		|	_ТаблицаЦБ.Купон КАК Купон,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА _ТаблицаЦБ.ЦеннаяБумага.Тип
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ТипКатегорияАкции
		|ПОМЕСТИТЬ _РазвернутаяТаблицаСКодами
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО _ТаблицаЦБ.ЦеннаяБумага.Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыБиржи
		|		ПО (ВЫБОР
		|				КОГДА _ТаблицаЦБ.Источник = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.)
		|					ТОГДА &ММВБ
