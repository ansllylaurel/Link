Функция ПодготовитьРезультатДляВыводаРСАОСД2020(ТекДокумент, ТекстЗапроса, Подписант)
	
	Результат = Новый Структура;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ПараметрыЗапроса = ПолучитьПараметрыЗапроса(ТекДокумент);
	Запрос.УстановитьПараметр("Период", 				 	  ПараметрыЗапроса.Период);
	Запрос.УстановитьПараметр("Организация", 				  ПараметрыЗапроса.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыЗапроса.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета", 					  ПараметрыЗапроса.ВидУчета);
	Запрос.УстановитьПараметр("ЦельРасчета",				  ПараметрыЗапроса.ЦельРасчетаСтоимостиОценки);
	Запрос.УстановитьПараметр("Ссылка",						  ПараметрыЗапроса.Ссылка);
	Запрос.УстановитьПараметр("ВалютаДокумента",			  ПараметрыЗапроса.ВалютаДокумента);
	Запрос.УстановитьПараметр("МНОВРазделеДенежныеСредства",  ПараметрыЗапроса.МНОВРазделеДенежныеСредства);
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаЦБ = Запрос.МенеджерВременныхТаблиц.Таблицы["_МассивРазделовЦБ"].ПолучитьДанные().Выгрузить();
		
	// Разделы		
	МассивРаздела1 = Запрос.МенеджерВременныхТаблиц.Таблицы["_МассивРаздела1"].ПолучитьДанные().Выгрузить();
	
	Для Каждого ТекСтрока Из МассивРаздела1 Цикл
		Если ЗначениеЗаполнено(ТекСтрока.НомерСоглашения) Тогда
			ТекСтрока.НомерСоглашения = "Подтверждение № " + Формат(ТекСтрока.НомерПодтверждения, "ЧГ=0") + " к Ген. Соглашению " + СокрЛП(ТекСтрока.НомерСоглашения) + " от " + Формат(ТекСтрока.ДатаСоглашения, "ДФ=dd.MM.yyyy");
		КонецЕсли;
	КонецЦикла;
	
	Результат.Вставить("МассивРаздела1", МассивРаздела1);	
	Результат.Вставить("МассивРаздела2", Запрос.МенеджерВременныхТаблиц.Таблицы["_МассивРаздела2"].ПолучитьДанные().Выгрузить());	
	    	
	МассивРаздела3 = Запрос.МенеджерВременныхТаблиц.Таблицы["_МассивРаздела3"].ПолучитьДанные().Выгрузить();
	
	// Получаем данные для расчета корректировки
	ДанныеДляРасчетаКорректировки = РаботаСКредитнымиИнструментами.ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправленияДляРСА(
						ПараметрыЗапроса.СчетДоверительногоУправления,
						КонецДня(ПараметрыЗапроса.Период),
						Перечисления.ТипыКредитныхИнструментов.ДепозитныйВклад,
						, 
						Ложь);
						
	// Расчитываем корректировку
	Для Каждого ТекСтрока Из МассивРаздела3 Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("КредитныйИнструмент", ТекСтрока.ДепозитныйВклад);
		
		НайденныеСтроки = ДанныеДляРасчетаКорректировки.НайтиСтроки(Отбор);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			ТекСтрока.КорректировкаЧерезЭСП	= ТекСтрока.СуммаВклада + ТекСтрока.НачисленныеПроценты - НайденныеСтроки[0].Номинал - НайденныеСтроки[0].Проценты;
			ТекСтрока.Всего					= ТекСтрока.Всего + ТекСтрока.КорректировкаЧерезЭСП;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.Вставить("МассивРаздела3", МассивРаздела3);
	
	Для Сч = 4 По 19 Цикл	
		Результат.Вставить("МассивРаздела" + СокрЛП(Сч), ПолучитьТаблицуРазделаЦБ(ТаблицаЦБ, , "Раздел", "Раздел" + СокрЛП(Сч)));
	КонецЦикла;		
		
	//Проверяем, нет ли необработанных разделов с ценными бумагами
	ТаблицаРазделаЦБ = ПолучитьТаблицуРазделаЦБ(ТаблицаЦБ, , "Раздел", "РазделНеОпределен");		
	Если ТаблицаРазделаЦБ.Количество() > 0 Тогда
		Для Каждого ТекСтрокаТаблицы Из ТаблицаРазделаЦБ Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить раздел, в который должна выгружаться ценная бумага " + ТекСтрокаТаблицы.НаименованиеЭмитента + " " + ТекСтрокаТаблицы.ISIN);
		КонецЦикла;	
	КонецЕсли;

	Для Сч = 20 По 28 Цикл
		Результат.Вставить("МассивРаздела" + СокрЛП(Сч), Запрос.МенеджерВременныхТаблиц.Таблицы["_МассивРаздела" + СокрЛП(Сч)].ПолучитьДанные().Выгрузить());
	КонецЦикла;
		
	// Заголовок и подвал
	Результат.Вставить("СДУ", ПараметрыЗапроса.СчетДоверительногоУправления.Наименование);
	Результат.Вставить("ДатаОтчета", Формат(ПараметрыЗапроса.Период, "ДФ=dd.MM.yyyy"));
	Результат.Вставить("ДатаОтчетаДата", ПараметрыЗапроса.Период);
	
	ПараметрыЗапроса.Вставить("Подписант", Подписант);
	ЗаголовокИПодвал = ПолучитьПараметрыЗаголовкаИПодвала(ПараметрыЗапроса);
	ДобавитьОбщиеДанныеВСтруктуруРезультата(Результат, ЗаголовокИПодвал, Подписант);
		
	Возврат Результат;
	
КонецФункции

