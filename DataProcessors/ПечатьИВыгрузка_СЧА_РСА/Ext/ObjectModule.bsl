	Результат.Вставить("МассивРаздела13_1", МассивРаздела13_1);
	
	ТаблицаРаздела = РезультатЗапроса[КоличествоВПакете - 2].Выгрузить();
	Если СвернутьКупонныйДоход Тогда
		ТаблицаРаздела.Свернуть("Раздел, РазделПодуровень, НаименованиеЭмитента, ГосударственныйРегистрационныйНомер, ISIN, CFI", "Сумма");
	КонецЕсли;
	
	МассивРаздела13_2 = СформироватьМассивСтрок(ТаблицаРаздела);
