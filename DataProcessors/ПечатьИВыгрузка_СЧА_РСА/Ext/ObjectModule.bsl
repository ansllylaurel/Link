Функция СформироватьТабличныйДокументРСАОСД(ТекДокумент, ТекстЗапроса, ОбластиМакета, Подписант)
	
	ДанныеДляЗаполнения = ПодготовитьРезультатДляВыводаРСАОСД(ТекДокумент, ТекстЗапроса, Подписант);
	Если ДанныеДляЗаполнения = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТД = Новый ТабличныйДокумент;
	
	// Шапка отчета
	Область = ОбластиМакета["Шапка"];
	Область.Параметры.ДатаОтчета				= Формат(ДанныеДляЗаполнения.ДатаОтчетаДата, "ДФ='дд.ММ.гггг ''г.'''");
	Область.Параметры.УчредительУправления		= ДанныеДляЗаполнения.ДанныеКлиента;
	Область.Параметры.УправляющаяКомпания		= ДанныеДляЗаполнения.ДанныеОрганизации;
	Область.Параметры.ДоговорДУ					= ДанныеДляЗаполнения.НомерИДатаДоговора;
	Область.Параметры.ДатаСоставленияРасчета	= Формат(ДанныеДляЗаполнения.ДатаФормирования, "ДЛФ=");
	
	ТД.Вывести(Область);
	
	АктивыИтог			= 0;
	ОбязательстваИтог	= 0;
	
	// I. АКТИВЫ
	Область = ОбластиМакета["Раздел_1"];
	ТД.Вывести(Область);
	
	// 1. Денежные средства на счетах
	ИтогиБлока = ВывестиБлокСИтогамиВТабличныйДокумент(ТД, ОбластиМакета, "1", ДанныеДляЗаполнения.МассивРаздела1, "ОстатокДС, НачисленныеПроценты, КорректировкаЧерезЭСП, Резерв, Всего");
	Если ИтогиБлока <> Неопределено Тогда
		АктивыИтог = АктивыИтог + ИтогиБлока.Всего;		
	КонецЕсли;
	
	// 2. Денежные средства на брокерских счетах
