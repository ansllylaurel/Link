
#Область Подготовка_запроса

Функция ПолучитьТекстЗапроса(ДокументСсылка, ИмяЗапроса, ПараметрыСверткиЦенныхБумаг = Неопределено) Экспорт
	
	ТекстЗапроса = "";
		
	ТекстЗапроса = Документы.РегистрацияСтоимостиАктивов.ПолучитьТекстЗапросаДляСпискаЦБ(Неопределено, ?(ИмяЗапроса = "СЧАИнфинитум20200401", Истина, Ложь));
	ТекстЗапроса = ТекстЗапроса + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////	
		|";	
	
	Если ИмяЗапроса = "СЧА" Тогда 	
		ТекстЗапроса = ДоработатьТекстЗапросаСЧА(ТекстЗапроса);
	ИначеЕсли ИмяЗапроса = "СЧАСДКГарант" Тогда 	
		ТекстЗапроса = ДоработатьТекстЗапросаСЧАСДКГарант(ТекстЗапроса);
	ИначеЕсли ИмяЗапроса = "СЧАНСД" Тогда 	
		ТекстЗапроса = ДоработатьТекстЗапросаСЧАНСД(ТекстЗапроса);
	ИначеЕсли ИмяЗапроса = "СЧАНСД_ПР" Тогда 
		// Для НСД_ПР используем готовый запрос от Инфинитума
		ТекстЗапроса = ДоработатьТекстЗапросаСЧАИнфинитум(ТекстЗапроса, Истина);
	ИначеЕсли ИмяЗапроса = "СЧАОСД" Тогда 	
		ТекстЗапроса = ДоработатьТекстЗапросаСЧАОСД(ТекстЗапроса);
	ИначеЕсли ИмяЗапроса = "СЧАМСД" Тогда 	
		ТекстЗапроса = ДоработатьТекстЗапросаСЧАМСД(ТекстЗапроса);
	ИначеЕсли ИмяЗапроса = "СЧАИнфинитум" Тогда 	
		ТекстЗапроса = ДоработатьТекстЗапросаСЧАИнфинитум(ТекстЗапроса);
	ИначеЕсли ИмяЗапроса = "СЧАИнфинитум20200401" Тогда 	
		ТекстЗапроса = ДоработатьТекстЗапросаСЧАИнфинитум_20200401(ТекстЗапроса);	
	ИначеЕсли ИмяЗапроса = "СЧАМСД_ПР" Тогда 	
		ТекстЗапроса = ДоработатьТекстЗапросаСЧАМСД_ПР(ТекстЗапроса);
	ИначеЕсли ИмяЗапроса = "РСАМСД" Тогда 	
		ТекстЗапроса = ДоработатьТекстЗапросаРСАМСД(ТекстЗапроса);
	ИначеЕсли ИмяЗапроса = "РСА" Тогда 	
		ТекстЗапроса = ДоработатьТекстЗапросаРСА(ТекстЗапроса);
	ИначеЕсли ИмяЗапроса = "РСАСДКГарант" Тогда 	
		ТекстЗапроса = ДоработатьТекстЗапросаРСАСДКГарант(ТекстЗапроса, ПараметрыСверткиЦенныхБумаг);
	ИначеЕсли ИмяЗапроса = "РСАОСД" Тогда 	
		
		Если ДокументСсылка.Дата < Дата(2020,1,1) Тогда
			ТекстЗапроса = ДоработатьТекстЗапросаРСАОСД(ТекстЗапроса);
		Иначе
			ТекстЗапроса = ДоработатьТекстЗапросаРСАОСД2020(ТекстЗапроса);
		КонецЕсли;
		
	ИначеЕсли ИмяЗапроса = "РСАНСД" Тогда		
		ДоработатьТекстЗапросаРСАНСД(ТекстЗапроса);		
	ИначеЕсли ИмяЗапроса = "СЧАНСД_ПН2023" Тогда    		
		ДоработатьТекстЗапросаРСАНСД(ТекстЗапроса);
		ДополнитьТекстЗапросаДляСЧАНСД_ПН2023(ТекстЗапроса);
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьПараметрыЗапроса(РегистрацияСтоимостиАктивов) Экспорт
	
	Параметры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РегистрацияСтоимостиАктивов,
		Новый Структура("СчетДоверительногоУправления, Период, Организация, ЦельРасчетаСтоимостиОценки, ВалютаДокумента",
			"СчетДоверительногоУправления", "НАЧАЛОПЕРИОДА(Дата, ДЕНЬ)", "Организация", "ЦельРасчетаСтоимостиОценки", "Организация.ВалютаУчета"));
		
	НастройкиЦелиРасчета = РаботаСПереоценкой.ОпределитьНастройкиОценки(Параметры.Период, Параметры.Организация, Параметры.СчетДоверительногоУправления, Параметры.ЦельРасчетаСтоимостиОценки);	
		
	Параметры.Вставить("Ссылка",								РегистрацияСтоимостиАктивов);
	Параметры.Вставить("ВидУчета",								НастройкиЦелиРасчета.ВидУчетаДляОстатковПартий);
	Параметры.Вставить("ВариантРасчетаОценочнойСтоимости",		НастройкиЦелиРасчета.ВариантРасчетаОценочнойСтоимости);
	Параметры.Вставить("МНОВРазделеДенежныеСредства",			НастройкиЦелиРасчета.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Стройкомплекс2018);
	Параметры.Вставить("РезервыПоМНООтноситьКРасчетномуСчету",	НастройкиЦелиРасчета.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020 
																	И Параметры.Период >= '20250101'
																Или НастройкиЦелиРасчета.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Газфонд 
																	И Параметры.Период >= '20250101');
	
	
	Возврат Параметры;
	
КонецФункции

#КонецОбласти

#Область Подготовка_структуры_результата

Процедура ДобавитьОбщиеДанныеВСтруктуруРезультата(Результат, ЗаголовокИПодвал, Подписант) Экспорт
	
	ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ПустаяСсылка();
	Если ЗаголовокИПодвал.Свойство("ДанныеКлиента") Тогда
		ДанныеКлиента = ЗаголовокИПодвал.ДанныеКлиента;
		
		Если ДанныеКлиента.Количество() > 0 Тогда
			СтрокаДанных = ДанныеКлиента[0];  			
			СтрокаРезультата = СтрокаДанных.ПолноеНаименованиеПоУставу + ", ИНН " + СтрокаДанных.ИНН + "/КПП " + СтрокаДанных.КПП;
			Результат.Вставить("ДанныеКлиента", СтрокаРезультата);	
			Результат.Вставить("НомерИДатаДоговора", "№" + СтрокаДанных.НомерДоговора + " от " + Формат(СтрокаДанных.ДатаЗаключения, "ДФ=dd.MM.yyyy"));	
			Результат.Вставить("НомерДоговора", 	СтрокаДанных.НомерДоговора);
			Результат.Вставить("ДатаДоговора",  	СтрокаДанных.ДатаЗаключения);
			Результат.Вставить("НаименованиеФонда", СтрокаДанных.ПолноеНаименованиеПоУставу);
			Результат.Вставить("ИННФонда", 			СтрокаДанных.ИНН);
			Результат.Вставить("КППФонда",		 	СтрокаДанных.КПП);
			Результат.Вставить("СДУ", 				СтрокаДанных.НаименованиеСчетаДУ);
			ВидДоговораДоверительногоУправления = СтрокаДанных.ВидДоговораДоверительногоУправления;
			Результат.Вставить("ВидДоговораДоверительногоУправления", ВидДоговораДоверительногоУправления);

			
			СтрокаРезультата = СтрокаДанных.КраткоеНаименованиеПоУставу + ", ИНН " + СтрокаДанных.ИНН + "/КПП " + СтрокаДанных.КПП;
			Результат.Вставить("ДанныеКлиентаКратко", СтрокаРезультата);				
		КонецЕсли;					
	КонецЕсли;	
	
	Если ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
		СтрокаВидДоговора = "средствами пенсионных накоплений для финансирования накопительной пенсии";		
	ИначеЕсли ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
		СтрокаВидДоговора = "средствами пенсионных резервов для финансирования резервной части пенсии";	
	ИначеЕсли ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР Тогда
		СтрокаВидДоговора = "средствами пенсионных накоплений";		
	Иначе
		СтрокаВидДоговора = "";
	КонецЕсли;
	
	Если ЗаголовокИПодвал.Свойство("ДанныеОрганизации") Тогда
		ДанныеОрганизации = ЗаголовокИПодвал.ДанныеОрганизации;
		
		Если ДанныеОрганизации.Количество() > 0 Тогда
			СтрокаДанных = ДанныеОрганизации[0];  
			СтрокаРезультата = СтрокаДанных.ПолноеНаименованиеПоУставу + " Д.У. " + СтрокаВидДоговора + ", ИНН " + СтрокаДанных.ИНН + "/КПП " + СтрокаДанных.КПП;
			Результат.Вставить("ДанныеОрганизации", СтрокаРезультата);
			
			СтрокаРезультата = СтрокаДанных.КраткоеНаименованиеПоУставу + ", ИНН " + СтрокаДанных.ИНН + "/КПП " + СтрокаДанных.КПП;
			Результат.Вставить("ДанныеОрганизацииКратко", СтрокаРезультата);
			
			Результат.Вставить("НаименованиеОрганизации", СтрокаДанных.ПолноеНаименованиеПоУставу);
			Результат.Вставить("ИННОрганизации", 		  СтрокаДанных.ИНН);
			Результат.Вставить("КППОрганизации",		  СтрокаДанных.КПП);

		КонецЕсли;					
	КонецЕсли;	
	
	Если ЗаголовокИПодвал.Свойство("ФИОПодписанта") Тогда
		ФИОПодписанта = ЗаголовокИПодвал.ФИОПодписанта;
		
		Если ФИОПодписанта.Количество() > 0 Тогда
			СтрокаДанных = ФИОПодписанта[0];
			СтрокаРезультата = Лев(СтрокаДанных.Имя, 1) + ". " + Лев(СтрокаДанных.Отчество, 1) + ". " + СтрокаДанных.Фамилия;
			Результат.Вставить("ФИОПодписанта", СтрокаРезультата);	
		Иначе 
			Результат.Вставить("ФИОПодписанта", СокрЛП(Подписант));
		КонецЕсли;	
		
	КонецЕсли;
	
	// Добавляем дату формирования
	Результат.Вставить("ДатаФормирования", ЭтотОбъект.ДатаИВремяФормирования);
		
	Часы    = Час(Результат.ДатаФормирования);
	Минуты  = Минута(Результат.ДатаФормирования);
	Секунды = Секунда(Результат.ДатаФормирования);
		
	ВремяФормирования = Формат(Часы, "ЧЦ=2; ЧН=00; ЧВН=") + ":" + Формат(Минуты, "ЧЦ=2; ЧН=00; ЧВН=");

	Результат.Вставить("ВремяФормирования", ВремяФормирования);
	Результат.Вставить("ЕдиницаИзмерения", "Тыс. руб.");

	Если ЗаголовокИПодвал.Свойство("КодПортфеля") Тогда
		Если ЗаголовокИПодвал.КодПортфеля.Количество() > 0 Тогда
			Результат.Вставить("КодПортфеля", ЗаголовокИПодвал.КодПортфеля[0].Значение);
		Иначе
			Результат.Вставить("КодПортфеля", "");
		КонецЕсли;
	КонецЕсли;	
		
КонецПроцедуры // ДобавитьОбщиеДанныеВСтруктуруРезультата()

Функция ПодготовитьРезультатДляВыгрузкиФормы029(РегистрацияСтоимостиАктивов, Подписант) Экспорт
	
	Результат = Новый Структура;
	
	ПараметрыЗапроса = ПолучитьПараметрыЗапроса(РегистрацияСтоимостиАктивов);
	
	ТабЗнач = ПолучитьТаблицуФормы029(ПараметрыЗапроса); 	
	
	МассивСтрок = СформироватьМассивСтрок(ТабЗнач);
	Результат.Вставить("МассивСтрок", МассивСтрок);
	
	Результат.Вставить("ДатаОтчета", Формат(ПараметрыЗапроса.Период, "ДФ=dd.MM.yyyy"));
	Результат.Вставить("ДатаОтчетаДата", ПараметрыЗапроса.Период);
	
	ПараметрыЗапроса.Вставить("Подписант", Подписант);
	ЗаголовокИПодвал = ПолучитьПараметрыЗаголовкаИПодвала(ПараметрыЗапроса);
	
	ДобавитьОбщиеДанныеВСтруктуруРезультата(Результат, ЗаголовокИПодвал, Подписант);
		
	Возврат Результат;
	
КонецФункции

Функция ПодготовитьРезультатДляВыгрузкиФормы685(РегистрацияСтоимостиАктивов) Экспорт
		
	ПараметрыЗапроса = ПолучитьПараметрыЗапроса(РегистрацияСтоимостиАктивов);	
		
	Результат = ПолучитьТаблицыФормы685(ПараметрыЗапроса); 	
		
	Результат.Вставить("ДатаОтчета", Формат(ПараметрыЗапроса.Период, "ДФ=dd.MM.yyyy"));
	Результат.Вставить("ДатаОтчетаДата", ПараметрыЗапроса.Период);
			
	Возврат Результат;
	
КонецФункции

Функция ПодготовитьРезультатДляВыгрузкиФормы301(РегистрацияСтоимостиАктивов, Подписант) Экспорт
	
	ПараметрыЗапроса = ПолучитьПараметрыЗапроса(РегистрацияСтоимостиАктивов);
	Результат = Новый Структура;
	ТабЗнач = ПолучитьТаблицуФормы301(ПараметрыЗапроса); 	
	
	МассивСтрок = СформироватьМассивСтрок(ТабЗнач);
	Результат.Вставить("МассивСтрок", МассивСтрок);
	
	Результат.Вставить("ДатаОтчета", Формат(ПараметрыЗапроса.Период, "ДФ=dd.MM.yyyy"));
	Результат.Вставить("ДатаОтчетаДата", ПараметрыЗапроса.Период);
	
	ПараметрыЗапроса.Вставить("Подписант", Подписант);
	ЗаголовокИПодвал = ПолучитьПараметрыЗаголовкаИПодвала(ПараметрыЗапроса);
	
	ДобавитьОбщиеДанныеВСтруктуруРезультата(Результат, ЗаголовокИПодвал, Подписант);
		
	Возврат Результат;
	
КонецФункции

Функция ПодготовитьРезультатДляВыводаСЧА(ТекДокумент, ТекстЗапроса, Коэффициент = 1000, ЭтоВариантС2018Года = Ложь, Подписант = Неопределено) Экспорт
	
	ПараметрыЗапроса = ПолучитьПараметрыЗапроса(ТекДокумент);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Период", 				 	  ПараметрыЗапроса.Период);
	Запрос.УстановитьПараметр("ПериодГраница",			 	  Новый Граница(КонецДня(ПараметрыЗапроса.Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", 				  ПараметрыЗапроса.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыЗапроса.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета", 					  ПараметрыЗапроса.ВидУчета);
	Запрос.УстановитьПараметр("ЦельРасчета",				  ПараметрыЗапроса.ЦельРасчетаСтоимостиОценки);
	Запрос.УстановитьПараметр("Ссылка",						  ПараметрыЗапроса.Ссылка);
	Запрос.УстановитьПараметр("ВалютаДокумента",			  ПараметрыЗапроса.ВалютаДокумента);
	Запрос.УстановитьПараметр("ЭтоВариантС2018Года",		  ЭтоВариантС2018Года);
	Запрос.УстановитьПараметр("МНОВРазделеДенежныеСредства",  ПараметрыЗапроса.МНОВРазделеДенежныеСредства);
	
	ТаблицаРезультата = Запрос.Выполнить().Выгрузить();                   
	КоличествоСтрок = ТаблицаРезультата.Количество();
	
	Если КоличествоСтрок = 0 Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	ТаблицаРезультата.Сортировать("КодСтроки");
	
	Результат = Новый Структура;
	Результат.Вставить("СЧА", ТаблицаРезультата[0].СЧА / Коэффициент);
	Для НомерСтроки = 1 По КоличествоСтрок-1 Цикл
		ТекСтрока = ТаблицаРезультата[НомерСтроки];
		Если СокрЛП(ТекСтрока.КодСтроки) <> "" И ТекСтрока.СуммаРынок <> 0 Тогда
			Результат.Вставить("Стр"+СокрЛП(ТекСтрока.КодСтроки), ?(ТекСтрока.СуммаРынок < 0, -ТекСтрока.СуммаРынок / Коэффициент, ТекСтрока.СуммаРынок / Коэффициент));
		КонецЕсли;		
	КонецЦикла;
	
	Результат.Вставить("ДатаОтчета", Формат(ПараметрыЗапроса.Период, "ДФ=dd.MM.yyyy"));
	Результат.Вставить("ДатаОтчетаДата", ПараметрыЗапроса.Период);
	
	ПараметрыЗапроса.Вставить("Подписант", Подписант);
	ЗаголовокИПодвал = ПолучитьПараметрыЗаголовкаИПодвала(ПараметрыЗапроса);
	
	ДобавитьОбщиеДанныеВСтруктуруРезультата(Результат, ЗаголовокИПодвал, Подписант);
	
	Возврат Результат;
	
КонецФункции // ПодготовитьРезультатДляВыводаСЧА()

Функция ПодготовитьРезультатДляВыводаРСА(ТекДокумент, ТекстЗапроса, СвернутьКупонныйДоход = Ложь, ЭтоВариантС2018Года = Ложь, Подписант = Неопределено, ЭтоПечатнаяФормаСДКГарант = Ложь) Экспорт
	
	Результат = Новый Структура;
		
	ПараметрыЗапроса = ПолучитьПараметрыЗапроса(ТекДокумент);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
		
	Запрос.УстановитьПараметр("Период", 				 	  ПараметрыЗапроса.Период);
	Запрос.УстановитьПараметр("ПериодГраница",			 	  Новый Граница(КонецДня(ПараметрыЗапроса.Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", 				  ПараметрыЗапроса.Организация);
