Функция СформироватьТабличныйДокументСЧАМСД(ТекДокумент, ТекстЗапроса, ОбластиМакета, Подписант)	

	ДанныеДляЗаполнения = ПодготовитьРезультатДляВыводаСЧА(ТекДокумент, ТекстЗапроса, 1, Истина, Подписант);
	
	Если ДанныеДляЗаполнения = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТД = Новый ТабличныйДокумент;
	
	Разрядность = 2;
	
	// Шапка отчета.
	Область = ОбластиМакета["Шапка"];
	Область.Параметры.ДатаОтчета	   = Формат(ДанныеДляЗаполнения.ДатаОтчета, "ДФ='дд.ММ.гггг ''г.'''");
	Область.Параметры.Организация	   = ДанныеДляЗаполнения.НаименованиеОрганизации + ", ИНН " + ДанныеДляЗаполнения.ИННОрганизации + "/КПП " + ДанныеДляЗаполнения.КППОрганизации;
	Область.Параметры.Клиент		   = ДанныеДляЗаполнения.ДанныеКлиента;
	Область.Параметры.Договор		   = ДанныеДляЗаполнения.НомерИДатаДоговора;
	Область.Параметры.ДатаФормирования = Формат(ДанныеДляЗаполнения.ДатаФормирования, "ДФ=dd.MM.yyyy") + " 23:59:59";
	
	ТД.Вывести(Область);
	
	Область = ОбластиМакета["Строка"];
	
	Область.Параметры.ВидИмущества = "Активы:";
	ТД.Вывести(Область);
	
    // Активы, денежные средства, оценка на текущую отчетную дату (010)
	Область.Параметры.ВидИмущества = "Денежные средства на счетах в кредитных организациях";
	Область.Параметры.КодСтроки = "10";
	Область.Параметры.Сумма = 0;
	Если ДанныеДляЗаполнения.Свойство("Стр010") Тогда
    	Область.Параметры.Сумма = Формат(ДанныеДляЗаполнения.Стр010, "ЧДЦ=" + Строка(Разрядность));
	КонецЕсли;	
	ТД.Вывести(Область);
	
    //Активы, Депозиты,  оценка на текущую отчетную дату (020)	
