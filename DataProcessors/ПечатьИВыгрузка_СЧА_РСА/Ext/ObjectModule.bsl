#Область Получение_областей_макета

Функция ПолучитьОбластиМакетаДляСЧАНСД(Макет, ВидДоговора, ЭтоФорма2023 = Ложь)
	
	Результат = Новый Соответствие;
	
	Если ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
		
		Если ЭтоФорма2023 Тогда
			Результат = ПолучитьОбластиМакетаДляСЧАРСАНСД(Макет);
			Результат.Вставить("Шапка15", 	Макет.ПолучитьОбласть("Шапка15"));
			Результат.Вставить("Строка15", 	Макет.ПолучитьОбласть("Строка15"));
			Результат.Вставить("Подвал15", 	Макет.ПолучитьОбласть("Подвал15"));
			Результат.Вставить("ПодвалСЧА", Макет.ПолучитьОбласть("ПодвалСЧА"));
		Иначе
			Результат.Вставить("Шапка",		Макет.ПолучитьОбласть("Шапка"));
			Результат.Вставить("Строка",	Макет.ПолучитьОбласть("Строка"));	
			Результат.Вставить("Подвал",	Макет.ПолучитьОбласть("Подвал"));
		КонецЕсли;
		
	ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
		Результат = ПолучитьОбластиМакетаДляСЧАНСД_ПР(Макет);
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОбластиМакетаДляСЧАНСД_ПР(Макет)
	
	Результат = Новый Соответствие;
	
	Результат.Вставить("Шапка",		Макет.ПолучитьОбласть("Шапка"));
	
	Результат.Вставить("Шапка1",	Макет.ПолучитьОбласть("Шапка1"));
