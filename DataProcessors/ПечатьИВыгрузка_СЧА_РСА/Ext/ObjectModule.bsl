		|				И ВЫРАЗИТЬ(_ПрочиеАктивы.СубъектАналитики КАК Справочник.БанковскиеСчета).Валюта <> _ПрочиеАктивы.ВалютаУчета
		|			ТОГДА 12
		|		КОГДА &МНОВРазделеДенежныеСредства
		|				И _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И ТИПЗНАЧЕНИЯ(_ПрочиеАктивы.СубъектАналитики) = ТИП(Документ.МНО)
		|			ТОГДА 11
		|		КОГДА НЕ &МНОВРазделеДенежныеСредства
		|				И _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И ТИПЗНАЧЕНИЯ(_ПрочиеАктивы.СубъектАналитики) = ТИП(Документ.МНО)
		|			ТОГДА 53
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|				И ВЫРАЗИТЬ(_ПрочиеАктивы.СубъектАналитики КАК Справочник.ДепозитныеВклады).БанковскийСчет.Валюта = _ПрочиеАктивы.ВалютаУчета
		|			ТОГДА 21
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|				И ВЫРАЗИТЬ(_ПрочиеАктивы.СубъектАналитики КАК Справочник.ДепозитныеВклады).БанковскийСчет.Валюта <> _ПрочиеАктивы.ВалютаУчета
		|			ТОГДА 22
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И ТИПЗНАЧЕНИЯ(_ПрочиеАктивы.СубъектАналитики) = ТИП(Справочник.БрокерскиеКомпании)
		|			ТОГДА 51
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И _ПрочиеАктивы.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона))
		|			ТОГДА 52
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|			ТОГДА 53
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|				И _ПрочиеАктивы.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария)
		|			ТОГДА 81
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|				И _ПрочиеАктивы.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющего)
		|			ТОГДА 82
