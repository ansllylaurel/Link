	ТаблицаРаздела = РезультатЗапроса[КоличествоВПакете - 1].Выгрузить();
	Для Каждого СтрокаТаблицы Из ТаблицаРаздела Цикл
		
		Если СтрокаТаблицы.ВидЦБ = "Проценты по МНО" ИЛИ СтрокаТаблицы.Субъект = "По сделке" ИЛИ СтрокаТаблицы.Субъект = "По 1-й части РЕПО" ИЛИ СтрокаТаблицы.Субъект = "По 2-й части РЕПО" Тогда
			СтрокаТаблицы.Субъект = СтрокаТаблицы.Субъект + " " + Формат(СтрокаТаблицы.ДетализацияСубъекта, "ЧГ=0");			
