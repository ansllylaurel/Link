Функция ПолучитьВыгрузкиРСА_СДКГарант(СписокСсылок, Разрядность = 5, Подписант, ПодписантДолжность = "") Экспорт
	
	МассивРезультата  = Новый Массив;
	СтруктураДанных   = Новый Структура;
		
	// Список колонок файла
	// [ДатаОтч];[УК];[ИНН_УК];[КПП_УК];[НомерДоговораДУ];[ДатаДоговораДУ];[ДатаОтчетаФ];[ВремяОтчета];[Валюта];[УполЛицо];[ДолжностьУЛ]; //1-11
	// [ТипРасчета];[ИдУчастия];[Субъект];[Эмитент];[ВидЦБ];[РегНомер];[РынЦена];[Колво];[Стоимость];[Источник]; //12-21
	// [ISIN];[CFI];[НаименованиеКО];[ДатаДоговораБС];[НомерДоговораБС];[РеквизитыБС];[Стоимость2];[Проценты];  //22-29
	// [Учредитель];[ИНН_Фонд];[КПП_Фонд]  //32
			
	ОбщиеРеквизиты 		= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СписокСсылок[0], "Дата,Организация"); 
	ДатаДокумента     	= ОбщиеРеквизиты.Дата;
	ЭтоФормаС2018Года 	= ДатаДокумента >= '20180101';
	ЦельРасчета 		= Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;
	
	// по задаче #263936 единица измерения руб/тыс.руб настраивается в зависимости от даты формирования
	Если ЭтотОбъект.ДатаИВремяФормирования >= '20190628' Тогда
		ЕдИзмВалюты = "Руб.";
		Коэффициент = 1;
	Иначе
		ЕдИзмВалюты = "Тыс. руб.";
		Коэффициент = 1000;
	КонецЕсли;	
		
	Для Каждого СтрокаСписка Из СписокСсылок Цикл
			
		ТекДокумент = СтрокаСписка;
		Если ТекДокумент = ПредопределенноеЗначение("Документ.РегистрацияСтоимостиАктивов.ПустаяСсылка") Тогда
			Продолжить;
		КонецЕсли;
		
		НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(ДатаДокумента, ОбщиеРеквизиты.Организация, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекДокумент, "СчетДоверительногоУправления"), ЦельРасчета);
		
		// ПараметрыСверткиЦенныхБумаг:
		// 	- ВыполнятьРасчетПоПисьмуЦБ0185316 						- вид цены во всех строках ЦБ заменяется на РасчетнаяЦена, строки сворачиваются
		// 	- СворачиватьСтрокиЦеннойБумагиСРазличнымиВидамиЦены 	- с 31.08.2023 Истина без дополнительных условий, т. к. ЭДО СДК Гарант не умеет загружать более одной строки по бумаге.
		//															  Если у ценной бумаги несколько видов цены, 	
		//
		ПараметрыСверткиЦенныхБумаг = Новый Структура("ВыполнятьРасчетПоПисьмуЦБ0185316, СворачиватьСтрокиЦеннойБумагиСРазличнымиВидамиЦены", 
												НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316, 
												ДатаДокумента >= '20230831');
		
		ТекстЗапроса = ПолучитьТекстЗапроса(ТекДокумент, "РСАСДКГарант", ПараметрыСверткиЦенныхБумаг);
		
		Результат = ПодготовитьРезультатДляВыводаРСА(ТекДокумент, ТекстЗапроса, Ложь, ЭтоФормаС2018Года, Подписант);

		Если Результат = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ИмяФонда = Результат.ДанныеКлиентаКратко;
		ИмяФонда = СтрЗаменить(ИмяФонда, "\",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, "/",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, "*",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, "?",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, """", "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, "<",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, ">",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, ":",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, "|",  "_");
		
		// Не учитываем ИНН, КПП
		ПозицияЗапятой = СтрНайти(ИмяФонда, ",");
		Если ПозицияЗапятой > 0 Тогда
			ИмяФонда = Лев(ИмяФонда, ПозицияЗапятой-1);	
		КонецЕсли;

		ТекстОтчета = Новый ТекстовыйДокумент;
		
		СтрДанныеОрганизации = Результат.ДанныеОрганизацииКратко;
		СтрДанныеОрганизации = СтрЗаменить(СтрДанныеОрганизации, ", ИНН ", ";");
		СтрДанныеОрганизации = СтрЗаменить(СтрДанныеОрганизации, "/КПП ", ";");
		СтрДоговор 			 = Результат.НомерДоговора + ";" + Формат(Результат.ДатаДоговора, "ДФ=dd.MM.yyyy");
		СтрДоговор			 = СокрЛП(СтрДоговор);

		Результат.Вставить("ЕдиницаИзмерения", ЕдИзмВалюты);
		
		СтрокаДоПоказателей = Результат.ДатаОтчета + ";"
								+ СтрДанныеОрганизации + ";"
								+ СтрДоговор + ";"
								+ Формат(Результат.ДатаФормирования, "ДФ=dd.MM.yyyy") + ";"
								+ Результат.ВремяФормирования + ";"
								+ Результат.ЕдиницаИзмерения + ";"
								+ Результат.ФИОПодписанта + ";"
								+ ?(ЗначениеЗаполнено(СокрЛП(ПодписантДолжность)), СокрЛП(ПодписантДолжность), "");
				
		СтрИмяФонда            = Результат.ДанныеКлиентаКратко;
		СтрИмяФонда            = СтрЗаменить(СтрИмяФонда, ", ИНН ", ";");
		СтрИмяФонда            = СтрЗаменить(СтрИмяФонда, "/КПП ", ";");
		СтрокаПослеПоказателей = ";" + СтрИмяФонда;
		
		ИдУчастия = "";  		
		
		Для Каждого ЭлементСтруктуры Из Результат Цикл
			
			Если Не Лев(ЭлементСтруктуры.Ключ, 13) = "МассивРаздела" Тогда 
				Продолжить;
			КонецЕсли;
			
			ТипРасчета = ОпределитьТипРасчета(ЭлементСтруктуры.Ключ, Неопределено);
			
			НаименованиеРаздела = ЭлементСтруктуры.Ключ;
			МассивСтрокРаздела = ЭлементСтруктуры.Значение;
			Для Каждого ТекСтрока Из МассивСтрокРаздела Цикл
				
				Если ТекСтрока.Свойство("ОПФЭмитента") Тогда
					ТипРасчета = ОпределитьТипРасчета(ЭлементСтруктуры.Ключ, ТекСтрока.ОПФЭмитента);			
				КонецЕсли;
				
				// Значимые колонки с 12 по 29. Заполним их через предварительно подготовленную структуру		
				Показатели = Новый Структура("ТипРасчета,ИдУчастия,Субъект,Эмитент,ВидЦБ,РегНомер,РынЦена,Колво,Стоимость,Источник,ISIN,CFI,НаименованиеКО,ДатаДоговораБС,НомерДоговораБС,РеквизитыБС,Стоимость2,Проценты",
											  ТипРасчета, ИдУчастия, "",   "",     "",   "",      0,      0,    0,        "",      "",  "", "",            "",            "",             "",         0,         0);
								
				ЗаполнитьПоказатели(НаименованиеРаздела, ТекСтрока, Показатели);
				
				ТекстПоказателей = СформироватьТекстПоказателей(Показатели, Коэффициент, Разрядность);
				
				НоваяСтрока = СтрокаДоПоказателей + ";" + ТекстПоказателей + ";" + СтрокаПослеПоказателей;
				ТекстОтчета.ДобавитьСтроку(НоваяСтрока);
			
			КонецЦикла;
	
		КонецЦикла;
		
		// Добавляем пустую строку
		Если ТекстОтчета.КоличествоСтрок() = 0 Тогда
			Показатели = Новый Структура("ТипРасчета,ИдУчастия,Субъект,Эмитент,ВидЦБ,РегНомер,РынЦена,Колво,Стоимость,Источник,ISIN,CFI,НаименованиеКО,ДатаДоговораБС,НомерДоговораБС,РеквизитыБС,Стоимость2,Проценты",
											  "15", "", "Итого",   "",     "",   "",      0,      0,    0,        "",      "",  "", "",            "",            "",             "",         0,         0);
			ТекстПоказателей = СформироватьТекстПоказателей(Показатели, Коэффициент, Разрядность);
			НоваяСтрока = СтрокаДоПоказателей + ";" + ТекстПоказателей + ";" + СтрокаПослеПоказателей;
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);
		КонецЕсли;	
		
		Если ТекстОтчета <> Неопределено Тогда
			СтруктураДанных.Вставить("ТекстОтчета", ТекстОтчета);
			СтруктураДанных.Вставить("ИмяФайла",    Результат.СДУ);
			СтруктураДанных.Вставить("ДатаОтчета",  Результат.ДатаОтчета);
			МассивРезультата.Добавить(СтруктураДанных);
		КонецЕсли;

	КонецЦикла;

	Возврат МассивРезультата;
	
КонецФункции

Функция ПолучитьВыгрузкиФормы029(СписокСсылок, Разрядность, Подписант) Экспорт
	
	МассивРезультата  = Новый Массив;
	СтруктураДанных   = Новый Структура;

	Кавычки = """";
	ВремяXML = " 00:00:00";

	ТекстОтчета = Неопределено;
	Для Каждого ТекДокумент Из СписокСсылок Цикл
			
		Результат = ПодготовитьРезультатДляВыгрузкиФормы029(ТекДокумент, Подписант);
		
		ИмяФонда = Результат.ДанныеКлиентаКратко;
		ИмяФонда = СтрЗаменить(ИмяФонда, "\",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, "/",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, "*",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, "?",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, """", "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, "<",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, ">",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, ":",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, "|",  "_");
		
		// Не учитываем ИНН, КПП
		ПозицияЗапятой = СтрНайти(ИмяФонда, ",");
		Если ПозицияЗапятой > 0 Тогда
			ИмяФонда = Лев(ИмяФонда, ПозицияЗапятой-1);	
		КонецЕсли;

		ТекстОтчета = Новый ТекстовыйДокумент;
		
		Если Результат.Свойство("ВидДоговораДоверительногоУправления") Тогда
			Если Результат.ВидДоговораДоверительногоУправления = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР") Тогда
				НаименованиеОрганизации = Результат.ДанныеОрганизации;
			Иначе	
				НаименованиеОрганизации = Результат.НаименованиеОрганизации;
			КонецЕсли;
		Иначе
			НаименованиеОрганизации = Результат.НаименованиеОрганизации;
		КонецЕсли;
		
		НайдПозиция = СтрНайти(НаименованиеОрганизации, ", ИНН ");
		Если НайдПозиция > 0 Тогда
			НаименованиеОрганизации = СокрЛП(Лев(НаименованиеОрганизации, НайдПозиция - 1));
		КонецЕсли;
		
		// Заголовок файла
		НоваяСтрока = "<?xml version=" + Кавычки + "1.0" + Кавычки + " encoding=" + Кавычки + "windows-1251" + Кавычки + " standalone=""yes""?>";
		ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		
		
		НоваяСтрока = "<EDO_ODKF029>";
		ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		
			
		НоваяСтрока = "<ReportOnDate>" + Формат(Результат.ДатаОтчетаДата, "ДФ=dd.MM.yyyy") + ВремяXML + "</ReportOnDate>";
		ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		
		
		НоваяСтрока = "<DateCreate>" + Формат(Результат.ДатаФормирования, "ДФ=dd.MM.yyyy") + ВремяXML + "</DateCreate>";
		ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		
				
		НоваяСтрока = "<DocNumber></DocNumber>";
		ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		
		
		НоваяСтрока = "<NameUK>" + НаименованиеОрганизации + "</NameUK>";
		ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		
		
		НоваяСтрока = "<IDInvestcase>" + Результат.КодПортфеля + "</IDInvestcase>";
		ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		
		
		НоваяСтрока = "<DDUNumber>" + Формат(Результат.ДатаДоговора, "ДФ=dd.MM.yyyy") + " № " + Результат.НомерДоговора + "</DDUNumber>";
		ТекстОтчета.ДобавитьСтроку(НоваяСтрока);
		
		МассивСтрок = Результат.МассивСтрок;
		
		// Таблица
		Для Каждого ТекСтрока Из МассивСтрок Цикл
				
			НоваяСтрока = "<ClientCashDataTable>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		
				
			НоваяСтрока = "<Code>" + ТекСтрока.КлассАктива + "</Code>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		
			
			НоваяСтрока = "<AccountCode>" + ТекСтрока.НомерСчетаЕПС + "</AccountCode>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		

			НоваяСтрока = "<AssetCode>" + ТекСтрока.ИдентификаторАктива + "</AssetCode>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		

			НоваяСтрока = "<GRN>" + ТекСтрока.НомерГосРегистрации + "</GRN>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		

			НоваяСтрока = "<AssetName>" + ТекСтрока.НаименованиеАктива + "</AssetName>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		

			Если ТипЗнч(ТекСтрока.Количество) = Тип("Число") И Цел(ТекСтрока.Количество) <> ТекСтрока.Количество Тогда
				НоваяСтрока = "<CountAsset>" + ПолучитьЗапись(ТекСтрока, "Количество", Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти) + "</CountAsset>";
			Иначе
				НоваяСтрока = "<CountAsset>" + ПолучитьЗапись(ТекСтрока, "Количество", Разрядность) + "</CountAsset>";
			КонецЕсли;
		
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		

			НоваяСтрока = "<Rate>" + ПолучитьЗапись(ТекСтрока, "Котировка", 10) + "</Rate>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		

			НоваяСтрока = "<IDCurRate>" + ТекСтрока.КодВалюты + "</IDCurRate>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		

			НоваяСтрока = "<DateRate>" + Формат(ТекСтрока.ДатаКотировки, "ДФ=dd.MM.yyyy") + "</DateRate>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		

			НоваяСтрока = "<NameRate>" + ТекСтрока.НаименованиеКотировки + "</NameRate>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		

			НоваяСтрока = "<FirmTrade>" + ТекСтрока.ИсточникЦены + "</FirmTrade>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		

			НоваяСтрока = "<LevelRate>" + ТекСтрока.УровеньОценки + "</LevelRate>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		

			НоваяСтрока = "<Nominal>" + ПолучитьЗапись(ТекСтрока, "Номинал", Разрядность) + "</Nominal>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		

			НоваяСтрока = "<Summa>" + ПолучитьЗапись(ТекСтрока, "Сумма", Разрядность) + "</Summa>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		

			НоваяСтрока = "<NKD>" + ПолучитьЗапись(ТекСтрока, "ЦенаКупона", Разрядность) + "</NKD>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		

			НоваяСтрока = "<SumNKD>" + ПолучитьЗапись(ТекСтрока, "Купон", Разрядность) + "</SumNKD>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		

			НоваяСтрока = "<SummaWithNKD>" + ПолучитьЗапись(ТекСтрока, "СуммаСКупоном", Разрядность) + "</SummaWithNKD>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		

			НоваяСтрока = "<SBRes>" + ПолучитьЗапись(ТекСтрока, "РезервПодОбесценение", Разрядность) + "</SBRes>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		

			НоваяСтрока = "<SummaAll>" + ПолучитьЗапись(ТекСтрока, "СуммаИтого", Разрядность) + "</SummaAll>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		
			
			Если ТекСтрока.ВыгружатьКомментарий Тогда
								
				Отказ = Ложь;
				Комментарий = СформироватьКомментарийДляФормы029(ТекСтрока, Результат.НомерДоговора, Отказ);				
				Если Отказ Тогда
					ВызватьИсключение "Превышена длина поля Comment по договору ДУ №" + Результат.НомерДоговора + "; текст: " + Комментарий;
				КонецЕсли;
				
				Если Не ПустаяСтрока(Комментарий) Тогда
					НоваяСтрока = "<Comment>" + Комментарий + "</Comment>";
					ТекстОтчета.ДобавитьСтроку(НоваяСтрока);					
				КонецЕсли;
								
			КонецЕсли;			
				
			НоваяСтрока = "</ClientCashDataTable>";
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);
			
		КонецЦикла;
		
		НоваяСтрока = "</EDO_ODKF029>";
		ТекстОтчета.ДобавитьСтроку(НоваяСтрока);
		
		Если ТекстОтчета <> Неопределено Тогда
			СтруктураДанных.Вставить("ТекстОтчета", ТекстОтчета);
			СтруктураДанных.Вставить("ИмяФайла",    Результат.СДУ);
			СтруктураДанных.Вставить("ДатаОтчета",    Результат.ДатаОтчета);
			МассивРезультата.Добавить(СтруктураДанных);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивРезультата;
	
КонецФункции

Функция ПолучитьВыгрузкиФормы685(СписокСсылок, РуководительПИФ, УполномоченноеЛицоСД) Экспорт
	
	МассивРезультата  = Новый Массив;
	СтруктураДанных   = Новый Структура;

	Кавычки 			= """";
	ВремяXML 			= " 00:00:00";
	ФорматЧисла 		= "ЧРД=.; ЧГ=0";
	ФорматЦелогоЧисла 	= "ЧДЦ=0; ЧГ=0";
		
	ТекстОтчета = Неопределено;
	Для Каждого ТекДокумент Из СписокСсылок Цикл
			
		Результат = ПодготовитьРезультатДляВыгрузкиФормы685(ТекДокумент);
		// Таблицы:
		//	ОсновныеДанные
		//	ЦенныеБумаги
		//	ДебиторскаяЗадолженность
		//	ДенежныеСредства
		//	Доли
		
		Если Результат.ОсновныеДанные.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОсновныеДанные = Результат.ОсновныеДанные[0];
		ИмяПИФ = ПолучитьИмяПИФ(ОсновныеДанные.КраткоеНаименованиеПИФ);
						
		ТекстОтчета = Новый ТекстовыйДокумент;
				
		// Заголовок файла
		ТекстОтчета.ДобавитьСтроку("<?xml version=" + Кавычки + "1.0" + Кавычки + " encoding=" + Кавычки + "windows-1251" + Кавычки + " standalone=""yes""?>");		
		                  		
		ТекстОтчета.ДобавитьСтроку("<EDO_ODKF685>");		
			
		ТекстОтчета.ДобавитьСтроку("<ReportOnDate>" + Формат(Результат.ДатаОтчетаДата, "ДФ=dd.MM.yyyy") + ВремяXML + "</ReportOnDate>");		
		
		ТекстОтчета.ДобавитьСтроку("<FullNamePIF>" + ОсновныеДанные.ПолноеНаименованиеПИФ + "</FullNamePIF>");
		
		ТекстОтчета.ДобавитьСтроку("<RegNomDDU>" + ОсновныеДанные.НомерПравилПИФ + "</RegNomDDU>");		
		
		ТекстОтчета.ДобавитьСтроку("<ISINPIF>" + ОсновныеДанные.ISIN + "</ISINPIF>");		
		
		ТекстОтчета.ДобавитьСтроку("<NameUKPIF>" + ОсновныеДанные.ПолноеНаименованиеУК + "</NameUKPIF>");		
		
		ТекстОтчета.ДобавитьСтроку("<INNUKPIF>" + ОсновныеДанные.ИННУК + "</INNUKPIF>");				
		
		ТекстОтчета.ДобавитьСтроку("<ReportDate>" + Формат(Результат.ДатаОтчета, "ДФ=dd.MM.yyyy") + ВремяXML + "</ReportDate>");		
				
		ТекстОтчета.ДобавитьСтроку("<IDCurrancy>" + ОсновныеДанные.КодВалюты + "</IDCurrancy>");				    		
		
		ТекстОтчета.ДобавитьСтроку("<SumActivPIF>" + ФорматЧислаДляФормы685(ОсновныеДанные.СтоимостьАктивов, ФорматЧисла, ФорматЦелогоЧисла) + "</SumActivPIF>");				
		
		ТекстОтчета.ДобавитьСтроку("<SumSCHAPIF>" + ФорматЧислаДляФормы685(ОсновныеДанные.СтоимостьЧистыхАктивов, ФорматЧисла, ФорматЦелогоЧисла) + "</SumSCHAPIF>");
		
		ТекстОтчета.ДобавитьСтроку("<RespPersonPost>" + РуководительПИФ + "</RespPersonPost>");
		
		ТекстОтчета.ДобавитьСтроку("<RespPersonPostSD>" + УполномоченноеЛицоСД + "</RespPersonPostSD>");
		
		ТекстОтчета.ДобавитьСтроку("<IDInvestcaseFond>" + ОсновныеДанные.КодИнвестиционногоСчета + "</IDInvestcaseFond>");
		
		ТекстОтчета.ДобавитьСтроку("<SumSCHAPIFOneSec>" + ФорматЧислаДляФормы685(ОсновныеДанные.СтоимостьПая, ФорматЧисла, ФорматЦелогоЧисла)  + "</SumSCHAPIFOneSec>");
		
		// Ценные бумаги
		Для Каждого ТекСтрока Из Результат.ЦенныеБумаги Цикл
				
			ТекстОтчета.ДобавитьСтроку("<ClientCashDataTable>");		
			
			ТекстОтчета.ДобавитьСтроку("<CBName>" + ТекСтрока.НаименованиеАктива + "</CBName>");
					
			ТекстОтчета.ДобавитьСтроку("<GRN>" + ТекСтрока.НомерГосРегистрации + "</GRN>");
						
			ТекстОтчета.ДобавитьСтроку("<ISIN>" + ТекСтрока.ISIN + "</ISIN>");
			
			ТекстОтчета.ДобавитьСтроку("<INN>" + ТекСтрока.ИННЭмитента + "</INN>");
			
			ТекстОтчета.ДобавитьСтроку("<EmitentName>" + ТекСтрока.НаименованиеЭмитента + "</EmitentName>");
			
			ТекстОтчета.ДобавитьСтроку("<CBCount>" + ФорматЧислаДляФормы685(ТекСтрока.Количество, ФорматЧисла, ФорматЦелогоЧисла) + "</CBCount>");
			
			ТекстОтчета.ДобавитьСтроку("<IDCurrency>" + ТекСтрока.КодВалюты + "</IDCurrency>");
			
			ТекстОтчета.ДобавитьСтроку("<SumInCurCB>" + ФорматЧислаДляФормы685(ТекСтрока.Сумма, ФорматЧисла, ФорматЦелогоЧисла) + "</SumInCurCB>");
													
			ТекстОтчета.ДобавитьСтроку("</ClientCashDataTable>");
						
		КонецЦикла;
		
		// Дебиторская задолженность
		Для Каждого ТекСтрока Из Результат.ДебиторскаяЗадолженность Цикл
				
			ТекстОтчета.ДобавитьСтроку("<DataDZad>");	
			
			ТекстОтчета.ДобавитьСтроку("<DebitorName>" + ТекСтрока.НаименованиеКонтрагента + "</DebitorName>");
			
			ТекстОтчета.ДобавитьСтроку("<INN>" + ТекСтрока.ИННКонтрагента + "</INN>");
			
			ТекстОтчета.ДобавитьСтроку("<DebitorType>" + ТекСтрока.ТипКонтрагента + "</DebitorType>");
			
			ТекстОтчета.ДобавитьСтроку("<CreditType>" + ТекСтрока.ВидЗадолженности + "</CreditType>");
			
			ТекстОтчета.ДобавитьСтроку("<BasementCredit>" + ТекСтрока.ОснованиеЗадолженности + ?(ЗначениеЗаполнено(ТекСтрока.ОснованиеЗадолженности_Дата), Формат(ТекСтрока.ОснованиеЗадолженности_Дата, "ДФ=dd.MM.yyyy"), "") + ?(ЗначениеЗаполнено(ТекСтрока.ИдентификаторАктива), ", ISIN " + ТекСтрока.ИдентификаторАктива, "") + "</BasementCredit>");

			ТекстОтчета.ДобавитьСтроку("<IDCurrency>" + ТекСтрока.КодВалюты + "</IDCurrency>");
			
			ТекстОтчета.ДобавитьСтроку("<SumInCurCredit>" + ФорматЧислаДляФормы685(ТекСтрока.Сумма, ФорматЧисла, ФорматЦелогоЧисла) + "</SumInCurCredit>");
			
			ТекстОтчета.ДобавитьСтроку("<Control_5343y>" + ТекСтрока.СоответствуетУсловиям5343у + "</Control_5343y>");
			
			ТекстОтчета.ДобавитьСтроку("<CodLEI>" + ТекСтрока.КодLEI + "</CodLEI>");
																
			ТекстОтчета.ДобавитьСтроку("</DataDZad>");
						
		КонецЦикла;

		// Денежные средства
		Для Каждого ТекСтрока Из Результат.ДенежныеСредства Цикл
				
			ТекстОтчета.ДобавитьСтроку("<DataMoney>");	
			
			ТекстОтчета.ДобавитьСтроку("<BankName>" + ТекСтрока.НаименованиеКонтрагента + "</BankName>");
			
			ТекстОтчета.ДобавитьСтроку("<BIK>" + ТекСтрока.БИКБанка + "</BIK>");
			
			ТекстОтчета.ДобавитьСтроку("<BankINN>" + ТекСтрока.ИННКонтрагента + "</BankINN>");
			
			ТекстОтчета.ДобавитьСтроку("<IDAccountType>" + ТекСтрока.ТипСчета + "</IDAccountType>");
			
			ТекстОтчета.ДобавитьСтроку("<Control_5343y>" + ТекСтрока.СоответствуетУсловиям5343у + "</Control_5343y>");
			
			ТекстОтчета.ДобавитьСтроку("<SubordDeposit>" + ТекСтрока.Субординированный + "</SubordDeposit>");

			ТекстОтчета.ДобавитьСтроку("<IDCurrency>" + ТекСтрока.КодВалюты + "</IDCurrency>");
			
			ТекстОтчета.ДобавитьСтроку("<SumInCurAccount>" + ФорматЧислаДляФормы685(ТекСтрока.Сумма, ФорматЧисла, ФорматЦелогоЧисла) + "</SumInCurAccount>");
			                          																
			ТекстОтчета.ДобавитьСтроку("</DataMoney>");
						
		КонецЦикла;

		// Доли
		Для Каждого ТекСтрока Из Результат.Доли Цикл
				
			ТекстОтчета.ДобавитьСтроку("<DataPai>");	
			
			ТекстОтчета.ДобавитьСтроку("<NameOOO>" + ТекСтрока.НаименованиеООО + "</NameOOO>");
								
			ТекстОтчета.ДобавитьСтроку("<INN>" + ТекСтрока.ИННООО + "</INN>");
									
			ТекстОтчета.ДобавитьСтроку("<SumInRub>" + ФорматЧислаДляФормы685(ТекСтрока.Сумма, ФорматЧисла, ФорматЦелогоЧисла) + "</SumInRub>");
			                          																
			ТекстОтчета.ДобавитьСтроку("</DataPai>");
						
		КонецЦикла;	
		
		НоваяСтрока = "</EDO_ODKF685>";
		ТекстОтчета.ДобавитьСтроку(НоваяСтрока);
		
		Если ТекстОтчета <> Неопределено Тогда
			СтруктураДанных.Вставить("ТекстОтчета", 	ТекстОтчета);
			СтруктураДанных.Вставить("ИмяФайла",    	ИмяПИФ);
			СтруктураДанных.Вставить("ДатаОтчета",    	Результат.ДатаОтчета);
			МассивРезультата.Добавить(СтруктураДанных);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивРезультата;
	
КонецФункции

Функция ФорматЧислаДляФормы685(Значение, ФорматЧисла, ФорматЦелогоЧисла)
	
	Результат = Формат(Значение, ?(Цел(Значение) = Значение, ФорматЦелогоЧисла, ФорматЧисла));
	
	// У дробного числа нужно не менее 2х знаков дробной части
	Возврат ?(Цел(Значение) <> Значение И Окр(Значение, 1, 1) = Значение, Результат + "0", Результат);
	
КонецФункции

Функция ПолучитьВыгрузкиСЧА_СДКГарант(СписокСсылок, Разрядность, Подписант, ПодписантДолжность = "") Экспорт

	МассивРезультата  = Новый Массив;
	СтруктураДанных   = Новый Структура;

	ДатаДокумента 		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СписокСсылок[0], "Дата"); 
	ЭтоФормаС2018Года   = ДатаДокумента >= '20180101';

	// по задаче #263936 единица измерения руб/тыс.руб настраивается в зависимости от даты формирования
	Если ЭтотОбъект.ДатаИВремяФормирования >= '20190628' Тогда
		ЕдИзмВалюты = "Руб.";
		Коэффициент = 1;
	Иначе
		ЕдИзмВалюты = "Тыс. руб.";
		Коэффициент = 1000;
	КонецЕсли;	
	
	// Текст запроса получаем один раз из первого документа
	ТекстЗапроса = ПолучитьТекстЗапроса(СписокСсылок[0], "СЧАСДКГарант");

	Для Каждого СтрокаСписка Из СписокСсылок Цикл
			
		ТекДокумент = СтрокаСписка;
		Если ТекДокумент = ПредопределенноеЗначение("Документ.РегистрацияСтоимостиАктивов.ПустаяСсылка") Тогда
			Продолжить;
		КонецЕсли;
		
		ДатаДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекДокумент, "Дата"); 
		
		Результат = ПодготовитьРезультатДляВыводаСЧА(ТекДокумент, ТекстЗапроса, Коэффициент, ЭтоФормаС2018Года, Подписант);
		
		Если Результат = Неопределено Тогда
			Продолжить;
		КонецЕсли;    	
	
		ИмяФонда = Результат.ДанныеКлиентаКратко;
		ИмяФонда = СтрЗаменить(ИмяФонда, "\",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, "/",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, "*",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, "?",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, """", "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, "<",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, ">",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, ":",  "_");
		ИмяФонда = СтрЗаменить(ИмяФонда, "|",  "_");
		
		// Не учитываем ИНН, КПП
		ПозицияЗапятой = СтрНайти(ИмяФонда, ",");
		Если ПозицияЗапятой > 0 Тогда
			ИмяФонда = Лев(ИмяФонда, ПозицияЗапятой-1);	
		КонецЕсли;
		
		ТекстОтчета = Новый ТекстовыйДокумент;
		
		СтрДанныеОрганизации = Результат.ДанныеОрганизацииКратко;
		СтрДанныеОрганизации = СтрЗаменить(СтрДанныеОрганизации, ", ИНН ", ";");
		СтрДанныеОрганизации = СтрЗаменить(СтрДанныеОрганизации, "/КПП ", ";");
		СтрДоговор 			 = Результат.НомерДоговора + ";" + Формат(Результат.ДатаДоговора, "ДФ=dd.MM.yyyy");
		СтрДоговор           = СокрЛП(СтрДоговор);
		
		Результат.Вставить("ЕдиницаИзмерения", ЕдИзмВалюты);
		
		СтрокаДоПоказателя = Результат.ДатаОтчета + ";" + СтрДанныеОрганизации + ";" + СтрДоговор + ";" + Формат(Результат.ДатаФормирования, "ДФ=dd.MM.yyyy") + ";" + Результат.ВремяФормирования + ";" + Результат.ВремяФормирования + ";";  
		СтрокаДоПоказателя = СтрокаДоПоказателя + Результат.ФИОПодписанта + ";" + ?(ЗначениеЗаполнено(СокрЛП(ПодписантДолжность)), СокрЛП(ПодписантДолжность) + ";", ";");		
						
		СтрИмяФонда           = Результат.ДанныеКлиентаКратко;
		СтрИмяФонда           = СтрЗаменить(СтрИмяФонда, ", ИНН ", ";");
		СтрИмяФонда           = СтрЗаменить(СтрИмяФонда, "/КПП ", ";");
		СтрокаПослеПоказателя = ";" + СтрИмяФонда;
		
		Для Каждого ЭлементСтруктуры Из Результат Цикл
			
			Если Лев(ЭлементСтруктуры.Ключ, 4) <> "Стр0" Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = СтрокаДоПоказателя + СтрЗаменить(СокрЛП(ЭлементСтруктуры.Ключ), "Стр", "") + ";" + Формат(ЭлементСтруктуры.Значение, "ЧГ=; ЧДЦ=" + Строка(Разрядность)) + СтрокаПослеПоказателя;
			
			ТекстОтчета.ДобавитьСтроку(НоваяСтрока);
			
		КонецЦикла;     		
		
		НоваяСтрока = СтрокаДоПоказателя + СокрЛП("080") + ";" + ?(Результат.Свойство("Стр070"), Формат(Результат.Стр070, "ЧГ=; ЧДЦ=" + Строка(Разрядность)), "0") + СтрокаПослеПоказателя; 
		НоваяСтрока = СтрокаДоПоказателя + СокрЛП("090") + ";" + Формат(Результат.СЧА, "ЧГ=; ЧН=0,00; ЧДЦ=" + Строка(Разрядность)) + СтрокаПослеПоказателя; 
		ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		
		
		Если ТекстОтчета <> Неопределено Тогда
			СтруктураДанных.Вставить("ТекстОтчета", ТекстОтчета);
			СтруктураДанных.Вставить("ИмяФайла",    Результат.СДУ);
			СтруктураДанных.Вставить("ДатаОтчета",    Результат.ДатаОтчета);
			МассивРезультата.Добавить(СтруктураДанных);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивРезультата;
	
КонецФункции

Функция ПолучитьТабличныеДокументыСЧАМСД(СписокСсылок, Подписант, Разрядность = 2) Экспорт
	
	Результат = Новый Массив;
			
	Для Каждого ТекДокумент Из СписокСсылок Цикл
		
		Если ТекДокумент = ПредопределенноеЗначение("Документ.РегистрацияСтоимостиАктивов.ПустаяСсылка") Тогда
			Продолжить;
		КонецЕсли;
		
		ВидДоговора = Неопределено;
		Макет = ОпределитьМакет("СЧАМСД", , Ложь, ВидДоговора, ТекДокумент); 
		Если Макет = Неопределено Тогда
			Возврат Результат;	
		КонецЕсли;

		ОбластиМакета = ПолучитьОбластиМакетаДляСЧАМСД(Макет, ВидДоговора);
		
		Если ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР
			ИЛИ ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
			ТекстЗапроса = ПолучитьТекстЗапроса(ТекДокумент, "СЧАМСД");
		ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
			ТекстЗапроса = ПолучитьТекстЗапроса(ТекДокумент, "СЧАМСД_ПР");
		КонецЕсли;	

		Если ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР
			ИЛИ ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
			ТабличныйДокумент = СформироватьТабличныйДокументСЧАМСД(ТекДокумент, ТекстЗапроса, ОбластиМакета, Подписант);
		ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
			ТабличныйДокумент = СформироватьТабличныйДокументСЧАМСД_ПР(ТекДокумент, ТекстЗапроса, ОбластиМакета, Подписант);
		КонецЕсли;	
		
		Если ТабличныйДокумент <> Неопределено Тогда
			Результат.Добавить(ТабличныйДокумент);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции	

Функция ПолучитьТабличныеДокументыРСАМСД(СписокСсылок, Подписант) Экспорт
	
	Результат = Новый Массив;
	
	Макет = ОпределитьМакет("РСАМСД",,,,СписокСсылок[0]); 
	Если Макет = Неопределено Тогда
		Возврат Результат;	
	КонецЕсли;
		
	ТекстЗапроса = ПолучитьТекстЗапроса(СписокСсылок[0], "РСАМСД");
	
	ОбластиМакета = ПолучитьОбластиМакетаДляРСАМСД(Макет);
	
	Для Каждого ТекДокумент Из СписокСсылок Цикл
		
		Если ТекДокумент = ПредопределенноеЗначение("Документ.РегистрацияСтоимостиАктивов.ПустаяСсылка") Тогда
			Продолжить;
		КонецЕсли;
		
		ТабличныйДокумент = СформироватьТабличныйДокументРСАМСД(ТекДокумент, ТекстЗапроса, ОбластиМакета, Подписант);
		
		Если ТабличныйДокумент <> Неопределено Тогда
			Результат.Добавить(ТабличныйДокумент);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТабличныеДокументыРСАОСД(СписокСсылок, Подписант) Экспорт
	
	Результат = Новый Массив;
	
	ДатаДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СписокСсылок[0], "Дата");
	
	Если ДатаДокумента < Дата(2020,1,1) Тогда
		Макет = ОпределитьМакет("РСА", ДатаДокумента,,,СписокСсылок[0]);
	Иначе
		Макет = ОпределитьМакет2020("РСАОСД", ДатаДокумента,,,СписокСсылок[0]);
	КонецЕсли;
	
	Если Макет = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ДатаДокумента < Дата(2020,1,1) Тогда
		ОбластиМакета = ПолучитьОбластиМакетаДляРСАОСД(Макет);
	Иначе
		ОбластиМакета = ПолучитьОбластиМакетаДляРСАОСД2020(Макет);
	КонецЕсли;                                        	
		
	// Текст запроса получаем один раз из первого документа
	ТекстЗапроса = ПолучитьТекстЗапроса(СписокСсылок[0], "РСАОСД");
	
	// Для каждого документа формируем отчет
	Для Каждого ТекДокумент Из СписокСсылок Цикл
		
		Если ТекДокумент = ПредопределенноеЗначение("Документ.РегистрацияСтоимостиАктивов.ПустаяСсылка") Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДатаДокумента < Дата(2020,1,1) Тогда
			ТабличныйДокумент = СформироватьТабличныйДокументРСАОСД(ТекДокумент, ТекстЗапроса, ОбластиМакета, Подписант);
		Иначе
			ТабличныйДокумент = СформироватьТабличныйДокументРСАОСД2020(ТекДокумент, ТекстЗапроса, ОбластиМакета, Подписант);
		КонецЕсли;
		
		Если ТабличныйДокумент <> Неопределено Тогда
			Результат.Добавить(ТабличныйДокумент);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;	
	
КонецФункции 

Функция ПолучитьРасшифровкуРасчетаРезервов(МассивСсылок) Экспорт 
	
	МассивРасшифровок = Новый Массив;

	Макет = ПолучитьМакет("РасшифровкаРасчетаРезервов");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НачислениеСписаниеРезервов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НачислениеСписаниеРезервовПартии.НомерСтроки КАК НомерСтроки,
		|	НачислениеСписаниеРезервовПартии.Партия КАК Партия,
		|	НачислениеСписаниеРезервовПартии.СтрокаПартии КАК СтрокаПартии,
		|	НачислениеСписаниеРезервовПартии.СуммаРезерваПартии КАК СуммаРезерваПартии,
		|	НачислениеСписаниеРезервовПартии.Количество КАК Количество,
		|	НачислениеСписаниеРезервовПартии.Актив КАК Актив,
		|	НачислениеСписаниеРезервовПартии.АналитикаРезерва КАК АналитикаРезерва,
		|	НачислениеСписаниеРезервовПартии.СтадияОбесценения КАК СтадияОбесценения,
		|	НачислениеСписаниеРезервовПартии.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	НачислениеСписаниеРезервовПартии.EAD КАК EAD,
		|	НачислениеСписаниеРезервовПартии.PD КАК PD,
		|	НачислениеСписаниеРезервовПартии.LGD КАК LGD,
		|	НачислениеСписаниеРезервовПартии.ДатаПогашения КАК ДатаПогашения,
		|	НачислениеСписаниеРезервовПартии.ДнейДоПогашения КАК ДнейДоПогашения,
		|	НачислениеСписаниеРезервовПартии.Формула КАК Формула,
		|	НачислениеСписаниеРезервовПартии.macro КАК macro,
		|	НачислениеСписаниеРезервовПартии.ВидРезерва КАК ВидРезерва,
		|	НачислениеСписаниеРезервовПартии.Профсуждение КАК Профсуждение,
		|	НачислениеСписаниеРезервовПартии.Реструктуризация КАК Реструктуризация,
		|	НачислениеСписаниеРезервовПартии.РейтингДефолт КАК РейтингДефолт,
		|	НачислениеСписаниеРезервовПартии.КоэффициентРезерва КАК КоэффициентРезерва
		|ИЗ
		|	Документ.НачислениеСписаниеРезервов КАК НачислениеСписаниеРезервов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НачислениеСписаниеРезервов.Партии КАК НачислениеСписаниеРезервовПартии
		|		ПО НачислениеСписаниеРезервов.Ссылка = НачислениеСписаниеРезервовПартии.Ссылка
		|			И (НачислениеСписаниеРезервов.Ссылка В (&МассивСсылок))
		|ИТОГИ ПО
		|	СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	
	ГруппировкаПоСчетам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	
	Пока ГруппировкаПоСчетам.Следующий() Цикл
		
		ВыборкаСтрокПартий = ГруппировкаПоСчетам.Выбрать();
					
		ТабличныйДокументРасшифровка = Новый ТабличныйДокумент;
		ТабличныйДокументРасшифровка.Вывести(Макет.ПолучитьОбласть("Шапка"));
		
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
		Пока ВыборкаСтрокПартий.Следующий() Цикл 
				
			ОбластьСтрока.Параметры.Заполнить(ВыборкаСтрокПартий);
			ТабличныйДокументРасшифровка.Вывести(ОбластьСтрока);
	
		КонецЦикла;
		
		МассивРасшифровок.Добавить(Новый Структура("СчетДоверительногоУправления, ТабличныйДокумент", ГруппировкаПоСчетам.СчетДоверительногоУправления, ТабличныйДокументРасшифровка));
		
	КонецЦикла;
		
	Возврат МассивРасшифровок;
	
КонецФункции

#КонецОбласти

#Область Прочие_процедуры_и_функции

Функция ТаблицаСРезервамиПоПогашениямЦБиКупонов(Запрос)
	
	ПогашенияОблигаций = Запрос.МенеджерВременныхТаблиц.Таблицы["_ПогашенияТелаИКупонаПоОблигациям"].ПолучитьДанные().Выгрузить();
	
	// #Техдолг временный
	// Спец. деп желает видеть резерв на погашение купона отдельно от резерва на погашение облигации
	// Когда разделим резервы на бэкофисные и бухгалтерские, этот блок будет удален
	Если ПогашенияОблигаций.Количество() > 0 Тогда
		
		// Вызываем расчет резервов и берем оттуда данные с разделенной суммой резерва
		МассивНачисленийСписанийРезервов = ПогашенияОблигаций.ВыгрузитьКолонку("НачислениеСписаниеРезервов");
		РаботаСКоллекциями.УдалитьПовторяющиесяЗначенияМассива(МассивНачисленийСписанийРезервов); 		
		
		Для Каждого НачислениеСписаниеРезервов Из МассивНачисленийСписанийРезервов Цикл
			
			Если Не ЗначениеЗаполнено(НачислениеСписаниеРезервов) Тогда
				Продолжить;
			КонецЕсли;
			
			ОбъектНачислениеСписаниеРезервов = НачислениеСписаниеРезервов.ПолучитьОбъект();
			
			Отказ = Ложь;
			ДанныеРасчета = Новый ТаблицаЗначений();
			ОбъектНачислениеСписаниеРезервов.ЗаполнитьРезервы(Отказ, ДанныеРасчета);
			
			Для Каждого СтрокаПогашения Из ПогашенияОблигаций Цикл
				НайдСтроки = ДанныеРасчета.НайтиСтроки(Новый Структура("Актив", СтрокаПогашения.Основание)); 
				
				Для Каждого НайдСтрока Из НайдСтроки Цикл
					Если НайдСтрока.EAD = СтрокаПогашения.ПогашениеКупона Тогда
						СтрокаПогашения.РезервНаКупон	= НайдСтрока.СуммаРезерваПартии;
						СтрокаПогашения.ПогашениеКупона	= СтрокаПогашения.ПогашениеКупона - НайдСтрока.СуммаРезерваПартии;
					Иначе	                                                          
						СтрокаПогашения.РезервНаТело	= НайдСтрока.СуммаРезерваПартии;
						СтрокаПогашения.ПогашениеТела	= НайдСтрока.EAD - НайдСтрока.СуммаРезерваПартии;
					КонецЕсли;
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ПогашенияОблигаций;
	
КонецФункции

Функция СформироватьКомментарийДляФормы029(СтрокаДанных, НомерДоговора, Отказ)
	
	// Длина комментария не должна превышать 255 символов.
	// При превышении можно не выводить информацию по полям "Контрагент" ("Банк") и "Договор"
		
	ИНН 				= "";
	КонтрагентБанк 		= "";
	Валюта 				= "";
	Начало				= "";
	Окончание			= "";
	Ставка				= "";
	Сумма				= "";
	Договор				= "";
	ВидЗадолженности	= "";
	
	ТребуетсяКомментарий = Ложь;
	Если СтрокаДанных.КлассАктива = 16 Или СтрокаДанных.КлассАктива = 22 Или СтрокаДанных.КлассАктива = 24 Или СтрокаДанных.КлассАктива = 26 Тогда
		
		ИНН = ?(ЗначениеЗаполнено(СтрокаДанных.ИНН), 						"ИНН=" + СокрЛП(СтрокаДанных.ИНН) + ";", "");
		КонтрагентБанк = ?(ЗначениеЗаполнено(СтрокаДанных.Контрагент), 		"Контрагент=" + СокрЛП(СтрокаДанных.Контрагент) + ";", "");	
		ВидЗадолженности = ?(СтрокаДанных.ЗадолженностьПоСделкеРЕПО,		"ВидЗадолженности=РЕПО;", ?(СтрокаДанных.КлассАктива = 24, "ВидЗадолженности=Прочая;", ""));
		ТребуетсяКомментарий = Истина;
		
	ИначеЕсли СтрокаДанных.КлассАктива = 15 Тогда
		
		ИНН 			= ?(ЗначениеЗаполнено(СтрокаДанных.ИНН),			"ИНН=" + СокрЛП(СтрокаДанных.ИНН) + ";", "");
		КонтрагентБанк 	= ?(ЗначениеЗаполнено(СтрокаДанных.Контрагент), 	"Банк=" + СокрЛП(СтрокаДанных.Контрагент) + ";", "");
		Валюта 			= ?(ЗначениеЗаполнено(СтрокаДанных.Валюта), 		"Валюта=" + СокрЛП(СтрокаДанных.Валюта) + ";", "");	
		Начало 			= ?(ЗначениеЗаполнено(СтрокаДанных.Начало), 		"Начало=" + Формат(СтрокаДанных.Начало, "ДФ=dd.MM.yyyy") + ";", "");
		Окончание 		= ?(ЗначениеЗаполнено(СтрокаДанных.Окончание), 		"Окончание=" + Формат(СтрокаДанных.Окончание, "ДФ=dd.MM.yyyy") + ";", "");
		Ставка 			= ?(ЗначениеЗаполнено(СтрокаДанных.Ставка), 		"Ставка=" + Формат(СтрокаДанных.Ставка, "ЧРД=.; ЧГ=0") + ";", "");
		Сумма 			= ?(ЗначениеЗаполнено(СтрокаДанных.СуммаДепозита), 	"СуммаМНО=" + Формат(СтрокаДанных.СуммаДепозита, "ЧРД=.; ЧГ=0") + ";", "");
		
		ТребуетсяКомментарий = Истина;
		
	ИначеЕсли СтрокаДанных.КлассАктива = 18 Тогда
		
		ИНН				= ?(ЗначениеЗаполнено(СтрокаДанных.ИНН),			"ИНН=" + СокрЛП(СтрокаДанных.ИНН) + ";", "");
		КонтрагентБанк	= ?(ЗначениеЗаполнено(СтрокаДанных.Контрагент), 	"Банк=" + СокрЛП(СтрокаДанных.Контрагент) + ";", "");
		Валюта 			= ?(ЗначениеЗаполнено(СтрокаДанных.Валюта), 		"Валюта=" + СокрЛП(СтрокаДанных.Валюта) + ";", "");
		Начало 			= ?(ЗначениеЗаполнено(СтрокаДанных.Начало), 		"Начало=" + Формат(СтрокаДанных.Начало, "ДФ=dd.MM.yyyy") + ";", "");
		Окончание 		= ?(ЗначениеЗаполнено(СтрокаДанных.Окончание), 		"Окончание=" + Формат(СтрокаДанных.Окончание, "ДФ=dd.MM.yyyy") + ";", "");
		Ставка 			= ?(ЗначениеЗаполнено(СтрокаДанных.Ставка), 		"Ставка=" + Формат(СтрокаДанных.Ставка, "ЧРД=.; ЧГ=0") + ";", "");
		Сумма 			= ?(ЗначениеЗаполнено(СтрокаДанных.СуммаДепозита), 	"Сумма=" + Формат(СтрокаДанных.СуммаДепозита, "ЧРД=.; ЧГ=0") + ";", "");
		Договор 		= ?(ЗначениеЗаполнено(СтрокаДанных.Договор), 		"Договор=" + СокрЛП(СтрокаДанных.Договор) + ";", "");
		ТребуетсяКомментарий = Истина;
		
	КонецЕсли;

	Комментарий = СтрШаблон("%1%2%3%4%5%6%7%8%9", ИНН, КонтрагентБанк, ВидЗадолженности, Валюта, Начало, Окончание, Ставка, Сумма, Договор);
	
	ДлинаКомментарий = СтрДлина(Комментарий);
	
	//В конце строки лишняя ";", поэтому сравниваем с 256
	Если ДлинаКомментарий > 256 Тогда
			
		// Проверяем длину полей КонтрагентБанк и Договор
		ИсключитьДоговор = Ложь;
		ДлинаКонтрагентБанк	= СтрДлина(КонтрагентБанк);
		Если ДлинаКомментарий - ДлинаКонтрагентБанк > 256 Тогда
			ДлинаДоговор = СтрДлина(Договор);
			ИсключитьДоговор = Истина;
			Если ДлинаКомментарий - ДлинаКонтрагентБанк - ДлинаДоговор > 256 Тогда 
				Отказ = Истина;
			КонецЕсли;						
		КонецЕсли;
		
		Если ИсключитьДоговор Тогда
			// Исключаем "КонтрагентБанк" и "Договор"
			Комментарий = СтрШаблон("%1%2%3%4%5%6%7", ИНН, ВидЗадолженности, Валюта, Начало, Окончание, Ставка, Сумма);
		Иначе
			// Исключаем только "КонтрагентБанк"
			Комментарий = СтрШаблон("%1%2%3%4%5%6%7%8", ИНН, ВидЗадолженности, Валюта, Начало, Окончание, Ставка, Сумма, Договор);
		КонецЕсли;
		
		ДлинаКомментарий = СтрДлина(Комментарий);
		
	КонецЕсли;	
	
	Если ТребуетсяКомментарий И ПустаяСтрока(Комментарий) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле Comment по договору ДУ №" + НомерДоговора + ", класс актива " + СтрокаДанных.КлассАктива);	
	КонецЕсли;
	
	// Удаляем последний символ (это ";")
	Возврат Лев(Комментарий, ДлинаКомментарий - 1);
			
КонецФункции

Функция ПолучитьПараметрыЗаголовкаИПодвала(Параметры) Экспорт
	
	СтруктураДанных = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РеквизитыОрганизации.ИНН КАК ИНН,
	|	РеквизитыОрганизации.КПП КАК КПП,
	|	РеквизитыОрганизации.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
	|	РеквизитыОрганизации.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
	|	РеквизитыОрганизации.СокращенноеНаименование КАК СокращенноеНаименование,
	|	РеквизитыОрганизации.ОрганизационноПравоваяФорма КАК ОрганизационноПравоваяФорма
	|ИЗ
	|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
	|			&Дата,
	|			ЮрФизЛицо = &Организация
	|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
	|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыОрганизации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(РеквизитыКонтрагента.ИНН, """") КАК ИНН,
	|	ЕСТЬNULL(РеквизитыКонтрагента.КПП, """") КАК КПП,
	|	ЕСТЬNULL(РеквизитыКонтрагента.КраткоеНаименованиеПоУставу, """") КАК КраткоеНаименованиеПоУставу,
	|	ЕСТЬNULL(РеквизитыКонтрагента.ПолноеНаименованиеПоУставу, """") КАК ПолноеНаименованиеПоУставу,
	|	ЕСТЬNULL(РеквизитыКонтрагента.СокращенноеНаименование, """") КАК СокращенноеНаименование,
	|	ЕСТЬNULL(РеквизитыКонтрагента.ОрганизационноПравоваяФорма, """") КАК ОрганизационноПравоваяФорма,
	|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.НомерСчета КАК НомерСчета,
	|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговора,
	|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
	|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.Наименование КАК НаименованиеСчетаДУ,
	|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
	|ИЗ
	|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Дата, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(&Дата, ) КАК РеквизитыКонтрагента
	|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыКонтрагента.ЮрФизЛицо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РеквизитыСотрудниковОрганизации.Фамилия КАК Фамилия,
	|	РеквизитыСотрудниковОрганизации.Имя КАК Имя,
	|	РеквизитыСотрудниковОрганизации.Отчество КАК Отчество
	|ИЗ
	|	РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
	|			&Дата,
	|			Организация = &Организация
	|				И ЮрФизЛицо = &ФизЛицо
	|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыСотрудниковОрганизации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗначенияДополнительныхСведений.Объект КАК Объект,
	|	ЗначенияДополнительныхСведений.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
	|ГДЕ
	|	ЗначенияДополнительныхСведений.Свойство.Ключ = ""ВнешняяОбработка._ЭкспортДанныхВСЭДВТБ.ИнвестСчет""
	|	И (ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Объект КАК Справочник.СчетаДоверительногоУправления)) = &СчетДоверительногоУправления";

	Запрос.УстановитьПараметр("Дата",        Параметры.Период);
	Запрос.УстановитьПараметр("Вид",         Справочники.ВидыКонтактнойИнформации.ЮридическийАдрес);
	Запрос.УстановитьПараметр("Тип",         Перечисления.ТипыКонтактнойИнформации.Адрес);
	Запрос.УстановитьПараметр("ФизЛицо",  	 Параметры.Подписант);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Параметры.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);
	
	ГоловнаяОрганизация = РаботаСНормативноСправочнойИнформацией.ПолучитьГоловнуюОрганизацию(Параметры.Организация.ЮрФизЛицо, Параметры.Период);
	
	Запрос.УстановитьПараметр("Организация", ?(ЗначениеЗаполнено(ГоловнаяОрганизация), ГоловнаяОрганизация, Параметры.Организация.ЮрФизЛицо));
	
	Результат = Запрос.ВыполнитьПакет();
	
	СтруктураДанных.Вставить("ДанныеОрганизации", Результат[0].Выгрузить());
	СтруктураДанных.Вставить("ДанныеКлиента", 	  Результат[1].Выгрузить()); 
	СтруктураДанных.Вставить("ФИОПодписанта", 	  Результат[2].Выгрузить());
	СтруктураДанных.Вставить("КодПортфеля", 	  Результат[3].Выгрузить());
	
	Возврат СтруктураДанных;

КонецФункции // ПолучитьПараметрыЗаголовкаИПодвала()	

Функция ПолучитьТаблицуРазделаЦБ(ТаблицаЦБ, НоваяТаблица = Неопределено, ИмяКолонки, Значение) Экспорт
	Если НоваяТаблица = Неопределено Тогда
		Возврат ТаблицаЦБ.Скопировать(Новый Структура(ИмяКолонки, Значение));
	КонецЕсли;
	
	НоваяТаблица.Очистить();
	НайдСтроки = ТаблицаЦБ.НайтиСтроки(Новый Структура(ИмяКолонки, Значение));
	Для Каждого НайдСтрока Из НайдСтроки Цикл
		НоваяСтрока = НоваяТаблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, НайдСтрока);
	КонецЦикла;

	Возврат НоваяТаблица;
	
КонецФункции // ПолучитьТаблицуРазделаЦБ

Функция ОпределитьТипРасчета(СтрРаздел, ОПФ = Неопределено)
	
	Если Не Лев(СтрРаздел, 13) = "МассивРаздела" Тогда
		Возврат "";	
	КонецЕсли;	
	
	ТекРаздел = СтрЗаменить(СтрРаздел, "МассивРаздела", "");
	
	ТипРасчета = 0;
	Если ТекРаздел = "8_1" Тогда
		Если ОПФ = ПредопределенноеЗначение("Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация") Тогда
			ТипРасчета = 16;
		Иначе	
			ТипРасчета = 12;
		КонецЕсли;	
	ИначеЕсли ТекРаздел = "13_1" Тогда
		ТипРасчета = 13;
	ИначеЕсли ТекРаздел = "13_2" Тогда
		ТипРасчета = 14;
	ИначеЕсли ТекРаздел = "13_3" Тогда
		ТипРасчета = 15;	
	Иначе
		ТипРасчета = Число(ТекРаздел) - 1;
	КонецЕсли;
	
	Возврат ТипРасчета;
	
КонецФункции // ОпределитьТипРасчета()

Функция СформироватьТекстПоказателей(Показатели, Коэффициент = 1000, Разрядность = 5)
	
	ТекстПоказателей = "";
	ЭтоПерваяСтрока = Истина;
	Для Каждого СтрокаПоказателей Из Показатели Цикл		
		
		Если (СтрокаПоказателей.Ключ = "РынЦена") И СтрокаПоказателей.Значение <> 0 Тогда
			ЗначениеПоказателя = Формат(Окр(СтрокаПоказателей.Значение, 5), "ЧГ=;");
		ИначеЕсли (СтрокаПоказателей.Ключ = "Стоимость" ИЛИ СтрокаПоказателей.Ключ = "Стоимость2" ИЛИ СтрокаПоказателей.Ключ = "Проценты") И СтрокаПоказателей.Значение <> 0 Тогда
			ЗначениеПоказателя = Формат(СтрокаПоказателей.Значение / Коэффициент, "ЧГ=; ЧДЦ=" + Строка(Разрядность));
		ИначеЕсли СтрокаПоказателей.Ключ = "Колво" Тогда
			ЗначениеПоказателя = Формат(СтрокаПоказателей.Значение, "ЧГ=");	
		Иначе
			ЗначениеПоказателя = СтрокаПоказателей.Значение;
		КонецЕсли;
		
		ТекстПоказателей = ТекстПоказателей + ?(ЭтоПерваяСтрока, "", ";") + ЗначениеПоказателя;
		ЭтоПерваяСтрока = Ложь;
	КонецЦикла;
	
	Возврат ТекстПоказателей;
	
КонецФункции // СформироватьТекстПоказателей

Процедура ЗаполнитьПоказатели(НаименованиеРаздела, СтрокаРаздела, Показатели)
	
	// Субъект,Эмитент,ВидЦБ,РегНомер,РынЦена,Колво,Стоимость,Источник,ISIN,CFI,НаименованиеКО,ДатаДоговораБС,НомерДоговораБС,РеквизитыБС,Стоимость2,Проценты
	Если НаименованиеРаздела = "МассивРаздела1" Тогда // Денежные средства 
		Показатели.НаименованиеКО  = СтрокаРаздела.НаименованиеБанка;
		Показатели.ДатаДоговораБС  = СтрокаРаздела.ДатаЗаключения;
		Показатели.НомерДоговораБС = СтрокаРаздела.НомерДоговора;
		Показатели.РеквизитыБС 	   = СтрокаРаздела.БанковскийСчет;
		Показатели.Стоимость2 	   = СтрокаРаздела.Сумма;		
	ИначеЕсли НаименованиеРаздела = "МассивРаздела2" Тогда // Депозиты
		Показатели.НаименованиеКО  = СтрокаРаздела.НаименованиеБанка;
		Показатели.ДатаДоговораБС  = СтрокаРаздела.ДатаЗаключения;
		Показатели.НомерДоговораБС = СтрокаРаздела.НомерДоговора;
		Показатели.РеквизитыБС     = СтрокаРаздела.БанковскийСчет;
		Показатели.Стоимость2      = СтрокаРаздела.Сумма + СтрокаРаздела.СуммаПроцентов;			
		Показатели.Проценты        = 0;			
	ИначеЕсли НаименованиеРаздела = "МассивРаздела13_1" Тогда // ДЗ - средства у брокера
		Показатели.Субъект         = СтрокаРаздела.НаименованиеБрокера;
		Показатели.Стоимость       = СтрокаРаздела.Сумма;			
	ИначеЕсли НаименованиеРаздела = "МассивРаздела13_2" Тогда // ДЗ - купон по облигациям	
		Показатели.Эмитент  	   = СтрокаРаздела.НаименованиеЭмитента;
		Показатели.РегНомер		   = СтрокаРаздела.ГосударственныйРегистрационныйНомер;
		Показатели.Стоимость       = СтрокаРаздела.Сумма;							
		Показатели.ISIN      	   = СтрокаРаздела.ISIN;				
		Показатели.CFI             = СтрокаРаздела.CFI;	
	ИначеЕсли НаименованиеРаздела = "МассивРаздела13_3" Тогда // ДЗ - прочая
		Показатели.Субъект         = СтрокаРаздела.Субъект;
		Показатели.ВидЦБ           = СтрокаРаздела.ВидЦБ;
		Показатели.Стоимость       = СтрокаРаздела.Сумма;					
	Иначе // Ценные бумаги - все остальные разделы		
		Показатели.Эмитент  	   = СтрокаРаздела.НаименованиеЭмитента;
		//Если НаименованиеРаздела = "МассивРаздела3" Тогда // возможно, в этом случае не нужно заполнять
		//	Показатели.Эмитент = "";
		//КонецЕсли;
		Показатели.ВидЦБ  		   = СтрокаРаздела.ВидЦБ;
		Показатели.РегНомер		   = СтрокаРаздела.ГосударственныйРегистрационныйНомер;
		Показатели.РынЦена         = СтрокаРаздела.Цена;
		Показатели.Колво    	   = СтрокаРаздела.Количество;
		Показатели.Стоимость       = СтрокаРаздела.Сумма;			
		Показатели.Источник        = СтрокаРаздела.ИсточникЦены;				
		Показатели.ISIN      	   = СтрокаРаздела.ISIN;				
		Показатели.CFI             = СтрокаРаздела.CFI;				
	КонецЕсли;     	
	
	Если Показатели.ТипРасчета = 12 Тогда
		Показатели.Эмитент	= Неопределено;
		Показатели.ВидЦБ	= СтрокаРаздела.НаименованиеЭмитента;
		Показатели.ISIN		= СтрокаРаздела.ГосударственныйРегистрационныйНомер;
		Показатели.РегНомер	= Неопределено;
	ИначеЕсли Показатели.ТипРасчета = 15 И СтрокаРаздела.Свойство("ВыводитьИнформациюОЦеннойБумаге") И СтрокаРаздела.ВыводитьИнформациюОЦеннойБумаге Тогда
		Показатели.Субъект = СтрокаРаздела.НаименованиеЭмитента + " " + СтрокаРаздела.ГосударственныйРегистрационныйНомер;
	КонецЕсли;
			
КонецПроцедуры // ЗаполнитьПоказатели()

Функция ОпределитьМакет(Префикс, ДатаОтчета = '00010101', ОднаФормаПНиПР = Истина, ВидДоговора = Неопределено, Документ = Неопределено) Экспорт
	
	Если Префикс = "СЧАНСД_ПН2023" Тогда
		Возврат ПолучитьМакет(Префикс);	
	КонецЕсли;
	
	Если ВидДоговора = Неопределено Тогда
		СчетДУ 		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "СчетДоверительногоУправления");
		ВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДУ, "ВидДоговораДоверительногоУправления");
	КонецЕсли;	
		
	ИмяМакета = "";
	ЭтоМакет2018 = ДатаОтчета >= '20180101';
	Если ОднаФормаПНиПР И (ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями
		 ИЛИ ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами 
		 ИЛИ ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР) Тогда
		ИмяМакета = Префикс + ?(ЭтоМакет2018, "2018", "") + "_ПН_ПР";
	ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
		ИмяМакета = Префикс + ?(ЭтоМакет2018, "2018", "") + "_ПР";
	ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
		ИмяМакета = Префикс + ?(ЭтоМакет2018, "2018", "") + "_ПН";	
	КонецЕсли;
	
	Если ИмяМакета = "" Тогда		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить форму выгрузки для вида договора " + СокрЛП(ВидДоговора));		
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолучитьМакет(ИмяМакета);	
	
КонецФункции

Функция ОпределитьМакет2020(Префикс, ДатаОтчета = '00010101', ОднаФормаПНиПР = Истина, ВидДоговора = Неопределено, Документ = Неопределено) Экспорт
	
	Если ВидДоговора = Неопределено Тогда
		СчетДУ 		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "СчетДоверительногоУправления");
		ВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДУ, "ВидДоговораДоверительногоУправления");
	КонецЕсли;	
		
	ИмяМакета = "";
	Если ОднаФормаПНиПР И (ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями
		 ИЛИ ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами 
		 ИЛИ ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР 
		 ИЛИ ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов)Тогда
		ИмяМакета = Префикс + "2020_ПН_ПР";
	ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
		ИмяМакета = Префикс + "2020_ПР";
	ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
		ИмяМакета = Префикс + "2020_ПН";	
	КонецЕсли;
	
	Если ИмяМакета = "" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить форму выгрузки" + СокрЛП(ВидДоговора));
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолучитьМакет(ИмяМакета);	
	
КонецФункции

Процедура ВывестиБлокВТабличныйДокумент(ТабличныйДокумент, ОбластиМакета, ПостфиксБлока, ДанныеДляЗаполнения, ПромежуточныйИтог = Неопределено, ИмяДополнительногоРесурса = Неопределено, ИтогДополнительногоРесурса = Неопределено, ИтогВсего = Неопределено) Экспорт
	
	ТабличныйДокумент.Вывести(ОбластиМакета["Шапка" + ПостфиксБлока]);
	
	Итог = 0;
	
	Для Каждого ТекСтрока Из ДанныеДляЗаполнения Цикл
		
		Область = ОбластиМакета["Строка" + ПостфиксБлока];
		Область.Параметры.Заполнить(ТекСтрока);
		ТабличныйДокумент.Вывести(Область);
		
		Итог = Итог + ТекСтрока.Сумма;
		
		Если ИмяДополнительногоРесурса <> Неопределено Тогда
			Итог = Итог + ТекСтрока[ИмяДополнительногоРесурса];
		КонецЕсли;
		
		Если ИтогДополнительногоРесурса <> Неопределено Тогда
			ИтогДополнительногоРесурса = ИтогДополнительногоРесурса + ТекСтрока["Купон"];	
		КонецЕсли;
		
		Если ИтогВсего <> Неопределено Тогда
			ИтогВсего = ИтогВсего + ТекСтрока["СуммаСНКД"];	
		КонецЕсли;
		
	КонецЦикла;
	
	Область = ОбластиМакета["Подвал" + ПостфиксБлока];
	Область.Параметры.Сумма = Итог;
	Если ИтогДополнительногоРесурса <> Неопределено Тогда
		Область.Параметры.Купон = ИтогДополнительногоРесурса;	
	КонецЕсли;
	
	Если ИтогВсего <> Неопределено Тогда
		Область.Параметры.СуммаСНКД = ИтогВсего;	
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(Область);
	
	Если ПромежуточныйИтог <> Неопределено Тогда
		ПромежуточныйИтог = ПромежуточныйИтог + Итог;
	КонецЕсли;
	
	Если ИтогДополнительногоРесурса <> Неопределено Тогда
		ПромежуточныйИтог = ПромежуточныйИтог + ИтогДополнительногоРесурса;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЦеныЦБ(ТаблицаЦБ)
	
	// Изменяем цены, сильно отклоняющиеся от расчетных
	Для Каждого СтрокаТаблицыЦБ Из ТаблицаЦБ Цикл
		РасчетнаяСумма = СтрокаТаблицыЦБ.Цена * СтрокаТаблицыЦБ.Количество;
		Если РасчетнаяСумма = СтрокаТаблицыЦБ.Сумма Тогда 
			Продолжить;
		КонецЕсли;
				
		Если (СтрокаТаблицыЦБ.Сумма <> 0) И РасчетнаяСумма < СтрокаТаблицыЦБ.Сумма Тогда
			Коэффициент = РасчетнаяСумма / СтрокаТаблицыЦБ.Сумма * 100;
		ИначеЕсли (РасчетнаяСумма <> 0) И РасчетнаяСумма > СтрокаТаблицыЦБ.Сумма Тогда	
			Коэффициент = СтрокаТаблицыЦБ.Сумма / РасчетнаяСумма * 100;
		Иначе 
			СтрокаТаблицыЦБ.Цена = 0;
			Продолжить;
		КонецЕсли;
		
		Если Коэффициент < 99 Тогда
			СтрокаТаблицыЦБ.Цена = Окр(СтрокаТаблицыЦБ.Сумма / СтрокаТаблицыЦБ.Количество, 5, 1);	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция СформироватьМассивСтрок(Данные, ПрефиксКолонки = "", ИмяТаблицы = "") Экспорт
		
	МассивСтрок		= Новый Массив;
	МассивКолонок	= Новый Массив;
		
	Для Каждого Колонка Из Данные.Колонки Цикл
		Если Лев(Колонка.Имя, СтрДлина(ПрефиксКолонки)) = ПрефиксКолонки ИЛИ НЕ ЗначениеЗаполнено(ПрефиксКолонки) Тогда
			МассивКолонок.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		ДанныеСтроки = Новый Структура;
		
		Для Каждого Колонка Из МассивКолонок Цикл
			
			ТекЗначение = СтрокаДанных[Колонка];
			Если ТипЗнч(ТекЗначение) = Тип("Число") И Найти(Колонка, "НомерДоговора") > 0 Тогда
				ТекЗначение = Формат(ТекЗначение, "ЧГ=0");
			КонецЕсли;	
			
			ДанныеСтроки.Вставить(Колонка, ТекЗначение);

			Если Найти(Колонка, "НомерСтроки") > 0 Тогда
				ДанныеСтроки.Вставить(Колонка, МассивСтрок.Количество() + 1);
			КонецЕсли;	
		КонецЦикла;
		
		МассивСтрок.Добавить(ДанныеСтроки);
		
	КонецЦикла;
	
	Возврат МассивСтрок;
	
КонецФункции

Функция ПолучитьЗапись(Результат, КодСтроки, Разрядность, Коэффициент = 1)
	
	Если Результат.Свойство(КодСтроки) Тогда
		Возврат Формат(Результат[КодСтроки] / Коэффициент, "ЧДЦ=" + Строка(Разрядность) + "; ЧРД=.; ЧГ=");
	Иначе
		Возврат "0.00";
	КонецЕсли;
	
КонецФункции // ПолучитьЗапись

Процедура ДобавитьНомерСтроки(ТабЗнач)
	
	// Колонка с номером строки таблицы
	ТабЗнач.Колонки.Добавить("Num_Row");
	
	Сч = 1;
	Для Каждого ТекСтрокаТабЗнач Из ТабЗнач Цикл
		
		ТекСтрокаТабЗнач.Num_Row = Сч;
		Сч = Сч + 1;
		
	КонецЦикла;

КонецПроцедуры

Функция ВывестиБлокСИтогамиВТабличныйДокумент(ТабличныйДокумент, ОбластиМакета, НомерБлока, Знач ДанныеДляЗаполнения, КолонкиСуммирования = Неопределено, НаименованиеБлока = Неопределено)
	
	Итоги = Неопределено;
	
	// Шапка
	Область = ОбластиМакета["Шапка" + НомерБлока];
	Если НаименованиеБлока <> Неопределено Тогда
		Область.Параметры.НаименованиеБлока = НаименованиеБлока;			
	КонецЕсли;
	ТабличныйДокумент.Вывести(Область);
	
	// Строки
	Если ДанныеДляЗаполнения <> Неопределено Тогда
		Для Каждого ТекСтрока Из ДанныеДляЗаполнения Цикл
			Область = ОбластиМакета["Строка" + НомерБлока];
			Область.Параметры.Заполнить(ТекСтрока);
			
			ТабличныйДокумент.Вывести(Область);		
		КонецЦикла;
	КонецЕсли;
	
	// Подвал
	Область = ОбластиМакета["Подвал" + НомерБлока];
	Если ДанныеДляЗаполнения <> Неопределено И ЗначениеЗаполнено(КолонкиСуммирования) Тогда
		ДанныеДляЗаполнения.Свернуть(, КолонкиСуммирования);
		Если ДанныеДляЗаполнения.Количество() = 0 Тогда  
			ДанныеДляЗаполнения.Добавить(); // Заполняем пустыми значениями		
		Иначе			
			Итоги = ДанныеДляЗаполнения[0];
		КонецЕсли;
		
		Область.Параметры.Заполнить(ДанныеДляЗаполнения[0]);
	КонецЕсли;
	ТабличныйДокумент.Вывести(Область);
	
	Возврат Итоги;
	
КонецФункции

Функция ПолучитьИмяПИФ(СтрокаНаименования)
	
	СтрокаНаименования = СтрЗаменить(СтрокаНаименования, " рыночных финансовых инструментов ", "");
	СтрокаНаименования = СтрЗаменить(СтрокаНаименования, " комбинированный ",  "");
	СтрокаНаименования = СтрЗаменить(СтрокаНаименования, " долгосрочных прямых инвестиций ", "");
	СтрокаНаименования = СтрЗаменить(СтрокаНаименования, " смешанных инвестиций ", "");
	СтрокаНаименования = СтрЗаменить(СтрокаНаименования, "\", "_");
	СтрокаНаименования = СтрЗаменить(СтрокаНаименования, "/", "_");
	СтрокаНаименования = СтрЗаменить(СтрокаНаименования, "*", "_");
	СтрокаНаименования = СтрЗаменить(СтрокаНаименования, "?", "_");
	СтрокаНаименования = СтрЗаменить(СтрокаНаименования, """", "_");
	СтрокаНаименования = СтрЗаменить(СтрокаНаименования, "<", "_");
	СтрокаНаименования = СтрЗаменить(СтрокаНаименования, ">", "_");
	СтрокаНаименования = СтрЗаменить(СтрокаНаименования, ":", "_");
	СтрокаНаименования = СтрЗаменить(СтрокаНаименования, "|", "_");

	Возврат СтрокаНаименования;	
	
КонецФункции

