	|			И КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СтоимостьПая.СубъектАналитики
	|			И (СтоимостьПая.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьПая))
	|			И (СтоимостьПая.Период = &Период)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК КодИнвестиционногоСчета
	|		ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = КодИнвестиционногоСчета.Объект
	|			И (КодИнвестиционногоСчета.Свойство.Ключ = ""ВнешняяОбработка._ЭкспортДанныхВСЭДВТБ.ИнвестСчет"")";
	
	#КонецОбласти
			
	Запрос.УстановитьПараметр("Организация",					ПараметрыЗапроса.Организация);
	Запрос.УстановитьПараметр("Период",							НачалоДня(ПараметрыЗапроса.Период));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ПараметрыЗапроса.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦельРасчета",					ПараметрыЗапроса.ЦельРасчетаСтоимостиОценки);
	Запрос.УстановитьПараметр("Ссылка",							ПараметрыЗапроса.Ссылка);
		
	Запрос.Выполнить();
	
	Результат = Новый Структура();
	Результат.Вставить("ОсновныеДанные", 			Запрос.МенеджерВременныхТаблиц.Таблицы["_Результат_ОсновныеДанные"].ПолучитьДанные().Выгрузить());
