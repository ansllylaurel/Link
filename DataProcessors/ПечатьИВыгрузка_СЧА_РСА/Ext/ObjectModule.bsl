	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "8", ДанныеДляЗаполнения.МассивРаздела8, ПромежуточныйИтог);
	
	// 9. Облигации российских хозяйственных обществ
	// (за исключением облигаций с ипотечным покрытием)
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "9", ДанныеДляЗаполнения.МассивРаздела9, ПромежуточныйИтог);
	
	// 10. Акции российских акционерных обществ
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "10", ДанныеДляЗаполнения.МассивРаздела10, ПромежуточныйИтог);
	
	// 11. Облигации с ипотечным покрытием, выпущенные в соответствии
	// с законодательством Российской Федерации об ипотечных ценных бумагах
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "11", ДанныеДляЗаполнения.МассивРаздела11, ПромежуточныйИтог);
	
	// 12. Ипотечные сертификаты участия, выданные в соответствии
	// с законодательством Российской Федерации об ипотечных ценных бумагах
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "12", ДанныеДляЗаполнения.МассивРаздела12, ПромежуточныйИтог);
	
	// 13. Инвестиционные паи паевых инвестиционных фондов, выданные
	// в соответствии с законодательством Российской Федерации
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "13", ДанныеДляЗаполнения.МассивРаздела13, ПромежуточныйИтог);
	
	// 14. Ценные бумаги правительств иностранных государств
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "14", ДанныеДляЗаполнения.МассивРаздела14, ПромежуточныйИтог);
	
	// 15. Ценные бумаги международных финансовых организаций
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "15", ДанныеДляЗаполнения.МассивРаздела15, ПромежуточныйИтог);
	
	// 16. Акции иностранных акционерных обществ
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "16", ДанныеДляЗаполнения.МассивРаздела16, ПромежуточныйИтог);
	
	// 17. Облигации иностранных коммерческих организаций
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "17", ДанныеДляЗаполнения.МассивРаздела17, ПромежуточныйИтог);
	
	// 18. Акции (паи, доли) иностранных инвестиционных фондов
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "18", ДанныеДляЗаполнения.МассивРаздела18, ПромежуточныйИтог);
	
	// 19. Объекты недвижимого имущества
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "19", ДанныеДляЗаполнения.МассивРаздела19, ПромежуточныйИтог);
	
	// 20. Иное имущество
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "20", ДанныеДляЗаполнения.МассивРаздела20, ПромежуточныйИтог);
	
	// Итого оценочная стоимость активов
	Область = ОбластиМакета["ОценочнаяСтоимостьАктивов"];
	Область.Параметры.Сумма = ПромежуточныйИтог;
	ТД.Вывести(Область);
	
	ИтоговаяСЧА = ИтоговаяСЧА + ПромежуточныйИтог;
	ПромежуточныйИтог = 0;
	
	// 21. Дебиторская задолженность (Шапка)
	ТД.Вывести(ОбластиМакета["Шапка21"]);
	
	// Средства пенсионных резервов на специальных брокерских счетах
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "21_1", ДанныеДляЗаполнения.МассивРаздела21_1, ПромежуточныйИтог);
	
	// Сумма средств на счетах клиринговых центров
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "21_2", ДанныеДляЗаполнения.МассивРаздела21_2, ПромежуточныйИтог);
	
	// Сумма средств на счетах клиринговых центров
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "21_3", ДанныеДляЗаполнения.МассивРаздела21_3);
	
	// Корректирующая величина, определенная по опционным контрактам, по которым лицо, действующее за
	// счет активов, составляющих инвестиционный портфель, является управомоченным лицом
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "21_4", ДанныеДляЗаполнения.МассивРаздела21_4);
	
	// Дебиторская задолженность по процентному (купонному) доходу по облигациям
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "21_5", ДанныеДляЗаполнения.МассивРаздела21_5, ПромежуточныйИтог);
	
	// Прочая дебиторская задолженность
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "21_6", ДанныеДляЗаполнения.МассивРаздела21_6, ПромежуточныйИтог);
	
	// 21. Дебиторская задолженность (Подвал)
	Область = ОбластиМакета["Подвал21"];
	Область.Параметры.Сумма = ПромежуточныйИтог;
	ТД.Вывести(Область);
	
	ИтоговаяСЧА = ИтоговаяСЧА + ПромежуточныйИтог;
	ПромежуточныйИтог = 0;
	
	// 22. Обязательства
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "22", ДанныеДляЗаполнения.МассивРаздела22, ПромежуточныйИтог);
	
	ИтоговаяСЧА = ИтоговаяСЧА - ПромежуточныйИтог;
	
	// Итого стоимость чистых активов
	Область = ОбластиМакета["Подвал"];
	Область.Параметры.Сумма			= ИтоговаяСЧА;
	Область.Параметры.ФИОПодписанта = ДанныеДляЗаполнения.ФИОПодписанта;
		
	ТД.Вывести(Область);
	
	ТД.АвтоМасштаб = Истина;
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяФайла",			ДанныеДляЗаполнения.СДУ + " " + ДанныеДляЗаполнения.ДатаОтчета + ".xls");
	Результат.Вставить("ТабличныйДокумент",	ТД);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТаблицуФормы029(ПараметрыЗапроса, Коэффициент = 1, Разрядность = 5) Экспорт
			
	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц; 
		
	#Область Текст_запроса
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиЦелейРасчетаСрезПоследних.Период КАК Период,
	|	НастройкиЦелейРасчетаСрезПоследних.Организация КАК Организация,
	|	НастройкиЦелейРасчетаСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	НастройкиЦелейРасчетаСрезПоследних.ЦельРасчета КАК ЦельРасчета,
	|	НастройкиЦелейРасчетаСрезПоследних.ВариантРасчетаОценочнойСтоимости КАК ВариантРасчетаОценочнойСтоимости,
	|	НастройкиЦелейРасчетаСрезПоследних.ВестиРасчетПоПартиям КАК ВестиРасчетПоПартиям,
	|	НастройкиЦелейРасчетаСрезПоследних.ВидУчетаДляОстатковПартий КАК ВидУчетаДляОстатковПартий,
	|	НастройкиЦелейРасчетаСрезПоследних.ТочностьЦеныКупона КАК ТочностьЦеныКупона,
	|	НастройкиЦелейРасчетаСрезПоследних.ТочностьЦеныОценки КАК ТочностьЦеныОценки
	|ПОМЕСТИТЬ _НастройкаЦели_ОценкаОбъектовВУправлении
	|ИЗ
	|	РегистрСведений.НастройкиЦелейРасчета.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления В (&СчетДоверительногоУправления)
	|				И ЦельРасчета = &ЦельРасчета) КАК НастройкиЦелейРасчетаСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
	|	СтоимостьПереоценки.Рынок КАК Рынок,
	|	ВЫБОР
	|		КОГДА СтоимостьПереоценки.ВидЦены = ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.АмортизированнаяСтоимость)
	|			ТОГДА (ВЫРАЗИТЬ(СУММА(СтоимостьПереоценки.СуммаВВалютеУчета) КАК ЧИСЛО(25, 10))) / (ВЫРАЗИТЬ(СУММА(СтоимостьПереоценки.Количество) КАК ЧИСЛО(25, 10)))
	|		ИНАЧЕ ВЫРАЗИТЬ(СРЕДНЕЕ(СтоимостьПереоценки.Цена) КАК ЧИСЛО(25, 10))
	|	КОНЕЦ КАК Стоимость,
	|	СтоимостьПереоценки.ВидЦены КАК ВидЦены,
	|	ВЫБОР
	|		КОГДА СтоимостьПереоценки.ВидЦены = ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.АмортизированнаяСтоимость)
	|			ТОГДА NULL
	|		ИНАЧЕ СтоимостьПереоценки.УровеньОценки
	|	КОНЕЦ КАК УровеньОценки,
	|	СтоимостьПереоценки.ДатаЦены КАК ДатаЦены,
	|	СтоимостьПереоценки.Источник КАК Источник,
	|	СУММА(СтоимостьПереоценки.СуммаВВалютеУчета) КАК Сумма,
	|	СУММА(СтоимостьПереоценки.СуммаКупонаВВалютеУчета) КАК Купон,
	|	СУММА(СтоимостьПереоценки.Количество) КАК Количество,
	|	СУММА(СтоимостьПереоценки.СуммаКупонаВВалютеУчета + СтоимостьПереоценки.СуммаВВалютеУчета) КАК ИтогоРынок,
	|	СУММА(ЕСТЬNULL(БухПартииЦенныхБумагОстатки.СуммаРезервовПодОбесценениеОстаток, 0) + ЕСТЬNULL(БухПартииЦенныхБумагОстатки.СуммаРезервовПодОбесценениеКупонаОстаток, 0)) КАК СуммаРезерва,
	|	ВЫБОР
	|		КОГДА СтоимостьПереоценки.ВалютаКотировкиКупона = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА СтоимостьПереоценки.ЦенаКупона
	|		КОГДА СтоимостьПереоценки.ВалютаКотировкиКупона = &ВалютаУчета
	|			ТОГДА СтоимостьПереоценки.ЦенаКотировкиКупона
	|		ИНАЧЕ СУММА(СтоимостьПереоценки.СуммаКупонаВВалютеУчета) / СУММА(СтоимостьПереоценки.Количество)
	|	КОНЕЦ КАК ЦенаКупона,
	|	СтоимостьПереоценки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС.СчетУчета КАК СчетУчета
	|ПОМЕСТИТЬ _ТаблицаСтоимости_Рынок
	|ИЗ
	|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
	|				&ПериодГраница,
	|				Организация = &Организация
	|					И СчетДоверительногоУправления В (&СчетДоверительногоУправления)
	|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)) КАК БухПартииЦенныхБумагОстатки
	|		ПО СтоимостьПереоценки.Организация = БухПартииЦенныхБумагОстатки.Организация
	|			И СтоимостьПереоценки.СчетДоверительногоУправления = БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления
	|			И СтоимостьПереоценки.ВидУчета = БухПартииЦенныхБумагОстатки.ВидУчета
	|			И СтоимостьПереоценки.Рынок = БухПартииЦенныхБумагОстатки.Рынок
	|			И СтоимостьПереоценки.ЦеннаяБумага = БухПартииЦенныхБумагОстатки.ЦеннаяБумага
	|			И СтоимостьПереоценки.Партия = БухПартииЦенныхБумагОстатки.Партия
	|			И СтоимостьПереоценки.СтрокаПартии = БухПартииЦенныхБумагОстатки.СтрокаПартии
	|ГДЕ
	|	СтоимостьПереоценки.Период = &Период
	|	И СтоимостьПереоценки.Организация = &Организация
	|	И СтоимостьПереоценки.СчетДоверительногоУправления В(&СчетДоверительногоУправления)
	|	И СтоимостьПереоценки.ВидУчета В
	|			(ВЫБРАТЬ
	|				_НастройкаЦели_ОценкаОбъектовВУправлении.ВидУчетаДляОстатковПартий
	|			ИЗ
	|				_НастройкаЦели_ОценкаОбъектовВУправлении КАК _НастройкаЦели_ОценкаОбъектовВУправлении)
	|	И СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета
	|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
	|
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьПереоценки.ЦеннаяБумага,
	|	СтоимостьПереоценки.Рынок,
	|	СтоимостьПереоценки.ВидЦены,
	|	СтоимостьПереоценки.ВалютаКотировкиКупона,
	|	СтоимостьПереоценки.ДатаЦены,
	|	СтоимостьПереоценки.Источник,
	|	СтоимостьПереоценки.ЦенаКотировкиКупона,
	|	СтоимостьПереоценки.ЦенаКупона,
	|	СтоимостьПереоценки.СчетДоверительногоУправления,
	|	ВЫБОР
	|		КОГДА СтоимостьПереоценки.ВидЦены = ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.АмортизированнаяСтоимость)
	|			ТОГДА NULL
	|		ИНАЧЕ СтоимостьПереоценки.УровеньОценки
	|	КОНЕЦ,
	|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС.СчетУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК СубъектАналитики,
	|	РезервыПредстоящихРасходовОстатки.Валюта КАК Валюта,
	|	СУММА(РезервыПредстоящихРасходовОстатки.СуммаОстаток) КАК СуммаРезерва
	|ПОМЕСТИТЬ _РезервыПодОбесценение
	|ИЗ
	|	РегистрНакопления.РезервыПредстоящихРасходов.Остатки(
	|			&ПериодГраница,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК РезервыПредстоящихРасходовОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	РезервыПредстоящихРасходовОстатки.СубъектАналитики,
	|	РезервыПредстоящихРасходовОстатки.Валюта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ТаблицаСтоимости_Рынок.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	_ТаблицаСтоимости_Рынок.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_ТаблицаСтоимости_Рынок.Рынок КАК Рынок,
	|	ВЫРАЗИТЬ(_ТаблицаСтоимости_Рынок.Стоимость КАК ЧИСЛО(19, 10)) КАК Стоимость,
	|	_ТаблицаСтоимости_Рынок.ВидЦены КАК ВидЦены,
	|	_ТаблицаСтоимости_Рынок.УровеньОценки КАК УровеньОценки,
	|	_ТаблицаСтоимости_Рынок.ДатаЦены КАК ДатаЦены,
	|	_ТаблицаСтоимости_Рынок.Источник КАК Источник,
	|	_ТаблицаСтоимости_Рынок.ЦенаКупона КАК ЦенаКупона,
	|	_ТаблицаСтоимости_Рынок.СчетУчета КАК СчетУчета,
	|	СУММА(ВЫРАЗИТЬ(_ТаблицаСтоимости_Рынок.Сумма КАК ЧИСЛО(19, 2))) КАК Сумма,
	|	СУММА(ВЫРАЗИТЬ(_ТаблицаСтоимости_Рынок.Купон КАК ЧИСЛО(19, 2))) КАК Купон,
	|	СУММА(_ТаблицаСтоимости_Рынок.Количество) КАК Количество,
	|	СУММА(ВЫРАЗИТЬ(_ТаблицаСтоимости_Рынок.ИтогоРынок КАК ЧИСЛО(19, 2))) КАК ИтогоРынок,
	|	СУММА(ВЫРАЗИТЬ(_ТаблицаСтоимости_Рынок.СуммаРезерва КАК ЧИСЛО(19, 2))) КАК СуммаРезерва
	|ПОМЕСТИТЬ _ТаблицаЦБ
	|ИЗ
	|	_ТаблицаСтоимости_Рынок КАК _ТаблицаСтоимости_Рынок
	|ГДЕ
	|	НЕ _ТаблицаСтоимости_Рынок.ЦеннаяБумага В (&ЦенныеБумагиСРасчетомПоЦБ5419)
	|
	|СГРУППИРОВАТЬ ПО
	|	_ТаблицаСтоимости_Рынок.ЦеннаяБумага,
