	МассивРаздела2 = СформироватьМассивСтрок(Запрос.МенеджерВременныхТаблиц.Таблицы["_МассивРаздела2"].ПолучитьДанные().Выгрузить());
	Результат.Вставить("МассивРаздела2", МассивРаздела2);
	
	Для Сч = 4 По 19 Цикл
		
		Если Сч = 5 Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаРазделаЦБ = ПолучитьТаблицуРазделаЦБ(ТаблицаЦБ, ПустаяТаблица, "Раздел", "Раздел" + СокрЛП(Сч));
