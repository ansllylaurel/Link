Функция СформироватьТабличныйДокументСЧАРСАНСД(ТекДокумент, ТекстЗапроса, ОбластиМакета, Подписант, ЭтоСЧА = Ложь)
	
	ДанныеДляЗаполнения = ПодготовитьРезультатДляВыводаСЧАРСАНСД(ТекДокумент, ТекстЗапроса, Подписант, ЭтоСЧА);
	
	Если ДанныеДляЗаполнения = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТД = Новый ТабличныйДокумент;
	
	// Шапка отчета.
	Область = ОбластиМакета["Шапка"];
	Область.Параметры.ДатаОтчета	   = Формат(ДанныеДляЗаполнения.ДатаОтчета, "ДФ='дд.ММ.гггг ''г.'''");
	Область.Параметры.Клиент		   = ДанныеДляЗаполнения.ДанныеКлиента;
	Область.Параметры.Организация	   = ДанныеДляЗаполнения.НаименованиеОрганизации + ", ИНН " + ДанныеДляЗаполнения.ИННОрганизации + "/КПП " + ДанныеДляЗаполнения.КППОрганизации;
	Область.Параметры.Договор		   = ДанныеДляЗаполнения.НомерИДатаДоговора;
	Область.Параметры.ДатаФормирования = Формат(ДанныеДляЗаполнения.ДатаФормирования, "ДФ=dd.MM.yyyy") + " 23:59:59";
	
	ТД.Вывести(Область);
	
	ИтоговаяСЧА = 0;
	ПромежуточныйИтог = 0;
	
	// 1. Денежные средства на счетах
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "1", ДанныеДляЗаполнения.МассивРаздела1, ПромежуточныйИтог);
	
	// 2. Денежные средства в депозитах
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "2", ДанныеДляЗаполнения.МассивРаздела2, ПромежуточныйИтог, "СуммаПроцентов");
		
	// 3. Государственные ценные бумаги Российской Федерации, 
	//    обращающиеся на рынке ценных бумаг, за исключением 
	//	  облигаций внешних облигационных займов Российской Федерации
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "3", ДанныеДляЗаполнения.МассивРаздела3, ПромежуточныйИтог); //, "Купон");
	
	// 4. Государственные ценные бумаги Российской Федерации,
	// специально выпущенные Правительством Российской Федерации
	// для размещения средств институциональных инвесторов
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "4", Новый Массив, ПромежуточныйИтог); //, "Купон");
	
	// 5. Облигации внешних облигационных займов
	// Российской Федерации
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "5", Новый Массив, ПромежуточныйИтог); //, "Купон");
	
	// 6. Государственные ценные бумаги субъектов
	// Российской Федерации
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "6", ДанныеДляЗаполнения.МассивРаздела6, ПромежуточныйИтог); //, "Купон");
	
	// 7. Муниципальные облигации
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "7", ДанныеДляЗаполнения.МассивРаздела7, ПромежуточныйИтог); //, "Купон");
	
	// 8. Облигации российских хозяйственных обществ, государственных предприятий и корпораций
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "8", ДанныеДляЗаполнения.МассивРаздела8, ПромежуточныйИтог); //, "Купон");
	
	// 8.1. Облигации российских хозяйственных обществ, государственных предприятий и корпораций
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "8_1", ДанныеДляЗаполнения.МассивРаздела8_1, ПромежуточныйИтог); //, "Купон");
	
	// 9. Акции российских эмитентов, созданных в форме открытых акционерных обществ
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "9", ДанныеДляЗаполнения.МассивРаздела9, ПромежуточныйИтог); //, "Купон");
	
	// 10. Облигации с ипотечным покрытием, выпущенные в соответствии
	// с законодательством Российской Федерации об ипотечных ценных бумагах
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "10", ДанныеДляЗаполнения.МассивРаздела10, ПромежуточныйИтог); //, "Купон");
	
	// 11. Ипотечные сертификаты участия, выданные в соответствии
	// с законодательством Российской Федерации об ипотечных ценных бумагах
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "11", ДанныеДляЗаполнения.МассивРаздела11, ПромежуточныйИтог); //, "Купон");
	
	// 12. Паи (акции, доли) индексных инвестиционных фондов, размещающих 
	//     средства в государственные ценные бумаги иностранных государств, облигации и акции иностранных эмитентов
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "12", Новый Массив, ПромежуточныйИтог); //, "Купон");
			
	//// Итого оценочная стоимость активов
	//Область = ОбластиМакета["ОценочнаяСтоимостьАктивов"];
	//Область.Параметры.Сумма = ПромежуточныйИтог;
	//ТД.Вывести(Область);
	
	ИтоговаяСЧА = ИтоговаяСЧА + ПромежуточныйИтог;
	ПромежуточныйИтог = 0;
		
	// 13. Дебиторская задолженность (Шапка)
	ТД.Вывести(ОбластиМакета["Шапка13"]);
	
	// Средства пенсионных резервов на специальных брокерских счетах
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "13_1", ДанныеДляЗаполнения.МассивРаздела13_1, ПромежуточныйИтог);
	
	// Дебиторская задолженность по купонному доходу
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "13_2", ДанныеДляЗаполнения.МассивРаздела13_2, ПромежуточныйИтог);
	
	// Прочая дебиторская задолженность
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "13_3", ДанныеДляЗаполнения.МассивРаздела13_3, ПромежуточныйИтог);
	
	// 13. Дебиторская задолженность (Подвал)
	Область = ОбластиМакета["Подвал13"];
	Область.Параметры.Сумма = ПромежуточныйИтог;
	ТД.Вывести(Область);
	
	ИтоговаяСЧА = ИтоговаяСЧА + ПромежуточныйИтог;
	
	// 12* Прочие активы
	ПромежуточныйИтог = 0;
	ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "ПрочиеАктивы", ДанныеДляЗаполнения.МассивРазделаПрочиеАктивы, ПромежуточныйИтог);
	
	ИтоговаяСЧА = ИтоговаяСЧА + ПромежуточныйИтог;
	
	// Итого рыночная стоимость активов
	Область = ОбластиМакета["Подвал"];
	Область.Параметры.Сумма			= ИтоговаяСЧА;
	
	ТД.Вывести(Область);
	
	Если ЭтоСЧА Тогда
		
		ПромежуточныйИтог = 0;
		              		
		// 15. Кредиторская задолженность
		ВывестиБлокВТабличныйДокумент(ТД, ОбластиМакета, "15", ДанныеДляЗаполнения.МассивРаздела15, ПромежуточныйИтог);		
		ИтоговаяСЧА = ИтоговаяСЧА - ПромежуточныйИтог;
	
		// Итого стоимость чистых активов
		Область = ОбластиМакета["ПодвалСЧА"];
		Область.Параметры.Сумма	= Формат(ИтоговаяСЧА, "ЧДЦ=5; ЧС=3");
		
		ТД.Вывести(Область);
		
	КонецЕсли; 
	        	
	Область = ОбластиМакета["ПодвалПодписи"];
	Область.Параметры.ФИОПодписанта = ДанныеДляЗаполнения.ФИОПодписанта;
	
	ТД.Вывести(Область);
	
	ТД.АвтоМасштаб = Истина;
	
	ИмяФонда = ДанныеДляЗаполнения.ДанныеКлиентаКратко;
	ИмяФонда = СтрЗаменить(ИмяФонда, "\",  "_");
	ИмяФонда = СтрЗаменить(ИмяФонда, "/",  "_");
	ИмяФонда = СтрЗаменить(ИмяФонда, "*",  "_");
	ИмяФонда = СтрЗаменить(ИмяФонда, "?",  "_");
	ИмяФонда = СтрЗаменить(ИмяФонда, """", "_");
	ИмяФонда = СтрЗаменить(ИмяФонда, "<",  "_");
	ИмяФонда = СтрЗаменить(ИмяФонда, ">",  "_");
	ИмяФонда = СтрЗаменить(ИмяФонда, ":",  "_");
	ИмяФонда = СтрЗаменить(ИмяФонда, "|",  "_");
	
	// Не учитываем ИНН, КПП
	ПозицияЗапятой = СтрНайти(ИмяФонда, ",");
	Если ПозицияЗапятой > 0 Тогда
		ИмяФонда = Лев(ИмяФонда, ПозицияЗапятой-1);	
	КонецЕсли;     		
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяФайла",			"НСД_" + ?(ЭтоСЧА, "СЧА_", "РСА_") + ДанныеДляЗаполнения.СДУ + "_" + ДанныеДляЗаполнения.ДатаОтчета + ".xls");
	Результат.Вставить("ТабличныйДокумент",	ТД);
	
	Возврат Результат;
	
КонецФункции

