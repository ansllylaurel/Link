Функция ПолучитьТабличныеДокументыСЧАНСД(СписокСсылок, Подписант, Разрядность = 5) Экспорт
	
	Результат = Новый Массив;
			
	Для Каждого СтрокаСписка Из СписокСсылок Цикл
				
		ТекДокумент = СтрокаСписка;
		Если ТекДокумент = ПредопределенноеЗначение("Документ.РегистрацияСтоимостиАктивов.ПустаяСсылка") Тогда
			Продолжить;
		КонецЕсли;
		
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекДокумент, Новый Структура("ВидДоговора, Дата", "СчетДоверительногоУправления.ВидДоговораДоверительногоУправления", "Дата"));
		
		ЭтоФорма2023 = РеквизитыДокумента.Дата >= '20231101';
			
		Макет = ОпределитьМакет(
					?(РеквизитыДокумента.ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями И ЭтоФорма2023, 
						"СЧАНСД_ПН2023", 
						"СЧАНСД"), 
					, 
					Ложь, 
					Неопределено, 
					ТекДокумент);
			
		Если Макет = Неопределено Тогда
			Возврат Результат;	
		КонецЕсли;
				
		ОбластиМакета = ПолучитьОбластиМакетаДляСЧАНСД(Макет, РеквизитыДокумента.ВидДоговора, ЭтоФорма2023); 	
	    
		Если РеквизитыДокумента.ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда 
			ТекстЗапроса = ПолучитьТекстЗапроса(ТекДокумент, "СЧАНСД_ПР");
			ТабличныйДокумент = СформироватьТабличныйДокументСЧАНСД_ПР(ТекДокумент, ТекстЗапроса, ОбластиМакета, Подписант);
		ИначеЕсли ЭтоФорма2023 Тогда
			ТекстЗапроса = ПолучитьТекстЗапроса(ТекДокумент, "СЧАНСД_ПН2023");
			ТабличныйДокумент = СформироватьТабличныйДокументСЧАРСАНСД(ТекДокумент, ТекстЗапроса, ОбластиМакета, Подписант, Истина);
		Иначе
			ТекстЗапроса = ПолучитьТекстЗапроса(ТекДокумент, "СЧАНСД");
			ТабличныйДокумент = СформироватьТабличныйДокументСЧАНСД(ТекДокумент, ТекстЗапроса, ОбластиМакета, Подписант, Разрядность);
		КонецЕсли;
				
		Если ТабличныйДокумент <> Неопределено Тогда
			Результат.Добавить(ТабличныйДокумент);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

