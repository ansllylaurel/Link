		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахISIN
		|		ПО _КЗПоВозвратуКупонногоДохода.Облигация = КодыВТорговыхСистемахISIN.Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""Section_7_3"" КАК Sections,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ИНН, ""-"") КАК VAT_Registration_No_Bank,
		|	СУММА(_ПрочиеАктивы.СуммаРынокВВалютеУчета) КАК Amount
		|ИЗ
		|	_ПрочиеАктивы КАК _ПрочиеАктивы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО _ПрочиеАктивы.Контрагент = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	_ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|	И НЕ _ПрочиеАктивы.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВозвратуКупонногоДохода))
		|	И ТИПЗНАЧЕНИЯ(_ПрочиеАктивы.СубъектАналитики) <> ТИП(Справочник.БрокерскиеКомпании)
		|
		|СГРУППИРОВАТЬ ПО
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОбщиеСуммы.Section КАК Section,
		|	СУММА(ЕСТЬNULL(_ОбщиеСуммы.Amount, 0)) КАК Amount
		|ИЗ
		|	_ОбщиеСуммы КАК _ОбщиеСуммы
		|
		|СГРУППИРОВАТЬ ПО
		|	_ОбщиеСуммы.Section
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияДополнительныхСведений.Значение КАК Ext_Fond_Code
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Свойство.Ключ = ""ВнешняяОбработка._ЭкспортДанныхВСЭДИНФИНИТУМ.ИнвестСчет""
		|	И ЗначенияДополнительныхСведений.Объект = &СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияДополнительныхСведений.Значение КАК Ext_UK_Сode
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Свойство.Ключ = ""ВнешняяОбработка._ЭкспортДанныхВСЭДИНФИНИТУМ.КодУправляющейКомпании""
		|	И ЗначенияДополнительныхСведений.Объект = &Организация";
					
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ДоработатьТекстЗапросаСЧА(ТекстЗапроса) Экспорт
	
	// Группируем ЦБ в соответствии с кодами строк СЧА
	ТекстЗапроса = ТекстЗапроса +  
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма, """") В (ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.ГосударственнаяКорпорация), ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.ФедеральноеГосударственноеУнитарноеПредприятие))
		|						ТОГДА ""050""
		|					КОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма, """") = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация)
		|						ТОГДА ""039""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная)
		|						ТОГДА ""031""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная)
		|						ТОГДА ""032""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Муниципальная)
		|						ТОГДА ""033""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная)
		|						ТОГДА ""034""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Ипотечная)
		|						ТОГДА ""037""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|						ТОГДА ""039""
		|				КОНЕЦ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ВЫБОР
		|					КОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.РезидентРФ, ЛОЖЬ) = ЛОЖЬ
		|						ТОГДА ""039""
		|					ИНАЧЕ ""035""
		|				КОНЕЦ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|			ТОГДА ""038""
		|		ИНАЧЕ ""050""
		|	КОНЕЦ КАК КодСтроки,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Акции).УчетныйАктивЦБРФ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Векселя).УчетныйАктивЦБРФ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).УчетныйАктивЦБРФ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).УчетныйАктивЦБРФ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Паи).УчетныйАктивЦБРФ
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.)
		|	КОНЕЦ КАК УчетныйАктивЦБРФ,
		|	ВЫБОР
		|		КОГДА &ЭтоВариантС2018Года
		|			ТОГДА _ТаблицаЦБ.Сумма + _ТаблицаЦБ.Купон
		|		ИНАЧЕ _ТаблицаЦБ.Сумма
		|	КОНЕЦ КАК Сумма
		|ПОМЕСТИТЬ _РазвернутаяТаблицаСКодами
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|					ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|				КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|					ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|			КОНЕЦ = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РазвернутаяТаблицаСКодами.КодСтроки КАК КодСтроки,
		|	СУММА(_РазвернутаяТаблицаСКодами.Сумма) КАК СуммаРынок
		|ПОМЕСТИТЬ _СтрокиЦБ
		|ИЗ
		|	_РазвернутаяТаблицаСКодами КАК _РазвернутаяТаблицаСКодами
		|
		|СГРУППИРОВАТЬ ПО
		|	_РазвернутаяТаблицаСКодами.КодСтроки";

	ТекстЗапроса = ТекстЗапроса + "
		|;
		|////////////////////////////////////////////////////////////////////////////////	
		|"; 
	
	// Запрос по прочим активам и обязательствам СЧА
	ТекстЗапроса = ТекстЗапроса + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(Разделы.СуммаРынокВВалютеУчета, 0) КАК СуммаРынок,
		|	Разделы.СубъектАналитики КАК СубъектАналитики,
		|	Разделы.ВидЗадолженности КАК ВидЗадолженности,
		|	Разделы.Контрагент КАК Контрагент,
		|	Разделы.ВидАктива КАК ВидАктива
		|ПОМЕСТИТЬ _ТЗ_Разделы
		|ИЗ
		|	РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК Разделы
		|ГДЕ
		|	Разделы.Регистратор = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТЗ_Разделы.СуммаРынок КАК СуммаРынок,
		|	_ТЗ_Разделы.ВидАктива КАК ВидАктива,
		|	_ТЗ_Разделы.ВидЗадолженности КАК ВидЗадолженности,
		|	_ТЗ_Разделы.Контрагент КАК Контрагент,
		|	_ТЗ_Разделы.СубъектАналитики КАК СубъектАналитики
		|ПОМЕСТИТЬ _ПрочиеАктивы
		|ИЗ
		|	_ТЗ_Разделы КАК _ТЗ_Разделы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|				И ТИПЗНАЧЕНИЯ(_ПрочиеАктивы.СубъектАналитики) = ТИП(Справочник.БанковскиеСчета)
		|				И _ПрочиеАктивы.СубъектАналитики <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ДенежныеСредстваВПути)
		|			ТОГДА ""010""
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|				И ТИПЗНАЧЕНИЯ(_ПрочиеАктивы.СубъектАналитики) = ТИП(Справочник.БанковскиеСчета)
		|				И _ПрочиеАктивы.СубъектАналитики = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ДенежныеСредстваВПути)
		|			ТОГДА ""050""
		|		КОГДА &МНОВРазделеДенежныеСредства
		|				И _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И ТИПЗНАЧЕНИЯ(_ПрочиеАктивы.СубъектАналитики) = ТИП(Документ.МНО)
		|			ТОГДА ""010""
		|		КОГДА НЕ &МНОВРазделеДенежныеСредства
		|				И _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И ТИПЗНАЧЕНИЯ(_ПрочиеАктивы.СубъектАналитики) = ТИП(Документ.МНО)
		|			ТОГДА ""040""
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|			ТОГДА ""020""
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|			ТОГДА ""040""
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|			ТОГДА ""070""
		|	КОНЕЦ КАК КодСтроки,
		|	_ПрочиеАктивы.СуммаРынок КАК СуммаРынок,
		|	_ПрочиеАктивы.СуммаРынок КАК СЧА
		|ПОМЕСТИТЬ _ТаблицаСтрок
		|ИЗ
		|	_ПрочиеАктивы КАК _ПрочиеАктивы
		|ГДЕ
		|	(_ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|			ИЛИ _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|			ИЛИ _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|			ИЛИ _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И ТИПЗНАЧЕНИЯ(_ПрочиеАктивы.СубъектАналитики) = ТИП(Справочник.БрокерскиеКомпании)
		|			ТОГДА ""041""
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И _ПрочиеАктивы.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона))
		|			ТОГДА ""042""
		|		КОГДА &МНОВРазделеДенежныеСредства
		|				И _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И НЕ _ПрочиеАктивы.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона))
		|				И ТИПЗНАЧЕНИЯ(_ПрочиеАктивы.СубъектАналитики) <> ТИП(Документ.МНО)
		|			ТОГДА ""043""
		|		КОГДА НЕ &МНОВРазделеДенежныеСредства
		|				И _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И НЕ _ПрочиеАктивы.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона))
		|			ТОГДА ""043""
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|				И _ПрочиеАктивы.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария)
		|			ТОГДА ""071""
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|				И _ПрочиеАктивы.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющего)
		|			ТОГДА ""072""
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|			ТОГДА ""075""
		|	КОНЕЦ,
		|	_ПрочиеАктивы.СуммаРынок,
		|	0
		|ИЗ
		|	_ПрочиеАктивы КАК _ПрочиеАктивы
		|ГДЕ
		|	(_ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|			ИЛИ _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""080"",
		|	_ПрочиеАктивы.СуммаРынок,
		|	0
		|ИЗ
		|	_ПрочиеАктивы КАК _ПрочиеАктивы
		|ГДЕ
		|	_ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""042"",
		|	СУММА(_ТаблицаЦБ.Купон),
		|	0
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|ГДЕ
		|	_ТаблицаЦБ.Купон <> 0
		|	И НЕ &ЭтоВариантС2018Года
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""040"",
		|	СУММА(_ТаблицаЦБ.Купон),
		|	СУММА(_ТаблицаЦБ.Купон)
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|ГДЕ
		|	_ТаблицаЦБ.Купон <> 0
		|	И НЕ &ЭтоВариантС2018Года
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_СтрокиЦБ.КодСтроки,
		|	_СтрокиЦБ.СуммаРынок,
		|	ВЫБОР
		|		КОГДА _СтрокиЦБ.КодСтроки = ""050""
		|			ТОГДА _СтрокиЦБ.СуммаРынок
		|		ИНАЧЕ 0
		|	КОНЕЦ
		|ИЗ
		|	_СтрокиЦБ КАК _СтрокиЦБ
		|ГДЕ
		|	_СтрокиЦБ.СуммаРынок <> 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""030"",
		|	_СтрокиЦБ.СуммаРынок,
		|	_СтрокиЦБ.СуммаРынок
		|ИЗ
		|	_СтрокиЦБ КАК _СтрокиЦБ
		|ГДЕ
		|	ПОДСТРОКА(_СтрокиЦБ.КодСтроки, 1, 2) = ""03""
		|	И _СтрокиЦБ.СуммаРынок <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаСтрок.КодСтроки КАК КодСтроки,
		|	СУММА(_ТаблицаСтрок.СуммаРынок) КАК СуммаРынок,
		|	СУММА(_ТаблицаСтрок.СЧА) КАК СЧА
		|ИЗ
		|	_ТаблицаСтрок КАК _ТаблицаСтрок
		|ГДЕ
		|	_ТаблицаСтрок.СуммаРынок <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	_ТаблицаСтрок.КодСтроки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""060"",
		|	СУММА(ВЫБОР
		|			КОГДА _ТаблицаСтрок.КодСтроки = ""010""
		|					ИЛИ _ТаблицаСтрок.КодСтроки = ""020""
		|					ИЛИ _ТаблицаСтрок.КодСтроки = ""030""
		|					ИЛИ _ТаблицаСтрок.КодСтроки = ""040""
		|					ИЛИ _ТаблицаСтрок.КодСтроки = ""050""
		|				ТОГДА _ТаблицаСтрок.СуммаРынок
		|			ИНАЧЕ 0
		|		КОНЕЦ),
		|	СУММА(0)
		|ИЗ
		|	_ТаблицаСтрок КАК _ТаблицаСтрок
		|ГДЕ
		|	_ТаблицаСтрок.СуммаРынок <> 0
		|ИТОГИ
		|	СУММА(СуммаРынок),
		|	СУММА(СЧА)
		|ПО
		|	ОБЩИЕ";  
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ДоработатьТекстЗапросаСЧАСДКГарант(ТекстЗапроса) Экспорт
	
	// Группируем ЦБ в соответствии с кодами строк СЧА
	ТекстЗапроса = ТекстЗапроса +  
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма, """") В (ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.ГосударственнаяКорпорация), ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.ФедеральноеГосударственноеУнитарноеПредприятие), ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.ГосударственнаяКомпания), ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.ГосударственноеУнитарноеПредприятие))
		|						ТОГДА ""050""
		|					КОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма, """") = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация)
		|						ТОГДА ""039""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная)
		|						ТОГДА ""031""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная)
		|						ТОГДА ""032""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Муниципальная)
		|						ТОГДА ""033""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная)
		|						ТОГДА ""034""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Ипотечная)
		|						ТОГДА ""037""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|						ТОГДА ВЫБОР
		|								КОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.РезидентРФ, ЛОЖЬ) = ЛОЖЬ
		|										И ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихНерезидентов)
		|									ТОГДА ""050""
		|								ИНАЧЕ ""039""
		|							КОНЕЦ
		|				КОНЕЦ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ВЫБОР
		|					КОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.РезидентРФ, ЛОЖЬ) = ЛОЖЬ
		|						ТОГДА ""039""
		|					ИНАЧЕ ""035""
		|				КОНЕЦ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|			ТОГДА ""038""
		|		ИНАЧЕ ""050""
		|	КОНЕЦ КАК КодСтроки,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Акции).УчетныйАктивЦБРФ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Векселя).УчетныйАктивЦБРФ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).УчетныйАктивЦБРФ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).УчетныйАктивЦБРФ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Паи).УчетныйАктивЦБРФ
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.)
		|	КОНЕЦ КАК УчетныйАктивЦБРФ,
		|	ВЫБОР
		|		КОГДА &ЭтоВариантС2018Года
		|			ТОГДА _ТаблицаЦБ.Сумма + _ТаблицаЦБ.Купон
		|		ИНАЧЕ _ТаблицаЦБ.Сумма
		|	КОНЕЦ КАК Сумма
		|ПОМЕСТИТЬ _РазвернутаяТаблицаСКодами
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|					ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|				КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|					ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|			КОНЕЦ = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РазвернутаяТаблицаСКодами.КодСтроки КАК КодСтроки,
		|	СУММА(_РазвернутаяТаблицаСКодами.Сумма) КАК СуммаРынок
		|ПОМЕСТИТЬ _СтрокиЦБ
		|ИЗ
		|	_РазвернутаяТаблицаСКодами КАК _РазвернутаяТаблицаСКодами
		|
		|СГРУППИРОВАТЬ ПО
		|	_РазвернутаяТаблицаСКодами.КодСтроки";

	ТекстЗапроса = ТекстЗапроса + "
		|;
		|////////////////////////////////////////////////////////////////////////////////	
		|";
	
	// Запрос по прочим активам и обязательствам СЧА
	ТекстЗапроса = ТекстЗапроса + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Разделы.СуммаРынокВВалютеУчета КАК СуммаРынок,
		|	Разделы.СубъектАналитики КАК СубъектАналитики,
		|	Разделы.ВидЗадолженности КАК ВидЗадолженности,
		|	Разделы.Контрагент КАК Контрагент,
		|	Разделы.ВидАктива КАК ВидАктива
		|ПОМЕСТИТЬ _ПрочиеАктивы
		|ИЗ
		|	РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК Разделы
		|ГДЕ
		|	Разделы.Регистратор = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|				И ТИПЗНАЧЕНИЯ(_ПрочиеАктивы.СубъектАналитики) = ТИП(Справочник.БанковскиеСчета)
		|				И _ПрочиеАктивы.СубъектАналитики <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ДенежныеСредстваВПути)
		|			ТОГДА ""010""
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|				И ТИПЗНАЧЕНИЯ(_ПрочиеАктивы.СубъектАналитики) = ТИП(Справочник.БанковскиеСчета)
		|				И _ПрочиеАктивы.СубъектАналитики = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ДенежныеСредстваВПути)
		|			ТОГДА ""050""
		|		КОГДА &МНОВРазделеДенежныеСредства
		|				И _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И ТИПЗНАЧЕНИЯ(_ПрочиеАктивы.СубъектАналитики) = ТИП(Документ.МНО)
		|			ТОГДА ""010""
		|		КОГДА НЕ &МНОВРазделеДенежныеСредства
		|				И _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И ТИПЗНАЧЕНИЯ(_ПрочиеАктивы.СубъектАналитики) = ТИП(Документ.МНО)
		|			ТОГДА ""040""
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|			ТОГДА ""020""
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|			ТОГДА ""040""
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|			ТОГДА ""070""
		|	КОНЕЦ КАК КодСтроки,
		|	_ПрочиеАктивы.СуммаРынок КАК СуммаРынок,
		|	_ПрочиеАктивы.СуммаРынок КАК СЧА
		|ПОМЕСТИТЬ _ТаблицаСтрок
		|ИЗ
		|	_ПрочиеАктивы КАК _ПрочиеАктивы
		|ГДЕ
		|	(_ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|			ИЛИ _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|			ИЛИ _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|			ИЛИ _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И ТИПЗНАЧЕНИЯ(_ПрочиеАктивы.СубъектАналитики) = ТИП(Справочник.БрокерскиеКомпании)
		|			ТОГДА ""041""
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И _ПрочиеАктивы.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона))
		|			ТОГДА ""042""
		|		КОГДА &МНОВРазделеДенежныеСредства
		|				И _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И НЕ _ПрочиеАктивы.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона))
		|				И ТИПЗНАЧЕНИЯ(_ПрочиеАктивы.СубъектАналитики) <> ТИП(Документ.МНО)
		|			ТОГДА ""043""
		|		КОГДА НЕ &МНОВРазделеДенежныеСредства
		|				И _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И НЕ _ПрочиеАктивы.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона))
		|			ТОГДА ""043""
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|				И _ПрочиеАктивы.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария)
		|			ТОГДА ""071""
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|				И _ПрочиеАктивы.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющего)
		|			ТОГДА ""072""
		|		КОГДА _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|			ТОГДА ""075""
		|	КОНЕЦ,
		|	_ПрочиеАктивы.СуммаРынок,
		|	0
		|ИЗ
		|	_ПрочиеАктивы КАК _ПрочиеАктивы
		|ГДЕ
		|	(_ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|			ИЛИ _ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""080"",
		|	_ПрочиеАктивы.СуммаРынок,
		|	0
		|ИЗ
		|	_ПрочиеАктивы КАК _ПрочиеАктивы
		|ГДЕ
		|	_ПрочиеАктивы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""042"",
		|	СУММА(_ТаблицаЦБ.Купон),
		|	0
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|ГДЕ
		|	_ТаблицаЦБ.Купон <> 0
		|	И НЕ &ЭтоВариантС2018Года
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""040"",
		|	СУММА(_ТаблицаЦБ.Купон),
		|	СУММА(_ТаблицаЦБ.Купон)
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|ГДЕ
		|	_ТаблицаЦБ.Купон <> 0
		|	И НЕ &ЭтоВариантС2018Года
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_СтрокиЦБ.КодСтроки,
		|	_СтрокиЦБ.СуммаРынок,
		|	ВЫБОР
		|		КОГДА _СтрокиЦБ.КодСтроки = ""050""
		|			ТОГДА _СтрокиЦБ.СуммаРынок
		|		ИНАЧЕ 0
		|	КОНЕЦ
		|ИЗ
		|	_СтрокиЦБ КАК _СтрокиЦБ
		|ГДЕ
		|	_СтрокиЦБ.СуммаРынок <> 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""030"",
		|	_СтрокиЦБ.СуммаРынок,
		|	_СтрокиЦБ.СуммаРынок
		|ИЗ
		|	_СтрокиЦБ КАК _СтрокиЦБ
		|ГДЕ
		|	ПОДСТРОКА(_СтрокиЦБ.КодСтроки, 1, 2) = ""03""
		|	И _СтрокиЦБ.СуммаРынок <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаСтрок.КодСтроки КАК КодСтроки,
		|	ЕСТЬNULL(СУММА(_ТаблицаСтрок.СуммаРынок), 0) КАК СуммаРынок,
		|	ЕСТЬNULL(СУММА(_ТаблицаСтрок.СЧА), 0) КАК СЧА
		|ИЗ
		|	_ТаблицаСтрок КАК _ТаблицаСтрок
		|ГДЕ
		|	_ТаблицаСтрок.СуммаРынок <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	_ТаблицаСтрок.КодСтроки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""060"",
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА _ТаблицаСтрок.КодСтроки = ""010""
		|						ИЛИ _ТаблицаСтрок.КодСтроки = ""020""
		|						ИЛИ _ТаблицаСтрок.КодСтроки = ""030""
		|						ИЛИ _ТаблицаСтрок.КодСтроки = ""040""
		|						ИЛИ _ТаблицаСтрок.КодСтроки = ""050""
		|					ТОГДА _ТаблицаСтрок.СуммаРынок
		|				ИНАЧЕ 0
		|			КОНЕЦ), 0),
		|	ЕСТЬNULL(СУММА(0), 0)
		|ИЗ
		|	_ТаблицаСтрок КАК _ТаблицаСтрок
		|ГДЕ
		|	_ТаблицаСтрок.СуммаРынок <> 0
		|ИТОГИ
		|	СУММА(СуммаРынок),
		|	СУММА(СЧА)
		|ПО
		|	ОБЩИЕ";  
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ДоработатьТекстЗапросаСЧАНСД(ТекстЗапроса) Экспорт
	
	// Группируем ЦБ в соответствии с кодами строк СЧА
	ТекстЗапроса = ТекстЗапроса + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма, """") = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация)
		|						ТОГДА ""039""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная)
		|						ТОГДА ""031""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная)
		|						ТОГДА ""032""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Муниципальная)
		|						ТОГДА ""033""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная)
		|						ТОГДА ""034""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Ипотечная)
		|						ТОГДА ""037""
		|					КОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|						ТОГДА ""050""
		|				КОНЕЦ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ВЫБОР
		|					КОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма, """") = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация)
		|						ТОГДА ""039""
		|					КОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.РезидентРФ, ЛОЖЬ) = ЛОЖЬ
		|						ТОГДА ""050""
		|					ИНАЧЕ ""035""
		|				КОНЕЦ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|			ТОГДА ""038""
		|		ИНАЧЕ ""050""
		|	КОНЕЦ КАК КодСтроки,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Акции).УчетныйАктивЦБРФ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Векселя).УчетныйАктивЦБРФ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).УчетныйАктивЦБРФ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).УчетныйАктивЦБРФ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Паи).УчетныйАктивЦБРФ
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.)
		|	КОНЕЦ КАК УчетныйАктивЦБРФ,
		|	ВЫБОР
		|		КОГДА &ЭтоВариантС2018Года
		|			ТОГДА _ТаблицаЦБ.Сумма + _ТаблицаЦБ.Купон
		|		ИНАЧЕ _ТаблицаЦБ.Сумма
		|	КОНЕЦ КАК Сумма
		|ПОМЕСТИТЬ _РазвернутаяТаблицаСКодами
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО _ТаблицаЦБ.ЦеннаяБумага.Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РазвернутаяТаблицаСКодами.КодСтроки КАК КодСтроки,
		|	СУММА(_РазвернутаяТаблицаСКодами.Сумма) КАК СуммаРынок
		|ПОМЕСТИТЬ _СтрокиЦБ
		|ИЗ
		|	_РазвернутаяТаблицаСКодами КАК _РазвернутаяТаблицаСКодами
		|
		|СГРУППИРОВАТЬ ПО
		|	_РазвернутаяТаблицаСКодами.КодСтроки";
	
	ТекстЗапроса = ТекстЗапроса + "
		|;
		|////////////////////////////////////////////////////////////////////////////////	
		|";
	
	// Запрос по прочим активам и обязательствам СЧА
	ТекстЗапроса = ТекстЗапроса + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(Разделы.СуммаРынокВВалютеУчета, 0) + ЕСТЬNULL(РезервыПредстоящихРасходовОстатки.СуммаОстаток, 0) КАК СуммаРынок,
		|	Разделы.СубъектАналитики КАК СубъектАналитики,
		|	Разделы.ВидЗадолженности КАК ВидЗадолженности,
		|	Разделы.Контрагент КАК Контрагент,
		|	Разделы.ВидАктива КАК ВидАктива,
		|	-ЕСТЬNULL(РезервыПредстоящихРасходовОстатки.СуммаОстаток, 0) КАК СуммаРезерваВВалютеУчета
		|ПОМЕСТИТЬ _ТЗ_Разделы
		|ИЗ
		|	РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК Разделы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РезервыПредстоящихРасходов.Остатки(
		|				&ПериодГраница,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК РезервыПредстоящихРасходовОстатки
		|		ПО (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(Разделы.Основание) = ТИП(Документ.СделкаРЕПО)
		|					ТОГДА Разделы.Основание = РезервыПредстоящихРасходовОстатки.СубъектАналитики
		|							И Разделы.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|				КОГДА ТИПЗНАЧЕНИЯ(Разделы.Основание) В (ТИП(Документ.ПогашениеКупона), ТИП(Документ.НачислениеДивидендов))
		|					ТОГДА Разделы.Основание = РезервыПредстоящихРасходовОстатки.СубъектАналитики
		|				КОГДА ТИПЗНАЧЕНИЯ(Разделы.Основание) = ТИП(Документ.ПогашениеЦеннойБумаги)
		|					ТОГДА Разделы.Основание = РезервыПредстоящихРасходовОстатки.СубъектАналитики
		|							И Разделы.ВидЗадолженности <> ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона)
		|				КОГДА ТИПЗНАЧЕНИЯ(Разделы.СубъектАналитики) = ТИП(Справочник.ДепозитныеВклады)
		|					ТОГДА Разделы.СубъектАналитики = РезервыПредстоящихРасходовОстатки.СубъектАналитики
		|							И Разделы.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитномуВкладу)
		|				КОГДА ТИПЗНАЧЕНИЯ(Разделы.СубъектАналитики) = ТИП(Справочник.БрокерскиеКомпании)
		|					ТОГДА Разделы.СубъектАналитики = РезервыПредстоящихРасходовОстатки.СубъектАналитики
