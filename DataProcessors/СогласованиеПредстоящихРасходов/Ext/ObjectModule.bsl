
Процедура ВыполнитьМетод(Метод, Экземпляры) Экспорт
	
	Если Не (Метод = "СформироватьОповещенияОНовыхПорученияхНаВыводДС"	
		Или Метод = "СформироватьОповещенияОСогласованныхПорученияхНаВыводДС"
		Или Метод = "СформироватьОповещенияОНовыхПорученияхНаПереводДС"
		Или Метод = "СформироватьОповещенияОПорученияхОжидающихАкцепта") Тогда
			
		Возврат;
		
	КонецЕсли;
	
	Ключи = Новый ТаблицаЗначений;
	ПоляТаблицы = "Идентификатор,Организация,Поручение";
	
	Ключи.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("УникальныйИдентификатор"));
	Ключи.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	
	Если Метод = "СформироватьОповещенияОНовыхПорученияхНаПереводДС" Тогда
		
		Ключи.Колонки.Добавить("Срочно", Новый ОписаниеТипов("Булево"));
		Ключи.Колонки.Добавить("Поручение", Новый ОписаниеТипов("ДокументСсылка.ПоручениеНаПереводДенежныхСредств")); 
		
		ПоляТаблицы = ПоляТаблицы + ",Срочно";
		
	ИначеЕсли Метод = "СформироватьОповещенияОПорученияхОжидающихАкцепта" Тогда 
		
		Ключи.Колонки.Добавить("Поручение", Новый ОписаниеТипов("ДокументСсылка.ПоручениеНаПереводДенежныхСредств"));
				
	Иначе
		
		Ключи.Колонки.Добавить("ЭтоНовый", Новый ОписаниеТипов("Булево"));
		Ключи.Колонки.Добавить("Поручение", Новый ОписаниеТипов("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств"));
		
		ПоляТаблицы = ПоляТаблицы + ",ЭтоНовый";
		
	КонецЕсли;
	
	Для Каждого Экземпляр Из Экземпляры Цикл
	
		НовыйКлюч = Ключи.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйКлюч, Экземпляр.Параметры);
		НовыйКлюч.Идентификатор = Экземпляр.Идентификатор;
	
	КонецЦикла;
	
	МВТ = Новый МенеджерВременныхТаблиц; 
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(Ключи, "_Экземпляры", МВТ,, ПоляТаблицы);
			
	Если Метод = "СформироватьОповещенияОНовыхПорученияхНаВыводДС" Тогда
		СформироватьОповещенияОНовыхПорученияхНаВыводДС(Метод, МВТ);	
	ИначеЕсли Метод = "СформироватьОповещенияОСогласованныхПорученияхНаВыводДС" Тогда
		СформироватьОповещенияОСогласованныхПорученияхНаВыводДС(Метод, МВТ);
	ИначеЕсли Метод = "СформироватьОповещенияОНовыхПорученияхНаПереводДС" Тогда
		СформироватьОповещенияОНовыхПорученияхНаПереводДС(Метод, МВТ);
	ИначеЕсли Метод = "СформироватьОповещенияОПорученияхОжидающихАкцепта" Тогда
		СформироватьОповещенияОПорученияхОжидающихАкцепта(Метод, МВТ);
	КонецЕсли; 
	
КонецПроцедуры

Процедура СформироватьОповещенияОНовыхПорученияхНаВыводДС(Метод, МВТ) 
	
	Механизм = Метаданные.Обработки.СогласованиеПредстоящихРасходов.Имя + "." + Метод;
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм);
	
	ДопПараметрыСтатистики = Новый Структура("Результат", "");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;

#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Экземпляры.Организация КАК Организация,
		|	_Экземпляры.Поручение КАК Поручение,
		|	МАКСИМУМ(_Экземпляры.ЭтоНовый) КАК ЭтоНовый
		|ПОМЕСТИТЬ _ГруппыЭкземпляров
		|ИЗ
		|	_Экземпляры КАК _Экземпляры
		|
		|СГРУППИРОВАТЬ ПО
		|	_Экземпляры.Организация,
		|	_Экземпляры.Поручение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ГруппыЭкземпляров.Организация КАК Организация,
		|	ДокПоручениеНаДвижениеДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДокПоручениеНаДвижениеДенежныхСредств.Ссылка КАК Поручение,
		|	ДокПоручениеНаДвижениеДенежныхСредств.ВыводВсехАктивов КАК ВыводВсехАктивов,
		|	ДокПоручениеНаДвижениеДенежныхСредств.ДатаИсполненияС КАК ДатаИсполненияС,
		|	ДокПоручениеНаДвижениеДенежныхСредств.ДатаИсполненияПо КАК ДатаИсполненияПо,
		|	ДокПоручениеНаДвижениеДенежныхСредств.Сумма КАК Сумма,
		|	ДокПоручениеНаДвижениеДенежныхСредств.Валюта КАК Валюта,
		|	ДокПоручениеНаДвижениеДенежныхСредств.СпособПередачи <> ЗНАЧЕНИЕ(Перечисление.СпособыПередачиПоручений.ВнутренняяСистема)
		|		И ДокПоручениеНаДвижениеДенежныхСредств.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица) КАК ТребуетсяПодтверждениеКлиентскогоОтдела,
		|	ДокПоручениеНаДвижениеДенежныхСредств.СпособПередачи = ЗНАЧЕНИЕ(Перечисление.СпособыПередачиПоручений.ВнутренняяСистема) КАК ВнутреннееПоручение,
		|	ДокПоручениеНаДвижениеДенежныхСредств.НазначениеПлатежа КАК НазначениеПлатежа,
		|	_ГруппыЭкземпляров.ЭтоНовый КАК ЭтоНовый,
		|	ЕСТЬNULL(ДокПоручениеНаДвижениеДенежныхСредств.Проведен, ЛОЖЬ) КАК Проведен,
		|	ДокПоручениеНаДвижениеДенежныхСредств.ТипЗадолженности КАК ТипЗадолженности
		|ПОМЕСТИТЬ _ДанныеПоручений
		|ИЗ
		|	_ГруппыЭкземпляров КАК _ГруппыЭкземпляров
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоручениеНаДвижениеДенежныхСредств КАК ДокПоручениеНаДвижениеДенежныхСредств
		|		ПО _ГруппыЭкземпляров.Организация = ДокПоручениеНаДвижениеДенежныхСредств.Организация
		|			И _ГруппыЭкземпляров.Поручение = ДокПоручениеНаДвижениеДенежныхСредств.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер КАК Брокер,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК Код
		|ПОМЕСТИТЬ _КодыБрокера
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			,
		|			СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_ДанныеПоручений.СчетДоверительногоУправления
		|				ИЗ
		|					_ДанныеПоручений КАК _ДанныеПоручений)) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Период, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания)
		|ГДЕ
		|	(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения >= &Период)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КодыБрокера.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_КодыБрокера.Брокер КАК Брокер,
		|	_КодыБрокера.Код КАК Код
		|ПОМЕСТИТЬ _ОдиночныеКодыБрокера
		|ИЗ
		|	_КодыБрокера КАК _КодыБрокера
		|ГДЕ
		|	_КодыБрокера.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				_КодыБрокера.СчетДоверительногоУправления
		|			ИЗ
		|				_КодыБрокера КАК _КодыБрокера
		|			СГРУППИРОВАТЬ ПО
		|				_КодыБрокера.СчетДоверительногоУправления
		|			ИМЕЮЩИЕ
		|				КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _КодыБрокера.Код) = 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеПоручений.Организация КАК Организация,
		|	_ДанныеПоручений.Поручение КАК Поручение,
		|	_Экземпляры.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ _ЗаданияДляОтмены
		|ИЗ
		|	_ДанныеПоручений КАК _ДанныеПоручений
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Экземпляры КАК _Экземпляры
		|		ПО _ДанныеПоручений.Организация = _Экземпляры.Организация
		|			И _ДанныеПоручений.Поручение = _Экземпляры.Поручение
		|			И (_Экземпляры.ЭтоНовый)
		|			И (НЕ _ДанныеПоручений.Проведен)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Экземпляры.Идентификатор КАК Идентификатор,
		|	_ДанныеПоручений.Организация КАК Организация,
		|	_ДанныеПоручений.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДанныеПоручений.СчетДоверительногоУправления.КодСчета КАК КодСчета,
		|	_ДанныеПоручений.Поручение КАК Поручение,
		|	_ДанныеПоручений.ВыводВсехАктивов КАК ВыводВсехАктивов,
		|	_ДанныеПоручений.ДатаИсполненияС КАК ДатаИсполненияС,
		|	_ДанныеПоручений.ДатаИсполненияПо КАК ДатаИсполненияПо,
		|	_ДанныеПоручений.Сумма КАК Сумма,
		|	_ДанныеПоручений.Валюта КАК Валюта,
		|	_ДанныеПоручений.ТребуетсяПодтверждениеКлиентскогоОтдела КАК ТребуетсяПодтверждениеКлиентскогоОтдела,
		|	_ДанныеПоручений.ВнутреннееПоручение КАК ВнутреннееПоручение,
		|	_ДанныеПоручений.НазначениеПлатежа КАК НазначениеПлатежа,
		|	_ДанныеПоручений.ТипЗадолженности КАК ТипЗадолженности,
		|	ВЫБОР
		|		КОГДА _ДанныеПоручений.ЭтоНовый
		|			ТОГДА ""Новые поручения""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА _ДанныеПоручений.Проведен
		|					ТОГДА ""Измененные поручения""
		|				ИНАЧЕ ""Отмененные поручения""
		|			КОНЕЦ
		|	КОНЕЦ КАК СостояниеПоручения,
		|	_ОдиночныеКодыБрокера.Код КАК КодБрокера,
		|	_ОдиночныеКодыБрокера.Брокер КАК Брокер
		|ИЗ
		|	_ДанныеПоручений КАК _ДанныеПоручений
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗаданияДляОтмены КАК _ЗаданияДляОтмены
		|		ПО _ДанныеПоручений.Организация = _ЗаданияДляОтмены.Организация
		|			И _ДанныеПоручений.Поручение = _ЗаданияДляОтмены.Поручение
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Экземпляры КАК _Экземпляры
		|		ПО _ДанныеПоручений.Организация = _Экземпляры.Организация
		|			И _ДанныеПоручений.Поручение = _Экземпляры.Поручение
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОдиночныеКодыБрокера КАК _ОдиночныеКодыБрокера
		|		ПО _ДанныеПоручений.СчетДоверительногоУправления = _ОдиночныеКодыБрокера.СчетДоверительногоУправления
		|ГДЕ
		|	_ЗаданияДляОтмены.Поручение ЕСТЬ NULL
		|ИТОГИ ПО
		|	Организация,
		|	ТипЗадолженности,
		|	СостояниеПоручения"; 
#КонецОбласти
	
	Запрос.УстановитьПараметр("Период", НачалоДня(ТекущаяДатаСеанса()));
	
	ВыборкаГруппировкаПоОрганизации = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		
	МассивОбработанныхПоручений = Новый Массив;
		
	Пока ВыборкаГруппировкаПоОрганизации.Следующий() Цикл 
		
		ВыборкаГруппировкаПоТипуЗадолженности = ВыборкаГруппировкаПоОрганизации.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаГруппировкаПоТипуЗадолженности.Следующий() Цикл
			
			Если ВыборкаГруппировкаПоТипуЗадолженности.ТипЗадолженности = Перечисления.ТипыЗадолженности.Кредиторская Тогда	
				ТемаПисьма = "Поручения на вывод денежных средств. УК " + ВыборкаГруппировкаПоОрганизации.Организация + ".";	
			ИначеЕсли ВыборкаГруппировкаПоТипуЗадолженности.ТипЗадолженности = Перечисления.ТипыЗадолженности.Дебиторская Тогда
				ТемаПисьма = "Поручения на ввод денежных средств. УК " + ВыборкаГруппировкаПоОрганизации.Организация + ".";	
			КонецЕсли;
		
			ТекстПисьма = "";
			ТекстПисьмаДляКлинтскогоОтдела = "";
	        СтруктураЗаданий = Новый Структура("Зафиксировать, ЗафиксироватьБезВыполнения", Новый Массив, Новый Массив);

			ВыборкаГруппировкаПоСостоянию = ВыборкаГруппировкаПоТипуЗадолженности.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаГруппировкаПоСостоянию.Следующий() Цикл 
				
				ТекстПисьма = ТекстПисьма + ?(ТекстПисьма = "", "", Символы.ПС) + "<tr class=""top2""><td colspan=""10"">" + ВыборкаГруппировкаПоСостоянию.СостояниеПоручения + "</td></tr>";

				Выборка = ВыборкаГруппировкаПоСостоянию.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					
					Если МассивОбработанныхПоручений.Найти(Выборка.Поручение) = Неопределено Тогда
						
						МассивОбработанныхПоручений.Добавить(Выборка.Поручение);
						
						СтрокаТекста = "<tr><td>" + ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Выборка.Поручение) 
									 + "</td><td>" + ?(Выборка.ВнутреннееПоручение, "ВНУТРЕННЕЕ", "КЛИЕНТСКОЕ")
									 + "</td><td>" + Выборка.ВыводВсехАктивов 
									 + "</td><td>" + Выборка.Сумма 
									 + "</td><td>" + Выборка.Валюта 
									 + "</td><td>" + Формат(Выборка.ДатаИсполненияС, "ДФ=dd.MM.yyyy") + " - " + Формат(Выборка.ДатаИсполненияПо, "ДФ=dd.MM.yyyy") 
									 + "</td><td>" + СокрЛП(Выборка.НазначениеПлатежа) 
									 + "</td><td>" + СокрЛП(Выборка.СчетДоверительногоУправления) 
									 + "</td><td>" + СокрЛП(Выборка.КодСчета) 
									 + "</td><td>" + СокрЛП(Выборка.КодБрокера) + " (" + Выборка.Брокер + ")</td></tr>"; 
						
						Если Выборка.ТребуетсяПодтверждениеКлиентскогоОтдела Тогда
							
							Если СтрНайти(ТекстПисьмаДляКлинтскогоОтдела, Выборка.СостояниеПоручения) = 0 Тогда 
								ТекстПисьмаДляКлинтскогоОтдела = ТекстПисьмаДляКлинтскогоОтдела + ?(ТекстПисьмаДляКлинтскогоОтдела = "", "", Символы.ПС) + "<tr class=""top2""><td colspan=""10"">" + Выборка.СостояниеПоручения + "</td></tr>";	
							КонецЕсли;
							
							ТекстПисьмаДляКлинтскогоОтдела = ТекстПисьмаДляКлинтскогоОтдела + Символы.ПС + СтрокаТекста;
							
						КонецЕсли;
						
						ТекстПисьма = ТекстПисьма + Символы.ПС + СтрокаТекста;
						
						СтруктураЗаданий.Зафиксировать.Добавить(Выборка.Идентификатор);
		
					Иначе
						СтруктураЗаданий.ЗафиксироватьБезВыполнения.Добавить(Выборка.Идентификатор);
					КонецЕсли;	
						
				КонецЦикла;
					
			КонецЦикла; 
			
			ПараметрыОповещения = Новый Структура;
			ПараметрыОповещения.Вставить("Метод", Метод);
			ПараметрыОповещения.Вставить("Организация", ВыборкаГруппировкаПоОрганизации.Организация);
		    ПараметрыОповещения.Вставить("Тема", ТемаПисьма);
			ПараметрыОповещения.Вставить("Сообщения", РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("Текст, Параметр", ТекстПисьма, "ТребуетсяПодтверждениеОСТО")));
			
			Если ТекстПисьмаДляКлинтскогоОтдела <> "" Тогда
				ПараметрыОповещения.Сообщения.Добавить(Новый Структура("Текст, Параметр", ТекстПисьмаДляКлинтскогоОтдела, "ТребуетсяПодтверждениеКлиентскогоОтдела"));
			КонецЕсли;

			СформироватьОповещения(ПараметрыОповещения);
		
			Для Каждого ТекЗадание Из СтруктураЗаданий.Зафиксировать Цикл
				РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(ТекЗадание);	
			КонецЦикла;
			// если поручение изменили, а потом отменили - оповещаем один раз об отмене. Задание об изменении поручения отменяем. 
			Для Каждого ТекЗадание Из СтруктураЗаданий.ЗафиксироватьБезВыполнения Цикл
				РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(ТекЗадание,, "Отмена выполнения. Состояние поручения было изменено до начала выполнения задания.");	
			КонецЦикла;
			
			ТекРезультат = Строка(ВыборкаГруппировкаПоОрганизации.Организация) 
					+ ": зафиксированно выполненных заданий " + СтруктураЗаданий.Зафиксировать.Количество() 
					+ ", отменено заданий " + СтруктураЗаданий.ЗафиксироватьБезВыполнения.Количество() + ". ";
			
			ДопПараметрыСтатистики.Результат = ДопПараметрыСтатистики.Результат + ТекРезультат;
				
		КонецЦикла;
					
	КонецЦикла;
	
	ЗаданияДляОтмены = МВТ.Таблицы["_ЗаданияДляОтмены"].ПолучитьДанные().Выбрать();
	
	Пока ЗаданияДляОтмены.Следующий() Цикл
		РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(ЗаданияДляОтмены.Идентификатор,, "Отмена выполнения. Новое поручение [" + ЗаданияДляОтмены.Поручение + "] было распроведено до начала выполнения задания.");	
	КонецЦикла;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, ДопПараметрыСтатистики);
	
КонецПроцедуры

Процедура СформироватьОповещенияОСогласованныхПорученияхНаВыводДС(Метод, МВТ)
	
	Механизм = Метаданные.Обработки.СогласованиеПредстоящихРасходов.Имя + "." + Метод;
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм);
	
	ДопПараметрыСтатистики = Новый Структура("Результат", "");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;

#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Экземпляры.Организация КАК Организация,
		|	_Экземпляры.Поручение КАК Поручение,
		|	МАКСИМУМ(_Экземпляры.ЭтоНовый) КАК ЭтоНовыйАкцепт
		|ПОМЕСТИТЬ _ГруппыЭкземпляров
		|ИЗ
		|	_Экземпляры КАК _Экземпляры
		|
		|СГРУППИРОВАТЬ ПО
		|	_Экземпляры.Организация,
		|	_Экземпляры.Поручение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ГруппыЭкземпляров.Организация КАК Организация,
		|	ДокПоручениеНаДвижениеДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДокПоручениеНаДвижениеДенежныхСредств.Ссылка КАК Поручение,
		|	ДокПоручениеНаДвижениеДенежныхСредств.ВыводВсехАктивов КАК ВыводВсехАктивов,
		|	ДокПоручениеНаДвижениеДенежныхСредств.ДатаИсполненияС КАК ДатаИсполненияС,
		|	ДокПоручениеНаДвижениеДенежныхСредств.ДатаИсполненияПо КАК ДатаИсполненияПо,
		|	ДокПоручениеНаДвижениеДенежныхСредств.Сумма КАК Сумма,
		|	ДокПоручениеНаДвижениеДенежныхСредств.Валюта КАК Валюта,
		|	ДокПоручениеНаДвижениеДенежныхСредств.СпособПередачи = ЗНАЧЕНИЕ(Перечисление.СпособыПередачиПоручений.ВнутренняяСистема) КАК ВнутреннееПоручение,
		|	_ГруппыЭкземпляров.ЭтоНовыйАкцепт КАК ЭтоНовыйАкцепт,
		|	ЕСТЬNULL(Акцепт.Проведен, ЛОЖЬ) КАК АкцептПроведен
		|ПОМЕСТИТЬ _ДанныеПоручений
		|ИЗ
		|	_ГруппыЭкземпляров КАК _ГруппыЭкземпляров
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоручениеНаДвижениеДенежныхСредств КАК ДокПоручениеНаДвижениеДенежныхСредств
		|		ПО _ГруппыЭкземпляров.Организация = ДокПоручениеНаДвижениеДенежныхСредств.Организация
		|			И _ГруппыЭкземпляров.Поручение = ДокПоручениеНаДвижениеДенежныхСредств.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Акцепт КАК Акцепт
		|		ПО _ГруппыЭкземпляров.Организация = Акцепт.Организация
		|			И _ГруппыЭкземпляров.Поручение = Акцепт.Объект
		|			И (НЕ Акцепт.ПометкаУдаления)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеПоручений.Организация КАК Организация,
		|	_ДанныеПоручений.Поручение КАК Поручение,
		|	_Экземпляры.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ _ЗаданияДляОтмены
		|ИЗ
		|	_ДанныеПоручений КАК _ДанныеПоручений
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Экземпляры КАК _Экземпляры
		|		ПО _ДанныеПоручений.Организация = _Экземпляры.Организация
		|			И _ДанныеПоручений.Поручение = _Экземпляры.Поручение
		|			И (_Экземпляры.ЭтоНовый)
		|			И (НЕ _ДанныеПоручений.АкцептПроведен)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Экземпляры.Идентификатор КАК Идентификатор,
		|	_ДанныеПоручений.Организация КАК Организация,
		|	_ДанныеПоручений.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДанныеПоручений.СчетДоверительногоУправления.КодСчета КАК КодСчета,
		|	_ДанныеПоручений.Поручение КАК Поручение,
		|	_ДанныеПоручений.ВыводВсехАктивов КАК ВыводВсехАктивов,
		|	_ДанныеПоручений.ДатаИсполненияС КАК ДатаИсполненияС,
		|	_ДанныеПоручений.ДатаИсполненияПо КАК ДатаИсполненияПо,
		|	_ДанныеПоручений.Сумма КАК Сумма,
		|	_ДанныеПоручений.Валюта КАК Валюта,
		|	_ДанныеПоручений.ВнутреннееПоручение КАК ВнутреннееПоручение,
		|	ВЫБОР
		|		КОГДА _ДанныеПоручений.ЭтоНовыйАкцепт
		|			ТОГДА ""Согласованные поручения""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА _ДанныеПоручений.АкцептПроведен
		|					ТОГДА ""Согласованные поручения""
		|				ИНАЧЕ ""Отмененные согласования поручений""
		|			КОНЕЦ
		|	КОНЕЦ КАК СостояниеСогласования
		|ИЗ
		|	_ДанныеПоручений КАК _ДанныеПоручений
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗаданияДляОтмены КАК _ЗаданияДляОтмены
		|		ПО _ДанныеПоручений.Организация = _ЗаданияДляОтмены.Организация
		|			И _ДанныеПоручений.Поручение = _ЗаданияДляОтмены.Поручение
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Экземпляры КАК _Экземпляры
		|		ПО _ДанныеПоручений.Организация = _Экземпляры.Организация
		|			И _ДанныеПоручений.Поручение = _Экземпляры.Поручение
		|ГДЕ
		|	_ЗаданияДляОтмены.Поручение ЕСТЬ NULL
		|ИТОГИ ПО
		|	Организация,
		|	СостояниеСогласования"; 
#КонецОбласти
		
	ВыборкаГруппировкаПоОрганизации = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		
	МассивОбработанныхПоручений = Новый Массив;
	
	Пока ВыборкаГруппировкаПоОрганизации.Следующий() Цикл
		
		ТекстПисьма = "";
		СтруктураЗаданий = Новый Структура("Зафиксировать, ЗафиксироватьБезВыполнения", Новый Массив, Новый Массив);
		
		ВыборкаГруппировкаПоСостоянию = ВыборкаГруппировкаПоОрганизации.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаГруппировкаПоСостоянию.Следующий() Цикл 
			
			ТекстПисьма = ТекстПисьма + ?(ТекстПисьма = "", "", Символы.ПС) + "<tr class=""top2""><td colspan=""8"">" + ВыборкаГруппировкаПоСостоянию.СостояниеСогласования + "</td></tr>";

			Выборка = ВыборкаГруппировкаПоСостоянию.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				Если МассивОбработанныхПоручений.Найти(Выборка.Поручение) = Неопределено Тогда
					
					МассивОбработанныхПоручений.Добавить(Выборка.Поручение);
					
					ТекстПисьма = ТекстПисьма + Символы.ПС 
								+ "<tr><td>" + ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Выборка.Поручение) 
								+ "</td><td>" + ?(Выборка.ВнутреннееПоручение, "ВНУТРЕННЕЕ", "КЛИЕНТСКОЕ") 
								+ "</td><td>" + Выборка.ВыводВсехАктивов 
								+ "</td><td>" + Выборка.Сумма 
								+ "</td><td>" + Выборка.Валюта 
								+ "</td><td>" + Формат(Выборка.ДатаИсполненияС, "ДФ=dd.MM.yyyy") + " - " + Формат(Выборка.ДатаИсполненияПо, "ДФ=dd.MM.yyyy") 
								+ "</td><td>" + СокрЛП(Выборка.СчетДоверительногоУправления)
								+ "</td><td>" + СокрЛП(Выборка.КодСчета) + "</td></tr>"; 
					
					СтруктураЗаданий.Зафиксировать.Добавить(Выборка.Идентификатор);
	
				Иначе
					СтруктураЗаданий.ЗафиксироватьБезВыполнения.Добавить(Выборка.Идентификатор);
				КонецЕсли;	
					
			КонецЦикла;
				
		КонецЦикла;
		
		ПараметрыОповещения = Новый Структура;
		ПараметрыОповещения.Вставить("Метод", Метод);
		ПараметрыОповещения.Вставить("Организация", ВыборкаГруппировкаПоОрганизации.Организация);
	    ПараметрыОповещения.Вставить("Тема", "Согласование поручений на ВЫВОД денежных средств. УК " + ВыборкаГруппировкаПоОрганизации.Организация + ".");
		ПараметрыОповещения.Вставить("Сообщения", РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("Текст, Параметр", ТекстПисьма, "УведомитьОСогласованныхПоручениях")));
		
		СформироватьОповещения(ПараметрыОповещения);
		
		Для Каждого ТекЗадание Из СтруктураЗаданий.Зафиксировать Цикл
			РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(ТекЗадание);	
		КонецЦикла;
		// если поручение изменили, а потом отменили - оповещаем один раз об отмене. Задание об изменении поручения отменяем. 
		Для Каждого ТекЗадание Из СтруктураЗаданий.ЗафиксироватьБезВыполнения Цикл
			РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(ТекЗадание,, "Отмена выполнения. Акцепт на вывод активов по поручению был изменен до начала выполнения задания.");	
		КонецЦикла;
		
		ТекРезультат = Строка(ВыборкаГруппировкаПоОрганизации.Организация) 
					+ ": зафиксированно выполненных заданий " + СтруктураЗаданий.Зафиксировать.Количество() 
					+ ", отменено заданий " + СтруктураЗаданий.ЗафиксироватьБезВыполнения.Количество() + ". "; 
					
		ДопПараметрыСтатистики.Результат = ДопПараметрыСтатистики.Результат + ТекРезультат; 
	
	КонецЦикла;
	
	ЗаданияДляОтмены = МВТ.Таблицы["_ЗаданияДляОтмены"].ПолучитьДанные().Выбрать();
	
	Пока ЗаданияДляОтмены.Следующий() Цикл
		РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(ЗаданияДляОтмены.Идентификатор,, "Отмена выполнения. Акцепт на вывод активов по поручению [" + ЗаданияДляОтмены.Поручение + "] был распроведен до начала выполнения задания.");	
	КонецЦикла;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, ДопПараметрыСтатистики);
	
КонецПроцедуры 

Процедура СформироватьОповещенияОНовыхПорученияхНаПереводДС(Метод, МВТ) Экспорт
	
	Механизм = Метаданные.Обработки.СогласованиеПредстоящихРасходов.Имя + "." + Метод;
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм);
	ДопПараметрыСтатистики = Новый Структура("Результат", "");
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
			
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Экземпляры.Организация КАК Организация,
		|	_Экземпляры.Поручение КАК Поручение,
		|	МАКСИМУМ(_Экземпляры.Срочно) КАК Срочно
		|ПОМЕСТИТЬ _ГруппыЭкземпляров
		|ИЗ
		|	_Экземпляры КАК _Экземпляры
		|
		|СГРУППИРОВАТЬ ПО
		|	_Экземпляры.Организация,
		|	_Экземпляры.Поручение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокументПоручение.Ссылка КАК Ссылка,
		|	ДокументПоручение.Организация КАК Организация,
		|	ДокументПоручение.Дата КАК ДатаПоручения,
		|	ДокументПоручение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДокументПоручение.БрокерПолучатель КАК БрокерПолучатель,
		|	ДокументПоручение.МестоХранения КАК МестоХранения,
		|	ДокументПоручение.МестоХраненияПолучатель КАК МестоХраненияПолучатель,
		|	ДокументПоручение.РасчетныйСчет КАК РасчетныйСчет,
		|	ДокументПоручение.РасчетныйСчетПолучатель КАК РасчетныйСчетПолучатель,
		|	ДокументПоручение.Сумма КАК Сумма,
		|	ДокументПоручение.Валюта КАК Валюта,
		|	_ГруппыЭкземпляров.Срочно КАК Срочно
		|ПОМЕСТИТЬ _ДанныеПоручений
		|ИЗ
		|	_ГруппыЭкземпляров КАК _ГруппыЭкземпляров
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоручениеНаПереводДенежныхСредств КАК ДокументПоручение
		|		ПО _ГруппыЭкземпляров.Организация = ДокументПоручение.Организация
		|			И _ГруппыЭкземпляров.Поручение = ДокументПоручение.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыПорученийНаПереводДенежныхСредств.СрезПоследних(
		|				,
		|				ПоручениеНаПереводДенежныхСредств В
		|					(ВЫБРАТЬ
		|						_ГруппыЭкземпляров.Поручение
		|					ИЗ
		|						_ГруппыЭкземпляров КАК _ГруппыЭкземпляров)) КАК СтатусыПорученийНаПереводДенежныхСредствСрезПоследних
		|		ПО _ГруппыЭкземпляров.Поручение = СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.ПоручениеНаПереводДенежныхСредств
		|ГДЕ
		|	СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.ГотовКОтправке)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер КАК Брокер,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК Код
		|ПОМЕСТИТЬ _КодыБрокера
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			,
		|			СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_ДанныеПоручений.СчетДоверительногоУправления
		|				ИЗ
		|					_ДанныеПоручений КАК _ДанныеПоручений)) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ТекущаяДата, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания)
		|ГДЕ
		|	(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения >= &ТекущаяДата)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КодыБрокера.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_КодыБрокера.Брокер КАК Брокер,
		|	_КодыБрокера.Код КАК Код
		|ПОМЕСТИТЬ _ОдиночныеКодыБрокера
		|ИЗ
		|	_КодыБрокера КАК _КодыБрокера
		|ГДЕ
		|	_КодыБрокера.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				_КодыБрокера.СчетДоверительногоУправления
		|			ИЗ
		|				_КодыБрокера КАК _КодыБрокера
		|			СГРУППИРОВАТЬ ПО
		|				_КодыБрокера.СчетДоверительногоУправления
		|			ИМЕЮЩИЕ
		|				КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _КодыБрокера.Код) = 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеПоручений.Ссылка КАК Ссылка,
		|	_ДанныеПоручений.Организация КАК Организация,
		|	_ДанныеПоручений.ДатаПоручения КАК ДатаПоручения,
		|	_ДанныеПоручений.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЕСТЬNULL(_КодыБрокера.Код, _ОдиночныеКодыБрокера.Код) КАК КодБрокера,
		|	_ДанныеПоручений.БрокерПолучатель КАК БрокерПолучатель,
		|	_ДанныеПоручений.МестоХраненияПолучатель КАК МестоХраненияПолучатель,
		|	ВЫБОР
		|		КОГДА _ДанныеПоручений.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ММВБ_ДепозитыСЦК)
		|			ТОГДА _ДанныеПоручений.МестоХранения
		|		ИНАЧЕ _ДанныеПоручений.РасчетныйСчет
		|	КОНЕЦ КАК Откуда,
		|	_ДанныеПоручений.РасчетныйСчетПолучатель КАК РасчетныйСчетПолучатель,
		|	_ДанныеПоручений.Сумма КАК Сумма,
		|	_ДанныеПоручений.Валюта КАК Валюта,
		|	_ДанныеПоручений.Срочно КАК Срочно,
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток КАК СуммаОстаток,
		|	ЕСТЬNULL(ДенежныеСредстваМНООстатки.СуммаОстаток, 0) КАК ОстатокМНО,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ОстаткиДенежныхСредствОстатки.СуммаОстаток, 0) - ЕСТЬNULL(ДенежныеСредстваМНООстатки.СуммаОстаток, 0) < _ДанныеПоручений.Сумма
		|			ТОГДА _ДанныеПоручений.Сумма - (ЕСТЬNULL(ОстаткиДенежныхСредствОстатки.СуммаОстаток, 0) - ЕСТЬNULL(ДенежныеСредстваМНООстатки.СуммаОстаток, 0))
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК НедостаточноДС
		|ИЗ
		|	_ДанныеПоручений КАК _ДанныеПоручений
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыБрокера КАК _КодыБрокера
		|		ПО _ДанныеПоручений.СчетДоверительногоУправления = _КодыБрокера.СчетДоверительногоУправления
		|			И _ДанныеПоручений.БрокерПолучатель = _КодыБрокера.Брокер
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОдиночныеКодыБрокера КАК _ОдиночныеКодыБрокера
		|		ПО _ДанныеПоручений.СчетДоверительногоУправления = _ОдиночныеКодыБрокера.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|				&ТекущаяДата,
		|				Организация В
		|						(ВЫБРАТЬ
		|							_Экземпляры.Организация
		|						ИЗ
		|							_Экземпляры КАК _Экземпляры)
		|					И (СчетДоверительногоУправления, МестоХранения, РасчетныйСчет) В
		|						(ВЫБРАТЬ
		|							_ДанныеПоручений.СчетДоверительногоУправления,
		|							_ДанныеПоручений.МестоХранения,
		|							_ДанныеПоручений.РасчетныйСчет
		|						ИЗ
		|							_ДанныеПоручений КАК _ДанныеПоручений)) КАК ОстаткиДенежныхСредствОстатки
		|		ПО _ДанныеПоручений.СчетДоверительногоУправления = ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления
		|			И _ДанныеПоручений.МестоХранения = ОстаткиДенежныхСредствОстатки.МестоХранения
		|			И _ДанныеПоручений.РасчетныйСчет = ОстаткиДенежныхСредствОстатки.РасчетныйСчет
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ДенежныеСредстваМНО.Остатки(
		|				&ТекущаяДата,
		|				Организация В
		|						(ВЫБРАТЬ
		|							_Экземпляры.Организация
		|						ИЗ
		|							_Экземпляры КАК _Экземпляры)
		|					И (СчетДоверительногоУправления, РасчетныйСчет) В
		|						(ВЫБРАТЬ
		|							_ДанныеПоручений.СчетДоверительногоУправления,
		|							_ДанныеПоручений.РасчетныйСчет
		|						ИЗ
		|							_ДанныеПоручений КАК _ДанныеПоручений)) КАК ДенежныеСредстваМНООстатки
		|		ПО _ДанныеПоручений.СчетДоверительногоУправления = ДенежныеСредстваМНООстатки.СчетДоверительногоУправления
		|			И _ДанныеПоручений.РасчетныйСчет = ДенежныеСредстваМНООстатки.РасчетныйСчет
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаПоручения,
		|	Срочно УБЫВ
		|ИТОГИ ПО
		|	Организация,
		|	ДатаПоручения";
#КонецОбласти
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	
	ВыборкаГруппировкаПоОрганизации = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаГруппировкаПоОрганизации.Следующий() Цикл 
	
		ВыборкаГруппировкаПоДате = ВыборкаГруппировкаПоОрганизации.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		ТекстПисьма = "";
	
		Пока ВыборкаГруппировкаПоДате.Следующий() Цикл
			
			Выборка = ВыборкаГруппировкаПоДате.Выбрать();
			
			ТекстПисьма = ТекстПисьма + ?(ТекстПисьма = "", "", Символы.ПС) + "<tr class=""top2""><td colspan=""14"">" + Формат(ВыборкаГруппировкаПоДате.ДатаПоручения, "ДФ=dd.MM.yyyy") + "</td></tr>";
		
			Пока Выборка.Следующий() Цикл
				
				ОписаниеКласса = "";
				
				Если Выборка.Срочно Тогда
					ОписаниеКласса = " class=""rapidly""";
				ИначеЕсли Выборка.Откуда = Справочники.МестаХранения.ММВБ_ДепозитыСЦК Тогда
					ОписаниеКласса = " class=""wait_for_approval""";	
				КонецЕсли;
						
				ТекстПисьма = ТекстПисьма + Символы.ПС 
					+ "<tr" + ОписаниеКласса + "><td>" + ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Выборка.Ссылка)
					+ "</td><td>" + СокрЛП(Выборка.КодБрокера)
					+ "</td><td>" + СокрЛП(Выборка.СчетДоверительногоУправления)
					+ "</td><td>" + Строка(Выборка.Сумма) 
					+ "</td><td>" + Выборка.Валюта 
					+ "</td><td>" + Выборка.Срочно
					+ "</td><td>" + ?(Выборка.Откуда = Справочники.МестаХранения.ММВБ_ДепозитыСЦК, "Требуется", "-----")
					+ "</td><td>" + Выборка.Откуда 
					+ "</td><td>" + Выборка.РасчетныйСчетПолучатель 
					+ "</td><td>" + ?(ЗначениеЗаполнено(Выборка.БрокерПолучатель), Выборка.БрокерПолучатель, "-----") 
					+ "</td><td>" + Выборка.МестоХраненияПолучатель 
					+ "</td><td>" + Строка(Выборка.СуммаОстаток) 
					+ "</td><td>" + Строка(Выборка.ОстатокМНО) 
					+ "</td><td>" + Строка(Выборка.НедостаточноДС) + "</td></tr>";
					
			КонецЦикла;
					
		КонецЦикла;
		
		ПараметрыОповещения = Новый Структура;
		ПараметрыОповещения.Вставить("Метод", Метод);
		ПараметрыОповещения.Вставить("Организация", ВыборкаГруппировкаПоОрганизации.Организация);
	    ПараметрыОповещения.Вставить("Тема", "Новые поручения на ПЕРЕВОД денежных средств. УК " + ВыборкаГруппировкаПоОрганизации.Организация + ".");
		ПараметрыОповещения.Вставить("Сообщения", РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("Текст, Параметр", ТекстПисьма, "УведомитьОНовыхПорученияхНаПереводДС")));	
		
		СформироватьОповещения(ПараметрыОповещения);  
		
		ВыборкаЗаданий = МВТ.Таблицы["_Экземпляры"].ПолучитьДанные().Выбрать();

		Пока ВыборкаЗаданий.Следующий() Цикл
			
			Если ВыборкаЗаданий.Организация <> ВыборкаГруппировкаПоОрганизации.Организация Тогда
				Продолжить;
			КонецЕсли;
			
			ТекущийСтатус = РаботаСДокументами.ПолучитьТекущийСтатусПорученияНаПереводДенежныхСредств(ВыборкаЗаданий.Поручение);

			Если ТекущийСтатус = Перечисления.СтатусыПорученийНаПереводДенежныхСредств.ГотовКОтправке Тогда
			
				РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(ВыборкаЗаданий.Идентификатор); 
				РегистрыСведений.СтатусыПорученийНаПереводДенежныхСредств.УстановитьСтатусПоручения(ВыборкаЗаданий.Поручение, Перечисления.СтатусыПорученийНаПереводДенежныхСредств.Отправлено);
				
			КонецЕсли;
			
		КонецЦикла; 
		
		ДопПараметрыСтатистики.Результат = ДопПараметрыСтатистики.Результат + ?(ЗначениеЗаполнено(ДопПараметрыСтатистики.Результат), ", ", "") 
			+ "Организация: " + ВыборкаГруппировкаПоОрганизации.Организация + ", Количество поручений: " + Выборка.Количество();
	
	КонецЦикла;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, ДопПараметрыСтатистики);
		
КонецПроцедуры 

Процедура СформироватьОповещенияОПорученияхОжидающихАкцепта(Метод, МВТ) 
	
	Механизм = Метаданные.Обработки.СогласованиеПредстоящихРасходов.Имя + "." + Метод;
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм);
	ДопПараметрыСтатистики = Новый Структура("Результат", "");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
			
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_Экземпляры.Организация КАК Организация,
		|	_Экземпляры.Поручение КАК Поручение
		|ПОМЕСТИТЬ _ГруппыЭкземпляров
		|ИЗ
		|	_Экземпляры КАК _Экземпляры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокументПоручение.Ссылка КАК Ссылка,
		|	ДокументПоручение.Организация КАК Организация,
		|	ДокументПоручение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДокументПоручение.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	ДокументПоручение.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	ДокументПоручение.Брокер КАК Брокер,
		|	ДокументПоручение.РасчетныйСчетПолучатель КАК РасчетныйСчетПолучатель,
		|	ДокументПоручение.Сумма КАК Сумма,
		|	ДокументПоручение.Валюта КАК Валюта
		|ИЗ
		|	_ГруппыЭкземпляров КАК _ГруппыЭкземпляров
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоручениеНаПереводДенежныхСредств КАК ДокументПоручение
		|		ПО _ГруппыЭкземпляров.Организация = ДокументПоручение.Организация
		|			И _ГруппыЭкземпляров.Поручение = ДокументПоручение.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыПорученийНаПереводДенежныхСредств.СрезПоследних(
		|				,
		|				ПоручениеНаПереводДенежныхСредств В
		|					(ВЫБРАТЬ
		|						_ГруппыЭкземпляров.Поручение
		|					ИЗ
		|						_ГруппыЭкземпляров КАК _ГруппыЭкземпляров)) КАК СтатусыПорученийНаПереводДенежныхСредствСрезПоследних
		|		ПО _ГруппыЭкземпляров.Поручение = СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.ПоручениеНаПереводДенежныхСредств
		|ГДЕ
		|	СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.ОжидаетАкцепта)
		|ИТОГИ ПО
		|	Организация";
#КонецОбласти
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	
	ВыборкаГруппировкаПоОрганизации = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТекстПисьма = "";
	
	Пока ВыборкаГруппировкаПоОрганизации.Следующий() Цикл 
				
		Выборка = ВыборкаГруппировкаПоОрганизации.Выбрать();
			
		Пока Выборка.Следующий() Цикл
								
			ТекстПисьма = ТекстПисьма + Символы.ПС 
				+ "<tr><td>" + ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Выборка.Ссылка)
				+ "</td><td>" + СокрЛП(Выборка.СчетДоверительногоУправления)
				+ "</td><td>" + ?(ЗначениеЗаполнено(Выборка.НомерДоговора), Выборка.НомерДоговора, "б/н") + " от " + Формат(Выборка.ДатаЗаключения, "ДФ=dd.MM.yyyy")
				+ "</td><td>" + Выборка.Брокер 
				+ "</td><td>" + Выборка.РасчетныйСчетПолучатель
				+ "</td><td>" + Строка(Выборка.Сумма) 
				+ "</td><td>" + Выборка.Валюта + "</td></tr>";
				
		КонецЦикла;
							
		ПараметрыОповещения = Новый Структура;
		ПараметрыОповещения.Вставить("Метод", Метод);
		ПараметрыОповещения.Вставить("Организация", ВыборкаГруппировкаПоОрганизации.Организация);
	    ПараметрыОповещения.Вставить("Тема", "Необходим акцепт для поручений на перевод денежных средств. УК " + ВыборкаГруппировкаПоОрганизации.Организация + ".");
		ПараметрыОповещения.Вставить("Сообщения", РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("Текст, Параметр", ТекстПисьма, "УведомитьОПорученияхОжидающихАкцепта")));	
		
		СформироватьОповещения(ПараметрыОповещения);  
		
		ВыборкаЗаданий = МВТ.Таблицы["_Экземпляры"].ПолучитьДанные().Выбрать();

		Пока ВыборкаЗаданий.Следующий() Цикл
			
			Если ВыборкаЗаданий.Организация <> ВыборкаГруппировкаПоОрганизации.Организация Тогда
				Продолжить;
			Конецесли;
			
			ТекущийСтатус = РаботаСДокументами.ПолучитьТекущийСтатусПорученияНаПереводДенежныхСредств(ВыборкаЗаданий.Поручение);

			Если ТекущийСтатус = Перечисления.СтатусыПорученийНаПереводДенежныхСредств.ОжидаетАкцепта Тогда			
				РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(ВыборкаЗаданий.Идентификатор);
			КонецЕсли;
						
		КонецЦикла;
		
		ДопПараметрыСтатистики.Результат = ДопПараметрыСтатистики.Результат + ?(ЗначениеЗаполнено(ДопПараметрыСтатистики.Результат), ", ", "") 
			+ "Организация: " + ВыборкаГруппировкаПоОрганизации.Организация + ", Количество поручений: " + Выборка.Количество();
	
	КонецЦикла;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, ДопПараметрыСтатистики);
		
КонецПроцедуры

Процедура СформироватьОповещения(Параметры)
	
	Для Каждого ТекСообщение Из Параметры.Сообщения Цикл
	
		Если Не ЗначениеЗаполнено(ТекСообщение.Текст) Тогда
			Продолжить;	
		КонецЕсли; 
		
		РеквизитыОповещения = Новый Структура("Организация, Тема", Параметры.Организация, Параметры.Тема);
		
		ТекстОписание =
			"<html>
			|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
			|	<style type=""text/css"">
			|		body     { font-family: ""Arial""; font-size: 12px; }
			|		table    { text-align: left; border-spacing: 0; border-collapse: collapse; }
			|		td       { border: 1px solid #CCC085; padding: 5px; }
			|		.top     { background: #F4ECC5; }
			|		.top2    { background: #F8F2D8; }
			|		.rapidly { background: #FFA07A; }
			|		.wait_for_approval { background: #E4F0DD; }
			|	</style>
			|</head><body>"; //wait_for_approval - ожидает акцепта спецдепозитария
			
		Если Параметры.Метод = "СформироватьОповещенияОСогласованныхПорученияхНаВыводДС" Тогда
				
			ТекстОписание = ТекстОписание +
				"<table cols=""8"">
			    |<tr class=""top""><td colspan=""6"">Поручение</td><td colspan=""2"">Счет доверительного управления</td></tr>
			    |<tr class=""top""><td>Ссылка</td><td>Вид поручения</td><td>Вывод всех активов</td><td>Сумма</td><td>Валюта</td><td>Период исполнения</td><td>Наименование</td><td>Код 1С</td></tr>";
					
							
		ИначеЕсли Параметры.Метод = "СформироватьОповещенияОНовыхПорученияхНаПереводДС" Тогда
			
			ТекстОписание = ТекстОписание +
				"<table cols=""14"">
				|<tr class=""top""><td rowspan=""2"">Поручение</td><td colspan=""2"">Счет доверительного управления</td><td rowspan=""2"">Сумма</td><td rowspan=""2"">Валюта</td><td rowspan=""2"">Срочно</td><td rowspan=""2"">Акцепт</td><td>ОТКУДА</td><td colspan=""3"">КУДА</td><td colspan=""2"">Остаток ДС на счете</td><td rowspan=""2"">Недостаточно ДС</td></tr>
				|<tr class=""top""><td>Код брокера</td><td>Наименование</td><td>Р/счет</td><td>Р/счет</td><td>Брокер</td><td>Место хранения</td><td>Всего</td><td>В МНО</td></tr>";
			
		ИначеЕсли Параметры.Метод = "СформироватьОповещенияОПорученияхОжидающихАкцепта" Тогда
			
			ТекстОписание = СтрЗаменить(ТекстОписание, "#CCC085", "#ACC8BD");
			
			ТекстОписание = ТекстОписание +
				"<table cols=""7"">
				|<tr class=""wait_for_approval""><td rowspan=""2"">Поручение</td><td colspan=""2"">Счет доверительного управления</td><td>ОТКУДА</td><td>КУДА</td><td rowspan=""2"">Сумма</td><td rowspan=""2"">Валюта</td></tr>
				|<tr class=""wait_for_approval""><td>Наименование</td><td>Договор</td><td>Брокер</td><td>Р/счет</td></tr>";
			
		Иначе
			
			ТекстОписание = ТекстОписание +
				"<table cols=""10"">
			    |<tr class=""top""><td colspan=""7"">Поручение</td><td colspan=""3"">Счет доверительного управления</td></tr>
			    |<tr class=""top""><td>Ссылка</td><td>Вид поручения</td><td>Вывод всех активов</td><td>Сумма</td><td>Валюта</td><td>Период исполнения</td><td>Назначение платежа</td><td>Наименование</td><td>Код 1С</td><td>Код у брокера</td></tr>";
			
		КонецЕсли;
		
		ТекСообщение.Текст = ТекстОписание + ТекСообщение.Текст + "</table></body></html>";
		
		РеквизитыОповещения.Вставить("Текст", ТекСообщение.Текст); 
		РеквизитыОповещения.Вставить(ТекСообщение.Параметр, Истина);
		
		Справочники.Оповещения.СформироватьОповещения("Обработка.СогласованиеПредстоящихРасходов", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
	КонецЦикла;
			
КонецПроцедуры

Функция ПолучитьДанныеПоПоручениям(Организация, Дата) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;	

#Область ТЕКСТ_ЗАПРОСА	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	СчетаДоверительногоУправления.Организация КАК Организация
		|ПОМЕСТИТЬ _ДействующиеСчетаДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &НачалоДня)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.Организация КАК Организация,
		|	НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.Валюта КАК Валюта,
		|	НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.РасчетныйСчет КАК РасчетныйСчет
		|ПОМЕСТИТЬ _СчетаИзНастроекУчетаДоходовПоЦеннымБумагам
		|ИЗ
		|	РегистрСведений.НастройкиУчетаДоходовПоЦеннымБумагам.СрезПоследних(
		|			&КонецДня,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_ДействующиеСчетаДУ.Ссылка
		|					ИЗ
		|						_ДействующиеСчетаДоверительногоУправления КАК _ДействующиеСчетаДУ)) КАК НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних
		|ГДЕ
		|	НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЕСТЬNULL(Поручение.Ссылка, ЗадолженностиПоДенежнымСредствамПоПоручениямОстаткиИОбороты.Основание) КАК Ссылка,
		|	ЗадолженностиПоДенежнымСредствамПоПоручениямОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаЗадолженностиОстаток
		|ПОМЕСТИТЬ _ПорученияИзОборотовРегистраЗадолженностиПоПоручениям
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствамПоПоручениям.ОстаткиИОбороты(
		|			&НачалоДня,
		|			&КонецДня,
		|			День,
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_ДействующиеСчетаДУ.Ссылка
		|					ИЗ
		|						_ДействующиеСчетаДоверительногоУправления КАК _ДействующиеСчетаДУ)) КАК ЗадолженностиПоДенежнымСредствамПоПоручениямОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоручениеНаДвижениеДенежныхСредств КАК Поручение
		|		ПО ЗадолженностиПоДенежнымСредствамПоПоручениямОстаткиИОбороты.Организация = Поручение.Организация
		|			И ЗадолженностиПоДенежнымСредствамПоПоручениямОстаткиИОбороты.СчетДоверительногоУправления = Поручение.СчетДоверительногоУправления
		|			И ЗадолженностиПоДенежнымСредствамПоПоручениямОстаткиИОбороты.Основание = Поручение.Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.Основание ССЫЛКА Документ.НачислениеЗадолженности
		|				ИЛИ ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.Основание ССЫЛКА Документ.РасчетНДФЛПайщиков
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.Основание
		|		ИНАЧЕ НачислениеЗадолженностиОснования.Ссылка
		|	КОНЕЦ КАК Ссылка,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.Основание КАК ОснованиеПоручения,
		|	СУММА(ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаРасход + ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаКонечныйОстаток) КАК СуммаЗадолженности
		|ПОМЕСТИТЬ _НачисленияЗадолженностиИзОборотов
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.ОстаткиИОбороты(
		|			&НачалоДня,
		|			&КонецДня,
		|			День,
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_ДействующиеСчетаДУ.Ссылка
		|					ИЗ
		|						_ДействующиеСчетаДоверительногоУправления КАК _ДействующиеСчетаДУ)
		|				И НЕ Аванс
		|				И ВидЗадолженности В (&ВидыЗадолженностиДляФормированияПоручений)) КАК ЗадолженностиПоДенежнымСредствамОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
		|		ПО ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.Основание = НачислениеЗадолженностиОснования.Основание
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.Основание ССЫЛКА Документ.НачислениеЗадолженности
		|				ИЛИ ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.Основание ССЫЛКА Документ.РасчетНДФЛПайщиков
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.Основание
		|		ИНАЧЕ НачислениеЗадолженностиОснования.Ссылка
		|	КОНЕЦ,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокПоручение.Ссылка КАК Ссылка,
		|	ДокПоручение.Организация КАК Организация,
		|	ДокПоручение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДокПоручение.ТипЗадолженности КАК ТипЗадолженности,
		|	ДокПоручение.СпособПередачи КАК СпособПередачи,
		|	ДокПоручение.Основание КАК Основание,
		|	ДокПоручение.Валюта КАК Валюта,
		|	ДокПоручение.Сумма КАК Сумма,
		|	ДокПоручение.ДатаИсполненияС КАК ДатаИсполненияС,
		|	ДокПоручение.ДатаИсполненияПо КАК ДатаИсполненияПо,
		|	ДокПоручение.РасчетныйСчет КАК РасчетныйСчет,
		|	ДокПоручение.РасчетныйСчетПолучатель КАК РасчетныйСчетПолучатель,
		|	ДокПоручение.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
		|	ДокПоручение.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
		|	ДокПоручение.ВыводВсехАктивов КАК ВыводВсехАктивов,
		|	ДокПоручение.ПоручениеНаПереводМеждуСчетамиДУ КАК ПоручениеНаПереводМеждуСчетамиДУ,
		|	ДокПоручение.Контрагент КАК Контрагент,
		|	_ПорученияИзОборотовРегистраЗадолженностиПоПоручениям.СуммаЗадолженностиОстаток КАК СуммаЗадолженностиОстаток,
		|	_ПорученияИзОборотовРегистраЗадолженностиПоПоручениям.СуммаЗадолженностиОстаток = 0
		|		И НЕ СписаниеЗадолженностейПоПоручению.Ссылка ЕСТЬ NULL КАК Исполнено,
		|	НЕ СписаниеЗадолженностейПоПоручению.Ссылка ЕСТЬ NULL КАК Отменено,
		|	НАЧАЛОПЕРИОДА(ЕСТЬNULL(СписаниеЗадолженностейПоПоручению.Дата, ДАТАВРЕМЯ(1, 1, 1)), ДЕНЬ) = &НачалоДня КАК ОтмененоВТекущемДне
		|ПОМЕСТИТЬ _Поручения
		|ИЗ
		|	Документ.ПоручениеНаДвижениеДенежныхСредств КАК ДокПоручение
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПорученияИзОборотовРегистраЗадолженностиПоПоручениям КАК _ПорученияИзОборотовРегистраЗадолженностиПоПоручениям
		|		ПО ДокПоручение.Ссылка = _ПорученияИзОборотовРегистраЗадолженностиПоПоручениям.Ссылка
		|			И (ДокПоручение.Проведен)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеЗадолженностейПоПоручению КАК СписаниеЗадолженностейПоПоручению
		|		ПО ДокПоручение.Ссылка = СписаниеЗадолженностейПоПоручению.Поручение
		|			И (СписаниеЗадолженностейПоПоручению.Проведен)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ДокПоручение.Ссылка,
		|	ДокПоручение.Организация,
		|	ДокПоручение.СчетДоверительногоУправления,
		|	ДокПоручение.ТипЗадолженности,
		|	ДокПоручение.СпособПередачи,
		|	ДокПоручение.Основание,
		|	ДокПоручение.Валюта,
		|	ДокПоручение.Сумма,
		|	ДокПоручение.ДатаИсполненияС,
