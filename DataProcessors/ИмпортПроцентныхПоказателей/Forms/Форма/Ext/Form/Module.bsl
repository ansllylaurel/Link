#Область Команды_формы

&НаКлиенте
Процедура ИмпортСредневзвешенныхПроцентныхСтавок(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ИмпортСредневзвешенныхПроцентныхСтавок");
	Попытка
		ВыполнитьИмпортСредневзвешенныхПроцентныхСтавок();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИмпортСредневзвешенныхПроцентныхСтавок()
	
	ОтчетОбИзменениях = ИмпортСредневзвешенныхПроцентныхСтавокНаСервере();
	
	Если ОтчетОбИзменениях <> Неопределено Тогда
		ОтчетОбИзменениях.Показать("Отчет об изменениях на " + Формат(Объект.ДатаЗагрузки, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Импорт завершен", ЭтаФорма.УникальныйИдентификатор);
	
КонецПроцедуры

