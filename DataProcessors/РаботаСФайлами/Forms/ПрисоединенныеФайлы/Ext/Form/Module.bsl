

#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ВладелецФайла", ВладелецФайла);
	УстановитьДоступность();
	ПрочитатьИОбновитьСписокФайлов();
	
КонецПроцедуры
	
#КонецОбласти 

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура ФайлыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьНаЧтение(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ФайлыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	Если Копирование Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Копирование файлов не поддерживается"); 
		Возврат;
	КонецЕсли; 
	
	ПоказатьВыборФайла();
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлыПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	ТекДанные = Элементы.Файлы.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
	
		ПараметрыФормы = Новый Структура("ДатаСоздания, ИдентификаторФайла, Наименование, Описание, Размер, Расширение");
		ПараметрыФормы.Вставить("ВладелецФайла", ЭтаФорма.ВладелецФайла);
		ЗаполнитьЗначенияСвойств(ПараметрыФормы, ТекДанные);
		ОткрытьФормуМодально("Обработка.РаботаСФайлами.Форма.ФормаФайла", ПараметрыФормы, ЭтаФорма);		
	
	КонецЕсли;
	ОбновитьСписокФайловКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлыПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекущиеДанные = Элементы.Файлы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = "";
	
	Если Элементы.Файлы.ВыделенныеСтроки.Количество() = 1 Тогда
		ТекстВопроса = СтрШаблон("Удалить файл ""%1""?", ТекущиеДанные.Наименование);
	Иначе
		ТекстВопроса = "Удалить выделенные файлы?";
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ВыделенныеСтроки", Элементы.Файлы.ВыделенныеСтроки);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПоказатьВопросДаНетЗавершение", ЭтаФорма, ДополнительныеПараметры);
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.ОК, "Да");
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, "Нет");
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки,,,Заголовок);
	
КонецПроцедуры

#КонецОбласти 

#Область Команды_формы

&НаКлиенте
Процедура ДобавитьСДиска(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ДобавитьСДиска");
	Попытка
		ПоказатьВыборФайла();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНаЧтение(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ОткрытьНаЧтение");
	Попытка
		ВыполнитьОткрытьНаЧтение(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОткрытьНаЧтение(ПараметрыСессии)
	
	ТекДанные = Элементы.Файлы.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ДанныеФайла = РаботаСФайловымХранилищем.ПолучитьФайл(ТекДанные.ИдентификаторФайла);
		Если ДанныеФайла <> Неопределено Тогда
			
			Каталог = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов();
			ИмяФайла = ДанныеФайла.Имя + "." + ДанныеФайла.Расширение;
			Маска = ДанныеФайла.Имя + " (*)." + ДанныеФайла.Расширение;
			НайденныеФайлы = НайтиФайлы(Каталог, ИмяФайла);
			
			Если НайденныеФайлы.Количество() > 0 Тогда
				ФайлыПоМаске = НайтиФайлы(Каталог, Маска);
				НомерКопии = ФайлыПоМаске.Количество() + 1;
				Путь = Каталог + СтрЗаменить(Маска, " (*).", " (" + НомерКопии + ").");
			Иначе
				Путь = Каталог + ИмяФайла;
			КонецЕсли; 
			
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеФайла.Адрес);	
			
			Попытка
			
				ДвоичныеДанные.Записать(Путь);
				ЗапуститьПриложение(Путь);	
			
			Исключение
				
				ТекстОшибки = "Не удалось открыть файл";
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				Описание = "";
				
				Если ТипЗнч(ИнформацияОбОшибке.Причина) = Тип("ИнформацияОбОшибке") Тогда
					Описание = ИнформацияОбОшибке.Причина.Описание;
				КонецЕсли; 
				
				Если Не ЗначениеЗаполнено(Описание) Тогда
					Описание = ОписаниеОшибки();
				КонецЕсли; 
				
				Предупреждение(ТекстОшибки + Символы.ПС + Описание);
				
			КонецПопытки; 		
			
			УдалитьИзВременногоХранилища(ДанныеФайла.Адрес);
		
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("Обновить");
	Попытка
		ОбновитьСписокФайловКлиент();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИзФайлаНаДиске(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ОбновитьИзФайлаНаДиске");
	Попытка
		ВыполнитьОбновитьИзФайлаНаДиске(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбновитьИзФайлаНаДиске(ПараметрыСессии)
	
	ТекущиеДанные = Элементы.Файлы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ПараметрыСессии.ТекстОшибки = "Не выбран файл для обновления";
		Возврат;	
	КонецЕсли; 
	
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("МножественныйВыбор", Ложь);
	ПараметрыВыбора.Вставить("НовыйФайл", Ложь);
	ПараметрыВыбора.Вставить("ИдентификаторФайла", ТекущиеДанные.ИдентификаторФайла);
	
	ПоказатьВыборФайла(ПараметрыВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНаДиск(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("СохранитьНаДиск");
	Попытка
		ВыполнитьСохранитьНаДиск(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСохранитьНаДиск(ПараметрыСессии)
	
	ПараметрыФайлов = Новый Массив;
	
	Для Каждого НомерСтроки Из Элементы.Файлы.ВыделенныеСтроки Цикл
		
		ТекДанные = Файлы.НайтиПоИдентификатору(НомерСтроки);
		ПараметрыФайла = Новый Структура;
		ПараметрыФайла.Вставить("Идентификатор", ТекДанные.ИдентификаторФайла);
		ПараметрыФайла.Вставить("Имя", ТекДанные.Наименование);
		ПараметрыФайла.Вставить("Расширение", ТекДанные.Расширение);
		ПараметрыФайлов.Добавить(ПараметрыФайла);
		
	КонецЦикла;
	
	Если ПараметрыФайлов.Количество() > 0 Тогда
	
		ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
		Если ДиалогВыбора.Выбрать() Тогда
			
			ПолучитьФайлыНаСервере(ПараметрыФайлов);
			Для каждого ПараметрыФайла Из ПараметрыФайлов Цикл
			
				ДвоичныеДанные = ПолучитьИзВременногоХранилища(ПараметрыФайла.Адрес);
				ДвоичныеДанные.Записать(ДиалогВыбора.Каталог + "\" + ПараметрыФайла.Имя + "." + ПараметрыФайла.Расширение);
			
			КонецЦикла; 
			
		КонецЕсли;
	
	КонецЕсли; 

КонецПроцедуры

&НаСервере
Процедура ПолучитьФайлыНаСервере(ПараметрыФайлов)

	Для каждого ПараметрыФайла Из ПараметрыФайлов Цикл
	
		ДанныеФайла = РаботаСФайловымХранилищем.ПолучитьФайл(ПараметрыФайла.Идентификатор);
		
		Если ДанныеФайла <> Неопределено Тогда
			ПараметрыФайла.Вставить("Адрес", ДанныеФайла.Адрес);
		КонецЕсли;
	
	КонецЦикла; 
		
КонецПроцедуры
 

#КонецОбласти 

#Область Добавление_файлов

&НаКлиенте
Процедура ВыборФайлаЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено Тогда
		
		Если ДополнительныеПараметры.НовыйФайл Тогда
			
			МассивФайлов = Новый Массив;
			
			Для Индекс = 0 По ВыбранныеФайлы.ВГраница() Цикл
				МассивФайлов.Добавить(Новый ОписаниеПередаваемогоФайла(ВыбранныеФайлы[Индекс]));
			КонецЦикла; 
			СоздатьФайлы(МассивФайлов);
			
		Иначе
			
			Путь = ВыбранныеФайлы[0];
			
			Попытка
			
				ДвоичныеДанные = Новый ДвоичныеДанные(Путь);
			
			Исключение
				
				ТекстОшибки = "Не удалось присоединить файл";
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				Описание = "";
				
				Если ТипЗнч(ИнформацияОбОшибке.Причина) = Тип("ИнформацияОбОшибке") Тогда
					Описание = ИнформацияОбОшибке.Причина.Описание;
				КонецЕсли; 
				
				Если Не ЗначениеЗаполнено(Описание) Тогда
					Описание = ОписаниеОшибки();
				КонецЕсли; 
				
				Предупреждение(ТекстОшибки + Символы.ПС + Описание);
				Возврат;
				
			КонецПопытки; 
			
			ПараметрыФайла = Новый Структура;
			ПараметрыФайла.Вставить("Путь", Путь);
			ПараметрыФайла.Вставить("Адрес", ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор));
			ПараметрыФайла.Вставить("ИдентификаторФайла", ДополнительныеПараметры.ИдентификаторФайла);
			ДобавитьВерсиюНаСервере(ПараметрыФайла);
			
		КонецЕсли;
		
		ОбновитьСписокФайловКлиент();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВыборФайла(ПараметрыВыбора = Неопределено) 
	
	Если ПараметрыВыбора = Неопределено Тогда
	
		ПараметрыВыбора = Новый Структура;
		ПараметрыВыбора.Вставить("МножественныйВыбор", Истина);
		ПараметрыВыбора.Вставить("НовыйФайл", Истина);
		ПараметрыВыбора.Вставить("ИдентификаторФайла", Неопределено);
	
	КонецЕсли; 
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.МножественныйВыбор = ПараметрыВыбора.МножественныйВыбор;
	
	Если ДиалогВыбора.Выбрать() Тогда
		
		ВыборФайлаЗавершение(ДиалогВыбора.ВыбранныеФайлы, ПараметрыВыбора);
		ОбновитьСписокФайловКлиент();		
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьФайлы(ПомещаемыеФайлы)

	ПомещенныеФайлы = Новый Массив;
	Попытка
	
		ПоместитьФайлы(ПомещаемыеФайлы, ПомещенныеФайлы,, Ложь, ЭтаФорма.УникальныйИдентификатор);
		СоздатьФайлыНаСервере(ЭтаФорма.ВладелецФайла, ПомещенныеФайлы);		
	
	Исключение
		
		ТекстОшибки = "Не удалось присоединить файл";
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Описание = "";
		
		Если ТипЗнч(ИнформацияОбОшибке.Причина) = Тип("ИнформацияОбОшибке") Тогда
			Описание = ИнформацияОбОшибке.Причина.Описание;
		КонецЕсли; 
		
		Если Не ЗначениеЗаполнено(Описание) Тогда
			Описание = ОписаниеОшибки();
		КонецЕсли; 
		
		Предупреждение(ТекстОшибки + Символы.ПС + Описание);
		
	КонецПопытки; 

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоздатьФайлыНаСервере(ВладелецФайла, ПомещенныеФайлы)

	Обработки.РаботаСФайлами.ПрисоединитьФайл(ВладелецФайла, ПомещенныеФайлы);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВерсиюНаСервере(ПараметрыФайла)

	ИдентификаторФайла = ПараметрыФайла.ИдентификаторФайла;
	
	Файл = Новый Файл(ПараметрыФайла.Путь);
	Расширение = СтрЗаменить(Файл.Расширение, ".", "");

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(ПараметрыФайла.Адрес);
	
	Попытка
		ИдентификаторВерсии = РаботаСФайловымХранилищем.ОбновитьФайл(ИдентификаторФайла, ПараметрыФайла.Адрес, Расширение);
		ЗаписьЖурналаРегистрации("Файловое хранилище.Добавление версии", 
			УровеньЖурналаРегистрации.Информация, 
			ЭтаФорма.ВладелецФайла.Метаданные(), 
			ЭтаФорма.ВладелецФайла, 
			"Добавлена версия: """ + Файл.Имя + """");
	Исключение
		ТекстОшибки = СтрШаблон("Не удалось обновить файл %1 в файловом хранилище из-за ошибки:%2", 
			ПараметрыФайла.Путь, 
			Символы.ПС + ОписаниеОшибки());
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецПопытки;

	УдалитьИзВременногоХранилища(ПараметрыФайла.Адрес); 

КонецПроцедуры 

#КонецОбласти 

#Область Чтение_файлов

&НаКлиенте
Процедура ОбновитьСписокФайловКлиент(ИдентификаторФайла = Неопределено)
	
	Если ИдентификаторФайла <> Неопределено Тогда
		ТекущийИдентификаторФайла = ИдентификаторФайла;
	ИначеЕсли Элементы.Файлы.ТекущиеДанные <> Неопределено Тогда
		ТекущийИдентификаторФайла = Элементы.Файлы.ТекущиеДанные.ИдентификаторФайла;
	КонецЕсли;
	
	ПрочитатьИОбновитьСписокФайлов();
	
	// Восстановим положение в списке.
	Для Каждого Строка Из Файлы Цикл
		Если Строка.ИдентификаторФайла = ТекущийИдентификаторФайла Тогда
			Элементы.Файлы.ТекущаяСтрока = Строка.ПолучитьИдентификатор();
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Оповестить("Запись_Файл", Новый Структура, ЭтаФорма.ВладелецФайла);
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьИОбновитьСписокФайлов()
	
	Файлы.Очистить();
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.ВладелецФайла) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеФайлов = РаботаСФайловымХранилищем.ПолучитьСписокФайлов(ЭтаФорма.ВладелецФайла);
	Для каждого ДанныеФайла Из ДанныеФайлов Цикл
		
		НоваяСтрока = ЭтаФорма.Файлы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеФайла);
		НоваяСтрока.ПредставлениеРазмера = РаботаСФайловымХранилищем.КраткоеПредставлениеРазмера(НоваяСтрока.Размер);
	
	КонецЦикла;
	
КонецПроцедуры
	
#КонецОбласти 

#Область Служебные_процедуры_и_функции

&НаКлиенте
Процедура ПоказатьВопросДаНетЗавершение(Результат, ПараметрыОповещения) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда
		ПометитьНаУдаление(ПараметрыОповещения.ВыделенныеСтроки);
		ОбновитьСписокФайловКлиент();
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ПометитьНаУдаление(Знач ВыделенныеСтроки)
	
	Для Каждого НомерСтроки Из ВыделенныеСтроки Цикл
		Данные = Файлы.НайтиПоИдентификатору(НомерСтроки);
		РаботаСФайловымХранилищем.УдалитьФайл(Данные.ИдентификаторФайла);
		РаботаСФайловымХранилищем.ПриИзмененииПрисоединенныхФайлов(ВладелецФайла);
		ИмяФайла = Данные.Наименование + ?(ЗначениеЗаполнено(Данные.Расширение), "." + Данные.Расширение, "");
		ЗаписьЖурналаРегистрации("Файловое хранилище.Удаление файла", 
			УровеньЖурналаРегистрации.Информация, 
			ЭтаФорма.ВладелецФайла.Метаданные(), 
			ЭтаФорма.ВладелецФайла, 
			"Удален файл: """ + ИмяФайла + """");
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступность()

	ПользователюРазрешеноИзменятьФайлы = ПользователюРазрешеноИзменятьФайлы(ВладелецФайла);
	ДоступНаИзменение = ЗначениеЗаполнено(ВладелецФайла) И ПравоДоступа("Изменение", ВладелецФайла.Метаданные()) И ПользователюРазрешеноИзменятьФайлы;
	
	Элементы.ДобавитьСДиска.Доступность 		= ДоступНаИзменение;
	Элементы.ОбновитьИзФайлаНаДиске.Доступность = ДоступНаИзменение;
	Элементы.Удалить.Доступность 				= ДоступНаИзменение;
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлыПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ФайлыПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	Если ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Перемещение Тогда
		
		МассивФайлов = Новый Массив;
		
		Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив") 
			И ТипЗнч(ПараметрыПеретаскивания.Значение[0]) = Тип("Файл") Тогда
			
			Для каждого Файл Из ПараметрыПеретаскивания.Значение Цикл
				МассивФайлов.Добавить(Новый ОписаниеПередаваемогоФайла(Файл.ПолноеИмя));
			КонецЦикла; 
			
			Подстрока = "выбранные файлы";
			
		ИначеЕсли ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Файл") Тогда
			МассивФайлов.Добавить(Новый ОписаниеПередаваемогоФайла(ПараметрыПеретаскивания.Значение.ПолноеИмя));
			Файл = Новый Файл(ПараметрыПеретаскивания.Значение.ПолноеИмя);
			Подстрока = СтрШаблон("файл '%1'", Файл.Имя);
		КонецЕсли;
		
		ТекстВопроса = СтрШаблон("Присоединить %1 к '%2'", Подстрока, ЭтаФорма.ВладелецФайла); 
		
		Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		
			СоздатьФайлы(МассивФайлов);
			ОбновитьСписокФайловКлиент();			
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПользователюРазрешеноИзменятьФайлы(ВладелецФайла)

	Результат = Истина;
	
	Если Не РольДоступна("ПолныеПрава") 
		И (ТипЗнч(ВладелецФайла) = Тип("ДокументСсылка.ИсходящийДокумент")
			Или ТипЗнч(ВладелецФайла) = Тип("ДокументСсылка.ВходящийДокумент")) Тогда
	
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ГруппыПользователей.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыПользователей КАК ГруппыПользователей
			|		ПО ГруппыПользователейСостав.Ссылка = ГруппыПользователей.Ссылка
			|			И (ГруппыПользователейСостав.Пользователь = &Пользователь)
			|			И (ГруппыПользователей.Организация = &Организация)
			|			И (ГруппыПользователей.Родитель = &Родитель)";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Родитель", ОбщегоНазначения.ПолучитьИменованныйОбъект("ИзменениеФайловВходящихИсходящихДокументов"));
		Запрос.УстановитьПараметр("Организация", ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация"));
		Запрос.УстановитьПараметр("Пользователь", ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущийПользователь"));
		
		Результат = Не Запрос.Выполнить().Пустой();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти 

