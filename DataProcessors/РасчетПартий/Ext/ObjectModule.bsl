				Если СтрокаПриходныхПартий.УчетныйАктивЕПС.Родитель = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток									// из СС
					И (СтрокаРеклассификации.УчетныйАктивЕПСРодитель = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСД											// в АС
						ИЛИ СтрокаРеклассификации.УчетныйАктивЕПСРодитель = Справочники.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения) Тогда    // тоже в АС
					// СС -> АС
					// дооценить старую партию, если нужно
					НовоеДвижениеПереоценки = ЭтотОбъект.РассчитанныеПартии.Добавить();
