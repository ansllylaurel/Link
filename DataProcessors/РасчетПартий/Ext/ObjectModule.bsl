						//		СтрокаПриходныхПартий.ИндексацияНоминала = СтрокаПриходныхПартий.ИндексацияНоминала + НовоеДвижение.ИндексацияНоминала;
						//		СтрокаПриходныхПартий.ИндексацияНоминалаЗаВремяВладения = СтрокаПриходныхПартий.ИндексацияНоминалаЗаВремяВладения + НовоеДвижение.ИндексацияНоминалаЗаВремяВладения;
						//	КонецЕсли;
						//КонецЕсли;
						
						НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
						
						ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаПриходныхПартий);
						НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Расход;
						НовоеДвижение.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
						НовоеДвижение.Период = ВыборкаДетальныеЗаписи.Период;
						НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
						
						//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.СписаниеПартии;
						
						Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.СнятиеЦеннойБумагиСУчета") Тогда
							ПриходныеПартииКУдалению.Добавить(СтрокаПриходныхПартий); // снятие удаляет партию
						ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ВыбытиеСтоимостиЦенныхБумагПоБухгалтерскомуУчету") Тогда
							НовоеДвижение.Количество = 0; // а выбытие не удаляет, еще и не списывает количество
							
							Для Каждого Ресурс из РесурсыПартий Цикл // спишем суммы с остатков
								Если Ресурс = "Количество" Тогда 
									Продолжить; 
								КонецЕсли;
								СтрокаПриходныхПартий[Ресурс] = 0;	
							КонецЦикла;	
							
						КонецЕсли;
						
					КонецЦикла;
						
					Для каждого СтрокаПриходныхПартийКУдалению Из ПриходныеПартииКУдалению Цикл
						ПриходныеПартии.Удалить(СтрокаПриходныхПартийКУдалению);
					КонецЦикла;
					
					#КонецОбласти
					
				ИначеЕсли НЕ ЭтоРынокОблигаций
							И ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги")
							И ВариантПогашения = Перечисления.ВариантыОтраженияДебиторскойЗадолженностиПриПолномПогашенииОблигаций.НаМоментСписания Тогда
							
					Продолжить;
					
				ИначеЕсли НЕ ЭтоРынокОблигаций
							И ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.СписаниеЦеннойБумаги")
							И ВариантПогашения = Перечисления.ВариантыОтраженияДебиторскойЗадолженностиПриПолномПогашенииОблигаций.НаМоментПогашения Тогда
							
					Продолжить;
					
				ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.Оплата") Тогда
					
