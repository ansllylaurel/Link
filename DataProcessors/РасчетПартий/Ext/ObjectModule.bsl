Процедура РассчитатьПартии(Отказ, НастройкиПоВидуУчета = Неопределено) Экспорт
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект);
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".РассчитатьПартии";
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	СчетДоверительногоУправленияДляУчета = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления);
	СписокСтратегий = Справочники.СчетаДоверительногоУправления.ПолучитьМассивСчетовПоДоговоруДУ(ЭтотОбъект.СчетДоверительногоУправления);
	
	// по собственным счетам вводы/выводы могут быть только между портфелями и в учет попадать не должны
	ВключатьВводыВыводы = (ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> Перечисления.ВидыДоговоровДоверительногоУправления.Собственный);
	
	Если ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		РассчитатьПартииЕПС(Отказ);
	Иначе
		РассчитатьПартииБУНУ(Отказ, НастройкиПоВидуУчета);
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);

КонецПроцедуры

Функция ПолучитьСуммуВВалютеУчетаДляПоставки(Партия, СтрокаПартии, Отказ)

	Тикет = Партия.Основание;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(СделкаЦенныеБумаги.Сумма) КАК Сумма,
		|	СУММА(СделкаЦенныеБумаги.СуммаКупона) КАК СуммаКупона,
		|	ВЫБОР
		|		КОГДА СделкаЦенныеБумаги.СтрокаПартии = &СтрокаПартии
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СтрокаПартии
		|ПОМЕСТИТЬ СуммыТикета
		|ИЗ
		|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|ГДЕ
		|	СделкаЦенныеБумаги.Ссылка = &Тикет
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА СделкаЦенныеБумаги.СтрокаПартии = &СтрокаПартии
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствам.ВидДвижения КАК ВидДвижения,
		|	ЗадолженностиПоДенежнымСредствам.Сумма / (СуммаНашаБумага.Сумма + ЕСТЬNULL(СуммаНеНашиБумаги.Сумма, 0)) * СуммаНашаБумага.Сумма КАК Сумма,
		|	ВЫБОР
		|		КОГДА СуммаНашаБумага.СуммаКупона = 0
		|			ТОГДА 0
		|		ИНАЧЕ ЗадолженностиПоДенежнымСредствам.СуммаКупона / (СуммаНашаБумага.СуммаКупона + ЕСТЬNULL(СуммаНеНашиБумаги.СуммаКупона, 0)) * СуммаНашаБумага.СуммаКупона
		|	КОНЕЦ КАК СуммаКупона,
		|	ЗадолженностиПоДенежнымСредствам.Регистратор КАК Регистратор,
		|	КурсыВалют.Курс КАК Курс
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (НАЧАЛОПЕРИОДА(ЗадолженностиПоДенежнымСредствам.Период, ДЕНЬ) = КурсыВалют.Период)
		|			И (КурсыВалют.Валюта = &ВалютаСделки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ СуммыТикета КАК СуммаНашаБумага
		|		ПО (СуммаНашаБумага.СтрокаПартии = 1)
		|		ЛЕВОЕ СОЕДИНЕНИЕ СуммыТикета КАК СуммаНеНашиБумаги
		|		ПО (СуммаНеНашиБумаги.СтрокаПартии = 0)
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Основание = &Тикет
		|	И ЗадолженностиПоДенежнымСредствам.Период >= &ДатаТикета
		|	И ЗадолженностиПоДенежнымСредствам.Период < &ДатаПоставки
		|	И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = &ВидЗадолженности";
	
	Запрос.УстановитьПараметр("Тикет", Тикет);
	Запрос.УстановитьПараметр("ВидЗадолженности", Справочники.ВидыЗадолженности.ПоСделке);
	Запрос.УстановитьПараметр("СтрокаПартии", СтрокаПартии);
	Запрос.УстановитьПараметр("ВалютаСделки", Тикет.ВалютаСделки);
	Запрос.УстановитьПараметр("ДатаТикета", Тикет.Дата);
	Запрос.УстановитьПараметр("ДатаПоставки", Партия.Дата);
	
	СуммаПоТикету = 0;
	СуммаОплачено = 0;
	СуммаОплаченоВВалютеУчета = 0;
	СуммаКупонаПоТикету = 0;
	СуммаКупонаОплачено = 0;
	СуммаКупонаОплаченоВВалютеУчета = 0;
	
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
		    СуммаПоТикету = СуммаПоТикету + ВыборкаДетальныеЗаписи.Сумма;
			СуммаКупонаПоТикету = СуммаКупонаПоТикету + ВыборкаДетальныеЗаписи.СуммаКупона;
		Иначе
			СуммаОплачено = СуммаОплачено + ВыборкаДетальныеЗаписи.Сумма;
			СуммаОплаченоВВалютеУчета = СуммаОплаченоВВалютеУчета + ВыборкаДетальныеЗаписи.Сумма * ВыборкаДетальныеЗаписи.Курс;
			СуммаКупонаОплачено = СуммаКупонаОплачено + ВыборкаДетальныеЗаписи.СуммаКупона;
			СуммаКупонаОплаченоВВалютеУчета = СуммаКупонаОплаченоВВалютеУчета + ВыборкаДетальныеЗаписи.СуммаКупона * ВыборкаДетальныеЗаписи.Курс;
		КонецЕсли;
	КонецЦикла;
	
	// неоплаченную сумму считаем по курсу на момент поставки
	// а все, что оплачено считаем по курсу на дату оплаты
	СуммаВВалютеУчета = СуммаОплаченоВВалютеУчета + РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаПоТикету - СуммаОплачено, Тикет.ВалютаСделки, ЭтотОбъект.Организация, Партия.Дата, Отказ);
	СуммаКупонаВВалютеУчета = СуммаКупонаОплаченоВВалютеУчета + РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКупонаПоТикету - СуммаКупонаОплачено, Тикет.ВалютаСделки, ЭтотОбъект.Организация, Партия.Дата, Отказ);

	Результат = Новый Структура();
	Результат.Вставить("СуммаВВалютеУчета",СуммаВВалютеУчета);
	Результат.Вставить("СуммаКупонаВВалютеУчета",СуммаКупонаВВалютеУчета);
	
	Возврат Результат;
		
КонецФункции //

Процедура РассчитатьИЗаписатьПартии(Отказ) Экспорт

	СчетДоверительногоУправленияДляУчета = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления);
	СписокСтратегий = Справочники.СчетаДоверительногоУправления.ПолучитьМассивСчетовПоДоговоруДУ(ЭтотОбъект.СчетДоверительногоУправления);
	// по собственным счетам вводы/выводы могут быть только между портфелями и в учет попадать не должны
	ВключатьВводыВыводы = (ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> Перечисления.ВидыДоговоровДоверительногоУправления.Собственный);
	
	НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.БухПартииЦенныхБумаг");
	ЭлементБлокировки.УстановитьЗначение("Организация", ЭтотОбъект.Организация);
	ЭлементБлокировки.УстановитьЗначение("ВидУчета", ЭтотОбъект.ВидУчета);
	ЭлементБлокировки.УстановитьЗначение("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО");
	ЭлементБлокировки.УстановитьЗначение("Организация", ЭтотОбъект.Организация);
	ЭлементБлокировки.УстановитьЗначение("ВидУчета", ЭтотОбъект.ВидУчета);
	ЭлементБлокировки.УстановитьЗначение("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.БухПартииЦенныхБумагПроданныеВРепо");
	ЭлементБлокировки.УстановитьЗначение("Организация", ЭтотОбъект.Организация);
	ЭлементБлокировки.УстановитьЗначение("ВидУчета", ЭтотОбъект.ВидУчета);
	ЭлементБлокировки.УстановитьЗначение("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.БухПартииЦенныхБумагКПолучению");
	ЭлементБлокировки.УстановитьЗначение("Организация", ЭтотОбъект.Организация);
	ЭлементБлокировки.УстановитьЗначение("ВидУчета", ЭтотОбъект.ВидУчета);
	ЭлементБлокировки.УстановитьЗначение("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.БухПартииСрочныхКонтрактов");
	ЭлементБлокировки.УстановитьЗначение("Организация", ЭтотОбъект.Организация);
	ЭлементБлокировки.УстановитьЗначение("ВидУчета", ЭтотОбъект.ВидУчета);
	ЭлементБлокировки.УстановитьЗначение("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
	Блокировка.Заблокировать();
	
	ЭтотОбъект.ВариантРасчета = Перечисления.ВариантыРасчетаПартий.ПолныйРасчет;
	
	РассчитатьПартии(Отказ);
	
	Если Отказ Тогда
		ОтменитьТранзакцию();
		Возврат;
	КонецЕсли;

	РегистрыДляЗаписи = Новый Соответствие;
	
	РегистрыДляЗаписи.Вставить("БухПартииЦенныхБумаг",					ЭтотОбъект.РассчитанныеПартии);
	РегистрыДляЗаписи.Вставить("БухПартииЦенныхБумагКПолучению",		ЭтотОбъект.РассчитанныеПартииКПоступлению);
	РегистрыДляЗаписи.Вставить("БухПартииЦенныхБумагКупленныеПоРЕПО",	ЭтотОбъект.РассчитанныеПартииОбратноеРЕПО);
	РегистрыДляЗаписи.Вставить("БухПартииЦенныхБумагПроданныеВРепо",	ЭтотОбъект.РассчитанныеПартииПрямоеРЕПО);
	РегистрыДляЗаписи.Вставить("БухПартииСрочныхКонтрактов",			ЭтотОбъект.РассчитанныеПартииСрочныеКонтракты);

	Для каждого Элемент Из РегистрыДляЗаписи Цикл
		ЗаписатьПартии(Элемент.Ключ, Элемент.Значение, Отказ);
		Если Отказ Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ЗаписатьНастройки(Отказ);
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

Функция ИндексацияНоминала(Регистратор, Период, СтрокаПриходныхПартий, Количество, УчитыватьИндексациюОтдельно, Отказ)
	
	Если СтрокаПриходныхПартий.Рынок <> Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ СтрокаПриходныхПартий.ЦеннаяБумага.ИндексируемыйНоминал Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Облигация = СтрокаПриходныхПартий.ЦеннаяБумага;
		
	КоэффициентИндексации = Количество/СтрокаПриходныхПартий.Количество;
	
	НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();

	НовоеДвижение.Рынок = 			СтрокаПриходныхПартий.Рынок;
	НовоеДвижение.ЦеннаяБумага = 	СтрокаПриходныхПартий.ЦеннаяБумага;
	НовоеДвижение.Партия = 			СтрокаПриходныхПартий.Партия;
	НовоеДвижение.СтрокаПартии = 	СтрокаПриходныхПартий.СтрокаПартии;
	
	НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Приход;
	НовоеДвижение.Регистратор = Регистратор;
	НовоеДвижение.Период = Период;
	НовоеДвижение.СтрокаКорзиныЦенныхБумаг = СтрокаПриходныхПартий.СтрокаПартии;
	
	//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.ПереоценкаИНачислениеПроцентов;
	
	Если ТипЗнч(СтрокаПриходныхПартий.Партия) = Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда
		ДатаПокупки = СтрокаПриходныхПартий.ДатаПокупки;
	Иначе
		ДатаПокупки = СтрокаПриходныхПартий.Партия.Дата;
	КонецЕсли;
	
	НовоеДвижение.ИндексацияНоминалаЗаВремяВладения = (Справочники.Облигации.ПолучитьНоминал(Облигация, Период) - Справочники.Облигации.ПолучитьНоминал(Облигация, ДатаПокупки)) * Количество
										- СтрокаПриходныхПартий.ИндексацияНоминалаЗаВремяВладения * КоэффициентИндексации;
	
	Возврат НовоеДвижение;
	
КонецФункции

Функция ПолучитьОтменыСделок_БУНУ()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОперацииСЦеннымиБумагами.Регистратор КАК Регистратор,
		|	ОперацииСЦеннымиБумагами.Основание КАК Основание,
		|	ОперацииСЦеннымиБумагами.ДатаОперации КАК ДатаОперации
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|ГДЕ
		|	ОперацииСЦеннымиБумагами.Организация = &Организация
		|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления В(&СписокСтратегий)
		|	И ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Регистратор) = ТИП(Документ.ОтменаСделки)
		|	И ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &НачалоПериода И &КонецПериода";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.КонецПериода));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
	Запрос.УстановитьПараметр("СписокСтратегий", СписокСтратегий);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции 

Функция ПолучитьПартииПроданныеВРЕПО_БУНУ()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.Рынок КАК Рынок,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.ПродажаРЕПО КАК ПродажаРЕПО,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.СтрокаПродажиРЕПО КАК СтрокаПродажиРЕПО,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.КоличествоОстаток КАК Количество,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.СтоимостьПокупкиОстаток КАК СтоимостьПокупки,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.СтоимостьПокупкиКупонаОстаток КАК СтоимостьПокупкиКупона,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.РасходыПриПокупкеВСтоимостиОстаток КАК РасходыПриПокупкеВСтоимости,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.РасходыПриПокупкеСНачалаГодаОстаток КАК РасходыПриПокупкеСНачалаГода,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.ПереоценкаВСтоимостиОстаток КАК ПереоценкаВСтоимости,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.ПереоценкаКупонаВСтоимостиОстаток КАК ПереоценкаКупонаВСтоимости,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.СтоимостьОстаток КАК Стоимость,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.СтоимостьКупонаОстаток КАК СтоимостьКупона,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.ПереоценкаОстаток КАК Переоценка,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.ПереоценкаКупонаОстаток КАК ПереоценкаКупона,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.ПродажаРЕПО.Дата КАК ПериодРЕПО,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.Партия.Дата КАК Период,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.ПродажаРЕПО.МоментВремени КАК МоментВремениРЕПО,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.Партия.МоментВремени КАК МоментВремени,
