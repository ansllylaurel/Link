							И НастройкиПоВидуУчета.ПереоцениватьПриобретенныеАктивы 
							И (ТипЗнч(ВыборкаДетальныеЗаписи.Партия) = Тип("ДокументСсылка.Сделка")
								ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Партия) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке")
								ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Партия) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг")) Тогда
								
							ПереоценкаДляПокупки = ПереоценкиДляОпераций.НайтиСтроки(Новый Структура("Ссылка,ЦеннаяБумага,ВидДвижения", 
														ВыборкаДетальныеЗаписи.Партия, 
														ЦеннаяБумага, 
														Перечисления.ВидыДвижений.Приход));
							
							Если ПереоценкаДляПокупки.Количество() <> 1 Тогда
								ТекстСообщения = СтрШаблон("Не удалось определить цену бумаги %1 для покупки %2", ЦеннаяБумага, ВыборкаДетальныеЗаписи.Партия); 
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
								Возврат;
							КонецЕсли;
							
							СуммаРынок = ПереоценкаДляПокупки[0].СуммаРынок;
							СуммаРынокВВалютеУчета = ПереоценкаДляПокупки[0].СуммаРынокВВалютеУчета;
							
							НовоеДвижениеПереоценки = ЭтотОбъект.РассчитанныеПартии.Добавить();
							
							ЗаполнитьЗначенияСвойств(НовоеДвижениеПереоценки, ВыборкаДетальныеЗаписи, "Регистратор,Период,Рынок,ЦеннаяБумага,Партия,СтрокаПартии");
							НовоеДвижениеПереоценки.ВидДвижения = Перечисления.ВидыДвижений.Приход;
							НовоеДвижениеПереоценки.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
							
							//НовоеДвижениеПереоценки.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.ПереоценкаИНачислениеПроцентов;
							
							Если УчитыватьПереоценкуОтдельно Тогда
								
								НовоеДвижениеПереоценки.Переоценка				= СуммаРынок - (ПриходнаяПартия.Стоимость + ПриходнаяПартия.Переоценка); 
								НовоеДвижениеПереоценки.ПереоценкаВВалютеУчета	= СуммаРынокВВалютеУчета - (ПриходнаяПартия.СтоимостьВВалютеУчета + ПриходнаяПартия.ПереоценкаВВалютеУчета); 
								
								ПриходнаяПартия.Переоценка						= ПриходнаяПартия.Переоценка + НовоеДвижениеПереоценки.Переоценка;
								ПриходнаяПартия.ПереоценкаВВалютеУчета			= ПриходнаяПартия.ПереоценкаВВалютеУчета + НовоеДвижениеПереоценки.ПереоценкаВВалютеУчета;
								
							Иначе
								
								НовоеДвижениеПереоценки.Стоимость				= СуммаРынок - ПриходнаяПартия.Стоимость; 
								НовоеДвижениеПереоценки.СтоимостьВВалютеУчета	= СуммаРынокВВалютеУчета - ПриходнаяПартия.СтоимостьВВалютеУчета; 
								НовоеДвижениеПереоценки.ПереоценкаВСтоимости	= НовоеДвижениеПереоценки.Стоимость;
								
								ПриходнаяПартия.Стоимость						= ПриходнаяПартия.Стоимость + НовоеДвижениеПереоценки.Стоимость;
								ПриходнаяПартия.СтоимостьВВалютеУчета			= ПриходнаяПартия.СтоимостьВВалютеУчета + НовоеДвижениеПереоценки.СтоимостьВВалютеУчета;
								ПриходнаяПартия.ПереоценкаВСтоимости			= ПриходнаяПартия.ПереоценкаВСтоимости + НовоеДвижениеПереоценки.ПереоценкаВСтоимости;
								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
					#КонецОбласти
	
				ИначеЕсли (ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги")
					И (РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].ВидПогашения <> Перечисления.ВидыПогашения.ЧастичноеПогашение))
					И ЭтоРынокОблигаций Тогда 
					
					#Область ПогашениеОблигацииНеЧастичное
					
					Если НастройкиПоВидуУчета.МетодОпределенияДоходовИРасходов = Перечисления.МетодыОпределенияДоходовИРасходов.Кассовый Тогда // при кассовом методе погашение ничего не делает
						Продолжить;
					КонецЕсли;
					
					ЭтоОферта = РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].ВидПогашения = Перечисления.ВидыПогашения.Оферта;
					КоличествоОферты = РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].Количество;
					
					
					СуммаКупонаНаОднуОблигацию = РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].СуммаКупона / РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].Количество;
					
					Если ВалютаНоминала = ВалютаУчета Тогда
						СуммаКупонаНаОднуОблигациюВВалютеУчета = СуммаКупонаНаОднуОблигацию;
					ИначеЕсли РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].ВалютаОплаты = ВалютаУчета Тогда
						// погашение купона по валютной бумаге причем сумма в рублях... маразм, блин!
						СуммаКупонаНаОднуОблигациюВВалютеУчета = СуммаКупонаНаОднуОблигацию;
						
						СуммаКупонаНаОднуОблигацию = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(ВыборкаДетальныеЗаписи.ЦеннаяБумага, НачалоДня(ВыборкаДетальныеЗаписи.Период), СчетДоверительногоУправленияДляУчета, Истина);
						
						КурсПерекурсовки = СуммаКупонаНаОднуОблигациюВВалютеУчета / СуммаКупонаНаОднуОблигацию;
					Иначе
						
						СуммаКупонаНаОднуОблигациюВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].СуммаКупона, ВалютаНоминала, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период, Отказ) / РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].Количество;
						
					КонецЕсли;
					
					
					Если НастройкиПоВидуУчета.ПереоцениватьАктивыПередПродажей Тогда
					
						ПереоценкаПередПродажами = ПереоценкиДляОпераций.НайтиСтроки(Новый Структура("Ссылка,ЦеннаяБумага,ВидДвижения",
															ВыборкаДетальныеЗаписи.Регистратор,
															ВыборкаДетальныеЗаписи.ЦеннаяБумага,
															Перечисления.ВидыДвижений.ПустаяСсылка()));
															
						Если ПереоценкаПередПродажами.Количество() <> 1 Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить цену бумаги перед продажей:" + Строка(ВыборкаДетальныеЗаписи.Регистратор) + " / "+ Строка(ВыборкаДетальныеЗаписи.ЦеннаяБумага));
							Отказ = Истина;
						КонецЕсли;
						
						СуммаРынокВсего = ПереоценкаПередПродажами[0].СуммаРынок;
						СуммаРынокВВалютеУчетаВсего = ПереоценкаПередПродажами[0].СуммаРынокВВалютеУчета;
						ОбщееКоличество = ПереоценкаПередПродажами[0].Количество;
					
					КонецЕсли;
					
					
					Для каждого СтрокаПриходныхПартий Из ПриходныеПартии Цикл //Спишем со всех приходных партий все купоны
						
						Если ЭтоОферта И КоличествоОферты = 0 Тогда
							Прервать;
						КонецЕсли;
						
						НовоеДвижениеПерекурсовки = Перекурсовка(ВыборкаДетальныеЗаписи.Регистратор, ЭтотОбъект.РассчитанныеПартии, ВыборкаДетальныеЗаписи.Период, СтрокаПриходныхПартий, СтрокаПриходныхПартий.Количество, ВыборкаДетальныеЗаписи.СтрокаПартии,,,, Отказ);
						НовоеДвижениеПерекурсовки.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
						
						Если Отказ Тогда
							Возврат;
						КонецЕсли;
						
						Если ДоначислятьКупонДоПолнойСтоимостиПередПродажейИПогашением Тогда
							
							_ОтражатьНаПереоценкеПолнуюСуммуКупон = ОтражатьНаПереоценкеПолнуюСуммуКупон;
							// хардкод для СНГ - согласно письму фонда, СНГ прекращает с 1го января 2020года учитывать УНКД отдельно и начинает учитывать "как все"
							Если ЭтоКлиентСНГ Тогда
							
								Если СтрокаПриходныхПартий.ДатаПокупки < '20200101' Тогда
									_ОтражатьНаПереоценкеПолнуюСуммуКупон = Истина;
								Иначе
									_ОтражатьНаПереоценкеПолнуюСуммуКупон = Ложь;
								КонецЕсли;
							
							КонецЕсли;
							// хардкод для СНГ
							
							НовоеДвижениеНачисленияНКД = ДоначислитьКупон(ВыборкаДетальныеЗаписи.Регистратор, 
																	ВыборкаДетальныеЗаписи.Период, 
																	СтрокаПриходныхПартий,
																	СуммаКупонаНаОднуОблигацию,
																	СтрокаПриходныхПартий.Количество,
																	0,
																	ВыборкаДетальныеЗаписи.СтрокаПартии,
																	_ОтражатьНаПереоценкеПолнуюСуммуКупон,
																	Отказ);
																		
							Если Отказ Тогда
								Возврат;
							КонецЕсли;
																	
							СтрокаПриходныхПартий.ПереоценкаКупона = СтрокаПриходныхПартий.ПереоценкаКупона + НовоеДвижениеНачисленияНКД.ПереоценкаКупона;
							СтрокаПриходныхПартий.ПереоценкаКупонаВВалютеУчета = СтрокаПриходныхПартий.ПереоценкаКупонаВВалютеУчета + НовоеДвижениеНачисленияНКД.ПереоценкаКупонаВВалютеУчета;
						
						КонецЕсли;
						
						Если НастройкиПоВидуУчета.ПереоцениватьАктивыПередПродажей
							И НЕ ПереоценкаПередПродажами[0].ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.Дефолт Тогда
							
							НовоеДвижениеПереоценки = ЭтотОбъект.РассчитанныеПартии.Добавить();
							
							НовоеДвижениеПереоценки.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
							НовоеДвижениеПереоценки.Период = ВыборкаДетальныеЗаписи.Период;
							НовоеДвижениеПереоценки.ВидДвижения = Перечисления.ВидыДвижений.Приход;
							НовоеДвижениеПереоценки.Рынок = ВыборкаДетальныеЗаписи.Рынок;
							НовоеДвижениеПереоценки.ЦеннаяБумага = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
							НовоеДвижениеПереоценки.Партия = СтрокаПриходныхПартий.Партия;
							НовоеДвижениеПереоценки.СтрокаПартии = СтрокаПриходныхПартий.СтрокаПартии;
							НовоеДвижениеПереоценки.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
							
							//НовоеДвижениеПереоценки.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.ПереоценкаИНачислениеПроцентов;
							
							ЦенаКотировки = ПереоценкаПередПродажами[0].ЦенаКотировки;
							СуммаРынок = Окр(ПереоценкаПередПродажами[0].СуммаРынок / ПереоценкаПередПродажами[0].Количество * СтрокаПриходныхПартий.Количество, 2);
							СуммаРынокВВалютеУчета = Окр(ПереоценкаПередПродажами[0].СуммаРынокВВалютеУчета / ПереоценкаПередПродажами[0].Количество * СтрокаПриходныхПартий.Количество, 2);
							
							СуммаРынокВсего = СуммаРынокВсего - СуммаРынок;
							СуммаРынокВВалютеУчетаВсего = СуммаРынокВВалютеУчетаВсего - СуммаРынокВВалютеУчета;
							
							ОбщееКоличество = ОбщееКоличество - СтрокаПриходныхПартий.Количество;
							Если ОбщееКоличество = 0 Тогда
							
								СуммаРынок = СуммаРынок + СуммаРынокВсего;
								СуммаРынокВВалютеУчета = СуммаРынокВВалютеУчета + СуммаРынокВВалютеУчетаВсего;
								
								СуммаРынокВсего = 0;
								СуммаРынокВВалютеУчетаВсего = 0;
							
							КонецЕсли;
							
							Если УчитыватьПереоценкуОтдельно Тогда
								НовоеДвижениеПереоценки.Переоценка = СуммаРынок	- (СтрокаПриходныхПартий.Стоимость + СтрокаПриходныхПартий.Переоценка); 
								НовоеДвижениеПереоценки.ПереоценкаВВалютеУчета = СуммаРынокВВалютеУчета	- (СтрокаПриходныхПартий.СтоимостьВВалютеУчета + СтрокаПриходныхПартий.ПереоценкаВВалютеУчета); 
								
								СтрокаПриходныхПартий.Переоценка = СтрокаПриходныхПартий.Переоценка + НовоеДвижениеПереоценки.Переоценка;
								СтрокаПриходныхПартий.ПереоценкаВВалютеУчета = СтрокаПриходныхПартий.ПереоценкаВВалютеУчета + НовоеДвижениеПереоценки.ПереоценкаВВалютеУчета;
							Иначе
								НовоеДвижениеПереоценки.Стоимость = СуммаРынок - СтрокаПриходныхПартий.Стоимость; 
								НовоеДвижениеПереоценки.СтоимостьВВалютеУчета = СуммаРынокВВалютеУчета - СтрокаПриходныхПартий.СтоимостьВВалютеУчета; 
								НовоеДвижениеПереоценки.ПереоценкаВСтоимости = НовоеДвижениеПереоценки.Стоимость;
								
								СтрокаПриходныхПартий.Стоимость = СтрокаПриходныхПартий.Стоимость + НовоеДвижениеПереоценки.Стоимость;
								СтрокаПриходныхПартий.СтоимостьВВалютеУчета = СтрокаПриходныхПартий.СтоимостьВВалютеУчета + НовоеДвижениеПереоценки.СтоимостьВВалютеУчета;
								СтрокаПриходныхПартий.ПереоценкаВСтоимости = СтрокаПриходныхПартий.ПереоценкаВСтоимости + НовоеДвижениеПереоценки.ПереоценкаВСтоимости;
							КонецЕсли;
							
						КонецЕсли;
						
						НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
						
						ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаПриходныхПартий);
						НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Расход;
						НовоеДвижение.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
						НовоеДвижение.Период = ВыборкаДетальныеЗаписи.Период;
						НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
						
						//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.СписаниеПартии;
						
						Если ЭтоОферта Тогда
							СпишемПоОферте = Мин(КоличествоОферты, НовоеДвижение.Количество);
							
							Если СпишемПоОферте < НовоеДвижение.Количество Тогда
								
								Для Каждого Ресурс из РесурсыПартий Цикл
									НовоеДвижение[Ресурс] = НовоеДвижение[Ресурс] * СпишемПоОферте / СтрокаПриходныхПартий.Количество;
								КонецЦикла;
								
							КонецЕсли;
							
							КоличествоОферты = КоличествоОферты - СпишемПоОферте;
						КонецЕсли;
						
						Если ВариантПогашения = Перечисления.ВариантыОтраженияДебиторскойЗадолженностиПриПолномПогашенииОблигаций.НаМоментСписания Тогда
							
							НовоеДвижение.Количество = 0;
							НовоеДвижение.СтоимостьПокупки = 0;
							НовоеДвижение.ПереоценкаВСтоимости = 0;
							НовоеДвижение.РасходыПриПокупкеВСтоимости = 0;
							НовоеДвижение.РасходыПриПокупкеВСтоимостиВВалютеУчета = 0;
							НовоеДвижение.Стоимость = 0;
							НовоеДвижение.СтоимостьВВалютеУчета = 0;
							НовоеДвижение.Переоценка = 0;
							НовоеДвижение.ПереоценкаВВалютеУчета = 0;
							НовоеДвижение.СуммаЧастичногоПогашения = 0;
							НовоеДвижение.ИндексацияНоминала = 0;
							НовоеДвижение.ИндексацияНоминалаЗаВремяВладения = 0;
							НовоеДвижение.ИндексацияНоминалаСНачалаГода = 0;							
							
							НовоеДвижение.СтоимостьПокупкиКупона = 0;
