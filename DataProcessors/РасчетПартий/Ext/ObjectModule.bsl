					//Если СтрокаРеклассификации.КорректировкаЭСПРазницаППРезервВПереоценку Тогда
						
					// полностью списать партию
					НовоеДвижениеСписания = ЭтотОбъект.РассчитанныеПартии.Добавить();
					
