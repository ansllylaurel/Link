Функция СуммаИзмененияНоминала(ДатаНоминала, ЦеннаяБумага)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НоминалыЦенныхБумаг.СуммаИзменения
		|ИЗ
		|	РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|ГДЕ
		|	НоминалыЦенныхБумаг.Период = &ДатаНоминала
		|	И НоминалыЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага";

	Запрос.УстановитьПараметр("ДатаНоминала", НачалоДня(ДатаНоминала));
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.СуммаИзменения;
	Иначе
		Возврат 0;
	КонецЕсли;
	
