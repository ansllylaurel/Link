Функция ПересчитатьДанныеСделкиВВалютуНоминала(ДатаКурса, ДанныеДляРаспределения, ВыборкаДетальныеЗаписи, ВалютаНоминала, ТаблицаРасходыПоСделкеСЗамещающимиОблигациями = Неопределено, ВалютаУчета, Отказ)
	
	ВалютаСделки = ВыборкаДетальныеЗаписи.ВалютаСделки;		

	ДанныеДляРаспределения.СтоимостьПокупки = РаботаСВалютами.ПересчетСуммыВВалюте(ДанныеДляРаспределения.СтоимостьПокупки, ВалютаСделки, ДатаКурса, ВалютаНоминала, ДатаКурса, Отказ);
	ДанныеДляРаспределения.СтоимостьПокупкиКупона = РаботаСВалютами.ПересчетСуммыВВалюте(ДанныеДляРаспределения.СтоимостьПокупкиКупона, ВалютаСделки, ДатаКурса, ВалютаНоминала, ДатаКурса, Отказ);
	
	СуммыПрихода = Новый Структура();
	СуммыПрихода.Вставить("СтоимостьПокупкиВВалютеУчета", ДанныеДляРаспределения.СтоимостьПокупки);
	СуммыПрихода.Вставить("СтоимостьПокупкиКупонаВВалютеУчета", ДанныеДляРаспределения.СтоимостьПокупкиКупона);
	СуммыПрихода.Вставить("РасходыПриПокупкеВСтоимостиВВалютеУчета", ДанныеДляРаспределения.РасходыПриПокупкеВСтоимости);
		
	РаботаСВалютами.ПолучитьСуммыВВалютеУчета(СуммыПрихода, ВалютаНоминала, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период, , Отказ);
	ДанныеДляРаспределения.СтоимостьПокупкиВВалютеУчета = СуммыПрихода.СтоимостьПокупкиВВалютеУчета;
	ДанныеДляРаспределения.СтоимостьПокупкиКупонаВВалютеУчета = СуммыПрихода.СтоимостьПокупкиКупонаВВалютеУчета;
	ДанныеДляРаспределения.РасходыПриПокупкеВСтоимостиВВалютеУчета = СуммыПрихода.РасходыПриПокупкеВСтоимостиВВалютеУчета;
	
	Если ВалютаСделки = ВалютаУчета И ВалютаСделки <> ВалютаНоминала И ТаблицаРасходыПоСделкеСЗамещающимиОблигациями <> Неопределено Тогда
		ОтборТаблицыРасходыПоСделке = Новый Структура();
		
		Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.Сделка") Тогда
			ОтборТаблицыРасходыПоСделке.Вставить("Сделка", ВыборкаДетальныеЗаписи.Регистратор);
		ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке")
			Или ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг") Тогда
			ОтборТаблицыРасходыПоСделке.Вставить("Сделка", ВыборкаДетальныеЗаписи.Основание);
		Иначе
			ОтборТаблицыРасходыПоСделке.Вставить("Сделка", ВыборкаДетальныеЗаписи.Регистратор);
		КонецЕсли;	
			
		ОтборТаблицыРасходыПоСделке.Вставить("ЦеннаяБумага", ВыборкаДетальныеЗаписи.ЦеннаяБумага);
		СтрокиТаблицыРасходыПоСделке = ТаблицаРасходыПоСделкеСЗамещающимиОблигациями.НайтиСтроки(ОтборТаблицыРасходыПоСделке);
		
		РасходыПриПокупкеВСтоимости = 0;
		РасходыПриПокупкеСНачалаГода = 0;
		
		Для Каждого СтрокаТаблицыРасходыПоСделке Из СтрокиТаблицыРасходыПоСделке Цикл
			СуммаРасходыПриПокупкеВСтоимости = РаботаСВалютами.ПересчетСуммыВВалюте(СтрокаТаблицыРасходыПоСделке.СуммаОборот, ВалютаСделки, СтрокаТаблицыРасходыПоСделке.Период, ВалютаНоминала, СтрокаТаблицыРасходыПоСделке.Период, Отказ);
			РасходыПриПокупкеВСтоимости = РасходыПриПокупкеВСтоимости + Окр(СуммаРасходыПриПокупкеВСтоимости, 2);
			РасходыПриПокупкеСНачалаГода = РасходыПриПокупкеСНачалаГода + Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаРасходыПриПокупкеВСтоимости, ВалютаСделки, ЭтотОбъект.Организация, СтрокаТаблицыРасходыПоСделке.Период, Отказ), 2);
		КонецЦикла;	
			
		ДанныеДляРаспределения.РасходыПриПокупкеВСтоимости = РасходыПриПокупкеВСтоимости;
		ДанныеДляРаспределения.РасходыПриПокупкеСНачалаГода = РасходыПриПокупкеСНачалаГода;
			
	Иначе	
		ДанныеДляРаспределения.РасходыПриПокупкеВСтоимости = РаботаСВалютами.ПересчетСуммыВВалюте(ДанныеДляРаспределения.РасходыПриПокупкеВСтоимости, ВалютаСделки, ДатаКурса, ВалютаНоминала, ДатаКурса, Отказ);
		ДанныеДляРаспределения.РасходыПриПокупкеСНачалаГода = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ДанныеДляРаспределения.РасходыПриПокупкеВСтоимости, ВалютаСделки, ЭтотОбъект.Организация, ДатаКурса, Отказ);
	КонецЕсли;	
	
КонецФункции

Процедура ПроверитьНарушенияДатЗапрета(Запрос, ИмяВременнойТаблицы, ИмяРегистра, Отказ)

	Выборка = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос.МенеджерВременныхТаблиц, ИмяВременнойТаблицы).Выбрать();
	Если Выборка.Следующий() Тогда
	
		ПредставлениеРегистра = Метаданные.РегистрыНакопления[ИмяРегистра].Представление();
		ПредставлениеРегистра = ПредставлениеРегистра + "' по виду учета '" + ВидУчета;
		
		ТекстСообщения = СтрШаблон("Запрещено редактирование регистра '%1', т.к. период меньше даты запрета редактирования",
			ПредставлениеРегистра + "' по документу '" + Выборка.Регистратор);
			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Выборка.Регистратор, , , Отказ);
	
	КонецЕсли;
	
