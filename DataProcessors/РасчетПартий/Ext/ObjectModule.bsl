				КонецЕсли;
				
				СтрокиРеклассификации = ДанныеРеклассификаций.НайтиСтроки(Новый Структура("Ссылка,ЦеннаяБумага,Партия,СтрокаПартии", 
																						ВыборкаДетальныеЗаписи.Регистратор,
																						ВыборкаДетальныеЗаписи.ЦеннаяБумага, 
																						ВыборкаДетальныеЗаписи.Партия, 
																						ВыборкаДетальныеЗаписи.СтрокаПартии));
				Если СтрокиРеклассификации.Количество() <> 1 Тогда
