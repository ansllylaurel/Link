								КонецЕсли;
							КонецЦикла;
							
						КонецЦикла;
							
					//оплата по покупками РЕПО
					ИначеЕсли РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО 
						ИЛИ РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО Тогда
						
						//по 1-й части покупки РЕПО если оплата позже, то перекурсовать бумаги
						//по 2-й части покупки РЕПО если оплата раньше, то погасить суммы и оставить количество
						ЗапросДляРЕПО = Новый Запрос;
						ЗапросДляРЕПО.Текст = 
							"ВЫБРАТЬ РАЗРЕШЕННЫЕ
							|	ОплатаОснования.Основание КАК Основание,
							|	НАЧАЛОПЕРИОДА(ОплатаОснования.Ссылка.Дата, ДЕНЬ) КАК ДатаОплаты,
							|	НАЧАЛОПЕРИОДА(ПоставкаЦенныхБумаг.Дата, ДЕНЬ) КАК ДатаПоставки,
							|	ОплатаОснования.Ссылка.ВидЗадолженности КАК ВидЗадолженности,
							|	ПоставкаЦенныхБумаг1Ч.Ссылка КАК ПоставкаЦенныхБумагПоПервойЧасти,
							|	ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.СделкаРЕПО).ВалютаСделки КАК ВалютаСделки,
							|	ОплатаОснования.КурсОплаты КАК КурсОплаты,
							|	ОплатаОснования.СобственныйКурсОплаты КАК СобственныйКурсОплаты,
							|	ЕСТЬNULL(ПоставкаЦенныхБумаг.Ссылка, ЗНАЧЕНИЕ(Документ.ПоставкаЦенныхБумаг.)) КАК ПоставкаЦенныхБумаг
							|ИЗ
							|	Документ.Оплата.Основания КАК ОплатаОснования
							|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоставкаЦенныхБумаг КАК ПоставкаЦенныхБумаг1Ч
							|		ПО ОплатаОснования.Основание = ПоставкаЦенныхБумаг1Ч.Основание
							|			И (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО) = ПоставкаЦенныхБумаг1Ч.ВидЗадолженности)
							|			И (ПоставкаЦенныхБумаг1Ч.Проведен)
							|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоставкаЦенныхБумаг КАК ПоставкаЦенныхБумаг
							|		ПО ОплатаОснования.Основание = ПоставкаЦенныхБумаг.Основание
							|			И ОплатаОснования.Ссылка.ВидЗадолженности = ПоставкаЦенныхБумаг.ВидЗадолженности
							|			И (ПоставкаЦенныхБумаг.Проведен)
							|ГДЕ
							|	ОплатаОснования.Ссылка = &Ссылка
							|	И (ОплатаОснования.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО)
							|				И НАЧАЛОПЕРИОДА(ЕСТЬNULL(ПоставкаЦенныхБумаг.Дата, ОплатаОснования.Ссылка.Дата), ДЕНЬ) < НАЧАЛОПЕРИОДА(ОплатаОснования.Ссылка.Дата, ДЕНЬ)
							|			ИЛИ ОплатаОснования.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
							|				И НАЧАЛОПЕРИОДА(ЕСТЬNULL(ПоставкаЦенныхБумаг.Дата, ДОБАВИТЬКДАТЕ(ОплатаОснования.Ссылка.Дата, ДЕНЬ, 1)), ДЕНЬ) > НАЧАЛОПЕРИОДА(ОплатаОснования.Ссылка.Дата, ДЕНЬ))
							|	И ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.СделкаРЕПО).ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)";
						
						ЗапросДляРЕПО.УстановитьПараметр("Ссылка", ВыборкаДетальныеЗаписи.Регистратор);
						
						РезультатЗапросаДляРЕПО = ЗапросДляРЕПО.Выполнить();
						
