Процедура РассчитатьПартииСрочныхКонтрактовЕПС(Отказ, ТаблицаПлановыхОпераций, РассчитыватьСтоимости)
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииСрочныхКонтрактовОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииСрочныхКонтрактовОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииСрочныхКонтрактовОстатки.ВидСделки КАК ВидСделки,
		|	БухПартииСрочныхКонтрактовОстатки.Партия КАК Партия,
		|	БухПартииСрочныхКонтрактовОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииСрочныхКонтрактовОстатки.КоличествоОстаток КАК Количество,
		|	БухПартииСрочныхКонтрактовОстатки.СтоимостьПокупкиОстаток КАК СтоимостьПокупки,
		|	БухПартииСрочныхКонтрактовОстатки.ПереоценкаОстаток КАК Переоценка,
		|	БухПартииСрочныхКонтрактовОстатки.ПереоценкаСНачалаГодаОстаток КАК ПереоценкаСНачалаГода,
		|	БухПартииСрочныхКонтрактовОстатки.СтоимостьБазовогоАктиваВВалютеУчетаОстаток КАК СтоимостьБазовогоАктиваВВалютеУчета,
		|	БухПартииСрочныхКонтрактовОстатки.Партия.Дата КАК Период,
		|	НЕОПРЕДЕЛЕНО КАК Регистратор,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход) КАК ВидДвижения,
		|	БухПартииСрочныхКонтрактовОстатки.Партия.МоментВремени КАК МоментВремени,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииСрочныхКонтрактовОстатки.Партия) = ТИП(Документ.Сделка)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииСрочныхКонтрактовОстатки.Партия КАК Документ.Сделка).НомерСделки
		|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииСрочныхКонтрактовОстатки.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
		|			ТОГДА ВЫРАЗИТЬ(ВЫРАЗИТЬ(БухПартииСрочныхКонтрактовОстатки.Партия КАК Документ.ИсполнениеОбязательствПоСделке).Основание КАК Документ.Сделка).НомерСделки
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК НомерСделки
		|ПОМЕСТИТЬ _Партии
		|ИЗ
		|	РегистрНакопления.БухПартииСрочныхКонтрактов.Остатки(
		|			&НачалоПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета) КАК БухПартииСрочныхКонтрактовОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОперацииСЦеннымиБумагами.ЦеннаяБумага,
		|	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка),
		|	ВЫРАЗИТЬ(ОперацииСЦеннымиБумагами.Регистратор КАК Документ.Сделка).ВидСделки,
		|	ОперацииСЦеннымиБумагами.Регистратор,
		|	ОперацииСЦеннымиБумагами.НомерСтроки,
		|	ОперацииСЦеннымиБумагами.Количество,
		|	ОперацииСЦеннымиБумагами.Сумма,
		|	0,
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(ОперацииСЦеннымиБумагами.Регистратор КАК Документ.Сделка).ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА -ЕСТЬNULL(РасходыПоСделкеОбороты.СуммаОборот, 0)
		|		ИНАЧЕ ЕСТЬNULL(РасходыПоСделкеОбороты.СуммаОборот, 0)
		|	КОНЕЦ,
		|	0,
		|	ОперацииСЦеннымиБумагами.ДатаОперации,
		|	ОперацииСЦеннымиБумагами.Регистратор,
		|	ОперацииСЦеннымиБумагами.ВидДвижения,
		|	ВЫРАЗИТЬ(ОперацииСЦеннымиБумагами.Регистратор КАК Документ.Сделка).МоментВремени,
		|	ВЫРАЗИТЬ(ОперацииСЦеннымиБумагами.Регистратор КАК Документ.Сделка).НомерСделки
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке.Обороты(
		|				,
		|				&КонецПериода,
		|				Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В (&СписокСтратегий)
		|					И (ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|						ИЛИ ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))) КАК РасходыПоСделкеОбороты
		|		ПО ОперацииСЦеннымиБумагами.Операция = РасходыПоСделкеОбороты.Сделка
		|			И ОперацииСЦеннымиБумагами.ЦеннаяБумага = РасходыПоСделкеОбороты.ЦеннаяБумага
		|ГДЕ
		|	ОперацииСЦеннымиБумагами.Организация = &Организация
		|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления В(&СписокСтратегий)
		|	И ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Регистратор) = ТИП(Документ.Сделка)
		|	И НЕ ВЫРАЗИТЬ(ОперацииСЦеннымиБумагами.Регистратор КАК Документ.Сделка).ОтложенноеИсполнение
		|	И ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ОперацииСЦеннымиБумагами.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Фьючерсы)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОперацииСЦеннымиБумагами.ЦеннаяБумага,
		|	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка),
		|	ВЫРАЗИТЬ(ОперацииСЦеннымиБумагами.Основание КАК Документ.Сделка).ВидСделки,
		|	ОперацииСЦеннымиБумагами.Регистратор,
		|	ОперацииСЦеннымиБумагами.НомерСтроки,
		|	ОперацииСЦеннымиБумагами.Количество,
		|	ОперацииСЦеннымиБумагами.Сумма,
		|	0,
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(ОперацииСЦеннымиБумагами.Основание КАК Документ.Сделка).ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА -ЕСТЬNULL(РасходыПоСделкеОбороты.СуммаОборот, 0)
		|		ИНАЧЕ ЕСТЬNULL(РасходыПоСделкеОбороты.СуммаОборот, 0)
		|	КОНЕЦ,
		|	0,
		|	ОперацииСЦеннымиБумагами.ДатаОперации,
		|	ОперацииСЦеннымиБумагами.Регистратор,
		|	ОперацииСЦеннымиБумагами.ВидДвижения,
		|	ВЫРАЗИТЬ(ОперацииСЦеннымиБумагами.Регистратор КАК Документ.ИсполнениеОбязательствПоСделке).МоментВремени,
		|	ВЫРАЗИТЬ(ОперацииСЦеннымиБумагами.Основание КАК Документ.Сделка).НомерСделки
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке.Обороты(
		|				,
		|				&КонецПериода,
		|				Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В (&СписокСтратегий)
		|					И (ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|						ИЛИ ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))) КАК РасходыПоСделкеОбороты
		|		ПО ОперацииСЦеннымиБумагами.Основание = РасходыПоСделкеОбороты.Сделка
		|			И ОперацииСЦеннымиБумагами.ЦеннаяБумага = РасходыПоСделкеОбороты.ЦеннаяБумага
		|ГДЕ
		|	ОперацииСЦеннымиБумагами.Организация = &Организация
		|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления В(&СписокСтратегий)
		|	И ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Регистратор) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
		|	И ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ОперацииСЦеннымиБумагами.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Фьючерсы)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Партии.ЦеннаяБумага.БазовыйАктив КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _Акции
		|ИЗ
		|	_Партии КАК Партии
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(Партии.ЦеннаяБумага.БазовыйАктив) = ТИП(Справочник.Акции)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Партии.ЦеннаяБумага КАК ЦеннаяБумага,
		|	Партии.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	Партии.ВидСделки КАК ВидСделки,
		|	Партии.Партия КАК Партия,
		|	Партии.СтрокаПартии КАК СтрокаПартии,
		|	Партии.Количество КАК Количество,
		|	Партии.СтоимостьПокупки КАК СтоимостьПокупки,
		|	Партии.Переоценка КАК Переоценка,
		|	Партии.Период КАК Период,
		|	Партии.Регистратор КАК Регистратор,
		|	Партии.ВидДвижения КАК ВидДвижения,
		|	Партии.МоментВремени КАК МоментВремени,
		|	Партии.НомерСделки КАК НомерСделки,
		|	Партии.ПереоценкаСНачалаГода КАК ПереоценкаСНачалаГода,
		|	Партии.СтоимостьБазовогоАктиваВВалютеУчета КАК СтоимостьБазовогоАктиваВВалютеУчета
		|ИЗ
		|	_Партии КАК Партии
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период,
		|	НомерСделки,
		|	МоментВремени
		|ИТОГИ ПО
		|	ЦеннаяБумага";

	#КонецОбласти 
		
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.КонецПериода));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВидУчета", ЭтотОбъект.ВидУчета);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
	Запрос.УстановитьПараметр("СписокСтратегий", СписокСтратегий);
	
	ЭтотОбъект.РассчитанныеПартииСрочныеКонтракты.Очистить();
	
	ПустаяТаблица = ЭтотОбъект.РассчитанныеПартииСрочныеКонтракты.Выгрузить();
	
	РезультатЗапроса = Запрос.Выполнить();

	Акции = Запрос.МенеджерВременныхТаблиц.Таблицы["_Акции"].ПолучитьДанные().Выгрузить();
	Если Акции.Количество() <> 0 Тогда
	
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("Организация",					ЭтотОбъект.Организация);
		ПараметрыРасчета.Вставить("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
		ПараметрыРасчета.Вставить("ЦельРасчета",					Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
		ПараметрыРасчета.Вставить("ВалютаУчета",					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета"));
		ПараметрыРасчета.Вставить("Дата", 							КонецДня(ЭтотОбъект.КонецПериода));
		НастройкиОценки	= РаботаСПереоценкой.ОпределитьНастройкиОценки(ПараметрыРасчета.Дата, ПараметрыРасчета.Организация, ПараметрыРасчета.СчетДоверительногоУправления, ПараметрыРасчета.ЦельРасчета);
		ПараметрыРасчета.Вставить("ВидУчета",							НастройкиОценки.ВидУчетаДляОстатковПартий); 	
		ПараметрыРасчета.Вставить("ВариантРасчетаОценочнойСтоимости",	НастройкиОценки.ВариантРасчетаОценочнойСтоимости); 	
		
		РСП = Документы.РегистрацияСтоимостиПереоценки.СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(РСП, ПараметрыРасчета);
		РСП.ДополнительныеСвойства.Вставить("ОчиститьКупоныСуммыИКоличество", Ложь);
		РСП.ДополнительныеСвойства.Вставить("ВыполнятьРасчетПоУказаниюЦБ", Ложь);
		
		ОцениваемыеБумаги = Новый ТаблицаЗначений;
		
		ОцениваемыеБумаги.Колонки.Добавить("ЦеннаяБумага",		Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
		ОцениваемыеБумаги.Колонки.Добавить("Количество",		Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
		ОцениваемыеБумаги.Колонки.Добавить("ВидДвижения",		Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДвижений"));
		ОцениваемыеБумаги.Колонки.Добавить("Рынок",				Новый ОписаниеТипов("ПеречислениеСсылка.РынкиЦенныхБумаг"));
		ОцениваемыеБумаги.Колонки.Добавить("ТипЗадолженности",	Новый ОписаниеТипов("ПеречислениеСсылка.ТипыЗадолженности"));
		
		ОцениваемыеБумаги.Колонки.Добавить("Партия",						Метаданные.ОпределяемыеТипы.Партия.Тип);
		ОцениваемыеБумаги.Колонки.Добавить("СтрокаПартии",					Новый ОписаниеТипов("Число"));
		ОцениваемыеБумаги.Колонки.Добавить("УчетныйАктивЕПС",				Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
		ОцениваемыеБумаги.Колонки.Добавить("СуммаРезервовПодОбесценение",	Новый ОписаниеТипов("Число"));
		
		Для каждого СтрокаАкции Из Акции Цикл
			
			СтрокаОцениваемыеБумаги = ОцениваемыеБумаги.Добавить();
			СтрокаОцениваемыеБумаги.ЦеннаяБумага = СтрокаАкции.ЦеннаяБумага;
			СтрокаОцениваемыеБумаги.Количество = 1;
			СтрокаОцениваемыеБумаги.ВидДвижения = Перечисления.ВидыДвижений.Приход;
			СтрокаОцениваемыеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Акции;
		
		КонецЦикла;
		
		РСП.ЗаполнитьСтоимостьПереоценки(Истина, Ложь, Отказ, Неопределено, Ложь, Неопределено, ОцениваемыеБумаги, Истина);
		ТаблицаСтоимостейАкций = РСП.СтоимостиПереоценки.Выгрузить();
		
	КонецЕсли;
	
	ВыборкаЦеннаяБумага = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаЦеннаяБумага.Следующий() Цикл
		
		ЦеннаяБумага = ВыборкаЦеннаяБумага.ЦеннаяБумага;
		БазовыйАктив = ЦеннаяБумага.БазовыйАктив;
		
		ПартииВНаличии = ПустаяТаблица.СкопироватьКолонки();
		
		ТекущееСостояниие = Перечисления.ВидыСделок.ПустаяСсылка(); // это переменная отражает, что у нас сейчас покупки или продажи
		
		// для фьючей не передаем СчетДоверительногоУправления - ибо не переопределяются
		УчетныйАктивЕПС = БухгалтерскийУчет.ОпределитьУчетныйАктивЕПС(, Перечисления.РынкиЦенныхБумаг.Фьючерсы, ВыборкаЦеннаяБумага.ЦеннаяБумага);
		
		ВыборкаДетальныеЗаписи = ВыборкаЦеннаяБумага.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ВыборкаДетальныеЗаписи.ВидСделки = ТекущееСостояниие
				ИЛИ ТекущееСостояниие = Перечисления.ВидыСделок.ПустаяСсылка() Тогда
				
				ПартияВНаличии = ПартииВНаличии.Добавить();
				ЗаполнитьЗначенияСвойств(ПартияВНаличии, ВыборкаДетальныеЗаписи);
				
				Если ПартияВНаличии.УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПустаяСсылка() Тогда
					ПартияВНаличии.УчетныйАктивЕПС = УчетныйАктивЕПС;
				КонецЕсли;
				
				НовоеДвижение = ЭтотОбъект.РассчитанныеПартииСрочныеКонтракты.Добавить();
				ЗаполнитьЗначенияСвойств(НовоеДвижение, ПартияВНаличии);
				НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Приход;
				
				Если РассчитыватьСтоимости Тогда
					Если ТипЗнч(БазовыйАктив) = Тип("СправочникСсылка.ВалютныеПары") Тогда
						// пока определение СтоимостиБазовогоАктиваВВалютеУчета сделано только для валютных пар
						СтоимостьБазовогоАктиваВВалюте = ВыборкаДетальныеЗаписи.Количество * ЦеннаяБумага.Лот;
						СтоимостьБазовогоАктиваВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтоимостьБазовогоАктиваВВалюте, БазовыйАктив.Валюта, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период);
						
						ПартияВНаличии.СтоимостьБазовогоАктиваВВалютеУчета = СтоимостьБазовогоАктиваВВалютеУчета;
						НовоеДвижение.СтоимостьБазовогоАктиваВВалютеУчета = СтоимостьБазовогоАктиваВВалютеУчета;
						
					ИначеЕсли ТипЗнч(БазовыйАктив) = Тип("СправочникСсылка.Акции") Тогда
						// и для акций
						СтоимостьБазовогоАктиваВВалюте = ВыборкаДетальныеЗаписи.Количество * ТаблицаСтоимостейАкций.НайтиСтроки(Новый Структура("ЦеннаяБумага", БазовыйАктив))[0].ЦенаКотировки;
						СтоимостьБазовогоАктиваВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтоимостьБазовогоАктиваВВалюте, БазовыйАктив.ВалютаНоминала, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период);
						
						ПартияВНаличии.СтоимостьБазовогоАктиваВВалютеУчета = СтоимостьБазовогоАктиваВВалютеУчета;
						НовоеДвижение.СтоимостьБазовогоАктиваВВалютеУчета = СтоимостьБазовогоАктиваВВалютеУчета;
						
					КонецЕсли;
				
				КонецЕсли;
				
				ТекущееСостояниие = ВыборкаДетальныеЗаписи.ВидСделки;
				
			Иначе
				
				ПартииКУдалению = Новый Массив;
						
				КоличествоКСписанию = ВыборкаДетальныеЗаписи.Количество;
				
				Для каждого СтрокаПартииВНаличии Из ПартииВНаличии Цикл
					
					Если СтрокаПартииВНаличии.Количество <= КоличествоКСписанию Тогда
						КоличествоКСписаниюПартии = СтрокаПартииВНаличии.Количество;
					Иначе	
						КоличествоКСписаниюПартии = СтрокаПартииВНаличии.Количество;
					КонецЕсли;
					
					СуммаПерекурсовки = 0;
					Если ТипЗнч(БазовыйАктив) = Тип("СправочникСсылка.ВалютныеПары")
						ИЛИ ТипЗнч(БазовыйАктив) = Тип("СправочникСсылка.Акции") Тогда 

						НовоеДвижениеПерекурсовки = ЭтотОбъект.РассчитанныеПартииСрочныеКонтракты.Добавить();
						
						ЗаполнитьЗначенияСвойств(НовоеДвижениеПерекурсовки, СтрокаПартииВНаличии);
						
						НовоеДвижениеПерекурсовки.ВидДвижения = Перечисления.ВидыДвижений.Приход;
						НовоеДвижениеПерекурсовки.Количество = 0;
						НовоеДвижениеПерекурсовки.Переоценка = 0;
						НовоеДвижениеПерекурсовки.ПереоценкаСНачалаГода = 0;
						НовоеДвижениеПерекурсовки.СтоимостьПокупки = 0;
						
						Если РассчитыватьСтоимости Тогда
							
							Если ТипЗнч(БазовыйАктив) = Тип("СправочникСсылка.ВалютныеПары") Тогда
								// пока определение СтоимостиБазовогоАктиваВВалютеУчета сделано только для валютных пар
								СтоимостьБазовогоАктиваВВалюте = КоличествоКСписаниюПартии * ЦеннаяБумага.Лот;
								СтоимостьБазовогоАктиваВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтоимостьБазовогоАктиваВВалюте, БазовыйАктив.Валюта, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период);
							ИначеЕсли ТипЗнч(БазовыйАктив) = Тип("СправочникСсылка.Акции") Тогда
								// и для акций
								СтоимостьБазовогоАктиваВВалюте = КоличествоКСписаниюПартии * ТаблицаСтоимостейАкций.НайтиСтроки(Новый Структура("ЦеннаяБумага", БазовыйАктив))[0].ЦенаКотировки;
								СтоимостьБазовогоАктиваВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтоимостьБазовогоАктиваВВалюте, БазовыйАктив.ВалютаНоминала, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период);
							КонецЕсли;
							
							Если КоличествоКСписаниюПартии = СтрокаПартииВНаличии.Количество Тогда
								БалансоваяСтоимостьБазовогоАктиваВВалютеУчета = СтрокаПартииВНаличии.СтоимостьБазовогоАктиваВВалютеУчета;
							Иначе
								БалансоваяСтоимостьБазовогоАктиваВВалютеУчета = СтрокаПартииВНаличии.СтоимостьБазовогоАктиваВВалютеУчета / СтрокаПартииВНаличии.Количество * КоличествоКСписаниюПартии;
							КонецЕсли;
							СуммаПерекурсовки = СтоимостьБазовогоАктиваВВалютеУчета - БалансоваяСтоимостьБазовогоАктиваВВалютеУчета;
							НовоеДвижениеПерекурсовки.СтоимостьБазовогоАктиваВВалютеУчета = СуммаПерекурсовки;
							
						КонецЕсли; 
						
					КонецЕсли;
					
							
					НовоеДвижение = ЭтотОбъект.РассчитанныеПартииСрочныеКонтракты.Добавить();
					
					ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаПартииВНаличии);
					
					НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Расход;
					НовоеДвижение.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
					НовоеДвижение.Период = ВыборкаДетальныеЗаписи.Период;
					
					Если СтрокаПартииВНаличии.Количество <= КоличествоКСписанию Тогда // закроем полностью
						
						ПартииКУдалению.Добавить(СтрокаПартииВНаличии);
						КоличествоКСписанию = КоличествоКСписанию - СтрокаПартииВНаличии.Количество;
								
					Иначе //спишем пропорционально
								
						КоэффициентСписания = КоличествоКСписанию / СтрокаПартииВНаличии.Количество;
								
						НовоеДвижение.Количество = КоличествоКСписанию;
						
						Если РассчитыватьСтоимости Тогда
						
							НовоеДвижение.СтоимостьПокупки = СтрокаПартииВНаличии.СтоимостьПокупки * КоэффициентСписания;
							НовоеДвижение.Переоценка = СтрокаПартииВНаличии.Переоценка * КоэффициентСписания;
							НовоеДвижение.ПереоценкаСНачалаГода = СтрокаПартииВНаличии.ПереоценкаСНачалаГода * КоэффициентСписания;
							НовоеДвижение.СтоимостьБазовогоАктиваВВалютеУчета = СтрокаПартииВНаличии.СтоимостьБазовогоАктиваВВалютеУчета * КоэффициентСписания;
							
							СтрокаПартииВНаличии.СтоимостьПокупки = СтрокаПартииВНаличии.СтоимостьПокупки - НовоеДвижение.СтоимостьПокупки;
							СтрокаПартииВНаличии.Переоценка = СтрокаПартииВНаличии.Переоценка - НовоеДвижение.Переоценка;
							СтрокаПартииВНаличии.ПереоценкаСНачалаГода = СтрокаПартииВНаличии.ПереоценкаСНачалаГода - НовоеДвижение.ПереоценкаСНачалаГода;
							СтрокаПартииВНаличии.СтоимостьБазовогоАктиваВВалютеУчета = СтрокаПартииВНаличии.СтоимостьБазовогоАктиваВВалютеУчета - НовоеДвижение.СтоимостьБазовогоАктиваВВалютеУчета;							
						
						КонецЕсли; 
						
						СтрокаПартииВНаличии.Количество = СтрокаПартииВНаличии.Количество - НовоеДвижение.Количество;
						
						КоличествоКСписанию = 0;
						
					КонецЕсли;
					
					НовоеДвижение.СтоимостьБазовогоАктиваВВалютеУчета = НовоеДвижение.СтоимостьБазовогоАктиваВВалютеУчета + СуммаПерекурсовки;
					
					Если КоличествоКСписанию = 0 Тогда
						Прервать;
					КонецЕсли;
							
				КонецЦикла;
						
				Для каждого СтрокаПартииКУдалению Из ПартииКУдалению Цикл
					ПартииВНаличии.Удалить(СтрокаПартииКУдалению);
				КонецЦикла;
				
				Если КоличествоКСписанию > 0 Тогда // а это означает переход на другую сторону силы
					
					ПартияВНаличии = ПартииВНаличии.Добавить();
					ЗаполнитьЗначенияСвойств(ПартияВНаличии, ВыборкаДетальныеЗаписи);
					ПартияВНаличии.Количество = КоличествоКСписанию;
					
					Если РассчитыватьСтоимости Тогда
						
						ПартияВНаличии.СтоимостьПокупки = ВыборкаДетальныеЗаписи.СтоимостьПокупки / ВыборкаДетальныеЗаписи.Количество * КоличествоКСписанию;
						ПартияВНаличии.Переоценка = ВыборкаДетальныеЗаписи.Переоценка / ВыборкаДетальныеЗаписи.Количество * КоличествоКСписанию; // тут 0
						
						// а тут комиссия, и ее начисляем всю
						Если ВыборкаДетальныеЗаписи.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
							// комиссия уменьшает переоценку (т.к. положительная переоценка это доход)
							ПартияВНаличии.ПереоценкаСНачалаГода = - ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГода;
						ИначеЕсли ВыборкаДетальныеЗаписи.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
							// комиссия увеличивает переоценку (т.к. положительная переоценка это расход)
							ПартияВНаличии.ПереоценкаСНачалаГода = ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГода;
						КонецЕсли;
					
					КонецЕсли; 
				
					Если ПартияВНаличии.УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПустаяСсылка() Тогда
						// для фьючей не передаем СчетДоверительногоУправления - ибо не переопределяются
						ПартияВНаличии.УчетныйАктивЕПС = БухгалтерскийУчет.ОпределитьУчетныйАктивЕПС(ВыборкаДетальныеЗаписи.Период, Перечисления.РынкиЦенныхБумаг.Фьючерсы, ВыборкаДетальныеЗаписи.ЦеннаяБумага);
					КонецЕсли;
					
					НовоеДвижение = ЭтотОбъект.РассчитанныеПартииСрочныеКонтракты.Добавить();
					ЗаполнитьЗначенияСвойств(НовоеДвижение, ПартияВНаличии);
					НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Приход;
					
					Если РассчитыватьСтоимости Тогда
						Если ТипЗнч(БазовыйАктив) = Тип("СправочникСсылка.ВалютныеПары") Тогда
							// пока определение СтоимостиБазовогоАктиваВВалютеУчета сделано только для валютных пар
							СтоимостьБазовогоАктиваВВалюте = КоличествоКСписанию * ЦеннаяБумага.Лот;
							СтоимостьБазовогоАктиваВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтоимостьБазовогоАктиваВВалюте, БазовыйАктив.Валюта, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период);
							
							ПартияВНаличии.СтоимостьБазовогоАктиваВВалютеУчета = СтоимостьБазовогоАктиваВВалютеУчета;
							НовоеДвижение.СтоимостьБазовогоАктиваВВалютеУчета = СтоимостьБазовогоАктиваВВалютеУчета;
							
						ИначеЕсли ТипЗнч(БазовыйАктив) = Тип("СправочникСсылка.Акции") Тогда
							// и для акций
							СтоимостьБазовогоАктиваВВалюте = КоличествоКСписанию * ТаблицаСтоимостейАкций.НайтиСтроки(Новый Структура("ЦеннаяБумага", БазовыйАктив))[0].ЦенаКотировки;
							СтоимостьБазовогоАктиваВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтоимостьБазовогоАктиваВВалюте, БазовыйАктив.ВалютаНоминала, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период);
							
							ПартияВНаличии.СтоимостьБазовогоАктиваВВалютеУчета = СтоимостьБазовогоАктиваВВалютеУчета;
							НовоеДвижение.СтоимостьБазовогоАктиваВВалютеУчета = СтоимостьБазовогоАктиваВВалютеУчета;
							
						КонецЕсли;
						
					КонецЕсли;
					
					ТекущееСостояниие = ВыборкаДетальныеЗаписи.ВидСделки;
					
				КонецЕсли;
					
			КонецЕсли;
		КонецЦикла;
		
		// теперь таблица приходных партий содержит только конечные остатки, которые мы и положим в соответствующую таб. часть обработки
		Для каждого СтрокаПартииВНаличии Из ПартииВНаличии Цикл
			Если СтрокаПартииВНаличии.Количество > 0 Тогда
				ЗаполнитьЗначенияСвойств(ЭтотОбъект.КонечныеОстаткиПартийСрочныеКонтракты.Добавить(), СтрокаПартииВНаличии);
			КонецЕсли;
		КонецЦикла;
	
	КонецЦикла;
	
	ЭтотОбъект.КонечныеОстаткиПартийСрочныеКонтракты.ЗаполнитьЗначения(Перечисления.РынкиЦенныхБумаг.Фьючерсы, "Рынок");
	
КонецПроцедуры

Функция ПолучитьДанныеССдляЦБ(Рынок, ЦеннаяБумага, Количество, ДатаПереоценки)
	
	Отказ = Ложь;
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("Организация",							ЭтотОбъект.Организация);
	ПараметрыРасчета.Вставить("СчетДоверительногоУправления",			ЭтотОбъект.СчетДоверительногоУправления);
	ПараметрыРасчета.Вставить("ЦельРасчета",							Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
	Если ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ДК") Тогда
		ПараметрыРасчета.Вставить("ЦельРасчета",						Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
	КонецЕсли;
	ПараметрыРасчета.Вставить("ВалютаУчета",							ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета"));
	ПараметрыРасчета.Вставить("Дата",									ДатаПереоценки);
	
	НастройкиОценки	= РаботаСПереоценкой.ОпределитьНастройкиОценки(ПараметрыРасчета.Дата, ПараметрыРасчета.Организация, ПараметрыРасчета.СчетДоверительногоУправления, ПараметрыРасчета.ЦельРасчета);
	
	ПараметрыРасчета.Вставить("ВидУчета",								НастройкиОценки.ВидУчетаДляОстатковПартий); 	
	ПараметрыРасчета.Вставить("ВариантРасчетаОценочнойСтоимости",		НастройкиОценки.ВариантРасчетаОценочнойСтоимости); 	

	ОцениваемыеБумаги = Новый ТаблицаЗначений;
	
	ОцениваемыеБумаги.Колонки.Добавить("ЦеннаяБумага",					Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
	ОцениваемыеБумаги.Колонки.Добавить("Количество",					Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
	ОцениваемыеБумаги.Колонки.Добавить("ВидДвижения",					Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДвижений"));
	ОцениваемыеБумаги.Колонки.Добавить("Рынок",							Новый ОписаниеТипов("ПеречислениеСсылка.РынкиЦенныхБумаг"));
	ОцениваемыеБумаги.Колонки.Добавить("ТипЗадолженности",				Новый ОписаниеТипов("ПеречислениеСсылка.ТипыЗадолженности"));
	
	ОцениваемыеБумаги.Колонки.Добавить("Партия",						Метаданные.ОпределяемыеТипы.Партия.Тип);
	ОцениваемыеБумаги.Колонки.Добавить("СтрокаПартии",					Новый ОписаниеТипов("Число"));
	ОцениваемыеБумаги.Колонки.Добавить("УчетныйАктивЕПС",				Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
	ОцениваемыеБумаги.Колонки.Добавить("СуммаРезервовПодОбесценение",	Новый ОписаниеТипов("Число"));
	
	СтрокаБумаги = ОцениваемыеБумаги.Добавить();
	СтрокаБумаги.ЦеннаяБумага = ЦеннаяБумага;
	СтрокаБумаги.Рынок = Рынок;
	СтрокаБумаги.Количество = Количество;
	СтрокаБумаги.ВидДвижения = Перечисления.ВидыДвижений.Расход;
	
	ПереоценкаЦБ = Документы.РегистрацияСтоимостиПереоценки.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(ПереоценкаЦБ, ПараметрыРасчета);
	ПереоценкаЦБ.ДополнительныеСвойства.Вставить("ОчиститьКупоныСуммыИКоличество", Ложь);
	ПереоценкаЦБ.ЗаполнитьСтоимостьПереоценки(Истина, Ложь, Отказ, Неопределено, Ложь, Неопределено, ОцениваемыеБумаги, Истина);
	ТаблицаСтоимостей = ПереоценкаЦБ.СтоимостиПереоценки.Выгрузить();
	
	СтрокаСтоимостей = ТаблицаСтоимостей[0];
	
	ДанныеСС = Новый Структура();
	
	ДанныеСС.Вставить("Количество", Количество);
	ДанныеСС.Вставить("СуммаРынок", Количество * СтрокаСтоимостей.ЦенаКотировки);
	
	ДанныеСС.Вставить("СуммаРынокВВалютеУчета", РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
		Новый Структура("СуммаРынок", ДанныеСС.СуммаРынок),
		СтрокаСтоимостей.ВалютаКотировки,
		ЭтотОбъект.Организация,
		ДатаПереоценки,
		?(ЗначениеЗаполнено(СтрокаСтоимостей.КурсВалютыНоминала), СтрокаСтоимостей.КурсВалютыНоминала, Неопределено),
		Отказ).СуммаРынок);
	
	Если Рынок = Перечисления.РынкиЦенныхБумаг.Облигации  Тогда
		ДанныеСС.Вставить("СуммаКупонаРынок", Количество * СтрокаСтоимостей.ЦенаКотировкиКупона);
		
		ДанныеСС.Вставить("СуммаКупонаРынокВВалютеУчета", РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
			Новый Структура("СуммаРынок", ДанныеСС.СуммаКупонаРынок),
			СтрокаСтоимостей.ВалютаКотировки,
			ЭтотОбъект.Организация,
			ДатаПереоценки,
			?(ЗначениеЗаполнено(СтрокаСтоимостей.КурсВалютыНоминала), СтрокаСтоимостей.КурсВалютыНоминала, Неопределено),
			Отказ).СуммаКупонаРынок);
		
	КонецЕсли;
	
	Возврат ДанныеСС;

КонецФункции

Функция ПолучитьПереоценкиПередВыводами(ЦельРасчета = Неопределено)

	ПереоцениватьПоСЧА = Истина;
	Если ЦельРасчета = Справочники.ЦелиРасчета.ЕдиныйПланСчетов Тогда
		
		НастройкиОценкиСЧА	= РаботаСПереоценкой.ОпределитьНастройкиОценки(ЭтотОбъект.НачалоПериода, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
		НастройкиОценкиЕПС	= РаботаСПереоценкой.ОпределитьНастройкиОценки(ЭтотОбъект.НачалоПериода, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЦельРасчета);
		
		Если НастройкиОценкиСЧА.ВариантРасчетаОценочнойСтоимости <> НастройкиОценкиЕПС.ВариантРасчетаОценочнойСтоимости Тогда
			ПереоцениватьПоСЧА = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ПереоцениватьПоСЧА Тогда // легко и просто...
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ВводыВыводыАктивовВВалютеУчета.Регистратор КАК Регистратор
			|ПОМЕСТИТЬ ВыводыЦБ
			|ИЗ
			|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
			|ГДЕ
			|	ВводыВыводыАктивовВВалютеУчета.Организация = &Организация
			|	И ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
			|	И ВводыВыводыАктивовВВалютеУчета.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ЦенныеБумаги)
			|	И ВводыВыводыАктивовВВалютеУчета.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВыводЦенныхБумагЦенныеБумаги.Ссылка КАК Ссылка,
			|	ВыводЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ВыводЦенныхБумагЦенныеБумаги.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	ВыводЦенныхБумагЦенныеБумаги.Количество КАК Количество,
			|	ВыводЦенныхБумагЦенныеБумаги.СуммаРынок КАК СуммаРынок,
			|	ВыводЦенныхБумагЦенныеБумаги.СуммаКупонаРынок КАК СуммаКупонаРынок,
			|	ВыводЦенныхБумагЦенныеБумаги.ЦенаКотировки КАК ЦенаКотировки,
			|	ВыводЦенныхБумагЦенныеБумаги.ЦенаКотировкиКупона КАК ЦенаКотировкиКупона,
			|	ВыводЦенныхБумагЦенныеБумаги.СуммаРынокВВалютеУчета КАК СуммаРынокВВалютеУчета,
			|	ВыводЦенныхБумагЦенныеБумаги.СуммаКупонаРынокВВалютеУчета КАК СуммаКупонаРынокВВалютеУчета,
			|	ВыводЦенныхБумагЦенныеБумаги.ВидЦены КАК ВидЦены
			|ИЗ
			|	Документ.ВыводЦенныхБумаг.ЦенныеБумаги КАК ВыводЦенныхБумагЦенныеБумаги
			|ГДЕ
			|	ВыводЦенныхБумагЦенныеБумаги.Ссылка В
			|			(ВЫБРАТЬ
			|				ВыводыЦБ.Регистратор
			|			ИЗ
			|				ВыводыЦБ)
			|	И &УсловиеУчетногоАктива";
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		
		Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.НачалоПериода));
		Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ЭтотОбъект.КонецПериода));
		
		Если ЦельРасчета = Справочники.ЦелиРасчета.ЕдиныйПланСчетов Тогда
		
			ПереоцениваемыеГруппыАктивов = Новый Массив;
			ПереоцениваемыеГруппыАктивов.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток);
			ПереоцениваемыеГруппыАктивов.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи);
			ПереоцениваемыеГруппыАктивов.Добавить(Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой);
			ПереоцениваемыеГруппыАктивов.Добавить(Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажи);
			
			Запрос.УстановитьПараметр("ПереоцениваемыеГруппыАктивов", ПереоцениваемыеГруппыАктивов);
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст,
				"&УсловиеУчетногоАктива", 
				"(ВыводЦенныхБумагЦенныеБумаги.УчетныйАктивЕПС = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка)
				|ИЛИ ВыводЦенныхБумагЦенныеБумаги.УчетныйАктивЕПС.Родитель В (&ПереоцениваемыеГруппыАктивов))");
			
		Иначе
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеУчетногоАктива", "ИСТИНА"); 
			
		КонецЕсли;		
		
		Возврат  Запрос.Выполнить().Выгрузить();
		
	Иначе // сложно и жестко - сделано для одного-единственного вывода по ДК Региону
		  // как только произойдет еще 2 таких же случая - обязуюсь расчетные данные по ЕПС запихать в документ ВыводЦБ
		
		ПереоценкиПередВыводами = Новый ТаблицаЗначений;
		
		ПереоценкиПередВыводами.Колонки.Добавить("Ссылка",							Новый ОписаниеТипов("ДокументСсылка.ВыводЦенныхБумаг"));
		ПереоценкиПередВыводами.Колонки.Добавить("ЦеннаяБумага",					Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
		ПереоценкиПередВыводами.Колонки.Добавить("УчетныйАктивЕПС",					Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
		ПереоценкиПередВыводами.Колонки.Добавить("Количество",						Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
		ПереоценкиПередВыводами.Колонки.Добавить("СуммаРынок",						Новый ОписаниеТипов("Число"));
		ПереоценкиПередВыводами.Колонки.Добавить("СуммаКупонаРынок",				Новый ОписаниеТипов("Число"));
		ПереоценкиПередВыводами.Колонки.Добавить("ЦенаКотировки",					Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
		ПереоценкиПередВыводами.Колонки.Добавить("ЦенаКотировкиКупона",				Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
		ПереоценкиПередВыводами.Колонки.Добавить("СуммаРынокВВалютеУчета",			Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
		ПереоценкиПередВыводами.Колонки.Добавить("СуммаКупонаРынокВВалютеУчета",	Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
		ПереоценкиПередВыводами.Колонки.Добавить("ВидЦены",							Новый ОписаниеТипов("ПеречислениеСсылка.ИсточникиЦеныДляПереоценки"));
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ВводыВыводыАктивовВВалютеУчета.Регистратор КАК Регистратор
			|ИЗ
			|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
			|ГДЕ
			|	ВводыВыводыАктивовВВалютеУчета.Организация = &Организация
			|	И ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
			|	И ВводыВыводыАктивовВВалютеУчета.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ЦенныеБумаги)
			|	И ВводыВыводыАктивовВВалютеУчета.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода";
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		
		Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.НачалоПериода));
		Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ЭтотОбъект.КонецПериода));
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			
			ДокументОбъект = ВыборкаДетальныеЗаписи.Регистратор.ПолучитьОбъект();
			
			РаботаСКорзинойЦенныхБумагКлиентСервер.ЗаполнитьРыночнуюСтоимостьЦенныхБумаг(ДокументОбъект, "ЦенныеБумаги", Неопределено, Неопределено, ЦельРасчета);
			
			Для каждого СтрокаЦенныеБумаги Из ДокументОбъект.ЦенныеБумаги Цикл
			
				СтрокаПереоценкиПередВыводами = ПереоценкиПередВыводами.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПереоценкиПередВыводами, СтрокаЦенныеБумаги);
				СтрокаПереоценкиПередВыводами.Ссылка = ВыборкаДетальныеЗаписи.Регистратор;
			
			КонецЦикла;
			
		КонецЕсли;
		
		Возврат  ПереоценкиПередВыводами;
		
	КонецЕсли;
	
	
КонецФункции

Функция ПолучитьПереоценкиДляОпераций(УчитыватьПокупки, УчитыватьПродажи, УчитыватьПогрешность, ЦельРасчета = Неопределено)

	Если ЦельРасчета = Неопределено Тогда
		ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;
	КонецЕсли;
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("Организация",					ЭтотОбъект.Организация);
	ПараметрыРасчета.Вставить("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	ПараметрыРасчета.Вставить("ЦельРасчета",					ЦельРасчета);
	ПараметрыРасчета.Вставить("ВалютаУчета",					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета"));
	
	МассивВидовСделок = Новый Массив;
	МассивВидовДвижений = Новый Массив;
	
	Если УчитыватьПокупки Тогда
		МассивВидовСделок.Добавить(Перечисления.ВидыСделок.Покупка);
		МассивВидовДвижений.Добавить(Перечисления.ВидыДвижений.Приход);
	КонецЕсли;
	
	Если УчитыватьПродажи Тогда
		МассивВидовСделок.Добавить(Перечисления.ВидыСделок.Продажа);
		МассивВидовДвижений.Добавить(Перечисления.ВидыДвижений.Расход);
	КонецЕсли;
	
	
	МассивТиповОпераций = Новый Массив;
	МассивТиповОпераций.Добавить(Тип("ДокументСсылка.Сделка"));
	МассивТиповОпераций.Добавить(Тип("ДокументСсылка.СделкаРЕПО"));
	МассивТиповОпераций.Добавить(Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке"));
	МассивТиповОпераций.Добавить(Тип("ДокументСсылка.ПоставкаЦенныхБумаг"));
	МассивТиповОпераций.Добавить(Тип("ДокументСсылка.ПогашениеЦеннойБумаги"));
	
	ПереоценкиДляОпераций = Новый ТаблицаЗначений;
	
	ПереоценкиДляОпераций.Колонки.Добавить("Ссылка",						Новый ОписаниеТипов(МассивТиповОпераций));
	ПереоценкиДляОпераций.Колонки.Добавить("ЦеннаяБумага",					Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
	ПереоценкиДляОпераций.Колонки.Добавить("УчетныйАктивЕПС",				Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
	ПереоценкиДляОпераций.Колонки.Добавить("Количество",					Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
	ПереоценкиДляОпераций.Колонки.Добавить("СуммаРынок",					Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	ПереоценкиДляОпераций.Колонки.Добавить("СуммаКупонаРынок",				Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	ПереоценкиДляОпераций.Колонки.Добавить("ЦенаКотировки",					Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
	ПереоценкиДляОпераций.Колонки.Добавить("ЦенаКотировкиКупона",			Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
	ПереоценкиДляОпераций.Колонки.Добавить("СуммаРынокВВалютеУчета",		Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	ПереоценкиДляОпераций.Колонки.Добавить("СуммаКупонаРынокВВалютеУчета",	Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	ПереоценкиДляОпераций.Колонки.Добавить("ВидЦены",						Новый ОписаниеТипов("ПеречислениеСсылка.ИсточникиЦеныДляПереоценки"));
	ПереоценкиДляОпераций.Колонки.Добавить("ВидДвижения",					Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДвижений"));
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаЦенныеБумаги.Ссылка КАК Ссылка,
		|	СделкаЦенныеБумаги.Ссылка.Рынок КАК Рынок,
		|	СделкаЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СделкаЦенныеБумаги.Количество КАК Количество,
		|	НАЧАЛОПЕРИОДА(СделкаЦенныеБумаги.Ссылка.Дата, ДЕНЬ) КАК ДатаОперации,
		|	ВЫБОР
		|		КОГДА СделкаЦенныеБумаги.Ссылка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|	КОНЕЦ КАК ВидДвижения
		|ПОМЕСТИТЬ _ОперацииСБумагами
		|ИЗ
		|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|ГДЕ
		|	СделкаЦенныеБумаги.Ссылка.Организация = &Организация
		|	И СделкаЦенныеБумаги.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СделкаЦенныеБумаги.Ссылка.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И СделкаЦенныеБумаги.Ссылка.ВидСделки В(&МассивВидовСделок)
		|	И НЕ СделкаЦенныеБумаги.Ссылка.ОтложенноеИсполнение
		|	И СделкаЦенныеБумаги.Ссылка.Проведен
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СделкаРЕПОЦенныеБумаги.Ссылка,
		|	СделкаРЕПОЦенныеБумаги.Ссылка.Рынок,
		|	СделкаРЕПОЦенныеБумаги.ЦеннаяБумага,
		|	СделкаРЕПОЦенныеБумаги.Количество,
		|	НАЧАЛОПЕРИОДА(СделкаРЕПОЦенныеБумаги.Ссылка.Дата, ДЕНЬ),
		|	ВЫБОР
		|		КОГДА СделкаРЕПОЦенныеБумаги.Ссылка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|	КОНЕЦ
		|ИЗ
		|	Документ.СделкаРЕПО.ЦенныеБумаги КАК СделкаРЕПОЦенныеБумаги
		|ГДЕ
		|	СделкаРЕПОЦенныеБумаги.Ссылка.Организация = &Организация
		|	И СделкаРЕПОЦенныеБумаги.Ссылка.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И СделкаРЕПОЦенныеБумаги.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СделкаРЕПОЦенныеБумаги.Ссылка.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И СделкаРЕПОЦенныеБумаги.Ссылка.ВидСделки В(&МассивВидовСделок)
		|	И (СделкаРЕПОЦенныеБумаги.Ссылка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|				И СделкаРЕПОЦенныеБумаги.Ссылка.ЧастьСделкиРЕПО = 2
		|			ИЛИ СделкаРЕПОЦенныеБумаги.Ссылка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|				И СделкаРЕПОЦенныеБумаги.Ссылка.ЧастьСделкиРЕПО = 1)
		|	И НЕ СделкаРЕПОЦенныеБумаги.Ссылка.ОтложенноеИсполнение
		|	И СделкаРЕПОЦенныеБумаги.Ссылка.Проведен
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка,
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.Рынок,
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.ЦеннаяБумага,
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.Количество,
		|	НАЧАЛОПЕРИОДА(ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.Дата, ДЕНЬ),
		|	ВЫБОР
		|		КОГДА ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|	КОНЕЦ
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК ИсполнениеОбязательствПоСделкеЦенныеБумаги
		|ГДЕ
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.Организация = &Организация
		|	И ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.ВидСделки В(&МассивВидовСделок)
		|	И ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.Проведен
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПоставкаЦенныхБумагЦенныеБумаги.Ссылка,
		|	ПоставкаЦенныхБумагЦенныеБумаги.Ссылка.Рынок,
		|	ПоставкаЦенныхБумагЦенныеБумаги.ЦеннаяБумага,
		|	ПоставкаЦенныхБумагЦенныеБумаги.Количество,
		|	НАЧАЛОПЕРИОДА(ПоставкаЦенныхБумагЦенныеБумаги.Ссылка.Дата, ДЕНЬ),
		|	ПоставкаЦенныхБумагЦенныеБумаги.Ссылка.ВидДвижения
		|ИЗ
		|	Документ.ПоставкаЦенныхБумаг.ЦенныеБумаги КАК ПоставкаЦенныхБумагЦенныеБумаги
		|ГДЕ
		|	ПоставкаЦенныхБумагЦенныеБумаги.Ссылка.Организация = &Организация
		|	И ПоставкаЦенныхБумагЦенныеБумаги.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПоставкаЦенныхБумагЦенныеБумаги.Ссылка.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И ПоставкаЦенныхБумагЦенныеБумаги.Ссылка.ВидДвижения В(&МассивВидовДвижений)
		|	И ПоставкаЦенныхБумагЦенныеБумаги.Ссылка.Проведен
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПогашениеЦеннойБумаги.Ссылка,
		|	ПогашениеЦеннойБумаги.Рынок,
		|	ПогашениеЦеннойБумаги.ЦеннаяБумага,
		|	ПогашениеЦеннойБумаги.Количество,
		|	НАЧАЛОПЕРИОДА(ПогашениеЦеннойБумаги.Дата, ДЕНЬ),
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.ПустаяСсылка)
		|ИЗ
		|	Документ.ПогашениеЦеннойБумаги КАК ПогашениеЦеннойБумаги
		|ГДЕ
		|	&ВидУчета <> ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|	И ПогашениеЦеннойБумаги.Организация = &Организация
		|	И ПогашениеЦеннойБумаги.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПогашениеЦеннойБумаги.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход) В (&МассивВидовДвижений)
		|	И ПогашениеЦеннойБумаги.Ссылка.Проведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОперацииСБумагами.Рынок КАК Рынок,
		|	_ОперацииСБумагами.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(_ОперацииСБумагами.Количество) КАК Количество,
		|	_ОперацииСБумагами.ДатаОперации КАК ДатаОперации,
		|	_ОперацииСБумагами.ВидДвижения КАК ВидДвижения
		|ИЗ
		|	_ОперацииСБумагами КАК _ОперацииСБумагами
		|
		|СГРУППИРОВАТЬ ПО
		|	_ОперацииСБумагами.Рынок,
		|	_ОперацииСБумагами.ЦеннаяБумага,
		|	_ОперацииСБумагами.ДатаОперации,
		|	_ОперацииСБумагами.ВидДвижения
		|ИТОГИ ПО
		|	ДатаОперации";
	
	
	// для погашения ВидДвижения = "пустая ссылка" т.к. погашения нужен отдельный расчет - там пересчет номиналов
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.НачалоПериода));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ЭтотОбъект.КонецПериода));
	
	Запрос.УстановитьПараметр("ВидУчета", ЭтотОбъект.ВидУчета);
	
	Запрос.УстановитьПараметр("МассивВидовСделок", МассивВидовСделок);
	Запрос.УстановитьПараметр("МассивВидовДвижений", МассивВидовДвижений);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ОперацииСБумагами = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОперацииСБумагами"].ПолучитьДанные().Выгрузить();
	
	ВыборкаДатаОперации = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДатаОперации.Следующий() Цикл
		
		ПараметрыРасчета.Вставить("Дата", КонецДня(ВыборкаДатаОперации.ДатаОперации));
		НастройкиОценки	= РаботаСПереоценкой.ОпределитьНастройкиОценки(ПараметрыРасчета.Дата, ПараметрыРасчета.Организация, ПараметрыРасчета.СчетДоверительногоУправления, ПараметрыРасчета.ЦельРасчета);
		ПараметрыРасчета.Вставить("ВидУчета",							НастройкиОценки.ВидУчетаДляОстатковПартий); 	
		ПараметрыРасчета.Вставить("ВариантРасчетаОценочнойСтоимости",	НастройкиОценки.ВариантРасчетаОценочнойСтоимости); 	
		
		Отказ = Ложь;
		
		ОцениваемыеБумаги = Новый ТаблицаЗначений;
		
		ОцениваемыеБумаги.Колонки.Добавить("ЦеннаяБумага",		Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
		ОцениваемыеБумаги.Колонки.Добавить("Количество",		Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
		ОцениваемыеБумаги.Колонки.Добавить("ВидДвижения",		Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДвижений"));
		ОцениваемыеБумаги.Колонки.Добавить("Рынок",				Новый ОписаниеТипов("ПеречислениеСсылка.РынкиЦенныхБумаг"));
		ОцениваемыеБумаги.Колонки.Добавить("ТипЗадолженности",	Новый ОписаниеТипов("ПеречислениеСсылка.ТипыЗадолженности"));
		
		ОцениваемыеБумаги.Колонки.Добавить("Партия",						Метаданные.ОпределяемыеТипы.Партия.Тип);
		ОцениваемыеБумаги.Колонки.Добавить("СтрокаПартии",					Новый ОписаниеТипов("Число"));
		ОцениваемыеБумаги.Колонки.Добавить("УчетныйАктивЕПС",				Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
		ОцениваемыеБумаги.Колонки.Добавить("СуммаРезервовПодОбесценение",	Новый ОписаниеТипов("Число"));
		
		ВыборкаДетальныеЗаписи = ВыборкаДатаОперации.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(ОцениваемыеБумаги.Добавить(), ВыборкаДетальныеЗаписи);
		КонецЦикла;
		
		ПереоценкаЦБ = Документы.РегистрацияСтоимостиПереоценки.СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(ПереоценкаЦБ, ПараметрыРасчета);
		ПереоценкаЦБ.ДополнительныеСвойства.Вставить("ОчиститьКупоныСуммыИКоличество", Ложь);
		
		ПереоценкаЦБ.ДополнительныеСвойства.Вставить("ДатаПереоценки", НачалоДня(ВыборкаДатаОперации.ДатаОперации));
		
		ПереоценкаЦБ.ЗаполнитьСтоимостьПереоценки(Истина, Ложь, Отказ, Неопределено, Ложь, Неопределено, ОцениваемыеБумаги, Истина);
		ТаблицаСтоимостей = ПереоценкаЦБ.СтоимостиПереоценки.Выгрузить();
		
		ОцениваемыеБумаги.Колонки.Добавить("СуммаРынок",					Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
		ОцениваемыеБумаги.Колонки.Добавить("СуммаКупонаРынок",				Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
		ОцениваемыеБумаги.Колонки.Добавить("СуммаРынокВВалютеУчета",		Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
		ОцениваемыеБумаги.Колонки.Добавить("СуммаКупонаРынокВВалютеУчета",	Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
		ОцениваемыеБумаги.Колонки.Добавить("ВидЦены",						Новый ОписаниеТипов("ПеречислениеСсылка.ИсточникиЦеныДляПереоценки"));
		ОцениваемыеБумаги.Колонки.Добавить("ЦенаКотировки",					Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
		ОцениваемыеБумаги.Колонки.Добавить("ЦенаКотировкиКупона",			Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
		
		Для каждого ОцениваемаяБумага Из ОцениваемыеБумаги Цикл
		
			СтрокиСтоимостей = ТаблицаСтоимостей.НайтиСтроки(Новый Структура("Рынок,ЦеннаяБумага", ОцениваемаяБумага.Рынок, ОцениваемаяБумага.ЦеннаяБумага));
			
			ЗаполнитьЗначенияСвойств(ОцениваемаяБумага, СтрокиСтоимостей[0], "ЦенаКотировки,ЦенаКотировкиКупона,ВидЦены");
			
			Если ОцениваемаяБумага.Рынок = Перечисления.РынкиЦенныхБумаг.Доли Тогда
				
				ОцениваемаяБумага.СуммаРынок = СтрокиСтоимостей[0].Сумма;
				ОцениваемаяБумага.СуммаРынокВВалютеУчета = СтрокиСтоимостей[0].СуммаВВалютеУчета;
				
			Иначе
				
				СуммаРынок = ОцениваемаяБумага.Количество * ОцениваемаяБумага.ЦенаКотировки;
				
				Если ОцениваемаяБумага.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации
					И ОцениваемаяБумага.ВидДвижения = Перечисления.ВидыДвижений.ПустаяСсылка() Тогда // пересчитаем для погашений
					СуммаРынок = ОцениваемаяБумага.Количество * БухгалтерскийУчетЕПС.ПолучитьСтоимостьСУчетомАмортизацииНоминала(ОцениваемаяБумага.ЦенаКотировки, ОцениваемаяБумага.ЦеннаяБумага, ВыборкаДатаОперации.ДатаОперации, ВыборкаДатаОперации.ДатаОперации - 24 * 60 * 60);
					Если СуммаРынок = 0 Тогда // для случая если по методике СЧА в день погашения облигация оценивается в 0
					    СуммаРынок = ОцениваемаяБумага.Количество * Справочники.Облигации.ПолучитьНоминал(ОцениваемаяБумага.ЦеннаяБумага, ВыборкаДатаОперации.ДатаОперации);
						
						Если СтрокиСтоимостей[0].ВалютаКотировки = Справочники.Валюты.ПустаяСсылка() Тогда // в день погашения может не быть оценки по методике и из-за этого не заполняется ни валюта, ни курс
							СтрокиСтоимостей[0].ВалютаКотировки = ОцениваемаяБумага.ЦеннаяБумага.ВалютаНоминала;
							СтрокиСтоимостей[0].КурсВалютыНоминала = НачалоДня(ВыборкаДатаОперации.ДатаОперации);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				СуммаКупонаРынок = ОцениваемаяБумага.Количество * ОцениваемаяБумага.ЦенаКотировкиКупона;
				
				ОцениваемаяБумага.СуммаРынок = СуммаРынок;
				ОцениваемаяБумага.СуммаКупонаРынок = СуммаКупонаРынок;
				
				Если СтрокиСтоимостей[0].ВалютаКотировки = ПараметрыРасчета.ВалютаУчета Тогда
					ОцениваемаяБумага.СуммаРынокВВалютеУчета = СуммаРынок;
					Если СтрокиСтоимостей[0].ВалютаКотировки <> ОцениваемаяБумага.ЦеннаяБумага.ВалютаНоминала Тогда // валютная бумага с рублевой котировкой
						ОцениваемаяБумага.СуммаРынок = ОцениваемаяБумага.Количество * СтрокиСтоимостей[0].Цена; // Цена - в валюте номинала
					КонецЕсли;
				Иначе // вот тут есть заложенность на то, что если валюта котировке не в валюте учета, то она в валюте номинала - возможно, есть случаи опровергающие это, но пока прецедентов не было
					// теперь для расчета рублевой суммы используется неокругленная валютная сумма
					// возможно, тут будут еще изменения т.к. в ЕПС этим пользуется только Югория и у нее нет валютных активов
					// когда это будут делать в ЕПС клиенты с валютными активами скорее всего нужно будет окурглять валютную сумму
					ОцениваемаяБумага.СуммаРынокВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
						Новый Структура("СуммаРынок", СуммаРынок),
						СтрокиСтоимостей[0].ВалютаКотировки,
						ЭтотОбъект.Организация,
						ВыборкаДатаОперации.ДатаОперации,
						?(ЗначениеЗаполнено(СтрокиСтоимостей[0].КурсВалютыНоминала), СтрокиСтоимостей[0].КурсВалютыНоминала, Неопределено),
						Отказ).СуммаРынок;
				КонецЕсли;
				
				Если ОцениваемаяБумага.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
					Если СтрокиСтоимостей[0].ВалютаКотировкиКупона = ПараметрыРасчета.ВалютаУчета Тогда
						ОцениваемаяБумага.СуммаКупонаРынокВВалютеУчета = СуммаКупонаРынок;
						Если СтрокиСтоимостей[0].ВалютаКотировкиКупона <> ОцениваемаяБумага.ЦеннаяБумага.ВалютаНоминала Тогда // валютная бумага с рублевой котировкой
							ОцениваемаяБумага.СуммаКупонаРынок = ОцениваемаяБумага.Количество * СтрокиСтоимостей[0].ЦенаКупона; // Цена - в валюте номинала
						КонецЕсли;
					Иначе // вот тут есть заложенность на то, что если валюта котировке не в валюте учета, то она в валюте номинала - возможно, есть случаи опровергающие это, но пока прецедентов не было
						ОцениваемаяБумага.СуммаКупонаРынокВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
							Новый Структура("СуммаКупонаРынок", СуммаКупонаРынок),
							СтрокиСтоимостей[0].ВалютаКотировкиКупона,
							ЭтотОбъект.Организация,
							ВыборкаДатаОперации.ДатаОперации,
							?(ЗначениеЗаполнено(СтрокиСтоимостей[0].КурсВалютыНоминала), СтрокиСтоимостей[0].КурсВалютыНоминала, Неопределено),
							Отказ).СуммаКупонаРынок;
					КонецЕсли;
				Иначе
					ОцениваемаяБумага.СуммаКупонаРынок = 0;
					ОцениваемаяБумага.СуммаКупонаРынокВВалютеУчета = 0;					
				КонецЕсли;
				
			КонецЕсли;
			
			СтрокиОперацииСБумагами = ОперацииСБумагами.НайтиСтроки(Новый Структура("ДатаОперации,Рынок,ЦеннаяБумага,ВидДвижения", ВыборкаДатаОперации.ДатаОперации, ОцениваемаяБумага.Рынок, ОцениваемаяБумага.ЦеннаяБумага, ОцениваемаяБумага.ВидДвижения));
			
			ВсегоНачислено = Новый Структура("Количество,СуммаРынок,СуммаКупонаРынок,СуммаРынокВВалютеУчета,СуммаКупонаРынокВВалютеУчета", 0, 0, 0, 0, 0);
			
			Для каждого ОперацияСБумагой Из СтрокиОперацииСБумагами Цикл
			
				СтрокаПереоценкиДляОпераций = ПереоценкиДляОпераций.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПереоценкиДляОпераций, ОцениваемаяБумага);
				
				СтрокаПереоценкиДляОпераций.Ссылка = ОперацияСБумагой.Ссылка;
				
				КоэффициентПересчета = ОперацияСБумагой.Количество / ОцениваемаяБумага.Количество;
				
				СтрокаПереоценкиДляОпераций.ВидДвижения						= ОцениваемаяБумага.ВидДвижения;
				
				СтрокаПереоценкиДляОпераций.Количество						= ОперацияСБумагой.Количество;
				
				СтрокаПереоценкиДляОпераций.СуммаРынок						= ОцениваемаяБумага.СуммаРынок					* КоэффициентПересчета;
				СтрокаПереоценкиДляОпераций.СуммаКупонаРынок				= ОцениваемаяБумага.СуммаКупонаРынок				* КоэффициентПересчета;
				СтрокаПереоценкиДляОпераций.СуммаРынокВВалютеУчета			= ОцениваемаяБумага.СуммаРынокВВалютеУчета		* КоэффициентПересчета;
				СтрокаПереоценкиДляОпераций.СуммаКупонаРынокВВалютеУчета	= ОцениваемаяБумага.СуммаКупонаРынокВВалютеУчета	* КоэффициентПересчета;
				
				Если УчитыватьПогрешность Тогда
					
					ОбщийКоэффициентПересчета = (ВсегоНачислено.Количество + ОперацияСБумагой.Количество) / ОцениваемаяБумага.Количество;
					
					Для каждого Ресурс Из ВсегоНачислено Цикл
						ВсегоНачислено[Ресурс.Ключ]	= ВсегоНачислено[Ресурс.Ключ] + СтрокаПереоценкиДляОпераций[Ресурс.Ключ];
						Если Ресурс.Ключ <> "Количество" Тогда
							ДолжноБытьНачислено = Окр(ОцениваемаяБумага[Ресурс.Ключ] * ОбщийКоэффициентПересчета, 2);
							Дельта = ДолжноБытьНачислено - ВсегоНачислено[Ресурс.Ключ];
							Если Дельта <> 0 Тогда
								СтрокаПереоценкиДляОпераций[Ресурс.Ключ] = СтрокаПереоценкиДляОпераций[Ресурс.Ключ] + Дельта;
								ВсегоНачислено[Ресурс.Ключ] = ВсегоНачислено[Ресурс.Ключ] + Дельта;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				
				КонецЕсли;
			
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат  ПереоценкиДляОпераций;
	
КонецФункции

Процедура УчестьПогрешностиРублевыхСумм(Период, КурсПерекурсовки, ПриходныеПартии, МассивДвиженийНачисления, Отказ)

	КопияПриходныхПартийДляРасчетаПогрешностей = ПриходныеПартии.Скопировать();
	КопияПриходныхПартийДляРасчетаПогрешностей.Колонки.Добавить("КурсВалютыНоминала", Метаданные.ОпределяемыеТипы.КурсВалюты.Тип);
	КопияПриходныхПартийДляРасчетаПогрешностей.ЗаполнитьЗначения(КурсПерекурсовки, "КурсВалютыНоминала");
	
	КопияПриходныхПартийДляРасчетаПогрешностей.Колонки["ДисконтПремия"].Имя = "НачальныеДисконтПремия";
	
	КопияПриходныхПартийДляРасчетаПогрешностей.Колонки["ДисконтПремияНачисленный"].Имя = "ОценочныеДисконтПремия";
	КопияПриходныхПартийДляРасчетаПогрешностей.Колонки["ДисконтПремияНачисленныйВВалютеУчета"].Имя = "ОценочныеДисконтПремияВВалютеУчета";
	
	КопияПриходныхПартийДляРасчетаПогрешностей.Колонки["КорректировкаЭСП"].Имя = "ОценочнаяКорректировкаЭСП";
	КопияПриходныхПартийДляРасчетаПогрешностей.Колонки["КорректировкаЭСПВВалютеУчета"].Имя = "ОценочнаяКорректировкаЭСПВВалютеУчета";
	
	КопияПриходныхПартийДляРасчетаПогрешностей.Колонки["РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные"].Имя = "ОценочнаяРазницаППНеНаблюдаемыеДанные";
	КопияПриходныхПартийДляРасчетаПогрешностей.Колонки["РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета"].Имя = "ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета";
	
	
	ОбъектДляРасчетаПогрешностей = Новый Структура("Дата, Организация, СчетДоверительногоУправления");
	ОбъектДляРасчетаПогрешностей.Вставить("Дата", Период);
	ОбъектДляРасчетаПогрешностей.Вставить("Организация", ЭтотОбъект.Организация);
	ОбъектДляРасчетаПогрешностей.Вставить("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	ОбъектДляРасчетаПогрешностей.Вставить("ЦенныеБумаги", КопияПриходныхПартийДляРасчетаПогрешностей);
	
	РаботаСПереоценкой.РаспределитьПогрешностьОкругленияВалютныхСуммЕПС(ОбъектДляРасчетаПогрешностей, Отказ);
	
	Для каждого СтрокаЦенныеБумаги Из ОбъектДляРасчетаПогрешностей.ЦенныеБумаги Цикл
		СтрокаПриходныхПартий = ПриходныеПартии.Найти(СтрокаЦенныеБумаги.НомерСтроки, "НомерСтроки");
		
		СкорректироватьДП = СтрокаЦенныеБумаги.ОценочныеДисконтПремияВВалютеУчета - СтрокаПриходныхПартий.ДисконтПремияНачисленныйВВалютеУчета;
		СкорректироватьЭСП = СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСПВВалютеУчета - СтрокаПриходныхПартий.КорректировкаЭСПВВалютеУчета;
		СкорректироватьПП = СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета - СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета;
		
		Если СкорректироватьДП <> 0 ИЛИ СкорректироватьЭСП <> 0 ИЛИ СкорректироватьПП <> 0 Тогда
			
			Для каждого СтрокаДвиженийНачисления Из МассивДвиженийНачисления Цикл // приходится искать в цикле, благо это редко и массив не большой
				Если СтрокаДвиженийНачисления.Партия = СтрокаЦенныеБумаги.Партия 
					И СтрокаДвиженийНачисления.СтрокаПартии = СтрокаЦенныеБумаги.СтрокаПартии Тогда
				
					СтрокаДвиженийНачисления.ДисконтПремияНачисленныйВВалютеУчета = СтрокаДвиженийНачисления.ДисконтПремияНачисленныйВВалютеУчета + СкорректироватьДП;
