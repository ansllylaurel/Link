								ПогрешностьОкругления.СуммаЧастичногоПогашения = 0;
								ПогрешностьОкругления.СтоимостьПокупкиКупона = 0;
								
								Если ОтражатьНаПереоценкеПолнуюСуммуКупон Тогда
									ПогрешностьОкругления.СтоимостьКупона = 0;
								Иначе
									НовоеДвижение.СтоимостьКупона = Окр(СтрокаПриходныхПартий.СтоимостьКупона, 2);
									ПогрешностьОкругления.СтоимостьКупона = СтрокаПриходныхПартий.СтоимостьКупона - НовоеДвижение.СтоимостьКупона;
								КонецЕсли;
							
								НовоеДвижение.ПереоценкаКупонаВСтоимости = Окр(СтрокаПриходныхПартий.ПереоценкаКупонаВСтоимости, 2);
								ПогрешностьОкругления.ПереоценкаКупонаВСтоимости = СтрокаПриходныхПартий.ПереоценкаКупонаВСтоимости - НовоеДвижение.ПереоценкаКупонаВСтоимости;
							
								НовоеДвижение.ПереоценкаКупона = Окр(СтрокаПриходныхПартий.ПереоценкаКупона, 2);
								ПогрешностьОкругления.ПереоценкаКупона = СтрокаПриходныхПартий.ПереоценкаКупона - НовоеДвижение.ПереоценкаКупона;
							
							КонецЕсли;
						
						КонецЕсли;
						
						СтрокаПриходныхПартий.ПереоценкаКупонаВСтоимости = 0;
						СтрокаПриходныхПартий.ПереоценкаКупона = 0;
						СтрокаПриходныхПартий.ПереоценкаКупонавВалютеУчета = 0;
						Если НЕ ОтражатьНаПереоценкеПолнуюСуммуКупон Тогда
							СтрокаПриходныхПартий.СтоимостьКупона = 0;
							СтрокаПриходныхПартий.СтоимостьКупонаВВалютеУчета = 0;
						КонецЕсли;
					КонецЦикла;
					
					СтрокиПартийПроданныхВРЕПО = ПартииПроданныеВРЕПО.НайтиСтроки(Новый Структура("ЦеннаяБумага", ВыборкаДетальныеЗаписи.ЦеннаяБумага));
					Для Каждого СтрокаПартииПроданнойВРЕПО ИЗ СтрокиПартийПроданныхВРЕПО Цикл
						
						НовоеДвижение = Перекурсовка(ВыборкаДетальныеЗаписи.Регистратор, ЭтотОбъект.РассчитанныеПартииПрямоеРЕПО, ВыборкаДетальныеЗаписи.Период, СтрокаПартииПроданнойВРЕПО, СтрокаПартииПроданнойВРЕПО.Количество, ВыборкаДетальныеЗаписи.СтрокаПартии,,,, Отказ);
						НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
						
						Если Отказ Тогда
							Возврат;
						КонецЕсли;
						
						НовоеДвижение = ЭтотОбъект.РассчитанныеПартииПрямоеРЕПО.Добавить();
						ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаПартииПроданнойВРЕПО);
						
						НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Расход;
						НовоеДвижение.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
						НовоеДвижение.Период = ВыборкаДетальныеЗаписи.Период;
						НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
						
						НовоеДвижение.Количество = 0;
						НовоеДвижение.СтоимостьПокупки = 0;
						НовоеДвижение.ПереоценкаВСтоимости = 0;
						НовоеДвижение.СтоимостьПокупкиКупона = 0;
						Если ОтражатьНаПереоценкеПолнуюСуммуКупон Тогда
							НовоеДвижение.СтоимостьКупона = 0;
							НовоеДвижение.СтоимостьКупонаВВалютеУчета = 0;
						КонецЕсли;
						НовоеДвижение.РасходыПриПокупкеВСтоимости = 0;
						НовоеДвижение.Стоимость = 0;
						НовоеДвижение.СтоимостьВВалютеУчета = 0;
						НовоеДвижение.Переоценка = 0;
						НовоеДвижение.ПереоценкаВВалютеУчета = 0;
						НовоеДвижение.СуммаЧастичногоПогашения = 0;
						НовоеДвижение.ИндексацияНоминала = 0;
						НовоеДвижение.ИндексацияНоминалаЗаВремяВладения = 0;
						
						СтрокаПартииПроданнойВРЕПО.ПереоценкаКупонаВСтоимости = 0;
						СтрокаПартииПроданнойВРЕПО.ПереоценкаКупона = 0;
						СтрокаПартииПроданнойВРЕПО.ПереоценкаКупонавВалютеУчета = 0;
						Если НЕ ОтражатьНаПереоценкеПолнуюСуммуКупон Тогда
							СтрокаПартииПроданнойВРЕПО.СтоимостьКупона = 0;
							СтрокаПартииПроданнойВРЕПО.СтоимостьКупонаВВалютеУчета = 0;
						КонецЕсли;
					КонецЦикла;
					
					#КонецОбласти

				ИначеЕсли (ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги")
						  ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.СписаниеЦеннойБумаги"))
						  И ЭтоРынокОблигаций Тогда
						  
					#Область ПогашениеИлиСписаниеОблигации
					
					Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги")
						 И РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].ВидПогашения <> Перечисления.ВидыПогашения.ЧастичноеПогашение
						 И ВариантПогашения = Перечисления.ВариантыОтраженияДебиторскойЗадолженностиПриПолномПогашенииОблигаций.НаМоментСписания Тогда
						Продолжить;
					КонецЕсли;
						  
					КоличествоКСписанию = ПриходныеПартии.Итог("Количество"); // по умолчанию списываем все количество, что есть
					Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") 
						И РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].ВидПогашения = Перечисления.ВидыПогашения.Оферта Тогда
						КоличествоКСписанию = РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].Количество; // но возможно, что погашаем не все бумаги
					ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.СписаниеЦеннойБумаги") Тогда 
						КоличествоКСписанию = ВыборкаДетальныеЗаписи.Количество; // списание также возможно на часть бумаг
					КонецЕсли;
					
					Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") И НастройкиПоВидуУчета.ПереоцениватьАктивыПередПродажей Тогда
					
						ПереоценкаПередПродажами = ПереоценкиДляОпераций.НайтиСтроки(Новый Структура("Ссылка,ЦеннаяБумага,ВидДвижения",
															ВыборкаДетальныеЗаписи.Регистратор,
															ВыборкаДетальныеЗаписи.ЦеннаяБумага,
															Перечисления.ВидыДвижений.ПустаяСсылка()));
															
						Если ПереоценкаПередПродажами.Количество() <> 1 Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить цену бумаги перед продажей:" + Строка(ВыборкаДетальныеЗаписи.Регистратор) + " / "+ Строка(ВыборкаДетальныеЗаписи.ЦеннаяБумага));
							Отказ = Истина;
						КонецЕсли;
						
						СуммаРынокВсего = ПереоценкаПередПродажами[0].СуммаРынок;
						СуммаРынокВВалютеУчетаВсего = ПереоценкаПередПродажами[0].СуммаРынокВВалютеУчета;
						ОбщееКоличество = ПереоценкаПередПродажами[0].Количество;
					
					КонецЕсли;
					
					
					ПриходныеПартииКУдалению = Новый Массив;
					
					Для каждого СтрокаПриходныхПартий Из ПриходныеПартии Цикл //Спишем либо все приходные партии либо пропорционально части номинала
						
						Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.СписаниеЦеннойБумаги")
							 ИЛИ РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].ВидПогашения = Перечисления.ВидыПогашения.ПолноеПогашение Тогда
							 
							Если КоличествоКСписанию = 0 Тогда // все списали
								Прервать;
							КонецЕсли;
							
							// Списание и полное погашение гасят все партии
							
							Если ВариантПогашения = Перечисления.ВариантыОтраженияДебиторскойЗадолженностиПриПолномПогашенииОблигаций.НаМоментПогашения
						 		И ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.СписаниеЦеннойБумаги") Тогда
								//движений по деньгам не делаем, двигаем только количество
								
							Иначе

								НовоеДвижение = Перекурсовка(ВыборкаДетальныеЗаписи.Регистратор, ЭтотОбъект.РассчитанныеПартии, ВыборкаДетальныеЗаписи.Период, СтрокаПриходныхПартий, СтрокаПриходныхПартий.Количество, ВыборкаДетальныеЗаписи.СтрокаПартии,,,, Отказ);
								НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
							
								Если Отказ Тогда
									Возврат;
								КонецЕсли;
								
								Если ИндексируемыйНоминал И ИндексироватьНоминал Тогда
									НовоеДвижение = ИндексацияНоминала(ВыборкаДетальныеЗаписи.Регистратор,
																		ВыборкаДетальныеЗаписи.Период,
																		СтрокаПриходныхПартий,
																		СтрокаПриходныхПартий.Количество,
																		УчитыватьИндексациюОтдельно,
																		Отказ);
									СтрокаПриходныхПартий.ИндексацияНоминала = СтрокаПриходныхПартий.ИндексацияНоминала + НовоеДвижение.ИндексацияНоминала;
									СтрокаПриходныхПартий.ИндексацияНоминалаЗаВремяВладения = СтрокаПриходныхПартий.ИндексацияНоминалаЗаВремяВладения + НовоеДвижение.ИндексацияНоминалаЗаВремяВладения;									
								КонецЕсли;	
								
							КонецЕсли;
							
							НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
							ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаПриходныхПартий);
							
							НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Расход;
							НовоеДвижение.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
							НовоеДвижение.Период = ВыборкаДетальныеЗаписи.Период;
							НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
							
							//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.СписаниеПартии;
							
							Если НастройкиПоВидуУчета.МетодОпределенияДоходовИРасходов <> Перечисления.МетодыОпределенияДоходовИРасходов.Кассовый
								И ВариантПогашения = Перечисления.ВариантыОтраженияДебиторскойЗадолженностиПриПолномПогашенииОблигаций.НаМоментПогашения
						 		И ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.СписаниеЦеннойБумаги") Тогда
								
								//списываем только количество, суммы списало погашение
								Для Каждого Ресурс из РесурсыПартий Цикл
									Если Ресурс = "Количество" Тогда 
										Продолжить; 
									КонецЕсли;
									НовоеДвижение[Ресурс] = 0;
								КонецЦикла;
							
							КонецЕсли;
							
							Спишем = Мин(КоличествоКСписанию, НовоеДвижение.Количество);
							
							Если Спишем < НовоеДвижение.Количество Тогда
								Для Каждого Ресурс из РесурсыПартий Цикл
									НовоеДвижение[Ресурс] = НовоеДвижение[Ресурс] * Спишем / НовоеДвижение.Количество;
									СтрокаПриходныхПартий[Ресурс] = СтрокаПриходныхПартий[Ресурс] - НовоеДвижение[Ресурс];
								КонецЦикла;
							Иначе
								ПриходныеПартииКУдалению.Добавить(СтрокаПриходныхПартий);
							КонецЕсли;
							
							КоличествоКСписанию = КоличествоКСписанию - Спишем;
							
							Если НастройкиПоВидуУчета.ТочностьРасчетаСтоимостиПартий > 2 Тогда
								//для сумм в валюте учета по ка пропускаю
								Если (СтрокаПриходныхПартий.СтоимостьПокупки - Окр(СтрокаПриходныхПартий.СтоимостьПокупки, 2) <> 0)
									 ИЛИ (СтрокаПриходныхПартий.СтоимостьПокупкиКупона - Окр(СтрокаПриходныхПартий.СтоимостьПокупкиКупона, 2) <> 0)
									 ИЛИ (СтрокаПриходныхПартий.РасходыПриПокупкеВСтоимости - Окр(СтрокаПриходныхПартий.РасходыПриПокупкеВСтоимости, 2) <> 0)
									 ИЛИ (СтрокаПриходныхПартий.РасходыПриПокупкеВСтоимостиВВалютеУчета - Окр(СтрокаПриходныхПартий.РасходыПриПокупкеВСтоимостиВВалютеУчета, 2) <> 0)
									 ИЛИ (СтрокаПриходныхПартий.ПереоценкаВСтоимости - Окр(СтрокаПриходныхПартий.ПереоценкаВСтоимости, 2) <> 0)
									 ИЛИ (СтрокаПриходныхПартий.ПереоценкаКупонаВСтоимости - Окр(СтрокаПриходныхПартий.ПереоценкаКупонаВСтоимости, 2) <> 0)
									 ИЛИ (СтрокаПриходныхПартий.Стоимость - Окр(СтрокаПриходныхПартий.Стоимость, 2) <> 0)
									 ИЛИ (СтрокаПриходныхПартий.СтоимостьКупона - Окр(СтрокаПриходныхПартий.СтоимостьКупона, 2) <> 0)
									 ИЛИ (СтрокаПриходныхПартий.Переоценка - Окр(СтрокаПриходныхПартий.Переоценка, 2) <> 0)
									 ИЛИ (СтрокаПриходныхПартий.ПереоценкаКупона - Окр(СтрокаПриходныхПартий.ПереоценкаКупона, 2) <> 0)
									 Тогда
									
									ПогрешностьОкругления = ПогрешностиОкругления.Добавить();
									
									ЗаполнитьЗначенияСвойств(ПогрешностьОкругления, СтрокаПриходныхПартий);
									ПогрешностьОкругления.ВидДвижения = Перечисления.ВидыДвижений.Расход;
									ПогрешностьОкругления.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
									ПогрешностьОкругления.Период = ВыборкаДетальныеЗаписи.Период;
									ПогрешностьОкругления.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
									
									НовоеДвижение.СтоимостьПокупки = Окр(СтрокаПриходныхПартий.СтоимостьПокупки, 2);
									ПогрешностьОкругления.СтоимостьПокупки = СтрокаПриходныхПартий.СтоимостьПокупки - НовоеДвижение.СтоимостьПокупки;
								
									НовоеДвижение.СтоимостьПокупкиКупона = Окр(СтрокаПриходныхПартий.СтоимостьПокупкиКупона, 2);
									ПогрешностьОкругления.СтоимостьПокупкиКупона = СтрокаПриходныхПартий.СтоимостьПокупкиКупона - НовоеДвижение.СтоимостьПокупкиКупона;
								
									НовоеДвижение.РасходыПриПокупкеВСтоимости = Окр(СтрокаПриходныхПартий.РасходыПриПокупкеВСтоимости, 2);
									ПогрешностьОкругления.РасходыПриПокупкеВСтоимости = СтрокаПриходныхПартий.РасходыПриПокупкеВСтоимости - НовоеДвижение.РасходыПриПокупкеВСтоимости;
								
									НовоеДвижение.РасходыПриПокупкеВСтоимостиВВалютеУчета = Окр(СтрокаПриходныхПартий.РасходыПриПокупкеВСтоимостиВВалютеУчета, 2);
									ПогрешностьОкругления.РасходыПриПокупкеВСтоимостиВВалютеУчета = СтрокаПриходныхПартий.РасходыПриПокупкеВСтоимостиВВалютеУчета - НовоеДвижение.РасходыПриПокупкеВСтоимостиВВалютеУчета;
								
									НовоеДвижение.ПереоценкаВСтоимости = Окр(СтрокаПриходныхПартий.ПереоценкаВСтоимости, 2);
									ПогрешностьОкругления.ПереоценкаВСтоимости = СтрокаПриходныхПартий.ПереоценкаВСтоимости - НовоеДвижение.ПереоценкаВСтоимости;
								
									НовоеДвижение.ПереоценкаКупонаВСтоимости = Окр(СтрокаПриходныхПартий.ПереоценкаКупонаВСтоимости, 2);
									ПогрешностьОкругления.ПереоценкаКупонаВСтоимости = СтрокаПриходныхПартий.ПереоценкаКупонаВСтоимости - НовоеДвижение.ПереоценкаКупонаВСтоимости;
								
									НовоеДвижение.Стоимость = Окр(СтрокаПриходныхПартий.Стоимость, 2);
									ПогрешностьОкругления.Стоимость = СтрокаПриходныхПартий.Стоимость - НовоеДвижение.Стоимость;
								
