							КонецЕсли;
							
							СтрокаПартииКупленныеПоРЕПОПоСделке.ПереоценкаКупона = СтрокаПартииКупленныеПоРЕПОПоСделке.ПереоценкаКупона + НовоеДвижение.ПереоценкаКупона;
							СтрокаПартииКупленныеПоРЕПОПоСделке.ПереоценкаКупонаВВалютеУчета = СтрокаПартииКупленныеПоРЕПОПоСделке.ПереоценкаКупонаВВалютеУчета + НовоеДвижение.ПереоценкаКупонаВВалютеУчета;
							
						КонецЕсли;
						
						// запомним, что удалить надо из репошных 
						ПартииКупленныеПоРЕПОКУдалению.Добавить(СтрокаПартииКупленныеПоРЕПОПоСделке);
						
						// движение по партиям РЕПО расход сделать
						НовоеДвижениеРЕПО = РассчитанныеПартииОбратноеРЕПО.Добавить();
						ЗаполнитьЗначенияСвойств(НовоеДвижениеРЕПО, СтрокаПартииКупленныеПоРЕПОПоСделке);
						
						НовоеДвижениеРЕПО.ВидДвижения = Перечисления.ВидыДвижений.Расход;
						НовоеДвижениеРЕПО.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
						НовоеДвижениеРЕПО.Период = ВыборкаДетальныеЗаписи.Период;
						НовоеДвижениеРЕПО.СтрокаКорзиныЦенныхБумаг = СтрокаПартииКупленныеПоРЕПОПоСделке.СтрокаПартии;
						
					КонецЦикла;
					
					// удалим партии РЕПО
					Для каждого СтрокаПартииКупленныеПоРЕПОКУдалению Из ПартииКупленныеПоРЕПОКУдалению Цикл
						ПартииКупленныеПоРЕПО.Удалить(СтрокаПартииКупленныеПоРЕПОКУдалению);
					КонецЦикла;
					
				Иначе
					
					//Остальные расходы спишем с приходов. Остальные это 
					
					ДокументыДляСписания = ПустаяТаблица.СкопироватьКолонки();
					
					Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.Сделка") //по этим документам неясен учетный актив ЕПС
						 ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.СделкаРЕПО")
						 ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке")
						 ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг") Тогда
						 
						КоличествоРаспределить = ВыборкаДетальныеЗаписи.Количество;
						ТекСделка = ВыборкаДетальныеЗаписи.Регистратор;
						Если ТипЗнч(ТекСделка) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке")
						ИЛИ ТипЗнч(ТекСделка) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг") Тогда
							ТекСделка = ВыборкаДетальныеЗаписи.Основание;
						КонецЕсли;
						
						РаспределенияПоТекущейСделкеИБумаге = РаспределенияПоСделкам.НайтиСтроки(Новый Структура("Сделка, ЦеннаяБумага", ТекСделка, ВыборкаДетальныеЗаписи.ЦеннаяБумага));
						
						Для каждого СтрокаРаспределенияПоСделкам Из РаспределенияПоТекущейСделкеИБумаге Цикл
							Если СтрокаРаспределенияПоСделкам.Количество = 0 Тогда
								Продолжить;
							КонецЕсли;
							
							СтрокаДокументыДляСписания = ДокументыДляСписания.Добавить();
							
							ЗаполнитьЗначенияСвойств(СтрокаДокументыДляСписания, ВыборкаДетальныеЗаписи);
							
							СтрокаДокументыДляСписания.УчетныйАктивЕПС = СтрокаРаспределенияПоСделкам.УчетныйАктивЕПС;
							СтрокаДокументыДляСписания.Количество = МИН(СтрокаРаспределенияПоСделкам.Количество, КоличествоРаспределить);
							
							СтрокаРаспределенияПоСделкам.Количество = СтрокаРаспределенияПоСделкам.Количество - СтрокаДокументыДляСписания.Количество;
							
							КоличествоРаспределить = КоличествоРаспределить - СтрокаДокументыДляСписания.Количество;
							Если КоличествоРаспределить = 0 Тогда
								Прервать;
							КонецЕсли;
							
						КонецЦикла;
						
						Если КоличествоРаспределить <> 0 Тогда // по части активов неясно как их распределять - распределение определяем по приходным партиям
						
							СтрокаДокументыДляСписания = ДокументыДляСписания.Добавить();
							ЗаполнитьЗначенияСвойств(СтрокаДокументыДляСписания, ВыборкаДетальныеЗаписи);
							СтрокаДокументыДляСписания.УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПустаяСсылка(); // и УчетныйАктивЕПС неизвестен
							СтрокаДокументыДляСписания.Количество = КоличествоРаспределить;
						
						КонецЕсли;
						
					Иначе
						СтрокаДокументыДляСписания = ДокументыДляСписания.Добавить();
						ЗаполнитьЗначенияСвойств(СтрокаДокументыДляСписания, ВыборкаДетальныеЗаписи);
						
						Если СтрокаДокументыДляСписания.УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПустаяСсылка() Тогда
							// попытаемся определить актив из приходных партий
							МассивУчетныхАктивов = ПриходныеПартии.ВыгрузитьКолонку("УчетныйАктивЕПС");
							РаботаСКоллекциями.УдалитьПовторяющиесяЗначенияМассива(МассивУчетныхАктивов);
							Если МассивУчетныхАктивов.Количество() > 1  Тогда
								
								ТекстСообщения = СтрШаблон("По ценной бумаге: %1 есть несколько учетных активов. Но в %2 учетный актив не задан!", 
								Строка(ВыборкаДетальныеЗаписи.ЦеннаяБумага), 
								Строка(ВыборкаДетальныеЗаписи.Регистратор));
								
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
							Иначе
								СтрокаДокументыДляСписания.УчетныйАктивЕПС = МассивУчетныхАктивов[0];
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
					
					КоличествоКСписаниюВсего = ДокументыДляСписания.Итог("Количество");
					Если РассчитыватьСтоимости
						И НастройкиПоВидуУчета.ПереоцениватьАктивыПередВыводом
						И НЕ НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316
						И ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ВыводЦенныхБумаг")
						И (ВыборкаДетальныеЗаписи.УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПустаяСсылка() ИЛИ
							ПереоцениваемыеГруппыАктивов.Найти(ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.Родитель) <> Неопределено)
						И ПереоценкиПередВыводами <> Неопределено // это возникает когда расчет динамический, а бумага по АС и расчет переопределился на нединамический, но для АС переоценка смысла не имеет
					Тогда
					
						ПереоценкаПередВыводами = ПереоценкиПередВыводами.НайтиСтроки(Новый Структура("Ссылка,ЦеннаяБумага",
															ВыборкаДетальныеЗаписи.Регистратор,
															ВыборкаДетальныеЗаписи.ЦеннаяБумага));
															
						Если ПереоценкаПередВыводами.Количество() <> 1 Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить цену бумаги при выводе:" + Строка(ВыборкаДетальныеЗаписи.Регистратор) + " / "+ Строка(ВыборкаДетальныеЗаписи.ЦеннаяБумага));
							Отказ = Истина;
						КонецЕсли;
						
						СуммаРынокВсего = ПереоценкаПередВыводами[0].СуммаРынок;
						СуммаРынокВВалютеУчетаВсего = ПереоценкаПередВыводами[0].СуммаРынокВВалютеУчета;
						
					ИначеЕсли РассчитыватьСтоимости
						И НастройкиПоВидуУчета.ПереоцениватьАктивыПередПродажей
						И НЕ НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316
						И ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) <> Тип("ДокументСсылка.ВыводЦенныхБумаг")
						И (ВыборкаДетальныеЗаписи.УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПустаяСсылка() ИЛИ
							ПереоцениваемыеГруппыАктивов.Найти(ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.Родитель) <> Неопределено)
						И ПереоценкиДляОпераций <> Неопределено // это возникает когда расчет динамический, а бумага по АС и расчет переопределился на нединамический, но для АС переоценка смысла не имеет
					Тогда
						
						ПереоценкаПередПродажами = ПереоценкиДляОпераций.НайтиСтроки(Новый Структура("Ссылка,ЦеннаяБумага,ВидДвижения",
															ВыборкаДетальныеЗаписи.Регистратор,
															ВыборкаДетальныеЗаписи.ЦеннаяБумага,
															Перечисления.ВидыДвижений.Расход));
															
						Если ПереоценкаПередПродажами.Количество() <> 1 Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить цену бумаги при продаже:" + Строка(ВыборкаДетальныеЗаписи.Регистратор) + " / "+ Строка(ВыборкаДетальныеЗаписи.ЦеннаяБумага));
							Отказ = Истина;
						КонецЕсли;
						
						СуммаРынокВсего = ПереоценкаПередПродажами[0].СуммаРынок;
						СуммаРынокВВалютеУчетаВсего = ПереоценкаПередПродажами[0].СуммаРынокВВалютеУчета;
						
					КонецЕсли;
					
					Для каждого СтрокаДокументыДляСписания Из ДокументыДляСписания Цикл
					
						ПриходныеПартииКУдалению = Новый Массив;
						ПриходныеПартииКУдалениюРЕПО = Новый Массив;
						
						КоличествоКСписанию = СтрокаДокументыДляСписания.Количество;
						СписываемыйУчетныйАктивЕПС = СтрокаДокументыДляСписания.УчетныйАктивЕПС;
						
						Если РассчитыватьСтоимости И ДанныеПоЦеннойБумаге.ЭтоОблигация Тогда
							
							Если ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки = 0 Тогда
								СуммаКупонаНаОднуОблигацию = Справочники.Облигации.ПолучитьКупон(ВыборкаДетальныеЗаписи.ЦеннаяБумага, НачалоДня(ВыборкаДетальныеЗаписи.Период), СчетДоверительногоУправленияДляУчета);
							Иначе
								СуммаКупонаНаОднуОблигацию = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(ВыборкаДетальныеЗаписи.ЦеннаяБумага, НачалоДня(ВыборкаДетальныеЗаписи.Период), СчетДоверительногоУправленияДляУчета, Истина, 6);
							КонецЕсли;
							
						КонецЕсли; 
						
						// для бумаг по АС берем данные по начальным дисконту/премии из первички (#404807)
						// это связано с тем, что у них комиссия идет в стоимость и требуется точность, большая чем может обеспечить ресурс ДисконтПремияПокупки
						// #436580 - для организации ДК сделано упрощение расчетов
						ИспользоватьПервичныеДанныеДляОпределенияЦеныПриобретения = (ПриходныеПартии.Найти(Истина, "ВключатьРасходыПоПокупкеВСтоимость") <> Неопределено) И НЕ Организация_ДК;
						
						Если ИспользоватьПервичныеДанныеДляОпределенияЦеныПриобретения Тогда
							ДатыИЦеныПокупки = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(ПриходныеПартии, СчетДоверительногоУправленияДляУчета, ВыборкаДетальныеЗаписи.Период).Выгрузить();
						Иначе 
							ДатыИЦеныПокупки = Неопределено;
						КонецЕсли;
						
						Для каждого СтрокаПриходныхПартий Из ПриходныеПартии Цикл
							
							Если СтрокаПриходныхПартий.УчетныйАктивЕПС <> СписываемыйУчетныйАктивЕПС
								И СписываемыйУчетныйАктивЕПС <> Справочники.УчетныеАктивыЕПС.ПустаяСсылка() Тогда
								Продолжить;
							КонецЕсли;
							
							Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ВыводЦенныхБумаг")
								И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Партия) Тогда
							
								Если СтрокаПриходныхПартий.Партия <> ВыборкаДетальныеЗаписи.Партия
									ИЛИ СтрокаПриходныхПартий.СтрокаПартии <> ВыборкаДетальныеЗаписи.СтрокаПартии Тогда
									
									Продолжить;
								
								КонецЕсли;	
							
							КонецЕсли;
							
							Если СтрокаПриходныхПартий.Количество <= КоличествоКСписанию Тогда
								КоличествоКСписаниюПартии = СтрокаПриходныхПартий.Количество;
							Иначе
								КоличествоКСписаниюПартии = КоличествоКСписанию;
							КонецЕсли;
							
							КоличествоКСписаниюВсего = КоличествоКСписаниюВсего - КоличествоКСписаниюПартии;
							
							НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
								НастройкиУчетаОбщие,
								СтрокаПриходныхПартий.ЦеннаяБумага,
								СтрокаПриходныхПартий.УчетныйАктивЕПС,
								СтрокаПриходныхПартий.Партия,
								СтрокаПриходныхПартий.СтрокаПартии);
							
							Если РассчитыватьСтоимости Тогда
								
								ЭтоФинстандартПослеДефолтаКоторыйУжеНеКурсуем = 
									(СтрокаПриходныхПартий.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финстандарт")
									И НачалоДня(ВыборкаДетальныеЗаписи.Период) > '20200605');
								
								НовоеДвижениеПерекурсовка = Неопределено;
								Если ДанныеПоЦеннойБумаге.ЭтоВалютнаяБумага И НЕ ЭтоФинстандартПослеДефолтаКоторыйУжеНеКурсуем Тогда // возможно, будем делать перекурсовку
									Если ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки = 0 Тогда // бумагу перекурсовываем по курсу ЦБ
										НовоеДвижениеПерекурсовка = Перекурсовка(ВыборкаДетальныеЗаписи.Регистратор,
											ЭтотОбъект.РассчитанныеПартии,
											ВыборкаДетальныеЗаписи.Период,
											СтрокаПриходныхПартий,
											КоличествоКСписаниюПартии,
											ВыборкаДетальныеЗаписи.СтрокаПартии,
											,
											,
											,
											Отказ);
									ИначеЕсли ДанныеПоЦеннойБумаге.ЭтоДефолтнаяОблигация			// у дефолтных валютных облигаций есть фишка: их общая стоимость равна нулю путем отрицательной переоценки, но!
										И НЕ УчитыватьВсеЧастиСтоимостиПоФиксированномуКурсу Тогда 	// если клиент не считает все части по 1му курсу
														
										РесурсыКПерекурсовке = Новый Массив();
										РесурсыКПерекурсовке.Добавить("СтоимостьВВалютеУчета");		// тело идет по курсу ЦБ и курсуется, а переоценка делается такой, чтобы выйти в ноль 
										
										НовоеДвижениеПерекурсовка = Перекурсовка(ВыборкаДетальныеЗаписи.Регистратор,
											ЭтотОбъект.РассчитанныеПартии,
											ВыборкаДетальныеЗаписи.Период,
											СтрокаПриходныхПартий,
											КоличествоКСписаниюПартии,
											ВыборкаДетальныеЗаписи.СтрокаПартии,
											,
											РесурсыКПерекурсовке,
											,
											Отказ);
									КонецЕсли;
								КонецЕсли;
								
								НовоеДвижениеПереоценки = Неопределено;
								
								ЭтоБумагаБезДатыПогашения		= (ДанныеПоЦеннойБумаге.ДатаПогашения = '00010101');
								ЭтоБумагаСПрошедшимПогашением	= (ДанныеПоЦеннойБумаге.ДатаПогашения < НачалоДня(ВыборкаДетальныеЗаписи.Период));
								ЭтоВыводКоторыйНеСчитаем		= (ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ВыводЦенныхБумаг")
									И НастройкиУчетаОбщие.НеСчитатьВводыВыводыЦенныхБумагОперациямиДляНачисленияПроцентногоДохода);
								ЭтоПромсвязьПоКоторойНичегоНеНачисляем = (СтрокаПриходныхПартий.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ПромСвязьКапитал_001"));
								
								Если ДанныеПоЦеннойБумаге.ЭтоОблигация
									И НЕ ДанныеПоЦеннойБумаге.ЭтоДефолтнаяОблигация
									И НЕ ЭтоБумагаБезДатыПогашения
									И НЕ ЭтоБумагаСПрошедшимПогашением
									И НЕ ЭтоВыводКоторыйНеСчитаем
									И НЕ ЭтоПромсвязьПоКоторойНичегоНеНачисляем Тогда
								
									НовоеДвижениеПереоценки = ДоначислитьКупон(ВыборкаДетальныеЗаписи.Регистратор,
																							ВыборкаДетальныеЗаписи.Период,
																							СтрокаПриходныхПартий,
																							СуммаКупонаНаОднуОблигацию,
																							КоличествоКСписаниюПартии,
																							ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки, 
																							0,
																							Ложь,
																							Отказ);
									//НовоеДвижениеПереоценкиКупона.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.ПереоценкаИНачислениеПроцентов;
																							
									ДатаПокупки	= СтрокаПриходныхПартий.ДатаПокупки;
									ДатаПокупкиНачальная = СтрокаПриходныхПартий.ДатаПокупкиНачальная;
									КорректировкаЭСПНачальная = СтрокаПриходныхПартий.КорректировкаЭСПНачальная;
									ЦенаПокупкиНачальная = СтрокаПриходныхПартий.СтоимостьПокупкиНачальная / СтрокаПриходныхПартий.Количество;
									
									Если ДатыИЦеныПокупки = Неопределено Тогда
										
										НачальныйДисконт  = Окр(СтрокаПриходныхПартий.ДисконтПремияПокупки / СтрокаПриходныхПартий.Количество, РазрядностьДробнойЧасти);
										
										Если ДанныеПоЦеннойБумаге.Амортизационная Тогда
											ЦенаПокупки	= Справочники.Облигации.ПолучитьНоминал(СтрокаПриходныхПартий.ЦеннаяБумага, ДатаПокупки) + НачальныйДисконт;
										Иначе
											ЦенаПокупки	= СтрокаПриходныхПартий.Номинал + НачальныйДисконт;
										КонецЕсли;
										ЦенаПокупкиКупона	= Окр(СтрокаПриходныхПартий.СтоимостьПокупкиКупона / СтрокаПриходныхПартий.Количество, РазрядностьДробнойЧасти);
										
									Иначе
										
										ДатаИЦенаПокупки = ДатыИЦеныПокупки.НайтиСтроки(Новый Структура("НомерСтроки", СтрокаПриходныхПартий.НомерСтроки));
										
										НачальныйДисконт 	= ДатаИЦенаПокупки[0].НачальныйДисконт;
										ЦенаПокупки 		= ДатаИЦенаПокупки[0].ЦенаПокупки;
										ЦенаПокупкиКупона 	= ДатаИЦенаПокупки[0].ЦенаКупона;
										
									КонецЕсли;
																							
									ДанныеПереоценки = Новый Структура("УчетныйАктивЕПС, Партия, СтрокаПартии");
									ЗаполнитьЗначенияСвойств(ДанныеПереоценки, СтрокаПриходныхПартий, "УчетныйАктивЕПС, Партия, СтрокаПартии");
									ДанныеПереоценки.Вставить("Количество", КоличествоКСписаниюПартии);
									ДанныеПереоценки.Вставить("ДатаПереоценки", НачалоДня(ВыборкаДетальныеЗаписи.Период));
									ДанныеПереоценки.Вставить("ОценочнаяСуммаКупона", СуммаКупонаНаОднуОблигацию * КоличествоКСписаниюПартии);
									ДанныеПереоценки.Вставить("БалансовыйДисконт", СтрокаПриходныхПартий.ДисконтПремияНачисленный * КоличествоКСписаниюПартии / СтрокаПриходныхПартий.Количество);
									ДанныеПереоценки.Вставить("БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные * КоличествоКСписаниюПартии / СтрокаПриходныхПартий.Количество);
									ДанныеПереоценки.Вставить("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
									ДанныеПереоценки.Вставить("Стоимость", СтрокаПриходныхПартий.Стоимость * КоличествоКСписаниюПартии / СтрокаПриходныхПартий.Количество);
									
									ДанныеПокупки = Новый Структура;
									ДанныеПокупки.Вставить("НачальныйДисконт", НачальныйДисконт);
									ДанныеПокупки.Вставить("ДатаПокупки", ДатаПокупки);
									ДанныеПокупки.Вставить("ДатаПокупкиНачальная", ДатаПокупкиНачальная);
									ДанныеПокупки.Вставить("КорректировкаЭСПНачальная", КорректировкаЭСПНачальная);
									ДанныеПокупки.Вставить("ЦенаПокупки", ЦенаПокупки);
									ДанныеПокупки.Вставить("НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная / СтрокаПриходныхПартий.Количество);
									ДанныеПокупки.Вставить("ЦенаПокупкиКупона", ЦенаПокупкиКупона);
									ДанныеПокупки.Вставить("ЦенаПокупкиНачальная", ЦенаПокупкиНачальная);

																
									// #458445 - так как с 01.01.23 переходим на переоценку/начисление %ных доходов при выводах и продажах всегда
									// то, теперь по умолчанию корректировка ЭСП перед выводом продажей начисляться будет (если бумага по АС, конечно)
									// а если клиенту не надо - пусть шлет письмо, будем хардкодить
									// т.е. меняем схему наоборот для корректировки ЭСП
									Если НачалоДня(ВыборкаДетальныеЗаписи.Период) >= '20230101' Тогда
									    Если СтрокаПриходныхПартий.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость Тогда
											НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода = Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке;	// принудительно посчитать ЭСП
										КонецЕсли;
									Иначе	
										// #368618 - спец. письмо от Эволюции "начислить ЭСП" перед выводом
										РоссетиПАО24032021 = (СтрокаПриходныхПартий.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_РоссетиПАО_002")
												 			   И НачалоДня(ВыборкаДетальныеЗаписи.Период) = '20210324'
												 			   И Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправленияДляУчета, ВыборкаДетальныеЗаписи.Период) 
															   		= ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Эволюция"));
																	
										Сафмар250521ОткрытиеОткрытиеИПСБ = (Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправленияДляУчета, ВыборкаДетальныеЗаписи.Период) 
															   		= ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар") // САФМАР
																И НачалоДня(ВыборкаДетальныеЗаписи.Период) = '20210525'
																И (СтрокаПриходныхПартий.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОткрытиеХолдинг")
																	ИЛИ СтрокаПриходныхПартий.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОткрХолдинг_004")
																	ИЛИ СтрокаПриходныхПартий.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ПСБ_013")));
																	
										Если РоссетиПАО24032021 ИЛИ Сафмар250521ОткрытиеОткрытиеИПСБ Тогда
											НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода = Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке;	// принудительно посчитать ЭСП
										КонецЕсли; 																	
									КонецЕсли;
									
									ДисконтИКорректировкаЭСП = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремииИКорректировкуПоЭСПИРазницуПервоначальногоПризнания(СтрокаПриходныхПартий.ЦеннаяБумага, ДанныеПереоценки, ДанныеПокупки, НастройкиУчетаЦеннойБумаги, Отказ);
									
									Если ДисконтИКорректировкаЭСП = Неопределено Тогда
										Возврат;
									КонецЕсли;
									
									ДисконтПремияНачисленныйПоПроданным = СтрокаПриходныхПартий.ДисконтПремияНачисленный / СтрокаПриходныхПартий.Количество * КоличествоКСписаниюПартии;
									
									НовоеДвижениеПереоценки.ДисконтПремияНачисленный = Окр(ДисконтИКорректировкаЭСП.ОценочныеДисконтПремия, 2) - Окр(ДисконтПремияНачисленныйПоПроданным, 2);
									
									КурсНачисленияДисконтаПремии = Неопределено; // по умолчанию курс - текущий
									Если УчитыватьВсеЧастиСтоимостиПоФиксированномуКурсу И ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки <> 0 Тогда
										КурсНачисленияДисконтаПремии = ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки; // если есть то будет он, если нет, то будет неопределено и возьмется текущий
									КонецЕсли;
									
									СуммыВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
											Новый Структура("СуммаДвижение", НовоеДвижениеПереоценки.ДисконтПремияНачисленный), 
											ДанныеПоЦеннойБумаге.ВалютаНоминала,
											ЭтотОбъект.Организация,
											ВыборкаДетальныеЗаписи.Период,
											КурсНачисленияДисконтаПремии,
											Отказ);
									
									НовоеДвижениеПереоценки.ДисконтПремияНачисленныйВВалютеУчета = СуммыВВалютеУчета.СуммаДвижение;
									НовоеДвижениеПереоценки.ДисконтПремияНачисленныйСНачалаГода = НовоеДвижениеПереоценки.ДисконтПремияНачисленныйВВалютеУчета;
										
									Если НастройкиУчетаОбщие.УтреннееНачислениеДисконтаПремии Тогда 
										
										// смотрим, продавали ли уже эту партию
										СтрокиНачислены = ПартииПоКоторымНачисленыДисконтПремия.НайтиСтроки(Новый Структура("Партия,СтрокаПартии", СтрокаПриходныхПартий.Партия, СтрокаПриходныхПартий.СтрокаПартии));
										Если СтрокиНачислены.Количество() = 0 Тогда // еще не начисляли
											
											СтрокаНачисления = ПартииПоКоторымНачисленыДисконтПремия.Добавить();
											
											СтрокаНачисления.Партия				= СтрокаПриходныхПартий.Партия;
											СтрокаНачисления.СтрокаПартии		= СтрокаПриходныхПартий.СтрокаПартии;
											

											ДанныеПереоценки = Новый Структура("Количество, УчетныйАктивЕПС, Партия, СтрокаПартии");
											ЗаполнитьЗначенияСвойств(ДанныеПереоценки, СтрокаПриходныхПартий, "Количество, УчетныйАктивЕПС, Партия, СтрокаПартии");
											ДанныеПереоценки.Вставить("ДатаПереоценки", НачалоДня(ВыборкаДетальныеЗаписи.Период));
											ДанныеПереоценки.Вставить("ОценочнаяСуммаКупона", СуммаКупонаНаОднуОблигацию * СтрокаПриходныхПартий.Количество);
											ДанныеПереоценки.Вставить("БалансовыйДисконт", СтрокаПриходныхПартий.ДисконтПремияНачисленный);
											ДанныеПереоценки.Вставить("БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные);
											ДанныеПереоценки.Вставить("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
											ДанныеПереоценки.Вставить("Стоимость", СтрокаПриходныхПартий.Стоимость);
											
											ДанныеПокупки = Новый Структура;
											ДанныеПокупки.Вставить("НачальныйДисконт", НачальныйДисконт);
											ДанныеПокупки.Вставить("ДатаПокупки", ДатаПокупки);
											ДанныеПокупки.Вставить("ДатаПокупкиНачальная", ДатаПокупкиНачальная);
											ДанныеПокупки.Вставить("КорректировкаЭСПНачальная", КорректировкаЭСПНачальная);
											ДанныеПокупки.Вставить("ЦенаПокупки", ЦенаПокупки);
											ДанныеПокупки.Вставить("НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная / СтрокаПриходныхПартий.Количество);
											ДанныеПокупки.Вставить("ЦенаПокупкиКупона", ЦенаПокупкиКупона);
											ДанныеПокупки.Вставить("ЦенаПокупкиНачальная", ЦенаПокупкиНачальная);

											// расчитаем в целом по всем
											ДисконтИКорректировкаЭСП = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремииИКорректировкуПоЭСПИРазницуПервоначальногоПризнания(СтрокаПриходныхПартий.ЦеннаяБумага, ДанныеПереоценки, ДанныеПокупки, НастройкиУчетаЦеннойБумаги, Отказ);
											
											// начислим на всю партию сразу
											НовоеДвижениеПереоценки.ДисконтПремияНачисленный = Окр(ДисконтИКорректировкаЭСП.ОценочныеДисконтПремия, 2) - Окр(СтрокаПриходныхПартий.ДисконтПремияНачисленный, 2);
											
											НовоеДвижениеПереоценки.ДисконтПремияНачисленныйВВалютеУчета  = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(НовоеДвижениеПереоценки.ДисконтПремияНачисленный, ДанныеПоЦеннойБумаге.ВалютаНоминала, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период, Отказ);
											НовоеДвижениеПереоценки.ДисконтПремияНачисленныйСНачалаГода = НовоеДвижениеПереоценки.ДисконтПремияНачисленныйВВалютеУчета;
											
											// в данном случае сразу включаем в стоимость партии всю сумму дисконта и премии
											СтрокаПриходныхПартий.ДисконтПремияНачисленный				= СтрокаПриходныхПартий.ДисконтПремияНачисленный				+ НовоеДвижениеПереоценки.ДисконтПремияНачисленный;
											СтрокаПриходныхПартий.ДисконтПремияНачисленныйВВалютеУчета	= СтрокаПриходныхПартий.ДисконтПремияНачисленныйВВалютеУчета	+ НовоеДвижениеПереоценки.ДисконтПремияНачисленныйВВалютеУчета;
											СтрокаПриходныхПартий.ДисконтПремияНачисленныйСНачалаГода	= СтрокаПриходныхПартий.ДисконтПремияНачисленныйСНачалаГода		+ НовоеДвижениеПереоценки.ДисконтПремияНачисленныйСНачалаГода;
											
										Иначе
											
											НовоеДвижениеПереоценки.ДисконтПремияНачисленный				= 0;
											
											НовоеДвижениеПереоценки.ДисконтПремияНачисленныйВВалютеУчета	= 0;
											НовоеДвижениеПереоценки.ДисконтПремияНачисленныйСНачалаГода	= 0;
											
										КонецЕсли;	
										
									ИначеЕсли НачальныйДисконт > 0 И НовоеДвижениеПереоценки.ДисконтПремияНачисленный > 0 Тогда
										
										//Купили с премией, а новая премия вдруг оказалась больше
										НовоеДвижениеПереоценки.ДисконтПремияНачисленный = 0; // ничего не делаем
										
										НовоеДвижениеПереоценки.ДисконтПремияНачисленныйВВалютеУчета	= 0;
										НовоеДвижениеПереоценки.ДисконтПремияНачисленныйСНачалаГода	= 0;
										
									КонецЕсли;
									
									ВыводПоГруппеБудущее = (ЭтоКлиентГруппыБудущее И ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ВыводЦенныхБумаг"));
									// уникальная ситуация: по бумаге прилетела досрочная оферта (т.е. надо считать АС) и в этот же день мы ее выводим
									// получается, нужно при выводи посчитать АС, несмотря на то, что будущее не считает АС при выводе
									Если ВыводПоГруппеБудущее
										И СтрокаПриходныхПартий.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ФПК_007")
										И НачалоДня(ВыборкаДетальныеЗаписи.Период) >= '20251027' Тогда
									
										ВыводПоГруппеБудущее = Ложь; 
									
									КонецЕсли;
									
									Если НЕ ВыводПоГруппеБудущее																								// группа будущее не считает АС при выводе бумаг
										И (НачалоДня(ВыборкаДетальныеЗаписи.Период) >= '20230101'																// с 1.1.23 считаем у всех корректировку ЭСП
											ИЛИ НастройкиДляУчетаКорректировкиЭСП.Найти(НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода) <> Неопределено	// те клиенты, что корректировку всегда считают
											ИЛИ РоссетиПАО24032021 ИЛИ Сафмар250521ОткрытиеОткрытиеИПСБ)														// хардкоды
										И НЕ ЭтоПрямоеРЕПО																										// при прямом РЕПО не происходит прекращение признания, поэтому не считаем
										Тогда
										
										НовоеДвижениеПереоценки.КорректировкаЭСП = ДисконтИКорректировкаЭСП.ОценочнаяКорректировкаЭСП
											- СтрокаПриходныхПартий.КорректировкаЭСП / СтрокаПриходныхПартий.Количество * КоличествоКСписаниюПартии;
											
											
										КурсНачисленияКорректировкиЭСП = Неопределено; // по умолчанию курс - текущий
										Если УчитыватьВсеЧастиСтоимостиПоФиксированномуКурсу И ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки <> 0 Тогда
											КурсНачисленияКорректировкиЭСП = ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки; // если есть то будет он, если нет, то будет неопределено и возьмется текущий
										КонецЕсли;
										
										СуммыВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
												Новый Структура("СуммаДвижение", НовоеДвижениеПереоценки.КорректировкаЭСП), 
												ДанныеПоЦеннойБумаге.ВалютаНоминала,
												ЭтотОбъект.Организация,
