					НовоеДвижениеСписания.ВидДвижения = Перечисления.ВидыДвижений.Расход;
					НовоеДвижениеСписания.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
					НовоеДвижениеСписания.Период = ВыборкаДетальныеЗаписи.Период;
					НовоеДвижениеСписания.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.НомерСделки;
					
					// создать движение с новым учетным активом ЕПС и, по настройкам, новую партию 
					НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
					
					ЗаполнитьЗначенияСвойств(НовоеДвижение, НовоеДвижениеСписания);
					НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Приход;
					НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.НомерСделки;
					
					НовоеДвижение.УчетныйАктивЕПС = ВыборкаДетальныеЗаписи.УчетныйАктивЕПС;

					// и это, на мой взгляд, искуственное условие - при реклассе из АС в СС всегда оставляем регистратор 
					
					//Если ВыборкаДетальныеЗаписи.Регистратор.ОставлятьПартииБезИзменений Тогда
					//	НовоеДвижение.УчетныйАктивЕПС = ВыборкаДетальныеЗаписи.УчетныйАктивЕПС;
					//Иначе
