				Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.Сделка") //по этим документам неясен учетный актив ЕПС
					 ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ИзменениеУсловийСделки") 
					 ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
					 
					ТекСделка = ВыборкаДетальныеЗаписи.Регистратор; 
					Если ТипЗнч(ТекСделка) = Тип("ДокументСсылка.ИзменениеУсловийСделки") Тогда
						ТекСделка = ВыборкаДетальныеЗаписи.Основание;
					КонецЕсли;
					
					КоличествоРаспределить = ВыборкаДетальныеЗаписи.Количество;
					РаспределенияПоТекущейСделкеИБумаге = РаспределенияПоСделкам.НайтиСтроки(Новый Структура("Сделка, ЦеннаяБумага", ТекСделка, ВыборкаДетальныеЗаписи.ЦеннаяБумага));
					Для каждого СтрокаРаспределенияПоСделкам Из РаспределенияПоТекущейСделкеИБумаге Цикл
						Если СтрокаРаспределенияПоСделкам.Количество = 0 Тогда
							Продолжить;
						КонецЕсли;
						
						СтрокаПартииДляРаспределения = ПартииДляРаспределения.Добавить();
						
						ЗаполнитьЗначенияСвойств(СтрокаПартииДляРаспределения, ВыборкаДетальныеЗаписи);
						
						СтрокаПартииДляРаспределения.УчетныйАктивЕПС = СтрокаРаспределенияПоСделкам.УчетныйАктивЕПС;
						СтрокаПартииДляРаспределения.Количество = МИН(СтрокаРаспределенияПоСделкам.Количество, КоличествоРаспределить);
						
						КоличествоРаспределить = КоличествоРаспределить - СтрокаПартииДляРаспределения.Количество;
						Если КоличествоРаспределить = 0 Тогда
							Прервать;
						КонецЕсли;
						
					КонецЦикла;
					 
					ДанныеДляРаспределения = Новый Структура(СписокСуммовыхПолей);
					ЗаполнитьЗначенияСвойств(ДанныеДляРаспределения, ВыборкаДетальныеЗаписи);
					
					Если РассчитыватьСтоимости Тогда
					
						КоличествоРаспределить = ВыборкаДетальныеЗаписи.Количество;
						 
						Для каждого СтрокаПартииДляРаспределения Из ПартииДляРаспределения Цикл
							Для каждого СуммовоеПоле Из ДанныеДляРаспределения Цикл
								ИмяПоля = СуммовоеПоле.Ключ;
								СуммаКРаспределению = СуммовоеПоле.Значение;
								Если СтрокаПартииДляРаспределения.Количество = 0 И КоличествоРаспределить = 0 Тогда // это покупка паев
									Сумма = СуммаКРаспределению;
								Иначе
									Сумма = СуммаКРаспределению / КоличествоРаспределить * СтрокаПартииДляРаспределения.Количество;	
								КонецЕсли;
								СтрокаПартииДляРаспределения[ИмяПоля] = Сумма;
								ДанныеДляРаспределения[ИмяПоля] = СуммаКРаспределению - Сумма;
							КонецЦикла;
							КоличествоРаспределить = КоличествоРаспределить - СтрокаПартииДляРаспределения.Количество;
						 КонецЦикла;	
					
					КонецЕсли; 					
					
				Иначе
					 СтрокаПартииДляРаспределения = ПартииДляРаспределения.Добавить();
					 ЗаполнитьЗначенияСвойств(СтрокаПартииДляРаспределения, ВыборкаДетальныеЗаписи);
					 
					 Если СтрокаПартииДляРаспределения.УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПустаяСсылка() Тогда
					 	СтрокаПартииДляРаспределения.УчетныйАктивЕПС = БухгалтерскийУчет.ОпределитьУчетныйАктивЕПС(ВыборкаДетальныеЗаписи.Период, ВыборкаДетальныеЗаписи.Рынок, ВыборкаДетальныеЗаписи.ЦеннаяБумага, СчетДоверительногоУправленияДляУчета);
					 КонецЕсли;
				КонецЕсли;
				
				Для каждого СтрокаПартииДляРаспределения Из ПартииДляРаспределения Цикл
					
					Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ИзменениеУсловийСделки") Тогда
						СтрокиПриходныхПартий = ПриходныеПартии.НайтиСтроки(Новый Структура("ЦеннаяБумага, УчетныйАктивЕПС, Количество", СтрокаПартииДляРаспределения.ЦеннаяБумага, СтрокаПартииДляРаспределения.УчетныйАктивЕПС, СтрокаПартииДляРаспределения.Количество));
						Если СтрокиПриходныхПартий.Количество() <> 1 Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Изменение условий сделки с заменой бумаг или их количества не будут обработаны при расчете партий: "+ВыборкаДетальныеЗаписи.Регистратор,,,,Отказ);
							Возврат;
						КонецЕсли;
						СтрокаПриходныеПартии = СтрокиПриходныхПартий[0];
						
						НовоеДвижение = ЭтотОбъект.РассчитанныеПартииКПоступлению.Добавить();
						
						ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаПриходныеПартии);
						
						ВалютаСделки = ВыборкаДетальныеЗаписи.ВалютаСделки;
						//добавляем дельту по стоимости
						НовоеДвижение.Количество = 0;
						НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Приход;
						НовоеДвижение.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
						НовоеДвижение.Период		= СтрокаПартииДляРаспределения.Период;
						
						Если РассчитыватьСтоимости Тогда
						
							НовоеДвижение.СтоимостьПокупки = РаботаСВалютами.ПересчетСуммыВВалюте(СтрокаПартииДляРаспределения.СтоимостьПокупки - СтрокаПриходныеПартии.СтоимостьПокупки, ВалютаСделки, СтрокаПартииДляРаспределения.Период, ВалютаНоминала, СтрокаПартииДляРаспределения.Период, Отказ);
							НовоеДвижение.СтоимостьПокупкиКупона = РаботаСВалютами.ПересчетСуммыВВалюте(СтрокаПартииДляРаспределения.СтоимостьПокупкиКупона - СтрокаПриходныеПартии.СтоимостьПокупкиКупона, ВалютаСделки, СтрокаПартииДляРаспределения.Период, ВалютаНоминала, СтрокаПартииДляРаспределения.Период, Отказ);
							
							СтрокаПартииДляРаспределения.Стоимость = СтрокаПартииДляРаспределения.СтоимостьПокупки;
							Если СтрокаПартииДляРаспределения.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость Тогда 
								//допускаем что расходы - в валюте номинала. Иначе - нужен регистр
								СтрокаПартииДляРаспределения.Стоимость = СтрокаПартииДляРаспределения.Стоимость + СтрокаПартииДляРаспределения.РасходыПриПокупкеВСтоимости;
							Иначе
								СтрокаПартииДляРаспределения.РасходыПриПокупкеВСтоимости = 0;
							КонецЕсли;
							СтрокаПартииДляРаспределения.СтоимостьВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаПартииДляРаспределения.Стоимость, ВалютаНоминала, ЭтотОбъект.Организация,  СтрокаПартииДляРаспределения.Период, Отказ);
							СтрокаПартииДляРаспределения.СтоимостьКупонаВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаПартииДляРаспределения.СтоимостьКупона, ВалютаНоминала, ЭтотОбъект.Организация,  СтрокаПартииДляРаспределения.Период, Отказ);
							
							НовоеДвижение.Стоимость = СтрокаПартииДляРаспределения.Стоимость - СтрокаПриходныеПартии.Стоимость;
							НовоеДвижение.СтоимостьВВалютеУчета = СтрокаПартииДляРаспределения.СтоимостьВВалютеУчета - СтрокаПриходныеПартии.СтоимостьВВалютеУчета;
							НовоеДвижение.СтоимостьКупона = СтрокаПартииДляРаспределения.СтоимостьКупона - СтрокаПриходныеПартии.СтоимостьКупона;
							НовоеДвижение.СтоимостьКупонаВВалютеУчета = СтрокаПартииДляРаспределения.СтоимостьКупонаВВалютеУчета - СтрокаПриходныеПартии.СтоимостьКупонаВВалютеУчета;
							НовоеДвижение.Переоценка = 0;
							НовоеДвижение.ПереоценкаВВалютеУчета = 0;
							НовоеДвижение.ПереоценкаКупона = 0;
							НовоеДвижение.ПереоценкаКупонаВВалютеУчета = 0;
							НовоеДвижение.ПереоценкаСНачалаГода = 0;
							НовоеДвижение.ПереоценкаСНачалаГодаПоложительная = 0;
							НовоеДвижение.ПереоценкаКупонаСНачалаГода = 0;
							НовоеДвижение.ПереоценкаНаБалансе = 0;
							НовоеДвижение.ПереоценкаНаБалансеВВалютеУчета = 0;
							
							
							СтрокаПриходныеПартии.СтоимостьПокупки = СтрокаПриходныеПартии.СтоимостьПокупки + НовоеДвижение.СтоимостьПокупки;
							СтрокаПриходныеПартии.СтоимостьПокупкиКупона = СтрокаПриходныеПартии.СтоимостьПокупкиКупона + НовоеДвижение.СтоимостьПокупкиКупона;
							СтрокаПриходныеПартии.Стоимость = СтрокаПриходныеПартии.Стоимость + НовоеДвижение.Стоимость;
							СтрокаПриходныеПартии.СтоимостьВВалютеУчета = СтрокаПриходныеПартии.СтоимостьВВалютеУчета + НовоеДвижение.СтоимостьВВалютеУчета;
							СтрокаПриходныеПартии.СтоимостьКупона = СтрокаПриходныеПартии.СтоимостьКупона + НовоеДвижение.СтоимостьКупона;
							СтрокаПриходныеПартии.СтоимостьКупонаВВалютеУчета = СтрокаПриходныеПартии.СтоимостьКупонаВВалютеУчета + НовоеДвижение.СтоимостьКупонаВВалютеУчета;							
						
						КонецЕсли; 
						
					Иначе
						ПриходнаяПартия = ПриходныеПартии.Добавить();
						
						ЗаполнитьЗначенияСвойств(ПриходнаяПартия, СтрокаПартииДляРаспределения);
						
						Если (СтрокаПартииДляРаспределения.Регистратор <> Неопределено) И РассчитыватьСтоимости Тогда //обработаем стоимости, причем начальные остатки идут "как есть" - не берем их
							
							// стоимости покупок идут в валюте сделки, а на стоимостях мы все учитываем в валюте номинала
							Если СтрокаПартииДляРаспределения.ВалютаСделки = ВалютаНоминала Тогда
								ПриходнаяПартия.Стоимость = ПриходнаяПартия.СтоимостьПокупки;
								ПриходнаяПартия.СтоимостьКупона = ПриходнаяПартия.СтоимостьПокупкиКупона;
							Иначе
								ПриходнаяПартия.Стоимость = РаботаСВалютами.ПересчетСуммыВВалюте(ПриходнаяПартия.СтоимостьПокупки, СтрокаПартииДляРаспределения.ВалютаСделки, СтрокаПартииДляРаспределения.Период, ВалютаНоминала, СтрокаПартииДляРаспределения.Период, Отказ);
								ПриходнаяПартия.СтоимостьКупона = РаботаСВалютами.ПересчетСуммыВВалюте(ПриходнаяПартия.СтоимостьПокупкиКупона, СтрокаПартииДляРаспределения.ВалютаСделки, СтрокаПартииДляРаспределения.Период, ВалютаНоминала, СтрокаПартииДляРаспределения.Период, Отказ);
							КонецЕсли;
							
							// пересчитываем при необходимости из валюты сделки в валюту учета
							Если СтрокаПартииДляРаспределения.ВалютаСделки = ВалютаУчета Тогда
								ПриходнаяПартия.СтоимостьВВалютеУчета = ПриходнаяПартия.СтоимостьПокупки;
								ПриходнаяПартия.СтоимостьКупонаВВалютеУчета = ПриходнаяПартия.СтоимостьПокупкиКупона;
							Иначе
								ПриходнаяПартия.СтоимостьВВалютеУчета = РаботаСВалютами.ПересчетСуммыВВалюте(ПриходнаяПартия.СтоимостьПокупки, СтрокаПартииДляРаспределения.ВалютаСделки, СтрокаПартииДляРаспределения.Период, ВалютаУчета, СтрокаПартииДляРаспределения.Период, Отказ);
								ПриходнаяПартия.СтоимостьКупонаВВалютеУчета = РаботаСВалютами.ПересчетСуммыВВалюте(ПриходнаяПартия.СтоимостьПокупкиКупона, СтрокаПартииДляРаспределения.ВалютаСделки, СтрокаПартииДляРаспределения.Период, ВалютаУчета, СтрокаПартииДляРаспределения.Период, Отказ);
							КонецЕсли;
							
							// для АСных бумаг считаем расходы (комиссии)
							Если ПриходнаяПартия.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость Тогда
								// считаем, что валюта расходов всегда равна валюте сделки
								// от старого допущения отказываемся - "допускаем что расходы в валюте номинала"
								Если СтрокаПартииДляРаспределения.ВалютаСделки = ВалютаУчета Тогда
									Если ВалютаНоминала = ВалютаУчета Тогда
										РасходыПриПокупкеВСтоимости = ПриходнаяПартия.РасходыПриПокупкеВСтоимости;
									Иначе	
										РасходыПриПокупкеВСтоимости = РаботаСВалютами.ПересчетСуммыВВалюте(ПриходнаяПартия.РасходыПриПокупкеВСтоимости, СтрокаПартииДляРаспределения.ВалютаСделки, СтрокаПартииДляРаспределения.Период, ВалютаНоминала, СтрокаПартииДляРаспределения.Период, Отказ);
									КонецЕсли;
									РасходыПриПокупкеВСтоимостиВВалютеУчета = ПриходнаяПартия.РасходыПриПокупкеВСтоимости;
								Иначе
									РасходыПриПокупкеВСтоимости = РаботаСВалютами.ПересчетСуммыВВалюте(ПриходнаяПартия.РасходыПриПокупкеВСтоимости, СтрокаПартииДляРаспределения.ВалютаСделки, СтрокаПартииДляРаспределения.Период, ВалютаНоминала, СтрокаПартииДляРаспределения.Период, Отказ);
									РасходыПриПокупкеВСтоимостиВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ПриходнаяПартия.РасходыПриПокупкеВСтоимости, СтрокаПартииДляРаспределения.ВалютаСделки, ЭтотОбъект.Организация, ПриходнаяПартия.Период, Отказ);
								КонецЕсли;
								ПриходнаяПартия.Стоимость = ПриходнаяПартия.Стоимость + РасходыПриПокупкеВСтоимости;
								ПриходнаяПартия.СтоимостьВВалютеУчета = ПриходнаяПартия.СтоимостьВВалютеУчета + РасходыПриПокупкеВСтоимостиВВалютеУчета;
							Иначе
								ПриходнаяПартия.РасходыПриПокупкеВСтоимости = 0;
							КонецЕсли;
							
						КонецЕсли;
						
						НовоеДвижение = ЭтотОбъект.РассчитанныеПартииКПоступлению.Добавить();
						
						ЗаполнитьЗначенияСвойств(НовоеДвижение, ПриходнаяПартия);
						
						НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Приход;
						НовоеДвижение.СтрокаКорзиныЦенныхБумаг = СтрокаПартииДляРаспределения.СтрокаПартии;
					КонецЕсли;
						
				КонецЦикла;
				
				
			Иначе //Остальные расходы спишем с приходов. Остальные это 
				
				ТекСделка = ВыборкаДетальныеЗаписи.Регистратор;
				Если ТипЗнч(ТекСделка) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке")
				 	ИЛИ ТипЗнч(ТекСделка) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг") Тогда
					ТекСделка = ВыборкаДетальныеЗаписи.Основание;
				КонецЕсли;
				
				ПриходныеПартииКСписанию = ПриходныеПартии.НайтиСтроки(Новый Структура("Партия, ЦеннаяБумага", ТекСделка, ВыборкаДетальныеЗаписи.ЦеннаяБумага));
				КоличествоКСписанию = ВыборкаДетальныеЗаписи.Количество;//СтрокаДокументыДляСписания.Количество;
				
				Для каждого СтрокаПриходныхПартий Из ПриходныеПартииКСписанию Цикл
					
					Если ЭтоПай И СтрокаПриходныхПартий.Количество = 0 Тогда // тяжелый случай, будем молиться что частичных поставок не будет...
					
						НовоеДвижение = ЭтотОбъект.РассчитанныеПартииКПоступлению.Добавить();
						
						ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаПриходныхПартий);
						
						НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Расход;
						НовоеДвижение.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
						НовоеДвижение.Период = ВыборкаДетальныеЗаписи.Период;
						НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
						
						КоличествоКСписанию = 0;
						
						Продолжить;
						
					КонецЕсли;
					
					
					Если СтрокаПриходныхПартий.Количество = 0 Тогда
						Продолжить;
					КонецЕсли;
					
					Если СтрокаПриходныхПартий.Количество <= КоличествоКСписанию Тогда
						КоличествоКСписаниюПартии = СтрокаПриходныхПартий.Количество;
					Иначе
						КоличествоКСписаниюПартии = КоличествоКСписанию;
					КонецЕсли;
					
					НовоеДвижение = ЭтотОбъект.РассчитанныеПартииКПоступлению.Добавить();
					
					ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаПриходныхПартий);
					
					НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Расход;
					НовоеДвижение.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
					НовоеДвижение.Период = ВыборкаДетальныеЗаписи.Период;
					НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
					
					Если СтрокаПриходныхПартий.Количество <= КоличествоКСписанию Тогда
						
						КоличествоКСписанию = КоличествоКСписанию - СтрокаПриходныхПартий.Количество;
						
						СтрокаПриходныхПартий.Количество = СтрокаПриходныхПартий.Количество - СтрокаПриходныхПартий.Количество;
						
					Иначе //спишем пропорционально
						
						КоэффициентСписания = КоличествоКСписанию / СтрокаПриходныхПартий.Количество;
						
						НовоеДвижение.Количество = КоличествоКСписанию;
						
						Если РассчитыватьСтоимости Тогда
						
							НовоеДвижение.СтоимостьПокупки = СтрокаПриходныхПартий.СтоимостьПокупки * КоэффициентСписания;
							НовоеДвижение.СтоимостьПокупкиКупона = СтрокаПриходныхПартий.СтоимостьПокупкиКупона * КоэффициентСписания;
							
							Если НастройкиПоВидуУчета.ВключатьРасходыПоПокупкеВСтоимость Тогда //чтоб не нарваться на коругление(Карлсон, ты???) спишем с суммой и вычтем
								НовоеДвижение.РасходыПриПокупкеВСтоимости = (СтрокаПриходныхПартий.СтоимостьПокупки + СтрокаПриходныхПартий.РасходыПриПокупкеВСтоимости) * КоэффициентСписания - НовоеДвижение.СтоимостьПокупки;
							Иначе //раз не включены то и не списываем
								НовоеДвижение.РасходыПриПокупкеВСтоимости = 0;
							КонецЕсли;
							
							НовоеДвижение.ПереоценкаВСтоимости = СтрокаПриходныхПартий.ПереоценкаВСтоимости * КоэффициентСписания;
							НовоеДвижение.Стоимость = СтрокаПриходныхПартий.Стоимость * КоэффициентСписания;
							НовоеДвижение.СтоимостьВВалютеУчета = СтрокаПриходныхПартий.СтоимостьВВалютеУчета * КоэффициентСписания;
							НовоеДвижение.Переоценка = СтрокаПриходныхПартий.Переоценка * КоэффициентСписания;
							НовоеДвижение.ПереоценкаВВалютеУчета = СтрокаПриходныхПартий.ПереоценкаВВалютеУчета * КоэффициентСписания;
							НовоеДвижение.ПереоценкаСНачалаГода = СтрокаПриходныхПартий.ПереоценкаСНачалаГода * КоэффициентСписания;
							НовоеДвижение.ПереоценкаСНачалаГодаПоложительная = СтрокаПриходныхПартий.ПереоценкаСНачалаГодаПоложительная * КоэффициентСписания;
							НовоеДвижение.ПереоценкаНаБалансе = СтрокаПриходныхПартий.ПереоценкаНаБалансе * КоэффициентСписания;
							НовоеДвижение.ПереоценкаНаБалансеВВалютеУчета = СтрокаПриходныхПартий.ПереоценкаНаБалансеВВалютеУчета * КоэффициентСписания;
							
							СтрокаПриходныхПартий.СтоимостьПокупки = СтрокаПриходныхПартий.СтоимостьПокупки - НовоеДвижение.СтоимостьПокупки;
							СтрокаПриходныхПартий.СтоимостьПокупкиКупона = СтрокаПриходныхПартий.СтоимостьПокупкиКупона - НовоеДвижение.СтоимостьПокупкиКупона;
							СтрокаПриходныхПартий.РасходыПриПокупкеВСтоимости = СтрокаПриходныхПартий.РасходыПриПокупкеВСтоимости - НовоеДвижение.РасходыПриПокупкеВСтоимости;
							
							СтрокаПриходныхПартий.ПереоценкаВСтоимости = СтрокаПриходныхПартий.ПереоценкаВСтоимости - НовоеДвижение.ПереоценкаВСтоимости;
							СтрокаПриходныхПартий.ПереоценкаКупонаВСтоимости = СтрокаПриходныхПартий.ПереоценкаКупонаВСтоимости - НовоеДвижение.ПереоценкаКупонаВСтоимости;
							СтрокаПриходныхПартий.Стоимость = СтрокаПриходныхПартий.Стоимость - НовоеДвижение.Стоимость;
							СтрокаПриходныхПартий.СтоимостьВВалютеУчета = СтрокаПриходныхПартий.СтоимостьВВалютеУчета - НовоеДвижение.СтоимостьВВалютеУчета;
							СтрокаПриходныхПартий.Переоценка = СтрокаПриходныхПартий.Переоценка - НовоеДвижение.Переоценка;
							СтрокаПриходныхПартий.ПереоценкаВВалютеУчета = СтрокаПриходныхПартий.ПереоценкаВВалютеУчета - НовоеДвижение.ПереоценкаВВалютеУчета;
							СтрокаПриходныхПартий.ПереоценкаСНачалаГода = СтрокаПриходныхПартий.ПереоценкаСНачалаГода - НовоеДвижение.ПереоценкаСНачалаГода;
							СтрокаПриходныхПартий.ПереоценкаСНачалаГодаПоложительная = СтрокаПриходныхПартий.ПереоценкаСНачалаГодаПоложительная - НовоеДвижение.ПереоценкаСНачалаГодаПоложительная;
							СтрокаПриходныхПартий.ПереоценкаНаБалансе = СтрокаПриходныхПартий.ПереоценкаНаБалансе - НовоеДвижение.ПереоценкаНаБалансе;							
							СтрокаПриходныхПартий.ПереоценкаНаБалансеВВалютеУчета = СтрокаПриходныхПартий.ПереоценкаНаБалансеВВалютеУчета - НовоеДвижение.ПереоценкаНаБалансеВВалютеУчета;
						
						КонецЕсли; 
						
						СтрокаПриходныхПартий.Количество = СтрокаПриходныхПартий.Количество - НовоеДвижение.Количество;
						
						КоличествоКСписанию = 0;
						
					КонецЕсли;
					
					Если КоличествоКСписанию = 0 Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
		КонецЦикла;
		
		// теперь таблица приходных партий содержит только конечные остатки, которые мы и положим в соответствующую таб. часть обработки
		Для каждого СтрокаПриходныеПартии Из ПриходныеПартии Цикл
			Если СтрокаПриходныеПартии.Количество > 0 Тогда
				ЗаполнитьЗначенияСвойств(ЭтотОбъект.КонечныеОстаткиПартийКПоступлению.Добавить(), СтрокаПриходныеПартии);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры
	
Функция ДоначислитьКупон(Регистратор, Период, СтрокаПриходныхПартий, СуммаКупона, Количество, ФиксированныйКурсПереоценки = 0, СтрокаКорзиныЦенныхБумаг, ОтражатьНаПереоценкеПолнуюСумму, Отказ)
	
	Если НЕ ОтражатьНаПереоценкеПолнуюСумму Тогда
		СуммаДооценкиКупона = СуммаКупона * СтрокаПриходныхПартий.Количество - СтрокаПриходныхПартий.СтоимостьКупона - СтрокаПриходныхПартий.ПереоценкаКупона;
	Иначе
		СуммаДооценкиКупона = СуммаКупона * СтрокаПриходныхПартий.Количество - СтрокаПриходныхПартий.ПереоценкаКупона;
	КонецЕсли;
	
	НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
	
	Если ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		НовоеДвижение.УчетныйАктивЕПС 	= СтрокаПриходныхПартий.УчетныйАктивЕПС;
	Иначе
		НовоеДвижение.СтрокаКорзиныЦенныхБумаг = СтрокаКорзиныЦенныхБумаг;
	КонецЕсли;
	
	НовоеДвижение.Рынок 			= СтрокаПриходныхПартий.Рынок;
	НовоеДвижение.ЦеннаяБумага 		= СтрокаПриходныхПартий.ЦеннаяБумага;
	НовоеДвижение.Партия 			= СтрокаПриходныхПартий.Партия;
	НовоеДвижение.СтрокаПартии 		= СтрокаПриходныхПартий.СтрокаПартии;
	
	НовоеДвижение.ВидДвижения 		= Перечисления.ВидыДвижений.Приход;
	НовоеДвижение.Регистратор 		= Регистратор;
	НовоеДвижение.Период 			= Период;
	
	//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.ПереоценкаИНачислениеПроцентов;
	
	Если Количество <> СтрокаПриходныхПартий.Количество Тогда
		СуммаДооценкиКупона = Окр(СуммаДооценкиКупона * Количество / СтрокаПриходныхПартий.Количество, 2);
	КонецЕсли;
	
	НовоеДвижение.ПереоценкаКупона = СуммаДооценкиКупона;
	
	Если НовоеДвижение.ПереоценкаКупона <> 0 Тогда
		Если ФиксированныйКурсПереоценки = 0 Тогда
			НовоеДвижение.ПереоценкаКупонаВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
																				СуммаДооценкиКупона,
																				СтрокаПриходныхПартий.ЦеннаяБумага.ВалютаНоминала,
																				ЭтотОбъект.Организация,
																				Период,
																				Отказ);
		Иначе
			НовоеДвижение.ПереоценкаКупонаВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
																				Новый Структура("Сумма", СуммаДооценкиКупона),
																				СтрокаПриходныхПартий.ЦеннаяБумага.ВалютаНоминала,
																				ЭтотОбъект.Организация,
																				Период,
																				ФиксированныйКурсПереоценки,
																				Отказ).Сумма;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НовоеДвижение;
	
КонецФункции

Функция ДоначислитьКупонРЕПО(Регистратор, Период, ТаблицаДвижений, СтрокаПриходныхПартий, СуммаКупона, Количество, СтрокаКорзиныЦенныхБумаг, Отказ)
	
	НовоеДвижение = ТаблицаДвижений.Добавить();  
	
	Если ЭтотОбъект.ВидУчета <> Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		НовоеДвижение.СтрокаКорзиныЦенныхБумаг = СтрокаКорзиныЦенныхБумаг;
	КонецЕсли;
	
	СвойстваКЗаполнению = "Рынок, ЦеннаяБумага, Партия, СтрокаПартии";
	
	Если ТаблицаДвижений = ЭтотОбъект.РассчитанныеПартииПрямоеРЕПО Тогда
		СвойстваКЗаполнению = СвойстваКЗаполнению + ", УчетныйАктивЕПС, ПродажаРЕПО, СтрокаПродажиРЕПО";
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаПриходныхПартий, СвойстваКЗаполнению);
	
	НовоеДвижение.ВидДвижения 		= Перечисления.ВидыДвижений.Приход;
	НовоеДвижение.Регистратор 		= Регистратор;
	НовоеДвижение.Период 			= Период;

	СуммаДооценкиКупона = СуммаКупона * СтрокаПриходныхПартий.Количество - СтрокаПриходныхПартий.СтоимостьКупона - СтрокаПриходныхПартий.ПереоценкаКупона;
	
	Если Количество <> СтрокаПриходныхПартий.Количество Тогда
		СуммаДооценкиКупона = Окр(СуммаДооценкиКупона * Количество / СтрокаПриходныхПартий.Количество, 2);
	КонецЕсли;
	
	НовоеДвижение.ПереоценкаКупона = СуммаДооценкиКупона;
	
	Если НовоеДвижение.ПереоценкаКупона <> 0 Тогда
		НовоеДвижение.ПереоценкаКупонаВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
																			СуммаДооценкиКупона,
																			СтрокаПриходныхПартий.ЦеннаяБумага.ВалютаНоминала,
																			ЭтотОбъект.Организация,
																			Период,
																			Отказ);
	КонецЕсли;
	
	Возврат НовоеДвижение;
	
КонецФункции

Функция Перекурсовка(Регистратор, ТаблицаДвижений, Период, СтрокаПриходныхПартий, Количество, СтрокаКорзиныЦенныхБумаг, КурсВалюты = Неопределено, РесурсыКПерекурсовке = Неопределено, ПараметрыПерекурсовки = Неопределено, Отказ)
	
	ПараметрыПроверки67ФЗ = Неопределено;
	ЭтоВебФинанс210522 = Ложь;
	ОтражатьНаПриходнойПартии = Истина;
	
	Если ПараметрыПерекурсовки <> Неопределено Тогда
		ПараметрыПерекурсовки.Свойство("ПараметрыПроверки67ФЗ", ПараметрыПроверки67ФЗ);
		
		Если НЕ ПараметрыПерекурсовки.Свойство("ЭтоВебФинанс210522", ЭтоВебФинанс210522) Тогда
			ЭтоВебФинанс210522 = Ложь;
		КонецЕсли;
		Если НЕ ПараметрыПерекурсовки.Свойство("ОтражатьНаПриходнойПартии", ОтражатьНаПриходнойПартии) Тогда
			ОтражатьНаПриходнойПартии = Истина;
		КонецЕсли;
	КонецЕсли;
	
	СуммыПерекурсовки = Новый Структура("СтоимостьВВалютеУчета,СтоимостьКупонаВВалютеУчета,ПереоценкаВВалютеУчета,ПереоценкаКупонаВВалютеУчета, ДисконтПремияНачисленныйВВалютеУчета,КорректировкаЭСПВВалютеУчета,РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,КурсовыеРазницыСНачалаГода, СтрокаКорзиныЦенныхБумаг",
							0, 0, 0, 0, 0, 0, 0, 0, 0);
							
	// Акции при продаже не курсуем!!! (ПБУ 3 п.7)
	Если СтрокаПриходныхПартий.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
	
		Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.Сделка")
			ИЛИ ТипЗнч(Регистратор) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке")
			ИЛИ ТипЗнч(Регистратор) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг") Тогда
		
			Возврат СуммыПерекурсовки;
		
		КонецЕсли;	
	
	КонецЕсли;
	
	Если СтрокаПриходныхПартий.Количество = 0 Тогда
	
		ТексСообщения = СтрШаблон("Обнаружено нолевое количество ценных бумаг %1, партия %2, строка партии %3",
									СтрокаПриходныхПартий.ЦеннаяБумага,
									СтрокаПриходныхПартий.Партия,
									СтрокаПриходныхПартий.СтрокаПартии);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТексСообщения,,,, Отказ);
		Возврат СуммыПерекурсовки;
		
	КонецЕсли;
	
	
	СуммыВВалюте = Новый Структура();
	
	Если РесурсыКПерекурсовке = Неопределено Тогда
	
		Если ЭтотОбъект.ВидУчета <> Перечисления.ВидыУчета.НалоговыйУчет Тогда
			СуммыВВалюте.Вставить("СтоимостьВВалютеУчета", СтрокаПриходныхПартий.Стоимость);
			СуммыВВалюте.Вставить("СтоимостьКупонаВВалютеУчета", СтрокаПриходныхПартий.СтоимостьКупона);
			СуммыВВалюте.Вставить("ПереоценкаВВалютеУчета", СтрокаПриходныхПартий.Переоценка);
		КонецЕсли;
		СуммыВВалюте.Вставить("ПереоценкаКупонаВВалютеУчета", СтрокаПриходныхПартий.ПереоценкаКупона);
		Если ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
			СуммыВВалюте.Вставить("ДисконтПремияНачисленныйВВалютеУчета", СтрокаПриходныхПартий.ДисконтПремияНачисленный);
			СуммыВВалюте.Вставить("КорректировкаЭСПВВалютеУчета", СтрокаПриходныхПартий.КорректировкаЭСП);
			СуммыВВалюте.Вставить("РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета", СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(РесурсыКПерекурсовке) = Тип("Массив") Тогда	
		Для Каждого РесурсКПерекурсовке Из РесурсыКПерекурсовке Цикл
			
			СуммыВВалюте.Вставить(РесурсКПерекурсовке, СтрокаПриходныхПартий[СтрЗаменить(РесурсКПерекурсовке,"ВВалютеУчета","")]);
			
		КонецЦикла;		
	КонецЕсли;
	
	РаботаСВалютами.ПолучитьСуммыВВалютеУчета(СуммыВВалюте, СтрокаПриходныхПартий.ЦеннаяБумага.ВалютаНоминала, ЭтотОбъект.Организация, Период, КурсВалюты, Отказ);
	
	КоэффициентПерекурсовки = Количество/СтрокаПриходныхПартий.Количество;
	
	Для каждого СуммаВВалюте Из СуммыВВалюте Цикл
		
		ИмяРесурса = СуммаВВалюте.Ключ;
		ВалютнаяСумма = СуммаВВалюте.Значение;
		
		СуммыПерекурсовки[ИмяРесурса] = (Окр(ВалютнаяСумма, 2) - СтрокаПриходныхПартий[ИмяРесурса]) * КоэффициентПерекурсовки;
		Если ИмяРесурса = "ПереоценкаКупонаВВалютеУчета" И ПараметрыПроверки67ФЗ <> Неопределено Тогда 
			Если СуммыПерекурсовки[ИмяРесурса] <> 0 И БухгалтерскийУчет.КурсоваяРазницаПереоценкиУдовлетворяет67ФЗ(СуммыПерекурсовки[ИмяРесурса], ПараметрыПроверки67ФЗ.ВидУчета, ПараметрыПроверки67ФЗ.СчетУчетаПереоценки, Период) Тогда 			
				СуммыПерекурсовки[ИмяРесурса] = 0;
			КонецЕсли;		
		КонецЕсли	
						
	КонецЦикла;
	
	Если ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
	
		СуммыПерекурсовки.КурсовыеРазницыСНачалаГода = СуммыПерекурсовки.СтоимостьВВалютеУчета + СуммыПерекурсовки.СтоимостьКупонаВВалютеУчета + СуммыПерекурсовки.ПереоценкаВВалютеУчета 
			+ СуммыПерекурсовки.ПереоценкаКупонаВВалютеУчета + СуммыПерекурсовки.ДисконтПремияНачисленныйВВалютеУчета + СуммыПерекурсовки.КорректировкаЭСПВВалютеУчета 
			+ СуммыПерекурсовки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета;
			
	КонецЕсли;
	
	ЕстьНенулевыеСуммы = Ложь;
	Для Каждого СуммаПерекурсовки из СуммыПерекурсовки Цикл
		Если СуммаПерекурсовки.Значение <> 0 Тогда
			ЕстьНенулевыеСуммы = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьНенулевыеСуммы Тогда
		
		НовоеДвижение = ТаблицаДвижений.Добавить();
		
		//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.Перекурсовка;
		
		ЗаполнитьЗначенияСвойств(НовоеДвижение, СуммыПерекурсовки);
		
		НовоеДвижение.ЦеннаяБумага 		= СтрокаПриходныхПартий.ЦеннаяБумага;
		Если ТаблицаДвижений <> ЭтотОбъект.РассчитанныеПартииОбратноеРЕПО Тогда
			НовоеДвижение.УчетныйАктивЕПС 	= СтрокаПриходныхПартий.УчетныйАктивЕПС;
		КонецЕсли;	
		НовоеДвижение.Партия 			= СтрокаПриходныхПартий.Партия;
		НовоеДвижение.СтрокаПартии 		= СтрокаПриходныхПартий.СтрокаПартии;
		НовоеДвижение.Рынок 			= СтрокаПриходныхПартий.Рынок;
		НовоеДвижение.СтрокаКорзиныЦенныхБумаг = СтрокаКорзиныЦенныхБумаг;
		
		НовоеДвижение.ВидДвижения 		= Перечисления.ВидыДвижений.Приход;
		НовоеДвижение.Регистратор 		= Регистратор;
		НовоеДвижение.Период 			= Период;
		
		
		Если ТаблицаДвижений = ЭтотОбъект.РассчитанныеПартииПрямоеРЕПО Тогда
			НовоеДвижение.ПродажаРЕПО 			= СтрокаПриходныхПартий.ПродажаРЕПО;
			НовоеДвижение.СтрокаПродажиРЕПО 	= СтрокаПриходныхПартий.СтрокаПродажиРЕПО;
		КонецЕсли;
		
		Если ЭтоВебФинанс210522 Тогда // курсуем только купон!
		
			НовоеДвижение.СтоимостьВВалютеУчета = 0;
			НовоеДвижение.СтоимостьКупонаВВалютеУчета = 0;
			НовоеДвижение.ПереоценкаВВалютеУчета = 0;
			НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета = 0;
			НовоеДвижение.КорректировкаЭСПВВалютеУчета = 0;
			НовоеДвижение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета = 0;
			НовоеДвижение.КурсовыеРазницыСНачалаГода = 0;
		
		КонецЕсли;
		
		Если ОтражатьНаПриходнойПартии Тогда
			СтрокаПриходныхПартий_Колонки = СтрокаПриходныхПартий.Владелец().Колонки;
			Для Каждого СуммаПерекурсовки Из СуммыПерекурсовки Цикл
				ИмяРесурса = СуммаПерекурсовки.Ключ;
				Если СтрокаПриходныхПартий_Колонки.Найти(ИмяРесурса) <> Неопределено Тогда
					Если ЗначениеЗаполнено(НовоеДвижение[ИмяРесурса]) Тогда
						СтрокаПриходныхПартий[ИмяРесурса] = СтрокаПриходныхПартий[ИмяРесурса] + НовоеДвижение[ИмяРесурса];
					КонецЕсли;	
				КонецЕсли;	
			КонецЦикла; 
			
		КонецЕсли;
			
		Возврат НовоеДвижение;
		
	Иначе
		
		Возврат СуммыПерекурсовки;
		
	КонецЕсли;
	
КонецФункции

Функция ЗаполнитьПоляВВалютеУчета(ДатаКурса, ДанныеДляРаспределения, ВыборкаДетальныеЗаписи, ВалютаНоминала, ФиксированныйКурсПереоценки, ТаблицаРасходыПоСделкеСЗамещающимиОблигациями = Неопределено, ВалютаУчета, Отказ)
	
	Если ФиксированныйКурсПереоценки <> 0 Тогда
	
		ДанныеДляРаспределения.СтоимостьПокупкиВВалютеУчета = ДанныеДляРаспределения.СтоимостьПокупки * ФиксированныйКурсПереоценки;
		ДанныеДляРаспределения.СтоимостьПокупкиКупонаВВалютеУчета = ДанныеДляРаспределения.СтоимостьПокупкиКупона * ФиксированныйКурсПереоценки;
		ДанныеДляРаспределения.РасходыПриПокупкеВСтоимостиВВалютеУчета = ДанныеДляРаспределения.РасходыПриПокупкеВСтоимости * ФиксированныйКурсПереоценки;
		ДанныеДляРаспределения.ПереоценкаВВалютеУчета = ДанныеДляРаспределения.Переоценка * ФиксированныйКурсПереоценки;
		
	Иначе
		
		ПересчитатьДанныеСделкиВВалютуНоминала(ДатаКурса, ДанныеДляРаспределения, ВыборкаДетальныеЗаписи, ВалютаНоминала, ТаблицаРасходыПоСделкеСЗамещающимиОблигациями, ВалютаУчета, Отказ);
		
	КонецЕсли;	
		
КонецФункции

Процедура ЗаписатьПартии(ИмяРегистра, ТаблицаПартий, Отказ)

	Если ТаблицаПартий.Количество() > 0 Тогда
	
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		#Область Текст_запроса_типы_регистраторов
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ТаблицаПартий.Регистратор КАК Регистратор
			|ПОМЕСТИТЬ _Регистраторы
			|ИЗ
			|	&ТаблицаПартий КАК ТаблицаПартий
			|ГДЕ
			|	ТаблицаПартий.Регистратор <> НЕОПРЕДЕЛЕНО
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Регистраторы.Регистратор КАК Регистратор,
			|	ТИПЗНАЧЕНИЯ(_Регистраторы.Регистратор) КАК ТипЗначения
			|ПОМЕСТИТЬ _ТипыРегистраторов
			|ИЗ
			|	_Регистраторы КАК _Регистраторы
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _Регистраторы";
		#КонецОбласти
		
		Запрос.УстановитьПараметр("ТаблицаПартий", ТаблицаПартий);
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
		Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
		
		Запрос.Выполнить();
		
		ВыборкаТипыЗначений = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос.МенеджерВременныхТаблиц, "_ТипыРегистраторов", Истина, "ТипЗначения", , "ТипЗначения").Выбрать();
		
		МассивВариантов = Новый Массив;
		
		Если ВыборкаТипыЗначений.Количество() > 0 Тогда
			
			Пока ВыборкаТипыЗначений.Следующий() Цикл
			
				МетаданныеДокумента = Метаданные.НайтиПоТипу(ВыборкаТипыЗначений.ТипЗначения);
				
				Вариант = СтрШаблон(
					"КОГДА ТИПЗНАЧЕНИЯ(_ТипыРегистраторов.Регистратор) = ТИП(%1)
					|			ТОГДА ВЫРАЗИТЬ(_ТипыРегистраторов.Регистратор КАК %1).Дата",
					МетаданныеДокумента.ПолноеИмя());
					
				МассивВариантов.Добавить(Вариант);
			
			КонецЦикла;
				
			ПодстрокаРегистраторДата = СтрШаблон(
				"ВЫБОР
				|		%1
				|	КОНЕЦ", СтрСоединить(МассивВариантов, Символы.ПС));
				
			#Область Текст_запроса_Поиск_нарушений_дат_запрета
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ТипыРегистраторов.Регистратор КАК Регистратор,
				|	&РегистраторДата КАК Дата
				|ПОМЕСТИТЬ _ДатыРегистраторов
				|ИЗ
				|	_ТипыРегистраторов КАК _ТипыРегистраторов
				|
				|ИНДЕКСИРОВАТЬ ПО
				|	_ТипыРегистраторов.Регистратор
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	КОНЕЦПЕРИОДА(ДатыЗапретаРедактирования.ДатаЗапретаРедактирования, ДЕНЬ) КАК ДатаЗапретаРедактирования
				|ПОМЕСТИТЬ _ДатыЗапрета
				|ИЗ
				|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
				|ГДЕ
				|	ДатыЗапретаРедактирования.Организация = &Организация
				|	И ДатыЗапретаРедактирования.СчетДоверительногоУправления = &СчетДоверительногоУправления
				|	И ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии)
				|	И ДатыЗапретаРедактирования.ВидУчета = &ВидУчета
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	_ДатыРегистраторов.Регистратор КАК Регистратор
				|ПОМЕСТИТЬ _СтарыеДвижения
				|ИЗ
				|	_ДатыРегистраторов КАК _ДатыРегистраторов
				|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыЗапрета КАК _ДатыЗапрета
				|		ПО (ИСТИНА)
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
				|		ПО (БухПартииЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления)
				|			И (БухПартииЦенныхБумаг.Активность)
				|			И (БухПартииЦенныхБумаг.ВидУчета = &ВидУчета)
				|			И _ДатыРегистраторов.Регистратор = БухПартииЦенныхБумаг.Регистратор
				|			И (_ДатыРегистраторов.Дата <= _ДатыЗапрета.ДатаЗапретаРедактирования)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	_ДатыРегистраторов.Регистратор КАК Регистратор
				|ПОМЕСТИТЬ _НовыеДвижения
				|ИЗ
				|	_ДатыРегистраторов КАК _ДатыРегистраторов
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДатыЗапрета КАК _ДатыЗапрета
				|		ПО _ДатыРегистраторов.Дата <= _ДатыЗапрета.ДатаЗапретаРедактирования";
			#КонецОбласти
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&РегистраторДата", ПодстрокаРегистраторДата);
			
			Если ИмяРегистра <> "БухПартииЦенныхБумаг" Тогда
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухПартииЦенныхБумаг", ИмяРегистра);
			КонецЕсли;
			
			Запрос.Выполнить();
			
			ПроверитьНарушенияДатЗапрета(Запрос, "_СтарыеДвижения", ИмяРегистра, Отказ);
			ПроверитьНарушенияДатЗапрета(Запрос, "_НовыеДвижения", ИмяРегистра, Отказ);
			
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
			
			ВыборкаДаты = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос.МенеджерВременныхТаблиц, "_ДатыРегистраторов").Выбрать();
			ДатыДвижений = Новый Соответствие;
			Пока ВыборкаДаты.Следующий() Цикл
				ДатыДвижений.Вставить(ВыборкаДаты.Регистратор, ВыборкаДаты.Дата);
			КонецЦикла;
			
			ТаблицаПартий.Сортировать("Регистратор, НомерСтроки");
				
			ТекущийРегистратор = Неопределено;
			ДатаДвижений = Неопределено;
			Движения = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
			
			МассивРесурсов = Новый Массив();
			Для Каждого Ресурс Из Метаданные.РегистрыНакопления[ИмяРегистра].Ресурсы Цикл
				МассивРесурсов.Добавить(Ресурс.Имя);
			КонецЦикла;
			
			Для Каждого СтрокаПартий Из ТаблицаПартий Цикл
				
				Если ТипЗнч(СтрокаПартий.Регистратор) = Тип("ДокументОбъект.КорректировкаРегистров")						// не нужно их записывать, они и так записаны
					ИЛИ ТипЗнч(СтрокаПартий.Регистратор) = Тип("ДокументОбъект.РегистрацияСуммПогашенийНеИсполненныхВСрок")	// не нужно их записывать, они проводятся по-другому
				Тогда 
					Продолжить;
				КонецЕсли;
				
				Если ТекущийРегистратор <> СтрокаПартий.Регистратор Тогда
					
					Если ТекущийРегистратор <> Неопределено Тогда
						
						Попытка
							Движения.ДополнительныеСвойства.Вставить("ЗаписьВСоставеРасчетаПартий", Истина);
							Движения.Записать(Истина);
						Исключение
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(), ТекущийРегистратор,,, Отказ);
							Возврат;
						КонецПопытки;
					
					КонецЕсли;
					
					ТекущийРегистратор = СтрокаПартий.Регистратор;
					//ДатаДвижений = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаПартий.Регистратор, "Дата");
					ДатаДвижений = ДатыДвижений[СтрокаПартий.Регистратор];
					
					Движения = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
					Движения.Отбор.Регистратор.Установить(ТекущийРегистратор);
					Движения.Прочитать();
					
					НомерЗаписи = Движения.Количество() - 1;
					Пока НомерЗаписи >= 0 Цикл
						Если Движения[НомерЗаписи].ВидУчета = ЭтотОбъект.ВидУчета Тогда
							Движения.Удалить(НомерЗаписи);
						КонецЕсли;
						НомерЗаписи = НомерЗаписи - 1;
					КонецЦикла;		
					
				КонецЕсли;
				
				ПустаяЗапись = Истина;
				Для Каждого Ресурс Из МассивРесурсов Цикл
					Если СтрокаПартий[Ресурс] <> 0 Тогда
						ПустаяЗапись = Ложь;
						Прервать;				
					КонецЕсли;
				КонецЦикла;
				Если ПустаяЗапись Тогда
					Продолжить;
				КонецЕсли;
			
				Движение = Движения.Добавить();
				Движение.Организация = ЭтотОбъект.Организация;
				Движение.СчетДоверительногоУправления = СчетДоверительногоУправленияДляУчета;
				Движение.ВидУчета = ЭтотОбъект.ВидУчета;
				ЗаполнитьЗначенияСвойств(Движение, СтрокаПартий);
				Движение.ВидДвижения = ?(СтрокаПартий.ВидДвижения = Перечисления.ВидыДвижений.Приход, ВидДвиженияНакопления.Приход, ВидДвиженияНакопления.Расход);
				Если ТекущийРегистратор <> Неопределено Тогда
					Движение.Период = ДатаДвижений;
				КонецЕсли;
				
			КонецЦикла;
			
			Если ТекущийРегистратор <> Неопределено Тогда
			
				Попытка
					Движения.ДополнительныеСвойства.Вставить("ЗаписьВСоставеРасчетаПартий", Истина);
					Движения.Записать(Истина);
				Исключение
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(), ТекущийРегистратор,,, Отказ);
					Возврат;
				КонецПопытки;
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;

	//затрем все движения по документам, не попавшим в список регистраторов
	РегистраторыПартий = ТаблицаПартий.ВыгрузитьКолонку("Регистратор");	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	НЕ БухПартииЦенныхБумаг.Регистратор В (&Регистраторы)
		|	И БухПартииЦенныхБумаг.Период >= &НачалоПериода
		|	И БухПартииЦенныхБумаг.Период <= &КонецПериода
		|	И БухПартииЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|	И ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумаг.Регистратор) <> ТИП(Документ.ПереоценкаЦенныхБумаг)
		|	И ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумаг.Регистратор) <> ТИП(Документ.КорректировкаРегистров)
		|	И ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумаг.Регистратор) <> ТИП(Документ.РегистрацияСуммПогашенийНеИсполненныхВСрок)
		|	И ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумаг.Регистратор) <> ТИП(Документ.НачислениеСписаниеРезервов)
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.Регистратор";
		
	Если ИмяРегистра<>"БухПартииЦенныхБумаг" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухПартииЦенныхБумаг", ИмяРегистра);
	КонецЕсли;
			
	Запрос.УстановитьПараметр("Регистраторы", РегистраторыПартий);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.КонецПериода));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
	Запрос.УстановитьПараметр("ВидУчета", ЭтотОбъект.ВидУчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Движения = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
		Движения.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Регистратор);
		Движения.Прочитать();
		КоличествоСтрокаНабора = Движения.Количество();
		Для СЦ=-(КоличествоСтрокаНабора-1) По 0 Цикл
			СтрокаНабораЗаписей = Движения[-СЦ];
			Если СтрокаНабораЗаписей.ВидУчета = ЭтотОбъект.ВидУчета Тогда
				Движения.Удалить(СтрокаНабораЗаписей);
			КонецЕсли;
		КонецЦикла;
		Попытка
			Движения.Записать(Истина);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(), ВыборкаДетальныеЗаписи.Регистратор,,, Отказ);
			Возврат;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьНастройки(Отказ)

	Если РассчитанныеНастройкиДляПартии.Количество() = 0 Тогда
		Возврат;		
	КонецЕсли;	
	
	Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправленияДляУчета, КонецПериода);
	
	РассчитанныеНастройкиДляПартии.Сортировать("Регистратор, НомерСтроки");
		
	ТекущийРегистратор = Неопределено;
	Движения = РегистрыСведений.ЗначенияНастроекУчетаЦенныхБумаг.СоздатьНаборЗаписей();
	
	Для Каждого СтрокаНастроек Из РассчитанныеНастройкиДляПартии Цикл
		
		Если ТекущийРегистратор <> СтрокаНастроек.Регистратор Тогда
			
			Если ТекущийРегистратор <> Неопределено Тогда
				Попытка
					Движения.Записать(Истина);
				Исключение
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(), ТекущийРегистратор,,, Отказ);
					Возврат;
				КонецПопытки;
			КонецЕсли;
			
			ТекущийРегистратор = СтрокаНастроек.Регистратор;
			
			Движения = РегистрыСведений.ЗначенияНастроекУчетаЦенныхБумаг.СоздатьНаборЗаписей();
			Движения.Отбор.Регистратор.Установить(ТекущийРегистратор);
			Движения.Прочитать();
			Движения.Очистить();
			
		КонецЕсли;
		
		Движение = Движения.Добавить();
		Движение.Организация = ЭтотОбъект.Организация;
		Движение.Клиент = Клиент;
		ЗаполнитьЗначенияСвойств(Движение, СтрокаНастроек);
		
	КонецЦикла;
	
	Если ТекущийРегистратор <> Неопределено Тогда
		Попытка
			Движения.Записать(Истина);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(), ТекущийРегистратор,,, Отказ);
			Возврат;
		КонецПопытки;
	КонецЕсли; 

	//затрем все движения по документам, не попавшим в список регистраторов
	Регистраторы = РассчитанныеНастройкиДляПартии.ВыгрузитьКолонку("Регистратор");	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияНастроекУчетаЦенныхБумаг.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.ЗначенияНастроекУчетаЦенныхБумаг КАК ЗначенияНастроекУчетаЦенныхБумаг
		|ГДЕ
		|	НЕ ЗначенияНастроекУчетаЦенныхБумаг.Регистратор В (&Регистраторы)
		|	И ЗначенияНастроекУчетаЦенныхБумаг.Период >= &НачалоПериода
		|	И ЗначенияНастроекУчетаЦенныхБумаг.Период <= &КонецПериода
		|	И ТИПЗНАЧЕНИЯ(ЗначенияНастроекУчетаЦенныхБумаг.Регистратор) В (ТИП(Документ.Сделка), ТИП(Документ.Сделка), ТИП(Документ.Сделка))
		|	И ЗначенияНастроекУчетаЦенныхБумаг.Регистратор.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗначенияНастроекУчетаЦенныхБумаг.Регистратор";
			
	Запрос.УстановитьПараметр("Регистраторы", Регистраторы);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.КонецПериода));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Движения = РегистрыСведений.ЗначенияНастроекУчетаЦенныхБумаг.СоздатьНаборЗаписей();
		Движения.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Регистратор);
		Движения.Прочитать();
		Движения.Очистить();
		Попытка
			Движения.Записать(Истина);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(), ВыборкаДетальныеЗаписи.Регистратор,,, Отказ);
			Возврат;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуПлановыхОпераций()

	Если ТаблицаПлановыхОпераций = Неопределено Тогда
		ТаблицаПлановыхОпераций = РегистрыСведений.ОперацииСЦеннымиБумагами.ПолучитьОписаниеТаблицыПлановыхОпераций();
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьРеквизитыДокументов(ТаблицаДляСделок, ИмяРегистра)
	
	ПолучаемыеПоля = "ВалютаСделки, ЧастьСделкиРЕПО, СуммаНаОднуОблигацию, ВалютаОплаты, ДатаФиксации, ВидПогашения, Сумма, Количество, СуммаКупона, Основание, ПогашениеЦеннойБумаги, ВидЗадолженности";
	МассивПолей = СтрРазделить(СтрЗаменить(ПолучаемыеПоля, " ", ""), ",", Ложь);
	
	ПоляДляЗапроса = "";
	ПоследнееПоле = МассивПолей[МассивПолей.ВГраница()];
	Для каждого Поле Из МассивПолей Цикл
		
		Если ТаблицаДляСделок.Колонки.Найти(Поле) = Неопределено Тогда
			ТаблицаДляСделок.Колонки.Добавить(Поле, Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1)));
		КонецЕсли; 
		
		ПоляДляЗапроса = ПоляДляЗапроса + Символы.Таб + "Таблица." + Поле + " КАК " + Поле;
		Если Поле <> ПоследнееПоле Тогда
			ПоляДляЗапроса = ПоляДляЗапроса + ", " + Символы.ПС;
		КонецЕсли;
		
	КонецЦикла;
	
	ПоляДляТаблицаДляСделок = СтрЗаменить(ПоляДляЗапроса, "Таблица.", "ТаблицаДляСделок.");
	ПоляДляТаблицаРегистраторов = СтрЗаменить(ПоляДляЗапроса, "Таблица.", "_ТаблицаРегистраторов.");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаДляСделок", ТаблицаДляСделок);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаДляСделок.Период КАК Период,
		|	ТаблицаДляСделок.Регистратор КАК Регистратор,
		|	ТаблицаДляСделок.ПлановыеДанные КАК ПлановыеДанные,
		|	&ПоляДляТаблицаДляСделок КАК ПоляДляТаблицаДляСделок
		|ПОМЕСТИТЬ _ТаблицаРегистраторов
		|ИЗ
		|	&ТаблицаДляСделок КАК ТаблицаДляСделок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаРегистраторов.Регистратор КАК Регистратор,
		|	_ТаблицаРегистраторов.Период КАК Дата,
		|	&ПоляДляТаблицаРегистраторов КАК ПоляДляТаблицаРегистраторов
		|ИЗ
		|	_ТаблицаРегистраторов КАК _ТаблицаРегистраторов
		|ГДЕ
		|	_ТаблицаРегистраторов.ПлановыеДанные";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляДляТаблицаДляСделок КАК ПоляДляТаблицаДляСделок", ПоляДляТаблицаДляСделок);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляДляТаблицаРегистраторов КАК ПоляДляТаблицаРегистраторов", ПоляДляТаблицаРегистраторов);
	
	
	ТипыРегистраторов = Метаданные.РегистрыНакопления[ИмяРегистра].СтандартныеРеквизиты.Регистратор.Тип.Типы();
	Для каждого ТипРегистратора Из ТипыРегистраторов Цикл
	
		МдРегистратора = Метаданные.НайтиПоТипу(ТипРегистратора);
		
		ПоляВыборки = "ДокументРегистратор.Дата КАК Дата";
		
		Для каждого Поле Из МассивПолей Цикл
			Реквизит = МдРегистратора.Реквизиты.Найти(Поле);
			ПоляВыборки = ПоляВыборки + ", " + Символы.ПС + Символы.Таб + ?(Реквизит = Неопределено, "НЕОПРЕДЕЛЕНО", "ДокументРегистратор." + Реквизит.Имя) + " КАК " + Поле;
		КонецЦикла; 
		
		Запрос.Текст = Запрос.Текст + СтрЗаменить(СтрЗаменить("
			|
			|ОБЪЕДИНИТЬ
			|
			|" + "ВЫБРАТЬ
			|	ДокументРегистратор.Ссылка КАК Регистратор,
		   	|	&ПоляВыборки КАК ПоляВыборки
		   	|ИЗ
		   	|	_ТаблицаРегистраторов КАК _ТаблицаРегистраторов
		   	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК ДокументРегистратор
		   	|		ПО _ТаблицаРегистраторов.Регистратор = ДокументРегистратор.Ссылка
		   	|ГДЕ
		   	|	НЕ _ТаблицаРегистраторов.ПлановыеДанные", "Сделка", МдРегистратора.Имя), "&ПоляВыборки КАК ПоляВыборки", ПоляВыборки);
	
	КонецЦикла; 
	
	Соответствие = Новый Соответствие;
	
	Для Каждого ТекСтрока Из Запрос.Выполнить().Выгрузить() Цикл
		Соответствие.Вставить(ТекСтрока.Регистратор, ТекСтрока);
	КонецЦикла;
	
	Возврат Соответствие;
		
КонецФункции

Процедура РассчитатьПартииБУНУ(Отказ, НастройкиПоВидуУчета)
	
	// Итак, у нас есть случаи, когда погашение купона(пока только оно) проводится раньше поступления бумаг
	// из-за хитрых вывертов брокера
	// но списывать как-то надо
	// заведем массив таблицу HardcoreParty
	// это захардкоженые движения партий
	// т.е. по определенным регистраторам будут подствляться именно эти движения
	НестандартныеДвиженияПартий = ЗаполнитьНестандартныеДвиженияПартий();	
	// если что, то заполнение этих партий есть в обработке:
	// \\am-1c00\Коля\ПолучитьДвиженияПартийДляНестандартныхОпераций.erf
	// там юзается ЗначениеВСтрокуВнутр
	
	// нужет для тех случаев чтобы 1 раз заполнить нестандартные движения партий
	// и больше этот регистратор не трогать
	МассивОбработанныхРегистраторов = Новый Массив;
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ = РегистрыСведений.НастройкиУчетаОбщие.ПолучитьДатуНачалаНеобходимостиДанныхЕПСВоВводахЦБ(СчетДоверительногоУправленияДляУчета);	
	
	РесурсыПартий = Новый Массив;
	РесурсыПартий.Добавить("Количество");
	РесурсыПартий.Добавить("СтоимостьПокупки");
	РесурсыПартий.Добавить("СтоимостьПокупкиКупона");
	РесурсыПартий.Добавить("РасходыПриПокупкеВСтоимости");
	РесурсыПартий.Добавить("РасходыПриПокупкеВСтоимостиВВалютеУчета");
	РесурсыПартий.Добавить("ПереоценкаВСтоимости");
	РесурсыПартий.Добавить("ПереоценкаКупонаВСтоимости");
	РесурсыПартий.Добавить("Стоимость");
	РесурсыПартий.Добавить("СтоимостьВВалютеУчета");
	РесурсыПартий.Добавить("СтоимостьКупона");
	РесурсыПартий.Добавить("СтоимостьКупонаВВалютеУчета");
	РесурсыПартий.Добавить("Переоценка");
	РесурсыПартий.Добавить("ПереоценкаВВалютеУчета");
	РесурсыПартий.Добавить("ПереоценкаКупона");
	РесурсыПартий.Добавить("ПереоценкаКупонаВВалютеУчета");
	РесурсыПартий.Добавить("ИндексацияНоминала");
	РесурсыПартий.Добавить("ИндексацияНоминалаЗаВремяВладения");
	РесурсыПартий.Добавить("СуммаЧастичногоПогашения");
		
	ЭтоНалоговыйУчет = ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет;
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.КонецПериода,
		ЭтотОбъект.Организация,
		СчетДоверительногоУправленияДляУчета);
	
	Если НастройкиПоВидуУчета = Неопределено Тогда
		
		НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
			ЭтотОбъект.КонецПериода,
			ЭтотОбъект.Организация,
			СчетДоверительногоУправленияДляУчета,
			ЭтотОбъект.ВидУчета,
			Отказ);
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	НастройкиУчетаПереоценки = БухгалтерскийУчет.ОпределитьНастройкиУчетаПереоценки(
		ЭтотОбъект.КонецПериода,
		ЭтотОбъект.Организация,
		СчетДоверительногоУправленияДляУчета,
		ЭтотОбъект.ВидУчета);
		
	НастройкиУчетаИндексацииНоминала = БухгалтерскийУчет.ОпределитьНастройкиУчетаИндексацииНоминала(
		ЭтотОбъект.КонецПериода,
		ЭтотОбъект.Организация,
		СчетДоверительногоУправленияДляУчета,
		ЭтотОбъект.ВидУчета);
		
