										- СтрокаПартииКупленныеПоРЕПО.СтоимостьВВалютеУчета;
									НовоеДвижениеРЕПО.СтоимостьКупонаВВалютеУчета = 
										Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаПартииКупленныеПоРЕПО.СтоимостьКупона, ВыборкаДетальныеЗаписиДляРЕПО.ВалютаСделки, ЭтотОбъект.Организация, ?(ВыборкаДетальныеЗаписиДляРЕПО.СобственныйКурсОплаты, ВыборкаДетальныеЗаписиДляРЕПО.КурсОплаты, ВыборкаДетальныеЗаписи.Период), Отказ), 2)
										- СтрокаПартииКупленныеПоРЕПО.СтоимостьКупонаВВалютеУчета;
										
									СтрокаПартииКупленныеПоРЕПО.СтоимостьВВалютеУчета = СтрокаПартииКупленныеПоРЕПО.СтоимостьВВалютеУчета + НовоеДвижениеРЕПО.СтоимостьВВалютеУчета;
									СтрокаПартииКупленныеПоРЕПО.СтоимостьКупонаВВалютеУчета = СтрокаПартииКупленныеПоРЕПО.СтоимостьКупонаВВалютеУчета + НовоеДвижениеРЕПО.СтоимостьКупонаВВалютеУчета;
									
								КонецЦикла;
								
							ИначеЕсли ВыборкаДетальныеЗаписиДляРЕПО.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО Тогда
								
								//списать суммы
								СтрокиПартийКупленныеПоРЕПО = ПартииКупленныеПоРЕПО.НайтиСтроки(Новый Структура("Партия",ВыборкаДетальныеЗаписиДляРЕПО.ПоставкаЦенныхБумагПоПервойЧасти));
								Для каждого СтрокаПартииКупленныеПоРЕПО Из СтрокиПартийКупленныеПоРЕПО Цикл
									НовоеДвижениеРЕПО = РассчитанныеПартииОбратноеРЕПО.Добавить();
									ЗаполнитьЗначенияСвойств(НовоеДвижениеРЕПО, СтрокаПартииКупленныеПоРЕПО);
									
									НовоеДвижениеРЕПО.ВидДвижения = Перечисления.ВидыДвижений.Расход;
									НовоеДвижениеРЕПО.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
									НовоеДвижениеРЕПО.Период = ВыборкаДетальныеЗаписи.Период;
									НовоеДвижениеРЕПО.Количество = 0;
									НовоеДвижениеРЕПО.Стоимость = СтрокаПартииКупленныеПоРЕПО.Стоимость;
									НовоеДвижениеРЕПО.СтоимостьВВалютеУчета = СтрокаПартииКупленныеПоРЕПО.СтоимостьВВалютеУчета;
									НовоеДвижениеРЕПО.СтоимостьКупона = СтрокаПартииКупленныеПоРЕПО.СтоимостьКупона;
									НовоеДвижениеРЕПО.СтоимостьКупонаВВалютеУчета = СтрокаПартииКупленныеПоРЕПО.СтоимостьКупонаВВалютеУчета;
									
									СтрокаПартииКупленныеПоРЕПО.Стоимость = 0;
									СтрокаПартииКупленныеПоРЕПО.СтоимостьВВалютеУчета = 0;
									СтрокаПартииКупленныеПоРЕПО.СтоимостьКупона = 0;
									СтрокаПартииКупленныеПоРЕПО.СтоимостьКупонаВВалютеУчета = 0;
									
								КонецЦикла;
								
							КонецЕсли;
							
						КонецЦикла;

					КонецЕсли;
					
					#КонецОбласти
					
				// ПРОДАЖИ НАЧИНАЮТЯ ОТСЮДА
				Иначе //Остальные расходы спишем с приходов. Остальные это 
				
					ЭтоПрямоеРЕПО = Ложь;
					ЭтоЗакрытиеОбратногоРЕПО = Ложь;
					Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
					    Если РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].ЧастьСделкиРЕПО = 1 Тогда
							ЭтоПрямоеРЕПО = Истина;
						ИначеЕсли РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].ЧастьСделкиРЕПО = 2 Тогда
							ЭтоЗакрытиеОбратногоРЕПО = Истина;
						КонецЕсли;
					ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг")
						И ТипЗнч(РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].Основание) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
					    Если РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].Основание.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
							ЭтоПрямоеРЕПО = Истина;
						ИначеЕсли РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].Основание.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
							ЭтоЗакрытиеОбратногоРЕПО = Истина;
						КонецЕсли;
					КонецЕсли;
					
					Если ЭтоЗакрытиеОбратногоРЕПО И НастройкиПоВидуУчета.УчитыватьПартииРЕПООтдельно Тогда

						// просто списываем РЕПОшные партии
						ПартииКупленныеПоРЕПОКУдалению = Новый Массив;
						
						Если ТипЗнч(ВыборкаДетальныеЗаписи.Партия) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
							ПартииКупленныеПоРЕПОПоСделке = ПартииКупленныеПоРЕПО.НайтиСтроки(Новый Структура("Партия,СтрокаПартии", ВыборкаДетальныеЗаписи.Партия.ПерваяЧастьРЕПО, ВыборкаДетальныеЗаписи.СтрокаПартии));
						Иначе
							ПартииКупленныеПоРЕПОПоСделке = Новый Массив;
							
							ПартииКупленныеПоРЕПОПоБумаге = ПартииКупленныеПоРЕПО.НайтиСтроки(Новый Структура("ЦеннаяБумага", ВыборкаДетальныеЗаписи.ЦеннаяБумага));
							Для Каждого ПартияКупленнаяПоРЕПОПоБумаге ИЗ ПартииКупленныеПоРЕПОПоБумаге Цикл
								//куда пихать СтрокаПродажиРЕПО?
								Если НЕ ЗначениеЗаполнено(ПартияКупленнаяПоРЕПОПоБумаге.Партия) Тогда
									//пока Коля не отпустит переоценку. Там не заполнены измерения
									Продолжить;
								КонецЕсли;
								//т.к. иногда бывают(бывали?) отложенные исполнения по биржевым РЕПО
								Если ТипЗнч(ПартияКупленнаяПоРЕПОПоБумаге.Партия) = Тип("ДокументСсылка.СделкаРЕПО") 
										И ПартияКупленнаяПоРЕПОПоБумаге.Партия = ВыборкаДетальныеЗаписи.Партия.Основание 
									ИЛИ ТипЗнч(ПартияКупленнаяПоРЕПОПоБумаге.Партия) <> Тип("ДокументСсылка.СделкаРЕПО")
										И ПартияКупленнаяПоРЕПОПоБумаге.Партия.Основание = ВыборкаДетальныеЗаписи.Партия.Основание Тогда
									
									ПартииКупленныеПоРЕПОПоСделке.Добавить(ПартияКупленнаяПоРЕПОПоБумаге);
									
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;                     
						
						ОсталосьЗакрытьКупленныхПоРЕПО = ВыборкаДетальныеЗаписи.Количество;
						
						Для каждого СтрокаПартииКупленныеПоРЕПОПоСделке Из ПартииКупленныеПоРЕПОПоСделке Цикл
							
							Если ОсталосьЗакрытьКупленныхПоРЕПО = 0 Тогда
								Прервать;
							КонецЕсли;
							
							ЗакроемПоРЕПО = Мин(СтрокаПартииКупленныеПоРЕПОПоСделке.Количество, ОсталосьЗакрытьКупленныхПоРЕПО);
							ОсталосьЗакрытьКупленныхПоРЕПО = ОсталосьЗакрытьКупленныхПоРЕПО - ЗакроемПоРЕПО;
							
							// движение по партиям РЕПО расход сделать
							НовоеДвижениеРЕПО = РассчитанныеПартииОбратноеРЕПО.Добавить();
							ЗаполнитьЗначенияСвойств(НовоеДвижениеРЕПО, СтрокаПартииКупленныеПоРЕПОПоСделке);
							
							НовоеДвижениеРЕПО.ВидДвижения = Перечисления.ВидыДвижений.Расход;
							НовоеДвижениеРЕПО.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
							НовоеДвижениеРЕПО.Период = ВыборкаДетальныеЗаписи.Период;
							НовоеДвижениеРЕПО.СтрокаКорзиныЦенныхБумаг = СтрокаПартииКупленныеПоРЕПОПоСделке.СтрокаПартии;
							
							Если ЗакроемПоРЕПО = СтрокаПартииКупленныеПоРЕПОПоСделке.Количество Тогда
								// запомним, что удалить надо из репошных 
								ПартииКупленныеПоРЕПОКУдалению.Добавить(СтрокаПартииКупленныеПоРЕПОПоСделке);
							Иначе
								
								КоэффициентСписания = ЗакроемПоРЕПО / НовоеДвижениеРЕПО.Количество;
								
								НовоеДвижениеРЕПО.Количество 							= ЗакроемПоРЕПО;
								НовоеДвижениеРЕПО.Стоимость 							= НовоеДвижениеРЕПО.Стоимость * КоэффициентСписания;
								НовоеДвижениеРЕПО.СтоимостьКупона 						= НовоеДвижениеРЕПО.СтоимостьКупона * КоэффициентСписания;
								НовоеДвижениеРЕПО.СтоимостьВВалютеУчета 				= НовоеДвижениеРЕПО.СтоимостьВВалютеУчета * КоэффициентСписания;
								НовоеДвижениеРЕПО.СтоимостьКупонаВВалютеУчета 			= НовоеДвижениеРЕПО.СтоимостьКупонаВВалютеУчета * КоэффициентСписания;
								НовоеДвижениеРЕПО.Переоценка 							= НовоеДвижениеРЕПО.Переоценка * КоэффициентСписания;
								НовоеДвижениеРЕПО.ПереоценкаВВалютеУчета 				= НовоеДвижениеРЕПО.ПереоценкаВВалютеУчета * КоэффициентСписания;
								НовоеДвижениеРЕПО.ПереоценкаКупона 						= НовоеДвижениеРЕПО.ПереоценкаКупона * КоэффициентСписания;
								НовоеДвижениеРЕПО.ПереоценкаКупонаВВалютеУчета 			= НовоеДвижениеРЕПО.ПереоценкаКупонаВВалютеУчета * КоэффициентСписания;
								
								СтрокаПартииКупленныеПоРЕПОПоСделке.Количество = СтрокаПартииКупленныеПоРЕПОПоСделке.Количество - НовоеДвижениеРЕПО.Количество;
								СтрокаПартииКупленныеПоРЕПОПоСделке.Стоимость = СтрокаПартииКупленныеПоРЕПОПоСделке.Стоимость - НовоеДвижениеРЕПО.Стоимость;
								СтрокаПартииКупленныеПоРЕПОПоСделке.СтоимостьКупона = СтрокаПартииКупленныеПоРЕПОПоСделке.СтоимостьКупона - НовоеДвижениеРЕПО.СтоимостьКупона;
								СтрокаПартииКупленныеПоРЕПОПоСделке.СтоимостьВВалютеУчета = СтрокаПартииКупленныеПоРЕПОПоСделке.СтоимостьВВалютеУчета - НовоеДвижениеРЕПО.СтоимостьВВалютеУчета;
								СтрокаПартииКупленныеПоРЕПОПоСделке.СтоимостьКупонаВВалютеУчета = СтрокаПартииКупленныеПоРЕПОПоСделке.СтоимостьКупонаВВалютеУчета - НовоеДвижениеРЕПО.СтоимостьКупонаВВалютеУчета;
								СтрокаПартииКупленныеПоРЕПОПоСделке.Переоценка = СтрокаПартииКупленныеПоРЕПОПоСделке.Переоценка - НовоеДвижениеРЕПО.Переоценка;
								СтрокаПартииКупленныеПоРЕПОПоСделке.ПереоценкаВВалютеУчета = СтрокаПартииКупленныеПоРЕПОПоСделке.ПереоценкаВВалютеУчета - НовоеДвижениеРЕПО.ПереоценкаВВалютеУчета;
								СтрокаПартииКупленныеПоРЕПОПоСделке.ПереоценкаКупона = СтрокаПартииКупленныеПоРЕПОПоСделке.ПереоценкаКупона - НовоеДвижениеРЕПО.ПереоценкаКупона;
								СтрокаПартииКупленныеПоРЕПОПоСделке.ПереоценкаКупонаВВалютеУчета = СтрокаПартииКупленныеПоРЕПОПоСделке.ПереоценкаКупонаВВалютеУчета - НовоеДвижениеРЕПО.ПереоценкаКупонаВВалютеУчета;
								
							КонецЕсли;
								
						КонецЦикла;
						
						Если ОсталосьЗакрытьКупленныхПоРЕПО <> 0 Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На момент документа " + Строка(ВыборкаДетальныеЗаписи.Регистратор) + " / "+ Строка(ВыборкаДетальныеЗаписи.ЦеннаяБумага)+" не хватает " + ОсталосьЗакрытьКупленныхПоРЕПО, ВыборкаДетальныеЗаписи.Регистратор,,,Отказ);
						КонецЕсли;
						
						// удалим партии РЕПО
						Для каждого СтрокаПартииКупленныеПоРЕПОКУдалению Из ПартииКупленныеПоРЕПОКУдалению Цикл
							ПартииКупленныеПоРЕПО.Удалить(СтрокаПартииКупленныеПоРЕПОКУдалению);
						КонецЦикла;
						
					Иначе
						
						Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ВыводЦенныхБумаг")
							И (НастройкиПоВидуУчета.ПереоцениватьАктивыПередВыводом ИЛИ НастройкиПоВидуУчета.НачислятьПроцентныеДоходыПоВыводимымАктивам) Тогда
						
							ПереоценкаПередВыводами = ПереоценкиПередВыводами.НайтиСтроки(Новый Структура("Ссылка,ЦеннаяБумага",
																ВыборкаДетальныеЗаписи.Регистратор,
																ВыборкаДетальныеЗаписи.ЦеннаяБумага));
																
							Если ПереоценкаПередВыводами.Количество() = 0 // цена должна быть хоть какая-нибудь
								ИЛИ ПереоценкаПередВыводами.Количество() <> 1 И ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет Тогда // но для НУ допустима ситуация нескольких цен из-за параллельного ЕПСа и цен по АС
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить цену бумаги перед выводом:" + Строка(ВыборкаДетальныеЗаписи.Регистратор) + " / "+ Строка(ВыборкаДетальныеЗаписи.ЦеннаяБумага));
								Отказ = Истина;
							Иначе
								СуммаРынокВсего = ПереоценкаПередВыводами[0].СуммаРынок;
								СуммаРынокВВалютеУчетаВсего = ПереоценкаПередВыводами[0].СуммаРынокВВалютеУчета;
								КоличествоВсего = ПереоценкаПередВыводами[0].Количество;
							КонецЕсли;
							
						ИначеЕсли НастройкиПоВидуУчета.ПереоцениватьАктивыПередПродажей И ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) <> Тип("ДокументСсылка.ВыводЦенныхБумаг") Тогда
							
							ПереоценкаПередПродажами = ПереоценкиДляОпераций.НайтиСтроки(Новый Структура("Ссылка,ЦеннаяБумага,ВидДвижения",
																ВыборкаДетальныеЗаписи.Регистратор,
																ВыборкаДетальныеЗаписи.ЦеннаяБумага,
																Перечисления.ВидыДвижений.Расход));
																
							Если ПереоценкаПередПродажами.Количество() <> 1 Тогда
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить цену бумаги перед продажей:" + Строка(ВыборкаДетальныеЗаписи.Регистратор) + " / "+ Строка(ВыборкаДетальныеЗаписи.ЦеннаяБумага));
								Отказ = Истина;
							Иначе
								СуммаРынокВсего = ПереоценкаПередПродажами[0].СуммаРынок;
								СуммаРынокВВалютеУчетаВсего = ПереоценкаПередПродажами[0].СуммаРынокВВалютеУчета;
								КоличествоВсего = ПереоценкаПередПродажами[0].Количество; 
							КонецЕсли;
							
						ИначеЕсли ДоначислятьКупонДоПолнойСтоимостиПередПродажейИПогашением Тогда
							
							СуммаКупонаНаОднуОблигацию = Справочники.Облигации.ПолучитьКупон(ВыборкаДетальныеЗаписи.ЦеннаяБумага, ВыборкаДетальныеЗаписи.Период, СчетДоверительногоУправленияДляУчета);
							
						КонецЕсли;
						
						ПриходныеПартииКУдалению = Новый Массив;
						
						КоличествоКСписанию = ВыборкаДетальныеЗаписи.Количество;
						
						Для каждого СтрокаПриходныхПартий Из ПриходныеПартии Цикл
							
							Если КоличествоКСписанию = 0 Тогда
								Прервать;
							КонецЕсли;
							
							КоличествоКСписаниюПоПартии = Мин(СтрокаПриходныхПартий.Количество, КоличествоКСписанию);
							
							// #416666 - настройка РаспределениеПартийНУДолжноСовпадатьСЕПС
							Если ЭтоНалоговыйУчет И НастройкиУчета.РаспределениеПартийНУДолжноСовпадатьСЕПС Тогда
								
								Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ВыводЦенныхБумаг")
									И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Партия)
									И СписокСтратегий.Найти(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаДетальныеЗаписи.Партия, "СчетДоверительногоУправления")) <> Неопределено Тогда
								
									Если СтрокаПриходныхПартий.Партия <> ВыборкаДетальныеЗаписи.Партия
										ИЛИ СтрокаПриходныхПартий.СтрокаПартии <> ВыборкаДетальныеЗаписи.СтрокаПартии Тогда
										
										Продолжить;
									
									КонецЕсли;	
									
								Иначе // для сделок и исполнений, увы, приходится смотреть как это делает ЕПС
									
									// а как ЕПС списывал данную партию?
									СписаниеПартииЕПС = СписанияПартийЕПС.НайтиСтроки(
															Новый Структура("Регистратор, ЦеннаяБумага, Партия, СтрокаПартии",
																ВыборкаДетальныеЗаписи.Регистратор,
																ЦеннаяБумага,
																СтрокаПриходныхПартий.Партия,
																СтрокаПриходныхПартий.СтрокаПартии));
																
									Если СписаниеПартииЕПС.Количество() = 0 Тогда 
										// Если никак не списывал, то и мы не будем
										Продолжить;								
									ИначеЕсли СписаниеПартииЕПС[0].Количество = 0 Тогда 
										Продолжить;
									Иначе
										// Сколько ЕПС списал - столько же и мы спишем
										КоличествоКСписаниюПоПартии = СписаниеПартииЕПС[0].Количество;
										СписаниеПартииЕПС[0].Количество = 0;
									КонецЕсли;
									
								КонецЕсли;
							
							КонецЕсли;
							
							МассивРесурсовКПерекурсовке = Неопределено;
							ТребуетсяПерекурсовка = Ложь; 
							Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ВыводЦенныхБумаг") Тогда
								ТребуетсяПерекурсовка = Истина;
							ИначеЕсли ЭтоПрямоеРЕПО Тогда
								ТребуетсяПерекурсовка = Истина;
							ИначеЕсли ЭтоРынокОблигаций И ЭтоФизЛицо И ЭтоНалоговыйУчет И ВыборкаДетальныеЗаписи.ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Государственная Тогда 
								// 214.1 НК РФ: 
								ТребуетсяПерекурсовка = Истина;
								
								МассивРесурсовКПерекурсовке = Новый Массив;
								МассивРесурсовКПерекурсовке.Добавить("СтоимостьВВалютеУчета");
								МассивРесурсовКПерекурсовке.Добавить("СтоимостьКупонаВВалютеУчета");
								
							ИначеЕсли НЕ ЭтоНалоговыйУчет Тогда
								ТребуетсяПерекурсовка = Истина; //#452426  
							КонецЕсли;
							
							Если ТребуетсяПерекурсовка Тогда
								
								НовоеДвижениеПерекурсовка = Перекурсовка(ВыборкаДетальныеЗаписи.Регистратор, ЭтотОбъект.РассчитанныеПартии, ВыборкаДетальныеЗаписи.Период, СтрокаПриходныхПартий, КоличествоКСписаниюПоПартии, ВыборкаДетальныеЗаписи.СтрокаПартии,, МассивРесурсовКПерекурсовке,Новый Структура("ОтражатьНаПриходнойПартии", Ложь), Отказ);
								НовоеДвижениеПерекурсовка.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
								
								Если Отказ Тогда
									Возврат;
								КонецЕсли;
								
							Иначе
								НовоеДвижениеПерекурсовка = Неопределено;
							КонецЕсли;
							
							НовоеДвижениеИндексация = Неопределено;
							
							Если ИндексируемыйНоминал И ИндексироватьНоминал Тогда
								//индексируемый номинал пока только у рублевых бумаг, поэтому не заморачиваемся
								
								НовоеДвижениеИндексация = Неопределено;
								НовоеДвижениеИндексация = ИндексацияНоминала(ВыборкаДетальныеЗаписи.Регистратор,
																				ВыборкаДетальныеЗаписи.Период,
																				СтрокаПриходныхПартий,
