		|	0,
		|	0,
		|	ОперацииСЦеннымиБумагами.Сумма,
		|	0,
		|	0,
		|	0,
		|	0,
		|	ОперацииСЦеннымиБумагами.ДатаОперации,
		|	ОперацииСЦеннымиБумагами.Регистратор,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход),
		|	ВЫРАЗИТЬ(ОперацииСЦеннымиБумагами.Регистратор КАК Документ.ИсполнениеРешенияОбИзмененииУставногоКапиталаООО).МоментВремени,
		|	"""",
		|	ОперацииСЦеннымиБумагами.Сумма * КурсВалютыНоминала.Курс / КурсВалютыНоминала.Кратность,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	ЛОЖЬ,
		|	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка)
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыНоминала
		|		ПО (НАЧАЛОПЕРИОДА(ОперацииСЦеннымиБумагами.ДатаОперации, ДЕНЬ) = КурсВалютыНоминала.Период)
		|			И (ВЫРАЗИТЬ(ОперацииСЦеннымиБумагами.ЦеннаяБумага КАК Справочник.Доли).ВалютаНоминала = КурсВалютыНоминала.Валюта)
		|ГДЕ
		|	ОперацииСЦеннымиБумагами.Организация = &Организация
		|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления В(&СписокСтратегий)
		|	И ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Регистратор) = ТИП(Документ.ИсполнениеРешенияОбИзмененииУставногоКапиталаООО)
		|	И ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &НачалоПериода И &КонецПериода
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОперацииСЦеннымиБумагами.Рынок,
		|	ОперацииСЦеннымиБумагами.ЦеннаяБумага,
		|	ОперацииСЦеннымиБумагами.Регистратор,
		|	&ВалютаУчета,
		|	ОперацииСЦеннымиБумагами.НомерСтроки,
		|	ОперацииСЦеннымиБумагами.Количество,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	ОперацииСЦеннымиБумагами.Сумма,
		|	0,
		|	0,
		|	0,
		|	0,
		|	ОперацииСЦеннымиБумагами.ДатаОперации,
		|	ОперацииСЦеннымиБумагами.Регистратор,
		|	ОперацииСЦеннымиБумагами.ВидДвижения,
		|	ВЫРАЗИТЬ(ОперацииСЦеннымиБумагами.Регистратор КАК Документ.КонвертацияЦенныхБумаг).МоментВремени,
		|	"""",
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	ЛОЖЬ,
		|	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка)
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|ГДЕ
		|	ОперацииСЦеннымиБумагами.Организация = &Организация
		|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления В(&СписокСтратегий)
		|	И ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Регистратор) = ТИП(Документ.КонвертацияЦенныхБумаг)
		|	И ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &НачалоПериода И &КонецПериода
		|
		|УПОРЯДОЧИТЬ ПО
		|	УчетныйАктивЕПС" + Порядок + ",
		|	Период" + Порядок + ",
		|	ДатаПокупки" + Порядок + ",
		|	НомерСделки" + Порядок + ",
		|	МоментВремени" + Порядок + ",
		|	СтрокаПартии" + Порядок + "
		|ИТОГИ ПО
		|	Рынок,
		|	ЦеннаяБумага";
	
	#КонецОбласти
	
	Если ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВыбытиеПоБУ", "ВыбытиеПоНУ");
	КонецЕсли;
		
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.КонецПериода));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВидУчета", ЭтотОбъект.ВидУчета);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
	Запрос.УстановитьПараметр("СписокСтратегий", СписокСтратегий);
	Запрос.УстановитьПараметр("ВключатьВводыВыводы", ВключатьВводыВыводы);
	Запрос.УстановитьПараметр("ЕстьВозможностьУчитыватьЦенныеБумагиПоАмортизированнойСтоимости", НастройкиУчета.ЕстьВозможностьУчитыватьЦенныеБумагиПоАмортизированнойСтоимости);
	Запрос.УстановитьПараметр("ВалютаУчета", ВалютаУчета);
	
	// #678414 - по БУ и НУ курс валюты должен браться по дате ДОГОВОРА (т.е. Сделки, а не исполнения или поставки)
	// чтобы не поломать старые периоды завожу ДатаПереходаКВзятиюКурсовВалютДатойДоговора
	// #техдолг - прикрутить настройку ВариантВзятияКурсаВалютныхБумагПриСделкахВРубляхДляРасчетаСтоимости из настроек по виду учета
	Запрос.УстановитьПараметр("ДатаПереходаКВзятиюКурсовВалютДатойДоговора", '20250501');
	
	РезультатЗапроса = Запрос.Выполнить();
	
	РеквизитыРегистраторов = ПолучитьРеквизитыДокументов(РезультатЗапроса.Выгрузить(ОбходРезультатаЗапроса.Прямой), "БухПартииЦенныхБумаг");
	
	Если НастройкиУчета.ЕстьВозможностьУчитыватьЦенныеБумагиПоАмортизированнойСтоимости Тогда
	
		ТаблицаСделок = Новый ТаблицаЗначений;
		ТаблицаСделок.Колонки.Добавить("Основание", Метаданные.ОпределяемыеТипы.Сделки.Тип);
		
		ТаблицаДляСделок = РезультатЗапроса.Выгрузить(ОбходРезультатаЗапроса.Прямой);
		ТаблицаДляСделок.Свернуть("Регистратор", "");
		Для каждого СтрокаТаблицыДляСделок Из ТаблицаДляСделок Цикл
			Если ТипЗнч(СтрокаТаблицыДляСделок.Регистратор) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
				СтрокаТаблицаСделок = ТаблицаСделок.Добавить();
				СтрокаТаблицаСделок.Основание = СтрокаТаблицыДляСделок.Регистратор.Основание;
			ИначеЕсли ТипЗнч(СтрокаТаблицыДляСделок.Регистратор) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг") Тогда
				СтрокаТаблицаСделок = ТаблицаСделок.Добавить();
				СтрокаТаблицаСделок.Основание = СтрокаТаблицыДляСделок.Регистратор.Основание;
			ИначеЕсли ТипЗнч(СтрокаТаблицыДляСделок.Регистратор) = Тип("ДокументСсылка.Сделка") Тогда
				СтрокаТаблицаСделок = ТаблицаСделок.Добавить();
				СтрокаТаблицаСделок.Основание = СтрокаТаблицыДляСделок.Регистратор;
			ИначеЕсли ТипЗнч(СтрокаТаблицыДляСделок.Регистратор) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
				СтрокаТаблицаСделок = ТаблицаСделок.Добавить();
				СтрокаТаблицаСделок.Основание = СтрокаТаблицыДляСделок.Регистратор;
			КонецЕсли;
		КонецЦикла;
		
		ТаблицаСделок.Свернуть("Основание", "");
		
		РаспределенияПоСделкам = БухгалтерскийУчетЕПС.ПолучитьРаспределениеПоВидуАктива(ТаблицаСделок);
		РаспределенияПоСделкам.Индексы.Добавить("Сделка, ЦеннаяБумага"); 
	
	КонецЕсли;
	
	ВыборкаРынок = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаРынок.Следующий() Цикл
		Рынок = ВыборкаРынок.Рынок;
		ЭтоРынокОблигаций = Рынок = Перечисления.РынкиЦенныхБумаг.Облигации;
		
		ВыборкаЦеннаяБумага = ВыборкаРынок.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаЦеннаяБумага.Следующий() Цикл
			
			ЦеннаяБумага 		= ВыборкаЦеннаяБумага.ЦеннаяБумага;
			УчетныйАктив 		= БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.КонецПериода, Рынок, ЦеннаяБумага);
			УчетныйАктивКупон 	= БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.КонецПериода, Рынок, ЦеннаяБумага, Истина);
			
			Если ЭтоНалоговыйУчет Тогда 				
				НастройкиУчетаАктиваКупон = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
					ЭтотОбъект.КонецПериода,
					ЭтотОбъект.Организация,
					СчетДоверительногоУправленияДляУчета,
					УчетныйАктивКупон,
					ЭтотОбъект.ВидУчета);	
			Иначе 
				НастройкиУчетаАктиваКупон = Неопределено;
			КонецЕсли;	
			
			УчитыватьПереоценкуОтдельно 	 = ?(НастройкиУчетаПереоценки.Свойство(УчетныйАктив.ИмяПредопределенныхДанных), 	 НастройкиУчетаПереоценки[УчетныйАктив.ИмяПредопределенныхДанных], Неопределено);
			УчитыватьПереоценкуОтдельноКупон = ?(НастройкиУчетаПереоценки.Свойство(УчетныйАктивКупон.ИмяПредопределенныхДанных), НастройкиУчетаПереоценки[УчетныйАктивКупон.ИмяПредопределенныхДанных], Неопределено);
			
			ОтражатьНаПереоценкеПолнуюСумму  	 = ?(НастройкиУчетаОтражатьНаПереоценкеПолнуюСумму.Свойство(УчетныйАктив.ИмяПредопределенныхДанных), 	  НастройкиУчетаОтражатьНаПереоценкеПолнуюСумму[УчетныйАктив.ИмяПредопределенныхДанных], Неопределено);
			ОтражатьНаПереоценкеПолнуюСуммуКупон = ?(НастройкиУчетаОтражатьНаПереоценкеПолнуюСумму.Свойство(УчетныйАктивКупон.ИмяПредопределенныхДанных), НастройкиУчетаОтражатьНаПереоценкеПолнуюСумму[УчетныйАктивКупон.ИмяПредопределенныхДанных], Неопределено);
			
			ВариантПогашения 			= ?(НастройкиУчетаПогашения.Свойство(УчетныйАктив.ИмяПредопределенныхДанных), 		НастройкиУчетаПогашения[УчетныйАктив.ИмяПредопределенныхДанных], Неопределено);
			ВариантЧастичногоПогашения 	= ?(НастройкиУчетаЧастичногоПогашения.Свойство(УчетныйАктив.ИмяПредопределенныхДанных),  НастройкиУчетаЧастичногоПогашения[УчетныйАктив.ИмяПредопределенныхДанных], Неопределено);
			
			УчитыватьИндексациюОтдельно 	 = ?(НастройкиУчетаИндексацииНоминала.Свойство(УчетныйАктив.ИмяПредопределенныхДанных), 	 НастройкиУчетаИндексацииНоминала[УчетныйАктив.ИмяПредопределенныхДанных], Неопределено);
			
			ДоначислятьКупонДоПолнойСтоимостиПередПродажейИПогашением = ?(НастройкиДоначислятьКупонДоПолнойСтоимостиПередПродажейИПогашением.Свойство(УчетныйАктивКупон.ИмяПредопределенныхДанных), НастройкиДоначислятьКупонДоПолнойСтоимостиПередПродажейИПогашением[УчетныйАктивКупон.ИмяПредопределенныхДанных], Неопределено);
			
			ВалютаНоминала = ЦеннаяБумага.ВалютаНоминала;
			
			ИндексируемыйНоминал = Ложь;
			ЭтоДефолтнаяОблигация = Ложь;
			Если ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
				ИндексируемыйНоминал = ЦеннаяБумага.ИндексируемыйНоминал;
				
				ЭтоДефолтнаяОблигация = (ВыборкаЦеннаяБумага.ЦеннаяБумага.ДатаПогашения < НачалоДня(ЭтотОбъект.НачалоПериода));
				
				Если ВыборкаЦеннаяБумага.ЦеннаяБумага.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Эмитент_Прайм") Тогда
					ЭтоДефолтнаяОблигация = Истина;
				КонецЕсли;
				
			КонецЕсли;
			
			ПриходныеПартии = ТаблицаШаблон.СкопироватьКолонки();
			
			ПогрешностиОкругления = ТаблицаШаблон.СкопироватьКолонки();
			
			ВыборкаДетальныеЗаписи = ВыборкаЦеннаяБумага.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				Если НестандартныеДвиженияПартий.Количество() > 0 Тогда
					
					Если МассивОбработанныхРегистраторов.Найти(ВыборкаДетальныеЗаписи.Регистратор) <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					НестандартныеДвиженияПартийПоРегистратору = НестандартныеДвиженияПартий.НайтиСтроки(Новый Структура("Регистратор", ВыборкаДетальныеЗаписи.Регистратор));
					
					Если НестандартныеДвиженияПартийПоРегистратору.Количество() > 0 Тогда
					
						Для каждого СтрокаДвиженияПартий Из НестандартныеДвиженияПартийПоРегистратору Цикл
						
							НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
							ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаДвиженияПартий);
						
						КонецЦикла;
						
						МассивОбработанныхРегистраторов.Добавить(ВыборкаДетальныеЗаписи.Регистратор);
						
						Продолжить;
						
					КонецЕсли;
				
				КонецЕсли;
				
				
				// уточнения по методу расчета по-среднему (+ добавильст партии по АС, которые идут именно как партии):
				// 1. при списании из "общей кучи" нужно учитывать 2 "кучки" по СС и любое количество кучек по АС:
				//		а. то, что было на утро
				//		б. то, что поступило в течение дня
				//      в - ... партии по АС, которых может быть много
				// 2. каждая кучка списывается отдельно
				// 3. какие возможны ситуации при списании(продаже):
				//		а. на утро было достаточное количество, чтобы списать (напр.: на утро было 100, потом купили 3, потом продаем 50)
				//			значит, кучка 1.а уходит по-среднему, кучка 1.б не трогается
				//		б. на утро было недостаточное количество, чтобы списать (напр.: на утро было 100, потом купили 3, потом продаем 101)
				//			значит, кучка 1.а уходит вся, как есть, а кучка 1.б списывается по-среднему
				//		в. на утро ничего не было, продаем то, что пришло за день
				//			значит, кучка 1.б списывается по-среднему
				//		г. только после исчерпания кучек 1.а и 1.б мы приступаем к кучкам по АС (кучка в и т.д.)
				//
				//	Решаться эта задача будет тем, что если раньше при методе расчета по-среднему была всегда одна строка (общая кучка),
				// 	то теперь их будет 2: 
				//		а. строке 0 будет кучка 1.а
				//		б. строке 1 будет кучка 1.б (+ будет заполнено поле период, чтобы понимать в каком дне мы ее, пардон, отложили)
				//		в. в строках 2 и больше будту партии по АС
				//	перед каждой операцией (не важно приход или расход) мы будем проверять можно ли кучку 1.б переложить в кучку 1.а и перекладывать если можно
				//	приход будет идти следующим образом:
				//		а. если бумага по СС то в кучку 1.б
				//		б. если бумага по АС, то просто добавляем партии
				//  расход будет идти по алгоритму из п.3
				Если НастройкиПоВидуУчета.МетодОценкиСтоимости = Перечисления.МетодыОценкиСтоимости.ПоСреднему
					И ПриходныеПартии.Количество() > 1
					И ПриходныеПартии[1].Количество > 0 Тогда
					
					ПартииНаНачалоДня = ПриходныеПартии[0];
					ПриходнаяПартия = ПриходныеПартии[1];
					
					Если ПриходнаяПартия.Период < НачалоДня(ВыборкаДетальныеЗаписи.Период) Тогда // наступил новый день - нужна переброска
						Для каждого РеквизитПартий Из Метаданные.РегистрыНакопления.БухПартииЦенныхБумаг.Ресурсы Цикл
							Если РесурсыПартий.Найти(РеквизитПартий.Имя) <> Неопределено Тогда 
								ПартииНаНачалоДня[РеквизитПартий.Имя] = ПартииНаНачалоДня[РеквизитПартий.Имя] + ПриходнаяПартия[РеквизитПартий.Имя];
								ПриходнаяПартия[РеквизитПартий.Имя] = 0;
							КонецЕсли;
						КонецЦикла;
						ПриходныеПартии.Удалить(ПриходнаяПартия);
					КонецЕсли;
				КонецЕсли;
				
				// Проверим на отмены
				Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.Сделка")
					ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
				
					ОтменыСделки = ОтменыСделок.НайтиСтроки(Новый Структура("Основание", ВыборкаДетальныеЗаписи.Регистратор));
					Если ОтменыСделки.Количество() > 0 Тогда
						// предполагаем, что количество отмен не может быть больше одной
						ДатаОтмены = ОтменыСделки[0].ДатаОперации;
						
						Если НачалоДня(ДатаОтмены) <> НачалоДня(ВыборкаДетальныеЗаписи.Период) Тогда
						    // отменять сделку можно только в тот же день!
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не поддерживаются отмены сделок, совершенные не в день сделки: " + Строка(ВыборкаДетальныеЗаписи.Регистратор), ВыборкаДетальныеЗаписи.Регистратор);
							Отказ = Истина;
							Возврат;
							
						Иначе
							// седлка отменена - не считаем партии по ней
							Продолжить;
							
						КонецЕсли;
					
					КонецЕсли;
					
				КонецЕсли;
				
				Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.КонвертацияЦенныхБумаг") Тогда
					
					#Область Конвертация
					Если ВыборкаДетальныеЗаписи.Рынок <> Перечисления.РынкиЦенныхБумаг.Акции Тогда 
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчет партий по документу Конвертация ценных бумаг предусмотрен только для акций");
						Продолжить;						
					КонецЕсли;
					ЭтоВыделение = (ВыборкаДетальныеЗаписи.Регистратор.ВидКонвертации = Справочники.ВидыКонвертацииЦенныхБумаг.Выделение); // особый вид, при котором партиеобразующим документом будет конвертация
					Если ЭтоВыделение Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Вид конвертации 'Выделение' пока не реализован");
						Продолжить;						
					КонецЕсли;
					
					Коэффициент = ВыборкаДетальныеЗаписи.Регистратор.Коэффициент;
					
					Если ВыборкаДетальныеЗаписи.ВидДвижения = Перечисления.ВидыДвижений.Расход Тогда
						
						//спишем все партии
						Для каждого СтрокаПриходныхПартий Из ПриходныеПартии Цикл
							
							НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
							
							ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаПриходныхПартий);
							ЗаполнитьЗначенияСвойств(НовоеДвижение, ВыборкаДетальныеЗаписи, "Регистратор,Период,Рынок");
							
							НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Расход;
							НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
							
							//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.СписаниеПартии;
							
							// при обмене сохраняем партию (по НУ, согласно НК, по БУ до первого обратного случая), будет выделение - добавлю условие
							НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
							
							ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаПриходныхПартий);
							ЗаполнитьЗначенияСвойств(НовоеДвижение, ВыборкаДетальныеЗаписи, "Регистратор, Период");
							
							НовоеДвижение.ЦеннаяБумага = ВыборкаДетальныеЗаписи.Регистратор.ЦеннаяБумагаНовая;
							НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Приход;
							НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
							
							НовоеДвижение.Количество = СтрокаПриходныхПартий.Количество * Коэффициент; 
							
							//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.ЗачислениеПартии;
							
						КонецЦикла;
						
						//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.ЗачислениеПартии;
						
					ИначеЕсли ВыборкаДетальныеЗаписи.ВидДвижения = Перечисления.ВидыДвижений.Приход Тогда
						
						Продолжить;  // проводка сделана выше в секции расход
						
					КонецЕсли;
					#КонецОбласти
					
				ИначеЕсли ВыборкаДетальныеЗаписи.ВидДвижения = Перечисления.ВидыДвижений.Приход Тогда
					
					#Область Приход
					ЭтоОбратноеРЕПО = Ложь;
					ЭтоЗакрытиеПрямогоРЕПО = Ложь;
					
					Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
						Если РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].ЧастьСделкиРЕПО = 1 Тогда
							ЭтоОбратноеРЕПО = Истина;
					    ИначеЕсли РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].ЧастьСделкиРЕПО = 2 Тогда
							ЭтоЗакрытиеПрямогоРЕПО = Истина;
						КонецЕсли;
					ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг")
						И ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор.Основание) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
						
						Если РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].Основание.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
							ЭтоОбратноеРЕПО = Истина;
					    ИначеЕсли РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].Основание.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
							ЭтоЗакрытиеПрямогоРЕПО = Истина;
						КонецЕсли;
						
					КонецЕсли;
					
					Если ЭтоЗакрытиеПрямогоРЕПО Тогда // возвращаем на баланс партии
						
						ПартииПроданныеВРЕПОКУдалению = Новый Массив;
						
						Если ТипЗнч(ВыборкаДетальныеЗаписи.Партия) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
							ПартииПроданныеВРЕПОПоСделке = ПартииПроданныеВРЕПО.НайтиСтроки(Новый Структура("ПродажаРЕПО,СтрокаПродажиРЕПО", ВыборкаДетальныеЗаписи.Партия.ПерваяЧастьРЕПО, ВыборкаДетальныеЗаписи.СтрокаПартии));
						Иначе
							ПартииПроданныеВРЕПОПоСделке = Новый Массив;
							
							ПартииПроданныеВРЕПОПоБумаге = ПартииПроданныеВРЕПО.НайтиСтроки(Новый Структура("ЦеннаяБумага", ВыборкаДетальныеЗаписи.ЦеннаяБумага));
							Для Каждого ПартияПроданнаяВРЕПОПоБумаге ИЗ ПартииПроданныеВРЕПОПоБумаге Цикл
								//куда пихать СтрокаПродажиРЕПО?
								Если НЕ ЗначениеЗаполнено(ПартияПроданнаяВРЕПОПоБумаге.ПродажаРЕПО) Тогда
									//пока Коля не отпустит переоценку. Там не заполнены измерения
									Продолжить;
								КонецЕсли;
								// пропускаем биржевые репо
								Если ТипЗнч(ПартияПроданнаяВРЕПОПоБумаге.ПродажаРЕПО) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
									Продолжить;
								КонецЕсли;
								Если ПартияПроданнаяВРЕПОПоБумаге.ПродажаРЕПО.Основание = ВыборкаДетальныеЗаписи.Партия.Основание Тогда
									
									ПартииПроданныеВРЕПОПоСделке.Добавить(ПартияПроданнаяВРЕПОПоБумаге);
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;
						
						Для каждого СтрокаПартииПроданныеВРЕПОПоСделке Из ПартииПроданныеВРЕПОПоСделке Цикл
							
							// запомним, что удалить надо из репошных 
							ПартииПроданныеВРЕПОКУдалению.Добавить(СтрокаПартииПроданныеВРЕПОПоСделке);
							
							Если ТипЗнч(СтрокаПартииПроданныеВРЕПОПоСделке.Партия) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
								
								// пришла партия
								ПриходнаяПартияРЕПО = ПартииКупленныеПоРЕПО.Добавить();
								ЗаполнитьЗначенияСвойств(ПриходнаяПартияРЕПО, СтрокаПартииПроданныеВРЕПОПоСделке);
								//ПриходнаяПартияРЕПО.НомерСтроки = ПартииКупленныеПоРЕПО.Количество();
								
								// движение по партиям приход сделать
								НовоеДвижениеРЕПО = ЭтотОбъект.РассчитанныеПартииОбратноеРЕПО.Добавить();
								ЗаполнитьЗначенияСвойств(НовоеДвижениеРЕПО, ПриходнаяПартияРЕПО);
								
								НовоеДвижениеРЕПО.Период = ВыборкаДетальныеЗаписи.Период;
								НовоеДвижениеРЕПО.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
								НовоеДвижениеРЕПО.ВидДвижения = Перечисления.ВидыДвижений.Приход;
								НовоеДвижениеРЕПО.СтрокаКорзиныЦенныхБумаг = СтрокаПартииПроданныеВРЕПОПоСделке.СтрокаПартии;
								
							Иначе
								
								НовоеДвижение = Перекурсовка(ВыборкаДетальныеЗаписи.Регистратор, ЭтотОбъект.РассчитанныеПартииПрямоеРЕПО, ВыборкаДетальныеЗаписи.Период, СтрокаПартииПроданныеВРЕПОПоСделке, СтрокаПартииПроданныеВРЕПОПоСделке.Количество, СтрокаПартииПроданныеВРЕПОПоСделке.СтрокаПартии,,,, Отказ);
								НовоеДвижение.СтрокаКорзиныЦенныхБумаг = СтрокаПартииПроданныеВРЕПОПоСделке.СтрокаПартии;
								
								Если Отказ Тогда
									Возврат;
								КонецЕсли;
								
								// пришла партия
								ДанныеПартии = Новый Структура();
								ДанныеПартии.Вставить("ЦеннаяБумага", СтрокаПартииПроданныеВРЕПОПоСделке.ЦеннаяБумага);
								ДанныеПартии.Вставить("Партия", СтрокаПартииПроданныеВРЕПОПоСделке.Партия);
								ДанныеПартии.Вставить("СтрокаПартии", СтрокаПартииПроданныеВРЕПОПоСделке.СтрокаПартии);
								
								НайденныеСтроки = ПриходныеПартии.НайтиСтроки(ДанныеПартии);
								Если НайденныеСтроки.Количество() = 0 Тогда 
									
									ПриходнаяПартия = ПриходныеПартии.Добавить();
									ЗаполнитьЗначенияСвойств(ПриходнаяПартия, СтрокаПартииПроданныеВРЕПОПоСделке);
									ПриходнаяПартия.НомерСтроки = ПриходныеПартии.Количество();
									ПриходнаяПартия.Период = ПриходнаяПартия.Партия.Дата;
									
									НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
									ЗаполнитьЗначенияСвойств(НовоеДвижение, ПриходнаяПартия);
									
									НовоеДвижение.Период = ВыборкаДетальныеЗаписи.Период;
									НовоеДвижение.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
									НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Приход;
									НовоеДвижение.СтрокаКорзиныЦенныхБумаг = СтрокаПартииПроданныеВРЕПОПоСделке.СтрокаПартии;
									
									//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.ЗачислениеПартии;
									
								Иначе
									
									ПриходнаяПартия = НайденныеСтроки[0];
									
									Для Каждого Ресурс из РесурсыПартий Цикл
										ПриходнаяПартия[Ресурс] = ПриходнаяПартия[Ресурс] + СтрокаПартииПроданныеВРЕПОПоСделке[Ресурс];	
									КонецЦикла;	
																		
									НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
									ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаПартииПроданныеВРЕПОПоСделке);
									
									НовоеДвижение.Период = ВыборкаДетальныеЗаписи.Период;
									НовоеДвижение.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
									НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Приход;
									НовоеДвижение.СтрокаКорзиныЦенныхБумаг = СтрокаПартииПроданныеВРЕПОПоСделке.СтрокаПартии;
																	
									//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.ЗачислениеПартии;
									
								КонецЕсли;
								
								// добавим дооценку вернувшихся из РЕПО бумаг, но это только для обычных партий партии, обратного РЕПО не дооцениваем
								Если НастройкиПоВидуУчета.ПереоцениватьПриобретенныеАктивы  Тогда
								
									ЭтоЗакрытиеКороткойПозиции = Ложь;
									Если ТипЗнч(ПриходнаяПартия.Партия) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
										ЭтоЗакрытиеКороткойПозиции = Истина;
									ИначеЕсли ТипЗнч(ПриходнаяПартия.Партия) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке")
										ИЛИ ТипЗнч(ПриходнаяПартия.Партия) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг") Тогда
										Если ТипЗнч(ПриходнаяПартия.Партия.Основание) = Тип("ДокументСсылка.СделкаРЕПО") Тогда 
											ЭтоЗакрытиеКороткойПозиции = Истина;
										КонецЕсли;
									КонецЕсли;
									
									Если НЕ ЭтоЗакрытиеКороткойПозиции Тогда // дооценим
									
										ПереоценкаДляПокупки = ПереоценкиДляОпераций.НайтиСтроки(Новый Структура("Ссылка,ЦеннаяБумага,ВидДвижения", 
																	ВыборкаДетальныеЗаписи.Регистратор, 
																	ЦеннаяБумага, 
																	Перечисления.ВидыДвижений.Приход));
										
										Если ПереоценкаДляПокупки.Количество() <> 1 Тогда
											ТекстСообщения = СтрШаблон("Не удалось определить цену бумаги %1 для покупки %2", ЦеннаяБумага, ВыборкаДетальныеЗаписи.Регистратор); 
											ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
											Возврат;
										КонецЕсли;
										
										Если СтрокаПартииПроданныеВРЕПОПоСделке.Количество = ПереоценкаДляПокупки[0].Количество Тогда
											СуммаРынок = ПереоценкаДляПокупки[0].СуммаРынок;
											СуммаРынокВВалютеУчета = ПереоценкаДляПокупки[0].СуммаРынокВВалютеУчета;
										Иначе
											СуммаРынок = ПереоценкаДляПокупки[0].СуммаРынок / ПереоценкаДляПокупки[0].Количество * СтрокаПартииПроданныеВРЕПОПоСделке.Количество;
											СуммаРынокВВалютеУчета = ПереоценкаДляПокупки[0].СуммаРынокВВалютеУчета / ПереоценкаДляПокупки[0].Количество * СтрокаПартииПроданныеВРЕПОПоСделке.Количество;
											
											ПереоценкаДляПокупки[0].СуммаРынок = ПереоценкаДляПокупки[0].СуммаРынок - СуммаРынок;
											ПереоценкаДляПокупки[0].СуммаРынокВВалютеУчета = ПереоценкаДляПокупки[0].СуммаРынокВВалютеУчета - СуммаРынокВВалютеУчета;
											ПереоценкаДляПокупки[0].Количество = ПереоценкаДляПокупки[0].Количество - СтрокаПартииПроданныеВРЕПОПоСделке.Количество;
										КонецЕсли;
										
										НовоеДвижениеПереоценки = ЭтотОбъект.РассчитанныеПартии.Добавить();
										
										ЗаполнитьЗначенияСвойств(НовоеДвижениеПереоценки, НовоеДвижение, "Регистратор,Период,Рынок,ЦеннаяБумага,Партия,СтрокаПартии");
										НовоеДвижениеПереоценки.ВидДвижения = Перечисления.ВидыДвижений.Приход;
										НовоеДвижениеПереоценки.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
										
										//НовоеДвижениеПереоценки.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.ПереоценкаИНачислениеПроцентов;
										
										Если УчитыватьПереоценкуОтдельно Тогда
											
											НовоеДвижениеПереоценки.Переоценка				= СуммаРынок - (НовоеДвижение.Стоимость + НовоеДвижение.Переоценка); 
											НовоеДвижениеПереоценки.ПереоценкаВВалютеУчета	= СуммаРынокВВалютеУчета - (НовоеДвижение.СтоимостьВВалютеУчета + НовоеДвижение.ПереоценкаВВалютеУчета); 
											
											ПриходнаяПартия.Переоценка						= ПриходнаяПартия.Переоценка + НовоеДвижениеПереоценки.Переоценка;
											ПриходнаяПартия.ПереоценкаВВалютеУчета			= ПриходнаяПартия.ПереоценкаВВалютеУчета + НовоеДвижениеПереоценки.ПереоценкаВВалютеУчета;
											
										Иначе
											
											НовоеДвижениеПереоценки.Стоимость				= СуммаРынок - НовоеДвижение.Стоимость; 
											НовоеДвижениеПереоценки.СтоимостьВВалютеУчета	= СуммаРынокВВалютеУчета - НовоеДвижение.СтоимостьВВалютеУчета; 
											НовоеДвижениеПереоценки.ПереоценкаВСтоимости	= НовоеДвижениеПереоценки.Стоимость;
											
											ПриходнаяПартия.Стоимость						= ПриходнаяПартия.Стоимость + НовоеДвижениеПереоценки.Стоимость;
											ПриходнаяПартия.СтоимостьВВалютеУчета			= ПриходнаяПартия.СтоимостьВВалютеУчета + НовоеДвижениеПереоценки.СтоимостьВВалютеУчета;
											ПриходнаяПартия.ПереоценкаВСтоимости			= ПриходнаяПартия.ПереоценкаВСтоимости + НовоеДвижениеПереоценки.ПереоценкаВСтоимости;
											
										КонецЕсли;
										
									
									КонецЕсли;
								
								КонецЕсли;
								
							КонецЕсли;						
							
							// движение по партиям РЕПО расход сделать
							НовоеДвижениеРЕПО = РассчитанныеПартииПрямоеРЕПО.Добавить();
							ЗаполнитьЗначенияСвойств(НовоеДвижениеРЕПО, СтрокаПартииПроданныеВРЕПОПоСделке);
							
							НовоеДвижениеРЕПО.Период = ВыборкаДетальныеЗаписи.Период;
							НовоеДвижениеРЕПО.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
							НовоеДвижениеРЕПО.ВидДвижения = Перечисления.ВидыДвижений.Расход;
							НовоеДвижениеРЕПО.СтрокаКорзиныЦенныхБумаг = СтрокаПартииПроданныеВРЕПОПоСделке.СтрокаПартии;
							
						КонецЦикла;
						
						//ПриходныеПартии.Сортировать("Период,НомерСделки,МоментВремени"); // отсортировать обязательно
						ПриходныеПартии.Сортировать("Период"); // отсортировать обязательно
						
						// удалим партии РЕПО
						Для каждого СтрокаПартииПроданныеВРЕПОКУдалению Из ПартииПроданныеВРЕПОКУдалению Цикл
							ПартииПроданныеВРЕПО.Удалить(СтрокаПартииПроданныеВРЕПОКУдалению);
						КонецЦикла;
						
					ИначеЕсли ЭтоОбратноеРЕПО И НастройкиПоВидуУчета.УчитыватьПартииРЕПООтдельно Тогда // приходуем в РЕПОшные партии
						
						ПриходнаяПартияРЕПО = ПартииКупленныеПоРЕПО.Добавить();
						
						ЗаполнитьЗначенияСвойств(ПриходнаяПартияРЕПО, ВыборкаДетальныеЗаписи);
						
						ВалютаСделки = РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].ВалютаСделки;
						ПриходнаяПартияРЕПО.Стоимость = РаботаСВалютами.ПересчетСуммыВВалюте(ВыборкаДетальныеЗаписи.СтоимостьПокупки, ВалютаСделки, ВыборкаДетальныеЗаписи.Период, ВалютаНоминала, ВыборкаДетальныеЗаписи.Период, Отказ);
						ПриходнаяПартияРЕПО.СтоимостьВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ВыборкаДетальныеЗаписи.СтоимостьПокупки, ВалютаСделки, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период, Отказ);
						ПриходнаяПартияРЕПО.СтоимостьКупона = РаботаСВалютами.ПересчетСуммыВВалюте(ВыборкаДетальныеЗаписи.СтоимостьПокупкиКупона, ВалютаСделки, ВыборкаДетальныеЗаписи.Период, ВалютаНоминала, ВыборкаДетальныеЗаписи.Период, Отказ);
						ПриходнаяПартияРЕПО.СтоимостьКупонаВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ВыборкаДетальныеЗаписи.СтоимостьПокупкиКупона, ВалютаСделки, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период, Отказ);
						
						//Если был аванс, то по курсу оплаты
						Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг") Тогда
							
							СделкаРЕПО = РеквизитыРегистраторов[ВыборкаДетальныеЗаписи.Регистратор].Основание;
							
							//допустим, условия оплаты первой части соблюдены
							Если СделкаРЕПО.ДатаОплаты < СделкаРЕПО.ДатаПоставки Тогда
								ЗапросРЕПО = Новый Запрос;
								ЗапросРЕПО.Текст = 
									"ВЫБРАТЬ РАЗРЕШЕННЫЕ
									|	НАЧАЛОПЕРИОДА(ОплатаОснования.Ссылка.Дата, ДЕНЬ) КАК Дата,
									|	ОплатаОснования.Ссылка.ВалютаОплаты КАК ВалютаОплаты,
									|	СУММА(ОплатаОснования.СуммаОплаты) КАК СуммаОплаты,
									|	СУММА(ОплатаОснования.СуммаОплатыКупона) КАК СуммаОплатыКупона
									|ИЗ
									|	Документ.Оплата.Основания КАК ОплатаОснования
									|ГДЕ
									|	ОплатаОснования.Основание = &СделкаРЕПО
									|	И ОплатаОснования.Ссылка.ВидЗадолженности = &ВидЗадолженности
									|
									|СГРУППИРОВАТЬ ПО
									|	ОплатаОснования.Ссылка.ВалютаОплаты,
									|	НАЧАЛОПЕРИОДА(ОплатаОснования.Ссылка.Дата, ДЕНЬ)";
								
								ЗапросРЕПО.УстановитьПараметр("ВидЗадолженности", Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО);
								ЗапросРЕПО.УстановитьПараметр("СделкаРЕПО", СделкаРЕПО);
								
								РезультатЗапросаРЕПО = ЗапросРЕПО.Выполнить();
								
								ВыборкаДетальныеЗаписиРЕПО = РезультатЗапросаРЕПО.Выбрать();
								
								//Считаем, что частичных оплат по 1-й части РЕПО НЕТ!
								//Если появятся - надо дорабатывать
								Если ВыборкаДетальныеЗаписиРЕПО.Следующий() Тогда
									Если ВыборкаДетальныеЗаписиРЕПО.Дата < ВыборкаДетальныеЗаписи.Период Тогда
										ПриходнаяПартияРЕПО.СтоимостьВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ВыборкаДетальныеЗаписиРЕПО.СуммаОплаты, ВыборкаДетальныеЗаписиРЕПО.ВалютаОплаты, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписиРЕПО.Дата, Отказ);
										ПриходнаяПартияРЕПО.СтоимостьКупонаВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ВыборкаДетальныеЗаписиРЕПО.СуммаОплатыКупона, ВыборкаДетальныеЗаписиРЕПО.ВалютаОплаты, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписиРЕПО.Дата, Отказ);
									КонецЕсли;
								КонецЕсли;
								
							КонецЕсли;
						КонецЕсли;
						
						
						НовоеДвижение = ЭтотОбъект.РассчитанныеПартииОбратноеРЕПО.Добавить();
						
						ЗаполнитьЗначенияСвойств(НовоеДвижение, ВыборкаДетальныеЗаписи);
						
						НовоеДвижение.Стоимость = ПриходнаяПартияРЕПО.Стоимость;
						НовоеДвижение.СтоимостьВВалютеУчета = ПриходнаяПартияРЕПО.СтоимостьВВалютеУчета;
						НовоеДвижение.СтоимостьКупона = ПриходнаяПартияРЕПО.СтоимостьКупона;
						НовоеДвижение.СтоимостьКупонаВВалютеУчета = ПриходнаяПартияРЕПО.СтоимостьКупонаВВалютеУчета;
						
						НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Приход;
						НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
					ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ИсполнениеРешенияОбИзмененииУставногоКапиталаООО") Тогда	
						
						КоличествоДолиОбщее = ПриходныеПартии.Итог("Количество");
						
						СтоимостьКРаспределению = ВыборкаДетальныеЗаписи.Стоимость;
						СтоимостьВВалютеУчетаКРаспределению = ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета;
						КоличествоКРаспределению = ВыборкаДетальныеЗаписи.Количество;
						//распределяем по приходным партиям
						Для Каждого ПриходнаяПартия из ПриходныеПартии Цикл
							
							НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
							
							//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.ПереоценкаИНачислениеПроцентов;
							
							ЗаполнитьЗначенияСвойств(НовоеДвижение, ВыборкаДетальныеЗаписи);
							ЗаполнитьЗначенияСвойств(НовоеДвижение, ПриходнаяПартия, "Партия,СтрокаПартии");
							
							НовоеДвижение.Стоимость	 			= СтоимостьКРаспределению * ПриходнаяПартия.Количество / КоличествоДолиОбщее;
							НовоеДвижение.СтоимостьВВалютеУчета = СтоимостьВВалютеУчетаКРаспределению * ПриходнаяПартия.Количество / КоличествоДолиОбщее;
							НовоеДвижение.Количество 			= КоличествоКРаспределению * ПриходнаяПартия.Количество / КоличествоДолиОбщее;
							
							Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаДетальныеЗаписи.Регистратор, "Основание.ВзносВУставныйКапитал") Тогда
								НовоеДвижение.СтоимостьПокупки  =  НовоеДвижение.Стоимость;
							КонецЕсли;
							
							КоличествоДолиОбщее = КоличествоДолиОбщее - ПриходнаяПартия.Количество;
							
							ПриходнаяПартия.Количество 				= ПриходнаяПартия.Количество + НовоеДвижение.Количество;
							ПриходнаяПартия.Стоимость 				= ПриходнаяПартия.Стоимость + НовоеДвижение.Стоимость;
							ПриходнаяПартия.СтоимостьВВалютеУчета 	= ПриходнаяПартия.СтоимостьВВалютеУчета + НовоеДвижение.СтоимостьВВалютеУчета;
							
							Если НовоеДвижение.Стоимость < 0 Тогда
								НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Расход;
								НовоеДвижение.Стоимость	 			= - НовоеДвижение.Стоимость;
								НовоеДвижение.СтоимостьВВалютеУчета = - НовоеДвижение.СтоимостьВВалютеУчета;
								НовоеДвижение.Количество 			= - НовоеДвижение.Количество;
							ИначеЕсли НовоеДвижение.Стоимость = 0 И НовоеДвижение.Количество < 0 Тогда
								НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Расход;
								НовоеДвижение.Количество 			= - НовоеДвижение.Количество;
							КонецЕсли;
							
						КонецЦикла;
						
					Иначе
						
						// определим учетный актив если у клиента предусмотрена возможность учета бумаг по АС при виде учета БУ
						// я заложился на невозможность частичного распределения партии (купили 100 бумаг и 50 распределили на АС и 50 на СС) т.к. за время ведения ЕПС такого не было никогда
						// также добавлю (или уже добавил в Документ.РаспределениеАктивовЕПС) контроль этого 
						// и да! я добавляю заполнение реквизита УчетныйАктивЕПС для партий по БУ т.к. "Так решила стая!"
						Если НастройкиУчета.ЕстьВозможностьУчитыватьЦенныеБумагиПоАмортизированнойСтоимости
							И (ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.Сделка")
								ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке")
							 	ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг")) Тогда
							
							ТекСделка = ВыборкаДетальныеЗаписи.Регистратор; 
							Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке")
							 ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг") Тогда
								ТекСделка = ВыборкаДетальныеЗаписи.Регистратор.Основание;
							КонецЕсли;
							
							РаспределениеПоТекущейСделкеИБумаге = РаспределенияПоСделкам.НайтиСтроки(Новый Структура("Сделка, ЦеннаяБумага", ТекСделка, ВыборкаДетальныеЗаписи.ЦеннаяБумага));
							Если РаспределениеПоТекущейСделкеИБумаге.Количество() = 0 Тогда
								УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПустаяСсылка();
							Иначе								
								УчетныйАктивЕПС = РаспределениеПоТекущейСделкеИБумаге[0].УчетныйАктивЕПС;
								
								// нас не интересуют неАС активы - не заполняем УчетныйАктивЕПС по ним
								Если УчетныйАктивЕПС.Родитель <> Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСД
									И УчетныйАктивЕПС.Родитель <> Справочники.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения Тогда
								
									УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПустаяСсылка(); 	
								
								КонецЕсли;
							КонецЕсли;
							
						Иначе
							УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПустаяСсылка();
						КонецЕсли;
						
						Если НастройкиПоВидуУчета.МетодОценкиСтоимости = Перечисления.МетодыОценкиСтоимости.ПоСреднему
							И ПриходныеПартии.Количество() > 1
							И НЕ ЗначениеЗаполнено(УчетныйАктивЕПС) Тогда // не АС партия
							
							ПриходнаяПартия = ПриходныеПартии[1];
							
							Для каждого РеквизитПартий Из Метаданные.РегистрыНакопления.БухПартииЦенныхБумаг.Ресурсы Цикл
								Если РесурсыПартий.Найти(РеквизитПартий.Имя) <> Неопределено Тогда 
									Если РеквизитПартий.Имя = "СуммаРезервовПодОбесценение"
										ИЛИ РеквизитПартий.Имя = "СуммаРезервовПоСомнительнымДолгам"
										ИЛИ РеквизитПартий.Имя = "СтоимостьВВалютеУчета"
										ИЛИ РеквизитПартий.Имя = "СтоимостьКупонаВВалютеУчета" Тогда
										Продолжить;
									КонецЕсли;
									
									Если РеквизитПартий.Имя = "Стоимость" Тогда
										Если ВыборкаДетальныеЗаписи.Регистратор <> Неопределено Тогда
											ПриходнаяПартия.Стоимость = ПриходнаяПартия.Стоимость + ВыборкаДетальныеЗаписи.СтоимостьПокупки;
										Иначе
											ПриходнаяПартия.Стоимость = ПриходнаяПартия.Стоимость + ВыборкаДетальныеЗаписи.Стоимость;
										КонецЕсли;
										ПриходнаяПартия.СтоимостьВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ПриходнаяПартия.Стоимость,ВалютаНоминала, Организация, ВыборкаДетальныеЗаписи.Период, Отказ);
										Если НастройкиПоВидуУчета.ВключатьРасходыПоПокупкеВСтоимость Тогда
											
											РасходыПриПокупкеВСтоимости = РассчитатьРасходыПриПокупкеВСтоимости_БУНУ(ЦеннаяБумага, ВалютаНоминала, ВыборкаДетальныеЗаписи, КомиссииПоПокупкам, ПоставкиПоПокупкам);
											
											ПриходнаяПартия.РасходыПриПокупкеВСтоимости = РасходыПриПокупкеВСтоимости.РасходыПриПокупкеВСтоимости;
											ПриходнаяПартия.РасходыПриПокупкеВСтоимостиВВалютеУчета = РасходыПриПокупкеВСтоимости.РасходыПриПокупкеВСтоимостиВВалютеУчета;
											
											ПриходнаяПартия.Стоимость = ПриходнаяПартия.Стоимость + ПриходнаяПартия.РасходыПриПокупкеВСтоимости;
