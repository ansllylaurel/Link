		|	Партии.КорректировкаЭСПСНачалаГода КАК КорректировкаЭСПСНачалаГода,
		|	Партии.ДисконтПремияНачисленныйСНачалаГода КАК ДисконтПремияНачисленныйСНачалаГода,
		|	Партии.ПереоценкаСНачалаГода КАК ПереоценкаСНачалаГода,
		|	Партии.РазницаПервоначальногоПризнанияСНачалаГода КАК РазницаПервоначальногоПризнанияСНачалаГода,
		|	Партии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	Партии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная,
		|	Партии.СтоимостьКупонаВВалютеУчета КАК СтоимостьКупонаВВалютеУчета,
		|	Партии.СтоимостьВВалютеУчета КАК СтоимостьВВалютеУчета,
		|	Партии.ПереоценкаВВалютеУчета КАК ПереоценкаВВалютеУчета,
		|	Партии.ПереоценкаКупонаВВалютеУчета КАК ПереоценкаКупонаВВалютеУчета,
		|	Партии.ДисконтПремияНачисленныйВВалютеУчета КАК ДисконтПремияНачисленныйВВалютеУчета,
		|	Партии.КорректировкаЭСПВВалютеУчета КАК КорректировкаЭСПВВалютеУчета,
		|	Партии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		|	Партии.КурсовыеРазницыСНачалаГода КАК КурсовыеРазницыСНачалаГода,
		|	Партии.СуммаРезервовПодОбесценение КАК СуммаРезервовПодОбесценение,
		|	Партии.СуммаРезервовПодОбесценениеКупона КАК СуммаРезервовПодОбесценениеКупона,
		|	Партии.СуммаРезервовПоСомнительнымДолгам КАК СуммаРезервовПоСомнительнымДолгам,
		|	Партии.ИндексацияНоминала КАК ИндексацияНоминала,
		|	Партии.ИндексацияНоминалаСНачалаГода КАК ИндексацияНоминалаСНачалаГода,
		|	Партии.ИндексацияНоминалаЗаВремяВладения КАК ИндексацияНоминалаЗаВремяВладения,
		|	Партии.ДатаПокупки КАК ДатаПокупки,
		|	Партии.ПереоценкаСНачалаГодаПоложительная КАК ПереоценкаСНачалаГодаПоложительная,
		|	Партии.ПогашениеКупонаНеИсполненноеВСрок КАК ПогашениеКупонаНеИсполненноеВСрок,
		|	Партии.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета КАК ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета,
		|	Партии.ПерваяЧастьРЕПО КАК ПерваяЧастьРЕПО,
		|	Партии.ЗадолженностьПоПогашениюКупона КАК ЗадолженностьПоПогашениюКупона,
		|	Партии.ЗадолженностьПоПогашениюКупонаВВалютеУчета КАК ЗадолженностьПоПогашениюКупонаВВалютеУчета,
		|	Партии.ДатаПокупкиНачальная КАК ДатаПокупкиНачальная,
		|	Партии.КорректировкаЭСПНачальная КАК КорректировкаЭСПНачальная,
		|	Партии.СтоимостьПокупкиНачальная КАК СтоимостьПокупкиНачальная,
		|	Партии.ПлановыеДанные КАК ПлановыеДанные,
		|	Партии.ЗадолженностьПоПогашениюТела КАК ЗадолженностьПоПогашениюТела,
		|	Партии.ЗадолженностьПоПогашениюТелаВВалютеУчета КАК ЗадолженностьПоПогашениюТелаВВалютеУчета,
		|	Партии.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
		|	Партии.СуммаНаОднуОблигацию КАК СуммаНаОднуОблигацию,
		|	Партии.ДатаФиксации КАК ДатаФиксации,
		|	Партии.ВидПогашения КАК ВидПогашения,
		|	Партии.Сумма КАК Сумма,
		|	Партии.СуммаКупона КАК СуммаКупона,
		|	Партии.ВидЗадолженности КАК ВидЗадолженности,
		|	Партии.ВалютаОплаты КАК ВалютаОплаты
		|ИЗ
		|	_Партии КАК Партии
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Номиналы КАК _Номиналы
		|		ПО Партии.ЦеннаяБумага = _Номиналы.ЦеннаяБумага
		|			И Партии.Период = _Номиналы.Период
		|ГДЕ
		|	Партии.Рынок <> ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период"+Порядок+",
		|	ДатаПокупки"+Порядок+",
		|	НомерСделки"+Порядок+",
		|	МоментВремени"+Порядок+",
		|	СтрокаПартии"+Порядок+"
		|ИТОГИ ПО
		|	ЦеннаяБумага";

	#КонецОбласти
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.КонецПериода));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВидУчета", ЭтотОбъект.ВидУчета);
	Запрос.УстановитьПараметр("ПлановыеДанные", ТаблицаПлановыхОпераций);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
	Запрос.УстановитьПараметр("СписокСтратегий", СписокСтратегий);
	Запрос.УстановитьПараметр("ВключатьВводыВыводы", ВключатьВводыВыводы);
	Запрос.УстановитьПараметр("ДатаЕПС", МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ);
	Запрос.УстановитьПараметр("УчитыватьРезервы", НЕ РассчитыватьСтоимости); // резервы считаем только для динамического расчета, ЕПС работает по другому
	Запрос.УстановитьПараметр("РассчитыватьСтоимости", РассчитыватьСтоимости);
	Запрос.УстановитьПараметр("ВалютаУчета", ВалютаУчета);
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	
	РезультатЗапроса = Запрос.Выполнить();

	//--------------------------
	ЭтотОбъект.РассчитанныеПартии.Очистить();
	ЭтотОбъект.РассчитанныеПартииПрямоеРЕПО.Очистить();
	ЭтотОбъект.РассчитанныеПартииОбратноеРЕПО.Очистить();
	ЭтотОбъект.КонечныеОстаткиПартий.Очистить();
	
	Если НЕ РассчитыватьСтоимости Тогда
		ЭтотОбъект.КонечныеОстаткиПартий.Загрузить(Запрос.МенеджерВременныхТаблиц.Таблицы["_ОстаткиБезДвижений"].ПолучитьДанные().Выгрузить());
	КонецЕсли;
	
	ПустаяТаблица = ЭтотОбъект.РассчитанныеПартии.ВыгрузитьКолонки();
	
	//--------------------------
	ТаблицаЦенныеБумаги = Запрос.МенеджерВременныхТаблиц.Таблицы["_ЦенныеБумаги"].ПолучитьДанные().Выгрузить();
	ТаблицаРасходыПоСделкеСЗамещающимиОблигациями = Запрос.МенеджерВременныхТаблиц.Таблицы["_РасходыПоСделкеСЗамещающимиОблигациями"].ПолучитьДанные().Выгрузить();
	
	//--------------------------
	// #416666 - для настройки УчитыватьУчетныйАктивПриСписанииПартий
	// учетный актив ЕПС выше ФИФО(или ЛИФО) - сначала спишем по ФИФО(или ЛИФО) бумаги по СС и только после перейдем к АС
	ПорядокЕПС = Новый Соответствие;
	
	ПорядокЕПС.Вставить(Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой, 1);
	ПорядокЕПС.Вставить(Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажи, 2);
	ПорядокЕПС.Вставить(Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток, 3);
	ПорядокЕПС.Вставить(Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи, 4);
	ПорядокЕПС.Вставить(Справочники.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения, 5);
	ПорядокЕПС.Вставить(Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСД, 6);
	
	//--------------------------
	//получим распределения активов
	РаспределенияПоСделкам = БухгалтерскийУчетЕПС.ПолучитьРаспределениеПоВидуАктива(Запрос.МенеджерВременныхТаблиц.Таблицы["_ТаблицаСделок"].ПолучитьДанные().Выгрузить());
	РаспределенияПоСделкам.Индексы.Добавить("Сделка, ЦеннаяБумага"); 

	//--------------------------
	РассчитанныеПартииКПоступлениюДляСписания = РассчитанныеПартииКПоступлению.Выгрузить();

	//--------------------------
	// #387189
	// 0. Расчет партий при расчете для целей ИД всегда считает только количество (ЭтотОбъект.ВариантРасчета = Перечисления.ВариантыРасчетаПартий.РасчетТолькоКоличества)
	// 1. Расчет партий при расчете для целей СЧА для бумаг по АС должен рассчитывать суммы, для бумаг по СС продолжаем считать только количество (ЭтотОбъект.ВариантРасчета = Перечисления.ВариантыРасчетаПартий.РасчетКоличестваДляБумагПоАССуммы)
	// 2. Расчет партий при расчете для целей ЕПС всегда считает всё (ЭтотОбъект.ВариантРасчета = Перечисления.ВариантыРасчетаПартий.ПолныйРасчет)
	// добавляем переменную для сохранения параметра РассчитыватьСтоимости - _Сохранение_РассчитыватьСтоимости:
	// 		внутри цикла по ценным бумагам перед начала цикла по операциям будем устанавливать РассчитыватьСтоимости = _Сохранение_РассчитыватьСтоимости
	//			внутри цикла по операциям если ВариантРасчета=РасчетКоличестваДляБумагПоАССуммы, то как только в таблицу приходных партий добавится строка у которой ВключатьРасходыПоПокупкеВСтоимость то мы сразу сделаем: РассчитыватьСтоимости = Истина
	_Сохранение_РассчитыватьСтоимости = РассчитыватьСтоимости;
	
	//--------------------------
	ПереоценкиПередВыводами = Неопределено;
	ПереоценкиДляОпераций = Неопределено;
	
	Если РассчитыватьСтоимости И НЕ НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316 Тогда 	// для динамического расчета нет смысла рассчитывать т.к. преоценка его не интересует, 
																							// для клиентов с послаблением тоже т.к. послабление приводит к тому, что цена актива не меняется (либо всегда по цене на 18.02.22, либо всегда по цене покупки)
																							// а раз цена не меняется, то сумма переоценки определяется легко: это сумма начисления дисконта/приемии и корректировки ЭСП, взятые с обратным знаком
																							// т.е. сколько процентных доходов начислим столько переоценки и спишем (и наоборот) чтобы общая цена актива не менялась
	
		Если НастройкиПоВидуУчета.ПереоцениватьАктивыПередВыводом ИЛИ НастройкиПоВидуУчета.НачислятьПроцентныеДоходыПоВыводимымАктивам Тогда
			ПереоценкиПередВыводами = ПолучитьПереоценкиПередВыводами(Справочники.ЦелиРасчета.ЕдиныйПланСчетов); 
		КонецЕсли;
		
		Если НастройкиПоВидуУчета.ПереоцениватьПриобретенныеАктивы ИЛИ НастройкиПоВидуУчета.ПереоцениватьАктивыПередПродажей Тогда
			ПереоценкиДляОпераций = ПолучитьПереоценкиДляОпераций(НастройкиПоВидуУчета.ПереоцениватьПриобретенныеАктивы, НастройкиПоВидуУчета.ПереоцениватьАктивыПередПродажей, НастройкиПоВидуУчета.УчитыватьПогрешностьОкругленияПриПродаже); 
		КонецЕсли;
		
	КонецЕсли;
	
	//--------------------------
	ДанныеРеклассификаций = Документы.РеклассификацияАктивовЕПС.ПолучитьДанныеРеклассификаций(НачалоДня(ЭтотОбъект.НачалоПериода), КонецДня(ЭтотОбъект.КонецПериода), ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	//--------------------------
	КлиентДоверительногоУправления = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.КонецПериода);
	
	ЭтоКлиентБудущее	= (КлиентДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_БУДУЩЕЕ"));
	ЭтоКлиентТелеком	= (КлиентДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_ТелекомСоюз"));
	ЭтоКлиентСНГ		= (КлиентДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФ_СНГ"));
	ЭтоКлиентЮгория		= (КлиентДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ГСКЮгория"));
	ЭтоКлиентСАФМАР		= (КлиентДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар"));
	ЭтоКлиентЭволюция	= (КлиентДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Эволюция"));
	
	ЭтоКлиентГруппыБудущее = БухгалтерскийУчетЕПС.ЭтоКлиентГруппыБудущее(КлиентДоверительногоУправления, ЭтотОбъект.КонецПериода);
	
	//--------------------------
	КлиентыУчитывающиеВсеЧастиСтоимостиПоФиксированномуКурсу = Новый Массив;
	КлиентыУчитывающиеВсеЧастиСтоимостиПоФиксированномуКурсу.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Большой"));
	КлиентыУчитывающиеВсеЧастиСтоимостиПоФиксированномуКурсу.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар"));
	
	УчитыватьВсеЧастиСтоимостиПоФиксированномуКурсу = (КлиентыУчитывающиеВсеЧастиСтоимостиПоФиксированномуКурсу.Найти(КлиентДоверительногоУправления) <> Неопределено);
	
	//--------------------------
	НастройкиДляУчетаКорректировкиЭСП = Новый Массив;
	НастройкиДляУчетаКорректировкиЭСП.Добавить(Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке);
	НастройкиДляУчетаКорректировкиЭСП.Добавить(Перечисления.ВариантыУчетаПроцентныхДоходов.ВЗависимостиОтКритерияСущественности);
	
	//--------------------------
	// В связи с переделкой отражения партий при погашении на "как надо" обнаружилась следующая ситуация:
	// 		если у клиента стоит настройка УчитыватьПогашенныеОблигацииДоПрекращенияПризнанияПоНоминалу
	//		и бумага в этот день только погашается (оплата и списание позднее, в следующие дни)
	//		то в этот день необходимо списать всю переоценку, чтобы облигация вышла на номинал 
	//		остальные части стоимости (дисконт-премию-корректировку) погашение выводти на номинал по дефолту
	//		вообще, конечно, переоценку мог бы списать в конце дня документ переоценка
	//		но! у клиента может быть и ежемесячная переоценка (ДБ, например) и переоценки в это день просто не будет
	//		поэтому, сделал списание переоценки непосредственно в погашении
	//		а запрос позволяет вычислить эти погашения, по которым ни оплаты ни списания в этот день не прошло
	Если НастройкиУчетаОбщие.УчитыватьПогашенныеОблигацииДоПрекращенияПризнанияПоНоминалу Тогда
		#Область ПогашенияНесписанныеИНеоплаченныеВТотЖеДень
		
		ЗапросПогашения = Новый Запрос();
		ЗапросПогашения.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОстаткиЦенныхБумагЗаблокированныеОстаткиИОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ОстаткиЦенныхБумагЗаблокированныеОстаткиИОбороты.Период КАК Период,
			|	ПогашениеЦеннойБумаги.Ссылка КАК Ссылка
			|ИЗ
			|	РегистрНакопления.ОстаткиЦенныхБумагЗаблокированные.ОстаткиИОбороты(
			|			&НачалоПериода,
			|			&ОкончаниеПериода,
			|			День,
			|			,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидБлокировкиАктива = ЗНАЧЕНИЕ(Перечисление.ВидыБлокировокАктивов.Погашение)
			|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)) КАК ОстаткиЦенныхБумагЗаблокированныеОстаткиИОбороты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.ОстаткиИОбороты(
			|				&НачалоПериода,
			|				&ОкончаниеПериода,
			|				День,
			|				,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|					И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации)) КАК ЗадолженностиПоДенежнымСредствамОстаткиИОбороты
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПогашениеЦеннойБумаги КАК ПогашениеЦеннойБумаги
			|			ПО ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.Основание = ПогашениеЦеннойБумаги.Ссылка
			|		ПО (ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.Период = ОстаткиЦенныхБумагЗаблокированныеОстаткиИОбороты.Период)
			|			И (ОстаткиЦенныхБумагЗаблокированныеОстаткиИОбороты.ЦеннаяБумага = ПогашениеЦеннойБумаги.ЦеннаяБумага)
			|ГДЕ
			|	ОстаткиЦенныхБумагЗаблокированныеОстаткиИОбороты.КоличествоРасход = 0
			|	И ОстаткиЦенныхБумагЗаблокированныеОстаткиИОбороты.КоличествоКонечныйОстаток > 0
			|	И ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаРасход = 0
			|	И ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаКонечныйОстаток > 0";
		
		ЗапросПогашения.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.НачалоПериода));
		ЗапросПогашения.УстановитьПараметр("ОкончаниеПериода", КонецДня(ЭтотОбъект.КонецПериода));
		ЗапросПогашения.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		ЗапросПогашения.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
		
		#КонецОбласти
		
		ПогашенияНесписанныеИНеоплаченныеВТотЖеДень = ЗапросПогашения.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		
	Иначе
		// Если настройки не стоит, то нам не нужно списывать переоценку при погашении - просто пустой масси погашений
		ПогашенияНесписанныеИНеоплаченныеВТотЖеДень = Новый Массив();
	КонецЕсли;
	
	//--------------------------
	// хардкод для банкротов Открытие, Арчер и Финстойн
	// с 31.10.2022 не переоцениваем ничего
	БанкротствоФинстоунаИАрчераПризнано = (НачалоДня(ЭтотОбъект.КонецПериода) >= '20221031'); // все признали банкротство финстоуна и арчера с 31.10.22
	БанкротствоОткрытияПризнано = (НачалоДня(ЭтотОбъект.КонецПериода) >= '20221117' ИЛИ НачалоДня(ЭтотОбъект.КонецПериода) >= '20221031' И НЕ ЭтоКлиентСАФМАР); // все признали банкротство открытия с 31.10.22, а ДБ с 17.11.22
	
	//--------------------------
	ИзмененияКурсовВалют = ПолучитьИзмененияКурсовВалют(); // чтобы не проводить перекурсовку в те дни, когда курс валютый не менялся - дело в том, что перекурсовка может принять погрешности за перекурсовку
	//--------------------------
	ПереоцениваемыеГруппыАктивов = Новый Массив;
	ПереоцениваемыеГруппыАктивов.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток);
	ПереоцениваемыеГруппыАктивов.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи);
	ПереоцениваемыеГруппыАктивов.Добавить(Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой);
	ПереоцениваемыеГруппыАктивов.Добавить(Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажи);
	
	//--------------------------
	РешенияКлиентовПоЗначениямЭСП = Неопределено;
	Если ЭтотОбъект.ВариантРасчета <> Перечисления.ВариантыРасчетаПартий.РасчетТолькоКоличества Тогда
		РешенияКлиентовПоЗначениямЭСП = ПолучитьРешенияКлиентовПоЗначениямЭСП();
		
		ПараметрыОценки = Новый Структура;
		ПараметрыОценки.Вставить("Клиент", 								КлиентДоверительногоУправления);
		ПараметрыОценки.Вставить("Организация",			 				ЭтотОбъект.Организация);
		ПараметрыОценки.Вставить("СчетДоверительногоУправления",		ЭтотОбъект.СчетДоверительногоУправления);
		ПараметрыОценки.Вставить("ЦельРасчета", 						Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
		
		НастройкиЦелиРасчета = БухгалтерскийУчет.ОпределитьНастройкиЦелиРасчета(ЭтотОбъект.КонецПериода, ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления, ПараметрыОценки.ЦельРасчета);
		ПараметрыОценки.Вставить("ВариантРасчетаОценочнойСтоимости" ,	НастройкиЦелиРасчета.ВариантРасчетаОценочнойСтоимости);
		
	КонецЕсли;
	
	//--------------------------
	ЦенныеБумагиЯвляющиесяДефолтнымиПоМнениюКлиента = БухгалтерскийУчетЕПС.ПолучитьЦенныеБумагиЯвляющиесяДефолтнымиПоМнениюКлиента(ЭтотОбъект.КонецПериода, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	ЦенныеБумагиОцениваемыеПоФиксированномуКурсу = ПолучитьЦенныеБумагиОцениваемыеПоФиксированномуКурсу(ЭтотОбъект.КонецПериода, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	//--------------------------
	ТипЧислаЦена = Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип.КвалификаторыЧисла;	
	РазрядностьДробнойЧасти = ТипЧислаЦена.РазрядностьДробнойЧасти;
	
	//--------------------------
	КолонкиРассчитанныеПартии = ЗаполнитьКолонкиРассчитанныеПартии();

	
	// если клиент ведет учет по стандарту МСФО9 и начисляет резервы ежедневно
	// то при выводе бумаг (возможно, что и при продаже, но это не точно) нужно начислить резервы по выводимым активам
	// для этого мы будем собирать все движения по выводу АСных бумаг, затем скопом посчитаем какой должен быть по ним резерв и откорректируем движения 
	// нам придется хранить приходные движения перед выводом и расходные движения вывода
	СчитаемРезервыПередВыводом = Ложь;
	Если НастройкиУчетаОбщие.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов = Перечисления.СтандартыФинансовойОтчетности.МСФО9
		И НастройкиУчетаОбщие.ПериодичностьНачисленияРезервов = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
	
		СчитаемРезервыПередВыводом = Истина;
		
		МассивДвиженийРезервов = Новый Массив();
	
	КонецЕсли;
	
	//--------------------------
	//--------------------------
	ВыборкаЦеннаяБумага = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	Пока ВыборкаЦеннаяБумага.Следующий() Цикл
		
		РассчитыватьСтоимости = _Сохранение_РассчитыватьСтоимости;
		
		ДанныеПоЦеннойБумаге = Новый Структура("ЦеннаяБумага,Эмитент,Номинал,ВалютаНоминала,Амортизационная,ИндексируемыйНоминал,ДатаПогашения,ЭтоАкция,ЭтоОблигация,ЭтоПай,ЭтоИСУ");
		
		СтрокиЦенныеБумаги = ТаблицаЦенныеБумаги.НайтиСтроки(Новый Структура("ЦеннаяБумага", ВыборкаЦеннаяБумага.ЦеннаяБумага));
		Если СтрокиЦенныеБумаги.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(ДанныеПоЦеннойБумаге, СтрокиЦенныеБумаги[0]);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проблема: по ценной бумаге " + Строка(ВыборкаЦеннаяБумага.ЦеннаяБумага) + " отсутствуют данные",,,, Отказ);
			Возврат;
		КонецЕсли;	
		
		Если ДанныеПоЦеннойБумаге.ЭтоОблигация
			И (ДанныеПоЦеннойБумаге.ДатаПогашения <> '00010101' И ДанныеПоЦеннойБумаге.ДатаПогашения < НачалоДня(ЭтотОбъект.НачалоПериода)
				ИЛИ ДанныеПоЦеннойБумаге.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Эмитент_Прайм")
				ИЛИ ЦенныеБумагиЯвляющиесяДефолтнымиПоМнениюКлиента.Найти(ВыборкаЦеннаяБумага.ЦеннаяБумага) <> Неопределено
				ИЛИ ВыборкаЦеннаяБумага.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финстоун") И БанкротствоФинстоунаИАрчераПризнано
				ИЛИ ВыборкаЦеннаяБумага.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_АрчерФинанс") И БанкротствоФинстоунаИАрчераПризнано
				ИЛИ ВыборкаЦеннаяБумага.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОткрытиеХолдинг") И БанкротствоОткрытияПризнано
				ИЛИ ВыборкаЦеннаяБумага.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОткрХолдинг_004") И БанкротствоОткрытияПризнано) Тогда
			
			ДанныеПоЦеннойБумаге.Вставить("ЭтоДефолтнаяОблигация", ИСТИНА);
		Иначе
			ДанныеПоЦеннойБумаге.Вставить("ЭтоДефолтнаяОблигация", ЛОЖЬ);
		КонецЕсли;
		
		ДанныеПоЦеннойБумаге.Вставить("ПроводилиНачислениеПоЭтойОблигацияСРеструктуризациейПлатежей", ЛОЖЬ);
		
		ДанныеПоЦеннойБумаге.Вставить("ЭтоВалютнаяБумага", ДанныеПоЦеннойБумаге.ВалютаНоминала <> ВалютаУчета);
		
		ДанныеПоЦеннойБумаге.Вставить("ФиксированныйКурсПереоценки", 0);
		Если ДанныеПоЦеннойБумаге.ЭтоВалютнаяБумага И ДанныеПоЦеннойБумаге.ЭтоОблигация Тогда
			НайденныеСтроки = ЦенныеБумагиОцениваемыеПоФиксированномуКурсу.НайтиСтроки(Новый Структура("ЦеннаяБумага", ВыборкаЦеннаяБумага.ЦеннаяБумага));
			Если НайденныеСтроки.Количество() > 0 Тогда
				ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки = НайденныеСтроки[0].КурсВалютыНоминала;
			КонецЕсли;
		КонецЕсли;
		
		
		ПриходныеПартии = ПустаяТаблица.СкопироватьКолонки();
		
		// #404807 - для того, что бы в случае повышенной точности брать данные из первички
		ПриходныеПартии.Колонки.Добавить("ВключатьРасходыПоПокупкеВСтоимость", Новый ОписаниеТипов("Булево"));
		
		// #416666 - настройка УчитыватьУчетныйАктивПриСписанииПартий
		Если НастройкиУчетаОбщие.УчитыватьУчетныйАктивПриСписанииПартий Тогда
			ПриходныеПартии.Колонки.Добавить("ПорядокЕПС", Новый ОписаниеТипов("Число"));
		КонецЕсли;
		
		// эта штука нужна нам для того случая если:
		// 1. Частичное погашение и погашение купона в один день
		// 2. Частичное погашение по времени раньше
		// 3. Были партии с дисконтом
		// и частичное погашение списывает часть дисконта, а погашению его начислять надо
		СписанияДисконтов = Новый ТаблицаЗначений;
		
		СписанияДисконтов.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
		СписанияДисконтов.Колонки.Добавить("Партия", Метаданные.ОпределяемыеТипы.Партия.Тип);
		СписанияДисконтов.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
		// конец этой штуки
		
		// У нас есть расхожения в копейках с учетом у СНГ
		// дело в том, что они начисляют купоны - дисконты - премии УТРОМ, а мы при продаже
		// на этом постоянно вылезают копейки
		// Поэтому, принят следующий алгоритм:
		// 1. При первой продаже по партии мы будем полностью начислять по ней дисконт/премию на все количество
		// 2. Дальнейшие списания будут уже плясать от полной суммы
		// 3. По остальным партиям дисконт премия будет начислен вечерней переоценкой
		// 4. Небольшой нюанс - по тем партиям, что продавали в течении дня дисконт/премия вечером начисляться не будет - дабы не выравнивать дисконт/премию что запрещено СНГ
		ПартииПоКоторымНачисленыДисконтПремия = Новый ТаблицаЗначений;
		
		ПартииПоКоторымНачисленыДисконтПремия.Колонки.Добавить("Партия", Метаданные.ОпределяемыеТипы.Партия.Тип);
		ПартииПоКоторымНачисленыДисконтПремия.Колонки.Добавить("СтрокаПартии", Новый ОписаниеТипов("Число"));
		
		ДатаОпераций = Неопределено;
		БылоПогашениеКупонаПоБумагеВЭтомПериоде = Ложь;
		
		ВыборкаДетальныеЗаписи = ВыборкаЦеннаяБумага.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ВыборкаДетальныеЗаписи.ВидДвижения = Перечисления.ВидыДвижений.Приход Тогда
				РассчитыватьСтоимости = _Сохранение_РассчитыватьСтоимости;
			КонецЕсли;	
			
			Если ДатаОпераций <> НачалоДня(ВыборкаДетальныеЗаписи.Период) Тогда // произошла смена дня при расчете партий
				
				ПартииПоКоторымНачисленыДисконтПремия.Очистить();
				ДатаОпераций = НачалоДня(ВыборкаДетальныеЗаписи.Период);
				БылоПогашениеКупонаПоБумагеВЭтомПериоде = Ложь;
				
			КонецЕсли;
			
			Если ВыборкаДетальныеЗаписи.Количество = 0 Тогда
				Если ВыборкаДетальныеЗаписи.Регистратор = Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("На начало %1 обнаружено нулевое количество ЦБ %2 по партии %3, строка %4", Формат(ЭтотОбъект.НачалоПериода, "ДФ=dd.MM.yyyy"), ВыборкаДетальныеЗаписи.ЦеннаяБумага, ВыборкаДетальныеЗаписи.Партия, ВыборкаДетальныеЗаписи.СтрокаПартии), ВыборкаДетальныеЗаписи.Партия);
				КонецЕсли;
				Если НЕ РассчитыватьСтоимости Тогда
					Продолжить; // при динамическом расчете интересуют только изменения количества 
				КонецЕсли;
			КонецЕсли;			
			
			Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.КорректировкаРегистров") Тогда// ОНО О_О - начинаем тянуть корректировки в расчет 

				Если ВыборкаДетальныеЗаписи.Период > '20990601' Тогда // тянем строго с определенной даты, более ранние корректировки захардкожены и можно поломать, проводя за прошлые числа
				
					СтрокиПриходныхПартий = ПриходныеПартии.НайтиСтроки(Новый Структура("ЦеннаяБумага,Партия,СтрокаПартии,УчетныйАктивЕПС", 
																							ВыборкаДетальныеЗаписи.ЦеннаяБумага, 
																							ВыборкаДетальныеЗаписи.Партия, 
																							ВыборкаДетальныеЗаписи.СтрокаПартии,
																							ВыборкаДетальныеЗаписи.УчетныйАктивЕПС));
					Если СтрокиПриходныхПартий.Количество() <> 1 Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неправильно заведена ручная корректировка: " + Строка(ВыборкаДетальныеЗаписи.Регистратор) + " по бумаге " + Строка(ВыборкаДетальныеЗаписи.ЦеннаяБумага), ВыборкаДетальныеЗаписи.Регистратор);
						Отказ = Истина;
						Продолжить;
					Иначе
						СтрокаПриходныхПартий = СтрокиПриходныхПартий[0];
					КонецЕсли;
					
					Если СтрокаПриходныхПартий.Количество <= 0 Тогда // нельзя коректировать нулевую партию
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неправильно заведена ручная корректировка: " + Строка(ВыборкаДетальныеЗаписи.Регистратор) + " по бумаге " + Строка(ВыборкаДетальныеЗаписи.ЦеннаяБумага) + " корректируется партия с нулевым количеством", ВыборкаДетальныеЗаписи.Регистратор);
						Отказ = Истина;
						Продолжить;
					ИначеЕсли ВыборкаДетальныеЗаписи.Количество <> 0 Тогда // нельзя коректировать количество
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неправильно заведена ручная корректировка: " + Строка(ВыборкаДетальныеЗаписи.Регистратор) + " по бумаге " + Строка(ВыборкаДетальныеЗаписи.ЦеннаяБумага) + " нельзя изменять количество корректировкой", ВыборкаДетальныеЗаписи.Регистратор);
						Отказ = Истина;
						Продолжить;
					КонецЕсли;
					
					// Суть: корректировка добавляет записи в РассчитанныеПартии, но они не будут записываться 
					// и еще она должна изменять ПриходныеПартии
					НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
					ЗаполнитьЗначенияСвойств(НовоеДвижение, ВыборкаДетальныеЗаписи);
					
					ЗнакДвижения = ?(ВыборкаДетальныеЗаписи.ВидДвижения = Перечисления.ВидыДвижений.Приход, 1, -1);
					
					ДанныеДляЗанесения = Новый Структура(РесурсыРегистраПартийСодержащиеСуммы);
					Для каждого СуммовоеПоле Из ДанныеДляЗанесения Цикл
						
						ИмяПоля = СуммовоеПоле.Ключ;
						СтрокаПриходныхПартий[ИмяПоля] = СтрокаПриходныхПартий[ИмяПоля] + ЗнакДвижения * НовоеДвижение[ИмяПоля];
					
					КонецЦикла;
				
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.КонвертацияЦенныхБумаг") И ВыборкаДетальныеЗаписи.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
				Если ВыборкаДетальныеЗаписи.ВидДвижения = Перечисления.ВидыДвижений.Расход Тогда
					
					ДанныеСС = ПолучитьДанныеССдляЦБ(ВыборкаДетальныеЗаписи.Рынок, ВыборкаДетальныеЗаписи.ЦеннаяБумага, ВыборкаДетальныеЗаписи.Количество, НачалоДня(ВыборкаДетальныеЗаписи.Период));
					
					КоличествоВсего = ВыборкаДетальныеЗаписи.Количество;
					СуммаРынокВсего = ДанныеСС.СуммаРынок;
					СуммаРынокВВалютеУчетаВсего = ДанныеСС.СуммаРынокВВалютеУчета;
					
					Для каждого СтрокаПриходныхПартий Из ПриходныеПартии Цикл
					    // переоцениим по СС
						НовоеДвижениеПереоценки = ЭтотОбъект.РассчитанныеПартии.Добавить();
						//НовоеДвижениеПереоценки.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.ПереоценкаИНачислениеПроцентов;						
						
						ЗаполнитьЗначенияСвойств(НовоеДвижениеПереоценки, ВыборкаДетальныеЗаписи, "Регистратор,Период,Рынок");
						ЗаполнитьЗначенияСвойств(НовоеДвижениеПереоценки, СтрокаПриходныхПартий, "УчетныйАктивЕПС,ЦеннаяБумага,Партия,СтрокаПартии");
						
						НовоеДвижениеПереоценки.ВидДвижения = Перечисления.ВидыДвижений.Приход;
						НовоеДвижениеПереоценки.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
						
						СуммаБаланс = СтрокаПриходныхПартий.Стоимость + СтрокаПриходныхПартий.Переоценка;
						СуммаБалансВВалютеУчета = СтрокаПриходныхПартий.СтоимостьВВалютеУчета + СтрокаПриходныхПартий.ПереоценкаВВалютеУчета;
						
						СуммаРынок = СуммаРынокВсего / КоличествоВсего * СтрокаПриходныхПартий.Количество;
						СуммаРынокВВалютеУчета = СуммаРынокВВалютеУчетаВсего / КоличествоВсего * СтрокаПриходныхПартий.Количество;
						
						СуммаРынокВсего = СуммаРынокВсего - СуммаРынок;
						СуммаРынокВВалютеУчета = СуммаРынокВВалютеУчета - СуммаРынок;
						
						КоличествоВсего = КоличествоВсего - СтрокаПриходныхПартий.Количество;
						
						НовоеДвижениеПереоценки.Переоценка = СуммаРынок - СуммаБаланс; 
						НовоеДвижениеПереоценки.ПереоценкаВВалютеУчета = СуммаРынокВВалютеУчета - СуммаБалансВВалютеУчета; 
						НовоеДвижениеПереоценки.ПереоценкаСНачалаГода = НовоеДвижениеПереоценки.ПереоценкаВВалютеУчета;
						Если НовоеДвижениеПереоценки.ПереоценкаВВалютеУчета > 0 Тогда
							НовоеДвижениеПереоценки.ПереоценкаСНачалаГодаПоложительная = НовоеДвижениеПереоценки.ПереоценкаВВалютеУчета;
						КонецЕсли;
						
						СтрокаПриходныхПартий.Переоценка = СтрокаПриходныхПартий.Переоценка + НовоеДвижениеПереоценки.Переоценка;
						СтрокаПриходныхПартий.ПереоценкаВВалютеУчета = СтрокаПриходныхПартий.ПереоценкаВВалютеУчета + НовоеДвижениеПереоценки.ПереоценкаВВалютеУчета;
						СтрокаПриходныхПартий.ПереоценкаСНачалаГода = СтрокаПриходныхПартий.ПереоценкаСНачалаГода + НовоеДвижениеПереоценки.ПереоценкаСНачалаГода;
						СтрокаПриходныхПартий.ПереоценкаСНачалаГодаПоложительная = СтрокаПриходныхПартий.ПереоценкаСНачалаГодаПоложительная + НовоеДвижениеПереоценки.ПереоценкаСНачалаГодаПоложительная;
						
						// спишем
						НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
						//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.СписаниеПартии;
						
						ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаПриходныхПартий);
						ЗаполнитьЗначенияСвойств(НовоеДвижение, ВыборкаДетальныеЗаписи, "Регистратор,Период,Рынок");
						
						НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Расход;
						НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
						
					КонецЦикла;
					
					ПриходныеПартии.Очистить(); // все, финита
					
				ИначеЕсли ВыборкаДетальныеЗаписи.ВидДвижения = Перечисления.ВидыДвижений.Приход Тогда
					
					ДанныеСС = ПолучитьДанныеССдляЦБ(ВыборкаДетальныеЗаписи.Рынок, ВыборкаДетальныеЗаписи.ЦеннаяБумага, ВыборкаДетальныеЗаписи.Количество, НачалоДня(ВыборкаДетальныеЗаписи.Период));
					
					НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
					//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.ЗачислениеПартии;
					
					ЗаполнитьЗначенияСвойств(НовоеДвижение, ВыборкаДетальныеЗаписи, "Регистратор,Период,Рынок,ЦеннаяБумага,Количество");
					НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Приход;
					НовоеДвижение.УчетныйАктивЕПС = БухгалтерскийУчет.ОпределитьУчетныйАктивЕПС(ВыборкаДетальныеЗаписи.Период, ВыборкаДетальныеЗаписи.Рынок, ВыборкаДетальныеЗаписи.ЦеннаяБумага, СчетДоверительногоУправленияДляУчета);
					НовоеДвижение.СтрокаКорзиныЦенныхБумаг = 1;
					НовоеДвижение.Партия = ВыборкаДетальныеЗаписи.Регистратор;
					НовоеДвижение.СтрокаПартии = 1;
					
					НовоеДвижение.СтоимостьПокупки = ДанныеСС.СуммаРынок;
					
					НовоеДвижение.Стоимость = ДанныеСС.СуммаРынок;
					НовоеДвижение.СтоимостьВВалютеУчета = ДанныеСС.СуммаРынокВВалютеУчета;
					
				КонецЕсли;
				
			ИначеЕсли ВыборкаДетальныеЗаписи.ВидДвижения = Перечисления.ВидыДвижений.Приход Тогда
				
				ЭтоОбратноеРЕПО = Ложь;
				ЭтоЗакрытиеПрямогоРЕПО = Ложь;
				
				Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
					Если ВыборкаДетальныеЗаписи.ЧастьСделкиРЕПО = 1 Тогда
						ЭтоОбратноеРЕПО = Истина;
				    ИначеЕсли ВыборкаДетальныеЗаписи.ЧастьСделкиРЕПО = 2 Тогда
						ЭтоЗакрытиеПрямогоРЕПО = Истина;
					КонецЕсли;
				КонецЕсли;
				
				Если ЭтоЗакрытиеПрямогоРЕПО Тогда // возвращаем на баланс партии
					
					ПартииПроданныеВРЕПОКУдалению = Новый Массив;
					
					ПартииПроданныеВРЕПОПоСделке = ПартииПроданныеВРЕПО.НайтиСтроки(Новый Структура("ПродажаРЕПО,СтрокаПродажиРЕПО", ВыборкаДетальныеЗаписи.ПерваяЧастьРЕПО, ВыборкаДетальныеЗаписи.СтрокаПартии));
					
					Для Каждого СтрокаПартииПроданныеВРЕПОПоСделке Из ПартииПроданныеВРЕПОПоСделке Цикл
						
						// запомним, что удалить надо из репошных 
						ПартииПроданныеВРЕПОКУдалению.Добавить(СтрокаПартииПроданныеВРЕПОПоСделке);
						
						// пришла партия
						Если СтрокаПартииПроданныеВРЕПОПоСделке.УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО Тогда
							ПриходнаяПартия = ПартииКупленныеПоРЕПО.Добавить();
						Иначе	
							ПриходнаяПартия = ПриходныеПартии.Добавить();
							ПриходнаяПартия.НомерСтроки = ПриходныеПартии.Количество();
							ПриходнаяПартия.Регистратор = ВыборкаДетальныеЗаписи.Партия;
						КонецЕсли;
						ЗаполнитьЗначенияСвойств(ПриходнаяПартия, СтрокаПартииПроданныеВРЕПОПоСделке);
						
						// движение по партиям приход сделать
						Если СтрокаПартииПроданныеВРЕПОПоСделке.УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО Тогда
							НовоеДвижение = ЭтотОбъект.РассчитанныеПартииОбратноеРЕПО.Добавить();
						Иначе 
							НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
						КонецЕсли;	
						ЗаполнитьЗначенияСвойств(НовоеДвижение, ПриходнаяПартия);
						
						НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Приход;
						НовоеДвижение.СтрокаКорзиныЦенныхБумаг = СтрокаПартииПроданныеВРЕПОПоСделке.СтрокаПартии;
						
						// движение по партиям РЕПО расход сделать
						НовоеДвижениеРЕПО = РассчитанныеПартииПрямоеРЕПО.Добавить();
						ЗаполнитьЗначенияСвойств(НовоеДвижениеРЕПО,СтрокаПартииПроданныеВРЕПОПоСделке);
						НовоеДвижениеРЕПО.Регистратор = ВыборкаДетальныеЗаписи.Партия;
						
						НовоеДвижениеРЕПО.ВидДвижения = Перечисления.ВидыДвижений.Расход;
						НовоеДвижениеРЕПО.СтрокаКорзиныЦенныхБумаг = СтрокаПартииПроданныеВРЕПОПоСделке.СтрокаПартии;
						
					КонецЦикла;
					
					ПриходныеПартии.Сортировать("Период"); // отсортировать обязательно		
					
					// удалим партии РЕПО
					Для каждого СтрокаПартииПроданныеВРЕПОКУдалению Из ПартииПроданныеВРЕПОКУдалению Цикл
						ПартииПроданныеВРЕПО.Удалить(СтрокаПартииПроданныеВРЕПОКУдалению);
					КонецЦикла;
					
				ИначеЕсли ЭтоОбратноеРЕПО И НастройкиПоВидуУчета.УчитыватьПартииРЕПООтдельно Тогда // приходуем в РЕПОшные партии
					
					ПриходнаяПартияРЕПО = ПартииКупленныеПоРЕПО.Добавить();
					
					ЗаполнитьЗначенияСвойств(ПриходнаяПартияРЕПО, ВыборкаДетальныеЗаписи);
					
					Если РассчитыватьСтоимости Тогда
					
						ВалютаСделки = ВыборкаДетальныеЗаписи.ВалютаСделки;
						ПриходнаяПартияРЕПО.Стоимость = РаботаСВалютами.ПересчетСуммыВВалюте(ВыборкаДетальныеЗаписи.СтоимостьПокупки, ВалютаСделки, ВыборкаДетальныеЗаписи.Период, ДанныеПоЦеннойБумаге.ВалютаНоминала, ВыборкаДетальныеЗаписи.Период, Отказ);
						ПриходнаяПартияРЕПО.СтоимостьВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ВыборкаДетальныеЗаписи.СтоимостьПокупки, ВалютаСделки, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период, Отказ);
						ПриходнаяПартияРЕПО.СтоимостьКупона = РаботаСВалютами.ПересчетСуммыВВалюте(ВыборкаДетальныеЗаписи.СтоимостьПокупкиКупона, ВалютаСделки, ВыборкаДетальныеЗаписи.Период, ДанныеПоЦеннойБумаге.ВалютаНоминала, ВыборкаДетальныеЗаписи.Период, Отказ);
						ПриходнаяПартияРЕПО.СтоимостьКупонаВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ВыборкаДетальныеЗаписи.СтоимостьПокупкиКупона, ВалютаСделки, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период, Отказ);
						
						Если Отказ Тогда
							Возврат;
						КонецЕсли;
						
					КонецЕсли; 
					
					НовоеДвижение = ЭтотОбъект.РассчитанныеПартииОбратноеРЕПО.Добавить();
					
					ЗаполнитьЗначенияСвойств(НовоеДвижение, ВыборкаДетальныеЗаписи);
					
					НовоеДвижение.Стоимость = ПриходнаяПартияРЕПО.Стоимость;
					НовоеДвижение.СтоимостьВВалютеУчета = ПриходнаяПартияРЕПО.СтоимостьВВалютеУчета;
					НовоеДвижение.СтоимостьКупона = ПриходнаяПартияРЕПО.СтоимостьКупона;
					НовоеДвижение.СтоимостьКупонаВВалютеУчета = ПриходнаяПартияРЕПО.СтоимостьКупонаВВалютеУчета;
					
					НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Приход;
					НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
					
				Иначе
					
					ПартииДляРаспределения = Новый Массив;
					
					Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.Сделка") //по этим документам неясен учетный актив ЕПС
						 ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.СделкаРЕПО")
						 ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке")
						 ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг") Тогда
						 
						ТекСделка = ВыборкаДетальныеЗаписи.Регистратор; 
						Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке")
						 ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг") Тогда
							ТекСделка = ВыборкаДетальныеЗаписи.Основание;
						КонецЕсли;
						
						КоличествоРаспределить = ВыборкаДетальныеЗаписи.Количество;
						РаспределенияПоТекущейСделкеИБумаге = РаспределенияПоСделкам.НайтиСтроки(Новый Структура("Сделка, ЦеннаяБумага", ТекСделка, ВыборкаДетальныеЗаписи.ЦеннаяБумага));
						Для Каждого СтрокаРаспределенияПоСделкам Из РаспределенияПоТекущейСделкеИБумаге Цикл
							Если СтрокаРаспределенияПоСделкам.Количество = 0 Тогда
								Продолжить;
							КонецЕсли;
							
							СтрокаПартииДляРаспределения = Новый Структура(КолонкиРассчитанныеПартии);
														
							ЗаполнитьЗначенияСвойств(СтрокаПартииДляРаспределения, ВыборкаДетальныеЗаписи);
							
							СтрокаПартииДляРаспределения.УчетныйАктивЕПС = СтрокаРаспределенияПоСделкам.УчетныйАктивЕПС;
							СтрокаПартииДляРаспределения.Количество = МИН(СтрокаРаспределенияПоСделкам.Количество, КоличествоРаспределить);
							
							СтрокаРаспределенияПоСделкам.Количество = СтрокаРаспределенияПоСделкам.Количество - СтрокаПартииДляРаспределения.Количество;
							
							КоличествоРаспределить = КоличествоРаспределить - СтрокаПартииДляРаспределения.Количество;
							ПартииДляРаспределения.Добавить(СтрокаПартииДляРаспределения);
							Если КоличествоРаспределить = 0 Тогда
								Прервать;
							КонецЕсли; 
							
						КонецЦикла;
						 
						КоличествоРаспределить = ВыборкаДетальныеЗаписи.Количество;
						 
						ДанныеДляРаспределения = Новый Структура(РесурсыРегистраПартийСодержащиеСуммы);
						ЗаполнитьЗначенияСвойств(ДанныеДляРаспределения, ВыборкаДетальныеЗаписи);
						
						ДатаКурса = ВыборкаДетальныеЗаписи.Период;
						// для валютной бумаги, если есть настройка, что берем курс датой сделки и наша партия не сделка, то дату курса ставим датой сделки
						Если ДанныеПоЦеннойБумаге.ЭтоВалютнаяБумага
							И НастройкиПоВидуУчета.ВариантВзятияКурсаВалютныхБумагПриСделкахВРубляхДляРасчетаСтоимости = Перечисления.ВариантВзятияКурсаВалютныхБумагПриСделкахВРубляхДляРасчетаСтоимости.НаДатуСделки
							И ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) <> Тип("ДокументСсылка.Сделка")
							И ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) <> Тип("ДокументСсылка.СделкаРЕПО") Тогда
							
							ДатаКурса = ТекСделка.Дата;
						
						КонецЕсли;
						
						// если мы при:
						// 1. Расчете СЧА - "НЕ РассчитыватьСтоимости" 
						// 2. Взяли бумагу по АС  - "СтрокаПартииДляРаспределения.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость"
						// 3. Причем, это валютная бумага - "ДанныеПоЦеннойБумаге.ЭтоВалютнаяБумага"
						// 4. А сделка была не в валюте номинала
						// то нужно ПересчитатьДанныеСделкиВВалютуНоминала()
						Если Не РассчитыватьСтоимости
							И СтрокаПартииДляРаспределения.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость
							И ДанныеПоЦеннойБумаге.ЭтоВалютнаяБумага
							И ВыборкаДетальныеЗаписи.ВалютаСделки <> ДанныеПоЦеннойБумаге.ВалютаНоминала
							Тогда
							
							ПересчитатьДанныеСделкиВВалютуНоминала(ДатаКурса, ДанныеДляРаспределения, ВыборкаДетальныеЗаписи, ДанныеПоЦеннойБумаге.ВалютаНоминала, ТаблицаРасходыПоСделкеСЗамещающимиОблигациями, ВалютаУчета, Отказ);
							
						КонецЕсли;
						
						Если РассчитыватьСтоимости Тогда
						
							ЗаполнитьПоляВВалютеУчета(ДатаКурса, ДанныеДляРаспределения, ВыборкаДетальныеЗаписи, ДанныеПоЦеннойБумаге.ВалютаНоминала, ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки, ТаблицаРасходыПоСделкеСЗамещающимиОблигациями, ВалютаУчета, Отказ);
							
							Если Отказ Тогда
								Возврат;
							КонецЕсли;
							
							Для каждого СтрокаПартииДляРаспределения Из ПартииДляРаспределения Цикл
								Для каждого СуммовоеПоле Из ДанныеДляРаспределения Цикл
									ИмяПоля = СуммовоеПоле.Ключ;
									СуммаКРаспределению = СуммовоеПоле.Значение;
									Сумма = СуммаКРаспределению / КоличествоРаспределить * СтрокаПартииДляРаспределения.Количество;
									СтрокаПартииДляРаспределения[ИмяПоля] = Сумма;
									ДанныеДляРаспределения[ИмяПоля] = СуммаКРаспределению - Сумма;
								КонецЦикла;
								КоличествоРаспределить = КоличествоРаспределить - СтрокаПартииДляРаспределения.Количество;
							 КонецЦикла;
						
						КонецЕсли; 						
						 
					Иначе
						 СтрокаПартииДляРаспределения = Новый Структура(КолонкиРассчитанныеПартии);
						 ЗаполнитьЗначенияСвойств(СтрокаПартииДляРаспределения, ВыборкаДетальныеЗаписи);
						 
						 Если ВыборкаДетальныеЗаписи.Регистратор <> Неопределено			// это НЕ начальные остатки партий
							 И НЕ ДанныеПоЦеннойБумаге.ЭтоДефолтнаяОблигация                // это не дефолтная бумага - у них сильно уж сложно
							 И ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки <> 0 Тогда	// курс валюты номинала фиксированный - значит, вводим строго по нему
						 	ЗаполнитьПоляВВалютеУчета(ВыборкаДетальныеЗаписи.Период, СтрокаПартииДляРаспределения, ВыборкаДетальныеЗаписи, ДанныеПоЦеннойБумаге.ВалютаНоминала, ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки, , ВалютаУчета, Отказ);
						 КонецЕсли;
						 
						 Если СтрокаПартииДляРаспределения.УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПустаяСсылка() Тогда
						 	СтрокаПартииДляРаспределения.УчетныйАктивЕПС = БухгалтерскийУчет.ОпределитьУчетныйАктивЕПС(ВыборкаДетальныеЗаписи.Период, ВыборкаДетальныеЗаписи.Рынок, ВыборкаДетальныеЗаписи.ЦеннаяБумага, СчетДоверительногоУправленияДляУчета);
						 КонецЕсли; 
						 ПартииДляРаспределения.Добавить(СтрокаПартииДляРаспределения);
					КонецЕсли;
					
					ОтсортироватьПриходы = Ложь;
					
					Для Каждого СтрокаПартииДляРаспределения Из ПартииДляРаспределения Цикл
						
						Если ЭтотОбъект.ВариантРасчета = Перечисления.ВариантыРасчетаПартий.РасчетКоличестваДляБумагПоАССуммы И НЕ РассчитыватьСтоимости // ведем расчет для целей СЧА и не считаем стоимости
							И СтрокаПартииДляРаспределения.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость Тогда	// но вот возникла партия по АС
							
							РассчитыватьСтоимости = Истина; // и вот мы уже считаем стоимости!
							
						КонецЕсли;
						
						НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
							НастройкиУчетаОбщие,
							ВыборкаДетальныеЗаписи.ЦеннаяБумага,
							СтрокаПартииДляРаспределения.УчетныйАктивЕПС,
							СтрокаПартииДляРаспределения.Партия,
							СтрокаПартииДляРаспределения.СтрокаПартии);
						
						ПриходнаяПартия = ПриходныеПартии.Добавить();
						
						ЗаполнитьЗначенияСвойств(ПриходнаяПартия, СтрокаПартииДляРаспределения);
						ПриходнаяПартия.ВключатьРасходыПоПокупкеВСтоимость = ПриходнаяПартия.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость;
						
						Если ПриходнаяПартия.ВключатьРасходыПоПокупкеВСтоимость // настроки актива важны,но с 1.1.26 для бумаг по АС могут быть применен критерий
							И НастройкиУчетаОбщие.ПроцентВключенияРасходовВСтоимостьОблигацийПоАС > 0
							И ПриходнаяПартия.РасходыПриПокупкеВСтоимостиВВалютеУчета / ПриходнаяПартия.СтоимостьПокупкиВВалютеУчета * 100 < НастройкиУчетаОбщие.ПроцентВключенияРасходовВСтоимостьОблигацийПоАС Тогда
							
							ПриходнаяПартия.ВключатьРасходыПоПокупкеВСтоимость = Ложь;
							
							СтрокаНастроек = РассчитанныеНастройкиДляПартии.Добавить();
							ЗаполнитьЗначенияСвойств(СтрокаНастроек, ПриходнаяПартия);
							СтрокаНастроек.Настройка = ПланыВидовХарактеристик.НастройкиУчетаЦенныхБумаг.НеВключатьРасходыВСтоимость;
							
							СтрокаНастроек.ЗначениеНастройки = Истина;
							СтрокаНастроек.Отключить = Ложь;
							
						КонецЕсли;
						
						ПриходнаяПартия.НомерСтроки = ПриходныеПартии.Количество();
						
						Если (СтрокаПартииДляРаспределения.Регистратор <> Неопределено)
							И (ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) <> Тип("ДокументСсылка.ВводЦенныхБумаг")
								ИЛИ ВыборкаДетальныеЗаписи.Период < МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ) Тогда
								//обработаем стоимости, причем начальные остатки идут "как есть" - не берем их
								//вводы обрабатываем только те, которые были после константы
							
							Если РассчитыватьСтоимости Тогда
							
								ПриходнаяПартия.Стоимость = ПриходнаяПартия.СтоимостьПокупки;
								ПриходнаяПартия.СтоимостьВВалютеУчета = ПриходнаяПартия.СтоимостьПокупкиВВалютеУчета;
								
								//тут неверно, нужно собирать и конвертировать расходы отдельно
								//случился прецедент и я переделал - для случая покупки валютной бумаги за рубли (и рублевой комиссии!!)
								//НИЧЕГО пересчитывать не нужно - в РасходыПриПокупкеВСтоимостиВВалютеУчета уже лежит правильная рублевая сумма 
								//сделал для всех ситуации безоговорочно т.к. таких случаев еще НИКОГДА не было
								Если НЕ (ВыборкаДетальныеЗаписи.ВалютаСделки = ВалютаУчета И ДанныеПоЦеннойБумаге.ВалютаНоминала <> ВалютаУчета) Тогда
									ПриходнаяПартия.РасходыПриПокупкеВСтоимостиВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
										ПриходнаяПартия.РасходыПриПокупкеВСтоимости,
										ДанныеПоЦеннойБумаге.ВалютаНоминала,
										ЭтотОбъект.Организация,
										ПриходнаяПартия.Период);
								КонецЕсли;
								
								Если ПриходнаяПартия.ВключатьРасходыПоПокупкеВСтоимость Тогда 
									Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) <> Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда // для вводов это чисто информационные ресурсы т.к. в стоимость расходы попали ранее
										ПриходнаяПартия.Стоимость = ПриходнаяПартия.Стоимость + ПриходнаяПартия.РасходыПриПокупкеВСтоимости;
										ПриходнаяПартия.СтоимостьВВалютеУчета = ПриходнаяПартия.СтоимостьВВалютеУчета + ПриходнаяПартия.РасходыПриПокупкеВСтоимостиВВалютеУчета;
									КонецЕсли;
								Иначе
									ПриходнаяПартия.РасходыПриПокупкеВСтоимости = 0;
									ПриходнаяПартия.РасходыПриПокупкеВСтоимостиВВалютеУчета = 0;
								КонецЕсли;
								
								Если (СтрокаПартииДляРаспределения.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации) 
									ИЛИ (СтрокаПартииДляРаспределения.Рынок = Перечисления.РынкиЦенныхБумаг.Векселя) Тогда
									
									УчитыватьИндексациюНоминала = Ложь;
									Если ДанныеПоЦеннойБумаге.ИндексируемыйНоминал И НастройкиПоВидуУчета.ВариантУчетаИндексацииНоминала = Перечисления.ВариантыУчетаИндексированногоНоминала.ОтНачальногоНоминала Тогда
										УчитыватьИндексациюНоминала = Истина;
									КонецЕсли;
									
									СтоимостьПоНоминалу = СтрокаПартииДляРаспределения.Номинал * СтрокаПартииДляРаспределения.Количество;
									СтоимостьПоНоминалуВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтоимостьПоНоминалу, ДанныеПоЦеннойБумаге.ВалютаНоминала, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период, Отказ);
									
									ПриходнаяПартия.ДисконтПремия = ПриходнаяПартия.Стоимость - СтоимостьПоНоминалу;
									ДисконтПремияВВалютеУчета = ПриходнаяПартия.СтоимостьВВалютеУчета - СтоимостьПоНоминалуВВалютеУчета;
									ПриходнаяПартия.ДисконтПремияПокупки = ПриходнаяПартия.ДисконтПремия;
									
									ПриходнаяПартия.ИндексацияНоминала = 0;
									ПриходнаяПартия.ИндексацияНоминалаСНачалаГода = 0;
									
									Если УчитыватьИндексациюНоминала Тогда
										
										СтоимостьПоНоминалу = СтрокаПартииДляРаспределения.Номинал * СтрокаПартииДляРаспределения.Количество;
										СтоимостьПоНачальномуНоминалу = ДанныеПоЦеннойБумаге.Номинал * СтрокаПартииДляРаспределения.Количество;
										
										Стоимость = ПриходнаяПартия.Стоимость / СтоимостьПоНоминалу  * СтоимостьПоНачальномуНоминалу;
										
										ИндексацияНоминала = ПриходнаяПартия.Стоимость - Стоимость;
										ДисконтПремия = ПриходнаяПартия.Стоимость - СтоимостьПоНоминалу;
										
										ПриходнаяПартия.Стоимость = Стоимость;
										ПриходнаяПартия.СтоимостьВВалютеУчета = Стоимость;
										
										ПриходнаяПартия.ИндексацияНоминала = ИндексацияНоминала;
										
										ПриходнаяПартия.ДисконтПремия = ДисконтПремия;
										ПриходнаяПартия.ДисконтПремияПокупки = ДисконтПремия;
										ПриходнаяПартия.ДисконтПремияНачисленный = ?(ДисконтПремия > 0, ДисконтПремия, 0);
										ПриходнаяПартия.ДисконтПремияНачисленныйВВалютеУчета = ПриходнаяПартия.ДисконтПремияНачисленный;
										
									ИначеЕсли ПриходнаяПартия.ДисконтПремия > 0 Тогда // купили с премией
										
										// сразу начисляем ее всю
										ПриходнаяПартия.ДисконтПремияНачисленный = ПриходнаяПартия.ДисконтПремия;
										ПриходнаяПартия.ДисконтПремияНачисленныйВВалютеУчета = ДисконтПремияВВалютеУчета;
										// и отражаем на стоимости только номинальную стоимость
										ПриходнаяПартия.Стоимость = СтоимостьПоНоминалу;
										ПриходнаяПартия.СтоимостьВВалютеУчета = СтоимостьПоНоминалуВВалютеУчета;
										
										// бывают такие клиенты, которые комиссию кладут на тело, и тело становится больше номинала
										Если ПриходнаяПартия.ВключатьРасходыПоПокупкеВСтоимость Тогда
										
											ОтноситьРасходыПриПокупкеНаПремию = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(ЭтотОбъект.КонецПериода,
																																 ЭтотОбъект.Организация,
																																 СчетДоверительногоУправленияДляУчета,
																																 ПриходнаяПартия.УчетныйАктивЕПС,
																																 Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет,
																																 "ОтноситьРасходыПриПокупкеНаПремию");
											Если НЕ ОтноситьРасходыПриПокупкеНаПремию Тогда // пихаем в тело расходы, а что делать...
												
												// точнее переносим из премии, если уже запихали туда
												ПриходнаяПартия.ДисконтПремия = ПриходнаяПартия.ДисконтПремия - ПриходнаяПартия.РасходыПриПокупкеВСтоимости;
												ПриходнаяПартия.ДисконтПремияПокупки = ПриходнаяПартия.ДисконтПремия;
												ПриходнаяПартия.ДисконтПремияНачисленный = ПриходнаяПартия.ДисконтПремияНачисленный - ПриходнаяПартия.РасходыПриПокупкеВСтоимости;
												ПриходнаяПартия.ДисконтПремияНачисленныйВВалютеУчета = ПриходнаяПартия.ДисконтПремияНачисленныйВВалютеУчета - ПриходнаяПартия.РасходыПриПокупкеВСтоимостиВВалютеУчета;
												ПриходнаяПартия.Стоимость = ПриходнаяПартия.Стоимость + ПриходнаяПартия.РасходыПриПокупкеВСтоимости;
												ПриходнаяПартия.СтоимостьВВалютеУчета = ПриходнаяПартия.СтоимостьВВалютеУчета + ПриходнаяПартия.РасходыПриПокупкеВСтоимостиВВалютеУчета;
											
											КонецЕсли;
																																 
										КонецЕсли;
										
									ИначеЕсли ПриходнаяПартия.ДисконтПремия < 0 И НастройкиУчетаЦеннойБумаги.СтоимостьТелаРавнаНоминалу Тогда
										
										ПриходнаяПартия.ДисконтПремияНачисленный = ПриходнаяПартия.ДисконтПремия;
										ПриходнаяПартия.ДисконтПремияНачисленныйВВалютеУчета = ДисконтПремияВВалютеУчета;
										ПриходнаяПартия.Стоимость = СтоимостьПоНоминалу;
										ПриходнаяПартия.СтоимостьВВалютеУчета = СтоимостьПоНоминалуВВалютеУчета;
										
									КонецЕсли;
									
								КонецЕсли;
								
								Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) <> Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда
								
									ПриходнаяПартия.СтоимостьКупона = ПриходнаяПартия.СтоимостьПокупкиКупона;
									ПриходнаяПартия.СтоимостьКупонаВВалютеУчета = ПриходнаяПартия.СтоимостьПокупкиКупонаВВалютеУчета;
									
									ДанныеПоискаРешений = Новый Структура("ЦеннаяБумага, Партия, СтрокаПартии");
									ЗаполнитьЗначенияСвойств(ДанныеПоискаРешений, ПриходнаяПартия);
									СтрокиРешений = РешенияКлиентовПоЗначениямЭСП.НайтиСтроки(ДанныеПоискаРешений);
									Если СтрокиРешений.Количество() > 0 Тогда
										
										ПараметрыДенежногоПотока = Новый Структура;
										ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения", НастройкиУчетаЦеннойБумаги.РассчитыватьЭСПДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоПогашения);
										ПараметрыДенежногоПотока.Вставить("Дата",			 ВыборкаДетальныеЗаписи.Период);
										ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",	 ВыборкаДетальныеЗаписи.Период);
										ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(ПриходнаяПартия.ЦеннаяБумага, ПараметрыДенежногоПотока, ПараметрыОценки);
										
										СтоимостьАС = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтрокиРешений[0].ЭСП, ВыборкаДетальныеЗаписи.Период) * ПриходнаяПартия.Количество;
										
										СтоимостьПриобретения = ПриходнаяПартия.Стоимость + ПриходнаяПартия.СтоимостьПокупкиКупона;
										
										КорректировкаПП = Окр(СтоимостьАС, 2) - СтоимостьПриобретения;
										
										ПриходнаяПартия.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = КорректировкаПП;
										ПриходнаяПартия.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета = КорректировкаПП;
										ПриходнаяПартия.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная = КорректировкаПП;
										
									КонецЕсли;
									
								КонецЕсли;
								
								//переоценка
								ПриходнаяПартия.Переоценка = 0;
								ПриходнаяПартия.ПереоценкаСНачалаГода = 0;
								ПриходнаяПартия.ПереоценкаСНачалаГодаПоложительная = 0;
							
							КонецЕсли; 

							ВсегоКПогашению = ПриходнаяПартия.Количество;
							ПартииСПереоценкой = РассчитанныеПартииКПоступлениюДляСписания.НайтиСтроки(Новый Структура("Регистратор, ЦеннаяБумага, УчетныйАктивЕПС", ВыборкаДетальныеЗаписи.Регистратор, СтрокаПартииДляРаспределения.ЦеннаяБумага, СтрокаПартииДляРаспределения.УчетныйАктивЕПС));
							Для Каждого ПартияСПереоценкой Из ПартииСПереоценкой Цикл
								
								Если ВсегоКПогашению = 0 Тогда
									
									Прервать;
									
								КонецЕсли;
								
								Если ПартияСПереоценкой.Количество = 0
									И ПартияСПереоценкой.ПереоценкаНаБалансе = 0
									И ПартияСПереоценкой.ПереоценкаСНачалаГода = 0
									И ПартияСПереоценкой.ПереоценкаСНачалаГодаПоложительная = 0 Тогда
									
									Продолжить;
									
								КонецЕсли;
								
								КПогашению = Мин(ПартияСПереоценкой.Количество, ВсегоКПогашению);
								
								Если РассчитыватьСтоимости Тогда
									
									ПриходнаяПартия.Переоценка = ПриходнаяПартия.Переоценка + ПартияСПереоценкой.ПереоценкаНаБалансе;
									ПриходнаяПартия.ПереоценкаВВалютеУчета = ПриходнаяПартия.ПереоценкаВВалютеУчета + ПартияСПереоценкой.ПереоценкаНаБалансеВВалютеУчета;
									
									ПриходнаяПартия.ПереоценкаСНачалаГода = ПриходнаяПартия.ПереоценкаСНачалаГода + ПартияСПереоценкой.ПереоценкаСНачалаГода;
									ПриходнаяПартия.ПереоценкаСНачалаГодаПоложительная = ПриходнаяПартия.ПереоценкаСНачалаГодаПоложительная + ПартияСПереоценкой.ПереоценкаСНачалаГодаПоложительная;
									
									Если Отказ Тогда
										Возврат;
									КонецЕсли;
									
								КонецЕсли; 
								
								ВсегоКПогашению = ВсегоКПогашению - КПогашению;
								ПартияСПереоценкой.Количество = ПартияСПереоценкой.Количество - КПогашению;
							КонецЦикла;
							
						// вводы 2016, которые надо правильно учитыватьв ЕПС,у них заполнена стоимость покупки - пока так криво выделяем	
						ИначеЕсли (ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ВводЦенныхБумаг")
							И ВыборкаДетальныеЗаписи.Период > МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ)
							И СтрокаПартииДляРаспределения.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации
							И РассчитыватьСтоимости Тогда
							
							ДатаПокупки = БухгалтерскийУчетЕПС.ОпределитьДатуПокупкиПартии(СтрокаПартииДляРаспределения.Партия, СтрокаПартииДляРаспределения.СтрокаПартии, Истина, МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ);
							
							ИндексацияНоминала = ВыборкаДетальныеЗаписи.ИндексацияНоминала;
							Если СтрокаПартииДляРаспределения.ЦеннаяБумага.ИндексируемыйНоминал Тогда
								// номинал берем на момент покупки!!!
								Если ДатаПокупки = Неопределено ИЛИ ДатаПокупки = '00010101' Тогда
								
									Отказ = Истина;
									ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не заполнена дата покупки ЦБ %1 по партии %2, строка %3",
										СтрокаПартииДляРаспределения.ЦеннаяБумага,
										СтрокаПартииДляРаспределения.Партия,
										СтрокаПартииДляРаспределения.СтрокаПартии));
									Возврат;
								
								КонецЕсли;
								
								СтоимостьПоНоминалу = СтрокаПартииДляРаспределения.Количество * Справочники.Облигации.ПолучитьНоминал(СтрокаПартииДляРаспределения.ЦеннаяБумага, ДатаПокупки);
								Если НастройкиПоВидуУчета.ВариантУчетаИндексацииНоминала = Перечисления.ВариантыУчетаИндексированногоНоминала.ОтНачальногоНоминала Тогда
									СтоимостьПоНачальномуНоминалу = ДанныеПоЦеннойБумаге.Номинал * СтрокаПартииДляРаспределения.Количество;
									ИндексацияНоминала = (СтоимостьПоНоминалу - СтоимостьПоНачальномуНоминалу) * СтрокаПартииДляРаспределения.Количество;
									СтоимостьПоНоминалу = СтоимостьПоНачальномуНоминалу;
								ИначеЕсли НастройкиПоВидуУчета.ВариантУчетаИндексацииНоминала = Перечисления.ВариантыУчетаИндексированногоНоминала.НеУчитывать Тогда
									ИндексацияНоминала = 0;
									СтоимостьПоНоминалу = СтрокаПартииДляРаспределения.Количество * Справочники.Облигации.ПолучитьНоминал(СтрокаПартииДляРаспределения.ЦеннаяБумага, ДатаПокупки);
								КонецЕсли;
							Иначе	// номинал берем на момент ввода!!!
								СтоимостьПоНоминалу = СтрокаПартииДляРаспределения.Количество * Справочники.Облигации.ПолучитьНоминал(СтрокаПартииДляРаспределения.ЦеннаяБумага, ВыборкаДетальныеЗаписи.Период);
							КонецЕсли;
							ПриходнаяПартия.ИндексацияНоминала = ИндексацияНоминала;
							ПриходнаяПартия.ИндексацияНоминалаСНачалаГода = ИндексацияНоминала;
							
							Если ПриходнаяПартия.ДисконтПремия > 0 ИЛИ НастройкиУчетаЦеннойБумаги.СтоимостьТелаРавнаНоминалу Тогда
								ПриходнаяПартия.Стоимость = СтоимостьПоНоминалу;
							Иначе
								ПриходнаяПартия.Стоимость = СтоимостьПоНоминалу + ПриходнаяПартия.ДисконтПремия;
							КонецЕсли;
							
							Если ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки <> 0	// по фикс курсу
								И НЕ ДанныеПоЦеннойБумаге.ЭтоДефолтнаяОблигация Тогда	// кроме дефолтных - у них все по другому
							    ПриходнаяПартия.СтоимостьВВалютеУчета = ПриходнаяПартия.Стоимость * ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки;
							Иначе
								ПриходнаяПартия.СтоимостьВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ПриходнаяПартия.Стоимость,ДанныеПоЦеннойБумаге.ВалютаНоминала, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период, Отказ);
							КонецЕсли;
							
							Если СтрокаПартииДляРаспределения.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Магистраль_002")	// особенная бумага
								И НачалоДня(ВыборкаДетальныеЗаписи.Период) = '20251219' Тогда														// в особенный день
							
								ПриходнаяПартия.Стоимость = СтрокаПартииДляРаспределения.СтоимостьВВалютеУчета;
								ПриходнаяПартия.СтоимостьВВалютеУчета = СтрокаПартииДляРаспределения.СтоимостьВВалютеУчета;
							
							ИначеЕсли СтрокаПартииДляРаспределения.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВейлФинанс")// особенная бумага
								И НачалоДня(ВыборкаДетальныеЗаписи.Период) = '20251219' Тогда														// в особенный день
							
								ПриходнаяПартия.Стоимость = СтрокаПартииДляРаспределения.СтоимостьВВалютеУчета;
								ПриходнаяПартия.СтоимостьВВалютеУчета = СтрокаПартииДляРаспределения.СтоимостьВВалютеУчета;
							
							ИначеЕсли СтрокаПартииДляРаспределения.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Структурные_инвестиции")// особенная бумага
								И НачалоДня(ВыборкаДетальныеЗаписи.Период) = '20251219' Тогда														// в особенный день
							
								ПриходнаяПартия.Стоимость = СтрокаПартииДляРаспределения.СтоимостьВВалютеУчета;
								ПриходнаяПартия.СтоимостьВВалютеУчета = СтрокаПартииДляРаспределения.СтоимостьВВалютеУчета;
							
							ИначеЕсли СтрокаПартииДляРаспределения.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финстандарт")// особенная бумага
								И (НачалоДня(ВыборкаДетальныеЗаписи.Период) = '20251219'                                                             // в особенный день
									ИЛИ НачалоДня(ВыборкаДетальныеЗаписи.Период) = '20251223') Тогда													 // второй особенный день	
							
								ПриходнаяПартия.СтоимостьВВалютеУчета = СтрокаПартииДляРаспределения.СтоимостьВВалютеУчета;
							
							КонецЕсли;
							
							Если НЕ ПриходнаяПартия.ВключатьРасходыПоПокупкеВСтоимость												// у бумаг по СС
								ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Партия) = Тип("ДокументСсылка.РеклассификацияАктивовЕПС") Тогда	// и бумаг, прошедших рекласс
							
								ПриходнаяПартия.РасходыПриПокупкеВСтоимости = 0;													// не должно быть расходов в стоимости
								ПриходнаяПартия.РасходыПриПокупкеВСтоимостиВВалютеУчета = 0;										// т.к. при их покупке комиссия сразу шла на расходы
							
							Иначе // бывают такие клиенты, которые комиссию кладут на тело, и тело становится больше номинала
							
								ОтноситьРасходыПриПокупкеНаПремию = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(ЭтотОбъект.КонецПериода,
																													 ЭтотОбъект.Организация,
																													 СчетДоверительногоУправленияДляУчета,
																													 ПриходнаяПартия.УчетныйАктивЕПС,
																													 Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет,
																													 "ОтноситьРасходыПриПокупкеНаПремию");
																													 
								Если НЕ ОтноситьРасходыПриПокупкеНаПремию И ПриходнаяПартия.ДисконтПремия = 0 Тогда // пихаем в тело расходы, а что делать...
									
									СтоимостьПоНоминалу = СтрокаПартииДляРаспределения.Количество * Справочники.Облигации.ПолучитьНоминал(СтрокаПартииДляРаспределения.ЦеннаяБумага, ДатаПокупки);
									Если ПриходнаяПартия.СтоимостьПокупки <> СтоимостьПоНоминалу Тогда
									
										ПриходнаяПартия.Стоимость = ПриходнаяПартия.СтоимостьПокупки;
										Если ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки <> 0 Тогда
											ПриходнаяПартия.СтоимостьВВалютеУчета = ПриходнаяПартия.Стоимость * ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки;
										Иначе
											ПриходнаяПартия.СтоимостьВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ПриходнаяПартия.Стоимость, ДанныеПоЦеннойБумаге.ВалютаНоминала, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период, Отказ);
										КонецЕсли;
									
									КонецЕсли;
								
								КонецЕсли;
																													 
							КонецЕсли;
							
							Если ПриходнаяПартия.УчетныйАктивЕПС.Родитель = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи Тогда
								ПриходнаяПартия.ПереоценкаСНачалаГода = ПриходнаяПартия.Переоценка
							КонецЕсли;
							
							Если Отказ Тогда
								Возврат;
							КонецЕсли;
							
						КонецЕсли;
						
						Если НастройкиУчетаОбщие.УчитыватьУчетныйАктивПриСписанииПартий Тогда
							ПриходнаяПартия.ПорядокЕПС = ПорядокЕПС[ПриходнаяПартия.УчетныйАктивЕПС.Родитель];
							ОтсортироватьПриходы = Истина;
						КонецЕсли;
						
						НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
						//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.ЗачислениеПартии;
						
						ЗаполнитьЗначенияСвойств(НовоеДвижение, ПриходнаяПартия);
						
						НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Приход;
						НовоеДвижение.СтрокаКорзиныЦенныхБумаг = СтрокаПартииДляРаспределения.СтрокаПартии;
						
						
						Если ТипЗнч(СтрокаПартииДляРаспределения.Партия) = Тип("ДокументСсылка.ВводЦенныхБумаг")
							И СтрокаПартииДляРаспределения.Партия.Дата > МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ
							И СтрокаПартииДляРаспределения.Регистратор <> Неопределено Тогда
							
							ПриходнаяПартия.Период = КонецДня(БухгалтерскийУчетЕПС.ОпределитьДатуПокупкиПартии(СтрокаПартииДляРаспределения.Партия, СтрокаПартииДляРаспределения.СтрокаПартии, Истина, МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ));
							
							ОтсортироватьПриходы = Истина;	
						
						КонецЕсли;
						
					КонецЦикла;
					
					Если ОтсортироватьПриходы Тогда
					
						Если НастройкиУчетаОбщие.УчитыватьУчетныйАктивПриСписанииПартий Тогда
						    ПриходныеПартии.Сортировать("ПорядокЕПС, Период");
						Иначе
							ПриходныеПартии.Сортировать("Период"); // отсортировать обязательно		
						КонецЕсли;
					
					КонецЕсли;

				КонецЕсли;
				
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПогашениеКупона") Тогда
				
				БылоПогашениеКупонаПоБумагеВЭтомПериоде = Истина;
				
				Если РассчитыватьСтоимости Тогда
					
					ЭтоБанкротПрайм = Ложь;
					Если ДанныеПоЦеннойБумаге.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Эмитент_Прайм")
						И ВыборкаДетальныеЗаписи.Период >= '20190913' Тогда
					
						ЭтоБанкротПрайм = Истина;
					
					КонецЕсли;
					
					// для бумаг по АС берем данные по начальным дисконту/премии из первички (#404807)
					// это связано с тем, что у них комиссия идет в стоимость и требуется точность, большая чем может обеспечить ресурс ДисконтПремияПокупки
					// #436580 - для организации ДК сделано упрощение расчетов
					ИспользоватьПервичныеДанныеДляОпределенияЦеныПриобретения = (ПриходныеПартии.Найти(Истина, "ВключатьРасходыПоПокупкеВСтоимость") <> Неопределено) И НЕ Организация_ДК;
					
					Если ИспользоватьПервичныеДанныеДляОпределенияЦеныПриобретения Тогда
						ДатыИЦеныПокупки = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(ПриходныеПартии, СчетДоверительногоУправленияДляУчета, ВыборкаДетальныеЗаписи.Период).Выгрузить();
					Иначе 
						ДатыИЦеныПокупки = Неопределено;
					КонецЕсли;
					
					// #361945 - по Облигация_ДП_О1ГрФин1P3, Облигация_АрчерФинанс, Облигация_ОткрытиеХолдинг клиенты Будущее(с 11/2/21) и Телеком(с 10/2/21) отключили расчет НКД
					НеНачислятьИНеПогашатьНКД = Ложь;
					Если ЭтоКлиентТелеком И НачалоДня(ВыборкаДетальныеЗаписи.Период) >= '20210210'
						ИЛИ ЭтоКлиентБудущее И НачалоДня(ВыборкаДетальныеЗаписи.Период) >= '20210211' Тогда
						
						Если ВыборкаДетальныеЗаписи.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_АрчерФинанс")
							ИЛИ ВыборкаДетальныеЗаписи.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1_Груп_Финанс") 
							ИЛИ ВыборкаДетальныеЗаписи.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ДП_О1ГрФин1P3") 
							ИЛИ ВыборкаДетальныеЗаписи.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОткрытиеХолдинг") Тогда
							
							НеНачислятьИНеПогашатьНКД = Истина;
							
						КонецЕсли;
					КонецЕсли;
					
					// #584222 - по Облигация_О1Пропертиз_Дол (О1 Пропертиз Финанс АО, 4B02-01-71827-H-001P, 1000.00 USD) клиенты Будущее и Эволюция(с 01/01/25)
					Если ((ЭтоКлиентБудущее ИЛИ ЭтоКлиентЭволюция) И НачалоДня(ВыборкаДетальныеЗаписи.Период) >= '20250101')
						И (ВыборкаДетальныеЗаписи.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1Пропертиз_Дол")) Тогда
						
						НеНачислятьИНеПогашатьНКД = Истина;
						
					КонецЕсли;
					
			        // хардкод для банкротов Открытие, Арчер и Финстойн
			        // с 31.10.2022 не переоцениваем ничего
					НеНачислятьДисконтПремиюКорректировку = Ложь;
				    Если (ВыборкаДетальныеЗаписи.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финстоун") И БанкротствоФинстоунаИАрчераПризнано)
					    ИЛИ (ВыборкаДетальныеЗаписи.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_АрчерФинанс") И БанкротствоФинстоунаИАрчераПризнано)
					    ИЛИ (ВыборкаДетальныеЗаписи.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОткрытиеХолдинг") И БанкротствоОткрытияПризнано)
					    ИЛИ (ВыборкаДетальныеЗаписи.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОткрХолдинг_004") И БанкротствоОткрытияПризнано) Тогда
					   
						 НеНачислятьИНеПогашатьНКД = Истина;
						 НеНачислятьДисконтПремиюКорректировку = Истина;
					 КонецЕсли;
					 
					 
					
					ЭтоВебФинанс210522 = (ВыборкаДетальныеЗаписи.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_VEB_5.942_11/21") И НачалоДня(ВыборкаДетальныеЗаписи.Регистратор.Дата) = '20220521');
					
					КурсПерекурсовки = Неопределено;
					
					ОбщееКоличество = ВыборкаДетальныеЗаписи.Количество;
					СуммаКупонаНаОднуОблигацию = ВыборкаДетальныеЗаписи.СуммаНаОднуОблигацию;
					Если НЕ ДанныеПоЦеннойБумаге.ЭтоВалютнаяБумага Тогда
						СуммаКупонаНаОднуОблигациюВВалютеУчета = СуммаКупонаНаОднуОблигацию;
						ОбщаяСуммаВВалютеУчета = ВыборкаДетальныеЗаписи.Количество * СуммаКупонаНаОднуОблигациюВВалютеУчета;
						ОбщаяСуммаОплатыВВалютеУчета = ОбщаяСуммаВВалютеУчета;
					ИначеЕсли ВыборкаДетальныеЗаписи.ВалютаОплаты = ВалютаУчета Тогда
						// погашение купона по валютной бумаге причем сумма в рублях... маразм, блин!
						СуммаКупонаНаОднуОблигациюВВалютеУчета = СуммаКупонаНаОднуОблигацию;
						СуммаКупонаНаОднуОблигацию = ОпределитьСтоимостьКупонаВМоментАмортизации(ВыборкаДетальныеЗаписи.ЦеннаяБумага, ВыборкаДетальныеЗаписи.Период);
						КурсПерекурсовки = СуммаКупонаНаОднуОблигациюВВалютеУчета / СуммаКупонаНаОднуОблигацию;
						ОбщаяСуммаВВалютеУчета = ВыборкаДетальныеЗаписи.Количество * СуммаКупонаНаОднуОблигациюВВалютеУчета;
						Если ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки <> 0 Тогда // ОбщаяСуммаВВалютеУчета должна в этом случае быть по фиксированному курсу!
							ОбщаяСуммаВВалютеУчета = ВыборкаДетальныеЗаписи.Количество * СуммаКупонаНаОднуОблигацию * ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки;
						КонецЕсли;
						ОбщаяСуммаОплатыВВалютеУчета = ВыборкаДетальныеЗаписи.СуммаНаОднуОблигацию * ВыборкаДетальныеЗаписи.Количество; // оплата приходит не по официальному курсу и не по куурсу клиента, а по какому-то 3му
					Иначе
						СуммаКупонаНаОднуОблигациюВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКупонаНаОднуОблигацию, ВыборкаДетальныеЗаписи.ВалютаОплаты, Организация, ВыборкаДетальныеЗаписи.Период, Отказ);
						//можно из регистра купонов брать, отбор по дате фиксации
						Если ВыборкаДетальныеЗаписи.ВалютаОплаты <> ДанныеПоЦеннойБумаге.ВалютаНоминала Тогда
							СуммаКупонаНаОднуОблигацию = Окр(РаботаСВалютами.ПересчетСуммыВВалюте(
																	СуммаКупонаНаОднуОблигацию,
																	ВыборкаДетальныеЗаписи.ВалютаОплаты,
																	ВыборкаДетальныеЗаписи.ДатаФиксации,
																	ДанныеПоЦеннойБумаге.ВалютаНоминала,
																	ВыборкаДетальныеЗаписи.ДатаФиксации,
																	Отказ),
																6);
						КонецЕсли;
															
						Если Отказ Тогда
							Возврат;
						КонецЕсли;
						
						ОбщаяСуммаВВалютеУчета = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ВыборкаДетальныеЗаписи.Количество * СуммаКупонаНаОднуОблигацию, 
																	ВыборкаДетальныеЗаписи.ВалютаОплаты,
																	Организация, ВыборкаДетальныеЗаписи.Период, Отказ),	2);
																	
						ОбщаяСуммаОплатыВВалютеУчета = ОбщаяСуммаВВалютеУчета;
					КонецЕсли;
					
					// для бумаг, с реструктуризацией платежей по купонам, купон гасится не весь
					// остается часть купона
					// например у Облигация_ТМ-энергоФинанс в 20190925 купон не гасили, а просто разбили на куски по 15,7 на 6 будущих периодов
					// и на конец дня купон будет ненулевой, поэтому дооценивать нужно до РасчетныйКупонНаНачалоДня
					// для обычных бумаг он (РасчетныйКупонНаКонецДня) все равно будет поэтому этот код будет работать для всех
					ОблигацияСРеструктуризациейПлатежей = Ложь;
					ПроизводитьНачислениеПроцентныхПоказателей = Истина;
					
					РасчетныйКупонНаКонецДня = Справочники.Облигации.ПолучитьКупон(ВыборкаДетальныеЗаписи.ЦеннаяБумага, НачалоДня(ВыборкаДетальныеЗаписи.Период), СчетДоверительногоУправленияДляУчета);
					Если РасчетныйКупонНаКонецДня <> 0 Тогда // пока такой критерий - лучше не придумал
						ОблигацияСРеструктуризациейПлатежей = Истина;	
					КонецЕсли;
					
					Если ОблигацияСРеструктуризациейПлатежей Тогда 
						
						// дооценивать будем до этого значения
						РасчетныйКупонНаНачалоДня = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(ВыборкаДетальныеЗаписи.ЦеннаяБумага, НачалоДня(ВыборкаДетальныеЗаписи.Период), СчетДоверительногоУправления, Истина);
						Если НЕ ДанныеПоЦеннойБумаге.ЭтоВалютнаяБумага Тогда
							РасчетныйКупонНаНачалоДняВВалютеУчета = РасчетныйКупонНаНачалоДня;
						Иначе	
						    РасчетныйКупонНаНачалоДняВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(РасчетныйКупонНаНачалоДня, ВыборкаДетальныеЗаписи.ВалютаОплаты, Организация, ВыборкаДетальныеЗаписи.Период, Отказ);
						КонецЕсли;
						
						// Возможно 2 варианта:
						//	1. И сумму реструктуризации и сумму этого периода запихали в одно погашение - нормас, по нему и доначислим купон до полной суммы перед погашением
						//  2. Сделали 2 разных погашения: одно на рекструктурируемую сумму, 2ое на тек. период  - тогда по первому погашению начислим, а по 2му не будем
						//  из-за п.2 делаем триггер о том, что уже начисляли
						Если ДанныеПоЦеннойБумаге.ПроводилиНачислениеПоЭтойОблигацияСРеструктуризациейПлатежей Тогда 
							ПроизводитьНачислениеПроцентныхПоказателей = Ложь;
						Иначе
							ДанныеПоЦеннойБумаге.ПроводилиНачислениеПоЭтойОблигацияСРеструктуризациейПлатежей = Истина;
						КонецЕсли;
					
					КонецЕсли;
					
					Если ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки <> 0 И НЕ ЭтоВебФинанс210522 Тогда
					
						КурсНачисленияКупона = ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки;
						
					ИначеЕсли КурсПерекурсовки <> Неопределено Тогда
						
						КурсНачисленияКупона = КурсПерекурсовки;
						
					Иначе
						
						КурсНачисленияКупона = 0;
					
					КонецЕсли;
					
					ТребуетсяУчетПогрешностиОкругленияРублевыхСумм = НастройкиПоВидуУчета.УчитыватьПогрешностьОкругленияНаПартияхВВалютеУчета И ДанныеПоЦеннойБумаге.ЭтоВалютнаяБумага И ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки = 0 И ВыборкаДетальныеЗаписи.Период > '20240101';
					МассивДвиженийНачисления = ?(ТребуетсяУчетПогрешностиОкругленияРублевыхСумм, Новый Массив(), Неопределено);

					Если ДанныеПоЦеннойБумаге.ЭтоВалютнаяБумага Тогда
						КурсВалютыИзменился = КурсВалютыИзменился(ИзмененияКурсовВалют, ДанныеПоЦеннойБумаге.ВалютаНоминала, НачалоДня(ВыборкаДетальныеЗаписи.Период));
					Иначе
						КурсВалютыИзменился = Ложь;
					КонецЕсли;
					
					//Для всех приходных партий:
					// 1. Дооценим купон
					// 2. Начислим дисконт/премию
					// 3. Начислим корректировку по ЭСП
					// 4. Спишем купон
					// 5. Если клиент отражает задолженность на счетах учета - добавим начисление задолженности по погашению купона
					Для Каждого СтрокаПриходныхПартий Из ПриходныеПартии Цикл
						
						НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
							НастройкиУчетаОбщие,
							СтрокаПриходныхПартий.ЦеннаяБумага,
							СтрокаПриходныхПартий.УчетныйАктивЕПС,
							СтрокаПриходныхПартий.Партия,
							СтрокаПриходныхПартий.СтрокаПартии);
						
						Если НЕ ЭтоБанкротПрайм И ПроизводитьНачислениеПроцентныхПоказателей Тогда
							
							Если (ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки = 0 ИЛИ ЭтоВебФинанс210522) И КурсВалютыИзменился Тогда
							
								НовоеДвижение = Перекурсовка(ВыборкаДетальныеЗаписи.Регистратор, ЭтотОбъект.РассчитанныеПартии, ВыборкаДетальныеЗаписи.Период, СтрокаПриходныхПартий, СтрокаПриходныхПартий.Количество, ВыборкаДетальныеЗаписи.СтрокаПартии, КурсПерекурсовки,, Новый Структура("ЭтоВебФинанс210522", ЭтоВебФинанс210522), Отказ);
								
								Если НастройкиУчетаОбщие.ОтражатьДоходыРасходыОтПерекурсовкиПереоценкиКакПереоценку
									И СтрокаПриходныхПартий.УчетныйАктивЕПС.Родитель = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи Тогда
								
									НовоеДвижение.ПереоценкаСНачалаГода = НовоеДвижение.ПереоценкаВВалютеУчета;
								
								КонецЕсли;
								
								Если Отказ Тогда
									Возврат;
								КонецЕсли;
								
							КонецЕсли;
							
							// 1. Дооценим купон
							ДоначислятьКупонДоСуммы = СуммаКупонаНаОднуОблигацию;
							Если ОблигацияСРеструктуризациейПлатежей Тогда
								ДоначислятьКупонДоСуммы = РасчетныйКупонНаНачалоДня;
							КонецЕсли;
							
							НовоеДвижение = ДоначислитьКупон(ВыборкаДетальныеЗаписи.Регистратор, 
																	ВыборкаДетальныеЗаписи.Период, 
																	СтрокаПриходныхПартий,
																	ДоначислятьКупонДоСуммы,
																	СтрокаПриходныхПартий.Количество,
																	КурсНачисленияКупона,
																	0,
																	Ложь,
																	Отказ);
							
							Если ТребуетсяУчетПогрешностиОкругленияРублевыхСумм Тогда
								МассивДвиженийНачисления.Добавить(НовоеДвижение);
							КонецЕсли; 
							
							Если Отказ Тогда
								Возврат;
							КонецЕсли;
							
							Если НеНачислятьИНеПогашатьНКД Тогда
							
								НовоеДвижение.ПереоценкаКупона = 0;
								НовоеДвижение.ПереоценкаКупонаВВалютеУчета = 0;
							
							КонецЕсли;
							
							СтрокаПриходныхПартий.ПереоценкаКупона = СтрокаПриходныхПартий.ПереоценкаКупона + НовоеДвижение.ПереоценкаКупона;
							СтрокаПриходныхПартий.ПереоценкаКупонаВВалютеУчета = СтрокаПриходныхПартий.ПереоценкаКупонаВВалютеУчета + НовоеДвижение.ПереоценкаКупонаВВалютеУчета;
																	
							// 2. Начислим дисконт/премию
							ДатаПокупки	= СтрокаПриходныхПартий.ДатаПокупки;
							ДатаПокупкиНачальная = СтрокаПриходныхПартий.ДатаПокупкиНачальная;
							КорректировкаЭСПНачальная = СтрокаПриходныхПартий.КорректировкаЭСПНачальная;
							ЦенаПокупкиНачальная = СтрокаПриходныхПартий.СтоимостьПокупкиНачальная / СтрокаПриходныхПартий.Количество;
							
							Если ДатыИЦеныПокупки = Неопределено Тогда
								
								НачальныйДисконт  = Окр(СтрокаПриходныхПартий.ДисконтПремияПокупки / СтрокаПриходныхПартий.Количество, РазрядностьДробнойЧасти);
								
								Если ДанныеПоЦеннойБумаге.Амортизационная ИЛИ ДанныеПоЦеннойБумаге.ИндексируемыйНоминал Тогда
									ЦенаПокупки	= Справочники.Облигации.ПолучитьНоминал(СтрокаПриходныхПартий.ЦеннаяБумага, ДатаПокупки) + НачальныйДисконт;
								Иначе
									ЦенаПокупки	= СтрокаПриходныхПартий.Номинал + НачальныйДисконт;
								КонецЕсли;
								ЦенаПокупкиКупона	= Окр(СтрокаПриходныхПартий.СтоимостьПокупкиКупона / СтрокаПриходныхПартий.Количество, РазрядностьДробнойЧасти);
								
							Иначе
								
								ДатаИЦенаПокупки = ДатыИЦеныПокупки.НайтиСтроки(Новый Структура("НомерСтроки", СтрокаПриходныхПартий.НомерСтроки));
								
								НачальныйДисконт 	= ДатаИЦенаПокупки[0].НачальныйДисконт;
								ЦенаПокупки 		= ДатаИЦенаПокупки[0].ЦенаПокупки;
								ЦенаПокупкиКупона 	= ДатаИЦенаПокупки[0].ЦенаКупона;
								
							КонецЕсли;
							
							ДанныеПереоценки = Новый Структура("Количество, УчетныйАктивЕПС, Партия, СтрокаПартии");
							ЗаполнитьЗначенияСвойств(ДанныеПереоценки, СтрокаПриходныхПартий, "Количество, УчетныйАктивЕПС, Партия, СтрокаПартии");
							ДанныеПереоценки.Вставить("ДатаПереоценки", НачалоДня(ВыборкаДетальныеЗаписи.Период));
							ДанныеПереоценки.Вставить("ОценочнаяСуммаКупона", 0);
							ДанныеПереоценки.Вставить("БалансовыйДисконт", СтрокаПриходныхПартий.ДисконтПремияНачисленный);
							ДанныеПереоценки.Вставить("БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные);
							ДанныеПереоценки.Вставить("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
							ДанныеПереоценки.Вставить("Стоимость", СтрокаПриходныхПартий.Стоимость);
							
							ДанныеПокупки = Новый Структура;
							ДанныеПокупки.Вставить("НачальныйДисконт", НачальныйДисконт);
							ДанныеПокупки.Вставить("ДатаПокупки", ДатаПокупки);
							ДанныеПокупки.Вставить("ДатаПокупкиНачальная", ДатаПокупкиНачальная);
							ДанныеПокупки.Вставить("КорректировкаЭСПНачальная", КорректировкаЭСПНачальная);
							ДанныеПокупки.Вставить("ЦенаПокупки", ЦенаПокупки);
							ДанныеПокупки.Вставить("НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная / СтрокаПриходныхПартий.Количество);
							ДанныеПокупки.Вставить("ЦенаПокупкиКупона", ЦенаПокупкиКупона);
							ДанныеПокупки.Вставить("ЦенаПокупкиНачальная", ЦенаПокупкиНачальная);

							ДисконтИКорректировкаЭСП = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремииИКорректировкуПоЭСПИРазницуПервоначальногоПризнания(СтрокаПриходныхПартий.ЦеннаяБумага, ДанныеПереоценки, ДанныеПокупки, НастройкиУчетаЦеннойБумаги, Отказ);
																										
							Если ДисконтИКорректировкаЭСП = Неопределено Тогда
								Возврат;
							КонецЕсли;
							
							Если ЭтоКлиентЮгория ИЛИ (НачальныйДисконт > 0 И СтрокаПриходныхПартий.ДисконтПремияНачисленный < ДисконтИКорректировкаЭСП.ОценочныеДисконтПремия) ИЛИ НеНачислятьДисконтПремиюКорректировку Тогда 
							    //Купили с премией, а новая премия вдруг оказалась больше
								НовоеДвижение.ДисконтПремияНачисленный = 0; // ничего не делаем
								НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета = 0; // ничего не делаем
							Иначе
								
								НовоеДвижение.ДисконтПремияНачисленный = ДисконтИКорректировкаЭСП.ОценочныеДисконтПремия - СтрокаПриходныхПартий.ДисконтПремияНачисленный;
								
								Для каждого СтрокаСписанияДисконтов Из СписанияДисконтов Цикл
								
									Если СтрокаСписанияДисконтов.Дата = НачалоДня(ВыборкаДетальныеЗаписи.Период) // в этот же день
										 И СтрокаСписанияДисконтов.Партия = СтрокаПриходныхПартий.Партия Тогда   // по этой же партии
									
										НовоеДвижение.ДисконтПремияНачисленный = НовоеДвижение.ДисконтПремияНачисленный - СтрокаСписанияДисконтов.Сумма;
									
									КонецЕсли;
								
								КонецЦикла;
								
								СтрокаПриходныхПартий.ДисконтПремияНачисленный = ДисконтИКорректировкаЭСП.ОценочныеДисконтПремия;
								
								КурсНачисленияДисконтаПремии = Неопределено; // по умолчанию курс - текущий
								Если УчитыватьВсеЧастиСтоимостиПоФиксированномуКурсу И ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки <> 0 Тогда
									КурсНачисленияДисконтаПремии = ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки; // если есть то будет он, если нет, то будет неопределено и возьмется текущий
								КонецЕсли;
								
								СуммыВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
										Новый Структура("СуммаДвижение, СуммаОстаток", НовоеДвижение.ДисконтПремияНачисленный, СтрокаПриходныхПартий.ДисконтПремияНачисленный), 
										ДанныеПоЦеннойБумаге.ВалютаНоминала,
										ЭтотОбъект.Организация,
										ВыборкаДетальныеЗаписи.Период,
										КурсНачисленияДисконтаПремии,
										Отказ);
										
								ОстатокДисконтПремияНачисленныйВВалютеУчета = Окр(СуммыВВалютеУчета.СуммаОстаток, 2);
										
								НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета = ОстатокДисконтПремияНачисленныйВВалютеУчета - СтрокаПриходныхПартий.ДисконтПремияНачисленныйВВалютеУчета;
								СтрокаПриходныхПартий.ДисконтПремияНачисленныйВВалютеУчета = ОстатокДисконтПремияНачисленныйВВалютеУчета;
								
							КонецЕсли;
							
							// 3. Начислим корректировку по ЭСП
							Если НастройкиДляУчетаКорректировкиЭСП.Найти(НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода) <> Неопределено И НЕ ЭтоКлиентЮгория И НЕ НеНачислятьДисконтПремиюКорректировку Тогда
								
								КурсНачисленияКорректировкиЭСП = Неопределено; // по умолчанию курс - текущий
								Если УчитыватьВсеЧастиСтоимостиПоФиксированномуКурсу И ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки <> 0 Тогда
									КурсНачисленияКорректировкиЭСП = ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки; // если есть то будет он, если нет, то будет неопределено и возьмется текущий
								КонецЕсли;
								
								ОценочнаяКорректировкаЭСПВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
																										Новый Структура("Сумма", ДисконтИКорректировкаЭСП.ОценочнаяКорректировкаЭСП), 
																										ДанныеПоЦеннойБумаге.ВалютаНоминала,
																										ЭтотОбъект.Организация,
																										ВыборкаДетальныеЗаписи.Период,
																										КурсНачисленияКорректировкиЭСП,
																									Отказ).Сумма;

								НовоеДвижение.КорректировкаЭСП = ДисконтИКорректировкаЭСП.ОценочнаяКорректировкаЭСП - СтрокаПриходныхПартий.КорректировкаЭСП;
								НовоеДвижение.КорректировкаЭСПВВалютеУчета = ОценочнаяКорректировкаЭСПВВалютеУчета - СтрокаПриходныхПартий.КорректировкаЭСПВВалютеУчета;
								
								СтрокаПриходныхПартий.КорректировкаЭСП = ДисконтИКорректировкаЭСП.ОценочнаяКорректировкаЭСП;
								СтрокаПриходныхПартий.КорректировкаЭСПВВалютеУчета = ОценочнаяКорректировкаЭСПВВалютеУчета;
								
							КонецЕсли;
							
							НовоеДвижение.ПереоценкаКупонаСНачалаГода = НовоеДвижение.ПереоценкаКупонаВВалютеУчета;
							НовоеДвижение.КорректировкаЭСПСНачалаГода = НовоеДвижение.КорректировкаЭСПВВалютеУчета;
							НовоеДвижение.ДисконтПремияНачисленныйСНачалаГода = НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета;
							
							СтрокаПриходныхПартий.ПереоценкаКупонаСНачалаГода = СтрокаПриходныхПартий.ПереоценкаКупонаСНачалаГода + НовоеДвижение.ПереоценкаКупонаСНачалаГода;
							СтрокаПриходныхПартий.КорректировкаЭСПСНачалаГода = СтрокаПриходныхПартий.КорректировкаЭСПСНачалаГода + НовоеДвижение.КорректировкаЭСПСНачалаГода; 
							СтрокаПриходныхПартий.ДисконтПремияНачисленныйСНачалаГода = СтрокаПриходныхПартий.ДисконтПремияНачисленныйСНачалаГода + НовоеДвижение.ДисконтПремияНачисленныйСНачалаГода;
							
						КонецЕсли;
							
						// 4. Спишем купон
						
						// Хардкод в этот день по этим бумагам купон не списываем
						Если (СтрокаПриходныхПартий.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_БизнесКонсалтиг")
							ИЛИ СтрокаПриходныхПартий.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_БКЗ_ФИНАНС")
							ИЛИ СтрокаПриходныхПартий.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ТМ-энергоФинанс"))
							И НачалоДня(ВыборкаДетальныеЗаписи.Период) = '20190925' Тогда
						
							Продолжить;
						
						КонецЕсли;
						
						Если НеНачислятьИНеПогашатьНКД Тогда
							Продолжить;
						КонецЕсли;
						
						НовоеДвижениеСписания = ЭтотОбъект.РассчитанныеПартии.Добавить();
						//НовоеДвижениеСписания.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.СписаниеКупона;
						
						НовоеДвижениеСписания.ЦеннаяБумага 		= СтрокаПриходныхПартий.ЦеннаяБумага;
						НовоеДвижениеСписания.УчетныйАктивЕПС 	= СтрокаПриходныхПартий.УчетныйАктивЕПС;
						НовоеДвижениеСписания.Партия	 		= СтрокаПриходныхПартий.Партия;
						НовоеДвижениеСписания.СтрокаПартии 		= СтрокаПриходныхПартий.СтрокаПартии;
						НовоеДвижениеСписания.Рынок 			= СтрокаПриходныхПартий.Рынок;
						
						НовоеДвижениеСписания.ВидДвижения = Перечисления.ВидыДвижений.Расход;
						НовоеДвижениеСписания.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
						НовоеДвижениеСписания.Период 	  = ВыборкаДетальныеЗаписи.Период;
						
						НовоеДвижениеСписания.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
						
						НовоеДвижениеСписания.ПереоценкаКупона = СтрокаПриходныхПартий.ПереоценкаКупона;
						НовоеДвижениеСписания.ПереоценкаКупонаВВалютеУчета = СтрокаПриходныхПартий.ПереоценкаКупонаВВалютеУчета;
						НовоеДвижениеСписания.ПереоценкаКупонаВСтоимости = СтрокаПриходныхПартий.ПереоценкаКупонаВСтоимости;
						НовоеДвижениеСписания.СтоимостьКупона = СтрокаПриходныхПартий.СтоимостьКупона;
						НовоеДвижениеСписания.СтоимостьКупонаВВалютеУчета = СтрокаПриходныхПартий.СтоимостьКупонаВВалютеУчета;
						
						НовоеДвижениеСписания.ПереоценкаКупонаСНачалаГода = СтрокаПриходныхПартий.ПереоценкаКупонаСНачалаГода;
						
						// для бумаг, с реструктуризацией платежей по купонам, купон гасится не весь
						// остается часть купона
						Если ОблигацияСРеструктуризациейПлатежей Тогда
							
							НовоеДвижениеСписания.ПереоценкаКупона =  СтрокаПриходныхПартий.Количество * СуммаКупонаНаОднуОблигацию - СтрокаПриходныхПартий.СтоимостьКупона;
							НовоеДвижениеСписания.ПереоценкаКупонаВВалютеУчета = СтрокаПриходныхПартий.Количество * СуммаКупонаНаОднуОблигацию - СтрокаПриходныхПартий.СтоимостьКупона;
							
							СтрокаПриходныхПартий.ПереоценкаКупона				= СтрокаПриходныхПартий.ПереоценкаКупона				- НовоеДвижениеСписания.ПереоценкаКупона				- НовоеДвижениеСписания.СтоимостьКупона;
							СтрокаПриходныхПартий.ПереоценкаКупонаВВалютеУчета	= СтрокаПриходныхПартий.ПереоценкаКупонаВВалютеУчета	- НовоеДвижениеСписания.ПереоценкаКупонаВВалютеУчета	- НовоеДвижениеСписания.СтоимостьКупонаВВалютеУчета;
							
						Иначе
							
							СтрокаПриходныхПартий.ПереоценкаКупона = 0;
							СтрокаПриходныхПартий.ПереоценкаКупонаВВалютеУчета = 0;
						
						КонецЕсли;
						
						СтрокаПриходныхПартий.ПереоценкаКупонаВСтоимости = 0;
						СтрокаПриходныхПартий.СтоимостьКупона = 0;
						СтрокаПриходныхПартий.СтоимостьКупонаВВалютеУчета = 0;
						СтрокаПриходныхПартий.ПереоценкаКупонаСНачалаГода = 0;
						
						СуммаОплатыВВалютеУчета = Окр(ОбщаяСуммаОплатыВВалютеУчета * СтрокаПриходныхПартий.Количество / ОбщееКоличество, 2);
						ОбщаяСуммаОплатыВВалютеУчета = ОбщаяСуммаОплатыВВалютеУчета - СуммаОплатыВВалютеУчета;
						
						ОбщаяСуммаВВалютеУчета = ОбщаяСуммаВВалютеУчета - (НовоеДвижениеСписания.СтоимостьКупонаВВалютеУчета + НовоеДвижениеСписания.ПереоценкаКупонаВВалютеУчета);
						ОбщееКоличество = ОбщееКоличество - СтрокаПриходныхПартий.Количество;
						Если НастройкиПоВидуУчета.УчитыватьПогрешностьОкругленияНаПартияхВВалютеУчета И ОбщееКоличество = 0 И ОбщаяСуммаВВалютеУчета <> 0 Тогда // ситуация когда накописась копейка(и) по рублевым суммам - отправим их на последнюю строку т.к. никакой разницы нет
						
							НовоеДвижение.ПереоценкаКупонаВВалютеУчета = НовоеДвижение.ПереоценкаКупонаВВалютеУчета + ОбщаяСуммаВВалютеУчета;
							НовоеДвижениеСписания.ПереоценкаКупонаВВалютеУчета = НовоеДвижениеСписания.ПереоценкаКупонаВВалютеУчета + ОбщаяСуммаВВалютеУчета;

							НовоеДвижение.ПереоценкаКупонаСНачалаГода = НовоеДвижение.ПереоценкаКупонаСНачалаГода + ОбщаяСуммаВВалютеУчета;
							НовоеДвижениеСписания.ПереоценкаКупонаСНачалаГода = НовоеДвижениеСписания.ПереоценкаКупонаСНачалаГода + ОбщаяСуммаВВалютеУчета;
							
						КонецЕсли;
						
						Если ОбщееКоличество = 0 И ОбщаяСуммаОплатыВВалютеУчета <> 0 Тогда
						
							СуммаОплатыВВалютеУчета = СуммаОплатыВВалютеУчета + ОбщаяСуммаОплатыВВалютеУчета;
							ОбщаяСуммаОплатыВВалютеУчета = 0;
						
						КонецЕсли;
						
						// 5. Если клиент отражает задолженность на счетах учета - добавим начисление задолженности по погашению купона
						Если НастройкиУчетаОбщие.ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
						
							НовоеДвижениеНачисленияЗадолженности = ЭтотОбъект.РассчитанныеПартии.Добавить();
							//НовоеДвижениеНачисленияЗадолженности.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.НачислениеЗадолженности;
							
							ЗаполнитьЗначенияСвойств(НовоеДвижениеНачисленияЗадолженности, НовоеДвижениеСписания, );
							
							НовоеДвижениеНачисленияЗадолженности.ВидДвижения = Перечисления.ВидыДвижений.Приход;
							
							НовоеДвижениеНачисленияЗадолженности.ЗадолженностьПоПогашениюКупона = НовоеДвижениеСписания.СтоимостьКупона + НовоеДвижениеСписания.ПереоценкаКупона;
							НовоеДвижениеНачисленияЗадолженности.ЗадолженностьПоПогашениюКупонаВВалютеУчета = СуммаОплатыВВалютеУчета;
							
							НовоеДвижениеНачисленияЗадолженности.СтоимостьКупона = 0;
							НовоеДвижениеНачисленияЗадолженности.СтоимостьКупонаВВалютеУчета = 0;
							НовоеДвижениеНачисленияЗадолженности.ПереоценкаКупона = 0;
							НовоеДвижениеНачисленияЗадолженности.ПереоценкаКупонаВВалютеУчета = 0;
							НовоеДвижениеНачисленияЗадолженности.ПереоценкаКупонаСНачалаГода = 0;
							
							СтрокаПриходныхПартий.ЗадолженностьПоПогашениюКупона = НовоеДвижениеНачисленияЗадолженности.ЗадолженностьПоПогашениюКупона;
							СтрокаПриходныхПартий.ЗадолженностьПоПогашениюКупонаВВалютеУчета = НовоеДвижениеНачисленияЗадолженности.ЗадолженностьПоПогашениюКупонаВВалютеУчета;
						
						КонецЕсли;
						
					КонецЦикла;
					
					Если ТребуетсяУчетПогрешностиОкругленияРублевыхСумм И НЕ ЭтоКлиентЮгория Тогда
						УчестьПогрешностиРублевыхСумм(ВыборкаДетальныеЗаписи.Период, КурсПерекурсовки, ПриходныеПартии, МассивДвиженийНачисления, Отказ);
					КонецЕсли;
					
					// нужно списывать купон также по партиям, купленым по РЕПО
					Для каждого СтрокаПриходныхПартийКупленныхпоРЕПО Из ПартииКупленныеПоРЕПО Цикл
						
						Если СтрокаПриходныхПартийКупленныхпоРЕПО.ЦеннаяБумага <> ВыборкаДетальныеЗаписи.ЦеннаяБумага Тогда
							Продолжить;
						КонецЕсли;
						
						Если НастройкиУчетаОбщие.ДействияПриПогашенииКупонаНаСчетахГлавыГ <> "НеНачислять_И_НеСписывать" Тогда
							// 1. Дооценим купон
							НовоеДвижениеНачисления = ДоначислитьКупонРЕПО(ВыборкаДетальныеЗаписи.Регистратор, 
																	ВыборкаДетальныеЗаписи.Период,
																	ЭтотОбъект.РассчитанныеПартииОбратноеРЕПО,
																	СтрокаПриходныхПартийКупленныхпоРЕПО,
																	СуммаКупонаНаОднуОблигацию,
																	СтрокаПриходныхПартийКупленныхпоРЕПО.Количество,
																	0,
																	Отказ);
																	
							СтрокаПриходныхПартийКупленныхпоРЕПО.ПереоценкаКупона = СтрокаПриходныхПартийКупленныхпоРЕПО.ПереоценкаКупона + НовоеДвижениеНачисления.ПереоценкаКупона;
							СтрокаПриходныхПартийКупленныхпоРЕПО.ПереоценкаКупонаВВалютеУчета = СтрокаПриходныхПартийКупленныхпоРЕПО.ПереоценкаКупонаВВалютеУчета + НовоеДвижениеНачисления.ПереоценкаКупонаВВалютеУчета;
																	
							// 2. Спишем купон
							НовоеДвижение = ЭтотОбъект.РассчитанныеПартииОбратноеРЕПО.Добавить();
							
							НовоеДвижение.ЦеннаяБумага 		= СтрокаПриходныхПартийКупленныхпоРЕПО.ЦеннаяБумага;
							НовоеДвижение.Партия	 		= СтрокаПриходныхПартийКупленныхпоРЕПО.Партия;
							НовоеДвижение.СтрокаПартии 		= СтрокаПриходныхПартийКупленныхпоРЕПО.СтрокаПартии;
							НовоеДвижение.Рынок 			= СтрокаПриходныхПартийКупленныхпоРЕПО.Рынок;
							
							НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Расход;
							НовоеДвижение.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
							НовоеДвижение.Период 	  = ВыборкаДетальныеЗаписи.Период;
							
							НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
							
							НовоеДвижение.ПереоценкаКупона				= СтрокаПриходныхПартийКупленныхпоРЕПО.ПереоценкаКупона;
							НовоеДвижение.ПереоценкаКупонаВВалютеУчета	= СтрокаПриходныхПартийКупленныхпоРЕПО.ПереоценкаКупонаВВалютеУчета;
							НовоеДвижение.СтоимостьКупона				= СтрокаПриходныхПартийКупленныхпоРЕПО.СтоимостьКупона;
							НовоеДвижение.СтоимостьКупонаВВалютеУчета	= СтрокаПриходныхПартийКупленныхпоРЕПО.СтоимостьКупонаВВалютеУчета;
							НовоеДвижение.ПереоценкаКупонаСНачалаГода	= СтрокаПриходныхПартийКупленныхпоРЕПО.ПереоценкаКупонаСНачалаГода;
							
							СтрокаПриходныхПартийКупленныхпоРЕПО.ПереоценкаКупона = 0;
							СтрокаПриходныхПартийКупленныхпоРЕПО.ПереоценкаКупонаВВалютеУчета = 0;
							СтрокаПриходныхПартийКупленныхпоРЕПО.СтоимостьКупона = 0;
							СтрокаПриходныхПартийКупленныхпоРЕПО.СтоимостьКупонаВВалютеУчета = 0;
							СтрокаПриходныхПартийКупленныхпоРЕПО.ПереоценкаКупонаСНачалаГода = 0;

						КонецЕсли;
							
					КонецЦикла;
					
					//Для всех партий, проданных в РЕПО:
					// 1. Дооценим купон
					// 2. Начислим дисконт/премию
					// 3. Начислим корректировку по ЭСП
					// 4. Спишем купон
					// 5. Если клиент отражает задолженность на счетах учета - добавим начисление задолженности по погашению купона
					Для Каждого СтрокаПартийПроданныхВРЕПО Из ПартииПроданныеВРЕПО Цикл
						
						Если СтрокаПартийПроданныхВРЕПО.ЦеннаяБумага <> ВыборкаДетальныеЗаписи.ЦеннаяБумага Тогда
							Продолжить;
						КонецЕсли;
						
						
						Если ДанныеПоЦеннойБумаге.ЭтоВалютнаяБумага И КурсВалютыИзменился Тогда
						
							НовоеДвижение = Перекурсовка(
								ВыборкаДетальныеЗаписи.Регистратор, 
								ЭтотОбъект.РассчитанныеПартииПрямоеРЕПО, 
								ВыборкаДетальныеЗаписи.Период, 
								СтрокаПартийПроданныхВРЕПО, 
								СтрокаПартийПроданныхВРЕПО.Количество, 
								ВыборкаДетальныеЗаписи.СтрокаПартии, 
								КурсПерекурсовки,
								,
								,
								Отказ);
							
							Если Отказ Тогда
								Возврат;
							КонецЕсли;
							
						КонецЕсли;
						
						// 1. Дооценим купон
						ДоначислятьКупонДоСуммы = СуммаКупонаНаОднуОблигацию;
						
						НовоеДвижение = ДоначислитьКупонРЕПО(
							ВыборкаДетальныеЗаписи.Регистратор, 
							ВыборкаДетальныеЗаписи.Период,
							ЭтотОбъект.РассчитанныеПартииПрямоеРЕПО,
							СтрокаПартийПроданныхВРЕПО,
							ДоначислятьКупонДоСуммы,
							СтрокаПартийПроданныхВРЕПО.Количество,
							0,
							Отказ);
						
						Если Отказ Тогда
							Возврат;
						КонецЕсли;
						
						СтрокаПартийПроданныхВРЕПО.ПереоценкаКупона = СтрокаПартийПроданныхВРЕПО.ПереоценкаКупона + НовоеДвижение.ПереоценкаКупона;
						СтрокаПартийПроданныхВРЕПО.ПереоценкаКупонаВВалютеУчета = СтрокаПартийПроданныхВРЕПО.ПереоценкаКупонаВВалютеУчета + НовоеДвижение.ПереоценкаКупонаВВалютеУчета;
																
						// 2. Начислим дисконт/премию
						ДатаПокупки	= СтрокаПартийПроданныхВРЕПО.ДатаПокупки;
						ДатаПокупкиНачальная = СтрокаПартийПроданныхВРЕПО.ДатаПокупкиНачальная;
						КорректировкаЭСПНачальная = СтрокаПартийПроданныхВРЕПО.КорректировкаЭСПНачальная;
						ЦенаПокупкиНачальная = СтрокаПартийПроданныхВРЕПО.СтоимостьПокупкиНачальная / СтрокаПартийПроданныхВРЕПО.Количество;
						
						НачальныйДисконт  = Окр(СтрокаПартийПроданныхВРЕПО.ДисконтПремияПокупки / СтрокаПартийПроданныхВРЕПО.Количество, РазрядностьДробнойЧасти);
						
						Если ДанныеПоЦеннойБумаге.Амортизационная ИЛИ ДанныеПоЦеннойБумаге.ИндексируемыйНоминал Тогда
							ЦенаПокупки	= Справочники.Облигации.ПолучитьНоминал(СтрокаПартийПроданныхВРЕПО.ЦеннаяБумага, ДатаПокупки) + НачальныйДисконт;
						Иначе
							ЦенаПокупки	= СтрокаПартийПроданныхВРЕПО.Номинал + НачальныйДисконт;
						КонецЕсли;
						ЦенаПокупкиКупона	= Окр(СтрокаПартийПроданныхВРЕПО.СтоимостьПокупкиКупона / СтрокаПартийПроданныхВРЕПО.Количество, РазрядностьДробнойЧасти);
							
						ДанныеПереоценки = Новый Структура("Количество, УчетныйАктивЕПС, Партия, СтрокаПартии");
						ЗаполнитьЗначенияСвойств(ДанныеПереоценки, СтрокаПартийПроданныхВРЕПО, "Количество, УчетныйАктивЕПС, Партия, СтрокаПартии");
						ДанныеПереоценки.Вставить("ДатаПереоценки", НачалоДня(ВыборкаДетальныеЗаписи.Период));
						ДанныеПереоценки.Вставить("ОценочнаяСуммаКупона", 0);
						ДанныеПереоценки.Вставить("БалансовыйДисконт", СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленный);
						ДанныеПереоценки.Вставить("БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", СтрокаПартийПроданныхВРЕПО.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные);
						ДанныеПереоценки.Вставить("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
						ДанныеПереоценки.Вставить("Стоимость", СтрокаПартийПроданныхВРЕПО.Стоимость);
						
						ДанныеПокупки = Новый Структура;
						ДанныеПокупки.Вставить("НачальныйДисконт", НачальныйДисконт);
						ДанныеПокупки.Вставить("ДатаПокупки", ДатаПокупки);
						ДанныеПокупки.Вставить("ДатаПокупкиНачальная", ДатаПокупкиНачальная);
						ДанныеПокупки.Вставить("КорректировкаЭСПНачальная", КорректировкаЭСПНачальная);
						ДанныеПокупки.Вставить("ЦенаПокупки", ЦенаПокупки);
						ДанныеПокупки.Вставить("НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", СтрокаПартийПроданныхВРЕПО.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная / СтрокаПартийПроданныхВРЕПО.Количество);
						ДанныеПокупки.Вставить("ЦенаПокупкиКупона", ЦенаПокупкиКупона);
						ДанныеПокупки.Вставить("ЦенаПокупкиНачальная", ЦенаПокупкиНачальная);

						ДисконтИКорректировкаЭСП = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремииИКорректировкуПоЭСПИРазницуПервоначальногоПризнания(СтрокаПартийПроданныхВРЕПО.ЦеннаяБумага, ДанныеПереоценки, ДанныеПокупки, НастройкиУчетаЦеннойБумаги, Отказ);
																									
						Если ДисконтИКорректировкаЭСП = Неопределено Тогда
							Возврат;
						КонецЕсли;
						
						НовоеДвижение.ДисконтПремияНачисленный = ДисконтИКорректировкаЭСП.ОценочныеДисконтПремия - СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленный;
						
						Если ДанныеПоЦеннойБумаге.ЭтоВалютнаяБумага Тогда
							ОстатокДисконтПремияНачисленныйВВалютеУчета = Окр(РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
								Новый Структура("СуммаОстаток", СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленный), 
								ДанныеПоЦеннойБумаге.ВалютаНоминала,
								ЭтотОбъект.Организация,
								ВыборкаДетальныеЗаписи.Период,
								,
								Отказ).СуммаОстаток, 2);
						Иначе
							ОстатокДисконтПремияНачисленныйВВалютеУчета = СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленный; 
						КонецЕсли;
								
						НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета = ОстатокДисконтПремияНачисленныйВВалютеУчета - СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленныйВВалютеУчета;
						
						Если НачальныйДисконт > 0 И СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленный < ДисконтИКорректировкаЭСП.ОценочныеДисконтПремия Тогда
						    //Купили с премией, а новая премия вдруг оказалась больше
							НовоеДвижение.ДисконтПремияНачисленный = 0; // ничего не делаем
							НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета = 0; // ничего не делаем
						КонецЕсли;

						СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленный = ДисконтИКорректировкаЭСП.ОценочныеДисконтПремия;
						СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленныйВВалютеУчета = ОстатокДисконтПремияНачисленныйВВалютеУчета;
						
						// 3. Начислим корректировку по ЭСП
						Если НастройкиДляУчетаКорректировкиЭСП.Найти(НастройкиУчетаОбщие.ВариантУчетаКупонногоДохода) <> Неопределено Тогда
							
							Если ДанныеПоЦеннойБумаге.ЭтоВалютнаяБумага Тогда
								ОценочнаяКорректировкаЭСПВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
									Новый Структура("Сумма", ДисконтИКорректировкаЭСП.ОценочнаяКорректировкаЭСП), 
									ДанныеПоЦеннойБумаге.ВалютаНоминала,
									ЭтотОбъект.Организация,
									ВыборкаДетальныеЗаписи.Период,
									,
									Отказ).Сумма;
							Иначе
								ОценочнаяКорректировкаЭСПВВалютеУчета = ДисконтИКорректировкаЭСП.ОценочнаяКорректировкаЭСП;
							КонецЕсли;

							НовоеДвижение.КорректировкаЭСП = ДисконтИКорректировкаЭСП.ОценочнаяКорректировкаЭСП - СтрокаПартийПроданныхВРЕПО.КорректировкаЭСП;
							НовоеДвижение.КорректировкаЭСПВВалютеУчета = ОценочнаяКорректировкаЭСПВВалютеУчета - СтрокаПартийПроданныхВРЕПО.КорректировкаЭСПВВалютеУчета;
							
							СтрокаПартийПроданныхВРЕПО.КорректировкаЭСП = ДисконтИКорректировкаЭСП.ОценочнаяКорректировкаЭСП;
							СтрокаПартийПроданныхВРЕПО.КорректировкаЭСПВВалютеУчета = ОценочнаяКорректировкаЭСПВВалютеУчета;
							
						КонецЕсли;
						
						НовоеДвижение.ПереоценкаКупонаСНачалаГода = НовоеДвижение.ПереоценкаКупонаВВалютеУчета;
						НовоеДвижение.КорректировкаЭСПСНачалаГода = НовоеДвижение.КорректировкаЭСПВВалютеУчета;
						НовоеДвижение.ДисконтПремияНачисленныйСНачалаГода = НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета;
						
						СтрокаПартийПроданныхВРЕПО.ПереоценкаКупонаСНачалаГода = СтрокаПартийПроданныхВРЕПО.ПереоценкаКупонаСНачалаГода + НовоеДвижение.ПереоценкаКупонаСНачалаГода;
						СтрокаПартийПроданныхВРЕПО.КорректировкаЭСПСНачалаГода = СтрокаПартийПроданныхВРЕПО.КорректировкаЭСПСНачалаГода + НовоеДвижение.КорректировкаЭСПСНачалаГода; 
						СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленныйСНачалаГода = СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленныйСНачалаГода + НовоеДвижение.ДисконтПремияНачисленныйСНачалаГода;
						
							
						// 4. Спишем купон
						НовоеДвижениеСписания = ЭтотОбъект.РассчитанныеПартииПрямоеРЕПО.Добавить();
						//НовоеДвижениеСписания.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.СписаниеКупона;
						
						НовоеДвижениеСписания.ЦеннаяБумага 		= СтрокаПартийПроданныхВРЕПО.ЦеннаяБумага;
						НовоеДвижениеСписания.УчетныйАктивЕПС 	= СтрокаПартийПроданныхВРЕПО.УчетныйАктивЕПС;
						НовоеДвижениеСписания.Партия	 		= СтрокаПартийПроданныхВРЕПО.Партия;
						НовоеДвижениеСписания.СтрокаПартии 		= СтрокаПартийПроданныхВРЕПО.СтрокаПартии;
						НовоеДвижениеСписания.Рынок 			= СтрокаПартийПроданныхВРЕПО.Рынок;

						НовоеДвижениеСписания.ПродажаРЕПО 		= СтрокаПартийПроданныхВРЕПО.ПродажаРЕПО;
						НовоеДвижениеСписания.СтрокаПродажиРЕПО	= СтрокаПартийПроданныхВРЕПО.СтрокаПродажиРЕПО;
						
						НовоеДвижениеСписания.ВидДвижения = Перечисления.ВидыДвижений.Расход;
						НовоеДвижениеСписания.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
						НовоеДвижениеСписания.Период 	  = ВыборкаДетальныеЗаписи.Период;
						
						НовоеДвижениеСписания.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
						
						НовоеДвижениеСписания.ПереоценкаКупона = СтрокаПартийПроданныхВРЕПО.ПереоценкаКупона;
						НовоеДвижениеСписания.ПереоценкаКупонаВВалютеУчета = СтрокаПартийПроданныхВРЕПО.ПереоценкаКупонаВВалютеУчета;
						НовоеДвижениеСписания.ПереоценкаКупонаВСтоимости = СтрокаПартийПроданныхВРЕПО.ПереоценкаКупонаВСтоимости;
						НовоеДвижениеСписания.СтоимостьКупона = СтрокаПартийПроданныхВРЕПО.СтоимостьКупона;
						НовоеДвижениеСписания.СтоимостьКупонаВВалютеУчета = СтрокаПартийПроданныхВРЕПО.СтоимостьКупонаВВалютеУчета;
						
						НовоеДвижениеСписания.ПереоценкаКупонаСНачалаГода = СтрокаПартийПроданныхВРЕПО.ПереоценкаКупонаСНачалаГода;

						СтрокаПартийПроданныхВРЕПО.СтоимостьКупона = 0;
						СтрокаПартийПроданныхВРЕПО.СтоимостьКупонаВВалютеУчета = 0;
						
						СтрокаПартийПроданныхВРЕПО.ПереоценкаКупона = 0;
						СтрокаПартийПроданныхВРЕПО.ПереоценкаКупонаВВалютеУчета = 0;
						СтрокаПартийПроданныхВРЕПО.ПереоценкаКупонаВСтоимости = 0;
						СтрокаПартийПроданныхВРЕПО.ПереоценкаКупонаСНачалаГода = 0;
						
						// 5. Если клиент отражает задолженность на счетах учета - добавим начисление задолженности по погашению купона
						Если НастройкиУчетаОбщие.ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
						
							НовоеДвижениеНачисленияЗадолженности = ЭтотОбъект.РассчитанныеПартииПрямоеРЕПО.Добавить();
							//НовоеДвижениеНачисленияЗадолженности.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.НачислениеЗадолженности;
							
							ЗаполнитьЗначенияСвойств(НовоеДвижениеНачисленияЗадолженности, НовоеДвижениеСписания, );
							
							НовоеДвижениеНачисленияЗадолженности.ВидДвижения = Перечисления.ВидыДвижений.Приход;
							
							НовоеДвижениеНачисленияЗадолженности.ЗадолженностьПоПогашениюКупона = НовоеДвижениеСписания.СтоимостьКупона + НовоеДвижениеСписания.ПереоценкаКупона;
							НовоеДвижениеНачисленияЗадолженности.ЗадолженностьПоПогашениюКупонаВВалютеУчета = НовоеДвижениеСписания.СтоимостьКупонаВВалютеУчета + НовоеДвижениеСписания.ПереоценкаКупонаВВалютеУчета;
							
							НовоеДвижениеНачисленияЗадолженности.СтоимостьКупона = 0;
							НовоеДвижениеНачисленияЗадолженности.СтоимостьКупонаВВалютеУчета = 0;
							НовоеДвижениеНачисленияЗадолженности.ПереоценкаКупона = 0;
							НовоеДвижениеНачисленияЗадолженности.ПереоценкаКупонаВВалютеУчета = 0;
							НовоеДвижениеНачисленияЗадолженности.ПереоценкаКупонаСНачалаГода = 0;
							
							СтрокаПартийПроданныхВРЕПО.ЗадолженностьПоПогашениюКупона = НовоеДвижениеНачисленияЗадолженности.ЗадолженностьПоПогашениюКупона;
							СтрокаПартийПроданныхВРЕПО.ЗадолженностьПоПогашениюКупонаВВалютеУчета = НовоеДвижениеНачисленияЗадолженности.ЗадолженностьПоПогашениюКупонаВВалютеУчета;
						
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.Оплата") Тогда
				
				Если НастройкиУчетаОбщие.ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов 
					И (ВыборкаДетальныеЗаписи.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюКупона
						ИЛИ ВыборкаДетальныеЗаписи.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюОблигации) Тогда
					
					ОбщееКоличество = ПриходныеПартии.Итог("Количество");
					
					Если ВыборкаДетальныеЗаписи.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюКупона Тогда
						
						ПолеЗадолженностьПоПогашению = "ЗадолженностьПоПогашениюКупона";
						ПолеЗадолженностьПоПогашениюВВалютеУчета = "ЗадолженностьПоПогашениюКупонаВВалютеУчета";
						СуммаОплаты = ВыборкаДетальныеЗаписи.СтоимостьПокупкиКупона;
						
					ИначеЕсли ВыборкаДетальныеЗаписи.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюОблигации Тогда
						
						ПолеЗадолженностьПоПогашению = "ЗадолженностьПоПогашениюТела";
						ПолеЗадолженностьПоПогашениюВВалютеУчета = "ЗадолженностьПоПогашениюТелаВВалютеУчета";
						СуммаОплаты = ВыборкаДетальныеЗаписи.СтоимостьПокупки;
						
					КонецЕсли;
					
					ОбщаяЗадолженностьПоПогашению = ПриходныеПартии.Итог(ПолеЗадолженностьПоПогашению);
					ОбщаяЗадолженностьПоПогашениюВВалютеУчета = ПриходныеПартии.Итог(ПолеЗадолженностьПоПогашениюВВалютеУчета);
					
					//если пришла оплата по купону, а задолженности нет, то это просроченная задолженность!
					//задолженность может и быть, но ее просто не хватает - в данном случае не трогаем ее, а списываем просрочку
					ЗадолженностиХватает = Истина;
					Если ВыборкаДетальныеЗаписи.ВалютаОплаты = ВалютаУчета Тогда
						ЗадолженностиХватает = (ОбщаяЗадолженностьПоПогашениюВВалютеУчета >= СуммаОплаты);
					Иначе
						ЗадолженностиХватает = (ОбщаяЗадолженностьПоПогашению >= СуммаОплаты);
					КонецЕсли;
					
					Если НЕ ЗадолженностиХватает
						И ВыборкаДетальныеЗаписи.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюКупона
						И ПриходныеПартии.Итог("ПогашениеКупонаНеИсполненноеВСрок") >= СуммаОплаты Тогда // проверим, что она есть и ее больше или столько же, сколько пришло по оплате
					
						ПолеЗадолженностьПоПогашению = "ПогашениеКупонаНеИсполненноеВСрок";
						ПолеЗадолженностьПоПогашениюВВалютеУчета = "ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета";
						
						ОбщаяЗадолженностьПоПогашению = ПриходныеПартии.Итог(ПолеЗадолженностьПоПогашению);
						ОбщаяЗадолженностьПоПогашениюВВалютеУчета = ПриходныеПартии.Итог(ПолеЗадолженностьПоПогашениюВВалютеУчета);
						
					КонецЕсли;
					
					Если ОбщаяЗадолженностьПоПогашению <= СуммаОплаты Тогда // ситуации: сколько гасили столько и пришло; пришло больше чем гасили - значит часть партий успели продать
						ДоляОплаты = 1;
						РаспределитьЗадолженностьПоПогашению = ОбщаяЗадолженностьПоПогашению;
						РаспределитьЗадолженностьПоПогашениюВВалютеУчета = ОбщаяЗадолженностьПоПогашениюВВалютеУчета;
					Иначе
						ДоляОплаты = СуммаОплаты / ОбщаяЗадолженностьПоПогашению;
						РаспределитьЗадолженностьПоПогашению = Окр(ОбщаяЗадолженностьПоПогашению * ДоляОплаты, 2);
						РаспределитьЗадолженностьПоПогашениюВВалютеУчета = Окр(ОбщаяЗадолженностьПоПогашениюВВалютеУчета * ДоляОплаты, 2);
					КонецЕсли;
					
					Для каждого СтрокаПриходныхПартий Из ПриходныеПартии Цикл
					
						НовоеДвижениеСписания = ЭтотОбъект.РассчитанныеПартии.Добавить();
						//НовоеДвижениеСписания.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.СписаниеЗадолженности;
						
						НовоеДвижениеСписания.ЦеннаяБумага 		= СтрокаПриходныхПартий.ЦеннаяБумага;
						НовоеДвижениеСписания.УчетныйАктивЕПС 	= СтрокаПриходныхПартий.УчетныйАктивЕПС;
						НовоеДвижениеСписания.Партия	 		= СтрокаПриходныхПартий.Партия;
						НовоеДвижениеСписания.СтрокаПартии 		= СтрокаПриходныхПартий.СтрокаПартии;
						НовоеДвижениеСписания.Рынок 			= СтрокаПриходныхПартий.Рынок;
						
						НовоеДвижениеСписания.ВидДвижения = Перечисления.ВидыДвижений.Расход;
						НовоеДвижениеСписания.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
						НовоеДвижениеСписания.Период 	  = ВыборкаДетальныеЗаписи.Период;
						
						НовоеДвижениеСписания.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
						
						НовоеДвижениеСписания[ПолеЗадолженностьПоПогашению] = Окр(СтрокаПриходныхПартий[ПолеЗадолженностьПоПогашению] * ДоляОплаты, 2);
						НовоеДвижениеСписания[ПолеЗадолженностьПоПогашениюВВалютеУчета] = Окр(СтрокаПриходныхПартий[ПолеЗадолженностьПоПогашениюВВалютеУчета] * ДоляОплаты, 2);
						
						ОбщееКоличество = ОбщееКоличество - СтрокаПриходныхПартий.Количество;
						РаспределитьЗадолженностьПоПогашению = РаспределитьЗадолженностьПоПогашению - НовоеДвижениеСписания[ПолеЗадолженностьПоПогашению];
						РаспределитьЗадолженностьПоПогашениюВВалютеУчета = РаспределитьЗадолженностьПоПогашениюВВалютеУчета - НовоеДвижениеСписания[ПолеЗадолженностьПоПогашениюВВалютеУчета];
						
						Если ОбщееКоличество = 0 
							И (РаспределитьЗадолженностьПоПогашению <> 0 
								ИЛИ  РаспределитьЗадолженностьПоПогашениюВВалютеУчета <> 0) Тогда // погрешность на последнюю строку для задолженности это не критично
						
							НовоеДвижениеСписания[ПолеЗадолженностьПоПогашению] = НовоеДвижениеСписания[ПолеЗадолженностьПоПогашению] + РаспределитьЗадолженностьПоПогашению;
							НовоеДвижениеСписания[ПолеЗадолженностьПоПогашениюВВалютеУчета] = НовоеДвижениеСписания[ПолеЗадолженностьПоПогашениюВВалютеУчета] + РаспределитьЗадолженностьПоПогашениюВВалютеУчета;
						
						КонецЕсли;
						
						СтрокаПриходныхПартий[ПолеЗадолженностьПоПогашению] = СтрокаПриходныхПартий[ПолеЗадолженностьПоПогашению] - НовоеДвижениеСписания[ПолеЗадолженностьПоПогашению];
						СтрокаПриходныхПартий[ПолеЗадолженностьПоПогашениюВВалютеУчета] = СтрокаПриходныхПартий[ПолеЗадолженностьПоПогашениюВВалютеУчета] - НовоеДвижениеСписания[ПолеЗадолженностьПоПогашениюВВалютеУчета];
						
					КонецЦикла;
					
				ИначеЕсли ВыборкаДетальныеЗаписи.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации
					И НЕ НастройкиУчетаОбщие.СписыватьПриПолномПогашенииВМоментПогашения Тогда // эти списывают при погашении
					
					// для валютных бумаг может вылезти погрешность для сумм в валюте учета
					// хорошо, что их всего 4: стоимость, дисконт/премия, УНКД и ННКД (все остальное должно быть списано)
					// учтем эти погрешности
					ДелаемПерекурсовку = ДанныеПоЦеннойБумаге.ЭтоВалютнаяБумага И ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки = 0;
					
					Если ДелаемПерекурсовку Тогда
						
						КоличествоИтог = ПриходныеПартии.Итог("Количество");
						
						СтоимостьИтог = ПриходныеПартии.Итог("Стоимость");
						ДисконтПремияНачисленныйИтог = ПриходныеПартии.Итог("ДисконтПремияНачисленный");
						СтоимостьКупонаИтог = ПриходныеПартии.Итог("СтоимостьКупона");
						ПереоценкаКупонаИтог = ПриходныеПартии.Итог("ПереоценкаКупона");
						
						ИтогиВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
							Новый Структура("Стоимость,ДисконтПремияНачисленный,СтоимостьКупона,ПереоценкаКупона", СтоимостьИтог, ДисконтПремияНачисленныйИтог, СтоимостьКупонаИтог, ПереоценкаКупонаИтог),
							ДанныеПоЦеннойБумаге.ВалютаНоминала,
							ЭтотОбъект.Организация,
							ВыборкаДетальныеЗаписи.Период,
							Неопределено,
							Отказ);
						
					КонецЕсли;
					
					// спишем все суммы с приходных партий
					Для каждого СтрокаПриходныхПартий Из ПриходныеПартии Цикл
						
						НовоеДвижениеПерекурсовка = Неопределено;
						Если ДелаемПерекурсовку Тогда
							НовоеДвижениеПерекурсовка = Перекурсовка(ВыборкаДетальныеЗаписи.Регистратор, ЭтотОбъект.РассчитанныеПартии, ВыборкаДетальныеЗаписи.Период, СтрокаПриходныхПартий, СтрокаПриходныхПартий.Количество, ВыборкаДетальныеЗаписи.СтрокаПартии,,,, Отказ);
							
							ИтогиВВалютеУчета.Стоимость = ИтогиВВалютеУчета.Стоимость - СтрокаПриходныхПартий.СтоимостьВВалютеУчета;
							ИтогиВВалютеУчета.ДисконтПремияНачисленный = ИтогиВВалютеУчета.ДисконтПремияНачисленный - СтрокаПриходныхПартий.ДисконтПремияНачисленныйВВалютеУчета;
							ИтогиВВалютеУчета.СтоимостьКупона = ИтогиВВалютеУчета.СтоимостьКупона - СтрокаПриходныхПартий.СтоимостьКупонаВВалютеУчета;
							ИтогиВВалютеУчета.ПереоценкаКупона = ИтогиВВалютеУчета.ПереоценкаКупона - СтрокаПриходныхПартий.ПереоценкаКупонаВВалютеУчета;
							
							КоличествоИтог = КоличествоИтог - СтрокаПриходныхПартий.Количество;
							
							Если КоличествоИтог = 0 Тогда // отправим погрешности округления на последнюю строку
								НовоеДвижениеПерекурсовка.СтоимостьВВалютеУчета					= НовоеДвижениеПерекурсовка.СтоимостьВВалютеУчета					+ ИтогиВВалютеУчета.Стоимость;
								НовоеДвижениеПерекурсовка.ДисконтПремияНачисленныйВВалютеУчета	= НовоеДвижениеПерекурсовка.ДисконтПремияНачисленныйВВалютеУчета	+ ИтогиВВалютеУчета.ДисконтПремияНачисленный;
								НовоеДвижениеПерекурсовка.СтоимостьКупонаВВалютеУчета			= НовоеДвижениеПерекурсовка.СтоимостьКупонаВВалютеУчета				+ ИтогиВВалютеУчета.СтоимостьКупона;
								НовоеДвижениеПерекурсовка.ПереоценкаКупонаВВалютеУчета			= НовоеДвижениеПерекурсовка.ПереоценкаКупонаВВалютеУчета			+ ИтогиВВалютеУчета.ПереоценкаКупона;
								
								СтрокаПриходныхПартий.СтоимостьВВалютеУчета					= СтрокаПриходныхПартий.СтоимостьВВалютеУчета					+ ИтогиВВалютеУчета.Стоимость;
								СтрокаПриходныхПартий.ДисконтПремияНачисленныйВВалютеУчета	= СтрокаПриходныхПартий.ДисконтПремияНачисленныйВВалютеУчета	+ ИтогиВВалютеУчета.ДисконтПремияНачисленный;
								СтрокаПриходныхПартий.СтоимостьКупонаВВалютеУчета			= СтрокаПриходныхПартий.СтоимостьКупонаВВалютеУчета				+ ИтогиВВалютеУчета.СтоимостьКупона;
								СтрокаПриходныхПартий.ПереоценкаКупонаВВалютеУчета			= СтрокаПриходныхПартий.ПереоценкаКупонаВВалютеУчета			+ ИтогиВВалютеУчета.ПереоценкаКупона;
							КонецЕсли;
							
						КонецЕсли;
						
						// если они есть, эти суммы
						ЕстьЧтоСписывать = Ложь;
						
						СуммовыеПоля = Новый Структура(РесурсыРегистраПартийСодержащиеСуммы);
						Для каждого СуммовоеПоле Из СуммовыеПоля Цикл
							ИмяПоля = СуммовоеПоле.Ключ;
							СуммовыеПоля[ИмяПоля] = 0;
							Если СтрокаПриходныхПартий[ИмяПоля] <> 0 Тогда
								ЕстьЧтоСписывать = Истина;
								СуммовыеПоля[ИмяПоля] = СтрокаПриходныхПартий[ИмяПоля];
								СтрокаПриходныхПартий[ИмяПоля] = 0;
							КонецЕсли;
						КонецЦикла;
						
						Если ЕстьЧтоСписывать Тогда
						
							НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
							//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.СписаниеПартии;
							
							НовоеДвижение.ЦеннаяБумага 		= СтрокаПриходныхПартий.ЦеннаяБумага;
							НовоеДвижение.УчетныйАктивЕПС 	= СтрокаПриходныхПартий.УчетныйАктивЕПС;
							НовоеДвижение.Партия	 		= СтрокаПриходныхПартий.Партия;
							НовоеДвижение.СтрокаПартии 		= СтрокаПриходныхПартий.СтрокаПартии;
							НовоеДвижение.Рынок 			= СтрокаПриходныхПартий.Рынок;
							
							НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
							
							ЗаполнитьЗначенияСвойств(НовоеДвижение, СуммовыеПоля);
							НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Расход;
							НовоеДвижение.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
							НовоеДвижение.Период = ВыборкаДетальныеЗаписи.Период;
							НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
						
						КонецЕсли;
					
					КонецЦикла;
					
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") И ДанныеПоЦеннойБумаге.ЭтоПай Тогда
				
				// паи по списанию
				Продолжить;
				
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.СписаниеЦеннойБумаги") И ДанныеПоЦеннойБумаге.ЭтоПай Тогда
				
				// т.к. по погашению паев вообще говоря не предполагается распределение по Активам ЕПС
				// то списываем приходные партии подряд
				
				КоличествоКСписанию = ВыборкаДетальныеЗаписи.Количество;
				ПриходныеПартииКУдалению = Новый Массив;
				
				Для каждого СтрокаПриходныхПартий Из ПриходныеПартии Цикл
					
					Если СтрокаПриходныхПартий.Количество <= КоличествоКСписанию Тогда
						КоличествоКСписаниюПартии = СтрокаПриходныхПартий.Количество;
					Иначе
						КоличествоКСписаниюПартии = КоличествоКСписанию;
					КонецЕсли;
					
					Если РассчитыватьСтоимости Тогда
					
						НовоеДвижениеПерекурсовка = Перекурсовка(ВыборкаДетальныеЗаписи.Регистратор, ЭтотОбъект.РассчитанныеПартии, ВыборкаДетальныеЗаписи.Период, СтрокаПриходныхПартий, КоличествоКСписаниюПартии, ВыборкаДетальныеЗаписи.СтрокаПартии,,,, Отказ);
					
					КонецЕсли;
						
					НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
					//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.СписаниеПартии;
					
					ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаПриходныхПартий);
					
					НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Расход;
					НовоеДвижение.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
					НовоеДвижение.Период = ВыборкаДетальныеЗаписи.Период;
					НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
					
					Если СтрокаПриходныхПартий.Количество <= КоличествоКСписанию Тогда
						
						КоличествоКСписанию = КоличествоКСписанию - СтрокаПриходныхПартий.Количество;
						ПриходныеПартииКУдалению.Добавить(СтрокаПриходныхПартий); // списали её всю
						
					Иначе //спишем пропорционально
						
						КоэффициентСписания = КоличествоКСписанию / СтрокаПриходныхПартий.Количество;
						
						НовоеДвижение.Количество = КоличествоКСписанию;
						
						Если РассчитыватьСтоимости Тогда
						
							НовоеДвижение.СтоимостьПокупки = СтрокаПриходныхПартий.СтоимостьПокупки * КоэффициентСписания;
							
							НовоеДвижение.Стоимость = СтрокаПриходныхПартий.Стоимость * КоэффициентСписания;
							НовоеДвижение.СтоимостьВВалютеУчета = СтрокаПриходныхПартий.СтоимостьВВалютеУчета * КоэффициентСписания;
							НовоеДвижение.Переоценка = СтрокаПриходныхПартий.Переоценка * КоэффициентСписания;
							НовоеДвижение.ПереоценкаВВалютеУчета = СтрокаПриходныхПартий.ПереоценкаВВалютеУчета * КоэффициентСписания;
							НовоеДвижение.ПереоценкаСНачалаГода = СтрокаПриходныхПартий.ПереоценкаСНачалаГода * КоэффициентСписания;
							НовоеДвижение.ПереоценкаСНачалаГодаПоложительная = СтрокаПриходныхПартий.ПереоценкаСНачалаГодаПоложительная * КоэффициентСписания;
							НовоеДвижение.КурсовыеРазницыСНачалаГода = СтрокаПриходныхПартий.КурсовыеРазницыСНачалаГода * КоэффициентСписания;
							
							
							СтрокаПриходныхПартий.СтоимостьПокупки = СтрокаПриходныхПартий.СтоимостьПокупки - НовоеДвижение.СтоимостьПокупки;
							
							СтрокаПриходныхПартий.Стоимость = СтрокаПриходныхПартий.Стоимость - НовоеДвижение.Стоимость;
							СтрокаПриходныхПартий.СтоимостьВВалютеУчета = СтрокаПриходныхПартий.СтоимостьВВалютеУчета - НовоеДвижение.СтоимостьВВалютеУчета;
							СтрокаПриходныхПартий.Переоценка = СтрокаПриходныхПартий.Переоценка - НовоеДвижение.Переоценка;
							СтрокаПриходныхПартий.ПереоценкаВВалютеУчета = СтрокаПриходныхПартий.ПереоценкаВВалютеУчета - НовоеДвижение.ПереоценкаВВалютеУчета;
							СтрокаПриходныхПартий.ПереоценкаСНачалаГода = СтрокаПриходныхПартий.ПереоценкаСНачалаГода - НовоеДвижение.ПереоценкаСНачалаГода;
							СтрокаПриходныхПартий.ПереоценкаСНачалаГодаПоложительная = СтрокаПриходныхПартий.ПереоценкаСНачалаГодаПоложительная - НовоеДвижение.ПереоценкаСНачалаГодаПоложительная;
							СтрокаПриходныхПартий.КурсовыеРазницыСНачалаГода = СтрокаПриходныхПартий.КурсовыеРазницыСНачалаГода - НовоеДвижение.КурсовыеРазницыСНачалаГода;
							
						КонецЕсли;
						
						СтрокаПриходныхПартий.Количество = СтрокаПриходныхПартий.Количество - НовоеДвижение.Количество;
						
						КоличествоКСписанию = 0;
					
					КонецЕсли;
					
					Если КоличествоКСписанию = 0 Тогда
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
				Если КоличествоКСписанию > 0 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не распределилась:" + Строка(ВыборкаДетальныеЗаписи.ЦеннаяБумага) + " по " + Строка(ВыборкаДетальныеЗаписи.Регистратор), ВыборкаДетальныеЗаписи.Регистратор);
					Сообщить(КоличествоКСписанию);
					Отказ = Истина;
				КонецЕсли;
				
				УдалялиПриходныеПартии = Ложь;
				Для каждого СтрокаПриходныхПартийКУдалению Из ПриходныеПартииКУдалению Цикл
					ПриходныеПартии.Удалить(СтрокаПриходныхПартийКУдалению);
					УдалялиПриходныеПартии = Истина;
				КонецЦикла;
				
				Если УдалялиПриходныеПартии Тогда
					ПриходныеПартииКоличество = ПриходныеПартии.Количество();
					Для Инд = 1 По ПриходныеПартииКоличество Цикл
						ПриходныеПартии[Инд - 1].НомерСтроки = Инд;
					КонецЦикла;
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.СписаниеЦеннойБумаги") 
				И НастройкиУчетаОбщие.СписыватьПриПолномПогашенииВМоментПогашения
				И ВыборкаДетальныеЗаписи.Период < БухгалтерскийУчетПовтИсп.ДатаСКоторойПерестаемСписыватьКоличествоВМоментПолногоПогашения() Тогда
				
				// ничего делать не надо - все списало погашение
				Продолжить;
				
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.СписаниеЦеннойБумаги") 
				ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.СнятиеЦеннойБумагиСУчета")
				ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ВыбытиеСтоимостиЦенныхБумагПоБухгалтерскомуУчету") Тогда
				
				ПриходныеПартииКУдалению = Новый Массив;
				
				Для каждого СтрокаПриходныхПартий Из ПриходныеПартии Цикл
					
					НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
					//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.СписаниеПартии;
					
					ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаПриходныхПартий);
					НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Расход;
					НовоеДвижение.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
					НовоеДвижение.Период = ВыборкаДетальныеЗаписи.Период;
					НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
					
					Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ВыбытиеСтоимостиЦенныхБумагПоБухгалтерскомуУчету") Тогда
						НовоеДвижение.Количество = 0; // выбытие количество не списывает
						
						СуммовыеПоля = Новый Структура(РесурсыРегистраПартийСодержащиеСуммы); // обнулим остаток на партии
						Для каждого СуммовоеПоле Из СуммовыеПоля Цикл
							ИмяПоля = СуммовоеПоле.Ключ;
							СтрокаПриходныхПартий[ИмяПоля] = 0;
						КонецЦикла;
						
					Иначе
						ПриходныеПартииКУдалению.Добавить(СтрокаПриходныхПартий); // все, кроме выбытия убивают партию
					КонецЕсли;
					
				КонецЦикла;
				
				УдалялиПриходныеПартии = Ложь;
				Для каждого СтрокаПриходныхПартийКУдалению Из ПриходныеПартииКУдалению Цикл
					ПриходныеПартии.Удалить(СтрокаПриходныхПартийКУдалению);
					УдалялиПриходныеПартии = Истина;
				КонецЦикла;
				
				Если УдалялиПриходныеПартии Тогда
					ПриходныеПартииКоличество = ПриходныеПартии.Количество();
					Для Инд = 1 По ПриходныеПартииКоличество Цикл
						ПриходныеПартии[Инд - 1].НомерСтроки = Инд;
					КонецЦикла;
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") И ДанныеПоЦеннойБумаге.ЭтоОблигация Тогда
				
				Если РассчитыватьСтоимости // #430408 при настройке СписыватьПриПолномПогашенииВМоментПогашения и полном погашении (оферте) списываем количество, поэтому при этих условиях в количественный расчет погашение должно попасть
					ИЛИ НастройкиУчетаОбщие.СписыватьПриПолномПогашенииВМоментПогашения И ВыборкаДетальныеЗаписи.ВидПогашения <> Перечисления.ВидыПогашения.ЧастичноеПогашение Тогда
					
					// для бумаг по АС берем данные по начальным дисконту/премии из первички (#404807)
					// это связано с тем, что у них комиссия идет в стоимость и требуется точность, большая чем может обеспечить ресурс ДисконтПремияПокупки
					// #436580 - для организации ДК сделано упрощение расчетов
					ИспользоватьПервичныеДанныеДляОпределенияЦеныПриобретения = (ПриходныеПартии.Найти(Истина, "ВключатьРасходыПоПокупкеВСтоимость") <> Неопределено) И НЕ Организация_ДК;
					
					Если ИспользоватьПервичныеДанныеДляОпределенияЦеныПриобретения Тогда
						ДатыИЦеныПокупки = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(ПриходныеПартии, СчетДоверительногоУправленияДляУчета, ВыборкаДетальныеЗаписи.Период).Выгрузить();
					Иначе 
						ДатыИЦеныПокупки = Неопределено;
					КонецЕсли;
					
					Если ВыборкаДетальныеЗаписи.ВидПогашения = Перечисления.ВидыПогашения.ЧастичноеПогашение Тогда
						
						ЦенаПогашенияКупона = ОпределитьСтоимостьКупонаВМоментАмортизации(ВыборкаДетальныеЗаписи.ЦеннаяБумага, ВыборкаДетальныеЗаписи.Период);
						Если ЦенаПогашенияКупона = 0 Тогда //в этот день не было погашения купона - начисляем процентные доходы
							СуммаКупонаНаОднуОблигацию = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(ВыборкаДетальныеЗаписи.ЦеннаяБумага, ВыборкаДетальныеЗаписи.Период, СчетДоверительногоУправленияДляУчета);
						Иначе
							СуммаКупонаНаОднуОблигацию = ЦенаПогашенияКупона;
						КонецЕсли;
						
						//ДатыИЦеныПокупки = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(ПриходныеПартии, СчетДоверительногоУправленияДляУчета, ВыборкаДетальныеЗаписи.Период).Выгрузить();
						
						СуммаСписанияНаОднуОблигацию = СуммаИзмененияНоминала(ВыборкаДетальныеЗаписи.Период, ВыборкаДетальныеЗаписи.ЦеннаяБумага);
						
						Для каждого СтрокаПриходныхПартий Из ПриходныеПартии Цикл 
							
							НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
								НастройкиУчетаОбщие,
								СтрокаПриходныхПартий.ЦеннаяБумага,
								СтрокаПриходныхПартий.УчетныйАктивЕПС,
								СтрокаПриходныхПартий.Партия,
								СтрокаПриходныхПартий.СтрокаПартии);
							
							НовоеДвижениеПерекурсовка = Перекурсовка(ВыборкаДетальныеЗаписи.Регистратор, ЭтотОбъект.РассчитанныеПартии, ВыборкаДетальныеЗаписи.Период, СтрокаПриходныхПартий, СтрокаПриходныхПартий.Количество, ВыборкаДетальныеЗаписи.СтрокаПартии,,,, Отказ);
							
							// Обычно в день частичного погашения проходит ПогашениеКупона
							// поэтому ничего не делаем, но иногда бывает опс и погашения не было
							// погашения купона не было - нужно все дооценить и отдисконтировать
							//
							// Для всех приходных партий:
							// Если погашения не было
								// 1. Дооценим купон
								// 2. Начислим дисконт/премию
								// 3. Начислим корректировку по ЭСП
							// КонецЕсли
							// Теперь спишем часть тела, и при необходимости кусок дисконта 
							
							Если ЦенаПогашенияКупона = 0 Тогда 
								
								// 1. Дооценим купон
								НовоеДвижение = ДоначислитьКупон(ВыборкаДетальныеЗаписи.Регистратор, 
																		ВыборкаДетальныеЗаписи.Период, 
																		СтрокаПриходныхПартий,
																		СуммаКупонаНаОднуОблигацию,
																		СтрокаПриходныхПартий.Количество,
																		ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки,
																		0,
																		Ложь,
																		Отказ);
								//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.ПереоценкаИНачислениеПроцентов;
																		
								СтрокаПриходныхПартий.ПереоценкаКупона = СтрокаПриходныхПартий.ПереоценкаКупона + НовоеДвижение.ПереоценкаКупона;
								СтрокаПриходныхПартий.ПереоценкаКупонаВВалютеУчета = СтрокаПриходныхПартий.ПереоценкаКупонаВВалютеУчета + НовоеДвижение.ПереоценкаКупонаВВалютеУчета;
								
								// 2. Начислим дисконт/премию
								ДатаПокупки	= СтрокаПриходныхПартий.ДатаПокупки;
								ДатаПокупкиНачальная	= СтрокаПриходныхПартий.ДатаПокупкиНачальная;
								КорректировкаЭСПНачальная = СтрокаПриходныхПартий.КорректировкаЭСПНачальная;
								ЦенаПокупкиНачальная = СтрокаПриходныхПартий.СтоимостьПокупкиНачальная / СтрокаПриходныхПартий.Количество;
								
								Если ДатыИЦеныПокупки = Неопределено Тогда
									
									НачальныйДисконт  = Окр(СтрокаПриходныхПартий.ДисконтПремияПокупки / СтрокаПриходныхПартий.Количество, РазрядностьДробнойЧасти);
									
									Если ДанныеПоЦеннойБумаге.Амортизационная Тогда
										ЦенаПокупки	= Справочники.Облигации.ПолучитьНоминал(СтрокаПриходныхПартий.ЦеннаяБумага, ДатаПокупки) + НачальныйДисконт;
									Иначе
										ЦенаПокупки	= СтрокаПриходныхПартий.Номинал + НачальныйДисконт;
									КонецЕсли;
									ЦенаПокупкиКупона	= Окр(СтрокаПриходныхПартий.СтоимостьПокупкиКупона / СтрокаПриходныхПартий.Количество, РазрядностьДробнойЧасти);
									
								Иначе
									
									ДатаИЦенаПокупки = ДатыИЦеныПокупки.НайтиСтроки(Новый Структура("НомерСтроки", СтрокаПриходныхПартий.НомерСтроки));
									
									НачальныйДисконт 	= ДатаИЦенаПокупки[0].НачальныйДисконт;
									ЦенаПокупки 		= ДатаИЦенаПокупки[0].ЦенаПокупки;
									ЦенаПокупкиКупона 	= ДатаИЦенаПокупки[0].ЦенаКупона;
									
								КонецЕсли;
								
								ДанныеПереоценки = Новый Структура("Количество, УчетныйАктивЕПС, Партия, СтрокаПартии");
								ЗаполнитьЗначенияСвойств(ДанныеПереоценки, СтрокаПриходныхПартий, "Количество, УчетныйАктивЕПС, Партия, СтрокаПартии");
								ДанныеПереоценки.Вставить("ДатаПереоценки", НачалоДня(ВыборкаДетальныеЗаписи.Период));
								ДанныеПереоценки.Вставить("ОценочнаяСуммаКупона", 0);
								ДанныеПереоценки.Вставить("БалансовыйДисконт", СтрокаПриходныхПартий.ДисконтПремияНачисленный);
								ДанныеПереоценки.Вставить("БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные);
								ДанныеПереоценки.Вставить("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
								ДанныеПереоценки.Вставить("Стоимость", СтрокаПриходныхПартий.Стоимость);
								
								ДанныеПокупки = Новый Структура;
								ДанныеПокупки.Вставить("НачальныйДисконт", НачальныйДисконт);
								ДанныеПокупки.Вставить("ДатаПокупки", ДатаПокупки);
								ДанныеПокупки.Вставить("ДатаПокупкиНачальная", ДатаПокупкиНачальная);
								ДанныеПокупки.Вставить("КорректировкаЭСПНачальная", КорректировкаЭСПНачальная);
								ДанныеПокупки.Вставить("ЦенаПокупки", ЦенаПокупки);
								ДанныеПокупки.Вставить("НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная / СтрокаПриходныхПартий.Количество);
								ДанныеПокупки.Вставить("ЦенаПокупкиКупона", ЦенаПокупкиКупона);
								ДанныеПокупки.Вставить("ЦенаПокупкиНачальная", ЦенаПокупкиНачальная);

								ДисконтИКорректировкаЭСП = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремииИКорректировкуПоЭСПИРазницуПервоначальногоПризнания(СтрокаПриходныхПартий.ЦеннаяБумага, ДанныеПереоценки, ДанныеПокупки, НастройкиУчетаЦеннойБумаги, Отказ);
								
								Если ДисконтИКорректировкаЭСП = Неопределено Тогда
									Возврат;
								КонецЕсли;
								
								Если ЭтоКлиентЮгория ИЛИ (НачальныйДисконт > 0 И СтрокаПриходныхПартий.ДисконтПремияНачисленный < ДисконтИКорректировкаЭСП.ОценочныеДисконтПремия) Тогда 
								    //Купили с премией, а новая премия вдруг оказалась больше
									НовоеДвижение.ДисконтПремияНачисленный = 0; // ничего не делаем
									НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета = 0;
								Иначе
									НовоеДвижение.ДисконтПремияНачисленный = ДисконтИКорректировкаЭСП.ОценочныеДисконтПремия - СтрокаПриходныхПартий.ДисконтПремияНачисленный;
									СтрокаПриходныхПартий.ДисконтПремияНачисленный = ДисконтИКорректировкаЭСП.ОценочныеДисконтПремия;
									
									КурсНачисленияДисконтаПремии = Неопределено; // по умолчанию курс - текущий
									Если УчитыватьВсеЧастиСтоимостиПоФиксированномуКурсу И ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки <> 0 Тогда
										КурсНачисленияДисконтаПремии = ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки; // если есть то будет он, если нет, то будет неопределено и возьмется текущий
									КонецЕсли;
									
									СуммыВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
											Новый Структура("СуммаДвижение, СуммаОстаток", НовоеДвижение.ДисконтПремияНачисленный, СтрокаПриходныхПартий.ДисконтПремияНачисленный), 
											ДанныеПоЦеннойБумаге.ВалютаНоминала,
											ЭтотОбъект.Организация,
											ВыборкаДетальныеЗаписи.Период,
											КурсНачисленияДисконтаПремии,
											Отказ);
									
									НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета = СуммыВВалютеУчета.СуммаДвижение;
									СтрокаПриходныхПартий.ДисконтПремияНачисленныйВВалютеУчета = СуммыВВалютеУчета.СуммаОстаток;
									
								КонецЕсли;
								
								
								// 3. Начислим корректировку по ЭСП
								Если НастройкиДляУчетаКорректировкиЭСП.Найти(НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода) <> Неопределено И НЕ ЭтоКлиентЮгория Тогда
									
									НовоеДвижение.КорректировкаЭСП = ДисконтИКорректировкаЭСП.ОценочнаяКорректировкаЭСП - СтрокаПриходныхПартий.КорректировкаЭСП;
									СтрокаПриходныхПартий.КорректировкаЭСП = ДисконтИКорректировкаЭСП.ОценочнаяКорректировкаЭСП;
									
									КурсНачисленияКорректировкиЭСП = Неопределено; // по умолчанию курс - текущий
									Если УчитыватьВсеЧастиСтоимостиПоФиксированномуКурсу И ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки <> 0 Тогда
										КурсНачисленияКорректировкиЭСП = ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки; // если есть то будет он, если нет, то будет неопределено и возьмется текущий
									КонецЕсли;
									
									СуммыВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
											Новый Структура("СуммаДвижение, СуммаОстаток", НовоеДвижение.КорректировкаЭСП, СтрокаПриходныхПартий.КорректировкаЭСП), 
											ДанныеПоЦеннойБумаге.ВалютаНоминала,
											ЭтотОбъект.Организация,
											ВыборкаДетальныеЗаписи.Период,
											КурсНачисленияКорректировкиЭСП,
											Отказ);
									
									НовоеДвижение.КорректировкаЭСПВВалютеУчета = СуммыВВалютеУчета.СуммаДвижение;
									СтрокаПриходныхПартий.КорректировкаЭСПВВалютеУчета = СуммыВВалютеУчета.СуммаОстаток;
									
								КонецЕсли;
								
								НовоеДвижение.ПереоценкаКупонаСНачалаГода = НовоеДвижение.ПереоценкаКупонаВВалютеУчета;
								НовоеДвижение.КорректировкаЭСПСНачалаГода = НовоеДвижение.КорректировкаЭСПВВалютеУчета;
								НовоеДвижение.ДисконтПремияНачисленныйСНачалаГода = НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета;
								
								
								СтрокаПриходныхПартий.ПереоценкаКупонаСНачалаГода = СтрокаПриходныхПартий.ПереоценкаКупонаСНачалаГода + НовоеДвижение.ПереоценкаКупонаСНачалаГода;
								СтрокаПриходныхПартий.КорректировкаЭСПСНачалаГода = СтрокаПриходныхПартий.КорректировкаЭСПСНачалаГода + НовоеДвижение.КорректировкаЭСПСНачалаГода; 
								СтрокаПриходныхПартий.ДисконтПремияНачисленныйСНачалаГода = СтрокаПриходныхПартий.ДисконтПремияНачисленныйСНачалаГода + НовоеДвижение.ДисконтПремияНачисленныйСНачалаГода;
						        							
							КонецЕсли;
							
							
							// Теперь спишем часть тела, и при необходимости кусок дисконта 
							Если (СтрокаПриходныхПартий.ДисконтПремия >= 0)
								ИЛИ (НастройкиУчетаЦеннойБумаги.СтоимостьТелаРавнаНоминалу И СтрокаПриходныхПартий.ДисконтПремия < 0) Тогда 
								
								// купили с премией/по номиналу или купили с дисконтом но считаем его с минусом - все списываем с тела
								СуммаСписанияТела = СуммаСписанияНаОднуОблигацию * СтрокаПриходныхПартий.Количество;
								СуммаСписанияДисконта = 0;
								
							Иначе // купили с дисконтом - часть с тела, а часть с дисконта - считаем по ЭСП
								
								ДатаПокупки	= СтрокаПриходныхПартий.ДатаПокупки;
								ДатаПокупкиНачальная	= СтрокаПриходныхПартий.ДатаПокупкиНачальная;
								КорректировкаЭСПНачальная = СтрокаПриходныхПартий.КорректировкаЭСПНачальная;
								ЦенаПокупкиНачальная = СтрокаПриходныхПартий.СтоимостьПокупкиНачальная / СтрокаПриходныхПартий.Количество;
								
								//ДатаПокупки 			= БухгалтерскийУчетЕПС.ОпределитьДатуПокупкиПартии(СтрокаПриходныхПартий.Партия, СтрокаПриходныхПартий.СтрокаПартии, , МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ);
								ЦенаПокупки 			= СтрокаПриходныхПартий.СтоимостьПокупки / СтрокаПриходныхПартий.Количество;
								ТелоКСписанию 			= ОпределитьСуммуСписанияТелаПриАмортизации(СтрокаПриходныхПартий.ЦеннаяБумага, ВыборкаДетальныеЗаписи.Период, ДатаПокупкиНачальная, ЦенаПокупкиНачальная, СтрокаПриходныхПартий.ДисконтПремияНачисленный / СтрокаПриходныхПартий.Количество, НастройкиУчетаЦеннойБумаги);
								//ТелоКСписанию 			= ОпределитьСуммуСписанияТелаПриАмортизации(СтрокаПриходныхПартий.ЦеннаяБумага, ВыборкаДетальныеЗаписи.Период, ДатаПокупки, ЦенаПокупки, СтрокаПриходныхПартий.ДисконтПремияНачисленный / СтрокаПриходныхПартий.Количество, НастройкиУчетаЦеннойБумаги);
								СуммаСписанияТела 		= Окр(ТелоКСписанию * СтрокаПриходныхПартий.Количество, 2);
								СуммаСписанияДисконта 	= СуммаСписанияНаОднуОблигацию * СтрокаПриходныхПартий.Количество - СуммаСписанияТела;
								
								НовоеСписание = СписанияДисконтов.Добавить();
								
								НовоеСписание.Дата 		= НачалоДня(ВыборкаДетальныеЗаписи.Период);
								НовоеСписание.Партия 	= СтрокаПриходныхПартий.Партия;
								НовоеСписание.Сумма 	= СуммаСписанияДисконта;
								
							КонецЕсли;
							
							НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
							//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.Амортизация;
							
							НовоеДвижение.ЦеннаяБумага 		= СтрокаПриходныхПартий.ЦеннаяБумага;
							НовоеДвижение.УчетныйАктивЕПС 	= СтрокаПриходныхПартий.УчетныйАктивЕПС;
							НовоеДвижение.Партия 			= СтрокаПриходныхПартий.Партия;
							НовоеДвижение.СтрокаПартии 		= СтрокаПриходныхПартий.СтрокаПартии;
							НовоеДвижение.Рынок 			= СтрокаПриходныхПартий.Рынок;
							
							НовоеДвижение.ВидДвижения 	= Перечисления.ВидыДвижений.Расход;
							НовоеДвижение.Регистратор 	= ВыборкаДетальныеЗаписи.Регистратор;
							НовоеДвижение.Период 		= ВыборкаДетальныеЗаписи.Период;
							
							НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
							
							НовоеДвижение.Стоимость 							= СуммаСписанияТела;
							НовоеДвижение.СтоимостьВВалютеУчета					= РаботаСВалютами.ПолучитьСуммуВВалютеУчета(НовоеДвижение.Стоимость, ДанныеПоЦеннойБумаге.ВалютаНоминала, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период, Отказ);
							НовоеДвижение.ДисконтПремияНачисленный 				= СуммаСписанияДисконта;
							НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета	= РаботаСВалютами.ПолучитьСуммуВВалютеУчета(НовоеДвижение.ДисконтПремияНачисленный, ДанныеПоЦеннойБумаге.ВалютаНоминала, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период, Отказ);
							НовоеДвижение.ДисконтПремия			 				= -СуммаСписанияДисконта;
							ОстатокПослеСписанияДисконта 						= СтрокаПриходныхПартий.ДисконтПремияНачисленный - СуммаСписанияДисконта;
							ОстатокПослеСписанияДисконтаВВалютеУчета			= СтрокаПриходныхПартий.ДисконтПремияНачисленныйВВалютеУчета - НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета;
							
							
							//Если после списания суммы с дисконтапремии начисленной сумма стала меньше, чем сумма, начисленная за этот год, значит списали и дисконтпремию начисленную за этот год
							Если ОстатокПослеСписанияДисконта < 0 И НЕ НастройкиУчетаЦеннойБумаги.СтоимостьТелаРавнаНоминалу Тогда
								//Такая ошибка возникает когда мы купили облигацию с амортизацией номинала с дисконтом
								//и при частичном погашении номинала часть стоимости должна списаться с тела, а часть с дисконта
								//суммы списания рассчитываются в зависимости от методик и если возникает ситуация, когда с дисконта
								//нужно списать какую-то сумму, а на дисконте начислено меньше и после списания он уйдет в минус
								//то в этом случае расчет партий выдает такую ошибку
								//Но у УГМК "СтоимостьТелаРавнаНоминалу" = "Да"
								//Это значит, что при покупке с дисконтом мы отражаем на теле всю сумму номинала
								//А на дисконте отражаем отрицательное значение
								//При этой схеме всегда идет линейное начисление дисконта, без каких-то расчетов и списаний при амортизациях
								//Вся сумма амортизации уходит с тела
								//Поэтому, достаточно лишь отключить проверку ухода дисконта в минус (он и так всегда в минусах)  при частичном погашении облигации
								//Видимо, раньше таких ситуаций у УГМК не возникало
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При частичном погашении облигации " + СтрокаПриходныхПартий.ЦеннаяБумага + " по партии " + СтрокаПриходныхПартий.Партия + "/"  + СокрЛП(СтрокаПриходныхПартий.СтрокаПартии) + " сумма списания дисконта больше дисконта/премии начисл.", ВыборкаДетальныеЗаписи.Регистратор,,,Отказ);
							КонецЕсли; 
							НовоеДвижение.ДисконтПремияНачисленныйСНачалаГода 			= ?(ОстатокПослеСписанияДисконтаВВалютеУчета < СтрокаПриходныхПартий.ДисконтПремияНачисленныйСНачалаГода, СтрокаПриходныхПартий.ДисконтПремияНачисленныйСНачалаГода - ОстатокПослеСписанияДисконтаВВалютеУчета, 0);				
							
							СтрокаПриходныхПартий.ДисконтПремияНачисленный 				= СтрокаПриходныхПартий.ДисконтПремияНачисленный - НовоеДвижение.ДисконтПремияНачисленный;
							СтрокаПриходныхПартий.ДисконтПремияНачисленныйВВалютеУчета	= СтрокаПриходныхПартий.ДисконтПремияНачисленныйВВалютеУчета - НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета;
							СтрокаПриходныхПартий.Стоимость 							= СтрокаПриходныхПартий.Стоимость - СуммаСписанияТела;
							СтрокаПриходныхПартий.СтоимостьВВалютеУчета					= СтрокаПриходныхПартий.СтоимостьВВалютеУчета - НовоеДвижение.СтоимостьВВалютеУчета;
							СтрокаПриходныхПартий.ДисконтПремияНачисленныйСНачалаГода 	= СтрокаПриходныхПартий.ДисконтПремияНачисленныйСНачалаГода - НовоеДвижение.ДисконтПремияНачисленныйСНачалаГода;
							
							
							// 4. Если клиент отражает задолженность на счетах учета - добавим начисление задолженности по погашению тела
							Если НастройкиУчетаОбщие.ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
							
								НовоеДвижениеНачисленияЗадолженности = ЭтотОбъект.РассчитанныеПартии.Добавить();
								//НовоеДвижениеНачисленияЗадолженности.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.НачислениеЗадолженности;
								
								ЗаполнитьЗначенияСвойств(НовоеДвижениеНачисленияЗадолженности, НовоеДвижение, );
								
								НовоеДвижениеНачисленияЗадолженности.ВидДвижения = Перечисления.ВидыДвижений.Приход;
								
								СуммовыеПоля = Новый Структура(РесурсыРегистраПартийСодержащиеСуммы);
								Для каждого СуммовоеПоле Из СуммовыеПоля Цикл
									ИмяПоля = СуммовоеПоле.Ключ;
									НовоеДвижениеНачисленияЗадолженности[ИмяПоля] = 0;
								КонецЦикла;
								
								НовоеДвижениеНачисленияЗадолженности.ЗадолженностьПоПогашениюТела = НовоеДвижение.Стоимость + НовоеДвижение.ДисконтПремияНачисленный;
								НовоеДвижениеНачисленияЗадолженности.ЗадолженностьПоПогашениюТелаВВалютеУчета = НовоеДвижение.СтоимостьВВалютеУчета + НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета;
								
								СтрокаПриходныхПартий.ЗадолженностьПоПогашениюТела = НовоеДвижениеНачисленияЗадолженности.ЗадолженностьПоПогашениюТела;
								СтрокаПриходныхПартий.ЗадолженностьПоПогашениюТелаВВалютеУчета = НовоеДвижениеНачисленияЗадолженности.ЗадолженностьПоПогашениюТелаВВалютеУчета;
							
							КонецЕсли;
							
						КонецЦикла;

						Для каждого СтрокаПартийПроданныхВРЕПО Из ПартииПроданныеВРЕПО Цикл 
							
							Если СтрокаПартийПроданныхВРЕПО.ЦеннаяБумага <> ВыборкаДетальныеЗаписи.ЦеннаяБумага Тогда
								Продолжить;
							КонецЕсли;
							
							НовоеДвижениеПерекурсовка = Перекурсовка(
								ВыборкаДетальныеЗаписи.Регистратор,
								ЭтотОбъект.РассчитанныеПартииПрямоеРЕПО,
								ВыборкаДетальныеЗаписи.Период,
								СтрокаПартийПроданныхВРЕПО,
								СтрокаПартийПроданныхВРЕПО.Количество,
								ВыборкаДетальныеЗаписи.СтрокаПартии,
								,
								,
								,
								Отказ);
							
							// Обычно в день частичного погашения проходит ПогашениеКупона
							// поэтому ничего не делаем, но иногда бывает опс и погашения не было
							// погашения купона не было - нужно все дооценить и отдисконтировать
							//
							// Для всех приходных партий:
							// Если погашения не было
								// 1. Дооценим купон
								// 2. Начислим дисконт/премию
								// 3. Начислим корректировку по ЭСП
							// КонецЕсли
							// Теперь спишем часть тела, и при необходимости кусок дисконта 
							
							Если ЦенаПогашенияКупона = 0 Тогда 
								
								// 1. Дооценим купон
								НовоеДвижение = ДоначислитьКупонРЕПО(
									ВыборкаДетальныеЗаписи.Регистратор, 
									ВыборкаДетальныеЗаписи.Период,
									ЭтотОбъект.РассчитанныеПартииПрямоеРЕПО,
									СтрокаПартийПроданныхВРЕПО,
									СуммаКупонаНаОднуОблигацию,
									СтрокаПартийПроданныхВРЕПО.Количество,
									0,
									Отказ);
								
								Если Отказ Тогда
									Возврат;
								КонецЕсли;
								//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.ПереоценкаИНачислениеПроцентов;
																		
								СтрокаПартийПроданныхВРЕПО.ПереоценкаКупона = СтрокаПартийПроданныхВРЕПО.ПереоценкаКупона + НовоеДвижение.ПереоценкаКупона;
								СтрокаПартийПроданныхВРЕПО.ПереоценкаКупонаВВалютеУчета = СтрокаПартийПроданныхВРЕПО.ПереоценкаКупонаВВалютеУчета + НовоеДвижение.ПереоценкаКупонаВВалютеУчета;
								
								// 2. Начислим дисконт/премию
								ДатаПокупки	= СтрокаПартийПроданныхВРЕПО.ДатаПокупки;
								ДатаПокупкиНачальная	= СтрокаПартийПроданныхВРЕПО.ДатаПокупкиНачальная;
								КорректировкаЭСПНачальная = СтрокаПартийПроданныхВРЕПО.КорректировкаЭСПНачальная;
								ЦенаПокупкиНачальная = СтрокаПартийПроданныхВРЕПО.СтоимостьПокупкиНачальная / СтрокаПартийПроданныхВРЕПО.Количество;
								
								НачальныйДисконт  = Окр(СтрокаПартийПроданныхВРЕПО.ДисконтПремияПокупки / СтрокаПартийПроданныхВРЕПО.Количество, РазрядностьДробнойЧасти);
								
								Если ДанныеПоЦеннойБумаге.Амортизационная Тогда
									ЦенаПокупки	= Справочники.Облигации.ПолучитьНоминал(СтрокаПартийПроданныхВРЕПО.ЦеннаяБумага, ДатаПокупки) + НачальныйДисконт;
								Иначе
									ЦенаПокупки	= СтрокаПартийПроданныхВРЕПО.Номинал + НачальныйДисконт;
								КонецЕсли;
								ЦенаПокупкиКупона	= Окр(СтрокаПартийПроданныхВРЕПО.СтоимостьПокупкиКупона / СтрокаПартийПроданныхВРЕПО.Количество, РазрядностьДробнойЧасти);
									
								ДанныеПереоценки = Новый Структура("Количество, УчетныйАктивЕПС, Партия, СтрокаПартии");
								ЗаполнитьЗначенияСвойств(ДанныеПереоценки, СтрокаПартийПроданныхВРЕПО, "Количество, УчетныйАктивЕПС, Партия, СтрокаПартии");
								ДанныеПереоценки.Вставить("ДатаПереоценки", НачалоДня(ВыборкаДетальныеЗаписи.Период));
								ДанныеПереоценки.Вставить("ОценочнаяСуммаКупона", 0);
								ДанныеПереоценки.Вставить("БалансовыйДисконт", СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленный);
								ДанныеПереоценки.Вставить("БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", СтрокаПартийПроданныхВРЕПО.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные);
								ДанныеПереоценки.Вставить("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
								ДанныеПереоценки.Вставить("Стоимость", СтрокаПартийПроданныхВРЕПО.Стоимость);
								
								ДанныеПокупки = Новый Структура;
								ДанныеПокупки.Вставить("НачальныйДисконт", НачальныйДисконт);
								ДанныеПокупки.Вставить("ДатаПокупки", ДатаПокупки);
								ДанныеПокупки.Вставить("ДатаПокупкиНачальная", ДатаПокупкиНачальная);
								ДанныеПокупки.Вставить("КорректировкаЭСПНачальная", КорректировкаЭСПНачальная);
								ДанныеПокупки.Вставить("ЦенаПокупки", ЦенаПокупки);
								ДанныеПокупки.Вставить("НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", СтрокаПартийПроданныхВРЕПО.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная / СтрокаПартийПроданныхВРЕПО.Количество);
								ДанныеПокупки.Вставить("ЦенаПокупкиКупона", ЦенаПокупкиКупона);
								ДанныеПокупки.Вставить("ЦенаПокупкиНачальная", ЦенаПокупкиНачальная);

								ДисконтИКорректировкаЭСП = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремииИКорректировкуПоЭСПИРазницуПервоначальногоПризнания(СтрокаПартийПроданныхВРЕПО.ЦеннаяБумага, ДанныеПереоценки, ДанныеПокупки, НастройкиУчетаОбщие, Отказ);
								
								Если ДисконтИКорректировкаЭСП = Неопределено Тогда
									Возврат;
								КонецЕсли;
								
								Если НачальныйДисконт > 0 И СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленный < ДисконтИКорректировкаЭСП.ОценочныеДисконтПремия Тогда 
								    //Купили с премией, а новая премия вдруг оказалась больше
									НовоеДвижение.ДисконтПремияНачисленный = 0; // ничего не делаем
									НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета = 0;
								Иначе
									НовоеДвижение.ДисконтПремияНачисленный = ДисконтИКорректировкаЭСП.ОценочныеДисконтПремия - СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленный;
									СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленный = ДисконтИКорректировкаЭСП.ОценочныеДисконтПремия;
									
									КурсНачисленияДисконтаПремии = Неопределено; // по умолчанию курс - текущий
									Если УчитыватьВсеЧастиСтоимостиПоФиксированномуКурсу И ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки <> 0 Тогда
										КурсНачисленияДисконтаПремии = ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки; // если есть то будет он, если нет, то будет неопределено и возьмется текущий
									КонецЕсли;
									
									СуммыВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
											Новый Структура("СуммаДвижение, СуммаОстаток", НовоеДвижение.ДисконтПремияНачисленный, СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленный), 
											ДанныеПоЦеннойБумаге.ВалютаНоминала,
											ЭтотОбъект.Организация,
											ВыборкаДетальныеЗаписи.Период,
											КурсНачисленияДисконтаПремии,
											Отказ);
									
									НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета = СуммыВВалютеУчета.СуммаДвижение;
									СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленныйВВалютеУчета = СуммыВВалютеУчета.СуммаОстаток;
									
								КонецЕсли;
								
								
								// 3. Начислим корректировку по ЭСП
								Если НастройкиДляУчетаКорректировкиЭСП.Найти(НастройкиУчетаОбщие.ВариантУчетаКупонногоДохода) <> Неопределено Тогда
									
									НовоеДвижение.КорректировкаЭСП = ДисконтИКорректировкаЭСП.ОценочнаяКорректировкаЭСП - СтрокаПартийПроданныхВРЕПО.КорректировкаЭСП;
									СтрокаПартийПроданныхВРЕПО.КорректировкаЭСП = ДисконтИКорректировкаЭСП.ОценочнаяКорректировкаЭСП;
									
									КурсНачисленияКорректировкиЭСП = Неопределено; // по умолчанию курс - текущий
									Если УчитыватьВсеЧастиСтоимостиПоФиксированномуКурсу И ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки <> 0 Тогда
										КурсНачисленияКорректировкиЭСП = ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки; // если есть то будет он, если нет, то будет неопределено и возьмется текущий
									КонецЕсли;
									
									СуммыВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
											Новый Структура("СуммаДвижение, СуммаОстаток", НовоеДвижение.КорректировкаЭСП, СтрокаПартийПроданныхВРЕПО.КорректировкаЭСП), 
											ДанныеПоЦеннойБумаге.ВалютаНоминала,
											ЭтотОбъект.Организация,
											ВыборкаДетальныеЗаписи.Период,
											КурсНачисленияКорректировкиЭСП,
											Отказ);
									
									НовоеДвижение.КорректировкаЭСПВВалютеУчета = СуммыВВалютеУчета.СуммаДвижение;
									СтрокаПартийПроданныхВРЕПО.КорректировкаЭСПВВалютеУчета = СуммыВВалютеУчета.СуммаОстаток;
									
								КонецЕсли;
								
								НовоеДвижение.ПереоценкаКупонаСНачалаГода = НовоеДвижение.ПереоценкаКупонаВВалютеУчета;
								НовоеДвижение.КорректировкаЭСПСНачалаГода = НовоеДвижение.КорректировкаЭСПВВалютеУчета;
								НовоеДвижение.ДисконтПремияНачисленныйСНачалаГода = НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета;
								
								
								СтрокаПартийПроданныхВРЕПО.ПереоценкаКупонаСНачалаГода = СтрокаПартийПроданныхВРЕПО.ПереоценкаКупонаСНачалаГода + НовоеДвижение.ПереоценкаКупонаСНачалаГода;
								СтрокаПартийПроданныхВРЕПО.КорректировкаЭСПСНачалаГода = СтрокаПартийПроданныхВРЕПО.КорректировкаЭСПСНачалаГода + НовоеДвижение.КорректировкаЭСПСНачалаГода; 
								СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленныйСНачалаГода = СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленныйСНачалаГода + НовоеДвижение.ДисконтПремияНачисленныйСНачалаГода;
						        							
							КонецЕсли;
							
							
							// Теперь спишем часть тела, и при необходимости кусок дисконта 
							Если (СтрокаПартийПроданныхВРЕПО.ДисконтПремия >= 0)
								ИЛИ (НастройкиУчетаЦеннойБумаги.СтоимостьТелаРавнаНоминалу И СтрокаПартийПроданныхВРЕПО.ДисконтПремия < 0) Тогда 
								
								// купили с премией/по номиналу или купили с дисконтом но считаем его с минусом - все списываем с тела
								СуммаСписанияТела = СуммаСписанияНаОднуОблигацию * СтрокаПартийПроданныхВРЕПО.Количество;
								СуммаСписанияДисконта = 0;
								
							Иначе // купили с дисконтом - часть с тела, а часть с дисконта - считаем по ЭСП
								
								ДатаПокупки	= СтрокаПартийПроданныхВРЕПО.ДатаПокупки;
								ДатаПокупкиНачальная	= СтрокаПартийПроданныхВРЕПО.ДатаПокупкиНачальная;
								КорректировкаЭСПНачальная = СтрокаПартийПроданныхВРЕПО.КорректировкаЭСПНачальная;
								ЦенаПокупкиНачальная = СтрокаПартийПроданныхВРЕПО.СтоимостьПокупкиНачальная / СтрокаПартийПроданныхВРЕПО.Количество;
								
								//ДатаПокупки 			= БухгалтерскийУчетЕПС.ОпределитьДатуПокупкиПартии(СтрокаПартийПроданныхВРЕПО.Партия, СтрокаПартийПроданныхВРЕПО.СтрокаПартии, , МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ);
								ЦенаПокупки 			= СтрокаПартийПроданныхВРЕПО.СтоимостьПокупки / СтрокаПартийПроданныхВРЕПО.Количество;
								ТелоКСписанию 			= ОпределитьСуммуСписанияТелаПриАмортизации(СтрокаПартийПроданныхВРЕПО.ЦеннаяБумага, ВыборкаДетальныеЗаписи.Период, ДатаПокупкиНачальная, ЦенаПокупкиНачальная, СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленный / СтрокаПартийПроданныхВРЕПО.Количество, НастройкиУчетаЦеннойБумаги);
								//ТелоКСписанию 			= ОпределитьСуммуСписанияТелаПриАмортизации(СтрокаПартийПроданныхВРЕПО.ЦеннаяБумага, ВыборкаДетальныеЗаписи.Период, ДатаПокупки, ЦенаПокупки, СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленный / СтрокаПартийПроданныхВРЕПО.Количество, НастройкиУчетаЦеннойБумаги);
								СуммаСписанияТела 		= Окр(ТелоКСписанию * СтрокаПартийПроданныхВРЕПО.Количество, 2);
								СуммаСписанияДисконта 	= СуммаСписанияНаОднуОблигацию * СтрокаПартийПроданныхВРЕПО.Количество - СуммаСписанияТела;
								
								НовоеСписание = СписанияДисконтов.Добавить();
								
								НовоеСписание.Дата 		= НачалоДня(ВыборкаДетальныеЗаписи.Период);
								НовоеСписание.Партия 	= СтрокаПартийПроданныхВРЕПО.Партия;
								НовоеСписание.Сумма 	= СуммаСписанияДисконта;
								
							КонецЕсли;
							
							НовоеДвижение = ЭтотОбъект.РассчитанныеПартииПрямоеРЕПО.Добавить();
							//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.Амортизация;
							
							НовоеДвижение.ЦеннаяБумага 		= СтрокаПартийПроданныхВРЕПО.ЦеннаяБумага;
							НовоеДвижение.УчетныйАктивЕПС 	= СтрокаПартийПроданныхВРЕПО.УчетныйАктивЕПС;
							НовоеДвижение.Партия 			= СтрокаПартийПроданныхВРЕПО.Партия;
							НовоеДвижение.СтрокаПартии 		= СтрокаПартийПроданныхВРЕПО.СтрокаПартии;
							НовоеДвижение.Рынок 			= СтрокаПартийПроданныхВРЕПО.Рынок;
							
							НовоеДвижениеСписания.ПродажаРЕПО 		= СтрокаПартийПроданныхВРЕПО.ПродажаРЕПО;
							НовоеДвижениеСписания.СтрокаПродажиРЕПО	= СтрокаПартийПроданныхВРЕПО.СтрокаПродажиРЕПО;
							
							НовоеДвижение.ВидДвижения 	= Перечисления.ВидыДвижений.Расход;
							НовоеДвижение.Регистратор 	= ВыборкаДетальныеЗаписи.Регистратор;
							НовоеДвижение.Период 		= ВыборкаДетальныеЗаписи.Период;
							
							НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
							
							НовоеДвижение.Стоимость 							= СуммаСписанияТела;
							НовоеДвижение.СтоимостьВВалютеУчета					= РаботаСВалютами.ПолучитьСуммуВВалютеУчета(НовоеДвижение.Стоимость, ДанныеПоЦеннойБумаге.ВалютаНоминала, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период, Отказ);
							НовоеДвижение.ДисконтПремияНачисленный 				= СуммаСписанияДисконта;
							НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета	= РаботаСВалютами.ПолучитьСуммуВВалютеУчета(НовоеДвижение.ДисконтПремияНачисленный, ДанныеПоЦеннойБумаге.ВалютаНоминала, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период, Отказ);
							НовоеДвижение.ДисконтПремия			 				= -СуммаСписанияДисконта;
							
							ОстатокПослеСписанияДисконта 						= СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленный - СуммаСписанияДисконта;
							ОстатокПослеСписанияДисконтаВВалютеУчета			= СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленныйВВалютеУчета - НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета;
							
							НовоеДвижение.ДисконтПремияНачисленныйСНачалаГода 			= ?(ОстатокПослеСписанияДисконтаВВалютеУчета < СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленныйСНачалаГода, СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленныйСНачалаГода - ОстатокПослеСписанияДисконтаВВалютеУчета, 0);				
							
							СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленный 				= СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленный - НовоеДвижение.ДисконтПремияНачисленный;
							СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленныйВВалютеУчета	= СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленныйВВалютеУчета - НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета;
							СтрокаПартийПроданныхВРЕПО.Стоимость 							= СтрокаПартийПроданныхВРЕПО.Стоимость - СуммаСписанияТела;
							СтрокаПартийПроданныхВРЕПО.СтоимостьВВалютеУчета					= СтрокаПартийПроданныхВРЕПО.СтоимостьВВалютеУчета - НовоеДвижение.СтоимостьВВалютеУчета;
							СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленныйСНачалаГода 	= СтрокаПартийПроданныхВРЕПО.ДисконтПремияНачисленныйСНачалаГода - НовоеДвижение.ДисконтПремияНачисленныйСНачалаГода;
							
							
							// 4. Если клиент отражает задолженность на счетах учета - добавим начисление задолженности по погашению тела
							Если НастройкиУчетаОбщие.ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
							
								НовоеДвижениеНачисленияЗадолженности = ЭтотОбъект.РассчитанныеПартииПрямоеРЕПО.Добавить();
								//НовоеДвижениеНачисленияЗадолженности.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.НачислениеЗадолженности;
								
								ЗаполнитьЗначенияСвойств(НовоеДвижениеНачисленияЗадолженности, НовоеДвижение, );
								
								НовоеДвижениеНачисленияЗадолженности.ВидДвижения = Перечисления.ВидыДвижений.Приход;
								
								СуммовыеПоля = Новый Структура(РесурсыРегистраПартийСодержащиеСуммы);
								Для каждого СуммовоеПоле Из СуммовыеПоля Цикл
									ИмяПоля = СуммовоеПоле.Ключ;
									НовоеДвижениеНачисленияЗадолженности[ИмяПоля] = 0;
								КонецЦикла;
								
								НовоеДвижениеНачисленияЗадолженности.ЗадолженностьПоПогашениюТела = НовоеДвижение.Стоимость + НовоеДвижение.ДисконтПремияНачисленный;
								НовоеДвижениеНачисленияЗадолженности.ЗадолженностьПоПогашениюТелаВВалютеУчета = НовоеДвижение.СтоимостьВВалютеУчета + НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета;
								
								СтрокаПартийПроданныхВРЕПО.ЗадолженностьПоПогашениюТела = НовоеДвижениеНачисленияЗадолженности.ЗадолженностьПоПогашениюТела;
								СтрокаПартийПроданныхВРЕПО.ЗадолженностьПоПогашениюТелаВВалютеУчета = НовоеДвижениеНачисленияЗадолженности.ЗадолженностьПоПогашениюТелаВВалютеУчета;
							
							КонецЕсли;
							
						КонецЦикла;
						
					Иначе // полное погашение или оферта
						
						Если РассчитыватьСтоимости Тогда
							
							ОбязательныйРасчетДисконтаПремииДоОферты = Ложь;
							Если ВыборкаДетальныеЗаписи.ВидПогашения = Перечисления.ВидыПогашения.Оферта Тогда
								
								ТипОферты = Справочники.Облигации.ОпределитьТипОферты(ВыборкаДетальныеЗаписи.ЦеннаяБумага, ВыборкаДетальныеЗаписи.Период);
																						
								// Согласно разъяснению ЦБ РФ № 17-2-2-ОЭ/20820 от 22.07.2019 
								// в случае обязательного досрочного погашения необходимо полностью начислить все процентные доходы (дисконты-премию-корректировку)
								Если ТипОферты = Перечисления.ТипыОфертПоОблигациям.Досрочно И ВыборкаДетальныеЗаписи.Период >= '20190722' Тогда
									
									// эта настройка будет обработана в РассчитатьАмортизациюДисконтаПремииИКорректировкуПоЭСПИРазницуПервоначальногоПризнания
									// будем считать не до погашения, а до этой обязательной оферты
									ОбязательныйРасчетДисконтаПремииДоОферты = Истина;
								
								КонецЕсли;
							
							КонецЕсли;
							
							
							КурсПерекурсовки = Неопределено;
							
							СуммаНаОднуОблигацию = ВыборкаДетальныеЗаписи.Сумма / ВыборкаДетальныеЗаписи.Количество;
							СуммаКупонаНаОднуОблигацию = ВыборкаДетальныеЗаписи.СуммаКупона / ВыборкаДетальныеЗаписи.Количество;
							
							Если НЕ ДанныеПоЦеннойБумаге.ЭтоВалютнаяБумага Тогда // гасим рублевую в рублях - всё хорошо
								СуммаНаОднуОблигациюВВалютеУчета = СуммаНаОднуОблигацию;
								СуммаКупонаНаОднуОблигациюВВалютеУчета = СуммаКупонаНаОднуОблигацию;
							ИначеЕсли ВыборкаДетальныеЗаписи.ВалютаОплаты = ВалютаУчета Тогда
								// погашение валютной бумаги причем сумма в рублях... маразм, блин!
								СуммаНаОднуОблигациюВВалютеУчета = СуммаНаОднуОблигацию;
								СуммаКупонаНаОднуОблигациюВВалютеУчета = СуммаКупонаНаОднуОблигацию;
								
								СуммаНаОднуОблигацию = Справочники.Облигации.ПолучитьНоминал(ВыборкаДетальныеЗаписи.ЦеннаяБумага, НачалоДня(ВыборкаДетальныеЗаписи.Период));
								СуммаКупонаНаОднуОблигацию = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(ВыборкаДетальныеЗаписи.ЦеннаяБумага, НачалоДня(ВыборкаДетальныеЗаписи.Период), СчетДоверительногоУправленияДляУчета, Истина);
								
								//КурсПерекурсовки = СуммаНаОднуОблигациюВВалютеУчета / СуммаНаОднуОблигацию;
							Иначе
								
								СуммаНаОднуОблигациюВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ВыборкаДетальныеЗаписи.Сумма, ДанныеПоЦеннойБумаге.ВалютаНоминала, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период, Отказ) / ВыборкаДетальныеЗаписи.Количество;
								СуммаКупонаНаОднуОблигациюВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ВыборкаДетальныеЗаписи.СуммаКупона, ДанныеПоЦеннойБумаге.ВалютаНоминала, ЭтотОбъект.Организация, ВыборкаДетальныеЗаписи.Период, Отказ) / ВыборкаДетальныеЗаписи.Количество;
								
							КонецЕсли;
							
					       // хардкод для банкрота вейла
					       // с 31.12.2022 у Эволюции купон списан и равен 0, Будущее пока банкроство не признало
					       Если ВыборкаДетальныеЗаписи.Период >= '20221231' И ЭтоКлиентЭволюция Тогда
							   Если ВыборкаДетальныеЗаписи.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВейлФинанс") Тогда
								   
									СуммаКупонаНаОднуОблигацию = 0;
									СуммаКупонаНаОднуОблигациюВВалютеУчета = 0;
									
					           КонецЕсли;
					       КонецЕсли;
							
							Если ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки <> 0 Тогда
							
								КурсНачисленияКупона = ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки;
								
							ИначеЕсли КурсПерекурсовки <> Неопределено Тогда
								
								КурсНачисленияКупона = КурсПерекурсовки;
								
							Иначе
								
								КурсНачисленияКупона = 0;
							
							КонецЕсли;
						
						КонецЕсли;
						
						Перекурсовывать = Истина;
						Если ВыборкаДетальныеЗаписи.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1Пропертиз_До2")
							И НачалоДня(ВыборкаДетальныеЗаписи.Период) = '20240514' Тогда
						
							Перекурсовывать = Ложь;
						
						КонецЕсли;
						
						ПриходныеПартииКУдалению = Новый Массив;
						
						//Для всех приходных партий:
						// Мы можем гасить по оферте, и купон гасится отдельно, а можем и по конечному погашению, тогда купон вместе 
						// Если конечное погашение
						// 		1. Дооценим купон
						// 		2. Начислим дисконт/премию
						// 		3. Начислим корректировку по ЭСП
						// КонецЕсли
						// 
						Для каждого СтрокаПриходныхПартий Из ПриходныеПартии Цикл
							
							НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
								НастройкиУчетаОбщие,
								СтрокаПриходныхПартий.ЦеннаяБумага,
								СтрокаПриходныхПартий.УчетныйАктивЕПС,
								СтрокаПриходныхПартий.Партия,
								СтрокаПриходныхПартий.СтрокаПартии);
							
							Если ОбязательныйРасчетДисконтаПремииДоОферты = Истина Тогда
								НастройкиУчетаЦеннойБумаги.РассчитыватьДисконтПремиюДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоОферты;
							КонецЕсли;
							
							Если РассчитыватьСтоимости Тогда
							
								Если Перекурсовывать Тогда
								
									НовоеДвижениеПерекурсовка = Перекурсовка(ВыборкаДетальныеЗаписи.Регистратор, ЭтотОбъект.РассчитанныеПартии, ВыборкаДетальныеЗаписи.Период, СтрокаПриходныхПартий, СтрокаПриходныхПартий.Количество, ВыборкаДетальныеЗаписи.СтрокаПартии, КурсПерекурсовки,,, Отказ);
								
								КонецЕсли;
								
								Если СуммаКупонаНаОднуОблигацию <> 0 Или НЕ БылоПогашениеКупонаПоБумагеВЭтомПериоде Тогда //если 0 то это оферта и есть погашение купона, оно и начислит
									
									// 1. Дооценим купон
									НовоеДвижение = ДоначислитьКупон(ВыборкаДетальныеЗаписи.Регистратор, 
																			ВыборкаДетальныеЗаписи.Период, 
																			СтрокаПриходныхПартий,
																			СуммаКупонаНаОднуОблигацию,
																			СтрокаПриходныхПартий.Количество,
																			КурсНачисленияКупона,
																			0,
																			Ложь,
																			Отказ);
									//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.ПереоценкаИНачислениеПроцентов;
									
									СтрокаПриходныхПартий.ПереоценкаКупона = СтрокаПриходныхПартий.ПереоценкаКупона + НовоеДвижение.ПереоценкаКупона;
									СтрокаПриходныхПартий.ПереоценкаКупонаВВалютеУчета = СтрокаПриходныхПартий.ПереоценкаКупонаВВалютеУчета + НовоеДвижение.ПереоценкаКупонаВВалютеУчета;
									
									Если НастройкиУчетаЦеннойБумаги.ПереоцениватьОблигацииПриПолномПогашении 
										И НЕ ДанныеПоЦеннойБумаге.ИндексируемыйНоминал Тогда // у таких облигаций отдельная тема ниже
									
										// Переоценка тела
										НовоеДвижение.Переоценка = -СтрокаПриходныхПартий.Переоценка;
										НовоеДвижение.ПереоценкаВВалютеУчета = -СтрокаПриходныхПартий.ПереоценкаВВалютеУчета;
										НовоеДвижение.ПереоценкаСНачалаГода = НовоеДвижение.ПереоценкаВВалютеУчета;
										Если НовоеДвижение.ПереоценкаВВалютеУчета > 0 Тогда
											НовоеДвижение.ПереоценкаСНачалаГодаПоложительная = НовоеДвижение.ПереоценкаВВалютеУчета;
										КонецЕсли;
										
										СтрокаПриходныхПартий.Переоценка = СтрокаПриходныхПартий.Переоценка + НовоеДвижение.Переоценка;
										СтрокаПриходныхПартий.ПереоценкаВВалютеУчета = СтрокаПриходныхПартий.ПереоценкаВВалютеУчета + НовоеДвижение.ПереоценкаВВалютеУчета;
										СтрокаПриходныхПартий.ПереоценкаСНачалаГода = СтрокаПриходныхПартий.ПереоценкаСНачалаГода + НовоеДвижение.ПереоценкаСНачалаГода;
										Если НовоеДвижение.ПереоценкаСНачалаГодаПоложительная > 0 Тогда
											СтрокаПриходныхПартий.ПереоценкаСНачалаГодаПоложительная = СтрокаПриходныхПартий.ПереоценкаСНачалаГодаПоложительная + НовоеДвижение.ПереоценкаСНачалаГодаПоложительная;
										КонецЕсли;
									
									КонецЕсли; 
									
									// 2. Начислим дисконт/премию
									ДатаПокупки	= СтрокаПриходныхПартий.ДатаПокупки;
									ДатаПокупкиНачальная	= СтрокаПриходныхПартий.ДатаПокупкиНачальная;
									КорректировкаЭСПНачальная = СтрокаПриходныхПартий.КорректировкаЭСПНачальная;
									ЦенаПокупкиНачальная = СтрокаПриходныхПартий.СтоимостьПокупкиНачальная / СтрокаПриходныхПартий.Количество;
									
									Если ДатыИЦеныПокупки = Неопределено Тогда
										
										НачальныйДисконт  = Окр(СтрокаПриходныхПартий.ДисконтПремияПокупки / СтрокаПриходныхПартий.Количество, РазрядностьДробнойЧасти);
										
										Если ДанныеПоЦеннойБумаге.Амортизационная Тогда
											ЦенаПокупки	= Справочники.Облигации.ПолучитьНоминал(СтрокаПриходныхПартий.ЦеннаяБумага, ДатаПокупки) + НачальныйДисконт;
										Иначе
											ЦенаПокупки	= СтрокаПриходныхПартий.Номинал + НачальныйДисконт;
										КонецЕсли;
										ЦенаПокупкиКупона	= Окр(СтрокаПриходныхПартий.СтоимостьПокупкиКупона / СтрокаПриходныхПартий.Количество, РазрядностьДробнойЧасти);
										
									Иначе
										
										ДатаИЦенаПокупки = ДатыИЦеныПокупки.НайтиСтроки(Новый Структура("НомерСтроки", СтрокаПриходныхПартий.НомерСтроки));
										
										НачальныйДисконт 	= ДатаИЦенаПокупки[0].НачальныйДисконт;
										ЦенаПокупки 		= ДатаИЦенаПокупки[0].ЦенаПокупки;
										ЦенаПокупкиКупона 	= ДатаИЦенаПокупки[0].ЦенаКупона;
										
									КонецЕсли;

									РассчитыватьКорректировкуЭСП = НастройкиДляУчетаКорректировкиЭСП.Найти(НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода) <> Неопределено	// или клиент считает корректировку ЭСП по всем видам активов
																	ИЛИ СтрокаПриходныхПартий.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость;						// или это вид актива, предполагающий расчет корректировки ЭСП
									
									Если РассчитыватьКорректировкуЭСП Тогда
										НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода = Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке;	// принудительно посчитать ЭСП
									КонецЕсли; 																	
									
									ДанныеПереоценки = Новый Структура("Количество, УчетныйАктивЕПС, Партия, СтрокаПартии");
									ЗаполнитьЗначенияСвойств(ДанныеПереоценки, СтрокаПриходныхПартий, "Количество, УчетныйАктивЕПС, Партия, СтрокаПартии");
									ДанныеПереоценки.Вставить("ДатаПереоценки", НачалоДня(ВыборкаДетальныеЗаписи.Период));
									ДанныеПереоценки.Вставить("ОценочнаяСуммаКупона", 0);
									Если ВыборкаДетальныеЗаписи.ВидПогашения = Перечисления.ВидыПогашения.Оферта	// бумага гасится по оферте
										И РассчитыватьКорректировкуЭСП												// это АС ная бумага и корректировку ЭСП считаем
										И ОпределитьСтоимостьКупонаВМоментАмортизации(ВыборкаДетальныеЗаписи.ЦеннаяБумага, ВыборкаДетальныеЗаписи.Период) = 0 Тогда // И самое важно что гасим НЕ в день окончания купонного периода
									
										ДанныеПереоценки.Вставить("ОценочнаяСуммаКупона", СуммаКупонаНаОднуОблигацию * СтрокаПриходныхПартий.Количество); // то хвостик купона нужно обязательно включить в АС!
									
									КонецЕсли;
									
									ДанныеПереоценки.Вставить("БалансовыйДисконт", СтрокаПриходныхПартий.ДисконтПремияНачисленный);
									ДанныеПереоценки.Вставить("БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные);
									ДанныеПереоценки.Вставить("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
									ДанныеПереоценки.Вставить("Стоимость", СтрокаПриходныхПартий.Стоимость);
									
									ДанныеПокупки = Новый Структура;
									ДанныеПокупки.Вставить("НачальныйДисконт", НачальныйДисконт);
									ДанныеПокупки.Вставить("ДатаПокупки", ДатаПокупки);
									ДанныеПокупки.Вставить("ДатаПокупкиНачальная", ДатаПокупкиНачальная);
									ДанныеПокупки.Вставить("КорректировкаЭСПНачальная", КорректировкаЭСПНачальная);
									ДанныеПокупки.Вставить("ЦенаПокупки", ЦенаПокупки);
									ДанныеПокупки.Вставить("НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная / СтрокаПриходныхПартий.Количество);
									ДанныеПокупки.Вставить("ЦенаПокупкиКупона", ЦенаПокупкиКупона);
									ДанныеПокупки.Вставить("ЦенаПокупкиНачальная", ЦенаПокупкиНачальная);
									
									ДисконтИКорректировкаЭСП = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремииИКорректировкуПоЭСПИРазницуПервоначальногоПризнания(СтрокаПриходныхПартий.ЦеннаяБумага, ДанныеПереоценки, ДанныеПокупки, НастройкиУчетаЦеннойБумаги, Отказ);
									
									Если ДисконтИКорректировкаЭСП = Неопределено Тогда
										Возврат;
									КонецЕсли;
									
									Если НачальныйДисконт > 0 
										И СтрокаПриходныхПартий.ДисконтПремияНачисленный < ДисконтИКорректировкаЭСП.ОценочныеДисконтПремия Тогда 
									    //Купили с премией, а новая премия вдруг оказалась больше
										НовоеДвижение.ДисконтПремияНачисленный = 0; // ничего не делаем
										НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета = 0; // ничего не делаем
									Иначе
										НовоеДвижение.ДисконтПремияНачисленный = ДисконтИКорректировкаЭСП.ОценочныеДисконтПремия - СтрокаПриходныхПартий.ДисконтПремияНачисленный;
										СтрокаПриходныхПартий.ДисконтПремияНачисленный = ДисконтИКорректировкаЭСП.ОценочныеДисконтПремия;
										
										Если НачальныйДисконт < 0 И ДанныеПоЦеннойБумаге.Амортизационная Тогда // купили с дисконтом + амортизационная
											// проверим расхождения, могут появиться, из-за округлений начислиляется не дополной стоимости
											Расхождение = СтрокаПриходныхПартий.ДисконтПремияНачисленный + СтрокаПриходныхПартий.Стоимость - СуммаНаОднуОблигацию * СтрокаПриходныхПартий.Количество;
											Если Расхождение < 0 Тогда
												
												НовоеДвижение.ДисконтПремияНачисленный = НовоеДвижение.ДисконтПремияНачисленный - Расхождение;
												СтрокаПриходныхПартий.ДисконтПремияНачисленный = СтрокаПриходныхПартий.ДисконтПремияНачисленный - Расхождение;
											
											КонецЕсли;
											
										КонецЕсли;
										
										КурсНачисленияДисконтаПремии = Неопределено; // по умолчанию курс - текущий
										Если УчитыватьВсеЧастиСтоимостиПоФиксированномуКурсу И ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки <> 0 Тогда
											КурсНачисленияДисконтаПремии = ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки; // если есть то будет он, если нет, то будет неопределено и возьмется текущий
										КонецЕсли;
										
										СуммыВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
												Новый Структура("СуммаДвижение, СуммаОстаток", НовоеДвижение.ДисконтПремияНачисленный, СтрокаПриходныхПартий.ДисконтПремияНачисленный), 
												ДанныеПоЦеннойБумаге.ВалютаНоминала,
												ЭтотОбъект.Организация,
												ВыборкаДетальныеЗаписи.Период,
												КурсНачисленияДисконтаПремии,
												Отказ);
										
										НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета = СуммыВВалютеУчета.СуммаДвижение;
										СтрокаПриходныхПартий.ДисконтПремияНачисленныйВВалютеУчета = СуммыВВалютеУчета.СуммаОстаток;
																											
									КонецЕсли;																			
									
									// 3. Начислим корректировку по ЭСП
									Если РассчитыватьКорректировкуЭСП Тогда
										
										Если СтрокаПриходныхПартий.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость
											И СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN084")
											И СтрокаПриходныхПартий.ЦеннаяБумага <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВЭБ.РФ_291") Тогда
											
											НовоеДвижение.КорректировкаЭСП = ДисконтИКорректировкаЭСП.ОценочнаяКорректировкаЭСП - СтрокаПриходныхПартий.КорректировкаЭСП - СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная;
											СтрокаПриходныхПартий.КорректировкаЭСП = ДисконтИКорректировкаЭСП.ОценочнаяКорректировкаЭСП - СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная;
											
										Иначе
											
											НовоеДвижение.КорректировкаЭСП = ДисконтИКорректировкаЭСП.ОценочнаяКорректировкаЭСП - СтрокаПриходныхПартий.КорректировкаЭСП;
											СтрокаПриходныхПартий.КорректировкаЭСП = ДисконтИКорректировкаЭСП.ОценочнаяКорректировкаЭСП;
											
										КонецЕсли;
										
										
										КурсНачисленияКорректировкиЭСП = Неопределено; // по умолчанию курс - текущий
										Если УчитыватьВсеЧастиСтоимостиПоФиксированномуКурсу И ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки <> 0 Тогда
											КурсНачисленияКорректировкиЭСП = ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки; // если есть то будет он, если нет, то будет неопределено и возьмется текущий
										КонецЕсли;
										
										СуммыВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
												Новый Структура("СуммаДвижение, СуммаОстаток", НовоеДвижение.КорректировкаЭСП, СтрокаПриходныхПартий.КорректировкаЭСП), 
												ДанныеПоЦеннойБумаге.ВалютаНоминала,
												ЭтотОбъект.Организация,
												ВыборкаДетальныеЗаписи.Период,
												КурсНачисленияКорректировкиЭСП,
												Отказ);
										
										НовоеДвижение.КорректировкаЭСПВВалютеУчета = СуммыВВалютеУчета.СуммаДвижение;
										СтрокаПриходныхПартий.КорректировкаЭСПВВалютеУчета = СуммыВВалютеУчета.СуммаОстаток;
										
										НовоеДвижение.КорректировкаЭСПСНачалаГода = НовоеДвижение.КорректировкаЭСПВВалютеУчета;
										СтрокаПриходныхПартий.КорректировкаЭСПСНачалаГода = СтрокаПриходныхПартий.КорректировкаЭСПСНачалаГода + НовоеДвижение.КорректировкаЭСПСНачалаГода; 
										
									КонецЕсли;
									
									
									// 4. Начислим корректировку ПП
									НовоеДвижение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = ДисконтИКорректировкаЭСП.ОценочнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные - СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные;
									СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = ДисконтИКорректировкаЭСП.ОценочнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные;
										
									КурсНачисленияКорректировкиПП = Неопределено; // по умолчанию курс - текущий
									Если УчитыватьВсеЧастиСтоимостиПоФиксированномуКурсу И ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки <> 0 Тогда
										КурсНачисленияКорректировкиПП = ДанныеПоЦеннойБумаге.ФиксированныйКурсПереоценки; // если есть то будет он, если нет, то будет неопределено и возьмется текущий
									КонецЕсли;
									
									СуммыВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
											Новый Структура("СуммаДвижение, СуммаОстаток", НовоеДвижение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные, СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные), 
											ДанныеПоЦеннойБумаге.ВалютаНоминала,
											ЭтотОбъект.Организация,
											ВыборкаДетальныеЗаписи.Период,
											КурсНачисленияКорректировкиПП,
											Отказ);
									
									НовоеДвижение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета = СуммыВВалютеУчета.СуммаДвижение;
									СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета = СуммыВВалютеУчета.СуммаОстаток;
									
									
									// 5. Начислим переоценку купона
									НовоеДвижение.ПереоценкаКупонаСНачалаГода = НовоеДвижение.ПереоценкаКупонаВВалютеУчета;
									НовоеДвижение.ДисконтПремияНачисленныйСНачалаГода = НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета;
									
									СтрокаПриходныхПартий.ПереоценкаКупонаСНачалаГода = СтрокаПриходныхПартий.ПереоценкаКупонаСНачалаГода + НовоеДвижение.ПереоценкаКупонаСНачалаГода;
									СтрокаПриходныхПартий.ДисконтПремияНачисленныйСНачалаГода = СтрокаПриходныхПартий.ДисконтПремияНачисленныйСНачалаГода + НовоеДвижение.ДисконтПремияНачисленныйСНачалаГода;
									
									// 6. Начислим индексацию номинала, если соответствующие настройки
									Если ДанныеПоЦеннойБумаге.ИндексируемыйНоминал Тогда
										
										НоминальнаяСтоимостьКПогашению = СуммаНаОднуОблигацию * СтрокаПриходныхПартий.Количество;
										
										Если (НастройкиПоВидуУчета.ВариантУчетаИндексацииНоминала = Перечисления.ВариантыУчетаИндексированногоНоминала.ОтНачальногоНоминала
											ИЛИ НастройкиПоВидуУчета.ВариантУчетаИндексацииНоминала = Перечисления.ВариантыУчетаИндексированногоНоминала.ОтНоминалаПриПокупке) Тогда
											
											ТекущаяНоминальнаяСтоимость = СтрокаПриходныхПартий.Стоимость
												+ СтрокаПриходныхПартий.ДисконтПремияНачисленный
												+ СтрокаПриходныхПартий.КорректировкаЭСП
												+ СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные
												+ СтрокаПриходныхПартий.ИндексацияНоминала;
												
											НачислитьИндексацииНоминала = НоминальнаяСтоимостьКПогашению - ТекущаяНоминальнаяСтоимость;
											
											НовоеДвижение.ИндексацияНоминала = НачислитьИндексацииНоминала;
											НовоеДвижение.ИндексацияНоминалаСНачалаГода = НачислитьИндексацииНоминала;
											
											СтрокаПриходныхПартий.ИндексацияНоминала = СтрокаПриходныхПартий.ИндексацияНоминала + НовоеДвижение.ИндексацияНоминала;
											СтрокаПриходныхПартий.ИндексацияНоминалаСНачалаГода = СтрокаПриходныхПартий.ИндексацияНоминалаСНачалаГода + НовоеДвижение.ИндексацияНоминалаСНачалаГода;
											
										Иначе // если настройка НеУчитывать, то индексация в переоценке и начисляем на переоценку
											
											ТекущаяНоминальнаяСтоимость = СтрокаПриходныхПартий.Стоимость
												+ СтрокаПриходныхПартий.ДисконтПремияНачисленный
												+ СтрокаПриходныхПартий.КорректировкаЭСП
												+ СтрокаПриходныхПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные
												+ СтрокаПриходныхПартий.Переоценка;
												
											НачислитьИндексацииНоминала = НоминальнаяСтоимостьКПогашению - ТекущаяНоминальнаяСтоимость;
											
											НовоеДвижение.Переоценка = НачислитьИндексацииНоминала;
											НовоеДвижение.ПереоценкаВВалютеУчета = НачислитьИндексацииНоминала;
											НовоеДвижение.ПереоценкаСНачалаГода = НачислитьИндексацииНоминала;
											Если НовоеДвижение.ПереоценкаВВалютеУчета > 0 Тогда
												НовоеДвижение.ПереоценкаСНачалаГодаПоложительная = НачислитьИндексацииНоминала;
											КонецЕсли;
											
											СтрокаПриходныхПартий.Переоценка = СтрокаПриходныхПартий.Переоценка + НовоеДвижение.Переоценка;
											СтрокаПриходныхПартий.ПереоценкаВВалютеУчета = СтрокаПриходныхПартий.ПереоценкаВВалютеУчета + НовоеДвижение.ПереоценкаВВалютеУчета;
											СтрокаПриходныхПартий.ПереоценкаСНачалаГода = СтрокаПриходныхПартий.ПереоценкаСНачалаГода + НовоеДвижение.ПереоценкаСНачалаГода;
											Если НовоеДвижение.ПереоценкаСНачалаГодаПоложительная > 0 Тогда
												СтрокаПриходныхПартий.ПереоценкаСНачалаГодаПоложительная = СтрокаПриходныхПартий.ПереоценкаСНачалаГодаПоложительная + НовоеДвижение.ПереоценкаСНачалаГодаПоложительная;
											КонецЕсли;
											
										КонецЕсли;
										
									КонецЕсли;
									
								КонецЕсли;
								
							КонецЕсли;
							
							// какие-либо списания проводим если стоит настройка СписыватьПриПолномПогашенииВМоментПогашения
							Если НастройкиУчетаОбщие.СписыватьПриПолномПогашенииВМоментПогашения Тогда
							
								НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
								//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.СписаниеПартии;
								
								ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаПриходныхПартий);
								НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Расход;
								НовоеДвижение.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
								НовоеДвижение.Период = ВыборкаДетальныеЗаписи.Период;
								НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
								
								Если ВыборкаДетальныеЗаписи.Период < БухгалтерскийУчетПовтИсп.ДатаСКоторойПерестаемСписыватьКоличествоВМоментПолногоПогашения() Тогда
								
									ПриходныеПартииКУдалению.Добавить(СтрокаПриходныхПартий);	// приходная партия уходит
									
								Иначе
									
									НовоеДвижение.Количество = 0; // не списываем количество
									
									// у приходной партии обнуляем суммы, но не количество
									Для каждого СуммовоеПоле Из Новый Структура(РесурсыРегистраПартийСодержащиеСуммы) Цикл
										СтрокаПриходныхПартий[СуммовоеПоле.Ключ] = 0;
									КонецЦикла;
									
								КонецЕсли;
								
							ИначеЕсли ПогашенияНесписанныеИНеоплаченныеВТотЖеДень.Найти(ВыборкаДетальныеЗаписи.Регистратор) <> Неопределено Тогда
							// если стоит настройка УчитыватьПогашенныеОблигацииДоПрекращенияПризнанияПоНоминалу
							// и по этому погашения в день погашения не было ни оплаты, ни списания
							// то мы должны списать переоценку и только ее
								НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
								//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.СписаниеПартии;
								
								НовоеДвижение.ЦеннаяБумага 		= СтрокаПриходныхПартий.ЦеннаяБумага;
								НовоеДвижение.УчетныйАктивЕПС 	= СтрокаПриходныхПартий.УчетныйАктивЕПС;
								НовоеДвижение.Партия	 		= СтрокаПриходныхПартий.Партия;
								НовоеДвижение.СтрокаПартии 		= СтрокаПриходныхПартий.СтрокаПартии;
								НовоеДвижение.Рынок 			= СтрокаПриходныхПартий.Рынок;
								
								НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Расход;
								НовоеДвижение.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
								НовоеДвижение.Период = ВыборкаДетальныеЗаписи.Период;
								НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
								
								НовоеДвижение.Переоценка 							= СтрокаПриходныхПартий.Переоценка;
								НовоеДвижение.ПереоценкаВВалютеУчета 				= СтрокаПриходныхПартий.ПереоценкаВВалютеУчета;
								НовоеДвижение.ПереоценкаСНачалаГода 				= СтрокаПриходныхПартий.ПереоценкаСНачалаГода;
								НовоеДвижение.ПереоценкаСНачалаГодаПоложительная	= СтрокаПриходныхПартий.ПереоценкаСНачалаГодаПоложительная;
								
							КонецЕсли;
							// во всех остальных случаях списание сумм будет идти в оплате или списании (в том, что раньше), а количество спишет списание
							
						КонецЦикла;
						
						УдалялиПриходныеПартии = Ложь;
						Для каждого СтрокаПриходныхПартийКУдалению Из ПриходныеПартииКУдалению Цикл
							ПриходныеПартии.Удалить(СтрокаПриходныхПартийКУдалению);
							УдалялиПриходныеПартии = Истина;
						КонецЦикла;
						
						Если УдалялиПриходныеПартии Тогда
							ПриходныеПартииКоличество = ПриходныеПартии.Количество();
							Для Инд = 1 По ПриходныеПартииКоличество Цикл
								ПриходныеПартии[Инд - 1].НомерСтроки = Инд;
							КонецЦикла;
						КонецЕсли;
						
					КонецЕсли;					
				
				КонецЕсли; 

			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") И ДанныеПоЦеннойБумаге.ЭтоИСУ Тогда
				
				// т.к. по погашению паев вообще говоря не предполагается распределение по Активам ЕПС
				// то списываем приходные партии подряд
				
				КоличествоКСписанию = ВыборкаДетальныеЗаписи.Количество;
				ПриходныеПартииКУдалению = Новый Массив;
				
				Для каждого СтрокаПриходныхПартий Из ПриходныеПартии Цикл
					
					Если СтрокаПриходныхПартий.Количество <= КоличествоКСписанию Тогда
						КоличествоКСписаниюПартии = СтрокаПриходныхПартий.Количество;
					Иначе
						КоличествоКСписаниюПартии = КоличествоКСписанию;
					КонецЕсли;
					
					Если РассчитыватьСтоимости Тогда
					
						НовоеДвижениеПерекурсовка = Перекурсовка(ВыборкаДетальныеЗаписи.Регистратор, ЭтотОбъект.РассчитанныеПартии, ВыборкаДетальныеЗаписи.Период, СтрокаПриходныхПартий, КоличествоКСписаниюПартии, ВыборкаДетальныеЗаписи.СтрокаПартии,,,, Отказ);
					
					КонецЕсли;
						
					НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
					//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.СписаниеПартии;
					
					ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаПриходныхПартий);
					
					НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Расход;
					НовоеДвижение.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
					НовоеДвижение.Период = ВыборкаДетальныеЗаписи.Период;
					НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
					
					Если СтрокаПриходныхПартий.Количество <= КоличествоКСписанию Тогда
						
						КоличествоКСписанию = КоличествоКСписанию - СтрокаПриходныхПартий.Количество;
						ПриходныеПартииКУдалению.Добавить(СтрокаПриходныхПартий); // списали её всю
						
					Иначе //спишем пропорционально
						
						КоэффициентСписания = КоличествоКСписанию / СтрокаПриходныхПартий.Количество;
						
						НовоеДвижение.Количество = КоличествоКСписанию;
						
						Если РассчитыватьСтоимости Тогда
						
							НовоеДвижение.СтоимостьПокупки = СтрокаПриходныхПартий.СтоимостьПокупки * КоэффициентСписания;
							
							НовоеДвижение.Стоимость = СтрокаПриходныхПартий.Стоимость * КоэффициентСписания;
							НовоеДвижение.СтоимостьВВалютеУчета = СтрокаПриходныхПартий.СтоимостьВВалютеУчета * КоэффициентСписания;
							НовоеДвижение.Переоценка = СтрокаПриходныхПартий.Переоценка * КоэффициентСписания;
							НовоеДвижение.ПереоценкаВВалютеУчета = СтрокаПриходныхПартий.ПереоценкаВВалютеУчета * КоэффициентСписания;
							НовоеДвижение.ПереоценкаСНачалаГода = СтрокаПриходныхПартий.ПереоценкаСНачалаГода * КоэффициентСписания;
							НовоеДвижение.ПереоценкаСНачалаГодаПоложительная = СтрокаПриходныхПартий.ПереоценкаСНачалаГодаПоложительная * КоэффициентСписания;
							НовоеДвижение.КурсовыеРазницыСНачалаГода = СтрокаПриходныхПартий.КурсовыеРазницыСНачалаГода * КоэффициентСписания;
							
							
							СтрокаПриходныхПартий.СтоимостьПокупки = СтрокаПриходныхПартий.СтоимостьПокупки - НовоеДвижение.СтоимостьПокупки;
							
							СтрокаПриходныхПартий.Стоимость = СтрокаПриходныхПартий.Стоимость - НовоеДвижение.Стоимость;
							СтрокаПриходныхПартий.СтоимостьВВалютеУчета = СтрокаПриходныхПартий.СтоимостьВВалютеУчета - НовоеДвижение.СтоимостьВВалютеУчета;
							СтрокаПриходныхПартий.Переоценка = СтрокаПриходныхПартий.Переоценка - НовоеДвижение.Переоценка;
							СтрокаПриходныхПартий.ПереоценкаВВалютеУчета = СтрокаПриходныхПартий.ПереоценкаВВалютеУчета - НовоеДвижение.ПереоценкаВВалютеУчета;
							СтрокаПриходныхПартий.ПереоценкаСНачалаГода = СтрокаПриходныхПартий.ПереоценкаСНачалаГода - НовоеДвижение.ПереоценкаСНачалаГода;
							СтрокаПриходныхПартий.ПереоценкаСНачалаГодаПоложительная = СтрокаПриходныхПартий.ПереоценкаСНачалаГодаПоложительная - НовоеДвижение.ПереоценкаСНачалаГодаПоложительная;
							СтрокаПриходныхПартий.КурсовыеРазницыСНачалаГода = СтрокаПриходныхПартий.КурсовыеРазницыСНачалаГода - НовоеДвижение.КурсовыеРазницыСНачалаГода;
							
						КонецЕсли;
						
						СтрокаПриходныхПартий.Количество = СтрокаПриходныхПартий.Количество - НовоеДвижение.Количество;
						
						КоличествоКСписанию = 0;
					
					КонецЕсли;
					
					// не списываем количество
					// оно будет в списании списываться
					НовоеДвижение.Количество = 0;
					
					Если КоличествоКСписанию = 0 Тогда
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
				Если КоличествоКСписанию > 0 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не распределилась:" + Строка(ВыборкаДетальныеЗаписи.ЦеннаяБумага) + " по " + Строка(ВыборкаДетальныеЗаписи.Регистратор), ВыборкаДетальныеЗаписи.Регистратор);
					Сообщить(КоличествоКСписанию);
					Отказ = Истина;
				КонецЕсли;
				
				УдалялиПриходныеПартии = Ложь;
				Для каждого СтрокаПриходныхПартийКУдалению Из ПриходныеПартииКУдалению Цикл
					ПриходныеПартии.Удалить(СтрокаПриходныхПартийКУдалению);
					УдалялиПриходныеПартии = Истина;
				КонецЦикла;
				
				Если УдалялиПриходныеПартии Тогда
					ПриходныеПартииКоличество = ПриходныеПартии.Количество();
					Для Инд = 1 По ПриходныеПартииКоличество Цикл
						ПриходныеПартии[Инд - 1].НомерСтроки = Инд;
					КонецЦикла;
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.НачислениеСписаниеРезервов") Тогда
				
				// #315386 - резервы участвуют в динамическом расчете - это нужно для СЧА
				
				СтрокиПриходныхПартий = ПриходныеПартии.НайтиСтроки(Новый Структура("ЦеннаяБумага,Партия,СтрокаПартии", 
																						ВыборкаДетальныеЗаписи.ЦеннаяБумага, 
																						ВыборкаДетальныеЗаписи.Партия, 
																						ВыборкаДетальныеЗаписи.СтрокаПартии));
																						
				Если СтрокиПриходныхПартий.Количество() <> 1 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет партий для резерва:" + Строка(ВыборкаДетальныеЗаписи.ЦеннаяБумага) + " по " + Строка(ВыборкаДетальныеЗаписи.Регистратор), ВыборкаДетальныеЗаписи.Регистратор);
					Сообщить(КоличествоКСписанию);
					Отказ = Истина;
				Иначе

					СтрокаПриходныхПартий = СтрокиПриходныхПартий[0];
					
					// Поскольку резервы теперь разделены + контроль необходимости идет в само документе резервов, то в данном месте никаких контролей делать не нужно
				
					СуммаНачисленияРезерва = ВыборкаДетальныеЗаписи.СуммаРезервовПодОбесценение - СтрокаПриходныхПартий.СуммаРезервовПодОбесценение;
					
					СтрокаПриходныхПартий.СуммаРезервовПодОбесценение = ВыборкаДетальныеЗаписи.СуммаРезервовПодОбесценение;
					
					НовоеДвижение = ЭтотОбъект.РассчитанныеПартии.Добавить();
					
					ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаПриходныхПартий, "УчетныйАктивЕПС,Рынок,ЦеннаяБумага,Партия,СтрокаПартии");
					
					НовоеДвижение.ВидДвижения = Перечисления.ВидыДвижений.Приход;
					НовоеДвижение.Регистратор = ВыборкаДетальныеЗаписи.Регистратор;
					НовоеДвижение.Период = ВыборкаДетальныеЗаписи.Период;
					НовоеДвижение.СтрокаКорзиныЦенныхБумаг = ВыборкаДетальныеЗаписи.СтрокаПартии;
					
					НовоеДвижение.СуммаРезервовПодОбесценение = СуммаНачисленияРезерва;
				
				КонецЕсли;					
				
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.РеклассификацияАктивовЕПС") Тогда
				
				ПриходныеПартииКУдалению = Новый Массив;
				
				СтрокиПриходныхПартий = ПриходныеПартии.НайтиСтроки(Новый Структура("ЦеннаяБумага,Партия,СтрокаПартии", 
																						ВыборкаДетальныеЗаписи.ЦеннаяБумага, 
																						ВыборкаДетальныеЗаписи.Партия, 
																						ВыборкаДетальныеЗаписи.СтрокаПартии));
				Если СтрокиПриходныхПартий.Количество() <> 1 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет партий для реклассификации:" + Строка(ВыборкаДетальныеЗаписи.ЦеннаяБумага) + " по " + Строка(ВыборкаДетальныеЗаписи.Регистратор), ВыборкаДетальныеЗаписи.Регистратор);
					Отказ = Истина;
					Возврат;
				Иначе
