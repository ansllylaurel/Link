Функция ОпределитьКоээффициентЧастичногоСписания(ЦеннаяБумага, Период)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	1 - НоминалыЦенныхБумаг.Номинал / (НоминалыЦенныхБумаг.Номинал + НоминалыЦенныхБумаг.СуммаИзменения) КАК Коэффициент
		|ИЗ
		|	РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|ГДЕ
		|	НоминалыЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага
		|	И НоминалыЦенныхБумаг.Период = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)";

	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Коэффициент;
	Иначе
		Возврат 1;
	КонецЕсли;

