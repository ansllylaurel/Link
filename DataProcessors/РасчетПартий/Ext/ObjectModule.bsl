Функция ПолучитьКомиссииПоПокупкам_БУНУ()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.Основание КАК Основание
		|ПОМЕСТИТЬ _СделкиПокупкиСКомиссией
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&ОкончаниеПериода,
		|			Период,
		|			ДвиженияИГраницыПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В (&СписокСтратегий)
		|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии))
		|				И ТИПЗНАЧЕНИЯ(Основание) = ТИП(Документ.Сделка)
		|				И ВЫРАЗИТЬ(Основание КАК Документ.Сделка).ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)) КАК ЗадолженностиПоДенежнымСредствамОстаткиИОбороты
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗадолженностиПоЦеннымБумагамОстаткиИОбороты.Основание
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&ОкончаниеПериода,
		|			Период,
		|			ДвиженияИГраницыПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В (&СписокСтратегий)
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|				И ТИПЗНАЧЕНИЯ(Основание) = ТИП(Документ.Сделка)
		|				И ВЫРАЗИТЬ(Основание КАК Документ.Сделка).ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)) КАК ЗадолженностиПоЦеннымБумагамОстаткиИОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделки.Основание КАК Основание,
		|	ЗадолженностиПоДенежнымСредствам.Период КАК Период,
		|	ЗадолженностиПоДенежнымСредствам.Регистратор КАК Регистратор,
		|	ЗадолженностиПоДенежнымСредствам.ВидДвижения КАК ВидДвижения,
		|	ЗадолженностиПоДенежнымСредствам.Валюта КАК Валюта,
		|	ЗадолженностиПоДенежнымСредствам.Сумма КАК Сумма,
		|	КурсыВалют.Курс КАК Курс
		|ИЗ
		|	_СделкиПокупкиСКомиссией КАК Сделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|		ПО Сделки.Основание = ЗадолженностиПоДенежнымСредствам.Основание
		|			И (ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (ЗадолженностиПоДенежнымСредствам.Валюта = КурсыВалют.Валюта)
		|			И (НАЧАЛОПЕРИОДА(ЗадолженностиПоДенежнымСредствам.Период, ДЕНЬ) = КурсыВалют.Период)
		|ГДЕ
		|	НЕ ЗадолженностиПоДенежнымСредствам.Период ЕСТЬ NULL
		|
		|УПОРЯДОЧИТЬ ПО
		|	Основание,
		|	Период";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.НачалоПериода));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ЭтотОбъект.КонецПериода));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
	Запрос.УстановитьПараметр("СписокСтратегий", СписокСтратегий);

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьПоставкиПоПокупкам_БУНУ()

	// Это для случая внебиржевых сделок, фильтр идет по раздельному исполнению
	// т.к. лучшего фильтра не нашел
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЗадолженностиПоЦеннымБумагамОстаткиИОбороты.Основание КАК Основание
		|ПОМЕСТИТЬ _Сделки
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&ОкончаниеПериода,
		|			Период,
		|			ДвиженияИГраницыПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В (&СписокСтратегий)
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|				И ТИПЗНАЧЕНИЯ(Основание) = ТИП(Документ.Сделка)
		|				И ВЫРАЗИТЬ(Основание КАК Документ.Сделка).ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|				И ВЫРАЗИТЬ(Основание КАК Документ.Сделка).РаздельноеИсполнение) КАК ЗадолженностиПоЦеннымБумагамОстаткиИОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Сделки.Основание КАК Основание,
		|	ЗадолженностиПоЦеннымБумагам.ВидДвижения КАК ВидДвижения,
		|	ЗадолженностиПоЦеннымБумагам.Регистратор КАК Регистратор,
		|	ЗадолженностиПоЦеннымБумагам.Количество КАК Количество,
		|	ЗадолженностиПоЦеннымБумагам.Период КАК Период
		|ИЗ
		|	_Сделки КАК _Сделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоЦеннымБумагам КАК ЗадолженностиПоЦеннымБумагам
		|		ПО _Сделки.Основание = ЗадолженностиПоЦеннымБумагам.Основание
		|
		|УПОРЯДОЧИТЬ ПО
		|	Основание,
		|	Период";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.НачалоПериода));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ЭтотОбъект.КонецПериода));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
	Запрос.УстановитьПараметр("СписокСтратегий", СписокСтратегий);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция РассчитатьРасходыПриПокупкеВСтоимости_БУНУ(ЦеннаяБумага, ВалютаНоминала, ВыборкаДетальныеЗаписи, КомиссииПоПокупкам, ПоставкиПоПокупкам)

	// ПОНЯТИЕ:
	// Признавать(применяемо к комиссии) - отправлять на стоимость бумаги
	
	//Как все будет работать:
	//1. Смотрим включаются ли комиссии в стоимость
	//2. Если включаются то формируем таблицу комиссий
	//3. Если не включаются то не формируем таблицу комиссий
	//4. Таблица будет иметь следующие колонки: 
	//	Сделка - это понятно что
	//	Документ начисления комиссии - либо начисление, либо сама сделка (для торговой комиссии)
	//	Валюта комиссии - это тоже понятно
	//	Сумма комиссии - это либо сумма оплаты комиссии, либо неоплаченая комиссия на конец периода
	//	Документ оплаты комиссии - либо оплата, либо Неопределено если это остаток неоплаченной
	//5. Собираем комиссию просто:
	//	Получим сделки по которым были остатки на начало + движуха по комиссии и бумагам
	//	Джойним к ним начисления, оплаты и остатки
	//	Важно! Берем только сделки покупки
	//6. Дальше просто - при расчете партий, когда приходуем партию получаем из таблицы комиссий строки
	//7. Из этих строк расчитываем комиссию
	//8. Возможна одна сложность - поставка идет частями и тут нужно определять какая у нас часть
	//9. Но вероятность этого КРАЙНЕ мала, поэтому тут можно сделать запрос, чтобы это выяснить
	//10.Все!
	
	
	ПолноеИсполнение = Истина; // нет частичной поставки
	
	Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.Сделка") Тогда
		
		Сделка = ВыборкаДетальныеЗаписи.Регистратор;
		
	ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
		
		Сделка = ВыборкаДетальныеЗаписи.Регистратор.Основание;
		
	ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг") Тогда
		
		Сделка = ВыборкаДетальныеЗаписи.Регистратор.Основание;
		
		СтрокиПоставок = ПоставкиПоПокупкам.НайтиСтроки(Новый Структура("Основание", Сделка));
		Если СтрокиПоставок.Количество() = 2 Тогда // Самый частый и простой вариант: одна сделка - одна поставка
			
			Если СтрокиПоставок[0].Количество <> СтрокиПоставок[1].Количество Тогда
				ПолноеИсполнение = Ложь;
			КонецЕсли;
			
		Иначе // начали считать
			ПолноеИсполнение = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	НачисленоРуб = 0;
	НачисленоВал = 0;
	
	ОплаченоРуб = 0;
	ОплаченоВал = 0;
	
	СтрокиКомиссии = КомиссииПоПокупкам.НайтиСтроки(Новый Структура("Основание", Сделка));
	
	Для каждого СтрокаКомиссии Из СтрокиКомиссии Цикл
		
		Если СтрокаКомиссии.Период > КонецДня(ВыборкаДетальныеЗаписи.Период) Тогда
			Прервать;
		КонецЕсли;
		
		СуммаРуб = СтрокаКомиссии.Сумма * СтрокаКомиссии.Курс;
		СуммаВал = РаботаСВалютами.ПересчетСуммыВВалюте(СуммаРуб, ЭтотОбъект.Организация.ВалютаУчета, СтрокаКомиссии.Период, ВалютаНоминала, СтрокаКомиссии.Период);
		
		
	#Область РасчетЧастичнойПоставки
		
		Если НЕ ПолноеИсполнение Тогда // редчайший случай, когда у нас идет частичная поставка
			
			КоличествоКПоставке = 0; // Количество бумаг по сделке
			КоличествоПоставлено = 0;
			
			СуммаРубПризнано = 0; // расчитаем, сколько уже признали расходов
			СуммаВалПризнано = 0;
			
			Для каждого СтрокаПоставок Из СтрокиПоставок Цикл
			
				Если СтрокаПоставок.ВидДвижения = ВидДвиженияНакопления.Приход Тогда // это сделка или 
				
					КоличествоКПоставке = КоличествоКПоставке + СтрокаПоставок.Количество;
					
				Иначе
					
					КоличествоПоставлено = КоличествоПоставлено + СтрокаПоставок.Количество;

					Если СтрокаПоставок.Регистратор = ВыборкаДетальныеЗаписи.Регистратор Тогда // Наша поставка
						
						Если КоличествоПоставлено = КоличествоКПоставке Тогда // наша поставка последняя - заметаем все под коврик
							
							СуммаРуб = СуммаРуб - СуммаРубПризнано;
							СуммаВал = СуммаВал - СуммаВалПризнано;
							
						Иначе
							
							СуммаРуб = Окр(СуммаРуб / КоличествоКПоставке * СтрокаПоставок.Количество);
							СуммаВал = Окр(СуммаВал / КоличествоКПоставке * СтрокаПоставок.Количество);
						
						КонецЕсли;
						
						Прервать;
						
					Иначе // это мы считаем, сколько мы признавали при предыдущих поставках
						
						СуммаРубПризнано = Окр(СуммаРуб / КоличествоКПоставке * СтрокаПоставок.Количество);
						СуммаВалПризнано = Окр(СуммаВал / КоличествоКПоставке * СтрокаПоставок.Количество);
						
					КонецЕсли;
					
				КонецЕсли;
			
			КонецЦикла;
		
		КонецЕсли;
		
	#КонецОбласти		
		
		Если СтрокаКомиссии.ВидДвижения = ВидДвиженияНакопления.Приход Тогда // начисление
			
			НачисленоРуб = НачисленоРуб + СуммаРуб;
			
		Иначе // оплата
			
			ОплаченоРуб = ОплаченоРуб + СуммаРуб;
			ОплаченоВал = ОплаченоВал + СуммаВал;
			
		КонецЕсли;
		
	КонецЦикла;
	
	НачисленоРуб = НачисленоРуб - ОплаченоРуб;
	НачисленоВал = РаботаСВалютами.ПересчетСуммыВВалюте(НачисленоРуб, ЭтотОбъект.Организация.ВалютаУчета, ВыборкаДетальныеЗаписи.Период, ВалютаНоминала, ВыборкаДетальныеЗаписи.Период);
	
	Возврат Новый Структура("РасходыПриПокупкеВСтоимости, РасходыПриПокупкеВСтоимостиВВалютеУчета", ОплаченоВал + НачисленоВал, ОплаченоРуб + НачисленоРуб);
	
КонецФункции

Функция ЗаполнитьНестандартныеДвиженияПартий()

	МакетДанных = ЭтотОбъект.ПолучитьМакет("НестандартныеДвиженияПартий");
	
	ТаблицаНестандартныеДвиженияПартий = ЭтотОбъект.РассчитанныеПартии.Выгрузить();
	ТаблицаНестандартныеДвиженияПартий.Очистить();
	
	ТаблицаНестандартныеДвиженияПартий.Колонки.Добавить("Содержание", Новый ОписаниеТипов("Строка"));
	
	Для ИндексСтрок = 2 По МакетДанных.ВысотаТаблицы Цикл
	
		Если СокрЛп(ЭтотОбъект.ВидУчета) <> СокрЛП(МакетДанных.Область(ИндексСтрок, 6).Текст) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтотОбъект.Организация <> ЗначениеИзСтрокиВнутр(МакетДанных.Область(ИндексСтрок, 4).Текст) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтотОбъект.СчетДоверительногоУправления <> ЗначениеИзСтрокиВнутр(МакетДанных.Область(ИндексСтрок, 5).Текст) Тогда
			Продолжить;
		КонецЕсли;
		
		ПериодДвижения = Дата(МакетДанных.Область(ИндексСтрок, 3).Текст);
		
		Если ПериодДвижения < ЭтотОбъект.НачалоПериода ИЛИ ПериодДвижения > ЭтотОбъект.КонецПериода Тогда
		    Продолжить;
		КонецЕсли;
		
		СтрокаТаблицаНестандартныеДвиженияПартий = ТаблицаНестандартныеДвиженияПартий.Добавить();
		
		Для ИндексКолонок = 1 По МакетДанных.ШиринаСтраницы Цикл
		
			ИмяКолонки = МакетДанных.Область(1, ИндексКолонок).Текст;
			
			Значение = МакетДанных.Область(ИндексСтрок, ИндексКолонок).Текст;
			Если Значение = "" Тогда
				Продолжить;
			КонецЕсли;
			
			Если ИмяКолонки = "Регистратор" Тогда
				СтрокаТаблицаНестандартныеДвиженияПартий.Регистратор = ЗначениеИзСтрокиВнутр(Значение);
			ИначеЕсли ИмяКолонки = "ВидДвижения" Тогда
				СтрокаТаблицаНестандартныеДвиженияПартий.ВидДвижения = ?(Значение = "Расход", ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход);
			ИначеЕсли ИмяКолонки = "Период" Тогда
				СтрокаТаблицаНестандартныеДвиженияПартий.Период = Дата(Значение);
			ИначеЕсли ИмяКолонки = "Организация" Тогда
			ИначеЕсли ИмяКолонки = "СчетДоверительногоУправления" Тогда
			ИначеЕсли ИмяКолонки = "ВидУчета" Тогда
			ИначеЕсли ИмяКолонки = "Рынок" Тогда
				СтрокаТаблицаНестандартныеДвиженияПартий.Рынок = Перечисления.РынкиЦенныхБумаг[Значение];
			ИначеЕсли ИмяКолонки = "ЦеннаяБумага" Тогда
				СтрокаТаблицаНестандартныеДвиженияПартий.ЦеннаяБумага = ЗначениеИзСтрокиВнутр(Значение);
			ИначеЕсли ИмяКолонки = "Партия" Тогда
				СтрокаТаблицаНестандартныеДвиженияПартий.Партия = ЗначениеИзСтрокиВнутр(Значение);
			ИначеЕсли ИмяКолонки = "УчетныйАктивЕПС" Тогда
				СтрокаТаблицаНестандартныеДвиженияПартий.УчетныйАктивЕПС = ЗначениеИзСтрокиВнутр(Значение);
			//ИначеЕсли ИмяКолонки = "СписаниеПогрешностиОкругления" Тогда
			//	СтрокаТаблицаНестандартныеДвиженияПартий.СписаниеПогрешностиОкругления = ?(Значение = "Нет", Ложь, Истина);
			ИначеЕсли ИмяКолонки = "Содержание" Тогда
				СтрокаТаблицаНестандартныеДвиженияПартий.Содержание = Значение;
			Иначе
				СтрокаТаблицаНестандартныеДвиженияПартий[ИмяКолонки] = Число(Значение);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаНестандартныеДвиженияПартий;

КонецФункции

Функция ПолучитьИзмененияКурсовВалют()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КурсыВалют.Период КАК Период,
		|	КурсыВалют.Валюта КАК Валюта,
		|	КурсыВалют.Курс КАК Курс,
		|	КурсыВалют.Кратность КАК Кратность
		|ПОМЕСТИТЬ _КурсыЗаПериод
		|ИЗ
		|	РегистрСведений.КурсыВалют КАК КурсыВалют
		|ГДЕ
		|	КурсыВалют.Период >= &НачалоВзятия
		|	И КурсыВалют.Период <= &ОкончаниеПериода
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Валюта,
		|	Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Периоды.Период КАК Период,
		|	МАКСИМУМ(_ПредыдущиеПериоды.Период) КАК ПредыдущийПериод,
		|	_Периоды.Валюта КАК Валюта
		|ПОМЕСТИТЬ _Периоды
		|ИЗ
		|	_КурсыЗаПериод КАК _Периоды
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыЗаПериод КАК _ПредыдущиеПериоды
		|		ПО _Периоды.Валюта = _ПредыдущиеПериоды.Валюта
		|			И _Периоды.Период > _ПредыдущиеПериоды.Период
		|ГДЕ
		|	_Периоды.Период >= &НачалоПериода
		|
		|СГРУППИРОВАТЬ ПО
		|	_Периоды.Валюта,
		|	_Периоды.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_Периоды.Валюта КАК Валюта,
		|	_Периоды.Период КАК Период,
		|	ВЫБОР
		|		КОГДА _КурсыЗаПериод.Курс = _КурсыЗаПредыдущийПериод.Курс
		|				И _КурсыЗаПериод.Кратность = _КурсыЗаПредыдущийПериод.Кратность
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК КурсИзменился
		|ИЗ
		|	_Периоды КАК _Периоды
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыЗаПериод КАК _КурсыЗаПериод
		|		ПО _Периоды.Валюта = _КурсыЗаПериод.Валюта
		|			И _Периоды.Период = _КурсыЗаПериод.Период
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыЗаПериод КАК _КурсыЗаПредыдущийПериод
		|		ПО _Периоды.Валюта = _КурсыЗаПредыдущийПериод.Валюта
		|			И _Периоды.ПредыдущийПериод = _КурсыЗаПредыдущийПериод.Период";
	
	Запрос.УстановитьПараметр("НачалоВзятия", НачалоДня(ЭтотОбъект.НачалоПериода) - 24 * 60 * 60);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.НачалоПериода));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ЭтотОбъект.КонецПериода));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

