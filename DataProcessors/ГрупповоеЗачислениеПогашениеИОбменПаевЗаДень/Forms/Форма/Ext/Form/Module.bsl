#Область События_элементов_формы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ПаевойИнвестиционныйФонд) Тогда
		ПаевойИнвестиционныйФондПриИзменении(Неопределено);	
	КонецЕсли;	
	
	ОчиститьТаблицы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт

	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	Объект.ПаевойИнвестиционныйФонд 	= "";
	Объект.СчетДоверительногоУправления = "";
	
	ОбновитьПараметрыПИФНаСервере();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПаевойИнвестиционныйФондПриИзменении(Элемент)
	
	Объект.СчетДоверительногоУправления = СчетДоверительногоУправленияПИФ(Объект.ПаевойИнвестиционныйФонд, Объект.Дата);
	ОбновитьПараметрыПИФНаСервере();	
	
	ОчиститьТаблицы();
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаСервереБезКонтекста
Функция СчетДоверительногоУправленияПИФ(ПаевойИнвестиционныйФонд, Дата)

	Возврат Справочники.СчетаДоверительногоУправления.СчетДоверительногоУправленияКлиента(ПаевойИнвестиционныйФонд, Дата);
	
КонецФункции

&НаСервере
Процедура СформироватьДокументыНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ОбработкаОбъект.СформироватьЗачисленияПаев();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьФлажки(ИмяТаблицы, Установить)
	
	Для Каждого ТекСтрока Из Объект[ИмяТаблицы] Цикл
		ТекСтрока.Обрабатывать = Установить;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ОбработкаОбъект.ЗаполнитьЗачисленияПаев();
	Объект.ЗачисленияПаев.Загрузить(ОбработкаОбъект.ЗачисленияПаев.Выгрузить());
	
	ОбработкаОбъект.ЗаполнитьПогашенияПаев();	
	Объект.ПогашенияПаев.Загрузить(ОбработкаОбъект.ПогашенияПаев.Выгрузить());
	
	ОбработкаОбъект.ЗаполнитьОбменыПаев();	
	Объект.ОбменыПаев.Загрузить(ОбработкаОбъект.ОбменыПаев.Выгрузить());
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьПараметрыПИФНаСервере()
	
	Если Объект.Дата <> '00010101' И ЗначениеЗаполнено(Объект.ПаевойИнвестиционныйФонд) Тогда
		
		ПараметрыРасчета = РегистрыСведений.УсловияПравилПаевогоИнвестиционногоФонда.ПараметрыРасчетаНадбавокИСкидок(Объект.ПаевойИнвестиционныйФонд, Объект.Дата);
		
		ЗаполнитьЗначенияСвойств(Объект, ПараметрыРасчета);
				
		Объект.РасчетнаяСтоимостьПая 	= РегистрыСведений.ФинансовыеПоказатели.РасчетнаяСтоимостьПаяНаДату(Объект.Организация, 
																				Объект.СчетДоверительногоУправления, 
																				Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, Объект.Дата, -2));
	Иначе
		
		Объект.СтавкаНадбавки				= 0;
		Объект.РасчетнаяСтоимостьПая		= 0;
		Объект.ПрименяютсяНадбавкиИСкидки	= Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТаблицы()
	
	Если Объект.ЗачисленияПаев.Количество() > 0 Тогда 
		Объект.ЗачисленияПаев.Очистить();	
	КонецЕсли;
	
	Если Объект.ПогашенияПаев.Количество() > 0 Тогда 
		Объект.ПогашенияПаев.Очистить();	
	КонецЕсли;
	
	Если Объект.ОбменыПаев.Количество() > 0 Тогда 
		Объект.ОбменыПаев.Очистить();	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти



