
Процедура ЗагрузитьДанныеОтДКРегион(Организация, Дата, ПаевойИнвестиционныйФонд, Задача, Отказ) Экспорт
	
	ОбменДаннымиСДК = Обработки.ОбменДаннымиСДКРегион.Создать();
	
	ОбменДаннымиСДК.Дата						= Дата;
	ОбменДаннымиСДК.Организация					= Организация;                                                   
	ОбменДаннымиСДК.ПаевойИнвестиционныйФонд	= ПаевойИнвестиционныйФонд;	
	ОбменДаннымиСДК.Задача						= Задача;
		
	ОбменДаннымиСДК.ЗагрузитьДанные(Отказ);
			
КонецПроцедуры
