		ТекДок.Variables("Организация").Value=СокрЛП(Объект.Организация);
		ТекДок.Variables("КодКлиента").Value=Данные.Код;
		ТекДок.Variables("ДатаДоговораБрокер").Value=Данные.ДатаДоговора;
		ТекДок.Variables("НомерДоговораБрокер").Value=Данные.НомерДоговора;
		ТекДок.Variables("РегНомер").Value=Данные.РегНомер;
		ТекДок.Variables("ISIN").Value=Данные.ISIN;
		ТекДок.Variables("Эмитент").Value=Данные.Эмитент;
		ТекДок.Variables("Количество").Value=СтрТабл.Количество;
		ТекДок.Variables("Процент").Value=Данные.ЦенаПроцент;
		ТекДок.Variables("Сумма").Value=Формат(СтрТабл.Сумма,"ЧЦ=17; ЧДЦ=2");
		ТекДок.Variables("Валюта").Value=Данные.валюта;
		ТекДок.Variables("СрокДействия").Value=Данные.ДатаВыкупа;
		ТекДок.Variables("Подписант").Value=СокрЛП(данные.Должность)+"  "+СокрЛП(Объект.Подписант);
		ТекДок.Variables("Доверенность").Value=" "+СокрЛП(Данные.основаниеПолномочий);	
		ТекДок.Variables("ДатаПоручения").Value=Формат(Объект.ДатаПоручения,"ДЛФ=DD");
		ТекДок.Variables("НомерПоручения").Value=СформироватьНомерПоручения(Данные);
		ТекДок.Variables("Серия").Value=Данные.Серия;
		ТекДок.Variables("ДополнительныеИнструкции").Value="Оферта, дата проведения "+Формат(Объект.ДатаОферты,"ДФ=dd.MM.yyyy");

		ТекДок.Fields.Update();
		Word.ActiveWindow.View.ShowFieldCodes = False;
		Word.Visible=Истина;
		
	КонецЦикла;

КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обработка 'Печать оферт' не используется и не работает",,,, Отказ);
	Возврат;
	
	ЗаполнитьЗначенияСвойств(Объект, Параметры);
	
	Если Параметры.Свойство("ПогашенияПлановые") тогда
		Для Каждого СтрокаПогашениеПланов Из Параметры.ПогашенияПлановые Цикл
			Если Не СтрокаПогашениеПланов.Флажок Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаПогашениеПланов.Брокер = Объект.Брокер Тогда
				ЗаполнитьЗначенияСвойств(Объект.СчетаДоверительногоУправления.Добавить(), СтрокаПогашениеПланов);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Объект.СчетаДоверительногоУправления.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбрано ни одного счета доверительного управления с брокером " + Объект.Брокер,,,, Отказ);
		Возврат;
	КонецЕсли;
	
	Если      Объект.Тип = "Поручение по ГПБ" Тогда
		Элементы.Агент.Видимость = Истина;
		Элементы.Срок.Видимость  = Истина;
	ИначеЕсли Объект.Тип = "Поручение БК Регион" Или Объект.Тип = "Отмена поручения БК Регион" Тогда
		Элементы.ДатаПоручения.Видимость = Истина;
		Объект.ДатаПоручения = ТекущаяДата();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		СотрудникиОрганизации = ПолучитьСотрудниковОрганизации(Объект.Организация);
		Элементы.Подписант.СписокВыбора.ЗагрузитьЗначения(СотрудникиОрганизации);
	КонецЕсли;
	
	 ЭтаФорма.Заголовок = Объект.Тип;
		
КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("Печать");
	Попытка
		ВыполнитьПечать(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПечать(ПараметрыСессии)
	
	Если      Объект.Тип = "Поручение по ГПБ" тогда
		ПечатьПоручениеГПБ();
	ИначеЕсли Объект.Тип = "Намерение продать по ГПБ" тогда
		ПечатьОНамеренииПродатьГПБ();
	ИначеЕсли Объект.Тип = "Отмена поручения БК Регион" тогда
		Если Не ЗначениеЗаполнено(Объект.ДатаПоручения) тогда
			Предупреждение("Не заполнена дата поручения!");
			ПараметрыСессии.ТекстОшибки = "Не заполнена дата поручения!";
			Возврат;
		КонецЕсли;
		ПечатьПоручениеНаОтменуБКРегион();
	ИначеЕсли Объект.Тип = "Поручение БК Регион" тогда
		Если Не ЗначениеЗаполнено(Объект.ДатаПоручения) тогда
			Предупреждение("Не заполнена дата поручения!");
			ПараметрыСессии.ТекстОшибки = "Не заполнена дата поручения!";
			Возврат;
		КонецЕсли;
		ПечатьПоручениеБКРегион();
	КонецЕсли;
	
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
