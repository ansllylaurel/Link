
&НаСервереБезКонтекста
Функция ПолучитьДанныеШапка(ЦеннаяБумага, ДатаОтч, Организация, Подписант)
	
	Данные = Новый Структура("ISIN,Эмитент,Тип,РегНомер,ДатаРегистрации,Серия,Валюта,ДатаВыкупа,ЦенаПроцент,Цена,ОписаниеУсловий,КраткоеНаименованиеПоУставу,Должность,ОснованиеПолномочий");

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Облигации.Ссылка,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование, """") КАК Эмитент,
		|	Облигации.Тип,
		|	Облигации.ГосударственныйРегистрационныйНомер КАК РегНомер,
		|	КодыВТорговыхСистемахСрезПоследних.Код КАК ISIN,
		|	Облигации.ВалютаНоминала.НаименованиеПолное КАК Валюта,
		|	Облигации.ДатаРегистрации,
		|	Облигации.НомерВыпуска КАК Серия,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, """") КАК КраткоеНаименованиеПоУставу,
		|	УсловияОферт.ДатаВыкупа,
		|	УсловияОферт.ЦенаПроцент,
		|	УсловияОферт.Цена,
		|	УсловияОферт.АкцептС,
		|	УсловияОферт.АкцептПо,
		|	УсловияОферт.ОписаниеУсловий
		|ИЗ
		|	РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(
		|			&ДатаОтчета,
		|			Объект = &ЦеннаяБумага
		|				И ВидКода = &ISN) КАК КодыВТорговыхСистемахСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|					&ДатаОтчета,
		|					Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний) И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И ЮрФизЛицо В
		|						(ВЫБРАТЬ
		|							Облигации.Эмитент.ЮрФизЛицо
		|						ИЗ
		|							Справочник.Облигации КАК Облигации
		|						ГДЕ
		|							Облигации.Ссылка = &ЦеннаяБумага)) КАК РеквизитыЮридическихЛицСрезПоследних
		|			ПО Облигации.Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияОферт КАК УсловияОферт
		|			ПО Облигации.Ссылка = УсловияОферт.Облигация
		|		ПО КодыВТорговыхСистемахСрезПоследних.Объект = Облигации.Ссылка
		|ГДЕ
		|	Облигации.Ссылка = &ЦеннаяБумага
		|	И УсловияОферт.ДатаВыкупа = &ДатаОтчета";
	
	Запрос.УстановитьПараметр("ISN", Перечисления.ВидыКодовВТорговыхСистемах.ISIN);
	Запрос.УстановитьПараметр("ДатаОтчета", ДатаОтч);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Данные, ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтактныеЛица.Должность,
		|	КонтактныеЛица.ОснованиеПолномочий
		|ИЗ
		|	РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|ГДЕ
		|	КонтактныеЛица.Подразделение = &Подразделение
		|	И КонтактныеЛица.Язык = &Язык
		|	И КонтактныеЛица.Объект = &Объект
		|	И КонтактныеЛица.КонтактноеЛицо = &КонтактноеЛицо";
	
	Запрос.УстановитьПараметр("КонтактноеЛицо", Подписант);
	Запрос.УстановитьПараметр("Объект", Организация.ЮрФизЛицо);
	Запрос.УстановитьПараметр("Подразделение", Справочники.Подразделения.ГруппаКомпаний);
	Запрос.УстановитьПараметр("Язык", Справочники.Языки.Русский);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Данные, ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеТЧ(Знач Данные, ДатаОтч, Организация, СчетДУ, Брокер)
	
	Данные.Вставить("ПолноеНаименованиеПоУставу");
	Данные.Вставить("КодКлиента");
	Данные.Вставить("НомерДоговора");
	Данные.Вставить("ДатаДоговора");
	Данные.Вставить("НаименованиеДляДокументов");
	Данные.Вставить("Код");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо.Код КАК КодКлиента
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&ДатаОтч,
		|			Организация = &Организация И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|			И ЮрФизЛицо В
		|				(ВЫБРАТЬ ПЕРВЫЕ 1
		|					КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|				ИЗ
		|					РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&датаОтч, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаОтч", ДатаОтч);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДУ);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Данные, ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.НомерДоговора КАК НомерДоговора,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.ДатаЗаключения КАК ДатаДоговора,
		|	ВЫБОР
		|		КОГДА КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ОсновнойБрокер
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК ОсновнойБрокер,
		|	ВЫБОР
		|		КОГДА КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.НаименованиеВладельцаДляДокументов = """"
		|			ТОГДА ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Договор.НаименованиеВладельцаДляДокументов
		|		ИНАЧЕ ЕСТЬNULL(КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.НаименованиеВладельцаДляДокументов, """")
		|	КОНЕЦ КАК НаименованиеДляДокументов,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&ДатаОтчета,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Брокер = &Брокер
		|				И Организация = &Организация) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления = ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОсновнойБрокер";
	
	Запрос.УстановитьПараметр("Брокер", Брокер);
	Запрос.УстановитьПараметр("ДатаОтчета", ДатаОтч);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДУ);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		 ЗаполнитьЗначенияСвойств(Данные, ВыборкаДетальныеЗаписи);
	КонецЦикла;

	Возврат Данные;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСотрудниковОрганизации(Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КонтактныеЛица.КонтактноеЛицо
		|ИЗ
		|	РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|ГДЕ
		|	КонтактныеЛица.Объект = &Объект";
		
	Запрос.УстановитьПараметр("Объект", Организация.ЮрФизЛицо);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КонтактноеЛицо");
	
КонецФункции // ПолучитьСотрудниковОрганизации


&НаКлиенте
Функция СформироватьНомерПоручения(Данные)
	
	Возврат "" + Формат(Объект.ДатаПоручения, "ДФ=dd") + Формат(Объект.ДатаПоручения, "ДФ=MM") + Формат(Объект.ДатаПоручения, "ДФ=yy") + "/" + Данные.Код + "/" + Данные.РегНомер;

КонецФункции

&НаКлиенте
Процедура ПечатьПоручениеГПБ()
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ПоручениеГПБ");
	
	ДанныеШапка = ПолучитьДанныеШапка(Объект.ЦеннаяБумага, Объект.ДатаОферты, Объект.Организация, Объект.Подписант);

	Для Каждого СтрТабл Из Объект.СчетаДоверительногоУправления цикл
		
		Данные = ПолучитьДанныеТЧ(ДанныеШапка,Объект.ДатаОферты,Объект.Организация,СтрТабл.СчетДоверительногоУправления,Объект.Брокер);

		имяВременногоФайла = ПолучитьИмяВременногоФайла();
		Макет.Записать(имяВременногоФайла);
		
		Word = Новый COMОбъект("Word.Application"); 
		
		ТекДок = Word.Documents.ADD(имяВременногоФайла);
		ТекДок.Variables("dat").Value=Объект.ДатаОферты;
		ТекДок.Variables("ПолноеНаименованиеКлиента").Value=Данные.НаименованиеДляДокументов;
		ТекДок.Variables("Организация").Value=СокрЛП(Объект.Организация);
		ТекДок.Variables("КодКлиента").Value=Данные.Код;
		ТекДок.Variables("ДатаДоговораБрокер").Value=Формат(Данные.ДатаДоговора,"ДЛФ=DD");
		ТекДок.Variables("НомерДоговораБрокер").Value=Данные.НомерДоговора;
		ТекДок.Variables("РегНомер").Value=Данные.РегНомер;
		ТекДок.Variables("ISIN").Value=Данные.ISIN;
		ТекДок.Variables("Эмитент").Value=Данные.Эмитент;
		ТекДок.Variables("Количество").Value=СтрТабл.Количество;
		ТекДок.Variables("Процент").Value=Данные.ЦенаПроцент;
		ТекДок.Variables("Сумма").Value=Формат(СтрТабл.Сумма,"ЧЦ=17; ЧДЦ=2");
		ТекДок.Variables("Валюта").Value=Данные.валюта;
		ТекДок.Variables("СрокДействия").Value=Данные.ДатаВыкупа;
		ТекДок.Variables("ДопУсловия").Value="СДЕЛКА РПС, Агент "+СокрЛП(Объект.Агент)+", Код расчетов Т0, срок выставления заявки "+СокрЛП(Объект.срок);
		ТекДок.Variables("НачОтдела").Value=СокрЛП(данные.Должность)+"  "+СокрЛП(Объект.Подписант);
		
		ТекДок.Fields.Update();
		
		Word.ActiveWindow.View.ShowFieldCodes = False;
		Word.Visible=Истина;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПечатьОНамеренииПродатьГПБ()
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("НамерениеПродатьГПБ");
	
	ДанныеШапка = ПолучитьДанныеШапка(Объект.ЦеннаяБумага,Объект.ДатаОферты,Объект.Организация,Объект.Подписант);
	
	имяВременногоФайла = ПолучитьИмяВременногоФайла();
	Макет.Записать(имяВременногоФайла);
	
	Word = Новый COMОбъект("Word.Application"); 
	
	ТекДок = Word.Documents.ADD(имяВременногоФайла);
	ТекДок.Variables("dat").Value=Объект.ДатаОферты;
	ТекДок.Variables("Организация").Value=СокрЛП(Объект.Организация);
	ТекДок.Variables("РегНомер").Value=ДанныеШапка.РегНомер;
	ТекДок.Variables("ДатаРегистрации").Value=ДанныеШапка.ДатаРегистрации;
	ТекДок.Variables("Серия").Value=ДанныеШапка.Серия;
	ТекДок.Variables("Номинал").Value=ДанныеШапка.Цена;
	ТекДок.Variables("Эмитент").Value=ДанныеШапка.КраткоеНаименованиеПоУставу;
	ТекДок.Variables("НачОтдела").Value=СокрЛП(ДанныеШапка.Должность)+"  "+СокрЛП(Объект.Подписант);
	
	ВсегоТаблиц = Word.Application.ActiveDocument.Tables.Count;
	Если ВсегоТаблиц = 0 тогда //в документе word нет таблиц для заполнения  
		ВызватьИсключение "В документе word нет таблиц для заполнения. Обратитетсь к программисту";
	КонецЕсли;
	
	wordTable=Word.Application.ActiveDocument.Tables(1);
	wordRows=wordTable.Rows; 
	
	Ном=1;
	
	Для Каждого СтрТабл Из Объект.СчетаДоверительногоУправления цикл
		
		Данные = ПолучитьДанныеТЧ(ДанныеШапка, Объект.ДатаОферты, Объект.Организация, СтрТабл.СчетДоверительногоУправления, Объект.Брокер);
		
		beforeRow=wordRows.Item(ном);               
		wordRows.Add(beforeRow);
		
		строкаДок="
			|№ "+Данные.НомерДоговора+" от "+Формат(Данные.ДатаДоговора,"ДЛФ=D")+"г. "+Данные.НаименованиеДляДокументов+" в количестве "+СтрТабл.Количество+" ("+ЧислоПрописью(СтрТабл.Количество,,",,,ж,,,,ж,0")+") штук ";
		inRow=wordRows.Item(ном);      
	
		inRow.Cells(1).Select();
		Word.Application.Selection.InsertAfter(строкаДок);
		ном=ном+1;
	КонецЦикла;
	
	ТекДок.Fields.Update();
	Word.ActiveWindow.View.ShowFieldCodes = False;
	Word.Visible=Истина;
		

КонецПроцедуры

&НаКлиенте
Процедура ПечатьПоручениеНаОтменуБКРегион()
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ОтменаПорученияБКРегион");
	
	ДанныеШапка = ПолучитьДанныеШапка(Объект.ЦеннаяБумага,Объект.ДатаОферты,Объект.Организация,Объект.Подписант);
	
	Для Каждого СтрТабл Из Объект.СчетаДоверительногоУправления цикл
		
		Данные=ПолучитьДанныеТЧ(ДанныеШапка,Объект.ДатаОферты,Объект.Организация,СтрТабл.СчетДоверительногоУправления,Объект.Брокер);

		имяВременногоФайла = ПолучитьИмяВременногоФайла();
		Макет.Записать(имяВременногоФайла);
		Word = Новый COMОбъект("Word.Application"); 
		ТекДок = Word.Documents.ADD(имяВременногоФайла);
		ТекДок.Variables("dat").Value=Объект.ДатаОферты;
		ТекДок.Variables("datStr").Value=Формат(Объект.ДатаОферты,"ДЛФ=DD");

		ТекДок.Variables("ПолноеНаименованиеКлиента").Value=Данные.НаименованиеДляДокументов;
		ТекДок.Variables("Организация").Value=СокрЛП(Объект.Организация);
		ТекДок.Variables("КодКлиента").Value=Данные.Код;
		ТекДок.Variables("ДатаДоговораБрокер").Value=Данные.ДатаДоговора;
		ТекДок.Variables("НомерДоговораБрокер").Value=Данные.НомерДоговора;
