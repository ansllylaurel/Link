&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ЭтаФорма.Параметры, "ЦеннаяБумага, Дата");
		
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДивидендыПоАкциямСрезПоследних.Акция КАК Акция,
	|	ДивидендыПоАкциямСрезПоследних.ДатаФиксации КАК ДатаФиксации,
	|	ДивидендыПоАкциямСрезПоследних.РазмерДивидендовНаОднуАкцию КАК ДивидендыНаЦеннуюБумагу,
	|	ДивидендыПоАкциямСрезПоследних.Д1 КАК Д1,
	|	ДивидендыПоАкциямСрезПоследних.Д2 КАК Д2,
	|	ДивидендыПоАкциямСрезПоследних.ПлановаяДатаОплатыДивидендов КАК ДатаОплатыПлановая,
	|	ДивидендыПоАкциямСрезПоследних.ИдСобытияПоВыплатеДивидендов КАК ИдСобытия,
	|	ДивидендыПоАкциямСрезПоследних.СтатусСобытия КАК СтатусСобытия
	|ИЗ
	|	РегистрСведений.ДивидендыПоАкциям.СрезПоследних(
	|			,
	|			Акция = &Акция
	|				И ДатаФиксации = &ДатаФиксации) КАК ДивидендыПоАкциямСрезПоследних";
	
	Запрос.УстановитьПараметр("Акция", ЭтаФорма.ЦеннаяБумага);
	Запрос.УстановитьПараметр("ДатаФиксации", ЭтаФорма.Дата);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() ЦИкл  
		НовоеНачисление = ЭтаФорма.ПараметрыНачисления.Добавить();
		ЗаполнитьЗначенияСвойств(НовоеНачисление, Выборка);
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если НЕ ЗавершениеРаботы Тогда
					
		ЭтаФорма.Закрыть(Неопределено);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Функция ВозращаемыеДанные(ИсточникДанных)
	
	Результат = Новый Структура("Д1, Д2, ДатаФиксации, ИдСобытия, ДатаОплатыПлановая, ДивидендыНаЦеннуюБумагу, СтатусСобытия");
	ЗаполнитьЗначенияСвойств(Результат, ИсточникДанных);
	
	Возврат Результат;
	
КонецФункции	

&НаКлиенте
Процедура ВыбратьВыплату(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ВыбратьВыплату");
	Попытка
		ВыполнитьВыбратьВыплату(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВыбратьВыплату(ПараметрыСессии)
	
	ТекущиеПараметры = ВозращаемыеДанные(ЭтаФорма.Элементы.ПараметрыНачисления.ТекущиеДанные);
	ЭтаФорма.Закрыть(ТекущиеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЭтаФорма.ПараметрыНачисления.Количество()=1 Тогда 
		Отказ = Истина;
		ТекущиеПараметры = ВозращаемыеДанные(ЭтаФорма.ПараметрыНачисления[0]);
		ЭтаФорма.Закрыть(ТекущиеПараметры);
	ИначеЕсли ЭтаФорма.ПараметрыНачисления.Количество()= 0 Тогда
		Отказ = Истина;
		ЭтаФорма.Закрыть(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыНачисленияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ВыбратьВыплату(Команды.Найти("ВыбратьВыплату"));
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
