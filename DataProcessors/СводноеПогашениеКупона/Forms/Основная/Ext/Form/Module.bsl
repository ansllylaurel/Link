#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПараметрыФормы = ЭтаФорма.Параметры;
	
	// начальное заполнение формы
	Если ЗначениеЗаполнено(ПараметрыФормы.ПогашениеКупона) Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ПараметрыФормы.ПогашениеКупона);
	Иначе		
		Если ПараметрыФормы.Свойство("ПараметрыЗаполнения") Тогда
			ЗаполнитьЗначенияСвойств(ЭтаФорма, ПараметрыФормы.ПараметрыЗаполнения);
		Иначе
			ЭтаФорма.Организация  	= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
			ЭтаФорма.Дата  			= ТекущаяДата();
			ЭтаФорма.ДатаФиксации 	= ТекущаяДата();
		КонецЕсли;
	КонецЕсли;

	ВалютаНоминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Облигация, "ВалютаНоминала");
	
	ЗаполнитьПлановыеИСозданныеПогашенияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "СводноеПогашениеКупона.Обновить" Тогда
		ЗаполнитьПлановыеИСозданныеПогашенияНаСервере();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ЭтаФорма.ДатаФиксации  = ПолучитьДатуФиксации(ЭтаФорма.Облигация, ЭтаФорма.Дата);
		
	ЗаполнитьПлановыеИСозданныеПогашенияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаФиксацииПриИзменении(Элемент)
	
	ЗаполнитьПлановыеИСозданныеПогашенияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОблигацияПриИзменении(Элемент)
	
	ЭтаФорма.СуммаНаОднуОблигацию = 0;
	ЭтаФорма.СуммаНаОднуОблигациюВРублях = 0;
	
	ВалютаНоминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Облигация, "ВалютаНоминала");
	
	СуммаНаОднуОблигациюПриИзменении(Неопределено);
	
	ПодходящаяДата			= Неопределено;
	ПодходящаяДатаФиксации	= Неопределено;
	
	МассивДатНачисленияПроцентов = ПолучитьДатыНачисленияПроцентов(ЭтаФорма.Облигация, ПодходящаяДата, ПодходящаяДатаФиксации);
	Элементы.Дата.СписокВыбора.Очистить();
	Для каждого ДатаНачисления Из МассивДатНачисленияПроцентов Цикл
		Элементы.Дата.СписокВыбора.Добавить(ДатаНачисления, Формат(ДатаНачисления, "ДФ=dd.MM.yyyy"));
	КонецЦикла; 
			
	Если ЭтаФорма.Дата <> ПодходящаяДата
		И Вопрос("Изменить дату на " + Формат(ПодходящаяДата, "ДФ=dd.MM.yyyy") + " из графика начисления процентов?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да
	Тогда
		ЭтаФорма.Дата         = ПодходящаяДата;
		ЭтаФорма.ДатаФиксации = ПодходящаяДатаФиксации;
	КонецЕсли;	
		
	ЗаполнитьПлановыеИСозданныеПогашенияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПогашенияСозданныеПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекущиеДанные = Элементы.ПогашенияСозданные.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьЗначение(ТекущиеДанные.Документ);
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаЗаполнитьДатуФиксацииИзДаты(Команда)
	
	ЭтаФорма.ДатаФиксации = ЭтаФорма.Дата;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПогашенияПлановыеУстановитьВсеФлажки(Команда)
	
	Для каждого СтрокаПогашенияПлановые Из ЭтаФорма.ПогашенияПлановые Цикл
		СтрокаПогашенияПлановые.Флажок = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПогашенияПлановыеСнятьВсеФлажки(Команда)
	
	Для каждого СтрокаПогашенияПлановые Из ЭтаФорма.ПогашенияПлановые Цикл
		СтрокаПогашенияПлановые.Флажок = Ложь;
	КонецЦикла;

	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновить(Команда)
	
	КлючиРазвернутыхСтрокПогашенияСозданные = Неопределено;
	РаботаСФормамиКлиент.ПолучитьКлючиРазвернутыхСтрокДерева(ЭтаФорма.ПогашенияСозданные, Элементы.ПогашенияСозданные, "Документ", КлючиРазвернутыхСтрокПогашенияСозданные);
	
	КлючТекущейСтрокиПогашенияСозданные = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.ПогашенияСозданные, "Документ");
	КлючТекущейСтрокиПогашенияПлановые  = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.ПогашенияПлановые,  "СчетДоверительногоУправления");
	
	ЗаполнитьПлановыеИСозданныеПогашенияНаСервере();
	
	РаботаСФормамиКлиент.ВосстановитьРазвернутыеСтрокиДереваПоКлючу(ЭтаФорма.ПогашенияСозданные, Элементы.ПогашенияСозданные, "Документ", КлючиРазвернутыхСтрокПогашенияСозданные);
	
	РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.ПогашенияСозданные, Элементы.ПогашенияСозданные, "Документ", КлючТекущейСтрокиПогашенияСозданные);
	РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.ПогашенияПлановые, Элементы.ПогашенияПлановые, "СчетДоверительногоУправления", КлючТекущейСтрокиПогашенияСозданные);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьПогашенияКупона(Команда)
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.ДатаФиксации) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана дата фиксации!");
		Возврат;
	КонецЕсли;	
	
	ЕстьОшибки = Ложь;
	
	// проверим заполнение
	ВыбПлановыеПогашения = Новый Массив();
	
	Для НомСтр = 0 По ЭтаФорма.ПогашенияПлановые.Количество() - 1 Цикл
			
		СтрокаПлановыеПогашения = ЭтаФорма.ПогашенияПлановые[НомСтр];
		
		Если Не СтрокаПлановыеПогашения.Флажок Тогда
			Продолжить;
		КонецЕсли;
	
		Если СтрокаПлановыеПогашения.Количество = 0 Тогда
			Сообщить("Не заполнено поле ""Количество"" в строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если СтрокаПлановыеПогашения.СуммаКупона = 0 Тогда
			Сообщить("Не заполнено поле ""Сумма купона"" в строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		ВыбПлановыеПогашения.Добавить(
			Новый Структура("СчетДоверительногоУправления, Количество, КоличествоПоРЕПО, КоличествоВРЕПО, СуммаКупона, СуммаКупонаВРублях",
				СтрокаПлановыеПогашения.СчетДоверительногоУправления,
				СтрокаПлановыеПогашения.Количество,
				СтрокаПлановыеПогашения.КоличествоПоРЕПО,
				СтрокаПлановыеПогашения.КоличествоВРЕПО,
				СтрокаПлановыеПогашения.СуммаКупона,
				СтрокаПлановыеПогашения.СуммаКупонаВРублях));
		
	КонецЦикла;
	
	Если ЕстьОшибки Тогда
		Возврат;
	ИначеЕсли ВыбПлановыеПогашения.Количество() = 0 Тогда
		Сообщить("Не выбраны плановые погашения.");
		Возврат;
	КонецЕсли;
	
	// откроем форму
	ПараметрыФормы = Новый Структура("ПлановыеПогашения, Организация, Дата, ДатаФиксации, Облигация, СуммаНаОднуОблигацию, СуммаНаОднуОблигациюВРублях", ВыбПлановыеПогашения);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ЭтаФорма);
	
	Если ОткрытьФормуМодально("Обработка.СводноеПогашениеКупона.Форма.СозданиеПогашенийКупона", ПараметрыФормы, ЭтаФорма) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КомандаОбновить(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыПровести(Команда)
	
	ДанныеВыбранныхДокументов = ПолучитьДанныеВыбранныхДокументов();
		
	Если ДанныеВыбранныхДокументов.Количество() > 0 Тогда
		
		РаботаСоСпискомДокументовКлиент.Провести(ДанныеВыбранныхДокументов);
	
		КомандаОбновить(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыОтменитьПроведение(Команда)
	
	ДанныеВыбранныхДокументов = ПолучитьДанныеВыбранныхДокументов();
	
	Если ДанныеВыбранныхДокументов.Количество() > 0 Тогда
		
		РаботаСоСпискомДокументовКлиент.ОтменитьПроведение(ДанныеВыбранныхДокументов);
		
		КомандаОбновить(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыУстановитьСнятьПометкуУдаление(Команда)
	
	ДанныеВыбранныхДокументов = ПолучитьДанныеВыбранныхДокументов();
	
	Если ДанныеВыбранныхДокументов.Количество() > 0 Тогда		
		
		РаботаСоСпискомДокументовКлиент.УстановитьСнятьПометкуУдаления(ДанныеВыбранныхДокументов);
		
		КомандаОбновить(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыСоздатьНаОсновании(Команда)
	
	ТекущиеДанныеСписка = Элементы.ПогашенияСозданные.ТекущиеДанные;
	
	Если ТекущиеДанныеСписка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанныеСписка.Документ) = Тип("ДокументСсылка.ПогашениеКупона") Тогда
		
		РаботаСоСпискомДокументовКлиент.СоздатьНаОсновании(ТекущиеДанныеСписка.Документ, "ПогашениеКупона");
		
		КомандаОбновить(Неопределено);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьНедостающиеОплаты(Команда)
	
	ПогашенияКупона = Новый Массив();
	
	Для каждого Элемент Из ЭтаФорма.ПогашенияСозданные.ПолучитьЭлементы() Цикл
		ПогашенияКупона.Добавить(Элемент.Документ);
	КонецЦикла;
	
	Если ПогашенияКупона.Количество() > 0 Тогда
		
		ДатаОплат = ?(ДатаФиксации < ТекущаяДата(), ТекущаяДата(), ДатаФиксации + 34*3600);
		
		Если Не ВвестиДату(ДатаОплат, "Введите дату оплат", ЧастиДаты.ДатаВремя) Тогда
			Возврат;
		КонецЕсли;
		
		СоздатьНедостающиеОплатыПоПогашениямКупона(ДатаОплат, ЭтаФорма.Организация, РаботаСЦеннымиБумагами.КонтрагентПоЦеннойБумаге(ЭтаФорма.Облигация), ПогашенияКупона);
		
		КомандаОбновить(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПогашенияСозданныеРазвернутьВсе(Команда)
	
	РаботаСФормамиКлиент.РазвернутьВсеЭлементыДерева(ЭтаФорма.ПогашенияСозданные, Элементы.ПогашенияСозданные);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПогашенияСозданныеСвернутьВсе(Команда)
	
	РаботаСФормамиКлиент.СвернутьВсеЭлементыДерева(ЭтаФорма.ПогашенияСозданные, Элементы.ПогашенияСозданные);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОткрытьГрафикНачисленияПроцентов(Команда)
	
	ПараметрыФормы = Новый Структура("Отбор",
		Новый Структура("Облигация", ЭтаФорма.Облигация));
	
	ОткрытьФорму("РегистрСведений.КупонныйДоходПоОблигациям.ФормаСписка", ПараметрыФормы);
		
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьНадписьПогашенияПлановыеИтого(Форма)
	
	ТекстНадписи = "";
	
	Если Форма.ПогашенияПлановые.Количество() > 0 Тогда
		
		ИтогоКоличество       = 0;
		ИтогоКоличествоПоРЕПО = 0;
		ИтогоКоличествоВРЕПО = 0;
		ИтогоСуммаКупона      = 0;
		
		Для каждого СтрокаПогашенияПлановые Из Форма.ПогашенияПлановые Цикл
			ИтогоКоличество       	= ИтогоКоличество       + СтрокаПогашенияПлановые.Количество;
			ИтогоКоличествоПоРЕПО	= ИтогоКоличествоПоРЕПО + СтрокаПогашенияПлановые.КоличествоПоРЕПО;
			ИтогоКоличествоВРЕПО	= ИтогоКоличествоВРЕПО	+ СтрокаПогашенияПлановые.КоличествоВРЕПО;
			ИтогоСуммаКупона      	= ИтогоСуммаКупона      + СтрокаПогашенияПлановые.СуммаКупона;
		КонецЦикла;
		
		ТекстНадписи = "Итого " + ИтогоКоличество + " " + РаботаСКорзинойЦенныхБумагКлиентСервер.ФормаМножественногоЧислаЦеннойБумаги(ИтогоКоличество, ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Облигации"))
			+ ?(ИтогоКоличествоПоРЕПО > 0, ", в т.ч. "  + ИтогоКоличествоПоРЕПО + " по РЕПО,", "")
			+ ?(ИтогоКоличествоВРЕПО > 0, ", в т.ч. "  + ИтогоКоличествоВРЕПО + " в РЕПО,", "")+ " на сумму " + ИтогоСуммаКупона;
		
	КонецЕсли;
	
	Форма.Элементы.НадписьПогашенияПлановыеИтого.Заголовок = ТекстНадписи;
	
КонецПроцедуры // ОбновитьНадписьПогашенияПлановыеИтого

&НаСервереБезКонтекста
Процедура СоздатьНедостающиеОплатыПоПогашениямКупона(Период, Организация, Контрагент, ПогашенияКупона)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Период КАК Дата,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход) КАК ВидДвижения,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК ВалютаОплаты,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Организация,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание.Брокер КАК Брокер,
		|	ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок) КАК МестоХранения,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание.РасчетныйСчет КАК РасчетныйСчет,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание,
		|	&Контрагент,
		|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка) КАК Договор,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК СуммаКупона,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК СуммаОплатыКупона
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			,
		|			Организация = &Организация
		|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона)
		|				И Основание В (&Основание)) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток > 0";
		
	Запрос.УстановитьПараметр("Период",      Период);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент",  Контрагент);
	Запрос.УстановитьПараметр("Основание",   ПогашенияКупона);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создание оплат не требуется");
		Возврат;
		
	КонецЕсли; 
	
	Пока Выборка.Следующий() Цикл
		
		Документ = Документы.Оплата.СоздатьДокумент();
		
		Документ.Ответственный = РаботаСПользователями.ТекущийПользователь();
			
		ЗаполнитьЗначенияСвойств(Документ, Выборка);
		ЗаполнитьЗначенияСвойств(Документ.Основания.Добавить(), Выборка);
		
		Если Не Документ.ПроверитьЗаполнение() Тогда
			Продолжить;
		КонецЕсли;
		
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + Документ.Ссылка, Документ.Ссылка);

	КонецЦикла;
	
КонецПроцедуры // СоздатьНедостающиеОплатыПоПогашениямКупона

&НаСервереБезКонтекста
Функция ПолучитьДатыНачисленияПроцентов(Облигация, ПодходящаяДата = Неопределено, ПодходящаяДатаФиксации = Неопределено)
	
	ПодходящаяДата       	= Дата(1, 1, 1);
	ПодходящаяДатаФиксации  = Дата(1, 1, 1);
	ТекущаяДатаНачалоДня	= НачалоДня(ТекущаяДата());
	
	ДатыНачисленияПроцентов = Новый Массив();
	
	Если ЗначениеЗаполнено(Облигация) Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КупонныйДоходПоОблигациям.ДатаОкончанияКупона КАК Период,
			|	КупонныйДоходПоОблигациям.ДатаФиксации
			|ИЗ
			|	РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
			|ГДЕ
			|	КупонныйДоходПоОблигациям.Облигация = &Облигация
			|
			|УПОРЯДОЧИТЬ ПО
			|	Период";
			
		Запрос.УстановитьПараметр("Облигация", Облигация);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ДатыНачисленияПроцентов.Добавить(Выборка.Период);
			
			Если Выборка.Период <= ТекущаяДатаНачалоДня Тогда
				ПодходящаяДата			= Выборка.Период;
				ПодходящаяДатаФиксации	= ?(ЗначениеЗаполнено(Выборка.ДатаФиксации), Выборка.ДатаФиксации, Выборка.Период);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ДатыНачисленияПроцентов;
	
КонецФункции // ПолучитьДатыНачисленияПроцентов

&НаСервере
Функция ЗаполнитьСозданныеПогашенияКупонаНаСервере()
	
	ПогашенияСозданные.ПолучитьЭлементы().Очистить();
	
	ПогашенияСозданныеНаСервере = РеквизитФормыВЗначение("ПогашенияСозданные");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	ЗадолженностиПоЦеннымБумагамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ЗадолженностиПоЦеннымБумагамОстатки
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
		|			&ДатаФиксации,
		|			(ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО)
		|				ИЛИ ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО))
		|				И Организация = &Организация
		|				И ЦеннаяБумага = &Облигация) КАК ЗадолженностиПоЦеннымБумагамОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.КоличествоОстаток - ЕСТЬNULL(_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.КоличествоОстаток, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоВРЕПО,
		|	ВЫБОР
		|		КОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.КоличествоОстаток - ЕСТЬNULL(_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.КоличествоОстаток, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоПоРЕПО
		|ПОМЕСТИТЬ _КоличествоВРЕПО
		|ИЗ
		|	_ЗадолженностиПоЦеннымБумагамОстатки КАК _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗадолженностиПоЦеннымБумагамОстатки КАК _ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО
		|		ПО (_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО))
		|			И _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.СчетДоверительногоУправления = _ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.СчетДоверительногоУправления
		|			И _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ЦеннаяБумага = _ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.ЦеннаяБумага
		|ГДЕ
		|	_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗадолженностиПоВторойЧастиРЕПООстатки.СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.Остатки(
		|			&ДатаФиксации,
		|			Организация = &Организация
		|				И ЦеннаяБумага = &Облигация) КАК ЗадолженностиПоВторойЧастиРЕПООстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КоличествоВРЕПО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СУММА(_КоличествоВРЕПО.КоличествоВРЕПО) КАК КоличествоВРЕПО,
		|	СУММА(_КоличествоВРЕПО.КоличествоПоРЕПО) КАК КоличествоПоРЕПО
		|ПОМЕСТИТЬ _ЦенныеБумагиВРЕПО
		|ИЗ
		|	_КоличествоВРЕПО КАК _КоличествоВРЕПО
		|
		|СГРУППИРОВАТЬ ПО
		|	_КоличествоВРЕПО.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПогашениеКупона.Ссылка КАК Документ,
		|	ВЫБОР
		|		КОГДА ПогашениеКупона.Проведен
		|			ТОГДА 1
		|		КОГДА ПогашениеКупона.ПометкаУдаления
		|			ТОГДА 0
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК СостояниеДокумента,
		|	ВЫБОР
		|		КОГДА ПогашениеКупона.ПометкаУдаления
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ИсключатьИзРасчетов,
		|	ПогашениеКупона.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ПогашениеКупона.СчетДоверительногоУправления КАК Объект,
		|	ПогашениеКупона.Брокер КАК Брокер,
		|	ПогашениеКупона.РасчетныйСчет КАК РасчетныйСчет,
		|	ПогашениеКупона.СуммаКупона КАК СуммаКупона,
		|	ПогашениеКупона.СуммаКупонаВРублях КАК СуммаКупонаВРублях,
		|	ПогашениеКупона.Количество КАК Количество,
		|	_ЦенныеБумагиВРЕПО.КоличествоВРЕПО КАК КоличествоВРЕПО,
		|	_ЦенныеБумагиВРЕПО.КоличествоПоРЕПО КАК КоличествоПоРЕПО,
		|	ПогашениеКупона.ВалютаОплаты КАК ВалютаОплаты,
		|	ПогашениеКупона.СуммаНаОднуОблигацию КАК СуммаНаОднуОблигацию
		|ИЗ
		|	Документ.ПогашениеКупона КАК ПогашениеКупона
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумагиВРЕПО КАК _ЦенныеБумагиВРЕПО
		|		ПО ПогашениеКупона.СчетДоверительногоУправления = _ЦенныеБумагиВРЕПО.СчетДоверительногоУправления
		|ГДЕ
		|	ПогашениеКупона.Организация = &Организация
		|	И ПогашениеКупона.Облигация = &Облигация
		|	И НАЧАЛОПЕРИОДА(ПогашениеКупона.Дата, ДЕНЬ) = &Дата
		|	И ПогашениеКупона.ДатаФиксации = НАЧАЛОПЕРИОДА(&ДатаФиксации, ДЕНЬ)";
		
	Запрос.УстановитьПараметр("Организация",  ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("Облигация",    ЭтаФорма.Облигация);
	Запрос.УстановитьПараметр("Дата",         ЭтаФорма.Дата);
	Запрос.УстановитьПараметр("ДатаФиксации", ?(ЭтаФорма.ДатаФиксации = ЭтаФорма.Дата, НачалоДня(ЭтаФорма.ДатаФиксации), КонецДня(ЭтаФорма.ДатаФиксации)));
	
	ПогашенияКупона = Запрос.Выполнить().Выгрузить();
	
	// получим и перенесем на форму погашения купонов с оплатами
	ОбработанныеПогашения = Новый Массив();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОплатаОснования.Основание КАК ПогашениеКупона,
		|	ОплатаОснования.Ссылка КАК Документ,
		|	ОплатаОснования.Ссылка КАК Объект,
		|	ВЫБОР
		|		КОГДА ОплатаОснования.Ссылка.Проведен
		|			ТОГДА 1
		|		КОГДА ОплатаОснования.Ссылка.ПометкаУдаления
		|			ТОГДА 0
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК СостояниеДокумента,
		|	ОплатаОснования.Ссылка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОплатаОснования.Ссылка.ВалютаОплаты КАК ВалютаОплаты,
		|	ОплатаОснования.Ссылка.Брокер КАК Брокер,
		|	ОплатаОснования.Ссылка.РасчетныйСчет КАК РасчетныйСчет,
		|	ОплатаОснования.СуммаКупона		
		|ИЗ
		|	Документ.Оплата.Основания КАК ОплатаОснования
		|ГДЕ
		|	ОплатаОснования.Ссылка.ВидЗадолженности = &ВидЗадолженности
		|	И ОплатаОснования.Ссылка.Организация = &Организация
		|	И ОплатаОснования.Основание В(&ПогашенияКупона)
		|ИТОГИ ПО
		|	ПогашениеКупона";
	
	Запрос.УстановитьПараметр("ВидЗадолженности", Справочники.ВидыЗадолженности.ПоПогашениюКупона);
	Запрос.УстановитьПараметр("Организация",      ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("ПогашенияКупона",  ПогашенияКупона.ВыгрузитьКолонку("Документ"));
		
	ВыборкаПогашенияКупона = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПогашенияКупона.Следующий() Цикл
		
		// найдем соответствующее погашение купона
		СтрокаПогашениКупона = ПогашенияКупона.Найти(ВыборкаПогашенияКупона.ПогашениеКупона, "Документ");
		
		Если СтрокаПогашениКупона = Неопределено Тогда // такого быть не должно, но на всякий случай отработаем
			Сообщить("Ошибка заполнения фактических погашений. Не удалось получить реквизиты документа " + ВыборкаПогашенияКупона.ПогашениеКупона + ". Обратитесь к разработчикам.");
			Продолжить;
		КонецЕсли;	
			
		ПогашенияСозданныеНаСервереСтрока1 = ПогашенияСозданныеНаСервере.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(ПогашенияСозданныеНаСервереСтрока1, СтрокаПогашениКупона);
		
		ПогашенияСозданныеНаСервереСтрока1.ПлатежныеРеквизиты = ""
			+ ?(ЗначениеЗаполнено(ПогашенияСозданныеНаСервереСтрока1.Брокер), "брокер " + ПогашенияСозданныеНаСервереСтрока1.Брокер + ", ", "")
			+ ?(ЗначениеЗаполнено(ПогашенияСозданныеНаСервереСтрока1.РасчетныйСчет), "р/счет " + ПогашенияСозданныеНаСервереСтрока1.РасчетныйСчет, "");
		
		ВыборкаОплаты = ВыборкаПогашенияКупона.Выбрать();
		
		Пока ВыборкаОплаты.Следующий() Цикл
			
			ПогашенияСозданныеНаСервереСтрока2 = ПогашенияСозданныеНаСервереСтрока1.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(ПогашенияСозданныеНаСервереСтрока2, ВыборкаОплаты);
			
			ПогашенияСозданныеНаСервереСтрока2.ПлатежныеРеквизиты = ""
				+ ?(ЗначениеЗаполнено(ПогашенияСозданныеНаСервереСтрока2.Брокер), "брокер " + ПогашенияСозданныеНаСервереСтрока2.Брокер + ", ", "")
				+ ?(ЗначениеЗаполнено(ПогашенияСозданныеНаСервереСтрока2.РасчетныйСчет), "р/счет " + ПогашенияСозданныеНаСервереСтрока2.РасчетныйСчет, "");
			
		КонецЦикла;
			
		ОбработанныеПогашения.Добавить(ВыборкаПогашенияКупона.ПогашениеКупона);
		
	КонецЦикла;
	
	// перенесем на форму погашения купонов без оплат
	ОбновленаСуммаНаОднуОблигацию = Ложь;
	
	Для каждого СтрокаПогашенияКупона Из ПогашенияКупона Цикл
		
		Если ОбработанныеПогашения.Найти(СтрокаПогашенияКупона.Документ) = Неопределено Тогда
			
			ПогашенияСозданныеНаСервереСтрока1 = ПогашенияСозданныеНаСервере.Строки.Добавить();
			
			ЗаполнитьЗначенияСвойств(ПогашенияСозданныеНаСервереСтрока1, СтрокаПогашенияКупона);
			
			ПогашенияСозданныеНаСервереСтрока1.ПлатежныеРеквизиты = ""
				+ ?(ЗначениеЗаполнено(ПогашенияСозданныеНаСервереСтрока1.Брокер), "брокер " + ПогашенияСозданныеНаСервереСтрока1.Брокер + ", ", "")
				+ ?(ЗначениеЗаполнено(ПогашенияСозданныеНаСервереСтрока1.РасчетныйСчет), "р/счет " + ПогашенияСозданныеНаСервереСтрока1.РасчетныйСчет, "");
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ПогашенияСозданныеНаСервере, "ПогашенияСозданные");
	
КонецФункции // ЗаполнитьСозданныеПогашенияКупонаНаСервере

&НаСервере
Функция ЗаполнитьПлановыеПогашенияНаСервере()
	
	ПогашенияПлановые.Очистить();
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.Облигация) Тогда
		Возврат Ложь;
	КонецЕсли;	

	// плановые данные
	Запрос = Новый Запрос;
	Запрос.Текст = 	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	ЗадолженностиПоЦеннымБумагамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ЗадолженностиПоЦеннымБумагамОстатки
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
		|			&ДатаФиксации,
		|			(ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО)
		|				ИЛИ ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО))
		|				И Организация = &Организация
		|				И ЦеннаяБумага = &Облигация) КАК ЗадолженностиПоЦеннымБумагамОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.КоличествоОстаток - ЕСТЬNULL(_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.КоличествоОстаток, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоВРЕПО,
		|	ВЫБОР
		|		КОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.КоличествоОстаток - ЕСТЬNULL(_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.КоличествоОстаток, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоПоРЕПО
		|ПОМЕСТИТЬ _КоличествоВРЕПО
		|ИЗ
		|	_ЗадолженностиПоЦеннымБумагамОстатки КАК _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗадолженностиПоЦеннымБумагамОстатки КАК _ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО
		|		ПО (_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО))
		|			И _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.СчетДоверительногоУправления = _ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.СчетДоверительногоУправления
		|			И _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ЦеннаяБумага = _ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.ЦеннаяБумага
		|ГДЕ
		|	_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗадолженностиПоВторойЧастиРЕПООстатки.СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.Остатки(
		|			&ДатаФиксации,
		|			Организация = &Организация
		|				И ЦеннаяБумага = &Облигация) КАК ЗадолженностиПоВторойЧастиРЕПООстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КоличествоВРЕПО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СУММА(_КоличествоВРЕПО.КоличествоВРЕПО) КАК КоличествоВРЕПО,
		|	СУММА(_КоличествоВРЕПО.КоличествоПоРЕПО) КАК КоличествоПоРЕПО
		|ПОМЕСТИТЬ _ЦенныеБумагиВРЕПО
		|ИЗ
		|	_КоличествоВРЕПО КАК _КоличествоВРЕПО
		|
		|СГРУППИРОВАТЬ ПО
		|	_КоличествоВРЕПО.СчетДоверительногоУправления
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИСТИНА КАК Флажок,
		|	ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления, _ЦенныеБумагиВРЕПО.СчетДоверительногоУправления) КАК СчетДоверительногоУправления,
		|	СУММА(ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.КоличествоОстаток, ЕСТЬNULL(_ЦенныеБумагиВРЕПО.КоличествоПоРЕПО, 0)) + ЕСТЬNULL(_ЦенныеБумагиВРЕПО.КоличествоВРЕПО, 0)) КАК Количество,
		|	СУММА(ЕСТЬNULL(_ЦенныеБумагиВРЕПО.КоличествоПоРЕПО, 0)) КАК КоличествоПоРЕПО,
		|	СУММА(ЕСТЬNULL(_ЦенныеБумагиВРЕПО.КоличествоВРЕПО, 0)) КАК КоличествоВРЕПО,
		|	СУММА(ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.КоличествоОстаток, ЕСТЬNULL(_ЦенныеБумагиВРЕПО.КоличествоПоРЕПО, 0)) + ЕСТЬNULL(_ЦенныеБумагиВРЕПО.КоличествоВРЕПО, 0)) * &СуммаНаОднуОблигацию КАК СуммаКупона,
		|	СУММА(ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.КоличествоОстаток, ЕСТЬNULL(_ЦенныеБумагиВРЕПО.КоличествоПоРЕПО, 0)) + ЕСТЬNULL(_ЦенныеБумагиВРЕПО.КоличествоВРЕПО, 0)) * &СуммаНаОднуОблигациюВРублях КАК СуммаКупонаВРублях
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|			&ДатаФиксации,
		|			Организация = &Организация
		|				И ЦеннаяБумага = &Облигация) КАК ОстаткиЦенныхБумагОстатки
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ЦенныеБумагиВРЕПО КАК _ЦенныеБумагиВРЕПО
		|		ПО ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления = _ЦенныеБумагиВРЕПО.СчетДоверительногоУправления
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления, _ЦенныеБумагиВРЕПО.СчетДоверительногоУправления)";
		
	ВидыЗадолженностиПоРЕПО = Новый Массив();
	ВидыЗадолженностиПоРЕПО.Добавить(Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО);
	ВидыЗадолженностиПоРЕПО.Добавить(Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО);
		
	Запрос.УстановитьПараметр("ДатаФиксации"		, ?(ЭтаФорма.ДатаФиксации = ЭтаФорма.Дата, НачалоДня(ЭтаФорма.ДатаФиксации), КонецДня(ЭтаФорма.ДатаФиксации)));
	Запрос.УстановитьПараметр("Организация"			, ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("Облигация"			, ЭтаФорма.Облигация);
	Запрос.УстановитьПараметр("ВидыЗадолженности"	, ВидыЗадолженностиПоРЕПО);
	Запрос.УстановитьПараметр("СуммаНаОднуОблигацию", ЭтаФорма.СуммаНаОднуОблигацию);
	Запрос.УстановитьПараметр("СуммаНаОднуОблигациюВРублях", ЭтаФорма.СуммаНаОднуОблигациюВРублях);
	
	ПлановыеПогашения = Запрос.Выполнить().Выгрузить();
	ПлановыеПогашения.Индексы.Добавить("СчетДоверительногоУправления");
	
	// в плановые погашения запись попадает только тогда, когда нет созданного (проведенного или записанного)
	// соответствующего погашения; остальные распределяются по созданным погашениям
	Для каждого СтрокаПогашенияСозданные Из ЭтаФорма.ПогашенияСозданные.ПолучитьЭлементы() Цикл
		
		// пропускаем погашения, помеченние на удаление
		Если СтрокаПогашенияСозданные.ИсключатьИзРасчетов Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиПлановыеПогашения = ПлановыеПогашения.НайтиСтроки(
			Новый Структура("СчетДоверительногоУправления",
				СтрокаПогашенияСозданные.СчетДоверительногоУправления));
				
		Если СтрокиПлановыеПогашения.Количество() = 1 Тогда
			
			СтрокаПлановыеПогашения = СтрокиПлановыеПогашения[0];
			
			Если СтрокаПогашенияСозданные.Количество >= СтрокаПлановыеПогашения.Количество Тогда
				
				СтрокаПогашенияСозданные.ПлановоеКоличество       = СтрокаПлановыеПогашения.Количество;
				СтрокаПогашенияСозданные.ПлановоеКоличествоПоРЕПО = СтрокаПлановыеПогашения.КоличествоПоРЕПО;
				СтрокаПогашенияСозданные.ПлановоеКоличествоВРЕПО = СтрокаПлановыеПогашения.КоличествоВРЕПО;
				
				ПлановыеПогашения.Удалить(СтрокаПлановыеПогашения);
				
			Иначе
				
				СтрокаПогашенияСозданные.ПлановоеКоличество       = СтрокаПогашенияСозданные.Количество;
				СтрокаПогашенияСозданные.ПлановоеКоличествоПоРЕПО = СтрокаПлановыеПогашения.КоличествоПоРЕПО * СтрокаПогашенияСозданные.Количество / СтрокаПлановыеПогашения.Количество;
				СтрокаПогашенияСозданные.ПлановоеКоличествоВРЕПО = СтрокаПлановыеПогашения.КоличествоВРЕПО * СтрокаПогашенияСозданные.Количество / СтрокаПлановыеПогашения.Количество;
				
				СтрокаПлановыеПогашения.Количество       = СтрокаПлановыеПогашения.Количество       - СтрокаПогашенияСозданные.ПлановоеКоличество;
				СтрокаПлановыеПогашения.КоличествоПоРЕПО = СтрокаПлановыеПогашения.КоличествоПоРЕПО - СтрокаПогашенияСозданные.ПлановоеКоличествоПоРЕПО;
				СтрокаПлановыеПогашения.КоличествоВРЕПО = СтрокаПлановыеПогашения.КоличествоВРЕПО - СтрокаПогашенияСозданные.ПлановоеКоличествоВРЕПО;
				
			КонецЕсли;
				
		ИначеЕсли СтрокиПлановыеПогашения.Количество() > 1 Тогда // такого быть не должно, но на всякий случай, перестрахуемся
			
			Сообщить("Ошибка распределения плановых показателей по фактическим операциям. Найдено более одной подходящей строки. Обратитесь к разработчикам.");
			Возврат Неопределено;
			
		КонецЕсли;
		
	КонецЦикла;	
	
	// распределим оставшиеся плановые значения
	ПогашенияСозданныеНаСервере = РеквизитФормыВЗначение("ПогашенияСозданные");
	
	Если ПлановыеПогашения.Количество() > 0 Тогда
		
		// сложность распределения в том, что плановые суммы могут закрываться разными документами
		// поэтому оставшуюся разницу закинем на первую попашуюся подходящую строку
		
		ПогашенияПлановыеНаСервере = РеквизитФормыВЗначение("ПогашенияПлановые");
				
		Для каждого СтрокаПлановыеПогашения Из ПлановыеПогашения Цикл
			
			СтрокиПогашенияСозданныеНаСервере = ПогашенияСозданныеНаСервере.Строки.НайтиСтроки(
				Новый Структура("СчетДоверительногоУправления", СтрокаПлановыеПогашения.СчетДоверительногоУправления));

			// исключим помеченные на удаление документы		
			Для Инд = 1 - СтрокиПогашенияСозданныеНаСервере.Количество() По 0 Цикл
				Если СтрокиПогашенияСозданныеНаСервере[-Инд].ИсключатьИзРасчетов Тогда
					СтрокиПогашенияСозданныеНаСервере.Удалить(-Инд);
				КонецЕсли;
			КонецЦикла;		
					
			Если СтрокиПогашенияСозданныеНаСервере.Количество() = 0 Тогда
			
				НоваяСтрокаПогашенияПлановыеНаСервере = ПогашенияПлановыеНаСервере.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаПогашенияПлановыеНаСервере, СтрокаПлановыеПогашения);
								
			Иначе
				
				СтрокаПогашенияСозданныеНаСервере = СтрокиПогашенияСозданныеНаСервере[СтрокиПогашенияСозданныеНаСервере.Количество() - 1];
				СтрокаПогашенияСозданныеНаСервере.ПлановоеКоличество       = СтрокаПогашенияСозданныеНаСервере.ПлановоеКоличество       + СтрокаПлановыеПогашения.Количество;
				СтрокаПогашенияСозданныеНаСервере.ПлановоеКоличествоПоРЕПО = СтрокаПогашенияСозданныеНаСервере.ПлановоеКоличествоПоРЕПО + СтрокаПлановыеПогашения.КоличествоПоРЕПО;
				СтрокаПогашенияСозданныеНаСервере.ПлановоеКоличествоВРЕПО  = СтрокаПогашенияСозданныеНаСервере.ПлановоеКоличествоВРЕПО  + СтрокаПлановыеПогашения.КоличествоВРЕПО;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ЗначениеВРеквизитФормы(ПогашенияПлановыеНаСервере, "ПогашенияПлановые");
						
	КонецЕсли;
	
	ПогашенияСозданныеНаСервере.Строки.Сортировать("ИсключатьИзРасчетов, Объект");
	
	ЗначениеВРеквизитФормы(ПогашенияСозданныеНаСервере, "ПогашенияСозданные");
	
	// заполним плановые суммы в созданных погашениях
	Для каждого СтрокаПогашенияСозданные Из ЭтаФорма.ПогашенияСозданные.ПолучитьЭлементы() Цикл
		//СтрокаПогашенияСозданные.ПлановаяСуммаКупона = РаботаСВалютами.ПересчетСуммыВВалюте(СтрокаПогашенияСозданные.ПлановоеКоличество * ЭтаФорма.СуммаНаОднуОблигацию, ВалютаНоминала, Дата, СтрокаПогашенияСозданные.ВалютаОплаты, Дата);
		СтрокаПогашенияСозданные.ПлановаяСуммаКупона = СтрокаПогашенияСозданные.ПлановоеКоличество * ЭтаФорма.СуммаНаОднуОблигацию;
		СтрокаПогашенияСозданные.ПлановаяСуммаКупонаВРублях = СтрокаПогашенияСозданные.ПлановоеКоличество * ЭтаФорма.СуммаНаОднуОблигациюВРублях;
	КонецЦикла;
	
КонецФункции // ЗаполнитьПлановыеПогашенияНаСервере

&НаСервере
Функция НастроитьВидимостьДоступностьНаСервере()
	
	// в созданных погашения колонка "Сумма на одну облигацию" отображается только тогда,
	// когда есть более одного варианта значения
	ЕстьРасхожденияПоСуммыНаОднуОблигацию = Ложь;
	ЕстьРасхожденияПоКоличество           = Ложь;
	ЕстьРасхожденияПоСуммаКупона          = Ложь;
	
	Для каждого Строка1ПогашенияСозданные Из ЭтаФорма.ПогашенияСозданные.ПолучитьЭлементы() Цикл
		
		Если Строка1ПогашенияСозданные.ИсключатьИзРасчетов Тогда
			Продолжить;
		КонецЕсли;
		
		Строка1ПогашенияСозданные._ПлановоеКоличество       	= " (" + Строка1ПогашенияСозданные.ПлановоеКоличество + ")";
		Строка1ПогашенияСозданные._ПлановоеКоличествоПоРЕПО 	= " (" + Строка1ПогашенияСозданные.ПлановоеКоличествоПоРЕПО + ")";
		Строка1ПогашенияСозданные._ПлановаяСуммаКупона      	= " (" + Строка1ПогашенияСозданные.ПлановаяСуммаКупона + ")";
		Строка1ПогашенияСозданные._ПлановаяСуммаКупонаВРублях 	= " (" + Строка1ПогашенияСозданные.ПлановаяСуммаКупонаВРублях + ")";
		
		Строка1ПогашенияСозданные.РасхождениеПоСуммаНаОднуОблигацию = (Строка1ПогашенияСозданные.СуммаНаОднуОблигацию <> ЭтаФорма.СуммаНаОднуОблигацию);
		Строка1ПогашенияСозданные.РасхождениеПоКоличество           = (Строка1ПогашенияСозданные.Количество           <> Строка1ПогашенияСозданные.ПлановоеКоличество);
		Строка1ПогашенияСозданные.РасхождениеПоСуммаКупона          = (Строка1ПогашенияСозданные.СуммаКупона          <> Строка1ПогашенияСозданные.ПлановаяСуммаКупона);
		
		Если Не ЕстьРасхожденияПоСуммыНаОднуОблигацию И Строка1ПогашенияСозданные.РасхождениеПоСуммаНаОднуОблигацию Тогда
			ЕстьРасхожденияПоСуммыНаОднуОблигацию = Истина;
		КонецЕсли;
		
		Если Не ЕстьРасхожденияПоКоличество И Строка1ПогашенияСозданные.РасхождениеПоКоличество Тогда
			ЕстьРасхожденияПоКоличество = Истина;
		КонецЕсли;
		
		Если Не ЕстьРасхожденияПоСуммаКупона И Строка1ПогашенияСозданные.РасхождениеПоСуммаКупона Тогда
			ЕстьРасхожденияПоСуммаКупона = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.ПогашенияСозданныеСуммаНаОднуОблигацию.Видимость     	 = ЕстьРасхожденияПоСуммыНаОднуОблигацию;
	Элементы.ПогашенияСозданныеСуммаНаОднуОблигациюВРублях.Видимость = ЕстьРасхожденияПоСуммыНаОднуОблигацию;
	Элементы.ПогашенияСозданные_ПлановоеКоличество.Видимость       	 = ЕстьРасхожденияПоКоличество;
	Элементы.ПогашенияСозданные_ПлановаяСуммаКупона.Видимость      	 = ЕстьРасхожденияПоСуммаКупона;
	Элементы.ПогашенияСозданные_ПлановаяСуммаКупонаВРублях.Видимость = ЕстьРасхожденияПоСуммаКупона;
	
КонецФункции // НастроитьВидимостьДоступностьНаСервере

&НаСервере
Функция ЗаполнитьПлановыеИСозданныеПогашенияНаСервере()
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.ДатаФиксации) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для даты погашения " + Формат(ЭтаФорма.Дата, "ДФ=dd.MM.yyyy") + " не указана дата фиксации в регистре ""Купонный доход по облигациям""!");
		ЭтаФорма.ПогашенияПлановые.Очистить();
		ЭтаФорма.ПогашенияСозданные.ПолучитьЭлементы().Очистить();
		Возврат Ложь;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ВалютаНоминала) Тогда
		ВалютаНоминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Облигация, "ВалютаНоминала");
	КонецЕсли;
	
	ОбновитьСуммыНаОднуОблигациюНаСервере();
	
	ЗаполнитьСозданныеПогашенияКупонаНаСервере();
	
	ЗаполнитьПлановыеПогашенияНаСервере();		
	
	НастроитьВидимостьДоступностьНаСервере();
	
	ОбновитьНадписьПогашенияПлановыеИтого(ЭтаФорма);
	
КонецФункции // ЗаполнитьПлановыеИСозданныеПогашенияНаСервере

&НаСервереБезКонтекста
Функция ПолучитьСуммыКупона(Облигация, Дата)
	
	Результат = Новый Структура("СуммаКупона,СуммаКупонаВРублях", 0, 0);
	
	Если Не ЗначениеЗаполнено(Облигация) Или Не ЗначениеЗаполнено(Дата) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КупонныйДоходПоОблигациям.СуммаКупона КАК СуммаКупона,
		|	КупонныйДоходПоОблигациям.СуммаКупонаВРублях КАК СуммаКупонаВРублях
		|ИЗ
		|	РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|ГДЕ
		|	КупонныйДоходПоОблигациям.Облигация = &Облигация
		|	И КупонныйДоходПоОблигациям.ДатаОкончанияКупона = &Дата";
	
	Запрос.УстановитьПараметр("Облигация", Облигация);
	Запрос.УстановитьПараметр("Дата",      НачалоДня(Дата));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.СуммаКупона = Выборка.СуммаКупона;
		Результат.СуммаКупонаВРублях = Выборка.СуммаКупонаВРублях;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ПолучитьСуммыКупонаИзРегистра

&НаСервере
Процедура ОбновитьСуммыНаОднуОблигациюНаСервере()
	
	Элементы.СуммаНаОднуОблигацию.ТолькоПросмотр = Истина;
	Элементы.СуммаНаОднуОблигациюВРублях.ТолькоПросмотр = Истина;
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.Облигация) Или Не ЗначениеЗаполнено(ЭтаФорма.Дата) Тогда
		ЭтаФорма.СуммаНаОднуОблигацию = 0;
		ЭтаФорма.СуммаНаОднуОблигациюВРублях = 0;
		Возврат;
	КонецЕсли;
	
	СуммыИзРегистра = ПолучитьСуммыКупона(ЭтаФорма.Облигация, ЭтаФорма.Дата);
	
	ЭтаФорма.СуммаНаОднуОблигацию = СуммыИзРегистра.СуммаКупона;
	ЭтаФорма.СуммаНаОднуОблигациюВРублях = СуммыИзРегистра.СуммаКупонаВРублях; 
	
	Если ЭтаФорма.СуммаНаОднуОблигацию = 0 И ЭтаФорма.СуммаНаОднуОблигациюВРублях = 0 Тогда
		Сообщить(
			"В регистре ""Купонный доход по облигациям"" не найдены суммы купона (в валюте и в рублях) для облигации " 
			+ Строка(ЭтаФорма.Облигация) + " на дату " + Формат(ЭтаФорма.Дата, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
		
	ПоказатьВРублях = (Строка(ВалютаНоминала) <> "RUB");
	
	//Настройка видимости суммы в рублях
	Элементы.СуммаНаОднуОблигациюВРублях.Видимость = ПоказатьВРублях;
    Элементы.ПогашенияСозданныеГруппаСуммаКупонаВРублях.Видимость = ПоказатьВРублях;
	Элементы.ПогашенияСозданныеСуммаНаОднуОблигациюВРублях.Видимость = ПоказатьВРублях И Элементы.ПогашенияСозданныеСуммаНаОднуОблигацию.Видимость;
	Элементы.ПогашенияПлановыеСуммаКупонаВРублях.Видимость = ПоказатьВРублях;

	//Настройка заголовка	
	Элементы.СуммаНаОднуОблигацию.Заголовок = "Сумма на одну облигацию в " + Строка(ВалютаНоминала);
	Элементы.ПогашенияСозданныеСуммаКупона.Заголовок = "Сумма купона в " + Строка(ВалютаНоминала);
	Элементы.ПогашенияСозданныеСуммаНаОднуОблигацию.Заголовок = "Сумма на одну облигацию в " + Строка(ВалютаНоминала);
	Элементы.ПогашенияПлановыеСуммаКупона.Заголовок = "Сумма купона в " + Строка(ВалютаНоминала);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДанныеВыбранныхДокументов()
	
	ДанныеВыбранныхДокументов = Новый Массив;
	
	ВыделенныеСтрокиСписка = Элементы.ПогашенияСозданные.ВыделенныеСтроки;
	
	Если ВыделенныеСтрокиСписка = Неопределено Тогда
		Возврат ДанныеВыбранныхДокументов;
	КонецЕсли;
	
	Если ВыделенныеСтрокиСписка.Количество() = 0 Тогда
		Возврат ДанныеВыбранныхДокументов;
	КонецЕсли;	
	
	Для каждого ВыделеннаяСтрокаСписка Из ВыделенныеСтрокиСписка Цикл
		
		ДанныеВыделеннойСтрокиСписка = Элементы.ПогашенияСозданные.ДанныеСтроки(ВыделеннаяСтрокаСписка);
		
		Состояние = Неопределено;
		
		Если      ДанныеВыделеннойСтрокиСписка.СостояниеДокумента = 0 Тогда
			Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументов.ПомеченНаУдаление");
		ИначеЕсли ДанныеВыделеннойСтрокиСписка.СостояниеДокумента = 1 Тогда
			Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументов.Проведен");
		ИначеЕсли ДанныеВыделеннойСтрокиСписка.СостояниеДокумента = 2 Тогда
			Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументов.Записан");
		КонецЕсли;
		
		ДанныеВыбранныхДокументов.Добавить(
			Новый Структура("Документ, Состояние", ДанныеВыделеннойСтрокиСписка.Документ, Состояние));
		
	КонецЦикла;

	Возврат ДанныеВыбранныхДокументов;
	
КонецФункции // ПолучитьДанныеВыбранныхДокументов

&НаСервереБезКонтекста
Функция ПолучитьДатуФиксации(Облигация, ДатаПогашения)
	
	ДатаФиксации  = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КупонныйДоходПоОблигациям.ДатаФиксации
		|ИЗ
		|	РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|ГДЕ
		|	КупонныйДоходПоОблигациям.Облигация = &Облигация
		|	И КупонныйДоходПоОблигациям.ДатаОкончанияКупона = &ДатаПогашения";
		
	Запрос.УстановитьПараметр("Облигация"		, Облигация);
	Запрос.УстановитьПараметр("ДатаПогашения"	, ДатаПогашения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДатаФиксации = Выборка.ДатаФиксации;
	КонецЕсли;
	
	Возврат ДатаФиксации;
	
КонецФункции

#КонецОбласти

&НаКлиенте
Процедура СуммаНаОднуОблигациюПриИзменении(Элемент)
	
	Для каждого СтрокаПогашенияПлановые Из ЭтаФорма.ПогашенияПлановые Цикл
		СтрокаПогашенияПлановые.СуммаКупона = СтрокаПогашенияПлановые.Количество * ЭтаФорма.СуммаНаОднуОблигацию;
		СтрокаПогашенияПлановые.СуммаКупонаВРублях = СтрокаПогашенияПлановые.Количество * ЭтаФорма.СуммаНаОднуОблигациюВРублях;
	КонецЦикла;
	
	ОбновитьНадписьПогашенияПлановыеИтого(ЭтаФорма);
	
КонецПроцедуры
