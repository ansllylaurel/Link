
&НаКлиенте
Процедура Сформировать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("Сформировать");
	Попытка
		ВыполнитьСформировать(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСформировать(ПараметрыСессии)
	
	Если ПроверитьЗаполнение() Тогда
		СформироватьНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()

	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("МакетСтоиомостьПаяОптимумКонсенсус");	
	ТабличныйДокумент.Очистить();
	
	ДанныеПечати = ПолучитьДанныеПечати();
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтаФорма.ИсходящийДокумент, "Дата, Организация"); 
	ТабличныйДокумент.Вывести(РаботаСОтчетами.ПолучитьШапкуОфициальногоБланкаОрганизации(РеквизитыДокумента.Организация, РеквизитыДокумента.Дата));
	
	ОбластьШапка 			= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрокаТаблицы 	= Макет.ПолучитьОбласть("СтрокаТаблицы");
	ОбластьПодвал 			= Макет.ПолучитьОбласть("Подвал");
	
	ОбластьШапка.Параметры.Заполнить(ДанныеПечати.ОбщиеСведения);
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	Для каждого СтрокаТаблица Из ДанныеПечати.Таблица Цикл
	
		ОбластьСтрокаТаблицы.Параметры.Заполнить(СтрокаТаблица);
		ТабличныйДокумент.Вывести(ОбластьСтрокаТаблицы);
	
	КонецЦикла; 
	
	ОбластьПодвал.Параметры.Заполнить(ДанныеПечати.ОбщиеСведения);
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
КонецПроцедуры
 
&НаСервере
Функция ПолучитьДанныеПечати()

	ПустойНомер = "___________________ от ________________";
	
	#Область ТекстЗапроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	Лицензии.ОрганВыдавшийЛицензию КАК ОрганВыдавшийЛицензию,
		|	Лицензии.Номер КАК Номер,
		|	Лицензии.ДатаВыдачи КАК ДатаВыдачи
		|ПОМЕСТИТЬ _РеквизитыПрофучастника
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо = &ОрганизацияЮрФизЛицо) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних,
		|	РегистрСведений.СтатусыЛицензий.СрезПоследних КАК СтатусыЛицензийСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лицензии КАК Лицензии
		|		ПО СтатусыЛицензийСрезПоследних.Лицензия = Лицензии.Ссылка
		|			И (Лицензии.ЮрФизЛицо = &ОрганизацияЮрФизЛицо)
		|			И (Лицензии.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ))
		|			И (СтатусыЛицензийСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтактныеЛица.Должность КАК Должность,
		|	КонтактныеЛица.ОснованиеПолномочий КАК ОснованиеПолномочий,
		|	КонтактныеЛица.КонтактноеЛицо.Наименование КАК Ответственный
		|ПОМЕСТИТЬ _РеквизитыПодписанта
		|ИЗ
		|	РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|ГДЕ
		|	(КонтактныеЛица.Подразделение, КонтактныеЛица.Язык, КонтактныеЛица.Объект, КонтактныеЛица.КонтактноеЛицо) В
		|			(ВЫБРАТЬ
		|				ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний) КАК Подразделение,
		|				ЗНАЧЕНИЕ(Справочник.Языки.Русский) КАК Язык,
		|				&ОрганизацияЮрФизЛицо КАК Объект,
		|				&Подписант КАК КонтактноеЛицо)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходящийДокумент.Дата КАК Дата,
		|	ИсходящийДокумент.Номер КАК Номер,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ИсходящийДокумент.Получатель) КАК Получатель
		|ПОМЕСТИТЬ _РеквизитыИсходящегоДокумента
		|ИЗ
		|	Документ.ИсходящийДокумент КАК ИсходящийДокумент
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ИсходящийДокумент.Получатель = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	ИсходящийДокумент.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВходящийДокумент.ДатаВходящегоДокумента КАК Дата,
		|	ВходящийДокумент.НомерВходящегоДокумента КАК Номер
		|ПОМЕСТИТЬ _РеквизитыОснований
		|ИЗ
		|	Документ.ИсходящийДокумент.Основания КАК ИсходящийДокументОснования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВходящийДокумент КАК ВходящийДокумент
		|		ПО ИсходящийДокументОснования.Основание = ВходящийДокумент.Ссылка
		|ГДЕ
		|	ИсходящийДокументОснования.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _КлиентыДУ
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления В (&Консенсус, &Оптимум)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлиентыДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	РеквизитыПИФ.ПаевойИнвестиционныйФонд КАК ПИФ,
		|	РеквизитыПИФ.ПолноеНаименованиеФонда КАК ПолноеНаименование,
		|	РеквизитыПИФ.ПаевойИнвестиционныйФонд.НомерПравил КАК НомерПравил,
		|	РеквизитыПИФ.ПаевойИнвестиционныйФонд.ДатаПравил КАК ДатаПравил,
		|	РеквизитыПИФ.ПаевойИнвестиционныйФонд.ОрганУтвердившийПравила КАК ОрганУтвердившийПравила
		|ПОМЕСТИТЬ _РеквизитыПИФ
		|ИЗ
		|	_КлиентыДУ КАК _КлиентыДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(
		|				&Период,
		|				ПаевойИнвестиционныйФонд В
		|					(ВЫБРАТЬ
		|						_КлиентыДУ.Клиент
		|					ИЗ
		|						_КлиентыДУ)) КАК РеквизитыПИФ
		|		ПО _КлиентыДУ.Клиент = РеквизитыПИФ.ПаевойИнвестиционныйФонд
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказатели.Период КАК Дата,
		|	ФинансовыеПоказатели.СубъектАналитики КАК СчетДоверительногоУправления,
		|	ФинансовыеПоказатели.Значение КАК СтоимостьПая
		|ИЗ
		|	_КлиентыДУ КАК _КлиентыДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО _КлиентыДУ.СчетДоверительногоУправления = ФинансовыеПоказатели.СубъектАналитики
		|ГДЕ
		|	ФинансовыеПоказатели.Период В(&ОтчетныеДаты)
		|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьПая)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата
		|ИТОГИ ПО
		|	Дата";
	
	#КонецОбласти 
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтаФорма.ИсходящийДокумент, "Дата, Номер, Получатель, Организация"); 
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.УстановитьПараметр("Период", 				РеквизитыДокумента.Дата);
	Запрос.УстановитьПараметр("Организация", 			РеквизитыДокумента.Организация);
	Запрос.УстановитьПараметр("ОрганизацияЮрФизЛицо", 	ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыДокумента.Организация, "ЮрФизЛицо"));
	Запрос.УстановитьПараметр("Подписант", 				ЭтаФорма.Подписант);
	Запрос.УстановитьПараметр("Консенсус", 				ЭтаФорма.Консенсус);
	Запрос.УстановитьПараметр("Оптимум", 				ЭтаФорма.Оптимум);
	Запрос.УстановитьПараметр("ОтчетныеДаты", 			ЭтаФорма.ОтчетныеДаты);
	Запрос.УстановитьПараметр("Ссылка",					ЭтаФорма.ИсходящийДокумент);
		
	Результат = Запрос.Выполнить();
	
	ОбщиеСведения = Новый Структура;
	
	ВыборкаПФ = МВТ.Таблицы.Найти("_РеквизитыПрофучастника").ПолучитьДанные().Выбрать();
	Если ВыборкаПФ.Следующий() Тогда
		
		Лицензия = "Лицензия " + ВыборкаПФ.ОрганВыдавшийЛицензию + " на осуществление деятельности  по управлению инвестиционными фондами, паевыми инвестиционными фондами и негосударственными пенсионными фондами №" 
			+ ВыборкаПФ.Номер + " от " + Формат(ВыборкаПФ.ДатаВыдачи, "ДФ='dd.MM.yyyy ""г.""'");
			
		ОбщиеСведения.Вставить("Лицензия",				ВыборкаПФ.ПолноеНаименованиеПоУставу + " (" + Лицензия + ")");
		
	КонецЕсли;
	
	ВыборкаПодписант = МВТ.Таблицы.Найти("_РеквизитыПодписанта").ПолучитьДанные().Выбрать();
	Если ВыборкаПодписант.Следующий() Тогда
		ОбщиеСведения.Вставить("Должность", 	ВыборкаПодписант.Должность);
		ОбщиеСведения.Вставить("Подписант", 	ВыборкаПодписант.Ответственный);
	КонецЕсли;
	
	ВыборкаИсходящийДокумент = МВТ.Таблицы.Найти("_РеквизитыИсходящегоДокумента").ПолучитьДанные().Выбрать();
	Если ВыборкаИсходящийДокумент.Следующий() Тогда
		
		ОбщиеСведения.Вставить("Клиент", ВыборкаИсходящийДокумент.Получатель);
		ОбщиеСведения.Вставить("ИсходящийНомер", ВыборкаИсходящийДокумент.Номер + " от " + Формат(ВыборкаИсходящийДокумент.Дата, "ДФ='dd.MM.yyyy ""г.""'"));
		
		ВыборкаОснований = МВТ.Таблицы.Найти("_РеквизитыОснований").ПолучитьДанные().Выбрать();
		МассивОснований = Новый Массив;
		Пока ВыборкаОснований.Следующий() Цикл
		
			МассивОснований.Добавить(ВыборкаОснований.Номер + " от " + Формат(ВыборкаОснований.Дата, "ДФ='dd.MM.yyyy ""г.""'"));
		
		КонецЦикла; 
		ОбщиеСведения.Вставить("ВходящийНомер", СтрСоединить(МассивОснований, ", "));
		
	КонецЕсли;
	
	ВыборкаРеквизитыПИФ = МВТ.Таблицы.Найти("_РеквизитыПИФ").ПолучитьДанные().Выбрать();
	
	//Правила доверительного управления Закрытым паевым инвестиционным комбинированным фондом "Оптимум"  зарегистрированы  Банком России 23 июля 2019 года за № 3776.)
	ШаблонПравил = "Правила доверительного управления %1 %2 зарегистрированы %3 %4 года за №%5.";
	
	Пока ВыборкаРеквизитыПИФ.Следующий() Цикл
	
		СтрокаНаименование 		= ВыборкаРеквизитыПИФ.ПолноеНаименование;
		
		Позиция 				= Найти(СтрокаНаименование, """");
		СтрокаНаименование1 	= Лев(СтрокаНаименование, Позиция-1); 
		СтрокаНаименование2 	= Сред(СтрокаНаименование, Позиция);
		ОрганУтвердившийПравила = ?(ЗначениеЗаполнено(ВыборкаРеквизитыПИФ.ОрганУтвердившийПравила), ВыборкаРеквизитыПИФ.ОрганУтвердившийПравила, "Банком России");
		
		Правила = СтрШаблон(ШаблонПравил, 
			ПолучитьСклоненияСтроки(СтрокаНаименование1, , "ПД=Творительный")[0], 
			СтрокаНаименование2, 
			ОрганУтвердившийПравила,
			Формат(ВыборкаРеквизитыПИФ.ДатаПравил, "ДФ='dd ММММ yyyy'"),
			ВыборкаРеквизитыПИФ.НомерПравил);
			
		Если ВыборкаРеквизитыПИФ.СчетДоверительногоУправления = ЭтаФорма.Консенсус Тогда
			ОбщиеСведения.Вставить("ЗаголовокКонсенсус", 	СтрокаНаименование);
			ОбщиеСведения.Вставить("ПравилаКонсенсус", 		Правила);
		Иначе
			ОбщиеСведения.Вставить("ЗаголовокОптимум", 		СтрокаНаименование);
			ОбщиеСведения.Вставить("ПравилаОптимум", 		Правила);
		КонецЕсли; 
		
	КонецЦикла;
	
	ОписаниеТиповДенежныеСуммы = Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип;
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Дата", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("СтоимостьПаяКонсенсус", ОписаниеТиповДенежныеСуммы);
	Таблица.Колонки.Добавить("СтоимостьПаяОптимум", ОписаниеТиповДенежныеСуммы);
	
	ВыборкаДаты = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДаты.Следующий() Цикл
	
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Дата = Формат(ВыборкаДаты.Дата, "ДФ=dd.MM.yyyy");
		
		ВыборкаСчета = ВыборкаДаты.Выбрать();
		Пока ВыборкаСчета.Следующий() Цикл
		
			Если ВыборкаСчета.СчетДоверительногоУправления = ЭтаФорма.Консенсус Тогда
				НоваяСтрока.СтоимостьПаяКонсенсус = ВыборкаСчета.СтоимостьПая;
			Иначе
				НоваяСтрока.СтоимостьПаяОптимум = ВыборкаСчета.СтоимостьПая;
			КонецЕсли;
		
		КонецЦикла; 
	
	КонецЦикла; 
		
	ДанныеПечати = Новый Структура("ОбщиеСведения, Таблица", ОбщиеСведения, Таблица);
	
	Возврат ДанныеПечати;

КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтаФорма.ИсходящийДокумент = Параметры.Ссылка;
	ЭтаФорма.Оптимум = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Оптимум");
	ЭтаФорма.Консенсус = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Консенсус");
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти