Функция ПолучитьПросроченныеРаспоряженияМНО(Дата, Организация, Банк) Экспорт
	
	Запрос = Новый Запрос; 
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Документ.Ссылка КАК Документ,
		|	ВЫБОР
		|		КОГДА Документ.Проведен
		|			ТОГДА 1
		|		КОГДА Документ.ПометкаУдаления
		|			ТОГДА 0
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК СостояниеДокумента,
		|	Документ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Документ.РасчетныйСчет КАК РасчетныйСчет,
		|	Документ.Процент КАК Процент,
		|	Документ.ДатаВозврата КАК ДатаВозврата,
		|	Документ.Сумма КАК Сумма
		|ИЗ
		|	Документ.Распоряжение КАК Документ
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(Документ.Дата, ДЕНЬ) < &Дата
		|	И НЕ Документ.ПометкаУдаления
		|	И Документ.Организация = &Организация
		|	И Документ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО)
		|	И НЕ Документ.Ссылка В
		|				(ВЫБРАТЬ
		|					МНО.Основание КАК Распоряжение
		|				ИЗ
		|					Документ.МНО КАК МНО
		|				ГДЕ
		|					НАЧАЛОПЕРИОДА(МНО.Дата, ДЕНЬ) < &Дата
		|					И МНО.Проведен
		|					И МНО.Организация = &Организация
		|					И (&БезОтбораПоБанку
		|						ИЛИ МНО.РасчетныйСчет.Банк = &Банк))
		|	И (&БезОтбораПоБанку
		|			ИЛИ Документ.РасчетныйСчет.Банк = &Банк)";
#КонецОбласти

	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
    Запрос.УстановитьПараметр("Банк", Банк);
	Запрос.УстановитьПараметр("БезОтбораПоБанку", (Не ЗначениеЗаполнено(Банк)));
		
	ПросроченныеРаспоряжения = Запрос.Выполнить().Выгрузить();
	
	Возврат ПросроченныеРаспоряжения;	
	
КонецФункции

Процедура ВыполнитьМетод(Метод, Экземпляры) Экспорт
	
	Механизм = Метаданные.Обработки.Распоряжения.Имя + "." + Метод;
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм);
	ДопПараметрыСтатистики = Новый Структура("Результат", "");

	Если Метод <> "СформироватьОповещенияОРаспоряженияхОжидающихАкцепта" Тогда
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, ДопПараметрыСтатистики);
		Возврат;	
	КонецЕсли;
	
	Ключи = Новый ТаблицаЗначений;
	
	Ключи.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("УникальныйИдентификатор"));
	Ключи.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Ключи.Колонки.Добавить("РаспоряжениеНаМНО", Новый ОписаниеТипов("ДокументСсылка.Распоряжение"));
		
	Для Каждого Экземпляр Из Экземпляры Цикл
	
		НовыйКлюч = Ключи.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйКлюч, Экземпляр.Параметры);
		НовыйКлюч.Идентификатор = Экземпляр.Идентификатор;
	
	КонецЦикла;
	
	МВТ = Новый МенеджерВременныхТаблиц; 
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(Ключи, "_Экземпляры", МВТ,, "Идентификатор,Организация,РаспоряжениеНаМНО");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;

#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Экземпляры.Организация КАК Организация,
		|	_Экземпляры.РаспоряжениеНаМНО КАК Распоряжение
		|ПОМЕСТИТЬ _ГруппыЭкземпляров
		|ИЗ
		|	_Экземпляры КАК _Экземпляры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_Экземпляры.Идентификатор КАК Идентификатор,
		|	_Экземпляры.Организация КАК Организация,
		|	_Экземпляры.РаспоряжениеНаМНО КАК Распоряжение,
		|	ДокРаспоряжение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДокРаспоряжение.СчетДоверительногоУправления.КодСчета КАК КодСчета,
		|	ДокРаспоряжение.РасчетныйСчет КАК РасчетныйСчет,
		|	ДокРаспоряжение.Сумма КАК Сумма,
		|	ДокРаспоряжение.Валюта КАК Валюта,
		|	ДокРаспоряжение.Процент КАК Процент,
		|	ДокРаспоряжение.ДатаВозврата КАК ДатаВозврата,
		|	ДокРаспоряжение.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	_Экземпляры КАК _Экземпляры
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Распоряжение КАК ДокРаспоряжение
		|		ПО _Экземпляры.РаспоряжениеНаМНО = ДокРаспоряжение.Ссылка
		|			И _Экземпляры.Организация = ДокРаспоряжение.Организация
		|ИТОГИ ПО
		|	Организация";
#КонецОбласти
	
	ВыборкаГруппировкаПоОрганизации = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
			
	Пока ВыборкаГруппировкаПоОрганизации.Следующий() Цикл
		
		ОписаниеТабличнойЧасти = "";
		МассивИдентификаторов = Новый Массив;
		
		Выборка = ВыборкаГруппировкаПоОрганизации.Выбрать();
		
		ДопПараметрыСтатистики.Результат = ДопПараметрыСтатистики.Результат + ?(ДопПараметрыСтатистики.Результат = "", "", ". ") 
			+ " УК " + ВыборкаГруппировкаПоОрганизации.Организация + ". Выполнено заданий " + Выборка.Количество() + " ед.";   		
		
		Пока Выборка.Следующий() Цикл 
			
			Если Выборка.ПометкаУдаления Тогда
				РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(Выборка.Идентификатор,, "Отмена выполнения. Распоряжение помечено на удаление.");
				Продолжить;
			КонецЕсли;
							
			ТекСтрока = "<tr><td>" + ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Выборка.Распоряжение) 
						+ "</td><td>" + СокрЛП(Выборка.РасчетныйСчет)  
						+ "</td><td>" + Выборка.Сумма 
						+ "</td><td>" + Выборка.Валюта  
						+ "</td><td>" + Выборка.Процент
						+ "</td><td>" + Формат(Выборка.ДатаВозврата, "ДФ=dd.MM.yyyy")
						+ "</td><td>" + СокрЛП(Выборка.СчетДоверительногоУправления)
						+ "</td><td>" + СокрЛП(Выборка.КодСчета) + "</td></tr>"; 
						
			ОписаниеТабличнойЧасти = ОписаниеТабличнойЧасти + Символы.ПС + ТекСтрока;
			
			МассивИдентификаторов.Добавить(Выборка.Идентификатор);

		КонецЦикла;
		
		Если ЗначениеЗаполнено(ОписаниеТабличнойЧасти) Тогда
			
			РеквизитыОповещения = Новый Структура("Организация", ВыборкаГруппировкаПоОрганизации.Организация); 
			РеквизитыОповещения.Вставить("Текст", СформироватьТекстСообщения(ОписаниеТабличнойЧасти)); 
		
			Справочники.Оповещения.СформироватьОповещения("Обработка.Распоряжения", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
			
		КонецЕсли;
		
		Для Каждого ТекИдентификатор Из МассивИдентификаторов Цикл
			РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(ТекИдентификатор);	
		КонецЦикла;
			
	КонецЦикла;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, ДопПараметрыСтатистики);
	
КонецПроцедуры 

Функция СформироватьТекстСообщения(ОписаниеТабличнойЧасти);
		
	ТекстСообщения =
		"<html>
		|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
		|	<style type=""text/css"">
		|		body  { font-family: ""Arial""; font-size: 12px; }
		|		table { text-align: left; border-spacing: 0; border-collapse: collapse; }
		|		td    { border: 1px solid #5877AD; padding: 5px; }
		|		.top  { background: #A6CAF0; }
		|	</style>
		|</head><body> 
		|<table cols=""8"">
		|<tr class=""top""><td colspan=""6"">Распоряжение</td><td colspan=""2"">Счет доверительного управления</td></tr>
		|<tr class=""top""><td>Ссылка</td><td>Расчетный счет</td><td>Сумма</td><td>Валюта</td><td>%</td><td>Дата возврата</td><td>Наименование</td><td>Код 1С</td></tr>";

	ТекстСообщения = ТекстСообщения + ОписаниеТабличнойЧасти + "</table></body></html>";
	
	Возврат ТекстСообщения;
		
КонецФункции
		
