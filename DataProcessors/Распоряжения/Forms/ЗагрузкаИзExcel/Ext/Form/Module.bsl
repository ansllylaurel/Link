
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, "Дата, Организация, Валюта, ВидОперации");
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИменованныеОбъекты.Имя КАК Имя,
		|	ВЫБОР
		|		КОГДА ИменованныеОбъекты.Имя = ""Организация_РПИ""
		|			ТОГДА ""ПИ""
		|		КОГДА ИменованныеОбъекты.Имя = ""Организация_РЭМ""
		|			ТОГДА ""РЭМ""
		|		КОГДА ИменованныеОбъекты.Имя = ""Организация_ТрастМ""
		|			ТОГДА ""ТРАСТ""
		|	КОНЕЦ КАК КодУК
		|ИЗ
		|	РегистрСведений.ИменованныеОбъекты КАК ИменованныеОбъекты
		|ГДЕ
		|	ИменованныеОбъекты.Объект = &Организация";
	
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		КодУК = Выборка.КодУК;
	КонецЕсли;
					
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРаспоряжения(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("СоздатьРаспоряжения");
	Попытка
		ВыполнитьСоздатьРаспоряжения(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСоздатьРаспоряжения(ПараметрыСессии)

	ТекДата = ТекущаяДата();
	
	МассивРаспоряжений = Новый Массив();
	
	РаспоряжениеМНО = (ЭтаФорма.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.МНО"));

	Для Каждого СтрокаДанных Из ЭтаФорма.ВнешниеДанные Цикл
		
		Если СтрокаДанных.СоздатьРаспоряжение И Элементы.ВнешниеДанные.ПроверитьСтроку(СтрокаДанных.ПолучитьИдентификатор()) Тогда
			
			ПараметрыРаспоряжения = Новый Структура;
			
			ПараметрыРаспоряжения.Вставить("Организация", ЭтаФорма.Организация);
			ПараметрыРаспоряжения.Вставить("Дата", ?(ЭтаФорма.Дата = НачалоДня(ТекДата), ТекДата, ЭтаФорма.Дата));
			ПараметрыРаспоряжения.Вставить("ВидОперации", ЭтаФорма.ВидОперации);
			ПараметрыРаспоряжения.Вставить("СчетДоверительногоУправления", СтрокаДанных.СчетДоверительногоУправления);
			ПараметрыРаспоряжения.Вставить("РасчетныйСчет", СтрокаДанных.РасчетныйСчетСписанияДенежныхСредств);
			ПараметрыРаспоряжения.Вставить("Сумма", СтрокаДанных.Сумма);
			ПараметрыРаспоряжения.Вставить("Валюта", СтрокаДанных.Валюта);
			ПараметрыРаспоряжения.Вставить("Процент", СтрокаДанных.Ставка);
			ПараметрыРаспоряжения.Вставить("ДатаРазмещения", ?(РаспоряжениеМНО, Дата(1,1,1), СтрокаДанных.ДатаРазмещения));
			ПараметрыРаспоряжения.Вставить("ДатаВозврата", СтрокаДанных.ДатаВозврата);
			ПараметрыРаспоряжения.Вставить("Банк", СтрокаДанных.БанкРазмещения);
			ПараметрыРаспоряжения.Вставить("РасчетныйСчетВозвратаДенежныхСредств", СтрокаДанных.РасчетныйСчетВозвратаДенежныхСредств);
			ПараметрыРаспоряжения.Вставить("ПериодичностьВыплатыПроцентов", СтрокаДанных.ПериодичностьВыплатыПроцентов);
			ПараметрыРаспоряжения.Вставить("ДоВостребования", СтрокаДанных.ДоВостребования);
			ПараметрыРаспоряжения.Вставить("ПроцентнаяСтавкаПриДосрочномЗакрытии", СтрокаДанных.СтавкаДоВостребования);
			ПараметрыРаспоряжения.Вставить("Субординированность", СтрокаДанных.Субординированность);
			ПараметрыРаспоряжения.Вставить("Коды", СтрокаДанных.КодУБрокера);
			ПараметрыРаспоряжения.Вставить("ПодКупон", СтрокаДанных.ПодКупон);
			
			МассивРаспоряжений.Добавить(ПараметрыРаспоряжения);
							
		КонецЕсли;
	
	КонецЦикла;
		
	Если МассивРаспоряжений.Количество() > 0 Тогда 
				
		СообщенияПользователю = СоздатьРаспоряженияНаСервере(МассивРаспоряжений);
		Закрыть(Новый Структура("СообщенияПользователю", СообщенияПользователю)); 
					
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо указать строки для загрузки распоряжений.");	
	КонецЕсли;
 	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Фильтр = "Таблицы EXCEL (*.xls;*.xlsx;*.xlsm)|*.xls;*.xlsx;*.xlsm";

	Если ДиалогВыбора.Выбрать() Тогда
		
		Если ЭтаФорма.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.МНО") Тогда
			ФайлМНО = ДиалогВыбора.ПолноеИмяФайла;
		ИначеЕсли ЭтаФорма.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента") Тогда	
			ФайлДепозитов = ДиалогВыбора.ПолноеИмяФайла; 
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьФайл(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ПрочитатьФайл");
	Попытка
		ВыполнитьПрочитатьФайл(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПрочитатьФайл(ПараметрыСессии)
			
	Если Не ЗначениеЗаполнено(КодУК) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нудалось определить код УК");
		ПараметрыСессии.ТекстОшибки = "Нудалось определить код УК";
		Возврат;
	КонецЕсли; 
	
	Если ВнешниеДанные.Количество() > 0
		И Вопрос("Перед заполнением табличная часть будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да
	Тогда
		ПараметрыСессии.ТекстОшибки = "Отмена пользователем";
		Возврат;
	КонецЕсли;
	
	ИсточникДанных = Новый Структура("ИмяФайла, ИмяЛиста, КоличествоПолей, ИндексПервойЯчейки");
			
	Если ЭтаФорма.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.МНО") Тогда
		ИсточникДанных.ИмяФайла = ЭтаФорма.ФайлМНО;
		ИсточникДанных.ИмяЛиста = Формат(Год(ЭтаФорма.Дата), "ЧГ=0; ЧФ=_Ч");
		ИсточникДанных.КоличествоПолей = 23;
		ИсточникДанных.ИндексПервойЯчейки = 3;
	ИначеЕсли ЭтаФорма.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента") Тогда	
		ИсточникДанных.ИмяФайла = ЭтаФорма.ФайлДепозитов;
		ИсточникДанных.ИмяЛиста = "реестр";
		ИсточникДанных.КоличествоПолей = 25;
		ИсточникДанных.ИндексПервойЯчейки = 2;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИсточникДанных.ИмяФайла) Тогда	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите файл для загрузки распоряжений.");
		ПараметрыСессии.ТекстОшибки = "Укажите файл для загрузки распоряжений.";
		Возврат;
	КонецЕсли;

	Файл = Новый Файл(ИсточникДанных.ИмяФайла);
	
	Если Не Файл.Существует() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось найти файл [" + ИсточникДанных.ИмяФайла + "] для загрузки распоряжений.");
		ПараметрыСессии.ТекстОшибки = "Не удалось найти файл для загрузки распоряжений.";
		Возврат;	
	КонецЕсли;
			
	Состояние("Выполняется чтение файла..");
	
	ВременныйАдресФайла = ПолучитьИмяВременногоФайла("xlsx");
	
	//копирование защищает от ошибки совместного доступа к файлу-исходнику
	КопироватьФайл(ИсточникДанных.ИмяФайла, ВременныйАдресФайла);
	
	БинарныйФайл = Новый ДвоичныеДанные(ВременныйАдресФайла);
	АдресФайлаВХранилище = ПоместитьВоВременноеХранилище(БинарныйФайл);
	
	ИсточникДанных.ИмяФайла = АдресФайлаВХранилище; 
	
	ДесериализоватьДанныеФайлаНаСервере(ИсточникДанных);
		
КонецПроцедуры

&НаСервере
Процедура ДесериализоватьДанныеФайлаНаСервере(Источник)
	
	Если ЭтаФорма.ВнешниеДанные.Количество() > 0 Тогда
		ЭтаФорма.ВнешниеДанные.Очистить();	
	КонецЕсли;

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");

	БинарныйФайл = ПолучитьИзВременногоХранилища(Источник.ИмяФайла);
	БинарныйФайл.Записать(ИмяВременногоФайла);    
	
	ДанныеТабличногоДокумента = Новый ТабличныйДокумент;
	ДанныеТабличногоДокумента.Прочитать(ИмяВременногоФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);

	Для Каждого ОбластьДокумента Из ДанныеТабличногоДокумента.Области Цикл 
		
		Если ОбластьДокумента.Имя = Источник.ИмяЛиста Тогда   
			
			ТабличныйДокументПриемник = Новый ТабличныйДокумент;
			
			ЛистДокумента = ДанныеТабличногоДокумента.ПолучитьОбласть(ОбластьДокумента.Имя);
			ОбластьШапки = ЛистДокумента.Область(Источник.ИндексПервойЯчейки, 1, Источник.ИндексПервойЯчейки, Источник.КоличествоПолей);
			
		    ТабличныйДокументПриемник.ВставитьОбласть(ОбластьШапки, ТабличныйДокументПриемник.Область(1, 1, 1, Источник.КоличествоПолей));
			                                                                 
			Если Не ШапкаТаблицыСоответствуетФормату(ТабличныйДокументПриемник, ЭтаФорма.ВидОперации) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка чтения файла!",, "ИмяФайла");
				Возврат;
			КонецЕсли;
			
			НомерПервойСтрокиЗаписей = Источник.ИндексПервойЯчейки + 1;
			НомерПоследнейСтрокиЗаписей = ПолучитьНомерПоследнейСтрокиЗаписей(ЛистДокумента, НомерПервойСтрокиЗаписей, ЛистДокумента.ВысотаТаблицы); 
			
			Для Индекс = 0 - НомерПоследнейСтрокиЗаписей По НомерПервойСтрокиЗаписей Цикл
					
				ПерваяЯчейка = ЛистДокумента.Область(-Индекс, 1);
				
				Если Не (ЗначениеЗаполнено(ПерваяЯчейка.Текст) И ЗначениеЗаполнено(ЛистДокумента.Область(-Индекс, 2).Текст)) Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТипЗнч(ПерваяЯчейка.Значение) = Тип("Дата") Тогда
						
					Если ПерваяЯчейка.Значение = ЭтаФорма.Дата Тогда
						НомерПервойСтрокиЗаписей = -Индекс;
					ИначеЕсли ПерваяЯчейка.Значение < ЭтаФорма.Дата Тогда
						Прервать;
					КонецЕсли;
					
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + (-Индекс) + "] в поле [Дата составления] некорректный формат значения. Данные распоряжения на МНО не загружены.");
					Продолжить;
				КонецЕсли;
						
			КонецЦикла;

			Если НомерПервойСтрокиЗаписей <> Источник.ИндексПервойЯчейки + 1 Тогда 
				
				ОбластьДанных = ЛистДокумента.Область(НомерПервойСтрокиЗаписей, 1, НомерПоследнейСтрокиЗаписей, Источник.КоличествоПолей);
				
				НомерПоследнейСтрокиПриемника = (НомерПоследнейСтрокиЗаписей - НомерПервойСтрокиЗаписей) + 2;  
				
				ТабличныйДокументПриемник.ВставитьОбласть(ОбластьДанных, ТабличныйДокументПриемник.Область(2, 1, НомерПоследнейСтрокиПриемника, Источник.КоличествоПолей));
				
				ИсточникОбластьЯчеек = ТабличныйДокументПриемник.Область(1, 1, ТабличныйДокументПриемник.ВысотаТаблицы, Источник.КоличествоПолей);
				
				ПостроительЗапроса = Новый ПостроительЗапроса;
				ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(ИсточникОбластьЯчеек);
				ПостроительЗапроса.ДобавлениеПредставлений = ТипДобавленияПредставлений.НеДобавлять;
				ПостроительЗапроса.ЗаполнитьНастройки();
				ПостроительЗапроса.Выполнить();
				
				ТаблицаДанных = ПостроительЗапроса.Результат.Выгрузить();
				НомерСтроки = НомерПервойСтрокиЗаписей - 1;
				
				Если ЭтаФорма.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.МНО") Тогда
		
					ВалютаНаименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтаФорма.Валюта, "Наименование");

					Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
						
						НомерСтроки = НомерСтроки + 1;
						
						Если Не (Врег(СтрокаДанных.УК) = ЭтаФорма.КодУК И ЗначениеЗаполнено(СтрокаДанных.КодСчета)) Тогда
							Продолжить;
						КонецЕсли;
						
						Если Не (ЗначениеЗаполнено(СтрокаДанных.Сумма) И ТипЗнч(СтрокаДанных.Сумма) = Тип("Число")) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Сумма, руб.] некорректный формат значения. Данные распоряжения на МНО не загружены.");
							Продолжить;
						КонецЕсли;
						
						Если Не (ЗначениеЗаполнено(СтрокаДанных.Ставка) И ТипЗнч(СтрокаДанных.Ставка) = Тип("Число")) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Ставка] некорректный формат значения. Данные распоряжения на МНО не загружены.");
							Продолжить;
						КонецЕсли;
						
						Если Не (ЗначениеЗаполнено(СтрокаДанных.Срок) И ТипЗнч(СтрокаДанных.Срок) = Тип("Дата")) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Срок] некорректный формат значения. Данные распоряжения на МНО не загружены.");
							Продолжить;
						КонецЕсли;
						
						Если Не ЗначениеЗаполнено(СтрокаДанных.БИК) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [БИК] отсутствуют данные. Данные распоряжения на МНО не загружены.");
							Продолжить;
						КонецЕсли;
						
						НоваяСтрокаВнешниеДанные = ЭтаФорма.ВнешниеДанные.Добавить();
					    НоваяСтрокаВнешниеДанные.НомерСтрокиФайла                = НомерСтроки;
						НоваяСтрокаВнешниеДанные.ДатаРазмещения                  = СтрокаДанных.ДатаСоставления;
						НоваяСтрокаВнешниеДанные.НаименованиеКлиента             = СтрокаДанных.Наименование;
						НоваяСтрокаВнешниеДанные.КодУБрокера                     = Формат(СтрокаДанных.Код, "ЧГ=0");
						НоваяСтрокаВнешниеДанные.Сумма                           = СтрокаДанных.Сумма;
						НоваяСтрокаВнешниеДанные.Ставка                          = СтрокаДанных.Ставка;
						НоваяСтрокаВнешниеДанные.ДатаВозврата                    = СтрокаДанных.Срок;
						НоваяСтрокаВнешниеДанные.Срок                            = СтрокаДанных.КолВоДней;
						НоваяСтрокаВнешниеДанные.БикБанкаСписанияДенежныхСредств = СтрокаДанных.БИК;
						НоваяСтрокаВнешниеДанные.ВалютаСтр                       = ВалютаНаименование;
						НоваяСтрокаВнешниеДанные.КодСчетаДУ                      = СтрокаДанных.КодСчета;
						НоваяСтрокаВнешниеДанные.ПодКупон                        = (Врег(СтрокаДанных.Купон) = "К");
												
					КонецЦикла;
					
				ИначеЕсли ЭтаФорма.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента") Тогда
					
					Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
						
						НомерСтроки = НомерСтроки + 1;
						
						Если ВРег(СтрокаДанных.УК) <> ЭтаФорма.КодУК Или ЗначениеЗаполнено(СтрокаДанных.Загружено) Тогда
							Продолжить;
						КонецЕсли; 
																
						Если Не (ЗначениеЗаполнено(СтрокаДанных.Сумма) И ТипЗнч(СтрокаДанных.Сумма) = Тип("Число")) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Сумма, руб.] некорректный формат значения. Распоряжение не будет загружено.");
							Продолжить;
						КонецЕсли;
						
						Если Не (ЗначениеЗаполнено(СтрокаДанных.Ставка) И ТипЗнч(СтрокаДанных.Ставка) = Тип("Число")) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Ставка] некорректный формат значения. Распоряжение не будет загружено.");
							Продолжить;
						КонецЕсли;
						
						Если Не (ЗначениеЗаполнено(СтрокаДанных.СрокДней) И ТипЗнч(СтрокаДанных.СрокДней) = Тип("Число")) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Срок] некорректный формат значения. Распоряжение не будет загружено.");
							Продолжить;
						КонецЕсли;

						Если Не ЗначениеЗаполнено(СтрокаДанных.ВыплатаПроцентов) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Выплата процентов] отсутствуют данные. Распоряжение не будет загружено.");
							Продолжить;
						КонецЕсли;
						
						Если Не ЗначениеЗаполнено(СтрокаДанных.Досрочка) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Возможность досрочного расторжения] отсутствуют данные. Распоряжение не будет загружено.");
							Продолжить;
						КонецЕсли;
						
						Если Не (ЗначениеЗаполнено(СтрокаДанных.ДатаОтправкиДС) И ТипЗнч(СтрокаДанных.ДатаОтправкиДС) = Тип("Дата")) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Дата отправки ДС] некорректный формат значения. Распоряжение не будет загружено.");
				        	Продолжить;	
						КонецЕсли;

						Если Не (ЗначениеЗаполнено(СтрокаДанных.ДатаВозврата) И ТипЗнч(СтрокаДанных.ДатаВозврата) = Тип("Дата")) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Дата возврата] некорректный формат значения. Распоряжение не будет загружено.");
							Продолжить;
						КонецЕсли;
						
						Если СтрокаДанных.ДатаОтправкиДС < ЭтаФорма.Дата Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] некорректно указана Дата отправки ДС [" + Формат(СтрокаДанных.ДатаОтправкиДС, "ДФ=dd.MM.yyyy") + "]. Распоряжение не будет загружено.");
							Продолжить;		
						КонецЕсли;
						
						Если СтрокаДанных.ДатаОтправкиДС >= СтрокаДанных.ДатаВозврата Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] некорректно указаны Дата отправки ДС [" + Формат(СтрокаДанных.ДатаОтправкиДС, "ДФ=dd.MM.yyyy") + "] и Дата возврата [" + Формат(СтрокаДанных.ДатаВозврата, "ДФ=dd.MM.yyyy") + "]. Распоряжение не будет загружено.");
							Продолжить;		
						КонецЕсли;
						
						Если Цел((СтрокаДанных.ДатаВозврата - СтрокаДанных.ДатаОтправкиДС)/(60 * 60 * 24)) <> СтрокаДанных.СрокДней Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] некорректно указан срок. Распоряжение не будет загружено.");
							Продолжить;	
						КонецЕсли;
						
						Если Не ЗначениеЗаполнено(СтрокаДанных.КодСчета) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Код счета] отсутствуют данные. Распоряжение не будет загружено.");
							Продолжить;
						КонецЕсли;

						Если Не ЗначениеЗаполнено(СтрокаДанных.БанкВозвратаДС) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Банк возврата денег] отсутствуют данные. Распоряжение не будет загружено.");
							Продолжить;
						КонецЕсли;

						Если Не ЗначениеЗаполнено(СтрокаДанных.БанкОтправкиДС) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Банк отправки денег] отсутствуют данные. Распоряжение не будет загружено.");
							Продолжить;
						КонецЕсли;
						
						Если ЗначениеЗаполнено(СтрокаДанных.СтавкаПриДосрочномРасторжении) Тогда
							
							Если ВРег(СокрЛП(СтрокаДанных.Досрочка)) = "НЕТ" Тогда
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] ошибка условий. Указана ставка при досрочном расторжении [" + СтрокаДанных.СтавкаПриДосрочномРасторжении + "] без возможности досрочного погашения.");
								Продолжить;
							КонецЕсли;
							
						Иначе
							
							Если ВРег(СокрЛП(СтрокаДанных.Досрочка)) = "ДА" Тогда
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] ошибка условий досрочного погашения. Не указана ставка при досрочном расторжении.");
								Продолжить;	
							КонецЕсли;
							
						КонецЕсли;

						Если Не ЗначениеЗаполнено(СтрокаДанных.ВалютаДепозита) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Валюта депозита] отсутствуют данные. Распоряжение не будет загружено.");
							Продолжить;
						КонецЕсли;

						Если Не ЗначениеЗаполнено(СтрокаДанных.БанкРазмещенияБик) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Банк размещения (БИК)] некорректный формат значения. Распоряжение не будет загружено.");
							Продолжить;
						КонецЕсли;
						
						Если Не ЗначениеЗаполнено(СтрокаДанных.БанкВозвратаДенегБик) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Банк возврата денег (БИК)] отсутствуют данные. Распоряжение не будет загружено.");
							Продолжить;
						КонецЕсли;
						
						Если Не ЗначениеЗаполнено(СтрокаДанных.БанкОтправкиДенегБик) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Банк отправки денег (БИК)] отсутствуют данные. Распоряжение не будет загружено.");
							Продолжить;
						КонецЕсли;
										
						НоваяСтрокаВнешниеДанные = ЭтаФорма.ВнешниеДанные.Добавить();
						
						НоваяСтрокаВнешниеДанные.НомерСтрокиФайла                 = НомерСтроки;
						НоваяСтрокаВнешниеДанные.НаименованиеКлиента              = СтрокаДанных.Портфель;
						НоваяСтрокаВнешниеДанные.КодУБрокера                      = Формат(СтрокаДанных.КодБрокера, "ЧГ=0");
						НоваяСтрокаВнешниеДанные.Сумма                            = СтрокаДанных.Сумма;
						НоваяСтрокаВнешниеДанные.Ставка                           = СтрокаДанных.Ставка;
						НоваяСтрокаВнешниеДанные.Срок                             = СтрокаДанных.СрокДней;
						НоваяСтрокаВнешниеДанные.ПериодичностьВыплатыПроцентовСтр = ВРег(СокрЛП(СтрокаДанных.ВыплатаПроцентов));
						НоваяСтрокаВнешниеДанные.ДоВостребования                  = (ВРег(СокрЛП(СтрокаДанных.Досрочка)) = "ДА");
						НоваяСтрокаВнешниеДанные.ДатаРазмещения                   = СтрокаДанных.ДатаОтправкиДС;
						НоваяСтрокаВнешниеДанные.ДатаВозврата                     = СтрокаДанных.ДатаВозврата;
						НоваяСтрокаВнешниеДанные.НомерГенСоглашения               = СтрокаДанных.НомерГенСоглашения;
						НоваяСтрокаВнешниеДанные.КодСчетаДУ                       = СтрокаДанных.КодСчета;
						НоваяСтрокаВнешниеДанные.СтавкаДоВостребования            = СтрокаДанных.СтавкаПриДосрочномРасторжении;
						НоваяСтрокаВнешниеДанные.ВалютаСтр                        = СтрокаДанных.ВалютаДепозита;
						НоваяСтрокаВнешниеДанные.Субординированность              = (ВРег(СокрЛП(СтрокаДанных.Субординированность)) = "ДА");
						НоваяСтрокаВнешниеДанные.БикБанкаРазмещения               = СтрокаДанных.БанкРазмещенияБик;
						НоваяСтрокаВнешниеДанные.БикБанкаВозвратаДенежныхСредств  = СтрокаДанных.БанкВозвратаДенегБик;
						НоваяСтрокаВнешниеДанные.БикБанкаСписанияДенежныхСредств  = СтрокаДанных.БанкОтправкиДенегБик;
						
					КонецЦикла;
	
				КонецЕсли;

			КонецЕсли;
					
		 КонецЕсли;
		
	 КонецЦикла;
	 
	Если ЭтаФорма.ВнешниеДанные.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют данные для загрузки.");
		Возврат;
	КонецЕсли;
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА	
	Запрос.Текст =
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	ВнешниеДанные.НомерСтрокиФайла КАК НомерСтрокиФайла,
	    |	ВнешниеДанные.ДатаРазмещения КАК ДатаРазмещения,
	    |	ВнешниеДанные.НаименованиеКлиента КАК НаименованиеКлиента,
	    |	ВнешниеДанные.КодУБрокера КАК КодУБрокера,
	    |	ВнешниеДанные.Сумма КАК Сумма,
	    |	ВнешниеДанные.Ставка КАК Ставка,
	    |	ВнешниеДанные.ДатаВозврата КАК ДатаВозврата,
	    |	ВнешниеДанные.Срок КАК Срок,
	    |	ВнешниеДанные.ПериодичностьВыплатыПроцентовСтр КАК ПериодичностьВыплатыПроцентовСтр,
	    |	ВнешниеДанные.ДоВостребования КАК ДоВостребования,
	    |	ВнешниеДанные.НомерГенСоглашения КАК НомерГенСоглашения,
	    |	ВнешниеДанные.КодСчетаДУ КАК КодСчетаДУ,
	    |	ВнешниеДанные.СтавкаДоВостребования КАК СтавкаДоВостребования,
	    |	ВнешниеДанные.ВалютаСтр КАК ВалютаСтр,
	    |	ВнешниеДанные.Субординированность КАК Субординированность,
	    |	ВнешниеДанные.БикБанкаРазмещения КАК БикБанкаРазмещения,
	    |	ВнешниеДанные.БикБанкаВозвратаДенежныхСредств КАК БикБанкаВозвратаДенежныхСредств,
	    |	ВнешниеДанные.БикБанкаСписанияДенежныхСредств КАК БикБанкаСписанияДенежныхСредств,
	    |	ВнешниеДанные.ПодКупон КАК ПодКупон
	    |ПОМЕСТИТЬ _ВнешниеДанные
	    |ИЗ
	    |	&ВнешниеДанные КАК ВнешниеДанные
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_ВнешниеДанные.НомерСтрокиФайла КАК НомерСтрокиФайла,
	    |	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
	    |	СчетаДоверительногоУправления.КодСчета КАК Код
	    |ПОМЕСТИТЬ _КодыСчетовДоверительногоУправления
	    |ИЗ
	    |	_ВнешниеДанные КАК _ВнешниеДанные
	    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
	    |		ПО _ВнешниеДанные.КодСчетаДУ = СчетаДоверительногоУправления.КодСчета
	    |			И (СчетаДоверительногоУправления.Организация = &Организация)
	    |			И (НЕ СчетаДоверительногоУправления.ПометкаУдаления)
	    |ГДЕ
	    |	(СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
	    |			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения > &ТекущаяДата)
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	""Не удалось определить счет доверительного управления по коду счета ДУ [%1]. Строка файла [%2]"" КАК ТекстОшибки,
	    |	_ВнешниеДанные.КодСчетаДУ КАК Код,
	    |	_ВнешниеДанные.НомерСтрокиФайла КАК НомерСтрокиФайла
	    |ПОМЕСТИТЬ _ОшибкиСчетовДоверительногоУправления
	    |ИЗ
	    |	_ВнешниеДанные КАК _ВнешниеДанные
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _КодыСчетовДоверительногоУправления КАК _КодыСчетовДоверительногоУправления
	    |		ПО _ВнешниеДанные.НомерСтрокиФайла = _КодыСчетовДоверительногоУправления.НомерСтрокиФайла
	    |ГДЕ
	    |	_КодыСчетовДоверительногоУправления.СчетДоверительногоУправления ЕСТЬ NULL
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_КодыСчетовДоверительногоУправления.НомерСтрокиФайла КАК НомерСтрокиФайла,
	    |	_КодыСчетовДоверительногоУправления.СчетДоверительногоУправления КАК Ссылка
	    |ПОМЕСТИТЬ _СчетаДоверительногоУправления
	    |ИЗ
	    |	_КодыСчетовДоверительногоУправления КАК _КодыСчетовДоверительногоУправления
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиСчетовДоверительногоУправления КАК _ОшибкиСчетовДоверительногоУправления
	    |		ПО _КодыСчетовДоверительногоУправления.НомерСтрокиФайла = _ОшибкиСчетовДоверительногоУправления.НомерСтрокиФайла
	    |ГДЕ
	    |	_ОшибкиСчетовДоверительногоУправления.НомерСтрокиФайла ЕСТЬ NULL
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_СчетаДоверительногоУправления.НомерСтрокиФайла КАК НомерСтрокиФайла,
	    |	_СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
	    |	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет КАК РасчетныйСчет,
	    |	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Валюта КАК Валюта,
	    |	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Валюта.Наименование КАК СимвольныйКодВалюты,
	    |	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Банк.Код КАК БИК,
	    |	ДоговорыМНО.Ссылка КАК ДоговорМНО
	    |ПОМЕСТИТЬ _РасчетныеСчета
	    |ИЗ
	    |	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
	    |		ПО (ИсполнителиПоДенежнымСредствамСобственные.Организация = &Организация)
	    |			И _СчетаДоверительногоУправления.Ссылка = ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ТекущаяДата, Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
