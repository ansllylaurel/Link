	    |			И _ДанныеДляСозданияРаспоряжений.Ставка = _ТекущиеРаспоряжения.Процент
	    |			И _ДанныеДляСозданияРаспоряжений.ДатаРазмещения = _ТекущиеРаспоряжения.ДатаРазмещения
	    |			И _ДанныеДляСозданияРаспоряжений.ДатаВозврата = _ТекущиеРаспоряжения.ДатаВозврата
	    |			И _ДанныеДляСозданияРаспоряжений.БанкРазмещения = _ТекущиеРаспоряжения.Банк
	    |			И _ДанныеДляСозданияРаспоряжений.Сумма = _ТекущиеРаспоряжения.Сумма
	    |			И _ДанныеДляСозданияРаспоряжений.Валюта = _ТекущиеРаспоряжения.Валюта
	    |			И _ДанныеДляСозданияРаспоряжений.ПериодичностьВыплатыПроцентов = _ТекущиеРаспоряжения.ПериодичностьВыплатыПроцентов
	    |			И _ДанныеДляСозданияРаспоряжений.РасчетныйСчетВозвратаДенежныхСредств = _ТекущиеРаспоряжения.РасчетныйСчетВозвратаДенежныхСредств
	    |			И _ДанныеДляСозданияРаспоряжений.ДоВостребования = _ТекущиеРаспоряжения.ДоВостребования
	    |			И _ДанныеДляСозданияРаспоряжений.СтавкаДоВостребования = _ТекущиеРаспоряжения.ПроцентнаяСтавкаПриДосрочномЗакрытии
	    |			И _ДанныеДляСозданияРаспоряжений.Субординированность = _ТекущиеРаспоряжения.Субординированность";
#КонецОбласти

	Запрос.УстановитьПараметр("ТекущаяДата", ЭтаФорма.Дата);
	Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ВнешниеДанные", ЭтаФорма.ВнешниеДанные.Выгрузить());
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("КодУК", ЭтаФорма.КодУК);
	Запрос.УстановитьПараметр("ВидОперации", ЭтаФорма.ВидОперации);
	Запрос.УстановитьПараметр("ВидОперацииРазмещениеКредитногоИнструмента", (ЭтаФорма.ВидОперации = Перечисления.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента));
	Запрос.УстановитьПараметр("ВидОперацииМНО", (ЭтаФорма.ВидОперации = Перечисления.ВидыОперацийБэкОфиса.МНО));
	
	ЭтаФорма.ВнешниеДанные.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Выборка = МВТ.Таблицы["_ОшибкиСчетовДоверительногоУправления"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Выборка.ТекстОшибки, Выборка.Код, Выборка.НомерСтрокиФайла));	
	КонецЦикла;
	
	Выборка = МВТ.Таблицы["_ОшибкиГенСоглашений"].ПолучитьДанные().Выбрать();

	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Выборка.ТекстОшибки, Выборка.НомерГенСоглашения, Выборка.СчетДоверительногоУправления, Выборка.НомерСтрокиФайла));	
	КонецЦикла;
	
	Выборка = МВТ.Таблицы["_ОшибкиОпределенияВалюты"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Выборка.ТекстОшибки, Выборка.ВалютаСтр, Выборка.НомерСтрокиФайла));	
	КонецЦикла;

	Выборка = МВТ.Таблицы["_ОшибкиПериодичностиВыплатыПроцентов"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Выборка.ТекстОшибки, Выборка.ПериодичностьВыплатыПроцентовСтр, Выборка.НомерСтрокиФайла));	
	КонецЦикла;
	
	Выборка = МВТ.Таблицы["_ОшибкиБанковскихСчетов"].ПолучитьДанные().Выбрать();
			
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Выборка.ТекстОшибки, Выборка.БИК, Выборка.ВалютаСтр, Выборка.НаименованиеКлиента, Выборка.Код, Выборка.НомерСтрокиФайла));	
	КонецЦикла;
			
КонецПроцедуры
 
&НаСервереБезКонтекста
Функция СоздатьРаспоряженияНаСервере(МассивРаспоряжений)
		
	Обработки.Распоряжения.СоздатьРаспоряжения(МассивРаспоряжений); 
	
	СообщенияПользователю = ПолучитьСообщенияПользователю(Истина); 
	
	Возврат СообщенияПользователю;
		
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЭтаФорма.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.МНО") Тогда
		ЭтаФорма.Заголовок = "Загрузка распоряжений на МНО из Excel";
	ИначеЕсли ЭтаФорма.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента") Тогда 
		ЭтаФорма.Заголовок = "Загрузка распоряжений на открытие депозитов из Excel";	
	КонецЕсли;
	
	НастроитьВидимостьИДоступность();
	ПрочитатьФайл(Неопределено);
		
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВидимостьИДоступность(Элемент = Неопределено)
	
	Если Элемент = Неопределено Тогда 
	
		ЭтоДепозиты = (ЭтаФорма.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента")); 
		
		ЭтаФорма.Элементы.ФайлМНО.Видимость = (ЭтаФорма.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.МНО"));
		ЭтаФорма.Элементы.ФайлДепозиты.Видимость = ЭтоДепозиты;
		
		ЭтаФорма.Элементы.ВнешниеДанныеБанкРазмещения.Видимость = ЭтоДепозиты;
		ЭтаФорма.Элементы.ВнешниеДанныеРасчетныйСчетВозвратаДенежныхСредств.Видимость = ЭтоДепозиты;
		ЭтаФорма.Элементы.ВнешниеДанныеНомерГенСоглашения.Видимость = ЭтоДепозиты; 
		ЭтаФорма.Элементы.ВнешниеДанныеСубординированность.Видимость = ЭтоДепозиты;
		ЭтаФорма.Элементы.ВнешниеДанныеДоВостребования.Видимость = ЭтоДепозиты;
		ЭтаФорма.Элементы.ВнешниеДанныеПериодичностьВыплатыПроцентов.Видимость = ЭтоДепозиты; 
		ЭтаФорма.Элементы.ВнешниеДанныеСтавкаДоВостребования.Видимость = ЭтоДепозиты;
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ВнешниеДанныеПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если Элемент.ТекущийЭлемент.Имя = "ВнешниеДанныеСоздатьРаспоряжение" Тогда
	
		Если ТекущиеДанные.ФлагРаспоряжениеСоздано И Не ТекущиеДанные.СоздатьРаспоряжение
			И Вопрос("По счету " + ТекущиеДанные.СчетДоверительногоУправления  + " уже создано распоряжение на сумму " + ТекущиеДанные.Сумма + " " + ТекущиеДанные.Валюта + ".
					|Вы действительно хотите создать новове распоряжение?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
			
			ТекущиеДанные.СоздатьРаспоряжение = Ложь;
			
		Иначе
			
			ТекущиеДанные.СоздатьРаспоряжение = Не ТекущиеДанные.СоздатьРаспоряжение;

		КонецЕсли;
	
	КонецЕсли;
	
	Отказ = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВсеФлажкиТекущейТаблицы(Флаг)
	
	Для Каждого СтрокаВнешниеДанные Из ЭтаФорма.ВнешниеДанные Цикл
		СтрокаВнешниеДанные.СоздатьРаспоряжение = ?(СтрокаВнешниеДанные.ФлагРаспоряжениеСоздано, Ложь, Флаг);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьВсеФлажки(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаУстановитьВсеФлажки");
	Попытка
		ИзменитьВсеФлажкиТекущейТаблицы(Истина);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьВсеФлажки(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаСнятьВсеФлажки");
	Попытка
		ИзменитьВсеФлажкиТекущейТаблицы(Ложь);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти

