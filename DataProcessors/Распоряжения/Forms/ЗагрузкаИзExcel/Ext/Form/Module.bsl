	    |	_ДанныеДляСозданияРаспоряжений.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	    |	_ДанныеДляСозданияРаспоряжений.НомерГенСоглашения КАК НомерГенСоглашения,
	    |	_ДанныеДляСозданияРаспоряжений.РасчетныйСчетСписанияДенежныхСредств КАК РасчетныйСчетСписанияДенежныхСредств,
	    |	_ДанныеДляСозданияРаспоряжений.РасчетныйСчетВозвратаДенежныхСредств КАК РасчетныйСчетВозвратаДенежныхСредств,
	    |	_ДанныеДляСозданияРаспоряжений.БанкРазмещения КАК БанкРазмещения,
	    |	_ДанныеДляСозданияРаспоряжений.ДоВостребования КАК ДоВостребования,
	    |	_ДанныеДляСозданияРаспоряжений.СтавкаДоВостребования КАК СтавкаДоВостребования,
	    |	_ДанныеДляСозданияРаспоряжений.Субординированность КАК Субординированность,
	    |	_ДанныеДляСозданияРаспоряжений.ПодКупон КАК ПодКупон,
	    |	НЕ _ТекущиеРаспоряжения.Ссылка ЕСТЬ NULL КАК ФлагРаспоряжениеСоздано
	    |ИЗ
	    |	_ДанныеДляСозданияРаспоряжений КАК _ДанныеДляСозданияРаспоряжений
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _ТекущиеРаспоряжения КАК _ТекущиеРаспоряжения
	    |		ПО _ДанныеДляСозданияРаспоряжений.СчетДоверительногоУправления = _ТекущиеРаспоряжения.СчетДоверительногоУправления
	    |			И _ДанныеДляСозданияРаспоряжений.РасчетныйСчетСписанияДенежныхСредств = _ТекущиеРаспоряжения.РасчетныйСчет
	    |			И _ДанныеДляСозданияРаспоряжений.Ставка = _ТекущиеРаспоряжения.Процент
	    |			И (&ВидОперацииМНО
	    |				ИЛИ _ДанныеДляСозданияРаспоряжений.ДатаРазмещения = _ТекущиеРаспоряжения.ДатаРазмещения)
	    |			И _ДанныеДляСозданияРаспоряжений.ДатаВозврата = _ТекущиеРаспоряжения.ДатаВозврата
	    |			И _ДанныеДляСозданияРаспоряжений.БанкРазмещения = _ТекущиеРаспоряжения.Банк
	    |			И _ДанныеДляСозданияРаспоряжений.Сумма = _ТекущиеРаспоряжения.Сумма
	    |			И _ДанныеДляСозданияРаспоряжений.Валюта = _ТекущиеРаспоряжения.Валюта
	    |			И _ДанныеДляСозданияРаспоряжений.ПериодичностьВыплатыПроцентов = _ТекущиеРаспоряжения.ПериодичностьВыплатыПроцентов
	    |			И _ДанныеДляСозданияРаспоряжений.РасчетныйСчетВозвратаДенежныхСредств = _ТекущиеРаспоряжения.РасчетныйСчетВозвратаДенежныхСредств
	    |			И _ДанныеДляСозданияРаспоряжений.ДоВостребования = _ТекущиеРаспоряжения.ДоВостребования
	    |			И _ДанныеДляСозданияРаспоряжений.СтавкаДоВостребования = _ТекущиеРаспоряжения.ПроцентнаяСтавкаПриДосрочномЗакрытии
	    |			И _ДанныеДляСозданияРаспоряжений.Субординированность = _ТекущиеРаспоряжения.Субординированность";
#КонецОбласти

	Запрос.УстановитьПараметр("ТекущаяДата", ЭтаФорма.Дата);
	Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ВнешниеДанные", ЭтаФорма.ВнешниеДанные.Выгрузить());
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("КодУК", ЭтаФорма.КодУК);
	Запрос.УстановитьПараметр("ВидОперации", ЭтаФорма.ВидОперации);
	Запрос.УстановитьПараметр("ВидОперацииРазмещениеКредитногоИнструмента", (ЭтаФорма.ВидОперации = Перечисления.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента));
	Запрос.УстановитьПараметр("ВидОперацииМНО", (ЭтаФорма.ВидОперации = Перечисления.ВидыОперацийБэкОфиса.МНО));
	
	ЭтаФорма.ВнешниеДанные.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Выборка = МВТ.Таблицы["_ОшибкиСчетовДоверительногоУправления"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Выборка.ТекстОшибки, Выборка.Код, Выборка.НомерСтрокиФайла));	
	КонецЦикла;
	
	Выборка = МВТ.Таблицы["_ОшибкиГенСоглашений"].ПолучитьДанные().Выбрать();

	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Выборка.ТекстОшибки, Выборка.НомерГенСоглашения, Выборка.СчетДоверительногоУправления, Выборка.НомерСтрокиФайла));	
	КонецЦикла;
	
	Выборка = МВТ.Таблицы["_ОшибкиОпределенияВалюты"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Выборка.ТекстОшибки, Выборка.ВалютаСтр, Выборка.НомерСтрокиФайла));	
	КонецЦикла;

	Выборка = МВТ.Таблицы["_ОшибкиПериодичностиВыплатыПроцентов"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Выборка.ТекстОшибки, Выборка.ПериодичностьВыплатыПроцентовСтр, Выборка.НомерСтрокиФайла));	
	КонецЦикла;
	
	Выборка = МВТ.Таблицы["_ОшибкиБанковскихСчетов"].ПолучитьДанные().Выбрать();
			
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Выборка.ТекстОшибки, Выборка.БИК, Выборка.ВалютаСтр, Выборка.НаименованиеКлиента, Выборка.Код, Выборка.НомерСтрокиФайла));	
	КонецЦикла;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ШапкаТаблицыСоответствуетФормату(ОбластьШапки, ВидОперации)
	
	ПоляСоответствуютФормату = Истина;
	
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.МНО") Тогда
		
		ИменаПолей = "ДАТА СОСТАВЛЕНИЯ;УК;НАИМЕНОВАНИЕ;КОД;СУММА, РУБ.;СТАВКА;СРОК;КОЛ ВО ДНЕЙ;БАНК;БИК;ДОХОД;УПРАВЛЯЮЩИЙ;КУПОН;РАБОЧИЙ ВЫХОДНОЙ;
		             |МНО ДЕЙСТВУЕТ;ДНЕЙ ДО ПОГАШЕНИЯ;ДОГОВОР;ТИП КЛИЕНТА;ТРЭШ АКТИВЫ;ВНУТР КЛИЕНТЫ;ДОЛЯ СЧА;ГРУППА ПОРТФЕЛЕЙ;КОД СЧЕТА";
		
	ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента") Тогда
		
		ИменаПолей = "ДАТА СОСТАВЛЕНИЯ;УК;ПОРТФЕЛЬ;КОД БРОКЕРА;СУММА, РУБ.;СТАВКА;СРОК ДНЕЙ;ВЫПЛАТА ПРОЦЕНТОВ;ДОСРОЧКА;БАНК РАЗМЕЩЕНИЯ;БАНК РАЗМЕЩЕНИЯ (ФИЛИАЛ);
		             |ДАТА ОТПРАВКИ ДС;%;ДАТА ВОЗВРАТА;№ ГЕН.СОГЛАШЕНИЯ;КОД СЧЕТА;БАНК ВОЗВРАТА ДС;БАНК ОТПРАВКИ ДС;СТАВКА ПРИ ДОСРОЧНОМ РАСТОРЖЕНИИ;
					 |ВАЛЮТА ДЕПОЗИТА;СУБОРДИНИРОВАННОСТЬ;БАНК РАЗМЕЩЕНИЯ (БИК);БАНК ВОЗВРАТА ДЕНЕГ (БИК);БАНК ОТПРАВКИ ДЕНЕГ (БИК);ЗАГРУЖЕНО";	
		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Загрузка опираций [" + ВидОперации + "] не поддерживается.");
		ПоляСоответствуютФормату = Ложь;
	КонецЕсли;
	
	ПоляШапки = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИменаПолей, ";", Истина, Истина);
			
	Для НомерПоля = 0 По ПоляШапки.Количество() - 1 Цикл
		
		ЗначениеЯчейки = СокрЛП(Врег(ОбластьШапки.Область(1, НомерПоля + 1).Текст));
		
		Если ПоляШапки[НомерПоля] <> ЗначениеЯчейки Тогда	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдено поле шапки [" + ПоляШапки[НомерПоля] + "]");
			ПоляСоответствуютФормату = Ложь;
		КонецЕсли;
		
		Если НомерПоля = 4 И ПоляШапки[НомерПоля] = "СУММА, РУБ." Тогда
			ОбластьШапки.Область(1, НомерПоля + 1).Текст = "Сумма";
		ИначеЕсли НомерПоля = 14 И ПоляШапки[НомерПоля] = "№ ГЕН.СОГЛАШЕНИЯ" Тогда
			ОбластьШапки.Область(1, НомерПоля + 1).Текст = "НомерГенСоглашения";
		ИначеЕсли НомерПоля = 21 И ПоляШапки[НомерПоля] = "БАНК РАЗМЕЩЕНИЯ (БИК)" Тогда
			ОбластьШапки.Область(1, НомерПоля + 1).Текст = "БанкРазмещенияБик";
		ИначеЕсли НомерПоля = 22 И ПоляШапки[НомерПоля] = "БАНК ВОЗВРАТА ДЕНЕГ (БИК)" Тогда
			ОбластьШапки.Область(1, НомерПоля + 1).Текст = "БанкВозвратаДенегБик";
		ИначеЕсли НомерПоля = 23 И ПоляШапки[НомерПоля] = "БАНК ОТПРАВКИ ДЕНЕГ (БИК)" Тогда
			ОбластьШапки.Область(1, НомерПоля + 1).Текст = "БанкОтправкиДенегБик";
		КонецЕсли;
			
	КонецЦикла; 
		
	Возврат ПоляСоответствуютФормату;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНомерПоследнейСтрокиЗаписей(Лист, НомерПервойСтроки, НомерПоследнойСтроки)
	
	Если НомерПоследнойСтроки <= НомерПервойСтроки + 1 Тогда  
		Возврат ?(ЗначениеЗаполнено(Лист.Область(НомерПоследнойСтроки, 1).Текст), НомерПоследнойСтроки, НомерПервойСтроки);	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Лист.Область(НомерПоследнойСтроки, 1).Текст) Тогда
		НомерСтроки = ПолучитьНомерПоследнейСтрокиЗаписей(Лист, НомерПоследнойСтроки, Окр(НомерПоследнойСтроки + ((НомерПоследнойСтроки - НомерПервойСтроки) / 2), 0, 1));
	Иначе
		НомерСтроки = ПолучитьНомерПоследнейСтрокиЗаписей(Лист, НомерПервойСтроки, Окр(НомерПервойСтроки + ((НомерПоследнойСтроки - НомерПервойСтроки) / 2), 0, 1));	
	КонецЕсли;
	
	Возврат НомерСтроки;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДаннымиБазыНаСервере()
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА	
	Запрос.Текст =
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	ВнешниеДанные.НомерСтрокиФайла КАК НомерСтрокиФайла,
	    |	ВнешниеДанные.ДатаРазмещения КАК ДатаРазмещения,
	    |	ВнешниеДанные.НаименованиеКлиента КАК НаименованиеКлиента,
	    |	ВнешниеДанные.КодУБрокера КАК КодУБрокера,
	    |	ВнешниеДанные.Сумма КАК Сумма,
	    |	ВнешниеДанные.Ставка КАК Ставка,
	    |	ВнешниеДанные.ДатаВозврата КАК ДатаВозврата,
	    |	ВнешниеДанные.Срок КАК Срок,
	    |	ВнешниеДанные.ПериодичностьВыплатыПроцентовСтр КАК ПериодичностьВыплатыПроцентовСтр,
	    |	ВнешниеДанные.ДоВостребования КАК ДоВостребования,
	    |	ВнешниеДанные.НомерГенСоглашения КАК НомерГенСоглашения,
	    |	ВнешниеДанные.КодСчетаДУ КАК КодСчетаДУ,
	    |	ВнешниеДанные.СтавкаДоВостребования КАК СтавкаДоВостребования,
	    |	ВнешниеДанные.ВалютаСтр КАК ВалютаСтр,
	    |	ВнешниеДанные.Субординированность КАК Субординированность,
	    |	ВнешниеДанные.БикБанкаРазмещения КАК БикБанкаРазмещения,
	    |	ВнешниеДанные.БикБанкаВозвратаДенежныхСредств КАК БикБанкаВозвратаДенежныхСредств,
	    |	ВнешниеДанные.БикБанкаСписанияДенежныхСредств КАК БикБанкаСписанияДенежныхСредств
	    |ПОМЕСТИТЬ _ВнешниеДанные
	    |ИЗ
	    |	&ВнешниеДанные КАК ВнешниеДанные
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_ВнешниеДанные.НомерСтрокиФайла КАК НомерСтрокиФайла,
	    |	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
	    |	СчетаДоверительногоУправления.КодСчета КАК Код
	    |ПОМЕСТИТЬ _КодыСчетовДоверительногоУправления
	    |ИЗ
	    |	_ВнешниеДанные КАК _ВнешниеДанные
	    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
	    |		ПО _ВнешниеДанные.КодСчетаДУ = СчетаДоверительногоУправления.КодСчета
	    |			И (СчетаДоверительногоУправления.Организация = &Организация)
	    |			И (НЕ СчетаДоверительногоУправления.ПометкаУдаления)
	    |ГДЕ
	    |	(СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
	    |			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения > &ТекущаяДата)
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	""Не удалось определить счет доверительного управления по коду счета ДУ [%1]. Строка файла [%2]"" КАК ТекстОшибки,
	    |	_ВнешниеДанные.КодСчетаДУ КАК Код,
	    |	_ВнешниеДанные.НомерСтрокиФайла КАК НомерСтрокиФайла
	    |ПОМЕСТИТЬ _ОшибкиСчетовДоверительногоУправления
	    |ИЗ
	    |	_ВнешниеДанные КАК _ВнешниеДанные
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _КодыСчетовДоверительногоУправления КАК _КодыСчетовДоверительногоУправления
	    |		ПО _ВнешниеДанные.НомерСтрокиФайла = _КодыСчетовДоверительногоУправления.НомерСтрокиФайла
	    |ГДЕ
	    |	_КодыСчетовДоверительногоУправления.СчетДоверительногоУправления ЕСТЬ NULL
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_КодыСчетовДоверительногоУправления.НомерСтрокиФайла КАК НомерСтрокиФайла,
	    |	_КодыСчетовДоверительногоУправления.СчетДоверительногоУправления КАК Ссылка
	    |ПОМЕСТИТЬ _СчетаДоверительногоУправления
	    |ИЗ
	    |	_КодыСчетовДоверительногоУправления КАК _КодыСчетовДоверительногоУправления
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиСчетовДоверительногоУправления КАК _ОшибкиСчетовДоверительногоУправления
	    |		ПО _КодыСчетовДоверительногоУправления.НомерСтрокиФайла = _ОшибкиСчетовДоверительногоУправления.НомерСтрокиФайла
	    |ГДЕ
	    |	_ОшибкиСчетовДоверительногоУправления.НомерСтрокиФайла ЕСТЬ NULL
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_СчетаДоверительногоУправления.НомерСтрокиФайла КАК НомерСтрокиФайла,
	    |	_СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
	    |	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет КАК РасчетныйСчет,
	    |	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Валюта КАК Валюта,
	    |	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Валюта.Наименование КАК СимвольныйКодВалюты,
	    |	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Банк.Код КАК БИК
