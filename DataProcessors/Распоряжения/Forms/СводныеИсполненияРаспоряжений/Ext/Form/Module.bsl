&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// начальное заполнение формы
	Организация	= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Дата		= ТекущаяДата();
	ЗаполнитьПлановыеСозданныеИсполненияНаСервере();
	ЗаполнитьПросроченныеРаспоряженияМНОНаСервере();  
	
	Если РаботаСДокументами.ИспользуетсяВыгрузкаПлатежныхПорученийВКлиентБанк(Организация, Дата) Тогда
		Элементы.РаспоряженияНаДепозитыКомандаСоздатьРазмещенияДепозитов.Заголовок	= "Создать депозиты";
		Элементы.ГруппаСозданныеРазмещения.Заголовок								= "Депозиты";
		Элементы.СозданныеРазмещенияДепозитовРазмещенияДепозиты.Заголовок			= "Депозит/Распоряжение";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПлановыеСозданныеИсполненияНаСервере()

	ЗаполнитьПлановыеИсполненияНаСервере();
	ЗаполнитьСозданныеИсполненияНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПлановыеИсполненияНаСервере()

	ЭтаФорма.РаспоряженияНаМНО.Очистить();
	ЭтаФорма.РаспоряженияНаДепозиты.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Документ.Основание КАК Распоряжение
		|ПОМЕСТИТЬ _ИсключаемыеРаспоряженияМНО
		|ИЗ
		|	Документ.МНО КАК Документ
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(Документ.Дата, ДЕНЬ) = &Дата
		|	И НЕ Документ.ПометкаУдаления
		|	И Документ.Организация = &Организация
		|	И (&БезОтбораПоБанку
		|			ИЛИ Документ.РасчетныйСчет.Банк = &Банк)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РазмещениеКредитногоИнструмента.Основание КАК Распоряжение
		|ПОМЕСТИТЬ _ИсключаемыеРаспоряженияНаДепозиты
		|ИЗ
		|	Документ.РазмещениеКредитногоИнструмента КАК РазмещениеКредитногоИнструмента
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(РазмещениеКредитногоИнструмента.Дата, ДЕНЬ) >= &Дата
		|	И НЕ РазмещениеКредитногоИнструмента.ПометкаУдаления
		|	И РазмещениеКредитногоИнструмента.Организация = &Организация
		|	И (&БезОтбораПоБанку
		|			ИЛИ РазмещениеКредитногоИнструмента.РасчетныйСчет.Банк = &Банк)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Документ.Ссылка КАК Документ,
		|	Документ.ВидОперации КАК ВидОперации,
		|	Документ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Документ.РасчетныйСчет КАК РасчетныйСчет,
		|	Документ.Процент КАК Процент,
		|	Документ.ДатаВозврата КАК ДатаВозврата,
		|	Документ.ДатаРазмещения КАК ДатаРазмещения,
		|	Документ.Сумма КАК Сумма,
		|	Документ.Валюта КАК Валюта,
		|	ВЫБОР
		|		КОГДА Документ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО)
		|			ТОГДА Документ.РасчетныйСчет.Банк
		|		КОГДА Документ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
		|			ТОГДА Документ.Банк
		|	КОНЕЦ КАК Банк,
		|	ВЫБОР
		|		КОГДА Документ.ПометкаУдаления
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК СостояниеДокумента,
		|	НомераПодтверждений.Номер КАК НомерПодтверждения,
		|	Документ.Биржевой КАК Биржевой
		|ПОМЕСТИТЬ _Распоряжения
		|ИЗ
		|	Документ.Распоряжение КАК Документ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ИсключаемыеРаспоряженияМНО КАК _ИсключаемыеРаспоряженияМНО
		|		ПО Документ.Ссылка = _ИсключаемыеРаспоряженияМНО.Распоряжение
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ИсключаемыеРаспоряженияНаДепозиты КАК _ИсключаемыеРаспоряженияНаДепозиты
		|		ПО Документ.Ссылка = _ИсключаемыеРаспоряженияНаДепозиты.Распоряжение
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераОбъектов КАК НомераПодтверждений
		|		ПО Документ.Ссылка = НомераПодтверждений.Объект
		|			И (НомераПодтверждений.Организация = &Организация)
		|			И (НомераПодтверждений.ВидНумерации В (ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.ПодтвержденияСбербанка), ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.ПодтвержденияВТБ), ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.РаспоряженияНаМНО)))
		|ГДЕ
		|	(Документ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО)
		|				И НАЧАЛОПЕРИОДА(Документ.Дата, ДЕНЬ) = &Дата
		|			ИЛИ Документ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
		|				И НАЧАЛОПЕРИОДА(Документ.ДатаРазмещения, ДЕНЬ) >= &Дата)
		|	И НЕ Документ.ПометкаУдаления
		|	И Документ.Организация = &Организация
		|	И _ИсключаемыеРаспоряженияМНО.Распоряжение ЕСТЬ NULL
		|	И _ИсключаемыеРаспоряженияНаДепозиты.Распоряжение ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиАкцептованияОперацийСрезПоследних.Организация КАК Организация,
		|	НастройкиАкцептованияОперацийСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НастройкиАкцептованияОперацийСрезПоследних.ВидАкцепта КАК ВидАкцепта,
		|	_Распоряжения.Документ КАК Документ,
		|	_Распоряжения.РасчетныйСчет КАК РасчетныйСчет
		|ПОМЕСТИТЬ _НастройкиАкцептования
		|ИЗ
		|	РегистрСведений.НастройкиАкцептованияОпераций.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_Распоряжения.СчетДоверительногоУправления
		|					ИЗ
		|						_Распоряжения КАК _Распоряжения
		|					ГДЕ
		|						_Распоряжения.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО))
		|				И ВидАкцепта = ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.МНО)) КАК НастройкиАкцептованияОперацийСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Распоряжения КАК _Распоряжения
		|		ПО (_Распоряжения.СчетДоверительногоУправления = НастройкиАкцептованияОперацийСрезПоследних.СчетДоверительногоУправления)
		|			И (_Распоряжения.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО))
		|ГДЕ
		|	НастройкиАкцептованияОперацийСрезПоследних.ТребуетсяАкцептование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НастройкиАкцептования.Документ КАК Документ,
		|	АкцептованиеОперацийСрезПоследних.Операция ЕСТЬ NULL
		|		ИЛИ АкцептованиеОперацийСрезПоследних.Срок <> ДАТАВРЕМЯ(1, 1, 1)
		|			И АкцептованиеОперацийСрезПоследних.Срок <= &Дата КАК ТребуетсяАкцепт
		|ПОМЕСТИТЬ _УсловияАкцептования
		|ИЗ
		|	_НастройкиАкцептования КАК _НастройкиАкцептования
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АкцептованиеОпераций.СрезПоследних(
		|				,
		|				Организация = &Организация
		|					И ВидАкцепта = ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.МНО)
		|					И Операция В
		|						(ВЫБРАТЬ
		|							_НастройкиАкцептования.Документ
		|						ИЗ
		|							_НастройкиАкцептования КАК _НастройкиАкцептования
		|				
		|						ОБЪЕДИНИТЬ
		|				
		|						ВЫБРАТЬ
		|							_НастройкиАкцептования.РасчетныйСчет
		|						ИЗ
		|							_НастройкиАкцептования КАК _НастройкиАкцептования)) КАК АкцептованиеОперацийСрезПоследних
		|		ПО _НастройкиАкцептования.Организация = АкцептованиеОперацийСрезПоследних.Организация
		|			И _НастройкиАкцептования.ВидАкцепта = АкцептованиеОперацийСрезПоследних.ВидАкцепта
		|			И (_НастройкиАкцептования.Документ = АкцептованиеОперацийСрезПоследних.Операция
		|				ИЛИ _НастройкиАкцептования.РасчетныйСчет = АкцептованиеОперацийСрезПоследних.Операция)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НЕ ЕСТЬNULL(_УсловияАкцептования.ТребуетсяАкцепт, ЛОЖЬ) КАК Флажок,
		|	_Распоряжения.Документ КАК Документ,
		|	_Распоряжения.НомерПодтверждения КАК НомерПодтверждения,
		|	_Распоряжения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Распоряжения.РасчетныйСчет КАК РасчетныйСчет,
		|	_Распоряжения.Процент КАК Процент,
		|	_Распоряжения.ДатаВозврата КАК ДатаВозврата,
		|	_Распоряжения.Сумма КАК Сумма,
		|	_Распоряжения.Валюта КАК Валюта,
		|	_Распоряжения.СостояниеДокумента КАК СостояниеДокумента,
		|	ЕСТЬNULL(_УсловияАкцептования.ТребуетсяАкцепт, ЛОЖЬ) КАК ТребуетсяАкцепт
		|ПОМЕСТИТЬ _РаспоряженияНаМНО
		|ИЗ
		|	_Распоряжения КАК _Распоряжения
		|		ЛЕВОЕ СОЕДИНЕНИЕ _УсловияАкцептования КАК _УсловияАкцептования
		|		ПО _Распоряжения.Документ = _УсловияАкцептования.Документ
		|ГДЕ
		|	_Распоряжения.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО)
		|	И (&БезОтбораПоБанку
		|			ИЛИ _Распоряжения.Банк = &Банк)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА _Распоряжения.Банк В (&МассивБанков)
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК КартинкаПечать,
		|	_Распоряжения.ДатаРазмещения = НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ) КАК Флажок,
		|	_Распоряжения.Документ КАК Документ,
		|	_Распоряжения.НомерПодтверждения КАК НомерПодтверждения,
		|	_Распоряжения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Распоряжения.РасчетныйСчет КАК РасчетныйСчет,
		|	_Распоряжения.Процент КАК Процент,
		|	_Распоряжения.ДатаВозврата КАК ДатаВозврата,
		|	_Распоряжения.ДатаРазмещения КАК ДатаРазмещения,
		|	_Распоряжения.Сумма КАК Сумма,
		|	_Распоряжения.Валюта КАК Валюта,
		|	_Распоряжения.Банк КАК Банк,
		|	_Распоряжения.СостояниеДокумента КАК СостояниеДокумента,
		|	_Распоряжения.Биржевой КАК Биржевой,
		|	НАЧАЛОПЕРИОДА(_Распоряжения.ДатаРазмещения, ДЕНЬ) КАК ДатаПодтверждения
		|ПОМЕСТИТЬ _РаспоряженияНаДепозиты
		|ИЗ
		|	_Распоряжения КАК _Распоряжения
		|ГДЕ
		|	_Распоряжения.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
		|	И (&БезОтбораПоБанку
		|			ИЛИ _Распоряжения.Банк = &Банк)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДенежныеСредстваВКредитныхИнструментахОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий КАК ДатаНачалаДействияУсловий,
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
		|	УсловияКредитныхИнструментовСрезПоследних.Действует КАК Действует,
		|	УсловияКредитныхИнструментовСрезПоследних.Реинвестировать КАК Реинвестировать,
		|	УсловияКредитныхИнструментовСрезПоследних.Период КАК Период,
		|	УсловияКредитныхИнструментовСрезПоследних.РасчетныйСчетВозвратаДенежныхСредств КАК РасчетныйСчетВозвратаДенежныхСредств
		|ПОМЕСТИТЬ _УсловияДепозитныхВкладов
		|ИЗ
		|	РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&Дата, Организация = &Организация) КАК УсловияКредитныхИнструментовСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.Остатки(
		|				,
		|				Организация = &Организация
		|					И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)) КАК ДенежныеСредстваВКредитныхИнструментахОстатки
		|		ПО (ДенежныеСредстваВКредитныхИнструментахОстатки.Организация = УсловияКредитныхИнструментовСрезПоследних.Организация)
		|			И (ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент)
		|			И (ДенежныеСредстваВКредитныхИнструментахОстатки.СуммаОстаток <> 0)
		|ГДЕ
		|	УсловияКредитныхИнструментовСрезПоследних.Действует
		|	И НЕ ВЫРАЗИТЬ(УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).ПометкаУдаления
		|	И (&БезОтбораПоБанку
		|			ИЛИ ВЫРАЗИТЬ(УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Банк = &Банк)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_УсловияДепозитныхВкладов.ДатаПогашения = НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ) КАК Флажок,
		|	_УсловияДепозитныхВкладов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_УсловияДепозитныхВкладов.КредитныйИнструмент КАК КредитныйИнструмент,
		|	_УсловияДепозитныхВкладов.ДатаПогашения КАК ДатаПогашения,
		|	_УсловияДепозитныхВкладов.КредитныйИнструмент._НачальныйНоминал КАК Сумма
		|ПОМЕСТИТЬ _ДепозитныеВкладыДляЗакрытия
		|ИЗ
		|	_УсловияДепозитныхВкладов КАК _УсловияДепозитныхВкладов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_УсловияДепозитныхВкладов.КредитныйИнструмент КАК КредитныйИнструмент,
		|			МАКСИМУМ(_УсловияДепозитныхВкладов.Период) КАК Период,
		|			МАКСИМУМ(_УсловияДепозитныхВкладов.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
		|		ИЗ
		|			_УсловияДепозитныхВкладов КАК _УсловияДепозитныхВкладов
		|		ГДЕ
		|			_УсловияДепозитныхВкладов.Действует
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_УсловияДепозитныхВкладов.КредитныйИнструмент) КАК ВложенныйЗапрос
		|		ПО _УсловияДепозитныхВкладов.КредитныйИнструмент = ВложенныйЗапрос.КредитныйИнструмент
		|			И _УсловияДепозитныхВкладов.Период = ВложенныйЗапрос.Период
		|			И _УсловияДепозитныхВкладов.ДатаНачалаДействияУсловий = ВложенныйЗапрос.ДатаНачалаДействияУсловий
		|ГДЕ
		|	_УсловияДепозитныхВкладов.ДатаПогашения = &Дата";
#КонецОбласти
			
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("БезОтбораПоБанку", (Не ЗначениеЗаполнено(ЭтаФорма.Банк)));
	Запрос.УстановитьПараметр("Банк", ЭтаФорма.Банк);
	
	МассивБанков = Новый Массив;
	
	Для Каждого ЭлементБанк Из Обработки.Распоряжения.ПолучитьСтруктуруБанковДляКоторыхНастроеныФормыПодтверждений() Цикл
		МассивБанков.Добавить(ЭлементБанк.Значение);
	КонецЦикла;
	
	Запрос.УстановитьПараметр("МассивБанков", МассивБанков);

	Запрос.Выполнить();
	
	ТабРаспоряженияНаМНО = Запрос.МенеджерВременныхТаблиц.Таблицы["_РаспоряженияНаМНО"].ПолучитьДанные().Выгрузить();
	
	ЭтаФорма.РаспоряженияНаМНО.Загрузить(ТабРаспоряженияНаМНО.Скопировать(Новый Структура("ТребуетсяАкцепт", Ложь)));
	ЭтаФорма.РаспоряженияОжидающиеАкцепта.Загрузить(ТабРаспоряженияНаМНО.Скопировать(Новый Структура("ТребуетсяАкцепт", Истина)));
	
	ЭтаФорма.РаспоряженияНаДепозиты.Загрузить(Запрос.МенеджерВременныхТаблиц.Таблицы["_РаспоряженияНаДепозиты"].ПолучитьДанные().Выгрузить());
	ЭтаФорма.ДепозитныеВкладыДляЗакрытия.Загрузить(Запрос.МенеджерВременныхТаблиц.Таблицы["_ДепозитныеВкладыДляЗакрытия"].ПолучитьДанные().Выгрузить());
	
	МассивТаблиц = РаботаСКоллекциями.ЗначенияВМассив("РаспоряженияНаМНО", "РаспоряженияНаДепозиты", "РаспоряженияОжидающиеАкцепта");  
	
	Для Инд = 0 По МассивТаблиц.Количество() - 1 Цикл 
		
		ТекТаблица = ЭтаФорма[МассивТаблиц[Инд]]; 
	
		Для Каждого СтрокаРаспоряжение Из ТекТаблица Цикл
			
			Если ЗначениеЗаполнено(СтрокаРаспоряжение.НомерПодтверждения) Тогда
				СтрокаРаспоряжение.НомерПодтверждения = РаботаСоСтрокамиКлиентСервер.СократитьЛидирующиеНули(СтрокаРаспоряжение.НомерПодтверждения);	
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЭтаФорма.Элементы.СтраницаМНО.Заголовок = "МНО (" + ЭтаФорма.РаспоряженияНаМНО.Количество() + ")"; 
	ЭтаФорма.Элементы.СтраницаРазмещениеДепозитов.Заголовок = "Размещение депозитов (" + ЭтаФорма.РаспоряженияНаДепозиты.Количество() + ")";
	ЭтаФорма.Элементы.СтраницаЗакрытиеДепозитов.Заголовок = "Закрытие депозитов (" + ЭтаФорма.ДепозитныеВкладыДляЗакрытия.Количество() + ")"; 
	
	ОжидаютАкцепта = ЭтаФорма.РаспоряженияОжидающиеАкцепта.Количество(); 
			
	ЭтаФорма.Элементы.КомандаПоказатьРаспоряженияОжидающиеАкцепта.Заголовок = "Ожидают акцепта" + ?(ОжидаютАкцепта > 0, " (" + ОжидаютАкцепта + ")", "");  
	ЭтаФорма.Элементы.КомандаПоказатьРаспоряженияОжидающиеАкцепта.Видимость = (ОжидаютАкцепта > 0); 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСозданныеИсполненияНаСервере()

#Область МНО
	СозданныеМНО.ПолучитьЭлементы().Очистить();
	
	СозданныеМНОНаСервере = РеквизитФормыВЗначение("СозданныеМНО");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокументМНО.Ссылка КАК ДокументМНО,
		|	ДокументМНО.Основание КАК Распоряжение,
		|	ПриходПроцентовМНО.Ссылка КАК ПриходПроцентов,
		|	ДокументМНО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДокументМНО.РасчетныйСчет КАК РасчетныйСчет,
		|	ДокументМНО.Сумма КАК Сумма,
		|	ДокументМНО.Процент КАК Процент,
		|	ДокументМНО.ДатаВозврата КАК ДатаВозврата,
		|	ВЫБОР
		|		КОГДА ДокументМНО.Основание.ПометкаУдаления
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК СостояниеРаспоряжения,
		|	ВЫБОР
		|		КОГДА ДокументМНО.Проведен
		|			ТОГДА 1
		|		КОГДА ДокументМНО.ПометкаУдаления
		|			ТОГДА 0
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК СостояниеМНО,
		|	ВЫБОР
		|		КОГДА ПриходПроцентовМНО.Проведен
		|			ТОГДА 1
		|		КОГДА ПриходПроцентовМНО.ПометкаУдаления
		|			ТОГДА 0
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК СостояниеПриходаПроцентов,
		|	ЕСТЬNULL(ПриходПроцентовМНО.Сумма, 0) КАК СуммаПроцентов,
		|	Распоряжение.Сумма КАК СуммаРаспоряжения,
		|	Распоряжение.Процент КАК ПроцентРаспоряжения,
		|	Распоряжение.ДатаВозврата КАК ДатаВозвратаРаспоряжения,
		|	Распоряжение.СчетДоверительногоУправления КАК СчетДоверительногоУправленияРаспоряжения,
		|	Распоряжение.РасчетныйСчет КАК РасчетныйСчетРаспоряжения
		|ИЗ
		|	Документ.МНО КАК ДокументМНО
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриходПроцентовМНО КАК ПриходПроцентовМНО
		|		ПО (ПриходПроцентовМНО.МНО = ДокументМНО.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Распоряжение КАК Распоряжение
		|		ПО (ДокументМНО.Основание = Распоряжение.Ссылка)
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(ДокументМНО.Дата, ДЕНЬ) = &Дата
		|	И ДокументМНО.Организация = &Организация
		|	И (&БезОтбораПоБанку ИЛИ ДокументМНО.РасчетныйСчет.Банк = &Банк)
		|ИТОГИ ПО
		|	ДокументМНО
		|	
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("БезОтбораПоБанку", (Не ЗначениеЗаполнено(ЭтаФорма.Банк)));
	Запрос.УстановитьПараметр("Банк", ЭтаФорма.Банк);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаМНО = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаМНО.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ВыборкаМНО.ДокументМНО) Тогда
		
			СозданныеМНОНаСервереСтрока1 = СозданныеМНОНаСервере.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СозданныеМНОНаСервереСтрока1, ВыборкаМНО);
			СозданныеМНОНаСервереСтрока1.Документ 				= ВыборкаМНО.ДокументМНО;
			СозданныеМНОНаСервереСтрока1.СостояниеДокумента 	= ВыборкаМНО.СостояниеМНО;
		
		КонецЕсли; 
		
		Выборка = ВыборкаМНО.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если ЗначениеЗаполнено(Выборка.Распоряжение) Тогда
			
				СозданныеМНОНаСервереСтрока2 = СозданныеМНОНаСервереСтрока1.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СозданныеМНОНаСервереСтрока2, Выборка);
				СозданныеМНОНаСервереСтрока2.Документ 						= Выборка.Распоряжение;
				СозданныеМНОНаСервереСтрока2.СостояниеДокумента 			= Выборка.СостояниеРаспоряжения;
				СозданныеМНОНаСервереСтрока2.Сумма 							= Выборка.СуммаРаспоряжения;
				СозданныеМНОНаСервереСтрока2.Процент 						= Выборка.ПроцентРаспоряжения;
				СозданныеМНОНаСервереСтрока2.ДатаВозврата 					= Выборка.ДатаВозвратаРаспоряжения;
				СозданныеМНОНаСервереСтрока2.СчетДоверительногоУправления 	= Выборка.СчетДоверительногоУправленияРаспоряжения;
				СозданныеМНОНаСервереСтрока2.РасчетныйСчет 					= Выборка.РасчетныйСчетРаспоряжения;
				
				ЗаполнитьЗначенияСвойств(СозданныеМНОНаСервереСтрока1, Выборка, "СуммаРаспоряжения, ПроцентРаспоряжения, ДатаВозвратаРаспоряжения");
				
				СозданныеМНОНаСервереСтрока1.РасхождениеПоСумма							= (Выборка.Сумма 		<> Выборка.СуммаРаспоряжения);
				СозданныеМНОНаСервереСтрока1.РасхождениеПоПроцент      					= (Выборка.Процент      <> Выборка.ПроцентРаспоряжения);
				СозданныеМНОНаСервереСтрока1.РасхождениеПоДатаВозврата 					= (Выборка.ДатаВозврата <> Выборка.ДатаВозвратаРаспоряжения); 
				СозданныеМНОНаСервереСтрока1.РасхождениеПоСчетДоверительногоУправления 	= (Выборка.СчетДоверительногоУправления <> Выборка.СчетДоверительногоУправленияРаспоряжения); 
				СозданныеМНОНаСервереСтрока1.РасхождениеПоРасчетныйСчет				 	= (Выборка.РасчетныйСчет <> Выборка.РасчетныйСчетРаспоряжения); 
				
				Если СозданныеМНОНаСервереСтрока1.РасхождениеПоСумма Тогда
					СозданныеМНОНаСервереСтрока1.СуммаСРасхождением = Формат(СозданныеМНОНаСервереСтрока1.Сумма, "ЧДЦ=2") + " (" + Формат(СозданныеМНОНаСервереСтрока2.Сумма, "ЧДЦ=2") + ")";
				КонецЕсли; 
				Если СозданныеМНОНаСервереСтрока1.РасхождениеПоПроцент Тогда
					СозданныеМНОНаСервереСтрока1.ПроцентСРасхождением = Формат(СозданныеМНОНаСервереСтрока1.Процент, "ЧДЦ=2") + " (" + Формат(СозданныеМНОНаСервереСтрока2.Процент, "ЧДЦ=2") + ")";
				КонецЕсли; 
				Если СозданныеМНОНаСервереСтрока1.РасхождениеПоДатаВозврата Тогда
					СозданныеМНОНаСервереСтрока1.ДатаВозвратаСРасхождением = Формат(СозданныеМНОНаСервереСтрока1.ДатаВозврата, "ДФ=dd.MM.yyyy") + " (" + Формат(СозданныеМНОНаСервереСтрока2.ДатаВозврата, "ДФ=dd.MM.yyyy") + ")";
				КонецЕсли; 
				Если СозданныеМНОНаСервереСтрока1.РасхождениеПоСчетДоверительногоУправления Тогда
					СозданныеМНОНаСервереСтрока1.СчетДоверительногоУправленияСРасхождением = Строка(СозданныеМНОНаСервереСтрока1.СчетДоверительногоУправления) + " (" + Строка(СозданныеМНОНаСервереСтрока2.СчетДоверительногоУправления) + ")";
				КонецЕсли;
				Если СозданныеМНОНаСервереСтрока1.РасхождениеПоРасчетныйСчет Тогда
					СозданныеМНОНаСервереСтрока1.РасчетныйСчетСРасхождением = Строка(СозданныеМНОНаСервереСтрока1.РасчетныйСчет) + " (" + Строка(СозданныеМНОНаСервереСтрока2.РасчетныйСчет) + ")";
				КонецЕсли;
			
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(Выборка.ПриходПроцентов) Тогда
				
				СозданныеМНОНаСервереСтрока3 = СозданныеМНОНаСервереСтрока1.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СозданныеМНОНаСервереСтрока3, Выборка, , "ДатаВозврата, Процент");
				СозданныеМНОНаСервереСтрока3.Документ 				= Выборка.ПриходПроцентов;
				СозданныеМНОНаСервереСтрока3.СостояниеДокумента 	= Выборка.СостояниеПриходаПроцентов;
				СозданныеМНОНаСервереСтрока3.Сумма 					= Выборка.СуммаПроцентов;
				
			КонецЕсли;
			
		КонецЦикла;
			
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(СозданныеМНОНаСервере, "СозданныеМНО");
#КонецОбласти

#Область Депозиты

	СозданныеРазмещенияДепозитов.ПолучитьЭлементы().Очистить();
	
	СозданныеРазмещенияДепозитовНаСервере = РеквизитФормыВЗначение("СозданныеРазмещенияДепозитов");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗакрытиеКредитногоИнструмента.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗакрытиеКредитногоИнструмента.Ссылка КАК Закрытие,
		|	ЗакрытиеКредитногоИнструмента.КредитныйИнструмент КАК Депозит,
		|	ЗакрытиеКредитногоИнструмента.Сумма КАК СуммаДепозита,
		|	ВЫБОР
		|		КОГДА ЗакрытиеКредитногоИнструмента.ПометкаУдаления
		|			ТОГДА 0
		|		КОГДА ЗакрытиеКредитногоИнструмента.Проведен
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК ДанныеКартинкиСтроки
		|ПОМЕСТИТЬ _ЗакрытияДепозитов
		|ИЗ
		|	Документ.ЗакрытиеКредитногоИнструмента КАК ЗакрытиеКредитногоИнструмента
		|ГДЕ
		|	ЗакрытиеКредитногоИнструмента.Организация = &Организация
		|	И НАЧАЛОПЕРИОДА(ЗакрытиеКредитногоИнструмента.Дата, ДЕНЬ) = &Дата
		|	И НЕ ЗакрытиеКредитногоИнструмента.ПометкаУдаления
		|	И ЗакрытиеКредитногоИнструмента.КредитныйИнструмент ССЫЛКА Справочник.ДепозитныеВклады
		|	И (&БезОтбораПоБанку
		|			ИЛИ ВЫРАЗИТЬ(ЗакрытиеКредитногоИнструмента.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Банк = &Банк)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(РазмещениеКредитногоИнструмента.Ссылка, ДепозитныеВклады.Ссылка) КАК ПолеИтогов,
		|	РазмещениеКредитногоИнструмента.Ссылка КАК РазмещениеКредитногоИнструмента,
		|	Распоряжения.Ссылка КАК Распоряжение,
		|	ЕСТЬNULL(РазмещениеКредитногоИнструмента.СчетДоверительногоУправления, Распоряжения.СчетДоверительногоУправления) КАК СчетДоверительногоУправления,
		|	ЕСТЬNULL(РазмещениеКредитногоИнструмента.РасчетныйСчет, Распоряжения.РасчетныйСчет) КАК РасчетныйСчетСписания,
		|	ЕСТЬNULL(РазмещениеКредитногоИнструмента.Сумма, ДепозитныеВклады._НачальныйНоминал) КАК Сумма,
		|	ДепозитныеВклады.Ссылка КАК ДепозитныйВклад,
		|	ДепозитныеВклады.БанковскийСчет КАК РасчетныйСчет,
		|	ДепозитныеВклады.БанковскийСчет.Валюта КАК Валюта,
		|	ДепозитныеВклады._НачальныйНоминал КАК НоминалДепозитногоВклада,
		|	УсловияКредитныхИнструментовСрезПервых.Процент КАК ПроцентДепозитногоВклада,
		|	УсловияКредитныхИнструментовСрезПервых.ДатаПогашения КАК ДатаВозвратаДепозитногоВклада,
		|	Распоряжения.СчетДоверительногоУправления КАК СчетДоверительногоУправленияРаспоряжения,
		|	Распоряжения.Сумма КАК СуммаРаспоряжения,
		|	Распоряжения.Валюта КАК ВалютаРаспоряжения,
		|	Распоряжения.Процент КАК ПроцентРаспоряжения,
		|	Распоряжения.ДатаВозврата КАК ДатаВозвратаРаспоряжения,
		|	Распоряжения.РасчетныйСчет КАК РасчетныйСчетРаспоряжения,
		|	ВЫБОР
		|		КОГДА Распоряжения.ПометкаУдаления
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК СостояниеРаспоряжения,
		|	ВЫБОР
		|		КОГДА РазмещениеКредитногоИнструмента.Проведен
		|			ТОГДА 1
		|		КОГДА РазмещениеКредитногоИнструмента.ПометкаУдаления
		|			ТОГДА 0
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК СостояниеРазмещения,
		|	ВЫБОР
		|		КОГДА ДепозитныеВклады.ПометкаУдаления
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК СостояниеДепозитногоВклада
		|ИЗ
		|	Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПервых(&Дата, Организация = &Организация) КАК УсловияКредитныхИнструментовСрезПервых
		|		ПО ДепозитныеВклады.Ссылка = УсловияКредитныхИнструментовСрезПервых.КредитныйИнструмент
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РазмещениеКредитногоИнструмента КАК РазмещениеКредитногоИнструмента
		|		ПО (РазмещениеКредитногоИнструмента.КредитныйИнструмент = ДепозитныеВклады.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Распоряжение КАК Распоряжения
		|		ПО (ЕСТЬNULL(РазмещениеКредитногоИнструмента.Основание, ДепозитныеВклады.Распоряжение) = Распоряжения.Ссылка)
		|ГДЕ
		|	ВЫБОР
		|			КОГДА РазмещениеКредитногоИнструмента.Ссылка ЕСТЬ НЕ NULL 
		|				ТОГДА НАЧАЛОПЕРИОДА(РазмещениеКредитногоИнструмента.Дата, ДЕНЬ) >= &Дата
		|						И РазмещениеКредитногоИнструмента.Организация = &Организация
		|						И НЕ РазмещениеКредитногоИнструмента.ПометкаУдаления
		|						И НЕ РазмещениеКредитногоИнструмента.Довнесение
		|						И РазмещениеКредитногоИнструмента.КредитныйИнструмент ССЫЛКА Справочник.ДепозитныеВклады
		|			ИНАЧЕ ДепозитныеВклады.Организация = &Организация
		|					И НЕ ДепозитныеВклады.ПометкаУдаления
		|					И Распоряжения.ДатаРазмещения >= &Дата
		|		КОНЕЦ
		|	И (&БезОтбораПоБанку
		|			ИЛИ ДепозитныеВклады.БанковскийСчет.Банк = &Банк)
		|ИТОГИ
		|	МАКСИМУМ(СчетДоверительногоУправления),
		|	МАКСИМУМ(РасчетныйСчетСписания),
		|	МАКСИМУМ(Сумма),
		|	МАКСИМУМ(Валюта),
		|	МАКСИМУМ(СостояниеРаспоряжения),
		|	МАКСИМУМ(СостояниеРазмещения),
		|	МАКСИМУМ(СостояниеДепозитногоВклада)
		|ПО
		|	ПолеИтогов
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("БезОтбораПоБанку", (Не ЗначениеЗаполнено(ЭтаФорма.Банк)));
	Запрос.УстановитьПараметр("Банк", ЭтаФорма.Банк);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаРазмещений = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаРазмещений.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ВыборкаРазмещений.ПолеИтогов) Тогда  
			Если ТипЗнч(ВыборкаРазмещений.ПолеИтогов) = Тип("ДокументСсылка.РазмещениеКредитногоИнструмента") Тогда
		
				СозданныеРазмещенияДепозитовНаСервереНоваяСтрока = СозданныеРазмещенияДепозитовНаСервере.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СозданныеРазмещенияДепозитовНаСервереНоваяСтрока, ВыборкаРазмещений);
				СозданныеРазмещенияДепозитовНаСервереНоваяСтрока.Документ = ВыборкаРазмещений.ПолеИтогов;
				СозданныеРазмещенияДепозитовНаСервереНоваяСтрока.СостояниеДокумента = ВыборкаРазмещений.СостояниеРазмещения;
				СозданныеРазмещенияДепозитовНаСервереНоваяСтрока.РасчетныйСчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СозданныеРазмещенияДепозитовНаСервереНоваяСтрока.Документ.КредитныйИнструмент, "БанковскийСчет");
				СозданныеРазмещенияДепозитовНаСервереНоваяСтрока.Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СозданныеРазмещенияДепозитовНаСервереНоваяСтрока.РасчетныйСчет, "Валюта");
				
			ИначеЕсли ТипЗнч(ВыборкаРазмещений.ПолеИтогов) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
			
				СозданныеРазмещенияДепозитовНаСервереНоваяСтрока = СозданныеРазмещенияДепозитовНаСервере.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СозданныеРазмещенияДепозитовНаСервереНоваяСтрока, ВыборкаРазмещений);
				СозданныеРазмещенияДепозитовНаСервереНоваяСтрока.Документ = ВыборкаРазмещений.ПолеИтогов;
				СозданныеРазмещенияДепозитовНаСервереНоваяСтрока.СостояниеДокумента = ВыборкаРазмещений.СостояниеДепозитногоВклада;
				СозданныеРазмещенияДепозитовНаСервереНоваяСтрока.РасчетныйСчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СозданныеРазмещенияДепозитовНаСервереНоваяСтрока.Документ, "БанковскийСчет");
				СозданныеРазмещенияДепозитовНаСервереНоваяСтрока.Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СозданныеРазмещенияДепозитовНаСервереНоваяСтрока.РасчетныйСчет, "Валюта");
								
			КонецЕсли; 
		КонецЕсли; 
		
		Выборка = ВыборкаРазмещений.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если ЗначениеЗаполнено(Выборка.Распоряжение) Тогда
				
				СозданныеРазмещенияДепозитовНаСервереНоваяПодстрока_1 = СозданныеРазмещенияДепозитовНаСервереНоваяСтрока.Строки.Добавить();
				СозданныеРазмещенияДепозитовНаСервереНоваяПодстрока_1.Документ = Выборка.Распоряжение;
				СозданныеРазмещенияДепозитовНаСервереНоваяПодстрока_1.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправленияРаспоряжения;
				СозданныеРазмещенияДепозитовНаСервереНоваяПодстрока_1.СостояниеДокумента = Выборка.СостояниеРаспоряжения;
				СозданныеРазмещенияДепозитовНаСервереНоваяПодстрока_1.РасчетныйСчетСписания = Выборка.РасчетныйСчетРаспоряжения;
				СозданныеРазмещенияДепозитовНаСервереНоваяПодстрока_1.Сумма = Выборка.СуммаРаспоряжения;
				СозданныеРазмещенияДепозитовНаСервереНоваяПодстрока_1.Валюта = Выборка.ВалютаРаспоряжения;
				СозданныеРазмещенияДепозитовНаСервереНоваяПодстрока_1.Процент = Выборка.ПроцентРаспоряжения;
				СозданныеРазмещенияДепозитовНаСервереНоваяПодстрока_1.ДатаВозврата = Выборка.ДатаВозвратаРаспоряжения;
				
			КонецЕсли;
			
		КонецЦикла;
			
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(СозданныеРазмещенияДепозитовНаСервере, "СозданныеРазмещенияДепозитов");
	
	ЭтаФорма.СозданныеЗакрытияДепозитов.Загрузить(Запрос.МенеджерВременныхТаблиц.Таблицы["_ЗакрытияДепозитов"].ПолучитьДанные().Выгрузить());

#КонецОбласти
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПросроченныеРаспоряженияМНОНаСервере()

	ПросроченныеРаспоряженияМНО.Очистить();
	
	ПросроченныеРаспоряжения = РеквизитФормыВЗначение("Объект").ПолучитьПросроченныеРаспоряженияМНО(ЭтаФорма.Дата, ЭтаФорма.Организация, ЭтаФорма.Банк);
	
	ПросроченныеРаспоряженияМНО.Загрузить(ПросроченныеРаспоряжения);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновить(Команда)
	
	КлючиРазвернутыхСтрокСозданныеМНО = Неопределено;
	РаботаСФормамиКлиент.ПолучитьКлючиРазвернутыхСтрокДерева(ЭтаФорма.СозданныеМНО, Элементы.СозданныеМНО, "Документ", КлючиРазвернутыхСтрокСозданныеМНО);
	
	КлючТекущейСтрокиСозданныеМНО = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.СозданныеМНО, "Документ");
	КлючТекущейСтрокиРаспоряженияНаМНО = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.РаспоряженияНаМНО, "Документ");
	КлючТекущейСтрокиПросроченныеРаспоряженияМНО = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.ПросроченныеРаспоряженияМНО, "Документ");
	
	ПроверитьЗаполнение();
	ЗаполнитьПлановыеСозданныеИсполненияНаСервере();
	ЗаполнитьПросроченныеРаспоряженияМНОНаСервере();
	
	РаботаСФормамиКлиент.ВосстановитьРазвернутыеСтрокиДереваПоКлючу(ЭтаФорма.СозданныеМНО, Элементы.СозданныеМНО, "Документ", КлючиРазвернутыхСтрокСозданныеМНО);
	
	РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.СозданныеМНО, Элементы.СозданныеМНО, "Документ", КлючТекущейСтрокиСозданныеМНО);
	РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.РаспоряженияНаМНО, Элементы.РаспоряженияНаМНО, "Документ", КлючТекущейСтрокиРаспоряженияНаМНО);
	РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.ПросроченныеРаспоряженияМНО, Элементы.ПросроченныеРаспоряженияМНО, "Документ", КлючТекущейСтрокиПросроченныеРаспоряженияМНО);
	
КонецПроцедуры
 
&НаКлиенте
Процедура ДатаОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	ПриИзмененииРеквизитовШапки("Дата", ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура БанкОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	ПриИзмененииРеквизитовШапки("Банк", ВыбранноеЗначение);

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРеквизитовШапки(ИмяРеквизита, ВыбранноеЗначение)
	
	ТекущееЗначение = ЭтаФорма[ИмяРеквизита];	

	Если Вопрос("Перезаполнить таблицы плановых и созданных распоряжений?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		
		ЭтаФорма[ИмяРеквизита] = ВыбранноеЗначение; 
		КомандаОбновить(Неопределено);
		
	Иначе
		ВыбранноеЗначение = ТекущееЗначение; 	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыПровести(Команда)
	
	ДанныеВыбранныхДокументов = ПолучитьДанныеВыбранныхДокументов();
		
	Если ДанныеВыбранныхДокументов.Количество() > 0 Тогда
		
		РаботаСоСпискомДокументовКлиент.Провести(ДанныеВыбранныхДокументов);
	
		КомандаОбновить(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыОтменитьПроведение(Команда)
	
	ДанныеВыбранныхДокументов = ПолучитьДанныеВыбранныхДокументов();
	
	Если ДанныеВыбранныхДокументов.Количество() > 0 Тогда
		
		РаботаСоСпискомДокументовКлиент.ОтменитьПроведение(ДанныеВыбранныхДокументов);
		
		КомандаОбновить(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыУстановитьСнятьПометкуУдаление(Команда)
	
	ДанныеВыбранныхДокументов = ПолучитьДанныеВыбранныхДокументов();
	
	Если ДанныеВыбранныхДокументов.Количество() > 0 Тогда		
		
		РаботаСоСпискомДокументовКлиент.УстановитьСнятьПометкуУдаления(ДанныеВыбранныхДокументов);
		
		КомандаОбновить(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыСоздатьНаОсновании(Команда)
	
	ТекущиеДанныеСписка = Элементы.СозданныеМНО.ТекущиеДанные;
	
	Если ТекущиеДанныеСписка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанныеСписка.Документ) = Тип("ДокументСсылка.МНО") Тогда
		
		РаботаСоСпискомДокументовКлиент.СоздатьНаОсновании(ТекущиеДанныеСписка.Документ, "МНО");
		
		КомандаОбновить(Неопределено);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДанныеВыбранныхДокументов()
	
	ДанныеВыбранныхДокументов = Новый Массив;
	
	ВыделенныеСтрокиСписка = Элементы.СозданныеМНО.ВыделенныеСтроки;
	
	Если ВыделенныеСтрокиСписка = Неопределено Тогда
		Возврат ДанныеВыбранныхДокументов;
	КонецЕсли;
	
	Если ВыделенныеСтрокиСписка.Количество() = 0 Тогда
		Возврат ДанныеВыбранныхДокументов;
	КонецЕсли;	
	
	Для каждого ВыделеннаяСтрокаСписка Из ВыделенныеСтрокиСписка Цикл
		
		ДанныеВыделеннойСтрокиСписка = Элементы.СозданныеМНО.ДанныеСтроки(ВыделеннаяСтрокаСписка);
		
		// не выполняем дейсвия над Распоряжениями на МНО
		Если ТипЗнч(ДанныеВыделеннойСтрокиСписка.Документ) = Тип("ДокументСсылка.Распоряжение") Тогда
		
			Продолжить;
		
		КонецЕсли; 
		
		Состояние = Неопределено;
		
		Если      ДанныеВыделеннойСтрокиСписка.СостояниеДокумента = 0 Тогда
			Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументов.ПомеченНаУдаление");
		ИначеЕсли ДанныеВыделеннойСтрокиСписка.СостояниеДокумента = 1 Тогда
			Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументов.Проведен");
		ИначеЕсли ДанныеВыделеннойСтрокиСписка.СостояниеДокумента = 2 Тогда
			Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументов.Записан");
		КонецЕсли;
		
		ДанныеВыбранныхДокументов.Добавить(
			Новый Структура("Документ, Состояние", ДанныеВыделеннойСтрокиСписка.Документ, Состояние));
		
	КонецЦикла;

	Возврат ДанныеВыбранныхДокументов;
	
КонецФункции

&НаКлиенте
Процедура КомандаРаспоряженияСозданныеРазвернутьВсе(Команда)
	
	РаботаСФормамиКлиент.РазвернутьВсеЭлементыДерева(ЭтаФорма.СозданныеМНО, Элементы.СозданныеМНО);
	
КонецПроцедуры

