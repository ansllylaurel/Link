					ДепозитныйВкладДляЗакрытия.Флажок = Ложь;
					Продолжить;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СоздатьЗакрытияДепозитовНаСервере();
	ЗаполнитьПлановыеСозданныеИсполненияНаСервере();
	
