КонецПроцедуры

&НаКлиенте
Процедура ПечатьРаспоряженийНаДепозиты(ВидПечати)
		
	МассивРаспоряжений	= Новый Массив;
	МассивБанков		= Новый Массив;
	
	// Для формы подтверждений отдельная проверка
	Если ВидПечати = "ПечатьБанковскихПодтверждений" Тогда 
		
		МассивЗаписей = ЭтаФорма.РаспоряженияНаДепозиты.НайтиСтроки(Новый Структура("Флажок, КартинкаПечать", Истина, 0));
		
		Для Каждого СтрокаРаспоряжений Из МассивЗаписей Цикл 		
			МассивРаспоряжений.Добавить(СтрокаРаспоряжений.Документ);
		КонецЦикла;
		
		Для Каждого СтрокаРаспоряжений Из ЭтаФорма.РаспоряженияНаДепозиты Цикл
			
			Если СтрокаРаспоряжений.Флажок И СтрокаРаспоряжений.КартинкаПечать = 1 Тогда
				
				МассивБанков.Добавить(СтрокаРаспоряжений.Банк);
				СтрокаРаспоряжений.Флажок = Ложь;
				
			КонецЕсли;
					
		КонецЦикла;
		
	Иначе
		МассивЗаписей = ЭтаФорма.РаспоряженияНаДепозиты.НайтиСтроки(Новый Структура("Флажок", Истина));
		
		БанкВТБ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_ВТБ");
		Для Каждого СтрокаРаспоряжений Из МассивЗаписей Цикл 
			Если СтрокаРаспоряжений.Банк <> БанкВТБ Тогда 
				МассивБанков.Добавить(СтрокаРаспоряжений.Банк);
				СтрокаРаспоряжений.Флажок = Ложь;
			Иначе	
				МассивРаспоряжений.Добавить(СтрокаРаспоряжений.Документ);
			КонецЕсли;
		КонецЦикла;	
		
	КонецЕсли;
	
	РаботаСКоллекциями.УдалитьПовторяющиесяЗначенияМассива(МассивБанков);
	      		
	Для Каждого ЭлементБанк Из МассивБанков Цикл
		
		Если Вопрос("Для Банка [" + ЭлементБанк + "] не настроена выбранная форма печати", РежимДиалогаВопрос.ОК) = КодВозвратаДиалога.ОК Тогда	
			Продолжить;	
		КонецЕсли;	
		
	КонецЦикла;  

	Если МассивРаспоряжений.Количество() > 0 Тогда	
	
		ПараметрыФормы = Новый Структура("МассивРаспоряжений, Дата, Банк, Организация, ВидПечати", 
								МассивРаспоряжений, 
								ЭтаФорма.Дата, 
								ЭтаФорма.Банк, 
								ЭтаФорма.Организация, 
								ВидПечати);
	
		ОткрытьФормуМодально("Обработка.Распоряжения.Форма.Печать",
			ПараметрыФормы,
			ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьРазмещенияДепозитов(Команда)
	
	РаспоряженияВыбраны = Ложь;
	ПолученыНовыеПараметры = Ложь;
	
	Для Каждого СтрокаРаспоряженияНаДепозиты Из ЭтаФорма.РаспоряженияНаДепозиты Цикл
		
		Если СтрокаРаспоряженияНаДепозиты.Флажок = Истина Тогда
			
			Если СтрокаРаспоряженияНаДепозиты.ДатаРазмещения <> НачалоДня(ТекущаяДата()) Тогда
		
				Если Вопрос("Дата размещения [" + Формат(СтрокаРаспоряженияНаДепозиты.ДатаРазмещения, "ДФ=dd.MM.yyyy") + "] в распоряжении [" + СтрокаРаспоряженияНаДепозиты.Документ + "] отличается от текущей даты. Продолжить создание размещения депозитного вклада?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда	
					Продолжить;	
				КонецЕсли;
				
			КонецЕсли;

			ПараметрыФормы = Новый Структура("Организация, СчетДоверительногоУправления, Банк, РасчетныйСчетДепозита, НомерПодтверждения, ДатаПодтверждения, УчетныйАктив, Процент, Сумма, Валюта, ДатаРазмещения, ДатаВозврата, Биржевой, ДепозитЗаключенПоДоговору");
	
			ЗаполнитьЗначенияСвойств(ПараметрыФормы, СтрокаРаспоряженияНаДепозиты);
			ПараметрыФормы.Организация = ЭтаФорма.Организация;

			НовыеПараметрыДепозита = ОткрытьФормуМодально("Обработка.Распоряжения.Форма.ПараметрыКредитныхИнструментов", ПараметрыФормы, ЭтаФорма);
	
			Если НовыеПараметрыДепозита <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(СтрокаРаспоряженияНаДепозиты, НовыеПараметрыДепозита, "РасчетныйСчетДепозита, НомерПодтверждения, ДатаПодтверждения, УчетныйАктив, Биржевой, ДепозитЗаключенПоДоговору");		
				ПолученыНовыеПараметры = Истина;	
			КонецЕсли;
	
			РаспоряженияВыбраны = Истина;
	
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПолученыНовыеПараметры Тогда
		
		СоздатьДепозитыИРазмещенияНаСервере();
		ЗаполнитьПлановыеСозданныеИсполненияНаСервере();
		
	КонецЕсли;
	
	Если Не РаспоряженияВыбраны Тогда	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите распоряжения для создания депозитных вкладов.");
	Конецесли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДепозитныеВкладыДляЗакрытияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДепозитныеВкладыДляЗакрытия.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ДепозитныеВкладыДляЗакрытияСчетДоверительногоУправления" И ЗначениеЗаполнено(ТекущиеДанные.СчетДоверительногоУправления) Тогда
		ОткрытьЗначение(ТекущиеДанные.СчетДоверительногоУправления);	
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.КредитныйИнструмент) И РаботаСПользователями.ПраваДоступны(ТекущиеДанные.КредитныйИнструмент, "Просмотр") Тогда
		ОткрытьЗначение(ТекущиеДанные.КредитныйИнструмент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СозданныеЗакрытияДепозитовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.СозданныеЗакрытияДепозитов.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "СозданныеЗакрытияДепозитовСчетДоверительногоУправления" И ЗначениеЗаполнено(ТекущиеДанные.СчетДоверительногоУправления) Тогда
		ОткрытьЗначение(ТекущиеДанные.СчетДоверительногоУправления);	
	ИначеЕсли Поле.Имя = "СозданныеЗакрытияДепозитовЗакрытие" И ЗначениеЗаполнено(ТекущиеДанные.Закрытие) И РаботаСПользователями.ПраваДоступны(ТекущиеДанные.Закрытие, "Просмотр") Тогда 
		ОткрытьЗначение(ТекущиеДанные.Закрытие);
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Депозит) И РаботаСПользователями.ПраваДоступны(ТекущиеДанные.Депозит, "Просмотр") Тогда
		ОткрытьЗначение(ТекущиеДанные.Депозит);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьЗакрытияДепозитов(Команда)
		
	Для Каждого ДепозитныйВкладДляЗакрытия Из ЭтаФорма.ДепозитныеВкладыДляЗакрытия Цикл
		
		Если ДепозитныйВкладДляЗакрытия.Флажок = Истина Тогда
			
			Если ДепозитныйВкладДляЗакрытия.ДатаПогашения <> НачалоДня(ТекущаяДата()) Тогда
		
				Если Вопрос("Дата погашения [" + Формат(ДепозитныйВкладДляЗакрытия.ДатаПогашения, "ДФ=dd.MM.yyyy") + "] депозитного вклада [" + ДепозитныйВкладДляЗакрытия.КредитныйИнструмент + "] отличается от текущей даты. Продолжить создание закрытия депозитного вклада?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда	
					
					ДепозитныйВкладДляЗакрытия.Флажок = Ложь;
					Продолжить;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СоздатьЗакрытияДепозитовНаСервере();
	ЗаполнитьПлановыеСозданныеИсполненияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПоказатьРаспоряженияОжидающиеАкцепта(Команда)
	
	ЭтаФорма.Элементы.ГруппаРаспоряженияОжидающиеАкцепта.Видимость = Не ЭтаФорма.Элементы.ГруппаРаспоряженияОжидающиеАкцепта.Видимость; 	

КонецПроцедуры

&НаКлиенте
Процедура КомандаПечатьПодтвержденияБанка(Команда)
	
	ОтправитьРаспоряженияНаПечать(Команда.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПечатьЗапросаСогласияНаРаспоряжениеИмуществом(Команда)
	
	ОтправитьРаспоряженияНаПечать(Команда.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПечатьУведомленияОНамерении(Команда)
	
	ОтправитьРаспоряженияНаПечать(Команда.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьРаспоряженияНаПечать(ИмяКоманды) 
	
	МассивДокументов = Новый Массив;
	
	ТекСчетДУ = Неопределено;
	
	Для Каждого ТекСтрока Из ЭтаФорма.РаспоряженияОжидающиеАкцепта Цикл 
		
		Если Не ТекСтрока.Флажок Тогда
			Продолжить;	
		КонецЕсли;

		ТекСчетДУ = ?(ТекСчетДУ = Неопределено, ТекСтрока.СчетДоверительногоУправления, ТекСчетДУ);  
				
		Если ИмяКоманды = "КомандаПечатьУведомленияОНамерении" И ТекСчетДУ <> ТекСтрока.СчетДоверительногоУправления Тогда  
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Печать уведомления о намерении возможно в рамках только одного счета ДУ.");
			Возврат
		КонецЕсли;
		
		МассивДокументов.Добавить(ТекСтрока.Документ);
		
	КонецЦикла;
	
	Если МассивДокументов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны распоряжения на МНО для печати");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("МассивДокументов", МассивДокументов);

	Если ИмяКоманды = "КомандаПечатьПодтвержденияБанка" Тогда	
		ОткрытьФорму("Обработка.ПечатьМНО.Форма.ФормаПечатьПодтверждений", ПараметрыФормы, ЭтаФорма);	
	ИначеЕсли ИмяКоманды = "КомандаПечатьУведомленияОНамерении" Тогда
		ОткрытьФорму("Обработка.ПечатьМНО.Форма.ФормаПечатьУведомленияОНамерении", ПараметрыФормы, ЭтаФорма);	
	ИначеЕсли ИмяКоманды = "КомандаПечатьЗапросаСогласияНаРаспоряжениеИмуществом" Тогда
		ОткрытьФорму("Обработка.ПечатьЗапросаСогласияНаРаспоряжениеИмуществом.Форма.ФормаПечатьЗапросаСогласия", ПараметрыФормы, ЭтаФорма);	
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура РаспоряженияОжидающиеАкцептаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОткрытьДокумент(Элементы.РаспоряженияОжидающиеАкцепта.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьАкцепт(Команда)
	
	МассивСтрок = ЭтаФорма.РаспоряженияОжидающиеАкцепта.НайтиСтроки(Новый Структура("Флажок", Истина));
	
	Если МассивСтрок.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать распоряжение для создания акцепта.");	
	ИначеЕсли Вопрос("Вы хотите акцептовать распоряжения (" + МассивСтрок.Количество() + " шт.)?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда

		Для Каждого ТекСтрока Из МассивСтрок Цикл	
			
			СтруктураЗаполнения = Новый Структура("Объект", ТекСтрока.Документ);
			РезультатСоздания = ОткрытьФормуМодально("Документ.Акцепт.ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", СтруктураЗаполнения), ЭтаФорма);
		
		КонецЦикла;
		
		ЗаполнитьПлановыеСозданныеИсполненияНаСервере();
						
	КонецЕсли; 
					
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьДлинныйАкцепт(Команда)
		
	МассивСтрок = ЭтаФорма.РаспоряженияОжидающиеАкцепта.НайтиСтроки(Новый Структура("Флажок", Истина));
	
	Если МассивСтрок.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать распоряжение для создания акцепта.");	
	ИначеЕсли Вопрос("Вы хотите создать длинные акцепты (" + МассивСтрок.Количество() + " шт.)?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда

		Для Каждого ТекСтрока Из МассивСтрок Цикл	
			
			СтруктураЗаполнения = Новый Структура("Объект, ДлинныйАкцепт", ТекСтрока.Документ);
			РезультатСоздания = ОткрытьФормуМодально("Документ.Акцепт.ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", СтруктураЗаполнения), ЭтаФорма);
		
		КонецЦикла;
		
		ЗаполнитьПлановыеСозданныеИсполненияНаСервере();
						
	КонецЕсли; 
					
КонецПроцедуры
