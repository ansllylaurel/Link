	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСоздатьРазмещенияДепозитов(ПараметрыСессии)
	
	РаспоряженияВыбраны = Ложь;
	ПолученыНовыеПараметры = Ложь;
	
	Для Каждого СтрокаРаспоряженияНаДепозиты Из ЭтаФорма.РаспоряженияНаДепозиты Цикл
		
		Если СтрокаРаспоряженияНаДепозиты.Флажок = Истина Тогда
			
			Если СтрокаРаспоряженияНаДепозиты.ДатаРазмещения <> НачалоДня(ТекущаяДата()) Тогда
		
				Если Вопрос("Дата размещения [" + Формат(СтрокаРаспоряженияНаДепозиты.ДатаРазмещения, "ДФ=dd.MM.yyyy") + "] в распоряжении [" + СтрокаРаспоряженияНаДепозиты.Документ + "] отличается от текущей даты. Продолжить создание размещения депозитного вклада?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда	
					Продолжить;	
				КонецЕсли;
				
			КонецЕсли;

			ПараметрыФормы = Новый Структура("Организация, СчетДоверительногоУправления, Банк, РасчетныйСчетДепозита, НомерПодтверждения, ДатаПодтверждения, УчетныйАктив, Процент, Сумма, Валюта, ДатаРазмещения, ДатаВозврата, Биржевой, ДепозитЗаключенПоДоговору");
	
			ЗаполнитьЗначенияСвойств(ПараметрыФормы, СтрокаРаспоряженияНаДепозиты);
			ПараметрыФормы.Организация = ЭтаФорма.Организация;

			НовыеПараметрыДепозита = ОткрытьФормуМодально("Обработка.Распоряжения.Форма.ПараметрыКредитныхИнструментов", ПараметрыФормы, ЭтаФорма);
	
			Если НовыеПараметрыДепозита <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(СтрокаРаспоряженияНаДепозиты, НовыеПараметрыДепозита, "РасчетныйСчетДепозита, НомерПодтверждения, ДатаПодтверждения, УчетныйАктив, Биржевой, ДепозитЗаключенПоДоговору");		
				ПолученыНовыеПараметры = Истина;	
			КонецЕсли;
	
			РаспоряженияВыбраны = Истина;
	
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПолученыНовыеПараметры Тогда
		
		СоздатьДепозитыИРазмещенияНаСервере();
		ЗаполнитьПлановыеСозданныеИсполненияНаСервере();
		
	КонецЕсли;
	
	Если Не РаспоряженияВыбраны Тогда	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите распоряжения для создания депозитных вкладов.");
	Конецесли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДепозитныеВкладыДляЗакрытияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДепозитныеВкладыДляЗакрытия.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ДепозитныеВкладыДляЗакрытияСчетДоверительногоУправления" И ЗначениеЗаполнено(ТекущиеДанные.СчетДоверительногоУправления) Тогда
		ОткрытьЗначение(ТекущиеДанные.СчетДоверительногоУправления);	
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.КредитныйИнструмент) И РаботаСПользователями.ПраваДоступны(ТекущиеДанные.КредитныйИнструмент, "Просмотр") Тогда
		ОткрытьЗначение(ТекущиеДанные.КредитныйИнструмент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СозданныеЗакрытияДепозитовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.СозданныеЗакрытияДепозитов.ТекущиеДанные;
	
