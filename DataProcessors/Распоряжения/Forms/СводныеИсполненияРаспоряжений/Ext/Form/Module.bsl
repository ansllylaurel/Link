		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "СозданныеЗакрытияДепозитовСчетДоверительногоУправления" И ЗначениеЗаполнено(ТекущиеДанные.СчетДоверительногоУправления) Тогда
		ОткрытьЗначение(ТекущиеДанные.СчетДоверительногоУправления);	
	ИначеЕсли Поле.Имя = "СозданныеЗакрытияДепозитовЗакрытие" И ЗначениеЗаполнено(ТекущиеДанные.Закрытие) И РаботаСПользователями.ПраваДоступны(ТекущиеДанные.Закрытие, "Просмотр") Тогда 
		ОткрытьЗначение(ТекущиеДанные.Закрытие);
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Депозит) И РаботаСПользователями.ПраваДоступны(ТекущиеДанные.Депозит, "Просмотр") Тогда
		ОткрытьЗначение(ТекущиеДанные.Депозит);
	КонецЕсли;

