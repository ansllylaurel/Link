&НаКлиенте
Процедура ПечатьРаспоряженийНаДепозиты(ВидПечати)
		
	МассивРаспоряжений	= Новый Массив;
	МассивБанков		= Новый Массив;
	
	// Для формы подтверждений отдельная проверка
	Если ВидПечати = "ПечатьБанковскихПодтверждений" Тогда 
		
		МассивЗаписей = ЭтаФорма.РаспоряженияНаДепозиты.НайтиСтроки(Новый Структура("Флажок, КартинкаПечать", Истина, 0));
		
		Для Каждого СтрокаРаспоряжений Из МассивЗаписей Цикл 		
			МассивРаспоряжений.Добавить(СтрокаРаспоряжений.Документ);
		КонецЦикла;
		
		Для Каждого СтрокаРаспоряжений Из ЭтаФорма.РаспоряженияНаДепозиты Цикл
			
			Если СтрокаРаспоряжений.Флажок И СтрокаРаспоряжений.КартинкаПечать = 1 Тогда
				
				МассивБанков.Добавить(СтрокаРаспоряжений.Банк);
				СтрокаРаспоряжений.Флажок = Ложь;
				
			КонецЕсли;
					
		КонецЦикла;
		
	Иначе
		МассивЗаписей = ЭтаФорма.РаспоряженияНаДепозиты.НайтиСтроки(Новый Структура("Флажок", Истина));
		
		БанкВТБ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_ВТБ");
		Для Каждого СтрокаРаспоряжений Из МассивЗаписей Цикл 
			Если СтрокаРаспоряжений.Банк <> БанкВТБ Тогда 
				МассивБанков.Добавить(СтрокаРаспоряжений.Банк);
				СтрокаРаспоряжений.Флажок = Ложь;
			Иначе	
				МассивРаспоряжений.Добавить(СтрокаРаспоряжений.Документ);
			КонецЕсли;
		КонецЦикла;	
		
	КонецЕсли;
	
	РаботаСКоллекциями.УдалитьПовторяющиесяЗначенияМассива(МассивБанков);
	      		
	Для Каждого ЭлементБанк Из МассивБанков Цикл
		
		Если Вопрос("Для Банка [" + ЭлементБанк + "] не настроена выбранная форма печати", РежимДиалогаВопрос.ОК) = КодВозвратаДиалога.ОК Тогда	
			Продолжить;	
		КонецЕсли;	
		
	КонецЦикла;  

	Если МассивРаспоряжений.Количество() > 0 Тогда	
	
		ПараметрыФормы = Новый Структура("МассивРаспоряжений, Дата, Банк, Организация, ВидПечати", 
								МассивРаспоряжений, 
								ЭтаФорма.Дата, 
								ЭтаФорма.Банк, 
								ЭтаФорма.Организация, 
								ВидПечати);
	
		ОткрытьФормуМодально("Обработка.Распоряжения.Форма.Печать",
			ПараметрыФормы,
			ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
