&НаКлиенте
Процедура КомандаСоздатьМНО(Команда)
	
	ЕстьОшибки = Ложь;
	
	// проверим заполнение
	ВыбРаспоряженияНаМНО = Новый Массив();
	
	Для НомСтр = 0 По РаспоряженияНаМНО.Количество() - 1 Цикл
			
		СтрокаПлановыеРаспоряжения = РаспоряженияНаМНО[НомСтр];
		
		Если Не СтрокаПлановыеРаспоряжения.Флажок Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаПлановыеРаспоряжения.СчетДоверительногоУправления) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Счет д/у"" в строке № " + (НомСтр + 1),,,, ЕстьОшибки);
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(СтрокаПлановыеРаспоряжения.РасчетныйСчет) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Р/счет"" в строке № " + (НомСтр + 1),,,, ЕстьОшибки);
		КонецЕсли;
	
		Если СтрокаПлановыеРаспоряжения.Сумма = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Сумма МНО"" в строке № " + (НомСтр + 1),,,, ЕстьОшибки);
		КонецЕсли;
		
		Если СтрокаПлановыеРаспоряжения.Процент = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Процент"" в строке № " + (НомСтр + 1),,,, ЕстьОшибки);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаПлановыеРаспоряжения.ДатаВозврата) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Дата возврата"" в строке № " + (НомСтр + 1),,,, ЕстьОшибки);
		КонецЕсли;
		
		ВыбРаспоряженияНаМНО.Добавить(
			Новый Структура("НомерСтроки, Документ", 
			НомСтр + 1,
			СтрокаПлановыеРаспоряжения.Документ));
		
	КонецЦикла;
	
	Если ЕстьОшибки Тогда
		Возврат;
	ИначеЕсли ВыбРаспоряженияНаМНО.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны распоряжения на МНО.");
		Возврат;
	КонецЕсли;
	
	Если СоздатьМНО(ВыбРаспоряженияНаМНО) Тогда
		КомандаОбновить(Неопределено);
		РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении()
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьМНО(ВыбРаспоряженияНаМНО)

	Для каждого СтрокаМНО Из ВыбРаспоряженияНаМНО Цикл
	
		МНО = Документы.МНО.СоздатьДокумент();
		МНО.Заполнить(СтрокаМНО.Документ);
		
		МНО.Ответственный = РаботаСПользователями.ТекущийПользователь();
		
		ЕстьОшибки = Ложь;
		
		Если Не МНО.ПроверитьЗаполнение() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При проверке заполнения МНО по строке № " + (СтрокаМНО.НомерСтроки) + " обнаружены ошибки",,,, ЕстьОшибки);
		КонецЕсли;
		
		Если Не ЕстьОшибки Тогда
		
			Попытка
				МНО.Записать(РежимЗаписиДокумента.Проведение);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + МНО);
				СоздатьПриходПроцентовМНО(МНО.Ссылка);
			Исключение
				МНО.Записать(РежимЗаписиДокумента.Запись);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести МНО " + МНО,,,, ЕстьОшибки);
			КонецПопытки;
			
		Иначе
			
			МНО.Записать(РежимЗаписиДокумента.Запись);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + МНО,,,, ЕстьОшибки);
			
		КонецЕсли; 
		
	КонецЦикла;
	
	Возврат Истина;

КонецФункции

&НаСервереБезКонтекста
Процедура СоздатьПриходПроцентовМНО(МНО)

	ПриходПроцентовМНО = Документы.ПриходПроцентовМНО.СоздатьДокумент();
	ПриходПроцентовМНО.Заполнить(МНО);
	
	Если Не ПриходПроцентовМНО.ПроверитьЗаполнение() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось создать документ прихода процентов по МНО");
	КонецЕсли;
	
	Попытка
		ПриходПроцентовМНО.Записать(РежимЗаписиДокумента.Запись);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + ПриходПроцентовМНО, ПриходПроцентовМНО.Ссылка);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось создать документ прихода процентов по МНО. Система сообщает: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДепозитыИРазмещенияНаСервере()
	
	ДанныеДляСозданияДепозитов = РаспоряженияНаДепозиты.Выгрузить(
		Новый Структура("Флажок", Истина),
		"Документ, УчетныйАктив, РасчетныйСчетДепозита, НомерПодтверждения, ДатаПодтверждения, ДепозитЗаключенПоДоговору, Биржевой");
	
	Обработки.Распоряжения.СоздатьДепозитыИРазмещения(ЭтаФорма.Организация, 
									ДанныеДляСозданияДепозитов, 
									?(РаботаСДокументами.ИспользуетсяВыгрузкаПлатежныхПорученийВКлиентБанк(ЭтаФорма.Организация, ЭтаФорма.Дата), Ложь, Истина));
		
КонецПроцедуры

&НаСервере
Процедура СоздатьЗакрытияДепозитовНаСервере()
	
	ДанныеДляЗакрытияДепозитов = ДепозитныеВкладыДляЗакрытия.Выгрузить(Новый Структура("Флажок", Истина), "КредитныйИнструмент");
	
	Справочники.ДепозитныеВклады.СоздатьЗакрытияКредитныхИнструментов(ЭтаФорма.Организация, ЭтаФорма.Дата, ДанныеДляЗакрытияДепозитов); 
	
КонецПроцедуры
 
