&НаКлиенте
Процедура ОтправитьРаспоряженияНаПечать(ИмяКоманды) 
	
	МассивДокументов = Новый Массив;
	
	ТекСчетДУ = Неопределено;
	
	Для Каждого ТекСтрока Из ЭтаФорма.РаспоряженияОжидающиеАкцепта Цикл 
		
		Если Не ТекСтрока.Флажок Тогда
			Продолжить;	
		КонецЕсли;

		ТекСчетДУ = ?(ТекСчетДУ = Неопределено, ТекСтрока.СчетДоверительногоУправления, ТекСчетДУ);  
				
		Если ИмяКоманды = "КомандаПечатьУведомленияОНамерении" И ТекСчетДУ <> ТекСтрока.СчетДоверительногоУправления Тогда  
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Печать уведомления о намерении возможно в рамках только одного счета ДУ.");
			Возврат
		КонецЕсли;
		
		МассивДокументов.Добавить(ТекСтрока.Документ);
		
	КонецЦикла;
	
	Если МассивДокументов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны распоряжения на МНО для печати");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("МассивДокументов", МассивДокументов);

	Если ИмяКоманды = "КомандаПечатьПодтвержденияБанка" Тогда	
		ОткрытьФорму("Обработка.ПечатьМНО.Форма.ФормаПечатьПодтверждений", ПараметрыФормы, ЭтаФорма);	
	ИначеЕсли ИмяКоманды = "КомандаПечатьУведомленияОНамерении" Тогда
		ОткрытьФорму("Обработка.ПечатьМНО.Форма.ФормаПечатьУведомленияОНамерении", ПараметрыФормы, ЭтаФорма);	
	ИначеЕсли ИмяКоманды = "КомандаПечатьЗапросаСогласияНаРаспоряжениеИмуществом" Тогда
		ОткрытьФорму("Обработка.ПечатьЗапросаСогласияНаРаспоряжениеИмуществом.Форма.ФормаПечатьЗапросаСогласия", ПараметрыФормы, ЭтаФорма);	
	КонецЕсли;
		
КонецПроцедуры

