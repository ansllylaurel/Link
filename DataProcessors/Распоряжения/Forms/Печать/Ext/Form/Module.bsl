
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Макеты = Новый Структура();
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, "Дата, Организация, Банк, ВидПечати");
		
	Если Не ЗначениеЗаполнено(ЭтаФорма.Организация) Тогда
		ЭтаФорма.Организация = ПараметрыСеанса.ТекущаяОрганизация;		
	КонецЕсли;
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект"); 
	
	Если Параметры.ВидПечати = "ПечатьРаспоряженийМНО" Тогда
	
		Макеты.Вставить("Распоряжение", ОбъектНаСервере.ПолучитьМакет("РаспоряжениеНаМНО"));
		
		ЭтаФорма.Заголовок = "Печать распоряжений на МНО";
	    ЭтаФорма.Элементы.Подписант.Заголовок = "Управляющий";
		
	ИначеЕсли Параметры.ВидПечати = "ПечатьРаспоряженийНаРазмещениеДепозитов" Тогда
		
		Макеты.Вставить("Распоряжение", ОбъектНаСервере.ПолучитьМакет("РаспоряжениеНаОткрытиеДепозита"));
		
		ЭтаФорма.Заголовок = "Печать распоряжений на открытие депозитов";
		ЭтаФорма.Элементы.Подписант.Заголовок = "Управляющий";      
		
	ИначеЕсли Параметры.ВидПечати = "ПечатьЗаявленийНаРазмещениеДепозитов" Тогда	
		
		Макеты.Вставить("ЗаявлениеНаРазмещениеДепозита", ОбъектНаСервере.ПолучитьМакет("ЗаявлениеНаРазмещениеДепозита_ВТБ"));
		
		ЭтаФорма.Заголовок = "Печать заявлений на размещение депозитов";
		ЭтаФорма.Элементы.Подписант.Заголовок = "Подписант";      
		
	ИначеЕсли Параметры.ВидПечати = "ПечатьБанковскихПодтверждений" Тогда
		
		Макеты.Вставить("ФормаПодтвержденияГПБ", ОбъектНаСервере.ПолучитьМакет("ФормаПодтвержденияГПБ")); 
		Макеты.Вставить("ФормаПодтвержденияСбер", ОбъектНаСервере.ПолучитьМакет("ФормаПодтвержденияСбер")); 
		Макеты.Вставить("ФормаПодтвержденияДомРФ", ОбъектНаСервере.ПолучитьМакет("ФормаПодтвержденияДомРФ"));
		Макеты.Вставить("ФормаПодтвержденияРСХБ", ОбъектНаСервере.ПолучитьМакет("ФормаПодтвержденияРСХБ"));
		
		ЭтаФорма.Заголовок = "Печать подтверждений о размещении денежных средств";
		
	КонецЕсли;
	
	ЗаполнитьРаспоряжения(Параметры.МассивРаспоряжений);
			
	Элементы.Подписант.СписокВыбора.ЗагрузитьЗначения(ПолучитьПодписантов(Параметры.ВидПечати));
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Элементы = Форма.Элементы;
	
	Элементы.Банк.Видимость = ЗначениеЗаполнено(Форма.Банк);
	Элементы.КаталогФайлов.Видимость = (Форма.РежимПечати = 1);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПодписантов(ВидПечати)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ЭтаФорма.Дата);
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	
	Если (ВидПечати = "ПечатьРаспоряженийМНО" Или ВидПечати = "ПечатьРаспоряженийНаРазмещениеДепозитов") Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ЕСТЬNULL(СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления, ВЫРАЗИТЬ(УправляющиеСчетовДоверительногоУправленияСрезПоследних.СубъектАналитики КАК Справочник.СчетаДоверительногоУправления)) КАК СчетДоверительногоУправления,
			|	УправляющиеСчетовДоверительногоУправленияСрезПоследних.Управляющий КАК Управляющий
			|ПОМЕСТИТЬ _Управляющие
			|ИЗ
			|	РегистрСведений.УправляющиеСчетовДоверительногоУправления.СрезПоследних(&Дата, Организация = &Организация) КАК УправляющиеСчетовДоверительногоУправленияСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(&Дата, Организация = &Организация) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
			|		ПО УправляющиеСчетовДоверительногоУправленияСрезПоследних.Организация = СтратегииИндивидуальногоИнвестированияСрезПоследних.Организация
			|			И УправляющиеСчетовДоверительногоУправленияСрезПоследних.СубъектАналитики = СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_Управляющие.Управляющий КАК КонтактноеЛицо
			|ИЗ
			|	_Управляющие КАК _Управляющие
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
			|		ПО _Управляющие.Управляющий = Сотрудники.ЮрФизЛицо
			|			И (Сотрудники.Организация = &Организация)
			|			И (_Управляющие.СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			|				ИЛИ _Управляющие.СчетДоверительногоУправления.ДатаРасторжения >= &Дата)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации.СрезПоследних(&Дата, Организация = &Организация) КАК СотрудникиОрганизации
			|		ПО (Сотрудники.Ссылка = СотрудникиОрганизации.Сотрудник)
			|			И (СотрудникиОрганизации.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение))";
		
	Иначе
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	КонтактныеЛица.КонтактноеЛицо КАК КонтактноеЛицо
			|ИЗ
			|	РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
			|		ПО КонтактныеЛица.Объект = Организации.ЮрФизЛицо
			|			И (КонтактныеЛица.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
			|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
			|			И (Организации.Ссылка = &Организация)";
		
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КонтактноеЛицо");
	
КонецФункции

&НаСервере
Процедура ЗаполнитьРаспоряжения(МассивРаспоряжений)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НЕ Распоряжение.ПометкаУдаления КАК Флажок,
		|	ВЫБОР
		|		КОГДА Распоряжение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
		|			ТОГДА Распоряжение.Банк
		|		КОГДА Распоряжение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО)
		|			ТОГДА Распоряжение.РасчетныйСчет.Банк
		|	КОНЕЦ КАК Банк,
		|	Распоряжение.Ссылка КАК Документ,
		|	Распоряжение.СчетДоверительногоУправления,
		|	Распоряжение.РасчетныйСчет,
		|	Распоряжение.Процент,
		|	Распоряжение.ДатаВозврата,
		|	Распоряжение.Сумма,
		|	Распоряжение.Комментарий,
		|	Распоряжение.Организация.ПрефиксНумерации
		|ИЗ
		|	Документ.Распоряжение КАК Распоряжение
		|ГДЕ
		|	Распоряжение.Ссылка В(&МассивРаспоряжений)
		|ИТОГИ ПО
		|	Банк
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("МассивРаспоряжений", МассивРаспоряжений);
	
	ВыборкаБанк = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	РаспоряженияНаСервере = РеквизитФормыВЗначение("Распоряжения");
	
	Пока ВыборкаБанк.Следующий() Цикл
		
		РаспоряженияСтрока1 = РаспоряженияНаСервере.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(РаспоряженияСтрока1, ВыборкаБанк);
		РаспоряженияСтрока1.Документ = ВыборкаБанк.Банк;
		
		Выборка = ВыборкаБанк.Выбрать();
		
		Пока Выборка.Следующий() Цикл
		
			РаспоряженияСтрока2 = РаспоряженияСтрока1.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(РаспоряженияСтрока2, Выборка);
		
		КонецЦикла; 
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(РаспоряженияНаСервере, "Распоряжения");
	
КонецПроцедуры
 
&НаКлиенте
Процедура КомандаРаспоряженияУстановитьВсеФлажки(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаРаспоряженияУстановитьВсеФлажки");
	Попытка
		УстановитьЗначенияФлажков(Истина);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаРаспоряженияСнятьВсеФлажки(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаРаспоряженияСнятьВсеФлажки");
	Попытка
		УстановитьЗначенияФлажков(Ложь);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначенияФлажков(Значение)

	Для каждого СтрокаБанк Из ЭтаФорма.Распоряжения.ПолучитьЭлементы() Цикл
		
		СтрокиРаспоряжений = СтрокаБанк.ПолучитьЭлементы();
		
		Если СтрокиРаспоряжений.Количество() = 0 Тогда
			
			СтрокаБанк.Флажок = Значение;
			
		Иначе
			
			Для каждого СтрокаРС Из СтрокиРаспоряжений Цикл
		
				СтрокаРС.Флажок = Значение;
			
			КонецЦикла; 
		
		КонецЕсли; 
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура РаспоряженияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Распоряжения.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не РаботаСПользователями.ПраваДоступны(ТекущиеДанные.Документ, "Просмотр") Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьЗначение(ТекущиеДанные.Документ);
	
КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("Печать");
	Попытка
		ВыполнитьПечать(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПечать(ПараметрыСессии)
	
	Если ЭтаФорма.РежимПечати = 1 И Не ЗначениеЗаполнено(ЭтаФорма.КаталогФайлов) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите папку для сохранения файлов",,, "КаталогФайлов");
		ПараметрыСессии.ТекстОшибки = "Укажите папку для сохранения файлов";
		Возврат;
	КонецЕсли;
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		ПараметрыСессии.ТекстОшибки = "Ошибка проверки заполнения";
		Возврат;
	КонецЕсли;
	
	ВыбРаспоряжения = Новый Массив();
	
	Для Каждого СтрокаБанк Из Распоряжения.ПолучитьЭлементы() Цикл
	
		Для Каждого СтрокаРаспоряжения Из СтрокаБанк.ПолучитьЭлементы() Цикл
		
			Если Не СтрокаРаспоряжения.Флажок Тогда
				Продолжить;
			КонецЕсли;
			
			ВыбРаспоряжения.Добавить(СтрокаРаспоряжения.Документ);
		
		КонецЦикла; 
	
	КонецЦикла; 
	
	Если ВыбРаспоряжения.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны распоряжения для печати.");
		ПараметрыСессии.ТекстОшибки = "Не выбраны распоряжения для печати.";
		Возврат;
	КонецЕсли;
	
	ПараметрыПечати = Новый Структура("ВидПечати, Макеты, Распоряжения, Дата, Организация, Подписант",
		ЭтаФорма.ВидПечати,
		ЭтаФорма.Макеты,
		ВыбРаспоряжения,
		ЭтаФорма.Дата,
		ЭтаФорма.Организация,
		ЭтаФорма.Подписант);
	
	Если ЭтаФорма.ВидПечати = "ПечатьРаспоряженийМНО" Или ЭтаФорма.ВидПечати = "ПечатьРаспоряженийНаРазмещениеДепозитов" Тогда  
		
		ДанныеДляПечати = СформироватьТикетыНаСервере(ПараметрыПечати);		
		
	ИначеЕсли ЭтаФорма.ВидПечати = "ПечатьБанковскихПодтверждений" Тогда
		
		ДанныеДляПечати = СформироватьПодтвержденияБанков(ПараметрыПечати);
		
	ИначеЕсли ЭтаФорма.ВидПечати = "ПечатьЗаявленийНаРазмещениеДепозитов" Тогда
		
		ДанныеДляПечати = СформироватьЗаявленияНаРазмещениеДепозитов(ПараметрыПечати);
		
	КонецЕсли;
	
	Для Каждого ЗаписьДанных Из ДанныеДляПечати Цикл
		
		Если ЭтаФорма.РежимПечати = 0 Тогда
			
			ЗаписьДанных.ТабличныйДокумент.Показать(,, Ложь);	
			
		ИначеЕсли ЭтаФорма.РежимПечати = 1 Тогда
			
			ИмяФайлаДляСохранения = СформироватьИмяФайла(ЗаписьДанных);
			
			Если ИмяФайлаДляСохранения = Неопределено Тогда
				Продолжить;	
			КонецЕсли;
			
			Попытка
				ЗаписьДанных.ТабличныйДокумент.Записать(ИмяФайлаДляСохранения, ЗаписьДанных.ТипФайла);
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл удалось сохранить файл!" + Символы.ПС + ОписаниеОшибки());
				ПараметрыСессии.ТекстОшибки = "Не удалось сохранить файл";
				Возврат;
			КонецПопытки;
						
		КонецЕсли;
			
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Печать завершена");
		
КонецПроцедуры

&НаКлиенте
Функция СформироватьИмяФайла(ЗаписьДанных)
	
	ИмяФайлаДляСохранения = Неопределено;

	КаталогСохранения = ЭтаФорма.КаталогФайлов + ?(ЗаписьДанных.ИмяПапки = "", "", "\" + Формат(ЗаписьДанных.ИмяПапки, "ДФ=yyyy"));
			
	Файл = Новый Файл(КаталогСохранения);

	Если Не (Файл.Существует() И Файл.ЭтоКаталог()) Тогда
		СоздатьКаталог(КаталогСохранения);
	КонецЕсли;
	
	ИсходноеИмяФайла = КаталогСохранения + "\" + ЗаписьДанных.ИмяФайла;
		
	Для Инд = 0 По 9 Цикл
		
		Если Инд = 0 Тогда
			ИмяФайлаДляСохранения = ИсходноеИмяФайла; 
		Иначе
			
			ПозицияРазделителя = СтрНайти(ИмяФайлаДляСохранения, ".", НаправлениеПоиска.СКонца);
			
			ИмяФайлаДляСохранения = Лев(ИмяФайлаДляСохранения, ПозицияРазделителя - ?(Инд = 1, 1, 3)) + "_" + Строка(Инд) + Прав(ИмяФайлаДляСохранения, СтрДлина(ИмяФайлаДляСохранения) - ПозицияРазделителя + 1); 
			
		КонецЕсли;
		
		Файл = Новый Файл(ИмяФайлаДляСохранения);
		
		Если Не Файл.Существует() Тогда
			Возврат ИмяФайлаДляСохранения;	
		КонецЕсли;
			
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сохранить файл [" + ЗаписьДанных.ИмяФайла + "]. В папке [" + КаталогСохранения + "] уже создано 10 копий."); 
			
	Возврат Неопределено;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьТикетыНаСервере(ПараметрыПечати)
	
	Возврат Обработки.Распоряжения.СформироватьТикеты(ПараметрыПечати);
			
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьПодтвержденияБанков(ПараметрыПечати)
	
	МассивПодтверждений = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Распоряжение.Ссылка КАК Ссылка,
		|	Распоряжение.Дата КАК Дата,
		|	Распоряжение.Организация КАК Организация,
		|	Распоряжение.ДатаРазмещения КАК ДатаРазмещения,
		|	Распоряжение.Банк КАК Банк,
		|	Распоряжение.РасчетныйСчет КАК РасчетныйСчет,
		|	Распоряжение.РасчетныйСчет.Договор.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДляДокументовСчетаСписания,
		|	Распоряжение.РасчетныйСчет.Банк.ЮрФизЛицо КАК БанкСписанияЮрЛицо,
		|	Распоряжение.РасчетныйСчетВозвратаДенежныхСредств КАК РасчетныйСчетВозвратаДенежныхСредств,
		|	Распоряжение.РасчетныйСчетВозвратаДенежныхСредств.Договор.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДляДокументовСчетаВозврата,
		|	Распоряжение.РасчетныйСчетВозвратаДенежныхСредств.Банк.ЮрФизЛицо КАК БанкВозвратаЮрЛицо,
		|	Распоряжение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Распоряжение.Сумма КАК Сумма,
		|	Распоряжение.Валюта КАК Валюта,
		|	Распоряжение.Процент КАК Процент,
		|	Распоряжение.ДатаВозврата КАК ДатаВозврата,
		|	Распоряжение.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
		|	Распоряжение.ДоВостребования КАК ДоВостребования,
		|	Распоряжение.ВидОперации КАК ВидОперации,
		|	Распоряжение.Комментарий КАК Комментарий,
		|	Распоряжение.Банк.ЮрФизЛицо КАК БанкЮрЛицо
		|ПОМЕСТИТЬ _Распоряжения
		|ИЗ
		|	Документ.Распоряжение КАК Распоряжение
		|ГДЕ
		|	Распоряжение.Ссылка В(&Распоряжения)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Распоряжения.Ссылка КАК Распоряжение,
		|	_Распоряжения.Организация КАК Организация,
		|	_Распоряжения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Распоряжения.БанкЮрЛицо КАК БанкЮрЛицо,
		|	ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).НомерДоговора КАК Номер,
		|	ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).ДатаЗаключения КАК ДатаЗаключения
		|ПОМЕСТИТЬ _ГенСоглашения
		|ИЗ
		|	_Распоряжения КАК _Распоряжения
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(&Дата, Организация = &Организация) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
		|		ПО _Распоряжения.Организация = ДоговорыСчетовДоверительногоУправленияСрезПоследних.Организация
		|			И _Распоряжения.СчетДоверительногоУправления = ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|			И (ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ГенСоглашениеПоДепозитнымВкладам))
		|			И (_Распоряжения.БанкЮрЛицо = ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).Контрагент)
		|			И (ДоговорыСчетовДоверительногоУправленияСрезПоследних.Активный)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Дата, Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО ((ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры)) = УсловияДоговоровОбщиеСрезПоследних.Договор)
		|ГДЕ
		|	(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &Дата)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ГенСоглашения.Распоряжение КАК Распоряжение,
		|	_ГенСоглашения.Организация КАК Организация,
		|	_ГенСоглашения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ГенСоглашения.БанкЮрЛицо КАК БанкЮрЛицо,
		|	_ГенСоглашения.Номер КАК Номер,
		|	_ГенСоглашения.ДатаЗаключения КАК ДатаЗаключения
		|ПОМЕСТИТЬ _ЕдиничныеГенСоглашения
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ГенСоглашения.Распоряжение КАК Распоряжение,
		|		_ГенСоглашения.Организация КАК Организация,
		|		_ГенСоглашения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		_ГенСоглашения.БанкЮрЛицо КАК БанкЮрЛицо,
		|		МАКСИМУМ(_ГенСоглашения.ДатаЗаключения) КАК ДатаЗаключения
		|	ИЗ
		|		_ГенСоглашения КАК _ГенСоглашения
		|	ГДЕ
		|		НЕ _ГенСоглашения.Номер ЕСТЬ NULL
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ГенСоглашения.Распоряжение,
		|		_ГенСоглашения.Организация,
		|		_ГенСоглашения.СчетДоверительногоУправления,
		|		_ГенСоглашения.БанкЮрЛицо) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГенСоглашения КАК _ГенСоглашения
		|		ПО ВложенныйЗапрос.Распоряжение = _ГенСоглашения.Распоряжение
		|			И ВложенныйЗапрос.Организация = _ГенСоглашения.Организация
		|			И ВложенныйЗапрос.СчетДоверительногоУправления = _ГенСоглашения.СчетДоверительногоУправления
		|			И ВложенныйЗапрос.БанкЮрЛицо = _ГенСоглашения.БанкЮрЛицо
		|			И ВложенныйЗапрос.ДатаЗаключения = _ГенСоглашения.ДатаЗаключения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_Распоряжения.Ссылка КАК Ссылка,
		|	_Распоряжения.Банк КАК Параметр,
		|	""В 1С отсутствует макет формы подтверждения для банка [%1]. Подтверждение банка на размещение депозита не будет сформировано."" КАК ТекстОшибки
		|ПОМЕСТИТЬ _ОшибкиПечати
		|ИЗ
		|	_Распоряжения КАК _Распоряжения
		|ГДЕ
		|	_Распоряжения.Банк <> ЗНАЧЕНИЕ(Справочник.Банки.ПустаяСсылка)
		|	И НЕ _Распоряжения.Банк В (&Банк_ГПБ, &Банк_Сбер, &Банк_ДомРФ, &Банк_РСХБ)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_Распоряжения.Ссылка,
		|	_Распоряжения.Ссылка,
		|	""Вид операции распоряжения [%1] не соответствует параметрам печати. Подтверждение банка на размещение депозита не будет сформировано.""
		|ИЗ
		|	_Распоряжения КАК _Распоряжения
		|ГДЕ
		|	НЕ _Распоряжения.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПРЕДСТАВЛЕНИЕ(КонтактныеЛица.КонтактноеЛицо) КАК Представление,
		|	КонтактныеЛица.Должность КАК Должность,
		|	КонтактныеЛица.ОснованиеПолномочий КАК ОснованиеПолномочий
		|ПОМЕСТИТЬ _ДанныеПодписанта
		|ИЗ
		|	РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|ГДЕ
		|	КонтактныеЛица.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|	И КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|	И КонтактныеЛица.КонтактноеЛицо = &Подписант
		|	И КонтактныеЛица.Объект.Ссылка = &ЮрЛицоОрганизации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_Распоряжения.БанкСписанияЮрЛицо КАК Ссылка
		|ПОМЕСТИТЬ _ЮрЛицаБанковОрганизаций
		|ИЗ
		|	_Распоряжения КАК _Распоряжения
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_Распоряжения.БанкВозвратаЮрЛицо
		|ИЗ
		|	_Распоряжения КАК _Распоряжения
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_Распоряжения.Банк.ЮрФизЛицо
		|ИЗ
		|	_Распоряжения КАК _Распоряжения
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	&ЮрЛицоОрганизации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо КАК Филиал,
		|	СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо КАК Родитель
		|ПОМЕСТИТЬ _ГоловныеОрганизации
		|ИЗ
		|	РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(
		|			&Дата,
		|			ЮридическоеЛицо В
		|					(ВЫБРАТЬ
		|						_ЮрЛица.Ссылка
		|					ИЗ
		|						_ЮрЛицаБанковОрганизаций КАК _ЮрЛица)
		|				И ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|ГДЕ
		|	СвязанныеЮридическиеЛицаСрезПоследних.Действует
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВложенныйЗапрос.ЮрЛицо КАК ЮрФизЛицо,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование КАК СокращенноеНаименование,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицСрезПоследних.КПП КАК КПП,
		|	СвидетельстваОГосРегистрации.Номер КАК ОГРН
		|ПОМЕСТИТЬ _РеквизитыЮрЛиц
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ЮрЛицаБанковОрганизаций.Ссылка КАК ЮрЛицо
		|	ИЗ
		|		_ЮрЛицаБанковОрганизаций КАК _ЮрЛицаБанковОрганизаций
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ГоловныеОрганизации.Родитель
		|	ИЗ
		|		_ГоловныеОрганизации КАК _ГоловныеОрганизации) КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Дата,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ВложенныйЗапрос.ЮрЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
		|				&Дата,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)) КАК СвидетельстваОГосРегистрации
		|		ПО ВложенныйЗапрос.ЮрЛицо = СвидетельстваОГосРегистрации.ЮрФизЛицо
		|			И (СвидетельстваОГосРегистрации.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ СвидетельстваОГосРегистрации.ДействуетПо > &Дата)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Распоряжения.Организация КАК Организация,
		|	ВЫБОР
		|		КОГДА _Распоряжения.Банк = &Банк_ГПБ
		|			ТОГДА ""ФормаПодтвержденияГПБ""
		|		КОГДА _Распоряжения.Банк = &Банк_Сбер
		|			ТОГДА ""ФормаПодтвержденияСбер""
		|		КОГДА _Распоряжения.Банк = &Банк_ДомРФ
		|			ТОГДА ""ФормаПодтвержденияДомРФ""
		|		КОГДА _Распоряжения.Банк = &Банк_РСХБ
		|			ТОГДА ""ФормаПодтвержденияРСХБ""
		|	КОНЕЦ КАК ИмяМакета,
		|	_Распоряжения.Дата КАК Дата,
		|	_Распоряжения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Распоряжения.ДатаРазмещения КАК ДатаРазмещения,
		|	_Распоряжения.ДатаВозврата КАК ДатаВозврата,
		|	_Распоряжения.Сумма КАК Сумма,
		|	ВЫБОР
		|		КОГДА _Распоряжения.Валюта = &Российский_рубль
		|			ТОГДА ""Рубли""
		|		ИНАЧЕ _Распоряжения.Валюта.НаименованиеПолное
		|	КОНЕЦ КАК НаименованиеВалюты,
		|	_Распоряжения.Валюта.ПараметрыПрописиНаРусском КАК ПараметрыПрописиВалютыНаРусском,
		|	_Распоряжения.Процент КАК Процент,
		|	ВЫБОР
		|		КОГДА _Распоряжения.ПериодичностьВыплатыПроцентов = ЗНАЧЕНИЕ(Перечисление.ПериодичностиВыплатыПроцентов.ВКонцеСрока)
		|			ТОГДА ВЫБОР
		|					КОГДА _Распоряжения.Банк = &Банк_ГПБ
		|						ТОГДА ""Вместе с погашением основного долга""
		|					ИНАЧЕ ""В конце срока""
		|				КОНЕЦ
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ПериодичностьВыплатыПроцентов,
		|	_ЕдиничныеГенСоглашения.Номер КАК НомерГенСоглашения,
		|	_ЕдиничныеГенСоглашения.ДатаЗаключения КАК ДатаГенСоглашения,
		|	_Распоряжения.Банк КАК Банк,
		|	_Распоряжения.Банк.Адрес КАК АдресБанкаРазмещения,
		|	_Распоряжения.Банк.Код КАК БикБанкаРазмещения,
		|	_Распоряжения.Банк.КоррСчет КАК КоррСчетБанкаРазмещения,
		|	_РеквизитыБанкаРазмещения.ПолноеНаименованиеПоУставу КАК НаименованиеБанкаРазмещения,
		|	_РеквизитыБанкаРазмещения.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеБанкаРазмещения,
		|	_РеквизитыБанкаРазмещения.ИНН КАК ИннБанкаРазмещения,
		|	_РеквизитыБанкаРазмещения.КПП КАК КппБанкаРазмещения,
		|	ЕСТЬNULL(_РеквизитыБанкаРазмещения.ОГРН, _РеквизитыГоловногоБанкаРазмещения.ОГРН) КАК ОгрнБанкаРазмещения,
		|	_РеквизитыГоловногоБанкаРазмещения.ПолноеНаименованиеПоУставу КАК НаименованиеГоловногоБанкаРазмещения,
		|	_РеквизитыГоловногоБанкаРазмещения.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеГоловногоБанкаРазмещения,
		|	_Распоряжения.НаименованиеВладельцаДляДокументовСчетаСписания КАК НаименованиеВладельцаДляДокументовСчетаСписания,
		|	_Распоряжения.НаименованиеВладельцаДляДокументовСчетаВозврата КАК НаименованиеВладельцаДляДокументовСчетаВозврата,
		|	_Распоряжения.РасчетныйСчет КАК РасчетныйСчетСписания,
		|	_Распоряжения.РасчетныйСчет.Наименование КАК НаименованиеСчетаСписания,
		|	_Распоряжения.РасчетныйСчет.Банк.Код КАК БикБанкаСписания,
		|	_Распоряжения.РасчетныйСчет.Банк.КоррСчет КАК КоррСчетБанкаСписания,
		|	ЕСТЬNULL(_РеквизитыГоловногоБанкаСписания.КраткоеНаименованиеПоУставу, _РеквизитыБанкаСписания.КраткоеНаименованиеПоУставу) КАК КраткоеНаименованиеБанкаСписания,
		|	_Распоряжения.РасчетныйСчетВозвратаДенежныхСредств КАК СчетВозвратаДенежныхСредств,
		|	_Распоряжения.РасчетныйСчетВозвратаДенежныхСредств.Наименование КАК НаименованиеСчетаВозврата,
		|	_Распоряжения.РасчетныйСчетВозвратаДенежныхСредств.Банк.Код КАК БикБанкаВозврата,
		|	_Распоряжения.РасчетныйСчетВозвратаДенежныхСредств.Банк.КоррСчет КАК КоррСчетБанкаВозврата,
		|	_Распоряжения.РасчетныйСчетВозвратаДенежныхСредств.Банк.Город КАК ГородБанкаВозврата,
		|	ЕСТЬNULL(_РеквизитыГоловногоБанкаВозврата.КраткоеНаименованиеПоУставу, _РеквизитыБанкаВозврата.КраткоеНаименованиеПоУставу) КАК КраткоеНаименованиеБанкаВозврата,
		|	РАЗНОСТЬДАТ(_Распоряжения.ДатаРазмещения, _Распоряжения.ДатаВозврата, ДЕНЬ) КАК Срок,
		|	ВЫБОР
		|		КОГДА _Распоряжения.ДоВостребования
		|			ТОГДА ""Да""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА _Распоряжения.Банк = &Банк_ГПБ
		|					ТОГДА ""Нет""
		|				КОГДА _Распоряжения.Банк = &Банк_Сбер
		|					ТОГДА ""Не предусмотрено""
		|				КОГДА _Распоряжения.Банк = &Банк_ДомРФ
		|					ТОГДА ""не допускается""
		|				ИНАЧЕ """"
		|			КОНЕЦ
		|	КОНЕЦ КАК ДоВостребования,
		|	ЕСТЬNULL(_РеквизитыГоловнойОрганизации.ИНН, _РеквизитыОрганизации.ИНН) КАК ИннОрганизации,
		|	ЕСТЬNULL(_РеквизитыГоловнойОрганизации.КПП, _РеквизитыОрганизации.КПП) КАК КппОрганизации,
		|	ВЫБОР
		|		КОГДА _Распоряжения.Банк = &Банк_ДомРФ
		|				И _Распоряжения.РасчетныйСчетВозвратаДенежныхСредств.Банк = &Банк_ДомРФ
		|			ТОГДА _Распоряжения.РасчетныйСчетВозвратаДенежныхСредств
		|	КОНЕЦ КАК СчетДомРФ,
		|	ВЫБОР
		|		КОГДА _Распоряжения.Банк = &Банк_ДомРФ
		|				И _Распоряжения.РасчетныйСчет.Банк = &Банк_ДомРФ
		|			ТОГДА _Распоряжения.РасчетныйСчет
		|	КОНЕЦ КАК СчетСписанияДомРФ,
		|	ЕСТЬNULL(НомераПодтверждений.Номер, """") КАК НомерПодтверждения
		|ИЗ
		|	_Распоряжения КАК _Распоряжения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ЕдиничныеГенСоглашения КАК _ЕдиничныеГенСоглашения
		|		ПО _Распоряжения.Организация = _ЕдиничныеГенСоглашения.Организация
		|			И _Распоряжения.Ссылка = _ЕдиничныеГенСоглашения.Распоряжение
		|			И _Распоряжения.СчетДоверительногоУправления = _ЕдиничныеГенСоглашения.СчетДоверительногоУправления
		|			И _Распоряжения.БанкЮрЛицо = _ЕдиничныеГенСоглашения.БанкЮрЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыОрганизации
		|		ПО _Распоряжения.Организация.ЮрФизЛицо = _РеквизитыОрганизации.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыБанкаРазмещения
		|		ПО _Распоряжения.БанкЮрЛицо = _РеквизитыБанкаРазмещения.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГоловныеОрганизации КАК _ГоловныеОрганизации
		|			ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыГоловнойОрганизации
		|			ПО _ГоловныеОрганизации.Родитель = _РеквизитыГоловнойОрганизации.ЮрФизЛицо
		|		ПО _Распоряжения.Организация.ЮрФизЛицо = _ГоловныеОрганизации.Филиал
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГоловныеОрганизации КАК _ГоловныеОрганизацииБанковРазмещения
		|			ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыГоловногоБанкаРазмещения
		|			ПО _ГоловныеОрганизацииБанковРазмещения.Родитель = _РеквизитыГоловногоБанкаРазмещения.ЮрФизЛицо
		|		ПО _Распоряжения.БанкЮрЛицо = _ГоловныеОрганизацииБанковРазмещения.Филиал
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыБанкаСписания
		|		ПО _Распоряжения.БанкСписанияЮрЛицо = _РеквизитыБанкаСписания.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГоловныеОрганизации КАК _ГоловныеОрганизацииБанковСписания
		|			ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыГоловногоБанкаСписания
		|			ПО _ГоловныеОрганизацииБанковСписания.Родитель = _РеквизитыГоловногоБанкаСписания.ЮрФизЛицо
		|		ПО _Распоряжения.БанкСписанияЮрЛицо = _ГоловныеОрганизацииБанковСписания.Филиал
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыБанкаВозврата
		|		ПО _Распоряжения.БанкВозвратаЮрЛицо = _РеквизитыБанкаВозврата.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГоловныеОрганизации КАК _ГоловныеОрганизацииБанковВозврата
		|			ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыГоловногоБанкаВозврата
		|			ПО _ГоловныеОрганизацииБанковВозврата.Родитель = _РеквизитыГоловногоБанкаВозврата.ЮрФизЛицо
		|		ПО _Распоряжения.БанкВозвратаЮрЛицо = _ГоловныеОрганизацииБанковВозврата.Филиал
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиПечати КАК _ОшибкиПечати
		|		ПО _Распоряжения.Ссылка = _ОшибкиПечати.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераОбъектов КАК НомераПодтверждений
		|		ПО _Распоряжения.Ссылка = НомераПодтверждений.Объект
		|			И (НомераПодтверждений.Организация = &Организация)
		|			И (НомераПодтверждений.ВидНумерации = ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.ПодтвержденияСбербанка))
		|ГДЕ
		|	_ОшибкиПечати.Ссылка ЕСТЬ NULL
		|ИТОГИ ПО
		|	ИмяМакета";	
#КонецОбласти

	Запрос.УстановитьПараметр("Распоряжения", ПараметрыПечати.Распоряжения);
	Запрос.УстановитьПараметр("Организация", ПараметрыПечати.Организация);
	Запрос.УстановитьПараметр("ЮрЛицоОрганизации", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыПечати.Организация, "ЮрФизЛицо"));
	Запрос.УстановитьПараметр("Подписант", ПараметрыПечати.Подписант);
	Запрос.УстановитьПараметр("Дата", ПараметрыПечати.Дата);
	
	СтруктураБанков = Обработки.Распоряжения.ПолучитьСтруктуруБанковДляКоторыхНастроеныФормыПодтверждений();
	
	Запрос.УстановитьПараметр("Банк_ГПБ", СтруктураБанков.Банк_ГПБ);
	Запрос.УстановитьПараметр("Банк_Сбер", СтруктураБанков.Банк_Сбер);
	Запрос.УстановитьПараметр("Банк_ДомРФ", СтруктураБанков.Банк_ДомРФ);
	Запрос.УстановитьПараметр("Банк_РСХБ", СтруктураБанков.Банк_РСХБ);

	Запрос.УстановитьПараметр("Российский_рубль", ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	ВыборкаГруппировкаПоБанку = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДанныеПодписанта = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДанныеПодписанта"].ПолучитьДанные().Выгрузить();
	
	Пока ВыборкаГруппировкаПоБанку.Следующий() Цикл
		
		ДетальныеЗаписи = ВыборкаГруппировкаПоБанку.Выбрать();
		
		Макет = ПараметрыПечати.Макеты[ВыборкаГруппировкаПоБанку.ИмяМакета];
					                                             
		Пока ДетальныеЗаписи.Следующий() Цикл
			
			ТабличныйДокумент = Новый ТабличныйДокумент;
			ТабличныйДокумент.ПолеСверху = 10;
			ТабличныйДокумент.ПолеСнизу = 0;
			ТабличныйДокумент.ПолеСлева = 20;

			ПервыйЛист = Макет.ПолучитьОбласть("ПервыйЛист");
	
			ЗаполнитьПараметрыОбласти("ПервыйЛист", ПервыйЛист, ДетальныеЗаписи, ДанныеПодписанта);
						
			ТабличныйДокумент.Вывести(ПервыйЛист);
						
			//форма подтверждения сбера размещается на двух листах. + Выводится колонтитул.
			Если ДетальныеЗаписи.ИмяМакета = "ФормаПодтвержденияСбер" Тогда
				
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				
				ВторойЛист = Макет.ПолучитьОбласть("ВторойЛист");
				ЗаполнитьПараметрыОбласти("ВторойЛист", ВторойЛист, ДетальныеЗаписи, ДанныеПодписанта);
								
				ТабличныйДокумент.Вывести(ВторойЛист); 
				
				ТабличныйДокумент.НижнийКолонтитул.НачальнаяСтраница = 1;
				ТабличныйДокумент.НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Низ;				
				
				ТабличныйДокумент.НижнийКолонтитул.ТекстВЦентре = "Банк _________________________                                              Клиент _________________________";
				ТабличныйДокумент.НижнийКолонтитул.Шрифт = Новый Шрифт("Times New Roman", 10);
				ТабличныйДокумент.РазмерКолонтитулаСнизу = 10;
				ТабличныйДокумент.НижнийКолонтитул.Выводить = Истина;
				
			Иначе
				
				ПустаяОбласть = Макет.ПолучитьОбласть("ПустаяОбласть");
				Подвал = Макет.ПолучитьОбласть("Подвал");
				
				ЗаполнитьПараметрыОбласти("Подвал", Подвал, ДетальныеЗаписи, ДанныеПодписанта);
			
				КоличествоПустыхОбластей = 0; // ПолучитьКоличествоПустыхОбластей(1, ПервыйЛист, Подвал, ПустаяОбласть);
				
				Для Инд = 0 По КоличествоПустыхОбластей Цикл 
					ТабличныйДокумент.Вывести(ПустаяОбласть);
				КонецЦикла;
			
				ТабличныйДокумент.Вывести(Подвал);
	
			КонецЕсли;
							
			ТабличныйДокумент.ОтображатьСетку = Ложь;
			ТабличныйДокумент.Защита = Ложь;
			ТабличныйДокумент.ТолькоПросмотр = Ложь;
			ТабличныйДокумент.ОтображатьЗаголовки = Ложь;

			ИмяПапки = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(ДетальныеЗаписи.Банк);
			
			ИмяФайла = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(Строка(ДетальныеЗаписи.Организация) + "_Подтверждение_" 
						+ ДетальныеЗаписи.КраткоеНаименованиеБанкаРазмещения) + "_" + Формат(ДетальныеЗаписи.Сумма, "ЧДЦ=0") + "_" 
						+ Строка(ДетальныеЗаписи.Срок) + "_" + ДетальныеЗаписи.СчетДоверительногоУправления + "_" + Формат(ДетальныеЗаписи.ДатаРазмещения, "ДФ=ddMMyyyy") + ".docx"; 
						
			МассивПодтверждений.Добавить(Новый Структура("ИмяПапки, ИмяФайла, ТипФайла, ТабличныйДокумент", ИмяПапки, ИмяФайла, ТипФайлаТабличногоДокумента.DOCX, ТабличныйДокумент));
		
		КонецЦикла;
			
	КонецЦикла;
	
	ВыборкаОшибокПечати = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиПечати"].ПолучитьДанные().Выбрать();
	
	Пока ВыборкаОшибокПечати.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ВыборкаОшибокПечати.ТекстОшибки, ВыборкаОшибокПечати.Параметр));	
	КонецЦикла;
	
	ПроверкаГенСоглашений = Запрос.МенеджерВременныхТаблиц.Таблицы["_ЕдиничныеГенСоглашения"].ПолучитьДанные().Выбрать();
	
	Возврат МассивПодтверждений;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьЗаявленияНаРазмещениеДепозитов(ПараметрыПечати)
	
	МассивЗаявлений = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо КАК РодительскоеЮридическоеЛицо,
		|	СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо КАК ЮридическоеЛицо
		|ПОМЕСТИТЬ _СвязанныеЮрЛицаБанка
		|ИЗ
		|	РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(
		|			&Дата,
		|			(ЮридическоеЛицо = &ЮридическоеЛицоВТБ
		|				ИЛИ РодительскоеЮридическоеЛицо = &ЮридическоеЛицоВТБ)
		|				И ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|ГДЕ
		|	СвязанныеЮридическиеЛицаСрезПоследних.Действует
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СвязанныеЮрЛицаБанка.ЮридическоеЛицо КАК ЮрЛицо
		|ИЗ
