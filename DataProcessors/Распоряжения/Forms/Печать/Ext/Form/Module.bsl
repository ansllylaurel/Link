		|			ТОГДА ""в дату окончания срока депозита""
		|		КОГДА _Распоряжения.ПериодичностьВыплатыПроцентов = ЗНАЧЕНИЕ(Перечисление.ПериодичностиВыплатыПроцентов.Ежемесячно)
		|			ТОГДА ""ежемесячно""
		|		ИНАЧЕ ""Ошибка""
		|	КОНЕЦ КАК ПериодичностьВыплатыПроцентов,
		|	_ЕдиничныеГенСоглашения.Номер КАК НомерГенСоглашения,
		|	_ЕдиничныеГенСоглашения.ДатаЗаключения КАК ДатаГенСоглашения,
		|	_Распоряжения.Банк КАК Банк,
		|	_Распоряжения.Банк.Адрес КАК АдресБанкаРазмещения,
		|	_Распоряжения.Банк.Код КАК БикБанкаРазмещения,
		|	_Распоряжения.Банк.КоррСчет КАК КоррСчетБанкаРазмещения,
		|	_РеквизитыБанкаРазмещения.ПолноеНаименованиеПоУставу КАК НаименованиеБанкаРазмещения,
		|	_РеквизитыБанкаРазмещения.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеБанкаРазмещения,
		|	_РеквизитыБанкаРазмещения.ИНН КАК ИННБанкаРазмещения,
		|	_РеквизитыБанкаРазмещения.КПП КАК КППБанкаРазмещения,
		|	ЕСТЬNULL(_РеквизитыБанкаРазмещения.ОГРН, _РеквизитыГоловногоБанкаРазмещения.ОГРН) КАК ОгрнБанкаРазмещения,
		|	_РеквизитыГоловногоБанкаРазмещения.ПолноеНаименованиеПоУставу КАК НаименованиеГоловногоБанкаРазмещения,
		|	_РеквизитыГоловногоБанкаРазмещения.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеГоловногоБанкаРазмещения,
		|	_Распоряжения.НаименованиеВладельцаДляДокументовСчетаСписания КАК НаименованиеВладельцаДляДокументовСчетаСписания,
		|	_Распоряжения.НаименованиеВладельцаДляДокументовСчетаВозврата КАК НаименованиеВладельцаДляДокументовСчетаВозврата,
		|	_Распоряжения.РасчетныйСчет КАК РасчетныйСчетСписания,
		|	_Распоряжения.РасчетныйСчет.Наименование КАК НаименованиеСчетаСписания,
		|	_Распоряжения.РасчетныйСчет.Банк.Код КАК БикБанкаСписания,
		|	_Распоряжения.РасчетныйСчет.Банк.КоррСчет КАК КоррСчетБанкаСписания,
		|	ЕСТЬNULL(_РеквизитыГоловногоБанкаСписания.КраткоеНаименованиеПоУставу, _РеквизитыБанкаСписания.КраткоеНаименованиеПоУставу) КАК КраткоеНаименованиеБанкаСписания,
		|	_Распоряжения.РасчетныйСчетВозвратаДенежныхСредств КАК СчетВозвратаДенежныхСредств,
		|	_Распоряжения.РасчетныйСчетВозвратаДенежныхСредств.Наименование КАК НаименованиеСчетаВозврата,
		|	_Распоряжения.РасчетныйСчетВозвратаДенежныхСредств.Банк.Код КАК БикБанкаВозврата,
		|	_Распоряжения.РасчетныйСчетВозвратаДенежныхСредств.Банк.КоррСчет КАК КоррСчетБанкаВозврата,
		|	_Распоряжения.РасчетныйСчетВозвратаДенежныхСредств.Банк.Город КАК ГородБанкаВозврата,
		|	ЕСТЬNULL(_РеквизитыГоловногоБанкаВозврата.КраткоеНаименованиеПоУставу, _РеквизитыБанкаВозврата.КраткоеНаименованиеПоУставу) КАК КраткоеНаименованиеБанкаВозврата,
		|	РАЗНОСТЬДАТ(_Распоряжения.ДатаРазмещения, _Распоряжения.ДатаВозврата, ДЕНЬ) КАК Срок,
		|	_Распоряжения.ДоВостребования КАК ДоВостребования,
		|	_Распоряжения.ПроцентнаяСтавкаПриДосрочномЗакрытии КАК СтавкаДоВостребования,
		|	ЕСТЬNULL(_РеквизитыГоловнойОрганизации.ИНН, _РеквизитыОрганизации.ИНН) КАК ИннОрганизации,
		|	ЕСТЬNULL(_РеквизитыГоловнойОрганизации.КПП, _РеквизитыОрганизации.КПП) КАК КппОрганизации,
		|	НомераПодтверждений.Номер КАК НомерПодтверждения,
		|	_Распоряжения.НомерСчетаСписания КАК НомерСчетаСписания,
		|	ВЫБОР
		|		КОГДА _Распоряжения.РасчетныйСчет.Банк.ЮрФизЛицо В (&ЮрЛицаБанкаВТБ)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК СчетСписанияВБанкеВТБ,
		|	ВЫБОР
		|		КОГДА _Распоряжения.БанкВозвратаДенежныхСредств.ЮрФизЛицо В (&ЮрЛицаБанкаВТБ)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК СчетВозвратаВБанкеВТБ,
		|	_Распоряжения.РасчетныйСчетВозвратаДенежныхСредств.НомерСчета КАК НомерСчетаВозврата
		|ИЗ
		|	_Распоряжения КАК _Распоряжения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ЕдиничныеГенСоглашения КАК _ЕдиничныеГенСоглашения
		|		ПО _Распоряжения.Организация = _ЕдиничныеГенСоглашения.Организация
		|			И _Распоряжения.Ссылка = _ЕдиничныеГенСоглашения.Распоряжение
		|			И _Распоряжения.СчетДоверительногоУправления = _ЕдиничныеГенСоглашения.СчетДоверительногоУправления
		|			И _Распоряжения.БанкЮрЛицо = _ЕдиничныеГенСоглашения.БанкЮрЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыОрганизации
		|		ПО _Распоряжения.Организация.ЮрФизЛицо = _РеквизитыОрганизации.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыБанкаРазмещения
		|		ПО _Распоряжения.БанкЮрЛицо = _РеквизитыБанкаРазмещения.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГоловныеОрганизации КАК _ГоловныеОрганизации
		|			ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыГоловнойОрганизации
		|			ПО _ГоловныеОрганизации.Родитель = _РеквизитыГоловнойОрганизации.ЮрФизЛицо
		|		ПО _Распоряжения.Организация.ЮрФизЛицо = _ГоловныеОрганизации.Филиал
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГоловныеОрганизации КАК _ГоловныеОрганизацииБанковРазмещения
		|			ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыГоловногоБанкаРазмещения
		|			ПО _ГоловныеОрганизацииБанковРазмещения.Родитель = _РеквизитыГоловногоБанкаРазмещения.ЮрФизЛицо
		|		ПО _Распоряжения.БанкЮрЛицо = _ГоловныеОрганизацииБанковРазмещения.Филиал
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыБанкаСписания
		|		ПО _Распоряжения.БанкСписанияЮрЛицо = _РеквизитыБанкаСписания.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГоловныеОрганизации КАК _ГоловныеОрганизацииБанковСписания
		|			ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыГоловногоБанкаСписания
		|			ПО _ГоловныеОрганизацииБанковСписания.Родитель = _РеквизитыГоловногоБанкаСписания.ЮрФизЛицо
		|		ПО _Распоряжения.БанкСписанияЮрЛицо = _ГоловныеОрганизацииБанковСписания.Филиал
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыБанкаВозврата
		|		ПО _Распоряжения.БанкВозвратаЮрЛицо = _РеквизитыБанкаВозврата.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГоловныеОрганизации КАК _ГоловныеОрганизацииБанковВозврата
		|			ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыГоловногоБанкаВозврата
		|			ПО _ГоловныеОрганизацииБанковВозврата.Родитель = _РеквизитыГоловногоБанкаВозврата.ЮрФизЛицо
		|		ПО _Распоряжения.БанкВозвратаЮрЛицо = _ГоловныеОрганизацииБанковВозврата.Филиал
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиПечати КАК _ОшибкиПечати
		|		ПО _Распоряжения.Ссылка = _ОшибкиПечати.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераОбъектов КАК НомераПодтверждений
		|		ПО _Распоряжения.Ссылка = НомераПодтверждений.Объект
		|			И (НомераПодтверждений.Организация = &Организация)
		|			И (НомераПодтверждений.ВидНумерации = ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.ПодтвержденияСбербанка))
		|ГДЕ
		|	_ОшибкиПечати.Ссылка ЕСТЬ NULL";	
	
#КонецОбласти

	Запрос.УстановитьПараметр("Распоряжения",		ПараметрыПечати.Распоряжения);
	Запрос.УстановитьПараметр("Организация", 		ПараметрыПечати.Организация);
	Запрос.УстановитьПараметр("ЮрЛицоОрганизации", 	ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыПечати.Организация, "ЮрФизЛицо"));
	Запрос.УстановитьПараметр("Подписант", 			ПараметрыПечати.Подписант);
	Запрос.УстановитьПараметр("ЮрЛицаБанкаВТБ", 	ЮрЛицаБанкаВТБ);	
	Запрос.УстановитьПараметр("Российский_рубль", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	ДанныеПодписанта = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДанныеПодписанта"].ПолучитьДанные().Выгрузить();
		
	Макет = ПараметрыПечати.Макеты["ЗаявлениеНаРазмещениеДепозита"];
					                                             
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ТабличныйДокумент = Новый ТабличныйДокумент;
		ТабличныйДокумент.ПолеСверху = 10;
		ТабличныйДокумент.ПолеСнизу = 0;
		ТабличныйДокумент.ПолеСлева = 20;

		ПервыйЛист = Макет.ПолучитьОбласть("Заявление");

		ЗаполнитьПараметрыОбласти("ПервыйЛист", ПервыйЛист, ВыборкаДетальныеЗаписи, ДанныеПодписанта);
					
		ТабличныйДокумент.Вывести(ПервыйЛист);
		        						
		ТабличныйДокумент.ОтображатьСетку 		= Ложь;
		ТабличныйДокумент.Защита 				= Ложь;
		ТабличныйДокумент.ТолькоПросмотр		= Ложь;
		ТабличныйДокумент.ОтображатьЗаголовки	= Ложь;

		ИмяПапки = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(ВыборкаДетальныеЗаписи.Банк);
		
		ИмяФайла = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(Строка(ВыборкаДетальныеЗаписи.Организация) + "_Заявление_" 
					+ ВыборкаДетальныеЗаписи.КраткоеНаименованиеБанкаРазмещения) + "_" + Формат(ВыборкаДетальныеЗаписи.Сумма, "ЧДЦ=0") + "_" 
					+ Строка(ВыборкаДетальныеЗаписи.Срок) + "_" + ВыборкаДетальныеЗаписи.СчетДоверительногоУправления + "_" + Формат(ВыборкаДетальныеЗаписи.ДатаРазмещения, "ДФ=ddMMyyyy") + ".docx"; 
					
		МассивЗаявлений.Добавить(Новый Структура("ИмяПапки, ИмяФайла, ТипФайла, ТабличныйДокумент", ИмяПапки, ИмяФайла, ТипФайлаТабличногоДокумента.DOCX, ТабличныйДокумент));
	
	КонецЦикла;
	
	ВыборкаОшибокПечати = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиПечати"].ПолучитьДанные().Выбрать();
	
	Пока ВыборкаОшибокПечати.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ВыборкаОшибокПечати.ТекстОшибки, ВыборкаОшибокПечати.Параметр));	
	КонецЦикла;
	
	ПроверкаГенСоглашений = Запрос.МенеджерВременныхТаблиц.Таблицы["_ЕдиничныеГенСоглашения"].ПолучитьДанные().Выбрать();
	
	Возврат МассивЗаявлений;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКоличествоПустыхОбластей(НомерЛиста, ОсновнаяОбласть, Подвал, ПустаяОбласть)
	
	ТабДок = Новый ТабличныйДокумент;
	
	ТабДок.ПолеСверху = 0;
	ТабДок.ПолеСнизу = 0;

	ТабДок.РазмерКолонтитулаСверху = 0;
	ТабДок.РазмерКолонтитулаСнизу = 0;

	МассивОбластейДляКонтроляВывода = Новый Массив;
									
	МассивОбластейДляКонтроляВывода.Добавить(ОсновнаяОбласть);
	МассивОбластейДляКонтроляВывода.Добавить(Подвал);
			
	Пока ТабДок.ПроверитьВывод(МассивОбластейДляКонтроляВывода) Цикл
		МассивОбластейДляКонтроляВывода.Добавить(ПустаяОбласть);	
	КонецЦикла;
	
	Возврат МассивОбластейДляКонтроляВывода.Количество() - 3; 
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьПараметрыОбласти(ИмяОбласти, ОбластьМакета, Выборка, ДанныеПодписанта)
	
	ШаблонЧислаПрописью 	= ?(Выборка.Процент = Окр(Выборка.Процент, 1), "целая, целых, целых, ж, десятая, десятых, десятых, ж, 1", "целая, целых, целых, ж, сотая, сотых, сотых, ж, 2");
	НезаполненноеЗначение 	= "____________________";
	
	Если ИмяОбласти = "ПервыйЛист" Тогда
		
		ОбластьМакета.Параметры.НомерГенСоглашения	= Выборка.НомерГенСоглашения;
		ОбластьМакета.Параметры.НаименованиеКлиента	= ?(ЗначениеЗаполнено(Выборка.НаименованиеВладельцаДляДокументовСчетаСписания), Выборка.НаименованиеВладельцаДляДокументовСчетаСписания, Выборка.НаименованиеВладельцаДляДокументовСчетаВозврата);
		ОбластьМакета.Параметры.СуммаПрописью		= Формат(Выборка.Сумма, "ЧДЦ=2") + " (" + ЧислоПрописью(Выборка.Сумма,, Выборка.ПараметрыПрописиВалютыНаРусском) + ")"; 
		ОбластьМакета.Параметры.НаименованиеВалюты	= Выборка.НаименованиеВалюты;
		
		Если Выборка.ИмяМакета <> "ФормаПодтвержденияСбер" Тогда // на Форме сбера эти параметры на втором листе 
			
			ОбластьМакета.Параметры.ИннОрганизации = Выборка.ИннОрганизации;
			
			Если Выборка.ИмяМакета <> "ЗаявлениеНаРазмещениеДепозита_ВТБ" Тогда
			
				ОбластьМакета.Параметры.НомерСчетаВозврата			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.СчетВозвратаДенежныхСредств, "НомерСчета");
				ОбластьМакета.Параметры.КоррСчетБанкаВозврата		= Выборка.КоррСчетБанкаВозврата;
				ОбластьМакета.Параметры.БикБанкаВозврата			= Выборка.БикБанкаВозврата;
				ОбластьМакета.Параметры.НаименованиеБанкаВозврата	= Выборка.КраткоеНаименованиеБанкаВозврата;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Выборка.ИмяМакета = "ФормаПодтвержденияСбер" Тогда
					
			ОбластьМакета.Параметры.ДатаПодтверждения	= Формат(Выборка.ДатаРазмещения, "ДФ=""'«'dd'»' MMMM yyyy 'г.'""");
			ОбластьМакета.Параметры.НомерПодтверждения	= РаботаСоСтрокамиКлиентСервер.СократитьЛидирующиеНули(Выборка.НомерПодтверждения);
			ОбластьМакета.Параметры.ДатаГенСоглашения	= Формат(Выборка.ДатаГенСоглашения, "ДФ=""'«'dd'»' MMMM yyyy 'г.'""");
			ОбластьМакета.Параметры.ДатаРазмещения		= Формат(Выборка.ДатаРазмещения, "ДФ=""dd.MM.yyyy 'г.'""");
