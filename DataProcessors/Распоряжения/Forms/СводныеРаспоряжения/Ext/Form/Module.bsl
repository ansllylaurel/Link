		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(&ПериодНачало, ) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
		|		ПО _ИтоговаяТаблица.СчетДоверительногоУправления = СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления
		|			И _ИтоговаяТаблица.СчетДоверительногоУправления.Организация = СтратегииИндивидуальногоИнвестированияСрезПоследних.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЕдиничныеКодыУБрокера КАК _ЕдиничныеКодыУБрокера
		|		ПО _ИтоговаяТаблица.СчетДоверительногоУправления = _ЕдиничныеКодыУБрокера.СчетДоверительногоУправления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок,
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.Наименование,
		|	_ИтоговаяТаблица.СчетДоверительногоУправления.Наименование
		|ИТОГИ ПО
		|	Стратегия,
		|	СчетДоверительногоУправления";
#КонецОбласти
		
	ВыборкаСтратегии = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСтратегии.Следующий() Цикл
		
		Если ВыборкаСтратегии.Стратегия <> Неопределено Тогда
			РаспоряженияМНОПлановыеНаСервереСтрока0 = РаспоряженияМНОПлановыеНаСервере.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(РаспоряженияМНОПлановыеНаСервереСтрока0, ВыборкаСтратегии);
			РаспоряженияМНОПлановыеНаСервереСтрока0.МестоХраненияСтратегияСчетДУ = ВыборкаСтратегии.Стратегия;
			РаспоряженияМНОПлановыеНаСервереСтрока0.Коды = ВыборкаСтратегии.Стратегия.ОсновнойКодУБрокера;
		Иначе
			РаспоряженияМНОПлановыеНаСервереСтрока0 = РаспоряженияМНОПлановыеНаСервере;
		КонецЕсли;
		
		Выборка = ВыборкаСтратегии.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока Выборка.Следующий() Цикл
			
			РаспоряженияМНОПлановыеНаСервереСтрока1 = РаспоряженияМНОПлановыеНаСервереСтрока0.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(РаспоряженияМНОПлановыеНаСервереСтрока1, Выборка);
			РаспоряженияМНОПлановыеНаСервереСтрока1.МестоХраненияСтратегияСчетДУ = Выборка.СчетДоверительногоУправления;
			
			ВыборкаРаспоряжения = Выборка.Выбрать();
			
			Пока ВыборкаРаспоряжения.Следующий() Цикл
				
				Если ВыборкаРаспоряжения.Количество() = 1 Тогда
					
					ЗаполнитьЗначенияСвойств(РаспоряженияМНОПлановыеНаСервереСтрока1, ВыборкаРаспоряжения);	
					
				Иначе
					
					Если РаспоряженияМНОПлановыеНаСервереСтрока1.Строки.Количество() = 0 Тогда
						ЗаполнитьЗначенияСвойств(РаспоряженияМНОПлановыеНаСервереСтрока1, ВыборкаРаспоряжения, "Коды");	
					КонецЕсли;	
					
					РаспоряженияМНОПлановыеНаСервереСтрока2 = РаспоряженияМНОПлановыеНаСервереСтрока1.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(РаспоряженияМНОПлановыеНаСервереСтрока2, ВыборкаРаспоряжения,, "Коды");
							
					РаспоряженияМНОПлановыеНаСервереСтрока2.МестоХраненияСтратегияСчетДУ = ВыборкаРаспоряжения.РасчетныйСчет;
					РаспоряженияМНОПлановыеНаСервереСтрока2.СтрокаРС = Истина;
					
				КонецЕсли; 
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(РаспоряженияМНОПлановыеНаСервере, "РаспоряженияМНОПлановые");
	
	ОбновитьНадписьРаспоряженияМНОПлановыеИтого(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьРаспоряженияМНО(Команда)
	
	КлючиРазвернутыхСтрокРаспоряженияМНОПлановые = Неопределено;
	РаботаСФормамиКлиент.ПолучитьКлючиРазвернутыхСтрокДерева(ЭтаФорма.РаспоряженияМНОПлановые, Элементы.РаспоряженияМНОПлановые, "МестоХраненияСтратегияСчетДУ", КлючиРазвернутыхСтрокРаспоряженияМНОПлановые);
	
	КлючТекущейСтрокиРаспоряженияМНОСозданные = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.РаспоряженияМНОСозданные, "Документ");
	КлючТекущейСтрокиМНОСозданные = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.МНОСозданные, "Документ");
	КлючТекущейСтрокиРаспоряженияМНОПлановые  = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.РаспоряженияМНОПлановые,  "МестоХраненияСтратегияСчетДУ");
	
	ПроверитьЗаполнение();
	
	ЗаполнитьПлановыеИСозданныеРаспоряженияНаСервере();
	
	РаботаСФормамиКлиент.ВосстановитьРазвернутыеСтрокиДереваПоКлючу(ЭтаФорма.РаспоряженияМНОПлановые, Элементы.РаспоряженияМНОПлановые, "МестоХраненияСтратегияСчетДУ", КлючиРазвернутыхСтрокРаспоряженияМНОПлановые);
	
	РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.РаспоряженияМНОСозданные, Элементы.РаспоряженияМНОСозданные, "Документ", КлючТекущейСтрокиРаспоряженияМНОСозданные);
	РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.МНОСозданные, Элементы.МНОСозданные, "Документ", КлючТекущейСтрокиМНОСозданные);
	РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.РаспоряженияМНОПлановые, Элементы.РаспоряженияМНОПлановые, "МестоХраненияСтратегияСчетДУ", КлючТекущейСтрокиРаспоряженияМНОПлановые);

КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьРаспоряженияНаРазмещениеДепозитов(Команда)
	
	РаспоряженияНаРазмещениеДепозитов.Параметры.УстановитьЗначениеПараметра("СписокОтмеченных", ЭтаФорма.СписокОтмеченных);

КонецПроцедуры

&НаКлиенте
Процедура КомандаРаспоряженияМНОПлановыеСнятьВсеФлажки(Команда)
	
	УстановитьЗначенияФлажков(Ложь);
	ОбновитьНадписьРаспоряженияМНОПлановыеИтого(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура КомандаРаспоряженияМНОПлановыеУстановитьВсеФлажки(Команда)
	
	УстановитьЗначенияФлажков(Истина);
	ОбновитьНадписьРаспоряженияМНОПлановыеИтого(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначенияФлажков(Значение, ЭлементыДерева = Неопределено)
	
	Если ЭлементыДерева = Неопределено Тогда
		ЭлементыДерева = ЭтаФорма.РаспоряженияМНОПлановые.ПолучитьЭлементы();
	КонецЕсли;
	
	Для Каждого ТекЭлемент Из ЭлементыДерева Цикл
		
		ДочерниеЭлементы = ТекЭлемент.ПолучитьЭлементы();
		
		Если ДочерниеЭлементы.Количество() = 0 Тогда
			ТекЭлемент.Флажок = Значение;
		Иначе
			УстановитьЗначенияФлажков(Значение, ДочерниеЭлементы);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры
 
&НаКлиенте
Функция СоздатьПлановыеРаспоряженияМНО(ЕстьОшибки, ЭлементыДерева = Неопределено)
	
	Результат = Новый Массив;
	
	Если ЭлементыДерева = Неопределено Тогда
		ЭлементыДерева = ЭтаФорма.РаспоряженияМНОПлановые.ПолучитьЭлементы();
	КонецЕсли;
	
	Для Каждого ТекЭлемент Из ЭлементыДерева Цикл
		
		ДочерниеЭлементы = ТекЭлемент.ПолучитьЭлементы();
		
		Если ДочерниеЭлементы.Количество() = 0 Тогда
			
			Если ТекЭлемент.Флажок Тогда
				
				ПроверитьЗаполнениеСтроки(ТекЭлемент, ЕстьОшибки);
			    
				Распоряжение = Новый Структура;
				Распоряжение.Вставить("СчетДоверительногоУправления", ТекЭлемент.СчетДоверительногоУправления);
				Распоряжение.Вставить("РасчетныйСчет",                ТекЭлемент.РасчетныйСчет);
				Распоряжение.Вставить("Сумма",                        ТекЭлемент.Сумма);
				Распоряжение.Вставить("Валюта",                       ЭтаФорма.Валюта);
				Распоряжение.Вставить("Процент",                      ТекЭлемент.Процент);
				Распоряжение.Вставить("ДатаВозврата",                 ТекЭлемент.ДатаВозврата);
				Распоряжение.Вставить("ПодКупон",					  ТекЭлемент.ПодКупон);
				Распоряжение.Вставить("Организация",                  ЭтаФорма.Организация);
				Распоряжение.Вставить("ВидОперации",                  ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.МНО"));
				Распоряжение.Вставить("Дата",                         ЭтаФорма.Дата);
				Распоряжение.Вставить("Коды",                         ТекЭлемент.Коды);
				
				Результат.Добавить(Распоряжение);
				
			КонецЕсли;
					
		Иначе
			РаботаСКоллекциями.ДополнитьМассив(Результат, СоздатьПлановыеРаспоряженияМНО(ЕстьОшибки, ДочерниеЭлементы));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура КомандаСоздатьРаспоряженияМНО(Команда)
	
	ЕстьОшибки = Ложь;
	
	ВыбПлановыеРаспоряжения = СоздатьПлановыеРаспоряженияМНО(ЕстьОшибки); 
	
	Если ЕстьОшибки Тогда
		Возврат;
	ИначеЕсли ВыбПлановыеРаспоряжения.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны плановые распоряжения.");
		Возврат;
	КонецЕсли;
	
	СоздатьРаспоряжения(ВыбПлановыеРаспоряжения);
	
	КомандаОбновитьРаспоряженияМНО(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнениеСтроки(СтрокаПлановыеРаспоряжения, ЕстьОшибки)

	СтрокаРодитель = СтрокаПлановыеРаспоряжения.ПолучитьРодителя();
	Если СтрокаРодитель = Неопределено Тогда
		КодКлиента = СтрокаПлановыеРаспоряжения.Коды;
	Иначе
		КодКлиента = СтрокаРодитель.Коды;
	КонецЕсли; 
	
	Если СтрокаПлановыеРаспоряжения.Сумма = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не заполнено поле ""Сумма МНО"" по клиенту с кодом: " + КодКлиента + "'"), ЭтотОбъект,,, ЕстьОшибки);
	КонецЕсли;
	
	Если СтрокаПлановыеРаспоряжения.Процент = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не заполнено поле ""Процент"" по клиенту с кодом: " + КодКлиента + "'"), ЭтотОбъект,,, ЕстьОшибки);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаПлановыеРаспоряжения.ДатаВозврата) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не заполнено поле ""Дата возврата"" по клиенту с кодом: " + КодКлиента + "'"), ЭтотОбъект,,, ЕстьОшибки);
	КонецЕсли;
	
	Если СтрокаПлановыеРаспоряжения.ДатаВозврата - Дата <= 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Дата возврата МНО меньше даты документа по клиенту с кодом: " + КодКлиента + "'"), ЭтотОбъект,,, ЕстьОшибки);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьРаспоряжения(ВыбПлановыеРаспоряжения)
					
	Обработки.Распоряжения.СоздатьРаспоряжения(ВыбПлановыеРаспоряжения);
	
КонецФункции

&НаКлиенте
Процедура ДатаОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	ПриИзмененииРеквизитовШапки("Дата", ВыбранноеЗначение);
	
	ДатаВозврата = ВыбранноеЗначение + Срок * 24 * 3600;

КонецПроцедуры

&НаКлиенте
Процедура БанкОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	ПриИзмененииРеквизитовШапки("Банк", ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРеквизитовШапки(ИмяРеквизита, ВыбранноеЗначение)
	
	ТекущееЗначение = ЭтаФорма[ИмяРеквизита];

	Если Вопрос("Перезаполнить таблицы плановых и созданных распоряжений?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		
		ЭтаФорма[ИмяРеквизита] = ВыбранноеЗначение; 
		
		ДатаВозврата = ЭтаФорма.Дата + Срок * 24 * 3600;

		КомандаОбновитьРаспоряженияМНО(Неопределено);
		
	Иначе
		ВыбранноеЗначение = ТекущееЗначение;	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроцентПриИзменении(Элемент)
	
	ЗаполнитьРеквизитыПлановыхРазмещений(Новый Структура("Процент", Процент));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизитыПлановыхРазмещений(ЗаполняемыеПоля, ЭлементыДерева = Неопределено)
	
	Если ЭлементыДерева = Неопределено Тогда
		ЭлементыДерева = ЭтаФорма.РаспоряженияМНОПлановые.ПолучитьЭлементы();
	КонецЕсли;
	
	Для Каждого ТекЭлемент Из ЭлементыДерева Цикл
		
		ДочерниеЭлементы = ТекЭлемент.ПолучитьЭлементы();
		
		Если ДочерниеЭлементы.Количество() = 0 Тогда
			
			Если ТекЭлемент.Флажок Тогда
				
				Для Каждого ЗаполняемоеПоле Из ЗаполняемыеПоля Цикл
					ТекЭлемент[ЗаполняемоеПоле.Ключ] = ЗаполняемоеПоле.Значение;
				КонецЦикла;
				
			КонецЕсли;
		Иначе
			ЗаполнитьРеквизитыПлановыхРазмещений(ЗаполняемыеПоля, ДочерниеЭлементы);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СрокПриИзменении(Элемент)
	
	ДатаВозврата = Дата + Срок * 24 * 3600;
	ЗаполнитьРеквизитыПлановыхРазмещений(Новый Структура("Срок, ДатаВозврата", Срок, ДатаВозврата));
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаВозвратаПриИзменении(Элемент)
	
	Срок = ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(ДатаВозврата, Дата);
	ЗаполнитьРеквизитыПлановыхРазмещений(Новый Структура("Срок, ДатаВозврата", Срок, ДатаВозврата));

КонецПроцедуры

&НаКлиенте
Процедура КомандаРаспоряженияМНОПлановыеРазвернутьВсе(Команда)
	
	РаботаСФормамиКлиент.РазвернутьВсеЭлементыДерева(ЭтаФорма.РаспоряженияМНОПлановые, Элементы.РаспоряженияМНОПлановые);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаРаспоряженияМНОПлановыеСвернутьВсе(Команда)
	
	РаботаСФормамиКлиент.СвернутьВсеЭлементыДерева(ЭтаФорма.РаспоряженияМНОПлановые, Элементы.РаспоряженияМНОПлановые);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаРаспоряженияМНОСозданныеПечать(Команда)
	
	МассивРаспоряжений = Новый Массив;
	
	Для Каждого СтрокаРаспоряжений Из РаспоряженияМНОСозданные Цикл
	
		МассивРаспоряжений.Добавить(СтрокаРаспоряжений.Документ);
		
	КонецЦикла;
	
	Если МассивРаспоряжений.Количество() = 0 Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны распоряжения для печати.");
		
	Иначе
	
		ПараметрыФормы = Новый Структура("МассивРаспоряжений, Дата, Банк, Организация, ВидПечати", МассивРаспоряжений, ЭтаФорма.Дата, ЭтаФорма.Банк, ЭтаФорма.Организация, "ПечатьРаспоряженийМНО");
		
		ОткрытьФормуМодально("Обработка.Распоряжения.Форма.Печать",
			ПараметрыФормы,
			ЭтаФорма);
			
	КонецЕсли;
	
КонецПроцедуры
	
	&НаКлиенте
Процедура КомандаРаспоряженияНаРазмещениеДепозитовПечать(Команда)
	
	МассивРаспоряжений = ЭтаФорма.СписокОтмеченных.ВыгрузитьЗначения();
			
	Если МассивРаспоряжений.Количество() = 0 Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны распоряжения для печати.");
		
	Иначе	
	
		ПараметрыФормы = Новый Структура("МассивРаспоряжений, Дата, Банк, Организация, ВидПечати", МассивРаспоряжений, ЭтаФорма.Дата, ЭтаФорма.Банк, ЭтаФорма.Организация, "ПечатьРаспоряженийНаРазмещениеДепозитов");
	
		ОткрытьФормуМодально("Обработка.Распоряжения.Форма.Печать",
			ПараметрыФормы,
			ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспоряженияМНОПлановыеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ИменаРедактируемыхПолей = Новый Массив;
	ИменаРедактируемыхПолей.Добавить("РаспоряженияМНОПлановыеСумма");
	ИменаРедактируемыхПолей.Добавить("РаспоряженияМНОПлановыеПроцент");
	ИменаРедактируемыхПолей.Добавить("РаспоряженияМНОПлановыеСрок");
	ИменаРедактируемыхПолей.Добавить("РаспоряженияМНОПлановыеДатаВозврата");
	
	Если Поле.Имя = "РаспоряженияМНОПлановыеСчетДоверительногоУправления" Тогда
	
		ОткрытьЗначение(Элемент.ТекущиеДанные.СчетДоверительногоУправления);
		
	ИначеЕсли Не ИменаРедактируемыхПолей.Найти(Поле.Имя) = Неопределено и ЗначениеЗаполнено(Элементы.РаспоряженияМНОПлановые.ТекущиеДанные.РасчетныйСчет) Тогда
		
		Элементы.РаспоряженияМНОПлановые.ТекущиеДанные.Флажок = Истина;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммуИКоличествоРаспоряжений(Количество, Сумма, ЭлементыДерева)
	
	Для Каждого ТекЭлемент Из ЭлементыДерева Цикл
		
		ДочерниеЭлементы = ТекЭлемент.ПолучитьЭлементы();
		
		Если ДочерниеЭлементы.Количество() = 0 Тогда
			
			Если ТекЭлемент.Флажок Тогда
				Количество	= Количество + 1;
				Сумма		= Сумма + ТекЭлемент.Сумма;
			КонецЕсли;
			
		Иначе
			РассчитатьСуммуИКоличествоРаспоряжений(Количество, Сумма, ДочерниеЭлементы);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьНадписьРаспоряженияМНОПлановыеИтого(Форма)
	
	ТекстНадписи = "";
	ИтогоКоличество = 0;
	ИтогоСумма = 0;
	
	РассчитатьСуммуИКоличествоРаспоряжений(ИтогоКоличество, ИтогоСумма, Форма.РаспоряженияМНОПлановые.ПолучитьЭлементы());
	
	ТекстНадписи = "Итого будет создано " + ИтогоКоличество + " " + РаботаСоСтрокамиКлиентСервер.ФормаМножественногоЧисла(ИтогоКоличество, "распоряжение", "распоряжения", "распоряжений") + ", на сумму " + ИтогоСумма;
			
	Форма.Элементы.НадписьРаспоряженияМНОПлановыеИтого.Заголовок = ТекстНадписи;
	
КонецПроцедуры 

&НаКлиенте
Процедура РаспоряженияМНОПлановыеСуммаПриИзменении(Элемент)
	
	ТекСтрока = Элементы.РаспоряженияМНОПлановые.ТекущиеДанные;
	Если ТекСтрока.Сумма = 0 Тогда
	
		ТекСтрока.Флажок = Ложь;
	
	КонецЕсли; 
	ОбновитьНадписьРаспоряженияМНОПлановыеИтого(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспоряженияМНОПлановыеФлажокПриИзменении(Элемент)
	
	ОбновитьНадписьРаспоряженияМНОПлановыеИтого(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
	ЗаполнитьПлановыеИСозданныеРаспоряженияНаСервере();
	
	ТаблицыЗаполнены = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспоряженияМНОПлановыеСрокПриИзменении(Элемент)
	
	ТекСтрока = Элементы.РаспоряженияМНОПлановые.ТекущиеДанные;
	ТекСтрока.ДатаВозврата = Дата + ТекСтрока.Срок * 24 * 3600;
	
КонецПроцедуры

&НаКлиенте
Процедура МНОСозданныеПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекущиеДанные = Элементы.МНОСозданные.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не РаботаСПользователями.ПраваДоступны(ТекущиеДанные.Документ, "Просмотр") Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьЗначение(ТекущиеДанные.Документ);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не ТаблицыЗаполнены Тогда
	
		ЗаполнитьПлановыеИСозданныеРаспоряженияНаСервере();
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаРаспоряженияМНОПлановыеОтображатьНачальныеОстатки(Команда)
	
	ОтображатьНачальныеОстатки = НЕ Элементы.КомандаРаспоряженияМНОПлановыеОтображатьНачальныеОстатки.Пометка;
	Элементы.КомандаРаспоряженияМНОПлановыеОтображатьНачальныеОстатки.Пометка = ОтображатьНачальныеОстатки;
	Элементы.ГруппаНачальныеОстатки.Видимость = ОтображатьНачальныеОстатки;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗагрузитьРаспоряженияМНОИзExcel(Команда)
	
	ЗагрузитьРаспоряженияИзExcel(ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.МНО"));
		
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗагрузитьРаспоряженияНаРазмещениеДепозитовИзExcel(Команда)
	
	ЗагрузитьРаспоряженияИзExcel(ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента"));
	
	РаспоряженияНаРазмещениеДепозитов.Параметры.УстановитьЗначениеПараметра("СписокОтмеченных", ЭтаФорма.СписокОтмеченных);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьРаспоряженияИзExcel(ВидОперации)
	
	ПараметрыФормы = Новый Структура("Дата, Организация, Валюта, ВидОперации", ЭтаФорма.Дата, ЭтаФорма.Организация, ЭтаФорма.Валюта, ВидОперации);	
	РезультатЗагрузки = ОткрытьФормуМодально("Обработка.Распоряжения.Форма.ЗагрузкаИзExcel", ПараметрыФормы, ЭтаФорма);
	
	Если ТипЗнч(РезультатЗагрузки) = Тип("Структура") Тогда
		
		Для Каждого Сообщение Из РезультатЗагрузки.СообщенияПользователю Цикл
			Сообщение.Сообщить();
		КонецЦикла; 
		
	КонецЕсли;
	
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.МНО") Тогда 
		КомандаОбновитьРаспоряженияМНО(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСозданныеРаспоряженияНаСервере()
	
	ПросроченныеРаспоряженияМНО.Очистить();
	РаспоряженияМНОСозданные.Очистить();
	МНОСозданные.Очистить();
	
	ПросроченныеРаспоряжения = РеквизитФормыВЗначение("Объект").ПолучитьПросроченныеРаспоряженияМНО(ЭтаФорма.Дата, ЭтаФорма.Организация, ЭтаФорма.Банк);
	
	ПросроченныеРаспоряженияМНО.Загрузить(ПросроченныеРаспоряжения);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Документ.Ссылка КАК Ссылка,
		|	Документ.ПометкаУдаления КАК ПометкаУдаления,
		|	Документ.Дата КАК ДатаРаспоряжения,
		|	Документ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Документ.СчетДоверительногоУправления.КодСчета КАК СчетДоверительногоУправленияКодСчета,
		|	Документ.Сумма КАК Сумма,
		|	Документ.Валюта КАК Валюта,
		|	Документ.ДатаВозврата КАК ДатаВозврата,
		|	РАЗНОСТЬДАТ(&ТекущаяДата, Документ.ДатаВозврата, ДЕНЬ) КАК ДоПогашения,
		|	ВЫБОР
		|		КОГДА Документ.ПометкаУдаления
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ДанныеКартинкиСтроки,
		|	ВЫБОР
		|		КОГДА Документ.Проведен
		|			ТОГДА 1
		|		КОГДА Документ.ПометкаУдаления
		|			ТОГДА 0
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК СостояниеДокумента,
		|	Документ.Процент КАК Ставка,
		|	Документ.РасчетныйСчет КАК РасчетныйСчет,
		|	Документ.РасчетныйСчет.Банк КАК Банк
		|ПОМЕСТИТЬ _Распоряжения
		|ИЗ
		|	Документ.Распоряжение КАК Документ
		|ГДЕ
		|	Документ.ДатаВозврата > &ТекущаяДата
		|	И НАЧАЛОПЕРИОДА(Документ.Дата, ДЕНЬ) <= &ТекущаяДата
		|	И Документ.Организация = &Организация
		|	И Документ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО)
		|	И (&Банк = ЗНАЧЕНИЕ(Справочник.Банки.ПустаяСсылка)
		|			ИЛИ Документ.РасчетныйСчет.Банк = &Банк)
		|	И Не Документ.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Документ.Ссылка КАК Ссылка,
		|	Документ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Документ.Сумма КАК Сумма,
		|	Документ.РасчетныйСчет.Банк КАК Банк,
		|	Документ.ДатаВозврата КАК ДатаВозврата,
		|	Документ.Основание КАК Основание,
		|	РАЗНОСТЬДАТ(&ТекущаяДата, Документ.ДатаВозврата, ДЕНЬ) КАК ДоПогашения,
		|	ВЫБОР
		|		КОГДА Документ.Проведен
		|			ТОГДА 1
		|		КОГДА Документ.ПометкаУдаления
		|			ТОГДА 0
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК СостояниеДокумента,
		|	Документ.Дата КАК ДатаРазмещения,
		|	Документ.Процент КАК Ставка,
		|	СторнированиеМНО.Ссылка ЕСТЬ NULL КАК Действует
		|ПОМЕСТИТЬ _МНО
		|ИЗ
		|	Документ.МНО КАК Документ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СторнированиеМНО КАК СторнированиеМНО
		|		ПО (СторнированиеМНО.МНО = Документ.Ссылка)
		|ГДЕ
		|	Документ.ДатаВозврата > &ТекущаяДата
		|	И НАЧАЛОПЕРИОДА(Документ.Дата, ДЕНЬ) <= &ТекущаяДата
		|	И Документ.Проведен
		|	И Документ.Организация = &Организация
		|	И (&Банк = ЗНАЧЕНИЕ(Справочник.Банки.ПустаяСсылка)
		|			ИЛИ Документ.РасчетныйСчет.Банк = &Банк)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_МНО.Ссылка КАК Документ,
		|	_МНО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_МНО.Сумма КАК Сумма,
		|	_МНО.ДатаВозврата КАК ДатаВозврата,
		|	_МНО.ДоПогашения КАК ДоПогашения,
		|	_МНО.СостояниеДокумента КАК СостояниеДокумента,
		|	_МНО.СостояниеДокумента КАК ДанныеКартинкиСтроки,
		|	_МНО.СчетДоверительногоУправления.Наименование КАК СчетДоверительногоУправленияНаименование,
		|	_МНО.ДатаРазмещения КАК ДатаРазмещения,
		|	_МНО.Ставка КАК Ставка,
		|	_МНО.Банк КАК Банк,
		|	NULL КАК Истекло
		|ИЗ
		|	_МНО КАК _МНО
		|ГДЕ
		|	_МНО.Действует
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_Распоряжения.Ссылка,
		|	_Распоряжения.СчетДоверительногоУправления,
		|	_Распоряжения.Сумма,
		|	_Распоряжения.ДатаВозврата,
		|	_Распоряжения.ДоПогашения,
		|	_Распоряжения.СостояниеДокумента,
		|	_Распоряжения.ДанныеКартинкиСтроки,
		|	_Распоряжения.СчетДоверительногоУправления.Наименование,
		|	NULL,
		|	_Распоряжения.Ставка,
		|	_Распоряжения.Банк,
		|	_Распоряжения.ДатаРаспоряжения < &ТекущаяДата 
		|ИЗ
		|	_Распоряжения КАК _Распоряжения
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МНО КАК _МНО
		|		ПО _Распоряжения.Ссылка = _МНО.Основание
		|ГДЕ
		|	_МНО.Основание ЕСТЬ NULL
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетДоверительногоУправленияНаименование";
	
	Запрос.УстановитьПараметр("ТекущаяДата", ЭтаФорма.Дата);
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("Банк", ЭтаФорма.Банк);
	
	Выборка = Запрос.Выполнить().Выбрать();
				
	ИтогоКоличество = 0;
	ИтогоСумма = 0;
	                                           
	ИтогоКоличествоМНО = 0;
	ИтогоСуммаМНО = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Если ТипЗнч(Выборка.Документ) = Тип("ДокументСсылка.МНО") Тогда 
			НоваяСтрока = МНОСозданные.Добавить();
			Если НЕ Выборка.Документ.ПометкаУдаления Тогда
			
				ИтогоКоличествоМНО = ИтогоКоличествоМНО + 1;
				ИтогоСуммаМНО = ИтогоСуммаМНО + Выборка.Сумма;
			
			КонецЕсли;
		Иначе
			НоваяСтрока = РаспоряженияМНОСозданные.Добавить();
			Если НЕ Выборка.Документ.ПометкаУдаления Тогда
			
				ИтогоКоличество = ИтогоКоличество + 1;
				ИтогоСумма = ИтогоСумма + Выборка.Сумма;
			
			КонецЕсли;
		КонецЕсли; 
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
	КонецЦикла;
	
	ТекстНадписи = "Итого " + ИтогоКоличество + " " + РаботаСоСтрокамиКлиентСервер.ФормаМножественногоЧисла(ИтогоКоличество, "распоряжение", "распоряжения", "распоряжений") + ", на сумму " + ИтогоСумма;
		
	Элементы.НадписьРаспоряженияМНОСозданныеИтого.Заголовок = ТекстНадписи;
	
	ТекстНадписи = "Итого " + ИтогоКоличествоМНО + " МНО, на сумму " + ИтогоСуммаМНО;
			
	Элементы.НадписьМНОСозданныеИтого.Заголовок = ТекстНадписи;
	Элементы.ГруппаПросроченныеРаспоряженияМНО.Заголовок = "Просроченные (" + Формат(ПросроченныеРаспоряжения.Количество(), "ЧГ=0") + ")";
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыУстановитьСнятьПометкуУдаление(Команда)
	
	ДанныеВыбранныхДокументов = ПолучитьДанныеВыбранныхДокументов();
	
	Если ДанныеВыбранныхДокументов.Количество() > 0 Тогда		
		
		РаботаСоСпискомДокументовКлиент.УстановитьСнятьПометкуУдаления(ДанныеВыбранныхДокументов);
		
		КомандаОбновитьРаспоряженияМНО(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДанныеВыбранныхДокументов()
	
	ДанныеВыбранныхДокументов = Новый Массив;
	
	ВыделенныеСтрокиСписка = Элементы.РаспоряженияМНОСозданные.ВыделенныеСтроки;
	
	Если ВыделенныеСтрокиСписка = Неопределено Тогда
		Возврат ДанныеВыбранныхДокументов;
	КонецЕсли;
	
	Если ВыделенныеСтрокиСписка.Количество() = 0 Тогда
		Возврат ДанныеВыбранныхДокументов;
	КонецЕсли;	
	
	Для каждого ВыделеннаяСтрокаСписка Из ВыделенныеСтрокиСписка Цикл
		
		ДанныеВыделеннойСтрокиСписка = Элементы.РаспоряженияМНОСозданные.ДанныеСтроки(ВыделеннаяСтрокаСписка);
		
		Состояние = Неопределено;
		
		Если      ДанныеВыделеннойСтрокиСписка.СостояниеДокумента = 0 Тогда
			Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументов.ПомеченНаУдаление");
		ИначеЕсли ДанныеВыделеннойСтрокиСписка.СостояниеДокумента = 1 Тогда
			Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументов.Проведен");
		ИначеЕсли ДанныеВыделеннойСтрокиСписка.СостояниеДокумента = 2 Тогда
			Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументов.Записан");
		КонецЕсли;
		
		ДанныеВыбранныхДокументов.Добавить(
			Новый Структура("Документ, Состояние", ДанныеВыделеннойСтрокиСписка.Документ, Состояние));
		
	КонецЦикла;

	Возврат ДанныеВыбранныхДокументов;
	
КонецФункции

&НаКлиенте
Процедура РаспоряженияМНОСозданныеПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекущиеДанные = Элементы.РаспоряженияМНОСозданные.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не РаботаСПользователями.ПраваДоступны(ТекущиеДанные.Документ, "Просмотр") Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьЗначение(ТекущиеДанные.Документ);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспоряженияМНОПлановыеДатаВозвратаПриИзменении(Элемент)
	
	ТекСтрока = Элементы.РаспоряженияМНОПлановые.ТекущиеДанные;
	ТекСтрока.Срок = ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(ТекСтрока.ДатаВозврата, Дата);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция БанкНачалоВыбораНаСервере(Период, Организация)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	БанковскиеСчета.Банк КАК Банк
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(&Период, Организация = &Организация) КАК ОстаткиДенежныхСредствОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		|		ПО ОстаткиДенежныхСредствОстатки.РасчетныйСчет = БанковскиеСчета.Ссылка";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Период);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	
КонецФункции

&НаКлиенте
Процедура БанкНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = Новый СписокЗначений;
	ДанныеВыбора.ЗагрузитьЗначения(БанкНачалоВыбораНаСервере(ЭтаФорма.Дата, ЭтаФорма.Организация));
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьРаспоряжениеНаРазмещениеДепозита(Команда)
		
	ОткрытьФорму("Документ.Распоряжение.Форма.ФормаДокумента",, ЭтаФорма, ЭтаФорма.УникальныйИдентификатор);
	
