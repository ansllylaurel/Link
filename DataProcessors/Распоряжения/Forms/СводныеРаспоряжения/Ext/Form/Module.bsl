&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// начальное заполнение формы
	ЭтаФорма.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	ЭтаФорма.Валюта = Организация.ВалютаУчета;
	ЭтаФорма.Дата = ТекущаяДата();
	
	РаспоряженияНаРазмещениеДепозитов.Параметры.УстановитьЗначениеПараметра("СписокОтмеченных", ЭтаФорма.СписокОтмеченных);
	РаспоряженияНаРазмещениеДепозитов.Параметры.УстановитьЗначениеПараметра("Организация", ЭтаФорма.Организация);
	РаспоряженияНаРазмещениеДепозитов.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ЭтаФорма.Дата);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПлановыеИСозданныеРаспоряженияНаСервере()

	ЗаполнитьСозданныеРаспоряженияНаСервере();
	
	ЗаполнитьПлановыеРаспоряженияНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПлановыеРаспоряженияНаСервере()
	
	РаспоряженияМНОПлановые.ПолучитьЭлементы().Очистить();
	РаспоряженияМНОПлановыеНаСервере = РеквизитФормыВЗначение("РаспоряженияМНОПлановые");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Валюта", ЭтаФорма.Валюта);
	Запрос.УстановитьПараметр("ДатаВозврата", ЭтаФорма.ДатаВозврата);
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("ОрганизацияЮрЛицо", ЭтаФорма.Организация.ЮрФизЛицо);
	Запрос.УстановитьПараметр("ПериодКонец", Новый Граница(КонецДня(ЭтаФорма.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПериодНачало", Новый Граница(НачалоДня(ЭтаФорма.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПериодМНОНачало", Новый Граница(НачалоДня(ЭтаФорма.Дата), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Дата", ЭтаФорма.Дата);
	Запрос.УстановитьПараметр("Процент", ЭтаФорма.Процент);
	Запрос.УстановитьПараметр("Срок", ЭтаФорма.Срок);
	Запрос.УстановитьПараметр("БезОтбораПоБанку", (Не ЗначениеЗаполнено(ЭтаФорма.Банк)));
	Запрос.УстановитьПараметр("Банк", ЭтаФорма.Банк);

#Область ТЕКСТ_ЗАПРОСА	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БанковскиеСчета.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _РасчетныеСчета
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|ГДЕ
		|	НЕ &БезОтбораПоБанку
		|	И БанковскиеСчета.Банк = &Банк
		|	И БанковскиеСчета.Организация = &Организация
		|	И БанковскиеСчета.ЮрФизЛицо = &ОрганизацияЮрЛицо
		|	И БанковскиеСчета.Валюта = &Валюта
		|	И (БанковскиеСчета.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ БанковскиеСчета.ДатаЗакрытия > &Дата)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
		|ГДЕ
		|	НЕ &БезОтбораПоБанку
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДенежныеСредстваВКредитныхИнструментахОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|	УсловияКредитныхИнструментовСрезПоследних.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий КАК ДатаНачалаДействияУсловий,
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
		|	УсловияКредитныхИнструментовСрезПоследних.Действует КАК Действует,
		|	УсловияКредитныхИнструментовСрезПоследних.Период КАК Период,
		|	ВЫБОР
		|		КОГДА УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ММВБ_ДепозитыСЦК)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.МестаХранения.ММВБ_ДепозитыСЦК)
		|		ИНАЧЕ УсловияКредитныхИнструментовСрезПоследних.РасчетныйСчетВозвратаДенежныхСредств
		|	КОНЕЦ КАК МестоХранения
		|ПОМЕСТИТЬ _УсловияДепозитныхВкладов
		|ИЗ
		|	РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&ПериодКонец, Организация = &Организация) КАК УсловияКредитныхИнструментовСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.Остатки(
		|				&ПериодКонец,
		|				Организация = &Организация
		|					И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)) КАК ДенежныеСредстваВКредитныхИнструментахОстатки
		|		ПО (ДенежныеСредстваВКредитныхИнструментахОстатки.Организация = УсловияКредитныхИнструментовСрезПоследних.Организация)
		|			И (ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент)
		|			И (ДенежныеСредстваВКредитныхИнструментахОстатки.СуммаОстаток <> 0)
		|ГДЕ
		|	УсловияКредитныхИнструментовСрезПоследних.Действует
		|	И НЕ ВЫРАЗИТЬ(УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).ПометкаУдаления
		|	И ВЫРАЗИТЬ(УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Валюта = &Валюта
		|	И (&БезОтбораПоБанку
		|			ИЛИ ВЫРАЗИТЬ(УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Банк = &Банк)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_УсловияДепозитныхВкладов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_УсловияДепозитныхВкладов.МестоХранения КАК МестоХранения,
		|	_УсловияДепозитныхВкладов.КредитныйИнструмент КАК Депозит,
		|	_УсловияДепозитныхВкладов.ДатаПогашения КАК ДатаПогашения,
		|	_УсловияДепозитныхВкладов.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
		|	_УсловияДепозитныхВкладов.КредитныйИнструмент._НачальныйНоминал КАК Сумма
		|ПОМЕСТИТЬ _ЗакрытияДепозитныхВкладов
		|ИЗ
		|	_УсловияДепозитныхВкладов КАК _УсловияДепозитныхВкладов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_УсловияДепозитныхВкладов.КредитныйИнструмент КАК КредитныйИнструмент,
		|			МАКСИМУМ(_УсловияДепозитныхВкладов.Период) КАК Период,
		|			МАКСИМУМ(_УсловияДепозитныхВкладов.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
		|		ИЗ
		|			_УсловияДепозитныхВкладов КАК _УсловияДепозитныхВкладов
		|		ГДЕ
		|			_УсловияДепозитныхВкладов.Действует
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_УсловияДепозитныхВкладов.КредитныйИнструмент) КАК ВложенныйЗапрос
		|		ПО _УсловияДепозитныхВкладов.КредитныйИнструмент = ВложенныйЗапрос.КредитныйИнструмент
		|			И _УсловияДепозитныхВкладов.Период = ВложенныйЗапрос.Период
		|			И _УсловияДепозитныхВкладов.ДатаНачалаДействияУсловий = ВложенныйЗапрос.ДатаНачалаДействияУсловий
		|ГДЕ
		|	_УсловияДепозитныхВкладов.ДатаПогашения = &Дата";
#КонецОбласти
		
	Запрос.Выполнить();

	ВыборкаДепозитов = Запрос.МенеджерВременныхТаблиц.Таблицы["_ЗакрытияДепозитныхВкладов"].ПолучитьДанные().Выбрать();
	
	ТаблицаПроцентовПоДепозитам = Новый ТаблицаЗначений;
	
	ТаблицаПроцентовПоДепозитам.Колонки.Добавить("КредитныйИнструмент", Новый ОписаниеТипов("СправочникСсылка.ДепозитныеВклады"));
	ТаблицаПроцентовПоДепозитам.Колонки.Добавить("Проценты", Новый ОписаниеТипов("Число"));
	ТаблицаПроцентовПоДепозитам.Колонки.Добавить("Операция", Новый ОписаниеТипов("Строка"));
	ТаблицаПроцентовПоДепозитам.Колонки.Добавить("ДатаДенежногоПотока", Новый ОписаниеТипов("Дата"));
	
	Пока ВыборкаДепозитов.Следующий() Цикл
		
		Попытка
			РаботаСКоллекциями.ТаблицаЗначений_Дополнить(РаботаСКредитнымиИнструментами.ПолучитьПроцентыКредитныхИнструментовПоСчетуДоверительногоУправления(ВыборкаДепозитов.СчетДоверительногоУправления, ВыборкаДепозитов.ДатаПогашения,,,,,ВыборкаДепозитов.Депозит), ТаблицаПроцентовПоДепозитам);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());	
		КонецПопытки;
		
		Если Не ЗначениеЗаполнено(ВыборкаДепозитов.ПериодичностьВыплатыПроцентов) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить сумму процентов по депозиту [" + ВыборкаДепозитов.Депозит + "]. В условиях депозита не указана периодичность выплаты процентов.");
		КонецЕсли;
		
	КонецЦикла;        
	
	Запрос.УстановитьПараметр("ТаблицаПроцентовПоДепозитам", ТаблицаПроцентовПоДепозитам);
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаПроцентовПоДепозитам.КредитныйИнструмент КАК Депозит,
		|	ТаблицаПроцентовПоДепозитам.Проценты КАК Проценты,
		|	ТаблицаПроцентовПоДепозитам.Операция КАК Операция,
		|	ТаблицаПроцентовПоДепозитам.ДатаДенежногоПотока КАК ДатаДенежногоПотока
		|ПОМЕСТИТЬ _ПроцентыПоДепозитнымВкладам
		|ИЗ
		|	&ТаблицаПроцентовПоДепозитам КАК ТаблицаПроцентовПоДепозитам
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗакрытияДепозитныхВкладов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ЗакрытияДепозитныхВкладов.МестоХранения КАК МестоХранения,
		|	СУММА(_ЗакрытияДепозитныхВкладов.Сумма + ЕСТЬNULL(ВложенныйЗапрос.Сумма, 0)) КАК Сумма
		|ПОМЕСТИТЬ _ОжидаемыеПоступленияПоДепозитам
		|ИЗ
		|	_ЗакрытияДепозитныхВкладов КАК _ЗакрытияДепозитныхВкладов
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_ПроцентыПоДепозитнымВкладам.Депозит КАК Депозит,
		|			СУММА(_ПроцентыПоДепозитнымВкладам.Проценты) КАК Сумма
		|		ИЗ
		|			_ПроцентыПоДепозитнымВкладам КАК _ПроцентыПоДепозитнымВкладам
		|		ГДЕ
		|			_ПроцентыПоДепозитнымВкладам.ДатаДенежногоПотока = &Дата
		|			И ПОДСТРОКА(_ПроцентыПоДепозитнымВкладам.Операция, 1, 10) = ""Начисление""
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_ПроцентыПоДепозитнымВкладам.Депозит) КАК ВложенныйЗапрос
		|		ПО _ЗакрытияДепозитныхВкладов.Депозит = ВложенныйЗапрос.Депозит
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЗакрытияДепозитныхВкладов.СчетДоверительногоУправления,
		|	_ЗакрытияДепозитныхВкладов.МестоХранения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредствОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредствОстаткиИОбороты.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ММВБ_ДепозитыСЦК)
		|			ТОГДА ЕСТЬNULL((ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Значение КАК СТРОКА(20))) + "" (счет клиринга)"", """")
		|		ИНАЧЕ ОстаткиДенежныхСредствОстаткиИОбороты.РасчетныйСчет
		|	КОНЕЦ КАК МестоХранения,
		|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаНачальныйОстаток КАК НаНачалоДня,
		|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаКонечныйОстаток КАК НаКонецДня
		|ПОМЕСТИТЬ _ОстаткиДенежныхСредств
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.ОстаткиИОбороты(
		|			&ПериодНачало,
		|			&ПериодКонец,
		|			,
		|			,
		|			Организация = &Организация
		|				И Валюта = &Валюта
		|				И (&БезОтбораПоБанку
		|					ИЛИ РасчетныйСчет В
		|						(ВЫБРАТЬ
		|							_Т.Ссылка
		|						ИЗ
		|							_РасчетныеСчета КАК _Т))) КАК ОстаткиДенежныхСредствОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ПО ОстаткиДенежныхСредствОстаткиИОбороты.СчетДоверительногоУправления = ЗначенияДополнительныхСведений.Объект
		|			И (ЗначенияДополнительныхСведений.Свойство.Ключ = ""НомерСчетаКлирингаВНКО_НКЦ"")
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДенежныеСредстваМНООстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДенежныеСредстваМНООстаткиИОбороты.РасчетныйСчет КАК РасчетныйСчет,
		|	ДенежныеСредстваМНООстаткиИОбороты.СуммаНачальныйОстаток КАК МНОНаНачало,
		|	ДенежныеСредстваМНООстаткиИОбороты.СуммаКонечныйОстаток КАК МНОНаКонец
		|ПОМЕСТИТЬ _ОстаткиВМНО
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваМНО.ОстаткиИОбороты(
		|			&ПериодМНОНачало,
		|			&ПериодКонец,
		|			,
		|			,
		|			Организация = &Организация
		|				И (&БезОтбораПоБанку
		|					ИЛИ РасчетныйСчет В
		|						(ВЫБРАТЬ
		|							_Т.Ссылка
		|						ИЗ
		|							_РасчетныеСчета КАК _Т))) КАК ДенежныеСредстваМНООстаткиИОбороты
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СчетДоверительногоУправления,
		|	РасчетныйСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Распоряжение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Распоряжение.РасчетныйСчет КАК РасчетныйСчет,
		|	Распоряжение.ВидОперации КАК ВидОперации,
		|	СУММА(Распоряжение.Сумма) КАК Сумма
		|ПОМЕСТИТЬ _НеисполненныеРаспоряжения
		|ИЗ
		|	Документ.Распоряжение КАК Распоряжение
		|ГДЕ
