&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "РаспоряженияНаРазмещениеДепозитов.Обновить" Тогда
		РаспоряженияНаРазмещениеДепозитов.Параметры.УстановитьЗначениеПараметра("СписокОтмеченных", ЭтаФорма.СписокОтмеченных);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспоряженияНаРазмещениеДепозитовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "РаспоряженияНаРазмещениеДепозитовФлаг" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если Элементы.РаспоряженияНаРазмещениеДепозитов.ТекущиеДанные <> Неопределено Тогда
			
			ЭлементСпискаОтмеченных = ЭтаФорма.СписокОтмеченных.НайтиПоЗначению(Элементы.РаспоряженияНаРазмещениеДепозитов.ТекущиеДанные.Ссылка);
			
			Если ЭлементСпискаОтмеченных = Неопределено Тогда
				
				ЭтаФорма.СписокОтмеченных.Добавить(Элементы.РаспоряженияНаРазмещениеДепозитов.ТекущиеДанные.Ссылка);

			Иначе
				
				ЭтаФорма.СписокОтмеченных.Удалить(ЭлементСпискаОтмеченных);
				
			КонецЕсли;
		
			РаспоряженияНаРазмещениеДепозитов.Параметры.УстановитьЗначениеПараметра("СписокОтмеченных", ЭтаФорма.СписокОтмеченных);
			
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

