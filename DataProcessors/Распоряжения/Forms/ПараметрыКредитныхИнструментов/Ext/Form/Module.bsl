
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, "Организация, СчетДоверительногоУправления, Банк, Процент, Сумма, Валюта, ДатаРазмещения, ДатаВозврата");
	
	Если Параметры.Свойство("Биржевой") Тогда
		ЭтаФорма.Биржевой = Параметры.Биржевой;	
	КонецЕсли;
	
	Если Параметры.Свойство("РасчетныйСчетДепозита") Тогда
		ЭтаФорма.РасчетныйСчетДепозита = Параметры.РасчетныйСчетДепозита;	
	КонецЕсли;
	
	Если Параметры.Свойство("НомерПодтверждения") Тогда
		ЭтаФорма.НомерПодтверждения = Параметры.НомерПодтверждения;	
	КонецЕсли;
	
	Если Параметры.Свойство("ДатаПодтверждения") Тогда
		ЭтаФорма.ДатаПодтверждения = Параметры.ДатаПодтверждения;		
	КонецЕсли;
	
	Если Параметры.Свойство("УчетныйАктив") И ЗначениеЗаполнено(Параметры.УчетныйАктив) Тогда
		ЭтаФорма.УчетныйАктив = Параметры.УчетныйАктив;
	Иначе
		ЭтаФорма.УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДепозитныеВкладыПоАС;
	КонецЕсли;
	
	Если Параметры.Свойство("ДепозитЗаключенПоДоговору") Тогда
		ЭтаФорма.ДепозитЗаключенПоДоговору = Параметры.ДепозитЗаключенПоДоговору;	
	КонецЕсли;
	
	Если Не ЭтаФорма.ДепозитЗаключенПоДоговору И Не ЗначениеЗаполнено(ЭтаФорма.ДатаПодтверждения) Тогда
		ЭтаФорма.ДатаПодтверждения = ЭтаФорма.ДатаРазмещения;	
	КонецЕсли;
	
	ЗаполнитьПараметрыБиржевогоВклада(ЭтаФорма);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
		
	Если ИмяСобытия = "РасчетныйСчет.УстановитьЗначение" И ЗначениеЗаполнено(Параметр) Тогда
		
		ЭтаФорма.РасчетныйСчетДепозита = Параметр;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура БиржевойПриИзменении(Элемент)
	
	ЗаполнитьПараметрыБиржевогоВклада(ЭтаФорма);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетныйСчетСоздание(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыРасчетногоСчета = Новый Структура("Организация, Банк, Валюта, Договор");
	ЗаполнитьЗначенияСвойств(ПараметрыРасчетногоСчета, ЭтаФорма);
	ПараметрыРасчетногоСчета.Вставить("ЮрФизЛицо", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтаФорма.Организация, "ЮрФизЛицо"));
	ПараметрыРасчетногоСчета.Вставить("ДатаОткрытия", ЭтаФорма.ДатаРазмещения);
	ПараметрыРасчетногоСчета.Вставить("ВидБанковскогоСчета", ПредопределенноеЗначение("Перечисление.ВидыБанковскихСчетов.ДепозитныйСчет"));
	ПараметрыРасчетногоСчета.Вставить("ВидУправленияДовереннымиСредствами", ПредопределенноеЗначение("Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ"));
	
	Если Не ЭтаФорма.ДепозитЗаключенПоДоговору Тогда
		
		ПараметрыРасчетногоСчета.Вставить("Договор", ПолучитьГенСоглашениеПоДепозитнымВкладам(ЭтаФорма.Организация, ЭтаФорма.СчетДоверительногоУправления, ЭтаФорма.Банк, ЭтаФорма.ДатаРазмещения)); 
		
	КонецЕсли;
		
	ОткрытьФорму("Справочник.БанковскиеСчета.Форма.ФормаЭлемента", Новый Структура("ЗначенияРеквизитов", ПараметрыРасчетногоСчета), ЭтаФорма, ЭтаФорма.УникальныйИдентификатор);
		
КонецПроцедуры

&НаКлиенте
Процедура ДепозитЗаключенПоДоговоруПриИзменении(Элемент)
	
	Если Не ЭтаФорма.ДепозитЗаключенПоДоговору И Не ЗначениеЗаполнено(ЭтаФорма.ДатаПодтверждения) Тогда
		ЭтаФорма.ДатаПодтверждения = ЭтаФорма.ДатаРазмещения;	
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
		
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьДепозит(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаСоздатьДепозит");
	Попытка
		ВыполнитьСоздатьДепозит(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСоздатьДепозит(ПараметрыСессии)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		ПараметрыСессии.ТекстОшибки = "Ошибка проверки заполнения";
		Возврат;
	КонецЕсли;
	
	НовыеПараметрыДепозита = Новый Структура("РасчетныйСчетДепозита, НомерПодтверждения, ДатаПодтверждения, УчетныйАктив, Биржевой, МестоХранения, ДепозитЗаключенПоДоговору");
	
	ЗаполнитьЗначенияСвойств(НовыеПараметрыДепозита, ЭтаФорма);
	
	Закрыть(НовыеПараметрыДепозита);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	ЭлементыФормы = Форма.Элементы;
	
	ЭлементыФормы.МестоХранения.Видимость				= Форма.Биржевой;
	ЭлементыФормы.ДепозитЗаключенПоДоговору.Доступность	= Не Форма.Биржевой;
	ЭлементыФормы.Банк.Заголовок						= "Банк" + ?(Форма.Биржевой, " (ЦК)", "");
	ЭлементыФормы.РеквизитыПодтверждения.Видимость		= Не Форма.ДепозитЗаключенПоДоговору;
	
	Если Форма.ДепозитЗаключенПоДоговору Тогда
		
		ПутьКДаннымСкрываемыхПолей =
			Новый Структура("РеквизитыПодтверждения",
				РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("НомерПодтверждения, ДатаПодтверждения", ",", Истина, Истина));
		
		РаботаСФормамиКлиентСервер.ОчиститьЗначенияСкрытыхПолей(Форма, ПутьКДаннымСкрываемыхПолей);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьГенСоглашениеПоДепозитнымВкладам(Организация, СчетДоверительногоУправления, Банк, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК ГенСоглашение
		|ИЗ
		|	РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВЫРАЗИТЬ(Договор КАК Справочник.Договоры).ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ГенСоглашениеПоДепозитнымВкладам)
		|				И ВЫРАЗИТЬ(Договор КАК Справочник.Договоры).Контрагент = ВЫРАЗИТЬ(&Банк КАК Справочник.Банки).ЮрФизЛицо
		|				И НЕ ВЫРАЗИТЬ(Договор КАК Справочник.Договоры).ПометкаУдаления) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Дата, Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор = УсловияДоговоровОбщиеСрезПоследних.Договор
		|ГДЕ
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.Активный
		|	И (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &Дата)";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Банк", Банк);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 1 Тогда
		
		Пока Выборка.Следующий() Цикл
			Возврат Выборка.ГенСоглашение;
		КонецЦикла;
		
	ИначеЕсли Выборка.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствует ген. соглашение по депозитным вкладам с банком [" + Банк + "] для счета ДУ [" + СчетДоверительногоУправления + "].");	
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось однозначно определить ген. соглашение по депозитным вкладам с банком [" + Банк + "] для счета ДУ [" + СчетДоверительногоУправления + "]. Найдено [" + Выборка.Количество() + "] соглашения.");	
	КонецЕсли;	
			
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьПараметрыБиржевогоВклада(ЭтаФорма)

	ЭтаФорма.МестоХранения				= ?(ЭтаФорма.Биржевой, ПредопределенноеЗначение("Справочник.МестаХранения.ММВБ_ДепозитыСЦК"), Неопределено);
	ЭтаФорма.ДепозитЗаключенПоДоговору	= ЭтаФорма.Биржевой;
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
