#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ЭтаФорма.Параметры, "Организация, ВидПогашения, Облигация, Дата, ДатаФиксации");
	
	ВалютаНоминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Облигация, "ВалютаНоминала");
	
	Для каждого СтрокаПлановыеПогашения Из ЭтаФорма.Параметры.ПлановыеПогашения Цикл
		
		НоваяСтрокаПогашенияОблигации = ПогашенияОблигации.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрокаПогашенияОблигации, СтрокаПлановыеПогашения);
		
		НоваяСтрокаПогашенияОблигации.ВалютаОплаты = Организация.ВалютаУчета;
	
		РассчитатьСуммыВВалютеОплатыНаСервере(ПогашенияОблигации.Индекс(НоваяСтрокаПогашенияОблигации));
				
	КонецЦикла;
	
	ТаблицаДанных = РегистрыСведений.НастройкиУчетаДоходовПоЦеннымБумагам.ПолучитьЗначенияНастроекУчетаДоходовПоЦеннымБумагам(РеквизитФормыВЗначение("ПогашенияОблигации"), ЭтаФорма.Дата, ЭтаФорма.Организация);
	
	ЗначениеВРеквизитФормы(ТаблицаДанных, "ПогашенияОблигации");

	ОбновитьНадписьПогашенияОблигацииИтого(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если НЕ ЗавершениеРаботы И Не ЭтаФорма.ПовторноеЗакрытие Тогда
		
		Отказ = Истина;
		
		ЭтаФорма.ПовторноеЗакрытие = Истина;
		
		ЭтаФорма.Закрыть(
			?(ЭтаФорма.СозданныеДокументы.Количество() = 0, Неопределено, ЭтаФорма.СозданныеДокументы.ВыгрузитьЗначения()));
		
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область События_таблицы_формы

&НаКлиенте
Процедура ПогашенияОблигацииОплатаЧерезБрокераПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПогашенияОблигации.ТекущиеДанные;
	
	Если Не ТекущиеДанные.ОплатаЧерезБрокера Тогда
		ТекущиеДанные.Брокер = Неопределено;
	КонецЕсли;
	
	ПогашенияОблигацииБрокерПриИзменении(ТекущиеДанные.ОплатаЧерезБрокера);
	
КонецПроцедуры

&НаКлиенте
Процедура ПогашенияОблигацииБрокерПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПогашенияОблигации.ТекущиеДанные;
	
	ТекущиеДанные.ДетализацияПоРасчетномуСчету = РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(
		Новый Структура("Дата, Организация, Брокер", ЭтаФорма.Дата, ЭтаФорма.Организация, ТекущиеДанные.Брокер));
	
	Если Не ТекущиеДанные.ДетализацияПоРасчетномуСчету Тогда
		ТекущиеДанные.РасчетныйСчет = Неопределено;
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура ПогашенияОблигацииРасчетныйСчетПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПогашенияОблигации.ТекущиеДанные;
	                 
	Если ЗначениеЗаполнено(ТекущиеДанные.РасчетныйСчет) Тогда		
		НоваяВалюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущиеДанные.РасчетныйСчет, "Валюта");
		РассчитатьСуммыВВалютеОплатыНаСервере(ПогашенияОблигации.Индекс(ТекущиеДанные), НоваяВалюта);
		ТекущиеДанные.ВалютаОплаты = НоваяВалюта;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПогашенияОблигацииПриИзменении(Элемент)
	
	ОбновитьНадписьПогашенияОблигацииИтого(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПогашенияОблигацииВалютаОплатыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ПогашенияОблигации.ТекущиеДанные;
	РаботаСДокументамиКлиент.СверитьВыбранноеЗначениеВалютыСВалютойРасчетногоСчета(ВыбранноеЗначение, ТекущиеДанные.ВалютаОплаты, ТекущиеДанные.РасчетныйСчет);
	
	РассчитатьСуммыВВалютеОплатыНаСервере(ПогашенияОблигации.Индекс(ТекущиеДанные), ВыбранноеЗначение);
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаСоздатьДокументы(Команда)
	
	Если СоздатьПогашенияОблигацииНаСервере() Тогда
		ВсеДокументыСозданы = ЭтаФорма.СозданныеДокументы.Количество() = ЭтаФорма.ПогашенияОблигации.Количество();
		Элементы.ФормаКомандаСоздатьДокументы.Доступность = НЕ ВсеДокументыСозданы;
		ЭтаФорма.ПовторноеЗакрытие = ВсеДокументыСозданы;
		ЭтаФорма.Закрыть(Истина);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьНадписьПогашенияОблигацииИтого(Форма)
	
	ТекстНадписи = "";
	
	Если Форма.ПогашенияОблигации.Количество() > 0 Тогда
		
		ИтогоКоличество  = 0;
		ИтогоСумма       = 0;
		ИтогоСуммаКупона = 0;
		
		Для каждого СтрокаПогашенияОблигации Из Форма.ПогашенияОблигации Цикл
			ИтогоКоличество  = ИтогоКоличество + СтрокаПогашенияОблигации.Количество;
			ИтогоСумма       = ИтогоСумма + СтрокаПогашенияОблигации.Сумма;
			ИтогоСуммаКупона = ИтогоСуммаКупона + СтрокаПогашенияОблигации.СуммаКупона;
		КонецЦикла;
		
		ТекстНадписи = "Итого " + ИтогоКоличество + " " + РаботаСКорзинойЦенныхБумагКлиентСервер.ФормаМножественногоЧислаЦеннойБумаги(ИтогоКоличество, ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Облигации"))
			+ " на сумму " + ИтогоСумма + ?(ИтогоСуммаКупона > 0, ", сумма купона " + ИтогоСуммаКупона, "");
		
	КонецЕсли;
	
	Форма.Элементы.НадписьПогашенияОблигацииИтого.Заголовок = ТекстНадписи;
	
КонецПроцедуры // ОбновитьНадписьПогашенияОблигацииИтого

&НаСервере
Функция СоздатьПогашенияОблигацииНаСервере()
	
	ЕстьОшибки = Ложь;
	
	// проверим заполнение на основе имеющихся данных
	Для НомСтр = 0 По ЭтаФорма.ПогашенияОблигации.Количество() - 1 Цикл
		
		СтрокаПогашенияОблигации = ЭтаФорма.ПогашенияОблигации[НомСтр];
		
		Если СтрокаПогашенияОблигации.Количество = 0 Тогда
			Сообщить("Не заполнено поле ""Количество"" в строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если СтрокаПогашенияОблигации.Сумма = 0 Тогда
			Сообщить("Не заполнено поле ""Сумма"" в строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если СтрокаПогашенияОблигации.ОплатаЧерезБрокера И Не ЗначениеЗаполнено(СтрокаПогашенияОблигации.Брокер) Тогда
			Сообщить("Не заполнено поле ""Брокер"" в строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если СтрокаПогашенияОблигации.ДетализацияПоРасчетномуСчету И Не ЗначениеЗаполнено(СтрокаПогашенияОблигации.РасчетныйСчет) Тогда
			Сообщить("Не заполнено поле ""Расчетный счет"" в строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьОшибки Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// создадим документ
	Для НомСтр = 0 По ЭтаФорма.ПогашенияОблигации.Количество() - 1 Цикл
		
		СтрокаПогашенияОблигации = ЭтаФорма.ПогашенияОблигации[НомСтр];
		
		Если СтрокаПогашенияОблигации.ДокументСоздан Тогда
		
			Продолжить;
		
		КонецЕсли;
		
		ПогашениеЦеннойБумаги = Документы.ПогашениеЦеннойБумаги.СоздатьДокумент();
		ПогашениеЦеннойБумаги.Рынок        = Перечисления.РынкиЦенныхБумаг.Облигации;
		ПогашениеЦеннойБумаги.ЦеннаяБумага = ЭтаФорма.Облигация;
		
		ЗаполнитьЗначенияСвойств(ПогашениеЦеннойБумаги, ЭтаФорма);
		ЗаполнитьЗначенияСвойств(ПогашениеЦеннойБумаги, СтрокаПогашенияОблигации);
		
		ПогашениеЦеннойБумаги.Ответственный = РаботаСПользователями.ТекущийПользователь();
	
		Если Не ПогашениеЦеннойБумаги.ПроверитьЗаполнение() Тогда
			Сообщить("Не удалось создать погашение купона по строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецЕсли;
	
		Попытка
			ПогашениеЦеннойБумаги.Записать(РежимЗаписиДокумента.Проведение);
			Сообщить("Создан документ " + ПогашениеЦеннойБумаги);
			ЭтаФорма.СозданныеДокументы.Добавить(ПогашениеЦеннойБумаги.Ссылка);
			СтрокаПогашенияОблигации.ДокументСоздан = Истина;
		Исключение
			Сообщить("Не удалось создать погашение купона по строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецПопытки;
	
	КонецЦикла;
	
	Возврат Не ЕстьОшибки;
	
КонецФункции // СоздатьПогашенияОблигацииНаСервере

&НаСервере
Процедура РассчитатьСуммыВВалютеОплатыНаСервере(ИндексСтроки, НоваяВалютаОплаты = Неопределено)
	
	СтрокаПогашенияОблигации = ПогашенияОблигации.Получить(ИндексСтроки);
	
	Если НоваяВалютаОплаты = СтрокаПогашенияОблигации.ВалютаОплаты Тогда
		Возврат;
	КонецЕсли;
		
	Коэффициент = РаботаСВалютами.ПересчетСуммыВВалюте(1, ?(НоваяВалютаОплаты = Неопределено, ВалютаНоминала, СтрокаПогашенияОблигации.ВалютаОплаты), Дата, ?(НоваяВалютаОплаты = Неопределено, СтрокаПогашенияОблигации.ВалютаОплаты, НоваяВалютаОплаты), Дата); 
	
	СтрокаПогашенияОблигации.Сумма 			= СтрокаПогашенияОблигации.Сумма * Коэффициент;
	СтрокаПогашенияОблигации.СуммаКупона 	= СтрокаПогашенияОблигации.СуммаКупона * Коэффициент;
	
КонецПроцедуры

#КонецОбласти