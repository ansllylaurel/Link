//События СЧА
&НаКлиенте
Процедура ФормированияСЧАВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ДатаЗначения		= ЭтаФорма.Элементы.ФормированияСЧА.ТекущиеДанные.ДатаЗначения;
	ЗначениеНастройки	= ЭтаФорма.Элементы.ФормированияСЧА.ТекущиеДанные.ЗначениеНастройки;
	ИмяЗначения			= ЭтаФорма.Элементы.ФормированияСЧА.ТекущиеДанные.ИмяНастройки;
	
	Если ИмяЗначения = "" Тогда
		Возврат;
	КонецЕсли;
	
	ТипИСинонимНастройки = ОпределитьТипИСинонимНастройкиНаСервере(ИмяЗначения, "НастройкиФормированияСЧА");
	
	НовыеДанныеНастройки = ОткрытьФормуМодально("Обработка.НастройкаУчета.Форма.РедактированиеНастройкиУчета",
		Новый Структура("ДатаЗначения,ПредставлениеНастройки,ЗначениеНастройки,ТипЗначения,СчетДоверительногоУправления,СчетаКлиента",
			ДатаЗначения, ТипИСинонимНастройки.СинонимНастройки, ЗначениеНастройки, ТипИСинонимНастройки.ТипЗначения, 
			СчетДоверительногоУправления, ЭтаФорма.СчетаКлиента), ЭтаФорма);
			
	Если ЗначениеЗаполнено(НовыеДанныеНастройки) Тогда
		НовыеДанныеНастройки.СчетаКлиента.Добавить(ЭтаФорма.СчетДоверительногоУправления, , Истина);
		Если УстановитьЗначениеНастройкиФормированияСЧАНаСервере(НовыеДанныеНастройки.ДатаЗначения, 
				ИмяЗначения, 
				НовыеДанныеНастройки.ЗначениеНастройки,
				Неопределено,
				НовыеДанныеНастройки.СчетаКлиента) Тогда
				
			КлючиРазвернутыхСтрок = Неопределено;
			РаботаСФормамиКлиент.ПолучитьКлючиРазвернутыхСтрокДерева(ЭтаФорма.ФормированияСЧА,  ЭтаФорма.Элементы.ФормированияСЧА,, КлючиРазвернутыхСтрок);
			
			ОбновитьНастройкиФормированияСЧАНаСервере();
			
			РаботаСФормамиКлиент.ВосстановитьРазвернутыеСтрокиДереваПоКлючу(ЭтаФорма.ФормированияСЧА,  ЭтаФорма.Элементы.ФормированияСЧА,, КлючиРазвернутыхСтрок);
			РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.ФормированияСЧА,  ЭтаФорма.Элементы.ФормированияСЧА,, ИмяЗначения);
			
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ФормированияСЧАПоВидамЗадолженностиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ИмяЗначения = ЭтаФорма.Элементы.ФормированияСЧАПоВидамЗадолженности.ТекущиеДанные.ИмяНастройки;
