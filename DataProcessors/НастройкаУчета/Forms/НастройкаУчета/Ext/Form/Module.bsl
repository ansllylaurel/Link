&НаКлиенте
Процедура АктивыЕПСПередРазворачиванием(Элемент, Строка, Отказ)
	
	Если ЭтаФорма.ФлагРазворачивания Тогда
		Возврат;
	Иначе
		МассивГрупп = Новый Массив();
		
		ДанныеСтроки = ЭтаФорма.Элементы.АктивыЕПС.ДанныеСтроки(Строка);
		Для каждого Элемент Из ДанныеСтроки.ПолучитьЭлементы() Цикл
			Если Элемент.Картинка = 6 Тогда // папка
				МассивГрупп.Добавить(Элемент.ПолучитьИдентификатор());	
			КонецЕсли;
		КонецЦикла;
		
		Если МассивГрупп.Количество() > 0 Тогда
			
			ЭтаФорма.ФлагРазворачивания = Истина;
			
			Для каждого СтрокаМассиваГрупп Из МассивГрупп Цикл
				ЭтаФорма.Элементы.АктивыЕПС.Развернуть(СтрокаМассиваГрупп, Ложь);
			КонецЦикла;
			
			ЭтаФорма.ФлагРазворачивания = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//События комиссия
&НаКлиенте
Процедура КомиссияВыбор(ВидУчета)
	
	ИмяТекущегоЭлементаИРеквизита = ОпределитьИмяТекущегоЭлементаИРеквизита();
	
	Данные = ЭтаФорма[ИмяТекущегоЭлементаИРеквизита];
	Элемент = ЭтаФорма.Элементы[ИмяТекущегоЭлементаИРеквизита];
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	ИмяЗначения = ТекущиеДанные.ИмяНастройки;
	Если ИмяЗначения = "" Тогда
		Возврат 
	КонецЕсли;
	
	ДатаЗначения = ТекущиеДанные.ДатаЗначения;
	ЗначениеНастройки = ТекущиеДанные.ЗначениеНастройки;
	ВидЗадолженности = ТекущиеДанные.ВидЗадолженности;
	ВидЗадолженностиПредставление = ТекущиеДанные.ПолучитьРодителя().ПредставлениеНастройки;
	
	ТипИСинонимНастройки = ОпределитьТипИСинонимНастройкиНаСервере(ИмяЗначения, "НастройкиУчетаКомиссии");
	
	ПредставлениеНастройки = Строка(ВидУчета) + ": " + ВидЗадолженностиПредставление + " — " + ТипИСинонимНастройки.СинонимНастройки;
	
	НовыеДанныеНастройки = ОткрытьФормуМодально("Обработка.НастройкаУчета.Форма.РедактированиеНастройкиУчета",
		Новый Структура("ДатаЗначения,ПредставлениеНастройки,ЗначениеНастройки,ТипЗначения,СчетДоверительногоУправления,СчетаКлиента",
			ДатаЗначения, ПредставлениеНастройки, ЗначениеНастройки, ТипИСинонимНастройки.ТипЗначения, 
			СчетДоверительногоУправления, ЭтаФорма.СчетаКлиента), ЭтаФорма);
			
	Если ЗначениеЗаполнено(НовыеДанныеНастройки) Тогда
		ИзмениласьНастройкаДляРедактируемогоДоговора = УстановитьЗначениеНастройкиКомиссииНаСервере(ЭтаФорма.СчетДоверительногоУправления, НовыеДанныеНастройки.ДатаЗначения, ИмяЗначения, НовыеДанныеНастройки.ЗначениеНастройки, ВидЗадолженности, ВидУчета);
			
		Для каждого СтрокаСчетаКлиента Из НовыеДанныеНастройки.СчетаКлиента Цикл
			Если СтрокаСчетаКлиента.Пометка Тогда
				ИзмениласьНастройка = УстановитьЗначениеНастройкиКомиссииНаСервере(СтрокаСчетаКлиента.Значение, НовыеДанныеНастройки.ДатаЗначения, ИмяЗначения, НовыеДанныеНастройки.ЗначениеНастройки, ВидЗадолженности, ВидУчета);
				Если НЕ ИзмениласьНастройкаДляРедактируемогоДоговора И ИзмениласьНастройка Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Изменено значение настройки для счета ДУ: %1", СтрокаСчетаКлиента.Значение));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		КлючиРазвернутыхСтрок = Неопределено;
		РаботаСФормамиКлиент.ПолучитьКлючиРазвернутыхСтрокДерева(Данные, Элемент,, КлючиРазвернутыхСтрок);
		
		ОбновитьНастройкиКомиссииПоРегиструНаСервере(ВидУчета);
		
		РаботаСФормамиКлиент.ВосстановитьРазвернутыеСтрокиДереваПоКлючу(Данные, Элемент,, КлючиРазвернутыхСтрок);
		РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(Данные, Элемент,, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидЗадолженности, "Код") + ИмяЗначения);
		
	КонецЕсли;
	
КонецПроцедуры

