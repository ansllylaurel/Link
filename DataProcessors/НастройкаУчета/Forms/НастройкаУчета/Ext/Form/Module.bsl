// Вспомогательные
&НаКлиенте
Функция ОпределитьИмяТекущегоЭлементаИРеквизита()

	Если ЭтаФорма.Элементы.НастройкиУчета.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиУчетаОбщие Тогда
		Возврат "Общие";
	ИначеЕсли ЭтаФорма.Элементы.НастройкиУчета.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиПоВидуУчета Тогда
		Если ЭтаФорма.Элементы.НастройкиПоВидуУчетаПоРегистрам.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиБухгалтерскийУчетСтраница Тогда
			Возврат "БухгалтерскийУчетНастройки";
		ИначеЕсли ЭтаФорма.Элементы.НастройкиПоВидуУчетаПоРегистрам.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиНалоговыйУчетСтраница Тогда
			Возврат "НалоговыйУчет";
		ИначеЕсли ЭтаФорма.Элементы.НастройкиПоВидуУчетаПоРегистрам.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиЕПССтраница Тогда
			Возврат "ЕПС";
		КонецЕсли;
	ИначеЕсли ЭтаФорма.Элементы.НастройкиУчета.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиУчетаАктивов Тогда
		Если ЭтаФорма.Элементы.НастройкиУчетаАктивовПоРегистрам.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиУчетаАктивовБухгалтерскийУчет Тогда
			Возврат "АктивыБухгалтерскийУчет";
		ИначеЕсли ЭтаФорма.Элементы.НастройкиУчетаАктивовПоРегистрам.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиУчетаАктивовНалоговыйУчет Тогда
			Возврат "АктивыНалоговыйУчет";
		ИначеЕсли ЭтаФорма.Элементы.НастройкиУчетаАктивовПоРегистрам.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиУчетаКлассификацииПоСрочностиЕПС Тогда
			Возврат "КлассификацияПоСрочностиЕПС";
		ИначеЕсли ЭтаФорма.Элементы.НастройкиУчетаАктивовПоРегистрам.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиУчетаАктивовЕПС Тогда
			Возврат "АктивыЕПС";
		КонецЕсли;
	ИначеЕсли ЭтаФорма.Элементы.НастройкиУчета.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиУчетаКомиссии Тогда
		Если ЭтаФорма.Элементы.НастройкиКомиссииПоРегистрам.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиКомиссииБухгалтерскийУчет Тогда
			Возврат "КомиссияБухгалтерскийУчет";
		ИначеЕсли ЭтаФорма.Элементы.НастройкиКомиссииПоРегистрам.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиКомиссииНалоговыйУчет Тогда
			Возврат "КомиссияНалоговыйУчет";
		ИначеЕсли ЭтаФорма.Элементы.НастройкиКомиссииПоРегистрам.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиКомиссииЕПС Тогда
			Возврат "КомиссияЕПС";
		КонецЕсли;
	ИначеЕсли ЭтаФорма.Элементы.НастройкиУчета.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиЗакрытияСчетов Тогда
		Если ЭтаФорма.Элементы.НастройкиЗакрытияСчетовПоРегистрам.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиЗакрытияСчетовБухгалтерскийУчет Тогда
			Возврат "ЗакрытияБухгалтерскийУчет";
		ИначеЕсли ЭтаФорма.Элементы.НастройкиЗакрытияСчетовПоРегистрам.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиЗакрытияСчетовНалоговыйУчет Тогда
			Возврат "ЗакрытияНалоговыйУчет";
		ИначеЕсли ЭтаФорма.Элементы.НастройкиЗакрытияСчетовПоРегистрам.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиЗакрытияЕПС Тогда
			Возврат "ЗакрытияЕПС";
		КонецЕсли;
	ИначеЕсли ЭтаФорма.Элементы.НастройкиУчета.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиФормированияСЧА Тогда
		Если ЭтаФорма.Элементы.НастройкиФормированияСЧАПоРегистрам.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиФормированияСЧАСтраница Тогда
			Возврат "ФормированияСЧА";
		ИначеЕсли ЭтаФорма.Элементы.НастройкиФормированияСЧАПоРегистрам.ТекущаяСтраница = ЭтаФорма.Элементы.НастройкиФормированияСЧАПоВидамЗадолженностиСтраница Тогда
			Возврат "ФормированияСЧАПоВидамЗадолженности";
		КонецЕсли;
	КонецЕсли;
	
	Возврат "";

КонецФункции

&НаСервере
Функция ОпределитьИконкуНаСервере(ТипРеквизита)

	МетаданныеРеквизита = Метаданные.НайтиПоТипу(ТипРеквизита.Типы()[0]);
	
	Если ТипРеквизита.Типы()[0] = Тип("ПланСчетовСсылка.Основной") Тогда
		Возврат 0;
	ИначеЕсли ТипРеквизита.Типы()[0] = Тип("Булево") Тогда
		Возврат 1;
	ИначеЕсли ТипРеквизита.Типы()[0] = Тип("Число") Тогда
		Возврат 7;
	ИначеЕсли ТипРеквизита.Типы()[0] = Тип("Дата") Тогда
		Возврат 8;
	ИначеЕсли ТипРеквизита.Типы()[0] = Тип("Строка") Тогда
		Возврат 3;
	ИначеЕсли Метаданные.Перечисления.Содержит(МетаданныеРеквизита) Тогда
		Возврат 2;
	ИначеЕсли Метаданные.Документы.Содержит(МетаданныеРеквизита) Тогда
		Возврат 3;
	КонецЕсли;

КонецФункции

&НаСервере
Функция ОпределитьТипИСинонимНастройкиНаСервере(ИмяНастройки, ИмяРегистра)
	
	Для каждого Ресурс Из Метаданные.РегистрыСведений[ИмяРегистра].Ресурсы Цикл
		Если Ресурс.Имя = ИмяНастройки Тогда
			Возврат Новый Структура("ТипЗначения,СинонимНастройки", Ресурс.Тип, Ресурс.Синоним);
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура РазвернутьДерево(Элемент, ЭлементФормы)

	МассивСтрокПапок = ПолучитьСтрокиПапок(Элемент);
	
	Для каждого СтрокаМассиваПапок Из МассивСтрокПапок Цикл
		ЭлементФормы.Развернуть(СтрокаМассиваПапок, Ложь);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ПолучитьСтрокиПапок(Элемент)

	МассивСтрок = Новый Массив();
	
	Для каждого ПодчиненныйЭлемент Из Элемент.ПолучитьЭлементы() Цикл
		Если ПодчиненныйЭлемент.Картинка = 6 Тогда
			МассивСтрок.Добавить(ПодчиненныйЭлемент.ПолучитьИдентификатор());
			РаботаСКоллекциями.ДополнитьМассив(МассивСтрок, ПолучитьСтрокиПапок(ПодчиненныйЭлемент));
		КонецЕсли;	
	КонецЦикла;

	Возврат МассивСтрок;
	
КонецФункции

&НаКлиенте
Процедура СвернутьДерево(Элемент, ЭлементФормы)
	
	МассивСтрокПапок = ПолучитьСтрокиПапок(Элемент);
	
	Для каждого СтрокаМассиваПапок Из МассивСтрокПапок Цикл
		ЭлементФормы.Свернуть(СтрокаМассиваПапок);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция НастройкаДляДругихДоговоровНаСервере(ИмяНастройки, ЗначениеНастройки, НастройкиДругихДоговоров, УчетныйАктив = Неопределено, ВидЗадолженности = Неопределено, ВариантЗакрытия = Неопределено)

	ЗначенияНастройки = Новый Соответствие();
	
	Если УчетныйАктив <> Неопределено Тогда
		СтрокиНастроек = НастройкиДругихДоговоров.НайтиСтроки(Новый Структура("УчетныйАктив", УчетныйАктив));
	ИначеЕсли ВидЗадолженности <> Неопределено Тогда
		СтрокиНастроек = НастройкиДругихДоговоров.НайтиСтроки(Новый Структура("ВидЗадолженности", ВидЗадолженности));
	ИначеЕсли ВариантЗакрытия <> Неопределено Тогда
		СтрокиНастроек = НастройкиДругихДоговоров.НайтиСтроки(Новый Структура("ВариантЗакрытияБухгалтерскихСчетов", ВариантЗакрытия));
	Иначе
		СтрокиНастроек = НастройкиДругихДоговоров.НайтиСтроки(Новый Структура("Организация", ЭтаФорма.Организация));
	КонецЕсли;
	
	Для каждого СтрокаНастройкиДругихДоговоров Из СтрокиНастроек Цикл
		
		ЗначениеНастройкиДругогоДоговора = СтрокаНастройкиДругихДоговоров[ИмяНастройки];
		
		Если ЗначениеНастройкиДругогоДоговора = ЗначениеНастройки Тогда
			Продолжить;
		КонецЕсли;	
		
		СтрокаСчетаДУ = ЗначенияНастройки.Получить(ЗначениеНастройкиДругогоДоговора);
		Если СтрокаСчетаДУ = Неопределено Тогда
			СтрокаСчетаДУ = "";
		КонецЕсли;
		СтрокаСчетаДУ = СтрокаСчетаДУ + Строка(СтрокаНастройкиДругихДоговоров.СчетДоверительногоУправления) + ",";
		
		ЗначенияНастройки.Вставить(ЗначениеНастройкиДругогоДоговора, СтрокаСчетаДУ);
		
	КонецЦикла;

	Если ЗначенияНастройки.Количество() = 0 Тогда
		Возврат "<Совпадает у всех договоров>"
	Иначе
		
		СтрокаНастройкаДляДругихДоговоров = "";
		Для каждого СтрокаЗначенияНастройки Из ЗначенияНастройки Цикл
			СтрокаНастройкаДляДругихДоговоров = Строка(СтрокаЗначенияНастройки.Ключ) + ": (" + Лев(СтрокаЗначенияНастройки.Значение, СтрДлина(СтрокаЗначенияНастройки.Значение) - 1) + ");";
		КонецЦикла;
		СтрокаНастройкаДляДругихДоговоров = Лев(СтрокаНастройкаДляДругихДоговоров, СтрДлина(СтрокаНастройкаДляДругихДоговоров) - 1);
		
		Возврат СтрокаНастройкаДляДругихДоговоров;
		
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДоступенРесурсНаСервере(ИмяРесурса, УчетныйАктив, ВидУчета, АдресТаблицыНастроекВидимости)
	
	НастройкиВидимости = ПолучитьИзВременногоХранилища(АдресТаблицыНастроекВидимости);
	Отбор = Новый Структура("Настройка, УчетныйАктив, ВидУчета", ИмяРесурса, УчетныйАктив, ВидУчета);
	Возврат НастройкиВидимости.НайтиСтроки(Отбор).Количество() = 0;
	
КонецФункции 

&НаСервере
Процедура ЗаполнитьНастройкиВидимостиНаСервере()

	Макет = РегистрыСведений.НастройкиУчетаАктивов.ПолучитьМакет("НастройкиВидимости");
	НастройкиВидимости = Новый ТаблицаЗначений;
	НастройкиВидимости.Колонки.Добавить("Настройка", 	Новый ОписаниеТипов("Строка"));
	НастройкиВидимости.Колонки.Добавить("УчетныйАктив", Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивы"));
	НастройкиВидимости.Колонки.Добавить("ВидУчета", 	Новый ОписаниеТипов("ПеречислениеСсылка.ВидыУчета"));
	
	Для каждого Область Из Макет.Области Цикл 
		Для ТекСтрока = Область.Верх По Область.Низ Цикл
			ИмяУчетногоАктива = Макет.Область(ТекСтрока, 1, ТекСтрока, 1).Текст;
			Для ТекКолонка = 2 По 5 Цикл
				Если Макет.Область(ТекСтрока, ТекКолонка, ТекСтрока, ТекКолонка).Текст = "-" Тогда
					
					ИмяВидаУчета = Макет.Область(1, ТекКолонка, 1, ТекКолонка).Текст;
					НоваяСтрока = НастройкиВидимости.Добавить();
					НоваяСтрока.Настройка 		= Область.Имя;
					НоваяСтрока.УчетныйАктив 	= Справочники.УчетныеАктивы[ИмяУчетногоАктива];
					НоваяСтрока.ВидУчета 		= Перечисления.ВидыУчета[ИмяВидаУчета];
					
				КонецЕсли; 
			КонецЦикла; 
		КонецЦикла; 
	КонецЦикла;
	
	АдресТаблицыНастроекВидимости = ПоместитьВоВременноеХранилище(НастройкиВидимости, ЭтаФорма.УникальныйИдентификатор);

КонецПроцедуры

&НаСервере
Функция ПроверитьВелсяЛиУчетНаСервере(ВидУчета)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаОбщие.ВестиБухгалтерскийУчет КАК ВестиБухгалтерскийУчет
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие КАК НастройкиУчетаОбщие
		|ГДЕ
		|	НастройкиУчетаОбщие.ВестиБухгалтерскийУчет
		|	И НастройкиУчетаОбщие.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И НастройкиУчетаОбщие.Организация = &Организация";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВестиБухгалтерскийУчет",  "Вести" + РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ВидУчета));
	
	Запрос.УстановитьПараметр("Организация", Этаформа.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Этаформа.СчетДоверительногоУправления);
	
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

&НаСервере
Процедура УстановитьВидимостьВЗависимостиОтВедущихсяУчетовНаСервере()

	ВелсяБУ = ПроверитьВелсяЛиУчетНаСервере(Перечисления.ВидыУчета.БухгалтерскийУчет);
	ВелсяНУ = ПроверитьВелсяЛиУчетНаСервере(Перечисления.ВидыУчета.НалоговыйУчет);
	ВелсяЕПС = ПроверитьВелсяЛиУчетНаСервере(Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	ЕстьАктивыПоАС = ВелсяЕПС ИЛИ ЭтаФорма.ЕстьВозможностьУчитыватьЦенныеБумагиПоАмортизированнойСтоимости;
	ВелсяСУ = Ложь;
	
	ЭтаФорма.Элементы.НастройкиБухгалтерскийУчетСтраница.Видимость = ВелсяБУ;
	ЭтаФорма.Элементы.НастройкиНалоговыйУчетСтраница.Видимость = ВелсяНУ;
	ЭтаФорма.Элементы.НастройкиЕПССтраница.Видимость = ЕстьАктивыПоАС;
	
	ЭтаФорма.Элементы.НастройкиУчетаАктивовБухгалтерскийУчет.Видимость = ВелсяБУ;
	ЭтаФорма.Элементы.НастройкиУчетаАктивовНалоговыйУчет.Видимость = ВелсяНУ;
	ЭтаФорма.Элементы.НастройкиУчетаКлассификацииПоСрочностиЕПС.Видимость = ЕстьАктивыПоАС;
	ЭтаФорма.Элементы.НастройкиУчетаАктивовЕПС.Видимость = ЕстьАктивыПоАС;
	
	ЭтаФорма.Элементы.НастройкиКомиссииБухгалтерскийУчет.Видимость = ВелсяБУ;
	ЭтаФорма.Элементы.НастройкиКомиссииНалоговыйУчет.Видимость = ВелсяНУ;
	ЭтаФорма.Элементы.НастройкиКомиссииЕПС.Видимость = ЕстьАктивыПоАС;
	
	ЭтаФорма.Элементы.НастройкиЗакрытияСчетовБухгалтерскийУчет.Видимость = ВелсяБУ;
	ЭтаФорма.Элементы.НастройкиЗакрытияСчетовНалоговыйУчет.Видимость = ВелсяНУ;
	ЭтаФорма.Элементы.НастройкиЗакрытияЕПС.Видимость = ЕстьАктивыПоАС;
	
	Если НЕ ВелсяЕПС И ЕстьАктивыПоАС Тогда
	
		ЭтаФорма.Элементы.НастройкиУчетаАктивовЕПС.Заголовок = "Активы по АС";
		ЭтаФорма.Элементы.НастройкиЕПССтраница.Заголовок = "Активы по АС";
	
	КонецЕсли;
	
	ЭтаФорма.Элементы.ОбщиеДругиеДоговора.Видимость = (СчетаКлиента.Количество() > 0);
	ЭтаФорма.Элементы.БухгалтерскийУчетНастройкиДругиеДоговора.Видимость = (СчетаКлиента.Количество() > 0);
	ЭтаФорма.Элементы.НалоговыйУчетДругиеДоговора.Видимость = (СчетаКлиента.Количество() > 0);
	ЭтаФорма.Элементы.ЕПСДругиеДоговора.Видимость = (СчетаКлиента.Количество() > 0);
	
	ЭтаФорма.Элементы.АктивыБухгалтерскийУчетДругиеДоговора.Видимость = (СчетаКлиента.Количество() > 0);
	ЭтаФорма.Элементы.АктивыНалоговыйУчетДругиеДоговора.Видимость = (СчетаКлиента.Количество() > 0);
	ЭтаФорма.Элементы.КлассификацияПоСрочностиЕПСДругиеДоговора.Видимость = (СчетаКлиента.Количество() > 0);
	ЭтаФорма.Элементы.АктивыЕПСДругиеДоговора.Видимость = (СчетаКлиента.Количество() > 0);
	
	ЭтаФорма.Элементы.КомиссияБухгалтерскийУчетДругиеДоговора.Видимость = (СчетаКлиента.Количество() > 0);
	ЭтаФорма.Элементы.КомиссияНалоговыйУчетДругиеДоговора.Видимость = (СчетаКлиента.Количество() > 0);
	ЭтаФорма.Элементы.КомиссияЕПСДругиеДоговора.Видимость = (СчетаКлиента.Количество() > 0);
	
	ЭтаФорма.Элементы.ЗакрытияБухгалтерскийУчетДругиеДоговора.Видимость = (СчетаКлиента.Количество() > 0);
	ЭтаФорма.Элементы.ЗакрытияНалоговыйУчетДругиеДоговора.Видимость = (СчетаКлиента.Количество() > 0);
	ЭтаФорма.Элементы.ЗакрытияЕПСДругиеДоговора.Видимость = (СчетаКлиента.Количество() > 0);
	
	ЭтаФорма.Элементы.ФормированияСЧАДругиеДоговора.Видимость = (СчетаКлиента.Количество() > 0);
	ЭтаФорма.Элементы.ФормированияСЧАПоВидамЗадолженностиДругиеДоговора.Видимость = (СчетаКлиента.Количество() > 0);
	
КонецПроцедуры

//Общие настройки
&НаСервере
Функция ПолучитьИсториюЗначенийОбщегоРеквизитаНаСервере(ИмяРеквизита)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаОбщие.Период,
		|	НастройкиУчетаОбщие." + ИмяРеквизита + " КАК ЗначениеРеквизита
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие КАК НастройкиУчетаОбщие
		|ГДЕ
		|	НастройкиУчетаОбщие.Организация = &Организация
		|	И НастройкиУчетаОбщие.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|
		|УПОРЯДОЧИТЬ ПО
		|	НастройкиУчетаОбщие.Период УБЫВ";

	Запрос.УстановитьПараметр("Организация", Этаформа.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Этаформа.СчетДоверительногоУправления);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Функция УстановитьЗначениеОбщейНастройкиНаСервере(СчетДУ, ДатаЗначения, ИмяЗначения, Значение)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаОбщиеСрезПоследних.*
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаОбщиеСрезПоследних";

	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("Период", ДатаЗначения);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДУ);

	ДанныеНастройки = Запрос.Выполнить().Выгрузить();
	Если ДанныеНастройки.Количество() = 0 Тогда
		СтрокаДанных = ДанныеНастройки.Добавить();
	Иначе
		СтрокаДанных = ДанныеНастройки[0];	
	КонецЕсли;
	СтрокаДанных.Период = ДатаЗначения;
	СтрокаДанных.Организация = ЭтаФорма.Организация;
	СтрокаДанных.СчетДоверительногоУправления = СчетДУ;
	
	Если СтрокаДанных[ИмяЗначения] <> Значение Тогда
		СтрокаДанных[ИмяЗначения] = Значение;
		
		Записи = РегистрыСведений.НастройкиУчетаОбщие.СоздатьНаборЗаписей();
		Записи.Отбор.Период.Установить(ДатаЗначения);
		Записи.Отбор.Организация.Установить(ЭтаФорма.Организация);
		Записи.Отбор.СчетДоверительногоУправления.Установить(СчетДУ);
		
		Записи.Прочитать();
		Записи.Загрузить(ДанныеНастройки);
		
		Попытка
			Записи.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать значение настройки из-за ошибки:" + Символы.ПС + ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ПолучитьОбщиеНастройкиДругихДоговоровНаСервере(СчетаКлиента)

	ДатаНастроек = ТекущаяДата();	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(НастройкиУчетаОбщие.Период) КАК Период
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие КАК НастройкиУчетаОбщие
		|ГДЕ
		|	НастройкиУчетаОбщие.Организация = &Организация
		|	И НастройкиУчетаОбщие.СчетДоверительногоУправления = &СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ВыборкаДетальныеЗаписи.Период <> Null Тогда
			ДатаНастроек = Макс(ДатаНастроек, ВыборкаДетальныеЗаписи.Период);
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ВсеПоля КАК ВсеПоля
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В (&СчетаДоверительногоУправления)) КАК НастройкиУчетаОбщиеСрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("Период", ДатаНастроек);
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаКлиента);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВсеПоля КАК ВсеПоля", "*");
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Процедура ОбновитьОбщиеНастройкиНаСервере()
	
	ВелсяЕПС = ПроверитьВелсяЛиУчетНаСервере(Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	
	РесурсыСГруппировкой = РегистрыСведений.НастройкиУчетаОбщие.ПолучитьГруппировкиОбщихНастроек();
	
	НастройкиДругихДоговоров = Неопределено;
	Если СчетаКлиента.Количество() > 0 Тогда
		НастройкиДругихДоговоров = ПолучитьОбщиеНастройкиДругихДоговоровНаСервере(СчетаКлиента.ВыгрузитьЗначения());
	КонецЕсли;
	
	ПредыдущаяГруппа = "";
	РодительскаяГруппа = "";
	
	ФильтрГрупп = ""; 			// по умолчанию показываем все группы
	РазрешитьГруппы = ""; 		// раз все показываем, то и исключений делать не нужно 
	
	Если НЕ ВелсяЕПС Тогда		// ЕПС не велся - не показываем группы вида "ЕПС ..."
	    ФильтрГрупп = "ЕПС";
		Если ЭтаФорма.ЕстьВозможностьУчитыватьЦенныеБумагиПоАмортизированнойСтоимости Тогда
			РазрешитьГруппы = "ЕПС Облигации"; // но если есть активы по АС в рамках БУ, то групппы вида "ЕПС Облигации ..." все-таки разрешаем
		КонецЕсли;
	КонецЕсли;
	
	ЭтаФорма.Общие.ПолучитьЭлементы().Очистить();
	
	Для каждого СтрокаРесурсыСГруппировкой Из РесурсыСГруппировкой Цикл
		
		Если ФильтрГрупп <> "" И Лев(СтрокаРесурсыСГруппировкой.Группа, СтрДлина(ФильтрГрупп)) = ФильтрГрупп Тогда
			
			Если РазрешитьГруппы = "" ИЛИ Лев(СтрокаРесурсыСГруппировкой.Группа, СтрДлина(РазрешитьГруппы)) <> РазрешитьГруппы Тогда
			
				Продолжить;	
			
			КонецЕсли;
		
		КонецЕсли;
		
		Если СтрокаРесурсыСГруппировкой.Группа <> ПредыдущаяГруппа Тогда // создаем новую группу
		
			Если СтрокаРесурсыСГруппировкой.Группа = "!корень" Тогда // этих без групп
			
				РодительскаяГруппа = ЭтаФорма.Общие;
				
			Иначе
				
				РодительскаяГруппа = ЭтаФорма.Общие.ПолучитьЭлементы().Добавить();
				РодительскаяГруппа.Картинка = 6;
				РодительскаяГруппа.ИмяНастройки = "";
				РодительскаяГруппа.ПредставлениеНастройки = СтрокаРесурсыСГруппировкой.Группа;
				РодительскаяГруппа.Ключ = РодительскаяГруппа.ПредставлениеНастройки; // группы виртуальные, у них только представление есть
			
			КонецЕсли;
			
			ПредыдущаяГруппа = СтрокаРесурсыСГруппировкой.Группа;
		
		КонецЕсли;
		
		РеквизитВДереве = РодительскаяГруппа.ПолучитьЭлементы().Добавить();
		РеквизитВДереве.Картинка = ОпределитьИконкуНаСервере(Метаданные.РегистрыСведений.НастройкиУчетаОбщие.Ресурсы[СтрокаРесурсыСГруппировкой.Имя].Тип);
		РеквизитВДереве.ИмяНастройки = СтрокаРесурсыСГруппировкой.Имя;
		РеквизитВДереве.ПредставлениеНастройки = СтрокаРесурсыСГруппировкой.Синоним;
		РеквизитВДереве.Ключ = РеквизитВДереве.ИмяНастройки; // а у самой настройки возьмем уже имя
		
		ИсторияЗначений = ПолучитьИсториюЗначенийОбщегоРеквизитаНаСервере(РеквизитВДереве.ИмяНастройки);
		Если ИсторияЗначений.Количество() > 0 Тогда
			Для каждого СтрокаИстории Из ИсторияЗначений Цикл
				Если ИсторияЗначений.Индекс(СтрокаИстории) = 0 Тогда
					РеквизитВДереве.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита;
					РеквизитВДереве.ДатаЗначения = СтрокаИстории.Период;
					РеквизитВДереве.ОтображаемаяДата = СтрокаИстории.Период;
					
					Если НастройкиДругихДоговоров <> Неопределено И СтрокаРесурсыСГруппировкой.Группа <> "!корень" Тогда
						РеквизитВДереве.ДругиеДоговора = НастройкаДляДругихДоговоровНаСервере(РеквизитВДереве.ИмяНастройки, РеквизитВДереве.ЗначениеНастройки, НастройкиДругихДоговоров);
					КонецЕсли;
				Иначе
					Если РеквизитВДереве.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита И
						РеквизитВДереве.ПолучитьЭлементы().Количество() = 0 Тогда
						РеквизитВДереве.ДатаЗначения = СтрокаИстории.Период;
						РеквизитВДереве.ОтображаемаяДата = СтрокаИстории.Период;
					Иначе
						ПериодВРеквизите = РеквизитВДереве.ПолучитьЭлементы().Добавить();
						ПериодВРеквизите.Картинка = 5;
						ПериодВРеквизите.ИмяНастройки = СтрокаРесурсыСГруппировкой.Имя;
						ПериодВРеквизите.ПредставлениеНастройки = "Значение на " + Формат(СтрокаИстории.Период, "ДФ=dd.MM.yyyy");
						ПериодВРеквизите.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита;
						ПериодВРеквизите.ДатаЗначения = СтрокаИстории.Период;
						ПериодВРеквизите.Ключ = ""; // у элементов типа дата-значение ключ делаем пустым т.к. ни позиционироваться, ни разворачивать их не нужно
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

//Расчетные настройки
&НаСервере
Процедура ОбновитьРасчетныеНастройкиНаСервере()

	ЭтаФорма.ЕстьВозможностьУчитыватьЦенныеБумагиПоАмортизированнойСтоимости = Ложь;
	
	ЭтаФорма.РасчетныеНастройки.Очистить();
	
	СписокРасчетныхНастроек = БухгалтерскийУчет.ОпределитьРасчетныеНастройкиУчета(ЭтаФорма.ДатаРасчетныхНастроек, ЭтаФорма.Организация, ЭтаФорма.СчетДоверительногоУправления);
	Для каждого РасчетнаяНастройка Из СписокРасчетныхНастроек Цикл
	
		СтрокаРасчетныеНастройки = ЭтаФорма.РасчетныеНастройки.Добавить();
		СтрокаРасчетныеНастройки.Настройка = РасчетнаяНастройка.Ключ;
		СтрокаРасчетныеНастройки.Значение = РасчетнаяНастройка.Значение;
		
		Если СтрокаРасчетныеНастройки.Настройка = "ЕстьВозможностьУчитыватьЦенныеБумагиПоАмортизированнойСтоимости" Тогда
			ЭтаФорма.ЕстьВозможностьУчитыватьЦенныеБумагиПоАмортизированнойСтоимости = СтрокаРасчетныеНастройки.Значение;
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

//Настройки активов
&НаСервере 
Процедура ПроверкаКорректностиНастройкиНаСервере(СтрокаДанных, ИмяЗначения)
	
	// Проверка корректности заполнения зависивых друг от друга настроек.
	// В случае конфликта настроек, проверяемая настройка заполняется значением по умолчанию
	
	НужнаПроверка = Ложь;  ТекстСообщения = "";
	
	Если СтрокаДанных.ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет ИЛИ СтрокаДанных.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда	
		Если ИмяЗначения = "ВыделятьНалогПоДивидендам" ИЛИ ИмяЗначения = "СпособОтраженияДивидендов" Тогда
			ИмяЗначенияНастройки = "ВыделятьНалогПоДивидендам";
			ИмяЗначенияПроверяемое = "СпособОтраженияДивидендов";
			ЗначениеНастройки = Ложь;
			ЗначениеНастройкиПроверяемой = Перечисления.СпособыОтраженияДивидендов.ОтражатьДатойОплаты;
			НужнаПроверка = Истина;
			ТекстСообщения = "Если 'Выделять налог по дивидендам' равно Нет, тогда  'Способ отражения дивидендов' должен быть установлен как 'Отражать датой оплаты'";
		ИначеЕсли ИмяЗначения = "ПриПогашенииВДоходеОтражатьТолькоРазницу" ИЛИ ИмяЗначения = "ДоначислятьКупонДоПолнойСтоимостиПередПродажейИПогашением" Тогда 
			ИмяЗначенияНастройки = "ПриПогашенииВДоходеОтражатьТолькоРазницу";
			ИмяЗначенияПроверяемое = "ДоначислятьКупонДоПолнойСтоимостиПередПродажейИПогашением";
			ЗначениеНастройки = Истина;
			ЗначениеНастройкиПроверяемой = Истина;	
			НужнаПроверка = Истина;
			ТекстСообщения = "Устанавливать параметр 'При погашении в доходе отражать только разницу' имеет смысл только если задан параметр 'Доначислять купон до полной стоимости перед продажей и погашением'";
		КонецЕсли;		
	Конецесли;
		
	Если НужнаПроверка Тогда 
		Если СтрокаДанных[ИмяЗначенияНастройки] = ЗначениеНастройки 
			И СтрокаДанных[ИмяЗначенияПроверяемое] <> ЗначениеНастройкиПроверяемой Тогда 
			СтрокаДанных[ИмяЗначенияПроверяемое] = ЗначениеНастройкиПроверяемой;			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);					
		КонецЕсли;	
	Конецесли;	
	
КонецПроцедуры	

&НаСервере
Функция ПолучитьИсториюЗначенийРеквизитаАктивовНаСервере(ИмяРеквизита, УчетныйАктив, ВидУчета, ЭтоЕПС, ИсторияНастроекАктивов)

	ИмяРегистра = "НастройкиУчетаАктивов";
	
	Если ЭтоЕПС Тогда
	
		ИмяРегистра = "НастройкиУчетаАктивовЕПС";
	
	КонецЕсли;
	
	Если ИсторияНастроекАктивов = Неопределено Тогда	
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НастройкиУчетаАктивов.*
			|ИЗ
			|	РегистрСведений." + ИмяРегистра + " КАК НастройкиУчетаАктивов
			|ГДЕ
			|	НастройкиУчетаАктивов.Организация = &Организация
			|	И НастройкиУчетаАктивов.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И НастройкиУчетаАктивов.ВидУчета = &ВидУчета
			|
			|УПОРЯДОЧИТЬ ПО
			|	Период УБЫВ";

		Запрос.УстановитьПараметр("Организация", Этаформа.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", Этаформа.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ВидУчета", ВидУчета);

		ИсторияНастроекАктивов = Запрос.Выполнить().Выгрузить();
		ИсторияНастроекАктивов.Индексы.Добавить("УчетныйАктив");
		
	КонецЕсли;
	
	ИсторияЗначенийРеквизитаАктивов = ИсторияНастроекАктивов.Скопировать(Новый Структура("УчетныйАктив", УчетныйАктив), "Период, " + ИмяРеквизита);
	ИсторияЗначенийРеквизитаАктивов.Колонки[ИмяРеквизита].Имя = "ЗначениеРеквизита";
		
	Возврат ИсторияЗначенийРеквизитаАктивов;

КонецФункции

&НаСервере
Функция УстановитьЗначениеНастройкиАктивовНаСервере(СчетДУ, ДатаЗначения, ИмяЗначения, Значение, УчетныйАктив, ВидУчета, ЭтоЕПС = Ложь)

	ИмяРегистра = "НастройкиУчетаАктивов";
	
	Если ЭтоЕПС Тогда
	
		ИмяРегистра = "НастройкиУчетаАктивовЕПС";
	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.*
		|ИЗ
		|	РегистрСведений." + ИмяРегистра + ".СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И УчетныйАктив = &УчетныйАктив
		|				И ВидУчета = &ВидУчета) КАК НастройкиУчетаАктивовСрезПоследних";

	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("Период", ДатаЗначения);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДУ);
	Запрос.УстановитьПараметр("УчетныйАктив", УчетныйАктив);
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);

	ДанныеНастройки = Запрос.Выполнить().Выгрузить();
	Если ДанныеНастройки.Количество() = 0 Тогда
		СтрокаДанных = ДанныеНастройки.Добавить();
	Иначе
		СтрокаДанных = ДанныеНастройки[0];	
	КонецЕсли;
	СтрокаДанных.Период = ДатаЗначения;
	СтрокаДанных.Организация = ЭтаФорма.Организация;
	СтрокаДанных.СчетДоверительногоУправления = СчетДУ;
	СтрокаДанных.УчетныйАктив = УчетныйАктив;
	СтрокаДанных.ВидУчета = ВидУчета;

	
	Если СтрокаДанных[ИмяЗначения] <> Значение Тогда
		СтрокаДанных[ИмяЗначения] = Значение;
		
		ПроверкаКорректностиНастройкиНаСервере(СтрокаДанных, ИмяЗначения);
		
		Записи = РегистрыСведений.НастройкиУчетаАктивов.СоздатьНаборЗаписей();
		Если ЭтоЕПС Тогда
			Записи = РегистрыСведений.НастройкиУчетаАктивовЕПС.СоздатьНаборЗаписей();
		КонецЕсли;
		
		Записи.Отбор.Период.Установить(ДатаЗначения);
		Записи.Отбор.Организация.Установить(ЭтаФорма.Организация);
		Записи.Отбор.СчетДоверительногоУправления.Установить(СчетДУ);
		Записи.Отбор.УчетныйАктив.Установить(УчетныйАктив);
		Записи.Отбор.ВидУчета.Установить(ВидУчета);	
		
		Записи.Прочитать();
		Записи.Загрузить(ДанныеНастройки);
		
		Попытка
			Записи.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать значение настройки из-за ошибки:" + Символы.ПС + ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ПолучитьНастройкиАктивовДругихДоговоровНаСервере(СчетаКлиента, ВидУчета)

	ДатаНастроек = ТекущаяДата();	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(НастройкиУчетаАктивов.Период) КАК Период
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов КАК НастройкиУчетаАктивов
		|ГДЕ
		|	НастройкиУчетаАктивов.Организация = &Организация
		|	И НастройкиУчетаАктивов.СчетДоверительногоУправления = &СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления);
	
	Если ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НастройкиУчетаАктивов", "НастройкиУчетаАктивовЕПС");
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ВыборкаДетальныеЗаписи.Период <> Null Тогда
			ДатаНастроек = Макс(ДатаНастроек, ВыборкаДетальныеЗаписи.Период);
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ВсеПоля КАК ВсеПоля
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&Период,
		|			Организация = &Организация И ВидУчета = &ВидУчета
		|				И СчетДоверительногоУправления В (&СчетаДоверительногоУправления)) КАК НастройкиПоВидуУчетаСрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("Период", ДатаНастроек);
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаКлиента);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВсеПоля КАК ВсеПоля", "*");
	
	Если ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НастройкиУчетаАктивов", "НастройкиУчетаАктивовЕПС");
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Процедура ОбновитьНастройкиАктивовПоРегиструНаСервере(ВидУчета, ЭтоЕПС = Ложь)
	
	Перем ИсторияНастроекАктивов;	
	
	НастройкиДругихДоговоров = Неопределено;
	Если СчетаКлиента.Количество() > 0 Тогда
		НастройкиДругихДоговоров = ПолучитьНастройкиАктивовДругихДоговоровНаСервере(СчетаКлиента.ВыгрузитьЗначения(), ВидУчета);
	КонецЕсли;
	
	Если ЭтоЕПС Тогда
		РеквизитФормы = ЭтаФорма.АктивыЕПС;
	ИначеЕсли ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет Тогда
		РеквизитФормы = ЭтаФорма.АктивыБухгалтерскийУчет;
	ИначеЕсли ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
		РеквизитФормы = ЭтаФорма.АктивыНалоговыйУчет;
	ИначеЕсли ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		РеквизитФормы = ЭтаФорма.КлассификацияПоСрочностиЕПС;
	КонецЕсли;
	
	РеквизитФормы.ПолучитьЭлементы().Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УчетныеАктивы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.УчетныеАктивы КАК УчетныеАктивы
		|
		|УПОРЯДОЧИТЬ ПО
		|	УчетныеАктивы.Родитель.Наименование,
		|	УчетныеАктивы.Наименование
		|ИТОГИ ПО
		|	ОБЩИЕ";
		
	Если ЭтоЕПС Тогда
	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "УчетныеАктивы", "УчетныеАктивыЕПС");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ОБЩИЕ", "УчетныеАктивыЕПС.Родитель");
		
		РесурсыРегистраСведений = Метаданные.РегистрыСведений.НастройкиУчетаАктивовЕПС.Ресурсы;
		
	Иначе
		
		РесурсыРегистраСведений = Метаданные.РегистрыСведений.НастройкиУчетаАктивов.Ресурсы;
		
		ГруппаУчетныхАктивовВДереве = РеквизитФормы;
		СоздатьГруппуРодителя = Ложь;
		
	КонецЕсли;		
	
	ВыборкаРодитель = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаРодитель.Следующий() Цикл
		
		Если ЭтоЕПС Тогда
		
			СоздатьГруппуРодителя = Истина;
			
		КонецЕсли;
		
		ВыборкаДетальныеЗаписи = ВыборкаРодитель.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			УчетныйАктив = ВыборкаДетальныеЗаписи.Ссылка;
			
			АктивПереоценивается = (УчетныйАктив.Родитель <> Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСД И УчетныйАктив.Родитель <> Справочники.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения);
			
			Если ЭтоЕПС 
				И (УчетныйАктив.Родитель = Справочники.УчетныеАктивыЕПС.ПустаяСсылка()
					ИЛИ ЭтаФорма.ЕстьВозможностьУчитыватьЦенныеБумагиПоАмортизированнойСтоимости 
						И УчетныйАктив.Родитель <> Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСД) Тогда
				
				Продолжить;		
				
			КонецЕсли;
			
			Если СоздатьГруппуРодителя Тогда
			
				ГруппаУчетныхАктивовВДереве = РеквизитФормы.ПолучитьЭлементы().Добавить();
				ГруппаУчетныхАктивовВДереве.Картинка = 6;
				ГруппаУчетныхАктивовВДереве.ИмяНастройки = "";
				ГруппаУчетныхАктивовВДереве.ПредставлениеНастройки = УчетныйАктив.Родитель.Наименование;
				ГруппаУчетныхАктивовВДереве.УчетныйАктив = УчетныйАктив.Родитель;
				ГруппаУчетныхАктивовВДереве.Ключ = УчетныйАктив.Родитель.Код;
				
				СоздатьГруппуРодителя = Ложь;
			
			КонецЕсли;
			
			УчетныйАктивВДереве = ГруппаУчетныхАктивовВДереве.ПолучитьЭлементы().Добавить();
			УчетныйАктивВДереве.Картинка = 6;
			УчетныйАктивВДереве.ИмяНастройки = "";
			УчетныйАктивВДереве.ПредставлениеНастройки = УчетныйАктив.Наименование;
			УчетныйАктивВДереве.УчетныйАктив = УчетныйАктив;
			УчетныйАктивВДереве.Ключ = УчетныйАктив.Код;
			
			БылаИсторияЗначений = Ложь;
			
			Для каждого Ресурс Из РесурсыРегистраСведений Цикл
				
				РесурсПереоценки = (Ресурс.Имя = "ПериодичностьПереоценки" ИЛИ Ресурс.Имя = "ПереоцениватьВДеньОперации" ИЛИ Ресурс.Имя = "ПереоцениватьВНерабочиеДни");
				РесурсКорректировкиЭСП = (Ресурс.Имя = "ПериодичностьНачисленияКорректировкиЭСП" ИЛИ Ресурс.Имя = "НачислятьКорректировкуЭСПВДеньОперации");
				
				Если ЭтоЕПС Тогда
					Если ЭтаФорма.ЕстьВозможностьУчитыватьЦенныеБумагиПоАмортизированнойСтоимости И НЕ РесурсКорректировкиЭСП Тогда
						Продолжить;
					ИначеЕсли РесурсПереоценки И НЕ АктивПереоценивается Тогда
						Продолжить;
					КонецЕсли;
				Иначе
					Если НЕ ДоступенРесурсНаСервере(Ресурс.Имя, УчетныйАктив, ВидУчета, АдресТаблицыНастроекВидимости) Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				РеквизитВДереве = УчетныйАктивВДереве.ПолучитьЭлементы().Добавить();
				РеквизитВДереве.Картинка = ОпределитьИконкуНаСервере(Ресурс.Тип);
				РеквизитВДереве.ИмяНастройки = Ресурс.Имя;
				РеквизитВДереве.ПредставлениеНастройки = Ресурс.Синоним;
				РеквизитВДереве.УчетныйАктив = УчетныйАктив;
				РеквизитВДереве.Ключ = УчетныйАктив.Код + РеквизитВДереве.ИмяНастройки;
				
				ИсторияЗначений = ПолучитьИсториюЗначенийРеквизитаАктивовНаСервере(РеквизитВДереве.ИмяНастройки, УчетныйАктив, ВидУчета, ЭтоЕПС, ИсторияНастроекАктивов);
				Если ИсторияЗначений.Количество() > 0 Тогда
					
					БылаИсторияЗначений = Истина;
					
					Для каждого СтрокаИстории Из ИсторияЗначений Цикл
						Если ИсторияЗначений.Индекс(СтрокаИстории) = 0 Тогда
							РеквизитВДереве.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита;
							РеквизитВДереве.ДатаЗначения = СтрокаИстории.Период;
							РеквизитВДереве.ОтображаемаяДата = СтрокаИстории.Период;
							
							Если НастройкиДругихДоговоров <> Неопределено Тогда
								РеквизитВДереве.ДругиеДоговора = НастройкаДляДругихДоговоровНаСервере(РеквизитВДереве.ИмяНастройки, РеквизитВДереве.ЗначениеНастройки, НастройкиДругихДоговоров, УчетныйАктив);
							КонецЕсли;
							
						Иначе
							Если РеквизитВДереве.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита И
								РеквизитВДереве.ПолучитьЭлементы().Количество() = 0 Тогда
								РеквизитВДереве.ДатаЗначения = СтрокаИстории.Период;
								РеквизитВДереве.ОтображаемаяДата = СтрокаИстории.Период;
							Иначе
								ПериодВРеквизите = РеквизитВДереве.ПолучитьЭлементы().Добавить();
								ПериодВРеквизите.Картинка = 5;
								ПериодВРеквизите.ИмяНастройки = Ресурс.Имя;
								ПериодВРеквизите.ПредставлениеНастройки = "Значение на " + Формат(СтрокаИстории.Период, "ДФ=dd.MM.yyyy");
								ПериодВРеквизите.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита;
								ПериодВРеквизите.ДатаЗначения = СтрокаИстории.Период;
								ПериодВРеквизите.УчетныйАктив = УчетныйАктив;
								ПериодВРеквизите.Ключ = "";
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если ЭтаФорма.СкрыватьНеиспользуемыеГруппыАктивов И НЕ БылаИсторияЗначений Тогда
			
				ГруппаУчетныхАктивовВДереве.ПолучитьЭлементы().Удалить(УчетныйАктивВДереве);
			
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если ЭтаФорма.СкрыватьНеиспользуемыеГруппыАктивов И ЭтоЕПС Тогда
	
		МассивЭлементовКУдалению = Новый Массив();
		
		Для каждого ЭлементГруппа Из РеквизитФормы.ПолучитьЭлементы() Цикл
			Если ЭлементГруппа.ПолучитьЭлементы().Количество() = 0 Тогда
				МассивЭлементовКУдалению.Добавить(ЭлементГруппа);
			КонецЕсли;	
		КонецЦикла;
		
		Для каждого ЭлементКУдалению Из МассивЭлементовКУдалению Цикл
			РеквизитФормы.ПолучитьЭлементы().Удалить(ЭлементКУдалению);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

//Настройки комисии
&НаСервере
Функция ПолучитьИсториюЗначенийРеквизитаКомиссииНаСервере(ИмяРеквизита, ВидЗадолженности, ВидУчета)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаКомиссии.Период КАК Период,
		|	НастройкиУчетаКомиссии." + ИмяРеквизита + " КАК ЗначениеРеквизита
		|ИЗ
		|	РегистрСведений.НастройкиУчетаКомиссии КАК НастройкиУчетаКомиссии
		|ГДЕ
		|	НастройкиУчетаКомиссии.Организация = &Организация
		|	И НастройкиУчетаКомиссии.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И НастройкиУчетаКомиссии.ВидЗадолженности = &ВидЗадолженности
		|	И НастройкиУчетаКомиссии.ВидУчета = &ВидУчета
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";

	Запрос.УстановитьПараметр("Организация", Этаформа.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Этаформа.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидЗадолженности", ВидЗадолженности);
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Функция УстановитьЗначениеНастройкиКомиссииНаСервере(СчетДУ, ДатаЗначения, ИмяЗначения, Значение, ВидЗадолженности, ВидУчета)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаКомиссииСрезПоследних.*
		|ИЗ
		|	РегистрСведений.НастройкиУчетаКомиссии.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидЗадолженности = &ВидЗадолженности
		|				И ВидУчета = &ВидУчета) КАК НастройкиУчетаКомиссииСрезПоследних";

	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("Период", ДатаЗначения);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДУ);
	Запрос.УстановитьПараметр("ВидЗадолженности", ВидЗадолженности);
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);

	ДанныеНастройки = Запрос.Выполнить().Выгрузить();
	Если ДанныеНастройки.Количество() = 0 Тогда
		СтрокаДанных = ДанныеНастройки.Добавить();
	Иначе
		СтрокаДанных = ДанныеНастройки[0];	
	КонецЕсли;
	СтрокаДанных.Период = ДатаЗначения;
	СтрокаДанных.Организация = ЭтаФорма.Организация;
	СтрокаДанных.СчетДоверительногоУправления = СчетДУ;
	СтрокаДанных.ВидЗадолженности = ВидЗадолженности;
	СтрокаДанных.ВидУчета = ВидУчета;
	
	Если СтрокаДанных[ИмяЗначения] <> Значение Тогда
		СтрокаДанных[ИмяЗначения] = Значение;
		
		Записи = РегистрыСведений.НастройкиУчетаКомиссии.СоздатьНаборЗаписей();
		Записи.Отбор.Период.Установить(ДатаЗначения);
		Записи.Отбор.Организация.Установить(ЭтаФорма.Организация);
		Записи.Отбор.СчетДоверительногоУправления.Установить(СчетДУ);
		Записи.Отбор.ВидЗадолженности.Установить(ВидЗадолженности);
		Записи.Отбор.ВидУчета.Установить(ВидУчета);
		
		Записи.Прочитать();
		Записи.Загрузить(ДанныеНастройки);
		
		Попытка
			Записи.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать значение настройки из-за ошибки:" + Символы.ПС + ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ПолучитьНастройкиКомиссииДругихДоговоровНаСервере(СчетаКлиента, ВидУчета)

	ДатаНастроек = ТекущаяДата();	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(НастройкиУчетаКомиссии.Период) КАК Период
		|ИЗ
		|	РегистрСведений.НастройкиУчетаКомиссии КАК НастройкиУчетаКомиссии
		|ГДЕ
		|	НастройкиУчетаКомиссии.Организация = &Организация
		|	И НастройкиУчетаКомиссии.СчетДоверительногоУправления = &СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ВыборкаДетальныеЗаписи.Период <> Null Тогда
			ДатаНастроек = Макс(ДатаНастроек, ВыборкаДетальныеЗаписи.Период);
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	&Период КАК Период,
		|	&Организация КАК Организация,
		|	&ВидУчета КАК ВидУчета,
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	ВидыЗадолженности.Ссылка КАК ВидЗадолженности
		|ПОМЕСТИТЬ _СчетаИВидыЗадолженности
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыЗадолженности КАК ВидыЗадолженности
		|		ПО (ВидыЗадолженности.Ссылка В (&ВидыЗадолженности))
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка В(&СчетаДоверительногоУправления)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&РесурсыРегистра КАК РесурсыРегистра,
		|	_СчетаИВидыЗадолженности.Период КАК Период,
		|	_СчетаИВидыЗадолженности.Организация КАК Организация,
		|	_СчетаИВидыЗадолженности.ВидУчета КАК ВидУчета,
		|	_СчетаИВидыЗадолженности.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_СчетаИВидыЗадолженности.ВидЗадолженности КАК ВидЗадолженности
		|ИЗ
		|	_СчетаИВидыЗадолженности КАК _СчетаИВидыЗадолженности
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаКомиссии.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И ВидУчета = &ВидУчета) КАК НастройкиУчетаКомиссииСрезПоследних
		|		ПО _СчетаИВидыЗадолженности.СчетДоверительногоУправления = НастройкиУчетаКомиссииСрезПоследних.СчетДоверительногоУправления
		|			И _СчетаИВидыЗадолженности.ВидЗадолженности = НастройкиУчетаКомиссииСрезПоследних.ВидЗадолженности";
	
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("Период", ДатаНастроек);
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаКлиента);
	Запрос.УстановитьПараметр("ВидыЗадолженности", ПолучитьМассивВидовЗадолженностиДляКомиссии(ЭтаФорма.СчетДоверительногоУправления));
	
	СтрокаПолей = "";
	
	ИменаПолей = РаботаСМетаданнымиПовтИсп.ПолучитьИменаПолейРегистра("РегистрыСведений", "НастройкиУчетаКомиссии", Истина);
	Для каждого ИмяПоля Из ИменаПолей Цикл
		СтрокаПолей = СтрокаПолей + СтрШаблон("ЕСТЬNULL(НастройкиУчетаКомиссииСрезПоследних.%1, ""Не задана"") КАК %1, ", ИмяПоля);
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&РесурсыРегистра КАК РесурсыРегистра,", СтрокаПолей);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьМассивВидовЗадолженностиДляКомиссии(СчетДоверительногоУправления)

	МассивВидовЗадолженностиДляКомиссии = Новый Массив();
	
	ЭтоПИФ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления") 
		= Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда;
		
	ВидыЗадолженностиКПереоценкеПИФ = Справочники.ВидыЗадолженности.ВидыЗадолженностиКПереоценкеПИФ();	

	ВидЗадолженности = Справочники.ВидыЗадолженности.Выбрать();
	Пока ВидЗадолженности.Следующий() Цикл
		
		НастройкаПереоценкиДляПИФ = ЭтоПИФ И 
			ВидыЗадолженностиКПереоценкеПИФ.Найти(ВидЗадолженности.Ссылка) <> Неопределено;
			
		Если ВидЗадолженности.Ссылка.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.Комиссия) ИЛИ
			 ВидЗадолженности.Родитель = Справочники.ВидыЗадолженности.УслугиДоверительногоУправления ИЛИ
			 ВидЗадолженности.Родитель = Справочники.ВидыЗадолженности.Недвижимость ИЛИ
			 ВидЗадолженности.Ссылка = Справочники.ВидыЗадолженности.ПоВозмещениюСтраховыхПремий ИЛИ
			 ВидЗадолженности.Ссылка = Справочники.ВидыЗадолженности.Прочее ИЛИ
			 ВидЗадолженности.Ссылка = Справочники.ВидыЗадолженности.РасходыПоСодержаниюНедвижимости ИЛИ
			 ВидЗадолженности.Ссылка = Справочники.ВидыЗадолженности.РасходыНаКоммунальныеУслуги ИЛИ
			 ВидЗадолженности.Ссылка = Справочники.ВидыЗадолженности.ПоНалогуНаИмущество ИЛИ
			 ВидЗадолженности.Ссылка = Справочники.ВидыЗадолженности.ПоЗемельномуНалогу ИЛИ
			 НастройкаПереоценкиДляПИФ 
			 Тогда
			 
			 МассивВидовЗадолженностиДляКомиссии.Добавить(ВидЗадолженности.Ссылка);
			 
		КонецЕсли;
	КонецЦикла;

	Возврат МассивВидовЗадолженностиДляКомиссии;
	
КонецФункции

&НаСервере
Процедура ОбновитьНастройкиКомиссииПоРегиструНаСервере(ВидУчета)
	
	НастройкиДругихДоговоров = Неопределено;
	Если СчетаКлиента.Количество() > 0 Тогда
		НастройкиДругихДоговоров = ПолучитьНастройкиКомиссииДругихДоговоровНаСервере(СчетаКлиента.ВыгрузитьЗначения(), ВидУчета);
	КонецЕсли;
	
	Если ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет Тогда
		РеквизитФормы = ЭтаФорма.КомиссияБухгалтерскийУчет;
	ИначеЕсли ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
		РеквизитФормы = ЭтаФорма.КомиссияНалоговыйУчет;
	ИначеЕсли ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		РеквизитФормы = ЭтаФорма.КомиссияЕПС;
	КонецЕсли;
	РеквизитФормы.ПолучитьЭлементы().Очистить();
	
	ЭтоПИФ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтаФорма.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления") 
		= Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда;
	
	ВидыЗадолженностиКПереоценкеПИФ = Справочники.ВидыЗадолженности.ВидыЗадолженностиКПереоценкеПИФ();	
	
	МассивВидовЗадолженностиДляКомиссии = ПолучитьМассивВидовЗадолженностиДляКомиссии(СчетДоверительногоУправления);
	Для каждого ВидЗадолженности Из МассивВидовЗадолженностиДляКомиссии Цикл
		
		НастройкаПереоценкиДляПИФ = ЭтоПИФ И 
			ВидыЗадолженностиКПереоценкеПИФ.Найти(ВидЗадолженности.Ссылка) <> Неопределено;
		
		УчетныйАктивВДереве = РеквизитФормы.ПолучитьЭлементы().Добавить();
		УчетныйАктивВДереве.Картинка = 6;
		УчетныйАктивВДереве.ИмяНастройки = "";
		УчетныйАктивВДереве.ПредставлениеНастройки = ВидЗадолженности.Наименование;
		УчетныйАктивВДереве.ВидЗадолженности = ВидЗадолженности.Ссылка;
		УчетныйАктивВДереве.Ключ = ВидЗадолженности.Код;
		
		Для каждого Ресурс Из Метаданные.РегистрыСведений.НастройкиУчетаКомиссии.Ресурсы Цикл
			
			Если Ресурс.Имя = "СчетУчета"
				И (НастройкаПереоценкиДляПИФ 
					ИЛИ ВидЗадолженности.Ссылка.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.Налоги)) 
				Тогда
				Продолжить;
			КонецЕсли;
			
			РеквизитВДереве = УчетныйАктивВДереве.ПолучитьЭлементы().Добавить();
			РеквизитВДереве.Картинка = ОпределитьИконкуНаСервере(Ресурс.Тип);
			РеквизитВДереве.ИмяНастройки = Ресурс.Имя;
			РеквизитВДереве.ПредставлениеНастройки = Ресурс.Синоним;
			РеквизитВДереве.ВидЗадолженности = ВидЗадолженности.Ссылка;
			РеквизитВДереве.Ключ = ВидЗадолженности.Код + РеквизитВДереве.ИмяНастройки;
			
			ИсторияЗначений = ПолучитьИсториюЗначенийРеквизитаКомиссииНаСервере(РеквизитВДереве.ИмяНастройки, ВидЗадолженности.Ссылка, ВидУчета);
			Если ИсторияЗначений.Количество() > 0 Тогда
				Для каждого СтрокаИстории Из ИсторияЗначений Цикл
					Если ИсторияЗначений.Индекс(СтрокаИстории) = 0 Тогда
						РеквизитВДереве.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита;
						РеквизитВДереве.ДатаЗначения = СтрокаИстории.Период;
						РеквизитВДереве.ОтображаемаяДата = СтрокаИстории.Период;
							
						Если НастройкиДругихДоговоров <> Неопределено Тогда
							РеквизитВДереве.ДругиеДоговора = НастройкаДляДругихДоговоровНаСервере(РеквизитВДереве.ИмяНастройки, РеквизитВДереве.ЗначениеНастройки, НастройкиДругихДоговоров,, ВидЗадолженности.Ссылка);
						КонецЕсли;
						
					Иначе
						Если РеквизитВДереве.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита И
							РеквизитВДереве.ПолучитьЭлементы().Количество() = 0 Тогда
							РеквизитВДереве.ДатаЗначения = СтрокаИстории.Период;
							РеквизитВДереве.ОтображаемаяДата = СтрокаИстории.Период;
						Иначе
							ПериодВРеквизите = РеквизитВДереве.ПолучитьЭлементы().Добавить();
							ПериодВРеквизите.Картинка = 5;
							ПериодВРеквизите.ИмяНастройки = Ресурс.Имя;
							ПериодВРеквизите.ПредставлениеНастройки = "Значение на " + Формат(СтрокаИстории.Период, "ДФ=dd.MM.yyyy");
							ПериодВРеквизите.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита;
							ПериодВРеквизите.ДатаЗначения = СтрокаИстории.Период;
							ПериодВРеквизите.ВидЗадолженности = ВидЗадолженности.Ссылка;
							ПериодВРеквизите.Ключ = "";
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла; 
	
КонецПроцедуры

//Настройки по виду учета
&НаСервере
Функция ПолучитьИсториюЗначенийРеквизитаВидаУчетаНаСервере(ИмяРеквизита, ВидУчета)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиПоВидуУчета.Период КАК Период,
		|	НастройкиПоВидуУчета." + ИмяРеквизита + " КАК ЗначениеРеквизита
		|ИЗ
		|	РегистрСведений.НастройкиПоВидуУчета КАК НастройкиПоВидуУчета
		|ГДЕ
		|	НастройкиПоВидуУчета.Организация = &Организация
		|	И НастройкиПоВидуУчета.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И НастройкиПоВидуУчета.ВидУчета = &ВидУчета
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";

	Запрос.УстановитьПараметр("Организация", Этаформа.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Этаформа.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

