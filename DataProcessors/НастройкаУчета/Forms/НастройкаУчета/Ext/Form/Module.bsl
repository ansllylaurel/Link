Функция ПолучитьНастройкиВидаУчетаДругихДоговоровНаСервере(СчетаКлиента, ВидУчета)

	ДатаНастроек = ТекущаяДата();	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(НастройкиПоВидуУчета.Период) КАК Период
		|ИЗ
		|	РегистрСведений.НастройкиПоВидуУчета КАК НастройкиПоВидуУчета
		|ГДЕ
		|	НастройкиПоВидуУчета.Организация = &Организация
		|	И НастройкиПоВидуУчета.СчетДоверительногоУправления = &СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ВыборкаДетальныеЗаписи.Период <> Null Тогда
			ДатаНастроек = Макс(ДатаНастроек, ВыборкаДетальныеЗаписи.Период);
		КонецЕсли;
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ВсеПоля КАК ВсеПоля
		|ИЗ
		|	РегистрСведений.НастройкиПоВидуУчета.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И ВидУчета = &ВидУчета
		|				И СчетДоверительногоУправления В (&СчетаДоверительногоУправления)) КАК НастройкиПоВидуУчетаСрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("Период", ДатаНастроек);
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаКлиента);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВсеПоля КАК ВсеПоля", "*");
	
	Возврат Запрос.Выполнить().Выгрузить();

