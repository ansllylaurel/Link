&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЭтаФорма.Параметры.Свойство("СчетДоверительногоУправления") Тогда
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задан счет доверительного управления!",,,, Отказ);
		
		Возврат;
	
	КонецЕсли;
	
	Если ЭтаФорма.Параметры.СчетДоверительногоУправления.ВидСчетаДоверительногоУправления = Перечисления.ВидыСчетовДоверительногоУправления.Стратегия Тогда
		
		Если ЭтаФорма.Параметры.СчетДоверительногоУправления.Родитель.ВестиКонсолидированныйБухгалтерскийУчет Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По договору д/у ведется консолидированный учет! Настройки по стратегии недоступны!",,,, Отказ);
			
			Возврат;
			
		КонецЕсли;
	
	КонецЕсли;
	
	ЭтаФорма.СкрыватьНеиспользуемыеГруппыАктивов = Истина;
	ЭтаФорма.СчетДоверительногоУправления = ЭтаФорма.Параметры.СчетДоверительногоУправления;
	ЭтаФорма.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	ЭтаФорма.ДатаРасчетныхНастроек = ТекущаяДата();
	ЭтаФорма.КлиентДУ = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтаФорма.СчетДоверительногоУправления, ТекущаяДата());
	
	МассивСчетов = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(ЭтаФорма.КлиентДУ,	ЭтаФорма.Организация, ТекущаяДата());	
	
	Для каждого СчетДУ Из МассивСчетов Цикл
		Если СчетДУ <> ЭтаФорма.СчетДоверительногоУправления Тогда
			СчетаКлиента.Добавить(СчетДУ,, Истина);
			Если СчетДУ.ВидДоговораДоверительногоУправления <> Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
				СчетаКлиентаБезПН.Добавить(СчетДУ,, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьНастройкиВидимостиНаСервере();
	
	ОбновитьРасчетныеНастройкиНаСервере();
	ОбновитьОбщиеНастройкиНаСервере();
	
	МассивОбновленныхСтраниц = Новый Массив;
	МассивОбновленныхСтраниц.Добавить("НастройкиУчетаОбщие");
	ЭтаФорма.АдресМассиваОбновленныхСтраниц = ПоместитьВоВременноеХранилище(МассивОбновленныхСтраниц, ЭтаФорма.УникальныйИдентификатор);
	
	УстановитьВидимостьВЗависимостиОтВедущихсяУчетовНаСервере(); 
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
