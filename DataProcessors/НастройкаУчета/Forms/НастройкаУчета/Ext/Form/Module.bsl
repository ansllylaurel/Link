	ПредставлениеНастройки = "СЧА: " + ВидЗадолженностиПредставление + " — " + ТипИСинонимНастройки.СинонимНастройки;
	
	НовыеДанныеНастройки = ОткрытьФормуМодально("Обработка.НастройкаУчета.Форма.РедактированиеНастройкиУчета",
		Новый Структура("ДатаЗначения,ПредставлениеНастройки,ЗначениеНастройки,ТипЗначения,СчетДоверительногоУправления,СчетаКлиента",
			ДатаЗначения, ПредставлениеНастройки, ЗначениеНастройки, ТипИСинонимНастройки.ТипЗначения, 
			СчетДоверительногоУправления, ЭтаФорма.СчетаКлиента), ЭтаФорма);
			
	Если ЗначениеЗаполнено(НовыеДанныеНастройки) Тогда
		НовыеДанныеНастройки.СчетаКлиента.Добавить(ЭтаФорма.СчетДоверительногоУправления, , Истина);
		Если УстановитьЗначениеНастройкиФормированияСЧАНаСервере(НовыеДанныеНастройки.ДатаЗначения, 
				ИмяЗначения, 
				НовыеДанныеНастройки.ЗначениеНастройки,
				ВидЗадолженности,
				НовыеДанныеНастройки.СчетаКлиента) Тогда
			
			КлючиРазвернутыхСтрок = Неопределено;
			РаботаСФормамиКлиент.ПолучитьКлючиРазвернутыхСтрокДерева(ЭтаФорма.ФормированияСЧАПоВидамЗадолженности, ЭтаФорма.Элементы.ФормированияСЧАПоВидамЗадолженности,, КлючиРазвернутыхСтрок);
			
			ОбновитьНастройкиФормированияСЧАПоВидамЗадолженностиНаСервере();
			
			РаботаСФормамиКлиент.ВосстановитьРазвернутыеСтрокиДереваПоКлючу(ЭтаФорма.ФормированияСЧАПоВидамЗадолженности, ЭтаФорма.Элементы.ФормированияСЧАПоВидамЗадолженности,, КлючиРазвернутыхСтрок);
			РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.ФормированияСЧАПоВидамЗадолженности, ЭтаФорма.Элементы.ФормированияСЧАПоВидамЗадолженности,, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидЗадолженности, "Код") + ИмяЗначения);
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//События смен страниц
&НаКлиенте
Процедура НастройкиУчетаПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница.Имя = "НастройкиУчетаАктивов" Тогда
		Страницы = Элементы.НастройкиУчетаАктивовПоРегистрам;
		НастройкиУчетаАктивовПоРегистрамПриСменеСтраницы(Страницы, Страницы.ТекущаяСтраница);		
	ИначеЕсли ТекущаяСтраница.Имя = "НастройкиУчетаКомиссии" Тогда
		Страницы = Элементы.НастройкиКомиссииПоРегистрам;
		НастройкиКомиссииПоРегистрамПриСменеСтраницы(Страницы, Страницы.ТекущаяСтраница);
	ИначеЕсли ТекущаяСтраница.Имя = "НастройкиПоВидуУчета" Тогда
		Страницы = Элементы.НастройкиПоВидуУчетаПоРегистрам;
		НастройкиПоВидуУчетаПоРегистрамПриСменеСтраницы(Страницы, Страницы.ТекущаяСтраница);
	ИначеЕсли ТекущаяСтраница.Имя = "НастройкиЗакрытияСчетов" Тогда
		Страницы = Элементы.НастройкиЗакрытияСчетовПоРегистрам;
		НастройкиЗакрытияСчетовПоРегистрамПриСменеСтраницы(Страницы, Страницы.ТекущаяСтраница);
	ИначеЕсли ТекущаяСтраница.Имя = "НастройкиФормированияСЧА" Тогда
		Страницы = Элементы.НастройкиФормированияСЧАПоРегистрам;
		НастройкиФормированияСЧАПоРегистрамПриСменеСтраницы(Страницы, Страницы.ТекущаяСтраница);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиУчетаАктивовПоРегистрамПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	МассивОбновленныхСтраниц = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресМассиваОбновленныхСтраниц);
	Если МассивОбновленныхСтраниц.Найти(ТекущаяСтраница.Имя) = Неопределено Тогда
		
		МассивОбновленныхСтраниц.Добавить(ТекущаяСтраница.Имя);
		ПоместитьВоВременноеХранилище(МассивОбновленныхСтраниц, ЭтаФорма.АдресМассиваОбновленныхСтраниц);
		
		Если ТекущаяСтраница.Имя = "НастройкиУчетаАктивовБухгалтерскийУчет" Тогда
			ОбновитьНастройкиАктивовПоРегиструНаСервере(ПредопределенноеЗначение("Перечисление.ВидыУчета.БухгалтерскийУчет"));
		ИначеЕсли ТекущаяСтраница.Имя = "НастройкиУчетаАктивовНалоговыйУчет" Тогда
			ОбновитьНастройкиАктивовПоРегиструНаСервере(ПредопределенноеЗначение("Перечисление.ВидыУчета.НалоговыйУчет"));
		ИначеЕсли ТекущаяСтраница.Имя = "НастройкиУчетаКлассификацииПоСрочностиЕПС" Тогда
			ОбновитьНастройкиАктивовПоРегиструНаСервере(ПредопределенноеЗначение("Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет"));
		ИначеЕсли ТекущаяСтраница.Имя = "НастройкиУчетаАктивовЕПС" Тогда
			ОбновитьНастройкиАктивовПоРегиструНаСервере(ПредопределенноеЗначение("Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет"), Истина);
		КонецЕсли; 
	
	КонецЕсли; 
	
