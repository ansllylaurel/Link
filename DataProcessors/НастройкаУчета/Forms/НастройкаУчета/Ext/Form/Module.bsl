&НаСервере
Процедура ОбновитьНастройкиВидаУчетаПоРегиструНаСервере(ВидУчета)
	
	РесурсыСГруппировкой = РегистрыСведений.НастройкиПоВидуУчета.ПолучитьГруппировкиНастроекПоВидуУчета();
	
	НастройкиДругихДоговоров = Неопределено;
	Если СчетаКлиента.Количество() > 0 Тогда
		Если ВидУчета <> Перечисления.ВидыУчета.НалоговыйУчет Тогда
			НастройкиДругихДоговоров = ПолучитьНастройкиВидаУчетаДругихДоговоровНаСервере(СчетаКлиента.ВыгрузитьЗначения(), ВидУчета);
		Иначе
			НастройкиДругихДоговоров = ПолучитьНастройкиВидаУчетаДругихДоговоровНаСервере(СчетаКлиентаБезПН.ВыгрузитьЗначения(), ВидУчета);
		КонецЕсли;
	КонецЕсли;
	
	Если ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет Тогда
		РеквизитФормы = ЭтаФорма.БухгалтерскийУчетНастройки;
	ИначеЕсли ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
		РеквизитФормы = ЭтаФорма.НалоговыйУчет;
	ИначеЕсли ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		РеквизитФормы = ЭтаФорма.ЕПС;
	КонецЕсли;
	
	РеквизитФормы.ПолучитьЭлементы().Очистить();
	
	ПредыдущаяГруппа = "";
	РодительскаяГруппа = "";
	
	Для каждого СтрокаРесурсыСГруппировкой Из РесурсыСГруппировкой Цикл
		
		Если СтрокаРесурсыСГруппировкой.Группа <> ПредыдущаяГруппа Тогда // создаем новую группу
		
			РодительскаяГруппа = РеквизитФормы.ПолучитьЭлементы().Добавить();
			РодительскаяГруппа.Картинка = 6;
			РодительскаяГруппа.ИмяНастройки = "";
			РодительскаяГруппа.ПредставлениеНастройки = СтрокаРесурсыСГруппировкой.Группа;
			РодительскаяГруппа.Ключ = РодительскаяГруппа.ПредставлениеНастройки; // группы виртуальные, у них только представление есть
			
			ПредыдущаяГруппа = СтрокаРесурсыСГруппировкой.Группа;
		
		КонецЕсли;
		
		РеквизитВДереве = РодительскаяГруппа.ПолучитьЭлементы().Добавить();
		РеквизитВДереве.Картинка = ОпределитьИконкуНаСервере(Метаданные.РегистрыСведений.НастройкиПоВидуУчета.Ресурсы[СтрокаРесурсыСГруппировкой.Имя].Тип);
		РеквизитВДереве.ИмяНастройки = СтрокаРесурсыСГруппировкой.Имя;
		РеквизитВДереве.ПредставлениеНастройки = СтрокаРесурсыСГруппировкой.Синоним;
		РеквизитВДереве.Ключ = РеквизитВДереве.ИмяНастройки;
		
		ИсторияЗначений = ПолучитьИсториюЗначенийРеквизитаВидаУчетаНаСервере(РеквизитВДереве.ИмяНастройки, ВидУчета);
		Если ИсторияЗначений.Количество() > 0 Тогда
			Для каждого СтрокаИстории Из ИсторияЗначений Цикл
				Если ИсторияЗначений.Индекс(СтрокаИстории) = 0 Тогда
					РеквизитВДереве.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита;
					РеквизитВДереве.ДатаЗначения = СтрокаИстории.Период;
					РеквизитВДереве.ОтображаемаяДата = СтрокаИстории.Период;
					Если НастройкиДругихДоговоров <> Неопределено Тогда
						РеквизитВДереве.ДругиеДоговора = НастройкаДляДругихДоговоровНаСервере(РеквизитВДереве.ИмяНастройки, РеквизитВДереве.ЗначениеНастройки, НастройкиДругихДоговоров);
					КонецЕсли;
				Иначе
					Если РеквизитВДереве.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита И
						РеквизитВДереве.ПолучитьЭлементы().Количество() = 0 Тогда
						РеквизитВДереве.ДатаЗначения = СтрокаИстории.Период;
						РеквизитВДереве.ОтображаемаяДата = СтрокаИстории.Период;
					Иначе
						ПериодВРеквизите = РеквизитВДереве.ПолучитьЭлементы().Добавить();
						ПериодВРеквизите.Картинка = 5;
						ПериодВРеквизите.ИмяНастройки = СтрокаРесурсыСГруппировкой.Имя;
						ПериодВРеквизите.ПредставлениеНастройки = "Значение на " + Формат(СтрокаИстории.Период, "ДФ=dd.MM.yyyy");
						ПериодВРеквизите.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита;
						ПериодВРеквизите.ДатаЗначения = СтрокаИстории.Период;
						ПериодВРеквизите.Ключ = "";
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

