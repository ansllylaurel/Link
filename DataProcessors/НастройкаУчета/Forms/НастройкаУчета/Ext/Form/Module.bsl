			ДатаНастроек = Макс(ДатаНастроек, ВыборкаДетальныеЗаписи.Период);
		КонецЕсли;
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ВсеПоля КАК ВсеПоля
		|ИЗ
		|	РегистрСведений.НастройкиЗакрытияБухгалтерскихСчетов.СрезПоследних(
		|			&Период,
		|			Организация = &Организация И ВидУчета = &ВидУчета
		|				И СчетДоверительногоУправления В (&СчетаДоверительногоУправления)) КАК НастройкиУчетаКомиссииСрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("Период", ДатаНастроек);
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаКлиента);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВсеПоля КАК ВсеПоля", "*");
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Процедура ОбновитьНастройкиЗакрытияПоРегиструНаСервере(ВидУчета)
	
	НастройкиДругихДоговоров = Неопределено;
	Если СчетаКлиента.Количество() > 0 Тогда
		НастройкиДругихДоговоров = ПолучитьНастройкиЗакрытияДругихДоговоровНаСервере(СчетаКлиента.ВыгрузитьЗначения(), ВидУчета);
	КонецЕсли;
	
	Если ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет Тогда
		РеквизитФормы = ЭтаФорма.ЗакрытияБухгалтерскийУчет;
	ИначеЕсли ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
		РеквизитФормы = ЭтаФорма.ЗакрытияНалоговыйУчет;
	ИначеЕсли ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		РеквизитФормы = ЭтаФорма.ЗакрытияЕПС;
	КонецЕсли;
	
	РеквизитФормы.ПолучитьЭлементы().Очистить();
	
	ВариантыЗакрытияБухгалтерскихСчетов = ПолучитьВариантыЗакрытияБухгалтерскихСчетовНаСервере(ВидУчета);
	
	Для каждого ВариантЗакрытия Из ВариантыЗакрытияБухгалтерскихСчетов Цикл
		
		ВариантЗакрытияВДереве = РеквизитФормы.ПолучитьЭлементы().Добавить();
		ВариантЗакрытияВДереве.Картинка = 6;
		ВариантЗакрытияВДереве.ИмяНастройки = "";
		ВариантЗакрытияВДереве.ПредставлениеНастройки = Метаданные.Перечисления.ВариантыЗакрытияБухгалтерскихСчетов.ЗначенияПеречисления[Перечисления.ВариантыЗакрытияБухгалтерскихСчетов.Индекс(ВариантЗакрытия)].Синоним;
		ВариантЗакрытияВДереве.ВариантЗакрытия = ВариантЗакрытия;
		ВариантЗакрытияВДереве.Ключ = ВариантЗакрытияВДереве.ПредставлениеНастройки;
		
		Для каждого Ресурс Из Метаданные.РегистрыСведений.НастройкиЗакрытияБухгалтерскихСчетов.Ресурсы Цикл
			
			РеквизитВДереве = ВариантЗакрытияВДереве.ПолучитьЭлементы().Добавить();
			РеквизитВДереве.Картинка = ОпределитьИконкуНаСервере(Ресурс.Тип);
			РеквизитВДереве.ИмяНастройки = Ресурс.Имя;
			РеквизитВДереве.ПредставлениеНастройки = Ресурс.Синоним;
			РеквизитВДереве.ВариантЗакрытия = ВариантЗакрытия;
			РеквизитВДереве.Ключ = ВариантЗакрытияВДереве.Ключ + РеквизитВДереве.ИмяНастройки;
			
			ИсторияЗначений = ПолучитьИсториюЗначенийРеквизитаЗакрытияНаСервере(РеквизитВДереве.ИмяНастройки, ВариантЗакрытия, ВидУчета);
			Если ИсторияЗначений.Количество() > 0 Тогда
				Для каждого СтрокаИстории Из ИсторияЗначений Цикл
					Если ИсторияЗначений.Индекс(СтрокаИстории) = 0 Тогда
						РеквизитВДереве.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита;
						РеквизитВДереве.ДатаЗначения = СтрокаИстории.Период;
						РеквизитВДереве.ОтображаемаяДата = СтрокаИстории.Период;
						
						Если НастройкиДругихДоговоров <> Неопределено Тогда
							РеквизитВДереве.ДругиеДоговора = НастройкаДляДругихДоговоровНаСервере(РеквизитВДереве.ИмяНастройки, РеквизитВДереве.ЗначениеНастройки, НастройкиДругихДоговоров,,, ВариантЗакрытия);
						КонецЕсли;
						
					Иначе
						Если РеквизитВДереве.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита И
							РеквизитВДереве.ПолучитьЭлементы().Количество() = 0 Тогда
							РеквизитВДереве.ДатаЗначения = СтрокаИстории.Период;
							РеквизитВДереве.ОтображаемаяДата = СтрокаИстории.Период;
						Иначе
							ПериодВРеквизите = РеквизитВДереве.ПолучитьЭлементы().Добавить();
							ПериодВРеквизите.Картинка = 5;
							ПериодВРеквизите.ИмяНастройки = Ресурс.Имя;
							ПериодВРеквизите.ПредставлениеНастройки = "Значение на " + Формат(СтрокаИстории.Период, "ДФ=dd.MM.yyyy");
							ПериодВРеквизите.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита;
							ПериодВРеквизите.ДатаЗначения = СтрокаИстории.Период;
							ПериодВРеквизите.ВариантЗакрытия = ВариантЗакрытия;
							ПериодВРеквизите.Ключ = "";
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла; 
	
КонецПроцедуры

//Настройки формирования СЧА
&НаСервере
Функция ПолучитьИсториюЗначенийРеквизитаНастройкиФормированияСЧАНаСервере(ИмяРеквизита)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиФормированияСЧА.Период КАК Период,
		|	НастройкиФормированияСЧА." + ИмяРеквизита + " КАК ЗначениеРеквизита
		|ИЗ
		|	РегистрСведений.НастройкиФормированияСЧА КАК НастройкиФормированияСЧА
		|ГДЕ
		|	НастройкиФормированияСЧА.Организация = &Организация
		|	И НастройкиФормированияСЧА.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";

	Запрос.УстановитьПараметр("Организация", Этаформа.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Этаформа.СчетДоверительногоУправления);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Функция УстановитьЗначениеНастройкиФормированияСЧАНаСервере(ДатаЗначения, ИмяЗначения, Значение, ВидЗадолженности = Неопределено, СчетаКлиента)
	
	УстановкаЗавершена = Ложь;
	
	Для Каждого СтрокаСчетаКлиента Из СчетаКлиента Цикл
		Если СтрокаСчетаКлиента.Пометка Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НастройкиФормированияСЧАСрезПоследних.*
			|ИЗ
			|	РегистрСведений.НастройкиФормированияСЧА.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиФормированияСЧАСрезПоследних";
			
			Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
			Запрос.УстановитьПараметр("Период", ДатаЗначения);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", СтрокаСчетаКлиента.Значение);
			Если ВидЗадолженности <> Неопределено Тогда
				Запрос.Текст = СтрЗаменить(Запрос.Текст, ".НастройкиФормированияСЧА.", ".НастройкиФормированияСЧАПоВидамЗадолженности.");
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "СчетДоверительногоУправления = &СчетДоверительногоУправления", "СчетДоверительногоУправления = &СчетДоверительногоУправления И ВидЗадолженности = &ВидЗадолженности");
				Запрос.УстановитьПараметр("ВидЗадолженности"			, ВидЗадолженности);
			КонецЕсли;	
			
			ДанныеНастройки = Запрос.Выполнить().Выгрузить();
			Если ДанныеНастройки.Количество() = 0 Тогда
				СтрокаДанных = ДанныеНастройки.Добавить();
			Иначе
				СтрокаДанных = ДанныеНастройки[0];	
			КонецЕсли;
			СтрокаДанных.Период = ДатаЗначения;
			СтрокаДанных.Организация = ЭтаФорма.Организация;
			СтрокаДанных.СчетДоверительногоУправления = СтрокаСчетаКлиента.Значение;
			Если ВидЗадолженности <> Неопределено Тогда
				СтрокаДанных.ВидЗадолженности = ВидЗадолженности;
			КонецЕсли;	
			
			Если СтрокаДанных[ИмяЗначения] <> Значение Тогда
				СтрокаДанных[ИмяЗначения] = Значение;
				
				Если ВидЗадолженности = Неопределено Тогда
					Записи = РегистрыСведений.НастройкиФормированияСЧА.СоздатьНаборЗаписей();
				Иначе
					Записи = РегистрыСведений.НастройкиФормированияСЧАПоВидамЗадолженности.СоздатьНаборЗаписей();
				КонецЕсли;	
				Записи.Отбор.Период.Установить(ДатаЗначения);
				Записи.Отбор.Организация.Установить(ЭтаФорма.Организация);
				Записи.Отбор.СчетДоверительногоУправления.Установить(СтрокаСчетаКлиента.Значение);
				Если ВидЗадолженности <> Неопределено Тогда
					Записи.Отбор.ВидЗадолженности.Установить(ВидЗадолженности);
				КонецЕсли;	
				
				Записи.Прочитать();
				Записи.Загрузить(ДанныеНастройки);
				Записи.Записать();
				
				УстановкаЗавершена = Истина;
				
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Изменено значение настройки для счета ДУ: %1", СтрокаСчетаКлиента.Значение));
		КонецЕсли;
	КонецЦикла;
	
	Возврат УстановкаЗавершена;
	
КонецФункции

&НаСервере
Процедура ОбновитьНастройкиФормированияСЧАНаСервере()
	
	РесурсыСГруппировкой = РегистрыСведений.НастройкиФормированияСЧА.ПолучитьГруппировкиОбщихНастроек();
	
	ПредыдущаяГруппа = "";
	РодительскаяГруппа = "";
	
	НастройкиДругихДоговоров = Неопределено;
	Если СчетаКлиента.Количество() > 0 Тогда
		НастройкиДругихДоговоров = ПолучитьНастройкиФормированияСЧАНаСервере(СчетаКлиента.ВыгрузитьЗначения(), "НастройкиФормированияСЧА");
	КонецЕсли;
	
	ЭтаФорма.ФормированияСЧА.ПолучитьЭлементы().Очистить();
	
	Для каждого СтрокаРесурсыСГруппировкой Из РесурсыСГруппировкой Цикл
	
		Если СтрокаРесурсыСГруппировкой.Группа <> ПредыдущаяГруппа Тогда // создаем новую группу
		
			Если СтрокаРесурсыСГруппировкой.Группа = "!корень" Тогда // этих без групп
			
				РодительскаяГруппа = ЭтаФорма.ФормированияСЧА;
				
			Иначе
				
				РодительскаяГруппа = ЭтаФорма.ФормированияСЧА.ПолучитьЭлементы().Добавить();
				РодительскаяГруппа.Картинка = 6;
				РодительскаяГруппа.ИмяНастройки = "";
				РодительскаяГруппа.ПредставлениеНастройки = СтрокаРесурсыСГруппировкой.Группа;
				РодительскаяГруппа.Ключ = РодительскаяГруппа.ПредставлениеНастройки;
			
			КонецЕсли;
			
			ПредыдущаяГруппа = СтрокаРесурсыСГруппировкой.Группа;
		
		КонецЕсли;
		
		РеквизитВДереве = РодительскаяГруппа.ПолучитьЭлементы().Добавить();
		РеквизитВДереве.Картинка = ОпределитьИконкуНаСервере(Метаданные.РегистрыСведений.НастройкиФормированияСЧА.Ресурсы[СтрокаРесурсыСГруппировкой.Имя].Тип);
		РеквизитВДереве.ИмяНастройки = СтрокаРесурсыСГруппировкой.Имя;
		РеквизитВДереве.ПредставлениеНастройки = СтрокаРесурсыСГруппировкой.Синоним;
		РеквизитВДереве.Ключ = РеквизитВДереве.ИмяНастройки;
		
		ИсторияЗначений = ПолучитьИсториюЗначенийРеквизитаНастройкиФормированияСЧАНаСервере(РеквизитВДереве.ИмяНастройки);
		Если ИсторияЗначений.Количество() > 0 Тогда
			Для каждого СтрокаИстории Из ИсторияЗначений Цикл
				Если ИсторияЗначений.Индекс(СтрокаИстории) = 0 Тогда
					РеквизитВДереве.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита;
					РеквизитВДереве.ДатаЗначения = СтрокаИстории.Период;
					РеквизитВДереве.ОтображаемаяДата = СтрокаИстории.Период;
					
					Если НастройкиДругихДоговоров <> Неопределено И СтрокаРесурсыСГруппировкой.Группа <> "!корень" Тогда
						РеквизитВДереве.ДругиеДоговора = НастройкаДляДругихДоговоровНаСервере(РеквизитВДереве.ИмяНастройки, РеквизитВДереве.ЗначениеНастройки, НастройкиДругихДоговоров);
					КонецЕсли;
				Иначе
					Если РеквизитВДереве.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита И
						РеквизитВДереве.ПолучитьЭлементы().Количество() = 0 Тогда
						РеквизитВДереве.ДатаЗначения = СтрокаИстории.Период;
						РеквизитВДереве.ОтображаемаяДата = СтрокаИстории.Период;
					Иначе
						ПериодВРеквизите = РеквизитВДереве.ПолучитьЭлементы().Добавить();
						ПериодВРеквизите.Картинка = 5;
						ПериодВРеквизите.ИмяНастройки = СтрокаРесурсыСГруппировкой.Имя;
						ПериодВРеквизите.ПредставлениеНастройки = "Значение на " + Формат(СтрокаИстории.Период, "ДФ=dd.MM.yyyy");
						ПериодВРеквизите.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита;
						ПериодВРеквизите.ДатаЗначения = СтрокаИстории.Период;
						ПериодВРеквизите.Ключ = "";
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

//Настройки формирования СЧА по видам задолженности
&НаСервере
Функция ПолучитьИсториюЗначенийРеквизитаФормированияСЧАПоВидамЗадолженностиНаСервере(ИмяРеквизита, ВидЗадолженности)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиФормированияСЧАПоВидамЗадолженности.Период КАК Период,
		|	НастройкиФормированияСЧАПоВидамЗадолженности." + ИмяРеквизита + " КАК ЗначениеРеквизита
		|ИЗ
		|	РегистрСведений.НастройкиФормированияСЧАПоВидамЗадолженности КАК НастройкиФормированияСЧАПоВидамЗадолженности
		|ГДЕ
		|	НастройкиФормированияСЧАПоВидамЗадолженности.Организация = &Организация
		|	И НастройкиФормированияСЧАПоВидамЗадолженности.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И НастройкиФормированияСЧАПоВидамЗадолженности.ВидЗадолженности = &ВидЗадолженности
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";

	Запрос.УстановитьПараметр("Организация"					, Этаформа.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Этаформа.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидЗадолженности"			, ВидЗадолженности);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Функция ПолучитьНастройкиФормированияСЧАНаСервере(СчетаКлиента, НаименованиеРегистра)

	ДатаНастроек = ТекущаяДата();	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(НастройкиФормированияСЧА.Период) КАК Период
		|ИЗ
		|	РегистрСведений." + НаименованиеРегистра + " КАК НастройкиФормированияСЧА
		|ГДЕ
		|	НастройкиФормированияСЧА.Организация = &Организация
		|	И НастройкиФормированияСЧА.СчетДоверительногоУправления = &СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ВыборкаДетальныеЗаписи.Период <> Null Тогда
			ДатаНастроек = Макс(ДатаНастроек, ВыборкаДетальныеЗаписи.Период);
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ВсеПоля КАК ВсеПоля
		|ИЗ
		|	РегистрСведений." + НаименованиеРегистра + ".СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В (&СчетаДоверительногоУправления)) КАК НастройкиФормированияСЧА";
	
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("Период", ДатаНастроек);
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаКлиента);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВсеПоля КАК ВсеПоля", "*");
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Процедура ОбновитьНастройкиФормированияСЧАПоВидамЗадолженностиНаСервере()
	
	РеквизитФормы = ЭтаФорма.ФормированияСЧАПоВидамЗадолженности;
	РеквизитФормы.ПолучитьЭлементы().Очистить();
	
	НастройкиДругихДоговоров = Неопределено;
	Если СчетаКлиента.Количество() > 0 Тогда
		НастройкиДругихДоговоров = ПолучитьНастройкиФормированияСЧАНаСервере(СчетаКлиента.ВыгрузитьЗначения(), "НастройкиФормированияСЧАПоВидамЗадолженности");
	КонецЕсли;
	
	ВидЗадолженности = РегистрыСведений.НастройкиФормированияСЧАПоВидамЗадолженности.ВидыЗадолженности();
	Пока ВидЗадолженности.Следующий() Цикл
		
		ВидЗадолженностиВДереве = РеквизитФормы.ПолучитьЭлементы().Добавить();
		ВидЗадолженностиВДереве.Картинка = 6;
		ВидЗадолженностиВДереве.ИмяНастройки = "";
		ВидЗадолженностиВДереве.ПредставлениеНастройки = ВидЗадолженности.Наименование;
		ВидЗадолженностиВДереве.ВидЗадолженности = ВидЗадолженности.Ссылка;
		ВидЗадолженностиВДереве.Ключ = ВидЗадолженности.Код;
		
		Для каждого Ресурс Из Метаданные.РегистрыСведений.НастройкиФормированияСЧАПоВидамЗадолженности.Ресурсы Цикл
			
			РеквизитВДереве = ВидЗадолженностиВДереве.ПолучитьЭлементы().Добавить();
			РеквизитВДереве.Картинка = ОпределитьИконкуНаСервере(Ресурс.Тип);
			РеквизитВДереве.ИмяНастройки = Ресурс.Имя;
			РеквизитВДереве.ПредставлениеНастройки = Ресурс.Синоним;
			РеквизитВДереве.ВидЗадолженности = ВидЗадолженности.Ссылка;
			РеквизитВДереве.Ключ = ВидЗадолженности.Код + РеквизитВДереве.ИмяНастройки;
			
			ИсторияЗначений = ПолучитьИсториюЗначенийРеквизитаФормированияСЧАПоВидамЗадолженностиНаСервере(РеквизитВДереве.ИмяНастройки, ВидЗадолженности.Ссылка);
			Если ИсторияЗначений.Количество() > 0 Тогда
				Для каждого СтрокаИстории Из ИсторияЗначений Цикл
					Если ИсторияЗначений.Индекс(СтрокаИстории) = 0 Тогда
						РеквизитВДереве.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита;
						РеквизитВДереве.ДатаЗначения = СтрокаИстории.Период;
						РеквизитВДереве.ОтображаемаяДата = СтрокаИстории.Период;
						
						Если НастройкиДругихДоговоров <> Неопределено И РеквизитВДереве.ПолучитьРодителя() <> Неопределено Тогда 
							РеквизитВДереве.ДругиеДоговора = НастройкаДляДругихДоговоровНаСервере(РеквизитВДереве.ИмяНастройки, РеквизитВДереве.ЗначениеНастройки, НастройкиДругихДоговоров, , РеквизитВДереве.ПолучитьРодителя().ВидЗадолженности);
						КонецЕсли;
					Иначе
						Если РеквизитВДереве.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита И
							РеквизитВДереве.ПолучитьЭлементы().Количество() = 0 Тогда
							РеквизитВДереве.ДатаЗначения = СтрокаИстории.Период;
							РеквизитВДереве.ОтображаемаяДата = СтрокаИстории.Период;
						Иначе
							ПериодВРеквизите = РеквизитВДереве.ПолучитьЭлементы().Добавить();
							ПериодВРеквизите.Картинка = 5;
							ПериодВРеквизите.ИмяНастройки = Ресурс.Имя;
							ПериодВРеквизите.ПредставлениеНастройки = "Значение на " + Формат(СтрокаИстории.Период, "ДФ=dd.MM.yyyy");
							ПериодВРеквизите.ЗначениеНастройки = СтрокаИстории.ЗначениеРеквизита;
							ПериодВРеквизите.ДатаЗначения = СтрокаИстории.Период;
							ПериодВРеквизите.ВидЗадолженности = ВидЗадолженности.Ссылка;
							ПериодВРеквизите.Ключ = "";
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла; 
	
КонецПроцедуры

//События общие
&НаКлиенте
Процедура ОбщиеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Данные = ЭтаФорма.Общие;
	Элемент = ЭтаФорма.Элементы.Общие;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	ДатаЗначения = ТекущиеДанные.ДатаЗначения;
	ЗначениеНастройки = ТекущиеДанные.ЗначениеНастройки;
	ИмяЗначения = ТекущиеДанные.ИмяНастройки;
	
	Если ИмяЗначения = "" Тогда
		Возврат;
	КонецЕсли;
	
	ТипИСинонимНастройки = ОпределитьТипИСинонимНастройкиНаСервере(ИмяЗначения, "НастройкиУчетаОбщие");
	
	НовыеДанныеНастройки = ОткрытьФормуМодально("Обработка.НастройкаУчета.Форма.РедактированиеНастройкиУчета",
		Новый Структура("ДатаЗначения,ПредставлениеНастройки,ЗначениеНастройки,ТипЗначения,СчетДоверительногоУправления,СчетаКлиента",
			ДатаЗначения, ТипИСинонимНастройки.СинонимНастройки, ЗначениеНастройки, ТипИСинонимНастройки.ТипЗначения, 
			СчетДоверительногоУправления, ЭтаФорма.СчетаКлиента), ЭтаФорма);
			
	Если ЗначениеЗаполнено(НовыеДанныеНастройки) Тогда
				
 		ИзмениласьНастройкаДляРедактируемогоДоговора = УстановитьЗначениеОбщейНастройкиНаСервере(ЭтаФорма.СчетДоверительногоУправления, НовыеДанныеНастройки.ДатаЗначения, ИмяЗначения, НовыеДанныеНастройки.ЗначениеНастройки);
			
		Для каждого СтрокаСчетаКлиента Из НовыеДанныеНастройки.СчетаКлиента Цикл
			Если СтрокаСчетаКлиента.Пометка Тогда
				ИзмениласьНастройка = УстановитьЗначениеОбщейНастройкиНаСервере(СтрокаСчетаКлиента.Значение, НовыеДанныеНастройки.ДатаЗначения, ИмяЗначения, НовыеДанныеНастройки.ЗначениеНастройки);
				Если НЕ ИзмениласьНастройкаДляРедактируемогоДоговора И ИзмениласьНастройка Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Изменено значение настройки для счета ДУ: %1", СтрокаСчетаКлиента.Значение));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		КлючиРазвернутыхСтрок = Неопределено;
		РаботаСФормамиКлиент.ПолучитьКлючиРазвернутыхСтрокДерева(Данные, Элемент,, КлючиРазвернутыхСтрок);
		
		ОбновитьОбщиеНастройкиНаСервере();
		
		РаботаСФормамиКлиент.ВосстановитьРазвернутыеСтрокиДереваПоКлючу(Данные, Элемент,, КлючиРазвернутыхСтрок);
		РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(Данные, Элемент,, ИмяЗначения);
		
	КонецЕсли;

КонецПроцедуры

//События по виду учета
&НаКлиенте
Процедура ВидУчетаВыбор(ВидУчета)
	
	ИмяТекущегоЭлементаИРеквизита = ОпределитьИмяТекущегоЭлементаИРеквизита();
	
	Данные = ЭтаФорма[ИмяТекущегоЭлементаИРеквизита];
	Элемент = ЭтаФорма.Элементы[ИмяТекущегоЭлементаИРеквизита];
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	ИмяЗначения = ТекущиеДанные.ИмяНастройки;
	Если ИмяЗначения = "" Тогда
		Возврат 
	КонецЕсли;
	
	ДатаЗначения = ТекущиеДанные.ДатаЗначения;
	ЗначениеНастройки = ТекущиеДанные.ЗначениеНастройки;
	
	ТипИСинонимНастройки = ОпределитьТипИСинонимНастройкиНаСервере(ИмяЗначения, "НастройкиПоВидуУчета");
	
	ПредставлениеНастройки = Строка(ВидУчета) + ": " + ТипИСинонимНастройки.СинонимНастройки;
	
	Если ВидУчета <> ПредопределенноеЗначение("Перечисление.ВидыУчета.НалоговыйУчет") Тогда
		СписокСчетовКлиента = ЭтаФорма.СчетаКлиента;
	Иначе
		СписокСчетовКлиента = ЭтаФорма.СчетаКлиентаБезПН;
	КонецЕсли;
	НовыеДанныеНастройки = ОткрытьФормуМодально("Обработка.НастройкаУчета.Форма.РедактированиеНастройкиУчета",
		Новый Структура("ДатаЗначения,ПредставлениеНастройки,ЗначениеНастройки,ТипЗначения,СчетДоверительногоУправления,СчетаКлиента",
			ДатаЗначения, ПредставлениеНастройки, ЗначениеНастройки, ТипИСинонимНастройки.ТипЗначения, 
			СчетДоверительногоУправления, СписокСчетовКлиента), ЭтаФорма);
			
	Если ЗначениеЗаполнено(НовыеДанныеНастройки) Тогда
		ИзмениласьНастройкаДляРедактируемогоДоговора = УстановитьЗначениеНастройкиВидаУчетаНаСервере(ЭтаФорма.СчетДоверительногоУправления, НовыеДанныеНастройки.ДатаЗначения, ИмяЗначения, НовыеДанныеНастройки.ЗначениеНастройки, ВидУчета);
			
		Для каждого СтрокаСчетаКлиента Из НовыеДанныеНастройки.СчетаКлиента Цикл
			Если СтрокаСчетаКлиента.Пометка Тогда
				ИзмениласьНастройка = УстановитьЗначениеНастройкиВидаУчетаНаСервере(СтрокаСчетаКлиента.Значение, НовыеДанныеНастройки.ДатаЗначения, ИмяЗначения, НовыеДанныеНастройки.ЗначениеНастройки, ВидУчета);
				Если НЕ ИзмениласьНастройкаДляРедактируемогоДоговора И ИзмениласьНастройка Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Изменено значение настройки для счета ДУ: %1", СтрокаСчетаКлиента.Значение));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		КлючиРазвернутыхСтрок = Неопределено;
		РаботаСФормамиКлиент.ПолучитьКлючиРазвернутыхСтрокДерева(Данные, Элемент,, КлючиРазвернутыхСтрок);
		
		ОбновитьНастройкиВидаУчетаПоРегиструНаСервере(ВидУчета);
		
		РаботаСФормамиКлиент.ВосстановитьРазвернутыеСтрокиДереваПоКлючу(Данные, Элемент,, КлючиРазвернутыхСтрок);
		РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(Данные, Элемент,, ИмяЗначения);
		
	КонецЕсли;
	
КонецПроцедуры

