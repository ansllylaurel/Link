			|					_ДвиженияПартий.СуммаРезервовПодОбесценение > 0),
			|			&СубконтоЦБ_Р,
			|			СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
			|				И Субконто1 В
