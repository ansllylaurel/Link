
Процедура ОповеститьОНеправильныхОстаткахПоСчетамБухгалтерскогоУчета(Период, Организация, СчетДоверительногоУправления, ВидУчета, ПолучатьОтрицательноеСальдо = Истина, ПолучатьЗависшееСальдоПоВалютеИКоличеству = Ложь) 

	ТаблицаНеправильныхОстатковПоСчетамБухгалтерскогоУчета = БухгалтерскийУчетЕПС.ПолучитьТаблицуНеправильныхОстатковПоСчетамБухгалтерскогоУчета(Период, Организация, СчетДоверительногоУправления, ВидУчета, ПолучатьОтрицательноеСальдо, ПолучатьЗависшееСальдоПоВалютеИКоличеству);

	Если ТаблицаНеправильныхОстатковПоСчетамБухгалтерскогоУчета = Неопределено ИЛИ ТаблицаНеправильныхОстатковПоСчетамБухгалтерскогоУчета.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыОповещения = Новый Структура("Организация, СчетДоверительногоУправления, ВидУчета, Период", Организация, СчетДоверительногоУправления, ВидУчета, Период);
	
	КолонкаЛицевой = "";
	Если ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		КолонкаЛицевой = "<td><b>Лицевой счет</b></td>";	
	КонецЕсли;
	
	ТекстОповещения = "<table border=""0"" cellspacing=""1"" bgcolor=""#000000""><tr bgcolor=""#FFFFFF""><td><b>Счет</b></td><td><b>Субконто1</b></td><td><b>Субконто2</b></td><td><b>Субконто3</b></td><td><b>Валюта</b></td>" + КолонкаЛицевой + "<td><b>Ошибка</b></td></tr>";
	
	Для каждого СтрокаНеправильныхОстатковПоСчетамБухгалтерскогоУчета Из ТаблицаНеправильныхОстатковПоСчетамБухгалтерскогоУчета Цикл
		
		ТекстОповещения = ТекстОповещения + "<tr bgcolor=""#FFFFFF"">";
		
		ТекстОповещения = ТекстОповещения + "<td align = ""left"" valign = ""top"">" + Строка(СтрокаНеправильныхОстатковПоСчетамБухгалтерскогоУчета.Счет) + "</td>";
		ТекстОповещения = ТекстОповещения + "<td align = ""left"" valign = ""top"">" + Строка(СтрокаНеправильныхОстатковПоСчетамБухгалтерскогоУчета.Субконто1) + "</td>";
		ТекстОповещения = ТекстОповещения + "<td align = ""left"" valign = ""top"">" + Строка(СтрокаНеправильныхОстатковПоСчетамБухгалтерскогоУчета.Субконто2) + "</td>";
		ТекстОповещения = ТекстОповещения + "<td align = ""left"" valign = ""top"">" + Строка(СтрокаНеправильныхОстатковПоСчетамБухгалтерскогоУчета.Субконто3) + "</td>";
		ТекстОповещения = ТекстОповещения + "<td align = ""left"" valign = ""top"">" + Строка(СтрокаНеправильныхОстатковПоСчетамБухгалтерскогоУчета.Валюта) + "</td>";
		Если ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
			ТекстОповещения = ТекстОповещения + "<td align = ""left"" valign = ""top"">" + Строка(СтрокаНеправильныхОстатковПоСчетамБухгалтерскогоУчета.ЛицевойСчет) + "</td>";
		КонецЕсли;
		ТекстОповещения = ТекстОповещения + "<td align = ""left"" valign = ""top"">" + Строка(СтрокаНеправильныхОстатковПоСчетамБухгалтерскогоУчета.Ошибка) + "</td>";
		
		ТекстОповещения = ТекстОповещения + "</tr>";
	
	КонецЦикла;
	
	ТекстОповещения = ТекстОповещения + "</table>";
	
	РеквизитыОповещения.Вставить("ТекстОповещения", ТекстОповещения);
	
	Если Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ")
		И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
	
		Справочники.Оповещения.СформироватьОповещения("Обработка.ФормированиеБухгалтерскогоУчета.ПроверкаОстатковПоБухгалтерскомуУчету_ПИ_ПИФ", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);	
				
	Иначе
		
		Справочники.Оповещения.СформироватьОповещения("Обработка.ФормированиеБухгалтерскогоУчета.ПроверкаОстатковПоБухгалтерскомуУчету", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
	КонецЕсли;
	
КонецПроцедуры

Функция СтруктуруВТекст(Параметры) 

	Описание = "Параметры: Структура:";
	Для каждого КлючИЗначение Из Параметры Цикл
		Если ТипЗнч(КлючИЗначение.Значение) = Тип("Массив") И КлючИЗначение.Значение.Количество() = 1 Тогда
			Описание = Описание + Символы.ПС + КлючИЗначение.Ключ + ": " + КлючИЗначение.Значение[0];
		Иначе
			Описание = Описание + Символы.ПС + КлючИЗначение.Ключ + ": " + КлючИЗначение.Значение;
		КонецЕсли;
		
	КонецЦикла; 

	Возврат Описание;
	
КонецФункции

Функция ОбработатьСчетДУФоново(ПараметрыОбработки) Экспорт
	
	СеансИнформационнойБазы = ПолучитьТекущийСеансИнформационнойБазы();
	ФоновоеЗадание = СеансИнформационнойБазы.ПолучитьФоновоеЗадание();
	
	ПараметрыОбработки.Вставить("ИдентификаторЗадания", ФоновоеЗадание.УникальныйИдентификатор);
	ПараметрыОбработки.Вставить("НомерСеанса", СеансИнформационнойБазы.НомерСеанса);
	
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
										"Обработки.ФормированиеБухгалтерскогоУчета.ОбработатьСчетаДУФоново",
										Новый ХранилищеЗначения(ПараметрыОбработки, Новый СжатиеДанных(9)),
										СтруктуруВТекст(ПараметрыОбработки));		
										
										
	СчетДоверительногоУправления   = ПараметрыОбработки.СчетДоверительногоУправления;
	ВидУчета 					   = ПараметрыОбработки.ВидУчета;
	НачалоПериодаОбщее		   	   = ПараметрыОбработки.НачалоПериода;
	КонецПериода 			  	   = ПараметрыОбработки.КонецПериода;
	Организация 				   = ПараметрыОбработки.Организация;
	Пользователь 				   = ПараметрыОбработки.Пользователь;
	
	НачалоПериода			= НачалоПериодаОбщее;
	ДатаЗаключенияДоговора	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "ДатаЗаключения");		
	
	Если НачалоПериода < ДатаЗаключенияДоговора Тогда
		НачалоПериода = ДатаЗаключенияДоговора;
	КонецЕсли;
	
	ДатыПереоценок = РаботаСПереоценкой.ОпределитьДатыПереоценокЗаПериод(СчетДоверительногоУправления, ВидУчета, НачалоПериода, КонецПериода); 
	
	ТекущаяНачальнаяДата = НачалоДня(НачалоПериода);  	
			
	Отказ = Ложь;   
		
	Для Каждого СтрокаДатыПереоценок Из ДатыПереоценок Цикл
		
		ТекущаяКонечнаяДата = СтрокаДатыПереоценок.Дата;
		
		Сформировать(ТекущаяНачальнаяДата, КонецДня(ТекущаяКонечнаяДата), СчетДоверительногоУправления, ВидУчета, Организация, Пользователь, ФоновоеЗадание.УникальныйИдентификатор, СтрокаДатыПереоценок.Реформация, СтрокаДатыПереоценок.СледующийДеньПослеПредыдущейРеформации, Отказ);
		                
		Если Отказ Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон("По счету ДУ %1 формирование учета (%2) НЕ завершено за период с %3 по %4",
						СчетДоверительногоУправления,
						ВидУчета,
						ТекущаяНачальнаяДата,
						КонецДня(ТекущаяКонечнаяДата)));
			Прервать;
		КонецЕсли;
		
		ТекущаяНачальнаяДата = КонецДня(ТекущаяКонечнаяДата) + 1;
		
		Попытка
			// разрешаем двигать вперед даты запрета редактирования, даже без наличия
			// соответствующей роли ИзменениеДатыЗапрета, см. задачу
			УстановитьПривилегированныйРежим(Истина);
			
			УстановитьДатуЗапрета(Организация, СчетДоверительногоУправления, Перечисления.ГруппыЗапретаРедактирования.Партии, ВидУчета, ТекущаяКонечнаяДата);
			УстановитьДатуЗапрета(Организация, СчетДоверительногоУправления, Перечисления.ГруппыЗапретаРедактирования.Проводки, ВидУчета, ТекущаяКонечнаяДата);
			
			УстановитьПривилегированныйРежим(Ложь);
			
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка установки даты запрета редактирования проводок и партий на " + Формат(ТекущаяКонечнаяДата, "ДФ=dd.MM.yyyy"));
			Продолжить;
		КонецПопытки;
		
	КонецЦикла;			
			
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии("Обработки.ФормированиеБухгалтерскогоУчета.ОбработатьСчетаДУФоново", Сессия);
	
	Возврат НЕ Отказ;
	
КонецФункции

Процедура УстановитьДатуЗапрета(Организация, СчетДоверительногоУправления, ГруппаЗапретаРедактирования, ВидУчета, ДатаЗапрета)

	НаборЗаписей = РегистрыСведений.ДатыЗапретаРедактирования.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.Организация.Установить(Организация);
	НаборЗаписей.Отбор.СчетДоверительногоУправления.Установить(СчетДоверительногоУправления);
	НаборЗаписей.Отбор.ГруппаЗапрета.Установить(ГруппаЗапретаРедактирования);
	НаборЗаписей.Отбор.ВидУчета.Установить(ВидУчета);
	
	НаборЗаписей.ДополнительныеСвойства.Вставить("УстановкуДатЗапретаПроизводитФБУ", Истина);
	
	Запись = НаборЗаписей.Добавить();
	Запись.Организация                  = Организация;
	Запись.СчетДоверительногоУправления = СчетДоверительногоУправления;
	Запись.ГруппаЗапрета                = ГруппаЗапретаРедактирования;
	Запись.ВидУчета                		= ВидУчета;
	Запись.ДатаЗапретаРедактирования    = ДатаЗапрета;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура ВывестиПользователюСообщениеВремениВыполнения(ДатаФормирования, ТекстСообщения) // Сообщения для пользователя для понимания процесса

	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("# %1 : Формирование за %2 : %3", Формат(ТекущаяДата(), "ДФ=HH:mm:ss"), ДатаФормирования, ТекстСообщения));	

КонецПроцедуры

Процедура Сформировать(ТекущаяНачальнаяДата, ТекущаяКонечнаяДата, СчетДоверительногоУправления, ВидУчета, Организация, Пользователь, ФЗУИД, ДеньРеформацииБаланса, СледующийДеньПослеПредыдущейРеформации, Отказ)

	ТекущаяДатаФормированияСтр = Формат(ТекущаяКонечнаяДата, "ДФ=dd.MM.yyyy");
	
	ВывестиПользователюСообщениеВремениВыполнения(ТекущаяДатаФормированияСтр, "Начали формирование учета");
	
	ПараметрыОценки = Новый Структура();
	ПараметрыОценки.Вставить("ВидУчета", ВидУчета);
	ПараметрыОценки.Вставить("ЦельРасчета", БухгалтерскийУчет.ОпределитьЦельРасчетаПоВидуУчета(ВидУчета));
	
	//#699083 Попытка возможности регистрации стоимости переоценки без партий.
	РСПРассчитанаДоРасчетаПартий = ВыполнитьРасчетРСП(ТекущаяКонечнаяДата, Организация, СчетДоверительногоУправления, ВидУчета, ПараметрыОценки, Пользователь, ФЗУИД, Истина, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
		
	
	#Область РасчетПартий
	
	Оповещения = Новый Структура;
	Оповещения.Вставить("ДвиженияАктивовОцениваемыхПоАС", Новый Структура("Текст, Тема", "", "")); 
	// можно прикрепить другое оповещение.  Ключ структуры должен по имени совпадать с  последней частью идентификатора в спр. Оповещения.  
	// Например,  Обработка.ФормированиеБухгалтерскогоУчета.ДвиженияАктивовОцениваемыхПоАС
	
	РассчитатьПартии(Организация, СчетДоверительногоУправления, ТекущаяНачальнаяДата, ТекущаяКонечнаяДата, ВидУчета, Отказ, Оповещения, ФЗУИД);
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("По счету ДУ %1 не удалось рассчитать партии с %2 по %3, %4",
					СчетДоверительногоУправления,
					Формат(ТекущаяНачальнаяДата, "ДФ=dd.MM.yyyy"),
					Формат(ТекущаяКонечнаяДата, "ДФ=dd.MM.yyyy"),
					ВидУчета));
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	//рассылка оповещений
	Для Каждого Оповещение из Оповещения Цикл
		Если ЗначениеЗаполнено(Оповещение.Значение.Текст) Тогда 
			РеквизитыОповещения = Новый Структура("Организация, Текст, Тема", Организация, Оповещение.Значение.Текст, Оповещение.Значение.Тема);
			Справочники.Оповещения.СформироватьОповещения("Обработка.ФормированиеБухгалтерскогоУчета." + Оповещение.Ключ, Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		КонецЕсли;
	КонецЦикла;	
			
	ВывестиПользователюСообщениеВремениВыполнения(ТекущаяДатаФормированияСтр, "Произвели расчет партий");
	
	#КонецОбласти

	#Область РаспроведениеЗакрытийСчетов
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗакрытиеБухгалтерскихСчетов.Ссылка
		|ИЗ
		|	Документ.ЗакрытиеБухгалтерскихСчетов КАК ЗакрытиеБухгалтерскихСчетов
		|ГДЕ
		|	ЗакрытиеБухгалтерскихСчетов.Организация = &Организация
		|	И ЗакрытиеБухгалтерскихСчетов.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ЗакрытиеБухгалтерскихСчетов.Дата МЕЖДУ &НачальнаяДата И &КонечнаяДата
		|	И ЗакрытиеБухгалтерскихСчетов.Проведен
		|	И ЗакрытиеБухгалтерскихСчетов.ВидУчета = &ВидУчета";

	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачальнаяДата",                НачалоДня(ТекущаяКонечнаяДата));
	Запрос.УстановитьПараметр("КонечнаяДата",                 КонецДня(ТекущаяКонечнаяДата));
	Запрос.УстановитьПараметр("ВидУчета",					  ВидУчета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ДокументЗакрытияСчетов = Выборка.Ссылка.ПолучитьОбъект();
		
		Если НЕ ЗаписатьДокумент(ДокументЗакрытияСчетов, РежимЗаписиДокумента.ОтменаПроведения, ФЗУИД) Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
	#КонецОбласти
	
	#Область ФормированиеПроводок
	
	КэшироватьОстаткиДоходовРасходов = Истина;
	
	// проверяем настройки на начало и за период
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиУчетаОбщиеСрезПоследних.НеСворачиватьПоПарнымСчетамДоходыРасходыОтПереоценки КАК НеСворачиватьПоПарнымСчетамДоходыРасходыОтПереоценки,
		|	НастройкиУчетаОбщиеСрезПоследних.ОтражатьПартииНаЛицевыхСчетах КАК ОтражатьПартииНаЛицевыхСчетах
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
		|			&НачалоПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаОбщиеСрезПоследних
		|ГДЕ
		|	(НастройкиУчетаОбщиеСрезПоследних.НеСворачиватьПоПарнымСчетамДоходыРасходыОтПереоценки
		|			ИЛИ НастройкиУчетаОбщиеСрезПоследних.ОтражатьПартииНаЛицевыхСчетах)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НастройкиУчетаОбщие.НеСворачиватьПоПарнымСчетамДоходыРасходыОтПереоценки,
		|	НастройкиУчетаОбщие.ОтражатьПартииНаЛицевыхСчетах
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие КАК НастройкиУчетаОбщие
		|ГДЕ
		|	НастройкиУчетаОбщие.Период > &НачалоПериода
		|	И НастройкиУчетаОбщие.Период <= &ОкончаниеПериода
		|	И НастройкиУчетаОбщие.Организация = &Организация
		|	И НастройкиУчетаОбщие.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И (НастройкиУчетаОбщие.НеСворачиватьПоПарнымСчетамДоходыРасходыОтПереоценки
		|			ИЛИ НастройкиУчетаОбщие.ОтражатьПартииНаЛицевыхСчетах)";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ТекущаяКонечнаяДата));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ТекущаяКонечнаяДата));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	Если НЕ Запрос.Выполнить().Пустой() Тогда
	
		КэшироватьОстаткиДоходовРасходов = Ложь;
	
