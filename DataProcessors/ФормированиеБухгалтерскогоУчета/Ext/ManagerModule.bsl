			|
			|ИНДЕКСИРОВАТЬ ПО
			|	СчетДоверительногоУправления,
			|	СчетУчетаРезерва,
			|	ЦеннаяБумага
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////";
	ИначеЕсли ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Или ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет Тогда			
		Запрос.Текст = Запрос.Текст + "
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумаг.СтрокаКорзиныЦенныхБумаг КАК СтрокаКорзиныЦенныхБумаг,
			|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
			|	БухПартииЦенныхБумаг.ВидДвижения КАК ВидДвижения,
			|	СУММА(БухПартииЦенныхБумаг.Количество) КАК Количество,
			|	СУММА(БухПартииЦенныхБумаг.Стоимость) КАК Стоимость,
			|	СУММА(БухПартииЦенныхБумаг.РасходыПриПокупкеВСтоимости) КАК РасходыПриПокупкеВСтоимости,
			|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупона) КАК СтоимостьКупона,
			|	СУММА(БухПартииЦенныхБумаг.Переоценка) КАК Переоценка,
			|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупона) КАК ПереоценкаКупона,
			|	СУММА(БухПартииЦенныхБумаг.СуммаЧастичногоПогашения) КАК СуммаЧастичногоПогашения,
			|	ВЫБОР
			|		КОГДА БухПартииЦенныхБумаг.Количество = 0
			|				И БухПартииЦенныхБумаг.Стоимость = 0
			|				И БухПартииЦенныхБумаг.СтоимостьКупона = 0
			|				И БухПартииЦенныхБумаг.Переоценка = 0
			|				И БухПартииЦенныхБумаг.ПереоценкаКупона = 0
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК Перекурсовка,
			|	ВЫБОР
			|		КОГДА БухПартииЦенныхБумаг.Количество = 0
			|				И (БухПартииЦенныхБумаг.ИндексацияНоминала <> 0
			|					ИЛИ БухПартииЦенныхБумаг.ИндексацияНоминалаЗаВремяВладения <> 0)
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК ДвижениеИндексацииНоминала,
			|	ВЫБОР
			|		КОГДА БухПартииЦенныхБумаг.Количество = 0
			|				И (БухПартииЦенныхБумаг.Переоценка <> 0
			|					ИЛИ БухПартииЦенныхБумаг.ПереоценкаКупона <> 0
			|					ИЛИ БухПартииЦенныхБумаг.Стоимость <> 0
			|					ИЛИ БухПартииЦенныхБумаг.СтоимостьКупона <> 0)
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК Дооценка,
			|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
			|	СУММА(БухПартииЦенныхБумаг.РасходыПриПокупкеВСтоимостиВВалютеУчета) КАК РасходыПриПокупкеВСтоимостиВВалютеУчета,
			|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
			|	СУММА(БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
			|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета) КАК ПереоценкаКупонаВВалютеУчета,
			|	СУММА(БухПартииЦенныхБумаг.ИндексацияНоминала) КАК ИндексацияНоминала,
			|	СУММА(БухПартииЦенныхБумаг.ИндексацияНоминалаЗаВремяВладения) КАК ИндексацияНоминалаЗаВремяВладения,
			|	БухПартииЦенныхБумаг.Регистратор КАК Регистратор
			|ПОМЕСТИТЬ _ДвиженияПартийЗаПериод
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
			|ГДЕ
            |	БухПартииЦенныхБумаг.Период МЕЖДУ &ДатаН И &ДатаК
			|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
			|	И БухПартииЦенныхБумаг.Регистратор В
			|			(ВЫБРАТЬ
			|				_Документы.Документ
			|			ИЗ
			|				_Документы КАК _Документы)
			|	И БухПартииЦенныхБумаг.Активность
			|
			|СГРУППИРОВАТЬ ПО
			|	БухПартииЦенныхБумаг.СтрокаКорзиныЦенныхБумаг,
			|	БухПартииЦенныхБумаг.ЦеннаяБумага,
			|	БухПартииЦенныхБумаг.ВидДвижения,
			|	БухПартииЦенныхБумаг.Регистратор,
			|	ВЫБОР
			|		КОГДА БухПартииЦенныхБумаг.Количество = 0
			|				И (БухПартииЦенныхБумаг.ИндексацияНоминала <> 0
			|					ИЛИ БухПартииЦенныхБумаг.ИндексацияНоминалаЗаВремяВладения <> 0)
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА БухПартииЦенныхБумаг.Количество = 0
			|				И БухПартииЦенныхБумаг.Стоимость = 0
			|				И БухПартииЦенныхБумаг.СтоимостьКупона = 0
			|				И БухПартииЦенныхБумаг.Переоценка = 0
			|				И БухПартииЦенныхБумаг.ПереоценкаКупона = 0
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА БухПартииЦенныхБумаг.Количество = 0
			|				И (БухПартииЦенныхБумаг.Переоценка <> 0
			|					ИЛИ БухПартииЦенныхБумаг.ПереоценкаКупона <> 0
			|					ИЛИ БухПартииЦенныхБумаг.Стоимость <> 0
			|					ИЛИ БухПартииЦенныхБумаг.СтоимостьКупона <> 0)
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Регистратор
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////";
	КонецЕсли;	
	Запрос.Текст = Запрос.Текст + "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Документы.Документ КАК Документ
		|ИЗ
		|	_Документы КАК _Документы
		|
		|УПОРЯДОЧИТЬ ПО
		|	_Документы.Документ.МоментВремени";
	
	#КонецОбласти
	
	СубконтоЦБ_Р = Новый Массив;
	СубконтоЦБ_Р.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги);
	СубконтоЦБ_Р.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Резервы);
	
	Запрос.УстановитьПараметр("ДатаН",							ТекущаяНачальнаяДата);
	Запрос.УстановитьПараметр("ДатаК",							ТекущаяКонечнаяДата);
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("ВидУчета",						ВидУчета);
	Запрос.УстановитьПараметр("СписокСтратегий", 				Справочники.СчетаДоверительногоУправления.ПолучитьМассивСчетовПоДоговоруДУ(СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("ВключатьВводыВыводы",			СчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> Перечисления.ВидыДоговоровДоверительногоУправления.Собственный);
	Запрос.УстановитьПараметр("СубконтоЦБ_Р", СубконтоЦБ_Р);
	Запрос.УстановитьПараметр("АналитикаРезерваПоУмолчанию", Справочники.Резервы.РезервОбесценениеУбытки12Месяцев);
	Запрос.УстановитьПараметр("Период", Новый Граница(ТекущаяНачальнаяДата, ВидГраницы.Исключая));
	
	Если ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВыбытиеПоБУ", "ВыбытиеПоНУ");
	ИначеЕсли ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВыбытиеПоБУ", "ВыбытиеПоЕПС");
	КонецЕсли;
	
	ВидыУчетаДляПроведения = Новый Массив;
	ВидыУчетаДляПроведения.Добавить(ВидУчета);
	
	КоличествоПроведенныхДокументов = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	ВсегоДокументов = Выборка.Количество();
	Пока Выборка.Следующий() Цикл
		
		// т.к. корректировка может изменить остатки по счетам 7хх нам нужно обновить таблицу остатков
		Если ТипЗнч(Выборка.Документ) = Тип("ДокументСсылка.КорректировкаРегистров") Тогда
			
			Если КэшироватьОстаткиДоходовРасходов Тогда
			
				ТаблицаОстатков = БухгалтерскийУчетЕПС.ПолучитьТаблицуОстатковПоПарнымСчетамДоходовРасходов(
															Новый Граница(Выборка.Документ.МоментВремени(), ВидГраницы.Включая),
															Организация, 
															СчетДоверительногоУправления,
															Истина,
															Истина);
															
				Если ТаблицаОстатков = Неопределено Тогда
					Отказ = Истина;
					Возврат;
				КонецЕсли;
			
			КонецЕсли;
			
		    Продолжить;
			
		КонецЕсли;
		
		ДокументОбъект = Выборка.Документ.ПолучитьОбъект();
		
		Если ДокументОбъект.Метаданные().Движения.Содержит(Метаданные.НайтиПоПолномуИмени("РегистрБухгалтерии." + РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ВидУчета))) Тогда
			
			ДокументОбъект.ДополнительныеСвойства.Вставить("ЗаписьВСоставеФБУ", Истина);
			
			Если КэшироватьОстаткиДоходовРасходов Тогда
				ДокументОбъект.ДополнительныеСвойства.Вставить("ТаблицаОстатковПоПарнымСчетамДоходовРасходов", ТаблицаОстатков);		
			КонецЕсли;
			
			СообщенияСтарые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
			
			Попытка
				ДокументОбъект.ДополнительныеСвойства.Вставить("МенеджерВременныхТаблицДвиженияПартийЗаПериод", Запрос.МенеджерВременныхТаблиц);		
				
				Если ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
					ДокументОбъект.ПроведениеПоРегиструЕПС("ЕдиныйБухгалтерскийУчет", Отказ);
				Иначе
					ДокументОбъект.ПроведениеПоРегиструБухгалтерии(РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ВидУчета), Отказ);
				КонецЕсли;
				
				Для каждого НаборЗаписей Из ДокументОбъект.Движения Цикл
					Если НаборЗаписей.Записывать Тогда
						НаборЗаписей.ДополнительныеСвойства.Вставить("ЗаписьВСоставеФБУ", Истина);
						НаборЗаписей.Записать();
					КонецЕсли;
				КонецЦикла;
			Исключение
				ТекущаяОшибка = ОписаниеОшибки();
				
				ВыводитьВЖурнал = Истина;
				
				СообщенияНовые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
				Для Инд = СообщенияСтарые.Количество() По СообщенияНовые.Количество() - 1 Цикл
					ТекущаяОшибка = ТекущаяОшибка + Символы.ПС + СообщенияНовые[Инд];
					ВыводитьВЖурнал = Ложь; // есть сообщения - ошибка пользователя, а не программиста
				КонецЦикла;
				
				СообщениеОшибки = СтрШаблон("Не удалось сформировать проводки документа: %1, %2. Система сообщает: %3. Счет ДУ: %4",
					Выборка.Документ,
					ВидУчета,
					ТекущаяОшибка,
					СчетДоверительногоУправления);
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОшибки,,,, Отказ);
				
				Если ВыводитьВЖурнал Тогда
					ЗаписьЖурналаРегистрации("ФБУ.ПровестиДокумент", УровеньЖурналаРегистрации.Ошибка, Метаданные.Обработки.ФормированиеБухгалтерскогоУчета,, СообщениеОшибки);
				КонецЕсли;
				
							
				Отказ = Истина;
				Возврат;
			КонецПопытки;
			
			Если КэшироватьОстаткиДоходовРасходов Тогда
				ТаблицаОстатков = ДокументОбъект.ДополнительныеСвойства.ТаблицаОстатковПоПарнымСчетамДоходовРасходов;
			КонецЕсли;
			
		КонецЕсли;
		
		КоличествоПроведенныхДокументов = КоличествоПроведенныхДокументов + 1;
		Если КоличествоПроведенныхДокументов % 100 = 0 Тогда
		
			ВывестиПользователюСообщениеВремениВыполнения(ТекущаяДатаФормированияСтр, СтрШаблон("Провели %1 документов из %2", КоличествоПроведенныхДокументов, ВсегоДокументов));
		
		КонецЕсли;
		
	КонецЦикла;
	
	#КонецОбласти
	

	#Область РассчитываемСтоимостиБумаг
	
	Если Не РСПРассчитанаДоРасчетаПартий Тогда
		
		//заполним стоимости переоценок ЕПС
		
		ВыполнитьРасчетРСП(ТекущаяКонечнаяДата, Организация, СчетДоверительногоУправления, ВидУчета, ПараметрыОценки, Пользователь, ФЗУИД, , Отказ);
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	#КонецОбласти
	
	// ПереоценкаМНО
	ДокументМНО = ПереоценитьМНО(Организация, СчетДоверительногоУправления, ТекущаяКонечнаяДата, ВидУчета, Пользователь, ФЗУИД, ДеньРеформацииБаланса, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// ПереоценкаЗадолженностиПоДенежнымСредствам
	ДокументПереоценкаЗадолженностиПоДенежнымСредствам = ПереоценитьЗадолженностиПоДС(Организация, СчетДоверительногоУправления, ТекущаяКонечнаяДата, ВидУчета, Пользователь, ФЗУИД, ДеньРеформацииБаланса, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// ПереоценкаСрочныхКонтрактов
	ДокументПереоценкаСрочныхКонтрактов = ПереоценитьСрочныеКонтракты(Организация, СчетДоверительногоУправления, ТекущаяКонечнаяДата, ВидУчета, Пользователь, ФЗУИД, ДеньРеформацииБаланса, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// ПереоценкаКредитныхИнструментов
	ДокументДепозиты = ПереоценитьДепозиты(Организация, СчетДоверительногоУправления, ТекущаяКонечнаяДата, ВидУчета, Пользователь, ФЗУИД, ДеньРеформацииБаланса, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// ПереоценкаЦенныхБумаг
	ДокументПереоценка = ПереоценитьАктивы(Организация, СчетДоверительногоУправления, ТекущаяКонечнаяДата, ПараметрыОценки, Пользователь, ФЗУИД, ДеньРеформацииБаланса, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли; 
	
	Если ДокументПереоценка = Неопределено Тогда
		ВывестиПользователюСообщениеВремениВыполнения(ТекущаяДатаФормированияСтр, "Переоценка бумаг не создавалась - нет необходимости");
	Иначе
		ВывестиПользователюСообщениеВремениВыполнения(ТекущаяДатаФормированияСтр, "Произвели переоценку бумаг");
	КонецЕсли;
	
	// ПереоценкаВалютныхЦенностей
	ДокументПереоценкаВалютныхАктивов = ПереоценитьВалютныеАктивы(Организация, СчетДоверительногоУправления, ТекущаяКонечнаяДата, ВидУчета, Пользователь, ФЗУИД, Ложь, ДеньРеформацииБаланса, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли; 
	
	// НачислениеСписаниеРезервов
	ДокументНачислениеСписаниеРезервов = НачислитьРезервы(Организация, СчетДоверительногоУправления, ТекущаяКонечнаяДата, ВидУчета, Пользователь, ФЗУИД, ДеньРеформацииБаланса, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли; 

	#Область ЗакрытияСчетов	
	
	ПериодичностиТекущейКонечнойДаты = БухгалтерскийУчетЕПС.ПолучитьПериодичностиДаты(ТекущаяКонечнаяДата);
		
	Если Не ПериодичностиТекущейКонечнойДаты.ПериодичностьМесяц И Не ПериодичностиТекущейКонечнойДаты.ПериодичностьКвартал И Не ПериодичностиТекущейКонечнойДаты.ПериодичностьГод И НЕ Отказ Тогда //это, возможно, реформация
		
		Если ДеньРеформацииБаланса Тогда 
			ПериодичностиТекущейКонечнойДаты.ПериодичностьМесяц   = Истина;
			ПериодичностиТекущейКонечнойДаты.ПериодичностьКвартал = Истина;
			ПериодичностиТекущейКонечнойДаты.ПериодичностьГод     = Истина;   
		КонецЕсли;
	КонецЕсли;
	
	// или расторжение договора
	Если КонецДня(СчетДоверительногоУправления.ДатаРасторжения) = ТекущаяКонечнаяДата И НЕ Отказ Тогда
		ПериодичностиТекущейКонечнойДаты.ПериодичностьМесяц   = Истина;
		ПериодичностиТекущейКонечнойДаты.ПериодичностьКвартал = Истина;
		ПериодичностиТекущейКонечнойДаты.ПериодичностьГод     = Истина;		
	КонецЕсли;	
	
	Если ПериодичностиТекущейКонечнойДаты.ПериодичностьМесяц И НЕ Отказ Тогда   
		НачальнаяДата = Макс(СледующийДеньПослеПредыдущейРеформации, НачалоМесяца(ТекущаяКонечнаяДата)); 
		КонечнаяДата  = НачалоДня(ТекущаяКонечнаяДата);
		
		ДокументЗакрытияСчетов = ЗакрытьСчетаЗаПериод(Организация, СчетДоверительногоУправления, НачальнаяДата, КонечнаяДата, Перечисления.ПериодичностьПереоценкиАктивов.Ежемесячно, ВидУчета, Пользователь, ФЗУИД, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПериодичностиТекущейКонечнойДаты.ПериодичностьКвартал И НЕ Отказ Тогда 
		НачальнаяДата = Макс(СледующийДеньПослеПредыдущейРеформации, НачалоКвартала(ТекущаяКонечнаяДата));
		КонечнаяДата  = НачалоДня(ТекущаяКонечнаяДата); 
		
		ДокументЗакрытияСчетов = ЗакрытьСчетаЗаПериод(Организация, СчетДоверительногоУправления, НачальнаяДата, КонечнаяДата, Перечисления.ПериодичностьПереоценкиАктивов.Ежеквартально, ВидУчета, Пользователь, ФЗУИД, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПериодичностиТекущейКонечнойДаты.ПериодичностьГод И НЕ Отказ Тогда  
		НачальнаяДата = Макс(СледующийДеньПослеПредыдущейРеформации, НачалоГода(ТекущаяКонечнаяДата));
		КонечнаяДата  = НачалоДня(ТекущаяКонечнаяДата); 
		
		ДокументЗакрытияСчетов = ЗакрытьСчетаЗаПериод(Организация, СчетДоверительногоУправления, НачальнаяДата, КонечнаяДата, Перечисления.ПериодичностьПереоценкиАктивов.Ежегодно, ВидУчета, Пользователь, ФЗУИД, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	#КонецОбласти
	
	ОповеститьОНеправильныхОстаткахПоСчетамБухгалтерскогоУчета(КонецДня(ТекущаяКонечнаяДата), Организация, СчетДоверительногоУправления, ВидУчета, Истина, Истина); 	
	
КонецПроцедуры

Процедура РассчитатьПартии(Организация, СчетДоверительногоУправления, НачальнаяДата, КонечнаяДата, ВидУчета, Отказ, Оповещения, ФЗУИД)

	ОбработкаРасчетПартий = Обработки.РасчетПартий.Создать();
	ОбработкаРасчетПартий.Организация                  = Организация;
	ОбработкаРасчетПартий.СчетДоверительногоУправления = СчетДоверительногоУправления;
	ОбработкаРасчетПартий.НачалоПериода                = НачальнаяДата;
	ОбработкаРасчетПартий.КонецПериода                 = КонечнаяДата;
	ОбработкаРасчетПартий.ВидУчета                     = ВидУчета;
	
	СообщенияСтарые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
	
	Попытка
		ОбработкаРасчетПартий.РассчитатьИЗаписатьПартии(Отказ);	
	Исключение
		ТекущаяОшибка = ОписаниеОшибки();
		
		СообщенияНовые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
		Для Инд = СообщенияСтарые.Количество() По СообщенияНовые.Количество() - 1 Цикл
			ТекущаяОшибка = ТекущаяОшибка + Символы.ПС + СообщенияНовые[Инд];
		КонецЦикла;
		
		СообщениеОшибкиРасчетаПартий = СтрШаблон("Не удалось рассчитать партии по %1, %2, %3 с %4 по %5: %6",
					Организация,
					СчетДоверительногоУправления,
					ВидУчета,
					НачальнаяДата,
					КонечнаяДата,
					ТекущаяОшибка);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОшибкиРасчетаПартий,,,, Отказ);
		
		ЗаписьЖурналаРегистрации("ФБУ.РасчетПартий", УровеньЖурналаРегистрации.Ошибка, Метаданные.Обработки.ФормированиеБухгалтерскогоУчета,, СообщениеОшибкиРасчетаПартий);
	КонецПопытки;
	
	// выбытие активов оцениваемых по амортизационной стоимости. Могут быть другие проверки. 
	Если НЕ Отказ И ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда 
		
		Оповещения.ДвиженияАктивовОцениваемыхПоАС = ПроверкаОповещенияДвиженийАктивовОцениваемыхПоАС(ОбработкаРасчетПартий.РассчитанныеПартии.Выгрузить(,"Период,Регистратор,Рынок,УчетныйАктивЕПС,ВидДвижения,ЦеннаяБумага,Количество"), СчетДоверительногоУправления, КонечнаяДата);
		
	КонецЕсли;	

КонецПроцедуры

Функция ПереоценитьЗадолженностиПоДС(Организация, СчетДоверительногоУправления, ДатаПереоценки, ВидУчета, Пользователь, ФЗУИД, ПереоцениватьБезУчетаНастроек, Отказ)
	
	Результат = Неопределено;
	Переоценивать = Ложь;
	
	Если ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет ИЛИ ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
		
		// Для налогового не реализована переоценка Т+
		// А РЕПО реализовано ежемесячно по дефолту для всех, кроме физлиц    
		
		ТолькоПервоначальноеПризнаниеПрямогоРЕПО = Ложь;
		ПереоцениватьРасчетыПоПрямомуРЕПО = ПереоцениватьБезУчетаНастроек ИЛИ 
			Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.НужнаПереоценкаПоАктиву(
				ДатаПереоценки, 
				Организация, 
				СчетДоверительногоУправления,
				Справочники.УчетныеАктивы.РасчетыПоПрямомуРЕПО,
				ВидУчета,
				ТолькоПервоначальноеПризнаниеПрямогоРЕПО);
											
		ТолькоПервоначальноеПризнаниеОбратногоРЕПО = Ложь;
		ПереоцениватьРасчетыПоОбратномуРЕПО = ПереоцениватьБезУчетаНастроек ИЛИ 
			Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.НужнаПереоценкаПоАктиву(
				ДатаПереоценки, 
				Организация, 
				СчетДоверительногоУправления,
				Справочники.УчетныеАктивы.РасчетыПоОбратномуРЕПО,
				ВидУчета,
				ТолькоПервоначальноеПризнаниеОбратногоРЕПО);
											
		ПереоцениватьЗадолженностьДСПоСделкамТПлюс = Ложь;
		Если ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет Тогда
												
			ПереоцениватьЗадолженностьДСПоСделкамТПлюс = ПереоцениватьБезУчетаНастроек ИЛИ 
				Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.НужнаПереоценкаПоАктиву(
					ДатаПереоценки, 
					Организация, 
					СчетДоверительногоУправления,
					Справочники.УчетныеАктивы.ЗадолженностьДСПоСделкамТПлюс,
					ВидУчета);
												
		КонецЕсли;	
		
		ПереоцениватьЗадолженности =  ПереоцениватьБезУчетаНастроек ИЛИ  
			Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.НужнаПереоценкаЗадолженностей(
				ДатаПереоценки, 
				Организация, 
				СчетДоверительногоУправления, 
				ВидУчета);
												
		Переоценивать = ПереоцениватьРасчетыПоПрямомуРЕПО ИЛИ ПереоцениватьРасчетыПоОбратномуРЕПО 
					ИЛИ ПереоцениватьЗадолженностьДСПоСделкамТПлюс ИЛИ ПереоцениватьЗадолженности;
		
	ИначеЕсли ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		
		ЕстьПоручениеНаПереоценку = РаботаСПереоценкой.ОпределитьНаличиеПорученияНаПереоценку(Организация, СчетДоверительногоУправления, НачалоДня(ДатаПереоценки), ВидУчета, Перечисления.ВидыАктивовДляПорученийНаПереоценку.Задолженность);
		
		Если ЕстьПоручениеНаПереоценку Тогда
		
			Нужно_ГлаваБ_НачислитьПроцентыПоРЕПО = Истина;	
			Нужно_ЕПС_ПереоценитьКомиссиюПоРЕПО = Истина;
			Нужно_ЕПС_ПризнатьРасходыПоБиржевымДепозитам = Истина;
			
		Иначе
			
			Нужно_ГлаваБ_НачислитьПроцентыПоРЕПО = Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.Нужно_ГлаваБ_НачислитьПроцентыПоРЕПО(ДатаПереоценки, Организация, СчетДоверительногоУправления);
			Нужно_ЕПС_ПереоценитьКомиссиюПоРЕПО = Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.Нужно_ЕПС_ПереоценитьКомиссиюПоРЕПО(ДатаПереоценки, Организация, СчетДоверительногоУправления);
			Нужно_ЕПС_ПризнатьРасходыПоБиржевымДепозитам = Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.Нужно_ЕПС_ПризнатьРасходыПоБиржевымДепозитам(ДатаПереоценки, Организация, СчетДоверительногоУправления);
			
		КонецЕсли;
		
		Переоценивать = Нужно_ГлаваБ_НачислитьПроцентыПоРЕПО ИЛИ Нужно_ЕПС_ПереоценитьКомиссиюПоРЕПО ИЛИ Нужно_ЕПС_ПризнатьРасходыПоБиржевымДепозитам;
		
	КонецЕсли;				
					
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПереоценкаЗадолженностиПоДенежнымСредствам.Ссылка КАК Ссылка,
		|	ПереоценкаЗадолженностиПоДенежнымСредствам.Представление КАК Представление
		|ИЗ
		|	Документ.ПереоценкаЗадолженностиПоДенежнымСредствам КАК ПереоценкаЗадолженностиПоДенежнымСредствам
		|ГДЕ
		|	ПереоценкаЗадолженностиПоДенежнымСредствам.Организация = &Организация
		|	И ПереоценкаЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПереоценкаЗадолженностиПоДенежнымСредствам.ВидУчета = &ВидУчета
		|	И ПереоценкаЗадолженностиПоДенежнымСредствам.Дата МЕЖДУ &НачальнаяДата И &КонечнаяДата
		|	И ПереоценкаЗадолженностиПоДенежнымСредствам.Проведен";

	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета",						ВидУчета);
	Запрос.УстановитьПараметр("НачальнаяДата",					НачалоДня(ДатаПереоценки));
	Запрос.УстановитьПараметр("КонечнаяДата",					КонецДня(ДатаПереоценки));

	Выборка = Запрос.Выполнить().Выбрать();
	
	// Метим на удаление существующие документы.
	Для ИндексДокумента = 1 По Выборка.Количество() Цикл
		
		// Если нужен документ, то пропускаем последний элемент в выборке.
		Если ИндексДокумента = Выборка.Количество()
			И Переоценивать Тогда
			Прервать;
		КонецЕсли;
		
		Если Выборка.Следующий()
			И НЕ ПометитьДокументНаУдаление(Выборка.Ссылка, ФЗУИД) Тогда
			Отказ = Истина;
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Переоценивать Тогда
		
		Если Выборка.Следующий() Тогда
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Иначе
			ДокументОбъект								= Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.СоздатьДокумент();
			ДокументОбъект.Дата							= КонецДня(ДатаПереоценки);
		    ДокументОбъект.Организация					= Организация;
		    ДокументОбъект.СчетДоверительногоУправления	= СчетДоверительногоУправления;
		    ДокументОбъект.ВидУчета						= ВидУчета;
			ДокументОбъект.Ответственный				= Пользователь;

		КонецЕсли;
		
		Если ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет ИЛИ ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда 
			ДокументОбъект.ДополнительныеСвойства.Вставить("ПереоцениватьРасчетыПоПрямомуРЕПО", ПереоцениватьРасчетыПоПрямомуРЕПО);
			ДокументОбъект.ДополнительныеСвойства.Вставить("ТолькоПервоначальноеПризнаниеПрямогоРЕПО", ТолькоПервоначальноеПризнаниеПрямогоРЕПО);
			ДокументОбъект.ДополнительныеСвойства.Вставить("ПереоцениватьРасчетыПоОбратномуРЕПО", ПереоцениватьРасчетыПоОбратномуРЕПО);
			ДокументОбъект.ДополнительныеСвойства.Вставить("ТолькоПервоначальноеПризнаниеОбратногоРЕПО", ТолькоПервоначальноеПризнаниеОбратногоРЕПО);
			ДокументОбъект.ДополнительныеСвойства.Вставить("ПереоцениватьЗадолженностьДСПоСделкамТПлюс", ПереоцениватьЗадолженностьДСПоСделкамТПлюс);
			ДокументОбъект.ДополнительныеСвойства.Вставить("ПереоцениватьЗадолженности", ПереоцениватьЗадолженности);
		ИначеЕсли ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда 
			ДокументОбъект.ДополнительныеСвойства.Вставить("Нужно_ГлаваБ_НачислитьПроцентыПоРЕПО", Нужно_ГлаваБ_НачислитьПроцентыПоРЕПО);
			ДокументОбъект.ДополнительныеСвойства.Вставить("Нужно_ЕПС_ПереоценитьКомиссиюПоРЕПО", Нужно_ЕПС_ПереоценитьКомиссиюПоРЕПО);
		КонецЕсли;
		
		Если ЗаписатьДокумент(ДокументОбъект, РежимЗаписиДокумента.Проведение, ФЗУИД) Тогда
			Результат = ДокументОбъект.Ссылка;
		Иначе
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьМеньшуюПериодичностьПереоценки(Периодичность1, Периодичность2)
	
	Если НЕ ЗначениеЗаполнено(Периодичность1) Тогда
		Возврат Периодичность2;
	ИначеЕсли НЕ ЗначениеЗаполнено(Периодичность2) Тогда
		Возврат Периодичность1;
	ИначеЕсли Периодичность1 = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно 
		ИЛИ Периодичность2 = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
		Возврат Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно;
	ИначеЕсли Периодичность1 = Перечисления.ПериодичностьПереоценкиАктивов.ПослеПриобретенийИРеализаций 
		ИЛИ Периодичность2 = Перечисления.ПериодичностьПереоценкиАктивов.ПослеПриобретенийИРеализаций Тогда
		Возврат Перечисления.ПериодичностьПереоценкиАктивов.ПослеПриобретенийИРеализаций;
	ИначеЕсли Периодичность1 = Перечисления.ПериодичностьПереоценкиАктивов.ЕжемесячноИПослеПриобретенийИРеализаций 
		ИЛИ Периодичность2 = Перечисления.ПериодичностьПереоценкиАктивов.ЕжемесячноИПослеПриобретенийИРеализаций Тогда
		Возврат Перечисления.ПериодичностьПереоценкиАктивов.ЕжемесячноИПослеПриобретенийИРеализаций;
	ИначеЕсли Периодичность1 = Перечисления.ПериодичностьПереоценкиАктивов.ЕжеквартальноИПослеПриобретенийИРеализаций 
		ИЛИ Периодичность2 = Перечисления.ПериодичностьПереоценкиАктивов.ЕжеквартальноИПослеПриобретенийИРеализаций Тогда
		Возврат Перечисления.ПериодичностьПереоценкиАктивов.ЕжеквартальноИПослеПриобретенийИРеализаций;
	ИначеЕсли Периодичность1 = Перечисления.ПериодичностьПереоценкиАктивов.ЕжегодноИПослеПриобретенийИРеализаций 
		ИЛИ Периодичность2 = Перечисления.ПериодичностьПереоценкиАктивов.ЕжегодноИПослеПриобретенийИРеализаций Тогда
		Возврат Перечисления.ПериодичностьПереоценкиАктивов.ЕжегодноИПослеПриобретенийИРеализаций;
	ИначеЕсли Периодичность1 = Перечисления.ПериодичностьПереоценкиАктивов.Ежемесячно 
		ИЛИ Периодичность2 = Перечисления.ПериодичностьПереоценкиАктивов.Ежемесячно Тогда
		Возврат Перечисления.ПериодичностьПереоценкиАктивов.Ежемесячно;
	ИначеЕсли Периодичность1 = Перечисления.ПериодичностьПереоценкиАктивов.ЕжемесячноВПоследнийРабочийДень 
		ИЛИ Периодичность2 = Перечисления.ПериодичностьПереоценкиАктивов.ЕжемесячноВПоследнийРабочийДень Тогда
		Возврат Перечисления.ПериодичностьПереоценкиАктивов.ЕжемесячноВПоследнийРабочийДень;
	ИначеЕсли Периодичность1 = Перечисления.ПериодичностьПереоценкиАктивов.Ежеквартально 
		ИЛИ Периодичность2 = Перечисления.ПериодичностьПереоценкиАктивов.Ежеквартально Тогда
		Возврат Перечисления.ПериодичностьПереоценкиАктивов.Ежеквартально;
	ИначеЕсли Периодичность1 = Перечисления.ПериодичностьПереоценкиАктивов.Ежегодно 
		ИЛИ Периодичность2 = Перечисления.ПериодичностьПереоценкиАктивов.Ежегодно Тогда
		Возврат Перечисления.ПериодичностьПереоценкиАктивов.Ежегодно;
	ИначеЕсли Периодичность1 = Перечисления.ПериодичностьПереоценкиАктивов.НеПереоценивать 
		ИЛИ Периодичность2 = Перечисления.ПериодичностьПереоценкиАктивов.НеПереоценивать Тогда
		Возврат Перечисления.ПериодичностьПереоценкиАктивов.НеПереоценивать;
	КонецЕсли;
	
КонецФункции

Функция ПометитьДокументНаУдаление(Документ, ФЗУИД)
	
	Результат = Истина;
	
	ДокументОбъект = Документ.ПолучитьОбъект();
	
	СообщенияСтарые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
	
	Попытка
		ДокументОбъект.УстановитьПометкуУдаления(Истина);
	Исключение
		ТекущаяОшибка = ОписаниеОшибки();
		
		СообщенияНовые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
		Для Инд = СообщенияСтарые.Количество() По СообщенияНовые.Количество() - 1 Цикл
			ТекущаяОшибка = ТекущаяОшибка + Символы.ПС + СообщенияНовые[Инд];
		КонецЦикла;
		
		СообщениеОшибкиДокумента = СтрШаблон("Не удалось пометить на удаление документ ' %1', счет ДУ %2. Система сообщает: %3",
			Документ,
			ДокументОбъект.СчетДоверительногоУправления,
			ТекущаяОшибка);
			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОшибкиДокумента);
		
		ЗаписьЖурналаРегистрации("ФБУ.ПометитьДокументНаУдаление", УровеньЖурналаРегистрации.Ошибка, Метаданные.Обработки.ФормированиеБухгалтерскогоУчета,, СообщениеОшибкиДокумента);
			
		Результат = Ложь;
	КонецПопытки;
	
	Если Результат Тогда
		Результат = ЗаписатьДокумент(ДокументОбъект, РежимЗаписиДокумента.Запись, ФЗУИД);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаписатьДокумент(ДокументОбъект, РежимЗаписи, ФЗУИД)
	
	СообщенияСтарые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
	
	Результат = Истина;
	
	Попытка
		ДокументОбъект.Записать(РежимЗаписи);
	Исключение
		ТекущаяОшибка = ОписаниеОшибки();
		
		СообщенияНовые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
		Для Инд = СообщенияСтарые.Количество() По СообщенияНовые.Количество() - 1 Цикл
			ТекущаяОшибка = ТекущаяОшибка + Символы.ПС + СообщенияНовые[Инд];
		КонецЦикла;
		
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			ДействиеСтрока = "провести";
		ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
			ДействиеСтрока = "записать";
		ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
			ДействиеСтрока = "отменить проведение";
		КонецЕсли;
		
		СообщениеОшибкиДокумента = СтрШаблон("Не удалось %1 документ %2, счет ДУ %3, дата %4. Система сообщает: %5",
			ДействиеСтрока,
			ДокументОбъект.Метаданные().Синоним,
			ДокументОбъект.СчетДоверительногоУправления,
			ДокументОбъект.Дата,
			ТекущаяОшибка);

		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОшибкиДокумента);
		
		ЗаписьЖурналаРегистрации("ФБУ.ЗаписатьДокумент", УровеньЖурналаРегистрации.Ошибка, Метаданные.Обработки.ФормированиеБухгалтерскогоУчета,, СообщениеОшибкиДокумента);
		
		Результат = Ложь;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПереоценитьМНО(Организация, СчетДоверительногоУправления, ДатаПереоценки, ВидУчета, Пользователь, ФЗУИД, ПереоцениватьБезУчетаНастроек, Отказ)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПереоценкаМНО.Ссылка
		|ИЗ
		|	Документ.ПереоценкаМНО КАК ПереоценкаМНО
		|ГДЕ
		|	ПереоценкаМНО.Организация = &Организация
		|	И ПереоценкаМНО.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПереоценкаМНО.ВидУчета = &ВидУчета
		|	И ПереоценкаМНО.Дата МЕЖДУ &НачальнаяДата И &КонечнаяДата
		|	И ПереоценкаМНО.Проведен");

	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета",						ВидУчета);
	Запрос.УстановитьПараметр("НачальнаяДата",					НачалоДня(ДатаПереоценки));
	Запрос.УстановитьПараметр("КонечнаяДата",					КонецДня(ДатаПереоценки));

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		ДокументМНО = Выборка.Ссылка.ПолучитьОбъект();
		Если Не ЗаписатьДокумент(ДокументМНО, РежимЗаписиДокумента.ОтменаПроведения, ФЗУИД) Тогда
			Отказ = Истина;
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		ДокументМНО = Документы.ПереоценкаМНО.СоздатьДокумент();
		ДокументМНО.Дата							= КонецДня(ДатаПереоценки);
	    ДокументМНО.Организация						= Организация;
	    ДокументМНО.СчетДоверительногоУправления	= СчетДоверительногоУправления;
	    ДокументМНО.ВидУчета						= ВидУчета;
		ДокументМНО.Ответственный					= Пользователь;
	КонецЕсли;
	
	// в дату реформации переоценку нужно сделать обязательно. 
	// если у документа Переоценка ПереоцениватьНаОснованииНастроекУчета = Ложь, то в переоценке не применяется политика учета. 			
	ДокументМНО.ПереоцениватьНаОснованииНастроекУчета = НЕ ПереоцениватьБезУчетаНастроек; 

	ДокументМНО.ЗаполнитьТабличнуюЧасть(Отказ);
	
	Если Отказ ИЛИ ДокументМНО.МНО.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ДокументМНО.ДополнительныеСвойства.Свойство("ТребуетсяПереоценка")
		И ДокументМНО.ДополнительныеСвойства.ТребуетсяПереоценка = Ложь
	Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Проводим документ	
	СообщенияСтарые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
	
	Попытка
		ДокументМНО.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ТекущаяОшибка = ОписаниеОшибки();
		
		СообщенияНовые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
		Для Инд = СообщенияСтарые.Количество() По СообщенияНовые.Количество() - 1 Цикл
			ТекущаяОшибка = ТекущаяОшибка + Символы.ПС + СообщенияНовые[Инд];
		КонецЦикла;
		
		СообщениеОшибкиМНО = СтрШаблон("Не удалось провести документ МНО, счет ДУ  %1 , дата  %2. Система сообщает: %3",
			СчетДоверительногоУправления,
			ДатаПереоценки,
			ТекущаяОшибка);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОшибкиМНО,,,, Отказ); 
		
		ЗаписьЖурналаРегистрации("ФБУ.ПереоценитьМНО", УровеньЖурналаРегистрации.Ошибка, Метаданные.Обработки.ФормированиеБухгалтерскогоУчета,, СообщениеОшибкиМНО);
		
		Возврат Неопределено;
	КонецПопытки;

	Возврат ДокументМНО.Ссылка;

КонецФункции

Функция ПереоценитьСрочныеКонтракты(Организация, СчетДоверительногоУправления, ДатаПереоценки, ВидУчета, Пользователь, ФЗУИД, ПереоцениватьБезУчетаНастроек, Отказ)
	
	Если ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		УчетныйАктив = Справочники.УчетныеАктивыЕПС.ПроизводныеФинансовыеИнструментыОснованныеНаВалютныхДоговорах; //выбираю 1 из т.к. остальные должны быть синхронно
	Иначе
		Возврат Неопределено; // в РСБУ нет учета СК
	КонецЕсли;
	
	ПериодичностьПереоценки = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
		ДатаПереоценки,
		Организация,
		СчетДоверительногоУправления,
		УчетныйАктив,
		ВидУчета,
		"ПериодичностьПереоценки");
		
	Если НЕ (ПереоцениватьБезУчетаНастроек ИЛИ БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьПереоценки, ДатаПереоценки)) Тогда 
		Возврат Неопределено;
	КонецЕсли;	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПереоценкаСрочныхКонтрактов.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПереоценкаСрочныхКонтрактов КАК ПереоценкаСрочныхКонтрактов
		|ГДЕ
		|	ПереоценкаСрочныхКонтрактов.Организация = &Организация
		|	И ПереоценкаСрочныхКонтрактов.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПереоценкаСрочныхКонтрактов.ВидУчета = &ВидУчета
		|	И ПереоценкаСрочныхКонтрактов.Дата МЕЖДУ &НачальнаяДата И &КонечнаяДата
		|	И ПереоценкаСрочныхКонтрактов.Проведен";

	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("НачальнаяДата", НачалоДня(ДатаПереоценки));
	Запрос.УстановитьПараметр("КонечнаяДата", КонецДня(ДатаПереоценки));

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		
		ДокументПереоценкаСрочныхКонтрактов = Выборка.Ссылка.ПолучитьОбъект();
		
		Если НЕ ЗаписатьДокумент(ДокументПереоценкаСрочныхКонтрактов, РежимЗаписиДокумента.ОтменаПроведения, ФЗУИД) Тогда
			Отказ = Истина;
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		
		ДокументПереоценкаСрочныхКонтрактов = Документы.ПереоценкаСрочныхКонтрактов.СоздатьДокумент();
		
		ДокументПереоценкаСрочныхКонтрактов.Дата = КонецДня(ДатаПереоценки);
	    ДокументПереоценкаСрочныхКонтрактов.Организация = Организация;
	    ДокументПереоценкаСрочныхКонтрактов.СчетДоверительногоУправления = СчетДоверительногоУправления;
	    ДокументПереоценкаСрочныхКонтрактов.ВидУчета = ВидУчета;
		
	КонецЕсли;
	
	ДокументПереоценкаСрочныхКонтрактов.Ответственный = Пользователь;
	
	СообщенияСтарые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
	
	Попытка
		ДокументПереоценкаСрочныхКонтрактов.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ТекущаяОшибка = ОписаниеОшибки();
		
		СообщенияНовые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
		Для Инд = СообщенияСтарые.Количество() По СообщенияНовые.Количество() - 1 Цикл
			ТекущаяОшибка = ТекущаяОшибка + Символы.ПС + СообщенияНовые[Инд];
		КонецЦикла;
		
		СообщениеОшибкиСК = СтрШаблон("Не удалось провести документ переоценки срочных контрактов, счет ДУ  %1 , дата  %2. Система сообщает: %3",
			СчетДоверительногоУправления,
			ДатаПереоценки,
			ТекущаяОшибка);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОшибкиСК,,,, Отказ); 
		
		ЗаписьЖурналаРегистрации("ФБУ.ПереоценитьСрочныеКонтракты", УровеньЖурналаРегистрации.Ошибка, Метаданные.Обработки.ФормированиеБухгалтерскогоУчета,, СообщениеОшибкиСК);
		
		Возврат Неопределено;
		
	КонецПопытки;
		
	Возврат ДокументПереоценкаСрочныхКонтрактов.Ссылка;

КонецФункции

Функция ПереоценитьДепозиты(Организация, СчетДоверительногоУправления, ДатаПереоценки, ВидУчета, Пользователь, ФЗУИД, ПереоцениватьБезУчетаНастроек, Отказ)

	КалендарьДляСчетаДУ = РаботаСПереоценкой.ПолучитьКалендарьДляСчетаДУ(Организация, СчетДоверительногоУправления, ДатаПереоценки);
	
	ЕстьПоручениеНаПереоценку = РаботаСПереоценкой.ОпределитьНаличиеПорученияНаПереоценку(Организация, СчетДоверительногоУправления, НачалоДня(ДатаПереоценки), ВидУчета, Перечисления.ВидыАктивовДляПорученийНаПереоценку.ДепозитныеВклады);
	
	Если НЕ ЕстьПоручениеНаПереоценку Тогда
		
		Если ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
			
			ПериодичностьПереоценки1 = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
				ДатаПереоценки,
				Организация,
				СчетДоверительногоУправления,
				Справочники.УчетныеАктивыЕПС.ДепозитныеВкладыПоАС,
				ВидУчета,
				"ПериодичностьПереоценки");
			
			ПериодичностьПереоценки2 = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
				ДатаПереоценки,
				Организация,
				СчетДоверительногоУправления,
				Справочники.УчетныеАктивыЕПС.ДепозитныеВкладыПоСС,
				ВидУчета,
				"ПериодичностьПереоценки");
				
			ПериодичностьПереоценки = ПолучитьМеньшуюПериодичностьПереоценки(ПериодичностьПереоценки1, ПериодичностьПереоценки2);	
			
		Иначе
			
			ПериодичностьПереоценки1 = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
				ДатаПереоценки,
				Организация,
				СчетДоверительногоУправления,
				Справочники.УчетныеАктивы.ДепозитныеВклады,
				ВидУчета,
				"ПериодичностьПереоценки");
			
			ПериодичностьПереоценки2 = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
				ДатаПереоценки,
				Организация,
				СчетДоверительногоУправления,
				Справочники.УчетныеАктивы.ЗаймыВыданные,
				ВидУчета,
				"ПериодичностьПереоценки");
				
			ПериодичностьПереоценки3 = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
				ДатаПереоценки,
				Организация,
				СчетДоверительногоУправления,
				Справочники.УчетныеАктивы.ЗаймыПолученныеДолгосрочные,
				ВидУчета,
				"ПериодичностьПереоценки");
				
			ПериодичностьПереоценки4 = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
				ДатаПереоценки,
				Организация,
				СчетДоверительногоУправления,
				Справочники.УчетныеАктивы.ЗаймыПолученныеКраткосрочные,
				ВидУчета,
				"ПериодичностьПереоценки");
				
			ПериодичностьПереоценки = ПолучитьМеньшуюПериодичностьПереоценки(ПериодичностьПереоценки1, ПериодичностьПереоценки2);	
			ПериодичностьПереоценки = ПолучитьМеньшуюПериодичностьПереоценки(ПериодичностьПереоценки, ПериодичностьПереоценки3);	
			ПериодичностьПереоценки = ПолучитьМеньшуюПериодичностьПереоценки(ПериодичностьПереоценки, ПериодичностьПереоценки4);	
			
		КонецЕсли;
		
		Если БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьПереоценки, ДатаПереоценки, КалендарьДляСчетаДУ)
			ИЛИ ПереоцениватьБезУчетаНастроек Тогда
			 
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПереоценкаКредитныхИнструментов.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПереоценкаКредитныхИнструментов КАК ПереоценкаКредитныхИнструментов
		|ГДЕ
		|	ПереоценкаКредитныхИнструментов.Организация = &Организация
		|	И ПереоценкаКредитныхИнструментов.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПереоценкаКредитныхИнструментов.ВидУчета = &ВидУчета
		|	И ПереоценкаКредитныхИнструментов.Дата МЕЖДУ &НачальнаяДата И &КонечнаяДата
		|	И ПереоценкаКредитныхИнструментов.Проведен";

	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("НачальнаяДата", НачалоДня(ДатаПереоценки));
	Запрос.УстановитьПараметр("КонечнаяДата", КонецДня(ДатаПереоценки));

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		
		ДокументДепозиты = Выборка.Ссылка.ПолучитьОбъект();
		
		Если НЕ ЗаписатьДокумент(ДокументДепозиты, РежимЗаписиДокумента.ОтменаПроведения, ФЗУИД) Тогда
			Отказ = Истина;
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		ДокументДепозиты = Документы.ПереоценкаКредитныхИнструментов.СоздатьДокумент();
		
		ДокументДепозиты.Дата = КонецДня(ДатаПереоценки);
		
	    ДокументДепозиты.Организация = Организация;
	    ДокументДепозиты.СчетДоверительногоУправления = СчетДоверительногоУправления;    
		// в дату реформации переоценку нужно сделать обязательно. 
		// если у документа Переоценка ПереоцениватьНаОснованииНастроекУчета = Ложь, то в переоценке не применяется политика учета. 				
		ДокументДепозиты.ПереоцениватьНаОснованииНастроекУчета = НЕ ПереоцениватьБезУчетаНастроек;   
	    ДокументДепозиты.ВидУчета = ВидУчета;
	КонецЕсли;
	
	ДокументДепозиты.Ответственный = Пользователь;
	
	ДокументДепозиты.ЗаполнитьКредитныеИнструменты(Отказ);
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось заполнить документ переоценки депозитных вкладов, счет ДУ " + СокрЛП(СчетДоверительногоУправления) + ", дата " + Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy") + ". Система сообщает: " + ОписаниеОшибки()); 
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ ПереоцениватьБезУчетаНастроек Тогда
		ДокументДепозиты.ПрименитьПолитикуУчета();
	КонецЕсли;
	
	Если ДокументДепозиты.КредитныеИнструменты.Количество() > 0 Тогда
		
		СообщенияСтарые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
		
		Попытка
			ДокументДепозиты.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ТекущаяОшибка = ОписаниеОшибки();
			
			СообщенияНовые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
			Для Инд = СообщенияСтарые.Количество() По СообщенияНовые.Количество() - 1 Цикл
				ТекущаяОшибка = ТекущаяОшибка + Символы.ПС + СообщенияНовые[Инд];
			КонецЦикла;
			
			СообщениеОшибкиДепозиты = СтрШаблон("Не удалось провести документ переоценки депозитных вкладов, счет ДУ  %1 , дата  %2. Система сообщает: %3",
				СчетДоверительногоУправления,
				ДатаПереоценки,
				ТекущаяОшибка);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОшибкиДепозиты,,,, Отказ); 
			
			ЗаписьЖурналаРегистрации("ФБУ.ПереоценитьДепозиты", УровеньЖурналаРегистрации.Ошибка, Метаданные.Обработки.ФормированиеБухгалтерскогоУчета,, СообщениеОшибкиДепозиты);
			
			Возврат Неопределено;
			
		КонецПопытки;
			
		Возврат ДокументДепозиты.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПереоценитьАктивы(Организация, СчетДоверительногоУправления, ДатаПереоценки, ПараметрыОценки, Пользователь, ФЗУИД, ПереоцениватьБезУчетаНастроек, Отказ)

	НужнаПереоценка = ПереоцениватьБезУчетаНастроек ИЛИ Документы.ПереоценкаЦенныхБумаг.НужнаПереоценка(ДатаПереоценки, Организация, СчетДоверительногоУправления, ПараметрыОценки.ВидУчета);
	
	Если НЕ НужнаПереоценка Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МаксимальноеКоличествоПартийВПереоценке = Обработки.МенеджерОтложенныхЗаданий.ПолучитьПараметрыФормированияБухгалтерскогоУчета().МаксимальноеКоличествоПартийВПереоценке;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПереоценкаЦенныхБумаг.Ссылка,
		|	ПереоценкаЦенныхБумаг.Проведен
		|ИЗ
		|	Документ.ПереоценкаЦенныхБумаг КАК ПереоценкаЦенныхБумаг
		|ГДЕ
		|	ПереоценкаЦенныхБумаг.Организация = &Организация
		|	И ПереоценкаЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПереоценкаЦенныхБумаг.ВидУчета = &ВидУчета
		|	И ПереоценкаЦенныхБумаг.Дата МЕЖДУ &НачальнаяДата И &КонечнаяДата
        |   И НЕ ПереоценкаЦенныхБумаг.ПометкаУдаления
        |   И НЕ ПереоценкаЦенныхБумаг.Проведен";

	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета",                     ПараметрыОценки.ВидУчета);
	Запрос.УстановитьПараметр("НачальнаяДата",                НачалоДня(ДатаПереоценки));
	Запрос.УстановитьПараметр("КонечнаяДата",                 КонецДня(ДатаПереоценки));

	Выборка = Запрос.Выполнить().Выбрать();
	
	// в дату реформации переоценку нужно сделать обязательно. 
	// если у документа Переоценка ПереоцениватьНаОснованииНастроекУчета = Ложь, то в переоценке не применяется политика учета.
	
	ДокументПереоценка = Неопределено;	// типа главная переоценка от которой будем плясать
	МассивПереоценок = Новый Массив();	// массив остальных переоценок, чтобы каждый раз не создавать при перефорировании
	
	Если Выборка.Количество() = 0 Тогда
		
		ДокументПереоценка = Документы.ПереоценкаЦенныхБумаг.СоздатьДокумент();
		
		ДокументПереоценка.Дата = КонецДня(ДатаПереоценки);
		ДокументПереоценка.Организация                           = Организация;
	    ДокументПереоценка.СчетДоверительногоУправления          = СчетДоверительногоУправления;
	    ДокументПереоценка.ВидУчета                              = ПараметрыОценки.ВидУчета;   
		ДокументПереоценка.ПереоцениватьНаОснованииНастроекУчета = НЕ ПереоцениватьБезУчетаНастроек;    
		ДокументПереоценка.ВариантРасчетаОценочнойСтоимости		 = ПараметрыОценки.ВариантРасчетаОценочнойСтоимости;
		
	Иначе
		
		Пока Выборка.Следующий() Цикл
			
			ПереоценкаИзВыборки = Выборка.Ссылка.ПолучитьОбъект();

			ПереоценкаИзВыборки.ПереоцениватьНаОснованииНастроекУчета = НЕ ПереоцениватьБезУчетаНастроек;	
			
			Если ПереоценкаИзВыборки.ВариантРасчетаОценочнойСтоимости <> ПереоценкаИзВыборки.ВариантРасчетаОценочнойСтоимости Тогда
				ПереоценкаИзВыборки.ВариантРасчетаОценочнойСтоимости = ПереоценкаИзВыборки.ВариантРасчетаОценочнойСтоимости;
			КонецЕсли;
			
			Если ДокументПереоценка = Неопределено Тогда
				ДокументПереоценка = ПереоценкаИзВыборки;
			Иначе
				ПереоценкаИзВыборки.Ответственный = Пользователь;
			КонецЕсли;
			
			МассивПереоценок.Добавить(ПереоценкаИзВыборки);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ДокументПереоценка.Ответственный = Пользователь;
	
	СообщенияСтарые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
	
	Попытка
		РаботаСПереоценкой.ПолучитьТабличнуюЧастьПереоценки(ДокументПереоценка, , Отказ);    
	Исключение
		ТекущаяОшибка = ОписаниеОшибки();
		
		СообщенияНовые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
		Для Инд = СообщенияСтарые.Количество() По СообщенияНовые.Количество() - 1 Цикл
			ТекущаяОшибка = ТекущаяОшибка + Символы.ПС + СообщенияНовые[Инд];
		КонецЦикла;
		
		СообщениеОшибкиПереоценки = СтрШаблон("По счету ДУ %1 не проведена переоценка ЦБ за %2. Система сообщает: %3",
					СчетДоверительногоУправления,
					ДатаПереоценки,
					ТекущаяОшибка);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОшибкиПереоценки,,,, Отказ); 
		                                                                                                 
		Возврат Неопределено;
	
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;   
	  
	ТабличнаяЧастьПереоценки = ДокументПереоценка.ЦенныеБумаги.Выгрузить(); 
	Если ПереоцениватьБезУчетаНастроек И ПараметрыОценки.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
		
		НастройкиПереоценкиЦенныхБумаг = БухгалтерскийУчет.ОпределитьНастройкиУчетаЦенныхБумаг(ДатаПереоценки, 
			Организация,
			СчетДоверительногоУправления,
			"ПолучитьСписокНастроекДляПереоценки");
		
		// в дату реформации для НУ очищаем переоценку ценной бумаги, так как в переоценке не будет применена политика учета,
		// а в НУ бумаги не переоцениваются. Купон переоценивается. 
		Для Каждого СтрокаТЧ из ТабличнаяЧастьПереоценки Цикл 
			СтрокаТЧ.ОценочнаяЦена = СтрокаТЧ.БалансоваяЦена;
			СтрокаТЧ.ОценочнаяЦенаПроцент = СтрокаТЧ.БалансоваяЦенаПроцент;
			СтрокаТЧ.ОценочнаяСумма = СтрокаТЧ.БалансоваяСумма;
			СтрокаТЧ.ОценочнаяСуммаВВалютеУчета = СтрокаТЧ.БалансоваяСуммаВВалютеУчета;
			
			// а для облигаций проверим настройки на дефолт
			Если СтрокаТЧ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
				ОтборПоНастройке = Новый Структура("ЦеннаяБумага, Настройка, ЗначениеНастройки",
					СтрокаТЧ.ЦеннаяБумага,
					ПланыВидовХарактеристик.НастройкиУчетаЦенныхБумаг.ПериодичностьНачисленияПроцентныхДоходов,
					Перечисления.ПериодичностьПереоценкиАктивов.НеПереоценивать);
				
				СтрокиНастроек = НастройкиПереоценкиЦенныхБумаг.НайтиСтроки(ОтборПоНастройке);
				
				Если СтрокиНастроек.Количество() > 0 Тогда // есть настройка, запрещающая начисление
					
					СтрокаТЧ.ОценочнаяЦенаКупона  = СтрокаТЧ.БалансоваяЦенаКупона;
					СтрокаТЧ.ОценочнаяСуммаКупона = СтрокаТЧ.БалансоваяСуммаКупона;
					СтрокаТЧ.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаТЧ.БалансоваяСуммаКупонаВВалютеУчета;
					
				КонецЕсли;
			
			КонецЕсли;
			
		КонецЦикла;   
		
	КонецЕсли;
	
	ДокументПереоценка.ЦенныеБумаги.Очистить();
	ДокументПереоценка.ДополнительныеСвойства.Вставить("ЦенныеБумаги", ТабличнаяЧастьПереоценки);
	
	РазрешенаИнтерактивнаяРаботаСДокументом = Документы.ПереоценкаЦенныхБумаг.РазрешенаИнтерактивнаяРаботаСДокументом(ДокументПереоценка);
	КоличествоПартий = ТабличнаяЧастьПереоценки.Количество();
	
	Если РазрешенаИнтерактивнаяРаботаСДокументом ИЛИ КоличествоПартий < МаксимальноеКоличествоПартийВПереоценке Тогда
		
		СообщенияСтарые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
		
		ДокументПереоценка.ДополнительныеСвойства.Вставить("ПереоцениватьЦБНеНаБалансе"); // к получению, в РЕПО, по РЕПО и пр.
		
		Если НЕ РазрешенаИнтерактивнаяРаботаСДокументом Тогда
			ДокументПереоценка.ДополнительныеСвойства.Вставить("ФормированиеБухгалтерскогоУчета");
		КонецЕсли;
		
		Попытка
			ДокументПереоценка.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ТекущаяОшибка = ОписаниеОшибки();
			
			СообщенияНовые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
			Для Инд = СообщенияСтарые.Количество() По СообщенияНовые.Количество() - 1 Цикл
				ТекущаяОшибка = ТекущаяОшибка + Символы.ПС + СообщенияНовые[Инд];
			КонецЦикла;
			
			СообщениеОшибкиПереоценки = СтрШаблон("По счету ДУ %1 не проведена переоценка ЦБ за %2. Система сообщает: %3",
						СчетДоверительногоУправления,
						ДатаПереоценки,
						ТекущаяОшибка);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОшибкиПереоценки,,,, Отказ); 
			
			ЗаписьЖурналаРегистрации("ФБУ.ПереоценитьАктивы", УровеньЖурналаРегистрации.Ошибка, Метаданные.Обработки.ФормированиеБухгалтерскогоУчета,, СообщениеОшибкиПереоценки);
			
			Возврат Неопределено;
			
		КонецПопытки;

	Иначе
		// контроль остатков
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		СообщенияСтарые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
		
		Если НЕ Документы.ПереоценкаЦенныхБумаг.СверитьДанныеПереоценкиСОстаткамиПартий(ДокументПереоценка, Запрос) Тогда
		
			ТекущаяОшибка = ОписаниеОшибки();
			
			СообщенияНовые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
			Для Инд = СообщенияСтарые.Количество() По СообщенияНовые.Количество() - 1 Цикл
				ТекущаяОшибка = ТекущаяОшибка + Символы.ПС + СообщенияНовые[Инд];
			КонецЦикла;
			
			СообщениеОшибкиПереоценки = СтрШаблон("По счету ДУ %1 не проведена переоценка ЦБ за %2. Система сообщает: %3",
						СчетДоверительногоУправления,
						ДатаПереоценки,
						ТекущаяОшибка);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОшибкиПереоценки,,,, Отказ); 
			
			ЗаписьЖурналаРегистрации("ФБУ.ПереоценитьАктивы", УровеньЖурналаРегистрации.Ошибка, Метаданные.Обработки.ФормированиеБухгалтерскогоУчета,, СообщениеОшибкиПереоценки);
			
			Возврат Неопределено;
		
		КонецЕсли;
		
		// хватит ли нам документов
		НужноПереоценок = Цел(КоличествоПартий / МаксимальноеКоличествоПартийВПереоценке);
		ПартийВПоследнейПереоценке = КоличествоПартий % МаксимальноеКоличествоПартийВПереоценке;
		Если ПартийВПоследнейПереоценке <> 0 Тогда
			НужноПереоценок = НужноПереоценок + 1;
		КонецЕсли;
		
		Если НужноПереоценок > МассивПереоценок.Количество() Тогда
			ДобавитьПереоценок = НужноПереоценок - МассивПереоценок.Количество();
			Для Инд = 1 По ДобавитьПереоценок Цикл
				НоваяПереоценка = Документы.ПереоценкаЦенныхБумаг.СоздатьДокумент();
				ЗаполнитьЗначенияСвойств(НоваяПереоценка, ДокументПереоценка, "Дата,Организация,СчетДоверительногоУправления,ВидУчета,ПереоцениватьНаОснованииНастроекУчета,ВариантРасчетаОценочнойСтоимости,Ответственный");
				МассивПереоценок.Добавить(НоваяПереоценка);
				НоваяПереоценка.ДополнительныеСвойства.Вставить("ФормированиеБухгалтерскогоУчета");
				НоваяПереоценка.Записать(РежимЗаписиДокумента.Запись);
			КонецЦикла;
		ИначеЕсли НужноПереоценок < МассивПереоценок.Количество() Тогда // ну вдруг оказалась лишняя переоценка
			Для Инд = НужноПереоценок По МассивПереоценок.Количество() - 1 Цикл
				ДокументПереоценка = МассивПереоценок[Инд];
				ДокументПереоценка.ДополнительныеСвойства.Вставить("ФормированиеБухгалтерскогоУчета");
				ДокументПереоценка.УстановитьПометкуУдаления(Истина);
			КонецЦикла;
		КонецЕсли;
		
		// отсортируем переоценки по моменту времени
		Для Инд = 0 По НужноПереоценок - 2 Цикл
			Для Инд1 = Инд + 1 По НужноПереоценок - 1 Цикл
				Если МассивПереоценок[Инд].МоментВремени().Сравнить(МассивПереоценок[Инд1].МоментВремени()) = 1 Тогда
					ДокументПереоценка = МассивПереоценок[Инд];
					МассивПереоценок[Инд] = МассивПереоценок[Инд1];
					МассивПереоценок[Инд1] = ДокументПереоценка;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Для Инд = 0 По НужноПереоценок - 1 Цикл
			ДокументПереоценка = МассивПереоценок[Инд];
			
			МассивСтрокДляКопирования = Новый Массив();
			СкопироватьСтрок = ?(Инд = НужноПереоценок - 1, ПартийВПоследнейПереоценке, МаксимальноеКоличествоПартийВПереоценке);
			Для Инд1 = 1 По СкопироватьСтрок Цикл
				МассивСтрокДляКопирования.Добавить(ТабличнаяЧастьПереоценки[Инд * МаксимальноеКоличествоПартийВПереоценке + (Инд1 - 1)]);
			КонецЦикла;
			
			ДокументПереоценка.ДополнительныеСвойства.Вставить("ЦенныеБумаги", ТабличнаяЧастьПереоценки.Скопировать(МассивСтрокДляКопирования));
			ДокументПереоценка.ДополнительныеСвойства.Вставить("ФормированиеБухгалтерскогоУчета");
			
			Если Инд = 0 Тогда // достаточно чтобы эти активы переоценила 1ая переоценка в течение дня, а остальные не тратили время 
				ДокументПереоценка.ДополнительныеСвойства.Вставить("ПереоцениватьЦБНеНаБалансе"); // к получению, в РЕПО, по РЕПО и пр.
			КонецЕсли;

			СообщенияСтарые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
			
			Попытка
				ДокументПереоценка.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ТекущаяОшибка = ОписаниеОшибки();
				
				СообщенияНовые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
				Для Инд = СообщенияСтарые.Количество() По СообщенияНовые.Количество() - 1 Цикл
					ТекущаяОшибка = ТекущаяОшибка + Символы.ПС + СообщенияНовые[Инд];
				КонецЦикла;
				
				СообщениеОшибкиПереоценки = СтрШаблон("По счету ДУ %1 не проведена переоценка ЦБ за %2. Система сообщает: %3",
							СчетДоверительногоУправления,
							ДатаПереоценки,
							ТекущаяОшибка);
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОшибкиПереоценки,,,, Отказ); 
				
				ЗаписьЖурналаРегистрации("ФБУ.ПереоценитьАктивы", УровеньЖурналаРегистрации.Ошибка, Метаданные.Обработки.ФормированиеБухгалтерскогоУчета,, СообщениеОшибкиПереоценки);
				
				Возврат Неопределено;
				
			КонецПопытки;
		
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ДокументПереоценка;
	
КонецФункции

Функция ПереоценитьВалютныеАктивы(Организация, СчетДоверительногоУправления, ДатаПереоценки, ВидУчета, Пользователь, ФЗУИД, НаУтро, ПереоцениватьБезУчетаНастроек, Отказ)
	
	НужнаПерекурсовка = ПереоцениватьБезУчетаНастроек ИЛИ Документы.ПереоценкаВалютныхЦенностей.НужнаПерекурсовка(ДатаПереоценки, Организация, СчетДоверительногоУправления, ВидУчета);
	
	Если НЕ НужнаПерекурсовка Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МетодикаПерекурсовкиВалютныхАктивовИОбязательств = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(ДатаПереоценки, Организация, СчетДоверительногоУправления, ВидУчета, "МетодикаПерекурсовкиВалютныхАктивовИОбязательств");
	
	Если МетодикаПерекурсовкиВалютныхАктивовИОбязательств = Перечисления.МетодикиПерекурсовкиВалютныхАктивовИОбязательств.ПереоцениватьКаждымДокументомИВКонцеДняПоНастройкамПериодичности И НаУтро Тогда
		
		Возврат Неопределено;
		
	ИначеЕсли МетодикаПерекурсовкиВалютныхАктивовИОбязательств = Перечисления.МетодикиПерекурсовкиВалютныхАктивовИОбязательств.ПереоцениватьКаждымДокументомИВКонцеДняПоНастройкамПериодичности Тогда
	
		НачальнаяДата = НачалоДня(ДатаПереоценки);
		КонечнаяДата = КонецДня(ДатаПереоценки);
		ДатаДокумента = КонечнаяДата;
		
	ИначеЕсли МетодикаПерекурсовкиВалютныхАктивовИОбязательств = Перечисления.МетодикиПерекурсовкиВалютныхАктивовИОбязательств.ПереоцениватьВНачалеИКонцеДня Тогда
		
		Если НаУтро Тогда
			НачальнаяДата = НачалоДня(ДатаПереоценки);
			КонечнаяДата = НачалоДня(ДатаПереоценки) + 12 * 60 * 60;
			ДатаДокумента = НачальнаяДата;
		Иначе
			НачальнаяДата = КонецДня(ДатаПереоценки) - 12 * 60 * 60;
			КонечнаяДата = КонецДня(ДатаПереоценки);
			ДатаДокумента = КонечнаяДата;
		КонецЕсли;
		
	Иначе 
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить методику перекурсовки активов и обязательств для  " + СчетДоверительногоУправления + " в организации " + Организация,,,,Отказ); 
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПереоценкаВалютныхЦенностей.Ссылка КАК Ссылка,
		|	ПереоценкаВалютныхЦенностей.Проведен КАК Проведен
		|ИЗ
		|	Документ.ПереоценкаВалютныхЦенностей КАК ПереоценкаВалютныхЦенностей
		|ГДЕ
		|	ПереоценкаВалютныхЦенностей.Организация = &Организация
		|	И ПереоценкаВалютныхЦенностей.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПереоценкаВалютныхЦенностей.ВидУчета = &ВидУчета
		|	И ПереоценкаВалютныхЦенностей.Дата МЕЖДУ &НачальнаяДата И &КонечнаяДата
		|	И НЕ ПереоценкаВалютныхЦенностей.ПометкаУдаления
        |   И НЕ ПереоценкаВалютныхЦенностей.Проведен";

	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета",                     ВидУчета);
	Запрос.УстановитьПараметр("НачальнаяДата",                НачальнаяДата);
	Запрос.УстановитьПараметр("КонечнаяДата",                 КонечнаяДата);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		
		ДокументПереоценкаВалютныхЦенностей = Выборка.Ссылка.ПолучитьОбъект();
		 
	Иначе
		
		ДокументПереоценкаВалютныхЦенностей = Документы.ПереоценкаВалютныхЦенностей.СоздатьДокумент();
		
		ДокументПереоценкаВалютныхЦенностей.Дата = ДатаДокумента;
		ДокументПереоценкаВалютныхЦенностей.Организация                           = Организация;
	    ДокументПереоценкаВалютныхЦенностей.СчетДоверительногоУправления          = СчетДоверительногоУправления;
	    ДокументПереоценкаВалютныхЦенностей.ВидУчета                              = ВидУчета;
		
	КонецЕсли;
	
	ДокументПереоценкаВалютныхЦенностей.Ответственный = Пользователь;
	
	СообщенияСтарые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
	
	Попытка
		ДокументПереоценкаВалютныхЦенностей.Записать(РежимЗаписиДокумента.Проведение);
		Возврат ДокументПереоценкаВалютныхЦенностей.Ссылка;
	Исключение
		ТекущаяОшибка = ОписаниеОшибки();
		
		СообщенияНовые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
		Для Инд = СообщенияСтарые.Количество() По СообщенияНовые.Количество() - 1 Цикл
			ТекущаяОшибка = ТекущаяОшибка + Символы.ПС + СообщенияНовые[Инд];
		КонецЦикла;
		
		СообщениеОшибкиПереоценкиВалютныеАктивы = СтрШаблон("По счету ДУ %1 не проведена переоценка валютных ценностей за %2. Система сообщает: %3",
					СчетДоверительногоУправления,
					ДатаПереоценки,
					ТекущаяОшибка);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОшибкиПереоценкиВалютныеАктивы,,,, Отказ); 
		
		ЗаписьЖурналаРегистрации("ФБУ.ПереоценитьВалютныеАктивы", УровеньЖурналаРегистрации.Ошибка, Метаданные.Обработки.ФормированиеБухгалтерскогоУчета,, СообщениеОшибкиПереоценкиВалютныеАктивы);
		
		Возврат Неопределено;
		
	КонецПопытки;  		
	Возврат ДокументПереоценкаВалютныхЦенностей.Ссылка;
	
КонецФункции

Функция НачислитьРезервы(Организация, СчетДоверительногоУправления, ДатаПереоценки, ВидУчета, Пользователь, ФЗУИД, ДеньРеформацииБаланса, Отказ)

	Если ВидУчета <> Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
	    Возврат Неопределено;
	КонецЕсли;
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ДатаПереоценки, Организация, СчетДоверительногоУправления);
	
	Если НастройкиУчета.ПериодичностьНачисленияРезервов = Перечисления.ПериодичностьПереоценкиАктивов.НеПереоценивать 
		ИЛИ НастройкиУчета.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов <> Перечисления.СтандартыФинансовойОтчетности.МСФО9 Тогда // в данном случае начисление и списание резервов производится вручную и автомтически ничего делать не нужно
		Возврат Неопределено;
	КонецЕсли;
	
	НужноНачислениеРезервов = ДеньРеформацииБаланса ИЛИ БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(НастройкиУчета.ПериодичностьНачисленияРезервов, ДатаПереоценки);
		
	ТолькоПоступившиеАктивы = НЕ НужноНачислениеРезервов И НастройкиУчета.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов = Перечисления.СтандартыФинансовойОтчетности.МСФО9;
	
	СообщенияСтарые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
	
	ДокументНачисленияРезервовСтарый = Документы.НачислениеСписаниеРезервов.ПолучитьСуществующийДокумент(Организация, СчетДоверительногоУправления, ДатаПереоценки, Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
	
	Если ДокументНачисленияРезервовСтарый = Неопределено Тогда
		ДокументНачисленияРезервов = Документы.НачислениеСписаниеРезервов.СоздатьДокумент();
		ДокументНачисленияРезервов.Дата = КонецДня(ДатаПереоценки);
		ДокументНачисленияРезервов.Организация = Организация;
		ДокументНачисленияРезервов.СчетДоверительногоУправления = СчетДоверительногоУправления;
		ДокументНачисленияРезервов.ЦельРасчета = Справочники.ЦелиРасчета.ЕдиныйПланСчетов;
	Иначе
		ДокументНачисленияРезервов = ДокументНачисленияРезервовСтарый.ПолучитьОбъект();
		
		// Хардкод - восстанавливаем время с КонецДня(ДатаПереоценки)
		Если ДокументНачисленияРезервов.Дата >= '20250101' И ДокументНачисленияРезервов.Дата < '20250219' И Не ДокументНачисленияРезервов.ПереходНаМСФО9 Тогда
			ДокументНачисленияРезервов.Дата = РаботаСДокументами.ПолучитьВремяДокумента(ДокументНачисленияРезервов.Дата, ДокументНачисленияРезервов.Ссылка);	
		КонецЕсли;	
		
		Если НЕ ЗаписатьДокумент(ДокументНачисленияРезервов, РежимЗаписиДокумента.ОтменаПроведения, ФЗУИД) Тогда
			Отказ = Истина;
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	ДокументНачисленияРезервов.Ответственный = Пользователь;
	
	ДокументНачисленияРезервов.ЗаполнитьРезервы(Отказ,, ТолькоПоступившиеАктивы);
	
	Если ДокументНачисленияРезервов.Партии.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		ДокументНачисленияРезервов.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ТекущаяОшибка = ОписаниеОшибки();
		
		СообщенияНовые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
		Для Инд = СообщенияСтарые.Количество() По СообщенияНовые.Количество() - 1 Цикл
			ТекущаяОшибка = ТекущаяОшибка + Символы.ПС + СообщенияНовые[Инд];
		КонецЦикла;
		
		СообщениеОшибкиРезервов = СтрШаблон("Не удалось провести документ начисления/списания резервов, счет ДУ  %1 , дата  %2. Система сообщает: %3",
			СчетДоверительногоУправления,
			ДатаПереоценки,
			ТекущаяОшибка);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОшибкиРезервов,,,, Отказ); 
		
		ЗаписьЖурналаРегистрации("ФБУ.НачислитьРезервы", УровеньЖурналаРегистрации.Ошибка, Метаданные.Обработки.ФормированиеБухгалтерскогоУчета,, СообщениеОшибкиРезервов);
		
		Возврат Неопределено;
	КонецПопытки;

	Возврат ДокументНачисленияРезервов.Ссылка;
	
КонецФункции

Процедура ОтменитьПереоценку(Организация, СчетДоверительногоУправления, ДатаПереоценки, ВидУчета, ФЗУИД, Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПереоценкаЦенныхБумаг.Ссылка КАК Ссылка,
		|	ПереоценкаЦенныхБумаг.Проведен КАК Проведен
		|ИЗ
		|	Документ.ПереоценкаЦенныхБумаг КАК ПереоценкаЦенныхБумаг
		|ГДЕ
		|	ПереоценкаЦенныхБумаг.Организация = &Организация
		|	И ПереоценкаЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПереоценкаЦенныхБумаг.ВидУчета = &ВидУчета
		|	И ПереоценкаЦенныхБумаг.Дата МЕЖДУ &НачальнаяДата И &КонечнаяДата
		|	И ПереоценкаЦенныхБумаг.Проведен
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПереоценкаВалютныхЦенностей.Ссылка,
		|	ПереоценкаВалютныхЦенностей.Проведен
		|ИЗ
		|	Документ.ПереоценкаВалютныхЦенностей КАК ПереоценкаВалютныхЦенностей
		|ГДЕ
		|	ПереоценкаВалютныхЦенностей.Организация = &Организация
		|	И ПереоценкаВалютныхЦенностей.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПереоценкаВалютныхЦенностей.ВидУчета = &ВидУчета
		|	И ПереоценкаВалютныхЦенностей.Дата МЕЖДУ &НачальнаяДата И &КонечнаяДата
		|	И ПереоценкаВалютныхЦенностей.Проведен";

	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета",                     ВидУчета);
	Запрос.УстановитьПараметр("НачальнаяДата",                НачалоДня(ДатаПереоценки));
	Запрос.УстановитьПараметр("КонечнаяДата",                 КонецДня(ДатаПереоценки));

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		
		ДокументПереоценка = Выборка.Ссылка.ПолучитьОбъект();
		Если Выборка.Проведен Тогда
			
			// чистим отдельно т.к. платформа при отмене проведения ставит странную огромную блокировку
			Если ТипЗнч(Выборка.Ссылка) = Тип("ДокументСсылка.ПереоценкаЦенныхБумаг") Тогда
				Движения = РегистрыСведений.СтоимостьПереоценки.СоздатьНаборЗаписей();
				Движения.Отбор.Регистратор.Установить(Выборка.Ссылка);
				Движения.Записать();
				
				Движения = РегистрыНакопления.БухПартииЦенныхБумаг.СоздатьНаборЗаписей();
				Движения.Отбор.Регистратор.Установить(Выборка.Ссылка);
				Движения.Записать();
			КонецЕсли;
			
			ДокументПереоценка.ДополнительныеСвойства.Вставить("ФормированиеБухгалтерскогоУчета");
			Если НЕ ЗаписатьДокумент(ДокументПереоценка, РежимЗаписиДокумента.ОтменаПроведения, ФЗУИД) Тогда
				Отказ = Истина;
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЗакрытьСчетаЗаПериод(Организация, СчетДоверительногоУправления, НачальнаяДата, КонечнаяДата, Периодичность, ВидУчета, Пользователь, ФЗУИД, Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗакрытиеБухгалтерскихСчетов.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗакрытиеБухгалтерскихСчетов КАК ЗакрытиеБухгалтерскихСчетов
		|ГДЕ
		|	ЗакрытиеБухгалтерскихСчетов.Организация = &Организация
		|	И ЗакрытиеБухгалтерскихСчетов.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ЗакрытиеБухгалтерскихСчетов.Дата МЕЖДУ &НачальнаяДата И &КонечнаяДата
		|	И ЗакрытиеБухгалтерскихСчетов.НачалоПериода = &НачалоПериода
		|	И ЗакрытиеБухгалтерскихСчетов.ОкончаниеПериода = &ОкончаниеПериода
		|	И ЗакрытиеБухгалтерскихСчетов.ВидУчета = &ВидУчета
		|	И НЕ ЗакрытиеБухгалтерскихСчетов.ПометкаУдаления
        |   И НЕ ЗакрытиеБухгалтерскихСчетов.Проведен";

	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачальнаяДата", НачалоДня(КонечнаяДата));
	Запрос.УстановитьПараметр("КонечнаяДата", КонецДня(КонечнаяДата));
	Запрос.УстановитьПараметр("НачалоПериода", НачальнаяДата);
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонечнаяДата);
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		ДокументЗакрытияСчетов = Выборка.Ссылка.ПолучитьОбъект();
		ДокументЗакрытияСчетов.ЗакрываемыеСчета.Очистить();
		
	Иначе
		
		ДокументЗакрытияСчетов = Документы.ЗакрытиеБухгалтерскихСчетов.СоздатьДокумент();
		
		ДокументЗакрытияСчетов.Дата = КонецДня(КонечнаяДата);
		
	    ДокументЗакрытияСчетов.Организация = Организация;
	    ДокументЗакрытияСчетов.СчетДоверительногоУправления = СчетДоверительногоУправления;
	    ДокументЗакрытияСчетов.НачалоПериода = НачальнаяДата;
	    ДокументЗакрытияСчетов.ОкончаниеПериода = КонечнаяДата;
	    ДокументЗакрытияСчетов.ВидУчета = ВидУчета;
		
	КонецЕсли;
	
	ДокументЗакрытияСчетов.Ответственный = Пользователь;
	
	ВариантыЗакрытияБухгалтерскихСчетов = БухгалтерскийУчет.ОпределитьВариантыЗакрытияБухгалтерскихСчетов(КонечнаяДата, Организация, СчетДоверительногоУправления, ВидУчета, Периодичность);
	
	ЗакрытиеСчета90 = Ложь;
	ЗакрытиеСчета91 = Ложь;
	ЗакрытиеСчетов901и902 = Ложь;
	ЗакрытиеСчетов911и912 = Ложь;
	ЗакрытиеСчета99 = Ложь;
	ЕПСЗакрытиеРаздела7 = Ложь;
	ЗакрытиеСчета79 = Ложь;
	
	Для каждого ВариантЗакрытияБухгалтерскихСчетов Из ВариантыЗакрытияБухгалтерскихСчетов Цикл
		Если ВариантЗакрытияБухгалтерскихСчетов = Перечисления.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчета90 Тогда
			ЗакрытиеСчета90 = Истина;	
		ИначеЕсли ВариантЗакрытияБухгалтерскихСчетов = Перечисления.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчета91 Тогда
			ЗакрытиеСчета91 = Истина;	
		ИначеЕсли ВариантЗакрытияБухгалтерскихСчетов = Перечисления.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчетов901и902 Тогда
			ЗакрытиеСчетов901и902 = Истина;	
		ИначеЕсли ВариантЗакрытияБухгалтерскихСчетов = Перечисления.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчетов911и912 Тогда
			ЗакрытиеСчетов911и912 = Истина;	
		ИначеЕсли ВариантЗакрытияБухгалтерскихСчетов = Перечисления.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчета99 Тогда
			ЗакрытиеСчета99 = Истина;	
		ИначеЕсли ВариантЗакрытияБухгалтерскихСчетов = Перечисления.ВариантыЗакрытияБухгалтерскихСчетов.ЕПСЗакрытиеРаздела7 Тогда
			ЕПСЗакрытиеРаздела7 = Истина;	
		КонецЕсли;
	КонецЦикла;
	
	Если Периодичность = Перечисления.ПериодичностьПереоценкиАктивов.Ежегодно И СчетДоверительногоУправления.ДатаРасторжения = КонечнаяДата
		И ВидУчета <> Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда 
		ЗакрытиеСчета79 = Истина;
	КонецЕсли;	
	
	Если ЗакрытиеСчета90 Тогда
		СтрокаЗакрытия = ДокументЗакрытияСчетов.ЗакрываемыеСчета.Добавить();
		СтрокаЗакрытия.ВариантЗакрытияБухгалтерскихСчетов = Перечисления.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчета90;
	КонецЕсли;
	Если ЗакрытиеСчета91 Тогда
		СтрокаЗакрытия = ДокументЗакрытияСчетов.ЗакрываемыеСчета.Добавить();
		СтрокаЗакрытия.ВариантЗакрытияБухгалтерскихСчетов = Перечисления.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчета91;
	КонецЕсли;
	Если ЗакрытиеСчетов901и902 Тогда
		СтрокаЗакрытия = ДокументЗакрытияСчетов.ЗакрываемыеСчета.Добавить();
		СтрокаЗакрытия.ВариантЗакрытияБухгалтерскихСчетов = Перечисления.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчетов901и902;
	КонецЕсли;
	Если ЗакрытиеСчетов911и912 Тогда
		СтрокаЗакрытия = ДокументЗакрытияСчетов.ЗакрываемыеСчета.Добавить();
		СтрокаЗакрытия.ВариантЗакрытияБухгалтерскихСчетов = Перечисления.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчетов911и912;
	КонецЕсли;
	Если ЗакрытиеСчета99 Тогда
		СтрокаЗакрытия = ДокументЗакрытияСчетов.ЗакрываемыеСчета.Добавить();
		СтрокаЗакрытия.ВариантЗакрытияБухгалтерскихСчетов = Перечисления.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчета99;
	КонецЕсли;
	Если ЗакрытиеСчета79 Тогда
		СтрокаЗакрытия = ДокументЗакрытияСчетов.ЗакрываемыеСчета.Добавить();
		СтрокаЗакрытия.ВариантЗакрытияБухгалтерскихСчетов = Перечисления.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчета79;
	КонецЕсли;	
	
	Если ЕПСЗакрытиеРаздела7 Тогда
		СтрокаЗакрытия = ДокументЗакрытияСчетов.ЗакрываемыеСчета.Добавить();
		СтрокаЗакрытия.ВариантЗакрытияБухгалтерскихСчетов = Перечисления.ВариантыЗакрытияБухгалтерскихСчетов.ЕПСЗакрытиеРаздела7;
	КонецЕсли;
	
	Если ДокументЗакрытияСчетов.ЗакрываемыеСчета.Количество() > 0 Тогда
		
		СообщенияСтарые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
	
		Попытка
			ДокументЗакрытияСчетов.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ТекущаяОшибка = ОписаниеОшибки();
			
			СообщенияНовые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
			Для Инд = СообщенияСтарые.Количество() По СообщенияНовые.Количество() - 1 Цикл
				ТекущаяОшибка = ТекущаяОшибка + Символы.ПС + СообщенияНовые[Инд];
			КонецЦикла;
			
			СообщениеОшибкиЗакрытьСчета = СтрШаблон("Не удалось провести документ закрытия бухгалтерских счетов, счет ДУ %1 , дата %2. Система сообщает: %3",
						СчетДоверительногоУправления,
						КонечнаяДата,
						ТекущаяОшибка);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОшибкиЗакрытьСчета,,,, Отказ); 
			
			ЗаписьЖурналаРегистрации("ФБУ.ЗакрытьСчетаЗаПериод", УровеньЖурналаРегистрации.Ошибка, Метаданные.Обработки.ФормированиеБухгалтерскогоУчета,, СообщениеОшибкиЗакрытьСчета);
			
			Возврат Неопределено;
			
		КонецПопытки;

		Возврат ДокументЗакрытияСчетов.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Процедура РассчитатьСтоимостиПереоценки(Организация, СчетДоверительногоУправления, ПараметрыОценки, ДатаПереоценки, Пользователь, ФЗУИД, ТаблицаЦенныхБумаг = Неопределено, Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РегистрацияСтоимостиПереоценки.Ссылка КАК Ссылка,
		|	НАЧАЛОПЕРИОДА(РегистрацияСтоимостиПереоценки.Дата, ДЕНЬ) КАК Дата
		|ИЗ
		|	Документ.РегистрацияСтоимостиПереоценки КАК РегистрацияСтоимостиПереоценки
		|ГДЕ
		|	РегистрацияСтоимостиПереоценки.Организация = &Организация
		|	И РегистрацияСтоимостиПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И РегистрацияСтоимостиПереоценки.ВидУчета = &ВидУчета
		|	И РегистрацияСтоимостиПереоценки.ЦельРасчета = &ЦельРасчета
		|	И РегистрацияСтоимостиПереоценки.Дата МЕЖДУ &ДатаПереоценки И &КонечнаяДата
		|	И РегистрацияСтоимостиПереоценки.Проведен";

	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета",                   	ПараметрыОценки.ВидУчета);
	Запрос.УстановитьПараметр("ЦельРасчета",					ПараметрыОценки.ЦельРасчета);
	Запрос.УстановитьПараметр("ДатаПереоценки",					НачалоДня(ДатаПереоценки));
	Запрос.УстановитьПараметр("КонечнаяДата",					КонецДня(ДатаПереоценки));

	Выборка = Запрос.Выполнить().Выбрать();

	// Метим на удаление существующие документы.
	Для ИндексДокумента = 1 По Выборка.Количество() Цикл
		
		// Если нужен документ, то пропускаем последний элемент в выборке.
		Если ИндексДокумента = Выборка.Количество() Тогда
			Прервать;
		КонецЕсли;
		
		Если Выборка.Следующий() И НЕ ПометитьДокументНаУдаление(Выборка.Ссылка, ФЗУИД) Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Выборка.Следующий() Тогда
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокументОбъект.Ответственный = Пользователь;
	Иначе
		ДокументОбъект								= Документы.РегистрацияСтоимостиПереоценки.СоздатьДокумент();
		ДокументОбъект.Дата							= КонецДня(ДатаПереоценки);
	    ДокументОбъект.Организация					= Организация;
	    ДокументОбъект.СчетДоверительногоУправления	= СчетДоверительногоУправления;
	    ДокументОбъект.ВидУчета						= ПараметрыОценки.ВидУчета;
	    ДокументОбъект.ЦельРасчета					= ПараметрыОценки.ЦельРасчета;
		ДокументОбъект.Ответственный				= Пользователь;
	КонецЕсли;
	
	ТаблицаСтоимостей = Неопределено;
	
	Если ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом Тогда
		
		ЭтоСафмар = (Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, ДатаПереоценки) = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар"));
		// #424570 - после 1го марта 2022 Сафмар все-таки файлы дает. Но! Мы не можем брать эти файлы для оценки - работаем строго по письму ЦБ РФ (18.02.2022 или приобретение)
		// но эти файлы будут использоваться для поручений на преоценку в процедуре ЗаполнитьПоручениеНаПереоценку чтобы начислять процентные доходы в эти дни
		Если ЭтоСафмар И ДатаПереоценки > '20220228' И ДатаПереоценки < '20221021' Тогда
			
			// нам нужна просто чистая таблица, что бы передать ее в РСП (иначе она заглючит)
			ТаблицаСтоимостей = ДокументОбъект.СтоимостиПереоценки.ВыгрузитьКолонки(); 
			ТаблицаСтоимостей.Колонки.ЦенаКотировки.Имя = "Стоимость";
			
		Иначе
			
			// стоимости переоценок будут загружаться из файла
			Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, ДатаПереоценки);
			
			Каталог	= ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации(
						"КлиентыДоверительногоУправления.ШаблонФайловОценочнойСтоимостиЦенныхБумагПредоставленнойКлиентомЕПС",
						Клиент,
						ДатаПереоценки);
			ИмяФайла = ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации(
						"КлиентыДоверительногоУправления.ШаблонИмениФайлаСОценочнойСтоимостьюЦенныхБумагПредоставленнойКлиентомЗаДеньЕПС",
						Клиент,
						ДатаПереоценки);
			
			ПолноеИмяФайла = Каталог + ?(Прав(Каталог, 1) <> "\", "\", "") + ИмяФайла;
			
			ВыбФайл = Новый Файл(ПолноеИмяФайла);
			Если ВыбФайл.Существует() Тогда
				ТаблицаСтоимостей = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайла));
			Иначе
				// #379057 - согласно этой задаче пустая таблица это норм т.к. клиент просто ЕЩЕ не дал цены и у нас идет ПЕРВОЕ, ПРИМЕРНОЕ ФБУ
				// потом, когда клиент пришлет цены, будет ОКОНЧАТЕЛЬНОЕ ФБУ
				// но сообщить о том, что проводим учет без цен - стоит
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Учет формируется без цен, получаемых от клиента, т.к. отсутствует файл: %1", ПолноеИмяФайла));
				
				Отказ = НЕ ЗаписатьДокумент(ДокументОбъект, РежимЗаписиДокумента.Проведение, ФЗУИД);
				
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	СообщенияСтарые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
	
	Попытка
		ДокументОбъект.ЗаполнитьСтоимостьПереоценки(Истина, Ложь, Отказ, ТаблицаСтоимостей, Ложь, , ТаблицаЦенныхБумаг);
		
		ОцененныеПоАмортизированнойСтоимости = ДокументОбъект.СтоимостиПереоценки.НайтиСтроки(Новый Структура("ВидЦены", Перечисления.ИсточникиЦеныДляПереоценки.АмортизированнаяСтоимость));
		Для Каждого УдаляемаяСтрока Из ОцененныеПоАмортизированнойСтоимости Цикл
			ДокументОбъект.СтоимостиПереоценки.Удалить(УдаляемаяСтрока);
		КонецЦикла;
		
	Исключение
		ТекущаяОшибка = ОписаниеОшибки();
		
		СообщенияНовые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
		Для Инд = СообщенияСтарые.Количество() По СообщенияНовые.Количество() - 1 Цикл
			ТекущаяОшибка = ТекущаяОшибка + Символы.ПС + СообщенияНовые[Инд];
		КонецЦикла;
		
		СообщениеОшибкиСтоимостиПереоценки = СтрШаблон("Не удалось рассчитать стоимости ценных бумаг на: %1, %2. Система сообщает: %3. Счет ДУ: %4",
					ДатаПереоценки,
					ПараметрыОценки.ВидУчета,
					ТекущаяОшибка,
					СчетДоверительногоУправления);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОшибкиСтоимостиПереоценки,,,, Отказ); 
		
		ЗаписьЖурналаРегистрации("ФБУ.РассчитатьСтоимостиПереоценки", УровеньЖурналаРегистрации.Ошибка, Метаданные.Обработки.ФормированиеБухгалтерскогоУчета,, СообщениеОшибкиСтоимостиПереоценки);
		
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = НЕ ЗаписатьДокумент(ДокументОбъект, РежимЗаписиДокумента.Проведение, ФЗУИД);
	
	Возврат;
	
КонецПроцедуры

Процедура ЗаполнитьПоручениеНаПереоценку(Организация, СчетДоверительногоУправления, ПараметрыОценки, ДатаПереоценки, Пользователь, ФЗУИД, Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПоручениеНаПереоценку.Ссылка КАК Ссылка,
		|	НАЧАЛОПЕРИОДА(ПоручениеНаПереоценку.Дата, ДЕНЬ) КАК Дата
		|ИЗ
		|	Документ.ПоручениеНаПереоценку КАК ПоручениеНаПереоценку
		|ГДЕ
		|	ПоручениеНаПереоценку.Организация = &Организация
		|	И ПоручениеНаПереоценку.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПоручениеНаПереоценку.ВидУчета = &ВидУчета
		|	И ПоручениеНаПереоценку.ПереоцениватьЦенныеБумаги
		|	И ПоручениеНаПереоценку.Дата МЕЖДУ &ДатаПереоценки И &КонечнаяДата
		|	И ПоручениеНаПереоценку.Проведен";

	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета",                   	ПараметрыОценки.ВидУчета);
	Запрос.УстановитьПараметр("ДатаПереоценки",					НачалоДня(ДатаПереоценки));
	Запрос.УстановитьПараметр("КонечнаяДата",					КонецДня(ДатаПереоценки));

	Выборка = Запрос.Выполнить().Выбрать();

	// Метим на удаление существующие документы.
	Для ИндексДокумента = 1 По Выборка.Количество() Цикл
		
		// Если нужен документ, то пропускаем последний элемент в выборке.
		Если ИндексДокумента = Выборка.Количество() Тогда
			Прервать;
		КонецЕсли;
		
		Если Выборка.Следующий() И НЕ ПометитьДокументНаУдаление(Выборка.Ссылка, ФЗУИД) Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Выборка.Следующий() Тогда
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокументОбъект.Ответственный = Пользователь;
	Иначе
		ДокументОбъект								= Документы.ПоручениеНаПереоценку.СоздатьДокумент();
		ДокументОбъект.Дата							= КонецДня(ДатаПереоценки);
	    ДокументОбъект.Организация					= Организация;
	    ДокументОбъект.СчетДоверительногоУправления	= СчетДоверительногоУправления;
	    ДокументОбъект.ВидУчета						= ПараметрыОценки.ВидУчета;
		ДокументОбъект.Ответственный				= Пользователь;
		ДокументОбъект.ПереоцениватьЦенныеБумаги	= Истина;
	КонецЕсли;
	
	ТаблицаСтоимостей = Неопределено;
	
	// поручения на переоценку будут загружаться из файла
	Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, ДатаПереоценки);
	
	Каталог	= ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации(
				"КлиентыДоверительногоУправления.ШаблонФайловОценочнойСтоимостиЦенныхБумагПредоставленнойКлиентомЕПС",
				Клиент,
				ДатаПереоценки);
	ИмяФайла = ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации(
				"КлиентыДоверительногоУправления.ШаблонИмениФайлаСОценочнойСтоимостьюЦенныхБумагПредоставленнойКлиентомЗаДеньЕПС",
				Клиент,
				ДатаПереоценки);
	
	ПолноеИмяФайла = Каталог + ?(Прав(Каталог, 1) <> "\", "\", "") + ИмяФайла;
	
	ВыбФайл = Новый Файл(ПолноеИмяФайла);
	Если ВыбФайл.Существует() Тогда
		ТаблицаСтоимостей = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайла));
	Иначе
		// #379057 - согласно этой задаче пустая таблица это норм т.к. клиент просто ЕЩЕ не дал цены и у нас идет ПЕРВОЕ, ПРИМЕРНОЕ ФБУ
		// потом, когда клиент пришлет цены, будет ОКОНЧАТЕЛЬНОЕ ФБУ
		// но сообщить о том, что проводим учет без цен - стоит
		Если Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, ДатаПереоценки)
			= ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар") 
			И ДатаПереоценки > '20220228'
			И ПараметрыОценки.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
			// после 28го сафмар уже не дает файлов и это норма
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствуют данные для поручения на переоценку за %1", ДатаПереоценки));
		Иначе	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Учет формируется без цен, получаемых от клиента, т.к. отсутствует файл: %1", ПолноеИмяФайла));
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	СообщенияСтарые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
	
	Попытка
		ДокументОбъект.ЗаполнитьИзФайла(ТаблицаСтоимостей, Отказ);
	Исключение
		ТекущаяОшибка = ОписаниеОшибки();
		
		СообщенияНовые = РаботаСДлительнымиОперациями.ПолучитьСообщения(ФЗУИД);
		Для Инд = СообщенияСтарые.Количество() По СообщенияНовые.Количество() - 1 Цикл
			ТекущаяОшибка = ТекущаяОшибка + Символы.ПС + СообщенияНовые[Инд];
		КонецЦикла;
		
		СообщениеОшибкиПоручениеНаПереоценку = СтрШаблон("Не удалось заполнить поручение на переоценку: %1, %2. Система сообщает: %3. Счет ДУ: %4",
					ДатаПереоценки,
					ПараметрыОценки.ВидУчета,
					ТекущаяОшибка,
					СчетДоверительногоУправления);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОшибкиПоручениеНаПереоценку,,,, Отказ); 
		
		ЗаписьЖурналаРегистрации("ФБУ.ЗаполнитьПоручениеНаПереоценку", УровеньЖурналаРегистрации.Ошибка, Метаданные.Обработки.ФормированиеБухгалтерскогоУчета,, СообщениеОшибкиПоручениеНаПереоценку);
		
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = НЕ ЗаписатьДокумент(ДокументОбъект, РежимЗаписиДокумента.Проведение, ФЗУИД);
	
	Возврат;
	
КонецПроцедуры

Функция ПроверкаОповещенияДвиженийАктивовОцениваемыхПоАС(Источник, СчетДоверительногоУправления, ДатаПроверкиОферты) 
	
	Запрос = Новый Запрос;
#Область ТЕКСТ_ЗАПРОСА	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НаборЗаписей.Период КАК Период,
		|	НаборЗаписей.Регистратор КАК Регистратор,
		|	НаборЗаписей.Рынок КАК Рынок,
		|	НаборЗаписей.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	НаборЗаписей.ВидДвижения КАК ВидДвижения,
		|	НаборЗаписей.ЦеннаяБумага КАК ЦеннаяБумага,
		|	НаборЗаписей.Количество КАК Количество
		|ПОМЕСТИТЬ _НаборЗаписей
		|ИЗ
		|	&НаборЗаписей КАК НаборЗаписей
		|ГДЕ
		|	НаборЗаписей.УчетныйАктивЕПС В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПСД), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения))
		|	И НаборЗаписей.Регистратор <> НЕОПРЕДЕЛЕНО
		|	И НаборЗаписей.Количество > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияОферт.Облигация КАК Облигация,
		|	МИНИМУМ(УсловияОферт.ДатаВыкупа) КАК ДатаБлижайшейОферты
		|ПОМЕСТИТЬ _УсловияОферт
		|ИЗ
		|	РегистрСведений.УсловияОферт КАК УсловияОферт
		|ГДЕ
		|	УсловияОферт.ДатаВыкупа > &ДатаПроверкиОферты
		|	И УсловияОферт.Облигация В
		|			(ВЫБРАТЬ
		|				_НаборЗаписей.ЦеннаяБумага КАК ЦеннаяБумага
		|			ИЗ
		|				_НаборЗаписей КАК _НаборЗаписей)
		|
		|СГРУППИРОВАТЬ ПО
		|	УсловияОферт.Облигация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НаборЗаписей.Период КАК Период,
		|	_НаборЗаписей.Регистратор КАК Регистратор,
		|	_НаборЗаписей.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(_НаборЗаписей.Количество) КАК Количество,
		|	ВЫРАЗИТЬ(_НаборЗаписей.ЦеннаяБумага КАК Справочник.Облигации).ДатаПогашения КАК ДатаПогашения,
		|	ЕСТЬNULL(_УсловияОферт.ДатаБлижайшейОферты, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаБлижайшейОферты,
		|	_НаборЗаписей.ВидДвижения КАК ВидДвижения,
		|	_НаборЗаписей.УчетныйАктивЕПС КАК УчетныйАктивЕПС
		|ИЗ
		|	_НаборЗаписей КАК _НаборЗаписей
		|		ЛЕВОЕ СОЕДИНЕНИЕ _УсловияОферт КАК _УсловияОферт
		|		ПО _НаборЗаписей.ЦеннаяБумага = _УсловияОферт.Облигация
		|
		|СГРУППИРОВАТЬ ПО
		|	_НаборЗаписей.Период,
		|	_НаборЗаписей.Регистратор,
		|	_НаборЗаписей.ЦеннаяБумага,
		|	ВЫРАЗИТЬ(_НаборЗаписей.ЦеннаяБумага КАК Справочник.Облигации).ДатаПогашения,
		|	ЕСТЬNULL(_УсловияОферт.ДатаБлижайшейОферты, ДАТАВРЕМЯ(1, 1, 1)),
		|	_НаборЗаписей.ВидДвижения,
		|	_НаборЗаписей.УчетныйАктивЕПС";

#КонецОбласти

	Запрос.УстановитьПараметр("НаборЗаписей" , Источник);
	Запрос.УстановитьПараметр("ДатаПроверкиОферты" , ДатаПроверкиОферты);

	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда 
		Результат = Новый Структура;
		Результат.Вставить("Текст", "");
		Результат.Вставить("Тема", ""); 
		Возврат Результат;
	КонецЕсли;	
	
	ЕстьВыбытие = Ложь;
	ЕстьПриобретение = Ложь;
	
	ТекстОповещенияВыбытиеАктивовАС = "";
	ТекстОповещенияПриобретениеАктивовАС = "";
	
	СтрокаТаблицыОповещения =
	"<tr><td><p align=""left"">%1</p></td>
	|<td><p align=""left"">%2</p></td>
	|<td><p align=""left"">%3</p></td>
	|<td><p align=""right"">%4</p></td>
	|<td><p align=""center"">%5</p></td>
	|<td><p align=""center"">%6</p></td></tr>";
	//Счет. документ, ценная бумага, количество, дата погашения, дата оферты
	
	СтрокаЗаголовокТаблицы = СтрШаблон(СтрокаТаблицыОповещения, "Счет", "Документ", "Ценная бумага", "Количество", "Дата погашения", "Дата оферты");
				
	Пока Выборка.Следующий() Цикл 	
		
		СтрокаЦеннаяБумага = ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Выборка.ЦеннаяБумага);
		СтрокаРегистратор = ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Выборка.Регистратор, Строка(Выборка.Регистратор));
		
		ДатаПогашения = Выборка.ДатаПогашения;
		ДатаОферты =  Выборка.ДатаБлижайшейОферты; 
		
		СтрокаДатаПогашения = Формат(ДатаПогашения, "ДФ=dd.MM.yyyy");	
		СтрокаДатаОферты = Формат(ДатаОФерты, "ДФ=dd.MM.yyyy");
		
		Если Выборка.ВидДвижения = Перечисления.ВидыДвижений.Расход Тогда 
			ТекстОповещенияВыбытиеАктивовАС = ТекстОповещенияВыбытиеАктивовАС + СтрШаблон(СтрокаТаблицыОповещения, Выборка.УчетныйАктивЕПС.СчетУчета, СтрокаРегистратор, СтрокаЦеннаяБумага, Строка(Выборка.Количество), СтрокаДатаПогашения, СтрокаДатаОферты);				
			ЕстьВыбытие = Истина;
		ИначеЕсли Выборка.ВидДвижения = Перечисления.ВидыДвижений.Приход Тогда
			ДатаСледующийГод = ДобавитьМесяц(Выборка.Период, 12);
			
			Если ДатаПогашения <= ДатаСледующийГод ИЛИ (ЗначениеЗаполнено(ДатаОферты) И ДатаОферты <= ДатаСледующийГод) Тогда  
				СтрокаДатаПогашения = "<font color = ""red"">" + СтрокаДатаПогашения + "</font>";	
				СтрокаДатаОферты = "<font color = ""red"">" + СтрокаДатаОферты + "</font>";
			КонецЕсли;	
			
			ТекстОповещенияПриобретениеАктивовАС = ТекстОповещенияПриобретениеАктивовАС + СтрШаблон(СтрокаТаблицыОповещения, Выборка.УчетныйАктивЕПС.СчетУчета, СтрокаРегистратор, СтрокаЦеннаяБумага, Строка(Выборка.Количество), СтрокаДатаПогашения, СтрокаДатаОферты);
			ЕстьПриобретение = Истина;
		КонецЕсли;			
	КонецЦикла;	
	
	Если ЕстьВыбытие Тогда 		
		ТекстОповещенияВыбытиеАктивовАС = СформироватьБлокТекстаОповещенияАктивовОцениваемыхПоАС(ТекстОповещенияВыбытиеАктивовАС, "Выбытие активов, оцениваемых по амортизированной стоимости", СтрокаЗаголовокТаблицы, СчетДоверительногоУправления);
	КонецЕсли;	
	
	Если ЕстьПриобретение Тогда 	
		ТекстОповещенияПриобретениеАктивовАС = СформироватьБлокТекстаОповещенияАктивовОцениваемыхПоАС(ТекстОповещенияПриобретениеАктивовАС, "Приобретение активов, оцениваемых по амортизированной стоимости", СтрокаЗаголовокТаблицы, СчетДоверительногоУправления);	
	КонецЕсли;	
	
	Если ЕстьВыбытие И Не ЕстьПриобретение Тогда 
		СтрокаТема = "Выбытие активов, оцениваемых по амортизированной стоимости";	
	ИначеЕсли НЕ ЕстьВыбытие И ЕстьПриобретение	Тогда 
		СтрокаТема = "Приобретение активов, оцениваемых по амортизированной стоимости";	
	ИначеЕсли ЕстьВыбытие И ЕстьПриобретение Тогда 
		СтрокаТема = "Выбытие и приобретение активов, оцениваемых по амортизированной стоимости";
	Иначе
		СтрокаТема = "";
	КонецЕсли;	
	
	Результат = Новый Структура;
	Результат.Вставить("Текст", ТекстОповещенияВыбытиеАктивовАС + ТекстОповещенияПриобретениеАктивовАС);
	Результат.Вставить("Тема", СтрокаТема); 
	
	Возврат Результат;
	
КонецФункции 	

Функция СформироватьБлокТекстаОповещенияАктивовОцениваемыхПоАС(ИсходныйТекст, СтрокаЗаголовокБлока, СтрокаЗаголовокТаблицы, СчетДоверительногоУправления)
	
	Возврат "<p>Счет доверительного управления: " + ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(СчетДоверительногоУправления) + "</p>" +
			"<p>" + СтрокаЗаголовокБлока + "</p>" +  
			"<table border = 1 cellpadding = 1>" +
			СтрокаЗаголовокТаблицы + 
			ИсходныйТекст + 
			"</table>";
	
КонецФункции	

Функция ПроизводитсяФормированиеУчетаВНастоящийМомент(Организация, СчетДоверительногоУправления, ВидУчета) Экспорт

	ПараметрыФормированияБухгалтерскогоУчета = Обработки.МенеджерОтложенныхЗаданий.ПолучитьПараметрыФормированияБухгалтерскогоУчета();	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОтложенныеЗадания.Идентификатор КАК Идентификатор
		|ИЗ
		|	РегистрСведений.ОтложенныеЗадания КАК ОтложенныеЗадания
		|ГДЕ
		|	ОтложенныеЗадания.Организация = &Организация
		|	И ОтложенныеЗадания.Объект = &ОбъектФормированияБухгалтерскогоУчета
		|	И ОтложенныеЗадания.Команда = &КомандаФормированияБухгалтерскогоУчета
		|	И ОтложенныеЗадания.Состояние В (ЗНАЧЕНИЕ(Перечисление.СостоянияОтложенныхЗаданий.Ожидание), ЗНАЧЕНИЕ(Перечисление.СостоянияОтложенныхЗаданий.Выполняется))
		|	И ОтложенныеЗадания.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОтложенныеЗадания.ВидУчета = &ВидУчета";
	
	Запрос.УстановитьПараметр("ОбъектФормированияБухгалтерскогоУчета",			ПараметрыФормированияБухгалтерскогоУчета.ОбъектФормированияБухгалтерскогоУчета);
	Запрос.УстановитьПараметр("КомандаФормированияБухгалтерскогоУчета",			ПараметрыФормированияБухгалтерскогоУчета.КомандаФормированияБухгалтерскогоУчета);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

Функция ДоступенРасчетРСПДоПартий(ТекущаяДата, Организация, СчетДоверительногоУправления, ЦельРасчета, Отказ)
	
	НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(ТекущаяДата, Организация, СчетДоверительногоУправления, ЦельРасчета, Истина);
	Если Не ЗначениеЗаполнено(НастройкиОценки.ВариантРасчетаОценочнойСтоимости) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определен вариант оценки для цели '" + ЦельРасчета + "' для клиента " + СчетДоверительногоУправления,,,, Отказ);
		Возврат Ложь;
	КонецЕсли;
	
	ВыполнятьРасчетПоУказаниюЦБ			  = (НастройкиОценки.ВыполнятьРасчетПоУказаниюЦБ5419) ИЛИ НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316;
	ВестиРасчетПоПартиям				  = НастройкиОценки.ВестиРасчетПоПартиям ИЛИ ВыполнятьРасчетПоУказаниюЦБ;
	
	МожноСчитатьРСПДоРасчетаПартий = Ложь;
	Если Не ВыполнятьРасчетПоУказаниюЦБ Тогда
		МожноСчитатьРСПДоРасчетаПартий = Не (ЦельРасчета.ТолькоДляФиксацииСтоимостиОценки И ВестиРасчетПоПартиям);
	КонецЕсли;	
	
	Возврат МожноСчитатьРСПДоРасчетаПартий;

КонецФункции	

Процедура СформироватьРасчетРСП(ТекущаяДатаФормирования, Организация, СчетДоверительногоУправления, ПараметрыОценки, Пользователь, ФЗУИД, ТаблицаЦБ = Неопределено, Отказ)
	
	ТекущаяДатаФормированияСтр = Формат(ТекущаяДатаФормирования, "ДФ=dd.MM.yyyy");
	
	НастройкиЦелиРасчета = БухгалтерскийУчет.ОпределитьНастройкиЦелиРасчета(ТекущаяДатаФормирования, Организация, СчетДоверительногоУправления, ПараметрыОценки.ЦельРасчета);
	ПараметрыОценки.Вставить("ВариантРасчетаОценочнойСтоимости" ,НастройкиЦелиРасчета.ВариантРасчетаОценочнойСтоимости);
	
	РассчитатьСтоимостиПереоценки(Организация, СчетДоверительногоУправления, ПараметрыОценки, ТекущаяДатаФормирования, Пользователь, ФЗУИД, ТаблицаЦБ, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ВывестиПользователюСообщениеВремениВыполнения(ТекущаяДатаФормированияСтр, "Расcчитали стоимость бумаг");
	
	Если ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом Тогда
		
		ЗаполнитьПоручениеНаПереоценку(Организация, СчетДоверительногоУправления, ПараметрыОценки, ТекущаяДатаФормирования, Пользователь, ФЗУИД, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		ВывестиПользователюСообщениеВремениВыполнения(ТекущаяДатаФормированияСтр, "Заполнили поручение на переоценку");
		
	КонецЕсли;	
	
КонецПроцедуры	

Функция ВыполнитьРасчетРСП(ТекущаяДатаФормирования, Организация, СчетДоверительногоУправления, ВидУчета, ПараметрыОценки, Пользователь, ФЗУИД, ПредварительныйРасчет = Ложь, Отказ)
	
	Если ВидУчета <> Перечисления.ВидыУчета.НалоговыйУчет Тогда
		
		Если ПредварительныйРасчет Тогда
			
			МожноСчитатьРСПДоРасчетаПартий = ДоступенРасчетРСПДоПартий(ТекущаяДатаФормирования, Организация, СчетДоверительногоУправления, ПараметрыОценки.ЦельРасчета, Отказ);
			
			Если Отказ Тогда
				Возврат Ложь;
			КонецЕсли;
			
			Если МожноСчитатьРСПДоРасчетаПартий Тогда
				// Проверяем может ли быть несколько цен по одной ЦБ за день.
				// Известные случаи - ввод и вывод ценных бумаг и сделки в т.ч РЕПО в тот же день.
				// Сделки в режиме аукциона, и первичное размещение.
				
				Запрос = Новый Запрос;
				Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	УсловияСделок.Регистратор КАК Регистратор
				|ПОМЕСТИТЬ _ДокументыВРазмещенияИВводаВывода
				|ИЗ
				|	РегистрСведений.УсловияСделок КАК УсловияСделок
				|ГДЕ
				|	УсловияСделок.Активность
				|	И УсловияСделок.Период МЕЖДУ &ТекущаяНачальнаяДата И &ТекущаяКонечнаяДата
				|	И УсловияСделок.Организация = &Организация
				|	И УсловияСделок.СчетДоверительногоУправления = &СчетДоверительногоУправления
				|	И (УсловияСделок.Сделка.РежимБиржевыхТоргов.Аукцион
				|			ИЛИ УсловияСделок.Сделка.РежимБиржевыхТоргов.ПервичноеРазмещение)
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	ВводыВыводыАктивовВВалютеУчета.Регистратор
				|ИЗ
				|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
				|ГДЕ
				|	ВводыВыводыАктивовВВалютеУчета.Активность
				|	И ВводыВыводыАктивовВВалютеУчета.Организация = &Организация
				|	И ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления = &СчетДоверительногоУправления
				|	И ВводыВыводыАктивовВВалютеУчета.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ЦенныеБумаги)
				|	И ВводыВыводыАктивовВВалютеУчета.Период МЕЖДУ &ТекущаяНачальнаяДата И &ТекущаяКонечнаяДата
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
				|	ОстаткиЦенныхБумагОстатки.Рынок КАК Рынок,
				|	ОстаткиЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
				|	ОстаткиЦенныхБумагОстатки.Организация КАК Организация,
				|	ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	НЕОПРЕДЕЛЕНО КАК Партия,
				|	1 КАК СтрокаПартии,
				|	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеДляПродажиПрочихРезидентов) КАК УчетныйАктивЕПС,
				|	0 КАК СуммаРезервовПодОбесценение
				|ПОМЕСТИТЬ _ОстаткиЦенныхБумаг
				|ИЗ
				|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
				|			&ТекущаяКонечнаяДата,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиЦенныхБумагОстатки
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага,
				|	ЗадолженностиПоЦеннымБумагамОстатки.Рынок,
				|	ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток,
				|	ЗадолженностиПоЦеннымБумагамОстатки.Организация,
				|	ЗадолженностиПоЦеннымБумагамОстатки.СчетДоверительногоУправления,
				|	НЕОПРЕДЕЛЕНО,
				|	1,
				|	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеДляПродажиПрочихРезидентов),
				|	0
				|ИЗ
				|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
				|			&ТекущаяКонечнаяДата,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЗадолженностиПоЦеннымБумагамОстатки
				|ГДЕ
				|	НЕ(ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
				|				И ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская))";
				
				Запрос.УстановитьПараметр("Организация", Организация);
				Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
				Запрос.УстановитьПараметр("ТекущаяКонечнаяДата", КонецДня(ТекущаяДатаФормирования));
				Запрос.УстановитьПараметр("ТекущаяНачальнаяДата", НачалоДня(ТекущаяДатаФормирования));
				
				РезультатЗапроса = Запрос.Выполнить();
				
				Если Запрос.МенеджерВременныхТаблиц.Таблицы["_ДокументыВРазмещенияИВводаВывода"].ПолучитьДанные().Пустой() Тогда
					ТаблицаЦБ	= Запрос.МенеджерВременныхТаблиц.Таблицы["_ОстаткиЦенныхБумаг"].ПолучитьДанные().Выгрузить();
					
					РаботаСКоллекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(ТаблицаЦБ, "Партия", Метаданные.ОпределяемыеТипы.Партия.Тип);

					//заполним стоимости переоценок ЕПС
					
					СформироватьРасчетРСП(ТекущаяДатаФормирования, Организация, СчетДоверительногоУправления, ПараметрыОценки, Пользователь, ФЗУИД, ТаблицаЦБ, Отказ);
					
					Если Отказ Тогда
						Возврат Ложь;
					КонецЕсли;
					
					Возврат Истина;
					
				Иначе	
					
					Возврат Ложь;
					
				КонецЕсли;
			Иначе	
				
				Возврат Ложь;
				
			КонецЕсли;	
			
		Иначе
			
			СформироватьРасчетРСП(ТекущаяДатаФормирования, Организация, СчетДоверительногоУправления, ПараметрыОценки, Пользователь, ФЗУИД, , Отказ);
			
			Возврат Истина;
			
		КонецЕсли;
		
	Иначе
		
		ПараметрыОценки.Вставить("ВариантРасчетаОценочнойСтоимости", Справочники.ВариантыРасчетаОценочнойСтоимости.ПустаяСсылка());
		
		Возврат Истина;
		
	КонецЕсли;
	
КонецФункции	
