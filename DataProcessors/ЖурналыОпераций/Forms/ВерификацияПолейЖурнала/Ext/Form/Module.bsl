
&НаСервере
Процедура ВывестиСтрокуОтчетаНаСервере(СтрокаОтчета, Документ, ТекущиеЗнчПолей = Неопределено, ТребуемоеЗнчПолей = Неопределено, КлючПоля, ПрочиеПоля)
	
	КолКлючПолей   = КлючПоля.Количество();
	КолПрочихПолей = ПрочиеПоля.Количество();
	
	ВысотаСводнойОбласти = Макс(КолКлючПолей, КолПрочихПолей);
	
	Для Инд = 0 По ВысотаСводнойОбласти - 1 Цикл
		Если Инд = 0 Тогда
			СтрокаОтчета.Параметры.Документ = Документ;
		Иначе
			СтрокаОтчета.Параметры.Документ = Неопределено;
		КонецЕсли;
		
		Если Инд < КолКлючПолей Тогда
			ИмяПоля = КлючПоля[Инд];
			СтрокаОтчета.Параметры.ИмяКлючПоля         = ИмяПоля;
			СтрокаОтчета.Параметры.ЗнчКлючПоляВЖурнале = ?(ТекущиеЗнчПолей = Неопределено, Неопределено, ТекущиеЗнчПолей[ИмяПоля]);
			СтрокаОтчета.Параметры.ЗнчКлючПоля         = ?(ТребуемоеЗнчПолей = Неопределено, Неопределено, ТребуемоеЗнчПолей[ИмяПоля]);
		Иначе
			СтрокаОтчета.Параметры.ИмяКлючПоля         = Неопределено;
			СтрокаОтчета.Параметры.ЗнчКлючПоляВЖурнале = Неопределено;
			СтрокаОтчета.Параметры.ЗнчКлючПоля         = Неопределено;
		КонецЕсли;
		
		Если Инд < КолПрочихПолей Тогда
			ИмяПоля = ПрочиеПоля[Инд];
			СтрокаОтчета.Параметры.ИмяПрочегоПоля         = ИмяПоля;
			СтрокаОтчета.Параметры.ЗнчПрочегоПоляВЖурнале = ?(ТекущиеЗнчПолей = Неопределено, Неопределено, ТекущиеЗнчПолей[ИмяПоля]);
			СтрокаОтчета.Параметры.ЗнчПрочегоПоля         = ?(ТребуемоеЗнчПолей = Неопределено, Неопределено, ТребуемоеЗнчПолей[ИмяПоля]);
		Иначе
			СтрокаОтчета.Параметры.ИмяПрочегоПоля         = Неопределено;
			СтрокаОтчета.Параметры.ЗнчПрочегоПоляВЖурнале = Неопределено;
			СтрокаОтчета.Параметры.ЗнчПрочегоПоля         = Неопределено;
		КонецЕсли;
		
		ЭтаФорма.Отчет.Вывести(СтрокаОтчета);
		
		Если Инд < КолКлючПолей И СтрокаОтчета.Параметры.ЗнчКлючПоляВЖурнале <> СтрокаОтчета.Параметры.ЗнчКлючПоля Тогда
			ЭтаФорма.Отчет.Область(ЭтаФорма.Отчет.ВысотаТаблицы, 2, ЭтаФорма.Отчет.ВысотаТаблицы, 5).ЦветТекста = WebЦвета.Красный;
		КонецЕсли;
		
		Если Инд < КолПрочихПолей И СтрокаОтчета.Параметры.ЗнчПрочегоПоляВЖурнале <> СтрокаОтчета.Параметры.ЗнчПрочегоПоля Тогда
			ЭтаФорма.Отчет.Область(ЭтаФорма.Отчет.ВысотаТаблицы, 6, ЭтаФорма.Отчет.ВысотаТаблицы, 8).ЦветТекста = WebЦвета.Красный;
		КонецЕсли;
		
	КонецЦикла;
	
	ЭтаФорма.Отчет.Область(ЭтаФорма.Отчет.ВысотаТаблицы, 2, ЭтаФорма.Отчет.ВысотаТаблицы - ВысотаСводнойОбласти + 1, 2).Объединить();
	
	Если КолКлючПолей > КолПрочихПолей Тогда
		ЭтаФорма.Отчет.Область(ЭтаФорма.Отчет.ВысотаТаблицы, 6, ЭтаФорма.Отчет.ВысотаТаблицы - (КолКлючПолей - КолПрочихПолей), 6).Объединить();
		ЭтаФорма.Отчет.Область(ЭтаФорма.Отчет.ВысотаТаблицы, 7, ЭтаФорма.Отчет.ВысотаТаблицы - (КолКлючПолей - КолПрочихПолей), 7).Объединить();
		ЭтаФорма.Отчет.Область(ЭтаФорма.Отчет.ВысотаТаблицы, 8, ЭтаФорма.Отчет.ВысотаТаблицы - (КолКлючПолей - КолПрочихПолей), 8).Объединить();
	КонецЕсли;
	
КонецПроцедуры // ВывестиСтрокуОтчетаНаСервере

&НаСервере
Процедура ВерифицироватьЗаполнениеЖурналаОперацийНаСервере()
	
	ЭтаФорма.Отчет.Очистить();
	
	// получим макет для отображения расхождений
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ОтчетОВерификации");
	
	СтрокаОтчета = Макет.ПолучитьОбласть("Строка");
	
	// отобразим шапку
	ШапкаОтчета = Макет.ПолучитьОбласть("Шапка");
	ШапкаОтчета.Параметры.Сформирован  = ТекущаяДата();
	ШапкаОтчета.Параметры.Пользователь = РаботаСПользователями.ТекущийПользователь();
	ШапкаОтчета.Параметры.ВидОперации  = ?(ЭтаФорма.ОтборПоВидуОперации, ЭтаФорма.ВидОперацииБэкОфиса, "Все");
	ШапкаОтчета.Параметры.Период       = ?(ЭтаФорма.ОтборПоПериоду, ЭтаФорма.Период, "Без ограничений");
	
	ЭтаФорма.Отчет.Вывести(ШапкаОтчета);
	
	// получим список полей журнала
	КлючПоляЖурнала = Новый Массив;
	
	Для каждого ИзмерениеМД Из Метаданные.РегистрыСведений.ЖурналОперацийБэкОфиса.Измерения Цикл
		КлючПоляЖурнала.Добавить(ИзмерениеМД.Имя);
	КонецЦикла;
	
	ПрочиеПоляЖурнала = Новый Массив;
	
	Для каждого РесурсМД Из Метаданные.РегистрыСведений.ЖурналОперацийБэкОфиса.Ресурсы Цикл
		ПрочиеПоляЖурнала.Добавить(РесурсМД.Имя);
	КонецЦикла;
	
	Для каждого РеквизитМД Из Метаданные.РегистрыСведений.ЖурналОперацийБэкОфиса.Реквизиты Цикл
		ПрочиеПоляЖурнала.Добавить(РеквизитМД.Имя);
	КонецЦикла;
	
	// ПОЕХАЛИ!!!
	Сообщить("Время нач. выполнения: " + ТекущаяДата());
	
	Обработано = 0;
	
	// получим все записи в журнале
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИСТИНА КАК БитаяСсылка,
		|	ЖурналОперацийБэкОфиса.*
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса";
		
	Если ЭтаФорма.ОтборПоВидуОперации Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС + 
			"ГДЕ
			|	(ЖурналОперацийБэкОфиса.ВидОперации = &ВидОперации
			|		ИЛИ ЖурналОперацийБэкОфиса.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.ПустаяСсылка))";
			
		Запрос.УстановитьПараметр("ВидОперации", ЭтаФорма.ВидОперацииБэкОфиса);
	КонецЕсли;
	
	Если ЭтаФорма.ОтборПоПериоду Тогда
		Если ЭтаФорма.ОтборПоВидуОперации Тогда
			Запрос.Текст = Запрос.Текст + Символы.ПС +
				"	И (ЖурналОперацийБэкОфиса.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)"
		Иначе		
			Запрос.Текст = Запрос.Текст + Символы.ПС +
				"ГДЕ
				|	(ЖурналОперацийБэкОфиса.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)"
		КонецЕсли;
			
		Запрос.УстановитьПараметр("ДатаНачала",    ЭтаФорма.Период.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания", ЭтаФорма.Период.ДатаОкончания);
	КонецЕсли;
	
	ОперацииЖурнала = Запрос.Выполнить().Выгрузить();
	
	// проверим соотв. значения полей документов записям в журнале
	Для каждого ДокументМД Из Метаданные.Документы Цикл
		Если Не РаботаСЖурналамиОпераций.ОперацияВключенаВЖурнал(ДокументМД.Имя) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтаФорма.ОтборПоВидуОперации И ДокументМД.Имя <> РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтаФорма.ВидОперацииБэкОфиса) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтаФорма.ОтборПоПериоду Тогда
			Выборка = Документы[ДокументМД.Имя].Выбрать(ЭтаФорма.Период.ДатаНачала, ЭтаФорма.Период.ДатаОкончания);
		Иначе
			Выборка = Документы[ДокументМД.Имя].Выбрать();
		КонецЕсли;
		
		Пока Выборка.Следующий() Цикл
			ЗнчПолейЖурнала = РаботаСЖурналамиОпераций.ПолучитьЗначенияПолейЖурналаИзДокумента(Выборка.Ссылка);
			
			ЗнчКлючПолейЖурнала = Новый Структура;
			
			Для каждого КлючПолеЖурнала Из КлючПоляЖурнала Цикл
				ЗнчКлючПолейЖурнала.Вставить(КлючПолеЖурнала, ЗнчПолейЖурнала[КлючПолеЖурнала]);
			КонецЦикла;
			
			СтрокиЖурналаОпераций = ОперацииЖурнала.НайтиСтроки(ЗнчКлючПолейЖурнала);
			
			Если СтрокиЖурналаОпераций.Количество() = 0 Тогда // нужно создать запись
				Если ЭтаФорма.Режим = 1 Тогда
					МенеджерЗаписи = РегистрыСведений.ЖурналОперацийБэкОфиса.СоздатьМенеджерЗаписи();
										
					//Если ДокументМД.Имя = "КорректировкаРегистров" Тогда
					//	ЗнчПолейЖурнала.СчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.НайтиПоРеквизиту("КодСчета", "СОБ00");
					//КонецЕсли;
					
					ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ЗнчПолейЖурнала);
					
					МенеджерЗаписи.Записать();
				КонецЕсли;
				
				ВывестиСтрокуОтчетаНаСервере(СтрокаОтчета, Выборка.Ссылка,, ЗнчПолейЖурнала, КлючПоляЖурнала, ПрочиеПоляЖурнала);
				
				Обработано = Обработано + 1;
				
			ИначеЕсли СтрокиЖурналаОпераций.Количество() = 1 Тогда // нужно проверить соотв. полей
				СтрокаЖурналаОпераций = СтрокиЖурналаОпераций[0];
				
				Если Не СтрокаЖурналаОпераций.БитаяСсылка Тогда // строка уже была обработана (актуально для сводных сделок)
					Продолжить;
				Иначе
					СтрокаЖурналаОпераций.БитаяСсылка = Ложь;
				КонецЕсли;
				
				ЕстьРасхождение = Ложь;
				
				Для каждого КлючЗнч Из ЗнчПолейЖурнала Цикл
					Если СтрокаЖурналаОпераций[КлючЗнч.Ключ] <> КлючЗнч.Значение Тогда
						ЕстьРасхождение = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если ЕстьРасхождение Тогда
					Если ЭтаФорма.Режим = 1 Тогда
						НаборЗаписей = РегистрыСведений.ЖурналОперацийБэкОфиса.СоздатьНаборЗаписей();
						
						Для каждого КлючПолеЖурнала Из КлючПоляЖурнала Цикл
							НаборЗаписей.Отбор[КлючПолеЖурнала].Установить(ЗнчПолейЖурнала[КлючПолеЖурнала]);
						КонецЦикла;
						
						НаборЗаписей.Прочитать();
						
						ЗаполнитьЗначенияСвойств(НаборЗаписей[0], ЗнчПолейЖурнала);
						
						НаборЗаписей.Записать();
					КонецЕсли;
					
					ВывестиСтрокуОтчетаНаСервере(СтрокаОтчета, Выборка.Ссылка, СтрокаЖурналаОпераций, ЗнчПолейЖурнала, КлючПоляЖурнала, ПрочиеПоляЖурнала);
					
					Обработано = Обработано + 1;
					
				КонецЕсли;				
				
			Иначе // фигня какая-то
				ВызватьИсключение "Найдено более одной записи в журнале, соотв. документу " + Выборка.Ссылка;
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// найдем и удалим битые ссылки
	Удалено = 0;
	
	СтрокиБитыеСсылки = ОперацииЖурнала.НайтиСтроки(Новый Структура("БитаяСсылка", Истина));
	
	Для каждого СтрокаБитыеСсылки Из СтрокиБитыеСсылки Цикл
		Если Режим = 1 Тогда
			НаборЗаписей = РегистрыСведений.ЖурналОперацийБэкОфиса.СоздатьНаборЗаписей();
						
			Для каждого КлючПолеЖурнала Из КлючПоляЖурнала Цикл
				НаборЗаписей.Отбор[КлючПолеЖурнала].Установить(СтрокаБитыеСсылки[КлючПолеЖурнала]);
			КонецЦикла;
			
			НаборЗаписей.Записать();
		КонецЕсли;
		
		ВывестиСтрокуОтчетаНаСервере(СтрокаОтчета, СтрокаБитыеСсылки.Документ, СтрокаБитыеСсылки,, КлючПоляЖурнала, ПрочиеПоляЖурнала);
		
		Обработано = Обработано + 1;
		Удалено    = Удалено + 1;
		
	КонецЦикла;
	
	Сообщить("Выполнение обработки завершено. Расхождений: " + Обработано + " из " + ОперацииЖурнала.Количество() + ". Из них битых ссылок: " + Удалено);
	Сообщить("Время кон. выполнения: " + ТекущаяДата());
	
КонецПроцедуры // ВерифицироватьЗаполнениеЖурналаОперацийНаСервере

&НаКлиенте
Процедура НастроитьВидимостьДоступность()
	
	Элементы.Период.Видимость = ЭтаФорма.ОтборПоПериоду;
	
	Элементы.ВидОперацииБэкОфиса.Видимость = ЭтаФорма.ОтборПоВидуОперации;
	
КонецПроцедуры // НастроитьВидимостьДоступность

////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастроитьВидимостьДоступность();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтаФорма.ОтборПоВидуОперации Тогда
		ПроверяемыеРеквизиты.Добавить("ВидОперацииБэкОфиса");
	КонецЕсли;
	
	Если ЭтаФорма.ОтборПоПериоду Тогда
		ПроверяемыеРеквизиты.Добавить("Период");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоВидуОперации(Элемент)

	Если Не ЭтаФорма.ОтборПоВидуОперации Тогда
		ЭтаФорма.ВидОперацииБэкОфиса    = Неопределено;
	КонецЕсли;
	
	Элементы.ВидОперацииБэкОфиса.Видимость = ЭтаФорма.ОтборПоВидуОперации;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоПериодуПриИзменении(Элемент)
	
	Если Не ЭтаФорма.ОтборПоПериоду Тогда
		ЭтаФорма.Период = Неопределено;
	КонецЕсли;
	
	Элементы.Период.Видимость = ЭтаФорма.ОтборПоПериоду;
	
КонецПроцедуры

&НаКлиенте
Процедура ЖурналОперацийПриИзменении(Элемент)
	
	НастроитьВидимостьДоступность();

КонецПроцедуры

&НаКлиенте
Процедура КомандаВыполнить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаВыполнить");
	Попытка
		ВыполнитьВыполнить(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВыполнить(ПараметрыСессии)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		ПараметрыСессии.ТекстОшибки = "Заполнение формы некорректно";
		Возврат;
	КонецЕсли;
	
	ВерифицироватьЗаполнениеЖурналаОперацийНаСервере();
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
