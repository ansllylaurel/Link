Функция СформироватьОтчетОРасхождениях(РезультатПроверки) Экспорт
	Макет = ПолучитьМакет("Расхождения");
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Вывести(Макет.ПолучитьОбласть("Шапка"));
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	Для Каждого Результат Из РезультатПроверки Цикл
		ОписаниеРезультата = Результат.Значение;
		Если ТипЗнч(ОписаниеРезультата) = Тип("Структура") И ОписаниеРезультата.Свойство("Данные") Тогда 
			РекурсивноВывестиСтрокиРасхождений(ТабДок, ОбластьСтрока, Результат.Ключ, ОписаниеРезультата.Данные);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТабДок;
КонецФункции

Процедура РекурсивноВывестиСтрокиРасхождений(ТабДок, Область, ГруппаНумерации, Данные, Строки = Неопределено)
	Если Строки = Неопределено Тогда
		Строки = Данные.Строки;
	КонецЕсли;
	
	Для каждого Строка Из Строки Цикл
		Если Не ЗначениеЗаполнено(Строка.Документ) Тогда
			РекурсивноВывестиСтрокиРасхождений(ТабДок, Область, ГруппаНумерации, Данные, Строка.Строки);
		Иначе
			Если Строка.ТребуетсяПеренумерация Тогда
				Область.Параметры.ГруппаНумерации = ГруппаНумерации;
				Область.Параметры.Документ        = Строка.Документ;
				Область.Параметры.ТекущийНомер    = Строка.ТекущийНомер;
				Область.Параметры.НовыйНомер      = Строка.НовыйНомер;
				Область.Параметры.Дата            = Строка.Дата;
			
				ТабДок.Вывести(Область);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры