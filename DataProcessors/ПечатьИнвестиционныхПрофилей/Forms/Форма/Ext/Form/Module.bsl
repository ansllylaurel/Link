		|		ИНАЧЕ _ИтоговаяТаблица.СоотношениеЧистыхАктивовКОбъемуПередаваемыхСредств
		|	КОНЕЦ КАК СоотношениеЧистыхАктивовКОбъемуПередаваемыхСредств,
		|	ВЫБОР
		|		КОГДА _ИтоговаяТаблица.ФизическоеЛицо
		|			ТОГДА "" ""
		|		КОГДА _ИтоговаяТаблица.КвалифицированныйИнвестор
		|			ТОГДА ""не заполняется""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА _ИтоговаяТаблица.НаличиеСпециалистовИлиПодразделенияИД
		|					ТОГДА ""Есть""
		|				ИНАЧЕ ""Нет""
		|			КОНЕЦ
		|	КОНЕЦ КАК НаличиеСпециалистовИлиПодразделенияИД,
		|	ВЫБОР
		|		КОГДА _ИтоговаяТаблица.ФизическоеЛицо
		|			ТОГДА "" ""
		|		КОГДА _ИтоговаяТаблица.КвалифицированныйИнвестор
		|			ТОГДА ""не заполняется""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА _ИтоговаяТаблица.НаличиеОперацийСФИЗаПоследнийОтчетныйГод
		|					ТОГДА ""Есть""
		|				ИНАЧЕ ""Нет""
		|			КОНЕЦ
		|	КОНЕЦ КАК НаличиеОперацийСФИЗаПоследнийОтчетныйГод
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
		|				&Период,
		|				ЮрФизЛицо = &Подписант
		|					И Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыСотрудниковОрганизации
		|		ПО (ИСТИНА)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ Выборка.Проведен Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ " + Выборка.Документ + " не проведен!");
		Иначе
			НоваяСтрока = Новый Структура;
		
			НоваяСтрока.Вставить("Наименование",										Выборка.Наименование);
			НоваяСтрока.Вставить("ИНН",													Выборка.ИНН);
			НоваяСтрока.Вставить("КвалИнвестор",										Выборка.КвалифицированныйИнвестор);
			НоваяСтрока.Вставить("НеквалИнвестор",										Выборка.НеквалифицированныйИнвестор);
			НоваяСтрока.Вставить("ЮрЛицо",												Выборка.ЮридическоеЛицо);
			НоваяСтрока.Вставить("ФизЛицо",												Выборка.ФизическоеЛицо);
			НоваяСтрока.Вставить("Сумма",												Выборка.СуммаПередаваемыхВДУСредств);
			НоваяСтрока.Вставить("ДатаЗаключенияДДУ",									Формат(Выборка.ДатаЗаключенияДДУ, "ДФ=dd.MM.yyyy"));
			НоваяСтрока.Вставить("ДатаЗавершенияДДУ",									Формат(Выборка.ДатаЗавершенияДДУ, "ДФ=dd.MM.yyyy"));
			НоваяСтрока.Вставить("ИнвестиционнаяЦель",									Выборка.ИнвестиционнаяЦель);
			НоваяСтрока.Вставить("Возраст",												Выборка.Возраст);
			НоваяСтрока.Вставить("НаличиеОпыта",										Выборка.НаличиеОпыта);
			НоваяСтрока.Вставить("УсловныйДоход",										Выборка.УсловныйДоход);
			НоваяСтрока.Вставить("УсловныйРасход",										Выборка.УсловныйРасход);
			НоваяСтрока.Вставить("УсловныеНакопления",									Выборка.УсловныеНакопления);
			НоваяСтрока.Вставить("ПриемлемыйУровеньРиска",								Строка(Выборка.ПриемлемыйУровеньРиска) + ?(Выборка.ПриемлемыйУровеньРиска = "не заполняется" ИЛИ Выборка.ПриемлемыйУровеньРиска = " " , "", " %"));
			НоваяСтрока.Вставить("ДатаНачалаГоризонта",									Формат(Выборка.ДатаНачалаГоризонта, "ДФ=dd.MM.yyyy"));
			НоваяСтрока.Вставить("ДатаЗавершенияГоризонта",								Формат(Выборка.ДатаЗавершенияГоризонта, "ДФ=dd.MM.yyyy"));
			НоваяСтрока.Вставить("ДопустимыйРиск",										Выборка.ДопустимыйРиск);
			НоваяСтрока.Вставить("ОжидаемаяДоходность",									Выборка.ОжидаемаяДоходность);
			НоваяСтрока.Вставить("Подписант",											Выборка.Подписант);
			НоваяСтрока.Вставить("ДатаДокумента",										Формат(Выборка.ДатаДокумента, "ДФ=dd.MM.yyyy"));
			НоваяСтрока.Вставить("ПредельныйДопустимыйРискЗаВесьСрокИнвестирования",	Выборка.ПредельныйДопустимыйРискЗаВесьСрокИнвестирования);
			НоваяСтрока.Вставить("РазмерЦелевыхСредств",								Выборка.РазмерЦелевыхСредств);
			НоваяСтрока.Вставить("СоотношениеЧистыхАктивовКОбъемуПередаваемыхСредств",	Выборка.СоотношениеЧистыхАктивовКОбъемуПередаваемыхСредств);
			НоваяСтрока.Вставить("НаличиеСпециалистовИлиПодразделенияИД",				Выборка.НаличиеСпециалистовИлиПодразделенияИД);
			НоваяСтрока.Вставить("НаличиеОперацийСФИЗаПоследнийОтчетныйГод",			Выборка.НаличиеОперацийСФИЗаПоследнийОтчетныйГод);
			
			Результат.Добавить(НоваяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьМакетИнвестиционногоПрофиля()
	
	ОбработкаНаСервере = РеквизитФормыВЗначение("Объект");
	
	Макет = ОбработкаНаСервере.ПолучитьМакет("ИнвестиционныйПрофиль");
	
	Возврат Макет;

КонецФункции

&НаСервере
Функция ПолучитьСтруктуруДляПечати()
	
	Результат = Новый Структура;
	
	Результат.Вставить("ДанныеДляПечати",	ПолучитьДанныеДляПечати());
	Результат.Вставить("Шаблон", 			ПолучитьМакетИнвестиционногоПрофиля());
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураДляПечати = ПолучитьСтруктуруДляПечати();
	
	Если СтруктураДляПечати.ДанныеДляПечати.Количество() > 0 Тогда
		
		// создадим документ MS Word на основании сохраненного шаблона
		WordApp = СоздатьОбъектWord(Истина);
		
		Для Каждого ТекДокумент Из СтруктураДляПечати.ДанныеДляПечати Цикл
			НапечататьДокумент(WordApp, СтруктураДляПечати.Шаблон, ТекДокумент);	
		КонецЦикла;
		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет данных для печати!");
	КонецЕсли;
	
	Если ВладелецФормы <> Неопределено Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокКонтактныхЛиц()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КонтактныеЛица.КонтактноеЛицо
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|		ПО Организации.ЮрФизЛицо = КонтактныеЛица.Объект
		|			И (КонтактныеЛица.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|ГДЕ
		|	Организации.Ссылка = &Организация
		|	И КонтактныеЛица.КонтактноеЛицо ССЫЛКА Справочник.ЮрФизЛица";
		
	Запрос.УстановитьПараметр("Организация", Организация);
	СписокКонтактныхЛиц.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КонтактноеЛицо"));
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	РезультатВыбора = СписокКонтактныхЛиц.ВыбратьЭлемент();
	
	Если РезультатВыбора <> Неопределено Тогда
		Подписант = РезультатВыбора.Значение;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОрганизацию()
	
	Если ЗначениеЗаполнено(Документ) Тогда
		Организация = Документ.Организация;
	Иначе
		Организация = Неопределено;
	КонецЕсли;
	
	ЗаполнитьСписокКонтактныхЛиц();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументПриИзменении(Элемент)
	
	УстановитьОрганизацию();
	
КонецПроцедуры
