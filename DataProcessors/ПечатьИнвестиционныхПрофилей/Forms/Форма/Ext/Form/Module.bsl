
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Документ", Документ);
	
	УстановитьОрганизацию();
	
	Если ЗначениеЗаполнено(Документ) Тогда
		Элементы.Документ.Видимость = Ложь;	
	КонецЕсли;
	
	ЗаполнитьСписокКонтактныхЛиц();
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПризнакиДокумента(ДокументWord, СтруктураПризнаков)
	
	Для Каждого КлючИЗнач из СтруктураПризнаков Цикл
		Попытка
			Field = ДокументWord.FormFields.Item(КлючИЗнач.Ключ);
			Field.CheckBox.Value = КлючИЗнач.Значение;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
Конецпроцедуры

&НаКлиенте
Процедура НапечататьДокумент(WordApp, ДвоичныеДанныеШаблона, ДанныеДляПечати)
	
	Попытка
		
		ПутьКФайлуШаблона = СохранитьШаблонНаДиск(ДвоичныеДанныеШаблона);
		
		NewDoc = ДобавитьДокументWord(WordApp, ПутьКФайлуШаблона);
		ЗаполнитьПараметрыWord(NewDoc, ДанныеДляПечати);
		ЗаполнитьПризнакиДокумента(NewDoc, ДанныеДляПечати);
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
	
	УдалитьФайлШаблона(ПутьКФайлуШаблона);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// РАБОТА с WORD

&НаКлиенте
Функция СоздатьОбъектWord(Visible = False)
	
	WordApp = Новый COMОбъект("Word.Application");
	WordApp.Application.Visible = Visible;

	Возврат WordApp;
	
КонецФункции

&НаКлиенте
Функция ДобавитьДокументWord(WordApp, ПутьКФайлу)
	
	Возврат WordApp.Application.Documents.Add(ПутьКФайлу, WordApp.Application.Visible);	
	
КонецФункции

&НаКлиенте
Функция СохранитьШаблонНаДиск(ДвоичныеДанные)
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("docx");
	ДвоичныеДанные.Записать(ВременныйФайл);
	
	Возврат ВременныйФайл;

КонецФункции

&НаКлиенте
Процедура УдалитьФайлШаблона(ПутьКФайлу)
	
	// удалим файл шаблона
	Попытка
		УдалитьФайлы(ПутьКФайлу);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыWord(ДокументWord, СтруктураРеквизитов)
	
	WordVars = ДокументWord.Variables;
	Для Каждого КлючИЗнач из СтруктураРеквизитов Цикл
		Если КлючИЗнач.Ключ = "Таблицы" Тогда
			Для каждого КлючИзначТаб из КлючИЗнач.Значение Цикл
				ЗаполнитьТаблицуWord(ДокументWord.Tables(КлючИзначТаб.Ключ), КлючИзначТаб.Значение)	
			КонецЦикла;
		Иначе
			Переменная = WordVars.Item(КлючИЗнач.Ключ);
			Попытка
				Переменная.Value = КлючИЗнач.Значение;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	ДокументWord.Fields.Update();
	
	Для каждого Секция из ДокументWord.Sections Цикл
	
		Для каждого ВерхнийКолонтитул из Секция.Headers Цикл
			Если ВерхнийКолонтитул.Range.Fields.Count Тогда
				ВерхнийКолонтитул.Range.Fields.Update();
			КонецЕсли;
		КонецЦикла;
		
		Для каждого НижнийКолонтитул из Секция.Footers Цикл
			Если НижнийКолонтитул.Range.Fields.Count Тогда
				НижнийКолонтитул.Range.Fields.Update();	
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуWord(ТаблицаWord, МассивСтруктур)
	
	КоличествоСтрок = ТаблицаWord.Rows.Count;
	Для каждого Структура из МассивСтруктур Цикл
		
		Если КоличествоСтрок < Структура.Строка Тогда
			Для Сч = 1 По Структура.Строка - КоличествоСтрок Цикл
				ТаблицаWord.Rows.Add();	
			КонецЦикла;
			КоличествоСтрок = Структура.Строка;
		КонецЕсли;
		
		Ячейка = ТаблицаWord.Cell(Структура.Строка, Структура.Колонка);
		Попытка
			Ячейка.Range.InsertAfter(Структура.Значение);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеДляПечати()
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период",		 Документ.Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Документ",	 Документ);
	Запрос.УстановитьПараметр("Подписант",	 Подписант);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РегистрацияИнвестиционногоПрофиля.Ссылка КАК Документ,
		|	РегистрацияИнвестиционногоПрофиля.Дата КАК Дата,
		|	РегистрацияИнвестиционногоПрофиля.Проведен КАК Проведен,
		|	РегистрацияИнвестиционногоПрофиля.Организация КАК Организация,
		|	РегистрацияИнвестиционногоПрофиля.СубъектУчета КАК СубъектУчета,
		|	РегистрацияИнвестиционногоПрофиля.СуммаПередаваемыхВДУСредств КАК СуммаПередаваемыхВДУСредств,
		|	РегистрацияИнвестиционногоПрофиля.НаличиеОпытаИЗнанийВОбластиИнвестирования КАК НаличиеОпытаИЗнанийВОбластиИнвестирования,
		|	РегистрацияИнвестиционногоПрофиля.ВеличинаУсловногоДохода КАК ВеличинаУсловногоДохода,
		|	РегистрацияИнвестиционногоПрофиля.ВеличинаУсловногоРасхода КАК ВеличинаУсловногоРасхода,
		|	РегистрацияИнвестиционногоПрофиля.ВеличинаУсловныхНакоплений КАК ВеличинаУсловныхНакоплений,
		|	РегистрацияИнвестиционногоПрофиля.ПриемлемыйУровеньРискаВОтносительномВыражении КАК ПриемлемыйУровеньРискаВОтносительномВыражении,
		|	РегистрацияИнвестиционногоПрофиля.ВариантИнвестиционногоГоризонта КАК ВариантИнвестиционногоГоризонта,
		|	РегистрацияИнвестиционногоПрофиля.НачалоПериодаИнвестиционногоГоризонта КАК НачалоПериодаИнвестиционногоГоризонта,
		|	РегистрацияИнвестиционногоПрофиля.ОкончаниеПериодаИнвестиционногоГоризонта КАК ОкончаниеПериодаИнвестиционногоГоризонта,
		|	РегистрацияИнвестиционногоПрофиля.ОтносительныйСрокИнвестиционногоГоризонта КАК ОтносительныйСрокИнвестиционногоГоризонта,
		|	РегистрацияИнвестиционногоПрофиля.ИнвестиционнаяЦель.Цели КАК ИнвестиционнаяЦель,
		|	РегистрацияИнвестиционногоПрофиля.ИнвестиционнаяЦель.ДопустимыйРискВПроцентах КАК ДопустимыйРиск,
		|	РегистрацияИнвестиционногоПрофиля.ИнвестиционнаяЦель.ОжидаемаяДоходностьВПроцентах КАК ОжидаемаяДоходность,
		|	РегистрацияИнвестиционногоПрофиля.ПредельныйДопустимыйРискЗаВесьСрокИнвестирования КАК ПредельныйДопустимыйРискЗаВесьСрокИнвестирования,
		|	РегистрацияИнвестиционногоПрофиля.РазмерЦелевыхСредств КАК РазмерЦелевыхСредств,
		|	РегистрацияИнвестиционногоПрофиля.СоотношениеЧистыхАктивовКОбъемуПередаваемыхСредств КАК СоотношениеЧистыхАктивовКОбъемуПередаваемыхСредств,
		|	РегистрацияИнвестиционногоПрофиля.НаличиеСпециалистовИлиПодразделенияИД КАК НаличиеСпециалистовИлиПодразделенияИД,
		|	РегистрацияИнвестиционногоПрофиля.НаличиеОперацийСФИЗаПоследнийОтчетныйГод КАК НаличиеОперацийСФИЗаПоследнийОтчетныйГод
		|ПОМЕСТИТЬ _ДанныеДокумента
		|ИЗ
		|	Документ.РегистрацияИнвестиционногоПрофиля КАК РегистрацияИнвестиционногоПрофиля
		|ГДЕ
		|	РегистрацияИнвестиционногоПрофиля.Ссылка = &Документ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеДокумента.Документ.Представление КАК Документ,
		|	_ДанныеДокумента.Проведен КАК Проведен,
		|	_ДанныеДокумента.Организация КАК Организация,
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления КАК СДУ,
		|	_ДанныеДокумента.СуммаПередаваемыхВДУСредств КАК СуммаПередаваемыхВДУСредств,
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключенияДДУ,
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения КАК ДатаЗавершенияДДУ,
		|	_ДанныеДокумента.ИнвестиционнаяЦель КАК ИнвестиционнаяЦель,
		|	_ДанныеДокумента.НаличиеОпытаИЗнанийВОбластиИнвестирования КАК НаличиеОпыта,
		|	_ДанныеДокумента.ВеличинаУсловногоДохода КАК УсловныйДоход,
		|	_ДанныеДокумента.ВеличинаУсловногоРасхода КАК УсловныйРасход,
		|	_ДанныеДокумента.ВеличинаУсловныхНакоплений КАК УсловныеНакопления,
		|	_ДанныеДокумента.ПриемлемыйУровеньРискаВОтносительномВыражении КАК ПриемлемыйУровеньРиска,
		|	ВЫБОР
		|		КОГДА _ДанныеДокумента.ВариантИнвестиционногоГоризонта = ЗНАЧЕНИЕ(Перечисление.ВариантыИнвестиционногоГоризонта.ИнтервалДат)
		|			ТОГДА _ДанныеДокумента.НачалоПериодаИнвестиционногоГоризонта
		|		КОГДА _ДанныеДокумента.ВариантИнвестиционногоГоризонта = ЗНАЧЕНИЕ(Перечисление.ВариантыИнвестиционногоГоризонта.КоличествоЛетСДатыЗаключенияДоговора)
		|			ТОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления.ДатаЗаключения
		|		ИНАЧЕ _ДанныеДокумента.Дата
		|	КОНЕЦ КАК ДатаНачалаГоризонта,
		|	ВЫБОР
		|		КОГДА _ДанныеДокумента.ВариантИнвестиционногоГоризонта = ЗНАЧЕНИЕ(Перечисление.ВариантыИнвестиционногоГоризонта.ИнтервалДат)
		|			ТОГДА _ДанныеДокумента.НачалоПериодаИнвестиционногоГоризонта
		|		КОГДА _ДанныеДокумента.ВариантИнвестиционногоГоризонта = ЗНАЧЕНИЕ(Перечисление.ВариантыИнвестиционногоГоризонта.КоличествоЛетСДатыЗаключенияДоговора)
		|			ТОГДА ДОБАВИТЬКДАТЕ(СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления.ДатаЗаключения, ГОД, _ДанныеДокумента.ОтносительныйСрокИнвестиционногоГоризонта)
		|		ИНАЧЕ ДОБАВИТЬКДАТЕ(_ДанныеДокумента.Дата, ГОД, _ДанныеДокумента.ОтносительныйСрокИнвестиционногоГоризонта)
		|	КОНЕЦ КАК ДатаЗавершенияГоризонта,
		|	_ДанныеДокумента.ДопустимыйРиск КАК ДопустимыйРиск,
		|	_ДанныеДокумента.ОжидаемаяДоходность КАК ОжидаемаяДоходность,
		|	_ДанныеДокумента.Дата КАК ДатаДокумента,
		|	_ДанныеДокумента.ПредельныйДопустимыйРискЗаВесьСрокИнвестирования КАК ПредельныйДопустимыйРискЗаВесьСрокИнвестирования,
		|	_ДанныеДокумента.РазмерЦелевыхСредств КАК РазмерЦелевыхСредств,
		|	_ДанныеДокумента.СоотношениеЧистыхАктивовКОбъемуПередаваемыхСредств КАК СоотношениеЧистыхАктивовКОбъемуПередаваемыхСредств,
		|	_ДанныеДокумента.НаличиеСпециалистовИлиПодразделенияИД КАК НаличиеСпециалистовИлиПодразделенияИД,
		|	_ДанныеДокумента.НаличиеОперацийСФИЗаПоследнийОтчетныйГод КАК НаличиеОперацийСФИЗаПоследнийОтчетныйГод
		|ПОМЕСТИТЬ _ДанныеССДУ
		|ИЗ
		|	_ДанныеДокумента КАК _ДанныеДокумента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(
		|				&Период,
		|				Организация В
		|					(ВЫБРАТЬ
		|						_ДанныеДокумента.Организация КАК Организация
		|					ИЗ
		|						_ДанныеДокумента КАК _ДанныеДокумента)) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
		|		ПО _ДанныеДокумента.СубъектУчета = СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия
		|ГДЕ
		|	_ДанныеДокумента.СубъектУчета ССЫЛКА Справочник.СтратегииИндивидуальногоИнвестирования
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ДанныеДокумента.Документ.Представление,
		|	_ДанныеДокумента.Проведен,
		|	_ДанныеДокумента.Организация,
		|	_ДанныеДокумента.СубъектУчета,
		|	_ДанныеДокумента.СуммаПередаваемыхВДУСредств,
		|	_ДанныеДокумента.СубъектУчета.ДатаЗаключения,
		|	_ДанныеДокумента.СубъектУчета.ДатаРасторжения,
		|	_ДанныеДокумента.ИнвестиционнаяЦель,
		|	_ДанныеДокумента.НаличиеОпытаИЗнанийВОбластиИнвестирования,
		|	_ДанныеДокумента.ВеличинаУсловногоДохода,
		|	_ДанныеДокумента.ВеличинаУсловногоРасхода,
		|	_ДанныеДокумента.ВеличинаУсловныхНакоплений,
		|	_ДанныеДокумента.ПриемлемыйУровеньРискаВОтносительномВыражении,
		|	ВЫБОР
		|		КОГДА _ДанныеДокумента.ВариантИнвестиционногоГоризонта = ЗНАЧЕНИЕ(Перечисление.ВариантыИнвестиционногоГоризонта.ИнтервалДат)
		|			ТОГДА _ДанныеДокумента.НачалоПериодаИнвестиционногоГоризонта
		|		КОГДА _ДанныеДокумента.ВариантИнвестиционногоГоризонта = ЗНАЧЕНИЕ(Перечисление.ВариантыИнвестиционногоГоризонта.КоличествоЛетСДатыЗаключенияДоговора)
		|			ТОГДА _ДанныеДокумента.СубъектУчета.ДатаЗаключения
		|		ИНАЧЕ _ДанныеДокумента.Дата
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА _ДанныеДокумента.ВариантИнвестиционногоГоризонта = ЗНАЧЕНИЕ(Перечисление.ВариантыИнвестиционногоГоризонта.ИнтервалДат)
		|			ТОГДА _ДанныеДокумента.НачалоПериодаИнвестиционногоГоризонта
		|		КОГДА _ДанныеДокумента.ВариантИнвестиционногоГоризонта = ЗНАЧЕНИЕ(Перечисление.ВариантыИнвестиционногоГоризонта.КоличествоЛетСДатыЗаключенияДоговора)
		|			ТОГДА ДОБАВИТЬКДАТЕ(_ДанныеДокумента.СубъектУчета.ДатаЗаключения, ГОД, _ДанныеДокумента.ОтносительныйСрокИнвестиционногоГоризонта)
		|		ИНАЧЕ ДОБАВИТЬКДАТЕ(_ДанныеДокумента.Дата, ГОД, _ДанныеДокумента.ОтносительныйСрокИнвестиционногоГоризонта)
		|	КОНЕЦ,
		|	_ДанныеДокумента.ДопустимыйРиск,
		|	_ДанныеДокумента.ОжидаемаяДоходность,
		|	_ДанныеДокумента.Дата,
		|	_ДанныеДокумента.ПредельныйДопустимыйРискЗаВесьСрокИнвестирования,
		|	_ДанныеДокумента.РазмерЦелевыхСредств,
		|	_ДанныеДокумента.СоотношениеЧистыхАктивовКОбъемуПередаваемыхСредств,
		|	_ДанныеДокумента.НаличиеСпециалистовИлиПодразделенияИД,
		|	_ДанныеДокумента.НаличиеОперацийСФИЗаПоследнийОтчетныйГод
		|ИЗ
