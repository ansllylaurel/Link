&НаСервереБезКонтекста
Функция ОрганизационноПравоваяФормаВРодительномПадеже(ОписаниеОрганизации)
	
	ОПФ = НРег("Акционерное общество");
	Если Лев(НРег(ОписаниеОрганизации), СтрДлина(ОПФ)) = ОПФ Тогда
		Возврат Лев(ОписаниеОрганизации, 10) + "го" + Сред(ОписаниеОрганизации, 12, 8) + "а" + Сред(ОписаниеОрганизации, 21);	
	КонецЕсли;
	
	ОПФ = НРег("Закрытое акционерное общество");
	Если Лев(НРег(ОписаниеОрганизации), СтрДлина(ОПФ)) = ОПФ Тогда
		Возврат Лев(ОписаниеОрганизации, 7) + "го" + Сред(ОписаниеОрганизации, 9, 11) + "го" + Сред(ОписаниеОрганизации, 21, 8) + "а" + Сред(ОписаниеОрганизации, 30);	
	КонецЕсли;

	ОПФ = НРег("Общество с ограниченной ответственностью");
	Если Лев(НРег(ОписаниеОрганизации), СтрДлина(ОПФ)) = ОПФ Тогда
		Возврат Лев(ОписаниеОрганизации, 7) + "а" + Сред(ОписаниеОрганизации, 9);	
	КонецЕсли;
	
	Возврат ОписаниеОрганизации;
	
КонецФункции

