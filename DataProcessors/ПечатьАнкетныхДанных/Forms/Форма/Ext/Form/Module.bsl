		Постфикс = "_До_09122019";
	Иначе
		
		Если НЕ ПервичноеОбращение Тогда
			Постфикс = "_Изменение";
		КонецЕсли;
		
	КонецЕсли;
	
	ИмяШаблона = "Анкета" + ДанныеДляПечати.ВариантАнкеты + ДанныеДляПечати.ВидЮрФизЛица + "СД" + Постфикс;
	НапечататьДокумент(WordApp, ИмяШаблона, ДанныеДляПечати);

КонецПроцедуры

