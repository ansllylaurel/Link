
/////////////////////////////////////////////////////////////////////////////////
// УПРАВЛЕНИЕ ФОРМОЙ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("СписокЮрФизЛиц", СписокЮрФизЛиц) Тогда
		
		Период = '00010101';
		ТретьяЧастьАнкеты = Истина;
		Элементы.ГруппаПечатьГрупповая.Видимость = Истина;
		Элементы.ГруппаПечатьОдиночная.Видимость = Ложь;
		
	Иначе
		
		Параметры.Свойство("ЮрФизЛицо",     ЮрФизЛицо);
		Параметры.Свойство("ВариантАнкеты", ВариантАнкеты);
		Параметры.Свойство("Период",        Период);
		Параметры.Свойство("ОснованиеПолномочий", ОснованиеПолномочий);
		
		ЗаполнитьСписокПериодов(ЭтотОбъект);
		
		ВозможнаАнкетаДепозитария = ПолучитьЦельПаи(ЮрФизЛицо, Период);
		
		ЗаполнитьФормыПоУмолчанию(ЭтотОбъект);
		УстановитьДоступностьАнкет(ЭтотОбъект);		
		Элементы.ГруппаПечатьГрупповая.Видимость = Ложь;
		Элементы.ГруппаПечатьОдиночная.Видимость = Истина;
	
	КонецЕсли; 


КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если АнкетаЮрФизЛицаСД Тогда
		ПроверяемыеРеквизиты.Добавить("Подписант");
	КонецЕсли;
	
	Если Не АнкетаЮрФизЛица
		И Не АнкетаЮрФизЛицаСД
		И Не ОпросникФАТКА
		И Не СогласиеНаОбработкуПерсональныхДанных 
		И Не ВтораяЧастьАнкеты 
		И Не ТретьяЧастьАнкеты 
		И Не ФормаСамосертификации Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны печатные формы",,,,Отказ);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСписокПериодов(Форма)
	
	Элемент = Форма.Элементы.Период;
	Элемент.СписокВыбора.Очистить();
	Элемент.СписокВыбора.Добавить('00010101', "Текущий");
	
	МассивПериодов = ПолучитьМассивПериодовАнкетныхДанных(Форма.ЮрФизЛицо);
	Для каждого Период из МассивПериодов Цикл
		Элемент.СписокВыбора.Добавить(Период, Формат(Период, "ДЛФ=D"));	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьАнкет(Форма)
	
	Если ЗначениеЗаполнено(Форма.ВариантАнкеты) Тогда
		Форма.Элементы.АнкетаЮрФизЛицаСД.Доступность = Ложь;	
		Форма.Элементы.ОпросникФАТКА.Доступность = Ложь;
	Иначе
		Форма.Элементы.АнкетаЮрФизЛицаСД.Доступность = Форма.ВозможнаАнкетаДепозитария;	
		Форма.Элементы.ОпросникФАТКА.Доступность = Истина;	
	КонецЕсли;
	
	Форма.Элементы.ФормаСамосертификации.Доступность = (Форма.ВариантАнкеты = ПредопределенноеЗначение("Перечисление.ВидыУчастниковАнкет.ПустаяСсылка")
														ИЛИ Форма.ВариантАнкеты = ПредопределенноеЗначение("Перечисление.ВидыУчастниковАнкет.Выгодоприобретатель"));
	
	
	Форма.Элементы.ОснованиеПолномочий.Видимость = Форма.ВариантАнкеты = ПредопределенноеЗначение("Перечисление.ВидыУчастниковАнкет.Представитель");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьФормыПоУмолчанию(Форма)
	
	Если Форма.ПервичноеОбращение Тогда
		
		Форма.АнкетаЮрФизЛица						= Истина;
		Форма.АнкетаЮрФизЛицаСД						= Не ЗначениеЗаполнено(Форма.ВариантАнкеты) и Форма.ВозможнаАнкетаДепозитария;
		Форма.ОпросникФАТКА							= Не ЗначениеЗаполнено(Форма.ВариантАнкеты);
		Форма.СогласиеНаОбработкуПерсональныхДанных	= Не ЗначениеЗаполнено(Форма.ВариантАнкеты)
														или Форма.ВариантАнкеты = ПредопределенноеЗначение("Перечисление.ВидыУчастниковАнкет.Представитель");
		
	Иначе
		
		Форма.АнкетаЮрФизЛица						= Истина;
		Форма.АнкетаЮрФизЛицаСД						= Не ЗначениеЗаполнено(Форма.ВариантАнкеты) и Форма.ВозможнаАнкетаДепозитария;
		Форма.ОпросникФАТКА							= Ложь;
		Форма.СогласиеНаОбработкуПерсональныхДанных	= Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМассивПериодовАнкетныхДанных(ЮрФизЛицо)
	
	Если ЮрФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыФизическихЛицАнкетные.Период КАК Период
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные КАК РеквизитыФизическихЛицАнкетные
		|ГДЕ
		|	РеквизитыФизическихЛицАнкетные.ЮрФизЛицо = &ЮрФизЛицо
		|	И РеквизитыФизическихЛицАнкетные.Организация = &Организация
		|	И РеквизитыФизическихЛицАнкетные.Язык = &Язык
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ");
		
		Запрос.УстановитьПараметр("ЮрФизЛицо",   ЮрФизЛицо);
		Запрос.УстановитьПараметр("Организация", ПараметрыСеанса.ТекущаяОрганизация);
		Запрос.УстановитьПараметр("Язык",        Справочники.Языки.Русский);
		
		Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
		
	ИначеЕсли ЮрФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицАнкетные.Период КАК Период
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные КАК РеквизитыЮридическихЛицАнкетные
		|ГДЕ
		|	РеквизитыЮридическихЛицАнкетные.ЮрФизЛицо = &ЮрФизЛицо
		|	И РеквизитыЮридическихЛицАнкетные.Организация = &Организация
		|	И РеквизитыЮридическихЛицАнкетные.Язык = &Язык
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ");
		
		Запрос.УстановитьПараметр("ЮрФизЛицо",   ЮрФизЛицо);
		Запрос.УстановитьПараметр("Организация", ПараметрыСеанса.ТекущаяОрганизация);
		Запрос.УстановитьПараметр("Язык",        Справочники.Языки.Русский);
		
		Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
		
	Иначе
		Возврат Новый Массив;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЦельПаи(Знач ЮрФизЛицо, Знач Период)
	
	Если ЮрФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Регистратор.ЦельПриобретениеПаев КАК ЦельПриобретениеПаев
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо = &ЮрФизЛицо
		|				И Организация = &Организация
		|				И Язык = &Язык) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних");
		
		Запрос.УстановитьПараметр("Период",      Период);
		Запрос.УстановитьПараметр("ЮрФизЛицо",   ЮрФизЛицо);
		Запрос.УстановитьПараметр("Организация", ПараметрыСеанса.ТекущаяОрганизация);
		Запрос.УстановитьПараметр("Язык",        Справочники.Языки.Русский);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.ЦельПриобретениеПаев;	
		КонецЕсли;
				
	ИначеЕсли ЮрФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.Регистратор.ЦельПриобретениеПаев КАК ЦельПриобретениеПаев
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо = &ЮрФизЛицо
		|				И Организация = &Организация
		|				И Язык = &Язык) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних");
		
		Запрос.УстановитьПараметр("Период",      Период);
		Запрос.УстановитьПараметр("ЮрФизЛицо",   ЮрФизЛицо);
		Запрос.УстановитьПараметр("Организация", ПараметрыСеанса.ТекущаяОрганизация);
		Запрос.УстановитьПараметр("Язык",        Справочники.Языки.Русский);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.ЦельПриобретениеПаев;	
		КонецЕсли;
				
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ЮрФизЛицоПриИзменении(Элемент)
	
	Период = '00010101';
	ЗаполнитьСписокПериодов(ЭтотОбъект);
	ВозможнаАнкетаДепозитария = ПолучитьЦельПаи(ЮрФизЛицо, Период);
	
	ЗаполнитьФормыПоУмолчанию(ЭтотОбъект);
	УстановитьДоступностьАнкет(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	ВозможнаАнкетаДепозитария = ПолучитьЦельПаи(ЮрФизЛицо, Период);
	
	ЗаполнитьФормыПоУмолчанию(ЭтотОбъект);
	УстановитьДоступностьАнкет(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантАнкетыПриИзменении(Элемент)
	
	ЗаполнитьФормыПоУмолчанию(ЭтотОбъект);
	УстановитьДоступностьАнкет(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПервичноеОбращениеПриИзменении(Элемент)
	
	ЗаполнитьФормыПоУмолчанию(ЭтотОбъект);
	
КонецПроцедуры

/////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ПЕЧАТИ

&НаКлиенте
Процедура Печать(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;	
	КонецЕсли;
		
	// создадим документ MS Word на основании сохраненного шаблона
	WordApp = СоздатьОбъектWord(Ложь);
	
	Если ЭтаФорма.СписокЮрФизЛиц.Количество() = 0 Тогда
		ЭтаФорма.СписокЮрФизЛиц.Добавить(ЭтаФорма.ЮрФизЛицо);
	КонецЕсли; 
	
	Для каждого ТекЮрФизЛицо Из ЭтаФорма.СписокЮрФизЛиц Цикл
	
		ЭтаФорма.ЮрФизЛицо = ТекЮрФизЛицо.Значение;
		
		ДанныеДляПечати = ПолучитьДанныеДляПечатиЮрФизЛица();
		
		Если АнкетаЮрФизЛица Тогда
			НапечататьАнкету(WordApp, ДанныеДляПечати);	
		КонецЕсли;
		
		Если АнкетаЮрФизЛицаСД Тогда
			НапечататьАнкетуСД(WordApp, ДанныеДляПечати);	
		КонецЕсли;
		
		Если СогласиеНаОбработкуПерсональныхДанных Тогда
			НапечататьСогласиеНаОбработкуПерсональныхДанных(WordApp, ДанныеДляПечати);
		КонецЕсли;
		
		Если ОпросникФАТКА Тогда
			НапечататьОпросник(WordApp, ДанныеДляПечати);
		КонецЕсли;
		
		Если ВтораяЧастьАнкеты Тогда
			НапечататьВторуюЧастьАнкеты(WordApp, ДанныеДляПечати);
		КонецЕсли;
		
		Если ТретьяЧастьАнкеты Тогда
			НапечататьТретьюЧастьАнкеты(WordApp, ДанныеДляПечати);
		КонецЕсли;
		
		Если ФормаСамосертификации Тогда
			НапечататьФормуСамосертификации(WordApp, ДанныеДляПечати);
		КонецЕсли;
		
	КонецЦикла; 
	
	WordApp.Application.Visible = Истина;
	
КонецПроцедуры

#Область Получение_данных

&НаСервере
Функция ПолучитьДанныеДляПечатиЮрФизЛица() 
	
	Если ЗначениеЗаполнено(ВариантАнкеты) Тогда
		ВариантАнкетыСтрока = ВариантАнкеты.Метаданные().ЗначенияПеречисления[Перечисления.ВидыУчастниковАнкет.Индекс(ВариантАнкеты)].Имя;
	Иначе
		ВариантАнкетыСтрока = "Владелец";
	КонецЕсли;
	
	ДанныеДляПечати = Новый Структура;
	
	ДанныеДляПечати.Вставить("ВариантАнкеты"			, ВариантАнкетыСтрока);
	ДанныеДляПечати.Вставить("ПодписантУК"				, ПолучитьПодписантаИзКонтактныхЛицНаСервере());
	ДанныеДляПечати.Вставить("ОснованиеПолномочий"		, ОснованиеПолномочий);
	ДанныеДляПечати.Вставить("УпрощеннаяИдентификация"	, Ложь);
	
	ДанныеДляПечати.Вставить("Подписант", ПолучитьПодписантаНаСервере());
	ДанныеДляПечати.Вставить("ДолжностьПодписанта", ЭтотОбъект.Должность);
		
	Если АнкетаЮрФизЛица 
	 Или АнкетаЮрФизЛицаСД 
	 Или СогласиеНаОбработкуПерсональныхДанных 
	 Или ОпросникФАТКА 
	 Или ВтораяЧастьАнкеты 
	 Или ТретьяЧастьАнкеты 
	 Или ФормаСамосертификации Тогда
	
		Если ЮрФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
			ДанныеДляПечати.Вставить("ВидЮрФизЛица",  "ФизЛицо");
			Анкета = ЗаполнитьДанныеДляПечатиФизЛица(ДанныеДляПечати, ЮрФизЛицо);	
			ДанныеДляПечати.Вставить("УпрощеннаяИдентификация", Анкета.УпрощеннаяИдентификация);
		ИначеЕсли ЮрФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
			ДанныеДляПечати.Вставить("ВидЮрФизЛица",  "ЮрЛицо");
			Анкета = ЗаполнитьДанныеДляПечатиЮрЛица(ДанныеДляПечати, ЮрФизЛицо);	
			ДанныеДляПечати.Вставить("УпрощеннаяИдентификация", Ложь);
		КонецЕсли;
		
		ЗаполнитьДанныеОпросников(ДанныеДляПечати, Анкета);
		
		ЗаполнитьДанныеПредставителей(ДанныеДляПечати, Анкета);
		
		ЗаполнитьДанныеОрганизации(ДанныеДляПечати);
		
		ДанныеДляПечати.Вставить("Дата", Формат(Анкета.Дата, "ДФ='dd MMMM yyyy ''г.'''"));
		
		ДатаНачалаОтношений = Справочники.СчетаДоверительногоУправления.ДатаНачалаРаботыСКлиентом(ЮрФизЛицо, Анкета.Организация);
		Если Не ЗначениеЗаполнено(ДатаНачалаОтношений) Тогда
			ДатаНачалаОтношений = Анкета.Дата;
		КонецЕсли;
		
		ДанныеДляПечати.Вставить("ДатаНачалаОтношений", Формат(ДатаНачалаОтношений, "ДФ='dd MMMM yyyy ''г'''"));
		
		ДанныеДляПечати.Вставить("УровеньРиска", ?(Анкета.ВысокийУровеньРиска, "высокий", "низкий"));
		ДанныеДляПечати.Вставить("ОбоснованиеУровняРиска", Анкета.ОбоснованиеУровняРиска);
		
		ДатаПрекращенияОтношений = Справочники.СчетаДоверительногоУправления.ДатаПрекращенияРаботыСКлиентом(ЮрФизЛицо, Анкета.Организация, ТекущаяДатаСеанса());
		ДанныеДляПечати.Вставить("ДатаПрекращенияОтношений", Формат(ДатаПрекращенияОтношений, "ДФ='dd MMMM yyyy ''г'''"));
		
		ДанныеРуководителя = ПолучитьДанныеРуководителя(Анкета.Организация, ДатаНачалаОтношений);
		ПредставлениеРуководителя = СтрШаблон("%1 %2 %3 %4", 
			ДанныеРуководителя.Должность,
			ДанныеРуководителя.Фамилия,
			ДанныеРуководителя.Имя,
			ДанныеРуководителя.Отчество);
		
		ДанныеДляПечати.Вставить("ПредставлениеРуководителя", ПредставлениеРуководителя);
		
	КонецЕсли; 
	
	Если ЭтаФорма.ВтораяЧастьАнкеты Тогда
		ЗаполнитьВторуюЧастьАнкеты(ДанныеДляПечати);
	КонецЕсли; 	
	
	Если ЭтаФорма.ТретьяЧастьАнкеты Тогда
		ЗаполнитьТретьюЧастьАнкеты(ДанныеДляПечати);
	КонецЕсли; 	
	
	ЗаполнитьПустыеПараметры(ДанныеДляПечати);
			
	Возврат ДанныеДляПечати;
	
КонецФункции

&НаСервере
Функция ЗаполнитьВторуюЧастьАнкеты(ДанныеДляПечати)

	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ЮрФизЛицо", ЮрФизЛицо);
	Запрос.УстановитьПараметр("Организация", ПараметрыСеанса.ТекущаяОрганизация);
	Запрос.УстановитьПараметр("Период", ЭтаФорма.Период);
	
	Если ДанныеДляПечати.Свойство("ФИО") Тогда
		ДанныеДляПечати.Вставить("ЮрФизЛицо", ДанныеДляПечати.ФИО);
	ИначеЕсли ДанныеДляПечати.Свойство("ПолноеНаименованиеПоУставу") Тогда
		ДанныеДляПечати.Вставить("ЮрФизЛицо", ДанныеДляПечати.ПолноеНаименованиеПоУставу);	
	Иначе
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество КАК ЮрФизЛицо
			|ИЗ
			|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И ЮрФизЛицо = &ЮрФизЛицо
			|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу
			|ИЗ
			|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И ЮрФизЛицо = &ЮрФизЛицо
			|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних";
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		
		ДанныеДляПечати.Вставить("ЮрФизЛицо", Выборка.ЮрФизЛицо);
		
	КонецЕсли;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АнкетаФизическогоЛица.Дата КАК Дата,
		|	АнкетаФизическогоЛица.Ответственный КАК Ответственный,
		|	АнкетаФизическогоЛица.Организация КАК Организация,
		|	АнкетаФизическогоЛица.Ответственный.ЮрФизЛицо КАК ОтветственныйЮрФизЛицо
		|ПОМЕСТИТЬ _Анкеты
		|ИЗ
		|	Документ.АнкетаФизическогоЛица КАК АнкетаФизическогоЛица
		|ГДЕ
		|	АнкетаФизическогоЛица.ЮрФизЛицо = &ЮрФизЛицо
		|	И АнкетаФизическогоЛица.Проведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Анкеты.Дата КАК Дата,
		|	ЕСТЬNULL(ВложенныйЗапрос.Ответственный, ""заполнение анкеты (досье) клиента осуществлено с использованием автоматизированных систем"") КАК Ответственный
		|ИЗ
		|	_Анкеты КАК _Анкеты
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВложенныйЗапрос.Дата КАК Дата,
		|			ВложенныйЗапрос.Сотрудник КАК Сотрудник,
		|			СотрудникиОрганизации.Должность.Наименование + "" "" + РеквизитыСотрудниковОрганизации.Фамилия + "" "" + РеквизитыСотрудниковОрганизации.Имя + "" "" + РеквизитыСотрудниковОрганизации.Отчество КАК Ответственный
		|		ИЗ
		|			(ВЫБРАТЬ
		|				_Анкеты.Дата КАК Дата,
		|				_Анкеты.Организация КАК Организация,
		|				СотрудникиОрганизации.Сотрудник КАК Сотрудник,
		|				_Анкеты.ОтветственныйЮрФизЛицо КАК ОтветственныйЮрФизЛицо,
		|				МАКСИМУМ(СотрудникиОрганизации.Период) КАК ПериодСотрудники,
		|				МАКСИМУМ(РеквизитыСотрудниковОрганизации.Период) КАК ПериодРеквизиты,
		|				МАКСИМУМ(СостояниеСотрудниковОрганизаций.Период) КАК ПериодСостояние
		|			ИЗ
		|				_Анкеты КАК _Анкеты
		|					ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации КАК СотрудникиОрганизации
		|					ПО _Анкеты.Организация = СотрудникиОрганизации.Организация
		|						И _Анкеты.ОтветственныйЮрФизЛицо = СотрудникиОрганизации.Сотрудник.ЮрФизЛицо
		|						И _Анкеты.Дата >= СотрудникиОрганизации.Период
		|					ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации КАК РеквизитыСотрудниковОрганизации
		|					ПО _Анкеты.Организация = РеквизитыСотрудниковОрганизации.Организация
		|						И _Анкеты.ОтветственныйЮрФизЛицо = РеквизитыСотрудниковОрганизации.ЮрФизЛицо
		|						И _Анкеты.Дата >= РеквизитыСотрудниковОрганизации.Период
		|						И (РеквизитыСотрудниковОрганизации.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|					ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеСотрудниковОрганизаций КАК СостояниеСотрудниковОрганизаций
		|					ПО _Анкеты.Организация = СостояниеСотрудниковОрганизаций.Организация
		|						И (СотрудникиОрганизации.Сотрудник = СостояниеСотрудниковОрганизаций.Сотрудник)
		|						И _Анкеты.Дата >= СостояниеСотрудниковОрганизаций.Период
		|			
		|			СГРУППИРОВАТЬ ПО
		|				_Анкеты.ОтветственныйЮрФизЛицо,
		|				_Анкеты.Дата,
		|				_Анкеты.Организация,
		|				СотрудникиОрганизации.Сотрудник) КАК ВложенныйЗапрос
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации КАК СотрудникиОрганизации
		|				ПО ВложенныйЗапрос.ПериодСотрудники = СотрудникиОрганизации.Период
		|					И ВложенныйЗапрос.Организация = СотрудникиОрганизации.Организация
		|					И ВложенныйЗапрос.Сотрудник = СотрудникиОрганизации.Сотрудник
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации КАК РеквизитыСотрудниковОрганизации
		|				ПО ВложенныйЗапрос.ПериодРеквизиты = РеквизитыСотрудниковОрганизации.Период
		|					И ВложенныйЗапрос.Организация = РеквизитыСотрудниковОрганизации.Организация
		|					И ВложенныйЗапрос.ОтветственныйЮрФизЛицо = РеквизитыСотрудниковОрганизации.ЮрФизЛицо
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеСотрудниковОрганизаций КАК СостояниеСотрудниковОрганизаций
		|				ПО (СостояниеСотрудниковОрганизаций.Период = ВложенныйЗапрос.ПериодСостояние)
		|					И (СостояниеСотрудниковОрганизаций.Организация = ВложенныйЗапрос.Организация)
		|					И ВложенныйЗапрос.Сотрудник = СостояниеСотрудниковОрганизаций.Сотрудник
		|					И (СостояниеСотрудниковОрганизаций.Состояние В (ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудникаОрганизации.Работа), ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудникаОрганизации.РаботаВОтпускеПоУходуЗаРебенком), ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудникаОрганизации.Командировка)))
		|		ГДЕ
		|			(СотрудникиОрганизации.ВидСобытия ЕСТЬ NULL
		|					ИЛИ СотрудникиОрганизации.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение))) КАК ВложенныйЗапрос
		|		ПО _Анкеты.Дата = ВложенныйЗапрос.Дата
		|
		|УПОРЯДОЧИТЬ ПО
		|	_Анкеты.Дата";
	
	Если ЭтаФорма.ЮрФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "АнкетаФизическогоЛица", "АнкетаЮридическогоЛица");
	КонецЕсли;
	
	ТаблицаАнкет = Запрос.Выполнить().Выгрузить();
	МассивСтруктур = Новый Массив;
	
	Для каждого СтрокаТаблицаАнкет Из ТаблицаАнкет Цикл
		
		ИндексСтроки = ТаблицаАнкет.Индекс(СтрокаТаблицаАнкет);
		НомерСтроки = ИндексСтроки + 10;
		
		Если ИндексСтроки = 0 Тогда
			ЗаголовокСтроки = "Дата оформления анкеты (досье) клиента" + Символы.ПС;
		ИначеЕсли ИндексСтроки = 1 Тогда
			ЗаголовокСтроки = "Даты обновлений анкеты (досье) клиента" + Символы.ПС;
		Иначе
			ЗаголовокСтроки = "";
		КонецЕсли;
		
		МассивСтруктур.Добавить(Новый Структура("Строка, Колонка, Значение", НомерСтроки, 1, ЗаголовокСтроки + Формат(СтрокаТаблицаАнкет.Дата, "ДФ=dd.MM.yyyy")));
		МассивСтруктур.Добавить(Новый Структура("Строка, Колонка, Значение", НомерСтроки, 2, СокрЛП(СтрокаТаблицаАнкет.Ответственный)));
		
	КонецЦикла; 	
	
	Таблицы = Новый Соответствие;
	Таблицы.Вставить(1, МассивСтруктур);
	
	ДанныеДляПечати.Вставить("Таблицы", Таблицы);
	
КонецФункции 

&НаСервере
Функция ЗаполнитьТретьюЧастьАнкеты(ДанныеДляПечати)

	ДанныеДляПечати.Вставить("ДатаНачала", Формат(ЭтаФорма.ПериодСверокСоСписками.ДатаНачала, "ДФ=dd.MM.yyyy"));
	ДанныеДляПечати.Вставить("ДатаОкончания", Формат(ЭтаФорма.ПериодСверокСоСписками.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ЮрФизЛицо", ЮрФизЛицо);
	Запрос.УстановитьПараметр("Организация", ПараметрыСеанса.ТекущаяОрганизация);
	Запрос.УстановитьПараметр("Период", ЭтаФорма.Период);
	
	Если ДанныеДляПечати.Свойство("ФИО") Тогда
		ДанныеДляПечати.Вставить("ЮрФизЛицо", ДанныеДляПечати.ФИО);
	ИначеЕсли ДанныеДляПечати.Свойство("ПолноеНаименованиеПоУставу") Тогда
		ДанныеДляПечати.Вставить("ЮрФизЛицо", ДанныеДляПечати.ПолноеНаименованиеПоУставу);	
	Иначе
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество КАК ЮрФизЛицо
			|ИЗ
			|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И ЮрФизЛицо = &ЮрФизЛицо
			|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу
			|ИЗ
			|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И ЮрФизЛицо = &ЮрФизЛицо
			|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних";
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		
		ДанныеДляПечати.Вставить("ЮрФизЛицо", Выборка.ЮрФизЛицо);
		
	КонецЕсли;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Клиент КАК Клиент,
		|	МИНИМУМ(ВложенныйЗапрос.ДатаЗаключения) КАК ДатаЗаключения,
		|	МАКСИМУМ(ВложенныйЗапрос.ДатаРасторжения) КАК ДатаРасторжения
		|ПОМЕСТИТЬ _ПериодыДействия
		|ИЗ
		|	(ВЫБРАТЬ
		|		КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|		СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|		ВЫБОР
		|			КОГДА СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА &ДатаОкончания
		|			ИНАЧЕ СчетаДоверительногоУправления.ДатаРасторжения
		|		КОНЕЦ КАК ДатаРасторжения
		|	ИЗ
		|		РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, Клиент = &ЮрФизЛицо) КАК КлиентыДоверительногоУправленияСрезПоследних
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|			ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|				И (СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания)
		|				И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаНачала)
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		ЗаявкаПайщика.Пайщик,
		|		НАЧАЛОПЕРИОДА(ЗаявкаПайщика.Дата, ДЕНЬ),
		|		ВЫБОР
		|			КОГДА КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА &ДатаОкончания
		|			ИНАЧЕ КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения
		|		КОНЕЦ
		|	ИЗ
		|		Документ.ЗаявкаПайщика КАК ЗаявкаПайщика
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|			ПО ЗаявкаПайщика.ПаевойИнвестиционныйФонд = КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|				И ЗаявкаПайщика.Организация = КлиентыДоверительногоУправленияСрезПоследних.Организация
		|				И (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания)
		|				И (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения >= &ДатаНачала)
		|	ГДЕ
		|		ЗаявкаПайщика.Организация = &Организация
		|		И ЗаявкаПайщика.Пайщик = &ЮрФизЛицо
		|		И ЗаявкаПайщика.Многократная
		|		И НЕ ЗаявкаПайщика.ПометкаУдаления) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.Клиент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _ТаблицаДат
		|ИЗ
		|	_ПериодыДействия КАК _ПериодыДействия
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ПО (ДанныеКалендаря.Дата >= _ПериодыДействия.ДатаЗаключения)
		|			И (ДанныеКалендаря.Дата <= _ПериодыДействия.ДатаРасторжения)
		|ГДЕ
		|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаря.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ТаблицаДат.Дата КАК Дата,
		|	ВЫБОР
		|		КОГДА ЖурналСверкиСоСписками.Пройдена
		|			ТОГДА ""Совпадений не выявлено""
		|		ИНАЧЕ ""Выявлено совпадение с "" + ВЫБОР ЖурналСверкиСоСписками.ВидПеречня
		|				КОГДА ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СписокТеррористов)
		|					ТОГДА ""Перечнем Э-Т""
		|				КОГДА ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СписокРешенийМВК)
		|					ТОГДА ""Решением МВК""
		|				КОГДА ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СводныйПереченьСоветаБезопасностиООН)
		|					ТОГДА ""Перечнем СБ ООН""
		|			КОНЕЦ
		|	КОНЕЦ КАК РезультатыПроверки,
		|	ВЫБОР
		|		КОГДА ЖурналСверкиСоСписками.Пройдена
		|				ИЛИ ЖурналСверкиСоСписками.Пройдена ЕСТЬ NULL
		|			ТОГДА ""-""
		|		ИНАЧЕ ВЫРАЗИТЬ(ЖурналСверкиСоСписками.Комментарий КАК СТРОКА(1024))
		|	КОНЕЦ КАК Комментарий
		|ИЗ
		|	_ТаблицаДат КАК _ТаблицаДат
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналСверкиСоСписками КАК ЖурналСверкиСоСписками
		|		ПО _ТаблицаДат.Дата = ЖурналСверкиСоСписками.Период
		|			И (ЖурналСверкиСоСписками.ЮрФизЛицо = &ЮрФизЛицо)
		|			И (ЖурналСверкиСоСписками.Организация = &Организация)
		|			И (ЖурналСверкиСоСписками.ВидПеречня В (ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СписокТеррористов), ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СписокРешенийМВК), ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СводныйПереченьСоветаБезопасностиООН)))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
	
	Запрос.УстановитьПараметр("ДатаНачала", ПериодСверокСоСписками.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ПериодСверокСоСписками.ДатаОкончания);
	ТаблицаПроверок = Запрос.Выполнить().Выгрузить();
	МассивСтруктур = Новый Массив;
	
	Для каждого СтрокаТаблицаПроверок Из ТаблицаПроверок Цикл
		
		НомерСтроки = ТаблицаПроверок.Индекс(СтрокаТаблицаПроверок) + 4;
		
		// первая колонка - номер п/п
		МассивСтруктур.Добавить(Новый Структура("Строка, Колонка, Значение", НомерСтроки, 1, НомерСтроки - 3));
		
		Для каждого КолонкаТаблицаПроверок Из ТаблицаПроверок.Колонки Цикл
		
			НомерКолонки = ТаблицаПроверок.Колонки.Индекс(КолонкаТаблицаПроверок) + 2;
			Значение = СтрокаТаблицаПроверок[КолонкаТаблицаПроверок.Имя];
			
			Если КолонкаТаблицаПроверок.Имя = "Комментарий" И Значение <> "-" Тогда
			
				ПозицияДаты = СтрНайти(Значение, "с данными санкционного списка от ") + 33;
				Если ПозицияДаты > 33 Тогда
					Значение = Сред(Значение, ПозицияДаты, 10);
				КонецЕсли;
			
			КонецЕсли;
			
			Если ТипЗнч(Значение) = Тип("Строка") Тогда
				Значение = СокрЛП(Значение);
			ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
				Значение = Формат(Значение, "ДФ=dd.MM.yyyy")
			КонецЕсли; 
			
			МассивСтруктур.Добавить(Новый Структура("Строка, Колонка, Значение", НомерСтроки, НомерКолонки, Значение));
		
		КонецЦикла; 
	
	КонецЦикла; 	
	
	Таблицы = Новый Соответствие;
	Таблицы.Вставить(1, МассивСтруктур);
	
	ДанныеДляПечати.Вставить("Таблицы", Таблицы);
	
КонецФункции 

&НаСервере
Функция ПолучитьДанныеРуководителя(Организация, Период)

	Руководитель = РегистрыСведений.ДолжностныеЛицаОрганизаций.ПолучитьДолжностноеЛицо(Период, Организация, Перечисления.ВидыДолжностныхЛиц.Руководитель);
	
	Если Руководитель = Неопределено Тогда
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеквизитыСотрудниковОрганизацииСрезПоследних.Фамилия КАК Фамилия,
			|	РеквизитыСотрудниковОрганизацииСрезПоследних.Имя КАК Имя,
			|	РеквизитыСотрудниковОрганизацииСрезПоследних.Отчество КАК Отчество,
			|	СотрудникиОрганизацииСрезПоследних.Должность КАК Должность
			|ИЗ
			|	РегистрСведений.СотрудникиОрганизации.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И Должность.Наименование = ""Генеральный директор"") КАК СотрудникиОрганизацииСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыСотрудниковОрганизацииСрезПоследних
			|		ПО СотрудникиОрганизацииСрезПоследних.Сотрудник.ЮрФизЛицо = РеквизитыСотрудниковОрганизацииСрезПоследних.ЮрФизЛицо
			|ГДЕ
			|	СотрудникиОрганизацииСрезПоследних.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)";
		
	Иначе
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеквизитыСотрудниковОрганизацииСрезПоследних.Фамилия КАК Фамилия,
			|	РеквизитыСотрудниковОрганизацииСрезПоследних.Имя КАК Имя,
			|	РеквизитыСотрудниковОрганизацииСрезПоследних.Отчество КАК Отчество,
			|	СотрудникиОрганизацииСрезПоследних.Должность КАК Должность
			|ИЗ
			|	РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
			|			&Период,
			|			(Организация, ЮрФизЛицо, Язык) В
			|				(ВЫБРАТЬ
			|					&Организация,
			|					Сотрудники.ЮрФизЛицо,
			|					ЗНАЧЕНИЕ(Справочник.Языки.Русский)
			|				ИЗ
			|					Справочник.Сотрудники КАК Сотрудники
			|				ГДЕ
			|					Сотрудники.Ссылка = &Руководитель)) КАК РеквизитыСотрудниковОрганизацииСрезПоследних
			|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И Сотрудник = &Руководитель) КАК СотрудникиОрганизацииСрезПоследних
			|		ПО (ИСТИНА)";
		
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Руководитель", Руководитель);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ДанныеРуководителя = Новый Структура("Должность, Фамилия, Имя, Отчество");
	
	Если Выборка.Следующий() Тогда
	
		ЗаполнитьЗначенияСвойств(ДанныеРуководителя, Выборка);
	
	КонецЕсли;
	
	Возврат ДанныеРуководителя;
	
КонецФункции

&НаСервере
Функция ЗаполнитьДанныеДляПечатиЮрЛица(ДанныеДляПечати, ЮрЛицо)
		
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.Регистратор КАК Анкета,
	|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
	|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
	|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.СокращенноеНаименование КАК СокращенноеНаименование,
	|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН,
	|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КПП КАК КПП,
	|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ОрганизационноПравоваяФорма КАК ОрганизационноПравоваяФорма,
	|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КодПоОКВЭД КАК КодПоОКВЭД,
	|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КодПоОКПО КАК КодПоОКПО,
	|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КодПоОКТМО КАК КодПоОКТМО,
	|	ЕСТЬNULL(РеквизитыЮридическихЛицАнкетныеСрезПоследнихГоловнойОрганизации.ОГРН, РеквизитыЮридическихЛицАнкетныеСрезПоследних.ОГРН) КАК ОГРН,
	|	ЕСТЬNULL(РеквизитыЮридическихЛицАнкетныеСрезПоследнихГоловнойОрганизации.ДатаВыдачиОГРН, РеквизитыЮридическихЛицАнкетныеСрезПоследних.ДатаВыдачиОГРН) КАК ДатаВыдачиОГРН,
	|	ЕСТЬNULL(РеквизитыЮридическихЛицАнкетныеСрезПоследнихГоловнойОрганизации.ОрганВыдавшийОГРН, РеквизитыЮридическихЛицАнкетныеСрезПоследних.ОрганВыдавшийОГРН) КАК ОрганВыдавшийОГРН,
	|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.РезидентРФ КАК РезидентРФ,
	|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.TIN КАК TIN,
	|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.СтранаРегистрации КАК СтранаРегистрации,
	|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ВебСтраница КАК ВебСтраница,
	|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.Период КАК ДатаЗаполнения
	|ИЗ
	|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
	|			&Период,
	|			ЮрФизЛицо = &ЮрФизЛицо
	|				И Организация = &Организация
	|				И Язык = &Язык) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
	|				&Период,
	|				ЮрФизЛицо = &ЮрФизЛицоГоловное
	|					И Организация = &Организация
	|					И Язык = &Язык) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследнихГоловнойОрганизации
	|		ПО (ИСТИНА)");
	
	Запрос.УстановитьПараметр("Период", 		   Период);
	Запрос.УстановитьПараметр("ЮрФизЛицоГоловное", РаботаСНормативноСправочнойИнформацией.ПолучитьГоловнуюОрганизацию(ЮрЛицо, Период));
	Запрос.УстановитьПараметр("ЮрФизЛицо",         ЮрЛицо);
	Запрос.УстановитьПараметр("Организация",       ПараметрыСеанса.ТекущаяОрганизация);
	Запрос.УстановитьПараметр("Язык", 			   Справочники.Языки.Русский);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Для каждого Колонка из Результат.Колонки Цикл
		ДанныеДляПечати.Вставить(Колонка.Имя);
	КонецЦикла;
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеДляПечати, Выборка);	
	Иначе
		ВызватьИсключение "Не найдена анкета для юридического лица " + ЮрЛицо;
	КонецЕсли;
	
	Анкета = Выборка.Анкета;
	
	ДанныеДляПечати.Вставить("ДатаАнкеты", Выборка.ДатаЗаполнения);
	
	ДанныеДляПечати.Вставить("ОГРНДо2002");
	ДанныеДляПечати.Вставить("ДатаВыдачиОГРНДо2002");
	ДанныеДляПечати.Вставить("ОрганВыдавшийОГРНДо2002");
	ДанныеДляПечати.Вставить("ОГРНПосле2002");
	ДанныеДляПечати.Вставить("ДатаВыдачиОГРНПосле2002");
	ДанныеДляПечати.Вставить("ОрганВыдавшийОГРНПосле2002");
	
	ДанныеДляПечати.Вставить("ОГРНПосле2002", Выборка.ОГРН);
	ДанныеДляПечати.Вставить("ДатаВыдачиОГРНПосле2002", Выборка.ДатаВыдачиОГРН);
	ДанныеДляПечати.Вставить("ОрганВыдавшийОГРНПосле2002", Выборка.ОрганВыдавшийОГРН);
	
	ДанныеДляПечати.Вставить("ДатаМестоГосударственнойРегистрации", Формат(Выборка.ДатаВыдачиОГРН, "ДФ=dd.MM.yyyy") + ", " + Выборка.ОрганВыдавшийОГРН);
	ДанныеДляПечати.Вставить("ОрганВыдавшийОГРНФилиала");
	
	ДанныеДляПечати.Вставить("КодыФорм", ДанныеДляПечати.КодПоОКТМО + ", " + ДанныеДляПечати.КодПоОКПО + ", " + ДанныеДляПечати.КодПоОКВЭД);
	
	ДанныеДляПечати.Вставить("КодПоОКТМО"	, ДанныеДляПечати.КодПоОКТМО);
	ДанныеДляПечати.Вставить("КодПоОКПО"	, ДанныеДляПечати.КодПоОКПО);
	ДанныеДляПечати.Вставить("КодПоОКВЭД"	, ДанныеДляПечати.КодПоОКВЭД);
	
	ДанныеДляПечати.Вставить("СтруктураОргановУправления", Анкета.СтруктураОргановУправления);
	ДанныеДляПечати.Вставить("ПерсональныйСоставОргановУправления", Анкета.ПерсональныйСоставОргановУправления);
	ДанныеДляПечати.Вставить("Лицензии", Анкета.Лицензии);
	
	// Контактная информация
	ДанныеДляПечати.Вставить("ЮридическийАдрес",	Анкета.ЮридическийАдрес);
	ДанныеДляПечати.Вставить("ФактическийАдрес",	Анкета.ФактическийАдрес);
	ДанныеДляПечати.Вставить("ПочтовыйАдрес",		Анкета.ПочтовыйАдрес);
	ДанныеДляПечати.Вставить("Email",				Анкета.Email);
	ДанныеДляПечати.Вставить("Телефоны",			Анкета.Телефоны);
	ДанныеДляПечати.Вставить("ВебСтраница",			Анкета.ВебСтраница);
	

	// Для спец. депа
	Если ДанныеДляПечати.ЮридическийАдрес = ДанныеДляПечати.ПочтовыйАдрес Тогда
		ДанныеДляПечати.Вставить("ПочтовыйАдресСовпадаетСД", "V");
		ДанныеДляПечати.Вставить("ПочтовыйАдресСД", " ");
	Иначе
		ДанныеДляПечати.Вставить("ПочтовыйАдресСовпадаетСД", " ");
		ДанныеДляПечати.Вставить("ПочтовыйАдресСД", ДанныеДляПечати.ПочтовыйАдрес);
	КонецЕсли;
	
	СтруктураРеквизитов = Новый Структура("НомерСчета, ЛицевойСчет, ПолучательПлатежа, НаименованиеБанка, БИК, ИННПолучателя, КоррСчет, РасчетныйСчет");
	Если Анкета.БанковскиеРеквизиты.Количество() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов,  Анкета.БанковскиеРеквизиты[0]);
	КонецЕсли;
		
	ДанныеДляПечати.Вставить("РеквизитыПлатежа", ПолучитьБанковскиеРеквизиты(СтруктураРеквизитов));
	
	ДанныеДляПечати.ДатаЗаполнения = Формат(ДанныеДляПечати.ДатаЗаполнения, "ДФ='dd.MM.yyyy ''г.'''");
	
	ДанныеДляПечати.Вставить("ИсточникДенежныхСредств",	Анкета.ИсточникиПроисхожденияДенежныхСредств);
	ДанныеДляПечати.Вставить("БИК",	Анкета.БИК);
	
	Возврат Анкета;
	
КонецФункции

