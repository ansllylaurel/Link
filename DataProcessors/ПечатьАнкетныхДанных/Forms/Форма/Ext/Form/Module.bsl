	// Добавление страны в адрес
	// сделаем интеллектуально, будем добавлять слово "Россия", если его нет в адресе.
	Если ЗначениеЗаполнено(ДанныеДляПечати.АдресРегистрации) Тогда
		Если НЕ СтрНачинаетсяС(ВРег(ДанныеДляПечати.АдресРегистрации), "РОССИЯ") Тогда  
			ДанныеДляПечати.АдресРегистрации = "РОССИЯ, " + ДанныеДляПечати.АдресРегистрации;	
		КонецЕсли;
	КонецЕсли;	
	Если ЗначениеЗаполнено(ДанныеДляПечати.АдресМестаЖительства) Тогда
		Если НЕ СтрНачинаетсяС(ВРег(ДанныеДляПечати.АдресМестаЖительства), "РОССИЯ") Тогда  
			ДанныеДляПечати.АдресМестаЖительства = "РОССИЯ, " + ДанныеДляПечати.АдресМестаЖительства;	
		КонецЕсли;
	КонецЕсли;	
	
	Анкета		= Выборка.Анкета;
	
	ДанныеДляПечати.Вставить("ДатаАнкеты",			Выборка.ДатаЗаполнения);
	ДанныеДляПечати.Вставить("ТипФизическогоЛица",	?(ПустаяСтрока(Анкета.ОГРНИП), "Физическое лицо", "Индивидуальный предприниматель"));
	ДанныеДляПечати.Вставить("ФИО",					"" + ДанныеДляПечати.Фамилия + " " + ДанныеДляПечати.Имя + " " + ДанныеДляПечати.Отчество);
	
	Если ЗначениеЗаполнено(ДанныеДляПечати.ФамилияДо) Тогда
		ДанныеДляПечати.Вставить("ФИОДо", "" + ДанныеДляПечати.ФамилияДо + " " + ДанныеДляПечати.ИмяДо + " " + ДанныеДляПечати.ОтчествоДо);
	Иначе
		ДанныеДляПечати.Вставить("ФИОДо", "");
	КонецЕсли;
	
	Если Анкета.УпрощеннаяИдентификация Тогда
		ДанныеДляПечати.Вставить("УдостоверениеЛичности", 
			Строка(ДанныеДляПечати.ВидУдостоверенияЛичности)
			+ ", " + ДанныеДляПечати.СерияУдостоверенияЛичности
			+ " " + ДанныеДляПечати.НомерУдостоверенияЛичности
			);
	Иначе
		ДанныеДляПечати.Вставить("УдостоверениеЛичности", 
			Строка(ДанныеДляПечати.ВидУдостоверенияЛичности)
			+ ", " + ДанныеДляПечати.СерияУдостоверенияЛичности
			+ " " + ДанныеДляПечати.НомерУдостоверенияЛичности
			+ ", " + ДанныеДляПечати.ОрганВыдавшийУдостоверениеЛичности
			+ ", " + Формат(ДанныеДляПечати.ДатаВыдачиУдостоверенияЛичности, "ДФ=dd.MM.yyyy")
			+ ", " + ДанныеДляПечати.КодОрганаВыдавшегоУдостоверениеЛичности
			);
	КонецЕсли;
		
	ДанныеДляПечати.Вставить("СерияНомерУдостоверенияЛичности", 
		ДанныеДляПечати.СерияУдостоверенияЛичности 
		+ ?(ПустаяСтрока(ДанныеДляПечати.СерияУдостоверенияЛичности), "", " ")
		+ ДанныеДляПечати.НомерУдостоверенияЛичности);

	ДанныеДляПечати.Вставить("УдостоверениеЛичностиКемКогдаВыдан", 
		ДанныеДляПечати.ОрганВыдавшийУдостоверениеЛичности
		+ ", " + Формат(ДанныеДляПечати.ДатаВыдачиУдостоверенияЛичности, "ДФ=dd.MM.yyyy"));
		
	ДанныеДляПечати.Вставить("ОГРНИПОписание",
		ДанныеДляПечати.ОГРНИП
		+ ?(Не ЗначениеЗаполнено(ДанныеДляПечати.ДатаВыдачиОГРНИП), "", ", " + Формат(ДанныеДляПечати.ДатаВыдачиОГРНИП, "ДФ=dd.MM.yyyy"))
		+ ?(ПустаяСтрока(ДанныеДляПечати.ОрганВыдавшийОГРНИП), "", ", " + ДанныеДляПечати.ОрганВыдавшийОГРНИП)
		+ ?(ПустаяСтрока(ДанныеДляПечати.ОрганВыдавшийОГРНИП), "", ", " + ДанныеДляПечати.Анкета.АдресОрганаВыдавшегоОГРНИП));
		
	Если ДанныеДляПечати.ДатаАнкеты < Дата(2021, 11, 29) Тогда
		ДанныеДляПечати.Вставить("ДокументПодтвержденияПраваНаходитьсяВРФ", Анкета.ДокументПраваНаходитьсяВРФ);
	Иначе
		
		Если ЗначениеЗаполнено(Анкета.ДокументПраваНаходитьсяВРФ) Тогда
			ДанныеДляПечати.Вставить("ДокументПодтвержденияПраваНаходитьсяВРФ", Анкета.ДокументПраваНаходитьсяВРФ);
		Иначе
			ДанныеДляПечати.Вставить("ДокументПодтвержденияПраваНаходитьсяВРФ",	Анкета.МиграционнаяКарта);
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеДляПечати.Вставить("МиграционнаяКарта", 						Анкета.МиграционнаяКарта);
	ДанныеДляПечати.Вставить("ВидыДеятельности", 						Анкета.ВидыДеятельности);
	ДанныеДляПечати.Вставить("Лицензии", 								Анкета.Лицензии);
	ДанныеДляПечати.Вставить("ЦелиДеятельности",						Анкета.ЦелиДеятельности); 
	ДанныеДляПечати.Вставить("ИсточникДенежныхСредств",					Анкета.ИсточникиПроисхожденияДенежныхСредств);

	// Для спец. депа
	Если ДанныеДляПечати.АдресРегистрации = ДанныеДляПечати.ПочтовыйАдрес Тогда
		ДанныеДляПечати.Вставить("ПочтовыйАдресСовпадаетСД", "V");
		ДанныеДляПечати.Вставить("ПочтовыйАдресСД", " ");
	Иначе
		ДанныеДляПечати.Вставить("ПочтовыйАдресСовпадаетСД", " ");
		ДанныеДляПечати.Вставить("ПочтовыйАдресСД", ДанныеДляПечати.ПочтовыйАдрес);
	КонецЕсли;
	
	СтруктураРеквизитов = Новый Структура("НомерСчета, ЛицевойСчет, ПолучательПлатежа, НаименованиеБанка, БИК, ИННПолучателя, КоррСчет, РасчетныйСчет");
	Если Анкета.БанковскиеРеквизиты.Количество() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов,  Анкета.БанковскиеРеквизиты[0]);
	КонецЕсли;
		
	ДанныеДляПечати.Вставить("РеквизитыПлатежа", ПолучитьБанковскиеРеквизиты(СтруктураРеквизитов));
	
	ДанныеДляПечати.ДатаЗаполнения = Формат(ДанныеДляПечати.ДатаЗаполнения, "ДФ='dd.MM.yyyy ''г.'''");
	
	Если ЗначениеЗаполнено(ДанныеДляПечати.СпособУведомленияОбОперациях) Тогда
		
		ФлажкиСпособаУведомления = Новый Структура("Флажок1, Флажок2, Флажок3, Флажок4", Ложь, Ложь, Ложь, Ложь);
		
		Если ДанныеДляПечати.СпособУведомленияОбОперациях = Перечисления.СпособыУведомленияОбОперациях.УУправляющейКомпанииИлиАгента Тогда
			ФлажкиСпособаУведомления.Флажок1 = Истина;
		ИначеЕсли ДанныеДляПечати.СпособУведомленияОбОперациях = Перечисления.СпособыУведомленияОбОперациях.Почтой Тогда
			ФлажкиСпособаУведомления.Флажок2 = Истина;
		ИначеЕсли ДанныеДляПечати.СпособУведомленияОбОперациях = Перечисления.СпособыУведомленияОбОперациях.ЛичноУРегистратора Тогда	
			ФлажкиСпособаУведомления.Флажок3 = Истина;
		Иначе
			ФлажкиСпособаУведомления.Флажок4 = Истина;
		КонецЕсли;
			
		ДанныеДляПечати.Вставить("ФлажкиСпособаУведомления", ФлажкиСпособаУведомления);
		
	КонецЕсли;
	
	Возврат Анкета;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеОпросников(ДанныеДляПечати, Анкета)
	
	Опросники = Новый Структура;
	
	Отбор = Новый Структура("ВидУчастника", Перечисления.ВидыУчастниковАнкет.БенефициарныйВладелецУстановленныйКомпанией);
	БенефициарныеВладельцыУстановленныеКомпанией = Анкета.ПредставителиВыгодоприобретатели.Выгрузить(Отбор, "ЮрФизЛицо");
	
	БенефициарныйВладелецУстановленныйКомпанией = Документы.АнкетаЮридическогоЛица.ПолучитьПредставлениеБенефициарныхВладельцев(
		Анкета.Дата, 
		Анкета.Организация, 
		БенефициарныеВладельцыУстановленныеКомпанией);	
		
	ДанныеДляПечати.Вставить("БенефициарныйВладелецОбоснование", Анкета.БенефициарныйВладелецОбоснование);
	
	Если ТипЗнч(Анкета) = Тип("ДокументСсылка.АнкетаФизическогоЛица") Тогда
		
		Опросники.Вставить("ЯвляетсяНРРФ",		ДанныеДляПечати.РезидентРФ);
		Опросники.Вставить("НеЯвляетсяНРРФ",	Не ДанныеДляПечати.РезидентРФ);
		
		Опросники.Вставить("ЯвляетсяНРИГ",		ДанныеДляПечати.НалоговыйРезидентИностранногоГосударства);
		Опросники.Вставить("НеЯвляетсяНРИГ",	Не ДанныеДляПечати.НалоговыйРезидентИностранногоГосударства);
		
		Опросники.Вставить("ЯвляетсяРФЗ173",	ДанныеДляПечати.РезидентПо173ФЗ);
		Опросники.Вставить("НеЯвляетсяРФЗ173",	Не ДанныеДляПечати.РезидентПо173ФЗ);
		
		Опросники.Вставить("ЯвляетсяЛНСША",		ДанныеДляПечати.РаспространениеЗаконодательстваСША);
		Опросники.Вставить("НеЯвляетсяЛНСША",	Не ДанныеДляПечати.РаспространениеЗаконодательстваСША);
		
		Опросники.Вставить("ИностранныйН",		ДанныеДляПечати.ИностранныйНалогоплательщик);
		Опросники.Вставить("НеИностранныйН",	Не ДанныеДляПечати.ИностранныйНалогоплательщик);
		
		Опросники.Вставить("Согласие",		ДанныеДляПечати.СогласиеНаПередачуИнформации);
		Опросники.Вставить("НеСогласие",	Не ДанныеДляПечати.СогласиеНаПередачуИнформации);
		
		Опросники.Вставить("ЯвляетсяПДЛ",   Анкета.ЯвляетсяПубличнымДолжностнымЛицом);
		Опросники.Вставить("НеЯвляетсяПДЛ", Не Анкета.ЯвляетсяПубличнымДолжностнымЛицом);
		ДанныеДляПечати.Вставить("ЯвляетсяПДЛОписание", ?(ПустаяСтрока(Анкета.ЯвляетсяПубличнымДолжностнымЛицомОписание), "____________________", Анкета.ЯвляетсяПубличнымДолжностнымЛицомОписание));
		
		Опросники.Вставить("ЯвляетсяРодПДЛ",   Анкета.ЯвляетсяРодственникомПубличногоДолжностногоЛица);
		Опросники.Вставить("НеЯвляетсяРодПДЛ", Не Анкета.ЯвляетсяРодственникомПубличногоДолжностногоЛица);
		ДанныеДляПечати.Вставить("ЯвляетсяРодПДЛОписание", ?(ПустаяСтрока(Анкета.ЯвляетсяРодственникомПубличногоДолжностногоЛицаОписание), "____________________", Анкета.ЯвляетсяРодственникомПубличногоДолжностногоЛицаОписание));
		
		Опросники.Вставить("НаличиеСчетаФАТФ",   Анкета.НаличиеСчетаВГосударствахНеВыполняющихРекомендацииФАТФ);
		Опросники.Вставить("НеНаличиеСчетаФАТФ", Не Анкета.НаличиеСчетаВГосударствахНеВыполняющихРекомендацииФАТФ);
		ДанныеДляПечати.Вставить("НаличиеСчетаФАТФОписание", ?(ПустаяСтрока(Анкета.НаличиеСчетаВГосударствахНеВыполняющихРекомендацииФАТФОписание), " ", Анкета.НаличиеСчетаВГосударствахНеВыполняющихРекомендацииФАТФОписание));
		
		Опросники.Вставить("ПоложительноеФП",   Анкета.ПоложительноеФинансовоеПоложение);
		Опросники.Вставить("НеПоложительноеФП", Не Анкета.ПоложительноеФинансовоеПоложение);

		Опросники.Вставить("ПоложительнаяДР",   Анкета.ДеловаяРепутацияПоложительная);
		Опросники.Вставить("НеПоложительнаяДР", Не Анкета.ДеловаяРепутацияПоложительная);
		ДанныеДляПечати.Вставить("ПоложительнаяДРОписание", ?(ПустаяСтрока(Анкета.ДеловаяРепутацияОписание), "_________________", Анкета.ДеловаяРепутацияОписание));
		
		Опросники.Вставить("КлиентВыгод",   Анкета.ВыгодоприобретательКлиент);
		Опросники.Вставить("НеКлиентВыгод", Не Анкета.ВыгодоприобретательКлиент);

		Опросники.Вставить("КлиентБенеф",   Анкета.БенефициарныйВладелецКлиент);
		Опросники.Вставить("НеКлиентБенеф", Не Анкета.БенефициарныйВладелецКлиент);

		Опросники.Вставить("ЦельПриобретениеПаев", Анкета.ЦельПриобретениеПаев);
		Опросники.Вставить("ЦельДоверительноеУпр", Анкета.ЦельДоверительноеУправление);
		Опросники.Вставить("ЦельДругое",           Анкета.ЦельДругое);
		ДанныеДляПечати.Вставить("ЦельДругоеОписание", ?(ПустаяСтрока(Анкета.ЦельДругоеОписание), "___________", Анкета.ЦельДругоеОписание));
		
		ДанныеДляПечати.Вставить("СогласиеОПДПИФ", Анкета.ЦельПриобретениеПаев);
		ДанныеДляПечати.Вставить("СогласиеОПДПрочее", Анкета.ЦельДоверительноеУправление или Анкета.ЦельДругое);
		
		Опросники.Вставить("ФлагКлиент"				,   ВариантАнкеты = ПредопределенноеЗначение("Перечисление.ВидыУчастниковАнкет.ПустаяСсылка"));
		Опросники.Вставить("ФлагВыгодоприобретатель",   ВариантАнкеты = ПредопределенноеЗначение("Перечисление.ВидыУчастниковАнкет.Выгодоприобретатель"));
		Опросники.Вставить("ФлагКонтролирующееЛицо"	,  Ложь);
		
		Если ПустаяСтрока(БенефициарныйВладелецУстановленныйКомпанией) И Анкета.БенефициарныйВладелецКлиент Тогда
		
			БенефициарныйВладелецУстановленныйКомпанией = ДанныеДляПечати.ФИО;
		
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Анкета) = Тип("ДокументСсылка.АнкетаЮридическогоЛица") Тогда
		
		Опросники.Вставить("НаличиеСчетаФАТФ",   Анкета.НаличиеСчетаВГосударствахНеВыполняющихРекомендацииФАТФ);
		Опросники.Вставить("НеНаличиеСчетаФАТФ", Не Анкета.НаличиеСчетаВГосударствахНеВыполняющихРекомендацииФАТФ);
		ДанныеДляПечати.Вставить("НаличиеСчетаФАТФОписание", ?(ПустаяСтрока(Анкета.НаличиеСчетаВГосударствахНеВыполняющихРекомендацииФАТФОписание), " ", Анкета.НаличиеСчетаВГосударствахНеВыполняющихРекомендацииФАТФОписание));
		
		Опросники.Вставить("ПоложительноеФП",   Анкета.ПоложительноеФинансовоеПоложение);
		Опросники.Вставить("НеПоложительноеФП", Не Анкета.ПоложительноеФинансовоеПоложение);
		
		Опросники.Вставить("ПоложительнаяДР",   Анкета.ДеловаяРепутацияПоложительная);
		Опросники.Вставить("НеПоложительнаяДР", Не Анкета.ДеловаяРепутацияПоложительная);
		ДанныеДляПечати.Вставить("ПоложительнаяДРОписание", ?(Не Анкета.ДеловаяРепутацияПоложительная или ПустаяСтрока(Анкета.ДеловаяРепутацияОписание), "_________________", Анкета.ДеловаяРепутацияОписание));
		ДанныеДляПечати.Вставить("ОтрицательнаяДРОписание", ?(Анкета.ДеловаяРепутацияПоложительная или ПустаяСтрока(Анкета.ДеловаяРепутацияОписание), "_________________", Анкета.ДеловаяРепутацияОписание));
		
		Опросники.Вставить("КоммерческаяДеят",   Анкета.ЦелиДеятельности = "Коммерческая");
		Опросники.Вставить("НеКоммерческаяДеят", Анкета.ЦелиДеятельности = "Некоммерческая");
		Опросники.Вставить("ДругаяДеят",         Анкета.ЦелиДеятельности = "Другое");
		ДанныеДляПечати.Вставить("ЦелиДеятельностиОписание", ?(ПустаяСтрока(Анкета.ЦелиДеятельностиОписание), "__________", Анкета.ЦелиДеятельностиОписание));
		
		Опросники.Вставить("КлиентВыгод",   Анкета.ВыгодоприобретательКлиент);
		Опросники.Вставить("НеКлиентВыгод", Не Анкета.ВыгодоприобретательКлиент);

		Опросники.Вставить("КлиентВыгод",   Анкета.ВыгодоприобретательКлиент);
		Опросники.Вставить("НеКлиентВыгод", Не Анкета.ВыгодоприобретательКлиент);

		Опросники.Вставить("ЦельПриобретениеПаев", Анкета.ЦельПриобретениеПаев);
		Опросники.Вставить("ЦельУправлениеННПФ",   Анкета.ЦельДоверительноеУправлениеНакоплениямиНПФ);
		Опросники.Вставить("ЦельУправлениеРНПФ",   Анкета.ЦельДоверительноеУправлениеРезервамиНПФ);
		Опросники.Вставить("ЦельДоверительноеУпр", Анкета.ЦельДоверительноеУправление);
		Опросники.Вставить("ЦельДругое",           Анкета.ЦельДругое);
		ДанныеДляПечати.Вставить("ЦельДругоеОписание", ?(ПустаяСтрока(Анкета.ЦельДругоеОписание), "___________", Анкета.ЦельДругоеОписание));
		
		ДанныеДляПечати.Вставить("СогласиеОПДПИФ", Анкета.ЦельПриобретениеПаев);
		ДанныеДляПечати.Вставить("СогласиеОПДПрочее", 
			Анкета.ЦельДоверительноеУправление 
			Или Анкета.ЦельДругое 
			Или Анкета.ЦельДоверительноеУправлениеНакоплениямиНПФ 
			Или Анкета.ЦельДоверительноеУправлениеРезервамиНПФ);
		
		Опросники.Вставить("БенефицВлФИО", Анкета.БенефициарныйВладелец = Перечисления.ВариантыСведенийОБенефициарныхВладельцах.Установлен);
		Опросники.Вставить("БенефицВлОтсутствует", Анкета.БенефициарныйВладелец = Перечисления.ВариантыСведенийОБенефициарныхВладельцах.Отсутствует);
		Опросники.Вставить("БенефицВлНеУст", Анкета.БенефициарныйВладелец = Перечисления.ВариантыСведенийОБенефициарныхВладельцах.НеУстановлен);
		
		ДанныеДляПечати.Вставить("БенефициарныйВладелецФИО", " ");
		ДанныеДляПечати.Вставить("БенефициарныйВладелецОтсутствует", " ");
		ДанныеДляПечати.Вставить("БенефициарныйВладелецНеУстановлен", " ");
		
		Если Анкета.БенефициарныйВладелец = Перечисления.ВариантыСведенийОБенефициарныхВладельцах.Установлен Тогда
		
			Отбор = Новый Структура("ВидУчастника", Перечисления.ВидыУчастниковАнкет.БенефициарныйВладелец);
			БенефициарныеВладельцы = Анкета.ПредставителиВыгодоприобретатели.Выгрузить(Отбор, "ЮрФизЛицо");

			БенефициарныйВладелецФИО = Документы.АнкетаЮридическогоЛица.ПолучитьПредставлениеБенефициарныхВладельцев(
				Анкета.Дата, 
				Анкета.Организация, 
				БенефициарныеВладельцы); 
			
			ДанныеДляПечати.Вставить("БенефициарныйВладелецФИО", БенефициарныйВладелецФИО);
			
			Если ПустаяСтрока(БенефициарныйВладелецУстановленныйКомпанией) Тогда
			
				БенефициарныйВладелецУстановленныйКомпанией = БенефициарныйВладелецФИО;
			
			КонецЕсли;
			
		ИначеЕсли Анкета.БенефициарныйВладелец = Перечисления.ВариантыСведенийОБенефициарныхВладельцах.Отсутствует Тогда
			
			ДанныеДляПечати.Вставить("БенефициарныйВладелецОтсутствует", Анкета.БенефициарныйВладелецКомментарий);
			
		ИначеЕсли Анкета.БенефициарныйВладелец = Перечисления.ВариантыСведенийОБенефициарныхВладельцах.НеУстановлен Тогда
			
			ДанныеДляПечати.Вставить("БенефициарныйВладелецНеУстановлен", Анкета.БенефициарныйВладелецКомментарий);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеДляПечати.Вставить("БенефициарныйВладелецУстановленныйКомпанией", БенефициарныйВладелецУстановленныйКомпанией);
	ДанныеДляПечати.Вставить("Опросники", Опросники);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьБанковскиеРеквизиты(СтруктураРеквизитов)
	
	ДанныеДляПечатиБанковскихРеквизитов = Новый Структура;
		
	ДанныеДляПечатиБанковскихРеквизитов.Вставить("БанковскиеРеквизиты",
		СокрЛП(СтруктураРеквизитов.ПолучательПлатежа) 
		+ ", " + СокрЛП(СтруктураРеквизитов.НаименованиеБанка)	
		+ ", БИК " + СокрЛП(СтруктураРеквизитов.БИК)	
		+ ", ИНН " + СокрЛП(СтруктураРеквизитов.ИННПолучателя)	
		+ ", к/с " + СокрЛП(СтруктураРеквизитов.КоррСчет)	
		+ ", р/с " + СокрЛП(СтруктураРеквизитов.РасчетныйСчет)
		+ ?(ЗначениеЗаполнено(СтруктураРеквизитов.ЛицевойСчет), ", л/с " + СокрЛП(СтруктураРеквизитов.ЛицевойСчет), ""));	
	
	ДанныеДляПечатиБанковскихРеквизитов.Вставить("НаименованиеПолучателя", СокрЛП(СтруктураРеквизитов.ПолучательПлатежа));
	ДанныеДляПечатиБанковскихРеквизитов.Вставить("НаименованиеБанка",      СокрЛП(СтруктураРеквизитов.НаименованиеБанка));
	ДанныеДляПечатиБанковскихРеквизитов.Вставить("НомерСчета",             СокрЛП(СтруктураРеквизитов.НомерСчета));
	ДанныеДляПечатиБанковскихРеквизитов.Вставить("ЛицевойСчет",            СокрЛП(СтруктураРеквизитов.ЛицевойСчет));
	ДанныеДляПечатиБанковскихРеквизитов.Вставить("БИК",                    СокрЛП(СтруктураРеквизитов.БИК));
	ДанныеДляПечатиБанковскихРеквизитов.Вставить("КоррСчет",               СокрЛП(СтруктураРеквизитов.КоррСчет));
	
	ДанныеДляПечатиБанковскихРеквизитов.Вставить("ГородБанка", "");
	ДанныеДляПечатиБанковскихРеквизитов.Вставить("ИННБанка",   "");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Банки.Город КАК ГородБанка,
	|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИННБанка
	|ИЗ
	|	Справочник.Банки КАК Банки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
	|				,
	|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
	|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
	|		ПО Банки.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
	|ГДЕ
	|	Банки.Код = &БИК");
	
	Запрос.УстановитьПараметр("БИК", СтруктураРеквизитов.БИК);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеДляПечатиБанковскихРеквизитов, Выборка);	
	КонецЕсли;

	Возврат ДанныеДляПечатиБанковскихРеквизитов;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеОрганизации(ДанныеДляПечати)
	
	Организация = ПараметрыСеанса.ТекущаяОрганизация;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
	|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу
	|ИЗ
	|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
	|			&Период,
	|			Подразделение = &Подразделение
	|				И Язык = &Язык
	|				И ЮрФизЛицо = &ЮрФизЛицо) КАК РеквизитыЮридическихЛицСрезПоследних");
	
	Запрос.УстановитьПараметр("Период",        Период);
	Запрос.УстановитьПараметр("ЮрФизЛицо",     Организация.ЮрФизЛицо);
	Запрос.УстановитьПараметр("Подразделение", Справочники.Подразделения.ГруппаКомпаний);
	Запрос.УстановитьПараметр("Язык", 		   Справочники.Языки.Русский);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДанныеДляПечати.Вставить("КраткоеНаименованиеУК", Выборка.КраткоеНаименованиеПоУставу);		
		ДанныеДляПечати.Вставить("НаименованиеУправляющейКомпании", Выборка.ПолноеНаименованиеПоУставу);		
		ДанныеДляПечати.Вставить("НаименованиеУправляющейКомпанииВДательномПадеже", ОрганизационноПравоваяФормаВДательномПадеже(Выборка.ПолноеНаименованиеПоУставу));		
		ДанныеДляПечати.Вставить("НаименованиеУправляющейКомпанииВРодительномПадеже", ОрганизационноПравоваяФормаВРодительномПадеже(Выборка.ПолноеНаименованиеПоУставу));		
	КонецЕсли;

	ЗапросКонтактнойИнформации = ПолучитьЗапросКонтактнойИнформации(Организация.ЮрФизЛицо);

	ЗапросКонтактнойИнформации.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.ЮридическийАдрес);
	ВставитьКонтактнуюИнформацию(ЗапросКонтактнойИнформации, ДанныеДляПечати, "ЮридическийАдресУправляющейКомпании");

КонецПроцедуры

&НаСервере
Функция ПолучитьЗапросКонтактнойИнформации(ЮрФизЛицоДляПечати)
	
	ЗапросКонтактнойИнформации = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтактнаяИнформацияСрезПоследних.Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация.СрезПоследних(
	|			,
	|			Объект = &ЮрФизЛицо
	|				И Подразделение = &Подразделение
	|				И Язык = &Язык
	|				И Вид = &Вид) КАК КонтактнаяИнформацияСрезПоследних");
	
	ЗапросКонтактнойИнформации.УстановитьПараметр("ЮрФизЛицо", ЮрФизЛицоДляПечати);        
	ЗапросКонтактнойИнформации.УстановитьПараметр("Подразделение", Справочники.Подразделения.ГруппаКомпаний);        
	ЗапросКонтактнойИнформации.УстановитьПараметр("Язык", Справочники.Языки.Русский);

	Возврат ЗапросКонтактнойИнформации;
	
КонецФункции

&НаСервере
Процедура ВставитьКонтактнуюИнформацию(Запрос, ДанныеДляПечати, Ключ)
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДанныеДляПечати.Вставить(Ключ, Выборка.Представление);
	Иначе
		ДанныеДляПечати.Вставить(Ключ);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПодписантаИзКонтактныхЛицНаСервере()
	
	ТекстПодписант = "____________";
	
	Если ЗначениеЗаполнено(Подписант) Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыСотрудниковОрганизации.Фамилия КАК Фамилия,
		|	РеквизитыСотрудниковОрганизации.Имя КАК Имя,
		|	РеквизитыСотрудниковОрганизации.Отчество КАК Отчество,
		|	КонтактныеЛица.Должность КАК Должность,
		|	КонтактныеЛица.ОснованиеПолномочий КАК ОснованиеПолномочий
		|ИЗ
		|	РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Язык = &Язык
		|				И ЮрФизЛицо = &Подписант) КАК РеквизитыСотрудниковОрганизации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|		ПО (КонтактныеЛица.КонтактноеЛицо = РеквизитыСотрудниковОрганизации.ЮрФизЛицо)
		|			И (КонтактныеЛица.Подразделение = &Подразделение)
		|			И (КонтактныеЛица.Язык = &Язык)
		|			И (КонтактныеЛица.Объект = &Организация)");
		
		Запрос.УстановитьПараметр("Период",        ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("Организация",   ПараметрыСеанса.ТекущаяОрганизация.ЮрФизЛицо);
		Запрос.УстановитьПараметр("Подписант", 	   Подписант);
		Запрос.УстановитьПараметр("Подразделение", Справочники.Подразделения.ГруппаКомпаний);
		Запрос.УстановитьПараметр("Язык",          Справочники.Языки.Русский);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			ТекстПодписант = СокрЛП(Выборка.Должность)
							+ " " + Выборка.Фамилия
							+ Символы.НПП + Лев(Выборка.Имя, 1) + "."
							+ ?(ЗначениеЗаполнено(Выборка.Отчество), Символы.НПП + Лев(Выборка.Отчество, 1) + ".", "");
							
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТекстПодписант;
	
КонецФункции

&НаСервере
Функция ПолучитьПодписантаНаСервере()
	
	ТекстПодписант = "				";
	
	Если ЗначениеЗаполнено(Подписант) Тогда
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	РеквизитыСотрудниковОрганизацииСрезПоследних.Фамилия КАК Фамилия,
			|	РеквизитыСотрудниковОрганизацииСрезПоследних.Имя КАК Имя,
			|	РеквизитыСотрудниковОрганизацииСрезПоследних.Отчество КАК Отчество
			|ИЗ
			|	РегистрСведений.СотрудникиОрганизации.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И Сотрудник.ЮрФизЛицо = &Подписант) КАК СотрудникиОрганизацииСрезПоследних
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И ЮрФизЛицо = &Подписант
			|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыСотрудниковОрганизацииСрезПоследних
			|		ПО (СотрудникиОрганизацииСрезПоследних.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение))
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия,
			|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя,
			|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество
			|ИЗ
			|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И ЮрФизЛицо = &Подписант
			|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних");
		
		Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("Организация", ПараметрыСеанса.ТекущаяОрганизация);
		Запрос.УстановитьПараметр("Подписант", Подписант);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			ТекстПодписант = Выборка.Фамилия + Символы.НПП + Лев(Выборка.Имя, 1) + "."
				+ ?(ЗначениеЗаполнено(Выборка.Отчество), Символы.НПП + Лев(Выборка.Отчество, 1) + ".", "");
							
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТекстПодписант;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеПредставителей(ДанныеДляПечати, Анкета)
	
	ВставитьДанныеПодписанта(ДанныеДляПечати, 1);
	ВставитьДанныеПодписанта(ДанныеДляПечати, 2);
	
	СчФизЛиц = 0;
	Представитель = Неопределено;
	
	Если ТипЗнч(Анкета) = Тип("ДокументСсылка.АнкетаФизическогоЛица") Тогда
		ЭтоАнкетаФизЛица    = Истина;
		ПолеСтатусДолжность = "СтатусПредставителя";
	Иначе
		ЭтоАнкетаФизЛица    = Ложь;
		ПолеСтатусДолжность = "Должность";
	КонецЕсли;
	
	Для каждого СтрокаТабЧасти из Анкета.ПредставителиВыгодоприобретатели Цикл
		
		Если СтрокаТабЧасти.ВидУчастника <> Перечисления.ВидыУчастниковАнкет.Представитель Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТабЧасти.ЮрФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
			
			СчФизЛиц = СчФизЛиц + 1;
			
			ДанныеФизЛица = Новый Структура;
			ЗаполнитьДанныеДляПечатиФизЛица(ДанныеФизЛица, СтрокаТабЧасти.ЮрФизЛицо);
			
			ВставитьДанныеПодписанта(ДанныеДляПечати, СчФизЛиц, ДанныеФизЛица, СтрокаТабЧасти[ПолеСтатусДолжность], СтрокаТабЧасти.ОснованиеПолномочий);
			
			Если ЭтоАнкетаФизЛица и Представитель = Неопределено Тогда
				
				Представитель = СтрокаТабЧасти.ЮрФизЛицо;
				
				Для каждого КлючИЗнач из ДанныеФизЛица Цикл
					ДанныеДляПечати.Вставить(КлючИЗнач.Ключ + "Представитель", КлючИЗнач.Значение);	
				КонецЦикла;
				
			КонецЕсли;
			
		ИначеЕсли СтрокаТабЧасти.ЮрФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
			
			Если Не ЭтоАнкетаФизЛица и Представитель = Неопределено Тогда
				
				Представитель = СтрокаТабЧасти.ЮрФизЛицо;
				
				ДанныеЮрЛица = Новый Структура;
				ЗаполнитьДанныеДляПечатиЮрЛица(ДанныеЮрЛица, СтрокаТабЧасти.ЮрФизЛицо);
				
				Для каждого КлючИЗнач из ДанныеЮрЛица Цикл
					ДанныеДляПечати.Вставить(КлючИЗнач.Ключ + "Представитель", КлючИЗнач.Значение);	
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Представитель = Неопределено Тогда
		
		Если ЭтоАнкетаФизЛица Тогда
			
			ДанныеДляПечати.Вставить("ФИОПредставитель");
			ДанныеДляПечати.Вставить("ВидУдостоверенияЛичностиПредставитель"); 
			ДанныеДляПечати.Вставить("СерияУдостоверенияЛичностиПредставитель"); 
			ДанныеДляПечати.Вставить("НомерУдостоверенияЛичностиПредставитель"); 
			ДанныеДляПечати.Вставить("ДатаВыдачиУдостоверенияЛичностиПредставитель");
			ДанныеДляПечати.Вставить("ОрганВыдавшийУдостоверениеЛичностиПредставитель");
			
		Иначе
			
			ДанныеДляПечати.Вставить("ПолноеНаименованиеПоУставуПредставитель");
			ДанныеДляПечати.Вставить("СокращенноеНаименованиеПоУставуПредставитель");
			ДанныеДляПечати.Вставить("КПППредставитель");
			ДанныеДляПечати.Вставить("ИННПредставитель");
			ДанныеДляПечати.Вставить("СтранаРегистрацииПредставитель");
			ДанныеДляПечати.Вставить("ОГРНПосле2002Представитель");
			ДанныеДляПечати.Вставить("ДатаВыдачиОГРНПосле2002Представитель");
			ДанныеДляПечати.Вставить("ОрганВыдавшийОГРНПосле2002Представитель");
			ДанныеДляПечати.Вставить("ОГРНДо2002Представитель");
			ДанныеДляПечати.Вставить("ДатаВыдачиОГРНДо2002Представитель");
			ДанныеДляПечати.Вставить("ОрганВыдавшийОГРНДо2002Представитель");
			ДанныеДляПечати.Вставить("ТелефоныПредставитель");
			ДанныеДляПечати.Вставить("EMailПредставитель");
			ДанныеДляПечати.Вставить("ЮридическийАдресПредставитель");
			ДанныеДляПечати.Вставить("ПочтовыйАдресСовпадаетСДПредставитель", " ");
			ДанныеДляПечати.Вставить("ПочтовыйАдресСДПредставитель", " ");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВставитьДанныеПодписанта(ДанныеДляПечати, НомерЛица, ДанныеПодписанта = Неопределено, СтатусДолжность = Неопределено, ОснованиеПолномочий = Неопределено)
	
	НомерЛицаСтрока = Формат(НомерЛица, "ЧН=0; ЧГ=0");
	
	Если ДанныеПодписанта = Неопределено Тогда
		ДанныеДляПечати.Вставить("ВЛице" + НомерЛицаСтрока);	
		ДанныеДляПечати.Вставить("УдостоверениеЛичностиВЛице" + НомерЛицаСтрока);	
		ДанныеДляПечати.Вставить("ДолжностьСтатус" + НомерЛицаСтрока);	
		ДанныеДляПечати.Вставить("ОснованиеПолномочий" + НомерЛицаСтрока);
	Иначе
		ДанныеДляПечати.Вставить("ВЛице" + НомерЛицаСтрока, 					   ДанныеПодписанта.ФИО);	
		ДанныеДляПечати.Вставить("УдостоверениеЛичностиВЛице" + НомерЛицаСтрока, ДанныеПодписанта.УдостоверениеЛичности);	
		ДанныеДляПечати.Вставить("ДолжностьСтатус" + НомерЛицаСтрока, 		   СтатусДолжность);	
		ДанныеДляПечати.Вставить("ОснованиеПолномочий" + НомерЛицаСтрока, 	   ОснованиеПолномочий);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПустыеПараметры(ДанныеДляПечати)
	
	Для каждого КлючИЗнач из ДанныеДляПечати Цикл
		
		Если ТипЗнч(КлючИЗнач.Значение) = Тип("ТаблицаЗначений") Тогда
			Продолжить;
		ИначеЕсли ТипЗнч(КлючИЗнач.Значение) = Тип("Структура") Тогда
			ЗаполнитьПустыеПараметры(КлючИЗнач.Значение);
			Продолжить;
		ИначеЕсли КлючИЗнач.Значение = " " ИЛИ КлючИЗнач.Значение = "				" Тогда
			Продолжить;
		ИначеЕсли Найти(КлючИЗнач.Значение, "УпрощеннаяИдентификация") Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(КлючИЗнач.Значение) Тогда
			ДанныеДляПечати.Вставить(КлючИЗнач.Ключ, "–"); // Здесь "длинное" тире. Скопировано из Word.
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

