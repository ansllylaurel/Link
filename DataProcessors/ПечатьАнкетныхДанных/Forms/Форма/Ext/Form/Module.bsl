		УдалитьФайлы(ПутьКФайлу);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыWord(ДокументWord, СтруктураРеквизитов, ОбновлятьПоля = Истина, ИмяШаблона = "")
	
	WordVars = ДокументWord.Variables;
	Для каждого КлючИЗнач из СтруктураРеквизитов Цикл
		Если КлючИЗнач.Ключ = "Таблицы" И (ИмяШаблона = "ТретьяЧастьАнкеты" Или ИмяШаблона = "ВтораяЧастьАнкеты") Тогда
			Для каждого КлючИзначТаб из КлючИЗнач.Значение Цикл
				ЗаполнитьТаблицуWord(ДокументWord.Tables(КлючИзначТаб.Ключ), КлючИзначТаб.Значение)	
			КонецЦикла;
		ИначеЕсли КлючИЗнач.Ключ = "Опросники" Или КлючИЗнач.Ключ = "ФлажкиСпособаУведомления" Тогда
			ЗаполнитьПризнакиДокумента(ДокументWord, КлючИЗнач.Значение);
		ИначеЕсли ТипЗнч(КлючИЗнач.Значение) = Тип("Структура") Тогда
			ЗаполнитьПараметрыWord(ДокументWord, КлючИЗнач.Значение, Ложь);
		Иначе
			Переменная = WordVars.Item(КлючИЗнач.Ключ);
			Попытка
				Переменная.Value = Формат(КлючИЗнач.Значение, "ДФ=dd.MM.yyyy");
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	Если ОбновлятьПоля Тогда
		ДокументWord.Fields.Update();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПризнакиДокумента(ДокументWord, СтруктураПризнаков)
	
	Для каждого КлючИЗнач из СтруктураПризнаков Цикл
		Попытка
			Field = ДокументWord.FormFields.Item(КлючИЗнач.Ключ);
			Field.CheckBox.Value = КлючИЗнач.Значение;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Для НомерЭлементаУправления = 1 По ДокументWord.ContentControls.Count Цикл
		ЭлементУправления = ДокументWord.ContentControls.Item(НомерЭлементаУправления);
		Если ЗначениеЗаполнено(ЭлементУправления.Tag) Тогда
			Если СтруктураПризнаков.Свойство(ЭлементУправления.Tag) Тогда
				ЭлементУправления.Checked = СтруктураПризнаков[ЭлементУправления.Tag];
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
Конецпроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуWord(ТаблицаWord, МассивСтруктур)
	
	КоличествоСтрок = ТаблицаWord.Rows.Count;
	Для каждого Структура из МассивСтруктур Цикл
		
		Если КоличествоСтрок < Структура.Строка Тогда
			Для Сч = 1 По Структура.Строка - КоличествоСтрок Цикл
				ТаблицаWord.Rows.Add();	
			КонецЦикла;
			КоличествоСтрок = Структура.Строка;
		КонецЕсли;
		
		Ячейка = ТаблицаWord.Cell(Структура.Строка, Структура.Колонка);
		Попытка
			Ячейка.Range.InsertAfter(Структура.Значение);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТретьяЧастьАнкетыПриИзменении(Элемент)
	
	Элементы.ПериодСверокСоСписками.Видимость = ЭтаФорма.ТретьяЧастьАнкеты;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантПриИзменении(Элемент)
	
	ЗаполнитьДолжностьПодписантаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДолжностьПодписантаНаСервере()

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СотрудникиОрганизации.Должность КАК Должность
		|ИЗ
		|	(ВЫБРАТЬ
		|		МАКСИМУМ(СотрудникиОрганизации.Период) КАК Период,
		|		СотрудникиОрганизации.Организация КАК Организация,
		|		СотрудникиОрганизации.Сотрудник КАК Сотрудник
		|	ИЗ
		|		РегистрСведений.СотрудникиОрганизации КАК СотрудникиОрганизации
		|	ГДЕ
		|		СотрудникиОрганизации.Период <= &Период
		|		И СотрудникиОрганизации.Организация = &Организация
		|		И СотрудникиОрганизации.Сотрудник.ЮрФизЛицо = &Подписант
		|	
		|	СГРУППИРОВАТЬ ПО
		|		СотрудникиОрганизации.Организация,
		|		СотрудникиОрганизации.Сотрудник) КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации КАК СотрудникиОрганизации
		|		ПО ВложенныйЗапрос.Период = СотрудникиОрганизации.Период
		|			И ВложенныйЗапрос.Организация = СотрудникиОрганизации.Организация
		|			И ВложенныйЗапрос.Сотрудник = СотрудникиОрганизации.Сотрудник
		|			И (СотрудникиОрганизации.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение))";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Организация", ПараметрыСеанса.ТекущаяОрганизация);
	Запрос.УстановитьПараметр("Подписант", ЭтаФорма.Подписант);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Элементы.Должность.СписокВыбора.Очистить();
	ЭтаФорма.Должность = Неопределено;
	
	Пока Выборка.Следующий() Цикл
	
		Элементы.Должность.СписокВыбора.Добавить(Выборка.Должность);
	
	КонецЦикла;
	
	Если Выборка.Количество() = 1 Тогда
	
		ЭтаФорма.Должность = Элементы.Должность.СписокВыбора[0].Значение;
	
	КонецЕсли;
	
КонецПроцедуры