&НаСервере
Функция ПолучитьИсточникОшибки(ИмяОбъекта, Вид)
	Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ДополнительныеОтчетыИОбработки.Ссылка
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
		|ГДЕ
		|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОбъекта
		|	И ДополнительныеОтчетыИОбработки.Вид = &Вид
		|	И ДополнительныеОтчетыИОбработки.ПометкаУдаления = ЛОЖЬ
		|");
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъекта);
	Запрос.УстановитьПараметр("Вид",        Вид);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка; 	
	КонецЕсли;	
	
	Возврат Неопределено;	
КонецФункции

&НаКлиенте
Процедура ПриЗакрытииДочернегоОкна(Параметр, ДополнительныеПараметры) Экспорт
	
	ЗаполнитьПаевыеИнвестиционныеФонды();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если Не (ЭтаФорма.ЭтоПодтверждениеСЧА Или ЭтаФорма.ВыгрузкаЗаПериод) Тогда
	
		НайденныеСтроки = Объект.ПаевыеИнвестиционныеФонды.НайтиСтроки(Новый Структура("Выбран, Подтверждена", Истина, Ложь));
		
		Для каждого СтрокаНайденныеСтроки Из НайденныеСтроки Цикл
			
			ТекстОшиибки = СтрШаблон("СЧА по '%1' не подтверждена", СтрокаНайденныеСтроки.СчетДоверительногоУправления);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшиибки,,,, Отказ);
		
		КонецЦикла; 		
	
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьИнформациюССайта()

	Попытка
	
		Если ЭтаФорма.ВыгрузкаЗаПериод Тогда
			Возврат;
		КонецЕсли; 
		
		Обработки.ОтправкаДанныхПИФНаСайт.ПолучитьИнформациюССайта(Объект.Организация, Объект.КонецПериода, Объект.ПаевыеИнвестиционныеФонды);
		
	Исключение
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить данные с сайта");
	      
	КонецПопытки; 
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьЗаписьАсинхронногоОбмена(ОписаниеФайла, Результат)

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(ОписаниеФайла.АдресВХранилище);
	ЧтениеДанных = Новый ЧтениеДанных(ДвоичныеДанные);
	ЧтениеТекста = Новый ЧтениеТекста(ЧтениеДанных.ИсходныйПоток());
	ТекстЗапроса = ЧтениеТекста.Прочитать();
	
	Запись = РегистрыСведений.АсинхронныйОбменДанными.СоздатьМенеджерЗаписи();
	Запись.ВнешняяСистема = Справочники.ВнешниеСистемы.СайтГКРегион;
	Запись.УникальныйИдентификатор = ОписаниеФайла.ИдентификаторОбменаДанными;	
	Запись.ТипПакета = Справочники.ГруппыИмпортируемыхОбъектов.ИмпортДанныхПИФ;
	Запись.ТекстЗапроса = Новый ХранилищеЗначения(ТекстЗапроса, Новый СжатиеДанных(9));
	Запись.ТекстОтвета = Новый ХранилищеЗначения(Результат.ПолучитьТелоКакСтроку(), Новый СжатиеДанных(9));
	Запись.КодСостояния = Результат.КодСостояния;
	Запись.ДатаЗапроса = ТекущаяДатаСеанса();
	Запись.СтатусОтвета = ?(Результат.КодСостояния >= 300, Перечисления.СтатусыОтветаАсинхронногоОбменаДанными.Ошибка, Перечисления.СтатусыОтветаАсинхронногоОбменаДанными.Исполнено);
	Запись.Пользователь = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущийПользователь");
	Запись.Записать();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьСоединениеНаСервере(ПараметрыПодключения)

	ИмяВременногоФайла = КаталогВременныхФайлов() + "CheckUploadSCP.txt";
	ЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла);
	ЗаписьТекста.Записать(Формат(ТекущаяДата(), "ДЛФ=DT"));
	ЗаписьТекста.Закрыть();
	
	session = ОткрытьСессию(ПараметрыПодключения);
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Соединение установлено успешно");
	
	// Выгружаем файлы
	Если Не СтрНачинаетсяС(ПараметрыПодключения.ТекущийКаталог, "/") Тогда
		ПараметрыПодключения.ТекущийКаталог = "/" + ПараметрыПодключения.ТекущийКаталог;
	КонецЕсли; 
	Если Не СтрЗаканчиваетсяНа(ПараметрыПодключения.ТекущийКаталог, "/") Тогда
		ПараметрыПодключения.ТекущийКаталог = ПараметрыПодключения.ТекущийКаталог + "/";
	КонецЕсли; 

	transferOptions = Новый COMОбъект("WinSCP.transferOptions");
	transferOptions.PreserveTimestamp = false;
	transferResult = session.PutFiles(ИмяВременногоФайла, ПараметрыПодключения.ТекущийКаталог, false, transferOptions);
	// Проверяем результат на возможные ошибки
	transferResult.Check();
	
	session.Close();
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл выгружен успешно");
	
	УдалитьФайлы(ИмяВременногоФайла);

КонецПроцедуры
 
#КонецОбласти 

#Область Параметры_подключения

&НаКлиенте
Процедура ПеречитатьПараметрыПодключения(Команда)
	
	ПараметрыПодключения = ПрочитатьПараметрыПодключения(Объект.Организация);
	Если ТипЗнч(ПараметрыПодключения) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ПараметрыПодключения);
	КонецЕсли; 
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьПараметрыПодключения(Организация)

	Значение = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(, "_ПараметрыОтправкиДанныхПИФНаСайт", Организация);
	НеЗаданыПараметры = Ложь;
	
	Если Значение <> Неопределено Тогда
		Попытка
			XMLЗначение = XMLЗначение(Тип("ХранилищеЗначения"), Значение);
			ПараметрыПодключения = XMLЗначение.Получить();
			Значение = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(, "_ПараметрыОтправкиДанныхПИФНаСайтКлюч", Организация);
			Если Значение <> Неопределено Тогда
				Попытка
					XMLЗначение = XMLЗначение(Тип("ХранилищеЗначения"), Значение);
					ПараметрыПодключения.Ключ = XMLЗначение.Получить();
				Исключение
					ПараметрыПодключения.Ключ = "";
				КонецПопытки;
			КонецЕсли;
			
			Возврат ПараметрыПодключения;
		Исключение
			НеЗаданыПараметры = Истина;
		КонецПопытки;
	Иначе
		НеЗаданыПараметры = Истина;
	КонецЕсли;
	
	Если НеЗаданыПараметры Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для организации " + Организация + " не заданы параметры выгрузки на сайт");
	КонецЕсли; 
		
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьПараметрыПодключенияНаСервере(Организация, ПараметрыПодключения)
	
	Если Не ПустаяСтрока(ПараметрыПодключения.Ключ) Тогда
		Свойство = ПланыВидовХарактеристик.ДополнительныеСведения.НайтиПоРеквизиту("Ключ", "_ПараметрыОтправкиДанныхПИФНаСайтКлюч");
		Если ЗначениеЗаполнено(Свойство) Тогда
			Запись = РегистрыСведений.ЗначенияДополнительныхСведений.СоздатьМенеджерЗаписи();
			Запись.Объект = Организация;
			Запись.Свойство = Свойство;
			Запись.Значение = XMLСтрока(Новый ХранилищеЗначения(ПараметрыПодключения.Ключ, Новый СжатиеДанных(9)));
			Запись.Записать();		
			XMLЗначение(Тип("ХранилищеЗначения"), XMLСтрока(Новый ХранилищеЗначения(ПараметрыПодключения, Новый СжатиеДанных(9)))).Получить()
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдено дополнительное свойство ""_ПараметрыОтправкиДанныхПИФНаСайтКлюч""");
		КонецЕсли;
		ПараметрыПодключения.Ключ = "";
	КонецЕсли;
	
	Свойство = ПланыВидовХарактеристик.ДополнительныеСведения.НайтиПоРеквизиту("Ключ", "_ПараметрыОтправкиДанныхПИФНаСайт");
	Если ЗначениеЗаполнено(Свойство) Тогда
		Запись = РегистрыСведений.ЗначенияДополнительныхСведений.СоздатьМенеджерЗаписи();
		Запись.Объект = Организация;
		Запись.Свойство = Свойство;
		Запись.Значение = XMLСтрока(Новый ХранилищеЗначения(ПараметрыПодключения, Новый СжатиеДанных(9)));
		Запись.Записать();		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдено дополнительное свойство ""_ПараметрыОтправкиДанныхПИФНаСайт""");
	КонецЕсли; 
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПараметрыПодключения(Команда)
	
	ЗаписатьПараметрыПодключенияНаСервере(Объект.Организация, ПолучитьСтруктуруПараметровПодключения());
	Элементы.ПараметрыПодключения.Скрыть();
	
КонецПроцедуры

&НаКлиенте 
Функция ПолучитьСтруктуруПараметровПодключения()

	ПараметрыПодключения = Новый Структура("Протокол, Сервер, ИмяПользователя, Пароль, ТекущийКаталог, АдресСайта, Скрипт, ЗащищенноеСоединение, Ключ");
	ЗаполнитьЗначенияСвойств(ПараметрыПодключения, ЭтаФорма);
	
	Возврат ПараметрыПодключения;

КонецФункции
 
#КонецОбласти