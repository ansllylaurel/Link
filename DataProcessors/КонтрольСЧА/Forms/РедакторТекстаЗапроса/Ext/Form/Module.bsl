
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ТекстЗапроса",	   ЭтаФорма.ТекстЗапроса);
	Параметры.Свойство("ОбязательныеПоля", ЭтаФорма.ОбязательныеПоля);
	
	Если ЭтоАдресВременногоХранилища(Параметры.АдресПараметровЗапроса) Тогда
		
		ПолученныеПараметрыЗапроса = ПолучитьИзВременногоХранилища(Параметры.АдресПараметровЗапроса);
		
		Если ТипЗнч(ПолученныеПараметрыЗапроса) = Тип("ТаблицаЗначений") Тогда
			
			ПараметрыЗапроса.Загрузить(ПолученныеПараметрыЗапроса);
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Элементы.КомментарийКТекстуЗапроса.Видимость = Ложь;	
	
КонецПроцедуры

#Область Команды_формы

&НаКлиенте
Процедура КомандаПолучитьИзТекста(Команда)
	КомандаПолучитьИзТекстаНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура КомандаУдалитьНеиспользуемые(Команда)
	КомандаУдалитьНеиспользуемыеНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура КомандаКонструктор(Команда)
	
	Элементы.КомментарийКТекстуЗапроса.Видимость = Ложь;
	
	Если ЗначениеЗаполнено(ЭтаФорма.ТекстЗапроса) Тогда
		
		Попытка
			Конструктор = Новый КонструкторЗапроса(ЭтаФорма.ТекстЗапроса);
		Исключение
			ОтобразитьОшибку(ИнформацияОбОшибке());
			Возврат;
		КонецПопытки;
		
	Иначе
		
		Конструктор = Новый КонструкторЗапроса();
		
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриЗакрытииКонструктора", ЭтаФорма);
	
	Конструктор.Показать(ОписаниеОповещения);
		
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыполнитьЗапрос(Команда)
	КомандаВыполнитьЗапросНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	
	РезультатРаботы = ПолучитьРезультатЗапроса();
	
	Если РезультатРаботы.Свойство("ТекстОшибки") Тогда
		Предупреждение(РезультатРаботы.ТекстОшибки);
		Возврат;
	КонецЕсли;
		
	Закрыть(РезультатРаботы);
	
КонецПроцедуры

#КонецОбласти 

#Область События_элементов

&НаКлиенте
Процедура КомментарийКТекстуЗапросаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ЗакрывающаяСкоба = Найти(КомментарийКТекстуЗапроса, "}");
	Если ЗакрывающаяСкоба = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДлинаСтроки = 0;
	
	ПозицияВопроса = Найти(КомментарийКТекстуЗапроса, "<<?>>") + СтрДлина("<<?>>");
	Если ПозицияВопроса > 0 Тогда
		ДлинаСтроки = СтрДлина(Сред(КомментарийКТекстуЗапроса, ПозицияВопроса));
	КонецЕсли;
	
	Координаты = Лев(КомментарийКТекстуЗапроса, ЗакрывающаяСкоба);
	Координаты = СтрЗаменить(Координаты, "{(", "");
	Координаты = СтрЗаменить(Координаты, ")}", "");
	Координаты = СтрЗаменить(Координаты, " ", "");
	МассивКоординат = СтрРазделить(Координаты, ",");
	Элементы.ТекстЗапроса.УстановитьГраницыВыделения(Число(МассивКоординат[0]), Число(МассивКоординат[1]), Число(МассивКоординат[0]), Число(МассивКоординат[1]) + ДлинаСтроки);
	ЭтаФорма.ТекущийЭлемент = Элементы.ТекстЗапроса;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииКонструктора(Результат, Дополнительно) Экспорт
	
	Если Результат <> Неопределено Тогда
		ЭтаФорма.ТекстЗапроса = Результат;
		КомандаПолучитьИзТекстаНаСервере();
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура КомандаПолучитьИзТекстаНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = ЭтаФорма.ТекстЗапроса;
	
	Элементы.КомментарийКТекстуЗапроса.Видимость = Ложь;
	
	Попытка
		ОписаниеПараметров = Запрос.НайтиПараметры();
	Исключение
		ОтобразитьОшибку(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	
	Для каждого Параметр Из ОписаниеПараметров Цикл
		
		НайденныеСтроки = ЭтаФорма.ПараметрыЗапроса.НайтиСтроки(Новый Структура("Параметр", Параметр.Имя));
		
		Если НайденныеСтроки.Количество() = 0 Тогда
		
			НоваяСтрока = ЭтаФорма.ПараметрыЗапроса.Добавить();
			НоваяСтрока.Параметр = Параметр.Имя;
			НоваяСтрока.Значение = Параметр.ТипЗначения.ПривестиЗначение();
		
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура КомандаУдалитьНеиспользуемыеНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = ЭтаФорма.ТекстЗапроса;
	
	Попытка
		ОписаниеПараметров = Запрос.НайтиПараметры();
	Исключение
		ОтобразитьОшибку(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	
	Индекс = ЭтаФорма.ПараметрыЗапроса.Количество() - 1;
	Пока Индекс >=0 Цикл
		ТекСтрока = ЭтаФорма.ПараметрыЗапроса[Индекс];
		Если ОписаниеПараметров.Найти(ТекСтрока.Параметр) = Неопределено Тогда
			ЭтаФорма.ПараметрыЗапроса.Удалить(Индекс);
		КонецЕсли; 
		Индекс = Индекс - 1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура КомандаВыполнитьЗапросНаСервере()
	
	ЭтаФорма.Результат.Очистить();
	
	ТаблицаРезультат = ВыполнитьЗапрос();
	
	Если ТаблицаРезультат <> Неопределено Тогда
		
		ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент("Всего строк: " + ТаблицаРезультат.Количество(),,, ЭтаФорма.Результат);
		РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(ПараметрыВывода, ТаблицаРезультат,, "", Ложь);    
		РаботаСОтчетами.УстановитьШиринуКолонок(ПараметрыВывода);
		
		ЭтаФорма.Модифицированность = Ложь;
		
	КонецЕсли;		
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьЗапрос(ПоместитьРезультатВХранилище = Истина)
	
	Запрос = Новый Запрос(ЭтаФорма.ТекстЗапроса);
	Для Каждого СтрокаПараметров Из ЭтаФорма.ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(СтрокаПараметров.Параметр, СтрокаПараметров.Значение);
	КонецЦикла;
	
	Попытка
		ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
		Элементы.КомментарийКТекстуЗапроса.Видимость = Ложь;
	Исключение
		ОтобразитьОшибку(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;
	
	Если ПоместитьРезультатВХранилище Тогда
		ЭтаФорма.АдресРезультата = ПоместитьВоВременноеХранилище(ТаблицаРезультат, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

&НаСервере
Функция ПолучитьРезультатЗапроса()
	
	// Получаем результат запроса
	
	Если ЭтаФорма.Модифицированность ИЛИ Не ЭтоАдресВременногоХранилища(ЭтаФорма.АдресРезультата) Тогда	
		ТаблицаРезультат = ВыполнитьЗапрос(Ложь);
	Иначе
		ТаблицаРезультат = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресРезультата);
	КонецЕсли;
	
	// Проверяем корректность возвращаемого набора
	
	Если ТаблицаРезультат = Неопределено Тогда
		
		Возврат Новый Структура("ТекстОшибки", "Ошибка выполнения запроса");
	
	ИначеЕсли ЗначениеЗаполнено(ЭтаФорма.ОбязательныеПоля) Тогда
		
		НайденыВсеПоля = Истина;
		
		Если ТипЗнч(ЭтаФорма.ОбязательныеПоля) = Тип("Строка") Тогда
			МассивОбязательныхПолей = СтрРазделить(ЭтаФорма.ОбязательныеПоля, ", ", Ложь);
		ИначеЕсли ТипЗнч(ЭтаФорма.ОбязательныеПоля) = Тип("Массив") Тогда
			МассивОбязательныхПолей = ЭтаФорма.ОбязательныеПоля;
		Иначе
			ВызватьИсключение СтрШаблон("Некорректное тип значения параметра 'ОбязательныеПоля' (%1)", ТипЗнч(ЭтаФорма.ОбязательныеПоля));
		КонецЕсли;
		
		Для Каждого ОбязательноПоле Из МассивОбязательныхПолей Цикл
			Если ТаблицаРезультат.Колонки.Найти(ОбязательноПоле) = Неопределено Тогда
				НайденыВсеПоля = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не НайденыВсеПоля Тогда
			Возврат Новый Структура("ТекстОшибки", "Результат запроса должен содержать колонки: " + СтрСоединить(МассивОбязательныхПолей, ", "));
		КонецЕсли;
		
	КонецЕсли;
	
	// Формируем результаты работы
	
	РезультатРаботы = Новый Структура;
	РезультатРаботы.Вставить("ТекстЗапроса", ЭтаФорма.ТекстЗапроса);
	
	Если ЭтоАдресВременногоХранилища(Параметры.АдресПараметровЗапроса) Тогда
		РезультатРаботы.Вставить("АдресПараметровЗапроса", ПоместитьВоВременноеХранилище(ПараметрыЗапроса.Выгрузить(), Параметры.АдресПараметровЗапроса));	
	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(Параметры.АдресРезультатаЗапроса) Тогда
		РезультатРаботы.Вставить("АдресРезультатаЗапроса", ПоместитьВоВременноеХранилище(ТаблицаРезультат, Параметры.АдресРезультатаЗапроса));	
	Иначе
		РезультатРаботы.Вставить("СчетаДоверительногоУправления", ТаблицаРезультат.ВыгрузитьКолонку(0));	
	КонецЕсли;
	
	Возврат РезультатРаботы; 
	
КонецФункции

&НаСервере
Процедура ОтобразитьОшибку(ИнформацияОбОшибке)
	
	КомментарийКТекстуЗапроса = ИнформацияОбОшибке.Причина.Описание;
	
	Элементы.КомментарийКТекстуЗапроса.Видимость = Истина;
	
КонецПроцедуры