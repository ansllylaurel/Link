
Процедура ВыполнитьМетод(Команда, ПараметрыКоманды) Экспорт
	
	Если Команда = "ВыполнитьОтложенныйКонтроль" Тогда
		ВыполнитьОтложенныйКонтроль(ПараметрыКоманды);
	ИначеЕсли Команда = "ВыполнитьКонтрольЗаМесяц" Тогда
		ВыполнитьКонтрольЗаМесяц(ПараметрыКоманды);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Выполнить отложенный контроль
//
// Параметры:
//  Экземпляры	 - ТаблицаЗначений - Колонки
//						- Организация - СправочникСсылка.Организации
//						- Дата - Дата
//						- СчетДоверительногоУправления - СправочникСсылка.СчетаДоверительногоУправления
//						- Идентификатор
Процедура ВыполнитьОтложенныйКонтроль(Экземпляры)
	
	КлючиЗапуска = Новый ТаблицаЗначений;
	
	КлючиЗапуска.Колонки.Добавить("Организация",					Новый ОписаниеТипов("СправочникСсылка.Организации"));
	КлючиЗапуска.Колонки.Добавить("Дата",							Новый ОписаниеТипов("Дата"));
	КлючиЗапуска.Колонки.Добавить("СчетДоверительногоУправления",	Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	КлючиЗапуска.Колонки.Добавить("Идентификатор",					Новый ОписаниеТипов("УникальныйИдентификатор"));
	
	// Фиксируем запуск.
	Для Каждого ТекЭкземпляр Из Экземпляры Цикл
		
		НовыйКлюч = КлючиЗапуска.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйКлюч, ТекЭкземпляр.Параметры);
		НовыйКлюч.Идентификатор = ТекЭкземпляр.Идентификатор;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КлючиЗапуска", КлючиЗапуска);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КлючиЗапуска.Организация КАК Организация,
		|	КлючиЗапуска.Дата КАК Дата,
		|	КлючиЗапуска.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлючиЗапуска.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ _Экземпляры
		|ИЗ
		|	&КлючиЗапуска КАК КлючиЗапуска
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Экземпляры.Организация КАК Организация,
		|	_Экземпляры.Дата КАК Период,
		|	_Экземпляры.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Экземпляры.Идентификатор КАК Идентификатор
		|ИЗ
		|	_Экземпляры КАК _Экземпляры
		|ИТОГИ ПО
		|	Организация,
		|	Дата,
		|	СчетДоверительногоУправления";
	
	// Запускаем проверки.
	ВыборкаОрганизации = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОрганизации.Следующий() Цикл
		
		ВыборкаДаты = ВыборкаОрганизации.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаДаты.Следующий() Цикл
			
			ВыборкаСДУ = ВыборкаДаты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаСДУ.Следующий() Цикл
				
				// выполняем контроль
				Параметры = Новый Структура("Организация, СчетДоверительногоУправления, Период");
				ЗаполнитьЗначенияСвойств(Параметры, ВыборкаСДУ);
				
				Попытка
					Результат = Обработки.КонтрольСЧА.ВыполнитьПроверку(Параметры);
				Исключение
					Результат = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				КонецПопытки; 
				
				ТемаПисьма = "";
				Если ТипЗнч(Результат) = Тип("Структура") Тогда
					Если Результат.Свойство("ТекстОшибки") Тогда
						
						ТемаПисьма = "Контроль СЧА. Проверка завершена с ошибками: " + Формат(ВыборкаСДУ.Период, "ДФ=dd.MM.yyyy") + ": " + ВыборкаСДУ.Организация + " - " + ВыборкаСДУ.СчетДоверительногоУправления;
						ТекстПисьма = Результат.ТекстОшибки;
						
					ИначеЕсли Результат.Количество() > 1 Тогда 
						
						Если Результат.ОтличияАктивов.Количество() > 0 Или Результат.ОтличияЦБ.Количество() > 0 Или Результат.ОтличияПрочихЦБ.Количество() > 0 Или Результат.ЕстьОшибкиЗарегистрированныхЗначений Тогда
					
							ТабличныйДокумент = Обработки.КонтрольСЧА.СформироватьТабличныйДокумент(Результат);
							
							ИмяФайла = ПолучитьИмяВременногоФайла("htm");
							ТабличныйДокумент.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.HTML);
							
							ИзмениласьСЧА = Ложь;
							Если Результат.Итоги.Количество() > 0 Тогда
								ТекСтрока = Результат.Итоги[0];
								Если ТекСтрока.СЧА_Расчетная <> ТекСтрока.СЧА_Текущая Тогда
									ИзмениласьСЧА = Истина;
								КонецЕсли; 
							КонецЕсли;
							
							ТемаПисьма = "Контроль СЧА. " + ?(ИзмениласьСЧА, "Изменилась СЧА на ", "Обнаружены расхождения при закрытии дня ") 
								+ Формат(ВыборкаСДУ.Период, "ДФ=dd.MM.yyyy") + ": " + ВыборкаСДУ.Организация + " - " + ВыборкаСДУ.СчетДоверительногоУправления;
							
							ТелоПисьма = Новый ТекстовыйДокумент;
							ТелоПисьма.Прочитать(ИмяФайла);
							ТекстПисьма = ТелоПисьма.ПолучитьТекст();
							
							УдалитьФайлы(ИмяФайла);
							
						КонецЕсли;
						
					КонецЕсли; 
				Иначе
					ТекстПисьма = Результат;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ТемаПисьма) Тогда
				
					РеквизитыОповещения = Новый Структура("Организация, Тема, Текст", ВыборкаСДУ.Организация, ТемаПисьма, ТекстПисьма);
					Справочники.Оповещения.СформироватьОповещения("Обработка.КонтрольСЧА.ВыполнитьПроверкуВФоне()", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);					
				
				КонецЕсли; 
				
				Выборка = ВыборкаСДУ.Выбрать();
				Пока Выборка.Следующий() Цикл
					// Фиксируем успешное выполнение задания.
					РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(Выборка.Идентификатор);
				КонецЦикла;
				
			КонецЦикла;			
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыполнитьКонтрольЗаМесяц(ПараметрыМетода)

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыМетода);
	
	ПерваяОчередь = Новый Массив; // 1-я очередь: ПФР, ПН, ПР, ПИФ, СРО, СТРАХ, ФОГФ
	ПерваяОчередь.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР);
	ПерваяОчередь.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями);
	ПерваяОчередь.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);
	ПерваяОчередь.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда);
	ПерваяОчередь.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций);
	ПерваяОчередь.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеИмуществомСтраховыхКомпаний);
	ПерваяОчередь.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний);
	ПерваяОчередь.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ);
	
	ПараметрыМетода.Вставить("ОтборВидыДоговоровДУ", ПерваяОчередь);
	ПараметрыМетода.Вставить("ПредставлениеОтбора", "1-я очередь");
	
	ОбъектОбработки = Обработки.КонтрольСЧА.Создать();
	ВыполнитьКонтрольСОтбором(ПараметрыМетода);
	
	ВтораяОчередь = Новый Массив; // 2-я очередь: ЮЛ, ФЛ, НПФ СС, СОБ, Активы целевых капиталов
	
	ВтораяОчередь.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица);
	ВтораяОчередь.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЮридическогоЛица);
	ВтораяОчередь.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов);
	ВтораяОчередь.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.Собственный);
	ПерваяОчередь.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов);
	
	ПараметрыМетода.Вставить("ОтборВидыДоговоровДУ", ВтораяОчередь);
	ПараметрыМетода.Вставить("ПредставлениеОтбора", "2-я очередь");
	ВыполнитьКонтрольСОтбором(ПараметрыМетода);
				
	ТретьяОчередь = Новый Массив; // 3-я очередь: ИИС и прочие
	
	Для каждого ЗначениеПеречисления Из Метаданные.Перечисления.ВидыДоговоровДоверительногоУправления.ЗначенияПеречисления Цикл
	
		Значение = Перечисления.ВидыДоговоровДоверительногоУправления[ЗначениеПеречисления.Имя];
		Если ПерваяОчередь.Найти(Значение) = Неопределено И ВтораяОчередь.Найти(Значение) = Неопределено Тогда
		
			ТретьяОчередь.Добавить(Значение);
		
		КонецЕсли; 
	
	КонецЦикла; 
		
	ПараметрыМетода.Вставить("ОтборВидыДоговоровДУ", ТретьяОчередь);
	ПараметрыМетода.Вставить("ПредставлениеОтбора", "3-я очередь");
	ВыполнитьКонтрольСОтбором(ПараметрыМетода);
				
КонецПроцедуры

Процедура ВыполнитьКонтрольСОтбором(ПараметрыМетода);

	ПараметрыОбработки = ПодготовитьПараметрыОбработки(ПараметрыМетода);
	Обработки.КонтрольСЧА.ПроверитьТаблицу(ПараметрыОбработки, Неопределено);
	
	ПолучитьРезультатыИзХранилищаЗначений(ПараметрыОбработки.ТаблицаДляПроверки); 
	ОтправитьРезультатыПроверкиНаПочту(ПараметрыОбработки.ТаблицаДляПроверки, ПараметрыМетода.ПредставлениеОтбора);

КонецПроцедуры
 
Функция ПодготовитьПараметрыОбработки(ПараметрыМетода)

	Отбор = Новый Структура("ОтборВидыДоговоровДУ, ИсключитьСчетНЕОПРЕДЕЛЕН", 
		ПараметрыМетода.ОтборВидыДоговоровДУ,
		Истина);
	
	ТаблицаКонтроля = Обработки.КонтрольСЧА.ПолучитьТаблицуКонтроляСЧА(
		ПараметрыМетода.Организация, 
		ПараметрыМетода.ПериодКонтроля, 
		1, 
		Отбор);
		
	ТаблицаДляПроверки = ЭтотОбъект.РезультатыПроверки.Выгрузить().СкопироватьКолонки();
	
	РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ТаблицаКонтроля, ТаблицаДляПроверки);	
		
	ТаблицаДляПроверки.Колонки.Добавить("НаборыДанных");
	ТаблицаДляПроверки.Колонки.Добавить("ЕстьОшибкиЗарегистрированныхЗначений", 	Новый ОписаниеТипов("Булево"));
	ТаблицаДляПроверки.Колонки.Добавить("ЕстьОшибкиВЦБ", 							Новый ОписаниеТипов("Булево"));
	ТаблицаДляПроверки.Колонки.Добавить("ЕстьОшибкиВАктивах", 						Новый ОписаниеТипов("Булево"));
	ТаблицаДляПроверки.Колонки.Добавить("ЕстьОшибки", 								Новый ОписаниеТипов("Булево"));
	ТаблицаДляПроверки.Колонки.Добавить("Результат", 								Новый ОписаниеТипов("Строка"));
	ТаблицаДляПроверки.Колонки.Добавить("Статус", 									Новый ОписаниеТипов("Строка"));
		
	Для каждого СтрокаТаблицаКонтроля Из ТаблицаДляПроверки Цикл
		СтрокаТаблицаКонтроля.ИднетификаторРезультата = Новый УникальныйИдентификатор;
	КонецЦикла; 
	
	ИмяПодчиненныхЗаданий = "Обработки.КонтрольСЧА.ВыполнитьПроверку_" + ПолучитьТекущийСеансИнформационнойБазы().НомерСеанса;
	ПараметрыОбработки = Новый Структура("ТаблицаДляПроверки, КоличествоПараллельныхСеансов, ИмяПодчиненныхЗаданий", 
		ТаблицаДляПроверки, 
		7, 
		ИмяПодчиненныхЗаданий);

	Возврат ПараметрыОбработки;

КонецФункции

Процедура ПолучитьРезультатыИзХранилищаЗначений(ТаблицаДляПроверки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИднетификаторРезультата", ТаблицаДляПроверки.ВыгрузитьКолонку("ИднетификаторРезультата"));
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ХранилищеЗначений.Идентификатор КАК Идентификатор,
		|	ХранилищеЗначений.ХранилищеЗначения КАК ХранилищеЗначения
		|ИЗ
		|	РегистрСведений.ХранилищеЗначений КАК ХранилищеЗначений
		|		ГДЕ ХранилищеЗначений.Идентификатор В (&ИднетификаторРезультата)
		|			И (ХранилищеЗначений.Источник = ""КонтрольСЧА"")";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		ТекСтрока = ТаблицаДляПроверки.НайтиСтроки(Новый Структура("ИднетификаторРезультата", Выборка.Идентификатор))[0];
		
		ЗначениеРезультат = Выборка.ХранилищеЗначения.Получить();
		
		Если ТипЗнч(ЗначениеРезультат) = Тип("Структура") И Не ЗначениеРезультат.Свойство("ТекстОшибки") Тогда
			
			ЗаполнитьЗначенияСвойств(ТекСтрока, ЗначениеРезультат);
			ТекСтрока.Статус = "Завершено";
			
			Если ЗначениеРезультат.Итоги.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(ТекСтрока, ЗначениеРезультат.Итоги[0]);
			КонецЕсли; 
						
			ТекСтрока.НаборыДанных = ЗначениеРезультат;
			ТекСтрока.ЕстьОшибкиЗарегистрированныхЗначений = ЗначениеРезультат.ЕстьОшибкиЗарегистрированныхЗначений;
			
			Если ЗначениеРезультат.ОтличияЦБ.Количество() <> 0 Тогда
				ТекСтрока.ЕстьОшибкиВЦБ = Истина;
			КонецЕсли;
			
			Если ЗначениеРезультат.ОтличияАктивов.Количество() <> 0 Тогда
				ТекСтрока.ЕстьОшибкиВАктивах = Истина;
			КонецЕсли;
			
			Если Не ТекСтрока.ДатаРасчетаСЧА Тогда
				ТекСтрока.Результат = ?(ТекСтрока.НеЗаданыНастройки, "Не заданы настройки формирования СЧА", "В этот день СЧА не рассчитывается");
				ТекСтрока.ЕстьОшибки = Истина;
			ИначеЕсли ТекСтрока.НеЗаданыНастройки Тогда
				ТекСтрока.Результат = "Не заданы настройки формирования СЧА";
				ТекСтрока.ЕстьОшибки = Истина;
			ИначеЕсли ТекСтрока.ЕстьОшибкиЗарегистрированныхЗначений Или ТекСтрока.ЕстьОшибкиВЦБ Или ТекСтрока.ЕстьОшибкиВАктивах Тогда
				ТекСтрока.Результат = "Есть расхождения" + ?(ТекСтрока.НеЗаданыНастройки, " (настройки не заданы)", "");
				ТекСтрока.ЕстьОшибки = Истина;
			Иначе
				ТекСтрока.Результат = "Нет расхождений" + ?(ТекСтрока.НеЗаданыНастройки, " (настройки не заданы)", "");
				ТекСтрока.ЕстьОшибки = ТекСтрока.НеЗаданыНастройки;
			КонецЕсли; 				
			
		Иначе
		
			ТекСтрока.Статус = "Завершено аварийно";
			ТекСтрока.ЕстьОшибки = Истина;
			
			Если ТипЗнч(ЗначениеРезультат) = Тип("Строка") Тогда
				ТекСтрока.Результат = ЗначениеРезультат;
			ИначеЕсли ТипЗнч(ЗначениеРезультат) = Тип("Структура") И ЗначениеРезультат.Свойство("ТекстОшибки") Тогда
				ТекСтрока.Результат = ЗначениеРезультат.ТекстОшибки;
			Иначе
				ТекСтрока.Результат = "Завершено аварийно";
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЦикла;

КонецПроцедуры
 
Процедура ОтправитьРезультатыПроверкиНаПочту(ТаблицаДляПроверки, ПредставлениеОтбора)
	
	Вложения		= Новый Соответствие;
	ВременныеФайлы	= Новый Массив;	
		
	СтрокиСОшибками = ТаблицаДляПроверки.НайтиСтроки(Новый Структура("ЕстьОшибки", Истина));
		
	Если СтрокиСОшибками.Количество() > 0 Тогда
	
		// Формируем отчет	
		
		Попытка
			
			ДанныеОтчета = СформироватьТабличныйДокументСРезультатамиПроверки(ТаблицаДляПроверки);
			
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
			
			ДанныеОтчета.Записать(ИмяВременногоФайла,  ТипФайлаТабличногоДокумента.XLSX);
			
			Вложения.Вставить("Отчет.xlsx", Новый Файл(ИмяВременногоФайла));
			
			ВременныеФайлы.Добавить(ИмяВременногоФайла);
			
		Исключение
			
			ЗаписьЖурналаРегистрации("Ошибка формирования отчета", УровеньЖурналаРегистрации.Ошибка, , Метаданные.Обработки.КонтрольСЧА.ПолноеИмя(), ОписаниеОшибки());
			
		КонецПопытки;
		
		// Формируем данные во внутреннем формате
		
		Попытка
			
			ДанныеФайла	= ПолучитьРезультатыПроверкиВоВнутреннемФормате(ТаблицаДляПроверки);
			
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
			
			ТекстовыйДокумент = Новый ТекстовыйДокумент;
			ТекстовыйДокумент.УстановитьТекст(ДанныеФайла);
			ТекстовыйДокумент.Записать(ИмяВременногоФайла, КодировкаТекста.UTF8);
			
			Вложения.Вставить("Служебный.xml", Новый Файл(ИмяВременногоФайла));
			
			ВременныеФайлы.Добавить(ИмяВременногоФайла);
			
		Исключение
			
			ЗаписьЖурналаРегистрации("Ошибка формирования файла во внутреннем формате", УровеньЖурналаРегистрации.Ошибка, , Метаданные.Обработки.КонтрольСЧА.ПолноеИмя(), ОписаниеОшибки());
			
		КонецПопытки;		
	
	КонецЕсли; 
	
	// Высылаем на почту	
			
	Попытка
		
		РеквизитыОповещения = Новый Структура("Организация, Тема, Текст, Вложения", 
			Организация, 
			"Контроль СЧА за период " + Строка(ЭтотОбъект.ПериодКонтроля) + ". " + ПредставлениеОтбора, 
			"Результаты проверки СЧА за период " + Строка(ЭтотОбъект.ПериодКонтроля) + ". " + ПредставлениеОтбора + ?(Вложения.Количество() = 0, ": расхождений не обнаружено", ""),
			Вложения);
		Справочники.Оповещения.СформироватьОповещения("Обработка.КонтрольСЧА.ВыполнитьКонтрольЗаМесяц()", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
	Исключение
		
		ЗаписьЖурналаРегистрации("Ошибка отправки отчета на электронную почту", УровеньЖурналаРегистрации.Ошибка, , Метаданные.Обработки.КонтрольСЧА.ПолноеИмя(), ОписаниеОшибки());
		
	КонецПопытки;	
	
	// Удаляем не нужные файлы	
	
	Для Каждого ВременныйФайл Из ВременныеФайлы Цикл
		УдалитьФайлы(ВременныйФайл);
	КонецЦикла;
	
КонецПроцедуры

Функция СформироватьТабличныйДокументСРезультатамиПроверки(ТаблицаДляПроверки)
		
	Клиенты = ТаблицаДляПроверки.Скопировать(ТаблицаДляПроверки.НайтиСтроки(Новый Структура("ЕстьОшибки", Истина)), "СчетДоверительногоУправления, Дата, Результат, РСА_Текущая, РСА_Расчетная, СЧА_Текущая, СЧА_Расчетная, НаборыДанных");
	
	ОбщиеНаборыДанных = Новый Структура("Клиенты", Клиенты);
	
	Для Каждого ТекСтрока Из Клиенты Цикл
		
		Если ТипЗнч(ТекСтрока.НаборыДанных) = Тип("Структура") Тогда

			НаборыДанных = ТекСтрока.НаборыДанных;

			РезультатПроверки = Новый Структура; 
			
			РезультатПроверки.Вставить("ОтличияАктивов", НаборыДанных.ОтличияАктивов.Скопировать());
			РезультатПроверки.ОтличияАктивов.Колонки.Добавить("СчетДоверительногоУправления", Клиенты.Колонки["СчетДоверительногоУправления"].ТипЗначения);
			РезультатПроверки.ОтличияАктивов.Колонки.Добавить("Дата", Клиенты.Колонки["Дата"].ТипЗначения);
			РезультатПроверки.ОтличияАктивов.ЗаполнитьЗначения(ТекСтрока.СчетДоверительногоУправления, "СчетДоверительногоУправления");
			РезультатПроверки.ОтличияАктивов.ЗаполнитьЗначения(ТекСтрока.Дата, "Дата");
			
			Если ОбщиеНаборыДанных.Свойство("ОтличияАктивов") Тогда
				РаботаСКоллекциями.ТаблицаЗначений_Дополнить(РезультатПроверки.ОтличияАктивов, ОбщиеНаборыДанных.ОтличияАктивов); 			
			Иначе
				ОбщиеНаборыДанных.Вставить("ОтличияАктивов", РезультатПроверки.ОтличияАктивов);	
			КонецЕсли;
		
			РезультатПроверки.Вставить("ОтличияЦБ", НаборыДанных.ОтличияЦБ.Скопировать());
			РезультатПроверки.ОтличияЦБ.Колонки.Добавить("СчетДоверительногоУправления", Клиенты.Колонки["СчетДоверительногоУправления"].ТипЗначения);
			РезультатПроверки.ОтличияЦБ.Колонки.Добавить("Дата", Клиенты.Колонки["Дата"].ТипЗначения);
			РезультатПроверки.ОтличияЦБ.ЗаполнитьЗначения(ТекСтрока.СчетДоверительногоУправления, "СчетДоверительногоУправления");
			РезультатПроверки.ОтличияЦБ.ЗаполнитьЗначения(ТекСтрока.Дата, "Дата");		
			
			Если ОбщиеНаборыДанных.Свойство("ОтличияЦБ") Тогда
				РаботаСКоллекциями.ТаблицаЗначений_Дополнить(РезультатПроверки.ОтличияЦБ, ОбщиеНаборыДанных.ОтличияЦБ); 			
			Иначе
				ОбщиеНаборыДанных.Вставить("ОтличияЦБ", РезультатПроверки.ОтличияЦБ);	
			КонецЕсли;
		
			РезультатПроверки.Вставить("ОтличияПрочихЦБ", НаборыДанных.ОтличияПрочихЦБ.Скопировать());
			РезультатПроверки.ОтличияПрочихЦБ.Колонки.Добавить("СчетДоверительногоУправления", Клиенты.Колонки["СчетДоверительногоУправления"].ТипЗначения);
			РезультатПроверки.ОтличияПрочихЦБ.Колонки.Добавить("Дата", Клиенты.Колонки["Дата"].ТипЗначения);
			РезультатПроверки.ОтличияПрочихЦБ.ЗаполнитьЗначения(ТекСтрока.СчетДоверительногоУправления, "СчетДоверительногоУправления");
			РезультатПроверки.ОтличияПрочихЦБ.ЗаполнитьЗначения(ТекСтрока.Дата, "Дата");		
			
			Если ОбщиеНаборыДанных.Свойство("ОтличияПрочихЦБ") Тогда
				РаботаСКоллекциями.ТаблицаЗначений_Дополнить(РезультатПроверки.ОтличияПрочихЦБ, ОбщиеНаборыДанных.ОтличияПрочихЦБ); 			
			Иначе
				ОбщиеНаборыДанных.Вставить("ОтличияПрочихЦБ", РезультатПроверки.ОтличияПрочихЦБ);	
			КонецЕсли;
			
			РезультатПроверки.Вставить("ОтличияДоходности", НаборыДанных.ОтличияДоходности.Скопировать());
			РезультатПроверки.ОтличияДоходности.Колонки.Добавить("СчетДоверительногоУправления", Клиенты.Колонки["СчетДоверительногоУправления"].ТипЗначения);
			РезультатПроверки.ОтличияДоходности.Колонки.Добавить("Дата", Клиенты.Колонки["Дата"].ТипЗначения);
			РезультатПроверки.ОтличияДоходности.ЗаполнитьЗначения(ТекСтрока.СчетДоверительногоУправления, "СчетДоверительногоУправления");
			РезультатПроверки.ОтличияДоходности.ЗаполнитьЗначения(ТекСтрока.Дата, "Дата");		
			
			Если ОбщиеНаборыДанных.Свойство("ОтличияДоходности") Тогда
				РаботаСКоллекциями.ТаблицаЗначений_Дополнить(РезультатПроверки.ОтличияДоходности, ОбщиеНаборыДанных.ОтличияДоходности); 			
			Иначе
				ОбщиеНаборыДанных.Вставить("ОтличияДоходности", РезультатПроверки.ОтличияДоходности);	
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;	
	
	ДокументРезультат = Обработки.КонтрольСЧА.СформироватьТабличныйДокумент(ОбщиеНаборыДанных);	
	
	ДокументРезультат.ОтображатьЗаголовки	= Ложь;
	ДокументРезультат.ОтображатьСетку		= Ложь;	
	
	Возврат ДокументРезультат;	
	
КонецФункции

Функция ПолучитьРезультатыПроверкиВоВнутреннемФормате(ТаблицаРезультатов)
	
	СохраняемыеДанные = Новый Структура;
	СохраняемыеДанные.Вставить("ТаблицаРезультатов", 			ТаблицаРезультатов);
	СохраняемыеДанные.Вставить("ПериодКонтроля", 				ЭтотОбъект.ПериодКонтроля);
	СохраняемыеДанные.Вставить("СчетаДоверительногоУправления", Новый СписокЗначений);
	
	Возврат XMLСтрока(Новый ХранилищеЗначения(СохраняемыеДанные, Новый СжатиеДанных(9)));
	
КонецФункции