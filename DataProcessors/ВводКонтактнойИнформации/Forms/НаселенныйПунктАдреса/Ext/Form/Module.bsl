
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры.НаселенныйПунктДетально);	
	
	ЗаполнитьСписокРегионов();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда
		НаселенныйПунктДетально = Новый Структура("ВнутригРайон, Город, НаселенныйПункт, Округ, Район, Регион, КодРегиона, Улица");
		ЗаполнитьЗначенияСвойств(НаселенныйПунктДетально, ЭтаФорма);
		
		НайденныеСтроки = РегионыРФ.НайтиСтроки(Новый Структура("Регион", Регион));
		Если НайденныеСтроки.Количество() > 0 Тогда
			НаселенныйПунктДетально.КодРегиона = НайденныеСтроки[0].КодРегиона;
		КонецЕсли;	
		
		Закрыть(НаселенныйПунктДетально);
	Иначе
		Закрыть();
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокРегионов()
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("РегионыРФ");
	
	Для Стр = 2 По Макет.ВысотаТаблицы Цикл	
		СтрокаДанных = РегионыРФ.Добавить();
		СтрокаДанных.КодРегиона = Макет.Область(Стр, 1, Стр, 1).Текст;
		СтрокаДанных.Регион		= Макет.Область(Стр, 2, Стр, 2).Текст;
		
		Элементы.Регион.СписокВыбора.Добавить(СтрокаДанных.Регион, СтрокаДанных.Регион);
	КонецЦикла;
	
КонецПроцедуры

