
&НаСервере
Процедура ОбновитьНормативноСправочнуюИнформациюНаСервере()
	
	Для каждого Элемент Из ЭтаФорма.СписокФлажков Цикл
		Если Не ЭтаФорма[Элемент.Значение] Тогда
			Продолжить;
		КонецЕсли;
		
		Обработки.ИмпортНормативноСправочнойИнформации.ОбновитьИзМатрих(Элемент.Значение, ЭтаФорма.РежимОбновления);
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выполнение завершено");
		
КонецПроцедуры // ОбновитьНормативноСправочнуюИнформациюНаСервере

&НаСервере
Процедура ЗаполнитьОтчетОНеобновленныхОбъектахНаСервере()
	
	ЭтаФорма.НеобновленныеОбъекты.Очистить();
	
	Выборка = Обработки.ИмпортНормативноСправочнойИнформации.ВыбратьОбъектыОбновленныеРанееТекущейДаты();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ЭтаФорма.НеобновленныеОбъекты.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьОтчетОНеобновленныхОбъектахНаСервере

&НаСервере
Процедура ОбновитьНеобновленныеОбъектыНаСервере()
	
	ЭтаФорма.РеквизитФормыВЗначение("Объект").ОбновитьИзМатрих(, 6);
	
КонецПроцедуры // ОбновитьНеобновленныеОбъектыНаСервере

&НаСервере
Процедура АвтоматическоеОбновлениеИзМатрихНаСервере()
	
	Обработки.ИмпортНормативноСправочнойИнформации.АвтоматическоеОбновлениеИзМатрих();
	
КонецПроцедуры // АвтоматическоеОбновлениеИзМатрихНаСервере

&НаСервере
Функция СформироватьОтчетОНеобновленныхОбъектах()
	
	ОтчетHTML =
		"<html>
		|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
		|	<style>
		|		body {
		|			font: 12pt sans-serif;
		|		}
		|		table {
		|			border-spacing: 0;
		|			border-collapse: collapse;
		|		}
		|		td {
		|			border: 1px solid lightgray;
		|			padding: 5px;
		|		}
		|		.caption {
		|			font-weight: bolder;
		|			font-size: 17px;
		|			text-align: center;
		|		}
		|	</style>
		|</head>
		|<body>
		|<h3>Объекты, обновленные ранее " + ТекущаяДатаСеанса() + "</h3>
		|<table>
		|<tr class=""caption"">
		|	<td>Объект</td>
		|	<td>Группа</td>
		|	<td>Код</td>
		|	<td>Дата обновления</td>
		|</tr>";
		
	Выборка = Обработки.ИмпортНормативноСправочнойИнформации.ВыбратьОбъектыОбновленныеРанееТекущейДаты();
	
	Пока Выборка.Следующий() Цикл
		ОтчетHTML = ОтчетHTML + Символы.ПС +
			"<tr>
			|	<td>" + Выборка.Объект + "</td>
			|	<td>" + Выборка.ГруппаОбъектов + "</td>
			|	<td>" + Выборка.Код + "</td>
			|	<td>" + Выборка.ДатаОбновления + "</td>
			|</tr>";
		
	КонецЦикла;	
		
	ОтчетHTML = ОтчетHTML + Символы.ПС +
		"</table></body></html>";
	
	Возврат ОтчетHTML;
	
КонецФункции // СформироватьОтчетОНеобновленныхОбъектах

