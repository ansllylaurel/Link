
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Период = ЭтаФорма.Параметры.Период;
	
	ЭтаФорма.РежимУчетаРабочихДней = 0; // только перезаполнение
	ЭтаФорма.Календарь = Справочники.Календари.Общероссийский;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	РежимУчетаРабочихДнейПриИзменении(Неопределено);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНастройкиРегистрацииЗаУказанныйПериод(Период, РежимУчетаРабочихДней, Календарь)
	
	НаборДат = Новый Массив;
	
	Если РежимУчетаРабочихДней = 1 Тогда // только рабочие дни и конец каждого месяца
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеКалендаря.Дата КАК Дата
			|ИЗ
			|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|ГДЕ
			|	ДанныеКалендаря.Календарь = &Календарь
			|	И (ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
			|			ИЛИ КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, ДЕНЬ) = КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, МЕСЯЦ))
			|	И ДанныеКалендаря.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
			|
			|УПОРЯДОЧИТЬ ПО
			|	Дата";
		
		Запрос.УстановитьПараметр("Календарь", Календарь);
		Запрос.УстановитьПараметр("ДатаНачала", Период.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания", Период.ДатаОкончания);
		
		Выборка = Запрос.Выполнить().Выбрать();
				
		Пока Выборка.Следующий() Цикл
			НаборДат.Добавить(Выборка.Дата);
		КонецЦикла;
			
	ИначеЕсли РежимУчетаРабочихДней = 2 Тогда // только рабочие дни
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеКалендаря.Дата КАК Дата
			|ИЗ
			|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|ГДЕ
			|	ДанныеКалендаря.Календарь = &Календарь
			|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
			|	И ДанныеКалендаря.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
			|
			|УПОРЯДОЧИТЬ ПО
			|	Дата";
		
		Запрос.УстановитьПараметр("Календарь", Календарь);
		Запрос.УстановитьПараметр("ДатаНачала", Период.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания", Период.ДатаОкончания);
		
		Выборка = Запрос.Выполнить().Выбрать();
				
		Пока Выборка.Следующий() Цикл
			НаборДат.Добавить(Выборка.Дата);
		КонецЦикла;
		
	ИначеЕсли РежимУчетаРабочихДней = 3 Или РежимУчетаРабочихДней = 0 Тогда // все дни
		ДатаПериода = Период.ДатаНачала;
		Пока ДатаПериода <= Период.ДатаОкончания Цикл
			НаборДат.Добавить(ДатаПериода);
			ДатаПериода = ДатаПериода + 86400;
		КонецЦикла;
		
	Иначе
		ВызватьИсключение "Получение набора дат по данному режиму не поддерживается";
		
	КонецЕсли;
	
	СоздаватьНедостающие = (РежимУчетаРабочихДней > 0);
	
	НастройкиРегистрацииЗаПериод = Новый Структура("НаборДат, СоздаватьНедостающие, ПерезаполнитьБезУчетаНастроекРегламентныхДействий", НаборДат, СоздаватьНедостающие, РежимУчетаРабочихДней = 0);
	
	Если РежимУчетаРабочихДней = 0 Тогда
		
		НастройкиРегистрацииЗаПериод.Вставить("ТекстВопроса", 
			"Подтвердите, пожалуйста, перезаполнение документов за период с " + 
			Формат(Период.ДатаНачала, "ДФ=dd.MM.yyyy") + " по " + Формат(Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
			
	КонецЕсли; 
	
	Возврат НастройкиРегистрацииЗаПериод;
	
КонецФункции // ПолучитьНастройкиРегистрацииЗаУказанныйПериод

&НаКлиенте
Процедура РежимУчетаРабочихДнейПриИзменении(Элемент)
	
	Элементы.Календарь.Видимость = (ЭтаФорма.РежимУчетаРабочихДней = 1 Или ЭтаФорма.РежимУчетаРабочихДней = 2);
	Элементы.ДекорацияСправка.Видимость = (ЭтаФорма.РежимУчетаРабочихДней = 0);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ТекстСообщения = "";
	
	Если Не ОбщегоНазначенияКлиентСервер.ПериодЗаполненКорректно(ЭтаФорма.Период,,, ТекстСообщения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,, "Период");
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.Закрыть(
			ПолучитьНастройкиРегистрацииЗаУказанныйПериод(ЭтаФорма.Период, ЭтаФорма.РежимУчетаРабочихДней, ЭтаФорма.Календарь));
	
КонецПроцедуры
