
&НаСервере
Функция ПолучитьРеквизитыДоговораСБрокером(Операция)
	
	РеквизитыДоговораСБрокером = Новый Структура("НомерДоговора, ДатаДоговора, НаименованиеВладельцаДоговораДляДокументов, НомерИнвестиционногоСчета",
		"" "", "" "", "" "", "" "");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.НомерДоговора КАК НомерДоговора,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.ДатаЗаключения КАК ДатаДоговора,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДоговораДляДокументов,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК НомерИнвестиционногоСчета
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&Период,
		|			Брокер = &Брокер
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних";
		
	РеквизитыОперации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Операция, "Дата, СчетДоверительногоУправления");	
		
	Запрос.УстановитьПараметр("Период",                       РеквизитыОперации.Дата);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", РеквизитыОперации.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Брокер",                       Брокер_БК_Регион);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если НЕ ЗначениеЗаполнено(Выборка.НаименованиеВладельцаДоговораДляДокументов) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В договоре брокерского обслуживания не заполнен реквизит 'Наименование владельца для документов'!");
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(РеквизитыДоговораСБрокером, Выборка);
		
	КонецЕсли;
	
	Возврат РеквизитыДоговораСБрокером;
	
КонецФункции // ПолучитьРеквизитыДоговораСБрокером

&НаСервере
Функция ПолучитьДанныеПорученияИлиПереводаДенежныхСредств(ПоручениеИлиПереводДенежныхСредств, Подписант)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПереводДенежныхСредств.Номер КАК Номер,
		|	ПереводДенежныхСредств.Дата КАК Дата,
		|	ПРЕДСТАВЛЕНИЕ(ПереводДенежныхСредств.СчетДоверительногоУправления) КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА КлиентыДоверительногоУправленияСрезПоследних.Клиент.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
		|			ТОГДА РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу
		|		КОГДА КлиентыДоверительногоУправленияСрезПоследних.Клиент.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|			ТОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество
		|	КОНЕЦ КАК Клиент,
		|	ПРЕДСТАВЛЕНИЕ(КлиентыДоверительногоУправленияСрезПоследних.Клиент.ВидЮрФизЛица) КАК ВидЮрФизЛица,
		|	ПереводДенежныхСредств.МестоХранения КАК МестоХранения,
		|	ПереводДенежныхСредств.Брокер КАК Брокер,
		|	ПереводДенежныхСредств.РасчетныйСчет.НомерСчета КАК РасчетныйСчет,
		|	ПРЕДСТАВЛЕНИЕ(ПереводДенежныхСредств.РасчетныйСчет.Банк) КАК РасчетныйСчетБанк,
		|	ПереводДенежныхСредств.РасчетныйСчет.Банк.Код КАК РасчетныйСчетБИК,
		|	ПереводДенежныхСредств.РасчетныйСчет.Банк.КоррСчет КАК РасчетныйСчетКоррСчет,
		|	ПереводДенежныхСредств.МестоХраненияПолучатель КАК МестоХраненияПолучатель,
		|	ПереводДенежныхСредств.БрокерПолучатель КАК БрокерПолучатель,
		|	ПереводДенежныхСредств.РасчетныйСчетПолучатель.НомерСчета КАК РасчетныйСчетПолучатель,
		|	ПРЕДСТАВЛЕНИЕ(ПереводДенежныхСредств.РасчетныйСчетПолучатель.Банк) КАК РасчетныйСчетПолучательБанк,
		|	ПереводДенежныхСредств.РасчетныйСчетПолучатель.Банк.Код КАК РасчетныйСчетПолучательБИК,
		|	ПереводДенежныхСредств.РасчетныйСчетПолучатель.Банк.КоррСчет КАК РасчетныйСчетПолучательКоррСчет,
		|	ПереводДенежныхСредств.РасчетныйСчетПолучатель.Договор.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДоговораПолучателяДляДокументов,
		|	ПереводДенежныхСредств.Валюта КАК Валюта,
		|	ПереводДенежныхСредств.Валюта.ПараметрыПрописиНаРусском КАК ПараметрыПрописиВалютыНаРусском,
		|	ПереводДенежныхСредств.Сумма КАК Сумма,
		|	КонтактныеЛица.КонтактноеЛицо.Представление КАК КонтактноеЛицо,
		|	КонтактныеЛица.Должность КАК Должность,
		|	КонтактныеЛица.ОснованиеПолномочий КАК ОснованиеПолномочий,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследнихПолучатель.ИНН, ""000"") КАК ИННПолучателя,
		|	ПереводДенежныхСредств.СчетДоверительногоУправления.КодСчета КАК СчетДоверительногоУправленияКод,
		|	ПереводДенежныхСредств.Организация КАК Организация,
		|	ПереводДенежныхСредств.Организация.ПрефиксНумерации КАК ОрганизацияПрефиксНумерации,
		|	ЗначенияДополнительныхСведенийБКАдрес.Значение КАК Адрес,
		|	ЗначенияДополнительныхСведенийБКТелефон.Значение КАК Телефон,
		|	КонтактнаяИнформацияБКСайт.Представление КАК Сайт
		|ИЗ
		|	Документ.ПереводДенежныхСредств КАК ПереводДенежныхСредств
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО ПереводДенежныхСредств.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(&Период, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО (РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо = КлиентыДоверительногоУправленияСрезПоследних.Клиент)
		|			И (РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо = ПереводДенежныхСредств.РасчетныйСчетПолучатель.ЮрФизЛицо)
		|			И (РеквизитыЮридическихЛицАнкетныеСрезПоследних.Организация = ПереводДенежныхСредств.Организация)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(&Период, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ПО (РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо = КлиентыДоверительногоУправленияСрезПоследних.Клиент)
		|			И (РеквизитыФизическихЛицАнкетныеСрезПоследних.Организация = ПереводДенежныхСредств.Организация)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|		ПО ПереводДенежныхСредств.Организация.ЮрФизЛицо = КонтактныеЛица.Объект
		|			И (КонтактныеЛица.КонтактноеЛицо = &Подписант)
		|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследнихПолучатель
		|		ПО ПереводДенежныхСредств.РасчетныйСчетПолучатель.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследнихПолучатель.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ВебСтраница)
		|					И Объект = &БКРегион) КАК КонтактнаяИнформацияБКСайт
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийБКАдрес
		|		ПО (ЗначенияДополнительныхСведенийБКАдрес.Объект = &БКРегион)
		|			И (ЗначенияДополнительныхСведенийБКАдрес.Свойство.Ключ = ""АдресЮрЛицаДляПечати"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийБКТелефон
		|		ПО (ЗначенияДополнительныхСведенийБКТелефон.Объект = &БКРегион)
		|			И (ЗначенияДополнительныхСведенийБКТелефон.Свойство.Ключ = ""ТелефонЮрЛицаДляПечати"")
		|ГДЕ
		|	ПереводДенежныхСредств.Ссылка = &Ссылка";
	
	Если ТипЗнч(ПоручениеИлиПереводДенежныхСредств) = Тип("ДокументСсылка.ПоручениеНаПереводДенежныхСредств") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ПереводДенежныхСредств КАК ПереводДенежныхСредств", "Документ.ПоручениеНаПереводДенежныхСредств КАК ПереводДенежныхСредств");	
	КонецЕсли;
	
	БКРегион = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион");
	
	Запрос.УстановитьПараметр("Ссылка",                       ПоручениеИлиПереводДенежныхСредств);
	Запрос.УстановитьПараметр("Период",                       ПоручениеИлиПереводДенежныхСредств.Дата);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПоручениеИлиПереводДенежныхСредств.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Подписант"					, Подписант);
	Запрос.УстановитьПараметр("БКРегион"					, ?(ЗначениеЗаполнено(БКРегион), БКРегион.ЮрФизЛицо, Неопределено));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если НЕ ЗначениеЗаполнено(Выборка.Клиент) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В анкетных данных клиента не заполнен реквизит 'Краткое наименование по уставу' или Ф.И.О.!");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.НаименованиеВладельцаДоговораПолучателяДляДокументов) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В договоре брокерского обслуживания не заполнен реквизит 'Наименование владельца для документов'!");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.ПараметрыПрописиВалютыНаРусском) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У Валюты не заполнен реквизит 'Параметры прописи на русском'!");
		КонецЕсли;
		
		РеквизитыРаспоряжения = Новый Структура();
		
		Для каждого Колонка Из РезультатЗапроса.Колонки Цикл
			РеквизитыРаспоряжения.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
		КонецЦикла;
		
		РеквизитыРаспоряжения.Вставить("СуммаИСуммаПрописью", Формат(РеквизитыРаспоряжения.Сумма, "ЧДЦ=2; ЧРГ=''''") + " (" + ЧислоПрописью(РеквизитыРаспоряжения.Сумма,, РеквизитыРаспоряжения.ПараметрыПрописиВалютыНаРусском) + ")");

		Возврат РеквизитыРаспоряжения;
		
	Иначе
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции // ПолучитьДанныеПереводаДенежныхСредств

&НаСервере
Функция ПолучитьДанныеЭмиссионнойВнебиржевойСделки(Сделка, Подписант)
	
	// т.к. распоряжение печатается из самого документа, то смотреть на условия сделки смысла нет,
	// т.к. период всё равно будет совпадать с датой документа
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА Сделка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА ""на прием эмиссионных ценных бумаг/инвестиционных паев""
		|		КОГДА Сделка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|			ТОГДА ""на вывод эмиссионных ценных бумаг/инвестиционных паев""
		|	КОНЕЦ КАК ВидПоручения,
		|	Сделка.Номер КАК Номер,
		|	ВЫБОР
		|		КОГДА Сделка.ОтложенноеИсполнение
		|			ТОГДА ВЫБОР
		|					КОГДА Сделка.РаздельноеИсполнение
		|						ТОГДА Сделка.Дата
		|					ИНАЧЕ Сделка.ДатаИсполнения
		|				КОНЕЦ
		|		ИНАЧЕ Сделка.Дата
		|	КОНЕЦ КАК Дата,
		|	ПРЕДСТАВЛЕНИЕ(Сделка.Рынок) КАК РынокПредставление,
		|	Сделка.МестоХранения КАК МестоХранения,
		|	Сделка.Брокер КАК Брокер,
		|	ВЫБОР
		|		КОГДА Сделка.Контрагент = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА ""Контрагенты БК РЕГИОН""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА Сделка.Контрагент.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
		|					ТОГДА РеквизитыЮрКонтрагентаСрезПоследних.ПолноеНаименованиеПоУставу
		|				КОГДА Сделка.Контрагент.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|					ТОГДА РеквизитыФизКонтрагентаСрезПоследних.Фамилия + "" "" + РеквизитыФизКонтрагентаСрезПоследних.Имя + "" "" + РеквизитыФизКонтрагентаСрезПоследних.Отчество
		|			КОНЕЦ
		|	КОНЕЦ КАК КонтрагентПолноеНаименование,
		|	СделкаЦенныеБумаги.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|	ВЫБОР
		|		КОГДА СделкаЦенныеБумаги.ДепозитарныйСчет.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета)
		|			ТОГДА СделкаЦенныеБумаги.ДепозитарныйСчет.Родитель.НомерСчета
		|		ИНАЧЕ СделкаЦенныеБумаги.ДепозитарныйСчет.НомерСчета
		|	КОНЕЦ КАК НомерДепозитарногоСчета,
		|	ВЫБОР
		|		КОГДА СделкаЦенныеБумаги.ДепозитарныйСчет.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета)
		|			ТОГДА СделкаЦенныеБумаги.ДепозитарныйСчет.НомерСчета
		|		ИНАЧЕ "" ""
		|	КОНЕЦ КАК НомерРазделаДепозитарногоСчета,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА РеквизитыПИФСрезПоследних.КраткоеНаименованиеФонда
		|		ИНАЧЕ РеквизитыЭмитентаСрезПоследних.КраткоеНаименованиеПоУставу
		|	КОНЕЦ КАК ЦеннаяБумагаЭмитентПредставление,
		|	СделкаЦенныеБумаги.ЦеннаяБумага.ГосударственныйРегистрационныйНомер КАК ЦеннаяБумагаРегистрационныйНомер,
		|	СделкаЦенныеБумаги.Количество КАК Количество,
		|	КонтактныеЛица.КонтактноеЛицо.Представление КАК КонтактноеЛицо,
		|	КонтактныеЛица.Должность КАК Должность,
		|	КонтактныеЛица.ОснованиеПолномочий КАК ОснованиеПолномочий,
		|	Сделка.СчетДоверительногоУправления.КодСчета КАК СчетДоверительногоУправленияКод,
		|	Сделка.Организация КАК Организация,
		|	Сделка.Организация.ПрефиксНумерации КАК ОрганизацияПрефиксНумерации,
		|	ЗначенияДополнительныхСведенийБКАдрес.Значение КАК Адрес,
		|	ЗначенияДополнительныхСведенийБКТелефон.Значение КАК Телефон,
		|	КонтактнаяИнформацияБКСайт.Представление КАК Сайт
		|ИЗ
		|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
		|		ПО СделкаЦенныеБумаги.Ссылка = Сделка.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮрКонтрагентаСрезПоследних
		|		ПО (Сделка.Контрагент = РеквизитыЮрКонтрагентаСрезПоследних.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизКонтрагентаСрезПоследних
		|		ПО (Сделка.Контрагент = РеквизитыФизКонтрагентаСрезПоследних.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&Период, ) КАК РеквизитыПИФСрезПоследних
		|		ПО (ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЭмитентаСрезПоследних
		|		ПО СделкаЦенныеБумаги.ЦеннаяБумага.Эмитент.ЮрФизЛицо = РеквизитыЭмитентаСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|		ПО СделкаЦенныеБумаги.Ссылка.Организация.ЮрФизЛицо = КонтактныеЛица.Объект
		|			И (КонтактныеЛица.КонтактноеЛицо = &Подписант)
		|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ВебСтраница)
		|					И Объект = &БКРегион) КАК КонтактнаяИнформацияБКСайт
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийБКАдрес
		|		ПО (ЗначенияДополнительныхСведенийБКАдрес.Объект = &БКРегион)
		|			И (ЗначенияДополнительныхСведенийБКАдрес.Свойство.Ключ = ""АдресЮрЛицаДляПечати"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийБКТелефон
		|		ПО (ЗначенияДополнительныхСведенийБКТелефон.Объект = &БКРегион)
		|			И (ЗначенияДополнительныхСведенийБКТелефон.Свойство.Ключ = ""ТелефонЮрЛицаДляПечати"")
		|ГДЕ
		|	Сделка.Ссылка = &Ссылка";
		
	БКРегион = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион");
	
	Запрос.УстановитьПараметр("Ссылка"		, Сделка);
	Запрос.УстановитьПараметр("Период"		, Сделка.Дата);
	Запрос.УстановитьПараметр("Организация"	, Организация);
	Запрос.УстановитьПараметр("Подписант"	, Подписант);
	Запрос.УстановитьПараметр("БКРегион"	, ?(ЗначениеЗаполнено(БКРегион), БКРегион.ЮрФизЛицо, Неопределено));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	РеквизитыРаспоряжения = Новый Массив();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.КонтрагентПолноеНаименование) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В реквизитах контрагента сделки не заполнен реквизит 'Полное наименование по уставу' или Ф.И.О.!");
		КонецЕсли;
		
		СтрокаРеквизитыРаспоряжения = Новый Структура();
		
		Для каждого Колонка Из РезультатЗапроса.Колонки Цикл
			СтрокаРеквизитыРаспоряжения.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
		КонецЦикла;
		
		РеквизитыРаспоряжения.Добавить(СтрокаРеквизитыРаспоряжения);
		
	КонецЦикла;
	
	// проверим, что депозитарные счета по всех строках совпадают
	Для Инд = 1 По РеквизитыРаспоряжения.Количество() - 1 Цикл
		Если РеквизитыРаспоряжения[Инд - 1].ДепозитарныйСчет <> РеквизитыРаспоряжения[Инд].ДепозитарныйСчет Тогда
			Сообщить("Печать распоряжений по сделкам с несколькими депозитарными счетами временно не поддерживается.");
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат РеквизитыРаспоряжения;
	
КонецФункции // ПолучитьДанныеЭмиссионнойВнебиржевойСделки

&НаСервере
Функция ПолучитьДанныеСписанияЦенныхБумаг(СписаниеЦеннойБумаги, Подписант)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""на вывод эмиссионных ценных бумаг/инвестиционных паев"" КАК ВидПоручения,
		|	СписаниеЦеннойБумаги.Номер КАК Номер,
		|	СписаниеЦеннойБумаги.Дата КАК Дата,
		|	""Облигации"" КАК РынокПредставление,
		|	ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка) КАК МестоХранения,
		|	СписаниеЦеннойБумаги.ДепозитарныйСчет.Брокер КАК Брокер,
		|	"" "" КАК КонтрагентПолноеНаименование,
		|	СписаниеЦеннойБумаги.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|	ВЫБОР
		|		КОГДА СписаниеЦеннойБумаги.ДепозитарныйСчет.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета)
		|			ТОГДА СписаниеЦеннойБумаги.ДепозитарныйСчет.Родитель.НомерСчета
		|		ИНАЧЕ СписаниеЦеннойБумаги.ДепозитарныйСчет.НомерСчета
		|	КОНЕЦ КАК НомерДепозитарногоСчета,
		|	ВЫБОР
		|		КОГДА СписаниеЦеннойБумаги.ДепозитарныйСчет.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета)
		|			ТОГДА СписаниеЦеннойБумаги.ДепозитарныйСчет.НомерСчета
		|		ИНАЧЕ "" ""
		|	КОНЕЦ КАК НомерРазделаДепозитарногоСчета,
		|	СписаниеЦеннойБумаги.ЦеннаяБумага.ГосударственныйРегистрационныйНомер КАК ЦеннаяБумагаРегистрационныйНомер,
		|	РеквизитыЭмитентаСрезПоследних.КраткоеНаименованиеПоУставу КАК ЦеннаяБумагаЭмитентПредставление,
		|	СписаниеЦеннойБумаги.Количество КАК Количество,
		|	КонтактныеЛица.КонтактноеЛицо.Представление КАК КонтактноеЛицо,
		|	КонтактныеЛица.Должность КАК Должность,
		|	КонтактныеЛица.ОснованиеПолномочий КАК ОснованиеПолномочий,
		|	СписаниеЦеннойБумаги.СчетДоверительногоУправления.КодСчета КАК СчетДоверительногоУправленияКод,
		|	СписаниеЦеннойБумаги.Организация КАК Организация,
		|	СписаниеЦеннойБумаги.Организация.ПрефиксНумерации КАК ОрганизацияПрефиксНумерации,
		|	ЗначенияДополнительныхСведенийБКАдрес.Значение КАК Адрес,
		|	ЗначенияДополнительныхСведенийБКТелефон.Значение КАК Телефон,
		|	КонтактнаяИнформацияБКСайт.Представление КАК Сайт
		|ИЗ
		|	Документ.СписаниеЦеннойБумаги КАК СписаниеЦеннойБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЭмитентаСрезПоследних
		|		ПО СписаниеЦеннойБумаги.ЦеннаяБумага.Эмитент.ЮрФизЛицо = РеквизитыЭмитентаСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|		ПО СписаниеЦеннойБумаги.Организация.ЮрФизЛицо = КонтактныеЛица.Объект
		|			И (КонтактныеЛица.КонтактноеЛицо = &Подписант)
		|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ВебСтраница)
		|					И Объект = &БКРегион) КАК КонтактнаяИнформацияБКСайт
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийБКАдрес
		|		ПО (ЗначенияДополнительныхСведенийБКАдрес.Объект = &БКРегион)
		|			И (ЗначенияДополнительныхСведенийБКАдрес.Свойство.Ключ = ""АдресЮрЛицаДляПечати"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийБКТелефон
		|		ПО (ЗначенияДополнительныхСведенийБКТелефон.Объект = &БКРегион)
		|			И (ЗначенияДополнительныхСведенийБКТелефон.Свойство.Ключ = ""ТелефонЮрЛицаДляПечати"")
		|ГДЕ
		|	СписаниеЦеннойБумаги.Ссылка = &Ссылка";
		
	БКРегион = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион");
	
	Запрос.УстановитьПараметр("Ссылка"		, СписаниеЦеннойБумаги);
	Запрос.УстановитьПараметр("Период"		, СписаниеЦеннойБумаги.Дата);
	Запрос.УстановитьПараметр("Подписант"	, Подписант);
	Запрос.УстановитьПараметр("БКРегион"	, ?(ЗначениеЗаполнено(БКРегион), БКРегион.ЮрФизЛицо, Неопределено));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	РеквизитыРаспоряжения = Новый Массив();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.ЦеннаяБумагаЭмитентПредставление) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В реквизитах эмитента не заполнен реквизит 'Краткое наименование по уставу'!");
		КонецЕсли;
		
		СтрокаРеквизитыРаспоряжения = Новый Структура();
		
		Для каждого Колонка Из РезультатЗапроса.Колонки Цикл
			СтрокаРеквизитыРаспоряжения.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
		КонецЦикла;
		
		РеквизитыРаспоряжения.Добавить(СтрокаРеквизитыРаспоряжения);
		
	КонецЦикла;
	
	Возврат РеквизитыРаспоряжения;
	
КонецФункции // ПолучитьДанныеЭмиссионнойВнебиржевойСделки

&НаСервере
Функция ПолучитьДанныеВыводаЦенныхБумаг(ВыводЦенныхБумаг, Подписант)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""на вывод эмиссионных ценных бумаг/инвестиционных паев"" КАК ВидПоручения,
		|	ВыводЦенныхБумаг.Номер КАК Номер,
		|	ВыводЦенныхБумаг.Дата КАК Дата,
		|	ПРЕДСТАВЛЕНИЕ(ВыводЦенныхБумаг.Рынок) КАК РынокПредставление,
		|	ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка) КАК МестоХранения,
		|	"" "" КАК КонтрагентПолноеНаименование,
		|	ВыводЦенныхБумаг.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|	ВЫБОР
		|		КОГДА ВыводЦенныхБумаг.ДепозитарныйСчет.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета)
		|			ТОГДА ВыводЦенныхБумаг.ДепозитарныйСчет.Родитель.НомерСчета
		|		ИНАЧЕ ВыводЦенныхБумаг.ДепозитарныйСчет.НомерСчета
		|	КОНЕЦ КАК НомерДепозитарногоСчета,
		|	ВЫБОР
		|		КОГДА ВыводЦенныхБумаг.ДепозитарныйСчет.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета)
		|			ТОГДА ВыводЦенныхБумаг.ДепозитарныйСчет.НомерСчета
		|		ИНАЧЕ "" ""
		|	КОНЕЦ КАК НомерРазделаДепозитарногоСчета,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ВыводЦенныхБумагЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА РеквизитыПИФСрезПоследних.КраткоеНаименованиеФонда
		|		ИНАЧЕ РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу
		|	КОНЕЦ КАК ЦеннаяБумагаЭмитентПредставление,
		|	ВыводЦенныхБумагЦенныеБумаги.ЦеннаяБумага.ГосударственныйРегистрационныйНомер КАК ЦеннаяБумагаРегистрационныйНомер,
		|	ВыводЦенныхБумагЦенныеБумаги.Количество КАК Количество,
		|	КонтактныеЛица.КонтактноеЛицо.Представление КАК КонтактноеЛицо,
		|	КонтактныеЛица.Должность КАК Должность,
		|	КонтактныеЛица.ОснованиеПолномочий КАК ОснованиеПолномочий,
		|	ВыводЦенныхБумаг.СчетДоверительногоУправления.КодСчета КАК СчетДоверительногоУправленияКод,
		|	ВыводЦенныхБумаг.Организация КАК Организация,
		|	ВыводЦенныхБумаг.Организация.ПрефиксНумерации КАК ОрганизацияПрефиксНумерации,
		|	ЗначенияДополнительныхСведенийБКАдрес.Значение КАК Адрес,
		|	ЗначенияДополнительныхСведенийБКТелефон.Значение КАК Телефон,
		|	КонтактнаяИнформацияБКСайт.Представление КАК Сайт
		|ИЗ
		|	Документ.ВыводЦенныхБумаг.ЦенныеБумаги КАК ВыводЦенныхБумагЦенныеБумаги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыводЦенныхБумаг КАК ВыводЦенныхБумаг
		|		ПО ВыводЦенныхБумагЦенныеБумаги.Ссылка = ВыводЦенныхБумаг.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&Период, ) КАК РеквизитыПИФСрезПоследних
		|		ПО (ВЫРАЗИТЬ(ВыводЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ВыводЦенныхБумагЦенныеБумаги.ЦеннаяБумага.Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|		ПО ВыводЦенныхБумагЦенныеБумаги.Ссылка.Организация.ЮрФизЛицо = КонтактныеЛица.Объект
		|			И (КонтактныеЛица.КонтактноеЛицо = &Подписант)
		|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ВебСтраница)
		|					И Объект = &БКРегион) КАК КонтактнаяИнформацияБКСайт
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийБКАдрес
		|		ПО (ЗначенияДополнительныхСведенийБКАдрес.Объект = &БКРегион)
		|			И (ЗначенияДополнительныхСведенийБКАдрес.Свойство.Ключ = ""АдресЮрЛицаДляПечати"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийБКТелефон
		|		ПО (ЗначенияДополнительныхСведенийБКТелефон.Объект = &БКРегион)
		|			И (ЗначенияДополнительныхСведенийБКТелефон.Свойство.Ключ = ""ТелефонЮрЛицаДляПечати"")
		|ГДЕ
		|	ВыводЦенныхБумаг.Ссылка = &Ссылка";
		
	БКРегион = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион");
	
	Запрос.УстановитьПараметр("Ссылка"		, ВыводЦенныхБумаг);
	Запрос.УстановитьПараметр("Период"		, ВыводЦенныхБумаг.Дата);
	Запрос.УстановитьПараметр("Подписант"	, Подписант);
	Запрос.УстановитьПараметр("БКРегион"	, ?(ЗначениеЗаполнено(БКРегион), БКРегион.ЮрФизЛицо, Неопределено));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	РеквизитыРаспоряжения = Новый Массив();
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаРеквизитыРаспоряжения = Новый Структура();
		
		Для каждого Колонка Из РезультатЗапроса.Колонки Цикл
			СтрокаРеквизитыРаспоряжения.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
		КонецЦикла;
		
		РеквизитыРаспоряжения.Добавить(СтрокаРеквизитыРаспоряжения);
		
	КонецЦикла;
	
	Возврат РеквизитыРаспоряжения;
	
КонецФункции // ПолучитьДанныеВыводаЦенныхБумаг

&НаСервере
Функция ПолучитьДанныеПереводаЦенныхБумаг(ВыводЦенныхБумаг, Подписант)
	
