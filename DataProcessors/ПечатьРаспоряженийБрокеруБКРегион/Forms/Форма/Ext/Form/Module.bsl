&НаСервереБезКонтекста
Функция ПолучитьСотрудниковОрганизации(Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КонтактныеЛица.КонтактноеЛицо
		|ИЗ
		|	РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|ГДЕ
		|	КонтактныеЛица.Объект = &Объект";
		
	Запрос.УстановитьПараметр("Объект", Организация.ЮрФизЛицо);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КонтактноеЛицо");
	
КонецФункции // ПолучитьСотрудниковОрганизации

&НаСервере
Процедура ПолучитьРеквизитыФормы_Р1(ВерсияФормы, РеквизитыЗаполнения, РеквизитыРаспоряжения)
	
	РеквизитыЗаполнения.Вставить("ВидПоручения", 		"на вывод денежных средств");
	
	РеквизитыЗаполнения.Вставить("Получатель",    РеквизитыРаспоряжения.НаименованиеВладельцаДоговораПолучателяДляДокументов);
	РеквизитыЗаполнения.Вставить("Банк",          РеквизитыРаспоряжения.РасчетныйСчетПолучательБанк);
	РеквизитыЗаполнения.Вставить("РСчет",         РеквизитыРаспоряжения.РасчетныйСчетПолучатель);
	РеквизитыЗаполнения.Вставить("КСчет",         РеквизитыРаспоряжения.РасчетныйСчетПолучательКоррСчет);
	РеквизитыЗаполнения.Вставить("БИК",           РеквизитыРаспоряжения.РасчетныйСчетПолучательБИК);
	
	Если ВерсияФормы = "00010101" Тогда
		
		РеквизитыЗаполнения.Вставить("СуммаПрописью",  РеквизитыРаспоряжения.СуммаИСуммаПрописью);
		
		// источник списания д/с
		Если      РеквизитыРаспоряжения.МестоХранения = ПредопределенноеЗначение("Справочник.МестаХранения.ВнебиржевойРынок") Тогда
			НомСтрТаб = 1;
		ИначеЕсли РеквизитыРаспоряжения.МестоХранения = ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС")
			Или РеквизитыРаспоряжения.МестоХранения = ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ_Торговый")
			Тогда
			НомСтрТаб = 2;
		ИначеЕсли РеквизитыРаспоряжения.МестоХранения = ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ_Торговый+") Тогда
			НомСтрТаб = 3;
		Иначе
			НомСтрТаб = 4;
		КонецЕсли;
		
		ЗначенияТаблицыWord = ПолучитьЗначенияТаблицыWord(РеквизитыЗаполнения, 2);
		ЗначенияТаблицыWord.Добавить(ПолучитьЗначениеЯчейкиWord(НомСтрТаб, 3, РеквизитыРаспоряжения.СуммаИСуммаПрописью));
		
	ИначеЕсли ВерсияФормы = "20170405" Тогда
		
		РеквизитыЗаполнения.Вставить("СуммаПрописью",  РеквизитыРаспоряжения.СуммаИСуммаПрописью);
		РеквизитыЗаполнения.Вставить("ИННПолучателя",  РеквизитыРаспоряжения.ИННПолучателя);
		
		// источник списания д/с
		Если      РеквизитыРаспоряжения.МестоХранения = ПредопределенноеЗначение("Справочник.МестаХранения.ВнебиржевойРынок") Тогда
			НомСтрТаб = 1;
		ИначеЕсли РеквизитыРаспоряжения.МестоХранения = ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС")
			Или РеквизитыРаспоряжения.МестоХранения = ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ_Торговый")
			Тогда
			НомСтрТаб = 2;
