КонецФункции

&НаКлиенте
Функция СохранитьШаблонНаДиск(ДвоичныеДанные)
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("doc");
	ДвоичныеДанные.Записать(ВременныйФайл);
	
	Возврат ВременныйФайл;

КонецФункции

&НаКлиенте
Процедура УдалитьФайлШаблона(ПутьКФайлу)
	
	// удалим файл шаблона
	Попытка
		УдалитьФайлы(ПутьКФайлу);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьФайлWord(ДокументWord, ПутьКФайлу)
	
	ДокументWord.SaveAs(ПутьКФайлу);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыWord(ДокументWord, СтруктураРеквизитов)
	
	WordVars = ДокументWord.Variables;
	Для каждого КлючИЗнач из СтруктураРеквизитов Цикл
		Если КлючИЗнач.Ключ = "Таблицы" Тогда
			Для каждого КлючИзначТаб из КлючИЗнач.Значение Цикл
				ЗаполнитьТаблицуWord(ДокументWord.Tables(КлючИзначТаб.Ключ), КлючИзначТаб.Значение)	
			КонецЦикла;
		Иначе
			Переменная = WordVars.Item(КлючИЗнач.Ключ);
			Попытка
				
				Если КлючИЗнач.Значение = "" Тогда
					Переменная.Value = " ";
				Иначе
					Переменная.Value = КлючИЗнач.Значение;
				КонецЕсли;
				
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	ДокументWord.Fields.Update();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуWord(ТаблицаWord, МассивСтруктур)
	
	КоличествоСтрок = ТаблицаWord.Rows.Count;
	Для каждого Структура из МассивСтруктур Цикл
		
		Если КоличествоСтрок < Структура.Строка Тогда
			Для Сч = 1 По Структура.Строка - КоличествоСтрок Цикл
				ТаблицаWord.Rows.Add();	
			КонецЦикла;
			КоличествоСтрок = Структура.Строка;
		КонецЕсли;
		
		Ячейка = ТаблицаWord.Cell(Структура.Строка, Структура.Колонка);
		Попытка
			Ячейка.Range.InsertAfter(Структура.Значение);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗначениеЯчейкиWord(Строка, Колонка, Значение)
	
	Возврат Новый Структура("Строка, Колонка, Значение", Строка, Колонка, Значение)
	
КонецФункции

&НаСервере
Функция ПолучитьЗначенияТаблицыWord(СтруктураРеквизитов, НомерТаблицы)
	
	// Для вывода в Word таблицы в структуре реквизитов создается элемент с ключом Таблицы.
	// Значение ключа - Соответствие, с ключами, равными номерам таблиц в шаблоне Word,
	// значение - массив структур с ключами (Строка, Колонка, Значение) 
	// СтруктураРеквизитов("Таблицы", <Соответствие[Номер, Массив(Структура(Номер, Колонка, Значение))]>)
	
	ЗначениеТаблицы = Неопределено;
	Если Не СтруктураРеквизитов.Свойство("Таблицы", ЗначениеТаблицы) Тогда
		ЗначениеТаблицы = Новый Соответствие;
		СтруктураРеквизитов.Вставить("Таблицы", ЗначениеТаблицы);
	КонецЕсли;
	
	МассивСтруктур = ЗначениеТаблицы[НомерТаблицы];
	Если МассивСтруктур = Неопределено Тогда
		МассивСтруктур = Новый Массив;
		ЗначениеТаблицы.Вставить(НомерТаблицы, МассивСтруктур);
	КонецЕсли;
	
	Возврат МассивСтруктур;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ ФОРМЫ И ЕЁ ЭЛЕМЕНТОВ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Брокер_БК_Регион = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион");
	ЭтаФорма.СохранятьФайл = ПараметрыСеанса.ЭтоРабочаяИнформационнаяБаза;
	
	Если ЭтаФорма.Параметры.Свойство("Основание") Тогда
		Объект.Основание 	= ЭтаФорма.Параметры.Основание;
		Объект.Дата			= ЭтаФорма.Параметры.Основание.Дата;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// чтобы отработало восстановление сохраненных настроек или начальное заполнение
	Если ЗначениеЗаполнено(Объект.Основание) Тогда
		
		Если ПолучитьФормуРаспоряженияНаСервере(Отказ) = Неопределено Тогда
			Возврат;
		КонецЕсли;
			
		ОснованиеПриИзменении(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованиеПриИзменении(Элемент)
	
	ЭтаФорма.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Основание, "Организация");
	
	Если ЗначениеЗаполнено(ЭтаФорма.Организация) Тогда
		
		СотрудникиОрганизации = ПолучитьСотрудниковОрганизации(ЭтаФорма.Организация);
		
		Элементы.Подписант.СписокВыбора.ЗагрузитьЗначения(СотрудникиОрганизации);
			
		Если СотрудникиОрганизации.Количество() > 0 Тогда
			Объект.Подписант = СотрудникиОрганизации[0];
		Иначе
			Объект.Подписант = Неопределено;
		КонецЕсли;
		
	Иначе
		
		Элементы.Подписант.СписокВыбора.Очистить();
		
		Объект.Подписант = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСформироватьРаспоряжение(Команда)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
		
	ФормаРаспоряжения = ПолучитьФормуРаспоряженияНаСервере();
	
	Если ФормаРаспоряжения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьРаспоряжение(ФормаРаспоряжения);
	
КонецПроцедуры

