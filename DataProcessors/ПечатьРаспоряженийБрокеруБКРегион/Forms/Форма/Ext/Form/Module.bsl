&НаСервере
Процедура ПолучитьРеквизитыФормы_Р3Р5(ВерсияФормы, РеквизитыЗаполнения, РеквизитыРаспоряжения)
	
	РеквизитыЗаполнения.Вставить("ВидПоручения",    РеквизитыРаспоряжения.ВидПоручения);
	РеквизитыЗаполнения.Вставить("Контрагент",      РеквизитыРаспоряжения.КонтрагентПолноеНаименование);
	РеквизитыЗаполнения.Вставить("ДоговорКуплПрод", "_______________");
	РеквизитыЗаполнения.Вставить("СчетДЕПО",        РеквизитыРаспоряжения.НомерДепозитарногоСчета);
	РеквизитыЗаполнения.Вставить("РазделДеп",       РеквизитыРаспоряжения.НомерРазделаДепозитарногоСчета);
	
	Если ВерсияФормы = "00010101" Тогда
		
		ЗначенияТаблицыWord = ПолучитьЗначенияТаблицыWord(РеквизитыЗаполнения, 1);
		
		НомерСтроки = ЗначенияТаблицыWord.Количество() / 4;
		
		ЗначенияТаблицыWord.Добавить(ПолучитьЗначениеЯчейкиWord(НомерСтроки + 2, 1, РеквизитыРаспоряжения.ЦеннаяБумагаЭмитентПредставление));
		ЗначенияТаблицыWord.Добавить(ПолучитьЗначениеЯчейкиWord(НомерСтроки + 2, 2, РеквизитыРаспоряжения.РынокПредставление));
		ЗначенияТаблицыWord.Добавить(ПолучитьЗначениеЯчейкиWord(НомерСтроки + 2, 3, РеквизитыРаспоряжения.ЦеннаяБумагаРегистрационныйНомер));
		ЗначенияТаблицыWord.Добавить(ПолучитьЗначениеЯчейкиWord(НомерСтроки + 2, 4, РеквизитыРаспоряжения.Количество));
		
	ИначеЕсли ВерсияФормы = "20170405"
		ИЛИ ВерсияФормы = "20170608"
		ИЛИ ВерсияФормы = "20180101" 
		ИЛИ ВерсияФормы = "20181214"
	Тогда
		
		РеквизитыЗаполнения.Вставить("ЭмитентЦБ",  		РеквизитыРаспоряжения.ЦеннаяБумагаЭмитентПредставление);
		РеквизитыЗаполнения.Вставить("ВидЦБ", 	 		РеквизитыРаспоряжения.РынокПредставление);
		РеквизитыЗаполнения.Вставить("РегНомер",  		РеквизитыРаспоряжения.ЦеннаяБумагаРегистрационныйНомер);
		РеквизитыЗаполнения.Вставить("КоличествоЦБ",  	Строка(РеквизитыРаспоряжения.Количество));
		
	КонецЕсли;
	
КонецПроцедуры

