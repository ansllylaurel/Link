&НаСервере
Функция ПолучитьРеквизитыФормыМакета(СтруктураФормы)
	
	Перем ФормаМакета;
	Перем ВерсияФормы;
	
	ФормаМакета = СтруктураФормы.Форма;
	ВерсияФормы	= СтруктураФормы.Версия;
	
	// Структура реквизитов содержит реквизиты и таблицы (Ключ структуры = Таблицы).
	// Таблицы - соответствие, где значение - массив структур("Строка,Колонка,Значение")
			
	Если ФормаМакета = "Форма_Р1_ВыводДенежныхСредств" 
		или ФормаМакета = "Форма_Р2_ПереводДенежныхСредств" Тогда
		
		СтарыйВариантЗаполнения = Ложь;
		
		МассивРеквизитовРаспоряжения = Новый Массив;
		МассивРеквизитовРаспоряжения.Добавить(ПолучитьДанныеПорученияИлиПереводаДенежныхСредств(Объект.Основание, Объект.Подписант));
		
	ИначеЕсли ФормаМакета = "Форма_Р3_ПриемЭмиссионныхЦенныхБумаг" 
		или ФормаМакета = "Форма_Р4_ПереводЭмиссионныхЦенныхБумаг"
		или ФормаМакета = "Форма_Р5_ВыводЭмиссионныхЦенныхБумаг" Тогда
		
		СтарыйВариантЗаполнения = ВерсияФормы < "20170608";
		
		Если      ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.СписаниеЦеннойБумаги") Тогда
			МассивРеквизитовРаспоряжения = ПолучитьДанныеСписанияЦенныхБумаг(Объект.Основание, Объект.Подписант);
			
		ИначеЕсли ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ПереводЦенныхБумаг") Тогда
			МассивРеквизитовРаспоряжения = ПолучитьДанныеПереводаЦенныхБумаг(Объект.Основание, Объект.Подписант);
			
		ИначеЕсли ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ВыводЦенныхБумаг") Тогда
			МассивРеквизитовРаспоряжения = ПолучитьДанныеВыводаЦенныхБумаг(Объект.Основание, Объект.Подписант);
			
		Иначе
			МассивРеквизитовРаспоряжения = ПолучитьДанныеЭмиссионнойВнебиржевойСделки(Объект.Основание, Объект.Подписант);
			
		КонецЕсли;
				
	Иначе
		
		ВызватьИсключение "Не удалось получить данные для печати распоряжения. Обратитесь к разработчикам.";
		
	КонецЕсли;
	
	Если ВерсияФормы >= "20170608" Тогда
		ФорматДаты = "ДФ='«dd» MMMM yyyy ''г.'''";
	Иначе
		ФорматДаты = "ДФ=dd.MM.yyyy";
	КонецЕсли;
	
	// договор с брокером
	РеквизитыДоговораСБрокером = ПолучитьРеквизитыДоговораСБрокером(Объект.Основание);
	
	МассивРеквизитовЗаполнения = Новый Массив;
	Для каждого РеквизитыРаспоряжения из МассивРеквизитовРаспоряжения Цикл
	
		РеквизитыЗаполнения = Новый Структура;
		МассивРеквизитовЗаполнения.Добавить(РеквизитыЗаполнения);
		
		РеквизитыЗаполнения.Вставить("Дата",		РеквизитыРаспоряжения.Дата);
		РеквизитыЗаполнения.Вставить("Организация",	РеквизитыРаспоряжения.Организация);
		
		Если СтарыйВариантЗаполнения Тогда
			
			РеквизитыЗаполнения.Вставить("НомерДатаДоговора", "№ " + РеквизитыДоговораСБрокером.НомерДоговора + " от " + Формат(РеквизитыДоговораСБрокером.ДатаДоговора, ФорматДаты));	
			РеквизитыЗаполнения.Вставить("ИСНомер",           РеквизитыДоговораСБрокером.НомерИнвестиционногоСчета);
			
		Иначе
			
			РеквизитыЗаполнения.Вставить("НомерДоговора", РеквизитыДоговораСБрокером.НомерДоговора);
			РеквизитыЗаполнения.Вставить("ДатаДоговора",  Формат(РеквизитыДоговораСБрокером.ДатаДоговора, ФорматДаты));
			РеквизитыЗаполнения.Вставить("СчетБрокера",	  РеквизитыДоговораСБрокером.НомерИнвестиционногоСчета);
			
		КонецЕсли;
		
		РеквизитыЗаполнения.Вставить("НомерИнвестиционногоСчета", РеквизитыДоговораСБрокером.НомерИнвестиционногоСчета);
		РеквизитыЗаполнения.Вставить("ПолеКлиент",                РеквизитыДоговораСБрокером.НаименованиеВладельцаДоговораДляДокументов);
		РеквизитыЗаполнения.Вставить("Подписант",                 РеквизитыРаспоряжения.Должность + " " + РеквизитыРаспоряжения.КонтактноеЛицо);
		РеквизитыЗаполнения.Вставить("Доверенность",              РеквизитыРаспоряжения.ОснованиеПолномочий);
		РеквизитыЗаполнения.Вставить("ДатаРаспоряжения",		  Формат(РеквизитыРаспоряжения.Дата, ФорматДаты));
		
		Объект.НомерПоследнегоРаспоряжения = Объект.НомерПоследнегоРаспоряжения + 1;
		РеквизитыЗаполнения.Вставить("НомерРаспоряжения", 
							РеквизитыРаспоряжения.ОрганизацияПрефиксНумерации + "-" + Формат(РеквизитыРаспоряжения.Дата, "ДФ=ddMMyy") + "-" + Объект.НомерПоследнегоРаспоряжения);
		
		Если ВерсияФормы >= "20181214" Тогда
			РеквизитыЗаполнения.Вставить("Адрес",	РеквизитыРаспоряжения.Адрес);
			РеквизитыЗаполнения.Вставить("Телефон",	РеквизитыРаспоряжения.Телефон);
			РеквизитыЗаполнения.Вставить("Сайт",	РеквизитыРаспоряжения.Сайт);
		КонецЕсли;
		
		Если ФормаМакета = "Форма_Р1_ВыводДенежныхСредств" Тогда
			ПолучитьРеквизитыФормы_Р1(ВерсияФормы, РеквизитыЗаполнения, РеквизитыРаспоряжения);
			
		ИначеЕсли ФормаМакета = "Форма_Р2_ПереводДенежныхСредств" Тогда
			ПолучитьРеквизитыФормы_Р2(ВерсияФормы, РеквизитыЗаполнения, РеквизитыРаспоряжения);
			
		ИначеЕсли ФормаМакета = "Форма_Р3_ПриемЭмиссионныхЦенныхБумаг"
			или ФормаМакета = "Форма_Р5_ВыводЭмиссионныхЦенныхБумаг" Тогда
			ПолучитьРеквизитыФормы_Р3Р5(ВерсияФормы, РеквизитыЗаполнения, РеквизитыРаспоряжения);
			
		ИначеЕсли ФормаМакета = "Форма_Р4_ПереводЭмиссионныхЦенныхБумаг" Тогда
			ПолучитьРеквизитыФормы_Р4(ВерсияФормы, РеквизитыЗаполнения, РеквизитыРаспоряжения);
			
		КонецЕсли;
		
	КонецЦикла;
		
	Возврат МассивРеквизитовЗаполнения; 

КонецФункции

&НаСервере
Функция ПолучитьШаблонРаспоряженияНаСервере(ИмяШаблона)
	
	ОбработкаНаСервере = РеквизитФормыВЗначение("Объект"); 
	Возврат ОбработкаНаСервере.ПолучитьМакет(ИмяШаблона);
	
КонецФункции // ПолучитьШаблонРаспоряженияНаСервере

&НаКлиенте
Процедура СформироватьРаспоряжение(СтруктураФормы) Экспорт
	
	// получим данные для распоряжения
	МассивРеквизитовРаспоряжения = ПолучитьРеквизитыФормыМакета(СтруктураФормы);
	
	// создадим документ MS Word на основании сохраненного шаблона
	WordApp = СоздатьОбъектWord(Истина);
	
	Попытка
		
		ПутьКФайлуШаблона = СохранитьШаблонНаДиск(ПолучитьШаблонРаспоряженияНаСервере(СтруктураФормы.Макет));
		
		Для каждого РеквизитыРаспоряжения из МассивРеквизитовРаспоряжения Цикл
			
			NewDoc = ДобавитьДокументWord(WordApp, ПутьКФайлуШаблона);
			
			ЗаполнитьПараметрыWord(NewDoc, РеквизитыРаспоряжения);
			
			Если ЭтаФорма.СохранятьФайл Тогда
				ПутьКФайлу = ПолучитьПутьКФайлу(СтруктураФормы.Форма, РеквизитыРаспоряжения, СтруктураФормы.Расширение);
				Если ЗначениеЗаполнено(ПутьКФайлу) Тогда
					СохранитьФайлWord(NewDoc, ПутьКФайлу);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		WordApp.Application.Activate();
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
	
	УдалитьФайлШаблона(ПутьКФайлуШаблона);
	
КонецПроцедуры // СформироватьРаспоряжение

&НаКлиенте
Функция ПолучитьПутьКФайлу(ФормаРаспоряжения, РеквизитыРаспоряжения, Расширение)
	
	Если ФормаРаспоряжения = "Форма_Р1_ВыводДенежныхСредств" Тогда
		
		ИмяФайла    = "Р-1_Поручение на возврат_";	
		ИмяКаталога = "КаталогПорученийБКРЕГИОНПоДС";
	
	ИначеЕсли ФормаРаспоряжения = "Форма_Р2_ПереводДенежныхСредств" Тогда 
		
		ИмяФайла    = "Р-2_Перевод между портфелями_";	
		ИмяКаталога = "КаталогПорученийБКРЕГИОНПоДС";
		
	ИначеЕсли ФормаРаспоряжения = "Форма_Р3_ПриемЭмиссионныхЦенныхБумаг" Тогда
		
		ИмяФайла    = "Р-3_Поручение на прием ЦБ_";	
		ИмяКаталога = "КаталогПорученийБКРЕГИОННаВводЦБ";
		
	ИначеЕсли ФормаРаспоряжения = "Форма_Р4_ПереводЭмиссионныхЦенныхБумаг" Тогда
		
		ИмяФайла    = "Р-4_Поручение на перевод ЦБ_";	
		ИмяКаталога = "КаталогПорученийБКРЕГИОННаВыводЦБ";
		
	ИначеЕсли ФормаРаспоряжения = "Форма_Р5_ВыводЭмиссионныхЦенныхБумаг" Тогда
		
		ИмяФайла    = "Р-5_Поручение на прием ЦБ_";	
		ИмяКаталога = "КаталогПорученийБКРЕГИОННаВводЦБ";
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для формы """ + ФормаРаспоряжения + """ не задан каталог сохранения");
		Возврат "";
		
	КонецЕсли;
	
	КаталогРаспоряжений = ПолучитьИмяКаталогаПоручений(ИмяКаталога, РеквизитыРаспоряжения.Организация, РеквизитыРаспоряжения.Дата);
	
	Если ЗначениеЗаполнено(КаталогРаспоряжений) Тогда
		
		КаталогФайлов = Новый Файл(КаталогРаспоряжений);
		Если Не КаталогФайлов.Существует() Тогда
			СоздатьКаталог(КаталогРаспоряжений);
		КонецЕсли;
		
		ПутьКФайлу = КаталогРаспоряжений 
					+ ИмяФайла
					+ РеквизитыРаспоряжения.НомерИнвестиционногоСчета
					+ "_" + Формат(РеквизитыРаспоряжения.ДатаРаспоряжения,"ДФ=ddMMyy")
					+ "_" + Объект.НомерПоследнегоРаспоряжения + "." + Расширение;
				
	КонецЕсли;
	
	Возврат ПутьКФайлу;

КонецФункции // ПолучитьПутьКФайлу

&НаСервереБезКонтекста
Функция ПолучитьИмяКаталогаПоручений(ДопСведение, Организация, ДатаОстатков)
	
	Возврат ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации(ДопСведение, Организация, ДатаОстатков);
	
КонецФункции // ПолучитьИмяФайлаОстатков

&НаСервере
Функция ПолучитьФормуРаспоряженияНаСервере(Отказ = Неопределено) Экспорт
	
	Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ПереводДенежныхСредств") Или ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ПоручениеНаПереводДенежныхСредств") Тогда
		
		РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Основание, "Брокер, БрокерПолучатель");
		
		Если      РеквизитыОснования.Брокер = Брокер_БК_Регион 
				И РеквизитыОснования.БрокерПолучатель = Брокер_БК_Регион Тогда
			
			ФормаМакета = "Форма_Р2_ПереводДенежныхСредств";
			
		ИначеЕсли РеквизитыОснования.Брокер = Брокер_БК_Регион 
			И РеквизитыОснования.БрокерПолучатель = ПредопределенноеЗначение("Справочник.БрокерскиеКомпании.ПустаяСсылка") Тогда
			
			ФормаМакета = "Форма_Р1_ВыводДенежныхСредств";

		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Печать распоряжения не возможна, т.к. перевод не соответствует выводу или переводу д/с на брокера " + ЭтаФорма.Брокер_БК_Регион + ".",,"Объект.Основание",, Отказ);
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.Сделка") Тогда
		
		РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Основание, "ВидСделки, Рынок, МестоХранения, Брокер");
		
		Если РеквизитыОснования.МестоХранения <> ПредопределенноеЗначение("Справочник.МестаХранения.ВнебиржевойРынок")
			Или РеквизитыОснования.Брокер <> ЭтаФорма.Брокер_БК_Регион 
			Или РеквизитыОснования.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Векселя")
		Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Печать распоряжения не возможна, т.к. сделка не соответствует эмиссионной внебиржевой покупке или продаже через брокера " + ЭтаФорма.Брокер_БК_Регион + ".",,"Объект.Основание",, Отказ);
			Возврат Неопределено;
		КонецЕсли;
		
		Если      РеквизитыОснования.ВидСделки = ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка") Тогда
			ФормаМакета = "Форма_Р3_ПриемЭмиссионныхЦенныхБумаг";

		ИначеЕсли РеквизитыОснования.ВидСделки = ПредопределенноеЗначение("Перечисление.ВидыСделок.Продажа") Тогда
			ФормаМакета = "Форма_Р5_ВыводЭмиссионныхЦенныхБумаг";
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.СписаниеЦеннойБумаги") Тогда
		
		Брокер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Основание, "ДепозитарныйСчет"), "Брокер");
		
		Если Брокер <> ЭтаФорма.Брокер_БК_Регион Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Печать распоряжения не возможна, т.к. не выбран раздел депозитарного счета, относящийся к брокеру " + ЭтаФорма.Брокер_БК_Регион + ".",,"Объект.Основание",, Отказ);
			Возврат Неопределено;
		КонецЕсли;
		
		ФормаМакета = "Форма_Р5_ВыводЭмиссионныхЦенныхБумаг";
		
	ИначеЕсли ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ВыводЦенныхБумаг") Тогда
		
		ФормаМакета = "Форма_Р5_ВыводЭмиссионныхЦенныхБумаг";
		
	ИначеЕсли ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ПереводЦенныхБумаг") Тогда
		
		БрокерОткуда = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Основание, "ДепозитарныйСчет"), "Брокер");
			
		БрокерКуда = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Основание, "ДепозитарныйСчетПолучатель"), "Брокер");
		
		Если БрокерОткуда <> БрокерКуда Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Печать распоряжения не возможна, т.к. счета находятся у разных брокеров.",,,, Отказ);
			Возврат Неопределено;
		ИначеЕсли БрокерОткуда <> ЭтаФорма.Брокер_БК_Регион Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Печать распоряжения не возможна, т.к. не выбран раздел депозитарного счета, относящийся к брокеру " + ЭтаФорма.Брокер_БК_Регион + ".",,"Объект.Основание",, Отказ);
			Возврат Неопределено;
		КонецЕсли;
		
		ФормаМакета = "Форма_Р4_ПереводЭмиссионныхЦенныхБумаг";
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить форму распоряжения для документа " + Объект.Основание + ".",,"Объект.Основание",, Отказ);
		Возврат Неопределено;
		
	КонецЕсли;
	
	Возврат ПолучитьИмяМакетаНаСервере(ФормаМакета);
	
КонецФункции // ПолучитьФормуРаспоряжения

&НаСервере
Функция ПолучитьИмяМакетаНаСервере(ФормаМакета) Экспорт
	
	ОбработкаОбъект   = РеквизитФормыВЗначение("Объект");
	
	ДлинаИмени = СтрДлина(ФормаМакета);
	ДатаСтрока = Формат(Объект.Дата, "ДФ=yyyyMMdd");
	
 	ПодходящаяФорма = "";
	МакетыОбработки = ОбработкаОбъект.Метаданные().Макеты;
	Для каждого Макет из МакетыОбработки Цикл
		
		Если Лев(Макет.Имя, 5) <> "Форма" Тогда
			Продолжить;
		КонецЕсли;
		
		Если Лев(Макет.Имя, ДлинаИмени) = ФормаМакета Тогда
			
			ДатаВерсии = Прав(Макет.Имя, 8);
			Если ДатаВерсии < ДатаСтрока Тогда
				
				Если ПодходящаяФорма < Макет.Имя Тогда
					ПодходящаяФорма = Макет.Имя;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ПодходящийМакет = МакетыОбработки[ПодходящаяФорма];
	Результат = Новый Структура("Макет, Форма, Версия, Расширение", 
		ПодходящийМакет.Имя, 
		Лев(ПодходящийМакет.Имя, СтрДлина(ПодходящийМакет.Имя) - 9), 
		Прав(ПодходящийМакет.Имя, 8), 
		ПодходящийМакет.Комментарий);
	
	Возврат Результат;
	
КонецФункции

