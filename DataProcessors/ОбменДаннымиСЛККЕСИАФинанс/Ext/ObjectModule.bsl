Функция ПолучитьДату(ДатаСтр)
	
	Если Не ЗначениеЗаполнено(ДатаСтр) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	//10.06.2021 -> 20210610
	ЧастиТекДаты = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ДатаСтр, ".", Истина, Истина);

	ТекДата = "";
	
	Для Инд = 1 - ЧастиТекДаты.Количество() По 0 Цикл	
		ТекДата = ТекДата + ЧастиТекДаты[-Инд];	
	КонецЦикла;
		
	Возврат Дата(ТекДата);
	
КонецФункции

Функция ПолучитьВидДокумента(ДокументЕсиа, Страна)
	
	Если ДокументЕсиа = "passport" Тогда
		
		Если Страна = Справочники.СтраныМира.Россия Тогда
			Возврат Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ;
		Иначе
			Возврат Справочники.ВидыДокументовФизическихЛиц.ПаспортИностранногоГражданина;	
		Конецесли;
		
	ИначеЕсли ДокументЕсиа = "driver_license" Тогда
		Возврат Справочники.ВидыДокументовФизическихЛиц.ВодительскоеУдостоверение;	
	ИначеЕсли ДокументЕсиа = "residence_permit" Тогда
		Возврат Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство; 
	Иначе
		Возврат Неопределено;
	КонецЕсли; 
		
КонецФункции
	
Функция ПолучиьОписаниеПубличногоЛица(Организация, Должность, Адрес)
	
	Описание = ?(ЗначениеЗаполнено(Организация), "Наимнование организации " + Организация, "");
	Описание = Описание + ?(ЗначениеЗаполнено(Должность), "должность " + Должность, "");
	Описание = Описание + ?(ЗначениеЗаполнено(Адрес), "адрес организации " + Адрес, "");
	
КонецФункции

Функция ПолучитьВидЗаявки(ВидЗаявкиЕсиа)
	
	Если ВидЗаявкиЕсиа = "pifs_purchase" Тогда
		Возврат Перечисления.ВидыЗаявокПайщиков.Зачисление;	
	ИначеЕсли ВидЗаявкиЕсиа = "pifs_selling" Тогда
		Возврат Перечисления.ВидыЗаявокПайщиков.Погашение;
	ИначеЕсли ВидЗаявкиЕсиа = "pifs_exchange" Тогда
		Возврат Перечисления.ВидыЗаявокПайщиков.Обмен;	
	Иначе
		ЗафиксироватьСообщение("Не удалось определить вид заявки пайщика по значению [" + ВидЗаявкиЕсиа + "]");
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция ПолучитьСтатусЗаявки(СтатусЕсиа) 
	
	СтатусыЗаявок = Новый Соответствие;
	СтатусыЗаявок.Вставить("draft", "Черновик");
	СтатусыЗаявок.Вставить("order_draft", "Черновик Винвестор");
	СтатусыЗаявок.Вставить("in_queue", "Новая");
	СтатусыЗаявок.Вставить("in_process", "В работе");
	СтатусыЗаявок.Вставить("elaboration", "Необходимы уточнения");
	СтатусыЗаявок.Вставить("wait_for_sign", "Требуется подпись");
	СтатусыЗаявок.Вставить("done", "Исполнена");
	СтатусыЗаявок.Вставить("rejected", "Отклонена");
	СтатусыЗаявок.Вставить("wrong", "Ошибочная");
	СтатусыЗаявок.Вставить("cancel", "Отменена");
	
	Статус = СтатусыЗаявок.Получить(СтатусЕсиа);
	
	Если Статус = Неопределено Тогда 	
		ЗафиксироватьСообщение("Не удалось определить статус заявки пайщика по значению [" + СтатусЕсиа + "]");
		Возврат Неопределено;
	Иначе
		Возврат Статус + " (" + СтатусЕсиа + ")"; 
	КонецЕсли;
		
КонецФункции

Функция ПолучитьПараметрыПодключения(ContentType = "application/json") Экспорт
	
	Возврат РаботаСВнешнимиСистемами.ЕСИА_Финанс_ПараметрыПодключения(ЭтотОбъект.Организация, ContentType);
	
КонецФункции

Процедура ЗафиксироватьСообщение(ТекстСообщения, Ошибка = Истина, Отказ = Ложь)
	
	Если Ошибка Тогда
	
		Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
			ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстСообщения);	
		Иначе
			ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", РаботаСКоллекциями.ЗначениеВМассив(ТекстСообщения));	
		КонецЕсли;
		
		Отказ = Истина;
		
	Иначе
		ЭтотОбъект.Результат.ДобавитьСтроку(ТекстСообщения);	
	КонецЕсли;
		
КонецПроцедуры

Процедура ОповеститьОбОшибках(ТекстОшибки = Неопределено) Экспорт
	
	Если ТекстОшибки <> Неопределено Тогда
		ЗафиксироватьСообщение(ТекстОшибки);	
	КонецЕсли;
		
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС); 
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
		
	ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");
	
КонецПроцедуры

Функция ПолучитьСтрокуJSON(Данные, ПараметрыЗаписи = Неопределено)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	
    Если ПараметрыЗаписи = Неопределено Тогда
		ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	Иначе
		ПараметрыЗаписиJSON = ПараметрыЗаписи;	
	КонецЕсли;
	
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	ЗаписатьJSON(ЗаписьJSON, Данные,,);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Возврат СтрокаJSON;
	
КонецФункции

Функция ДесериализоватьСтрокуJSON(СтрокаJSON, ИзменитьЧисловыеКлючи = Ложь)
	
	Если ИзменитьЧисловыеКлючи Тогда
		СтрокаJSON = СтрЗаменить(СтрокаJSON, """0"":", """НольСтр"":");
		СтрокаJSON = СтрЗаменить(СтрокаJSON, """1"":", """ОдинСтр"":");
		СтрокаJSON = СтрЗаменить(СтрокаJSON, """2"":", """ДваСтр"":");
	    СтрокаJSON = СтрЗаменить(СтрокаJSON, """3"":", """ТриСтр"":");
	    СтрокаJSON = СтрЗаменить(СтрокаJSON, """4"":", """ЧетыреСтр"":");
		СтрокаJSON = СтрЗаменить(СтрокаJSON, """5"":", """ПатьСтр"":");
	    СтрокаJSON = СтрЗаменить(СтрокаJSON, """6"":", """ШестьСтр"":");
	    СтрокаJSON = СтрЗаменить(СтрокаJSON, """7"":", """СемьСтр"":");
	    СтрокаJSON = СтрЗаменить(СтрокаJSON, """8"":", """ВосемьСтр"":");
		СтрокаJSON = СтрЗаменить(СтрокаJSON, """9"":", """ДевятьСтр"":");
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON();
    ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Возврат ПрочитатьJSON(ЧтениеJSON);
	
КонецФункции

Процедура ИмпортироватьАнкеты() Экспорт
	
	ПараметрыПодключения = ПолучитьПараметрыПодключения();
		
	ТекстСообщения = "Не удалось получить данные пользователей из системы ЕСИА.Финанс"; 
	
	//1 получаем коды вновь созданных пользователей
	//2 получаем коды пользователей с измененными данными
	ПараметрыЗапроса = РаботаСКоллекциями.ЗначенияВМассив("created_at", "updated_at");
	
	МассивИдентификаторов = Новый Массив;

	Для Каждого ТекПараметр Из ПараметрыЗапроса Цикл
	
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("GET", ПараметрыПодключения, "/api/v1/back_office/users?filter%5B" + ТекПараметр + "%5D%5Bgt%5D=" + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy"),, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
		
		ДанныеЕсиа = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
			
		Если Не (ТипЗнч(ДанныеЕсиа) = Тип("Структура") И ДанныеЕсиа.Свойство("success") И ДанныеЕсиа.success И ДанныеЕсиа.Свойство("users")) Тогда			
			ЗафиксироватьСообщение(ТекстСообщения);	
		    Возврат;	
		КонецЕсли;
		
		Для Каждого ТекПользователь Из ДанныеЕсиа.users Цикл		
			
			Если МассивИдентификаторов.Найти(ТекПользователь.id) = Неопределено Тогда 
				МассивИдентификаторов.Добавить(Строка(ТекПользователь.id));
			КонецЕсли;
				
		КонецЦикла;
		
	КонецЦикла;
	
	//ФильтрСтр = "?filter%5Bstatus%5D=in_queue&filter%5Bkind%5D=person_info_change&filter%5Bcreated_at%5D%5Bgt%5D=" + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy");  
	
	Если МассивИдентификаторов.Количество() = 0 Тогда
		ЗафиксироватьСообщение("Отсутствуют данные для загрузки.", Ложь);
		Возврат;
	КонецЕсли;
	
	//Если по коду ЕСИА найдено физ.лицо - не загружаем анкету.	
	Запрос = Новый Запрос;

#Область Текст_Запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ПОМЕСТИТЬ _КодыВоВнешнихСистемах
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица))) КАК КодыВоВнешнихСистемахСрезПоследних
		|ГДЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Код В(&МассивИдентификаторов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КодыПайщиков.Объект КАК Ссылка,
		|	_КодыПайщиков.Код КАК ИдентификаторПользователя,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Регистратор КАК АнкетаСсылка,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Период КАК ДатаАнкетныхДанных 
		|ИЗ
		|	_КодыВоВнешнихСистемах КАК _КодыПайщиков
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&ДатаКонецДня,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И ЮрФизЛицо В
		|						(ВЫБРАТЬ
		|							_КодыПайщиков.Объект
		|						ИЗ
		|							_КодыВоВнешнихСистемах КАК _КодыПайщиков)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ПО _КодыПайщиков.Объект = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо";
		//|ГДЕ
		//|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Регистратор ЕСТЬ NULL";
		//|	РАЗНОСТЬДАТ(РеквизитыФизическихЛицАнкетныеСрезПоследних.Период, &ДатаНачалоДня, ДЕНЬ) > 0 
		
#КонецОбласти
	
	Запрос.УстановитьПараметр("МассивИдентификаторов", МассивИдентификаторов);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаНачалоДня", НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("ДатаКонецДня", КонецДня(ЭтотОбъект.Дата));
	
	ТаблицаАнкет = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ТекКод Из МассивИдентификаторов Цикл 
		
		СтрокаТаблицы = ТаблицаАнкет.Найти(ТекКод, "ИдентификаторПользователя");
		
		Если СтрокаТаблицы = Неопределено Тогда
			
			НоваяСтрока = ТаблицаАнкет.Добавить();
			НоваяСтрока.ИдентификаторПользователя = ТекКод;
			
		КонецЕсли;
			
	КонецЦикла;
				
	Если ТаблицаАнкет.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	ДанныеПользователей = ДесериализоватьДанныеПользователейЕсиа(ТаблицаАнкет, ПараметрыПодключения);
	
	Если ДанныеПользователей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	БанковскиеСчета = ДесериализоватьДанныеБанковскихСчетовЕсиа(ДанныеПользователей, ПараметрыПодключения);

	СформироватьИЗагрузитьАнкеты(ДанныеПользователей, БанковскиеСчета, Новый МенеджерВременныхТаблиц, ПараметрыПодключения); 
		
КонецПроцедуры

Функция ДесериализоватьДанныеЗаявокЕсиа(ОтветЕсиа, ПараметрыПодключения)
	
	ЗаявкиПайщиков = СформироватьТаблицуПриемник("ЗаявкиПайщиков");	
		
	Для Каждого ТекЗаявка Из ОтветЕсиа.claims Цикл
				
		Если ТекЗаявка.status <> "in_queue" Тогда
			Продолжить;
		КонецЕсли;
				
		Если Не (ТекЗаявка.Свойство("owner_type") И ТекЗаявка.owner_type = "Fund") Тогда
			Продолжить;	
		Конецесли;
		
		ТекДатаЗаявки = Дата(Лев(РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(ТекЗаявка.created_at), 14));
		
		Если ЭтотОбъект.Дата <> НачалоДня(ТекДатаЗаявки) Тогда
			Продолжить;
		КонецЕсли; 
		
		//устанавливаем фонду код (portfolio_code) такой-же как и идентификатор
		ТекстСообщения = "Не удалось получить данные фонда из системы ЕСИА.Финанс по id " + ТекЗаявка.owner_id;
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("GET", ПараметрыПодключения, "/api/v1/back_office/funds/" + ТекЗаявка.owner_id,, ТекстСообщения);
	
		Если HTTPОтвет = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		Иначе
			
			ДанныеФонда = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"), Истина);
			
			Если Не (ТипЗнч(ДанныеФонда) = Тип("Структура") И ДанныеФонда.Свойство("success") И ДанныеФонда.success) 
				Или Не ДанныеФонда.Свойство("fund") Тогда
				
				ЗафиксироватьСообщение("Не удалось получить данные фонда из системы ЕСИА.Финанс по id " + ТекЗаявка.owner_id);
				Продолжить;
				
			ИначеЕсли Строка(ТекЗаявка.owner_id) <> ДанныеФонда.fund.portfolio_code Тогда 
					
				ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("portfolio_code", ТекЗаявка.owner_id)); 
				
				ТекстСообщения = "Не удалось установить portfolio_code для фонда id " + ТекЗаявка.owner_id;
				
				HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("PUT", ПараметрыПодключения, "/api/v1/back_office/funds/" + ТекЗаявка.owner_id, ТелоЗапроса, ТекстСообщения);
				
				Если HTTPОтвет = Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					Продолжить;
				КонецЕсли;
				
				ОтветНаЗапрос = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
		
				Если Не (ТипЗнч(ОтветНаЗапрос) = Тип("Структура") И ОтветНаЗапрос.Свойство("success") И ОтветНаЗапрос.success) Тогда
					
					ЗафиксироватьСообщение("Не удалось установить portfolio_code для фонда id " + ТекЗаявка.owner_id);
					Продолжить;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;

		НоваяЗапись = ЗаявкиПайщиков.Добавить();
		
		НоваяЗапись.Идентификатор = ТекЗаявка.id;
		НоваяЗапись.ВидЗаявки = ПолучитьВидЗаявки(ТекЗаявка.kind);
		НоваяЗапись.Статус = ПолучитьСтатусЗаявки(ТекЗаявка.status);
		НоваяЗапись.ИдентификаторПользователя = ТекЗаявка.user_id;
		НоваяЗапись.НомерЗаявки = ТекЗаявка.inner_code;
		НоваяЗапись.ДатаЗаявки = ТекДатаЗаявки;
		
		НоваяЗапись.ИдентификаторПифа = ТекЗаявка.owner_id; 
		
		Если ТекЗаявка.Свойство("data") Тогда
			
			НоваяЗапись.Сумма = ?(ТекЗаявка.data.Свойство("amount"), ТекЗаявка.data.amount, 0);
			
			Если ТекЗаявка.data.Свойство("account_number") Тогда
				НоваяЗапись.НомерСчетаДепо = ТекЗаявка.data.account_number;
			Иначе
				
				Если ТекЗаявка.metadata.Свойство("is_with_open") И ТекЗаявка.metadata.is_with_open И ТекЗаявка.kind = "pifs_purchase" Тогда  
					
					НоваяЗапись.ОткрытьЗакрытьДепозитарныйСчет = Истина;
					
				Иначе
					ЗафиксироватьСообщение("При импорте заявки не удалось определить депозитарный счет, код ЕСИА.Финанс [" + ТекЗаявка.id + "].");
					НоваяЗапись.ЕстьОшибкиДанных = Истина;
				КонецЕсли;
				
			КонецЕсли; 
						
			Если ТекЗаявка.kind = "pifs_purchase" Тогда	
				
				НоваяЗапись.Количество = ?(ТекЗаявка.data.Свойство("pieces_amount"), ТекЗаявка.data.pieces_amount, 0); 
				
				НоваяЗапись.Многократная = (НоваяЗапись.ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Зачисление) И Не ТекЗаявка.data.Свойство("amount");

			ИначеЕсли ТекЗаявка.kind = "pifs_selling" Или ТекЗаявка.kind = "pifs_exchange" Тогда
			   
				Если ТекЗаявка.data.Свойство("count") Тогда
					НоваяЗапись.Количество = ТекЗаявка.data.count;
				Иначе
					ЗафиксироватьСообщение("При импорте заявки не удалось определить количество паев, код ЕСИА.Финанс [" + ТекЗаявка.id + "].");
					НоваяЗапись.ЕстьОшибкиДанных = Истина;
				КонецЕсли;
				
			КонецЕсли; 
			
			Если ТекЗаявка.kind = "pifs_exchange" Тогда
				
				НоваяЗапись.ИдентификаторПифаДляОбмена = ТекЗаявка.data.fund_to_id;
				
				Если ТекЗаявка.data.Свойство("account_number_to") Тогда
					НоваяЗапись.НомерСчетаДепоДляОбмена = ТекЗаявка.data.account_number_to;
				Иначе
					
					Если ТекЗаявка.metadata.Свойство("is_with_open") И ТекЗаявка.metadata.is_with_open Тогда 
						НоваяЗапись.ОткрытьДепозитарныйСчетДляОбмена = Истина;
					Иначе
						ЗафиксироватьСообщение("При импорте заявки [идентификатор ЕСИА.Финанс " + ТекЗаявка.id + "] не удалось определить депозитарный счет для обмена.");
						НоваяЗапись.ЕстьОшибкиДанных = Истина;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
									
			Если ТекЗаявка.data.Свойство("requisite_id") Тогда 
				НоваяЗапись.ИдентификаторРасчетногоСчета = ТекЗаявка.data.requisite_id;				
			Иначе
				ЗафиксироватьСообщение("Не удалось получить банковские реквизиты из заявки, код ЕСИА.Финанс [" + ТекЗаявка.id + "]");
				НоваяЗапись.ЕстьОшибкиДанных = Истина;
	            Продолжить;
			КонецЕсли;
			
			//получаем подпись
			//устанавливаем фонду код (portfolio_code) такой-же как и идентификатор
			ТекстСообщения = "Не удалось получить данные подписи заявки пайщика из системы ЕСИА.Финанс по id " + ТекЗаявка.id;
			
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("GET", ПараметрыПодключения, "/api/v1/back_office/claims/" + ТекЗаявка.id,, ТекстСообщения);
		
			Если HTTPОтвет = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				НоваяЗапись.ЕстьОшибкиДанных = Истина;
				Продолжить;
			Иначе
				
				ОтветНаЗапрос = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
				
				Если Не ОтветНаЗапрос.Свойство("Claim") Тогда
					ЗафиксироватьСообщение("Не удалось получить данные подписи заявки пайщика, код ЕСИА.Финанс [" + ТекЗаявка.id + "]");
					НоваяЗапись.ЕстьОшибкиДанных = Истина;
	            	Продолжить;
				КонецЕсли;
				
				ПолныеДанныеЗаявки = ОтветНаЗапрос.Claim;
				
				Если Не ПолныеДанныеЗаявки.Свойство("attachments") Тогда
					ЗафиксироватьСообщение("Не удалось получить данные подписи заявки пайщика, код ЕСИА.Финанс [" + ТекЗаявка.id + "]");
					НоваяЗапись.ЕстьОшибкиДанных = Истина;
	            	Продолжить;
				Конецесли; 
				
				//Из заявки получаем файлы для дальнейшей привязки к заявке пайщика
				НоваяЗапись.МассивФайлов = ПолучитьМассивФайлов(ПолныеДанныеЗаявки.attachments, ПараметрыПодключения);
				
				Для Каждого ТекВложение Из ПолныеДанныеЗаявки.attachments Цикл
										
					Если Не ((ТекВложение.kind = "pifs_purchase_with_account" Или ТекВложение.kind = "pifs_purchase" 
							Или ТекВложение.kind = "pifs_exchange" Или ТекВложение.kind = "pifs_selling") И СтрНачинаетсяС(ТекВложение.description, "Заявка")) Тогда
						Продолжить;		
					КонецЕсли;
					
					Если Не ТекВложение.Свойство("client_sign") Тогда 
						ЗафиксироватьСообщение("Не удалось получить данные подписи заявки пайщика, код ЕСИА.Финанс [" + ТекЗаявка.id + "]");
						НоваяЗапись.ЕстьОшибкиДанных = Истина;
	            		Продолжить;
					КонецЕсли;
					
					СтруктураПодписи = ТекВложение.client_sign;
					
					Если ПодписьВалидна(СтруктураПодписи) Тогда 
					
						МассивТелефонКод = СтрРазделить(СтруктураПодписи.identifier, "/");
						
						Телефон = МассивТелефонКод[0];
						
						НоваяЗапись.ПЭП_НомерТелефона = ?(СтрНайти(Телефон, "+") > 0, "+", "") + РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(Телефон);
						НоваяЗапись.ПЭП_Код = СокрЛП(МассивТелефонКод[1]);
						НоваяЗапись.ПЭП_ДатаВремяПодписи = Дата(Лев(РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(СтруктураПодписи.signed_at), 14));
						
						Прервать;
					Иначе
						ЗафиксироватьСообщение("Не удалось получить данные подписи заявки пайщика, код ЕСИА.Финанс [" + ТекЗаявка.id + "]");
						НоваяЗапись.ЕстьОшибкиДанных = Истина;
	            		Продолжить;	
					КонецЕсли;
					
				КонецЦикла;
				
				Если Не ЗначениеЗаполнено(НоваяЗапись.ПЭП_Код) Тогда
					ЗафиксироватьСообщение("Не удалось получить данные подписи заявки пайщика, код ЕСИА.Финанс [" + ТекЗаявка.id + "]");
					НоваяЗапись.ЕстьОшибкиДанных = Истина;	
				КонецЕсли;
						
			КонецЕсли;
			
		КонецЕсли;
								
	КонецЦикла;
	
	Возврат ЗаявкиПайщиков;
	
КонецФункции 

Функция ДесериализоватьДанныеПользователейЕсиа(ТаблицаАнкет, ПараметрыПодключения)
	
	ПользователиЕсиа = СформироватьТаблицуПриемник("ПользователиЕсиа");
									
	Для Каждого ТекЗапись Из ТаблицаАнкет Цикл
		
		СтрокаТаблицыПользователей = ПользователиЕсиа.Найти(ТекЗапись.ИдентификаторПользователя, "Идентификатор"); 
		
		Если СтрокаТаблицыПользователей <> Неопределено Тогда  //если у пользователя несколько заявок
			Продолжить;	
		КонецЕсли;
		
		ТекстСообщения = "Не удалось получить данные пользователя из системы ЕСИА.Финанс по id " + ТекЗапись.ИдентификаторПользователя;
		
		//1. получаем данные пользователя по идентификатору
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("GET", ПараметрыПодключения, "/api/v1/back_office/users/" + ТекЗапись.ИдентификаторПользователя,, ТекстСообщения);
	
		Если HTTPОтвет = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		Иначе
			
			ДанныеЕсиа = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
			
			Если Не (ТипЗнч(ДанныеЕсиа) = Тип("Структура") И ДанныеЕсиа.Свойство("success") И ДанныеЕсиа.success)
				Или Не ДанныеЕсиа.Свойство("user") Тогда
				
				ЗафиксироватьСообщение("Не удалось получить данные пользователя из системы ЕСИА.Финанс по id " + ТекЗапись.ИдентификаторПользователя);
				Продолжить;	
				
			КонецЕсли; 
			
			ДанныеПользователяЕсиа = ДанныеЕсиа.user;
						
			ЗначенияРеквизитовАнкеты = ПолучитьЗначенияРеквизитовАнкетыПользователя(ДанныеПользователяЕсиа, ПараметрыПодключения);
			
			Если ЗначенияРеквизитовАнкеты = Неопределено Тогда 
				Продолжить;
			КонецЕсли;
			
