Функция ДесериализоватьДанныеБанковскихСчетовЕсиа(ДанныеПользователей, ПараметрыПодключения) 
	
	ТаблицаБанковскихСчетов = СформироватьТаблицуПриемник("БанковскиеСчета");
	
	Для Каждого ТекПользователь Из ДанныеПользователей Цикл 
		
		ТекстСообщения = "Не удалось получить данные расчетных счетов пользователя из системы ЕСИА.Финанс по id пользователя " + ТекПользователь.Идентификатор;
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос(
			"GET", 
			ПараметрыПодключения, 
			"/api/v1/back_office/requisites?requisite_owner_type=User&requisite_owner_id=" + ТекПользователь.Идентификатор,
			, 
			ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		Иначе
			
			ДанныеЕсиа = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
			
			Если Не (ТипЗнч(ДанныеЕсиа) = Тип("Структура") И ДанныеЕсиа.Свойство("success") И ДанныеЕсиа.success)
				Или Не ДанныеЕсиа.Свойство("requisites") Тогда
				
				ЗафиксироватьСообщение("Не удалось получить данные счетов пользователя из системы ЕСИА.Финанс по id " + ТекПользователь.Идентификатор);
				Продолжить;	
				
			КонецЕсли;
			
			Для Каждого ТекСчет Из ДанныеЕсиа.requisites Цикл
				
				СтрокиТаблицыСчетов = ТаблицаБанковскихСчетов.НайтиСтроки(Новый Структура("ИдентификаторПользователя, НомерСчета", ТекПользователь.Идентификатор, ТекСчет.payment_account));
				
				Если СтрокиТаблицыСчетов.Количество() = 0 Тогда 
					
					НовыйСчет = ТаблицаБанковскихСчетов.Добавить();
					ПолучитьЗначенияБанковскихРеквизитов(НовыйСчет, ТекСчет);
	
				КонецЕсли;
		
			КонецЦикла;
				
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ТаблицаБанковскихСчетов; 
		
КонецФункции

