		|	И РАЗНОСТЬДАТ(ЕСТЬNULL(_ОбъектыУчетнойСистемы.ДатаАнкетныхДанных, ДАТАВРЕМЯ(2000, 1, 1)), &ДатаНачалоДня, ДЕНЬ) > 0";
	
#КонецОбласти

	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ЗаявкиПайщиков", ЗаявкиПайщиков);
	Запрос.УстановитьПараметр("ДатаНачалоДня", НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("ДатаКонецДня", КонецДня(ЭтотОбъект.Дата));
	
	ТаблицаАнкет = Запрос.Выполнить().Выгрузить(); 
	
	ОшибкиОпределенияПифов = МВТ.Таблицы["_ОшибкиОпределенияПифов"].ПолучитьДанные().Выбрать();
	
	Пока ОшибкиОпределенияПифов.Следующий() Цикл
		ЗафиксироватьСообщение("Не удалось определить ПИФ по коду системы ЕСИА.Финанс [" + ОшибкиОпределенияПифов.ИдентификаторПифа + "]");	
