		|			И (_ДанныеПользователей.Ссылка = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеФизЛицИзУчетнойСистемы КАК _СверкаПоИНН
		|		ПО _ДанныеПользователей.ИНН = _СверкаПоИНН.ИНН
		|			И _ДанныеПользователей.ДатаРождения = _СверкаПоИНН.ДатаРождения
		|			И (_ДанныеПользователей.Ссылка = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка))
