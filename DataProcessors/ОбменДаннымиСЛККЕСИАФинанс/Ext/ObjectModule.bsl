		|			И _ДанныеПользователей.ДатаРождения = _СверкаПоСНИЛС.ДатаРождения
		|			И (_ДанныеПользователей.Ссылка = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеФизЛицИзУчетнойСистемы КАК _СверкаПоФИО
		|		ПО _ДанныеПользователей.Фамилия = _СверкаПоФИО.Фамилия
		|			И _ДанныеПользователей.Имя = _СверкаПоФИО.Имя
		|			И _ДанныеПользователей.Отчество = _СверкаПоФИО.Отчество
		|			И _ДанныеПользователей.ДатаРождения = _СверкаПоФИО.ДатаРождения
		|			И (_ДанныеПользователей.Ссылка = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка))
		|;
		|
