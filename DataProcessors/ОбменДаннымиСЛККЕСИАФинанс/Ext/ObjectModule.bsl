	Пока ОшибкиДублейЗаявок.Следующий() Цикл
		ЗафиксироватьСообщение("Ошибка загрузки заявки пайщика. Из системы ЕСИА.Финанс для пользователя [" + ОшибкиДублейЗаявок.ИдентификаторПользователя + "] получено несколько заявок.");	
	КонецЦикла;
	
	ОшибкиСчетовДепо = МВТ.Таблицы["_ОшибкиОпределенияДепозитарныхСчетов"].ПолучитьДанные().Выбрать();
	
	Пока ОшибкиСчетовДепо.Следующий() Цикл
		ЗафиксироватьСообщение("Не удалось найти в 1С лицевой счет по номеру [" + ОшибкиСчетовДепо.НомерСчета + "].
								| Пользователь [" + ОшибкиСчетовДепо.Пайщик + "], ID заявки [" + ОшибкиСчетовДепо.ИдентификаторЗаявки + "]");	
	КонецЦикла;

	Если ТаблицаАнкет.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	ДанныеПользователей = ДесериализоватьДанныеПользователейЕсиа(ТаблицаАнкет, ПараметрыПодключения); //получаем данные пайщиков (физ лиц) на основании данных заявок
	БанковскиеСчета = ДесериализоватьДанныеБанковскихСчетовЕсиа(ДанныеПользователей, ПараметрыПодключения);
				
	//загружаем анкеты в 1С 
	СформироватьИЗагрузитьАнкеты(ДанныеПользователей, БанковскиеСчета, МВТ, ПараметрыПодключения);
				
#Область Текст_Запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеЗаявок.Идентификатор КАК Идентификатор,
		|	_ДанныеЗаявок.ВидЗаявки КАК ВидЗаявки,
		|	_ДанныеЗаявок.Статус КАК Статус,
		|	_ДанныеЗаявок.ИдентификаторПользователя КАК ИдентификаторПользователя,
		|	_ДанныеЗаявок.НомерЗаявки КАК НомерЗаявки,
		|	_ДанныеЗаявок.ДатаЗаявки КАК ДатаЗаявки,
		|	_ДанныеЗаявок.ИдентификаторПифа КАК ИдентификаторПифа,
		|	_ДанныеЗаявок.Сумма КАК Сумма,
		|	_ДанныеЗаявок.Количество КАК Количество,
		|	_ДанныеЗаявок.Многократная КАК Многократная,
		|	_ДанныеЗаявок.ПЭП_НомерТелефона КАК ПЭП_НомерТелефона,
		|	_ДанныеЗаявок.ПЭП_Код КАК ПЭП_Код,
		|	_ДанныеЗаявок.ПЭП_ДатаВремяПодписи КАК ПЭП_ДатаВремяПодписи,
		|	_ДанныеЗаявок.ОткрытьЗакрытьДепозитарныйСчет КАК ОткрытьЗакрытьДепозитарныйСчет,
		|	_ДанныеЗаявок.ОткрытьДепозитарныйСчетДляОбмена КАК ОткрытьДепозитарныйСчетВПаевомИнвестиционномФондеДляОбмена,
		|	_ОбъектыУчетнойСистемы.ЗаявкаПайщика КАК Ссылка,
		|	_ОбъектыУчетнойСистемы.Пайщик КАК Пайщик,
		|	_ОбъектыУчетнойСистемы.Пиф КАК ПаевойИнвестиционныйФонд,
		|	_ОбъектыУчетнойСистемы.ПифДляОбмена КАК ПаевойИнвестиционныйФондДляОбменаПаев,
		|	_ДанныеБанковскихСчетов.Ссылка КАК РасчетныйСчет,
		|	_ДанныеБанковскихСчетов.ЮрФизЛицо КАК ВладелецСчета,
		|	_ДанныеБанковскихСчетов.Бик КАК БИК,
		|	_ДанныеБанковскихСчетов.КоррСчет КАК КоррСчет,
		|	_ДанныеБанковскихСчетов.НомерСчета КАК НомерСчета,
		|	_ДанныеБанковскихСчетов.ПолучательПлатежа КАК ПолучательПлатежа,
		|	_ДанныеБанковскихСчетов.ИННПолучателя КАК ИННПолучателя,
		|	_ДанныеБанковскихСчетов.НазначениеПлатежа КАК НазначениеПлатежа,
		|	_ДанныеБанковскихСчетов.НаименованиеБанка КАК НаименованиеБанка,
		|	_ДепозитарныеСчета.Ссылка КАК ДепозитарныйСчет,
		|	_ДепозитарныеСчетаДляОбмена.Ссылка КАК ДепозитарныйСчетВПаевомИнвестиционномФондеДляОбмена
		|ИЗ
		|	_ДанныеЗаявок КАК _ДанныеЗаявок
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОбъектыУчетнойСистемы КАК _ОбъектыУчетнойСистемы
		|		ПО _ДанныеЗаявок.Идентификатор = _ОбъектыУчетнойСистемы.Идентификатор
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиОпределенияПифов КАК _ОшибкиОпределенияПифов
		|		ПО _ДанныеЗаявок.Идентификатор = _ОшибкиОпределенияПифов.ИдентификаторЗаявки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеБанковскихСчетов КАК _ДанныеБанковскихСчетов
		|		ПО _ДанныеЗаявок.ИдентификаторРасчетногоСчета = _ДанныеБанковскихСчетов.Идентификатор
		|			И _ДанныеЗаявок.ИдентификаторПользователя = _ДанныеБанковскихСчетов.ИдентификаторПользователя
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиДублейЗаявок КАК _ОшибкиДублейЗаявок
		|		ПО _ДанныеЗаявок.ИдентификаторПользователя = _ОшибкиДублейЗаявок.ИдентификаторПользователя
		|			И _ДанныеЗаявок.ИдентификаторПифа = _ОшибкиДублейЗаявок.ИдентификаторПифа
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиОпределенияДепозитарныхСчетов КАК _ОшибкиОпределенияДепозитарныхСчетов
		|		ПО _ДанныеЗаявок.Идентификатор = _ОшибкиОпределенияДепозитарныхСчетов.ИдентификаторЗаявки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДепозитарныеСчета КАК _ДепозитарныеСчета
		|		ПО _ДанныеЗаявок.Идентификатор = _ДепозитарныеСчета.Идентификатор
		|			И _ДанныеЗаявок.НомерСчетаДепо = _ДепозитарныеСчета.НомерСчета
		|			И _ДанныеЗаявок.ИдентификаторПользователя = _ДепозитарныеСчета.ИдентификаторПользователя
		|			И _ДанныеЗаявок.ИдентификаторПифа = _ДепозитарныеСчета.ИдентификаторПифа
		|			И (_ДанныеЗаявок.НомерСчетаДепо <> """")
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДепозитарныеСчета КАК _ДепозитарныеСчетаДляОбмена
		|		ПО _ДанныеЗаявок.Идентификатор = _ДепозитарныеСчетаДляОбмена.Идентификатор
		|			И _ДанныеЗаявок.НомерСчетаДепо = _ДепозитарныеСчетаДляОбмена.НомерСчета
		|			И _ДанныеЗаявок.ИдентификаторПользователя = _ДепозитарныеСчетаДляОбмена.ИдентификаторПользователя
		|			И _ДанныеЗаявок.ИдентификаторПифа = _ДепозитарныеСчетаДляОбмена.ИдентификаторПифа
		|			И (_ДанныеЗаявок.НомерСчетаДепоДляОбмена <> """")
		|ГДЕ
		|	НЕ _ДанныеЗаявок.ЕстьОшибкиДанных
		|	И _ОбъектыУчетнойСистемы.ЗаявкаПайщика ЕСТЬ NULL
		|	И _ОшибкиОпределенияПифов.ИдентификаторПифа ЕСТЬ NULL
		|	И _ОшибкиДублейЗаявок.ИдентификаторПользователя ЕСТЬ NULL
		|	И _ОшибкиОпределенияДепозитарныхСчетов.ИдентификаторЗаявки ЕСТЬ NULL";
#КонецОбласти

	ВыборкаЗаявок = Запрос.Выполнить().Выбрать();

	Пока ВыборкаЗаявок.Следующий() Цикл 
		
		Если ЗначениеЗаполнено(ВыборкаЗаявок.Ссылка) Тогда
			
			СтрокаТаблицыЗаявок = ЗаявкиПайщиков.Найти(ВыборкаЗаявок.Идентификатор, "Идентификатор"); 
			
			Если СтрокаТаблицыЗаявок = Неопределено Тогда
				ЗафиксироватьСообщение("Не удалось сверить и обновить файлы к заявке [" + ВыборкаЗаявок.Идентификатор + "].");
			Иначе
				ЗагрузитьФайлыВХранилище(ВыборкаЗаявок.Ссылка, СтрокаТаблицыЗаявок.МассивФайлов, Истина);
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		ДокЗаявка = Документы.ЗаявкаПайщика.СоздатьДокумент();
		
		ЗаполнитьЗначенияСвойств(ДокЗаявка, ВыборкаЗаявок);
		
		ДокЗаявка.Дата			= ВыборкаЗаявок.ДатаЗаявки;
		ДокЗаявка.Организация	= ЭтотОбъект.Организация;
		
		ДокЗаявка.ИсточникЗаявки = Перечисления.ИсточникиАнкетИЗаявок.Сайт;
		ДокЗаявка.ВидПайщика = Перечисления.ВидыПайщиков.Владелец;
		ДокЗаявка.СобственностьНаПаи = Перечисления.ВидыСобственности.НеДолеваяНеСовместная;
		
		Если Не ЗначениеЗаполнено(ДокЗаявка.Пайщик) Тогда
			
			СтрокаТаблицыПользователей = ДанныеПользователей.Найти(ВыборкаЗаявок.ИдентификаторПользователя, "Идентификатор");
				
			Если СтрокаТаблицыПользователей = Неопределено Тогда
				ЗафиксироватьСообщение("Не удалось импортировать заявку [" + ВыборкаЗаявок.Идентификатор + "]. Не удалось импортировать пользователя [id " + ВыборкаЗаявок.ИдентификаторПользователя + "].");
				Продолжить;
			Иначе
				ДокЗаявка.Пайщик = СтрокаТаблицыПользователей.Ссылка;
			КонецЕсли;
	
		КонецЕсли;
		
		ДокЗаявка.Владелец = ДокЗаявка.Пайщик;		
		
		Если ЗначениеЗаполнено(ДокЗаявка.РасчетныйСчет)
			И ВыборкаЗаявок.ВладелецСчета <> ДокЗаявка.Пайщик Тогда
			
			ДокЗаявка.РасчетныйСчет = Неопределено;
		КонецЕсли;
		
		НачатьТранзакцию();
		
		ДокЗаявка.Записать(РежимЗаписиДокумента.Проведение);
		РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(ДокЗаявка.Ссылка,
			Справочники.ВнешниеСистемы.ЕсиаФинанс,
			Справочники.ГруппыИмпортируемыхОбъектов.ЗаявкиПайщиков, ВыборкаЗаявок.Идентификатор);
			
		ЗафиксироватьСообщение("Загружен документ [" + ДокЗаявка + "]. Физ лицо " + ДокЗаявка.Пайщик, Ложь); 
				
		СтрокаТаблицыЗаявок = ЗаявкиПайщиков.Найти(ВыборкаЗаявок.Идентификатор, "Идентификатор"); 
			
		Если СтрокаТаблицыЗаявок = Неопределено Тогда
			ЗафиксироватьСообщение("Не удалось загрузить файлы к заявке [" + ВыборкаЗаявок.Идентификатор + "].");
		Иначе
			ЗагрузитьФайлыВХранилище(ДокЗаявка.Ссылка, СтрокаТаблицыЗаявок.МассивФайлов);
		КонецЕсли;
		
		//ОтменитьТранзакцию();
		ЗафиксироватьТранзакцию();
		
	КонецЦикла;
																
КонецПроцедуры 

Функция ПолучитьМассивФайлов(ВнешнниеДанные, ПараметрыПодключения)
	
	МассивФайлов = Новый Массив;
	
	Для Каждого СтрокаДанных Из ВнешнниеДанные Цикл 
		
		ТекстСообщения = "Не удалось получить Файл из системы ЕСИА.Финанс по id " + СтрокаДанных.id;
				
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос(
			"GET", 
			ПараметрыПодключения, 
			"/api/v1/back_office/attachments/" + СтрокаДанных.id,
			, 
			ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		ДвоичныеДанныеФайла = HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();
		
		ОписаниеФайла = Новый Структура;
		ОписаниеФайла.Вставить("ПолноеИмя", СтрокаДанных.filename);
		ОписаниеФайла.Вставить("Хранение", ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла));
				
		МассивФайлов.Добавить(ОписаниеФайла);
		
	КонецЦикла;
	
	Возврат МассивФайлов;
	
КонецФункции 

Процедура ЗагрузитьФайлыВХранилище(Родитель, МассивФайлов, СверитьФайлы = Ложь)
	
	Если СверитьФайлы Тогда
		
		РанееЗагруженныеДанные = РаботаСФайловымХранилищем.ПолучитьСписокФайлов(Родитель);
		
		Для Каждого ЭлементДанных Из РанееЗагруженныеДанные Цикл
			
			РанееЗагруженныйФайл = РаботаСФайловымХранилищем.ПолучитьФайл(ЭлементДанных.ИдентификаторФайла); 
			
			Для Инд = 0 По МассивФайлов.Количество() - 1 Цикл
				
				НовыйФайл = МассивФайлов[Инд];
				
				Если НовыйФайл.ПолноеИмя = РанееЗагруженныйФайл.Имя + "." + РанееЗагруженныйФайл.Расширение 
					И ПолучитьИзВременногоХранилища(НовыйФайл.Хранение) = ПолучитьИзВременногоХранилища(РанееЗагруженныйФайл.Адрес) Тогда
					
					МассивФайлов.Удалить(Инд);
					Прервать;
				КонецЕсли;
					
			КонецЦикла;
				
		КонецЦикла;
			
	КонецЕсли;
	
	//Что делать если в 1С есть файлы которых нет в Есиа.Финанс ?????
	
	Если МассивФайлов.Количество() > 0 Тогда 
		
		ДанныеВерсий = Обработки.РаботаСФайлами.ПрисоединитьФайл(Родитель, МассивФайлов);
		
		Если ДанныеВерсий.Количество() = 0 Тогда
			
			ЗафиксироватьСообщение("Не удалось загрузить файлы к объекту [" + СокрЛП(Родитель) + "]");
			
		Иначе
			
			Для Каждого ЗаписьВерсии Из ДанныеВерсий Цикл
				
				Если ЗаписьВерсии.Свойство("ТекстОшибки") Тогда
					ЗафиксироватьСообщение(ЗаписьВерсии.ТекстОшибки);
				Иначе                                                                         
					
					ЗафиксироватьСообщение("К " + ?(ТипЗнч(Родитель) = Тип("ДокументСсылка.ЗаявкаПайщика"), "документу", "анкете") + " [" + Родитель + "] загружен файл [" + ЗаписьВерсии.ПолноеИмя + "]", Ложь);
					
				КонецЕсли; 
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли; 
		
КонецПроцедуры

Процедура УстановитьСтатус(ЗаявкаПайщика, НовыйСтатус, Отказ = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК КодЗаявки
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЗаявкиПайщиков)
		|				И Объект = &ЗаявкаПайщика) КАК КодыВоВнешнихСистемахСрезПоследних";
	Запрос.УстановитьПараметр("ЗаявкаПайщика", ЗаявкаПайщика);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		
		ПараметрыПодключения = ПолучитьПараметрыПодключения(); 
		
		ТекстСообщения = "Не удалось установить статус [" + ПолучитьСтатусЗаявки(НовыйСтатус) + "] завке " + ЗаявкаПайщика;
		
		ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("status", НовыйСтатус)); 
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("PATCH", ПараметрыПодключения, "/api/v1/back_office/claims/" + Выборка.КодЗаявки, ТелоЗапроса, ТекстСообщения);
	
		Если HTTPОтвет = Неопределено Тогда
			ЗафиксироватьСообщение(ТекстСообщения,, Отказ);	
		Иначе	
			ЗафиксироватьСообщение("Операции [" + ЗаявкаПайщика + "] установлен статус [" + ПолучитьСтатусЗаявки(НовыйСтатус) + "]", Ложь);	
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

Функция ПрочитатьАдресФИАС(ДанныеЕсиа) 
	
	ИменаПолейАдреса = Новый Соответствие;	
	ИменаПолейАдреса.Вставить("Страна", "country");	
	ИменаПолейАдреса.Вставить("Индекс", "index");	
	ИменаПолейАдреса.Вставить("Регион", "region");		
	ИменаПолейАдреса.Вставить("Район", "district");	
	ИменаПолейАдреса.Вставить("НаселенныйПункт", "city");	
	ИменаПолейАдреса.Вставить("Улица", "street");
	ИменаПолейАдреса.Вставить("Дом", "house");	
	ИменаПолейАдреса.Вставить("Корпус", "corps");	
	ИменаПолейАдреса.Вставить("Квартира", "flat");

	Страна = ДанныеЕсиа[ИменаПолейАдреса.Получить("Страна")];
	Индекс = ДанныеЕсиа[ИменаПолейАдреса.Получить("Индекс")];
	Регион = ДанныеЕсиа[ИменаПолейАдреса.Получить("Регион")];
	Район  = ДанныеЕсиа[ИменаПолейАдреса.Получить("Район")];
	Город  = ДанныеЕсиа[ИменаПолейАдреса.Получить("НаселенныйПункт")];
	Улица  = ДанныеЕсиа[ИменаПолейАдреса.Получить("Улица")];
	
	Дом      = ДанныеЕсиа[ИменаПолейАдреса.Получить("Дом")];
	
	Дом = СтрЗаменить(Дом, "дом", "");
	Дом = СтрЗаменить(Дом, "д.", "");
	Дом = СокрЛП(СтрЗаменить(Дом, "д", ""));

	Корпус   = ДанныеЕсиа[ИменаПолейАдреса.Получить("Корпус")];
	Квартира = ДанныеЕсиа[ИменаПолейАдреса.Получить("Квартира")];	
		
	ПредставлениеАдреса = "";
	ДополнитьПредставлениеАдреса(Страна, ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(Индекс, ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(Регион, ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(Район,  ", ", ПредставлениеАдреса, Истина);
	ДополнитьПредставлениеАдреса(Город,  ", ", ПредставлениеАдреса, Истина);
	
	ДополнитьПредставлениеАдреса(Улица,    ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(?(ПустаяСтрока(Дом), "", "дом " + Дом),           ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(?(ПустаяСтрока(Корпус), "", "корп. " + Корпус),   ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(?(ПустаяСтрока(Квартира), "", "кв. " + Квартира), ", ", ПредставлениеАдреса);
	
	ПространствоИмен = "http://www.v8.1c.ru/ssl/contactinfo";
	
	РезультатXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(ПространствоИмен, "КонтактнаяИнформация"));
	РезультатXDTO.Состав = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(ПространствоИмен, "Адрес"));
	РезультатXDTO.Представление = ПредставлениеАдреса;
	
	Адрес = РезультатXDTO.Состав;
		
	Если ЗначениеЗаполнено(Страна) И Страна <> "Российская Федерация" Тогда
		
		Адрес.Страна = Страна;
		Адрес.Состав = ПредставлениеАдреса;
		
	Иначе
		Адрес.Страна = "РОССИЯ";
		АдресРФ = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(ПространствоИмен, "АдресРФ"));
		
		Если ЗначениеЗаполнено(Индекс) Тогда
			ЭлементИндекс = СоздатьДопАдрЭлемента(АдресРФ);
			ЭлементИндекс.ТипАдрЭл = "10100000";
			ЭлементИндекс.Значение = Индекс;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(Регион) Тогда
			АдресРФ.СубъектРФ = Регион;
		КонецЕсли;
				
		Если ЗначениеЗаполнено(Район) Тогда
			АдресРФ.СвРайМО = ФабрикаXDTO.Создать(АдресРФ.Тип().Свойства.Получить("СвРайМО").Тип);
			АдресРФ.СвРайМО.Район = Район;

		КонецЕсли;
		
		Если ЗначениеЗаполнено(Город) Тогда
			АдресРФ.Город = Город;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Улица) Тогда
			АдресРФ.Улица = Улица;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Дом) Тогда
			ЭлементДом = СоздатьНомерДопАдрЭлемента(АдресРФ);
			ЭлементДом.Тип = "1010";
			ЭлементДом.Значение = Дом;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Корпус) Тогда
			ЭлементКорпус = СоздатьНомерДопАдрЭлемента(АдресРФ);
			ЭлементКорпус.Тип = "1050";
			ЭлементКорпус.Значение = Корпус;

		КонецЕсли;
				
		Если ЗначениеЗаполнено(Квартира) Тогда
			ЭлементКвартира = СоздатьНомерДопАдрЭлемента(АдресРФ);
			ЭлементКвартира.Тип = "2010";
			ЭлементКвартира.Значение = Квартира;
		КонецЕсли;
		
		Адрес.Состав = АдресРФ;
	КонецЕсли;
	
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиXML(, , Ложь, Ложь, ""));
	
	ФабрикаXDTO.ЗаписатьXML(Запись, РезультатXDTO);
	
	РезультатXDTO = СтрЗаменить(Запись.Закрыть(), Символы.ПС, "&#10;");
	
	Возврат РезультатXDTO;
	
КонецФункции 

Процедура ДополнитьПредставлениеАдреса(Дополнение, СтрокаКонкатенации, Представление, ПропускатьНайденныйТекст = Ложь)
	
	Если ПропускатьНайденныйТекст и СтрНайти(Представление, СтрокаКонкатенации + Дополнение) Тогда
		Возврат;
	КонецЕсли;
	
	Если Дополнение <> "" Тогда
		Представление = Представление + ?(ПустаяСтрока(Представление), "", СтрокаКонкатенации) + Дополнение;
	КонецЕсли;
	
КонецПроцедуры 

Функция СоздатьНомерДопАдрЭлемента(АдресРФ) Экспорт 
	ДопАдрЭл = СоздатьДопАдрЭлемента(АдресРФ);
	ДопАдрЭл.Номер = ФабрикаXDTO.Создать(ДопАдрЭл.Тип().Свойства.Получить("Номер").Тип);
	Возврат ДопАдрЭл.Номер;
КонецФункции

Функция СоздатьДопАдрЭлемента(АдресРФ) Экспорт
	СвойствоДопАдрЭлемента = АдресРФ.ДопАдрЭл.ВладеющееСвойство;
	ДопАдрЭлемента = ФабрикаXDTO.Создать(СвойствоДопАдрЭлемента.Тип);
	АдресРФ.ДопАдрЭл.Добавить(ДопАдрЭлемента);
	Возврат ДопАдрЭлемента;
КонецФункции

Функция ПрочитатьАдрес(ДанныеЕсиа)
	
	ИменаПолейАдреса = Новый Соответствие;	
	ИменаПолейАдреса.Вставить("Страна", "country");	
	ИменаПолейАдреса.Вставить("Индекс", "index");	
	ИменаПолейАдреса.Вставить("Регион", "region");		
	ИменаПолейАдреса.Вставить("Район", "district");	
	ИменаПолейАдреса.Вставить("НаселенныйПункт", "city");	
	ИменаПолейАдреса.Вставить("Улица", "street");
	ИменаПолейАдреса.Вставить("Дом", "house");	
	ИменаПолейАдреса.Вставить("Корпус", "corps");		
	ИменаПолейАдреса.Вставить("Квартира", "flat");

	Страна = ДанныеЕсиа[ИменаПолейАдреса.Получить("Страна")];
	Индекс = ДанныеЕсиа[ИменаПолейАдреса.Получить("Индекс")];
	Регион = ДанныеЕсиа[ИменаПолейАдреса.Получить("Регион")];
	Район  = ДанныеЕсиа[ИменаПолейАдреса.Получить("Район")];
	Город  = ДанныеЕсиа[ИменаПолейАдреса.Получить("НаселенныйПункт")];
	Улица  = ДанныеЕсиа[ИменаПолейАдреса.Получить("Улица")];
	
	Дом      = ДанныеЕсиа[ИменаПолейАдреса.Получить("Дом")];
	Корпус   = ДанныеЕсиа[ИменаПолейАдреса.Получить("Корпус")];
	Квартира = ДанныеЕсиа[ИменаПолейАдреса.Получить("Квартира")];
		
	ПредставлениеАдреса = "";
	ДополнитьПредставлениеАдреса(Страна,   ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(Индекс,   ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(Регион,   ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(Район,    ", ", ПредставлениеАдреса, Истина);
	ДополнитьПредставлениеАдреса(Город,    ", ", ПредставлениеАдреса, Истина);
	
	ДополнитьПредставлениеАдреса(Улица,    ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(?(ПустаяСтрока(Дом), "", "дом " + Дом),            ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(?(ПустаяСтрока(Корпус), "", "корп. " + Корпус),    ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(?(ПустаяСтрока(Квартира), "", "кв. " + Квартира),  ", ", ПредставлениеАдреса);
	
	Возврат ПредставлениеАдреса;
	
КонецФункции

Функция ПолучитьЗначенияРеквизитовАнкетыПользователя(ДанныеЕсиа, ПараметрыПодключения) 
	
	ДанныеДляОпределенияСсылок = Новый Структура();
	АнкетныеДанные = Новый Структура;
			
	Если Не ДанныеЕсиа.Свойство("person_info") Тогда
		ЗафиксироватьСообщение("Не удалось получить данные физ. лица по идентификатору ЕСИА.Финанс [" + ДанныеЕсиа.id + "]");
		Возврат Неопределено;
	КонецЕсли; 
	
	Если Не (ДанныеЕсиа.Свойство("fill_stage") И (ДанныеЕсиа.fill_stage = "active" Или ДанныеЕсиа.fill_stage = "filled" Или ДанныеЕсиа.fill_stage = "claim")) Тогда
		ЗафиксироватьСообщение("Текущий статус пользователя ЕСИА.Финанс [" + ?(ДанныеЕсиа.Свойство("fill_stage"), ДанныеЕсиа.fill_stage, "нет статуса") + "], [id пользователя " + ДанныеЕсиа.id + "]. Анкета не будет загружена.");
		Возврат Неопределено;	
	КонецЕсли;
	// по умолчанию идентификация происходит по СМЭВ
	Если Не (ДанныеЕсиа.Свойство("identification_type") И ДанныеЕсиа.identification_type = "smev") Тогда
		ЗафиксироватьСообщение("Данные пользователя ЕСИА.Финанс не прошли первичную идентификацию [identification_type = " 
			+ ?(ДанныеЕсиа.Свойство("identification_type"), ДанныеЕсиа.identification_type, "отсутствует значение") + "], [id пользователя " + ДанныеЕсиа.id + "]. Анкета не будет загружена.");
		Возврат Неопределено;	
	КонецЕсли;
	
	ФизЛицо = ДанныеЕсиа.person_info; 
	
	Если Не (ФизЛицо.Свойство("is_actual") И ФизЛицо.is_actual) Тогда
		ЗафиксироватьСообщение("Данные пользователя ЕСИА.Финанс не актуальны [id пользователя " + ДанныеЕсиа.id + "]. Анкета не будет загружена.");
		Возврат Неопределено;	
	КонецЕсли;
	
	Если Не (ФизЛицо.Свойство("actuality_updated_at") И ЗначениеЗаполнено(ФизЛицо.actuality_updated_at)) Тогда 
		ЗафиксироватьСообщение("В данных пользователя ЕСИА.Финанс [id пользователя " + ДанныеЕсиа.id + "] отсутствует дата актуальности. Анкета не будет загружена.");
		Возврат Неопределено;
	КонецЕсли;
				
	Если Не ФизЛицо.Свойство("document") Тогда
		ЗафиксироватьСообщение("Не удалось получить данные удостоверения личности физ. лица [id пользователя ЕСИА.Финанс " + ДанныеЕсиа.id + "]");
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ДанныеЕсиа.Свойство("checks") Тогда
		ЗафиксироватьСообщение("Анкета пользователя не прошла проверку на стороне ЕСИА.Финанс [id пользователя " + ДанныеЕсиа.id + "]. Данные не будут загружены.");
		Возврат Неопределено;
	КонецЕсли; 
	
	РезультатыПроверок = ДанныеЕсиа.checks; 
	
	Если Не РезультатыПроверок.Свойство("is_valid_info") Или Не РезультатыПроверок.is_valid_info Тогда
		ЗафиксироватьСообщение("Данные пользователя не подтверждены менеджером [id пользователя ЕСИА.Финанс " + ДанныеЕсиа.id + "]. Анкета не будет загружена.");
		Возврат Неопределено;	
	КонецЕсли;
	
	Если Не (РезультатыПроверок.Свойство("no_pi_change_claim") И РезультатыПроверок.no_pi_change_claim) Тогда
		ЗафиксироватьСообщение("У пользователя есть неподтвержденные заявки на изменение личных данных [id пользователя ЕСИА.Финанс " + ДанныеЕсиа.id + "]. Анкета не будет загружена.");
		Возврат Неопределено;	
	КонецЕсли;
		
	//проверяем подписи анкет
	Если ФизЛицо.Свойство("attachments") Тогда 
		
		Для Каждого ТекВложение Из ФизЛицо.attachments Цикл
			
			Если ТекВложение.kind = "anket_data" И ТекВложение.Свойство("client_sign") Тогда
				
				Если ПодписьВалидна(ТекВложение.client_sign) Тогда 
					
					Если СтрНачинаетсяС(ТекВложение.description, "Согласие ОПД") Тогда
				    	АнкетныеДанные.Вставить("СогласиеНаПередачуИнформации", Истина);
				    КонецЕсли;
				
				Иначе
					
					ЗафиксироватьСообщение("Не удалось получить данные физ. лица по идентификатору ЕСИА.Финанс [" + ДанныеЕсиа.id + "]."
						+ "Отсутствует подпись документа [" + ТекВложение.description + "]");
					Возврат Неопределено;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла; 
		
		АнкетныеДанные.Вставить("МассивФайлов", ПолучитьМассивФайлов(ФизЛицо.attachments, ПараметрыПодключения));
		
	КонецЕсли;
	
	ДанныеДляОпределенияСсылок.Вставить("ДатаАктуальности", ПолучитьДату(ФизЛицо.actuality_updated_at));
	ДанныеДляОпределенияСсылок.Вставить("Фамилия", ФизЛицо.surname);
	ДанныеДляОпределенияСсылок.Вставить("Имя", ФизЛицо.name);
    ДанныеДляОпределенияСсылок.Вставить("Отчество", ФизЛицо.patronymic);
	ДанныеДляОпределенияСсылок.Вставить("ИНН", ФизЛицо.inn);
	СНИЛС = ФизЛицо.snils;
	
	Если СтрДлина(СНИЛС) = 11 Тогда
		СНИЛС = Лев(СНИЛС, 3) + "-" + Сред(СНИЛС, 4, 3) + "-" + Сред(СНИЛС, 7, 3) + " " + Прав(СНИЛС, 2);
	КонецЕсли;
	
	ДанныеДляОпределенияСсылок.Вставить("СНИЛС", СНИЛС);
	ДанныеДляОпределенияСсылок.Вставить("ДатаРождения", ПолучитьДату(ФизЛицо.birthday));
	ДанныеДляОпределенияСсылок.Вставить("ГражданствоСтр", ВРег(ФизЛицо.nationality));
	
	АнкетныеДанные.Вставить("МестоРождения", ФизЛицо.birth_place);
	АнкетныеДанные.Вставить("Пол", ?(ФизЛицо.male, Перечисления.ПолФизическогоЛица.Мужской, Перечисления.ПолФизическогоЛица.Женский));
	АнкетныеДанные.Вставить("РезидентРФ", ФизЛицо.Свойство("is_rf_resident") И ФизЛицо.is_rf_resident);

	//Заполним позже одним запросом для всех клиентов
	//АнкетныеДанные.Вставить("Гражданство", Неопределено);
	АнкетныеДанные.Вставить("ВтороеГражданство", Новый Массив);
	АнкетныеДанные.Вставить("НалоговыйРезидентИностранногоГосударстваГосударство", Новый Массив);
	АнкетныеДанные.Вставить("ИностранныйНалогоплательщикГосударство", Новый Массив); 
	//------------------------------------------------

	Если ФизЛицо.is_additional_nationatilies Тогда
		
		ДанныеДляОпределенияСсылок.Вставить("ДопГражданстваСтр", "");
		
		Для Каждого ДопГражданство Из ФизЛицо.additional_nationatilies_items Цикл
			ДанныеДляОпределенияСсылок.ДопГражданстваСтр = ДанныеДляОпределенияСсылок.ДопГражданстваСтр + ВРег(ДопГражданство.country);	
		КонецЦикла;
		
	КонецЕсли;
	
	Если ФизЛицо.Свойство("tax_status_in_foreign") И ФизЛицо.tax_status_in_foreign Тогда
		
		ДанныеДляОпределенияСсылок.Вставить("РезиденстваСтр", "");
		
		Для Каждого Резиденство Из ФизЛицо.tax_status_foreign_items Цикл
			ДанныеДляОпределенияСсылок.РезиденстваСтр = ДанныеДляОпределенияСсылок.РезиденстваСтр + ВРег(Резиденство.country);	
		КонецЦикла;	
		
		АнкетныеДанные.Вставить("НалоговыйРезидентИностранногоГосударства", Истина); 
		
	КонецЕсли;
		
	ДокументФизЛица = ФизЛицо.document;
	
	ДанныеДляОпределенияСсылок.Вставить("ВидДокументаСтр", ДокументФизЛица.kind); 
	ДанныеДляОпределенияСсылок.Вставить("КодСтраныВыдачиДокумента", ВРег(ДокументФизЛица.country_code)); 
	//Заполним позже одним запросом для всех клиентов
	//АнкетныеДанные.Вставить("ВидУдостоверенияЛичности", Неопределено);
	//АнкетныеДанные.Вставить("СтранаВыдачиДокумента", Неопределено);
	//-----------------------------------------------
	//Реквизиты.КодАнкеты = СокрЛП(ДокументФизЛица.series) + " " + ДокументФизЛица.number;
	ДанныеДляОпределенияСсылок.Вставить("СерияУдостоверенияЛичности", ДокументФизЛица.series);
	ДанныеДляОпределенияСсылок.Вставить("НомерУдостоверенияЛичности", ДокументФизЛица.number);
	АнкетныеДанные.Вставить("ДатаВыдачиУдостоверенияЛичности", ПолучитьДату(ДокументФизЛица.issue_date));
	АнкетныеДанные.Вставить("ДатаОкончанияДействияУдостоверенияЛичности", ПолучитьДату(ДокументФизЛица.expiration_date));
	АнкетныеДанные.Вставить("ОрганВыдавшийУдостоверениеЛичности", ДокументФизЛица.issuer);
    АнкетныеДанные.Вставить("КодОрганаВыдавшегоУдостоверениеЛичности", ДокументФизЛица.issuer_code);
		
	Если РезультатыПроверок.Свойство("expired_passports") 
		И РезультатыПроверок.expired_passports <> Неопределено И РезультатыПроверок.expired_passports.status = "Пройдена успешно" Тогда 
		
		АнкетныеДанные.Вставить("СтатусПроверки", Перечисления.СтатусыПроверкиУдостоверенияЛичности.Действителен);
		
	Иначе
		АнкетныеДанные.Вставить("СтатусПроверки", Перечисления.СтатусыПроверкиУдостоверенияЛичности.НеПроверен);	
	КонецЕсли;
	
	АнкетныеДанные.Вставить("ПроверенПоПеречнюТеррористов", 
						(РезультатыПроверок.Свойство("possible_terrorists") И РезультатыПроверок.possible_terrorists <> Неопределено
						И РезультатыПроверок.possible_terrorists.status = "Пройдена успешно"));

	АнкетныеДанные.Вставить("ПроверенПоПеречнюСБООН", 
						(РезультатыПроверок.Свойство("uns") И РезультатыПроверок.uns <> Неопределено
						И РезультатыПроверок.uns.status = "Пройдена успешно"));

	АнкетныеДанные.Вставить("ПроверенПоСпискамРешенийМВК", 
						(РезультатыПроверок.Свойство("frozen_assets") И РезультатыПроверок.frozen_assets <> Неопределено
						И РезультатыПроверок.frozen_assets.status = "Пройдена успешно"));
						
	АнкетныеДанные.Вставить("ПроверенПоБазеОтказовПо764П", 
						(РезультатыПроверок.Свойство("operation_cancels") И РезультатыПроверок.operation_cancels <> Неопределено
						И РезультатыПроверок.operation_cancels.status = "Пройдена успешно"));					
				
	АнкетныеДанные.Вставить("ВысокийУровеньРиска", ДанныеЕсиа.Свойство("risk_level") И ДанныеЕсиа.risk_level = "high");
	
	// Для низкого уровня риска добавляем пояснение
	Если Не АнкетныеДанные.ВысокийУровеньРиска Тогда
		АнкетныеДанные.Вставить("ОбоснованиеУровняРиска", "факторы высокого уровня риска не установлены");
	КонецЕсли;
	
	Если ФизЛицо.Свойство("addresses") Тогда 
		
		Адреса = ФизЛицо.addresses;
		
		АдресРегистрации = "";
		
		Если Адреса.Свойство("main") И Адреса.main.Свойство("full") Тогда
			АдресРегистрации = ПрочитатьАдрес(Адреса.main);
			АдресРегистрацииФИАС = ПрочитатьАдресФИАС(Адреса.main);
		Конецесли;
		
		АнкетныеДанные.Вставить("АдресРегистрации", АдресРегистрации);
		АнкетныеДанные.Вставить("АдресРегистрацииФИАС", АдресРегистрацииФИАС);
		
		Если Адреса.Свойство("residential") И Адреса.residential.Свойство("is_active") И Адреса.residential.is_active Тогда
			АнкетныеДанные.Вставить("АдресМестаЖительства", ПрочитатьАдрес(Адреса.residential));
			АнкетныеДанные.Вставить("АдресМестаЖительстваФИАС", ПрочитатьАдресФИАС(Адреса.residential));
		Иначе
			АнкетныеДанные.Вставить("АдресМестаЖительства", АдресРегистрации);
			АнкетныеДанные.Вставить("АдресМестаЖительстваФИАС", АдресРегистрацииФИАС);
		Конецесли;
		
		Если Адреса.Свойство("for_corresp") И Адреса.for_corresp.Свойство("is_active") И Адреса.for_corresp.is_active Тогда
			АнкетныеДанные.Вставить("ПочтовыйАдрес", ПрочитатьАдрес(Адреса.for_corresp));
			АнкетныеДанные.Вставить("ПочтовыйАдресФИАС", ПрочитатьАдресФИАС(Адреса.for_corresp));
		КонецЕсли;
		
	КонецЕсли; 
	
	АнкетныеДанные.Вставить("EMail", ФизЛицо.contact_email); 
		
	// В ближайшем релизе ЕСИА.Финанс появится новое поле main_phone_full_str
	Если ФизЛицо.Свойство("main_phone_full_str") Тогда
		АнкетныеДанные.Вставить("Телефоны",				ФизЛицо.main_phone_full_str);
		АнкетныеДанные.Вставить("ТелефонДляОповещения",	ФизЛицо.main_phone_full_str);
	Иначе	
		// Код страны телефона пока отсутствует - хардкод
		АнкетныеДанные.Вставить("Телефоны",				"7" + ФизЛицо.main_phone);
		АнкетныеДанные.Вставить("ТелефонДляОповещения",	"7" + ФизЛицо.main_phone);
	КонецЕсли;		
	
	ОписаниеПубличногоЛица = "";
	
	Если ФизЛицо.Свойство("is_russian_pub_person") И ФизЛицо.is_russian_pub_person Тогда	
		ОписаниеПубличногоЛица = ПолучиьОписаниеПубличногоЛица(ФизЛицо.irpp_name_organization, ФизЛицо.irpp_your_position, ФизЛицо.irpp_employer_address);	
	ИначеЕсли ФизЛицо.Свойство("is_person_of_intercity_organizations") И ФизЛицо.is_person_of_intercity_organizations Тогда
        ОписаниеПубличногоЛица = ПолучиьОписаниеПубличногоЛица(ФизЛицо.ipio_name_organization, ФизЛицо.ipio_your_position, ФизЛицо.ipio_employer_address);
	ИначеЕсли ФизЛицо.Свойство("is_foreign_pub_person") И ФизЛицо.is_foreign_pub_person Тогда
        ОписаниеПубличногоЛица = ПолучиьОписаниеПубличногоЛица(ФизЛицо.ifpp_name_organization, ФизЛицо.ifpp_your_position, ФизЛицо.ifpp_employer_address);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеПубличногоЛица) Тогда
		АнкетныеДанные.Вставить("ЯвляетсяПубличнымДолжностнымЛицом", Истина);
		АнкетныеДанные.Вставить("ЯвляетсяПубличнымДолжностнымЛицомОписание", ОписаниеПубличногоЛица); 
	КонецЕсли; 
	
	Если ФизЛицо.Свойство("is_bound_with_pub_person") И ФизЛицо.is_bound_with_pub_person Тогда
		АнкетныеДанные.Вставить("ЯвляетсяРодственникомПубличногоДолжностногоЛица", Истина);
		АнкетныеДанные.Вставить("ЯвляетсяРодственникомПубличногоДолжностногоЛицаОписание", ФизЛицо.kinship_status); 	
	КонецЕсли;
	
	Если ФизЛицо.Свойство("purpose_of_business") Тогда
		
		ОписаниеДругое = "";
		
		Для Каждого ТекЦель Из ФизЛицо.purpose_of_business Цикл
			
			Если ТекЦель = "pif_services" Тогда
				АнкетныеДанные.Вставить("ЦельПриобретениеПаев", Истина);	
			ИначеЕсли ТекЦель = "du_services" Тогда
				АнкетныеДанные.Вставить("ЦельДоверительноеУправление", Истина);
			ИначеЕсли ТекЦель = "bo_services" Тогда 
				ОписаниеДругое = ОписаниеДругое + ?(ЗначениеЗаполнено(ОписаниеДругое), ", ", "") + "брокерские услуги";
			ИначеЕсли ТекЦель = "depos_services" Тогда
				ОписаниеДругое = ОписаниеДругое + ?(ЗначениеЗаполнено(ОписаниеДругое), ", ", "") + "депозитарные услуги";
			//ИначеЕсли ТекЦель = "du_services" Тогда
			//	
			//	ОписаниеДругое = ОписаниеДругое + ?(ЗначениеЗаполнено(ОписаниеДругое), ", ", "") + 
			//		"услуги доверительного управления ценными бумагами, 
			//		|денежными средствами, предназначенными для совершения сделок с ценными бумагами 
			//		|и (или) заключения договоров, являющихся производными финансовыми инструментами";

			КонецЕсли;	
				
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ОписаниеДругое) Тогда
			АнкетныеДанные.Вставить("ЦельДругое", Истина);
			АнкетныеДанные.Вставить("ЦельДругоеОписание", ОписаниеДругое);
		КонецЕсли;
	
	КонецЕсли;
	
	АнкетныеДанные.Вставить("ЦелиДеятельности", ФизЛицо.purpose_of_activity_str);
	АнкетныеДанные.Вставить("ПоложительноеФинансовоеПоложение",  ФизЛицо.Свойство("financial_position") И ФизЛицо.financial_position = "positive");
	АнкетныеДанные.Вставить("ДеловаяРепутацияПоложительная",  ФизЛицо.Свойство("customer_reputation") И ФизЛицо.customer_reputation = "positive"); 
	АнкетныеДанные.Вставить("ИсточникиПроисхожденияДенежныхСредств", ФизЛицо.source_of_money_income_str);
	
	АнкетныеДанные.Вставить("РаспространениеЗаконодательстваСША", (ФизЛицо.Свойство("tax_status") И ФизЛицо.tax_status = "resident")); 
	
	Если ФизЛицо.Свойство("foreign_address") Тогда
		
		Если ФизЛицо.foreign_address = "usa" Тогда  
			АнкетныеДанные.Вставить("АдресФактическогоПроживанияВИностранномГосударстве", ФизЛицо.foreign_usa_address); 	
		ИначеЕсли  ФизЛицо.foreign_address = "foreign " Тогда	
			АнкетныеДанные.Вставить("АдресФактическогоПроживанияВИностранномГосударстве", ФизЛицо.foreign_address_foreign_items_str);	
		КонецЕсли;	
			
	КонецЕсли; 
	
	Если ФизЛицо.Свойство("source_of_money_income") Тогда
		
		ИсточникСтр = ""; 
		
		Для Каждого ИсточникДС Из ФизЛицо.source_of_money_income Цикл
			
			Если ИсточникДС = "personal" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), ", ", "") + "личные сбережения";
				
			ИначеЕсли ИсточникДС = "nrd_papers" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), ", ", "") + 
					"доход от операций с ценными бумагами и (или) иностранными финансовыми инструментами, не квалифицированными в соответствии с законодательством РФ в качестве ценных бумаг";	
				
			ИначеЕсли ИсточникДС = "bussiness" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), ", ", "") + 
					"доход от осуществления предпринимательской деятельности и (или) от участия в уставном (складочном) капитале коммерческой организации";
	
			ИначеЕсли ИсточникДС = "financial_instruments" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), ", ", "") + 
					"доход от операций с производными финансовыми инструментами"; 
				
			ИначеЕсли ИсточникДС = "inheritance" Тогда

				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), ", ", "") + 
					"получение наследства или активов по договору дарения";
				
			ИначеЕсли ИсточникДС = "credit" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), ", ", "") + "заем, кредит";
				
			ИначеЕсли ИсточникДС = "job" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), ", ", "") + 
					"доход по основному месту работы (включая доход от работы по совместительству)";
			ИначеЕсли ИсточникДС = "else" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), ", ", "") + "иное";
				
			КонецЕсли;
			
		КонецЦикла;
		
		АнкетныеДанные.Вставить("ИсточникиПроисхожденияДенежныхСредств", ИсточникСтр);
	
	КонецЕсли;
			
	Возврат Новый Структура("АнкетныеДанные, ДанныеДляОпределенияСсылок", АнкетныеДанные, ДанныеДляОпределенияСсылок);
	
КонецФункции 

