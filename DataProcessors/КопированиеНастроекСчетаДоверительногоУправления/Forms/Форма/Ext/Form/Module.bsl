		СтрокаЗаписиПриемник.Организация = ЭтаФорма.СчетРеципиент.Организация;
		СтрокаЗаписиПриемник.Период = ЭтаФорма.ДатаУстановки;   
		
		ДобавитьРасшифровкуОперации(Расшифровка, ЭтаФорма.СчетРеципиент, "ПереопределениеКлассификацииУчетныхАктивовЦБ", ВыборкаДетальныеЗаписи, СвойстваПриемника, ИсключаяСвойства, Ложь, "");
		
