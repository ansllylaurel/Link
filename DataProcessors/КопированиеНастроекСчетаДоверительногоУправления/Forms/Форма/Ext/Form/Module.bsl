	ПолеПриемника = ПолучитьПолеПриемникаРегистраНастроек("ПереопределениеКлассификацииУчетныхАктивовЦБ");
	
	СвойстваПриемника = Новый Структура;
	СвойстваПриемника.Вставить("Период",		ЭтотОбъект.ДатаУстановки);
