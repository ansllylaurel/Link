&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ШаблонУведомленияИнфинитум = РеквизитФормыВЗначение("Объект").ПолучитьМакет("УведомлениеИнфинитум");
	
	СписокСсылок.ЗагрузитьЗначения(Параметры.МассивСсылок);
	Элементы.Подписант.СписокВыбора.ЗагрузитьЗначения(ПолучитьПодписантов(Параметры.МассивСсылок));
	
КонецПроцедуры

Функция ПолучитьПодписантов(МассивСсылок)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КонтактныеЛица.КонтактноеЛицо КАК КонтактноеЛицо
		|ИЗ
		|	Документ.РазмещениеКредитногоИнструмента КАК РазмещениеДС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|		ПО РазмещениеДС.Организация.ЮрФизЛицо = КонтактныеЛица.Объект
		|ГДЕ
		|	РазмещениеДС.Ссылка В(&МассивСсылок)
		|
		|УПОРЯДОЧИТЬ ПО
		|	КонтактноеЛицо
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КонтактноеЛицо");	

КонецФункции

&НаКлиенте
Процедура Печать(Команда)

	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	МассивУведомлений	= ПолучитьМассивУведомлений(СписокСсылок.ВыгрузитьЗначения());
	
	Для Каждого Уведомление Из МассивУведомлений Цикл
		Если Уведомление.СпецДепозитарий.УникальныйИдентификатор() = Новый УникальныйИдентификатор("81daee7f-9fa2-11e3-92b0-000c2931cdc5") Тогда
			ПечатьИнфинитум(Уведомление);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для спец.депозитария: " + СокрЛП(Уведомление.СпецДепозитарийПредставление) + Символы.ПС + " не определено ни одной печатной формы!");
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьИнфинитум(Уведомление)
	
		ИмяФайлаШаблонаУведомления = ПолучитьИмяВременногоФайла("xlt");

		ШаблонУведомленияИнфинитум.Записать(ИмяФайлаШаблонаУведомления);
		
		// создадим документ MS Excel на основании сохраненного шаблона
		ExcelApp = Новый COMОбъект("Excel.Application");
		ExcelApp.Application.Visible = True;
		
		ExcelApp.Application.Workbooks.Open(ИмяФайлаШаблонаУведомления);
		
		ExcelApp.Cells(3, 8)	.Value	= Уведомление.Клиент;
		ExcelApp.Cells(5, 8)	.Value	= Уведомление.ЮрЛицоСчетаДУ;
		ExcelApp.Cells(7, 8)	.Value	= Уведомление.ДоговорДУ;
		ExcelApp.Cells(9, 8)	.Value	= Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy");
		ExcelApp.Cells(9, 17)	.Value	= Сред(ТекущаяДата(), 12, 2) + " час. " + Сред(ТекущаяДата(), 15, 2) + " мин.";
		ExcelApp.Cells(11, 8)	.Value 	= Уведомление.КонтактноеЛицо;
		ExcelApp.Cells(15, 8)	.Value	= Уведомление.Банк;
		ExcelApp.Cells(15, 11)	.Value	= Уведомление.Сумма;
		ExcelApp.Cells(15, 13)	.Value	= Уведомление.Валюта;
		ExcelApp.Cells(15, 14)	.Value	= Формат(Объект.ДатаОплаты, "ДФ=dd.MM.yyyy") + " г.";
		ExcelApp.Cells(15, 16)	.Value	= Уведомление.УсловияСделки;
		ExcelApp.Cells(15, 21)	.Value	= Уведомление.Приложение;

		Попытка
			УдалитьФайлы(КаталогВременныхФайлов(), ИмяФайлаШаблонаУведомления);
		Исключение
		КонецПопытки;
	
КонецПроцедуры	

Функция ПолучитьМассивУведомлений(МассивСсылок)
	
	НовыйМассив = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РазмещениеКредитногоИнструмента.Дата КАК Дата,
	|	ДепозитныеВклады.БанковскийСчет.ЮрФизЛицо КАК Клиент,
	|	РазмещениеКредитногоИнструмента.СчетДоверительногоУправления КАК СчетДУ,
	|	РазмещениеКредитногоИнструмента.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговораДУ,
	|	РазмещениеКредитногоИнструмента.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаДоговораДУ,
	|	ДепозитныеВклады.БанковскийСчет.Банк КАК Банк,
	|	РазмещениеКредитногоИнструмента.Сумма КАК Сумма,
	|	ДепозитныеВклады.БанковскийСчет.Валюта КАК Валюта,
	|	ДепозитныеВклады.БанковскийСчет.Договор КАК ДепозитныйВкладБанковскийСчетДоговор,
	|	ДепозитныеВклады.Ссылка КАК ДепозитныйВклад,
	|	МАКСИМУМ(КлиентыДоверительногоУправления.Период) КАК ПериодКлиентыСчетовДУ,
	|	РазмещениеКредитногоИнструмента.СчетДоверительногоУправления.СпециализированныйДепозитарий КАК СпецДепозитарий,
	|	РазмещениеКредитногоИнструмента.Организация КАК Организация
	|ПОМЕСТИТЬ ВТ1
	|ИЗ
	|	Документ.РазмещениеКредитногоИнструмента КАК РазмещениеКредитногоИнструмента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
	|		ПО РазмещениеКредитногоИнструмента.СчетДоверительногоУправления = КлиентыДоверительногоУправления.СчетДоверительногоУправления
	|			И РазмещениеКредитногоИнструмента.Дата >= КлиентыДоверительногоУправления.Период
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
	|		ПО РазмещениеКредитногоИнструмента.КредитныйИнструмент = ДепозитныеВклады.Ссылка
	|ГДЕ
	|	РазмещениеКредитногоИнструмента.Ссылка В(&МассивСсылок)
	|
	|СГРУППИРОВАТЬ ПО
	|	РазмещениеКредитногоИнструмента.СчетДоверительногоУправления,
	|	РазмещениеКредитногоИнструмента.Дата,
	|	РазмещениеКредитногоИнструмента.Сумма,
	|	ДепозитныеВклады.Ссылка,
	|	ДепозитныеВклады.БанковскийСчет.ЮрФизЛицо,
	|	РазмещениеКредитногоИнструмента.СчетДоверительногоУправления.НомерДоговора,
	|	РазмещениеКредитногоИнструмента.СчетДоверительногоУправления.ДатаЗаключения,
	|	ДепозитныеВклады.БанковскийСчет.Банк,
	|	ДепозитныеВклады.БанковскийСчет.Валюта,
	|	ДепозитныеВклады.БанковскийСчет.Договор,
	|	РазмещениеКредитногоИнструмента.СчетДоверительногоУправления.СпециализированныйДепозитарий,
	|	РазмещениеКредитногоИнструмента.Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ1.Клиент КАК Клиент,
	|	КлиентыДоверительногоУправления.Клиент КАК ЮрЛицоСчетаДУ,
	|	НАЧАЛОПЕРИОДА(ВТ1.Дата, ДЕНЬ) КАК Дата,
	|	ВТ1.СчетДУ КАК СчетДУ,
	|	ВТ1.НомерДоговораДУ КАК НомерДоговораДУ,
	|	ВТ1.ДатаДоговораДУ КАК ДатаДоговораДУ,
	|	ВТ1.Банк КАК Банк,
	|	ВТ1.Сумма КАК Сумма,
	|	ВТ1.Валюта КАК Валюта,
	|	ВТ1.ДепозитныйВкладБанковскийСчетДоговор КАК ДепозитныйВкладБанковскийСчетДоговор,
	|	ВТ1.ДепозитныйВклад КАК ДепозитныйВклад,
	|	ВТ1.СпецДепозитарий КАК СпецДепозитарий,
	|	ВТ1.Организация КАК Организация
	|ПОМЕСТИТЬ ВТ2
	|ИЗ
	|	ВТ1 КАК ВТ1
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
	|		ПО ВТ1.СчетДУ = КлиентыДоверительногоУправления.СчетДоверительногоУправления
	|			И ВТ1.ПериодКлиентыСчетовДУ = КлиентыДоверительногоУправления.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВсеДаты.КредитныйИнструмент КАК КредитныйИнструмент,
	|	ВсеДаты.ДатаНачалаДействияУсловий КАК ДатаНачалаДействияУсловий,
	|	ВсеДаты.Период КАК Период,
	|	УсловияКредитныхИнструментов.Действует КАК Действует,
	|	УсловияКредитныхИнструментов.ДатаПогашения КАК ДатаПогашения,
	|	УсловияКредитныхИнструментов.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
	|	УсловияКредитныхИнструментов.Процент КАК Процент
	|ПОМЕСТИТЬ _СрезДействующихУсловийНаДатыРазмещения
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТ2.ДепозитныйВклад КАК КредитныйИнструмент,
	|		УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий КАК ДатаНачалаДействияУсловий,
	|		МАКСИМУМ(УсловияКредитныхИнструментов.Период) КАК Период
	|	ИЗ
	|		ВТ2 КАК ВТ2
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов КАК УсловияКредитныхИнструментов
	|			ПО ВТ2.ДепозитныйВклад = УсловияКредитныхИнструментов.КредитныйИнструмент
	|	ГДЕ
	|		УсловияКредитныхИнструментов.Период <= ВТ2.Дата
	|		И УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий <= ВТ2.Дата
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВТ2.ДепозитныйВклад,
	|		УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий) КАК ВсеДаты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов КАК УсловияКредитныхИнструментов
	|		ПО ВсеДаты.КредитныйИнструмент = УсловияКредитныхИнструментов.КредитныйИнструмент
	|			И ВсеДаты.Период = УсловияКредитныхИнструментов.Период
	|			И ВсеДаты.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий
	|ГДЕ
	|	УсловияКредитныхИнструментов.Действует
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ2.Клиент КАК Клиент,
	|	ВТ2.ЮрЛицоСчетаДУ КАК ЮрЛицоСчетаДУ,
	|	ВТ2.Дата КАК Дата,
	|	ВТ2.СчетДУ КАК СчетДУ,
	|	ВТ2.НомерДоговораДУ КАК НомерДоговораДУ,
	|	ВТ2.ДатаДоговораДУ КАК ДатаДоговораДУ,
	|	ВТ2.Банк КАК Банк,
	|	ВТ2.Сумма КАК Сумма,
	|	ВТ2.Валюта КАК Валюта,
	|	ВТ2.ДепозитныйВкладБанковскийСчетДоговор КАК ДепозитныйВкладБанковскийСчетДоговор,
	|	ВТ2.ДепозитныйВклад КАК ДепозитныйВклад,
	|	МАКСИМУМ(РеквизитыКлиент.Период) КАК ПериодРеквизитыКлиент,
	|	МАКСИМУМ(РеквизитыЮрЛицоСчетДУ.Период) КАК ПериодРеквизитыЮрЛицоСчетаДУ,
	|	МАКСИМУМ(_СрезДействующихУсловийНаДатыРазмещения.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловийКредитныхИнструментов,
	|	ВТ2.СпецДепозитарий КАК СпецДепозитарий,
	|	ВТ2.Организация КАК Организация
	|ПОМЕСТИТЬ ВТ3
	|ИЗ
	|	ВТ2 КАК ВТ2
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц КАК РеквизитыКлиент
	|		ПО ВТ2.Клиент = РеквизитыКлиент.ЮрФизЛицо
	|			И (РеквизитыКлиент.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
	|			И (РеквизитыКлиент.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
	|			И ВТ2.Дата >= РеквизитыКлиент.Период
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц КАК РеквизитыЮрЛицоСчетДУ
	|		ПО ВТ2.ЮрЛицоСчетаДУ = РеквизитыЮрЛицоСчетДУ.ЮрФизЛицо
	|			И (РеквизитыЮрЛицоСчетДУ.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
	|			И (РеквизитыЮрЛицоСчетДУ.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
	|			И ВТ2.Дата >= РеквизитыЮрЛицоСчетДУ.Период
	|		ЛЕВОЕ СОЕДИНЕНИЕ _СрезДействующихУсловийНаДатыРазмещения КАК _СрезДействующихУсловийНаДатыРазмещения
	|		ПО ВТ2.ДепозитныйВклад = _СрезДействующихУсловийНаДатыРазмещения.КредитныйИнструмент
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ2.СчетДУ,
	|	ВТ2.Клиент,
	|	ВТ2.ЮрЛицоСчетаДУ,
	|	ВТ2.Сумма,
	|	ВТ2.Дата,
	|	ВТ2.ДепозитныйВклад,
	|	ВТ2.Валюта,
	|	ВТ2.Банк,
	|	ВТ2.ДатаДоговораДУ,
	|	ВТ2.ДепозитныйВкладБанковскийСчетДоговор,
	|	ВТ2.НомерДоговораДУ,
	|	ВТ2.СпецДепозитарий,
	|	ВТ2.Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ3.Клиент КАК Клиент,
	|	РеквизитыКлиент.ПолноеНаименованиеПоУставу КАК КлиентПолноеНаименованиеПоУставу,
	|	ВТ3.ЮрЛицоСчетаДУ КАК ЮрЛицоСчетаДУ,
	|	РеквизитыРеквизитыЮрЛицоСчетаДУ.ПолноеНаименованиеПоУставу КАК ЮрЛицоСчетаДУПолноеНаименованиеПоУставу,
	|	ВТ3.Дата КАК Дата,
	|	ВТ3.СчетДУ КАК СчетДУ,
	|	ВТ3.НомерДоговораДУ КАК НомерДоговораДУ,
	|	ВТ3.ДатаДоговораДУ КАК ДатаДоговораДУ,
	|	ВТ3.Банк КАК Банк,
	|	ВТ3.Сумма КАК Сумма,
	|	ВТ3.Валюта.НаименованиеПолное КАК Валюта,
	|	ВТ3.ДепозитныйВкладБанковскийСчетДоговор КАК ДепозитныйВкладБанковскийСчетДоговор,
	|	ВТ3.ДепозитныйВклад КАК ДепозитныйВклад,
	|	ВТ3.Банк.Наименование КАК БанкНаименование,
	|	_СрезДействующихУсловийНаДатыРазмещения.ДатаПогашения КАК ДатаПогашения,
	|	_СрезДействующихУсловийНаДатыРазмещения.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
	|	_СрезДействующихУсловийНаДатыРазмещения.Процент КАК Процент,
	|	РАЗНОСТЬДАТ(ВТ3.ДепозитныйВклад.ДатаРегистрации, _СрезДействующихУсловийНаДатыРазмещения.ДатаПогашения, ДЕНЬ) КАК КоличествоДнейВклада,
	|	ВТ3.ДепозитныйВкладБанковскийСчетДоговор.НомерДоговора КАК ДепозитныйВкладНомерДоговора,
	|	ВТ3.ДепозитныйВкладБанковскийСчетДоговор.ДатаЗаключения КАК ДепозитныйВкладДатаЗаключения,
	|	ВТ3.СпецДепозитарий КАК СпецДепозитарий,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ВТ3.СпецДепозитарий) КАК СпецДепозитарийПредставление,
	|	КонтактныеЛица.КонтактноеЛицо.Представление КАК КонтактноеЛицо,
	|	КонтактныеЛица.Должность КАК Должность,
	|	ВТ3.ДепозитныйВклад.ДоВостребования КАК ДоВостребования
	|ИЗ
	|	ВТ3 КАК ВТ3
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц КАК РеквизитыКлиент
	|		ПО ВТ3.Клиент = РеквизитыКлиент.ЮрФизЛицо
	|			И (РеквизитыКлиент.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
	|			И (РеквизитыКлиент.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
	|			И ВТ3.ПериодРеквизитыКлиент = РеквизитыКлиент.Период
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц КАК РеквизитыРеквизитыЮрЛицоСчетаДУ
	|		ПО ВТ3.ЮрЛицоСчетаДУ = РеквизитыРеквизитыЮрЛицоСчетаДУ.ЮрФизЛицо
	|			И (РеквизитыРеквизитыЮрЛицоСчетаДУ.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
	|			И (РеквизитыРеквизитыЮрЛицоСчетаДУ.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
	|			И ВТ3.ПериодРеквизитыЮрЛицоСчетаДУ = РеквизитыРеквизитыЮрЛицоСчетаДУ.Период
	|		ЛЕВОЕ СОЕДИНЕНИЕ _СрезДействующихУсловийНаДатыРазмещения КАК _СрезДействующихУсловийНаДатыРазмещения
	|		ПО ВТ3.ДепозитныйВклад = _СрезДействующихУсловийНаДатыРазмещения.КредитныйИнструмент
	|			И ВТ3.ДатаНачалаДействияУсловийКредитныхИнструментов = _СрезДействующихУсловийНаДатыРазмещения.ДатаНачалаДействияУсловий
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
	|		ПО ВТ3.Организация.ЮрФизЛицо = КонтактныеЛица.Объект
	|			И (КонтактныеЛица.КонтактноеЛицо = &Подписант)
	|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))";
	
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	Запрос.УстановитьПараметр("Подписант"	, Объект.Подписант);
	
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	Выборка = ПакетРезультатов[4].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураРеквизитов = Новый Структура;
		
		СтруктураРеквизитов.Вставить("СпецДепозитарий"				, Выборка.СпецДепозитарий);
		СтруктураРеквизитов.Вставить("СпецДепозитарийПредставление"	, Выборка.СпецДепозитарийПредставление);
		СтруктураРеквизитов.Вставить("Клиент", Выборка.КлиентПолноеНаименованиеПоУставу);
		СтруктураРеквизитов.Вставить("ЮрЛицоСчетаДУ", Выборка.ЮрЛицоСчетаДУПолноеНаименованиеПоУставу);
		СтруктураРеквизитов.Вставить("ДоговорДУ", Выборка.НомерДоговораДУ + " от " + Формат(Выборка.ДатаДоговораДУ, "ДФ=dd.MM.yyyy"));
		СтруктураРеквизитов.Вставить("Банк", Выборка.БанкНаименование);
		СтруктураРеквизитов.Вставить("Сумма", Формат(Выборка.Сумма, "ЧДЦ=2"));
		СтруктураРеквизитов.Вставить("Валюта", Строка(Выборка.Валюта));
		СтруктураРеквизитов.Вставить("УсловияСделки", "Процентная ставка - " + Выборка.Процент + "% годовых; срок - " + ?(Выборка.ДоВостребования, "до востребования", ""+Выборка.КоличествоДнейВклада + " дней") + ";  выплата процентов - " + Строка(Выборка.ПериодичностьВыплатыПроцентов) + ".");
		СтруктураРеквизитов.Вставить("Приложение", "ДОГОВОР БАНКОВСКОГО ДЕПОЗИТА № " + Выборка.ДепозитныйВкладНомерДоговора  + " от " + Формат(Выборка.ДепозитныйВкладДатаЗаключения, "ДФ='dd MMMM yyyy'") + " года");
		СтруктураРеквизитов.Вставить("КонтактноеЛицо", Сред(Выборка.КонтактноеЛицо, Найти(Выборка.КонтактноеЛицо, " ") + 1) + " " + Лев(Выборка.КонтактноеЛицо, Найти(Выборка.КонтактноеЛицо, " ") - 1));
		
		НовыйМассив.Добавить(СтруктураРеквизитов);
	
	КонецЦикла;
	
	Возврат НовыйМассив;
	
КонецФункции

&НаКлиенте
Процедура ДатаОплатыПриИзменении(Элемент)
	
	Объект.СдвигДатыОплаты = Объект.ДатаОплаты - ТекущаяДата();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Объект.ДатаОплаты = ТекущаяДата() + Объект.СдвигДатыОплаты;
	
КонецПроцедуры









