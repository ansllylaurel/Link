
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ШаблонЗапроса = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ЗапросСогласия");
	
	СписокДокументов.ЗагрузитьЗначения(Параметры.МассивДокументов); 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область Текст_Запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	МНО.Организация КАК Организация,
		|	МНО.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _ДанныеДокументов
		|ИЗ
		|	Документ.МНО КАК МНО
		|ГДЕ
		|	МНО.Ссылка В(&МассивДокументов)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Распоряжение.Организация,
		|	Распоряжение.СчетДоверительногоУправления
		|ИЗ
		|	Документ.Распоряжение КАК Распоряжение
		|ГДЕ
		|	Распоряжение.Ссылка В(&МассивДокументов)
		|	И Распоряжение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ПРЕДСТАВЛЕНИЕ(КонтактныеЛица.КонтактноеЛицо) КАК ФИО,
		|	КонтактныеЛица.КонтактноеЛицо КАК ФизЛицо,
		|	КонтактныеЛица.Должность КАК Должность,
		|	ОтветственныеЛица.ЭтоПодписант КАК ЭтоПодписант
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ДанныеДокументов.СчетДоверительногоУправления.СпециализированныйДепозитарий.ЮрФизЛицо КАК ЮрФизЛицо,
		|		ЛОЖЬ КАК ЭтоПодписант
		|	ИЗ
		|		_ДанныеДокументов КАК _ДанныеДокументов
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ДанныеДокументов.Организация.ЮрФизЛицо,
		|		ИСТИНА
		|	ИЗ
		|		_ДанныеДокументов КАК _ДанныеДокументов) КАК ОтветственныеЛица
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|		ПО ОтветственныеЛица.ЮрФизЛицо = КонтактныеЛица.Объект";
#КонецОбласти

	Запрос.УстановитьПараметр("МассивДокументов", Параметры.МассивДокументов);
	ТаблицаОтветственных.Загрузить(Запрос.Выполнить().Выгрузить());
	
	МассивСтрок = ТаблицаОтветственных.НайтиСтроки(Новый Структура("ЭтоПодписант", Истина));
	
	Для Каждого ТекСтрока Из МассивСтрок Цикл
		Элементы.Подписант.СписокВыбора.Добавить(ТекСтрока.ФизЛицо);	
	КонецЦикла;
	
	МассивСтрок = ТаблицаОтветственных.НайтиСтроки(Новый Структура("ЭтоПодписант", Ложь));
	
	Для Каждого ТекСтрока Из МассивСтрок Цикл
		Элементы.Ответственный.СписокВыбора.Добавить(ТекСтрока.ФИО);	
	КонецЦикла;
	
	Объект.Ответственный = ?(МассивСтрок.Количество() = 1, МассивСтрок[0].ФИО, "");
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМассивЗапросов(МассивДокументов)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Обработки.ПечатьМНО.СформироватьМенеджерВременныхТаблицСДанными(МассивДокументов);
	
#Область Текст_Запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеДокументов.Организация КАК Организация,
		|	КонтактнаяИнформация.Период КАК Период,
		|	КонтактнаяИнформация.Представление КАК Представление
		|ПОМЕСТИТЬ _ПолнаяТаблицаКонтактов
		|ИЗ
		|	_ДанныеДокументов КАК _ДанныеДокументов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|		ПО _ДанныеДокументов.Дата >= КонтактнаяИнформация.Период
		|			И _ДанныеДокументов.Организация.ЮрФизЛицо = КонтактнаяИнформация.Объект
		|			И (КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактическийАдрес))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Организация КАК Организация,
		|	_ПолнаяТаблицаКонтактов.Представление КАК Представление
		|ПОМЕСТИТЬ КонтактнаяИнформация
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ПолнаяТаблицаКонтактов.Организация КАК Организация,
		|		МАКСИМУМ(_ПолнаяТаблицаКонтактов.Период) КАК Период
		|	ИЗ
		|		_ПолнаяТаблицаКонтактов КАК _ПолнаяТаблицаКонтактов
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ПолнаяТаблицаКонтактов.Организация) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПолнаяТаблицаКонтактов КАК _ПолнаяТаблицаКонтактов
		|		ПО ВложенныйЗапрос.Период = _ПолнаяТаблицаКонтактов.Период
		|			И ВложенныйЗапрос.Организация = _ПолнаяТаблицаКонтактов.Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеДокументов.РасчетныйСчет КАК РасчетныйСчет,
		|	ДокументыЮридическихЛиц.Номер КАК ОГРН,
		|	ДокументыЮридическихЛиц.Период КАК Период
		|ПОМЕСТИТЬ _ПолнаяТаблицаДанныхДокументовЮрЛиц
		|ИЗ
		|	_ДанныеДокументов КАК _ДанныеДокументов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц КАК ДокументыЮридическихЛиц
		|		ПО _ДанныеДокументов.РасчетныйСчет.Банк.ЮрФизЛицо = ДокументыЮридическихЛиц.ЮрФизЛицо
		|			И (ДокументыЮридическихЛиц.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И (ДокументыЮридическихЛиц.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|			И (ДокументыЮридическихЛиц.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации))
		|			И _ДанныеДокументов.Дата >= ДокументыЮридическихЛиц.Период
		|			И (ДокументыЮридическихЛиц.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ ДокументыЮридическихЛиц.ДействуетПо > _ДанныеДокументов.Дата)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.РасчетныйСчет КАК РасчетныйСчет,
		|	_ПолнаяТаблицаДанныхДокументовЮрЛиц.ОГРН КАК ОГРН,
		|	_ПолнаяТаблицаДанныхДокументовЮрЛиц.Период КАК ДатаВыдачиОГРН
		|ПОМЕСТИТЬ _ДанныеДокументовЮрЛиц
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ПолнаяТаблицаДанныхДокументовЮрЛиц.РасчетныйСчет КАК РасчетныйСчет,
		|		МАКСИМУМ(_ПолнаяТаблицаДанныхДокументовЮрЛиц.Период) КАК Период
		|	ИЗ
		|		_ПолнаяТаблицаДанныхДокументовЮрЛиц КАК _ПолнаяТаблицаДанныхДокументовЮрЛиц
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ПолнаяТаблицаДанныхДокументовЮрЛиц.РасчетныйСчет) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПолнаяТаблицаДанныхДокументовЮрЛиц КАК _ПолнаяТаблицаДанныхДокументовЮрЛиц
		|		ПО ВложенныйЗапрос.Период = _ПолнаяТаблицаДанныхДокументовЮрЛиц.Период
		|			И ВложенныйЗапрос.РасчетныйСчет = _ПолнаяТаблицаДанныхДокументовЮрЛиц.РасчетныйСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеДокументов.НомерПодтверждения КАК Номер,
		|	_ДанныеДокументов.Дата КАК ДатаРаспоряжения,
		|	_ДанныеДокументов.Сумма КАК Сумма,
		|	_ДанныеДокументов.Процент КАК Процент,
		|	_ДанныеДокументов.ДатаВозврата КАК ДатаКонец,
		|	БанковскиеСчета.ДоговорМНО КАК ДоговорМНО,
		|	БанковскиеСчета.Банк.Наименование КАК НаименованиеБанка,
		|	БанковскиеСчета.Банк.Город КАК Город,
		|	БанковскиеСчета.Договор.НаименованиеВладельцаДляДокументов КАК Клиент,
		|	БанковскиеСчета.НомерСчета КАК НомерСчета,
		|	БанковскиеСчета.Валюта.НаименованиеПолное КАК Валюта,
		|	БанковскиеСчета.Валюта.ПараметрыПрописиНаРусском КАК ПараметрыПрописиВалютыНаРусском,
		|	БанковскиеСчета.Банк.КоррСчет КАК КоррСчет,
		|	БанковскиеСчета.Банк.Код КАК БИК,
		|	РеквизитыБанков.КраткоеНаименованиеПоУставу КАК Банк,
		|	РеквизитыБанков.ИНН КАК ИНН,
		|	_ДанныеДокументовЮрЛиц.ОГРН КАК ОГРН,
		|	_ДанныеДокументовЮрЛиц.ДатаВыдачиОГРН КАК ДатаВыдачиОГРН,
		|	РеквизитыОрганизаций.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеОрганизации,
		|	РеквизитыОрганизаций.Наименование КАК КраткоеНаименованиеОрганизации,
		|	РеквизитыКлиентов.Наименование КАК ПолноеНаименованиеКлиента,
		|	РеквизитыСпецДепозитария.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеСпецДепозитария,
		|	КонтактнаяИнформация.Представление КАК МестонахождениеУК
		|ИЗ
		|	_ДанныеДокументов КАК _ДанныеДокументов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		|		ПО _ДанныеДокументов.РасчетныйСчет = БанковскиеСчета.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеДокументовЮрЛиц КАК _ДанныеДокументовЮрЛиц
		|		ПО _ДанныеДокументов.РасчетныйСчет = _ДанныеДокументовЮрЛиц.РасчетныйСчет
		|		ЛЕВОЕ СОЕДИНЕНИЕ РеквизитыЮрЛиц КАК РеквизитыБанков
		|		ПО _ДанныеДокументов.РасчетныйСчет = РеквизитыБанков.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрФизЛицАнкетные КАК РеквизитыОрганизаций
		|		ПО _ДанныеДокументов.Организация = РеквизитыОрганизаций.Объект
		|			И РеквизитыОрганизаций.ЭтоОрганизация
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрФизЛицАнкетные КАК РеквизитыКлиентов
		|		ПО _ДанныеДокументов.СчетДоверительногоУправления = РеквизитыКлиентов.Объект
		|			И НЕ РеквизитыКлиентов.ЭтоОрганизация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РеквизитыЮрЛиц КАК РеквизитыСпецДепозитария
		|		ПО _ДанныеДокументов.СчетДоверительногоУправления.СпециализированныйДепозитарий = РеквизитыСпецДепозитария.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ КонтактнаяИнформация КАК КонтактнаяИнформация
		|		ПО _ДанныеДокументов.Организация = КонтактнаяИнформация.Организация";
#КонецОбласти
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	НовыйМассив = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураРеквизитов = Новый Структура;
		СтруктураРеквизитов.Вставить("Номер", Строка(Выборка.Номер));
		СтруктураРеквизитов.Вставить("ДатаРаспоряжения", Формат(Выборка.ДатаРаспоряжения, "ДФ=dd.MM.yyyy"));
		
		ГенСоглашение = СокрЛ(СтрЗаменить(Выборка.ДоговорМНО.Наименование, "Ген.соглашение ", "№ "));
		СтруктураРеквизитов.Вставить("ГенСоглашение", СокрЛП(Сред(ГенСоглашение, Найти(ГенСоглашение, "№") + 1)));
		СтруктураРеквизитов.Вставить("Банк", СокрЛП(Выборка.НаименованиеБанка));
		СтруктураРеквизитов.Вставить("Клиент", Выборка.Клиент);
		СтруктураРеквизитов.Вставить("НомерСчета1", Выборка.НомерСчета);
		СтруктураРеквизитов.Вставить("НомерСчета2", "р/с " + Выборка.НомерСчета);
		СтруктураРеквизитов.Вставить("Банк2", Строка(Выборка.Банк) + " " + (Выборка.Город));
		СтруктураРеквизитов.Вставить("КоррСчет2", "кор/сч " + Выборка.КоррСчет + "  БИК " + Выборка.БИК);
		СтруктураРеквизитов.Вставить("ИНН2", "ИНН " + Выборка.ИНН);
		
		СтруктураРеквизитов.Вставить("Валюта", Выборка.Валюта);
		СтруктураРеквизитов.Вставить("Сумма", Формат(Выборка.Сумма, "ЧДЦ=2") + " (" + ЧислоПрописью(Выборка.Сумма,, Выборка.ПараметрыПрописиВалютыНаРусском) + ")");
		СтруктураРеквизитов.Вставить("Ставка", Формат(Выборка.Процент, "ЧЦ=5; ЧДЦ=2")  + " %");
		СтруктураРеквизитов.Вставить("ДатаНачало", Формат(Выборка.ДатаРаспоряжения	, "ДФ='dd MMMM yyyy'") + " года");
		СтруктураРеквизитов.Вставить("ДатаКонец", Формат(Выборка.ДатаКонец	, "ДФ=dd.MM.yyyy") + "г");
		
		СтруктураРеквизитов.Вставить("ОГРН", "ОГРН " + Выборка.ОГРН);
		СтруктураРеквизитов.Вставить("ДатаВыдачиОГРН", "от " + Формат(Выборка.ДатаВыдачиОГРН, "ДФ=dd.MM.yyyy") + "г");
		СтруктураРеквизитов.Вставить("ПолноеНаименованиеОрганизации", СокрЛП(Выборка.ПолноеНаименованиеОрганизации));
		СтруктураРеквизитов.Вставить("КраткоеНаименованиеОрганизации", СокрЛП(Выборка.КраткоеНаименованиеОрганизации));
		СтруктураРеквизитов.Вставить("ПолноеНаименованиеКлиента", СокрЛП(Выборка.ПолноеНаименованиеКлиента));
		СтруктураРеквизитов.Вставить("КраткоеНаименованиеСпецДепозитария", СокрЛП(Выборка.КраткоеНаименованиеСпецДепозитария));
		СтруктураРеквизитов.Вставить("МестонахождениеУК", СокрЛП(Выборка.МестонахождениеУК));
		СтруктураРеквизитов.Вставить("Лицензия", "21-000-1-00064 от 22.05.2002г.");
		СтруктураРеквизитов.Вставить("Характер", "Размещение денежных средств на неснижаемый остаток.");
		СтруктураРеквизитов.Вставить("ОписаниеИмущества", "Денежные средства на расчетном счете.");
		
		НовыйМассив.Добавить(СтруктураРеквизитов);
	
	КонецЦикла;
	
	Возврат НовыйМассив;

КонецФункции

&НаКлиенте
Функция ПолучитьРеквизитыФизЛица(ФизЛицо)
	
	РеквизитыФизЛица = Новый Структура("ФИО, Должность", "" "", "" "");
	ПараметрыОтбора = Новый Структура("ФИО", ФизЛицо);
	
	НайденныеСтроки = ТаблицаОтветственных.НайтиСтроки(ПараметрыОтбора);
		
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		ЗаполнитьЗначенияСвойств(РеквизитыФизЛица, НайденныеСтроки[0]);
		РеквизитыФизЛица.ФИО = Сред(РеквизитыФизЛица.ФИО, Найти(РеквизитыФизЛица.ФИО, " ") + 1) + " " + Лев(РеквизитыФизЛица.ФИО, Найти(РеквизитыФизЛица.ФИО, " ") - 1);
	
	КонецЕсли; 
	
	Возврат РеквизитыФизЛица
	
КонецФункции

&НаКлиенте
Процедура Печать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("Печать");
	Попытка
		ВыполнитьПечать(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПечать(ПараметрыСессии)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		ПараметрыСессии.ТекстОшибки = "Проверка заполнения не пройдена";
		Возврат;
	КонецЕсли;
	
	МассивПодтверждений = ПолучитьМассивЗапросов(СписокДокументов.ВыгрузитьЗначения());
	РеквизитыПодписанта = ПолучитьРеквизитыФизЛица(Объект.Подписант);
	РеквизитыОтветственного = ПолучитьРеквизитыФизЛица(Объект.Ответственный);
	
	Для Каждого Подтверждение Из МассивПодтверждений Цикл
	
		ИмяФайлаШаблонаРаспоряжения = ПолучитьИмяВременногоФайла("dot");

		ШаблонЗапроса.Записать(ИмяФайлаШаблонаРаспоряжения);
		
		// создадим документ MS Word на основании сохраненного шаблона
		WordApp = Новый COMОбъект("Word.Application");
				
		WordApp.Application.Documents.Add(ИмяФайлаШаблонаРаспоряжения, False);
		
		
		WordVars = WordApp.Application.ActiveDocument.Variables;
		
		Для Каждого РеквизитПодтверждения Из Подтверждение Цикл
			WordVars.Item(РеквизитПодтверждения.Ключ).Value = РеквизитПодтверждения.Значение;
		КонецЦикла;
		
		WordVars.Item("Должность").Value    = РеквизитыПодписанта.Должность;
		WordVars.Item("Подписант").Value    = "(" + РеквизитыПодписанта.ФИО + ")";
		
		WordVars.Item("ДолжностьОтветственного").Value	= РеквизитыОтветственного.Должность + " " + Подтверждение.КраткоеНаименованиеСпецДепозитария;
		WordVars.Item("Ответственный").Value    		= "(" + РеквизитыОтветственного.ФИО + ")";
		
		WordApp.Application.ActiveDocument.Fields.Update();
		WordApp.Application.Visible = True;
		
		// удалим файл шаблона
		Попытка
			УдалитьФайлы(КаталогВременныхФайлов(), ИмяФайлаШаблонаРаспоряжения);
		Исключение
		КонецПопытки;
	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен ответственный спец. депозитария");
	
	КонецЕсли; 
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
