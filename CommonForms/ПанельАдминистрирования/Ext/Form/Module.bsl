
&НаСервереБезКонтекста
Процедура УстановитьНовоеЗначениеКонстанты(ИмяКонстанты, НовоеЗнч)
	
	// если требуется, установим новое значение (блокировка данных не требуется)
	Если Константы[ИмяКонстанты].Получить() <> НовоеЗнч Тогда
		Константы[ИмяКонстанты].Установить(НовоеЗнч);
	КонецЕсли;
	
КонецПроцедуры // УстановитьНовоеЗначениеКонстанты

&НаСервереБезКонтекста
Процедура УстановитьЗначениеПараметраСеанса(ИмяПараметра, НовоеЗнч)
	
	ПараметрыСеанса[ИмяПараметра] = НовоеЗнч;
	
КонецПроцедуры // УстановитьЗначениеПараметраСеанса

&НаСервере
Процедура ПеречитатьНастройкиНаСервере()
	
	ЭтаФорма.СтрокаСоединенияРабочейИнформационнойБазы  = Константы.СтрокаСоединенияРабочейИнформационнойБазы.Получить();
	ЭтаФорма.ФормированиеДвиженийПоРегистрамБухгалтерии = ОбщегоНазначения.ЗначениеПараметраСеанса("ФормированиеДвиженийПоРегистрамБухгалтерии");
	ЭтаФорма.ФормированиеДвиженийПоРегистрамБэкОфиса    = ОбщегоНазначения.ЗначениеПараметраСеанса("ФормированиеДвиженийПоРегистрамБэкОфиса");

КонецПроцедуры // ПеречитатьНастройкиНаСервере


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПеречитатьНастройкиНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	РаботаСФормамиКлиент.ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка, Модифицированность);
	
КонецПроцедуры


&НаКлиенте
Процедура КомандаНастройкаПроксиСервера(Команда)
	
#Если ВебКлиент Тогда
	Предупреждение(НСтр("ru = 'В веб-клиенте параметры прокси-сервера необходимо задавать в настройках браузера.'"));
	Возврат;
#КонецЕсли		

	ОткрытьФорму("ОбщаяФорма.ПараметрыПроксиСервера", Новый Структура("НастройкаПроксиНаКлиенте", Ложь));
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСохранить(Команда)
	
	УстановитьНовоеЗначениеКонстанты("СтрокаСоединенияРабочейИнформационнойБазы", ЭтаФорма.СтрокаСоединенияРабочейИнформационнойБазы);
	
	УстановитьЗначениеПараметраСеанса("ФормированиеДвиженийПоРегистрамБухгалтерии", ЭтаФорма.ФормированиеДвиженийПоРегистрамБухгалтерии);
	УстановитьЗначениеПараметраСеанса("ФормированиеДвиженийПоРегистрамБэкОфиса",    ЭтаФорма.ФормированиеДвиженийПоРегистрамБэкОфиса);
	
	ЭтаФорма.Модифицированность = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПеречитать(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда
		Если Вопрос("Все несохраненные изменения будут утеряны. Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;			
			
	ПеречитатьНастройкиНаСервере();
	
	ЭтаФорма.Модифицированность = Ложь;
	
КонецПроцедуры
