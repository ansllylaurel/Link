							НоваяСтрока.ТипКомиссии = ПолучитьТипКомиссии(СтрЗаменить(СтрЗаменить(Строка, "<TD CLASS=""LEFT"">", ""), "</TD>", ""));
						КонецЕсли;
						
						Если СтрНайти(Строка, "<TD CLASS=""RIGHT"" STYLE=""WIDTH:25%"">") > 0 Тогда
							
							НоваяСтрока.Сумма = Число(СтрЗаменить(СтрЗаменить(Строка, "<TD CLASS=""RIGHT"" STYLE=""WIDTH:25%"">", ""), "</TD>", ""));
							
							ОстаткиЗадолженностиПоКомиссииНаНачало.Добавить(НоваяСтрока);
							
						КонецЕсли;
						
						Если СтрНайти(Строка, "</TABLE>") > 0 Тогда
							ОбработкаНачальныхОстатковКомиссии = Ложь;
							Результат.Вставить("ОстаткиЗадолженностиПоКомиссииНаНачало", ОстаткиЗадолженностиПоКомиссииНаНачало);
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;
				
				Если СтрНайти(Строка, "<H5>НАЧИСЛЕНО ЗА ПЕРИОД:</H5>") > 0 Тогда
					
					НачисленнаяКомиссияЗаПериод = Новый Массив;
					
					ОбработкаНачисленнойКомиссии = Истина;
					
