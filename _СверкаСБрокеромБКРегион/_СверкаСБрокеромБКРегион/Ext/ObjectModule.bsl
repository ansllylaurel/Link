	Accounts_Divisions.Колонки.Добавить("Account_ID", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(15)));
	Accounts_Divisions.Колонки.Добавить("Number"    , Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(15)));
	Accounts_Divisions.Колонки.Добавить("Секция"    , Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(15)));
