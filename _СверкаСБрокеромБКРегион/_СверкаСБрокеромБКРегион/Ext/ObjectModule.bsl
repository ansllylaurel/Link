
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Сверка с брокером БК РЕГИОН",
		"2.90",
		"",
		Истина,
		"СкриншотФормы");
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Функция ПолучитьРезультатСравнения(Брокер, Депозитарий, Период, Каталог, СверкаСМесячнымОтчетомБрокера, СчетаДУ = Неопределено) Экспорт
	
	Если СверкаСМесячнымОтчетомБрокера Тогда
		НачалоПериода	= НачалоМесяца(Период);
		КонецПериода	= КонецМесяца(Период);
	Иначе
		НачалоПериода	= Период;
		КонецПериода	= КонецДня(Период);
	КонецЕсли;
		
	// Получаем данные файлов с отчетами брокера.
	ДанныеОтчетов = ПолучитьДанныеОтчетов(Брокер, НачалоПериода, КонецПериода, Каталог, СверкаСМесячнымОтчетомБрокера,,,СчетаДУ);
	
	Если ДанныеОтчетов = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Подготавливаем структуру для результатов сверки.
	// Таблица для списка проверенных счетов доверительного управления и стратегий.
	СчетаДоверительногоУправления = Новый ТаблицаЗначений;
	СчетаДоверительногоУправления.Колонки.Добавить("СчетДоверительногоУправления",	Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	СчетаДоверительногоУправления.Колонки.Добавить("Стратегия",						Новый ОписаниеТипов("СправочникСсылка.СтратегииИндивидуальногоИнвестирования"));
	СчетаДоверительногоУправления.Колонки.Добавить("ВремяПолученияДанных",			Новый ОписаниеТипов("Дата"));
	
	// Массив типов для колонки "Субъект аналитики".
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.СчетаДоверительногоУправления"));
	МассивТипов.Добавить(Тип("СправочникСсылка.СтратегииИндивидуальногоИнвестирования"));
	
	МассивТиповДБО = Новый Массив;
	МассивТиповДБО.Добавить(Тип("СправочникСсылка.ДоговорыБрокерскогоОбслуживания"));
	МассивТиповДБО.Добавить(Тип("СправочникСсылка.Договоры"));
	
	// Таблица для расхождений, выявленных при сверке.
	Расхождения = Новый ТаблицаЗначений;
	Расхождения.Колонки.Добавить("ДоговорБрокерскогоОбслуживания",	Новый ОписаниеТипов(МассивТиповДБО));
	Расхождения.Колонки.Добавить("СубъектАналитики",				Новый ОписаниеТипов(МассивТипов));
	Расхождения.Колонки.Добавить("ВалютнаяСекция",					Новый ОписаниеТипов("Булево"));
	Расхождения.Колонки.Добавить("НачалоПериода",					Новый ОписаниеТипов("Дата"));
	Расхождения.Колонки.Добавить("КонецПериода",					Новый ОписаниеТипов("Дата"));
	Расхождения.Колонки.Добавить("ВнебиржевойРынок",				Новый ОписаниеТипов("Булево"));
	Расхождения.Колонки.Добавить("Валюта",							Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	Расхождения.Колонки.Добавить("ЦеннаяБумага",					Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
	Расхождения.Колонки.Добавить("Блок",							Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ДатаОперации",					Новый ОписаниеТипов("Дата"));
	Расхождения.Колонки.Добавить("Показатель",						Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("Брокер",							Новый ОписаниеТипов("Число"));
	Расхождения.Колонки.Добавить("УчетнаяСистема",					Новый ОписаниеТипов("Число"));
	Расхождения.Колонки.Добавить("Расхождение",						Новый ОписаниеТипов("Булево"));
	
	Результат = Новый Структура("СверенныеСчетаДоверительногоУправления, Расхождения", СчетаДоверительногоУправления, Расхождения); 
	
	КлючиДляСверки = ПолучитьКлючиДляСверки(ДанныеОтчетов.МВТ, Брокер, СверкаСМесячнымОтчетомБрокера, НачалоПериода, КонецПериода, СчетаДУ);
	
	#Область Сравнение_данных
	
	// Получаем результат сверки по ключам с полным периодом сверки (сутки / месяц);
	Если КлючиДляСверки.СПолнымПериодом.Количество() > 0 Тогда
		
		// Сравниваем данные отчетов по ключам.
		РезультатСравнения = ПроизвестиСверку(ДанныеОтчетов.МВТ, НачалоПериода, КонецПериода, Брокер, Депозитарий, Истина, СчетаДУ);
		
		// Дополняем результат сверки результатами сравнения отчетов по ключам.
		РаботаСКоллекциями.ТаблицаЗначений_Дополнить(РезультатСравнения.СверенныеСчетаДоверительногоУправления,	Результат.СверенныеСчетаДоверительногоУправления);
		РаботаСКоллекциями.ТаблицаЗначений_Дополнить(РезультатСравнения.Расхождения,							Результат.Расхождения);
		
	КонецЕсли;
	
	// Получаем результат сверки по ключам с разделенным периодом сверки (начало месяца - дата расторжения ДБО (включая) / дата расторжения ДБО (исключая) - конец месяца).
	Если СверкаСМесячнымОтчетомБрокера
		И КлючиДляСверки.СРазделеннымПериодом.Количество() > 0 Тогда
		
		Для Каждого Ключ Из КлючиДляСверки.СРазделеннымПериодом Цикл
			
			// Сравниваем данные отчетов по ключам.
			РезультатСравнения = ПроизвестиСверку(ДанныеОтчетов.МВТ, Ключ.НачалоПериода, Ключ.КонецПериода, Брокер, Депозитарий, Ложь);
			
			// Дополняем результат сверки результатами сравнения отчетов по ключам.
			РаботаСКоллекциями.ТаблицаЗначений_Дополнить(РезультатСравнения.СверенныеСчетаДоверительногоУправления,	Результат.СверенныеСчетаДоверительногоУправления);
			РаботаСКоллекциями.ТаблицаЗначений_Дополнить(РезультатСравнения.Расхождения,							Результат.Расхождения);
			
		КонецЦикла;
		
	КонецЕсли;
	
	#КонецОбласти
	
	#Область Заполнение_времени_получения_данных
	
	Для Каждого СверенныеДанные Из Результат.СверенныеСчетаДоверительногоУправления Цикл
		
		ВремяПолученияДанных = ДанныеОтчетов.ВремяПолученияДанных.Получить(СверенныеДанные.Стратегия);
		Если ВремяПолученияДанных <> Неопределено Тогда
			СверенныеДанные.ВремяПолученияДанных = ВремяПолученияДанных;
		КонецЕсли;
			
		ВремяПолученияДанных = ДанныеОтчетов.ВремяПолученияДанных.Получить(СверенныеДанные.СчетДоверительногоУправления);
		Если ВремяПолученияДанных <> Неопределено Тогда
			СверенныеДанные.ВремяПолученияДанных = ВремяПолученияДанных;
		КонецЕсли;
		
	КонецЦикла;
	
	#КонецОбласти
	
	Возврат Результат;
	
КонецФункции

Функция ФайлИмпортаСоответствуетСхемеXSD(МассивДанных, СхемаИмя) Экспорт
	
	ФайлСхемы = Новый Файл(КаталогВременныхФайлов() + "Schema.xsd");
	Если ФайлСхемы.Существует() Тогда
		УдалитьФайлы(ФайлСхемы.ПолноеИмя);
	КонецЕсли;
	
	МакетСхемыXSD = ЭтотОбъект.ПолучитьМакет(СхемаИмя);
	
	Попытка
		МакетСхемыXSD.Записать(ФайлСхемы.ПолноеИмя);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("XML файл не прошел проверку! Ошибка: Не удалось записать файл схемы в каталог временных файлов!" + Символы.ПС + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		КомОбъектКэшСхем = Новый COMОбъект("MSXML2.XMLSchemaCache.6.0");
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("XML файл не прошел проверку! Ошибка: Не удалось создать объект XMLSchemaCache" + Символы.ПС + ОписаниеОшибки());
		УдалитьФайлы(ФайлСхемы.ПолноеИмя);
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		КомОбъектКэшСхем.add(, ФайлСхемы.ПолноеИмя);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("XML файл не прошел проверку! Ошибка: Не удалось подключить схему: " + Символы.ПС + ОписаниеОшибки());
		УдалитьФайлы(ФайлСхемы.ПолноеИмя);
		Возврат Ложь;
	КонецПопытки;
	
	ИмяФайлаДанных = ПолучитьИмяВременногоФайла("xml");
		
	Для Каждого ФайлДанных Из МассивДанных Цикл
		
		ФайлДанных.ДвоичныеДанные.Записать(ИмяФайлаДанных);
		
		Попытка
			КомОбъектДок = Новый COMОбъект("MSXML2.DOMDocument.6.0");
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("XML файл не прошел проверку! Ошибка: Не удалось создать объект DOMDocument" + Символы.ПС + ОписаниеОшибки());
			УдалитьФайлы(ФайлСхемы.ПолноеИмя);
			Возврат Ложь;
		КонецПопытки;
		
		КомОбъектДок.schemas          = КомОбъектКэшСхем;
		КомОбъектДок.async            = Ложь;
		КомОбъектДок.validateOnParse  = Истина;
		КомОбъектДок.resolveExternals = Истина;
		КомОбъектДок.SetProperty("MultipleErrorMessages", Истина);
		
		Попытка
			КомОбъектДок.load(ИмяФайлаДанных);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("XML файл [" + ФайлДанных.ИмяФайла + "] не прошел проверку! Ошибка: Не удалось загрузить файл остатков в объект DOMDocument" + Символы.ПС + ОписаниеОшибки());
			УдалитьФайлы(ИмяФайлаДанных);
			УдалитьФайлы(ФайлСхемы.ПолноеИмя);
			Возврат Ложь;
		КонецПопытки;

		Если КомОбъектДок.parseError.errorCode <> 0 Тогда 
			
			ТекстСообщения = "Файл импорта [" + ФайлДанных.ИмяФайла + "] не соответствует схеме XSD."; 
		
			Для Каждого Ошибка из КомОбъектДок.parseError.AllErrors  Цикл
				ТекстСообщения = ТекстСообщения + Символы.ПС + СокрЛП(Ошибка.errorXPath) + " Ошибка: " + СокрЛП(Ошибка.reason);
			КонецЦикла;
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			УдалитьФайлы(ИмяФайлаДанных);
			УдалитьФайлы(ФайлСхемы.ПолноеИмя);
			Возврат Ложь;
			
		КонецЕсли;
			
	КонецЦикла;
	
	УдалитьФайлы(ИмяФайлаДанных);
	УдалитьФайлы(ФайлСхемы.ПолноеИмя);
	
	Возврат Истина;
	
КонецФункции // ФайлИмпортаСоответствуетСхемеXSD

Функция ПроизвестиСверку(МВТ, НачалоПериода, КонецПериода, Брокер, Депозитарий, ПолныйПериод, СчетаДУ = Неопределено)
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.УстановитьПараметр("Организация",							Организация);
	Запрос.УстановитьПараметр("Брокер",									Брокер);
	Запрос.УстановитьПараметр("Депозитарий",							Депозитарий);
	Запрос.УстановитьПараметр("БрокерЮридическоеЛицо",					Брокер.ЮрФизЛицо);
	Запрос.УстановитьПараметр("ВалютнаяСекция",							ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС_раздел_FX"));
	Запрос.УстановитьПараметр("СверятьБезУчетаВалютнойСекции",			СверятьБезУчетаВалютнойСекции);
	Запрос.УстановитьПараметр("НачалоПериода",							НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",							КонецПериода);
	Запрос.УстановитьПараметр("КонецПериодаГраница",					Новый Граница(КонецДня(КонецПериода), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ВалютаУчета",							Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("ПолныйПериод",							ПолныйПериод);
	Запрос.УстановитьПараметр("Ключ",   								"УчетНеВедется");
	
	ИспользоватьОтборПоВидамДоговоровСчетовДУ = РаботаСВнешнимиСистемами.ИмпортРазделенПоОчередям(ЭтотОбъект.Организация) И  ЭтотОбъект.ОчередьЗагрузки <> 0;
	Запрос.УстановитьПараметр("ИспользоватьОтборПоВидамДоговоровСчетовДУ", ИспользоватьОтборПоВидамДоговоровСчетовДУ);
	
	Если ИспользоватьОтборПоВидамДоговоровСчетовДУ Тогда
		Запрос.УстановитьПараметр("ВидыДоговоровСчетовДУ", РаботаСВнешнимиСистемами.ПолучитьВидыДоговорДоверительногоУправленияДляОчереди(ЭтотОбъект.Организация, ЭтотОбъект.ОчередьЗагрузки));
	Иначе
		Запрос.УстановитьПараметр("ВидыДоговоровСчетовДУ", Новый Массив());
	КонецЕсли;
	
	Запрос.Текст = ПолучитьТекстЗапроса();
	
	Расхождения = Запрос.Выполнить().Выгрузить();
	
	РезультатСравнения = Новый Структура("СверенныеСчетаДоверительногоУправления, Расхождения",
		МВТ.Таблицы["_СверенныеСчета"].ПолучитьДанные().Выгрузить(),
		Расхождения);
	
	Возврат РезультатСравнения;
	
КонецФункции

Функция ПолучитьКлючиДляСверки(МВТ, Брокер, СверкаСМесячнымОтчетомБрокера, НачалоПериода, КонецПериода, СчетаДУ = Неопределено)
	
	Если Не СчетаДУ = Неопределено Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтратегииИндивидуальногоИнвестированияСрезПоследних1.СчетДоверительногоУправления КАК СчетДУ
			|ИЗ
			|	РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(
			|			&КоненцПериода,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления В (&СчетаДУ)) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(&КоненцПериода, Организация = &Организация) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних1
			|		ПО СтратегииИндивидуальногоИнвестированияСрезПоследних.Организация = СтратегииИндивидуальногоИнвестированияСрезПоследних1.Организация
			|			И СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия = СтратегииИндивидуальногоИнвестированияСрезПоследних1.Стратегия";
		Запрос.УстановитьПараметр("КоненцПериода", КонецПериода);
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("СчетаДУ", СчетаДУ);
		
		МассивСчетовСтратегии = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СчетДУ");
		
		Если МассивСчетовСтратегии.Количество() > 0 Тогда
			РаботаСКоллекциями.ДополнитьМассив(СчетаДУ, МассивСчетовСтратегии, Истина);	
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("Брокер",							Брокер);
	Запрос.УстановитьПараметр("СверкаСМесячнымОтчетомБрокера",	СверкаСМесячнымОтчетомБрокера);
	Запрос.УстановитьПараметр("НачалоПериода",					НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",					КонецПериода);
	Запрос.УстановитьПараметр("ИспользоватьОтборПоСчетамДУ", НЕ (СчетаДУ = Неопределено));
	Запрос.УстановитьПараметр("СчетаДУ", СчетаДУ);
	Запрос.УстановитьПараметр("Ключ",   "УчетНеВедется");
			
	ИспользоватьОтборПоВидамДоговоровСчетовДУ = РаботаСВнешнимиСистемами.ИмпортРазделенПоОчередям(ЭтотОбъект.Организация) И  ЭтотОбъект.ОчередьЗагрузки <> 0;
	Запрос.УстановитьПараметр("ИспользоватьОтборПоВидамДоговоровСчетовДУ", ИспользоватьОтборПоВидамДоговоровСчетовДУ);
	
	Если ИспользоватьОтборПоВидамДоговоровСчетовДУ Тогда
		Запрос.УстановитьПараметр("ВидыДоговоровСчетовДУ", РаботаСВнешнимиСистемами.ПолучитьВидыДоговорДоверительногоУправленияДляОчереди(ЭтотОбъект.Организация, ЭтотОбъект.ОчередьЗагрузки));
	Иначе
		Запрос.УстановитьПараметр("ВидыДоговоровСчетовДУ", Новый Массив());
	КонецЕсли;	
	
	Запрос.Текст =
#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияДополнительныхСведений.Объект КАК Счет
		|ПОМЕСТИТЬ _НеИспользуемыеСчетаДУ
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Объект ССЫЛКА Справочник.СчетаДоверительногоУправления
		|	И ЗначенияДополнительныхСведений.Свойство.Ключ = &Ключ
		|	И ЗначенияДополнительныхСведений.Значение = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания КАК ДБО,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления КАК СДУ,
		|	&СверкаСМесячнымОтчетомБрокера
		|		И НЕ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|		И НЕ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|		И УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения < &КонецПериода КАК РазделитьПериодСверки,
		|	ЕСТЬNULL(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРасторжения
		|ПОМЕСТИТЬ _ДБОСДУ
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И Брокер = &Брокер
		|				И (НЕ &ИспользоватьОтборПоСчетамДУ ИЛИ СчетДоверительногоУправления В (&СчетаДУ)) 
		|				И (НЕ &ИспользоватьОтборПоВидамДоговоровСчетовДУ ИЛИ СчетДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоровСчетовДУ))
		|				И НЕ СчетДоверительногоУправления  В
		|				(ВЫБРАТЬ
		|					ВТ.Счет
		|				ИЗ
		|					_НеИспользуемыеСчетаДУ КАК ВТ)) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&КонецПериода, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания)
		|ГДЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код <> ""0""
		|	И (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &НачалоПериода)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДБО,
		|	СДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДБОСДУ.ДБО КАК ДБО,
		|	_ДБОСДУ.РазделитьПериодСверки КАК РазделитьПериодСверки,
		|	_ДБОСДУ.ДатаРасторжения КАК ДатаРасторжения
		|ПОМЕСТИТЬ _ДБОСтратегий
		|ИЗ
		|	_ДБОСДУ КАК _ДБОСДУ
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДБОСДУ.ДБО,
		|	_ДБОСДУ.РазделитьПериодСверки,
		|	_ДБОСДУ.ДатаРасторжения
		//|
		//|ИМЕЮЩИЕ
		//|	КОЛИЧЕСТВО(_ДБОСДУ.СДУ) > 1
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДБО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДБОСтратегий.ДБО КАК ДБО,
		|	СтратегииИндивидуальногоИнвестирования.Ссылка КАК Стратегия,
		|	_ДБОСДУ.СДУ КАК СДУ,
		|	_ДБОСтратегий.РазделитьПериодСверки КАК РазделитьПериодСверки,
		|	_ДБОСтратегий.ДатаРасторжения КАК ДатаРасторжения
		|ПОМЕСТИТЬ _Стратегии
		|ИЗ
		|	_ДБОСтратегий КАК _ДБОСтратегий
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтратегииИндивидуальногоИнвестирования КАК СтратегииИндивидуальногоИнвестирования
		|		ПО _ДБОСтратегий.ДБО = СтратегииИндивидуальногоИнвестирования.ОсновнойБрокерскийДоговор
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДБОСДУ КАК _ДБОСДУ
		|		ПО _ДБОСтратегий.ДБО = _ДБОСДУ.ДБО
		|ГДЕ
		|	(_ДБОСтратегий.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ _ДБОСтратегий.ДатаРасторжения >= &КонецПериода)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДБО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Стратегии.ДБО КАК ДБО,
		|	_Стратегии.Стратегия КАК СА,
		|	_Стратегии.СДУ КАК СДУ,
		|	_Стратегии.РазделитьПериодСверки КАК РазделитьПериодСверки,
		|	_Стратегии.ДатаРасторжения КАК ДатаРасторжения
		|ПОМЕСТИТЬ _Ключи
		|ИЗ
		|	_Стратегии КАК _Стратегии
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ДБОСДУ.ДБО,
		|	_ДБОСДУ.СДУ,
		|	_ДБОСДУ.СДУ,
		|	_ДБОСДУ.РазделитьПериодСверки,
		|	_ДБОСДУ.ДатаРасторжения
		|ИЗ
		|	_ДБОСДУ КАК _ДБОСДУ
		|ГДЕ
		|	НЕ _ДБОСДУ.ДБО В
		|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|					_Стратегии.ДБО КАК ДБО
		|				ИЗ
		|					_Стратегии КАК _Стратегии)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДБО,
		|	СА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИСТИНА КАК РазделенПериодСверки,
		|	_Ключи.ДБО КАК ДБО,
		|	_Ключи.СА КАК СА,
		|	_Ключи.СДУ КАК СДУ,
		|	&НачалоПериода КАК НачалоПериода,
		|	_Ключи.ДатаРасторжения КАК КонецПериода
		|ПОМЕСТИТЬ _ИтоговаяТаблица
		|ИЗ
		|	_Ключи КАК _Ключи
		|ГДЕ
		|	_Ключи.РазделитьПериодСверки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИСТИНА,
		|	_Ключи.ДБО,
		|	_Ключи.СА,
		|	_Ключи.СДУ,
		|	ДОБАВИТЬКДАТЕ(_Ключи.ДатаРасторжения, ДЕНЬ, 1),
		|	НАЧАЛОПЕРИОДА(&КонецПериода, ДЕНЬ)
		|ИЗ
		|	_Ключи КАК _Ключи
		|ГДЕ
		|	_Ключи.РазделитьПериодСверки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЛОЖЬ,
		|	_Ключи.ДБО,
		|	_Ключи.СА,
		|	_Ключи.СДУ,
		|	&НачалоПериода,
		|	НАЧАЛОПЕРИОДА(&КонецПериода, ДЕНЬ)
		|ИЗ
		|	_Ключи КАК _Ключи
		|ГДЕ
		|	НЕ _Ключи.РазделитьПериодСверки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИтоговаяТаблица.ДБО КАК ДБО,
		|	_ИтоговаяТаблица.СА КАК СА,
		|	_ИтоговаяТаблица.СДУ КАК СДУ,
		|	_ИтоговаяТаблица.НачалоПериода КАК НачалоПериода,
		|	_ИтоговаяТаблица.КонецПериода КАК КонецПериода
		|ПОМЕСТИТЬ _КлючиСПолнымПериодом
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|ГДЕ
		|	НЕ _ИтоговаяТаблица.РазделенПериодСверки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИтоговаяТаблица.ДБО КАК ДБО,
		|	_ИтоговаяТаблица.СА КАК СА,
		|	_ИтоговаяТаблица.СДУ КАК СДУ,
		|	_ИтоговаяТаблица.НачалоПериода КАК НачалоПериода,
		|	_ИтоговаяТаблица.КонецПериода КАК КонецПериода
		|ПОМЕСТИТЬ _КлючиСРазделеннымПериодом
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|ГДЕ
		|	_ИтоговаяТаблица.РазделенПериодСверки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлючиСПолнымПериодом.ДБО КАК ДБО,
		|	_КлючиСПолнымПериодом.СА КАК СА,
		|	_КлючиСПолнымПериодом.СДУ КАК СДУ,
		|	_КлючиСПолнымПериодом.НачалоПериода КАК НачалоПериода,
		|	_КлючиСПолнымПериодом.КонецПериода КАК КонецПериода
		|ИЗ
		|	_КлючиСПолнымПериодом КАК _КлючиСПолнымПериодом
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_КлючиСРазделеннымПериодом.НачалоПериода КАК НачалоПериода,
		|	_КлючиСРазделеннымПериодом.КонецПериода КАК КонецПериода
		|ИЗ
		|	_КлючиСРазделеннымПериодом КАК _КлючиСРазделеннымПериодом
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ДБОСДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ДБОСтратегий
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _Стратегии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _Ключи
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ИтоговаяТаблица";
#КонецОбласти

	ПакетныйРезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Результат = Новый Структура();
	Результат.Вставить("СПолнымПериодом",		ПакетныйРезультатЗапроса[8].Выгрузить());
	Результат.Вставить("СРазделеннымПериодом",	ПакетныйРезультатЗапроса[9].Выгрузить());
	
	Возврат Результат;
	
КонецФункции

Функция ПоместитьДанныеОтчетовВМВТ(ДанныеОтчетов, Брокер, КонецПериода)
	
	Результат = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
		
	Запрос.МенеджерВременныхТаблиц = Результат;
	
	Запрос.УстановитьПараметр("Организация",							Организация);
	Запрос.УстановитьПараметр("Брокер",									Брокер);
	Запрос.УстановитьПараметр("КонецПериода",							КонецПериода);
	Запрос.УстановитьПараметр("СверятьБезУчетаВалютнойСекции",			СверятьБезУчетаВалютнойСекции);
	Запрос.УстановитьПараметр("ОстаткиДенежныхСредств",					ДанныеОтчетов.ОстаткиДенежныхСредств);
	Запрос.УстановитьПараметр("ОбязательстваПоДенежнымСредствам",		ДанныеОтчетов.ОбязательстваПоДенежнымСредствам);
	Запрос.УстановитьПараметр("ОстаткиЗадолженностиПоКомиссииНаНачало",	ДанныеОтчетов.ОстаткиЗадолженностиПоКомиссииНаНачало);
	Запрос.УстановитьПараметр("НачисленнаяКомиссияЗаПериод",			ДанныеОтчетов.НачисленнаяКомиссияЗаПериод);
	Запрос.УстановитьПараметр("ОплаченнаяКомиссияЗаПериод",				ДанныеОтчетов.ОплаченнаяКомиссияЗаПериод);
	Запрос.УстановитьПараметр("ОстаткиЗадолженностиПоКомиссииНаКонец",	ДанныеОтчетов.ОстаткиЗадолженностиПоКомиссииНаКонец);
	Запрос.УстановитьПараметр("ДвиженияДенежныхСредств",				ДанныеОтчетов.ДвиженияДенежныхСредств);
	Запрос.УстановитьПараметр("ЗаблокированныеДенежныеСредства",		ДанныеОтчетов.ЗаблокированныеДенежныеСредства);
	Запрос.УстановитьПараметр("ОжидаемыеПоступленияДенежныхСредств",	ДанныеОтчетов.ОжидаемыеПоступленияДенежныхСредств);
	Запрос.УстановитьПараметр("КонверсионныеСделки",					ДанныеОтчетов.КонверсионныеСделки);
	Запрос.УстановитьПараметр("НезавершенныеКонверсионныеСделки",		ДанныеОтчетов.НезавершенныеКонверсионныеСделки);
	Запрос.УстановитьПараметр("ОстаткиАкций",							ДанныеОтчетов.ОстаткиАкций);
	Запрос.УстановитьПараметр("ОстаткиОблигаций",						ДанныеОтчетов.ОстаткиОблигаций);
	Запрос.УстановитьПараметр("ОстаткиПаев",							ДанныеОтчетов.ОстаткиПаев);
	Запрос.УстановитьПараметр("ЗадолженностьПоЦБ",						ДанныеОтчетов.ЗадолженностьПоЦБ);
	Запрос.УстановитьПараметр("ДвиженияАкций",							ДанныеОтчетов.ДвиженияАкций);
	Запрос.УстановитьПараметр("ДвиженияОблигаций",						ДанныеОтчетов.ДвиженияОблигаций);
