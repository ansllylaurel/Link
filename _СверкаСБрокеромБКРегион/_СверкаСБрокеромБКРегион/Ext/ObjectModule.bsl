							НоваяСтрока = ПолучитьНовуюСтрокуДанныхОтчета(ДБО, СА, ВалютнаяСекция, НачалоПериодаОтчета, КонецПериодаОтчета);
							
							НоваяСтрока.Вставить("ТипКомиссии");
							НоваяСтрока.Вставить("Сумма");
							НоваяСтрока.Вставить("Валюта", Валюта);
							
						КонецЕсли;
						
						Если СтрНайти(Строка, "<TD CLASS=""LEFT"">") > 0 Тогда
							НоваяСтрока.ТипКомиссии = ПолучитьТипКомиссии(СтрЗаменить(СтрЗаменить(Строка, "<TD CLASS=""LEFT"">", ""), "</TD>", ""));
						КонецЕсли;
						
						Если СтрНайти(Строка, "<TD CLASS=""RIGHT"" STYLE=""WIDTH:25%"">") > 0 Тогда
							
							НоваяСтрока.Сумма = Число(СтрЗаменить(СтрЗаменить(Строка, "<TD CLASS=""RIGHT"" STYLE=""WIDTH:25%"">", ""), "</TD>", ""));
							
							НачисленнаяКомиссияЗаПериод.Добавить(НоваяСтрока);
							
						КонецЕсли;
						
						Если СтрНайти(Строка, "</TABLE>") > 0 Тогда
							ОбработкаНачисленнойКомиссии = Ложь;
							Результат.Вставить("НачисленнаяКомиссияЗаПериод", НачисленнаяКомиссияЗаПериод);
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;
				
				Если СтрНайти(Строка, "<H5>ОПЛАТА ЗАДОЛЖЕННОСТЕЙ ПО КОМИССИИ ЗА ПЕРИОД:</H5>") > 0 Тогда
					
					ОплаченнаяКомиссияЗаПериод = Новый Массив;
					
					ОбработкаОплаченнойКомиссии = Истина;
					
					Пока ОбработкаОплаченнойКомиссии Цикл
						
						Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки);
						
						Если СтрНайти(Строка, "<TD STYLE=""WIDTH:10%"">") > 0 Тогда
						
							// Очередная строка начисленной задолженности по комиисии.
							КодВалюты = СтрЗаменить(СтрЗаменить(Строка, "<TD STYLE=""WIDTH:10%"">", ""), "</TD>", "");
							
							Валюта = КешОбъектов.Валюты.Получить(КодВалюты);
							
							Если Валюта = Неопределено Тогда
								Валюта = ПолучитьВалютуПоНаименованию(?(КодВалюты = "РУБ", "RUB", КодВалюты));
