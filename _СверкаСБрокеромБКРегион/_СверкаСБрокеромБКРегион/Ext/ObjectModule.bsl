	Agreements.Колонки.Добавить("Ключ"       , Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	Agreements.Колонки.Добавить("ID"         , Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(15)));
	Agreements.Колонки.Добавить("Number"     , Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(15)));
