		|	Money_Remains.Inner_Account_Division_ID КАК Inner_Account_Division_ID,
		|	Money_Remains.Money_Storage_Place КАК Money_Storage_Place,
		|	Money_Remains.Division_Type КАК Division_Type,
		|	Money_Remains.Currency_Code КАК Currency_Code,
		|	Money_Remains.Amount КАК Amount
		|ПОМЕСТИТЬ _Money_Remains
		|ИЗ
		|	&Money_Remains КАК Money_Remains
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(_Money_Remains.Amount) КАК Сумма,
		|	_Money_Remains.Division_Type КАК Division_Type,
		|	ВЫБОР
		|		КОГДА _Money_Remains.Division_Type В (""Obligations.Delivery"", ""Obligations.Charges"")
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|		КОГДА _Money_Remains.Division_Type = ""Obligations.Receipt""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ТипЗадолженности,
		|	ВЫБОР
		|		КОГДА _Money_Remains.Division_Type В (""Obligations.Delivery"", ""Obligations.Receipt"")
		|			ТОГДА ""По сделкам""
		|		КОГДА _Money_Remains.Division_Type = ""Obligations.Charges""
		|			ТОГДА ""По комиссии""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Задолженность,
		|	_КодыСчетовВнутреннегоУчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Валюты.ВалютаСсылка КАК Валюта,
		|	_МестаХраненияДенежныхСредств.Ссылка КАК МестоХранения,
		|	_Money_Remains.Date КАК Date
		|ПОМЕСТИТЬ _ДенежныеСредства_OTBR
		|ИЗ
		|	_Money_Remains КАК _Money_Remains
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеПервыхУзлов КАК _ДанныеПервыхУзлов
		|		ПО _Money_Remains.Ключ = _ДанныеПервыхУзлов.Ключ
		|			И (_ДанныеПервыхУзлов.ФайлСоответствуетФормату = ИСТИНА)
