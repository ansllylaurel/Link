Функция ПолучитьДанныеОтчетов(Брокер, НачалоПериода, КонецПериода, Знач Каталог, СверкаСМесячнымОтчетомБрокера, ЗагружаемыеРазделы = Неопределено, ПропускатьСтрокиЕслиЦБНеНайдена = Истина, СчетаДУ = Неопределено)
	
	МассивТиповДБО = Новый Массив;
	МассивТиповДБО.Добавить(Тип("СправочникСсылка.ДоговорыБрокерскогоОбслуживания"));
	МассивТиповДБО.Добавить(Тип("СправочникСсылка.Договоры"));
	
	ТаблицаДляПроверкиНаличияДублейОтчетов = Новый ТаблицаЗначений;
	ТаблицаДляПроверкиНаличияДублейОтчетов.Колонки.Добавить("ДБО",				Новый ОписаниеТипов(МассивТиповДБО));
	ТаблицаДляПроверкиНаличияДублейОтчетов.Колонки.Добавить("Валютный",			Новый ОписаниеТипов("Булево"));
	ТаблицаДляПроверкиНаличияДублейОтчетов.Колонки.Добавить("ПорядковыйНомер",	Новый ОписаниеТипов("Число"));
	ТаблицаДляПроверкиНаличияДублейОтчетов.Колонки.Добавить("НачалоПериода",	Новый ОписаниеТипов("Дата"));
	ТаблицаДляПроверкиНаличияДублейОтчетов.Колонки.Добавить("КонецПериода",		Новый ОписаниеТипов("Дата"));
	
	ЗагружаемыеРазделы = ПодготовитьСтруктуруЗагружаемыхРазделов(ЗагружаемыеРазделы);
	
	ДанныеОтчетов = ПодготовитьПустуюСтруктуруРезультата(ЗагружаемыеРазделы, ПропускатьСтрокиЕслиЦБНеНайдена);
	
	#Область Загрузка_данных_отчетов_брокера
	
	СодержимоеФайлов = ПолучитьСодержимоеФайлов(Каталог, СверкаСМесячнымОтчетомБрокера);
	
	ЕстьДанныеЗаПериод = Ложь;
	
	Если СодержимоеФайлов <> Неопределено Тогда
		
		КешОбъектов = Новый Структура;
		КешОбъектов.Вставить("Валюты",			Новый Соответствие);
		КешОбъектов.Вставить("Акции",			Новый Соответствие);
		КешОбъектов.Вставить("Облигации",		Новый Соответствие);
		КешОбъектов.Вставить("Паи",				Новый Соответствие);
		КешОбъектов.Вставить("ЦенныеБумаги",	Новый Соответствие);
		
		Для Каждого ТекОтчет Из СодержимоеФайлов Цикл
			
			ДанныеОтчета =
				ДесериализоватьДанныеОтчета(
					НачалоПериода,
					КонецПериода,
					ТекОтчет.Данные,
					Организация,
					Брокер,
					КешОбъектов,
					ЗагружаемыеРазделы,
					ПропускатьСтрокиЕслиЦБНеНайдена,
					СверкаСМесячнымОтчетомБрокера,
					СчетаДУ,
					ЕстьДанныеЗаПериод);
			
			Если ДанныеОтчета <> Неопределено Тогда
				
				ЕстьДанныеЗаПериод = Истина;
				
				НоваяСтрока					= ТаблицаДляПроверкиНаличияДублейОтчетов.Добавить();
				НоваяСтрока.ПорядковыйНомер	= ТаблицаДляПроверкиНаличияДублейОтчетов.Количество();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеОтчета);
				
				// Переносим данные отчета в общую таблицу
				
				Для каждого Раздел Из ДанныеОтчета Цикл
					Если ДанныеОтчетов.Свойство(Раздел.Ключ) Тогда 
						Для Каждого ТекСтрока Из ДанныеОтчета[Раздел.Ключ] Цикл
							НоваяСтрока = ДанныеОтчетов[Раздел.Ключ].Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
						КонецЦикла;
					КонецЕсли;
				КонецЦикла; 
				
				// Запоминаем время получения данных СА
				// Если данные получены из нескольких файлов,
				// то возьмем наиболее позднее время создания файла 
				
				Если ДанныеОтчета.Свойство("СА") Тогда
					
					ВремяПолученияДанных = ДанныеОтчетов.ВремяПолученияДанных.Получить(ДанныеОтчета.СА);
					Если ВремяПолученияДанных = Неопределено Тогда
						ДанныеОтчетов.ВремяПолученияДанных.Вставить(ДанныеОтчета.СА, ТекОтчет.ВремяПолученияДанных);
					Иначе
						ДанныеОтчетов.ВремяПолученияДанных.Вставить(ДанныеОтчета.СА, Макс(ТекОтчет.ВремяПолученияДанных, ВремяПолученияДанных));
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	#КонецОбласти
	
	#Область Проверка_наличия_дублей_отчетов

	Если НЕ ЕстьДанныеЗаПериод Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В папке [" + Каталог + "] за указанный период нет файлов с отчетами брокера!");
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаДляПроверкиНаличияДублейОтчетов", ТаблицаДляПроверкиНаличияДублейОтчетов);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаДляПроверкиНаличияДублейОтчетов.ДБО КАК ДБО,
		|	ТаблицаДляПроверкиНаличияДублейОтчетов.Валютный КАК Валютный,
		|	ТаблицаДляПроверкиНаличияДублейОтчетов.ПорядковыйНомер КАК ПорядковыйНомер,
		|	ТаблицаДляПроверкиНаличияДублейОтчетов.НачалоПериода КАК НачалоПериода,
		|	ТаблицаДляПроверкиНаличияДублейОтчетов.КонецПериода КАК КонецПериода
		|ПОМЕСТИТЬ _Данные
		|ИЗ
		|	&ТаблицаДляПроверкиНаличияДублейОтчетов КАК ТаблицаДляПроверкиНаличияДублейОтчетов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_Данные.ДБО КАК ДБО,
		|	_Данные.Валютный КАК Валютный,
		|	_Данные.НачалоПериода КАК НачалоПериода,
		|	_Данные.КонецПериода КАК КонецПериода
		|ИЗ
		|	_Данные КАК _Данные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Данные КАК _Данные1
		|		ПО _Данные.ПорядковыйНомер <> _Данные1.ПорядковыйНомер
		|			И _Данные.ДБО = _Данные1.ДБО
		|			И _Данные.Валютный = _Данные1.Валютный
		|			И _Данные.ДБО <> НЕОПРЕДЕЛЕНО
		|			И (_Данные1.НачалоПериода МЕЖДУ _Данные.НачалоПериода И _Данные.КонецПериода
		|				ИЛИ _Данные1.КонецПериода МЕЖДУ _Данные.НачалоПериода И _Данные.КонецПериода)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДБО,
		|	Валютный,
		|	НачалоПериода,
		|	КонецПериода
		|ИТОГИ ПО
		|	ДБО,
		|	Валютный";
	
	ВыборкаДБО = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДБО.Следующий() Цикл
		
		ДанныеОтчетов = Неопределено;
		
		ВыборкаВалютный = ВыборкаДБО.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаВалютный.Следующий() Цикл
			
			ТекстСообщения = "По договору " + ВыборкаДБО.ДБО;
			
			ТекстСообщения = ТекстСообщения + " с признаком 'Валютный' = '" + Формат(ВыборкаВалютный.Валютный, "БЛ=Нет; БИ=Да") + "' обнаружено наличие дублей файлов-отчетов брокера по периодам:";
			
			Выборка = ВыборкаВалютный.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				ТекстСообщения = ТекстСообщения + Символы.ПС + "с " + Формат(Выборка.НачалоПериода, "ДФ=dd.MM.yyyy") + " по " + Формат(Выборка.КонецПериода, "ДФ=dd.MM.yyyy");
				
			КонецЦикла;
			
			ТекстСообщения = ТекстСообщения + "
				|Это означает, что в каталоге '" + Каталог + "' существует несколько файлов-отчетов, содержащих информацию за одинаковый период, и дублирующих данные друг друга.";
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
		КонецЦикла;
		
	КонецЦикла;
	
	#КонецОбласти
	
	Если ДанныеОтчетов = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ВремяПолученияДанных",	ДанныеОтчетов.ВремяПолученияДанных);
	Результат.Вставить("МВТ",					ПоместитьДанныеОтчетовВМВТ(ДанныеОтчетов, Брокер, КонецПериода));
	
	Возврат Результат;

КонецФункции 

