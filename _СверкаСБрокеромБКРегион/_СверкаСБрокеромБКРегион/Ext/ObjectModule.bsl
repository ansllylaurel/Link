КонецФункции

Функция СверитьОстаткиСДаннымиФайловOTBR(НачалоПериода, КонецПериода, Каталоги, Брокер, Депозитарий, СчетаДУ) Экспорт
	
	Если НачалоПериода < Дата(2020,11,15) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сверка остатков с файлами OTBR осуществляется с 15.11.2020!");
		Возврат Неопределено;
	КонецЕсли;

	МассивКаталогов = СтрРазделить(Каталоги, Символ(0182));
	
	КаталогиСФайлами = Новый Массив;
	
	Для Каждого Каталог ИЗ МассивКаталогов Цикл
		
		ОбъектФайл = Новый Файл(Каталог);
		
		Если ОбъектФайл.Существует() И ОбъектФайл.ЭтоКаталог() Тогда
			КаталогиСФайлами.Добавить(Новый Структура("КаталогИмя, Файлы, ЕстьФайлы", Каталог, НайтиФайлы(Каталог, "*", Истина), Ложь));
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствует папка [" + Каталог + "]!");	
		КонецЕсли;
		
	КонецЦикла;
			
	МассивФайлов  = Новый Массив;
	ДатаФайла = НачалоПериода;
	
	МассивДатИсключенныхИзСверки = Новый Массив;
	
	Пока ДатаФайла <= КонецПериода Цикл
		
		ЕстьФайлыЗаТекущуюДату = Ложь;
		
		Для Каждого Каталог Из КаталогиСФайлами Цикл
			
			Для Каждого Файл Из Каталог.Файлы Цикл
				
				ЕстьФайлыВКаталоге = Ложь;
				
				Если Лев(Файл.Имя, 32) = "BrokerReport_" + Формат(ДатаФайла, "ДФ=дд.ММ.гг") + "_-_" + Формат(ДатаФайла, "ДФ=дд.ММ.гг") И Прав(Файл.Имя, 4) = ".xml" Тогда
					МассивФайлов.Добавить(Новый Структура("ИмяФайла, Дата, ДвоичныеДанные", Файл.Имя, ДатаФайла, Новый ДвоичныеДанные(Файл.ПолноеИмя)));
					ЕстьФайлыВКаталоге     = Истина;
					ЕстьФайлыЗаТекущуюДату = Истина;
				КонецЕсли;
				
				Если Каталог.ЕстьФайлы = Ложь И ЕстьФайлыВКаталоге = Истина Тогда 
					Каталог.ЕстьФайлы = Истина;
				КонецЕсли;
				
			КонецЦикла;
						
		КонецЦикла;

		Если ЕстьФайлыЗаТекущуюДату = Ложь Тогда
			МассивДатИсключенныхИзСверки.Добавить(ДатаФайла);
		КонецЕсли;
		
		ДатаФайла = ДатаФайла + 86400;
	КонецЦикла;
	
	Для Каждого Каталог Из КаталогиСФайлами Цикл
		
		Если Каталог.ЕстьФайлы = Ложь Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В папке [" + Каталог.КаталогИмя + "] отсутствуют файлы OTBR за период [" + Формат(НачалоПериода, "ДФ=dd.MM.yyyy") + " - " + Формат(КонецПериода, "ДФ=dd.MM.yyyy") + "].");
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивФайлов.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ФайлИмпортаСоответствуетСхемеXSD(МассивФайлов, "Схема_OTBR") Тогда
		Возврат Неопределено;
	КонецЕсли;
			
	Макет = ЭтотОбъект.ПолучитьМакет("Схема_OTBR");

	ЧтениеСхемыOTBR = Новый ЧтениеXML;
	ЧтениеСхемыOTBR.УстановитьСтроку(Макет.ПолучитьТекст());
	
	ПостроительDOM = Новый ПостроительDOM;
	
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеСхемыOTBR);
	
	ПостроительСхемXML = Новый ПостроительСхемXML;
	СхемаXML = ПостроительСхемXML.СоздатьСхемуXML(ДокументDOM);
	
	НаборСхемXML = Новый НаборСхемXML;
	НаборСхемXML.Добавить(СхемаXML);
	
	СвояФабрикаXDTO = Новый ФабрикаXDTO(НаборСхемXML);
	ТипXDTO = СвояФабрикаXDTO.Тип("xmlns:xs=""xmlns:xs=""http://www.w3.org/2001/XMLSchema""", "Data");
	
	ИмяФайлаДанныхНаСервере = ПолучитьИмяВременногоФайла("xml");
		
	СтруктураВнешнихДанных = ПолучитьСтруктуруДанныхOTBR();
	
	Для Каждого СтрокаФайловИмпорта Из МассивФайлов Цикл
			
		СтрокаФайловИмпорта.ДвоичныеДанные.Записать(ИмяФайлаДанныхНаСервере);
		
		ЧтениеТекста = Новый ЧтениеТекста(ИмяФайлаДанныхНаСервере, КодировкаТекста.UTF8);
		СтрокаXML = ЧтениеТекста.Прочитать();
		СтрокаXML = СтрЗаменить(СтрокаXML, "<Data", "<Data xmlns:xs=""http://www.w3.org/2001/XMLSchema"" ");
		                                                                                              
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(СтрокаXML);
		
		ОбъектXDTO = СвояФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ТипXDTO);
		
		Если ТипЗнч(ОбъектXDTO) = Тип("ОбъектXDTO") Тогда
			ЗаполнитьСтруктуруДаннымиИзОбъектаXTDO(ОбъектXDTO, СтруктураВнешнихДанных, СтрокаФайловИмпорта.ИмяФайла, СтрокаФайловИмпорта.Дата);								
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить объект XDTO");
			Возврат Неопределено;
		КонецЕсли;
		
		ЧтениеТекста.Закрыть();
	КонецЦикла;
	
	// Заменяем коды счетов для УКПИ
	Если ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда
		Для Каждого ТекСтрока Из СтруктураВнешнихДанных.Accounts_Divisions Цикл
			ПозицияПодчеркивания = СтрНайти(ТекСтрока.Number, "_");
			Если ПозицияПодчеркивания > 0 Тогда
				ТекСтрока.Number = Лев(ТекСтрока.Number, ПозицияПодчеркивания - 1);	
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;	
	
	// Убираем постфикс SPFI для производных инструментов
    Для Каждого ТекСтрока Из СтруктураВнешнихДанных.Accounts_Divisions Цикл
		ПозицияПодчеркивания = СтрНайти(ТекСтрока.Number, "_SPFI");
		Если ПозицияПодчеркивания > 0 Тогда
			ТекСтрока.Number = Лев(ТекСтрока.Number, ПозицияПодчеркивания - 1);	
		КонецЕсли;
	КонецЦикла;
		
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеПервыхУзлов.Ключ КАК Ключ,
		|	ДанныеПервыхУзлов.ФайлСоответствуетФормату КАК ФайлСоответствуетФормату
		|ПОМЕСТИТЬ _ДанныеПервыхУзлов
		|ИЗ
		|	&ДанныеПервыхУзлов КАК ДанныеПервыхУзлов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Объект КАК Справочник.СчетаДоверительногоУправления).Ссылка КАК Счет
		|ПОМЕСТИТЬ _СчетаИсключеныИзЗагрузки
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Объект ССЫЛКА Справочник.СчетаДоверительногоУправления
		|	И ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Объект КАК Справочник.СчетаДоверительногоУправления).Организация = &Организация
		|	И ЗначенияДополнительныхСведений.Свойство.Ключ = &Ключ
		|	И ЗначенияДополнительныхСведений.Значение = ИСТИНА
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СчетаДоверительногоУправления.Ссылка
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И (СчетаДоверительногоУправления.Ссылка В (&НеопределенныеСчета)
		|			ИЛИ &ОтборОчередьЗагрузки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Организация КАК Организация,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер КАК Брокер,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК Код,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения КАК ДатаРасторженияСчета,
		|	УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения КАК ДатаРасторженияДоговора,
		|	ВЫБОР
		|		КОГДА _СчетаИсключеныИзЗагрузки.Счет ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ИсключенИзЗагрузки,
		|	ВЫБОР
		|		КОГДА КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления В (&СчетаДУ)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК УчаствуетВОтборе
		|ПОМЕСТИТЬ _КодыСчетов
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
