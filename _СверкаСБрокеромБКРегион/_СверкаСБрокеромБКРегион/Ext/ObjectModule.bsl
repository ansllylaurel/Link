#КонецОбласти
	
КонецФункции

Функция ПодготовитьПустуюСтруктуруРезультата(ЗагружаемыеРазделы, ПропускатьСтрокиЕслиЦБНеНайдена)
	
	Результат = Новый Структура;
	
	ТипыСубъектаАналитики = Новый Массив;
	ТипыСубъектаАналитики.Добавить(Тип("СправочникСсылка.СчетаДоверительногоУправления"));
	ТипыСубъектаАналитики.Добавить(Тип("СправочникСсылка.СтратегииИндивидуальногоИнвестирования"));
	
	МассивТиповДБО = Новый Массив;
	МассивТиповДБО.Добавить(Тип("СправочникСсылка.ДоговорыБрокерскогоОбслуживания"));
	МассивТиповДБО.Добавить(Тип("СправочникСсылка.Договоры"));
	
	МассивТиповЦеннаяБумага = Новый Массив;
	МассивТиповЦеннаяБумага.Добавить(Тип("СправочникСсылка.Акции"));
	МассивТиповЦеннаяБумага.Добавить(Тип("СправочникСсылка.Облигации"));
	МассивТиповЦеннаяБумага.Добавить(Тип("СправочникСсылка.Паи"));
	МассивТиповЦеннаяБумага.Добавить(Тип("СправочникСсылка.ДепозитарныеРасписки"));
	
	МассивТиповАкций = Новый Массив;
	МассивТиповАкций.Добавить(Тип("СправочникСсылка.Акции"));
	МассивТиповАкций.Добавить(Тип("СправочникСсылка.ДепозитарныеРасписки"));

	ОписаниеТипаДБО				= Новый ОписаниеТипов(МассивТиповДБО);
	ОписаниеТипаСА				= Новый ОписаниеТипов(ТипыСубъектаАналитики);
	ОписаниеТипаЦеннаяБумага	= Новый ОписаниеТипов(МассивТиповЦеннаяБумага);
	ОписаниеТипаВалюты			= Новый ОписаниеТипов("СправочникСсылка.Валюты");
	ОписаниеТипаБулево			= Новый ОписаниеТипов("Булево");
	ОписаниеТипаЧисло			= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(22,5));
	ОписаниеТипаСтрока21		= Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(21));
	ОписаниеТипаСтрока250		= Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(250));
	ОписаниеТипаАкция			= Новый ОписаниеТипов(МассивТиповАкций);
	ОписаниеТипаОблигация		= Новый ОписаниеТипов("СправочникСсылка.Облигации");
	ОписаниеТипаПай				= Новый ОписаниеТипов("СправочникСсылка.Паи");
	ОписаниеТипаДатаВремя		= Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));
	ОписаниеТипаВидыСделок		= Новый ОписаниеТипов("ПеречислениеСсылка.ВидыСделок");
	
	Если ЗагружаемыеРазделы.ОстаткиДенежныхСредств Тогда
	
		ОстаткиДенежныхСредств = Новый ТаблицаЗначений;
		ОстаткиДенежныхСредств.Колонки.Добавить("ДБО",					ОписаниеТипаДБО);
		ОстаткиДенежныхСредств.Колонки.Добавить("СА",					ОписаниеТипаСА);
		ОстаткиДенежныхСредств.Колонки.Добавить("ВалютнаяСекция",		ОписаниеТипаБулево);
		ОстаткиДенежныхСредств.Колонки.Добавить("НачалоПериода",		ОписаниеТипаДатаВремя);
		ОстаткиДенежныхСредств.Колонки.Добавить("КонецПериода",			ОписаниеТипаДатаВремя);
		ОстаткиДенежныхСредств.Колонки.Добавить("ВнебиржевойРынок",		ОписаниеТипаБулево);
		ОстаткиДенежныхСредств.Колонки.Добавить("Валюта",				ОписаниеТипаВалюты);
		ОстаткиДенежныхСредств.Колонки.Добавить("НачальныйОстаток",		ОписаниеТипаЧисло);
		ОстаткиДенежныхСредств.Колонки.Добавить("КонечныйОстаток",		ОписаниеТипаЧисло);
		
		Результат.Вставить("ОстаткиДенежныхСредств", ОстаткиДенежныхСредств);		
	
	КонецЕсли;
	
	Если ЗагружаемыеРазделы.ОбязательстваПоДенежнымСредствам Тогда
	
		ОбязательстваПоДенежнымСредствам = Новый ТаблицаЗначений;
		ОбязательстваПоДенежнымСредствам.Колонки.Добавить("ДБО",							ОписаниеТипаДБО);
		ОбязательстваПоДенежнымСредствам.Колонки.Добавить("СА",								ОписаниеТипаСА);
		ОбязательстваПоДенежнымСредствам.Колонки.Добавить("НачалоПериода",					ОписаниеТипаДатаВремя);
		ОбязательстваПоДенежнымСредствам.Колонки.Добавить("КонецПериода",					ОписаниеТипаДатаВремя);
		ОбязательстваПоДенежнымСредствам.Колонки.Добавить("Валюта",							ОписаниеТипаВалюты);
		ОбязательстваПоДенежнымСредствам.Колонки.Добавить("НачальныйОстаток",				ОписаниеТипаЧисло);
		ОбязательстваПоДенежнымСредствам.Колонки.Добавить("ДебиторскаяЗадолженность",		ОписаниеТипаЧисло);
		ОбязательстваПоДенежнымСредствам.Колонки.Добавить("КредиторскаяЗадолженность",		ОписаниеТипаЧисло);
		ОбязательстваПоДенежнымСредствам.Колонки.Добавить("КонечныйОстаток",				ОписаниеТипаЧисло);
		
		Результат.Вставить("ОбязательстваПоДенежнымСредствам", ОбязательстваПоДенежнымСредствам);		
	
	КонецЕсли; 

	Если ЗагружаемыеРазделы.ОстаткиЗадолженностиПоКомиссииНаНачало Тогда
	
		ОстаткиЗадолженностиПоКомиссии = Новый ТаблицаЗначений;
		ОстаткиЗадолженностиПоКомиссии.Колонки.Добавить("ДБО",					ОписаниеТипаДБО);
		ОстаткиЗадолженностиПоКомиссии.Колонки.Добавить("СА",					ОписаниеТипаСА);
		ОстаткиЗадолженностиПоКомиссии.Колонки.Добавить("НачалоПериода",		ОписаниеТипаДатаВремя);
		ОстаткиЗадолженностиПоКомиссии.Колонки.Добавить("КонецПериода",			ОписаниеТипаДатаВремя);
		ОстаткиЗадолженностиПоКомиссии.Колонки.Добавить("Валюта",				ОписаниеТипаВалюты);
		ОстаткиЗадолженностиПоКомиссии.Колонки.Добавить("ТипКомиссии",			ОписаниеТипаСтрока21);
		ОстаткиЗадолженностиПоКомиссии.Колонки.Добавить("Сумма",				ОписаниеТипаЧисло);
		
		Результат.Вставить("ОстаткиЗадолженностиПоКомиссииНаНачало", ОстаткиЗадолженностиПоКомиссии);		
	
	КонецЕсли;

	Если ЗагружаемыеРазделы.НачисленнаяКомиссияЗаПериод Тогда
	
		НачисленнаяКомиссияЗаПериод = Новый ТаблицаЗначений;
		НачисленнаяКомиссияЗаПериод.Колонки.Добавить("ДБО",				ОписаниеТипаДБО);
		НачисленнаяКомиссияЗаПериод.Колонки.Добавить("СА",				ОписаниеТипаСА);
		НачисленнаяКомиссияЗаПериод.Колонки.Добавить("НачалоПериода",	ОписаниеТипаДатаВремя);
		НачисленнаяКомиссияЗаПериод.Колонки.Добавить("КонецПериода",	ОписаниеТипаДатаВремя);
		НачисленнаяКомиссияЗаПериод.Колонки.Добавить("Валюта",			ОписаниеТипаВалюты);
		НачисленнаяКомиссияЗаПериод.Колонки.Добавить("ТипКомиссии",		ОписаниеТипаСтрока21);
		НачисленнаяКомиссияЗаПериод.Колонки.Добавить("Сумма",			ОписаниеТипаЧисло);
		
