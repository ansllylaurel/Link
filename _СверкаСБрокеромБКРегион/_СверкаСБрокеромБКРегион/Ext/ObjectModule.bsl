							КонецЕсли;
							
							НоваяСтрока = ПолучитьНовуюСтрокуДанныхОтчета(ДБО, СА, ВалютнаяСекция, НачалоПериодаОтчета, КонецПериодаОтчета);
							
							НоваяСтрока.Вставить("ТипКомиссии");
							НоваяСтрока.Вставить("Сумма");
							НоваяСтрока.Вставить("Валюта", Валюта);
							
						КонецЕсли;
						
						Если СтрНайти(Строка, "<TD CLASS=""LEFT"">") > 0 Тогда
							НоваяСтрока.ТипКомиссии = ПолучитьТипКомиссии(СтрЗаменить(СтрЗаменить(Строка, "<TD CLASS=""LEFT"">", ""), "</TD>", ""));
						КонецЕсли;
						
