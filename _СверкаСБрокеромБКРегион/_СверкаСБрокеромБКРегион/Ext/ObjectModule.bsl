		|					КОНЕЦ
		|			КОГДА _Depo_Remains.Depo_Storage_Place = ""Основной в НРД""
		|				ТОГДА ВЫБОР
		|						КОГДА ЕСТЬNULL(_ДепозитарныеСчета.КоличествоСчетов, 0) > 1
		|							ТОГДА ""ОШИБКА.В исполнителях найдено несколько основных депозитарных счетов в депозитарии БК Регион""
		|						ИНАЧЕ ""ОШИБКА.В исполнителях не найден основной депозитарный счет в депозитарии БК Регион""
