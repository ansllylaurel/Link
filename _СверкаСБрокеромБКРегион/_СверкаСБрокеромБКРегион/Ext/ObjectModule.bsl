		СделкиСПаями.Колонки.Добавить("Количество",				Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
		СделкиСПаями.Колонки.Добавить("Цена",					Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
		СделкиСПаями.Колонки.Добавить("Сумма",					ОписаниеТипаЧисло);
		СделкиСПаями.Колонки.Добавить("СтавкаРЕПО",				ОписаниеТипаЧисло);
		СделкиСПаями.Колонки.Добавить("ВалютаЦены",				ОписаниеТипаВалюты);
		СделкиСПаями.Колонки.Добавить("ВалютаРасчетов",			ОписаниеТипаВалюты);
		СделкиСПаями.Колонки.Добавить("БиржеваяКомиссия",		ОписаниеТипаЧисло);
		СделкиСПаями.Колонки.Добавить("БрокерскаяКомиссия",		ОписаниеТипаЧисло);
		
		Если Не ПропускатьСтрокиЕслиЦБНеНайдена Тогда
			СделкиСПаями.Колонки.Добавить("РегНомер", 	ОписаниеТипаСтрока250);
			СделкиСПаями.Колонки.Добавить("Эмитент", 	ОписаниеТипаСтрока250);
			СделкиСПаями.Колонки.Добавить("Рынок", 		ОписаниеТипаСтрока21);
		КонецЕсли; 
		
		Результат.Вставить("СделкиСПаями", СделкиСПаями);
	
	КонецЕсли; 
	
	Результат.Вставить("ВремяПолученияДанных", Новый Соответствие);	
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСчетДУ(Организация, Брокер, ДатаОтчета, Код, ОтборСчетаДУ)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация" , Организация);
	Запрос.УстановитьПараметр("Брокер"      , Брокер);
	Запрос.УстановитьПараметр("ДатаОтчета"  , ДатаОтчета);
	Запрос.УстановитьПараметр("Код"         , Код);
	Запрос.УстановитьПараметр("ОтборПоСчету", ?(ОтборСчетаДУ = Неопределено, Ложь, Истина));
	Запрос.УстановитьПараметр("МассивСчетов", ?(ОтборСчетаДУ = Неопределено, Новый Массив, ОтборСчетаДУ));
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления КАК СДУ,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания КАК Договор,
		|	ВЫБОР
		|		КОГДА &ОтборПоСчету
		|			ТОГДА ВЫБОР
		|					КОГДА КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления В (&МассивСчетов)
		|						ТОГДА ИСТИНА
		|					ИНАЧЕ ЛОЖЬ
		|				КОНЕЦ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ФлСверятьДанныеПоСубъекту
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&ДатаОтчета,
		|			Организация = &Организация
		|				И Брокер = &Брокер) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|ГДЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код = &Код
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия,
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнойБрокерскийДоговор,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА &ОтборПоСчету
		|				ТОГДА ВЫБОР
		|						КОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления В (&МассивСчетов)
		|							ТОГДА ИСТИНА
		|						ИНАЧЕ ЛОЖЬ
		|					КОНЕЦ
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ)
		|ИЗ
		|	РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(&ДатаОтчета, Организация = &Организация) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
		|ГДЕ
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнойКодУБрокера = &Код
		|	И СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнойБрокер = &Брокер
		|
		|СГРУППИРОВАТЬ ПО
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия,
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнойБрокерскийДоговор";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий()
		И ЗначениеЗаполнено(Выборка.СДУ)
		И ЗначениеЗаполнено(Выборка.Договор) Тогда
		Возврат Новый Структура("СубъектАналитики, Договор, СверятьДанныеПоСубъекту", Выборка.СДУ, Выборка.Договор, Выборка.ФлСверятьДанныеПоСубъекту);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДоговорБО(Организация, Брокер, Номер, Дата, ДатаОтчета, ОтборСчетаДУ)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация" , Организация);
	Запрос.УстановитьПараметр("Контрагент"  , Брокер.ЮрФизЛицо);
	Запрос.УстановитьПараметр("Номер"       , Номер);
