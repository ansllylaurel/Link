						КешОбъектов.Валюты.Вставить(Наименование, Валюта);
						НоваяСтрока.Валюта = Валюта;
					Иначе
						НоваяСтрока.Валюта = Валюта;
					КонецЕсли;
					
					Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки);
					НоваяСтрока.НачальныйОстаток = Число(СтрЗаменить(СтрЗаменить(Строка, "<TD CLASS=""RIGHT"">", ""), "</TD>", ""));
					Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки);
					НоваяСтрока.ДебиторскаяЗадолженность = Число(СтрЗаменить(СтрЗаменить(Строка, "<TD CLASS=""RIGHT"">", ""), "</TD>", ""));
					Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки);
					НоваяСтрока.КредиторскаяЗадолженность = Число(СтрЗаменить(СтрЗаменить(Строка, "<TD CLASS=""RIGHT"">", ""), "</TD>", ""));
					Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки);
					НоваяСтрока.КонечныйОстаток = Число(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(Строка, "<TD CLASS=""RIGHT"">", ""), "</TD>", ""), "</TR>", ""), "</TBODY>", ""), "</TABLE>", ""));
					
					ЗадолженностиПоДС.Добавить(НоваяСтрока);
					
				КонецЕсли;
				
				Если СтрНайти(Строка, "</TABLE>") Тогда
					ОбработкаЗадолженностиДС = Ложь;
					ОбязательстваОбработаны = Истина;
					Результат.Вставить("ОбязательстваПоДенежнымСредствам", ЗадолженностиПоДС);
				КонецЕсли;
				
			КонецЦикла;
			
			Продолжить;
			
		КонецЕсли;
		#КонецОбласти
		#Область ОпределениеКомиссии
		// Определяем комиссию за период.
		Если НЕ КомиссияОбработана И СтрНайти(Строка, "<H5>КОМИССИЯ ЗА ОТЧЕТНЫЙ ПЕРИОД:</H5>") > 0 Тогда
			
			ОбработкаКомиссии = Истина;
			
			Пока ОбработкаКомиссии Цикл
				
				Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки);
				
				// Блоки по комиссии могут отсутствовать,
				// поэтому, если не обнаружили в текущей строке ни одного блока по комиссии - заканчиваем обработку комиссии
				// и возвращаем индекс строки на предыдущую строку, для нормальной дальнейшей обработки.
				Если СтрНайти(Строка, "<H5>ЗАДОЛЖЕННОСТЬ НА НАЧАЛО ПЕРИОДА:</H5>") = 0
					И СтрНайти(Строка, "<H5>НАЧИСЛЕНО ЗА ПЕРИОД:</H5>") = 0
					И СтрНайти(Строка, "<H5>ОПЛАТА ЗАДОЛЖЕННОСТЕЙ ПО КОМИССИИ ЗА ПЕРИОД:</H5>") = 0
					И СтрНайти(Строка, "<H5>ЗАДОЛЖЕННОСТЬ НА КОНЕЦ ПЕРИОДА:</H5>") = 0 Тогда
					ИндексСтроки = ИндексСтроки - 2;
					ОбработкаКомиссии = Ложь;
					КомиссияОбработана = Истина;
				КонецЕсли;
				
				Если СтрНайти(Строка, "<H5>ЗАДОЛЖЕННОСТЬ НА НАЧАЛО ПЕРИОДА:</H5>") > 0 Тогда
					
