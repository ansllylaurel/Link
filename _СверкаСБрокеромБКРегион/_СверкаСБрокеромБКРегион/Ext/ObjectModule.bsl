	ДанныеПервыхУзлов.Колонки.Добавить("ЗначенияАтрибутов");
	ДанныеПервыхУзлов.Колонки.Добавить("ФайлСоответствуетФормату", Новый ОписаниеТипов("Булево"));
	
	СтруктураДанных.Вставить("ДанныеПервыхУзлов", ДанныеПервыхУзлов);
	
	Возврат СтруктураДанных;
	
КонецФункции //ПолучитьСтруктуруДанныхOTBR

Процедура ЗаполнитьСтруктуруДаннымиИзОбъектаXTDO(ОбъектXDTO, СтруктураДанных, ИмяФайла, ДатаСверки, ИмяТаблицы = "", РекурсивныйВызов = Ложь)
	
	Если Не РекурсивныйВызов Тогда
		ДанныеПервогоУзла = Новый Структура("Account_Number, Date_From, Date_To, Recipient, Sender, Sender_System");
	КонецЕсли;
	
	Для Каждого СвойствоОбъектаXDTO Из ОбъектXDTO.Свойства() Цикл
		
		//Исключены операции и неиспользуемые справочники.
		Если СвойствоОбъектаXDTO.Имя = "Operations" Или СвойствоОбъектаXDTO.Имя = "Firms" 
			Или СвойствоОбъектаXDTO.Имя = "Persons" Или СвойствоОбъектаXDTO.Имя = "Enums_Values" Тогда
			Продолжить;
		КонецЕсли;
		
		Если СвойствоОбъектаXDTO.Форма = ФормаXML.Элемент Тогда
			
			Если СвойствоОбъектаXDTO.ВерхняяГраница = 1 Тогда  //у cписка XDTO ВерхняяГраница = -1 
				ЗначениеСвойстваОбъектаXDTO = ОбъектXDTO.Получить(СвойствоОбъектаXDTO);
			Иначе
				ЗначениеСвойстваОбъектаXDTO = ОбъектXDTO.ПолучитьСписок(СвойствоОбъектаXDTO);
			КонецЕсли;
			
			Если СвойствоОбъектаXDTO.Имя = "Record" Тогда //Может состоять из списка, может состоять из атрибутов (если одна запись)
				
				// Bonds, Shares, Bills, Derivatives, DRs, Funds,
				// Для сверки остатков цб нам нужен только код матрих
				Если СтрНайти("Bonds, Shares, Bills, Derivatives, DRs, Funds", ИмяТаблицы) > 0 Тогда
					ЗаполнитьТаблицуЗначенийДаннымиИзОбъектаXTDO(ЗначениеСвойстваОбъектаXDTO, СтруктураДанных["КодыЦенныхБумаг"], ИмяТаблицы, ИмяФайла, Истина);
				ИначеЕсли СтруктураДанных.Свойство(ИмяТаблицы) Тогда
					ЗаполнитьТаблицуЗначенийДаннымиИзОбъектаXTDO(ЗначениеСвойстваОбъектаXDTO, СтруктураДанных[ИмяТаблицы], ИмяТаблицы, ИмяФайла, Ложь);
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не настроена загрузка для элемента файла " + ИмяТаблицы + "");
				КонецЕсли;
			
				Продолжить;
			
			Иначе
				ЗаполнитьСтруктуруДаннымиИзОбъектаXTDO(ЗначениеСвойстваОбъектаXDTO, СтруктураДанных, ИмяФайла, ДатаСверки, СвойствоОбъектаXDTO.Имя, Истина);
			КонецЕсли
			
		ИначеЕсли СвойствоОбъектаXDTO.Форма = ФормаXML.Атрибут Тогда
			
			Если ДанныеПервогоУзла.Свойство(СвойствоОбъектаXDTO.Имя) Тогда
				
				ДанныеПервогоУзла[СвойствоОбъектаXDTO.Имя] = ОбъектXDTO.Получить(СвойствоОбъектаXDTO);
				
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле импорта " + ИмяФайла + " в первом узле присутствует неописанный атрибут [" + СвойствоОбъектаXDTO.Имя + "]"); 
			КонецЕсли;
			
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не настроено правило десериализации для типа: " + ТипЗнч(ЗначениеСвойстваОбъектаXDTO) + "!");		
		КонецЕсли;
		
	КонецЦикла;
	
	Если РекурсивныйВызов Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	
	Если Не ЗначениеЗаполнено(ДанныеПервогоУзла.Account_Number)  Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле импорта [" + ИмяФайла + "] не заполнено значение атрибута первого узла [Account_Number]!");	
		ЕстьОшибки = Истина;
	КонецЕсли;
		
	Если ДанныеПервогоУзла.Date_From <> Формат(ДатаСверки, "ДФ=""гггг-ММ-дд""") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле импорта [" + ИмяФайла + "] значение атрибута первого узла [Date_From = " + ДанныеПервогоУзла.Date_From + "] не соответствет дате импорта!");
		ЕстьОшибки = Истина;
	КонецЕсли;
		
	Если ДанныеПервогоУзла.Date_To <> Формат(ДатаСверки, "ДФ=""гггг-ММ-дд""") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле импорта [" + ИмяФайла + "] значение атрибута первого узла [Date_To = " + ДанныеПервогоУзла.Date_To + "] не соответствет дате импорта!");
		ЕстьОшибки = Истина;
	КонецЕсли;
			
	Если ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ") И Не (ДанныеПервогоУзла.Recipient = "OTBR.RegionAM" Или ДанныеПервогоУзла.Recipient = "OTBR.RegionAM.PIF")  
		Или ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ") И Не (ДанныеПервогоУзла.Recipient = "OTBR.RegionTR" Или ДанныеПервогоУзла.Recipient = "OTBR.RegionTR.PIF") 
		Или ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") И Не (ДанныеПервогоУзла.Recipient = "OTBR.RegionPI" Или ДанныеПервогоУзла.Recipient = "OTBR.RegionPI.PIF") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле импорта [" + ИмяФайла + "] значение атрибута первого узла [Recipient = " + ДанныеПервогоУзла.Recipient + "] не соответствет организации [" + ЭтотОбъект.Организация + "]!");	
		ЕстьОшибки = Истина;
	КонецЕсли;
			
	Если ДанныеПервогоУзла.Sender <> "Region.BC" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле импорта [" + ИмяФайла + "] значение атрибута первого узла [Sender = " + ДанныеПервогоУзла.Sender + "] не соответствет формату обмена данных!");
		ЕстьОшибки = Истина;
	КонецЕсли;
				
	Если ДанныеПервогоУзла.Sender_System <> "MX1" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле импорта [" + ИмяФайла + "] значение атрибута первого узла [Sender_System = " + ДанныеПервогоУзла.Sender_System + "] не соответствет формату обмена данных!");
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	НоваяСтрока                          = СтруктураДанных.ДанныеПервыхУзлов.Добавить();
	НоваяСтрока.Ключ                     = ИмяФайла;
	НоваяСтрока.ЗначенияАтрибутов        = ДанныеПервогоУзла;
	НоваяСтрока.ФайлСоответствуетФормату = Не ЕстьОшибки;
			
КонецПроцедуры //ЗаполнитьСтруктуруДаннымиИзОбъектаXTDO

Процедура ЗаполнитьТаблицуЗначенийДаннымиИзОбъектаXTDO(ЗначниеОбъектаXDTO, ТаблицаПриемникДанных, ТаблицаИсточникИмя, ИмяФайла, ЗаписывитьТолькоID)
	
	Если ТипЗнч(ЗначниеОбъектаXDTO) = Тип("ОбъектXDTO") Тогда
				
		НоваяСтрока = ТаблицаПриемникДанных.Добавить();
		
		Для Каждого Свойство Из ЗначниеОбъектаXDTO.Свойства() Цикл
			
			Если ЗаписывитьТолькоID И Свойство.Имя = "ID" Тогда
				
				НоваяСтрока[Свойство.Имя] = ЗначниеОбъектаXDTO[Свойство.Имя];
				НоваяСтрока.Тип = ТаблицаИсточникИмя;
				Прервать;
				
			КонецЕсли;
			
			Если ТаблицаПриемникДанных.Колонки.Найти(Свойство.Имя) = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле импорта [" + ИмяФайла + "] присутствует атрибут [" + Свойство.Имя + "], который не описан в таблице [" + ТаблицаИсточникИмя + "] структуры данных!");
			Иначе
				
				Если ТаблицаИсточникИмя = "Accounts_Divisions" И Свойство.Имя = "Number" Тогда
				
					Данные = ПолучитьКодИСекцию(ЗначниеОбъектаXDTO[Свойство.Имя]);	
					НоваяСтрока[Свойство.Имя] = Данные.Код;
					НоваяСтрока.Секция = Данные.Секция;
					
				ИначеЕсли (ТаблицаИсточникИмя = "Depo_Remains" Или ТаблицаИсточникИмя = "Money_Remains") И  Свойство.Имя = "Date" Тогда
					НоваяСтрока[Свойство.Имя] = Дата(СтрЗаменить(ЗначниеОбъектаXDTO[Свойство.Имя], "-", ""));	
				Иначе
					НоваяСтрока[Свойство.Имя] = ЗначниеОбъектаXDTO[Свойство.Имя];
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		НоваяСтрока.Ключ = ИмяФайла;
		
	ИначеЕсли ТипЗнч(ЗначниеОбъектаXDTO) = Тип("СписокXDTO") Тогда
	
		Для Каждого СтрокаСписка Из ЗначниеОбъектаXDTO Цикл
			
			НоваяСтрока = ТаблицаПриемникДанных.Добавить();
			
			Для Каждого Свойство Из СтрокаСписка.Свойства() Цикл
				
				Если ЗаписывитьТолькоID И Свойство.Имя = "ID" Тогда
					
					НоваяСтрока[Свойство.Имя] = СтрокаСписка[Свойство.Имя];
					НоваяСтрока.Тип = ТаблицаИсточникИмя;
					Прервать;
					
				КонецЕсли;
				
				Если ТаблицаПриемникДанных.Колонки.Найти(Свойство.Имя) = Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле импорта [" + ИмяФайла + "] присутствует атрибут [" + Свойство.Имя + "], который не описан в таблице [" + ТаблицаИсточникИмя + "] структуры данных!");
				Иначе
										
					Если ТаблицаИсточникИмя = "Accounts_Divisions" И Свойство.Имя = "Number" Тогда
						
						Данные = ПолучитьКодИСекцию(СтрокаСписка[Свойство.Имя]);
						НоваяСтрока[Свойство.Имя] = Данные.Код;
						НоваяСтрока.Секция = Данные.Секция;
						
					ИначеЕсли (ТаблицаИсточникИмя = "Depo_Remains" Или ТаблицаИсточникИмя = "Money_Remains") И  Свойство.Имя = "Date" Тогда
						
						НоваяСтрока[Свойство.Имя] = Дата(СтрЗаменить(СтрокаСписка[Свойство.Имя], "-", ""));
										
					Иначе
						НоваяСтрока[Свойство.Имя] = СтрокаСписка[Свойство.Имя];
					КонецЕсли;

				КонецЕсли;
				
			КонецЦикла;
			
			НоваяСтрока.Ключ = ИмяФайла;
			
		КонецЦикла;
		
	КонецЕсли;
			
КонецПроцедуры //ЗаполнитьТаблицуЗначенийДаннымиИзОбъектаXTDO()

Функция ПолучитьКодИСекцию(Номер)
	
	Код = "";
	Секция = "";
	
	Если СтрНайти(Номер, "_VN") > 0 Тогда
		Код = СтрЗаменить(Номер, "_VN", "");
		Секция = "Внебиржевая";
	ИначеЕсли СтрНайти(Номер, "_OTC") > 0 Тогда //новые коды
		Код = СтрЗаменить(Номер, "_OTC", "");
		Секция = "Внебиржевая";
	ИначеЕсли СтрНайти(Номер, "_FX") > 0 Тогда //новые коды
		Код = СтрЗаменить(Номер, "_FX", "");
		Секция = "Валютная";
	ИначеЕсли СтрНайти(Номер, "_V") > 0 Тогда
		Код = СтрЗаменить(Номер, "_V", "");
		Секция = "Валютная";
	ИначеЕсли СтрНайти(Номер, "V") > 0 Тогда
		Код = СтрЗаменить(Номер, "V", "");
		Секция = "Валютная";
	ИначеЕсли СтрНайти(Номер, "_R") > 0 Тогда 
		Код = СтрЗаменить(Номер, "_R", "");
		Секция = "Репо";
	ИначеЕсли СтрНайти(Номер, "_FO") > 0 Тогда //новые коды
		Код = СтрЗаменить(Номер, "_FO", "");
		Секция = "Фортс";
	ИначеЕсли СтрНайти(Номер, "_F") > 0 Тогда
		Код = СтрЗаменить(Номер, "_F", "");
		Секция = "Фортс";
	Иначе
		Код = Номер;
		Секция = "Основная";
	КонецЕсли;

	Возврат Новый Структура("Код, Секция", Код, Секция);
	
КонецФункции //ПолучитьКодИСекцию

// Функция исключительно для вызова извне.
Функция ПолучитьСтруктуруРезультата(Брокер, Период, Каталог, СверкаСМесячнымОтчетомБрокера, ЗагружаемыеРазделы = Неопределено, ПропускатьСтрокиЕслиЦБНеНайдена = Истина) Экспорт

	ЗагружаемыеРазделы = ПодготовитьСтруктуруЗагружаемыхРазделов(ЗагружаемыеРазделы);
	
	Результат = ПодготовитьПустуюСтруктуруРезультата(ЗагружаемыеРазделы, ПропускатьСтрокиЕслиЦБНеНайдена);
	
	#Область ЗагрузкаДанныхОтчетовБрокера
	СодержимоеФайлов = ПолучитьСодержимоеФайлов(Каталог, СверкаСМесячнымОтчетомБрокера);
	
	Если СодержимоеФайлов <> Неопределено Тогда
		
		КешОбъектов = Новый Структура;
		КешОбъектов.Вставить("Валюты",		Новый Соответствие);
		КешОбъектов.Вставить("Акции",		Новый Соответствие);
		КешОбъектов.Вставить("Облигации",	Новый Соответствие);
		КешОбъектов.Вставить("Паи",			Новый Соответствие);
		
		Для Каждого ТекОтчет Из СодержимоеФайлов Цикл
			
			ДанныеОтчета = ДесериализоватьДанныеОтчета(НачалоДня(Период), КонецДня(Период), ТекОтчет.Данные, Организация, Брокер, КешОбъектов, ЗагружаемыеРазделы, ПропускатьСтрокиЕслиЦБНеНайдена, СверкаСМесячнымОтчетомБрокера);
			
			Если ДанныеОтчета <> Неопределено Тогда
				Для каждого Раздел Из ДанныеОтчета Цикл
					Если Результат.Свойство(Раздел.Ключ) Тогда 
						Для Каждого ТекСтрока Из ДанныеОтчета[Раздел.Ключ] Цикл
							НоваяСтрока = Результат[Раздел.Ключ].Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
						КонецЦикла;
					КонецЕсли;
				КонецЦикла; 
			Иначе
				Возврат Неопределено;
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	#КонецОбласти
	
	Возврат Результат;

КонецФункции

Функция ПолучитьКодЦеннойБумагиИзСтроки(Строка)

	Код = "";
	
	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить("ГДР, ГОС. РЕГ. ");
	Идентификаторы.Добавить("ГДР, ISIN ");
	Идентификаторы.Добавить("АДР, ГОС. РЕГ. ");
	Идентификаторы.Добавить("АДР, ISIN ");
	Идентификаторы.Добавить("ГОС. РЕГ. ");
	Идентификаторы.Добавить("ISIN ");
	
	Для каждого Идентификатор Из Идентификаторы Цикл
	
		ПозицияИдентификатора = СтрНайти(Строка, Идентификатор);
		Если ПозицияИдентификатора > 0 Тогда
			
			Код = Сред(Строка, ПозицияИдентификатора + СтрДлина(Идентификатор));
			Прервать;
		
		КонецЕсли; 
	
	КонецЦикла; 
	
	Если Код = "" Тогда
		Код = Строка;
	КонецЕсли; 
	
	Если СтрНачинаетсяС(Код, ВРег("не предусмотрен")) Тогда
		
		Код = ВРег("не предусмотрен");
		
	Иначе
		
		Разделители = Новый Массив;
		Разделители.Добавить(" ");
		Разделители.Добавить(",");
		
		Для каждого Разделитель Из Разделители Цикл
			
			ПозицияРазделителя = СтрНайти(Код, Разделитель);
			
			Если ПозицияРазделителя > 0 Тогда
			
				Код = Лев(Код, ПозицияРазделителя - 1);
			
			КонецЕсли; 
		
		КонецЦикла; 
	
	КонецЕсли; 
		
	Возврат Код;

КонецФункции
 
Функция ПолучитьЗначениеЯчейки(ТекстФайла, ИндексСтроки)

	Строка = "";
	Пока Не СтрЗаканчиваетсяНа(Строка, "</TD>") Цикл
		
		Строка = Строка + ПолучитьСтроку(ТекстФайла, ИндексСтроки);
	
	КонецЦикла; 
	
	Строка = СтрЗаменить(СтрЗаменить(Строка, "<TD>", ""), "</TD>", "");
	
	Возврат Строка;

КонецФункции
 

#КонецОбласти
