	Результат.Вставить("ЗаблокированныеАкции",		Истина);
	Результат.Вставить("ЗаблокированныеОблигации",	Истина);
	Результат.Вставить("ЗаблокированныеПаи",		Истина);
	
	Результат.Вставить("ОстаткиАкций",		Истина);
	Результат.Вставить("ОстаткиОблигаций",	Истина);
	Результат.Вставить("ОстаткиПаев",		Истина);
	
