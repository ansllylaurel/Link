	Результат.Вставить("СделкиСОблигациями",	Ложь);
	Результат.Вставить("СделкиСПаями",			Ложь);
	
	Если ЗагружаемыеРазделы <> Неопределено Тогда
		Для каждого ЭлементСтруктуры Из Результат Цикл
			Результат[ЭлементСтруктуры.Ключ] = (ЗагружаемыеРазделы.Найти(ЭлементСтруктуры.Ключ) <> Неопределено);
		КонецЦикла; 
	КонецЕсли; 
	
	Возврат Результат;

