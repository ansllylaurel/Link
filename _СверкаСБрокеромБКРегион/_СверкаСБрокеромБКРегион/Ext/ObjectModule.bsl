Функция ПолучитьТипКомиссии(ТипКомиссииСтрокой)
	
	Если ТипКомиссииСтрокой = "КОМИССИЯ БИРЖИ" Тогда
		Возврат "Торговая комиссия";
	ИначеЕсли ТипКомиссииСтрокой = "НАЧИСЛЕНИЕ БРОКЕРСКОЙ КОМИССИИ ПО ЭМИССИОННЫМ ЦЕННЫМ БУМАГАМ"
		ИЛИ ТипКомиссииСтрокой = "НАЧИСЛЕНИЕ БРОКЕРСКОЙ КОМИССИИ ПО ВЕКСЕЛЯМ"
		ИЛИ ТипКомиссииСтрокой = "НАЧИСЛЕНИЕ КОМИССИИ ЗА РЕПО"
		ИЛИ ТипКомиссииСтрокой = "КОМИССИЯ БРОКЕРА ЗА ОПЕРАЦИИ НА ВАЛЮТНОМ РЫНКЕ"
		ИЛИ ТипКомиссииСтрокой = "КОМИССИЯ БРОКЕРА ЗА ОПЕРАЦИИ НА ВАЛЮТНОМ РЫНКЕ И РЫНКЕ ДРАГОЦЕННЫХ МЕТАЛЛОВ"
		ИЛИ ТипКомиссииСтрокой = "НАЧИСЛЕНИЕ БРОКЕРСКОЙ КОМИССИИ ПО СРОЧНОМУ РЫНКУ"
		ИЛИ ТипКомиссииСтрокой = "НАЧИСЛЕНИЕ БРОКЕРСКОЙ КОМИССИ ПО СРОЧНОМУ РЫНКУ" //была ошибка в отчете брокера - КОМИССИ
		ИЛИ ТипКомиссииСтрокой = "КОМИССИЯ ЗА КЛИРИНГ"
		ИЛИ ТипКомиссииСтрокой = "НАЧИСЛЕНИЕ ЗА ПОСРЕДНИЧЕСКИЕ УСЛУГИ"
		ИЛИ ТипКомиссииСтрокой = "ВОЗМЕЩЕНИЕ РАСХОДОВ БРОКЕРА" Тогда
		Возврат "Брокерская комиссия";
	ИначеЕсли ТипКомиссииСтрокой = "НАЧИСЛЕНИЕ ДЕПОЗИТАРНЫХ УСЛУГ" Тогда
		Возврат "Депозитарная комиссия"
	Иначе
		Возврат "Прочее";
	КонецЕсли;
	
КонецФункции

Функция ПолучитьЦеннуюБумагу(Тип, Код)
	
	Если Код = "не предусмотрен" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось определить ценную бумагу по коду '%1'!", Код));
		Возврат Неопределено;
	ИначеЕсли Код = "1-04-33498-E"
		И Тип = "Акция" Тогда
		Возврат ОбщегоНазначения.ПолучитьИменованныйОбъект("Акция_ИнтерРАО");
	КонецЕсли;
	
	Если Тип = "Акция" Тогда
		Алиас = "Акции";
		ИмяПоляРегНомер = "ГосударственныйРегистрационныйНомер";
		ТипДляСообщения = "акцию";
		ТипДляСообщенияОДублях = "акций";
	ИначеЕсли Тип = "Облигация" Тогда
		Алиас = "Облигации";
		ИмяПоляРегНомер = "ГосударственныйРегистрационныйНомер";
		ТипДляСообщения = "облигацию";
		ТипДляСообщенияОДублях = "облигаций";
	ИначеЕсли Тип = "Пай" Тогда
		Алиас = "Паи";
		ИмяПоляРегНомер = "ГосударственныйРегистрационныйНомер";
		ТипДляСообщения = "пай";
		ТипДляСообщенияОДублях = "паев";
	ИначеЕсли Тип = "ДепозитарнаяРасписка" Тогда
		Алиас = "ДепозитарныеРасписки";
		ИмяПоляРегНомер = "РегистрационныйНомер";
		ТипДляСообщения = "депозитарная расписка";
		ТипДляСообщенияОДублях = "депозитарных расписок";
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сверка по ценным бумагам производится только по акциям, облигациям или паям!");
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Код", Код);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	" + Алиас + ".Ссылка КАК ЦеннаяБумага
		|ИЗ
		|	Справочник." + Алиас + " КАК " + Алиас + "
		|ГДЕ
		|	" + Алиас + "." + ИмяПоляРегНомер + " = &Код
		|	И НЕ " + Алиас + ".ПометкаУдаления
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	КодыВТорговыхСистемахСрезПоследних.Объект
		|ИЗ
		|	РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(
		|			,
		|			Объект ССЫЛКА Справочник." + Алиас + "
		|				И ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
		|ГДЕ
		|	КодыВТорговыхСистемахСрезПоследних.Код = &Код
		|	И НЕ КодыВТорговыхСистемахСрезПоследних.Объект.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("По гос. рег. номеру / ISIN '%1' обнаружено несколько %2!", Код, ТипДляСообщенияОДублях));
	КонецЕсли;
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЦеннаяБумага;
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось определить %1 по гос. рег. номеру / ISIN '%2'!", ТипДляСообщения, Код));
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьЦеннуюБумагуПоКодуIsin(КодIsin)
	
	КодIsin = Врег(КодIsin);
	
	Если КодIsin = "НЕ ПРЕДУСМОТРЕН" Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось определить ценную бумагу по коду ISIN '%1'!", КодIsin));
		Возврат Неопределено;
		
	ИначеЕсли КодIsin = "RU000A0JPNM1" Тогда
		Возврат ОбщегоНазначения.ПолучитьИменованныйОбъект("Акция_ИнтерРАО");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВТорговыхСистемахСрезПоследних.Объект КАК ЦеннаяБумага
		|ИЗ
		|	РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(
		|			,
		|		 ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
		|ГДЕ
		|	КодыВТорговыхСистемахСрезПоследних.Код = &КодIsin
		|	И НЕ КодыВТорговыхСистемахСрезПоследних.Объект.ПометкаУдаления";
	
	
	Запрос.УстановитьПараметр("КодIsin", КодIsin);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("По коду ISIN '%1' обнаружено несколько ценных бумаг!", КодIsin));
	КонецЕсли;
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЦеннаяБумага;
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось ценную бумагу по коду ISIN '%1'!", КодIsin));
		
		Возврат Неопределено;
		
	КонецЕсли;

КонецФункции

Функция ПолучитьЦеннуюБумагуПоКоду(Код, Серия)
	
	Если Код = "1-04-33498-E" Тогда // в справочние 1С присутствуют две бумаги с таким кодом 
		Возврат ОбщегоНазначения.ПолучитьИменованныйОбъект("Акция_ИнтерРАО");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Код"  , Код);
	Запрос.УстановитьПараметр("Серия", Серия);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Акции.Ссылка КАК ЦеннаяБумага
		|ИЗ
		|	Справочник.Акции КАК Акции
		|ГДЕ
		|	Акции.ГосударственныйРегистрационныйНомер = &Код
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Облигации.Ссылка
		|ИЗ
		|	Справочник.Облигации КАК Облигации
		|ГДЕ
		|	Облигации.ГосударственныйРегистрационныйНомер = &Код
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Паи.Ссылка
		|ИЗ
		|	Справочник.Паи КАК Паи
		|ГДЕ
		|	Паи.ГосударственныйРегистрационныйНомер = &Код
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Векселя.Ссылка
		|ИЗ
		|	Справочник.Векселя КАК Векселя
		|ГДЕ
		|	Векселя.Номер = &Код И Векселя.Серия = &Серия
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КодыВТорговыхСистемахСрезПоследних.Объект
		|ИЗ
		|	РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
		|ГДЕ
		|	КодыВТорговыхСистемахСрезПоследних.Код = &Код";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 1 Тогда // Нашли ЦБ.
		Выборка.Следующий();
		Возврат Выборка.ЦеннаяБумага;
	ИначеЕсли Выборка.Количество() = 0 Тогда // Не нашли ЦБ.
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось определить ценную бумагу по коду '%1'!", Код));
		Возврат Неопределено;
	ИначеЕсли Выборка.Количество() > 1 Тогда // Нашли несколько ЦБ.
		Выборка.Следующий();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось определить ценную бумагу. По коду '%1' найдено несколько ценных бумаг.", Код));
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСтроку(Текст, Индекс, Смещение = 1)
	
	Индекс = Индекс + Смещение;
	
	Результат = СтрЗаменить(СокрЛП(СтрПолучитьСтроку(Текст, Индекс)), Символы.НПП, "");
	
	Если Результат = "</TD>" Тогда
		// такое бывает, когда значение поля пустое, например 
		// <td class="left">
        // </td>
		Возврат ПолучитьСтроку(Текст, Индекс);
	Иначе
		Возврат Результат;
	КонецЕсли; 
	
КонецФункции

Функция ПолучитьСодержимоеФайлов(Знач Каталоги, СверкаСМесячнымОтчетомБрокера, ВремяПолученияДанных = Неопределено)
	
	// Результат теперь возвращает массив структур (ДатаСоздания, Данные):
	//  ДатаСоздания - Дата		- наименьшее из даты создания и даты изменения файла.
	//							  Файлы из архива наследуют даты.
	//  Данные		 - Строка	- текст файла
	
	Результат	 = Новый Массив;
	Файлы		 = Новый Массив;
	
	Если ЭтоАдресВременногоХранилища(Каталоги) Тогда
		
		ПараметрыФайла = ПолучитьИзВременногоХранилища(Каталоги);
		ПутьКВременномуФайлу = ПолучитьИмяВременногоФайла(ПараметрыФайла.Расширение);
		ПараметрыФайла.ДвоичныеДанные.Записать(ПутьКВременномуФайлу);
		
		ОбъектФайл = Новый Файл(ПутьКВременномуФайлу);
		ЗаполнитьФайлы(ОбъектФайл, Файлы, Каталоги);
		
	Иначе
		
		МассивКаталогов = СтрРазделить(Каталоги, Символ(0182));
				
		Для Каждого Каталог ИЗ МассивКаталогов Цикл
			ОбъектФайл = Новый Файл(Каталог);
			ЗаполнитьФайлы(ОбъектФайл, Файлы, Каталог);
		КонецЦикла;
				
	КонецЕсли;

	Для Каждого ТекФайл Из Файлы Цикл
		
		Если ТекФайл.Расширение = ".zip" Тогда
			
			ПутьКФайламИзАрхива = КаталогВременныхФайлов() + ТекФайл.ИмяБезРасширения;
			
			ЧтениеZIP = Новый ЧтениеZipФайла(ТекФайл.ПолноеИмя);
			
			Попытка
				ЧтениеZIP.ИзвлечьВсе(ПутьКФайламИзАрхива, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
			Исключение
				Сообщить("Ошибка при распаковке архива '" + ТекФайл.ПолноеИмя + "':" + Символы.ПС + ОписаниеОшибки());
				Возврат Неопределено;
			КонецПопытки;
			
			ВремяПолученияФайла = ?(ВремяПолученияДанных = Неопределено, ОпределитьДатуСозданияФайла(ТекФайл.ПолноеИмя), ВремяПолученияДанных);	
			
			СодержимоеФайлов = ПолучитьСодержимоеФайлов(ПутьКФайламИзАрхива, СверкаСМесячнымОтчетомБрокера, ВремяПолученияФайла);
			
			Если СодержимоеФайлов <> Неопределено Тогда
				РаботаСКоллекциями.ДополнитьМассив(Результат, СодержимоеФайлов);
			КонецЕсли;
			
			УдалитьФайлы(ПутьКФайламИзАрхива);
			
		ИначеЕсли ТекФайл.Расширение = ".htm" ИЛИ ТекФайл.Расширение = ".html" Тогда
			
			ТД = Новый ТекстовыйДокумент;
			
			Попытка
				ТД.Прочитать(ТекФайл.ПолноеИмя);
			Исключение
				Сообщить("Ошибка при чтении файла '" + ТекФайл.ПолноеИмя + "':" + Символы.ПС + ОписаниеОшибки());
				Возврат Неопределено;
			КонецПопытки;
			
			ВремяПолученияФайла = ?(ВремяПолученияДанных = Неопределено, ОпределитьДатуСозданияФайла(ТекФайл.ПолноеИмя), ВремяПолученияДанных);	
			
			Результат.Добавить(Новый Структура("ВремяПолученияДанных, Данные", ВремяПолученияФайла, СтрЗаменить(ТД.ПолучитьТекст(), "&nbsp;", "")));
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЭтоАдресВременногоХранилища(Каталог) Тогда
		УдалитьФайлы(ПутьКВременномуФайлу);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьФайлы(ОбъектФайл, Файлы, Каталог)
	
	Если ОбъектФайл.Существует() И ОбъектФайл.ЭтоКаталог() Тогда
		
		ФайлыТекущегоКаталога = НайтиФайлы(Каталог, "*", Истина);
		
		Для Каждого Файл Из ФайлыТекущегоКаталога Цикл
			Файлы.Добавить(Файл);
		КонецЦикла;
		
	Иначе
		Если ОбъектФайл.Существует() Тогда
			Файлы.Добавить(ОбъектФайл);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

Функция ОпределитьДатуСозданияФайла(ПолноеИмяФайла)
	
	Файл = Новый Файл(ПолноеИмяФайла);
	
	ДатаИзменения = Файл.ПолучитьВремяИзменения();
	
	Попытка
		FSO = Новый COMОбъект("Scripting.FileSystemObject");
		ДатаСоздания = FSO.GetFile(ПолноеИмяФайла).DateCreated;
	Исключение
		ДатаСоздания = Неопределено;
	КонецПопытки;
	
	Если ДатаСоздания = Неопределено Тогда
		ДатаСоздания = ДатаИзменения;
	Иначе
		ДатаСоздания = Мин(ДатаСоздания, ДатаИзменения);
	КонецЕсли;
	
	Возврат ДатаСоздания;
	
КонецФункции

Функция ПолучитьНовуюСтрокуДанныхОтчета(ДоговорБрокерскогоОбслуживания, СубъектАналитики, ВалютнаяСекция, НачалоПериода, КонецПериода)
	
	Результат = Новый Структура;
	
	Результат.Вставить("ДБО",				ДоговорБрокерскогоОбслуживания);
	Результат.Вставить("СА",				СубъектАналитики);
	Результат.Вставить("ВалютнаяСекция",	ВалютнаяСекция);
	Результат.Вставить("НачалоПериода",		НачалоПериода);
	Результат.Вставить("КонецПериода",		КонецПериода);
	
	Возврат Результат;
	
КонецФункции

Функция ДесериализоватьДанныеОтчета(НачалоПериода, КонецПериода, ТекстФайла, Организация, Брокер, КешОбъектов, ЗагружаемыеРазделы, ПропускатьСтрокиЕслиЦБНеНайдена, СверкаСМесячнымОтчетомБрокера, ОтборСчетаДУ = Неопределено, ЕстьДанныеЗаПериод = Ложь)
	
	ТекстФайла = ВРег(ТекстФайла);
	
	Результат = Новый Структура;
	
	ДатаФормированияОтчетаОпределена            = Не ЗагружаемыеРазделы.ДатаФормированияОтчета;
	ПериодОтчетаОпределен						= Не ЗагружаемыеРазделы.ДатаОтчета;
	ДБОИСАОпределены							= Не ЗагружаемыеРазделы.ДБОИСА;
	ОстаткиОбработаны							= Не ЗагружаемыеРазделы.ОстаткиДенежныхСредств;
	ОбязательстваОбработаны						= Не ЗагружаемыеРазделы.ОбязательстваПоДенежнымСредствам;
	КомиссияОбработана							= Не (ЗагружаемыеРазделы.ОстаткиЗадолженностиПоКомиссииНаНачало Или ЗагружаемыеРазделы.ОстаткиЗадолженностиПоКомиссииНаКонец Или ЗагружаемыеРазделы.НачисленнаяКомиссияЗаПериод Или ЗагружаемыеРазделы.ОплаченнаяКомиссияЗаПериод);
	ДвиженияОбработаны							= Не ЗагружаемыеРазделы.ДвиженияДенежныхСредств;
	ЗаблокированныеДСОбработаны					= Не ЗагружаемыеРазделы.ЗаблокированныеДенежныеСредства;
	ДСКПоступлениюОбработаны					= Не ЗагружаемыеРазделы.ОжидаемыеПоступленияДенежныхСредств;
	КонверсионныеСделкиОбработаны				= Не ЗагружаемыеРазделы.КонверсионныеСделки;
	НезавершенныеКонверсионныеСделкиОбработаны	= Не ЗагружаемыеРазделы.НезавершенныеКонверсионныеСделки;
	ОстаткиЦБОбработаны							= Не (ЗагружаемыеРазделы.ОстаткиАкций Или ЗагружаемыеРазделы.ОстаткиОблигаций Или ЗагружаемыеРазделы.ОстаткиПаев 
													Или ЗагружаемыеРазделы.ЗаблокированныеАкции Или ЗагружаемыеРазделы.ЗаблокированныеОблигации Или ЗагружаемыеРазделы.ЗаблокированныеПаи);
	ЗадолженностьПоЦБОбработана					= Не ЗагружаемыеРазделы.ЗадолженностьПоЦБ;
	ДвиженияЦБОбработаны						= Не (ЗагружаемыеРазделы.ДвиженияАкций Или ЗагружаемыеРазделы.ДвиженияОблигаций Или ЗагружаемыеРазделы.ДвиженияПаев);
	ОжидаемыеПоступленияЦБОбработаны			= Не (ЗагружаемыеРазделы.ОжидаемыеПоступленияАкций Или ЗагружаемыеРазделы.ОжидаемыеПоступленияОблигаций Или ЗагружаемыеРазделы.ОжидаемыеПоступленияПаев);
	СделкиСЦБОбработаны							= Не (ЗагружаемыеРазделы.СделкиСАкциями Или ЗагружаемыеРазделы.СделкиСОблигациями Или ЗагружаемыеРазделы.СделкиСПаями);
	
	ДатаОтчета		= Неопределено;
	ДБО				= Неопределено;
	СА				= Неопределено;
	       					
	Для ИндексСтроки = 1 По СтрЧислоСтрок(ТекстФайла) Цикл
		
		Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки, 0);
		
		Если СтрНайти(Строка, "</HTML>") <> 0
			Или СтрНайти(Строка, "<H4>ДВИЖЕНИЕ ЦЕННЫХ БУМАГ (СПИСАНИЕ / ЗАЧИСЛЕНИЕ):</H4>") <> 0 
			Или СтрНайти(Строка, "СДЕЛКИ СО СРОЧНЫМИ КОНТРАКТАМИ ПО СЧЕТУ КЛИЕНТА ЗА ОТЧЕТНЫЙ ПЕРИОД (ФЬЮЧЕРСЫ):") <> 0
			Или (СделкиСЦБОбработаны И КонверсионныеСделкиОбработаны И НезавершенныеКонверсионныеСделкиОбработаны
				И СтрНайти(Строка, "<H5>СДЕЛКИ С ЦЕННЫМИ БУМАГАМИ ПО СЧЕТУ КЛИЕНТА ЗА ОТЧЕТНЫЙ ПЕРИОД:</H5>") > 0) Тогда
			
			Прервать;
			
		КонецЕсли;
		
		#Область ОпределениеДатыОтчета
		
		// Определяем дату формирования отчета
		Если Не ДатаФормированияОтчетаОпределена Тогда
			
			Если СтрНайти(Строка, "ДАТА:") > 0 Тогда
				// сама дата содержится в следующей строке
				ДатаФормированияОтчета = ПолучитьСтроку(ТекстФайла, ИндексСтроки);
				ДатаФормированияОтчета = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Лев(ДатаФормированияОтчета, 10));
				
				Результат.Вставить("ДатаФормированияОтчета", ДатаФормированияОтчета);
				
				ДатаФормированияОтчетаОпределена = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		// Определяем дату и период отчета.
		Если НЕ ПериодОтчетаОпределен Тогда
			
			Если СтрНайти(Строка, "ОТЧЕТ КЛИЕНТУ ЗА ПЕРИОД С") > 0 Тогда
				
				ПериодОтчетаОпределен = Истина;
				
				// Определяем начало периода отчета.
				Строка				= ПолучитьСтроку(ТекстФайла, ИндексСтроки);
				НачалоПериодаОтчета	= Дата(Сред(Строка, 7, 4), Сред(Строка, 4, 2), Лев(Строка, 2));
				ДатаОтчета			= КонецПериода;
				
				// Определяем конец периода отчета.
				Строка				= ПолучитьСтроку(ТекстФайла, ИндексСтроки);
				
				Если СтрНайти(Строка, ".") = 0 Тогда
					Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки);
				КонецЕсли;
				
				Строка = СтрЗаменить(Строка, " ", "");
				Строка = СтрЗаменить(Строка, "ПО", "");
				Строка = СтрЗаменить(Строка, Символы.ПС, "");
				
				КонецПериодаОтчета	= Дата(Сред(Строка, 7, 4), Сред(Строка, 4, 2), Лев(Строка, 2));
				
				// Проверяем соответствие периода сверки с датой отчета.
				Если СверкаСМесячнымОтчетомБрокера
						И (НачалоПериодаОтчета <> НачалоПериода
							ИЛИ КонецМесяца(КонецПериодаОтчета) <> КонецПериода)
					ИЛИ НЕ СверкаСМесячнымОтчетомБрокера
							И (НачалоПериодаОтчета <> НачалоПериода
								ИЛИ КонецДня(КонецПериодаОтчета) <> КонецПериода) Тогда
					Возврат Неопределено;
				КонецЕсли;
				
				Результат.Вставить("НачалоПериода",	НачалоПериодаОтчета);
				Результат.Вставить("КонецПериода",	КонецПериодаОтчета);
				
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		#КонецОбласти
		#Область ОпределениеДБОИСДУ
		
		// Определяем договор брокерского обслуживания и счет доверительного управления.
		Если НЕ ДБОИСАОпределены Тогда
			
			Если СтрНайти(Строка, "НОМЕР ИНВЕСТИЦИОННОГО СЧЕТА:") > 0 Тогда
				Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки);
				
			 	КодСДУ = СтрЗаменить(СтрЗаменить(СтрЗаменить(Строка, "</TD>", ""), "<TD>", ""), "</TR>", "");
				    								
				Если Прав(КодСДУ, 1) = "V" Тогда
					ВалютнаяСекция = Истина;
					КодСДУ = СтрЗаменить(КодСДУ, "V", "");
				Иначе
					ВалютнаяСекция = Ложь;
				КонецЕсли;
				
				Результат.Вставить("Валютный", ВалютнаяСекция);
				
				ДанныеСДУ = ПолучитьСчетДУ(Организация, Брокер, ДатаОтчета, КодСДУ, ОтборСчетаДУ);
				
				Если ДанныеСДУ <> Неопределено Тогда
					
					СА	= ДанныеСДУ.СубъектАналитики;
					ДБО	= ДанныеСДУ.Договор;
					
					ДБОИСАОпределены = Истина;
					
					Если Не ДанныеСДУ.СверятьДанныеПоСубъекту Тогда
						//не удовл. усл. отбора, но файлы есть 
						ЕстьДанныеЗаПериод = Истина;
						Возврат Неопределено;
					КонецЕсли;
					
				КонецЕсли;
				
			ИначеЕсли СтрНайти(Строка, "СОГЛАШЕНИЕ О БРОКЕРСКОМ ОБСЛУЖИВАНИИ:") > 0 Тогда
				//Получаем номер ДБО
				Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки);
				НомерДБО = СтрЗаменить(СтрЗаменить(СтрЗаменить(Строка, "<TD>", ""), " ОТ", ""), " ", "");
				
				// Получаем дату ДБО
				Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки);
				
				Если СтрНайти(Строка, ".") = 0 Тогда
					Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки);
				КонецЕсли;
				
				Строка = Лев(Строка, СтрНайти(Строка, "</TD>") - 1);
				
				ДатаДБО = Дата(Прав(Строка, 4), Сред(Строка, 4, 2), Лев(Строка, 2));
				
				ДанныеОДоговоре = ПолучитьДоговорБО(Организация, Брокер, НомерДБО, ДатаДБО, ДатаОтчета, ОтборСчетаДУ);
				
				Если ДанныеОДоговоре = Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить договор брокерского обслуживания с № " + НомерДБО + " и датой " + Формат(ДатаДБО, "ДФ=dd.MM.yyyy") + "! Сверка с данным отчетом брокера не будет произведена.");
					Прервать;
				КонецЕсли;
				
				ДБО	= ДанныеОДоговоре.Договор;
				СА	= ДанныеОДоговоре.СубъектАналитики;
				ДБОИСАОпределены = Истина;
				
				Если Не ДанныеОДоговоре.СверятьДанныеПоСубъекту Тогда
					ЕстьДанныеЗаПериод = Истина;
					Возврат Неопределено;
				КонецЕсли;
				
			КонецЕсли;
			
			Результат.Вставить("СА", СА);
			Результат.Вставить("ДБО", ДБО);
			
			Продолжить;
			
		КонецЕсли;
		#КонецОбласти
		#Область ОпределениеОстатковДС
		// Определяем остаток ДС.
		Если Не ОстаткиОбработаны Тогда
			
			Если СтрНайти(Строка, "<H5>ОСТАТОК ДЕНЕЖНЫХ СРЕДСТВ") > 0 Тогда
				
				Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки);
				
				Если СтрНайти(Строка, "<TABLE") > 0 Тогда
					
					Остатки = Новый Массив;
					
					ОбработкаОстатковДС = Истина;
					
					Пока ОбработкаОстатковДС Цикл
						
						Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки);
						
						Если СтрНайти(Строка, "ВХОДЯЩИЙ ОСТАТОК ДС НА НАЧАЛО ПЕРИОДА,") > 0 Тогда
							
							Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки);
							
							Код = Лев(Строка, 3);
							
							Валюта = КешОбъектов.Валюты.Получить(Код);
							
							Если Валюта = Неопределено Тогда
								Валюта = ПолучитьВалютуПоНаименованию(?(Код = "РУБ", "RUB", Код));
								КешОбъектов.Валюты.Вставить(Код, Валюта);
							КонецЕсли;
							
							// Если остатки ДС 0, то расшифровки не будет.
							Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки, 2);
							НачальныйОстаток = Число(СтрЗаменить(СтрЗаменить(Строка, "<TD CLASS=""RIGHT COLORED"">", ""), "</TD>", ""));
							
							Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки, 5);
							КонечныйОстаток = Число(СтрЗаменить(СтрЗаменить(Строка, "<TD CLASS=""RIGHT COLORED"">", ""), "</TD>", ""));
							
							Если НачальныйОстаток = 0 И КонечныйОстаток = 0 Тогда
								НоваяСтрока = ПолучитьНовуюСтрокуДанныхОтчета(ДБО, СА, ВалютнаяСекция, НачалоПериодаОтчета, КонецПериодаОтчета);
								
								НоваяСтрока.Вставить("ВнебиржевойРынок");
								НоваяСтрока.Вставить("НачальныйОстаток");
								НоваяСтрока.Вставить("КонечныйОстаток");
								НоваяСтрока.Вставить("Валюта", Валюта);
								
								Остатки.Добавить(НоваяСтрока);
								
								Продолжить;
							КонецЕсли;
							
							Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки, 7);
							
							ОбработкаОстатковПоВалюте = Истина;
							СмещениеСтроки = 4;
							
							Пока ОбработкаОстатковПоВалюте Цикл
								
								НоваяСтрока = ПолучитьНовуюСтрокуДанныхОтчета(ДБО, СА, ВалютнаяСекция, НачалоПериодаОтчета, КонецПериодаОтчета);
								
								НоваяСтрока.Вставить("ВнебиржевойРынок");
								НоваяСтрока.Вставить("НачальныйОстаток");
								НоваяСтрока.Вставить("КонечныйОстаток");
								НоваяСтрока.Вставить("Валюта", Валюта);
								
								НоваяСтрока.ВнебиржевойРынок = СтрНайти(Строка, "ВНЕБИРЖЕВОЙ РЫНОК") > 0;
								
								Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки);
								
								НоваяСтрока.НачальныйОстаток = Число(СтрЗаменить(СтрЗаменить(Строка, "<TD CLASS=""RIGHT"">", ""), "</TD>", ""));
								
								Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки, 2 + СмещениеСтроки);
								СмещениеСтроки = 0;
								
								НоваяСтрока.КонечныйОстаток = Число(СтрЗаменить(СтрЗаменить(Строка, "<TD CLASS=""RIGHT"">", ""), "</TD>", ""));
								
								Остатки.Добавить(НоваяСтрока);
								
								Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки, 3);
								
								Если СтрНайти(Строка, "<TD CLASS=""LEFT"">") = 0 Тогда
									ИндексСтроки = ИндексСтроки - 3;
									ОбработкаОстатковПоВалюте = Ложь;
								КонецЕсли;
								
							КонецЦикла;
							
							Продолжить;
							
						КонецЕсли;
						
						Если СтрНайти(Строка, "</TABLE>") Тогда
							ОбработкаОстатковДС = Ложь;
							ОстаткиОбработаны = Истина;
							Результат.Вставить("ОстаткиДенежныхСредств", Остатки);
						КонецЕсли;
						
					КонецЦикла;
					
					Продолжить;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		#КонецОбласти
		#Область ОпределениеОбязательствПоДС
		// Определяем обязательства по ДС.
		Если Не ОбязательстваОбработаны И СтрНайти(Строка, "<H5>ОБЯЗАТЕЛЬСТВА ПО ДС") > 0 Тогда
			
			Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки, 9);
			
			ЗадолженностиПоДС = Новый Массив;
			
			ОбработкаЗадолженностиДС = Истина;
				
			Пока ОбработкаЗадолженностиДС Цикл			
				
				Строка = ПолучитьСтроку(ТекстФайла, ИндексСтроки);
				
				Если СтрНайти(Строка, "<TD CLASS=""LEFT"">") > 0 Тогда
					
					НоваяСтрока = ПолучитьНовуюСтрокуДанныхОтчета(ДБО, СА, ВалютнаяСекция, НачалоПериодаОтчета, КонецПериодаОтчета);
					
					НоваяСтрока.Вставить("Валюта");
					НоваяСтрока.Вставить("НачальныйОстаток");
					НоваяСтрока.Вставить("ДебиторскаяЗадолженность");
					НоваяСтрока.Вставить("КредиторскаяЗадолженность");
					НоваяСтрока.Вставить("КонечныйОстаток");
					
					Наименование = СтрЗаменить(СтрЗаменить(Строка, "<TD CLASS=""LEFT"">", ""), "</TD>", "");
					
					Валюта = КешОбъектов.Валюты.Получить(Наименование);
					
					Если Валюта = Неопределено Тогда
