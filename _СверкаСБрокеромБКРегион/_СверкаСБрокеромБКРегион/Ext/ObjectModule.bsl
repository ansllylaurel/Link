#КонецОбласти

	НепоределенныеСчета = Новый Массив;
	НепоределенныеСчета.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Неопределен_Траст"));
	НепоределенныеСчета.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Неопределен_РЭМ"));
	
	Запрос.УстановитьПараметр("КонецПериода"       , КонецПериода);
	Запрос.УстановитьПараметр("НачалоПериода"      , НачалоПериода);
	Запрос.УстановитьПараметр("Ключ"               , "УчетНеВедется");
	Запрос.УстановитьПараметр("Организация"        , ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер"             , Брокер);
	Запрос.УстановитьПараметр("Депозитарий"        , Депозитарий);
	Запрос.УстановитьПараметр("Accounts"           , СтруктураВнешнихДанных.Accounts);
	Запрос.УстановитьПараметр("Accounts_Divisions" , СтруктураВнешнихДанных.Accounts_Divisions);
	Запрос.УстановитьПараметр("Currencies"         , СтруктураВнешнихДанных.Currencies);
	Запрос.УстановитьПараметр("КодыЦенныхБумаг"    , СтруктураВнешнихДанных.КодыЦенныхБумаг);
	Запрос.УстановитьПараметр("ДанныеПервыхУзлов"  , СтруктураВнешнихДанных.ДанныеПервыхУзлов);
	Запрос.УстановитьПараметр("СчетаДУ"            , ?(СчетаДУ = Неопределено, Справочники.СчетаДоверительногоУправления.ПустаяСсылка(), СчетаДУ));
	Запрос.УстановитьПараметр("НеопределенныеСчета", НепоределенныеСчета);
	Запрос.УстановитьПараметр("ГруппаОбъектов"     , Справочники.ГруппыИмпортируемыхОбъектов.ДепозитарныеСчета);
	
	Если ЭтотОбъект.ОчередьЗагрузки = 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборОчередьЗагрузки", "ЛОЖЬ");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборОчередьЗагрузки", "НЕ СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоровСчетовДУ)");
		Запрос.УстановитьПараметр("ВидыДоговоровСчетовДУ", РаботаСВнешнимиСистемами.ПолучитьВидыДоговорДоверительногоУправленияДляОчереди(ЭтотОбъект.Организация, ЭтотОбъект.ОчередьЗагрузки));
	КонецЕсли;
		
	Результат = Запрос.ВыполнитьПакет();
	
	Выборка = Результат[14].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.СчетДоверительногоУправления) Тогда
			
			Если ЗначениеЗаполнено(Выборка.ДатаРасторженияСчета) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В отчете OTBR присутствуют данные счета ДУ [" + Выборка.СчетДоверительногоУправления + "], у которого истек срок действия договора доверительного управления [" + Формат(Выборка.ДатаРасторженияСчета, "ДФ=dd.MM.yyyy") + " г.]");	
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Выборка.ДатаРасторженияДоговора) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В отчете OTBR присутствуют данные счета ДУ [" + Выборка.СчетДоверительногоУправления + "], у которого истек срок действия договора с брокером [" + Формат(Выборка.ДатаРасторженияДоговора, "ДФ=dd.MM.yyyy") + " г.]");	
			КонецЕсли;
				
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В регистре [Коды счетов ДУ у брокера] не найден счет ДУ по коду [" + Выборка.Account_Division_Number + "]. Матрикс ID счета [" + Выборка.Account_ID + "], матрикс ID портфеля [" + Выборка.Account_Division_ID + "].");	
		КонецЕсли;
		
	КонецЦикла;
	
	Выборка = Результат[15].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В регистре [Коды во внешних системах] не найдена бумага [" + Выборка.ТипБумаги + "] по коду [" + Выборка.Matrix_ID + "].");	
	КонецЦикла;
		
	Выборка = Результат[16].Выбрать();	
		
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В регистре [Коды во внешних системах] не найдена валюта [" + Выборка.ISO_Code + "] по коду [" + Выборка.Matrix_ID + "].");	
	КонецЦикла;
		
	Если Результат[17].Пустой() Тогда	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В папке [" + Каталог + "] отсутствуют файлы OTBR соответствующие параметрам импорта.");	
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _ДатыПериода
