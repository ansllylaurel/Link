	Запрос.УстановитьПараметр("ОтборПоСчету", ?(ОтборСчетаДУ = Неопределено, Ложь, Истина));
	Запрос.УстановитьПараметр("МассивСчетов", ?(ОтборСчетаДУ = Неопределено, Новый Массив, ОтборСчетаДУ));

	
	Запрос.Текст =
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия КАК Стратегия,
	    |	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнойБрокерскийДоговор КАК Договор,
	    |	МАКСИМУМ(ВЫБОР
	    |			КОГДА &ОтборПоСчету
	    |				ТОГДА ВЫБОР
	    |						КОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления В (&МассивСчетов)
	    |							ТОГДА ИСТИНА
	    |						ИНАЧЕ ЛОЖЬ
	    |					КОНЕЦ
	    |			ИНАЧЕ ИСТИНА
	    |		КОНЕЦ) КАК ФлСверятьДанныеПоСубъекту
	    |ИЗ
	    |	РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(&ДатаОтчета, Организация = &Организация) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
	    |ГДЕ
	    |	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнойБрокерскийДоговор.Организация = &Организация
	    |	И СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнойБрокерскийДоговор.Контрагент = &Контрагент
	    |	И СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнойБрокерскийДоговор.НомерДоговора = &Номер
	    |	И СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнойБрокерскийДоговор.ДатаЗаключения = &Дата
	    |
	    |СГРУППИРОВАТЬ ПО
	    |	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия,
	    |	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнойБрокерскийДоговор";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Договор, СубъектАналитики, СверятьДанныеПоСубъекту", Выборка.Договор, Выборка.Стратегия, Выборка.ФлСверятьДанныеПоСубъекту);
	Иначе
