// ИНТЕРФЕЙС

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка", "Проведение отложенных биржевых операций", "1.34", "", Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ПроведениеОтложенныхБиржевыхОперацийЗаТекущуюДату",  "Проведение отложенных биржевых операций за текущую дату",, Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска загрузки отложенных операций по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	ЭтотОбъект.Организация = ПараметрыКоманды.Организация;
	ЭтотОбъект.Период      = ТекущаяДатаСеанса();
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	
	ПровестиОтложенныеБиржевыеОперации();
	
КонецПроцедуры // ВыполнитьКоманду

Процедура ПровестиОтложенныеБиржевыеОперации() Экспорт
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ПровестиОтложенныеБиржевыеОперации()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Организация, Период");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	ДопПараметрыДляФиксацииСтатистики = Новый Структура;
	
	ПараметрыСеанса.ФормированиеДвиженийПоРегистрамБэкОфиса = Истина;
	
	СписатьОтложеннуюОплатуТорговойКомиссии(ДопПараметрыДляФиксацииСтатистики);
	ПровестиИсполненияОбязательствПоСделкамИЗакрытияРЕПО(ДопПараметрыДляФиксацииСтатистики);	
	
	ОповеститьОбОшибках();
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, ДопПараметрыДляФиксацииСтатистики);

КонецПроцедуры // ПровестиОтложенныеБиржевыеОперации

////////////////////////////////////////////////////////////////////////////////
// ОСНОВНОЙ ФУНКЦИОНАЛ

Процедура ПровестиИсполненияОбязательствПоСделкамИЗакрытияРЕПО(ДопПараметры) 
	
	ПроведеноИсполнений = 0;
	ПроведеноСделокРепо = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""ИсполнениеСделки"" КАК ТипОперации,
		|	ИсполнениеОбязательствПоСделке.Ссылка КАК Ссылка,
		|	ИсполнениеОбязательствПоСделке.Дата КАК Дата
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|ГДЕ
		|	НЕ ИсполнениеОбязательствПоСделке.Проведен
		|	И НЕ ИсполнениеОбязательствПоСделке.ПометкаУдаления
		|	И ИсполнениеОбязательствПоСделке.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ) И КОНЕЦПЕРИОДА(&Дата, ДЕНЬ)
		|	И ИсполнениеОбязательствПоСделке.Организация = &Организация
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""СделкаРепо"",
		|	СделкаРЕПО.Ссылка,
		|	СделкаРЕПО.Дата
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПО
		|ГДЕ
		|	НЕ СделкаРЕПО.Проведен
		|	И НЕ СделкаРЕПО.ПометкаУдаления
		|	И СделкаРЕПО.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ) И КОНЕЦПЕРИОДА(&Дата, ДЕНЬ)
		|	И СделкаРЕПО.Организация = &Организация
		|	И СделкаРЕПО.ЧастьСделкиРЕПО = 2
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
		
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Дата",        ЭтотОбъект.Период);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			
			СделкаРепо = Выборка.Ссылка.ПолучитьОбъект();
			СделкаРепо.Записать(РежимЗаписиДокумента.Проведение);
			
			Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведен документ " + СделкаРепо, СделкаРепо.Ссылка);
			КонецЕсли;
			
			Если Выборка.ТипОперации = "ИсполнениеСделки" Тогда 
				ПроведеноИсполнений = ПроведеноИсполнений + 1;
			ИначеЕсли Выборка.ТипОперации = "СделкаРепо" Тогда
				ПроведеноСделокРепо = ПроведеноСделокРепо + 1;
			КонецЕсли
				
		Исключение
			
			ЗарегистрироватьОшибкуИмпорта("Не удалось провести документ " + СделкаРепо + ". Система сообщает: " + ОписаниеОшибки());
			
		КонецПопытки;
		
	КонецЦикла;
	
	ДопПараметры.Вставить("ИсполнениеОбязательствПоСделкам", "Проведено " + ПроведеноИсполнений + " док.");
	ДопПараметры.Вставить("СделкаРепо", "Проведено " + ПроведеноСделокРепо + " док.");
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведено документов: " + Строка(ПроведеноИсполнений + ПроведеноСделокРепо) + " из " + Выборка.Количество());
	КонецЕсли;
		
КонецПроцедуры // ИмпортироватьИсполненияОбязательствПоСделкам

Процедура СписатьОтложеннуюОплатуТорговойКомиссии(ДопПараметры)
	
	КлючевыеПоляСтр = "Брокер, МестоХранения, СчетДоверительногоУправления, ОснованияНомерСтроки";
	КлючевыеПоля    = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(КлючевыеПоляСтр, ",", Истина, Истина);
	ИсключаемыеПоля = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("Ответственный, Комментарий, ОбеспечительныйПлатеж, КоррСчет, Субконто1, Субконто2, Субконто3, КоррСчетЕПС, СубконтоЕПС1, СубконтоЕПС2, СубконтоЕПС3, ДатаПлановогоПогашенияЗадолженности, ОснованияПортфель, ОснованияСтавкаНДС, ОснованияСуммаНДС", ",", Истина, Истина);
	
	// отберем фактические оплаты
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период",      ЭтотОбъект.Период);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Оплата.Проведен КАК Проведен,
		|	Оплата.Ссылка КАК Ссылка,
		|	Оплата.Дата КАК Дата,
		|	Оплата.Организация КАК Организация,
		|	Оплата.ВидДвижения КАК ВидДвижения,
		|	Оплата.ВидЗадолженности КАК ВидЗадолженности,
		|	Оплата.Аванс КАК Аванс,
		|	Оплата.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Оплата.Брокер КАК Брокер,
		|	Оплата.МестоХранения КАК МестоХранения,
		|	Оплата.РасчетныйСчет КАК РасчетныйСчет,
		|	Оплата.ВалютаОплаты КАК ВалютаОплаты,
		|	Оплата.СтрокаБанковскойВыписки КАК СтрокаБанковскойВыписки,
		|	Оплата.Договор КАК Договор,
		|	Оплата.Контрагент КАК Контрагент,
		|	Оплата.РасчетныйСчетКонтрагента КАК РасчетныйСчетКонтрагента,
		|	Оплата.Поручение КАК Поручение,
		|	-ОплатаОснования.НомерСтроки КАК ОснованияНомерСтроки,
		|	ОплатаОснования.Основание КАК ОснованияОснование,
		|	ОплатаОснования.Валюта КАК ОснованияВалюта,
		|	ОплатаОснования.Сумма КАК ОснованияСумма,
		|	ОплатаОснования.СуммаОплаты КАК ОснованияСуммаОплаты,
		|	ОплатаОснования.СуммаКупона КАК ОснованияСуммаКупона,
		|	ОплатаОснования.СуммаОплатыКупона КАК ОснованияСуммаОплатыКупона,
		|	ОплатаОснования.СобственныйКурсОплаты КАК ОснованияСобственныйКурсОплаты,
		|	ОплатаОснования.КурсОплаты КАК ОснованияКурсОплаты
		|ИЗ
		|	Документ.Оплата.Основания КАК ОплатаОснования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Оплата КАК Оплата
		|		ПО ОплатаОснования.Ссылка = Оплата.Ссылка
		|ГДЕ
		|	НЕ Оплата.ПометкаУдаления
		|	И Оплата.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И Оплата.Организация = &Организация
		|	И Оплата.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|	И Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)";

	ОплатыТорговойКомиссии = Запрос.Выполнить().Выгрузить();
	
	// дополним таблицу плановыми полями
	ПоляРесурсы = Новый Массив;
	
	ОплатыТорговойКомиссии.Колонки.Добавить("НовДата", Новый ОписаниеТипов("Дата"));
	ПоляРесурсы.Добавить("Дата");
	
	Для каждого РеквизитМД Из Метаданные.Документы.Оплата.Реквизиты Цикл
		Если КлючевыеПоля.Найти(РеквизитМД.Имя) = Неопределено И ИсключаемыеПоля.Найти(РеквизитМД.Имя) = Неопределено Тогда
			ОплатыТорговойКомиссии.Колонки.Добавить("Нов" + РеквизитМД.Имя, РеквизитМД.Тип);
			ПоляРесурсы.Добавить(РеквизитМД.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого РеквизитМД Из Метаданные.Документы.Оплата.ТабличныеЧасти.Основания.Реквизиты Цикл
		Если КлючевыеПоля.Найти("Основания" + РеквизитМД.Имя) = Неопределено И ИсключаемыеПоля.Найти("Основания" + РеквизитМД.Имя) = Неопределено Тогда
			ОплатыТорговойКомиссии.Колонки.Добавить("НовОснования" + РеквизитМД.Имя, РеквизитМД.Тип);
			ПоляРесурсы.Добавить("Основания" + РеквизитМД.Имя);
		КонецЕсли;
	КонецЦикла;
	
	ОплатыТорговойКомиссии.Колонки.Добавить("ОснованияПорядок", Метаданные.Документы.Сделка.Реквизиты.НомерСделки.Тип);
	
	// выберем плановые оплаты
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделка.Ссылка КАК Основание
		|ПОМЕСТИТЬ _СделкиСОплатойКомиссии
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|ГДЕ
		|	Сделка.ДатаОплатыТорговойКомиссии МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И Сделка.Организация = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДОБАВИТЬКДАТЕ(&Период, МИНУТА, 20 * 60 + 30) КАК НовДата,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Организация КАК НовОрганизация,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход) КАК НовВидДвижения,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии) КАК НовВидЗадолженности,
		|	ЛОЖЬ КАК НовАванс,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.Сделка).Брокер КАК Брокер,
		|	ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.Сделка).МестоХранения КАК МестоХранения,
		|	ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.Сделка).РасчетныйСчет КАК РасчетныйСчет,
		|	ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка) КАК НовРасчетныйСчет,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК НовВалютаОплаты,
		|	ЗНАЧЕНИЕ(Документ.СтрокаБанковскойВыписки.ПустаяСсылка) КАК НовСтрокаБанковскойВыписки,
		|	ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.Сделка).Брокер.ЮрФизЛицо КАК НовКонтрагент,
		|	ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка) КАК НовРасчетныйСчетКонтрагента,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК НовОснованияОснование,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК НовОснованияВалюта,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК НовОснованияСумма,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК НовОснованияСуммаКупона,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК НовОснованияСуммаОплаты,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК НовОснованияСуммаОплатыКупона,
		|	ЛОЖЬ КАК НовОснованияСобственныйКурсОплаты,
		|	НЕОПРЕДЕЛЕНО КАК НовОснованияКурсОплаты,
		|	ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.Сделка).НомерСделки КАК ОснованияПорядок
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			&Период,
		|			ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|				И Организация = &Организация
		|				И Основание В
		|					(ВЫБРАТЬ
		|						_СделкиСОплатойКомиссии.Основание
		|					ИЗ
		|						_СделкиСОплатойКомиссии)) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.Сделка).НомерСделки
		|ИТОГИ ПО
		|	Брокер,
		|	МестоХранения,
		|	СчетДоверительногоУправления";
		
	РезультатЗапроса = Запрос.Выполнить();
		
	// установим соответствие плановых и фактических данных по ключевым полям
	ВыборкаБрокер = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаБрокер.Следующий() Цикл
		
		ВыборкаМестоХранения = ВыборкаБрокер.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаМестоХранения.Следующий() Цикл
			
			ВыборкаСчетДоверительногоУправления = ВыборкаМестоХранения.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаСчетДоверительногоУправления.Следующий() Цикл
				
				Выборка = ВыборкаСчетДоверительногоУправления.Выбрать();
				
				НомерСтроки = 1;
				
				Пока Выборка.Следующий() Цикл
					
					Ключ = Новый Структура(КлючевыеПоляСтр);
					
					ЗаполнитьЗначенияСвойств(Ключ, Выборка);
					Ключ.ОснованияНомерСтроки = -НомерСтроки; // если останется отрицат. число, это будет признаком того, что строку нужно исключить
					
					СтрокиОплатыТорговойКомиссии = ОплатыТорговойКомиссии.НайтиСтроки(Ключ);
					
					Если      СтрокиОплатыТорговойКомиссии.Количество() = 0 Тогда
						НоваяСтрокаОплатыТорговойКомиссии = ОплатыТорговойКомиссии.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрокаОплатыТорговойКомиссии, Выборка);
						НоваяСтрокаОплатыТорговойКомиссии.ОснованияНомерСтроки = 0;
						
					ИначеЕсли СтрокиОплатыТорговойКомиссии.Количество() = 1 Тогда
						СтрокиОплатыТорговойКомиссии[0].ОснованияНомерСтроки = -СтрокиОплатыТорговойКомиссии[0].ОснованияНомерСтроки;
						ЗаполнитьЗначенияСвойств(СтрокиОплатыТорговойКомиссии[0], Выборка);
						
					Иначе
						Если НомерСтроки > 1 Тогда
							//Регистрируем ошибку один раз
							Продолжить;
						КонецЕсли;
						ЗарегистрироватьОшибкуИмпорта("Найдено более одной оплаты торговой комиссии за период " + ЭтотОбъект.Период 
							+ ", в организации: " + ЭтотОбъект.Организация
							+ ", где брокер: " + Выборка.Брокер
							+ ", место хранения: " + Выборка.МестоХранения
							+ ", счет д/у: " + Выборка.СчетДоверительногоУправления);
					КонецЕсли;
					
					НомерСтроки = НомерСтроки + 1;
					
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	// найдем и расхождения
	Обработано = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ОплатыТорговойКомиссии.ОснованияНомерСтроки <= 0
		|				ИЛИ Не ОплатыТорговойКомиссии.Проведен
		|				ИЛИ &УсловиеПоискаРасхождений
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ЕстьРасхождения,
		|	ОплатыТорговойКомиссии.Ссылка,
		|	ОплатыТорговойКомиссии.ОснованияПорядок,
		|	ОплатыТорговойКомиссии.ОснованияНомерСтроки,
		|	ОплатыТорговойКомиссии.Брокер,
		|	ОплатыТорговойКомиссии.МестоХранения,
		|	ОплатыТорговойКомиссии.СчетДоверительногоУправления,
		|	&Ресурсы
		|ПОМЕСТИТЬ _ОплатыТорговойКомиссии
		|ИЗ
		|	&ОплатыТорговойКомиссии КАК ОплатыТорговойКомиссии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОплатыТорговойКомиссии.Ссылка КАК Ссылка,
		|	_ОплатыТорговойКомиссии.ОснованияНомерСтроки,
		|	_ОплатыТорговойКомиссии.Брокер КАК Брокер,
		|	_ОплатыТорговойКомиссии.МестоХранения КАК МестоХранения,
		|	_ОплатыТорговойКомиссии.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОплатыТорговойКомиссии.ЕстьРасхождения КАК ЕстьРасхождения,
		|	&РесурсыДокумента
		|ИЗ
		|	_ОплатыТорговойКомиссии КАК _ОплатыТорговойКомиссии
		|
		|УПОРЯДОЧИТЬ ПО
		|	_ОплатыТорговойКомиссии.ОснованияПорядок
		|ИТОГИ
		|	СУММА(ЕстьРасхождения)
		|ПО
		|	Ссылка,
		|	Брокер,
		|	МестоХранения,
		|	СчетДоверительногоУправления";
		
	Запрос.УстановитьПараметр("ОплатыТорговойКомиссии", ОплатыТорговойКомиссии);
		
	ПоляРесурсыВЗапросе      = "";
	УсловиеПоискаРасхождений = "";
	ПоляДокументаВЗапросе    = "";
	
	Для каждого ПолеРесурс Из ПоляРесурсы Цикл
		ПоляРесурсыВЗапросе = ПоляРесурсыВЗапросе
			+ ?(ПустаяСтрока(ПоляРесурсыВЗапросе), "", "," + Символы.ПС + Символы.Таб)
			+ "ОплатыТорговойКомиссии.Нов" + ПолеРесурс + " КАК " + ПолеРесурс;
			
		ПоляДокументаВЗапросе = ПоляДокументаВЗапросе
			+ ?(ПустаяСтрока(ПоляДокументаВЗапросе), "", "," + Символы.ПС + Символы.Таб)
			+ "_ОплатыТорговойКомиссии." + ПолеРесурс;
			
		УсловиеПоискаРасхождений = УсловиеПоискаРасхождений
			+ ?(ПустаяСтрока(УсловиеПоискаРасхождений), "", Символы.ПС + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб)
			+ "ИЛИ ОплатыТорговойКомиссии." + ПолеРесурс + " <> ОплатыТорговойКомиссии.Нов" + ПолеРесурс;
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&РесурсыДокумента", ПоляДокументаВЗапросе);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Ресурсы", ПоляРесурсыВЗапросе);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИЛИ &УсловиеПоискаРасхождений", УсловиеПоискаРасхождений);
	
	ВыборкаСсылка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	Пока ВыборкаСсылка.Следующий() Цикл
		
		Если ВыборкаСсылка.ЕстьРасхождения = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаСсылка.Ссылка) Тогда
			ОплатаТорговойКомиссии = ВыборкаСсылка.Ссылка.ПолучитьОбъект();
			ОплатаТорговойКомиссии.Основания.Очистить();
		Иначе
			ОплатаТорговойКомиссии = Неопределено;
		КонецЕсли;
		
		ВыборкаБрокер = ВыборкаСсылка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаБрокер.Следующий() Цикл
			
			ВыборкаМестоХранения = ВыборкаБрокер.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаМестоХранения.Следующий() Цикл
				
				ВыборкаСчетДоверительногоУправления = ВыборкаМестоХранения.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаСчетДоверительногоУправления.Следующий() Цикл
					
					Если Не ЗначениеЗаполнено(ВыборкаСсылка.Ссылка) Тогда
						ОплатаТорговойКомиссии = Документы.Оплата.СоздатьДокумент();
						ОплатаТорговойКомиссии.Ответственный = РаботаСПользователями.ТекущийПользователь();
					КонецЕсли;
					
					Выборка = ВыборкаСчетДоверительногоУправления.Выбрать();
					
					Пока Выборка.Следующий() Цикл
						ЕстьОшибка = Ложь;
						Если Выборка.ОснованияНомерСтроки < 0 Тогда
							ЕстьОшибка = Истина;
							Продолжить;
						КонецЕсли;
						
						Если ОплатаТорговойКомиссии.Основания.Количество() = 0 Тогда
							ЗаполнитьЗначенияСвойств(ОплатаТорговойКомиссии, Выборка);
						КонецЕсли;
						
						НоваяСтрокаОснования = ОплатаТорговойКомиссии.Основания.Добавить();
						
						Для каждого РеквизитМД Из Метаданные.Документы.Оплата.ТабличныеЧасти.Основания.Реквизиты Цикл
							Если ИсключаемыеПоля.Найти("Основания" + РеквизитМД.Имя) <> Неопределено Тогда
								Продолжить;
							КонецЕсли;
							НоваяСтрокаОснования[РеквизитМД.Имя] = Выборка["Основания" + РеквизитМД.Имя];
						КонецЦикла;
					КонецЦикла;
					
					Если ЕстьОшибка Тогда
						Продолжить;
					КонецЕсли;
					
					//В случае когда документ не проводится, ошибку не фиксируем, 
					//т.к. сверка с отчетом брокера это выявит.
					Попытка
						ОплатаТорговойКомиссии.Записать(РежимЗаписиДокумента.Проведение);
						Обработано = Обработано + 1;						
					Исключение
						
						Попытка
							ОплатаТорговойКомиссии.Записать(РежимЗаписиДокумента.Запись);	
						Исключение
							ЗарегистрироватьОшибкуИмпорта("Не удалось записать оплату торговой комиссии " + ОплатаТорговойКомиссии
								+ ", организация: " + ЭтотОбъект.Организация + ", брокер: " + ВыборкаСчетДоверительногоУправления.Брокер
								+ ", место хранения: " + ВыборкаСчетДоверительногоУправления.МестоХранения
								+ ", счет д/у: " + ВыборкаСчетДоверительногоУправления.СчетДоверительногоУправления
								+ ". Система сообщает: " + ОписаниеОшибки());
						КонецПопытки;
							
					КонецПопытки;
					
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ДопПараметры.Вставить("ОплатаТорговойКомиссии", "Проведено " + Обработано + " док.");
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обработано оплат торговой комиссии: " + Обработано);
	КонецЕсли;
	
КонецПроцедуры // ИмпортироватьОтложеннуюОплатуТорговойКомиссии

////////////////////////////////////////////////////////////////////////////////
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ

Процедура ЗарегистрироватьОшибкуИмпорта(ТекстОшибки, ДополнитьТекстОшибкиСообщениями = Истина)
	
	Если ДополнитьТекстОшибкиСообщениями Тогда
		СообщенияПользователю = ПолучитьСообщенияПользователю(Истина);
		Если СообщенияПользователю.Количество() > 0 Тогда
		    ТекстОшибки = ТекстОшибки + Символы.ПС + "Сообщения пользователю:";
			Для каждого Сообщение Из СообщенияПользователю Цикл
				ТекстОшибки = ТекстОшибки + Символы.ПС + Символы.Таб + Сообщение.Текст + Символы.Таб + Сообщение.КлючДанных;
			КонецЦикла;
		Иначе
			ТекстОшибки = ТекстОшибки + Символы.ПС + "Сообщения пользователю не зарегистрированы";
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	
КонецПроцедуры // ЗарегистрироватьОшибкуИмпорта

Процедура ОповеститьОбОшибках(ЕстьОшибки = Неопределено)
	
	ЕстьОшибки = ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки");
	
	Если Не ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС + Символы.ПС));
	КонецЕсли;
	
КонецПроцедуры // ОповеститьОбОшибках

////////////////////////////////////////////////////////////////////////////////

ЭтотОбъект.ДополнительныеСвойства = Новый Структура;
