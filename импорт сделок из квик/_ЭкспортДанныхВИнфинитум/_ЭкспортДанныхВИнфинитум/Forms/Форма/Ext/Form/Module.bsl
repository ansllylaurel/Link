	Попытка
		ОбновитьНаСервере();
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		
КонецПроцедуры

&НаКлиенте
Процедура КомандаЭкспортировать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаЭкспортировать");
	Попытка
		ВыполнитьЭкспорт(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЭкспорт(ПараметрыСессии)
	
	// Проверяем подписанта и должность
	Если Не (ЗначениеЗаполнено(ЭтаФорма.Подписант) И ЗначениеЗаполнено(ЭтаФорма.ПодписантДолжность)) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо указать ответственного", , "Подписант");
	    ДобавитьТекстОшибки(ПараметрыСессии, "Не указан ответственный (Подписант)");
	    Возврат;
	КонецЕсли;
	
	// Проверяем каталог выгрузки	
	Отказ = Ложь;
	РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(Объект.КаталогФайлов, Отказ);
	
	Если Отказ Тогда
		Сообщить("Экспорт данных прерван");
		ДобавитьТекстОшибки(ПараметрыСессии, "Не пройдена проверка каталога выгрузки");
		Возврат;
	КонецЕсли;
	
	Успешно = Ложь;
	
	ОчиститьСообщения();
	
	МассивСчетовДУ = Новый Массив;
	
	Для Каждого Элемент Из ЭтаФорма.ФормыПервичныхДокументовСЭД Цикл
		
		Если Не ЭтаФорма[Элемент.Значение] Тогда
			Продолжить;
		КонецЕсли;
		
		ТекМакет = Неопределено;
		
		Если Элемент.Значение = "ФормаСЧА_РСА_20200401" Тогда
			ТекМакет = ПолучитьМакетСЧАИнфинитум(Объект.Период);
		ИначеЕсли Элемент.Значение = "ФормаУведомленийОРазмещенииДепозитов" 
			Или Элемент.Значение = "ФормаУведомленийОПереводахСоСчетовБрокера" Тогда
			
			ТекМакет = ПолучитьМакет("Уведомление"); 
		КонецЕсли;
		
		МассивСчетовДУ.Очистить(); 
		
		Для Каждого СтрокаАктивныеСчетаДоверительногоУправления Из ЭтаФорма.АктивныеСчетаДоверительногоУправления Цикл
			
			Если Не СтрокаАктивныеСчетаДоверительногоУправления.Флажок Тогда
				Продолжить;
			КонецЕсли;            			
		
			Если СтрокаАктивныеСчетаДоверительногоУправления[Элемент.Значение] Тогда
				МассивСчетовДУ.Добавить(СтрокаАктивныеСчетаДоверительногоУправления.СчетДоверительногоУправления);	
			КонецЕсли;
			
		КонецЦикла;
		
		Если МассивСчетовДУ.Количество() = 0 Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны счета ДУ для выгрузки формы '" + Элемент.Представление + "'");
			Продолжить;
		КонецЕсли;
				
		КаталогДаты = "\" + Формат(Объект.Период, "ДФ=yyyy.MM") + "\" + Формат(Объект.Период, "ДФ=yyyy.MM.dd") + "\"; 
		
		Если Элемент.Значение = "ФормаУведомленийОРазмещенииДепозитов" Тогда
			ТекКаталогФайлов = Объект.КаталогФайлов + "\" + "Уведомления_о_депозитах" + КаталогДаты;
		ИначеЕсли Элемент.Значение = "ФормаУведомленийОПереводахСоСчетовБрокера" Тогда
			ТекКаталогФайлов = Объект.КаталогФайлов + "\" + "Уведомления_о_переводах" + КаталогДаты;
		Иначе
			ТекКаталогФайлов = Объект.КаталогФайлов + "\" + "СЧА" + КаталогДаты;	
		КонецЕсли;
			
		Отказ = Ложь;
	    РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(ТекКаталогФайлов, Отказ);
		
		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
				
		Успешно = ПолучитьФорму("ВнешняяОбработка._ЭкспортДанныхВИнфинитум.Форма." + Элемент.Значение) 
					.СфомироватьДокументыСЭД(Объект.Организация, МассивСчетовДУ, Объект.Период, ТекКаталогФайлов, Подписант, ПодписантДолжность, ТекМакет);			
				
	КонецЦикла;
	
	Сообщить(?(Успешно, "Экспорт данных завершен", "Экспорт данных прерван"));
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМакет(ИмяМакета)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	Возврат ОбъектОбработки.ПолучитьМакет(ИмяМакета);
	
КонецФункции

&НаСервере
Функция ПолучитьМакетСЧАИнфинитум(Период)
	
	ИспользоватьФорматV10 = Обработки.ПечатьИВыгрузка_СЧА_РСА.Создать().ИспользоватьФорматСЧАv10Инфинитум(Период);
	
	Возврат ПолучитьМакет(?(ИспользоватьФорматV10, "SchemaV10", "Схема"));
	
КонецФункции

