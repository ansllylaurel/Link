&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.Период = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДата()), -2);
		
	ЭтаФорма.ЮрЛицоОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ЮрФизЛицо");
	
	УстановитьКаталогНаСервере();
		
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("ФормаСЧА", "Сверка СЧА (ПН, ПР)");
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("ФормаСЧА_РСА_20200401", "Сверка СЧА (ПН, ПР) в новом формате (xml)");
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("ФормаУведомленийОРазмещенииДепозитов", "Уведомления о размещении депозитов (xls)");
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("ФормаУведомленийОПереводахСоСчетовБрокера", "Уведомления о переводах (xls)");
		
	// создадим реквизиты формы
	НовыеРеквизитыФормы = Новый Массив;
	
	Для Каждого ФормаПервичныхДокументовСЭД Из ЭтаФорма.ФормыПервичныхДокументовСЭД Цикл
		
		Если ФормаПервичныхДокументовСЭД.Значение = "ФормаСЧА" Тогда 
			НаименованиеРеквизита = "СЧА (ПН, ПР)";
		ИначеЕсли ФормаПервичныхДокументовСЭД.Значение = "ФормаСЧА_РСА_20200401" Тогда 
			НаименованиеРеквизита = "СЧА (ПН, ПР) в новом формате (xml)"; //ФормаПервичныхДокументовСЭД.Значение;
		Иначе
			НаименованиеРеквизита = ФормаПервичныхДокументовСЭД.Представление;	
		КонецЕсли;
		
		НовыеРеквизитыФормы.Добавить(
			Новый РеквизитФормы(ФормаПервичныхДокументовСЭД.Значение, Новый ОписаниеТипов("Булево")));
		НовыеРеквизитыФормы.Добавить(
			Новый РеквизитФормы(ФормаПервичныхДокументовСЭД.Значение, Новый ОписаниеТипов("Булево"), "АктивныеСчетаДоверительногоУправления", НаименованиеРеквизита));
			
	КонецЦикла;
	
	ЭтаФорма.ИзменитьРеквизиты(НовыеРеквизитыФормы, Новый Массив);
	
	// создадим элементы управления, соотв. новым реквизитам формы
	Для каждого ФормаПервичныхДокументовСЭД Из ЭтаФорма.ФормыПервичныхДокументовСЭД Цикл
		
		Если ФормаПервичныхДокументовСЭД.Значение = "ФормаСЧА" Тогда 
			НаименованиеРеквизита = "СЧА (ПН, ПР)";
		ИначеЕсли ФормаПервичныхДокументовСЭД.Значение = "ФормаСЧА_РСА_20200401" Тогда 
			НаименованиеРеквизита = "СЧА (ПН, ПР) в новом формате (xml)";
		ИначеЕсли ФормаПервичныхДокументовСЭД.Значение = "ФормаУведомленийОРазмещенииДепозитов" Тогда
			НаименованиеРеквизита = "Депозиты (xls)";
		ИначеЕсли ФормаПервичныхДокументовСЭД.Значение = "ФормаУведомленийОПереводахСоСчетовБрокера" Тогда
			НаименованиеРеквизита = "Переводы (xls)";
		Иначе
			НаименованиеРеквизита = ФормаПервичныхДокументовСЭД.Представление;		
		КонецЕсли;

		ПолеФлажкаФормы = Элементы.Добавить(ФормаПервичныхДокументовСЭД.Значение, Тип("ПолеФормы"), Элементы.ГруппаФормы);
		ПолеФлажкаФормы.Вид                = ВидПоляФормы.ПолеФлажка;
		ПолеФлажкаФормы.ПутьКДанным        = ФормаПервичныхДокументовСЭД.Значение;
		ПолеФлажкаФормы.Заголовок          = ФормаПервичныхДокументовСЭД.Представление;
		ПолеФлажкаФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		
		ПолеФлажкаФормы.УстановитьДействие("ПриИзменении", "Подключаемый_ФлажкиФормПриИзменении");
		
		ПолеФлажкаТаблицы = Элементы.Вставить("АктивныеСчетаДоверительногоУправления" + ФормаПервичныхДокументовСЭД.Значение, Тип("ПолеФормы"), Элементы.АктивныеСчетаДоверительногоУправления, Элементы.АктивныеСчетаДоверительногоУправленияФлажок);
		ПолеФлажкаТаблицы.Вид                = ВидПоляФормы.ПолеФлажка;
		ПолеФлажкаТаблицы.ПутьКДанным        = "АктивныеСчетаДоверительногоУправления." + ФормаПервичныхДокументовСЭД.Значение;
		ПолеФлажкаТаблицы.Заголовок          = НаименованиеРеквизита;
		ПолеФлажкаТаблицы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		ПолеФлажкаТаблицы.ТолькоПросмотр     = Истина;
		
		ЭтаФорма[ФормаПервичныхДокументовСЭД.Значение] = ?(ФормаПервичныхДокументовСЭД.Значение = "ФормаСЧА", Истина, Ложь);
				
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьАктивныеСчетаДоверительногоУправления()
	
	Если ЭтаФорма.ФормаУведомленийОРазмещенииДепозитов Тогда 
		ЭтаФорма.ФормаУведомленийОРазмещенииДепозитов = (Объект.Период = НачалоДня(ТекущаяДатаСеанса()));	
	Конецесли; 
	
	Если ЭтаФорма.ФормаУведомленийОПереводахСоСчетовБрокера Тогда
		ЭтаФорма.ФормаУведомленийОПереводахСоСчетовБрокера = (Объект.Период = НачалоДня(ТекущаяДатаСеанса()));	
	Конецесли;
	
	ЭтаФорма.АктивныеСчетаДоверительногоУправления.Очистить();

	Запрос = Новый Запрос;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаСпецДепаИнфинитум
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В(&СписокВидовДоговоров)
		|	И СчетаДоверительногоУправления.СпециализированныйДепозитарий = &Инфинитум
		|	И (СчетаДоверительногоУправления.ДатаРасторжения >= &Период
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИСТИНА КАК Флажок,
		|	МАКСИМУМ(ВложенныйЗапрос.ФормаСЧА) КАК ФормаСЧА,
		|	МАКСИМУМ(ВложенныйЗапрос.ФормаСЧА_РСА_20200401) КАК ФормаСЧА_РСА_20200401,
		|	МАКСИМУМ(ВложенныйЗапрос.ФормаУведомленийОРазмещенииДепозитов) КАК ФормаУведомленийОРазмещенииДепозитов,
		|	МАКСИМУМ(ВложенныйЗапрос.ФормаУведомленийОПереводахСоСчетовБрокера) КАК ФормаУведомленийОПереводахСоСчетовБрокера,
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		&ФормаСЧА КАК ФормаСЧА,
		|		ЛОЖЬ КАК ФормаСЧА_РСА_20200401,
		|		ЛОЖЬ КАК ФормаУведомленийОРазмещенииДепозитов,
		|		ЛОЖЬ КАК ФормаУведомленийОПереводахСоСчетовБрокера,
		|		_СчетаСпецДепаИнфинитум.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|	ИЗ
		|		_СчетаСпецДепаИнфинитум КАК _СчетаСпецДепаИнфинитум
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		ЛОЖЬ,
		|		НЕ ЗначенияДополнительныхСведений.Объект ЕСТЬ NULL,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		_СчетаСпецДепаИнфинитум.СчетДоверительногоУправления
		|	ИЗ
		|		_СчетаСпецДепаИнфинитум КАК _СчетаСпецДепаИнфинитум
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|			ПО (&ФормаСЧА_РСА_20200401)
		|				И _СчетаСпецДепаИнфинитум.СчетДоверительногоУправления = ЗначенияДополнительныхСведений.Объект
		|				И (ЗначенияДополнительныхСведений.Свойство.Ключ = ""ВнешняяОбработка._ЭкспортДанныхВСЭДИНФИНИТУМ.ИнвестСчет"")
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		НЕ Распоряжение.Ссылка ЕСТЬ NULL,
		|		ЛОЖЬ,
		|		_СчетаСпецДепаИнфинитум.СчетДоверительногоУправления
		|	ИЗ
		|		_СчетаСпецДепаИнфинитум КАК _СчетаСпецДепаИнфинитум
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Распоряжение КАК Распоряжение
		|			ПО (&ФормаУведомленийОРазмещенииДепозитов)
		|				И _СчетаСпецДепаИнфинитум.СчетДоверительногоУправления = Распоряжение.СчетДоверительногоУправления
		|				И (НАЧАЛОПЕРИОДА(Распоряжение.ДатаРазмещения, ДЕНЬ) = &Период)
		|				И (Распоряжение.Организация = &Организация)
		|				И (Распоряжение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента))
		|				И (НЕ Распоряжение.ПометкаУдаления)
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ИСТИНА,
		|		_СчетаСпецДепаИнфинитум.СчетДоверительногоУправления
		|	ИЗ
		|		_СчетаСпецДепаИнфинитум КАК _СчетаСпецДепаИнфинитум
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоручениеНаПереводДенежныхСредств КАК ДокПоручение
		|			ПО (&ФормаУведомленийОПереводахСоСчетовБрокера)
		|				И _СчетаСпецДепаИнфинитум.СчетДоверительногоУправления = ДокПоручение.СчетДоверительногоУправления
		|				И (ДокПоручение.Организация = &Организация)
		|				И (НАЧАЛОПЕРИОДА(ДокПоручение.Дата, ДЕНЬ) = &Период)
		|				И (ДокПоручение.Проведен)
		|				И (ДокПоручение.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка))
		|				И (ДокПоручение.БрокерПолучатель = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка))
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиАкцептованияОпераций.СрезПоследних КАК НастройкиАкцептованияОперацийСрезПоследних
		|			ПО (ДокПоручение.Организация = НастройкиАкцептованияОперацийСрезПоследних.Организация)
		|				И (ДокПоручение.СчетДоверительногоУправления = НастройкиАкцептованияОперацийСрезПоследних.СчетДоверительногоУправления)
		|				И (НастройкиАкцептованияОперацийСрезПоследних.ВидАкцепта = ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.ПереводСБрокерскогоСчетаНаРасчетный))
		|	ГДЕ
		|		ЕСТЬNULL(НастройкиАкцептованияОперацийСрезПоследних.ТребуетсяАкцептование, ЛОЖЬ)) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.СчетДоверительногоУправления
		|
		|ИМЕЮЩИЕ
		|	(МАКСИМУМ(ВложенныйЗапрос.ФормаСЧА) = ИСТИНА
		|		ИЛИ МАКСИМУМ(ВложенныйЗапрос.ФормаСЧА_РСА_20200401) = ИСТИНА
		|		ИЛИ МАКСИМУМ(ВложенныйЗапрос.ФормаУведомленийОРазмещенииДепозитов) = ИСТИНА
		|		ИЛИ МАКСИМУМ(ВложенныйЗапрос.ФормаУведомленийОПереводахСоСчетовБрокера) = ИСТИНА)";
#КонецОбласти
	
	СписокВидовДоговоров = Новый Массив;
	СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями);
	СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Инфинитум", ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_Инфинитум"));
	Запрос.УстановитьПараметр("СписокВидовДоговоров", СписокВидовДоговоров);
	Запрос.УстановитьПараметр("Период", Объект.Период);
	
	Запрос.УстановитьПараметр("ФормаСЧА", ЭтаФорма.ФормаСЧА);
	Запрос.УстановитьПараметр("ФормаСЧА_РСА_20200401", ЭтаФорма.ФормаСЧА_РСА_20200401);
	Запрос.УстановитьПараметр("ФормаУведомленийОРазмещенииДепозитов", ЭтаФорма.ФормаУведомленийОРазмещенииДепозитов);
	Запрос.УстановитьПараметр("ФормаУведомленийОПереводахСоСчетовБрокера", ЭтаФорма.ФормаУведомленийОПереводахСоСчетовБрокера);
	
	ЭтаФорма.АктивныеСчетаДоверительногоУправления.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ЭтаФорма.АктивныеСчетаДоверительногоУправления.Сортировать("СчетДоверительногоУправления");
			
КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере(УстановитьКаталог = Ложь)
			
	ОбновитьАктивныеСчетаДоверительногоУправления();
	
	Если УстановитьКаталог Тогда
		УстановитьКаталогНаСервере(); 	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ФлажкиФормПриИзменении(Элемент)
	
	ТекНачалоДня = НачалоДня(ТекущаяДата());
	
	Если Элемент.Имя = "ФормаУведомленийОРазмещенииДепозитов" Или Элемент.Имя = "ФормаУведомленийОПереводахСоСчетовБрокера" Тогда
		
		Если (ЭтаФорма["ФормаУведомленийОРазмещенииДепозитов"] Или ЭтаФорма["ФормаУведомленийОПереводахСоСчетовБрокера"])
			И Объект.Период <> ТекНачалоДня Тогда
		
			ВидУведомлений = "Уведомления о " + ?(ЭтаФорма["ФормаУведомленийОРазмещенииДепозитов"], "размещении депозитов", "переводах со счетов брокера"); 
			Если Вопрос(ВидУведомлений + " должны формироваться в текущем дне. Установить для периода значение [" + Формат(ТекНачалоДня, "ДФ=dd.MM.yyyy") + "]?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда	
				
				Объект.Период = ТекНачалоДня;
				ЭтаФорма["ФормаСЧА"] = Ложь;
				ЭтаФорма["ФормаСЧА_РСА_20200401"] = Ложь;

			Иначе
				
				ЭтаФорма["ФормаУведомленийОРазмещенииДепозитов"] = Ложь;
				ЭтаФорма["ФормаУведомленийОПереводахСоСчетовБрокера"] = Ложь;
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ЭтаФорма[Элемент.Имя] = Истина Тогда
		
		ЭтаФорма["ФормаУведомленийОРазмещенииДепозитов"] = Ложь;
		ЭтаФорма["ФормаУведомленийОПереводахСоСчетовБрокера"] = Ложь;
	
	КонецЕсли;
	
	КомандаОбновить(Неопределено);
	
	НастроитьВидимостьИДоступность();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьКаталогНаСервере()
	    	
	Если ОбщегоНазначения.ЗначениеПараметраСеанса("ЭтоРабочаяИнформационнаяБаза") Тогда
