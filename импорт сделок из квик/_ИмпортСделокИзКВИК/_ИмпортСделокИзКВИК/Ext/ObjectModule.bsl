Процедура ВывестиТаблицуЗначенийВТабличныйДокумент(ДокументРезультат, Данные, ИмяТаблицы, ПараметрыОформления, СворачиватьГруппыСтрок, ШириныКолонок)
	// Получаем описание колонок таблицы
	СтруктураТаблицы = Новый Структура;
	Для Каждого Колонка Из Данные.Колонки Цикл
		СтруктураТаблицы.Вставить(Колонка.Имя, ?(ЗначениеЗаполнено(Колонка.Заголовок), Колонка.Заголовок, Колонка.Имя)); 			
	КонецЦикла;

	// Выводим в табличный документ
	РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(
		ДокументРезультат,
		Данные,
		СтруктураТаблицы,
		ПараметрыОформления,
		ИмяТаблицы,
		СворачиватьГруппыСтрок,
		Истина
	);

	// Фиксируем максимальные ширины колонок
	Если Не СворачиватьГруппыСтрок Тогда 
		ВсегоКолонок = 0; 
		Для Каждого ШиринаКолонки Из СтруктураТаблицы Цикл
			ШириныКолонок.Вставить(ВсегоКолонок, ?(ШириныКолонок[ВсегоКолонок] = Неопределено, ШиринаКолонки.Значение, Макс(ШириныКолонок[ВсегоКолонок], ШиринаКолонки.Значение))); 		
			ВсегоКолонок = ВсегоКолонок + 1;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

