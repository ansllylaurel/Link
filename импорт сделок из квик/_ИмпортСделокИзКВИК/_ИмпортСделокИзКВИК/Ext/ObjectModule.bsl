		|		ПО (Сделка.ВидСделки = _СделкиКВИК.ВидСделки)
		|			И (Сделка.НомерСделки = _СделкиКВИК.НомерСделки
		|				ИЛИ _СделкиКВИК.СделкаСЦентральнымКонтрагентом
		|					И Сделка.НомерСделкиСЦентральнымКонтрагентом = _СделкиКВИК.НомерСделкиСЦентральнымКонтрагентом
		|					И Сделка.ЧастьСделкиРЕПО = _СделкиКВИК.ЧастьСделкиРЕПО)
		|			И СделкаЦенныеБумаги.НомерСтроки = _СделкиКВИК.ЦенныеБумагиНомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИмпортируемыеСделки.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
		|	_ИмпортируемыеСделки.НомерСделки КАК НомерСделки,
		|	NULL КАК Документ,
		|	СУММА(1) КАК Количество
		|ПОМЕСТИТЬ _ОшибкиИмпортируемыхСделокРЕПО
		|ИЗ
		|	_ИмпортируемыеСделки КАК _ИмпортируемыеСделки
		|ГДЕ
		|	_ИмпортируемыеСделки.НомерСделки <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	_ИмпортируемыеСделки.ЧастьСделкиРЕПО,
		|	_ИмпортируемыеСделки.НомерСделки,
		|	_ИмпортируемыеСделки.Документ
		|
		|ИМЕЮЩИЕ
		|	СУММА(1) > 1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ИмпортируемыеСделки.ЧастьСделкиРЕПО,
		|	_ИмпортируемыеСделки.НомерСделки,
		|	_ИмпортируемыеСделки.Документ,
		|	1
		|ИЗ
		|	_ИмпортируемыеСделки КАК _ИмпортируемыеСделки
		|ГДЕ
		|	_ИмпортируемыеСделки.НомерСделки = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Звездочка КАК Звездочка
		|ИЗ
		|	_ИмпортируемыеСделки КАК _ИмпортируемыеСделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиИмпортируемыхСделокРЕПО КАК _ОшибкиИмпортируемыхСделокРЕПО
		|		ПО (ЕСТЬNULL(_ИмпортируемыеСделки.ЧастьСделкиРЕПО, """") = ЕСТЬNULL(_ОшибкиИмпортируемыхСделокРЕПО.ЧастьСделкиРЕПО, """"))
		|			И _ИмпортируемыеСделки.НомерСделки = _ОшибкиИмпортируемыхСделокРЕПО.НомерСделки
		|ГДЕ
		|	&ЕстьРасхождения
		|	И _ОшибкиИмпортируемыхСделокРЕПО.НомерСделки ЕСТЬ NULL"
		+
		"
		|УПОРЯДОЧИТЬ ПО
		|	НовНомерСделки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _СделкиРЕПО_1С
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _СделкиРЕПО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _СделкиКВИК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ИмпортируемыеСделки";
	#КонецОбласти
	ДополнитьТекстЗапросаТекущимиИНовымиРеквизитами(Запрос.Текст, Метаданные.Документы.СделкаРЕПО,
		"ПортфельКонтрагента, НомерДоговораКонтрагента, Ответственный, Комментарий, Договор, ПлатежноеУсловиеСделки, НомерПорученияУБрокера, ДатаПорученияУБрокера, "
			+ "ЦенныеБумаги.Портфель, ЦенныеБумаги.СтрокаПартии, ЦенныеБумагиВторойЧасти.Портфель",
		"МестоХранения, ЦенныеБумаги.ДепозитарныйСчет, ЦенныеБумагиВторойЧасти.ДепозитарныйСчет", "");
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВалютаУчета", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета"));
	Запрос.УстановитьПараметр("Брокер", Брокер);
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.ДатаИмпорта);
	Запрос.УстановитьПараметр("ЧастьСделкиРепо", ЧастьСделкиРепо);
	
	// Для сделок с центральным контрагентом КВИК присылает пустой PartnerOrganization, который мы
	//	пишем в контрагента на бирже. Однако на самом деле там должен стоять "НКО НКЦ (АО)"
	//	и отчет брокера это подтверждает
	Запрос.УстановитьПараметр("НкоНкц", ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЕстьРасхождения", ?(ЭтотОбъект.ОтображатьТолькоРасхождения, "ЕстьРасхождения", "Истина"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");
	
	ИмпортируемыеДанные = Запрос.Выполнить().Выгрузить();
	
	ДублиСделокРЕПО = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДублиСделокРЕПО_1С"].ПолучитьДанные().Выбрать();
	
	Пока ДублиСделокРЕПО.Следующий() Цикл
		ЗарегистрироватьОшибкуИмпорта("В базе обнаружены дубли сделок Репо. У " + Строка(ДублиСделокРЕПО.Количество) + " сделок Репо [" + ДублиСделокРЕПО.ЧастьСделкиРЕПО + "-ая часть] одинаковый номер [" + ДублиСделокРЕПО.НомерСделки + "].");
	КонецЦикла;
	
	ОшибкиИмпортируемыхСделокРЕПО = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиИмпортируемыхСделокРЕПО"].ПолучитьДанные().Выбрать();
	
	Пока ОшибкиИмпортируемыхСделокРЕПО.Следующий() Цикл
		Если ОшибкиИмпортируемыхСделокРЕПО.НомерСделки = 0 Тогда
			ЗарегистрироватьОшибкуИмпорта("В 1С обнаружена сделка РЕПО [" + ОшибкиИмпортируемыхСделокРЕПО.Документ + "], для которой не удалось определить документ основание из данных QUIKа. Проверьте вывод данных (ODBC) из QUIKа.");
		Иначе
			ЗарегистрироватьОшибкуИмпорта("Сделка РЕПО [" + ОшибкиИмпортируемыхСделокРЕПО.НомерСделки + "] [" + ОшибкиИмпортируемыхСделокРЕПО.ЧастьСделкиРЕПО + " - ая часть] не будет загружена, т.к. при формировании данных для загрузки обнаружено несколько записей [" + Строка(ОшибкиИмпортируемыхСделокРЕПО.Количество) + "].");
		КонецЕсли;
	КонецЦикла;
	
	УдалитьВременныеТаблицы("СделкаРЕПО", МВТ);
	
	Если ДублиСделокРЕПО.Количество() > 0 Или ОшибкиИмпортируемыхСделокРЕПО.Количество() > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПроверитьЗаполнениеИмпортируемыхСделок(ИмпортируемыеДанные, Истина, "СделкаРЕПО");
	
	Возврат ИмпортируемыеДанные;
КонецФункции

Функция ИмпортироватьСделкиСВалютой(Брокер, МВТ)
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаСВалютой.Ссылка КАК Ссылка,
		|	СделкаСВалютой.НомерСделки КАК НомерСделки,
		|	СделкаСВалютой.ВерсияДанных КАК ВерсияДанных,
		|	СделкаСВалютой.ПометкаУдаления КАК ПометкаУдаления,
		|	СделкаСВалютой.Номер КАК Номер,
		|	СделкаСВалютой.Дата КАК Дата,
		|	СделкаСВалютой.Проведен КАК Проведен,
		|	СделкаСВалютой.Организация КАК Организация,
		|	СделкаСВалютой.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СделкаСВалютой.ВидСделки КАК ВидСделки,
		|	СделкаСВалютой.ТипСделки КАК ТипСделки,
		|	СделкаСВалютой.Основание КАК Основание,
		|	СделкаСВалютой.МестоХранения КАК МестоХранения,
		|	СделкаСВалютой.Брокер КАК Брокер,
		|	СделкаСВалютой.РасчетныйСчет КАК РасчетныйСчет,
		|	СделкаСВалютой.РасчетныйСчетКонтрвалюты КАК РасчетныйСчетКонтрвалюты,
		|	СделкаСВалютой.Валюта КАК Валюта,
		|	СделкаСВалютой.Контрвалюта КАК Контрвалюта,
		|	СделкаСВалютой.Курс КАК Курс,
		|	СделкаСВалютой.Сумма КАК Сумма,
		|	СделкаСВалютой.СуммаКонтрвалюты КАК СуммаКонтрвалюты,
		|	СделкаСВалютой.ВалютаКомиссии КАК ВалютаКомиссии,
		|	СделкаСВалютой.СуммаКомиссии КАК СуммаКомиссии,
		|	СделкаСВалютой.ОтложенноеИсполнение КАК ОтложенноеИсполнение,
		|	СделкаСВалютой.ДатаИсполнения КАК ДатаИсполнения,
		|	СделкаСВалютой.ОтложеннаяОплатаКомиссии КАК ОтложеннаяОплатаКомиссии,
		|	СделкаСВалютой.ДатаОплатыКомиссии КАК ДатаОплатыКомиссии,
		|	СделкаСВалютой.НомерПодтверждения КАК НомерПодтверждения
		|ПОМЕСТИТЬ _СделкиСВалютой_1С
		|ИЗ
		|	Документ.СделкаСВалютой КАК СделкаСВалютой
		|ГДЕ
		|	СделкаСВалютой.Организация = &Организация
		|	И СделкаСВалютой.Брокер = &Брокер
		|	И СделкаСВалютой.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И СделкаСВалютой.МестоХранения = &МестоХранения_FX
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _СделкиСВалютой_1С.Ссылка) КАК Количество,
		|	_СделкиСВалютой_1С.НомерСделки КАК НомерСделки,
		|	_СделкиСВалютой_1С.ВидСделки КАК ВидСделки
		|ПОМЕСТИТЬ _ДублиСделокСВалютой_1С
		|ИЗ
		|	_СделкиСВалютой_1С КАК _СделкиСВалютой_1С
		|
		|СГРУППИРОВАТЬ ПО
		|	_СделкиСВалютой_1С.НомерСделки,
		|	_СделкиСВалютой_1С.ВидСделки
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _СделкиСВалютой_1С.Ссылка) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВнешниеДанные.DealNumber КАК НомерСделки,
		|	_ВнешниеДанные.DealDate КАК Дата,
		|	ИСТИНА КАК Проведен,
		|	ЛОЖЬ КАК ПометкаУдаления,
		|	_ВнешниеДанные.ВидСделки КАК ВидСделки,
		|	ЗНАЧЕНИЕ(Перечисление.ТипыСделокСВалютой.Конверсионная) КАК ТипСделки,
		|	_СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	&Брокер КАК Брокер,
		|	&Организация КАК Организация,
		|	ЗНАЧЕНИЕ(Документ.СделкаСВалютой.ПустаяСсылка) КАК Основание,
		|	&МестоХранения_FX КАК МестоХранения,
		|	_ВнешниеДанные.PaymentCode КАК PaymentCode,
		|	_ВнешниеДанные.RepaymentDate КАК ДатаИсполнения,
		|	ВЫБОР
		|		КОГДА НАЧАЛОПЕРИОДА(_ВнешниеДанные.DealDate, ДЕНЬ) <> _ВнешниеДанные.RepaymentDate
		|				И _ВнешниеДанные.RepaymentDate <> ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОтложенноеИсполнение,
		|	_Валюты.Ссылка КАК Валюта,
		|	_КонтрВалюты.Ссылка КАК Контрвалюта,
		|	_ВнешниеДанные.Quantity * _ВнешниеДанные.P_LotSize КАК Сумма,
		|	_ВнешниеДанные.P_LotSize КАК P_LotSize,
		|	_ВнешниеДанные.Price КАК Курс,
		|	_ВнешниеДанные.Volume КАК СуммаКонтрвалюты,
		|	ЕСТЬNULL(_ВнешниеДанные.Comission, 0) КАК СуммаКомиссии,
		|	ЛОЖЬ КАК ОтложеннаяОплатаКомиссии,
		|	&ВалютаУчета КАК ВалютаКомиссии,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаОплатыКомиссии,
		|	_ВнешниеДанные.InstrumentClassCode КАК InstrumentClassCode,
		|	_ВнешниеДанные.InstrumentCode КАК InstrumentCode
		|ПОМЕСТИТЬ _СделкиСВалютой_QUIK
		|ИЗ
		|	_ВнешниеДанные КАК _ВнешниеДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ПО _ВнешниеДанные.Client = _СчетаДоверительногоУправления.Client
		|			И _ВнешниеДанные.Briefcase = _СчетаДоверительногоУправления.Briefcase
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Валюты КАК _Валюты
		|		ПО _ВнешниеДанные.Currency = _Валюты.Currency
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КонтрВалюты КАК _КонтрВалюты
		|		ПО _ВнешниеДанные.CounterCurrency = _КонтрВалюты.Currency
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СделкиСВалютой_1С.Ссылка КАК Документ,
		|	_СделкиСВалютой_1С.НомерСделки КАК ТекНомерСделки,
		|	_СделкиСВалютой_QUIK.НомерСделки КАК НовНомерСделки,
		|	_СделкиСВалютой_1С.ПометкаУдаления КАК ТекПометкаУдаления,
		|	_СделкиСВалютой_QUIK.ПометкаУдаления КАК НовПометкаУдаления,
		|	_СделкиСВалютой_1С.Дата КАК ТекДата,
		|	_СделкиСВалютой_QUIK.Дата КАК НовДата,
		|	_СделкиСВалютой_1С.Проведен КАК ТекПроведен,
		|	_СделкиСВалютой_QUIK.Проведен КАК НовПроведен,
		|	_СделкиСВалютой_1С.Организация КАК ТекОрганизация,
		|	_СделкиСВалютой_QUIK.Организация КАК НовОрганизация,
		|	_СделкиСВалютой_1С.СчетДоверительногоУправления КАК ТекСчетДоверительногоУправления,
		|	_СделкиСВалютой_QUIK.СчетДоверительногоУправления КАК НовСчетДоверительногоУправления,
		|	_СделкиСВалютой_1С.ВидСделки КАК ТекВидСделки,
		|	_СделкиСВалютой_QUIK.ВидСделки КАК НовВидСделки,
		|	_СделкиСВалютой_1С.ТипСделки КАК ТекТипСделки,
		|	_СделкиСВалютой_QUIK.ТипСделки КАК НовТипСделки,
		|	_СделкиСВалютой_1С.Основание КАК ТекОснование,
		|	_СделкиСВалютой_QUIK.Основание КАК НовОснование,
		|	_СделкиСВалютой_1С.МестоХранения КАК ТекМестоХранения,
		|	_СделкиСВалютой_QUIK.МестоХранения КАК НовМестоХранения,
		|	_СделкиСВалютой_1С.Брокер КАК ТекБрокер,
		|	_СделкиСВалютой_QUIK.Брокер КАК НовБрокер,
		|	_СделкиСВалютой_1С.Валюта КАК ТекВалюта,
		|	_СделкиСВалютой_QUIK.Валюта КАК НовВалюта,
		|	_СделкиСВалютой_1С.Контрвалюта КАК ТекКонтрвалюта,
		|	_СделкиСВалютой_QUIK.Контрвалюта КАК НовКонтрвалюта,
		|	_СделкиСВалютой_1С.Курс КАК ТекКурс,
		|	_СделкиСВалютой_QUIK.Курс КАК НовКурс,
		|	_СделкиСВалютой_1С.Сумма КАК ТекСумма,
		|	_СделкиСВалютой_QUIK.Сумма КАК НовСумма,
		|	_СделкиСВалютой_1С.СуммаКонтрвалюты КАК ТекСуммаКонтрвалюты,
		|	_СделкиСВалютой_QUIK.СуммаКонтрвалюты КАК НовСуммаКонтрвалюты,
		|	_СделкиСВалютой_1С.ВалютаКомиссии КАК ТекВалютаКомиссии,
		|	_СделкиСВалютой_QUIK.ВалютаКомиссии КАК НовВалютаКомиссии,
		|	_СделкиСВалютой_1С.СуммаКомиссии КАК ТекСуммаКомиссии,
		|	_СделкиСВалютой_QUIK.СуммаКомиссии КАК НовСуммаКомиссии,
		|	_СделкиСВалютой_1С.ОтложенноеИсполнение КАК ТекОтложенноеИсполнение,
		|	_СделкиСВалютой_QUIK.ОтложенноеИсполнение КАК НовОтложенноеИсполнение,
		|	_СделкиСВалютой_1С.ДатаИсполнения КАК ТекДатаИсполнения,
		|	_СделкиСВалютой_QUIK.ДатаИсполнения КАК НовДатаИсполнения,
		|	_СделкиСВалютой_1С.ОтложеннаяОплатаКомиссии КАК ТекОтложеннаяОплатаКомиссии,
		|	_СделкиСВалютой_QUIK.ОтложеннаяОплатаКомиссии КАК НовОтложеннаяОплатаКомиссии,
		|	_СделкиСВалютой_1С.ДатаОплатыКомиссии КАК ТекДатаОплатыКомиссии,
		|	_СделкиСВалютой_QUIK.ДатаОплатыКомиссии КАК НовДатаОплатыКомиссии,
		|	_СделкиСВалютой_QUIK.InstrumentClassCode КАК InstrumentClassCode,
		|	_СделкиСВалютой_QUIK.InstrumentCode КАК InstrumentCode,
		|	ЕСТЬNULL(_СделкиСВалютой_QUIK.НомерСделки, 0) КАК НомерСделки,
		|	_СделкиСВалютой_QUIK.ВидСделки КАК ВидСделки,
		|	ВЫБОР
		|		КОГДА _СделкиСВалютой_1С.Ссылка ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЭтоНовыйДокумент,
		|	ВЫБОР
		|		КОГДА _СделкиСВалютой_1С.Ссылка ЕСТЬ NULL
		|				ИЛИ _СделкиСВалютой_1С.ПометкаУдаления <> _СделкиСВалютой_QUIK.ПометкаУдаления
		|				ИЛИ _СделкиСВалютой_1С.Дата <> _СделкиСВалютой_QUIK.Дата
		|				ИЛИ _СделкиСВалютой_1С.Проведен <> _СделкиСВалютой_QUIK.Проведен
		|				ИЛИ _СделкиСВалютой_1С.Организация <> _СделкиСВалютой_QUIK.Организация
		|				ИЛИ _СделкиСВалютой_1С.СчетДоверительногоУправления <> _СделкиСВалютой_QUIK.СчетДоверительногоУправления
		|				ИЛИ _СделкиСВалютой_1С.ВидСделки <> _СделкиСВалютой_QUIK.ВидСделки
		|				ИЛИ _СделкиСВалютой_1С.ТипСделки <> _СделкиСВалютой_QUIK.ТипСделки
		|				ИЛИ _СделкиСВалютой_1С.Основание <> _СделкиСВалютой_QUIK.Основание
		|				ИЛИ _СделкиСВалютой_1С.МестоХранения <> _СделкиСВалютой_QUIK.МестоХранения
		|				ИЛИ _СделкиСВалютой_1С.Брокер <> _СделкиСВалютой_QUIK.Брокер
		|				ИЛИ _СделкиСВалютой_1С.Валюта <> _СделкиСВалютой_QUIK.Валюта
		|				ИЛИ _СделкиСВалютой_1С.Контрвалюта <> _СделкиСВалютой_QUIK.Контрвалюта
		|				ИЛИ _СделкиСВалютой_1С.Курс <> _СделкиСВалютой_QUIK.Курс
		|				ИЛИ _СделкиСВалютой_1С.Сумма <> _СделкиСВалютой_QUIK.Сумма
		|				ИЛИ _СделкиСВалютой_1С.СуммаКонтрвалюты <> _СделкиСВалютой_QUIK.СуммаКонтрвалюты
		|				ИЛИ _СделкиСВалютой_1С.ВалютаКомиссии <> _СделкиСВалютой_QUIK.ВалютаКомиссии
		|				ИЛИ _СделкиСВалютой_1С.СуммаКомиссии <> _СделкиСВалютой_QUIK.СуммаКомиссии
		|				ИЛИ _СделкиСВалютой_1С.ОтложенноеИсполнение <> _СделкиСВалютой_QUIK.ОтложенноеИсполнение
		|				ИЛИ _СделкиСВалютой_1С.ДатаИсполнения <> _СделкиСВалютой_QUIK.ДатаИсполнения
		|				ИЛИ _СделкиСВалютой_1С.ОтложеннаяОплатаКомиссии <> _СделкиСВалютой_QUIK.ОтложеннаяОплатаКомиссии
		|				ИЛИ _СделкиСВалютой_1С.ДатаОплатыКомиссии <> _СделкиСВалютой_QUIK.ДатаОплатыКомиссии
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьРасхождения
		|ПОМЕСТИТЬ _ИмпортируемыеСделки
		|ИЗ
		|	_СделкиСВалютой_1С КАК _СделкиСВалютой_1С
		|		ПОЛНОЕ СОЕДИНЕНИЕ _СделкиСВалютой_QUIK КАК _СделкиСВалютой_QUIK
		|		ПО _СделкиСВалютой_1С.НомерСделки = _СделкиСВалютой_QUIK.НомерСделки
		|			И _СделкиСВалютой_1С.ВидСделки = _СделкиСВалютой_QUIK.ВидСделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДублиСделокСВалютой_1С КАК _ДублиСделокСВалютой_1С
		|		ПО _СделкиСВалютой_1С.НомерСделки = _ДублиСделокСВалютой_1С.НомерСделки
		|			И _СделкиСВалютой_1С.ВидСделки = _ДублиСделокСВалютой_1С.ВидСделки
		|ГДЕ
		|	_ДублиСделокСВалютой_1С.НомерСделки ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИмпортируемыеСделки.ВидСделки КАК ВидСделки,
		|	_ИмпортируемыеСделки.НомерСделки КАК НомерСделки,
		|	_ИмпортируемыеСделки.Документ КАК Документ,
		|	СУММА(1) КАК Количество
		|ПОМЕСТИТЬ _ОшибкиИмпортируемыхСделокСВалютой
		|ИЗ
		|	_ИмпортируемыеСделки КАК _ИмпортируемыеСделки
		|ГДЕ
		|	_ИмпортируемыеСделки.НомерСделки <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	_ИмпортируемыеСделки.ВидСделки,
		|	_ИмпортируемыеСделки.НомерСделки,
		|	_ИмпортируемыеСделки.Документ
		|
		|ИМЕЮЩИЕ
		|	СУММА(1) > 1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ИмпортируемыеСделки.ВидСделки,
		|	_ИмпортируемыеСделки.НомерСделки,
		|	_ИмпортируемыеСделки.Документ,
		|	1
		|ИЗ
		|	_ИмпортируемыеСделки КАК _ИмпортируемыеСделки
		|ГДЕ
		|	_ИмпортируемыеСделки.НомерСделки = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	*
		|ИЗ
		|	_ИмпортируемыеСделки КАК _ИмпортируемыеСделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиИмпортируемыхСделокСВалютой КАК _ОшибкиИмпортируемыхСделокСВалютой
		|		ПО (ЕСТЬNULL(_ИмпортируемыеСделки.ВидСделки, """") = ЕСТЬNULL(_ОшибкиИмпортируемыхСделокСВалютой.ВидСделки, """"))
		|			И _ИмпортируемыеСделки.НомерСделки = _ОшибкиИмпортируемыхСделокСВалютой.НомерСделки
		|ГДЕ
		|	&ЕстьРасхождения
		|	И _ОшибкиИмпортируемыхСделокСВалютой.НомерСделки ЕСТЬ NULL"
		+
		"
		|УПОРЯДОЧИТЬ ПО
		|	НовНомерСделки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _СделкиСВалютой_1С
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _СделкиСВалютой_QUIK
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ИмпортируемыеСделки";		
#КонецОбласти
	
	Запрос.УстановитьПараметр("Брокер", Брокер);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВалютаУчета", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета"));
	Запрос.УстановитьПараметр("МестоХранения_FX", ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС_раздел_FX"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЕстьРасхождения", ?(ЭтотОбъект.ОтображатьТолькоРасхождения, "ЕстьРасхождения", "Истина"));
	
	ИмпортируемыеДанные = Запрос.Выполнить().Выгрузить();

	ДублиСделокСВалютой = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДублиСделокСВалютой_1С"].ПолучитьДанные().Выбрать();
	
	Пока ДублиСделокСВалютой.Следующий() Цикл
		ЗарегистрироватьОшибкуИмпорта("В базе обнаружены дубли сделок с валютой. У [" + ДублиСделокСВалютой.НомерСделки + "] сделок с валютой одинаковый номер " + Строка(ДублиСделокСВалютой.Количество) + ".");
	КонецЦикла;
	
	ОшибкиИмпортируемыхСделокСВалютой = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиИмпортируемыхСделокСВалютой"].ПолучитьДанные().Выбрать();
	
	Пока ОшибкиИмпортируемыхСделокСВалютой.Следующий() Цикл
		
		Если ОшибкиИмпортируемыхСделокСВалютой.НомерСделки = 0 Тогда
			ЗарегистрироватьОшибкуИмпорта("В 1С обнаружена сделка с валютой [" + ОшибкиИмпортируемыхСделокСВалютой.Документ + "], которой нет в QUIKе. Проверьте вывод данных (ODBC) из QUIKа.");	
		Иначе
			ЗарегистрироватьОшибкуИмпорта("Сделка c валютой [" + ОшибкиИмпортируемыхСделокСВалютой.НомерСделки + "] [" + ОшибкиИмпортируемыхСделокСВалютой.ВидСделки + "] не будет загружена, т.к. при формировании данных для загрузки обнаружено несколько [" + Строка(ОшибкиИмпортируемыхСделокСВалютой.Количество) + "] записей.");
		КонецЕсли;
		
	КонецЦикла;
	
	УдалитьВременныеТаблицы("СделкаСВалютой", МВТ);
	
	Если ДублиСделокСВалютой.Количество() > 0 Или ОшибкиИмпортируемыхСделокСВалютой.Количество() > 0 Тогда
		Возврат Неопределено;	
	КонецЕсли;

	Для Инд = 1 - ИмпортируемыеДанные.Количество() По 0 Цикл
		
		СтрокаИмпортируемыеСделки = ИмпортируемыеДанные[-Инд];
		
		Если Не ЗначениеЗаполнено(СтрокаИмпортируемыеСделки.НовНомерСделки) Тогда
			ЗарегистрироватьОшибкуИмпорта("Обнаружен документ " + СтрокаИмпортируемыеСделки.Документ + ", которого нет в КВИК-е.");
			ИмпортируемыеДанные.Удалить(-Инд);
			Продолжить;
		КонецЕсли;
		
		Если Не (СтрокаИмпортируемыеСделки.InstrumentClassCode = "CETS" Или СтрокаИмпортируемыеСделки.InstrumentClassCode = "CETS_SU") Тогда
			ЗарегистрироватьОшибкуИмпорта("У сделок с валютой обнаружен новый режим " + СтрокаИмпортируемыеСделки.InstrumentClassCode + ".");
			ИмпортируемыеДанные.Удалить(-Инд);
			Продолжить;
		КонецЕсли;
		
		Если СтрНайти(СтрокаИмпортируемыеСделки.InstrumentCode, "TODTOM") > 0 Тогда
			ЗарегистрироватьОшибкуИмпорта("В QUIKе обнаружена СВОП сделка с валютой  № " + СтрокаИмпортируемыеСделки.НовНомерСделки + ". Для импорта необходима доработка.");
			ИмпортируемыеДанные.Удалить(-Инд);
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ИмпортируемыеДанные;
	
КонецФункции

Процедура ИмпортироватьГруппуОбъектов(Брокер, ВнешниеДанные, ВидДокумента, ИмпортируемыеДанные, ДанныеДляСтатистики)
	// Корректируем изменный КВИКом код режима биржевых торгов
	Для Каждого СтрокаВнешниеДанные Из ВнешниеДанные Цикл
		СтрокаВнешниеДанные.InstrumentClassCode = СтрЗаменить(СтрокаВнешниеДанные.InstrumentClassCode, "_BND", "");
	КонецЦикла;
	
	МВТ = ПолучитьМенеджерВременныхТаблицСДанными(ВнешниеДанные, ВидДокумента, Брокер);
	
	Если ВидДокумента = "Сделка" Тогда
		Если ЭтотОбъект.РежимИмпорта = 2 Тогда
			ИмпортируемыеДанные.Сделки = ИмпортироватьСделки(Брокер, МВТ);
			
			Если Не ИмпортируемыеДанные.Сделки = Неопределено Тогда
				ДанныеДляСтатистики.Сделки = УстранитьРасхождения(ИмпортируемыеДанные.Сделки, "Сделка");
			КонецЕсли;
			
			ИмпортируемыеДанные.БудущиеИсполненияОбязательствПоСделкам = ИмпортироватьБудущиеИсполненияОбязательствПоСделкам(Брокер, МВТ);
				
			Если Не ИмпортируемыеДанные.БудущиеИсполненияОбязательствПоСделкам = Неопределено Тогда
				ДанныеДляСтатистики.БудущиеИсполненияОбязательствПоСделкам = УстранитьРасхождения(ИмпортируемыеДанные.БудущиеИсполненияОбязательствПоСделкам, "ИсполнениеОбязательствПоСделке");
			КонецЕсли;
			
			Если Не ИмпортируемыеДанные.Сделки = Неопределено Тогда
				СписатьОтложеннуюОплатуТорговойКомиссии(Брокер, ИмпортируемыеДанные.Сделки, ДанныеДляСтатистики);
			КонецЕсли;
			
			Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
				ИмпортируемыеДанные.Сделки                                 = ИмпортироватьСделки(Брокер, МВТ);
				ИмпортируемыеДанные.БудущиеИсполненияОбязательствПоСделкам = ИмпортироватьБудущиеИсполненияОбязательствПоСделкам(Брокер, МВТ);
			КонецЕсли;
		Иначе
			ИмпортируемыеДанные.Сделки                                 = ИмпортироватьСделки(Брокер, МВТ);
			ИмпортируемыеДанные.БудущиеИсполненияОбязательствПоСделкам = ИмпортироватьБудущиеИсполненияОбязательствПоСделкам(Брокер, МВТ);
		КонецЕсли;
	ИначеЕсли ВидДокумента = "СделкаРЕПО" Тогда
		Если ЭтотОбъект.РежимИмпорта = 2 Тогда
			ИмпортируемыеДанные.СделкиРЕПО = ИмпортироватьСделкиРЕПО(Брокер, МВТ, 1);
			
			Если Не ИмпортируемыеДанные.СделкиРЕПО = Неопределено Тогда
				ДанныеДляСтатистики.СделкиРЕПО = УстранитьРасхождения(ИмпортируемыеДанные.СделкиРЕПО, "СделкаРЕПО");
				
				// Следующей итерацией загружаем вторые части
				ИмпортируемыеДанные.СделкиРЕПО = ИмпортироватьСделкиРЕПО(Брокер, МВТ, 2);
				
				Если Не ИмпортируемыеДанные.СделкиРЕПО = Неопределено Тогда
					ДанныеДляСтатистики.СделкиРЕПО_2 = УстранитьРасхождения(ИмпортируемыеДанные.СделкиРЕПО, "СделкаРЕПО");
				КонецЕсли;
				
				// Обновим данные на форме после загрузки сделок
				Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
					ИмпортируемыеДанные.СделкиРЕПО = ИмпортироватьСделкиРЕПО(Брокер, МВТ);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ИмпортируемыеДанные.СделкиРЕПО = ИмпортироватьСделкиРЕПО(Брокер, МВТ);
		КонецЕсли;
	ИначеЕсли ВидДокумента = "СделкаСВалютой" Тогда
		ИмпортируемыеДанные.СделкиСВалютой = ИмпортироватьСделкиСВалютой(Брокер, МВТ);
		
		Если ЭтотОбъект.РежимИмпорта = 2 Тогда
			Если Не ИмпортируемыеДанные.СделкиСВалютой = Неопределено Тогда
				ДанныеДляСтатистики.СделкиСВалютой = УстранитьРасхождения(ИмпортируемыеДанные.СделкиСВалютой, ВидДокумента);
			КонецЕсли;
		
			Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
				ИмпортируемыеДанные.СделкиСВалютой = ИмпортироватьСделкиСВалютой(Брокер, МВТ);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьМенеджерВременныхТаблицСДанными(ВнешниеДанные, ВидДокумента, Брокер)
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ВидДокумента КАК ВидДокумента,
		|	ВнешниеДанные.DealDate КАК DealDate,
		|	ВнешниеДанные.DealTime КАК DealTime,
		|	ВнешниеДанные.FirstPart КАК FirstPart,
		|	ВнешниеДанные.OrderNumber КАК OrderNumber,
		|	ВнешниеДанные.DealNumber КАК DealNumber,
		|	ВнешниеДанные.SourceNumber КАК SourceNumber,
		|	ВнешниеДанные.RepoPart КАК RepoPart,
		|	ВнешниеДанные.Operation КАК Operation,
		|	ВнешниеДанные.Duration КАК Duration,
		|	ВнешниеДанные.RepaymentDate КАК RepaymentDate,
		|	ВнешниеДанные.RepoRate КАК RepoRate,
		|	ВнешниеДанные.PartnerOrganization КАК PartnerOrganization,
		|	ВнешниеДанные.Client КАК Client,
		|	ВнешниеДанные.Briefcase КАК Briefcase,
		|	ВнешниеДанные.Currency КАК Currency,
		|	ВнешниеДанные.InstrumentClassCode КАК InstrumentClassCode,
		|	ВнешниеДанные.InstrumentClass КАК InstrumentClass,
		|	ВнешниеДанные.InstrumentCode КАК InstrumentCode,
		|	ВнешниеДанные.Quantity КАК Quantity,
		|	ВнешниеДанные.P_LotSize КАК P_LotSize,
		|	ВнешниеДанные.Volume КАК Volume,
		|	ВнешниеДанные.Coupon КАК Coupon,
