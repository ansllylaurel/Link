// ИНТЕРФЕЙС

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка",
		"КВИК: импорт сделок",
		"3.39",
		"",
		Истина);
	
	// Команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортСделокЧерезБКРЕГИОН", "БК РЕГИОН, за текущую дату",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортСделокЧерезБКРЕГИОН_Вчера", "БК РЕГИОН, за вчера",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортСделокЧерезГПБ", "ГПБ, за текущую дату",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортСделокЧерезРСБХ", "РСХБ, за текущую дату",, Ложь, "ВызовСерверногоМетода");	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортЦенныхБумаг", "Импорт новых ценных бумаг",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,  "СверкаСделокСДаннымиКвиковТрейдеров", "Сверка сделок с данными квиков трейдеров",, Ложь, "ВызовСерверногоМетода"); 
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
КонецФункции

// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ЭтотОбъект.ДатаИмпорта = ТекущаяДатаСеанса();
	ТекстСообщения = Неопределено;
	
	//В неторговые (но рабочие) дни через QUIK могут отправляться поручения на переводы ДС 
	Если Не ЭтоРабочийИлиТорговыйДень(НачалоДня(ЭтотОбъект.ДатаИмпорта)) Тогда
		Возврат;
	КонецЕсли;

	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыКоманды, "Организация");
	
	ЭтотОбъект.ТипИсточника = 1; // сервер SQL
	ЭтотОбъект.РежимИмпорта = 2; // поиск и устранение расхождений
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");
	КонецЕсли;
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	
	Если ИдентификаторКоманды = "АвтоИмпортСделокЧерезБКРЕГИОН" Тогда
		ЭтотОбъект.СхемаДанных = "БК РЕГИОН";
	ИначеЕсли ИдентификаторКоманды = "АвтоИмпортСделокЧерезБКРЕГИОН_Вчера" Тогда
		ЭтотОбъект.СхемаДанных = "БК РЕГИОН";
		ЭтотОбъект.ДатаИмпорта = Справочники.Календари.ДобавитьКДатеРабочиеДни(ОбщегоНазначения.ПолучитьИменованныйОбъект("КалендарьКотировок"), НачалоДня(ТекущаяДатаСеанса()) - 1, -1);
	ИначеЕсли ИдентификаторКоманды = "АвтоИмпортСделокЧерезГПБ" Тогда
		ЭтотОбъект.СхемаДанных = "ГПБ";
	ИначеЕсли ИдентификаторКоманды = "АвтоИмпортСделокЧерезРСБХ" Тогда
		ЭтотОбъект.СхемаДанных = "РСХБ";
	ИначеЕсли ИдентификаторКоманды = "АвтоИмпортЦенныхБумаг"
		Или ИдентификаторКоманды = "СверкаСделокСДаннымиКвиковТрейдеров" Тогда
		//Для импорта ценных бумаг и сверки схема данных не нужна
	Иначе
		ЗарегистрироватьОшибкуИмпорта("Для команды [" + ИдентификаторКоманды + "] не определена схема данных.");
		ОповеститьОбОшибках(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "ДатаИмпорта,Организация,СхемаДанных,РежимИмпорта,ТипИсточника");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + "." + ИдентификаторКоманды;
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыВыполненияДляСбораСтатистики.Хранилище, ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ДанныеДляСтатистики = Новый Структура("Сделки, ИсполненияОбязательствПоСделкам, БудущиеИсполненияОбязательствПоСделкам, СделкиРЕПО, СделкиРЕПО_2, СделкиСВалютой, ЗагруженныеБумаги, ОплатаТорговойКомиссии");
	
	Если ИдентификаторКоманды = "АвтоИмпортЦенныхБумаг" Тогда 
		
		НайтиИЗагрузитьЦенныеБумаги(ДанныеДляСтатистики); 
		
	ИначеЕсли ИдентификаторКоманды = "СверкаСделокСДаннымиКвиковТрейдеров" Тогда
		
		СверитьСделкиСДаннымиКвиковТрейдеров();	
		
	Иначе
		ИмпортироватьДанные(, ДанныеДляСтатистики);
	КонецЕсли;
	
	Для Каждого ГруппаОбъектов Из ДанныеДляСтатистики Цикл
		
		Если Не ЗначениеЗаполнено(ГруппаОбъектов.Значение) Тогда
			ДанныеДляСтатистики.Удалить(ГруппаОбъектов.Ключ);	
		КонецЕсли;
		
	КонецЦикла;
	
	Если ДанныеДляСтатистики.Количество() = 0 Тогда
		ДанныеДляСтатистики = Неопределено;	
	КонецЕсли;
	
	ОповеститьОбОшибках(ТекстСообщения);
		
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, ДанныеДляСтатистики, ТекстСообщения);
	
КонецПроцедуры

Функция ИмпортироватьДанные(ВнешниеСделки = Неопределено, ДанныеДляСтатистики) Экспорт
	ПараметрыСеанса.ФормированиеДвиженийПоРегистрамБэкОфиса = Истина;
	
	// Проверим корректность полноту и корректность заполнения полей
	Если Не ЗначениеЗаполнено(ЭтотОбъект.Организация) Тогда
		ЗарегистрироватьОшибкуИмпорта("Не заполнено поле 'Организация'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.СхемаДанных) Тогда
		ЗарегистрироватьОшибкуИмпорта("Не заполнено поле 'Схема данных'");
	КонецЕсли;
	
	Если ЭтотОбъект.ТипИсточника <> 1 И ЭтотОбъект.ТипИсточника <> 2 Тогда
		ЗарегистрироватьОшибкуИмпорта("Некорректно заполнено поле 'Тип источника'");
	КонецЕсли;
	
	Если ЭтотОбъект.РежимИмпорта <> 1 И ЭтотОбъект.РежимИмпорта <> 2 Тогда
		ЗарегистрироватьОшибкуИмпорта("Некорректно заполнено поле 'Режим импорта'");
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		Если ЭтотОбъект.ТипИсточника <> 1 Тогда // Сервер SQL
			ЗарегистрироватьОшибкуИмпорта("Некорректно заполнено поле 'Тип источника' при регламетном выполнении");
		КонецЕсли;
		
		Если ЭтотОбъект.РежимИмпорта <> 2 Тогда // Поиск и устранение расхождений
			ЗарегистрироватьОшибкуИмпорта("Некорректно заполнено поле 'Режим импорта' при регламетном выполнении");
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Получим схему импорта и проверим корректность её заполнения
	СхемаИмпорта = ПолучитьВыбраннуюСхемуИмпорта();
	
	Если СхемаИмпорта = Неопределено Тогда
		ЗарегистрироватьОшибкуИмпорта("Не удалось получить схему импорта по имени [" + ЭтотОбъект.СхемаДанных + "]");
		Возврат Неопределено;
	КонецЕсли;
	
	Если СхемаИмпорта.СтрокаСоединения = Неопределено Тогда
		ЗарегистрироватьОшибкуИмпорта("В схеме импорта '" + ЭтотОбъект.СхемаДанных + "' не заданы параметры соединения с сервером данных.");
	КонецЕсли;
	
	// Определим брокера
	Если СхемаИмпорта.Брокер = Неопределено Тогда
		ЗарегистрироватьОшибкуИмпорта("В схеме импорта '" + ЭтотОбъект.СхемаДанных + "' не заданы параметры соединения с сервером данных.");
	Иначе
		Брокер = ОбщегоНазначения.ПолучитьИменованныйОбъект(СхемаИмпорта.Брокер);
		Если Брокер = Неопределено Тогда
			ЗарегистрироватьОшибкуИмпорта("Не удалось найти брокера '" + СхемаИмпорта.Брокер + "' среди именованных объектов.");
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмпортируемыеДанные = Новый Структура("Сделки, ИсполненияОбязательствПоСделкам, БудущиеИсполненияОбязательствПоСделкам, СделкиРЕПО, СделкиСВалютой");
	
	Если ВнешниеСделки <> Неопределено Тогда
		ВнешниеДанные = ПолучитьДанныеИзМассива(СхемаИмпорта.БазаДанных, СхемаИмпорта.СхемаИсточника, ВнешниеСделки);
		
		Если ВнешниеДанные <> Неопределено Тогда
			ИмпортироватьГруппуОбъектов(Брокер, ВнешниеДанные.ОбычныеСделки, "Сделка", ИмпортируемыеДанные, ДанныеДляСтатистики);
			ИмпортироватьГруппуОбъектов(Брокер, ВнешниеДанные.СделкиРЕПО, "СделкаРЕПО", ИмпортируемыеДанные, ДанныеДляСтатистики);
		КонецЕсли;
	Иначе // Загрузим с сервера
		// Получим правила
		ПравилаИмпорта = ПолучитьПравилаИмпорта(СхемаИмпорта.БазаДанных, СхемаИмпорта.СхемаИсточника, Брокер);
		
		Если ТипЗнч(ПравилаИмпорта) <> Тип("Массив") Или ПравилаИмпорта.Количество() = 0 Тогда
			ЗарегистрироватьОшибкуИмпорта("Не удалось получить правила импорта данных.");
			Возврат Неопределено;
		КонецЕсли;
		
		СтруктураДанныхКВИК = ПолучитьСтруктуруДанныхКВИК();
		
		Для Каждого ПравилоИмпорта Из ПравилаИмпорта Цикл
			Если ПустаяСтрока(ПравилоИмпорта.ТекстЗапроса) Тогда
				ЗарегистрироватьОшибкуИмпорта("Не задан текст запроса для получения данных по группе объектов '" + ПравилоИмпорта.ГруппаОбъектов + "'");
				Продолжить;
			КонецЕсли;
			
			НаборЗаписей = РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(СхемаИмпорта.СтрокаСоединения, ПравилоИмпорта.ТекстЗапроса);
			
			Если НаборЗаписей = Неопределено Тогда;
				ЗарегистрироватьОшибкуИмпорта("Возникла ошибка при выполнении запроса. Не удалось получить данные по группе объектов '" + ПравилоИмпорта.ГруппаОбъектов + "'");
				Продолжить;
			КонецЕсли;
			
			ВнешниеДанные = ПолучитьПустуюТаблицуЗначений(СтруктураДанныхКВИК);
			
			ДанныеКвика = РаботаСВнешнимиСистемами.ADODBC_ВыгрузитьНаборВТаблицуЗначений(НаборЗаписей, СтруктураДанныхКВИК);
			
			Если ДанныеКвика <> Неопределено Тогда
				РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ДанныеКвика, ВнешниеДанные);
			КонецЕсли;
			
			ИмпортироватьГруппуОбъектов(Брокер, ВнешниеДанные, ПравилоИмпорта.ВидДокумента, ИмпортируемыеДанные, ДанныеДляСтатистики);
		КонецЦикла;
	КонецЕсли;
		
	Возврат ИмпортируемыеДанные;
КонецФункции

Процедура СверитьСделкиСДаннымиКвиковТрейдеров(ТекРезультат = Неопределено) Экспорт
	
	Если ТекРезультат = Неопределено Тогда
		ТекРезультат = Новый Структура("ОтсутствуютУНас, ОтсутствуютУТрейдера", Новый Массив, Новый Массив);	
	КонецЕсли;
	
	СтрокаСоединения = "Driver={SQL Server};Server=AP70;UID=Nikolay;PWD=11111";
	
	Если ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ") Тогда 	
		
		ArchiveSchema = "ram";
		SourceDataBase = "QuikExportRam";
		
	ИначеЕсли ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ") Тогда
		
		ArchiveSchema = "trast";
		SourceDataBase = "QuikExportTrast";
	
	Иначе
		
		ЗарегистрироватьОшибкуИмпорта("Для организации [" + ЭтотОбъект.Организация + "] не описаны правила сверки с данными QUIKов трейдеров.");
		Возврат;
	
	КонецЕсли; 
			
	ДатаСтрокой = Формат(ЭтотОбъект.ДатаИмпорта, "ДФ=yyyyMMdd");

	ТекстЗапроса = "EXEC [QuikExportArchive].[dbo].[DealsDivergenceControl] '" + ДатаСтрокой + "', '" + ArchiveSchema + "', '" + SourceDataBase + "'";  
	
	ВнешниеДанные = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса,,, Новый Структура("ВозвращатьПустуюТаблицу", Истина)); 
	
	Если ВнешниеДанные = Неопределено Тогда 
		ЗарегистрироватьОшибкуИмпорта("Не удалось получить данные QUIKов трейдеров для сверки количества сделок.");
		Возврат;
	КонецЕсли;
	
	ТекДата = ТекущаяДатаСеанса();
	
	Для Каждого Строка Из ВнешниеДанные Цикл
		
		Если Строка.ФлагСделкаОтсутствует Тогда
			
			//Если сделки нет более 5 минут - фиксируем ошибку.
			ПятьМинут = 5 * 60;
			
			Если ТекДата - Дата(Формат(Строка.DealDate, "ДФ=yyyyMMdd") + СтрЗаменить(Строка.DealTime, ":", "")) > ПятьМинут Тогда 
				
				ТекРезультат.ОтсутствуютУНас.Добавить(СтрШаблон(Строка.ТекстСообщения, Формат(Строка.DealNumber, "ЧГ=0"), Строка.DealType, Строка.ClassCode, СокрЛП(Строка.SourceSchema), Строка.Client));  
							
			КонецЕсли;
			
		Иначе
			ТекРезультат.ОтсутствуютУТрейдера.Добавить(СтрШаблон(Строка.ТекстСообщения, Формат(Строка.DealNumber, "ЧГ=0"), Строка.DealType, Строка.ClassCode, СокрЛП(Строка.SourceSchema), Строка.Client)); 	
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
				
		Если ТекРезультат.ОтсутствуютУНас.Количество() > 0 Тогда
			
			ТекстСообщения = "Отсутствующие сделки:" + Символы.ПС; 
			
			Для Каждого ОписаниеСделки Из ТекРезультат.ОтсутствуютУНас Цикл 
				ТекстСообщения = ТекстСообщения + Символы.ПС + ОписаниеСделки; 
			КонецЦикла;
			
			ЗарегистрироватьОшибкуИмпорта(ТекстСообщения);
			
		КонецЕсли; 
		
		Если ТекРезультат.ОтсутствуютУТрейдера.Количество() > 0 Тогда
			
			ТекстСообщения = "Проверьте вывод данных из QUIKов трейдеров. Отсутствуют данные следующих сделок:" + Символы.ПС; 
			
			Для Каждого ОписаниеСделки Из ТекРезультат.ОтсутствуютУТрейдера Цикл 
				ТекстСообщения = ТекстСообщения + Символы.ПС + ОписаниеСделки; 
			КонецЦикла;
			
			ЗарегистрироватьОшибкуИмпорта(ТекстСообщения);
			
		КонецЕсли;
		
	КонецЕсли;
			
КонецПроцедуры 

Функция ПолучитьСхемыИмпорта(ТипИсточника) Экспорт
	СхемыИмпорта = Новый Массив();
	ВыборкаXPath = ВыполнитьЗапросXPathКПравиламИмпорта("//СхемаИмпорта[@ТипИсточника=""" + ТипИсточника + """]");
	
	ЗначениеАтрибутаУК = ПолучитьИмяУК();
	Если ЗначениеАтрибутаУК = Неопределено Тогда
		ЗарегистрироватьОшибкуИмпорта("Не удалось получить схему импорта для организации [" + ЭтотОбъект.Организация + "] и типу источника [" + ТипИсточника + "]");
		Возврат Неопределено;
	КонецЕсли;
		
	Пока 1 = 1 Цикл
		ЭлементDOM = ВыборкаXPath.ПолучитьСледующий();
		
		Если ЭлементDOM = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		ЗначениеАтрибута = ЭлементDOM.ПолучитьАтрибут("УК");
		
		Если ЗначениеАтрибута = ЗначениеАтрибутаУК Тогда
			СхемыИмпорта.Добавить(ЭлементDOM.ПолучитьАтрибут("Имя"));
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СхемыИмпорта;
КонецФункции

Функция ЭтоРабочийИлиТорговыйДень(НачалоДня)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ДанныеКалендаряКотировок.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|				ИЛИ ДанныеОбщероссийскогоКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФлагРабочийДень
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаряКотировок,
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеОбщероссийскогоКалендаря
		|ГДЕ
		|	ДанныеКалендаряКотировок.Календарь = &КалендарьКотировок
		|	И ДанныеКалендаряКотировок.Дата = &НачалоДня		
		|	И ДанныеОбщероссийскогоКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеОбщероссийскогоКалендаря.Дата = &НачалоДня";
	
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня);
	Запрос.УстановитьПараметр("КалендарьКотировок", ОбщегоНазначения.ПолучитьИменованныйОбъект("КалендарьКотировок"));
	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат[0].ФлагРабочийДень;
	
КонецФункции

