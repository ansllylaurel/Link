	ОшибкиЦенныхБумаг = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиЦенныхБумаг"].ПолучитьДанные().Выбрать();
	Пока ОшибкиЦенныхБумаг.Следующий() Цикл
		ЗарегистрироватьОшибкуИмпорта("" + ВидДокумента + " [" + ОшибкиЦенныхБумаг.DealNumber + "] не будет загружена, т.к. не удалось определить ценную бумагу по коду [" + ОшибкиЦенныхБумаг.InstrumentCode + "]. В регистре [коды в торговых системах] найдено " + Строка(ОшибкиЦенныхБумаг.Количество) + " зап. с таким кодом.");
	КонецЦикла;
	
	ОшибкиКодовУБрокера = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиКодовУБрокера"].ПолучитьДанные().Выбрать();
	Пока ОшибкиКодовУБрокера.Следующий() Цикл
		ЗарегистрироватьОшибкуИмпорта("" + ВидДокумента + " [" + ОшибкиКодовУБрокера.DealNumber + "] не будет загружена, т.к. не удалось определить счет доверительного управления. По коду [" + ОшибкиКодовУБрокера.Client + "\" + ОшибкиКодовУБрокера.Briefcase+ "] найдено " + Строка(ОшибкиКодовУБрокера.Количество) + " зап. в регистре [коды счетов ДУ у брокера].");
	КонецЦикла;
		
	ОшибкиВалют = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиВалют"].ПолучитьДанные().Выбрать();
	Пока ОшибкиВалют.Следующий() Цикл
		ЗарегистрироватьОшибкуИмпорта("" + ВидДокумента + " [" + ОшибкиВалют.DealNumber + "] не будет загружена, т.к. не удалось определить валюту по коду [" + ОшибкиВалют.Currency + "]. В справочнике [Валюты] " + Строка(ОшибкиВалют.Количество) + " знач. с таким кодом.");
	КонецЦикла;
	
	ОшибкиРежимовБиржевыхТоргов = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиРежимовБиржевыхТоргов"].ПолучитьДанные().Выбрать();
	Пока ОшибкиРежимовБиржевыхТоргов.Следующий() Цикл
		Если ОшибкиРежимовБиржевыхТоргов.ФлагРежимНеСоответсвуетСделке Тогда
			ЗарегистрироватьОшибкуИмпорта("" + ВидДокумента + " [" + ОшибкиРежимовБиржевыхТоргов.DealNumber + "] не будет загружена, т.к. режим биржевых торгов [" + ОшибкиРежимовБиржевыхТоргов.InstrumentClassCode + "] не соответствует сделкам" + ?(ВидДокумента = "Сделка", ".", " РЕПО.") + " У режима установлен флаг Репо [" + ОшибкиРежимовБиржевыхТоргов.Репо + "]. Проверьте настройки таблиц в QUIKах, возможно в таблицы попали разные типы сделок.");
		Иначе
			ЗарегистрироватьОшибкуИмпорта("" + ВидДокумента + " [" + ОшибкиРежимовБиржевыхТоргов.DealNumber + "] не будет загружена, т.к. не удалось определить режим биржевых торгов по коду [" + ОшибкиРежимовБиржевыхТоргов.InstrumentClassCode + "]. В справочнике " + Строка(ОшибкиРежимовБиржевыхТоргов.Количество) + " зап. с таким кодом.");
		КонецЕсли;
	КонецЦикла;
	
	ОшибкиИсполнителей31 = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиИсполнителей31"].ПолучитьДанные().Выбрать();
	Пока ОшибкиИсполнителей31.Следующий() Цикл
		ЗарегистрироватьОшибкуИмпорта("" + ВидДокумента + " [" + ОшибкиИсполнителей31.DealNumber + "] не будет загружена, т.к. не удалось определить исполнителя с кодом 31 для счета ДУ [" + ОшибкиИсполнителей31.СчетДоверительногоУправления + "]. В регистре " + Строка(ОшибкиИсполнителей31.Количество) + " зап. с кодом 31.");
	КонецЦикла;
	
	ОшибкиИсполнителей36 = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиИсполнителей36"].ПолучитьДанные().Выбрать();
	Пока ОшибкиИсполнителей36.Следующий() Цикл
		ЗарегистрироватьОшибкуИмпорта("" + ВидДокумента + " [" + ОшибкиИсполнителей36.DealNumber + "] не будет загружена, т.к. не удалось определить исполнителя с кодом 36 для счета ДУ [" + ОшибкиИсполнителей36.СчетДоверительногоУправления + "]. В регистре " + Строка(ОшибкиИсполнителей36.Количество) + " зап. с кодом 36.");
	КонецЦикла;
	
	ОшибкиКонтрагентов = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиКонтрагентов"].ПолучитьДанные().Выбрать();
	Пока ОшибкиКонтрагентов.Следующий() Цикл
		ЗарегистрироватьОшибкуИмпорта("" + ВидДокумента + " [" + ОшибкиКонтрагентов.DealNumber + "] не будет загружена, т.к. не удалось определить контрагента [" + ОшибкиКонтрагентов.PartnerOrganization + "]. В регистре [КодыВоВнешнихСистемах] " + Строка(ОшибкиКонтрагентов.Количество) + " зап. с кодом " + ОшибкиКонтрагентов.PartnerOrganization + ".");
	КонецЦикла;
	
	Возврат МВТ;
КонецФункции

Процедура СписатьОтложеннуюОплатуТорговойКомиссии(Брокер, ИмпортируемыеСделки, ДанныеДляСтатистики)
	
	КлючевыеПоляСтр = "ДатаОплатыКомиссии, Брокер, МестоХранения, СчетДоверительногоУправления, ОснованияНомерСтроки";
	КлючевыеПоля    = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(КлючевыеПоляСтр, ",", Истина, Истина);
	ИсключаемыеПоля = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("Ответственный, Комментарий, ОбеспечительныйПлатеж, КоррСчет, Субконто1, Субконто2, Субконто3, КоррСчетЕПС, СубконтоЕПС1, СубконтоЕПС2, СубконтоЕПС3, ДатаПлановогоПогашенияЗадолженности, ОснованияПортфель, ОснованияСтавкаНДС, ОснованияСуммаНДС", ",", Истина, Истина);
	
	НомераСделок = Новый Массив;
	Для Каждого СтрокаИмпортируемойСделки Из ИмпортируемыеСделки Цикл
		Если ЗначениеЗаполнено(СтрокаИмпортируемойСделки.НовНомерСделки)
			И НомераСделок.Найти(СтрокаИмпортируемойСделки.НовНомерСделки) = Неопределено Тогда
			НомераСделок.Добавить(СтрокаИмпортируемойСделки.НовНомерСделки);
		КонецЕсли;
	КонецЦикла;
	
	Если НомераСделок.Количество() = 0 Тогда
		ДанныеДляСтатистики.Вставить("ОплатаТорговойКомиссии", "Проведено 0 док.");
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер",      Брокер);
	Запрос.УстановитьПараметр("ДатаИмпорта", ЭтотОбъект.ДатаИмпорта);
	Запрос.УстановитьПараметр("НомераСделок", НомераСделок);
	Запрос.УстановитьПараметр("Период",      ТекущаяДатаСеанса());
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НАЧАЛОПЕРИОДА(Сделка.ДатаОплатыТорговойКомиссии, ДЕНЬ) КАК ДатаОплатыКомиссии
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|ГДЕ
		|	Сделка.ОтложеннаяОплатаТорговойКомиссии
		|	И Сделка.ДатаОплатыТорговойКомиссии <> ДАТАВРЕМЯ(1, 1, 1)
		|	И Сделка.Организация = &Организация
		|	И Сделка.Брокер = &Брокер
		|	И Сделка.НомерСделки В (&НомераСделок)
		|	И Сделка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаИмпорта, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаИмпорта, ДЕНЬ)
		|	И НЕ Сделка.ПометкаУдаления";
	
	ДатыОплатыКомиссии = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДатаОплатыКомиссии");
	
	Если ДатыОплатыКомиссии.Количество() = 0 Тогда
		ДанныеДляСтатистики.Вставить("ОплатаТорговойКомиссии", "Проведено 0 док.");
		Возврат;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДатыОплатыКомиссии", ДатыОплатыКомиссии);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Оплата.Проведен КАК Проведен,
		|	Оплата.Ссылка КАК Ссылка,
		|	Оплата.Дата КАК Дата,
		|	Оплата.Организация КАК Организация,
		|	Оплата.ВидДвижения КАК ВидДвижения,
		|	Оплата.ВидЗадолженности КАК ВидЗадолженности,
		|	Оплата.Аванс КАК Аванс,
		|	Оплата.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Оплата.Брокер КАК Брокер,
		|	Оплата.МестоХранения КАК МестоХранения,
		|	Оплата.РасчетныйСчет КАК РасчетныйСчет,
		|	Оплата.ВалютаОплаты КАК ВалютаОплаты,
		|	Оплата.СтрокаБанковскойВыписки КАК СтрокаБанковскойВыписки,
		|	Оплата.Договор КАК Договор,
		|	Оплата.Контрагент КАК Контрагент,
		|	Оплата.РасчетныйСчетКонтрагента КАК РасчетныйСчетКонтрагента,
		|	Оплата.Поручение КАК Поручение,
		|	-ОплатаОснования.НомерСтроки КАК ОснованияНомерСтроки,
		|	ОплатаОснования.Основание КАК ОснованияОснование,
		|	ОплатаОснования.Валюта КАК ОснованияВалюта,
		|	ОплатаОснования.Сумма КАК ОснованияСумма,
		|	ОплатаОснования.СуммаОплаты КАК ОснованияСуммаОплаты,
		|	ОплатаОснования.СуммаКупона КАК ОснованияСуммаКупона,
		|	ОплатаОснования.СуммаОплатыКупона КАК ОснованияСуммаОплатыКупона,
		|	ОплатаОснования.СобственныйКурсОплаты КАК ОснованияСобственныйКурсОплаты,
		|	ОплатаОснования.КурсОплаты КАК ОснованияКурсОплаты,
		|	НАЧАЛОПЕРИОДА(Сделка.ДатаОплатыТорговойКомиссии, ДЕНЬ) КАК ДатаОплатыКомиссии
		|ИЗ
		|	Документ.Оплата.Основания КАК ОплатаОснования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Оплата КАК Оплата
		|		ПО ОплатаОснования.Ссылка = Оплата.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
		|		ПО ОплатаОснования.Основание = Сделка.Ссылка
		|ГДЕ
		|	НЕ Оплата.ПометкаУдаления
		|	И (Оплата.Дата > &Период
		|			ИЛИ НЕ Оплата.Проведен)
		|	И Оплата.Организация = &Организация
		|	И Оплата.Брокер = &Брокер
		|	И Оплата.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|	И Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|	И Сделка.ОтложеннаяОплатаТорговойКомиссии
		|	И Сделка.ДатаОплатыТорговойКомиссии <> ДАТАВРЕМЯ(1, 1, 1)
		|	И НАЧАЛОПЕРИОДА(Сделка.ДатаОплатыТорговойКомиссии, ДЕНЬ) В (&ДатыОплатыКомиссии)";
	
	ОплатыТорговойКомиссии = Запрос.Выполнить().Выгрузить();
	
	ПоляРесурсы = Новый Массив;
	
	ОплатыТорговойКомиссии.Колонки.Добавить("НовДата", Новый ОписаниеТипов("Дата"));
	ПоляРесурсы.Добавить("Дата");
	
	Для Каждого РеквизитМД Из Метаданные.Документы.Оплата.Реквизиты Цикл
		Если КлючевыеПоля.Найти(РеквизитМД.Имя) = Неопределено И ИсключаемыеПоля.Найти(РеквизитМД.Имя) = Неопределено Тогда
			ОплатыТорговойКомиссии.Колонки.Добавить("Нов" + РеквизитМД.Имя, РеквизитМД.Тип);
			ПоляРесурсы.Добавить(РеквизитМД.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого РеквизитМД Из Метаданные.Документы.Оплата.ТабличныеЧасти.Основания.Реквизиты Цикл
		Если КлючевыеПоля.Найти("Основания" + РеквизитМД.Имя) = Неопределено И ИсключаемыеПоля.Найти("Основания" + РеквизитМД.Имя) = Неопределено Тогда
			ОплатыТорговойКомиссии.Колонки.Добавить("НовОснования" + РеквизитМД.Имя, РеквизитМД.Тип);
			ПоляРесурсы.Добавить("Основания" + РеквизитМД.Имя);
		КонецЕсли;
	КонецЦикла;
	
	ОплатыТорговойКомиссии.Колонки.Добавить("ОснованияПорядок", Метаданные.Документы.Сделка.Реквизиты.НомерСделки.Тип);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделка.Ссылка КАК Основание
		|ПОМЕСТИТЬ _СделкиСОплатойКомиссии
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|ГДЕ
		|	Сделка.ОтложеннаяОплатаТорговойКомиссии
		|	И Сделка.ДатаОплатыТорговойКомиссии <> ДАТАВРЕМЯ(1, 1, 1)
		|	И Сделка.Организация = &Организация
		|	И Сделка.Брокер = &Брокер
		|	И НАЧАЛОПЕРИОДА(Сделка.ДатаОплатыТорговойКомиссии, ДЕНЬ) В (&ДатыОплатыКомиссии)
		|	И НЕ Сделка.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.Сделка).ДатаОплатыТорговойКомиссии, ДЕНЬ), МИНУТА, 20 * 60 + 30) КАК НовДата,
		|	НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.Сделка).ДатаОплатыТорговойКомиссии, ДЕНЬ) КАК ДатаОплатыКомиссии,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Организация КАК НовОрганизация,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход) КАК НовВидДвижения,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии) КАК НовВидЗадолженности,
		|	ЛОЖЬ КАК НовАванс,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.Сделка).Брокер КАК Брокер,
		|	ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.Сделка).МестоХранения КАК МестоХранения,
		|	ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.Сделка).РасчетныйСчет КАК РасчетныйСчет,
		|	ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка) КАК НовРасчетныйСчет,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК НовВалютаОплаты,
		|	ЗНАЧЕНИЕ(Документ.СтрокаБанковскойВыписки.ПустаяСсылка) КАК НовСтрокаБанковскойВыписки,
		|	ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.Сделка).Брокер.ЮрФизЛицо КАК НовКонтрагент,
		|	ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка) КАК НовРасчетныйСчетКонтрагента,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК НовОснованияОснование,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК НовОснованияВалюта,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК НовОснованияСумма,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК НовОснованияСуммаКупона,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК НовОснованияСуммаОплаты,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК НовОснованияСуммаОплатыКупона,
		|	ЛОЖЬ КАК НовОснованияСобственныйКурсОплаты,
		|	НЕОПРЕДЕЛЕНО КАК НовОснованияКурсОплаты,
		|	ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.Сделка).НомерСделки КАК ОснованияПорядок
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			&Период,
		|			ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|				И Организация = &Организация
		|				И Основание В
		|					(ВЫБРАТЬ
		|						_СделкиСОплатойКомиссии.Основание
		|					ИЗ
		|						_СделкиСОплатойКомиссии)) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.Сделка).НомерСделки
		|ИТОГИ ПО
		|	ДатаОплатыКомиссии,
		|	Брокер,
		|	МестоХранения,
		|	СчетДоверительногоУправления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДатаОплатыКомиссии = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДатаОплатыКомиссии.Следующий() Цикл
		
		ВыборкаБрокер = ВыборкаДатаОплатыКомиссии.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаБрокер.Следующий() Цикл
			
			ВыборкаМестоХранения = ВыборкаБрокер.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаМестоХранения.Следующий() Цикл
				
				ВыборкаСчетДоверительногоУправления = ВыборкаМестоХранения.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаСчетДоверительногоУправления.Следующий() Цикл
					
					Выборка = ВыборкаСчетДоверительногоУправления.Выбрать();
					
					НомерСтроки = 1;
					
					Пока Выборка.Следующий() Цикл
						
						Ключ = Новый Структура(КлючевыеПоляСтр);
						
						ЗаполнитьЗначенияСвойств(Ключ, Выборка);
						Ключ.ОснованияНомерСтроки = -НомерСтроки;
						
						СтрокиОплатыТорговойКомиссии = ОплатыТорговойКомиссии.НайтиСтроки(Ключ);
						
						Если СтрокиОплатыТорговойКомиссии.Количество() = 0 Тогда
							НоваяСтрокаОплатыТорговойКомиссии = ОплатыТорговойКомиссии.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрокаОплатыТорговойКомиссии, Выборка);
							НоваяСтрокаОплатыТорговойКомиссии.ОснованияНомерСтроки = 0;
							
						ИначеЕсли СтрокиОплатыТорговойКомиссии.Количество() = 1 Тогда
							СтрокиОплатыТорговойКомиссии[0].ОснованияНомерСтроки = -СтрокиОплатыТорговойКомиссии[0].ОснованияНомерСтроки;
							ЗаполнитьЗначенияСвойств(СтрокиОплатыТорговойКомиссии[0], Выборка);
							
						Иначе
							Если НомерСтроки > 1 Тогда
								Продолжить;
							КонецЕсли;
							ЗарегистрироватьОшибкуИмпорта("Найдено более одной оплаты торговой комиссии за дату " + Выборка.ДатаОплатыКомиссии
								+ ", в организации: " + ЭтотОбъект.Организация
								+ ", где брокер: " + Выборка.Брокер
								+ ", место хранения: " + Выборка.МестоХранения
								+ ", счет д/у: " + Выборка.СчетДоверительногоУправления);
						КонецЕсли;
						
						НомерСтроки = НомерСтроки + 1;
						
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Обработано = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ОплатыТорговойКомиссии.ОснованияНомерСтроки <= 0
		|				ИЛИ Не ОплатыТорговойКомиссии.Проведен
		|				ИЛИ &УсловиеПоискаРасхождений
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ЕстьРасхождения,
		|	ОплатыТорговойКомиссии.Ссылка,
		|	ОплатыТорговойКомиссии.ОснованияПорядок,
		|	ОплатыТорговойКомиссии.ОснованияНомерСтроки,
		|	ОплатыТорговойКомиссии.ДатаОплатыКомиссии,
		|	ОплатыТорговойКомиссии.Брокер,
		|	ОплатыТорговойКомиссии.МестоХранения,
		|	ОплатыТорговойКомиссии.СчетДоверительногоУправления,
		|	&Ресурсы
		|ПОМЕСТИТЬ _ОплатыТорговойКомиссии
		|ИЗ
		|	&ОплатыТорговойКомиссии КАК ОплатыТорговойКомиссии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОплатыТорговойКомиссии.Ссылка КАК Ссылка,
		|	_ОплатыТорговойКомиссии.ОснованияНомерСтроки,
		|	_ОплатыТорговойКомиссии.ДатаОплатыКомиссии КАК ДатаОплатыКомиссии,
		|	_ОплатыТорговойКомиссии.Брокер КАК Брокер,
		|	_ОплатыТорговойКомиссии.МестоХранения КАК МестоХранения,
		|	_ОплатыТорговойКомиссии.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОплатыТорговойКомиссии.ЕстьРасхождения КАК ЕстьРасхождения,
		|	&РесурсыДокумента
		|ИЗ
		|	_ОплатыТорговойКомиссии КАК _ОплатыТорговойКомиссии
		|
		|УПОРЯДОЧИТЬ ПО
		|	_ОплатыТорговойКомиссии.ОснованияПорядок
		|ИТОГИ
		|	СУММА(ЕстьРасхождения)
		|ПО
		|	Ссылка,
		|	ДатаОплатыКомиссии,
		|	Брокер,
		|	МестоХранения,
		|	СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("ОплатыТорговойКомиссии", ОплатыТорговойКомиссии);
	
	ПоляРесурсыВЗапросе      = "";
	УсловиеПоискаРасхождений = "";
	ПоляДокументаВЗапросе    = "";
	
	Для Каждого ПолеРесурс Из ПоляРесурсы Цикл
		ПоляРесурсыВЗапросе = ПоляРесурсыВЗапросе
			+ ?(ПустаяСтрока(ПоляРесурсыВЗапросе), "", "," + Символы.ПС + Символы.Таб)
			+ "ОплатыТорговойКомиссии.Нов" + ПолеРесурс + " КАК " + ПолеРесурс;
			
		ПоляДокументаВЗапросе = ПоляДокументаВЗапросе
			+ ?(ПустаяСтрока(ПоляДокументаВЗапросе), "", "," + Символы.ПС + Символы.Таб)
			+ "_ОплатыТорговойКомиссии." + ПолеРесурс;
			
		УсловиеПоискаРасхождений = УсловиеПоискаРасхождений
			+ ?(ПустаяСтрока(УсловиеПоискаРасхождений), "", Символы.ПС + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб)
			+ "ИЛИ ОплатыТорговойКомиссии." + ПолеРесурс + " <> ОплатыТорговойКомиссии.Нов" + ПолеРесурс;
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&РесурсыДокумента", ПоляДокументаВЗапросе);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Ресурсы", ПоляРесурсыВЗапросе);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИЛИ &УсловиеПоискаРасхождений", УсловиеПоискаРасхождений);
	
	ВыборкаСсылка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСсылка.Следующий() Цикл
		
		Если ВыборкаСсылка.ЕстьРасхождения = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаСсылка.Ссылка) Тогда
			ОплатаТорговойКомиссии = ВыборкаСсылка.Ссылка.ПолучитьОбъект();
			ОплатаТорговойКомиссии.Основания.Очистить();
		Иначе
			ОплатаТорговойКомиссии = Неопределено;
		КонецЕсли;
		
		ВыборкаДатаОплатыКомиссии = ВыборкаСсылка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаДатаОплатыКомиссии.Следующий() Цикл
			
			ВыборкаБрокер = ВыборкаДатаОплатыКомиссии.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаБрокер.Следующий() Цикл
				
				ВыборкаМестоХранения = ВыборкаБрокер.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаМестоХранения.Следующий() Цикл
					
					ВыборкаСчетДоверительногоУправления = ВыборкаМестоХранения.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
					Пока ВыборкаСчетДоверительногоУправления.Следующий() Цикл
						
						Если Не ЗначениеЗаполнено(ВыборкаСсылка.Ссылка) Тогда
							ОплатаТорговойКомиссии = Документы.Оплата.СоздатьДокумент();
							ОплатаТорговойКомиссии.Ответственный = РаботаСПользователями.ТекущийПользователь();
							ОплатаТорговойКомиссии.Комментарий = "Создан аппаратно-техническими средствами " + ТекущаяДата();
						КонецЕсли;
						
						Выборка = ВыборкаСчетДоверительногоУправления.Выбрать();
						
						Пока Выборка.Следующий() Цикл
							ЕстьОшибка = Ложь;
							Если Выборка.ОснованияНомерСтроки < 0 Тогда
								ЕстьОшибка = Истина;
								Продолжить;
							КонецЕсли;
							
							Если ОплатаТорговойКомиссии.Основания.Количество() = 0 Тогда
								ЗаполнитьЗначенияСвойств(ОплатаТорговойКомиссии, Выборка);
							КонецЕсли;
							
							НоваяСтрокаОснования = ОплатаТорговойКомиссии.Основания.Добавить();
							
							Для Каждого РеквизитМД Из Метаданные.Документы.Оплата.ТабличныеЧасти.Основания.Реквизиты Цикл
								Если ИсключаемыеПоля.Найти("Основания" + РеквизитМД.Имя) <> Неопределено Тогда
									Продолжить;
								КонецЕсли;
								НоваяСтрокаОснования[РеквизитМД.Имя] = Выборка["Основания" + РеквизитМД.Имя];
							КонецЦикла;
						КонецЦикла;
						
						Если ЕстьОшибка Тогда
							Продолжить;
						КонецЕсли;
						
						Попытка
							ОплатаТорговойКомиссии.Записать(РежимЗаписиДокумента.Проведение);
							Обработано = Обработано + 1;
						Исключение
							Попытка
								ОплатаТорговойКомиссии.Записать(РежимЗаписиДокумента.Запись);
							Исключение
								ЗарегистрироватьОшибкуИмпорта("Не удалось записать оплату торговой комиссии " + ОплатаТорговойКомиссии
									+ ", организация: " + ЭтотОбъект.Организация + ", брокер: " + ВыборкаСчетДоверительногоУправления.Брокер
									+ ", место хранения: " + ВыборкаСчетДоверительногоУправления.МестоХранения
									+ ", счет д/у: " + ВыборкаСчетДоверительногоУправления.СчетДоверительногоУправления
									+ ". Система сообщает: " + ОписаниеОшибки());
							КонецПопытки;
						КонецПопытки;
						
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ДанныеДляСтатистики.Вставить("ОплатаТорговойКомиссии", "Проведено " + Обработано + " док.");
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обработано оплат торговой комиссии: " + Обработано);
	КонецЕсли;
	
КонецПроцедуры // СписатьОтложеннуюОплатуТорговойКомиссии

////////////////////////////////////////////////////////////////////////////////
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ

Процедура ЗарегистрироватьОшибкуИмпорта(ТекстОшибки)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	// дополним текст ошибки сообщениями пользователю
	МассивСообщений = ПолучитьСообщенияПользователю(Истина);
	
	Если МассивСообщений.Количество() > 0 Тогда

		ТекстОшибки = ТекстОшибки + Символы.ПС + "Сообщения пользователю:";
		Для Каждого ТекСообщение Из МассивСообщений Цикл
			
			Если ТекСообщение.Текст = "" Тогда
				Продолжить;
			Иначе
				Текст = ТекСообщение.Текст + ". " + Строка(ТекСообщение.КлючДанных);
				ТекстОшибки = ТекстОшибки + Символы.ПС + Текст; 
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки) = Неопределено Тогда
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОповеститьОбОшибках(ТекстСообщения) Экспорт
	
	ЕстьОшибки = ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки");
	
	Если Не ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС); 
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
		
	ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");	
	
КонецПроцедуры

Функция ПолучитьСтруктуруДанныхКВИК()
	СтруктураДанныхКВИК = Новый Структура;
	
	СтруктураДанныхКВИК.Вставить("Account", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(12)));
	СтруктураДанныхКВИК.Вставить("OrderNumber", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25)));
	СтруктураДанныхКВИК.Вставить("DealNumber", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25)));
	СтруктураДанныхКВИК.Вставить("SourceNumber", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25)));
	СтруктураДанныхКВИК.Вставить("DealDate", Новый ОписаниеТипов("Дата"));
	СтруктураДанныхКВИК.Вставить("DealTime", Новый ОписаниеТипов("Дата"));
	СтруктураДанныхКВИК.Вставить("RepaymentDate", Новый ОписаниеТипов("Дата"));
	СтруктураДанныхКВИК.Вставить("InstrumentShortName", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	СтруктураДанныхКВИК.Вставить("InstrumentName", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(255)));
	СтруктураДанныхКВИК.Вставить("InstrumentCode", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	СтруктураДанныхКВИК.Вставить("InstrumentClass", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	СтруктураДанныхКВИК.Вставить("InstrumentClassCode", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(10)));
	СтруктураДанныхКВИК.Вставить("Operation", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	СтруктураДанныхКВИК.Вставить("Price", Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
	СтруктураДанныхКВИК.Вставить("Quantity", Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
	СтруктураДанныхКВИК.Вставить("Volume", Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	СтруктураДанныхКВИК.Вставить("Currency", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(12)));
	СтруктураДанныхКВИК.Вставить("CounterCurrency", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(12)));
	СтруктураДанныхКВИК.Вставить("PaymentCode", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(10)));
	СтруктураДанныхКВИК.Вставить("Coupon", Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	СтруктураДанныхКВИК.Вставить("Цена", Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
	СтруктураДанныхКВИК.Вставить("ЦенаРепо_М", Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
	СтруктураДанныхКВИК.Вставить("ЦенаКупона", Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);	
	СтруктураДанныхКВИК.Вставить("ЦенаВторойЧасти", Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
	СтруктураДанныхКВИК.Вставить("ЦенаКупонаВторойЧасти", Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);	
	СтруктураДанныхКВИК.Вставить("Client", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	СтруктураДанныхКВИК.Вставить("Briefcase", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	СтруктураДанныхКВИК.Вставить("PartnerOrganization", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	СтруктураДанныхКВИК.Вставить("Comission", Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	СтруктураДанныхКВИК.Вставить("P_LotSize", Новый ОписаниеТипов("Число"));
	СтруктураДанныхКВИК.Вставить("RepoPart", Новый ОписаниеТипов("Число"));
	СтруктураДанныхКВИК.Вставить("FirstPart", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25)));
	СтруктураДанныхКВИК.Вставить("PriceReturn", Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
	СтруктураДанныхКВИК.Вставить("RepoYield", Новый ОписаниеТипов("Число"));
	СтруктураДанныхКВИК.Вставить("RepoSum", Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	СтруктураДанныхКВИК.Вставить("RepoVolume", Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	СтруктураДанныхКВИК.Вставить("Duration", Новый ОписаниеТипов("Число"));
	СтруктураДанныхКВИК.Вставить("RepoRate", Новый ОписаниеТипов("Число"));
	СтруктураДанныхКВИК.Вставить("AccountCode", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(10)));
	СтруктураДанныхКВИК.Вставить("RepoStartingStartDiscount", Новый ОписаниеТипов("Число"));
	
	Возврат СтруктураДанныхКВИК;
КонецФункции

Функция ПолучитьПустуюТаблицуЗначений(СтруктураДанныхКВИК)
	
	Табл = Новый ТаблицаЗначений;
	
	Для Каждого Поле Из СтруктураДанныхКВИК Цикл
		Табл.Колонки.Добавить(Поле.Ключ, Поле.Значение, Поле.Ключ);
	КонецЦикла;
		
	Возврат Табл;
		
КонецФункции

Функция ПолучитьВыбраннуюСхемуИмпорта()
	
	ПолучитьДанныеАрхива = (ЭтотОбъект.ДатаИмпорта < НачалоДня(ТекущаяДатаСеанса()));
	
	ИмяУК = ПолучитьИмяУК();
	
	ВыборкаXPath = ВыполнитьЗапросXPathКПравиламИмпорта("//СхемаИмпорта[@Имя=""" + ЭтотОбъект.СхемаДанных + """][@УК=""" + ИмяУК + """]");
	
	Пока 1 = 1 Цикл
		
		ЭлементDOM = ВыборкаXPath.ПолучитьСледующий();
		
		Если ЭлементDOM = Неопределено Тогда
			Возврат Неопределено;
		Иначе
			Возврат
				Новый Структура("СтрокаСоединения, БазаДанных, СхемаИсточника, Брокер",
					"Driver={SQL Server};Server=AP70;UID=Nikolay;PWD=11111",
					?(ПолучитьДанныеАрхива, ЭлементDOM.ПолучитьАтрибут("БазаДанныхАрхива"), ЭлементDOM.ПолучитьАтрибут("БазаДанных")),
					?(ПолучитьДанныеАрхива, ЭлементDOM.ПолучитьАтрибут("СхемаАрхива"), ЭлементDOM.ПолучитьАтрибут("СхемаИсточника")),
  					ЭлементDOM.ПолучитьАтрибут("Брокер"));
		КонецЕсли;

	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьПравилаИмпорта(БазаДанных, СхемаИсточника, Брокер)
		
	// определим коды счетов д/у по этому брокеру
	КодыСчетовДУ = "";
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК DealerID
		|ПОМЕСТИТЬ _КодыВоВнешнихСистемах
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&Период,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ММВБ)
		|				И ГруппаОбъектов = &ГруппаОбъектов
		|				И Объект = &Брокер) КАК КодыВоВнешнихСистемахСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Объект КАК Справочник.СчетаДоверительногоУправления).Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _СчетаИсключеныИзЗагрузки
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Объект ССЫЛКА Справочник.СчетаДоверительногоУправления
		|	И ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Объект КАК Справочник.СчетаДоверительногоУправления).Организация = &Организация
		|	И ЗначенияДополнительныхСведений.Свойство.Ключ = &Ключ
		|	И ЗначенияДополнительныхСведений.Значение = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК Код
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Брокер = &Брокер
		|				И НЕ СчетДоверительногоУправления В
		|						(ВЫБРАТЬ
		|							Счета.Ссылка
		|						ИЗ
		|							_СчетаИсключеныИзЗагрузки КАК Счета)) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.КодFORTS
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Брокер = &Брокер
		|				И КодFORTS <> """"
		|				И НЕ СчетДоверительногоУправления В
		|						(ВЫБРАТЬ
		|							Счета.Ссылка
		|						ИЗ
		|							_СчетаИсключеныИзЗагрузки КАК Счета)) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних";
#КонецОбласти

	Запрос.УстановитьПараметр("Период", ЭтотОбъект.ДатаИмпорта);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер", Брокер); 
	Запрос.УстановитьПараметр("ГруппаОбъектов", Справочники.ГруппыИмпортируемыхОбъектов.ПолучитьГруппуПоНаименованию("Брокерские компании"));
	Запрос.УстановитьПараметр("Ключ", "УчетНеВедется");
	
	Результат = Запрос.Выполнить();
	
	_КодыВоВнешнихСистемах = Запрос.МенеджерВременныхТаблиц.Таблицы["_КодыВоВнешнихСистемах"].ПолучитьДанные().Выбрать();
		
	Если _КодыВоВнешнихСистемах.Следующий() Тогда
		DealerID = _КодыВоВнешнихСистемах.DealerID;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(DealerID) Тогда
		ЗарегистрироватьОшибкуИмпорта("Не удалось определить код участника торгов (ММВБ) для брокера [" + Брокер + "].");
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		КодыСчетовДУ = КодыСчетовДУ + ?(ПустаяСтрока(КодыСчетовДУ), "", ",") + Выборка.Код;
	КонецЦикла;
	
	// получим схему импорта
	СхемаИмпорта = Новый Массив();
	
	ВыборкаXPath = ВыполнитьЗапросXPathКПравиламИмпорта("//ПравилоИмпорта");
	
	Пока 1 = 1 Цикл
		
		ЭлементDOM = ВыборкаXPath.ПолучитьСледующий();
		
		Если ЭлементDOM = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		ТекстЗапроса =
			"SET NOCOUNT ON
			|
			|USE @DBName
			|
			|IF OBJECT_ID('tempdb..#ClientsByOrganization') IS NOT NULL
			|	DROP TABLE #ClientsByOrganization
			|
			|CREATE TABLE #ClientsByOrganization	(
			|	Code NVARCHAR(50)
			|)
			|
			|INSERT INTO #ClientsByOrganization
			|SELECT value
			|FROM STRING_SPLIT(@Client, ',')
			|
			|";
		
		ТекстЗапроса = ТекстЗапроса + ЭлементDOM.ТекстовоеСодержимое;
		ТекстЗапроса = ТекстЗапроса +
			"
			|
			|DROP TABLE #ClientsByOrganization";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "@DealDate", "'" + Формат(ЭтотОбъект.ДатаИмпорта, "ДФ=ггггММдд") + "'");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "@Dealer", "'" + DealerID + "'");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "@DBName", БазаДанных);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "@Client", "'" + КодыСчетовДУ + "'");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#SourceSchema", СхемаИсточника); 
		
		СхемаИмпорта.Добавить(
			Новый Структура("ГруппаОбъектов, ВидДокумента, ТекстЗапроса",
				ЭлементDOM.ПолучитьАтрибут("ГруппаОбъектов"), ЭлементDOM.ПолучитьАтрибут("ВидДокумента"), ТекстЗапроса));
		
	КонецЦикла;

	Возврат СхемаИмпорта;

КонецФункции

Функция ВыполнитьЗапросXPathКПравиламИмпорта(ЗапросXPath)
	
	ПравилаЗагрузкиXML = ЭтотОбъект.ПолучитьМакет("ПравилаИмпорта").ПолучитьТекст();
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ПравилаЗагрузкиXML);
	
	ПостроительDOM = Новый ПостроительDOM;
	
	ДокументDOM  = ПостроительDOM.Прочитать(ЧтениеXML);
	
	ВыборкаXPath = ДокументDOM.ВычислитьВыражениеXPath(ЗапросXPath, ДокументDOM.ЭлементДокумента, Новый РазыменовательПространствИменDOM(ДокументDOM.ЭлементДокумента));
	
	Возврат ВыборкаXPath;
	
КонецФункции 

Функция ПолучитьИмяУК()
	МассивИмен = РаботаСКоллекциями.ЗначенияВМассив("Организация_РЭМ", "Организация_РПИ", "Организация_МДТраст");
	
	Для Каждого ТекИмя Из МассивИмен Цикл
		Если ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект(ТекИмя) Тогда
			Возврат ТекИмя;
		КонецЕсли;
	КонецЦикла;
КонецФункции

Функция ПолучитьТаблицуПараметров(БазаДанных, СхемаИсточника)
		
	ТекстЗапроса		=
		"SELECT DISTINCT
		|	[P_InstrumentClassCode] AS InstrumentClassCode,
		|	[P_InstrumentClass] AS InstrumentClass,
		|	[P_InstrumentCode] AS P_InstrumentCode,
		|	[P_InstrumentShortName] AS InstrumentShortName,
		|	[P_InstrumentName] AS InstrumentName,
		|	CASE WHEN [P_InstrumentClassCode] LIKE '%FUT%' THEN [P_InstrumentName] ELSE [P_InstrumentCode] END AS InstrumentCode,
		|	CASE WHEN [P_InstrumentClassCode] LIKE '%FUT%' THEN 1 ELSE 0 END AS CalculationPrice,
		|	[P_LotSize] AS P_LotSize
		|FROM [" + БазаДанных + "].[" + СхемаИсточника + "].[Parameters]
		|WHERE
		|P_TradeDate = '" + Формат(ДатаПараметров, "ДЛФ=D") + "'";
	
	СтрокаСоединения = "Driver={SQL Server};Server=AP70;UID=Nikolay;PWD=11111;" + БазаДанных; 
	
	Возврат РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса);
	
КонецФункции

Процедура ДополнитьТаблицуИзПараметров(Сделки, Параметры)
	
	Для Каждого ТекСтрока Из Параметры Цикл
		
		НайденныеСделки = Сделки.НайтиСтроки(Новый Структура("InstrumentClassCode, InstrumentCode", ТекСтрока.InstrumentClassCode, ТекСтрока.P_InstrumentCode));
		
		Для Каждого ТекСделка Из НайденныеСделки Цикл
			
			ЗаполнитьЗначенияСвойств(ТекСделка, ТекСтрока);
			
			Если ТекСтрока.CalculationPrice
				И ТекСделка.Quantity <> 0 Тогда
				ТекСделка.Price = ТекСделка.Volume / ТекСделка.Quantity;
			ИначеЕсли ТекСделка.Quantity = 0 Тогда
				ТекСделка.Price = 0;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДанныеИзМассива(БазаДанных, СхемаИсточника, МассивДанных)
	МаскаПолей = "DealNumber,,DealTime,Operation,,,,Account,InstrumentClassCode,InstrumentCode,Price,Quantity,Volume,RepaymentDate,Coupon,,,PriceReturn,
				|AccountCode,DealType,,Comission,RepoRate,RepoYield,RepoSum,RepoVolume,Duration,,,,,,,,Client,,SourceNumber,,,PartnerOrganization,DealDate";
	
	МассивПолей = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(МаскаПолей);
	
	Результат = Новый Структура("ОбычныеСделки, СделкиРЕПО", Новый ТаблицаЗначений, Новый ТаблицаЗначений);
	
	Для Каждого Колонка Из ПолучитьСтруктуруДанныхКВИК() Цикл
		Результат.ОбычныеСделки.Колонки.Добавить(Колонка.Ключ, Колонка.Значение);
		Результат.СделкиРЕПО.Колонки.Добавить(Колонка.Ключ, Колонка.Значение);
	КонецЦикла;
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	Для Каждого СтрокаДанных Из МассивДанных Цикл
		ТипСделки = СтрокаДанных[МассивПолей.Найти("DealType")];
		
		Если ТипСделки = "G" Тогда
			Продолжить;
		КонецЕсли;
		
		ЭтоСделкаРЕПО = ТипСделки = "H" ИЛИ ТипСделки = "h";
		
		// Разделяем список сделок на обычные и РЕПО.
		Если ЭтоСделкаРЕПО Тогда
			ВнешниеДанные = Результат.СделкиРЕПО;
		Иначе
			ВнешниеДанные = Результат.ОбычныеСделки;
		КонецЕсли;
		
		НоваяСтрока = ВнешниеДанные.Добавить();
		
		Для Каждого Колонка Из ВнешниеДанные.Колонки Цикл
			ИмяКолонки = Колонка.Имя;
			Индекс = МассивПолей.Найти(ИмяКолонки);
			
			Если Не Индекс = Неопределено Тогда
				НоваяСтрока[ИмяКолонки] = ПривестиЗначениеКТипу(СтрокаДанных[Индекс], ИмяКолонки, ТипЗнч(НоваяСтрока[ИмяКолонки]));
			ИначеЕсли ИмяКолонки = "Currency" Тогда
				НоваяСтрока[ИмяКолонки] = ВалютаУчета;
			ИначеЕсли ЭтоСделкаРЕПО Тогда
				Если ИмяКолонки = "RepoPart" Тогда
					Если ТипСделки = "H" Тогда
						НоваяСтрока.REPOPart = 1;
					Иначе
						НоваяСтрока.REPOPart = 2;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		НоваяСтрока.BriefCase = СтрЗаменить(НоваяСтрока.Client, "/", "_");
		
		НачалоПостфикса = СтрНайти(НоваяСтрока.Client, "/", НаправлениеПоиска.СКонца);
		Если НачалоПостфикса > 0 Тогда
			НоваяСтрока.Client = Лев(НоваяСтрока.Client, НачалоПостфикса-1);
		КонецЕсли;
		
		НоваяСтрока.DealDate = НоваяСтрока.DealDate + Час(НоваяСтрока.DealTime) * 3600 + Минута(НоваяСтрока.DealTime) * 60 + Секунда(НоваяСтрока.DealTime);
	КонецЦикла;
	
	ТаблицаПараметров = ПолучитьТаблицуПараметров(БазаДанных, СхемаИсточника);
	
	Если ТаблицаПараметров = Неопределено Тогда
		ЗарегистрироватьОшибкуИмпорта("Не удалось получить таблицу параметров из архивной базы данных!");
		Возврат Неопределено;
	КонецЕсли;
	
	ДополнитьТаблицуИзПараметров(Результат.СделкиРЕПО, ТаблицаПараметров);
	
	Для Каждого ТекСделка Из Результат.СделкиРЕПО Цикл
		ТекСделка.Цена					= ?(ТекСделка.P_LotSize = 0, 0, ТекСделка.P_LotSize * ТекСделка.Volume / ТекСделка.Quantity);
		ТекСделка.ЦенаКупона			= ?(ТекСделка.P_LotSize = 0, 0, ТекСделка.P_LotSize * ТекСделка.Coupon / ТекСделка.Quantity);
		ТекСделка.ЦенаКупонаВторойЧасти	= ?(ТекСделка.RepoPart = 2 ИЛИ ТекСделка.P_LotSize = 0, 0, ТекСделка.P_LotSize * ТекСделка.RepoYield / ТекСделка.Quantity);
		ТекСделка.ЦенаВторойЧасти		= ?(ТекСделка.RepoPart = 2 ИЛИ ТекСделка.P_LotSize = 0, 0, ТекСделка.P_LotSize * (ТекСделка.RepoVolume - ТекСделка.RepoYield) / ТекСделка.Quantity);
		ТекСделка.DealTime				= ?(ТекСделка.RepoPart = 1, ТекСделка.DealTime, Дата(2001,1,1));
		ТекСделка.RepaymentDate			= ?(ТекСделка.RepoPart = 1, ТекСделка.RepaymentDate, Дата(2001,1,1));
		ТекСделка.DealDate				= ?(ТекСделка.RepoPart = 1, ТекСделка.DealDate, НачалоДня(ТекСделка.DealDate) + 24*60*60 * ТекСделка.Duration);
		
		// Определим первую часть РЕПО
		Если ТекСделка.RepoPart = 2 Тогда
			Отбор = Новый Структура;
			
			Если ЗначениеЗаполнено(ТекСделка.SourceNumber) Тогда
				Отбор.Вставить("RepoPart",		1);
				Отбор.Вставить("SourceNumber",	ТекСделка.SourceNumber);
			Иначе
				Отбор.Вставить("RepoPart",				1);
				Отбор.Вставить("Client",				ТекСделка.Client);
				Отбор.Вставить("Briefcase",				ТекСделка.Briefcase);
				Отбор.Вставить("Account",				ТекСделка.Account);
				Отбор.Вставить("InstrumentCode",		ТекСделка.InstrumentCode);
				Отбор.Вставить("Quantity",				ТекСделка.Quantity);
				Отбор.Вставить("ЦенаВторойЧасти",		ТекСделка.Цена);
				Отбор.Вставить("ЦенаКупонаВторойЧасти",	ТекСделка.Coupon);
				Отбор.Вставить("RepoVolume",			ТекСделка.Volume + ТекСделка.Coupon);
				Отбор.Вставить("RepoRate",				ТекСделка.RepoRate);
			КонецЕсли;
			
			НайденныеСтроки = Результат.СделкиРЕПО.НайтиСтроки(Отбор);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				Если НайденныеСтроки.Количество() > 1 Тогда
					ЗарегистрироватьОшибкуИмпорта("Для 2 части РЕПО (сделка № " + ТекСделка.DealNumber + ") не удалось однозначно определить первую часть РЕПО!");
				КонецЕсли;
				
				ТекСделка.FirstPart = НайденныеСтроки[0].DealNumber;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ДополнитьТаблицуИзПараметров(Результат.ОбычныеСделки, ТаблицаПараметров);
	
	Для Каждого ТекСделка Из Результат.ОбычныеСделки Цикл
		ТекСделка.PaymentCode = ТекСделка.AccountCode;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция ПривестиЗначениеКТипу(Значение, Имя, ОжидаемыйТип)

	Если Имя = "Operation" Тогда
		
		Возврат ?(Значение = "B", "Купля", "Продажа");
		
	ИначеЕсли Имя = "DealDate" ИЛИ Имя = "RepaymentDate" Тогда
		
		Если СтрДлина(СокрЛП(Значение)) = 10 Тогда
		
			Возврат Дата(Сред(Значение, 7, 4), Сред(Значение, 4, 2), Лев(Значение, 2));
			
		Иначе
			
			Возврат Дата("20" + Сред(Значение, 7, 2), Сред(Значение, 4, 2), Лев(Значение, 2));
		
		КонецЕсли; 
				
	ИначеЕсли Имя = "DealTime" Тогда
		
		Возврат Дата(2001, 1, 1, Лев(Значение, 2), Сред(Значение, 4, 2) , Сред(Значение, 7, 2));
		
	ИначеЕсли Имя = "TPlus" Тогда
		
		Возврат ?(СтрНайти(Значение, "+") = 0, 0, -1);
		
	ИначеЕсли ОжидаемыйТип = Тип("Число") и Значение = "" Тогда
		
		Возврат 0;
		
	Иначе
		
		Возврат Значение;
	
	КонецЕсли; 
	
КонецФункции

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	//Массив = Новый Массив;
	Если ЭтотОбъект.ТипИсточника = 2 Тогда
