	ПараметрыОформления.Вставить("ПолеТаблицы",			Макет.ПолучитьОбласть("ПолеТаблицы"));
	ПараметрыОформления.Вставить("РазделительТаблиц",	Макет.ПолучитьОбласть("РазделительТаблиц"));

	ПараметрыОформления.ЗаголовокОтчета.Параметры.Поле = "Результат процедуры 'ИмпортироватьСделки'";			
	Отчет.Вывести(ПараметрыОформления.ЗаголовокОтчета);
	
	ШириныКолонок = Новый Соответствие;
	
	ВывестиТаблицуЗначенийВТабличныйДокумент(Отчет, ТаблицаПараметров, "Параметры запроса", ПараметрыОформления, Истина, ШириныКолонок);
	
	// Результаты запроса
	Для Каждого ВТ из Запрос.МенеджерВременныхТаблиц.Таблицы Цикл
		ВывестиТаблицуЗначенийВТабличныйДокумент(Отчет, ВТ.ПолучитьДанные().Выгрузить(), ВТ.ПолноеИмя, ПараметрыОформления, Ложь, ШириныКолонок);    
	КонецЦикла;
	
	ВывестиТаблицуЗначенийВТабличныйДокумент(Отчет, ИмпортируемыеДанные, "Импортируемые данные", ПараметрыОформления, Ложь, ШириныКолонок);    

	// Установим ширины колонок для таблицы
	ВсегоКолонок = ШириныКолонок.Количество(); 
