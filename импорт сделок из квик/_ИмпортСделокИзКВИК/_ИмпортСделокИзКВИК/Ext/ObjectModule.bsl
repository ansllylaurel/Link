Процедура УдалитьВременныеТаблицы(ВидДокумента, МВТ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Если ВидДокумента = "Сделка" Тогда
		
		Запрос.Текст =
			"УНИЧТОЖИТЬ _ДублиСделок_1С
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ОшибкиИмпортируемыхСделок
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ДублиИсполнений_1С
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ОшибкиИмпортируемыхИсполнений";
		
	ИначеЕсли ВидДокумента = "СделкаРЕПО" Тогда
	
		Запрос.Текст = 
			"УНИЧТОЖИТЬ _ДублиСделокРЕПО_1С
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ОшибкиИмпортируемыхСделокРЕПО"; 
		
	ИначеЕсли ВидДокумента = "СделкаСВалютой" Тогда
		
		Запрос.Текст =
			"УНИЧТОЖИТЬ _ДублиСделокСВалютой_1С
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ОшибкиИмпортируемыхСделокСВалютой";
		
	КонецЕсли;
	
	Запрос.Выполнить();

КонецПроцедуры

#Область Процедуры_отладки

Процедура ОтправитьСделкиДляОтладки(Запрос, ИмпортируемыеДанные, ТипСделки)

	ТаблицаПараметров = Новый ТаблицаЗначений;
	Для каждого Параметр Из Запрос.Параметры Цикл
		ТаблицаПараметров.Колонки.Добавить(Параметр.Ключ);
	КонецЦикла; 
	ЗаполнитьЗначенияСвойств(ТаблицаПараметров.Добавить(), Запрос.Параметры);
	
	Отчет = Новый ТабличныйДокумент;	
	Отчет.ТолькоПросмотр		= Истина;
	Отчет.ОтображатьЗаголовки	= Ложь;
	Отчет.ОтображатьСетку		= Ложь;
	
	// Параметры макета
	Макет = Документы.РегистрацияСтоимостиПереоценки.ПолучитьМакет("МакетРасшифровкиРасчета");
	
	ПараметрыОформления	= Новый Структура;
	ПараметрыОформления.Вставить("ЗаголовокОтчета",		Макет.ПолучитьОбласть("ЗаголовокОтчета"));
	ПараметрыОформления.Вставить("ЗаголовокТаблицы",	Макет.ПолучитьОбласть("ЗаголовокТаблицы"));
