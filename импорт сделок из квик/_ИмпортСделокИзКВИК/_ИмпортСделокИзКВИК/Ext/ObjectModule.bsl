			ЗарегистрироватьОшибкуИмпорта("По коду [" + Выборка.КодБумаги + "] не удалось найти инструмент для импорта в 1С.");
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивКодовВыгруженныхБумаг.Количество() > 0  Тогда
		ДанныеДляСтатистики.ЗагруженныеБумаги = РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(МассивКодовВыгруженныхБумаг);	
	Иначе
		ДанныеДляСтатистики.ЗагруженныеБумаги = Неопределено;	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеИмпортируемыхСделок(ИмпортируемыеСделки, ПересчитыватьРеквизиты, ВидДокумента)
	
	Если ТипЗнч(ИмпортируемыеСделки) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
			
	Брокер_БК_Регион  = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион");
	Брокер_ГПБ        = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ");
	Брокер_РСХБ		  = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_РСХБ");
	
	ММВБ_Торговый     = ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ_Торговый");
	ММВБ_ТорговыйПлюс = ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ_Торговый+");
	ММВБ_FORTS		  = ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС_раздел_FORTS");
	ММВБ              = ММВБ_ТорговыйПлюс.Родитель;
	
	Для Инд = 1 - ИмпортируемыеСделки.Количество() По 0 Цикл
		
		СтрокаИмпортируемыеСделки = ИмпортируемыеСделки[-Инд];
		
		// определим место хранения и брокера
		Если ПересчитыватьРеквизиты Тогда
		
			Если СтрокаИмпортируемыеСделки.НовРынок = Перечисления.РынкиЦенныхБумаг.Фьючерсы Тогда
				
				СтрокаИмпортируемыеСделки.НовМестоХранения 				  = ММВБ_FORTS;
				СтрокаИмпортируемыеСделки.НовЦенныеБумагиДепозитарныйСчет = Справочники.ДепозитарныеСчета.СчетУчетаДеривативов;
			Иначе
				
				СтрокаИмпортируемыеСделки.НовМестоХранения                = Справочники.МестаХранения.ПустаяСсылка();
				СтрокаИмпортируемыеСделки.НовЦенныеБумагиДепозитарныйСчет = Справочники.ДепозитарныеСчета.ПустаяСсылка();
				
				Если      СтрокаИмпортируемыеСделки.НовБрокер = Брокер_БК_Регион Тогда
					
					Если ЭтотОбъект.ДатаИмпорта >= Дата(2017, 11, 1) Тогда
						// начиная с этой даты все сделки по БК Региону пойдут по Т+ (см. задачу 1Ф-160561)
						СтрокаИмпортируемыеСделки.НовЦенныеБумагиДепозитарныйСчет = СтрокаИмпортируемыеСделки.ЦенныеБумагиДепозитарныйСчет36;
						СтрокаИмпортируемыеСделки.НовМестоХранения = ММВБ_ТорговыйПлюс;
					
					Иначе
						Если СтрокаИмпортируемыеСделки.TPlus Тогда
							СтрокаИмпортируемыеСделки.НовЦенныеБумагиДепозитарныйСчет = СтрокаИмпортируемыеСделки.ЦенныеБумагиДепозитарныйСчет36;
							СтрокаИмпортируемыеСделки.НовМестоХранения = ММВБ_ТорговыйПлюс;
						Иначе
							СтрокаИмпортируемыеСделки.НовЦенныеБумагиДепозитарныйСчет = СтрокаИмпортируемыеСделки.ЦенныеБумагиДепозитарныйСчет31;
							СтрокаИмпортируемыеСделки.НовМестоХранения = ММВБ_Торговый;
						КонецЕсли;	
					КонецЕсли;
											
				ИначеЕсли СтрокаИмпортируемыеСделки.НовБрокер = Брокер_РСХБ Тогда	
					СтрокаИмпортируемыеСделки.НовМестоХранения = ММВБ; // т.к. брокер не раскрывает на каких разделах лежат д/с
					
					Если      СтрокаИмпортируемыеСделки.НовРынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
						СтрокаИмпортируемыеСделки.НовЦенныеБумагиДепозитарныйСчет = СтрокаИмпортируемыеСделки.ЦенныеБумагиДепозитарныйСчет36;
					ИначеЕсли СтрокаИмпортируемыеСделки.НовРынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
						Если СтрокаИмпортируемыеСделки.НовЦенныеБумагиЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Государственная Тогда
							СтрокаИмпортируемыеСделки.НовЦенныеБумагиДепозитарныйСчет = СтрокаИмпортируемыеСделки.ЦенныеБумагиДепозитарныйСчет36;
						Иначе	
							СтрокаИмпортируемыеСделки.НовЦенныеБумагиДепозитарныйСчет = СтрокаИмпортируемыеСделки.ЦенныеБумагиДепозитарныйСчет31;
						КонецЕсли;
					КонецЕсли;
					
				ИначеЕсли СтрокаИмпортируемыеСделки.НовБрокер = Брокер_ГПБ Тогда
					
					СтрокаИмпортируемыеСделки.НовМестоХранения = ММВБ;
					// Задача #287149. С этого дня все бумаги хранятся на 36-ом счете. 
					Если ЭтотОбъект.ДатаИмпорта >= Дата(2019, 10, 31) Тогда
						СтрокаИмпортируемыеСделки.НовЦенныеБумагиДепозитарныйСчет = СтрокаИмпортируемыеСделки.ЦенныеБумагиДепозитарныйСчет36;
					Иначе
						
						Если	СтрокаИмпортируемыеСделки.НовРынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
							СтрокаИмпортируемыеСделки.НовЦенныеБумагиДепозитарныйСчет = СтрокаИмпортируемыеСделки.ЦенныеБумагиДепозитарныйСчет36;
						ИначеЕсли СтрокаИмпортируемыеСделки.НовРынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
							Если СтрокаИмпортируемыеСделки.НовЦенныеБумагиЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Государственная
								// Начиная с этой даты московская биржа перевела часть корпоративных облигаций в режим торгов TQCB (Т+ Облигации)
								// https://www.moex.com/n25349/?nt=106
								ИЛИ (ЭтотОбъект.ДатаИмпорта >= Дата(2019, 10, 14) И СтрокаИмпортируемыеСделки.InstrumentClassCode = "TQCB") Тогда
								СтрокаИмпортируемыеСделки.НовЦенныеБумагиДепозитарныйСчет = СтрокаИмпортируемыеСделки.ЦенныеБумагиДепозитарныйСчет36;
							Иначе	
								СтрокаИмпортируемыеСделки.НовЦенныеБумагиДепозитарныйСчет = СтрокаИмпортируемыеСделки.ЦенныеБумагиДепозитарныйСчет31;
							КонецЕсли;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
			
			КонецЕсли;
			
			Если ИмпортируемыеСделки.Колонки.Найти("НовЦенныеБумагиВторойЧастиДепозитарныйСчет") <> Неопределено И СтрокаИмпортируемыеСделки.НовЧастьСделкиРЕПО <> 2 Тогда
				СтрокаИмпортируемыеСделки.НовЦенныеБумагиВторойЧастиДепозитарныйСчет = СтрокаИмпортируемыеСделки.НовЦенныеБумагиДепозитарныйСчет;
			КонецЕсли;
			
			Если Не СтрокаИмпортируемыеСделки.ЕстьРасхождения Тогда // уточним наличие расхождений
				Если СтрокаИмпортируемыеСделки.НовМестоХранения <> СтрокаИмпортируемыеСделки.ТекМестоХранения
					Или СтрокаИмпортируемыеСделки.НовЦенныеБумагиДепозитарныйСчет <> СтрокаИмпортируемыеСделки.ТекЦенныеБумагиДепозитарныйСчет
				Тогда
					СтрокаИмпортируемыеСделки.ЕстьРасхождения = Истина;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		// блокирующие проверки
		Если Не ЗначениеЗаполнено(СтрокаИмпортируемыеСделки.НовНомерСделки) Тогда
			ЗарегистрироватьОшибкуИмпорта("Обнаружен документ " + СтрокаИмпортируемыеСделки.Документ + ", которого нет в КВИК-е.");
			ИмпортируемыеСделки.Удалить(-Инд);
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(СтрокаИмпортируемыеСделки.НовЦенныеБумагиНомерСтроки) = Тип("Число") И СтрокаИмпортируемыеСделки.НовЦенныеБумагиНомерСтроки > 1 Тогда
			ЗарегистрироватьОшибкуИмпорта("Обнаружен документ " + ?(ВидДокумента = "ИсполнениеОбязательствПоСделке", "исполнение обязательст по сделке №" , "КВИК-сделка №") + СтрокаИмпортируемыеСделки.НовНомерСделки + " с корзиной ценных бумаг. Данный вид сделок не поддерживается. Обратитесь к разработчикам.");
			ИмпортируемыеСделки.Удалить(-Инд);
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(СтрокаИмпортируемыеСделки.ТекЦенныеБумагиНомерСтроки) = Тип("Число") И СтрокаИмпортируемыеСделки.ТекЦенныеБумагиНомерСтроки > 1 Тогда
			ЗарегистрироватьОшибкуИмпорта("Обнаружен документ " + ?(ВидДокумента = "ИсполнениеОбязательствПоСделке", "исполнение обязательст по сделке №" , "КВИК-сделка №") + СтрокаИмпортируемыеСделки.Документ + " с корзиной ценных бумаг. Данный вид сделок не поддерживается. Обратитесь к разработчикам.");
			ИмпортируемыеСделки.Удалить(-Инд);
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаИмпортируемыеСделки.НовВидСделки) Тогда
			
			Если ВидДокумента = "ИсполнениеОбязательствПоСделке" Тогда
				ЗарегистрироватьОшибкуИмпорта("При импорте исполнения обязательств по сделке № " + СтрокаИмпортируемыеСделки.НовНомерСделки + " клиент " + СтрокаИмпортируемыеСделки.НовСчетДоверительногоУправления + " организация " + СтрокаИмпортируемыеСделки.НовОрганизация + " брокер " + СтрокаИмпортируемыеСделки.НовБрокер + " не удалось определить вид сделки основания");
			Иначе
				ЗарегистрироватьОшибкуИмпорта("Не удалось определить вид сделки по операции " + СтрокаИмпортируемыеСделки.Operation + " в сделке № " + СтрокаИмпортируемыеСделки.НовНомерСделки);
			КонецЕсли;
			
			ИмпортируемыеСделки.Удалить(-Инд);
			Продолжить;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаИмпортируемыеСделки.НовСчетДоверительногоУправления) Тогда
			
			Если ВидДокумента = "ИсполнениеОбязательствПоСделке" Тогда
				ЗарегистрироватьОшибкуИмпорта("Не удалось определить счет д/у в исполнении обязательств по сделке № " + СтрокаИмпортируемыеСделки.НовНомерСделки + " организация " + СтрокаИмпортируемыеСделки.НовОрганизация + " брокер " + СтрокаИмпортируемыеСделки.НовБрокер + "");
			Иначе
				ЗарегистрироватьОшибкуИмпорта("Не удалось определить счет д/у по коду " + СтрокаИмпортируемыеСделки.Client + " у брокера " + СтрокаИмпортируемыеСделки.НовБрокер + " в сделке № " + СтрокаИмпортируемыеСделки.НовНомерСделки);
			КонецЕсли;
			
			ИмпортируемыеСделки.Удалить(-Инд);
			Продолжить;
			
		КонецЕсли;

		Если Не ЗначениеЗаполнено(СтрокаИмпортируемыеСделки.НовЦенныеБумагиЦеннаяБумага) Тогда
			
			Если ВидДокумента = "ИсполнениеОбязательствПоСделке" Тогда
				ЗарегистрироватьОшибкуИмпорта("Не удалось определить ценную бумагу в исполнении обязательств по сделке № " + СтрокаИмпортируемыеСделки.НовНомерСделки + " клиент " + СтрокаИмпортируемыеСделки.НовСчетДоверительногоУправления + " организация " + СтрокаИмпортируемыеСделки.НовОрганизация + " брокер " + СтрокаИмпортируемыеСделки.НовБрокер + "");
			Иначе
				ЗарегистрироватьОшибкуИмпорта("Не удалось определить ценную бумагу по коду " + СтрокаИмпортируемыеСделки.InstrumentCode + " в классе " + СтрокаИмпортируемыеСделки.InstrumentClassCode + " в сделке № " + СтрокаИмпортируемыеСделки.НовНомерСделки);
			КонецЕсли;
			
			ИмпортируемыеСделки.Удалить(-Инд);
			Продолжить;
			
		КонецЕсли;
		
		Если СтрокаИмпортируемыеСделки.P_LotSize = 0 Тогда
			
			Если ВидДокумента = "ИсполнениеОбязательствПоСделке" Тогда
				ЗарегистрироватьОшибкуИмпорта("Не задана лотность ценной бумаги " + СтрокаИмпортируемыеСделки.НовЦенныеБумагиЦеннаяБумага + " в исполнении обязательств по сделке № " + СтрокаИмпортируемыеСделки.НовНомерСделки + " клиент " + СтрокаИмпортируемыеСделки.НовСчетДоверительногоУправления + " организация " + СтрокаИмпортируемыеСделки.НовОрганизация + " брокер " + СтрокаИмпортируемыеСделки.НовБрокер + "");
			Иначе
				ЗарегистрироватьОшибкуИмпорта("Не задана лотность ценной бумаги " + СтрокаИмпортируемыеСделки.InstrumentCode + " в классе " + СтрокаИмпортируемыеСделки.InstrumentClassCode + " в сделке № " + СтрокаИмпортируемыеСделки.НовНомерСделки);
			КонецЕсли;
			//ИмпортируемыеСделки.Удалить(-Инд);
			Продолжить;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаИмпортируемыеСделки.НовМестоХранения) Тогда
			ЗарегистрироватьОшибкуИмпорта("Не удалось определить место хранения на бирже для клиента " + СтрокаИмпортируемыеСделки.НовСчетДоверительногоУправления + " у брокера " + СтрокаИмпортируемыеСделки.НовБрокер + " по месту хранения " + СтрокаИмпортируемыеСделки.НовМестоХранения + " в сделке № " + СтрокаИмпортируемыеСделки.НовНомерСделки);
			ИмпортируемыеСделки.Удалить(-Инд);
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаИмпортируемыеСделки.НовЦенныеБумагиДепозитарныйСчет) Тогда
			ЗарегистрироватьОшибкуИмпорта("Не удалось определить депозитарный счет для клиента " + СтрокаИмпортируемыеСделки.НовСчетДоверительногоУправления + " у брокера " + СтрокаИмпортируемыеСделки.НовБрокер + " по месту хранения " + СтрокаИмпортируемыеСделки.НовМестоХранения + " в сделке № " + СтрокаИмпортируемыеСделки.НовНомерСделки);
			ИмпортируемыеСделки.Удалить(-Инд);
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаИмпортируемыеСделки.НовВалютаСделки) Тогда
			
			Если ВидДокумента = "ИсполнениеОбязательствПоСделке" Тогда
				ЗарегистрироватьОшибкуИмпорта("Не удалось определить валюту сделки в исполнении обязательств по сделке к сделке № " + СтрокаИмпортируемыеСделки.НовНомерСделки);
			Иначе
				ЗарегистрироватьОшибкуИмпорта("Не удалось определить валюту сделки по имени " + СтрокаИмпортируемыеСделки.Currency + " в сделке № " + СтрокаИмпортируемыеСделки.НовНомерСделки);
			КонецЕсли;
			
			ИмпортируемыеСделки.Удалить(-Инд);
			Продолжить;
			
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьТекстЗапросаТекущимиИНовымиРеквизитами(ТекстЗапроса, ДокументМД, Знач НеОбрабатыватьРеквизиты, Знач НеИскатьРасхождения, Знач ДопЗначенияДляСверки)
	
	ТекущиеИНовыеРеквизиты   = "";
	УсловиеПоискаРасхождений = "";
	
	Если ТипЗнч(НеОбрабатыватьРеквизиты) = Тип("Строка") Тогда
		НеОбрабатыватьРеквизиты = СтрЗаменить(НеОбрабатыватьРеквизиты, " ", "");
		НеОбрабатыватьРеквизиты = СтрЗаменить(НеОбрабатыватьРеквизиты, ";", ",");
		НеОбрабатыватьРеквизиты = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НеОбрабатыватьРеквизиты, ",", Истина);
	КонецЕсли;
	
	Если ТипЗнч(НеИскатьРасхождения) = Тип("Строка") Тогда
		НеИскатьРасхождения = СтрЗаменить(НеИскатьРасхождения, " ", "");
		НеИскатьРасхождения = СтрЗаменить(НеИскатьРасхождения, ";", ",");
		НеИскатьРасхождения = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НеИскатьРасхождения, ",", Истина);
	КонецЕсли;
	
	Если ТипЗнч(ДопЗначенияДляСверки) = Тип("Строка") Тогда //проверяется значение "Раскрытый контрагент" из доп.сведений.
		ДопЗначенияДляСверки = СтрЗаменить(ДопЗначенияДляСверки, " ", "");
		ДопЗначенияДляСверки = СтрЗаменить(ДопЗначенияДляСверки, ";", ",");
		ДопЗначенияДляСверки = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ДопЗначенияДляСверки, ",", Истина);	
	КонецЕсли;
	
	// отработаем реквизиты шапки
	ТекущиеИНовыеРеквизиты =
		"Сделка.Дата КАК ТекДата,
		|_СделкиКВИК.Дата КАК НовДата,
		|Сделка.Проведен КАК ТекПроведен,
		|_СделкиКВИК.Проведен КАК НовПроведен";
		
	УсловиеПоискаРасхождений = "Сделка.Дата <> _СделкиКВИК.Дата ИЛИ Сделка.Проведен <> _СделкиКВИК.Проведен"; // перед &УсловиеПоискаРасхождений в той же строке в запросе стоит ИЛИ
	
	Для Каждого ДопРеквизит Из ДопЗначенияДляСверки Цикл
		
		ТекущиеИНовыеРеквизиты = ТекущиеИНовыеРеквизиты + "," + Символы.ПС + Символы.Таб
			+ "Сделка." + ДопРеквизит + " КАК Тек" + ДопРеквизит;
			
		ТекущиеИНовыеРеквизиты = ТекущиеИНовыеРеквизиты + "," + Символы.ПС + Символы.Таб
			+ "_СделкиКВИК." + ДопРеквизит + " КАК Нов" + ДопРеквизит;
					
	КонецЦикла;
		
	Для каждого РеквизитМД Из ДокументМД.Реквизиты Цикл
		
		Если НеОбрабатыватьРеквизиты.Найти(РеквизитМД.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущиеИНовыеРеквизиты = ТекущиеИНовыеРеквизиты + "," + Символы.ПС + Символы.Таб
			+ "Сделка." + РеквизитМД.Имя + " КАК Тек" + РеквизитМД.Имя;
			
		ТекущиеИНовыеРеквизиты = ТекущиеИНовыеРеквизиты + "," + Символы.ПС + Символы.Таб
			+ "_СделкиКВИК." + РеквизитМД.Имя + " КАК Нов" + РеквизитМД.Имя;
			
		Если НеИскатьРасхождения.Найти(РеквизитМД.Имя) = Неопределено Тогда
			УсловиеПоискаРасхождений = УсловиеПоискаРасхождений + Символы.ПС + Символы.Таб + Символы.Таб + Символы.Таб + "ИЛИ "
				+ "Сделка." + РеквизитМД.Имя + " <> _СделкиКВИК." + РеквизитМД.Имя;
		КонецЕсли;
			
	КонецЦикла;
	
	// отработаем реквизиты табличных частей
	Для каждого ТабЧастьМД Из ДокументМД.ТабличныеЧасти Цикл
		
		Если НеОбрабатыватьРеквизиты.Найти(ТабЧастьМД.Имя + ".*") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущиеИНовыеРеквизиты = ТекущиеИНовыеРеквизиты + "," + Символы.ПС + Символы.Таб
			+ "Сделка" + ТабЧастьМД.Имя + ".НомерСтроки КАК Тек" + ТабЧастьМД.Имя + "НомерСтроки";
		
		ТекущиеИНовыеРеквизиты = ТекущиеИНовыеРеквизиты + "," + Символы.ПС + Символы.Таб
			+ "_СделкиКВИК." + ТабЧастьМД.Имя + "НомерСтроки КАК Нов" + ТабЧастьМД.Имя + "НомерСтроки";
			
		Для каждого РеквизитМД Из ТабЧастьМД.Реквизиты Цикл
			
			Если НеОбрабатыватьРеквизиты.Найти(ТабЧастьМД.Имя + "." + РеквизитМД.Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТекущиеИНовыеРеквизиты = ТекущиеИНовыеРеквизиты + "," + Символы.ПС + Символы.Таб
				+ "Сделка" + ТабЧастьМД.Имя + "." + РеквизитМД.Имя + " КАК Тек" + ТабЧастьМД.Имя + РеквизитМД.Имя;
				
			ТекущиеИНовыеРеквизиты = ТекущиеИНовыеРеквизиты + "," + Символы.ПС + Символы.Таб
				+ "_СделкиКВИК." + ТабЧастьМД.Имя + РеквизитМД.Имя + " КАК Нов" + ТабЧастьМД.Имя + РеквизитМД.Имя;
				
			Если НеИскатьРасхождения.Найти(ТабЧастьМД.Имя + ".*") = Неопределено
				И НеИскатьРасхождения.Найти(ТабЧастьМД.Имя + "." + РеквизитМД.Имя) = Неопределено
			Тогда
				УсловиеПоискаРасхождений = УсловиеПоискаРасхождений + Символы.ПС + Символы.Таб + Символы.Таб + Символы.Таб + "ИЛИ "
					+ "Сделка" + ТабЧастьМД.Имя + "." + РеквизитМД.Имя + " <> _СделкиКВИК." + ТабЧастьМД.Имя + РеквизитМД.Имя;
				
				Если ТабЧастьМД.Имя = "ЦенныеБумагиВторойЧасти" Тогда
					УсловиеПоискаРасхождений = УсловиеПоискаРасхождений + " И Сделка.ЧастьСделкиРЕПО <> 2";
				КонецЕсли;
			КонецЕсли;
				
		КонецЦикла;
			
	КонецЦикла;
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекущиеИНовыеРеквизиты КАК ТекущиеИНовыеРеквизиты", ТекущиеИНовыеРеквизиты);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоискаРасхождений", УсловиеПоискаРасхождений);
	
КонецПроцедуры
	
Функция ИмпортироватьСделки(Брокер, МВТ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделка.Ссылка КАК Ссылка,
		|	Сделка.ВерсияДанных КАК ВерсияДанных,
		|	Сделка.ПометкаУдаления КАК ПометкаУдаления,
		|	Сделка.Номер КАК Номер,
		|	Сделка.Дата КАК Дата,
		|	Сделка.Проведен КАК Проведен,
		|	Сделка.Организация КАК Организация,
		|	Сделка.ВидСделки КАК ВидСделки,
		|	Сделка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Сделка.Рынок КАК Рынок,
		|	Сделка.Брокер КАК Брокер,
		|	Сделка.МестоХранения КАК МестоХранения,
		|	Сделка.РасчетныйСчет КАК РасчетныйСчет,
		|	Сделка.ВалютаСделки КАК ВалютаСделки,
		|	Сделка.НомерСделки КАК НомерСделки,
		|	Сделка.ВремяСделки КАК ВремяСделки,
		|	Сделка.КодРасчетовНаБирже КАК КодРасчетовНаБирже,
		|	Сделка.РежимБиржевыхТоргов КАК РежимБиржевыхТоргов,
		|	Сделка.НеполныеЛоты КАК НеполныеЛоты,
		|	Сделка.РежимПереговорныхСделок КАК РежимПереговорныхСделок,
		|	Сделка.КонтрагентНаБирже КАК КонтрагентНаБирже,
		|	Сделка.ВыкупЭмитентом КАК ВыкупЭмитентом,
		|	Сделка.ПервичноеРазмещение КАК ПервичноеРазмещение,
		|	Сделка.Контрагент КАК Контрагент,
		|	Сделка.РасчетныйСчетКонтрагента КАК РасчетныйСчетКонтрагента,
		|	Сделка.НомерДоговораКонтрагента КАК НомерДоговораКонтрагента,
		|	Сделка.Договор КАК Договор,
		|	Сделка.ОтложенноеИсполнение КАК ОтложенноеИсполнение,
		|	Сделка.ДатаИсполнения КАК ДатаИсполнения,
		|	Сделка.РаздельноеИсполнение КАК РаздельноеИсполнение,
		|	Сделка.ДатаОплаты КАК ДатаОплаты,
		|	Сделка.ДатаПоставки КАК ДатаПоставки,
		|	Сделка.ОтложеннаяОплатаТорговойКомиссии КАК ОтложеннаяОплатаТорговойКомиссии,
		|	Сделка.ДатаОплатыТорговойКомиссии КАК ДатаОплатыТорговойКомиссии,
		|	Сделка.ВалютаТорговойКомиссии КАК ВалютаТорговойКомиссии,
		|	Сделка.ВалютаОплаты КАК ВалютаОплаты,
		|	Сделка.СобственныйКурсОплаты КАК СобственныйКурсОплаты,
		|	Сделка.ПлатежноеУсловиеСделки КАК ПлатежноеУсловиеСделки,
		|	Сделка.КурсОплаты КАК КурсОплаты,
		|	Сделка.Ответственный КАК Ответственный,
		|	Сделка.Комментарий КАК Комментарий,
		|	Сделка.ПриобретениеПаев КАК ПриобретениеПаев,
		|	СделкаЦенныеБумаги.НомерСтроки КАК СделкаЦенныеБумагиНомерСтроки,
		|	ЕСТЬNULL(ЗначенияДополнительныхСведений.Значение, НЕОПРЕДЕЛЕНО) КАК КонтрагентВДопСведения
		|ПОМЕСТИТЬ _Сделки_1С
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|		ПО (СделкаЦенныеБумаги.Ссылка = Сделка.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ПО Сделка.Ссылка = ЗначенияДополнительныхСведений.Объект
		|			И (ЗначенияДополнительныхСведений.Свойство = &РаскрытыйКонтрагент)
		|			И (&ЭтоРэм_Траст)
		|ГДЕ
		|	Сделка.Организация = &Организация
		|	И НАЧАЛОПЕРИОДА(Сделка.Дата, ДЕНЬ) = &Период
		|	И Сделка.Брокер = &Брокер
		|	И НЕ Сделка.ПометкаУдаления
		|	И Сделка.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Сделки_1С.Ссылка) КАК Количество,
		|	_Сделки_1С.НомерСделки КАК НомерСделки
		|ПОМЕСТИТЬ _ДублиСделок_1С
		|ИЗ
		|	_Сделки_1С КАК _Сделки_1С
		|
		|СГРУППИРОВАТЬ ПО
		|	_Сделки_1С.НомерСделки
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Сделки_1С.Ссылка) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВнешниеДанные.DealDate КАК Дата,
		|	НАЧАЛОПЕРИОДА(_ВнешниеДанные.DealDate, ДЕНЬ) <= НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ) КАК Проведен,
		|	_ВнешниеДанные.ВидСделки КАК ВидСделки,
		|	&Организация КАК Организация,
		|	_ЦенныеБумаги.Рынок КАК Рынок,
		|	&Брокер КАК Брокер,
		|	ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка) КАК МестоХранения,
		|	_СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка) КАК РасчетныйСчет,
		|	_Валюты.Ссылка КАК ВалютаСделки,
		|	ВЫБОР
		|		КОГДА _ВнешниеДанные.Comission > 0
		|			ТОГДА &ВалютаУчета
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|	КОНЕЦ КАК ВалютаТорговойКомиссии,
		|	_ВнешниеДанные.DealNumber КАК НомерСделки,
		|	ДОБАВИТЬКДАТЕ(_ВнешниеДанные.DealTime, ГОД, РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(_ВнешниеДанные.DealTime, ГОД), ДАТАВРЕМЯ(1, 1, 1), ГОД)) КАК ВремяСделки,
		|	_ВнешниеДанные.PaymentCode КАК КодРасчетовНаБирже,
		|	ВЫБОР
		|		КОГДА _ВнешниеДанные.InstrumentClass ПОДОБНО ""%Неполные лоты%""
		|				ИЛИ _ВнешниеДанные.InstrumentClassCode = ""SMAL""
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК НеполныеЛоты,
		|	_ВнешниеДанные.PartnerOrganization КАК КонтрагентНаБирже,
		|	ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка) КАК Контрагент,
		|	ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка) КАК РасчетныйСчетКонтрагента,
		|	ВЫБОР
		|		КОГДА НАЧАЛОПЕРИОДА(_ВнешниеДанные.DealDate, ДЕНЬ) = _ВнешниеДанные.RepaymentDate
		|				ИЛИ _ВнешниеДанные.RepaymentDate = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ОтложенноеИсполнение,
		|	ВЫБОР
		|		КОГДА НАЧАЛОПЕРИОДА(_ВнешниеДанные.DealDate, ДЕНЬ) = _ВнешниеДанные.RepaymentDate
		|				ИЛИ _ВнешниеДанные.RepaymentDate = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		|		ИНАЧЕ _ВнешниеДанные.RepaymentDate
		|	КОНЕЦ КАК ДатаИсполнения,
		|	ЛОЖЬ КАК РаздельноеИсполнение,
		|	ВЫБОР
		|		КОГДА НАЧАЛОПЕРИОДА(_ВнешниеДанные.DealDate, ДЕНЬ) = _ВнешниеДанные.RepaymentDate
		|				ИЛИ _ВнешниеДанные.RepaymentDate = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		|		ИНАЧЕ _ВнешниеДанные.RepaymentDate
		|	КОНЕЦ КАК ДатаОплаты,
		|	ВЫБОР
		|		КОГДА НАЧАЛОПЕРИОДА(_ВнешниеДанные.DealDate, ДЕНЬ) = _ВнешниеДанные.RepaymentDate
		|				ИЛИ _ВнешниеДанные.RepaymentDate = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		|		ИНАЧЕ _ВнешниеДанные.RepaymentDate
		|	КОНЕЦ КАК ДатаПоставки,
		|	_Валюты.Ссылка КАК ВалютаОплаты,
		|	ЛОЖЬ КАК СобственныйКурсОплаты,
		|	НЕОПРЕДЕЛЕНО КАК КурсОплаты,
		|	ВЫБОР
		|		КОГДА НАЧАЛОПЕРИОДА(_ВнешниеДанные.DealDate, ДЕНЬ) <> _ВнешниеДанные.RepaymentDate
		|				И _ВнешниеДанные.RepaymentDate <> ДАТАВРЕМЯ(1, 1, 1)
		|				И НастройкиУчетаБэкОфисаСрезПоследних.СписаниеТорговойКомиссииПриИсполненииОтложеннойСделки
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОтложеннаяОплатаТорговойКомиссии,
		|	ВЫБОР
		|		КОГДА НАЧАЛОПЕРИОДА(_ВнешниеДанные.DealDate, ДЕНЬ) <> _ВнешниеДанные.RepaymentDate
		|				И _ВнешниеДанные.RepaymentDate <> ДАТАВРЕМЯ(1, 1, 1)
		|				И НастройкиУчетаБэкОфисаСрезПоследних.СписаниеТорговойКомиссииПриИсполненииОтложеннойСделки
		|			ТОГДА _ВнешниеДанные.RepaymentDate
		|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
		|	КОНЕЦ КАК ДатаОплатыТорговойКомиссии,
		|	1 КАК ЦенныеБумагиНомерСтроки,
		|	ЗНАЧЕНИЕ(Справочник.ДепозитарныеСчета.ПустаяСсылка) КАК ЦенныеБумагиДепозитарныйСчет,
		|	_Исполнители31.ДепозитарныйСчет КАК ЦенныеБумагиДепозитарныйСчет31,
		|	_Исполнители36.ДепозитарныйСчет КАК ЦенныеБумагиДепозитарныйСчет36,
		|	_ЦенныеБумаги.Ссылка КАК ЦенныеБумагиЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА _ВнешниеДанные.P_LotSize = 1
		|					И НЕ _ЦенныеБумаги.Ссылка ССЫЛКА Справочник.Облигации
		|					И НЕ _ВнешниеДанные.Price = 0
		|				ИЛИ _ЦенныеБумаги.Ссылка ССЫЛКА Справочник.ПроизводныеФинансовыеИнструменты
		|			ТОГДА _ВнешниеДанные.Quantity
		|		ИНАЧЕ _ВнешниеДанные.P_LotSize * _ВнешниеДанные.Quantity
		|	КОНЕЦ КАК ЦенныеБумагиКоличество,
		|	ВЫБОР
		|		КОГДА _ВнешниеДанные.P_LotSize = 0
		|				ИЛИ _ВнешниеДанные.Quantity = 0
		|			ТОГДА 0
		|		КОГДА _ВнешниеДанные.P_LotSize = 1
		|					И НЕ _ЦенныеБумаги.Ссылка ССЫЛКА Справочник.Облигации
		|				ИЛИ _ЦенныеБумаги.Ссылка ССЫЛКА Справочник.ПроизводныеФинансовыеИнструменты
		|			ТОГДА _ВнешниеДанные.Price
		|		ИНАЧЕ ВЫРАЗИТЬ(_ВнешниеДанные.Volume / (_ВнешниеДанные.P_LotSize * _ВнешниеДанные.Quantity) КАК ЧИСЛО(27, 6))
		|	КОНЕЦ КАК ЦенныеБумагиЦена,
		|	ВЫБОР
		|		КОГДА _ЦенныеБумаги.Ссылка ССЫЛКА Справочник.Облигации
		|			ТОГДА _ВнешниеДанные.Price
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ЦенныеБумагиЦенаПроцент,
		|	ВЫБОР
		|		КОГДА НЕ _ЦенныеБумаги.Ссылка ССЫЛКА Справочник.Облигации
		|				ИЛИ _ВнешниеДанные.P_LotSize = 0
		|				ИЛИ _ВнешниеДанные.Quantity = 0
		|			ТОГДА 0
		|		ИНАЧЕ ВЫРАЗИТЬ(_ВнешниеДанные.Coupon / (_ВнешниеДанные.P_LotSize * _ВнешниеДанные.Quantity) КАК ЧИСЛО(27, 12))
		|	КОНЕЦ КАК ЦенныеБумагиЦенаКупона,
		|	_ВнешниеДанные.Volume КАК ЦенныеБумагиСумма,
		|	_ВнешниеДанные.Coupon КАК ЦенныеБумагиСуммаКупона,
		|	_ВнешниеДанные.Comission КАК ЦенныеБумагиТорговаяКомиссия,
		|	_ВнешниеДанные.Operation КАК Operation,
		|	_ВнешниеДанные.Currency КАК Currency,
		|	_ВнешниеДанные.Client КАК Client,
		|	_ВнешниеДанные.InstrumentClassCode КАК InstrumentClassCode,
		|	_ВнешниеДанные.InstrumentCode КАК InstrumentCode,
		|	_ВнешниеДанные.P_LotSize КАК P_LotSize,
		|	ЕСТЬNULL(_РежимыБиржевыхТоргов.Ссылка, ЗНАЧЕНИЕ(Справочник.РежимыБиржевыхТоргов.ПустаяСсылка)) КАК РежимБиржевыхТоргов,
		|	ЕСТЬNULL(_РежимыБиржевыхТоргов.ТПлюс, ЛОЖЬ) КАК TPlus,
		|	ЕСТЬNULL(_РежимыБиржевыхТоргов.ПервичноеРазмещение, ЛОЖЬ) КАК ПервичноеРазмещение,
		|	ЕСТЬNULL(_РежимыБиржевыхТоргов.РежимПереговорныхСделок, ЛОЖЬ) КАК РежимПереговорныхСделок,
		|	ЕСТЬNULL(_РежимыБиржевыхТоргов.ВыкупЭмитентом, ЛОЖЬ) КАК ВыкупЭмитентом,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_РежимыБиржевыхТоргов.ФлагЗаписатьДанныеОбЭмитенте, ЛОЖЬ) = ИСТИНА
		|			ТОГДА _ЦенныеБумаги.ЭмитентЮрЛицо
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК КонтрагентВДопСведения
		|ПОМЕСТИТЬ _СделкиКВИК
		|ИЗ
		|	_ВнешниеДанные КАК _ВнешниеДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумаги КАК _ЦенныеБумаги
		|		ПО _ВнешниеДанные.InstrumentCode = _ЦенныеБумаги.InstrumentCode
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ПО _ВнешниеДанные.Client = _СчетаДоверительногоУправления.Client
		|			И _ВнешниеДанные.Briefcase = _СчетаДоверительногоУправления.Briefcase
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Валюты КАК _Валюты
		|		ПО _ВнешниеДанные.Currency = _Валюты.Currency
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Исполнители31 КАК _Исполнители31
		|		ПО _ВнешниеДанные.Client = _Исполнители31.Client
		|			И _ВнешниеДанные.Briefcase = _Исполнители31.Briefcase
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Исполнители36 КАК _Исполнители36
		|		ПО _ВнешниеДанные.Client = _Исполнители36.Client
		|			И _ВнешниеДанные.Briefcase = _Исполнители36.Briefcase
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РежимыБиржевыхТоргов КАК _РежимыБиржевыхТоргов
		|		ПО _ВнешниеДанные.InstrumentClassCode = _РежимыБиржевыхТоргов.InstrumentClassCode
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаБэкОфиса.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Брокер = &Брокер) КАК НастройкиУчетаБэкОфисаСрезПоследних
		|		ПО (1 = 1)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ВидСделки,
		|	НомерСделки,
		|	ЦенныеБумагиНомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ТекущиеИНовыеРеквизиты КАК ТекущиеИНовыеРеквизиты,
		|	Сделка.Ссылка КАК Документ,
		|	ВЫБОР
		|		КОГДА Сделка.Ссылка ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЭтоНовыйДокумент,
		|	ВЫБОР
		|		КОГДА _СделкиКВИК.Дата ЕСТЬ NULL
		|				ИЛИ Сделка.Ссылка ЕСТЬ NULL
		|				ИЛИ НЕ Сделка.Проведен
		|				ИЛИ &УсловиеПоискаРасхождений
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьРасхождения,
		|	ВЫБОР
		|		КОГДА _СделкиКВИК.КонтрагентВДопСведения <> Сделка.КонтрагентВДопСведения
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьРасхожденияВДопСведениях,
		|	_СделкиКВИК.ЦенныеБумагиДепозитарныйСчет31 КАК ЦенныеБумагиДепозитарныйСчет31,
		|	_СделкиКВИК.ЦенныеБумагиДепозитарныйСчет36 КАК ЦенныеБумагиДепозитарныйСчет36,
		|	_СделкиКВИК.TPlus КАК TPlus,
		|	_СделкиКВИК.Operation КАК Operation,
		|	_СделкиКВИК.Currency КАК Currency,
		|	_СделкиКВИК.Client КАК Client,
		|	_СделкиКВИК.InstrumentClassCode КАК InstrumentClassCode,
		|	_СделкиКВИК.InstrumentCode КАК InstrumentCode,
		|	_СделкиКВИК.P_LotSize КАК P_LotSize,
		|	ЕСТЬNULL(_СделкиКВИК.НомерСделки, 0) КАК НомерСделки
		|ПОМЕСТИТЬ _ИмпортируемыеСделки
		|ИЗ
		|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Сделки_1С КАК Сделка
		|			ЛЕВОЕ СОЕДИНЕНИЕ _ДублиСделок_1С КАК _ДублиСделок_1С
		|			ПО Сделка.НомерСделки = _ДублиСделок_1С.НомерСделки
		|		ПО СделкаЦенныеБумаги.Ссылка = Сделка.Ссылка
		|		ПОЛНОЕ СОЕДИНЕНИЕ _СделкиКВИК КАК _СделкиКВИК
		|		ПО (Сделка.ВидСделки = _СделкиКВИК.ВидСделки)
		|			И (Сделка.НомерСделки = _СделкиКВИК.НомерСделки)
		|			И СделкаЦенныеБумаги.НомерСтроки = _СделкиКВИК.ЦенныеБумагиНомерСтроки
		|ГДЕ
		|	_ДублиСделок_1С.НомерСделки ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИмпортируемыеСделки.НомерСделки КАК НомерСделки,
		|	NULL КАК Документ,
		|	СУММА(1) КАК Количество
		|ПОМЕСТИТЬ _ОшибкиИмпортируемыхСделок
		|ИЗ
		|	_ИмпортируемыеСделки КАК _ИмпортируемыеСделки
		|ГДЕ
		|	_ИмпортируемыеСделки.НомерСделки <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	_ИмпортируемыеСделки.НомерСделки,
		|	_ИмпортируемыеСделки.Документ
		|
		|ИМЕЮЩИЕ
		|	СУММА(1) > 1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ИмпортируемыеСделки.НомерСделки,
		|	_ИмпортируемыеСделки.Документ,
		|	1
		|ИЗ
		|	_ИмпортируемыеСделки КАК _ИмпортируемыеСделки
		|ГДЕ
		|	_ИмпортируемыеСделки.НомерСделки = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Звездочка КАК Звездочка
		|ИЗ
		|	_ИмпортируемыеСделки КАК _ИмпортируемыеСделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиИмпортируемыхСделок КАК _ОшибкиИмпортируемыхСделок
		|		ПО _ИмпортируемыеСделки.НомерСделки = _ОшибкиИмпортируемыхСделок.НомерСделки
		|ГДЕ
		|	&ЕстьРасхождения
		|	И _ОшибкиИмпортируемыхСделок.НомерСделки ЕСТЬ NULL"
		+
		"
		|УПОРЯДОЧИТЬ ПО
		|	НовНомерСделки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _Сделки_1С
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _СделкиКВИК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ИмпортируемыеСделки"
		;
#КонецОбласти
	
	ДополнитьТекстЗапросаТекущимиИНовымиРеквизитами(Запрос.Текст, Метаданные.Документы.Сделка,
		"Контрагент, НомерДоговораКонтрагента, ДепозитарныйСчетКонтрагента, ПортфельКонтрагента, Ответственный, Комментарий, Договор, ЦенныеБумаги.Портфель, ЦенныеБумаги.СтрокаПартии, ПлатежноеУсловиеСделки, ПриобретениеПаев, НомерПорученияУБрокера, ДатаПорученияУБрокера",
		"МестоХранения, ЦенныеБумаги.ДепозитарныйСчет", "КонтрагентВДопСведения");
		
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.ДатаИмпорта);	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВалютаУчета", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета"));
	Запрос.УстановитьПараметр("Брокер", Брокер);	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("ЭтоРэм_Траст", (ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ") Или ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ")));
	Запрос.УстановитьПараметр("РаскрытыйКонтрагент", ПланыВидовХарактеристик.ДополнительныеСведения.НайтиПоРеквизиту("Ключ", "_РаскрытыйКонтрагент"));
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЕстьРасхождения", ?(ЭтотОбъект.ОтображатьТолькоРасхождения, "ЕстьРасхождения", "Истина"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");
	
	ИмпортируемыеДанные = Запрос.Выполнить().Выгрузить();
		
	ДублиСделок1С = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДублиСделок_1С"].ПолучитьДанные().Выбрать();
	
	Пока ДублиСделок1С.Следующий() Цикл
		ЗарегистрироватьОшибкуИмпорта("В базе обнаружены дубли сделок. У " + Строка(ДублиСделок1С.Количество) + " сделок одинаковый номер [" + ДублиСделок1С.НомерСделки + "].");
	КонецЦикла;
	
	ОшибкиИмпортируемыхСделок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиИмпортируемыхСделок"].ПолучитьДанные().Выбрать();
	
	Пока ОшибкиИмпортируемыхСделок.Следующий() Цикл
		
		Если ОшибкиИмпортируемыхСделок.НомерСделки = 0 Тогда
			ЗарегистрироватьОшибкуИмпорта("В 1С обнаружена сделка [" + ОшибкиИмпортируемыхСделок.Документ + "], которой нет в QUIKе. Проверьте вывод данных (ODBC) из QUIKа.");
		Иначе
			ЗарегистрироватьОшибкуИмпорта("Сделка [" + ОшибкиИмпортируемыхСделок.НомерСделки + "] не будет загружена, т.к. при формировании данных для загрузки обнаружено несколько записей [" + Строка(ОшибкиИмпортируемыхСделок.Количество) + "].");
		КонецЕсли;
		
	КонецЦикла;
		
	Если ДублиСделок1С.Количество() > 0 Или ОшибкиИмпортируемыхСделок.Количество() > 0 Тогда
		Возврат Неопределено;
	Конецесли;
			
	ПроверитьЗаполнениеИмпортируемыхСделок(ИмпортируемыеДанные, Истина, "Сделка");
	
	Возврат ИмпортируемыеДанные;
	
КонецФункции

Функция ИмпортироватьБудущиеИсполненияОбязательствПоСделкам(Брокер, МВТ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделка.НомерСделки КАК НомерСделки,
		|	ВЫБОР
		|		КОГДА Сделка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА ДОБАВИТЬКДАТЕ(Сделка.ДатаИсполнения, СЕКУНДА, 34200)
		|		КОГДА Сделка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|			ТОГДА ДОБАВИТЬКДАТЕ(Сделка.ДатаИсполнения, СЕКУНДА, 34201)
		|	КОНЕЦ КАК Дата,
		|	ИСТИНА КАК Проведен,
		|	Сделка.Организация КАК Организация,
		|	Сделка.Ссылка КАК Основание,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке) КАК ВидЗадолженности,
		|	Сделка.ВидСделки КАК ВидСделки,
		|	Сделка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Сделка.Рынок КАК Рынок,
		|	Сделка.МестоХранения КАК МестоХранения,
		|	Сделка.Брокер КАК Брокер,
		|	Сделка.РасчетныйСчет КАК РасчетныйСчет,
		|	Сделка.ВалютаСделки КАК ВалютаСделки,
		|	СделкаЦенныеБумаги.НомерСтроки КАК ЦенныеБумагиНомерСтроки,
		|	СделкаЦенныеБумаги.ДепозитарныйСчет КАК ЦенныеБумагиДепозитарныйСчет,
		|	СделкаЦенныеБумаги.ЦеннаяБумага КАК ЦенныеБумагиЦеннаяБумага,
		|	СделкаЦенныеБумаги.Количество КАК ЦенныеБумагиКоличество,
		|	СделкаЦенныеБумаги.Цена КАК ЦенныеБумагиЦена,
		|	СделкаЦенныеБумаги.ЦенаПроцент КАК ЦенныеБумагиЦенаПроцент,
		|	СделкаЦенныеБумаги.ЦенаКупона КАК ЦенныеБумагиЦенаКупона,
		|	СделкаЦенныеБумаги.Сумма КАК ЦенныеБумагиСумма,
		|	СделкаЦенныеБумаги.СуммаКупона КАК ЦенныеБумагиСуммаКупона
		|ПОМЕСТИТЬ _СделкиКВИК
		|ИЗ
		|	_ВнешниеДанные КАК _ВнешниеДанные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|			ПО Сделка.Ссылка = СделкаЦенныеБумаги.Ссылка
		|			ЛЕВОЕ СОЕДИНЕНИЕ _ДублиСделок_1С КАК _ДублиСделок_1С
		|			ПО Сделка.НомерСделки = _ДублиСделок_1С.НомерСделки
		|		ПО _ВнешниеДанные.DealNumber = Сделка.НомерСделки
		|			И _ВнешниеДанные.ВидСделки = Сделка.ВидСделки
		|			И Сделка.Организация = &Организация 
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаБэкОфиса.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Брокер = &Брокер) КАК НастройкиУчетаБэкОфисаСрезПоследних
		|		ПО (1 = 1)
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(_ВнешниеДанные.DealDate, ДЕНЬ) <> _ВнешниеДанные.RepaymentDate
		|	И _ВнешниеДанные.RepaymentDate <> ДАТАВРЕМЯ(1, 1, 1)
		|	И НЕ Сделка.ПометкаУдаления
		|	И _ДублиСделок_1С.НомерСделки ЕСТЬ NULL
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Сделка.ВидСделки,
		|	НомерСделки,
		|	ЦенныеБумагиНомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсполнениеОбязательствПоСделке.Ссылка КАК Ссылка,
		|	ИсполнениеОбязательствПоСделке.ВерсияДанных КАК ВерсияДанных,
		|	ИсполнениеОбязательствПоСделке.ПометкаУдаления КАК ПометкаУдаления,
		|	ИсполнениеОбязательствПоСделке.Номер КАК Номер,
		|	ИсполнениеОбязательствПоСделке.Дата КАК Дата,
		|	ИсполнениеОбязательствПоСделке.Проведен КАК Проведен,
		|	ИсполнениеОбязательствПоСделке.Организация КАК Организация,
		|	ИсполнениеОбязательствПоСделке.Основание КАК Основание,
		|	ИсполнениеОбязательствПоСделке.ВидЗадолженности КАК ВидЗадолженности,
		|	ИсполнениеОбязательствПоСделке.ВидСделки КАК ВидСделки,
		|	ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ИсполнениеОбязательствПоСделке.Рынок КАК Рынок,
		|	ИсполнениеОбязательствПоСделке.Брокер КАК Брокер,
		|	ИсполнениеОбязательствПоСделке.МестоХранения КАК МестоХранения,
		|	ИсполнениеОбязательствПоСделке.РасчетныйСчет КАК РасчетныйСчет,
		|	ИсполнениеОбязательствПоСделке.ВалютаСделки КАК ВалютаСделки,
		|	ИсполнениеОбязательствПоСделке.Ответственный КАК Ответственный,
		|	ИсполнениеОбязательствПоСделке.Комментарий КАК Комментарий,
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.НомерСтроки КАК НомерСтроки,
		|	ВЫРАЗИТЬ(ИсполнениеОбязательствПоСделке.Основание КАК Документ.Сделка).НомерСделки КАК НомерСделки
		|ПОМЕСТИТЬ _Исполнения_1С
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК ИсполнениеОбязательствПоСделкеЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|		ПО ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка = ИсполнениеОбязательствПоСделке.Ссылка
		|ГДЕ
		|	(НАЧАЛОПЕРИОДА(ИсполнениеОбязательствПоСделке.Основание.Дата, ДЕНЬ) = &Период
		|				И ИсполнениеОбязательствПоСделке.Организация = &Организация
		|				И ИсполнениеОбязательствПоСделке.Брокер = &Брокер
		|				И НЕ ИсполнениеОбязательствПоСделке.ПометкаУдаления
		|				И ИсполнениеОбязательствПоСделке.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|			ИЛИ ИсполнениеОбязательствПоСделке.Ссылка ЕСТЬ NULL)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Исполнения_1С.Ссылка) КАК Количество,
		|	_Исполнения_1С.НомерСтроки КАК НомерСтроки,
		|	_Исполнения_1С.НомерСделки КАК НомерСделки
		|ПОМЕСТИТЬ _ДублиИсполнений_1С
		|ИЗ
		|	_Исполнения_1С КАК _Исполнения_1С
		|
		|СГРУППИРОВАТЬ ПО
		|	_Исполнения_1С.НомерСтроки,
		|	_Исполнения_1С.НомерСделки
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Исполнения_1С.Ссылка) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_СделкиКВИК.НомерСделки, 0) КАК НовНомерСделки,
		|	&ТекущиеИНовыеРеквизиты КАК ТекущиеИНовыеРеквизиты,
		|	Сделка.Ссылка КАК Документ,
		|	ВЫБОР
		|		КОГДА Сделка.Ссылка ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЭтоНовыйДокумент,
		|	ВЫБОР
		|		КОГДА _СделкиКВИК.Дата ЕСТЬ NULL
		|				ИЛИ Сделка.Ссылка ЕСТЬ NULL
		|				ИЛИ &УсловиеПоискаРасхождений
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьРасхождения,
		|	1 КАК P_LotSize
		|ПОМЕСТИТЬ _ИмпортируемыеСделки
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Исполнения_1С КАК Сделка
		|			ЛЕВОЕ СОЕДИНЕНИЕ _ДублиИсполнений_1С КАК _ДублиИсполнений_1С
		|			ПО Сделка.НомерСделки = _ДублиИсполнений_1С.НомерСделки
		|		ПО СделкаЦенныеБумаги.Ссылка = Сделка.Ссылка
		|		ПОЛНОЕ СОЕДИНЕНИЕ _СделкиКВИК КАК _СделкиКВИК
		|		ПО (Сделка.Организация = _СделкиКВИК.Организация)
		|			И (Сделка.ВидСделки = _СделкиКВИК.ВидСделки)
		|			И (Сделка.НомерСделки = _СделкиКВИК.НомерСделки)
		|			И СделкаЦенныеБумаги.НомерСтроки = _СделкиКВИК.ЦенныеБумагиНомерСтроки
		|ГДЕ
		|	_ДублиИсполнений_1С.НомерСделки ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИмпортируемыеСделки.НовНомерСделки КАК НомерСделки,
		|	NULL КАК Документ,
		|	СУММА(1) КАК Количество
		|ПОМЕСТИТЬ _ОшибкиИмпортируемыхИсполнений
		|ИЗ
		|	_ИмпортируемыеСделки КАК _ИмпортируемыеСделки
		|ГДЕ
		|	_ИмпортируемыеСделки.НовНомерСделки <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	_ИмпортируемыеСделки.НовНомерСделки,
		|	_ИмпортируемыеСделки.Документ
		|
		|ИМЕЮЩИЕ
		|	СУММА(1) > 1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ИмпортируемыеСделки.НовНомерСделки,
		|	_ИмпортируемыеСделки.Документ,
		|	1
		|ИЗ
		|	_ИмпортируемыеСделки КАК _ИмпортируемыеСделки
		|ГДЕ
		|	_ИмпортируемыеСделки.НовНомерСделки = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Звездочка КАК Звездочка
		|ИЗ
		|	_ИмпортируемыеСделки КАК _ИмпортируемыеСделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиИмпортируемыхИсполнений КАК _ОшибкиИмпортируемыхИсполнений
		|		ПО _ИмпортируемыеСделки.НовНомерСделки = _ОшибкиИмпортируемыхИсполнений.НомерСделки
		|ГДЕ
		|	&ЕстьРасхождения
		|	И _ОшибкиИмпортируемыхИсполнений.НомерСделки ЕСТЬ NULL"
		+
		"
		|УПОРЯДОЧИТЬ ПО
		|	НовНомерСделки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _СделкиКВИК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _Исполнения_1С
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ИмпортируемыеСделки";
#КонецОбласти
	
	ДополнитьТекстЗапросаТекущимиИНовымиРеквизитами(Запрос.Текст, Метаданные.Документы.ИсполнениеОбязательствПоСделке,
		"КонтрагентНаБирже, Ответственный, Комментарий, ЦенныеБумаги.Портфель, ЦенныеБумаги.СтрокаПартии", "", "");
		
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.ДатаИмпорта);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер", Брокер);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЕстьРасхождения", ?(ЭтотОбъект.ОтображатьТолькоРасхождения, "ЕстьРасхождения", "Истина"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");
	
	ИмпортируемыеДанные = Запрос.Выполнить().Выгрузить();
	
	ДублиИсполнений = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДублиИсполнений_1С"].ПолучитьДанные().Выбрать();
	
	Пока ДублиИсполнений.Следующий() Цикл
		ЗарегистрироватьОшибкуИмпорта("В базе обнаружены дубли исполнений сделок. У сделки [" + ДублиИсполнений.НомерСделки + "] " + Строка(ДублиИсполнений.Количество) + " исполнени" + ?(ДублиИсполнений.Количество > 4, "й", "я") + ".");
	КонецЦикла;
	
	ОшибкиИмпортируемыхИсполнений = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиИмпортируемыхИсполнений"].ПолучитьДанные().Выбрать();
	
	Пока ОшибкиИмпортируемыхИсполнений.Следующий() Цикл
		
		Если ОшибкиИмпортируемыхИсполнений.НомерСделки = 0 Тогда
			ЗарегистрироватьОшибкуИмпорта("В 1С обнаружен документ [" + ОшибкиИмпортируемыхИсполнений.Документ + "], для которого не удалось определить сделку основание из данных QUIKа. Проверьте вывод данных (ODBC) из QUIKа.");
		Иначе
			ЗарегистрироватьОшибкуИмпорта("Исполнение обязательств по сделке [" + ОшибкиИмпортируемыхИсполнений.НомерСделки + "] не будет загружено, т.к. при формировании данных для загрузки обнаружено несколько записей [" + Строка(ОшибкиИмпортируемыхИсполнений.Количество) + "].");
		КонецЕсли;
		
	КонецЦикла;
	
	//Временные таблицы сделок и исполнений по сделкам удаляем после формирования данных для исполнений.
	УдалитьВременныеТаблицы("Сделка", МВТ);
	
	Если ДублиИсполнений.Количество() > 0 Или ОшибкиИмпортируемыхИсполнений.Количество() > 0 Тогда
		Возврат Неопределено;
	Конецесли;
	
	ПроверитьЗаполнениеИмпортируемыхСделок(ИмпортируемыеДанные, Ложь, "ИсполнениеОбязательствПоСделке");
	
	Возврат ИмпортируемыеДанные;
		
КонецФункции

Функция ИмпортироватьСделкиРЕПО(Брокер, МВТ, ЧастьСделкиРепо = Неопределено)
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	//Для сделок в режиме Репо-м брокер расчитывает сумму сделки (без НКД) по формуле СуммаРепо - СуммаКупона (RepoSum - Coupon)
	//В QUIKе сумма сделки (без НКД) отражена в поле Volume, но у сделок в Режиме Репо-М это значение не всегда равно значению (RepoSum - Coupon).
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаРЕПО.Ссылка КАК Ссылка,
		|	СделкаРЕПО.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
		|	СделкаРЕПО.НомерСделки КАК НомерСделки
		|ПОМЕСТИТЬ _СделкиРЕПО_1С
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПО
		|ГДЕ
		|	СделкаРЕПО.Организация = &Организация
		|	И НЕ СделкаРЕПО.ПометкаУдаления
		|	И СделкаРЕПО.Брокер = &Брокер
		|	И СделкаРЕПО.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И (СделкаРЕПО.ЧастьСделкиРЕПО = 1
		|				И НАЧАЛОПЕРИОДА(СделкаРЕПО.Дата, ДЕНЬ) = &Период
		|			ИЛИ СделкаРЕПО.ЧастьСделкиРЕПО = 2
		|				И НАЧАЛОПЕРИОДА(СделкаРЕПО.ПерваяЧастьРЕПО.Дата, ДЕНЬ) = &Период)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _СделкиРЕПО_1С.Ссылка) КАК Количество,
		|	_СделкиРЕПО_1С.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
		|	_СделкиРЕПО_1С.НомерСделки КАК НомерСделки
		|ПОМЕСТИТЬ _ДублиСделокРЕПО_1С
		|ИЗ
		|	_СделкиРЕПО_1С КАК _СделкиРЕПО_1С
		|ГДЕ
		|	_СделкиРЕПО_1С.НомерСделки <> """"
		|
		|СГРУППИРОВАТЬ ПО
		|	_СделкиРЕПО_1С.ЧастьСделкиРЕПО,
		|	_СделкиРЕПО_1С.НомерСделки
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _СделкиРЕПО_1С.Ссылка) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СделкиРЕПО_1С.Ссылка КАК Ссылка,
		|	_СделкиРЕПО_1С.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
		|	_СделкиРЕПО_1С.НомерСделки КАК НомерСделки,
		|	СделкаРЕПОЦенныеБумаги.ДепозитарныйСчет КАК ДепозитарныйСчет
		|ПОМЕСТИТЬ _СделкиРЕПО
		|ИЗ
		|	_СделкиРЕПО_1С КАК _СделкиРЕПО_1С
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДублиСделокРЕПО_1С КАК _ДублиСделокРЕПО_1С
		|		ПО _СделкиРЕПО_1С.НомерСделки = _ДублиСделокРЕПО_1С.НомерСделки
		|			И _СделкиРЕПО_1С.ЧастьСделкиРЕПО = _ДублиСделокРЕПО_1С.ЧастьСделкиРЕПО
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО.ЦенныеБумаги КАК СделкаРЕПОЦенныеБумаги
		|		ПО _СделкиРЕПО_1С.Ссылка = СделкаРЕПОЦенныеБумаги.Ссылка
		|			И (СделкаРЕПОЦенныеБумаги.НомерСтроки = 1)
		|ГДЕ
		|	_ДублиСделокРЕПО_1С.НомерСделки ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА _ВнешниеДанные.RepoPart = 2
		|			ТОГДА ВЫБОР
		|					КОГДА _ВнешниеДанные.Operation = ""Купля""
		|							ИЛИ _ВнешниеДанные.Operation = ""BUY""
		|						ТОГДА ДОБАВИТЬКДАТЕ(_ВнешниеДанные.DealDate, СЕКУНДА, 34200)
		|					КОГДА _ВнешниеДанные.Operation = ""Продажа""
		|							ИЛИ _ВнешниеДанные.Operation = ""SELL""
		|						ТОГДА ДОБАВИТЬКДАТЕ(_ВнешниеДанные.DealDate, СЕКУНДА, 34260)
		|				КОНЕЦ
		|		ИНАЧЕ _ВнешниеДанные.DealDate
		|	КОНЕЦ КАК Дата,
		|	ИСТИНА КАК Проведен,
		|	ИСТИНА КАК ДвеЧастиСделкиРЕПО,
		|	_ВнешниеДанные.RepoPart КАК ЧастьСделкиРЕПО,
		|	ВЫБОР
		|		КОГДА _ВнешниеДанные.RepoPart = 2
		|			ТОГДА _ПервыеЧастиСделокРепо.Ссылка
		|		ИНАЧЕ ЗНАЧЕНИЕ(Документ.СделкаРЕПО.ПустаяСсылка)
		|	КОНЕЦ КАК ПерваяЧастьРЕПО,
		|	ВЫБОР
		|		КОГДА _ВнешниеДанные.RepoPart = 2
		|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		|		ИНАЧЕ ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(_ВнешниеДанные.DealDate, ДЕНЬ), ДЕНЬ, _ВнешниеДанные.Duration)
		|	КОНЕЦ КАК ДатаВторойЧастиРЕПО,
		|	_ВнешниеДанные.ВидСделки КАК ВидСделки,
		|	ВЫБОР
		|		КОГДА _ВнешниеДанные.RepoPart = 1
		|			ТОГДА _ВнешниеДанные.RepoRate
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СтавкаРЕПО,
		|	0 КАК БазаРасчетаПроцентов,
		|	&Организация КАК Организация,
		|	&Брокер КАК Брокер,
		|	ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка) КАК МестоХранения,
		|	_СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка) КАК РасчетныйСчет,
		|	_ЦенныеБумаги.Рынок КАК Рынок,
		|	_Валюты.Ссылка КАК ВалютаСделки,
		|	ВЫБОР
