	//	
	//	МассивСверкаСМесячнымОтчетомБрокера = СверкаСОтчетомБрокера(Истина);
	//Иначе
	//	МассивСверкаСМесячнымОтчетомБрокера = Новый Массив();		
	//	Объект.ПутьКФайлуОстатков = ПолучитьИмяФайлаОстатков(Объект.Организация, ДатаСверки);
	//КонецЕсли;	
		
	//Возврат Новый Структура("СверкаСОтчетомБрокера, СверкаСМесячнымОтчетомБрокера", 
	//	ДанныеСверкиДляБухгалтерии, 
	//	МассивСверкаСМесячнымОтчетомБрокера);	
		
	Возврат Новый Структура("СверкаСОтчетомБрокера", ДанныеСверкиДляБухгалтерии);	
		
		
КонецФункции

#Область Служебные_и_вспомогательные_функции

&НаСервере
Процедура ЗафиксироватьРезультатСверки(ДанныеОСверке)
	
	Если ЭтаФорма.ВыводитьОтчетОПодтвержденныхОперациях Тогда
		ПараметрыОтчета = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент("Отчет о подтвержденных операциях", , , ЭтаФорма.ОтчетОПодтвержденныхОперациях);
	КонецЕсли;
		
	ТаблицаСверки = ?(ТипЗнч(ДанныеОСверке) = Тип("Строка"), ПолучитьИзВременногоХранилища(ДанныеОСверке), ДанныеОСверке);
	
	Для Каждого СтрокаСверки Из ТаблицаСверки Цикл
		
		РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.ЗафиксироватьРезультатСверки(
			Объект.Организация,
			СтрокаСверки.СчетДоверительногоУправления,
			ЭтаФорма.ДатаСверки,
			Справочники.ВнешниеСистемы.ОтчетБрокераБКРегион,
			СтрокаСверки.СверкаПройденаУспешно,
			Ложь,
			ЭтаФорма.ВремяСверки,
			СтрокаСверки.Примечание);
		
		// Подтверждаем, если не было расхождений
		
		Если СтрокаСверки.ОтсутствуютРасхождения Тогда 
			
			ПодтвердитьОперацииСБрокером(
				СтрокаСверки.СчетДоверительногоУправления,
				СтрокаСверки.НеподтвержденныеОперации,
				ЭтаФорма.ВремяСверки,
				ПараметрыОтчета);
			
		КонецЕсли;
		
	КонецЦикла;

	// Установим ширину колонок и отобразим отчет
	
	Если ЭтаФорма.ВыводитьОтчетОПодтвержденныхОперациях Тогда
		
		РаботаСОтчетами.УстановитьШиринуКолонок(ПараметрыОтчета);
		
		Элементы.ГруппаОтчетОПодтвержденныхОперациях.Видимость = Истина;	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступность(Форма)
	
	Элементы = Форма.Элементы;
	
	СверкаЗаОдинДень = (Не Форма.СверкаЗаПериод Или Форма.СверкаЗаПериод И Форма.ПериодСверки.ДатаНачала = НачалоДня(Форма.ПериодСверки.ДатаОкончания));
	
	Форма.ФиксироватьРезультатСверки            = ?(СверкаЗаОдинДень И Форма.СверкаСОтчетомHTML, Форма.ФиксироватьРезультатСверки, Ложь);
	Форма.СверкаСМесячнымОтчетомБрокера         = ?(СверкаЗаОдинДень И Форма.СверкаСОтчетомHTML, Форма.СверкаСМесячнымОтчетомБрокера, Ложь);
	Форма.ВыводитьОтчетОПодтвержденныхОперациях = ?(СверкаЗаОдинДень И Форма.СверкаСОтчетомHTML, Форма.ВыводитьОтчетОПодтвержденныхОперациях, Ложь);
	
	Элементы.ФиксироватьРезультатСверки.Доступность             = (СверкаЗаОдинДень И Форма.СверкаСОтчетомHTML И Не Форма.СверкаСМесячнымОтчетомБрокера);
	Элементы.СверкаСМесячнымОтчетомБрокера.Доступность          = (СверкаЗаОдинДень И Форма.СверкаСОтчетомHTML);
	Элементы.ВремяСверки.Доступность						    = Форма.ФиксироватьРезультатСверки;
	Элементы.СверятьОстаткиДСБезУчетаВалютнойСекции.Доступность = Форма.СверкаСОтчетомHTML;     
	Элементы.ВыводитьОтчетОПодтвержденныхОперациях.Доступность  = (Форма.ФиксироватьРезультатСверки И СверкаЗаОдинДень И Форма.СверкаСОтчетомHTML);
	
	Элементы.СтраницаОтчетовСверкиСФайламиHTML.Видимость   = Форма.СверкаСОтчетомHTML;
	Элементы.СтраницаОтчетовСверкиСФайламиXML.Видимость    = Форма.СверкаСФайламиXML;
	Элементы.СтраницаОтчетовСверкиСФайламиOTBR.Видимость   = Форма.СверкаСФайламиOTBR;
	
	Элементы.СверкаСДаннымиФайловXML.Доступность  = Форма.СверкаЗаПериод Или Форма.ДатаСверки < Дата(2021,04,01);
	Элементы.СверкаСДаннымиФайловXML.Видимость    = Форма.СверкаЗаПериод Или Форма.ДатаСверки < Дата(2021,04,01);
	Элементы.ПериодСверки.Видимость               = Форма.СверкаЗаПериод;
	Элементы.ДатаСверки.Видимость                 = Не Форма.СверкаЗаПериод;
		
КонецПроцедуры

&НаСервере
Процедура ОбработатьОчередиЗагрузкиНаСервере()

	ИмпортироватьИзНесколькихФайлов = РаботаСВнешнимиСистемами.ИмпортРазделенПоОчередям(Объект.Организация);		
	Элементы.ОчередьЗагрузки.Видимость = ИмпортироватьИзНесколькихФайлов;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗарегистрироватьНовуюОшибку(ЖурналОшибок, ТекстОшибки)
	
	Если ЖурналОшибок.Найти(ТекстОшибки) = Неопределено Тогда
		ЖурналОшибок.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры // ЗарегистрироватьНовуюОшибку

&НаСервере
Функция ПолучитьИмяФайлаОстатков(Организация, Период) Экспорт
	
	Если ТипЗнч(Период) = Тип("СтандартныйПериод") Тогда

		Если РаботаСВнешнимиСистемами.ИмпортРазделенПоОчередям(Организация) Тогда
			
			КаталогОтчетаСОчередью = "";
			
			Если Объект.ОчередьЗагрузки = 0 Тогда		
				
				КоличествоОчередей = РаботаСВнешнимиСистемами.КоличествоОчередейОрганизации(Организация);
				
				Для Очередь = 1 По КоличествоОчередей Цикл
					КаталогОтчетаСОчередью = КаталогОтчетаСОчередью + ";" + ПолучитьКаталогСОтчетами(Организация, Период, Очередь);						
				КонецЦикла;
				
			Иначе
				//КаталогОтчетаСОчередью = КаталогОтчетаСОчередью + ";" + ПолучитьКаталогОтчетаСОчередью("ВнешниеОбработки.ФайловаяСверкаСБрокеромБКРегион.КаталогФайловОстатковМатрих", Организация, ДатаОстатков, Объект.ОчередьЗагрузки);
				КаталогОтчетаСОчередью = ПолучитьКаталогСОтчетами(Организация, Период, Объект.ОчередьЗагрузки);
			КонецЕсли;
			
			Возврат Сред(КаталогОтчетаСОчередью, 2);
			
		Иначе
			Возврат ПолучитьКаталогСОтчетами(Организация, Период, Очередь);
			//Возврат "\\am-1c00\Арчи\Data\MX_Remains_2017-08-18.xml";
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Период) = Тип("Дата") Тогда
		
		Если РаботаСВнешнимиСистемами.ИмпортРазделенПоОчередям(Организация) Тогда
			
			КаталогОтчетаСОчередью = "";
			
			Если Объект.ОчередьЗагрузки = 0 Тогда		
				
				КоличествоОчередей = РаботаСВнешнимиСистемами.КоличествоОчередейОрганизации(Организация);
				
				Для Очередь = 1 По КоличествоОчередей Цикл
					КаталогОтчетаСОчередью = КаталогОтчетаСОчередью + ";" + ПолучитьКаталогОтчетаСОчередью("ВнешниеОбработки.ФайловаяСверкаСБрокеромБКРегион.КаталогФайловОстатковМатрих", Организация, Период, Очередь);						
				КонецЦикла;
				
			Иначе
				КаталогОтчетаСОчередью = КаталогОтчетаСОчередью + ";" + ПолучитьКаталогОтчетаСОчередью("ВнешниеОбработки.ФайловаяСверкаСБрокеромБКРегион.КаталогФайловОстатковМатрих", Организация, Период, Объект.ОчередьЗагрузки);		
			КонецЕсли;
			
			Возврат Сред(КаталогОтчетаСОчередью, 2);
			
		Иначе
			Возврат ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ВнешниеОбработки.ФайловаяСверкаСБрокеромБКРегион.КаталогФайловОстатковМатрих", Организация, Период);
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции // ПолучитьИмяФайлаОстатков

&НаСервереБезКонтекста
Функция ПолучитьКаталогОтчетаСОчередью(Ключ, Организация, ДатаОстатков, ОчередьЗагрузки)
	
	КаталогОтчета = ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации(Ключ, Организация);
	КаталогОтчета = СтрЗаменить(КаталогОтчета, "Очередь", ОчередьЗагрузки);
		
	ПараметрыШаблона = Новый Структура;
	ПараметрыШаблона.Вставить("Период", ДатаОстатков);
	
	Возврат ПланыВидовХарактеристик.ДополнительныеСведения.ОбработатьПутьКФайлу(КаталогОтчета, ПараметрыШаблона);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКаталогСОтчетами(Организация, Период, ОчередьЗагрузки)
		
	КаталогОтчета = ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ВнешниеОбработки.ФайловаяСверкаСБрокеромБКРегион.КаталогФайловОстатковМатрих", Организация);
	КаталогОтчета = СтрЗаменить(КаталогОтчета, "Очередь", ОчередьЗагрузки);	
	
	Если НачалоДня(Период.ДатаНачала) > НачалоДня(Период.ДатаОкончания) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Некорректно задан период. Дата начала [" + Формат(Период.ДатаНачала, "ДФ=dd.MM.yyyy") + "] больше даты окончания [" + Формат(Период.ДатаОкончания, "ДФ=dd.MM.yyyy") + "].");
		Возврат "";
		
	ИначеЕсли НачалоДня(Период.ДатаНачала) = НачалоДня(Период.ДатаОкончания) Тогда //вернем файл 
		
		Возврат ПланыВидовХарактеристик.ДополнительныеСведения.ОбработатьПутьКФайлу(КаталогОтчета, Новый Структура("Период", Период.ДатаНачала));
		
	Иначе //Для периода нужно получить папку (общий верхний уровень)
					
		КаталогОтчетаНаНачалоПериода = ПланыВидовХарактеристик.ДополнительныеСведения.ОбработатьПутьКФайлу(КаталогОтчета, Новый Структура("Период", Период.ДатаНачала));
		КаталогОтчетаНаКонецПериода  = ПланыВидовХарактеристик.ДополнительныеСведения.ОбработатьПутьКФайлу(КаталогОтчета, Новый Структура("Период", НачалоДня(Период.ДатаОкончания)));	
		
		Возврат ПолучитьОбщийВерхнийУровень(КаталогОтчетаНаНачалоПериода, КаталогОтчетаНаКонецПериода);
		
	КонецЕсли;
	
КонецФункции //ПолучитьКаталогСОтчетами

&НаСервереБезКонтекста
Функция ПолучитьОбщийВерхнийУровень(Каталог1, Каталог2)
	
	ОбщийВерхнийУровень = "";
	Уровень = "";
	Пока Лев(Каталог1, 1) = Лев(Каталог2, 1) Цикл
		
		Уровень = Уровень + Лев(Каталог1, 1);
		
		Каталог1 = Сред(Каталог1, 2);
		Каталог2 = Сред(Каталог2, 2);
		
		Если Прав(Уровень, 1) = "\" Или Прав(Уровень, 1) = "/" Тогда
			ОбщийВерхнийУровень = ОбщийВерхнийУровень + Уровень;
			Уровень = "";
		КонецЕсли;
		
		Если Каталог1 = "" И Каталог2 = "" Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОбщийВерхнийУровень;
	
КонецФункции //ПолучитьОбщийВерхнийУровень

&НаСервереБезКонтекста
Функция ПолучитьГруппуИмпортируемыхЦенныхБумаг(ВидОбъектаСтр)
	
	ВидОбъекта = Справочники.ГруппыИмпортируемыхОбъектов.ПустаяСсылка();
	
	Если ВидОбъектаСтр = "вВекселя" Тогда
		ВидОбъекта = Справочники.ГруппыИмпортируемыхОбъектов.Векселя;
	ИначеЕсли ВидОбъектаСтр = "Паи ПИФ" Тогда
		ВидОбъекта = Справочники.ГруппыИмпортируемыхОбъектов.Паи;
	ИначеЕсли ВидОбъектаСтр = "Ипотечный СУ" Тогда
		ВидОбъекта = Справочники.ГруппыИмпортируемыхОбъектов.ИпотечныеСертификатыУчастия;
	ИначеЕсли ВидОбъектаСтр = "Фьючерсный контракт" Тогда
		ВидОбъекта = Справочники.ГруппыИмпортируемыхОбъектов.ПроизводственныеФинансовыеИнструменты;
	КонецЕсли;
	
	Возврат ВидОбъекта;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОбъект1С(Знач ГруппаОбъектов, Знач Идентификатор, Дата, ДополнительныеПараметры, СчетДУ = Неопределено)
	
	// сначала проверим наличие объекта в кэше
	Если      ГруппаОбъектов = "СчетаДоверительногоУправления" Тогда
		Ключ = ГруппаОбъектов + "/" + Идентификатор.КодКлиента + "/" + Идентификатор.КодПортфеля;
	ИначеЕсли ГруппаОбъектов = "ЦенныеБумаги" Тогда
		Ключ = ГруппаОбъектов + "/" + Идентификатор.Код + "/" + Идентификатор.Тип;
	ИначеЕсли ГруппаОбъектов = "ДепозитарныеСчета" Тогда
		Ключ = ГруппаОбъектов + "/" + Идентификатор.НомерСчета + "/" + Идентификатор.НомерРаздела + "/" + Идентификатор.ВидАктива;
	Иначе
		Ключ = ГруппаОбъектов + "/" + Идентификатор;
	КонецЕсли;
	
	Объект1С =  ДополнительныеПараметры.Кэш[Ключ];
	Если Объект1С <> Неопределено Тогда
		Возврат Объект1С;
	КонецЕсли;
	
	// найдем объект в базе данных
	Если ГруппаОбъектов = "Валюты" Тогда
		Объект1С = Справочники.Валюты.НайтиПоКоду(Идентификатор);
		
		Если Не ЗначениеЗаполнено(Объект1С) Тогда
			Объект1С = Справочники.Валюты.ПустаяСсылка();
			ДополнительныеПараметры.ЖурналОшибок.Добавить("Не удалось получить валюту по коду '" + Идентификатор + "'");
		КонецЕсли;
		
	ИначеЕсли ГруппаОбъектов = "МестаХранения" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект
			|ИЗ
			|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
			|			&Период,
			|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
			|				И ГруппаОбъектов = &ГруппаОбъектов) КАК КодыВоВнешнихСистемахСрезПоследних
			|ГДЕ
			|	КодыВоВнешнихСистемахСрезПоследних.Код = &Код";
		
		Запрос.УстановитьПараметр("Период",         Дата);
		Запрос.УстановитьПараметр("ГруппаОбъектов", Справочники.ГруппыИмпортируемыхОбъектов.МестаХранения);
		Запрос.УстановитьПараметр("Код",            Идентификатор);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Объект1С = Выборка.Объект;
		Иначе
			Объект1С = Справочники.МестаХранения.ПустаяСсылка();
			ЗарегистрироватьНовуюОшибку(ДополнительныеПараметры.ЖурналОшибок, "Не удалось получить место хранения по коду '" + Идентификатор + "' Матрих");
		КонецЕсли;
		
	ИначеЕсли ГруппаОбъектов = "СчетаДоверительногоУправления" Тогда
		КодКлиента = Идентификатор.КодКлиента;
		Если Прав(КодКлиента, 1) = "V" Тогда // БК РЕГИОН таким образом выделяет валютные портфели, которые мы у себя не фиксируем
			КодКлиента = Лев(КодКлиента, СтрДлина(КодКлиента) - 1);
		КонецЕсли;
			
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|ИЗ
			|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И Брокер = &Брокер) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
			|ГДЕ
			|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код В(&КодКлиента, &КодПортфеля)";
		
		Запрос.УстановитьПараметр("Период",       Дата);
		Запрос.УстановитьПараметр("Организация",  ДополнительныеПараметры.Организация);
		Запрос.УстановитьПараметр("Брокер",       ДополнительныеПараметры.Брокер_БК_Регион);
		Запрос.УстановитьПараметр("КодКлиента",   КодКлиента);
		Запрос.УстановитьПараметр("КодПортфеля",  Идентификатор.КодПортфеля);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Объект1С = Выборка.СчетДоверительногоУправления;
		Иначе
			Объект1С = Справочники.СчетаДоверительногоУправления.ПустаяСсылка();
			ЗарегистрироватьНовуюОшибку(ДополнительныеПараметры.ЖурналОшибок, "Не удалось получить счет д/у по коду брокера " + КодКлиента + " (" + Идентификатор.КодПортфеля + ")");
		КонецЕсли;
		
	ИначеЕсли ГруппаОбъектов = "ЦенныеБумаги" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект
			|ИЗ
			|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
			|			&Период,
			|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
			|				И ГруппаОбъектов = &ГруппаОбъектов) КАК КодыВоВнешнихСистемахСрезПоследних
			|ГДЕ
			|	КодыВоВнешнихСистемахСрезПоследних.Код = &Код";
		
		Запрос.УстановитьПараметр("Период",         Дата);
		Запрос.УстановитьПараметр("ГруппаОбъектов", ПолучитьГруппуИмпортируемыхЦенныхБумаг(Идентификатор.Тип));
		Запрос.УстановитьПараметр("Код",            Идентификатор.Код);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Объект1С = Выборка.Объект;
		Иначе
			Объект1С = Справочники.Акции.ПустаяСсылка();
			ЗарегистрироватьНовуюОшибку(ДополнительныеПараметры.ЖурналОшибок, "Не удалось получить ценную бумагу (" + Идентификатор.Тип + ") по коду '" + Идентификатор.Код + "'");
		КонецЕсли;
		
	ИначеЕсли ГруппаОбъектов = "ДепозитарныеСчета" Тогда
		
		Если Идентификатор.НомерРаздела = "СДТ" Или Идентификатор.НомерРаздела = "СПЕЦД" Тогда // брокер не знает фактического счета, на котором лежат остатки
			Объект1С = "СДТ"; // без фиксации ошибки
			
		ИначеЕсли Идентификатор.ВидАктива = "Фьючерсный контракт" Тогда
			
			Объект1С = Справочники.ДепозитарныеСчета.СчетУчетаДеривативов;
			
		ИначеЕсли Идентификатор.ВидАктива = "Векселя" Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет КАК ДепозитарныйСчет
				|ИЗ
				|	РегистрСведений.ИсполнителиПоЦеннымБумагам КАК ИсполнителиПоЦеннымБумагам
				|ГДЕ
				|	ИсполнителиПоЦеннымБумагам.Организация = &Организация
				|	И ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления = &СчетДУ
				|	И (ИсполнителиПоЦеннымБумагам.ДатаЗакрытия >= &Дата
				|			ИЛИ ИсполнителиПоЦеннымБумагам.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))
				|	И (ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.ДатаОткрытия <= &Дата
				|			ИЛИ ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.ДатаОткрытия = ДАТАВРЕМЯ(1, 1, 1))
				|	И ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.ОтветственноеХранение)";
			
			Запрос.УстановитьПараметр("Организация", ДополнительныеПараметры.Организация);
			Запрос.УстановитьПараметр("СчетДУ"     , СчетДУ);
			Запрос.УстановитьПараметр("Дата"       , Дата);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				Объект1С = Выборка.ДепозитарныйСчет;
			Иначе
				Объект1С = Справочники.ДепозитарныеСчета.ПустаяСсылка();
				ЗарегистрироватьНовуюОшибку(ДополнительныеПараметры.ЖурналОшибок, "Не удалось получить счет ответственного хранения для сверки остатков векселей.");
			КонецЕсли;

		Иначе
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ДепозитарныеСчета.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.ДепозитарныеСчета КАК ДепозитарныеСчета
				|ГДЕ
				|	ДепозитарныеСчета.Организация = &Организация
				|	И (ДепозитарныеСчета.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета)
				|				И ДепозитарныеСчета.НомерСчета = &НомерРаздела
				|				И ДепозитарныеСчета.Родитель.НомерСчета = &НомерСчета
				|			ИЛИ ДепозитарныеСчета.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.Депозитарный)
				|				И ДепозитарныеСчета.НомерСчета = &НомерСчета
				|				И НЕ ДепозитарныеСчета.ПодчиненныеРазделы)";
			
			Запрос.УстановитьПараметр("Организация" , ДополнительныеПараметры.Организация);
			Запрос.УстановитьПараметр("НомерСчета"  , Идентификатор.НомерСчета);
			Запрос.УстановитьПараметр("НомерРаздела", Идентификатор.НомерРаздела);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				Объект1С = Выборка.Ссылка;
			Иначе
				Объект1С = Справочники.ДепозитарныеСчета.ПустаяСсылка();
				ЗарегистрироватьНовуюОшибку(ДополнительныеПараметры.ЖурналОшибок, "Не удалось получить депозитарный счет № " + Идентификатор.НомерСчета + ?(ПустаяСтрока(Идентификатор.НомерРаздела), "", ", раздел № " + Идентификатор.НомерРаздела));
			КонецЕсли;
			
		КонецЕсли;			
		
	КонецЕсли;
	
	Если Объект1С = Неопределено Тогда
		ВызватьИсключение "Ошибка обработки объект 1С из группы '" + ГруппаОбъектов + "'";
	КонецЕсли;
	
	ДополнительныеПараметры.Кэш.Вставить(Ключ, Объект1С);
	
	Возврат Объект1С;
	
КонецФункции // ПолучитьОбъект1С

&НаСервереБезКонтекста
Функция СфомироватьHtmlОтчетОСверке(Расхождения, Знач Измерения, Знач Ресурсы, ШапкаТаблицы, ЗаголовкиКолонок, КоличествоРасхождений, ФорматированныйВыводЧисла = Ложь)
	
	Измерения = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(Измерения, ",", Истина, Истина);
	Ресурсы   = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(Ресурсы, ",", Истина, Истина);
	
	КоличествоРасхождений = 0;
	
	Отчет =
		"<html>
		|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
		|	<style>
		|		body {
		|			font: 10pt sans-serif;
		|		}
		|		table {
		|			border-spacing: 0;
		|			border-collapse: collapse;
		|		}
		|		td {
		|			border: 1px solid lightgray;
		|			padding: 5px;
		|		}
		|		.without_discrepancies {
		|			color: green;
		|		}
		|		.mistake {
		|			color: red;
		|		}
		|	</style>
		|</head>
		|<boby>";
	
	// шапка таблицы
	Отчет = Отчет + "<ul>";
	Для каждого Элемент Из ШапкаТаблицы Цикл
		Отчет = Отчет + "	<li>" + ?(ЗаголовкиКолонок.Свойство(Элемент.Ключ), ЗаголовкиКолонок[Элемент.Ключ], Элемент.Ключ) + ": " + Элемент.Значение + "</li>";
	КонецЦикла;
	Отчет = Отчет + "</ul>";
	
	// заголовок таблицы
	Если ТипЗнч(Расхождения) = Тип("РезультатЗапроса") И Расхождения.Пустой()
		ИЛИ ТипЗнч(Расхождения) = Тип("ТаблицаЗначений") И Расхождения.Количество() = 0 Тогда
		Отчет = Отчет + "<h2 class=""without_discrepancies"">Расхождений не найдено</h2>";
		
	Иначе
		
		Если ТипЗнч(Расхождения) = Тип("РезультатЗапроса") Тогда
			Расхождения = Расхождения.Выгрузить();
		КонецЕсли;
		
		Отчет = Отчет + "<table>";
		
		// шапка таблицы
		Отчет = Отчет + "<tr>";
		
		Для каждого Поле Из Измерения Цикл
			Отчет = Отчет + "<th>" + ?(ЗаголовкиКолонок.Свойство(Поле), ЗаголовкиКолонок[Поле], Поле) + "</th>";
		КонецЦикла;
		
		Для каждого Поле Из Ресурсы Цикл
			Отчет = Отчет + "<th>" + ?(ЗаголовкиКолонок.Свойство(Поле), ЗаголовкиКолонок[Поле], Поле) + "</th>";
		КонецЦикла;
		
		Отчет = Отчет + "</tr>";
		
		// строки таблицы
		Для Каждого ТекСтрока Из Расхождения Цикл
			
			Если ТекСтрока.Расхождение Тогда
				КоличествоРасхождений = КоличествоРасхождений + 1;
			КонецЕсли;
			
			Отчет = Отчет + "<tr>";
			
			Для каждого Поле Из Измерения Цикл
				
				Если ТипЗнч(ТекСтрока[Поле]) = Тип("Дата") Тогда
					Отчет = Отчет + "<td>" + Формат(ТекСтрока[Поле], "ДФ=dd.MM.yyyy") + "</td>";
				Иначе
					Отчет = Отчет + "<td " + ?(СтрНайти(ТекСтрока[Поле], "ОШИБКА") > 0, "class=""mistake""", "") + ">" + СтрЗаменить(ТекСтрока[Поле], "ОШИБКА.", "") + "</td>";
				КонецЕсли;
				
			КонецЦикла;
			
			Для каждого Поле Из Ресурсы Цикл
				
				Если ФорматированныйВыводЧисла Тогда
					Значение = Формат(ТекСтрока[Поле], "ЧДЦ=2");
				Иначе
					Значение = ТекСтрока[Поле];
				КонецЕсли;
				
				Отчет = Отчет + "<td>" + Значение + "</td>";
			КонецЦикла;
			
			Отчет = Отчет + "</tr>";
			
		КонецЦикла;	
		
		Отчет = Отчет + "</table>";
		
	КонецЕсли;
	
	Отчет = Отчет + "</body></html>";
	
	Возврат Отчет;

КонецФункции // СфомироватьHtmlОтчетОСверке

