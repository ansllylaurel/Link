#Область УниверсальныйОтбор

&НаКлиенте
Процедура ПерезаполнитьСписокСчетовДУУниверсальногоОтбора()   
	
	
	СчетаОтбор = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьНаборСчетовДУИзУниверсальногоОтбора(Объект.Организация, ЭтаФорма.УниверсальныйОтборСчет, ЭтаФорма.УниверсальныйОтборКлиент, ЭтаФорма.УниверсальныйОтборВидДоговора, ЭтаФорма.ПериодСверки.ДатаНачала);
	
	Если СчетаОтбор = Неопределено Тогда
		Объект.СписокСчетовДУ.Очистить();
	Иначе
		Объект.СписокСчетовДУ.ЗагрузитьЗначения(СчетаОтбор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УниверсальныйОтборСчетПриИзменении(Элемент)
	
	ОбновитьЗаголовокУниверсальногоОтбора();
	
	Если ЭтаФорма.УниверсальныйОтборСчет.Количество() > 0
			Или ЭтаФорма.УниверсальныйОтборКлиент.Количество() > 0
			Или ЭтаФорма.УниверсальныйОтборВидДоговора.Количество() > 0 Тогда
		ПерезаполнитьСписокСчетовДУУниверсальногоОтбора();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УниверсальныйОтборКлиентПриИзменении(Элемент)
	
	ОбновитьЗаголовокУниверсальногоОтбора();
	
	Если ЭтаФорма.УниверсальныйОтборСчет.Количество() > 0
			Или ЭтаФорма.УниверсальныйОтборКлиент.Количество() > 0
			Или ЭтаФорма.УниверсальныйОтборВидДоговора.Количество() > 0 Тогда
		ПерезаполнитьСписокСчетовДУУниверсальногоОтбора();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УниверсальныйОтборВидДоговораПриИзменении(Элемент)
	
	ОбновитьЗаголовокУниверсальногоОтбора();
	
	Если ЭтаФорма.УниверсальныйОтборСчет.Количество() > 0
			Или ЭтаФорма.УниверсальныйОтборКлиент.Количество() > 0
			Или ЭтаФорма.УниверсальныйОтборВидДоговора.Количество() > 0 Тогда
		ПерезаполнитьСписокСчетовДУУниверсальногоОтбора();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗаголовокУниверсальногоОтбора()
	
	Если ЭтаФорма.УниверсальныйОтборСчет.Количество() > 0
			Или ЭтаФорма.УниверсальныйОтборКлиент.Количество() > 0
			Или ЭтаФорма.УниверсальныйОтборВидДоговора.Количество() > 0 Тогда
		ЭтаФорма.ЗаголовокУниверсальногоОтбора = 
			"Задано счетов: " 	  + ЭтаФорма.УниверсальныйОтборСчет.Количество() +
			", клиентов: " 	  	  + ЭтаФорма.УниверсальныйОтборКлиент.Количество() +
			", видов договоров: " + ЭтаФорма.УниверсальныйОтборВидДоговора.Количество();
	Иначе
		ЭтаФорма.ЗаголовокУниверсальногоОтбора = "не задан";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОтборУниверсальный(Команда)
	
	УниверсальныйОтборСчет.Очистить();
	УниверсальныйОтборКлиент.Очистить();
	УниверсальныйОтборВидДоговора.Очистить();
	
	ПерезаполнитьСписокСчетовДУУниверсальногоОтбора();
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьОтборУниверсальный(Команда)
	
	ОписаниеНастроек = РаботаСФормамиКлиент.ПолучитьНастройкиИзХранилищаВариантовИНастроекОтчетов(
		ЭтаФорма.ИмяФормы, ЭтаФорма.КлючНастроекУниверсальногоОтбора);
	
	Если ОписаниеНастроек <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ОписаниеНастроек.Настройки);
		ОбновитьЗаголовокУниверсальногоОтбора();
		Если ЭтаФорма.УниверсальныйОтборСчет.Количество() > 0
				Или ЭтаФорма.УниверсальныйОтборКлиент.Количество() > 0
				Или ЭтаФорма.УниверсальныйОтборВидДоговора.Количество() > 0 Тогда
			ПерезаполнитьСписокСчетовДУУниверсальногоОтбора();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьОтборУниверсальный(Команда)
	
	Настройки = Новый Структура("УниверсальныйОтборСчет, УниверсальныйОтборКлиент, УниверсальныйОтборВидДоговора");
	ЗаполнитьЗначенияСвойств(Настройки, ЭтаФорма);
	
	РаботаСФормамиКлиент.СохранитьНастройкиВХранилищеВариантовИНастроекОтчетов(
		ЭтаФорма.ИмяФормы, ЭтаФорма.КлючНастроекУниверсальногоОтбора, Настройки);
	
КонецПроцедуры

