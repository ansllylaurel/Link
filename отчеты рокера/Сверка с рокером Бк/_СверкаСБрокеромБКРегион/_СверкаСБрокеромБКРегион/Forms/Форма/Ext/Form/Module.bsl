&НаСервереБезКонтекста
Функция ПолучитьТекстСообщения(Дата, Организация, МассивСчетов)
	
	ТекстСообщения = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"        , Дата);
	Запрос.УстановитьПараметр("Организация" , Организация);
	Запрос.УстановитьПараметр("МассивСчетов", МассивСчетов);
	
	Запрос.Текст =
		 "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		 |	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия КАК Стратегия,
		 |	СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		 |ИЗ
		 |	РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(
		 |			&Дата,
		 |			Организация = &Организация
		 |				И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
		 |				И СчетДоверительногоУправления В (&МассивСчетов)) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТекстСообщения = ТекстСообщения + Символы.ПС + "ИИС [" + Выборка.СчетДоверительногоУправления + "] принадлежит стратегии [" + Выборка.Стратегия + "].";
		
	КонецЦикла;
	
	Если ТекстСообщения <> "" Тогда
		
		ТекстСообщения = "В отборе по счетам доверительного управления присутствуют счета ИИС. Сверка с отчетом HTML пройдет целиком по стратегии." + ТекстСообщения;
		
	КонецЕсли;
	
	Возврат ТекстСообщения;
	
КонецФункции

