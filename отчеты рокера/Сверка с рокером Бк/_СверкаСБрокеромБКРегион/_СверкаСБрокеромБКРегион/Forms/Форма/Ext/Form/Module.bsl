&НаСервере
Функция СверитьОстаткиДенежныхСредствНаСервере()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _ДатыПериода
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ДенежныеСредстваБрокер.СчетДоверительногоУправления КАК Справочник.СчетаДоверительногоУправления) КАК СчетДоверительногоУправления,
		|	ДенежныеСредстваБрокер.МестоХранения КАК МестоХранения,
		|	ДенежныеСредстваБрокер.Валюта КАК Валюта,
		|	ДенежныеСредстваБрокер.Сумма КАК Сумма,
		|	ДенежныеСредстваБрокер.ДатаОстатков КАК Дата
		|ПОМЕСТИТЬ _ДенежныеСредстваБрокер
		|ИЗ
		|	&ДенежныеСредстваБрокер КАК ДенежныеСредстваБрокер
		|ГДЕ
		|	&ОтборПоСчетамДенежныеСредства
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияДополнительныхСведений.Объект КАК Счет
		|ПОМЕСТИТЬ _НеИспользуемыеСчетаДУ
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Объект ССЫЛКА Справочник.СчетаДоверительногоУправления
		|	И ЗначенияДополнительныхСведений.Свойство.Ключ = &Ключ
		|	И ЗначенияДополнительныхСведений.Значение = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредствОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОстаткиДенежныхСредствОстаткиИОбороты.МестоХранения КАК МестоХранения,
		|	ОстаткиДенежныхСредствОстаткиИОбороты.Валюта КАК Валюта,
		|	СУММА(ВЫБОР
		|			КОГДА ОстаткиДенежныхСредствОстаткиИОбороты.Период = &НачалоПериода
		|				ТОГДА ОстаткиДенежныхСредствОстаткиИОбороты.СуммаКонечныйОстаток
		|			ИНАЧЕ ОстаткиДенежныхСредствОстаткиИОбороты.СуммаОборот
		|		КОНЕЦ) КАК Сумма,
		|	_ДатыПериода.Дата КАК Дата
		|ПОМЕСТИТЬ _ДенежныеСредства1С
		|ИЗ
		|	_ДатыПериода КАК _ДатыПериода
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиДенежныхСредств.ОстаткиИОбороты(
		|				&НачалоПериода,
		|				&КонецПериодаГраница,
		|				День,
		|				,
		|				Брокер = &Брокер
		|					И Организация = &Организация
		|					И &ОтборПоСчетамДоверительногоУправления
		|					И ВЫБОР
		|						КОГДА &ИспользоватьОтборПоВидамДоговоровСчетовДУ
		|							ТОГДА СчетДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоровСчетовДУ)
		|						ИНАЧЕ ИСТИНА
		|					КОНЕЦ
		|					И НЕ СчетДоверительногоУправления В
		|							(ВЫБРАТЬ
		|								ВТ.Счет
		|							ИЗ
		|								_НеИспользуемыеСчетаДУ КАК ВТ)) КАК ОстаткиДенежныхСредствОстаткиИОбороты
		|		ПО _ДатыПериода.Дата >= ОстаткиДенежныхСредствОстаткиИОбороты.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиДенежныхСредствОстаткиИОбороты.СчетДоверительногоУправления,
		|	ОстаткиДенежныхСредствОстаткиИОбороты.МестоХранения,
		|	ОстаткиДенежныхСредствОстаткиИОбороты.Валюта,
		|	_ДатыПериода.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_ДенежныеСредстваБрокер.СчетДоверительногоУправления, _ДенежныеСредства1С.СчетДоверительногоУправления) КАК СчетДоверительногоУправления,
		|	ЕСТЬNULL(_ДенежныеСредстваБрокер.МестоХранения, _ДенежныеСредства1С.МестоХранения) КАК МестоХранения,
		|	ЕСТЬNULL(_ДенежныеСредстваБрокер.Валюта, _ДенежныеСредства1С.Валюта) КАК Валюта,
		|	ЕСТЬNULL(_ДенежныеСредстваБрокер.Сумма, 0) КАК СуммаБрокер,
		|	ЕСТЬNULL(_ДенежныеСредства1С.Сумма, 0) КАК Сумма1С,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_ДенежныеСредстваБрокер.Сумма, 0) <> ЕСТЬNULL(_ДенежныеСредства1С.Сумма, 0)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Расхождение,
		|	ЕСТЬNULL(_ДенежныеСредстваБрокер.Дата, _ДенежныеСредства1С.Дата) КАК Дата
		|ИЗ
		|	_ДенежныеСредстваБрокер КАК _ДенежныеСредстваБрокер
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ДенежныеСредства1С КАК _ДенежныеСредства1С
		|		ПО _ДенежныеСредстваБрокер.СчетДоверительногоУправления = _ДенежныеСредства1С.СчетДоверительногоУправления
		|			И _ДенежныеСредстваБрокер.МестоХранения = _ДенежныеСредства1С.МестоХранения
		|			И _ДенежныеСредстваБрокер.Валюта = _ДенежныеСредства1С.Валюта
		|			И _ДенежныеСредстваБрокер.Дата = _ДенежныеСредства1С.Дата
		|ГДЕ
		|	&ВыводитьТолькоРасхождения
		|	И НЕ _ДенежныеСредстваБрокер.СчетДоверительногоУправления.Ссылка В
		|				(ВЫБРАТЬ
		|					ВТ.Счет
		|				ИЗ
		|					_НеИспользуемыеСчетаДУ КАК ВТ)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата,
		|	СчетДоверительногоУправления,
		|	МестоХранения,
		|	Валюта";

	Если Объект.ВыводитьТолькоРасхождения Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВыводитьТолькоРасхождения", "ЕСТЬNULL(_ДенежныеСредстваБрокер.Сумма, 0) <> ЕСТЬNULL(_ДенежныеСредства1С.Сумма, 0)");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВыводитьТолькоРасхождения", "ИСТИНА");
	КонецЕсли;
	
	Если ИспользоватьОтборПоСчетамДоверительногоУправления Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоСчетамДоверительногоУправления", "СчетДоверительногоУправления В (&СчетаДоверительногоУправления)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоСчетамДенежныеСредства", "ДенежныеСредстваБрокер.СчетДоверительногоУправления В (&СчетаДоверительногоУправления)");		
		Запрос.УстановитьПараметр("СчетаДоверительногоУправления", Объект.СписокСчетовДУ);	
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоСчетамДоверительногоУправления", "Истина");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоСчетамДенежныеСредства", "Истина");
	КонецЕсли;
	
	ИспользоватьОтборПоВидамДоговоровСчетовДУ = РаботаСВнешнимиСистемами.ИмпортРазделенПоОчередям(Объект.Организация) И Объект.ОчередьЗагрузки <> 0;
	Запрос.УстановитьПараметр("ИспользоватьОтборПоВидамДоговоровСчетовДУ", ИспользоватьОтборПоВидамДоговоровСчетовДУ);
	
	Если ИспользоватьОтборПоВидамДоговоровСчетовДУ Тогда
		Запрос.УстановитьПараметр("ВидыДоговоровСчетовДУ", РаботаСВнешнимиСистемами.ПолучитьВидыДоговорДоверительногоУправленияДляОчереди(Объект.Организация, Объект.ОчередьЗагрузки));
	Иначе
		Запрос.УстановитьПараметр("ВидыДоговоровСчетовДУ", Новый Массив());
	КонецЕсли;
	
	Если СверкаЗаПериод Тогда 	
		Запрос.УстановитьПараметр("НачалоПериода", ЭтаФорма.ПериодСверки.ДатаНачала);
		Запрос.УстановитьПараметр("КонецПериода" , ЭтаФорма.ПериодСверки.ДатаОкончания);
		Запрос.УстановитьПараметр("КонецПериодаГраница" , Новый Граница(КонецДня(ЭтаФорма.ПериодСверки.ДатаОкончания), ВидГраницы.Включая));
	Иначе
		Запрос.УстановитьПараметр("НачалоПериода", ЭтаФорма.ДатаСверки);
		Запрос.УстановитьПараметр("КонецПериода" , ЭтаФорма.ДатаСверки);
		Запрос.УстановитьПараметр("КонецПериодаГраница" , Новый Граница(КонецДня(ЭтаФорма.ДатаСверки), ВидГраницы.Включая));
	КонецЕсли;
		
	ДенежныеСредстваНаСервере = ЭтаФорма.ДенежныеСредства.Выгрузить();
	ДенежныеСредстваНаСервере.Свернуть("ДатаОстатков, СчетДоверительногоУправления, МестоХранения, Валюта", "Сумма");
	
	Запрос.УстановитьПараметр("Организация",            Объект.Организация);
	Запрос.УстановитьПараметр("Брокер",                 ЭтаФорма.Брокер_БК_Регион);
	Запрос.УстановитьПараметр("ДенежныеСредстваБрокер", ДенежныеСредстваНаСервере);
	Запрос.УстановитьПараметр("Ключ",   "УчетНеВедется");
	
	Возврат Запрос.Выполнить();
	
КонецФункции // СверитьОстаткиДенежныхСредствНаСервере

&НаСервере
Функция СверитьОстаткиЦенныхБумагНаСервере()
			
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _ДатыПериода
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ЦенныеБумагиБрокер.СчетДоверительногоУправления КАК Справочник.СчетаДоверительногоУправления) КАК СчетДоверительногоУправления,
		|	ЦенныеБумагиБрокер.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЦенныеБумагиБрокер.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|	ЦенныеБумагиБрокер.Количество КАК Количество,
		|	ЦенныеБумагиБрокер.ДатаОстатков КАК Дата
		|ПОМЕСТИТЬ _ЦенныеБумагиБрокер
		|ИЗ
		|	&ЦенныеБумагиБрокер КАК ЦенныеБумагиБрокер
		|ГДЕ
		|	&ОтборПоСчетамДУЦенныеБумаги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияДополнительныхСведений.Объект КАК Счет
		|ПОМЕСТИТЬ _НеИспользуемыеСчетаДУ
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Объект ССЫЛКА Справочник.СчетаДоверительногоУправления
		|	И ЗначенияДополнительныхСведений.Свойство.Ключ = &Ключ
		|	И ЗначенияДополнительныхСведений.Значение = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиЦенныхБумагОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|	СУММА(ВЫБОР
		|			КОГДА ОстаткиЦенныхБумагОстаткиИОбороты.Период = &НачалоПериода
		|				ТОГДА ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоКонечныйОстаток
		|			ИНАЧЕ ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоОборот
		|		КОНЕЦ) КАК Количество,
		|	_ДатыПериода.Дата КАК Дата
		|ПОМЕСТИТЬ _ЦенныеБумаги1С
		|ИЗ
		|	_ДатыПериода КАК _ДатыПериода
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг.ОстаткиИОбороты(
		|				&НачалоПериода,
		|				&КонецПериодаГраница,
		|				День,
		|				,
		|				Организация = &Организация
		|					И (ДепозитарныйСчет.Брокер = &Брокер
		|						ИЛИ ДепозитарныйСчет.Депозитарий = &Депозитарий
		|						ИЛИ ДепозитарныйСчет В
		|							(ВЫБРАТЬ
		|								_ЦенныеБумагиБрокер.ДепозитарныйСчет
		|							ИЗ
		|								_ЦенныеБумагиБрокер))
		|					И &ОтборПоСчетамДоверительногоУправления
		|					И ВЫБОР
		|						КОГДА &ИспользоватьОтборПоВидамДоговоровСчетовДУ
		|							ТОГДА СчетДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоровСчетовДУ)
		|						ИНАЧЕ ИСТИНА
		|					КОНЕЦ
		|					И НЕ СчетДоверительногоУправления В
		|							(ВЫБРАТЬ
		|								ВТ.Счет
		|							ИЗ
		|								_НеИспользуемыеСчетаДУ КАК ВТ)) КАК ОстаткиЦенныхБумагОстаткиИОбороты
		|		ПО _ДатыПериода.Дата >= ОстаткиЦенныхБумагОстаткиИОбороты.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиЦенныхБумагОстаткиИОбороты.СчетДоверительногоУправления,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.ЦеннаяБумага,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.ДепозитарныйСчет,
		|	_ДатыПериода.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_ЦенныеБумагиБрокер.СчетДоверительногоУправления, _ЦенныеБумаги1С.СчетДоверительногоУправления) КАК СчетДоверительногоУправления,
		|	ЕСТЬNULL(_ЦенныеБумагиБрокер.ЦеннаяБумага, _ЦенныеБумаги1С.ЦеннаяБумага) КАК ЦеннаяБумага,
		|	ЕСТЬNULL(_ЦенныеБумагиБрокер.ДепозитарныйСчет, _ЦенныеБумаги1С.ДепозитарныйСчет) КАК ДепозитарныйСчет,
		|	ЕСТЬNULL(_ЦенныеБумагиБрокер.Количество, 0) КАК КоличествоБрокер,
		|	ЕСТЬNULL(_ЦенныеБумаги1С.Количество, 0) КАК Количество1С,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_ЦенныеБумагиБрокер.Количество, 0) <> ЕСТЬNULL(_ЦенныеБумаги1С.Количество, 0)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Расхождение,
		|	ЕСТЬNULL(_ЦенныеБумагиБрокер.Дата, _ЦенныеБумаги1С.Дата) КАК Дата
		|ИЗ
		|	_ЦенныеБумагиБрокер КАК _ЦенныеБумагиБрокер
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ЦенныеБумаги1С КАК _ЦенныеБумаги1С
		|		ПО _ЦенныеБумагиБрокер.СчетДоверительногоУправления = _ЦенныеБумаги1С.СчетДоверительногоУправления
		|			И _ЦенныеБумагиБрокер.ЦеннаяБумага = _ЦенныеБумаги1С.ЦеннаяБумага
		|			И (_ЦенныеБумагиБрокер.ДепозитарныйСчет = _ЦенныеБумаги1С.ДепозитарныйСчет
		|				ИЛИ _ЦенныеБумагиБрокер.ДепозитарныйСчет = ""СДТ"")
		|			И _ЦенныеБумагиБрокер.Дата = _ЦенныеБумаги1С.Дата
		|ГДЕ
		|	&ВыводитьТолькоРасхождения
		|	И НЕ _ЦенныеБумагиБрокер.СчетДоверительногоУправления.Ссылка В
		|				(ВЫБРАТЬ
		|					ВТ.Счет
		|				ИЗ
		|					_НеИспользуемыеСчетаДУ КАК ВТ)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата,
		|	СчетДоверительногоУправления,
		|	ЦеннаяБумага,
		|	ДепозитарныйСчет";		
	
	Если Объект.ВыводитьТолькоРасхождения Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВыводитьТолькоРасхождения", "ЕСТЬNULL(_ЦенныеБумагиБрокер.Количество, 0) <> ЕСТЬNULL(_ЦенныеБумаги1С.Количество, 0)");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВыводитьТолькоРасхождения", "ИСТИНА");
	КонецЕсли;
	
	Если ИспользоватьОтборПоСчетамДоверительногоУправления Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоСчетамДоверительногоУправления", "СчетДоверительногоУправления В (&СчетаДоверительногоУправления)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоСчетамДУЦенныеБумаги", "ЦенныеБумагиБрокер.СчетДоверительногоУправления В (&СчетаДоверительногоУправления)");
		Запрос.УстановитьПараметр("СчетаДоверительногоУправления", Объект.СписокСчетовДУ);	
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоСчетамДоверительногоУправления", "Истина");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоСчетамДУЦенныеБумаги", "Истина");		
	КонецЕсли;
	
	ИспользоватьОтборПоВидамДоговоровСчетовДУ = РаботаСВнешнимиСистемами.ИмпортРазделенПоОчередям(Объект.Организация) И  Объект.ОчередьЗагрузки <> 0;
	Запрос.УстановитьПараметр("ИспользоватьОтборПоВидамДоговоровСчетовДУ", ИспользоватьОтборПоВидамДоговоровСчетовДУ);
	
	Если ИспользоватьОтборПоВидамДоговоровСчетовДУ Тогда
		Запрос.УстановитьПараметр("ВидыДоговоровСчетовДУ", РаботаСВнешнимиСистемами.ПолучитьВидыДоговорДоверительногоУправленияДляОчереди(Объект.Организация, Объект.ОчередьЗагрузки));
	Иначе
		Запрос.УстановитьПараметр("ВидыДоговоровСчетовДУ", Новый Массив());
	КонецЕсли;
	
	Если СверкаЗаПериод Тогда 	
		Запрос.УстановитьПараметр("НачалоПериода", ЭтаФорма.ПериодСверки.ДатаНачала);
		Запрос.УстановитьПараметр("КонецПериода" , ЭтаФорма.ПериодСверки.ДатаОкончания);
		Запрос.УстановитьПараметр("КонецПериодаГраница" , Новый Граница(КонецДня(ЭтаФорма.ПериодСверки.ДатаОкончания), ВидГраницы.Включая));
	Иначе
		Запрос.УстановитьПараметр("НачалоПериода", ЭтаФорма.ДатаСверки);
		Запрос.УстановитьПараметр("КонецПериода" , ЭтаФорма.ДатаСверки);
		Запрос.УстановитьПараметр("КонецПериодаГраница" , Новый Граница(КонецДня(ЭтаФорма.ДатаСверки), ВидГраницы.Включая));
	КонецЕсли;
	
	ЦенныеБумагиНаСервере = ЭтаФорма.ЦенныеБумаги.Выгрузить();
	ЦенныеБумагиНаСервере.Свернуть("ДатаОстатков, СчетДоверительногоУправления, ЦеннаяБумага, ДепозитарныйСчет", "Количество");
	
	Запрос.УстановитьПараметр("Организация",        Объект.Организация);
	Запрос.УстановитьПараметр("Брокер",             ЭтаФорма.Брокер_БК_Регион);
	Запрос.УстановитьПараметр("Депозитарий",        ЭтаФорма.Депозитарий_БК_Регион);
	Запрос.УстановитьПараметр("ЦенныеБумагиБрокер", ЦенныеБумагиНаСервере);
	Запрос.УстановитьПараметр("Ключ",   "УчетНеВедется");
		
	Возврат Запрос.Выполнить();
	
КонецФункции // СверитьОстаткиЦенныхБумагНаСервере

&НаСервере
Процедура ЗаполнитьСсылкиВТаблицах()
	
	Кэш = Новый Соответствие;
	ЖурналОшибок = Новый Массив;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Организация", Объект.Организация);
	ДополнительныеПараметры.Вставить("Брокер_БК_Регион", ЭтаФорма.Брокер_БК_Регион);
	ДополнительныеПараметры.Вставить("Депозитарий_БК_Регион", ЭтаФорма.Депозитарий_БК_Регион);
	ДополнительныеПараметры.Вставить("Кэш", Кэш);
	ДополнительныеПараметры.Вставить("ЖурналОшибок", ЖурналОшибок);	
	//ДополнительныеПараметры.Вставить("ДатаСверки", ЭтаФорма.ДатаСверки);
	
	Для Каждого СтрокаЦБ Из Этаформа.ЦенныеБумаги Цикл
		СтрокаЦБ.СчетДоверительногоУправления	= ПолучитьОбъект1С("СчетаДоверительногоУправления", Новый Структура("КодКлиента, КодПортфеля", СтрокаЦБ.Investment_Account_Number, СтрокаЦБ.Investment_Account_Division_Number), СтрокаЦБ.ДатаОстатков, ДополнительныеПараметры);
		СтрокаЦБ.ЦеннаяБумага					= ПолучитьОбъект1С("ЦенныеБумаги", Новый Структура("Тип, Код", СтрокаЦБ.Security_Type, СтрокаЦБ.Security_ID), СтрокаЦБ.ДатаОстатков, ДополнительныеПараметры);
		СтрокаЦБ.ДепозитарныйСчет				= ПолучитьОбъект1С("ДепозитарныеСчета", Новый Структура("НомерСчета, НомерРаздела, ВидАктива", СтрокаЦБ.Depo_Account_Number, СтрокаЦБ.Depo_Account_Division_Number, СтрокаЦБ.Security_Type), СтрокаЦБ.ДатаОстатков, ДополнительныеПараметры, СтрокаЦБ.СчетДоверительногоУправления);
	КонецЦикла;
		
	Для Каждого СтрокаДС Из Этаформа.ДенежныеСредства Цикл
		СтрокаДС.СчетДоверительногоУправления	= ПолучитьОбъект1С("СчетаДоверительногоУправления", Новый Структура("КодКлиента, КодПортфеля", СтрокаДС.Investment_Account_Number, СтрокаДС.Investment_Account_Division_Number), СтрокаДС.ДатаОстатков, ДополнительныеПараметры);
		СтрокаДС.МестоХранения					= ПолучитьОбъект1С("МестаХранения", СтрокаДС.Money_Account_Division_Type, СтрокаДС.ДатаОстатков, ДополнительныеПараметры);
		СтрокаДС.Валюта							= ПолучитьОбъект1С("Валюты", СтрокаДС.Currency_Code, СтрокаДС.ДатаОстатков, ДополнительныеПараметры);
	КонецЦикла;
		
	Для каждого ТекстОшибки Из ДополнительныеПараметры.ЖурналОшибок Цикл
		Сообщить(ТекстОшибки);
	КонецЦикла;
	
КонецПроцедуры	

&НаКлиенте
Функция ПолучитьДатуИзСтрокиГГГГММДД(ДатаТекст)
	
	// ГГГГ-ММ-ДД
	Возврат Дата(Число(Лев(ДатаТекст, 4)), Число(Сред(ДатаТекст, 6, 2)), Число(Прав(ДатаТекст, 2)));
	
КонецФункции

&НаКлиенте
Процедура ПоОтветуИзменитьПутьКФайлам()
	
	Если ЭтаФорма.СверкаЗаПериод Тогда 
	
		Режим = РежимДиалогаВопрос.ДаНет;
		Ответ = Вопрос("Изменить путь к каталогам с отчетами?", Режим, 0);
		
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		
		Объект.ПутьКФайлуОстатков  = ПолучитьИмяФайлаОстатков(Объект.Организация, ЭтаФорма.ПериодСверки);
		Объект.ПутьКФайламOTBR     = ПолучитьПутьКОтчетамБрокера(Объект.Организация, ЭтаФорма.ПериодСверки, Ложь, Объект.ОчередьЗагрузки);
		
		Если ЭтаФорма.ПериодСверки.ДатаНачала = НачалоДня(ЭтаФорма.ПериодСверки.ДатаОкончания) Тогда
			Объект.ПутьКОтчетамБрокера = ПолучитьПутьКОтчетамБрокера(Объект.Организация, ЭтаФорма.ПериодСверки.ДатаНачала, СверкаСМесячнымОтчетомБрокера, Объект.ОчередьЗагрузки);
		Иначе
			Объект.ПутьКОтчетамБрокера = ПолучитьПутьКОтчетамБрокера(Объект.Организация, ЭтаФорма.ПериодСверки, Ложь, Объект.ОчередьЗагрузки);
		КонецЕсли;

	Иначе
		
		Объект.ПутьКФайлуОстатков  = ПолучитьИмяФайлаОстатков(Объект.Организация, ЭтаФорма.ДатаСверки);
		Объект.ПутьКОтчетамБрокера = ПолучитьПутьКОтчетамБрокера(Объект.Организация, ЭтаФорма.ДатаСверки, СверкаСМесячнымОтчетомБрокера, Объект.ОчередьЗагрузки);
		Объект.ПутьКФайламOTBR     = ПолучитьПутьКОтчетамБрокера(Объект.Организация, ЭтаФорма.ДатаСверки, Ложь, Объект.ОчередьЗагрузки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПодтвердитьОперацииСБрокером(СчетДоверительногоУправления, Операции, ВремяПодтверждения, ПараметрыОтчета = Неопределено)
	
	// Подтверждаем операции с брокером
	
	ПодтвержденныеОперации = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПодтвердитьОперацииСБрокером(Операции, ВремяПодтверждения);
	
	Если ПараметрыОтчета = Неопределено ИЛИ ПодтвержденныеОперации.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	// Выводим подтвержденные операции в отчет	
	
	СтруктураТаблицы = Новый Структура("ПредставлениеОперации, Период, Примечание", "Операция", "Время подтверждения", "Примечание");
	
	РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(
		ПараметрыОтчета,
		Операции,
		СтруктураТаблицы,
		Строка(СчетДоверительногоУправления),
		Ложь,
		Истина
	);
	
КонецПроцедуры

