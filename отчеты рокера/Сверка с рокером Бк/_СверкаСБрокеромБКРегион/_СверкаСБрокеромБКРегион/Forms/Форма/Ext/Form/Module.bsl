
#Область События_формы_и_элементов

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Если Параметры.Свойство("Организация") Тогда
		Объект.Организация = Параметры.Организация;
	КонецЕсли;
	
	НовыйМассив = Новый Массив();
 	НовыйМассив.Добавить(Новый ПараметрВыбора("Отбор.Организация", Объект.Организация));	
	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);	
	Элементы.СчетДоверительногоУправления.ПараметрыВыбора = НовыеПараметры;
	
	Объект.СписокСчетовДУ.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления");
	ЭтаФорма.Элементы.СчетДоверительногоУправления.Видимость = ИспользоватьОтборПоСчетамДоверительногоУправления;  
	ЭтаФорма.Элементы.ГруппаУниверсальныйОтбор.Видимость = ИспользоватьОтборПоСчетамДоверительногоУправления;
	
	ЭтаФорма.ДатаСверки = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДата() - 86400), -1);
	
	Если Параметры.Свойство("ДатаСверки") Тогда
		ЭтаФорма.ДатаСверки = Параметры.ДатаСверки;
	КонецЕсли;
	
	ОбработатьОчередиЗагрузкиНаСервере();
	
	Объект.ВыводитьТолькоРасхождения	 = Истина;
	Объект.СверятьБезУчетаВалютнойСекции = Истина;
	Объект.ПутьКФайлуОстатков			 = ПолучитьИмяФайлаОстатков(Объект.Организация, ЭтаФорма.ДатаСверки);
	Объект.ПутьКОтчетамБрокера			 = ПолучитьПутьКОтчетамБрокера(Объект.Организация, ЭтаФорма.ДатаСверки, Ложь, Объект.ОчередьЗагрузки);
	Объект.ПутьКФайламOTBR               = ПолучитьПутьКОтчетамБрокера(Объект.Организация, ЭтаФорма.ДатаСверки, Ложь, Объект.ОчередьЗагрузки);
	
	ЭтаФорма.ФиксироватьРезультатСверки            = Ложь;
	ЭтаФорма.ВыводитьОтчетОПодтвержденныхОперациях = Ложь;
	
	ЭтаФорма.СверкаСФайламиOTBR = Истина;
	ЭтаФорма.СверкаСОтчетомHTML = Истина;
	ЭтаФорма.СверкаСФайламиXML  = Ложь;
	
	ЭтаФорма.ВремяСверки        = ТекущаяДата();	
	
	Элементы.ГруппаОтчетОПодтвержденныхОперациях.Видимость = Ложь;
	
	ЭтаФорма.СверкаЗаПериод = РольДоступна("ПолныеПрава");
	
	Если ЭтаФорма.СверкаЗаПериод Тогда
		ЭтаФорма.ПериодСверки.ДатаНачала    = ЭтаФорма.ДатаСверки;
		ЭтаФорма.ПериодСверки.ДатаОкончания = КонецДня(ЭтаФорма.ДатаСверки);
		ЭтаФорма.ДатаСверки                 = Дата(1,1,1);
	КонецЕсли;

КонецПроцедуры //ПриСозданииНаСервере

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)

	Если ЭтаФорма.ФиксироватьРезультатСверки Тогда
		ПроверяемыеРеквизиты.Добавить("ВремяСверки");
	КонецЕсли;
	
	Если ЭтаФорма.СверкаЗаПериод Тогда
		ПроверяемыеРеквизиты.Добавить("ПериодСверки");
	    ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ДатаСверки"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаСверкиПриИзменении(Элемент)
	
	ЭтаФорма.СверкаСФайламиXML = (ЭтаФорма.СверкаСФайламиXML И (ЭтаФорма.СверкаЗаПериод Или ЭтаФорма.ДатаСверки < Дата(2021,04,01))); 
	
	Если НачалоДня(КонецМесяца(ДатаСверки)) = ДатаСверки Тогда
		СверкаСМесячнымОтчетомБрокера = Истина;
	Иначе
		СверкаСМесячнымОтчетомБрокера = Ложь;
	КонецЕсли;
	
	ПоОтветуИзменитьПутьКФайлам();

	СверкаСМесячнымОтчетомБрокераПриИзменении(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодСверкиПриИзменении(Элемент)
	
	ПоОтветуИзменитьПутьКФайлам();
	НастроитьВидимостьДоступность(ЭтаФорма);
		
КонецПроцедуры //ПериодСверкиПриИзменении

&НаКлиенте
Процедура СверкаСМесячнымОтчетомБрокераПриИзменении(Элемент)
	
	Если СверкаСМесячнымОтчетомБрокера Тогда 
		ЭтаФорма.ФиксироватьРезультатСверки			   = Ложь;
		ЭтаФорма.ВыводитьОтчетОПодтвержденныхОперациях = Ложь;
	КонецЕсли;
	
	Если Элемент.Имя = "СверкаСМесячнымОтчетомБрокера" Тогда 
		ПоОтветуИзменитьПутьКФайлам();
	КонецЕсли;
	
	НастроитьВидимостьДоступность(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ФиксироватьРезультатСверкиПриИзменении(Элемент)
	
	Если ЭтаФорма.ФиксироватьРезультатСверки И Не ЭтаФорма.СверкаЗаПериод Тогда
		ЭтаФорма.ВремяСверки = ТекущаяДата();
	КонецЕсли;
	
	ЭтаФорма.ВыводитьОтчетОПодтвержденныхОперациях = ЭтаФорма.ФиксироватьРезультатСверки;
	
	НастроитьВидимостьДоступность(ЭтаФорма);	
	
КонецПроцедуры

&НаКлиенте
Процедура ВремяСверкиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	ВыбранноеЗначение = ВыбранноеЗначение + (ЭтаФорма.ВремяСверки - НачалоДня(ЭтаФорма.ВремяСверки));		
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьОтборПоСчетамДоверительногоУправленияПриИзменении(Элемент)
	
	ЭтаФорма.Элементы.СчетДоверительногоУправления.Видимость = ИспользоватьОтборПоСчетамДоверительногоУправления;
	ЭтаФорма.Элементы.ГруппаУниверсальныйОтбор.Видимость = ИспользоватьОтборПоСчетамДоверительногоУправления;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчередьЗагрузкиПриИзменении(Элемент)
	
	Объект.СписокСчетовДУ.Очистить();
	ИспользоватьОтборПоСчетамДоверительногоУправления = Ложь;
	ИспользоватьОтборПоСчетамДоверительногоУправленияПриИзменении(Неопределено);
	
	ПоОтветуИзменитьПутьКФайлам();
			
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(Новый ПараметрВыбора("Отбор.Организация", Объект.Организация));
	
	Если Объект.ОчередьЗагрузки <> 0 Тогда		
		НовыйМассив.Добавить(Новый ПараметрВыбора("Отбор.ВидДоговораДоверительногоУправления",
		Новый ФиксированныйМассив(РаботаСВнешнимиСистемами.ПолучитьВидыДоговорДоверительногоУправленияДляОчереди(Объект.Организация, Объект.ОчередьЗагрузки))));		
	КонецЕсли;
	
	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);	
	Элементы.СчетДоверительногоУправления.ПараметрыВыбора = НовыеПараметры;
	
КонецПроцедуры

&НаКлиенте
Процедура СверкаСДаннымиФайловOTBRПриИзменении(Элемент)
	НастроитьВидимостьДоступность(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура СверкаСДаннымиФайловHTMLПриИзменении(Элемент)
	
	Объект.СверятьБезУчетаВалютнойСекции = ЭтаФорма.СверкаСОтчетомHTML;
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СверкаСДаннымиФайловXMLПриИзменении(Элемент)
	НастроитьВидимостьДоступность(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайламОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Адрес = "";
	Если Элемент.Имя = "ПутьКФайламOTBR" Тогда
		Адрес = Объект.ПутьКФайламOTBR;
	ИначеЕсли Элемент.Имя = "ПутьКОтчетамБрокера" Или Элемент.Имя = "ПутьКФайлуОстатков" Тогда
	
		Если Элемент.Имя = "ПутьКФайлуОстатков" Тогда
			МассивПодстрок = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(Объект.ПутьКФайлуОстатков, ";"); // файл XML
		ИначеЕсли Элемент.Имя = "ПутьКОтчетамБрокера" Тогда
			МассивПодстрок = СтрРазделить(Объект.ПутьКОтчетамБрокера, Символ(0182));
		КонецЕсли;
		
		Если МассивПодстрок.Количество() > 1 Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке указаны адреса нескольких " + ?(Прав(МассивПодстрок[0], 4) = ".xml", "файлов", "папок") + ".", ЭтотОбъект, ЭтаФорма.ТекущийЭлемент.Имя);
			Возврат;

		Иначе
			Адрес = МассивПодстрок[0]; 
		КонецЕсли;
		
	КонецЕсли;
	
	Если Адрес = "" Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектПапкаФайл = Новый Файл(Адрес);
	
	Если ОбъектПапкаФайл.Существует() Тогда
		ЗапуститьПриложение(Адрес);	
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось открыть " + ?(Прав(Адрес, 4) = ".xml", "файл", "папку") + " [" + Адрес + "]. " + ?(Прав(Адрес, 4) = ".xml", "Файл", "Папка") + " отсутствует.", ЭтотОбъект, ЭтаФорма.ТекущийЭлемент.Имя);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт
	
	Объект.Организация	= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(Новый ПараметрВыбора("Отбор.Организация", Объект.Организация));	
	Элементы.СчетДоверительногоУправления.ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);
		
	ОбработатьОчередиЗагрузкиНаСервере();
	ОчиститьФормыОтчетовНаСервере();
	
	ПоОтветуИзменитьПутьКФайлам();
		
КонецПроцедуры //ПриСменеТекущейОрганизации()

&НаКлиенте
Процедура ПутьКФайламНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Элемент.Имя = "ПутьКФайлуОстатков" Тогда
		
		ДиалогВыбораФайла               = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		ДиалогВыбораФайла.ИндексФильтра = 0;
		ДиалогВыбораФайла.Фильтр        = "XML (*.xml)|*.xml";
		ДиалогВыбораФайла.Каталог       = РаботаСФайламиКлиентСервер.РазложитьПолноеИмяФайла(Объект.ПутьКФайлуОстатков).Путь;
				
		Если ДиалогВыбораФайла.Выбрать() Тогда
			Объект.ПутьКФайлуОстатков = ДиалогВыбораФайла.ПолноеИмяФайла;
		КонецЕсли;
		
	ИначеЕсли Элемент.Имя = "ПутьКФайламOTBR" Тогда
	
		ДиалогВыбораКаталога                    = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
		ДиалогВыбораКаталога.Каталог            = Объект.ПутьКФайламOTBR;
		ДиалогВыбораКаталога.МножественныйВыбор = Ложь;
		ДиалогВыбораКаталога.Заголовок	        = "Выберите каталог с отчетами";
		
		Если ДиалогВыбораКаталога.Выбрать() Тогда
			Объект.ПутьКФайламOTBR = ДиалогВыбораКаталога.Каталог;
		КонецЕсли;
		
	ИначеЕсли Элемент.Имя = "ПутьКОтчетамБрокера" Тогда
		
		ДиалогВыбораКаталога                    = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
		ДиалогВыбораКаталога.Каталог            = Объект.ПутьКОтчетамБрокера;
		ДиалогВыбораКаталога.МножественныйВыбор = Ложь;
		ДиалогВыбораКаталога.Заголовок	        = "Выберите каталог с отчетами";
		
		Если ДиалогВыбораКаталога.Выбрать() Тогда
			Объект.ПутьКОтчетамБрокера = ДиалогВыбораКаталога.Каталог;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры //ПутьКФайламНачалоВыбора

#КонецОбласти

&НаКлиенте
Процедура КомандаСверить(Команда) Экспорт
	
	Если Не ЭтаФорма.СверкаСФайламиXML И Не ЭтаФорма.СверкаСОтчетомHTML И Не ЭтаФорма.СверкаСФайламиOTBR Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите источник данных.");
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.Брокер_БК_Регион      = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион");
	ЭтаФорма.Депозитарий_БК_Регион = ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_БК_Регион");
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.ИспользоватьОтборПоСчетамДоверительногоУправления И ЭтаФорма.СверкаСОтчетомHTML Тогда
		//По счетам ИИС нет отдельных отчетов HTML, отчеты сформированы целиком по стратегии.
		//Если в "отборе по счету ДУ" присутствует ИИС, уведомим пользователя о том, что сверка будет проходить целиком по стратегии.  
		ТекстСообщения = ПолучитьТекстСообщения(?(ЭтаФорма.СверкаЗаПериод, ЭтаФорма.ПериодСверки.ДатаНачала, ЭтаФорма.ДатаСверки), Объект.Организация, Объект.СписокСчетовДУ.ВыгрузитьЗначения());
		
		Если ТекстСообщения <> "" Тогда
			
			РезультатВопроса = Вопрос(ТекстСообщения + Символы.ПС + "Продолжить?", РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да);
			
			Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
				Возврат;		
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтаФорма.ФиксироватьРезультатСверки Тогда
		
		// С момента установки флажка сверки прошло более 30 минут
		
		Если НачалоДня(ТекущаяДата()) = НачалоДня(ЭтаФорма.ВремяСверки)
			И ТекущаяДата() > (ЭтаФорма.ВремяСверки + 30 * 60)
		Тогда
		
			РезультатВопроса = Вопрос("С момента установки времени сверки прошло более 30 минут. Обновить время сверки?", РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да);
			
			Если РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
				Возврат;
			ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Да Тогда
				ЭтаФорма.ВремяСверки = ТекущаяДата();		
			КонецЕсли;
			
		КонецЕсли;
		
		// Сверяем обычно на следующий рабочий день
		
		НачальнаяДатаСверки = ?(ЭтаФорма.СверкаЗаПериод, ЭтаФорма.ПериодСверки.ДатаНачала, ЭтаФорма.ДатаСверки);
		
		Если НачальнаяДатаСверки <> ДобавитьКДатеРабочиеДни(НачалоДня(ЭтаФорма.ВремяСверки) - 1, -1) Тогда
		
			РезультатВопроса = Вопрос("Сверка фиксируется не на следующий рабочий день от сверяемой даты. Все равно продолжить?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
			
			Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
				Возврат;
			КонецЕсли;
			
		КонецЕсли;		
		
	КонецЕсли;
	
	ЭтаФорма.ДенежныеСредства.Очистить();
	ЭтаФорма.ЦенныеБумаги.Очистить();
	
	Если ЭтаФорма.СверкаСФайламиXML И Не СверкаСМесячнымОтчетомБрокера Тогда
		ПрочитатьОстаткиИзФайловБрокера();
	КонецЕсли;
		
	РезультатыСверки = СверитьНаСервере();
	
	Если РезультатыСверки <> Неопределено
		И (РезультатыСверки.НепрошедшиеСверку.Количество() > 0
			ИЛИ РезультатыСверки.ИмеющиеРасхождения.Количество() > 0
			ИЛИ РезультатыСверки.ИмеющиеОперацииПозжеВремениСверки.Количество() > 0)
	Тогда

		#Область Уточняем_у_пользователя_что_следует_зафиксировать_сверку_несмотря_на_расхождения
	
	    ОписаниеРасхождений	= "";
		Отказ				= Ложь;
		
		Если РезультатыСверки.НепрошедшиеСверку.Количество() > 0 Тогда
			ОписаниеРасхождений = ?(ПустаяСтрока(ОписаниеРасхождений), "", ОписаниеРасхождений + ", ") + "сверка не пройдена";	
		КонецЕсли;
		
		Если РезультатыСверки.ИмеющиеРасхождения.Количество() > 0 Тогда
			ОписаниеРасхождений = ?(ПустаяСтрока(ОписаниеРасхождений), "", ОписаниеРасхождений + ", ") + "выявлены расхождения";	
		КонецЕсли;
		
		Если РезультатыСверки.ИмеющиеОперацииПозжеВремениСверки.Количество() > 0 Тогда
			ОписаниеРасхождений = ?(ПустаяСтрока(ОписаниеРасхождений), "", ОписаниеРасхождений + ", ") + "имеются операции со временем внесения более поздним, чем время сверки";	
			Отказ = Истина; // В этом случае запрещаем фиксацию сверки
		КонецЕсли;
		
		ТекстСообщения = "По некоторым счетам д/у " + ОписаниеРасхождений + ".";
		
		Если Отказ Тогда
			Предупреждение(ТекстСообщения + Символы.ПС + "Фиксация сверки отменена!");
		Иначе
			ОтветНаВопрос = Вопрос(ТекстСообщения + Символы.ПС + "Все равно зафиксировать результаты сверки?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
			Отказ		  = (ОтветНаВопрос <> КодВозвратаДиалога.Да);
		КонецЕсли;
		
		Если Не Отказ Тогда
			ЗафиксироватьРезультатСверки(РезультатыСверки.ТаблицаСверки);
		КонецЕсли;
		
		#КонецОбласти
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьОстаткиИзФайловБрокера()
	
	МассивПодстрок = Новый Массив;
	
	Если ЭтаФорма.СверкаЗаПериод Тогда
		
		Если ПериодСверки.ДатаНачала = НачалоДня(ПериодСверки.ДатаОкончания) Тогда
			РаботаСКоллекциями.ДополнитьМассив(МассивПодстрок, РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(Объект.ПутьКФайлуОстатков, ";"));	
		Иначе
			
			ДатаНачалаСверки = ПериодСверки.ДатаНачала;
			
			Пока ДатаНачалаСверки <= ПериодСверки.ДатаОкончания Цикл
				
				ИменаФайлов = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПолучитьИмяФайлаОстатков(Объект.Организация, ДатаНачалаСверки), ";");
				
				Для Каждого ИмяФайла Из ИменаФайлов Цикл
					
					Файл = Новый Файл(ИмяФайла);
					Если Файл.Существует() Тогда
						МассивПодстрок.Добавить(ИмяФайла);
					Иначе
						Продолжить;
					КонецЕсли;
					
				КонецЦикла;

				ДатаНачалаСверки = ДатаНачалаСверки + 86400;
				 
			КонецЦикла;
			
		КонецЕсли;
	Иначе	
		РаботаСКоллекциями.ДополнитьМассив(МассивПодстрок, РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(Объект.ПутьКФайлуОстатков, ";"));
	КонецЕсли;
	
	МассивДаннных = Новый Массив;
	Для Каждого ИмяФайла Из МассивПодстрок Цикл
		Попытка
			МассивДаннных.Добавить(Новый Структура("ИмяФайла, ДвоичныеДанные", ИмяФайла, Новый ДвоичныеДанные(ИмяФайла)));
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось прочитать данные по остаткам из файла брокера '" + ИмяФайла + "'" + Символы.ПС + "из-за ошибки: " + ОписаниеОшибки());
			Возврат;
		КонецПопытки;
	КонецЦикла;
	
	Если (ЭтаФорма.ДатаСверки > Дата(2019, 12, 31) Или (ЭтаФорма.СверкаЗаПериод И ПериодСверки.ДатаНачала > Дата(2019, 12, 31))) И Не ПроверитьФайлИмпортаНаСоответствиеСхемеXSDНаСервере(МассивДаннных) Тогда
		Возврат;	
	КонецЕсли;

	Для Каждого Каталог Из МассивПодстрок Цикл
		
		ПрочитатьОстаткиИзФайлаБрокера(Каталог);
				
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьОстаткиИзФайлаБрокера(ИмяФайла)
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяФайла);
		
	ТекущийКодКлиента  = "";
	ТекущийКодПортфеля = "";
	ТекущийВидАктива = "";
	
	ИмяКорневогоУзла = "";
	ФайлДатаОстатков = "";
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
				
		ИмяУзла = ЧтениеXML.Имя;
		
		Если ПустаяСтрока(ИмяКорневогоУзла) Тогда
			ИмяКорневогоУзла = ИмяУзла;
			
			Если ИмяКорневогоУзла <> "Remains" Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла. Выбранный файл не содержит остатки активов организации у брокера '" + ЭтаФорма.Брокер_БК_Регион + "'");
				Возврат;
			КонецЕсли;
			
			ФайлДатаОстатков = Дата(СтрЗаменить(ЧтениеXML.ЗначениеАтрибута("Date"), "-", ""));
		КонецЕсли;
		
		Если ИмяУзла = "Investment_Account_Number" Тогда
			
			ТекущийКодКлиента = ЧтениеXML.ЗначениеАтрибута("Number");
			
		ИначеЕсли ИмяУзла = "Investment_Account_Division_Number" Тогда
			
			ТекущийКодПортфеля = ЧтениеXML.ЗначениеАтрибута("Number");
			
		ИначеЕсли ИмяУзла = "Security_Type" Тогда
			
			ТекущийВидАктива = ЧтениеXML.ЗначениеАтрибута("Name");
			
		ИначеЕсли ИмяУзла = "Security_Remains" Тогда
			
			СтрокаЦБ = Этаформа.ЦенныеБумаги.Добавить();
			
			СтрокаЦБ.Investment_Account_Number          = ТекущийКодКлиента;
			СтрокаЦБ.Investment_Account_Division_Number = ТекущийКодПортфеля;
			СтрокаЦБ.Security_Type                      = ТекущийВидАктива;
			СтрокаЦБ.Security_ID                        = ЧтениеXML.ЗначениеАтрибута("Security_ID");
			СтрокаЦБ.Depo_Account_Number                = ЧтениеXML.ЗначениеАтрибута("Depo_Account_Number");
			СтрокаЦБ.Depo_Account_Division_Number       = ЧтениеXML.ЗначениеАтрибута("Depo_Account_Division_Number");
			СтрокаЦБ.Количество                         = Число(ЧтениеXML.ЗначениеАтрибута("Volume"));
			СтрокаЦБ.ДатаОстатков                       = ФайлДатаОстатков;

		ИначеЕсли ИмяУзла = "Money_Remains" Тогда
			
			СтрокаДС = Этаформа.ДенежныеСредства.Добавить();
			
			СтрокаДС.Investment_Account_Number          = ТекущийКодКлиента;
			СтрокаДС.Investment_Account_Division_Number = ТекущийКодПортфеля;
			СтрокаДС.Money_Account_Division_Type		= ЧтениеXML.ЗначениеАтрибута("Money_Account_Division_Type");
			СтрокаДС.Currency_Code						= ЧтениеXML.ЗначениеАтрибута("Currency_Code");
			СтрокаДС.Сумма                        		= Число(ЧтениеXML.ЗначениеАтрибута("Amount"));
			СтрокаДС.ДатаОстатков                       = ФайлДатаОстатков;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ПрочитатьОстаткиИзФайлаБрокера

&НаСервере
Функция СверитьНаСервере(ДанныеСверкиДляБухгалтерии = Неопределено)
	
	Перем РезультатСверки, КоличествоРасхождений;
	
	ШапкаОтчета = Новый Структура;
	ШапкаОтчета.Вставить("Организация", Объект.Организация);
	ШапкаОтчета.Вставить("Брокер", ЭтаФорма.Брокер_БК_Регион);

	ОтборПоСчетам = Неопределено;
	СчетаДУСтрокой = "";
	
	Если ИспользоватьОтборПоСчетамДоверительногоУправления Тогда
		
		ОтборПоСчетам = СвернутьМассив(Объект.СписокСчетовДУ.ВыгрузитьЗначения());
		
		Для Каждого Счет Из ОтборПоСчетам Цикл
			СчетаДУСтрокой = СчетаДУСтрокой + ", " + Строка(Счет);			
		КонецЦикла;
		
		Если СчетаДУСтрокой = "" Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В отборе не выбран счет ДУ. Снимите флаг [Отбор по счетам доверительного управления] или укажите счет.");
			Возврат РезультатСверки;
		КонецЕсли;
		
		ШапкаОтчета.Вставить("Счета", Сред(СчетаДУСтрокой, 3));		
		
	КонецЕсли;
	
	Если ЭтаФорма.СверкаЗаПериод Тогда
		
		Если СверкаСМесячнымОтчетомБрокера Тогда
			ШапкаОтчета.Вставить("Период", Формат(НачалоМесяца(ЭтаФорма.ПериодСверки.ДатаНачала), "ДФ=dd.MM.yyyy") + " - " + Формат(ЭтаФорма.ПериодСверки.ДатаОкончания, "ДФ=dd.MM.yyyy"));
		Иначе
			ШапкаОтчета.Вставить("Период", Формат(ЭтаФорма.ПериодСверки.ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ЭтаФорма.ПериодСверки.ДатаОкончания, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		
	Иначе
		
		Если СверкаСМесячнымОтчетомБрокера Тогда
			ШапкаОтчета.Вставить("Период", Формат(ЭтаФорма.ДатаСверки, "ДФ=dd.MM.yyyy"));
		Иначе
			ШапкаОтчета.Вставить("Период", Формат(НачалоМесяца(ЭтаФорма.ДатаСверки), "ДФ=dd.MM.yyyy") + " - " + Формат(ЭтаФорма.ДатаСверки, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		
	КонецЕсли;
	
	ДопПараметрыСтатистики = Новый Структура("ДатаСверки, ВремяСверки, ПериодСчерки, ОтборПоСчетам, ФиксироватьРезультатСверки, СверкаСОтчетомHTML, СверкаСФайламиOTBR, СверкаСФайламиXML, СверкаСМесячнымОтчетомБрокера, ВыводитьОтчетОПодтвержденныхОперациях",
							ЭтаФорма.ДатаСверки, ЭтаФорма.ВремяСверки, ЭтаФорма.ПериодСверки, СчетаДУСтрокой, ЭтаФорма.ФиксироватьРезультатСверки, ЭтаФорма.СверкаСОтчетомHTML,
							ЭтаФорма.СверкаСФайламиOTBR, ЭтаФорма.СверкаСФайламиXML, ЭтаФорма.СверкаСМесячнымОтчетомБрокера, ЭтаФорма.ВыводитьОтчетОПодтвержденныхОперациях);

	Механизм = "_СверкаСБрокеромБКРегион.СверитьНаСервере()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(Объект, "Организация, ОчередьЗагрузки, СверятьБезУчетаВалютнойСекции", ДопПараметрыСтатистики);
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ЗаголовкиПолейОтчета = Новый Структура;
	ЗаголовкиПолейОтчета.Вставить("СчетДоверительногоУправления",	"Счет доверительного управления");
	ЗаголовкиПолейОтчета.Вставить("СА",								"Субъект аналитики");
	ЗаголовкиПолейОтчета.Вставить("МестоХранения",					"Место хранения");
	ЗаголовкиПолейОтчета.Вставить("ЦеннаяБумага",					"Ценная бумага");
	ЗаголовкиПолейОтчета.Вставить("ДепозитарныйСчет",				"Депозитарный счет");
	ЗаголовкиПолейОтчета.Вставить("ТипЗадолженности",				"Тип задолженности");
	ЗаголовкиПолейОтчета.Вставить("Задолженность",				    "Задолженность");
	ЗаголовкиПолейОтчета.Вставить("СуммаБрокер",					"Сумма, брокер");
	ЗаголовкиПолейОтчета.Вставить("Сумма1С",						"Сумма, 1С");
	ЗаголовкиПолейОтчета.Вставить("КоличествоБрокер",				"Кол-во, брокер");
	ЗаголовкиПолейОтчета.Вставить("Количество1С",					"Кол-во, 1С");
	ЗаголовкиПолейОтчета.Вставить("Дата",                           "Дата");
				
	ЗаполнитьСсылкиВТаблицах();
	
	Если НЕ СверкаСМесячнымОтчетомБрокера Тогда
		
		Если ЭтаФорма.СверкаСФайламиXML И Не (Этаформа.ЦенныеБумаги.Количество() = 0 И ЭтаФорма.ДенежныеСредства.Количество() = 0) Тогда
			
			// сверка остатков д/с
			ДанныеОтчетаОСверке = СверитьОстаткиДенежныхСредствНаСервере();
			ЭтаФорма.ОтчетОСверкеДенежныхСредств = СфомироватьHtmlОтчетОСверке(ДанныеОтчетаОСверке, "Дата, СчетДоверительногоУправления, МестоХранения, Валюта", "СуммаБрокер, Сумма1С", ШапкаОтчета, ЗаголовкиПолейОтчета, КоличествоРасхождений);
			
			ОстаткиДСБезРасхождений = (КоличествоРасхождений = 0);
			Элементы.ГруппаОтчетОСверкеДенежныхСредств.Картинка = ?(ОстаткиДСБезРасхождений, БиблиотекаКартинок.ПроверкаУспешна, БиблиотекаКартинок.ПроверкаНеУспешна);
			
			// сверка остатков ц/б
			ДанныеОтчетаОСверке = СверитьОстаткиЦенныхБумагНаСервере();
			ЭтаФорма.ОтчетОСверкеЦенныхБумаг = СфомироватьHtmlОтчетОСверке(ДанныеОтчетаОСверке, "Дата, СчетДоверительногоУправления, ДепозитарныйСчет, ЦеннаяБумага", "КоличествоБрокер, Количество1С", ШапкаОтчета, ЗаголовкиПолейОтчета, КоличествоРасхождений);
			
			ОстаткиЦББезРасхождений = (КоличествоРасхождений = 0);	
			Элементы.ГруппаОтчетОСверкеЦенныхБумаг.Картинка = ?(ОстаткиЦББезРасхождений, БиблиотекаКартинок.ПроверкаУспешна, БиблиотекаКартинок.ПроверкаНеУспешна);
			
		Иначе
			ЭтаФорма.ОтчетОСверкеДенежныхСредств = ПолучитьHTMLДокументССообщениемОбОшибке("Сверка с файламми XML не проводилась.");
			ЭтаФорма.ОтчетОСверкеЦенныхБумаг     = ЭтаФорма.ОтчетОСверкеДенежныхСредств;
			
			Элементы.ГруппаОтчетОСверкеДенежныхСредств.Картинка	= БиблиотекаКартинок.Информация32;
			Элементы.ГруппаОтчетОСверкеЦенныхБумаг.Картинка		= БиблиотекаКартинок.Информация32;
		КонецЕсли;
		
		ОтчетОбОшибке = Неопределено;
		
		// сверка с файлами OTBR
		Если СверкаСФайламиOTBR Тогда
			
			Если ЗначениеЗаполнено(Объект.ПутьКФайламOTBR) Тогда
			
				ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
				
				Если ЭтаФорма.СверкаЗаПериод Тогда
					
					Если ЭтаФорма.ПериодСверки.ДатаНачала = НачалоДня(ЭтаФорма.ПериодСверки.ДатаОкончания) Тогда
						ДанныеОСверке = ОбработкаОбъект.СверитьОстаткиСДаннымиФайловOTBR(ЭтаФорма.ПериодСверки.ДатаНачала, ЭтаФорма.ПериодСверки.ДатаОкончания, Объект.ПутьКФайламOTBR, ЭтаФорма.Брокер_БК_Регион, ЭтаФорма.Депозитарий_БК_Регион, ОтборПоСчетам);	
					Иначе
					
						КаталогиСОтчетами = "";
						ДатаОтчета = ЭтаФорма.ПериодСверки.ДатаНачала;
								
						Пока ДатаОтчета <= ЭтаФорма.ПериодСверки.ДатаОкончания Цикл
							
							КаталогиСОтчетами = КаталогиСОтчетами + ?(КаталогиСОтчетами = "", "", Символ(0182)) + ПолучитьПутьКОтчетамБрокера(Объект.Организация, ДатаОтчета, Ложь, Объект.ОчередьЗагрузки); 
							ДатаОтчета = ДатаОтчета + 86400;
							
						КонецЦикла;
						
						ДанныеОСверке = ОбработкаОбъект.СверитьОстаткиСДаннымиФайловOTBR(ЭтаФорма.ПериодСверки.ДатаНачала, ЭтаФорма.ПериодСверки.ДатаОкончания, КаталогиСОтчетами, ЭтаФорма.Брокер_БК_Регион, ЭтаФорма.Депозитарий_БК_Регион, ОтборПоСчетам);
					КонецЕсли;
				Иначе
					ДанныеОСверке = ОбработкаОбъект.СверитьОстаткиСДаннымиФайловOTBR(ЭтаФорма.ДатаСверки, КонецДня(ЭтаФорма.ДатаСверки), Объект.ПутьКФайламOTBR, ЭтаФорма.Брокер_БК_Регион, ЭтаФорма.Депозитарий_БК_Регион, ОтборПоСчетам);
				КонецЕсли;
				
				Если ДанныеОСверке = Неопределено Тогда
					ОтчетОбОшибке = ПолучитьHTMLДокументССообщениемОбОшибке("При сверке возникли ошибки. Cверка остатков с данными файлов OTBR не проводилась.");	
				Иначе
										
					ЭтаФорма.ОтчетОСверкеДенежныхСредствOTBR = СфомироватьHtmlОтчетОСверке(ДанныеОСверке.СверкаДС, "Дата, СчетДоверительногоУправления, МестоХранения, Валюта", "СуммаБрокер, Сумма1С", ШапкаОтчета, ЗаголовкиПолейОтчета, КоличествоРасхождений);
					Элементы.ГруппаОтчетОСверкеДенежныхСредствOTBR.Картинка = ?((КоличествоРасхождений = 0), БиблиотекаКартинок.ПроверкаУспешна, БиблиотекаКартинок.ПроверкаНеУспешна);
					
					ЭтаФорма.ОтчетОСверкеЦенныхБумагOTBR = СфомироватьHtmlОтчетОСверке(ДанныеОСверке.СверкаЦБ, "Дата, СчетДоверительногоУправления, ДепозитарныйСчет, ЦеннаяБумага", "КоличествоБрокер, Количество1С", ШапкаОтчета, ЗаголовкиПолейОтчета, КоличествоРасхождений);	
					Элементы.ГруппаОтчетОСверкеЦенныхБумагOTBR.Картинка = ?((КоличествоРасхождений = 0), БиблиотекаКартинок.ПроверкаУспешна, БиблиотекаКартинок.ПроверкаНеУспешна);
					
					ЭтаФорма.ОтчетОСверкеЗадолженностиПоДС_OTBR = СфомироватьHtmlОтчетОСверке(ДанныеОСверке.СверкаЗадолженностьДС, "Дата, СчетДоверительногоУправления, ТипЗадолженности, Задолженность, Валюта", "СуммаБрокер, Сумма1С", ШапкаОтчета, ЗаголовкиПолейОтчета, КоличествоРасхождений);	
					Элементы.ГруппаОтчетОСверкеЗадолженностиПоДС_OTBR.Картинка = ?((КоличествоРасхождений = 0), БиблиотекаКартинок.ПроверкаУспешна, БиблиотекаКартинок.ПроверкаНеУспешна);
					
					ЭтаФорма.ОтчетОСверкеЗадолженностиПоЦБ_OTBR = СфомироватьHtmlОтчетОСверке(ДанныеОСверке.СверкаЗадолженностьЦБ, "Дата, СчетДоверительногоУправления, ДепозитарныйСчет, ТипЗадолженности, ЦеннаяБумага", "КоличествоБрокер, Количество1С", ШапкаОтчета, ЗаголовкиПолейОтчета, КоличествоРасхождений);	
					Элементы.ГруппаОтчетОСверкеЗадолженностиПоЦБ_OTBR.Картинка = ?((КоличествоРасхождений = 0), БиблиотекаКартинок.ПроверкаУспешна, БиблиотекаКартинок.ПроверкаНеУспешна);
					
					Если ДанныеСверкиДляБухгалтерии <> Неопределено Тогда 
						РаботаСКоллекциями.ДополнитьМассив(ДанныеСверкиДляБухгалтерии, ДанныеОСверке.СверкаДС.ВыгрузитьКолонку("СчетДоверительногоУправления"), Истина);
						РаботаСКоллекциями.ДополнитьМассив(ДанныеСверкиДляБухгалтерии, ДанныеОСверке.СверкаЦБ.ВыгрузитьКолонку("СчетДоверительногоУправления"), Истина);
						РаботаСКоллекциями.ДополнитьМассив(ДанныеСверкиДляБухгалтерии, ДанныеОСверке.СверкаЗадолженностьДС.ВыгрузитьКолонку("СчетДоверительногоУправления"), Истина);
						РаботаСКоллекциями.ДополнитьМассив(ДанныеСверкиДляБухгалтерии, ДанныеОСверке.СверкаЗадолженностьЦБ.ВыгрузитьКолонку("СчетДоверительногоУправления"), Истина);
					КонецЕсли;	
					
				КонецЕсли;
								
			Иначе
				ОтчетОбОшибке = ПолучитьHTMLДокументССообщениемОбОшибке("Не указан путь к файлам OTBR. Cверка остатков с данными файлов OTBR не проводилась.");
			КонецЕсли;
			
		Иначе
			ОтчетОбОшибке = ПолучитьHTMLДокументССообщениемОбОшибке("Сверка с файламми OTBR не проводилась.");	
		КонецЕсли;
		
		Если ОтчетОбОшибке <> Неопределено Тогда
			
			ЭтаФорма.ОтчетОСверкеДенежныхСредствOTBR    = ОтчетОбОшибке;
			ЭтаФорма.ОтчетОСверкеЦенныхБумагOTBR        = ОтчетОбОшибке;
			ЭтаФорма.ОтчетОСверкеЗадолженностиПоДС_OTBR = ОтчетОбОшибке;
			ЭтаФорма.ОтчетОСверкеЗадолженностиПоЦБ_OTBR = ОтчетОбОшибке;
			
			Элементы.ГруппаОтчетОСверкеДенежныхСредствOTBR.Картинка    = БиблиотекаКартинок.Информация32;
			Элементы.ГруппаОтчетОСверкеЦенныхБумагOTBR.Картинка        = БиблиотекаКартинок.Информация32;
			Элементы.ГруппаОтчетОСверкеЗадолженностиПоДС_OTBR.Картинка = БиблиотекаКартинок.Информация32;
			Элементы.ГруппаОтчетОСверкеЗадолженностиПоЦБ_OTBR.Картинка = БиблиотекаКартинок.Информация32;
			
		КонецЕсли;
		
	Иначе
		
		ПустойОтчет =
			"<html>
			|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
			|	<h3>Для получения результата сверки нажмите [Сверить]. Сверка еще не проводилась.</h3>
			|</head>
			|<boby>";
		
		ЭтаФорма.ОтчетОСверкеДенежныхСредств				= ПустойОтчет;
		ЭтаФорма.ОтчетОСверкеЦенныхБумаг					= ПустойОтчет;
		Элементы.ГруппаОтчетОСверкеДенежныхСредств.Картинка	= БиблиотекаКартинок.Информация32;
		Элементы.ГруппаОтчетОСверкеЦенныхБумаг.Картинка		= БиблиотекаКартинок.Информация32;
		
		ЭтаФорма.ОтчетОСверкеДенежныхСредствOTBR    = ПустойОтчет;
		ЭтаФорма.ОтчетОСверкеЦенныхБумагOTBR        = ПустойОтчет;
		ЭтаФорма.ОтчетОСверкеЗадолженностиПоДС_OTBR = ПустойОтчет;
		ЭтаФорма.ОтчетОСверкеЗадолженностиПоЦБ_OTBR = ПустойОтчет;
		
		Элементы.ГруппаОтчетОСверкеДенежныхСредствOTBR.Картинка    = БиблиотекаКартинок.Информация32;
		Элементы.ГруппаОтчетОСверкеЦенныхБумагOTBR.Картинка        = БиблиотекаКартинок.Информация32;
		Элементы.ГруппаОтчетОСверкеЗадолженностиПоДС_OTBR.Картинка = БиблиотекаКартинок.Информация32;
		Элементы.ГруппаОтчетОСверкеЗадолженностиПоЦБ_OTBR.Картинка = БиблиотекаКартинок.Информация32;
		
	КонецЕсли;
	
	// Сверка данных с отчетом брокера.
	ДанныеБрокераБезРасхождений = Ложь;
		
	Если Не ЭтаФорма.СверкаСОтчетомHTML Тогда
		
		ЭтаФорма.ОтчетОСверкеСОтчетомБрокера = ПолучитьHTMLДокументССообщениемОбОшибке("Сверка с HTML отчетом не проводилась.");
		Элементы.ГруппаОтчетОСверкеСОтчетомБрокера.Картинка = БиблиотекаКартинок.Информация32;
		
	Иначе
		Если ЗначениеЗаполнено(Объект.ПутьКОтчетамБрокера) Или ЭтаФорма.СверкаЗаПериод Тогда
			ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
						
			Если ЭтаФорма.СверкаЗаПериод Тогда
				
				РезультатСравнения = Неопределено;
				ДатаОтчета = ЭтаФорма.ПериодСверки.ДатаНачала;
					
				Пока ДатаОтчета <= ЭтаФорма.ПериодСверки.ДатаОкончания Цикл
					
					Если ЭтаФорма.ПериодСверки.ДатаНачала = НачалоДня(ЭтаФорма.ПериодСверки.ДатаОкончания) Тогда
						ПутьКотчетуБрокера = ПолучитьПутьКОтчетамБрокера(Объект.Организация, ДатаОтчета, СверкаСМесячнымОтчетомБрокера, Объект.ОчередьЗагрузки);
					Иначе
						ПутьКотчетуБрокера = ПолучитьПутьКОтчетамБрокера(Объект.Организация, ДатаОтчета, Ложь, Объект.ОчередьЗагрузки);
					КонецЕсли;
					
					Если ЗначениеЗаполнено(ПутьКотчетуБрокера) Тогда 
						РезультатСревненияЗаДату = ОбработкаОбъект.ПолучитьРезультатСравнения(ЭтаФорма.Брокер_БК_Регион, ЭтаФорма.Депозитарий_БК_Регион, ДатаОтчета, ПутьКотчетуБрокера, СверкаСМесячнымОтчетомБрокера, ОтборПоСчетам);
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить путь к отчетам брокера для организации [" + Объект.Организация + "] на дату [" + ДатаОтчета + "].");
						Продолжить;
					КонецЕсли;
					
					Если РезультатСравнения = Неопределено Тогда
						РезультатСравнения = РезультатСревненияЗаДату;
					Иначе
						
						Если РезультатСревненияЗаДату <> Неопределено И РезультатСравнения.Свойство("Расхождения") И РезультатСревненияЗаДату.Свойство("Расхождения") Тогда
							РаботаСКоллекциями.ТаблицаЗначений_Дополнить(РезультатСревненияЗаДату.Расхождения, РезультатСравнения.Расхождения);	
						КонецЕсли;
						
					КонецЕсли;
					
					ДатаОтчета = ДатаОтчета + 86400; 	
				КонецЦикла;
				
			Иначе
				РезультатСравнения = ОбработкаОбъект.ПолучитьРезультатСравнения(ЭтаФорма.Брокер_БК_Регион, ЭтаФорма.Депозитарий_БК_Регион, ЭтаФорма.ДатаСверки, Объект.ПутьКОтчетамБрокера, СверкаСМесячнымОтчетомБрокера, ОтборПоСчетам);
			КонецЕсли;
			
			Если РезультатСравнения = Неопределено Тогда
				ЭтаФорма.ОтчетОСверкеСОтчетомБрокера = ПолучитьHTMLДокументССообщениемОбОшибке("Не удалось сравнить данные отчетов брокера с данными учетной системы."); 
			Иначе
				
				ЗаголовкиПолейОтчета = Новый Структура;
				ЗаголовкиПолейОтчета.Вставить("ДоговорБрокерскогоОбслуживания",	"Договор брокерского обслуживания");
				ЗаголовкиПолейОтчета.Вставить("СубъектАналитики",				"Субъект аналитики");
				ЗаголовкиПолейОтчета.Вставить("НачалоПериода",					"Начало периода");
				ЗаголовкиПолейОтчета.Вставить("КонецПериода",					"Конец периода");
				ЗаголовкиПолейОтчета.Вставить("ВалютнаяСекция",					"Валютная секция");
				ЗаголовкиПолейОтчета.Вставить("ВнебиржевойРынок",				"Внебиржевой рынок");
				ЗаголовкиПолейОтчета.Вставить("Блок",							"Блок");
				ЗаголовкиПолейОтчета.Вставить("ДатаОперации",					"Дата операции");
				ЗаголовкиПолейОтчета.Вставить("Валюта",							"Валюта");
				ЗаголовкиПолейОтчета.Вставить("ЦеннаяБумага",					"Ценная бумага");
				ЗаголовкиПолейОтчета.Вставить("Показатель",						"Показатель");
				ЗаголовкиПолейОтчета.Вставить("Брокер",							"Брокер");
				ЗаголовкиПолейОтчета.Вставить("УчетнаяСистема",					"УчетнаяСистема");
				
				ЭтаФорма.ОтчетОСверкеСОтчетомБрокера = СфомироватьHtmlОтчетОСверке(РезультатСравнения.Расхождения, "ДоговорБрокерскогоОбслуживания, СубъектАналитики, НачалоПериода, КонецПериода, ВалютнаяСекция, ВнебиржевойРынок, Блок, ДатаОперации, Валюта, ЦеннаяБумага, Показатель", "Брокер, УчетнаяСистема", ШапкаОтчета, ЗаголовкиПолейОтчета, КоличествоРасхождений, Истина);
				
				ДанныеБрокераБезРасхождений = (КоличествоРасхождений = 0);

			КонецЕсли;
			
		Иначе
			ЭтаФорма.ОтчетОСверкеСОтчетомБрокера = ПолучитьHTMLДокументССообщениемОбОшибке("Не указан каталог с отчетами брокера.");
		КонецЕсли;
		
		Элементы.ГруппаОтчетОСверкеСОтчетомБрокера.Картинка = ?(ДанныеБрокераБезРасхождений, БиблиотекаКартинок.ПроверкаУспешна, БиблиотекаКартинок.ПроверкаНеУспешна);
	КонецЕсли;
	
	// Фиксация сверки с брокером и подтверждение операций при отсутствии расхождений
	
	Элементы.ГруппаОтчетОПодтвержденныхОперациях.Видимость = Ложь;
	ЭтаФорма.ОтчетОПодтвержденныхОперациях.Очистить();	
	
	Если ЭтаФорма.ФиксироватьРезультатСверки И РезультатСравнения <> Неопределено И Не СверкаСМесячнымОтчетомБрокера Тогда
		
		// Соберем всю информацию по результатам сверки.
		// Если есть расхождения или время сверки раньше времени внесения,
		// сначала спросим у пользователя перед фиксацией
		
		РезультатСверки = Новый Структура("НепрошедшиеСверку, ИмеющиеРасхождения, ИмеющиеОперацииПозжеВремениСверки", Новый Массив, Новый Массив, Новый Массив);
		
		ТаблицаСверки = Новый ТаблицаЗначений;
		ТаблицаСверки.Колонки.Добавить("СчетДоверительногоУправления",					Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
		ТаблицаСверки.Колонки.Добавить("ВремяПолученияДанных",							Новый ОписаниеТипов("Дата"));
		ТаблицаСверки.Колонки.Добавить("СверкаПройденаУспешно",							Новый ОписаниеТипов("Булево"));
		ТаблицаСверки.Колонки.Добавить("ОтсутствуютРасхождения",						Новый ОписаниеТипов("Булево"));
		ТаблицаСверки.Колонки.Добавить("НеподтвержденныеОперации",						Новый ОписаниеТипов("ТаблицаЗначений"));
		ТаблицаСверки.Колонки.Добавить("НеподтвержденныеОперацииПозжеВремениСверки",	Новый ОписаниеТипов("ТаблицаЗначений"));
		ТаблицаСверки.Колонки.Добавить("Примечание",									Новый ОписаниеТипов("Строка"));
		
		#Область Заполнение_таблицы_сверки
		
		Расхождения = РезультатСравнения.Расхождения;
		Расхождения.Индексы.Добавить("СубъектАналитики");

		Для Каждого СубъектАналитики Из РезультатСравнения.СверенныеСчетаДоверительногоУправления Цикл
			
			РасхожденияПоСубъекту = Расхождения.Скопировать(Новый Структура("СубъектАналитики", ?(ЗначениеЗаполнено(СубъектАналитики.Стратегия), СубъектАналитики.Стратегия, СубъектАналитики.СчетДоверительногоУправления)), "Блок");
			
			// сверка успешна, если нет расхождений по д/с
			
			ОтсутствуютРасхождения	= (РасхожденияПоСубъекту.Количество() = 0);
			СверкаПройденаУспешно	= ОтсутствуютРасхождения;
			Примечание				 = "";
			
			Если Не СверкаПройденаУспешно Тогда  
				
				ЕстьОтчетБрокера		= (РасхожденияПоСубъекту.Найти("Нет отчета брокера", "Блок") = Неопределено);
				РасхожденияПоОстаткамДС	= (РасхожденияПоСубъекту.Найти("Остатки денежных средств", "Блок") <> Неопределено);
				СверкаПройденаУспешно	= ЕстьОтчетБрокера И Не РасхожденияПоОстаткамДС;
				
				Если Не СверкаПройденаУспешно Тогда
					
					Если Не ЕстьОтчетБрокера Тогда
						Примечание = "Расхождения" + ?(ЗначениеЗаполнено(СубъектАналитики.Стратегия), " (по стратегии в целом)", "") + ": нет отчета брокера";
					ИначеЕсли РасхожденияПоОстаткамДС Тогда
						Примечание = "Расхождения" + ?(ЗначениеЗаполнено(СубъектАналитики.Стратегия), " (по стратегии в целом)", "") + " по остаткам денежных средств";
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;				
			
			// Запоминаем результаты сверки
			
			Если ОтсутствуютРасхождения Тогда 
				НеподтвержденныеОперации					= РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПолучитьНеподтвержденныеОперацииСБрокером(Объект.Организация, СубъектАналитики.СчетДоверительногоУправления, ЭтаФорма.Брокер_БК_Регион, ЭтаФорма.ДатаСверки, КонецДня(ЭтаФорма.ДатаСверки), Истина);
				НеподтвержденныеОперацииПозжеВремениСверки	= РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ОперацииВнесенныеПозднее(НеподтвержденныеОперации, ЭтаФорма.ВремяСверки); 
			Иначе
				НеподтвержденныеОперации					= Неопределено;
				НеподтвержденныеОперацииПозжеВремениСверки	= Неопределено;
			КонецЕсли;
			
			СтрокаСверки = ТаблицаСверки.Добавить();
			СтрокаСверки.СчетДоверительногоУправления				= СубъектАналитики.СчетДоверительногоУправления;
			СтрокаСверки.ВремяПолученияДанных						= СубъектАналитики.ВремяПолученияДанных;
			СтрокаСверки.СверкаПройденаУспешно						= СверкаПройденаУспешно;
			СтрокаСверки.ОтсутствуютРасхождения						= ОтсутствуютРасхождения;
			СтрокаСверки.Примечание									= Примечание;
			СтрокаСверки.НеподтвержденныеОперации					= НеподтвержденныеОперации;
			СтрокаСверки.НеподтвержденныеОперацииПозжеВремениСверки	= НеподтвержденныеОперацииПозжеВремениСверки;
			
			Если Не СтрокаСверки.СверкаПройденаУспешно Тогда
				РезультатСверки.НепрошедшиеСверку.Добавить(СтрокаСверки.СчетДоверительногоУправления);
			КонецЕсли;
			
			Если Не СтрокаСверки.ОтсутствуютРасхождения Тогда
				РезультатСверки.ИмеющиеРасхождения.Добавить(СтрокаСверки.СчетДоверительногоУправления);
			КонецЕсли;
			
			Если СтрокаСверки.НеподтвержденныеОперацииПозжеВремениСверки.Количество() > 0 Тогда
				РезультатСверки.ИмеющиеОперацииПозжеВремениСверки.Добавить(СтрокаСверки.СчетДоверительногоУправления);
			КонецЕсли;
			
		КонецЦикла;
		
		#КонецОбласти
		
		Если РезультатСверки.НепрошедшиеСверку.Количество() = 0
			И РезультатСверки.ИмеющиеРасхождения.Количество() = 0
			И РезультатСверки.ИмеющиеОперацииПозжеВремениСверки.Количество() = 0
		Тогда
		
			ЗафиксироватьРезультатСверки(ТаблицаСверки);
			
		Иначе
			
			РезультатСверки.Вставить("ТаблицаСверки", ПоместитьВоВременноеХранилище(ТаблицаСверки, ЭтаФорма.УникальныйИдентификатор));
			
			Если РезультатСверки.ИмеющиеОперацииПозжеВремениСверки.Количество() > 0 Тогда
			
				#Область Вывод_неподтвержденных_операций_со_временем_внесения_позже_времени_сверки
			
				ПараметрыОтчета = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент("Неподтвержденные операции со временем внесения более поздним, чем время сверки", , , ЭтаФорма.ОтчетОПодтвержденныхОперациях);
				
				Для Каждого СтрокаСверки Из ТаблицаСверки Цикл
				
					Если СтрокаСверки.НеподтвержденныеОперацииПозжеВремениСверки.Количество() = 0 Тогда
						Продолжить;
					КонецЕсли;
					
					РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(
						ПараметрыОтчета,
						СтрокаСверки.НеподтвержденныеОперацииПозжеВремениСверки,
						Новый Структура("Операция, ВремяВнесения", "Операция", "Время внесения"),
						Строка(СтрокаСверки.СчетДоверительногоУправления),
						Ложь,
						Истина);					
				
				КонецЦикла; 
				
				РаботаСОтчетами.УстановитьШиринуКолонок(ПараметрыОтчета);
				
				Элементы.ГруппаОтчетОПодтвержденныхОперациях.Видимость	 = Истина;
				Элементы.ГруппыОтчетовСверкиСФайламиHTML.ТекущаяСтраница = Элементы.ГруппыОтчетовСверкиСФайламиHTML.ПодчиненныеЭлементы.ГруппаОтчетОПодтвержденныхОперациях;
				Элементы.ПанельОтчетыОСверках.ТекущаяСтраница			 = Элементы.ПанельОтчетыОСверках.ПодчиненныеЭлементы.СтраницаОтчетовСверкиСФайламиHTML;
			
				#КонецОбласти
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли РезультатСравнения <> Неопределено И СверкаСМесячнымОтчетомБрокера И ДанныеБрокераБезРасхождений Тогда
		
		НеподтвержденныеОперации = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПолучитьНеподтвержденныеОперацииСБрокером(Объект.Организация, , ЭтаФорма.Брокер_БК_Регион, НачалоМесяца(ДатаСверки), КонецМесяца(ДатаСверки), Ложь);
		
		Если НеподтвержденныеОперации.Количество() > 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("За " + НРег(Формат(ДатаСверки, "ДФ='ММММ гггг ''г.'''")) + " расхождений с отчетом брокера не выявлено, но обнаружены неподтвержденные операции!");
		КонецЕсли;
		
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);

	Возврат РезультатСверки;
	
КонецФункции

&НаКлиенте
