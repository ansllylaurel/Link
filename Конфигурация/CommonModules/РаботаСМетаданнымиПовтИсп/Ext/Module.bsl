// РЕГИСТРЫ

Функция ПолучитьИменаПолейРегистра(ИмяГруппыМетаданных, ИмяРегистра, ИсклИзмерения = Ложь, ИсклРесурсы = Ложь, ИсклРеквизиты = Ложь) Экспорт
	
	ИменаПолей = Новый Массив;
	
	МетаданныеРегистра = Метаданные[ИмяГруппыМетаданных][ИмяРегистра];
	
	Если Не ИсклИзмерения Тогда
		
		Если НРег(ИмяГруппыМетаданных) = "регистрысведений" Тогда
			Если МетаданныеРегистра.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
				ИменаПолей.Добавить("Период");
			КонецЕсли;
		КонецЕсли;
	
		Для Каждого Поле Из МетаданныеРегистра.Измерения Цикл
			ИменаПолей.Добавить(Поле.Имя);
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не ИсклРесурсы Тогда
	
		Для Каждого Поле Из МетаданныеРегистра.Ресурсы Цикл
			ИменаПолей.Добавить(Поле.Имя);
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не ИсклРеквизиты Тогда
	
		Для Каждого Поле Из МетаданныеРегистра.Реквизиты Цикл
			ИменаПолей.Добавить(Поле.Имя);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ИменаПолей;
	
КонецФункции // ПолучитьИменаПолейРегистра

Функция ПолучитьОписаниеПолейРегистра(ИмяГруппыМетаданных, ИмяРегистра, ИсклИзмерения = Ложь, ИсклРесурсы = Ложь, ИсклРеквизиты = Ложь) Экспорт
	
	ОписаниеПолей = Новый Массив;
	
	МетаданныеРегистра = Метаданные[ИмяГруппыМетаданных][ИмяРегистра];
	
	Если Не ИсклИзмерения Тогда
		
		Если НРег(ИмяГруппыМетаданных) = "регистрысведений" Тогда
			Если МетаданныеРегистра.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
				ОписаниеПолей.Добавить(
					Новый Структура("Имя, Тип, Синоним", "Период", Новый ОписаниеТипов("Дата"), ""));
			КонецЕсли;
		КонецЕсли;
	
		Для Каждого Поле Из МетаданныеРегистра.Измерения Цикл
			ОписаниеПолей.Добавить(Новый Структура("Имя, Тип, Синоним",
				Поле.Имя, Поле.Тип, Поле.Синоним));
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не ИсклРесурсы Тогда
	
		Для Каждого Поле Из МетаданныеРегистра.Ресурсы Цикл
			ОписаниеПолей.Добавить(Новый Структура("Имя, Тип, Синоним",
				Поле.Имя, Поле.Тип, Поле.Синоним));
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не ИсклРеквизиты Тогда
	
		Для Каждого Поле Из МетаданныеРегистра.Реквизиты Цикл
			ОписаниеПолей.Добавить(Новый Структура("Имя, Тип, Синоним",
				Поле.Имя, Поле.Тип, Поле.Синоним));
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ОписаниеПолей;
	
КонецФункции // ПолучитьОписаниеПолейРегистра

Функция ПолучитьСписокРегистровБухгалтерии() Экспорт

	СписокРегистров = Новый Соответствие;
	
	Для каждого РегистрБухгалтерии Из Метаданные.РегистрыБухгалтерии Цикл
		СписокРегистров.Вставить(РегистрБухгалтерии.Имя, РегистрБухгалтерии);
	КонецЦикла;
	
	Возврат СписокРегистров;

КонецФункции // ПолучитьСписокРегистровБухгалтерии

Функция ПолучитьСписокРегистровБэкОфиса() Экспорт
	
	// регистрами бэк-офиса считаем регистры, не отнесенные к регистрами с партиями и проводками
	
	СписокРегистров = Новый Соответствие;
	
	РегистрыСПартиями	= ПолучитьСписокРегистровСПартиями();	
	РегистрыСПроводками	= ПолучитьСписокРегистровСПроводками();
	
	Для Каждого МетаРегистр Из Метаданные.РегистрыСведений Цикл
		Если РегистрыСПартиями[МетаРегистр.Имя] = Неопределено И РегистрыСПроводками[МетаРегистр.Имя] = Неопределено Тогда
			СписокРегистров.Вставить(МетаРегистр.Имя, МетаРегистр);			
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого МетаРегистр Из Метаданные.РегистрыНакопления Цикл
		Если РегистрыСПартиями[МетаРегистр.Имя] = Неопределено И РегистрыСПроводками[МетаРегистр.Имя] = Неопределено Тогда
			СписокРегистров.Вставить(МетаРегистр.Имя, МетаРегистр);			
		КонецЕсли;
	КонецЦикла;	
	
	Возврат СписокРегистров;
	
КонецФункции

Функция ПолучитьСписокРегистровСПроводками() Экспорт
	
	СписокРегистров = ПолучитьСписокРегистровБухгалтерии();
	
	СписокРегистров.Вставить("РаспределенияАктивовЕПС",							Метаданные.РегистрыСведений.РаспределенияАктивовЕПС);
	СписокРегистров.Вставить("ПорученияНаПереоценку", 							Метаданные.РегистрыСведений.ПорученияНаПереоценку);
	СписокРегистров.Вставить("НакопленныеДоходыИРасходыКСписаниюПриПродажеЕПС",	Метаданные.РегистрыНакопления.НакопленныеДоходыИРасходыКСписаниюПриПродажеЕПС);
		
	Возврат СписокРегистров;
	
КонецФункции

Функция ПолучитьСписокРегистровСПартиями() Экспорт
	
	// регистрами с партиями считаем регистры сведений и накоплений, содержащие вид учета
	
	СписокРегистров = Новый Соответствие;
	
	Для Каждого МетаРегистр Из Метаданные.РегистрыСведений Цикл
		Если МетаРегистр.Измерения.Найти("ВидУчета") <> Неопределено Тогда
			СписокРегистров.Вставить(МетаРегистр.Имя, МетаРегистр);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого МетаРегистр Из Метаданные.РегистрыНакопления Цикл
		Если МетаРегистр.Измерения.Найти("ВидУчета") <> Неопределено Тогда
			СписокРегистров.Вставить(МетаРегистр.Имя, МетаРегистр);
		КонецЕсли;
	КонецЦикла;	
	
	Возврат СписокРегистров;
	
КонецФункции

Функция РегистрыСРегистрациейПоКлиенту() Экспорт
	
	СписокРегистров = Новый Соответствие;
	
	СписокРегистров.Вставить(Метаданные.РегистрыСведений.ЗначенияНастроекУчетаЦенныхБумаг.ПолноеИмя(),	Метаданные.РегистрыСведений.ЗначенияНастроекУчетаЦенныхБумаг);
	СписокРегистров.Вставить(Метаданные.РегистрыСведений.АналогиЦенныхБумаг.ПолноеИмя(),				Метаданные.РегистрыСведений.АналогиЦенныхБумаг);
	
	Возврат СписокРегистров;
	
КонецФункции

Функция ПолучитьПоляРегистраЗависимыеОтРеквизита(ПолноеИмяМД, ИмяРеквизита) Экспорт
	
	НайденныеПоля = Новый Массив;
	
	МетаданныеРегистра = Метаданные.НайтиПоПолномуИмени(ПолноеИмяМД);
	
	Если Метаданные.РегистрыСведений.Содержит(МетаданныеРегистра) Тогда
		ИмяГруппыМетаданных = "РегистрыСведений";
	ИначеЕсли Метаданные.РегистрыНакопления.Содержит(МетаданныеРегистра) Тогда
		ИмяГруппыМетаданных = "РегистрыНакопления";
	ИначеЕсли Метаданные.РегистрыБухгалтерии.Содержит(МетаданныеРегистра) Тогда
		ИмяГруппыМетаданных = "РегистрыБухгалтерии";
	ИначеЕсли Метаданные.РегистрыРасчета.Содержит(МетаданныеРегистра) Тогда
		ИмяГруппыМетаданных = "РегистрыРасчета";		
	КонецЕсли;
	
	ОписаниеПолейРегистра = РаботаСМетаданнымиПовтИсп.ПолучитьОписаниеПолейРегистра(ИмяГруппыМетаданных, МетаданныеРегистра.Имя);
	
	Для Каждого ОписаниеПоля Из ОписаниеПолейРегистра Цикл
		
		Для Каждого ТипЗначения Из ОписаниеПоля.Тип.Типы() Цикл		
			
			МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипЗначения);
			
			Если МетаданныеОбъекта = Неопределено Тогда
				
				Продолжить;
				
			ИначеЕсли Метаданные.Справочники.Содержит(МетаданныеОбъекта) ИЛИ Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
				
				Если ЕстьРеквизитОбъекта(МетаданныеОбъекта, ИмяРеквизита) Тогда
					
					Если ИмяГруппыМетаданных = "РегистрыБухгалтерии"
						И (МетаданныеРегистра.Измерения.Содержит(ОписаниеПоля) ИЛИ МетаданныеРегистра.Ресурсы.Содержит(ОписаниеПоля))
						И Не ОписаниеПоля.Балансовый
					Тогда
						НайденныеПоля.Добавить(ОписаниеПоля.Имя + "Дт");
						НайденныеПоля.Добавить(ОписаниеПоля.Имя + "Кт");
					Иначе
						НайденныеПоля.Добавить(ОписаниеПоля.Имя);
					КонецЕсли;
					
					Прервать;
					
				КонецЕсли;
				
			КонецЕсли;			
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат НайденныеПоля;
	
КонецФункции

