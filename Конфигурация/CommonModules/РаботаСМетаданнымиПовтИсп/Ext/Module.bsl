Функция ПолучитьИменаДокументовБезДвиженийПоБэкОфису() Экспорт

	МассивДокументов = Новый Массив;
	Для каждого Документ Из Метаданные.Документы Цикл
		
		ЕстьДвиженияПоБэкОфису = Ложь;
		ЕстьДвиженияБух = Ложь;
		
		Для каждого Регистр Из Документ.Движения Цикл
			
			Если Метаданные.РегистрыНакопления.Содержит(Регистр) 
				Или Метаданные.РегистрыСведений.Содержит(Регистр)
				Или Метаданные.РегистрыРасчета.Содержит(Регистр) Тогда
			
				ЕстьДвиженияПоБэкОфису = Истина;
				Если ЕстьДвиженияБух Тогда
					Прервать;
				КонецЕсли; 
			
			КонецЕсли;
			
			Если Метаданные.РегистрыБухгалтерии.Содержит(Регистр) Тогда
				ЕстьДвиженияБух = Истина;
			КонецЕсли; 
			
		КонецЦикла; 
		
		Если Не ЕстьДвиженияПоБэкОфису И ЕстьДвиженияБух Тогда
			МассивДокументов.Добавить(Документ.Имя);
		КонецЕсли; 
		
	КонецЦикла; 
	
	Возврат МассивДокументов;

КонецФункции

Функция МенеджерОбъектаМетаданных(ПолноеИмяОбъектМетаданных) Экспорт
	
	Возврат Новый(СтрЗаменить(ПолноеИмяОбъектМетаданных, ".", "Менеджер."));
	
КонецФункции

Функция ЕстьРеквизитОбъекта(МетаданныеОбъекта, ИмяРеквизита) Экспорт
	
	Если ТипЗнч(МетаданныеОбъекта) = Тип("Строка") Тогда
		Возврат (Метаданные.НайтиПоПолномуИмени(МетаданныеОбъекта).Реквизиты.Найти(ИмяРеквизита) <> Неопределено);
	Иначе
		Возврат (МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита) <> Неопределено);
	КонецЕсли;

КонецФункции

Функция ЗависимыеОтРеквизитаТипыЗначений(ИмяРеквизита) Экспорт
	
	РезультатФункции = Новый Соответствие;
	
	КоллекцииОбъектов = Новый Соответствие;
	КоллекцииОбъектов.Вставить("СправочникСсылка",				Метаданные.Справочники);
	КоллекцииОбъектов.Вставить("ДокументСсылка",				Метаданные.Документы);
	КоллекцииОбъектов.Вставить("ПланВидовХарактеристикСсылка",	Метаданные.ПланыВидовХарактеристик);
	КоллекцииОбъектов.Вставить("ЗадачаСсылка",					Метаданные.Задачи);
	
	Для Каждого КоллекцияОбъектов Из КоллекцииОбъектов Цикл
		Для Каждого ОбъектМетаданных Из КоллекцияОбъектов.Значение Цикл 
			Если ЕстьРеквизитОбъекта(ОбъектМетаданных, ИмяРеквизита) Тогда
				РезультатФункции.Вставить(Тип(КоллекцияОбъектов.Ключ + "." + ОбъектМетаданных.Имя), ОбъектМетаданных);	
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции
