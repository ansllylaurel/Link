
////////////////////////////////////////////////////////////////////////////////
// ПЕРЕЧИСЛЕНИЯ

Функция ПолучитьИдентификаторПеречисления(ЗнчПеречисления) Экспорт
	
	ИмяОбъектаМД = ЗнчПеречисления.Метаданные().Имя;
	
	ИндексЗнч     = Перечисления[ИмяОбъектаМД].Индекс(ЗнчПеречисления);
	Идентификатор = Метаданные.Перечисления[ИмяОбъектаМД].ЗначенияПеречисления[ИндексЗнч].Имя;
	
	Возврат Идентификатор;
	
КонецФункции // ПолучитьИдентификаторПеречисления

Функция ЗначенияПеречисленияВСтруктуру(ИмяПеречисления) Экспорт
	
	ЗначенияПеречисления = Новый Структура;
	
	Для Каждого ЗначениеПеречисления Из Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления Цикл
		ЗначенияПеречисления.Вставить(ЗначениеПеречисления.Имя, Перечисления[ИмяПеречисления][ЗначениеПеречисления.Имя]);
	КонецЦикла;
	
	Возврат ЗначенияПеречисления;
	
КонецФункции // ЗначенияПеречисленияВСтруктуру

////////////////////////////////////////////////////////////////////////////////
// СПРАВОЧНИКИ

Функция ЗначенияПредопределенныхЭлементовСправочникаВСтруктуру(ИмяСправочника, Отбор = Неопределено) Экспорт
	
	ЗначенияСправочника = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Справочник.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
		|	Справочник.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Валюты КАК Справочник
		|ГДЕ
		|	Справочник.Предопределенный";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Валюты", ИмяСправочника);
	
	Если Отбор <> Неопределено Тогда
		МассивОтборов = Новый Массив;
		
		Для Каждого ЭлементОтбора Из Отбор Цикл
			МассивОтборов.Добавить(СтрШаблон("И Справочник.%1 = &%1", ЭлементОтбора.Ключ));
			Запрос.УстановитьПараметр(ЭлементОтбора.Ключ, ЭлементОтбора.Значение);
		КонецЦикла;
		
		Запрос.Текст = Запрос.Текст + Символы.ПС + СтрСоединить(МассивОтборов, Символы.ПС);
		
	КонецЕсли;
		
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗначенияСправочника.Вставить(Выборка.ИмяПредопределенныхДанных, Выборка.Ссылка);
	КонецЦикла;	
	
	Возврат ЗначенияСправочника;
	
КонецФункции // ЗначенияПеречисленияВСтруктуру

////////////////////////////////////////////////////////////////////////////////
// ДОКУМЕНТЫ

Функция ПолучитьСписокДокументовНаОсновании(ИмяДокумента) Экспорт

	СписокДокументов = Новый СписокЗначений;
	
	Для каждого ДокументМД Из Метаданные.Документы Цикл
		Для каждого ДокументОснованияМД Из ДокументМД.ВводитсяНаОсновании Цикл
			Если ДокументОснованияМД.Имя = ИмяДокумента Тогда
				Если ПравоДоступа("ИнтерактивноеДобавление", ДокументМД, РаботаСПользователями.ТекущийПользователь()) Тогда 
					СписокДокументов.Добавить(ДокументМД.Имя, ДокументМД.Представление());
				КонецЕсли;	
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;	
	
	СписокДокументов.СортироватьПоПредставлению();
	
	Возврат СписокДокументов;

КонецФункции // ПолучитьСписокДокументовНаОсновании

Функция ПолучитьИменаПолейШапкиДокумента(ИмяДокумента) Экспорт
	
	ИменаПолей = Новый Массив;
	
	МетаданныеДокумента = Метаданные.Документы[ИмяДокумента];
	
	Для Каждого Поле Из МетаданныеДокумента.СтандартныеРеквизиты Цикл 
		ИменаПолей.Добавить(Поле.Имя);
	КонецЦикла;

	Для Каждого Поле Из МетаданныеДокумента.Реквизиты Цикл
		ИменаПолей.Добавить(Поле.Имя);
	КонецЦикла;
	
	Возврат ИменаПолей;
	
КонецФункции // ПолучитьИменаПолейШапкиДокумента

Функция ЕстьРеквизитШапкиДокумента(ИмяДокумента, ИмяРеквизита) Экспорт
	
	МетаданныеДокумента = Метаданные.Документы[ИмяДокумента];
	
	Для Каждого Реквизит Из МетаданныеДокумента.СтандартныеРеквизиты Цикл
		Если Реквизит.Имя = ИмяРеквизита Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если МетаданныеДокумента.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;
	
КонецФункции

Функция ДокументыСРегистрациейПоКлиенту() Экспорт
	
	СписокРегистров = Новый Соответствие;
	
	СписокРегистров.Вставить(Метаданные.Документы.РегистрацияПредоставленныхКлиентомСведенийОЦенныхБумагах.Имя, Метаданные.Документы.РегистрацияПредоставленныхКлиентомСведенийОЦенныхБумагах);
	
	Возврат СписокРегистров;
	
КонецФункции

