// БУХГАЛТЕРИЯ

Функция ПолучитьМаксимальноеКоличествоСубконто(ПланСчетов) Экспорт
	
	Возврат ПланСчетов.Метаданные().МаксКоличествоСубконто;

КонецФункции // ПолучитьМаксимальноеКоличествоСубконто

Функция НеПроверятьЗаполнениеСубконто(Организация, Счет, ВидСубконто, Период = Неопределено) Экспорт
	
	Если Период = Неопределено Тогда
		Период = ТекущаяДата();
	КонецЕсли;
	
	Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета Тогда
		Если Счет = ПланыСчетов.Основной.ДенежныеСредстваУБрокера
			Или Счет = ПланыСчетов.Основной.ВалютныеСредстваУБрокера
			Или Счет = ПланыСчетов.Основной.РасчетыЧерезБрокера
			Или Счет = ПланыСчетов.Основной.РасчетыЧерезБрокераВВалюте
		Тогда
			Возврат Истина;
		КонецЕсли;
		
	ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги
		Или ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ОбращаетсяНаОРЦБ
	Тогда
		Если Счет = ПланыСчетов.Основной.ПрочиеДоходы
			Или Счет = ПланыСчетов.Основной.ПрочиеРасходы
			Или Счет = ПланыСчетов.Основной.СальдоПрочихДоходовИРасходов
			Или Счет = ПланыСчетов.Основной.ПрибылиИУбытки
			Или Счет = ПланыСчетов.Основной.Выручка
			Или Счет = ПланыСчетов.Основной.СебестоимостьПродажи
			Или Счет = ПланыСчетов.Основной.ПрибыльУбытокОтПродаж
			Или Счет = ПланыСчетов.Единый.ПрочиеДоходыРасходы01
			Или Счет = ПланыСчетов.Единый.ПрочиеДоходыРасходы02
			Или Счет = ПланыСчетов.Единый.ДоходыРасходыПоОбеспечениюДеятельности01
			Или Счет = ПланыСчетов.Единый.ДоходыРасходыПоОбеспечениюДеятельности02
			ИЛИ Счет = ПланыСчетов.Единый.ДоходыРасходыОтОпераций11 
			ИЛИ Счет = ПланыСчетов.Единый.ДоходыРасходыОтОпераций12 
			ИЛИ Счет = ПланыСчетов.Основной.ДоходыБудущихПериодов
			ИЛИ Счет = ПланыСчетов.Основной.РасходыБудущихПериодов
		Тогда
			Возврат Истина;
		КонецЕсли;
	ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ПрочиеДоходыИРасходы Тогда
		Если Счет = ПланыСчетов.Основной.СальдоПрочихДоходовИРасходов
			Или Счет = ПланыСчетов.Основной.ПрибыльУбытокОтПродаж
				Или Счет = ПланыСчетов.Основной.ПрибылиИУбытки
					Или Счет = ПланыСчетов.Основной.РезервыПредстоящихРасходов
		Тогда
			Возврат Истина;
		КонецЕсли;
		
	ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ДепозитныеВклады Тогда
		Если Счет = ПланыСчетов.Единый.Депозиты03 Тогда
			Возврат Истина;
		КонецЕсли;
		
	ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Сделка Тогда
		Если Счет = ПланыСчетов.Основной.РасчетыПоКомиссии ИЛИ Счет = ПланыСчетов.Основной.РасчетыПоКомиссииБрокера Тогда
			Возврат Истина;
		КонецЕсли;
		
	ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты Тогда
		Если Счет = ПланыСчетов.Основной.ПереводыВПути ИЛИ Счет = ПланыСчетов.Основной.ПереводыВПутиВВалюте Тогда
			Возврат Истина;
		КонецЕсли;
		
	ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.МНО Тогда
		Если Счет = ПланыСчетов.Единый.Расчеты23 Тогда
			Возврат Истина;
		КонецЕсли;
		
	ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов Тогда
		Если Счет = ПланыСчетов.Единый.Расчеты07
			ИЛИ Счет = ПланыСчетов.Единый.Расчеты08 
			ИЛИ Счет = ПланыСчетов.Единый.Расчеты23 
			ИЛИ Счет = ПланыСчетов.Единый.Расчеты22 
			ИЛИ Счет = ПланыСчетов.Единый.Расчеты25 
			ИЛИ Счет = ПланыСчетов.Единый.ПрочиеСчетаПоОперациямСПриобретеннымиЦеннымиБумагами05 
			ИЛИ Счет = ПланыСчетов.Основной.ПогашениеКупонаЕврооблигации
			ИЛИ Счет = ПланыСчетов.Единый.ВспомогательныеСчета01 И Период < '20241001'
		Тогда
			Возврат Истина; 
		ИначеЕсли Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") 
			И Счет.Метаданные() = Метаданные.ПланыСчетов.Основной
			И Счет.ПринадлежитЭлементу(ПланыСчетов.Основной.ПереоценкаЗадолженностей) Тогда
			 // #572237 Документ ПриходПроцентовПоКредитномуИнструменту является основанием для задолженности, 
			 // но в субконто ОснованиеРасчетов отсутствует. Так как ситуация единичная, то, чтобы избежать 
			 // пересчета итогов, в том числе и по ЕПС, делаю это субконто незаполняемым. 
			Возврат Истина; 
		КонецЕсли;
		
	ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств Тогда
		Если Счет = ПланыСчетов.Основной.ЦелевоеФинансированиеПФРВозврат Тогда
			Возврат Истина;
			
		ИначеЕсли (Период < '20190101' ИЛИ Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ"))
			И (Счет = ПланыСчетов.Основной.РасчетныеСчета
			ИЛИ Счет = ПланыСчетов.Основной.ВалютныеСчета
			ИЛИ Счет = ПланыСчетов.Основной.ДенежныеСредстваУБрокера
			ИЛИ Счет = ПланыСчетов.Основной.ВалютныеСредстваУБрокера
			ИЛИ Счет = ПланыСчетов.Основной.РасчетыЧерезБрокера
			ИЛИ Счет = ПланыСчетов.Основной.РасчетыЧерезБрокераВВалюте) Тогда
			
			Возврат Истина;
			
		КонецЕсли;
		
	ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Договоры
		И Счет = ПланыСчетов.Основной.РасчетыПоАвансамВыданным
		И Период < '20190101' Тогда
		Возврат Истина;
		
	ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Резервы 
		И Счет = ПланыСчетов.Единый.ДолговыеДляПродажиИДоПогашения22
		И Период < '20190101' Тогда
		Возврат Истина;
		
	ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.УсловияЗаймовКредитовИДепозитов 
		И (Счет = ПланыСчетов.Единый.РасчетныеСчета05
			ИЛИ Счет = ПланыСчетов.Единый.ПроцентныеДоходы01) Тогда
		Возврат Истина;
		
	КонецЕсли;	
	
	Возврат Ложь;
	
КонецФункции // НеПроверятьЗаполнениеСубконто

Функция ПолучитьСписокТиповСубконто() Экспорт

	СписокТиповСубконто = Новый Массив;
	
	Выборка = ПланыВидовХарактеристик.ВидыСубконто.Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивТипов = Выборка.ТипЗначения.Типы();
		Для Каждого ТипИзМассива из МассивТипов Цикл
			Переменная = Новый(ТипИзМассива);
			ИмяТипа = Переменная.Метаданные().ПолноеИмя();
			ИмяТипа = СтрЗаменить(ИмяТипа, ".", "Ссылка.");
			Если СписокТиповСубконто.Найти(ИмяТипа) = Неопределено Тогда
				СписокТиповСубконто.Добавить(Тип(ИмяТипа));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат СписокТиповСубконто;
	
КонецФункции

// Если пустое субконто составного типа, то его значение должно быть Неопределено
// Если ссылочного типа - пустая ссылка. 
// пустые значения разного типа приводят к расползанию ОСВ

Функция ПолучитьПустоеЗначениеСубконто(ВидСубконто) Экспорт
	
	МассивТиповСубконто = ВидСубконто.ТипЗначения.Типы();
		
	Если МассивТиповСубконто.Количество() > 1 Тогда 	
		ЗначениеСубконто = Неопределено;
	Иначе
		ЗначениеСубконто = Новый(МассивТиповСубконто[0]);	
	КонецЕсли;	
	
	Возврат ЗначениеСубконто;
	
КонецФункции	

