КонецФункции

// Проверяет наличие недопустимых символов в имени файла.
//
// Параметры
//  ИмяФайла  - Строка 
// Возвращаемое значение:
//   Массив   - массив обнаруженных в имени файла недопустимых символов.
//              Если недопустимых символов не обнаружено возвращается пустой массив.
Функция НайтиНедопустимыеСимволыВИмениФайла(ИмяФайла) Экспорт

	НедопустимыеСимволы = ПолучитьНедопустимыеСимволыВИмениФайла();
	
	МассивНайденныхНедопустимыхСимволов = Новый Массив;
	
	Для ПозицияСимвола = 1 По СтрДлина(НедопустимыеСимволы) Цикл
		ПроверяемыйСимвол = Сред(НедопустимыеСимволы,ПозицияСимвола,1);
		Если Найти(ИмяФайла,ПроверяемыйСимвол) <> 0 Тогда
			МассивНайденныхНедопустимыхСимволов.Добавить(ПроверяемыйСимвол);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивНайденныхНедопустимыхСимволов;

КонецФункции

// Заменяет недопустимые символы в имени файла.
//
// Параметры
//  ИмяФайла     - Строка - исходное имя файла.
//  НаЧтоМенять  - Строка - строка, на которую необходимо заменить недопустимые символы.
//
// Возвращаемое значение:
//   Строка - преобразованное имя файла.
//
Функция ЗаменитьНедопустимыеСимволыВИмениФайла(Знач ИмяФайла, НаЧтоМенять = " ") Экспорт

	Результат = ИмяФайла;
	МассивНайденныхНедопустимыхСимволов = НайтиНедопустимыеСимволыВИмениФайла(Результат);
	Для Каждого НедопустимыйСимвол Из МассивНайденныхНедопустимыхСимволов Цикл
		Результат = СтрЗаменить(Результат, НедопустимыйСимвол, НаЧтоМенять);
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция ПоместитьДвоичныеДанныеВАрхив(ДанныеФайла) Экспорт
	
	ИмяВременногоФайла = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов() + "\" + ДанныеФайла.Имя;
	
	ДанныеФайла.ДвоичныеДанные.Записать(ИмяВременногоФайла);
	
	Архив = Новый ЗаписьZipФайла();
	Архив.Добавить(ИмяВременногоФайла);
	
	ДанныеАрхива = Новый Структура;
	ДанныеАрхива.Вставить("ДвоичныеДанные", 	Архив.ПолучитьДвоичныеДанные());
	ДанныеАрхива.Вставить("Имя",				ДанныеФайла.ИмяБезРасширения + ".zip");
	ДанныеАрхива.Вставить("ИмяБезРасширения",	ДанныеФайла.ИмяБезРасширения);
	ДанныеАрхива.Вставить("Расширение",			".zip");
	
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
	КонецПопытки;
	
	Возврат ДанныеАрхива;
	
КонецФункции

//Возвращает файлы находящиеся в папке
//
//Параметры
//	АдресКаталога - тип "Строка", адрес (путь) к папке.
//	Маска         - тип "Строка", маска выбора файлов, пример: "*.txt"
//	ИскатьВОбработанных - тип ""Булево, к результату добавляются файлы из вложенной папки "Обработано".
//
//Возвращаемое значение:
//	Массив структур - структура содержит файл и признак "обработан" = Истина
//                     в случае если файл находится в папке "Обработано".
Функция ПолучитьФайлыДляОбработкиИзКаталога(АдресКаталога, Маска = "*", ИскатьВОбработанных = Ложь) Экспорт
	
	МассивФайлов = Новый Массив;
	
	КаталогСФайлами = Новый Файл(АдресКаталога);
	
	Если КаталогСФайлами.Существует() И КаталогСФайлами.ЭтоКаталог() Тогда
																								
		ФайлыКаталога = НайтиФайлы(АдресКаталога, Маска, Истина);
		
		Для Каждого Файл Из ФайлыКаталога Цикл
			
			Если СтрЗаканчиваетсяНа(Нрег(Файл.Путь), "\обработано\") Тогда 
				
				Если ИскатьВОбработанных Тогда
					МассивФайлов.Добавить(Новый Структура("Файл, Обработан", Файл, Истина));
				КонецЕсли;
				
			Иначе
				МассивФайлов.Добавить(Новый Структура("Файл, Обработан", Файл, Ложь));	
			КонецЕсли;
							
		КонецЦикла;
							
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось найти папку [" + АдресКаталога + "].");
		Возврат Неопределено;
		
	КонецЕсли;
	
	Возврат МассивФайлов;
	
КонецФункции

//Создает новую папку "Обработано" в папке исходнике и переносит туда файлы
//
//Параметры
//	МассивФайлов - тип "Массив", элементы - тип "файл", или тип "Структура" со свойствами "Имя", "Путь",
//                 "Имя" - имя файла, "Путь" - адрес папки расположения файла.
//	ИмяКаталога  - тип "Строка", имя новой папки, в которую нужно перенести файлы.
//
Процедура ПеренестиОбработанныеФайлыВКаталог(МассивФайлов, ИмяКаталога = "Обработано") Экспорт
	
	ЭтоРабочаяБаза = ОбщегоНазначения.ЗначениеПараметраСеанса("ЭтоРабочаяИнформационнаяБаза");
	
	Если Не ЭтоРабочаяБаза Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ТекФайл Из МассивФайлов Цикл
						
		Каталог = Новый Файл(ТекФайл.Путь); 
		
		Если Каталог.Существует() И Каталог.ЭтоКаталог() Тогда 
			
			Отказ = Ложь;
			
			КаталогПриемник = Каталог.ПолноеИмя + "\" + ИмяКаталога; 
			
			РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(КаталогПриемник, Отказ, Ложь);
			
			Если Отказ Тогда 				
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					"Не удалось перенести файл [" + ТекФайл.Имя + "] в папку [Обработано]. Не удалось создать папку [" + КаталогПриемник + "].");				
				Продолжить;
				
			КонецЕсли; 
			
			Попытка 
				ПереместитьФайл(ТекФайл.Путь + "\" + ТекФайл.Имя, КаталогПриемник + "\" + ТекФайл.Имя);	
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					"Не удалось перенести файл [" + ТекФайл.Имя + "] в папку [" + КаталогПриемник + "]." + Символы.ПС + ОписаниеОшибки()); 	
			КонецПопытки;
			
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				"Не удалось перенести файл [" + ТекФайл.Имя + "] в папку [Обработано]. Не удалось найти папку [" + ТекФайл.Путь + "].");		
		КонецЕсли;
		
	КонецЦикла;
			
КонецПроцедуры
