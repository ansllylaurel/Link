Функция СоздатьТаблицуРасшифровки() Экспорт
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Раздел", 					Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(150)));
	Таблица.Колонки.Добавить("ИмяЯчейки", 				Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(10)));
	Таблица.Колонки.Добавить("НомерСтрокиРасшифровки", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10,0)));
	Таблица.Колонки.Добавить("ЗнакОперации", 			Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(1)));
	Таблица.Колонки.Добавить("Счет", 					Новый ОписаниеТипов("ПланСчетовСсылка.Единый"));
	Таблица.Колонки.Добавить("КорСчет", 				Новый ОписаниеТипов("ПланСчетовСсылка.Единый"));
	Таблица.Колонки.Добавить("ДатаНачала", 				Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	Таблица.Колонки.Добавить("ДатаКонца", 				Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	
	Таблица.Колонки.Добавить("ИмяПоказателя", 			Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(150)));
	
	Таблица.Колонки.Добавить("ИмяСлагаемого", 			Новый ОписаниеТипов("Строка"));
	
	Таблица.Колонки.Добавить("Сумма", 					Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
	Таблица.Колонки.Добавить("Сдвиг", 					Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3,0)));
	Таблица.Колонки.Добавить("ДанныеНеМенялись", 		Новый ОписаниеТипов("Булево"));
	
	Таблица.Колонки.Добавить("Страница", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3,0)));
	Таблица.Колонки.Добавить("Субконто1", 	Новый ОписаниеТипов("Строка, ПланВидовХарактеристикСсылка.ВидыСубконто"));
	Таблица.Колонки.Добавить("Субконто2", 	Новый ОписаниеТипов("Строка, ПланВидовХарактеристикСсылка.ВидыСубконто"));
	Таблица.Колонки.Добавить("Субконто3", 	Новый ОписаниеТипов("Строка, ПланВидовХарактеристикСсылка.ВидыСубконто"));
	
	Таблица.Колонки.Добавить("МнЧ", 		Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(1)));
	Таблица.Колонки.Добавить("СтрокаПП", 	Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(50)));
	
	Возврат Таблица;
	
КонецФункции

// ДобавитьСтрокуВРасшифровку
Процедура ДобавитьСтрокуВРасшифровку(ТаблицаРасшифровки, ДатаНачала, ДатаКонца, СтруктураПолей) Экспорт
	
	НовСтр = ТаблицаРасшифровки.Добавить();
	НовСтр.НомерСтрокиРасшифровки     = ТаблицаРасшифровки.Количество();
	
	ЗаполнитьЗначенияСвойств(НовСтр, СтруктураПолей);
	
	Если Не ЗначениеЗаполнено(СтруктураПолей.Сдвиг) Тогда
		НовСтр.ДатаНачала = ДатаНачала;
		НовСтр.ДатаКонца  = ДатаКонца;
	ИначеЕсли ТипЗнч(СтруктураПолей.Сдвиг) = Тип("Число") Тогда//И Сдвиг <= 10 Тогда
		НовСтр.ДатаНачала = ДобавитьМесяц(ДатаНачала, -12 * Мин(СтруктураПолей.Сдвиг, 10));
		НовСтр.ДатаКонца  = ДобавитьМесяц(ДатаКонца, -12 * Мин(СтруктураПолей.Сдвиг, 10));
	Иначе
		НовСтр.ДатаНачала = СтруктураПолей.Сдвиг;
		НовСтр.ДатаКонца  = СтруктураПолей.ПраваяГраница;
	КонецЕсли;
	
КонецПроцедуры

// Процедура выводит секцию указанного вида с указанными значениями в поле табличного документа.
//
// Параметры:
//	Таб - поле табличного документа или табличный документ, в который следует осуществить вывод.
//	ИмяОбласти - имя области, которую следует вывести в Таб
//	Значение - первое значение для заполнения в области ИмяОбласти
//	Значение2 - второе значение для заполнения в области ИмяОбласти
//	Расшифровка - значение расшифровки для соответствующих ячеек области.
//
Процедура ВывестиСекцию(ТабДок, ИмяОбласти, Значение = Неопределено, Значение2 = Неопределено, Расшифровка = Неопределено, НомерУзла = Неопределено)
	
	Макет = ПолучитьОбщийМакет("МакетРасшифровкиОтчетности");
	
	// не так ли проще, чем условие ниже...
	Если СтрЧислоСтрок(ИмяОбласти) > 1 Тогда
		Область = Макет.ПолучитьОбласть(СтрПолучитьСтроку(ИмяОбласти, 1));
	Иначе
		Область = Макет.ПолучитьОбласть(ИмяОбласти);
	КонецЕсли;
	
	Если (Найти(ИмяОбласти, "НазваниеОргБезПлюса" + Символы.ПС) > 0) Или (Найти(ИмяОбласти, "НазваниеОрг" + Символы.ПС) > 0) Тогда
		Область = Макет.ПолучитьОбласть(СтрПолучитьСтроку(ИмяОбласти, 1));
	Иначе
		Область = Макет.ПолучитьОбласть(ИмяОбласти);
	КонецЕсли;
	
	Если Значение <> Неопределено ИЛИ Значение2 <> Неопределено Тогда
		НомерОбласти = 0;
		Для Каждого Обл Из Область.Области Цикл
			Если Обл.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник И Обл.СодержитЗначение Тогда
				НомерОбласти = НомерОбласти + 1;
				Обл.Значение = ?(НомерОбласти = 1, Значение, Значение2);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Расшифровка <> Неопределено Тогда
		
	КонецЕсли;
	
	Если (Найти(ИмяОбласти, "НазваниеОргБезПлюса" + Символы.ПС) > 0) Или (Найти(ИмяОбласти, "НазваниеОрг" + Символы.ПС) > 0) Тогда
		
		Область.Параметры.НазваниеОрганизации = СтрПолучитьСтроку(ИмяОбласти, 2);
		ИтогПоОрганизации = СтрПолучитьСтроку(ИмяОбласти, 3); // Итоговая сумма по организации в целом.
		ИтогПоОрганизации = ?(ПустаяСтрока(ИтогПоОрганизации), "0", ИтогПоОрганизации);
		Область.Параметры.ИтогПоОрганизации = ИтогПоОрганизации;
		
	КонецЕсли;
	
	Если НомерУзла = Неопределено Тогда
		ТабДок.Вывести(Область);
	Иначе
		ТабДок.Вывести(Область, 1, Строка(НомерУзла));
	КонецЕсли;
	
КонецПроцедуры

// Процедура выводить слагаемое, описываемое строкой таблицы значений в поле табличного документа на форме.
//
// Параметры:
//	Стр            - строка таблицы значений, описывающая выводимое слагаемое.
//  НомерУзла      - номер группы.
//  ВыводСтрокиСлагаемого - используется в консолидированном режим. Если Истина, то строка Плюс не выводится,
//                          все остальное -вывод.
//
Процедура ВыводСтроки(ТабДок, СуммаПоПоказателю, Стр, НомерУзла = Неопределено, ВыводСтрокиСлагаемого = Неопределено, Знак = "") Экспорт
	
	Если ТипЗнч(Стр.ИмяСлагаемого) <> Тип("Строка") Тогда
		Стр.ИмяСлагаемого = "субконто: " + Стр.ИмяСлагаемого;
	КонецЕсли;
	
	Если Лев(Стр.ИмяСлагаемого, 1)="#" Тогда
		
		// Получена строка-разделитель, просто выдаем эту секцию
		ПодзаголовокНаименование = Сред(Стр.ИмяСлагаемого, 2, СтрДлина(Стр.ИмяСлагаемого));
		ВывестиСекцию(ТабДок, "Подзаголовок",ПодзаголовокНаименование);
		
		Возврат;
		
	Иначе
		СлагаемоеНаименование = НаименованиеСлагаемого(Стр.ИмяСлагаемого,Стр.Счет,Стр.КорСчет,Стр.ДатаНачала, Стр.ДатаКонца);
	КонецЕсли;
	
	Если Стр.Субконто1 <> Неопределено Тогда
		
		Если ТипЗнч(Стр.Субконто1) = Тип("СписокЗначений") Тогда
			
			СлагаемоеНаименование = СлагаемоеНаименование + "." + Символы.ПС + "Субконто " + Стр.Счет.ВидыСубконто[0].ВидСубконто.Наименование + " принимает одно из следующих значений:" + Символы.ПС;
			
			Для Каждого Эл Из Стр.Субконто1 Цикл
				СлагаемоеНаименование = СлагаемоеНаименование + Эл.Значение + ", ";
			КонецЦикла;
			
			СлагаемоеНаименование = Лев(СлагаемоеНаименование, СтрДлина(СлагаемоеНаименование) - 2) + "; ";
			
		Иначе
			
			СлагаемоеНаименование = СлагаемоеНаименование + "." + Символы.ПС + "Субконто " + Стр.Счет.ВидыСубконто[0].ВидСубконто.Наименование + " принимает значение " + Стр.Субконто1 + ";";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Стр.Субконто2 <> Неопределено Тогда
		
		Если ТипЗнч(Стр.Субконто2) = Тип("СписокЗначений") Тогда
			
			СлагаемоеНаименование = СлагаемоеНаименование + "." + Символы.ПС + "Субконто " + Стр.Счет.ВидыСубконто[1].ВидСубконто.Наименование + " принимает одно из следующих значений:" + Символы.ПС;
			
			Для Каждого Эл Из Стр.Субконто2 Цикл
				СлагаемоеНаименование = СлагаемоеНаименование + Эл.Значение + ", ";
			КонецЦикла;
			
			СлагаемоеНаименование = Лев(СлагаемоеНаименование, СтрДлина(СлагаемоеНаименование) - 2) + "; ";
			
		Иначе
			
			СлагаемоеНаименование = СлагаемоеНаименование + "." + Символы.ПС + "Субконто " + Стр.Счет.ВидыСубконто[1].ВидСубконто.Наименование + " принимает значение " + Стр.Субконто2 + ";";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Стр.Субконто3 <> Неопределено Тогда
		
		Если ТипЗнч(Стр.Субконто3) = Тип("СписокЗначений") Тогда
			
			СлагаемоеНаименование = СлагаемоеНаименование + "." + Символы.ПС + "Субконто " + Стр.Счет.ВидыСубконто[2].ВидСубконто.Наименование + " принимает одно из следующих значений:" + Символы.ПС;
			
			Для Каждого Эл Из Стр.Субконто3 Цикл
				СлагаемоеНаименование = СлагаемоеНаименование + Эл.Значение + ", ";
			КонецЦикла;
			
			СлагаемоеНаименование = Лев(СлагаемоеНаименование, СтрДлина(СлагаемоеНаименование) - 2) + "; ";
			
		Иначе
			
			СлагаемоеНаименование = СлагаемоеНаименование + "." + Символы.ПС + "Субконто " + Стр.Счет.ВидыСубконто[2].ВидСубконто.Наименование + " принимает значение " + Стр.Субконто3 + ";";
			
		КонецЕсли;
		
	КонецЕсли;
	
	// ВыводСтрокиСлагаемого - только для консолидированного режима используется.
	// При выводе данных по организации, перед первой строкой расшифровки чтобы не выдавалась область Плюс.
	Если ВыводСтрокиСлагаемого = Неопределено Тогда
		
		Если Стр.ЗнакОперации <> Знак Тогда
			
			Если ЛОЖЬ Тогда //отключено, но может пригодиться
				Если Стр.ЗнакОперации = "+" Тогда
					ВывестиСекцию(ТабДок, "Плюс");
				Иначе
					ВывестиСекцию(ТабДок, "Минус");
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Знак = "";
	
	Сумма = Стр.Сумма;
	СуммаПоПоказателю = СуммаПоПоказателю + Сумма;
	ВывестиСекцию(ТабДок, "Слагаемое", СлагаемоеНаименование, Сумма, ?(Лев(Стр.ИмяСлагаемого, 1) = "!", Стр, Неопределено), НомерУзла);
	
КонецПроцедуры

// Функция возвращает строку таблицы значений, описывающую значение ручной корректировки для показателя.
//
// Параметры:
//	Стр - строка таблицы значений, описывающая показатель, для которого требуется получить корректировку.
//
// Возвращаемое значение:
//	СтрокаТаблицыЗначений, описывающая значение ручной корректировки. Неопределено - если строка не задана.
//
Функция ПолучитьСмещение(Стр, ИмяЯчейки, Параметры)
	
	Перем МассивВариантовЗаполненияСтраниц;
	
	мСтруктураВариантыЗаполнения = ПолучитьИзВременногоХранилища(Параметры.Адрес_СтруктураВариантыЗаполнения);
	
	Если НЕ мСтруктураВариантыЗаполнения.Свойство(Стр.Раздел, МассивВариантовЗаполненияСтраниц) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если МассивВариантовЗаполненияСтраниц.Количество() < ?(Стр.Страница = Неопределено, 1, Стр.Страница) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаВариантовЗаполнения = МассивВариантовЗаполненияСтраниц[?(Стр.Страница = Неопределено, 0, Стр.Страница)];
	ИскомаяСтрока = ТаблицаВариантовЗаполнения.Найти(ИмяЯчейки, "КодПоказателя");
	
	Если ИскомаяСтрока = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ИскомаяСтрока;
	
КонецФункции

// ВывестиРасшифровкуОтчета
Функция ВывестиРасшифровкуОтчета(ИмяРаздела, ИмяЯчейки, Параметры, ТекущийРазделРасшифровки = "", ОчищатьПоле = Истина)
	
	ТабДок = Новый ТабличныйДокумент;
	
	ТаблицаРасшифровки = ПолучитьИзВременногоХранилища(Параметры.Адрес_Расшифровка);
	
	ПоследнийНомер = 1;
	Для Каждого СтрокаТаблицы Из ТаблицаРасшифровки Цикл
		
		Если СтрокаТаблицы.Раздел = Неопределено Тогда
			СтрокаТаблицы.Раздел = "ФормаОтчета";
		КонецЕсли;
		
		ПоследнийНомер = Макс(СтрокаТаблицы.НомерСтрокиРасшифровки, ПоследнийНомер);
		
	КонецЦикла;
	
	//НайденныеСтроки = ТаблицаРасшифровки.НайтиСтроки(Новый Структура("Счет", КонсолидированнаяОтчетность.ПолучитьСчетЕ01()));
	//ТекНом = ПоследнийНомер + 1;
	//Для Каждого ТекСтр Из НайденныеСтроки Цикл
	//	ТекСтр.НомерСтрокиРасшифровки = ТекНом;
	//	ТекНом = ТекНом + 1;
	//КонецЦикла;
	
	ТаблицаРасшифровки.Сортировать("Раздел, ИмяЯчейки, НомерСтрокиРасшифровки, Счет, КорСчет, ЗнакОперации Убыв, ИмяСлагаемого");
	
	Если ТаблицаРасшифровки.Колонки.Найти("ОтчетДляРасшифровки") = Неопределено Тогда
		ТаблицаРасшифровки.Колонки.Добавить("ОтчетДляРасшифровки");
	КонецЕсли;
	
	мКолонкаОрганизацияЕсть = (ТаблицаРасшифровки.Колонки.Найти("Организация") <> Неопределено);
	
	// Инициализируем таблицу, в которой будут хранится описания областей отчета, соответствующих
	// расшифровкам показателей.
	ОбластиГруппыСтрок = Новый ТаблицаЗначений;
	ОбластиГруппыСтрок.Колонки.Добавить("Наименование", , "Наименование показателя");
	ОбластиГруппыСтрок.Колонки.Добавить("Верх");
	ОбластиГруппыСтрок.Колонки.Добавить("Низ");
	
	// инициализируем все переменные модуля формы из переменных модуля вызывающей формы
	
	Если ОчищатьПоле Тогда
		ТабДок.Очистить();
	КонецЕсли;
	
	СуммаПоПоказателю = 0;
	Зг = 0;
	Стр = 1;
	
	НомерСтрокиЗначения = 0;
	
	Попытка
		ОсобыйАлгоритмРасшифровки = Параметры.ОсобыйАлгоритмРасшифровки;
	Исключение
		ОсобыйАлгоритмРасшифровки = Ложь;
	КонецПопытки;
	
	Если ОсобыйАлгоритмРасшифровки Тогда
		
		ИмяРазделаРасшифровки = ?(ТекущийРазделРасшифровки = "", ИмяРаздела, ТекущийРазделРасшифровки);
		
		НайденныеСтроки = ТаблицаРасшифровки.НайтиСтроки(Новый Структура("ИмяЯчейки, Раздел", ИмяЯчейки, ИмяРазделаРасшифровки));
		
	Иначе
		
		НайденныеСтроки = ТаблицаРасшифровки.НайтиСтроки(Новый Структура("ИмяЯчейки", ИмяЯчейки));
		
	КонецЕсли;
	
	НайденныеСтрокиТабл = ТаблицаРасшифровки.СкопироватьКолонки();
	Для Каждого СтрокаТаблицыИсточника Из НайденныеСтроки Цикл
		ЗаполнитьЗначенияСвойств(НайденныеСтрокиТабл.Добавить(), СтрокаТаблицыИсточника);
	КонецЦикла;
	
	ТаблицаНайденныхЗаписей = НайденныеСтрокиТабл.Скопировать();
	
	// Колонка "Организация" может присутствовать в таблице ТаблицаРасшифровки и в случае заполнения отчета 
	// не в режиме Консолидации. Для определения режима необходимо
	// свернуть таблицу по полю Организация и получить кол-во записей.
	
	Если мКолонкаОрганизацияЕсть Тогда
		НайденныеСтрокиТабл.Свернуть("Организация", "Сумма");
	Иначе
		НайденныеСтрокиТабл = Новый СписокЗначений;
	КонецЕсли;
	
	РежимКонсолидации = Ложь;
	Если НайденныеСтрокиТабл.Количество() <> 0 Тогда
		
		Если мКолонкаОрганизацияЕсть Тогда
			Если ОсобыйАлгоритмРасшифровки Тогда
				РежимКонсолидации = Истина;
			Иначе
				РежимКонсолидации = (НайденныеСтрокиТабл.Количество() > 1) И (НЕ НайденныеСтрокиТабл[0].Организация = Неопределено);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если РежимКонсолидации Тогда
		ВсегоПоказателей = НайденныеСтрокиТабл.Количество();
	КонецЕсли;
	
	Если НайденныеСтроки.Количество() > 0 И НЕ РежимКонсолидации
		Или РежимКонсолидации И ВсегоПоказателей > 0 Тогда
		
		// Расшифровка для выбранного показателя найдена
		Знак = "+";
		
		Смещение = ПолучитьСмещение(ТаблицаРасшифровки.Получить(0), ИмяЯчейки, Параметры);
		
		Наименование = НайденныеСтроки[0].ИмяПоказателя;
		
		НовСтр = ОбластиГруппыСтрок.Добавить();
		НовСтр.Наименование = Наименование;
		НовСтр.Верх = ТабДок.ВысотаТаблицы + 1;
		
		ВывестиСекцию(ТабДок, "Заголовок", Символы.ПС + Наименование + Символы.ПС + Символы.ПС, , НайденныеСтроки[0]);
		
		Если РежимКонсолидации Тогда
			
			// Выполняем цикл показа показателей с нужной организацией.
			НомерОрганизацииГруппы = 1;
			
			Для Каждого ПоказательОтОрг Из НайденныеСтрокиТабл Цикл
				
				Если ОсобыйАлгоритмРасшифровки Тогда
					НайденныеСтроки = ТаблицаРасшифровки.НайтиСтроки(Новый Структура("ИмяЯчейки, Раздел, Организация", ИмяЯчейки, ИмяРазделаРасшифровки, ПоказательОтОрг.Организация));
				Иначе
					НайденныеСтроки = ТаблицаРасшифровки.НайтиСтроки(Новый Структура("ИмяЯчейки, Организация", ИмяЯчейки, ПоказательОтОрг.Организация));
				КонецЕсли;
				
				ОбщееКолвоЗаписей = НайденныеСтроки.Количество();
				
				// Вывод названия организации.
				НазваниеОбл = "НазваниеОрг";
				Если НомерОрганизацииГруппы = 1 Тогда
					// Первое название организации выводим без верхнего плюса.
					НазваниеОбл = "НазваниеОргБезПлюса";
				Конецесли;
				
				// В качестве верхней группировки можно использовать документ
				НаименованиеГруппировки = ПоказательОтОрг.Организация;
				Если ТипЗнч(ПоказательОтОрг.Организация) = Тип("СправочникСсылка.Организации") Тогда
					НаименованиеГруппировки = ПоказательОтОрг.Организация.Наименование
				КонецЕсли;
				
				ВывестиСекцию(ТабДок, НазваниеОбл + Символы.ПС
				+ НаименованиеГруппировки + Символы.ПС
				+ Формат(ПоказательОтОрг.Сумма, "ЧЦ=15; ЧДЦ=2; ЧН="));
				
				// Начинаем группировку.
				НомерОрганизацииГруппыСтр = Строка(НомерОрганизацииГруппы);
				ИмяГруппы = НаименованиеГруппировки;
				
				// Имя группы получим из названия организации, если оно не указано, то порядковый номер.
				НомерОрганизацииГруппыСтр = ?(ПустаяСтрока(ИмяГруппы), НомерОрганизацииГруппыСтр, ИмяГруппы);
				ТабДок.НачатьГруппуСтрок(НомерОрганизацииГруппыСтр);
				
				Знак = "+";
				
				// Организуем цикл по всем показателям внутри организации.
				Для Инд = 1 По ОбщееКолвоЗаписей Цикл
					ВыводСтроки(ТабДок, СуммаПоПоказателю, НайденныеСтроки[Инд - 1], НомерОрганизацииГруппыСтр);
				КонецЦикла;
				
				НомерОрганизацииГруппы = НомерОрганизацииГруппы + 1;
				
				// Начинаем группировку.
				ТабДок.ЗакончитьГруппуСтрок();
				
			КонецЦикла;
			
		Иначе
			
			Для Каждого Стр Из НайденныеСтроки Цикл
				ВыводСтроки(ТабДок, СуммаПоПоказателю, Стр);
			КонецЦикла;
			
		КонецЕсли;
		
		Дельта = 0;
		Если Смещение <> Неопределено И Смещение.Дельта <> 0 Тогда
			ВывестиСекцию(ТабДок, "Плюс");
			ВывестиСекцию(ТабДок, "Слагаемое", Смещение.Комментарий + ?(ПустаяСтрока(Смещение.Комментарий), "Р", " - р") + "учная корректировка", Смещение.Дельта, НайденныеСтроки[0]);
			Дельта = Дельта + Смещение.Дельта;
		КонецЕсли;
		
		ВывестиСекцию(ТабДок, "Итог", СуммаПоПоказателю + Дельта);
		
		НовСтр.Низ = ТабДок.ВысотаТаблицы;
		
		ТабДок.ТолькоПросмотр = Истина;
		ТабДок.ОтображатьЗаголовки = Ложь;
		ТабДок.ОтображатьСетку = Ложь;
		
		Заголовок = СтрЗаменить(Наименование,Символы.ПС,". ") + " - расшифровка значения";
		
	Иначе
		
	КонецЕсли;
	
	Возврат ТабДок;
	
КонецФункции

// СформироватьМакетРасшифровки
Функция СформироватьМакетРасшифровки(ИмяРаздела, ИмяЯчейки, Параметры) Экспорт
	
	Если Не ЗначениеЗаполнено(ИмяРаздела) //Или Не ЗначениеЗаполнено(ИмяЯчейки)
		Или Не ЗначениеЗаполнено(Параметры.Адрес_Расшифровка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТабДок = ВывестиРасшифровкуОтчета(ИмяРаздела, ИмяЯчейки, Параметры);
	
	УдалитьИзВременногоХранилища(Параметры.Адрес_Расшифровка);
	
	Возврат ТабДок;
	
КонецФункции

#КонецОбласти

Функция ПолучитьСоответствиеРазделов(РазделыОтчета, Знач СписокРазделовПредыдущегоГода)
	
	СоответствиеРазделов = Новый Соответствие;     
	
	// Это соответствие нужно, если форма отчета предыдущего года отличается от формы текущего года.
	// 2024 года. ФормаОтчета*_2024 и ФормаОтчета*_2020 Соответственно. 
	// Изменились некоторые макеты. Ищем их по представлению 
	
	Для каждого ТекСтрока Из РазделыОтчета Цикл
		Представление = ТекСтрока.Представление;
		Для Каждого Элемент из СписокРазделовПредыдущегоГода Цикл   
			Если Элемент.Представление = Представление Тогда 
				СоответствиеРазделов.Вставить(ТекСтрока.ИмяРаздела, Элемент.Значение);	
				СписокРазделовПредыдущегоГода.Удалить(Элемент);
				Прервать;
			КонецЕсли;
		КонецЦикла;	
		Если СписокРазделовПредыдущегоГода.Количество() = 0 Тогда 
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
		
	Возврат СоответствиеРазделов;
	
КонецФункции	

Функция ПолучитьРегламентированныйОтчетВПакете(РегламентированныйОтчет, Знач РазделыОтчета, СохраняемыеРазделы = Неопределено, СписокРазделовПредыдущегоГода = Неопределено, ВыводитьСопоставимыеДанные = Истина, ВыводитьНезаполненныеСтроки = Истина, БезДанныхПоследнегоКвартала = Ложь, СписокРазделовАналогичногоПериодаПредыдущегоГода = Неопределено, ОтчетЗаАналогичныйПериодПрошлогоГода = Неопределено) Экспорт
	
	// БезДанныхПоследнегоКвартала имеет смысл только для ОФР форма МСФО9_2025
	
	Результат = Новый ПакетОтображаемыхДокументов;
	
	РазделТитульнаяСтраница = РазделыОтчета[0].ИмяРаздела;
	ЗаполненныеРазделыТекущегоИПредыдущегоГода = ПолучитьМассивЗаполненныхРазделовРегламентированногоОтчета(РегламентированныйОтчет, СписокРазделовПредыдущегоГода, РазделТитульнаяСтраница, СписокРазделовАналогичногоПериодаПредыдущегоГода, ОтчетЗаАналогичныйПериодПрошлогоГода);
	
	МассивЗаполненныхРазделов = ЗаполненныеРазделыТекущегоИПредыдущегоГода.МассивРазделов;
	Если ЗаполненныеРазделыТекущегоИПредыдущегоГода.Свойство("МассивРазделовПредыдущегоГода") Тогда 
		МассивРазделовПредыдущегоГода = ЗаполненныеРазделыТекущегоИПредыдущегоГода.МассивРазделовПредыдущегоГода;       
		СоответствиеРазделов = ПолучитьСоответствиеРазделов(РазделыОтчета, СписокРазделовПредыдущегоГода);
	КонецЕсли;	
	Если ЗаполненныеРазделыТекущегоИПредыдущегоГода.Свойство("МассивРазделовАналогичногоПериодаПредыдущегоГода") Тогда 
		МассивРазделовАналогичногоПериодаПредыдущегоГода = ЗаполненныеРазделыТекущегоИПредыдущегоГода.МассивРазделовАналогичногоПериодаПредыдущегоГода;       
		СоответствиеРазделов = ПолучитьСоответствиеРазделов(РазделыОтчета, СписокРазделовАналогичногоПериодаПредыдущегоГода);
	КонецЕсли;	

	ТаблицаРазделов = Новый Массив;
	
	Для каждого ТекСтрока Из РазделыОтчета Цикл
	
		ТекРаздел = ТекСтрока.ИмяРаздела;
		
		Если СохраняемыеРазделы <> Неопределено Тогда
			ЭлементСписка = СохраняемыеРазделы.НайтиПоЗначению(ТекРаздел);
			Если ЭлементСписка = Неопределено Тогда 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Раздел отчета '" + ТекРаздел + "' отсутствует в настройке сохраняемых разделов. Настройку необходимо исправить.");
				Продолжить; 
			КонецЕсли;	
			Если НЕ ЭлементСписка.Пометка Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если Не МассивЗаполненныхРазделов.Найти(ТекРаздел) = Неопределено Тогда  
			ДобавитьТабличныйДокументВТаблицуРазделов("ТекущийГод", ТаблицаРазделов, ТекРаздел, ТекСтрока, ВыводитьНезаполненныеСтроки, БезДанныхПоследнегоКвартала);
		КонецЕсли;
			
		Если (ЗначениеЗаполнено(МассивРазделовПредыдущегоГода) ИЛИ ЗначениеЗаполнено(МассивРазделовАналогичногоПериодаПредыдущегоГода))
			И ВыводитьСопоставимыеДанные Тогда
			ТекРазделПредыдущегоГода = ПолучитьРазделПредыдущегоГода(ТекРаздел, СоответствиеРазделов);  
			
			Если ЗначениеЗаполнено(МассивРазделовПредыдущегоГода) И Не МассивРазделовПредыдущегоГода.Найти(ТекРазделПредыдущегоГода) = Неопределено Тогда
				Режим = "ПрошлыйГод";
			ИначеЕсли ЗначениеЗаполнено(МассивРазделовАналогичногоПериодаПредыдущегоГода) И Не МассивРазделовАналогичногоПериодаПредыдущегоГода.Найти(ТекРазделПредыдущегоГода) = Неопределено Тогда
				Режим = "АналогичныйПериод";
			Иначе
				Продолжить;
			КонецЕсли;	
			
			ДобавитьТабличныйДокументВТаблицуРазделов(Режим, ТаблицаРазделов, ТекРазделПредыдущегоГода, ТекСтрока, ВыводитьНезаполненныеСтроки);
			
		КонецЕсли;
		
	КонецЦикла; 
	
	ВыводитьОшибку = Ложь;
	ВыводитьОшибкуОтчетаЗаАналогичныйПериод  = Ложь; 
	Если СписокРазделовАналогичногоПериодаПредыдущегоГода <> Неопределено И НЕ ЗначениеЗаполнено(МассивРазделовАналогичногоПериодаПредыдущегоГода) И ВыводитьСопоставимыеДанные Тогда 
		ВыводитьОшибкуОтчетаЗаАналогичныйПериод  = Истина; // заплатка на случай, если программно отчет найти не удалось.
	Иначе	
		ВыводитьОшибкуОтчетаЗаАналогичныйПериод  = Ложь;
	КонецЕсли;
	
	Для Каждого ТекРаздел из ТаблицаРазделов Цикл
		
		ТекЗаголовок = ТекРаздел.ИмяЛиста;  
		
		ПозицияРазделителя = СтрНайти(ТекРаздел.ИмяРаздела, "_", НаправлениеПоиска.СКонца);
		Если ПозицияРазделителя > 0 Тогда
			ОкончаниеИмениРаздела = Сред(ТекРаздел.ИмяРаздела, ПозицияРазделителя);
			ИмяРаздела = Лев(ТекРаздел.ИмяРаздела, ПозицияРазделителя - 1);
			
			ТабличныйДокумент = Новый ТабличныйДокумент;
			ТабличныйДокумент.Вывести(ТекРаздел.ТабличныйДокумент);
			
			Если ОкончаниеИмениРаздела = "_ПрошлыйГод" Тогда
				ТабличныйДокумент = ЗаполнитьРазделРегламентированногоОтчетаЗаПрошлыйГод(ТабличныйДокумент, ИмяРаздела, РегламентированныйОтчет.ОтчетНаКонецПрошлогоГода); 
			ИначеЕсли ОкончаниеИмениРаздела = "_АналогичныйПериод" Тогда  
				ТабличныйДокумент = ЗаполнитьРазделРегламентированногоОтчетаЗаПрошлыйГод(ТабличныйДокумент, ИмяРаздела, ОтчетЗаАналогичныйПериодПрошлогоГода)
			КонецЕсли;
			
			Если ТабличныйДокумент = Неопределено Тогда 
				
				Если ОкончаниеИмениРаздела = "_ПрошлыйГод" Тогда
					ВыводитьОшибку = Истина;
				ИначеЕсли ОкончаниеИмениРаздела = "_АналогичныйПериод" Тогда
					ВыводитьОшибкуОтчетаЗаАналогичныйПериод = Истина;
				КонецЕсли;
				Продолжить;
			КонецЕсли;   
			
		Иначе
			ТабличныйДокумент = ТекРаздел.ТабличныйДокумент;
		КонецЕсли;	
			
		НовыйЭлемент = Результат.Состав.Добавить(ПоместитьВоВременноеХранилище(ТабличныйДокумент, Новый УникальныйИдентификатор));		
		НовыйЭлемент.Наименование = ТекРаздел.ИмяЛиста; 		
		
	КонецЦикла;
	
	Если ВыводитьОшибку Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отчет за предыдущий год не заполнен, соответствующие данные не выгружены.");
	КонецЕсли;

	Если ВыводитьОшибкуОтчетаЗаАналогичныйПериод Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отчет за аналогичный период прошлого года не заполнен, соответствующие данные не выгружены.");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УдалитьПустыеСтрокиТабличногоДокумента(ТабличныйДокумент, ИмяРаздела)
	//Кодом процедуры поделился Павел Кузнецов

	// Удаление нулевых строк
	ОбластиРаздела = ТабличныйДокумент.Области;
	
	МассивПустыхСтрок = Новый СписокЗначений;
	МассивНеПустыхСтрок = Новый Массив;
	
	Для Каждого ТекОбласть Из ОбластиРаздела Цикл
		//Анализируем = Истина;
		Если ТекОбласть.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
			Попытка
				Если НЕ  ТекОбласть.СодержитЗначение Тогда
					Продолжить;
				КонецЕсли;
			Исключение
				Продолжить
			КонецПопытки;
		Иначе
			Продолжить
		КонецЕсли;
		
		//Критерий области = Параметр, содержит значение типа число
		//Некоторые таблицы имеют значащие ячейки с Типом  Строка. 
		ОблИмя = СокрЛП(ТекОбласть.Имя);
		Если (Лев(ОблИмя,1) = "П" ИЛИ Лев(ОблИмя,1) = "Д") И СтрДлина(ОблИмя) < 7 И ТекОбласть.СодержитЗначение Тогда
			НомерСтроки = ТекОбласть.Верх; НомерСтолбца =  ТекОбласть.Лево;
			//Формируем массивы заполненных строк и пустых строк
			Если ЗначениеЗаполнено(ТекОбласть.Значение) Тогда
				Если МассивНеПустыхСтрок.Найти(НомерСтроки) = НЕОПРЕДЕЛЕНО Тогда
					МассивНеПустыхСтрок.Добавить(НомерСтроки);
				КонецЕсли;
			Иначе
				Если МассивПустыхСтрок.НайтиПоЗначению(НомерСтроки) = НЕОПРЕДЕЛЕНО Тогда
					МассивПустыхСтрок.Добавить(НомерСтроки);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//удаляем из массива пустых строк непустые 
	Для каждого НеПустаяСтрока Из МассивНеПустыхСтрок Цикл
		ИндексНеПустаяСтрока= МассивПустыхСтрок.НайтиПоЗначению(НеПустаяСтрока);
		Если НЕ  ИндексНеПустаяСтрока = НЕОПРЕДЕЛЕНО Тогда
			МассивПустыхСтрок.Удалить(ИндексНеПустаяСтрока);
		КонецЕсли;
	КонецЦикла;   
	
	//удаляем пустые строки со смещением вверх
	МассивПустыхСтрок.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
	Для каждого ПустаяСтрока Из МассивПустыхСтрок Цикл
		Смещать = ТипСмещенияТабличногоДокумента.ПоВертикали;
		ОбластьСтрока = ТабличныйДокумент.Область("R"+ПустаяСтрока.Значение);
		ТабличныйДокумент.УдалитьОбласть(ОбластьСтрока,Смещать);
	КонецЦикла;   
	                
КонецПроцедуры

Процедура ДобавитьТабличныйДокументВТаблицуРазделов(Режим, ТаблицаРазделов, ТекРаздел, ТекСтрока, ВыводитьНезаполненныеСтроки, БезДанныхПоследнегоКвартала = Ложь)
	
	Если Режим = "ТекущийГод" Тогда 
		ДобавкаИмяЛиста = "";
		ДобавкаПредставление = "";
	ИначеЕсли Режим = "ПрошлыйГод" Тогда
		ДобавкаИмяЛиста = "_ПрошлыйГод";
		ДобавкаПредставление = " (Прошлый год)";
	ИначеЕсли Режим = "АналогичныйПериод" Тогда
		ДобавкаИмяЛиста = "_АналогичныйПериод";
		ДобавкаПредставление = " (Аналогичный период)";
	КонецЕсли;
	
	Если БезДанныхПоследнегоКвартала Тогда
		Область = ТекСтрока.ТабличныйДокумент.Области.Найти("СекцияПоследнийКвартал");  
		Если Область <> Неопределено Тогда 
			Область.Очистить(Истина, Истина, Истина); 
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ВыводитьНезаполненныеСтроки Тогда 
		УдалитьПустыеСтрокиТабличногоДокумента(ТекСтрока.ТабличныйДокумент, ТекРаздел);    
	КонецЕсли;
	
	ТаблицаРазделов.Добавить(Новый Структура("ИмяРаздела, ИмяЛиста, ТабличныйДокумент", 
	ТекРаздел + ДобавкаИмяЛиста, 
	ТекСтрока.Представление + ДобавкаПредставление, 
	ТекСтрока.ТабличныйДокумент));
	
КонецПроцедуры 

Функция ПолучитьРазделПредыдущегоГода(ТекРаздел, СоответствиеРазделов)  
	
	ТекРазделПредыдущегоГода = СоответствиеРазделов.Получить(ТекРаздел);
	Если ТекРазделПредыдущегоГода = Неопределено Тогда 
		ТекРазделПредыдущегоГода = ТекРаздел;
	КонецЕсли;

	Возврат ТекРазделПредыдущегоГода;
	
КонецФункции


