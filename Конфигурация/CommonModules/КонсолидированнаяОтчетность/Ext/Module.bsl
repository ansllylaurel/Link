			|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОбороты.КорСубконто2, ОперацииСЦеннымиБумагами.Основание),
			|	ЛОЖЬ,
			|	ЕСТЬNULL(_Сделки.ЭтоЦБдоПогашения, ЛОЖЬ),
			|	ЕСТЬNULL(_Сделки.ЭтоЦБдляПродажи, ЛОЖЬ),
			|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОбороты.СуммаОборот, ОперацииСЦеннымиБумагами.Сумма)
			|ИЗ
			|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
			|		ЛЕВОЕ СОЕДИНЕНИЕ _Сделки КАК _Сделки
			|		ПО ОперацииСЦеннымиБумагами.Основание = _Сделки.Сделка
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(
			|				&НачалоПериода,
			|				&КонецПериода,
			|				Регистратор,
			|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетныеСчета01),
			|				,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|					И Субконто2 = ЗНАЧЕНИЕ(Справочник.ВидыДвиженияДенежныхСредств.ПогашениеОблигации),
			|				,
			|				) КАК ЕдиныйБухгалтерскийУчетОбороты
			|		ПО ОперацииСЦеннымиБумагами.Операция = ЕдиныйБухгалтерскийУчетОбороты.Регистратор
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПогашениеЦеннойБумаги КАК ПогашениеЦеннойБумаги
			|		ПО ОперацииСЦеннымиБумагами.Основание = ПогашениеЦеннойБумаги.Ссылка
			|ГДЕ
			|	ОперацииСЦеннымиБумагами.Организация = &Организация
			|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &НачалоПериода И &КонецПериода
			|	И ОперацииСЦеннымиБумагами.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|	И ОперацииСЦеннымиБумагами.Сумма > 0
			|	И ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Основание) = ТИП(Документ.ПогашениеЦеннойБумаги)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СУММА(_ДвиженияДС.СуммаОборот) КАК СуммаОборот,
			|	_ДвиженияДС.ЭтоЦБдоПогашения КАК ЭтоЦБдоПогашения,
			|	_ДвиженияДС.ЭтоЦБдляПродажи КАК ЭтоЦБдляПродажи,
			|	_ДвиженияДС.ВидДвиженияДС КАК ВидДвиженияДС,
			|	_ДвиженияДС.ЭтоСделкаСВалютой КАК ЭтоСделкаСВалютой
			|ИЗ
			|	_ДвиженияДС КАК _ДвиженияДС
			|
			|СГРУППИРОВАТЬ ПО
			|	_ДвиженияДС.ВидДвиженияДС,
			|	_ДвиженияДС.ЭтоЦБдоПогашения,
			|	_ДвиженияДС.ЭтоЦБдляПродажи,
			|	_ДвиженияДС.ЭтоСделкаСВалютой
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _Сделки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ДвиженияДС";
			
			Запрос.УстановитьПараметр("Организация", 					Запрос.Параметры.Организация);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	Запрос.Параметры.СчетДоверительногоУправления);
			
			мТаблицаДвиженийДС_ТП = Запрос.Выполнить().Выгрузить();
			
			//учтем дату реформации за прошлый год. ДатаНачалаПрошлогоПериодаОтчетаСУчетомРеформации есть только в редакции МСФО 9 2025
			Если Запрос.Параметры.Свойство("ДатаНачалаПрошлогоПериодаОтчетаСУчетомРеформации")
				И Запрос.Параметры.ДатаНачалаПрошлогоПериодаОтчетаСУчетомРеформации = Неопределено Тогда
				мТаблицаДвиженийДС_ПП = мТаблицаДвиженийДС_ТП.Скопировать();
				мТаблицаДвиженийДС_ПП.Очистить();
				//не считаем данные за прошлый год. 
			Иначе
				Если Запрос.Параметры.Свойство("ДатаНачалаПрошлогоПериодаОтчетаСУчетомРеформации") Тогда 
					Запрос.УстановитьПараметр("НачалоПредыдущегоПериода", Запрос.Параметры.ДатаНачалаПрошлогоПериодаОтчетаСУчетомРеформации); 
				КонецЕсли;
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "НачалоПериода", "НачалоПредыдущегоПериода");
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "КонецПериода", "КонецПредыдущегоПериода");
				мТаблицаДвиженийДС_ПП = Запрос.Выполнить().Выгрузить();
			КонецЕсли;
					
			Результат.Вставить("ДвиженияДС_ТП", 	мТаблицаДвиженийДС_ТП);
			Результат.Вставить("ДвиженияДС_ПП", 	мТаблицаДвиженийДС_ПП);
			
		КонецЕсли		
	КонецЦикла;					
	
	Запрос.МенеджерВременныхТаблиц.Закрыть();
	
	Возврат Результат;
	
КонецФункции

Процедура ОчиститьОбластьТабличногоДокумента(ТекРаздел, НачальныйНомерСтроки, КонечныйНомерСтроки, НачальныйНомерКолонки, КонечныйНомерКолонки) Экспорт

	Для НомКол = НачальныйНомерКолонки по КонечныйНомерКолонки Цикл 
		НомКолСтрока = Формат(НомКол, "ЧЦ=2; ЧДЦ=0; ЧВН=");		
		Для НомСтр = НачальныйНомерСтроки По КонечныйНомерСтроки Цикл
			НомСтрСтрока = Формат(НомСтр, "ЧЦ=2; ЧДЦ=0; ЧВН=");
			Ячейка = ТекРаздел.Области["П" + НомСтрСтрока + НомКолСтрока];
			Если ТипЗнч(Ячейка.Значение) = Тип("Строка") Тогда 
				Ячейка.Значение = "";       // 10.4 в Баланс МСФО 9
			Иначе
				Ячейка.Значение = 0;    //число в большинстве случаев. 
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;		
	
КонецПроцедуры 

//06.05.2025 Из двух функций делаю одну. 
// В балансе формы 2024 остается вызов старых функций. 
// функции ПолучитьДепозитныеВкладыДолгосрочные() и ПолучитьДепозитныеВкладыКраткосрочные() оставлены как заглушики
// в форме 2025 г. вызывается  ПолучитьДепозитныеВклады

Функция ПолучитьДепозитныеВкладыДолгосрочные(НастройкиОтчета, СтруктураРеквизитовФормы) Экспорт
	
	Возврат ПолучитьДепозитныеВклады(НастройкиОтчета, СтруктураРеквизитовФормы, , "Долгосрочные");
	
КонецФункции 

Функция ПолучитьДепозитныеВкладыКраткосрочные(НастройкиОтчета, СтруктураРеквизитовФормы) Экспорт
	
	Возврат ПолучитьДепозитныеВклады(НастройкиОтчета, СтруктураРеквизитовФормы, , "Краткосрочные");

КонецФункции 

Функция ПолучитьДепозитныеВклады(НастройкиОтчета, СтруктураРеквизитовФормы, СчитатьДляЧего = "Тело", ПризнакПоСроку = "ДолгосрочныеИКраткосрочные", БратьНастройкиОПДС = Ложь) Экспорт
	
	УчитыватьПроценты = ?(БратьНастройкиОПДС, НастройкиОтчета.НеУчитыватьПроцентыПоДепозитамВДС_ОПДС, НастройкиОтчета.НеУчитыватьПроцентыПоДепозитамВДС);
	Если УчитыватьПроценты = Неопределено Тогда
		УчитыватьПроценты = Ложь;
	КонецЕсли;   
	
	// логика вывернутая.  По умолчанию проценты учитываются в ДС. 
	// Если НеУчитыватьПроцентыПоДепозитамВДС = истина, тогда проценты будем учитывать вместе депозитом. 
	// поэтому УчитыватьПроценты = Истина, т.к. локально в этой функции надо учесть % по депозитам.  
	
	Если ПризнакПоСроку = "ДолгосрочныеИКраткосрочные"  Тогда 
		
		Условие = " ИСТИНА"; 
	
	ИначеЕсли ПризнакПоСроку = "Долгосрочные" Тогда
		
		Условие = " РАЗНОСТЬДАТ(ВЫРАЗИТЬ(ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).ДатаРегистрации, УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения, ДЕНЬ) >= &КоличествоДнейДляПризнанияДепозитаДолгосрочным";
		
		Если СчитатьДляЧего = "Проценты" И УчитыватьПроценты Тогда
			Условие = " ИСТИНА";  
			// если мы не учитываем проценты в ДС, тогда проценты по всем депозитам попадают в долгосрочные. 
		КонецЕсли;
		
	ИначеЕсли ПризнакПоСроку = "Краткосрочные" Тогда
		
		Условие = " РАЗНОСТЬДАТ(ВЫРАЗИТЬ(ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).ДатаРегистрации, УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения, ДЕНЬ) < &КоличествоДнейДляПризнанияДепозитаДолгосрочным";
		
		Если СчитатьДляЧего = "Проценты" И УчитыватьПроценты Тогда
			Возврат Новый Массив; 
			// так как % уже учтены в долгосрочных, вернем пустой массив. 
		КонецЕсли; 
	Иначе 
		ВызватьИсключение "Указан недопуститимый признак разделения по сроку: " + ПризнакПоСроку;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.КредитныйИнструмент КАК ДепозитныйВклад
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Период,
		|			,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)) КАК ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|			УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения
		|		ИЗ
		|			(ВЫБРАТЬ
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|				МАКСИМУМ(УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
		|			ИЗ
		|				РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&КонецПериода, ) КАК УсловияКредитныхИнструментовСрезПоследних
		|			ГДЕ
		|				УсловияКредитныхИнструментовСрезПоследних.Действует
		|			
		|			СГРУППИРОВАТЬ ПО
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент) КАК АктуальныеДатыНачалаДействия
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&КонецПериода, ) КАК УсловияКредитныхИнструментовСрезПоследних
		|				ПО АктуальныеДатыНачалаДействия.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|					И АктуальныеДатыНачалаДействия.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК УсловияКредитныхИнструментовСрезПоследних
		|		ПО ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|ГДЕ
		|	&УсловиеНаСрокДепозита
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.КредитныйИнструмент
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.ОстаткиИОбороты(
		|			&НачалоПрошлогоПериода,
		|			&КонецПрошлогоПериода,
		|			Период,
		|			,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)) КАК ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|			УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения
		|		ИЗ
		|			(ВЫБРАТЬ
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|				МАКСИМУМ(УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
		|			ИЗ
		|				РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&КонецПрошлогоПериода, ) КАК УсловияКредитныхИнструментовСрезПоследних
		|			ГДЕ
		|				УсловияКредитныхИнструментовСрезПоследних.Действует
		|			
		|			СГРУППИРОВАТЬ ПО
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент) КАК АктуальныеДатыНачалаДействия
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&КонецПрошлогоПериода, ) КАК УсловияКредитныхИнструментовСрезПоследних
		|				ПО АктуальныеДатыНачалаДействия.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|					И АктуальныеДатыНачалаДействия.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК УсловияКредитныхИнструментовСрезПоследних
		|		ПО ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|ГДЕ
		|	&УсловиеНаСрокДепозита";
	
	Запрос.УстановитьПараметр("КоличествоДнейДляПризнанияДепозитаДолгосрочным", ?(БратьНастройкиОПДС, НастройкиОтчета.КоличествоДнейДляПризнанияДепозитаДолгосрочным_ОПДС, НастройкиОтчета.КоличествоДнейДляПризнанияДепозитаДолгосрочным));
	Запрос.УстановитьПараметр("НачалоПериода", СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета);
	Запрос.УстановитьПараметр("КонецПериода", СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета);
	Запрос.УстановитьПараметр("НачалоПрошлогоПериода", СтруктураРеквизитовФормы.мДатаНачалаПрошлогоПериодаОтчета);
	Запрос.УстановитьПараметр("КонецПрошлогоПериода", СтруктураРеквизитовФормы.мДатаКонцаПрошлогоПериодаОтчета);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СтруктураРеквизитовФормы.СчетДоверительногоУправления); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНаСрокДепозита", Условие); 
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДепозитныйВклад");
	
КонецФункции

Функция ПолучитьТаблицуРейтинговНаДату(ДатаРейтинга) Экспорт  
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаРейтинга", ДатаРейтинга);  	
		
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	РейтингиСрезПоследних.Субъект КАК Субъект,
		|	РейтингиСрезПоследних.Шкала.ТипШкалы КАК ТипШкалы,
		|	РейтингиСрезПоследних.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	РейтингиСрезПоследних.Шкала КАК Шкала,
		|	РейтингиСрезПоследних.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	ЕСТЬNULL(СопоставлениеРейтинговыхШкалСрезПоследних.СтрокаСопоставления, 5) КАК СтрокаСопоставления,
		|	РейтингиСрезПоследних.Период КАК Период
		|ПОМЕСТИТЬ _РейтингиСрезПоследних
		|ИЗ
		|	РегистрСведений.Рейтинги.СрезПоследних(&ДатаРейтинга, ) КАК РейтингиСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СопоставлениеРейтинговыхШкал.СрезПоследних(&ДатаРейтинга, Источник = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПереченьЦБ_РФДляОтчетности)) КАК СопоставлениеРейтинговыхШкалСрезПоследних
		|		ПО РейтингиСрезПоследних.Шкала = СопоставлениеРейтинговыхШкалСрезПоследних.ШкалаРейтингаЭталонная
		|			И (РейтингиСрезПоследних.ЗначениеРейтинга.Оценка МЕЖДУ СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМаксимальное.Оценка И СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМинимальное.Оценка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_РейтингиСрезПоследних.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	ВЫБОР
		|		КОГДА _РейтингиСрезПоследних.РейтинговоеАгентство = ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.АКРА)
		|			ТОГДА 1
		|		КОГДА _РейтингиСрезПоследних.РейтинговоеАгентство = ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.RAEX)
		|			ТОГДА 2
		|		КОГДА _РейтингиСрезПоследних.РейтинговоеАгентство = ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.FitchRatings)
		|			ТОГДА 3
		|		КОГДА _РейтингиСрезПоследних.РейтинговоеАгентство = ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.Moodys)
		|			ТОГДА 4
		|		КОГДА _РейтингиСрезПоследних.РейтинговоеАгентство = ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.StandardAndPoors)
		|			ТОГДА 5
		|	КОНЕЦ КАК ПриоритетРейтинговогоАгентства
		|ПОМЕСТИТЬ _ПриоритетыРейтинговыхАгентств
		|ИЗ
		|	_РейтингиСрезПоследних КАК _РейтингиСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Субъект КАК Субъект,
		|	ВложенныйЗапрос.ТипШкалы КАК ТипШкалы,
		|	ВложенныйЗапрос.СтрокаСопоставления КАК СтрокаСопоставления,
		|	_РейтингиСрезПоследних.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	_РейтингиСрезПоследних.Шкала КАК Шкала,
		|	_РейтингиСрезПоследних.Шкала.ТипШкалы КАК ШкалаТипШкалы,
		|	_РейтингиСрезПоследних.Шкала.Владелец КАК ШкалаВладелец,
		|	_РейтингиСрезПоследних.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	_РейтингиСрезПоследних.ЗначениеРейтинга.Наименование КАК ЗначениеРейтингаНаименование,
		|	_РейтингиСрезПоследних.Период КАК Период
		|ИЗ
		|	(ВЫБРАТЬ
		|		_СтрокиСМаксимальнымРейтингом.Субъект КАК Субъект,
		|		_СтрокиСМаксимальнымРейтингом.ТипШкалы КАК ТипШкалы,
		|		_СтрокиСМаксимальнымРейтингом.СтрокаСопоставления КАК СтрокаСопоставления,
		|		МИНИМУМ(_ПриоритетыРейтинговыхАгентств.ПриоритетРейтинговогоАгентства) КАК ПриоритетРейтинговогоАгентства
		|	ИЗ
		|		(ВЫБРАТЬ
		|			_РейтингиСрезПоследних.Субъект КАК Субъект,
		|			_РейтингиСрезПоследних.ТипШкалы КАК ТипШкалы,
		|			МИНИМУМ(_РейтингиСрезПоследних.СтрокаСопоставления) КАК СтрокаСопоставления
		|		ИЗ
		|			_РейтингиСрезПоследних КАК _РейтингиСрезПоследних
		|		ГДЕ
		|			НЕ _РейтингиСрезПоследних.ЗначениеРейтинга.РейтингСнят
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_РейтингиСрезПоследних.Субъект,
		|			_РейтингиСрезПоследних.ТипШкалы) КАК _СтрокиСМаксимальнымРейтингом
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _РейтингиСрезПоследних КАК _РейтингиСрезПоследних
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПриоритетыРейтинговыхАгентств КАК _ПриоритетыРейтинговыхАгентств
		|				ПО _РейтингиСрезПоследних.РейтинговоеАгентство = _ПриоритетыРейтинговыхАгентств.РейтинговоеАгентство
		|			ПО _СтрокиСМаксимальнымРейтингом.Субъект = _РейтингиСрезПоследних.Субъект
		|				И _СтрокиСМаксимальнымРейтингом.ТипШкалы = _РейтингиСрезПоследних.ТипШкалы
		|				И _СтрокиСМаксимальнымРейтингом.СтрокаСопоставления = _РейтингиСрезПоследних.СтрокаСопоставления
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_СтрокиСМаксимальнымРейтингом.Субъект,
		|		_СтрокиСМаксимальнымРейтингом.ТипШкалы,
		|		_СтрокиСМаксимальнымРейтингом.СтрокаСопоставления) КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПриоритетыРейтинговыхАгентств КАК _ПриоритетыРейтинговыхАгентств
		|		ПО ВложенныйЗапрос.ПриоритетРейтинговогоАгентства = _ПриоритетыРейтинговыхАгентств.ПриоритетРейтинговогоАгентства
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _РейтингиСрезПоследних КАК _РейтингиСрезПоследних
		|		ПО (_ПриоритетыРейтинговыхАгентств.РейтинговоеАгентство = _РейтингиСрезПоследних.РейтинговоеАгентство)
		|			И ВложенныйЗапрос.Субъект = _РейтингиСрезПоследних.Субъект
		|			И ВложенныйЗапрос.ТипШкалы = _РейтингиСрезПоследних.ТипШкалы
		|			И ВложенныйЗапрос.СтрокаСопоставления = _РейтингиСрезПоследних.СтрокаСопоставления";	
	
	Возврат Запрос.Выполнить().Выгрузить(); 

КонецФункции

Функция ПолучитьЗапросРезервПоДепозитамСервер(СтруктураРеквизитовФормы, НастройкиОтчета, СписокДепозитов, ВидСальдо, БратьНастройкиОПДС = Ложь) Экспорт 
		
	Запрос = Новый Запрос;
	Запрос.Текст =  
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""НаКонец"" КАК ВидСальдо,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Депозит,
		|	СУММА(ВЫБОР
		|			КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты01)
		|				ТОГДА ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаДепозит,
		|	СУММА(ВЫБОР
		|			КОГДА НЕ(ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты01)
		|						ИЛИ ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты15))
		|				ТОГДА ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаПроцент,
		|	СУММА(ВЫБОР
		|			КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты15)
		|				ТОГДА ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаРезерв
		|ПОМЕСТИТЬ _ДанныеДепозиты
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&грКонецПериода,
		|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты)),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И &ОтборДепозиты) КАК ЕдиныйБухгалтерскийУчетОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""НаНачало"",
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2,
		|	СУММА(ВЫБОР
		|			КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты01)
		|				ТОГДА ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ),
		|	СУММА(ВЫБОР
		|			КОГДА НЕ(ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты01)
		|						ИЛИ ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты15))
		|				ТОГДА ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ),
		|	СУММА(ВЫБОР
		|			КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты15)
		|				ТОГДА ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ)
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&НачалоПериода,
		|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты)),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И &ОтборДепозиты) КАК ЕдиныйБухгалтерскийУчетОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.ВидСальдо КАК ВидСальдо,
		|	СУММА(ВложенныйЗапрос.РезервДепозит) КАК РезервДепозит,
		|	СУММА(ВложенныйЗапрос.РезервПроцент) КАК РезервПроцент
		|ПОМЕСТИТЬ _РезервНачалоКонец
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ДанныеДепозиты.ВидСальдо КАК ВидСальдо,
		|		_ДанныеДепозиты.СуммаРезерв - ВЫБОР
		|			КОГДА &ПроцентыПоДепозитамВДС
		|				ТОГДА 0
		|			ИНАЧЕ ВЫРАЗИТЬ(_ДанныеДепозиты.СуммаРезерв * _ДанныеДепозиты.СуммаПроцент / (_ДанныеДепозиты.СуммаДепозит + _ДанныеДепозиты.СуммаПроцент) КАК ЧИСЛО(19, 2))
		|		КОНЕЦ КАК РезервДепозит,
		|		ВЫБОР
		|			КОГДА &ПроцентыПоДепозитамВДС
		|				ТОГДА 0
		|			ИНАЧЕ ВЫРАЗИТЬ(_ДанныеДепозиты.СуммаРезерв * _ДанныеДепозиты.СуммаПроцент / (_ДанныеДепозиты.СуммаДепозит + _ДанныеДепозиты.СуммаПроцент) КАК ЧИСЛО(19, 2))
		|		КОНЕЦ КАК РезервПроцент
		|	ИЗ
		|		_ДанныеДепозиты КАК _ДанныеДепозиты
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		""НаНачало"",
		|		0,
		|		0
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		""НаКонец"",
		|		0,
		|		0) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.ВидСальдо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РезервНачалоКонец.ВидСальдо КАК ВидСальдо,
		|	_РезервНачалоКонец.РезервДепозит КАК РезервДепозит,
		|	_РезервНачалоКонец.РезервПроцент КАК РезервПроцент
		|ПОМЕСТИТЬ _Резерв
		|ИЗ
		|	_РезервНачалоКонец КАК _РезервНачалоКонец
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Оборот"",
		|	ЕСТЬNULL(_РезервКонец.РезервДепозит, 0) - ЕСТЬNULL(_РезервНачало.РезервДепозит, 0),
		|	ЕСТЬNULL(_РезервКонец.РезервПроцент, 0) - ЕСТЬNULL(_РезервНачало.РезервПроцент, 0)
		|ИЗ
		|	_РезервНачалоКонец КАК _РезервНачало
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РезервНачалоКонец КАК _РезервКонец
		|		ПО (ИСТИНА)
		|ГДЕ
		|	_РезервНачало.ВидСальдо = ""НаНачало""
		|	И _РезервКонец.ВидСальдо = ""НаКонец""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_Резерв.ВидСальдо КАК ВидСальдо,
		|	_Резерв.РезервДепозит КАК РезервДепозит,
		|	_Резерв.РезервПроцент КАК РезервПроцент
		|ИЗ
		|	_Резерв КАК _Резерв
		|ГДЕ
		|	_Резерв.ВидСальдо = &ВидСальдо"; 
		
	Запрос.УстановитьПараметр("Организация", СтруктураРеквизитовФормы.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СтруктураРеквизитовФормы.СчетДоверительногоУправления); 
	Если СписокДепозитов = Неопределено Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборДепозиты", "ИСТИНА");
	Иначе   
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборДепозиты", "Субконто2 В (&СписокДепозитов)");
		Запрос.УстановитьПараметр("СписокДепозитов", СписокДепозитов); 
	КонецЕсли;
	Запрос.УстановитьПараметр("СписокДепозитов", СписокДепозитов);    
	НеУчитыватьПроцентыПоДепозитамВДС = ?(БратьНастройкиОПДС, НастройкиОтчета.НеУчитыватьПроцентыПоДепозитамВДС_ОПДС, НастройкиОтчета.НеУчитыватьПроцентыПоДепозитамВДС);
	Запрос.УстановитьПараметр("ПроцентыПоДепозитамВДС", ?(НеУчитыватьПроцентыПоДепозитамВДС = Неопределено, ИСТИНА, НЕ НеУчитыватьПроцентыПоДепозитамВДС));  
	Запрос.УстановитьПараметр("ВидСальдо", ВидСальдо);
	
	Возврат Запрос;
	
КонецФункции

Функция ЕстьВнешняяРасшифровка(СтруктураРеквизитовФормы, ИмяРаздела, ИмяЯчейки) Экспорт
	
	Если СтруктураРеквизитовФормы.мВыбраннаяФорма = "ФормаОтчета_МСФО9_2025"
		И ИмяРаздела = "АнализСправедливойСтоимостиИБалансоваяСтоимость2025"
		И СтрНайти("П1102, П1103, П1104, П1302, П1303, П1304, П1602, П1603, П1604, П1702, П1703, П1704", ИмяЯчейки) > 0 Тогда 
		Возврат Истина;  
	ИначеЕсли СтруктураРеквизитовФормы.мВыбраннаяФорма = "ФормаОтчета_МСФО9_СК_2025"
		И ИмяРаздела = "АнализСправедливойСтоимостиИБалансоваяСтоимостьСК" 
		И СтрНайти("П1002, П1003, П1004, П1202, П1203, П1204, П1502, П1503, П1504, П1702, П1703, П1704", ИмяЯчейки) > 0  Тогда 
		Возврат Истина;    
	ИначеЕсли СтруктураРеквизитовФормы.мВыбраннаяФорма = "ФормаОтчета_МСФО9_2025" 
		И (ИмяРаздела = "РейтингиДолговыхТаблица50_8"
			ИЛИ ИмяРаздела = "РейтингиДолговыхТаблица50_9"
			ИЛИ ИмяРаздела = "РейтингиДолговыхОбесцененныхТаблица50_10") Тогда 
		Возврат Истина;
	ИначеЕсли СтруктураРеквизитовФормы.мВыбраннаяФорма = "ФормаОтчета_МСФО9_СК_2025" 
		И (ИмяРаздела = "РейтингиДолговыхТаблица58_12"
			ИЛИ ИмяРаздела = "РейтингиДолговыхТаблица58_13"
			ИЛИ ИмяРаздела = "РейтингиДолговыхОбесцененныхТаблица58_14") Тогда 
		Возврат Истина; 
	ИначеЕсли СтруктураРеквизитовФормы.мВыбраннаяФорма = "ФормаОтчета_МСФО9_2025"
		И ИмяРаздела = "ИнформацияОСверкеИзмененийПоУровню3ИерархииСС" Тогда 
		Возврат Истина;  
	ИначеЕсли СтруктураРеквизитовФормы.мВыбраннаяФорма = "ФормаОтчета_МСФО9_СК_2025"
		И ИмяРаздела = "ИнформацияОСверкеИзмененийПоУровню3ИерархииСС" Тогда 
		Возврат Истина;    
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции   

Функция ПолучитьПараметрыВнешнейРасшифровки(СтруктураРеквизитовФормы, ИмяРаздела, ПараметрыФормы) Экспорт
	
	Если (СтруктураРеквизитовФормы.мВыбраннаяФорма = "ФормаОтчета_МСФО9_2025"
		И ИмяРаздела = "АнализСправедливойСтоимостиИБалансоваяСтоимость2025") 
		ИЛИ 
		(СтруктураРеквизитовФормы.мВыбраннаяФорма = "ФормаОтчета_МСФО9_СК_2025"
		И ИмяРаздела = "АнализСправедливойСтоимостиИБалансоваяСтоимостьСК") Тогда 

		ИмяОбъекта = "_РасшифровкаАнализСправедливойСтоимостиАктивовНеОцениваемыхПоСC";
		
		ПараметрыФормы.Вставить("Организация", СтруктураРеквизитовФормы.Организация);  
		ПараметрыФормы.Вставить("СчетДоверительногоУправления", СтруктураРеквизитовФормы.СчетДоверительногоУправления);
		ПараметрыФормы.Вставить("Период", СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета);  
		
	ИначеЕсли (СтруктураРеквизитовФормы.мВыбраннаяФорма = "ФормаОтчета_МСФО9_2025"
		И (ИмяРаздела = "РейтингиДолговыхТаблица50_8"
			ИЛИ ИмяРаздела = "РейтингиДолговыхТаблица50_9"
			ИЛИ ИмяРаздела = "РейтингиДолговыхОбесцененныхТаблица50_10")) 
		ИЛИ 
		(СтруктураРеквизитовФормы.мВыбраннаяФорма = "ФормаОтчета_МСФО9_СК_2025"
		И(ИмяРаздела = "РейтингиДолговыхТаблица58_12"
			ИЛИ ИмяРаздела = "РейтингиДолговыхТаблица58_13"
			ИЛИ ИмяРаздела = "РейтингиДолговыхОбесцененныхТаблица58_14")) Тогда 
			
		ИмяОбъекта = "_РасшифровкаИнформацииОКредитныхРейтингах";
		
		ПараметрыФормы.Вставить("Организация", СтруктураРеквизитовФормы.Организация);  
		ПараметрыФормы.Вставить("СчетДоверительногоУправления", СтруктураРеквизитовФормы.СчетДоверительногоУправления);
		ПараметрыФормы.Вставить("Период", СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета); 
		
	ИначеЕсли (СтруктураРеквизитовФормы.мВыбраннаяФорма = "ФормаОтчета_МСФО9_2025"
			ИЛИ СтруктураРеквизитовФормы.мВыбраннаяФорма = "ФормаОтчета_МСФО9_СК_2025")
		 И	ИмяРаздела = "ИнформацияОСверкеИзмененийПоУровню3ИерархииСС" Тогда
		 

		ИмяОбъекта = "_ИзмененияНаУровне3";
		
		ПараметрыФормы.Вставить("Организация", СтруктураРеквизитовФормы.Организация);  
		ПараметрыФормы.Вставить("СчетДоверительногоУправления", СтруктураРеквизитовФормы.СчетДоверительногоУправления);
		ПараметрыФормы.Вставить("Период", Новый СтандартныйПериод(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета, СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета)); 
		 
		 
	КонецЕсли; 

	СсылкаНаРасшифровку =  РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта(ИмяОбъекта);	
	
	Если Не ЗначениеЗаполнено(СсылкаНаРасшифровку) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяПодключенногоОбъекта	= РаботаСДополнительнымиОтчетамиИОбработками.ПодключитьВнешнююОбработку(СсылкаНаРасшифровку);
	ВидОбъекта				= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаРасшифровку, "Вид");
	
	Если ВидОбъекта = ПредопределенноеЗначение("Перечисление.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет") Тогда
		Возврат "ВнешнийОтчет." + ИмяПодключенногоОбъекта + ".Форма";
	Иначе
		Возврат "ВнешняяОбработка." + ИмяПодключенногоОбъекта + ".Форма";
	КонецЕсли;
	
КонецФункции

Процедура СкопироватьОбласть(ТекРаздел, НачальныйНомерКолонки, КонечныйНомерКолонки, НачальныйНомерСтроки, КонечныйНомерСтроки, СдвигПоВертикали, СдвигПоГоризонтали) Экспорт
	
	// Вызывается из ОФР (МСФО 9 2025) из нескольких примечаний. Используется, чтобы повторно не считать данные за 1-й квартал, если сам отчет за 1-й квартал. 
	// в Балансе есть одноименная функция, но она немного отличается и выполняет перенос данных прошлого года. Нужна только на момент перехода на МСФО 9 
	// с 2026 года не нужна. 
 
	
	Для НомКол = НачальныйНомерКолонки по КонечныйНомерКолонки Цикл 
		НомКолСтрокаОткуда = Формат(НомКол, "ЧЦ=2; ЧДЦ=0; ЧВН=");
		НомКолСтрокаКуда = Формат(НомКол + СдвигПоГоризонтали, "ЧЦ=2; ЧДЦ=0; ЧВН=");
		
		Для НомСтр = НачальныйНомерСтроки По КонечныйНомерСтроки Цикл
			НомСтрСтрокаОткуда = Формат(НомСтр, "ЧЦ=2; ЧДЦ=0; ЧВН=");
			НомСтрСтрокаКуда = Формат(НомСтр + СдвигПоВертикали, "ЧЦ=2; ЧДЦ=0; ЧВН=");
			ЯчейкаОткуда = ТекРаздел.Области["П" + НомСтрСтрокаОткуда + НомКолСтрокаОткуда];
			ЯчейкаКуда = ТекРаздел.Области["П" + НомСтрСтрокаКуда + НомКолСтрокаКуда];  
			ЯчейкаКуда.Значение = ЯчейкаОткуда.Значение;
		КонецЦикла;
	КонецЦикла;
		
КонецПроцедуры    

#КонецОбласти
