// ТипСправочникаСодержитсяВРегистреБухгалтерии
Функция ТипСправочникаСодержитсяВРегистреБухгалтерии(стрТипСправочника) Экспорт
	
	// определим какой по наличию плана счетов какой ПВХ нужно проверять.
	мдПВХ = Метаданные.ПланыВидовХарактеристик.ВидыСубконто;
	
	мТипы = мдПВХ.Тип.Типы();
	Попытка
		Если мТипы.Найти(Тип("СправочникСсылка." + стрТипСправочника)) = Неопределено Тогда
			Возврат ЛОЖЬ;
		КонецЕсли;
	Исключение
		Возврат ЛОЖЬ;
	КонецПопытки;
	
	Возврат ИСТИНА;
	
КонецФункции //ТипСправочникаСодержитсяВРегистреБухгалтерии

// г_стрОтборВирт_ВидыДоходовРасходовНФО_Кор
Функция г_стрОтборВирт_ВидыДоходовРасходовНФО_Кор(КолСубконто) Экспорт
	
	ТекстВернуть = 
	"	И ВЫБОР";
	
