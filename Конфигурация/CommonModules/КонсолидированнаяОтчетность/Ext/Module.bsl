// ЗаполнитьРазделПоСпискуСчетовЗаПериод_ОбесцененныеНеобесцененные_ТекстЗапроса.
Функция ЗаполнитьРазделПоСпискуСчетовЗаПериод_ОбесцененныеНеобесцененные_ТекстЗапроса(ЭтаФорма) Экспорт
	
	// определим количество субконто в плане счетов
	КолСубконто = Метаданные.ПланыСчетов.Единый.МаксКоличествоСубконто;
	
	// !!!!!!определим список справочников, необходимых для запроса
	сзСправочники = Новый СписокЗначений;
	сзСправочники.Добавить("ДепозитныеВклады");
	сзСправочники.Добавить("Договоры");
	сзСправочники.Добавить("ДоговорыБрокерскогоОбслуживания");
	сзСправочники.Добавить("Акции");
	сзСправочники.Добавить("Облигации");
	сзСправочники.Добавить("Паи");
	сзСправочники.Добавить("Векселя");
	сзСправочники.Добавить("ПроизводныеФинансовыеИнструменты");
	
	Для Каждого эл_сзСправочники из сзСправочники Цикл
		
		эл_сзСправочники.Пометка = НЕ (Метаданные.Справочники.Найти(эл_сзСправочники.Значение) = Неопределено);
		
		Если НЕ ТипСправочникаСодержитсяВРегистреБухгалтерии(эл_сзСправочники.Значение) Тогда
			эл_сзСправочники.Пометка = ЛОЖЬ;
		КонецЕсли;
		
	КонецЦикла;
	
	// определим тексты для подмены
	Текст1 = "";
	Текст2 = "";
	Текст3 = "";
	Текст4 = "";
	Для сч = 1 по КолСубконто Цикл
		
		Для Каждого эл_сзСправочники из сзСправочники Цикл
			Если НЕ эл_сзСправочники.Пометка Тогда
				Продолжить;
			КонецЕсли;
			
			Текст1 = Текст1 + "
			|			КОГДА ВЫРАЗИТЬ(вэУправленческий.Субконто" + сч + " КАК Справочник." + эл_сзСправочники.Значение + ") ССЫЛКА Справочник." + эл_сзСправочники.Значение + "
			
			|				ТОГДА вэУправленческий.Субконто" + сч;
			
			Текст2 = Текст2 + "
			|					КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто" + сч + " ССЫЛКА Справочник." + эл_сзСправочники.Значение + "
			|						ТОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто" + сч;
			
			Текст3 = Текст3 + "
			|				И (НЕ втНеобесцененныеАктивы.ЦеннаяБумага = ЗНАЧЕНИЕ(Справочник." + эл_сзСправочники.Значение + ".ПустаяСсылка))"
			
		КонецЦикла; //Для Каждого эл_сзСправочники из сзСправочники Цикл
		
		Текст4 = Текст4 + ?(Текст4 = "", "", " ИЛИ ") + "
		|						Субконто" + сч + " В
		|								(ВЫБРАТЬ
		|									втНеобесцененныеАктивы.ЦеннаяБумага КАК ЦеннаяБумага
		|								ИЗ
		|									втНеобесцененныеАктивы КАК втНеобесцененныеАктивы)";
		 
			
		
	КонецЦикла; //Для сч = 1 по КолСубконто Цикл
	
	Текст4 = "(" + Текст4 + ")";
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	ВложенныйЗапрос.Счет КАК Счет,
	|	СУММА(ВложенныйЗапрос.СуммаКонечныйОстатокДт) КАК СуммаКонечныйОстатокДт,
	|	СУММА(ВложенныйЗапрос.СуммаКонечныйОстатокКт) КАК СуммаКонечныйОстатокКт,
	|	ВложенныйЗапрос.ЦеннаяБумага КАК ЦеннаяБумага
	|ПОМЕСТИТЬ втНеобесцененныеАктивы
	|ИЗ
	|	(ВЫБРАТЬ
	|		вэУправленческий.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|		вэУправленческий.Счет КАК Счет,
	|		вэУправленческий.СуммаОстатокДт КАК СуммаКонечныйОстатокДт,
	|		вэУправленческий.СуммаОстатокКт КАК СуммаКонечныйОстатокКт,
	|		ВЫБОР"
	
	
	// #528487 Если по ценной бумаге есть резерв, то вся балансовая стоимость становится обесцененной
	+ Текст1 + "
	
	|			ИНАЧЕ НЕОПРЕДЕЛЕНО
	|		КОНЕЦ КАК ЦеннаяБумага
	|	ИЗ
	|		РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
	|				&грКонецПериода,
	|				Счет В ИЕРАРХИИ (&СписокСчетов),
	|				,
	|				СчетДоверительногоУправления = &СчетДоверительногоУправления
	|					И &стрОтборВирт) КАК вэУправленческий) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.СчетДоверительногоУправления,
	|	ВложенныйЗапрос.Счет,
	|	ВложенныйЗапрос.ЦеннаяБумага
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.Счет КАК Счет,
	|	ВложенныйЗапрос.СуммаКонечныйОстатокДт КАК СуммаКонечныйОстатокДт,
	|	ВложенныйЗапрос.СуммаКонечныйОстатокКт КАК СуммаКонечныйОстатокКт,
	|	ВложенныйЗапрос.СуммаОбесцененныеДт КАК СуммаОбесцененныеДт,
	|	ВложенныйЗапрос.СуммаОбесцененныеКт КАК СуммаОбесцененныеКт
	|ИЗ
	|	(ВЫБРАТЬ
	|		втНеобесцененныеАктивы.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|		втНеобесцененныеАктивы.Счет КАК Счет,
	|		СУММА(втНеобесцененныеАктивы.СуммаКонечныйОстатокДт) КАК СуммаКонечныйОстатокДт,
	|		СУММА(втНеобесцененныеАктивы.СуммаКонечныйОстатокКт) КАК СуммаКонечныйОстатокКт,
	|		СУММА(ВЫБОР
	|				КОГДА ЕСТЬNULL(ОстаткиОбесцененные.СуммаОстатокДт, 0) + ЕСТЬNULL(ОстаткиОбесцененные.СуммаОстатокКт, 0) = 0
	|					ТОГДА ЕСТЬNULL(ОстаткиОбесцененные.СуммаОстатокДт, 0)
	|				ИНАЧЕ втНеобесцененныеАктивы.СуммаКонечныйОстатокКт
	|			КОНЕЦ) КАК СуммаОбесцененныеДт,
	|		СУММА(ВЫБОР
	|				КОГДА ЕСТЬNULL(ОстаткиОбесцененные.СуммаОстатокДт, 0) + ЕСТЬNULL(ОстаткиОбесцененные.СуммаОстатокКт, 0) = 0
	|					ТОГДА ЕСТЬNULL(ОстаткиОбесцененные.СуммаОстатокКт, 0)
	|				ИНАЧЕ втНеобесцененныеАктивы.СуммаКонечныйОстатокДт
	|			КОНЕЦ) КАК СуммаОбесцененныеКт	
	|	ИЗ
	|		втНеобесцененныеАктивы КАК втНеобесцененныеАктивы
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|				ЕдиныйБухгалтерскийУчетОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,	
	|				ВЫБОР"		
		
	+ Текст2 + "
	
	|					ИНАЧЕ НЕОПРЕДЕЛЕНО
	|				КОНЕЦ КАК ЦеннаяБумага,
	|				СУММА(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт) КАК СуммаОстатокДт,
	|				СУММА(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт) КАК СуммаОстатокКт
	|			ИЗ
	|				РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
	|						&грКонецПериода,
	|						Счет В (&СчетОбесцененные),
	|						, " + Текст4 + "
	|							И &стрОтборВирт) КАК ЕдиныйБухгалтерскийУчетОстатки
	|			
	|			СГРУППИРОВАТЬ ПО
	|				ЕдиныйБухгалтерскийУчетОстатки.СчетДоверительногоУправления,
	|				ВЫБОР"
	
	+ Текст2 + "
	
	
	|					ИНАЧЕ НЕОПРЕДЕЛЕНО
	|				КОНЕЦ) КАК ОстаткиОбесцененные
	|			ПО втНеобесцененныеАктивы.СчетДоверительногоУправления = ОстаткиОбесцененные.СчетДоверительногоУправления
	|				И втНеобесцененныеАктивы.ЦеннаяБумага = ОстаткиОбесцененные.ЦеннаяБумага
	|				И (НЕ втНеобесцененныеАктивы.ЦеннаяБумага = НЕОПРЕДЕЛЕНО)"
	
	+ Текст3 + "
	
	|	
	|	СГРУППИРОВАТЬ ПО
	|		втНеобесцененныеАктивы.СчетДоверительногоУправления,
	|		втНеобесцененныеАктивы.Счет) КАК ВложенныйЗапрос
	|ИТОГИ
	|	СУММА(СуммаКонечныйОстатокДт),
	|	СУММА(СуммаКонечныйОстатокКт),
	|	СУММА(СуммаОбесцененныеДт),
	|	СУММА(СуммаОбесцененныеКт)
	|ПО
	|	Счет";	
	
	Возврат ТекстЗапроса;
	
КонецФункции  //ЗаполнитьРазделПоСпискуСчетовЗаПериод_ОбесцененныеНеобесцененные_ТекстЗапроса

// ЗаполнитьНастройкиПоУмолчанию
Процедура ЗаполнитьНастройкиПоУмолчанию(Объект, ЭтаФорма) Экспорт
	
	// Период - текущий месяц.
	Объект.ДатаНачала = НачалоГода(ТекущаяДата());
	Объект.ДатаОкончания = КонецМесяца(ТекущаяДата());
	Объект.ТочностьЕдиницыИзмерения	= 2;
	//!!!!!!
	//Если НЕ Объект.Ссылка.Метаданные().Реквизиты.Найти("Состояние") = Неопределено Тогда
	//	Объект.Состояние = Перечисления.УПЦБ_СостоянияОтчетов.Выполняется;
	//КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
	
Функция ПолучитьМассивЗаполненныхРазделовРегламентированногоОтчета(Ссылка, СписокРазделовПредыдущегоГода, РазделТитульнаяСтраница, СписокРазделовАналогичногоПериодаПредыдущегоГода, ОтчетЗаАналогичныйПериодПрошлогоГода) Экспорт
	
	Результат = Новый Структура;
	
	ДанныеОтчета = Ссылка.ДанныеОтчета.Получить();
		
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Показатели.ИмяРаздела КАК ИмяРаздела
		|ПОМЕСТИТЬ Показатели
		|ИЗ
		|	&Показатели КАК Показатели
		|ГДЕ
		|	ВЫРАЗИТЬ(Показатели.ИмяПоказателя КАК СТРОКА(2)) ПОДОБНО ""П[0-9]%""
		|	И Показатели.Значение <> 0
		|	И Показатели.Значение <> """"
		|	И Показатели.Значение <> ""-""
		|	И &ИмяРаздела
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Показатели.ИмяРаздела КАК ИмяРаздела
		|ИЗ
		|	Показатели КАК Показатели";
	
	
	МассивСписов = Новый Массив;
	МассивСписов.Добавить("МассивРазделов"); 
	Если ЗначениеЗаполнено(СписокРазделовПредыдущегоГода) И ЗначениеЗаполнено(Ссылка.ОтчетНаКонецПрошлогоГода) Тогда
    	МассивСписов.Добавить("МассивРазделовПредыдущегоГода");
	КонецЕсли;
	Если ЗначениеЗаполнено(СписокРазделовАналогичногоПериодаПредыдущегоГода) И ЗначениеЗаполнено(ОтчетЗаАналогичныйПериодПрошлогоГода) Тогда
    	МассивСписов.Добавить("МассивРазделовАналогичногоПериодаПредыдущегоГода");
	КонецЕсли;
	
	Для Каждого ЭлементМассива из МассивСписов Цикл
		Если ЭлементМассива = "МассивРазделов" Тогда
			Запрос.Текст = ТекстЗапроса; 
			Запрос.УстановитьПараметр("ИмяРаздела", Истина);
			Запрос.УстановитьПараметр("Показатели", ДанныеОтчета.ПоказателиОтчета);
		Иначе
			Запрос.Текст = СтрЗаменить(ТекстЗапроса, "&ИмяРаздела", "Показатели.ИмяРаздела В (&СписокРазделов)"); 
			Если ЭлементМассива = "МассивРазделовПредыдущегоГода" Тогда 
				СписокРазделов = СписокРазделовПредыдущегоГода;
				ДанныеОтчета = Ссылка.ОтчетНаКонецПрошлогоГода.ДанныеОтчета.Получить(); 
			ИначеЕсли ЭлементМассива = "МассивРазделовАналогичногоПериодаПредыдущегоГода" Тогда
				СписокРазделов = СписокРазделовАналогичногоПериодаПредыдущегоГода;
				ДанныеОтчета = ОтчетЗаАналогичныйПериодПрошлогоГода.ДанныеОтчета.Получить();
			КонецЕсли;
			
			Запрос.УстановитьПараметр("Показатели", ДанныеОтчета.ПоказателиОтчета);
			Запрос.УстановитьПараметр("СписокРазделов", СписокРазделов);	
		КонецЕсли;
		
		МассивРазделов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
		
		// Как минимум должен быть титульный лист - остальной баланс может быть пустой т.к. клиент расторгся или вывелся
		// или есть заполненные разделы, но титульная страница пустая. 	
		Если ЭлементМассива = "МассивРазделов" И МассивРазделов.Найти(РазделТитульнаяСтраница) = Неопределено Тогда	
			МассивРазделов.Добавить(РазделТитульнаяСтраница);
		КонецЕсли; 
		Если ЭлементМассива = "МассивРазделовПредыдущегоГода" Тогда
			ЕстьТитульнаяСтраница = ?(СписокРазделовПредыдущегоГода.НайтиПоЗначению(РазделТитульнаяСтраница) = Неопределено, ЛОЖЬ, ИСТИНА);
			Если ЕстьТитульнаяСтраница И МассивРазделов.Найти(РазделТитульнаяСтраница) = Неопределено Тогда
				МассивРазделов.Добавить(РазделТитульнаяСтраница);
			КонецЕсли;
		КонецЕсли;
		
		Результат.Вставить(ЭлементМассива, МассивРазделов);
		
	КонецЦикла;	

	Возврат Результат;
		
КонецФункции

Процедура ДобавитьШапку(ЭтаФорма) Экспорт

	Если ЭтаФорма.ШапкаДобавлена Тогда
		Возврат;
	Иначе
		ЭтаФорма.ШапкаДобавлена = Истина;
	КонецЕсли;
	
	МакетШапка   = ПолучитьОбщийМакет("ОбщиеОбластиСтандартногоОтчета");
	ОбластьШапка = МакетШапка.ПолучитьОбласть("ШапкаБухгалтерскихОтчетовЕПС");
	ПараметрыШапки = ПолучитьПараметрыШапки(ЭтаФорма.Объект);
	
	Если ЗначениеЗаполнено(ПараметрыШапки) Тогда
	
		ОбластьШапка.Параметры.Заполнить(ПараметрыШапки);
		ОбластьШапка.Параметры.ДатаДоговора = Формат(ПараметрыШапки.ДатаДоговора, "ДФ=dd.MM.yyyy");
		ОбластьШапка.Параметры.ДатаОтчета = Формат(ПараметрыШапки.ДатаОтчета, "ДФ=dd.MM.yyyy");
	
	КонецЕсли;
		
	мМассивРазделов = ПолучитьИзВременногоХранилища(ЭтаФорма.Адрес_мМассивРазделов);
	
	Для Каждого ИмяРаздела Из мМассивРазделов Цикл
		Попытка
			ТабДок = ЭтаФорма["ТабличныйДокумент" + ИмяРаздела];
			Если Не СтрНачинаетсяС(ИмяРаздела, "ОтчетТитульнаяСтраница") Тогда
				
				ОбластьТаблица = ТабДок.НайтиТекст("Таблица ");
				ШиринаТаблицы = ?(ОбластьТаблица = Неопределено, ТабДок.ШиринаТаблицы, ОбластьТаблица.Лево);
				
				Для НомерСтроки = 1 По 4 Цикл
				
					Область = ОбластьШапка.Область(НомерСтроки, 1, НомерСтроки, ШиринаТаблицы);
					Область.Объединить();
				
				КонецЦикла;
				
				ТабДок.ВставитьОбласть(ОбластьШапка.Область(1, , 4, ), ТабДок.Область(1, , 4, ), ТипСмещенияТабличногоДокумента.ПоВертикали, Истина);
				
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры
 
Функция ПолучитьПараметрыШапки(Объект) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|ПОМЕСТИТЬ _КлиентДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицОрганизации.КраткоеНаименованиеПоУставу КАК ДоверительныйУправляющий,
		|	СчетаДоверительногоУправления.НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора,
		|	&Период КАК ДатаОтчета,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицКлиента.КраткоеНаименованиеПоУставу, РеквизитыФизическихЛицКлиента.Фамилия + "" "" + ПОДСТРОКА(РеквизитыФизическихЛицКлиента.Имя, 1, 1) + "". "" + ПОДСТРОКА(РеквизитыФизическихЛицКлиента.Отчество, 1, 1) + ""."") КАК УчредительУправления
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, ЮрФизЛицо = &ЮрФизЛицо И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицОрганизации,
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления,
		|	_КлиентДоверительногоУправления КАК _КлиентДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(, Организация = &Организация И Язык = &Язык) КАК РеквизитыФизическихЛицКлиента
		|		ПО _КлиентДоверительногоУправления.Клиент = РеквизитыФизическихЛицКлиента.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(, Организация = &Организация И Язык = &Язык) КАК РеквизитыЮридическихЛицКлиента
		|		ПО _КлиентДоверительногоУправления.Клиент = РеквизитыЮридическихЛицКлиента.ЮрФизЛицо
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления";
	
	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		Запрос.УстановитьПараметр("Период", Объект.мДатаКонцаПериодаОтчета);
	Иначе	
		Запрос.УстановитьПараметр("Период", Объект.ДатаОкончания);
	КонецЕсли; 	
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Язык", Справочники.Языки.Русский);
	Запрос.УстановитьПараметр("ЮрФизЛицо", Объект.Организация.ЮрФизЛицо);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	КонецЕсли;
		
КонецФункции

Процедура ЗаполнитьСоставПоказателейПоМакету(МакетСоставаПоказателей, ТаблицаСоставПоказателей, СтруктураВариантыЗаполнения) Экспорт

	Для каждого Область Из МакетСоставаПоказателей.Области Цикл
		
		ИмяОбласти = Область.Имя;
		ОбластьМакета = МакетСоставаПоказателей.ПолучитьОбласть(ИмяОбласти);
		
		ТаблицаПоказателей = Новый ТаблицаЗначений;
		ТаблицаПоказателей.Колонки.Добавить("ВариантЗаполнения", 	Новый ОписаниеТипов("Число"));
		ТаблицаПоказателей.Колонки.Добавить("Дельта", 				Новый ОписаниеТипов("Число"));
		ТаблицаПоказателей.Колонки.Добавить("ЗначениеАвто", 		Новый ОписаниеТипов("Число"));
		ТаблицаПоказателей.Колонки.Добавить("КодПоказателя", 		Новый ОписаниеТипов("Строка"));
		ТаблицаПоказателей.Колонки.Добавить("Комментарий", 			Новый ОписаниеТипов("Строка"));
		
		КоличествоСтрок = ОбластьМакета.ВысотаТаблицы;
		
		Для НомерСтроки = 1 По КоличествоСтрок Цикл
		
			// добавляем строку в таблицу состава показателей
			НоваяСтрока = ТаблицаСоставПоказателей.Добавить();
			НоваяСтрока.ИмяПоляТаблДокумента 		= ИмяОбласти;
			НоваяСтрока.КодПоказателяПоСоставу 		= ОбластьМакета.Область(НомерСтроки, 1).Текст;
			НоваяСтрока.КодПоказателяПоФорме 		= ОбластьМакета.Область(НомерСтроки, 2).Текст;
			НоваяСтрока.ПризнМногострочности 		= ОбластьМакета.Область(НомерСтроки, 3).Текст;
			НоваяСтрока.ТипДанныхПоказателя 		= ОбластьМакета.Область(НомерСтроки, 4).Текст;
			НоваяСтрока.КодПоказателяПоСтруктуре 	= ОбластьМакета.Область(НомерСтроки, 5).Текст;
			
			// заполняем структуру вариантов заполнения
			ВариантЗаполнения = ОбластьМакета.Область(НомерСтроки, 6).Текст;
			Если ЗначениеЗаполнено(ВариантЗаполнения) Тогда
			
				НоваяСтрока = ТаблицаПоказателей.Добавить();
				НоваяСтрока.ВариантЗаполнения = ВариантЗаполнения;
				НоваяСтрока.КодПоказателя = ОбластьМакета.Область(НомерСтроки, 1).Текст;
			
			КонецЕсли; 
		
		КонецЦикла;
		
		МассивТаблиц = Новый Массив;
		МассивТаблиц.Добавить(ТаблицаПоказателей);
		СтруктураВариантыЗаполнения.Вставить(ИмяОбласти, МассивТаблиц);
	
	КонецЦикла;

КонецПроцедуры
          	
Процедура ЗаполнитьЗаголовки(Объект, ЭтаФорма, ИмяРаздела) Экспорт
	
	Если ИмяРаздела = "" Тогда
		мМассивРазделов = ПолучитьИзВременногоХранилища(ЭтаФорма.Адрес_мМассивРазделов);
	Иначе
		мМассивРазделов = Новый Массив;
		мМассивРазделов.Добавить(ИмяРаздела);
	КонецЕсли;
	
	мМассивМногострочныхРазделов = ПолучитьИзВременногоХранилища(ЭтаФорма.Адрес_мМассивМногострочныхРазделов); // #НадзорнаяОтчетность
	
	Для Каждого ТекИмяРаздела из мМассивРазделов Цикл
		Если ТекИмяРаздела = "Настройка"
			или ТекИмяРаздела = "Проверка"
			или ТекИмяРаздела = "ПроверкаПротоколОшибок"
			или НЕ мМассивМногострочныхРазделов.Найти(ТекИмяРаздела) = Неопределено  // #НадзорнаяОтчетность
			или СтрЧислоВхождений(ИмяРаздела, "МногострочныйРаздел") > 0             // #НадзорнаяОтчетность
			Тогда
			Продолжить;
		КонецЕсли;
		
		ТекРаздел = ЭтаФорма["ТабличныйДокумент" + ТекИмяРаздела];
		
		// Настройки заполнения шапки: Текущий период
		ЗаполнитьЗаголовки_УстановитьЗначениеВОбласть(ТекРаздел.Области, "ТекущийПериод", ЭтаФорма.мПредставлениеТекущегоПериода);
		
		// Настройки заполнения шапки: Предыдущий период
		Если НЕ ЭтаФорма.Элементы.Найти("ДокументЗаПредыдущийПериод") = Неопределено
			и ЗначениеЗаполнено(ЭтаФорма.мПредставлениеПредыдущегоПериода)
			Тогда
			ЗаполнитьЗаголовки_УстановитьЗначениеВОбласть(ТекРаздел.Области, "ПредыдущийПериод", "На " + Формат(Объект.ДокументЗаПредыдущийПериод.ДатаОкончания, "ДФ=dd.MM.yyyy")); // #НадзорнаяОтчетность
		Иначе
			ЗаполнитьЗаголовки_УстановитьЗначениеВОбласть(ТекРаздел.Области, "ПредыдущийПериод", ЭтаФорма.мПредставлениеПредыдущегоПериода);
		КонецЕсли;
		
		// Настройки для заголовков периодов
		ЗаполнитьЗаголовки_УстановитьЗначениеВОбласть(ТекРаздел.Области, "ЗаголовокНачалоПериода", "Балансовая стоимость на " + Формат(Объект.ДатаНачала, "ДФ=dd.MM.yyyy") + " г.");
		ЗаполнитьЗаголовки_УстановитьЗначениеВОбласть(ТекРаздел.Области, "ЗаголовокКонецПериода", "Балансовая стоимость на " + Формат(Объект.ДатаОкончания, "ДФ=dd.MM.yyyy") + " г.");
		
		// Настройки для титульного листа
		Если ТекИмяРаздела = ЭтаФорма.ИмяОсновногоРаздела Тогда
			ЗаполнитьЗаголовки_УстановитьЗначениеВОбласть(ТекРаздел.Области, "ТекущийПериод1", Формат(Объект.ДатаОкончания, "ДФ=dd.MM.yyyy"));
			
			СведенияОбОрганизации = СведенияОЮрФизЛице(Объект.СчетДоверительногоУправления, Объект.ДатаОкончания);
			ЗаполнитьЗаголовки_УстановитьЗначениеВОбласть(ТекРаздел.Области, "Организация", СведенияОбОрганизации.НаименованиеОрганизации + " Д.У. " + 
				СведенияОбОрганизации.ПолноеНаименование + " (" + СведенияОбОрганизации.КраткоеНаименование + ") по договору №" + 
				СведенияОбОрганизации.НомерДоговора + " от " + Формат(СведенияОбОрганизации.ДатаДоговора, "ДФ=dd.MM.yyyy"));
			ЗаполнитьЗаголовки_УстановитьЗначениеВОбласть(ТекРаздел.Области, "ПочтовыйАдресОрганизации", СведенияОбОрганизации.ЮридическийАдрес);
			
			ЗаполнитьЗаголовки_УстановитьЗначениеВОбласть(ТекРаздел.Области, "ОрганизацияОГРН", СведенияОбОрганизации.ОГРН);
			ЗаполнитьЗаголовки_УстановитьЗначениеВОбласть(ТекРаздел.Области, "ОрганизацияИНН", СведенияОбОрганизации.ИНН);
			
			Попытка ЗаполнитьЗаголовки_УстановитьЗначениеВОбласть(ТекРаздел.Области, "ОрганизацияОКАТО", СведенияОбОрганизации.КодПоОКТМО) Исключение КонецПопытки;
			
			//!!!!!!ЗаполнитьЗаголовки_УстановитьЗначениеВОбласть(ТекРаздел.Области, "ОрганизацияНомерЛицензии", ОпределитьЛицензиюОрганизации(Объект, Организация));
			
			//// заполним подписантов
			//СтрукДанныеПодписантов = ПолучитьДанныеПодписантов(Объект);
			//ЗаполнитьЗаголовки_УстановитьЗначениеВОбласть(ТекРаздел.Области, "РуководительФИО", СтрукДанныеПодписантов.РуководительФИО);
			//ЗаполнитьЗаголовки_УстановитьЗначениеВОбласть(ТекРаздел.Области, "ОтветственныйФИО", СтрукДанныеПодписантов.ОтветственныйФИО);
			//ЗаполнитьЗаголовки_УстановитьЗначениеВОбласть(ТекРаздел.Области, "ОтветственныйДолжность", СтрукДанныеПодписантов.ОтветственныйДолжность);
			
		ИначеЕсли ТекИмяРаздела = "" Тогда
			
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьЗаголовки_УстановитьЗначениеВОбласть(Области, ИмяОбласти, Значение)
	
	ТекОбласть = Области.Найти(ИмяОбласти);
	
	Если НЕ ТекОбласть = Неопределено
		и ТекОбласть.СодержитЗначение
		Тогда
		ТекОбласть.Значение = Значение;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьДатуПеречняФинансовыхОрганизаций(ДатаОкончания) Экспорт

	// #Тедолг - сделать правильно! и красиво!
	
	ДатаПеречня = КонецДня(ДатаОкончания) + 1;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	МАКСИМУМ(Периоды.Период) КАК Период
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ПеречниОбъектов.Период КАК Период
	               |	ИЗ
	               |		РегистрСведений.ПеречниОбъектов КАК ПеречниОбъектов
	               |	ГДЕ
	               |		ПеречниОбъектов.Период <= &ДатаПеречня
	               |		И ПеречниОбъектов.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЦБРФ)
	               |		И ПеречниОбъектов.ВидПеречня.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ЦБРФ_ПереченьОрганизацийФинансовогоСектора)
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		ПеречниОбъектов.Период
	               |	
	               |	ИМЕЮЩИЕ
	               |		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПеречниОбъектов.Объект) >= 499) КАК Периоды";
	Запрос.УстановитьПараметр("ДатаПеречня", ДатаПеречня);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДатаПеречня = Выборка.Период;
	КонецЕсли;
	
	Возврат ДатаПеречня;

КонецФункции
 
Функция ИсточникОтчета(ИмяФормыСтр) Экспорт
	
	МассивИмениФормы = СтрРазделить(ИмяФормыСтр, ".", Ложь);
	Если СтрНачинаетсяС(МассивИмениФормы[1], "РегламентированныйОтчет") Тогда
		Возврат МассивИмениФормы[1];
		
	КонецЕсли;
	
	Для Каждого ЭлементИмени Из МассивИмениФормы Цикл
		Если СтрНачинаетсяС(ЭлементИмени, "РегламентированныйОтчет") Тогда
			Возврат ЭлементИмени;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция ПредставлениеФинансовогоПериода(ДатаНачалаОтчетногоПериода, ДатаОкончанияОтчетногоПериода, ФП = "Истина") Экспорт

	ДатаНачалаОП    = ?(ЗначениеЗаполнено(ДатаНачалаОтчетногоПериода), ДатаНачалаОтчетногоПериода, Дата(1, 1, 1));
	ДатаОкончанияОП = ?(ЗначениеЗаполнено(ДатаОкончанияОтчетногоПериода), ДатаОкончанияОтчетногоПериода, Дата(1, 1, 1));
	ДатаОкончанияОП = ?(ДатаНачалаОП > ДатаОкончанияОП, ДатаНачалаОП, ДатаОкончанияОП);
	
	ПредставлениеФинПериода = ПредставлениеПериода(НачалоДня(ДатаНачалаОП), КонецДня(ДатаОкончанияОП), "Л=ru_RU;ФП=" + ФП);
	
	Если ЗначениеЗаполнено(ДатаОкончанияОтчетногоПериода) Тогда
		
		ПредставлениеФинПериодаГод = ПредставлениеПериода(НачалоГода(ДатаОкончанияОП), КонецГода(ДатаОкончанияОП), "Л=ru_RU;ФП=" + ФП);
		
		Если ФП = "Ложь"
		   И ДатаНачалаОП = НачалоГода(ДатаНачалаОП) Тогда
			
			Если СтрНайти(ПредставлениеФинПериода, "1 квартал") > 0 Тогда
				
				ПредставлениеФинПериода = СтрЗаменить(ПредставлениеФинПериода, НСтр("ru='1 квартал'"), НСтр("ru='Январь - Март'"));
				
			ИначеЕсли ПредставлениеФинПериода = ПредставлениеФинПериодаГод Тогда
				
				ПредставлениеФинПериода = НСтр("ru='Январь - Декабрь '") + ПредставлениеФинПериодаГод;
				
			КонецЕсли;	
			
		КонецЕсли;
						
		Если СтрНайти(ПредставлениеФинПериода, ПредставлениеФинПериодаГод) > 0 Тогда
			
			ПредставлениеФинПериода = СтрЗаменить(СтрЗаменить(ПредставлениеФинПериода, ПредставлениеФинПериодаГод, ""), "  ", " ")
									+ ПредставлениеФинПериодаГод;
									
		КонецЕсли; 
		
								
	КонецЕсли;
		
	Возврат ПредставлениеФинПериода;
	
КонецФункции

Процедура ЗаполнитьНачальныеНастройкиСервер(Параметры) Экспорт
	
	МакетСоставаПоказателей 	= Параметры.МакетСоставаПоказателей;
	мТаблицаСоставПоказателей 	= Параметры.мТаблицаСоставПоказателей;
	УникальныйИдентификатор 	= Параметры.УникальныйИдентификатор;
	
	ЦветЗаполняетсяТолькоВручную     = Новый Цвет(255, 255, 225);
	ЦветЗаполняетсяАвтоКорректир     = Новый Цвет(255, 240, 200);
	ЦветЗаполняетсяАвтоБезКорректир  = Новый Цвет(230, 240, 220);
	ЦветЗаполняетсяАвтоАрифметика    = Новый Цвет(192, 220, 192);  // ЗЕЛЕНЫЙ
	ЦветЗаполняетсяОднозначноВручную = Новый Цвет(255, 255, 192);  // ЖЕЛТЫЙ
	ЦветЗаполняетсяАвтоматически     = Новый Цвет(255, 255, 255);  // Белый, Ввод запрещен
	
	// структура цветов раскраски автозаполняемых ячеек
	мСтруктураЦветовРаскраски = Новый Структура;
	мСтруктураЦветовРаскраски.Вставить("_1", ЦветЗаполняетсяТолькоВручную);
	мСтруктураЦветовРаскраски.Вставить("_2", ЦветЗаполняетсяАвтоКорректир);
	мСтруктураЦветовРаскраски.Вставить("_3", ЦветЗаполняетсяАвтоБезКорректир);
	мСтруктураЦветовРаскраски.Вставить("_4", ЦветЗаполняетсяАвтоАрифметика);
	мСтруктураЦветовРаскраски.Вставить("_0", ЦветЗаполняетсяОднозначноВручную);
	мСтруктураЦветовРаскраски.Вставить("_5", ЦветЗаполняетсяАвтоматически);
	
	мСтруктураВариантыЗаполнения = Новый Структура;
	
	КонсолидированнаяОтчетность.ЗаполнитьСоставПоказателейПоМакету(МакетСоставаПоказателей, мТаблицаСоставПоказателей, мСтруктураВариантыЗаполнения);
	
	ОписаниеТиповСтрока15  = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(15, ДопустимаяДлина.Переменная));
	ОписаниеТиповСтрока100 = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100, ДопустимаяДлина.Переменная));
	ОписаниеТиповЧисло1    = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1));
	ОписаниеТиповЧисло15   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
	
	мТаблицаВариантыЗаполнения = Новый ТаблицаЗначений;
	мТаблицаВариантыЗаполнения.Колонки.Добавить("КодПоказателя",     ОписаниеТиповСтрока100);
	мТаблицаВариантыЗаполнения.Колонки.Добавить("ВариантЗаполнения", ОписаниеТиповЧисло1);
	мТаблицаВариантыЗаполнения.Колонки.Добавить("ЗначениеАвто",      ОписаниеТиповЧисло15);
	мТаблицаВариантыЗаполнения.Колонки.Добавить("Дельта",            ОписаниеТиповЧисло15);
	мТаблицаВариантыЗаполнения.Колонки.Добавить("Комментарий",       ОписаниеТиповСтрока100);
	
	Параметры.Адрес_мСтруктураЦветовРаскраски     	= ПоместитьВоВременноеХранилище(мСтруктураЦветовРаскраски, УникальныйИдентификатор);
	Параметры.Адрес_мСтруктураВариантыЗаполнения	= ПоместитьВоВременноеХранилище(мСтруктураВариантыЗаполнения, УникальныйИдентификатор);
	Параметры.Адрес_мТаблицаВариантыЗаполнения    	= ПоместитьВоВременноеХранилище(мТаблицаВариантыЗаполнения, УникальныйИдентификатор);
	
	Если Параметры.Свойство("Адрес_ТаблицаРасшифровки") Тогда
	
		ТаблицаРасшифровки = КонсолидированнаяОтчетность.СоздатьТаблицуРасшифровки();
		Параметры.Адрес_ТаблицаРасшифровки 				= ПоместитьВоВременноеХранилище(ТаблицаРасшифровки, УникальныйИдентификатор);
	    	
	КонецЕсли; 
	
	Если Параметры.Свойство("Адрес_мТаблицаСчетов") Тогда
	
		мТаблицаСчетов = Новый ТаблицаЗначений;
		мТаблицаСчетов.Колонки.Добавить("ИмяЯчейки");
		мТаблицаСчетов.Колонки.Добавить("ИмяПоказателя");
		мТаблицаСчетов.Колонки.Добавить("Счет");
		мТаблицаСчетов.Колонки.Добавить("ЗнакОперации");
		мТаблицаСчетов.Колонки.Добавить("ИмяСлагаемого");
		мТаблицаСчетов.Колонки.Добавить("ТекстРасшифровки");
		мТаблицаСчетов.Колонки.Добавить("ИмяРеквизитаСуммы");
		мТаблицаСчетов.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
		
		Параметры.Адрес_мТаблицаСчетов 					= ПоместитьВоВременноеХранилище(мТаблицаСчетов, УникальныйИдентификатор);
	
	КонецЕсли; 
		
КонецПроцедуры

Процедура УстановитьФорматВывода(СтруктураРеквизитовФормы, мТаблицаСоставПоказателей, Форма) Экспорт
	
	Если СтруктураРеквизитовФормы.ЕдиницаИзмерения = ПредопределенноеЗначение("Перечисление.ПорядкиОкругленияОтчетности.Окр1") Тогда
		СтруктураРеквизитовФормы.мДелитель = 1;
		мСтрокаФормата = "ЧЦ = 15; ЧДЦ = " + СтруктураРеквизитовФормы.ТочностьЕдиницыИзмерения + "; ЧРД=,; ЧН=-; ЧС = 0; ЧО=0";
	ИначеЕсли СтруктураРеквизитовФормы.ЕдиницаИзмерения = ПредопределенноеЗначение("Перечисление.ПорядкиОкругленияОтчетности.Окр1000") Тогда
		СтруктураРеквизитовФормы.мДелитель = 1000;
		мСтрокаФормата = "ЧЦ = 15; ЧДЦ = " + СтруктураРеквизитовФормы.ТочностьЕдиницыИзмерения + "; ЧРД=,; ЧН=-; ЧС = 3; ЧО=0";
	ИначеЕсли СтруктураРеквизитовФормы.ЕдиницаИзмерения = ПредопределенноеЗначение("Перечисление.ПорядкиОкругленияОтчетности.Окр1000000") Тогда
		СтруктураРеквизитовФормы.мДелитель = 1000000;
		мСтрокаФормата = "ЧЦ = 15; ЧДЦ = " + СтруктураРеквизитовФормы.ТочностьЕдиницыИзмерения + "; ЧРД=,; ЧН=-; ЧС = 6; ЧО=0";
	КонецЕсли;
	
	Для Каждого СтрПоказатели Из мТаблицаСоставПоказателей Цикл  
				
		ИмяТаблДокумента = СокрП(СтрПоказатели.ИмяПоляТаблДокумента);
		КодПоказателя    = СокрП(СтрПоказатели.КодПоказателяПоСоставу);
		
		Если КодПоказателя = "===" Тогда
			Прервать;
		КонецЕсли;
		
		Если (Лев(КодПоказателя, 2) = "//") ИЛИ (КодПоказателя = "###") Тогда
			Продолжить;
		КонецЕсли;
		
		КодПоказателяВФорме = СокрП(СтрПоказатели.КодПоказателяПоФорме);
		
		ИмяПоказателя = КодПоказателя;
		Если Не ПустаяСтрока(КодПоказателяВФорме) Тогда
			ИмяПоказателя = КодПоказателяВФорме;
		КонецЕсли;
		
		ТипДанныхПоказателя = СокрП(СтрПоказатели.ТипДанныхПоказателя);
		
		Если ТипДанныхПоказателя = "Е" Тогда
			
			Попытка
				ТекТабличныйДокумент = НайтиТабличныйДокументРаздела(Форма.РазделыОтчета, ИмяТаблДокумента);
				ФорматируемаяОбласть = ТекТабличныйДокумент.Области[ИмяПоказателя];
				
				ФорматируемаяОбласть.Формат = мСтрокаФормата;
			Исключение
				
				ТекстСообщения = СтрШаблон(
				НСтр("ru = 'Не найдена ячейка %1 в разделе %2'"),
				ИмяПоказателя,
				ИмяТаблДокумента);
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьЦветФонаЯчейки(Форма, ИмяТекущейСтраницыПанели = "", ТекРаздел = Неопределено) Экспорт
	Перем ЦветФона;
	
	мСтруктураЦветовРаскраски = ПолучитьИзВременногоХранилища(Форма.Адрес_мСтруктураЦветовРаскраски);
	
	// устанавливаем цвет фона всех автозаполняемых ячеек активной страницы
	ТаблицаВариантыЗаполнения = ПолучитьТаблицуВариантовЗаполнения(ИмяТекущейСтраницыПанели, Форма.Адрес_мСтруктураВариантыЗаполнения);
	Если ТаблицаВариантыЗаполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РазделыСРучнойКорректировкой = Форма.РазделыОтчета.НайтиСтроки(Новый Структура("ИмяРаздела, РучнаяКорректировка", ИмяТекущейСтраницыПанели, Истина));//ПолучитьИзВременногоХранилища(Форма.Адрес_РазделыСРучнойКорректировкой);
	
	Для Каждого Строка Из ТаблицаВариантыЗаполнения Цикл
		
		ИмяПоказателя     = Строка.КодПоказателя;
		ВариантЗаполнения = Строка.ВариантЗаполнения;
		Комментарий       = Строка.Комментарий;
		
		Попытка
			Если ТекРаздел = Неопределено Тогда
				ТекОбластьЯчеек = НайтиТабличныйДокументРаздела(Форма.РазделыОтчета, ИмяТекущейСтраницыПанели).Области[ИмяПоказателя];
			Иначе
				ТекОбластьЯчеек = ТекРаздел.Области[ИмяПоказателя];
			КонецЕсли;
		Исключение
			ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Не найдена ячейка %1 в разделе %2'"),
			ИмяПоказателя,
			ИмяТекущейСтраницыПанели);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			Продолжить;
		КонецПопытки;
		
		Если (Не ПустаяСтрока(Комментарий)) ИЛИ (Не ПустаяСтрока(ТекОбластьЯчеек.Примечание.Текст)) Тогда
			ТекОбластьЯчеек.Примечание.Текст = Комментарий;
		КонецЕсли;
		
		Ключ = "_" + ВариантЗаполнения;
		мСтруктураЦветовРаскраски.Свойство(Ключ, ЦветФона);
		
		Если ВариантЗаполнения = 3 Тогда
			Если РазделыСРучнойКорректировкой.Количество() > 0 Тогда
				ТекОбластьЯчеек.Защита = Ложь;
				мСтруктураЦветовРаскраски.Свойство("_0", ЦветФона);
				ТекОбластьЯчеек.Расшифровка = Неопределено;
			Иначе
				ТекОбластьЯчеек.Защита = Истина;
				ТекОбластьЯчеек.Расшифровка = "";
			КонецЕсли;
		КонецЕсли;
		
		ТекОбластьЯчеек.ЦветФона = ЦветФона;
		
	КонецЦикла;
	
КонецПроцедуры
 
Функция ПолучитьТаблицуВариантовЗаполнения(ИмяСтраницыПанели, Адрес_мСтруктураВариантыЗаполнения)
	
	Перем МассивВариантовЗаполненияСтраниц;
	Перем ТаблицаВариантыЗаполнения;
	
	мСтруктураВариантыЗаполнения = ПолучитьИзВременногоХранилища(Адрес_мСтруктураВариантыЗаполнения);
	
	Если мСтруктураВариантыЗаполнения.Свойство(ИмяСтраницыПанели, МассивВариантовЗаполненияСтраниц) Тогда
		// получим варианты заполнения ячеек, заданные для активной страницы
		ТаблицаВариантыЗаполнения = МассивВариантовЗаполненияСтраниц[0];
	КонецЕсли;
	
	Возврат ТаблицаВариантыЗаполнения;
	
КонецФункции

Процедура ЗаписатьОтчет(Форма) Экспорт

	Если Форма.СтруктураРеквизитовФормы.мСохраненныйДок = Неопределено Тогда
	
		мСохраненныйДок = Документы.РегламентированныйОтчет.СоздатьДокумент();
		мСохраненныйДок.Дата = Форма.СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета;
		мСохраненныйДок.УстановитьВремя();
				
	Иначе
		
		мСохраненныйДок = Форма.СтруктураРеквизитовФормы.мСохраненныйДок.ПолучитьОбъект();
	
	КонецЕсли; 
	
	ЗаполнитьЗначенияСвойств(мСохраненныйДок, Форма.СтруктураРеквизитовФормы);
	
	Если Форма.СтруктураРеквизитовФормы.мСохраненныйДок = Неопределено Тогда
		мСохраненныйДок.УстановитьНовыйНомер();
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(мСохраненныйДок.ВидУчета) Тогда
		мСохраненныйДок.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
	КонецЕсли; 
	
	СтруктураНаименованийОтчета = ПолучитьСтруктуруНаименованийОтчета(Форма.ИмяФормы);
	
	мСохраненныйДок.ДатаНачала 			= Форма.СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета;
	мСохраненныйДок.ДатаОкончания 		= Форма.СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета;
	мСохраненныйДок.Комментарий 		= Форма.Комментарий;
	мСохраненныйДок.СтатусОтчета 		= Форма.СтатусОтчета;
	мСохраненныйДок.НомерКорректировки 	= Форма.НомерКорректировки;
	мСохраненныйДок.Ответственный 		= РаботаСПользователями.ТекущийПользователь();;
	мСохраненныйДок.НаименованиеОтчета 	= СтруктураНаименованийОтчета.НаименованиеОтчета;
	мСохраненныйДок.ИсточникОтчета 		= СтруктураНаименованийОтчета.ИсточникОтчета;
	мСохраненныйДок.ВыбраннаяФорма 		= Форма.СтруктураРеквизитовФормы.мВыбраннаяФорма;
	мСохраненныйДок.РедакцияФормы		= Форма.СтруктураРеквизитовФормы.мРедакцияФормы;
	мСохраненныйДок.НестандартныйПериод	= Форма.СтруктураРеквизитовФормы.НестандартныйПериод;
	
	ДанныеОтчета = Новый Структура;
	
	СтрокиСРучнойКорректировкой = Форма.РазделыОтчета.НайтиСтроки(Новый Структура("РучнаяКорректировка", Истина));
	РазделыСРучнойКорректировкой = Новый Массив;
	Для каждого Строка Из СтрокиСРучнойКорректировкой Цикл
		РазделыСРучнойКорректировкой.Добавить(Строка.ИмяРаздела);
	КонецЦикла; 
	
	ДанныеОтчета.Вставить("ПоказателиОтчета", Форма.Показатели.Выгрузить());
	ДанныеОтчета.Вставить("РазделыСРучнойКорректировкой", РазделыСРучнойКорректировкой);
	ДанныеОтчета.Вставить("Подписант", Форма.Подписант);
	
	Попытка
		ДанныеОтчета.Вставить("Расшифровка", ПолучитьИзВременногоХранилища(Форма.Адрес_ТаблицаРасшифровки));
	Исключение
	КонецПопытки; 
	
	Если Форма.СтруктураРеквизитовФормы.Свойство("ВидДеятельностиОрганизации") Тогда
	
		ДанныеОтчета.Вставить("ВидДеятельностиОрганизации", Форма.СтруктураРеквизитовФормы.ВидДеятельностиОрганизации);
	
	КонецЕсли;	
	
	Если Форма.СтруктураРеквизитовФормы.Свойство("НКО") Тогда
	
		ДанныеОтчета.Вставить("НКО", Форма.СтруктураРеквизитовФормы.НКО);
	
	КонецЕсли; 
	
	Если Не Форма.РазделыОтчета.Выгрузить().Колонки.Найти("МногострочныйРаздел") = Неопределено Тогда
	
		Для каждого ТекСтрока Из Форма.РазделыОтчета Цикл
		
			Если ТекСтрока.МногострочныйРаздел Тогда
			
				ДанныеОтчета.Вставить(ТекСтрока.ИмяРаздела, Форма[ТекСтрока.ИмяРаздела].Выгрузить());
			
			КонецЕсли; 
		
		КонецЦикла; 
	
	КонецЕсли; 
	
	мСохраненныйДок.ДанныеОтчета = Новый ХранилищеЗначения(ДанныеОтчета, Новый СжатиеДанных(9));
	
	Попытка
		мСохраненныйДок.Записать();
		Форма.СтруктураРеквизитовФормы.мСохраненныйДок = мСохраненныйДок.Ссылка;
	Исключение
		// будет выдано сообщение фунцией ЕстьДокументыЗаТотЖеПериод()
	КонецПопытки	

КонецПроцедуры
 
Функция НайтиТабличныйДокументРаздела(РазделыОтчета, ИмяРаздела) Экспорт
	
	СтруктураОтбора = Новый Структура("ИмяРаздела", ИмяРаздела);
	ТабличныйДокумент = РазделыОтчета.НайтиСтроки(СтруктураОтбора)[0].ТабличныйДокумент;
	Возврат ТабличныйДокумент;

КонецФункции

Функция ЗаполнитьТабличныйДокументИзМакета(ЭтаФорма, ТекСтрока, ИмяМакета, ТаблицаИзменяемыхОбластей = Неопределено) Экспорт

	ИмяОтчета = ПолучитьСтруктуруНаименованийОтчета(ЭтаФорма.ИмяФормы).ИсточникОтчета;
	
	Макет = Отчеты[ИмяОтчета].ПолучитьМакет(ИмяМакета);
			
	ТабДок = Новый ТабличныйДокумент;
	
	Если ЭтаФорма.ИмяФормы = "Отчет.РегламентированныйОтчетБалансРСБУ.Форма.ФормаОтчета_07100001"
		ИЛИ ЭтаФорма.ИмяФормы = "Отчет.РегламентированныйОтчетБалансРСБУ.Форма.ФормаОтчета_07100001_2025"
		ИЛИ ЭтаФорма.ИмяФормы = "Отчет.РегламентированныйОтчетБалансРСБУ.Форма.ФормаОтчета_07100001_2025СРасшифровкой" Тогда	
						
		Если ЭтаФорма.СтруктураРеквизитовФормы.ВыводитьНомерПриказа Тогда
         //   от_04_10_2023_157н_(с_расшифровкой)
			ИмяРедакцииФормы = СтрЗаменить(ЭтаФорма.Параметры.мРедакцияФормы, " (с расшифровкой)","");
			ИмяРедакцииФормы = СтрЗаменить(ИмяРедакцииФормы," ","_");
			ИмяРедакцииФормы = СтрЗаменить(ИмяРедакцииФормы,".","_");
			ИмяРедакцииФормы = СтрЗаменить(ИмяРедакцииФормы,"№","");
			
			Область = Макет.ПолучитьОбласть("НаименованиеПриказа_"+ИмяРедакцииФормы);
			
			ТабДок.Вывести(Область);
			
		КонецЕсли;
		
		Область = Макет.ПолучитьОбласть("Баланс_Шапка");
		Если ЭтаФорма.Параметры.мРедакцияФормы = "от 06.03.2018 №41н" Тогда
			Область.Параметры.НомерОКВЭД = "";
		Иначе
			Область.Параметры.НомерОКВЭД = "2";
		КонецЕсли;
		
		ТабДок.Вывести(Область);

		Если ЭтаФорма.Параметры.мРедакцияФормы = "от 19.04.2019 №61н" Тогда
			
			Область = Макет.ПолучитьОбласть("СведенияОбАудиторе_19_04_2019_61н");
			
			ТабДок.Вывести(Область);
			
		КонецЕсли;
		
		Область = Макет.ПолучитьОбласть("Баланс_ОсновнаяЧасть");
		ТабДок.Вывести(Область);
		
		Макет = ПолучитьОбщийМакет("ОбщиеОбластиСтандартногоОтчета");   
		Если ЭтаФорма.ИмяФормы = "Отчет.РегламентированныйОтчетБалансРСБУ.Форма.ФормаОтчета_07100001_2025"
			ИЛИ ЭтаФорма.ИмяФормы = "Отчет.РегламентированныйОтчетБалансРСБУ.Форма.ФормаОтчета_07100001_2025СРасшифровкой" Тогда
			ОбластьПодписи = Макет.ПолучитьОбласть("ПодписиБухгалтерскихОтчетовРСБУ");
		Иначе	
			ОбластьПодписи = Макет.ПолучитьОбласть("ПодписиБухгалтерскихОтчетовЕПС");
		КонецЕсли;
		ТабДок.Вывести(ОбластьПодписи);
		
	ИначеЕсли  ЭтаФорма.ИмяФормы = "Отчет.РегламентированныйОтчетОФинансовыхРезультатахРСБУ.Форма.ФормаОтчета_07100002_2025" 
		И ИмяМакета <> "ОФРРСБУ_МакетРасшифровка" Тогда
		
		
		Если ЭтаФорма.СтруктураРеквизитовФормы.ВыводитьНомерПриказа Тогда
			
			ИмяРедакцииФормы = СтрЗаменить(ЭтаФорма.Параметры.мРедакцияФормы," ","_");
			ИмяРедакцииФормы = СтрЗаменить(ИмяРедакцииФормы,".","_");
			ИмяРедакцииФормы = СтрЗаменить(ИмяРедакцииФормы,"№","");
			
			Область = Макет.ПолучитьОбласть("НаименованиеПриказа_"+ИмяРедакцииФормы);
			
			ТабДок.Вывести(Область);
			
		КонецЕсли;
		
		Область = Макет.ПолучитьОбласть("ОФР_Шапка");
		Область.Параметры.НомерОКВЭД = "2";
		ТабДок.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("ОФР_ОсновнаяЧасть");
		ТабДок.Вывести(Область);
		
		Макет = ПолучитьОбщийМакет("ОбщиеОбластиСтандартногоОтчета");
		ОбластьПодписи = Макет.ПолучитьОбласть("ПодписиБухгалтерскихОтчетовРСБУ");
		ТабДок.Вывести(ОбластьПодписи);
		
	Иначе	
		
		Область = Макет.ПолучитьОбласть();
		
		ТабДок.Вывести(Область);
		
		Если СтрНачинаетсяС(ТекСтрока.ИмяРаздела, "ОтчетТитульнаяСтраница") Тогда
			
			Макет = ПолучитьОбщийМакет("ОбщиеОбластиСтандартногоОтчета");
			ОбластьПодписи = Макет.ПолучитьОбласть("ПодписиБухгалтерскихОтчетовЕПС");
			ТабДок.Вывести(ОбластьПодписи);
			
		Иначе
			
			МакетШапка   = ПолучитьОбщийМакет("ОбщиеОбластиСтандартногоОтчета");
			ОбластьШапка = МакетШапка.ПолучитьОбласть("ШапкаБухгалтерскихОтчетовЕПС");
			ПараметрыШапки = ПолучитьПараметрыШапки(ЭтаФорма.СтруктураРеквизитовФормы);
			
			Если ЗначениеЗаполнено(ПараметрыШапки) Тогда
				
				ОбластьШапка.Параметры.Заполнить(ПараметрыШапки);
				ОбластьШапка.Параметры.ДатаДоговора = Формат(ПараметрыШапки.ДатаДоговора, "ДФ=dd.MM.yyyy");
				ОбластьШапка.Параметры.ДатаОтчета = Формат(ПараметрыШапки.ДатаОтчета, "ДФ=dd.MM.yyyy");
				
			КонецЕсли;
			
			ОбластьТаблица = ТабДок.НайтиТекст("Таблица ");
			ШиринаТаблицы = ?(ОбластьТаблица = Неопределено, ТабДок.ШиринаТаблицы, ОбластьТаблица.Лево);
			
			Для НомерСтроки = 1 По 4 Цикл
				
				Область = ОбластьШапка.Область(НомерСтроки, 1, НомерСтроки, ШиринаТаблицы);
				Область.Объединить();
				
			КонецЦикла;
			
			ТабДок.ВставитьОбласть(ОбластьШапка.Область(1, , 4, ), ТабДок.Область(1, , 4, ), ТипСмещенияТабличногоДокумента.ПоВертикали, Истина);
			
			Если ИмяМакета = "ОФРРСБУ_МакетРасшифровка" Тогда
				// ОФР РСБУ - подписант будет не только на титульном листе, но и на расшифровке
				
				Макет = ПолучитьОбщийМакет("ОбщиеОбластиСтандартногоОтчета");
				ОбластьПодписи = Макет.ПолучитьОбласть("ПодписиБухгалтерскихОтчетовРСБУ");
				ТабДок.Вывести(ОбластьПодписи);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
		
	// изменяемые области
	Если ТаблицаИзменяемыхОбластей <> Неопределено Тогда 
		ГодФормирования = Год(ЭтаФорма.СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета);
		
		Для Каждого СтрокаТаблицы из ТаблицаИзменяемыхОбластей Цикл 
			Если СтрНайти(СтрокаТаблицы.ИмяМакета, ИмяМакета) = 0 Тогда 
				Продолжить;
			Иначе	
				Область = ТабДок.Области.Найти(СтрокаТаблицы.ИмяОбласти);
				Если Область <> Неопределено Тогда   
					Если ПустаяСтрока(СтрокаТаблицы.ГодНачалаДействия) Тогда 
						Область.Текст = СтрокаТаблицы.СодержимоеОбласти;		
					ИначеЕсли ГодФормирования >= Число(СтрокаТаблицы.ГодНачалаДействия) Тогда 
						Область.Текст = СтрокаТаблицы.СодержимоеОбласти;	
					КонецЕсли;
				Иначе 
					ВызватьИсключение("Область '" + СтрокаТаблицы.ИмяОбласти + "' не задана в макете " + ИмяМакета);	
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
	ТекСтрока.ТабличныйДокумент = ТабДок;
	УстановитьЦветФонаЯчейки(ЭтаФорма, ТекСтрока.ИмяРаздела, ТекСтрока.ТабличныйДокумент);	

КонецФункции
 
Функция ПолучитьСтруктуруНаименованийОтчета(ИмяФормы) Экспорт

	МетаданныеОтчета = Метаданные.Отчеты[Сред(Лев(ИмяФормы, СтрНайти(ИмяФормы, ".Форма.") - 1), 7)];
	Возврат Новый Структура("НаименованиеОтчета, ИсточникОтчета", МетаданныеОтчета.Синоним, МетаданныеОтчета.Имя);

КонецФункции
 
Процедура ПриЗакрытииРегламентированногоОтчета(Форма) Экспорт
		
	Если Форма.СтруктураРеквизитовФормы.мСохраненныйДок <> Неопределено И Форма.СтруктураРеквизитовФормы.мСохраненныйДок <> КонсолидированнаяОтчетностьКлиентСервер.ПустоеЗначениеТипа(ТипЗнч(Форма.СтруктураРеквизитовФормы.мСохраненныйДок)) И Форма.СтруктураРеквизитовФормы.мСохраненныйДок.ПолучитьОбъект().Заблокирован() Тогда
		Форма.СтруктураРеквизитовФормы.мСохраненныйДок.ПолучитьОбъект().Разблокировать();
	КонецЕсли;
	
	Если Форма.СтруктураРеквизитовФормы.мСохраненныйДок <> Неопределено
	   И Форма.СтруктураРеквизитовФормы.мСохраненныйДок <> КонсолидированнаяОтчетностьКлиентСервер.ПустоеЗначениеТипа(ТипЗнч(Форма.СтруктураРеквизитовФормы.мСохраненныйДок)) Тогда
	
		РазблокироватьДанныеДляРедактирования(Форма.СтруктураРеквизитовФормы.мСохраненныйДок, Форма.УникальныйИдентификатор);
		
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьОтчетНаКонецПредыдущегоПериода(СтруктураРеквизитовФормы, ИсточникОтчета, ПозапрошлыйПериод = Ложь, СтараяРедакцияФормы = "", ОтчетЗаАналогичныйПериод = Ложь) Экспорт

	Если ИсточникОтчета = "РегламентированныйОтчетОПотокахДенежныхСредствНПФ" Тогда
	
		Возврат Неопределено;
		
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	РегламентированныйОтчет.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РегламентированныйОтчет КАК РегламентированныйОтчет
	|ГДЕ
	|	НЕ РегламентированныйОтчет.ПометкаУдаления
	|	И РегламентированныйОтчет.Организация = &Организация
	|	И РегламентированныйОтчет.СчетДоверительногоУправления = &СчетДоверительногоУправления
	|	И РегламентированныйОтчет.ДатаНачала = &ДатаНачала
	|	И РегламентированныйОтчет.ДатаОкончания = &ДатаОкончания
	|	И РегламентированныйОтчет.ВалютаДокумента = &ВалютаДокумента
	|	И РегламентированныйОтчет.ВыбраннаяФорма = &ВыбраннаяФорма
	|	И РегламентированныйОтчет.ИсточникОтчета = &ИсточникОтчета
	|	И РегламентированныйОтчет.ОтчетЗаПоследнийКвартал = &ОтчетЗаПоследнийКвартал
	|	И НЕ РегламентированныйОтчет.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	РегламентированныйОтчет.НомерКорректировки УБЫВ";
	
	ОтчетЗаПоследнийКвартал = ?(СтруктураРеквизитовФормы.Свойство("ОтчетЗаПоследнийКвартал"), СтруктураРеквизитовФормы.ОтчетЗаПоследнийКвартал, Ложь);
	НестандартныйПериод = ?(СтруктураРеквизитовФормы.Свойство("НестандартныйПериод"), СтруктураРеквизитовФормы.НестандартныйПериод, Ложь);  
	
	Запрос.УстановитьПараметр("Организация", 					СтруктураРеквизитовФормы.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	СтруктураРеквизитовФормы.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВалютаДокумента", 				СтруктураРеквизитовФормы.ВалютаДокумента);
	Запрос.УстановитьПараметр("ВыбраннаяФорма", 				?(ЗначениеЗаполнено(СтараяРедакцияФормы), СтараяРедакцияФормы, СтруктураРеквизитовФормы.мВыбраннаяФорма));
	Запрос.УстановитьПараметр("ОтчетЗаПоследнийКвартал", 		ОтчетЗаПоследнийКвартал);
	Запрос.УстановитьПараметр("ИсточникОтчета", 				ИсточникОтчета);
	
	Если ИсточникОтчета = "РегламентированныйОтчетОФинансовыхРезультатах" Тогда
		
		// берем отчет за аналогичный период прошлого года
		Запрос.УстановитьПараметр("ДатаНачала", 					НачалоДня(ДобавитьМесяц(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета, -12)));
		Если НестандартныйПериод Тогда 
			Запрос.УстановитьПараметр("ДатаОкончания", 					НачалоДня(ДобавитьМесяц(КонецКвартала(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета), -12)));
		Иначе	
			Запрос.УстановитьПараметр("ДатаОкончания", 					НачалоДня(ДобавитьМесяц(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета, -12)));
		КонецЕсли;	
	Иначе
		
		Если НЕ ОтчетЗаАналогичныйПериод Тогда
			// для баланса и 1-ФС берем отчет за прошлый год
			Запрос.УстановитьПараметр("ДатаНачала", 					НачалоГода(ДобавитьМесяц(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета, -12-?(ПозапрошлыйПериод,12,0))));
			Запрос.УстановитьПараметр("ДатаОкончания", 					НачалоДня(КонецГода(ДобавитьМесяц(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета, -12-?(ПозапрошлыйПериод,12,0)))));  
		Иначе
			
			// для Баланса МСФО 9 2025
			Запрос.УстановитьПараметр("ДатаНачала", 					НачалоДня(ДобавитьМесяц(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета, -12)));
			Запрос.УстановитьПараметр("ДатаОкончания", 					НачалоДня(ДобавитьМесяц(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета, -12)));
			// что будет при реформации и не стандартном периоде отчета? 
			//  мб как в ОФР. 
			
		КонецЕсли;
	
	КонецЕсли; 
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли; 
	
КонецФункции

Функция ПолучитьПредыдущуюФорму(ИсточникОтчета, СтруктураРеквизитовФормы, ПозапрошлыйГод = Ложь) Экспорт
	
	Результат = "";
	
	Макет = ПолучитьОбщийМакет("ПреемственностьФормРегламентированныхОтчетов");	
	
	ОбластьЗаголовки = Макет.ПолучитьОбласть("Заголовок|Колонки");
	ОбластьДанные = Макет.ПолучитьОбласть("Данные|Колонки");
	
	ТаблицаПреемственности = Новый ТаблицаЗначений;
	
	КоличествоКолонок = ОбластьЗаголовки.ШиринаТаблицы;
	КоличествоСтрок = ОбластьДанные.ВысотаТаблицы;
	
	Для инд = 1 по КоличествоКолонок Цикл 
		ТаблицаПреемственности.Колонки.Добавить(ОбластьЗаголовки.ПолучитьОбласть(1, инд).ТекущаяОбласть.Текст);
	КонецЦикла;	
	
	Для индСтроки = 1 по КоличествоСтрок Цикл 
		НоваяСтрока = ТаблицаПреемственности.Добавить();
		Для индКолонки = 1 по КоличествоКолонок Цикл 
			НоваяСтрока[ИндКолонки-1] = ОбластьДанные.ПолучитьОбласть(индСтроки, индКолонки).ТекущаяОбласть.Текст;		
		КонецЦикла;	
	КонецЦикла;	
	
	ПараметрыПоиска = Новый Структура();
	ПараметрыПоиска.Вставить("Источник", ИсточникОтчета);
	ПараметрыПоиска.Вставить("ИмяФормы", СтруктураРеквизитовФормы.мВыбраннаяФорма); 

	ГодНачалаДействия = Год(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета);

	Если ПозапрошлыйГод Тогда  //это только для Баланса РСБУ
		ГодНачалаДействияПГ = ГодНачалаДействия - 1;		
		ПараметрыПоиска.Вставить("ГодНачалаДействия", Формат(ГодНачалаДействияПГ,"ЧГ=0")); 
		
		НайденыеСтроки = ТаблицаПреемственности.НайтиСтроки(ПараметрыПоиска);
		Если НайденыеСтроки.Количество() = 1 Тогда 
			Результат = НайденыеСтроки[0].СтараяРедакция;
		КонецЕсли;			
	КонецЕсли;    
	
	Если ПустаяСтрока(Результат) Тогда // если за позапрошлый год не нашли, значит за позапрошлый год будет таже форма, что и за прошлый 
		ПараметрыПоиска.Вставить("ГодНачалаДействия", Формат(ГодНачалаДействия,"ЧГ=0")); 	
		
		НайденыеСтроки = ТаблицаПреемственности.НайтиСтроки(ПараметрыПоиска);
		Если НайденыеСтроки.Количество() = 1 Тогда 
			Результат = НайденыеСтроки[0].СтараяРедакция;
		КонецЕсли;	
	КонецЕсли;

	Возврат Результат;	
		
КонецФункции 

Функция ПолучитьТаблицуИзменяемыхОбластей(ИмяСекции) Экспорт

	Макет = ПолучитьОбщийМакет("ПереопределяемыеИменаРазделовРегламентированнойОтчетности");	
	
	Если Макет.Области.Найти(ИмяСекции) = Неопределено Тогда 
		Возврат Неопределено;
	КонецЕсли;	
	
	ОбластьЗаголовки = Макет.ПолучитьОбласть("Заголовок|Колонки");
	ОбластьДанные = Макет.ПолучитьОбласть(ИмяСекции + "|Колонки");   
	
	ТаблицаИзменяемыхОбластей = Новый ТаблицаЗначений;
	
	КоличествоКолонок = ОбластьЗаголовки.ШиринаТаблицы;
	КоличествоСтрок = ОбластьДанные.ВысотаТаблицы;
	
	Для инд = 1 по КоличествоКолонок Цикл 
		ТаблицаИзменяемыхОбластей.Колонки.Добавить(ОбластьЗаголовки.ПолучитьОбласть(1, инд).ТекущаяОбласть.Текст);
	КонецЦикла;	
	
	Для индСтроки = 1 по КоличествоСтрок Цикл 
		НоваяСтрока = ТаблицаИзменяемыхОбластей.Добавить();
		Для индКолонки = 1 по КоличествоКолонок Цикл 
			НоваяСтрока[ИндКолонки-1] = ОбластьДанные.ПолучитьОбласть(индСтроки, индКолонки).ТекущаяОбласть.Текст;		
		КонецЦикла;	
	КонецЦикла;	
	
	Возврат ТаблицаИзменяемыхОбластей;
	
КонецФункции 

Процедура УдалитьРасшифровкуЯчейки(Адрес_ТаблицаРасшифровки, ИмяРаздела, ИмяЯчейки) Экспорт
	
	ТаблицаРасшифровки = ПолучитьИзВременногоХранилища(Адрес_ТаблицаРасшифровки);
	
	Отбор = Новый Структура("Раздел, ИмяЯчейки", ИмяРаздела, ИмяЯчейки);
	НайденныеСтроки = ТаблицаРасшифровки.НайтиСтроки(Отбор);
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		ТаблицаРасшифровки.Удалить(НайденнаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

Процедура СкопироватьЗначениеЯчейки(СтруктураРеквизитовФормы, Форма, Адрес_ТаблицаРасшифровки, ИмяРазделаРезультат, РазделРезультат, ИмяЯчейкиРезультат, ИмяРазделаИсточник, ИмяЯчейкиИсточник, ВключаяРасшифровку = Истина) Экспорт
	
	// Определим ячейку-результат
	Попытка
		ЯчейкаРезультат = РазделРезультат.Области[ИмяЯчейкиРезультат];
	Исключение
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Расчет итогов по разделу %1: не найдена ячейка %2'"),
			ИмяРазделаРезультат,
			ИмяЯчейкиРезультат
		);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецПопытки;
		
	// Табличный документ-источник
	Если ТипЗнч(ИмяРазделаИсточник) = Тип("Строка") Тогда
		Попытка
			РазделОтчета = Форма.РазделыОтчета.НайтиСтроки(Новый Структура("ИмяРаздела", ИмяРазделаИсточник))[0];
			ТабИсточник = РазделОтчета.ТабличныйДокумент;
		Исключение
			ТекстСообщения = СтрШаблон(
				НСтр("ru = 'Расчет итогов по разделу %1: не найден раздел %2'"),
				ИмяРазделаРезультат,
				ИмяРазделаИсточник
			);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецПопытки;
	Иначе
		// Если передан табличный документ, значит заполнение идет с текущего раздела
		ТабИсточник = ИмяРазделаИсточник;
		РазделОтчета = Форма.РазделыОтчета.НайтиСтроки(Новый Структура("ИмяРаздела", ИмяРазделаРезультат))[0];
	КонецЕсли;
	СтраницаИсточник = РазделОтчета;
	
	// Определим ячейку-источник
	Попытка
		ЯчейкаИсточник = ТабИсточник.Области[ИмяЯчейкиИсточник];
	Исключение
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Расчет итогов по разделу %1: в разделе %2 не найдена ячейка %3'"),
			ИмяРазделаРезультат,
			ИмяРазделаИсточник,
			ИмяЯчейкиИсточник
		);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецПопытки;
	
	// Скопируем значение
	ЯчейкаРезультат.Значение = ЯчейкаИсточник.Значение;
		
	// Скопируем расшифровку
	КонсолидированнаяОтчетность.УдалитьРасшифровкуЯчейки(Адрес_ТаблицаРасшифровки, ИмяРазделаРезультат, ИмяЯчейкиРезультат);	
	Если ВключаяРасшифровку Тогда
		ТаблицаРасшифровки = ПолучитьИзВременногоХранилища(Адрес_ТаблицаРасшифровки);
		
		Отбор = Новый Структура("Раздел, ИмяЯчейки", СтраницаИсточник.ИмяРаздела, ИмяЯчейкиИсточник);
		НайденныеСтроки = ТаблицаРасшифровки.НайтиСтроки(Отбор);
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
						
			СтруктураПолей = Новый Структура("СчетДоверительногоУправления, ИмяЯчейки, ИмяПоказателя, ЗнакОперации, ИмяСлагаемого, Сумма, Счет, КорСчет, Сдвиг, ПраваяГраница, Раздел",
			СтруктураРеквизитовФормы.СчетДоверительногоУправления, ИмяЯчейкиРезультат, НайденнаяСтрока.ИмяПоказателя, НайденнаяСтрока.ЗнакОперации, НайденнаяСтрока.ИмяСлагаемого, НайденнаяСтрока.Сумма, НайденнаяСтрока.Счет, НайденнаяСтрока.КорСчет, , , ИмяРазделаРезультат);
	
			КонсолидированнаяОтчетность.ДобавитьСтрокуВРасшифровку(ТаблицаРасшифровки, СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета, СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета, СтруктураПолей);
						
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры // СкопироватьЗначениеЯчейки

Процедура СохранитьВариантНастроек(Форма, КлючОбъекта) Экспорт
		
	Настройки = Новый Структура;
	
	Настройки.Вставить("ИмяФормы", Форма.ИмяФормы);
	Настройки.Вставить("СохраняемыеРазделы", Форма.СохраняемыеРазделы);
	
	ХранилищаНастроек.ХранилищеВариантовИНастроекОтчетов.Сохранить(КлючОбъекта, Форма.КлючТекущихНастроек, Настройки);
	
КонецПроцедуры

Процедура ЗагрузитьВариантНастроек(Форма, КлючОбъекта) Экспорт
		
	Настройки = ХранилищаНастроек.ХранилищеВариантовИНастроекОтчетов.Загрузить(КлючОбъекта, Форма.КлючТекущихНастроек);
	
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбран неправильный вариант отчета!");
		Возврат;
	КонецЕсли;
	
	Если НЕ Настройки.Свойство("ИмяФормы") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбран неправильный вариант отчета!");
		Возврат;
	КонецЕсли;
	
	// #ТехническийДолг# - нужно сделать красиво 
	Если Настройки.ИмяФормы <> Форма.ИмяФормы
		И (СтрЗаменить(Настройки.ИмяФормы, КлючОбъекта + ".Форма.", "") <> Форма.ИмяФормы) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбран неправильный вариант отчета!");
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Форма, Настройки, "СохраняемыеРазделы");
	
КонецПроцедуры

#Область АвтоматическоеФормирование
// процедуры и функции перенесенны из модулей объектов регламентированных отчетов

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	// Проверка статуса документа.
	Если ТипЗнч(НастройкиОтчета) = Тип("Структура")
		И НастройкиОтчета.Свойство("РегламентированныйОтчет")
		И ЗначениеЗаполнено(НастройкиОтчета.РегламентированныйОтчет)
		И ТипЗнч(НастройкиОтчета.РегламентированныйОтчет) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
		ДокументОтчет = НастройкиОтчета.РегламентированныйОтчет;
	Иначе		
		ВызватьИсключение "Отсутствует сохраненный регламентированный отчет!";
	КонецЕсли;
	
	// Заполнение табличных документов данными из сохраненного документа.
	СтруктураПараметров =  ПолучитьСтруктуруПараметров(НастройкиОтчета);
	
	//Инициализация(СтруктураПараметров, НастройкиОтчета.КлючОтчета);
	
	СписокСохранения = СтруктураПараметров.мСохраненныйДок.ДанныеОтчета.Получить();
	Если СписокСохранения.Свойство("НКО") Тогда
		СтруктураПараметров.НКО = СписокСохранения.НКО;
	КонецЕсли;	
		
	Если СтруктураПараметров.Свойство("ВидДеятельностиОрганизации") Тогда
		СписокСохранения.Свойство("ВидДеятельностиОрганизации",	СтруктураПараметров.ВидДеятельностиОрганизации);
	КонецЕсли;
	
	СтруктураПараметров.Вставить("РазделыОтчета", СоздатьТаблицуРазделовУчета());
	
	ЗаполнитьНачальныеНастройкиАвтоматическоеФормирование(СтруктураПараметров, НастройкиОтчета.КлючОтчета);

	ЗаполнитьТабличныеДокументыИзМакетов(СтруктураПараметров, НастройкиОтчета.КлючОтчета);
	ВосстановитьСохраненныеДанные(СтруктураПараметров);
	
	ЭтаФорма = Новый Структура;
	ЭтаФорма.Вставить("РазделыОтчета", СтруктураПараметров.РазделыОтчета);
	
	УстановитьФорматВывода(СтруктураПараметров, СтруктураПараметров.мТаблицаСоставПоказателей, ЭтаФорма);
	
	//
	
	Если НастройкиОтчета.КлючОтчета = "РегламентированныйОтчетБаланс" 
		ИЛИ НастройкиОтчета.КлючОтчета = "РегламентированныйОтчетОФинансовыхРезультатах" Тогда                                                     
		ИмяФормыПредыдущегоГода = СтруктураПараметров.ОтчетНаКонецПрошлогоГода.ВыбраннаяФорма;
		СписокРазделовПредыдущегоГода = КонсолидированнаяОтчетность.ПолучитьСписокРазделовПредыдущегоГода(НастройкиОтчета.КлючОтчета, ИмяФормыПредыдущегоГода, СтруктураПараметров.НКО);  
	Иначе
		СписокРазделовПредыдущегоГода = Неопределено;
	КонецЕсли;
	
	//Список выгружаемых разделов этого и предыдущего года могут быть переопределены в сохраненном варианте отчета.
	СохраняемыеРазделы			= Неопределено;
	ВыводитьСопоставимыеДанные	= Истина;
	Если НастройкиОтчета.Свойство("ВыводитьСопоставимыеДанные")
		И ЗначениеЗаполнено(НастройкиОтчета.ВыводитьСопоставимыеДанные)
		И ТипЗнч(НастройкиОтчета.ВыводитьСопоставимыеДанные) = Тип("Булево") Тогда
	
		ВыводитьСопоставимыеДанные	= НастройкиОтчета.ВыводитьСопоставимыеДанные;
	
	КонецЕсли;
	
	Если НастройкиОтчета.Свойство("ВариантОтчета")
		И ЗначениеЗаполнено(НастройкиОтчета.ВариантОтчета)
		И ТипЗнч(НастройкиОтчета.ВариантОтчета) = Тип("УникальныйИдентификатор") Тогда
		
		Форма = Новый Структура;
		
		Форма.Вставить("КлючТекущихНастроек",			НастройкиОтчета.ВариантОтчета);
		Форма.Вставить("ИмяФормы",						СтруктураПараметров.мВыбраннаяФорма);
		Форма.Вставить("СохраняемыеРазделы",			СохраняемыеРазделы);
		
		ЗагрузитьВариантНастроек(Форма, "Отчет." + НастройкиОтчета.КлючОтчета);
		
		СохраняемыеРазделы			= Форма.СохраняемыеРазделы;
	
	КонецЕсли;
	
	// Упаковка в пакет отображаемых документов.   
	БезДанныхПоследнегоКвартала = Ложь;
	Если ДокументОтчет.ИсточникОтчета = "РегламентированныйОтчетОФинансовыхРезультатах"
		И (ДокументОтчет.ВыбраннаяФорма = "ФормаОтчета_МСФО9_2025" ИЛИ ДокументОтчет.ВыбраннаяФорма = "ФормаОтчета_МСФО9_СК_2025") Тогда
		Если Месяц(ДокументОтчет.ДатаОкончания) <= 3 
			ИЛИ Месяц(ДокументОтчет.ДатаОкончания) >= 10 Тогда  
			БезДанныхПоследнегоКвартала = Истина;  // не будем печать область СекцияПоследнийКвартал
		КонецЕсли;
	КонецЕсли;
	
	СписокРазделовОтчетаЗаАналогичныйПериодПредыдущегоГода = Неопределено;
	ОтчетЗаАналогичныйПериодПрошлогоГода = Неопределено;
	
	Если ДокументОтчет.ИсточникОтчета = "РегламентированныйОтчетБаланс"
		И (ДокументОтчет.ВыбраннаяФорма = "ФормаОтчета_МСФО9_2025"
		ИЛИ ДокументОтчет.ВыбраннаяФорма = "ФормаОтчета_МСФО9_СК_2025") Тогда 
		
		СписокРазделовОтчетаЗаАналогичныйПериодПредыдущегоГода = КонсолидированнаяОтчетность.ПолучитьСписокРазделовОтчетаЗаАналогичныйПериодПредыдущегоГода(НастройкиОтчета.КлючОтчета, ИмяФормыПредыдущегоГода, СтруктураПараметров.НКО);
		ОтчетЗаАналогичныйПериодПрошлогоГода = КонсолидированнаяОтчетность.ПолучитьОтчетНаКонецПредыдущегоПериода(СтруктураПараметров, НастройкиОтчета.КлючОтчета, ,ИмяФормыПредыдущегоГода, Истина);
		
	КонецЕсли;
	
	
	ПакетОтображаемыхДокументов = КонсолидированнаяОтчетность.ПолучитьРегламентированныйОтчетВПакете(ДокументОтчет, СтруктураПараметров.РазделыОтчета, СохраняемыеРазделы, СписокРазделовПредыдущегоГода, ВыводитьСопоставимыеДанные, , БезДанныхПоследнегоКвартала, СписокРазделовОтчетаЗаАналогичныйПериодПредыдущегоГода, ОтчетЗаАналогичныйПериодПрошлогоГода);
	
	НастройкиОтчета.Вставить("Результат", ПакетОтображаемыхДокументов);

КонецПроцедуры 

Функция ПолучитьСтруктуруПараметров(НастройкиОтчета)
	
	Результат = Отчеты[НастройкиОтчета.КлючОтчета].ПолучитьСтруктуруПараметров(НастройкиОтчета.ВыбраннаяФорма);
	
	Результат.мВыбраннаяФорма				= НастройкиОтчета.ВыбраннаяФорма;
	Результат.мСохраненныйДок				= НастройкиОтчета.РегламентированныйОтчет;
	Результат.мДатаНачалаПериодаОтчета		= НастройкиОтчета.Период.ДатаНачала;
	Результат.мДатаКонцаПериодаОтчета		= НастройкиОтчета.Период.ДатаОкончания;
	Результат.Организация					= НастройкиОтчета.Организация;
	Результат.СчетДоверительногоУправления	= НастройкиОтчета.СчетДоверительногоУправления;
	Результат.НестандартныйПериод			= НастройкиОтчета.РегламентированныйОтчет.НестандартныйПериод;
	
	Если НастройкиОтчета.КлючОтчета = "РегламентированныйОтчетБалансРСБУ" Тогда
		
		РезультатЗапроса = Отчеты.РегламентированныйОтчетБалансРСБУ.ПолучитьНастройкиОтчетностиРСБУ(Результат.Организация, 
		Результат.СчетДоверительногоУправления);
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Результат.Вставить(ВыборкаДетальныеЗаписи.СвойствоКлюч, ВыборкаДетальныеЗаписи.Значение);
		КонецЦикла;
		
	ИначеЕсли НастройкиОтчета.КлючОтчета = "РегламентированныйОтчетОФинансовыхРезультатахРСБУ" Тогда               
		
		РезультатЗапроса = Отчеты.РегламентированныйОтчетОФинансовыхРезультатахРСБУ.ПолучитьНастройкиОтчетностиРСБУ(Результат.Организация, 
		Результат.СчетДоверительногоУправления);
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Результат.Вставить(ВыборкаДетальныеЗаписи.СвойствоКлюч, ВыборкаДетальныеЗаписи.Значение);
		КонецЦикла;
		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Процедура ВосстановитьСохраненныеДанные(СтруктураПараметров)
	
	Перем ПоказателиОтчета;
	Перем ТаблицаРасшифровки;
	Перем РазделыСРучнойКорректировкой;
	
	СтруктураПараметров.Организация						= СтруктураПараметров.мСохраненныйДок.Организация;
	СтруктураПараметров.СчетДоверительногоУправления	= СтруктураПараметров.мСохраненныйДок.СчетДоверительногоУправления;
	СтруктураПараметров.ЕдиницаИзмерения				= СтруктураПараметров.мСохраненныйДок.ЕдиницаИзмерения;
	СтруктураПараметров.ТочностьЕдиницыИзмерения		= СтруктураПараметров.мСохраненныйДок.ТочностьЕдиницыИзмерения;
	СтруктураПараметров.ВалютаДокумента					= СтруктураПараметров.мСохраненныйДок.ВалютаДокумента;
	СтруктураПараметров.ОтчетНаКонецПрошлогоГода		= СтруктураПараметров.мСохраненныйДок.ОтчетНаКонецПрошлогоГода;
	
	// восстанавливаем сохраненные данные отчета
	СписокСохранения = СтруктураПараметров.мСохраненныйДок.ДанныеОтчета.Получить();
	
	СписокСохранения.Свойство("Расшифровка", ТаблицаРасшифровки);
	
	Если ТипЗнч(ТаблицаРасшифровки) = Тип("ТаблицаЗначений") Тогда
		СтруктураПараметров.Адрес_ТаблицаРасшифровки = ПоместитьВоВременноеХранилище(ТаблицаРасшифровки);
	КонецЕсли;
	
	// восстановим сохраненные данные редактируемых ячеек
	СписокСохранения.Свойство("ПоказателиОтчета",				ПоказателиОтчета);
	СписокСохранения.Свойство("РазделыСРучнойКорректировкой",	РазделыСРучнойКорректировкой);
	
	ЭтаФорма = Новый Структура;
	ЭтаФорма.Вставить("Адрес_мСтруктураЦветовРаскраски",	СтруктураПараметров.Адрес_мСтруктураЦветовРаскраски);
	ЭтаФорма.Вставить("Адрес_мСтруктураВариантыЗаполнения",	СтруктураПараметров.Адрес_мСтруктураВариантыЗаполнения);
	ЭтаФорма.Вставить("РазделыОтчета",						СтруктураПараметров.РазделыОтчета);
	
	Для Каждого ТекСтрока из СтруктураПараметров.РазделыОтчета Цикл
		Если Не РазделыСРучнойКорректировкой.Найти(ТекСтрока.ИмяРаздела) = Неопределено Тогда
			ТекСтрока.РучнаяКорректировка = Истина;
			КонсолидированнаяОтчетность.УстановитьЦветФонаЯчейки(ЭтаФорма, ТекСтрока.ИмяРаздела, ТекСтрока.ТабличныйДокумент);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекСтрока из ПоказателиОтчета Цикл
		Попытка
			ТабДок = НайтиТабличныйДокументРаздела(СтруктураПараметров.РазделыОтчета, ТекСтрока.ИмяРаздела);
			ТабДок.Области[ТекСтрока.ИмяПоказателя].Значение = ТекСтрока.Значение;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Функция СоздатьТаблицуРазделовУчета() 
	
	Результат = Новый ТаблицаЗначений;
	
	Результат.Колонки.Добавить("ИмяРаздела",			Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Представление",			Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ТабличныйДокумент");
	Результат.Колонки.Добавить("РучнаяКорректировка",	Новый ОписаниеТипов("Булево"));
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьРазделОтчета(РазделыОтчета, ИмяРаздела, Представление)

	НоваяСтрока = РазделыОтчета.Добавить();
	
	НоваяСтрока.ИмяРаздела		= ИмяРаздела;
	НоваяСтрока.Представление	= Представление;

КонецПроцедуры

Процедура СформироватьСписокРазделовОтчета(ВыбраннаяФорма, НКО, РазделыОтчета, КлючОтчета, ДатаФормирования)
		
	СписокРазделовОтчета = Отчеты[КлючОтчета].СформироватьСписокРазделовОтчета(ВыбраннаяФорма, НКО, ДатаФормирования);  
	
	Для Каждого Раздел Из СписокРазделовОтчета Цикл
		ДобавитьРазделОтчета(РазделыОтчета, Раздел.Значение, Раздел.Представление);
	КонецЦикла;
	
КонецПроцедуры

Функция СоздатьТаблицуСоставПоказателей()
	
	Результат = Новый ТаблицаЗначений;
	
	Результат.Колонки.Добавить("ИмяПоляТаблДокумента",		Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("КодПоказателяПоСоставу",	Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("КодПоказателяПоФорме",		Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ПризнМногострочности",		Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ТипДанныхПоказателя",		Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("КодПоказателяПоСтруктуре",	Новый ОписаниеТипов("Строка"));
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьНачальныеНастройкиАвтоматическоеФормирование(СтруктураПараметров, КлючОтчета)
	
	Перем ПараметрНКО;
	
	Если НЕ СтруктураПараметров.Свойство("НКО", ПараметрНКО) Тогда 
		ПараметрНКО = Ложь;
	КонецЕсли;	
	
	СформироватьСписокРазделовОтчета(СтруктураПараметров.мВыбраннаяФорма, ПараметрНКО, СтруктураПараметров.РазделыОтчета, КлючОтчета, СтруктураПараметров.мДатаКонцаПериодаОтчета);
	
	НачальныеНастройки = Новый Структура;
	
	НачальныеНастройки.Вставить("мТаблицаСоставПоказателей",			СоздатьТаблицуСоставПоказателей());
	НачальныеНастройки.Вставить("УникальныйИдентификатор",				Неопределено);
	НачальныеНастройки.Вставить("Адрес_ТаблицаРасшифровки",				"");
	НачальныеНастройки.Вставить("Адрес_мСтруктураЦветовРаскраски",		"");
	НачальныеНастройки.Вставить("Адрес_мСтруктураВариантыЗаполнения",	"");
	НачальныеНастройки.Вставить("Адрес_мТаблицаВариантыЗаполнения",		"");
	НачальныеНастройки.Вставить("Адрес_мТаблицаСчетов",					"");
	
	
	ИмяМакетаСоставаПоказателей = КонсолидированнаяОтчетность.ПолучитьИмяМакетаСоставаПоказателей(КлючОтчета, СтруктураПараметров);	
	НачальныеНастройки.Вставить("МакетСоставаПоказателей", Отчеты[КлючОтчета].ПолучитьМакет(ИмяМакетаСоставаПоказателей));
	
	ЗаполнитьНачальныеНастройкиСервер(НачальныеНастройки);
		
	Для каждого ЭлементСтруктуры Из НачальныеНастройки Цикл
		Если Лев(ЭлементСтруктуры.Ключ, 6) = "Адрес_" Тогда
			СтруктураПараметров.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
		КонецЕсли; 
	КонецЦикла; 
	
	СтруктураПараметров.Вставить("мТаблицаСоставПоказателей", НачальныеНастройки.мТаблицаСоставПоказателей);
	
КонецПроцедуры

Функция ПолучитьПрефиксМакета(ИмяФормы)
	
	Если СтрНачинаетсяС(ИмяФормы, "ФормаОтчета_МСФО39") Тогда 
		Префикс = "МСФО39_";
	Иначе 	
		Префикс = "МСФО9_";
	КонецЕсли;
	
	Возврат Префикс;
	
КонецФункции	

Процедура ЗаполнитьТабличныеДокументыИзМакетов(СтруктураПараметров, КлючОтчета)
	
	ЭтаФорма = Новый Структура;
	ЭтаФорма.Вставить("ИмяФормы",							"Отчет." + КлючОтчета + ".Форма." + СтруктураПараметров.мВыбраннаяФорма);
	ЭтаФорма.Вставить("СтруктураРеквизитовФормы",			СтруктураПараметров);
	ЭтаФорма.Вставить("Адрес_мСтруктураЦветовРаскраски",	СтруктураПараметров.Адрес_мСтруктураЦветовРаскраски);
	ЭтаФорма.Вставить("Адрес_мСтруктураВариантыЗаполнения",	СтруктураПараметров.Адрес_мСтруктураВариантыЗаполнения);
	ЭтаФорма.Вставить("РазделыОтчета",						СтруктураПараметров.РазделыОтчета);
	
	ТаблицаИзменяемыхОбластей = ПолучитьТаблицуИзменяемыхОбластей(КлючОтчета + СтруктураПараметров.мВыбраннаяФорма);
		
	Если КлючОтчета = "РегламентированныйОтчетБаланс" Тогда
		Для Каждого ТекСтрока Из ЭтаФорма.РазделыОтчета Цикл
			
			Префикс = ПолучитьПрефиксМакета(СтруктураПараметров.мВыбраннаяФорма);
									
			Если ТекСтрока.ИмяРаздела = "ОтчетТитульнаяСтраница" Тогда
				// у форм 2020 и 2024 нет вариантов для НКО
				// можно упростить. 
				Если (СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО39_СК_2020"
					ИЛИ СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО39_СК_2024"
					ИЛИ СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО39_СК"
					ИЛИ СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО39")
					ИЛИ СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО9_СК_2025"

					И СтруктураПараметров.Свойство("ВидДеятельностиОрганизации")
					И ЗначениеЗаполнено(СтруктураПараметров.ВидДеятельностиОрганизации)
					И СтруктураПараметров.ВидДеятельностиОрганизации <> "НПФ" Тогда
					Префикс = Префикс + СтруктураПараметров.ВидДеятельностиОрганизации + "_";
				КонецЕсли;
				
				Префикс = Префикс + ?(СтруктураПараметров.НКО, "НКО_", "");
				
			КонецЕсли;
			
			ИмяМакета = Префикс + "Макет" + ТекСтрока.ИмяРаздела;
			
			КонсолидированнаяОтчетность.ЗаполнитьТабличныйДокументИзМакета(ЭтаФорма, ТекСтрока, ИмяМакета, ТаблицаИзменяемыхОбластей);
						
		КонецЦикла;
		
	ИначеЕсли КлючОтчета = "РегламентированныйОтчетБалансРСБУ" Тогда
		Параметры = Новый Структура;
		Параметры.Вставить("мРедакцияФормы", СтруктураПараметров.мСохраненныйДок.РедакцияФормы);
	
		ЭтаФорма.Вставить("Параметры", Параметры);
		
		Для Каждого ТекСтрока Из ЭтаФорма.РазделыОтчета Цикл
			КонсолидированнаяОтчетность.ЗаполнитьТабличныйДокументИзМакета(ЭтаФорма, ТекСтрока, "БалансРСБУ_Макет" + ТекСтрока.ИмяРаздела, ТаблицаИзменяемыхОбластей);
		КонецЦикла;
		
	ИначеЕсли КлючОтчета = "РегламентированныйОтчетОФинансовыхРезультатахРСБУ" Тогда

		Параметры = Новый Структура;
		Параметры.Вставить("мРедакцияФормы", СтруктураПараметров.мСохраненныйДок.РедакцияФормы);
	
		ЭтаФорма.Вставить("Параметры", Параметры);
		
		Для Каждого ТекСтрока Из ЭтаФорма.РазделыОтчета Цикл
			КонсолидированнаяОтчетность.ЗаполнитьТабличныйДокументИзМакета(ЭтаФорма, ТекСтрока, "ОФРРСБУ_Макет" + ТекСтрока.ИмяРаздела, ТаблицаИзменяемыхОбластей);
		КонецЦикла;
		
	ИначеЕсли КлючОтчета = "РегламентированныйОтчетОПотокахДенежныхСредствНПФ" Тогда
		Для Каждого ТекСтрока Из ЭтаФорма.РазделыОтчета Цикл
			
			Префикс = ПолучитьПрефиксМакета(СтруктураПараметров.мВыбраннаяФорма);
			
			Если СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО39" И (ТекСтрока.ИмяРаздела = "ОтчетТитульнаяСтраница"
				ИЛИ ТекСтрока.ИмяРаздела = "ФинансоваяДеятельность"
				ИЛИ ТекСтрока.ИмяРаздела = "ИнвестиционнаяДеятельность")
				ИЛИ СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО9" И (ТекСтрока.ИмяРаздела = "ОтчетТитульнаяСтраница"
				ИЛИ ТекСтрока.ИмяРаздела = "ФинансоваяДеятельность"
				ИЛИ ТекСтрока.ИмяРаздела = "ДенежныеСредства")
				ИЛИ СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО39_2017" И (ТекСтрока.ИмяРаздела = "ОтчетТитульнаяСтраница2017"
				ИЛИ ТекСтрока.ИмяРаздела = "ФинансоваяДеятельность2017"
				ИЛИ ТекСтрока.ИмяРаздела = "ИнвестиционнаяДеятельность2017")
				ИЛИ СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО39_2020" И (ТекСтрока.ИмяРаздела = "ОтчетТитульнаяСтраница2020"
				ИЛИ ТекСтрока.ИмяРаздела = "ФинансоваяДеятельность2020"
				ИЛИ ТекСтрока.ИмяРаздела = "ИнвестиционнаяДеятельность2017")
				ИЛИ СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО9_2020" И (ТекСтрока.ИмяРаздела = "ОтчетТитульнаяСтраница2020"
				ИЛИ ТекСтрока.ИмяРаздела = "ФинансоваяДеятельность2020"
				ИЛИ ТекСтрока.ИмяРаздела = "ДенежныеСредства") Тогда
				Префикс = Префикс + ?(СтруктураПараметров.НКО, "НКО_", "");
			КонецЕсли;
			
			ИмяМакета = Префикс + "Макет" + ТекСтрока.ИмяРаздела;
			
			КонсолидированнаяОтчетность.ЗаполнитьТабличныйДокументИзМакета(ЭтаФорма, ТекСтрока, ИмяМакета, ТаблицаИзменяемыхОбластей);
			
		КонецЦикла;
		
	ИначеЕсли КлючОтчета = "РегламентированныйОтчетОФинансовыхРезультатах" Тогда	
		Для Каждого ТекСтрока Из ЭтаФорма.РазделыОтчета Цикл
			
			Префикс = ПолучитьПрефиксМакета(СтруктураПараметров.мВыбраннаяФорма);
			
			Если СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО39" И ТекСтрока.ИмяРаздела = "ОтчетТитульнаяСтраница"
				ИЛИ СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО39_2017" И ТекСтрока.ИмяРаздела = "ОтчетТитульнаяСтраница2017"
				ИЛИ СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО9" И ТекСтрока.ИмяРаздела = "ОтчетТитульнаяСтраница"
				ИЛИ СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО9_2017" И (ТекСтрока.ИмяРаздела = "ОтчетТитульнаяСтраница" ИЛИ ТекСтрока.ИмяРаздела = "ДоходыЗаВычетомРасходов2017")
				ИЛИ СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО39_2020" И ТекСтрока.ИмяРаздела = "ОтчетТитульнаяСтраница2020"
				ИЛИ СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО9_2020" И (ТекСтрока.ИмяРаздела = "ОтчетТитульнаяСтраница2020" ИЛИ ТекСтрока.ИмяРаздела = "ДоходыЗаВычетомРасходов") Тогда
				Префикс = Префикс + ?(СтруктураПараметров.НКО, "НКО_", "");
			ИначеЕсли СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО39_СК" И ТекСтрока.ИмяРаздела = "ОтчетТитульнаяСтраница"
				ИЛИ СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО39_СК_2020" И ТекСтрока.ИмяРаздела = "ОтчетТитульнаяСтраница2020" 
			 	ИЛИ СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО39_СК_2024" И ТекСтрока.ИмяРаздела = "ОтчетТитульнаяСтраница2020" 
				ИЛИ СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_МСФО9_СК_2025" И ТекСтрока.ИмяРаздела = "ОтчетТитульнаяСтраница" Тогда
				Префикс = Префикс
				+ ?(ЗначениеЗаполнено(СтруктураПараметров.ВидДеятельностиОрганизации) И СтруктураПараметров.ВидДеятельностиОрганизации <> "НПФ", СтруктураПараметров.ВидДеятельностиОрганизации + "_", "")
				+ ?(СтруктураПараметров.НКО, "НКО_", "");
			КонецЕсли;
			
			ИмяМакета = Префикс + "Макет" + ТекСтрока.ИмяРаздела;
			
			КонсолидированнаяОтчетность.ЗаполнитьТабличныйДокументИзМакета(ЭтаФорма, ТекСтрока, ИмяМакета, ТаблицаИзменяемыхОбластей);
						
		КонецЦикла;
		
	ИначеЕсли КлючОтчета = "РегламентированныйОтчетФинансовыеОперацииНПФ" Тогда	
		Для Каждого ТекСтрока Из ЭтаФорма.РазделыОтчета Цикл
			
			Если ТекСтрока.ИмяРаздела = "ОтчетТитульнаяСтраница"
				ИЛИ ТекСтрока.ИмяРаздела = "ОтчетТитульнаяСтраница2020" Тогда
				КонсолидированнаяОтчетность.ЗаполнитьТабличныйДокументИзМакета(ЭтаФорма, ТекСтрока, "Макет" + ТекСтрока.ИмяРаздела);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьИмяМакетаСоставаПоказателей(КлючОтчета, СтруктураПараметров) Экспорт
										
	Если КлючОтчета = "РегламентированныйОтчетБалансРСБУ" Тогда  
		
		Если СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_07100001" Тогда 
			ИмяМакетаСоставаПоказателей = "БалансРСБУ_СоставПоказателей";   
		ИначеЕсли СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_07100001_2025" Тогда 
			ИмяМакетаСоставаПоказателей = "БалансРСБУ_СоставПоказателей2025";   
		ИначеЕсли СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_07100001_2025СРасшифровкой" Тогда 
			ИмяМакетаСоставаПоказателей = "БалансРСБУ_СоставПоказателей2025СРасшифровкой";   
		КонецЕсли;	
		
	ИначеЕсли КлючОтчета = "РегламентированныйОтчетОФинансовыхРезультатахРСБУ" Тогда  
		
		// ОФР РСБУ добавлен с 01.01.2025. Имя формы и макета назначены для общности с Балансом РСБУ
		Если СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета_07100002_2025" Тогда 
			ИмяМакетаСоставаПоказателей = "ОФРРСБУ_СоставПоказателей2025";   
        КонецЕсли;
		
	ИначеЕсли КлючОтчета = "РегламентированныйОтчетФинансовыеОперацииНПФ" Тогда	
						
		Если СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета" Тогда
			ИмяМакетаСоставаПоказателей = "СоставПоказателей";
		ИначеЕсли СтруктураПараметров.мВыбраннаяФорма = "ФормаОтчета2020" Тогда
			ИмяМакетаСоставаПоказателей = "СоставПоказателей2020";
		КонецЕсли;
		
	Иначе //сделаем универсально 
		// ФормаОтчета_МСФО39_СК_2020
		// Части Имени формы
		// имя формы МСФО39 или МСФО9. Есть всегда 
		// вид деятельности. Только СК. для вида деятельности НПФ эта часть пустая
		// год формы. У старых форм нет. Значения - 2017 или 2020. 
		// НКО (некоммерческая организация). Форма бывает в двух вариантах: для АО и НКО. У страховых формы НКО
		// с 2020 в базе нет отчетов в форме НКО
		ИмяФормы = СтруктураПараметров.мВыбраннаяФорма; 
		
		Если СтрНачинаетсяС(ИмяФормы, "ФормаОтчета_МСФО39") Тогда 
			ЧастьФорма = "МСФО39";
		ИначеЕсли СтрНачинаетсяС(ИмяФормы, "ФормаОтчета_МСФО9") Тогда 
			ЧастьФорма = "МСФО9";
		Иначе
			ВызватьИсключение "Неизвестная форма. Не удалось определить имя макета состава показателей";
			Возврат "";
		КонецЕсли;	
		
		Если СтруктураПараметров.Свойство("ВидДеятельностиОрганизации") И СтруктураПараметров.ВидДеятельностиОрганизации = "СК" Тогда     //СК, НПФ
			ЧастьВидДеятельности = "_СК";
		Иначе
			ЧастьВидДеятельности = "";
		КонецЕсли;
		
		Если СтруктураПараметров.Свойство("НКО") И СтруктураПараметров.НКО = Истина Тогда   
			ЧастьНКО = "_НКО";
		Иначе
			ЧастьНКО = "";
		КонецЕсли;
		
		ГодыРедакцийФорм = Новый Массив;
		ГодыРедакцийФорм.Добавить("2017");
		ГодыРедакцийФорм.Добавить("2020");
		ГодыРедакцийФорм.Добавить("2024");
		ГодыРедакцийФорм.Добавить("2025");
		
		ГодФормы = Прав(ИмяФормы, 4);
		Если ГодыРедакцийФорм.Найти(ГодФормы) = Неопределено Тогда 
			ГодФормы = "";
		КонецЕсли;		
		
		//У баланса в 2022 году примечание 20 заменили на 20.1 
		Если КлючОтчета = "РегламентированныйОтчетБаланс" И ИмяФормы = "ФормаОтчета_МСФО39_2020" Тогда	
			Если Год(СтруктураПараметров.мДатаКонцаПериодаОтчета) >= 2022 Тогда  
				ГодФормы = "2022";
			КонецЕсли
		КонецЕсли;
		
		ИмяМакетаСоставаПоказателей = ЧастьФорма + ЧастьВидДеятельности + ЧастьНКО + "_СоставПоказателей" + ГодФормы;	
		
	КонецЕсли;
	
	Возврат ИмяМакетаСоставаПоказателей;
	
КонецФункции	

Функция ПолучитьСписокРазделовПредыдущегоГода(КлючОтчета, ИмяФормы, НКО = Ложь) Экспорт
	
	Возврат Отчеты[КлючОтчета].ПолучитьСписокРазделовПредыдущегоГода(ИмяФормы, НКО);
	
КонецФункции

Функция ПолучитьСписокРазделовОтчетаЗаАналогичныйПериодПредыдущегоГода(КлючОтчета, ИмяФормы, НКО = Ложь) Экспорт
	
	//внимание! Только Баланс МСФО 9 (2025) 
	Возврат Отчеты[КлючОтчета].ПолучитьСписокРазделовОтчетаЗаАналогичныйПериодПредыдущегоГода(ИмяФормы, НКО);
	
КонецФункции

#КонецОбласти

#Область ОбщиеПроцедурыИФункцииПостроенияОтчетности

Функция ПодготовитьВременныеТаблицыДокумента(Запрос, ЗапрашиваемыеТаблицы) Экспорт
	
	Результат = Новый Структура;
	
	Для Каждого ЭлементСписка из ЗапрашиваемыеТаблицы Цикл 
		Если ЭлементСписка.Значение = "ТаблицаСчетовСОбСубконто" Тогда   
			//заимствовано из ПолучитьТаблицуСчетовСОборотнымСубконтоКонтрагенты(), функция удалена	
			
			ТипКонтрагенты = Тип("СправочникСсылка.ЮрФизЛица");
			
			Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВидыСубконто.Ссылка КАК Счет,
			|	ВидыСубконто.ВидСубконто КАК ВидСубконто,
			|	ВидыСубконто.ВидСубконто.ТипЗначения КАК ТипЗначения
			|ИЗ
			|	ПланСчетов.Единый.ВидыСубконто КАК ВидыСубконто
			|ГДЕ
			|	ВидыСубконто.ТолькоОбороты = ИСТИНА
			|
			|УПОРЯДОЧИТЬ ПО
			|	ВидыСубконто.Ссылка.Порядок,
			|	ВидыСубконто.Ссылка.Код";
			
			ТаблицаСчетовСОборотнымСубконтоКонтрагенты = Запрос.Выполнить().Выгрузить();
			
			Инд = ТаблицаСчетовСОборотнымСубконтоКонтрагенты.Количество() - 1;
			Пока Инд >= 0 Цикл
				ТекСтрока = ТаблицаСчетовСОборотнымСубконтоКонтрагенты[Инд];
				Если Не ТекСтрока.ТипЗначения.СодержитТип(ТипКонтрагенты) Тогда
					ТаблицаСчетовСОборотнымСубконтоКонтрагенты.Удалить(ТекСтрока);
				КонецЕсли;
				Инд = Инд - 1;
			КонецЦикла;
			
			ТаблицаСчетовСОборотнымСубконтоКонтрагенты.Колонки.Удалить("ТипЗначения");
						
			Результат.Вставить("ТаблицаСчетовСОбСубконто", ТаблицаСчетовСОборотнымСубконтоКонтрагенты);
			
		ИначеЕсли ЭлементСписка.Значение = "КоэффициентыВалют" Тогда 
			ТекстЗапросаКурсыВалют = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КурсыВалютСрезПоследних.Валюта КАК Валюта,
			|	КурсыВалютСрезПоследних.Курс,
			|	КурсыВалютСрезПоследних.Кратность
			|ПОМЕСТИТЬ #ТаблицаРезультат
			|ИЗ
			|	РегистрСведений.КурсыВалют.СрезПоследних(&КонецПериода, ) КАК КурсыВалютСрезПоследних
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Валюта
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КурсВалютыПроводки.Валюта,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(КурсВалютыПроводки.Курс, 1) <> 0
			|				И ЕСТЬNULL(КурсВалютыПроводки.Кратность, 1) <> 0
			|				И ЕСТЬNULL(КурсВалютыДокумента.Курс, 1) <> 0
			|				И ЕСТЬNULL(КурсВалютыДокумента.Кратность, 1) <> 0
			|			ТОГДА КурсВалютыПроводки.Курс * КурсВалютыДокумента.Кратность / (КурсВалютыДокумента.Курс * КурсВалютыПроводки.Кратность)
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК Курс
			|ИЗ
			|	#ТаблицаРезультат КАК КурсВалютыПроводки
			|		ЛЕВОЕ СОЕДИНЕНИЕ #ТаблицаРезультат КАК КурсВалютыДокумента
			|		ПО (КурсВалютыДокумента.Валюта = &ВалютаДокумента)";
			
			Запрос.Текст = СтрЗаменить(ТекстЗапросаКурсыВалют, "#ТаблицаРезультат", "КурсыВалютНаКонецТекущегоПериода");
			мТаблицаКоэффициентыВалютТП = Запрос.Выполнить().Выгрузить();
			
			Результат.Вставить("КоэффициентыВалютТП", мТаблицаКоэффициентыВалютТП);
			
			// Получим курсы валют прошлого периода	
			Запрос.Текст = СтрЗаменить(ТекстЗапросаКурсыВалют, "#ТаблицаРезультат", "КурсыВалютНаКонецПрошлогоПериода");
			мТаблицаКоэффициентыВалютПП = Запрос.Выполнить().Выгрузить();
			
			Результат.Вставить("КоэффициентыВалютПП", мТаблицаКоэффициентыВалютПП);
			
		ИначеЕсли  ЭлементСписка.Значение = "КурсыВалютНаКонец" Тогда	
			// КурсыВалютНаКонец в списке должны быть после КоэффициентыВалют, временные запросы КурсыВалют* уже должны существовать   
			
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ * ИЗ КурсыВалютНаКонецТекущегоПериода КАК ТЗ";
			мТаблицаКурсыВалютНаКонецТекущегоПериода = Запрос.Выполнить().Выгрузить();		
			Результат.Вставить("КурсыВалютНаКонецТП", мТаблицаКурсыВалютНаКонецТекущегоПериода);
			
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ * ИЗ КурсыВалютНаКонецПрошлогоПериода КАК ТЗ";
			мТаблицаКурсыВалютНаКонецПрошлогоПериода = Запрос.Выполнить().Выгрузить();
			Результат.Вставить("КурсыВалютНаКонецПП", мТаблицаКурсыВалютНаКонецПрошлогоПериода);
			
		ИначеЕсли ЭлементСписка.Значение = "ФинансовыеОрганизации" Тогда  	
			
			ДатаПеречня = КонсолидированнаяОтчетность.ПолучитьДатуПеречняФинансовыхОрганизаций(Запрос.Параметры.КонецПериода);
			ДатаПеречняПП = КонсолидированнаяОтчетность.ПолучитьДатуПеречняФинансовыхОрганизаций(Запрос.Параметры.КонецПредыдущегоПериода);
			
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ПеречниОбъектов.Объект
			|ИЗ
			|	РегистрСведений.ПеречниОбъектов КАК ПеречниОбъектов
			|ГДЕ
			|	ПеречниОбъектов.Включен
			|	И ПеречниОбъектов.Период = &ДатаПеречняТП
			|	И ПеречниОбъектов.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЦБРФ)
			|	И ПеречниОбъектов.ВидПеречня.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ЦБРФ_ПереченьОрганизацийФинансовогоСектора)";
			Запрос.УстановитьПараметр("ДатаПеречняТП", ДатаПеречня);
			мТаблицаФинансовыхОрганизацийТП = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаПеречняТП", "&ДатаПеречняПП");
			
			Запрос.УстановитьПараметр("ДатаПеречняПП", ДатаПеречняПП);
