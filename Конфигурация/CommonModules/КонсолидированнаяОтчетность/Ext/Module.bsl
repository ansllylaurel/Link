// УчетныйАктивЦБРФ_СписокСправочников
Функция УчетныйАктивЦБРФ_СписокСправочников(флЕстьСправочники = ЛОЖЬ) Экспорт
	
	сзСправочники = Новый СписокЗначений;
	сзСправочники.Добавить("Акции");
	сзСправочники.Добавить("Паи");
	сзСправочники.Добавить("Облигации");
	
	флЕстьСправочники = ЛОЖЬ;
	Для Каждого эл_сзСправочники из сзСправочники Цикл
		эл_сзСправочники.Пометка = НЕ (Метаданные.Справочники.Найти(эл_сзСправочники.Значение) = Неопределено) И НЕ (Метаданные.Справочники[эл_сзСправочники.Значение].Реквизиты.Найти("УчетныйАктивЦБРФ") = Неопределено);
		
		Если эл_сзСправочники.Пометка Тогда
			Если НЕ ТипСправочникаСодержитсяВРегистреБухгалтерии(эл_сзСправочники.Значение) Тогда
				эл_сзСправочники.Пометка = ЛОЖЬ;
			КонецЕсли;
		КонецЕсли;
		
		Если эл_сзСправочники.Пометка Тогда
			флЕстьСправочники = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат сзСправочники;
	
КонецФункции

