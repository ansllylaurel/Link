////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

Функция ЗаполнитьРазделРегламентированногоОтчетаЗаПрошлыйГод(Знач ТабличныйДокумент, ИмяРаздела, ОтчетПрошлогоГода) Экспорт

	Если Не ЗначениеЗаполнено(ОтчетПрошлогоГода) Тогда
	
		Возврат Неопределено;
		
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Показатели.ИмяРаздела,
	|	Показатели.ИмяПоказателя,
	|	Показатели.Значение
	|ПОМЕСТИТЬ Показатели
	|ИЗ
	|	&Показатели КАК Показатели
	|ГДЕ
	|	Показатели.ИмяРаздела = &ИмяРаздела
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Показатели.ИмяРаздела,
	|	Показатели.ИмяПоказателя,
	|	Показатели.Значение
	|ИЗ
	|	Показатели КАК Показатели";
	
	ДанныеОтчета = ОтчетПрошлогоГода.ДанныеОтчета.Получить(); 
		
	Запрос.УстановитьПараметр("Показатели", ДанныеОтчета.ПоказателиОтчета);
	Запрос.УстановитьПараметр("ИмяРаздела", ИмяРаздела);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Для Каждого ТекОбласть Из ТабличныйДокумент.Области Цикл
		Если Не ТекОбласть.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Если Не ТекОбласть.СодержитЗначение Тогда
				Продолжить;
			КонецЕсли;
		Исключение
			ТекстСообщения = "Ошибка макета: раздел " + ИмяРаздела + " область " + ТекОбласть.Имя + " не содержит значение!";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		КонецПопытки;
		ТекОбласть.Очистить();
	КонецЦикла;
	
	Если НЕ ТабличныйДокумент.Области.Найти("ТекущийПериод") = Неопределено Тогда
		ТабличныйДокумент.Области.ТекущийПериод.Значение = "На " + Формат(ОтчетПрошлогоГода.ДатаОкончания, "ДФ=dd.MM.yyyy"); 
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		Попытка
			ТабличныйДокумент.Области[Выборка.ИмяПоказателя].Значение = Выборка.Значение;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Возврат ТабличныйДокумент;

КонецФункции   

// НаименованиеСлагаемого
Функция НаименованиеСлагаемого(ИмяСлагаемого, КодСчета, КодКорреспондентскогоСчета, ДатаНачалаПериода, ДатаКонцаПериода) Экспорт
	
	Если Лев(ИмяСлагаемого, 1)="!" Тогда
		// передана мнемоника, будем расшифровывать
		Наименование = "";
		ПредставлениеПериодаС = " " + ПредставлениеПериода(ДатаНачалаПериода, КонецДня(ДатаКонцаПериода), "ФП = Истина") + " ";
		Макроимя = Сред(ИмяСлагаемого, 2);
		
		Если Макроимя = "СНД" Тогда
			Наименование = "Сальдо на начало периода" + ПредставлениеПериодаС + "по дебету счета " + СокрЛП(КодСчета);
		ИначеЕсли Макроимя = "СНДР" Тогда
			Наименование = "Сальдо на начало периода" + ПредставлениеПериодаС + "по дебету субсчетов счета " + СокрЛП(КодСчета);
		ИначеЕсли Макроимя = "СНДРС" Тогда
			Наименование = "Сальдо на начало периода" + ПредставлениеПериодаС + "по дебету счета " + СокрЛП(КодСчета) + " по субконто";
		ИначеЕсли Макроимя = "СКД" Тогда
			Наименование = "Сальдо на конец периода" + ПредставлениеПериодаС + "по дебету счета " + СокрЛП(КодСчета);
		ИначеЕсли Макроимя = "СКДР" Тогда
			Наименование = "Сальдо на конец периода" + ПредставлениеПериодаС + "по дебету субсчетов счета " + СокрЛП(КодСчета);
		ИначеЕсли Макроимя = "СКДРС" Тогда
			Наименование = "Сальдо на конец периода" + ПредставлениеПериодаС + "по дебету субсчетов счета " + СокрЛП(КодСчета) + " по субконто";
		ИначеЕсли Макроимя = "СНК" Тогда
			Наименование = "Сальдо на начало периода" + ПредставлениеПериодаС + "по кредиту счета " + СокрЛП(КодСчета);
		ИначеЕсли Макроимя = "СНКР" Тогда
			Наименование = "Сальдо на начало периода" + ПредставлениеПериодаС + "по кредиту субсчетов счета " + СокрЛП(КодСчета);
		ИначеЕсли Макроимя = "СНКРС" Тогда
			Наименование = "Сальдо на начало периода" + ПредставлениеПериодаС + "по кредиту счета " + СокрЛП(КодСчета) + " по субконто";
		ИначеЕсли Макроимя = "СКК" Тогда
			Наименование = "Сальдо на конец периода" + ПредставлениеПериодаС + "по кредиту счета " + СокрЛП(КодСчета);
		ИначеЕсли Макроимя = "СККР" Тогда
			Наименование = "Сальдо на конец периода" + ПредставлениеПериодаС + "по кредиту субсчетов счета " + СокрЛП(КодСчета);
		ИначеЕсли Макроимя = "СККРС" Тогда
			Наименование = "Сальдо на конец периода" + ПредставлениеПериодаС + "по кредиту счета " + СокрЛП(КодСчета) + " по субконто";
		ИначеЕсли Макроимя = "ДО" Тогда
			Если НЕ ЗначениеЗаполнено(КодКорреспондентскогоСчета) Тогда
				Наименование = "Оборот по дебету счета " + СокрЛП(КодСчета) + ?(ПредставлениеПериодаС = " ", "", " за период" + ПредставлениеПериодаС);
			Иначе
				Наименование = "Оборот с кредита счета " + СокрЛП(КодКорреспондентскогоСчета) + " в дебет счета " + СокрЛП(КодСчета) + ?(ПредставлениеПериодаС = " ", "", " за период" + ПредставлениеПериодаС);
			КонецЕсли;
		ИначеЕсли Макроимя = "КО" Тогда
			Если НЕ ЗначениеЗаполнено(КодКорреспондентскогоСчета) Тогда
				Наименование = "Оборот по кредиту счета " + СокрЛП(КодСчета) + ?(ПредставлениеПериодаС = " ", "", " за период" + ПредставлениеПериодаС);
			Иначе
				Наименование = "Оборот с кредита счета " + СокрЛП(КодСчета) + " в дебет счета " + СокрЛП(КодКорреспондентскогоСчета) + ?(ПредставлениеПериодаС = " ", "", " за период" + ПредставлениеПериодаС);
			КонецЕсли;
		ИначеЕсли Макроимя = "ОБ" Тогда
			Наименование = "Оборот с кредита счета " + СокрЛП(КодКорреспондентскогоСчета) + " в дебет счета " + СокрЛП(КодСчета) + ?(ПредставлениеПериодаС = " ", "", " за период" + ПредставлениеПериодаС);
		КонецЕсли;
		Возврат Наименование;
	Иначе
		// передано имя, ничего расшифровывать не нужно
		Возврат ИмяСлагаемого;
	КонецЕсли;
	
КонецФункции

// ПолучитьИмяРеквизитаСуммыПоИмениСлагаемого
Функция ПолучитьИмяРеквизитаСуммыПоИмениСлагаемого(ИмяСлагаемого) Экспорт
	
	ИмяРеквизитаСуммы = "";
	
	Если ИмяСлагаемого = "!ДО" Тогда
		ИмяРеквизитаСуммы = "СуммаОборотДт";
	ИначеЕсли ИмяСлагаемого = "!КО" Тогда
		ИмяРеквизитаСуммы = "СуммаОборотКт";
	ИначеЕсли ИмяСлагаемого = "!СНД" Тогда
		ИмяРеквизитаСуммы = "СуммаНачальныйОстатокДт";
	ИначеЕсли ИмяСлагаемого = "!СНК" Тогда
		ИмяРеквизитаСуммы = "СуммаНачальныйОстатокКт";
	ИначеЕсли ИмяСлагаемого = "!СНДР" Тогда
		ИмяРеквизитаСуммы = "СуммаНачальныйРазвернутыйОстатокДт";
	ИначеЕсли ИмяСлагаемого = "!СНКР" Тогда
		ИмяРеквизитаСуммы = "СуммаНачальныйРазвернутыйОстатокКт";
	ИначеЕсли ИмяСлагаемого = "!СКД" Тогда
		ИмяРеквизитаСуммы = "СуммаКонечныйОстатокДт";
	ИначеЕсли ИмяСлагаемого = "!СКК" Тогда
		ИмяРеквизитаСуммы = "СуммаКонечныйОстатокКт";
	ИначеЕсли ИмяСлагаемого = "!СКДР" Тогда
		ИмяРеквизитаСуммы = "СуммаКонечныйРазвернутыйОстатокДт";
	ИначеЕсли ИмяСлагаемого = "!СККР" Тогда
		ИмяРеквизитаСуммы = "СуммаКонечныйРазвернутыйОстатокКт";
	Иначе
		ИмяРеквизитаСуммы = "";
	КонецЕсли;
	
	Возврат ИмяРеквизитаСуммы;
	
КонецФункции

Функция ПолучитьДенежныйПоказательСРазмерностью(Объект, ЭтаФорма) Экспорт
	
	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		мДелитель = Объект.мДелитель;
	Иначе	
		мДелитель = ЭтаФорма.мДелитель;
	КонецЕсли;
	
	Если мДелитель = 1000 Тогда
		Результат = "Тыс. ";
	ИначеЕсли мДелитель = 1000000 Тогда
		Результат = "Млн. ";
	Иначе
		Результат = "";
	КонецЕсли;
	
	СтрокаВалюта = ?(ЗначениеЗаполнено(Объект.ВалютаДокумента), Строка(Объект.ВалютаДокумента), "руб");
	СтрокаВалюта = СтрЗаменить(СтрокаВалюта, "RUB", "руб.");
	
	Возврат нрег(Результат + СтрокаВалюта);
	
КонецФункции

Функция СведенияОЮрФизЛице(СчетДоверительногоУправления, Период) Экспорт

	НаименованияКлиента = РаботаСОтчетами.ПолноеИКраткоеНаименованиеКлиентаДляДокументов(СчетДоверительногоУправления, Период);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора,
		|	&КраткоеНаименованиеКлиента КАК КраткоеНаименование,
		|	&ПолноеНаименованиеКлиента КАК ПолноеНаименование,
		|	РеквизитыСчетаДУСрезПоследних.ПочтовыйАдрес КАК ПочтовыйАдрес,
		|	РеквизитыСчетаДУСрезПоследних.ЮридическийАдрес КАК ЮридическийАдрес,
		|	РеквизитыСчетаДУСрезПоследних.ФактическийАдрес КАК ФактическийАдрес,
		|	РеквизитыСчетаДУСрезПоследних.КодПоОКПО КАК КодПоОКПО,
		|	РеквизитыСчетаДУСрезПоследних.КодПоОКТМО КАК КодПоОКТМО,
		|	РеквизитыСчетаДУСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыСчетаДУСрезПоследних.ОГРН КАК ОГРН,
		|	РеквизитыСчетаДУСрезПоследних.КодПоОКВЭД КАК КодПоОКВЭД,
		|	РеквизитыСчетаДУСрезПоследних.ОрганизационноПравоваяФорма.Наименование КАК ОрганизационноПравоваяФорма,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК НаименованиеОрганизации,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеОрганизации,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КодПоОКПО КАК КодПоОКПООрганизации,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН КАК ИННОрганизации,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КодПоОКВЭД КАК КодПоОКВЭДОрганизации,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ОрганизационноПравоваяФорма.Наименование КАК ОрганизационноПравоваяФормаОрганизации,
		|	ЕСТЬNULL(КонтактнаяИнформацияСрезПоследних.Представление, """") КАК ЮридическийАдресОрганизации
		|ИЗ
		|	(ВЫБРАТЬ
		|		СчетаДУ.НомерДоговора КАК НомерДоговора,
		|		СчетаДУ.ДатаЗаключения КАК ДатаЗаключения
		|	ИЗ
		|		Справочник.СчетаДоверительногоУправления КАК СчетаДУ
		|	ГДЕ
		|		СчетаДУ.Ссылка = &СчетДоверительногоУправления) КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|					&Период,
		|					Организация = &Организация
		|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыСчетаДУСрезПоследних
		|			ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыСчетаДУСрезПоследних.ЮрФизЛицо
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮридическийАдрес)
		|					И Объект В
		|						(ВЫБРАТЬ
		|							Организации.ЮрФизЛицо КАК ЮрФизЛицо
		|						ИЗ
		|							Справочник.Организации КАК Организации
		|						ГДЕ
		|							Организации.Ссылка = &Организация)) КАК КонтактнаяИнформацияСрезПоследних
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И ЮрФизЛицо В
		|						(ВЫБРАТЬ
		|							Организации.ЮрФизЛицо КАК ЮрФизЛицо
		|						ИЗ
		|							Справочник.Организации КАК Организации
		|						ГДЕ
		|							Организации.Ссылка = &Организация)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО (ИСТИНА)";
	
	Запрос.УстановитьПараметр("Период", 						Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", 					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "Организация"));
	Запрос.УстановитьПараметр("КраткоеНаименованиеКлиента", 	НаименованияКлиента.КраткоеНаименование);
	Запрос.УстановитьПараметр("ПолноеНаименованиеКлиента", 		НаименованияКлиента.ПолноеНаименование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи;
	КонецЕсли;
	
КонецФункции

// ЕстьДокументыЗаТотЖеПериод
Функция ЕстьДокументыЗаТотЖеПериод(Знач ДокументОбъект) Экспорт
	
	ЕстьДокументы = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РегламентированныйОтчет.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РегламентированныйОтчет КАК РегламентированныйОтчет
	|ГДЕ
	|	РегламентированныйОтчет.Ссылка <> &Ссылка
	|	И Не РегламентированныйОтчет.ПометкаУдаления
	|	И РегламентированныйОтчет.Организация = &Организация
	|	И РегламентированныйОтчет.СчетДоверительногоУправления = &СчетДоверительногоУправления
	|	И РегламентированныйОтчет.ДатаНачала = &ДатаНачала
	|	И РегламентированныйОтчет.ДатаОкончания = &ДатаОкончания
	|	И РегламентированныйОтчет.ВалютаДокумента = &ВалютаДокумента
	|	И РегламентированныйОтчет.НомерКорректировки = &НомерКорректировки
	|	И РегламентированныйОтчет.ВыбраннаяФорма = &ВыбраннаяФорма
	|	И РегламентированныйОтчет.ИсточникОтчета = &ИсточникОтчета
	|	И РегламентированныйОтчет.ОтчетЗаПоследнийКвартал = &ОтчетЗаПоследнийКвартал
	|	И РегламентированныйОтчет.НестандартныйПериод = &НестандартныйПериод
	|	И РегламентированныйОтчет.ВидУчета = &ВидУчета";
	
	Запрос.УстановитьПараметр("Ссылка"       				, ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("Организация"    				, ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ДокументОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаНачала"  				, ДокументОбъект.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"  				, ДокументОбъект.ДатаОкончания);
	Запрос.УстановитьПараметр("ВалютаДокумента"				, ДокументОбъект.ВалютаДокумента);
	Запрос.УстановитьПараметр("НомерКорректировки"			, ДокументОбъект.НомерКорректировки);
	Запрос.УстановитьПараметр("ВыбраннаяФорма"				, ДокументОбъект.ВыбраннаяФорма);
	Запрос.УстановитьПараметр("ИсточникОтчета"				, ДокументОбъект.ИсточникОтчета);
	Запрос.УстановитьПараметр("ОтчетЗаПоследнийКвартал"		, ДокументОбъект.ОтчетЗаПоследнийКвартал);
	Запрос.УстановитьПараметр("НестандартныйПериод"			, ДокументОбъект.НестандартныйПериод);
	Запрос.УстановитьПараметр("ВидУчета"					, ДокументОбъект.ВидУчета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекстОшибки = "За указанный период уже заведен документ, ключевые поля которого совпадают с текущим документом: " + Выборка.Ссылка;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Выборка.Ссылка, , , ЕстьДокументы);
	КонецЦикла;
	
	Возврат ЕстьДокументы;
	
КонецФункции

