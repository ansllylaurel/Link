#КонецОбласти

#Область СлужебныеОтборыЗапросов

// ОтборПоСубконтоПлюсМинус
Процедура ОтборПоСубконтоПлюсМинус(Запрос, ВидСальдо, мТаблицаСчетов, ТекстСравненияПредставление = "", СравнениеИтогаСНулем = "", стрОтборВирт = "") Экспорт
	
	// Если в запросе есть служебные слова:
	// #ОтборПоСубконтоДоговорЦенныеБумагиПлюс
	// #ОтборПоСубконтоДоговорЦенныеБумагиМинус.
	
	// определим сколько субконто в плане счетов
	ИмяПланаСчетов = "Единый";
	КолСубконто = Метаданные.ПланыСчетов.Единый.МаксКоличествоСубконто;
	
	ВариантОтборов = Неопределено;
	
	стрТекстСравнения = Неопределено;
	стрТекстСлужебнойКоманды = "";
	стрТекстОтбораПоПустомуСубконто = "ВложенныйЗапрос.Субконто <> НЕОПРЕДЕЛЕНО";
	Если СтрЧислоВхождений(Запрос.Текст, "#ОтборПоСубконтоДоговорЦенныеБумагиПлюс") Тогда
		стрТекстСравнения = " >0";
		стрТекстСлужебнойКоманды = "#ОтборПоСубконтоДоговорЦенныеБумагиПлюс";
		ТекстСравненияПредставление = "больше нуля";
		ВариантОтборов = "ДоговорЦенныеБумаги";
	ИначеЕсли СтрЧислоВхождений(Запрос.Текст, "#ОтборПоСубконтоДоговорЦенныеБумагиМинус") Тогда
		стрТекстСравнения = " <0";
		стрТекстСлужебнойКоманды = "#ОтборПоСубконтоДоговорЦенныеБумагиМинус";
		ТекстСравненияПредставление = "меньше нуля";
		ВариантОтборов = "ДоговорЦенныеБумаги";
		
	ИначеЕсли СтрЧислоВхождений(Запрос.Текст, "#ОтборПоОФРПлюс") Тогда
		стрТекстСравнения = " >0";
		стрТекстСлужебнойКоманды = "#ОтборПоОФРПлюс";
		ТекстСравненияПредставление = "больше нуля";
		ВариантОтборов = "ОФР";
	ИначеЕсли СтрЧислоВхождений(Запрос.Текст, "#ОтборПоОФРМинус") Тогда
		стрТекстСравнения = " <0";
		стрТекстСлужебнойКоманды = "#ОтборПоОФРМинус";
		ТекстСравненияПредставление = "меньше нуля";
		ВариантОтборов = "ОФР";
		
	ИначеЕсли СтрЧислоВхождений(Запрос.Текст, "#ОтборПоОСиНМАПлюс") Тогда
		стрТекстСравнения = " >0";
		стрТекстСлужебнойКоманды = "#ОтборПоОСиНМАПлюс";
		ТекстСравненияПредставление = "больше нуля";
		ВариантОтборов = "ОСиНМА";
		стрТекстОтбораПоПустомуСубконто = "ИСТИНА"; //не нужен отбор по пустому субконто, пусть попадают в запрос
		
	ИначеЕсли СтрЧислоВхождений(Запрос.Текст, "#ОтборПоОСиНМАМинус") Тогда
		стрТекстСравнения = " <0";
		стрТекстСлужебнойКоманды = "#ОтборПоОСиНМАМинус";
		ТекстСравненияПредставление = "меньше нуля";
		ВариантОтборов = "ОСиНМА";
		стрТекстОтбораПоПустомуСубконто = "ИСТИНА"; //не нужен отбор по пустому субконто, пусть попадают в запрос
		
	ИначеЕсли СтрЧислоВхождений(Запрос.Текст, "#СводноПлюс") Тогда
		СравнениеИтогаСНулем = "Больше";
		стрТекстСлужебнойКоманды = "#СводноПлюс";
		
	ИначеЕсли СтрЧислоВхождений(Запрос.Текст, "#СводноМинус") Тогда
		СравнениеИтогаСНулем = "Меньше";
		стрТекстСлужебнойКоманды = "#СводноМинус";
		
	КонецЕсли;
	
	Если стрТекстСравнения = Неопределено Тогда
		Если ЗначениеЗаполнено(стрТекстСлужебнойКоманды) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, стрТекстСлужебнойКоманды, "");
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	стрОтборВиртТекущий = СтрЗаменить(стрОтборВирт, стрТекстСлужебнойКоманды, "");
	
	// запомним текущий текст запроса
	ТекстЗапроса = Запрос.Текст;
	
	// сформируем запрос для определения мЗначенияДляОтбораПоСубконто
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	тзТаблицаСчетов.Счет,
	|	тзТаблицаСчетов.ЗнакОперации,
	|	тзТаблицаСчетов.ИмяРеквизитаСуммы
	|ПОМЕСТИТЬ ВТ_тзТаблицаСчетов
	|ИЗ
	|	&тзТаблицаСчетов КАК тзТаблицаСчетов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.Сумма,
	|	ВложенныйЗапрос.Субконто
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВложенныйЗапрос.Субконто КАК Субконто,
	|		СУММА(ВложенныйЗапрос.Сумма) КАК Сумма
	|	ИЗ
	|		(ВЫБРАТЬ
	|			ВЫБОР";
	
	Если ВариантОтборов = "ДоговорЦенныеБумаги" Тогда
		мВидыСправочниковДляОтбора = Новый Массив;
		//!!!!!!
		//мВидыСправочниковДляОтбора.Добавить("ЦенныеБумаги");
		//мВидыСправочниковДляОтбора.Добавить("ДоговорыКонтрагентов");
		
		мВидыСправочниковДляОтбора.Добавить("Договоры");
		мВидыСправочниковДляОтбора.Добавить("ДоговорыБрокерскогоОбслуживания");
		мВидыСправочниковДляОтбора.Добавить("Акции");
		мВидыСправочниковДляОтбора.Добавить("Облигации");
		мВидыСправочниковДляОтбора.Добавить("Паи");
		мВидыСправочниковДляОтбора.Добавить("Векселя");
		мВидыСправочниковДляОтбора.Добавить("ПроизводныеФинансовыеИнструменты");
		
		Если ТипСправочникаСодержитсяВРегистреБухгалтерии("иас_ПроизводныеФинансовыеИнструменты") Тогда
			мВидыСправочниковДляОтбора.Добавить("иас_ПроизводныеФинансовыеИнструменты");
		КонецЕсли;
		
		Для Сч = 1 по КолСубконто Цикл
			
			Для Каждого ИмяСправочника из мВидыСправочниковДляОтбора Цикл
				Запрос.Текст = Запрос.Текст  + "
				|			КОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто" + Сч + " ССЫЛКА Справочник." + ИмяСправочника + "
				|					И НЕ ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто" + Сч + " = ЗНАЧЕНИЕ(Справочник." + ИмяСправочника + ".ПустаяСсылка)
				|				ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто" + Сч;
				
			КонецЦикла;
			
		КонецЦикла;
		
	ИначеЕсли ВариантОтборов = "ОСиНМА" Тогда
		мВидыСправочниковДляОтбора = Новый Массив;
		мВидыСправочниковДляОтбора.Добавить("ОсновныеСредства");
		мВидыСправочниковДляОтбора.Добавить("НематериальныеАктивы");
		
		Для Сч = 1 по КолСубконто Цикл
			
			Для Каждого ИмяСправочника из мВидыСправочниковДляОтбора Цикл
				Запрос.Текст = Запрос.Текст  + "
				|			КОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто" + Сч + " ССЫЛКА Справочник." + ИмяСправочника + "
				|				ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто" + Сч;
				
			КонецЦикла;
			
		КонецЦикла;
		
		
	ИначеЕсли ВариантОтборов = "ОФР" Тогда
		
		Для Сч = 1 по КолСубконто Цикл
			Запрос.Текст = Запрос.Текст  + "
			
			|	КОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто" + Сч + " КАК Справочник.ГруппыФинансовогоУчетаДоходовРасходов) ССЫЛКА Справочник.ГруппыФинансовогоУчетаДоходовРасходов
			|			И НЕ ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто" + Сч + " КАК Справочник.ГруппыФинансовогоУчетаДоходовРасходов) = ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаДоходовРасходов.ПустаяСсылка)
			|		ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто" + Сч;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст  + "
	
	|			ИНАЧЕ НЕОПРЕДЕЛЕНО
	|		КОНЕЦ КАК Субконто,
	|		ВЫБОР
	|			КОГДА ВТ_тзТаблицаСчетов.ИмяРеквизитаСуммы = ""СуммаНачальныйОстатокДт""
	|				ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстатокДт
	|			КОГДА ВТ_тзТаблицаСчетов.ИмяРеквизитаСуммы = ""СуммаНачальныйОстатокКт""
	|				ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстатокКт
	|			КОГДА ВТ_тзТаблицаСчетов.ИмяРеквизитаСуммы = ""СуммаОборотДт""
	|				ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаОборотДт
	|			КОГДА ВТ_тзТаблицаСчетов.ИмяРеквизитаСуммы = ""СуммаОборотКт""
	|				ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаОборотКт
	|			КОГДА ВТ_тзТаблицаСчетов.ИмяРеквизитаСуммы = ""СуммаКонечныйОстатокДт""
	|				ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстатокДт
	|			КОГДА ВТ_тзТаблицаСчетов.ИмяРеквизитаСуммы = ""СуммаКонечныйОстатокКт""
	|				ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстатокКт
	|		КОНЕЦ * ВЫБОР
	|			КОГДА ВТ_тзТаблицаСчетов.ЗнакОперации = ""-""
	|				ТОГДА -1
	|			ИНАЧЕ 1
	|		КОНЕЦ КАК Сумма
	|	ИЗ
	|		РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.ОстаткиИОбороты(&НачалоПериода, &грКонецПериода, , , Счет В ИЕРАРХИИ (&СписокСчетов), , СчетДоверительногоУправления = &СчетДоверительногоУправления " + стрОтборВиртТекущий + ") КАК ЕдиныйБухгалтерскийУчетОстаткиИОбороты
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_тзТаблицаСчетов КАК ВТ_тзТаблицаСчетов
	|			ПО ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет = ВТ_тзТаблицаСчетов.Счет) КАК ВложенныйЗапрос
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВложенныйЗапрос.Субконто) КАК ВложенныйЗапрос
	|ГДЕ
	|	ВложенныйЗапрос.Сумма " + стрТекстСравнения + "
	|	И " + стрТекстОтбораПоПустомуСубконто + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_тзТаблицаСчетов";

	// определим период:
	Если СтрЧислоВхождений(ТекстЗапроса, "&НачалоПредыдущегоПериода") > 0 ТОгда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НачалоПериода", "&НачалоПредыдущегоПериода");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КонецПериода", "&КонецПредыдущегоПериода");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&грКонецПериода", "&грКонецПредыдущегоПериода");
	КонецЕсли;
	
	тзТаблицаСчетов = Новый ТаблицаЗначений;
	тзТаблицаСчетов.Колонки.Добавить("Счет", ПланыСчетов.ТипВсеСсылки());
	тзТаблицаСчетов.Колонки.Добавить("ЗнакОперации", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1)));
	тзТаблицаСчетов.Колонки.Добавить("ИмяРеквизитаСуммы", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Для Каждого стр_мТаблицаСчетов из мТаблицаСчетов Цикл
		стр_тзТаблицаСчетов = тзТаблицаСчетов.Добавить();
		ЗаполнитьЗначенияСвойств(стр_тзТаблицаСчетов, стр_мТаблицаСчетов);
	КонецЦикла;
	
	
	Запрос.УстановитьПараметр("тзТаблицаСчетов", тзТаблицаСчетов);
	
	// сформируем массив с отбором по субконто
	мЗначенияДляОтбораПоСубконто = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Субконто");
	
	Запрос.УстановитьПараметр("мЗначенияДляОтбораПоСубконто", мЗначенияДляОтбораПоСубконто);
	
	// Вместо текста служебной команды стрТекстСлужебнойКоманды поставим условие на отбор по субконто из мЗначенияДляОтбораПоСубконто.
	
	
	стрТекстСубконто = "";
	
	Для Сч = 1 по КолСубконто Цикл
		стрТекстСубконто = стрТекстСубконто + ?(стрТекстСубконто = "", "", " ИЛИ ") + "Субконто" + Сч + " В (&мЗначенияДляОтбораПоСубконто)";
	КонецЦикла;
	
	стрТекстОтбораПоСубконто = "
	|	И (" + стрТекстСубконто + ")";
	
	// стрТекстОтбораПоСубконто = "
	// |	И (    Субконто1 В (&мЗначенияДляОтбораПоСубконто)
	// |	   ИЛИ Субконто2 В (&мЗначенияДляОтбораПоСубконто)
	// |	   ИЛИ Субконто3 В (&мЗначенияДляОтбораПоСубконто)
	// |	   )";
	
	// подменим условие
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, стрТекстСлужебнойКоманды, стрТекстОтбораПоСубконто);
	
	// вернем текст запроса
	Запрос.Текст = ТекстЗапроса;
	
КонецПроцедуры //ОтборПоСубконтоПлюсМинус

// СкорректироватьСлагаемоеНаименование_ОФР
Процедура СкорректироватьСлагаемоеНаименование_ОФР(Запрос, СлагаемоеНаименование) Экспорт
	
	Если СтрЧислоВхождений(Запрос.Текст, "ГруппыФинансовогоУчетаДоходовРасходов") > 0 Тогда
		стрЗначенияОтбора = "";
		Для Каждого эл из Запрос.Параметры.мВидыДоходовРасходовНФО Цикл
			стрЗначенияОтбора = стрЗначенияОтбора + ?(стрЗначенияОтбора = "", "", ", ") + эл;
		КонецЦикла;
		
		// если в СлагаемоеНаименование уже есть "по ОФР" уберем эту часть и правее неё
		стр = СтрЗаменить(СлагаемоеНаименование, " по ОФР", Символы.ПС);
		СлагаемоеНаименование = СтрПолучитьСтроку(стр, 1);
		
		СлагаемоеНаименование = СлагаемоеНаименование + " по ОФР " + стрЗначенияОтбора;
	КонецЕсли;
	
КонецПроцедуры //СкорректироватьСлагаемоеНаименование_ОФР

// ИменаРеквизитовФормы
Функция ИменаРеквизитовФормы(Форма) Экспорт
	
	// Возвращаемое значение функции.
	Результат = Новый Массив;
	
	Для Каждого РеквизитФормы Из Форма.ПолучитьРеквизиты() Цикл
		
		Результат.Добавить(РеквизитФормы.Имя);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// ЗаполнитьПеременныеДляОтбора
Процедура ЗаполнитьПеременныеДляОтбора(Объект, ЭтаФорма) Экспорт
	
	мРеквизитыВсеИмена = Новый Массив;
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_ВидыДоходовРасходовНФО");         //+
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_ВидыДоходовРасходовНФО_Кор");     //+
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_БНФОГруппаФинансовогоУчета");     //+
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_БНФОГруппаФинансовогоУчета_НЕ");     //+
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_ГруппаФинансовогоУчета");
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_ГруппаФинансовогоУчета_НЕ");
	
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_ДополнительнаяАналитика");
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_ДополнительнаяАналитика_НЕ");
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_КорДополнительнаяАналитика");
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_КорДополнительнаяАналитика_НЕ");
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_КорДоговорДепозитарногоОбслуживания");
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_КорДоговорДепозитарногоОбслуживания_НЕ");
	
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_ФинансовыеОрганизации");
	мРеквизитыВсеИмена.Добавить("г_стрОтбор_ФинансовыеОрганизации_НЕ");
	
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_МНО");
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_УчетныйАктивЦБРФ");
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_ДепозитныйВклад");
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_ДепозитныйВкладДолгосрочный");
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_ДепозитныйВкладКраткосрочный");
	
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_ГруппаФинансовогоУчетаКт");
	
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_ДочерниеПредприятия");
	мРеквизитыВсеИмена.Добавить("г_стрОтборВирт_ДочерниеПредприятия_НЕ");
	
	
	мРеквизитыВсеИмена.Добавить("ПроверкаПередЗаписью_ПроверкаВыполнена");   //#ПроверкаПередЗаписью
	
	мРеквизитыВсеИмена.Добавить("ОтображатьЯчейкуВЗаголовкеТаблицы");   //#ЗаголовокАктивнойЯчейки
	мРеквизитыВсеИмена.Добавить("ТекстНадписиТекущейЯчейки");   //#ЗаголовокАктивнойЯчейки
	
	мРеквизитыВсеИмена.Добавить("ОткрыватьНастройкиЯчейкиПриРасшифровке");   //#ИнтерфейсНастроек
	
	мРеквизитыФормы = ИменаРеквизитовФормы(ЭтаФорма);
	
	// добавим отсутствующие реквизиты формы
	мОтсутствующиеРеквизиты = Новый Массив;
	Для Каждого ИмяРеквизита из мРеквизитыВсеИмена Цикл
		Если мРеквизитыФормы.Найти(ИмяРеквизита) = Неопределено Тогда
			
			Если ИмяРеквизита = "ПроверкаПередЗаписью_ПроверкаВыполнена"
				или ИмяРеквизита = "ОтображатьЯчейкуВЗаголовкеТаблицы"  //#ЗаголовокАктивнойЯчейки
				или ИмяРеквизита = "ОткрыватьНастройкиЯчейкиПриРасшифровке"  //#ИнтерфейсНастроек
				Тогда
				мОтсутствующиеРеквизиты.Добавить(Новый РеквизитФормы(ИмяРеквизита, Новый ОписаниеТипов("Булево")));
				Продолжить;
			Конецесли;
			
			мОтсутствующиеРеквизиты.Добавить(Новый РеквизитФормы(ИмяРеквизита, Новый ОписаниеТипов("Строка")));
			
		КонецЕсли;
	КонецЦикла;
	
	Если мОтсутствующиеРеквизиты.Количество() > 0 Тогда
		ЭтаФорма.ИзменитьРеквизиты(мОтсутствующиеРеквизиты);
	КонецЕсли;
	
	// определим сколько субконто в плане счетов
	ИмяПланаСчетов = "Единый";
	КолСубконто = Метаданные.ПланыСчетов[ИмяПланаСчетов].МаксКоличествоСубконто;
	
	// установим переменные для отборов
	ЭтаФорма.г_стрОтборВирт_ВидыДоходовРасходовНФО_Кор = г_стрОтборВирт_ВидыДоходовРасходовНФО_Кор(КолСубконто);
	ЭтаФорма.г_стрОтборВирт_ВидыДоходовРасходовНФО = СтрЗаменить(ЭтаФорма.г_стрОтборВирт_ВидыДоходовРасходовНФО_Кор, "КорСубконто", "Субконто");
	
	ЭтаФорма.г_стрОтборВирт_МНО = г_стрОтборВирт_МНО();
	ЭтаФорма.г_стрОтборВирт_УчетныйАктивЦБРФ = г_стрОтборВирт_УчетныйАктивЦБРФ();
	ЭтаФорма.г_стрОтборВирт_ДепозитныйВклад = г_стрОтборВирт_ДепозитныйВклад();	
	ЭтаФорма.г_стрОтборВирт_ДепозитныйВкладДолгосрочный = г_стрОтборВирт_ДепозитныйВкладДолгосрочный();	
	ЭтаФорма.г_стрОтборВирт_ДепозитныйВкладКраткосрочный = г_стрОтборВирт_ДепозитныйВкладКраткосрочный();	
	
	ЭтаФорма.г_стрОтборВирт_ДополнительнаяАналитика = г_стрОтборВирт_ДополнительнаяАналитика();	
	ЭтаФорма.г_стрОтборВирт_ДополнительнаяАналитика_НЕ = г_стрОтборВирт_ДополнительнаяАналитика_НЕ();	
	ЭтаФорма.г_стрОтборВирт_КорДополнительнаяАналитика = г_стрОтборВирт_КорДополнительнаяАналитика();	
	ЭтаФорма.г_стрОтборВирт_КорДополнительнаяАналитика_НЕ = г_стрОтборВирт_КорДополнительнаяАналитика_НЕ();
	ЭтаФорма.г_стрОтборВирт_КорДоговорДепозитарногоОбслуживания = г_стрОтборВирт_КорДоговорДепозитарногоОбслуживания();	
	ЭтаФорма.г_стрОтборВирт_КорДоговорДепозитарногоОбслуживания_НЕ = г_стрОтборВирт_КорДоговорДепозитарногоОбслуживания_НЕ();
	
	ЭтаФорма.г_стрОтбор_ФинансовыеОрганизации = г_стрОтбор_ФинансовыеОрганизации();
	ЭтаФорма.г_стрОтбор_ФинансовыеОрганизации_НЕ = г_стрОтбор_ФинансовыеОрганизации_НЕ();
	
	ЭтаФорма.г_стрОтбор_ДочерниеПредприятия = г_стрОтбор_ДочерниеПредприятия();
	ЭтаФорма.г_стрОтбор_ДочерниеПредприятия_НЕ = г_стрОтбор_ДочерниеПредприятия_НЕ();
	
	/////////////////////  Для активизации ячейки и отображения имени текущей ячейки.
	// Подключим обработчик события для каждого табличного поля.
	Для Каждого Элемент из ЭтаФорма.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ПолеФормы")
			И Лев(Элемент.Имя, 17) = "ТабличныйДокумент"
			Тогда
			Элемент.УстановитьДействие("ПриАктивизацииОбласти", "ТабличныйДокументПриАктивизацииОбласти");
		КонецЕсли;
		
	КонецЦикла;
	
	// #ЗаголовокАктивнойЯчейки
	Если ЭтаФорма.Элементы.Найти("ОтображатьЯчейкуВЗаголовкеТаблицы") = Неопределено Тогда
		// добавим элемент формы
		НовыйЭлемент = ЭтаФорма.Элементы.Вставить("ОтображатьЯчейкуВЗаголовкеТаблицы", Тип("ПолеФормы"), ЭтаФорма.Элементы.Настройка, ЭтаФорма.Элементы.ГруппаИзмерение);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
		НовыйЭлемент.ПутьКДанным = "ОтображатьЯчейкуВЗаголовкеТаблицы";
		НовыйЭлемент.Заголовок = "Отображать имя текущей ячейки";
	КонецЕсли;
	
	// #ЗаголовокАктивнойЯчейки
	Если ЭтаФорма.Элементы.Найти("ТекстНадписиТекущейЯчейки") = Неопределено Тогда
		НовыйЭлемент = ЭтаФорма.Элементы.Добавить("ТекстНадписиТекущейЯчейки", Тип("ПолеФормы"), ЭтаФорма.Элементы.ГруппаПериод);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеНадписи;
		НовыйЭлемент.ПутьКДанным = "ТекстНадписиТекущейЯчейки";
		НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	КонецЕсли;
		
	// Если у страниц есть группировка: "горизонтальная, если возможно", сменим её на "вертикальная"
	Для Каждого Элемент из ЭтаФорма.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ГруппаФормы")
			и (Элемент.Вид = ВидГруппыФормы.Страница или Элемент.Имя = "ГруппаНастройкиЗаполнения")
			Тогда
			Элемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры //ЗаполнитьПеременныеДляОтбора

// ЗаполнитьСтруктуруПеременныхДляОтбора
Процедура ЗаполнитьСтруктуруПеременныхДляОтбора(СтруктураПеременных) Экспорт
	
	СтруктураПеременных = Новый Структура;
	
	// определим сколько субконто в плане счетов
	ИмяПланаСчетов = "Единый";
	КолСубконто = Метаданные.ПланыСчетов[ИмяПланаСчетов].МаксКоличествоСубконто;
	
	// установим переменные для отборов
	СтруктураПеременных.Вставить("ВидыДоходовРасходовНФО_Кор", г_стрОтборВирт_ВидыДоходовРасходовНФО_Кор(КолСубконто));
	СтруктураПеременных.Вставить("ВидыДоходовРасходовНФО", СтрЗаменить(СтруктураПеременных.ВидыДоходовРасходовНФО_Кор, "КорСубконто", "Субконто"));
	
	СтруктураПеременных.Вставить("МНО", г_стрОтборВирт_МНО());
	СтруктураПеременных.Вставить("УчетныйАктивЦБРФ", г_стрОтборВирт_УчетныйАктивЦБРФ());
	СтруктураПеременных.Вставить("ДепозитныйВклад", г_стрОтборВирт_ДепозитныйВклад());	
	СтруктураПеременных.Вставить("ДепозитныйВкладДолгосрочный", г_стрОтборВирт_ДепозитныйВкладДолгосрочный());	
	СтруктураПеременных.Вставить("ДепозитныйВкладКраткосрочный", г_стрОтборВирт_ДепозитныйВкладКраткосрочный());	
	СтруктураПеременных.Вставить("ФьючерсРасчетный", г_стрОтборВирт_ФьючерсРасчетный());	
	СтруктураПеременных.Вставить("ФьючерсПоставочный", г_стрОтборВирт_ФьючерсПоставочный());	
	
	СтруктураПеременных.Вставить("ДополнительнаяАналитика", г_стрОтборВирт_ДополнительнаяАналитика());	
	СтруктураПеременных.Вставить("ДополнительнаяАналитика_НЕ", г_стрОтборВирт_ДополнительнаяАналитика_НЕ());	
	СтруктураПеременных.Вставить("КорДополнительнаяАналитика", г_стрОтборВирт_КорДополнительнаяАналитика());	
	СтруктураПеременных.Вставить("КорДополнительнаяАналитика_НЕ", г_стрОтборВирт_КорДополнительнаяАналитика_НЕ());
	СтруктураПеременных.Вставить("КорДоговорДепозитарногоОбслуживания", г_стрОтборВирт_КорДоговорДепозитарногоОбслуживания());	
	СтруктураПеременных.Вставить("КорДоговорДепозитарногоОбслуживания_НЕ", г_стрОтборВирт_КорДоговорДепозитарногоОбслуживания_НЕ());
	
	СтруктураПеременных.Вставить("ФинансовыеОрганизации", г_стрОтбор_ФинансовыеОрганизации());
	СтруктураПеременных.Вставить("ФинансовыеОрганизации_НЕ", г_стрОтбор_ФинансовыеОрганизации_НЕ());
	
	СтруктураПеременных.Вставить("ДочерниеПредприятия", г_стрОтбор_ДочерниеПредприятия());
