
#Область ОКУД0420401

Функция ОКУД0420401_РассчитатьКатегориюПрофУчастникаНаОснованииКвартальныхПоказателей(Параметры, Отказ) Экспорт

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДатаРасчета",			Параметры.ДатаРасчета);
	Запрос.УстановитьПараметр("Организация",			Параметры.Организация);
	Запрос.УстановитьПараметр("ЮрФизЛицоОрганизации",	Параметры.Организация.ЮрФизЛицо);
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ОКУД0420401_ПолучитьТаблицуКвартальныхПоказателей(), "_ВидыПоказателей", Запрос); 
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаРасчета, МЕСЯЦ, -13), КВАРТАЛ), ДЕНЬ) КАК Дата
		|ПОМЕСТИТЬ _КонцыКварталов
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаРасчета, МЕСЯЦ, -10), КВАРТАЛ), ДЕНЬ)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаРасчета, МЕСЯЦ, -7), КВАРТАЛ), ДЕНЬ)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаРасчета, МЕСЯЦ, -4), КВАРТАЛ), ДЕНЬ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КонцыКварталов.Дата КАК Дата,
		|	МАКСИМУМ(ЕСТЬNULL(СтатусыЛицензий.Статус, """") = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)) КАК Действует
		|ПОМЕСТИТЬ _ДействиеЛицензий
		|ИЗ
		|	_КонцыКварталов КАК _КонцыКварталов
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_КонцыКварталов.Дата КАК Дата,
		|			СтатусыЛицензий.Лицензия КАК Лицензия,
		|			МАКСИМУМ(СтатусыЛицензий.Период) КАК ДатаСтатусаЛицензии
		|		ИЗ
		|			_КонцыКварталов КАК _КонцыКварталов
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий КАК СтатусыЛицензий
		|				ПО (СтатусыЛицензий.Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами))
		|					И (СтатусыЛицензий.Лицензия.ЮрФизЛицо = &ЮрФизЛицоОрганизации)
		|					И _КонцыКварталов.Дата >= СтатусыЛицензий.Период
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_КонцыКварталов.Дата,
		|			СтатусыЛицензий.Лицензия) КАК ВложенныйЗапрос
		|		ПО _КонцыКварталов.Дата = ВложенныйЗапрос.Дата
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий КАК СтатусыЛицензий
		|		ПО (ВложенныйЗапрос.Лицензия = СтатусыЛицензий.Лицензия)
		|			И (ВложенныйЗапрос.ДатаСтатусаЛицензии = СтатусыЛицензий.Период)
		|
		|СГРУППИРОВАТЬ ПО
		|	_КонцыКварталов.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗНАЧЕНИЕ(Перечисление.КатегорииПрофессиональныхУчастниковРынкаЦенныхБумаг.Малый) КАК Категория,
		|	1 КАК Значение
		|ПОМЕСТИТЬ _КатегорииПрофУчастников
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Перечисление.КатегорииПрофессиональныхУчастниковРынкаЦенныхБумаг.Средний),
		|	2
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Перечисление.КатегорииПрофессиональныхУчастниковРынкаЦенныхБумаг.Крупный),
		|	3
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДействиеЛицензий.Дата КАК Дата,
		|	_ДействиеЛицензий.Действует КАК ЛицензияДействует,
		|	_ВидыПоказателей.НомерСтроки КАК НомерСтроки,
		|	_ВидыПоказателей.ВидПоказателя КАК ВидПоказателя,
		|	_ВидыПоказателей.ДатаНачала КАК ВидПоказателяДатаНачала,
		|	_ВидыПоказателей.ДатаОкончания КАК ВидПоказателяДатаОкончания,
		|	ФинансовыеПоказатели.Значение КАК ЗначениеПоказателя,
		|	_КатегорииПрофУчастников.Категория КАК Категория,
		|	_КатегорииПрофУчастников.Значение КАК ЗначениеКатегории
		|ПОМЕСТИТЬ _Расшифровка
		|ИЗ
		|	_ДействиеЛицензий КАК _ДействиеЛицензий
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВидыПоказателей КАК _ВидыПоказателей
		|		ПО (_ВидыПоказателей.ДатаНачала <= _ДействиеЛицензий.Дата)
		|			И (_ВидыПоказателей.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ _ВидыПоказателей.ДатаОкончания >= _ДействиеЛицензий.Дата)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО _ДействиеЛицензий.Дата = ФинансовыеПоказатели.Период
		|			И (ФинансовыеПоказатели.Организация = &Организация)
		|			И (_ВидыПоказателей.ВидПоказателя = ФинансовыеПоказатели.ВидПоказателя)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КатегорииПрофУчастников КАК _КатегорииПрофУчастников
		|		ПО (ВЫБОР
		|				КОГДА ФинансовыеПоказатели.Значение > _ВидыПоказателей.ВерхняяГраница
		|					ТОГДА 3
		|				КОГДА ФинансовыеПоказатели.Значение > _ВидыПоказателей.НижнняГраница
		|					ТОГДА 2
		|				ИНАЧЕ 1
		|			КОНЕЦ = _КатегорииПрофУчастников.Значение)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.Дата КАК Дата,
		|	ВложенныйЗапрос.ЛицензияДействует КАК ЛицензияДействует,
		|	_КатегорииПрофУчастников.Категория КАК КатегорияПроцУчастника
		|ПОМЕСТИТЬ _КвартальныеПоказатели
		|ИЗ
		|	(ВЫБРАТЬ
		|		_Расшифровка.Дата КАК Дата,
		|		_Расшифровка.ЛицензияДействует КАК ЛицензияДействует,
		|		МАКСИМУМ(_Расшифровка.ЗначениеКатегории) КАК ЗначениеКатегории
		|	ИЗ
		|		_Расшифровка КАК _Расшифровка
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_Расшифровка.Дата,
		|		_Расшифровка.ЛицензияДействует) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КатегорииПрофУчастников КАК _КатегорииПрофУчастников
		|		ПО ВложенныйЗапрос.ЗначениеКатегории = _КатегорииПрофУчастников.Значение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КвартальныеПоказатели.КатегорияПроцУчастника КАК КатегорияПроцУчастника,
		|	1 КАК НомерАбзаца481П
		|ПОМЕСТИТЬ _Результат
		|ИЗ
		|	_КвартальныеПоказатели КАК _КвартальныеПоказатели
		|ГДЕ
		|	_КвартальныеПоказатели.ЛицензияДействует
		|
		|СГРУППИРОВАТЬ ПО
		|	_КвартальныеПоказатели.КатегорияПроцУчастника
		|
		|ИМЕЮЩИЕ
		|	СУММА(1) >= 3
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_КвартальныеПоказатели.КатегорияПроцУчастника,
		|	2
		|ИЗ
		|	_КвартальныеПоказатели КАК _КвартальныеПоказатели
		|ГДЕ
		|	_КвартальныеПоказатели.ЛицензияДействует
		|	И КВАРТАЛ(_КвартальныеПоказатели.Дата) В (2, 3)
		|
		|СГРУППИРОВАТЬ ПО
		|	_КвартальныеПоказатели.КатегорияПроцУчастника
		|
		|ИМЕЮЩИЕ
		|	СУММА(1) = 2
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_КвартальныеПоказатели.КатегорияПроцУчастника,
		|	3
		|ИЗ
		|	_КвартальныеПоказатели КАК _КвартальныеПоказатели
		|ГДЕ
		|	_КвартальныеПоказатели.ЛицензияДействует
		|	И КВАРТАЛ(_КвартальныеПоказатели.Дата) В (1, 2, 3)
		|
		|СГРУППИРОВАТЬ ПО
		|	_КвартальныеПоказатели.КатегорияПроцУчастника
		|
		|ИМЕЮЩИЕ
		|	СУММА(1) = 2
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_КвартальныеПоказатели.КатегорияПроцУчастника,
		|	4
		|ИЗ
		|	_КвартальныеПоказатели КАК _КвартальныеПоказатели
		|ГДЕ
		|	_КвартальныеПоказатели.ЛицензияДействует
		|	И КВАРТАЛ(_КвартальныеПоказатели.Дата) = 3
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Перечисление.КатегорииПрофессиональныхУчастниковРынкаЦенныхБумаг.Малый),
		|	5
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК НаименованиеОрганизации
		|ПОМЕСТИТЬ _РеквизитыОрганизации
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&ДатаРасчета,
		|			Организация = &Организация
		|				И ЮрФизЛицо = &ЮрФизЛицоОрганизации
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних";
	
#КонецОбласти	

	Запрос.Выполнить();

	Расшифровка = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Расшифровка").ПолучитьДанные().Выгрузить();
	Расшифровка.Сортировать("Дата Убыв, НомерСтроки");
	
	Для Каждого СтрокаКвартальныхПоказателей Из Расшифровка Цикл
		Если СтрокаКвартальныхПоказателей.ЛицензияДействует И СтрокаКвартальныхПоказателей.ЗначениеПоказателя = Null Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон("Не зарегистрирован показатель %1 на %2",
					СтрокаКвартальныхПоказателей.ВидПоказателя,
					Формат(СтрокаКвартальныхПоказателей.Дата, "ДФ=dd.MM.yyyy")),,,, Отказ);
		КонецЕсли;
	КонецЦикла;	
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВидыПоказателей = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ВидыПоказателей").ПолучитьДанные().Выгрузить();
	ВидыПоказателей.Сортировать("НомерСтроки");
	
	Для Каждого СтрокаВидыПоказателей Из ВидыПоказателей Цикл
		Если Расшифровка.НайтиСтроки(Новый Структура("ВидПоказателя, ВидПоказателяДатаНачала, ВидПоказателяДатаОкончания", СтрокаВидыПоказателей.ВидПоказателя, СтрокаВидыПоказателей.ДатаНачала, СтрокаВидыПоказателей.ДатаОкончания)).Количество() = 0 Тогда
			ВидыПоказателей.Удалить(СтрокаВидыПоказателей);
		КонецЕсли;
	КонецЦикла;
	
	РезультатРасчета = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Результат").ПолучитьДанные().Выгрузить();
	РезультатРасчета.Сортировать("НомерАбзаца481П");
	
#Область Абзацы481П
	СопоставленияКвартальныхДиапазонов = Новый Соответствие;
	СопоставленияКвартальныхДиапазонов.Вставить(1, "Лицензиатом определен один квартальный диапазон не менее чем в трех из четырех кварталов, предшествующих четвертому кварталу текущего календарного года, указанный диапазон значений показателей является для него годовым диапазоном;");
	СопоставленияКвартальныхДиапазонов.Вставить(2, "Лицензиатом определен один квартальный диапазон в двух кварталах, предшествующих четвертому кварталу текущего календарного года, указанный диапазон значений показателей является для него годовым диапазоном;");
	СопоставленияКвартальныхДиапазонов.Вставить(3, "Лицензиатом определен один квартальный диапазон в двух из трех кварталов, предшествующих четвертому кварталу текущего календарного года, указанный диапазон значений показателей является для него годовым диапазоном;");
	СопоставленияКвартальныхДиапазонов.Вставить(4, "Лицензиатом определен один квартальный диапазон в квартале, предшествующем дате определения значений показателей, указанный диапазон значений показателей является для него годовым диапазоном;");
	СопоставленияКвартальныхДиапазонов.Вставить(5, "Лицензиатом не был определен ни один квартальный диапазон;");
#КонецОбласти	

#Область Описание5009У
	Описание5009У = Новый Соответствие;
	Описание5009У.Вставить(Перечисления.КатегорииПрофессиональныхУчастниковРынкаЦенныхБумаг.Крупный, "Лицензиат определил хотя бы по одному из показателей, установленных в графе 2 приложения к Положению Банка России от 27 июля 2015 года N 481-П ""О лицензионных требованиях и условиях осуществления профессиональной деятельности на рынке ценных бумаг, ограничениях на совмещение отдельных видов профессиональной деятельности на рынке ценных бумаг, а также о порядке и сроках представления в Банк России отчетов о прекращении обязательств, связанных с осуществлением профессиональной деятельности на рынке ценных бумаг, в случае аннулирования лицензии профессионального участника рынка ценных бумаг"", зарегистрированному Министерством юстиции Российской Федерации 25 августа 2015 года N 38673, 29 июля 2016 года N 43030, 20 октября 2017 года N 48630, 22 января 2019 года N 53485, 26 января 2021 года N 62231 (далее соответственно - показатели деятельности, Положение Банка России N 481-П), в качестве годового диапазона значений показателей деятельности для каждого из осуществляемых профессиональным участником лицензируемых видов профессиональной деятельности на рынке ценных бумаг (далее - годовой диапазон) квартальный диапазон, указанный в графе 5 приложения к Положению Банка России N 481-П.");
	Описание5009У.Вставить(Перечисления.КатегорииПрофессиональныхУчастниковРынкаЦенныхБумаг.Средний, "Лицензиат определил хотя бы по одному из показателей деятельности в качестве годового диапазона квартальный диапазон, указанный в графе 4 приложения к Положению Банка России N 481-П, и не определившие ни по одному из показателей деятельности в качестве годового диапазона квартальный диапазон, указанный в графе 5 приложения к Положению Банка России N 481-П.");
	Описание5009У.Вставить(Перечисления.КатегорииПрофессиональныхУчастниковРынкаЦенныхБумаг.Малый, "Лицензиат не определил ни по одному из показателей деятельности в качестве годового диапазона квартальный диапазон, указанный в графах 4 и 5 приложения к Положению Банка России N 481-П.");
#КонецОбласти
	
	РеквизитыОрганизации = Новый Структура("НаименованиеОрганизации");
	Таблица_РеквизитыОрганизации = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_РеквизитыОрганизации").ПолучитьДанные().Выгрузить();
	Если Таблица_РеквизитыОрганизации.Количество() Тогда
		ЗаполнитьЗначенияСвойств(РеквизитыОрганизации, Таблица_РеквизитыОрганизации[0]);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствует анкета юр. лица ораганизации");
	КонецЕсли;
	
	Результат = Новый Структура;
	
	Результат.Вставить("ВидПоказателя", 			Справочники.ВидыФинансовыхПоказателей.КатегорияПрофессиональногоУчастникаРынкаЦенныхБумаг);
	Результат.Вставить("Значение",					РезультатРасчета[0].КатегорияПроцУчастника);
	Результат.Вставить("Описание481П",				СопоставленияКвартальныхДиапазонов.Получить(РезультатРасчета[0].НомерАбзаца481П));
	Результат.Вставить("Описание5709У",				Описание5009У.Получить(РезультатРасчета[0].КатегорияПроцУчастника));
	Результат.Вставить("ПредыдущийГод",				Формат(ДобавитьМесяц(Параметры.ДатаРасчета, -12), "ДФ=yyyy"));
	Результат.Вставить("ВидыПоказателей",			ВидыПоказателей);
	Результат.Вставить("Расшифровка",				Расшифровка);
	Результат.Вставить("РеквизитыОрганизации",		РеквизитыОрганизации);

	Возврат Результат;

КонецФункции

Функция ОКУД0420401_ПолучитьКатегориюПрофУчастника(Параметры, Отказ) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ДатаНачала",	 Параметры.Период.ДатаНачала);
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПоказателиДеятельности.КатегорияПрофУчастника КАК КатегорияПрофУчастника
		|ИЗ
		|	РегистрСведений.ПоказателиДеятельности КАК ПоказателиДеятельности
		|ГДЕ
		|	ПоказателиДеятельности.Период = НАЧАЛОПЕРИОДА(&ДатаНачала, ГОД)
		|	И ПоказателиДеятельности.Активность
		|	И ПоказателиДеятельности.Организация = &Организация";
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КатегорияПрофУчастника;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Категория профессионального учатника (показатель деятельности) не зарегистрирована на %1 год", Формат(Параметры.Период.ДатаНачала, "ДФ=yyyy")),,,, Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции	

