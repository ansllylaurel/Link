#Область ОКУД0420431
Функция ВерсияТаксономииОтчетаПоДате(ИмяПакета, ДатаОтчета, Организация) Экспорт
	
	ОтчетностьЦБ = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьОбъектВнешнейОбработки("_ОтчетностьЦБ");

	ОтчетностьЦБ.Организация = Организация;
	ОтчетностьЦБ.Период		 = ДатаОтчета;
	
	ТочкиВхода = ОтчетностьЦБ.ПолучитьТочкиВхода();
	
	ПараметрыПоиска = Новый Структура("ИмяПакета, Спецдеп", ИмяПакета, Ложь);
	НайденныеСтроки = ТочкиВхода.НайтиСтроки(ПараметрыПоиска);
	
	ВерсияТаксономии = "";
	
	Для Каждого СтрокаТочкиВхода Из НайденныеСтроки Цикл
		Если СтрокаТочкиВхода.Период <= ДатаОтчета Тогда
			Если ЗначениеЗаполнено(СтрокаТочкиВхода.ВерсияТаксономии) Тогда
				ВерсияТаксономии = СтрокаТочкиВхода.ВерсияТаксономии;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВерсияТаксономии;

КонецФункции

Процедура ОКУД0420431_ЗаполнитьПараметрДляПоказаВыводаАктивовПоСчетуДУ(Запрос)
	
	СчетаДУДляПоказаИзъятия = Новый ТаблицаЗначений;
	СчетаДУДляПоказаИзъятия.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	СчетаДУДляПоказаИзъятия.Колонки.Добавить("ДоходностьПоСтратегии",        Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 2)));
	
	Если Запрос.Параметры.ДатаОкончания = Дата(2025, 6, 30, 23, 59, 59) Тогда
		
		НоваяСтрока = СчетаДУДляПоказаИзъятия.Добавить();
		НоваяСтрока.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_СМАО");
		НоваяСтрока.ДоходностьПоСтратегии        = 19.02;
		
	КонецЕсли;	
	Запрос.УстановитьПараметр("СДУДляИзъятия", СчетаДУДляПоказаИзъятия);
	
КонецПроцедуры

Процедура ОКУД0420431_ВыполнитьЗапросы(Параметры, Запрос, Отказ) Экспорт
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(
		Запрос.МенеджерВременныхТаблиц,
		Новый СтандартныйПериод(Параметры.Период.ДатаНачала - 86400, Параметры.Период.ДатаОкончания + 86400), //захватим день до и день после, чтобы понимать были ли они клиентами вне отчётного периода
		Новый Структура("Организация, ВидДеятельности", Параметры.Организация, Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами),
		"_СчетаДоверительногоУправления_С_Датами");

	РаботаСОтчетами.ПоместитьДатыПолученияДокументовОСмертиВМенеджерВременныхТаблиц(Запрос, Параметры.Период.ДатаОкончания, Параметры.Организация, , "_ДатыПолученияДокументовОСмерти");
		
	ЗаполнитьТаблицуКодыКлиентовПоОКАТО(Параметры, Запрос.МенеджерВременныхТаблиц);

	Запрос.УстановитьПараметр("ДатаНачала",				Параметры.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",			Параметры.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ГраницаОкончания",		Новый Граница(Параметры.Период.ДатаОкончания, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",			Параметры.Организация);
	Запрос.УстановитьПараметр("НКО_НКЦ",				ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ"));		
	Запрос.УстановитьПараметр("ЭтоРПИ",					Параметры.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ"));		
	
	Запрос.УстановитьПараметр("УчитываласьДатаОкончанияИнтервалаПриРасчетеГоризонта", Параметры.Период.ДатаОкончания >= Дата(2024, 6, 30));
	
	
	Если НЕ Запрос.Параметры.Свойство("ЕстьРаздел_SR_0420459") Тогда
		Запрос.УстановитьПараметр("ЕстьРаздел_SR_0420459", Ложь);
	КонецЕсли;
	
	Если НЕ Запрос.Параметры.Свойство("РазмерыСчетовКлиентов") Тогда
		
		РазмерыСчетовКлиентов = Новый ТаблицаЗначений;
		РазмерыСчетовКлиентов.Колонки.Добавить("Идентификатор",	 Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
		РазмерыСчетовКлиентов.Колонки.Добавить("Наименование",	 Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
		РазмерыСчетовКлиентов.Колонки.Добавить("НижняяГраница",	 Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 2)));
		РазмерыСчетовКлиентов.Колонки.Добавить("ВерхняяГраница", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 2)));
		
		Запрос.УстановитьПараметр("РазмерыСчетовКлиентов", РазмерыСчетовКлиентов);
		
	КонецЕсли;	
		
	РынкиЦенныхБумагОтработанныеВОтчете = Новый Массив;
	РынкиЦенныхБумагОтработанныеВОтчете.Добавить(Перечисления.РынкиЦенныхБумаг.Акции);
	РынкиЦенныхБумагОтработанныеВОтчете.Добавить(Перечисления.РынкиЦенныхБумаг.Облигации);
	РынкиЦенныхБумагОтработанныеВОтчете.Добавить(Перечисления.РынкиЦенныхБумаг.Векселя);
	РынкиЦенныхБумагОтработанныеВОтчете.Добавить(Перечисления.РынкиЦенныхБумаг.Паи);
	
	РынкиЦенныхБумагПФИ = Новый Массив;
	РынкиЦенныхБумагПФИ.Добавить(Перечисления.РынкиЦенныхБумаг.Опционы);
	РынкиЦенныхБумагПФИ.Добавить(Перечисления.РынкиЦенныхБумаг.Фьючерсы);
	
	Запрос.УстановитьПараметр("РынкиЦенныхБумагОтработанныеВОтчете", РынкиЦенныхБумагОтработанныеВОтчете);
	Запрос.УстановитьПараметр("РынкиЦенныхБумагПФИ", РынкиЦенныхБумагПФИ);
	
	Если Не Запрос.Параметры.Свойство("ВерсияТаксономии") Тогда
		
		ВерсияТаксономии = ВерсияТаксономииОтчетаПоДате("ОКУД0420431", Запрос.Параметры.ДатаОкончания, Параметры.Организация); 
		
		Запрос.УстановитьПараметр("ВерсияТаксономии", ВерсияТаксономии); 
		
	КонецЕсли;	

	ОКУД0420431_ЗаполнитьПараметрДляПоказаВыводаАктивовПоСчетуДУ(Запрос);
	
	#Область Текст_запроса
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СДУДляИзъятия.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СДУДляИзъятия.ДоходностьПоСтратегии КАК ДоходностьПоСтратегии
		|ПОМЕСТИТЬ _СДУПоказатьИзъятиеСЧАПредварительная
		|ИЗ
		|	&СДУДляИзъятия КАК СДУДляИзъятия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_СДУПоказатьИзъятиеСЧАПредварительная.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_СДУПоказатьИзъятиеСЧАПредварительная.ДоходностьПоСтратегии КАК ДоходностьПоСтратегии
		|ПОМЕСТИТЬ _СДУПоказатьИзъятиеСЧА
		|ИЗ
		|	_СДУПоказатьИзъятиеСЧАПредварительная КАК _СДУПоказатьИзъятиеСЧАПредварительная
		|ГДЕ
		|	_СДУПоказатьИзъятиеСЧАПредварительная.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				_СчетаДоверительногоУправления_С_Датами.Ссылка
		|			ИЗ
		|				_СчетаДоверительногоУправления_С_Датами КАК _СчетаДоверительногоУправления_С_Датами)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЛицензииДоговоровДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЛицензииДоговоровДоверительногоУправления.Период КАК Период,
		|	ЛицензииДоговоровДоверительногоУправления.Лицензия КАК Лицензия
		|ПОМЕСТИТЬ _ДатыОкончанияЛицензииДУ
		|ИЗ
		|	РегистрСведений.ЛицензииДоговоровДоверительногоУправления КАК ЛицензииДоговоровДоверительногоУправления
		|ГДЕ
		|	НЕ ЛицензииДоговоровДоверительногоУправления.Действует
		|	И ЛицензииДоговоровДоверительногоУправления.Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами)
		|	И ЛицензииДоговоровДоверительногоУправления.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ЛицензииДоговоровДоверительногоУправления.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				_СчетаДоверительногоУправления_С_Датами.Ссылка
		|			ИЗ
		|				_СчетаДоверительногоУправления_С_Датами КАК _СчетаДоверительногоУправления_С_Датами)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДатыОкончанияЛицензии.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	МАКСИМУМ(ФинансовыеПоказателиСЧА.Период) КАК Период
