		|	ГДЕ
		|		ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|		И ДЕНЬ(ДанныеКалендаря.Дата) = 29
		|		И МЕСЯЦ(ДанныеКалендаря.Дата) = 2
		|		И ДанныеКалендаря.Дата < &ДатаОкончания) КАК Последнее29Февраля
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеОтчета.ЮрЛицо КАК ЮрЛицо,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
		|			КОГДА _ДанныеОтчета.УчитыватьВКоличестеКлиентов
		|				ТОГДА _ДанныеОтчета.Клиент
		|		КОНЕЦ) КАК КоличествоКлиентов,
		|	_ДанныеОтчета.Активный КАК Активный,
		|	_ДанныеОтчета.КвалИнвестор КАК КвалИнвестор,
		|	_ДанныеОтчета.РезидентРФ КАК РезидентРФ,
		|	СУММА(_ДанныеОтчета.СЧА) КАК Сумма
		|ПОМЕСТИТЬ _ПечатнаяФорма21
		|ИЗ
		|	_ДанныеОтчета КАК _ДанныеОтчета
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДанныеОтчета.ЮрЛицо,
		|	_ДанныеОтчета.РезидентРФ,
		|	_ДанныеОтчета.КвалИнвестор,
