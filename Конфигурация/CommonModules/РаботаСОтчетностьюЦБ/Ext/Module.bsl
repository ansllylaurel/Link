		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Договоры.Ссылка КАК Договор,
		|	РеквизитыАудитора.ПолноеНаименованиеПоУставу КАК ПолноеНаименование,
		|	ДокументыЮридическихЛицСрезПоследних.Номер КАК ОГРН,
		|	РеквизитыАудитора.ИНН КАК ИНН,
		|	РеквизитыСРО.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеСРО,
		|	ГосударственныйРеестрСРО.НомерВРеестре КАК НомерСРО,
		|	РеестрАудиторов.НомерВРеестре КАК НомерАудитораВРеестреСРО
		|ПОМЕСТИТЬ _РеквизитыАудитора
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ДатаОкончания, Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = Договоры.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыАудитора
		|		ПО Договоры.Контрагент = РеквизитыАудитора.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВхожденияВРеестры.СрезПоследних(&ДатаОкончания, ВидРеестра = ЗНАЧЕНИЕ(Справочник.ВидыРеестров.СРОАудиторов)) КАК РеестрАудиторов
		|		ПО (РеестрАудиторов.ЮрФизЛицо = Договоры.Контрагент)
		|			И (НЕ РеестрАудиторов.ИсключенИзРеестра)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВхожденияВРеестры.СрезПоследних(&ДатаОкончания, ВидРеестра = ЗНАЧЕНИЕ(Справочник.ВидыРеестров.ГосударственныйРеестрСаморегулируемыхОрганизацийАудиторов)) КАК ГосударственныйРеестрСРО
		|		ПО (ГосударственныйРеестрСРО.ЮрФизЛицо = РеестрАудиторов.ДержательРеестра)
		|			И (НЕ ГосударственныйРеестрСРО.ИсключенИзРеестра)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыСРО
		|		ПО (РеестрАудиторов.ДержательРеестра = РеквизитыСРО.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)) КАК ДокументыЮридическихЛицСрезПоследних
		|		ПО Договоры.Контрагент = ДокументыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|			И (ДокументыЮридическихЛицСрезПоследних.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ ДокументыЮридическихЛицСрезПоследних.ДействуетПо > &ДатаОкончания)
		|ГДЕ
		|	Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ОказанияАудиторскихУслуг)
		|	И Договоры.Организация = &Организация
		|	И Договоры.ДатаЗаключения <= &ДатаОкончания
		|	И (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения >= &ДатаНачала)
		|	И НЕ Договоры.ПометкаУдаления";
	
	Запрос.Выполнить();
	
КонецПроцедуры
	
Процедура ДобавитьДанныеДляПроверкиРеквизитовАудитора(Источник) Экспорт
	
	Если Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Свойство("ПроверкаРеквизитовАудитора") Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеДанные = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДатаНачала",			ДобавитьМесяц(ТекущаяДата(), -1)); //на сдачу отчёта 15 дней, покажем договора закрытые за последний месяц, на всякий случай
	Запрос.УстановитьПараметр("ДатаОкончания",		ТекущаяДата());
	
	Запрос.УстановитьПараметр("ОтборПоЮрФизЛицуИспользование",	Ложь);
	Запрос.УстановитьПараметр("ОтборПоЮрФизЛицуЗначение",		Новый Массив);
	
	Запрос.УстановитьПараметр("ЕстьОрганизация",				 Источник.Метаданные().Измерения.Найти("Организация") <> Неопределено);
	Запрос.УстановитьПараметр("ОтборПоОрганизацииЗначение",		 Новый Массив);
	Запрос.УстановитьПараметр("ОтборПоОрганизацииИспользование", Ложь);
	
#Область АудиторыИСРО
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Договоры.Организация КАК Организация,
		|	Договоры.Контрагент КАК Аудитор,
		|	РеестрАудиторов.ДержательРеестра КАК СРО
		|ПОМЕСТИТЬ _АудиторыИСРО
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ДатаОкончания, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = Договоры.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВхожденияВРеестры.СрезПоследних(&ДатаОкончания, ВидРеестра = ЗНАЧЕНИЕ(Справочник.ВидыРеестров.СРОАудиторов)) КАК РеестрАудиторов
		|		ПО (РеестрАудиторов.ЮрФизЛицо = Договоры.Контрагент)
		|			И (НЕ РеестрАудиторов.ИсключенИзРеестра)
		|ГДЕ
		|	Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ОказанияАудиторскихУслуг)
		|	И (&ЕстьОрганизация = ЛОЖЬ
		|			ИЛИ &ОтборПоОрганизацииИспользование = ЛОЖЬ
		|			ИЛИ Договоры.Организация В (&ОтборПоОрганизацииЗначение))
		|	И Договоры.ДатаЗаключения <= &ДатаОкончания
		|	И (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения >= &ДатаНачала)
		|	И НЕ Договоры.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_АудиторыИСРО.Организация КАК Организация,
		|	ЮрФизЛица.Ссылка КАК ЮрФизЛицо,
		|	ИСТИНА КАК ЭтоАудитор,
		|	ЗНАЧЕНИЕ(Справочник.ВидыРеестров.СРОАудиторов) КАК ВидРеестра,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации) КАК ВидДокумента,
		|	ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний) КАК Подразделение,
		|	ЗНАЧЕНИЕ(Справочник.Языки.Русский) КАК Язык,
		|	ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮридическийАдрес) КАК ВидКонтактнойИнформации
		|ПОМЕСТИТЬ _Отборы
		|ИЗ
		|	Справочник.ЮрФизЛица КАК ЮрФизЛица
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _АудиторыИСРО КАК _АудиторыИСРО
		|		ПО ЮрФизЛица.Ссылка = _АудиторыИСРО.Аудитор
		|ГДЕ
		|	(&ОтборПоЮрФизЛицуИспользование = ЛОЖЬ
		|			ИЛИ ЮрФизЛица.Ссылка В (&ОтборПоЮрФизЛицуЗначение))
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_АудиторыИСРО.Организация,
		|	ЮрФизЛица.Ссылка,
		|	ЛОЖЬ,
		|	ЗНАЧЕНИЕ(Справочник.ВидыРеестров.ГосударственныйРеестрСаморегулируемыхОрганизацийАудиторов),
		|	НЕОПРЕДЕЛЕНО,
		|	ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|	ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|	ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮридическийАдрес)
		|ИЗ
		|	Справочник.ЮрФизЛица КАК ЮрФизЛица
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _АудиторыИСРО КАК _АудиторыИСРО
		|		ПО ЮрФизЛица.Ссылка = _АудиторыИСРО.СРО
		|ГДЕ
		|	(&ОтборПоЮрФизЛицуИспользование = ЛОЖЬ
		|			ИЛИ ЮрФизЛица.Ссылка В (&ОтборПоЮрФизЛицуЗначение))";

	Для Каждого ЭлементОтбора Из Источник.Отбор Цикл
		
		Если ЭлементОтбора.Имя = "ЮрФизЛицо" Тогда
			Запрос.УстановитьПараметр("ОтборПоЮрФизЛицуИспользование",	ЭлементОтбора.Использование);
			Запрос.УстановитьПараметр("ОтборПоЮрФизЛицуЗначение",		ЭлементОтбора.Значение);
		КонецЕсли;
		
		Если ЭлементОтбора.Имя = "Организация" Тогда
			Запрос.УстановитьПараметр("ОтборПоОрганизацииИспользование",	ЭлементОтбора.Использование);
			Запрос.УстановитьПараметр("ОтборПоОрганизацииЗначение",			ЭлементОтбора.Значение);
		КонецЕсли;
		
		Если ЭлементОтбора.Имя = "Регистратор" Тогда
			Запрос.УстановитьПараметр("ОтборПоОрганизацииИспользование",	ЭлементОтбора.Использование);
			Запрос.УстановитьПараметр("ОтборПоОрганизацииЗначение",			ЭлементОтбора.Значение.Организация);
		КонецЕсли;
		
	КонецЦикла;
	
#КонецОбласти	

	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ВыполнитьЗапросКДаннымДляПроверкиРеквизитовАудитора(Источник, Запрос);
		
		ДополнительныеДанные.Вставить("Отборы",			Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("_Отборы").ПолучитьДанные().Выгрузить());
		ДополнительныеДанные.Вставить("ДанныеДоЗаписи", Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("_ДанныеРегистра").ПолучитьДанные().Выгрузить());
		
		Источник.ЗаписьИсторииДанных.ДобавитьДополнительныеДанные("ПроверкаРеквизитовАудитора", ДополнительныеДанные, "ПроверкаРеквизитовАудитора"); 
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьРезультатПроверкиРеквизитовАудитора(Источник) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(Источник.ЗаписьИсторииДанных.ДополнительныеДанные.ПроверкаРеквизитовАудитора.Отборы, "_Отборы", Запрос);
	
	ВыполнитьЗапросКДаннымДляПроверкиРеквизитовАудитора(Источник, Запрос);
	
	ДанныеРегистра = Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("_ДанныеРегистра").ПолучитьДанные().Выгрузить();
	
	МассивКолонок = Новый Массив;
	Для Каждого Колонка Из ДанныеРегистра.Колонки Цикл
		МассивКолонок.Добавить(Колонка.Имя);
	КонецЦикла;
	
	ДанныеРегистра.Колонки.Вставить(0, "ВидИзменения");
	ДанныеРегистра.ЗаполнитьЗначения(1, "ВидИзменения");
	
	Для Каждого СтрокаДанныхРегистраДоЗаписи Из Источник.ЗаписьИсторииДанных.ДополнительныеДанные.ПроверкаРеквизитовАудитора.ДанныеДоЗаписи Цикл
		СтрокаДанныхРегистра = ДанныеРегистра.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДанныхРегистра, СтрокаДанныхРегистраДоЗаписи); 
		СтрокаДанныхРегистра.ВидИзменения = -1;
	КонецЦикла;
	
	ДанныеРегистра.Свернуть(СтрСоединить(МассивКолонок, ","), "ВидИзменения");
	
	МассивСтрокДляУдаления = Новый Массив;
	МассивОрганизаций = Новый Массив;
	
	Для Каждого СтрокаДанныхРегистра Из ДанныеРегистра Цикл
		Если СтрокаДанныхРегистра.ВидИзменения = 0 Тогда
			МассивСтрокДляУдаления.Добавить(СтрокаДанныхРегистра);
		Иначе
			СтрокаДанныхРегистра.ВидИзменения = ?(СтрокаДанныхРегистра.ВидИзменения = 1, "Добавлена запись", "Удалена запись");
			Если МассивОрганизаций.Найти(СтрокаДанныхРегистра.Организация) = Неопределено Тогда
				МассивОрганизаций.Добавить(СтрокаДанныхРегистра.Организация);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого СтрокаДанныхРегистра Из МассивСтрокДляУдаления Цикл
		ДанныеРегистра.Удалить(СтрокаДанныхРегистра);
	КонецЦикла;	
	
	РезультатПроверки = Новый Массив;
	
	Если ДанныеРегистра.Количество() > 0 Тогда
		
		Для Каждого Организация Из МассивОрганизаций Цикл
			РезультатПроверкиПоОрганизации = Новый Структура;
			РезультатПроверкиПоОрганизации.Вставить("Организация",	Организация);
			РезультатПроверкиПоОрганизации.Вставить("ТелоПисьма",	ПолучитьОтчетПроверкиРеквизитовАудитора(Источник, ДанныеРегистра.Скопировать(РезультатПроверкиПоОрганизации)));
			РезультатПроверкиПоОрганизации.Вставить("Тема",			СтрШаблон("Изменились реквизиты аудитора (или СРО аудитора) по действующим договорам %1", Организация));
			
			РезультатПроверки.Добавить(РезультатПроверкиПоОрганизации);
		КонецЦикла;
		
	КонецЕсли;
	
	Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Удалить("ПроверкаРеквизитовАудитора");

	Возврат РезультатПроверки;
	
КонецФункции

Функция ПолучитьОтчетПроверкиРеквизитовАудитора(Источник, ДанныеРегистра)
	
	ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент(, , , Новый ТабличныйДокумент); 
	
	СтруктураТаблицы = Новый Структура("ВидИзменения, Период", "Вид изменения", "Период");
	
	Для Каждого Измерение Из Источник.Метаданные().Измерения Цикл
		Если ДанныеРегистра.Колонки.Найти(Измерение.Имя) <> Неопределено Тогда
			СтруктураТаблицы.Вставить(Измерение.Имя, Измерение.Синоним);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Ресурс Из Источник.Метаданные().Ресурсы Цикл
		Если ДанныеРегистра.Колонки.Найти(Ресурс.Имя) <> Неопределено Тогда
			СтруктураТаблицы.Вставить(Ресурс.Имя, Ресурс.Синоним);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Реквизит Из Источник.Метаданные().Реквизиты Цикл
		Если ДанныеРегистра.Колонки.Найти(Реквизит.Имя) <> Неопределено Тогда
			СтруктураТаблицы.Вставить(Реквизит.Имя, Реквизит.Синоним);
		КонецЕсли;
	КонецЦикла;
	
	РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(ПараметрыВывода, ДанныеРегистра, СтруктураТаблицы, "Изменились данные регистра " + Источник.Метаданные().Синоним,, Истина); 
	РаботаСОтчетами.УстановитьШиринуКолонок(ПараметрыВывода);
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("html");
	
	ПараметрыВывода.ДокументРезультат.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.HTML);
	
	ТелоПисьма = Новый ТекстовыйДокумент;
	ТелоПисьма.Прочитать(ИмяВременногоФайла);
	
	ТекстПисьма = ТелоПисьма.ПолучитьТекст();
	
	УдалитьФайлы(ИмяВременногоФайла);
	
	Возврат ТекстПисьма;
	
КонецФункции

Процедура ВыполнитьЗапросКДаннымДляПроверкиРеквизитовАудитора(Источник, Запрос)
	
	Если ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.ВхожденияВРеестры") Тогда 
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВхожденияВРеестры.Период КАК Период,
			|	_Отборы.Организация КАК Организация,
			|	ВхожденияВРеестры.ЮрФизЛицо КАК ЮрФизЛицо,
			|	ВхожденияВРеестры.ВидРеестра КАК ВидРеестра,
			|	ВхожденияВРеестры.ИсключенИзРеестра КАК ИсключенИзРеестра,
			|	ВхожденияВРеестры.ДержательРеестра КАК ДержательРеестра,
			|	ВхожденияВРеестры.НомерВРеестре КАК НомерВРеестре
			|ПОМЕСТИТЬ _ДанныеРегистра
			|ИЗ
			|	РегистрСведений.ВхожденияВРеестры КАК ВхожденияВРеестры
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Отборы КАК _Отборы
			|		ПО ВхожденияВРеестры.ЮрФизЛицо = _Отборы.ЮрФизЛицо
			|			И ВхожденияВРеестры.ВидРеестра = _Отборы.ВидРеестра";
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.ДокументыЮридическихЛиц") Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДокументыЮридическихЛиц.Период КАК Период,
			|	_Отборы.Организация КАК Организация,
			|	ДокументыЮридическихЛиц.Подразделение КАК Подразделение,
			|	ДокументыЮридическихЛиц.Язык КАК Язык,
			|	ДокументыЮридическихЛиц.ЮрФизЛицо КАК ЮрФизЛицо,
			|	ДокументыЮридическихЛиц.Вид КАК Вид,
			|	ДокументыЮридическихЛиц.ДействуетПо КАК ДействуетПо,
			|	ДокументыЮридическихЛиц.Номер КАК Номер
			|ПОМЕСТИТЬ _ДанныеРегистра
			|ИЗ
			|	РегистрСведений.ДокументыЮридическихЛиц КАК ДокументыЮридическихЛиц
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Отборы КАК _Отборы
			|		ПО ДокументыЮридическихЛиц.ЮрФизЛицо = _Отборы.ЮрФизЛицо
			|			И ДокументыЮридическихЛиц.Вид = _Отборы.ВидДокумента
			|			И _Отборы.ЭтоАудитор = ИСТИНА";
		
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.РеквизитыЮридическихЛиц") Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеквизитыЮридическихЛиц.Период КАК Период,
			|	_Отборы.Организация КАК Организация,
			|	РеквизитыЮридическихЛиц.Подразделение КАК Подразделение,
			|	РеквизитыЮридическихЛиц.Язык КАК Язык,
			|	РеквизитыЮридическихЛиц.ЮрФизЛицо КАК ЮрФизЛицо,
			|	РеквизитыЮридическихЛиц.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
			|	РеквизитыЮридическихЛиц.ИНН КАК ИНН
			|ПОМЕСТИТЬ _ДанныеРегистра
			|ИЗ
			|	РегистрСведений.РеквизитыЮридическихЛиц КАК РеквизитыЮридическихЛиц
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Отборы КАК _Отборы
			|		ПО РеквизитыЮридическихЛиц.ЮрФизЛицо = _Отборы.ЮрФизЛицо
			|			И РеквизитыЮридическихЛиц.Подразделение = _Отборы.Подразделение
			|			И РеквизитыЮридическихЛиц.Язык = _Отборы.Язык";
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.РеквизитыЮридическихЛицАнкетные") Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеквизитыЮридическихЛицАнкетные.Период КАК Период,
			|	РеквизитыЮридическихЛицАнкетные.Организация КАК Организация,
			|	РеквизитыЮридическихЛицАнкетные.ЮрФизЛицо КАК ЮрФизЛицо,
			|	РеквизитыЮридическихЛицАнкетные.Язык КАК Язык,
			|	РеквизитыЮридическихЛицАнкетные.ЮридическийАдрес КАК ЮридическийАдрес
			|ПОМЕСТИТЬ _ДанныеРегистра
			|ИЗ
			|	РегистрСведений.РеквизитыЮридическихЛицАнкетные КАК РеквизитыЮридическихЛицАнкетные
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Отборы КАК _Отборы
			|		ПО РеквизитыЮридическихЛицАнкетные.ЮрФизЛицо = _Отборы.ЮрФизЛицо
			|			И РеквизитыЮридическихЛицАнкетные.Организация = _Отборы.Организация
			|			И _Отборы.ЭтоАудитор = ИСТИНА";
		
	КонецЕсли;
	
	Запрос.Выполнить();
	
КонецПроцедуры

#КонецОбласти

#Область СООУРКИ028

// Возвращает текст основного запроса для формы СООУРКИ028
//
//	Параметры:
//		- ДатаОкончания - дата конца периода отчета
//
Функция ПолучитьТекстЗапроса_СООУРКИ028(ДатаОкончания) Экспорт
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&СтоимостьСобственныхСредствИзБухгалтерии КАК ВеличинаСобственныхСредств
		|ПОМЕСТИТЬ ВТ_ВеличинаСобственныхСредств
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
		|ПОМЕСТИТЬ ВТ_СчетаДоверительногоУправления
		|ИЗ
		|	_Клиенты КАК СчетаДоверительногоУправления";
	
	ТекстЗапроса = ТекстЗапроса + Символы.ПС + ";" + Символы.ПС;
	
	ТекстЗапросаДатСЧА = Справочники.НастройкиРегламентныхДействий.ПолучитьТекстЗапросаПоДатамРегламентныхДействий(
			Новый Структура("ВидДействия, ДополнитьРабочимиДнями, СвойПериодДляКаждогоСчетаДУ, УдалитьВсеВременныеТаблицы, ИмяТаблицыСчетовДУ, ИмяТаблицыДатДействияЗаПериод", 
				"СЧА", Ложь, Ложь, Истина, "ВТ_СчетаДоверительногоУправления", "ВТ_ДатыСЧА"));
			
	ТекстЗапросаДатСЧА = СтрЗаменить(ТекстЗапросаДатСЧА,"&ДатаПо", "КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)");
	ТекстЗапросаДатСЧА = СтрЗаменить(ТекстЗапросаДатСЧА,"&ДатаС", "НАЧАЛОПЕРИОДА(&ПоследнийРабочийДень, ДЕНЬ)");
	
	ТекстЗапроса = ТекстЗапроса + ТекстЗапросаДатСЧА +
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СчетаДоверительногоУправления.СчетДоверительногоУправления) КАК КоличествоПИФАИФ,
		|	СУММА(ФинансовыеПоказатели.Значение) КАК СтоимостьЧистыхАктивовИФ
		|ПОМЕСТИТЬ ВТ_СтоимостьЧистыхАктивовИФ
		|ИЗ
		|	ВТ_СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОкончания, ) КАК КлиентыДУПИФ
		|		ПО СчетаДоверительногоУправления.СчетДоверительногоУправления = КлиентыДУПИФ.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВТ_ДатыСЧА.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|			МАКСИМУМ(ВТ_ДатыСЧА.Дата) КАК Дата
		|		ИЗ
		|			ВТ_ДатыСЧА КАК ВТ_ДатыСЧА
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ВТ_ДатыСЧА.СчетДоверительногоУправления) КАК ВТ_ДатыСЧА
		|		ПО СчетаДоверительногоУправления.СчетДоверительногоУправления = ВТ_ДатыСЧА.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО (ВТ_ДатыСЧА.СчетДоверительногоУправления = ФинансовыеПоказатели.СубъектАналитики)
		|			И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|			И (ВТ_ДатыСЧА.Дата = ФинансовыеПоказатели.Период)
		|ГДЕ
		|	(СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
		|			ИЛИ СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиАкционерныхИнвестиционныхФондов))";
	
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + ";" + Символы.ПС;
	
	Если ДатаОкончания >= Дата(2021,1,1) Тогда //Приказ Минфина России от 01.12.2020 N 293н #368918 
		
		ТекстЗапроса = ТекстЗапроса + 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СчетаДоверительногоУправления.СчетДоверительногоУправления) КАК КоличествоДоговоровДУ1,
			|	СУММА(ФинансовыеПоказатели.Значение) КАК СтоимостьПенсионныхРезервовНПФ
			|ПОМЕСТИТЬ ВТ_СтоимостьПенсионныхРезервовНПФ
			|ИЗ
			|	ВТ_СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			ВТ_ДатыСЧА.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|			МАКСИМУМ(ВТ_ДатыСЧА.Дата) КАК Дата
			|		ИЗ
			|			ВТ_ДатыСЧА КАК ВТ_ДатыСЧА
			|		
			|		СГРУППИРОВАТЬ ПО
			|			ВТ_ДатыСЧА.СчетДоверительногоУправления) КАК ВТ_ДатыСЧА
			|		ПО СчетаДоверительногоУправления.СчетДоверительногоУправления = ВТ_ДатыСЧА.СчетДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
			|		ПО (ВТ_ДатыСЧА.СчетДоверительногоУправления = ФинансовыеПоказатели.СубъектАналитики)
			|			И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
			|			И (ВТ_ДатыСЧА.Дата = ФинансовыеПоказатели.Период)
			|ГДЕ
			|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами)";
			
	Иначе
		
		ТекстЗапроса = ТекстЗапроса + 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СчетаДоверительногоУправления.СчетДоверительногоУправления) КАК КоличествоДоговоровДУ1,
			|	СУММА(ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Сумма, 0)) КАК СтоимостьПенсионныхРезервовНПФ
			|ПОМЕСТИТЬ ВТ_СтоимостьПенсионныхРезервовНПФ
			|ИЗ
			|	ВТ_СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ _РСАНаКонецБаланс КАК ЕдиныйБухгалтерскийУчетОстатки
			|		ПО (ЕдиныйБухгалтерскийУчетОстатки.СчетДоверительногоУправления = СчетаДоверительногоУправления.СчетДоверительногоУправления)
			|ГДЕ
			|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами)";
		
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + Символы.ПС + ";" + Символы.ПС;
	ТекстЗапроса = ТекстЗапроса + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СчетаДоверительногоУправления.СчетДоверительногоУправления) КАК КоличествоДоговоровДУ2,
		|	СУММА(ФинансовыеПоказатели.Значение) КАК СтоимостьЧистыхАктивовПоДоговорамСНПФ
		|ПОМЕСТИТЬ ВТ_СтоимостьЧистыхАктивовПоДоговорамСНПФ
		|ИЗ
		|	ВТ_СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВТ_ДатыСЧА.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|			МАКСИМУМ(ВТ_ДатыСЧА.Дата) КАК Дата
		|		ИЗ
		|			ВТ_ДатыСЧА КАК ВТ_ДатыСЧА
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ВТ_ДатыСЧА.СчетДоверительногоУправления) КАК ВТ_ДатыСЧА
		|		ПО СчетаДоверительногоУправления.СчетДоверительногоУправления = ВТ_ДатыСЧА.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО (ВТ_ДатыСЧА.СчетДоверительногоУправления = ФинансовыеПоказатели.СубъектАналитики)
		|			И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|			И (ВТ_ДатыСЧА.Дата = ФинансовыеПоказатели.Период)
		|ГДЕ
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ФинансовыеПоказатели.Значение) КАК СтоимостьЧистыхАктивовПоДоговорамСПФР
		|ПОМЕСТИТЬ ВТ_СтоимостьЧистыхАктивовПоДоговорамСПФР
		|ИЗ
		|	ВТ_СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВТ_ДатыСЧА.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|			МАКСИМУМ(ВТ_ДатыСЧА.Дата) КАК Дата
		|		ИЗ
		|			ВТ_ДатыСЧА КАК ВТ_ДатыСЧА
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ВТ_ДатыСЧА.СчетДоверительногоУправления) КАК ВТ_ДатыСЧА
		|		ПО СчетаДоверительногоУправления.СчетДоверительногоУправления = ВТ_ДатыСЧА.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО (ВТ_ДатыСЧА.СчетДоверительногоУправления = ФинансовыеПоказатели.СубъектАналитики)
		|			И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|			И (ВТ_ДатыСЧА.Дата = ФинансовыеПоказатели.Период)
		|ГДЕ
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ДатаОкончания КАК ДатаПредставления,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК УправляющаяКомпания,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИННУправляющейКомпании,
		|	ВЫРАЗИТЬ(ВТ_ВеличинаСобственныхСредств.ВеличинаСобственныхСредств / &Коэффициент КАК ЧИСЛО(19, 2)) КАК ВеличинаСобственныхСредств,
		|	ВТ_СтоимостьЧистыхАктивовИФ.КоличествоПИФАИФ КАК КоличествоПИФАИФ,
		|	ВТ_СтоимостьПенсионныхРезервовНПФ.КоличествоДоговоровДУ1 КАК КоличествоДоговоровДУ1,
		|	ВТ_СтоимостьЧистыхАктивовПоДоговорамСНПФ.КоличествоДоговоровДУ2 КАК КоличествоДоговоровДУ2,
		|	ВЫРАЗИТЬ(ВТ_СтоимостьЧистыхАктивовИФ.СтоимостьЧистыхАктивовИФ / &Коэффициент КАК ЧИСЛО(19, 2)) КАК СтоимостьЧистыхАктивовИФ,
		|	ВЫРАЗИТЬ(ВТ_СтоимостьПенсионныхРезервовНПФ.СтоимостьПенсионныхРезервовНПФ / &Коэффициент КАК ЧИСЛО(19, 2)) КАК СтоимостьПенсионныхРезервовНПФ,
		|	ВЫРАЗИТЬ(ВТ_СтоимостьЧистыхАктивовПоДоговорамСНПФ.СтоимостьЧистыхАктивовПоДоговорамСНПФ / &Коэффициент КАК ЧИСЛО(19, 2)) КАК СтоимостьЧистыхАктивовПоДоговорамСНПФ,
		|	ВЫРАЗИТЬ(ВТ_СтоимостьЧистыхАктивовПоДоговорамСПФР.СтоимостьЧистыхАктивовПоДоговорамСПФР / &Коэффициент КАК ЧИСЛО(19, 2)) КАК СтоимостьЧистыхАктивовПоДоговорамСПФР
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(
		|				&ДатаОкончания,
		|				ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)
		|					И НЕ РодительскоеЮридическоеЛицо В (&ИсключаемыеГоловныеОрганизации)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО Организации.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|			И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, Организации.ЮрФизЛицо) = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо),
		|	ВТ_ВеличинаСобственныхСредств КАК ВТ_ВеличинаСобственныхСредств,
		|	ВТ_СтоимостьЧистыхАктивовИФ КАК ВТ_СтоимостьЧистыхАктивовИФ,
		|	ВТ_СтоимостьПенсионныхРезервовНПФ КАК ВТ_СтоимостьПенсионныхРезервовНПФ,
		|	ВТ_СтоимостьЧистыхАктивовПоДоговорамСНПФ КАК ВТ_СтоимостьЧистыхАктивовПоДоговорамСНПФ,
		|	ВТ_СтоимостьЧистыхАктивовПоДоговорамСПФР КАК ВТ_СтоимостьЧистыхАктивовПоДоговорамСПФР
		|ГДЕ
		|	Организации.Ссылка = &Организация";
	
	Возврат ТекстЗапроса;
	
КонецФункции
	
#КонецОбласти

#Область ДополнительныеПроцедурыИФункции

Функция ЗаполнитьТаблицуКодыКлиентовПоОКАТО(Параметры, МенеджерВременныхТаблиц) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДатаОкончания", Параметры.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация"	 , Параметры.Организация);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыФизическихЛицСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо,
		|	"""" КАК КодОКАТО,
		|	РеквизитыФизическихЛицСрезПоследних.АдресРегистрацииФИАС КАК АдресРегистрацииФИАС
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&ДатаОкончания,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицСрезПоследних
		|ГДЕ
		|	РеквизитыФизическихЛицСрезПоследних.РезидентПо173ФЗ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо,
		|	РеквизитыЮридическихЛицСрезПоследних.КодПоОКАТО,
		|	""""
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&ДатаОкончания,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|ГДЕ
		|	РеквизитыЮридическихЛицСрезПоследних.РезидентРФ";
	
	КодыКлиентовПоОКАТО = Запрос.Выполнить().Выгрузить();
	КодыКлиентовПоОКАТО.Колонки.Добавить("КодСубъекта", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(2)));
	
	Для Каждого СтрокаТаблицы Из КодыКлиентовПоОКАТО Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.АдресРегистрацииФИАС) Тогда
			ИндексНачала = СтрНайти(СтрокаТаблицы.АдресРегистрацииФИАС, "<КодСубъектаРФ>");
			Если ИндексНачала > 0 Тогда
				СтрокаТаблицы.КодСубъекта = Сред(СтрокаТаблицы.АдресРегистрацииФИАС, ИндексНачала + 15, 2);
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(КодыКлиентовПоОКАТО, "_КодыКлиентовПоОКАТО", Запрос,, "ЮрФизЛицо, КодОКАТО, КодСубъекта");
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ПолучитьТаблицуИзОбщегоМакета("СоответствиеКодовСубъектовИКодовОКАТО"), "_СоотвествиеКодов", Запрос,, "КодСубъекта, КодОКАТО");
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КодыКлиентовПоОКАТО.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ВЫБОР
		|		КОГДА КодыСубъектов.КодОКАТО ЕСТЬ НЕ NULL 
		|				И ПОДСТРОКА(КодыСубъектов.КодОКАТО, 3, 1) = """"
		|			ТОГДА КодыСубъектов.КодОКАТО + ""00""
		|		КОГДА КодыСубъектов.КодОКАТО ЕСТЬ НЕ NULL 
		|			ТОГДА КодыСубъектов.КодОКАТО
		|		КОГДА КодыОКАТО4.КодОКАТО ЕСТЬ НЕ NULL 
		|			ТОГДА КодыОКАТО4.КодОКАТО
		|		КОГДА КодыОКАТО2.КодОКАТО ЕСТЬ НЕ NULL 
		|			ТОГДА КодыОКАТО2.КодОКАТО + ""00""
		|	КОНЕЦ КАК ОКАТО
		|ПОМЕСТИТЬ КодыКлиентовПоОКАТО
		|ИЗ
		|	_КодыКлиентовПоОКАТО КАК _КодыКлиентовПоОКАТО
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СоотвествиеКодов КАК КодыСубъектов
		|		ПО _КодыКлиентовПоОКАТО.КодСубъекта = КодыСубъектов.КодСубъекта
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СоотвествиеКодов КАК КодыОКАТО4
		|		ПО (ПОДСТРОКА(_КодыКлиентовПоОКАТО.КодОКАТО, 1, 4) = КодыОКАТО4.КодОКАТО)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СоотвествиеКодов КАК КодыОКАТО2
		|		ПО (ПОДСТРОКА(_КодыКлиентовПоОКАТО.КодОКАТО, 1, 2) = КодыОКАТО2.КодОКАТО)";
	
	Запрос.Выполнить();

КонецФункции

//Возвращает массив некорректных головных организаций, например бывший Траст
Функция ПолучитьИсключаемыеГоловныеОрганизации() Экспорт
	
	ИсключаемыеГоловныеОрганизации = Новый Массив;
	ИсключаемыеГоловныеОрганизации.Добавить(Справочники.ЮрФизЛица.ПустаяСсылка());
	ИсключаемыеГоловныеОрганизации.Добавить(Справочники.ЮрФизЛица.ПолучитьСсылку(Новый УникальныйИдентификатор("e140844a-3de4-11e6-bee9-000c2958e1dd")));

	Возврат ИсключаемыеГоловныеОрганизации;
	
КонецФункции

Функция ПолучитьТаблицуИзОбщегоМакета(ИмяМакета, ПараметрыПоиска = Неопределено, Сортировка = Неопределено)
	
	Таблица = Новый ТаблицаЗначений;
	Макет	= ПолучитьОбщийМакет(ИмяМакета);
	Отказ	= Ложь;
	
	КолонкиМакета = Новый Соответствие;
	Для НомерКолонки = 1 По Макет.ШиринаТаблицы Цикл
		ПараметрыКолонки = СтрРазделить(СокрЛП(Макет.Область(1, НомерКолонки, 1, НомерКолонки).Текст), "()", Ложь);
		
		КолонкиМакета.Вставить(ПараметрыКолонки[0], НомерКолонки);
		Если ПараметрыКолонки.Количество() = 1 Тогда
			Таблица.Колонки.Добавить(ПараметрыКолонки[0], Новый ОписаниеТипов("Строка"));
		ИначеЕсли ПараметрыКолонки.Количество() = 2 Тогда
			Таблица.Колонки.Добавить(ПараметрыКолонки[0], Новый ОписаниеТипов(ПараметрыКолонки[1]));
		ИначеЕсли ПараметрыКолонки.Количество() = 3 И ПараметрыКолонки[1] = "Строка" Тогда
			Таблица.Колонки.Добавить(ПараметрыКолонки[0], Новый ОписаниеТипов(ПараметрыКолонки[1], Новый КвалификаторыСтроки(ПараметрыКолонки[2])));	
		КонецЕсли;
		
	КонецЦикла;
	
	Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
		НоваяСтрока = Таблица.Добавить();
		Для Каждого КолонкаМакета Из КолонкиМакета Цикл
			Значение = СокрЛП(Макет.Область(НомерСтроки, КолонкаМакета.Значение, НомерСтроки, КолонкаМакета.Значение).Текст);
			
			Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(НоваяСтрока[КолонкаМакета.Ключ])) Тогда
				Если ЗначениеЗаполнено(Значение) Тогда
					Попытка 
						УникальныйИдентификатор = Новый УникальныйИдентификатор(Значение);
						НоваяСтрока[КолонкаМакета.Ключ]	= ОбщегоНазначения.МенеджерОбъектаПоСсылке(НоваяСтрока[КолонкаМакета.Ключ]).ПолучитьСсылку(УникальныйИдентификатор);
					Исключение
						НоваяСтрока[КолонкаМакета.Ключ] = ОбщегоНазначения.ПолучитьИменованныйОбъект(Значение);
					КонецПопытки;
				КонецЕсли;
			ИначеЕсли ТипЗнч(НоваяСтрока[КолонкаМакета.Ключ]) = Тип("Тип") Тогда
				НоваяСтрока[КолонкаМакета.Ключ]	= Тип(Значение);
			Иначе
				НоваяСтрока[КолонкаМакета.Ключ]	= Значение;
			КонецЕсли;
				
			Если ТипЗнч(НоваяСтрока[КолонкаМакета.Ключ]) = Тип("Строка") И НоваяСтрока[КолонкаМакета.Ключ] <> Значение Тогда 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Неверно указана ширина колонки %1 в макете %2, не поместилось значение %3, обратитесь к программисту.", КолонкаМакета.Ключ, ИмяМакета, Значение),,,, Отказ);
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЦикла;
	
	Если ТипЗнч(ПараметрыПоиска) = Тип("Структура") Тогда
		Результат = Таблица.Скопировать(ПараметрыПоиска);
	Иначе
		Результат = Таблица;
	КонецЕсли;
	
	Если Сортировка <> Неопределено Тогда
		Результат.Сортировать(Сортировка);
	КонецЕсли;
	
	Если Не Отказ Тогда
		Возврат Результат;
	КонецЕсли;
	
КонецФункции

#КонецОбласти
