Функция ОКУД0420417_ПолучитьОбъемСделок(Параметры, Запрос = Неопределено, ТаблицаСделок = Неопределено) Экспорт
	
	Если Запрос = Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Параметры.Вставить("ВерсияТаксономии",	"4_2");
		Параметры.Вставить("ВариантОтчета",		"ОКУД0420417");
		
		ОКУД0420417_ЗаполнитьПараметрыЗапроса(Параметры, Запрос, Ложь, Ложь);		
		Запрос.Выполнить();
	КонецЕсли;

	Колонки = Новый Массив;
	Колонки.Добавить("Сделка");
	Колонки.Добавить("Кол4_ДатаСделки");
	Колонки.Добавить("Кол41_СуммаСделкиПервЧасть");
	Колонки.Добавить("СуммаСделкиВВалютеУчета");
	Колонки.Добавить("ВалютаСделки");
	Колонки.Добавить("КурсВалютыСделки");
	Колонки.Добавить("СчетДоверительногоУправления");
	Колонки.Добавить("МестоХранения");
	Колонки.Добавить("Кол3_ТипСделки");
	Колонки.Добавить("Кол5_КодДоговора");
	Колонки.Добавить("Кол8_ВидИнфСообщ");
	
	ТаблицаОтчета = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ТаблицаОтчета").ПолучитьДанные().Выгрузить().Скопировать(, СтрСоединить(Колонки, ","));
	
	ТаблицаОтчета.Колонки.Найти("Кол4_ДатаСделки").Имя				= "ДатаСделки";
	ТаблицаОтчета.Колонки.Найти("Кол41_СуммаСделкиПервЧасть").Имя	= "СуммаСделки";
	ТаблицаОтчета.Колонки.Найти("Кол3_ТипСделки").Имя				= "ТипСделки";
	ТаблицаОтчета.Колонки.Найти("Кол5_КодДоговора").Имя				= "КодДоговора";
	ТаблицаОтчета.Колонки.Найти("Кол8_ВидИнфСообщ").Имя				= "ВидИнфСообщ";
	
	ТаблицаСделок = ТаблицаОтчета.Скопировать(Новый Структура("ТипСделки,КодДоговора,ВидИнфСообщ", "AM", "BS","NEW"));
	ТаблицаСделок.Сортировать("МестоХранения,ДатаСделки,СчетДоверительногоУправления,Сделка", Новый СравнениеЗначений);	
	
	ОбъемСделок = ТаблицаСделок.Итог("СуммаСделкиВВалютеУчета");
	
	Возврат ОбъемСделок;
	
КонецФункции

