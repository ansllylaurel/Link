Функция КонтрольКвартальныхПоказателей(ПараметрыРасчета, Запрос, Отказ) Экспорт
	
	//ПараметрыРасчета - используются в конструкции Вычислить(Выборка.Функция)
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ОКУД0420401_ПолучитьТаблицуКвартальныхПоказателей(), "_ВидыПоказателей", Запрос); 
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВидыПоказателей.ВидПоказателя КАК ВидПоказателя,
		|	_ВидыПоказателей.Функция КАК Функция,
		|	ФинансовыеПоказатели.Значение КАК Значение,
		|	НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ) КАК Период,
		|	ФинансовыеПоказатели.Регистратор КАК Регистратор
		|ИЗ
		|	_ВидыПоказателей КАК _ВидыПоказателей
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО _ВидыПоказателей.ВидПоказателя = ФинансовыеПоказатели.ВидПоказателя
		|			И (ФинансовыеПоказатели.Активность)
		|			И (ФинансовыеПоказатели.Организация = &Организация)
		|			И (ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ))
		|ГДЕ
		|	_ВидыПоказателей.ДатаНачала <= &ДатаОкончания
		|	И (_ВидыПоказателей.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ _ВидыПоказателей.ДатаОкончания >= &ДатаОкончания)";
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Значение = NULL Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон("Не зарегистрирован показатель '%1' на %2.",
					Выборка.ВидПоказателя,
					Формат(Выборка.Период, "ДФ=dd.MM.yyyy")),,,, Отказ);
		Иначе	
			РасчетноеЗначение = Вычислить(Выборка.Функция);
			Если РасчетноеЗначение <> Выборка.Значение Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Расчётное значение показателя %1 (%2)  не соответствует зарегистрированному (%3) на %4.",
						Выборка.ВидПоказателя,
						РасчетноеЗначение,
						Выборка.Значение,
						Формат(Выборка.Период, "ДФ=dd.MM.yyyy")), Выборка.Регистратор,,, Отказ);
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

