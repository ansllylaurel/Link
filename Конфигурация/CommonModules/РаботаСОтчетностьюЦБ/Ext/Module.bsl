		"СчетаДУДействующиеВПериоде"); 
		
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СделкиСДатамиЗакрытияИсключения.ДатаНачала КАК ДатаНачала,
		|	_СделкиСДатамиЗакрытияИсключения.Сделка КАК Сделка,
		|	_СделкиСДатамиЗакрытияИсключения.ЧастьСделки КАК ЧастьСделки,
		|	_СделкиСДатамиЗакрытияИсключения.ЗаменитьЧастьСделки КАК ЗаменитьЧастьСделки,
		|	_СделкиСДатамиЗакрытияИсключения.ВидИнформационногоСообщения КАК ВидИнформационногоСообщения,
		|	_СделкиСДатамиЗакрытияИсключения.ЗаменитьВидИнформационногоСообщения КАК ЗаменитьВидИнформационногоСообщения,
		|	_СделкиСДатамиЗакрытияИсключения.КодСтроныНеИсполнившейОбязательства КАК КодСтроныНеИсполнившейОбязательства,
		|	_СделкиСДатамиЗакрытияИсключения.ЗаменитьКодСтроныНеИсполнившейОбязательства КАК ЗаменитьКодСтроныНеИсполнившейОбязательства,
		|	_СделкиСДатамиЗакрытияИсключения.ЗадолженностьПоДС КАК ЗадолженностьПоДС,
		|	_СделкиСДатамиЗакрытияИсключения.ЗаменитьЗадолженностьПоДС КАК ЗаменитьЗадолженностьПоДС,
		|	_СделкиСДатамиЗакрытияИсключения.ДатаПоследнейОплаты КАК ДатаПоследнейОплаты,
		|	_СделкиСДатамиЗакрытияИсключения.ЗаменитьДатаПоследнейОплаты КАК ЗаменитьДатаПоследнейОплаты,
		|	_СделкиСДатамиЗакрытияИсключения.ЗадолженностьПоЦБ КАК ЗадолженностьПоЦБ,
		|	_СделкиСДатамиЗакрытияИсключения.ЗаменитьЗадолженностьПоЦБ КАК ЗаменитьЗадолженностьПоЦБ,
		|	_СделкиСДатамиЗакрытияИсключения.ДатаПоследнейПоставки КАК ДатаПоследнейПоставки,
