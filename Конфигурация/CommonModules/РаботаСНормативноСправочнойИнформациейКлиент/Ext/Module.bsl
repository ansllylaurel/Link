
Процедура УстановитьНаименованиеФункциональнойРоли(Объект) Экспорт
 
	Если ЗначениеЗаполнено(Объект.Наименование) Тогда
		Если ЗначениеЗаполнено(Объект.ЮрФизЛицо) Тогда
			Если ТипЗнч(Объект.ЮрФизЛицо) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
				НовоеНаименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ЮрФизЛицо, "Наименование");
				ВидЮрФизЛица      = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ЮрФизЛицо, "ВидЮрФизЛица");
				
				Если Объект.Наименование <> НовоеНаименование Тогда
					Если Вопрос("Изменить наименование на «" + НовоеНаименование + "», в соответствии с наименованием " + ?(ВидЮрФизЛица = ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо"), "юр.", "физ.") + " лица?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
						Объект.Наименование = НовоеНаименование;
					КонецЕсли;
				КонецЕсли;
			Иначе
				НовоеНаименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ЮрФизЛицо, "Наименование");
				
				Если Объект.Наименование <> НовоеНаименование Тогда
					Если Вопрос("Изменить наименование на «" + НовоеНаименование + "», в соответствии с наименованием ПИФа?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
						Объект.Наименование = НовоеНаименование;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
	    НовоеНаименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ЮрФизЛицо, "Наименование");
		Объект.Наименование = НовоеНаименование;
	КонецЕсли; 

КонецПроцедуры // УстановитьНаименованиеФункциональнойРоли

Процедура УстановитьНовоеНаименование(Объект) Экспорт
	
	ЗадействованныеРеквизиты = РаботаСНормативноСправочнойИнформацией.ПолучитьЗадействованныеВНаименованииРеквизиты(Объект.Ссылка);
	
	НовоеНаименование = РаботаСНормативноСправочнойИнформацией.СформироватьНаименование(
		Объект.Ссылка, ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(Объект, ЗадействованныеРеквизиты));
	
	Если Не ПустаяСтрока(НовоеНаименование) Тогда
		Если ПустаяСтрока(Объект.Наименование) Тогда
			Объект.Наименование = НовоеНаименование;
		ИначеЕсли Объект.Наименование <> НовоеНаименование Тогда
			Если Вопрос("Изменить наименование на «" + НовоеНаименование + "»?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
				Объект.Наименование = НовоеНаименование;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // УстановитьНовоеНаименование

Процедура ИмпортироватьНовыйОбъектИзМатрикс(ГруппаОбъектов, СписокФормы) Экспорт
	
	ПараметрыИмпорта = Новый Структура;
	ПараметрыИмпорта.Вставить("ГруппаПравил",                      "Матрих");
	ПараметрыИмпорта.Вставить("ГруппаОбъектов",                    ГруппаОбъектов);
	ПараметрыИмпорта.Вставить("ЗакрытьФормуПослеУспешногоИмпорта", Истина);
	
	ОбработанныеОбъекты = ОткрытьФормуМодально("Обработка.ИмпортНормативноСправочнойИнформации.Форма", ПараметрыИмпорта);
	
	Если ТипЗнч(ОбработанныеОбъекты) = Тип("Массив") И ОбработанныеОбъекты.Количество() > 0 Тогда
		СписокФормы.ТекущаяСтрока = ОбработанныеОбъекты[0];
	КонецЕсли;
	
КонецПроцедуры // ИмпортироватьНовыйОбъектМатрикс	

// Возвращает реквизиты головной организации
//
// Параметры
//	Организация						- СправочникСсылка.Организации	- Организация для которой необходимо получить реквизиты головной организации
//	Дата							- Дата							- Дата реквизитов
//	Реквизиты						- Строка						- Список реквизитов через запятую
//
// Возвращаемое значение:
//  Структура - реквизиты головной организации
//
Функция ПолучитьРеквизитыГоловнойОрганизации(Организация, Дата, Реквизиты) Экспорт

	Возврат РаботаСНормативноСправочнойИнформацией.ПолучитьРеквизитыГоловнойОрганизации(Организация, Дата, Реквизиты);
	
КонецФункции