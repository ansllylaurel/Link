				СтрШаблон("Сотрудник %1 отсутствует (%2) на %3",
					НеРаботающиеСотрудники.Сотрудник,
					НеРаботающиеСотрудники.Состояние,
					Формат(Дата, "ДФ=dd.MM.yyyy")), НеРаботающиеСотрудники.Сотрудник,,, Отказ);
			Результат = Истина;
		КонецЦикла;
		
	КонецЕсли;
	
