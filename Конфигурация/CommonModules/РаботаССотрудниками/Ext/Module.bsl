Функция СотрудникиВходятВПеречень(Организация, ВидПеречня, Сотрудники, Дата, Отказ) Экспорт
	
	Результат = Истина;
	
	СотрудникиВходящиеВПеречень = СотрудникиВходящиеВПеречень(Организация, ВидПеречня, Дата);
	
	Если ТипЗнч(Сотрудники) = Тип("СправочникСсылка.Сотрудники") Тогда
		Если СотрудникиВходящиеВПеречень.Найти(Сотрудники, "Сотрудник") = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон("Сотрудник %1 не входит в перечень %2 по состоянию на %3",
					Сотрудники,
					ВидПеречня,
					Формат(Дата, "ДФ=dd.MM.yyyy")),,,, Отказ);
			Результат = Ложь;
		КонецЕсли;
		
	Иначе
		Для Каждого Сотрудник Из Сотрудники Цикл
			Если СотрудникиВходящиеВПеречень.Найти(Сотрудник, "Сотрудник") = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Сотрудник %1 не входит в перечень %2 по состоянию на %3",
						Сотрудник,
						ВидПеречня,
						Формат(Дата, "ДФ=dd.MM.yyyy")),,,, Отказ);
				Результат = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СотрудникОтсутсвуетНаРабочемМесте(Организация, Сотрудник, Дата, Отказ) Экспорт 
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Сотрудник",   Сотрудник);
	Запрос.УстановитьПараметр("Дата",		 Дата);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СотрудникиОрганизацииСрезПоследних.Сотрудник КАК Сотрудник
		|ПОМЕСТИТЬ _РаботающиеСотрудники
		|ИЗ
		|	РегистрСведений.СотрудникиОрганизации.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И Сотрудник = &Сотрудник) КАК СотрудникиОрганизацииСрезПоследних
		|ГДЕ
		|	СотрудникиОрганизацииСрезПоследних.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СостояниеСотрудниковОрганизацийСрезПоследних.Сотрудник КАК Сотрудник,
		|	СостояниеСотрудниковОрганизацийСрезПоследних.Состояние КАК Состояние
		|ПОМЕСТИТЬ _НеРаботающиеСотрудники
		|ИЗ
		|	РегистрСведений.СостояниеСотрудниковОрганизаций.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И Сотрудник = &Сотрудник) КАК СостояниеСотрудниковОрганизацийСрезПоследних
		|ГДЕ
		|	СостояниеСотрудниковОрганизацийСрезПоследних.Состояние <> ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудникаОрганизации.Работа)";
	
	Запрос.Выполнить();
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_РаботающиеСотрудники").ПолучитьДанные().Пустой() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Сотрудник %1 не работает в организации %2 на %3",
				Сотрудник,
				Организация,
				Формат(Дата, "ДФ=dd.MM.yyyy")), Сотрудник,,, Отказ);
		Результат = Истина;
				
	Иначе 
		НеРаботающиеСотрудники = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_НеРаботающиеСотрудники").ПолучитьДанные().Выбрать();
		Пока НеРаботающиеСотрудники.Следующий() Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон("Сотрудник %1 отсутствует (%2) на %3",
					Сотрудник,
					НеРаботающиеСотрудники.Состояние,
					Формат(Дата, "ДФ=dd.MM.yyyy")), Сотрудник,,, Отказ);
			Результат = Истина;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПользовательОтсутствуетНаРабочемМесте(Организация, Пользователь, Дата, Отказ) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		ВызватьИсключение "Текущий пользователь не указан";
	КонецЕсли;
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация",  Организация);
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("Дата",		  Дата);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сотрудники.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _Сотрудники
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	Сотрудники.Пользователь = &Пользователь
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СотрудникиОрганизацииСрезПоследних.Сотрудник КАК Сотрудник
		|ПОМЕСТИТЬ _РаботающиеСотрудники
		|ИЗ
		|	РегистрСведений.СотрудникиОрганизации.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И Сотрудник В
		|					(ВЫБРАТЬ
		|						_Сотрудники.Ссылка
		|					ИЗ
		|						_Сотрудники КАК _Сотрудники)) КАК СотрудникиОрганизацииСрезПоследних
		|ГДЕ
		|	СотрудникиОрганизацииСрезПоследних.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СостояниеСотрудниковОрганизацийСрезПоследних.Сотрудник КАК Сотрудник,
		|	СостояниеСотрудниковОрганизацийСрезПоследних.Состояние КАК Состояние
		|ПОМЕСТИТЬ _НеРаботающиеСотрудники
		|ИЗ
		|	РегистрСведений.СостояниеСотрудниковОрганизаций.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И Сотрудник В
		|					(ВЫБРАТЬ
		|						_РаботающиеСотрудники.Сотрудник
		|					ИЗ
		|						_РаботающиеСотрудники КАК _РаботающиеСотрудники)) КАК СостояниеСотрудниковОрганизацийСрезПоследних
		|ГДЕ
		|	СостояниеСотрудниковОрганизацийСрезПоследних.Состояние <> ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудникаОрганизации.Работа)";
	
	
	Запрос.Выполнить();
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Сотрудники").ПолучитьДанные().Пустой() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Для пользователя %1 в организации %2 не определён ни один сотрудник.",
				Пользователь,
				Организация), Пользователь,,, Отказ);
