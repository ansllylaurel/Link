Функция СотрудникиВходящиеВПеречень(Организация, ВидПеречня, Дата) Экспорт

	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВидПеречня",	 ВидПеречня);
	Запрос.УстановитьПараметр("Дата",	  	 Дата);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВнесениеИзмененийВоВнутреннийПереченьОснования.Сотрудник КАК Сотрудник
		|ИЗ
		|	РегистрСведений.ВнутренниеПеречни.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И ВидПеречня = &ВидПеречня) КАК ВнутренниеПеречниСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОснованияВнесенияВПеречень.СрезПоследних(
		|				&Дата,
		|				Организация = &Организация
		|					И ВидПеречня = &ВидПеречня) КАК ОснованияВнесенияВПереченьСрезПоследних
		|		ПО ВнутренниеПеречниСрезПоследних.Объект = ОснованияВнесенияВПереченьСрезПоследних.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВнесениеИзмененийВоВнутреннийПеречень.Основания КАК ВнесениеИзмененийВоВнутреннийПереченьОснования
		|		ПО (ОснованияВнесенияВПереченьСрезПоследних.Основание = ВнесениеИзмененийВоВнутреннийПереченьОснования.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации.СрезПоследних(&Дата, Организация = &Организация) КАК СотрудникиОрганизацииСрезПоследних
		|		ПО (ВнесениеИзмененийВоВнутреннийПереченьОснования.Сотрудник = СотрудникиОрганизацииСрезПоследних.Сотрудник)
		|ГДЕ
		|	ВнутренниеПеречниСрезПоследних.Действует
		|	И СотрудникиОрганизацииСрезПоследних.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Сотрудник
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьРеквизитыСотрудника(Организация, Сотрудник, Дата = Неопределено, Реквизиты) Экспорт
	
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДата();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Сотрудник",	 Сотрудник);
	Запрос.УстановитьПараметр("Дата",		 Дата);
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Сотрудники.Ссылка КАК Сотрудник,
		|	Сотрудники.ВидЗанятости КАК ВидЗанятости,
		|	Сотрудники.ЮрФизЛицо КАК ЮрФизЛицо,
		|	Сотрудники.Наименование КАК Наименование,
		|	СотрудникиОрганизацииСрезПоследних.Должность КАК Должность,
		|	СотрудникиОрганизацииСрезПоследних.Должность.Наименование КАК ДолжностьНаименование,
		|	СотрудникиОрганизацииСрезПоследних.Подразделение КАК Подразделение,
		|	СотрудникиОрганизацииСрезПоследних.Подразделение.Наименование КАК ПодразделениеНаименование,
		|	СотрудникиОрганизацииСрезПоследних.Должность.Наименование + "" ("" + СотрудникиОрганизацииСрезПоследних.Подразделение.Наименование + "")"" КАК ДолжностьИПодразделение,
		|	НЕ(СотрудникиОрганизацииСрезПоследних.ВидСобытия ЕСТЬ NULL
		|			ИЛИ СотрудникиОрганизацииСрезПоследних.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)) КАК Работает,
		|	СотрудникиОрганизацииСрезПоследних.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение) КАК Уволен,
		|	СостояниеСотрудниковОрганизацийСрезПоследних.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудникаОрганизации.Работа)
		|		ИЛИ СостояниеСотрудниковОрганизацийСрезПоследних.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудникаОрганизации.РаботаВОтпускеПоУходуЗаРебенком) КАК НаходитсяНаРабочемМесте,
		|	СостояниеСотрудниковОрганизацийСрезПоследних.Состояние КАК Состояние,
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.Фамилия КАК Фамилия,
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.Имя КАК Имя,
