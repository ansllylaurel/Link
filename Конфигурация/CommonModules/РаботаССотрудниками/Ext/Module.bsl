	ИначеЕсли Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_РаботающиеСотрудники").ПолучитьДанные().Пустой() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Для пользователя %1 в организации %2 не определён ни один работающий на %3 сотрудник.",
				Пользователь,
				Организация,
				Формат(Дата, "ДФ=dd.MM.yyyy")), Пользователь,,, Отказ);
