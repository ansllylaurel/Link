	
Функция СотрудникиУволены(Организация, Сотрудники, Дата, ВыводитьСообщения = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Сотрудники",	 Сотрудники);
	Запрос.УстановитьПараметр("Дата",	  	 Дата);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СотрудникиОрганизацииСрезПоследних.Сотрудник КАК Сотрудник
		|ИЗ
		|	РегистрСведений.СотрудникиОрганизации.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И Сотрудник В (&Сотрудники)) КАК СотрудникиОрганизацииСрезПоследних
		|ГДЕ
		|	СотрудникиОрганизацииСрезПоследних.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)";
	
	Результат = Запрос.Выполнить();
	
	Если ВыводитьСообщения Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Сотрудник %1 уволен.", Выборка.Сотрудник), Выборка.Сотрудник);
		КонецЦикла;
	КонецЕсли;	
	
	Возврат НЕ Результат.Пустой();
	
КонецФункции

