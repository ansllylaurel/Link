
// При загрузке данных из настроек считывает значения реквизитов формы и реквизиты основного реквизита (Отчёт/Обработка)
// Вызывает необходимые проверки
Процедура ПриЗагрузкеДанныхИзНастроек(Форма, ПутьКРеквизитуОрганизации = Неопределено) Экспорт
	
	Если Форма.Параметры.Свойство("АдресПриЗагрузкеДанныхИзНастроекНаСервере") Тогда
		ПоместитьВоВременноеХранилище(Истина, Форма.Параметры.АдресПриЗагрузкеДанныхИзНастроекНаСервере);
		Возврат;
	КонецЕсли;
	
	// Для обычных пользователей очищаем реквизиты с недоступными в данном сеансе значениями.
	// Для пользователей с полными правами в зависимости от настройки пользователя:
	// - либо очищаем реквизиты, не соответствующие организации отчета/обработки,
	// - либо оставляем без изменений. 
	
	ОчищатьНедоступныеЗначения					= Истина;
	ОчищатьНесоотвествующиеОрганизацииЗначения	= Ложь;
	
	ТекущаяОрганизация = Неопределено;
	
	Если РаботаСПользователями.ЭтоПолноправныйПользователь() Тогда
		
		ОчищатьРеквизитыСоЗначениямиНеСоответствующимиОрганизацииПриОткрытииФормы =
			РегистрыСведений.ЗначенияНастроекПользователей.ПолучитьЗначениеНастройки(ПланыВидовХарактеристик.НастройкиПользователей.ОчищатьРеквизитыСоЗначениямиНеСоответствующимиОрганизацииПриОткрытииФормы);
		
		ОчищатьНедоступныеЗначения					= Ложь;
		ОчищатьНесоотвествующиеОрганизацииЗначения	= (ОчищатьРеквизитыСоЗначениямиНеСоответствующимиОрганизацииПриОткрытииФормы = Истина);
		
		Если ОчищатьНесоотвествующиеОрганизацииЗначения И ПутьКРеквизитуОрганизации <> Неопределено Тогда
			ТекущаяОрганизация = РаботаСФормамиКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, ПутьКРеквизитуОрганизации);
		КонецЕсли;
		
	КонецЕсли;
		
	// Получаем таблицу проверяемых реквизитов и их значений
	
	Если ОчищатьНедоступныеЗначения ИЛИ ОчищатьНесоотвествующиеОрганизацииЗначения Тогда
		
		ЗависимыеОтОрганизацииТипыЗначений = РаботаСМетаданнымиПовтИсп.ЗависимыеОтРеквизитаТипыЗначений("Организация");
		
		ПроверяемыеРеквизиты = Новый ТаблицаЗначений;
		ПроверяемыеРеквизиты.Колонки.Добавить("ПутьКРеквизиту", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(1024)));	
		ПроверяемыеРеквизиты.Колонки.Добавить("Значение");
		ПроверяемыеРеквизиты.Колонки.Добавить("ТипЗначения");
		ПроверяемыеРеквизиты.Колонки.Добавить("ХранитКоллекцию", Новый ОписаниеТипов("Булево"));
		
		РеквизитыФормы = Форма.ПолучитьРеквизиты();
		
		Для Каждого РеквизитФормы Из РеквизитыФормы Цикл
			
			Если РеквизитФормы.Имя = "Отчет" ИЛИ РеквизитФормы.Имя = "Объект" Тогда
				ВладелецРеквизитов	= РеквизитФормы.Имя;
				КоллекцияРеквизитов	= Форма.РеквизитФормыВЗначение(РеквизитФормы.Имя).Метаданные().Реквизиты; 
			Иначе
				ВладелецРеквизитов	= "";
				КоллекцияРеквизитов = РаботаСКоллекциями.ЗначениеВМассив(РеквизитФормы);
			КонецЕсли;
			
			Для Каждого Реквизит Из КоллекцияРеквизитов Цикл
				
				ЗначениеРеквизита		= ?(ПустаяСтрока(ВладелецРеквизитов), Форма[Реквизит.Имя], Форма[ВладелецРеквизитов][Реквизит.Имя]);
				ТипЗначенияРеквизита	= ТипЗнч(ЗначениеРеквизита);
				ХранитКоллекцию			= (ТипЗначенияРеквизита = Тип("СписокЗначений"));
				
				КоллекцияЗначенийРеквизита = Новый Массив;
				
				Если ХранитКоллекцию Тогда
					
					ЕстьЗависимыйОтОрганизацииТип = Ложь;
					Для каждого ПроверяемыйТип Из ЗначениеРеквизита.ТипЗначения.Типы() Цикл
						Если ЗависимыеОтОрганизацииТипыЗначений.Получить(ПроверяемыйТип) <> Неопределено Тогда
							ЕстьЗависимыйОтОрганизацииТип = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					Если ЕстьЗависимыйОтОрганизацииТип Тогда
						Для каждого ЭлементСписка Из ЗначениеРеквизита Цикл
							КоллекцияЗначенийРеквизита.Добавить(Новый Структура("Значение, Тип", ЭлементСписка.Значение, ТипЗнч(ЭлементСписка.Значение)));
						КонецЦикла;
					КонецЕсли;
				Иначе
					КоллекцияЗначенийРеквизита = Новый Массив();
					КоллекцияЗначенийРеквизита.Добавить(Новый Структура("Значение, Тип", ЗначениеРеквизита, ТипЗначенияРеквизита));
				КонецЕсли;
				
				Для каждого ЭлементЗначенийРеквизита Из КоллекцияЗначенийРеквизита Цикл
				
					Если ЗависимыеОтОрганизацииТипыЗначений.Получить(ЭлементЗначенийРеквизита.Тип) <> Неопределено
						И ЗначениеЗаполнено(ЭлементЗначенийРеквизита.Значение)
					Тогда
						
						ПроверяемыйРеквизит = ПроверяемыеРеквизиты.Добавить();
						ПроверяемыйРеквизит.ХранитКоллекцию	= ХранитКоллекцию;
						ПроверяемыйРеквизит.ПутьКРеквизиту	= ?(ПустаяСтрока(ВладелецРеквизитов), "", ВладелецРеквизитов + ".") + Реквизит.Имя;
						ПроверяемыйРеквизит.Значение		= ЭлементЗначенийРеквизита.Значение;
						ПроверяемыйРеквизит.ТипЗначения		= ЭлементЗначенийРеквизита.Тип;
						
					КонецЕсли;
				
				КонецЦикла;
				
				// Получаем организацию из основного реквизита (в приоритете), либо из формы
				
				Если ОчищатьНесоотвествующиеОрганизацииЗначения И Реквизит.Имя = "Организация"
					И (ТекущаяОрганизация = Неопределено ИЛИ Не ПустаяСтрока(ВладелецРеквизитов))
				Тогда
					ТекущаяОрганизация = ЗначениеРеквизита;	
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
		// Очистим недоступные или не соответствующие организации значения
		
		Если ПроверяемыеРеквизиты.Количество() > 0
			И (ОчищатьНедоступныеЗначения ИЛИ ОчищатьНесоотвествующиеОрганизацииЗначения И ТекущаяОрганизация <> Неопределено)
		Тогда
		
			#Область Очистка_реквизитов
			
			// Подготавливаем ТЗ к помещению во временную таблицу запроса
			
			ТипыЗначений = ПроверяемыеРеквизиты.Скопировать(Неопределено, "ТипЗначения");
			ТипыЗначений.Свернуть("ТипЗначения");
			
			РаботаСКоллекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(ПроверяемыеРеквизиты, "Значение", Новый ОписаниеТипов(ТипыЗначений.ВыгрузитьКолонку(0))); 
			
			// Выполняем поиск реквизитов с доступными значениями
			
			Запрос = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ПроверяемыеРеквизиты.ПутьКРеквизиту КАК ПутьКРеквизиту,
				|	ПроверяемыеРеквизиты.ХранитКоллекцию КАК ХранитКоллекцию,
				|	ПроверяемыеРеквизиты.Значение КАК Значение
				|ПОМЕСТИТЬ _ПроверяемыеРеквизиты
				|ИЗ
				|	&ПроверяемыеРеквизиты КАК ПроверяемыеРеквизиты
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	_ПроверяемыеРеквизиты.ПутьКРеквизиту КАК ПутьКРеквизиту,
				|	_ПроверяемыеРеквизиты.ХранитКоллекцию КАК ХранитКоллекцию
				|ИЗ
				|	_ПроверяемыеРеквизиты КАК _ПроверяемыеРеквизиты
				|ГДЕ
				|	&ФильтрПоТекущейОрганизации");
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст,
				"&ФильтрПоТекущейОрганизации",
				?(ТекущаяОрганизация = Неопределено, "_ПроверяемыеРеквизиты.Значение.Ссылка ЕСТЬ NULL", "_ПроверяемыеРеквизиты.Значение.Организация <> &Организация"));
			
			Запрос.УстановитьПараметр("ПроверяемыеРеквизиты",	ПроверяемыеРеквизиты);
			Запрос.УстановитьПараметр("Организация",			ТекущаяОрганизация);
			
			НедоступныеРеквизиты = Запрос.Выполнить().Выгрузить();
			
			Для Каждого Реквизит Из НедоступныеРеквизиты Цикл
				
				Если Реквизит.ХранитКоллекцию Тогда
					РеквизитФормы = РаботаСФормамиКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, Реквизит.ПутьКРеквизиту);
					РеквизитФормы.Очистить();
					РеквизитФормы.Добавить();
				Иначе
					РаботаСФормамиКлиентСервер.УстановитьРеквизитФормыПоПути(Форма, Реквизит.ПутьКРеквизиту, Неопределено);
				КонецЕсли;
				
			КонецЦикла;		
			
			#КонецОбласти
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//В передаваемой форме создаёт реквизит ВерсияДополнительногоОтчетаИлиОбработки и заполняет его текущей версией отчёта/обработки
Процедура УстановитьВерсиюДополнительногоОтчетаОбработки(Форма) Экспорт
	
	ОсновнойРеквизитФормы	= Неопределено;
	РеквизитыФормы			= Форма.ПолучитьРеквизиты();
	
	Для Каждого Реквизит Из РеквизитыФормы Цикл
		Если Реквизит.Имя = "Отчет" ИЛИ Реквизит.Имя = "Объект" Тогда
			ОсновнойРеквизитФормы = Реквизит;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ОсновнойРеквизитФормы = Неопределено Тогда
		ВызватьИсключение "Не установлен основной реквизит формы";
	КонецЕсли;
	
	Объект = Форма.РеквизитФормыВЗначение(ОсновнойРеквизитФормы.Имя);
	
	ДобавляемыеРеквизиты = Новый Массив();
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ВерсияДополнительногоОтчетаИлиОбработки", Новый ОписаниеТипов("Строка")));
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	Форма.ВерсияДополнительногоОтчетаИлиОбработки = Объект.СведенияОВнешнейОбработке().Версия;
	
КонецПроцедуры

Процедура ЗаполнитьДополнительныеСвязиИПараметрыВыбора(Элемент, ДополнительныеПараметры) Экспорт
	
#Область СвязиПараметровВыбора 
	НовыеСвязиПараметровВыбора = Новый Массив;
	
	Для Каждого СвязьПараметровВыбора Из Элемент.СвязиПараметровВыбора Цикл
		НовыеСвязиПараметровВыбора.Добавить(СвязьПараметровВыбора);
		
		ИмяПараметра = СтрЗаменить(СвязьПараметровВыбора.Имя, "Отбор.", "");
		
		Если Найти(ДополнительныеПараметры, ИмяПараметра) > 0 Тогда
			НовыеСвязиПараметровВыбора.Добавить(Новый СвязьПараметраВыбора("ДополнительныеПараметры." + ИмяПараметра, СвязьПараметровВыбора.ПутьКДанным));
		КонецЕсли;
	КонецЦикла;
	
	Элемент.СвязиПараметровВыбора = Новый ФиксированныйМассив(НовыеСвязиПараметровВыбора);
#КонецОбласти	

#Область ПараметрыВыбора
	НовыеПараметрыВыбора = Новый Массив;
	
	Для Каждого ПараметрВыбора Из Элемент.ПараметрыВыбора Цикл
		НовыеПараметрыВыбора.Добавить(ПараметрВыбора);
		
		ИмяПараметра = СтрЗаменить(ПараметрВыбора.Имя, "Отбор.", "");
		
		Если Найти(ДополнительныеПараметры, ИмяПараметра) > 0 Тогда
			НовыеПараметрыВыбора.Добавить(Новый ПараметрВыбора("ДополнительныеПараметры." + ИмяПараметра, ПараметрВыбора.Значение));
		КонецЕсли;
	КонецЦикла;
	
	Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(НовыеПараметрыВыбора);
#КонецОбласти
	
КонецПроцедуры

Процедура ЗаписатьЗначениеДополнительногоСведенияОбъекта(Ссылка, ИмяКлюча, Значение) Экспорт
	
	ПланыВидовХарактеристик.ДополнительныеСведения.ЗаписатьЗначениеДополнительногоСведенияОбъекта(Ссылка, ИмяКлюча, Значение);
				
КонецПроцедуры

Процедура УстановитьПредставлениеЗначенийДляПоляТабличнойЧастиСоСпискомВыбора(Форма, Элемент) Экспорт

	Для Каждого ЭлементСпискаВыбора Из Элемент.СписокВыбора Цикл

		Если ПустаяСтрока(ЭлементСпискаВыбора.Представление) Тогда
			Продолжить;
		КонецЕсли;
		
        ЭлементУсловногоОформления = Форма.УсловноеОформление.Элементы.Добавить();
        ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", ЭлементСпискаВыбора.Представление);

        ЭлементУсловия = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
        ЭлементУсловия.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных(Элемент.ПутьКДанным);
        ЭлементУсловия.ВидСравнения		= ВидСравненияКомпоновкиДанных.Равно;
        ЭлементУсловия.ПравоеЗначение	= ЭлементСпискаВыбора.Значение;

        ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
        ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(Элемент.Имя);
		
	КонецЦикла;

КонецПроцедуры

#Область Работа_с_шаблонами

Процедура ЗагрузитьСписокШаблонов(Форма, ИмяЭлемента) Экспорт
	
	ИмяКоманды		= "КомандаНастройкаШаблонов_" + ИмяЭлемента;
	НоваяКоманда	= Форма.Команды.Найти(ИмяКоманды);
	
	Если НоваяКоманда = Неопределено Тогда
		
		Форма.Элементы[ИмяЭлемента].КнопкаВыпадающегоСписка = Истина;
		
		ДобавляемыеРеквизиты = Новый Массив();
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("АдресМассиваДобавленныхКоманд" + ИмяЭлемента, Новый ОписаниеТипов("Строка")));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СписокШаблонов_" + ИмяЭлемента, Новый ОписаниеТипов("СписокЗначений")));
		
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		Форма["АдресМассиваДобавленныхКоманд" + ИмяЭлемента] = ПоместитьВоВременноеХранилище(Неопределено, Форма.УникальныйИдентификатор);
		
		НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);	
		НоваяКоманда.Действие	= "КомандаНастройкаШаблонов_Подключаемый";
		НоваяКоманда.Заголовок	= "Настройка шаблонов";
		НоваяКоманда.Картинка	= БиблиотекаКартинок.Изменить;
		
		КнопкаФормы = Форма.Элементы.Найти(ИмяКоманды);
		Если КнопкаФормы = Неопределено Тогда
			КнопкаФормы = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Форма.Элементы[ИмяЭлемента].КонтекстноеМеню);
			КнопкаФормы.ИмяКоманды	= ИмяКоманды;
			КнопкаФормы.Заголовок	= НоваяКоманда.Заголовок;
		КонецЕсли; 
		
	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Хранилище = ХранилищеОбщихНастроек.Загрузить(Форма.ИмяФормы + "." + ИмяЭлемента, "СписокШаблонов", , "ВсеПользователи");
	
	Если ТипЗнч(Хранилище) = Тип("ХранилищеЗначения") Тогда
		
		СтруктураНастроек = Хранилище.Получить();
		Если СтруктураНастроек.Свойство("СписокШаблонов") Тогда
			Форма["СписокШаблонов_" + ИмяЭлемента].ЗагрузитьЗначения(СтруктураНастроек.СписокШаблонов);
		КонецЕсли; 
		
		ОбновитьКнопкиШаблонов(Форма, ИмяЭлемента);
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура СохранитьСписокШаблонов(Форма, ИмяЭлемента, СписокШаблонов) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Форма["СписокШаблонов_" + ИмяЭлемента] = СписокШаблонов;
	
	Структура = Новый Структура;
	Структура.Вставить("СписокШаблонов", СписокШаблонов.ВыгрузитьЗначения());
	ХранилищеОбщихНастроек.Сохранить(Форма.ИмяФормы + "." + ИмяЭлемента, "СписокШаблонов", Новый ХранилищеЗначения(Структура, Новый СжатиеДанных(9)),, "ВсеПользователи");
	
	ОбновитьКнопкиШаблонов(Форма, ИмяЭлемента); 
	
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Процедура ОбновитьКнопкиШаблонов(Форма, ИмяЭлемента) Экспорт
	
	МассивДобавленныхКоманд = ПолучитьИзВременногоХранилища(Форма["АдресМассиваДобавленныхКоманд" + ИмяЭлемента]);
	Если МассивДобавленныхКоманд = Неопределено Тогда
		МассивДобавленныхКоманд = Новый Массив;
	Иначе
		// удалим ранее созданные команды
		Для каждого ИмяКоманды Из МассивДобавленныхКоманд Цикл
			Форма.Команды.Удалить(Форма.Команды.Найти(ИмяКоманды));
			Форма.Элементы.Удалить(Форма.Элементы.Найти(ИмяКоманды));
		КонецЦикла; 
		МассивДобавленныхКоманд.Очистить();
	КонецЕсли; 
	
	Элемент = Форма.Элементы[ИмяЭлемента];
	Элемент.СписокВыбора.Очистить();
	
	МассивПутьКДанным = СтрРазделить(Элемент.ПутьКДанным, ".");
	ИмяРеквизита = МассивПутьКДанным[МассивПутьКДанным.ВГраница()];
	
	Для каждого ЭлементСписка Из Форма["СписокШаблонов_" + ИмяЭлемента] Цикл
		
		ИмяКоманды = ИмяРеквизита + "_Шаблон_" + ЭлементСписка.ПолучитьИдентификатор();
		
		НоваяКоманда = Форма.Команды.Найти(ИмяКоманды);
		Если НоваяКоманда = Неопределено Тогда
			НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);	
			НоваяКоманда.Действие = "ПриВыбореШаблона_Подключаемый";
			НоваяКоманда.Заголовок = ЭлементСписка.Значение;
			
			Если ТипЗнч(Элемент.Родитель) = Тип("ТаблицаФормы") Тогда
				НоваяКоманда.ИспользуемаяТаблица = Элемент.Родитель;
			КонецЕсли;
			
			КнопкаФормы = Форма.Элементы.Найти(ИмяКоманды);
			Если КнопкаФормы = Неопределено Тогда
				КнопкаФормы = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Элемент.КонтекстноеМеню);
				КнопкаФормы.ИмяКоманды = ИмяКоманды;
				КнопкаФормы.Заголовок = ЭлементСписка.Значение;
			КонецЕсли; 
			
			МассивДобавленныхКоманд.Добавить(ИмяКоманды);
		КонецЕсли; 
		
		Элемент.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Значение);
		
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(МассивДобавленныхКоманд, Форма["АдресМассиваДобавленныхКоманд" + ИмяЭлемента]);
	
КонецПроцедуры
	
#КонецОбласти

