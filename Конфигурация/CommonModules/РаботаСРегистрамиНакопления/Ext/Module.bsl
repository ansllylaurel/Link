
Процедура ЗаполнитьЗначенияСвойствДвижения(Движение, ЗначенияСвойств, СоответствияСвойств = Неопределено, РасчетныеСвойства = Неопределено) Экспорт

	ЗаполнитьЗначенияСвойств(Движение, ЗначенияСвойств);
	
	Если ТипЗнч(СоответствияСвойств) = Тип("Структура") Тогда
		Для каждого КлючЗнч Из СоответствияСвойств Цикл
			Движение[КлючЗнч.Ключ] = ЗначенияСвойств[КлючЗнч.Значение];
		КонецЦикла;
	КонецЕсли;

	Если ТипЗнч(РасчетныеСвойства) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Движение, РасчетныеСвойства);
	КонецЕсли;

КонецПроцедуры // ЗаполнитьЗначенияСвойствДвижения

Процедура СформироватьДвижения(НаборДвижений, ВидДвижения = Неопределено, Период, ПлановыеДвижения, СоответствияПолей = Неопределено) Экспорт
	
	
	Если ТипЗнч(ПлановыеДвижения) = Тип("ТаблицаЗначений")  Тогда
		
		Если ПлановыеДвижения.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Для каждого СтрокаПлановыеДвижения Из ПлановыеДвижения Цикл
			Движение = НаборДвижений.Добавить();
			
			Если ВидДвижения <> Неопределено Тогда
				Движение.ВидДвижения = ВидДвижения;
			КонецЕсли; 
			
			Движение.Период = Период;
			
			ЗаполнитьЗначенияСвойствДвижения(Движение, СтрокаПлановыеДвижения, СоответствияПолей);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ПлановыеДвижения) = Тип("ВыборкаИзРезультатаЗапроса")  Тогда
		
		Пока ПлановыеДвижения.Следующий() Цикл
			Движение = НаборДвижений.Добавить();
			
			Если ВидДвижения <> Неопределено Тогда
				Движение.ВидДвижения = ВидДвижения;
			КонецЕсли;
			
			Движение.Период = Период;
			
			ЗаполнитьЗначенияСвойствДвижения(Движение, ПлановыеДвижения, СоответствияПолей);
		КонецЦикла; 
		
		ПлановыеДвижения.Сбросить();
		
	КонецЕсли;
	
	Если НаборДвижений.Количество() <> 0 Тогда
		НаборДвижений.Записывать = Истина;
	КонецЕсли; 
	
КонецПроцедуры // СформироватьДвижения

