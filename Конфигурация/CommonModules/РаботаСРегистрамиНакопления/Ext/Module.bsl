Процедура СформироватьСводныеДвиженияПоТорговойКомиссииВСделке(Сделка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделка.Дата КАК Период,
		|	Сделка.Ссылка КАК Основание,
		|	ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская) КАК ТипЗадолженности,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии) КАК ВидЗадолженности,
		|	Сделка.Организация КАК Организация,
		|	Сделка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Сделка.ВалютаТорговойКомиссии КАК Валюта,
		|	Сделка.Брокер КАК Брокер,
		|	Сделка.МестоХранения КАК МестоХранения,
		|	Сделка.Брокер.ЮрФизЛицо КАК Контрагент,
		|	Сделка.РасчетныйСчет КАК РасчетныйСчет,
		|	СуммыЗадолженности.Сумма КАК Сумма,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.Оплата) КАК ВидДвиженияДенежныхСредств,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии) КАК ВариантДвиженияДенежныхСредств
		|ИЗ
		|	(ВЫБРАТЬ
		|		СделкаЦенныеБумаги.Ссылка КАК Ссылка,
		|		СУММА(СделкаЦенныеБумаги.ТорговаяКомиссия) КАК Сумма
		|	ИЗ
		|		Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|	ГДЕ
		|		СделкаЦенныеБумаги.Ссылка = &Ссылка
		|	
		|	СГРУППИРОВАТЬ ПО
		|		СделкаЦенныеБумаги.Ссылка
		|	
		|	ИМЕЮЩИЕ
		|		СУММА(СделкаЦенныеБумаги.ТорговаяКомиссия) > 0) КАК СуммыЗадолженности
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
		|		ПО (Сделка.Ссылка = СуммыЗадолженности.Ссылка)";

	Запрос.УстановитьПараметр("Ссылка", Сделка.Ссылка);
	
	ИмяДокумента = Сделка.Метаданные().Имя;
	
	Если ИмяДокумента = "СделкаРЕПО" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Сделка", "СделкаРЕПО");
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Сделка.Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход(), Выборка);
		
		Если Не Сделка.ОтложеннаяОплатаТорговойКомиссии Тогда
			ЗаполнитьЗначенияСвойств(Сделка.Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьРасход(), Выборка);
			ЗаполнитьЗначенияСвойств(Сделка.Движения.ОстаткиДенежныхСредств.ДобавитьРасход(), Выборка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // СформироватьСводныеДвиженияПоТорговойКомиссииВСделке

