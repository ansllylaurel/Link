// РАБОТА СО СВОДНЫМИ ФОРМАМИ

Функция СформироватьКлючСводнойФормы(ИмяФормы, ПараметрыФормы) Экспорт
	
	СоставКлючаСводнойФормы = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("Организация, Дата, СчетДоверительногоУправления, Брокер, МестоХранения, Рынок, Состояние", ",", Истина, Истина);
	
	КлючСводнойФормы = ИмяФормы;
	
	Для каждого ПолеКлючаСводнойФормы Из СоставКлючаСводнойФормы Цикл
		
		ЗнчПоляКлючаСводнойФормы = ПараметрыФормы[ПолеКлючаСводнойФормы];
		
		Если      ТипЗнч(ЗнчПоляКлючаСводнойФормы) = Тип("Дата") Или ТипЗнч(ЗнчПоляКлючаСводнойФормы) = Тип("Число") Или ТипЗнч(ЗнчПоляКлючаСводнойФормы) = Тип("Строка") Тогда
			КлючСводнойФормы = КлючСводнойФормы + "_" + Строка(ЗнчПоляКлючаСводнойФормы);
		ИначеЕсли Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ЗнчПоляКлючаСводнойФормы)) Тогда
			КлючСводнойФормы = КлючСводнойФормы + "_" + ЗнчПоляКлючаСводнойФормы.УникальныйИдентификатор();
		ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(ЗнчПоляКлючаСводнойФормы)) Тогда
			КлючСводнойФормы = КлючСводнойФормы + "_" + РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЗнчПоляКлючаСводнойФормы);
		Иначе
			Сообщить("Не удалось сформировать идентификатор сводной формы. Неверный тип параметра " + ПолеКлючаСводнойФормы + ". Обратитесь к разработчикам.");
			Возврат Новый УникальныйИдентификатор();
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат КлючСводнойФормы;
	
КонецФункции // СформироватьКлючСводнойФормы

Функция ПолучитьРеквизитыСводнойФормы(Документ) Экспорт
	
	ЗначенияПолейЖурнала = ПолучитьЗначенияПолейЖурналаИзДокумента(Документ);
	
	Если      ЗначенияПолейЖурнала.ВидОперации = Перечисления.ВидыОперацийБэкОфиса.СводнаяБиржеваяСделка Тогда
		ЗначенияПолейЖурнала.Вставить("ИмяФормы", "ОбщаяФорма.СводнаяБиржеваяСделка");
	ИначеЕсли ЗначенияПолейЖурнала.ВидОперации = Перечисления.ВидыОперацийБэкОфиса.СводноеИсполнениеОбязательствПоБиржевымСделкам Тогда
		ЗначенияПолейЖурнала.Вставить("ИмяФормы", "ОбщаяФорма.СводноеИсполнениеБиржевыхСделок");
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	// проверим, а есть ли запись в журнале, удовлетворяющая данным полям
	МенеджерЗаписи = РегистрыСведений.ЖурналОперацийБэкОфиса.СоздатьМенеджерЗаписи();
	
	Для каждого Измерение Из Метаданные.РегистрыСведений.ЖурналОперацийБэкОфиса.Измерения Цикл
		МенеджерЗаписи[Измерение.Имя] = ЗначенияПолейЖурнала[Измерение.Имя];
	КонецЦикла;	
	
	МенеджерЗаписи.Прочитать();
	
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// осталось только получить ключ уникальности формы
	ЗначенияПолейЖурнала.Вставить("КлючФормы",  СформироватьКлючСводнойФормы(ЗначенияПолейЖурнала.ИмяФормы, ЗначенияПолейЖурнала));
	
	Возврат ЗначенияПолейЖурнала;
	
КонецФункции // ПолучитьРеквизитыСводнойФормы

Функция ПолучитьВариантыСводнойФормы(ВыборкаДокументы) Экспорт
	
	ВариантыИсполнений = Новый Массив();
		
	Пока ВыборкаДокументы.Следующий() Цикл
		
		// получим реквизиты сводной формы
		РеквизитыСводнойФормы = ПолучитьРеквизитыСводнойФормы(ВыборкаДокументы.Ссылка);
		
		ЕстьАналогичныеРеквизитыСводнойФормы = Ложь;
		
		// проверим, а вдруг такие рекизиты исполнения уже были зафиксированы
		Для каждого ВариантИсполнения Из ВариантыИсполнений Цикл
			
			ЕстьАналогичныеРеквизитыСводнойФормы = Истина;
			
			Для каждого КлючЗнч Из ВариантИсполнения Цикл
				Если ВариантИсполнения[КлючЗнч.Ключ] <> РеквизитыСводнойФормы[КлючЗнч.Ключ] Тогда
					ЕстьАналогичныеРеквизитыСводнойФормы = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ЕстьАналогичныеРеквизитыСводнойФормы Тогда
				Прервать;
			КонецЕсли;
				
		КонецЦикла;			
		
		Если Не ЕстьАналогичныеРеквизитыСводнойФормы Тогда
			ВариантыИсполнений.Добавить(РеквизитыСводнойФормы);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ВариантыИсполнений;
	
КонецФункции // ПолучитьВариантыСводныхФорм

