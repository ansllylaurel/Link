// ВЫЗОВ ИЗ СОБЫТИЙ ДОКУМЕНТОВ

// Актуально только для документов, ссылка на которые не попадает в измерение "Документ"
// Например, "Сделка"
Процедура ПередЗаписьюДокумента(Документ) Экспорт
	
	Если Документ.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;	
	
	Если НЕ ПараметрыСеанса.ФормированиеДвиженийПоРегистрамБэкОфиса Тогда //бухгалтерия? -досвидания!
		Возврат;
	КонецЕсли;
	
	ВидОперации = Документ.Метаданные().Имя;
	
	Если ОперацияВключенаВЖурнал(ВидОперации) Тогда
		Документ.ДополнительныеСвойства.Вставить("ПредЗначенияПолейЖурналаОпераций", ПолучитьЗначенияПолейЖурналаИзДокумента(Документ.Ссылка));
	КонецЕсли;
	
КонецПроцедуры // ПередЗаписьюДокумента

Процедура ПриЗаписиДокумента(Документ) Экспорт
	
	Если НЕ ПараметрыСеанса.ФормированиеДвиженийПоРегистрамБэкОфиса Тогда //бухгалтерия? -досвидания!
		Возврат;
	КонецЕсли;
	
	ВидОперации = Документ.Метаданные().Имя;
	
	Если ОперацияВключенаВЖурнал(ВидОперации) Тогда
		ЗарегистрироватьОперациюВЖурнале(Документ);
	КонецЕсли;
	
КонецПроцедуры // ПриЗаписиДокумента

Процедура ПередУдалениемДокумента(Документ) Экспорт

	ВидОперации = Документ.Метаданные().Имя;
	
	Если ОперацияВключенаВЖурнал(ВидОперации) Тогда
		УдалитьОперациюИзЖурнала(Документ);
	КонецЕсли;
	
КонецПроцедуры

