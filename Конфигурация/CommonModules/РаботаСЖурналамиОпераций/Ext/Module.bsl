		|			ИЛИ &Ссылка = ЗНАЧЕНИЕ(Документ.ИсполнениеОбязательствПоСделке.ПустаяСсылка))
		|	И ИсполнениеОбязательствПоСделке.Организация = &Организация
		|	И ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(ИсполнениеОбязательствПоСделке.Дата, ДЕНЬ), МИНУТА, &КоличествоМинут) = &Дата
		|	И ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ИсполнениеОбязательствПоСделке.МестоХранения = &МестоХранения
		|	И ИсполнениеОбязательствПоСделке.Брокер = &Брокер
		|	И ИсполнениеОбязательствПоСделке.Рынок = &Рынок
		|	И ИсполнениеОбязательствПоСделке.Проведен = &Проведен
		|	И ИсполнениеОбязательствПоСделке.ПометкаУдаления = &ПометкаУдаления";
		
	Запрос.УстановитьПараметр("Организация",                  ЗнчПолейЖурнала.Организация);
	Запрос.УстановитьПараметр("Дата",                         ЗнчПолейЖурнала.Дата);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЗнчПолейЖурнала.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("МестоХранения",                ЗнчПолейЖурнала.МестоХранения);
	Запрос.УстановитьПараметр("Брокер",                       ЗнчПолейЖурнала.Брокер);
	Запрос.УстановитьПараметр("Рынок",                        ЗнчПолейЖурнала.Рынок);
	Запрос.УстановитьПараметр("Проведен",                     (ЗнчПолейЖурнала.Состояние = Перечисления.СостоянияДокументов.Проведен));
	Запрос.УстановитьПараметр("ПометкаУдаления",              (ЗнчПолейЖурнала.Состояние = Перечисления.СостоянияДокументов.ПомеченНаУдаление));
	Запрос.УстановитьПараметр("Ссылка",                       ИсклДокумент.Ссылка);
	Запрос.УстановитьПараметр("КоличествоМинут",              ?(ЗнчПолейЖурнала.Брокер = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ"), 9*60+30, 17*60));

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции // ЕстьАналогичныеИсполнениеОбязательствПоСделке


Процедура ОтменитьРегистрациюБиржевойСделки(Документ)
	Перем ПредЗнчПолейЖурнала, ПредМестоХранения;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не Документ.ДополнительныеСвойства.Свойство("ПредЗначенияПолейЖурналаОпераций", ПредЗнчПолейЖурнала) Тогда
		Возврат;
	КонецЕсли;
	
	Если ПредЗнчПолейЖурнала.МестоХранения <> Справочники.МестаХранения.ВнебиржевойРынок Тогда
		
		Если Не ЕстьАналогичныеБиржевыеСделки(ПредЗнчПолейЖурнала, Документ) Тогда
			НаборЗаписейЖурнала = РегистрыСведений.ЖурналОперацийБэкОфиса.СоздатьНаборЗаписей();
			
			Для каждого ЭлементОтбора Из НаборЗаписейЖурнала.Отбор Цикл
				ЭлементОтбора.Установить(ПредЗнчПолейЖурнала[ЭлементОтбора.Имя]);
			КонецЦикла;
			
			НаборЗаписейЖурнала.Записать();
		КонецЕсли;
		
	ИначеЕсли Документ.МестоХранения <> Справочники.МестаХранения.ВнебиржевойРынок Тогда
		
		НаборЗаписейЖурнала = РегистрыСведений.ЖурналОперацийБэкОфиса.СоздатьНаборЗаписей();
		НаборЗаписейЖурнала.Отбор.Документ.Установить(Документ.Ссылка);
		НаборЗаписейЖурнала.Записать();
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры // ОтменитьРегистрациюБиржевойСделки

