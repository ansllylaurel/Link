Процедура ЗарегистрироватьДокумент(Документ)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НовыеЗнчПолейЖурнала = ПолучитьЗначенияПолейЖурналаИзДокумента(Документ);
	
	Записывать = Неопределено;
	
	// !!! Пришлось делать через набор записей т.к. через менеджер записи 1ска НЕ РАБОТАЕТ
	НаборЗаписейЖурнала = РегистрыСведений.ЖурналОперацийБэкОфиса.СоздатьНаборЗаписей();
	НаборЗаписейЖурнала.Отбор.Документ.Установить(Документ.Ссылка);
	НаборЗаписейЖурнала.Прочитать();
	
	Если НаборЗаписейЖурнала.Количество() = 1 Тогда
		ЗаписьЖурнала = НаборЗаписейЖурнала[0];
		
		// проверим наличие изменных записей
		Записывать = Ложь;
		
		Для каждого КлючЗнч Из НовыеЗнчПолейЖурнала Цикл
			Если КлючЗнч.Значение <> ЗаписьЖурнала[КлючЗнч.Ключ] Тогда
				Записывать = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		ЗаписьЖурнала = НаборЗаписейЖурнала.Добавить();
		
		Записывать = Истина;
	КонецЕсли;
	// !!! Пришлось делать через набор записей т.к. через менеджер записи 1ска НЕ РАБОТАЕТ
	
	Если Записывать Тогда
		ЗаполнитьЗначенияСвойств(ЗаписьЖурнала, НовыеЗнчПолейЖурнала);
		НаборЗаписейЖурнала.Записать();
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры // ЗарегистрироватьДокумент
