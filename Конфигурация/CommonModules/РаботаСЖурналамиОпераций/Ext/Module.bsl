Функция ОперацияВключенаВЖурнал(ВидОперации) Экспорт
	
	Возврат Не (Метаданные.Перечисления.ВидыОперацийБэкОфиса.ЗначенияПеречисления.Найти(ВидОперации) = Неопределено);
	
КонецФункции // ОперацияВключенаВЖурнал

Функция ПолучитьСтруктуруПолейЖурнала()
	
	СтруктураПолей = Новый Структура;
	
	ЖурналОперацийМД = Метаданные.РегистрыСведений.ЖурналОперацийБэкОфиса;
	
	Для каждого Поле Из ЖурналОперацийМД.Измерения Цикл
		СтруктураПолей.Вставить(Поле.Имя);
	КонецЦикла;
	
	Для каждого Поле Из ЖурналОперацийМД.Ресурсы Цикл
		СтруктураПолей.Вставить(Поле.Имя);
	КонецЦикла;
	
	Для каждого Поле Из ЖурналОперацийМД.Реквизиты Цикл
		СтруктураПолей.Вставить(Поле.Имя);
	КонецЦикла;
	
	Возврат СтруктураПолей;
	
КонецФункции // ПолучитьСтруктуруПолейЖурнала

Процедура УстановитьЗначенияРасчетныхПолейЖурнала(ЗнчПолейЖурнала, Документ)
	
	ВидыОперацийЖурнала = Перечисления.ВидыОперацийБэкОфиса;
	
	// "перекроем" значения расчетных полей
	ДокументМД  = Документ.Метаданные();
	ВидОперации = ДокументМД.Имя;
	
	// значения, общие для всех документов
	ЗнчПолейЖурнала.Документ    = Документ.Ссылка;
	ЗнчПолейЖурнала.ВидОперации = ВидыОперацийЖурнала[ВидОперации];
	ЗнчПолейЖурнала.Состояние   = Перечисления.СостоянияДокументов.ПолучитьСостояниеДокумента(Документ);
	
	ЗнчПолейЖурнала.ПредставлениеОперации = Строка(Документ);
	
	// ценные бумаги, [рынок]
	Если      ВидОперации = "КонвертацияЦенныхБумаг" Тогда
		ЗнчПолейЖурнала.ЦеннаяБумага = Документ.ЦеннаяБумага;
		
	ИначеЕсли ВидОперации = "ПогашениеКупона" Тогда
		ЗнчПолейЖурнала.ЦеннаяБумага = Документ.Облигация;
		ЗнчПолейЖурнала.Рынок        = Перечисления.РынкиЦенныхБумаг.Облигации;

	ИначеЕсли ВидОперации = "ВводЦенныхБумаг" Или ВидОперации = "ВыводЦенныхБумаг"
		Или ВидОперации = "ПереводЦенныхБумаг" Или ВидОперации = "ПоставкаЦенныхБумаг"
		Или ВидОперации = "ИзменениеУсловийСделки"
		Или ((ВидОперации = "Сделка" Или ВидОперации = "ИсполнениеОбязательствПоСделке") И ЗнчПолейЖурнала.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок)
	Тогда
		Если Документ.ЦенныеБумаги.Количество() = 1 Тогда
			ЗнчПолейЖурнала.ЦеннаяБумага = Документ.ЦенныеБумаги[0].ЦеннаяБумага;
		КонецЕсли;
		
	КонецЕсли;
	
	// место хранения
	Если ДокументМД.Реквизиты.Найти("МестоХранения") = Неопределено Тогда
		ЗнчПолейЖурнала.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок;
	КонецЕсли;
	
	// прочие
	Если      ВидОперации = "Сделка" И ЗначениеЗаполнено(ЗнчПолейЖурнала.МестоХранения) И ЗнчПолейЖурнала.МестоХранения <> Справочники.МестаХранения.ВнебиржевойРынок Тогда
		ЗнчПолейЖурнала.Документ      = Неопределено;
		ЗнчПолейЖурнала.Ответственный = Справочники.Пользователи.ПустаяСсылка();
		ЗнчПолейЖурнала.Комментарий   = "";
		ЗнчПолейЖурнала.Дата          = НачалоДня(ЗнчПолейЖурнала.Дата) + 10*60*60;
		ЗнчПолейЖурнала.ВидОперации   = ВидыОперацийЖурнала.СводнаяБиржеваяСделка;
		
		ЗнчПолейЖурнала.ПредставлениеОперации = "Биржевые операции"
			+ ?(ЗначениеЗаполнено(ЗнчПолейЖурнала.Рынок), ", " + ЗнчПолейЖурнала.Рынок, "")
			+ ?(ЗначениеЗаполнено(ЗнчПолейЖурнала.Брокер), ", " + ЗнчПолейЖурнала.Брокер, "");
			
	ИначеЕсли ВидОперации = "ИсполнениеОбязательствПоСделке" И ЗначениеЗаполнено(ЗнчПолейЖурнала.МестоХранения) И ЗнчПолейЖурнала.МестоХранения <> Справочники.МестаХранения.ВнебиржевойРынок Тогда
		ЗнчПолейЖурнала.Документ      = Неопределено;
		ЗнчПолейЖурнала.Ответственный = Справочники.Пользователи.ПустаяСсылка();
		ЗнчПолейЖурнала.Комментарий   = "";
		ЗнчПолейЖурнала.Дата          = НачалоДня(ЗнчПолейЖурнала.Дата) + ?(ЗнчПолейЖурнала.Брокер = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ"), 9*60*60+30*60, 17*60*60);
		ЗнчПолейЖурнала.ВидОперации   = ВидыОперацийЖурнала.СводноеИсполнениеОбязательствПоБиржевымСделкам;
		
		ЗнчПолейЖурнала.ПредставлениеОперации = "Исполнения биржевых сделок"
			+ ?(ЗначениеЗаполнено(ЗнчПолейЖурнала.Рынок), ", " + ЗнчПолейЖурнала.Рынок, "")
			+ ?(ЗначениеЗаполнено(ЗнчПолейЖурнала.Брокер), ", " + ЗнчПолейЖурнала.Брокер, "");
			
	ИначеЕсли ВидОперации = "ПоставкаЦенныхБумаг" И ЗначениеЗаполнено(Документ.Основание) Тогда
		ЗнчПолейЖурнала.МестоХранения = Документ.Основание.МестоХранения;
		ЗнчПолейЖурнала.Брокер        = Документ.Основание.Брокер;
		
	КонецЕсли;
	
	// номер и представление вида документа
	Если ЗнчПолейЖурнала.ВидОперации = ВидыОперацийЖурнала.СводнаяБиржеваяСделка
		Или ЗнчПолейЖурнала.ВидОперации = ВидыОперацийЖурнала.СводноеИсполнениеОбязательствПоБиржевымСделкам
	Тогда
		ЗнчПолейЖурнала.ПредставлениеВидаОперации = Строка(ЗнчПолейЖурнала.ВидОперации);
		
		// Уберем из ключевых полей
		ЗнчПолейЖурнала.Удалить("Номер");
		
	Иначе
		ЗнчПолейЖурнала.Номер = СокрЛП(Документ.Номер);
		
		// из представления документа нужно отрезать номер и все, что расположено справа от него
		ЗнчПолейЖурнала.ПредставлениеВидаОперации = Лев(
			ЗнчПолейЖурнала.ПредставлениеОперации,
			Найти(ЗнчПолейЖурнала.ПредставлениеОперации, " " + ЗнчПолейЖурнала.Номер + " ") - 1);
		
	КонецЕсли;
	
	// сумма
	Если      ВидОперации = "ВводЦенныхБумаг" Тогда
	    ЗнчПолейЖурнала.Сумма = Документ.ЦенныеБумаги.Итог("Сумма");
	ИначеЕсли ВидОперации = "ВыводЦенныхБумаг" Тогда
	    ЗнчПолейЖурнала.Сумма = Документ.ЦенныеБумаги.Итог("СуммаРынок");
	ИначеЕсли ВидОперации = "Оплата" Тогда
	    ЗнчПолейЖурнала.Сумма = Документ.Основания.Итог("Сумма");
		Если ЗнчПолейЖурнала.Сумма = 0 Тогда
			ЗнчПолейЖурнала.Сумма = Документ.Основания.Итог("СуммаКупона");
		КонецЕсли;
	ИначеЕсли ВидОперации = "ПогашениеКупона" Тогда
	    ЗнчПолейЖурнала.Сумма = Документ.СуммаКупона;
	ИначеЕсли ВидОперации = "ПоставкаЦенныхБумаг" Тогда
	    ЗнчПолейЖурнала.Сумма = Документ.ЦенныеБумаги.Итог("Сумма");
	ИначеЕсли ВидОперации = "НачислениеЗадолженности" Тогда
	    ЗнчПолейЖурнала.Сумма = Документ.Основания.Итог("Сумма");
	ИначеЕсли ВидОперации = "Сделка" И ЗнчПолейЖурнала.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок Тогда
	    ЗнчПолейЖурнала.Сумма = Документ.ЦенныеБумаги.Итог("Сумма");
	ИначеЕсли ВидОперации = "СделкаРЕПО" Тогда
	    ЗнчПолейЖурнала.Сумма = Документ.ЦенныеБумаги.Итог("Сумма");
	КонецЕсли;
	
	// типизация значения ключевых полей, чтобы исключить проблемы при поиске расхождений
	Если Не ЗначениеЗаполнено(ЗнчПолейЖурнала.Рынок) Тогда
		ЗнчПолейЖурнала.Рынок = Перечисления.РынкиЦенныхБумаг.ПустаяСсылка();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗнчПолейЖурнала.МестоХранения) Тогда
		ЗнчПолейЖурнала.МестоХранения = Справочники.МестаХранения.ПустаяСсылка();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗнчПолейЖурнала.Брокер) Тогда
		ЗнчПолейЖурнала.Брокер = Справочники.БрокерскиеКомпании.ПустаяСсылка();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗнчПолейЖурнала.Сумма) Тогда
		ЗнчПолейЖурнала.Сумма = 0;
	КонецЕсли;
	
КонецПроцедуры // УстановитьЗначенияРасчетныхПолейЖурнала

Функция ПолучитьЗначенияПолейЖурналаИзДокумента(Документ) Экспорт
	
	ЗнчПолейЖурнала = ПолучитьСтруктуруПолейЖурнала();
	ЗаполнитьЗначенияСвойств(ЗнчПолейЖурнала, Документ);
	
	УстановитьЗначенияРасчетныхПолейЖурнала(ЗнчПолейЖурнала, Документ);
	
	Возврат ЗнчПолейЖурнала;
	
КонецФункции // ПолучитьЗначенияПолейЖурналаИзДокумента

Процедура ЗаполнитьИзмеренияЖурналаЗначениями(ЗаписьЖурнала, ЗнчПолейЖурнала)
	
	ЗаписьЖурнала.Организация                  = ЗнчПолейЖурнала.Организация;
	ЗаписьЖурнала.Дата                         = ЗнчПолейЖурнала.Дата;
	ЗаписьЖурнала.СчетДоверительногоУправления = ЗнчПолейЖурнала.СчетДоверительногоУправления;
	ЗаписьЖурнала.Брокер                       = ЗнчПолейЖурнала.Брокер;
	ЗаписьЖурнала.МестоХранения                = ЗнчПолейЖурнала.МестоХранения;
	ЗаписьЖурнала.Рынок                        = ЗнчПолейЖурнала.Рынок;
	ЗаписьЖурнала.Документ                     = ЗнчПолейЖурнала.Документ;
	ЗаписьЖурнала.ВидОперации                  = ЗнчПолейЖурнала.ВидОперации;
	ЗаписьЖурнала.Состояние                    = ЗнчПолейЖурнала.Состояние;
	
КонецПроцедуры // ЗаполнитьИзмеренияЖурналаЗначениями


Функция ДобавитьЭлементБлокировки(Блокировка, Документ, ИзПредыдущегоСостояния)
	
	// По-особому у нас обрабатываются только биржевые сделки и их исполнения, т.к. по этим документам
	// создаются сводные записи, в которых отсутствует ссылка на сам документ
	
	// Т.к. сводная запись по набору измерений м.б. только одна, то на точное расчетное время, которое зависит от
	// типа документа и брокера, нам пофигу. Для блокировки вполне достаточно, чтобы оно было общим за день,
	// поэтому приводим его к началу дня
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЖурналОперацийБэкОфиса");
	
	Если ИзПредыдущегоСостояния Тогда
		РеквизитыДокумента = Документ.ДополнительныеСвойства.ПредЗначенияРеквизитовШапки;
	Иначе
		РеквизитыДокумента = Документ;
	КонецЕсли;		
	
	Если      ТипЗнч(Документ) = Тип("ДокументОбъект.Сделка") И РеквизитыДокумента.МестоХранения <> Справочники.МестаХранения.ВнебиржевойРынок Тогда
		
		ЭлементБлокировки.УстановитьЗначение("Дата",                         НачалоДня(РеквизитыДокумента.Дата));
		ЭлементБлокировки.УстановитьЗначение("Организация",                  РеквизитыДокумента.Организация);
		ЭлементБлокировки.УстановитьЗначение("СчетДоверительногоУправления", РеквизитыДокумента.СчетДоверительногоУправления);
		ЭлементБлокировки.УстановитьЗначение("Брокер",                       РеквизитыДокумента.Брокер);
		ЭлементБлокировки.УстановитьЗначение("ВидОперации",                  Перечисления.ВидыОперацийБэкОфиса.СводнаяБиржеваяСделка);
		ЭлементБлокировки.УстановитьЗначение("Документ",                     Документы.Сделка.ПустаяСсылка());
		
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.ИсполнениеОбязательствПоСделке") И РеквизитыДокумента.МестоХранения <> Справочники.МестаХранения.ВнебиржевойРынок Тогда
		
		ЭлементБлокировки.УстановитьЗначение("Дата",                         НачалоДня(РеквизитыДокумента.Дата));
		ЭлементБлокировки.УстановитьЗначение("Организация",                  РеквизитыДокумента.Организация);
		ЭлементБлокировки.УстановитьЗначение("СчетДоверительногоУправления", РеквизитыДокумента.СчетДоверительногоУправления);
		ЭлементБлокировки.УстановитьЗначение("Брокер",                       РеквизитыДокумента.Брокер);
		ЭлементБлокировки.УстановитьЗначение("ВидОперации",                  Перечисления.ВидыОперацийБэкОфиса.СводноеИсполнениеОбязательствПоБиржевымСделкам);
		ЭлементБлокировки.УстановитьЗначение("Документ",                     Документы.ИсполнениеОбязательствПоСделке.ПустаяСсылка());
		
	Иначе
		
		ЭлементБлокировки.УстановитьЗначение("Документ", Документ.Ссылка);
		
	КонецЕсли;
	
КонецФункции // ДобавитьЭлементБлокировки

Процедура УстановитьБлокировкуЖурнала(Документ)
	
	Если МонопольныйРежим() Тогда
		Возврат;                                                          
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	// блокировка по новому состоянию документа
	ДобавитьЭлементБлокировки(Блокировка, Документ, Ложь);
	
	// для ранее записанных документо заблокируемм также и старое состояние;
	// даже если оно продублирует новое состояние - ничего страшного
	Если Документ.ДополнительныеСвойства.Свойство("ЭтоНовый") Тогда
		// #ТехДолг 21.05.2020 Сережа К
		//	оказывается, не все документ перед записью (корректировка, в частности) вызывают общие механизмы,
		//	которые заполняют доп. свойства; в рамках задачи #318696 нужно написать инструкцию и скрипт
		//	для проверки всех объектов мд на соответствие ей
		Если Не Документ.ДополнительныеСвойства.ЭтоНовый Тогда
			ДобавитьЭлементБлокировки(Блокировка, Документ, Истина);
		КонецЕсли;
	КонецЕсли;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры // УстановитьБлокировкуЖурнала

Процедура УдалитьОперациюИзЖурнала(Документ)
	
	УстановитьПривилегированныйРежим(Истина);
	
	// установим блокировку
	УстановитьБлокировкуЖурнала(Документ);
	
	Если ТипЗнч(Документ) = Тип("ДокументОбъект.Сделка") И Документ.МестоХранения <> Справочники.МестаХранения.ВнебиржевойРынок Тогда
		
		ЗнчПолейЖурнала = ПолучитьЗначенияПолейЖурналаИзДокумента(Документ);
		
		Если Не ЕстьАналогичныеБиржевыеСделки(ЗнчПолейЖурнала, Документ) Тогда
			// запись удаляем только тогда, когда не осталось больше аналогичных документов
			НаборЗаписейЖурнала = РегистрыСведений.ЖурналОперацийБэкОфиса.СоздатьНаборЗаписей();

			Для каждого ЭлементОтбора Из НаборЗаписейЖурнала.Отбор Цикл
				ЭлементОтбора.Установить(ЗнчПолейЖурнала[ЭлементОтбора.Имя]);
			КонецЦикла;
			
			НаборЗаписейЖурнала.Записать();
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.ИсполнениеОбязательствПоСделке") И Документ.МестоХранения <> Справочники.МестаХранения.ВнебиржевойРынок Тогда
		
		ЗнчПолейЖурнала = ПолучитьЗначенияПолейЖурналаИзДокумента(Документ);
		
		Если Не ЕстьАналогичныеИсполнениеОбязательствПоСделке(ЗнчПолейЖурнала, Документ) Тогда
			// запись удаляем только тогда, когда не осталось больше аналогичных документов
			НаборЗаписейЖурнала = РегистрыСведений.ЖурналОперацийБэкОфиса.СоздатьНаборЗаписей();

			Для каждого ЭлементОтбора Из НаборЗаписейЖурнала.Отбор Цикл
				ЭлементОтбора.Установить(ЗнчПолейЖурнала[ЭлементОтбора.Имя]);
			КонецЦикла;
			
			НаборЗаписейЖурнала.Записать();
		КонецЕсли;
		
	Иначе
		
		НаборЗаписейЖурнала = РегистрыСведений.ЖурналОперацийБэкОфиса.СоздатьНаборЗаписей();
		НаборЗаписейЖурнала.Отбор.Документ.Установить(Документ.Ссылка);
		НаборЗаписейЖурнала.Записать();
	
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры // УдалитьОперациюИзЖурнала

Процедура ЗарегистрироватьОперациюВЖурнале(Документ)
	
	// проверим, а есть ли вид данного документа, среди видов документов УК
	ВидОперации = Документ.Метаданные().Имя;
	
	// в целях ускорения записи, проверим, изменились ли значения ключевых полей
	// для тех документов, у которых зафиксированы пред. значения (например, сводные сделки)
	Если Документ.ДополнительныеСвойства.Свойство("ПредЗначенияПолейЖурналаОпераций") Тогда
		ЕстьИзмененияКлючевыхПолей = Ложь;
		
		ТекущиеЗначенияПолейЖурналаОпераций = ПолучитьЗначенияПолейЖурналаИзДокумента(Документ);
		
		Для каждого КлючЗначение Из ТекущиеЗначенияПолейЖурналаОпераций Цикл
			Если КлючЗначение.Значение <> Документ.ДополнительныеСвойства.ПредЗначенияПолейЖурналаОпераций[КлючЗначение.Ключ] Тогда
				ЕстьИзмененияКлючевыхПолей = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ЕстьИзмененияКлючевыхПолей Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// установим блокировку
	УстановитьБлокировкуЖурнала(Документ);
	
	Если ТипЗнч(Документ) = Тип("ДокументОбъект.Сделка") Тогда
		
		ОтменитьРегистрациюБиржевойСделки(Документ);
		
		Если Документ.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок Тогда
			ЗарегистрироватьДокумент(Документ);
		Иначе
			ЗарегистрироватьБиржевуюСделку(Документ);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.ИсполнениеОбязательствПоСделке") Тогда
		
		ОтменитьРегистрациюИсполненияОбязательствПоСделке(Документ);
		
		Если Документ.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок Тогда
			ЗарегистрироватьДокумент(Документ);
		Иначе
			ЗарегистрироватьИсполнениеОбязательствПоСделке(Документ);
		КонецЕсли;
		
	Иначе	
		
		ЗарегистрироватьДокумент(Документ);
		
	КонецЕсли;
	
КонецПроцедуры // ЗарегистрироватьОперациюВЖурнале

	
Функция ЕстьАналогичныеБиржевыеСделки(ЗнчПолейЖурнала, ИсклДокумент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделка.Ссылка
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|ГДЕ
		|	(Сделка.Ссылка <> &Ссылка
		|			ИЛИ &Ссылка = ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка))
		|	И Сделка.Организация = &Организация
		|	И ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(Сделка.Дата, ДЕНЬ), ЧАС, 10) = &Дата
		|	И Сделка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И Сделка.МестоХранения = &МестоХранения
		|	И Сделка.Брокер = &Брокер
		|	И Сделка.Рынок = &Рынок
		|	И Сделка.Проведен = &Проведен
		|	И Сделка.ПометкаУдаления = &ПометкаУдаления";
		
	Запрос.УстановитьПараметр("Организация",                  ЗнчПолейЖурнала.Организация);
	Запрос.УстановитьПараметр("Дата",                         ЗнчПолейЖурнала.Дата);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЗнчПолейЖурнала.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("МестоХранения",                ЗнчПолейЖурнала.МестоХранения);
	Запрос.УстановитьПараметр("Брокер",                       ЗнчПолейЖурнала.Брокер);
	Запрос.УстановитьПараметр("Рынок",                        ЗнчПолейЖурнала.Рынок);
	Запрос.УстановитьПараметр("Проведен",                     (ЗнчПолейЖурнала.Состояние = Перечисления.СостоянияДокументов.Проведен));
	Запрос.УстановитьПараметр("ПометкаУдаления",              (ЗнчПолейЖурнала.Состояние = Перечисления.СостоянияДокументов.ПомеченНаУдаление));
	Запрос.УстановитьПараметр("Ссылка",                       ИсклДокумент.Ссылка);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции // ЕстьАналогичныеБиржевыеСделки

Функция ЕстьАналогичныеИсполнениеОбязательствПоСделке(ЗнчПолейЖурнала, ИсклДокумент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсполнениеОбязательствПоСделке.Ссылка
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
