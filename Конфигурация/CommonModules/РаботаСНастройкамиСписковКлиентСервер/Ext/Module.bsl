// СЛУЖЕБНЫЕ

// Поиск элементов и групп отбора динамического списка по ключу или представлению, если ключ не задан
//
// Параметры:
//   Контейнер     - контейнер с элементами и группами отбора, например "Список.Отбор" или группа в отборе
//   Ключ          - поле компоновки данных, имя поля компоновки или структура, содержащая свойства элемента компоновки (не используется для групп)
//   Представление - строка поиска (используется вместо ключа, если он не задан)
//
Функция НайтиЭлементыИГруппыОтбора(Контейнер, Знач Ключ = Неопределено, Представление = Неопределено) Экспорт
	
	МассивЭлементов = Новый Массив;
	
	НайтиЭлементыИГруппыОтбораРекурсивно(Контейнер.Элементы, МассивЭлементов, ?(ЗначениеЗаполнено(Ключ), Ключ, Представление), Не ЗначениеЗаполнено(Ключ));
	
	Возврат МассивЭлементов;
	
КонецФункции // НайтиЭлементыИГруппыОтбора

// Изменение элементов отбора, соответствующих ключу или представлению, если ключ не задан
//
// Параметры:
//   Контейнер        - контейнер с элементами и группами отбора, например "Список.Отбор" или группа в отборе
//   Ключ             - поле компоновки данных, имя поля компоновки или структура, содержащая свойства элемента компоновки (не используется для групп)
// Устанавливаемые значения (если заданы):
//   Представление    - представление поля компоновки (также используется вместо ключа, если он не задан)
//   ПравоеЗначение   - произвольный
//   ВидСравнения     - ВидСравненияКомпоновкиДанных
//   Использование    - булево
//   РежимОтображения - РежимОтображенияЭлементаНастройкиКомпоновкиДанных
//
Функция ИзменитьЭлементыОтбора(Контейнер, Ключ, Представление = Неопределено, ВидСравнения = Неопределено, ПравоеЗначение = Неопределено, Использование = Неопределено, РежимОтображения = Неопределено)
	
	МассивЭлементов = НайтиЭлементыИГруппыОтбора(Контейнер, Ключ, Представление);
	
	Для Каждого Элемент Из МассивЭлементов Цикл
		Если Представление <> Неопределено Тогда
			Элемент.Представление = Представление;
		КонецЕсли;
		Если Использование <> Неопределено Тогда
			Элемент.Использование = Использование;
		КонецЕсли;
		Если ВидСравнения <> Неопределено Тогда
			Элемент.ВидСравнения = ВидСравнения;
		КонецЕсли;
		Если ПравоеЗначение <> Неопределено Тогда
			Элемент.ПравоеЗначение = ПравоеЗначение;
		КонецЕсли;
		Если РежимОтображения <> Неопределено Тогда
			Элемент.РежимОтображения = РежимОтображения;
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивЭлементов.Количество();
	
КонецФункции // ИзменитьЭлементыОтбора

Функция ЭлементОтбораСоответствуетКлючу(ЭлементОтбора, Ключ)
	
	ПолноеСоответствие = Неопределено;
	
	Если ТипЗнч(Ключ) = Тип("Структура") Тогда
		ПолноеСоответствие = Истина;
		
		// последовательно и поименно проверим соответствие свойств элемента отбора и переданных свойств ключа
		Для каждого ЭлементКлюча Из Ключ Цикл
			Если      ВРег(ЭлементКлюча.Ключ) = ВРег("ЛевоеЗначение") Тогда
				ПолноеСоответствие = (ЭлементОтбора.ЛевоеЗначение = ЭлементКлюча.Значение);
			ИначеЕсли ВРег(ЭлементКлюча.Ключ) = ВРег("ИмяПоля") Тогда
				ПолноеСоответствие = (ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ЭлементКлюча.Значение));
			ИначеЕсли ВРег(ЭлементКлюча.Ключ) = ВРег("ВидСравнения") Тогда
				ПолноеСоответствие = (ЭлементОтбора.ВидСравнения = ЭлементКлюча.Значение);
			ИначеЕсли ВРег(ЭлементКлюча.Ключ) = ВРег("ПравоеЗначение") Тогда
				ПолноеСоответствие = (ЭлементОтбора.ПравоеЗначение = ЭлементКлюча.Значение);
			ИначеЕсли ВРег(ЭлементКлюча.Ключ) = ВРег("Использование") Тогда
				ПолноеСоответствие = (ЭлементОтбора.Использование = ЭлементКлюча.Значение);
			ИначеЕсли ВРег(ЭлементКлюча.Ключ) = ВРег("РежимОтображения") Тогда
				ПолноеСоответствие = (ЭлементОтбора.РежимОтображения = ЭлементКлюча.Значение);
			ИначеЕсли ВРег(ЭлементКлюча.Ключ) = ВРег("Представление") Тогда
				ПолноеСоответствие = (ЭлементОтбора.Представление = ЭлементКлюча.Значение);
			КонецЕсли;
				
			Если Не ПолноеСоответствие Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		ПолноеСоответствие = (ЭлементОтбора.ЛевоеЗначение = ?(ТипЗнч(Ключ) = Тип("Строка"), Новый ПолеКомпоновкиДанных(Ключ), Ключ));
			
	КонецЕсли;

	Возврат ПолноеСоответствие;
	
КонецФункции // ЭлементОтбораСоответствуетКлючу

Процедура НайтиЭлементыИГруппыОтбораРекурсивно(Контейнер, МассивЭлементов, Ключ, ИскатьПоПредставлению)
	
	Для каждого ЭлементОтбора Из Контейнер Цикл
		Если ИскатьПоПредставлению И ЭлементОтбора.Представление = Ключ Тогда
			МассивЭлементов.Добавить(ЭлементОтбора);
		КонецЕсли;
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Если Не ИскатьПоПредставлению Тогда
				Если ЭлементОтбораСоответствуетКлючу(ЭлементОтбора, Ключ) Тогда
					МассивЭлементов.Добавить(ЭлементОтбора);
				КонецЕсли;
			КонецЕсли;
		Иначе
			НайтиЭлементыИГруппыОтбораРекурсивно(ЭлементОтбора.Элементы, МассивЭлементов, Ключ, ИскатьПоПредставлению);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // НайтиЭлементыИГруппыОтбораРекурсивно
