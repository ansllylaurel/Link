// МОДИФИКАЦИЯ ЭЛЕМЕНТОВ ОТБОРА ДИНАМИЧЕСКОГО СПИСКА

// Изменяет найденные элементы отбора по ключу, или создает новый, если таковые не были найдены
//
// Параметры
//   Контейнер - контейнер с элементами и группами отбора, например "Список.Отбор" или группа в отборе
//   Ключ      - поле компоновки данных, имя поля компоновки или структура, содержащая свойства элемента компоновки (не используется для групп)
// Устанавливаемые поля:
//   Представление    - строка (используется вместо ключа, если он не задан)
//   ВидСравнения     - ВидСравненияКомпоновкиДанных
//   ПравоеЗначение   - произвольный
//   Использование    - булево
//   РежимОтображения - РежимОтображенияЭлементаНастройкиКомпоновкиДанных
//
Процедура УстановитьЭлементОтбора(Контейнер, Ключ, Представление = Неопределено, ВидСравнения = Неопределено, ПравоеЗначение = Неопределено, Использование = Неопределено, РежимОтображения = Неопределено) Экспорт
	
	ЧислоИзмененных = ИзменитьЭлементыОтбора(Контейнер, Ключ, Представление, ВидСравнения, ПравоеЗначение, Использование, РежимОтображения);
	
	Если ЧислоИзмененных = 0 Тогда
		ИмяПоля = Ключ;
		Если ТипЗнч(Ключ) = Тип("Структура") Тогда
			Ключ.Свойство("ИмяПоля", ИмяПоля);
		КонецЕсли;
		
		ДобавитьЭлементОтбора(Контейнер, ИмяПоля, Представление, ВидСравнения, ПравоеЗначение, Использование, РежимОтображения);
	КонецЕсли;
	
КонецПроцедуры // УстановитьЭлементОтбора

// Добавление элемента компоновки в контейнер элементов компоновки
//
// Параметры:
//   Контейнер        - контейнер с элементами и группами отбора, например "Список.Отбор" или группа в отборе
//   ИмяПоля          - строка, имя для поля компоновки данных
//   ВидСравнения     - ВидСравненияКомпоновкиДанных
//   ПравоеЗначение   - произвольный
//   Представление    - строка, представление элемента компоновки данных
//   Использование    - булево
//   РежимОтображения - РежимОтображенияЭлементаНастройкиКомпоновкиДанных - режим отображения
//
Функция ДобавитьЭлементОтбора(Контейнер, ИмяПоля, Представление  = Неопределено, ВидСравнения = Неопределено, ПравоеЗначение = Неопределено, Использование = Неопределено, РежимОтображения = Неопределено) Экспорт
	
	Элемент = Контейнер.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	Элемент.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Элемент.ВидСравнения     = ?(ВидСравнения = Неопределено, ВидСравненияКомпоновкиДанных.Равно, ВидСравнения);
	Элемент.ПравоеЗначение   = ПравоеЗначение;
	Элемент.Представление    = Представление;
	Элемент.Использование    = ?(Использование = Неопределено, Истина, Использование);
	Элемент.РежимОтображения = ?(РежимОтображения = Неопределено, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто, РежимОтображения);
	
	Возврат Элемент;
	
КонецФункции // ДобавитьЭлементОтбора

// Изменяет найденные группы элементов отбора по ключу, или создает новую, если таковые не были найдены
//
// Параметры:
//   Контейнер     - отбор, элементы отбора или группами отбора, например "Список.Отбор", "Список.Отбор.Элементы"
//   ТипГруппы     - ТипГруппыЭлементовОтбораКомпоновкиДанных
//   Представление - строка, представление группы
//
Функция УстановитьГруппуЭлементовОтбора(Знач Контейнер, Ключ = Неопределено, Представление, ТипГруппы, Использование = Истина, Применение = Неопределено, РежимОтображения = Неопределено) Экспорт
	
	ТипГруппаЭлементовОтбораКомпоновкиДанных = Тип("ГруппаЭлементовОтбораКомпоновкиДанных");
	
	Если ТипЗнч(Контейнер) = ТипГруппаЭлементовОтбораКомпоновкиДанных Или ТипЗнч(Контейнер) = Тип("ОтборКомпоновкиДанных") Тогда
		Контейнер = Контейнер.Элементы;
	КонецЕсли;
	
	ГруппыЭлементовОтбора = НайтиЭлементыИГруппыОтбора(Контейнер, Ключ, Представление);
	
	// удалим элементы, не являющиеся группами
	Для Инд = 1 - ГруппыЭлементовОтбора.Количество По 0 Цикл
		Если ТипЗнч(ГруппыЭлементовОтбора[-Инд]) <> ТипГруппаЭлементовОтбораКомпоновкиДанных Тогда
			ГруппыЭлементовОтбора.Удалить();
		КонецЕсли;
	КонецЦикла;
	
	Если ГруппыЭлементовОтбора.Количество() = 0 Тогда
		ГруппыЭлементовОтбора.Добавить(
			Контейнер.Добавить(ТипГруппаЭлементовОтбораКомпоновкиДанных));
	КонецЕсли;
	
	Для каждого ГруппаЭлементовОтбора Из ГруппыЭлементовОтбора Цикл
		ГруппаЭлементовОтбора.Представление    = Представление;
		ГруппаЭлементовОтбора.ТипГруппы        = ТипГруппы;
		ГруппаЭлементовОтбора.Использование    = Использование;
		ГруппаЭлементовОтбора.Применение       = ?(Применение = Неопределено, ТипПримененияОтбораКомпоновкиДанных.Элементы, Применение);
		ГруппаЭлементовОтбора.РежимОтображения = ?(РежимОтображения = Неопределено, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто, РежимОтображения);
	КонецЦикла;
	
	Возврат ГруппыЭлементовОтбора;
	
КонецФункции // УстановитьГруппуЭлементовОтбора

Процедура УстановитьЭлементОтбораСписка(Форма, ИмяСписка, ИмяПоля) Экспорт

	КлючЭлементаОтбора = Новый Структура("ИмяПоля, Представление", ИмяПоля, "БыстрыйОтбор" + ИмяПоля);
	ПолеНеРедактируется = Форма.Элементы["БыстрыйОтбор" + ИмяСписка + ИмяПоля].ТолькоПросмотр;	
	ЗначениеПоля        = Форма[ИмяПоля];
		
	Если ПолеНеРедактируется Тогда // отбираем даже по пустому значению
		РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма[ИмяСписка].Отбор, КлючЭлементаОтбора, "БыстрыйОтбор" + ИмяПоля,
			ВидСравненияКомпоновкиДанных.Равно, ЗначениеПоля, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто);
	Иначе
		Если ЗначениеЗаполнено(ЗначениеПоля) Тогда
			// установим отбор
			РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма[ИмяСписка].Отбор, КлючЭлементаОтбора, "БыстрыйОтбор" + ИмяПоля,
				ВидСравненияКомпоновкиДанных.Равно, ЗначениеПоля, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто);
		Иначе
			// отключим отбор
			РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма[ИмяСписка].Отбор, КлючЭлементаОтбора, "БыстрыйОтбор" + ИмяПоля,
				ВидСравненияКомпоновкиДанных.Равно, ЗначениеПоля, Ложь, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // УстановитьЭлементОтбораСписка

Процедура УстановитьБыстрыеОтборы(Форма, ИмяСписка, ПоляБыстрогоОтбора, ОтсутствующиеВСпискеПоля = "", УстанавливатьТолькоПросмотр = Ложь) Экспорт
	
	ПараметрыФормы = Форма.Параметры;
	Элементы = Форма.Элементы;
	МассивПоляБыстрогоОтбора = СтрРазделить(ПоляБыстрогоОтбора, ",");
	МассивОтсутствующихПолей = СтрРазделить(ОтсутствующиеВСпискеПоля, ",");
	
	Для Каждого ПолеБыстрогоОтбора Из МассивПоляБыстрогоОтбора Цикл
				
		Если ПараметрыФормы.Свойство(ПолеБыстрогоОтбора) Тогда
			
			Форма[ПолеБыстрогоОтбора] = ПараметрыФормы[ПолеБыстрогоОтбора];
			Если УстанавливатьТолькоПросмотр Тогда
				Элементы["БыстрыйОтбор" + ИмяСписка + ПолеБыстрогоОтбора].ТолькоПросмотр = Истина;
			КонецЕсли;
			
			Если МассивОтсутствующихПолей.Найти(ПолеБыстрогоОтбора) = Неопределено Тогда																
				// если не пользоваться отборами, то при создании записи регистра поля будут не заполнены
				УстановитьЭлементОтбораСписка(Форма, ИмяСписка, ПолеБыстрогоОтбора);							
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
				
КонецПроцедуры  

