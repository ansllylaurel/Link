		#Область Расчет_кредитного_спреда
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗначенияБиржевыхИндексов.Период КАК Период,
			|	ЗначенияБиржевыхИндексов.Y_RUMBTRAAANS КАК Y_RUMBTRAAANS,
			|	ЗначенияБиржевыхИндексов.DURATION_RUMBTRAAANS КАК DURATION_RUMBTRAAANS,
			|	ЗначенияБиржевыхИндексов.GCURVE_DURATION_RUMBTRAAANS КАК GCURVE_DURATION_RUMBTRAAANS,
			|	ЗначенияБиржевыхИндексов.Y_RUMBTRAANS КАК Y_RUMBTRAANS,
			|	ЗначенияБиржевыхИндексов.DURATION_RUMBTRAANS КАК DURATION_RUMBTRAANS,
			|	ЗначенияБиржевыхИндексов.GCURVE_DURATION_RUMBTRAANS КАК GCURVE_DURATION_RUMBTRAANS,
			|	ЗначенияБиржевыхИндексов.Y_RUMBTRANS КАК Y_RUMBTRANS,
			|	ЗначенияБиржевыхИндексов.DURATION_RUMBTRANS КАК DURATION_RUMBTRANS,
			|	ЗначенияБиржевыхИндексов.GCURVE_DURATION_RUMBTRANS КАК GCURVE_DURATION_RUMBTRANS,
			|	ЗначенияБиржевыхИндексов.Y_RUMBTRBBBNS КАК Y_RUMBTRBBBNS,
			|	ЗначенияБиржевыхИндексов.DURATION_RUMBTRBBBNS КАК DURATION_RUMBTRBBBNS,
			|	ЗначенияБиржевыхИндексов.GCURVE_DURATION_RUMBTRBBBNS КАК GCURVE_DURATION_RUMBTRBBBNS
			|ПОМЕСТИТЬ _ЗначенияБиржевыхИндексов
			|ИЗ
			|	&ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НомераРейтинговыхГрупп.НомерГруппы КАК НомерГруппы,
			|	_ЗначенияБиржевыхИндексов.Период КАК Период,
			|	ВЫБОР
			|		КОГДА НомераРейтинговыхГрупп.НомерГруппы = 1
			|			ТОГДА (_ЗначенияБиржевыхИндексов.Y_RUMBTRAAANS - _ЗначенияБиржевыхИндексов.GCURVE_DURATION_RUMBTRAAANS) * 100
			|		КОГДА НомераРейтинговыхГрупп.НомерГруппы = 2
			|			ТОГДА (_ЗначенияБиржевыхИндексов.Y_RUMBTRAANS - _ЗначенияБиржевыхИндексов.GCURVE_DURATION_RUMBTRAANS) * 100
			|		КОГДА НомераРейтинговыхГрупп.НомерГруппы = 3
			|			ТОГДА (_ЗначенияБиржевыхИндексов.Y_RUMBTRANS - _ЗначенияБиржевыхИндексов.GCURVE_DURATION_RUMBTRANS) * 100
			|		КОГДА НомераРейтинговыхГрупп.НомерГруппы = 4
			|			ТОГДА (_ЗначенияБиржевыхИндексов.Y_RUMBTRBBBNS - _ЗначенияБиржевыхИндексов.GCURVE_DURATION_RUMBTRBBBNS) * 100
			|	КОНЕЦ КАК КредитныйСпред
			|ПОМЕСТИТЬ _ЗначенияКредитныхСпредов
			|ИЗ
			|	_ЗначенияБиржевыхИндексов КАК _ЗначенияБиржевыхИндексов,
			|	(ВЫБРАТЬ
			|		1 КАК НомерГруппы
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		2
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		3
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		4
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		5) КАК НомераРейтинговыхГрупп";
		
		Запрос.УстановитьПараметр("ММВБ",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));		
		Запрос.УстановитьПараметр("ЗначенияБиржевыхИндексов",	ЗначенияБиржевыхИндексов);

		Если РасшифровкаРасчета = Неопределено Тогда
			Запрос.Выполнить();
		Иначе
			РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаОперации, Запрос, , "Кредитный спред", Неопределено, "ПараметрыЗапроса, _ЗначенияБиржевыхИндексов, _ЗначенияКредитныхСпредов");
		КонецЕсли;
		
		#КонецОбласти
		
		#КонецОбласти
		
	ИначеЕсли ВариантРасчетаКредитногоСпреда = "СУчетомЗначенийКБДВТочкеДюрацииИндекса" Тогда
		
		#Область Индексы_RUCBITRBBB_RUCBITRBB_RUCBITRB		
		
		// Индексы: RUCBITRBBB, RUCBITRBB, RUCBITRB
		
		// Рейтинговая группа I:		(Y_RUCBITRBBB - КБД_DURATION_RUCBITRBBB) * 100
		// Рейтинговая группа II:		(Y_RUCBITRBB - КБД_DURATION_RUCBITRBB) * 100
		// Рейтинговая группа III:		(Y_RUCBITRB - КБД_DURATION_RUCBITRB) * 100
		// Рейтинговая группа IV (1):	ОКРУГЛ(СРЗНАЧ(Y_TM - КБД_СРВЗВЕШ_СРОК_ДО_ПОГАШЕНИЯ_ЦБ), 4) * 100		
		// Рейтинговая группа IV (2):	(Y_RUCBICPL3 - Y_RUGBICP3Y) * 100, для долговых ценных бумаг, входящих в котировальный уровень 3 ММВБ
		// Рейтинговая группа IV (3):	(Y_RUCBICPL2 - Y_RUGBICP3Y) * 100, для долговых ценных бумаг, входящих в котировальный уровень 2 ММВБ

		ПоследняяРейтинговаяГруппа = 4;
		
		#Область Проверка_параметров_и_описание_алгоритма_расчета
		
		ОписаниеРасчета = Новый Структура("Описание",
			"RUCBITRBBB, RUCBITRBB, RUCBITRB - индексы
			|Y - значение доходности соответствующего индекса ММВБ
			|КБД_DURATION - значение ставки КБД в точке, соответствующей дюрации соответствующего индекса ММВБ
			|Sрг - медиана спреда соответствующей рейтинговой группы 
			|
			|Расчет кредитного спреда:
			|Рейтинговая группа I:   (Y_RUCBITRBBB - КБД_DURATION_RUCBITRBBB) * 100
			|Рейтинговая группа II:  (Y_RUCBITRBB - КБД_DURATION_RUCBITRBB) * 100
			|Рейтинговая группа III: (Y_RUCBITRB - КБД_DURATION_RUCBITRB) * 100");
		
		Если ПараметрыРасчетаКредитногоСпреда.ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы = "ПоЗначениюПредыдущейРейтинговойГруппы" Тогда
			
			ОписаниеРасчета.Описание = ОписаниеРасчета.Описание + "
				|Рейтинговая группа IV: значение кредитного спреда для III рейтинговой группы, увеличенное на ОтклонениеКредитногоСпреда базисных пунктов";
		
		ИначеЕсли ПараметрыРасчетаКредитногоСпреда.ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы = "РазностьИндексовЧистыхЦенГосударственныхИКорпоративныхОблигаций" Тогда
			
			ОписаниеРасчета.Описание = ОписаниеРасчета.Описание + "
				|Рейтинговая группа IV (1): (Y_RUCBICPL3 - Y_RUGBICP3Y) * 100, для долговых ценных бумаг, входящих в котировальный уровень 3 ММВБ
				|Рейтинговая группа IV (2): (Y_RUCBICPL2 - Y_RUGBICP3Y) * 100, для долговых ценных бумаг, входящих в котировальный уровень 2 ММВБ";
			
		ИначеЕсли ПараметрыРасчетаКредитногоСпреда.ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы = Неопределено Тогда 
			
			ОписаниеРасчета.Описание = ОписаниеРасчета.Описание + "
				|Рейтинговая группа IV:  ОКРУГЛ(СРЗНАЧ(Y_TM - КБД_СРВЗВЕШ_СРОК_ДО_ПОГАШЕНИЯ_ЦБ), 4) * 100";
			
			Если РейтинговаяГруппа = 4 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Рейтинг " + Субъект + " попал в рейтинговую группу IV. Расчет кредитного спреда для данной группы не реализован.", , , , ОшибкаРасчета);
			КонецЕсли;
			
		Иначе
			
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Вариант расчета кредитного спреда IV рейтинговой группы '%1' не реализован", ПараметрыРасчетаКредитногоСпреда.ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы), , , , ОшибкаРасчета);
			
		КонецЕсли;
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаОперации, "Алгоритм", ОписаниеРасчета, "Алгоритм расчета кредитного спреда");
		КонецЕсли;
		
		Если ОшибкаРасчета Тогда
			Возврат Новый ТаблицаЗначений;
		КонецЕсли;
		
		#КонецОбласти

		#Область Получение_значений_индексов_и_расчет_значений_КБД_в_точке_дюрации_индекса
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_КалендарьИндексов.Дата КАК Период,
			|	RUCBITRBBB.YIELD КАК Y_RUCBITRBBB,
			|	RUCBITRBBB.DURATION КАК DURATION_RUCBITRBBB,
			|	0 КАК GCURVE_DURATION_RUCBITRBBB,
			|	RUCBITRBB.YIELD КАК Y_RUCBITRBB,
			|	RUCBITRBB.DURATION КАК DURATION_RUCBITRBB,
			|	0 КАК GCURVE_DURATION_RUCBITRBB,
			|	RUCBITRB.YIELD КАК Y_RUCBITRB,
			|	RUCBITRB.DURATION КАК DURATION_RUCBITRB,
			|	0 КАК GCURVE_DURATION_RUCBITRB,
			|	RUGBICP3Y.YIELD КАК Y_RUGBICP3Y,
			|	RUCBICPL3.YIELD КАК Y_RUCBICPL3,
			|	RUCBICPL2.YIELD КАК Y_RUCBICPL2
			|ИЗ
			|	_КалендарьИндексов КАК _КалендарьИндексов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК RUCBITRBBB
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БиржевыеИндексы КАК БиржевойИндекс_RUCBITRBBB
			|			ПО (БиржевойИндекс_RUCBITRBBB.Код = ""RUCBITRBBB"")
			|				И (БиржевойИндекс_RUCBITRBBB.Ссылка = RUCBITRBBB.БиржевойИндекс)
			|		ПО (RUCBITRBBB.Период = _КалендарьИндексов.Дата)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК RUCBITRBB
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БиржевыеИндексы КАК БиржевойИндекс_RUCBITRBB
			|			ПО (БиржевойИндекс_RUCBITRBB.Код = ""RUCBITRBB"")
			|				И (БиржевойИндекс_RUCBITRBB.Ссылка = RUCBITRBB.БиржевойИндекс)
			|		ПО (RUCBITRBB.Период = _КалендарьИндексов.Дата)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК RUCBITRB
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БиржевыеИндексы КАК БиржевойИндекс_RUCBITRB
			|			ПО (БиржевойИндекс_RUCBITRB.Код = ""RUCBITRB"")
			|				И (БиржевойИндекс_RUCBITRB.Ссылка = RUCBITRB.БиржевойИндекс)
			|		ПО (RUCBITRB.Период = _КалендарьИндексов.Дата)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК RUGBICP3Y
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БиржевыеИндексы КАК БиржевойИндекс_RUGBICP3Y
			|			ПО (БиржевойИндекс_RUGBICP3Y.Код = ""RUGBICP3Y"")
			|				И (БиржевойИндекс_RUGBICP3Y.Ссылка = RUGBICP3Y.БиржевойИндекс)
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК RUCBICPL3
			|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БиржевыеИндексы КАК БиржевойИндекс_RUCBICPL3
			|				ПО (БиржевойИндекс_RUCBICPL3.Код = ""RUCBICPL3"")
			|					И (БиржевойИндекс_RUCBICPL3.Ссылка = RUCBICPL3.БиржевойИндекс)
			|			ПО (RUCBICPL3.Период = RUGBICP3Y.Период)
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК RUCBICPL2
			|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БиржевыеИндексы КАК БиржевойИндекс_RUCBICPL2
			|				ПО (БиржевойИндекс_RUCBICPL2.Код = ""RUCBICPL2"")
			|					И (БиржевойИндекс_RUCBICPL2.Ссылка = RUCBICPL2.БиржевойИндекс)
			|			ПО (RUCBICPL2.Период = RUGBICP3Y.Период)
			|		ПО (RUGBICP3Y.Период = _КалендарьИндексов.Дата)
			|			И (&ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы = ""РазностьИндексовЧистыхЦенГосударственныхИКорпоративныхОблигаций"")
			|ГДЕ
			|	НЕ(RUGBICP3Y.Период ЕСТЬ NULL
			|				И &ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы = ""РазностьИндексовЧистыхЦенГосударственныхИКорпоративныхОблигаций"")";
		
		// Расчет значения КБД в точке дюрации индекса
		
		ТочностьКБД = 2;
		Если ПараметрыРасчетаКредитногоСпреда.Свойство("ТочностьКБД") Тогда
			ТочностьКБД = ПараметрыРасчетаКредитногоСпреда.ТочностьКБД;
		КонецЕсли;
		
		ЗначенияБиржевыхИндексов = Запрос.Выполнить().Выгрузить();
		
		Для Каждого ЗначениеБиржевогоИндекса Из ЗначенияБиржевыхИндексов Цикл

			ДюрацииИндексов = Новый Структура;
			ДюрацииИндексов.Вставить("RUCBITRBBB", ЗначениеБиржевогоИндекса.DURATION_RUCBITRBBB);
			ДюрацииИндексов.Вставить("RUCBITRBB",  ЗначениеБиржевогоИндекса.DURATION_RUCBITRBB);
			ДюрацииИндексов.Вставить("RUCBITRB",   ЗначениеБиржевогоИндекса.DURATION_RUCBITRB);
				
			Для Каждого ДюрацияИндекса Из ДюрацииИндексов Цикл
				Если ДюрацияИндекса.Значение = 0 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Значение дюрации индекса %1 за %2 равно 0", ДюрацияИндекса.Ключ, Формат(ЗначениеБиржевогоИндекса.Период, "ДФ=dd.MM.yyyy")), , , , ОшибкаРасчета);
				КонецЕсли;
			Конеццикла;
			
			Если Не ОшибкаРасчета Тогда
				ЗначениеБиржевогоИндекса.GCURVE_DURATION_RUCBITRBBB = Окр(РассчитатьЗначениеКривойБескупоннойДоходности(ЗначениеБиржевогоИндекса.Период, Окр(ДюрацииИндексов.RUCBITRBBB / 365, 4), , ОшибкаРасчета), ТочностьКБД);
			КонецЕсли;
			Если Не ОшибкаРасчета Тогда
				ЗначениеБиржевогоИндекса.GCURVE_DURATION_RUCBITRBB = Окр(РассчитатьЗначениеКривойБескупоннойДоходности(ЗначениеБиржевогоИндекса.Период, Окр(ДюрацииИндексов.RUCBITRBB / 365, 4), , ОшибкаРасчета), ТочностьКБД);
			КонецЕсли;
			Если Не ОшибкаРасчета Тогда
				ЗначениеБиржевогоИндекса.GCURVE_DURATION_RUCBITRB = Окр(РассчитатьЗначениеКривойБескупоннойДоходности(ЗначениеБиржевогоИндекса.Период, Окр(ДюрацииИндексов.RUCBITRB / 365, 4), , ОшибкаРасчета), ТочностьКБД);
			КонецЕсли;
			
			Если ОшибкаРасчета Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Ошибка расчета кредитного спреда '%1'", Субъект), , , , Отказ);
				Возврат Новый ТаблицаЗначений;
			КонецЕсли;
			
		КонецЦикла;
		
		#КонецОбласти
		
		#Область Расчет_кредитного_спреда
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗначенияБиржевыхИндексов.Период КАК Период,
			|	ЗначенияБиржевыхИндексов.Y_RUCBITRBBB КАК Y_RUCBITRBBB,
			|	ЗначенияБиржевыхИндексов.DURATION_RUCBITRBBB КАК DURATION_RUCBITRBBB,
			|	ЗначенияБиржевыхИндексов.GCURVE_DURATION_RUCBITRBBB КАК GCURVE_DURATION_RUCBITRBBB,
			|	ЗначенияБиржевыхИндексов.Y_RUCBITRBB КАК Y_RUCBITRBB,
			|	ЗначенияБиржевыхИндексов.DURATION_RUCBITRBB КАК DURATION_RUCBITRBB,
			|	ЗначенияБиржевыхИндексов.GCURVE_DURATION_RUCBITRBB КАК GCURVE_DURATION_RUCBITRBB,
			|	ЗначенияБиржевыхИндексов.Y_RUCBITRB КАК Y_RUCBITRB,
