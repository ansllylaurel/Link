
#Область Рейтинг_и_кредитный_спред

// Помещает таблицу рейтинговых групп переданных субъектов в менеджер временных таблиц
//
// Параметры
//	ИсточникВременныхТаблиц		- Запрос, МенеджерВременныхТаблиц	- источник временных таблиц
//	Субъекты					- Массив							- массив субъектов
//								- ТаблицаЗначений					- таблица субъектов, указанных в колонке "Субъект"
//								- Строка							- имя временной таблицы субъектов, указанных в колонке "Субъект"
//	Дата						- Дата								- дата получения рейтинга
//	ПараметрыРасчетаРейтинга	- Структура							- параметры расчета рейтинга
//	ИмяВременнойТаблицы			- Строка							- имя таблицы, под которым она будет создана в менеджере
//	РасшифровкаРасчета			- Структура							- структура расшифровки
//								- Неопределено						- без расшифровки
//
Процедура ПоместитьРейтинговыеГруппыСубъектовВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, Субъекты, Дата, ПараметрыРасчетаРейтинга, ИмяВременнойТаблицы = "_РейтинговыеГруппы", РасшифровкаРасчета = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СистемныеФункции.МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц);
	
	Запрос.УстановитьПараметр("ДатаОценки", Дата);
	
	Если ПараметрыРасчетаРейтинга.Свойство("РейтинговаяГруппа") Тогда
		
		#Область Ранее_рассчитанная_рейтинговая_группа
		
		// #Техдолг: Переписать на поиск в МВТ таблицы _РейтинговыеГруппы
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&Субъект КАК Субъект,
			|	РейтинговыеГруппы.РейтинговаяГруппа КАК НомерГруппы,
			|	""Ранее рассчитанная рейтинговая группа"" КАК Описание
			|ПОМЕСТИТЬ #РейтинговыеГруппы#
			|ИЗ
			|	(ВЫБРАТЬ
			|		1 КАК РейтинговаяГруппа
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		2
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		3
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		4
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		5) КАК РейтинговыеГруппы
			|ГДЕ
			|	РейтинговыеГруппы.РейтинговаяГруппа В(&РейтинговаяГруппа)";
		
		Запрос.УстановитьПараметр("Субъект",			Субъекты);
		Запрос.УстановитьПараметр("РейтинговаяГруппа",	ПараметрыРасчетаРейтинга.РейтинговаяГруппа);
		
		#КонецОбласти		
		
	Иначе
		
		#Область Расчет_рейтинговой_группы
		
		#Область Заполняем_таблицу_субъектов		
		
		ИмяТаблицыСубъектовРейтинга = "_СубъектыРейтинга";
		
		Если ТипЗнч(Субъекты) = Тип("Массив") ИЛИ ТипЗнч(Субъекты) = Тип("ТаблицаЗначений") Тогда
			
			#Область Массив_или_таблица_субъектов
			
			Если ТипЗнч(Субъекты) = Тип("Массив") Тогда
				
				ТаблицаСубъектов = Новый ТаблицаЗначений;
				ТаблицаСубъектов.Колонки.Добавить("Субъект");
				ТаблицаСубъектов.Колонки.Добавить("ТипЗначения");
				
				Для Каждого ЭлементМассива Из Субъекты Цикл
					СтрокаТаблицыСубъектов = ТаблицаСубъектов.Добавить();
					СтрокаТаблицыСубъектов.Субъект		= ЭлементМассива;
					СтрокаТаблицыСубъектов.ТипЗначения	= ТипЗнч(ЭлементМассива);
				КонецЦикла;
				
				ТипыЗначенийСубъектов = ТаблицаСубъектов.Скопировать(Неопределено, "ТипЗначения");
				ТипыЗначенийСубъектов.Свернуть("ТипЗначения");
				
				РаботаСКоллекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(ТаблицаСубъектов, "Субъект", Новый ОписаниеТипов(ТипыЗначенийСубъектов.ВыгрузитьКолонку(0)));
				
				ТаблицаСубъектов.Колонки.Удалить(ТаблицаСубъектов.Колонки.Найти("ТипЗначения"));
				
			Иначе
				
				ТаблицаСубъектов = Субъекты;
				
			КонецЕсли;
			
			СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаСубъектов, ИмяТаблицыСубъектовРейтинга, Запрос);

			#КонецОбласти	
			
		ИначеЕсли ТипЗнч(Субъекты) = Тип("Строка") Тогда
			
			ИмяТаблицыСубъектовРейтинга = Субъекты; // Таблица субьектов во временных таблицах под нестандартным именем
			
		ИначеЕсли Субъекты <> Неопределено Тогда
			
			#Область Прочие_субъекты		
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	&Субъект КАК Субъект
				|ПОМЕСТИТЬ " + ИмяТаблицыСубъектовРейтинга;
			
			Запрос.УстановитьПараметр("Субъект", Субъекты);
			
			Запрос.Выполнить();
			
			#КонецОбласти	
			
		Иначе
			
			ВызватьИсключение "Не заполнен параметр Субъекты";
			
		КонецЕсли;
		
		#КонецОбласти		
		
		#Область Заполняем_таблицу_связанных_субъектов
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СвязанныеСубъектыРейтинга.Субъект КАК Субъект,
			|	СвязанныеСубъектыРейтинга.СвязанныйСубъект КАК СвязанныйСубъект,
			|	СвязанныеСубъектыРейтинга.ВидСвязи КАК ВидСвязи,
			|	ВЫБОР
			|		КОГДА &УчитыватьПриоритетРейтингов
			|			ТОГДА СвязанныеСубъектыРейтинга.Приоритет
			|		ИНАЧЕ 1
			|	КОНЕЦ КАК Приоритет,
			|	СвязанныеСубъектыРейтинга.ПредопределеннаяРейтинговаяГруппа КАК ПредопределеннаяРейтинговаяГруппа
			|ПОМЕСТИТЬ _СвязанныеСубъектыРейтинга
			|ИЗ
			|	(ВЫБРАТЬ
			|		Облигации.Ссылка КАК Субъект,
			|		ВЫБОР
			|			КОГДА СвязиСубъектов.ВидСвязи = ""Субъект""
			|				ТОГДА Облигации.Ссылка
			|			КОГДА СвязиСубъектов.ВидСвязи = ""Эмитент""
			|				ТОГДА Облигации.Эмитент.ЮрФизЛицо
			|			КОГДА СвязиСубъектов.ВидСвязи = ""Гарант""
			|				ТОГДА Облигации.Гарант
			|			КОГДА СвязиСубъектов.ВидСвязи = ""Оригинатор""
			|				ТОГДА Облигации.Оригинатор
			|		КОНЕЦ КАК СвязанныйСубъект,
			|		СвязиСубъектов.ВидСвязи КАК ВидСвязи,
			|		СвязиСубъектов.Приоритет КАК Приоритет,
			|		ВЫБОР
			|			КОГДА СвязиСубъектов.ВидСвязи = ""Субъект""
			|					И Облигации.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииГосударства)
			|					И &РейтинговаяГруппаГосударственныхОблигаций <> НЕОПРЕДЕЛЕНО
			|				ТОГДА &РейтинговаяГруппаГосударственныхОблигаций
			|			ИНАЧЕ НЕОПРЕДЕЛЕНО
			|		КОНЕЦ КАК ПредопределеннаяРейтинговаяГруппа
			|	ИЗ
			|		Справочник.Облигации КАК Облигации
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ #СубъектыРейтинга# КАК _СубъектыРейтинга
			|			ПО (_СубъектыРейтинга.Субъект = Облигации.Ссылка)
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
			|					&ДатаОценки,
			|					&УчитыватьРейтингРоссийскогоОригинатораОблигацийНерезидентов
			|						И (Подразделение, Язык, ЮрФизЛицо) В
			|							(ВЫБРАТЬ
			|								ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
			|								ЗНАЧЕНИЕ(Справочник.Языки.Русский),
			|								Облигации.Оригинатор
			|							ИЗ
			|								Справочник.Облигации КАК Облигации
			|									ВНУТРЕННЕЕ СОЕДИНЕНИЕ #СубъектыРейтинга# КАК _СубъектыРейтинга
			|									ПО
			|										Облигации.Ссылка = _СубъектыРейтинга.Субъект
			|							ГДЕ
			|								НЕ Облигации.Оригинатор = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка))) КАК РеквизитыОригинатора
			|			ПО Облигации.Оригинатор = РеквизитыОригинатора.ЮрФизЛицо,
			|		(ВЫБРАТЬ
			|			""Субъект"" КАК ВидСвязи,
			|			1 КАК Приоритет
			|		ГДЕ
			|			&РейтингЦеннойБумаги
			|		
			|		ОБЪЕДИНИТЬ ВСЕ
			|		
			|		ВЫБРАТЬ
			|			""Эмитент"",
			|			2
			|		ГДЕ
			|			&РейтингЭмитента
			|		
			|		ОБЪЕДИНИТЬ ВСЕ
			|		
			|		ВЫБРАТЬ
			|			""Гарант"",
			|			3
			|		ГДЕ
			|			&РейтингГаранта
			|		
			|		ОБЪЕДИНИТЬ ВСЕ
			|		
			|		ВЫБРАТЬ
			|			""Оригинатор"",
			|			4
			|		ГДЕ
			|			&УчитыватьРейтингРоссийскогоОригинатораОблигацийНерезидентов) КАК СвязиСубъектов
			|	ГДЕ
			|		НЕ(СвязиСубъектов.ВидСвязи = ""Гарант""
			|					И Облигации.Гарант = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка))
			|		И НЕ(СвязиСубъектов.ВидСвязи = ""Оригинатор""
			|					И (Облигации.Оригинатор = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
			|						ИЛИ НЕ Облигации.УчетныйАктивЦБРФ В (&УчетныеАктивыОблигацийНерезидентов)
			|						ИЛИ НЕ РеквизитыОригинатора.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)))
			|					И НЕ(&БезОтбораОблигацийНерезидентовУчитывающихРейтингОригинатора
			|							ИЛИ Облигации.Ссылка В (&ОблигацииНерезидентовУчитывающиеРейтингОригинатора)))
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ДепозитныеВклады.Ссылка,
			|		ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, ДепозитныеВклады.БанковскийСчет.Банк.ЮрФизЛицо),
			|		""Банк"",
			|		1,
			|		НЕОПРЕДЕЛЕНО
			|	ИЗ
			|		Справочник.ДепозитныеВклады КАК ДепозитныеВклады
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ #СубъектыРейтинга# КАК _СубъектыРейтинга
			|			ПО (_СубъектыРейтинга.Субъект = ДепозитныеВклады.Ссылка)
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&ДатаОценки, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
			|			ПО ДепозитныеВклады.БанковскийСчет.Банк.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
			|				И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		МНО.Ссылка,
			|		ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, МНО.РасчетныйСчет.Банк.ЮрФизЛицо),
			|		""Банк"",
			|		1,
			|		НЕОПРЕДЕЛЕНО
			|	ИЗ
			|		Документ.МНО КАК МНО
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ #СубъектыРейтинга# КАК _СубъектыРейтинга
			|			ПО (_СубъектыРейтинга.Субъект = МНО.Ссылка)
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&ДатаОценки, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
			|			ПО МНО.РасчетныйСчет.Банк.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
			|				И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		_СубъектыРейтинга.Субъект,
			|		_СубъектыРейтинга.Субъект,
			|		""Субъект"",
			|		1,
			|		НЕОПРЕДЕЛЕНО
			|	ИЗ
			|		#СубъектыРейтинга# КАК _СубъектыРейтинга
			|	ГДЕ
			|		НЕ ТИПЗНАЧЕНИЯ(_СубъектыРейтинга.Субъект) В (ТИП(Справочник.Облигации), ТИП(Справочник.ДепозитныеВклады), ТИП(Документ.МНО))) КАК СвязанныеСубъектыРейтинга";		
		
		Если ПараметрыРасчетаРейтинга.Свойство("РейтинговаяГруппаГосударственныхОблигаций") Тогда
			Запрос.УстановитьПараметр("РейтинговаяГруппаГосударственныхОблигаций", ПараметрыРасчетаРейтинга.РейтинговаяГруппаГосударственныхОблигаций);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&РейтинговаяГруппаГосударственныхОблигаций", "НЕОПРЕДЕЛЕНО");	
		КонецЕсли;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#СубъектыРейтинга#", ИмяТаблицыСубъектовРейтинга);
		
		Если РасшифровкаРасчета = Неопределено
			ИЛИ СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, ИмяТаблицыСубъектовРейтинга, , "Субъект", "ТИПЗНАЧЕНИЯ(Субъект) = ТИП(Справочник.Облигации)").Выбрать().Следующий()
		Тогда
		
			#Область Параметры_рейтинга_ценных_бумаг
			
			// Старый способ фильтрации рейтингов субъектов
			
			Если ПараметрыРасчетаРейтинга.Свойство("ТолькоЭмитент")
				И ПараметрыРасчетаРейтинга.ТолькоЭмитент = Истина
			Тогда
				ПараметрыРасчетаРейтинга.Вставить("РейтингЦеннойБумаги",	Ложь);
				ПараметрыРасчетаРейтинга.Вставить("РейтингЭмитента",		Истина);
				ПараметрыРасчетаРейтинга.Вставить("РейтингГаранта",			Истина);
			КонецЕсли;				
			
			// Если не указаны субъекты, то берем все
			
			Если Не ПараметрыРасчетаРейтинга.Свойство("РейтингЦеннойБумаги")
				И Не ПараметрыРасчетаРейтинга.Свойство("РейтингЭмитента")
				И Не ПараметрыРасчетаРейтинга.Свойство("РейтингГаранта")
			Тогда
				ПараметрыРасчетаРейтинга.Вставить("РейтингЦеннойБумаги",	Истина);
				ПараметрыРасчетаРейтинга.Вставить("РейтингЭмитента",		Истина);
				ПараметрыРасчетаРейтинга.Вставить("РейтингГаранта",			Истина);
			КонецЕсли;				
			
			Если Не ПараметрыРасчетаРейтинга.Свойство("РейтингЦеннойБумаги") Тогда
				ПараметрыРасчетаРейтинга.Вставить("РейтингЦеннойБумаги", Ложь);
			КонецЕсли;
			
			Если Не ПараметрыРасчетаРейтинга.Свойство("РейтингЭмитента") Тогда
				ПараметрыРасчетаРейтинга.Вставить("РейтингЭмитента", Ложь);
			КонецЕсли;
			
			Если Не ПараметрыРасчетаРейтинга.Свойство("РейтингГаранта") Тогда
				ПараметрыРасчетаРейтинга.Вставить("РейтингГаранта", Ложь);
			КонецЕсли;
			
			Если Не ПараметрыРасчетаРейтинга.Свойство("УчитыватьРейтингРоссийскогоОригинатораОблигацийНерезидентов") Тогда
				ПараметрыРасчетаРейтинга.Вставить("УчитыватьРейтингРоссийскогоОригинатораОблигацийНерезидентов", Ложь);
			ИначеЕсли ПараметрыРасчетаРейтинга.УчитыватьРейтингРоссийскогоОригинатораОблигацийНерезидентов Тогда
				УчетныеАктивыОблигацийНерезидентов = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииНерезидентов();
			КонецЕсли;
			
			Если Не ПараметрыРасчетаРейтинга.Свойство("ОблигацииНерезидентовУчитывающиеРейтингОригинатора") Тогда
				ПараметрыРасчетаРейтинга.Вставить("ОблигацииНерезидентовУчитывающиеРейтингОригинатора", Неопределено);
			КонецЕсли;
			
			Запрос.УстановитьПараметр("РейтингЦеннойБумаги",	ПараметрыРасчетаРейтинга.РейтингЦеннойБумаги);
			Запрос.УстановитьПараметр("РейтингЭмитента",		ПараметрыРасчетаРейтинга.РейтингЭмитента);
			Запрос.УстановитьПараметр("РейтингГаранта",			ПараметрыРасчетаРейтинга.РейтингГаранта);
			
			Запрос.УстановитьПараметр("УчитыватьРейтингРоссийскогоОригинатораОблигацийНерезидентов", ПараметрыРасчетаРейтинга.УчитыватьРейтингРоссийскогоОригинатораОблигацийНерезидентов);
			Запрос.УстановитьПараметр("УчетныеАктивыОблигацийНерезидентов",							 УчетныеАктивыОблигацийНерезидентов);
			Запрос.УстановитьПараметр("БезОтбораОблигацийНерезидентовУчитывающихРейтингОригинатора", (ПараметрыРасчетаРейтинга.ОблигацииНерезидентовУчитывающиеРейтингОригинатора = Неопределено));
			Запрос.УстановитьПараметр("ОблигацииНерезидентовУчитывающиеРейтингОригинатора",			 ПараметрыРасчетаРейтинга.ОблигацииНерезидентовУчитывающиеРейтингОригинатора);
			
			#КонецОбласти
			
		Иначе // Так в расшифровке не будет лишних параметров, но не уверен, что это хорошо архитектурно
			
			#Область Замена_параметров_рейтинга_ценных_бумаг_на_дефолтные_значения 
			
			ПараметрыРейтингаЦенныхБумаг = Новый Структура;
			ПараметрыРейтингаЦенныхБумаг.Вставить("РейтингЦеннойБумаги",										 "ЛОЖЬ");
			ПараметрыРейтингаЦенныхБумаг.Вставить("РейтингЭмитента",											 "ЛОЖЬ");
			ПараметрыРейтингаЦенныхБумаг.Вставить("РейтингГаранта",												 "ЛОЖЬ");
			ПараметрыРейтингаЦенныхБумаг.Вставить("УчитыватьРейтингРоссийскогоОригинатораОблигацийНерезидентов", "ЛОЖЬ");
			ПараметрыРейтингаЦенныхБумаг.Вставить("БезОтбораОблигацийНерезидентовУчитывающихРейтингОригинатора", "ИСТИНА");
			ПараметрыРейтингаЦенныхБумаг.Вставить("ОблигацииНерезидентовУчитывающиеРейтингОригинатора",			 "НЕОПРЕДЕЛЕНО");
			ПараметрыРейтингаЦенныхБумаг.Вставить("УчетныеАктивыОблигацийНерезидентов",							 "НЕОПРЕДЕЛЕНО");
			
			Для каждого Параметр Из ПараметрыРейтингаЦенныхБумаг Цикл
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&" + Параметр.Ключ, Параметр.Значение); 	
			КонецЦикла; 
			
			#КонецОбласти
			
		КонецЕсли;
		
		Если Не ПараметрыРасчетаРейтинга.Свойство("УчитыватьПриоритетРейтингов") Тогда
			ПараметрыРасчетаРейтинга.Вставить("УчитыватьПриоритетРейтингов", Ложь);
		КонецЕсли;
		
		Запрос.УстановитьПараметр("УчитыватьПриоритетРейтингов", ПараметрыРасчетаРейтинга.УчитыватьПриоритетРейтингов);
		
		Запрос.Выполнить();
		
		#КонецОбласти
		
		#Область Составляем_текст_запроса_рейтингов
		
		ТекстЗапросаРейтингов =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СвязанныеСубъектыРейтинга.Субъект КАК Субъект,
			|	_СвязанныеСубъектыРейтинга.СвязанныйСубъект КАК СвязанныйСубъект,
			|	РейтингиСрезПоследних.РейтинговоеАгентство КАК РейтинговоеАгентство,
			|	РейтингиСрезПоследних.Шкала КАК Шкала,
			|	РейтингиСрезПоследних.ЗначениеРейтинга КАК Рейтинг,
			|	РейтингиСрезПоследних.ЗначениеРейтинга.Оценка КАК Оценка,
			|	&ДатаОценки КАК ДатаРейтинга
			|ПОМЕСТИТЬ _Рейтинги
			|ИЗ
			|	_СвязанныеСубъектыРейтинга КАК _СвязанныеСубъектыРейтинга
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
			|				&ДатаОценки,
			|				(&УчитыватьРейтингНРАТолькоДляБанков_
			|					ИЛИ &УчитыватьРейтингНРАТолькоДляБанковИНефинансовыхКомпаний_
			|					ИЛИ &УчитыватьРейтингНКРТолькоДляБанковИНефинансовыхКомпаний)
			|					И (Подразделение, Язык, ЮрФизЛицо) В
			|						(ВЫБРАТЬ
			|							ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
			|							ЗНАЧЕНИЕ(Справочник.Языки.Русский),
			|							_СвязанныеСубъектыРейтинга.СвязанныйСубъект
			|						ИЗ
			|							_СвязанныеСубъектыРейтинга)) КАК РеквизитыСвязанныхСубъектов
			|		ПО _СвязанныеСубъектыРейтинга.СвязанныйСубъект = РеквизитыСвязанныхСубъектов.ЮрФизЛицо
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Рейтинги.СрезПоследних(
			|				&ДатаОценки,
			|				(Субъект, Агрегатор) В
			|						(ВЫБРАТЬ
			|							_СвязанныеСубъектыРейтинга.СвязанныйСубъект,
			|							ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.РуДата)
			|						ИЗ
			|							_СвязанныеСубъектыРейтинга КАК _СвязанныеСубъектыРейтинга
			|						ГДЕ
			|							&ФильтрСвязанныхСубъектов)
			|					И Шкала.Срок = ЗНАЧЕНИЕ(Перечисление.СрокиРейтингов.Долгосрочный)
			|					И РейтинговоеАгентство В (&РейтинговыеАгентства)
			|					И &ФильтрРейтингов
			|					И (Шкала.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1)
			|						ИЛИ Шкала.ДатаПереходаВАрхив > &ДатаОценки)) КАК РейтингиСрезПоследних
			|		ПО (РейтингиСрезПоследних.Субъект = _СвязанныеСубъектыРейтинга.СвязанныйСубъект)
			|			И (РейтингиСрезПоследних.ЗначениеРейтинга.РейтингСнят = ЛОЖЬ)
			|			И (РейтингиСрезПоследних.РейтинговоеАгентство <> ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.НРА)
			|				ИЛИ (НЕ &УчитыватьРейтингНРАТолькоДляБанков_
			|					ИЛИ РеквизитыСвязанныхСубъектов.Отрасль В (&Отрасль_Банки))
			|					И (НЕ &УчитыватьРейтингНРАТолькоДляБанковИНефинансовыхКомпаний_
			|						ИЛИ РеквизитыСвязанныхСубъектов.Отрасль В (&Отрасль_Банки)
			|						ИЛИ НЕ РеквизитыСвязанныхСубъектов.Отрасль В (&Отрасль_ФинансовыеКомпании)))
			|			И (РейтингиСрезПоследних.РейтинговоеАгентство <> ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.НКР)
			|				ИЛИ НЕ &УчитыватьРейтингНКРТолькоДляБанковИНефинансовыхКомпаний
			|				ИЛИ РеквизитыСвязанныхСубъектов.Отрасль В (&Отрасль_Банки)
			|				ИЛИ НЕ РеквизитыСвязанныхСубъектов.Отрасль В (&Отрасль_ФинансовыеКомпании))";
		
		Если ПараметрыРасчетаРейтинга.Свойство("РейтинговыеАгентства") Тогда
			Запрос.УстановитьПараметр("РейтинговыеАгентства", ПараметрыРасчетаРейтинга.РейтинговыеАгентства);
		Иначе
			ТекстЗапросаРейтингов = СтрЗаменить(ТекстЗапросаРейтингов, "РейтинговоеАгентство В (&РейтинговыеАгентства)", "ИСТИНА");
		КонецЕсли;
		
		#Область Учет_рейтингов_в_зависимости_от_отрасли_субъекта
		
		Отрасль_Банки				= Неопределено;
		Отрасль_ФинансовыеКомпании	= Неопределено;
		
		#Область НРА_только_для_банков
		
		УчитыватьРейтингНРАТолькоДляБанков = Ложь;
		
		Если ПараметрыРасчетаРейтинга.Свойство("УчитыватьРейтингНРАТолькоДляБанков")
			И ПараметрыРасчетаРейтинга.УчитыватьРейтингНРАТолькоДляБанков
		Тогда
			УчитыватьРейтингНРАТолькоДляБанков	= Истина;
			Отрасль_Банки						= ОбщегоНазначения.ПолучитьИменованныйОбъект("Отрасль_Банки");
			
			Запрос.УстановитьПараметр("УчитыватьРейтингНРАТолькоДляБанков", УчитыватьРейтингНРАТолькоДляБанков);
		КонецЕсли;
		
		ТекстЗапросаРейтингов = СтрЗаменить(ТекстЗапросаРейтингов,
			"&УчитыватьРейтингНРАТолькоДляБанков_",
			?(УчитыватьРейтингНРАТолькоДляБанков, "&УчитыватьРейтингНРАТолькоДляБанков", "ЛОЖЬ"));
			
		#КонецОбласти		
		
		#Область НРА_только_для_банков_и_нефинансовых_компаний
		
		УчитыватьРейтингНРАТолькоДляБанковИНефинансовыхКомпаний = Ложь;
		
		Если ПараметрыРасчетаРейтинга.Свойство("УчитыватьРейтингНРАТолькоДляБанковИНефинансовыхКомпаний")
			И ПараметрыРасчетаРейтинга.УчитыватьРейтингНРАТолькоДляБанковИНефинансовыхКомпаний
		Тогда
			УчитыватьРейтингНРАТолькоДляБанковИНефинансовыхКомпаний	= Истина;
			Отрасль_Банки											= ОбщегоНазначения.ПолучитьИменованныйОбъект("Отрасль_Банки");
			Отрасль_ФинансовыеКомпании								= ОбщегоНазначения.ПолучитьИменованныйОбъект("Отрасль_ФинансовыеКомпании");
			
			Запрос.УстановитьПараметр("УчитыватьРейтингНРАТолькоДляБанковИНефинансовыхКомпаний", УчитыватьРейтингНРАТолькоДляБанковИНефинансовыхКомпаний);
		КонецЕсли;
		
		ТекстЗапросаРейтингов = СтрЗаменить(ТекстЗапросаРейтингов,
			"&УчитыватьРейтингНРАТолькоДляБанковИНефинансовыхКомпаний_",
			?(УчитыватьРейтингНРАТолькоДляБанковИНефинансовыхКомпаний, "&УчитыватьРейтингНРАТолькоДляБанковИНефинансовыхКомпаний", "ЛОЖЬ"));
			
		#КонецОбласти
		
		#Область НКР_только_для_банков_и_нефинансовых_компаний
		
		УчитыватьРейтингНКРТолькоДляБанковИНефинансовыхКомпаний = Ложь;
		
		Если ПараметрыРасчетаРейтинга.Свойство("УчитыватьРейтингНКРТолькоДляБанковИНефинансовыхКомпаний")
			И ПараметрыРасчетаРейтинга.УчитыватьРейтингНКРТолькоДляБанковИНефинансовыхКомпаний
		Тогда
			УчитыватьРейтингНКРТолькоДляБанковИНефинансовыхКомпаний	= Истина;
			Отрасль_Банки											= ОбщегоНазначения.ПолучитьИменованныйОбъект("Отрасль_Банки");
			Отрасль_ФинансовыеКомпании								= ОбщегоНазначения.ПолучитьИменованныйОбъект("Отрасль_ФинансовыеКомпании");
		КонецЕсли;
		
		Если УчитыватьРейтингНКРТолькоДляБанковИНефинансовыхКомпаний Тогда
			Запрос.УстановитьПараметр("УчитыватьРейтингНКРТолькоДляБанковИНефинансовыхКомпаний", УчитыватьРейтингНКРТолькоДляБанковИНефинансовыхКомпаний);
		Иначе
			ТекстЗапросаРейтингов = СтрЗаменить(ТекстЗапросаРейтингов, "&УчитыватьРейтингНКРТолькоДляБанковИНефинансовыхКомпаний", "ЛОЖЬ");			
		КонецЕсли;
		
		#КонецОбласти
		
		Если УчитыватьРейтингНРАТолькоДляБанков
			И УчитыватьРейтингНРАТолькоДляБанковИНефинансовыхКомпаний
		Тогда
			ВызватьИсключение "Параметры 'УчитыватьРейтингНРАТолькоДляБанков' и 'УчитыватьРейтингНРАТолькоДляБанковИНефинансовыхКомпаний' не могут быть заданы одновременно!";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Отрасль_Банки) Тогда
			Запрос.УстановитьПараметр("Отрасль_Банки", Отрасль_Банки);
		Иначе
			ТекстЗапросаРейтингов = СтрЗаменить(ТекстЗапросаРейтингов, "&Отрасль_Банки", "НЕОПРЕДЕЛЕНО");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Отрасль_ФинансовыеКомпании) Тогда
			Запрос.УстановитьПараметр("Отрасль_ФинансовыеКомпании", Отрасль_ФинансовыеКомпании);
		Иначе
			ТекстЗапросаРейтингов = СтрЗаменить(ТекстЗапросаРейтингов, "&Отрасль_ФинансовыеКомпании", "НЕОПРЕДЕЛЕНО");
		КонецЕсли;		
		
		#КонецОбласти
		
		Если ПараметрыРасчетаРейтинга.Свойство("ИсключатьДляРублевыхОблигацийРейтингFitchRatings") 
			И ПараметрыРасчетаРейтинга.ИсключатьДляРублевыхОблигацийРейтингFitchRatings = Истина
		Тогда
		
			#Область Исключение_рейтинга_Fitch_Ratings_для_рублевых_облигаций
			
			ТекстЗапросаРейтингов = СтрЗаменить(ТекстЗапросаРейтингов,
				"ПО (РейтингиСрезПоследних.Субъект = _СвязанныеСубъектыРейтинга.СвязанныйСубъект)",
				"ПО (РейтингиСрезПоследних.Субъект = _СвязанныеСубъектыРейтинга.СвязанныйСубъект)
				|			И НЕ (ТИПЗНАЧЕНИЯ(_СвязанныеСубъектыРейтинга.СвязанныйСубъект) = ТИП(Справочник.Облигации)
				|					И ВЫРАЗИТЬ(_СвязанныеСубъектыРейтинга.СвязанныйСубъект КАК Справочник.Облигации).ВалютаНоминала = &ВалютаРубли
				|					И РейтингиСрезПоследних.РейтинговоеАгентство = &FitchRatings)");		
		
			Запрос.УстановитьПараметр("FitchRatings", Справочники.РейтинговыеАгентства.FitchRatings);
			Запрос.УстановитьПараметр("ВалютаРубли", ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
			
			#КонецОбласти
		
		КонецЕсли;
		
		Если ПараметрыРасчетаРейтинга.Свойство("ИсключатьДляРублевыхОблигацийРейтингИностранныхАгентств") 
			И ПараметрыРасчетаРейтинга.ИсключатьДляРублевыхОблигацийРейтингИностранныхАгентств = Истина
		Тогда
		
			#Область Исключение_рейтинга_иностранных_агентств_для_рублевых_облигаций
			
			ТекстЗапросаРейтингов = СтрЗаменить(ТекстЗапросаРейтингов,
				"ПО (РейтингиСрезПоследних.Субъект = _СвязанныеСубъектыРейтинга.СвязанныйСубъект)",
				"ПО (РейтингиСрезПоследних.Субъект = _СвязанныеСубъектыРейтинга.СвязанныйСубъект)
				|			И НЕ (ТИПЗНАЧЕНИЯ(_СвязанныеСубъектыРейтинга.Субъект) = ТИП(Справочник.Облигации)
				|					И ВЫРАЗИТЬ(_СвязанныеСубъектыРейтинга.Субъект КАК Справочник.Облигации).ВалютаНоминала = &ВалютаРубли
				|					И РейтингиСрезПоследних.РейтинговоеАгентство В (&ИностранныеАгентства))");		
		
			Запрос.УстановитьПараметр("ВалютаРубли",			ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
			Запрос.УстановитьПараметр("ИностранныеАгентства",	Справочники.РейтинговыеАгентства.ИностранныеРейтинговыеАгентства());
			
			#КонецОбласти
		
		КонецЕсли;
		
		Если ПараметрыРасчетаРейтинга.Свойство("ИсключатьДляРублевыхОблигацийРейтингВИностраннойВалюте") 
			И ПараметрыРасчетаРейтинга.ИсключатьДляРублевыхОблигацийРейтингВИностраннойВалюте = Истина
		Тогда
		
			#Область Исключение_рейтинга_в_иностранной_валюте_для_рублевых_облигаций
			
			ТекстЗапросаРейтингов = СтрЗаменить(ТекстЗапросаРейтингов,
				"ПО (РейтингиСрезПоследних.Субъект = _СвязанныеСубъектыРейтинга.СвязанныйСубъект)",
				"ПО (РейтингиСрезПоследних.Субъект = _СвязанныеСубъектыРейтинга.СвязанныйСубъект)
				|			И НЕ (ТИПЗНАЧЕНИЯ(_СвязанныеСубъектыРейтинга.Субъект) = ТИП(Справочник.Облигации)
				|					И ВЫРАЗИТЬ(_СвязанныеСубъектыРейтинга.Субъект КАК Справочник.Облигации).ВалютаНоминала = &ВалютаРубли
				|					И РейтингиСрезПоследних.Шкала.ТипШкалы = ЗНАЧЕНИЕ(Перечисление.ТипыШкалРейтинговыхАгенств.МеждународнаяИнВалюта))");		
		
			Запрос.УстановитьПараметр("ВалютаРубли", ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
			
			#КонецОбласти
		
		КонецЕсли;
		
		Запрос.Текст = СтрЗаменить(ТекстЗапросаРейтингов, "&ФильтрСвязанныхСубъектов", "ИСТИНА");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,		  "&ФильтрРейтингов",		   "ИСТИНА");
		
		ИспользуютсяСобственныеПараметрыРейтингаРФ = (ПараметрыРасчетаРейтинга.Свойство("ПараметрыРейтингаРФ") И ТипЗнч(ПараметрыРасчетаРейтинга.ПараметрыРейтингаРФ) = Тип("Структура"));
		
		Если ИспользуютсяСобственныеПараметрыРейтингаРФ Тогда

			#Область Дополняем_текст_запроса_рейтингами_РФ_на_указанную_дату
			
			ТекстЗапросаРейтинговРФ = СтрЗаменить(ТекстЗапросаРейтингов,   "ВЫБРАТЬ РАЗРЕШЕННЫЕ",		"ВЫБРАТЬ");
			ТекстЗапросаРейтинговРФ = СтрЗаменить(ТекстЗапросаРейтинговРФ, "ПОМЕСТИТЬ _Рейтинги",		"");
			ТекстЗапросаРейтинговРФ = СтрЗаменить(ТекстЗапросаРейтинговРФ, "&ДатаОценки",				"&ДатаРейтингаРФ");
			ТекстЗапросаРейтинговРФ = СтрЗаменить(ТекстЗапросаРейтинговРФ, "&ФильтрСвязанныхСубъектов",	"_СвязанныеСубъектыРейтинга.СвязанныйСубъект = &МинфинРоссии");
			ТекстЗапросаРейтинговРФ = СтрЗаменить(ТекстЗапросаРейтинговРФ, "&ФильтрРейтингов",			"&ДатаОценки <> &ДатаРейтингаРФ");

			Запрос.Текст = Запрос.Текст + Символы.ПС + Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС + Символы.ПС + ТекстЗапросаРейтинговРФ;
			
			#КонецОбласти
			
		КонецЕсли;
		
		#КонецОбласти
		
		Запрос.Текст = Запрос.Текст + ";" + Символы.ПС + Символы.ПС +
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СвязанныеСубъектыРейтинга.Субъект КАК Субъект,
			|	ЕСТЬNULL(МАКСИМУМ(_СвязанныеСубъектыРейтинга.Субъект = _Рейтинги.СвязанныйСубъект), ЛОЖЬ) КАК РейтингСубъекта,
			|	ЕСТЬNULL(МАКСИМУМ(_СвязанныеСубъектыРейтинга.ВидСвязи = ""Эмитент""
			|				И _Рейтинги.СвязанныйСубъект ЕСТЬ НЕ NULL ), ЛОЖЬ) КАК РейтингЭмитента
			|ПОМЕСТИТЬ _НаличиеРейтинговНаДатуОценки
			|ИЗ
			|	_СвязанныеСубъектыРейтинга КАК _СвязанныеСубъектыРейтинга
			|		ЛЕВОЕ СОЕДИНЕНИЕ _Рейтинги КАК _Рейтинги
			|		ПО (_Рейтинги.Субъект = _СвязанныеСубъектыРейтинга.Субъект)
			|			И (_Рейтинги.СвязанныйСубъект = _СвязанныеСубъектыРейтинга.СвязанныйСубъект)
			|			И (_Рейтинги.ДатаРейтинга = &ДатаОценки)
			|
			|СГРУППИРОВАТЬ ПО
			|	_СвязанныеСубъектыРейтинга.Субъект
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_СвязанныеСубъектыРейтинга.Субъект КАК Субъект
			|ПОМЕСТИТЬ _НаличиеГарантииРФ
			|ИЗ
			|	_СвязанныеСубъектыРейтинга КАК _СвязанныеСубъектыРейтинга
			|ГДЕ
			|	_СвязанныеСубъектыРейтинга.ВидСвязи = ""Гарант""
			|	И _СвязанныеСубъектыРейтинга.СвязанныйСубъект = &МинфинРоссии
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_СубъектыРейтинга.Субъект КАК Субъект
			|ПОМЕСТИТЬ _СубординированныеВыпуски
			|ИЗ
			|	#СубъектыРейтинга# КАК _СубъектыРейтинга
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
			|		ПО (Облигации.Ссылка = _СубъектыРейтинга.Субъект)
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
			|		ПО (ДепозитныеВклады.Ссылка = _СубъектыРейтинга.Субъект)
			|ГДЕ
			|	ТИПЗНАЧЕНИЯ(_СубъектыРейтинга.Субъект) В (ТИП(Справочник.Облигации), ТИП(Справочник.ДепозитныеВклады))
			|	И ЕСТЬNULL(Облигации.Субординированность, ДепозитныеВклады.Субординированность)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СвязанныеСубъектыРейтинга.Субъект КАК Субъект,
			|	_СвязанныеСубъектыРейтинга.СвязанныйСубъект КАК СвязанныйСубъект,
			|	ВЫБОР
			|		КОГДА &ПриоритетРоссийскихАгентствПередИностранными
			|				И _Рейтинги.РейтинговоеАгентство В (&ИностранныеАгентства)
			|			ТОГДА 100
			|		ИНАЧЕ 0
			|	КОНЕЦ + _СвязанныеСубъектыРейтинга.Приоритет КАК Приоритет,
			|	СопоставлениеРейтинговыхШкал.СтрокаСопоставления КАК СтрокаСопоставления,
			|	_Рейтинги.Рейтинг КАК Рейтинг,
			|	_Рейтинги.РейтинговоеАгентство КАК РейтинговоеАгентство,
			|	_Рейтинги.Шкала КАК Шкала,
			|	_Рейтинги.Оценка КАК Оценка,
			|	ВЫБОР
			|		КОГДА &СнижениеРейтингаСубординированнойБумагиПриОтсутствииРейтингаВыпуска <> 0
			|				И _СубординированныеВыпуски.Субъект ЕСТЬ НЕ NULL 
			|				И _НаличиеРейтинговНаДатуОценки.РейтингСубъекта = ЛОЖЬ
			|			ТОГДА _Рейтинги.Оценка + &СнижениеРейтингаСубординированнойБумагиПриОтсутствииРейтингаВыпуска
			|		ИНАЧЕ _Рейтинги.Оценка
			|	КОНЕЦ КАК СопоставляемаяОценка,
			|	СопоставлениеРейтинговыхШкал.ЗначениеМинимальное.Оценка КАК ЗначениеМинимальноеОценка,
			|	СопоставлениеРейтинговыхШкал.ЗначениеМаксимальное.Оценка КАК ЗначениеМаксимальноеОценка,
