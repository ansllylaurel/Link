			|	NULL,
			|	NULL,
			|	ЛОЖЬ
			|ИЗ
			|	#СубъектыРейтинга# КАК _СубъектыРейтинга
			|ГДЕ
			|	&ТолькоНаблюдаемыеДанные = ЛОЖЬ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СопоставленныеРейтинги.Субъект КАК Субъект,
			|	МИНИМУМ(_СопоставленныеРейтинги.СтрокаСопоставления) КАК НомерГруппы
			|ПОМЕСТИТЬ #РейтинговыеГруппы#
			|ИЗ
			|	_СопоставленныеРейтинги КАК _СопоставленныеРейтинги
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			_СопоставленныеРейтинги.Субъект КАК Субъект,
			|			МИНИМУМ(_СопоставленныеРейтинги.Приоритет) КАК Приоритет
			|		ИЗ
			|			_СопоставленныеРейтинги КАК _СопоставленныеРейтинги
			|		ГДЕ
			|			_СопоставленныеРейтинги.СтрокаСопоставления ЕСТЬ НЕ NULL 
			|		
			|		СГРУППИРОВАТЬ ПО
			|			_СопоставленныеРейтинги.Субъект) КАК ПриоритетРейтингов
			|		ПО (ПриоритетРейтингов.Субъект = _СопоставленныеРейтинги.Субъект)
			|			И (ПриоритетРейтингов.Приоритет = _СопоставленныеРейтинги.Приоритет)
			|
			|СГРУППИРОВАТЬ ПО
			|	_СопоставленныеРейтинги.Субъект";		
		
		Если Не ПараметрыРасчетаРейтинга.Свойство("КоличествоРейтинговыхГрупп") Тогда
			Если ПараметрыРасчетаРейтинга.ИсточникТаблицыСоответствияРейтингов = Справочники.ВнешниеСистемы.Атом_РасчетСС
		 		ИЛИ	ПараметрыРасчетаРейтинга.ИсточникТаблицыСоответствияРейтингов = Справочники.ВнешниеСистемы.НПФ_ОПФ
		 	Тогда 	
				ПараметрыРасчетаРейтинга.Вставить("КоличествоРейтинговыхГрупп", 3);		
			ИначеЕсли ПараметрыРасчетаРейтинга.ИсточникТаблицыСоответствияРейтингов = Справочники.ВнешниеСистемы.Газфонд
		 		ИЛИ	ПараметрыРасчетаРейтинга.ИсточникТаблицыСоответствияРейтингов = Справочники.ВнешниеСистемы.ОПИФ
		 		ИЛИ	ПараметрыРасчетаРейтинга.ИсточникТаблицыСоответствияРейтингов = Справочники.ВнешниеСистемы.ОПИФ2022
		 		ИЛИ	ПараметрыРасчетаРейтинга.ИсточникТаблицыСоответствияРейтингов = Справочники.ВнешниеСистемы.ОПИФ2023
		 		ИЛИ	ПараметрыРасчетаРейтинга.ИсточникТаблицыСоответствияРейтингов = Справочники.ВнешниеСистемы.ОПИФ2023_МРА
		 		ИЛИ	ПараметрыРасчетаРейтинга.ИсточникТаблицыСоответствияРейтингов = Справочники.ВнешниеСистемы.Традиция2024
				ИЛИ ПараметрыРасчетаРейтинга.ИсточникТаблицыСоответствияРейтингов = Справочники.ВнешниеСистемы.Сургутнефтегаз2023
				ИЛИ ПараметрыРасчетаРейтинга.ИсточникТаблицыСоответствияРейтингов = Справочники.ВнешниеСистемы.Сургутнефтегаз20230619
			Тогда 	
				ПараметрыРасчетаРейтинга.Вставить("КоличествоРейтинговыхГрупп", 4);
			ИначеЕсли ПараметрыРасчетаРейтинга.ИсточникТаблицыСоответствияРейтингов = Справочники.ВнешниеСистемы.Будущее Тогда 	
				ПараметрыРасчетаРейтинга.Вставить("КоличествоРейтинговыхГрупп", 5);
			ИначеЕсли ПараметрыРасчетаРейтинга.ИсточникТаблицыСоответствияРейтингов = Справочники.ВнешниеСистемы.ОПК Тогда 	
				ПараметрыРасчетаРейтинга.Вставить("КоличествоРейтинговыхГрупп", 17);
			Иначе
				ПараметрыРасчетаРейтинга.Вставить("КоличествоРейтинговыхГрупп", Неопределено);
			КонецЕсли;
		КонецЕсли;
		
		Если Не ПараметрыРасчетаРейтинга.Свойство("ТолькоНаблюдаемыеДанные") Тогда
			ПараметрыРасчетаРейтинга.Вставить("ТолькоНаблюдаемыеДанные", Ложь);
		КонецЕсли;
		
		Если ПараметрыРасчетаРейтинга.ТолькоНаблюдаемыеДанные = Ложь И Не ЗначениеЗаполнено(ПараметрыРасчетаРейтинга.КоличествоРейтинговыхГрупп) Тогда
			ВызватьИсключение "Для таблицы соответствия рейтингов не задано количество рейтинговых групп!
							  |Определение рейтинговой группы по ненаблюдаемым данным не может быть выполнено.";
		КонецЕсли;
		
		// #ТехДолг: необходимо проверить нужна ли данная вариативность для других методик
		Если Не ПараметрыРасчетаРейтинга.Свойство("УчитыватьВидРейтинга") Тогда
			ПараметрыРасчетаРейтинга.Вставить("УчитыватьВидРейтинга", Ложь);
		КонецЕсли;
		// #ТехДолг
		
		Если ПараметрыРасчетаРейтинга.Свойство("ПриоритетРоссийскихАгентствПередИностранными") Тогда
			Запрос.УстановитьПараметр("ПриоритетРоссийскихАгентствПередИностранными", ПараметрыРасчетаРейтинга.ПриоритетРоссийскихАгентствПередИностранными);
			Запрос.УстановитьПараметр("ИностранныеАгентства",						  Справочники.РейтинговыеАгентства.ИностранныеРейтинговыеАгентства());
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПриоритетРоссийскихАгентствПередИностранными", "ЛОЖЬ");	
		КонецЕсли;
		
		Если Не Запрос.Параметры.Свойство("ИностранныеАгентства") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИностранныеАгентства", "NULL"); // Если параметр не задан, то он и не нужен (убираем из расшифровки)	
		КонецЕсли;
		
		Если Не ПараметрыРасчетаРейтинга.Свойство("СнижениеРейтингаСубординированнойБумагиПриОтсутствииРейтингаВыпуска") Тогда
			ПараметрыРасчетаРейтинга.Вставить("СнижениеРейтингаСубординированнойБумагиПриОтсутствииРейтингаВыпуска", 0);
		КонецЕсли;
		
		ЗаданаРейтинговаяГруппаБумагСГарантиейРФПриОтсутствииРейтингаВыпускаИЭмитента = 
			ПараметрыРасчетаРейтинга.Свойство("РейтинговаяГруппаБумагСГарантиейРФПриОтсутствииРейтингаВыпускаИЭмитента")
				И ПараметрыРасчетаРейтинга.РейтинговаяГруппаБумагСГарантиейРФПриОтсутствииРейтингаВыпускаИЭмитента <> Неопределено;
		
		Если ЗаданаРейтинговаяГруппаБумагСГарантиейРФПриОтсутствииРейтингаВыпускаИЭмитента Тогда
			Запрос.УстановитьПараметр("РейтинговаяГруппаБумагСГарантиейРФПриОтсутствииРейтингаВыпускаИЭмитента", ПараметрыРасчетаРейтинга.РейтинговаяГруппаБумагСГарантиейРФПриОтсутствииРейтингаВыпускаИЭмитента);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&РейтинговаяГруппаБумагСГарантиейРФПриОтсутствииРейтингаВыпускаИЭмитента", "НЕОПРЕДЕЛЕНО");	
		КонецЕсли;
		
		Если ИспользуютсяСобственныеПараметрыРейтингаРФ
			ИЛИ ЗаданаРейтинговаяГруппаБумагСГарантиейРФПриОтсутствииРейтингаВыпускаИЭмитента
		Тогда
			Запрос.УстановитьПараметр("МинфинРоссии", ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии"));
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&МинфинРоссии", "NULL");
		КонецЕсли;
		
		Если ИспользуютсяСобственныеПараметрыРейтингаРФ
			И ПараметрыРасчетаРейтинга.ПараметрыРейтингаРФ.Свойство("ДатаРейтинга")
		Тогда
			Запрос.УстановитьПараметр("ДатаРейтингаРФ", ПараметрыРасчетаРейтинга.ПараметрыРейтингаРФ.ДатаРейтинга);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаРейтингаРФ", "&ДатаОценки");
		КонецЕсли;
		
		Если ИспользуютсяСобственныеПараметрыРейтингаРФ
			И ПараметрыРасчетаРейтинга.ПараметрыРейтингаРФ.Свойство("ИсточникТаблицыСоответствияРейтингов")
		Тогда
			Запрос.УстановитьПараметр("ИсточникТаблицыСоответствияРейтинговРФ", ПараметрыРасчетаРейтинга.ПараметрыРейтингаРФ.ИсточникТаблицыСоответствияРейтингов);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИсточникТаблицыСоответствияРейтинговРФ", "&ИсточникТаблицыСоответствияРейтингов");
		КонецЕсли;
		
		Если ПараметрыРасчетаРейтинга.Свойство("ИспользоватьПараметрыРейтингаРФДляГосударственныхЦенныхБумаг") Тогда
			
			Если ПараметрыРасчетаРейтинга.ИспользоватьПараметрыРейтингаРФДляГосударственныхЦенныхБумаг
				И ПараметрыРасчетаРейтинга.Свойство("РейтинговаяГруппаГосударственныхОблигаций")
				И ПараметрыРасчетаРейтинга.РейтинговаяГруппаГосударственныхОблигаций <> Неопределено
			Тогда
				ВызватьИсключение "Параметры 'РейтинговаяГруппаГосударственныхОблигаций' и 'ИспользоватьПараметрыРейтингаРФДляГосударственныхЦенныхБумаг' не могут быть заданы одновременно!";
			КонецЕсли;

			Запрос.УстановитьПараметр("ИспользоватьПараметрыРейтингаРФДляГосударственныхЦенныхБумаг", ПараметрыРасчетаРейтинга.ИспользоватьПараметрыРейтингаРФДляГосударственныхЦенныхБумаг);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИспользоватьПараметрыРейтингаРФДляГосударственныхЦенныхБумаг", "ЛОЖЬ");
		КонецЕсли;

		Если ПараметрыРасчетаРейтинга.Свойство("ИспользоватьПараметрыРейтингаРФДляБумагСГарантиейРФПриОтсутствииРейтингаВыпускаИЭмитента") Тогда
			
			Если ЗаданаРейтинговаяГруппаБумагСГарантиейРФПриОтсутствииРейтингаВыпускаИЭмитента
				И ПараметрыРасчетаРейтинга.ИспользоватьПараметрыРейтингаРФДляБумагСГарантиейРФПриОтсутствииРейтингаВыпускаИЭмитента
			Тогда
				ВызватьИсключение "Параметры 'РейтинговаяГруппаБумагСГарантиейРФПриОтсутствииРейтингаВыпускаИЭмитента' и 'ИспользоватьПараметрыРейтингаРФДляБумагСГарантиейРФПриОтсутствииРейтингаВыпускаИЭмитента' не могут быть заданы одновременно!";
			КонецЕсли;
			
			Запрос.УстановитьПараметр("ИспользоватьПараметрыРейтингаРФДляБумагСГарантиейРФПриОтсутствииРейтингаВыпускаИЭмитента", ПараметрыРасчетаРейтинга.ИспользоватьПараметрыРейтингаРФДляБумагСГарантиейРФПриОтсутствииРейтингаВыпускаИЭмитента);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИспользоватьПараметрыРейтингаРФДляБумагСГарантиейРФПриОтсутствииРейтингаВыпускаИЭмитента", "ЛОЖЬ");
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ТолькоНаблюдаемыеДанные",				ПараметрыРасчетаРейтинга.ТолькоНаблюдаемыеДанные);
		Запрос.УстановитьПараметр("ИсточникТаблицыСоответствияРейтингов",	ПараметрыРасчетаРейтинга.ИсточникТаблицыСоответствияРейтингов);	
		Запрос.УстановитьПараметр("КоличествоРейтинговыхГрупп",				ПараметрыРасчетаРейтинга.КоличествоРейтинговыхГрупп);
		Запрос.УстановитьПараметр("УчитыватьВидРейтинга",					ПараметрыРасчетаРейтинга.УчитыватьВидРейтинга);
		
		Запрос.УстановитьПараметр("СнижениеРейтингаСубординированнойБумагиПриОтсутствииРейтингаВыпуска", ПараметрыРасчетаРейтинга.СнижениеРейтингаСубординированнойБумагиПриОтсутствииРейтингаВыпуска);
		
		#КонецОбласти		
		
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#СубъектыРейтинга#",	ИмяТаблицыСубъектовРейтинга);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#РейтинговыеГруппы#", ИмяВременнойТаблицы);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		Запрос.Выполнить();
	Иначе
		РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Определение рейтинговой группы", "Рейтинг", Неопределено, , , Истина);
	КонецЕсли;
	
КонецПроцедуры

Функция ОпределитьРейтинговуюГруппу(Субъект, Дата, ПараметрыРасчетаРейтинга, МенеджерВременныхТаблиц = Неопределено, РасшифровкаРасчета = Неопределено) Экспорт
	
	МенеджерВТ = ?(МенеджерВременныхТаблиц = Неопределено, Новый МенеджерВременныхТаблиц, МенеджерВременныхТаблиц);
	
	ПоместитьРейтинговыеГруппыСубъектовВМенеджерВременныхТаблиц(МенеджерВТ, Субъект, Дата, ПараметрыРасчетаРейтинга, "_РейтинговыеГруппы", РасшифровкаРасчета);
	
	РейтинговыеГруппы = МенеджерВТ.Таблицы["_РейтинговыеГруппы"].ПолучитьДанные().Выбрать();
	Если РейтинговыеГруппы.Следующий() Тогда
		РейтинговаяГруппа = РейтинговыеГруппы.НомерГруппы;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(РейтинговаяГруппа) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Рейтинг " + Субъект + " не попал ни в одну рейтинговую группу");
	КонецЕсли;
	
	Возврат РейтинговаяГруппа;
	
КонецФункции

Функция РассчитатьКредитныйСпред(Субъект, Дата, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, Отказ, РасшифровкаРасчета = Неопределено) Экспорт
	
	Перем СтрокаПремииЗаСубординированность, ОтклонениеКредитногоСпреда, КоличествоДнейРасчетаКредитногоСпреда, ТочностьМедианыКредитногоСпреда;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расчет кредитного спреда", , , Истина);
	КонецЕсли;	
	
	// Проверки	
	
	Если ТипЗнч(Субъект) <> Тип("СправочникСсылка.Облигации")
		И ТипЗнч(Субъект) <> Тип("СправочникСсылка.ДепозитныеВклады")
		И ТипЗнч(Субъект) <> Тип("ДокументСсылка.МНО")
	Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	#Область Получение_рейтинговой_группы_субъекта
	
	РейтинговаяГруппа = ОпределитьРейтинговуюГруппу(Субъект, Дата, ПараметрыРасчетаРейтинга, МенеджерВременныхТаблиц, РасшифровкаОперации);
	
	Если Не ЗначениеЗаполнено(РейтинговаяГруппа) Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;	
	
	#КонецОбласти	
	
	#Область Возвращаем_нулевой_кредитный_спред_для_государственных_облигаций
	
	РассчитыватьКредитныйСпредДляГосударственныхОблигаций = 
		ПараметрыРасчетаКредитногоСпреда.Свойство("РассчитыватьКредитныйСпредДляГосударственныхОблигаций")
			И ПараметрыРасчетаКредитногоСпреда.РассчитыватьКредитныйСпредДляГосударственныхОблигаций;
	
	Если Не РассчитыватьКредитныйСпредДляГосударственныхОблигаций
		И ТипЗнч(Субъект) = Тип("СправочникСсылка.Облигации")
		И Субъект.УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииГосударства
	Тогда
		
		ТаблицаГос = Новый ТаблицаЗначений;
		ТаблицаГос.Колонки.Добавить("СтрокаСопоставления",		Новый ОписаниеТипов("Число"));
		ТаблицаГос.Колонки.Добавить("Медиана",					Новый ОписаниеТипов("Число"));
		ТаблицаГос.Колонки.Добавить("МинимумКредитногоСпреда",	Новый ОписаниеТипов("Число"));
		ТаблицаГос.Колонки.Добавить("МаксимумКредитногоСпреда",	Новый ОписаниеТипов("Число"));
		
		НоваяСтрокаТаблицаГос = ТаблицаГос.Добавить();
		НоваяСтрокаТаблицаГос.СтрокаСопоставления		= РейтинговаяГруппа;
		НоваяСтрокаТаблицаГос.Медиана					= 0;
		НоваяСтрокаТаблицаГос.МинимумКредитногоСпреда	= 0;
		НоваяСтрокаТаблицаГос.МаксимумКредитногоСпреда	= 0;
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Кредитный спред", 
				Новый Структура("Описание", "Расчет кредитного спреда для государственных облигаций не выполняется."));
		КонецЕсли;
		
		Возврат	ТаблицаГос;
		
	КонецЕсли;	
	
	#КонецОбласти

	#Область Заполнение_параметров_расчета_кредитного_спреда
	
	ОсновнойКалендарьКотировок = Константы.ОсновнойКалендарьКотировок.Получить();
	
	Если Не ПараметрыРасчетаКредитногоСпреда.Свойство("ВариантРасчетаКредитногоСпреда") Тогда
		ПараметрыРасчетаКредитногоСпреда.Вставить("ВариантРасчетаКредитногоСпреда", "ПоИндексамСовокупногоДоходаГосударственныхИКорпоративныхОблигаций");	
	КонецЕсли;
	
	ВариантРасчетаКредитногоСпреда = ПараметрыРасчетаКредитногоСпреда.ВариантРасчетаКредитногоСпреда;
	
	Если ПараметрыРасчетаКредитногоСпреда.Свойство("ВариантРасчетаКредитногоСпредаМуниципальныхОблигаций")
		И ЗначениеЗаполнено(ПараметрыРасчетаКредитногоСпреда.ВариантРасчетаКредитногоСпредаМуниципальныхОблигаций)
		И ТипЗнч(Субъект) = Тип("СправочникСсылка.Облигации")
		И (Субъект.Категория = Перечисления.КатегорииОблигаций.Муниципальная ИЛИ Субъект.Категория = Перечисления.КатегорииОблигаций.Субфедеральная)		
	Тогда
		ВариантРасчетаКредитногоСпреда = ПараметрыРасчетаКредитногоСпреда.ВариантРасчетаКредитногоСпредаМуниципальныхОблигаций;			
	КонецЕсли;	
	
	Если Не ПараметрыРасчетаКредитногоСпреда.Свойство("ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы") Тогда
		ПараметрыРасчетаКредитногоСпреда.Вставить("ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы", Неопределено); // т.е. переопределения расчета для данной рейтинговой группы нет  	
	КонецЕсли;
	
	Если Не ПараметрыРасчетаКредитногоСпреда.Свойство("ВариантРасчетаДиапазонаКредитногоСпреда") Тогда
		ПараметрыРасчетаКредитногоСпреда.Вставить("ВариантРасчетаДиапазонаКредитногоСпреда", "ПоМедиане");	
	КонецЕсли;
	
	Если Не ПараметрыРасчетаКредитногоСпреда.Свойство("ТочностьМедианыКредитногоСпреда", ТочностьМедианыКредитногоСпреда) Тогда
		ТочностьМедианыКредитногоСпреда = 0;
	КонецЕсли;
	
	Если ПараметрыРасчетаКредитногоСпреда.Свойство("ПремииЗаСубординированность") Тогда
		СтрокаПремииЗаСубординированность = ПараметрыРасчетаКредитногоСпреда.ПремииЗаСубординированность.Найти(Субъект, "ЦеннаяБумага");
	КонецЕсли;
	
	ПремияЗаСубординированность = ?(СтрокаПремииЗаСубординированность = Неопределено, 0, СтрокаПремииЗаСубординированность.ПроцентПремии * 100);
	
	Если Не ПараметрыРасчетаКредитногоСпреда.Свойство("УчитыватьПремиюЗаСубординированностьТолькоПриОтсутствииРейтингаВыпуска") Тогда
		ПараметрыРасчетаКредитногоСпреда.Вставить("УчитыватьПремиюЗаСубординированностьТолькоПриОтсутствииРейтингаВыпуска", Ложь);
	КонецЕсли;
	
	Если ПремияЗаСубординированность <> 0
		И ПараметрыРасчетаКредитногоСпреда.УчитыватьПремиюЗаСубординированностьТолькоПриОтсутствииРейтингаВыпуска
		И (ТипЗнч(Субъект) = Тип("СправочникСсылка.Облигации") ИЛИ ТипЗнч(Субъект) = Тип("СправочникСсылка.ДепозитныеВклады"))
	Тогда
		
		#Область Ищем_рейтинг_выпуска
		
		ЗапросРейтингов = Новый Запрос;
		ЗапросРейтингов.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		ЗапросРейтингов.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	*
			|ИЗ
			|	_СопоставленныеРейтинги КАК _СопоставленныеРейтинги
			|ГДЕ
			|	_СопоставленныеРейтинги.СвязанныйСубъект = _СопоставленныеРейтинги.Субъект
			|	И _СопоставленныеРейтинги.НаблюдаемыеДанные = ИСТИНА
			|	И _СопоставленныеРейтинги.СтрокаСопоставления ЕСТЬ НЕ NULL ";
			
		РейтингВыпускаНайден = Не ЗапросРейтингов.Выполнить().Пустой();
		
		#КонецОбласти
		
		Если РейтингВыпускаНайден Тогда
			ПремияЗаСубординированность = 0;	
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ПараметрыРасчетаКредитногоСпреда.Свойство("КоличествоДнейРасчетаКредитногоСпреда", КоличествоДнейРасчетаКредитногоСпреда) Тогда
		КоличествоДнейРасчетаКредитногоСпреда = 20;	
	КонецЕсли;	
	
	Если ПараметрыРасчетаКредитногоСпреда.Свойство("ИсключитьДеньПереоценки") И ПараметрыРасчетаКредитногоСпреда.ИсключитьДеньПереоценки Тогда
		ДатаПереоценки = НачалоДня(Дата) - 1;
	Иначе
		ДатаПереоценки = Дата;
	КонецЕсли;	
	
	Если Не ПараметрыРасчетаКредитногоСпреда.Свойство("БратьБиржевыеИндексыТолькоВДниТорговИнструментом") Тогда
		ПараметрыРасчетаКредитногоСпреда.Вставить("БратьБиржевыеИндексыТолькоВДниТорговИнструментом", Ложь);
	КонецЕсли;	
	
	#Область Определяем_календарь_индексов
	
	ЗапросКалендаря = Новый Запрос;
	ЗапросКалендаря.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Если ТипЗнч(Субъект) = Тип("СправочникСсылка.Облигации")
		И ПараметрыРасчетаКредитногоСпреда.БратьБиржевыеИндексыТолькоВДниТорговИнструментом
	Тогда
		
		РаботаСПереоценкой.ПоместитьСведенияОТоргахЦеннымиБумагамиВМенеджерВременныхТаблиц(ЗапросКалендаря, Субъект, ДатаПереоценки, КоличествоДнейРасчетаКредитногоСпреда, "_КалендарьИндексов");
		
	Иначе
		
		ЗапросКалендаря.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 20
			|	ДанныеКалендаря.Дата КАК Дата,
			|	АВТОНОМЕРЗАПИСИ() КАК ТорговыхДнейНазад
			|ПОМЕСТИТЬ _КалендарьИндексов
			|ИЗ
			|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|ГДЕ
			|	ДанныеКалендаря.Календарь = &ОсновнойКалендарьКотировок
			|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
			|	И ДанныеКалендаря.Дата <= &Период
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДанныеКалендаря.Дата УБЫВ";
		
		ЗапросКалендаря.Текст = СтрЗаменить(ЗапросКалендаря.Текст, "ПЕРВЫЕ 20", "ПЕРВЫЕ " + Формат(КоличествоДнейРасчетаКредитногоСпреда, "ЧН=; ЧГ="));
		
		ЗапросКалендаря.УстановитьПараметр("ОсновнойКалендарьКотировок", ОсновнойКалендарьКотировок);
		ЗапросКалендаря.УстановитьПараметр("Период",					 ДатаПереоценки);
		
		ЗапросКалендаря.Выполнить();
		
	КонецЕсли;
	
	ЗапросКалендаря.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ Дата ИЗ _КалендарьИндексов ГДЕ ТорговыхДнейНазад = 1";
	
	ПоследняяДатаТоргов = ЗапросКалендаря.Выполнить().Выгрузить()[0].Дата;
		
	#КонецОбласти
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Субъект",												  Субъект);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",									  ПоследняяДатаТоргов);
	
	Запрос.УстановитьПараметр("ВариантРасчетаКредитногоСпреда",							  ВариантРасчетаКредитногоСпреда);
	Запрос.УстановитьПараметр("ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы", ПараметрыРасчетаКредитногоСпреда.ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы);
	
	#КонецОбласти
	
	// Расчет кредитного спреда 	
	
	ОшибкаРасчета = Ложь;	

	Если ВариантРасчетаКредитногоСпреда = "РазностьИндексовСовокупногоДоходаКорпоративныхОблигацийИКБДВТочкеДюрацииИндекса" Тогда
		
		#Область Индексы_RUCBTRAAANS_RUCBTRA2A_RUCBTR2B3B		
		
		// Индексы: RUCBTRAAANS, RUCBTRA2A, RUCBTR2B3B
		
		// Рейтинговая группа I:		(Y_RUCBTRAAANS - КБД_DURATION_RUCBTRAAANS) * 100
		// Рейтинговая группа II:		(Y_RUCBTRA2A - КБД_DURATION_RUCBTRA2A) * 100
		// Рейтинговая группа III:		(Y_RUCBTR2B3B - КБД_DURATION_RUCBTR2B3B) * 100
		// Рейтинговая группа IV (1):	ОКРУГЛ(СРЗНАЧ(Y_TM - КБД_СРВЗВЕШ_СРОК_ДО_ПОГАШЕНИЯ_ЦБ), 4) * 100		
		// Рейтинговая группа IV (2):	(Y_RUCBICPL3 - Y_RUGBICP3Y) * 100, для долговых ценных бумаг, входящих в котировальный уровень 3 ММВБ
		// Рейтинговая группа IV (3):	(Y_RUCBICPL2 - Y_RUGBICP3Y) * 100, для долговых ценных бумаг, входящих в котировальный уровень 2 ММВБ

		ПоследняяРейтинговаяГруппа = 4;

		#Область Проверка_параметров_и_описание_алгоритма_расчета
		
		ОписаниеРасчета = Новый Структура("Описание",
			"RUCBTRAAANS, RUCBTRA2A, RUCBTR2B3B - индексы
			|Y - значение доходности соответствующего индекса ММВБ
			|КБД_DURATION - значение ставки КБД в точке, соответствующей дюрации соответствующего индекса ММВБ
			|Sрг - медиана спреда соответствующей рейтинговой группы 
			|
			|Расчет кредитного спреда:
			|Рейтинговая группа I:   (Y_RUCBTRAAANS - КБД_DURATION_RUCBTRAAANS) * 100
			|Рейтинговая группа II:  (Y_RUCBTRA2A - КБД_DURATION_RUCBTRA2A) * 100
			|Рейтинговая группа III: (Y_RUCBTR2B3B - КБД_DURATION_RUCBTR2B3B) * 100");
		
		Если ПараметрыРасчетаКредитногоСпреда.ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы = "ПоЗначениюПредыдущейРейтинговойГруппы" Тогда
			
			ОписаниеРасчета.Описание = ОписаниеРасчета.Описание + "
				|Рейтинговая группа IV: значение кредитного спреда для III рейтинговой группы, увеличенное на ОтклонениеКредитногоСпреда базисных пунктов";
		
		ИначеЕсли ПараметрыРасчетаКредитногоСпреда.ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы = "РазностьИндексовЧистыхЦенГосударственныхИКорпоративныхОблигаций" Тогда
			
			ОписаниеРасчета.Описание = ОписаниеРасчета.Описание + "
				|Рейтинговая группа IV (1): (Y_RUCBICPL3 - Y_RUGBICP3Y) * 100, для долговых ценных бумаг, входящих в котировальный уровень 3 ММВБ
				|Рейтинговая группа IV (2): (Y_RUCBICPL2 - Y_RUGBICP3Y) * 100, для долговых ценных бумаг, входящих в котировальный уровень 2 ММВБ";
			
		ИначеЕсли ПараметрыРасчетаКредитногоСпреда.ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы = Неопределено Тогда 
			
			ОписаниеРасчета.Описание = ОписаниеРасчета.Описание + "
				|Рейтинговая группа IV:  ОКРУГЛ(СРЗНАЧ(Y_TM - КБД_СРВЗВЕШ_СРОК_ДО_ПОГАШЕНИЯ_ЦБ), 4) * 100";
			
			Если РейтинговаяГруппа = 4 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Рейтинг " + Субъект + " попал в рейтинговую группу IV. Расчет кредитного спреда для данной группы не реализован.", , , , ОшибкаРасчета);
			КонецЕсли;
			
		Иначе
			
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Вариант расчета кредитного спреда IV рейтинговой группы '%1' не реализован", ПараметрыРасчетаКредитногоСпреда.ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы), , , , ОшибкаРасчета);
			
		КонецЕсли;
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаОперации, "Алгоритм", ОписаниеРасчета, "Алгоритм расчета кредитного спреда");
		КонецЕсли;
		
		Если ОшибкаРасчета Тогда
			Возврат Новый ТаблицаЗначений;
		КонецЕсли;
		
		#КонецОбласти

		#Область Получение_значений_индексов_и_расчет_значений_КБД_в_точке_дюрации_индекса
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_КалендарьИндексов.Дата КАК Период,
			|	RUCBTRAAANS.YIELD КАК Y_RUCBTRAAANS,
			|	RUCBTRAAANS.DURATION КАК DURATION_RUCBTRAAANS,
			|	0 КАК GCURVE_DURATION_RUCBTRAAANS,
			|	RUCBTRA2A.YIELD КАК Y_RUCBTRA2A,
			|	RUCBTRA2A.DURATION КАК DURATION_RUCBTRA2A,
			|	0 КАК GCURVE_DURATION_RUCBTRA2A,
			|	RUCBTR2B3B.YIELD КАК Y_RUCBTR2B3B,
			|	RUCBTR2B3B.DURATION КАК DURATION_RUCBTR2B3B,
			|	0 КАК GCURVE_DURATION_RUCBTR2B3B,
			|	RUGBICP3Y.YIELD КАК Y_RUGBICP3Y,
			|	RUCBICPL3.YIELD КАК Y_RUCBICPL3,
			|	RUCBICPL2.YIELD КАК Y_RUCBICPL2
			|ИЗ
			|	_КалендарьИндексов КАК _КалендарьИндексов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК RUCBTRAAANS
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БиржевыеИндексы КАК БиржевойИндекс_RUCBTRAAANS
			|			ПО (БиржевойИндекс_RUCBTRAAANS.Код = ""RUCBTRAAANS"")
			|				И (БиржевойИндекс_RUCBTRAAANS.Ссылка = RUCBTRAAANS.БиржевойИндекс)
			|		ПО (RUCBTRAAANS.Период = _КалендарьИндексов.Дата)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК RUCBTRA2A
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БиржевыеИндексы КАК БиржевойИндекс_RUCBTRA2A
			|			ПО (БиржевойИндекс_RUCBTRA2A.Код = ""RUCBTRA2A"")
			|				И (БиржевойИндекс_RUCBTRA2A.Ссылка = RUCBTRA2A.БиржевойИндекс)
			|		ПО (RUCBTRA2A.Период = _КалендарьИндексов.Дата)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК RUCBTR2B3B
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БиржевыеИндексы КАК БиржевойИндекс_RUCBTR2B3B
			|			ПО (БиржевойИндекс_RUCBTR2B3B.Код = ""RUCBTR2B3B"")
			|				И (БиржевойИндекс_RUCBTR2B3B.Ссылка = RUCBTR2B3B.БиржевойИндекс)
			|		ПО (RUCBTR2B3B.Период = _КалендарьИндексов.Дата)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК RUGBICP3Y
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БиржевыеИндексы КАК БиржевойИндекс_RUGBICP3Y
			|			ПО (БиржевойИндекс_RUGBICP3Y.Код = ""RUGBICP3Y"")
			|				И (БиржевойИндекс_RUGBICP3Y.Ссылка = RUGBICP3Y.БиржевойИндекс)
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК RUCBICPL3
			|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БиржевыеИндексы КАК БиржевойИндекс_RUCBICPL3
			|				ПО (БиржевойИндекс_RUCBICPL3.Код = ""RUCBICPL3"")
			|					И (БиржевойИндекс_RUCBICPL3.Ссылка = RUCBICPL3.БиржевойИндекс)
			|			ПО (RUCBICPL3.Период = RUGBICP3Y.Период)
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК RUCBICPL2
			|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БиржевыеИндексы КАК БиржевойИндекс_RUCBICPL2
			|				ПО (БиржевойИндекс_RUCBICPL2.Код = ""RUCBICPL2"")
			|					И (БиржевойИндекс_RUCBICPL2.Ссылка = RUCBICPL2.БиржевойИндекс)
			|			ПО (RUCBICPL2.Период = RUGBICP3Y.Период)
			|		ПО (RUGBICP3Y.Период = _КалендарьИндексов.Дата)
			|			И (&ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы = ""РазностьИндексовЧистыхЦенГосударственныхИКорпоративныхОблигаций"")
			|ГДЕ
			|	НЕ(RUGBICP3Y.Период ЕСТЬ NULL
			|				И &ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы = ""РазностьИндексовЧистыхЦенГосударственныхИКорпоративныхОблигаций"")";
		
		// Расчет значения КБД в точке дюрации индекса
		
		ТочностьКБД = 2;
		Если ПараметрыРасчетаКредитногоСпреда.Свойство("ТочностьКБД") Тогда
			ТочностьКБД = ПараметрыРасчетаКредитногоСпреда.ТочностьКБД;
		КонецЕсли;
		
		ЗначенияБиржевыхИндексов = Запрос.Выполнить().Выгрузить();
		
		Для Каждого ЗначениеБиржевогоИндекса Из ЗначенияБиржевыхИндексов Цикл

			ДюрацииИндексов = Новый Структура;
			ДюрацииИндексов.Вставить("RUCBTRAAANS",	ЗначениеБиржевогоИндекса.DURATION_RUCBTRAAANS);
			ДюрацииИндексов.Вставить("RUCBTRA2A",	ЗначениеБиржевогоИндекса.DURATION_RUCBTRA2A);
			ДюрацииИндексов.Вставить("RUCBTR2B3B",	ЗначениеБиржевогоИндекса.DURATION_RUCBTR2B3B);
				
			Для Каждого ДюрацияИндекса Из ДюрацииИндексов Цикл
				Если ДюрацияИндекса.Значение = 0 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Значение дюрации индекса %1 за %2 равно 0", ДюрацияИндекса.Ключ, Формат(ЗначениеБиржевогоИндекса.Период, "ДФ=dd.MM.yyyy")), , , , ОшибкаРасчета);
				КонецЕсли;
			Конеццикла;
			
			Если Не ОшибкаРасчета Тогда
				ЗначениеБиржевогоИндекса.GCURVE_DURATION_RUCBTRAAANS = Окр(РассчитатьЗначениеКривойБескупоннойДоходности(ЗначениеБиржевогоИндекса.Период, Окр(ДюрацииИндексов.RUCBTRAAANS / 365, 4), , ОшибкаРасчета), ТочностьКБД);
			КонецЕсли;
			Если Не ОшибкаРасчета Тогда
				ЗначениеБиржевогоИндекса.GCURVE_DURATION_RUCBTRA2A = Окр(РассчитатьЗначениеКривойБескупоннойДоходности(ЗначениеБиржевогоИндекса.Период, Окр(ДюрацииИндексов.RUCBTRA2A / 365, 4), , ОшибкаРасчета), ТочностьКБД);
			КонецЕсли;
			Если Не ОшибкаРасчета Тогда
				ЗначениеБиржевогоИндекса.GCURVE_DURATION_RUCBTR2B3B = Окр(РассчитатьЗначениеКривойБескупоннойДоходности(ЗначениеБиржевогоИндекса.Период, Окр(ДюрацииИндексов.RUCBTR2B3B / 365, 4), , ОшибкаРасчета), ТочностьКБД);
			КонецЕсли;
			
			Если ОшибкаРасчета Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Ошибка расчета кредитного спреда '%1'", Субъект), , , , Отказ);
				Возврат Новый ТаблицаЗначений;
			КонецЕсли;
			
		КонецЦикла;
		
		#КонецОбласти
		
		#Область Расчет_кредитного_спреда
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗначенияБиржевыхИндексов.Период КАК Период,
			|	ЗначенияБиржевыхИндексов.Y_RUCBTRAAANS КАК Y_RUCBTRAAANS,
			|	ЗначенияБиржевыхИндексов.DURATION_RUCBTRAAANS КАК DURATION_RUCBTRAAANS,
			|	ЗначенияБиржевыхИндексов.GCURVE_DURATION_RUCBTRAAANS КАК GCURVE_DURATION_RUCBTRAAANS,
			|	ЗначенияБиржевыхИндексов.Y_RUCBTRA2A КАК Y_RUCBTRA2A,
			|	ЗначенияБиржевыхИндексов.DURATION_RUCBTRA2A КАК DURATION_RUCBTRA2A,
			|	ЗначенияБиржевыхИндексов.GCURVE_DURATION_RUCBTRA2A КАК GCURVE_DURATION_RUCBTRA2A,
			|	ЗначенияБиржевыхИндексов.Y_RUCBTR2B3B КАК Y_RUCBTR2B3B,
			|	ЗначенияБиржевыхИндексов.DURATION_RUCBTR2B3B КАК DURATION_RUCBTR2B3B,
			|	ЗначенияБиржевыхИндексов.GCURVE_DURATION_RUCBTR2B3B КАК GCURVE_DURATION_RUCBTR2B3B,
			|	ЗначенияБиржевыхИндексов.Y_RUGBICP3Y КАК Y_RUGBICP3Y,
			|	ЗначенияБиржевыхИндексов.Y_RUCBICPL3 КАК Y_RUCBICPL3,
			|	ЗначенияБиржевыхИндексов.Y_RUCBICPL2 КАК Y_RUCBICPL2
			|ПОМЕСТИТЬ _ЗначенияБиржевыхИндексов
			|ИЗ
			|	&ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НомераРейтинговыхГрупп.НомерГруппы КАК НомерГруппы,
			|	_ЗначенияБиржевыхИндексов.Период КАК Период,
			|	ВЫБОР
			|		КОГДА НомераРейтинговыхГрупп.НомерГруппы = 1
			|			ТОГДА (_ЗначенияБиржевыхИндексов.Y_RUCBTRAAANS - _ЗначенияБиржевыхИндексов.GCURVE_DURATION_RUCBTRAAANS) * 100
			|		КОГДА НомераРейтинговыхГрупп.НомерГруппы = 2
			|			ТОГДА (_ЗначенияБиржевыхИндексов.Y_RUCBTRA2A - _ЗначенияБиржевыхИндексов.GCURVE_DURATION_RUCBTRA2A) * 100
			|		КОГДА НомераРейтинговыхГрупп.НомерГруппы = 3
			|			ТОГДА (_ЗначенияБиржевыхИндексов.Y_RUCBTR2B3B - _ЗначенияБиржевыхИндексов.GCURVE_DURATION_RUCBTR2B3B) * 100
			|		КОГДА НомераРейтинговыхГрупп.НомерГруппы = 4
			|				И КотировальныйУровеньММВБ.Значение = 3
			|			ТОГДА (_ЗначенияБиржевыхИндексов.Y_RUCBICPL3 - _ЗначенияБиржевыхИндексов.Y_RUGBICP3Y) * 100
			|		КОГДА НомераРейтинговыхГрупп.НомерГруппы = 4
			|				И КотировальныйУровеньММВБ.Значение = 2
			|			ТОГДА (_ЗначенияБиржевыхИндексов.Y_RUCBICPL2 - _ЗначенияБиржевыхИндексов.Y_RUGBICP3Y) * 100
			|	КОНЕЦ КАК КредитныйСпред,
			|	КотировальныйУровеньММВБ.Значение КАК КотировальныйУровеньММВБ
			|ПОМЕСТИТЬ _ЗначенияКредитныхСпредов
			|ИЗ
			|	_ЗначенияБиржевыхИндексов КАК _ЗначенияБиржевыхИндексов,
			|	(ВЫБРАТЬ
			|		1 КАК НомерГруппы
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		2
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		3
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		4) КАК НомераРейтинговыхГрупп
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
			|			КотировкиТорговыхПлощадок.LISTNAME КАК Значение
			|		ИЗ
			|			РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
			|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ _РейтинговыеГруппы КАК _РейтинговыеГруппы
			|				ПО (_РейтинговыеГруппы.НомерГруппы = 4)
			|		ГДЕ
			|			&ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы = ""РазностьИндексовЧистыхЦенГосударственныхИКорпоративныхОблигаций""
			|			И КотировкиТорговыхПлощадок.ЦеннаяБумага = &Субъект
			|			И КотировкиТорговыхПлощадок.Период = &ПоследняяДатаТоргов
			|			И КотировкиТорговыхПлощадок.Биржа = &ММВБ
			|			И КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим) КАК КотировальныйУровеньММВБ
			|		ПО (НомераРейтинговыхГрупп.НомерГруппы = 4)";
		
		Запрос.УстановитьПараметр("ММВБ",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));		
		Запрос.УстановитьПараметр("ЗначенияБиржевыхИндексов",	ЗначенияБиржевыхИндексов);

		Если РасшифровкаРасчета = Неопределено Тогда
			Запрос.Выполнить();
		Иначе
			РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаОперации, Запрос, , "Кредитный спред", Неопределено, "ПараметрыЗапроса, _ЗначенияБиржевыхИндексов, _ЗначенияКредитныхСпредов");
		КонецЕсли;
		
		#КонецОбласти
		
		#КонецОбласти
		
	ИначеЕсли ВариантРасчетаКредитногоСпреда = "РазностьИндексов_RUCBTRAAANS_RUCBTRAANS_RUCBTRANS_RUCBTRBBBNS_ИКБДВТочкеДюрацииИндекса" Тогда
		
		#Область Индексы_RUCBTRAAANS_RUCBTRAANS_RUCBTRANS_RUCBTRBBBNS		
		
		// Индексы: RUCBTRAAANS, RUCBTRAANS, RUCBTRANS, RUCBTRBBBNS
		
		// Рейтинговая группа I:	(Y_RUCBTRAAANS - КБД_DURATION_RUCBTRAAANS) * 100
		// Рейтинговая группа II:	(Y_RUCBTRAANS - КБД_DURATION_RUCBTRAANS) * 100
		// Рейтинговая группа III:	(Y_RUCBTRANS - КБД_DURATION_RUCBTRANS) * 100
		// Рейтинговая группа IV:	(Y_RUCBTRBBBNS - КБД_DURATION_RUCBTRBBBNS) * 100		
		// Рейтинговая группа V:	значение индекса G-spread полной доходности российского рынка высокодоходных (ВДО) корпоративных облигаций		

		ПоследняяРейтинговаяГруппа = 5;

		#Область Проверка_параметров_и_описание_алгоритма_расчета
		
		ОписаниеРасчета = Новый Структура("Описание",
			"RUCBTRAAANS, RUCBTRAANS, RUCBTRANS - индексы
			|Y - значение доходности соответствующего индекса ММВБ
			|КБД_DURATION - значение ставки КБД в точке, соответствующей дюрации соответствующего индекса ММВБ
			|Sрг - медиана спреда соответствующей рейтинговой группы 
			|
			|Расчет кредитного спреда:
			|Рейтинговая группа I:   (Y_RUCBTRAAANS - КБД_DURATION_RUCBTRAAANS) * 100
			|Рейтинговая группа II:  (Y_RUCBTRAANS - КБД_DURATION_RUCBTRAANS) * 100
			|Рейтинговая группа III: (Y_RUCBTRANS - КБД_DURATION_RUCBTRANS) * 100
			|Рейтинговая группа IV:  (Y_RUCBTRBBBNS - КБД_DURATION_RUCBTRBBBNS) * 100");
		
		Если ПараметрыРасчетаКредитногоСпреда.ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы = Неопределено Тогда 
			
			ОписаниеРасчета.Описание = ОписаниеРасчета.Описание + "
				|Рейтинговая группа V:  значение индекса G-spread полной доходности российского рынка высокодоходных (ВДО) корпоративных облигаций";
			
			Если РейтинговаяГруппа = ПоследняяРейтинговаяГруппа Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Рейтинг ""%1"" попал в рейтинговую группу %2. Расчет кредитного спреда для данной группы не реализован.",
						Субъект, РаботаСоСтрокамиКлиентСервер.ПреобразоватьЧислоВРимскуюНотацию(РейтинговаяГруппа, Ложь)), , , , ОшибкаРасчета);
			КонецЕсли;

		Иначе
			
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Вариант расчета кредитного спреда V рейтинговой группы '%1' не реализован", ПараметрыРасчетаКредитногоСпреда.ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы), , , , ОшибкаРасчета);
			
		КонецЕсли;
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаОперации, "Алгоритм", ОписаниеРасчета, "Алгоритм расчета кредитного спреда");
		КонецЕсли;
		
		Если ОшибкаРасчета Тогда
			Возврат Новый ТаблицаЗначений;
		КонецЕсли;
		
		#КонецОбласти

		#Область Получение_значений_индексов_и_расчет_значений_КБД_в_точке_дюрации_индекса
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_КалендарьИндексов.Дата КАК Период,
			|	RUCBTRAAANS.YIELD КАК Y_RUCBTRAAANS,
			|	RUCBTRAAANS.DURATION КАК DURATION_RUCBTRAAANS,
			|	0 КАК GCURVE_DURATION_RUCBTRAAANS,
			|	RUCBTRAANS.YIELD КАК Y_RUCBTRAANS,
			|	RUCBTRAANS.DURATION КАК DURATION_RUCBTRAANS,
			|	0 КАК GCURVE_DURATION_RUCBTRAANS,
			|	RUCBTRANS.YIELD КАК Y_RUCBTRANS,
			|	RUCBTRANS.DURATION КАК DURATION_RUCBTRANS,
			|	0 КАК GCURVE_DURATION_RUCBTRANS,
			|	RUCBTRBBBNS.YIELD КАК Y_RUCBTRBBBNS,
			|	RUCBTRBBBNS.DURATION КАК DURATION_RUCBTRBBBNS,
			|	0 КАК GCURVE_DURATION_RUCBTRBBBNS
			|ИЗ
			|	_КалендарьИндексов КАК _КалендарьИндексов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК RUCBTRAAANS
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БиржевыеИндексы КАК БиржевойИндекс_RUCBTRAAANS
			|			ПО (БиржевойИндекс_RUCBTRAAANS.Код = ""RUCBTRAAANS"")
			|				И (БиржевойИндекс_RUCBTRAAANS.Ссылка = RUCBTRAAANS.БиржевойИндекс)
			|		ПО (RUCBTRAAANS.Период = _КалендарьИндексов.Дата)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК RUCBTRAANS
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БиржевыеИндексы КАК БиржевойИндекс_RUCBTRAANS
			|			ПО (БиржевойИндекс_RUCBTRAANS.Код = ""RUCBTRAANS"")
			|				И (БиржевойИндекс_RUCBTRAANS.Ссылка = RUCBTRAANS.БиржевойИндекс)
			|		ПО (RUCBTRAANS.Период = _КалендарьИндексов.Дата)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК RUCBTRANS
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БиржевыеИндексы КАК БиржевойИндекс_RUCBTRANS
			|			ПО (БиржевойИндекс_RUCBTRANS.Код = ""RUCBTRANS"")
			|				И (БиржевойИндекс_RUCBTRANS.Ссылка = RUCBTRANS.БиржевойИндекс)
			|		ПО (RUCBTRANS.Период = _КалендарьИндексов.Дата)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК RUCBTRBBBNS
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БиржевыеИндексы КАК БиржевойИндекс_RUCBTRBBBNS
			|			ПО (БиржевойИндекс_RUCBTRBBBNS.Код = ""RUCBTRBBBNS"")
			|				И (БиржевойИндекс_RUCBTRBBBNS.Ссылка = RUCBTRBBBNS.БиржевойИндекс)
			|		ПО (RUCBTRBBBNS.Период = _КалендарьИндексов.Дата)";
		
		// Расчет значения КБД в точке дюрации индекса
		
		ТочностьКБД = 2;
		Если ПараметрыРасчетаКредитногоСпреда.Свойство("ТочностьКБД") Тогда
