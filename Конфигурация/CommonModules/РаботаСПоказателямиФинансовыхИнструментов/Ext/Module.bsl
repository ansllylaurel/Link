		И ПараметрыРасчетаКредитногоСпреда.ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы = "ПоЗначениюПредыдущейРейтинговойГруппы"
	Тогда
		
		Если Не ПараметрыРасчетаКредитногоСпреда.Свойство("ОтклонениеКредитногоСпредаПоследнейРейтинговойГруппы", ОтклонениеКредитногоСпреда) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон("Рейтинг ""%1"" попал в рейтинговую группу %2. Расчет кредитного спреда для данной группы выполняется на основании экспертного значения, которое на %3 не задано.",
					Субъект, РаботаСоСтрокамиКлиентСервер.ПреобразоватьЧислоВРимскуюНотацию(РейтинговаяГруппа, Ложь), Формат(Дата, "ДФ=dd.MM.yyyy")), , , , Отказ);
			Возврат Новый ТаблицаЗначений;
		КонецЕсли;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "_МедианыКредитныхСпредов.НомерГруппы = _РейтинговыеГруппы.НомерГруппы", "_МедианыКредитныхСпредов.НомерГруппы = " + (РейтинговаяГруппа - 1));
		
	ИначеЕсли Не ПараметрыРасчетаКредитногоСпреда.Свойство("ОтклонениеКредитногоСпреда", ОтклонениеКредитногоСпреда) Тогда
		
		ОтклонениеКредитногоСпреда = 0;
		
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("ВариантРасчетаДиапазонаКредитногоСпреда",								ПараметрыРасчетаКредитногоСпреда.ВариантРасчетаДиапазонаКредитногоСпреда);
	
	Запрос.УстановитьПараметр("ПремияЗаСубординированность",											ПремияЗаСубординированность);
	Запрос.УстановитьПараметр("УчитыватьПремиюЗаСубординированностьТолькоПриОтсутствииРейтингаВыпуска", ПараметрыРасчетаКредитногоСпреда.УчитыватьПремиюЗаСубординированностьТолькоПриОтсутствииРейтингаВыпуска);
	
	Запрос.УстановитьПараметр("ОтклонениеКредитногоСпреда",												ОтклонениеКредитногоСпреда);
	Запрос.УстановитьПараметр("ТочностьМедианыКредитногоСпреда",										ТочностьМедианыКредитногоСпреда); // чисто для расшифровки
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаОперации, "Диапазон кредитных спредов рейтинговых групп", ОписаниеРасчетаДиапазонаСпреда);
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаОперации, "Параметры расчета диапазона", Запрос.Параметры, , Истина, Истина);
	КонецЕсли;
	
	#КонецОбласти
	
	Если РасшифровкаРасчета = Неопределено Тогда
		КредитныйСпред = Запрос.Выполнить().Выгрузить();
	Иначе
		КредитныйСпред = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаОперации, Запрос, , "Кредитный спред", , "");
	КонецЕсли;	
	
	// Проверка корректности расчета кредитного спреда
	
	Если ТипЗнч(КредитныйСпред) <> Тип("ТаблицаЗначений")
		ИЛИ КредитныйСпред.Количество() = 0
		ИЛИ КредитныйСпред[0].Медиана = NULL
		ИЛИ КредитныйСпред[0].МинимумКредитногоСпреда = NULL
		ИЛИ КредитныйСпред[0].МаксимумКредитногоСпреда = NULL
	Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Ошибка расчета кредитного спреда '%1'", Субъект), , , , Отказ);
		
	Иначе
		
		Если ПараметрыРасчетаКредитногоСпреда.Свойство("ТочностьДиапазонаКредитныхСпредов") Тогда
			
			ОписаниеТипаДиапазонаКредитныхСпредов = Новый ОписаниеТипов("Число, NULL", 
				Новый КвалификаторыЧисла(27, ПараметрыРасчетаКредитногоСпреда.ТочностьДиапазонаКредитныхСпредов));
			
			РаботаСКоллекциями.ТаблицаЗначений_ОбновитьТочностьКолонок(КредитныйСпред,
				Новый Структура("МинимумКредитногоСпреда, МаксимумКредитногоСпреда", ОписаниеТипаДиапазонаКредитныхСпредов, ОписаниеТипаДиапазонаКредитныхСпредов));

		КонецЕсли;

	КонецЕсли;	
	
	Возврат КредитныйСпред;
	
КонецФункции

#КонецОбласти

#Область Средневзвешенный_срок_до_погашения

Функция РассчитатьСредневзвешенныйСрокДоПогашенияИлиОферты(Облигация, Дата, ДенежныйПоток)
	
	// Получаем потоки по погашению тела
	
	ДатаПереоценки = Неопределено;
	
	Если ДенежныйПоток = Неопределено Тогда	
		ВызватьИсключение "Не задан параметр 'Денежный поток'";
	КонецЕсли;	
		
	Если ДенежныйПоток.Колонки.Найти("Купон") <> Неопределено Тогда
		
		ПогашениеТела = ДенежныйПоток.Скопировать(Новый Структура("Купон", Ложь), "Дата, Поток");
		ПогашениеТела.Свернуть("Дата", "Поток");
		
	ИначеЕсли ДенежныйПоток.Колонки.Найти("ПотокПоТелу") <> Неопределено Тогда
		
		ПогашениеТела = Новый ТаблицаЗначений;
		ПогашениеТела.Колонки.Добавить("Дата",	Новый ОписаниеТипов("Дата"));
		ПогашениеТела.Колонки.Добавить("Поток",	Новый ОписаниеТипов("Число"));
		
		Для Каждого СтрокаПотока Из ДенежныйПоток Цикл
			Если СтрокаПотока.ПотокПоТелу <> 0 Тогда
				СтрокаПогашенияТела = ПогашениеТела.Добавить();
				СтрокаПогашенияТела.Дата	= СтрокаПотока.Дата;	
				СтрокаПогашенияТела.Поток	= СтрокаПотока.ПотокПоТелу;
			КонецЕсли;
		КонецЦикла;
		
		ПогашениеТела.Свернуть("Дата", "Поток");
		
	Иначе
		
		ПогашениеТела = ДенежныйПоток;	
		
	КонецЕсли;
	
	// Расчет	
	
	НоминалНаДату = Справочники.Облигации.ПолучитьНоминал(Облигация, Дата);
	
	СрокДоПогашения = 0;
	Для Каждого СтрокаПотока Из ПогашениеТела Цикл
		СрокДоПогашения = СрокДоПогашения + СтрокаПотока.Поток / НоминалНаДату * (СтрокаПотока.Дата - Дата) / 86400 / 365;
	КонецЦикла;
	
	Возврат СрокДоПогашения;
	
КонецФункции	

Функция РассчитатьСредневзвешенныйСрокДоПогашенияДепозита(ДепозитныйВклад, Дата)
	
	ДенежныйПоток = ДепозитныйВклад.ПлановыеВыплаты;
	НоминалНаДату = РаботаСКредитнымиИнструментами.ПолучитьДанныеКредитногоИнструмента(ДепозитныйВклад, Дата).Номинал;
	
	СрокДоПогашения = 0;
	Для Каждого КусокПотока Из ДенежныйПоток Цикл
		Если КусокПотока.Тип = Перечисления.ТипыВыплатПоДепозитнымВкладам.Проценты Тогда
			Продолжить;
		КонецЕсли;
		Если КусокПотока.Период > Дата Тогда
			Если ЗначениеЗаполнено(НоминалНаДату) Тогда
				СрокДоПогашения = СрокДоПогашения + КусокПотока.Сумма / НоминалНаДату * (КусокПотока.Период - НачалоДня(Дата)) / 86400 / 365;
			Иначе
				СрокДоПогашения = СрокДоПогашения + (КусокПотока.Период - НачалоДня(Дата)) / 86400 / 365;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	Возврат СрокДоПогашения;
	
КонецФункции

Функция РассчитатьСредневзвешенныйСрокДоПогашенияМНО(МНО, Дата)
	
	СрокДоПогашения = 0;
	Если МНО.ДатаВозврата > Дата Тогда
		СрокДоПогашения = (МНО.ДатаВозврата - НачалоДня(Дата)) / 86400 / 365;
	КонецЕсли;
	
	Возврат СрокДоПогашения;
	
КонецФункции

#КонецОбласти

#Область Безрисковая_ставка_доходности

Функция РассчитатьБезрисковуюСтавкуДоходности(ЦеннаяБумага, Дата, ДенежныйПоток = Неопределено, Отказ, РасшифровкаРасчета = Неопределено) Экспорт
	
	БезрисковаяСтавкаДоходности = 0;	
	
	Если ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") И ЦеннаяБумага.ИндексируемыйНоминал Тогда
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КотировкиТорговыхПлощадокСводныеСрезПоследних.YIELDCLOSE
			|ИЗ
			|	РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
			|			&Период,
			|			ЦеннаяБумага = &ЦеннаяБумага) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
			|ГДЕ
			|	КотировкиТорговыхПлощадокСводныеСрезПоследних.YIELDCLOSE <> 0");
		
		Запрос.УстановитьПараметр("Период", Дата);
		Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			БезрисковаяСтавкаДоходности = ВыборкаДетальныеЗаписи.YIELDCLOSE;
		КонецЕсли;

	Иначе
		
		БезрисковаяСтавкаДоходности = РассчитатьНоминальнуюБезрисковуюСтавкуДоходности(ЦеннаяБумага, Дата, ДенежныйПоток, Отказ, , 2, РасшифровкаРасчета);
		
	КонецЕсли;

	Возврат БезрисковаяСтавкаДоходности;
	
КонецФункции

// Бескупонная доходность актива в точке, соответствующей средневзвешенному сроку до погашения, в процентах
Функция РассчитатьНоминальнуюБезрисковуюСтавкуДоходности(Актив, Дата, ДенежныйПоток = Неопределено, Отказ, ТочностьСрокаДоПогашения = 4, ТочностьСтавки = Неопределено, РасшифровкаРасчета = Неопределено) Экспорт
	
	Если ТипЗнч(Актив) <> Тип("СправочникСсылка.Облигации")
		И ТипЗнч(Актив) <> Тип("СправочникСсылка.ДепозитныеВклады")
		И ТипЗнч(Актив) <> Тип("ДокументСсылка.МНО")
	Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ТипЗнч(Актив) = Тип("СправочникСсылка.Облигации") Тогда
		СрокДоПогашения = РассчитатьСредневзвешенныйСрокДоПогашенияИлиОферты(Актив, Дата, ДенежныйПоток);
	ИначеЕсли ТипЗнч(Актив) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		СрокДоПогашения = РассчитатьСредневзвешенныйСрокДоПогашенияДепозита(Актив, Дата);
	ИначеЕсли ТипЗнч(Актив) = Тип("ДокументСсылка.МНО") Тогда
		СрокДоПогашения = РассчитатьСредневзвешенныйСрокДоПогашенияМНО(Актив, Дата);
	КонецЕсли;
	
	Если ТочностьСрокаДоПогашения <> Неопределено Тогда
		СрокДоПогашения = Окр(СрокДоПогашения, ТочностьСрокаДоПогашения); // у Атома и Ливанова в методике описано округление. СД Инфинитум так считает
	КонецЕсли;
	
	ЗначениеКривой = 0;
	
	Если СрокДоПогашения <> 0 Тогда // дефолтные бумаги?
		ЗначениеКривой = РассчитатьЗначениеКривойБескупоннойДоходности(Дата, СрокДоПогашения, , Отказ);
	КонецЕсли;	
	
	Если ТочностьСтавки <> Неопределено Тогда
		ЗначениеКривой = Окр(ЗначениеКривой, ТочностьСтавки);	
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "РассчитатьНоминальнуюБезрисковуюСтавкуДоходности",
			Новый Структура("ТочностьСрокаДоПогашения, СрокДоПогашения, ТочностьСтавки, ЗначениеКБД", ТочностьСрокаДоПогашения, СрокДоПогашения, ТочностьСтавки, ЗначениеКривой),
			"Бескупонная доходность актива в точке, соответствующей средневзвешенному сроку до погашения");
	КонецЕсли;
	
	Возврат ЗначениеКривой; 
		
КонецФункции

// Возвращает значение КБД в процентах
//
// Параметры:
//	Дата				- Дата													- дата, на которую определяется значение
//	СрокДоПогашения		- Число													- срок до погашения в годах
//	ВидКривой			- ПеречислениеСсылка.ВидыКривойБескупоннойДоходности	- вид кривой
//						- Неопределено											- актуальный вид кривой Московской биржи, действующий на указанную дату
//	Отказ				- Булево												- выходной параметр, при ошибке устанавливается в значение Истина
//	ДатаЗначения		- Дата													- Необязательный. Выходной параметр, заполняется датой значения
//	РасшифровкаРасчета	- Структура, Неопределено								- 
//
// Возвращаемое значение:
//	Значение - Число - значение КБД или 0 при ошибке
//
Функция РассчитатьЗначениеКривойБескупоннойДоходности(Дата, СрокДоПогашения, ВидКривой = Неопределено, Отказ, ДатаЗначения = Неопределено, РасшифровкаРасчета = Неопределено) Экспорт
	
	#Область Проверка_входящих_параметров

	Если (ВидКривой = Перечисления.ВидыКривойБескупоннойДоходности.ЕврозонаААА 
		ИЛИ ВидКривой = Перечисления.ВидыКривойБескупоннойДоходности.Еврозона) 
		И Дата > Дата(2026, 7, 2) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Значения КБД '%1' не закачиваются с 02.07.2026 г. Обратитесь к программистам!", ВидКривой), , , , Отказ);
	КонецЕсли;	
	
	Если ВидКривой = Перечисления.ВидыКривойБескупоннойДоходности.ЕврозонаААА И СрокДоПогашения <> 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Получение значения КБД '%1' реализовано только для срока погашения 1 год", ВидКривой), , , , Отказ);
	КонецЕсли;
	
	#КонецОбласти
	
	КривыеСПредопределеннымиСроками = Новый Массив;
	КривыеСПредопределеннымиСроками.Добавить(Перечисления.ВидыКривойБескупоннойДоходности.США);
	КривыеСПредопределеннымиСроками.Добавить(Перечисления.ВидыКривойБескупоннойДоходности.Еврозона);
	КривыеСПредопределеннымиСроками.Добавить(Перечисления.ВидыКривойБескупоннойДоходности.ЕврозонаААА);
	
	Если ВидКривой = Неопределено
		ИЛИ КривыеСПредопределеннымиСроками.Найти(ВидКривой) = Неопределено
	Тогда
	
	    #Область Расчет_для_рублей
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПараметрыКривойБескупоннойДоходности.beta0,
			|	ПараметрыКривойБескупоннойДоходности.beta1,
			|	ПараметрыКривойБескупоннойДоходности.beta2,
			|	ПараметрыКривойБескупоннойДоходности.tau,
			|	ПараметрыКривойБескупоннойДоходности.g1,
			|	ПараметрыКривойБескупоннойДоходности.g2,
			|	ПараметрыКривойБескупоннойДоходности.g3,
			|	ПараметрыКривойБескупоннойДоходности.g4,
			|	ПараметрыКривойБескупоннойДоходности.g5,
			|	ПараметрыКривойБескупоннойДоходности.g6,
			|	ПараметрыКривойБескупоннойДоходности.g7,
			|	ПараметрыКривойБескупоннойДоходности.g8,
			|	ПараметрыКривойБескупоннойДоходности.g9,
			|	ПараметрыКривойБескупоннойДоходности.ВидПараметра
			|ИЗ
			|	РегистрСведений.ПараметрыКривойБескупоннойДоходности КАК ПараметрыКривойБескупоннойДоходности
			|ГДЕ
			|	ПараметрыКривойБескупоннойДоходности.Период = &Период
			|	И ПараметрыКривойБескупоннойДоходности.ВидПараметра В (&ВидКривой)");
			
		ДатаЗначения = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(), Дата);

		Если ДатаЗначения = '20220107' Тогда // биржа торговала, но параметры КБД не рассчитывала (#410701 #Хардкод)
			ДатаЗначения = '20220106';		
		КонецЕсли;

		Если ВидКривой = Неопределено Тогда
			ВидКривой = Новый Массив;
			ВидКривой.Добавить(Перечисления.ВидыКривойБескупоннойДоходности.Текущее);
			ВидКривой.Добавить(Перечисления.ВидыКривойБескупоннойДоходности.Текущее2017);
		КонецЕсли;

		Запрос.УстановитьПараметр("Период",		ДатаЗначения);
		Запрос.УстановитьПараметр("ВидКривой",	ВидКривой);

		РезультатЗапроса = Запрос.Выполнить();

		Если РезультатЗапроса.Пустой() Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет параметров кривой бескупонной доходности на " + Формат(ДатаЗначения, "ДФ=dd.MM.yyyy"), , , , Отказ);
			
		Иначе
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

			Если Не ВыборкаДетальныеЗаписи.НайтиСледующий(Новый Структура("ВидПараметра", Перечисления.ВидыКривойБескупоннойДоходности.Текущее2017)) Тогда
				ВыборкаДетальныеЗаписи.Сбросить();
				ВыборкаДетальныеЗаписи.НайтиСледующий(Новый Структура("ВидПараметра", Перечисления.ВидыКривойБескупоннойДоходности.Текущее));
			КонецЕсли;

			Возврат РассчитатьЗначениеКривойБескупоннойДоходностиПоПараметрам(ВыборкаДетальныеЗаписи.ВидПараметра, ВыборкаДетальныеЗаписи, СрокДоПогашения, Отказ);		
			
		КонецЕсли;

		#КонецОбласти			
	
	Иначе
	
	    #Область Расчет_для_США_и_Еврозоны
		
		Запрос = Новый Запрос;
		
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВЫРАЗИТЬ(ТаблицаИндексов.Индекс КАК Справочник.БиржевыеИндексы) КАК Индекс,
			|	ТаблицаИндексов.Срок КАК Срок
			|ПОМЕСТИТЬ _ТаблицаИндексов
			|ИЗ
			|	&ТаблицаИндексов КАК ТаблицаИндексов
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗначенияБиржевыхИндексов.Период КАК Период,
			|	ЗначенияБиржевыхИндексов.БиржевойИндекс КАК Индекс,
			|	ЗначенияБиржевыхИндексов.YIELD КАК Доходность
			|ПОМЕСТИТЬ _ЗначенияБиржевыхИндексов
			|ИЗ
			|	РегистрСведений.ЗначенияБиржевыхИндексов.СрезПоследних(
			|			&Период,
			|			(Биржа, БиржевойИндекс) В
			|				(ВЫБРАТЬ
			|					_ТаблицаИндексов.Индекс.Владелец,
			|					_ТаблицаИндексов.Индекс
			|				ИЗ
			|					_ТаблицаИндексов)) КАК ЗначенияБиржевыхИндексов
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	МАКСИМУМ(_ЗначенияБиржевыхИндексов.Период) КАК Период
			|ПОМЕСТИТЬ _ПоследняяДатаИндексов
			|ИЗ
			|	_ЗначенияБиржевыхИндексов КАК _ЗначенияБиржевыхИндексов
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ТаблицаИндексов.Индекс КАК Индекс,
			|	_ТаблицаИндексов.Срок КАК Срок,
			|	_ЗначенияБиржевыхИндексов.Доходность КАК Доходность
			|ИЗ
			|	_ТаблицаИндексов КАК _ТаблицаИндексов
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияБиржевыхИндексов КАК _ЗначенияБиржевыхИндексов
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПоследняяДатаИндексов КАК _ПоследняяДатаИндексов
			|			ПО _ЗначенияБиржевыхИндексов.Период = _ПоследняяДатаИндексов.Период
			|		ПО (_ЗначенияБиржевыхИндексов.Индекс = _ТаблицаИндексов.Индекс)";
		
		Если ВидКривой = Перечисления.ВидыКривойБескупоннойДоходности.США Тогда
			ТаблицаИндексов = Справочники.БиржевыеИндексы.ИндексыГосударственныхОблигацийСША();
		Иначе
			ТаблицаИндексов = Справочники.БиржевыеИндексы.ИндексыГосударственныхОблигацийЕврозоны(ВидКривой = Перечисления.ВидыКривойБескупоннойДоходности.ЕврозонаААА);
		КонецЕсли;		

		СтрокаИндекса = ТаблицаИндексов.Найти(СрокДоПогашения, "Срок"); // Если указана узловая точка, то наличие других значений не требуется
		
		Если СтрокаИндекса <> Неопределено Тогда
			ТаблицаИндексов = ТаблицаИндексов.Скопировать(РаботаСКоллекциями.ЗначениеВМассив(СтрокаИндекса));
		КонецЕсли;	
			
		Запрос.УстановитьПараметр("Период",			 Дата);
		Запрос.УстановитьПараметр("ТаблицаИндексов", ТаблицаИндексов);

		ЗначенияИндексов = Запрос.Выполнить().Выгрузить();
		ДатаЗначения	 = Запрос.МенеджерВременныхТаблиц.Таблицы["_ПоследняяДатаИндексов"].ПолучитьДанные().Выгрузить()[0][0];

		Если ЗначенияИндексов.Количество() > 0 Тогда

			ПустыеЗначения = ЗначенияИндексов.НайтиСтроки(Новый Структура("Доходность", NULL));
			
			Если ПустыеЗначения.Количество() = 0 Тогда
				
				Если СтрокаИндекса = Неопределено Тогда
					
					Возврат МатематическиеФункции.ЛинейнаяИнтерполяция(СрокДоПогашения, ЗначенияИндексов, "Срок", "Доходность", РасшифровкаРасчета);
					
				Иначе	
					
					Если РасшифровкаРасчета <> Неопределено Тогда
						РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "Значение КБД в точке " + СрокДоПогашения, Новый Структура("Описание, Значение", "Точка совпадает с узловой", ЗначенияИндексов[0].Доходность));
					КонецЕсли;
					
					Возврат ЗначенияИндексов[0].Доходность;
					
				КонецЕсли;					
				
			Иначе
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("На %1 нет значений индексов %2",
						Формат(ДатаЗначения, "ДФ=dd.MM.yyyy"), СтрСоединить(ЗначенияИндексов.Скопировать(ПустыеЗначения).ВыгрузитьКолонку("Индекс"), ", ")), , , , Отказ);
						
			КонецЕсли;
				
		Иначе
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("На %1 нет значений КБД '%2'", Формат(Дата, "ДФ=dd.MM.yyyy"), ВидКривой), , , , Отказ);
			
		КонецЕсли;		

		#КонецОбласти
		
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция РассчитатьЗначениеКривойБескупоннойДоходностиПоПараметрам(ВидКривой, ПараметрыКривой, СрокДоПогашения, Отказ) Экспорт
	
	Если СрокДоПогашения = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Срок до погашения не может быть равен 0", , , , Отказ);
		Возврат 0;
	КонецЕсли;	
	
	Если ВидКривой = Перечисления.ВидыКривойБескупоннойДоходности.Текущее2017 Тогда
		
		beta0 	= ПараметрыКривой.beta0;
		beta1 	= ПараметрыКривой.beta1;
		beta2 	= ПараметрыКривой.beta2;
		tau 	= ПараметрыКривой.tau;
		
		g		= Новый Массив(10);
		g[1]	= ПараметрыКривой.g1;
		g[2]	= ПараметрыКривой.g2;
		g[3]	= ПараметрыКривой.g3;
		g[4]	= ПараметрыКривой.g4;
		g[5]	= ПараметрыКривой.g5;
		g[6]	= ПараметрыКривой.g6;
		g[7]	= ПараметрыКривой.g7;
		g[8]	= ПараметрыКривой.g8;
		g[9]	= ПараметрыКривой.g9;
		
		ЗначениеКривой = beta0 
			+ (beta1 + beta2) * tau / СрокДоПогашения * (1 - Exp( - СрокДоПогашения / tau))
			- beta2 * Exp( - СрокДоПогашения / tau);
		
		к = 1.6;
		а2 = 0.6;
		
		Для сц=1 по 9 Цикл
			
			а = ?(сц=1, 0, ?(сц=2, а2, а + а2 * Pow(к,сц-2)));
			б = ?(сц=1, а2, б * к);
			
			ЗначениеКривой = ЗначениеКривой
				+ g[сц] * Exp( - Pow(СрокДоПогашения - а, 2) / Pow(б, 2));
				
		КонецЦикла;	
			
	ИначеЕсли ВидКривой = Перечисления.ВидыКривойБескупоннойДоходности.Текущее Тогда
		
		beta0 	= ПараметрыКривой.beta0;
		beta1 	= ПараметрыКривой.beta1;
		beta2 	= ПараметрыКривой.beta2;
		tau 	= ПараметрыКривой.tau;
		g1 		= ПараметрыКривой.g1;
		g2 		= ПараметрыКривой.g2;
		g3 		= ПараметрыКривой.g3;
		
		ЗначениеКривой = beta0 
			+ (beta1 + beta2) * tau / СрокДоПогашения * (1 - Exp( - СрокДоПогашения / tau))
			- beta2 * Exp( - СрокДоПогашения / tau)
			+ g1 * Exp( - Pow(СрокДоПогашения, 2) / 2)
			+ g2 * Exp( - Pow(СрокДоПогашения - 1, 2) / 2)
			+ g3 * Exp( - Pow(СрокДоПогашения - 2, 2) / 2);		
		
	КонецЕсли;
	
	ЗначениеКривойВПроцентах = 100 * (Exp(ЗначениеКривой / 10000) - 1);
	
	Возврат ЗначениеКривойВПроцентах;	
	
КонецФункции

#КонецОбласти

#Область Дисконтирование_стоимости_денежного_потока

// Возвращает дисконтированную стоимость денежных потоков, рассчитанную по формуле:
//                CF(i)
// СС = Σ ———————————————————————— 
//                   t(i) - t(0)
//                   ——————————— 
//        (1 + r) ^       T
//			
// CF(i)    – будущие денежные потоки по долговой ценной бумаге
// r     	– ставка дисконтирования
// t(i)     – дата i-го платежа
// t(0)		– дата оценки
// T		– количество календарных дней в году, к которому относится платеж
//
// Параметры:
//	ДенежныйПоток					- ТаблицаЗначений			- денежные потоки
//	СтавкаДисконтирования			- Число 					- ставка дисконтирования
//	ДатаПереоценки					- Дата 						- 
//	ПараметрыОценки					- Структура, Неопределено	- ключи ТочностьДисконтированногоПотока 
//	Отказ							- Булево					- 
//	РасшифровкаРасчета				- Структура, Неопределено 	- 
//
// Возвращаемое значение:
//	Стоимость - Число - рассчитанная стоимость или 0 при ошибке (Отказ = Истина)
//
Функция РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтавкаДисконтирования, ДатаПереоценки, ПараметрыОценки = Неопределено, Отказ = Ложь, РасшифровкаРасчета = Неопределено) Экспорт

	#Область Проверка_и_обработка_входящих_параметров
	
	Если ТипЗнч(ДенежныйПоток) <> Тип("ТаблицаЗначений") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Некорректное значение параметра денежный поток '%1'", ТипЗнч(ДенежныйПоток)), , , , Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	ТочностьДисконтированногоПотока	= Неопределено;
	
	Если ТипЗнч(ПараметрыОценки) = Тип("Структура") Тогда
		ПараметрыОценки.Свойство("ТочностьДисконтированногоПотока",	ТочностьДисконтированногоПотока);
	КонецЕсли;
	
	#КонецОбласти
	
	БудущиеПотоки = ДенежныйПоток.Скопировать(, "Дата, Поток");
	
	БудущиеПотоки.Колонки.Добавить("КоличествоДней",		Новый ОписаниеТипов("Число"));
	БудущиеПотоки.Колонки.Добавить("ДисконтированныйПоток",	Новый ОписаниеТипов("Число"));
	
	Для Каждого Поток Из БудущиеПотоки Цикл
		
		Поток.КоличествоДней = ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(Поток.Дата, ДатаПереоценки);
		
		ДисконтированныйПоток = Поток.Поток / Pow(1 + СтавкаДисконтирования / 100, Поток.КоличествоДней / 365);
		
		Поток.ДисконтированныйПоток = ?(ТочностьДисконтированногоПотока = Неопределено, ДисконтированныйПоток, Окр(ДисконтированныйПоток, ТочностьДисконтированногоПотока));  
		
	КонецЦикла;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Дисконтирование денежных потоков", БудущиеПотоки);
	КонецЕсли;
	
	Возврат БудущиеПотоки.Итог("ДисконтированныйПоток");
	
КонецФункции

// Возвращает дисконтированную стоимость денежных потоков, рассчитанную по формуле:
//                  CF(i) * k
// СС = Σ ————————————————————————————— 
//                         t(i) - t(0)
//                         ——————————— 
//        (1 + r(i) + Δ) ^      T
//			
// CF(i)    – будущие денежные потоки по долговой ценной бумаге
// k		- коэффициент (k) корректировки потока (например, в результате оценки ожидаемых потерь в случае дефолта)
// r(i)     – доходность кривой бескупонной доходности (G-кривая), соответствующая дате выплаты i-го денежного потока
// Δ        - отклонение от КБД (например, CrSpread – медианное значение кредитного спреда облигационного индекса)
// t(i)     – дата i-го платежа
// t(0)		– дата оценки
// T		– количество календарных дней в году, к которому относится платеж
//
// Параметры:
//	ДенежныйПоток					- ТаблицаЗначений			- денежные потоки
//	ДатаПереоценки					- Дата 						- 
//	ОтклонениеСтавки				- Число						- отклонение (Δ) от доходности кривой бескупонной доходности  
//	КоэффициентКорректировкиПотока	- Число						- коэффициент (k) корректировки потока  
//	ПараметрыОценки					- Структура, Неопределено	- ключи ТочностьКБД, ТочностьСтавкиДисконтирования, ТочностьДисконтированногоПотока 
//	Отказ							- Булево					- 
//	РасшифровкаРасчета				- Структура, Неопределено 	- 
//
// Возвращаемое значение:
//	Стоимость - Число - рассчитанная стоимость или 0 при ошибке (Отказ = Истина)
//
Функция РассчитатьДисконтированнуюСтоимостьПоЗначениямКривойБескупоннойДоходности(ДенежныйПоток, ДатаПереоценки, ОтклонениеСтавки = 0, КоэффициентКорректировкиПотока = 1, ПараметрыОценки = Неопределено, Отказ = Ложь, РасшифровкаРасчета = Неопределено) Экспорт
	
	#Область Проверка_и_обработка_входящих_параметров
	
	Если ТипЗнч(ДенежныйПоток) <> Тип("ТаблицаЗначений") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Некорректное значение параметра денежный поток '%1'", ТипЗнч(ДенежныйПоток)), , , , Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	ТочностьКБД						= Неопределено;
	ТочностьСтавкиДисконтирования	= Неопределено;
	ТочностьДисконтированногоПотока	= Неопределено;
	ТочностьСрокаДоДатыПотока		= Неопределено;
	
	Если ТипЗнч(ПараметрыОценки) = Тип("Структура") Тогда
		ПараметрыОценки.Свойство("ТочностьКБД",						ТочностьКБД);
		ПараметрыОценки.Свойство("ТочностьСтавкиДисконтирования",	ТочностьСтавкиДисконтирования);
		ПараметрыОценки.Свойство("ТочностьДисконтированногоПотока",	ТочностьДисконтированногоПотока);
		ПараметрыОценки.Свойство("ТочностьСрокаДоДатыПотока",		ТочностьСрокаДоДатыПотока);
	КонецЕсли;
	
	#КонецОбласти
	
	БудущиеПотоки = ДенежныйПоток.Скопировать(, "Дата, Поток");

	Если КоэффициентКорректировкиПотока <> 1 Тогда
		БудущиеПотоки.Колонки.Добавить("СкорректированныйПоток", Новый ОписаниеТипов("Число"));
	КонецЕсли;
	
	БудущиеПотоки.Колонки.Добавить("КоличествоДней",		Новый ОписаниеТипов("Число"));
	БудущиеПотоки.Колонки.Добавить("КоличествоЛет",			Новый ОписаниеТипов("Число"));
	БудущиеПотоки.Колонки.Добавить("СтавкаКБД",				Новый ОписаниеТипов("Число"));
	БудущиеПотоки.Колонки.Добавить("СтавкаДисконтирования",	Новый ОписаниеТипов("Число"));
	БудущиеПотоки.Колонки.Добавить("ДисконтированныйПоток",	Новый ОписаниеТипов("Число"));
	
	Для Каждого Поток Из БудущиеПотоки Цикл
		
		Если КоэффициентКорректировкиПотока <> 1 Тогда
			Поток.СкорректированныйПоток = Поток.Поток * КоэффициентКорректировкиПотока;
		КонецЕсли;
		
		Поток.КоличествоДней = ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(Поток.Дата, ДатаПереоценки);
		Поток.КоличествоЛет	 = Поток.КоличествоДней / 365;
		
		Если ТочностьСрокаДоДатыПотока <> Неопределено Тогда
			Поток.КоличествоЛет	 = Окр(Поток.КоличествоЛет, ТочностьСрокаДоДатыПотока);
		КонецЕсли;
		
		ЗначениеКБД = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьЗначениеКривойБескупоннойДоходности(ДатаПереоценки, Поток.КоличествоЛет, , Отказ);
		
		Если Отказ = Истина Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Поток.СтавкаКБД = ?(ТочностьКБД = Неопределено, ЗначениеКБД, Окр(ЗначениеКБД, ТочностьКБД)) / 100;
		
		СтавкаДисконтирования = Поток.СтавкаКБД + ОтклонениеСтавки;
		
		Поток.СтавкаДисконтирования = ?(ТочностьСтавкиДисконтирования = Неопределено, СтавкаДисконтирования, Окр(СтавкаДисконтирования, ТочностьСтавкиДисконтирования + 2));
		
		СуммаПотока = ?(КоэффициентКорректировкиПотока <> 1, Поток.СкорректированныйПоток, Поток.Поток); 
		
		ДисконтированныйПоток = СуммаПотока / Pow(1 + Поток.СтавкаДисконтирования, Поток.КоличествоДней / 365);
		
		Поток.ДисконтированныйПоток = ?(ТочностьДисконтированногоПотока = Неопределено, ДисконтированныйПоток, Окр(ДисконтированныйПоток, ТочностьДисконтированногоПотока));  
		
	КонецЦикла;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Дисконтирование денежных потоков по ставке КБД в точке, соответствующей дате потока", БудущиеПотоки);
	КонецЕсли;
	
	Возврат БудущиеПотоки.Итог("ДисконтированныйПоток");
				
КонецФункции

#КонецОбласти
