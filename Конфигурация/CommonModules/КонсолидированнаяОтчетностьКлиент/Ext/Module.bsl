#Область ПрограммныйИнтерфейс

Функция НуженПересчетОсновногоРаздела(ИмяРаздела) Экспорт
	
	МассивИсключений = Новый Массив;
	МассивИсключений.Добавить("ТабличныйДокументИнформацияОКредитномКачествеДолговыхФинансовыхАктивов");
	МассивИсключений.Добавить("ТабличныйДокументИнформацияОКредитномКачествеПоДепозитам");
	МассивИсключений.Добавить("ТабличныйДокументИнформацияОКредитномКачествеПрочихРазмещенныхСредствИДЗ");
	МассивИсключений.Добавить("ТабличныйДокументАнализФинансовыхАктивовИФинансовыхОбязательствВРазрезеСроков");
	МассивИсключений.Добавить("ТабличныйДокументКраткийОбзорФинансовыхАктивовИОбязательств");
	МассивИсключений.Добавить("ТабличныйДокументИнформацияОБалансовойСтоимостиФинансовыхАктивов");
	МассивИсключений.Добавить("ТабличныйДокументУровниВИерархииСправедливойСтоимости");
	МассивИсключений.Добавить("ТабличныйДокументМетодыОценкиИИсходныеДанныеУровня2");
	МассивИсключений.Добавить("ТабличныйДокументМетодыОценкиИИсходныеДанныеУровня3");
	МассивИсключений.Добавить("ТабличныйДокументФинансовыеИнструментыПодлежащиеВзаимозачету");
	
	МассивИсключений.Добавить("ТабличныйДокументИнформацияОКредитныхРейтингахДолговыхИнструментов");
	МассивИсключений.Добавить("ТабличныйДокументГеографическийАнализФинансовыхАктивовИОбязательств");
	МассивИсключений.Добавить("ТабличныйДокументАнализФинансовыхАктивовИОбязательствВРазрезеСроков");
	МассивИсключений.Добавить("ТабличныйДокументОбзорФинансовыхАктивовИОбязательствВРазрезеОсновныхВалют");
	МассивИсключений.Добавить("ТабличныйДокументАнализПроцентногоРискаКВозможнымИзменениямВПроцентныхСтавках");
	МассивИсключений.Добавить("ТабличныйДокументУровниВИерархииСправедливойСтоимости");
	МассивИсключений.Добавить("ТабличныйДокументМетодыОценкиИИсходныеДанныеУровня2");
	МассивИсключений.Добавить("ТабличныйДокументМетодыОценкиИИсходныеДанныеУровня3");
	МассивИсключений.Добавить("ТабличныйДокументАнализСправедливойСтоимостиИБалансоваяСтоимость");
	
	Если СтрЧислоВхождений(ИмяРаздела, "ТабличныйДокументПримечание") > 0 Или МассивИсключений.Найти(ИмяРаздела) <> Неопределено Тогда
		Возврат ЛОЖЬ;
	КонецЕсли;
	
	Возврат ИСТИНА;
	
КонецФункции

// ОкруглитьЧислоПоФормату
Функция ОкруглитьЧислоПоФормату(ИсходноеЧисло, Точность, Делитель = 1) Экспорт
	
	пДелитель = ?(Делитель = 0, 1, Делитель);
	ОкругленноеЧисло = Окр(ИсходноеЧисло / пДелитель, Точность) * пДелитель;
	
	Возврат ОкругленноеЧисло;
	
КонецФункции

// РасчетМногострочногоРаздела
Процедура РасчетМногострочногоРаздела(ТабДок, МассивСтрок, Точность, Делитель) Экспорт
	
	Для Каждого СтрокаПоказателя Из МассивСтрок Цикл
		
		ИмяПоказателя = СтрокаПоказателя.ИмяПоказателя;
		
		стрНомКол = Прав(ИмяПоказателя, 2);
		
		ЗначениеПоказателя = 0;
		
		КонНомСтр = Число(Сред(ИмяПоказателя, 2, 2)) - 1;
		Для НомСтр = 1 По КонНомСтр Цикл
			стрНомСтр = ?(НомСтр < 10, "0" + НомСтр, "" + НомСтр);
			ЗначениеПоказателя = ЗначениеПоказателя + ОкруглитьЧислоПоФормату(ТабДок.Области["П" + стрНомСтр + стрНомКол].Значение, Точность, Делитель);
		КонецЦикла;
		
		ТабДок.Области[ИмяПоказателя].Значение = ЗначениеПоказателя;
		
	КонецЦикла;
	
КонецПроцедуры

// РасчетИтоговНачало
Процедура РасчетИтоговНачало(ЭтаФорма, ИмяРаздела) Экспорт
	// #ЧисткаИтогов
	
	Если ИмяРаздела = "" Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.мСтруктураРасчетаИтогов = Неопределено Тогда
		ЭтаФорма.мСтруктураРасчетаИтогов = Новый Структура;
		
	КонецЕсли;
	
	// Если уже есть итоги по разделу ИмяРаздела, то удалим ветку из структуры.
	Если ЭтаФорма.мСтруктураРасчетаИтогов.Свойство(ИмяРаздела) Тогда
		ЭтаФорма.мСтруктураРасчетаИтогов.Удалить(ИмяРаздела);
	КонецЕсли;
	
КонецПроцедуры

// ИтоговаяЯчейкаПервыйРасчет
Функция ИтоговаяЯчейкаПервыйРасчет(ЭтаФорма, ИмяРаздела, ИмяЯчейки, Ячейка) Экспорт
	// #ЧисткаИтогов
	
	Если ИмяРаздела = "" Тогда
		Возврат ЛОЖЬ;
	КонецЕсли;
	
	Если ЭтаФорма.мСтруктураРасчетаИтогов = Неопределено Тогда
		ЭтаФорма.мСтруктураРасчетаИтогов = Новый Структура;
		
	КонецЕсли;
	
	// если еще нет ветки ИмяРаздела, добавим
	Если НЕ ЭтаФорма.мСтруктураРасчетаИтогов.Свойство(ИмяРаздела) Тогда
		ЭтаФорма.мСтруктураРасчетаИтогов.Вставить(ИмяРаздела, Новый Структура);
	КонецЕсли;
	
	// В ветке ИмяРаздела поищем ячейку ИмяЯчейки
	// если её еще нет, значит это первое заполнение ячейки и нужно:
	// 1. очистить ячейку - результат
	// 2. очистить данные в расшифровке.
	
	Если НЕ ЭтаФорма.мСтруктураРасчетаИтогов[ИмяРаздела].Свойство(ИмяЯчейки) Тогда
		
		// очистим ячейку
		Ячейка.Значение = 0;
		
		// добавляем ветку ИмяЯчейки
		ЭтаФорма.мСтруктураРасчетаИтогов[ИмяРаздела].Вставить(ИмяЯчейки);
		
		Возврат Истина; //это первый расчет
		
	КонецЕсли;
	
	Возврат ЛОЖЬ; //уже не первый расчет
	
КонецФункции

// ПриАктивизацииОбласти
Процедура ПриАктивизацииОбласти(ЭтаФорма, Элемент) Экспорт
	
	Если ЭтаФорма.ТекущийЭлемент <> Элемент Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.ОтображатьЯчейкуВЗаголовкеТаблицы Тогда
		ЭтаФорма.ТекстНадписиТекущейЯчейки = "   " + Элемент.ТекущаяОбласть.Имя;
	Иначе 
		ЭтаФорма.ТекстНадписиТекущейЯчейки = "";
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ПолучитьИмяТекущегоРазделаОбработка(Элементы, ТекСтраница) Экспорт
	
	Если Тип(ТекСтраница) = Тип("ГруппаФормы") Тогда
		ЭлементГруппа = ТекСтраница;
		
		// Найдем страницы для этой группы
		ЭлементСтраницы = Элементы.Найти("Страницы" + ЭлементГруппа.Имя);
		Если ЭлементСтраницы = Неопределено Тогда
			ЭлементСтраницы = Элементы.Найти("Страницы_" + ЭлементГруппа.Имя);
		КонецЕсли;
		
		Если ЭлементСтраницы = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ТекСтраница = ЭлементСтраницы.ТекущаяСтраница;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СохранитьРегламентированныйОтчетВExcel(ЭтаФорма, ИмяФайла, СохраняемыеРазделы = Неопределено, МассивРазделовПредыдущегоГода = Неопределено, ВыводитьСопоставимыеДанные = Истина, ВыводитьНезаполненныеСтроки = Истина, БезДанныхПоследнегоКвартала = Ложь, МассивРазделовАналогичногоПериодаПредыдущегоГода = Неопределено, ОтчетЗаАналогичныйПериодПрошлогоГода = Неопределено) Экспорт
	
	ПакетОтображаемыхДокументов = КонсолидированнаяОтчетность.ПолучитьРегламентированныйОтчетВПакете(ЭтаФорма.СтруктураРеквизитовФормы.мСохраненныйДок,
																									ЭтаФорма.РазделыОтчета,
																									СохраняемыеРазделы,
																									МассивРазделовПредыдущегоГода,
																									ВыводитьСопоставимыеДанные,
																									ВыводитьНезаполненныеСтроки,
																									БезДанныхПоследнегоКвартала,
																									МассивРазделовАналогичногоПериодаПредыдущегоГода,
																									ОтчетЗаАналогичныйПериодПрошлогоГода);
																									
	
	ПакетОтображаемыхДокументов.Записать(ИмяФайла, ТипФайлаПакетаОтображаемыхДокументов.XLSX); 

КонецПроцедуры // Сохранить()

Процедура ЗаполнитьПодписанта(ЭтаФорма, СтруктураДанныхКонтактногоЛица = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(ЭтаФорма.Подписант) Тогда
		
		ЭтаФорма.ТабличныйДокументОтчетТитульнаяСтраница.Области.ФИОРуководителя.Значение = "";
		ЭтаФорма.ТабличныйДокументОтчетТитульнаяСтраница.Области.ДолжностьРуководителя.Значение = "";
		ЭтаФорма.ТабличныйДокументОтчетТитульнаяСтраница.Области.ДатаФормирования.Значение = "«___» _______________ _____ г.";
		Возврат;
		
	КонецЕсли;
		
	Если СтруктураДанныхКонтактногоЛица = Неопределено Тогда
	
		СтруктураКлюча = Новый Структура;
		СтруктураКлюча.Вставить("Подразделение", ПредопределенноеЗначение("Справочник.Подразделения.ГруппаКомпаний"));
	    СтруктураКлюча.Вставить("Язык", ПредопределенноеЗначение("Справочник.Языки.Русский"));
		СтруктураКлюча.Вставить("Объект", ЭтаФорма.Объект.Организация);
		СтруктураКлюча.Вставить("КонтактноеЛицо", ЭтаФорма.Подписант);
		
		СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(СтруктураКлюча);
	
	КонецЕсли; 
	
	ЭтаФорма.ТабличныйДокументОтчетТитульнаяСтраница.Области.ДолжностьРуководителя.Значение = РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку(
	"%1 (на основании %2)", 
	СтруктураДанныхКонтактногоЛица.Должность,
	СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий);
	
	ЭтаФорма.ТабличныйДокументОтчетТитульнаяСтраница.Области.ФИОРуководителя.Значение = СтруктураДанныхКонтактногоЛица.КонтактноеЛицо;
	ЭтаФорма.ТабличныйДокументОтчетТитульнаяСтраница.Области.ДатаФормирования.Значение = Формат(ТекущаяДата(), "ДФ='«dd» ММММ yyyy ""г.""'");
	
КонецПроцедуры

Процедура ВидимостьПодписиБухгалтера(ТабличныйДокументОтчетТитульнаяСтраница, Показать)
	
	Если Показать Тогда
		ТабличныйДокументОтчетТитульнаяСтраница.Области["ПодписьБухгалтера"].ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
		ТабличныйДокументОтчетТитульнаяСтраница.Области["ПодписьБухгалтераНазваниеРеквизита"].Текст = "(подпись)";
		ТабличныйДокументОтчетТитульнаяСтраница.Области["ФИОБухгалтера"].ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
		ТабличныйДокументОтчетТитульнаяСтраница.Области["ФИОБухгалтераНазваниеРеквизита"].Текст = "(расшифровка подписи)";
	Иначе
		ТабличныйДокументОтчетТитульнаяСтраница.Области["ПодписьБухгалтера"].ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
		ТабличныйДокументОтчетТитульнаяСтраница.Области["ПодписьБухгалтераНазваниеРеквизита"].Текст = "";
		ТабличныйДокументОтчетТитульнаяСтраница.Области["ФИОБухгалтера"].ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
		ТабличныйДокументОтчетТитульнаяСтраница.Области["ФИОБухгалтераНазваниеРеквизита"].Текст = "";
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПодписантаРегламентированногоОтчета(ЭтаФорма, СтруктураДанныхКонтактногоЛицаРуководитель = Неопределено, СтруктураДанныхКонтактногоЛицаБухгалтер = Неопределено, ЭтоРСБУ = Ложь) Экспорт

	
	ОчиститьДатуФормирования = Истина;
	
	ИмяРеквизита 		= "Подписант";
	ИмяОбластиФИО 		= "ФИОРуководителя" 		+ ?(ЭтоРСБУ, "1", "");
	ИмяОбластиДолжность = "ДолжностьРуководителя" 	+ ?(ЭтоРСБУ, "1", "");   
	ИмяОбластиДата 		= "ДатаФормирования" 		+ ?(ЭтоРСБУ, "1", "");

	СтруктураДанныхКонтактногоЛица = СтруктураДанныхКонтактногоЛицаРуководитель;
	
	ТабличныеДокументыСПодписями = Новый Массив;
	ТабличныеДокументыСПодписями.Добавить(ЭтаФорма.РазделыОтчета[0].ТабличныйДокумент);  //Титульная страница всегда.
	Если ЭтаФорма.ИмяФормы = "Отчет.РегламентированныйОтчетОФинансовыхРезультатахРСБУ.Форма.ФормаОтчета_07100002_2025" Тогда
		ТабличныеДокументыСПодписями.Добавить(ЭтаФорма.РазделыОтчета[1].ТабличныйДокумент);    // расшифровка
	КонецЕсли;
	
	Для Каждого ТабличныйДокумент из ТабличныеДокументыСПодписями Цикл  
		
		Если Не ЗначениеЗаполнено(ЭтаФорма[ИмяРеквизита]) Тогда
			
			ТабличныйДокумент.Области[ИмяОбластиФИО].Значение = "";
			ТабличныйДокумент.Области[ИмяОбластиДолжность].Значение = "";
			
		Иначе 
			ОчиститьДатуФормирования = Ложь;
			
		КонецЕсли;
		
		Если СтруктураДанныхКонтактногоЛица = Неопределено Тогда
			
			СтруктураКлюча = Новый Структура;
			СтруктураКлюча.Вставить("Подразделение", ПредопределенноеЗначение("Справочник.Подразделения.ГруппаКомпаний"));
			СтруктураКлюча.Вставить("Язык", ПредопределенноеЗначение("Справочник.Языки.Русский"));
			СтруктураКлюча.Вставить("Объект", ЭтаФорма.СтруктураРеквизитовФормы.Организация);
			СтруктураКлюча.Вставить("КонтактноеЛицо", ЭтаФорма[ИмяРеквизита]);
			
			СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(СтруктураКлюча);
			СтруктураДанныхКонтактногоЛицаРуководитель = СтруктураДанныхКонтактногоЛица;
			
		КонецЕсли; 
		
		Должность = "";
		ОснованиеПолномочий = "";
		КонтактноеЛицо = "";
		
		СтруктураДанныхКонтактногоЛица.Свойство("Должность", Должность);
		СтруктураДанныхКонтактногоЛица.Свойство("ОснованиеПолномочий", ОснованиеПолномочий);
		СтруктураДанныхКонтактногоЛица.Свойство("КонтактноеЛицо", КонтактноеЛицо);
		
		ДолжностьРуководителя = Строка(Должность) + ?(ЗначениеЗаполнено(ОснованиеПолномочий), "(на основании" + ОснованиеПолномочий + ")", "");
		
		ТабличныйДокумент.Области[ИмяОбластиДолжность].Значение = ДолжностьРуководителя;
		
		ТабличныйДокумент.Области[ИмяОбластиФИО].Значение = КонтактноеЛицо;
		
		Если ОчиститьДатуФормирования Тогда
			ТабличныйДокумент.Области[ИмяОбластиДата].Значение = "«___» _______________ _____ г.";
		Иначе
			ТабличныйДокумент.Области[ИмяОбластиДата].Значение = Формат(ТекущаяДата(), "ДФ='«dd» ММММ yyyy ""г.""'");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередЗакрытиемРегламентированногоОтчета(Форма, Отказ, СтандартнаяОбработка, ЗавершениеРаботы, ТекстПредупреждения) Экспорт
				
	Если Форма.Модифицированность Тогда
		
		Отказ = Истина;
		
		Если ЗавершениеРаботы Тогда
		
			ТекстПредупреждения = НСтр("ru='Данные отчета были изменены.
											|Перед завершением работы рекомендуется записать отчет,
											|иначе измененные данные будут утеряны.'");
			
			Возврат;
		
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения("ВопросСохранитьИзмененияЗавершение", ЭтотОбъект, Форма);
		ПоказатьВопрос(Оповещение, НСтр("ru='Данные были изменены. Сохранить изменения?'"), РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВопросСохранитьИзмененияЗавершение(Ответ, Форма) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Форма", Форма);
		Оповещение = Новый ОписаниеОповещения("ПослеСохраненияФормыЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		Форма.СохранитьНаКлиенте(Оповещение);
		
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		
		Форма.Модифицированность = Ложь;
		
		Форма.Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеСохраненияФормыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ДополнительныеПараметры.Форма.Закрыть();
	
КонецПроцедуры

Процедура СформироватьЗаголовокФормы(ЭтаФорма) Экспорт
	
	НаименованиеОтчета = КонсолидированнаяОтчетность.ПолучитьСтруктуруНаименованийОтчета(ЭтаФорма.ИмяФормы).НаименованиеОтчета;
	
	Если СтрНайти(ЭтаФорма.Заголовок, НаименованиеОтчета) = 0 Тогда
		ЭтаФорма.Заголовок = НаименованиеОтчета;
	КонецЕсли; 
	
	Если СтрНайти(ЭтаФорма.Заголовок, ЭтаФорма.СтруктураРеквизитовФормы.СтрПериодОтчета) = 0 Тогда
		ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + " за " + ЭтаФорма.СтруктураРеквизитовФормы.СтрПериодОтчета;
	КонецЕсли;
	
	СчетДУСтр = " (" + ЭтаФорма.СтруктураРеквизитовФормы.НаимСчетаДоверительногоУправления + ")";
	Если СтрНайти(ЭтаФорма.Заголовок, СчетДУСтр) = 0 Тогда
		ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + СчетДУСтр;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриОткрытииФормы(ЭтаФорма) Экспорт
	
	// заглушка пока не будет отключено автоматическое сохранение подписанта в настройках формы
	Если ТипЗнч(ЭтаФорма.НастройкиОтчета) = Тип("Структура") Тогда
		ЭтаФорма.Подписант = ЭтаФорма.НастройкиОтчета.Подписант.КонтактноеЛицо;
	Иначе 
		
		// Если создается новый документ и не копированием,
		// то заполняем подписанта по умолчанию
		
		Если Не ЗначениеЗаполнено(ЭтаФорма.СтруктураРеквизитовФормы.мСохраненныйДок)
			И Не ЗначениеЗаполнено(ЭтаФорма.СтруктураРеквизитовФормы.мСкопированаФорма)
		Тогда
			РаботаСОтчетамиКлиентСервер.ЗаполнитьПодписанта(ЭтаФорма);
		КонецЕсли;
			
	КонецЕсли;
	// конец заглушки
	
	Если ЗначениеЗаполнено(ЭтаФорма.СтруктураРеквизитовФормы.мСохраненныйДок) Тогда
		ИсторияРаботыПользователя.Добавить(ЭтаФорма.СтруктураРеквизитовФормы.мСохраненныйДок);
	КонецЕсли;
	
	СформироватьЗаголовокФормы(ЭтаФорма);
	
//	ЗаполнитьПодписантаРегламентированногоОтчета(ЭтаФорма);
	
КонецПроцедуры

Процедура УстановитьДатуНачалаПрошлогоПериодаСУчетомРеформации(СтруктураРеквизитовФормы, ДатаНачалаПрошлогоПериодаСУчетомРеформации, ЭтоПоследнийКвартал = Ложь) Экспорт
	
	Если ЭтоПоследнийКвартал Тогда
		ДатаНачала = СтруктураРеквизитовФормы.мДатаНачалаПоследнегоКварталаПрошлогоПериодаОтчета;
	Иначе
		ДатаНачала = СтруктураРеквизитовФормы.мДатаНачалаПрошлогоПериодаОтчета;
	КонецЕсли;
	ДатаОкончания = СтруктураРеквизитовФормы.мДатаКонцаПрошлогоПериодаОтчета;
	
	Если ДатаНачалаПрошлогоПериодаСУчетомРеформации <= ДатаНачала Тогда
		// все хорошо, реформация была раньше, или совсем не было. 
		// дата начала не меняется
	ИначеЕсли ДатаНачалаПрошлогоПериодаСУчетомРеформации > ДатаНачала 
		И ДатаНачалаПрошлогоПериодаСУчетомРеформации <= ДатаОкончания Тогда
		// реформация произошла в период отчета. Строим отчет с даты начала реформации
		ДатаНачала = ДатаНачалаПрошлогоПериодаСУчетомРеформации;
	Иначе 	                      
		// реформация была позже. Отчет не будем стоить. 
		ДатаНачала = Неопределено;
	КонецЕсли;
	
	Если ЭтоПоследнийКвартал Тогда
		СтруктураРеквизитовФормы.ДатаНачалаПоследнегоКварталаПрошлогоПериодаОтчетаСУчетомРеформации = ДатаНачала;
	Иначе
		СтруктураРеквизитовФормы.ДатаНачалаПрошлогоПериодаОтчетаСУчетомРеформации = ДатаНачала;
	КонецЕсли;
	
КонецПроцедуры	

#КонецОбласти
