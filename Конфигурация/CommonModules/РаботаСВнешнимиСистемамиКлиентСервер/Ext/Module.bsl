Функция WordЗапуститьПриложение() Экспорт
	
	Попытка
		WordApp = Новый COMОбъект("Word.Application");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат WordApp;
	
КонецФункции

Процедура WordЗакрытьПриложение(WordApp) Экспорт
	
	WordApp.Quit();
	WordApp = Неопределено;
	
КонецПроцедуры

Процедура WordУстановитьПараметрыПриложения(WordApp, Видимость = Неопределено, СостояниеОкна = Неопределено, ЗаголовокАктивногоОкна = Неопределено, АктивироватьОкно = Неопределено) Экспорт
	
	wdWindowStateMaximize = 1;
	wdWindowStateMinimize = 2;
	
	Если ЗаголовокАктивногоОкна <> Неопределено Тогда
		WordApp.ActiveWindow.Caption = ЗаголовокАктивногоОкна;
	КонецЕсли;
	
	Если Видимость <> Неопределено Тогда
		WordApp.Visible = Видимость;
	КонецЕсли;
	
	Если СостояниеОкна <> Неопределено Тогда
		WordApp.WindowState = ?(СостояниеОкна = "Развернуто", wdWindowStateMaximize, Неопределено);
	КонецЕсли;

	Если АктивироватьОкно <> Неопределено Тогда
		
		// Используем такой финт, т.к. WordApp.Activate() и WordApp.ActiveWindow.Activate() не срабатывают		
		
		ТекущееСостояние = WordApp.WindowState;
		
		WordApp.WindowState = wdWindowStateMinimize;
		WordApp.WindowState = ТекущееСостояние;
		
	КонецЕсли;
	
КонецПроцедуры

Функция WordСоздатьДокумент(WordApp, ПутьКШаблону = Неопределено) Экспорт
	
	Если ПутьКШаблону = Неопределено Тогда
		НовыйДокумент = WordApp.Documents.Add();
	Иначе
		НовыйДокумент = WordApp.Documents.Add(ПутьКШаблону);
	КонецЕсли;
	
	Возврат НовыйДокумент;
	
КонецФункции

#КонецОбласти

#Область Сайт_Интерфакс

Функция ПолучиьСтоимостиССайтаИнтерфакс(АдресСтраницыИнтерфакс, ПолноеНаименованиеОрганизации, Период, ПредыдущийПериод = Неопределено) Экспорт

	СтоимостиИнтерфакс = Новый Структура("ПредыдущаяСЧА, ПредыдущаяСтоимостьПая, СЧА, СтоимостьПая", -1, -1, -1, -1);
	
	Если Не КорректныйАдресСтраницыИнтерфакс(АдресСтраницыИнтерфакс, ПолноеНаименованиеОрганизации) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось обнаружить данные организации " + ПолноеНаименованиеОрганизации + " на странице Интерфакс");
		Возврат СтоимостиИнтерфакс;
	КонецЕсли; 
	
	НачалоСтроки 	= СтрНайти(АдресСтраницыИнтерфакс, "//") + 2;
	КонецСтроки 	= СтрНайти(АдресСтраницыИнтерфакс, "/",, НачалоСтроки);
	АдресСервера 	= Лев(АдресСтраницыИнтерфакс, КонецСтроки);
	
	НачалоКодаКомпании = СтрНайти(АдресСтраницыИнтерфакс, "?id=", НаправлениеПоиска.СКонца) + 4;
	КодКомпании = Сред(АдресСтраницыИнтерфакс, НачалоКодаКомпании, 4);
	
	ПериодГод = Формат(?(КонецГода(Период) = КонецДня(Период), КонецДня(Период)+1, Период), "ДФ=yyyy");
	
	Скрипт = АдресСервера + "Event/Page?companyId=" + КодКомпании + "&year=" + ПериодГод;

	ДокументHTML = ПолучитьДокументHTMLПоГиперссылке(Скрипт);
	
	ЭлементыTABLE = ДокументHTML.ПолучитьЭлементыПоИмени("table");
	
	Для каждого Таблица Из ЭлементыTABLE Цикл
	
		Заголовки = Таблица.ПолучитьЭлементыПоИмени("th");
		
		Если Заголовки.Количество() > 0 И Заголовки[0].ТекстовоеСодержимое = "Дата события" Тогда
			
			ПропуститьСтрокуЗаголовка = Истина;
					
			Для каждого СтрокаТаблицы Из Таблица.ДочерниеУзлы Цикл
				
				Если ПропуститьСтрокуЗаголовка Тогда
					ПропуститьСтрокуЗаголовка = Ложь;
					Продолжить;
				ИначеЕсли ТипЗнч(СтрокаТаблицы) <> Тип("ЭлементСтрокаТаблицыHTML") Тогда
					Продолжить;
				КонецЕсли; 
				
				Колонки = СтрокаТаблицы.ПолучитьЭлементыПоИмени("td");
				
				Если Колонки[0].ТекстовоеСодержимое = Формат(Период, "ДФ=dd.MM.yyyy") 
					И СокрЛП(Колонки[2].ТекстовоеСодержимое) = "Стоимость чистых активов и расчетная стоимость инвестиционного пая" Тогда
				
					СсылкаНаСообщение = Колонки[2].ПолучитьЭлементыПоИмени("a")[0].Гиперссылка;
					Запрос = Прав(СсылкаНаСообщение, СтрДлина(СсылкаНаСообщение) - КонецСтроки + 1);
					ЗаполнитьСтоимостиИзСообщенияИнтерфакс(Сред(АдресСтраницыИнтерфакс, НачалоСтроки, КонецСтроки-НачалоСтроки), Запрос, СтоимостиИнтерфакс, Период, ПредыдущийПериод);
					
					Прервать;
					
				КонецЕсли; 
				
			КонецЦикла;
			Прервать;
			
		КонецЕсли;
			
	КонецЦикла;
	
	Возврат СтоимостиИнтерфакс;

КонецФункции

Функция ПолучитьДокументHTMLПоГиперссылке(Гиперссылка) Экспорт

	ЧтениеHTML = Новый ЧтениеHTML;
	ЧтениеHTML.ОткрытьФайл(Гиперссылка, "UTF-8");
	        
	ПостроительDOM = Новый ПостроительDOM;
	ДокументHTML = ПостроительDOM.Прочитать(ЧтениеHTML);
	        
	ЧтениеHTML.Закрыть();
	Возврат ДокументHTML;
	
КонецФункции
 
Функция КорректныйАдресСтраницыИнтерфакс(АдресСтраницыИнтерфакс, ПолноеНаименованиеОрганизации)

	ДокументHTML = ПолучитьДокументHTMLПоГиперссылке(АдресСтраницыИнтерфакс);
	
	ЭлементыTABLE = ДокументHTML.ПолучитьЭлементыПоИмени("table");
	
	Для каждого Таблица Из ЭлементыTABLE Цикл
	
		Заголовки = Таблица.ПолучитьЭлементыПоИмени("td");
		
		Если Заголовки.Количество() > 0 И Заголовки[0].ТекстовоеСодержимое = "Полное наименование компании" Тогда
			ПолноеНаименование = СокрЛП(Заголовки[1].ТекстовоеСодержимое);
			Возврат ПолноеНаименование = ПолноеНаименованиеОрганизации;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;

КонецФункции

Функция ЗаполнитьСтоимостиИзСообщенияИнтерфакс(АдресСервера, Запрос, СодержимоеСообщения, Период, ПредыдущийПериод)

	Соединение = Новый HTTPСоединение(АдресСервера);
	Ответ = Соединение.Получить(Новый HTTPЗапрос(Запрос));
	
	Если Ответ.КодСостояния = 200 Тогда
		
		ПредставлениеПериода = Формат(Период, "ДФ=dd.MM.yyyy");
		ТекстСтраницы = Ответ.ПолучитьТелоКакСтроку();
		СодержимоеСообщения.Вставить("СтоимостьПая", НайтиСтоимостьНаСтраницеИнтерфакс(ТекстСтраницы, "5. Расчетная стоимость инвестиционного пая", ПредставлениеПериода));
		СодержимоеСообщения.Вставить("СЧА", НайтиСтоимостьНаСтраницеИнтерфакс(ТекстСтраницы, "8. Стоимость чистых активов", ПредставлениеПериода));
		
		Если ПредыдущийПериод <> Неопределено Тогда
			ПредставлениеПредыдущегоПериода = Формат(ПредыдущийПериод, "ДФ=dd.MM.yyyy");
			СодержимоеСообщения.Вставить("ПредыдущаяСтоимостьПая", НайтиСтоимостьНаСтраницеИнтерфакс(ТекстСтраницы, "6. Расчетная стоимость инвестиционного пая", ПредставлениеПредыдущегоПериода));
			СодержимоеСообщения.Вставить("ПредыдущаяСЧА", НайтиСтоимостьНаСтраницеИнтерфакс(ТекстСтраницы, "9. Стоимость чистых активов", ПредставлениеПредыдущегоПериода));			
		КонецЕсли; 

	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось прочитать сообщение о стоимости чистых активов на сайте Интерфакс." + Символы.ПС + "Код состояния: " + Ответ.КодСостояния);
	КонецЕсли; 
	
	Возврат СодержимоеСообщения;

КонецФункции

Функция НайтиСтоимостьНаСтраницеИнтерфакс(ТекстСтраницы, СтрокаПоиска, ПредставлениеПериода)

	НачалоСтроки = СтрНайти(ТекстСтраницы, СтрокаПоиска);
	КонецСтроки = СтрНайти(ТекстСтраницы, "<",, НачалоСтроки);
	НачалоСуммы = СтрНайти(ТекстСтраницы, ПредставлениеПериода, , НачалоСтроки) + 11;

	Стоимость = Число(СтрЗаменить(СокрЛП(Сред(ТекстСтраницы, НачалоСуммы, КонецСтроки-НачалоСуммы)), " ", ""));
	
	Возврат Стоимость;

КонецФункции 
	
#КонецОбласти

// Помещает файл оценочной стоимости ценных бумаг, предоставленной клиентом, во временное хранилище
//
// Параметры:
//	СчетДоверительногоУправления		- СправочникСсылка.СчетаДоверительногоУправления	- счет д/у
//	Дата								- Дата												- дата оценки
//	ЕПС									- Булево											- для ЕПС (см. функцию РаботаСПереоценкой.ПолучитьПутьКФайлуОценочнойСтоимостиПредоставленнойКлиентом)
//	Адрес								- УникальныйИдентификатор, Строка					- адрес (см. функцию ПоместитьВоВременноеХранилище)
//	Отказ								- Булево											- выходной параметр, при ошибке устанавливается в значение Истина
//	СообщатьОбОшибке					- Булево											- при Истина - текст ошибки будет сообщен, при Ложь - только помещен в параметр ТекстОшибки
//	ТекстОшибки							- Строка											- выходной параметр, при ошибке заполняется текстом ошибки
//
// Возвращаемое значение:
//	Строка			- адрес файла во временном хранилище
//	Неопределено	- при ошибке 
//
Функция ПоместитьФайлОценочнойСтоимостиПредоставленнойКлиентомВоВременноеХранилище(СчетДоверительногоУправления, Дата, ЕПС = Ложь, Адрес = Неопределено, Отказ = Ложь, СообщатьОбОшибке = Истина, ТекстОшибки = Неопределено) Экспорт
	
	// Определяем путь к файлу
	
	ПутьКФайлу = РаботаСПереоценкой.ПолучитьПутьКФайлуОценочнойСтоимостиПредоставленнойКлиентом(СчетДоверительногоУправления, Дата, ЕПС);
	
	Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Отказ		= Истина;
		ТекстОшибки	= "Не задан путь к файлам оценочной стоимости ценных бумаг клиента";
		Если СообщатьОбОшибке Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	// Помещаем данные файла во временное хранилище
	
	АдресТаблицыСтоимостей = Неопределено;
	
	СвойстваФайла = Новый Файл(ПутьКФайлу);
	Если СвойстваФайла.Существует() И СвойстваФайла.ЭтоФайл() Тогда
		АдресТаблицыСтоимостей = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПутьКФайлу), Адрес);
	КонецЕсли;
	
	Если АдресТаблицыСтоимостей = Неопределено Тогда
		Отказ		= Истина;
		ТекстОшибки	= "Ошибка при загрузке стоимостей ценных бумаг из файла клиента: некорректный путь или ошибка доступа к файлу " + ПутьКФайлу;
		Если СообщатьОбОшибке Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат АдресТаблицыСтоимостей;
	
КонецФункции

#Если Клиент Тогда

// Запрашивает у пользователя файл оценочной стоимости ценных бумаг, предоставленной клиентом, и помещает во временное хранилище
//
// Параметры:
//	СчетДоверительногоУправления		- СправочникСсылка.СчетаДоверительногоУправления	- счет д/у
//	Дата								- Дата												- дата оценки
//	ЕПС									- Булево											- для ЕПС (см. функцию РаботаСПереоценкой.ПолучитьПутьКФайлуОценочнойСтоимостиПредоставленнойКлиентом)
//	Адрес								- УникальныйИдентификатор, Строка					- адрес (см. функцию ПоместитьВоВременноеХранилище)
//
// Возвращаемое значение:
//	Строка			- адрес файла во временном хранилище
//	Неопределено	- если файл не выбран 
//
Функция ВыбратьФайлОценочнойСтоимостиПредоставленнойКлиентом(СчетДоверительногоУправления, Дата, ЕПС = Ложь, Адрес = Неопределено) Экспорт

	// Определяем путь к файлу
	
	ПутьКФайлу = РаботаСПереоценкой.ПолучитьПутьКФайлуОценочнойСтоимостиПредоставленнойКлиентом(СчетДоверительногоУправления, Дата, ЕПС);
	
	Если ЗначениеЗаполнено(ПутьКФайлу) Тогда
		
		СвойстваФайла = Новый Файл(ПутьКФайлу);
		
		Если Не СвойстваФайла.Существует()
			ИЛИ Не СвойстваФайла.ЭтоФайл()
			ИЛИ Вопрос("Заполнить из файла """ + ПутьКФайлу + """?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да
		Тогда
			ПутьКФайлу = "";
		КонецЕсли;
		
	КонецЕсли; 
	
	// Если путь к файлу не задан или к нему нет доступа, запрашиваем новый путь у пользователя
	
	Если ПустаяСтрока(ПутьКФайлу) Тогда 
		
		ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		ДиалогВыбора.Фильтр = "Файлы XML (*.xml)|*.xml";

		Если Не ДиалогВыбора.Выбрать() Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ПутьКФайлу = ДиалогВыбора.ПолноеИмяФайла;
		
	КонецЕсли;
	
	АдресТаблицыСтоимостей = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПутьКФайлу), Адрес);
		
	Возврат АдресТаблицыСтоимостей;
	
КонецФункции

// Предлагает пользователю выбрать файл Excel и помещает его во временное хранилище
//
// Параметры:
//	Адрес								- УникальныйИдентификатор, Строка
//
// Возвращаемое значение:
//	Строка			- адрес файла во временном хранилище
//	Неопределено	- если файл не выбран 
//
Функция ВыбратьФайлExcelИПоместитьВоВременноеХранилище(Адрес = Неопределено) Экспорт
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Фильтр = "Таблицы EXCEL (*.xlsx)|*.xlsx|Таблицы EXCEL (*.xls)|*.xls";

	Если Не ДиалогВыбора.Выбрать() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПутьКФайлу = ДиалогВыбора.ПолноеИмяФайла;
	
	Попытка	
		АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПутьКФайлу), Адрес);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
		
	Возврат АдресВоВременномХранилище;
	
КонецФункции

#КонецЕсли