
#Область Работа_с_Excel

Функция ExcelЗапуститьПриложение() Экспорт
	Попытка
		ExcelApp = Новый COMОбъект("Excel.Application");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат ExcelApp;
КонецФункции

Процедура ExcelЗакрытьПриложение(ExcelApp) Экспорт
	ExcelApp.Quit();
	ExcelApp = Неопределено;
КонецПроцедуры

Процедура ExcelУстановитьПараметрыПриложения(ExcelApp, Видимость = Неопределено, СостояниеОкна = Неопределено, ЗаголовокАктивногоОкна = Неопределено,
	АктивироватьОкно = Неопределено, ЧисловойСтильСсылок = Ложь
) Экспорт
	xlMinimized = -4140;
	xlMaximized = -4137;
	
	Если ЗаголовокАктивногоОкна <> Неопределено Тогда
		ExcelApp.ActiveWindow.Caption = ЗаголовокАктивногоОкна;
	КонецЕсли;
	
	Если Видимость <> Неопределено Тогда
		ExcelApp.Visible = Видимость;
	КонецЕсли;
	
	Если СостояниеОкна <> Неопределено Тогда
		ExcelApp.WindowState = ?(СостояниеОкна = "Развернуто", xlMaximized, Неопределено);
	КонецЕсли;

	Если АктивироватьОкно <> Неопределено Тогда
		// Используем такой финт, т.к. ExcelApp.ActiveWindow.Activate() не срабатывает
		ТекущееСостояние = ExcelApp.WindowState;
		
		ExcelApp.WindowState = xlMinimized;
		ExcelApp.WindowState = ТекущееСостояние;
	КонецЕсли;
	
	// Для работы большинства текущий формул колонки должны обозначаться буквами ("xlA1" / 1), а не числами ("xlR1C1" / -4150)
	ExcelApp.ReferenceStyle = ?(ЧисловойСтильСсылок, -4150, 1);
КонецПроцедуры

Процедура ExcelУстановитьПараметрыИнтерактивностиПриложения(ExcelApp, ОтображатьПредупреждения = Неопределено, ВключитьСобытия = Неопределено,
	ОбновлятьЭкран = Неопределено, Интерактивность = Неопределено, АвтоматическиеВычисления = Неопределено
) Экспорт
	Если ОтображатьПредупреждения <> Неопределено Тогда
		ExcelApp.DisplayAlerts = ОтображатьПредупреждения;
	КонецЕсли;
	
	Если ВключитьСобытия <> Неопределено Тогда
		ExcelApp.EnableEvents = ВключитьСобытия;
	КонецЕсли;
	
	Если ОбновлятьЭкран <> Неопределено Тогда
		ExcelApp.ScreenUpdating = ОбновлятьЭкран;
	КонецЕсли;
	
	Если Интерактивность <> Неопределено Тогда
		ExcelApp.Interactive = Интерактивность;
	КонецЕсли;
	
	Если АвтоматическиеВычисления <> Неопределено Тогда
		xlManual = -4135;
		xlAutomatic = -4105;
		
		ExcelApp.Calculation = ?(АвтоматическиеВычисления, xlAutomatic, xlManual);
	КонецЕсли;
КонецПроцедуры

Процедура ExcelСброситьВыделение(СтраницаExcel) Экспорт
	
	СтраницаExcel.Activate();
	СтраницаExcel.Cells(1, 1).Select();
	
КонецПроцедуры

Процедура ExcelУстановитьПараметрыПечати(СтраницаExcel, АвтоМасштаб = Неопределено, Ориентация = Неопределено, ПолеСлева = Неопределено, ПолеСправа = Неопределено, ПолеСверху = Неопределено, ПолеСнизу = Неопределено) Экспорт
	
	ПараметрыПечати = Новый Структура;	
	
	Если Ориентация = ОриентацияСтраницы.Портрет Тогда
		ПараметрыПечати.Вставить("Orientation", 1); // xlPortrait = 1	
	ИначеЕсли Ориентация = ОриентацияСтраницы.Ландшафт Тогда
		ПараметрыПечати.Вставить("Orientation", 2); // xlLandscape = 2	
	КонецЕсли;
	
	Если АвтоМасштаб = Истина Тогда	
		ПараметрыПечати.Вставить("PrintArea", "");
		ПараметрыПечати.Вставить("Zoom", Ложь);
		ПараметрыПечати.Вставить("FitToPagesWide", 1);
		ПараметрыПечати.Вставить("FitToPagesTall", Ложь);
	КонецЕсли;		
	
	Если ПолеСлева <> Неопределено И ПолеСлева <> 0
		ИЛИ ПолеСправа <> Неопределено И ПолеСправа <> 0
		ИЛИ ПолеСверху <> Неопределено И ПолеСверху <> 0
		ИЛИ ПолеСнизу <> Неопределено И ПолеСнизу <> 0
	Тогда
		ExcelApp = СтраницаExcel.Application;
	КонецЕсли;
	
	Если ПолеСлева <> Неопределено Тогда
		ПараметрыПечати.Вставить("LeftMargin", ?(ПолеСлева = 0, 0, ExcelApp.CentimetersToPoints(ПолеСлева)));
	КонецЕсли;
	
	Если ПолеСправа <> Неопределено Тогда
		ПараметрыПечати.Вставить("RightMargin", ?(ПолеСправа = 0, 0, ExcelApp.CentimetersToPoints(ПолеСправа)));
	КонецЕсли;
	
	Если ПолеСверху <> Неопределено Тогда
		ПараметрыПечати.Вставить("TopMargin", ?(ПолеСверху = 0, 0, ExcelApp.CentimetersToPoints(ПолеСверху)));
	КонецЕсли;
	
	Если ПолеСнизу <> Неопределено Тогда
		ПараметрыПечати.Вставить("BottomMargin", ?(ПолеСнизу = 0, 0, ExcelApp.CentimetersToPoints(ПолеСнизу)));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыПечати) Тогда
		
		КоличествоПопыток		= 2; // попробуем применить настройки в несколько попыток, т.к. возможно требуется время, чтобы подтянулись настройки принтера
		ОжиданиеМеждуПопытками	= 5; // секунды
		
		Для НомерПопытки = 1 По КоличествоПопыток Цикл

			Попытка
				
				ЗаполнитьЗначенияСвойств(СтраницаExcel.PageSetup, ПараметрыПечати);
				Прервать;
				
			Исключение
				
				Если НомерПопытки = КоличествоПопыток Тогда
					ВызватьИсключение;
				КонецЕсли;
				
    			ЗапуститьПриложение(СтрШаблон("Timeout /T %1 /NoBreak", ОжиданиеМеждуПопытками), , Истина);
				
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ExcelКопироватьОбласть(ОбластьИсточник, ОбластьПриемник, КопироватьВсе = Истина, КопироватьФормат = Ложь, КопироватьШиринуСтолбцов = Ложь, ИспользоватьБуферОбмена = Ложь, КопироватьВсеВключаяРисунки = Ложь) Экспорт
	
	xlPasteColumnWidths	= 8;
	xlLastCell			= 11;
	xlPasteFormats		= -4122;
	
	Если ИспользоватьБуферОбмена Тогда
		
		ОбластьИсточник.Copy();
		
		Если КопироватьШиринуСтолбцов Тогда
			ОбластьПриемник.PasteSpecial(xlPasteColumnWidths);
		КонецЕсли;
		
		Если КопироватьФормат Тогда
			ОбластьПриемник.PasteSpecial(xlPasteFormats);
		КонецЕсли;
		
		Если КопироватьВсе Тогда
			Если КопироватьВсеВключаяРисунки Тогда
				ОбластьПриемник.Select();
				ОбластьПриемник.Worksheet.Paste();
			Иначе
				ОбластьПриемник.PasteSpecial();
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		Если КопироватьВсе Тогда
			ОбластьИсточник.Copy(ОбластьПриемник);		
		КонецЕсли;
		
		Если КопироватьШиринуСтолбцов Тогда
			Для н = 1 По ОбластьИсточник.SpecialCells(xlLastCell).Column Цикл
				ОбластьПриемник.Columns(н).ColumnWidth = ОбластьИсточник.Columns(н).ColumnWidth;		
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ExcelВыполнитьАвтозаполнениеОбласти(Область, ПодобластьШаблон, ТипЗаполнения = Неопределено) Экспорт

	Если ТипЗаполнения = Неопределено Тогда	
	
		ПодобластьШаблон.AutoFill(Область);
		
	Иначе
		
		Если ТипЗнч(ТипЗаполнения) = Тип("Число") Тогда
			Type = ТипЗаполнения;
		ИначеЕсли ТипЗаполнения = "ТолькоФорматы" Тогда
			Type = 3; // xlFillFormats
		ИначеЕсли ТипЗаполнения = "ТолькоЗначения" Тогда
			Type = 4; // xlFillValues
		Иначе
			Type = 0; // xlFillDefault 
		КонецЕсли;
		
		ПодобластьШаблон.AutoFill(Область, Type);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ExcelАдресОбластиСтрокой(Верх, Лево, Низ, Право) Экспорт

	Возврат ?(ТипЗнч(Лево) = Тип("Строка"), Лево, ExcelАдресСтолбцаСтрокой(Лево))
		+ Формат(Верх, "ЧН=; ЧГ=")
		+ ":"
		+ ?(ТипЗнч(Право) = Тип("Строка"), Право, ExcelАдресСтолбцаСтрокой(Право))
		+ Формат(Низ, "ЧН=; ЧГ=");

КонецФункции

Функция ExcelАдресЯчейкиСтрокой(НомерСтроки, НомерСтолбца, АбсолютнаяСтрока = Ложь, АбсолютныйСтолбец = Ложь) Экспорт

	АдресЯчейкиСтрокой = "";		
	
	Если АбсолютныйСтолбец Тогда
		АдресЯчейкиСтрокой = "$";
	КонецЕсли;
	
	АдресЯчейкиСтрокой = АдресЯчейкиСтрокой + ?(ТипЗнч(НомерСтолбца) = Тип("Строка"), НомерСтолбца, ExcelАдресСтолбцаСтрокой(НомерСтолбца));
	
	Если АбсолютнаяСтрока Тогда
		АдресЯчейкиСтрокой = АдресЯчейкиСтрокой + "$";
	КонецЕсли;
	
	АдресЯчейкиСтрокой = АдресЯчейкиСтрокой + Формат(НомерСтроки, "ЧН=; ЧГ=");
	
	Возврат АдресЯчейкиСтрокой;

КонецФункции

Функция ExcelАдресСтолбцаСтрокой(НомерСтолбца) Экспорт

	// До ZZ (702 столбца)	
	Возврат ?(НомерСтолбца > 26, Символ(64 + (НомерСтолбца - 1) / 26) + Символ(65 + (НомерСтолбца - 1) % 26), Символ(64 + НомерСтолбца));

КонецФункции

Функция ExcelВывестиОбласть(ОписаниеЛистаExcel, ОписаниеОбласти, КопироватьШиринуСтолбцов = Ложь, ИспользоватьБуферОбмена = Ложь, ВысотаОбласти = Неопределено, ВключаяРисунки = Ложь) Экспорт
	
	Если ТипЗнч(ОписаниеОбласти) = Тип("Структура") Тогда
		ОбластьИсточник	= ОписаниеОбласти.Область;
		Если ОписаниеОбласти.Высота = Неопределено Тогда
			ОписаниеОбласти.Высота = ОбластьИсточник.Rows.Count;		
		КонецЕсли;
		ВысотаОбласти = ОписаниеОбласти.Высота;
	Иначе
		ОбластьИсточник	= ОписаниеОбласти;
		Если ВысотаОбласти = Неопределено Тогда
			ВысотаОбласти = ОбластьИсточник.Rows.Count;
		КонецЕсли;
	КонецЕсли;
	
	ОбластьВставки = ОписаниеЛистаExcel.Страница.Cells(ОписаниеЛистаExcel.ВсегоСтрок + 1, 1);
		
	ExcelКопироватьОбласть(ОбластьИсточник, ОбластьВставки, Истина, Ложь, КопироватьШиринуСтолбцов, ИспользоватьБуферОбмена, ВключаяРисунки);
	
	ОписаниеЛистаExcel.ВсегоСтрок = ОписаниеЛистаExcel.ВсегоСтрок + ВысотаОбласти;	
	
	Возврат ОбластьВставки;
	
КонецФункции

Функция ExcelВставитьОбласть(ОписаниеЛистаExcel, ОписаниеОбластиИсточника, ОбластьПриемник = Неопределено, СмещениеВНиз = Истина, ФорматСПраваИСверху = Истина, ВысотаОбласти = Неопределено, ВернутьВставленнуюОбласть = Истина) Экспорт
	
	СкопироватьОбласть = (ОбластьПриемник <> Неопределено);
	
	Если ТипЗнч(ОписаниеОбластиИсточника) = Тип("Структура") Тогда
		ОбластьИсточник	= ОписаниеОбластиИсточника.Область;
	Иначе
		ОбластьИсточник	= ОписаниеОбластиИсточника;
	КонецЕсли;
	
	Если СкопироватьОбласть Тогда
		ОбластьИсточник.Copy();
	Иначе
		ОбластьПриемник = ОбластьИсточник;
	КонецЕсли;
	
	Если ВысотаОбласти = Неопределено И (СмещениеВНиз ИЛИ ВернутьВставленнуюОбласть) Тогда
		
		Если ТипЗнч(ОписаниеОбластиИсточника) = Тип("Структура") Тогда
			ВысотаОбласти = ОписаниеОбластиИсточника.Высота;
		КонецЕсли;
		
		Если ВысотаОбласти = Неопределено Тогда
			ВысотаОбласти = ОбластьИсточник.Rows.Count;
			Если ТипЗнч(ОписаниеОбластиИсточника) = Тип("Структура") Тогда
				ОписаниеОбластиИсточника.Высота = ВысотаОбласти;		
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если СмещениеВНиз Тогда
		
		Если ВернутьВставленнуюОбласть Тогда
			АдресОбластиВставки = ExcelАдресОбластиСтрокой(ОбластьПриемник.Row, "", ОбластьПриемник.Row + ВысотаОбласти - 1, "");
		КонецЕсли;
		
		ОписаниеЛистаExcel.ВсегоСтрок = ОписаниеЛистаExcel.ВсегоСтрок + ВысотаОбласти;
		
	ИначеЕсли ВернутьВставленнуюОбласть Тогда // Не тестировалось
		
		АдресОбластиВставки = ExcelАдресОбластиСтрокой(
			ОбластьПриемник.Row, ОбластьПриемник.Column, ОбластьПриемник.Row + ВысотаОбласти - 1, ОбластьПриемник.Column + ОбластьИсточник.Columns.Count - 1);
		
	КонецЕсли;	
	
	xlShiftDown					= -4121;
	xlShiftToRight				= -4161;
	xlFormatFromLeftOrAbove		= 0; 
	xlFormatFromRightOrBelow	= 1;		

	Если ФорматСПраваИСверху = Неопределено Тогда 	
		ОбластьПриемник.Insert(?(СмещениеВНиз, xlShiftDown, xlShiftToRight));
	Иначе
		ОбластьПриемник.Insert(?(СмещениеВНиз, xlShiftDown, xlShiftToRight), ?(ФорматСПраваИСверху, xlFormatFromRightOrBelow, xlFormatFromLeftOrAbove));
	КонецЕсли;

	Если СкопироватьОбласть Тогда
		ExcelОчиститьБуферОбмена(ОписаниеЛистаExcel.Страница.Application)
	КонецЕсли;
	
	Возврат ?(ВернутьВставленнуюОбласть, ОписаниеЛистаExcel.Страница.Range(АдресОбластиВставки), Истина);
	
КонецФункции	

