
#Область Работа_со_временными_таблицами

// Получает массив имен временных таблиц из менеджера временных таблиц
//
// Параметры:
//  ИсточникВременныхТаблиц									- Запрос, МенеджерВременныхТаблиц	- источник временных таблиц
//  ЗаполнятьМенеджерВременныхТаблицВЗапросеПриОтсутствии	- Булево							- если в переданном запросе менеджер временных таблиц будет пуст, то он будет заполнен
//
// Возвращаемое значение:
//  МенеджерВременныхТаблиц - менеджер временных таблиц
//
Функция МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц, ЗаполнятьМенеджерВременныхТаблицВЗапросеПриОтсутствии = Истина) Экспорт
	
	МенеджерВременныхТаблиц = Неопределено;
	
	Если ТипЗнч(ИсточникВременныхТаблиц) = Тип("Запрос") Тогда
		Если ИсточникВременныхТаблиц.МенеджерВременныхТаблиц = Неопределено И ЗаполнятьМенеджерВременныхТаблицВЗапросеПриОтсутствии Тогда
			ИсточникВременныхТаблиц.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		КонецЕсли;
		МенеджерВременныхТаблиц = ИсточникВременныхТаблиц.МенеджерВременныхТаблиц;
	ИначеЕсли ТипЗнч(ИсточникВременныхТаблиц) = Тип("МенеджерВременныхТаблиц") Тогда
		МенеджерВременныхТаблиц = ИсточникВременныхТаблиц;
	Иначе
		ВызватьИсключение СтрШаблон("Неверный тип параметра ИсточникВременныхТаблиц: %1", ТипЗнч(ИсточникВременныхТаблиц));
	КонецЕсли;	
	
	Возврат МенеджерВременныхТаблиц;
	
КонецФункции

// Получает массив имен временных таблиц из менеджера временных таблиц
//
// Параметры:
//  ИсточникВременныхТаблиц - Запрос, МенеджерВременныхТаблиц - источник временных таблиц
//
// Возвращаемое значение:
//  Массив - массив имен временных таблиц
//
Функция ПолучитьИменаВременныхТаблицЗапроса(ИсточникВременныхТаблиц) Экспорт

	МенеджерВременныхТаблиц = МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц, Ложь);
		
	МассивИмен = Новый Массив;

	Для Каждого ТаблицаВТ Из МенеджерВременныхТаблиц.Таблицы Цикл
		МассивИмен.Добавить(ТаблицаВТ.ПолноеИмя);
	КонецЦикла;
	
	Возврат МассивИмен;

КонецФункции

// Возвращает структуру временных таблиц запроса
//		
// Параметры:
//  ИсточникВременныхТаблиц	- Запрос					- запрос, из текста которого будут получены временные таблицы
//							- МенеджерВременныхТаблиц	- МВТ ранее выполненного запроса
// Возвращаемое значение:
//  Структура - Ключ - имя временной таблицы, значение - таблица значений
//
Функция ПолучитьВременныеТаблицыЗапроса(ИсточникВременныхТаблиц) Экспорт
	
	МенеджерВременныхТаблиц = МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц, Ложь); 

	Если МенеджерВременныхТаблиц = Неопределено
		И ТипЗнч(ИсточникВременныхТаблиц) = Тип("Запрос")
	Тогда
	
		#Область Выполним_запрос_чтобы_заполнить_менеджер
		
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
		НовыйЗапрос = Новый Запрос(ИсточникВременныхТаблиц.Текст);
		НовыйЗапрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Для каждого Параметр Из ИсточникВременныхТаблиц.Параметры Цикл
			НовыйЗапрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
		КонецЦикла; 
		НовыйЗапрос.Выполнить();
		
		#КонецОбласти
		
	КонецЕсли;	

	СтруктураВременныхТаблиц = Новый Структура;

	Для Каждого Вт из МенеджерВременныхТаблиц.Таблицы Цикл
		СтруктураВременныхТаблиц.Вставить(ВТ.ПолноеИмя, ВТ.ПолучитьДанные().Выгрузить());
	КонецЦикла;
	
	Возврат СтруктураВременныхТаблиц;
	
КонецФункции

// Получает данные таблицы из менеджера временных таблиц
//
// Параметры
//	ИсточникВременныхТаблиц	- Запрос, МенеджерВременныхТаблиц	- источник временных таблиц
//	ИмяВременнойТаблицы		- Строка							- имя таблицы, из которой берутся данные
//	РазличныеСтроки			- Булево							- Если Истина, в результат не будут попадать повторяющиеся строки
//	ПоляТаблицы				- Строка, Структура, Массив			- поля таблицы, заполняемые аналогично параметру Реквизиты в ОбщегоНазначения.ЗначенияРеквизитовОбъекта
//							- Неопределено						- все поля переданной таблицы
//	Отбор					- Строка, Структура, Неопределено	- строка отборов или структура (где Текст - строка отборов, Параметры - это параметры запроса), подставляемая в секцию ГДЕ запроса
//
// Возвращаемое значение:
//  РезультатЗапроса - содержимое временной таблицы
//
Функция ПолучитьДанныеВременнойТаблицыЗапроса(ИсточникВременныхТаблиц, ИмяВременнойТаблицы, РазличныеСтроки = Ложь, ПоляТаблицы = Неопределено, Отбор = Неопределено, Сортировка = Неопределено, Итоги = Неопределено, ИтоговыеФункции = Неопределено) Экспорт
	
	#Область Получаем_структуру_полей_таблицы
	
	Если ПоляТаблицы = Неопределено Тогда
		
		СтруктураПолей = Новый Структура;
		
	ИначеЕсли ТипЗнч(ПоляТаблицы) = Тип("Строка") Тогда
		
		СтруктураПолей = Новый Структура(ПоляТаблицы);
		
	ИначеЕсли ТипЗнч(ПоляТаблицы) = Тип("Структура")
		ИЛИ ТипЗнч(ПоляТаблицы) = Тип("ФиксированнаяСтруктура")
	Тогда
	
		СтруктураПолей = ПоляТаблицы;
		
	ИначеЕсли ТипЗнч(ПоляТаблицы) = Тип("Массив")
		ИЛИ ТипЗнч(ПоляТаблицы) = Тип("ФиксированныйМассив")
	Тогда
	
		СтруктураПолей = Новый Структура;
		Для Каждого Поле Из ПоляТаблицы Цикл
			СтруктураПолей.Вставить(Поле);
		КонецЦикла;
		
	Иначе
		
		ВызватьИсключение РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Неверный тип параметра ПоляТаблицы: %1'"), Строка(ТипЗнч(ПоляТаблицы)));
			
	КонецЕсли;
	
	#КонецОбласти	
	
	#Область Определяем_поля_временной_таблицы
	
	МассивПолей = Новый Массив;
	
	Для Каждого КлючИЗначение Из СтруктураПолей Цикл
		Если ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
			ИмяКолонки = СокрЛП(КлючИЗначение.Значение);
		Иначе
			ИмяКолонки = СокрЛП(КлючИЗначение.Ключ);
		КонецЕсли;
		МассивПолей.Добавить(ИмяКолонки + " КАК " + СокрЛП(КлючИЗначение.Ключ));
	КонецЦикла;	
	
	Если МассивПолей.Количество() = 0 Тогда
		МассивПолей.Добавить("*");
	КонецЕсли;
	
	#КонецОбласти	
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц, Ложь);
	
	Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ПоляТаблицы КАК ПоляТаблицы
		|ИЗ
		|	#ВременнаяТаблица# КАК ВременнаяТаблица
		|ГДЕ
		|	&Отбор";
	
	Если Сортировка <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
			|УПОРЯДОЧИТЬ ПО
			|	" + Сортировка;
	КонецЕсли;
	
	Если Итоги <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + СтрШаблон("
			|ИТОГИ 
			|	%1
			|ПО
			|	%2", ИтоговыеФункции, Итоги);
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "РАЗРЕШЕННЫЕ",					 ?(РазличныеСтроки, "РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ", "РАЗРЕШЕННЫЕ")); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ВременнаяТаблица#",			 ИмяВременнойТаблицы); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляТаблицы КАК ПоляТаблицы", СтрСоединить(МассивПолей, "," + Символы.ПС + Символы.Таб)); 
	
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		
		Для Каждого Параметр Из Отбор.Параметры Цикл
			Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Отбор", Отбор.Текст); 
		
	Иначе	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Отбор", ?(Отбор = Неопределено, "ИСТИНА", Отбор)); 
	КонецЕсли;
	
	Возврат Запрос.Выполнить();
	
КонецФункции

// Помещает таблицу в менеджер временных таблиц
//
// Параметры
//	Таблица					- ТаблицаЗначений							- таблица, данные которой надо поместить в менеджер
//							- Строка									- имя временной таблицы, являющейся источником для помещаемой таблицы
//	ИмяВременнойТаблицы		- Строка									- имя таблицы, под которым она будет создана в менеджере
//	ИсточникВременныхТаблиц	- Запрос, МенеджерВременныхТаблиц			- источник временных таблиц
//	РазличныеСтроки			- Булево									- Если Истина, в результат не будут попадать повторяющиеся строки
//	ПоляТаблицы				- Строка, Структура, Массив					- поля таблицы, заполняемые аналогично параметру Реквизиты в ОбщегоНазначения.ЗначенияРеквизитовОбъекта
//							- Неопределено								- все поля переданной таблицы
//	Отбор					- Строка, Неопределено						- строка отборов, подставляемая в секцию ГДЕ запроса
//	ПоляИндексирования		- Строка, Неопределено						- строка - имена полей таблицы, перечисленные через запятую. Подставляется в секцию ИНДЕКСИРОВАТЬ ПО запроса
//
Процедура ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(Таблица, ИмяВременнойТаблицы, ИсточникВременныхТаблиц, РазличныеСтроки = Ложь, ПоляТаблицы = Неопределено, Отбор = Неопределено, ПоляИндексирования = Неопределено) Экспорт
	
	МенеджерВременныхТаблиц = МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц);
	
	#Область Получаем_структуру_полей_таблицы
	
	ЭтоВременнаяТаблицаЗапроса = (ТипЗнч(Таблица) = Тип("Строка"));
	
	Если ПоляТаблицы = Неопределено Тогда
		
		КолонкиТаблицы = ?(ЭтоВременнаяТаблицаЗапроса, МенеджерВременныхТаблиц.Таблицы[Таблица].Колонки, Таблица.Колонки);
		
		СтруктураПолей = Новый Структура;
		Для Каждого Колонка Из КолонкиТаблицы Цикл
			СтруктураПолей.Вставить(Колонка.Имя);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ПоляТаблицы) = Тип("Строка") Тогда
		
		СтруктураПолей = Новый Структура(ПоляТаблицы);
		
	ИначеЕсли ТипЗнч(ПоляТаблицы) = Тип("Структура")
		ИЛИ ТипЗнч(ПоляТаблицы) = Тип("ФиксированнаяСтруктура")
	Тогда
	
		СтруктураПолей = ПоляТаблицы;
		
	ИначеЕсли ТипЗнч(ПоляТаблицы) = Тип("Массив")
		ИЛИ ТипЗнч(ПоляТаблицы) = Тип("ФиксированныйМассив")
	Тогда
	
		СтруктураПолей = Новый Структура;
		Для Каждого Поле Из ПоляТаблицы Цикл
			СтруктураПолей.Вставить(Поле);
		КонецЦикла;
		
	Иначе
		
		ВызватьИсключение РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Неверный тип параметра ПоляТаблицы: %1'"), Строка(ТипЗнч(ПоляТаблицы)));
			
	КонецЕсли;
	
	#КонецОбласти	
	
	#Область Определяем_поля_временной_таблицы_и_проверяем_возможность_помещения_данных_во_временную_таблицу
	
	ПрефиксОшибки = СтрШаблон("Не удалось поместить таблицу '%1' в менеджер временных таблиц", ИмяВременнойТаблицы);
	
	МассивКолонокБезТипа = Новый Массив;
	МассивПолей			 = Новый Массив;
	
	Для Каждого КлючИЗначение Из СтруктураПолей Цикл
		Если ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
			Если Не ЭтоВременнаяТаблицаЗапроса И СтрНайти(КлючИЗначение.Значение, ".") > 0 Тогда
				ВызватьИсключение ПрефиксОшибки + СтрШаблон(", содержимое объекта данных может быть выбрано только во временную таблицу: '%1'", КлючИЗначение.Значение);
			КонецЕсли;
			ИмяКолонки = СокрЛП(КлючИЗначение.Значение);
		Иначе
			ИмяКолонки = СокрЛП(КлючИЗначение.Ключ);
		КонецЕсли;
		
		Если Не (ЭтоВременнаяТаблицаЗапроса ИЛИ ЗначениеЗаполнено(Таблица.Колонки[ИмяКолонки].ТипЗначения)) Тогда
			МассивКолонокБезТипа.Добавить(ИмяКолонки);
		КонецЕсли;
		
		МассивПолей.Добавить(ИмяКолонки + " КАК " + СокрЛП(КлючИЗначение.Ключ));
	КонецЦикла;	
	
	Если МассивКолонокБезТипа.Количество() > 0 Тогда
		ВызватьИсключение ПрефиксОшибки + ", не задан тип в колонках: " + СтрСоединить(МассивКолонокБезТипа, ",");
	КонецЕсли;
	
	#КонецОбласти
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Если МенеджерВременныхТаблиц.Таблицы.Найти(ИмяВременнойТаблицы) <> Неопределено Тогда
		Запрос.Текст =  
			"УНИЧТОЖИТЬ " + ИмяВременнойТаблицы + "
			|;
			|";
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ПоляТаблицы КАК ПоляТаблицы
		|ПОМЕСТИТЬ #ТаблицаПриемник#
		|ИЗ
		|	#ТаблицаИсточник# КАК ТаблицаПриемник
		|ГДЕ
		|	&Отбор";
	
	Если ПоляИндексирования <> Неопределено Тогда
	
		Запрос.Текст = Запрос.Текст + "
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	" + ПоляИндексирования;
	
	КонецЕсли; 
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "РАЗРЕШЕННЫЕ",					 ?(РазличныеСтроки, "РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ", "РАЗРЕШЕННЫЕ")); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ТаблицаПриемник#",			 ИмяВременнойТаблицы); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляТаблицы КАК ПоляТаблицы", СтрСоединить(МассивПолей, "," + Символы.ПС + Символы.Таб)); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Отбор",						 ?(Отбор = Неопределено, "ИСТИНА", Отбор)); 
	
	Если ЭтоВременнаяТаблицаЗапроса Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ТаблицаИсточник#", Таблица); 
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ТаблицаИсточник#", "&ТаблицаЗначений"); 
		
		Запрос.УстановитьПараметр("ТаблицаЗначений", Таблица);
	КонецЕсли;
	
	Запрос.Выполнить();

КонецПроцедуры

// Удаляет таблицы из менеджера временных таблиц
//
// Параметры:
//  ИсточникВременныхТаблиц - Запрос, МенеджерВременныхТаблиц - источник временных таблиц
//  СписокТаблиц - Строка, Структура, Массив - Список удаляемых таблиц. Если список не указан, то удаляются все.
//											   В строке должен быть список имен таблиц, разделенный запятыми,
//											   в структуре - ключи, соответствующие именам таблиц,
//											   в массиве - имена таблиц
//  ИсключаяТаблицы - Строка, Структура, Массив - Список таблиц, которые необходимо исключить из удаления.
//					                              В строке должен быть список имен таблиц, разделенный запятыми,
//												  в структуре - ключи, соответствующие именам таблиц,
//												  в массиве - имена таблиц
//
Процедура УдалитьТаблицыИзМенеджераВременныхТаблиц(ИсточникВременныхТаблиц, Знач СписокТаблиц = Неопределено, Знач ИсключаяТаблицы = Неопределено) Экспорт
	
	МенеджерВременныхТаблиц = МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц, Ложь);
	
	Если ТипЗнч(СписокТаблиц) = Тип("Строка") Тогда
		СписокТаблиц = Новый Структура(СписокТаблиц);
	ИначеЕсли ТипЗнч(СписокТаблиц) = Тип("Массив") Тогда
		СписокТаблиц = Новый Структура(СтрСоединить(СписокТаблиц, ", "));	
	КонецЕсли;
	
	Если ТипЗнч(ИсключаяТаблицы) = Тип("Строка") Тогда
		ИсключаяТаблицы = Новый Структура(ИсключаяТаблицы);
	ИначеЕсли ТипЗнч(ИсключаяТаблицы) = Тип("Массив") Тогда
		ИсключаяТаблицы = Новый Структура(СтрСоединить(ИсключаяТаблицы, ", "));	
	КонецЕсли;
	
	// Получаем список таблиц на удаление

	ПодзапросыНаУдалениеТаблиц = Новый Массив;
	
	Для Каждого ТаблицаВТ Из МенеджерВременныхТаблиц.Таблицы Цикл
		
		Если СписокТаблиц <> Неопределено И Не СписокТаблиц.Свойство(ТаблицаВТ.ПолноеИмя) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ИсключаяТаблицы <> Неопределено И ИсключаяТаблицы.Свойство(ТаблицаВТ.ПолноеИмя) Тогда
			Продолжить;	
		КонецЕсли;			
		
		ПодзапросыНаУдалениеТаблиц.Добавить("УНИЧТОЖИТЬ " + ТаблицаВТ.ПолноеИмя); 
		
	КонецЦикла;
	
	// Удаляем их из менеждера временных таблиц
	
	Если ПодзапросыНаУдалениеТаблиц.Количество() > 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.Текст = СтрСоединить(ПодзапросыНаУдалениеТаблиц, ";" + Символы.ПС); 
		Запрос.Выполнить();
		
	КонецЕсли;
	
КонецПроцедуры

// Возвращает количество записей временной таблицы запроса
//
// Параметры:
//  ИсточникВременныхТаблиц	- Запрос, МенеджерВременныхТаблиц - источник временных таблиц
//	ИмяВременнойТаблицы		- Строка - имя временной таблицы
//
// Возвращаемое значение:
//  Число - количество записей
//
Функция КоличествоЗаписейВременнойТаблицы(ИсточникВременныхТаблиц, ИмяВременнойТаблицы) Экспорт
	
	МенеджерВременныхТаблиц = МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц, Ложь);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	_ВременнаяТаблица КАК _ВременнаяТаблица");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "_ВременнаяТаблица", ИмяВременнойТаблицы);
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();	
	ВыборкаЗапроса.Следующий();
	
	Возврат ВыборкаЗапроса.Количество;
	
КонецФункции

// Возвращает имена колонок содержащих строки неограниченной длины
//
// Параметры:
//  ИсточникВременныхТаблиц	- Запрос, МенеджерВременныхТаблиц - источник временных таблиц
//	ИмяВременнойТаблицы		- Строка - имя временной таблицы
//
// Возвращаемое значение:
//  Массив - содержит имена колонок содержащих строки неограниченной длины
//
Функция КолонкиНеограниченнойДлиныВременнойТаблицы(ИсточникВременныхТаблиц, ИмяТаблицы) Экспорт
	
	МенеджерВременныхТаблиц = СистемныеФункции.МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц);
	
	ВременнаяТаблица = МенеджерВременныхТаблиц.Таблицы.Найти(ИмяТаблицы);
	Если ВременнаяТаблица = Неопределено Тогда
		ВызватьИсключение РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'В менеджере временных таблиц отсутствует таблица ""%1""'"), ИмяТаблицы);
	КонецЕсли;
	
	КолонкиНеограниченнойДлины = Новый Массив;
	Для Каждого Колонка Из ВременнаяТаблица.Колонки Цикл
		Если Колонка.ТипЗначения.СодержитТип(Тип("Строка")) И Колонка.ТипЗначения.КвалификаторыСтроки.Длина = 0 Тогда
			КолонкиНеограниченнойДлины.Добавить(Колонка.Имя);
		КонецЕсли;	
	КонецЦикла;
	
	Возврат КолонкиНеограниченнойДлины;
	
КонецФункции	

// Помещает результат сравнения двух таблиц в менеджер временных таблиц
//
// Параметры
//	ИсточникВременныхТаблиц	- Запрос, МенеджерВременныхТаблиц			- источник временных таблиц
//	Таблица1				- ТаблицаЗначений							- таблица, данные которой надо поместить в менеджер
//							- Строка									- имя временной таблицы, являющейся источником для помещаемой таблицы
//	Таблица2				- ТаблицаЗначений							- таблица, данные которой надо поместить в менеджер
//							- Строка									- имя временной таблицы, являющейся источником для помещаемой таблицы
//	ИмяТаблицыРезультата	- Строка									- имя таблицы с результатом сравнения таблицы 1 и таблицы 2, под которым она будет создана в менеджере
//	Измерения				- Массив							        - массив с именами колонок являющихся измерениями таблицы 
//							- Строка									- строка с именами колонок являющихся измерениями таблицы, разделенными запятой 
//	ПрефиксРесурсовТаблицы1	- Строка									- префикс колонок не являющихся измерениями из таблицы 1 в результирующей таблице
//	ПрефиксРесурсовТаблицы2	- Строка									- префикс колонок не являющихся измерениями из таблицы 2 в результирующей таблице
//
Процедура ПоместитьРезультатСравненияТаблицЗначенийВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, Таблица1, Таблица2, ИмяТаблицыРезультата, Измерения = "", ПрефиксРесурсовТаблицы1 = "", ПрефиксРесурсовТаблицы2 = "_") Экспорт
	
#Область ПримерЗапроса
	//"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	//|	ЕСТЬNULL(Таблица1.Измерение1, Таблица2.Измерение1) КАК Измерение1,
	//|	ЕСТЬNULL(Таблица1.Измерение2, Таблица2.Измерение2) КАК Измерение2,
	//|	Таблица1.Ресурс1 КАК Ресурс1,
	//|	Таблица2.Ресурс1 КАК _Ресурс1,
	//|	Таблица1.Ресурс2 КАК Ресурс2,
	//|	Таблица2.Ресурс3 КАК _Ресурс2
	//|ПОМЕСТИТЬ ТаблицаРезультат
	//|ИЗ
	//|	Таблица1 КАК Таблица1
	//|		ПОЛНОЕ СОЕДИНЕНИЕ Таблица2 КАК Таблица2
	//|		ПО Таблица1.Измерение1 = Таблица2.Измерение1
	//|			И Таблица1.Измерение2 = Таблица2.Измерение2
	//|ГДЕ
	//|	(Таблица1.Измерение1 ЕСТЬ NULL
	//|			ИЛИ Таблица2.Измерение1 ЕСТЬ NULL
	//|			ИЛИ (Таблица1.Ресурс1 ЕСТЬ NULL) <> (Таблица2.Ресурс1 ЕСТЬ NULL)
	//|			ИЛИ ЕСТЬNULL(Таблица1.Ресурс1, 0) <> ЕСТЬNULL(Таблица2.Ресурс1, 0)
	//|			ИЛИ (Таблица1.Ресурс2 ЕСТЬ NULL) <> (Таблица2.Ресурс2 ЕСТЬ NULL)
	//|			ИЛИ ЕСТЬNULL(Таблица1.Ресурс2, 0) <> ЕСТЬNULL(Таблица2.Ресурс2, 0))";
#КонецОбласти	
	
	ИмяТаблицы1 = "Таблица1";
	Если ТипЗнч(Таблица1) = Тип("ТаблицаЗначений") Тогда
		СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(Таблица1, ИмяТаблицы1, ИсточникВременныхТаблиц);
	Иначе
		ИмяТаблицы1 = Таблица1;
	КонецЕсли;
	
	ИмяТаблицы2 = "Таблица2";
	Если ТипЗнч(Таблица2) = Тип("ТаблицаЗначений") Тогда
		СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(Таблица2, ИмяТаблицы2, ИсточникВременныхТаблиц);
	Иначе
		ИмяТаблицы2 = Таблица2;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СистемныеФункции.МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц);
	
	#Область ПолучениеИменКолонокНеограниченнойДлиныВременнойТаблицы
	КолонкиНеограниченнойДлины = КолонкиНеограниченнойДлиныВременнойТаблицы(ИсточникВременныхТаблиц, ИмяТаблицы1); 
	#КонецОбласти
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|ВЫБОР
		|	КОГДА Таблица1.ПолеСтатус ЕСТЬ НЕ NULL И Таблица2.ПолеСтатус ЕСТЬ НЕ NULL
		|		ТОГДА 3
		|	КОГДА Таблица1.ПолеСтатус ЕСТЬ НЕ NULL
		|		ТОГДА 2
		|	КОГДА Таблица2.ПолеСтатус ЕСТЬ НЕ NULL
		|		ТОГДА 1
		|	КОНЕЦ КАК Статус,
		|	&ИзмеренияВыборки КАК ИзмеренияВыборки,
		|	&РесурсыВыборки КАК РесурсыВыборки
		|ПОМЕСТИТЬ ИмяТаблицыРезультата
		|ИЗ
		|	Таблица1 КАК Таблица1
		|		ПОЛНОЕ СОЕДИНЕНИЕ Таблица2 КАК Таблица2
		|		ПО (&ИзмеренияСоединения)
		|ГДЕ
		|	(&ИзмеренияУсловия
		|			ИЛИ &РесурсыУсловия)";
	
	МассивИзмеренийВыборки	  = Новый Массив;
	МассивИзмеренийСоединения = Новый Массив;
	МассивКолонокИсключений   = Новый Массив;
	
	ИзмеренияУсловия = "";
	ПервоеИзмерение = "";
	ИзмеренияДопУсловия = "";
	
	МассивРесурсовВыборки = Новый Массив;
	МассивРесурсовУсловия = Новый Массив;
	ПервыйРесурс = "";
	
	Если ТипЗнч(Измерения) = Тип("Массив") Тогда
		МассивИзмерений = Измерения;
	Иначе
		МассивИзмерений = СтрРазделить(Измерения, ", ", Ложь);
	КонецЕсли;
	
	Для Каждого Колонка Из Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(ИмяТаблицы1).Колонки Цикл
		Если МассивИзмерений.Найти(Колонка.Имя) <> Неопределено Тогда
			МассивИзмеренийВыборки.Добавить(СтрЗаменить("ЕСТЬNULL(Таблица1.Измерение, Таблица2.Измерение) КАК Измерение", "Измерение", Колонка.Имя));
			МассивИзмеренийСоединения.Добавить(СтрЗаменить("Таблица1.Измерение = Таблица2.Измерение", "Измерение", Колонка.Имя));
			
			Если ПустаяСтрока(ПервоеИзмерение) Тогда
				ПервоеИзмерение = Колонка.Имя;
			КонецЕсли;
			
			Если ПустаяСтрока(ИзмеренияУсловия) Тогда
				ИзмеренияУсловия = СтрЗаменить("Таблица1.Измерение ЕСТЬ NULL ИЛИ Таблица2.Измерение ЕСТЬ NULL", "Измерение", Колонка.Имя);
			КонецЕсли;
			
			// При наличии колонок со строками неограниченной длины выберем в запросе одно измерение из обеих таблиц для последующего использования в условиях
			Если КолонкиНеограниченнойДлины.Количество() Тогда
				Если МассивКолонокИсключений.Количество() = 0 Тогда
					СтрокаИзмеренияПервойТаблицы = СтрЗаменить(СтрЗаменить("Таблица1.Измерение КАК Измерение1", "Измерение1", СтрШаблон("%1_%2", ИмяТаблицы1, Колонка.Имя)), "Измерение", Колонка.Имя);
					СтрокаИзмеренияВторойТаблицы = СтрЗаменить(СтрЗаменить("Таблица2.Измерение КАК Измерение2", "Измерение2", СтрШаблон("%1_%2", ИмяТаблицы2, Колонка.Имя)), "Измерение", Колонка.Имя);
					
					МассивИзмеренийВыборки.Добавить(СтрокаИзмеренияПервойТаблицы);
					МассивИзмеренийВыборки.Добавить(СтрокаИзмеренияВторойТаблицы);
					
					// При построении запроса на основании данных таблицы значений эти колонки выбирать не нужно, они добавляются только для условий
					МассивКолонокИсключений.Добавить(СтрШаблон("%1_%2", ИмяТаблицы1, Колонка.Имя));
					МассивКолонокИсключений.Добавить(СтрШаблон("%1_%2", ИмяТаблицы2, Колонка.Имя));
				КонецЕсли;
				// Строка условий запроса для загрузки данных из таблицы значений
				Если ПустаяСтрока(ИзмеренияДопУсловия) Тогда
					ИзмеренияДопУсловия = СтрШаблон("Таб.%1_%2 ЕСТЬ NULL ИЛИ Таб.%3_%4 ЕСТЬ NULL", ИмяТаблицы1, Колонка.Имя, ИмяТаблицы2, Колонка.Имя); 
				КонецЕсли;	
			КонецЕсли;	
			
		Иначе
			МассивРесурсовВыборки.Добавить(СтрШаблон(
				"	Таблица1.%1 КАК %2%1,
				|	Таблица2.%1 КАК %3%1",
			    Колонка.Имя,
				ПрефиксРесурсовТаблицы1,
				ПрефиксРесурсовТаблицы2));
				
			МассивРесурсовУсловия.Добавить(СтрЗаменить("(Таблица1.Ресурс ЕСТЬ NULL) <> (Таблица2.Ресурс ЕСТЬ NULL)", "Ресурс", Колонка.Имя));
			
			Если Не (Колонка.ТипЗначения.СодержитТип(Тип("Строка")) И Колонка.ТипЗначения.КвалификаторыСтроки.Длина = 0) Тогда // ***********************
				МассивРесурсовУсловия.Добавить(СтрЗаменить("ISNULL(Таблица1.Ресурс, 0) <> ISNULL(Таблица2.Ресурс, 0)", "Ресурс", Колонка.Имя));
			КонецЕсли;

			Если ПустаяСтрока(ПервыйРесурс) Тогда
				ПервыйРесурс = Колонка.Имя;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Если МассивИзмерений.Количество() = 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИзмеренияВыборки КАК ИзмеренияВыборки,", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИзмеренияСоединения", "ИСТИНА");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИзмеренияУсловия", "ЛОЖЬ");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПолеСтатус", ПервыйРесурс);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИзмеренияВыборки КАК ИзмеренияВыборки", СтрСоединить(МассивИзмеренийВыборки, "," + Символы.ПС + Символы.Таб));
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИзмеренияСоединения", СтрСоединить(МассивИзмеренийСоединения, Символы.ПС + Символы.Таб + Символы.Таб + Символы.Таб + "И "));
		Если КолонкиНеограниченнойДлины.Количество() Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИзмеренияУсловия", "ИСТИНА"); // При наличии колонок со строками неограниченной длины условия в первом запросе отключаем
		Иначе	
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИзмеренияУсловия", ИзмеренияУсловия);
		КонецЕсли;	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПолеСтатус", ПервоеИзмерение);
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&РесурсыВыборки КАК РесурсыВыборки", СтрСоединить(МассивРесурсовВыборки,  "," + Символы.ПС));
	
	Если КолонкиНеограниченнойДлины.Количество() Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&РесурсыУсловия", "ИСТИНА"); // При наличии колонок со строками неограниченной длины условия в первом запросе отключаем
	Иначе	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&РесурсыУсловия", СтрСоединить(МассивРесурсовУсловия, Символы.ПС + Символы.Таб + Символы.Таб + Символы.Таб + "ИЛИ "));
	КонецЕсли;	
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Таблица1", ИмяТаблицы1);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Таблица2", ИмяТаблицы2);
	
	// При наличии колонок со строками неограниченной длины запрос не будет сохранять данные во временную таблицу. Данные во временную таблицу будут загружены другим запросом.
	Если КолонкиНеограниченнойДлины.Количество() Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ ИмяТаблицыРезультата", "");
	КонецЕсли;	
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяТаблицыРезультата", ИмяТаблицыРезультата);
	
	Если КолонкиНеограниченнойДлины.Количество() Тогда
		
		// Выгрузим данные в таблицу значений, добавим колонки с результатом сравнения колонок со строками неограниченной длины
		ТаблицаДляСравнения = Запрос.Выполнить().Выгрузить();
		
		МассивПолейВыборки = Новый Массив;
		МассивУсловийГотовогоСравнения = Новый Массив;
		
		Для Каждого Колонка Из КолонкиНеограниченнойДлины Цикл
			ИмяКолонкиСравнения = СтрШаблон("Сравнение_%1", Колонка);
			ТаблицаДляСравнения.Колонки.Добавить(ИмяКолонкиСравнения, Новый ОписаниеТипов("Булево"));
			Для Каждого СтрокаТаблицы Из ТаблицаДляСравнения Цикл
				СтрокаТаблицы[ИмяКолонкиСравнения] = (СтрокаТаблицы[СтрШаблон("%1%2", ПрефиксРесурсовТаблицы1, Колонка)] = СтрокаТаблицы[СтрШаблон("%1%2", ПрефиксРесурсовТаблицы2, Колонка)]);	
			КонецЦикла;	
			МассивКолонокИсключений.Добавить(ИмяКолонкиСравнения);
			МассивУсловийГотовогоСравнения.Добавить(СтрЗаменить(" НЕ Таб.Ресурс", "Ресурс", СтрШаблон("Сравнение_%1", Колонка)));
		КонецЦикла;	
		Запрос.УстановитьПараметр("Данные", ТаблицаДляСравнения);
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&ПоляВыборки КАК ПоляВыборки
			|ПОМЕСТИТЬ ИмяТаблицыРезультата
			|ИЗ
			|	&Данные КАК Таб
			|ГДЕ
			|	(&ИзмеренияУсловия
			|			ИЛИ &РесурсыУсловия
			|           ИЛИ &УсловияГотовогоСравнения)";
		
		Для Каждого Колонка Из ТаблицаДляСравнения.Колонки Цикл
			Если МассивКолонокИсключений.Найти(Колонка.Имя) = Неопределено Тогда
				МассивПолейВыборки.Добавить(СтрЗаменить("Таб.Поле КАК Поле", "Поле", Колонка.Имя));
			КонецЕсли;	
		КонецЦикла;	
		
		Если МассивПолейВыборки.Количество() = 0 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляВыборки КАК ПоляВыборки", "");
		Иначе	
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляВыборки КАК ПоляВыборки", СтрСоединить(МассивПолейВыборки, "," + Символы.ПС + Символы.Таб));
		КонецЕсли;	
		Если МассивИзмерений.Количество() = 0 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИзмеренияУсловия", "ЛОЖЬ");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИзмеренияУсловия", ИзмеренияДопУсловия);
		КонецЕсли;
		РесурсыУсловия = СтрСоединить(МассивРесурсовУсловия, Символы.ПС + Символы.Таб + Символы.Таб + Символы.Таб + "ИЛИ ");
		РесурсыУсловия = СтрЗаменить(РесурсыУсловия, "Таблица1", "Таб");
		РесурсыУсловия = СтрЗаменить(РесурсыУсловия, "Таблица2.", "Таб._");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&РесурсыУсловия", РесурсыУсловия);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяТаблицыРезультата", ИмяТаблицыРезультата);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияГотовогоСравнения", СтрСоединить(МассивУсловийГотовогоСравнения, " ИЛИ"));
		
	КонецЕсли;
	
	Запрос.Выполнить();	
	
КонецПроцедуры

