//Возвращает дату из полученного параметра 
Функция ПолучитьДатуИзГраницы(Граница) Экспорт
	Если ТипЗнч(Граница) = Тип("Дата") Тогда
		Возврат Граница;
	ИначеЕсли ТипЗнч(Граница) = Тип("Граница") Тогда
		Если ТипЗнч(Граница.Значение) = Тип("Дата") Тогда
			Возврат Граница.Значение;
	    ИначеЕсли ТипЗнч(Граница.Значение) = Тип("МоментВремени") Тогда
			Возврат Граница.Значение.Дата;
		КонецЕсли;
	КонецЕсли;
КонецФункции
