// Проверяет наличие ссылки в информационной базе
Функция СсылкаСуществует(Ссылка) Экспорт
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ИСТИНА ИЗ " + Ссылка.Метаданные().ПолноеИмя() + " КАК Т ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция СсылочныйТип(Значение) Экспорт
	
	ТипИсходногоЗнч = ТипЗнч(Значение);
	
	Возврат Справочники.ТипВсеСсылки().СодержитТип(ТипИсходногоЗнч)
		ИЛИ Документы.ТипВсеСсылки().СодержитТип(ТипИсходногоЗнч)
		ИЛИ Перечисления.ТипВсеСсылки().СодержитТип(ТипИсходногоЗнч)
		ИЛИ ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипИсходногоЗнч)
		ИЛИ ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипИсходногоЗнч)
		ИЛИ Задачи.ТипВсеСсылки().СодержитТип(ТипИсходногоЗнч);
	
КонецФункции

Функция ПустыеСсылкиСоставногоТипа(ОписаниеТипа) Экспорт

	ПустыеСсылки		  = Новый Массив;
	ОписаниеТипаВсеСсылки = РаботаСМетаданнымиПовтИсп.ОписаниеТипаВсеСсылки();
	
	Для Каждого Тип Из ОписаниеТипа.Типы() Цикл
		Если ОписаниеТипаВсеСсылки.СодержитТип(Тип) Тогда
			ПустыеСсылки.Добавить(Новый(Тип));	
		КонецЕсли;
	КонецЦикла; 	

	Возврат ПустыеСсылки;
	
КонецФункции

// Возвращает ссылку на объект базы по навигационной ссылке
Функция ПолучитьСсылкуПоНавигационнойСсылке(НавигационнаяСсылка) Экспорт
	
    ПерваяТочка = СтрНайти(НавигационнаяСсылка, "e1cib/data/");
    ВтораяТочка = СтрНайти(НавигационнаяСсылка, "?ref=");
	
	Если ПерваяТочка = 0 ИЛИ ВтораяТочка = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
    ПредставлениеТипа	= Сред(НавигационнаяСсылка, ПерваяТочка + 11, ВтораяТочка - ПерваяТочка - 11);
    ШаблонЗначения		= ЗначениеВСтрокуВнутр(ПредопределенноеЗначение(ПредставлениеТипа + ".ПустаяСсылка"));
    ЗначениеСсылки		= СтрЗаменить(ШаблонЗначения, "00000000000000000000000000000000", Сред(НавигационнаяСсылка, ВтораяТочка + 5));
    Ссылка				= ЗначениеИзСтрокиВнутр(ЗначениеСсылки);
	
	Возврат Ссылка;	
	
КонецФункции

