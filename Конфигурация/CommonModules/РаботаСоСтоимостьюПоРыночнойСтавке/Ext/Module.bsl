		|		ИНАЧЕ _РасчетныеСреднерыночныеСтавки.СреднерыночнаяСтавка * (1 - _НастройкиАктивов.ПроцентСущественностиОтклоненияОтРыночнойСтавки / 100)
		|	КОНЕЦ КАК НижняяГраницаСреднерыночнойСтавки,
		|	ВЫБОР
		|		КОГДА _НастройкиАктивов.СхемаПроверкиСущественностиОтклонений = ЗНАЧЕНИЕ(Перечисление.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ПоКлючевойСтавке)
		|				И _НастройкиАктивов.ПроцентСущественностиВПроцентныхПунктах
		|			ТОГДА _СреднерыночныеПоКлючевойСтавке.КлючеваяСтавкаЦБРФ + _НастройкиАктивов.ПроцентСущественностиОтклоненияОтРыночнойСтавки
		|		КОГДА _НастройкиАктивов.СхемаПроверкиСущественностиОтклонений = ЗНАЧЕНИЕ(Перечисление.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ПоКлючевойСтавке)
		|			ТОГДА _СреднерыночныеПоКлючевойСтавке.КлючеваяСтавкаЦБРФ * (1 + _НастройкиАктивов.ПроцентСущественностиОтклоненияОтРыночнойСтавки / 100)
		|		КОГДА _НастройкиАктивов.СхемаПроверкиСущественностиОтклонений = ЗНАЧЕНИЕ(Перечисление.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ЦентральныйКонтрагентИлиСтавкаРыночнаяПоШкалеИндексов)
		|				И _НастройкиАктивов.ПроцентСущественностиВПроцентныхПунктах
		|			ТОГДА ЕСТЬNULL(_СделкиРЕПОДляОценкиПоШкалеИндексов.ЗначениеИндекса, 0) + _НастройкиАктивов.ПроцентСущественностиОтклоненияОтРыночнойСтавки
		|		КОГДА _НастройкиАктивов.СхемаПроверкиСущественностиОтклонений = ЗНАЧЕНИЕ(Перечисление.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ЦентральныйКонтрагентИлиСтавкаРыночнаяПоШкалеИндексов)
		|			ТОГДА ЕСТЬNULL(_СделкиРЕПОДляОценкиПоШкалеИндексов.ЗначениеИндекса, 0) * (1 + _НастройкиАктивов.ПроцентСущественностиОтклоненияОтРыночнойСтавки / 100)
		|		КОГДА _НастройкиАктивов.ВариантОтклоненияОтРыночнойСтавки = ЗНАЧЕНИЕ(Перечисление.ВариантыОтклоненияОтРыночнойСтавкиПоДепозитнымВкладам.КоэффициентВолатильностиРычнонойСтавки)
		|			ТОГДА _РасчетныеСреднерыночныеСтавки.СреднерыночнаяСтавка * (1 + _КоэффициентыВолатильностиРычнонойСтавки.Коэффициент)
		|		КОГДА _НастройкиАктивов.ПроцентСущественностиВПроцентныхПунктах
		|			ТОГДА _РасчетныеСреднерыночныеСтавки.СреднерыночнаяСтавка + _НастройкиАктивов.ПроцентСущественностиОтклоненияОтРыночнойСтавки
		|		ИНАЧЕ _РасчетныеСреднерыночныеСтавки.СреднерыночнаяСтавка * (1 + _НастройкиАктивов.ПроцентСущественностиОтклоненияОтРыночнойСтавки / 100)
		|	КОНЕЦ КАК ВерхняяГраницаСреднерыночнойСтавки,
		|	0 КАК БезрисковаяСтавкаДоходности,
		|	0 КАК Медиана,
		|	0 КАК МинимумКредитногоСпреда,
		|	0 КАК МаксимумКредитногоСпреда,
		|	_КоэффициентыВолатильностиРычнонойСтавки.Коэффициент КАК КоэффициентыВолатильностиРычнонойСтавки,
		|	_КоэффициентыВолатильностиРычнонойСтавки.МинимальнаяСредневзвешеннаяСтавка КАК МинимальнаяСредневзвешеннаяСтавка,
		|	_КоэффициентыВолатильностиРычнонойСтавки.МаксимальнаяСредневзвешеннаяСтавка КАК МаксимальнаяСредневзвешеннаяСтавка,
		|	_НастройкиАктивов.НеПоказыватьОтрицательныеПроценты КАК НеПоказыватьОтрицательныеПроценты,
		|	_НастройкиАктивов.ПериодНаблюдаемыхПроцентныхСтавок КАК ПериодНаблюдаемыхПроцентныхСтавок,
		|	_НастройкиАктивов.СмещениеСтандартногоОтклонения КАК СмещениеСтандартногоОтклонения,
		|	_УсловияАктива.СтавкаПоДоговору КАК СтавкаДляПроверкиНаРыночность,
		|	_УсловияАктива.НеУчитывать580ПИОтнестиКорректировкуНаТело КАК НеУчитывать580ПИОтнестиКорректировкуНаТело,
		|	_УсловияАктива.ДатаРазмещенияДляПримененияРыночнойСтавки КАК ДатаРазмещенияДляПримененияРыночнойСтавки,
		|	_ПериодыАктивов.ДатаПроверкиНаРыночность КАК ДатаПроверкиНаРыночность,
		|	_УсловияАктива.УчетныйАктив КАК УчетныйАктив,
		|	_НастройкиАктивов.Субъект КАК Субъект,
		|	_УсловияАктива.СделкаСЦентральнымКонтрагентом КАК СделкаСЦентральнымКонтрагентом,
		|	_НастройкиАктивов.РассчитыватьЛинейноНерыночныеАктивы КАК РассчитыватьЛинейноНерыночныеАктивы,
		|	_НастройкиАктивов.ПериодичностьОценки КАК ПериодичностьОценки,
		|	_НастройкиАктивов.ПериодичностьРасчетаКорректировкиЭСП КАК ПериодичностьРасчетаКорректировкиЭСП,
		|	_НастройкиАктивов.ИспользоватьНастройкиНаДатуРазмещенияАктива КАК ИспользоватьНастройкиНаДатуРазмещенияАктива,
		|	_НастройкиАктивов.ВариантРасчетаСрокаДляПримененияРыночнойСтавки КАК ВариантРасчетаСрокаДляПримененияРыночнойСтавки,
		|	_НастройкиАктивов.ВидСредневзвешеннойРыночнойСтавки КАК ВидСредневзвешеннойРыночнойСтавки,
		|	_НастройкиАктивов.ПроверкаНаРыночностьПоПеречнюЦБ580П КАК ПроверкаНаРыночностьПоПеречнюЦБ580П,
		|	_НастройкиАктивов.ВидКонтрагента КАК ВидКонтрагента,
		|	""Линейно"" КАК МетодРасчета,
		|	_ПериодыАктивов.ОписаниеДатыПроверкиНаРыночность КАК ОписаниеДатыПроверкиНаРыночность,
		|	_ПериодыАктивов.ОписаниеДатыКлючевойСтавки КАК ОписаниеДатыКлючевойСтавки,
		|	_НастройкиАктивов.ВариантПолученияДатыКлючевойСтавки КАК ВариантПолученияДатыКлючевойСтавки,
		|	ИСТИНА КАК СтавкаПризнанаРыночной,
		|	_УсловияАктива.СрокВозвратаДепозитаПоТребованиюКлиента КАК СрокВозвратаДепозитаПоТребованиюКлиента
		|ИЗ
		|	_Активы КАК _Активы
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НастройкиАктивов КАК _НастройкиАктивов
		|		ПО _Активы.Актив = _НастройкиАктивов.Актив
		|		ЛЕВОЕ СОЕДИНЕНИЕ _УсловияАктива КАК _УсловияАктива
		|		ПО _Активы.Актив = _УсловияАктива.Актив
		|			И (_Активы.ДатаПогашения = _УсловияАктива.ДатаПогашения
		|				ИЛИ НЕ _Активы.ЭтоДенежныйПоток)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПериодыАктивов КАК _ПериодыАктивов
		|		ПО _Активы.Актив = _ПериодыАктивов.Актив
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СреднерыночныеПоКлючевойСтавке КАК _СреднерыночныеПоКлючевойСтавке
		|		ПО _Активы.Актив = _СреднерыночныеПоКлючевойСтавке.Актив
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РасчетныеСреднерыночныеСтавки КАК _РасчетныеСреднерыночныеСтавки
		|		ПО _Активы.Актив = _РасчетныеСреднерыночныеСтавки.Актив
		|			И (_УсловияАктива.ДатаПогашения = _РасчетныеСреднерыночныеСтавки.ДатаПогашения)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КоэффициентыВолатильностиРычнонойСтавки КАК _КоэффициентыВолатильностиРычнонойСтавки
		|		ПО _Активы.Актив = _КоэффициентыВолатильностиРычнонойСтавки.Актив
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СделкиРЕПОДляОценкиПоШкалеИндексов КАК _СделкиРЕПОДляОценкиПоШкалеИндексов
		|		ПО _Активы.Актив = _СделкиРЕПОДляОценкиПоШкалеИндексов.Актив";
	
	#КонецОбласти
	
	Активы = Запрос.Выполнить().Выгрузить();
	
	Активы.Колонки.Добавить("АдресРасшифровкиВариантаОтклоненияОтРыночнойСтавки", 	Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(150))); 
	Активы.Колонки.Добавить("АдресРасшифровкиРасчетПоМетодикеКлиента",				Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(150))); 
	Активы.Колонки.Добавить("АдресРасшифровкиКБД_MosPrime", 						Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(150))); 
	Активы.Колонки.Добавить("АдресРасшифровкиДенежныхПотоков", 						Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(150))); 
	
	Активы.Колонки.Добавить("СуммаРезерва",		Новый ОписаниеТипов("Число"));	// Колонка для хранения резерва под обесценение 
	Активы.Колонки.Добавить("ЕстьОбесценение",	Новый ОписаниеТипов("Булево")); // Колонка для проверки, применяется ли обесценение для актива 
	
	НастройкиУчета								= БухгалтерскийУчет.ОпределитьНастройкиУчета(Период, Организация, СчетДоверительногоУправления);
	ВидыАктивовСОтдельнымиСтавкамиНаКаждыйПоток	= ПолучитьВидыАктивовСОтдельнымиСтавкамиНаКаждыйПоток(СчетДоверительногоУправления, Период);	
	
	#Область Обход_активов	
	
	Для Каждого СтрокаАктивы Из Активы Цикл
		
		Если ТипЗнч(СтрокаАктивы.Актив) = Тип("СправочникСсылка.ДепозитныеВклады") 
		   И НЕ ЗначениеЗаполнено(СтрокаАктивы.УчетныйАктив) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В условиях депозитного вклада " + СтрокаАктивы.Актив + " не указан учетный актив",,,, Отказ);
			Продолжить;
		КонецЕсли;
		
		Если НЕ ПроверитьВозможностьИспользованияСхемыПроверкиСущественностиОтклонений(СтрокаАктивы, Период, Отказ) Тогда
			Продолжить;			
		КонецЕсли;
		
		Если ТипЗнч(СтрокаАктивы.ВидСредневзвешеннойРыночнойСтавки) = Тип("СправочникСсылка.БиржевыеИндексы") 
		   И НЕ ЗначениеЗаполнено(СтрокаАктивы.СреднерыночнаяСтавка)
		   И НЕ СтрокаАктивы.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.РасчетПоМетодикеКлиента Тогда 
			Если СтрокаАктивы.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ЦентральныйКонтрагентИлиСтавкаРыночная
				И СтрокаАктивы.СделкаСЦентральнымКонтрагентом
				И СтрокаАктивы.СрокАктиваДляПримененияРыночнойСтавки < СтрокаАктивы.МаксимальныйСрокДоПогашенияДляПримененияЛинейногоРасчета Тогда
				//Индекс не нужен
			Иначе
				ТекстСообщения = СтрШаблон("Невозможно проверить на рыночность %1 Нет значения индекса %2 за %3",
					СтрокаАктивы.Актив,
					СтрокаАктивы.ВидСредневзвешеннойРыночнойСтавки,
					Формат(СтрокаАктивы.ДатаРазмещенияДляОтбораРыночнойСтавки, "ДФ=dd.MM.yyyy"));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаАктивы.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.РасчетПоМетодикеКлиента Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаАктивы.ВидСредневзвешеннойРыночнойСтавки) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В настройках проверки на рыночность для актива %1 не указан 'Вид средневзвешенной рыночной ставки'", СтрокаАктивы.Актив),,,, Отказ);
				Продолжить;
			КонецЕсли;
			
			РассчитатьГраницыРыночностиПоМетодикеКлиента(СтрокаАктивы, СтрокаАктивы.ДатаПроверкиНаРыночность, СчетДоверительногоУправления, Клиент, ЦельРасчета, Отказ, ЭтоРасшифровка);
		КонецЕсли;
				
		НулеваяРыночнаяСтоимостьАктива 	= Новый Структура("Стоимость, Обесценение", 0, 0);		
		РасчетнаяСтоимостьАктива 		= НулеваяРыночнаяСтоимостьАктива;
		
		Если СтрокаАктивы.ВариантОтклоненияОтРыночнойСтавки = Перечисления.ВариантыОтклоненияОтРыночнойСтавкиПоДепозитнымВкладам.КриваяБезрисковойДоходности Тогда
			//Требуется расчёт КБД, Фиксированное отклонение и коэффициент волатильности учтены в запросы.
			ПараметрыОценки = Новый Структура("Клиент, СчетДоверительногоУправления, ВариантРасчетаСправедливойСтоимости", Клиент, СчетДоверительногоУправления, НастройкиОценки.ВариантРасчетаОценочнойСтоимости);
			
			РассчитатьБезрисковуюСтавкуДоходностиПоДепозиту(
				СтрокаАктивы, 
				?(Справочники.ПериодичностиОпределенияРыночнойСтавки.ПроверкаТолькоПриПервоначальномПризнании(СтрокаАктивы.ПериодичностьОпределенияРыночнойСтавки), 
					СтрокаАктивы.ДатаПроверкиНаРыночность,
					Период), 
				СчетДоверительногоУправления, 
				ПараметрыОценки);
			
		ИначеЕсли СтрокаАктивы.ВариантОтклоненияОтРыночнойСтавки = Перечисления.ВариантыОтклоненияОтРыночнойСтавкиПоДепозитнымВкладам.СтандартноеОтклонениеПоГенеральнойСовокупности Тогда
			СреднерыночныеСтавки = Запрос.МенеджерВременныхТаблиц.Таблицы["_РасчетныеСреднерыночныеСтавкиЗаПериод"].ПолучитьДанные().Выгрузить();
			РассчитатьСтандартноеОтклонениеПоГенеральнойСовокупности(
				СтрокаАктивы,
				СреднерыночныеСтавки, 
				СтрокаАктивы.ПериодНаблюдаемыхПроцентныхСтавок, 
				СтрокаАктивы.СмещениеСтандартногоОтклонения, 
				СтрокаАктивы.ВидСредневзвешеннойРыночнойСтавки, 
				Отказ);
			
			Если ЭтоРасшифровка Тогда
				СтрокаАктивы.АдресРасшифровкиВариантаОтклоненияОтРыночнойСтавки = ПоместитьВоВременноеХранилище(СреднерыночныеСтавки);
			КонецЕсли;
			
		ИначеЕсли СтрокаАктивы.ВариантОтклоненияОтРыночнойСтавки = Перечисления.ВариантыОтклоненияОтРыночнойСтавкиПоДепозитнымВкладам.КоэффициентВолатильностиРычнонойСтавки Тогда
			Если ЭтоРасшифровка Тогда
				СтрокаАктивы.АдресРасшифровкиВариантаОтклоненияОтРыночнойСтавки = ПоместитьВоВременноеХранилище(Запрос.МенеджерВременныхТаблиц.Таблицы["_РасчетныеСреднерыночныеСтавкиЗаПериод"].ПолучитьДанные().Выгрузить());
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрокаАктивы.ТочностьГраницДиапазонаРыночнойСтавки > 0 Тогда
			СтрокаАктивы.НижняяГраницаСреднерыночнойСтавки	= ОКР(СтрокаАктивы.НижняяГраницаСреднерыночнойСтавки, СтрокаАктивы.ТочностьГраницДиапазонаРыночнойСтавки);
			СтрокаАктивы.ВерхняяГраницаСреднерыночнойСтавки	= ОКР(СтрокаАктивы.ВерхняяГраницаСреднерыночнойСтавки, СтрокаАктивы.ТочностьГраницДиапазонаРыночнойСтавки);
		КонецЕсли;
		
		Если ТипЗнч(СтрокаАктивы.Актив) = Тип("СправочникСсылка.ДепозитныеВклады") И СтрокаАктивы.ДоВостребования Тогда
			//Депозиты до востребования считаются линейно
			
		ИначеЕсли СтрокаАктивы.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.НеПроверять Тогда
			Если  СтрокаАктивы.МаксимальныйСрокАктиваДляИспользованияСхемы = 0
				ИЛИ СтрокаАктивы.МаксимальныйСрокАктиваДляИспользованияСхемы >= СтрокаАктивы.СрокАктиваДляПримененияРыночнойСтавки Тогда
				//Не проверяем
			Иначе
				ТекстСообщения = СтрШаблон("Срок (%1 дней) актива %2 превышает максимальный срок (%3 дней) для расчёта актива без проверки на рыночность",
					СтрокаАктивы.СрокАктиваДляПримененияРыночнойСтавки,
					СтрокаАктивы.Актив,
					СтрокаАктивы.МаксимальныйСрокАктиваДляИспользованияСхемы);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
			КонецЕсли;
			
		// #511334 Хардкод для ДК Регион - никому больше такое не нужно, поэтому даже в настройки не выносим	
		ИначеЕсли СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_15/DSK") Или СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_13/DSK") Тогда
			
			Если (СтрокаАктивы.СрокВозвратаДепозитаПоТребованиюКлиента > 0 И СтрокаАктивы.СрокВозвратаДепозитаПоТребованиюКлиента <= 5) Тогда 
				
				Если ЗначениеЗаполнено(СтрокаАктивы.ПроцентнаяСтавкаПриДосрочномЗакрытии) Тогда
					
					РасчетнаяСтоимостьАктива.Стоимость = РасчетнаяСтоимостьАктива.Стоимость + РасчетнаяСтоимостьАктива.Стоимость * СтрокаАктивы.ПроцентнаяСтавкаПриДосрочномЗакрытии * ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(Период, СтрокаАктивы.ДатаРегистрации) / 365;	
					
				КонецЕсли;	
				
				СтрокаАктивы.СтавкаПризнанаРыночной = Истина;																			
				
			Иначе
				
				Если ТипЗнч(СтрокаАктивы.Актив) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
					ДатаПервоначальногоПризнания = КонецДня(СтрокаАктивы.ДатаРегистрации);
					
					СтрокаАктивы.БезрисковаяСтавкаДоходности = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьНоминальнуюБезрисковуюСтавкуДоходности(СтрокаАктивы.Актив, КонецДня(Период), , Ложь);
					
					ЭСПДепозита = ПолучитьСтавкуЭСПАктива(СтрокаАктивы, ДатаПервоначальногоПризнания, СтрокаАктивы.ТочностьЭСП);
					
					БезрисковаяСтавкаДоходностиНаДатуПервоначальногоПризнания = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьНоминальнуюБезрисковуюСтавкуДоходности(СтрокаАктивы.Актив, ДатаПервоначальногоПризнания, , Ложь);
					
					СтрокаАктивы.ПроцентПоАктиву	= СтрокаАктивы.БезрисковаяСтавкаДоходности + (ЭСПДепозита - БезрисковаяСтавкаДоходностиНаДатуПервоначальногоПризнания);	
				КонецЕсли;
				
				РасчетнаяСтоимостьАктива = РассчитатьСтоимостьАктиваПоСтавке(СтрокаАктивы.ПроцентПоАктиву, 
																			Период, 
																			СтрокаАктивы, 
																			Неопределено, 
																			Ложь, 
																			СтрокаАктивы.ТочностьЭСП, 
																			НастройкиУчета.РазрядностьОкругленияПромежуточныхРасчетовДепозитныхВкладов, 
																			Организация, 
																			СчетДоверительногоУправления, 
																			ВидыАктивовСОтдельнымиСтавкамиНаКаждыйПоток, 
																			ЦельРасчета,
																			Отказ);
																			
				СтрокаАктивы.СтавкаПризнанаРыночной = Истина;																			
																			
			КонецЕсли;
			
		ИначеЕсли СтрокаАктивы.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ЦентральныйКонтрагент Тогда
			
			Если НЕ СтрокаАктивы.СделкаСЦентральнымКонтрагентом Тогда
				//Схема Репо с ЦК выбирается, если в методике у фонда написано, что для сделок не с ЦК нужно обратиться за методикой оценки к фонду
				//Нужно уточнить у фонда методику расчёта и выбрать схему РЕПО с ЦК или ставка рыночная
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Сделка (депозит) без ЦК не может быть оценена по схеме '%1', необходимо запросить у клиента методику оценки", СтрокаАктивы.СхемаПроверкиСущественностиОтклонений),,,, Отказ);
				Продолжить;
			КонецЕсли;
			
			Если СтрокаАктивы.СрокАктиваДляПримененияРыночнойСтавки < СтрокаАктивы.МаксимальныйСрокДоПогашенияДляПримененияЛинейногоРасчета Тогда
				//Репо с ЦК до этого срока считаются линейно	
			Иначе
				//Репо с ЦК после этого срока считаются по фактической ЭСП	
				РасчетнаяСтоимостьАктива = РассчитатьСтоимостьАктиваПоСтавке(СтрокаАктивы.ПроцентПоАктиву, 
																			Период, 
																			СтрокаАктивы, 
																			СтрокаАктивы.УчетныйАктив, 
																			Истина, 
																			СтрокаАктивы.ТочностьЭСПНаДатуРасчета, 
																			НастройкиУчета.РазрядностьОкругленияПромежуточныхРасчетовДепозитныхВкладов, 
																			Организация, 
																			СчетДоверительногоУправления, 
																			ВидыАктивовСОтдельнымиСтавкамиНаКаждыйПоток, 
																			ЦельРасчета,
																			Отказ);
				
			КонецЕсли;
			
		ИначеЕсли (СтрокаАктивы.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ЦентральныйКонтрагентИлиСтавкаРыночная
					ИЛИ СтрокаАктивы.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ЦентральныйКонтрагентИлиСтавкаРыночнаяПоШкалеИндексов)
				И СтрокаАктивы.СделкаСЦентральнымКонтрагентом
				И СтрокаАктивы.СрокАктиваДляПримененияРыночнойСтавки < СтрокаАктивы.МаксимальныйСрокДоПогашенияДляПримененияЛинейногоРасчета Тогда
			//Репо с ЦК в рынке, считаются линейно
			
		ИначеЕсли СтрокаАктивы.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ПересчитатьПоРыночнойСтавке Тогда
			
			Если СтрокаАктивы.СрокАктиваДляПримененияРыночнойСтавки < СтрокаАктивы.МинимальныйСрокДоПогашенияДляПримененияРыночнойСтавки И НЕ СтрокаАктивы.ЭтоДенежныйПоток Тогда
				//Не пересчитываем
			Иначе
				РасчетнаяСтоимостьАктива = РассчитатьСтоимостьАктиваПоСтавке(СтрокаАктивы.СреднерыночнаяСтавка, 
																			Период, 
																			СтрокаАктивы, 
																			СтрокаАктивы.УчетныйАктив, 
																			Ложь, 
																			СтрокаАктивы.ТочностьРыночнойСтавки, 
																			НастройкиУчета.РазрядностьОкругленияПромежуточныхРасчетовДепозитныхВкладов, 
																			Организация, 
																			СчетДоверительногоУправления, 
																			ВидыАктивовСОтдельнымиСтавкамиНаКаждыйПоток, 
																			ЦельРасчета,
																			Отказ);
			КонецЕсли;
			
		ИначеЕсли СтрокаАктивы.ПройденаПроверкаНаРыночностьПоПеречнюЦБ580П И НЕ СтрокаАктивы.НеУчитывать580ПИОтнестиКорректировкуНаТело  Тогда
			Если СтрокаАктивы.СрокАктиваДляПримененияРыночнойСтавки < СтрокаАктивы.МаксимальныйСрокДоПогашенияДляПримененияЛинейногоРасчета Тогда
				//Ставка в рынке считаем линейно
			ИначеЕсли СтрокаАктивы.УчетныйАктив <> Справочники.УчетныеАктивыЕПС.ДепозитныеВкладыПоСС Тогда
				РасчетнаяСтоимостьАктива = РассчитатьСтоимостьАктиваПоСтавке(СтрокаАктивы.ПроцентПоАктиву, 
																			Период, 
																			СтрокаАктивы, 
																			Неопределено, 
																			СтрокаАктивы.ВидСтавкиДляРасчетаДисконтированногоПотокаНаДатуРасчета = Перечисления.ВидыПроцентныхСтавокДляРасчетаСтоимостиДепозитныхВкладов.ЭСП, 
																			СтрокаАктивы.ТочностьЭСПНаДатуРасчета, 
																			НастройкиУчета.РазрядностьОкругленияПромежуточныхРасчетовДепозитныхВкладов, 
																			Организация, 
																			СчетДоверительногоУправления, 
																			ВидыАктивовСОтдельнымиСтавкамиНаКаждыйПоток, 
																			ЦельРасчета,
																			Отказ);
			КонецЕсли;
			
		ИначеЕсли СтрокаАктивы.СрокАктиваДляПримененияРыночнойСтавки < СтрокаАктивы.МинимальныйСрокДоПогашенияДляПримененияРыночнойСтавки Тогда
			//Депозиты считаются линейно
			
		ИначеЕсли СтрокаАктивы.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ЛинейноИПоФактическойЭСП
		   И СтрокаАктивы.СрокАктиваДляПримененияРыночнойСтавки <= СтрокаАктивы.МаксимальныйСрокДоПогашенияДляПримененияЛинейногоРасчета Тогда
			//Линейно
			
		ИначеЕсли СтрокаАктивы.СхемаПроверкиСущественностиОтклонений <> Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.РасчетПоМетодикеКлиента
			И (СтрокаАктивы.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ЛинейноИПоФактическойЭСП
				ИЛИ СтрокаАктивы.СрокАктиваДляПримененияРыночнойСтавки > СтрокаАктивы.МаксимальныйСрокДоПогашенияДляПримененияРыночнойСтавки) Тогда
			//Депозит больше срока проверки на рыночность, считаем по ЭСП
			РасчетнаяСтоимостьАктива = РассчитатьСтоимостьАктиваПоСтавке(СтрокаАктивы.ПроцентПоАктиву, 
																		Период, 
																		СтрокаАктивы, 
																		Неопределено, 
																		СтрокаАктивы.ВидСтавкиДляРасчетаДисконтированногоПотокаНаДатуРасчета = Перечисления.ВидыПроцентныхСтавокДляРасчетаСтоимостиДепозитныхВкладов.ЭСП, 
																		СтрокаАктивы.ТочностьЭСПНаДатуРасчета, 
																		НастройкиУчета.РазрядностьОкругленияПромежуточныхРасчетовДепозитныхВкладов, 
																		Организация, 
																		СчетДоверительногоУправления, 
																		ВидыАктивовСОтдельнымиСтавкамиНаКаждыйПоток, 
																		ЦельРасчета,
																		Отказ);
																		
		ИначеЕсли СтрокаАктивы.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.КБДИMosPrime1День Тогда
			
			Если СтрокаАктивы.ВидАктива = Перечисления.ВидыАктивовДляПроверкиНаРыночность.ОбратноеРЕПО И СтрокаАктивы.Актив.МестоХранения <> Справочники.МестаХранения.ВнебиржевойРынок	Тогда
				//биржу не дисконтируем
				СтрокаАктивы.СтавкаПризнанаРыночной = Истина;
			Иначе
				РассчитатьСтавкуКБД_MosPrime(СтрокаАктивы, Период, СчетДоверительногоУправления, Клиент, ЦельРасчета, Отказ, ЭтоРасшифровка);
				
				РасчетнаяСтоимостьАктива = РассчитатьСтоимостьАктиваПоСтавке(СтрокаАктивы.ПроцентПоАктиву, 
																			Период, 
																			СтрокаАктивы, 
																			Неопределено, 
																			Ложь, 
																			СтрокаАктивы.ТочностьЭСП, 
																			НастройкиУчета.РазрядностьОкругленияПромежуточныхРасчетовДепозитныхВкладов, 
																			Организация, 
																			СчетДоверительногоУправления, 
																			ВидыАктивовСОтдельнымиСтавкамиНаКаждыйПоток, 
																			ЦельРасчета,
																			Отказ);
				СтрокаАктивы.СтавкаПризнанаРыночной = (РасчетнаяСтоимостьАктива.Стоимость = 0);																			
			КонецЕсли;
			
		ИначеЕсли СтрокаАктивы.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ОтклонениеСтоимостиПоЭСППоРыночнойСтавке Тогда
			
			РыночнаяСтавка = ПолучитьСтавкуЭСПАктива(СтрокаАктивы, Период, СтрокаАктивы.ТочностьЭСП);
			
			СтрокаАктивы.СтавкаДляПроверкиНаРыночность = РыночнаяСтавка;
			
			Если (СтрокаАктивы.НижняяГраницаСреднерыночнойСтавки > РыночнаяСтавка ИЛИ СтрокаАктивы.ВерхняяГраницаСреднерыночнойСтавки < РыночнаяСтавка)
				И СтрокаАктивы.ИспользованиеРыночнойСтавкиБезУчетаПроцентаСущественностиОтклонения Тогда
				РыночнаяСтавка = СтрокаАктивы.СреднерыночнаяСтавка;
				
			ИначеЕсли СтрокаАктивы.НижняяГраницаСреднерыночнойСтавки > РыночнаяСтавка Тогда
				РыночнаяСтавка = СтрокаАктивы.НижняяГраницаСреднерыночнойСтавки;
				
			ИначеЕсли СтрокаАктивы.ВерхняяГраницаСреднерыночнойСтавки < РыночнаяСтавка Тогда
				РыночнаяСтавка = СтрокаАктивы.ВерхняяГраницаСреднерыночнойСтавки;
				
			ИначеЕсли СтрокаАктивы.ВидСтавкиДляРасчетаДисконтированногоПотока <> Перечисления.ВидыПроцентныхСтавокДляРасчетаСтоимостиДепозитныхВкладов.ЭСП Тогда
				РыночнаяСтавка = СтрокаАктивы.СтавкаПоДоговору;
				
			КонецЕсли;
			
			РасчетнаяСтоимостьАктива = РассчитатьСтоимостьАктиваПоСтавке(РыночнаяСтавка, 
																		СтрокаАктивы.ДатаПроверкиНаРыночность, 
																		СтрокаАктивы, 
																		Неопределено, 
																		Ложь, 
																		СтрокаАктивы.ТочностьЭСП, 
																		НастройкиУчета.РазрядностьОкругленияПромежуточныхРасчетовДепозитныхВкладов, 
																		Организация, 
																		СчетДоверительногоУправления, 
																		ВидыАктивовСОтдельнымиСтавкамиНаКаждыйПоток, 
																		ЦельРасчета,
																		Отказ);
			
			СтрокаАктивы.ПроцентПоАктиву = РыночнаяСтавка;
			
			Если Справочники.ПериодичностиОпределенияРыночнойСтавки.ПроверкаТолькоПриПервоначальномПризнании(СтрокаАктивы.ПериодичностьОпределенияРыночнойСтавки)
				И СтрокаАктивы.Номинал * (1 - СтрокаАктивы.ПроцентСущественностиОтклоненияОтСтоимостиПоЭСП/100) <= РасчетнаяСтоимостьАктива.Стоимость 
				И СтрокаАктивы.Номинал * (1 + СтрокаАктивы.ПроцентСущественностиОтклоненияОтСтоимостиПоЭСП/100) >= РасчетнаяСтоимостьАктива.Стоимость Тогда
				
				РасчетнаяСтоимостьАктива = НулеваяРыночнаяСтоимостьАктива; //Отклонение линейной стоимости и стоимости ЭСП по рыночной ставке несущественно, считаем линейно

			ИначеЕсли (СтрокаАктивы.Номинал + СтрокаАктивы.Проценты) * (1 - СтрокаАктивы.ПроцентСущественностиОтклоненияОтСтоимостиПоЭСП/100) <= РасчетнаяСтоимостьАктива.Стоимость 
					И (СтрокаАктивы.Номинал + СтрокаАктивы.Проценты) * (1 + СтрокаАктивы.ПроцентСущественностиОтклоненияОтСтоимостиПоЭСП/100) >= РасчетнаяСтоимостьАктива.Стоимость Тогда
					
