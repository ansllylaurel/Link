		Запрос.УстановитьПараметр("Организация", Продажа_РПИ_160522_132387.Организация);
		Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(Период), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("ПериодДата", Период);
		Запрос.УстановитьПараметр("Сделка", Продажа_РПИ_160522_132387);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", Продажа_РПИ_160522_132387.СчетДоверительногоУправления);
				
		СтавкаПроцента = 9;
		
		ВключаяДатуНачала = Ложь;
		//#695772 Харкод, эхо #386115 и #468527. Ранее хардкодом дата окончания смещалась на день вперёд, потому что выпадала на выходной. C 14.11.2025 новая дата окончания - рабочий день. Но на текущую дату должны включать дату окончания
		ВключаяДатуОкончания = Период < Дата(2025, 11, 14) Или Не ДоПогашения;
		
	КонецЕсли;
		
	Если Не ПустаяСтрока(Запрос.Текст) Тогда
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			СтрокаПотока = ТаблицаРезультат.Добавить();
			СтрокаПотока.ВидЗадолженности 		= ВыборкаДетальныеЗаписи.ВидЗадолженности;
			СтрокаПотока.ТипЗадолженности 		= Перечисления.ТипыЗадолженности.Дебиторская;
			СтрокаПотока.ОснованиеЗадолженности = ВыборкаДетальныеЗаписи.ОснованиеЗадолженности;
			СтрокаПотока.ДатаРегистрации 		= НачалоДня(ВыборкаДетальныеЗаписи.ДатаРегистрации);
			СтрокаПотока.Валюта 				= ВыборкаДетальныеЗаписи.Валюта;
			СтрокаПотока.Сумма 					= ВыборкаДетальныеЗаписи.СуммаОстаток;
			СтрокаПотока.Период 				= ?(ДоПогашения, ВыборкаДетальныеЗаписи.ДатаОплатыПлановая, Период);
			
			//доначислим проценты
			Дни = РаботаСКредитнымиИнструментами.РасчетВисокосныхИОбычныхДней(
						ВыборкаДетальныеЗаписи.ДатаОплатыАванса + ?(ВключаяДатуНачала, 0, 86400), 
						СтрокаПотока.Период + ?(ВключаяДатуОкончания, 86400, 0), Ложь);
			
			СтрокаПотока.Проценты = СтрокаПотока.Сумма * СтавкаПроцента / 100 * (Дни["Дней365"] / 365 + Дни["Дней366"] / 366);
			
		КонецЦикла;
		
		ТаблицаРезультат.Свернуть("ОснованиеЗадолженности,ВидЗадолженности,ТипЗадолженности,ДатаРегистрации,Валюта,Период", "Сумма,Проценты");
		
		Для Каждого СтрокаПотока из ТаблицаРезультат Цикл
			СтрокаПотока.Проценты = Окр(СтрокаПотока.Проценты, 2);
		КонецЦикла;
			
	КонецЕсли;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

#КонецОбласти
