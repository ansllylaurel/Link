					// Проверяем ставку при первоначальном признании
					Если СтрокаАктивы.НижняяГраницаСреднерыночнойСтавки <= СтрокаАктивы.СтавкаПоДоговору 
						И СтрокаАктивы.СтавкаПоДоговору <= СтрокаАктивы.ВерхняяГраницаСреднерыночнойСтавки Тогда
						
						РыночнаяСтавка						= СтрокаАктивы.СтавкаПоДоговору; 
						СтрокаАктивы.СтавкаПризнанаРыночной	= Истина;
						РасчетнаяСтоимостьАктива			= НулеваяРыночнаяСтоимостьАктива;
						
					Иначе	
										
						РыночнаяСтавка = ПолучитьСтавкуЭСПАктива(СтрокаАктивы, СтрокаАктивы.ДатаПроверкиНаРыночность, СтрокаАктивы.ТочностьЭСП);  
																
					КонецЕсли;	
					
				Иначе
					РыночнаяСтавка = ПолучитьСтавкуЭСПАктива(СтрокаАктивы, Период, СтрокаАктивы.ТочностьЭСПНаДатуРасчета);
				КонецЕсли;
				
				СтрокаАктивы.СтавкаДляПроверкиНаРыночность = РыночнаяСтавка;
				
				Если Не СтрокаАктивы.СтавкаПризнанаРыночной Тогда
					
					Если (СтрокаАктивы.НижняяГраницаСреднерыночнойСтавки > РыночнаяСтавка ИЛИ СтрокаАктивы.ВерхняяГраницаСреднерыночнойСтавки < РыночнаяСтавка)
						И СтрокаАктивы.ИспользованиеРыночнойСтавкиБезУчетаПроцентаСущественностиОтклонения Тогда
						РыночнаяСтавка = СтрокаАктивы.СреднерыночнаяСтавка;
						
					ИначеЕсли СтрокаАктивы.НижняяГраницаСреднерыночнойСтавки > РыночнаяСтавка Тогда
						РыночнаяСтавка = СтрокаАктивы.НижняяГраницаСреднерыночнойСтавки;
						
					ИначеЕсли СтрокаАктивы.ВерхняяГраницаСреднерыночнойСтавки < РыночнаяСтавка Тогда
						РыночнаяСтавка = СтрокаАктивы.ВерхняяГраницаСреднерыночнойСтавки;
						
					ИначеЕсли СтрокаАктивы.ВидСтавкиДляРасчетаДисконтированногоПотока <> Перечисления.ВидыПроцентныхСтавокДляРасчетаСтоимостиДепозитныхВкладов.ЭСП Тогда
						РыночнаяСтавка = СтрокаАктивы.СтавкаПоДоговору;
						
					КонецЕсли;
										
					РасчетнаяСтоимостьАктива = РассчитатьСтоимостьАктиваПоСтавке(РыночнаяСтавка, 
																				Период, 
																				СтрокаАктивы, 
																				СтрокаАктивы.УчетныйАктив, 
																				Ложь, 
																				СтрокаАктивы.ТочностьЭСПНаДатуРасчета, 
																				НастройкиУчета.РазрядностьОкругленияПромежуточныхРасчетовДепозитныхВкладов, 
																				Организация, 
																				СчетДоверительногоУправления, 
																				ВидыАктивовСОтдельнымиСтавкамиНаКаждыйПоток, 
																				ЦельРасчета,
																				Отказ);
																
					КонецЕсли;
																			
					СтрокаАктивы.ПроцентПоАктиву = РыночнаяСтавка;
				
			КонецЕсли;
			
		Иначе
			
			РыночнаяСтавка = СтрокаАктивы.СтавкаПоДоговору;
			
			//проверить ЭСП на рыночность, обычно это для депозитов более года
			Если СтрокаАктивы.УчетныйАктив <> Справочники.УчетныеАктивыЕПС.ДепозитныеВкладыПоСС 
				И СтрокаАктивы.ВидСтавкиДляПроверкиНаРыночность = Перечисления.ВидыПроцентныхСтавокДляРасчетаСтоимостиДепозитныхВкладов.ЭСП Тогда
				РыночнаяСтавка = ПолучитьСтавкуЭСПАктива(СтрокаАктивы, Период, СтрокаАктивы.ТочностьЭСПНаДатуРасчета);
			КонецЕсли;
			
			СтрокаАктивы.СтавкаДляПроверкиНаРыночность = РыночнаяСтавка;
			СтрокаАктивы.СтавкаПризнанаРыночной = НЕ (СтрокаАктивы.НижняяГраницаСреднерыночнойСтавки > РыночнаяСтавка ИЛИ СтрокаАктивы.ВерхняяГраницаСреднерыночнойСтавки < РыночнаяСтавка);
				
			Если (СтрокаАктивы.НижняяГраницаСреднерыночнойСтавки > РыночнаяСтавка ИЛИ СтрокаАктивы.ВерхняяГраницаСреднерыночнойСтавки < РыночнаяСтавка)
				И СтрокаАктивы.ИспользованиеРыночнойСтавкиБезУчетаПроцентаСущественностиОтклонения Тогда
				РыночнаяСтавка = СтрокаАктивы.СреднерыночнаяСтавка;
				
			ИначеЕсли СтрокаАктивы.НижняяГраницаСреднерыночнойСтавки > РыночнаяСтавка Тогда
				РыночнаяСтавка = СтрокаАктивы.НижняяГраницаСреднерыночнойСтавки;
				
			ИначеЕсли СтрокаАктивы.ВерхняяГраницаСреднерыночнойСтавки < РыночнаяСтавка Тогда
				РыночнаяСтавка = СтрокаАктивы.ВерхняяГраницаСреднерыночнойСтавки;
				
			ИначеЕсли СтрокаАктивы.УчетныйАктив <> Справочники.УчетныеАктивыЕПС.ДепозитныеВкладыПоСС
				И СтрокаАктивы.ВидСтавкиДляПроверкиНаРыночность <> Перечисления.ВидыПроцентныхСтавокДляРасчетаСтоимостиДепозитныхВкладов.ЭСП
				И СтрокаАктивы.ВидСтавкиДляРасчетаДисконтированногоПотокаНаДатуРасчета = Перечисления.ВидыПроцентныхСтавокДляРасчетаСтоимостиДепозитныхВкладов.ЭСП Тогда
				
				РыночнаяСтавка = ПолучитьСтавкуЭСПАктива(СтрокаАктивы, Период, СтрокаАктивы.ТочностьЭСПНаДатуРасчета);
				
			КонецЕсли;
			
			РасчетнаяСтоимостьАктива = РассчитатьСтоимостьАктиваПоСтавке(РыночнаяСтавка, 
																		Период, 
																		СтрокаАктивы, 
																		СтрокаАктивы.УчетныйАктив, 
																		Ложь, 
																		СтрокаАктивы.ТочностьЭСПНаДатуРасчета, 
																		НастройкиУчета.РазрядностьОкругленияПромежуточныхРасчетовДепозитныхВкладов, 
																		Организация, 
																		СчетДоверительногоУправления, 
																		ВидыАктивовСОтдельнымиСтавкамиНаКаждыйПоток, 
																		ЦельРасчета,
																		Отказ);
															
			СтрокаАктивы.ПроцентПоАктиву = РыночнаяСтавка;
															
		КонецЕсли;
		
		Если СтрокаАктивы.СтавкаПризнанаРыночной 
		   И СтрокаАктивы.ПервоначальноеПризнаниеДепозитаИлиМНО
		   И СтрокаАктивы.ПериодичностьВыплатыПроцентов <> Перечисления.ПериодичностиВыплатыПроцентов.Авансом Тогда
			РасчетнаяСтоимостьАктива = НулеваяРыночнаяСтоимостьАктива; //При ПП депозита или мно, если ставка рыночная, то актив не дисконтируется
		КонецЕсли;
		
		Если ТипЗнч(РасчетнаяСтоимостьАктива) <> Тип("Структура") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При расчете рыночной стоимости актива "+СтрокаАктивы.Актив+" полученный результат не соответствует ожидаемой структуре",,,,Отказ);
		ИначеЕсли РасчетнаяСтоимостьАктива.Стоимость <> 0 Тогда
			//Депозиты ПСБ Будущего
			Если СтрокаАктивы.Актив = ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозит_ПСБ_37313") И НачалоДня(Период) = Дата(2020, 3, 23) Тогда
				СтрокаАктивы.ПроцентыЭСП = -2871.8;
			ИначеЕсли СтрокаАктивы.Актив = ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозит_ПСБ_37316") И НачалоДня(Период) = Дата(2020, 3, 26) Тогда 	
				СтрокаАктивы.ПроцентыЭСП = -2160.50;
			Иначе
				СтрокаАктивы.ПроцентыЭСП = РасчетнаяСтоимостьАктива.Стоимость - (СтрокаАктивы.Номинал + (СтрокаАктивы.Проценты - СтрокаАктивы.Задолженность));		
			КонецЕсли;
			СтрокаАктивы.СуммаРезерва 		= РасчетнаяСтоимостьАктива.Обесценение;
			СтрокаАктивы.ЕстьОбесценение 	= СтрокаАктивы.СуммаРезерва <> 0;
			
			Если НЕ СтрокаАктивы.ЭтоДенежныйПоток Тогда
				СтрокаАктивы.ПроцентыЭСП 	= Окр(СтрокаАктивы.ПроцентыЭСП, 2);
				СтрокаАктивы.СуммаРезерва 	= Окр(СтрокаАктивы.СуммаРезерва, 2);
			КонецЕсли;
				
			Если СтрокаАктивы.УчетныйАктив <> Справочники.УчетныеАктивыЕПС.ДепозитныеВкладыПоСС Тогда
				СтрокаАктивы.МетодРасчета = "По ЭСП";
			КонецЕсли;
			
			Если РасчетнаяСтоимостьАктива.Свойство("АдресРасшифровкиДенежныхПотоков") Тогда
				СтрокаАктивы.АдресРасшифровкиДенежныхПотоков = РасчетнаяСтоимостьАктива.АдресРасшифровкиДенежныхПотоков;
			КонецЕсли;
		КонецЕсли;
		
		//Не покажем отрицательные проценты
		Если СтрокаАктивы.Проценты + СтрокаАктивы.ПроцентыЭСП < 0 
			И СтрокаАктивы.НеПоказыватьОтрицательныеПроценты
			И НЕ СтрокаАктивы.НеУчитывать580ПИОтнестиКорректировкуНаТело Тогда
			СтрокаАктивы.Проценты = 0;
			СтрокаАктивы.ПроцентыЭСП = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	#КонецОбласти
	
	// Обесценение
	ПрименитьОбесценение(Активы, СчетДоверительногоУправления, Период, ЦельРасчета, Отказ);
	
	// Свернуть денежные потоки
	СтрокиДенежныхПотоков = Активы.НайтиСтроки(Новый Структура("ЭтоДенежныйПоток", Истина));
	Если СтрокиДенежныхПотоков.Количество()>0 Тогда
		
		АктивыСПотоками = Новый ТаблицаЗначений;
		АктивыСПотоками.Колонки.Добавить("Актив");
		АктивыСПотоками.Колонки.Добавить("ОсновнаяСтрока");
		
		Для Каждого СтрокаДенежногоПотока ИЗ СтрокиДенежныхПотоков Цикл
			АктивСПотоками = АктивыСПотоками.Найти(СтрокаДенежногоПотока.Актив, "Актив");
			Если АктивСПотоками = Неопределено Тогда
				АктивСПотоками = АктивыСПотоками.Добавить();
				АктивСПотоками.Актив = СтрокаДенежногоПотока.Актив;
				АктивСПотоками.ОсновнаяСтрока = СтрокаДенежногоПотока;
				
				ТаблицаДенежныхПотоков = Активы.СкопироватьКолонки();
				ЗаполнитьЗначенияСвойств(ТаблицаДенежныхПотоков.Добавить(), СтрокаДенежногоПотока);
				СтрокаДенежногоПотока.АдресРасшифровкиДенежныхПотоков = ПоместитьВоВременноеХранилище(ТаблицаДенежныхПотоков);
			
			Иначе
				ОсновнаяСтрока = АктивСПотоками.ОсновнаяСтрока;
				
				ТаблицаДенежныхПотоков = ПолучитьИзВременногоХранилища(ОсновнаяСтрока.АдресРасшифровкиДенежныхПотоков);
				ЗаполнитьЗначенияСвойств(ТаблицаДенежныхПотоков.Добавить(), СтрокаДенежногоПотока);
				ОсновнаяСтрока.АдресРасшифровкиДенежныхПотоков = ПоместитьВоВременноеХранилище(ТаблицаДенежныхПотоков);
				
				ОсновнаяСтрока.Номинал = ОсновнаяСтрока.Номинал + СтрокаДенежногоПотока.Номинал;
				ОсновнаяСтрока.Проценты = ОсновнаяСтрока.Проценты + СтрокаДенежногоПотока.Проценты;
				ОсновнаяСтрока.ПроцентыЭСП = ОсновнаяСтрока.ПроцентыЭСП + СтрокаДенежногоПотока.ПроцентыЭСП;
				ОсновнаяСтрока.СуммаРезерва = ОсновнаяСтрока.СуммаРезерва + СтрокаДенежногоПотока.СуммаРезерва;
				Если ОсновнаяСтрока.ДатаПогашения < СтрокаДенежногоПотока.ДатаПогашения Тогда
					ОсновнаяСтрока.ДатаПогашения = СтрокаДенежногоПотока.ДатаПогашения;
				КонецЕсли;
				
				Активы.Удалить(СтрокаДенежногоПотока);
			КонецЕсли;
		КонецЦикла;
		
		//округлим после суммирования потоков
		Для Каждого АктивСПотоками из АктивыСПотоками Цикл
			ОсновнаяСтрока = АктивСПотоками.ОсновнаяСтрока;
			
			//Расчитывем от общей округленной стоимости, чтобы итоговый результат не разъехался
			//Какой показатель округлить первым - для ПИФ без разницы, остальные пока не используют.
			СуммаДисконтированияИОбсценения = Окр(ОсновнаяСтрока.ПроцентыЭСП + ОсновнаяСтрока.СуммаРезерва, 2); 
			ОсновнаяСтрока.ПроцентыЭСП = Окр(ОсновнаяСтрока.ПроцентыЭСП, 2);
			ОсновнаяСтрока.СуммаРезерва = СуммаДисконтированияИОбсценения - ОсновнаяСтрока.ПроцентыЭСП;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЭтоРасшифровка Тогда
		СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(Активы, "_РасшифровкаСтоимостиАктивовПоРыночнойСтавке", МенеджерВременныхТаблиц);
	КонецЕсли;
		
	Возврат Активы;
	
КонецФункции

Процедура ПрименитьОбесценение(Активы, СчетДоверительногоУправления, Период, ЦельРасчета, Отказ) Экспорт
	
	Если Активы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Активы)<>Тип("ТаблицаЗначений") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести обесценение активов",,,,Отказ);
		Возврат;
	КонецЕсли;
	
	ТипыАктивовОбесцениваемыеКоэффициентом = Новый Массив;
	ТипыАктивовОбесцениваемыеКоэффициентом.Добавить(Тип("СправочникСсылка.Займы"));
	ТипыАктивовОбесцениваемыеКоэффициентом.Добавить(Тип("ДокументСсылка.ЗакрытиеКредитногоИнструмента"));
	ТипыАктивовОбесцениваемыеКоэффициентом.Добавить(Тип("ДокументСсылка.СделкаСНедвижимостью"));
	ТипыАктивовОбесцениваемыеКоэффициентом.Добавить(Тип("ДокументСсылка.НачислениеЗадолженности"));
	
	#Область Процент_Обесценения
	
	//для Начислений задолженности коэффициент обесценения висит на Договоре, а не на самом документе.
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Активы.Актив КАК Актив
		|ПОМЕСТИТЬ _АктивыКОбесценению
		|ИЗ
		|	&Активы КАК Активы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивыКОбесценению.Актив КАК Актив,
		|	ОбесценениеАктивовСрезПоследних.Коэффициент КАК Коэффициент
		|ИЗ
		|	_АктивыКОбесценению КАК _АктивыКОбесценению
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
		|		ПО _АктивыКОбесценению.Актив = НачислениеЗадолженности.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОбесценениеАктивов.СрезПоследних(
		|				&ДатаОценки,
		|				Актив В
		|						(ВЫБРАТЬ
		|							НачислениеЗадолженности.Договор КАК Актив
		|						ИЗ
		|							_АктивыКОбесценению КАК _АктивыКОбесценению
		|								ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
		|								ПО
		|									_АктивыКОбесценению.Актив = НачислениеЗадолженности.Ссылка
		|				
		|						ОБЪЕДИНИТЬ ВСЕ
		|				
		|						ВЫБРАТЬ
		|							_АктивыКОбесценению.Актив
		|						ИЗ
		|							_АктивыКОбесценению КАК _АктивыКОбесценению)
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ДатаДенежногоПотока = ДАТАВРЕМЯ(1, 1, 1)) КАК ОбесценениеАктивовСрезПоследних
		|		ПО (_АктивыКОбесценению.Актив = ОбесценениеАктивовСрезПоследних.Актив
		|				ИЛИ НачислениеЗадолженности.Договор = ОбесценениеАктивовСрезПоследних.Актив)
		|ГДЕ
		|	ОбесценениеАктивовСрезПоследних.Коэффициент <> 1";
	
	Запрос.УстановитьПараметр("Активы", Активы);
	Запрос.УстановитьПараметр("ДатаОценки", Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ТипыАктивовОбесцениваемыеКоэффициентом.Найти(ТипЗнч(ВыборкаДетальныеЗаписи.Актив)) = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Вид актива "+ТипЗнч(ВыборкаДетальныеЗаписи.Актив)+" не обработан при обесценении по коэффициенту!",,,,Отказ);
			Возврат;
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.Коэффициент = 1 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиАктива = Активы.НайтиСтроки(Новый Структура("Актив, ЕстьОбесценение", ВыборкаДетальныеЗаписи.Актив, Ложь));
		
		Для Каждого СтрокаАктива Из СтрокиАктива Цикл
		
			СтоимостьАктива = СтрокаАктива.Номинал + СтрокаАктива.Проценты + СтрокаАктива.ПроцентыЭСП;
			СуммаОбесценения = СтоимостьАктива * ВыборкаДетальныеЗаписи.Коэффициент - СтоимостьАктива;
			
			//распределим обратно полученную сумму. Пока все отнесенм на проценты по ЭСП.
			СтрокаАктива.СуммаРезерва = СуммаОбесценения;
			
			// Помечаем, что к этому активу применено обесценение
			СтрокаАктива.ЕстьОбесценение = Истина;

		КонецЦикла;
		
	КонецЦикла;
	
	#КонецОбласти
	
	#Область Остатки_Регистра_РезервыПредстоящихРасходов
	
	// Для цели ОценкаОбъектовВУправлении заполним резервы из регистра резервов
	Если ЦельРасчета <> Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении Или Период >= '20230101' Тогда
		Возврат;
	КонецЕсли;
	
	// Если СуммаРезерва уже заполнена, не перезаполняем (уже применен процент обесценения)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК Актив,
		|	РезервыПредстоящихРасходовОстатки.СуммаОстаток КАК СуммаРезерва
		|ИЗ
		|	РегистрНакопления.РезервыПредстоящихРасходов.Остатки(
		|			&ДатаОценки,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И СубъектАналитики В (&Активы)
		|				И Резерв В (&Резервы)) КАК РезервыПредстоящихРасходовОстатки";
	
	Запрос.УстановитьПараметр("Активы", Активы.ВыгрузитьКолонку("Актив"));
	Запрос.УстановитьПараметр("ДатаОценки", Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	МассивРезервов = Новый Массив;
	МассивРезервов.Добавить(Справочники.Резервы.РезервОбесценениеБумагиБлагоприятныеИзмененияОбесцененныеПриПризнании);
	МассивРезервов.Добавить(Справочники.Резервы.РезервОбесценениеБумагиОбесцененныеНеобеспеченныеПриПризнании);
	МассивРезервов.Добавить(Справочники.Резервы.РезервОбесценениеБумагиУбыткиВесьСрокУвеличилсяРискНеобесцененные);
	МассивРезервов.Добавить(Справочники.Резервы.РезервОбесценениеДепозитыОбесцененныеОбеспеченныеПриПризнании);
	МассивРезервов.Добавить(Справочники.Резервы.РезервОбесценениеДепозитыОбесцененныеПриПризнании);
	МассивРезервов.Добавить(Справочники.Резервы.РезервОбесценениеДепозитыУбыткиВесьСрокИндивидуальнаяОценка);
	МассивРезервов.Добавить(Справочники.Резервы.РезервОбесценениеДепозитыУбыткиВесьСрокГрупповаяОценка);
	МассивРезервов.Добавить(Справочники.Резервы.РезервОбесценениеУбытки12Месяцев);
	МассивРезервов.Добавить(Справочники.Резервы.РезервПодОбесценениеМСФО39);
	
	Запрос.УстановитьПараметр("Резервы", МассивРезервов); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ТипыАктивовОбесцениваемыеКоэффициентом.Найти(ТипЗнч(ВыборкаДетальныеЗаписи.Актив)) <> Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Вид актива "+ТипЗнч(ВыборкаДетальныеЗаписи.Актив)+" не обработан при обесценении по сумме!",,,,Отказ);
			Возврат;
		КонецЕсли;
		
		СтрокаАктива = Активы.Найти(ВыборкаДетальныеЗаписи.Актив, "Актив");		
		СтрокаАктива.СуммаРезерва = ?(СтрокаАктива.СуммаРезерва = 0, - ВыборкаДетальныеЗаписи.СуммаРезерва, СтрокаАктива.СуммаРезерва);
		
	КонецЦикла;
	
	#КонецОбласти
	
КонецПроцедуры

Функция РасшифровкаСтоимостиАктиваПоРыночнойСтавке(Актив, СчетДоверительногоУправления, Период, ЦельРасчета, ПараметрыЗаполнения = Неопределено, Отказ) Экспорт
	
	Результат = Новый ТабличныйДокумент;
	Результат.ОтображатьЗаголовки	= Ложь;
	Результат.ОтображатьСетку		= Ложь;
	Результат.ТолькоПросмотр		= Истина;
	
	Клиент		= Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период);
	
	НастройкиФормированияСЧА = РегистрыСведений.НастройкиФормированияСЧА.ОпределитьНастройки(Период, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления);
	НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(Период, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, ЦельРасчета);
	
#Область Макет
	МакетРасшифровки = РегистрыСведений.НастройкиРасчетаРыночнойСтавкиПоВидамАктивов.ПолучитьМакет("РасшифровкаСтоимостиАктиваПоРыночнойСтавке");
	
	ОбластьРазделитель = МакетРасшифровки.ПолучитьОбласть("Разделитель");
	ОбластьГруппировка = МакетРасшифровки.ПолучитьОбласть("Группировка");
#КонецОбласти	
	
#Область Шапка 
	ОбластьШапка = МакетРасшифровки.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Организация					= СчетДоверительногоУправления.Организация;
	ОбластьШапка.Параметры.СчетДоверительногоУправления	= СчетДоверительногоУправления;
	ОбластьШапка.Параметры.Актив						= Актив;
	ОбластьШапка.Параметры.Период						= Период;
	ОбластьШапка.Параметры.ЦельРасчета					= ЦельРасчета;

	Результат.Вывести(ОбластьШапка);
	Результат.Вывести(ОбластьРазделитель);
#КонецОбласти	
	
#Область Актив

	ОбластьАктив = Неопределено;
	
	Если ТипЗнч(Актив) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		ОбластьАктив = МакетРасшифровки.ПолучитьОбласть("ДепозитныВклад");
		
	ИначеЕсли ТипЗнч(Актив) = Тип("ДокументСсылка.МНО") Тогда
		ОбластьАктив = МакетРасшифровки.ПолучитьОбласть("МНО");
	
	ИначеЕсли ТипЗнч(Актив) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		ОбластьАктив = МакетРасшифровки.ПолучитьОбласть("СделкаРЕПО");
		
	ИначеЕсли ТипЗнч(Актив) = Тип("ДокументСсылка.Сделка") Тогда
		ОбластьАктив = МакетРасшифровки.ПолучитьОбласть("Сделка");
	
	ИначеЕсли ТипЗнч(Актив) = Тип("ДокументСсылка.СделкаСНедвижимостью") Тогда
		ОбластьАктив = МакетРасшифровки.ПолучитьОбласть("СделкаСНедвижимостью");
	
	ИначеЕсли ТипЗнч(Актив) = Тип("СправочникСсылка.Займы") Тогда
		ОбластьАктив = МакетРасшифровки.ПолучитьОбласть("Займ");
	
	КонецЕсли;
	
	ПараметрыРазмещения = Новый Структура("ДатаРазмещения, ДатаПогашения, Тип, Сумма");

	Если ОбластьАктив <> Неопределено Тогда
		ПараметрыАктива = ПолучитьПараметрыАктива(Актив, Период);
		
		ЗаполнитьЗначенияСвойств(ОбластьАктив.Параметры, ПараметрыАктива);
		ЗаполнитьЗначенияСвойств(ПараметрыРазмещения, ПараметрыАктива);
		
		Результат.Вывести(ОбластьАктив);
		Результат.Вывести(ОбластьРазделитель);
	КонецЕсли;
	
#КонецОбласти

#Область ПлановыеВыплаты

	ПлановыеВыплаты = ПолучитьПлановыеВыплатыПоАктиву(СчетДоверительногоУправления, Актив, Период);
	Если ПлановыеВыплаты.Количество() <> 0  Тогда
		ПлановыеВыплаты.Сортировать("Период");
	КонецЕсли;
	
	Результат.Вывести(МакетРасшифровки.ПолучитьОбласть("ШапкаДенежныеПотоки"));
	
	НомерСтроки = 1;
	ОбластьСтрокаДенежныеПотоки = МакетРасшифровки.ПолучитьОбласть("СтрокаДенежныеПотоки");
	
	Если ТипЗнч(Актив) = Тип("ДокументСсылка.Сделка")
		И ЗначениеЗаполнено(ПараметрыРазмещения.ДатаПогашения) Тогда
		
		ОбластьСтрокаДенежныеПотоки.Параметры.Номер		= НомерСтроки;
		ОбластьСтрокаДенежныеПотоки.Параметры.Период	= ПараметрыРазмещения.ДатаПогашения;
		ОбластьСтрокаДенежныеПотоки.Параметры.Тип		= ПараметрыРазмещения.Тип;
		ОбластьСтрокаДенежныеПотоки.Параметры.Сумма 	= ПараметрыРазмещения.Сумма;
		
		Результат.Вывести(ОбластьСтрокаДенежныеПотоки);
		
		НомерСтроки = НомерСтроки + 1;
		
	ИначеЕсли ЗначениеЗаполнено(ПараметрыРазмещения.ДатаРазмещения) Тогда
		
		ОбластьСтрокаДенежныеПотоки.Параметры.Номер		= НомерСтроки;
		ОбластьСтрокаДенежныеПотоки.Параметры.Период	= ПараметрыРазмещения.ДатаРазмещения;
		ОбластьСтрокаДенежныеПотоки.Параметры.Тип		= ПараметрыРазмещения.Тип;
		ОбластьСтрокаДенежныеПотоки.Параметры.Сумма 	= - ПараметрыРазмещения.Сумма;
		
		Результат.Вывести(ОбластьСтрокаДенежныеПотоки);
		
		НомерСтроки = НомерСтроки + 1;
	КонецЕсли;
	
	Для Каждого СтрокаВыплаты Из ПлановыеВыплаты Цикл
		ЗаполнитьЗначенияСвойств(ОбластьСтрокаДенежныеПотоки.Параметры, СтрокаВыплаты);
		ОбластьСтрокаДенежныеПотоки.Параметры.Номер		= НомерСтроки;
		
		Результат.Вывести(ОбластьСтрокаДенежныеПотоки);
		
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Если НомерСтроки > 1 Тогда
		Результат.Вывести(ОбластьРазделитель);
	КонецЕсли;
	
#КонецОбласти

#Область ПолучениеСтрокиРасшифровки

	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ПустаяТаблицаЗначений = Новый ТаблицаЗначений;
	ПустаяТаблицаЗначений.Колонки.Добавить("АктивНеПроверяетсяНаРыночность", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(1)));
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ПустаяТаблицаЗначений, "_РасшифровкаСтоимостиАктивовПоРыночнойСтавке", МенеджерВременныхТаблиц);

	РеквизитыАктива = Новый Структура("Актив,Номинал,Проценты,СтавкаПоДоговору");
	
	Если ТипЗнч(Актив) = Тип("СправочникСсылка.ДепозитныеВклады") ИЛИ ТипЗнч(Актив) = Тип("СправочникСсылка.Займы") Тогда
		Если ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении Тогда
			
			РаботаСКредитнымиИнструментами.ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправленияДляРСА(
				СчетДоверительногоУправления, 
				Период,
				РаботаСКредитнымиИнструментами.ПолучитьТипКредитногоИнструмента(Актив),
				,
				, 
				МенеджерВременныхТаблиц, 
				Отказ);
				
		Иначе
				
			РаботаСКредитнымиИнструментами.ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправленияПоРыночнойСтавкеСУчетомПериодичностиОценки(
				СчетДоверительногоУправления,
				Период,
				ЦельРасчета,
				РаботаСКредитнымиИнструментами.ПолучитьТипКредитногоИнструмента(Актив),
				,
				МенеджерВременныхТаблиц, 
				Отказ);
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Актив) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		Справочники.ВариантыРасчетаОценочнойСтоимости.ПолучитьЗадолженностиПоСделкамРЕПО(
			НастройкиОценки.ВариантРасчетаОценочнойСтоимости,
			СчетДоверительногоУправления.Организация,
			СчетДоверительногоУправления, 
			Период,
			Неопределено,
			ЦельРасчета,
			Неопределено,
			НастройкиФормированияСЧА,
			Отказ,
			МенеджерВременныхТаблиц);
			
	ИначеЕсли ТипЗнч(Актив) = Тип("ДокументСсылка.Сделка") Тогда
		Справочники.ВариантыРасчетаОценочнойСтоимости.ПолучитьЗадолженностиПоСделкамСРаздельнымИсполнением(
			НастройкиОценки.ВариантРасчетаОценочнойСтоимости,
			СчетДоверительногоУправления.Организация,
			СчетДоверительногоУправления, 
			Период,
			ЦельРасчета,
			Отказ,
			МенеджерВременныхТаблиц);
			
	ИначеЕсли ТипЗнч(Актив) = Тип("ДокументСсылка.СделкаСНедвижимостью") Тогда
			
		Параметры = Новый Структура;
		Параметры.Вставить("ВариантРасчетаОценочнойСтоимости", НастройкиОценки.ВариантРасчетаОценочнойСтоимости);
		Параметры.Вставить("СчетДоверительногоУправления", СчетДоверительногоУправления);
		Параметры.Вставить("Период", Период);
		Параметры.Вставить("Организация", СчетДоверительногоУправления.Организация);
		Параметры.Вставить("ЦельРасчета", ЦельРасчета);
	
		СтоимостиЗадолженностей = РаботаСоСтоимостьюПоРыночнойСтавке.РассчитатьСправедливыеСтоимостиЗадолженностей(Параметры, Неопределено, Отказ, МенеджерВременныхТаблиц);
		
	ИначеЕсли ТипЗнч(Актив) = Тип("ДокументСсылка.МНО") Тогда
		
		Если НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Сургутнефтегаз
			ИЛИ (НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Федерация И Период < '20200514')
		Тогда
			ВидУчета = Неопределено;		
			ОпределитьПериодичностьПереоценкиМНО = Истина;
		ИначеЕсли НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.СбербанкСтрахование Тогда
			ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;		
			ОпределитьПериодичностьПереоценкиМНО = Истина;
		Иначе
			ВидУчета = Неопределено;		
			ОпределитьПериодичностьПереоценкиМНО = Ложь;
		КонецЕсли;
		
		СтоимостиМНО = РаботаСМНО.ПолучитьСтоимостиМНОСчетуДоверительногоУправления(
			СчетДоверительногоУправления, 
			ВидУчета, 
			ОпределитьПериодичностьПереоценкиМНО,
			Период,
			ЦельРасчета,
			Отказ,
			МенеджерВременныхТаблиц);
			
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если МенеджерВременныхТаблиц.Таблицы.Найти("_РасшифровкаСтоимостиАктивовПоРыночнойСтавке").Колонки.Найти("АктивНеПроверяетсяНаРыночность") <> Неопределено Тогда
		ВывестиОбласть("НеПроверяется", МакетРасшифровки, Результат);
		Возврат Результат;
	Иначе
		Таблица_РасшифровкаСтоимостиАктивовПоРыночнойСтавке = МенеджерВременныхТаблиц.Таблицы.Найти("_РасшифровкаСтоимостиАктивовПоРыночнойСтавке").ПолучитьДанные().Выгрузить();
	КонецЕсли;
	
	СтрокаРасшифровки = Таблица_РасшифровкаСтоимостиАктивовПоРыночнойСтавке.Найти(Актив, "Актив");
	
	Если СтрокаРасшифровки = Неопределено 
		ИЛИ СтрокаРасшифровки.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.НеПроверять Тогда
		ВывестиОбласть("НеПроверяется", МакетРасшифровки, Результат);
		Возврат Результат;
	КонецЕсли;
	
#КонецОбласти

#Область ПараметрыПроверкиНаРыночность

	ОбластьГруппировка.Параметры.Имя = "Настройки проверки на рыночность";
	Результат.Вывести(ОбластьГруппировка);
	Результат.НачатьГруппуСтрок(, Ложь);

	ОбластьЗаголовокНастройки = МакетРасшифровки.ПолучитьОбласть("ЗаголовокНастройки");
	ЗаполнитьЗначенияСвойств(ОбластьЗаголовокНастройки.Параметры, СтрокаРасшифровки);
	ОбластьЗаголовокНастройки.Параметры.ТипСубъекта = ТипЗнч(СтрокаРасшифровки.Субъект);
	Результат.Вывести(ОбластьЗаголовокНастройки);
	
	СписокИспользуемыхИзмеренийИРесурсов = РегистрыСведений.НастройкиРасчетаРыночнойСтавкиПоВидамАктивов.ИспользуемыеИзмеренияИРесурсы(СтрокаРасшифровки);
	
	МассивИсключений = Новый Массив; //Выводятся отдельно
	МассивИсключений.Добавить("Организация");
	МассивИсключений.Добавить("Субъект");
	МассивИсключений.Добавить("Валюта");
	МассивИсключений.Добавить("ВидАктива");
	МассивИсключений.Добавить("ЦельРасчета");
	МассивИсключений.Добавить("СхемаПроверкиСущественностиОтклонений");
	
	Присоединить = Ложь;
	ОбластьЭлементНастройки = МакетРасшифровки.ПолучитьОбласть("ЭлементНастройки|Первая");
	
	Для Каждого ИспользуемыйРесурс Из СписокИспользуемыхИзмеренийИРесурсов Цикл
		Если ИспользуемыйРесурс.Пометка
		   И МассивИсключений.Найти(ИспользуемыйРесурс.Значение) = Неопределено Тогда
			
			ОбластьЭлементНастройки.Параметры.Представление = ИспользуемыйРесурс.Представление;
			ОбластьЭлементНастройки.Параметры.Значение		= СтрокаРасшифровки[ИспользуемыйРесурс.Значение];
			Если Присоединить Тогда
				Результат.Присоединить(ОбластьЭлементНастройки);
			Иначе
				Результат.Вывести(ОбластьЭлементНастройки);
				Присоединить = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Результат.ЗакончитьГруппуСтрок();
	
	Результат.Вывести(ОбластьРазделитель);
	
#КонецОбласти

#Область ДатаПроверкиНаРыночность

	ОбластьГруппировка.Параметры.Имя = "Дата проверки на рыночность";
	Результат.Вывести(ОбластьГруппировка);

	ВывестиОбласть("ДатаПроверкиНаРыночность", МакетРасшифровки, Результат, СтрокаРасшифровки);
	
	Результат.Вывести(ОбластьРазделитель);
	
#КонецОбласти

#Область СоставРасшифровки

	СоставРасшифровки = Новый Структура;
	Если СтрокаРасшифровки.ВариантОтклоненияОтРыночнойСтавки = Перечисления.ВариантыОтклоненияОтРыночнойСтавкиПоДепозитнымВкладам.КриваяБезрисковойДоходности Тогда
	    СоставРасшифровки = Новый Структура("РыночнаяСтавка, ГраницыРыночнойСтавки, СтавкиПоАктивуИМетодРасчета");
		
	ИначеЕсли СтрокаРасшифровки.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.СтавкаРыночная
	 ИЛИ СтрокаРасшифровки.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.СтавкаРыночнаяИОтклонениеСтоимостиПоЭСП
	 ИЛИ СтрокаРасшифровки.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.СтавкаРыночнаяИлиОтклонениеСтоимостиПоРыночнойСтавке
	 ИЛИ СтрокаРасшифровки.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ОтклонениеСтоимостиПоЭСППоРыночнойСтавке Тогда
		Если ТипЗнч(СтрокаРасшифровки.ВидСредневзвешеннойРыночнойСтавки) = Тип("СправочникСсылка.БиржевыеИндексы") Тогда
			СоставРасшифровки = Новый Структура("БиржевойИндекс, ГраницыРыночнойСтавки, СтавкиПоАктивуИМетодРасчета");
		Иначе
	 		СоставРасшифровки = Новый Структура("СредневзвешеннаяСтавка, КлючеваяСтавка, РыночнаяСтавка, ГраницыРыночнойСтавки, СтавкиПоАктивуИМетодРасчета");
		КонецЕсли;
	 
	ИначеЕсли СтрокаРасшифровки.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ПересчитатьПоРыночнойСтавке Тогда
	    СоставРасшифровки = Новый Структура("СредневзвешеннаяСтавка,КлючеваяСтавка,РыночнаяСтавка");
		
	ИначеЕсли СтрокаРасшифровки.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ЦентральныйКонтрагентИлиСтавкаРыночная Тогда
		Если СтрокаРасшифровки.СделкаСЦентральнымКонтрагентом
			И СтрокаРасшифровки.СрокАктиваДляПримененияРыночнойСтавки < СтрокаРасшифровки.МаксимальныйСрокДоПогашенияДляПримененияЛинейногоРасчета Тогда
			СоставРасшифровки = Новый Структура("СделкаСЦК");
		Иначе
			СоставРасшифровки = Новый Структура("СредневзвешеннаяСтавка, КлючеваяСтавка, РыночнаяСтавка, ГраницыРыночнойСтавки, СтавкиПоАктивуИМетодРасчета");
		КонецЕсли;
		
	ИначеЕсли СтрокаРасшифровки.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ЦентральныйКонтрагентИлиСтавкаРыночнаяПоШкалеИндексов Тогда
		Если СтрокаРасшифровки.СделкаСЦентральнымКонтрагентом
			И СтрокаРасшифровки.СрокАктиваДляПримененияРыночнойСтавки < СтрокаРасшифровки.МаксимальныйСрокДоПогашенияДляПримененияЛинейногоРасчета Тогда
			СоставРасшифровки = Новый Структура("СделкаСЦК");
		Иначе
			СоставРасшифровки = Новый Структура("БиржевойИндекс, РыночнаяСтавка, ГраницыРыночнойСтавки, СтавкиПоАктивуИМетодРасчета");
		КонецЕсли;		
		
	ИначеЕсли СтрокаРасшифровки.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ЦентральныйКонтрагент Тогда
		Если СтрокаРасшифровки.СрокАктиваДляПримененияРыночнойСтавки < СтрокаРасшифровки.МаксимальныйСрокДоПогашенияДляПримененияЛинейногоРасчета Тогда
			СоставРасшифровки = Новый Структура("СделкаСЦК");
		КонецЕсли;
		
	ИначеЕсли СтрокаРасшифровки.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.НеПроверять Тогда
		СоставРасшифровки = Новый Структура("АктивНеПроверяетсяНаРыночность");
		
	ИначеЕсли СтрокаРасшифровки.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ПоКлючевойСтавке Тогда
		СоставРасшифровки = Новый Структура("КлючеваяВКачествеРыночной, ГраницыРыночнойСтавки, СтавкиПоАктивуИМетодРасчета");
		
	ИначеЕсли СтрокаРасшифровки.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ЛинейноИПоФактическойЭСП Тогда
		СоставРасшифровки = Новый Структура("СтавкиПоАктивуИМетодРасчета");
		
	ИначеЕсли СтрокаРасшифровки.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.РасчетПоМетодикеКлиента Тогда
		СоставРасшифровки = Новый Структура("РасчетПоМетодикеКлиента,ИспользованнаяРыночнаяСтавка,СтавкиПоАктивуИМетодРасчета");
		
	ИначеЕсли СтрокаРасшифровки.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.КБДИMosPrime1День Тогда
		Если СтрокаРасшифровки.СтавкаПризнанаРыночной Тогда
			СоставРасшифровки = Новый Структура("ИспользованнаяРыночнаяСтавка");
		Иначе
			СоставРасшифровки = Новый Структура("КБД_MosPrime,ИспользованнаяРыночнаяСтавка");
		КонецЕсли;
		
	КонецЕсли;
#КонецОбласти

	Если СоставРасшифровки.Свойство("КБД_MosPrime") Тогда
		
		ОбластьГруппировка.Параметры.Имя = "Ставки КБД и MosPrime";
		Результат.Вывести(ОбластьГруппировка);
		Результат.НачатьГруппуСтрок(, Ложь);

		СписокИспользуемыхПолейРасшифровки = Новый Структура;
		СписокИспользуемыхПолейРасшифровки.Вставить("ДнейДоПогашения","Дней до погашения");
		СписокИспользуемыхПолейРасшифровки.Вставить("СрокДоПогашения","Срок до погашения, лет");
		СписокИспользуемыхПолейРасшифровки.Вставить("НаиболееБлизкийПредыдущийСрокДоПогашения","Наиболее близкий предыдущий срок до погашения");
		СписокИспользуемыхПолейРасшифровки.Вставить("НаиболееБлизкийПоследующийСрокДоПогашения","Наиболее близкий последущий срок до погашения");
		СписокИспользуемыхПолейРасшифровки.Вставить("МинимальныйСрок","Минимальный срок");
		СписокИспользуемыхПолейРасшифровки.Вставить("МаксимальныйСрок","Максимальный срок");
		СписокИспользуемыхПолейРасшифровки.Вставить("СтавкаНаиболееБлизкогоПредыдущегоСрокаДоПогашения","Ставка наиболее близкого предыдущего срока до погашения");
		СписокИспользуемыхПолейРасшифровки.Вставить("СтавкаНаиболееБлизкогоПоследующегоСрокаДоПогашения","Ставка наиболее близкого последующего срока до погашения");
		СписокИспользуемыхПолейРасшифровки.Вставить("ВидСтавки","Вид ставки");
		СписокИспользуемыхПолейРасшифровки.Вставить("Ставка","Ставка");
		
		ОбластьШапкаТаблицы = МакетРасшифровки.ПолучитьОбласть("ШапкаТаблицы|Первая");
		ОбластьСтрокаТаблицы = МакетРасшифровки.ПолучитьОбласть("СтрокаТаблицы|Первая");
		
		ОбластьШапкаТаблицы.Параметры.Представление = "Дата денежного потока";
		Результат.Вывести(ОбластьШапкаТаблицы);
		ОбластьШапкаТаблицы.Параметры.Представление = "Сумма денежного потока";
		Результат.Присоединить(ОбластьШапкаТаблицы);
		ОбластьШапкаТаблицы.Параметры.Представление = "Сумма резерва под обесценение";
		Результат.Присоединить(ОбластьШапкаТаблицы);
		
		Для Каждого ИспользуемыйРесурс Из СписокИспользуемыхПолейРасшифровки Цикл
			ОбластьШапкаТаблицы.Параметры.Представление = ИспользуемыйРесурс.Значение;
			Результат.Присоединить(ОбластьШапкаТаблицы);
		КонецЦикла;
		ОбластьШапкаТаблицы.Параметры.Представление = "Корректировка дисконтирования";
		Результат.Присоединить(ОбластьШапкаТаблицы);
		
		//Проверим есть ли денежные потоки
		Если СтрокаРасшифровки.АдресРасшифровкиДенежныхПотоков <> "" Тогда
			ТаблицаДенежныхПотоков = ПолучитьИзВременногоХранилища(СтрокаРасшифровки.АдресРасшифровкиДенежныхПотоков);
			ТаблицаДенежныхПотоков.Сортировать("ДатаПогашения");
		Иначе
			ТаблицаДенежныхПотоков = Новый Массив;
			ТаблицаДенежныхПотоков.Добавить(СтрокаРасшифровки);
		КонецЕсли;
			
		Для Каждого РасшифровкаДенежногоПотока из ТаблицаДенежныхПотоков Цикл
			
			ПараметрыРасшифровки = ПолучитьИзВременногоХранилища(РасшифровкаДенежногоПотока.АдресРасшифровкиКБД_MosPrime);
			
			ОбластьСтрокаТаблицы.Параметры.Значение		= РасшифровкаДенежногоПотока.ДатаПогашения;
			Результат.Вывести(ОбластьСтрокаТаблицы);
			
			ОбластьСтрокаТаблицы.Параметры.Значение		= РасшифровкаДенежногоПотока.Номинал + РасшифровкаДенежногоПотока.Проценты;
			Результат.Присоединить(ОбластьСтрокаТаблицы);
			
			ОбластьСтрокаТаблицы.Параметры.Значение		= РасшифровкаДенежногоПотока.СуммаРезерва;
			Результат.Присоединить(ОбластьСтрокаТаблицы);
			
			Для Каждого ИспользуемыйРесурс Из СписокИспользуемыхПолейРасшифровки Цикл
				Если ПараметрыРасшифровки.Свойство(ИспользуемыйРесурс.Ключ) Тогда
					ОбластьСтрокаТаблицы.Параметры.Значение		= ПараметрыРасшифровки[ИспользуемыйРесурс.Ключ];
				Иначе
					ОбластьСтрокаТаблицы.Параметры.Значение		= "";
				КонецЕсли;
				Результат.Присоединить(ОбластьСтрокаТаблицы);
			КонецЦикла;
			
			ОбластьСтрокаТаблицы.Параметры.Значение		= РасшифровкаДенежногоПотока.ПроцентыЭСП;
			Результат.Присоединить(ОбластьСтрокаТаблицы);
					
		КонецЦикла;
		Результат.ЗакончитьГруппуСтрок();
	
		Результат.Вывести(ОбластьРазделитель);
	КонецЕсли;
			
#Область СделкаСЦК
	Если СоставРасшифровки.Свойство("СделкаСЦК") Тогда
		Если СтрокаРасшифровки.СрокАктиваДляПримененияРыночнойСтавки < СтрокаРасшифровки.МаксимальныйСрокДоПогашенияДляПримененияЛинейногоРасчета Тогда
			ОбластьГруппировка.Параметры.Имя = "Сделка с ЦК сроком до " + СтрокаРасшифровки.МаксимальныйСрокДоПогашенияДляПримененияЛинейногоРасчета + " дней не проверяется на рыночность";
			
			Результат.Вывести(ОбластьГруппировка);
			Результат.Вывести(ОбластьРазделитель);
		КонецЕсли;
	КонецЕсли;
	
#КонецОбласти

#Область АктивНеПроверяетсяНаРыночность
	Если СоставРасшифровки.Свойство("АктивНеПроверяетсяНаРыночность") Тогда
		ВывестиОбласть("НеПроверяется", МакетРасшифровки, Результат);
		Результат.Вывести(ОбластьРазделитель);
	КонецЕсли;
#КонецОбласти

#Область СредневзвешеннаяСтавка
	Если СоставРасшифровки.Свойство("СредневзвешеннаяСтавка") Тогда
		
		ОбластьГруппировка.Параметры.Имя = "Средневзвешенная ставка";
		Результат.Вывести(ОбластьГруппировка);
		Результат.НачатьГруппуСтрок(, Ложь);
		
		ВывестиОбласть("ОтборСредневзвешеннаяСтавка", МакетРасшифровки, Результат, СтрокаРасшифровки);
		
		Результат.ЗакончитьГруппуСтрок();
		
		ВывестиОбласть("СредневзвешеннаяСтавка", МакетРасшифровки, Результат, СтрокаРасшифровки);
		
		Результат.Вывести(ОбластьРазделитель);
	КонецЕсли;
#КонецОбласти

#Область КлючеваяВКачествеРыночной
	Если СоставРасшифровки.Свойство("КлючеваяВКачествеРыночной") Тогда
		ОбластьГруппировка.Параметры.Имя = "Рыночная ставка";
		Результат.Вывести(ОбластьГруппировка);
	
		ВывестиОбласть("КлючеваяВКачествеРыночной", МакетРасшифровки, Результат, СтрокаРасшифровки);
		
		Результат.Вывести(ОбластьРазделитель);
	КонецЕсли;
#КонецОбласти

#Область КлючеваяСтавка
	Если СоставРасшифровки.Свойство("КлючеваяСтавка") И НЕ СтрокаРасшифровки.ИгнорироватьИзменениеКлючевойСтавки Тогда
		ОбластьГруппировка.Параметры.Имя = "Ключевая ставка";
		Результат.Вывести(ОбластьГруппировка);
		
		Если СтрокаРасшифровки.ВариантПолученияКлючевойСтавки = Перечисления.ВариантыПолученияКлючевойСтавкиЗаПериодДействияСредневзвешенойСтавкиПоДепозитам.СредняяЗаМесяц Тогда
			Результат.НачатьГруппуСтрок(, Ложь);
			Результат.Вывести(МакетРасшифровки.ПолучитьОбласть("ШапкаСредняяКлючевая"));
			
			Для Каждого СтрокаКлючевыеСтавки Из КлючевыеСтавкиЗаМесяц(Период, СтрокаРасшифровки.ПериодСреднерыночнойСтавки) Цикл
				ВывестиОбласть("СтрокаСредняяКлючевая", МакетРасшифровки, Результат, СтрокаКлючевыеСтавки);
			КонецЦикла;	
			
			Результат.ЗакончитьГруппуСтрок();
		КонецЕсли;
		
		ВывестиОбласть("КлючеваяСтавка", МакетРасшифровки, Результат, СтрокаРасшифровки);
		
		Результат.Вывести(ОбластьРазделитель);
	КонецЕсли;
#КонецОбласти

#Область РыночнаяСтавка

	Если СоставРасшифровки.Свойство("РыночнаяСтавка") Тогда
		
		ОбластьГруппировка.Параметры.Имя = "Рыночная ставка";
		Результат.Вывести(ОбластьГруппировка);
		Результат.НачатьГруппуСтрок(, Ложь);

		ВывестиОбласть("РыночнаяСтавка", МакетРасшифровки, Результат, СтрокаРасшифровки);
		
		Если СтрокаРасшифровки.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ПересчитатьПоРыночнойСтавке Тогда
			ВывестиОбласть("МетодРасчетаДепозита", МакетРасшифровки, Результат, СтрокаРасшифровки);
		КонецЕсли;
		
		Результат.Вывести(ОбластьРазделитель);
	КонецЕсли;

	
#КонецОбласти

#Область БиржевойИндекс

	Если СоставРасшифровки.Свойство("БиржевойИндекс") Тогда
		
		ОбластьГруппировка.Параметры.Имя = "Биржевой индекс";
		Результат.Вывести(ОбластьГруппировка);
		Результат.НачатьГруппуСтрок(, Ложь);

		ВывестиОбласть("БиржевойИндекс", МакетРасшифровки, Результат, СтрокаРасшифровки);
		
		Если СтрокаРасшифровки.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ПересчитатьПоРыночнойСтавке Тогда
			ВывестиОбласть("МетодРасчетаДепозита", МакетРасшифровки, Результат, СтрокаРасшифровки);
		КонецЕсли;
		
		Результат.Вывести(ОбластьРазделитель);
	КонецЕсли;

	
#КонецОбласти

#Область РасчетПоМетодикеКлиента
	Если СоставРасшифровки.Свойство("РасчетПоМетодикеКлиента") И ЗначениеЗаполнено(СтрокаРасшифровки.АдресРасшифровкиРасчетПоМетодикеКлиента) Тогда
	
		ПараметрыРасшифровкиРасчетаПоМетодикеКлиента = ПолучитьИзВременногоХранилища(СтрокаРасшифровки.АдресРасшифровкиРасчетПоМетодикеКлиента);
		Если ТипЗнч(ПараметрыРасшифровкиРасчетаПоМетодикеКлиента) = Тип("Структура") Тогда
			
			ВывестиОбласть("Группировка",	МакетРасшифровки, Результат, Новый Структура("Имя", "Проверка на рыночность"));
			Если ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.Свойство("Операции") Тогда
				ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент( , , , Результат);
				ПараметрыВывода.Вставить("СобственныйФорматСтрок", Истина);
				
				РаботаСДокументами.СформироватьРасшифровкуОперации(ПараметрыРасшифровкиРасчетаПоМетодикеКлиента, ПараметрыВывода);
			КонецЕсли;	
			ВывестиОбласть("Показатель",	МакетРасшифровки, Результат, Новый Структура("Имя, Значение", "Рейтинговая группа",	ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.РейтинговаяГруппа));
			
			Если ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.Свойство("ПредыдущееЗначениеИндекса") Тогда
				ВывестиОбласть("Показатель",	МакетРасшифровки, Результат, Новый Структура("Имя, Значение", СтрШаблон("%1t-1 (%2)", ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.Индикатор, Формат(ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.ПредыдущийДеньБиржевогоИндекса, "ДФ=dd.MM.yyyy")), ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.ПредыдущееЗначениеИндекса));
			КонецЕсли;
			
			Если ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.Свойство("ТекущееЗначениеИндекса") Тогда
				ВывестиОбласть("Показатель",	МакетРасшифровки, Результат, Новый Структура("Имя, Значение", СтрШаблон("%1", ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.Индикатор), ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.ТекущееЗначениеИндекса));
			КонецЕсли;
			
			Если ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.Свойство("Спред") Тогда
				ВывестиОбласть("Показатель",	МакетРасшифровки, Результат, Новый Структура("Имя, Значение", "spread",   ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.Спред));
			КонецЕсли;
			
			Если ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.Свойство("КредитныеСпреды") Тогда
				Для Каждого КредитныйСпред Из ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.КредитныеСпреды Цикл 
					ВывестиОбласть("Показатель", МакетРасшифровки, Результат, Новый Структура("Имя, Значение", КредитныйСпред.Представление, КредитныйСпред.Значение));
				КонецЦикла;
			КонецЕсли;

			Результат.Вывести(ОбластьРазделитель);
			
			ВывестиОбласть("ГруппировкаИЗначение", МакетРасшифровки, Результат, Новый Структура("Имя, Значение", "Нижняя граница - мин. значение между ставками ", ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.НижняяГраница));
			
			Для Каждого ФормулаНижнейГраницы Из ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.ФормулыНижнейГраницы Цикл 
				ВывестиОбласть("Показатель", МакетРасшифровки, Результат, Новый Структура("Имя, Значение", ФормулаНижнейГраницы.Представление, ФормулаНижнейГраницы.Значение));
			КонецЦикла;
			
			Результат.Вывести(ОбластьРазделитель);
			
			ВывестиОбласть("ГруппировкаИЗначение", МакетРасшифровки, Результат, Новый Структура("Имя, Значение", "Верхняя граница - макс. значение между ставками ", ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.ВерхняяГраница));
			
			Для Каждого ФормулаВерхнейГраницы Из ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.ФормулыВерхнейГраницы Цикл 
				ВывестиОбласть("Показатель", МакетРасшифровки, Результат, Новый Структура("Имя, Значение", ФормулаВерхнейГраницы.Представление, ФормулаВерхнейГраницы.Значение));
			КонецЦикла;
			
			Если ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.ФормулыСреднерыночнойСтавки.Количество() Тогда
				Результат.Вывести(ОбластьРазделитель);
				ВывестиОбласть("ГруппировкаИЗначение", МакетРасшифровки, Результат, Новый Структура("Имя, Значение", "Рыночная ставка ", ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.СреднерыночнаяСтавка));
				
				Для Каждого ФормулыСреднерыночнойСтавки Из ПараметрыРасшифровкиРасчетаПоМетодикеКлиента.ФормулыСреднерыночнойСтавки Цикл 
					ВывестиОбласть("Показатель", МакетРасшифровки, Результат, Новый Структура("Имя, Значение", ФормулыСреднерыночнойСтавки.Представление, ФормулыСреднерыночнойСтавки.Значение));
				КонецЦикла;
			КонецЕсли;
			
			Результат.Вывести(ОбластьРазделитель);
		КонецЕсли;	
		
	КонецЕсли;
#КонецОбласти

#Область ГраницыРыночнойСтавки
	Если СоставРасшифровки.Свойство("ГраницыРыночнойСтавки") Тогда
		
		ОбластьГруппировка.Параметры.Имя = "Границы рыночной ставки";
		Результат.Вывести(ОбластьГруппировка);
		
		Если ЗначениеЗаполнено(СтрокаРасшифровки.ВариантОтклоненияОтРыночнойСтавки) Тогда
			ВывестиОбласть("ВариантОтклонения", МакетРасшифровки, Результат, СтрокаРасшифровки);
		КонецЕсли;
		
		ОбластьОтклонение = МакетРасшифровки.ПолучитьОбласть("Отклонение");
		
		Если СтрокаРасшифровки.ВариантОтклоненияОтРыночнойСтавки = Перечисления.ВариантыОтклоненияОтРыночнойСтавкиПоДепозитнымВкладам.Фиксированный Тогда
			ЗаполнитьЗначенияСвойств(ОбластьОтклонение.Параметры, СтрокаРасшифровки);
			Результат.Вывести(ОбластьОтклонение);
			
		ИначеЕсли СтрокаРасшифровки.ВариантОтклоненияОтРыночнойСтавки = Перечисления.ВариантыОтклоненияОтРыночнойСтавкиПоДепозитнымВкладам.КоэффициентВолатильностиРычнонойСтавки Тогда
			
			Результат.НачатьГруппуСтрок(, Ложь);
			
			ВывестиОбласть("ШапкаСредневзвешенныеСтавкиKV", МакетРасшифровки, Результат, СтрокаРасшифровки);
			
			СреднерыночныеСтавки = ПолучитьИзВременногоХранилища(СтрокаРасшифровки.АдресРасшифровкиВариантаОтклоненияОтРыночнойСтавки);
			СреднерыночныеСтавки.Сортировать("ПериодСреднерыночнойСтавки");
			
			НайденныеСтроки	= СреднерыночныеСтавки.НайтиСтроки(Новый Структура("Актив", Актив));
			Для Каждого СтрокаСреднеРыночнойСтавки Из НайденныеСтроки Цикл
				Если ТипЗнч(СтрокаРасшифровки.ВидСредневзвешеннойРыночнойСтавки) = Тип("СправочникСсылка.БиржевыеИндексы") Тогда
					ВывестиОбласть("СтрокаБиржевыеИндексыKV", МакетРасшифровки, Результат, СтрокаСреднеРыночнойСтавки);
				Иначе
					ВывестиОбласть("СтрокаСредневзвешенныеСтавкиKV", МакетРасшифровки, Результат, СтрокаСреднеРыночнойСтавки);
				КонецЕсли;
			КонецЦикла;
			
			ВывестиОбласть("КоэффициентыВолатильностиРычнонойСтавки", МакетРасшифровки, Результат, СтрокаРасшифровки);
			
			Результат.Вывести(ОбластьРазделитель);
			Результат.ЗакончитьГруппуСтрок();
			
			ОбластьОтклонение.Параметры.ПроцентСущественностиОтклоненияОтРыночнойСтавки = СтрокаРасшифровки.КоэффициентыВолатильностиРычнонойСтавки;
			Результат.Вывести(ОбластьОтклонение);
			
		ИначеЕсли СтрокаРасшифровки.ВариантОтклоненияОтРыночнойСтавки = Перечисления.ВариантыОтклоненияОтРыночнойСтавкиПоДепозитнымВкладам.СтандартноеОтклонениеПоГенеральнойСовокупности Тогда
			
			Результат.НачатьГруппуСтрок(, Ложь);

			ВывестиОбласть("ШапкаСредневзвешенныеСтавкиСтандартноеОтклонение", МакетРасшифровки, Результат, СтрокаРасшифровки);
			
			ПараметрыСтандартноеОтклонение = Новый Структура("КоэффициентыВолатильностиРычнонойСтавки, СмещениеСтандартногоОтклонения, СредняяПроцентнаяСтавка,СуммаКвадратовСтавок", 
																СтрокаРасшифровки.КоэффициентыВолатильностиРычнонойСтавки,
																СтрокаРасшифровки.СмещениеСтандартногоОтклонения, 0, 0);
			
			СреднерыночныеСтавки = ПолучитьИзВременногоХранилища(СтрокаРасшифровки.АдресРасшифровкиВариантаОтклоненияОтРыночнойСтавки);
			СреднерыночныеСтавки.Сортировать("ПериодСреднерыночнойСтавки");
			
			НайденныеСтроки	= СреднерыночныеСтавки.НайтиСтроки(Новый Структура("Актив", Актив));
			Для Каждого СтрокаСреднеРыночнойСтавки Из НайденныеСтроки Цикл
				ПараметрыСтандартноеОтклонение.СредняяПроцентнаяСтавка	= ПараметрыСтандартноеОтклонение.СредняяПроцентнаяСтавка	+ СтрокаСреднеРыночнойСтавки.ПроцентнаяСтавка;
				ПараметрыСтандартноеОтклонение.СуммаКвадратовСтавок		= ПараметрыСтандартноеОтклонение.СуммаКвадратовСтавок		+ СтрокаСреднеРыночнойСтавки.КвадратРазницыСтавок;
				
				Если ТипЗнч(СтрокаРасшифровки.ВидСредневзвешеннойРыночнойСтавки) = Тип("СправочникСсылка.БиржевыеИндексы") Тогда
					ВывестиОбласть("СтрокаБиржевыеИндексыСтандартноеОтклонение", МакетРасшифровки, Результат, СтрокаСреднеРыночнойСтавки);
				Иначе
					ВывестиОбласть("СтрокаСредневзвешенныеСтавкиСтандартноеОтклонение", МакетРасшифровки, Результат, СтрокаСреднеРыночнойСтавки);
				КонецЕсли;
			КонецЦикла;
			
			ПараметрыСтандартноеОтклонение.СредняяПроцентнаяСтавка = ПараметрыСтандартноеОтклонение.СредняяПроцентнаяСтавка / НайденныеСтроки.Количество();
			
			ВывестиОбласть("СтандартноеОтклонение", МакетРасшифровки, Результат, ПараметрыСтандартноеОтклонение);
			
			Результат.Вывести(ОбластьРазделитель);
			Результат.ЗакончитьГруппуСтрок();
			
			ОбластьОтклонение.Параметры.ПроцентСущественностиОтклоненияОтРыночнойСтавки = СтрокаРасшифровки.КоэффициентыВолатильностиРычнонойСтавки;
			Результат.Вывести(ОбластьОтклонение);
			
		ИначеЕсли СтрокаРасшифровки.ВариантОтклоненияОтРыночнойСтавки = Перечисления.ВариантыОтклоненияОтРыночнойСтавкиПоДепозитнымВкладам.КриваяБезрисковойДоходности Тогда
			
			Результат.НачатьГруппуСтрок(, Ложь);
			
			ВывестиОбласть("КБД", МакетРасшифровки, Результат, СтрокаРасшифровки);
			Результат.Вывести(ОбластьРазделитель);
			
			Результат.ЗакончитьГруппуСтрок();
	
		КонецЕсли;

		ВывестиОбласть("ГраницыРыночнойСтавки", МакетРасшифровки, Результат, СтрокаРасшифровки);
		Результат.Вывести(ОбластьРазделитель);
		
	КонецЕсли;	
#КонецОбласти

#Область СтавкиПоАктивуИМетодРасчета

	Если СоставРасшифровки.Свойство("СтавкиПоАктивуИМетодРасчета") Тогда

		ОбластьГруппировка.Параметры.Имя = "Итоговые ставки и метод расчёта";
		Результат.Вывести(ОбластьГруппировка);
		
		ПараметрыЗаполненияИтоговыхСтавок = Новый Структура("ФактическаяЭСП, Рыночная, ИспользованаФактическаяЭСП, ИспользованаРыночнаяСтавка", 0, 0, Ложь, Ложь);

		ПараметрыЗаполненияИтоговыхСтавок.Вставить("СтавкаПоДоговору"				, СтрокаРасшифровки.СтавкаПоДоговору);
		ПараметрыЗаполненияИтоговыхСтавок.Вставить("ИспользованаСтавкаПоДоговору"	, СтрокаРасшифровки.СтавкаПоДоговору = СтрокаРасшифровки.ПроцентПоАктиву);
		
		ВывестиОбласть("СтавкаПоДоговору", МакетРасшифровки, Результат, ПараметрыЗаполненияИтоговыхСтавок);

		Если СтрокаРасшифровки.УчетныйАктив <> Справочники.УчетныеАктивыЕПС.ДепозитныеВкладыПоСС Тогда
			ПараметрыЗаполненияИтоговыхСтавок.Вставить("ФактическаяЭСП", ПолучитьСтавкуЭСПАктива(СтрокаРасшифровки, Период, СтрокаРасшифровки.ТочностьЭСП));
			
			Если СтрокаРасшифровки.ТочностьЭСП = 0 Тогда
				ПараметрыЗаполненияИтоговыхСтавок.Вставить("ИспользованаФактическаяЭСП"	, НЕ ПараметрыЗаполненияИтоговыхСтавок.ИспользованаСтавкаПоДоговору И ОКР(ПараметрыЗаполненияИтоговыхСтавок.ФактическаяЭСП, 9) = ОКР(СтрокаРасшифровки.ПроцентПоАктиву, 9));	
				ПараметрыЗаполненияИтоговыхСтавок.Вставить("ФактическаяЭСП"				, ОКР(ПараметрыЗаполненияИтоговыхСтавок.ФактическаяЭСП, 12));
			Иначе
				ПараметрыЗаполненияИтоговыхСтавок.Вставить("ИспользованаФактическаяЭСП"	, НЕ ПараметрыЗаполненияИтоговыхСтавок.ИспользованаСтавкаПоДоговору И ОКР(ПараметрыЗаполненияИтоговыхСтавок.ФактическаяЭСП, МИН(9, СтрокаРасшифровки.ТочностьЭСП)) = ОКР(СтрокаРасшифровки.ПроцентПоАктиву, СтрокаРасшифровки.ТочностьЭСП));
			КонецЕсли;	
				
			ВывестиОбласть("ФактическаяЭСП", МакетРасшифровки, Результат, ПараметрыЗаполненияИтоговыхСтавок);
		КонецЕсли;
		
		Если СоставРасшифровки.Свойство("РыночнаяСтавка")
		 ИЛИ СоставРасшифровки.Свойство("КлючеваяВКачествеРыночной")
		 ИЛИ СоставРасшифровки.Свойство("РасчетПоМетодикеКлиента") Тогда
			ПараметрыЗаполненияИтоговыхСтавок.Вставить("ИспользованаРыночнаяСтавка", НЕ ПараметрыЗаполненияИтоговыхСтавок.ИспользованаСтавкаПоДоговору И НЕ ПараметрыЗаполненияИтоговыхСтавок.ИспользованаФактическаяЭСП);
			
			Если НЕ ПараметрыЗаполненияИтоговыхСтавок.ИспользованаРыночнаяСтавка 
			 ИЛИ СтрокаРасшифровки.ПроцентПоАктиву = СтрокаРасшифровки.СреднерыночнаяСтавка Тогда
				ПараметрыЗаполненияИтоговыхСтавок.Вставить("Рыночная", СтрокаРасшифровки.СреднерыночнаяСтавка);
				
			ИначеЕсли СтрокаРасшифровки.ПроцентПоАктиву = СтрокаРасшифровки.НижняяГраницаСреднерыночнойСтавки Тогда
				ПараметрыЗаполненияИтоговыхСтавок.Вставить("Рыночная", СтрокаРасшифровки.НижняяГраницаСреднерыночнойСтавки);
				
			ИначеЕсли СтрокаРасшифровки.ПроцентПоАктиву = СтрокаРасшифровки.ВерхняяГраницаСреднерыночнойСтавки Тогда
				ПараметрыЗаполненияИтоговыхСтавок.Вставить("Рыночная", СтрокаРасшифровки.ВерхняяГраницаСреднерыночнойСтавки);
				
			КонецЕсли;
			
			ВывестиОбласть("ИспользованнаяРыночнаяСтавка", МакетРасшифровки, Результат, ПараметрыЗаполненияИтоговыхСтавок);

		КонецЕсли;
		
		ВывестиОбласть("МетодРасчетаДепозита", МакетРасшифровки, Результат, СтрокаРасшифровки);
		Результат.Вывести(ОбластьРазделитель);
		
	КонецЕсли;
#КонецОбласти

#Область СтоимостьАктива

	ОбластьГруппировка.Параметры.Имя = "Стоимость актива";
	Результат.Вывести(ОбластьГруппировка);

	ПараметрыВыводаСтоимости = Новый Структура("Номинал, Проценты, ПроцентыЭСП, Комиссия, СуммаРезерва");
	
	ЗаполнитьЗначенияСвойств(ПараметрыВыводаСтоимости, СтрокаРасшифровки);

	ПараметрыВыводаСтоимости.Вставить("ИтогоПроценты"	, СтрокаРасшифровки.Проценты + СтрокаРасшифровки.ПроцентыЭСП);
	
	Если СтрокаРасшифровки.ПроцентыЭСП = 0 Тогда
		ВывестиОбласть("ЛинейнаяСтоимость", МакетРасшифровки, Результат, ПараметрыВыводаСтоимости);
	Иначе	
		ВывестиОбласть("СтоимостьПоЭСП", МакетРасшифровки, Результат, ПараметрыВыводаСтоимости);
	КонецЕсли;
	
	Если СтрокаРасшифровки.СуммаРезерва <> 0 Тогда
		ВывестиОбласть("Обесценение", МакетРасшифровки, Результат, ПараметрыВыводаСтоимости);
	КонецЕсли;
	
	Если СтрокаРасшифровки.Комиссия <> 0 Тогда
		ВывестиОбласть("Комиссия", МакетРасшифровки, Результат, ПараметрыВыводаСтоимости);
	КонецЕсли;
	
	ПараметрыВыводаСтоимости.Вставить("ИтогоСумма"		, СтрокаРасшифровки.Номинал + СтрокаРасшифровки.Проценты + СтрокаРасшифровки.ПроцентыЭСП + СтрокаРасшифровки.СуммаРезерва + СтрокаРасшифровки.Комиссия);
	
	ВывестиОбласть("ИтогоСумма", МакетРасшифровки, Результат, ПараметрыВыводаСтоимости);
	
	Результат.Вывести(ОбластьРазделитель);

#КонецОбласти

	Возврат Результат;
	
КонецФункции

Процедура ВывестиОбласть(ИмяОбласти, Макет, Результат, ИсточникДанных = Неопределено)
	
	Область = Макет.ПолучитьОбласть(ИмяОбласти);
	
	Если ИсточникДанных <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Область.Параметры, ИсточникДанных);
	КонецЕсли;
	
	Результат.Вывести(Область);
	
КонецПроцедуры

Функция ПолучитьПараметрыАктива(Актив, Период)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Актив"	, Актив);
	Запрос.УстановитьПараметр("Период"	, Период);
	Запрос.УстановитьПараметр("ГраницаПериода", Новый Граница(Период, ВидГраницы.Включая));

	Если ТипЗнч(Актив) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	БанковскиеСчета.Валюта КАК Валюта,
			|	НоминалыКредитныхИнструментовСрезПоследних.Сумма КАК Сумма,
			|	УсловияКредитныхИнструментовСрезПоследних.Процент КАК Процент,
			|	ДепозитныеВклады.ДатаРегистрации КАК ДатаРазмещения,
			|	ДепозитныеВклады.ДатаНачалаНачисленияПроцентов КАК ДатаНачалаНачисленияПроцентов,
			|	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
			|	РАЗНОСТЬДАТ(ДепозитныеВклады.ДатаРегистрации, УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения, ДЕНЬ) КАК КоличествоДнейВклада,
			|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&Период, ДЕНЬ), УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения, ДЕНЬ) КАК ДнейДоПогашения,
			|	""Размещение"" КАК Тип
			|ИЗ
			|	Справочник.ДепозитныеВклады КАК ДепозитныеВклады
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
			|				&Период,
			|				ДатаНачалаДействияУсловий <= &Период
			|					И КредитныйИнструмент = &Актив) КАК УсловияКредитныхИнструментовСрезПоследних
			|		ПО ДепозитныеВклады.Ссылка = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
			|		ПО ДепозитныеВклады.БанковскийСчет = БанковскиеСчета.Ссылка
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыКредитныхИнструментов.СрезПоследних(&Период, КредитныйИнструмент = &Актив) КАК НоминалыКредитныхИнструментовСрезПоследних
			|		ПО ДепозитныеВклады.Ссылка = НоминалыКредитныхИнструментовСрезПоследних.КредитныйИнструмент
			|ГДЕ
			|	ДепозитныеВклады.Ссылка = &Актив
			|
			|УПОРЯДОЧИТЬ ПО
			|	УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий УБЫВ";
		
	ИначеЕсли ТипЗнч(Актив) = Тип("СправочникСсылка.Займы") Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	Займы.Валюта КАК Валюта,
			|	НоминалыКредитныхИнструментовСрезПоследних.Сумма КАК Сумма,
			|	УсловияКредитныхИнструментовСрезПоследних.Процент КАК Процент,
			|	Займы.ДатаЗаключения КАК ДатаРазмещения,
			|	УсловияКредитныхИнструментовСрезПоследних.Контрагент КАК Контрагент,
			|	Займы.ВидКредитногоИнструмента КАК ВидКредитногоИнструмента,
			|	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
			|	РАЗНОСТЬДАТ(Займы.ДатаЗаключения, УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения, ДЕНЬ) КАК КоличествоДнейВклада,
			|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&Период, ДЕНЬ), УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения, ДЕНЬ) КАК ДнейДоПогашения,
			|	""Размещение"" КАК Тип
			|ИЗ
			|	Справочник.Займы КАК Займы
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
			|				&Период,
			|				ДатаНачалаДействияУсловий <= &Период
			|					И КредитныйИнструмент = &Актив) КАК УсловияКредитныхИнструментовСрезПоследних
			|		ПО Займы.Ссылка = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыКредитныхИнструментов.СрезПоследних(&Период, КредитныйИнструмент = &Актив) КАК НоминалыКредитныхИнструментовСрезПоследних
			|		ПО Займы.Ссылка = НоминалыКредитныхИнструментовСрезПоследних.КредитныйИнструмент
			|ГДЕ
			|	Займы.Ссылка = &Актив
			|
			|УПОРЯДОЧИТЬ ПО
			|	УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий УБЫВ";
		
	ИначеЕсли ТипЗнч(Актив) = Тип("ДокументСсылка.МНО") Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БанковскиеСчета.Валюта КАК Валюта,
			|	МНО.Сумма КАК Сумма,
			|	МНО.Процент КАК Процент,
			|	МНО.Дата КАК ДатаРазмещения,
			|	МНО.ДатаВозврата КАК ДатаВозврата,
			|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(МНО.Дата, ДЕНЬ), МНО.ДатаВозврата, ДЕНЬ) КАК КоличествоДнейМНО,
			|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&Период, ДЕНЬ), МНО.ДатаВозврата, ДЕНЬ) КАК ДнейДоПогашения,
			|	""Размещение"" КАК Тип
			|ИЗ
			|	Документ.МНО КАК МНО
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
			|		ПО МНО.РасчетныйСчет = БанковскиеСчета.Ссылка
			|ГДЕ
			|	МНО.Ссылка = &Актив";
		
	ИначеЕсли ТипЗнч(Актив) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	УсловияСделокРЕПО1.СделкаРЕПО.ВидСделки КАК ВидСделки,
			|	УсловияСделокРЕПО1.СделкаРЕПО.ВалютаСделки КАК Валюта,
			|	УсловияСделокРЕПО1.СделкаРЕПО.Дата КАК Дата,
			|	МИНИМУМ(УсловияСделокРЕПО1.ДатаОплаты) КАК ДатаРазмещения,
			|	СУММА(УсловияСделокРЕПО1.Сумма + УсловияСделокРЕПО1.СуммаКупона) КАК Сумма,
			|	МИНИМУМ(УсловияСделокРЕПО2.ДатаОплаты) КАК ДатаОплатыВторойЧасти,
			|	СУММА(УсловияСделокРЕПО2.Сумма + УсловияСделокРЕПО2.СуммаКупона) КАК СуммаВторойЧасти,
			|	""Оплата первой части"" КАК Тип,
			|	УсловияСделокРЕПО2.СтавкаРЕПО КАК СтавкаРЕПО
			|ИЗ
			|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
			|			&Период,
			|			СделкаРЕПО = &Актив
			|				И ЧастьСделкиРЕПО = 1) КАК УсловияСделокРЕПО1
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
			|				&Период,
			|				СделкаРЕПО = &Актив
			|					И ЧастьСделкиРЕПО = 2) КАК УсловияСделокРЕПО2
			|		ПО УсловияСделокРЕПО1.Организация = УсловияСделокРЕПО2.Организация
			|			И УсловияСделокРЕПО1.СделкаРЕПО = УсловияСделокРЕПО2.СделкаРЕПО
			|			И УсловияСделокРЕПО1.Рынок = УсловияСделокРЕПО2.Рынок
			|			И УсловияСделокРЕПО1.ЦеннаяБумага = УсловияСделокРЕПО2.ЦеннаяБумага
			|
			|СГРУППИРОВАТЬ ПО
			|	УсловияСделокРЕПО1.СделкаРЕПО.ВидСделки,
			|	УсловияСделокРЕПО1.СделкаРЕПО.ВалютаСделки,
			|	УсловияСделокРЕПО1.СделкаРЕПО.Дата,
			|	УсловияСделокРЕПО2.СтавкаРЕПО";
		
	ИначеЕсли ТипЗнч(Актив) = Тип("ДокументСсылка.Сделка") Тогда	
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	УсловияСделокСрезПоследних.ВалютаОплаты КАК Валюта,
			|	ВЫБОР
			|		КОГДА ВложенныйЗапрос.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|			ТОГДА ВложенныйЗапрос.Сумма
			|		ИНАЧЕ -ВложенныйЗапрос.Сумма
			|	КОНЕЦ КАК Сумма,
			|	ВЫБОР
			|		КОГДА ВложенныйЗапрос.Сумма > 0
			|			ТОГДА УсловияСделокСрезПоследних.ДатаОплаты
			|		ИНАЧЕ УсловияСделокСрезПоследних.ДатаПоставки
			|	КОНЕЦ КАК ДатаПогашения,
			|	""Погашение"" КАК Тип
			|ИЗ
			|	(ВЫБРАТЬ
			|		ВложенныйЗапрос.Основание КАК Основание,
			|		ВложенныйЗапрос.ТипЗадолженности КАК ТипЗадолженности,
			|		СУММА(ВложенныйЗапрос.Сумма) КАК Сумма
			|	ИЗ
			|		(ВЫБРАТЬ
			|			ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
			|			ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
			|			ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК Сумма
			|		ИЗ
			|			РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
			|					&ГраницаПериода,
			|					Основание = &Актив
			|						И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)) КАК ЗадолженностиПоДенежнымСредствамОстатки
			|		
			|		ОБЪЕДИНИТЬ ВСЕ
			|		
			|		ВЫБРАТЬ
			|			ЗадолженностиПоЦеннымБумагамОстатки.Основание,
			|			ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности,
			|			-ЗадолженностиПоЦеннымБумагамОстатки.СуммаОстаток - ЗадолженностиПоЦеннымБумагамОстатки.СуммаКупонаОстаток
			|		ИЗ
			|			РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
			|					&ГраницаПериода,
			|					Основание = &Актив
			|						И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)) КАК ЗадолженностиПоЦеннымБумагамОстатки) КАК ВложенныйЗапрос
			|	
			|	СГРУППИРОВАТЬ ПО
			|		ВложенныйЗапрос.Основание,
			|		ВложенныйЗапрос.ТипЗадолженности) КАК ВложенныйЗапрос
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделок.СрезПоследних(&Период, Сделка = &Актив) КАК УсловияСделокСрезПоследних
			|		ПО ВложенныйЗапрос.Основание = УсловияСделокСрезПоследних.Сделка";
		
	ИначеЕсли ТипЗнч(Актив) = Тип("ДокументСсылка.СделкаСНедвижимостью") Тогда	
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СделкаСНедвижимостью.Ссылка.Контрагент КАК Контрагент,
			|	СделкаСНедвижимостью.Ссылка.Договор КАК Договор,
			|	СделкаСНедвижимостью.Ссылка.ВидПраваНаНедвижимость КАК ВидПраваНаНедвижимость,
			|	СделкаСНедвижимостью.Ссылка.ВидСделки КАК ВидСделки,
			|	СУММА(УсловияСделокСНедвижимостьюСрезПоследних.Сумма) КАК Сумма,
			|	МАКСИМУМ(УсловияСделокСНедвижимостьюСрезПоследних.ПлановаяДатаПередачи) КАК ПлановаяДатаПередачи
			|ИЗ
			|	РегистрСведений.УсловияСделокСНедвижимостью.СрезПоследних(&Период, Основание = &Актив) КАК УсловияСделокСНедвижимостьюСрезПоследних
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаСНедвижимостью КАК СделкаСНедвижимостью
			|		ПО (НЕ УсловияСделокСНедвижимостьюСрезПоследних.Отменено)
			|			И УсловияСделокСНедвижимостьюСрезПоследних.Основание = СделкаСНедвижимостью.Ссылка
			|
			|СГРУППИРОВАТЬ ПО
			|	СделкаСНедвижимостью.Ссылка.Контрагент,
			|	СделкаСНедвижимостью.Ссылка.Договор,
			|	СделкаСНедвижимостью.Ссылка.ВидПраваНаНедвижимость,
			|	СделкаСНедвижимостью.Ссылка.ВидСделки";
	КонецЕсли;
	
	ПараметрыАктива = Новый Структура;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Для Каждого Колонка ИЗ РезультатЗапроса.Колонки Цикл
		ПараметрыАктива.Вставить(Колонка.Имя);
	КонецЦикла;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ПараметрыАктива, Выборка);
	КонецЦикла;
	
	Возврат ПараметрыАктива;
	
КонецФункции

Функция КлючевыеСтавкиЗаМесяц(Период, ПериодСреднерыночнойСтавки)
	
	Запрос = Новый Запрос;	

	#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _Даты
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(ДанныеКалендаря.Дата, МЕСЯЦ) = НАЧАЛОПЕРИОДА(&ПериодСреднерыночнойСтавки, МЕСЯЦ)
		|	И ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Дата КАК Период,
		|	ПроцентныеПоказатели.ЗначениеПоказателя КАК Ставка
		|ИЗ
		|	(ВЫБРАТЬ
		|		_Даты.Дата КАК Дата,
		|		МАКСИМУМ(ПроцентныеПоказатели.ДатаЗначения) КАК ПериодКлючевой
		|	ИЗ
		|		_Даты КАК _Даты
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПроцентныеПоказатели.СрезПоследних(
		|					&Период,
		|					Показатель = ЗНАЧЕНИЕ(Перечисление.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ)
		|						И Прогноз = ЛОЖЬ) КАК ПроцентныеПоказатели
		|			ПО _Даты.Дата >= ПроцентныеПоказатели.ДатаЗначения
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_Даты.Дата) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПроцентныеПоказатели.СрезПоследних(
		|				&Период,
		|				Показатель = ЗНАЧЕНИЕ(Перечисление.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ)
		|					И Прогноз = ЛОЖЬ) КАК ПроцентныеПоказатели
		|		ПО ВложенныйЗапрос.ПериодКлючевой = ПроцентныеПоказатели.ДатаЗначения
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";
	
#КонецОбласти

	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ПериодСреднерыночнойСтавки", ПериодСреднерыночнойСтавки);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти

#Область СтоимостьПоРыночнойСтавке_ДополнительныеФункции

Процедура РассчитатьБезрисковуюСтавкуДоходностиПоДепозиту(СтрокаДепозиты, Период, СчетДоверительногоУправления, ПараметрыОценки)

	СтрокаДепозиты.БезрисковаяСтавкаДоходности = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьНоминальнуюБезрисковуюСтавкуДоходности(СтрокаДепозиты.Актив, Период, , Ложь), СтрокаДепозиты.ТочностьРыночнойСтавки);
	
	ПараметрыРасчетаРейтинга = Новый Структура;
	ПараметрыРасчетаРейтинга.Вставить("ИсточникТаблицыСоответствияРейтингов",	СтрокаДепозиты.ИсточникТаблицыСоответствияРейтингов);
	ПараметрыРасчетаРейтинга.Вставить("ТолькоНаблюдаемыеДанные",				Истина);
	ПараметрыРасчетаРейтинга.Вставить("ТолькоЭмитент",							Истина);

	ПараметрыРасчетаКредитногоСпреда = РаботаСПереоценкой.ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, Период);
	ПараметрыРасчетаКредитногоСпреда.Вставить("ОтклонениеКредитногоСпреда", СтрокаДепозиты.ОтклонениеКредитногоСпреда);
	
	КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(СтрокаДепозиты.Актив, Период, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, Ложь); 
	
	Если КредитныйСпред.Количество() > 0 Тогда
		СтрокаДепозиты.Медиана					= ОКР(КредитныйСпред[0].Медиана, 2);
		СтрокаДепозиты.МинимумКредитногоСпреда	= ОКР(КредитныйСпред[0].МинимумКредитногоСпреда, 2);
		СтрокаДепозиты.МаксимумКредитногоСпреда	= ОКР(КредитныйСпред[0].МаксимумКредитногоСпреда, 2);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определен диапазон кредитного спреда для депозита " + СтрокаДепозиты.Актив);
	КонецЕсли;
	
	СтрокаДепозиты.СреднерыночнаяСтавка					= СтрокаДепозиты.БезрисковаяСтавкаДоходности + СтрокаДепозиты.Медиана/100;
	СтрокаДепозиты.НижняяГраницаСреднерыночнойСтавки	= СтрокаДепозиты.БезрисковаяСтавкаДоходности + СтрокаДепозиты.МинимумКредитногоСпреда/100;
	СтрокаДепозиты.ВерхняяГраницаСреднерыночнойСтавки	= СтрокаДепозиты.БезрисковаяСтавкаДоходности + СтрокаДепозиты.МаксимумКредитногоСпреда/100;

КонецПроцедуры

Процедура РассчитатьСтандартноеОтклонениеПоГенеральнойСовокупности(СтрокаАктивы, СреднерыночныеСтавкиЗа12Месяцев, Знач КоличествоЗначений = 12, Смещение = 0, ВидСредневзвешеннойРыночнойСтавки, Отказ)
	
	Если НЕ ЗначениеЗаполнено(КоличествоЗначений) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неверно задан параметр КоличествоЗначений!",,,, Отказ);
	КонецЕсли;
	
	БиржевойИндекс = (ТипЗнч(ВидСредневзвешеннойРыночнойСтавки) = Тип("СправочникСсылка.БиржевыеИндексы"));
	
	ПараметрыПоиска = Новый Структура("Актив", СтрокаАктивы.Актив);
	НайденныеСтроки = СреднерыночныеСтавкиЗа12Месяцев.НайтиСтроки(ПараметрыПоиска);
	
	Если БиржевойИндекс Тогда //Для биржевых индексов период наблюдаемых значений не равен количеству значений
		КоличествоЗначений = НайденныеСтроки.Количество();
	Иначе
		Если НайденныеСтроки.Количество() <> КоличествоЗначений Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Невозможно рассчитать стандартное отклонение: из " + КоличествоЗначений + " ставок за последние " + КоличествоЗначений + " месяцев обнаружено только " + НайденныеСтроки.Количество());
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	КоличествоЗначений = 0;
	СредняяПроцентнаяСтавка = 0;
	
	Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаДанных.ПроцентнаяСтавка) Тогда
			ТекстСообщения = СтрШаблон("Ошибка в расчёте стандартного отклонения по активу %1: %2 %3 за %4 = 0",
										СтрокаАктивы.Актив,
										?(БиржевойИндекс, "доходность индекса ", "значение ставки "),
										ВидСредневзвешеннойРыночнойСтавки,
										Формат(СтрокаАктивы.ПериодСреднерыночнойСтавки, "ДФ=dd.MM.yyyy"));
										
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		Иначе	
			СредняяПроцентнаяСтавка = СредняяПроцентнаяСтавка + СтрокаДанных.ПроцентнаяСтавка;
			КоличествоЗначений = КоличествоЗначений + 1;
		КонецЕсли;
	КонецЦикла;
	
	СредняяПроцентнаяСтавка = СредняяПроцентнаяСтавка / КоличествоЗначений;
	
	СуммаКвадратовСтавок = 0;
	
	Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
		СтрокаДанных.КвадратРазницыСтавок = Pow(СтрокаДанных.ПроцентнаяСтавка - СредняяПроцентнаяСтавка, 2);
		СуммаКвадратовСтавок = СуммаКвадратовСтавок + Pow(СтрокаДанных.ПроцентнаяСтавка - СредняяПроцентнаяСтавка, 2);
	КонецЦикла;
	
	СтрокаАктивы.КоэффициентыВолатильностиРычнонойСтавки = ОКР(Sqrt(СуммаКвадратовСтавок / (КоличествоЗначений - Смещение)), 2);
	
	Если СтрокаАктивы.ПроцентСущественностиВПроцентныхПунктах Тогда
		СтрокаАктивы.НижняяГраницаСреднерыночнойСтавки	= СтрокаАктивы.СреднерыночнаяСтавка - СтрокаАктивы.КоэффициентыВолатильностиРычнонойСтавки;
		СтрокаАктивы.ВерхняяГраницаСреднерыночнойСтавки	= СтрокаАктивы.СреднерыночнаяСтавка + СтрокаАктивы.КоэффициентыВолатильностиРычнонойСтавки;
	Иначе
		СтрокаАктивы.НижняяГраницаСреднерыночнойСтавки	= СтрокаАктивы.СреднерыночнаяСтавка * (1 - СтрокаАктивы.КоэффициентыВолатильностиРычнонойСтавки);
		СтрокаАктивы.ВерхняяГраницаСреднерыночнойСтавки	= СтрокаАктивы.СреднерыночнаяСтавка * (1 + СтрокаАктивы.КоэффициентыВолатильностиРычнонойСтавки);
	КонецЕсли;
	
КонецПроцедуры

Функция РассчитатьСтоимостьАктиваПоСтавке(Ставка, Период, СтрокаАктивы, УчетныйАктив, РассчитыватьДисконтированныйПотокПоСтавкеЭСП, ТочностьЭСП, 
	РазрядностьОкругленияПромежуточныхРасчетовДепозитныхВкладов, Организация, СчетДоверительногоУправления, ВидыАктивовСОтдельнымиСтавкамиНаКаждыйПоток, ЦельРасчета, Отказ)
	
	Результат = Новый Структура("Стоимость, Обесценение", 0, 0);
	
	ДенежныйПоток = Неопределено;
	Если СтрокаАктивы.ЭтоДенежныйПоток Тогда
		
		ДенежныйПоток = Новый ТаблицаЗначений;
		ДенежныйПоток.Колонки.Добавить("Период"	, Новый ОписаниеТипов("Дата"));
		ДенежныйПоток.Колонки.Добавить("Сумма"	, Новый ОписаниеТипов("Число"));
		
		
		СтрокаДенежногоПотока = ДенежныйПоток.Добавить();
		СтрокаДенежногоПотока.Период = СтрокаАктивы.ДатаПогашения; 
		СтрокаДенежногоПотока.Сумма	 = СтрокаАктивы.Номинал + СтрокаАктивы.Проценты; 
		
	ИначеЕсли ВидыАктивовСОтдельнымиСтавкамиНаКаждыйПоток <> Неопределено 
		И НужныОтдельныеСтавкиПоПотокам(СчетДоверительногоУправления, СтрокаАктивы.Актив, СтрокаАктивы.ВидАктива, ВидыАктивовСОтдельнымиСтавкамиНаКаждыйПоток) Тогда
		
		Если СтрокаАктивы.ВидАктива = Перечисления.ВидыАктивовДляПроверкиНаРыночность.ЗаймыВыданные
			ИЛИ СтрокаАктивы.ВидАктива = Перечисления.ВидыАктивовДляПроверкиНаРыночность.ЗаймыПолученные Тогда
			
			//делаем рекурсию через ПолучитьСтоимостьКредитныхИнструментовПоРыночнойСтавке, передав туда разбитый на потоки актив.
			ПотокиПоАктиву = РаботаСКредитнымиИнструментами.ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправления(СчетДоверительногоУправления,Период,,,Ложь,,СтрокаАктивы.Актив,,Истина,ВидыАктивовСОтдельнымиСтавкамиНаКаждыйПоток);
			ПотокиПоАктивуПоРыночнойСтавке = РаботаСоСтоимостьюПоРыночнойСтавке.ПолучитьСтоимостьКредитныхИнструментовПоРыночнойСтавке(ПотокиПоАктиву,СчетДоверительногоУправления, Период, ЦельРасчета,, Отказ); 
			Если ПотокиПоАктивуПоРыночнойСтавке.Количество() = 1 Тогда
				Результат.Стоимость = ПотокиПоАктивуПоРыночнойСтавке[0].Номинал + ПотокиПоАктивуПоРыночнойСтавке[0].Проценты + ПотокиПоАктивуПоРыночнойСтавке[0].ПроцентыЭСП;				
				Результат.Обесценение = ПотокиПоАктивуПоРыночнойСтавке[0].СуммаРезерва;
				Результат.Вставить("АдресРасшифровкиДенежныхПотоков", ПотокиПоАктивуПоРыночнойСтавке[0].АдресРасшифровкиДенежныхПотоков);
				Возврат Результат;
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дисконтирование по собственным ставкам для каждого денежного потовка для актива вида "+СтрокаАктивы.ВидАктива+" не предусмотрено",,,,Отказ);
				Возврат Результат;
			КонецЕсли;
		ИначеЕсли (СтрокаАктивы.ВидАктива = Перечисления.ВидыАктивовДляПроверкиНаРыночность.КредиторскаяЗадолженность 
				ИЛИ СтрокаАктивы.ВидАктива = Перечисления.ВидыАктивовДляПроверкиНаРыночность.ДебиторскаяЗадолженность)
			И (ТипЗнч(СтрокаАктивы.Актив) = Тип("ДокументСсылка.СделкаСНедвижимостью")
				ИЛИ Справочники.Договоры.ЭтоИнвестконтракт(СтрокаАктивы.Актив)) Тогда
			
			ПотокиПоАктиву = ПолучитьПлановыеВыплатыПоАктиву(СчетДоверительногоУправления, СтрокаАктивы.Актив, Период);
			ПотокиПоАктиву.Колонки.Добавить("ВидАктива");
			ПотокиПоАктиву.ЗаполнитьЗначения(СтрокаАктивы.ВидАктива,"ВидАктива");
			
			РаботаСоСтоимостьюПоРыночнойСтавке.ПолучитьСтоимостьЗадолженностиПоРыночнойСтавке(ПотокиПоАктиву, СчетДоверительногоУправления, Период, ЦельРасчета, ,Отказ);
			Если ПотокиПоАктиву.Количество() = 1 Тогда
				Результат.Стоимость = ПотокиПоАктиву[0].Сумма + ПотокиПоАктиву[0].ПроцентыЭСП;				
				Результат.Обесценение = ПотокиПоАктиву[0].СуммаРезерва;
				Результат.Вставить("АдресРасшифровкиДенежныхПотоков", ПотокиПоАктиву[0].АдресРасшифровкиДенежныхПотоков);
				Возврат Результат;
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дисконтирование по собственным ставкам для каждого денежного потовка для актива вида "+СтрокаАктивы.ВидАктива+" не предусмотрено",,,,Отказ);
				Возврат Результат;
			КонецЕсли;
			
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дисконтирование по собственным ставкам для каждого денежного потовка для актива "+СтрокаАктивы.Актив+"("+СтрокаАктивы.ВидАктива+") вернуло некорректный результат!",,,,Отказ);
			Возврат Результат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если (СтрокаАктивы.ВидАктива = Перечисления.ВидыАктивовДляПроверкиНаРыночность.ДебиторскаяЗадолженность
		ИЛИ СтрокаАктивы.ВидАктива = Перечисления.ВидыАктивовДляПроверкиНаРыночность.КредиторскаяЗадолженность)
			И НЕ (ТипЗнч(СтрокаАктивы.Актив) = Тип("ДокументСсылка.СделкаСНедвижимостью")
				ИЛИ Справочники.Договоры.ЭтоИнвестконтракт(СтрокаАктивы.Актив)) Тогда
			
		КолДней = (НачалоДня(СтрокаАктивы.ДатаПогашения) - НачалоДня(Период)) / 86400; 
		
		Если КолДней > 0 Тогда
			
			Если ТипЗнч(СтрокаАктивы.Актив) = Тип("ДокументСсылка.Сделка") 
				И Период >= Дата(2022,11,16)
				И СтрокаАктивы.Актив = ОбщегоНазначения.ПолучитьИменованныйОбъект("Продажа_РПИ_160522_132387") Тогда
				
				//проверка: не должно быть оплат!
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЗадолженностиПоДенежнымСредствам.Регистратор КАК Регистратор
					|ИЗ
					|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
					|ГДЕ
					|	ЗадолженностиПоДенежнымСредствам.Основание = &Сделка
					|	И ЗадолженностиПоДенежнымСредствам.Организация = &Организация
					|	И ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = &СчетДоверительногоУправления
					|	И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
					|	И ЗадолженностиПоДенежнымСредствам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
					|	И ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
					|	И ЗадолженностиПоДенежнымСредствам.Сумма <> 0";
				
				Запрос.УстановитьПараметр("Организация", Организация);
				Запрос.УстановитьПараметр("Сделка", СтрокаАктивы.Актив);
				Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				
				Если ВыборкаДетальныеЗаписи.Следующий() Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для сделки Продажа_РПИ_160522_132387 обнаружены оплаты! Невозможно получить денежный поток по условиям сделки!",СтрокаАктивы.Актив,,, Отказ);
				КонецЕсли;
				
				Результат.Стоимость = (СтрокаАктивы.Номинал + СтрокаАктивы.Проценты) / Pow(1 + Окр(Ставка, ТочностьЭСП) / 100, КолДней / 365);
				
			ИначеЕсли СтрокаАктивы.Актив = ОбщегоНазначения.ПолучитьИменованныйОбъект("Продажа_РПИ_270624_18_2") Тогда
				
				Результат.Стоимость = (СтрокаАктивы.Номинал + СтрокаАктивы.Проценты) / Pow(1 + Окр(Ставка, ТочностьЭСП) / 100, КолДней / 365);
				
			Иначе		
				Результат.Стоимость = СтрокаАктивы.Номинал / Pow(1 + Окр(Ставка, ТочностьЭСП) / 100, КолДней / 365);
			КонецЕсли;
			
		КонецЕсли;
	
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДепозитныеВкладыПоСС Тогда
		ДепозитыЛинейно = РаботаСКредитнымиИнструментами.ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправления(СчетДоверительногоУправления, 
			Период,Перечисления.ТипыКредитныхИнструментов.ДепозитныйВклад,,,, СтрокаАктивы.Актив, Ставка);
		Результат.Стоимость = ДепозитыЛинейно[0].Номинал + ДепозитыЛинейно[0].Проценты;
		
	ИначеЕсли РассчитыватьДисконтированныйПотокПоСтавкеЭСП Тогда
		Ставка = ПолучитьСтавкуЭСПАктива(СтрокаАктивы, Период, ТочностьЭСП);
		
		Результат = ПолучитьДисконтированнуюСтоимостьАктива(Период,
														СтрокаАктивы.Актив,
														Ставка, 
														РазрядностьОкругленияПромежуточныхРасчетовДепозитныхВкладов, 
														Организация, 
														СчетДоверительногоУправления,
														ДенежныйПоток,
														Отказ);
	Иначе
		Результат = ПолучитьДисконтированнуюСтоимостьАктива(Период, 
														СтрокаАктивы.Актив, 
														Ставка, 
														РазрядностьОкругленияПромежуточныхРасчетовДепозитныхВкладов, 
														Организация, 
														СчетДоверительногоУправления,
														ДенежныйПоток,
														Отказ);

	КонецЕсли;
													
	Возврат Результат;												
	
КонецФункции

//Ставку ЭСП можно рассчитать только по депозитам, для остальных активов возвращаем ставку
Функция ПолучитьСтавкуЭСПАктива(СтрокаАктивы, Период, ТочностьЭСП)

	СтавкаЭСП = 0;
	
	Если ТипЗнч(СтрокаАктивы.Актив) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		СтавкаЭСП = Справочники.ДепозитныеВклады.ПолучитьДоходностьИДюрацию(СтрокаАктивы.Актив).Доходность;
	ИначеЕсли ТипЗнч(СтрокаАктивы.Актив) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		 СтавкаЭСП = РаботаСоСделкамиРЕПО.ПолучитьДоходностьИДюрациюПоСделкеРЕПО(СтрокаАктивы.Актив, Период, СтрокаАктивы.Номинал).Доходность;  
	ИначеЕсли ТипЗнч(СтрокаАктивы.Актив) = Тип("ДокументСсылка.МНО") Тогда
		 СтавкаЭСП = РаботаСМНО.ПолучитьДоходностьИДюрациюПоСделкеМНО(СтрокаАктивы.Актив, Период, СтрокаАктивы.Номинал).Доходность;  
	КонецЕсли;
	
	Если ТочностьЭСП = 0 Тогда
		Возврат СтавкаЭСП;
	Иначе
		Возврат Окр(СтавкаЭСП, ТочностьЭСП);
	КонецЕсли;
	
КонецФункции	

Функция ПолучитьПлановыеВыплатыПоАктиву(СчетДоверительногоУправления, Актив, Период)
	
	Если ТипЗнч(Актив) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		Возврат Актив.ПлановыеВыплаты.Выгрузить();
	ИначеЕсли ТипЗнч(Актив) = Тип("СправочникСсылка.Займы") Тогда
		Возврат РаботаСКредитнымиИнструментами.ПолучитьДенежныйПотокПоКредитномуИнструменту(СчетДоверительногоУправления, Актив, Период);
	ИначеЕсли ТипЗнч(Актив) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		Возврат РаботаСоСделкамиРЕПО.ПолучитьПлановыеВыплатыПоСделкеРЕПО(Актив, Период);
	ИначеЕсли ТипЗнч(Актив) = Тип("ДокументСсылка.МНО") Тогда
		Возврат РаботаСМНО.ПолучитьПлановыеВыплатыПоСделкеМНО(Актив, Период);
	ИначеЕсли ТипЗнч(Актив) = Тип("ДокументСсылка.СделкаСНедвижимостью") Тогда
		Возврат Документы.СделкаСНедвижимостью.ПолучитьПлановыеВыплатыПоСделкеСНедвижимостью(Актив, КонецДня(Период));
	ИначеЕсли ТипЗнч(Актив) = Тип("СправочникСсылка.Договоры") Тогда
		Возврат ПолучитьПлановыеВыплатыДоговоруСтроительства(СчетДоверительногоУправления, Актив, Период);
	Иначе
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;	
	
КонецФункции

Функция ПолучитьДисконтированнуюСтоимостьАктива(Период, Актив, ПроцентПоАктиву, РазрядностьОкругленияПромежуточныхРасчетовДепозитныхВкладов, 
	Организация, СчетДоверительногоУправления, ПлановыеВыплаты = Неопределено, Отказ)
	
	Стоимость			= 0;
	СуммаОбесценения 	= 0;
	ЭтоРасчетОдногоПотока = Ложь;
	
	Если ПлановыеВыплаты <> Неопределено Тогда
		//выплаты получены ранее (один поток)
		ЭтоРасчетОдногоПотока = Истина;
	Иначе
		ПлановыеВыплаты = ПолучитьПлановыеВыплатыПоАктиву(СчетДоверительногоУправления, Актив, Период);
	КонецЕсли;
	
	Если ПлановыеВыплаты.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена таблица плановых выплат для актива " + Актив,,,, Отказ);
	КонецЕсли;
	
	Если ТипЗнч(Актив) = Тип("СправочникСсылка.Займы") 
		ИЛИ ТипЗнч(Актив) = Тип("ДокументСсылка.СделкаСНедвижимостью")
		ИЛИ Справочники.Договоры.ЭтоИнвестконтракт(Актив) Тогда

		#Область Запрос_обесценения
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос.УстановитьПараметр("ПлановыеВыплаты", ПлановыеВыплаты);
		Запрос.УстановитьПараметр("Актив", Актив);
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("Период", Период);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПлановыеВыплаты.Период КАК Период
			|ПОМЕСТИТЬ _ДатыПлановыхВыплат
			|ИЗ
			|	&ПлановыеВыплаты КАК ПлановыеВыплаты
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОбесценениеАктивовСрезПоследних.ДатаДенежногоПотока КАК ДатаДенежногоПотока,
			|	ОбесценениеАктивовСрезПоследних.Коэффициент КАК Коэффициент
			|ПОМЕСТИТЬ _ПотокиОбесценения
			|ИЗ
			|	РегистрСведений.ОбесценениеАктивов.СрезПоследних(
			|			&Период,
			|			Актив = &Актив
			|				И Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОбесценениеАктивовСрезПоследних
			|ГДЕ
			|	ОбесценениеАктивовСрезПоследних.Коэффициент <> 1
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ПотокиОбесценения.ДатаДенежногоПотока КАК ДатаДенежногоПотока,
			|	_ДатыПлановыхВыплат.Период КАК Период
			|ИЗ
			|	_ПотокиОбесценения КАК _ПотокиОбесценения
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыПлановыхВыплат КАК _ДатыПлановыхВыплат
			|		ПО _ПотокиОбесценения.ДатаДенежногоПотока = _ДатыПлановыхВыплат.Период
			|ГДЕ
			|	_ДатыПлановыхВыплат.Период ЕСТЬ NULL
			|	И _ПотокиОбесценения.ДатаДенежногоПотока >= &Период
			|";
		
		ВыборкаЛишниеПериодыОбесценения = Запрос.Выполнить().Выбрать();
		
		Если НЕ ЭтоРасчетОдногоПотока Тогда
			Пока ВыборкаЛишниеПериодыОбесценения.Следующий() Цикл
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для актива "+Актив+" обнаружен лишний коэффициент обесценения на " + Формат(ВыборкаЛишниеПериодыОбесценения.ДатаДенежногоПотока, "ДФ=dd.MM.yyyy") ,,,, Отказ);
			КонецЦикла;
		КонецЕсли;
		
		Если НЕ Отказ Тогда
		
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ПотокиОбесценения.Коэффициент КАК Коэффициент
				|ПОМЕСТИТЬ _ОбщийКоэффициент
				|ИЗ
				|	_ПотокиОбесценения КАК _ПотокиОбесценения
				|ГДЕ
				|	_ПотокиОбесценения.ДатаДенежногоПотока = ДАТАВРЕМЯ(1, 1, 1)
				|	И _ПотокиОбесценения.Коэффициент <> 1
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ДатыПлановыхВыплат.Период КАК Период,
				|	ЕСТЬNULL(_ПотокиОбесценения.Коэффициент, 1) КАК Коэффициент,
				|	ЕСТЬNULL(_ОбщийКоэффициент.Коэффициент, 1) КАК ОбщийКоэффициент
				|ИЗ
				|	_ДатыПлановыхВыплат КАК _ДатыПлановыхВыплат
				|		ЛЕВОЕ СОЕДИНЕНИЕ _ПотокиОбесценения КАК _ПотокиОбесценения
				|			ЛЕВОЕ СОЕДИНЕНИЕ _ОбщийКоэффициент КАК _ОбщийКоэффициент
				|			ПО (ИСТИНА)
				|		ПО _ДатыПлановыхВыплат.Период = _ПотокиОбесценения.ДатаДенежногоПотока
				|			И (_ПотокиОбесценения.ДатаДенежногоПотока <> ДАТАВРЕМЯ(1, 1, 1))";
			
			РезультатЗапросаОбесценения = Запрос.Выполнить();
			ВыборкаОбесценение = РезультатЗапросаОбесценения.Выбрать();
			
		Иначе		
			ВыборкаОбесценение = Неопределено;
		КонецЕсли;
		
		#КонецОбласти
		
	Иначе
		ВыборкаОбесценение = Неопределено;
	КонецЕсли;
	
	Для каждого СтрокаТаблицыПлатежей Из ПлановыеВыплаты Цикл
		
		Если СтрокаТаблицыПлатежей.Период < НачалоДня(Период) Тогда
			Продолжить;
		КонецЕсли;
		
		Обесценение = 0;

		//обесценение пока только для займов
		Если ВыборкаОбесценение <> Неопределено Тогда
			ВыборкаОбесценение.Сбросить();
			Если ВыборкаОбесценение.НайтиСледующий(СтрокаТаблицыПлатежей.Период, "Период") Тогда
				Если ВыборкаОбесценение.ОбщийКоэффициент <> 1 И ВыборкаОбесценение.Коэффициент <> 1 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для актива "+Актив+" одновременно обнаружены общий коэффициент обесценения и коэффициент обесценения по дате денежного потока " + Формат(СтрокаТаблицыПлатежей.Период, "ДФ=dd.MM.yyyy") ,,,, Отказ);
				КонецЕсли;
				
				//один из кэффициентов = 1, поэтому умножаем на оба
				Обесценение = СтрокаТаблицыПлатежей.Сумма * ВыборкаОбесценение.ОбщийКоэффициент * ВыборкаОбесценение.Коэффициент - СтрокаТаблицыПлатежей.Сумма;
				СуммаОбесценения = СуммаОбесценения + Обесценение;
			КонецЕсли;
		КонецЕсли;	
		
		КолДней = (НачалоДня(СтрокаТаблицыПлатежей.Период) - НачалоДня(Период)) / 86400;
		
		ДисконтированныйПоток = (СтрокаТаблицыПлатежей.Сумма + Обесценение) / Pow(1 + ПроцентПоАктиву / 100, КолДней / 365);
		
		Если Период < Дата(2020, 09, 7) Тогда
			Если РазрядностьОкругленияПромежуточныхРасчетовДепозитныхВкладов > 0 Тогда
				ДисконтированныйПоток = Окр(ДисконтированныйПоток, РазрядностьОкругленияПромежуточныхРасчетовДепозитныхВкладов);
			КонецЕсли;
		КонецЕсли;
		
		Стоимость = Стоимость + ДисконтированныйПоток - Обесценение;
		
	КонецЦикла;
	
	Возврат Новый Структура("Стоимость,Обесценение", Стоимость, СуммаОбесценения);
	
КонецФункции

Функция ПроверитьВозможностьИспользованияСхемыПроверкиСущественностиОтклонений(СтрокаАктивы, Период, Отказ)
	
	ПромежуточныйОтказ = Ложь; //это чтобы все ошибки проверить
	
	Если ТипЗнч(СтрокаАктивы.Актив) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		
		//Для вида актива ЕПС ДепозитныеВкладыПоСС доступны не все схемы расчёта
		Если СтрокаАктивы.УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДепозитныеВкладыПоСС Тогда
			Если СтрокаАктивы.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ОтклонениеСтоимостиПоЭСППоРыночнойСтавке
			 ИЛИ СтрокаАктивы.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.СтавкаРыночнаяИОтклонениеСтоимостиПоЭСП Тогда
			    ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для депозитного вклада " + СтрокаАктивы.Актив + ", учётного актива " + СтрокаАктивы.УчетныйАктив + " невозможно использовать схему проверку на рыночность " + СтрокаАктивы.СхемаПроверкиСущественностиОтклонений,,,, ПромежуточныйОтказ);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если СтрокаАктивы.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.ОтклонениеСтоимостиПоЭСППоРыночнойСтавке
	 ИЛИ СтрокаАктивы.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.СтавкаРыночнаяИлиОтклонениеСтоимостиПоРыночнойСтавке
	 ИЛИ СтрокаАктивы.СхемаПроверкиСущественностиОтклонений = Перечисления.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.СтавкаРыночнаяИОтклонениеСтоимостиПоЭСП Тогда
	 	Если Не Справочники.ПериодичностиОпределенияРыночнойСтавки.ПроверкаТолькоПриПервоначальномПризнании(СтрокаАктивы.ПериодичностьОпределенияРыночнойСтавки)
		   И НачалоДня(Период) <> НачалоДня(СтрокаАктивы.ДатаПроверкиНаРыночность) Тогда
		   ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сравнение линейной стоимости и стоимости по ЭСП для схемы '" + СтрокаАктивы.СхемаПроверкиСущественностиОтклонений + "' на промежуточные даты не реализован",,,, ПромежуточныйОтказ);
		КонецЕсли;
	КонецЕсли;
	
	Отказ = Макс(ПромежуточныйОтказ, Отказ);
	
	Возврат НЕ ПромежуточныйОтказ;
	
КонецФункции

#КонецОбласти

#Область РасчетПоМетодикеКлиента

// Расчитывает границы рыночной ставки по методике клиента
//	Формулы для расчёта границ рыночной ставки зависят от рейтинга инструмента. Рейтинг определеяется для банка.
//	Вычисляемые параметры
//	КБДd - КБД в точке дюрации депозита в дату размещения депозита
//	Rf_t - значение безрискового индикатора на дату размещения депозита
//	Rf_t-1 - значение безрискового индикатора на рабочий день предшествующий дате размещения депозита
//	Sгр1 - кредитный спред 1 рейтинговой группы = Y_RUCBITRBBB - КБД_RUCBITRBBB
//	Sгр2 - кредитный спред 2 рейтинговой группы = Y_RUCBITRBB - КБД_RUCBITRBB
//	Sгр2 - кредитный спред 3 рейтинговой группы = Y_RUCBITRB - КБД_RUCBITRB
//		где Y - доходность индекса, КБД - КБД в точке дюрации индекса
//	Премия - премия за субординированность.
//	spread - Сумма(Ri - Rf) / 3, где
//		Ri - три ближайшие к дате размещения средневзвешенные ставки по депозитам для НФО, в зависимости от срока инструмента 
//		Rf - средняя ставка безрискового индикатора в месяце за который действует Ri.
//
Процедура РассчитатьГраницыРыночностиПоМетодикеКлиента(СтрокаАктивы, Период, СчетДоверительногоУправления, Клиент, ЦельРасчета, Отказ, ЭтоРасшифровка = Ложь)
	
	ПараметрыРасшифровки = Новый Структура;
	ПараметрыРасшифровки.Вставить("Операции", Новый Массив);
	
	Премия = 0; //за субординированность
	
	НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(Период, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, ЦельРасчета, Истина);
	
#Область КредитныеСпреды

	ПараметрыОценки = Новый Структура;
	ПараметрыОценки.Вставить("СчетДоверительногоУправления",		СчетДоверительногоУправления);
	ПараметрыОценки.Вставить("ВариантРасчетаСправедливойСтоимости",	НастройкиОценки.ВариантРасчетаОценочнойСтоимости);
	ПараметрыОценки.Вставить("Клиент",								Клиент);

	ПараметрыРасчетаРейтинга = РаботаСПереоценкой.ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, Период, Отказ);
	ПараметрыРасчетаРейтинга.Вставить("ИсключатьДляРублевыхОблигацийРейтингВИностраннойВалюте", Ложь);

	ПараметрыРасчетаКредитногоСпреда = РаботаСПереоценкой.ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, Период, Отказ);
	ПараметрыРасчетаКредитногоСпреда.Вставить("ВариантРасчетаДиапазонаКредитногоСпреда", "НеРассчитывать");
	
	Если НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020
		ИЛИ НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ХантыМансийский2020 Тогда
		ПараметрыРасчетаКредитногоСпреда.Вставить("ТочностьКБД", 2);
	КонецЕсли;
	
	РейтинговаяГруппа = РаботаСПоказателямиФинансовыхИнструментов.ОпределитьРейтинговуюГруппу(СтрокаАктивы.Актив, Период, ПараметрыРасчетаРейтинга, , ПараметрыРасшифровки);
	ПараметрыРасшифровки.Вставить("РейтинговаяГруппа", РейтинговаяГруппа);
	
	МассивРейтинговыхГрупп = Новый Массив;
	МассивРейтинговыхГрупп.Добавить(1);
	МассивРейтинговыхГрупп.Добавить(2);
	МассивРейтинговыхГрупп.Добавить(3);
	МассивРейтинговыхГрупп.Добавить(4);
	
	ПараметрыРасчетаРейтинга.Вставить("РейтинговаяГруппа", МассивРейтинговыхГрупп);
	
	КредитныеСпреды = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(СтрокаАктивы.Актив, Период, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, Ложь, ПараметрыРасшифровки); 
	
	ПараметрыРасшифровки.Вставить("КредитныеСпреды", Новый Массив);
	
	Sгр1 = КредитныеСпреды.Найти(1, "НомерГруппы").Медиана/100;
	Если НЕ ЗначениеЗаполнено(Sгр1) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить кредитный спред 1 рейтинговой группы для актива " + СтрокаАктивы.Актив,,,, Отказ);
		Возврат;
	КонецЕсли;	
	ПараметрыРасшифровки.КредитныеСпреды.Добавить(Новый Структура("Представление, Значение", "SргI", Sгр1));

	Sгр2 = КредитныеСпреды.Найти(2, "НомерГруппы").Медиана/100;
	Если НЕ ЗначениеЗаполнено(Sгр2) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить кредитный спред 2 рейтинговой группы для актива " + СтрокаАктивы.Актив,,,, Отказ);
		Возврат;
	КонецЕсли;	
	ПараметрыРасшифровки.КредитныеСпреды.Добавить(Новый Структура("Представление, Значение", "SргII", Sгр2));

	Sгр3 = КредитныеСпреды.Найти(3, "НомерГруппы").Медиана/100;
	Если НЕ ЗначениеЗаполнено(Sгр3) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить кредитный спред 3 рейтинговой группы для актива " + СтрокаАктивы.Актив,,,, Отказ);
		Возврат;
	КонецЕсли;	
	ПараметрыРасшифровки.КредитныеСпреды.Добавить(Новый Структура("Представление, Значение", "SргIII", Sгр3));
	
	Если НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ХантыМансийский2020 Тогда
		Sгр4 = КредитныеСпреды.Найти(4, "НомерГруппы").Медиана/100;
		Если НЕ ЗначениеЗаполнено(Sгр4) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить кредитный спред 4 рейтинговой группы для актива " + СтрокаАктивы.Актив,,,, Отказ);
			Возврат;
		КонецЕсли;	
		ПараметрыРасшифровки.КредитныеСпреды.Добавить(Новый Структура("Представление, Значение", "SргIV", Sгр4));
	КонецЕсли;
	
#КонецОбласти

#Область КБД
	Если НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Благосостояние2020
	 ИЛИ НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ХантыМансийский2020
	 ИЛИ НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Традиция2019 Тогда
	 	ТочностьКБД = Неопределено;
		ПараметрыРасчетаКредитногоСпреда.Свойство("ТочностьКБД", ТочностьКБД);
		
		Если НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Традиция2019 Тогда 
			КБД = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьНоминальнуюБезрисковуюСтавкуДоходности(СтрокаАктивы.Актив, КонецДня(Период), , Ложь, Неопределено, ТочностьКБД, ПараметрыРасшифровки);
		Иначе		
			КБД = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьНоминальнуюБезрисковуюСтавкуДоходности(СтрокаАктивы.Актив, КонецДня(Период), , Ложь, 4, ТочностьКБД, ПараметрыРасшифровки);
		КонецЕсли;
		
	КонецЕсли;
#КонецОбласти	

#Область ЗначениеБезрисковогоИндикатора 

	Если НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020
	 ИЛИ НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Благосостояние2020 Тогда
		ЗначениеБезрисковогоИндикатора = 0;
		
		Если РейтинговаяГруппа = 1 
			ИЛИ РейтинговаяГруппа = 2
			ИЛИ (РейтинговаяГруппа = 3 И НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020) Тогда
			
			Если НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020 
			   И Период >= Дата(2023, 9, 1) Тогда
			    ГруппаБанков = Перечисления.ГруппыБанковДляПолученияРыночнойПроцентнойСтавки.ВсеБанкиРФ;
			ИначеЕсли РейтинговаяГруппа = 1 
				ИЛИ НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020 Тогда
				ГруппаБанков = Перечисления.ГруппыБанковДляПолученияРыночнойПроцентнойСтавки.Крупнейшие30Банков;
			ИначеЕсли РейтинговаяГруппа = 2 Тогда
				ГруппаБанков = Перечисления.ГруппыБанковДляПолученияРыночнойПроцентнойСтавки.ВсеБанкиРФ;
			КонецЕсли;
			
			Если НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Благосостояние2020 Тогда
				Если СтрокаАктивы.СрокАктиваДляПримененияРыночнойСтавки < 31 Тогда
					ИнтервалШкалы = Перечисления.ИнтервалыШкалСредневзвешенныхПроцентныхСтавокПоДепозитам.До30ДнейВключаяДоВостребования;
				ИначеЕсли СтрокаАктивы.СрокАктиваДляПримененияРыночнойСтавки < 366 Тогда
					ИнтервалШкалы = Перечисления.ИнтервалыШкалСредневзвешенныхПроцентныхСтавокПоДепозитам.До1ГодаВключаяДоВостребования;
				Иначе
					ИнтервалШкалы = Перечисления.ИнтервалыШкалСредневзвешенныхПроцентныхСтавокПоДепозитам.От1ГодаДо3Лет;
				КонецЕсли;
			ИначеЕсли НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020 Тогда
				Если СтрокаАктивы.СрокАктиваДляПримененияРыночнойСтавки < 31 Тогда
					ИнтервалШкалы = Перечисления.ИнтервалыШкалСредневзвешенныхПроцентныхСтавокПоДепозитам.До30ДнейВключаяДоВостребования;
				ИначеЕсли СтрокаАктивы.СрокАктиваДляПримененияРыночнойСтавки < 91 Тогда
					ИнтервалШкалы = Перечисления.ИнтервалыШкалСредневзвешенныхПроцентныхСтавокПоДепозитам.От31До90Дней;
				ИначеЕсли СтрокаАктивы.СрокАктиваДляПримененияРыночнойСтавки < 181 Тогда
					ИнтервалШкалы = Перечисления.ИнтервалыШкалСредневзвешенныхПроцентныхСтавокПоДепозитам.От91До180Дней;
				ИначеЕсли СтрокаАктивы.СрокАктиваДляПримененияРыночнойСтавки < 366 Тогда
					ИнтервалШкалы = Перечисления.ИнтервалыШкалСредневзвешенныхПроцентныхСтавокПоДепозитам.От181ДняДо1Года;
				ИначеЕсли СтрокаАктивы.СрокАктиваДляПримененияРыночнойСтавки < (365 * 3 + 1) Тогда
					ИнтервалШкалы = Перечисления.ИнтервалыШкалСредневзвешенныхПроцентныхСтавокПоДепозитам.От1ГодаДо3Лет;
				Иначе
					ИнтервалШкалы = Перечисления.ИнтервалыШкалСредневзвешенныхПроцентныхСтавокПоДепозитам.Свыше3Лет;
				КонецЕсли;
			КонецЕсли;
			
			ЗначениеБезрисковогоИндикатора = ПолучитьЗначениеБезрисковогоИндикатораСОтклонением(СтрокаАктивы.ВидСредневзвешеннойРыночнойСтавки, Период, ГруппаБанков, ИнтервалШкалы, СтрокаАктивы.Валюта, НастройкиОценки.ВариантРасчетаОценочнойСтоимости, Отказ, ПараметрыРасшифровки);
			
			Если НЕ ЗначениеЗаполнено(ЗначениеБезрисковогоИндикатора) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось расчитать %1 + spread на %2 для актива %3", СтрокаАктивы.ВидСредневзвешеннойРыночнойСтавки, Формат(Период, "ДФ=dd.MM.yyyy"), СтрокаАктивы.Актив),,,, Отказ);
			КонецЕсли;
			
