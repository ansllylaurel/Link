	КонецЕсли;
	
#КонецОбласти
	
	
КонецПроцедуры

Функция ПолучитьЗначениеБезрисковогоИндикатораСОтклонением(БиржевойИндекс, Период, ГруппаБанков, ИнтервалШкалы, Валюта, ВариантРасчетаОценочнойСтоимости, Отказ, ПараметрыРасшифровки)
	
	ПредыдущийРабочийДень = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, Период - 84600, -1);
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Период", 		Период);
	Запрос.УстановитьПараметр("ГруппаБанков", 	ГруппаБанков);
	Запрос.УстановитьПараметр("ИнтервалШкалы", 	ИнтервалШкалы);
	Запрос.УстановитьПараметр("Валюта", 		Валюта);
	Запрос.УстановитьПараметр("БиржевойИндекс",	БиржевойИндекс);
	
	Запрос.УстановитьПараметр("ПредыдущийРабочийДень", ПредыдущийРабочийДень);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СредневзвешенныеПроцентныеСтавкиСрезПоследних.НачалоРасчетногоМесяца КАК НачалоРасчетногоМесяца,
		|	СредневзвешенныеПроцентныеСтавкиСрезПоследних.ПроцентнаяСтавка КАК ПроцентнаяСтавка
		|ПОМЕСТИТЬ _СтавкиПоДепозитам
		|ИЗ
		|	РегистрСведений.СредневзвешенныеПроцентныеСтавки.СрезПоследних(
		|			&Период,
		|			Вид = ЗНАЧЕНИЕ(Перечисление.ВидыСредневзвешенныхСтавок.ПоДепозитамНФО)
		|				И ГруппаБанков = &ГруппаБанков
		|				И Валюта = &Валюта
		|				И ИнтервалШкалы = &ИнтервалШкалы) КАК СредневзвешенныеПроцентныеСтавкиСрезПоследних
		|ГДЕ
		|	СредневзвешенныеПроцентныеСтавкиСрезПоследних.Действует
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(ДОБАВИТЬКДАТЕ(_СтавкиПоДепозитам.НачалоРасчетногоМесяца, МЕСЯЦ, -2)) КАК НачалоПериода,
		|	КОНЕЦПЕРИОДА(МАКСИМУМ(_СтавкиПоДепозитам.НачалоРасчетногоМесяца), МЕСЯЦ) КАК ОкончанияПериода
		|ПОМЕСТИТЬ _ПериодыСтавок
		|ИЗ
		|	_СтавкиПоДепозитам КАК _СтавкиПоДепозитам
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БиржевыеИндексыВМесяцыСтавокПоДепозитам.Период КАК ДатаИндексаВПериодеСтавок,
		|	БиржевыеИндексыВМесяцыСтавокПоДепозитам.CLOSE КАК ЗначениеИндексаВПериодеСтавок,
		|	БиржевыеИндексыНаДатуОценки.CLOSE КАК ТекущееЗначениеИндекса,
		|	БиржевыеИндексыНаПредыдущийРабочийДень.CLOSE КАК ПредыдущееЗначениеИндекса
		|ПОМЕСТИТЬ _ЗначенияИндексов
		|ИЗ
		|	_ПериодыСтавок КАК ПериодыСтавок
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК БиржевыеИндексыВМесяцыСтавокПоДепозитам
		|		ПО (БиржевыеИндексыВМесяцыСтавокПоДепозитам.БиржевойИндекс = &БиржевойИндекс)
		|			И (БиржевыеИндексыВМесяцыСтавокПоДепозитам.Период МЕЖДУ ПериодыСтавок.НачалоПериода И ПериодыСтавок.ОкончанияПериода)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК БиржевыеИндексыНаДатуОценки
		|		ПО (БиржевыеИндексыНаДатуОценки.БиржевойИндекс = &БиржевойИндекс)
		|			И (БиржевыеИндексыНаДатуОценки.Период = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК БиржевыеИндексыНаПредыдущийРабочийДень
		|		ПО (БиржевыеИндексыНаПредыдущийРабочийДень.БиржевойИндекс = &БиржевойИндекс)
		|			И (БиржевыеИндексыНаПредыдущийРабочийДень.Период = НАЧАЛОПЕРИОДА(&ПредыдущийРабочийДень, ДЕНЬ))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СтавкиПоДепозитам.НачалоРасчетногоМесяца КАК НачалоРасчетногоМесяца,
		|	_СтавкиПоДепозитам.ПроцентнаяСтавка КАК ПроцентнаяСтавка
		|ПОМЕСТИТЬ _СтавкиПоДепозитамЗаПериод
		|ИЗ
		|	_ПериодыСтавок КАК ПериодыСтавок
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СтавкиПоДепозитам КАК _СтавкиПоДепозитам
		|		ПО (_СтавкиПоДепозитам.НачалоРасчетногоМесяца МЕЖДУ ПериодыСтавок.НачалоПериода И ПериодыСтавок.ОкончанияПериода)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_СтавкиПоДепозитамЗаПериодСоСреднимЗначениемИндекса.ТекущееЗначениеИндекса, _СтавкиПоДепозитамЗаПериодСоСреднимЗначениемИндекса.ПредыдущееЗначениеИндекса) + СРЕДНЕЕ(_СтавкиПоДепозитамЗаПериодСоСреднимЗначениемИндекса.ПроцентнаяСтавка - _СтавкиПоДепозитамЗаПериодСоСреднимЗначениемИндекса.СреднееЗначениеИндекса) КАК ЗначениеБезрисковогоИндикатора,
		|	_СтавкиПоДепозитамЗаПериодСоСреднимЗначениемИндекса.ТекущееЗначениеИндекса КАК ТекущееЗначениеИндекса,
		|	_СтавкиПоДепозитамЗаПериодСоСреднимЗначениемИндекса.ПредыдущееЗначениеИндекса КАК ПредыдущееЗначениеИндекса,
		|	СРЕДНЕЕ(_СтавкиПоДепозитамЗаПериодСоСреднимЗначениемИндекса.ПроцентнаяСтавка - _СтавкиПоДепозитамЗаПериодСоСреднимЗначениемИндекса.СреднееЗначениеИндекса) КАК Спред
		|ПОМЕСТИТЬ _Благосостояние2020
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ЗначенияИндексов.ТекущееЗначениеИндекса КАК ТекущееЗначениеИндекса,
		|		_ЗначенияИндексов.ПредыдущееЗначениеИндекса КАК ПредыдущееЗначениеИндекса,
		|		_СтавкиПоДепозитамЗаПериод.НачалоРасчетногоМесяца КАК НачалоРасчетногоМесяца,
		|		_СтавкиПоДепозитамЗаПериод.ПроцентнаяСтавка КАК ПроцентнаяСтавка,
		|		СРЕДНЕЕ(_ЗначенияИндексов.ЗначениеИндексаВПериодеСтавок) КАК СреднееЗначениеИндекса
		|	ИЗ
		|		_СтавкиПоДепозитамЗаПериод КАК _СтавкиПоДепозитамЗаПериод
		|			ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияИндексов КАК _ЗначенияИндексов
		|			ПО (_СтавкиПоДепозитамЗаПериод.НачалоРасчетногоМесяца = НАЧАЛОПЕРИОДА(_ЗначенияИндексов.ДатаИндексаВПериодеСтавок, МЕСЯЦ))
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ЗначенияИндексов.ТекущееЗначениеИндекса,
		|		_ЗначенияИндексов.ПредыдущееЗначениеИндекса,
		|		_СтавкиПоДепозитамЗаПериод.НачалоРасчетногоМесяца,
		|		_СтавкиПоДепозитамЗаПериод.ПроцентнаяСтавка) КАК _СтавкиПоДепозитамЗаПериодСоСреднимЗначениемИндекса
		|
		|СГРУППИРОВАТЬ ПО
		|	_СтавкиПоДепозитамЗаПериодСоСреднимЗначениемИндекса.ТекущееЗначениеИндекса,
		|	_СтавкиПоДепозитамЗаПериодСоСреднимЗначениемИндекса.ПредыдущееЗначениеИндекса
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗначенияИндексов.ПредыдущееЗначениеИндекса + (ВЫРАЗИТЬ(СРЕДНЕЕ(_СтавкиПоДепозитамЗаПериод.ПроцентнаяСтавка) - СРЕДНЕЕ(_ЗначенияИндексов.ЗначениеИндексаВПериодеСтавок) КАК ЧИСЛО(19, 2))) КАК ЗначениеБезрисковогоИндикатора,
		|	СРЕДНЕЕ(_ЗначенияИндексов.ЗначениеИндексаВПериодеСтавок) КАК СреднееЗначениеИндекса,
		|	_ЗначенияИндексов.ПредыдущееЗначениеИндекса КАК ПредыдущееЗначениеИндекса,
		|	NULL КАК ТекущееЗначениеИндекса,
		|	ВЫРАЗИТЬ(СРЕДНЕЕ(_СтавкиПоДепозитамЗаПериод.ПроцентнаяСтавка) - СРЕДНЕЕ(_ЗначенияИндексов.ЗначениеИндексаВПериодеСтавок) КАК ЧИСЛО(19, 2)) КАК Спред
		|ПОМЕСТИТЬ _Атомфонд2020
		|ИЗ
		|	_СтавкиПоДепозитамЗаПериод КАК _СтавкиПоДепозитамЗаПериод
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияИндексов КАК _ЗначенияИндексов
		|		ПО (ИСТИНА)
		|ГДЕ
		|	&Период < ДАТАВРЕМЯ(2023, 4, 1)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЗначенияИндексов.ТекущееЗначениеИндекса,
		|	_ЗначенияИндексов.ПредыдущееЗначениеИндекса
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕСТЬNULL(_ЗначенияИндексов.ТекущееЗначениеИндекса, _ЗначенияИндексов.ПредыдущееЗначениеИндекса) + (ВЫРАЗИТЬ(СРЕДНЕЕ(_СтавкиПоДепозитамЗаПериод.ПроцентнаяСтавка) - СРЕДНЕЕ(_ЗначенияИндексов.ЗначениеИндексаВПериодеСтавок) КАК ЧИСЛО(19, 2))),
		|	СРЕДНЕЕ(_ЗначенияИндексов.ЗначениеИндексаВПериодеСтавок),
		|	_ЗначенияИндексов.ПредыдущееЗначениеИндекса,
		|	_ЗначенияИндексов.ТекущееЗначениеИндекса,
		|	ВЫРАЗИТЬ(СРЕДНЕЕ(_СтавкиПоДепозитамЗаПериод.ПроцентнаяСтавка) - СРЕДНЕЕ(_ЗначенияИндексов.ЗначениеИндексаВПериодеСтавок) КАК ЧИСЛО(19, 2))
		|ИЗ
		|	_СтавкиПоДепозитамЗаПериод КАК _СтавкиПоДепозитамЗаПериод
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияИндексов КАК _ЗначенияИндексов
		|		ПО (ИСТИНА)
		|ГДЕ
		|	&Период >= ДАТАВРЕМЯ(2023, 4, 1)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЗначенияИндексов.ТекущееЗначениеИндекса,
		|	_ЗначенияИндексов.ПредыдущееЗначениеИндекса";
	
	Запрос.Выполнить();
	
	Если ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Благосостояние2020 Тогда
		Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Благосостояние2020").ПолучитьДанные().Выбрать();
		
	ИначеЕсли ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020 Тогда
		Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Атомфонд2020").ПолучитьДанные().Выбрать();
		
	КонецЕсли;
	
	Если Не Выборка.Следующий() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось рассчитать %1 + spread на %2", БиржевойИндекс, Формат(Период, "ДФ=dd.MM.yyyy")),,,, Отказ);
		Возврат 0;
	КонецЕсли;	
	
	Если ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Благосостояние2020 Тогда

		Если НЕ ЗначениеЗаполнено(Выборка.ТекущееЗначениеИндекса) И НЕ ЗначениеЗаполнено(Выборка.ПредыдущееЗначениеИндекса) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствуют значения индекса %1 на %2 и на %3", БиржевойИндекс, Формат(Период, "ДФ=dd.MM.yyyy"), Формат(ПредыдущийРабочийДень, "ДФ=dd.MM.yyyy")),,,, Отказ);
			Возврат 0;
		КонецЕсли;		
		
	ИначеЕсли ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020 Тогда

		Если НЕ ЗначениеЗаполнено(Выборка.ПредыдущееЗначениеИндекса)
				И ПредыдущийРабочийДень <> Дата(2024, 11, 02) // за 02.11.2024 (сб) биржа не предоставила значений индекса и расчет перестал работать #ТехДолг #570161
		Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствует значение индекса %1 на %2", БиржевойИндекс, Формат(ПредыдущийРабочийДень, "ДФ=dd.MM.yyyy")),,,, Отказ);
			Возврат 0;
		КонецЕсли;		
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.ТекущееЗначениеИндекса)  Тогда
		ПараметрыРасшифровки.Вставить("ТекущееЗначениеИндекса", Выборка.ТекущееЗначениеИндекса);		
	КонецЕсли;
		
	ПараметрыРасшифровки.Вставить("ПредыдущееЗначениеИндекса",		Выборка.ПредыдущееЗначениеИндекса);
	ПараметрыРасшифровки.Вставить("ПредыдущийДеньБиржевогоИндекса",	ПредыдущийРабочийДень);
	ПараметрыРасшифровки.Вставить("Спред", 							Выборка.Спред);
	
	Возврат Выборка.ЗначениеБезрисковогоИндикатора;
	
КонецФункции

#КонецОбласти

#Область КБД_MosPrime
//Рассчитывает ставку схемы "КБД + MosPrime 1 день" для методики ЗПИФ УКПИ
Процедура РассчитатьСтавкуКБД_MosPrime(СтрокаАктивы, Период, СчетДоверительногоУправления, Клиент, ЦельРасчета, Отказ, ЭтоРасшифровка = Ложь) 
	
	ПараметрыРасшифровки = Новый Структура;
	
	//Хардкод. Допсоглашение для дебиторки по инвестконтракту от 20.10.2023.
	Если СтрокаАктивы.ВидАктива = Перечисления.ВидыАктивовДляПроверкиНаРыночность.ДебиторскаяЗадолженность
		И ТипЗнч(СтрокаАктивы.Актив) = Тип("СправочникСсылка.Договоры") 
		И СтрокаАктивы.Актив.ВидДоговора = Перечисления.ВидыДоговоров.СтроительствоНаСвоемУчастке
		И Период >= Дата(2023, 10, 20) И Период < Дата(2023, 10, 31) Тогда
		СтрокаАктивы.ДатаПроверкиНаРыночность = Дата(2023, 10, 20);
	КонецЕсли;
	
	ДнейДоПогашения = (НачалоДня(СтрокаАктивы.ДатаПогашения) - НачалоДня(СтрокаАктивы.ДатаПроверкиНаРыночность)) / 86400;
	
	Если СтрокаАктивы.ДатаПроверкиНаРыночность <> НачалоДня(Период) Тогда 
		//#437106: 	Если в дату проверки на рыночность был поток с такой датой погашения, то берем ставку на эту потока. 
		//			Иначе - берем ставку на дату самого позднего потока отчетной даты.
		ПотокиАктива = ПолучитьПлановыеВыплатыПоАктиву(СчетДоверительногоУправления, СтрокаАктивы.Актив, КонецДня(СтрокаАктивы.ДатаПроверкиНаРыночность));
		Если ПотокиАктива.Количество() > 0 Тогда
		
			ПересчитатьДниДоПогашения = Истина;
			ДатаСамогоПозднегоПотока = Дата(1,1,1);
			
			Для Каждого Поток из ПотокиАктива Цикл
				
				Если Поток.Период = СтрокаАктивы.ДатаПогашения Тогда
					ПересчитатьДниДоПогашения = Ложь;
					Прервать;
				КонецЕсли;
				
				Если ДатаСамогоПозднегоПотока < Поток.Период Тогда
					ДатаСамогоПозднегоПотока = Поток.Период;
				КонецЕсли;
				
			КонецЦикла;
			
			Если ПересчитатьДниДоПогашения Тогда
			 	ДнейДоПогашения = (НачалоДня(ДатаСамогоПозднегоПотока) - НачалоДня(СтрокаАктивы.ДатаПроверкиНаРыночность)) / 86400;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыРасшифровки.Вставить("ДнейДоПогашения", ДнейДоПогашения);
	
	Если ДнейДоПогашения <= 0  Тогда
		
		РыночнаяСтавка = 0;
		
	ИначеЕсли ДнейДоПогашения = 1 И Период < Дата(2023,7,1) Тогда
		
		БиржаНФА 		= ОбщегоНазначения.ПолучитьИменованныйОбъект("СРО_НФА");
		MosPrime1День	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Ставка_MosPrime_1день");
		РыночнаяСтавка 	= РегистрыСведений.ЗначенияБиржевыхИндексов.Получить(НачалоДня(СтрокаАктивы.ДатаПроверкиНаРыночность), Новый Структура("Биржа, БиржевойИндекс", БиржаНФА, MosPrime1День)).VALUE;
		
		СтрокаАктивы.ВидСтавкиДляПроверкиНаРыночность = MosPrime1День;
		ПараметрыРасшифровки.Вставить("ВидСтавки", "MosPrime1День");
		
	Иначе
		
		ДнейВГоду = (КонецГода(СтрокаАктивы.ДатаПроверкиНаРыночность) + 1 - НачалоГода(СтрокаАктивы.ДатаПроверкиНаРыночность)) / 86400;
		Если Период < Дата(2024,3,29) И ДнейДоПогашения <= ДнейВГоду Тогда
			СрокДоПогашения = ДнейДоПогашения / ДнейВГоду; 
		Иначе
			СрокДоПогашения = ДнейДоПогашения / 365;
		КонецЕсли;
		
		Если Период >= Дата(2022,3,31) Тогда
			ПараметрыРасшифровки.Вставить("СрокДоПогашения", СрокДоПогашения);
			
			КБД = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьЗначениеКривойБескупоннойДоходности(СтрокаАктивы.ДатаПроверкиНаРыночность, СрокДоПогашения, , Отказ), 2);
			РыночнаяСтавка = Окр(КБД * КоэффициентКорректировкиКБД(Период, Отказ), 2);
			ПараметрыРасшифровки.Вставить("ВидСтавки", "КБД");
		Иначе
			СрокДоПогашения = Окр(СрокДоПогашения, 4);
			ПараметрыРасшифровки.Вставить("СрокДоПогашения", СрокДоПогашения);
			
			РыночнаяСтавка = РассчитатьЗначениеКривойБескупоннойДоходностиИнтерполяцией(СрокДоПогашения, СтрокаАктивы.ДатаПроверкиНаРыночность, Отказ, ПараметрыРасшифровки);
			ПараметрыРасшифровки.Вставить("ВидСтавки", "КБД");
		КонецЕсли;
	КонецЕсли;
	
	СтрокаАктивы.ПроцентПоАктиву = РыночнаяСтавка;
	ПараметрыРасшифровки.Вставить("Ставка", РыночнаяСтавка);
	
	СтрокаАктивы.АдресРасшифровкиКБД_MosPrime = ПоместитьВоВременноеХранилище(ПараметрыРасшифровки);

КонецПроцедуры

Функция КоэффициентКорректировкиКБД(Период, Отказ)
	
	Результат = 1;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПараметрыКривойБескупоннойДоходностиСрезПоследних.Период КАК Период,
		|	ПараметрыКривойБескупоннойДоходностиСрезПоследних.ВидПараметра КАК ВидПараметра
		|ПОМЕСТИТЬ _ДатаКБД
		|ИЗ
		|	РегистрСведений.ПараметрыКривойБескупоннойДоходности.СрезПоследних(&Период, ВидПараметра = ЗНАЧЕНИЕ(Перечисление.ВидыКривойБескупоннойДоходности.Текущее2017)) КАК ПараметрыКривойБескупоннойДоходностиСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_ДатаКБД.Период КАК ПериодКБД,
		|	_ДатаКБД.ВидПараметра КАК ВидПараметра,
		|	КлючеваяНаДатуКБД.ДатаЗначения КАК КлючеваяНаДатуКБДДатаЗначения,
		|	ISNULL(КлючеваяНаДатуКБД.ЗначениеПоказателя, 0) КАК КлючеваяНаДатуКБДЗначениеПоказателя,
		|	КлючеваяНаДатуОценки.ДатаЗначения КАК КлючеваяНаДатуОценкиДатаЗначения,
		|	ISNULL(КлючеваяНаДатуОценки.ЗначениеПоказателя, 0) КАК КлючеваяНаДатуОценкиЗначениеПоказателя
		|ИЗ
		|	_ДатаКБД КАК _ДатаКБД,
		|	(ВЫБРАТЬ ПЕРВЫЕ 1
		|		ПроцентныеПоказатели.ДатаЗначения КАК ДатаЗначения,
		|		ПроцентныеПоказатели.ЗначениеПоказателя КАК ЗначениеПоказателя
		|	ИЗ
		|		_ДатаКБД КАК _ДатаКБД
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПроцентныеПоказатели КАК ПроцентныеПоказатели
		|			ПО (ПроцентныеПоказатели.Период <= _ДатаКБД.Период)
		|				И (ПроцентныеПоказатели.ДатаЗначения <= _ДатаКБД.Период)
		|	ГДЕ
		|		ПроцентныеПоказатели.Показатель = ЗНАЧЕНИЕ(Перечисление.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ)
		|		И ПроцентныеПоказатели.Прогноз = ЛОЖЬ
		|	
		|	УПОРЯДОЧИТЬ ПО
		|		ПроцентныеПоказатели.ДатаЗначения УБЫВ,
		|		ПроцентныеПоказатели.Период УБЫВ) КАК КлючеваяНаДатуКБД,
		|	(ВЫБРАТЬ ПЕРВЫЕ 1
		|		ПроцентныеПоказатели.ДатаЗначения КАК ДатаЗначения,
		|		ПроцентныеПоказатели.ЗначениеПоказателя КАК ЗначениеПоказателя
		|	ИЗ
		|		РегистрСведений.ПроцентныеПоказатели КАК ПроцентныеПоказатели
		|	ГДЕ
		|		ПроцентныеПоказатели.Показатель = ЗНАЧЕНИЕ(Перечисление.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ)
		|		И ПроцентныеПоказатели.Прогноз = ЛОЖЬ
		|		И ПроцентныеПоказатели.Период <= &Период
		|		И ПроцентныеПоказатели.ДатаЗначения <= &Период
		|	
		|	УПОРЯДОЧИТЬ ПО
		|		ПроцентныеПоказатели.ДатаЗначения УБЫВ,
		|		ПроцентныеПоказатели.Период УБЫВ) КАК КлючеваяНаДатуОценки";
	
	Запрос.УстановитьПараметр("Период", Период);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ВыборкаДетальныеЗаписи.КлючеваяНаДатуКБДЗначениеПоказателя = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить коэффициент корректировки ставки КБД на "+Формат(Период,"ДФ=dd.MM.yyyy"),,,,Отказ);
		Иначе
			Результат = ВыборкаДетальныеЗаписи.КлючеваяНаДатуОценкиЗначениеПоказателя / ВыборкаДетальныеЗаписи.КлючеваяНаДатуКБДЗначениеПоказателя;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение КБД в процентах, определяется интерполяцией значений щкалы, которую дает ММВБ
Функция РассчитатьЗначениеКривойБескупоннойДоходностиИнтерполяцией(СрокДоПогашения, ДатаРасчета, Отказ, ПараметрыРасшифровки) Экспорт

	ШкалаСроковММВБ = Новый Массив;
	
	ШкалаСроковММВБ.Добавить(0.25);
	ШкалаСроковММВБ.Добавить(0.5);
	ШкалаСроковММВБ.Добавить(0.75);
	ШкалаСроковММВБ.Добавить(1);
	ШкалаСроковММВБ.Добавить(2);
	ШкалаСроковММВБ.Добавить(3);
	ШкалаСроковММВБ.Добавить(5);
	ШкалаСроковММВБ.Добавить(7);
	ШкалаСроковММВБ.Добавить(10);
	ШкалаСроковММВБ.Добавить(15);
	ШкалаСроковММВБ.Добавить(20);
	ШкалаСроковММВБ.Добавить(30);
	
	//если срок совпадает со значением шкалы, то вернем его
	Если ШкалаСроковММВБ.Найти(СрокДоПогашения) <> Неопределено Тогда
		ПараметрыРасшифровки.Вставить("НаиболееБлизкийПредыдущийСрокДоПогашения", СрокДоПогашения);
		Возврат Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьЗначениеКривойБескупоннойДоходности(ДатаРасчета, СрокДоПогашения, , Отказ), 2);
	КонецЕсли;
	
	Dmin = 100;
	Dmax = 0; 
	V0 = 0;
	V1 = 100; 
	Для Каждого СрокШкалы ИЗ ШкалаСроковММВБ Цикл
		Если СрокДоПогашения < СрокШкалы И V1 > СрокШкалы Тогда
			V1 = СрокШкалы;
		ИначеЕсли СрокДоПогашения > СрокШкалы И V0 < СрокШкалы Тогда
			V0 = СрокШкалы;
		КонецЕсли;
		Если Dmin > СрокШкалы Тогда
			Dmin = СрокШкалы;
		КонецЕсли;
		Если Dmax < СрокШкалы Тогда
			Dmax = СрокШкалы;
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыРасшифровки.Вставить("МинимальныйСрок", Dmin);
	ПараметрыРасшифровки.Вставить("МаксимальныйСрок", Dmax);
	ПараметрыРасшифровки.Вставить("НаиболееБлизкийПредыдущийСрокДоПогашения", V0);
	ПараметрыРасшифровки.Вставить("НаиболееБлизкийПоследующийСрокДоПогашения", V1);
	
	Если ДатаРасчета >= Дата(2021,12,30) Тогда
		ТочностьКБД = 4;
	Иначе
		ТочностьКБД = 2;
	КонецЕсли;
	
	Если СрокДоПогашения > Dmax Тогда
		Возврат Окр(Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьЗначениеКривойБескупоннойДоходности(ДатаРасчета, Dmax, , Отказ), ТочностьКБД), 2);
	ИначеЕсли СрокДоПогашения < Dmin Тогда
		Возврат Окр(Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьЗначениеКривойБескупоннойДоходности(ДатаРасчета, Dmin, , Отказ), ТочностьКБД), 2);
	Иначе
		K0 = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьЗначениеКривойБескупоннойДоходности(ДатаРасчета, V0, , Отказ), ТочностьКБД);
		K1 = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьЗначениеКривойБескупоннойДоходности(ДатаРасчета, V1, , Отказ), ТочностьКБД);
		
		ПараметрыРасшифровки.Вставить("СтавкаНаиболееБлизкогоПредыдущегоСрокаДоПогашения", K0);
		ПараметрыРасшифровки.Вставить("СтавкаНаиболееБлизкогоПоследующегоСрокаДоПогашения", K1);
		
		Возврат Окр(K0 + (СрокДоПогашения - V0)/(V1 -V0)*(K1 - K0), 2);
	КонецЕсли;
	
КонецФункции


#КонецОбласти

