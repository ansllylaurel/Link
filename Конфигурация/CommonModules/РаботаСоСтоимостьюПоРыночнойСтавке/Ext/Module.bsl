		|			_ЗадолженностиПоСделкамСРаздельнымИсполнением.ОснованиеЗадолженности,
		|			_ЗадолженностиПоСделкамСРаздельнымИсполнением.Контрагент,
		|			_ЗадолженностиПоСделкамСРаздельнымИсполнением.Сумма,
		|			_ЗадолженностиПоСделкамСРаздельнымИсполнением.ДатаПогашения,
		|			НачалоИсполенияПоСделкам.ДатаВозникновенияЗадолженности) КАК СделкиСРаздельнымИсполнениемИСрокомПогашения
		|	ГДЕ
		|		ВЫБОР
		|				КОГДА &ВариантРасчетаОценочнойСтоимости = ЗНАЧЕНИЕ(Справочник.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ_УКПИ)
		|					ТОГДА СделкиСРаздельнымИсполнениемИСрокомПогашения.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделкеСНедвижимостью))
		|							И СделкиСРаздельнымИсполнениемИСрокомПогашения.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|							И СделкиСРаздельнымИсполнениемИСрокомПогашения.РабочихДнейОтВозникновенияДоПогашения > 15
		|				КОГДА &ВариантРасчетаОценочнойСтоимости = ЗНАЧЕНИЕ(Справочник.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2018)
		|					ТОГДА СделкиСРаздельнымИсполнениемИСрокомПогашения.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|							И СделкиСРаздельнымИсполнениемИСрокомПогашения.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|							И &КонецПериода >= ДАТАВРЕМЯ(2020, 1, 1)
		|				КОГДА &ВариантРасчетаОценочнойСтоимости = ЗНАЧЕНИЕ(Справочник.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2021)
		|					ТОГДА СделкиСРаздельнымИсполнениемИСрокомПогашения.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|							И СделкиСРаздельнымИсполнениемИСрокомПогашения.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Займы.Валюта,
		|		ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоЗаймуПроценты),
		|		ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская),
		|		_СтоимостиПросроченнойДебиторки0.Основание,
		|		УсловияКредитныхИнструментовСрезПоследних.Контрагент,
		|		_СтоимостиПросроченнойДебиторки0.Проценты,
		|		ВЫРАЗИТЬ(_СтоимостиПросроченнойДебиторки0.Основание КАК Документ.ЗакрытиеКредитногоИнструмента).Дата,
		|		ВЫРАЗИТЬ(_СтоимостиПросроченнойДебиторки0.Основание КАК Документ.ЗакрытиеКредитногоИнструмента).Дата
		|	ИЗ
		|		_СтоимостиПросроченнойДебиторки0 КАК _СтоимостиПросроченнойДебиторки0
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Займы КАК Займы
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|					УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|					УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
		|					УсловияКредитныхИнструментовСрезПоследних.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
		|					УсловияКредитныхИнструментовСрезПоследних.Процент КАК Процент,
		|					УсловияКредитныхИнструментовСрезПоследних.Контрагент КАК Контрагент
		|				ИЗ
		|					(ВЫБРАТЬ
		|						УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|						МАКСИМУМ(УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
		|					ИЗ
		|						РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
		|								&Период,
		|								ДатаНачалаДействияУсловий <= &КонецПериода
		|									И КредитныйИнструмент В
		|										(ВЫБРАТЬ
		|											_СтоимостиПросроченнойДебиторки0.КРедитныйИнструмент
		|										ИЗ
		|											_СтоимостиПросроченнойДебиторки0 КАК _СтоимостиПросроченнойДебиторки0)) КАК УсловияКредитныхИнструментовСрезПоследних
		|					ГДЕ
		|						УсловияКредитныхИнструментовСрезПоследних.Действует
		|					
		|					СГРУППИРОВАТЬ ПО
		|						УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент) КАК АктуальныеДатыНачалаДействия
		|						ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
		|								&Период,
		|								ДатаНачалаДействияУсловий <= &КонецПериода
		|									И КредитныйИнструмент В
		|										(ВЫБРАТЬ
		|											_СтоимостиПросроченнойДебиторки0.КРедитныйИнструмент
		|										ИЗ
		|											_СтоимостиПросроченнойДебиторки0 КАК _СтоимостиПросроченнойДебиторки0)) КАК УсловияКредитныхИнструментовСрезПоследних
		|						ПО АктуальныеДатыНачалаДействия.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|							И АктуальныеДатыНачалаДействия.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК УсловияКредитныхИнструментовСрезПоследних
		|				ПО Займы.Ссылка = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|			ПО _СтоимостиПросроченнойДебиторки0.КРедитныйИнструмент = Займы.Ссылка
		|	ГДЕ
		|		_СтоимостиПросроченнойДебиторки0.Основание ССЫЛКА Документ.ЗакрытиеКредитногоИнструмента) КАК _ЗадолженностиПоДенежнымСредствамОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЗадолженностиПоДенежнымСредствамОстатки.Валюта,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ОснованиеЗадолженности,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.Контрагент,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ДатаПогашения,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ДатаВозникновения";
	
	Запрос.Параметры.Вставить("Календарь", Справочники.Календари.Общероссийский);
	
	ЗадолженностиПоДенежнымСредствамКОбесценениюИДисконтированию = Запрос.Выполнить().Выгрузить();
	
	Если Параметры.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Бриз") И НачалоДня(Параметры.Период) >= Дата(2025, 8, 29) Тогда
		ЗадолженностиПоДенежнымСредствамКОбесценениюИДисконтированию.Очистить();
		Возврат ЗадолженностиПоДенежнымСредствамКОбесценениюИДисконтированию;
	КонецЕсли;
	
	Если Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ_УКПИ
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2018
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2021 
		Тогда
		РаботаСоСтоимостьюПоРыночнойСтавке.ПолучитьСтоимостьЗадолженностиПоРыночнойСтавке(
				ЗадолженностиПоДенежнымСредствамКОбесценениюИДисконтированию, 
				Параметры.СчетДоверительногоУправления, 
				Параметры.Период, 
				Параметры.ЦельРасчета, 
				МенеджерВременныхТаблицРасшифровки,
				Отказ);
	КонецЕсли;

	//удалим строки, для которых СС не отличается от исходной суммы
	КоличествоСтрок = ЗадолженностиПоДенежнымСредствамКОбесценениюИДисконтированию.Количество();
	//#434641 - дефолт
	ДефолтныйЗайм = ОбщегоНазначения.ПолучитьИменованныйОбъект("ПросрочкаЗаймаКотенко_РПИ");
	
	Для сц = 1 - КоличествоСтрок по 0 Цикл
		
		ТекСтрока = ЗадолженностиПоДенежнымСредствамКОбесценениюИДисконтированию.Получить(-сц);
		
		Если ТекСтрока.ПроцентыЭСП + ТекСтрока.СуммаРезерва = 0 Тогда
			
			ЗадолженностиПоДенежнымСредствамКОбесценениюИДисконтированию.Удалить(ТекСтрока);
			
		ИначеЕсли ТекСтрока.ОснованиеЗадолженности = ДефолтныйЗайм И НачалоДня(Параметры.Период) >= Дата(2022,6,21) Тогда
			
			Если ТекСтрока.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоЗайму Тогда
				ТекСтрока.СуммаРезерва = - (ТекСтрока.Сумма + ТекСтрока.ПроцентыЭСП) + 1;
			Иначе
				ТекСтрока.СуммаРезерва = - (ТекСтрока.Сумма + ТекСтрока.ПроцентыЭСП);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЗадолженностиПоДенежнымСредствамКОбесценениюИДисконтированию;
			
КонецФункции

Функция ПолучитьПлановыеВыплатыДоговоруСтроительства(СчетДоверительногоУправления, Актив, Период) 
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("ОснованиеЗадолженности", Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаРезультат.Колонки.Добавить("ДатаРегистрации", Новый ОписаниеТипов("Дата"));
	ТаблицаРезультат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	ТаблицаРезультат.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	
	Если Справочники.Договоры.ЭтоИнвестконтракт(Актив) Тогда 
			
		Активы = Новый Массив;	
		Активы.Добавить(Актив);
		
		ТаблицаРезультат = РассчитатьПроцентыПоЗадолженностям(СчетДоверительногоУправления, Активы, Период, Истина);
		
		ТаблицаРезультат.Колонки.Добавить("ЭтоДенежныйПоток", Новый ОписаниеТипов("Булево"));
		ТаблицаРезультат.ЗаполнитьЗначения(Истина,"ЭтоДенежныйПоток");
		
		Для Каждого Строка Из ТаблицаРезультат Цикл
			Строка.Сумма = Строка.Сумма + Строка.Проценты; 
		КонецЦикла;
		
		ТаблицаРезультат.Колонки.Удалить(ТаблицаРезультат.Колонки.Индекс(ТаблицаРезультат.Колонки.Найти("Проценты")));
		
	Иначе
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Функция РассчитатьПроцентыПоЗадолженностям(СчетДоверительногоУправления, Активы, Период, ДоПогашения = Ложь) Экспорт
	
	Отказ = Ложь;
	
	МассивТиповОснований = Новый Массив;
	МассивТиповОснований.Добавить(Тип("СправочникСсылка.Договоры"));
	МассивТиповОснований.Добавить(Тип("ДокументСсылка.Сделка"));

	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("ВидЗадолженности", Новый ОписаниеТипов("СправочникСсылка.ВидыЗадолженности"));
	ТаблицаРезультат.Колонки.Добавить("ТипЗадолженности", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыЗадолженности"));
	ТаблицаРезультат.Колонки.Добавить("ОснованиеЗадолженности", Новый ОписаниеТипов(МассивТиповОснований));
	ТаблицаРезультат.Колонки.Добавить("ДатаРегистрации", Новый ОписаниеТипов("Дата"));
	ТаблицаРезультат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	ТаблицаРезультат.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаРезультат.Колонки.Добавить("Проценты", Новый ОписаниеТипов("Число"));
	ТаблицаРезультат.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	
	Если СчетДоверительногоУправления.Организация <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда
		Возврат ТаблицаРезультат;
	КонецЕсли;
	
	Договор_РПИ_Инвестконтракт_301120 	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Договор_РПИ_Инвестконтракт_301120");
	Продажа_РПИ_160522_132387 			= ОбщегоНазначения.ПолучитьИменованныйОбъект("Продажа_РПИ_160522_132387");
	Продажа_РПИ_270624_18_2 			= ОбщегоНазначения.ПолучитьИменованныйОбъект("Продажа_РПИ_270624_18_2");
	ПроцентыПоЗайму_РПИ_011024_5_1		= ОбщегоНазначения.ПолучитьИменованныйОбъект("ПроцентыПоЗайму_РПИ_011024_5_1");
	ПроцентыПоЗайму_РПИ_090125_5_1		= ОбщегоНазначения.ПолучитьИменованныйОбъект("ПроцентыПоЗайму_РПИ_090125_5_1");
	
	ВключаяДатуНачала = Ложь;
	ВключаяДатуОкончания = Ложь;
		
	Запрос = Новый Запрос;
	
	Сделка = Неопределено;
	ДатыОпределенияСтавки = Новый Массив;
	
	Если Активы.Найти(ПроцентыПоЗайму_РПИ_011024_5_1) <> Неопределено Тогда
		Сделка = ПроцентыПоЗайму_РПИ_011024_5_1;
		ДатыОпределенияСтавки.Добавить('20241114');        // дата договора об изменения срока оплаты задолженности
		ДатыОпределенияСтавки.Добавить('20241129');        // последний рабочий день месяца. В эти даты проверяем и меняем % ставку
		ДатыОпределенияСтавки.Добавить('20241228');        // список может измениться. Могут быть частичные погащения. 
	ИначеЕсли Активы.Найти(ПроцентыПоЗайму_РПИ_090125_5_1) <> Неопределено Тогда
		Сделка = ПроцентыПоЗайму_РПИ_090125_5_1;
		ДатыОпределенияСтавки.Добавить('20250123');        // второе начисление процентов, по которым надо считать.
	КонецЕсли;
		
	Если Сделка <> Неопределено Тогда	

		ДатыОпределенияСтавки.Добавить('20250131');        // Может измениться срок погащения. Тогда этот список надо будет изменить
		ДатыОпределенияСтавки.Добавить('20250228');
		ДатыОпределенияСтавки.Добавить('20250331');   
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПлановыеДатыОплатСрезПоследних.ДатаОплаты КАК ДатаОплатыПлановая,
		|	ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток, 0) КАК СуммаОстаток,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоЗаймуПроценты) КАК ВидЗадолженности,
		|	&Сделка КАК ОснованиеЗадолженности,
		|	ДАТАВРЕМЯ(2024, 11, 14, 0, 0, 0) КАК ДатаРегистрации,
		|	ПлановыеДатыОплатСрезПоследних.Валюта КАК Валюта,
		|	_ПараметрыКБД.Период КАК Период,
		|	_ПараметрыКБД.beta0 КАК beta0,
		|	_ПараметрыКБД.beta1 КАК beta1,
		|	_ПараметрыКБД.beta2 КАК beta2,
		|	_ПараметрыКБД.tau КАК tau,
		|	_ПараметрыКБД.g1 КАК g1,
		|	_ПараметрыКБД.g2 КАК g2,
		|	_ПараметрыКБД.g3 КАК g3,
		|	_ПараметрыКБД.g4 КАК g4,
		|	_ПараметрыКБД.g5 КАК g5,
		|	_ПараметрыКБД.g6 КАК g6,
		|	_ПараметрыКБД.g7 КАК g7,
