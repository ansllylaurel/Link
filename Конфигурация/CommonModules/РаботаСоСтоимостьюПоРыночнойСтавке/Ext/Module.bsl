
#Область ВнешниеВызовы

Функция ПолучитьСтоимостьКредитныхИнструментовПоРыночнойСтавке(КредитныеИнструменты, СчетДоверительногоУправления, Период, ЦельРасчета, МенеджерВременныхТаблиц = Неопределено, Отказ = Ложь) Экспорт 
	
	Активы = ПолучитьТаблицуАктивов();
	ЕстьПризнакДенежногоПотока = (КредитныеИнструменты.Колонки.Найти("ДатаДенежногоПотока") <> Неопределено);
	
	Для Каждого СтрокаКредитныеИнструменты Из КредитныеИнструменты Цикл
		СтрокаАктивы = Активы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаАктивы, СтрокаКредитныеИнструменты);
		
		//Исходная таблица содержит колонку "ДатаДенежногоПотока" при расчете по своей ставке для каждого денежного потока.
		//Если колонки нет, то это обычный расчет
		Если ЕстьПризнакДенежногоПотока
			И ЗначениеЗаполнено(СтрокаКредитныеИнструменты.ДатаДенежногоПотока) Тогда
			СтрокаАктивы.ДатаПогашения = СтрокаКредитныеИнструменты.ДатаДенежногоПотока;
			СтрокаАктивы.ЭтоДенежныйПоток = Истина;
		Иначе
			СтрокаАктивы.ЭтоДенежныйПоток = Ложь;
		КонецЕсли;
		
		СтрокаАктивы.Актив = СтрокаКредитныеИнструменты.КредитныйИнструмент;
		СтрокаАктивы.ВидАктива = СтрокаКредитныеИнструменты.ВидАктива;
	КонецЦикла;
	
	АктивыПоРыночнойСтавке = ПолучитьСтоимостьАктивовПоРыночнойСтавке(Активы, СчетДоверительногоУправления, Период, ЦельРасчета, МенеджерВременныхТаблиц, Отказ);
	
	АктивыПоРыночнойСтавке.Колонки.Добавить("КредитныйИнструмент"				, Новый ОписаниеТипов("СправочникСсылка.ДепозитныеВклады, СправочникСсылка.Займы"));
	АктивыПоРыночнойСтавке.Колонки.Добавить("ПроцентПоКредитномуИнструменту"	, Новый ОписаниеТипов("Число"));
	АктивыПоРыночнойСтавке.Колонки.Добавить("СрокКредитногоИнструмента"			, Новый ОписаниеТипов("Число"));
	
	Для Каждого СтрокаАктивыПоРыночнойСтавке Из АктивыПоРыночнойСтавке Цикл
		СтрокаАктивыПоРыночнойСтавке.КредитныйИнструмент	= СтрокаАктивыПоРыночнойСтавке.Актив;
		Если АктивыПоРыночнойСтавке.Колонки.Найти("ПроцентПоАктиву") <> Неопределено Тогда
			СтрокаАктивыПоРыночнойСтавке.ПроцентПоКредитномуИнструменту	= СтрокаАктивыПоРыночнойСтавке.ПроцентПоАктиву;
			СтрокаАктивыПоРыночнойСтавке.СрокКредитногоИнструмента		= СтрокаАктивыПоРыночнойСтавке.СрокАктиваДляПримененияРыночнойСтавки;
		КонецЕсли;
	КонецЦикла;
	
	Возврат АктивыПоРыночнойСтавке;
	
КонецФункции

Процедура ПолучитьСтоимостьРЕПОПоРыночнойСтавке(ЗадолженностьПоСделкамРЕПО, СчетДоверительногоУправления, Период, ЦельРасчета, КомиссияВСтоимости = Ложь, МенеджерВременныхТаблиц = Неопределено, Отказ = Ложь) Экспорт
	
	Активы = ПолучитьТаблицуАктивов();
	
	ЕстьПризнакДенежногоПотока = (ЗадолженностьПоСделкамРЕПО.Колонки.Найти("ДатаДенежногоПотока") <> Неопределено);
	
	Для Каждого СтрокаЗадолженности Из ЗадолженностьПоСделкамРЕПО Цикл
		СтрокаАктивы = Активы.Добавить();
		СтрокаАктивы.Актив = СтрокаЗадолженности.СделкаРЕПО;
		
		Если ЕстьПризнакДенежногоПотока
			И ЗначениеЗаполнено(СтрокаЗадолженности.ДатаДенежногоПотока) Тогда
			СтрокаАктивы.ДатаПогашения = СтрокаЗадолженности.ДатаДенежногоПотока;
			СтрокаАктивы.ЭтоДенежныйПоток = Истина;
		Иначе
			СтрокаАктивы.ЭтоДенежныйПоток = Ложь;
		КонецЕсли;
		
		Если СтрокаЗадолженности.СделкаРЕПО.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
			СтрокаАктивы.ВидАктива = Перечисления.ВидыАктивовДляПроверкиНаРыночность.ПрямоеРЕПО;
		Иначе
			СтрокаАктивы.ВидАктива = Перечисления.ВидыАктивовДляПроверкиНаРыночность.ОбратноеРЕПО;
		КонецЕсли;
		
		СтрокаАктивы.Номинал	= СтрокаЗадолженности.Задолженность;
		
		СтрокаАктивы.Проценты = СтрокаЗадолженности.СуммаПроцентов;
			
		СтрокаАктивы.Ставка		= СтрокаЗадолженности.Ставка;
		
		Если КомиссияВСтоимости = Истина Тогда
			СтрокаАктивы.Комиссия = СтрокаЗадолженности.КомиссияПоРЕПОВВалютеСделки; //используется для расшифровки
		КонецЕсли;
	КонецЦикла;
	
	ПолучитьСтоимостьАктивовПоРыночнойСтавке(Активы, СчетДоверительногоУправления, Период, ЦельРасчета, МенеджерВременныхТаблиц, Отказ);
	
	ЗадолженностьПоСделкамРЕПО.Колонки.Добавить("ПроцентыЭСП", 	Новый ОписаниеТипов("Число"));
	ЗадолженностьПоСделкамРЕПО.Колонки.Добавить("СуммаРезерва", Новый ОписаниеТипов("Число"));
	
	Для Каждого СтрокаАктивы Из Активы Цикл
		СтрокаЗадолженности = ЗадолженностьПоСделкамРЕПО.Найти(СтрокаАктивы.Актив, "СделкаРЕПО");
		Если СтрокаЗадолженности <> Неопределено Тогда
			СтрокаЗадолженности.СуммаПроцентов = СтрокаАктивы.Проценты + СтрокаАктивы.ПроцентыЭСП;
			СтрокаЗадолженности.ЗадолженностьПоСС = СтрокаЗадолженности.Задолженность + СтрокаАктивы.Проценты + СтрокаАктивы.ПроцентыЭСП;
			СтрокаЗадолженности.ПроцентыЭСП = СтрокаАктивы.ПроцентыЭСП;
			СтрокаЗадолженности.СуммаРезерва = СтрокаАктивы.СуммаРезерва;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПолучитьСтоимостьЗадолженностиПоРыночнойСтавке(ТаблицаЗадолженностей, СчетДоверительногоУправления, Период, ЦельРасчета, МенеджерВременныхТаблиц = Неопределено, Отказ = Ложь) Экспорт 
	
	Активы = ПолучитьТаблицуАктивов();
	
	ЭтоРазбитыйНаПотокиАктив = ТаблицаЗадолженностей.Колонки.Найти("ЭтоДенежныйПоток") <> Неопределено;
	
	Если СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Ритм_УКПИ") Тогда
		Продажа_РПИ_160522_132387 = ОбщегоНазначения.ПолучитьИменованныйОбъект("Продажа_РПИ_160522_132387");
	Иначе
		Продажа_РПИ_160522_132387 = Неопределено;
	КонецЕсли;
	
	Продажа_РПИ_270624_18_2 			= ОбщегоНазначения.ПолучитьИменованныйОбъект("Продажа_РПИ_270624_18_2");   
	ПроцентыПоЗайму_РПИ_011024_5_1		= ОбщегоНазначения.ПолучитьИменованныйОбъект("ПроцентыПоЗайму_РПИ_011024_5_1");
	ПроцентыПоЗайму_РПИ_090125_5_1		= ОбщегоНазначения.ПолучитьИменованныйОбъект("ПроцентыПоЗайму_РПИ_090125_5_1");

	ЗаймГеоресурсЗадолженностьПоПроцентам = Ложь;
	
	Для Каждого СтрокаЗадолженности Из ТаблицаЗадолженностей Цикл

		Если (СтрокаЗадолженности.ОснованиеЗадолженности = ПроцентыПоЗайму_РПИ_011024_5_1
			ИЛИ СтрокаЗадолженности.ОснованиеЗадолженности = ПроцентыПоЗайму_РПИ_090125_5_1)
				И НЕ ЗаймГеоресурсЗадолженностьПоПроцентам Тогда
			ЗаймГеоресурсЗадолженностьПоПроцентам = Истина; 
			Активы.Колонки.Добавить("АдресРасшифровкиДенежныхПотоков");     
		КонецЕсли;
		
		СтрокаАктивы = Активы.Добавить();		
		
		Если Не ЭтоРазбитыйНаПотокиАктив Тогда
			Если СтрокаЗадолженности.ТипЗадолженности = Перечисления.ТипыЗадолженности.Дебиторская Тогда
				СтрокаАктивы.ВидАктива		= Перечисления.ВидыАктивовДляПроверкиНаРыночность.ДебиторскаяЗадолженность;
			ИначеЕсли СтрокаЗадолженности.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПолучениюВАренду Тогда
				СтрокаАктивы.ВидАктива		= Перечисления.ВидыАктивовДляПроверкиНаРыночность.КредиторскаяЗадолженностьПоДолгосрочнойАренде;
			Иначе
				СтрокаАктивы.ВидАктива		= Перечисления.ВидыАктивовДляПроверкиНаРыночность.КредиторскаяЗадолженность;
			КонецЕсли;
			СтрокаАктивы.ДатаПогашения		= СтрокаЗадолженности.ДатаПогашения;
		Иначе
			СтрокаАктивы.ВидАктива 			= СтрокаЗадолженности.ВидАктива;
			СтрокаАктивы.ДатаПогашения 		= СтрокаЗадолженности.Период;
			СтрокаАктивы.ЭтоДенежныйПоток 	= СтрокаЗадолженности.ЭтоДенежныйПоток;
		КонецЕсли;
		
		СтрокаАктивы.Номинал				= СтрокаЗадолженности.Сумма;
		СтрокаАктивы.Актив					= СтрокаЗадолженности.ОснованиеЗадолженности;
		СтрокаАктивы.Валюта					= СтрокаЗадолженности.Валюта;
		СтрокаАктивы.ДатаРегистрации  		= СтрокаЗадолженности.ДатаРегистрации;     
				
		Если СтрокаАктивы.ВидАктива = Перечисления.ВидыАктивовДляПроверкиНаРыночность.ДебиторскаяЗадолженность
			И (СтрокаЗадолженности.ОснованиеЗадолженности = Продажа_РПИ_160522_132387 Или СтрокаЗадолженности.ОснованиеЗадолженности = Продажа_РПИ_270624_18_2) 
			ИЛИ (СтрокаЗадолженности.ОснованиеЗадолженности = ПроцентыПоЗайму_РПИ_011024_5_1 И Период >= Дата(2024, 11, 14))
			ИЛИ (СтрокаЗадолженности.ОснованиеЗадолженности = ПроцентыПоЗайму_РПИ_090125_5_1 И Период >= Дата(2025, 01, 23))
 		Тогда
					
			//#468527. хардкод пока не реализовано #386115
			//С 31 января 2023г учесть перенос даты погашения на следующий рабочий день
			Если СтрокаЗадолженности.ОснованиеЗадолженности = Продажа_РПИ_160522_132387 
				И Период >= Дата(2023,1,31) 
				И СтрокаАктивы.ДатаПогашения = Дата(2025,11,16) Тогда
				СтрокаАктивы.ДатаПогашения = Дата(2025,11,17);
			КонецЕсли; 
						
			АктивыДляРасчетаПроцентов = Новый Массив;	
			АктивыДляРасчетаПроцентов.Добавить(СтрокаЗадолженности.ОснованиеЗадолженности);
			
			ТаблицаРезультат = РассчитатьПроцентыПоЗадолженностям(СчетДоверительногоУправления, АктивыДляРасчетаПроцентов, Период, Истина);
			
			
			Если ЗаймГеоресурсЗадолженностьПоПроцентам Тогда 
				СтрокаАктивы.СуммаРезерва = -ТаблицаРезультат.Итог("Проценты");	
			Иначе 	  
				СтрокаАктивы.Проценты = ТаблицаРезультат.Итог("Проценты");    
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЦикла;   
	
	Если НЕ ЗаймГеоресурсЗадолженностьПоПроцентам Тогда 
		ПолучитьСтоимостьАктивовПоРыночнойСтавке(Активы, СчетДоверительногоУправления, Период, ЦельРасчета, МенеджерВременныхТаблиц, Отказ); 
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоРазбитыйНаПотокиАктив Тогда
		ТаблицаЗадолженностей.Свернуть("ВидАктива,ОснованиеЗадолженности,Валюта,ДатаРегистрации","Сумма");
		ТаблицаЗадолженностей.Колонки.Добавить("ПроцентыЭСП", Новый ОписаниеТипов("Число"));
		ТаблицаЗадолженностей.Колонки.Добавить("СуммаРезерва", Новый ОписаниеТипов("Число"));
	КонецЕсли;	
	
	ТаблицаЗадолженностей.Колонки.Добавить("АдресРасшифровкиДенежныхПотоков");
	
	Для Каждого СтрокаАктивы Из Активы Цикл
		Если Не ЭтоРазбитыйНаПотокиАктив Тогда
			ПараметрыПоиска = Новый Структура("ТипЗадолженности, ОснованиеЗадолженности", 
				?(СтрокаАктивы.ВидАктива = Перечисления.ВидыАктивовДляПроверкиНаРыночность.ДебиторскаяЗадолженность, Перечисления.ТипыЗадолженности.Дебиторская, Перечисления.ТипыЗадолженности.Кредиторская), 
				СтрокаАктивы.Актив);
		Иначе
			ПараметрыПоиска = Новый Структура("ВидАктива, ОснованиеЗадолженности", 
				СтрокаАктивы.ВидАктива, 
				СтрокаАктивы.Актив);
		КонецЕсли;
		НайденныеСтроки = ТаблицаЗадолженностей.НайтиСтроки(ПараметрыПоиска);

		Для Каждого СтрокаЗадолженности Из НайденныеСтроки Цикл
			
			//#техдолг: Нет разделения по виду задолженности, поэтому соответствие ищем по исходной сумме.
			Если ТипЗнч(СтрокаЗадолженности.ОснованиеЗадолженности) = Тип("ДокументСсылка.ЗакрытиеКредитногоИнструмента") 
				И (СтрокаЗадолженности.Сумма <> СтрокаАктивы.Номинал) Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрокаЗадолженности.ОснованиеЗадолженности = Продажа_РПИ_160522_132387 
				Или СтрокаЗадолженности.ОснованиеЗадолженности = Продажа_РПИ_270624_18_2 Тогда
				СтрокаЗадолженности.ПроцентыЭСП = СтрокаАктивы.Проценты + СтрокаАктивы.ПроцентыЭСП;
			ИначеЕсли СтрокаАктивы.Проценты <> 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При расчете задолженности для основания " + СтрокаАктивы.Актив + " по рыночной ставке обнаружены проценты",,,,Отказ);
				Возврат;
			Иначе
				СтрокаЗадолженности.ПроцентыЭСП = СтрокаАктивы.ПроцентыЭСП;
			КонецЕсли;
			
			СтрокаЗадолженности.СуммаРезерва = СтрокаАктивы.СуммаРезерва;
			СтрокаЗадолженности.АдресРасшифровкиДенежныхПотоков = СтрокаАктивы.АдресРасшифровкиДенежныхПотоков;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПолучитьСтоимостьМНОПоРыночнойСтавке(ТаблицаМНО, СчетДоверительногоУправления, Период, ЦельРасчета, МенеджерВременныхТаблиц = Неопределено, Отказ = Ложь) Экспорт
	
	Активы = ПолучитьТаблицуАктивов();
	
	Для Каждого СтрокаМНО Из ТаблицаМНО Цикл
		СтрокаАктивы = Активы.Добавить();
		СтрокаАктивы.Актив		= СтрокаМНО.МНО;
		СтрокаАктивы.ВидАктива	= Перечисления.ВидыАктивовДляПроверкиНаРыночность.МНО;
		СтрокаАктивы.Номинал	= СтрокаМНО.СуммаМНО;
		СтрокаАктивы.Проценты	= СтрокаМНО.ПроцентыМНО;
	КонецЦикла;
	
	ПолучитьСтоимостьАктивовПоРыночнойСтавке(Активы, СчетДоверительногоУправления, Период, ЦельРасчета, МенеджерВременныхТаблиц, Отказ);
	
	Для Каждого СтрокаАктивы Из Активы Цикл
		СтрокаМНО = ТаблицаМНО.Найти(СтрокаАктивы.Актив, "МНО");
		Если СтрокаМНО <> Неопределено Тогда
			СтрокаМНО.ПроцентыМНО = СтрокаАктивы.Проценты + СтрокаАктивы.ПроцентыЭСП;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ЕстьНастройкиПроверкиНаРыночность(СчетДоверительногоУправления, Период, ЦельРасчета, МассивВидовАктивов, МассивАктивов = Неопределено) Экспорт
	
	Если МассивАктивов = Неопределено Тогда
		МассивАктивов = Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период"						, Период);
	Запрос.УстановитьПараметр("Организация"					, СчетДоверительногоУправления.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦельРасчета"					, ЦельРасчета);
	Запрос.УстановитьПараметр("МассивВидовАктивов"			, МассивВидовАктивов);
	Запрос.УстановитьПараметр("МассивАктивов"				, МассивАктивов);
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&СчетДоверительногоУправления КАК Субъект
		|ПОМЕСТИТЬ _Субъекты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НастройкиРасчетаРыночнойСтавкиПоВидамАктивов.Субъект
		|ИЗ
		|	РегистрСведений.НастройкиРасчетаРыночнойСтавкиПоВидамАктивов КАК НастройкиРасчетаРыночнойСтавкиПоВидамАктивов
		|ГДЕ
		|	НастройкиРасчетаРыночнойСтавкиПоВидамАктивов.Субъект В(&МассивАктивов)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НастройкиЦелейРасчетаСрезПоследних.ВариантРасчетаОценочнойСтоимости
		|ИЗ
		|	РегистрСведений.НастройкиЦелейРасчета.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И ЦельРасчета = &ЦельРасчета
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиЦелейРасчетаСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиРасчетаРыночнойСтавкиПоВидамАктивовСрезПоследних.СхемаПроверкиСущественностиОтклонений КАК СхемаПроверкиСущественностиОтклонений
		|ИЗ
		|	РегистрСведений.НастройкиРасчетаРыночнойСтавкиПоВидамАктивов.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И ЦельРасчета = &ЦельРасчета
		|				И ВидАктива В (&МассивВидовАктивов)
		|				И Субъект В
		|					(ВЫБРАТЬ
		|						_Субъекты.Субъект КАК Субъект
		|					ИЗ
		|						_Субъекты КАК _Субъекты)) КАК НастройкиРасчетаРыночнойСтавкиПоВидамАктивовСрезПоследних
		|ГДЕ
		|	НЕ(НастройкиРасчетаРыночнойСтавкиПоВидамАктивовСрезПоследних.СхемаПроверкиСущественностиОтклонений = ЗНАЧЕНИЕ(Перечисление.СхемыПроверкиСущественностиОтклоненийПоДепозитнымВкладам.НеПроверять)
		|				И НастройкиРасчетаРыночнойСтавкиПоВидамАктивовСрезПоследних.МаксимальныйСрокАктиваДляИспользованияСхемы = 0)";
#КонецОбласти
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

#КонецОбласти

#Область СтоимостьПоРыночнойСтавке

//Получаем настройку определения ставки для каждого потока. Пока хардкодом, в регистр НастройкиРасчетаРыночнойСтавкиПоВидамАктивов не добавляли.
Функция ПолучитьВидыАктивовСОтдельнымиСтавкамиНаКаждыйПоток(СчетДоверительногоУправления, Период)
	
	ТекОрганизация = СчетДоверительногоУправления.Организация;
	
	//Актуально только для займов РПИ
	Если Период >= Дата(2021,7,1) 
		И ТекОрганизация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда
		
		ОтдельныеСтавкиПоПотокам = Новый ТаблицаЗначений();
		ОтдельныеСтавкиПоПотокам.Колонки.Добавить("СчетДоверительногоУправления");
		ОтдельныеСтавкиПоПотокам.Колонки.Добавить("ВидАктива");
		ОтдельныеСтавкиПоПотокам.Колонки.Добавить("ВидКонтрагента");
		ОтдельныеСтавкиПоПотокам.Колонки.Добавить("Валюта");
		
		СтрокаОтдельныеСтавкиПоПотокам = ОтдельныеСтавкиПоПотокам.Добавить();
		СтрокаОтдельныеСтавкиПоПотокам.СчетДоверительногоУправления = СчетДоверительногоУправления;
		СтрокаОтдельныеСтавкиПоПотокам.ВидАктива = Перечисления.ВидыАктивовДляПроверкиНаРыночность.ЗаймыВыданные;
		СтрокаОтдельныеСтавкиПоПотокам.ВидКонтрагента = Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо;
		СтрокаОтдельныеСтавкиПоПотокам.Валюта = ТекОрганизация.ВалютаУчета;
		
		СтрокаОтдельныеСтавкиПоПотокам = ОтдельныеСтавкиПоПотокам.Добавить();
		СтрокаОтдельныеСтавкиПоПотокам.СчетДоверительногоУправления = СчетДоверительногоУправления;
		СтрокаОтдельныеСтавкиПоПотокам.ВидАктива = Перечисления.ВидыАктивовДляПроверкиНаРыночность.ЗаймыВыданные;
		СтрокаОтдельныеСтавкиПоПотокам.ВидКонтрагента = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо;
		СтрокаОтдельныеСтавкиПоПотокам.Валюта = ТекОрганизация.ВалютаУчета;
		
		СтрокаОтдельныеСтавкиПоПотокам = ОтдельныеСтавкиПоПотокам.Добавить();
		СтрокаОтдельныеСтавкиПоПотокам.СчетДоверительногоУправления = СчетДоверительногоУправления;
		СтрокаОтдельныеСтавкиПоПотокам.ВидАктива = Перечисления.ВидыАктивовДляПроверкиНаРыночность.КредиторскаяЗадолженность;
		СтрокаОтдельныеСтавкиПоПотокам.ВидКонтрагента = Неопределено;
		СтрокаОтдельныеСтавкиПоПотокам.Валюта = ТекОрганизация.ВалютаУчета;
		
		СтрокаОтдельныеСтавкиПоПотокам = ОтдельныеСтавкиПоПотокам.Добавить();
		СтрокаОтдельныеСтавкиПоПотокам.СчетДоверительногоУправления = СчетДоверительногоУправления;
		СтрокаОтдельныеСтавкиПоПотокам.ВидАктива = Перечисления.ВидыАктивовДляПроверкиНаРыночность.ДебиторскаяЗадолженность;
		СтрокаОтдельныеСтавкиПоПотокам.ВидКонтрагента = Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо;
		СтрокаОтдельныеСтавкиПоПотокам.Валюта = ТекОрганизация.ВалютаУчета;
		
		Возврат ОтдельныеСтавкиПоПотокам;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция НужныОтдельныеСтавкиПоПотокам(СчетДоверительногоУправления, Актив, ВидАктива, ВидыАктивовСОтдельнымиСтавкамиНаКаждыйПоток) Экспорт
	
	//хардкод! Для остальных видов активов пока не надо
	Если ТипЗнч(Актив) = Тип("СправочникСсылка.Займы") Тогда	
		
		ДанныеКредитногоИнструмента = РаботаСКредитнымиИнструментами.ПолучитьДанныеКредитногоИнструмента(Актив); 
		ВидКонтрагента = ДанныеКредитногоИнструмента.Контрагент.ВидЮрФизЛица;
		ВалютаАктива = Актив.Валюта;
		
	ИначеЕсли ТипЗнч(Актив) = Тип("ДокументСсылка.СделкаСНедвижимостью") Тогда
		
		Если ВидАктива = Перечисления.ВидыАктивовДляПроверкиНаРыночность.КредиторскаяЗадолженность Тогда
			ВидКонтрагента = Неопределено;
		Иначе
			ВидКонтрагента = Актив.Контрагент.ВидЮрФизЛица;
		КонецЕсли;	
		ВалютаАктива = ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");
		
	ИначеЕсли Справочники.Договоры.ЭтоИнвестконтракт(Актив) Тогда
		
		Если ВидАктива = Перечисления.ВидыАктивовДляПроверкиНаРыночность.КредиторскаяЗадолженность Тогда
			ВидКонтрагента = Неопределено;
		Иначе
			ВидКонтрагента = Актив.Контрагент.ВидЮрФизЛица;
		КонецЕсли;	
		ВалютаАктива = ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	СтрокиПоВидуАктива = ВидыАктивовСОтдельнымиСтавкамиНаКаждыйПоток.НайтиСтроки(Новый Структура("ВидАктива, СчетДоверительногоУправления, ВидКонтрагента, Валюта", 
		ВидАктива, СчетДоверительногоУправления, ВидКонтрагента, ВалютаАктива));
	
	Если СтрокиПоВидуАктива.Количество() > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ДатыИзмененияПравилСЧА(СчетДоверительногоУправления, Период)
	
	ТаблицаДополнительныхДат = Новый ТаблицаЗначений;
	ТаблицаДополнительныхДат.Колонки.Добавить("ВидАктива", 		Новый ОписаниеТипов("ПеречислениеСсылка.ВидыАктивовДляПроверкиНаРыночность"));
	ТаблицаДополнительныхДат.Колонки.Добавить("Дата", 			Новый ОписаниеТипов("Дата"));
	ТаблицаДополнительныхДат.Колонки.Добавить("КодСобытия",		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3)));
	ТаблицаДополнительныхДат.Колонки.Добавить("ОписаниеСобытия",Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	
	Если СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
	
		Если СчетДоверительногоУправления.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ")
			ИЛИ СчетДоверительногоУправления.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ")
			ИЛИ СчетДоверительногоУправления.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ")
		Тогда	
		
		    // #381040: добавлены даты проверки рыночности ставки дисконтирования в связи с изменением правил определения СЧА в части изменения вида рыночной ставки
		
			ДополнительнаяДата = ТаблицаДополнительныхДат.Добавить();
			ДополнительнаяДата.ВидАктива		= Перечисления.ВидыАктивовДляПроверкиНаРыночность.ЗаймыВыданные;
			ДополнительнаяДата.Дата 			= Дата(2021,7,1);
			ДополнительнаяДата.КодСобытия		= 0;
			ДополнительнаяДата.ОписаниеСобытия	= "Изменение правил";
			
			ДополнительнаяДата = ТаблицаДополнительныхДат.Добавить();
			ДополнительнаяДата.ВидАктива		= Перечисления.ВидыАктивовДляПроверкиНаРыночность.ОбратноеРЕПО;
			ДополнительнаяДата.Дата				= Дата(2021,7,1);
			ДополнительнаяДата.КодСобытия		= 0;
			ДополнительнаяДата.ОписаниеСобытия	= "Изменение правил";
			
		КонецЕсли;
		
		Если СчетДоверительногоУправления.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ")
			И (СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ЗПИФИскра") 
				ИЛИ СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ЗПИФФаренгейт")) 
		Тогда
		
			ДополнительнаяДата = ТаблицаДополнительныхДат.Добавить();
			ДополнительнаяДата.ВидАктива		= Перечисления.ВидыАктивовДляПроверкиНаРыночность.ДебиторскаяЗадолженность;
			ДополнительнаяДата.Дата 			= Дата(2024,2,7);
			ДополнительнаяДата.КодСобытия		= 0;
			ДополнительнаяДата.ОписаниеСобытия	= "Изменение правил";
		
		КонецЕсли;
			
	КонецЕсли;
	
	Если ТаблицаДополнительныхДат.Количество() > 0 Тогда
		
		// Если есть строки, свернём таблицу, оставим только последние даты перед &Период
		// Также на эту дату вычислим описание события с минимальны кодом (ниже код -выше приоритет) - нужно для расшифровки
		
		Запрос = Новый Запрос;
		
		Запрос.УстановитьПараметр("ТаблицаДополнительныхДат", ТаблицаДополнительныхДат);
		Запрос.УстановитьПараметр("Период"					, Период);
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТаблицаДополнительныхДат.ВидАктива КАК ВидАктива,
			|	ТаблицаДополнительныхДат.Дата КАК Дата,
			|	ТаблицаДополнительныхДат.КодСобытия КАК КодСобытия,
			|	ТаблицаДополнительныхДат.ОписаниеСобытия КАК ОписаниеСобытия
			|ПОМЕСТИТЬ _ТаблицаДополнительныхДат
			|ИЗ
			|	&ТаблицаДополнительныхДат КАК ТаблицаДополнительныхДат
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ВложенныйЗапрос.ВидАктива КАК ВидАктива,
			|	ВложенныйЗапрос.Дата КАК Дата,
			|	ВложенныйЗапрос.КодСобытия КАК КодСобытия,
			|	_ТаблицаДополнительныхДат.ОписаниеСобытия КАК ОписаниеСобытия
			|ИЗ
			|	(ВЫБРАТЬ
			|		ВложенныйЗапрос.ВидАктива КАК ВидАктива,
			|		ВложенныйЗапрос.Дата КАК Дата,
			|		МИНИМУМ(_ТаблицаДополнительныхДат.КодСобытия) КАК КодСобытия
			|	ИЗ
			|		(ВЫБРАТЬ
			|			_ТаблицаДополнительныхДат.ВидАктива КАК ВидАктива,
			|			МАКСИМУМ(_ТаблицаДополнительныхДат.Дата) КАК Дата
			|		ИЗ
			|			_ТаблицаДополнительныхДат КАК _ТаблицаДополнительныхДат
			|		ГДЕ
			|			_ТаблицаДополнительныхДат.Дата <= &Период
			|		
			|		СГРУППИРОВАТЬ ПО
			|			_ТаблицаДополнительныхДат.ВидАктива) КАК ВложенныйЗапрос
			|			ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаДополнительныхДат КАК _ТаблицаДополнительныхДат
			|			ПО ВложенныйЗапрос.ВидАктива = _ТаблицаДополнительныхДат.ВидАктива
			|				И ВложенныйЗапрос.Дата = _ТаблицаДополнительныхДат.Дата
			|	
			|	СГРУППИРОВАТЬ ПО
			|		ВложенныйЗапрос.ВидАктива,
			|		ВложенныйЗапрос.Дата) КАК ВложенныйЗапрос
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаДополнительныхДат КАК _ТаблицаДополнительныхДат
			|		ПО ВложенныйЗапрос.ВидАктива = _ТаблицаДополнительныхДат.ВидАктива
			|			И ВложенныйЗапрос.Дата = _ТаблицаДополнительныхДат.Дата
			|			И ВложенныйЗапрос.КодСобытия = _ТаблицаДополнительныхДат.КодСобытия"; 
		
		ТаблицаДополнительныхДат = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	Возврат ТаблицаДополнительныхДат;

КонецФункции

Функция ПолучитьСтоимостьАктивовПоРыночнойСтавке(Активы, СчетДоверительногоУправления, Период, ЦельРасчета, МенеджерВременныхТаблиц = Неопределено, Отказ)
	
	ЭтоРасшифровка = (МенеджерВременныхТаблиц <> Неопределено И МенеджерВременныхТаблиц.Таблицы.Найти("_РасшифровкаСтоимостиАктивовПоРыночнойСтавке") <> Неопределено);

	Организация = СчетДоверительногоУправления.Организация;
	Клиент		= Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период);
	
	НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(Период, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, ЦельРасчета, Истина);
																
	#Область Получение_даты_определения_СЧА
																
	Если ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении 
		ИЛИ ЦельРасчета = Справочники.ЦелиРасчета.БухгалтерскийУчет
	Тогда
		
