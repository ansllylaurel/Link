//помещает во временную таблицу _ДатыСменыСрокаПолнойОплаты 
//	последнюю дату изменения срока полной оплаты и срок полной оплаты 
//	по основаниям таблицы _ЗадолженностиПоДенежнымСредствамОстатки, 
//	для которых плановые даты оплаты задаются графиком
Процедура РассчитатьДатыИзмененияСрокаПолногоПогашенияЗадолженностейПоГрафику(Запрос)
	
	//В подзапрос _ПолныеДанныеГрафика собираются полные данные графика, 
	//		соответствующие каждой дате изменений (Период), ограниченные по &КонецПериода
	//Во временную таблицу _ДатыИзмененийИСрокиВыплатыПоГрафику помещается 
	//		максимальная дата платежа (срок полной оплаты) для каждой даты изменний
	// Пример данных в таблице _ДатыИзмененийИСрокиВыплатыПоГрафику на примере одного основания:
	//	Период 		ДатаПлатежа
	//	31.03.2021	01.06.2023
	//	06.07.2021	31.12.2025
	//	07.02.2022	31.12.2025
	//	30.09.2022	31.12.2025
	//	24.05.2023	30.06.2024
	//Далее в подзапрос _ДатыСменыУсловийСПериодами помещаются даты смены условий для каждого периода. 
	//		Если смены условий не было, то устанавливается дата первых условий
	//Для приведенного выше примера _ДатыСменыУсловийСПериодами будет содержать:
	//	Период 		ДатаСменыУсловий
	//	31.03.2021	06.07.2021
	//	06.07.2021	24.05.2023
	//	07.02.2022	24.05.2023
	//	30.09.2022	24.05.2023
	//	24.05.2023	NULL
	//В подзапрос _ДатыСменыСрокаПолнойОплаты для каждого основания помещается самая поздняя дата смены условий
	//Для примера:
	//	 ДатаСменыУсловий
	//	 24.05.2023
	//Во временную таблицу _ДатыСменыСрокаПолнойОплаты помещается дата смены условия 
	//	и соответствующий ей срок полной оплаты
	//Для примера:
	//	 ДатаСменыУсловий	ДатаПлатежа
	//	 24.05.2023         30.06.2024
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПолныеДанныеГрафика.Основание КАК Основание,
		|	_ПолныеДанныеГрафика.Период КАК Период,
		|	МАКСИМУМ(_ПолныеДанныеГрафика.ДатаПлатежа) КАК ДатаПлатежа
		|ПОМЕСТИТЬ _ДатыИзмененийИСрокиВыплатыПоГрафику
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ДатыСменыГрафика.Основание КАК Основание,
		|		_ДатыСменыГрафика.Период КАК Период,
		|		_ДатыСменыГрафика.ДатаПлатежа КАК ДатаПлатежа,
		|		ГрафикиПлатежей.Действует КАК Действует
		|	ИЗ
		|		(ВЫБРАТЬ
		|			ГрафикиПлатежей.Основание КАК Основание,
		|			ГрафикиПлатежей.Период КАК Период,
		|			ГрафикиПлатежей1.ДатаПлатежа КАК ДатаПлатежа,
		|			МАКСИМУМ(ГрафикиПлатежей1.Период) КАК МаксимальнаяДатаУстановкиПотока
		|		ИЗ
		|			_ЗадолженностиПоДенежнымСредствамОстатки КАК _ЗадолженностиПоДенежнымСредствамОстатки
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикиПлатежей КАК ГрафикиПлатежей
		|				ПО _ЗадолженностиПоДенежнымСредствамОстатки.Основание = ГрафикиПлатежей.Основание
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикиПлатежей КАК ГрафикиПлатежей1
		|				ПО (ГрафикиПлатежей.Основание = ГрафикиПлатежей1.Основание)
		|					И (ГрафикиПлатежей.Период >= ГрафикиПлатежей1.Период)
		|					И (ГрафикиПлатежей.Период <= &КонецПериода)
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ГрафикиПлатежей.Основание,
		|			ГрафикиПлатежей.Период,
		|			ГрафикиПлатежей1.ДатаПлатежа) КАК _ДатыСменыГрафика
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикиПлатежей КАК ГрафикиПлатежей
		|			ПО _ДатыСменыГрафика.Основание = ГрафикиПлатежей.Основание
		|				И _ДатыСменыГрафика.ДатаПлатежа = ГрафикиПлатежей.ДатаПлатежа
		|				И _ДатыСменыГрафика.МаксимальнаяДатаУстановкиПотока = ГрафикиПлатежей.Период
		|				И (ГрафикиПлатежей.Действует)) КАК _ПолныеДанныеГрафика
		|
		|СГРУППИРОВАТЬ ПО
		|	_ПолныеДанныеГрафика.Основание,
		|	_ПолныеДанныеГрафика.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДатыСменыСрокаПолнойОплаты.Основание КАК Основание,
		|	_ДатыСменыСрокаПолнойОплаты.ДатаСменыУсловий КАК ДатаСменыУсловий,
		|	_ДатыИзмененийИСрокиВыплатыПоГрафику.ДатаПлатежа КАК ДатаПлатежа
		|ПОМЕСТИТЬ _ДатыСменыСрокаПолнойОплаты
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ДатыСменыУсловийСПериодами.Основание КАК Основание,
		|		ЕСТЬNULL(МАКСИМУМ(_ДатыСменыУсловийСПериодами.ДатаСменыУсловий), МИНИМУМ(_ДатыСменыУсловийСПериодами.Период)) КАК ДатаСменыУсловий
		|	ИЗ
		|		(ВЫБРАТЬ
		|			_ДатыИзмененийИСрокиВыплаты.Основание КАК Основание,
		|			_ДатыИзмененийИСрокиВыплаты.Период КАК Период,
		|			МИНИМУМ(_ДатыИзмененийИСрокиВыплаты1.Период) КАК ДатаСменыУсловий
		|		ИЗ
		|			_ДатыИзмененийИСрокиВыплатыПоГрафику КАК _ДатыИзмененийИСрокиВыплаты
		|				ЛЕВОЕ СОЕДИНЕНИЕ _ДатыИзмененийИСрокиВыплатыПоГрафику КАК _ДатыИзмененийИСрокиВыплаты1
		|				ПО _ДатыИзмененийИСрокиВыплаты.Основание = _ДатыИзмененийИСрокиВыплаты1.Основание
		|					И _ДатыИзмененийИСрокиВыплаты.Период < _ДатыИзмененийИСрокиВыплаты1.Период
		|					И _ДатыИзмененийИСрокиВыплаты.ДатаПлатежа <> _ДатыИзмененийИСрокиВыплаты1.ДатаПлатежа
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_ДатыИзмененийИСрокиВыплаты.Основание,
		|			_ДатыИзмененийИСрокиВыплаты.Период) КАК _ДатыСменыУсловийСПериодами
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ДатыСменыУсловийСПериодами.Основание) КАК _ДатыСменыСрокаПолнойОплаты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДатыИзмененийИСрокиВыплатыПоГрафику КАК _ДатыИзмененийИСрокиВыплатыПоГрафику
		|		ПО _ДатыСменыСрокаПолнойОплаты.Основание = _ДатыИзмененийИСрокиВыплатыПоГрафику.Основание
		|			И _ДатыСменыСрокаПолнойОплаты.ДатаСменыУсловий = _ДатыИзмененийИСрокиВыплатыПоГрафику.Период";
	
	Запрос.Выполнить();
	
КонецПроцедуры

Функция РассчитатьСправедливыеСтоимостиЗадолженностей(Параметры, Запрос, Отказ, МенеджерВременныхТаблицРасшифровки = Неопределено) Экспорт
	
	Если Запрос = Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос.УстановитьПараметр("Организация", 				  	Параметры.Организация);
		Запрос.УстановитьПараметр("Период", 				  	  	Новый Граница(КонецДня(Параметры.Период), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("КонецПериода", 				  	КонецДня(Параметры.Период));
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	Параметры.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ВариантРасчетаОценочнойСтоимости",  	Параметры.ВариантРасчетаОценочнойСтоимости);
		
		Справочники.ВариантыРасчетаОценочнойСтоимости.ПолучитьЗадолженностиПоСделкамСРаздельнымИсполнением(
			Параметры.ВариантРасчетаОценочнойСтоимости,
			Параметры.Организация,
			Параметры.СчетДоверительногоУправления, 
			Параметры.Период,
			Параметры.ЦельРасчета,
			Отказ,
			Запрос.МенеджерВременныхТаблиц);
			
		СтоимостиПросроченнойДебиторки = РаботаСКредитнымиИнструментами.ПолучитьСтоимостиПросроченныхЗаймовПоСчетуДоверительногоУправления(
			Параметры.СчетДоверительногоУправления,
			КонецДня(Параметры.Период),
			Ложь, ,
			Отказ);
		
		СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(СтоимостиПросроченнойДебиторки, "_СтоимостиПросроченнойДебиторки0", Запрос.МенеджерВременныхТаблиц);

		Справочники.ВариантыРасчетаОценочнойСтоимости.ПоместитьЗадолженностиПоДенежнымСредствамВМенеджерВременныхТаблиц(Запрос);
	КонецЕсли;
	
	РассчитатьДатыИзмененияСрокаПолногоПогашенияЗадолженностейПоГрафику(Запрос);
	
	//отбираем неоперационую задолженность
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ОснованиеЗадолженности КАК ОснованиеЗадолженности,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент,
		|	СУММА(_ЗадолженностиПоДенежнымСредствамОстатки.Сумма) КАК Сумма,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ДатаПогашения КАК ДатаПогашения,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ДатаВозникновения КАК ДатаРегистрации,
		|	0 КАК ПроцентыЭСП,
		|	0 КАК СуммаРезерва
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
		|		_ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|		_ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|		_ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК ОснованиеЗадолженности,
		|		_ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент,
		|		_ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + _ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК Сумма,
		|		ВЫБОР
		|			КОГДА _ЗадолженностиПоДенежнымСредствамОстатки.Основание ССЫЛКА Документ.ЗакрытиеКредитногоИнструмента
		|				ТОГДА ВЫРАЗИТЬ(_ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ЗакрытиеКредитногоИнструмента).Дата
		|			КОГДА _ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|					И НЕ ПлановыеДатыОплатСрезПоследних.ДатаОплаты ЕСТЬ NULL
		|				ТОГДА ПлановыеДатыОплатСрезПоследних.ДатаОплаты
		|			КОГДА _ЗадолженностиПоДенежнымСредствамОстатки.Основание ССЫЛКА Документ.НачислениеЗадолженности
		|					И НЕ ПлановыеДатыОплатСрезПоследних.ДатаОплаты ЕСТЬ NULL
		|				ТОГДА ПлановыеДатыОплатСрезПоследних.ДатаОплаты
		|			КОГДА _ЗадолженностиПоДенежнымСредствамОстатки.Основание ССЫЛКА Документ.ПриходПроцентовПоКредитномуИнструменту
		|					И НЕ ПлановыеДатыОплатСрезПоследних.ДатаОплаты ЕСТЬ NULL
		|				ТОГДА ПлановыеДатыОплатСрезПоследних.ДатаОплаты
		|			ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|		КОНЕЦ КАК ДатаПогашения,
		|		ВЫБОР
		|			КОГДА _ЗадолженностиПоДенежнымСредствамОстатки.Основание ССЫЛКА Документ.ЗакрытиеКредитногоИнструмента
		|				ТОГДА ВЫРАЗИТЬ(_ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ЗакрытиеКредитногоИнструмента).Дата
		|			КОГДА _ЗадолженностиПоДенежнымСредствамОстатки.Основание ССЫЛКА Документ.НачислениеЗадолженности
		|				ТОГДА ВЫРАЗИТЬ(_ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.НачислениеЗадолженности).Дата
		|			КОГДА _ЗадолженностиПоДенежнымСредствамОстатки.Основание ССЫЛКА Документ.ПриходПроцентовПоКредитномуИнструменту
		|				ТОГДА ВЫРАЗИТЬ(_ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПриходПроцентовПоКредитномуИнструменту).Дата
		|			ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|		КОНЕЦ КАК ДатаВозникновения
		|	ИЗ
		|		_ЗадолженностиПоДенежнымСредствамОстатки КАК _ЗадолженностиПоДенежнымСредствамОстатки
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыеДатыОплат.СрезПоследних(
		|					&Период,
		|					Организация = &Организация
		|						И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|						И (Основание, ВидЗадолженности, Валюта) В
		|							(ВЫБРАТЬ
		|								_ЗадолженностиПоДенежнымСредствамОстатки.Основание,
		|								_ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности,
		|								_ЗадолженностиПоДенежнымСредствамОстатки.Валюта
		|							ИЗ
		|								_ЗадолженностиПоДенежнымСредствамОстатки КАК _ЗадолженностиПоДенежнымСредствамОстатки)) КАК ПлановыеДатыОплатСрезПоследних
		|			ПО _ЗадолженностиПоДенежнымСредствамОстатки.Основание = ПлановыеДатыОплатСрезПоследних.Основание
		|				И _ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности = ПлановыеДатыОплатСрезПоследних.ВидЗадолженности
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
		|			ПО _ЗадолженностиПоДенежнымСредствамОстатки.Основание = НачислениеЗадолженности.Ссылка
		|				И (НачислениеЗадолженности.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоАренде), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоАрендеПеременнаяЧасть)))
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
		|			ПО (НачислениеЗадолженности.Договор = Договоры.Ссылка)
		|				И (Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.Аренды))
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОбесценениеАктивов.СрезПоследних(
		|					&Период,
		|					Организация = &Организация
		|						И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|						И ТИПЗНАЧЕНИЯ(Актив) = ТИП(Справочник.Договоры)) КАК ОбесценениеАктивовСрезПоследних
		|			ПО (Договоры.Ссылка = ОбесценениеАктивовСрезПоследних.Актив)
		|			ЛЕВОЕ СОЕДИНЕНИЕ _ДатыСменыСрокаПолнойОплаты КАК _ДатыСменыСрокаПолнойОплаты
		|			ПО _ЗадолженностиПоДенежнымСредствамОстатки.Основание = _ДатыСменыСрокаПолнойОплаты.Основание
		|	ГДЕ
		|		ВЫБОР
		|				КОГДА &ВариантРасчетаОценочнойСтоимости = ЗНАЧЕНИЕ(Справочник.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ_УКПИ)
		|					ТОГДА ВЫБОР
		|							КОГДА _ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|									И _ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоЗайму), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоЗаймуПроценты))
		|								ТОГДА _ЗадолженностиПоДенежнымСредствамОстатки.Основание ССЫЛКА Документ.ЗакрытиеКредитногоИнструмента
		|										ИЛИ _ЗадолженностиПоДенежнымСредствамОстатки.Основание ССЫЛКА Документ.ПриходПроцентовПоКредитномуИнструменту
		|							КОГДА _ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|									И _ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоАренде), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоАрендеПеременнаяЧасть))
		|									И ЕСТЬNULL(ОбесценениеАктивовСрезПоследних.Коэффициент, 1) <> 1
		|								ТОГДА _ЗадолженностиПоДенежнымСредствамОстатки.Основание ССЫЛКА Документ.НачислениеЗадолженности
		|							КОГДА _ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|									И _ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоИнвестконтракту))
		|									И _ЗадолженностиПоДенежнымСредствамОстатки.Основание ССЫЛКА Документ.СделкаСНедвижимостью
		|								ТОГДА &КонецПериода < ДАТАВРЕМЯ(2023, 9, 1)
		|										ИЛИ ДОБАВИТЬКДАТЕ(ЕСТЬNULL(_ДатыСменыСрокаПолнойОплаты.ДатаСменыУсловий, ДАТАВРЕМЯ(1, 1, 1)), ГОД, 1) < ЕСТЬNULL(_ДатыСменыСрокаПолнойОплаты.ДатаПлатежа, ДАТАВРЕМЯ(1, 1, 1))
		|							КОГДА _ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|									И _ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПолучениюВАренду))
		|								ТОГДА _ЗадолженностиПоДенежнымСредствамОстатки.Основание ССЫЛКА Документ.СделкаСНедвижимостью
