// МАССИВЫ

Функция ЗначениеВМассив(Значение) Экспорт
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	Иначе
		Массив = Новый Массив;
		Массив.Добавить(Значение);
		Возврат Массив;
	КонецЕсли;
КонецФункции

Функция ЗначенияВМассив(Значение1 = "#ЗначениеНеПередано#", Значение2 = "#ЗначениеНеПередано#", Значение3 = "#ЗначениеНеПередано#", Значение4 = "#ЗначениеНеПередано#", Значение5 = "#ЗначениеНеПередано#", Значение6 = "#ЗначениеНеПередано#", Значение7 = "#ЗначениеНеПередано#", Значение8 = "#ЗначениеНеПередано#", Значение9 = "#ЗначениеНеПередано#") Экспорт

	Массив = Новый Массив;
	
	Если Значение1 <> "#ЗначениеНеПередано#" Тогда Массив.Добавить(Значение1) КонецЕсли;
	Если Значение2 <> "#ЗначениеНеПередано#" Тогда Массив.Добавить(Значение2) КонецЕсли;
	Если Значение3 <> "#ЗначениеНеПередано#" Тогда Массив.Добавить(Значение3) КонецЕсли;
	Если Значение4 <> "#ЗначениеНеПередано#" Тогда Массив.Добавить(Значение4) КонецЕсли;
	Если Значение5 <> "#ЗначениеНеПередано#" Тогда Массив.Добавить(Значение5) КонецЕсли;
	Если Значение6 <> "#ЗначениеНеПередано#" Тогда Массив.Добавить(Значение6) КонецЕсли;
	Если Значение7 <> "#ЗначениеНеПередано#" Тогда Массив.Добавить(Значение7) КонецЕсли;
	Если Значение8 <> "#ЗначениеНеПередано#" Тогда Массив.Добавить(Значение8) КонецЕсли;
	Если Значение9 <> "#ЗначениеНеПередано#" Тогда Массив.Добавить(Значение9) КонецЕсли;
	
	Возврат Массив;

КонецФункции

Процедура УдалитьПовторяющиесяЗначенияМассива(Массив) Экспорт
	
	НовыйМассив = Новый Массив;
	
	ДополнитьМассив(НовыйМассив, Массив, Истина);
	
	Массив = НовыйМассив;
	
КонецПроцедуры

// Дополняет массив отдельным значением или значениями из другого массива
//
// Параметры:
//  МассивПриемник				- Массив									- массив, в который необходимо добавить значения
//  Источник					- Произвольный, Массив, ФиксированныйМассив	- отдельное значение или массив значений для заполнения
//  ТолькоУникальныеЗначения	- Булево									- если истина, то в массив будут включены только уникальные значения
//
Процедура ДополнитьМассив(МассивПриемник, Источник, ТолькоУникальныеЗначения = Ложь) Экспорт
	
	Если ТипЗнч(Источник) = Тип("Массив") ИЛИ ТипЗнч(Источник) = Тип("ФиксированныйМассив") Тогда
		
		// Дополняется массивом
		
		Если ТолькоУникальныеЗначения Тогда
			
			УникальныеЗначения = Новый Соответствие;
			
			Для Каждого Значение Из МассивПриемник Цикл
				УникальныеЗначения.Вставить(Значение, Истина);
			КонецЦикла;
			
			Для Каждого Значение Из Источник Цикл
				Если УникальныеЗначения[Значение] = Неопределено Тогда
					МассивПриемник.Добавить(Значение);
					УникальныеЗначения.Вставить(Значение, Истина);
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			
			Для Каждого Значение Из Источник Цикл
				МассивПриемник.Добавить(Значение);
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе

		// Дополняется отдельным значением	
		
		Если Не ТолькоУникальныеЗначения
			ИЛИ МассивПриемник.Найти(Источник) = Неопределено
		Тогда
			МассивПриемник.Добавить(Источник);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

