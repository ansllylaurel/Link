// СТРУКТУРА

// Возвращает копию структуры
//
// Параметры:
//   Структура			- Структура					- коллекция, из которой будут считываться свойства для копирования
//   ТолькоКлючи		- Булево					- при Истина копируются только ключи свойств
//   СписокСвойств		- Массив, Структура, Строка	- копируемые свойства (если строка, то список имен свойств, разделенный запятыми)
//   ИсключаяСвойства	- Массив, Структура, Строка	- исключаемые свойства (если строка, то список имен свойств, разделенный запятыми)
//
// Возвращаемое значение:
//	Структура - скопированная структура
//
Функция СкопироватьСтруктуру(Структура, ТолькоКлючи = Ложь, СписокСвойств = Неопределено, ИсключаяСвойства = Неопределено) Экспорт
	
	#Область Заполняем_структуры_включаемых_или_исключаемых_свойств
	
	Если ТипЗнч(СписокСвойств) = Тип("Массив") Тогда
		ВключаемыеСвойства = Новый Структура;
		Для Каждого Ключ Из СписокСвойств Цикл
			ВключаемыеСвойства.Вставить(Ключ);
		КонецЦикла;
	ИначеЕсли ТипЗнч(СписокСвойств) = Тип("Строка") Тогда
		ВключаемыеСвойства = Новый Структура(СписокСвойств);
	Иначе
		ВключаемыеСвойства = СписокСвойств;
	КонецЕсли;	
	
	Если ТипЗнч(ИсключаяСвойства) = Тип("Массив") Тогда
		ИсключаемыеСвойства = Новый Структура;
		Для Каждого Ключ Из ИсключаяСвойства Цикл
			ИсключаемыеСвойства.Вставить(Ключ);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ИсключаяСвойства) = Тип("Строка") Тогда
		ИсключаемыеСвойства = Новый Структура(ИсключаяСвойства);
	Иначе
		ИсключаемыеСвойства = ИсключаяСвойства;
	КонецЕсли;
	
	#КонецОбласти
	
	КопияСтруктуры = Новый Структура;
	
	Для каждого КлючЗнч Из Структура Цикл
		Если (ВключаемыеСвойства = Неопределено ИЛИ ВключаемыеСвойства.Свойство(КлючЗнч.Ключ))
			И (ИсключаемыеСвойства = Неопределено ИЛИ Не ИсключаемыеСвойства.Свойство(КлючЗнч.Ключ))
		Тогда
			КопияСтруктуры.Вставить(КлючЗнч.Ключ, ?(ТолькоКлючи, Неопределено, КлючЗнч.Значение));
		КонецЕсли;
	КонецЦикла;
	
	Возврат КопияСтруктуры;
	
КонецФункции

Функция СтруктурыИдентичны(Структура1, Структура2, ТолькоПоЗначениямОбщихКлючей = Ложь) Экспорт
	
	Для каждого КлючЗнч Из Структура1 Цикл
		Если Не Структура2.Свойство(КлючЗнч.Ключ) Тогда // отсутствует во 2-й структуре
			Если ТолькоПоЗначениямОбщихКлючей Тогда
				Продолжить;
			Иначе
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Если Структура1[КлючЗнч.Ключ] <> Структура2[КлючЗнч.Ключ] Тогда // значения различаются
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ТолькоПоЗначениямОбщихКлючей Тогда
		Для каждого КлючЗнч Из Структура2 Цикл
			Если Не Структура1.Свойство(КлючЗнч.Ключ) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции // СтруктурыИдентичны

Процедура ДобавитьНовыйЭлементВСтруктуру(Структура, Ключ, Значение) Экспорт
	
	Если Не Структура.Свойство(Ключ) Тогда
		Структура.Вставить(Ключ, Значение);
	КонецЕсли;
	
КонецПроцедуры // ДобавитьНовыйЭлементВСтруктуру

// Возвращает значение свойства структуры.
//
// Параметры:
//   Структура - Структура
//             - ФиксированнаяСтруктура - объект, из которого необходимо прочитать значение ключа.
//   Ключ - Строка - имя свойства структуры, для которого необходимо прочитать значение.
//   ЗначениеПоУмолчанию - Произвольный - возвращается когда в структуре нет значения по указанному
//                                        ключу.
//       Для скорости рекомендуется передавать только быстро вычисляемые значения (например примитивные типы),
//       а инициализацию более тяжелых значений выполнять после проверки полученного значения (только если это
//       требуется).
//
// Возвращаемое значение:
//   Произвольный - значение свойства структуры. ЗначениеПоУмолчанию если в структуре нет указанного свойства.
//
Функция СвойствоСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Если Структура = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Результат = ЗначениеПоУмолчанию;
	Если Структура.Свойство(Ключ, Результат) Тогда
		Возврат Результат;
	Иначе
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
КонецФункции

// Дополняет структуру значениями из другой структуры.
//
// Параметры:
//   Приемник - Структура - коллекция, в которую будут добавляться новые значения.
//   Источник - Структура - коллекция, из которой будут считываться пары Ключ и Значение для заполнения.
//   Заменять - Булево, Неопределено - Что делать в местах пересечения ключей источника и приемника:
//                                       Истина - Заменять значения приемника (самый быстрый способ),
//                                       Ложь   - Не заменять значения приемника (пропускать),
//                                       Неопределено - Значение по умолчанию. Бросать исключение.
//
Процедура ДополнитьСтруктуру(Приемник, Источник, Заменять = Неопределено) Экспорт
	
	Для Каждого Элемент Из Источник Цикл
		Если Заменять <> Истина И Приемник.Свойство(Элемент.Ключ) Тогда
			Если Заменять = Ложь Тогда
				Продолжить;
			Иначе
				ВызватьИсключение РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Пересечение ключей источника и приемника: ""%1"".'"), Элемент.Ключ);
			КонецЕсли
		КонецЕсли;
		Приемник.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
КонецПроцедуры

