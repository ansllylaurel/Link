// ДЕРЕВЬЯ ЗНАЧЕНИЙ

Процедура ДеревоЗначений_ЗаполнитьИзДерева(ДеревоПриемник, ДеревоИсточник, ОчищатьПередЗаполнением = Истина) Экспорт
	
	Если ОчищатьПередЗаполнением Тогда
		ДеревоПриемник.Строки.Очистить();
	КонецЕсли;
	
	Для каждого СтрокаДеревоИсточник Из ДеревоИсточник.Строки Цикл
		СтрокаДеревоПриемник = ДеревоПриемник.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДеревоПриемник, СтрокаДеревоИсточник);
		
		ДеревоЗначений_ЗаполнитьИзДерева(СтрокаДеревоПриемник, СтрокаДеревоИсточник, Ложь);
	КонецЦикла;
		
КонецПроцедуры // ДеревоЗначений_ЗаполнитьИзДерева

Процедура ДеревоЗначений_ЗаполнитьИзВыборки(Дерево, Выборка) Экспорт
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрокаНастройки = Дерево.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаНастройки, Выборка);
		//НоваяСтрокаНастройки.Значение = Выборка.Настройка.ТипЗначения.ПривестиЗначение(Выборка.Значение);
		
		СтрокиВыборки = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		Если СтрокиВыборки.Количество() > 0 Тогда
			ДеревоЗначений_ЗаполнитьИзВыборки(НоваяСтрокаНастройки.ПолучитьЭлементы(), СтрокиВыборки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ДеревоЗначений_ЗаполнитьИзВыборки

Функция ДеревоЗначений_ПолучитьВетку(Дерево, УзелВетки, ВключатьКорневойУзелВетки = Истина, УдалитьВеткуИзДерева = Ложь) Экспорт
	
	НовоеДерево = Дерево.Скопировать();
	НовоеДерево.Строки.Очистить();
	
	Если ТипЗнч(УзелВетки) = Тип("СтрокаДереваЗначений") Тогда
		НайденныеВетки = Новый Массив;
		НайденныеВетки.Добавить(УзелВетки);
	Иначе	
		НайденныеВетки = Дерево.Строки.НайтиСтроки(УзелВетки, Истина);
	КонецЕсли;
	
	Для Каждого НайденнаяВетка Из НайденныеВетки Цикл
		НовыйУзел = НовоеДерево;
		
		Если ВключатьКорневойУзелВетки Тогда
			НовыйУзел = НовоеДерево.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйУзел, НайденнаяВетка);
		КонецЕсли;
		
		ДеревоЗначений_ЗаполнитьИзДерева(НовыйУзел, НайденнаяВетка, Ложь);
	КонецЦикла;
	
	Если УдалитьВеткуИзДерева Тогда
		Для Каждого НайденнаяВетка Из НайденныеВетки Цикл
			// В попытке, т.к. не нашел, как определить удалена строка ранее или нет
			Попытка
				РодительскийУзел = НайденнаяВетка.Родитель;	
			Исключение
				Продолжить;	
			КонецПопытки;
			
			Если РодительскийУзел = Неопределено Тогда
				Дерево.Строки.Удалить(НайденнаяВетка);
			Иначе
				НайденнаяВетка.Родитель.Строки.Удалить(НайденнаяВетка);		
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат НовоеДерево;
	
КонецФункции

