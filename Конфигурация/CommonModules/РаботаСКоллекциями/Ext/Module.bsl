// СПИСКИ ЗНАЧЕНИЙ

Функция ЗначенияСписком(Значения) Экспорт
	Если ТипЗнч(Значения) = Тип("СписокЗначений") Тогда
		Возврат Значения;
	Иначе
		СписокЗначений = Новый СписокЗначений;
		Если ТипЗнч(Значения) = Тип("Массив") Тогда
			СписокЗначений.ЗагрузитьЗначения(Значения);
		ИначеЕсли Значения <> Неопределено Тогда
			СписокЗначений.Добавить(Значения);
		КонецЕсли;
		Возврат СписокЗначений;
	КонецЕсли;
КонецФункции

Функция НайтиЗначениеСпискаПоПредставлению(СписокЗначений, ПредставлениеДляПоиска) Экспорт
	
	Для каждого ЭлементСписка Из СписокЗначений Цикл
		Если ВРег(СокрЛП(ЭлементСписка.Представление)) = ВРег(СокрЛП(ПредставлениеДляПоиска)) Тогда
			Возврат ЭлементСписка.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции // СписокЗначений_НайтиЗначениеПоПредставлению

// Сравнивает элементы списков значений или массивов по значениям
//
Функция СпискиЗначенийИдентичны(Список1, Список2) Экспорт
	
	СпискиИдентичны = Истина;
	
	Для Каждого ЭлементСписка1 Из Список1 Цикл
		Если НайтиВСписке(Список2, ЭлементСписка1) = Неопределено Тогда
			СпискиИдентичны = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если СпискиИдентичны Тогда
		Для Каждого ЭлементСписка2 Из Список2 Цикл
			Если НайтиВСписке(Список1, ЭлементСписка2) = Неопределено Тогда
				СпискиИдентичны = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СпискиИдентичны;
	
КонецФункции // СпискиЗначенийИдентичны

// Проверяет, что элементы первого списка входят в второй список
Функция ЭлементыПервогоСпискаВходятВоВторойСписок(Список1, Список2) Экспорт
	
	СпискиИдентичны = Истина;
	
	Для Каждого ЭлементСписка1 Из Список1 Цикл
		Если НайтиВСписке(Список2, ЭлементСписка1) = Неопределено Тогда
			СпискиИдентичны = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СпискиИдентичны;
	
КонецФункции

// Дополняет список отдельным значением или значениями из другого списка
//
// Параметры:
//  СписокПриемник				- СписокЗначений										- список значений, в который необходимо добавить значения
//  Источник					- Произвольный, ЭлементСпискаЗначений, СписокЗначений	- отдельное значение или список значений для заполнения
//  ТолькоУникальныеЗначения	- Булево												- если истина, то в список значений будут включены только уникальные значения
//
Процедура ДополнитьСписок(СписокПриемник, Источник, ТолькоУникальныеЗначения = Ложь) Экспорт
	
	Если ТипЗнч(Источник) = Тип("СписокЗначений") Тогда
		
		// Дополняется списком значений	
		
		Если ТолькоУникальныеЗначения Тогда
			
			УникальныеЗначения = Новый Соответствие;
			
			Для Каждого Элемент Из СписокПриемник Цикл
				УникальныеЗначения.Вставить(Элемент.Значение, Истина);
			КонецЦикла;
			
			Для Каждого Элемент Из Источник Цикл
				Если УникальныеЗначения[Элемент.Значение] = Неопределено Тогда
					ЗаполнитьЗначенияСвойств(СписокПриемник.Добавить(), Элемент);
					УникальныеЗначения.Вставить(Элемент.Значение, Истина);
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			
			Для Каждого Элемент Из Источник Цикл
				ЗаполнитьЗначенияСвойств(СписокПриемник.Добавить(), Элемент);
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		
		// Дополняется отдельным значением	
		
		Если Не ТолькоУникальныеЗначения
			ИЛИ НайтиВСписке(СписокПриемник, Источник) = Неопределено
		Тогда
		
			Если ТипЗнч(Источник) = Тип("ЭлементСпискаЗначений") Тогда
				ЗаполнитьЗначенияСвойств(СписокПриемник.Добавить(), Источник);
			Иначе
				СписокПриемник.Добавить(Источник);
			КонецЕсли;
		
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ТАБЛИЦЫ ЗНАЧЕНИЙ

// Функция создает структуру со свойствами, как колонки таблицы значений передаваемой строки
//  и устанавливает этим свойствам значения из строки таблицы значений
// 
// Параметры:
//  СтрокаТаблицыЗначений - СтрокаТаблицыЗначений
//
// ВозвращаемоеЗначение:
//  Структура
//
Функция ТаблицаЗначений_СтрокаВСтруктуру(СтрокаТаблицыЗначений) Экспорт
	
	Структура = Новый Структура;
	Для каждого Колонка Из СтрокаТаблицыЗначений.Владелец().Колонки Цикл
		Структура.Вставить(Колонка.Имя, СтрокаТаблицыЗначений[Колонка.Имя]);
	КонецЦикла;
	
	Возврат Структура;
	
КонецФункции

// Возвращает массив ключей, по которым можно получить неуникальные строки таблицы значений
// 
// Параметры:
//  ТабЗнч			- ТаблицаЗначений	- таблица значений
//	КолонкиТабЗнч	- Строка			- колонки таблицы значений, разделенные запятой
//
// Возвращаемое значение:
//  Массив - массив структур, содержащих поля:
//		- ключ			- значение колонки, если в КолонкиТабЗнч передана одна колонка
//						- структура, где ключи - имена колонок, значения - соответствующие им значения
//		- количество	- количество строк таблицы значений с данным ключом
//
Функция ТаблицаЗначений_НайтиНеУникальныеЗначения(ТабЗнч, КолонкиТабЗнч) Экспорт
	
	// определим имя суммируемой колонки
	ИмяСуммируемойКолонки = "СуммируемоеПоле" + СтрЗаменить(XMLСтрока(Новый УникальныйИдентификатор), "-", "");
	
	// свернем таблицу значений по указанному ключу
	ГруппируемыеЗнч = ТабЗнч.Скопировать(, КолонкиТабЗнч);
	
	ГруппируемыеЗнч.Колонки.Добавить(ИмяСуммируемойКолонки, Новый ОписаниеТипов("Число"));
	ГруппируемыеЗнч.ЗаполнитьЗначения(1, ИмяСуммируемойКолонки);
	
	ГруппируемыеЗнч.Свернуть(КолонкиТабЗнч, ИмяСуммируемойКолонки);
	ГруппируемыеЗнч.Сортировать(ИмяСуммируемойКолонки + " УБЫВ");
	
	// выделим не уникальные значения в массив
	НеУникальныеЗначения = Новый Массив;
	
	Для каждого СтрокаГруппируемыеЗнч Из ГруппируемыеЗнч Цикл
		Если СтрокаГруппируемыеЗнч[ИмяСуммируемойКолонки] = 1 Тогда
			Прервать;
		Иначе
			СтруктураКлюча = Новый Структура(КолонкиТабЗнч);
			Если СтруктураКлюча.Количество() > 1 Тогда
				ЗаполнитьЗначенияСвойств(СтруктураКлюча, СтрокаГруппируемыеЗнч);
				НеУникальныеЗначения.Добавить(Новый Структура("Ключ, Количество", СтруктураКлюча, СтрокаГруппируемыеЗнч[ИмяСуммируемойКолонки]));
			Иначе
				НеУникальныеЗначения.Добавить(Новый Структура("Ключ, Количество", СтрокаГруппируемыеЗнч[КолонкиТабЗнч], СтрокаГруппируемыеЗнч[ИмяСуммируемойКолонки]));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НеУникальныеЗначения;
	
КонецФункции

// Дополняет таблицу значений-приемник данными из таблицы значений-источник
//
// Параметры:
//  ТаблицаИсточник - ТаблицаЗначений - таблица, из которой будут браться строки для заполнения;
//  ТаблицаПриемник - ТаблицаЗначений - таблица, в которую будут добавлены строки из таблицы-источника.
//  
Процедура ТаблицаЗначений_Дополнить(ТаблицаИсточник, ТаблицаПриемник) Экспорт
	
	Для Каждого СтрокаТаблицыИсточник Из ТаблицаИсточник Цикл
		
		ЗаполнитьЗначенияСвойств(ТаблицаПриемник.Добавить(), СтрокаТаблицыИсточник);
		
	КонецЦикла;
	
КонецПроцедуры // ТаблицаЗначений_Дополнить

// Преобразует текст формата XML в таблицу значений, при этом колонки таблицы формируются на основе описания в XML
//
// Параметры:
//  XML     - текст в формате XML или ЧтениеXML.
//
// Схема XML:
//<?xml version="1.0" encoding="utf-8"?>
//<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
//  <xs:element name="Items">
//	<xs:complexType>
//	  <xs:sequence>
//		<xs:element maxOccurs="unbounded" name="Item">
//		  <xs:complexType>
//			<xs:attribute name="Code" type="xs:integer" use="required" />
//			<xs:attribute name="Name" type="xs:string" use="required" />
//			<xs:attribute name="Socr" type="xs:string" use="required" />
//			<xs:attribute name="Index" type="xs:string" use="required" />
//		  </xs:complexType>
//		</xs:element>
//	  </xs:sequence>
//	  <xs:attribute name="Description" type="xs:string" use="required" />
//	  <xs:attribute name="Columns" type="xs:string" use="required" />
//	</xs:complexType>
//  </xs:element>
//</xs:schema>
//
// Примеры XML-файлов см. в демонстрационной конфигурации.
// 
// Пример использования:
//   КлассификаторТаблица = ПрочитатьXMLВТаблицу(РегистрыСведений.АдресныйКлассификатор.
//       ПолучитьМакет("КлассификаторАдресныхОбъектовРоссии").ПолучитьТекст());
//
// Возвращаемое значение:
//  Структура с полями 
//   ИмяТаблицы - Строка
//   Данные - ТаблицаЗначений.
//
Функция ПрочитатьXMLВТаблицу(Знач XML) Экспорт
	
	Если ТипЗнч(XML) <> Тип("ЧтениеXML") Тогда
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(XML);
	Иначе
		Чтение = XML;
	КонецЕсли;
	
	// Прочитаем первый узел и проверим его
	Если Не Чтение.Прочитать() Тогда
		ВызватьИсключение("Пустой XML");
	ИначеЕсли Чтение.Имя <> "Items" Тогда
		ВызватьИсключение("Ошибка в структуре XML");
	КонецЕсли;
	
	// Получим описание таблицы и создадим ее
	ИмяТаблицы = Чтение.ПолучитьАтрибут("Description");
	ИменаКолонок = СтрЗаменить(Чтение.ПолучитьАтрибут("Columns"), ",", Символы.ПС);
	Колонок = СтрЧислоСтрок(ИменаКолонок);
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	Для Сч = 1 По Колонок Цикл
		ТаблицаЗначений.Колонки.Добавить(СтрПолучитьСтроку(ИменаКолонок, Сч), Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	
	// Заполним значения в таблице
	Пока Чтение.Прочитать() Цикл
		
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.Имя = "Items" Тогда
			Прервать;
		ИначеЕсли Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		ИначеЕсли Чтение.Имя <> "Item" Тогда
			ВызватьИсключение("Ошибка в структуре XML");
		КонецЕсли;
		
		новСтр = ТаблицаЗначений.Добавить();
		Для Сч = 1 По Колонок Цикл
			ИмяКолонки = СтрПолучитьСтроку(ИменаКолонок, Сч);
			новСтр[Сч-1] = Чтение.ПолучитьАтрибут(ИмяКолонки);
		КонецЦикла;
		
	КонецЦикла;
	
	// Заполним результат
	Результат = Новый Структура;
	Результат.Вставить("ИмяТаблицы", ИмяТаблицы);
	Результат.Вставить("Данные", ТаблицаЗначений);
	
	Возврат Результат;
	
КонецФункции // ПрочитатьXMLВТаблицу()

Функция ПолучитьПоляТаблицыДляЗапроса(Таблица, ИмяТаблицы, Знач НеВключатьПоля = Неопределено) Экспорт
	
	ПоляТаблицыДляЗапроса = "";
	
	// нормализуем строковый список полей
	НеВключатьПоля = ВРег(СокрЛП(НеВключатьПоля)) + ",";
	
	Пока Найти(НеВключатьПоля, " ") > 0 Цикл
		НеВключатьПоля = СтрЗаменить(НеВключатьПоля, " ", "");
	КонецЦикла;
	
	// выделим поля таблицы в строку для запроса
	ЭтоПервоеПолеВЗапросе = Истина;
	
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Если Найти(НеВключатьПоля, ВРег(Колонка.Имя) + ",") > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПоляТаблицыДляЗапроса = ПоляТаблицыДляЗапроса
			+ ?(ЭтоПервоеПолеВЗапросе, "", ",") + Символы.ПС + Символы.Таб
			+ ?(ПустаяСтрока(ИмяТаблицы), "", ИмяТаблицы  + ".") + Колонка.Имя;
			
		ЭтоПервоеПолеВЗапросе = Ложь;
	КонецЦикла;
	
	Возврат ПоляТаблицыДляЗапроса;
	
КонецФункции // ПолучитьПоляТаблицыДляЗапроса

Функция ТаблицаЗначений_ИзменитьТипЗначенияКолонки(Таблица, ИмяКолонки, НовыйТипЗначения) Экспорт
	
	СлужебнаяКолонка = Таблица.Колонки.Добавить("_СлужебнаяКолонка_", НовыйТипЗначения);
	
	Таблица.ЗагрузитьКолонку(Таблица.ВыгрузитьКолонку(ИмяКолонки), "_СлужебнаяКолонка_");
	
	Таблица.Колонки.Удалить(ИмяКолонки);
	
	СлужебнаяКолонка.Имя = ИмяКолонки;	
	
КонецФункции

// Исправление фичи платформы: при помещении во временную таблицу SQL числовые колонки, для которых не определена точность,
//  округляются до 9 знаков после запятой
//
// Параметры:
//  Таблица - ТаблицаЗначений - проверяемая таблица
//  ПроверяемыеКолонки - Структура - ключ: имя колонки, значение: описание типа с нужной точностью
//
Процедура ТаблицаЗначений_ОбновитьТочностьКолонок(Таблица, ПроверяемыеКолонки) Экспорт 
	
	Для Каждого ПроверяемаяКолонка Из ПроверяемыеКолонки Цикл
		
		Колонка = Таблица.Колонки.Найти(ПроверяемаяКолонка.Ключ);			
		
		Если Колонка <> Неопределено
			И Колонка.ТипЗначения.КвалификаторыЧисла.РазрядностьДробнойЧасти < ПроверяемаяКолонка.Значение.КвалификаторыЧисла.РазрядностьДробнойЧасти
		Тогда 
			РаботаСКоллекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(Таблица, ПроверяемаяКолонка.Ключ, ПроверяемаяКолонка.Значение);
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

// Возвращает массив структур
// 
// Параметры:
//  ТабЗнч			- ТаблицаЗначений	- таблица значений
//	КолонкиТабЗнч	- Строка			- колонки таблицы значений, разделенные запятой
//
// Возвращаемое значение:
//  Массив - массив каждый элемент которого это структура, соответствующая строке таблицы значений
//
Функция ТаблицаЗначений_В_МассивСтруктур(ТабЗнч, КолонкиТабЗнч = Неопределено) Экспорт
	
	Если КолонкиТабЗнч = Неопределено Тогда
		ОписаниеСтруктуры = "";
		Для каждого Колонка Из ТабЗнч.Колонки Цикл
			ОписаниеСтруктуры = ОписаниеСтруктуры + ?(ОписаниеСтруктуры = "", "", ",") + Колонка.Имя;
		КонецЦикла;
	Иначе
		ОписаниеСтруктуры = КолонкиТабЗнч;
	КонецЕсли;
	
	Массив = Новый Массив();
	Для каждого СтрокаТабЗнч Из ТабЗнч Цикл
		СтрокаМассива = Новый Структура(ОписаниеСтруктуры);
		ЗаполнитьЗначенияСвойств(СтрокаМассива, СтрокаТабЗнч, ОписаниеСтруктуры);
	    Массив.Добавить(СтрокаМассива);
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

