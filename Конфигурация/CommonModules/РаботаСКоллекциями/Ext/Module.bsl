// КЭШИРОВАНИЕ

Функция Кэширование_СоздатьКэш(КлючПоиска) Экспорт
	
	КэшОбъектов = Новый ТаблицаЗначений;
		
	// поля, входящие в состав ключа
	ИндексируемыеПоля = "";
	
	Для каждого СвойствоКлючаПоиска Из КлючПоиска Цикл
		КэшОбъектов.Колонки.Добавить(СвойствоКлючаПоиска.Ключ);
		ИндексируемыеПоля = ИндексируемыеПоля + ?(ПустаяСтрока(ИндексируемыеПоля), "", ",") + СвойствоКлючаПоиска.Ключ;
	КонецЦикла;
	
	КэшОбъектов.Индексы.Добавить(ИндексируемыеПоля);
	
	// предопределенное поле
	КэшОбъектов.Колонки.Добавить("Значение");
	
	Возврат КэшОбъектов;

КонецФункции // Кэширование_СоздатьКэш

Процедура Кэширование_ДобавитьЗначение(КэшОбъектов, КлючПоиска, Значение) Экспорт
	
	СтрокаКэшОбъектов = КэшОбъектов.Добавить();
	
	Для каждого СвойствоКлючаПоиска Из КлючПоиска Цикл
		СтрокаКэшОбъектов[СвойствоКлючаПоиска.Ключ] = СвойствоКлючаПоиска.Значение;
	КонецЦикла;
	
	СтрокаКэшОбъектов.Значение = Значение;
	
КонецПроцедуры // Кэширование_ДобавитьЗначение

Функция Кэширование_НайтиЗначение(КэшОбъектов, КлючПоиска, ЗнчНайдено) Экспорт

	ЗнчНайдено = Ложь;
	
	СтрокиКэшОбъектов = КэшОбъектов.НайтиСтроки(КлючПоиска);
	Если СтрокиКэшОбъектов.Количество() > 0 Тогда
		ЗнчНайдено = Истина;
		
		Возврат СтрокиКэшОбъектов[0].Значение;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции // Кэширование_НайтиЗначение

