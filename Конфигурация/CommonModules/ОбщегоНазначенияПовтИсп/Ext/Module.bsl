
// Возвращает ссылку на объект, которому в регистре сведений "ИменованныеОбъекты"
//  поставлено в соответствие указанное имя, если таковой существует
//	если объект не найден, вызывается исключение
// 
// Параметры:
//  ИмяОбъекта                 - Строка, например, "Брокер_БК_Регион".
// 
// Возвращаемое значение:
//  Произвольный - Ссылка на объект.
// 
Функция ПолучитьИменованныйОбъект(ИмяОбъекта) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИменованныеОбъекты.Объект
		|ИЗ
		|	РегистрСведений.ИменованныеОбъекты КАК ИменованныеОбъекты
		|ГДЕ
		|	ИменованныеОбъекты.Имя = &Имя";
		
	Запрос.УстановитьПараметр("Имя", ИмяОбъекта);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Объект;
	КонецЕсли;
	
	ВызватьИсключение "Не удалось найти объект по имени '" + ИмяОбъекта + "'";
	
КонецФункции // ПолучитьИменованныйОбъект

//Возвращает массив ведущих измерений
//
//Параметры:
//МетаданныеОбъекта - Объект.Метаданные()
//
Функция ПолучитьМассивВедущихИзмерений(ПолноеИмяМетаданных) Экспорт
	
	ЧастиПолногоИмени = СтрРазделить(ПолноеИмяМетаданных, ".");
	
	ТипМетаданных = СтрЗаменить(ЧастиПолногоИмени[0], "Регистр", "Регистры");
	ВидМетаданных = ЧастиПолногоИмени[1];
	
	МетаданныеОбъекта = Метаданные[ТипМетаданных][ВидМетаданных];
	
	МассивВедущихИзмерений = Новый Массив;
	
	Для Каждого Измерение Из МетаданныеОбъекта.Измерения Цикл
		Если Измерение.Ведущее Тогда
			МассивВедущихИзмерений.Добавить(Измерение.Имя);
		КонецЕсли;	
	КонецЦикла;
	
	Возврат МассивВедущихИзмерений;
	
КонецФункции

Функция ПолучитьСсылкуИнформационнойБазы() Экспорт
	
	ПараметрыПодключения = РаботаСоСтрокамиКлиентСервер.ПолучитьПараметрыИзСтроки(СтрокаСоединенияИнформационнойБазы());
	СсылкаИБ = СтрШаблон("e1c://server/%1/%2", ПараметрыПодключения.Srvr, ПараметрыПодключения.Ref);

	Возврат СсылкаИБ;
	
КонецФункции
