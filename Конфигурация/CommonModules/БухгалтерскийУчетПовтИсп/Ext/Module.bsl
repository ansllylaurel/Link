
Функция ПолучитьЛицевойСчет(БалансовыйСчет, Валюта, Организация, СчетДоверительногоУправления, Знач Субконто1 = Неопределено, Знач Субконто2 = Неопределено, Знач Субконто3 = Неопределено, ДополнительнаяАналитика = Неопределено, Партия = Неопределено, СтрокаПартии = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена организация для определения лицевого счета");
	    Возврат Неопределено;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(СчетДоверительногоУправления) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен счет доверительного управления для определения лицевого счета");
	    Возврат Неопределено;
	КонецЕсли;
	
	БалансовыйСчетСтруктурой = БухгалтерскийУчет.РеквизитыСчета(БалансовыйСчет);
	КоличествоСубконто = БалансовыйСчетСтруктурой.ВидыСубконто.Количество();
	Если (КоличествоСубконто > 0 И Субконто1 = Неопределено И Не РаботаСМетаданнымиПовтИсп.НеПроверятьЗаполнениеСубконто(Организация, БалансовыйСчет, БалансовыйСчетСтруктурой.ВидыСубконто[0].ВидСубконто))
		ИЛИ (КоличествоСубконто > 1 И Субконто2 = Неопределено И Не РаботаСМетаданнымиПовтИсп.НеПроверятьЗаполнениеСубконто(Организация, БалансовыйСчет, БалансовыйСчетСтруктурой.ВидыСубконто[1].ВидСубконто)
		И ПланыВидовХарактеристик.ВидыСубконто.Сделка<>БалансовыйСчетСтруктурой.ВидыСубконто[1].ВидСубконто)
		ИЛИ КоличествоСубконто > 2 И Субконто3 = Неопределено И Не РаботаСМетаданнымиПовтИсп.НеПроверятьЗаполнениеСубконто(Организация, БалансовыйСчет, БалансовыйСчетСтруктурой.ВидыСубконто[2].ВидСубконто)
		Тогда
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено субконто для определения лицевого счета: " + БалансовыйСчетСтруктурой.Код);
	    Возврат Неопределено;
		
	КонецЕсли;
	
	Если ТипЗнч(Субконто2) = Тип("СправочникСсылка.ВидыДвиженияДенежныхСредств") Тогда
		Субконто2 = Неопределено;
	КонецЕсли;
	Если ТипЗнч(Субконто1) = Тип("СправочникСсылка.ВидыДвиженияДенежныхСредств") Тогда
		Субконто1 = Неопределено;
	КонецЕсли;
		
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ЛицевыеСчета.Ссылка КАК Ссылка,
		|	ЛицевыеСчета.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
		|ГДЕ
		|	ЛицевыеСчета.СчетУчета = &СчетУчета
		|	И ЛицевыеСчета.Валюта = &Валюта
		|	И ЛицевыеСчета.Организация = &Организация
		|	И ЛицевыеСчета.Владелец = &СчетДоверительногоУправления
		|	И ЛицевыеСчета.Субконто1 = &Субконто1
		|	И ЛицевыеСчета.Субконто2 = &Субконто2
		|	И ЛицевыеСчета.Субконто3 = &Субконто3
		|	И ЛицевыеСчета.ДополнительнаяАналитика = &ДополнительнаяАналитика
		|	И ЛицевыеСчета.Партия = &Партия
		|	И ЛицевыеСчета.СтрокаПартии = &СтрокаПартии";
	
	Если Субконто1 = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Субконто1", "Неопределено");
	Иначе
		Запрос.УстановитьПараметр("Субконто1", Субконто1);
	КонецЕсли;
	Если Субконто2 = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Субконто2", "Неопределено");
	Иначе
		Запрос.УстановитьПараметр("Субконто2", Субконто2);
	КонецЕсли;
	Если Субконто3 = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Субконто3", "Неопределено");
	Иначе
		Запрос.УстановитьПараметр("Субконто3", Субконто3);
	КонецЕсли;
	Если ДополнительнаяАналитика = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДополнительнаяАналитика", "Значение(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ПустаяСсылка)");
	Иначе
		Запрос.УстановитьПараметр("ДополнительнаяАналитика", ДополнительнаяАналитика);
	КонецЕсли;
	Если Партия = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Партия", "Неопределено");
	Иначе
		Запрос.УстановитьПараметр("Партия", Партия);
	КонецЕсли;
	Если СтрокаПартии = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СтрокаПартии", "0");
	Иначе
		Запрос.УстановитьПараметр("СтрокаПартии", СтрокаПартии);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("СчетУчета", БалансовыйСчет);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Если ВыборкаДетальныеЗаписи.ПометкаУдаления Тогда
			ЛицевойСчет = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			ЛицевойСчет.УстановитьПометкуУдаления(Ложь, Ложь);
		КонецЕсли;	
	
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
		
	Иначе
		
		НовыйЛицевой = Справочники.ЛицевыеСчета.СоздатьЭлемент();
		
		НовыйЛицевой.Владелец = СчетДоверительногоУправления;
		
		НовыйЛицевой.СчетУчета = БалансовыйСчет;
		НовыйЛицевой.Организация = Организация;
		НовыйЛицевой.Валюта = Валюта;
		Если Субконто1 <> Неопределено Тогда
			НовыйЛицевой.Субконто1 = Субконто1;
		КонецЕсли;
		Если Субконто2 <> Неопределено Тогда
			НовыйЛицевой.Субконто2 = Субконто2;
		КонецЕсли;
		Если Субконто3 <> Неопределено Тогда
			НовыйЛицевой.Субконто3 = Субконто3;
		КонецЕсли;
		Если ДополнительнаяАналитика <> Неопределено Тогда
			НовыйЛицевой.ДополнительнаяАналитика = ДополнительнаяАналитика;
		КонецЕсли;
		Если Партия <> Неопределено Тогда
			НовыйЛицевой.Партия = Партия;
		КонецЕсли;
		Если СтрокаПартии <> 0 Тогда
			НовыйЛицевой.СтрокаПартии = СтрокаПартии;
		КонецЕсли;
		
		НовыйЛицевой.Записать();
		
		Возврат НовыйЛицевой.Ссылка;
	
	КонецЕсли;
	
КонецФункции

Функция ОпределитьЦельРасчетаПоВидуУчета(ВидУчета) Экспорт
	
	ЦельРасчета = Справочники.ЦелиРасчета.ПустаяСсылка();
	
	Если ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет Тогда
		ЦельРасчета = Справочники.ЦелиРасчета.БухгалтерскийУчет;
	ИначеЕсли ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		ЦельРасчета = Справочники.ЦелиРасчета.ЕдиныйПланСчетов;
	ИначеЕсли ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
		ЦельРасчета = Справочники.ЦелиРасчета.НалоговыйУчет;
	КонецЕсли;
	
	Возврат ЦельРасчета;
	
КонецФункции

Функция ОпределитьВидУчетаПоЦелиРасчета(ЦельРасчета) Экспорт
	
	ВидУчета = Перечисления.ВидыУчета.ПустаяСсылка();
	
	Если ЦельРасчета = Справочники.ЦелиРасчета.БухгалтерскийУчет Тогда
		ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет;
	ИначеЕсли ЦельРасчета = Справочники.ЦелиРасчета.ЕдиныйПланСчетов Тогда
		ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
	ИначеЕсли ЦельРасчета = Справочники.ЦелиРасчета.НалоговыйУчет Тогда
		ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет;
	КонецЕсли;
	
	Возврат ВидУчета;
	
КонецФункции

Функция СчетЯвляетсяГруппой(Счет) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Основной.Ссылка
		|ИЗ
		|	ПланСчетов." + РаботаСМетаданнымиПовтИсп.скПолучитьИмяПоСсылке(Счет) + " КАК Основной
		|ГДЕ
		|	Основной.Родитель = &Родитель";
		
	Запрос.УстановитьПараметр("Родитель", Счет);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции // СчетЯвляетсяГруппой

Функция ОпределитьНастройкиЦелиРасчета(Период, Организация, СчетДоверительногоУправления, ЦельРасчета) Экспорт
	Возврат БухгалтерскийУчет.ОпределитьНастройкиЦелиРасчета(Период, Организация, СчетДоверительногоУправления, ЦельРасчета);	
КонецФункции	

