Функция РеквизитыСчета(Счет) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка", Счет.Ссылка);
	Результат.Вставить("Код", Счет.Код);
	Результат.Вставить("Наименование", Счет.Наименование);
	Результат.Вставить("Порядок", Счет.Порядок);
	Результат.Вставить("Родитель", Счет.Родитель);
	Результат.Вставить("Вид", Счет.Вид);
	Результат.Вставить("Забалансовый", Счет.Забалансовый);
	Результат.Вставить("ПометкаУдаления", Счет.ПометкаУдаления);
	Результат.Вставить("Предопределенный", Счет.Предопределенный);
	Результат.Вставить("ИмяПредопределенныхДанных", Счет.ИмяПредопределенныхДанных);
	Результат.Вставить("Количественный", Счет.Количественный);
	Результат.Вставить("Валютный", Счет.Валютный);
	
	Если ТипЗнч(Счет) = Тип("ПланСчетовСсылка.Единый") Тогда
		Результат.Вставить("ГлаваПланаСчетовНФО", Счет.ГлаваПланаСчетовНФО);
	КонецЕсли;	
	
	ВидыСубконто = Новый ТаблицаЗначений;
	ВидыСубконто.Колонки.Добавить("НомерСтроки");
	ВидыСубконто.Колонки.Добавить("ВидСубконто");

	Для Каждого ВидСубконто Из Счет.ВидыСубконто Цикл
		СтрокаВидыСубконто = ВидыСубконто.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаВидыСубконто, ВидСубконто);
	КонецЦикла;	
	
	Результат.Вставить("ВидыСубконто", ВидыСубконто);
	
	Возврат Результат;
	
КонецФункции // СчетСтруктурой

Функция ЭтоДолевойУчетныйАктивЦБРФ(УчетныйАктивЦБРФ) Экспорт

	УчетныеАктивЦБРФДолевые = Новый Массив();
	
	УчетныеАктивЦБРФДолевые.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.АОИ);
	УчетныеАктивЦБРФДолевые.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.АОИБанков);
	УчетныеАктивЦБРФДолевые.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.АПИ);
	УчетныеАктивЦБРФДолевые.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.АПИБанков);

	УчетныеАктивЦБРФДолевые.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.ИСУ);
	УчетныеАктивЦБРФДолевые.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.КСУ);

	УчетныеАктивЦБРФДолевые.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.ПаиФондов);
	УчетныеАктивЦБРФДолевые.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.ПаиФондовНерезидентов);
	
    Возврат (УчетныеАктивЦБРФДолевые.Найти(УчетныйАктивЦБРФ) <> Неопределено);
	
КонецФункции

Функция ЭтоДолговойУчетныйАктивЦБРФ(УчетныйАктивЦБРФ) Экспорт

	УчетныеАктивЦБРФДолговые = Новый Массив();

	УчетныеАктивЦБРФДолговые.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковРезидентов);
	УчетныеАктивЦБРФДолговые.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихРезидентов);
	УчетныеАктивЦБРФДолговые.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихНерезидентов);
	УчетныеАктивЦБРФДолговые.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств);
	УчетныеАктивЦБРФДолговые.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииГосударства);
	УчетныеАктивЦБРФДолговые.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииСубфедеральные);
	УчетныеАктивЦБРФДолговые.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковНерезидентов);
	
    Возврат (УчетныеАктивЦБРФДолговые.Найти(УчетныйАктивЦБРФ) <> Неопределено);
	
КонецФункции

Функция ЭтоДолевойУчетныйАктивЕПС(УчетныйАктивЕПС) Экспорт

	Родитель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетныйАктивЕПС, "Родитель");
	Если Родитель = Справочники.УчетныеАктивыЕПС.ПустаяСсылка() Тогда
		РодительскийУчетныйАктивЕПС = УчетныйАктивЕПС;
	Иначе
		РодительскийУчетныйАктивЕПС = Родитель;
	КонецЕсли;

	РодительскиеУчетныеАктивЕПСДолевые = Новый Массив();
	
	РодительскиеУчетныеАктивЕПСДолевые.Добавить(Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажи);
	РодительскиеУчетныеАктивЕПСДолевые.Добавить(Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой);

	Возврат (РодительскиеУчетныеАктивЕПСДолевые.Найти(РодительскийУчетныйАктивЕПС) <> Неопределено);
	
КонецФункции 

Функция ЭтоДолговойРодительскийАктивЕПС(УчетныйАктивЕПС) Экспорт

	Родитель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетныйАктивЕПС, "Родитель");
	Если Родитель = Справочники.УчетныеАктивыЕПС.ПустаяСсылка() Тогда
		РодительскийУчетныйАктивЕПС = УчетныйАктивЕПС;
	Иначе
		РодительскийУчетныйАктивЕПС = Родитель;
	КонецЕсли;

	РодительскиеУчетныеАктивЕПСДолговые = Новый Массив();
	
	РодительскиеУчетныеАктивЕПСДолговые.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения);
	РодительскиеУчетныеАктивЕПСДолговые.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи);
	РодительскиеУчетныеАктивЕПСДолговые.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток);
	РодительскиеУчетныеАктивЕПСДолговые.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСД);

	Возврат (РодительскиеУчетныеАктивЕПСДолговые.Найти(РодительскийУчетныйАктивЕПС) <> Неопределено);
	
КонецФункции 

Функция ОпределитьУчетныйАктивЕПСПоКодуСчетаУчета(КодСчетаУчета) Экспорт

	Если СтрДлина(СокрЛП(КодСчетаУчета)) = 5 Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	УчетныеАктивыЕПС.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
			|ГДЕ
			|	УчетныеАктивыЕПС.СчетУчета.Код = &Код";
		
		Запрос.УстановитьПараметр("Код", КодСчетаУчета);
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		     Возврат ВыборкаДетальныеЗаписи.Ссылка;
		КонецЕсли;
		
	ИначеЕсли СтрДлина(СокрЛП(КодСчетаУчета)) = 3 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	УчетныеАктивыЕПС.Родитель КАК Родитель
			|ИЗ
			|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
			|ГДЕ
			|	ПОДСТРОКА(УчетныеАктивыЕПС.СчетУчета.Код, 1, 3) = &Код";
		
		Запрос.УстановитьПараметр("Код", КодСчетаУчета);
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		     Возврат ВыборкаДетальныеЗаписи.Родитель;
		КонецЕсли;
	
	КонецЕсли;

	Возврат Неопределено;
	
КонецФункции 

Функция ОпределитьУчетныйАктивЕПСПоРодителюИУчетномуАктивуЦБРФ(РодительскийУчетныйАктивЕПС, УчетныйАктивЦБРФ) Экспорт

	ЭтоДолевойАктив = ЭтоДолевойУчетныйАктивЦБРФ(УчетныйАктивЦБРФ);
	ЭтоДолговойАктив = ЭтоДолговойУчетныйАктивЦБРФ(УчетныйАктивЦБРФ);
	
	ЭтоДолевойРодительскийАктивЕПС = ЭтоДолевойУчетныйАктивЕПС(РодительскийУчетныйАктивЕПС);
	ЭтоДолговойРодительскийАктивЕПС = ЭтоДолговойРодительскийАктивЕПС(РодительскийУчетныйАктивЕПС);

	Если (НЕ ЭтоДолговойАктив И НЕ ЭтоДолевойАктив)
		ИЛИ (НЕ ЭтоДолевойРодительскийАктивЕПС И НЕ ЭтоДолговойРодительскийАктивЕПС)
		ИЛИ (ЭтоДолевойАктив <> ЭтоДолевойРодительскийАктивЕПС)
		ИЛИ (ЭтоДолговойАктив <> ЭтоДолговойРодительскийАктивЕПС) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если РодительскийУчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой Тогда
	
		Если УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АОИ
			ИЛИ УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АПИ
			ИЛИ УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ИСУ
			ИЛИ УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.КСУ Тогда
			
			Возврат Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливойПрочихРезидентов;

		ИначеЕсли УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АОИБанков
			ИЛИ УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АПИБанков Тогда
			
			Возврат Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливойКредитныхОрганизаций;	
			
		ИначеЕсли УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ПаиФондов
			ИЛИ УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ПаиФондовНерезидентов Тогда
			
			Возврат Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливойПрочихРезидентов;
			
		КонецЕсли;
		
	ИначеЕсли РодительскийУчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажи Тогда

		Если УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АОИ
