Функция ОпределитьВидСубконтоУчетаЦеннойБумаги(Рынок) Экспорт
	
	Если      Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
		Возврат ПланыВидовХарактеристик.ВидыСубконто.Акции;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		Возврат ПланыВидовХарактеристик.ВидыСубконто.Облигации;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Паи Тогда
		Возврат ПланыВидовХарактеристик.ВидыСубконто.Паи;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Векселя Тогда
		Возврат ПланыВидовХарактеристик.ВидыСубконто.Векселя;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Доли Тогда
		Возврат ПланыВидовХарактеристик.ВидыСубконто.Доли;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия Тогда 
		Возврат ПланыВидовХарактеристик.ВидыСубконто.ИпотечныеСертификатыУчастия;  
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.ДепозитарныеРасписки Тогда 
		Возврат ПланыВидовХарактеристик.ВидыСубконто.ДепозитарныеРасписки;  
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.ДрагоценныеМеталлы Тогда 
		Возврат ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги;  
	КонецЕсли;
	
	Возврат ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка();
	
КонецФункции // ОпределитьВидСубконтоУчетаЦеннойБумаги

Функция ОпределитьУчетныйАктив(Период, Рынок, Актив, ЭтоКупон = Ложь) Экспорт
	
	ВалютаРубли	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");
	
	Если Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
		Если Актив.ВалютаНоминала = ВалютаРубли Тогда
			Возврат Справочники.УчетныеАктивы.Акции;
		Иначе
			Возврат Справочники.УчетныеАктивы.АкцииИностранныхЭмитентов;	
		КонецЕсли;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Паи Тогда
		Если Актив.ВалютаНоминала = ВалютаРубли Тогда
			Возврат Справочники.УчетныеАктивы.Паи;
		Иначе
			Возврат Справочники.УчетныеАктивы.ПаиИностранныхЭмитентов;
		КонецЕсли;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.ДепозитарныеРасписки Тогда
		Возврат Справочники.УчетныеАктивы.ДепозитарныеРасписки;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия Тогда
		Возврат Справочники.УчетныеАктивы.ИпотечныеСертификатыУчастия;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Векселя Тогда
		Если Актив.ВалютаНоминала = ВалютаРубли Тогда
			Возврат ?(Актив.ТипВекселя = Перечисления.ТипыВекселей.Дисконтный, Справочники.УчетныеАктивы.ВекселяДисконтные, Справочники.УчетныеАктивы.ВекселяПроцентные);
		Иначе
			Возврат ?(Актив.ТипВекселя = Перечисления.ТипыВекселей.Дисконтный, Справочники.УчетныеАктивы.ВекселяДисконтныеВалютные, Справочники.УчетныеАктивы.ВекселяПроцентныеВалютные);
		КонецЕсли;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда	
		Если Актив.ВалютаНоминала <> ВалютаРубли Тогда
			Если Актив.Категория = Перечисления.КатегорииОблигаций.Государственная Тогда
				Если ЭтоКупон Тогда
					Возврат Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалютеКупон;
				Иначе
					Возврат Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалюте;
				КонецЕсли;	
			Иначе
				Если ЭтоКупон Тогда
					Возврат Справочники.УчетныеАктивы.ЕврооблигацииКупон;
				Иначе
					Возврат Справочники.УчетныеАктивы.Еврооблигации;
				КонецЕсли;	
			КонецЕсли;
		ИначеЕсли Период >= '2014-01-01 00:00:00' И Период <= '2015-03-31 23:59:59' Тогда
			//*********************************************************
			// 7ка целый год неправильно учитавала госкорпорации
			// она считала их госами!!!!!!!!!!!!!!!!
			Если Актив.Категория = Перечисления.КатегорииОблигаций.Корпоративная Тогда
				
				// определим, является ли эмитент гос. корпорацией
				Запрос = Новый Запрос;
				Запрос.Текст =
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма
					|ИЗ
					|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, ЮрФизЛицо = &ЮрФизЛицо И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних";
					
				Запрос.УстановитьПараметр("Период",    Период);
				Запрос.УстановитьПараметр("ЮрФизЛицо", Актив.Эмитент.ЮрФизЛицо);
				
				Выборка = Запрос.Выполнить().Выбрать();
				
				Если Выборка.Следующий() И Выборка.ОрганизационноПравоваяФорма = Справочники.ОрганизационноПравовыеФормы.ГосударственнаяКорпорация Тогда
					Если ЭтоКупон Тогда
						Возврат Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон;
					Иначе
						Возврат Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные;
					КонецЕсли;
				Иначе	
					Если ЭтоКупон Тогда
						Возврат Справочники.УчетныеАктивы.ОблигацииКорпоративныеКупон;
					Иначе
						Возврат Справочники.УчетныеАктивы.ОблигацииКорпоративные;
					КонецЕсли;
				КонецЕсли;
				
			Иначе
				Если ЭтоКупон Тогда
					Возврат Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон;
				Иначе
					Возврат Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные;
				КонецЕсли;
			КонецЕсли;
			//*********************************************************
		Иначе
			Если ЭтоКупон Тогда
				Если Актив.Категория = Перечисления.КатегорииОблигаций.Еврооблигация Тогда
					Возврат Справочники.УчетныеАктивы.ЕврооблигацииКупон;
				ИначеЕсли Актив.Категория = Перечисления.КатегорииОблигаций.Корпоративная ИЛИ Актив.Категория = Перечисления.КатегорииОблигаций.Ипотечная Тогда
					Возврат Справочники.УчетныеАктивы.ОблигацииКорпоративныеКупон;
				Иначе
					Возврат Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон;
				КонецЕсли;
			Иначе
				Если Актив.Категория = Перечисления.КатегорииОблигаций.Еврооблигация Тогда
					Возврат Справочники.УчетныеАктивы.Еврооблигации;
				ИначеЕсли Актив.Категория = Перечисления.КатегорииОблигаций.Корпоративная ИЛИ Актив.Категория = Перечисления.КатегорииОблигаций.Ипотечная Тогда
					Возврат Справочники.УчетныеАктивы.ОблигацииКорпоративные;
				Иначе
					Возврат Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Доли Тогда
		Возврат Справочники.УчетныеАктивы.Доли;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Фьючерсы Тогда
		Возврат Справочники.УчетныеАктивы.Фьючерсы;
	ИначеЕсли ТипЗнч(Актив) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		Возврат Справочники.УчетныеАктивы.ДепозитныеВклады;
	ИначеЕсли ТипЗнч(Актив) = Тип("СправочникСсылка.Займы") Тогда
		ДатаПогашенияЗайма = РаботаСКредитнымиИнструментами.ПолучитьДатуПогашенияКредитногоИнструмента(Актив, Период);
		Если Актив.ВидКредитногоИнструмента = Перечисления.ВидыКредитныхИнструментов.Выданный тогда
			Возврат Справочники.УчетныеАктивы.ЗаймыВыданные;
		ИначеЕсли ДатаПогашенияЗайма = Неопределено Тогда
			Возврат Неопределено;
		ИначеЕсли ДобавитьМесяц(ДатаПогашенияЗайма, -12) < Период Тогда
			Возврат Справочники.УчетныеАктивы.ЗаймыПолученныеКраткосрочные;
		Иначе
			Возврат Справочники.УчетныеАктивы.ЗаймыПолученныеДолгосрочные;
		КонецЕсли;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.ДрагоценныеМеталлы Тогда
		Возврат Справочники.УчетныеАктивы.ДрагоценныеМеталлы;
	КонецЕсли;

КонецФункции // ОпределитьУчетныйАктив

Функция ОпределитьПриоритетнуюКатегориюПриКлассификации(СчетДоверительногоУправления, Рынок, Период)

	Если Рынок = Перечисления.РынкиЦенныхБумаг.Акции ИЛИ Рынок = Перечисления.РынкиЦенныхБумаг.Паи Тогда
		Если СчетДоверительногоУправления = Неопределено Тогда
			Возврат Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой;
		Иначе
			Настройка = БухгалтерскийУчет.ОпределитьНастройкуУчета(Период, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, "ПриоритетнаяКатегорияПриКлассификацииДолевыхЦенныхБумаг");
			Если НЕ ЗначениеЗаполнено(Настройка) Тогда
				Возврат Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой;
			Иначе	
				Возврат Настройка;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		Если СчетДоверительногоУправления = Неопределено Тогда
			Возврат Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток;
		Иначе
			Настройка = БухгалтерскийУчет.ОпределитьНастройкуУчета(Период, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, "ПриоритетнаяКатегорияПриКлассификацииДолговыхЦенныхБумаг");
			Если НЕ ЗначениеЗаполнено(Настройка) Тогда
				Возврат Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток;
			Иначе	
				Возврат Настройка;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция ПолучитьПереопределенныеУчетныеАктивыЦБРФ(Период, СчетДоверительногоУправления) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _Клиент
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО (СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПереопределениеКлассификацииУчетныхАктивовЦБСрезПоследних.Эмитент КАК Эмитент,
		|	ПереопределениеКлассификацииУчетныхАктивовЦБСрезПоследних.ИсходныйУчетныйАктивЦБ КАК ИсходныйУчетныйАктивЦБ,
		|	ПереопределениеКлассификацииУчетныхАктивовЦБСрезПоследних.НовыйУчетныйАктивЦБ КАК НовыйУчетныйАктивЦБ
		|ИЗ
		|	РегистрСведений.ПереопределениеКлассификацииУчетныхАктивовЦБ.СрезПоследних(
		|			&Период,
		|			(Организация, Клиент) В
		|				(ВЫБРАТЬ
		|					_Клиент.Организация,
		|					_Клиент.Клиент
		|				ИЗ
		|					_Клиент)) КАК ПереопределениеКлассификацииУчетныхАктивовЦБСрезПоследних");
	
	Запрос.УстановитьПараметр("Период",							Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	
	ПереопределенныеУчетныеАктивыЦБРФ = Запрос.Выполнить().Выгрузить();
	ПереопределенныеУчетныеАктивыЦБРФ.Индексы.Добавить("Эмитент, ИсходныйУчетныйАктивЦБ");
	
	Возврат ПереопределенныеУчетныеАктивыЦБРФ;

КонецФункции

Функция ПолучитьПереопределенныйУчетныйАктивЦБРФ(УчетныйАктивЦБРФ, Период, СчетДоверительногоУправления, Эмитент)

	Если СчетДоверительногоУправления = Неопределено Тогда
		Возврат УчетныйАктивЦБРФ;
	КонецЕсли;
	
	Если Период = '00010101' ИЛИ Период = Неопределено Тогда  
		ДатаНастроек = Период;
	ИначеЕсли ТипЗнч(Период) = Тип("Дата") ИЛИ ТипЗнч(Период) = Тип("Граница") Тогда
		ДатаНастроек = КонецДня(СистемныеФункции.ПолучитьДатуИзГраницы(Период));
	Иначе
		ВызватьИсключение СтрШаблон("Некорректный тип значения '%1' параметра 'Период'", ТипЗнч(Период));
	КонецЕсли;	
	
	ПереопределенныеУчетныеАктивыЦБРФ	= ПолучитьПереопределенныеУчетныеАктивыЦБРФ(ДатаНастроек, СчетДоверительногоУправления);
	ПереопределенныйУчетныйАктивЦБРФ	= ПереопределенныеУчетныеАктивыЦБРФ.НайтиСтроки(Новый Структура("Эмитент, ИсходныйУчетныйАктивЦБ", Эмитент, УчетныйАктивЦБРФ));
	УчетныйАктивЦБ						= ?(ПереопределенныйУчетныйАктивЦБРФ.Количество() = 0, УчетныйАктивЦБРФ, ПереопределенныйУчетныйАктивЦБРФ[0].НовыйУчетныйАктивЦБ);
	
	Возврат УчетныйАктивЦБ;

КонецФункции

Функция ОпределитьУчетныйАктивЕПС(Период, Рынок, Актив, СчетДоверительногоУправления = Неопределено) Экспорт

	Эмитент = Неопределено;
	
	Если Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
		
		АктивУчетныйАктивЦБРФ = ПолучитьПереопределенныйУчетныйАктивЦБРФ(Актив.УчетныйАктивЦБРФ, Период, СчетДоверительногоУправления, Актив.Эмитент);
		
		ПриоритетнаяКатегория = ОпределитьПриоритетнуюКатегориюПриКлассификации(СчетДоверительногоУправления, Рынок, Период);
		
		Если ПриоритетнаяКатегория = Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажи Тогда
			Если АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АОИБанков
				ИЛИ АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АПИБанков Тогда
			
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажиКредитныхОрганизаций;
				
			ИначеЕсли АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АОИ
				ИЛИ АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АПИ Тогда
				
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажиПрочихРезидентов;
				
			Иначе //незаполнено или что- то непонятное
				
				Если Справочники.ЮрФизЛица.ПолучитьФункциональнуюРоль(Актив.Эмитент.ЮрФизЛицо, "Банки") = Неопределено Тогда
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажиПрочихРезидентов;
				Иначе
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажиКредитныхОрганизаций;
				КонецЕсли;
				
			КонецЕсли;
		Иначе			
			Если АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АОИБанков
				ИЛИ АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АПИБанков Тогда
			
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливойКредитныхОрганизаций;
				
			ИначеЕсли АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АОИ
				ИЛИ АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АПИ Тогда
				
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливойПрочихРезидентов;
				
			Иначе //незаполнено или что- то непонятное
				
				Если Справочники.ЮрФизЛица.ПолучитьФункциональнуюРоль(Актив.Эмитент.ЮрФизЛицо, "Банки") = Неопределено Тогда
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливойПрочихРезидентов;
				Иначе
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливойКредитныхОрганизаций;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Паи Тогда
		//пока отправим на "посправедливой"
		
		// для паев нет возможности получать данные из <<УчетныйАктивЦБРФ>>
		УправляющаяКомпания = Справочники.УправляющиеКомпании.ПолучитьУправляющуюКомпаниюПИФДляПаяНаДату(Период, Актив);
		УправляющаяКомпания_ЮрЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УправляющаяКомпания, "ЮрФизЛицо");
		Если Справочники.ЮрФизЛица.ПолучитьФункциональнуюРоль(УправляющаяКомпания_ЮрЛицо, "Банки") = Неопределено Тогда
			УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливойПрочихРезидентов;
		Иначе
			УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливойКредитныхОрганизаций;
		КонецЕсли;
		
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.ДепозитарныеРасписки Тогда
		// К.Б.:  ДР классифицируются по базовому активу
		УчетныйАктивЦБРФ =  ОпределитьУчетныйАктивЕПС(Период, Перечисления.РынкиЦенныхБумаг.Акции, Актив.БазоваяЦБ, СчетДоверительногоУправления);
		
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия Тогда
		// а Х.З.
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Векселя Тогда
		
		Если Актив.Эмитент.ЮрФизЛицо = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии") Тогда
			УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ВекселяДоПогашенияРФ;
		Иначе
			
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма КАК ОрганизационноПравоваяФорма,
				|	РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации КАК СтранаРегистрации
				|ИЗ
				|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
				|			&Период,
				|			ЮрФизЛицо = &ЮрФизЛицо
				|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних";
				
			Запрос.УстановитьПараметр("Период",    Период);
			Запрос.УстановитьПараметр("ЮрФизЛицо", Актив.Эмитент.ЮрФизЛицо);
			
			ОПФ = Справочники.ОрганизационноПравовыеФормы.ПубличноеАкционерноеОбщество; // по умолчанию некое юр.лицо
			Страна = Справочники.СтраныМира.Россия;
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ОПФ = Выборка.ОрганизационноПравоваяФорма;
				Страна = Выборка.СтранаРегистрации;
			КонецЕсли;
			КредитнаяОрганизация = (Справочники.ЮрФизЛица.ПолучитьФункциональнуюРоль(Актив.Эмитент.ЮрФизЛицо, "Банки") <> Неопределено);
			
			Если Страна = Справочники.СтраныМира.Россия Тогда
				Если ОПФ = Справочники.ОрганизационноПравовыеФормы.ГосударственноеПредприятие Тогда
					Возврат Справочники.УчетныеАктивыЕПС.ВекселяДоПогашенияСубъектовРФ;	
				ИначеЕсли КредитнаяОрганизация Тогда
					Возврат Справочники.УчетныеАктивыЕПС.ВекселяДоПогашенияКредитныхОрганизаций;
				Иначе
					Возврат Справочники.УчетныеАктивыЕПС.ВекселяДоПогашенияПрочихРезидентов;
				КонецЕсли;
			Иначе
				Если ОПФ = Справочники.ОрганизационноПравовыеФормы.ГосударственноеПредприятие Тогда
					Возврат Справочники.УчетныеАктивыЕПС.ВекселяДоПогашенияИностранныхГосударств;	
				ИначеЕсли КредитнаяОрганизация Тогда
					Возврат Справочники.УчетныеАктивыЕПС.ВекселяДоПогашенияБанковНерезидентов;
				Иначе
					Возврат Справочники.УчетныеАктивыЕПС.ВекселяДоПогашенияПрочихНерезидентов;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		// пока на долговые по амортизации
		Если Справочники.ЮрФизЛица.ПолучитьФункциональнуюРоль(Актив.Эмитент.ЮрФизЛицо, "Банки") = Неопределено Тогда
			УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСДПрочихРезидентов;
		Иначе
			УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСДКредитныхОрганизаций;
		КонецЕсли;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		
		АктивУчетныйАктивЦБРФ = ПолучитьПереопределенныйУчетныйАктивЦБРФ(Актив.УчетныйАктивЦБРФ, Период, СчетДоверительногоУправления, Актив.Эмитент);
		
		ПриоритетнаяКатегория = ОпределитьПриоритетнуюКатегориюПриКлассификации(СчетДоверительногоУправления, Рынок, Период);
		
		Если ПриоритетнаяКатегория = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи Тогда
			Если АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииГосударства Тогда
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиРФ;
			ИначеЕсли АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииСубфедеральные Тогда
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиСубъектовРФ;
			ИначеЕсли АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковРезидентов Тогда
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиКредитныхОрганизаций;
			ИначеЕсли АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихРезидентов Тогда
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиПрочихРезидентов;
			ИначеЕсли АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковНерезидентов Тогда
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиБанковНерезидентов;
			ИначеЕсли АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихНерезидентов Тогда
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиПрочихНерезидентов;
			Иначе
				Если Актив.Категория = Перечисления.КатегорииОблигаций.Государственная Тогда
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиРФ;
				ИначеЕсли Актив.Категория = Перечисления.КатегорииОблигаций.Субфедеральная
						  ИЛИ Актив.Категория = Перечисления.КатегорииОблигаций.Муниципальная Тогда
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиСубъектовРФ;
				ИначеЕсли Актив.УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковРезидентов Тогда
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиКредитныхОрганизаций;
				ИначеЕсли Актив.УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихНерезидентов Тогда
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиПрочихРезидентов;
				ИначеЕсли Актив.УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковНерезидентов Тогда
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиБанковНерезидентов;
				Иначе
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиПрочихНерезидентов;
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииГосударства Тогда
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбытокРФ;
			ИначеЕсли АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииСубфедеральные Тогда
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбытокСубъектовРФ;
			ИначеЕсли АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковРезидентов Тогда
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбытокКредитныхОрганизаций;
			ИначеЕсли АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихРезидентов Тогда
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбытокПрочихРезидентов;
			ИначеЕсли АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковНерезидентов Тогда
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбытокБанковНерезидентов;
			ИначеЕсли АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихНерезидентов Тогда
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбытокПрочихНерезидентов;
			Иначе
				Если Актив.Категория = Перечисления.КатегорииОблигаций.Государственная Тогда
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбытокРФ;
				ИначеЕсли Актив.Категория = Перечисления.КатегорииОблигаций.Субфедеральная
						  ИЛИ Актив.Категория = Перечисления.КатегорииОблигаций.Муниципальная Тогда
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбытокСубъектовРФ;
				ИначеЕсли Актив.УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковРезидентов Тогда
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбытокКредитныхОрганизаций;
				ИначеЕсли Актив.УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихНерезидентов Тогда
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбытокПрочихНерезидентов;
				ИначеЕсли Актив.УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковНерезидентов Тогда
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбытокБанковНерезидентов;
				Иначе
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбытокПрочихРезидентов;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Фьючерсы Тогда
		
		// #ТехническийДолг - 28/10/17 - если никто не возвражает, так буду помечать те вещи, которые потом нужно будет переделать
		
		// АД!!!!
		НаименованиеАктива = Лев(Актив.Наименование, СтрНайти(Актив.Наименование, "-") - 1);
		
		Индексы = "RTS,MXI,MIX,RVI";
		Акции = "SBRF,GAZR,LKOH,VTBR,SBPR,MGNT,ROSN,HYDR,GMKR,SNGP,FEES,ALRS,MOEX,SNGR,RTKM,NLMK,AFLT,TATN,CHMF,NOTK,MTSI,TRNF";
		Облигации = "OF10,OFZ4,OFZ2,OF15,OFZ6";
		Валюта = "Si,ED,Eu,UJPY,GBPU,AUDU,UCAD,UCHF";
		ПроцентныеСтавки = "RUON";
		ТоварныеКонтракты = "BR,GOLD,SILV,PLT,PLD";
		
		Если СтрНайти(Индексы, НаименованиеАктива) > 0 Тогда
			УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ПроизводныеФинансовыеИнструментыОснованныеНаДолевыхИнструментах;
		ИначеЕсли СтрНайти(Акции, НаименованиеАктива) > 0 Тогда
			УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ПроизводныеФинансовыеИнструментыОснованныеНаДолевыхИнструментах;
		ИначеЕсли СтрНайти(Облигации, НаименованиеАктива) > 0 Тогда
			УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ПроизводныеФинансовыеИнструментыОснованныеНаПроцентныхДоговорах;
		ИначеЕсли СтрНайти(Валюта, НаименованиеАктива) > 0 Тогда
			УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ПроизводныеФинансовыеИнструментыОснованныеНаВалютныхДоговорах;
		ИначеЕсли СтрНайти(ПроцентныеСтавки, НаименованиеАктива) > 0 Тогда
			УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ПроизводныеФинансовыеИнструментыОснованныеНаПроцентныхДоговорах;
		Иначе
			УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ПроизводныеФинансовыеИнструментыОснованныеНаПрочихДоговорах;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Актив) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		
		УчетныйАктивЦБРФ = Справочники.ДепозитныеВклады.ОпределитьУчетныйАктивДепозита(Актив, Период);
		
	КонецЕсли;
	
	Возврат УчетныйАктивЦБРФ;
	
КонецФункции

// Возвращает дату начала учета резервов по ЗПИФ в бухгалтерском учете
Функция ПолучитьДатуНачалаУчетаРезервовЗПИФВБухУчете() Экспорт
	Возврат Дата(2019, 1, 1);
КонецФункции
