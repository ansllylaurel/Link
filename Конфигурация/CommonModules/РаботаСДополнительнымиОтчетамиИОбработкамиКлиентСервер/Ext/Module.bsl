
//Функция сравнивает версию открытой обработки с версией в справочнике ДополнительныеОтчетыИОбработки
//В случае, если обработки нет в справочнике или версии не отличаются возвращает Истина, иначе Ложь.
//Возможно так же использование как процедуры через Отказ
Функция ПроверитьАктуальностьВерсииОбработки(Форма, Отказ = Ложь) Экспорт
	
	ЧастиИмениФормы = СтрРазделить(Форма.ИмяФормы, ".");
	
	ИмяОбъекта = ЧастиИмениФормы[1];
	
	АктуальнаяВерсияОбработки = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьАктуальнуюВерсиюОбработкиПоИмениОбъекта(ИмяОбъекта);
	
	Если ЗначениеЗаполнено(АктуальнаяВерсияОбработки) //если обработка новая, версии не будет
	   И Форма.ВерсияДополнительногоОтчетаИлиОбработки <> АктуальнаяВерсияОбработки Тогда
	   
		Если ЧастиИмениФормы[0] = "ВнешнийОтчет" Тогда
	    	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Версия отчёта обновилась. Переоткройте отчёт.",,,, Отказ);	
		Иначе
	    	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Версия обработки обновилась. Переоткройте обработку.",,,, Отказ);	
		КонецЕсли;

		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции