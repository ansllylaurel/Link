#Область Общие_обработчики_событий

Процедура СостояниеДокументаОбработкаНавигационнойСсылки(Форма, ОсновнойРеквизит, Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка) Экспорт

	СтандартнаяОбработка = Ложь;
	
	// Получаем навигационные ссылки закрытых счетов д/у	
	
	НавигационныеСсылки = СтрРазделить(НавигационнаяСсылкаФорматированнойСтроки, "|");
	
	Если НавигационныеСсылки.Количество() = 1 Тогда
		
		НавигационнаяСсылка = НавигационныеСсылки[0];	
		
	Иначе	
		
		ПредставленияСсылок = ПолучитьПредставленияНавигационныхСсылок(НавигационныеСсылки);
	
		СписокСчетов = Новый СписокЗначений;
		Для Каждого ПредставлениеСсылки Из ПредставленияСсылок Цикл
			СписокСчетов.Добавить(ПредставлениеСсылки.НавигационнаяСсылка, ПредставлениеСсылки.Текст);
		КонецЦикла;
		
		ЭлементСписка = СписокСчетов.ВыбратьЭлемент("Список счетов д/у");
		Если ЭлементСписка = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		НавигационнаяСсылка = ЭлементСписка.Значение;

	КонецЕсли;	
	
	// Открываем форму с датами запрета
	
	СчетДоверительногоУправления = СистемныеФункции.ПолучитьСсылкуПоНавигационнойСсылке(НавигационнаяСсылка);
	
	ПараметрыФормы = Новый Структура("ОтображатьБухгалтерскийУчет, ОтображатьНалоговыйУчет, ОтображатьЕдиныйБухгалтерскийУчет");
	ПараметрыФормы.Вставить("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	ПараметрыФормы.Вставить("Организация",					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "Организация"));

	ОткрытьФормуМодально("РегистрСведений.ДатыЗапретаРедактирования.Форма.НастройкиДатЗапрета", ПараметрыФормы, Форма);
	
	// Обновляем статус документа
	
	ТекстЗапрета = Неопределено;
		
	Если РаботаСДокументами.ЗапретРедактированияДокумента(ОсновнойРеквизит, , , Ложь, ТекстЗапрета) Тогда

		РаботаСДокументамиКлиентСервер.УстановитьСостояниеДокумента(Форма, ТекстЗапрета, "ДатаЗапретаРедактирования");

	ИначеЕсли Форма.ТолькоПросмотр Тогда

		// Т.к. неизвестны все причины, по которым форма открыта только для просмотра,
		// можем только переоткрыть ее
		
		ИмяФормы					= Форма.ИмяФормы;
		Параметры					= Новый Структура("Ключ", Форма.Параметры.Ключ);
		МодальныйРежим				= Форма.МодальныйРежим;
		ВладелецФормы				= Форма.ВладелецФормы;
		КлючУникальности			= Форма.КлючУникальности;
		Окно						= Форма.Окно;
		РежимОткрытияОкна			= Форма.РежимОткрытияОкна;
		
		Форма.Закрыть();
		
		Если МодальныйРежим Тогда
			ОткрытьФормуМодально(ИмяФормы, Параметры, ВладелецФормы);
		Иначе
			ОткрытьФорму(ИмяФормы, Параметры, ВладелецФормы, КлючУникальности, Окно, , , РежимОткрытияОкна);
		КонецЕсли;

	Иначе

		РаботаСДокументамиКлиентСервер.УстановитьСостояниеДокумента(Форма, ТекстЗапрета, "ДатаЗапретаРедактирования");
		
	КонецЕсли;
		
КонецПроцедуры		

#КонецОбласти

#Область Работа_с_шаблонами

Процедура ПриВыбореШаблона(Форма, Команда) Экспорт
	
	МассивИмяКоманды = СтрРазделить(Команда.Имя, "_");
	
	ИмяРеквизита	= МассивИмяКоманды[0];
	Идентификатор	= МассивИмяКоманды[2];
	
	Если Команда.ИспользуемаяТаблица = Неопределено Тогда
		ИмяЭлемента = ИмяРеквизита;  
	Иначе
		ИмяЭлемента = Команда.ИспользуемаяТаблица.Имя + ИмяРеквизита;  
	КонецЕсли;
	
	Шаблон = Форма["СписокШаблонов_" + ИмяЭлемента].НайтиПоИдентификатору(Идентификатор);
	Если Шаблон <> Неопределено Тогда
		Если Команда.ИспользуемаяТаблица = Неопределено Тогда
			Форма.Объект[ИмяРеквизита] = Шаблон.Значение;
		Иначе
			Команда.ИспользуемаяТаблица.ТекущиеДанные[ИмяРеквизита] = Шаблон.Значение;
		КонецЕсли;
		
		Форма.Модифицированность = Истина;

	КонецЕсли;
КонецПроцедуры

#КонецОбласти

Процедура РасшифроватьРасчетПроцентныхПоказателей(Объект, ЭтаФорма) Экспорт

	Если Объект.Рынок <> ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Облигации") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расшифровка расчета доступна только для облигаций");
		Возврат;
	КонецЕсли; 
	
	ЭтоИсполнение = (ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке"));
	ЭтоПоставка = (ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг"));
	ЭтоСделка = (ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.Сделка"));
	
	Если НЕ ЭтоИсполнение И НЕ ЭтоСделка И НЕ ЭтоПоставка Тогда
		Возврат;
	КонецЕсли;
	
	Сделка = ?(ЭтоСделка, Объект.Ссылка, Объект.Основание);
	
	ЭтоПродажа = ?(ЭтоПоставка, Объект.ВидДвижения = ПредопределенноеЗначение("Перечисление.ВидыДвижений.Расход"), Объект.ВидСделки = ПредопределенноеЗначение("Перечисление.ВидыСделок.Продажа"));
	ЭтоПокупка = ?(ЭтоПоставка, Объект.ВидДвижения = ПредопределенноеЗначение("Перечисление.ВидыДвижений.Приход"), Объект.ВидСделки = ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка"));
	
	Если ЭтоПродажа Тогда
	
		СписокПартий = БухгалтерскийУчетЕПС.ПолучитьСписокПроданныхПартийПоРегистратору(Объект.Ссылка);
		
		Если СписокПартий.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет движений по регистру ""Партии ценных бумаг""");
			Возврат;
		КонецЕсли;
		
		ЭлементСпискаПартий =  СписокПартий.ВыбратьЭлемент("Партия");
		Если ЭлементСпискаПартий = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбрали партию");
			Возврат;
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура("ДатаПереоценки, Организация, СчетДоверительногоУправления, 
			|Количество, ОценочнаяСуммаКупона, ЦеннаяБумага, Партия, СтрокаПартии, УчетныйАктивЕПС, Стоимость",
			Объект.Дата,
			Объект.Организация,
			Объект.СчетДоверительногоУправления,
			ЭлементСпискаПартий.Значение.Количество,
			ЭлементСпискаПартий.Значение.ОценочнаяСуммаКупона,
			ЭлементСпискаПартий.Значение.ЦеннаяБумага,
			ЭлементСпискаПартий.Значение.Партия,
			ЭлементСпискаПартий.Значение.СтрокаПартии,
			ЭлементСпискаПартий.Значение.УчетныйАктивЕПС,
			ЭлементСпискаПартий.Значение.Стоимость);
			
	ИначеЕсли ЭтоПокупка Тогда
		
		УчетныеАктивы = БухгалтерскийУчетЕПС.ОпределитьУчетныеАктивыЕПСДляСделки(Сделка);
		Если УчетныеАктивы.Количество() = 1 Тогда
			УчетныйАктивЕПС = УчетныеАктивы[0];
		Иначе
			СписокУчетныеАктивы = Новый СписокЗначений();
			СписокУчетныеАктивы.ЗагрузитьЗначения(УчетныеАктивы);
			ЭлементСписокУчетныеАктивы = СписокУчетныеАктивы.ВыбратьЭлемент("Выберите учетный актив");
			Если ЭлементСписокУчетныеАктивы = Неопределено Тогда
				Возврат;
			КонецЕсли;
			УчетныйАктивЕПС = ЭлементСписокУчетныеАктивы.Значение;
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура("ДатаПереоценки, Организация, СчетДоверительногоУправления, 
			|Количество, ОценочнаяСуммаКупона, ЦеннаяБумага, Партия, СтрокаПартии, УчетныйАктивЕПС",
			Объект.Дата,
			Объект.Организация,
			Объект.СчетДоверительногоУправления,
			ЭтаФорма.ЦенныеБумагиКоличество1,
			ЭтаФорма.ЦенныеБумагиСуммаКупона1,
			ЭтаФорма.ЦенныеБумагиЦеннаяБумага1,
			Объект.Ссылка,
			1,
			УчетныйАктивЕПС);
			
	КонецЕсли;
	
	ОткрытьФорму("Отчет.РасшифровкаРасчетаАмортизацииДисконтаПремииИКорректировкиПоЭСП.Форма.Форма", ПараметрыФормы, ЭтаФорма, ЭтаФорма,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца)

КонецПроцедуры

Функция ПроверитьИВывестиОповещениеОПроверкеПартийПриИзмененииДатЗапрета(ДанныеПроверки) Экспорт

	ВыводитьСостояние = БухгалтерскийУчет.ДатаЗапретаПартийПереноситсяВперед(ДанныеПроверки);
	
	Если ВыводитьСостояние Тогда
	
		Состояние("Проверка партий... Ждите...");
	
	КонецЕсли;
	
	Возврат ВыводитьСостояние;

КонецФункции

