// Открывает форму для выбора настроек в хранилище вариантов и настроек отчетов и возращает настройки из него по выбранному ключу
//
// Параметры:
//	КлючОбъекта					- Строка						- ключ объекта
//	КлючТекущихНастроек			- Строка						- ключ текущих настроек
//	Организация					- СправочникСсылка.Организации	- для выбора настроек указанной организации
//								- Неопределено					- для выбора настроек текущей организации пользователя
//	ОбновитьКлючТекущихНастроек	- Булево						- при выборе настроек параметру КлючТекущихНастроек будет присвоено значение ключа выбранных настроек
//
// Возвращаемое значение:
//	Структура - описание настроек с ключами:
//		- КлючНастроек	- Строка		- ключ настроек
//		- Настройки		- Произвольный	- полученные настройки
//	Неопределено - если настройки не были выбраны
//
Функция ПолучитьНастройкиИзХранилищаВариантовИНастроекОтчетов(КлючОбъекта, КлючТекущихНастроек, Организация = Неопределено, ОбновитьКлючТекущихНастроек = Истина) Экспорт
	
	Перем ОписаниеРезультата;
	
	ВыборНастроек = ВыбратьЗагружаемыеНастройкиИзХранилищаВариантовИНастроекОтчетов(КлючОбъекта, КлючТекущихНастроек, Организация, ОбновитьКлючТекущихНастроек);
	
	Если ТипЗнч(ВыборНастроек) = Тип("ВыборНастроек") Тогда

		Настройки = РаботаСХранилищем.ХранилищеВариантовИНастроекОтчетовЗагрузить(КлючОбъекта, КлючТекущихНастроек);
		
		ОписаниеРезультата = Новый Структура("КлючНастроек, Настройки", ВыборНастроек.КлючНастроек, Настройки);
		
	КонецЕсли;
	
	Возврат ОписаниеРезультата;
	
КонецФункции

// Открывает форму для выбора настроек в хранилище вариантов и настроек отчетов и помещает настройки из него по выбранному ключу во временное хранилище
//
// Параметры:
//	КлючОбъекта					- Строка						- ключ объекта
//	КлючТекущихНастроек			- Строка						- ключ текущих настроек
//	Организация					- СправочникСсылка.Организации	- для выбора настроек указанной организации
//								- Неопределено					- для выбора настроек текущей организации пользователя
//	ОбновитьКлючТекущихНастроек	- Булево						- при выборе настроек параметру КлючТекущихНастроек будет присвоено значение ключа выбранных настроек
//
// Возвращаемое значение:
//	Структура - описание настроек с ключами:
//		- КлючНастроек						- Строка	- ключ настроек
//		- АдресНастроекВоВременномХранилище	- Строка	- адрес во временном хранилище полученных настроек
//	Неопределено - если настройки не были выбраны
//
Функция ПоместитьНастройкиИзХранилищаВариантовИНастроекОтчетовВоВременноеХранилище(КлючОбъекта, КлючТекущихНастроек, АдресНастроек, Организация = Неопределено, ОбновитьКлючТекущихНастроек = Истина) Экспорт
	
	Перем ОписаниеРезультата;
	
	ВыборНастроек = ВыбратьЗагружаемыеНастройкиИзХранилищаВариантовИНастроекОтчетов(КлючОбъекта, КлючТекущихНастроек, Организация, ОбновитьКлючТекущихНастроек);
	
	Если ТипЗнч(ВыборНастроек) = Тип("ВыборНастроек") Тогда

		АдресНастроекВоВременномХранилище = РаботаСХранилищем.ХранилищеВариантовИНастроекОтчетовЗагрузитьВоВременноеХранилище(КлючОбъекта, КлючТекущихНастроек, АдресНастроек);
		
		ОписаниеРезультата = Новый Структура("КлючНастроек, АдресНастроекВоВременномХранилище", ВыборНастроек.КлючНастроек, АдресНастроекВоВременномХранилище);
		
	КонецЕсли;

	Возврат ОписаниеРезультата;

КонецФункции

