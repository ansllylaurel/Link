
&НаКлиенте
Процедура РазвернутьВсеЭлементыДерева(ДанныеДерево, ТаблицаФормы) Экспорт
	
	Для каждого Элемент Из ДанныеДерево.ПолучитьЭлементы() Цикл
		ТаблицаФормы.Развернуть(Элемент.ПолучитьИдентификатор(), Истина);
	КонецЦикла;
	
КонецПроцедуры // РазвернутьВсеЭлементыДерева

&НаКлиенте
Процедура СвернутьВсеЭлементыДерева(ДанныеДерево, ТаблицаФормы) Экспорт
	
	Для каждого Элемент Из ДанныеДерево.ПолучитьЭлементы() Цикл
		
		СвернутьВсеЭлементыДерева(Элемент, ТаблицаФормы);
		
		ТаблицаФормы.Свернуть(Элемент.ПолучитьИдентификатор());
		
	КонецЦикла;
	
КонецПроцедуры // СвернутьВсеЭлементыДерева

&НаКлиенте
Процедура ПолучитьКлючиРазвернутыхСтрокДерева(ДанныеДерево, ТаблицаФормы, ПолеКлюча = "Ключ", КлючиРазвернутыхСтрок) Экспорт
	
	Если ТипЗнч(КлючиРазвернутыхСтрок) <> Тип("Массив") Тогда
		КлючиРазвернутыхСтрок = Новый Массив();
	КонецЕсли;
	
	Для каждого Элемент Из ДанныеДерево.ПолучитьЭлементы() Цикл
		
		ЭлементРазвернут = ТаблицаФормы.Развернут(Элемент.ПолучитьИдентификатор());
		
		Если ЭлементРазвернут <> Неопределено И ЭлементРазвернут Тогда
			КлючиРазвернутыхСтрок.Добавить(Элемент[ПолеКлюча]);
		КонецЕсли;
		
		ПолучитьКлючиРазвернутыхСтрокДерева(Элемент, ТаблицаФормы, ПолеКлюча, КлючиРазвернутыхСтрок);
		
	КонецЦикла;
	
КонецПроцедуры // ПолучитьКлючиРазвернутыхСтрокДерева

&НаКлиенте
Процедура ВосстановитьРазвернутыеСтрокиДереваПоКлючу(ДанныеДерево, ТаблицаФормы, ПолеКлюча = "Ключ", КлючиРазвернутыхСтрок) Экспорт
	
	Если ТипЗнч(КлючиРазвернутыхСтрок) <> Тип("Массив") Или КлючиРазвернутыхСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Элемент Из ДанныеДерево.ПолучитьЭлементы() Цикл
		
		Если КлючиРазвернутыхСтрок.Найти(Элемент[ПолеКлюча]) <> Неопределено Тогда
			ТаблицаФормы.Развернуть(Элемент.ПолучитьИдентификатор());
		КонецЕсли;
		
		ВосстановитьРазвернутыеСтрокиДереваПоКлючу(Элемент, ТаблицаФормы, ПолеКлюча, КлючиРазвернутыхСтрок);
		
	КонецЦикла;
	
КонецПроцедуры // ВосстановитьРазвернутыеСтрокиДереваПоКлючу

&НаКлиенте
Функция ПолучитьКлючТекущейСтроки(ТаблицаФормы, ПолеКлюча = "Ключ") Экспорт
	
	ТекущиеДанные = ТаблицаФормы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ТекущиеДанные[ПолеКлюча];
	
КонецФункции // ПолучитьКлючТекущейСтроки

&НаКлиенте
Процедура ВосстановитьТекущуюСтрокуПоКлючу(ДанныеФормы, ТаблицаФормы, ПолеКлюча = "Ключ", КлючТекущейСтроки) Экспорт
	
	Если ПолеКлюча = "" Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеФормы) = Тип("ДанныеФормыДерево") Или ТипЗнч(ДанныеФормы) = Тип("ДанныеФормыЭлементДерева") Тогда
		
		Для каждого Элемент Из ДанныеФормы.ПолучитьЭлементы() Цикл
			
			Если Элемент[ПолеКлюча] = КлючТекущейСтроки Тогда
				
				ТаблицаФормы.ТекущаяСтрока = Элемент.ПолучитьИдентификатор();
				
				ПолеКлюча = "";
				
				Возврат;
				
			КонецЕсли;
			
			ВосстановитьТекущуюСтрокуПоКлючу(Элемент, ТаблицаФормы, ПолеКлюча, КлючТекущейСтроки);
			
			Если ПолеКлюча = "" Тогда
				Возврат;
			КонецЕсли;
			
		КонецЦикла;

	ИначеЕсли ТипЗнч(ДанныеФормы) = Тип("ДанныеФормыКоллекция") Тогда
		
		Для каждого Элемент Из ДанныеФормы Цикл
			Если Элемент[ПолеКлюча] = КлючТекущейСтроки Тогда
				ТаблицаФормы.ТекущаяСтрока = Элемент.ПолучитьИдентификатор();
				Возврат;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ВосстановитьТекущуюСтрокуПоКлючу

////////////////////////////////////////////////////////////////////////////////

Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка, Модифицированность) Экспорт
	
	Если Модифицированность Тогда
		ТекстПредупреждения = "Закрыть форму без сохранения изменений?";
		Если ЗавершениеРаботы ИЛИ Вопрос(ТекстПредупреждения, РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

