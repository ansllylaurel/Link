Функция СформироватьЗаголовокПриложения() Экспорт
	
	ТекущаяОрганизация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущаяОрганизация, "ПрефиксНумерации, Наименование, ЗаголовокСистемы");
	
	КлючСистемы = ?(ПустаяСтрока(РеквизитыОрганизации.ПрефиксНумерации), РеквизитыОрганизации.Наименование, РеквизитыОрганизации.ПрефиксНумерации);
	
	Если ПустаяСтрока(РеквизитыОрганизации.ЗаголовокСистемы) Тогда
		РеквизитыОрганизации.ЗаголовокСистемы = РаботаСМетаданнымиПовтИсп.ПолучитьСинонимКонфигурации();
	КонецЕсли;
	
	Если Не ОбщегоНазначения.ЗначениеПараметраСеанса("ЭтоРабочаяИнформационнаяБаза") Тогда
		// чтобы не налажать, работая на боевой вместо копии, отобразим сведения о копии в заголовке
		ИмяИнфБазы = СистемныеФункции.ПолучитьИмяИнформационноБазы();
		Возврат "(КОПИЯ - " + СтрЗаменить(ИмяИнфБазы, "AssetManagement", "") +  ") " + КлючСистемы + " - " + РеквизитыОрганизации.ЗаголовокСистемы;
	Иначе
		Возврат КлючСистемы + " - " + РеквизитыОрганизации.ЗаголовокСистемы;
	КонецЕсли;
	
КонецФункции // СформироватьЗаголовокПриложения

Процедура ЗаполнитьПараметрыРаботыКлиентаПриЗавершении() Экспорт

	// позже можно будет поместить параметр в регистр сведений ЗначенияНастроекПользователей
	ПараметрыРаботыКлиентаПриЗавершении.Вставить("ПоказыватьПредупреждениеПередЗавершениемРаботыСистемы", ОбщегоНазначения.ЗначениеПараметраСеанса("ЭтоРабочаяИнформационнаяБаза"));

КонецПроцедуры

Процедура ПровестиПоБухгалтерскомуУчету(ЭтаФорма) Экспорт

	Если ЭтаФорма.Модифицированность Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведение по бухгалтерскому учету возможно только для не модифицированного документа");
		
	Иначе
		
		ПараметрыФормы = Новый Структура("Документ", ЭтаФорма.Объект.Ссылка);
		ОткрытьФормуМодально("ОбщаяФорма.ФормаПроведенияПоБухгалтерскомуУчету", ПараметрыФормы, ЭтаФорма);
	
	КонецЕсли;

КонецПроцедуры

Функция ПоказатьДеревоЗначений(АдресДереваЗначений, ТекстПодсказки = "", Владелец = Неопределено, Кнопки = Неопределено, КнопкаПоУмолчанию = "ОК", Заголовок = "", ДополнительныеПараметры = Неопределено) Экспорт
	
	СписокКнопок = Новый СписокЗначений;
	
	Если Кнопки = РежимДиалогаВопрос.ДаНет Тогда
		СписокКнопок.Добавить("Да");
		СписокКнопок.Добавить("Нет");
	ИначеЕсли Кнопки = РежимДиалогаВопрос.ОКОтмена Тогда
		СписокКнопок.Добавить("ОК");
		СписокКнопок.Добавить("Отмена");
	ИначеЕсли Кнопки = РежимДиалогаВопрос.ОК Тогда
		СписокКнопок.Добавить("ОК");
	ИначеЕсли ТипЗнч(Кнопки) = Тип("Строка") Тогда
		Для Каждого Кнопка Из Новый Структура(Кнопки) Цикл
			СписокКнопок.Добавить(Кнопка.Ключ);
		КонецЦикла;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресДереваЗначений",	АдресДереваЗначений);
	ПараметрыФормы.Вставить("Кнопки",				СписокКнопок);
	ПараметрыФормы.Вставить("КнопкаПоУмолчанию",	Строка(КнопкаПоУмолчанию));
	ПараметрыФормы.Вставить("Заголовок",			Заголовок);
	ПараметрыФормы.Вставить("ТекстПодсказки",		ТекстПодсказки);
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		Для Каждого ДополнительныйПараметр Из ДополнительныеПараметры Цикл
			ПараметрыФормы.Вставить(ДополнительныйПараметр.Ключ, ДополнительныйПараметр.Значение);		
		КонецЦикла;
	КонецЕсли;
	
	КодВозврата				= Неопределено;
	ДополнительныеПараметры = Неопределено;	
	
	РезультатОткрытия = ОткрытьФормуМодально("ОбщаяФорма.ФормаДереваЗначений", ПараметрыФормы, Владелец);
	Если ТипЗнч(РезультатОткрытия) = Тип("Структура") Тогда
		ДополнительныеПараметры = РезультатОткрытия;
		ДополнительныеПараметры.Свойство("КодВозврата", КодВозврата); 
	КонецЕсли;
	
	Возврат КодВозврата;

КонецФункции

#Область Работа_с_хранилищем_вариантов_и_настроек_отчетов

// Открывает форму для выбора сохраняемых настроек в хранилище вариантов и настроек отчетов
//
// Параметры:
//	КлючОбъекта					- Строка						- ключ объекта
//	КлючТекущихНастроек			- Строка						- ключ текущих настроек
//	Организация					- СправочникСсылка.Организации	- для выбора настроек указанной организации
//								- Неопределено					- для выбора настроек текущей организации пользователя
//	ОбновитьКлючТекущихНастроек	- Булево						- при выборе настроек параметру КлючТекущихНастроек будет присвоено значение ключа выбранных настроек
//
// Возвращаемое значение:
//	ВыборНастроек	- выбранное значение
//	Неопределено	- если настройки не были выбраны
//
Функция ВыбратьСохраняемыеНастройкиИзХранилищаВариантовИНастроекОтчетов(КлючОбъекта, КлючТекущихНастроек, Организация = Неопределено, ОбновитьКлючТекущихНастроек = Истина) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КлючОбъекта",			КлючОбъекта);
	ПараметрыФормы.Вставить("КлючТекущихНастроек",	КлючТекущихНастроек);
	ПараметрыФормы.Вставить("Организация",			Организация);
	
	ВыборНастроек = ОткрытьФормуМодально("ХранилищеНастроек.ХранилищеВариантовИНастроекОтчетов.ФормаСохранения", ПараметрыФормы);
	
	Если ТипЗнч(ВыборНастроек) = Тип("ВыборНастроек") И ОбновитьКлючТекущихНастроек Тогда

		КлючТекущихНастроек = ВыборНастроек.КлючНастроек;
		
	КонецЕсли;
		
	Возврат ВыборНастроек;
	
КонецФункции

// Открывает форму для выбора настроек в хранилище вариантов и настроек отчетов и сохраняет в нем переданные настройки по выбранному ключу
//
// Параметры:
//	КлючОбъекта					- Строка						- ключ объекта
//	КлючТекущихНастроек			- Строка						- ключ текущих настроек
//	Настройки					- Произвольный					- сохраняемые настройки
//	Организация					- СправочникСсылка.Организации	- для выбора настроек указанной организации
//								- Неопределено					- для выбора настроек текущей организации пользователя
//	ОбновитьКлючТекущихНастроек	- Булево						- при выборе настроек параметру КлючТекущихНастроек будет присвоено значение ключа выбранных настроек
//
// Возвращаемое значение:
//	ВыборНастроек	- выбранное значение
//	Неопределено	- если настройки не были выбраны
//
Функция СохранитьНастройкиВХранилищеВариантовИНастроекОтчетов(КлючОбъекта, КлючТекущихНастроек, Настройки, Организация = Неопределено, ОбновитьКлючТекущихНастроек = Истина) Экспорт
	
	ВыборНастроек = ВыбратьСохраняемыеНастройкиИзХранилищаВариантовИНастроекОтчетов(КлючОбъекта, КлючТекущихНастроек, Организация, ОбновитьКлючТекущихНастроек);
	
	Если ТипЗнч(ВыборНастроек) = Тип("ВыборНастроек") Тогда
		
		РаботаСХранилищем.ХранилищеВариантовИНастроекОтчетовСохранить(КлючОбъекта, ВыборНастроек.КлючНастроек, Настройки);
		
	КонецЕсли;
	
	Возврат ВыборНастроек;
	
КонецФункции

// Открывает форму для выбора настроек в хранилище вариантов и настроек отчетов и сохраняет в нем переданные по адресу во временном хранилище настройки по выбранному ключу
//
// Параметры:
//	КлючОбъекта						- Строка						- ключ объекта
//	КлючТекущихНастроек				- Строка						- ключ текущих настроек
//	АдресНастроек					- Строка						- адрес сохраняемых настроек во временном хранилище
//	Организация						- СправочникСсылка.Организации	- для выбора настроек указанной организации
//									- Неопределено					- для выбора настроек текущей организации пользователя
//	ОбновитьКлючТекущихНастроек		- Булево						- при выборе настроек параметру КлючТекущихНастроек будет присвоено значение ключа выбранных настроек
//	УдалитьИзВременногоХранилища	- Булево						- после сохранения настройки из временного хранилища будут удалены
//
// Возвращаемое значение:
//	ВыборНастроек	- выбранное значение
//	Неопределено	- если настройки не были выбраны
//
Функция СохранитьНастройкиИзВременногоХранилищаВХранилищеВариантовИНастроекОтчетов(КлючОбъекта, КлючТекущихНастроек, АдресНастроек, Организация = Неопределено, ОбновитьКлючТекущихНастроек = Истина, УдалитьИзВременногоХранилища = Истина) Экспорт
	
	ВыборНастроек = ВыбратьСохраняемыеНастройкиИзХранилищаВариантовИНастроекОтчетов(КлючОбъекта, КлючТекущихНастроек, Организация, ОбновитьКлючТекущихНастроек);
	
	Если ТипЗнч(ВыборНастроек) = Тип("ВыборНастроек") Тогда
		
		РаботаСХранилищем.ХранилищеВариантовИНастроекОтчетовСохранитьИзВременногоХранилища(КлючОбъекта, ВыборНастроек.КлючНастроек, АдресНастроек, , , , УдалитьИзВременногоХранилища);
		
	КонецЕсли;
	
	Возврат ВыборНастроек;
	
КонецФункции

// Открывает форму для выбора загружаемых настроек из хранилища вариантов и настроек отчетов
//
// Параметры:
//	КлючОбъекта					- Строка						- ключ объекта
//	КлючТекущихНастроек			- Строка						- ключ текущих настроек
//	Организация					- СправочникСсылка.Организации	- для выбора настроек указанной организации
//								- Неопределено					- для выбора настроек текущей организации пользователя
//	ОбновитьКлючТекущихНастроек	- Булево						- при выборе настроек параметру КлючТекущихНастроек будет присвоено значение ключа выбранных настроек
//
// Возвращаемое значение:
//	ВыборНастроек	- выбранное значение
//	Неопределено	- если настройки не были выбраны
//
Функция ВыбратьЗагружаемыеНастройкиИзХранилищаВариантовИНастроекОтчетов(КлючОбъекта, КлючТекущихНастроек, Организация = Неопределено, ОбновитьКлючТекущихНастроек = Истина) Экспорт
	
	ПараметрыФормы = Новый Структура;
