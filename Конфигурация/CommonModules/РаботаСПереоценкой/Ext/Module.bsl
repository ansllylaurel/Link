		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	ТаблицаЦБ.ВалютаНоминала,
		|	0,
		|	0,
		|	0,
		|	0,
		|	ИСТИНА
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|ГДЕ
		|	ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости = ИСТИНА";
		
	#КонецОбласти	
		
	ПоследняяДатаТорговБлумберга	= РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки);	
	
	РабочихДнейНазад10				= Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(), НачалоДня(ДатаПереоценки), -10);
	ТорговыхДнейНазад30				= Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(), НачалоДня(ДатаПереоценки), -30);
	ПоследняяДатаТоргов				= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(), НачалоДня(ДатаПереоценки));
	ДатаЦенНРД						= ?(ДатаПереоценки >= '20200101', НачалоДня(ДатаПереоценки), ПоследняяДатаТоргов); 
	
	ИностранныеУчетныеАктивы		= Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();
	
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберга",	ПоследняяДатаТорговБлумберга);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",			ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("ДатаЦенНРД",						ДатаЦенНРД);
	
	Запрос.УстановитьПараметр("НРД",							ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("ММВБ",							ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));	
	Запрос.УстановитьПараметр("Блумберг",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("Режим_BGN",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	
	Запрос.УстановитьПараметр("Рубли",							ПараметрыОценки.Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("РабочихДнейНазад10",				РабочихДнейНазад10);
	Запрос.УстановитьПараметр("БумагиНерезидентов",				ИностранныеУчетныеАктивы);
	Запрос.УстановитьПараметр("ОВОЗ",							Перечисления.ВидыГосударственныхОблигаций.ОВОЗ);
	
	// Настройки методики 
	Запрос.УстановитьПараметр("БратьЦеныНРДВПроцентах",			ДатаПереоценки >= '20190715');

	//ВНИМАНИЕ! С 22.06.2020 Сбербанк (он единственный на методике Атомфонд2018 в 2020 году) использует итоги только основной сессии,
	// в тексте запроса заменяются поля для котировок
	Если ДатаПереоценки >= '20200622' Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КотировкиТорговыхПлощадок.BID", 		"КотировкиТорговыхПлощадок.BID_MAIN");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КотировкиТорговыхПлощадок.OFFER", 	"КотировкиТорговыхПлощадок.OFFER_MAIN");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КотировкиТорговыхПлощадок.NUMTRADES", "КотировкиТорговыхПлощадок.NUMTRADES_MAIN");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КотировкиТорговыхПлощадок.VALUE", 	"КотировкиТорговыхПлощадок.VALUE_MAIN");
	КонецЕсли;
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Атомфонда 2018 (ЕПС)", "Промежуточная таблица стоимостей ЦБ");		
	КонецЕсли;
	
	// Расчет и тестирование цен
	
	ПараметрыРасчетаРейтинга		 = ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда = ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
	
	Для Каждого СтрокаСтоимости Из ТаблицаСтоимостейЦБ Цикл
		
		Если СтрокаСтоимости.ОценкаПоАмортизированнойСтоимости Тогда
			
			// Амортизированную стоимость считаем в процедуре ЗаполнитьПереоценкуАтомфонда, т.к. она зависит от даты покупки 
						
		Иначе
			
			// Справедливая стоимость		
		
			Если СтрокаСтоимости.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				
				НоминалНаДату				= Справочники.Облигации.ПолучитьНоминал(СтрокаСтоимости.ЦеннаяБумага, ДатаПереоценки);
				Купон						= Справочники.Облигации.ПолучитьКупон(СтрокаСтоимости.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
				РейтинговаяГруппа			= Неопределено;
				КредитныйСпред				= Неопределено;
				БезрисковаяСтавкаДоходности	= Неопределено;
				
				ПараметрыДенежногоПотока = Новый Структура;
				ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",								Ложь);
				ПараметрыДенежногоПотока.Вставить("Дата",											ДатаПереоценки);
				ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",									ДатаПереоценки);
				ПараметрыДенежногоПотока.Вставить("УчитыватьИзмененениеКупонаСНаступленияПериода",	Истина);				
				
				ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(СтрокаСтоимости.ЦеннаяБумага, ПараметрыДенежногоПотока, ПараметрыОценки, Отказ, РасшифровкаРасчета);
				
			Иначе
				
				НоминалНаДату = 100;
				
			КонецЕсли;
			
			Если СтрокаСтоимости.СправедливаяЦена>0 Тогда
				Если СтрокаСтоимости.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.РыночнаяЦена2 Тогда
					СтрокаСтоимости.УровеньОценки = 1;//ок
					СтрокаСтоимости.Источник = СтрокаСтоимости.БиржаЮрФизЛицо;
					СтрокаСтоимости.Стоимость = СтрокаСтоимости.СправедливаяЦена * НоминалНаДату /100;
					Если СтрокаСтоимости.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
						СтрокаСтоимости.ВалютаКотировки = СтрокаСтоимости.ВалютаНоминала;
					КонецЕсли;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если СтрокаСтоимости.СправедливаяЦена > 0 Тогда
				ПроверкаНаАдекватность = ПроверитьЦенуНаАдекватность(СтрокаСтоимости.ЦеннаяБумага, СтрокаСтоимости.СправедливаяЦена * НоминалНаДату /100, ДатаПереоценки, ПараметрыОценки, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, , Купон, РейтинговаяГруппа, КредитныйСпред, ДенежныйПоток, БезрисковаяСтавкаДоходности, Отказ, РасшифровкаРасчета); 
				Если ПроверкаНаАдекватность Тогда
					СтрокаСтоимости.УровеньОценки = 1;//ок
					СтрокаСтоимости.Источник = СтрокаСтоимости.БиржаЮрФизЛицо;
					СтрокаСтоимости.Стоимость = СтрокаСтоимости.СправедливаяЦена * НоминалНаДату /100;
					Если СтрокаСтоимости.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
						СтрокаСтоимости.ВалютаКотировки = СтрокаСтоимости.ВалютаНоминала;
					КонецЕсли;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			//рынок признается неактивным
			
			//дефолт?
			Если ЗначениеЗаполнено(СтрокаСтоимости.ДатаПогашения) Тогда
				Если СтрокаСтоимости.ДатаПогашения < ДатаПереоценки 
					И НачалоДня(СтрокаСтоимости.ДатаПогашения) < НачалоДня(СтрокаСтоимости.ДатаПогашения) + 10 * 86400 // #Техдолг: абсурд
				Тогда
					СтрокаСтоимости.УровеньОценки = 3;
					СтрокаСтоимости.Источник = СтрокаСтоимости.ЦеннаяБумага.Эмитент.ЮрФизЛицо;
					СтрокаСтоимости.Стоимость = 0;
					СтрокаСтоимости.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.Дефолт;
					СтрокаСтоимости.ВалютаКотировки = СтрокаСтоимости.ВалютаНоминала;
					СтрокаСтоимости.ДатаЦены = НачалоДня(СтрокаСтоимости.ДатаПогашения) + 10 * 86400;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если СтрокаСтоимости.ЦБРФ Тогда
				
				//2.а - только для долговых
				Если СтрокаСтоимости.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И СтрокаСтоимости.СводныеКотировки_MARKETPRICE2 > 0 И СтрокаСтоимости.СводныеКотировки_MARKETPRICE2_DATE >= ТорговыхДнейНазад30 Тогда
					Если СтрокаСтоимости.MARKETPRICE2 > 0 Тогда
						ПроверкаНаАдекватность = ПроверитьЦенуНаАдекватность(СтрокаСтоимости.ЦеннаяБумага, СтрокаСтоимости.MARKETPRICE2 * НоминалНаДату /100, ДатаПереоценки, ПараметрыОценки, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, , Купон, РейтинговаяГруппа, КредитныйСпред, ДенежныйПоток, БезрисковаяСтавкаДоходности, Отказ, РасшифровкаРасчета); 
						Если ПроверкаНаАдекватность Тогда
							СтрокаСтоимости.УровеньОценки = 2;//ок
							СтрокаСтоимости.Источник = СтрокаСтоимости.БиржаЮрФизЛицо;
							СтрокаСтоимости.Стоимость = СтрокаСтоимости.MARKETPRICE2 * НоминалНаДату /100;
							СтрокаСтоимости.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.РыночнаяЦена2;
							Если СтрокаСтоимости.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
								СтрокаСтоимости.ВалютаКотировки = СтрокаСтоимости.ВалютаНоминала;
							Иначе
								СтрокаСтоимости.ВалютаКотировки = СтрокаСтоимости.ВалютаММВБ;
							КонецЕсли;
							СтрокаСтоимости.ДатаЦены = ДатаПереоценки;
							Продолжить;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				//2.в
				//по схеме цена НРД берется если есть цена Р2 за 30 дней
				Если СтрокаСтоимости.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И СтрокаСтоимости.СводныеКотировки_MARKETPRICE2 > 0 И СтрокаСтоимости.СводныеКотировки_MARKETPRICE2_DATE >= ТорговыхДнейНазад30 
					ИЛИ НЕ СтрокаСтоимости.Торгуется Тогда
					Если СтрокаСтоимости.ЦенаНРД > 0 И СтрокаСтоимости.СводныеКотировки_MARKETPRICE2 > 0 И СтрокаСтоимости.СводныеКотировки_MARKETPRICE2_DATE >= ТорговыхДнейНазад30 Тогда // было НачалоДня(ДатаПереоценки)-30*86400
						//проверка адекватности только для долговых
						Если СтрокаСтоимости.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
							ПроверкаНаАдекватность = ПроверитьЦенуНаАдекватность(СтрокаСтоимости.ЦеннаяБумага, СтрокаСтоимости.ЦенаНРД, ДатаПереоценки, ПараметрыОценки, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, , Купон, РейтинговаяГруппа, КредитныйСпред, ДенежныйПоток, БезрисковаяСтавкаДоходности, Отказ, РасшифровкаРасчета); 
						Иначе
							ПроверкаНаАдекватность = Истина;
						КонецЕсли;
						Если ПроверкаНаАдекватность Тогда
							СтрокаСтоимости.УровеньОценки = 2;//ок
							СтрокаСтоимости.Источник = ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");
							СтрокаСтоимости.Стоимость = СтрокаСтоимости.ЦенаНРД;
							СтрокаСтоимости.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД;
							СтрокаСтоимости.ДатаЦены = СтрокаСтоимости.ДатаЦеныНРД;
							СтрокаСтоимости.ВалютаКотировки = СтрокаСтоимости.ВалютаНоминала;
							Продолжить;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
			Иначе
				
				//по умолчанию проверка на адекватность котировок Блумберг не осуществляется, если это отдельно не заявлено Фондом. Пока не заявлено
				Если СтрокаСтоимости.BGN > 0 ИЛИ СтрокаСтоимости.BVAL > 0 Тогда
					СтрокаСтоимости.УровеньОценки = 2;
					СтрокаСтоимости.Источник = ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
					СтрокаСтоимости.Стоимость = ?(СтрокаСтоимости.BGN > 0, СтрокаСтоимости.BGN, СтрокаСтоимости.BVAL);
					СтрокаСтоимости.ВидЦены = ?(СтрокаСтоимости.BGN > 0, Перечисления.ИсточникиЦеныДляПереоценки.СредняяЦенаЗакрытия, Перечисления.ИсточникиЦеныДляПереоценки.СредневзвешеннаяЦена);
					СтрокаСтоимости.ДатаЦены = СтрокаСтоимости.ДатаЦеныБлумберга;
					Если СтрокаСтоимости.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
						СтрокаСтоимости.ВалютаКотировки = СтрокаСтоимости.ВалютаНоминала;
					Иначе
						СтрокаСтоимости.ВалютаКотировки = СтрокаСтоимости.ВалютаБлумберга;
					КонецЕсли;
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
		
		КонецЕсли;
		
		// Вынесено в процедуру ЗаполнитьПереоценкуАтомфонда, т.к. зависит от даты покупки 
		
		СтрокаСтоимости.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.ПустаяСсылка();
		СтрокаСтоимости.ДатаЦены = 0;
		
	КонецЦикла;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "Таблица стоимостей ЦБ", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныАтомфонда2020(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	                            
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ИсходнаяТаблицаЦБ");
	ПоместитьСведенияОТоргахЦеннымиБумагамиВМенеджерВременныхТаблиц(Запрос, "_ИсходнаяТаблицаЦБ", ДатаПереоценки, 10, "_СведенияОТоргахЦеннымиБумагами");	
	ПоместитьОценкиПоНоминалуДляПогашенныхЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления, ДатаПереоценки);
	
	#Область Основной_запрос	
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала = &ВалютаРубли КАК НоминированаВРублях,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ), ЛОЖЬ) КАК ОВОЗРФ,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, НЕОПРЕДЕЛЕНО) КАК ДатаПогашенияОблигации,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК ТоргуетсяНаММВБ,
		|	_ЦБПоНоминальнойСтоимостиПослеПогашения.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК ОценкаПоНоминалу,
		|	_СведенияОТоргахЦеннымиБумагами.Дата КАК ПоследняяДатаТоргов
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						_ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ИСТИНА
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|					ГДЕ
		|						_ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, Статус, Биржа, Рынок) В
		|					(ВЫБРАТЬ
		|						_ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже),
		|						&ММВБ,
		|						_ИсходнаяТаблицаЦБ.Рынок
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦБПоНоминальнойСтоимостиПослеПогашения КАК _ЦБПоНоминальнойСтоимостиПослеПогашения
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = _ЦБПоНоминальнойСтоимостиПослеПогашения.ЦеннаяБумага
		|			И _ИсходнаяТаблицаЦБ.Рынок = _ЦБПоНоминальнойСтоимостиПослеПогашения.Рынок
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СведенияОТоргахЦеннымиБумагами КАК _СведенияОТоргахЦеннымиБумагами
		|		ПО (_СведенияОТоргахЦеннымиБумагами.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|			И (_СведенияОТоргахЦеннымиБумагами.ТорговыхДнейНазад = 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.Период КАК Период,
		|	КотировкиТорговыхПлощадок.РежимТоргов КАК РежимТоргов,
		|	КотировкиТорговыхПлощадок.Валюта КАК Валюта,
		|	КурсыВалют.Курс / КурсыВалют.Кратность КАК КурсВалютыНаДатуПереоценки,
		|	КотировкиТорговыхПлощадок.NUMTRADES КАК КоличествоСделок,
		|	КотировкиТорговыхПлощадок.VALUE КАК ОбъемСделок,
		|	КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ _КотировкиММВБЗаПоследние10ТорговыхДней
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СведенияОТоргахЦеннымиБумагами КАК _СведенияОТоргахЦеннымиБумагами
		|		ПО (_СведенияОТоргахЦеннымиБумагами.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.Рынок = _ТаблицаЦБ.Рынок)
		|			И (КотировкиТорговыхПлощадок.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадок.Период = _СведенияОТоргахЦеннымиБумагами.Дата)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КурсыВалют.Валюта = КотировкиТорговыхПлощадок.Валюта)
		|			И (КурсыВалют.Период = &ДатаПереоценки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(_КотировкиММВБЗаПоследние10ТорговыхДней.КоличествоСделок) КАК КоличествоСделок,
		|	СУММА(_КотировкиММВБЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета) КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ _ИтогиММВБЗаПоследние10ТорговыхДней
		|ИЗ
		|	_КотировкиММВБЗаПоследние10ТорговыхДней КАК _КотировкиММВБЗаПоследние10ТорговыхДней
		|
		|СГРУППИРОВАТЬ ПО
		|	_КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_КотировкиММВБЗаПоследние10ТорговыхДней.Период КАК Период,
		|	_КотировкиММВБЗаПоследние10ТорговыхДней.РежимТоргов КАК РежимТоргов,
		|	_КотировкиММВБЗаПоследние10ТорговыхДней.Валюта КАК Валюта,
		|	_КотировкиММВБЗаПоследние10ТорговыхДней.КурсВалютыНаДатуПереоценки КАК КурсВалютыНаДатуПереоценки,
		|	_КотировкиММВБЗаПоследние10ТорговыхДней.КоличествоСделок КАК КоличествоСделок,
		|	_КотировкиММВБЗаПоследние10ТорговыхДней.ОбъемСделок КАК ОбъемСделок,
		|	_КотировкиММВБЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ _КотировкиММВБЗаПоследнийТорговыйДень
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КотировкиММВБЗаПоследние10ТорговыхДней КАК _КотировкиММВБЗаПоследние10ТорговыхДней
		|		ПО (_КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (_КотировкиММВБЗаПоследние10ТорговыхДней.Период = _ТаблицаЦБ.ПоследняяДатаТоргов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КотировкиММВБЗаПоследнийТорговыйДень.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(_КотировкиММВБЗаПоследнийТорговыйДень.КоличествоСделок) КАК КоличествоСделок,
		|	СУММА(_КотировкиММВБЗаПоследнийТорговыйДень.ОбъемСделокВВалютеУчета) КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ _ИтогиММВБЗаПоследнийТорговыйДень
		|ИЗ
		|	_КотировкиММВБЗаПоследнийТорговыйДень КАК _КотировкиММВБЗаПоследнийТорговыйДень
		|
		|СГРУППИРОВАТЬ ПО
		|	_КотировкиММВБЗаПоследнийТорговыйДень.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	&ММВБ КАК Биржа,
		|	_ИтогиММВБЗаПоследние10ТорговыхДней.КоличествоСделок КАК КоличествоСделокЗаПоследние10ТорговыхДней,
		|	_ИтогиММВБЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета КАК ОбъемСделокВВалютеУчетаЗаПоследние10ТорговыхДней,
		|	_ТаблицаЦБ.ПоследняяДатаТоргов КАК ПоследняяДатаТоргов,
		|	_ИтогиММВБЗаПоследнийТорговыйДень.ОбъемСделокВВалютеУчета КАК ОбъемСделокВВалютеУчетаЗаПоследнийТорговыйДень
		|ПОМЕСТИТЬ _АктивныйРынокММВБ
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ИтогиММВБЗаПоследние10ТорговыхДней КАК _ИтогиММВБЗаПоследние10ТорговыхДней
		|		ПО (_ИтогиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (_ИтогиММВБЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета >= 500000)
		|			И (_ИтогиММВБЗаПоследние10ТорговыхДней.КоличествоСделок >= 10)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ИтогиММВБЗаПоследнийТорговыйДень КАК _ИтогиММВБЗаПоследнийТорговыйДень
		|		ПО (_ИтогиММВБЗаПоследнийТорговыйДень.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (_ИтогиММВБЗаПоследнийТорговыйДень.ОбъемСделокВВалютеУчета > 0)
		|ГДЕ
		|	_ТаблицаЦБ.ТоргуетсяНаММВБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивныйРынокММВБ.Рынок КАК Рынок,
		|	_АктивныйРынокММВБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_АктивныйРынокММВБ.ВалютаНоминала КАК ВалютаНоминала,
