		ТаблицаСтоимостейЦБ = ПолучитьЦеныЮгорииЖизньСтрахование(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.СургутнефтегазСтрахование Тогда
		ТаблицаСтоимостейЦБ = ПолучитьЦеныСургутнефтегазСтрахование(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Федерация Тогда
		ТаблицаСтоимостейЦБ = ПолучитьЦеныФедерации(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Федерация2021 Тогда
		ТаблицаСтоимостейЦБ = ПолучитьЦеныФедерации2021(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Доверие Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныДоверия(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Гефест Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныГефеста(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Ростех Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныРостеха(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);	
	// Удалённые методики (снятые с поддержки)
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Нефтегарант
		Или ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Сургутнефтегаз2018
		Или ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть
		Или ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Перспектива
		Или ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Перспектива2018
		Или ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ЕвроинсСтрахование
		Или ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФондФилософии
		Или ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РПИ
		Или ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ЛонгТермИнвестментс
		Или ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.МегаруссСтрахование
		Или ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.СправедливаяПИФ
		Или ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2018
		Или ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2018
		Или ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2020
		Или ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ПФР2018
		Или ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ПФР2019_УКПИ
		Или ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_Нефтегарант2018ПР
		Или ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_Нефтегарант2019
		Или ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная3ЕПС
		Или (ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.СредневзвешеннаяЕПС И ДатаПереоценки < '20220101')
	Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("По счету д/у %1 расчет стоимости для варианта '%2' более не поддерживается. Если необходима поддержка методики, обратитесь к программистам.",
				СокрЛП(ПараметрыОценки.СчетДоверительногоУправления), ПараметрыОценки.ВариантРасчетаСправедливойСтоимости), , , , Отказ);
		Возврат Неопределено;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("По счету д/у %1 не реализован расчет стоимости для варианта '%2'",
				СокрЛП(ПараметрыОценки.СчетДоверительногоУправления), ПараметрыОценки.ВариантРасчетаСправедливойСтоимости), , , , Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЦенныеБумагиСПриоритетнымиЦенами <> Неопределено И ЦенныеБумагиСПриоритетнымиЦенами.Количество() > 0 Тогда
	
		#Область Возвращаем_бумаги_с_приоритетной_оценочной_ценой
		
		ЕстьПолеКупон			= (ТаблицаСтоимостейЦБ.Колонки.Найти("Купон") <> Неопределено);
		ЕстьПолеВалютаКупона	= (ТаблицаСтоимостейЦБ.Колонки.Найти("ВалютаКупона") <> Неопределено);
		
		Если ЕстьПолеКупон Тогда
			
			Запрос = Новый Запрос;
			
			ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ЦенныеБумагиСПриоритетнымиЦенами, "_ЦенныеБумаги"); 
			ПоместитьКотировкиКупоновВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, ПараметрыОценки.ВариантРасчетаСправедливойСтоимости, "_ЦенныеБумаги", "_Купоны");
			
			КупоныБумагСПриоритетнымиЦенами = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_Купоны", , "Облигация, Купон, ВалютаКупона").Выгрузить();
			
		КонецЕсли;
		
		Для Каждого СтрокаЦеннойБумагиСПриоритетнойЦеной Из ЦенныеБумагиСПриоритетнымиЦенами Цикл
			
			СтрокаСтоимостейЦБ = ТаблицаСтоимостейЦБ.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаСтоимостейЦБ, СтрокаЦеннойБумагиСПриоритетнойЦеной);
			
			// Если купон задается вместе с оценочной ценой, то его считать не требуется
			
			Если ЕстьПолеКупон И Не СтрокаЦеннойБумагиСПриоритетнойЦеной.СтрокиОценочнойСтоимости[0].ОценкаКупона И ТипЗнч(СтрокаСтоимостейЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
				
				КупонБумаги = КупоныБумагСПриоритетнымиЦенами.Найти(СтрокаСтоимостейЦБ.ЦеннаяБумага, "Облигация");
				
				Если КупонБумаги = Неопределено ИЛИ Не ЗначениеЗаполнено(КупонБумаги.Купон) Тогда
					СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(
						СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления, , ?(ЕстьПолеВалютаКупона, СтрокаСтоимостейЦБ.ВалютаКупона, Неопределено));
				Иначе
					ЗаполнитьЗначенияСвойств(СтрокаСтоимостейЦБ, КупонБумаги);
				КонецЕсли;
						
			КонецЕсли; 
			
		КонецЦикла;
			
		#КонецОбласти
	
	КонецЕсли;
	
	#Область Дополнение_выходной_таблицы_ЦБ_недостающими_колонками	
	
	// дополним выходную таблицу недостающими колонками, которые должны были бы прийти из методик,
	// но по какой-то причине не пришли
	
	// #Техдолг т.к. не понимаю, почему функция получения стоимости должна возвращать:
	// КурсВалютыНоминала, Сумма, да и, наверное, Количество тоже
	
	СтоимостьПереоценкиМД = Метаданные.РегистрыСведений.СтоимостьПереоценки;
	
	Если ТаблицаСтоимостейЦБ.Колонки.Найти("Партия") = Неопределено Тогда
		ТаблицаСтоимостейЦБ.Колонки.Добавить("Партия", СтоимостьПереоценкиМД.Измерения.Партия.Тип);
		ТаблицаСтоимостейЦБ.Колонки.Добавить("СтрокаПартии", СтоимостьПереоценкиМД.Измерения.СтрокаПартии.Тип);
	КонецЕсли;
	
	Если ТаблицаСтоимостейЦБ.Колонки.Найти("Количество") = Неопределено Тогда
		ТаблицаСтоимостейЦБ.Колонки.Добавить("Количество", СтоимостьПереоценкиМД.Ресурсы.Количество.Тип);
		ТаблицаСтоимостейЦБ.Колонки.Добавить("Сумма", СтоимостьПереоценкиМД.Ресурсы.Сумма.Тип);
	КонецЕсли;
	
	Если ТаблицаСтоимостейЦБ.Колонки.Найти("Купон") = Неопределено Тогда
		ТаблицаСтоимостейЦБ.Колонки.Добавить("Купон", СтоимостьПереоценкиМД.Ресурсы.СуммаКупона.Тип);
	КонецЕсли; 

	Если ТаблицаСтоимостейЦБ.Колонки.Найти("ЦенаКотировки") = Неопределено Тогда
		ТаблицаСтоимостейЦБ.Колонки.Добавить("ЦенаКотировки", СтоимостьПереоценкиМД.Реквизиты.ЦенаКотировки.Тип);
		ТаблицаСтоимостейЦБ.ЗагрузитьКолонку(ТаблицаСтоимостейЦБ.ВыгрузитьКолонку("Стоимость"), "ЦенаКотировки");
	КонецЕсли;

	Если ТаблицаСтоимостейЦБ.Колонки.Найти("ВалютаКотировки") = Неопределено Тогда
		ТаблицаСтоимостейЦБ.Колонки.Добавить("ВалютаКотировки", СтоимостьПереоценкиМД.Реквизиты.ВалютаКотировки.Тип);
		ТаблицаСтоимостейЦБ.ЗаполнитьЗначения(ПараметрыОценки.Организация.ВалютаУчета, "ВалютаКотировки"); // #Техдолг и от него нужно избавиться
	КонецЕсли;

	Если ТаблицаСтоимостейЦБ.Колонки.Найти("КурсВалютыНоминала") = Неопределено Тогда
		ТаблицаСтоимостейЦБ.Колонки.Добавить("КурсВалютыНоминала", СтоимостьПереоценкиМД.Реквизиты.КурсВалютыНоминала.Тип);
	КонецЕсли;
	
	#КонецОбласти

	// Общие уведомлялки	
		
	УведомитьОНеобходимостиПроверитьАктуальностьИспользованногоЗначенияКБДИностранныхОблигаций(ПараметрыОценки, ДатаПереоценки);
	
	УведомитьОНеобходимостиПроверитьОтсутствиеЦенБолееВысокогоПриоритета(ПараметрыОценки, ДатаПереоценки);
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Процедура ЗаполнитьЦенныеБумаги(Объект, МенеджерВременныхТаблиц, ИмяВремТаблицы, УчитыватьПартииПоРЕПО, УчитыватьПартииКПолучению, УчитыватьПартииВРЕПО, Отказ, РасшифровкаРасчета)

	ВклРежимДинамическогоРасчетаПартий = МенеджерВременныхТаблиц <> Неопределено
			И МенеджерВременныхТаблиц.Таблицы.Найти("_КонечныеОстаткиПартий") <> Неопределено;
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.ПереоценкаЦенныхБумаг") Тогда
		Запрос.УстановитьПараметр("Период",                   Новый Граница(Объект.МоментВремени(), ВидГраницы.Исключая));
	Иначе
		Запрос.УстановитьПараметр("Период",                   Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	КонецЕсли; 
	
	Запрос.УстановитьПараметр("Организация",                  Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета",                     Объект.ВидУчета);
	
	Если Не ВклРежимДинамическогоРасчетаПартий Тогда
	
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
			|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
			|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагОстатки
			|ГДЕ
			|	БухПартииЦенныхБумагОстатки.КоличествоОстаток = 0";
			
		Первый = Истина;
		МассивИсключений = Новый Массив;
		МассивИсключений.Добавить("СуммаРезервовПоСомнительнымДолгам");
		МассивИсключений.Добавить("Количество");
		
		Для каждого Ресурс Из Метаданные.РегистрыНакопления.БухПартииЦенныхБумаг.Ресурсы Цикл
			
			Если МассивИсключений.Найти(Ресурс.Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли; 
			
			Если Первый Тогда
				ТекстЗапроса = ТекстЗапроса + " 
				|	И НЕ(";
				Первый = Ложь;
			Иначе
				ТекстЗапроса = ТекстЗапроса + "
				|				И ";
			КонецЕсли; 
			ТекстЗапроса = ТекстЗапроса + "БухПартииЦенныхБумагОстатки." + Ресурс.Имя + "Остаток = 0";
		
		КонецЦикла; 
		
		ТекстЗапроса = ТекстЗапроса + ")";
		
		Запрос.Текст = ТекстЗапроса;
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если ТипЗнч(Объект) = Тип("Структура") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заполнение невозможно: по ценной бумаге " + Выборка.ЦеннаяБумага + " обнаружен нулевой остаток. Партия: " + Выборка.Партия + ", строка: " + Выборка.СтрокаПартии, , , , Отказ);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заполнение невозможно: по ценной бумаге " + Выборка.ЦеннаяБумага + " обнаружен нулевой остаток. Партия: " + Выборка.Партия + ", строка: " + Выборка.СтрокаПартии, Объект.Ссылка, , , Отказ);
			КонецЕсли;  
			
		КонецЦикла; 
		
		Если Отказ Тогда
		    Возврат;
		КонецЕсли; 
		
		Если МенеджерВременныхТаблиц = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
			|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	Неопределено КАК ТипЗадолженности,
