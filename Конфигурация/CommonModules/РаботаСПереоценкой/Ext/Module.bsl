			|				И НЕ _До_П_2_2_5.ВидЦены = ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.Дефолт)
			|			ТОГДА ЕСТЬNULL(СтоимостьПереоценкиСрезПоследних.Источник, 0)
			|		ИНАЧЕ _До_П_2_2_5.Источник
