		 |			ТОГДА РасчетССНРДОсновнойВыпуск.ВалютаКотировки
		 |		ИНАЧЕ 0
		 |	КОНЕЦ
		 |;
		 |
		 |////////////////////////////////////////////////////////////////////////////////
		 |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		 |	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		 |	ТаблицаЦБ.Рынок КАК Рынок,
		 |	КонвертацияЦенныхБумагЦенныеБумаги.Ссылка.ЦеннаяБумага КАК ЦеннаяБумагаДоКонвертации,
		 |	КонвертацияЦенныхБумагЦенныеБумаги.Количество / КонвертацияЦенныхБумагЦенныеБумаги.КоличествоНовое КАК КоэффициентКонвертации
		 |ПОМЕСТИТЬ ЦБПослеКонвертации
		 |ИЗ
		 |	ТаблицаЦБ КАК ТаблицаЦБ
		 |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КонвертацияЦенныхБумаг.ЦенныеБумаги КАК КонвертацияЦенныхБумагЦенныеБумаги
		 |		ПО ТаблицаЦБ.ЦеннаяБумага = КонвертацияЦенныхБумагЦенныеБумаги.Ссылка.ЦеннаяБумагаНовая
		 |;
		 |
		 |////////////////////////////////////////////////////////////////////////////////
		 |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		 |	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		 |	ТаблицаЦБ.Рынок КАК Рынок,
		 |	ВЫБОР
		 |		КОГДА ЕСТЬNULL(РасчетССАналогичные.СправедливаяЦена, 0) > 0
		 |			ТОГДА РасчетССАналогичные.СправедливаяЦена
		 |		КОГДА ЕСТЬNULL(РасчетССАналогичные1.СправедливаяЦена, 0) > 0
		 |			ТОГДА РасчетССАналогичные1.СправедливаяЦена / ЦБПослеКонвертации.КоэффициентКонвертации
		 |		ИНАЧЕ 0
		 |	КОНЕЦ КАК СправедливаяЦена,
		 |	ВЫБОР
		 |		КОГДА ЕСТЬNULL(РасчетССАналогичные.СправедливаяЦена, 0) > 0
		 |			ТОГДА РасчетССАналогичные.ДатаКотировки
		 |		КОГДА ЕСТЬNULL(РасчетССАналогичные1.СправедливаяЦена, 0) > 0
		 |			ТОГДА РасчетССАналогичные1.ДатаКотировки
		 |		ИНАЧЕ 0
		 |	КОНЕЦ КАК ДатаКотировки,
		 |	ВЫБОР
		 |		КОГДА ЕСТЬNULL(РасчетССАналогичные.СправедливаяЦена, 0) > 0
		 |			ТОГДА РасчетССАналогичные.Биржа
		 |		КОГДА ЕСТЬNULL(РасчетССАналогичные1.СправедливаяЦена, 0) > 0
		 |			ТОГДА РасчетССАналогичные1.Биржа
		 |		ИНАЧЕ 0
		 |	КОНЕЦ КАК Биржа,
		 |	ВЫБОР
		 |		КОГДА ЕСТЬNULL(РасчетССАналогичные.СправедливаяЦена, 0) > 0
		 |			ТОГДА РасчетССАналогичные.ПолеКотировки
		 |		КОГДА ЕСТЬNULL(РасчетССАналогичные1.СправедливаяЦена, 0) > 0
		 |			ТОГДА РасчетССАналогичные1.ПолеКотировки
		 |		ИНАЧЕ 0
		 |	КОНЕЦ КАК ПолеКотировки,
		 |	ВЫБОР
		 |		КОГДА ЕСТЬNULL(РасчетССАналогичные.СправедливаяЦена, 0) > 0
		 |			ТОГДА РасчетССАналогичные.УровеньОценки
		 |		КОГДА ЕСТЬNULL(РасчетССАналогичные1.СправедливаяЦена, 0) > 0
		 |			ТОГДА 2
		 |		ИНАЧЕ 0
		 |	КОНЕЦ КАК УровеньОценки,
		 |	ВЫБОР
		 |		КОГДА ЕСТЬNULL(РасчетССАналогичные.СправедливаяЦена, 0) > 0
		 |			ТОГДА РасчетССАналогичные.ВалютаКотировки
		 |		КОГДА ЕСТЬNULL(РасчетССАналогичные1.СправедливаяЦена, 0) > 0
		 |			ТОГДА РасчетССАналогичные1.ВалютаКотировки
		 |		ИНАЧЕ 0
		 |	КОНЕЦ КАК ВалютаКотировки
		 |ПОМЕСТИТЬ РасчетССПослеКонвертации
		 |ИЗ
		 |	ТаблицаЦБ КАК ТаблицаЦБ
		 |		ЛЕВОЕ СОЕДИНЕНИЕ РасчетССАналогичные КАК РасчетССАналогичные
		 |		ПО ТаблицаЦБ.Рынок = РасчетССАналогичные.Рынок
		 |			И ТаблицаЦБ.ЦеннаяБумага = РасчетССАналогичные.ЦеннаяБумага
		 |		ЛЕВОЕ СОЕДИНЕНИЕ ЦБПослеКонвертации КАК ЦБПослеКонвертации
		 |			ЛЕВОЕ СОЕДИНЕНИЕ РасчетССАналогичные КАК РасчетССАналогичные1
		 |			ПО ЦБПослеКонвертации.Рынок = РасчетССАналогичные1.Рынок
		 |				И ЦБПослеКонвертации.ЦеннаяБумагаДоКонвертации = РасчетССАналогичные1.ЦеннаяБумага
		 |		ПО ТаблицаЦБ.ЦеннаяБумага = ЦБПослеКонвертации.ЦеннаяБумага
		 |			И ТаблицаЦБ.Рынок = ЦБПослеКонвертации.Рынок
		 |;
		 |
		 |////////////////////////////////////////////////////////////////////////////////
		 |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		 |	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		 |	ТаблицаЦБ.Рынок КАК Рынок,
		 |	ТаблицаЦБ.Номинал КАК Номинал,
		 |	ВЫБОР
		 |		КОГДА ЕСТЬNULL(РасчетССПослеКонвертации.СправедливаяЦена, 0) > 0
		 |			ТОГДА РасчетССПослеКонвертации.СправедливаяЦена
		 |		КОГДА ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.Период, ДАТАВРЕМЯ(1890, 1, 1, 0, 0, 0)) > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -90)
		 |			ТОГДА РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена
		 |		ИНАЧЕ 0
		 |	КОНЕЦ КАК СправедливаяЦена,
		 |	ВЫБОР
		 |		КОГДА ЕСТЬNULL(РасчетССПослеКонвертации.СправедливаяЦена, 0) > 0
		 |			ТОГДА РасчетССПослеКонвертации.ДатаКотировки
		 |		КОГДА ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.Период, ДАТАВРЕМЯ(1890, 1, 1, 0, 0, 0)) > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -90)
		 |			ТОГДА РасчетныеЦеныПаевСрезПоследних.Период
		 |		ИНАЧЕ 0
		 |	КОНЕЦ КАК ДатаКотировки,
		 |	ВЫБОР
		 |		КОГДА ЕСТЬNULL(РасчетССПослеКонвертации.СправедливаяЦена, 0) > 0
		 |			ТОГДА РасчетССПослеКонвертации.Биржа
		 |		КОГДА ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.Период, ДАТАВРЕМЯ(1890, 1, 1, 0, 0, 0)) > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -90)
		 |			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
		 |		ИНАЧЕ 0
		 |	КОНЕЦ КАК Биржа,
		 |	ВЫБОР
		 |		КОГДА ЕСТЬNULL(РасчетССПослеКонвертации.СправедливаяЦена, 0) > 0
		 |			ТОГДА РасчетССПослеКонвертации.ПолеКотировки
		 |		КОГДА ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.Период, ДАТАВРЕМЯ(1890, 1, 1, 0, 0, 0)) > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -90)
		 |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СЧА)
		 |		ИНАЧЕ 0
		 |	КОНЕЦ КАК ПолеКотировки,
		 |	ВЫБОР
		 |		КОГДА ЕСТЬNULL(РасчетССПослеКонвертации.СправедливаяЦена, 0) > 0
		 |			ТОГДА РасчетССПослеКонвертации.УровеньОценки
		 |		КОГДА ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.Период, ДАТАВРЕМЯ(1890, 1, 1, 0, 0, 0)) > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -90)
		 |			ТОГДА 2
		 |		ИНАЧЕ 0
		 |	КОНЕЦ КАК УровеньОценки,
		 |	ВЫБОР
		 |		КОГДА ЕСТЬNULL(РасчетССПослеКонвертации.СправедливаяЦена, 0) > 0
		 |			ТОГДА РасчетССПослеКонвертации.ВалютаКотировки
		 |		КОГДА ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.Период, ДАТАВРЕМЯ(1890, 1, 1, 0, 0, 0)) > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -90)
		 |			ТОГДА ТаблицаЦБ.ВалютаНоминала
		 |		ИНАЧЕ 0
		 |	КОНЕЦ КАК ВалютаКотировки
		 |ПОМЕСТИТЬ РасчетСС
		 |ИЗ
		 |	ТаблицаЦБ КАК ТаблицаЦБ
		 |		ЛЕВОЕ СОЕДИНЕНИЕ РасчетССПослеКонвертации КАК РасчетССПослеКонвертации
		 |		ПО ТаблицаЦБ.Рынок = РасчетССПослеКонвертации.Рынок
		 |			И ТаблицаЦБ.ЦеннаяБумага = РасчетССПослеКонвертации.ЦеннаяБумага
		 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(&ДатаПереоценки, ) КАК РасчетныеЦеныПаевСрезПоследних
		 |		ПО ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага
		 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФСрезПоследних
		 |		ПО (ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		 |;
		 |
		 |////////////////////////////////////////////////////////////////////////////////
		 |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		 |	РасчетСС.ЦеннаяБумага КАК ЦеннаяБумага,
		 |	РасчетСС.Рынок КАК Рынок,
		 |	РасчетСС.Номинал КАК Номинал,
		 |	РасчетСС.СправедливаяЦена КАК Стоимость,
		 |	РасчетСС.ПолеКотировки КАК ВидЦены,
		 |	РасчетСС.ДатаКотировки КАК ДатаЦены,
		 |	РасчетСС.УровеньОценки КАК УровеньОценки,
		 |	РасчетСС.Биржа КАК Источник,
		 |	""цены облигаций приведены к деньгам при выборе цен НРД, умножать на номинал не надо"" КАК Поле1,
		 |	РасчетСС.ВалютаКотировки КАК ВалютаКотировки
		 |ИЗ
		 |	РасчетСС КАК РасчетСС
		 |ГДЕ
		 |	РасчетСС.СправедливаяЦена <> 0";
		
	РабочихДнейНазад10 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -10);
		
	ИностранныеУчетныеАктивы = Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();
	
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	Запрос.УстановитьПараметр("НРД", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("ММВБ", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	
	Запрос.УстановитьПараметр("Блумберг", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	
	Запрос.УстановитьПараметр("Режим_BGN", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL", ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	
	Запрос.УстановитьПараметр("Организация", ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("ВалютаУчета", ПараметрыОценки.Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыОценки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("РабочихДнейНазад10", РабочихДнейНазад10);
	Запрос.УстановитьПараметр("БумагиНерезидентов", ИностранныеУчетныеАктивы);
	Запрос.УстановитьПараметр("ОВОЗ", Перечисления.ВидыГосударственныхОблигаций.ОВОЗ);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);
	
	ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаСтоимостейЦБ;
КонецФункции

Функция ПолучитьЦеныЛиванова(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ1
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Акции.ОсновнойВыпуск,
		|	ИсходнаяТаблицаЦБ.Рынок,
		|	Акции.УчетныйАктивЦБРФ
		|ИЗ
		|	Справочник.Акции КАК Акции
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ПО (ИсходнаяТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка)
		|ГДЕ
		|	Акции.ОсновнойВыпуск <> ЗНАЧЕНИЕ(Справочник.Акции.пустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КонвертацияЦенныхБумаг.ЦеннаяБумага,
		|	КонвертацияЦенныхБумаг.Рынок,
		|	КонвертацияЦенныхБумаг.ЦеннаяБумага.УчетныйАктивЦБРФ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КонвертацияЦенныхБумаг КАК КонвертацияЦенныхБумаг
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = КонвертацияЦенныхБумаг.ЦеннаяБумагаНовая
		|;"
		+
		"
		|
		|////////////////////////////////////////////////////////////////////////////////
		|"
		+
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ1.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ1.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ВЫБОР
		|		КОГДА ИсходнаяТаблицаЦБ1.УчетныйАктивЦБРФ В (&БумагиНерезидентов)
		|			ТОГДА ЛОЖЬ
		|		КОГДА ИсходнаяТаблицаЦБ1.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА ИсходнаяТаблицаЦБ1.ЦеннаяБумага.Подкатегория = &ОВОЗ
		|						ТОГДА ЛОЖЬ
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЦБРФ
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ1 КАК ИсходнаяТаблицаЦБ1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ1.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ЕСТЬNULL(КотировкиТорговыхПлощадок.MARKETPRICE2, 0) КАК MARKETPRICE2,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.Период ЕСТЬ NULL
		|			ТОГДА 0
		|		КОГДА ТаблицаЦБ.ЦБРФ
		|			ТОГДА ВЫБОР
