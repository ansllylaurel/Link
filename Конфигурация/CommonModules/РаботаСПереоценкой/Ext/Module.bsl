		 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФСрезПоследних
		 |		ПО (ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		 |;
		 |
		 |////////////////////////////////////////////////////////////////////////////////
		 |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		 |	РасчетСС.ЦеннаяБумага КАК ЦеннаяБумага,
		 |	РасчетСС.Рынок КАК Рынок,
		 |	РасчетСС.Номинал КАК Номинал,
		 |	РасчетСС.СправедливаяЦена КАК Стоимость,
		 |	РасчетСС.ПолеКотировки КАК ВидЦены,
		 |	РасчетСС.ДатаКотировки КАК ДатаЦены,
		 |	РасчетСС.УровеньОценки КАК УровеньОценки,
		 |	РасчетСС.Биржа КАК Источник,
		 |	РасчетСС.ВалютаКотировки КАК ВалютаКотировки,
		 |	""цены облигаций приведены к деньгам при выборе цен НРД, умножать на номинал не надо"" КАК Примечание
		 |ИЗ
		 |	РасчетСС КАК РасчетСС
		 |ГДЕ
		 |	РасчетСС.СправедливаяЦена <> 0";
		
	РабочихДнейНазад10 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -10);
		
	ИностранныеУчетныеАктивы = Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();
	
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	Запрос.УстановитьПараметр("НРД", ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("ММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	
	Запрос.УстановитьПараметр("Блумберг", ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	
	Запрос.УстановитьПараметр("Режим_BGN"	, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL"	, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	
	Запрос.УстановитьПараметр("Организация", ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("ВалютаУчета", ПараметрыОценки.Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыОценки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("РабочихДнейНазад10", РабочихДнейНазад10);
	Запрос.УстановитьПараметр("БумагиНерезидентов", ИностранныеУчетныеАктивы);
	Запрос.УстановитьПараметр("ОВОЗ", Перечисления.ВидыГосударственныхОблигаций.ОВОЗ);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Согласие (ЕПС)", "Таблица стоимостей ЦБ");		
	Иначе
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;
КонецФункции

Функция ПолучитьЦеныСогласия2019(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	#Область Текст_запроса	
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, НЕОПРЕДЕЛЕНО) КАК ДатаПогашения,
		|	ЕСТЬNULL(Облигации.Эмитент, НЕОПРЕДЕЛЕНО) КАК ЭмитентОблигации,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК ТоргуетсяНаММВБ
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ИСТИНА
		|					ИЗ
		|						ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|					ГДЕ
		|						ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, Статус, Биржа, Рынок) В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже),
		|						&ММВБ,
		|						ИсходнаяТаблицаЦБ.Рынок
		|					ИЗ
		|						ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДефолтыПоОблигациям.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ДефолтыПоОблигациям.ТипДефолта КАК ТипДефолта,
		|	МИНИМУМ(ДефолтыПоОблигациям.Период) КАК ДатаДефолта
		|ПОМЕСТИТЬ _Дефолты
		|ИЗ
		|	(ВЫБРАТЬ
		|		ДефолтыПоОблигациям.Облигация КАК ЦеннаяБумага,
		|		ДефолтыПоОблигациям.ТипДефолта КАК ТипДефолта,
		|		ДефолтыПоОблигациям.Период КАК Период
		|	ИЗ
		|		РегистрСведений.ДефолтыПоОблигациям КАК ДефолтыПоОблигациям
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаЦБ КАК ТаблицаЦБ
		|			ПО (ТаблицаЦБ.ЦеннаяБумага = ДефолтыПоОблигациям.Облигация)
		|	ГДЕ
		|		ДефолтыПоОблигациям.Период <= &РабочихДнейНазад10
		|		И (ДефолтыПоОблигациям.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.Банкротство)
		|				ИЛИ ДефолтыПоОблигациям.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ИсполнениеОферты)
		|					И ДефолтыПоОблигациям.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.НеисполнениеОферты)
		|				ИЛИ ДефолтыПоОблигациям.ТипДефолта В (ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.КупонныеВыплаты), ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации))
		|					И ДефолтыПоОблигациям.СтатусДефолта В (ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт), ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.ТехническийДефолт)))
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ТаблицаЦБ.ЦеннаяБумага,
		|		ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации),
		|		ТаблицаЦБ.ДатаПогашения
		|	ИЗ
		|		ТаблицаЦБ КАК ТаблицаЦБ
		|	ГДЕ
		|		ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|		И ТаблицаЦБ.ДатаПогашения <> ДАТАВРЕМЯ(1, 1, 1)
		|		И ТаблицаЦБ.ДатаПогашения <= &РабочихДнейНазад10) КАК ДефолтыПоОблигациям
		|
		|СГРУППИРОВАТЬ ПО
		|	ДефолтыПоОблигациям.ЦеннаяБумага,
		|	ДефолтыПоОблигациям.ТипДефолта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.Период КАК Период,
		|	КотировкиТорговыхПлощадок.Валюта КАК Валюта,
		|	КотировкиТорговыхПлощадок.РежимТоргов КАК РежимТоргов,
		|	СУММА(КотировкиТорговыхПлощадок.NUMTRADES) КАК КоличествоСделок,
		|	СУММА(КотировкиТорговыхПлощадок.VALUE) КАК ОбъемСделок,
		|	СУММА(КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность) КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ КотировкиММВБЗаПоследние10ТорговыхДней
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Рынок = ТаблицаЦБ.Рынок)
		|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадок.Период МЕЖДУ &ТорговыхДнейНазад10 И &ДатаПереоценки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта)
		|			И (КотировкиТорговыхПлощадок.Период = КурсыВалют.Период)
		|ГДЕ
		|	ТаблицаЦБ.ТоргуетсяНаММВБ
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.Период,
		|	КотировкиТорговыхПлощадок.Валюта,
		|	КотировкиТорговыхПлощадок.РежимТоргов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиММВБЗаПоследние10ТорговыхДней.Период КАК Период,
		|	СУММА(КотировкиММВБЗаПоследние10ТорговыхДней.КоличествоСделок) КАК КоличествоСделок,
		|	СУММА(КотировкиММВБЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета) КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ ИтогиММВБЗаПоследние10ТорговыхДней
		|ИЗ
		|	КотировкиММВБЗаПоследние10ТорговыхДней КАК КотировкиММВБЗаПоследние10ТорговыхДней
		|
		|СГРУППИРОВАТЬ ПО
		|	КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага,
		|	КотировкиММВБЗаПоследние10ТорговыхДней.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	СделкиЗаПоследние10ТорговыхДней.КоличествоСделок КАК КоличествоСделок,
		|	СделкиЗаПоследние10ТорговыхДней.СуммарныйОбъемСделокВВалютеУчета КАК СуммарныйОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ АктивныйРынокММВБ
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ИтогиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага КАК ЦеннаяБумага,
		|			СУММА(ИтогиММВБЗаПоследние10ТорговыхДней.КоличествоСделок) КАК КоличествоСделок,
		|			СУММА(ИтогиММВБЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета) КАК СуммарныйОбъемСделокВВалютеУчета
		|		ИЗ
		|			ИтогиММВБЗаПоследние10ТорговыхДней КАК ИтогиММВБЗаПоследние10ТорговыхДней
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ИтогиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага) КАК СделкиЗаПоследние10ТорговыхДней
		|		ПО (СделкиЗаПоследние10ТорговыхДней.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (СделкиЗаПоследние10ТорговыхДней.СуммарныйОбъемСделокВВалютеУчета >= 500000)
		|			И (СделкиЗаПоследние10ТорговыхДней.КоличествоСделок >= 10)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АктивныйРынокММВБ.Рынок КАК Рынок,
		|	АктивныйРынокММВБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	АктивныйРынокММВБ.ВалютаНоминала = КотировкиТорговыхПлощадок.Валюта КАК ТоргиВВалютеНоминала,
		|	КотировкиТорговыхПлощадок.Биржа КАК Биржа,
		|	КотировкиТорговыхПлощадок.РежимТоргов КАК РежимТоргов,
		|	КотировкиТорговыхПлощадок.Период КАК Период,
		|	КотировкиТорговыхПлощадок.Валюта КАК Валюта,
		|	КотировкиТорговыхПлощадок.BID КАК BID,
		|	КотировкиТорговыхПлощадок.OFFER КАК OFFER,
		|	КотировкиТорговыхПлощадок.WAPRICE КАК WAPRICE,
		|	КотировкиТорговыхПлощадок.VOLUME КАК VOLUME,
		|	КотировкиТорговыхПлощадок.VALUE КАК VALUE,
		|	КотировкиТорговыхПлощадок.LEGALCLOSEPRICE КАК LEGALCLOSEPRICE,
		|	КотировкиТорговыхПлощадок.CLOSE КАК CLOSE,
		|	КотировкиТорговыхПлощадок.VOLUME КАК ОбъемСделокШтукБумаг,
		|	КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ КотировкиАктивногоРынкаММВБ
		|ИЗ
		|	АктивныйРынокММВБ КАК АктивныйРынокММВБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.ЦеннаяБумага = АктивныйРынокММВБ.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Рынок = АктивныйРынокММВБ.Рынок)
		|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадок.Период = &ПоследняяДатаТоргов)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КурсыВалют.Валюта = КотировкиТорговыхПлощадок.Валюта)
		|			И (КурсыВалют.Период = КотировкиТорговыхПлощадок.Период)
