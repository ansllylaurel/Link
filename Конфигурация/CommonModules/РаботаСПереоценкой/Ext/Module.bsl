	Если ДатаПереоценки >= '20200622' Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КотировкиТорговыхПлощадок.BID", 		"КотировкиТорговыхПлощадок.BID_MAIN");
