	КалендарьКотировок			= Константы.ОсновнойКалендарьКотировок.Получить();	
	ПоследняяДатаТорговБлумберг	= РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки, Блумберг);	
	
	БратьЦеныНРДНаДатуТоргов									= (ДатаПереоценки >= '20210101');
	ТестироватьЦеныНРД											= (ДатаПереоценки >= '20210101');
	ТестироватьЦеныБлумберг										= (ДатаПереоценки >= '20210101');	
	ДоступныДанныеБлумберг										= ПроверитьДоступностьДанныхBloomberg(ДатаПереоценки);
	ОцениватьБумагиМеждународногоВнебиржевогоРынкаПоБлумбергу	= (ДоступныДанныеБлумберг И ДатаПереоценки < '20230401');
	ОцениватьАкцииРоссийскогоВнебиржевогоРынкаПоНРД				= (ДатаПереоценки < '20230401');
	ОцениватьПоЦенеР2На1Уровне									= (ДатаПереоценки >= '20240419');
	ТестироватьWapriceИНРДНаBidИOffer							= (ДатаПереоценки >= '20260101');
	ИспользоватьЦеныНРДНаУровне3								= (ДатаПереоценки >= '20260101');
	
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберг",	ПоследняяДатаТорговБлумберг);
	Запрос.УстановитьПараметр("КалендарныхДнейНазад35",			НачалоДня(ДатаПереоценки) - 35 * 86400);
	
	Запрос.УстановитьПараметр("ММВБ",					ММВБ);
	Запрос.УстановитьПараметр("НРД",					НРД);
	Запрос.УстановитьПараметр("Блумберг",				Блумберг);
	Запрос.УстановитьПараметр("ДоступныеБиржи",			ДоступныеБиржи);
	Запрос.УстановитьПараметр("ДоступныДанныеБлумберг",	ДоступныДанныеБлумберг);
	
	Запрос.УстановитьПараметр("Режим_BGN",		ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL",		ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	Запрос.УстановитьПараметр("ВалютаРубли",	ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	Запрос.УстановитьПараметр("БратьЦеныНРДНаДатуТоргов",									БратьЦеныНРДНаДатуТоргов);
	Запрос.УстановитьПараметр("ТестироватьЦеныНРД",											ТестироватьЦеныНРД);
	Запрос.УстановитьПараметр("ТестироватьЦеныБлумберг",									ТестироватьЦеныБлумберг);
	Запрос.УстановитьПараметр("ОцениватьБумагиМеждународногоВнебиржевогоРынкаПоБлумбергу",	ОцениватьБумагиМеждународногоВнебиржевогоРынкаПоБлумбергу);
	Запрос.УстановитьПараметр("ОцениватьАкцииРоссийскогоВнебиржевогоРынкаПоНРД",			ОцениватьАкцииРоссийскогоВнебиржевогоРынкаПоНРД);
	Запрос.УстановитьПараметр("ОцениватьПоЦенеР2На1Уровне",									ОцениватьПоЦенеР2На1Уровне);
	Запрос.УстановитьПараметр("ТестироватьWapriceИНРДНаBidИOffer",							ТестироватьWapriceИНРДНаBidИOffer);
	Запрос.УстановитьПараметр("ИспользоватьЦеныНРДНаУровне3",								ИспользоватьЦеныНРДНаУровне3);	
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены", ТолькоНаблюдаемыеЦены);
	
	ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Транснефти 2020 (ЕПС)", "Таблица стоимостей ЦБ");		
	
	// Расчетные цены 	
	
	ВыполненРасчетЦены = Ложь;	
	
	ПараметрыОценки.Вставить("ТочностьДисконтированногоПотока", 6);

	Если ДатаПереоценки >= '20230130' Тогда
		ПараметрыОценки.Вставить("ТочностьСрокаДоПогашения",		4);
		ПараметрыОценки.Вставить("ТочностьСтавкиДисконтирования",	4);
	КонецЕсли;
	
	ПараметрыПроверкиАналогов = Новый Структура;
	ПараметрыПроверкиАналогов.Вставить("ГлубинаСделокРоссийскойПлощадки",			1);
	ПараметрыПроверкиАналогов.Вставить("ОбъемСделокВВалютеУчетаРоссийскойПлощадки",	?(ДатаПереоценки >= '20230130', "500000", "1000000"));
	ПараметрыПроверкиАналогов.Вставить("ОбъемСделокВШтукахРоссийскойПлощадки",		?(ДатаПереоценки >= '20230130', "500", "1000"));
	
	ПараметрыРасчетаСтоимостиПоАналогам = Новый Структура;
	ПараметрыРасчетаСтоимостиПоАналогам.Вставить("ВариантРасчета",				Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2020);
	ПараметрыРасчетаСтоимостиПоАналогам.Вставить("ПараметрыЗапроса",			Запрос.Параметры);
	ПараметрыРасчетаСтоимостиПоАналогам.Вставить("ПараметрыПроверкиАналогов",	ПараметрыПроверкиАналогов);
	ПараметрыРасчетаСтоимостиПоАналогам.Вставить("ИсточникЦены",				ПараметрыОценки.Клиент);
	
	ПараметрыОценки.Вставить("ПараметрыРасчетаСтоимостиПоАналогам", ПараметрыРасчетаСтоимостиПоАналогам);
	
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);	
	ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	
	КотировкиАналогов			= Неопределено;
	КотировкиАналоговНРД		= Неопределено;
	КотировкиАналоговБлумберг	= Неопределено;
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		Если СтрокаСтоимостейЦБ.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.Номинал Тогда
			Продолжить; // Для погашенных ЦБ дополнительные действия не требуются
		КонецЕсли;
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления, , СтрокаСтоимостейЦБ.ВалютаКупона);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0
			ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены)
			ИЛИ ТолькоНаблюдаемыеЦены
		Тогда
			Продолжить;
		КонецЕсли;
		
		// Требуется расчет цены
		
		ОшибкаРасчета = Ложь;
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			Если СтрокаСтоимостейЦБ.СчитаемЧтоДефолт Тогда
				Если РасшифровкаРасчета <> Неопределено Тогда	
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Оценка дефолтных долговых ценных бумаг", Новый Структура("Описание", "Оценка дефолтных долговых ценных бумаг не реализована"));
				КонецЕсли;		
				Продолжить;	
			КонецЕсли;
			
			Если СтрокаСтоимостейЦБ.ОсновнойРынок = "Российская торговая площадка"
				ИЛИ СтрокаСтоимостейЦБ.ОсновнойРынок = "Российский внебиржевой рынок"
				ИЛИ СтрокаСтоимостейЦБ.ОсновнойРынок = "Международный внебиржевой рынок" И ОцениватьБумагиМеждународногоВнебиржевогоРынкаПоБлумбергу
			Тогда

			    #Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков_по_ставке_рассчитанной_по_аналогам
				
				ЦенаЗаполнена = ЗаполнитьДисконтированнойПоСтавкеРассчитаннойПоАналогамСтоимостью(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 3, ПараметрыДенежногоПотока, , ОшибкаРасчета, РасшифровкаРасчета);
				
				Если Не ЦенаЗаполнена Тогда
					
					Если СтрокаСтоимостейЦБ.ОсновнойРынок = "Российская торговая площадка" И ДатаПереоценки >= '20230130' Тогда
					
						#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков_по_безрисковой_ставке_доходности
						
						ОшибкаРасчета = Ложь;
						ЦенаЗаполнена = ЗаполнитьДисконтированнойПоБезрисковойСтавкеДоходностиСтоимостью(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, ПараметрыДенежногоПотока, Истина, 3, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, , ОшибкаРасчета, РасшифровкаРасчета);
						
						Если ОшибкаРасчета Тогда
							ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
							Продолжить;
						ИначеЕсли ЦенаЗаполнена Тогда
							ВыполненРасчетЦены = Истина;
							Продолжить;
						КонецЕсли;
						
						#КонецОбласти
					
					КонецЕсли;
					
				КонецЕсли; 	
				
				Если ОшибкаРасчета Тогда
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
					Продолжить;
				ИначеЕсли ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
					Продолжить;
				КонецЕсли;
				
				#КонецОбласти
				
			КонецЕсли;

		ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда	
			
			Если СтрокаСтоимостейЦБ.ОсновнойРынок = "Российская торговая площадка"
				ИЛИ СтрокаСтоимостейЦБ.ОсновнойРынок = "Иностранная торговая площадка"
			Тогда
			
				#Область Расчет_на_основе_корректировки_исторической_цены
				
				// Справедливая стоимость акций, обращающихся на российских и иностранных фондовых биржах,
				// определяется в соответствии с моделью оценки, основанной на корректировке исторической цены (CAPM).
				// Применяем при отсутствии цены не более 10 рабочих дней
				
				ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, Справочники.Календари.Общероссийский, 3, 6, ОшибкаРасчета, РасшифровкаРасчета);  
				
				Если ОшибкаРасчета Тогда
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
					Продолжить;
				ИначеЕсли ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
				КонецЕсли;
				
				#КонецОбласти
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "После расчета цен", ТаблицаСтоимостейЦБ.Скопировать());	
	КонецЕсли;
		
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныУГМКПерспективы2020(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	
	ПоместитьОценкиПоНоминалуДляПогашенныхЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления, ДатаПереоценки);
	
	#Область Основной_запрос	
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	Эмитенты.Ссылка КАК Эмитент,
		|	Эмитенты.ЮрФизЛицо КАК ЮрЛицоЭмитента,
		|	Эмитенты.ДатаБанкротства КАК ДатаБанкротства,
		|	Эмитенты.ДатаБанкротства <> ДАТАВРЕМЯ(1, 1, 1)
		|		И Эмитенты.ДатаБанкротства <= &ДатаПереоценки КАК Банкрот
		|ПОМЕСТИТЬ ЭмитентыЦенныхБумаг
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Векселя КАК Векселя
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Векселя.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеРасписки КАК ДепозитарныеРасписки
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = ДепозитарныеРасписки.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = ИпотечныеСертификатыУчастия.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|		ПО (Эмитенты.Ссылка = ВЫБОР
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|					ТОГДА Акции.Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|					ТОГДА Облигации.Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|					ТОГДА Векселя.Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|					ТОГДА ДепозитарныеРасписки.Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|					ТОГДА ИпотечныеСертификатыУчастия.Эмитент
		|			КОНЕЦ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала = &ВалютаРубли КАК НоминированаВРублях,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК ТоргуетсяНаММВБ,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, НЕОПРЕДЕЛЕНО) КАК ДатаПогашения,
		|	ЕСТЬNULL(Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ), ЛОЖЬ) КАК ОблигацияОВОЗРФ,
		|	ЕСТЬNULL(Облигации.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств), ЛОЖЬ) КАК ОблигацияИнострГосударства,
		|	ЕСТЬNULL(Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|			И НЕ РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЕврооблигацияИнострЭмитента,
		|	ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента КАК Эмитент,
		|	ЕСТЬNULL(ЭмитентыЦенныхБумаг.Банкрот
		|			ИЛИ Облигации.ДатаПогашения <> ДАТАВРЕМЯ(1, 1, 1)
		|				И Облигации.ДатаПогашения <= &РабочихДнейНазад10, ЛОЖЬ) КАК СчитаемЧтоДефолт,
		|	ЕСТЬNULL(ЭмитентыЦенныхБумаг.Банкрот, ЛОЖЬ) КАК ЭмитентБанкрот,
		|	ЭмитентыЦенныхБумаг.ДатаБанкротства КАК ЭмитентДатаБанкротства,
