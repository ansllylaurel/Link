	Запрос.УстановитьПараметр("Блумберг",				Блумберг);
	
	Запрос.УстановитьПараметр("Режим_BGN",				ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL",				ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	Запрос.УстановитьПараметр("ВалютаРубли",			ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ",		ТаблицаЦБ);
	
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены",	ТолькоНаблюдаемыеЦены);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены УГМК-Перспектива 2020 (ЕПС)", "Таблица стоимостей ЦБ", , , "ИсходнаяТаблицаЦБ, ЭмитентыЦенныхБумаг");
	КонецЕсли;
	
	Если ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;
	
	// Расчетные цены 	
	
	ВыполненРасчетЦены = Ложь;	
	
	ПараметрыОценки.Вставить("ТочностьСтавкиДисконтирования", 2);
	ПараметрыОценки.Вставить("ТочностьDCF",					  4);
	
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		Если СтрокаСтоимостейЦБ.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.Номинал Тогда
			// Для погашенных ЦБ дополнительные действия не требуются
			Продолжить;
		КонецЕсли;	
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены) Тогда
			Продолжить;
		КонецЕсли;
		
		// Расчетные цены
		
		ОшибкаРасчета = Ложь;
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			Если СтрокаСтоимостейЦБ.ЭмитентРоссийский И Не СтрокаСтоимостейЦБ.ОблигацияОВОЗРФ Тогда
			
				#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков
				
				ЦенаЗаполнена = ЗаполнитьДисконтированнойПоБезрисковойСтавкеДоходностиСтоимостью(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, ПараметрыДенежногоПотока, , 2, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, , Отказ, РасшифровкаРасчета);
		
				Если ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
				КонецЕсли;
				
				#КонецОбласти
			
			КонецЕсли;
			
		ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
			
			Если СтрокаСтоимостейЦБ.ЭмитентРоссийский И СтрокаСтоимостейЦБ.ТоргуетсяНаММВБ Тогда
			
				#Область Расчет_на_основе_корректировки_исторической_цены					
				
				// Справедливая стоимость акций российских эмитентов, допущенных к торгам на ММВБ,
				// определяется в соответствии с моделью оценки, основанной на корректировке исторической цены (CAPM).
				// Применяем при отсутствии наблюдаемой цены не более 10 торговых дней
				
				ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, ОсновнойКалендарьКотировок, , 5, Отказ, РасшифровкаРасчета);  
				
				Если ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
				КонецЕсли;
				
				#КонецОбласти					
			
			КонецЕсли;
			
		КонецЕсли;

	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "После расчета цен", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;	

КонецФункции

Функция ПолучитьЦеныУГМКПерспективы2021(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "ИсходнаяТаблицаЦБ");
	ПоместитьБумагиОцениваемыеПоАмортизированнойСтоимостиВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки, ДатаПереоценки, "ИсходнаяТаблицаЦБ");
	ПоместитьОценкиПоНоминалуДляПогашенныхЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления, ДатаПереоценки);
	ПоместитьЭмитентовЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "ИсходнаяТаблицаЦБ");
	ПоместитьСведенияОТоргахЦеннымиБумагамиВМенеджерВременныхТаблиц(Запрос, "ИсходнаяТаблицаЦБ", ДатаПереоценки, 10, "_СведенияОТоргахЦеннымиБумагами");
	
	#Область Основной_запрос	
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала = &ВалютаРубли КАК НоминированаВРублях,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК ТоргуетсяНаММВБ,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, НЕОПРЕДЕЛЕНО) КАК ДатаПогашения,
		|	ЕСТЬNULL(Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ), ЛОЖЬ) КАК ОблигацияОВОЗРФ,
		|	ЕСТЬNULL(Облигации.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств), ЛОЖЬ) КАК ОблигацияИнострГосударства,
		|	ЕСТЬNULL(Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|			И НЕ РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЕврооблигацияИнострЭмитента,
		|	_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента КАК Эмитент,
		|	ЕСТЬNULL(_ЭмитентыЦенныхБумаг.Банкрот
		|			ИЛИ Облигации.ДатаПогашения <> ДАТАВРЕМЯ(1, 1, 1)
		|				И Облигации.ДатаПогашения <= &РабочихДнейНазад10, ЛОЖЬ) КАК СчитаемЧтоДефолт,
		|	ЕСТЬNULL(_ЭмитентыЦенныхБумаг.Банкрот, ЛОЖЬ) КАК ЭмитентБанкрот,
		|	_ЭмитентыЦенныхБумаг.ДатаБанкротства КАК ЭмитентДатаБанкротства,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЭмитентРоссийский,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация), ЛОЖЬ) КАК ЭмитентМеждународнаяФинОрганизация,
		|	_ЦБПоНоминальнойСтоимостиПослеПогашения.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК ОценкаПоНоминалу,
		|	_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК ОценкаПоАмортизированнойСтоимости,
		|	_СведенияОТоргахЦеннымиБумагами.Дата КАК ПоследняяДатаТоргов
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЭмитентыЦенныхБумаг КАК _ЭмитентыЦенныхБумаг
		|		ПО (_ЭмитентыЦенныхБумаг.ЦеннаяБумага = ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента
		|					ИЗ
		|						_ЭмитентыЦенныхБумаг)) КАК РеквизитыЮрЛицаЭмитента
		|		ПО (РеквизитыЮрЛицаЭмитента.ЮрФизЛицо = _ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ИСТИНА
		|					ИЗ
		|						ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|					ГДЕ
		|						ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, Статус, Биржа, Рынок) В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже),
		|						&ММВБ,
		|						ИсходнаяТаблицаЦБ.Рынок
		|					ИЗ
		|						ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦБПоНоминальнойСтоимостиПослеПогашения КАК _ЦБПоНоминальнойСтоимостиПослеПогашения
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = _ЦБПоНоминальнойСтоимостиПослеПогашения.ЦеннаяБумага
		|			И ИсходнаяТаблицаЦБ.Рынок = _ЦБПоНоминальнойСтоимостиПослеПогашения.Рынок
		|		ЛЕВОЕ СОЕДИНЕНИЕ _БумагиОцениваемыеПоАмортизированнойСтоимости КАК _БумагиОцениваемыеПоАмортизированнойСтоимости
		|		ПО (_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага = ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СведенияОТоргахЦеннымиБумагами КАК _СведенияОТоргахЦеннымиБумагами
		|		ПО (_СведенияОТоргахЦеннымиБумагами.ЦеннаяБумага = ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|			И (_СведенияОТоргахЦеннымиБумагами.ТорговыхДнейНазад = 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.Период КАК Период,
		|	КотировкиТорговыхПлощадок.Период = ТаблицаЦБ.ПоследняяДатаТоргов КАК ПоследнийТорговыйДень,
		|	КотировкиТорговыхПлощадок.Валюта КАК Валюта,
		|	КотировкиТорговыхПлощадок.РежимТоргов КАК РежимТоргов,
		|	СУММА(КотировкиТорговыхПлощадок.NUMTRADES) КАК КоличествоСделок,
		|	СУММА(КотировкиТорговыхПлощадок.VALUE) КАК ОбъемСделок,
		|	СУММА(КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность) КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ КотировкиММВБЗаПоследние10ТорговыхДней
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СведенияОТоргахЦеннымиБумагами КАК _СведенияОТоргахЦеннымиБумагами
		|		ПО (_СведенияОТоргахЦеннымиБумагами.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.Рынок = ТаблицаЦБ.Рынок)
		|			И (КотировкиТорговыхПлощадок.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадок.Период = _СведенияОТоргахЦеннымиБумагами.Дата)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта)
		|			И (КотировкиТорговыхПлощадок.Период = КурсыВалют.Период)
		|ГДЕ
		|	НЕ ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.Период,
		|	КотировкиТорговыхПлощадок.Период = ТаблицаЦБ.ПоследняяДатаТоргов,
		|	КотировкиТорговыхПлощадок.Валюта,
		|	КотировкиТорговыхПлощадок.РежимТоргов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиММВБЗаПоследние10ТорговыхДней.Период КАК Период,
		|	КотировкиММВБЗаПоследние10ТорговыхДней.ПоследнийТорговыйДень КАК ПоследнийТорговыйДень,
		|	СУММА(КотировкиММВБЗаПоследние10ТорговыхДней.КоличествоСделок) КАК КоличествоСделок,
		|	СУММА(КотировкиММВБЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета) КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ ИтогиММВБЗаПоследние10ТорговыхДней
		|ИЗ
		|	КотировкиММВБЗаПоследние10ТорговыхДней КАК КотировкиММВБЗаПоследние10ТорговыхДней
		|
		|СГРУППИРОВАТЬ ПО
		|	КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага,
		|	КотировкиММВБЗаПоследние10ТорговыхДней.Период,
		|	КотировкиММВБЗаПоследние10ТорговыхДней.ПоследнийТорговыйДень
		|;
