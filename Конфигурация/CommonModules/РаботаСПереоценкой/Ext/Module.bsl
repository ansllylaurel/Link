		|	_Данные.Источник КАК Источник
		|ИЗ
		|	_Данные КАК _Данные";
	
	ПоследняяДатаТорговБлумберга	= РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки);	
	ПоследняяДатаТоргов				= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки));
	ПоследнийРабочийДень			= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский,НачалоДня(ДатаПереоценки));
	ТорговыхДнейНазад90				= Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -90);
	ТорговыхДнейНазад10				= Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -10);
	
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	Запрос.УстановитьПараметр("Организация", ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов", ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыОценки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад90", ТорговыхДнейНазад90);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10", ТорговыхДнейНазад10);
	Запрос.УстановитьПараметр("ММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	
	Запрос.УстановитьПараметр("Блумберг", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("Режим_BGN", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	
	Запрос.УстановитьПараметр("Рубли", ПараметрыОценки.Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберга", ПоследняяДатаТорговБлумберга);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Сургутнефтегаз (ЕПС)", "Таблица стоимостей ЦБ");		
	Иначе
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныТрадиции(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(Облигации.ДатаНачалаОбращения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаОбращения,
		|	ЕСТЬNULL(Облигации.ДатаНачалаРазмещения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаРазмещения
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	КотировкиТорговыхПлощадок.Рынок КАК Рынок,
		|	КотировкиТорговыхПлощадок.Биржа КАК Биржа,
		|	КотировкиТорговыхПлощадок.Валюта КАК Валюта,
		|	КурсыВалют.Кратность КАК Кратность,
		|	КурсыВалют.Курс КАК Курс
		|ПОМЕСТИТЬ АктивныйРынокММВБ90Дней
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|			ПО КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта
		|				И (КурсыВалют.Период = &ДатаПереоценки)
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадок.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
		|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|ГДЕ
		|	КотировкиТорговыхПлощадок.Период >= &ТорговыхДнейНазад90
		|	И КотировкиТорговыхПлощадок.Период <= &ДатаПереоценки
		|	И КотировкиТорговыхПлощадок.Биржа = &ММВБ
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал,
		|	КотировкиТорговыхПлощадок.Рынок,
		|	КотировкиТорговыхПлощадок.Биржа,
		|	КотировкиТорговыхПлощадок.Валюта,
		|	КурсыВалют.Кратность,
		|	КурсыВалют.Курс
		|
		|ИМЕЮЩИЕ
		|	СУММА(КотировкиТорговыхПлощадок.VALUE * ВЫБОР
		|			КОГДА КотировкиТорговыхПлощадок.Валюта = &Рубли
		|				ТОГДА 1
		|			ИНАЧЕ КурсыВалют.Курс / КурсыВалют.Кратность
		|		КОНЕЦ) >= 500000 И
		|	СУММА(КотировкиТорговыхПлощадок.NUMTRADES) >= 10
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АктивныйРынокММВБ90Дней.ЦеннаяБумага КАК ЦеннаяБумага,
		|	АктивныйРынокММВБ90Дней.Номинал КАК Номинал,
		|	КотировкиТорговыхПлощадок.Рынок КАК Рынок,
		|	КотировкиТорговыхПлощадок.Биржа КАК Биржа,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.MARKETPRICE2 > 0
		|			ТОГДА КотировкиТорговыхПлощадок.MARKETPRICE2
		|		КОГДА КотировкиТорговыхПлощадок.MARKETPRICE3 > 0
		|			ТОГДА КотировкиТорговыхПлощадок.MARKETPRICE3
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СправедливаяЦена,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.MARKETPRICE2 > 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.РыночнаяЦена2)
		|		КОГДА КотировкиТорговыхПлощадок.MARKETPRICE3 > 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.РыночнаяЦена3)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПолеКотировки,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.MARKETPRICE2 > 0
		|			ТОГДА КотировкиТорговыхПлощадок.Период
		|		КОГДА КотировкиТорговыхПлощадок.MARKETPRICE3 > 0
		|			ТОГДА КотировкиТорговыхПлощадок.Период
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ДатаКотировки,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.MARKETPRICE2 > 0
		|			ТОГДА 1
		|		КОГДА КотировкиТорговыхПлощадок.MARKETPRICE3 > 0
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УровеньОценки,
		|	КотировкиТорговыхПлощадок.Валюта КАК Валюта
		|ПОМЕСТИТЬ АктивыйРынокММВБОбъемТоргов
		|ИЗ
		|	АктивныйРынокММВБ90Дней КАК АктивныйРынокММВБ90Дней
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО АктивныйРынокММВБ90Дней.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
		|			И АктивныйРынокММВБ90Дней.Рынок = КотировкиТорговыхПлощадок.Рынок
		|			И АктивныйРынокММВБ90Дней.Биржа = КотировкиТорговыхПлощадок.Биржа
		|ГДЕ
		|	КотировкиТорговыхПлощадок.Период = &ПоследняяДатаТоргов
		|	И КотировкиТорговыхПлощадок.MARKETPRICE3 > 0
		|	И КотировкиТорговыхПлощадок.Биржа = &ММВБ
		|	И КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ВЫБОР
		|		КОГДА АктивыйРынокММВБОбъемТоргов.СправедливаяЦена > 0
		|			ТОГДА АктивыйРынокММВБОбъемТоргов.СправедливаяЦена
		|		КОГДА КотировкиТорговыхПлощадок.WAPRICE > 0
		|			ТОГДА КотировкиТорговыхПлощадок.WAPRICE
		|		КОГДА КотировкиТорговыхПлощадок.BID > 0
		|			ТОГДА КотировкиТорговыхПлощадок.BID
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СправедливаяЦена,
		|	ВЫБОР
		|		КОГДА АктивыйРынокММВБОбъемТоргов.СправедливаяЦена > 0
		|			ТОГДА АктивыйРынокММВБОбъемТоргов.ПолеКотировки
		|		КОГДА КотировкиТорговыхПлощадок.WAPRICE > 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныдляПереоценки.СредневзвешеннаяЦена)
		|		КОГДА КотировкиТорговыхПлощадок.BID > 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныдляПереоценки.ЦенаСпроса)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПолеКотировки,
		|	ВЫБОР
		|		КОГДА АктивыйРынокММВБОбъемТоргов.СправедливаяЦена > 0
		|			ТОГДА АктивыйРынокММВБОбъемТоргов.ДатаКотировки
		|		КОГДА КотировкиТорговыхПлощадок.WAPRICE > 0
		|			ТОГДА КотировкиТорговыхПлощадок.Период
		|		КОГДА КотировкиТорговыхПлощадок.BID > 0
		|			ТОГДА КотировкиТорговыхПлощадок.Период
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ДатаКотировки,
		|	ВЫБОР
		|		КОГДА АктивыйРынокММВБОбъемТоргов.СправедливаяЦена > 0
		|			ТОГДА АктивыйРынокММВБОбъемТоргов.УровеньОценки
		|		КОГДА КотировкиТорговыхПлощадок.WAPRICE > 0
		|			ТОГДА 1
		|		КОГДА КотировкиТорговыхПлощадок.BID > 0
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УровеньОценки,
		|	ВЫБОР
		|		КОГДА АктивыйРынокММВБОбъемТоргов.СправедливаяЦена > 0
		|			ТОГДА АктивыйРынокММВБОбъемТоргов.Биржа
		|		КОГДА КотировкиТорговыхПлощадок.WAPRICE > 0
		|			ТОГДА КотировкиТорговыхПлощадок.Биржа
		|		КОГДА КотировкиТорговыхПлощадок.BID > 0
		|			ТОГДА КотировкиТорговыхПлощадок.Биржа
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Биржа,
		|	ВЫБОР
		|		КОГДА АктивыйРынокММВБОбъемТоргов.СправедливаяЦена > 0
		|			ТОГДА АктивыйРынокММВБОбъемТоргов.Валюта
		|		КОГДА КотировкиТорговыхПлощадок.WAPRICE > 0
		|			ТОГДА КотировкиТорговыхПлощадок.Валюта
		|		КОГДА КотировкиТорговыхПлощадок.BID > 0
		|			ТОГДА КотировкиТорговыхПлощадок.Валюта
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ВалютаКотировки
		|ПОМЕСТИТЬ КотировкиБлумбергУровень1
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ АктивыйРынокММВБОбъемТоргов КАК АктивыйРынокММВБОбъемТоргов
		|		ПО ТаблицаЦБ.Рынок = АктивыйРынокММВБОбъемТоргов.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = АктивыйРынокММВБОбъемТоргов.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадок.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
		|			И (КотировкиТорговыхПлощадок.Биржа = &Блумберг)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов = &Режим_BGN)
		|			И (КотировкиТорговыхПлощадок.Период = &ДатаПереоценки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.CLOSE КАК CLOSE,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.CLOSE_DATE КАК CLOSE_DATE,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа КАК Биржа,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаПогашения,
		|	ЕСТЬNULL(Облигации.Категория, 0) КАК КатегорияОблигации,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта КАК Валюта
		|ПОМЕСТИТЬ Уровень2_1ЦеныПоследнихСделок
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ КотировкиБлумбергУровень1 КАК КотировкиБлумбергУровень1
		|		ПО ТаблицаЦБ.Рынок = КотировкиБлумбергУровень1.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиБлумбергУровень1.ЦеннаяБумага
		|			И (КотировкиБлумбергУровень1.СправедливаяЦена > 0)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|				&ДатаПереоценки,
		|				Биржа = &ММВБ
		|					И РежимТоргов.ОсновнойРежим) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадокСводныеСрезПоследних.Рынок
