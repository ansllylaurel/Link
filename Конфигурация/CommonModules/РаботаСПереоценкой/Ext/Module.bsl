		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО КотировкиБлумбергУровень1.ИсточникКотировки = Биржи.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				Статус = ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже)
		|					И Биржа = &ММВБ
		|					И ЦеннаяБумага В
		|						(ВЫБРАТЬ
		|							ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|						ИЗ
		|							ТаблицаЦБ КАК ТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО КотировкиБлумбергУровень1.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага";
	
	#КонецОбласти
	
	ИностранныеУчетныеАктивы		= Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();
	ПоследняяДатаТорговБлумберга	= РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки);	
	ПоследняяДатаТоргов				= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки));
	ТорговыхДнейНазад10				= Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -10);
	
	БиржаММВБ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",			ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10",			ТорговыхДнейНазад10);
	Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберга",	ПоследняяДатаТорговБлумберга);
	Запрос.УстановитьПараметр("ММВБ",							БиржаММВБ);
	Запрос.УстановитьПараметр("НРД",							ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("Блумберг",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("Режим_BGN",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	Запрос.УстановитьПараметр("ИностранныеУчетныеАктивы",		ИностранныеУчетныеАктивы);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Аквилон (ЕПС)", "Таблица стоимостей ЦБ");		
	КонецЕсли;
	
	ЗаполнитьНеоцененныеБумагиРасчетнымиЦенамиНационального2018(ПараметрыОценки, ДатаПереоценки, ТаблицаСтоимостейЦБ, Ложь, Истина, РасшифровкаРасчета);
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныЛукойла(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|;
		|"+"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		   |	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		   |	ТаблицаЦБ.Номинал КАК Номинал,
		   |	КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта КАК Валюта,
		   |	ВЫБОР
		   |		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		   |			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК СправедливаяЦена,
		   |	ВЫБОР
		   |		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		   |			ТОГДА 1
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК УровеньОценки,
		   |	ВЫБОР
		   |		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		   |			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК ДатаЦены,
		   |	ВЫБОР
		   |		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		   |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.РыночнаяЦена2)
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК ПолеКотировки,
		   |	ВЫБОР
		   |		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		   |			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК Биржа,
		   |	ТаблицаЦБ.Рынок КАК Рынок
		   |ПОМЕСТИТЬ КотировкиР2
		   |ИЗ
		   |	ТаблицаЦБ КАК ТаблицаЦБ
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		   |				&ДатаПереоценки,
		   |				Биржа = &ММВБ
		   |					И РежимТоргов.ОсновнойРежим) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
		   |		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадокСводныеСрезПоследних.Рынок
		   |			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага
		   |;
		   |
		   |////////////////////////////////////////////////////////////////////////////////
		   |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		   |	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		   |	ТаблицаЦБ.Рынок КАК Рынок,
		   |	КотировкиТорговыхПлощадок.РежимТоргов.ТПлюс КАК ТПлюс,
		   |	МАКСИМУМ(КотировкиТорговыхПлощадок.Период) КАК Период,
		   |	КотировкиТорговыхПлощадок.РежимТоргов КАК РежимТоргов
		   |ПОМЕСТИТЬ ДатыКотировокОсновныхТорговММВБ
		   |ИЗ
		   |	ТаблицаЦБ КАК ТаблицаЦБ
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		   |		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадок.Рынок
		   |			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
		   |ГДЕ
		   |	КотировкиТорговыхПлощадок.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		   |	И КотировкиТорговыхПлощадок.Период <= &ДатаПереоценки
		   |	И КотировкиТорговыхПлощадок.VOLUME > 0
		   |	И КотировкиТорговыхПлощадок.Биржа = &ММВБ
		   |	И КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим
		   |	И КотировкиТорговыхПлощадок.LEGALCLOSEPRICE > 0
		   |
		   |СГРУППИРОВАТЬ ПО
		   |	ТаблицаЦБ.ЦеннаяБумага,
		   |	ТаблицаЦБ.Рынок,
		   |	КотировкиТорговыхПлощадок.РежимТоргов.ТПлюс,
		   |	КотировкиТорговыхПлощадок.РежимТоргов
		   |;
		   |
		   |////////////////////////////////////////////////////////////////////////////////
		   |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		   |	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		   |	ТаблицаЦБ.Рынок КАК Рынок,
		   |	ВЫБОР
		   |		КОГДА КотировкиР2.СправедливаяЦена > 0
		   |			ТОГДА КотировкиР2.СправедливаяЦена
		   |		КОГДА НЕ ДатыКотировокОсновныхТорговММВБ.Период ЕСТЬ NULL
		   |				И НЕ ДатыКотировокОсновныхТорговММВБТПлюс.Период ЕСТЬ NULL
		   |			ТОГДА ВЫБОР
		   |					КОГДА ДатыКотировокОсновныхТорговММВБ.Период <= ДатыКотировокОсновныхТорговММВБТПлюс.Период
		   |						ТОГДА КотировкиТорговыхПлощадок.LEGALCLOSEPRICE
		   |					ИНАЧЕ КотировкиТорговыхПлощадокТПлюс.LEGALCLOSEPRICE
		   |				КОНЕЦ
		   |		КОГДА НЕ ДатыКотировокОсновныхТорговММВБ.Период ЕСТЬ NULL
		   |			ТОГДА КотировкиТорговыхПлощадок.LEGALCLOSEPRICE
		   |		КОГДА НЕ ДатыКотировокОсновныхТорговММВБТПлюс.Период ЕСТЬ NULL
		   |			ТОГДА КотировкиТорговыхПлощадокТПлюс.LEGALCLOSEPRICE
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК СправедливаяЦена,
		   |	ВЫБОР
		   |		КОГДА КотировкиР2.СправедливаяЦена > 0
		   |			ТОГДА КотировкиР2.УровеньОценки
		   |		КОГДА НЕ ДатыКотировокОсновныхТорговММВБ.Период ЕСТЬ NULL
		   |				И НЕ ДатыКотировокОсновныхТорговММВБТПлюс.Период ЕСТЬ NULL
		   |			ТОГДА ВЫБОР
		   |					КОГДА ДатыКотировокОсновныхТорговММВБ.Период <= ДатыКотировокОсновныхТорговММВБТПлюс.Период
		   |						ТОГДА 1
		   |					ИНАЧЕ 1
		   |				КОНЕЦ
		   |		КОГДА НЕ ДатыКотировокОсновныхТорговММВБ.Период ЕСТЬ NULL
		   |			ТОГДА 1
		   |		КОГДА НЕ ДатыКотировокОсновныхТорговММВБТПлюс.Период ЕСТЬ NULL
		   |			ТОГДА 1
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК УровеньОценки,
		   |	ВЫБОР
		   |		КОГДА КотировкиР2.СправедливаяЦена > 0
		   |			ТОГДА КотировкиР2.ДатаЦены
		   |		КОГДА НЕ ДатыКотировокОсновныхТорговММВБ.Период ЕСТЬ NULL
		   |				И НЕ ДатыКотировокОсновныхТорговММВБТПлюс.Период ЕСТЬ NULL
		   |			ТОГДА ВЫБОР
		   |					КОГДА ДатыКотировокОсновныхТорговММВБ.Период <= ДатыКотировокОсновныхТорговММВБТПлюс.Период
		   |						ТОГДА ДатыКотировокОсновныхТорговММВБ.Период
		   |					ИНАЧЕ ДатыКотировокОсновныхТорговММВБТПлюс.Период
		   |				КОНЕЦ
		   |		КОГДА НЕ ДатыКотировокОсновныхТорговММВБ.Период ЕСТЬ NULL
		   |			ТОГДА ДатыКотировокОсновныхТорговММВБ.Период
		   |		КОГДА НЕ ДатыКотировокОсновныхТорговММВБТПлюс.Период ЕСТЬ NULL
		   |			ТОГДА ДатыКотировокОсновныхТорговММВБТПлюс.Период
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК ДатаЦены,
		   |	ВЫБОР
		   |		КОГДА КотировкиР2.СправедливаяЦена > 0
		   |			ТОГДА КотировкиР2.ПолеКотировки
		   |		КОГДА НЕ ДатыКотировокОсновныхТорговММВБ.Период ЕСТЬ NULL
		   |				ИЛИ НЕ ДатыКотировокОсновныхТорговММВБТПлюс.Период ЕСТЬ NULL
		   |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ЦенаЗакрытия)
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК ПолеКотировки,
		   |	КотировкиР2.Биржа КАК Биржа,
		   |	ВЫБОР
		   |		КОГДА КотировкиР2.СправедливаяЦена > 0
		   |			ТОГДА КотировкиР2.Валюта
		   |		КОГДА НЕ ДатыКотировокОсновныхТорговММВБ.Период ЕСТЬ NULL
		   |				И НЕ ДатыКотировокОсновныхТорговММВБТПлюс.Период ЕСТЬ NULL
		   |			ТОГДА ВЫБОР
		   |					КОГДА ДатыКотировокОсновныхТорговММВБ.Период <= ДатыКотировокОсновныхТорговММВБТПлюс.Период
		   |						ТОГДА КотировкиТорговыхПлощадок.Валюта
		   |					ИНАЧЕ КотировкиТорговыхПлощадокТПлюс.Валюта
		   |				КОНЕЦ
		   |		КОГДА НЕ ДатыКотировокОсновныхТорговММВБ.Период ЕСТЬ NULL
		   |			ТОГДА КотировкиТорговыхПлощадок.Валюта
		   |		КОГДА НЕ ДатыКотировокОсновныхТорговММВБТПлюс.Период ЕСТЬ NULL
		   |			ТОГДА КотировкиТорговыхПлощадокТПлюс.Валюта
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК ВалютаКотировки
		   |ПОМЕСТИТЬ КотировкиОсновныхТорговММВБ
		   |ИЗ
		   |	ТаблицаЦБ КАК ТаблицаЦБ
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		   |			ЛЕВОЕ СОЕДИНЕНИЕ ДатыКотировокОсновныхТорговММВБ КАК ДатыКотировокОсновныхТорговММВБ
		   |			ПО (ДатыКотировокОсновныхТорговММВБ.Рынок = КотировкиТорговыхПлощадок.Рынок)
		   |				И (ДатыКотировокОсновныхТорговММВБ.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага)
		   |				И (ДатыКотировокОсновныхТорговММВБ.РежимТоргов = КотировкиТорговыхПлощадок.РежимТоргов)
		   |				И (ДатыКотировокОсновныхТорговММВБ.Период = КотировкиТорговыхПлощадок.Период)
		   |				И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		   |		ПО (ТаблицаЦБ.Рынок = ДатыКотировокОсновныхТорговММВБ.Рынок)
		   |			И (ТаблицаЦБ.ЦеннаяБумага = ДатыКотировокОсновныхТорговММВБ.ЦеннаяБумага)
		   |			И (ДатыКотировокОсновныхТорговММВБ.ТПлюс)
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадокТПлюс
		   |			ЛЕВОЕ СОЕДИНЕНИЕ ДатыКотировокОсновныхТорговММВБ КАК ДатыКотировокОсновныхТорговММВБТПлюс
		   |			ПО (ДатыКотировокОсновныхТорговММВБТПлюс.Рынок = КотировкиТорговыхПлощадокТПлюс.Рынок)
		   |				И (ДатыКотировокОсновныхТорговММВБТПлюс.ЦеннаяБумага = КотировкиТорговыхПлощадокТПлюс.ЦеннаяБумага)
		   |				И (ДатыКотировокОсновныхТорговММВБТПлюс.РежимТоргов = КотировкиТорговыхПлощадокТПлюс.РежимТоргов)
