		|ПОМЕСТИТЬ _КотировкиБлумберг
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|						(ВЫБРАТЬ
		|							ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|						ИЗ
		|							_ТаблицаСпискаЦБ КАК ИсходнаяТаблицаЦБ)
		|					И Биржа = &Блумберг) КАК КотировкиТорговыхПлощадок
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
		|			И ИсходнаяТаблицаЦБ.Рынок = КотировкиТорговыхПлощадок.Рынок
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Уровень1 КАК ВТУровень1
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = ВТУровень1.ЦеннаяБумага
		|			И ИсходнаяТаблицаЦБ.Рынок = ВТУровень1.Рынок
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеНРД КАК ВТДанныеНРД
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = ВТДанныеНРД.ЦеннаяБумага
		|			И ИсходнаяТаблицаЦБ.Рынок = ВТДанныеНРД.Рынок
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РасчетнаяСтоимостьПаев КАК ВТРасчетнаяСтоимостьПаев
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = ВТРасчетнаяСтоимостьПаев.ЦеннаяБумага
		|			И ИсходнаяТаблицаЦБ.Рынок = ВТРасчетнаяСтоимостьПаев.Рынок
		|ГДЕ
		|	КотировкиТорговыхПлощадок.Период > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|	И ВТУровень1.ЦеннаяБумага ЕСТЬ NULL
		|	И ВТДанныеНРД.ЦеннаяБумага ЕСТЬ NULL
		|	И ВТРасчетнаяСтоимостьПаев.ЦеннаяБумага ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.Рынок,
		|	КотировкиТорговыхПлощадок.Биржа.ЮрФизЛицо,
		|	ИсходнаяТаблицаЦБ.Номинал,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТКотировкиБлумберг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВТКотировкиБлумберг.Рынок КАК Рынок,
		|	ВЫБОР
		|		КОГДА ВТКотировкиБлумберг.WAPRICE <> 0
		|			ТОГДА ВТКотировкиБлумберг.WAPRICE
		|		КОГДА ВТКотировкиБлумберг.CLOSE <> 0
		|			ТОГДА ВТКотировкиБлумберг.CLOSE
		|	КОНЕЦ КАК Стоимость,
		|	ВЫБОР
		|		КОГДА ВТКотировкиБлумберг.WAPRICE <> 0
		|			ТОГДА ВТКотировкиБлумберг.WAPRICE_DATE
		|		КОГДА ВТКотировкиБлумберг.CLOSE <> 0
		|			ТОГДА ВТКотировкиБлумберг.CLOSE_DATE
		|	КОНЕЦ КАК ДатаЦены,
		|	ВЫБОР
		|		КОГДА ВТКотировкиБлумберг.WAPRICE <> 0
		|			ТОГДА 1
		|		КОГДА ВТКотировкиБлумберг.CLOSE <> 0
		|			ТОГДА 2
		|	КОНЕЦ КАК Уровень,
		|	ВТКотировкиБлумберг.Источник КАК Источник,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СредневзвешеннаяЦена) КАК ВидЦены,
		|	ВТКотировкиБлумберг.Номинал КАК Номинал,
		|	ВТКотировкиБлумберг.ВалютаНоминала КАК ВалютаНоминала
		|ПОМЕСТИТЬ _СтоимостьБлумберг
		|ИЗ
		|	_КотировкиБлумберг КАК ВТКотировкиБлумберг
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ВТКотировкиБлумберг.WAPRICE <> 0
		|				ТОГДА ВТКотировкиБлумберг.WAPRICE
		|			КОГДА ВТКотировкиБлумберг.CLOSE <> 0
		|				ТОГДА ВТКотировкиБлумберг.CLOSE
		|		КОНЕЦ <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТУровень1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВТУровень1.Рынок КАК Рынок,
		|	ВТУровень1.Номинал КАК Номинал,
		|	ВТУровень1.ВалютаНоминала КАК ВалютаНоминала,
		|	ВТУровень1.ВалютаНоминала КАК ВалютаКупона,
		|	ВТУровень1.ВалютаКотировки КАК ВалютаКотировки,
		|	ВТУровень1.Стоимость КАК Стоимость,
		|	ВТУровень1.ДатаЦены КАК ДатаЦены,
		|	0 КАК Купон,
		|	ВТУровень1.Источник КАК Источник,
		|	ВТУровень1.ВидЦены КАК ВидЦены,
		|	1 КАК УровеньОценки
		|ПОМЕСТИТЬ _ОцененныеЦенныеБумаги
		|ИЗ
		|	_Уровень1 КАК ВТУровень1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТДанныеНРД.ЦеннаяБумага,
		|	ВТДанныеНРД.Рынок,
		|	ВТДанныеНРД.Номинал,
		|	ВТДанныеНРД.ВалютаНоминала,
		|	ВТДанныеНРД.ВалютаНоминала,
		|	ВТДанныеНРД.ВалютаНоминала,
		|	ВТДанныеНРД.Стоимость,
		|	ВТДанныеНРД.ДатаЦены,
		|	0,
		|	ВТДанныеНРД.Источник,
		|	ВТДанныеНРД.ВидЦены,
		|	ВТДанныеНРД.Уровень
		|ИЗ
		|	_ДанныеНРД КАК ВТДанныеНРД
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТСтоимостьБлумберг.ЦеннаяБумага,
		|	ВТСтоимостьБлумберг.Рынок,
		|	ВТСтоимостьБлумберг.Номинал,
		|	ВТСтоимостьБлумберг.ВалютаНоминала,
		|	ВТСтоимостьБлумберг.ВалютаНоминала,
		|	ВТСтоимостьБлумберг.ВалютаНоминала,
		|	ВТСтоимостьБлумберг.Стоимость,
		|	ВТСтоимостьБлумберг.ДатаЦены,
		|	0,
		|	ВТСтоимостьБлумберг.Источник,
		|	ВТСтоимостьБлумберг.ВидЦены,
		|	ВТСтоимостьБлумберг.Уровень
		|ИЗ
		|	_СтоимостьБлумберг КАК ВТСтоимостьБлумберг
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТРасчетнаяСтоимостьПаев.ЦеннаяБумага,
		|	ВТРасчетнаяСтоимостьПаев.Рынок,
		|	ВТРасчетнаяСтоимостьПаев.Номинал,
		|	ВТРасчетнаяСтоимостьПаев.ВалютаНоминала,
		|	ВТРасчетнаяСтоимостьПаев.ВалютаНоминала,
		|	ВТРасчетнаяСтоимостьПаев.ВалютаНоминала,
		|	ВТРасчетнаяСтоимостьПаев.Стоимость,
		|	ВТРасчетнаяСтоимостьПаев.ДатаЦены,
		|	0,
		|	ВТРасчетнаяСтоимостьПаев.Источник,
		|	ВТРасчетнаяСтоимостьПаев.ВидЦены,
		|	ВТРасчетнаяСтоимостьПаев.Уровень
		|ИЗ
		|	_РасчетнаяСтоимостьПаев КАК ВТРасчетнаяСтоимостьПаев
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ИсходнаяТаблицаЦБ.Номинал КАК Номинал,
		|	ЕСТЬNULL(_ОцененныеЦенныеБумаги.Стоимость, 0) КАК Стоимость,
		|	ЕСТЬNULL(_ОцененныеЦенныеБумаги.ВалютаКотировки, НЕОПРЕДЕЛЕНО) КАК ВалютаКотировки,
		|	ЕСТЬNULL(_ОцененныеЦенныеБумаги.ВидЦены, НЕОПРЕДЕЛЕНО) КАК ВидЦены,
		|	ЕСТЬNULL(_ОцененныеЦенныеБумаги.ДатаЦены, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаЦены,
		|	ЕСТЬNULL(_ОцененныеЦенныеБумаги.УровеньОценки, НЕОПРЕДЕЛЕНО) КАК УровеньОценки,
		|	ЕСТЬNULL(_ОцененныеЦенныеБумаги.Источник, НЕОПРЕДЕЛЕНО) КАК Источник,
		|	ЕСТЬNULL(_ОцененныеЦенныеБумаги.Купон, 0) КАК Купон,
		|	ЕСТЬNULL(_ОцененныеЦенныеБумаги.ВалютаКупона, НЕОПРЕДЕЛЕНО) КАК ВалютаКупона
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОцененныеЦенныеБумаги КАК _ОцененныеЦенныеБумаги
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = _ОцененныеЦенныеБумаги.ЦеннаяБумага";
			
		#КонецОбласти		
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", 	ТаблицаЦБ);	       
	Запрос.УстановитьПараметр("ДатаПереоценки", 	НачалоДня(ДатаПереоценки));	
	Запрос.УстановитьПараметр("ММВБ", 				ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("НРД",				ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));	
	Запрос.УстановитьПараметр("Режим_BGN", 			ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL",			ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	Запрос.УстановитьПараметр("Блумберг", 			ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
		
	Если РасшифровкаРасчета <> Неопределено Тогда
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Средневзвешенная (ЕПС)", "Таблица стоимостей ЦБ");		
	Иначе
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы из ТаблицаСтоимостейЦБ Цикл
		Если ТипЗнч(СтрокаТаблицы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда				
				СтрокаТаблицы.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаТаблицы.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);	
		КонецЕсли;
	КонецЦикла;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "После заполнения расчетного купона", ТаблицаСтоимостейЦБ.Скопировать());		
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;

КонецФункции

Функция ПолучитьЦеныСредневзвешенная2022(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	// Уровень 1:
	//	- цены ММВБ WAPRICE глубиной не более 30 календарных дней;
	// Уровень 2:
	//	- цены НРД глубиной не более 30 календарных дней;
	//  - цены паев 
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ИсходнаяТаблицаЦБ");
	ПоместитьТаблицуДатРасчетныхЦенПаевВМенеджерВременныхТаблиц(Запрос, "_ИсходнаяТаблицаЦБ", ДатаПереоценки, "_ТаблицаДатРасчетныхЦенПаев");
	
	#Область Основной_запрос
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ВЫБОР
		|		КОГДА _ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|				И ВЫРАЗИТЬ(_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.КСУ)
		|			ТОГДА ВЫРАЗИТЬ(_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Номинал
		|		ИНАЧЕ НоминалыЦенныхБумагСрезПоследних.Номинал
		|	КОНЕЦ КАК Номинал,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК ТоргуетсяНаММВБ
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ИСТИНА
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|					ГДЕ
		|						ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, Статус, Биржа, Рынок) В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже),
		|						&ММВБ,
		|						ИсходнаяТаблицаЦБ.Рынок
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиТорговыхПлощадок.Рынок КАК Рынок,
		|	КотировкиТорговыхПлощадок.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.Биржа КАК Биржа,
		|	КотировкиТорговыхПлощадок.РежимТоргов КАК РежимТоргов,
		|	КотировкиТорговыхПлощадок.WAPRICE КАК WAPRICE,
		|	КотировкиТорговыхПлощадок.WAPRICE_DATE КАК WAPRICE_DATE,
		|	КотировкиТорговыхПлощадок.Валюта КАК Валюта,
		|	_ТаблицаЦБ.ВалютаНоминала = КотировкиТорговыхПлощадок.Валюта КАК ВВалютеНоминала
		|ПОМЕСТИТЬ _КотировкиММВБЗаПоследние30Дней
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, Рынок, Биржа) В
		|					(ВЫБРАТЬ
		|						_ТаблицаЦБ.ЦеннаяБумага,
		|						_ТаблицаЦБ.Рынок,
		|						&ММВБ
		|					ИЗ
		|						_ТаблицаЦБ КАК _ТаблицаЦБ
		|					ГДЕ
		|						_ТаблицаЦБ.ТоргуетсяНаММВБ)) КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.WAPRICE > 0)
		|			И (КотировкиТорговыхПлощадок.WAPRICE_DATE >= &КалендарныхДнейНазад30)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.Рынок КАК Рынок,
