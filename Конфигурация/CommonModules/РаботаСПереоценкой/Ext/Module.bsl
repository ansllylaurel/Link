		|						ИНАЧЕ 0
		|					КОНЕЦ КАК ЧИСЛО(19, 10))
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК РыночнаяЦенаПроцент,
		|	ВЫБОР
		|		КОГДА _КотировкиСДублями.ЦенаКотировки > 0
		|			ТОГДА _КотировкиСДублями.ДатаКотировки
		|		КОГДА ЕСТЬNULL(КотировкиБлумберг.CLOSE_DATE, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) >= &МинимальнаяДатаКотировки
		|				И ЕСТЬNULL(КотировкиБлумберг.CLOSE, 0) <> 0
		|			ТОГДА КотировкиБлумберг.CLOSE_DATE
		|		КОГДА ЕСТЬNULL(КотировкиЛондон.LEGALCLOSEPRICE_DATE, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) >= &МинимальнаяДатаКотировки
		|				И ЕСТЬNULL(КотировкиЛондон.LEGALCLOSEPRICE, 0) <> 0
		|			ТОГДА КотировкиЛондон.LEGALCLOSEPRICE_DATE
		|		КОГДА ЕСТЬNULL(КотировкиФранкфурт.LEGALCLOSEPRICE_DATE, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) >= &МинимальнаяДатаКотировки
		|				И ЕСТЬNULL(КотировкиФранкфурт.LEGALCLOSEPRICE, 0) <> 0
		|			ТОГДА КотировкиФранкфурт.LEGALCLOSEPRICE_DATE
		|		ИНАЧЕ ДАТАВРЕМЯ(1980, 1, 1)
		|	КОНЕЦ <> &РабочаяДатапереоценки КАК ТребуетсяРасчет,
		|	ВЫБОР
		|		КОГДА _КотировкиСДублями.ЦенаКотировки > 0
		|			ТОГДА _КотировкиСДублями.Биржа
		|		КОГДА ЕСТЬNULL(КотировкиБлумберг.CLOSE_DATE, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) >= &МинимальнаяДатаКотировки
		|				И ЕСТЬNULL(КотировкиБлумберг.CLOSE, 0) <> 0
		|			ТОГДА КотировкиБлумберг.Биржа
		|		КОГДА ЕСТЬNULL(КотировкиЛондон.LEGALCLOSEPRICE_DATE, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) >= &МинимальнаяДатаКотировки
		|				И ЕСТЬNULL(КотировкиЛондон.LEGALCLOSEPRICE, 0) <> 0
		|			ТОГДА КотировкиЛондон.Биржа
		|		КОГДА ЕСТЬNULL(КотировкиФранкфурт.LEGALCLOSEPRICE_DATE, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) >= &МинимальнаяДатаКотировки
		|				И ЕСТЬNULL(КотировкиФранкфурт.LEGALCLOSEPRICE, 0) <> 0
		|			ТОГДА КотировкиФранкфурт.Биржа
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Биржа,
		|	ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследних.Номинал, 0) КАК Номинал,
		|	ВЫБОР
		|		КОГДА _КотировкиСДублями.ЦенаКотировки > 0
		|			ТОГДА _КотировкиСДублями.ИсточникЦены
		|		КОГДА ЕСТЬNULL(КотировкиБлумберг.CLOSE_DATE, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) >= &МинимальнаяДатаКотировки
		|				И ЕСТЬNULL(КотировкиБлумберг.CLOSE, 0) <> 0
		|			ТОГДА КотировкиБлумберг.Биржа.ЮрФизЛицо
		|		КОГДА ЕСТЬNULL(КотировкиЛондон.LEGALCLOSEPRICE_DATE, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) >= &МинимальнаяДатаКотировки
		|				И ЕСТЬNULL(КотировкиЛондон.LEGALCLOSEPRICE, 0) <> 0
		|			ТОГДА КотировкиЛондон.Биржа.ЮрФизЛицо
		|		КОГДА ЕСТЬNULL(КотировкиФранкфурт.LEGALCLOSEPRICE_DATE, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) >= &МинимальнаяДатаКотировки
		|				И ЕСТЬNULL(КотировкиФранкфурт.LEGALCLOSEPRICE, 0) <> 0
		|			ТОГДА КотировкиФранкфурт.Биржа.ЮрФизЛицо
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ИсточникЦены,
		|	ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена, 0) КАК РасчетнаяЦенаПая,
		|	ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).ДатаПогашения КАК ДатаПогашения
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(
		|				&Период,
		|				ВЫРАЗИТЬ(ЦеннаяБумага КАК Справочник.Паи) В
		|					(ВЫБРАТЬ
		|						_ЦенныеБумаги.ЦеннаяБумага
		|					ИЗ
		|						_ЦенныеБумаги)) КАК РасчетныеЦеныПаевСрезПоследних
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РежимыТорговММВБ КАК _РежимыТорговММВБ
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = _РежимыТорговММВБ.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КотировкиСДублями КАК _КотировкиСДублями
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = _КотировкиСДублями.ЦеннаяБумага
		|			И (_РежимыТорговММВБ.РежимТоргов = _КотировкиСДублями.РежимТоргов)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|				&Период,
		|				Биржа = &Блумберг
		|					И РежимТоргов = &BGN
		|					И ЦеннаяБумага В
		|						(ВЫБРАТЬ
		|							_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага
		|						ИЗ
		|							_ЦенныеБумаги КАК _ЦенныеБумаги)) КАК КотировкиБлумберг
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = КотировкиБлумберг.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&Период,
		|				ВЫРАЗИТЬ(ЦеннаяБумага КАК Справочник.Облигации) В
		|					(ВЫБРАТЬ
		|						_ЦенныеБумаги.ЦеннаяБумага
		|					ИЗ
		|						_ЦенныеБумаги)) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|				&Период,
		|				Биржа = &Лондон
		|					И ЦеннаяБумага В
		|						(ВЫБРАТЬ
		|							_ЦенныеБумаги.ЦеннаяБумага
		|						ИЗ
		|							_ЦенныеБумаги
		|						ГДЕ
		|							_ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки)) КАК КотировкиЛондон
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = КотировкиЛондон.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|				&Период,
		|				Биржа = &Франкфурт
		|					И ЦеннаяБумага В
		|						(ВЫБРАТЬ
		|							_ЦенныеБумаги.ЦеннаяБумага
		|						ИЗ
		|							_ЦенныеБумаги
		|						ГДЕ
		|							_ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки)) КАК КотировкиФранкфурт
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = КотировкиФранкфурт.ЦеннаяБумага";
		
		
		//ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КотировкиЦенныхБумаг.Период", "КотировкиЦенныхБумаг.MARKETPRICE2_DATE");
		
		//Если НЕ СчетДоверительногоУправления.КалендарьКотировок = Справочники.Календари.ПустаяСсылка() Тогда
		//	Календарь = СчетДоверительногоУправления.КалендарьКотировок;
		//КонецЕсли;
	
	
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "MARKETPRICE2", ПолеКотировки);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЧИСЛО(19, 2)", "ЧИСЛО(19, " + Формат(ТочностьРасчетаОценочнойСтоимости, "ЧЦ=10") + ")");
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ПолучатьЦеныПаев", ВариантРасчетаСтоимости.Родитель = Справочники.ВариантыРасчетаОценочнойСтоимости.Бухгалтерия);
	Запрос.УстановитьПараметр("РабочаяДатаПереоценки", РабочаяДатаПереоценки);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ЦенныеБумаги", ЦенныеБумаги);
	Запрос.УстановитьПараметр("БиржаММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("Блумберг", ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("BGN", ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Календарь", Календарь);	
	
	//котировки Лондона и Франкфурта дейтствуют для Долгосрочных инвестиций (УКПИ) для депозитарных расписок. Если кому-то лишние, нужно условия навешивать.
	Запрос.УстановитьПараметр("Лондон", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_LSE"));
	Запрос.УстановитьПараметр("Франкфурт", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_FRNK"));
	
	МинимальнаяДатаКотировки = ?(ВариантРасчетаСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная3ПоследняяЗа90КалендарныхДней
			Или ВариантРасчетаСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная2ПоследняяЗа90КалендарныхДней, НачалоДня(Период) - 90 * 24 * 60 * 60, РабочаяДатаПереоценки); //нужно рабочую дату именно взять
	Запрос.УстановитьПараметр("МинимальнаяДатаКотировки", МинимальнаяДатаКотировки);	
	
	Возврат Запрос.Выполнить().Выгрузить();
		
КонецФункции 

Процедура ДополнитьТаблицуПолямиПереоценки(Таблица, ДополнительныеКолонки = Неопределено)
	
	// Добавляем колонки переоценки или обновляем точность имеющихся
	
	РеквизитыПереоценки = Метаданные.Документы.ПереоценкаЦенныхБумаг.ТабличныеЧасти.ЦенныеБумаги.Реквизиты;
	
	ПроверкаТочности = Новый Структура("РыночнаяСумма, РыночнаяСуммаКупона, ЦенаКотировки, КурсВалютыНоминала");	
	
	Для Каждого РеквизитПереоценки Из РеквизитыПереоценки Цикл
		Если Таблица.Колонки.Найти(РеквизитПереоценки.Имя) = Неопределено Тогда
			Таблица.Колонки.Добавить(РеквизитПереоценки.Имя, РеквизитПереоценки.Тип);
		ИначеЕсли ПроверкаТочности.Свойство(РеквизитПереоценки.Имя)
			И Таблица.Колонки[РеквизитПереоценки.Имя].ТипЗначения.КвалификаторыЧисла.РазрядностьДробнойЧасти < РеквизитПереоценки.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти
		Тогда
			РаботаСКоллекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(Таблица, РеквизитПереоценки.Имя, РеквизитПереоценки.Тип);
		КонецЕсли;
	КонецЦикла;
	
	// Добавляем дополнительные колонки или обновляем точность имеющихся
	
	Если ТипЗнч(ДополнительныеКолонки) = Тип("Структура") Тогда
		Для Каждого ДополнительнаяКолонка Из ДополнительныеКолонки Цикл
			ТипКолонки = ДополнительнаяКолонка.Значение;
			Если Таблица.Колонки.Найти(ДополнительнаяКолонка.Ключ) = Неопределено Тогда
				Таблица.Колонки.Добавить(ДополнительнаяКолонка.Ключ, ТипКолонки);
			ИначеЕсли Таблица.Колонки[ДополнительнаяКолонка.Ключ].ТипЗначения.КвалификаторыЧисла.РазрядностьДробнойЧасти < ТипКолонки.КвалификаторыЧисла.РазрядностьДробнойЧасти Тогда
				РаботаСКоллекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(Таблица, ДополнительнаяКолонка.Ключ, ТипКолонки);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры	

Процедура ЗаполнитьЦеныКупона(СтрокаЦенныеБумаги, ДатаПереоценки, ИспользоватьРасчетныйКупон, СчетДоверительногоУправления, КэшРасчетныхКупонов)

	Если СтрокаЦенныеБумаги.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.Дефолт
		И СтрокаЦенныеБумаги.УровеньОценки <> 3 // Исключаем дефолт на основании проф. суждения
	Тогда
		
		СтрокаЦенныеБумаги.УровеньОценки		= 3;
		СтрокаЦенныеБумаги.ДатаКотировкиКупона	= '00010101000000';
		СтрокаЦенныеБумаги.РыночнаяЦенаКупона	= 0;
		СтрокаЦенныеБумаги.РыночнаяСуммаКупона	= 0;
		СтрокаЦенныеБумаги.ОценочнаяЦенаКупона	= 0;
		СтрокаЦенныеБумаги.ОценочнаяСуммаКупона	= 0;
		
		Возврат;
		
	КонецЕсли;
	
	Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		
		РассчитатьКупон = Ложь;
		
		Если ЗначениеЗаполнено(СтрокаЦенныеБумаги.ДатаПогашения) И СтрокаЦенныеБумаги.ДатаПогашения <= ДатаПереоценки Тогда
			СтрокаЦенныеБумаги.ОценочнаяЦенаКупона 	= СтрокаЦенныеБумаги.БалансоваяЦенаКупона;
			СтрокаЦенныеБумаги.ОценочнаяСуммаКупона = СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
			СтрокаЦенныеБумаги.ДатаКотировкиКупона = СтрокаЦенныеБумаги.ДатаПогашения;
		ИначеЕсли СтрокаЦенныеБумаги.ДатаКотировкиКупона = ДатаПереоценки И НЕ ИспользоватьРасчетныйКупон Тогда
			СтрокаЦенныеБумаги.ОценочнаяЦенаКупона 	= СтрокаЦенныеБумаги.РыночнаяЦенаКупона;
			СтрокаЦенныеБумаги.ОценочнаяСуммаКупона = СтрокаЦенныеБумаги.РыночнаяСуммаКупона;
		Иначе
			РассчитатьКупон = Истина;
		КонецЕсли;
		
		Если СтрокаЦенныеБумаги.ОценочнаяЦенаКупона = 0 И Не РассчитатьКупон Тогда
			РассчитатьКупон = РаботаСЦеннымиБумагами.ТребуетсяРасчетКупона(СтрокаЦенныеБумаги.ЦеннаяБумага, ДатаПереоценки);
		КонецЕсли;
		
		Если РассчитатьКупон Тогда
			
			ОценочнаяЦенаКупона = КэшРасчетныхКупонов.Получить(СтрокаЦенныеБумаги.ЦеннаяБумага);
			Если ОценочнаяЦенаКупона = Неопределено Тогда
				ТочностьКупона		= РаботаСЦеннымиБумагами.ТочностьРасчетногоКупона(СтрокаЦенныеБумаги.ЦеннаяБумага, ДатаПереоценки, СтрокаЦенныеБумаги.ВалютаНоминала, СчетДоверительногоУправления);
				ОценочнаяЦенаКупона = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(СтрокаЦенныеБумаги.ЦеннаяБумага, ДатаПереоценки, СчетДоверительногоУправления, , ТочностьКупона);
				КэшРасчетныхКупонов.Вставить(СтрокаЦенныеБумаги.ЦеннаяБумага, ОценочнаяЦенаКупона);
			КонецЕсли; 
			
			СтрокаЦенныеБумаги.ОценочнаяЦенаКупона	= ОценочнаяЦенаКупона;
			СтрокаЦенныеБумаги.ОценочнаяСуммаКупона	= СтрокаЦенныеБумаги.ОценочнаяЦенаКупона * СтрокаЦенныеБумаги.Количество;
			СтрокаЦенныеБумаги.ДатаКотировкиКупона	= ДатаПереоценки;
			
		КонецЕсли;
		
	Иначе
		
		СтрокаЦенныеБумаги.ДатаКотировкиКупона 		= '00010101000000';
		СтрокаЦенныеБумаги.БалансоваяЦенаКупона 	= 0;
		СтрокаЦенныеБумаги.БалансоваяСуммаКупона	= 0;
		СтрокаЦенныеБумаги.РыночнаяЦенаКупона 		= 0;
		СтрокаЦенныеБумаги.РыночнаяСуммаКупона 		= 0;
		СтрокаЦенныеБумаги.ОценочнаяЦенаКупона 		= 0;
		СтрокаЦенныеБумаги.ОценочнаяСуммаКупона 	= 0;
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьОценочнуюЦенуПоЗначению(СтрокаЦенныеБумаги, Цена, ПолеЦены, Номинал = Неопределено)

	Если Цена <> 0 Тогда
		СтрокаЦенныеБумаги.ОценочнаяЦена = Цена;
		СтрокаЦенныеБумаги.ОценочнаяЦенаПроцент = Цена / ?(ЗначениеЗаполнено(Номинал), Номинал, 100) * 100;
		СтрокаЦенныеБумаги.ПолеЦены = ПолеЦены;
		СтрокаЦенныеБумаги.ОценочнаяСумма = Цена * СтрокаЦенныеБумаги.Количество;
	КонецЕсли;

КонецПроцедуры
 
Процедура ЗаполнитьОценочнуюЦенуПоВидуЦены(СтрокаЦенныеБумаги, ВидЦены)

	СтрокаЦенныеБумаги.ПолеЦены 			= Перечисления.ИсточникиЦеныДляПереоценки[ВидЦены + "Цена"];
	СтрокаЦенныеБумаги.ОценочнаяЦена 		= СтрокаЦенныеБумаги[ВидЦены + "Цена"];
	СтрокаЦенныеБумаги.ОценочнаяЦенаПроцент	= СтрокаЦенныеБумаги[ВидЦены + "ЦенаПроцент"];
	СтрокаЦенныеБумаги.ОценочнаяСумма 		= СтрокаЦенныеБумаги[ВидЦены + "Сумма"];

КонецПроцедуры

Процедура ПрименитьПолитикуУчетаЕПС(Объект, УдалятьЛишниеСтроки = Ложь, СообщенияОбОценочнойСтоимости = Неопределено, ВалютаУчета, Отказ)
	
	ДатаПереоценки = НачалоДня(Объект.Дата);
	// На текущий момент нет настроек учета, которые бы позволили бы управлять формированием движений по партиям
	// и формированием проводок (для страховых партии нужны, а проводки нет). В результате пришлось извращаться:
	// движения по партиям формируются всегда; 
	ВедетсяУчетПоТекущемуВиду = РегистрыСведений.НастройкиУчетаОбщие.ВедетсяУчетПоВиду(
		ДатаПереоценки,
		Объект.Организация,
		Объект.СчетДоверительногоУправления,
		Объект.ВидУчета);
	
	ПереоценкаПослеВводаНачальныхОстатков = Ложь;
	//Вдруг это переоценка датой ввода остатков?
	Если НЕ ВедетсяУчетПоТекущемуВиду Тогда
		ВедетсяУчетПоТекущемуВиду = РегистрыСведений.НастройкиУчетаОбщие.ВедетсяУчетПоВиду(
			ДатаПереоценки + 24 * 60 * 60,
			Объект.Организация,
			Объект.СчетДоверительногоУправления,
			Объект.ВидУчета);
		ПереоценкаПослеВводаНачальныхОстатков = ВедетсяУчетПоТекущемуВиду;
	КонецЕсли;
	
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(ДатаПереоценки, Объект.Организация, Объект.СчетДоверительногоУправления);
	Если ПереоценкаПослеВводаНачальныхОстатков Тогда
		НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(ДатаПереоценки + 24 * 60 * 60, Объект.Организация, Объект.СчетДоверительногоУправления);
	КонецЕсли;
	
	НастройкиПереоценкиЦенныхБумаг = БухгалтерскийУчет.ОпределитьНастройкиУчетаЦенныхБумаг(ДатаПереоценки, 
		Объект.Организация,
		Объект.СчетДоверительногоУправления,
		"ПолучитьСписокНастроекДляПереоценки");
	
	МассивСчетовБудущего = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_БУДУЩЕЕ"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
																				ДатаПереоценки);
	ЭтоКлиентБудущее = (МассивСчетовБудущего.Найти(Объект.СчетДоверительногоУправления) <> Неопределено);
	
	МассивСчетовТелеком = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_ТелекомСоюз"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
																				ДатаПереоценки);
	ЭтоКлиентТелеком = (МассивСчетовТелеком.Найти(Объект.СчетДоверительногоУправления) <> Неопределено);
	
	МассивСчетовЭволюции = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Эволюция"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
																				ДатаПереоценки);
	ЭтоКлиентЭволюция = (МассивСчетовЭволюции.Найти(Объект.СчетДоверительногоУправления) <> Неопределено);

	МассивСчетовСНГ = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФ_СНГ"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"),
																				ДатаПереоценки);
	ЭтоКлиентСНГ = (МассивСчетовСНГ.Найти(Объект.СчетДоверительногоУправления) <> Неопределено);
	
	МассивСчетовСАФМАР = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
																				ДатаПереоценки);
	ЭтоКлиентСАФМАР = (МассивСчетовСАФМАР.Найти(Объект.СчетДоверительногоУправления) <> Неопределено);
	
	МассивСчетовОПФ = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФОПФ"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
																				ДатаПереоценки);
	ЭтоКлиентОПФ = (МассивСчетовОПФ.Найти(Объект.СчетДоверительногоУправления) <> Неопределено);
	
	МассивСчетовФедерация = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Федерация"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
																				ДатаПереоценки);
	ЭтоКлиентФедерация = (МассивСчетовФедерация.Найти(Объект.СчетДоверительногоУправления) <> Неопределено);
	
	БанкротствоФинстоунаИАрчераПризнано = (НачалоДня(ДатаПереоценки) >= '20221031'); // все признали банкротство финстоуна и арчера с 31.10.22
	БанкротствоОткрытияПризнано = (НачалоДня(ДатаПереоценки) >= '20221117' ИЛИ НачалоДня(ДатаПереоценки) >= '20221031' И НЕ ЭтоКлиентСАФМАР); // все признали банкротство открытия с 31.10.22, а ДБ с 17.11.22
	
	// #361945 - по Облигация_О1_Груп_Финанс, Облигация_АрчерФинанс, Облигация_ОткрытиеХолдинг клиенты Телеком(с 10/2/21)
	// #361945 - по Облигация_ДП_О1ГрФин1P3, Облигация_АрчерФинанс, Облигация_ОткрытиеХолдинг клиенты Будущее(с 11/2/21)	
	// #389630 - по Облигация_АрчерФинанс,Облигация_Финстоун клиенты Эволюции(с 26/08/21) - исправлено, письмо получили 27го, поэтому с 27го 
	// #584222 - по Облигация_О1Пропертиз_Дол (О1 Пропертиз Финанс АО, 4B02-01-71827-H-001P, 1000.00 USD) клиенты Будущее и Эволюция(с 01/01/25)	
	БанкротствоАрчерФинансПризнано = НачалоДня(ДатаПереоценки) >= '20250101'
		ИЛИ ЭтоКлиентТелеком И НачалоДня(ДатаПереоценки) >= '20210210'
		ИЛИ ЭтоКлиентБудущее И НачалоДня(ДатаПереоценки) >= '20210211'
		ИЛИ ЭтоКлиентЭволюция И НачалоДня(ДатаПереоценки) >= '20210827';

	БанкротствоО1ГрупФинансПризнано = НачалоДня(ДатаПереоценки) >= '20250101'
		ИЛИ ЭтоКлиентТелеком И НачалоДня(ДатаПереоценки) >= '20210210';

	БанкротствоДПО1ГрупФинансПризнано = НачалоДня(ДатаПереоценки) >= '20250101'
		ИЛИ ЭтоКлиентБудущее И НачалоДня(ДатаПереоценки) >= '20210211';

	БанкротствоОткрытиеХолдингПризнано = НачалоДня(ДатаПереоценки) >= '20250101'
		ИЛИ ЭтоКлиентТелеком И НачалоДня(ДатаПереоценки) >= '20210210'
		ИЛИ ЭтоКлиентБудущее И НачалоДня(ДатаПереоценки) >= '20210211';

	БанкротствоФинстоунПризнано = НачалоДня(ДатаПереоценки) >= '20250101'
		ИЛИ ЭтоКлиентЭволюция И НачалоДня(ДатаПереоценки) >= '20210827';

	БанкротствоО1ПропертизПризнано = НачалоДня(ДатаПереоценки) >= '20250101';
	
	
	НужнаПерекурсовка = Документы.ПереоценкаВалютныхЦенностей.НужнаПерекурсовка(ДатаПереоценки, Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ВидУчета);
	НужнаИндексацияНоминала = БухгалтерскийУчет.НужнаИндексацияНоминала(ДатаПереоценки, Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ВидУчета);
	
	ПериодичностиДатыПереоценки = БухгалтерскийУчетЕПС.ПолучитьПериодичностиДаты(ДатаПереоценки);
	
	КалендарьДляСчетаДУ = ПолучитьКалендарьДляСчетаДУ(Объект.Организация, Объект.СчетДоверительногоУправления, ДатаПереоценки);
	РабочийДень			 = Справочники.Календари.ЭтоРабочийДень(КалендарьДляСчетаДУ, ДатаПереоценки);
	
	ТаблицаПриобретенияИРеализаций = Неопределено;
	ПараметрыОтбора = Новый Структура("ЦеннаяБумага,УчетныйАктивЕПС");
	
	ПроверятьФиксированныйКурс = (ТипЗнч(Объект) = Тип("ДокументОбъект.ПереоценкаЦенныхБумаг"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив КАК УчетныйАктив,
		|	НастройкиУчетаАктивовСрезПоследних.ПериодичностьПереоценки КАК ПериодичностьПереоценки,
		|	НастройкиУчетаАктивовСрезПоследних.ПереоцениватьВДеньОперации КАК ПереоцениватьВДеньОперации,
		|	НастройкиУчетаАктивовСрезПоследних.ПереоцениватьВНерабочиеДни КАК ПереоцениватьВНерабочиеДни,
		|	НастройкиУчетаАктивовСрезПоследних.ПериодичностьНачисленияПроцентныхДоходов КАК ПериодичностьНачисленияПроцентныхДоходов,
		|	НастройкиУчетаАктивовСрезПоследних.НачислятьПроцентныеДоходыВДеньОперации КАК НачислятьПроцентныеДоходыВДеньОперации,
		|	НастройкиУчетаАктивовСрезПоследних.НачислятьПроцентныеДоходыВНерабочиеДни КАК НачислятьПроцентныеДоходыВНерабочиеДни,
		|	НастройкиУчетаАктивовСрезПоследних.ПериодичностьНачисленияКорректировкиЭСП КАК ПериодичностьНачисленияКорректировкиЭСП,
		|	НастройкиУчетаАктивовСрезПоследних.НачислятьКорректировкуЭСПВДеньОперации КАК НачислятьКорректировкуЭСПВДеньОперации
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивовЕПС.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета) КАК НастройкиУчетаАктивовСрезПоследних
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив,
		|	НастройкиУчетаАктивовСрезПоследних.ПериодичностьПереоценки,
		|	НастройкиУчетаАктивовСрезПоследних.ПереоцениватьВДеньОперации,
		|	НастройкиУчетаАктивовСрезПоследних.ПереоцениватьВНерабочиеДни,
		|	НастройкиУчетаАктивовСрезПоследних.ПериодичностьНачисленияПроцентныхДоходов,
		|	НастройкиУчетаАктивовСрезПоследних.НачислятьПроцентныеДоходыВДеньОперации,
		|	НастройкиУчетаАктивовСрезПоследних.НачислятьПроцентныеДоходыВНерабочиеДни,
		|	НастройкиУчетаАктивовСрезПоследних.ПериодичностьНачисленияКорректировкиЭСП,
		|	НастройкиУчетаАктивовСрезПоследних.НачислятьКорректировкуЭСПВДеньОперации
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивовЕПС.СрезПоследних(
		|			ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, 1),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета) КАК НастройкиУчетаАктивовСрезПоследних
		|ГДЕ
		|	НастройкиУчетаАктивовСрезПоследних.ПериодичностьПереоценки <> ЗНАЧЕНИЕ(Перечисление.ПериодичностьПереоценкиАктивов.ПустаяСсылка)";

	Запрос.УстановитьПараметр("ВидУчета", Объект.ВидУчета);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Период", ДатаПереоценки);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);

	НастройкиУчета = Запрос.Выполнить().Выгрузить();
	
	НастройкиУчетаС = Новый Соответствие();
	Для каждого СтрокаНастройкиУчета Из НастройкиУчета Цикл
		НастройкиУчетаС.Вставить(
			СтрокаНастройкиУчета.УчетныйАктив,
			РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(СтрокаНастройкиУчета));
	КонецЦикла;
	
	КоличествоИндексовПереоценки = Объект.ЦенныеБумаги.Количество()-1;
	Для СЦ = -(КоличествоИндексовПереоценки) По 0 Цикл
		СтрокаЦенныеБумаги = Объект.ЦенныеБумаги.Получить(-СЦ);
		
		УчетныйАктив				= СтрокаЦенныеБумаги.УчетныйАктивЕПС;
		Переоценивать				= Ложь;
		НачислятьПроцентныеДоходы	= Ложь;
		НачислятьКорректировкуЭСП	= Ложь;
		
		ПериодичностьПереоценки		= Неопределено;
		ПереоцениватьВДеньОперации	= Ложь;
		ПереоцениватьВНерабочиеДни	= Ложь;
		
		ПериодичностьНачисленияПроцентныхДоходов	= Неопределено;
		ПериодичностьНачисленияКорректировкиЭСП		= Неопределено;
		НачислятьПроцентныеДоходыВДеньОперации		= Ложь;
		НачислятьПроцентныеДоходыВНерабочиеДни		= Ложь;
		
		НастройкиПереоценкиУчетногоАктива = НастройкиУчетаС[УчетныйАктив];
		
		Если НастройкиПереоценкиУчетногоАктива = Неопределено Тогда 			
			Если ТипЗнч(Объект) = Тип("Структура") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана периодичность переоценки для вида актива "+УчетныйАктив,,,, Отказ);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана периодичность переоценки для вида актива "+УчетныйАктив, Объект.Ссылка,,, Отказ);	
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
		Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			НастройкиПереоценкиУчетногоАктива.Вставить("НастройкиУчетаЦенныхБумаг", НастройкиПереоценкиЦенныхБумаг);
			НастройкиПереоценкиЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
				НастройкиПереоценкиУчетногоАктива,
				СтрокаЦенныеБумаги.ЦеннаяБумага,
				СтрокаЦенныеБумаги.УчетныйАктивЕПС,
				СтрокаЦенныеБумаги.Партия,
				СтрокаЦенныеБумаги.СтрокаПартии);
		Иначе
			НастройкиПереоценкиЦеннойБумаги = НастройкиПереоценкиУчетногоАктива;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НастройкиПереоценкиЦеннойБумаги.ПериодичностьПереоценки) Тогда
			Если ТипЗнч(Объект) = Тип("Структура") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана периодичность переоценки для вида актива "+УчетныйАктив,,,, Отказ);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана периодичность переоценки для вида актива "+УчетныйАктив, Объект.Ссылка,,, Отказ);
			КонецЕсли;
			
			Возврат;
		КонецЕсли;
		
		ПериодичностьПереоценки		= НастройкиПереоценкиЦеннойБумаги.ПериодичностьПереоценки;
		ПереоцениватьВДеньОперации	= НастройкиПереоценкиЦеннойБумаги.ПереоцениватьВДеньОперации;
		ПереоцениватьВНерабочиеДни	= НастройкиПереоценкиЦеннойБумаги.ПереоцениватьВНерабочиеДни;
		
		Если ПереоцениватьВДеньОперации Тогда
			
			Если ТаблицаПриобретенияиРеализаций = Неопределено Тогда
				ТаблицаПриобретенияИРеализаций = ПолучитьПриобретенияИРеализации(Объект, ДатаПереоценки, НастройкиУчетаОбщие);
			КонецЕсли;
			
			ПараметрыОтбора.ЦеннаяБумага 	= СтрокаЦенныеБумаги.ЦеннаяБумага;
			ПараметрыОтбора.УчетныйАктивЕПС = СтрокаЦенныеБумаги.УчетныйАктивЕПС;
			
			СтрокиПриобретенияИРеализаций = ТаблицаПриобретенияИРеализаций.НайтиСтроки(ПараметрыОтбора);
			
			Переоценивать = СтрокиПриобретенияИРеализаций.Количество() <> 0;
			
		КонецЕсли;
		
		Если НЕ Переоценивать Тогда
			Если ПериодичностьПереоценки = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
				Если ПериодичностиДатыПереоценки.ПериодичностьМесяц Тогда
				    Переоценивать = Истина;
				ИначеЕсли РабочийДень Тогда
					Переоценивать = Истина;
				ИначеЕсли ПереоцениватьВНерабочиеДни Тогда
					Переоценивать = Истина;
				КонецЕсли;
			Иначе
				Переоценивать = БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьПереоценки, ДатаПереоценки, Справочники.Календари.Общероссийский);
			КонецЕсли;
		КонецЕсли;
		
		Если Не Переоценивать И СообщенияОбОценочнойСтоимости <> Неопределено Тогда
			ТекстСообщения = "Не определена цена переоценки для ЦБ " + Строка(СтрокаЦенныеБумаги.ЦеннаяБумага)+" на "+ДатаПереоценки;
			ЭлементСообщения = СообщенияОбОценочнойСтоимости.НайтиПоЗначению(ТекстСообщения);
			Если ЭлементСообщения <> Неопределено Тогда
				СообщенияОбОценочнойСтоимости.Удалить(ЭлементСообщения);
			КонецЕсли;
		КонецЕсли;

		Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
			СтрокаЦенныеБумаги.Перекурсовать = Ложь;
		ИначеЕсли СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала = ВалютаУчета Тогда
			СтрокаЦенныеБумаги.Перекурсовать = Ложь;
		ИначеЕсли Переоценивать Тогда
			СтрокаЦенныеБумаги.Перекурсовать = Истина;
		Иначе
			СтрокаЦенныеБумаги.Перекурсовать = НужнаПерекурсовка;
		КонецЕсли;

		Если УдалятьЛишниеСтроки И Не Переоценивать И НЕ СтрокаЦенныеБумаги.Перекурсовать И НЕ СтрокаЦенныеБумаги.ИндексироватьНоминал Тогда
			Объект.ЦенныеБумаги.Удалить(-СЦ);
		ИначеЕсли Не Переоценивать Тогда
			СтрокаЦенныеБумаги.ОценочнаяЦена        = СтрокаЦенныеБумаги.БалансоваяЦена;
			СтрокаЦенныеБумаги.ОценочнаяЦенаПроцент = СтрокаЦенныеБумаги.БалансоваяЦенаПроцент;
			СтрокаЦенныеБумаги.ПолеЦены   = Перечисления.ИсточникиЦеныДляПереоценки.БалансоваяЦена;
			СтрокаЦенныеБумаги.ОценочнаяСумма = СтрокаЦенныеБумаги.БалансоваяСумма;
			СтрокаЦенныеБумаги.ОценочнаяСуммаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаВВалютеУчета;
		КонецЕсли;
		
		Если СтрокаЦенныеБумаги.Рынок <> Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НастройкиПереоценкиЦеннойБумаги.ПериодичностьНачисленияПроцентныхДоходов) Тогда
			
			Если ТипЗнч(Объект) = Тип("Структура") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана периодичность начисления процентных доходов для вида актива "+УчетныйАктив,,,, Отказ);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана периодичность начисления процентных доходов для вида актива "+УчетныйАктив, Объект.Ссылка,,, Отказ);
			КонецЕсли;
			
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НастройкиПереоценкиЦеннойБумаги.ПериодичностьНачисленияКорректировкиЭСП) Тогда
			
			Если ТипЗнч(Объект) = Тип("Структура") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана периодичность начисления корректировки ЭСП для вида актива "+УчетныйАктив,,,, Отказ);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана периодичность начисления корректировки ЭСП для вида актива "+УчетныйАктив, Объект.Ссылка,,, Отказ);
			КонецЕсли;
			
			Возврат;
		КонецЕсли;
		
		ПериодичностьНачисленияПроцентныхДоходов	= НастройкиПереоценкиЦеннойБумаги.ПериодичностьНачисленияПроцентныхДоходов;
		НачислятьПроцентныеДоходыВДеньОперации		= НастройкиПереоценкиЦеннойБумаги.НачислятьПроцентныеДоходыВДеньОперации;
		НачислятьПроцентныеДоходыВНерабочиеДни		= НастройкиПереоценкиЦеннойБумаги.НачислятьПроцентныеДоходыВНерабочиеДни;
		
		ПериодичностьНачисленияКорректировкиЭСП		= НастройкиПереоценкиЦеннойБумаги.ПериодичностьНачисленияКорректировкиЭСП;
		НачислятьКорректировкиЭСПВДеньОперации		= НастройкиПереоценкиЦеннойБумаги.НачислятьКорректировкуЭСПВДеньОперации;
		НачислятьКорректировкиЭСПВНерабочиеДни		= НачислятьПроцентныеДоходыВНерабочиеДни; // вообще так правильно: они должны идти синхронно, но я позже почитаю законы еще
		
		Если НачислятьПроцентныеДоходыВДеньОперации Тогда
			
			Если ТаблицаПриобретенияиРеализаций = Неопределено Тогда
				ТаблицаПриобретенияИРеализаций = ПолучитьПриобретенияИРеализации(Объект, ДатаПереоценки, НастройкиУчетаОбщие);
			КонецЕсли;
			
			ПараметрыОтбора.ЦеннаяБумага 	= СтрокаЦенныеБумаги.ЦеннаяБумага;
			ПараметрыОтбора.УчетныйАктивЕПС = СтрокаЦенныеБумаги.УчетныйАктивЕПС;
			
			СтрокиПриобретенияИРеализаций = ТаблицаПриобретенияИРеализаций.НайтиСтроки(ПараметрыОтбора);
			
			НачислятьПроцентныеДоходы = СтрокиПриобретенияИРеализаций.Количество() <> 0;
			
		КонецЕсли;
		
		Если НачислятьКорректировкиЭСПВДеньОперации Тогда
			
			Если ТаблицаПриобретенияиРеализаций = Неопределено Тогда
				ТаблицаПриобретенияИРеализаций = ПолучитьПриобретенияИРеализации(Объект, ДатаПереоценки, НастройкиУчетаОбщие);
			КонецЕсли;
			
			ПараметрыОтбора.ЦеннаяБумага 	= СтрокаЦенныеБумаги.ЦеннаяБумага;
			ПараметрыОтбора.УчетныйАктивЕПС = СтрокаЦенныеБумаги.УчетныйАктивЕПС;
			
			СтрокиПриобретенияИРеализаций = ТаблицаПриобретенияИРеализаций.НайтиСтроки(ПараметрыОтбора);
			
			НачислятьКорректировкуЭСП = СтрокиПриобретенияИРеализаций.Количество() <> 0;
			
		КонецЕсли;
		
		Если НЕ НачислятьПроцентныеДоходы Тогда
			Если ПериодичностьНачисленияПроцентныхДоходов = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
				Если ПериодичностиДатыПереоценки.ПериодичностьМесяц Тогда
				    НачислятьПроцентныеДоходы = Истина;
				ИначеЕсли РабочийДень Тогда
					НачислятьПроцентныеДоходы = Истина;
				ИначеЕсли НачислятьПроцентныеДоходыВНерабочиеДни Тогда
					НачислятьПроцентныеДоходы = Истина;
				КонецЕсли;
			Иначе
				НачислятьПроцентныеДоходы = БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьНачисленияПроцентныхДоходов, ДатаПереоценки, Справочники.Календари.Общероссийский);
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ НачислятьКорректировкуЭСП Тогда
			Если ПериодичностьНачисленияКорректировкиЭСП = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
				Если ПериодичностиДатыПереоценки.ПериодичностьМесяц Тогда
				    НачислятьКорректировкуЭСП = Истина;
				ИначеЕсли РабочийДень Тогда
					НачислятьКорректировкуЭСП = Истина;
				ИначеЕсли НачислятьКорректировкиЭСПВНерабочиеДни Тогда
					НачислятьКорректировкуЭСП = Истина;
				КонецЕсли;
			Иначе
				НачислятьКорректировкуЭСП = БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьНачисленияКорректировкиЭСП, ДатаПереоценки, Справочники.Календари.Общероссийский);
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтоКлиентСАФМАР Тогда // в эти дни по этим бумагам прошли оферту
			
			Если НачалоДня(ДатаПереоценки) = '20230419' И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_МОЭК_ПАО_002")
				ИЛИ НачалоДня(ДатаПереоценки) = '20230427' И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Роснефть_004_01")
				ИЛИ НачалоДня(ДатаПереоценки) = '20230501' И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ПочтаРоссииАО_004")
				ИЛИ НачалоДня(ДатаПереоценки) = '20230501' И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ПочтаРоссииАО_005")
				ИЛИ НачалоДня(ДатаПереоценки) = '20230526' И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ИНГРАДПАО_003")
				ИЛИ НачалоДня(ДатаПереоценки) = '20230530' И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_РЖД_001") Тогда
			
				НачислятьКорректировкуЭСП = Истина;
			
			КонецЕсли;
			
		ИначеЕсли ЭтоКлиентОПФ ИЛИ ЭтоКлиентФедерация Тогда 
			
			Если НачалоДня(ДатаПереоценки) = '20230427' И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Роснефть_004_01")
				ИЛИ НачалоДня(ДатаПереоценки) = '20230627' И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Икс5_Финанс_012")
			Тогда
			
				НачислятьКорректировкуЭСП = Истина;
			
			КонецЕсли;
			
		КонецЕсли;
		
		// #427893 - настройка, чтобы в день ввода не считать дисконт премию, чтобы копейки не лезли
		НастройкиУчетаБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
			НастройкиУчетаОбщие,
			СтрокаЦенныеБумаги.ЦеннаяБумага,
			СтрокаЦенныеБумаги.УчетныйАктивЕПС,
			СтрокаЦенныеБумаги.Партия,
			СтрокаЦенныеБумаги.СтрокаПартии);
		
		Если НачислятьПроцентныеДоходы И НастройкиУчетаБумаги.НеРассчитыватьДисконтПремиюВДеньВвода Тогда
			Если ТипЗнч(СтрокаЦенныеБумаги.Партия) = Тип("ДокументСсылка.ВводЦенныхБумаг") И НачалоДня(СтрокаЦенныеБумаги.Партия.Дата) = НачалоДня(ДатаПереоценки) Тогда
				НачислятьПроцентныеДоходы = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаЦенныеБумаги.ИндексироватьНоминал = Ложь;
		Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			Если СтрокаЦенныеБумаги.ЦеннаяБумага.ИндексируемыйНоминал И НачислятьПроцентныеДоходы Тогда //И НужнаПерекурсовка Тогда
				СтрокаЦенныеБумаги.ИндексироватьНоминал = НужнаИндексацияНоминала;
			КонецЕсли;
		КонецЕсли;
		
		Если Не НачислятьПроцентныеДоходы Тогда
		
			СтрокаЦенныеБумаги.ОценочныеДисконтПремия = СтрокаЦенныеБумаги.БалансовыеДисконтПремия;
			СтрокаЦенныеБумаги.ОценочныеДисконтПремияВВалютеУчета = СтрокаЦенныеБумаги.БалансовыеДисконтПремияВВалютеУчета;
			
			Если НЕ ПериодичностиДатыПереоценки.ПериодичностьМесяц Тогда
				СтрокаЦенныеБумаги.ОценочнаяЦенаКупона  = СтрокаЦенныеБумаги.БалансоваяЦенаКупона;
				СтрокаЦенныеБумаги.ОценочнаяСуммаКупона = СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
				СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;
			КонецЕсли;
			
			Если ПериодичностьНачисленияПроцентныхДоходов = Перечисления.ПериодичностьПереоценкиАктивов.ЕжемесячноВПоследнийРабочийДень 
				И ПериодичностиДатыПереоценки.ПериодичностьМесяц Тогда
				СтрокаЦенныеБумаги.ОценочнаяЦенаКупона  = СтрокаЦенныеБумаги.БалансоваяЦенаКупона;
				СтрокаЦенныеБумаги.ОценочнаяСуммаКупона = СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
				СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;				
			КонецЕсли;
			
		КонецЕсли;
		
		// хардкод для бущего пн
		// только концы кварталов
		// с 1/1/21 - концы месяцев
		Если Объект.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN084") Тогда
			Если (КонецМесяца(ДатаПереоценки) <> КонецДня(ДатаПереоценки) И ДатаПереоценки >= '20210101'
				ИЛИ КонецКвартала(ДатаПереоценки) <> КонецДня(ДатаПереоценки) И ДатаПереоценки < '20210101')
				И НЕ (СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ДП_Роснфт2P7") И ДатаПереоценки = '20240329')
			Тогда
				СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанные = СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанные;
				СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанныеВВалютеУчета;
			КонецЕсли;
		КонецЕсли;		
		
		
		Если Не НачислятьКорректировкуЭСП Тогда
		
			СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСП = СтрокаЦенныеБумаги.БалансоваяКорректировкаЭСП;
			СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСПВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяКорректировкаЭСПВВалютеУчета;
			
			СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанные = СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанные;
			СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанныеВВалютеУчета;
			
		КонецЕсли;
		
       // хардкод для банкрота прайма
       // с 13.09.2019 не переоцениваем купон
       Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И НачалоДня(ДатаПереоценки) >= '20190913' Тогда
		   Если СтрокаЦенныеБумаги.ЦеннаяБумага.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Эмитент_Прайм") Тогда
			   
				СтрокаЦенныеБумаги.ОценочнаяЦенаКупона  = СтрокаЦенныеБумаги.БалансоваяЦенаКупона;
				СтрокаЦенныеБумаги.ОценочнаяСуммаКупона = СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
				СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;
				
				СтрокаЦенныеБумаги.ОценочныеДисконтПремия = СтрокаЦенныеБумаги.БалансовыеДисконтПремия;
				СтрокаЦенныеБумаги.ОценочныеДисконтПремияВВалютеУчета = СтрокаЦенныеБумаги.БалансовыеДисконтПремияВВалютеУчета;
				
				СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСП = СтрокаЦенныеБумаги.БалансоваяКорректировкаЭСП;
				СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСПВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяКорректировкаЭСПВВалютеУчета;
				СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанные = СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанные;
				СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанныеВВалютеУчета;
				
           КонецЕсли;
       КонецЕсли;
	   
       // хардкод для банкротов Открытие, Арчер и Финстойн
       // с 31.10.2022 не переоцениваем ничего
	   Если НЕ Переоценивать
		   И ((СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финстоун") И БанкротствоФинстоунаИАрчераПризнано)
			   ИЛИ (СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_АрчерФинанс") И БанкротствоФинстоунаИАрчераПризнано)
			   ИЛИ (СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОткрытиеХолдинг") И БанкротствоОткрытияПризнано)
			   ИЛИ (СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОткрХолдинг_004") И БанкротствоОткрытияПризнано)) Тогда
		   
			СтрокаЦенныеБумаги.ОценочнаяЦенаКупона  = СтрокаЦенныеБумаги.БалансоваяЦенаКупона;
			СтрокаЦенныеБумаги.ОценочнаяСуммаКупона = СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
			СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;
			
			СтрокаЦенныеБумаги.ОценочныеДисконтПремия = СтрокаЦенныеБумаги.БалансовыеДисконтПремия;
			СтрокаЦенныеБумаги.ОценочныеДисконтПремияВВалютеУчета = СтрокаЦенныеБумаги.БалансовыеДисконтПремияВВалютеУчета;
			
			СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСП = СтрокаЦенныеБумаги.БалансоваяКорректировкаЭСП;
			СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСПВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяКорректировкаЭСПВВалютеУчета;
			СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанные = СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанные;
			СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанныеВВалютеУчета;
			
			Переоценивать = Ложь;
       КонецЕсли;
	   
       // хардкод для банкрота вейла
       
	   Если СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВейлФинанс") Тогда
		    // с 31.12.2022 у Эволюции купон списан и равен 0, Будущее пока банкроство не признало
       		Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И НачалоДня(ДатаПереоценки) >= '20221231' И ЭтоКлиентЭволюция Тогда
		   
				СтрокаЦенныеБумаги.ОценочнаяЦенаКупона  = 0;
				СтрокаЦенныеБумаги.ОценочнаяСуммаКупона = 0;
				СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета = 0;
		    // Будущее пока банкроство не признало, просто с даты погашения - 08.03.2023 зафиксировало все части стоимости
			ИначеЕсли СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И НачалоДня(ДатаПереоценки) >= '20230308' И ЭтоКлиентБудущее Тогда
				
				СтрокаЦенныеБумаги.ОценочныеДисконтПремия = СтрокаЦенныеБумаги.БалансовыеДисконтПремия;
				СтрокаЦенныеБумаги.ОценочныеДисконтПремияВВалютеУчета = СтрокаЦенныеБумаги.БалансовыеДисконтПремияВВалютеУчета;
				
				СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСП = СтрокаЦенныеБумаги.БалансоваяКорректировкаЭСП;
				СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСПВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяКорректировкаЭСПВВалютеУчета;
				СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанные = СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанные;
				СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанныеВВалютеУчета;
				
				Переоценивать = Ложь;
				
			КонецЕсли;
       КонецЕсли;
	   
	   //Отключили расчет НКД
	   Если БанкротствоАрчерФинансПризнано И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_АрчерФинанс")
		   ИЛИ БанкротствоО1ГрупФинансПризнано И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1_Груп_Финанс")  
		   ИЛИ БанкротствоОткрытиеХолдингПризнано И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОткрытиеХолдинг")
		   ИЛИ БанкротствоДПО1ГрупФинансПризнано И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ДП_О1ГрФин1P3") 
		   ИЛИ БанкротствоФинстоунПризнано И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финстоун")
		   ИЛИ БанкротствоО1ПропертизПризнано И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1Пропертиз_Дол") Тогда 
		   
		   СтрокаЦенныеБумаги.ОценочнаяЦенаКупона  = СтрокаЦенныеБумаги.БалансоваяЦенаКупона;
		   СтрокаЦенныеБумаги.ОценочнаяСуммаКупона = СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
		   СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;
		   
		КонецЕсли;
		   
	   ФиксированныйКурс = Ложь;
	   Если ПроверятьФиксированныйКурс
		   И СтрокаЦенныеБумаги.КурсВалютыНоминала <> 0
		   И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финстандарт") // пока только по нему, остальные хоть и по фикс.курсу немного курсуются
	   Тогда
			   
			ФиксированныйКурс = Истина;
	   
	   КонецЕсли;
	   
		Если СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала = ВалютаУчета Тогда
			СтрокаЦенныеБумаги.Перекурсовать = Ложь;
		ИначеЕсли СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
			СтрокаЦенныеБумаги.Перекурсовать = Ложь;
		ИначеЕсли Переоценивать ИЛИ НачислятьПроцентныеДоходы Тогда
			СтрокаЦенныеБумаги.Перекурсовать = НЕ ФиксированныйКурс;
		Иначе
			СтрокаЦенныеБумаги.Перекурсовать = НужнаПерекурсовка;
		КонецЕсли;
	   
	   // По задаче #424568 СНГ отказывается от переоценки, но по последнему разъяснению: бумаги с индексацией нужно переоценивать на сумму индексации
	   Если ЭтоКлиентСНГ 
		   И ДатаПереоценки >= '20220310' 
		   И ДатаПереоценки < '20221230'
		   И СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации
		   И СтрокаЦенныеБумаги.ЦеннаяБумага.ИндексируемыйНоминал
		   И ТипЗнч(СтрокаЦенныеБумаги.Партия) <> Тип("ДокументСсылка.СделкаРЕПО")
		   И (РабочийДень ИЛИ ПериодичностиДатыПереоценки.ПериодичностьМесяц) Тогда
	   
	   	   Переоценивать = Истина;
	   
	   КонецЕсли;
	   
	   Если УдалятьЛишниеСтроки И Не Переоценивать И НЕ СтрокаЦенныеБумаги.Перекурсовать И НЕ СтрокаЦенныеБумаги.ИндексироватьНоминал Тогда
		   Объект.ЦенныеБумаги.Удалить(-СЦ);
	   ИначеЕсли Не Переоценивать Тогда
		   СтрокаЦенныеБумаги.ОценочнаяЦена        = СтрокаЦенныеБумаги.БалансоваяЦена;
		   СтрокаЦенныеБумаги.ОценочнаяЦенаПроцент = СтрокаЦенныеБумаги.БалансоваяЦенаПроцент;
		   СтрокаЦенныеБумаги.ПолеЦены   = Перечисления.ИсточникиЦеныДляПереоценки.БалансоваяЦена;
		   СтрокаЦенныеБумаги.ОценочнаяСумма = СтрокаЦенныеБумаги.БалансоваяСумма;
		   СтрокаЦенныеБумаги.ОценочнаяСуммаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаВВалютеУчета;
		   
		   Если НастройкиУчетаОбщие.ВключатьПроцентныеДоходыИКорректировкиВБалансовуюСтоимостьПриПереоценке Тогда
			   
			   СтрокаЦенныеБумаги.ОценочнаяСумма = СтрокаЦенныеБумаги.БалансоваяСумма + СтрокаЦенныеБумаги.ОценочныеДисконтПремия + СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСП;
			   СтрокаЦенныеБумаги.ОценочнаяСуммаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаВВалютеУчета + СтрокаЦенныеБумаги.ОценочныеДисконтПремияВВалютеУчета + СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСПВВалютеУчета;
			   
		   Иначе
			   
			   СтрокаЦенныеБумаги.ОценочнаяСумма = СтрокаЦенныеБумаги.БалансоваяСумма + Макс(СтрокаЦенныеБумаги.НачальныеДисконтПремия, 0);
			   СтрокаЦенныеБумаги.ОценочнаяСуммаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаВВалютеУчета + РаботаСВалютами.ПолучитьСуммуВВалютеУчета(Макс(СтрокаЦенныеБумаги.НачальныеДисконтПремия, 0), СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала, Объект.Организация, Объект.Дата, Отказ);
			   
		   КонецЕсли;
		   
	   КонецЕсли;
	   
		// хардкод для финстандарта
		// после полного погашения 22.05.2020 он лежит на балансе и не меняется
		Если СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финстандарт")
			И НачалоДня(ДатаПереоценки) > '20200522' Тогда
		
			СтрокаЦенныеБумаги.ОценочныеДисконтПремияВВалютеУчета = СтрокаЦенныеБумаги.БалансовыеДисконтПремияВВалютеУчета;
		
		КонецЕсли;
	   
	КонецЦикла;

КонецПроцедуры

Процедура ПрименитьПолитикуУчета(Объект, УдалятьЛишниеСтроки = Ложь, СообщенияОбОценочнойСтоимости = Неопределено, ВалютаУчета,  Отказ) Экспорт

	Если Объект.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		ПрименитьПолитикуУчетаЕПС(Объект, УдалятьЛишниеСтроки,  СообщенияОбОценочнойСтоимости, ВалютаУчета, Отказ);
		Возврат
	КонецЕсли;
	ДатаПереоценки = НачалоДня(Объект.Дата);
	
	
	МассивСчетовБудущего = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_БУДУЩЕЕ"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
																				ДатаПереоценки);
	ЭтоКлиентБудущее = (МассивСчетовБудущего.Найти(Объект.СчетДоверительногоУправления) <> Неопределено);
	
	
	МассивСчетовЭволюции = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Эволюция"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
																				ДатаПереоценки);
	ЭтоКлиентЭволюция = (МассивСчетовЭволюции.Найти(Объект.СчетДоверительногоУправления) <> Неопределено);
	
	МассивСчетовТелеком = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_ТелекомСоюз"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
																				ДатаПереоценки);
	ЭтоКлиентТелеком = (МассивСчетовТелеком.Найти(Объект.СчетДоверительногоУправления) <> Неопределено);
	
	МассивСчетовСАФМАР = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
																				ДатаПереоценки);
	ЭтоКлиентСАФМАР = (МассивСчетовСАФМАР.Найти(Объект.СчетДоверительногоУправления) <> Неопределено);
	
	// хардкод для банкротов Открытие, Арчер и Финстойн
	// с 31.10.2022 не переоцениваем ничего
	// все признали банкротство финстоуна и арчера с 31.10.22
	БанкротствоФинстоунаИАрчераПризнано = (НачалоДня(ДатаПереоценки) >= '20221031'); 
	// все признали банкротство открытия с 31.10.22, а ДБ с 17.11.22
	БанкротствоОткрытияПризнано = (НачалоДня(ДатаПереоценки) >= '20221117' ИЛИ НачалоДня(ДатаПереоценки) >= '20221031' И НЕ ЭтоКлиентСАФМАР);

	// в 2025 запланированы переводы бумаг, поэтому распространяем хардкоды на всё
	// #477507 - по Облигациям О1_Груп_Финанс клиенты Телеком и Будущее (с 31/03/23) не переоценивают купон
	БанкротствоО1ГрупФинансПризнано = НачалоДня(ДатаПереоценки) >= '20250101' ИЛИ ЭтоКлиентТелеком И НачалоДня(ДатаПереоценки) >= '20230331';
	БанкротствоДПО1ГрупФинансПризнано = НачалоДня(ДатаПереоценки) >= '20250101' ИЛИ ЭтоКлиентБудущее И НачалоДня(ДатаПереоценки) >= '20230331';
	// #584222 - по Облигация_О1Пропертиз_Дол (О1 Пропертиз Финанс АО, 4B02-01-71827-H-001P, 1000.00 USD) клиенты Будущее и Эволюция(с 01/01/25)	
	БанкротствоО1ПропертизПризнано = НачалоДня(ДатаПереоценки) >= '20250101' ИЛИ (ЭтоКлиентБудущее ИЛИ ЭтоКлиентЭволюция) И НачалоДня(ДатаПереоценки) >= '20250101';
	
	
	ПериодичностиДатыПереоценки = БухгалтерскийУчетЕПС.ПолучитьПериодичностиДаты(ДатаПереоценки);

	КалендарьДляСчетаДУ = ПолучитьКалендарьДляСчетаДУ(Объект.Организация, Объект.СчетДоверительногоУправления, ДатаПереоценки);
	РабочийДень			 = Справочники.Календари.ЭтоРабочийДень(КалендарьДляСчетаДУ, ДатаПереоценки);
	
	НастройкаПериодичностиПереоценки = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктивов(ДатаПереоценки, Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ВидУчета, "ПериодичностьПереоценки");
	НастройкаПереоценкиВНерабочиеДни = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктивов(ДатаПереоценки, Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ВидУчета, "ПереоцениватьВНерабочиеДни");
	НастройкаПереоцениватьВДеньОперации = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктивов(ДатаПереоценки, Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ВидУчета, "ПереоцениватьВДеньОперации");
	
	НужнаПерекурсовка = Документы.ПереоценкаВалютныхЦенностей.НужнаПерекурсовка(ДатаПереоценки, Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ВидУчета);
	НужнаИндексацияНоминала = БухгалтерскийУчет.НужнаИндексацияНоминала(ДатаПереоценки, Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ВидУчета);
	
	ПерекурсовыватьВДеньОперации = 	БухгалтерскийУчет.НужнаПерекурсовкаВДатуОперации(ДатаПереоценки, Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ВидУчета);
	ТаблицаПриобретенияИРеализаций = Неопределено;
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(ДатаПереоценки, Объект.Организация, Объект.СчетДоверительногоУправления);
	
	КоличествоИндексовПереоценки = Объект.ЦенныеБумаги.Количество()-1;
	Для СЦ = -(КоличествоИндексовПереоценки) По 0 Цикл
		СтрокаЦенныеБумаги = Объект.ЦенныеБумаги.Получить(-СЦ);
		
		УчетныйАктив      = БухгалтерскийУчет.ОпределитьУчетныйАктив(Объект.Дата, СтрокаЦенныеБумаги.Рынок, СтрокаЦенныеБумаги.ЦеннаяБумага);
		УчетныйАктивКупон = БухгалтерскийУчет.ОпределитьУчетныйАктив(Объект.Дата, СтрокаЦенныеБумаги.Рынок, СтрокаЦенныеБумаги.ЦеннаяБумага, Истина);
		ИмяУчетногоАктива = УчетныйАктив.ИмяПредопределенныхДанных;
		ИмяУчетногоАктиваКупона = УчетныйАктивКупон.ИмяПредопределенныхДанных;
		
		ПериодичностьПереоценки       = НастройкаПериодичностиПереоценки[ИмяУчетногоАктива];
		ПериодичностьПереоценкиКупона = НастройкаПериодичностиПереоценки[ИмяУчетногоАктиваКупона];
		
		ПереоцениватьВНерабочиеДни		= НастройкаПереоценкиВНерабочиеДни[ИмяУчетногоАктива];
		ПереоцениватьВНерабочиеДниКупон	= НастройкаПереоценкиВНерабочиеДни[ИмяУчетногоАктиваКупона];
		
		ПереоцениватьВДеньОперации	= НастройкаПереоцениватьВДеньОперации[ИмяУчетногоАктива];
		
		Переоценивать				= Ложь;
		Если ПереоцениватьВДеньОперации Тогда
			
			Если ТаблицаПриобретенияиРеализаций = Неопределено Тогда
				ТаблицаПриобретенияИРеализаций = ПолучитьПриобретенияИРеализации(Объект, ДатаПереоценки, НастройкиУчетаОбщие);
			КонецЕсли;
			
			СтрокиПриобретенияИРеализаций = ТаблицаПриобретенияИРеализаций.НайтиСтроки(Новый Структура("ЦеннаяБумага", СтрокаЦенныеБумаги.ЦеннаяБумага));
			
			Переоценивать = СтрокиПриобретенияИРеализаций.Количество() <> 0;
			
		КонецЕсли;
		
		Если НЕ Переоценивать Тогда
		
			Если ПериодичностьПереоценки = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
				Если ПериодичностиДатыПереоценки.ПериодичностьМесяц Тогда
				    Переоценивать = Истина;
				ИначеЕсли РабочийДень Тогда
					Переоценивать = Истина;
				ИначеЕсли ПереоцениватьВНерабочиеДни Тогда
					Переоценивать = Истина;
				КонецЕсли;
			Иначе
				Переоценивать = БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьПереоценки, ДатаПереоценки, Справочники.Календари.Общероссийский);
			КонецЕсли;
		
		КонецЕсли;

		ПереоцениватьКупон = Ложь;
		Если ПериодичностьПереоценкиКупона = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
			Если ПериодичностиДатыПереоценки.ПериодичностьМесяц Тогда
			    ПереоцениватьКупон = Истина;
			ИначеЕсли РабочийДень Тогда
				ПереоцениватьКупон = Истина;
			ИначеЕсли ПереоцениватьВНерабочиеДниКупон Тогда
				ПереоцениватьКупон = Истина;
			КонецЕсли;
		Иначе
			ПереоцениватьКупон = БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьПереоценкиКупона, ДатаПереоценки, Справочники.Календари.Общероссийский);
		КонецЕсли;
		
		Если СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала = ВалютаУчета Тогда
			СтрокаЦенныеБумаги.Перекурсовать = Ложь;
		ИначеЕсли СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
			СтрокаЦенныеБумаги.Перекурсовать = Ложь;
		ИначеЕсли Переоценивать ИЛИ ПереоцениватьКупон Тогда
			СтрокаЦенныеБумаги.Перекурсовать = Истина;
		Иначе
			Если НЕ НужнаПерекурсовка Тогда
			
				Если ПерекурсовыватьВДеньОперации Тогда
					
					Если ТаблицаПриобретенияиРеализаций = Неопределено Тогда
						ТаблицаПриобретенияИРеализаций = ПолучитьПриобретенияИРеализации(Объект, ДатаПереоценки, НастройкиУчетаОбщие);
						ПараметрыОтбораДляПерекурсовки = Новый Структура("ЦеннаяБумага", СтрокаЦенныеБумаги.ЦеннаяБумага);
					КонецЕсли;
					
					ПараметрыОтбораДляПерекурсовки.ЦеннаяБумага 	= СтрокаЦенныеБумаги.ЦеннаяБумага;
					
					СтрокиПриобретенияИРеализаций = ТаблицаПриобретенияИРеализаций.НайтиСтроки(ПараметрыОтбораДляПерекурсовки);
					
					СтрокаЦенныеБумаги.Перекурсовать = СтрокиПриобретенияИРеализаций.Количество() <> 0;
					
				КонецЕсли;
			Иначе			
				СтрокаЦенныеБумаги.Перекурсовать = НужнаПерекурсовка;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаЦенныеБумаги.ИндексироватьНоминал = Ложь;
		Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			Если СтрокаЦенныеБумаги.ЦеннаяБумага.ИндексируемыйНоминал Тогда
				СтрокаЦенныеБумаги.ИндексироватьНоминал = НужнаИндексацияНоминала;
			КонецЕсли;
		КонецЕсли;
		
		Если УдалятьЛишниеСтроки И Не Переоценивать И Не ПереоцениватьКупон И НЕ СтрокаЦенныеБумаги.Перекурсовать И НЕ СтрокаЦенныеБумаги.ИндексироватьНоминал Тогда
			Объект.ЦенныеБумаги.Удалить(-СЦ);
			Продолжить;
		КонецЕсли;
		
		Если Не Переоценивать Тогда
			СтрокаЦенныеБумаги.ОценочнаяЦена        = СтрокаЦенныеБумаги.БалансоваяЦена;
			СтрокаЦенныеБумаги.ОценочнаяЦенаПроцент = СтрокаЦенныеБумаги.БалансоваяЦенаПроцент;
			
			СтрокаЦенныеБумаги.ПолеЦены   = Перечисления.ИсточникиЦеныДляПереоценки.БалансоваяЦена;
			СтрокаЦенныеБумаги.ОценочнаяСумма = СтрокаЦенныеБумаги.БалансоваяСумма;
			Если СтрокаЦенныеБумаги.Перекурсовать И Объект.ВидУчета <> Перечисления.ВидыУчета.НалоговыйУчет Тогда
				СтрокаЦенныеБумаги.ОценочнаяСуммаВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.БалансоваяСумма,СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала, Объект.Организация, Объект.Дата, Отказ);
			Иначе
				СтрокаЦенныеБумаги.ОценочнаяСуммаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаВВалютеУчета;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ПереоцениватьКупон Тогда
			СтрокаЦенныеБумаги.ОценочнаяЦенаКупона  = СтрокаЦенныеБумаги.БалансоваяЦенаКупона;
			Если СтрокаЦенныеБумаги.Перекурсовать Тогда
				Если Объект.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
					
					УчитыватьПереоценкуОтдельноКупон = Истина;
					
					СуммаПереоценкиКупона 				= СтрокаЦенныеБумаги.ОценочнаяСуммаКупона - СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
					Если СуммаПереоценкиКупона = 0 Тогда
						БалансоваяСуммаКупонаПоТекущемуКурсу =  СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета;
					Иначе
						БалансоваяСуммаКупонаПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.БалансоваяСуммаКупона, СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала, Объект.Организация, Объект.Дата, Отказ), 2);
					КонецЕсли;
					КурсоваяРазницаКупона = БалансоваяСуммаКупонаПоТекущемуКурсу - СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;
					СуммаПереоценкиКупонаВВалютеУчета 	= СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета - СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета - КурсоваяРазницаКупона;
					Если НЕ УчитыватьПереоценкуОтдельноКупон Тогда
						СуммаКурсовойРазницыПереоценкиКупона = 0;
					Иначе
						СуммаКурсовойРазницыПереоценкиКупона = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.ПереоценкаКупона, СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала, Объект.Организация, Объект.Дата, Отказ), 2)
						 - СтрокаЦенныеБумаги.ПереоценкаКупонаВВалютеУчета;
					КонецЕсли;
					СуммаКурсовойРазницыКупона = КурсоваяРазницаКупона - СуммаКурсовойРазницыПереоценкиКупона;
					Если СтрокаЦенныеБумаги.БалансоваяСуммаКупона = СтрокаЦенныеБумаги.ПереоценкаКупона Тогда 
						//купон при покупке погашен, все валим на переоценку купона
						СуммаКурсовойРазницыПереоценкиКупона = СуммаКурсовойРазницыПереоценкиКупона + СуммаКурсовойРазницыКупона;
						СуммаКурсовойРазницыКупона = 0;
					КонецЕсли;
					Если Объект.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда	
						//Уплаченный НКД в НУ не переоценивается
						СуммаКурсовойРазницыКупона = 0;
					КонецЕсли;	
						
					СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета  
						+ СуммаКурсовойРазницыПереоценкиКупона;
					
					СтрокаЦенныеБумаги.ОценочнаяСуммаКупона = СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
						
				Иначе
					СтрокаЦенныеБумаги.ОценочнаяСуммаКупона = СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
					СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.ОценочнаяСуммаКупона,СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала, Объект.Организация, Объект.Дата, Отказ);
				КонецЕсли;
			Иначе
				СтрокаЦенныеБумаги.ОценочнаяСуммаКупона = СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
				СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;
			КонецЕсли;
		Иначе
			Если Объект.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
				
				УчитыватьПереоценкуОтдельноКупон = Истина;
				
				СуммаПереоценкиКупона 				= СтрокаЦенныеБумаги.ОценочнаяСуммаКупона - СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
				Если СуммаПереоценкиКупона = 0 Тогда
					БалансоваяСуммаКупонаПоТекущемуКурсу =  СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета;
				Иначе
					БалансоваяСуммаКупонаПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.БалансоваяСуммаКупона, СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала, Объект.Организация, Объект.Дата, Отказ), 2);
				КонецЕсли;
				КурсоваяРазницаКупона = БалансоваяСуммаКупонаПоТекущемуКурсу - СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;
				СуммаПереоценкиКупонаВВалютеУчета 	= СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета - СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета - КурсоваяРазницаКупона;
				Если НЕ УчитыватьПереоценкуОтдельноКупон Тогда
					СуммаКурсовойРазницыПереоценкиКупона = 0;
				Иначе
					СуммаКурсовойРазницыПереоценкиКупона = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.ПереоценкаКупона, СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала, Объект.Организация, Объект.Дата, Отказ), 2)
					 - СтрокаЦенныеБумаги.ПереоценкаКупонаВВалютеУчета;
				КонецЕсли;
				СуммаКурсовойРазницыКупона = КурсоваяРазницаКупона - СуммаКурсовойРазницыПереоценкиКупона;
				Если СтрокаЦенныеБумаги.БалансоваяСуммаКупона = СтрокаЦенныеБумаги.ПереоценкаКупона Тогда 
					//купон при покупке погашен, все валим на переоценку купона
					СуммаКурсовойРазницыПереоценкиКупона = СуммаКурсовойРазницыПереоценкиКупона + СуммаКурсовойРазницыКупона;
					СуммаКурсовойРазницыКупона = 0;
				КонецЕсли;
				Если Объект.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда	
					//Уплаченный НКД в НУ не переоценивается
					СуммаКурсовойРазницыКупона = 0;
				КонецЕсли;	
					
				СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета + СуммаПереоценкиКупонаВВалютеУчета
					+ СуммаКурсовойРазницыПереоценкиКупона;
					
			КонецЕсли;			
			
		КонецЕсли;
		
       // хардкод для банкрота прайма
       // с 13.09.2019 не переоцениваем купон - ставим купон на 12е
       Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И НачалоДня(ДатаПереоценки) >= '20190913' Тогда
		   Если СтрокаЦенныеБумаги.ЦеннаяБумага.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Эмитент_Прайм") Тогда
			   
				СтрокаЦенныеБумаги.ОценочнаяЦенаКупона = Справочники.Облигации.ПолучитьКупон(СтрокаЦенныеБумаги.ЦеннаяБумага, '20190912', Объект.СчетДоверительногоУправления, , , Истина);
				СтрокаЦенныеБумаги.ОценочнаяСуммаКупона = Окр(СтрокаЦенныеБумаги.ОценочнаяЦенаКупона * СтрокаЦенныеБумаги.Количество, 2);
				СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаЦенныеБумаги.ОценочнаяСуммаКупона;
				
				// с 15.10.19 пошли траблы с округлением поэтому просто:
				Если НачалоДня(ДатаПереоценки) >= '20191015' Тогда
				
					СтрокаЦенныеБумаги.ОценочнаяЦенаКупона  = СтрокаЦенныеБумаги.БалансоваяЦенаКупона;
					СтрокаЦенныеБумаги.ОценочнаяСуммаКупона = СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
					СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;
				
				КонецЕсли;
           КонецЕсли;
       КонецЕсли;

	   Если (СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финстоун") И БанкротствоФинстоунаИАрчераПризнано)
		   ИЛИ (СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_АрчерФинанс") И БанкротствоФинстоунаИАрчераПризнано)
		   ИЛИ (СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОткрытиеХолдинг") И БанкротствоОткрытияПризнано)
		   ИЛИ (СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОткрХолдинг_004") И БанкротствоОткрытияПризнано)
		   ИЛИ (СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1_Груп_Финанс") И БанкротствоО1ГрупФинансПризнано) 
		   ИЛИ (СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ДП_О1ГрФин1P3") И БанкротствоДПО1ГрупФинансПризнано)
		   ИЛИ (СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1Пропертиз_Дол") И БанкротствоО1ПропертизПризнано) Тогда
		   
			СтрокаЦенныеБумаги.ОценочнаяЦенаКупона  = СтрокаЦенныеБумаги.БалансоваяЦенаКупона;
			СтрокаЦенныеБумаги.ОценочнаяСуммаКупона = СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
			СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;
			
       КонецЕсли;
	   
	КонецЦикла;
	
	Если СообщенияОбОценочнойСтоимости <> Неопределено Тогда
		Для Каждого Сообщение из СообщенияОбОценочнойСтоимости Цикл
			
			// Если сообщение с пометкой, значит, Отказ
			Если Сообщение.Пометка Тогда
				Отказ = Истина;
			КонецЕсли;
				
			Если ТипЗнч(Объект) = Тип("Структура") Тогда				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение.Значение);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение.Значение, Объект.Ссылка);
			КонецЕсли;                                                                    			
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьПриобретенияИРеализации(Объект, ДатаНачала, НастройкиУчетаОбщие)
	
	ДатаОкончания = КонецДня(ДатаНачала);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.УчетныйАктивЕПС КАК УчетныйАктивЕПС
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.УчетныйАктивЕПС КАК УчетныйАктивЕПС
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = БухПартииЦенныхБумаг.ЦеннаяБумага
		|			И (БухПартииЦенныхБумаг.ВидУчета = &ВидУчета)
		|			И (БухПартииЦенныхБумаг.Период >= &ДатаНачала)
		|			И (БухПартииЦенныхБумаг.Период <= &ДатаОкончания)
		|			И (БухПартииЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|			И (БухПартииЦенныхБумаг.Активность)
		|			И (БухПартииЦенныхБумаг.Регистратор ССЫЛКА Документ.ВводЦенныхБумаг
		|					И НЕ &НеСчитатьВводыВыводыЦенныхБумагОперациямиДляНачисленияПроцентногоДохода
		|				ИЛИ БухПартииЦенныхБумаг.Регистратор ССЫЛКА Документ.ВыводЦенныхБумаг
		|					И НЕ &НеСчитатьВводыВыводыЦенныхБумагОперациямиДляНачисленияПроцентногоДохода
		|				ИЛИ БухПартииЦенныхБумаг.Регистратор ССЫЛКА Документ.ИсполнениеОбязательствПоСделке
		|				ИЛИ БухПартииЦенныхБумаг.Регистратор ССЫЛКА Документ.ПогашениеКупона
		|				ИЛИ БухПартииЦенныхБумаг.Регистратор ССЫЛКА Документ.ПогашениеЦеннойБумаги
		|				ИЛИ БухПартииЦенныхБумаг.Регистратор ССЫЛКА Документ.ПоставкаЦенныхБумаг
		|				ИЛИ БухПартииЦенныхБумаг.Регистратор ССЫЛКА Документ.Сделка
		|				ИЛИ БухПартииЦенныхБумаг.Регистратор ССЫЛКА Документ.СделкаРЕПО
		|					И НЕ &НеСчитатьСделкуРЕПООснованиемДляПереоценки)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.УчетныйАктивЕПС
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО КАК БухПартииЦенныхБумагКупленныеПоРЕПО
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = БухПартииЦенныхБумагКупленныеПоРЕПО.ЦеннаяБумага
		|			И (НЕ &НеСчитатьСделкуРЕПООснованиемДляПереоценки)
		|			И (БухПартииЦенныхБумагКупленныеПоРЕПО.ВидУчета = &ВидУчета)
		|			И (БухПартииЦенныхБумагКупленныеПоРЕПО.Период >= &ДатаНачала)
		|			И (БухПартииЦенныхБумагКупленныеПоРЕПО.Период <= &ДатаОкончания)
		|			И (БухПартииЦенныхБумагКупленныеПоРЕПО.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|			И (БухПартииЦенныхБумагКупленныеПоРЕПО.Активность)
		|			И (БухПартииЦенныхБумагКупленныеПоРЕПО.Регистратор ССЫЛКА Документ.ИсполнениеОбязательствПоСделке
		|				ИЛИ БухПартииЦенныхБумагКупленныеПоРЕПО.Регистратор ССЫЛКА Документ.ПоставкаЦенныхБумаг
		|				ИЛИ БухПартииЦенныхБумагКупленныеПоРЕПО.Регистратор ССЫЛКА Документ.СделкаРЕПО)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.УчетныйАктивЕПС
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПорученияНаПереоценку КАК ПорученияНаПереоценку
		|		ПО (ИсходнаяТаблицаЦБ.ЦеннаяБумага = ПорученияНаПереоценку.ЦеннаяБумага
		|				ИЛИ ПорученияНаПереоценку.ЦеннаяБумага = НЕОПРЕДЕЛЕНО)
		|			И (ПорученияНаПереоценку.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|			И (ПорученияНаПереоценку.ВидУчета = &ВидУчета)
		|			И (ПорученияНаПереоценку.ДатаПереоценки >= &ДатаНачала)
		|			И (ПорученияНаПереоценку.ДатаПереоценки <= &ДатаОкончания)
		|			И (ПорученияНаПереоценку.Активность)
		|			И (ПорученияНаПереоценку.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивовДляПорученийНаПереоценку.ЦенныеБумаги))
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.УчетныйАктивЕПС
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РешенияКлиентовПоЗначениямЭСП КАК РешенияКлиентовПоЗначениямЭСП
		|		ПО (&СчитаемИзмененияЭСПОперациями)
		|			И ИсходнаяТаблицаЦБ.ЦеннаяБумага = РешенияКлиентовПоЗначениямЭСП.ЦеннаяБумага
		|			И ИсходнаяТаблицаЦБ.УчетныйАктивЕПС = РешенияКлиентовПоЗначениямЭСП.УчетныйАктивЕПС
		|			И (РешенияКлиентовПоЗначениямЭСП.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|			И (РешенияКлиентовПоЗначениямЭСП.Период >= &ДатаНачала)
		|			И (РешенияКлиентовПоЗначениямЭСП.Период <= &ДатаОкончания)
		|			И (РешенияКлиентовПоЗначениямЭСП.Активность)";
		
	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		ТаблицаЦБ = Объект.ЦенныеБумаги;
	Иначе
		ТаблицаЦБ = Объект.ЦенныеБумаги.Выгрузить(,"ЦеннаяБумага,УчетныйАктивЕПС");
	КонецЕсли;
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", 	ТаблицаЦБ);
	Запрос.УстановитьПараметр("ДатаНачала", 		ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 		ДатаОкончания);
	Запрос.УстановитьПараметр("ВидУчета", 			Объект.ВидУчета);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НеСчитатьВводыВыводыЦенныхБумагОперациямиДляНачисленияПроцентногоДохода", НастройкиУчетаОбщие.НеСчитатьВводыВыводыЦенныхБумагОперациямиДляНачисленияПроцентногоДохода);
	
	МассивСчетовСАФМАР = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
		ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар"),
		ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
		ДатаОкончания);

	ЭтоКлиентСАФМАР = (МассивСчетовСАФМАР.Найти(Объект.СчетДоверительногоУправления) <> Неопределено);
	
	
	МассивСчетовЮгория = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
		ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ГСКЮгория"),
		ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"),
		ДатаОкончания);

	ЭтоКлиентЮгория = (МассивСчетовЮгория.Найти(Объект.СчетДоверительногоУправления) <> Неопределено);

	
	МассивСчетовРОСТЕХ = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
		ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Ростех"),
		ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"),
		ДатаОкончания);
		
	ЭтоКлиентРОСТЕХ = (МассивСчетовРОСТЕХ.Найти(Объект.СчетДоверительногоУправления) <> Неопределено);

	
	Запрос.УстановитьПараметр("НеСчитатьСделкуРЕПООснованиемДляПереоценки", ЭтоКлиентСАФМАР ИЛИ ЭтоКлиентЮгория ИЛИ ЭтоКлиентРОСТЕХ);

	
	СчитаемИзмененияЭСПОперациями = (Объект.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет) И (ДатаНачала > '20250401');
	Запрос.УстановитьПараметр("СчитаемИзмененияЭСПОперациями", СчитаемИзмененияЭСПОперациями);

	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

// Проверяет наличие котировок и других загружаемых данных на дату
//
// Параметры:
//	ДатаКотировок - Дата - 
//	СписокПроверки - Неопределено, Структура - если Неопределено, то проверяются все загружаемые данные; 
//		если Структура, то проверяются данные по значению Булево для: 
//		- КотировкиММВБ
//		- КотировкиБлумберг
//		- ИндексыММВБ
//		- ССРасчетныеНРД
//		- ПараметрыКривойБД (Параметры кривой бескупонной доходности)
//		- РасчетныеЦеныRUData
//		- КурсыВалют
//		- КлиринговыеОтчетыСПФИ
//	СтрокаСообщений - Строка - выходной параметр, заполняется текстом о ненайденных данных
//
// Возвращаемое значение:
//	РезультатПроверки - Булево - Истина, если все проверяемые данные прогружены
//
Функция ПроверитьЗагружаемыеДанные(ДатаКотировок, СписокПроверки = Неопределено, СтрокаСообщений = "") Экспорт

	КотировкиММВБ 			= СписокПроверки = Неопределено ИЛИ СписокПроверки.Свойство("КотировкиММВБ") И СписокПроверки.КотировкиММВБ;
	КотировкиБлумберг 		= СписокПроверки = Неопределено ИЛИ СписокПроверки.Свойство("КотировкиБлумберг") И СписокПроверки.КотировкиБлумберг;
	ИндексыММВБ 			= СписокПроверки = Неопределено ИЛИ СписокПроверки.Свойство("ИндексыММВБ") И СписокПроверки.ИндексыММВБ;
	ССРасчетныеНРД 			= СписокПроверки = Неопределено ИЛИ СписокПроверки.Свойство("ССРасчетныеНРД") И СписокПроверки.ССРасчетныеНРД;
	ПараметрыКривойБД		= СписокПроверки = Неопределено ИЛИ СписокПроверки.Свойство("ПараметрыКривойБД") И СписокПроверки.ПараметрыКривойБД;
	РасчетныеЦеныRUData		= СписокПроверки = Неопределено ИЛИ СписокПроверки.Свойство("РасчетныеЦеныRUData") И СписокПроверки.РасчетныеЦеныRUData;
	КурсыВалют				= СписокПроверки = Неопределено ИЛИ СписокПроверки.Свойство("КурсыВалют") И СписокПроверки.КурсыВалют;
	КлиринговыеОтчетыСПФИ	= СписокПроверки = Неопределено ИЛИ СписокПроверки.Свойство("КлиринговыеОтчетыСПФИ") И СписокПроверки.КлиринговыеОтчетыСПФИ;
	
	Результат = Истина;
	СтрокаСообщений = "";
	
	ДатаПроверкиКотировок = НачалоДня(ДатаКотировок);
	ДатаТорговММВБ        = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(), ДатаПроверкиКотировок);
	ДатаРабочая           = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ДатаПроверкиКотировок);
	
	// Блумберг:
	// - до 11.11.2016 мы не вели котировки
	// - с 01.04.2022 перестал давать котировки (#423722)
	Если КотировкиБлумберг И (ДатаРабочая < '20161111' Или ДатаРабочая >= '20220401') Тогда
		КотировкиБлумберг = Ложь;
	КонецЕсли;
	
	// Цены RU Data:
	// - до 03.01.2018 мы не вели котировки
	// - с 28.09.2022 перестали качать котировки (#448937)
	Если РасчетныеЦеныRUData И (ДатаТорговММВБ < '20180103' Или ДатаТорговММВБ >= '20220928') Тогда
		РасчетныеЦеныRUData = Ложь;
	КонецЕсли;
	
	Если КотировкиММВБ ИЛИ КотировкиБлумберг Тогда
		Для сц=1 по 2 Цикл
			Если сц=1 И не КотировкиММВБ Тогда
				Продолжить;
			ИначеЕсли сц=2 и НЕ КотировкиБлумберг Тогда
				Продолжить;
			КонецЕсли;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	КотировкиТорговыхПлощадок.BID
				|ИЗ
				|	РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
				|ГДЕ
				|	КотировкиТорговыхПлощадок.Период = &ДатаПроверкиКотировок
				|	И КотировкиТорговыхПлощадок.Биржа = &Биржа";
			
			Запрос.УстановитьПараметр("Биржа", ?(сц=1, 
												ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"), 
												ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg")));
			Запрос.УстановитьПараметр("ДатаПроверкиКотировок", ?(сц=1, 
												ДатаТорговММВБ, 
												ДатаРабочая));
			
			РезультатЗапроса = Запрос.Выполнить();
			Если РезультатЗапроса.Пустой() Тогда
				СтрокаСообщений = СтрокаСообщений + ?(СтрокаСообщений="","",", ") + ?(сц=1, "итоги торгов ММВБ ("+Формат(ДатаТорговММВБ,"ДФ=dd.MM.yyyy")+")", "итоги торгов Блумберг ("+Формат(ДатаРабочая,"ДФ=dd.MM.yyyy")+")");
				Результат = Ложь;	
			КонецЕсли;

		КонецЦикла;
	КонецЕсли;
	
	Если ИндексыММВБ Тогда
		
		#Область Индексы_ММВБ 

		Если ДатаТорговММВБ < '20220321' ИЛИ ДатаТорговММВБ > '20220325' Тогда

			#Область Проверяемые_индексы 
		
			// Индексы из методик, КС, проверки ЭСП и прочих мест правильно бы получать автоматически.
			// Если будут настройки в справочнике, можно как-то в отдельной ТЧ элемента справочника их хранить.
			// Т.е. получаем действующие настройки, а из их значений получаем индексы.
			// #Техдолг #Хардкод
			
			ПроверяемыеИндексы = Новый Массив;
			ПроверяемыеИндексы.Добавить("IMOEX"); 
			
			// Из методик						
			ПроверяемыеИндексы.Добавить("RUCBITR1Y");
			ПроверяемыеИндексы.Добавить("RUGBITR10Y");
			ПроверяемыеИндексы.Добавить("RUGBITR15");
			ПроверяемыеИндексы.Добавить("RUGBITR1Y");
			ПроверяемыеИндексы.Добавить("RUGBITR3Y");
			ПроверяемыеИндексы.Добавить("RUGBITR5+");
			ПроверяемыеИндексы.Добавить("RUGBITR5Y");
			ПроверяемыеИндексы.Добавить("RUMBITR1Y");
			
			Если ДатаКотировок < '20230601' Тогда // ММВБ прекратила расчет с 01.06.2023
				
				ПроверяемыеИндексы.Добавить("RUCBICP");
				ПроверяемыеИндексы.Добавить("RUCBITR3+"); // его в перечне не было, но и базе 
				ПроверяемыеИндексы.Добавить("RUCBITRB3Y");
				ПроверяемыеИндексы.Добавить("RUCBITRBB3+");
				ПроверяемыеИндексы.Добавить("RUCBITRBB3Y");
				ПроверяемыеИндексы.Добавить("RUCBITRBB5Y");
				ПроверяемыеИндексы.Добавить("RUCBITRBBB3+");
				ПроверяемыеИндексы.Добавить("RUCBITRBBB3Y");
				ПроверяемыеИндексы.Добавить("RUCBITRBBB5Y");
				
				ПроверяемыеИндексы.Добавить("RUMBICP");
				ПроверяемыеИндексы.Добавить("RUMBITR3+");
				ПроверяемыеИндексы.Добавить("RUMBITR3Y");
				ПроверяемыеИндексы.Добавить("RUMBITRBB3Y");
				ПроверяемыеИндексы.Добавить("RUMBITRBBB3+");
				ПроверяемыеИндексы.Добавить("RUMBITRBBB3Y");
				
			КонецЕсли;
			
			// Из проверок ЭСП

			ПроверяемыеИндексы.Добавить("RUGBITR1Y");
			ПроверяемыеИндексы.Добавить("RUGBITR3Y");
			ПроверяемыеИндексы.Добавить("RUGBITR5Y");
			ПроверяемыеИндексы.Добавить("RUGBITR5+");
			ПроверяемыеИндексы.Добавить("RUGBITR10Y");
			ПроверяемыеИндексы.Добавить("RUCBITR1Y");
			ПроверяемыеИндексы.Добавить("RUMBITR1Y");
			
			Если ДатаКотировок < '20230601' Тогда // ММВБ прекратила расчет с 01.06.2023
				
				ПроверяемыеИндексы.Добавить("RUCBITRB3Y");
				ПроверяемыеИндексы.Добавить("RUCBITRBB3+");
				ПроверяемыеИндексы.Добавить("RUCBITRBB3Y");
				ПроверяемыеИндексы.Добавить("RUCBITRBB5Y");
				ПроверяемыеИндексы.Добавить("RUCBITRBBB3+");
				ПроверяемыеИндексы.Добавить("RUCBITRBBB3Y");
				ПроверяемыеИндексы.Добавить("RUCBITRBBB5Y");
				
				ПроверяемыеИндексы.Добавить("RUMBITRBB3Y");
				ПроверяемыеИндексы.Добавить("RUMBITRBBB3+");
				ПроверяемыеИндексы.Добавить("RUMBITRBBB3Y");
				
			КонецЕсли;
			
			// Из расчета кредитного спреда
			
			ПроверяемыеИндексы.Добавить("RUGBITR3Y");
			ПроверяемыеИндексы.Добавить("RUGBICP3Y");	
			ПроверяемыеИндексы.Добавить("RUCBITRL2");
			
			// Эти индексы у нас больше не используются
			Если НачалоДня(ДатаКотировок) < '20241114' Тогда
				ПроверяемыеИндексы.Добавить("RUCBITRL3");
				ПроверяемыеИндексы.Добавить("RUABITR");	
			КонецЕсли;	
			
			Если ДатаКотировок < '20230601' Тогда // ММВБ прекратила расчет с 01.06.2023
				
				ПроверяемыеИндексы.Добавить("RUCBITRBBB3Y");
				ПроверяемыеИндексы.Добавить("RUCBITRBB3Y");
				ПроверяемыеИндексы.Добавить("RUCBITRB3Y");
				ПроверяемыеИндексы.Добавить("RUCBITRBBB");
				ПроверяемыеИндексы.Добавить("RUCBITRBB");
				ПроверяемыеИндексы.Добавить("RUCBITRB");
				ПроверяемыеИндексы.Добавить("RUCBICPBBB3Y");
				ПроверяемыеИндексы.Добавить("RUCBICPBB3Y");
				ПроверяемыеИндексы.Добавить("RUCBICPB3Y");
				
			КонецЕсли;
			
			ПроверяемыеИндексы.Добавить("RUCBICPL3");
			ПроверяемыеИндексы.Добавить("RUCBICPL2");
			
			Если ДатаКотировок >= '20230401' Тогда

				ПроверяемыеИндексы.Добавить("RUCBTRAAANS");
				ПроверяемыеИндексы.Добавить("RUCBTRA2A");
				ПроверяемыеИндексы.Добавить("RUCBTR2B3B");
				ПроверяемыеИндексы.Добавить("RUCBTRAANS");
				ПроверяемыеИндексы.Добавить("RUCBTRANS");
				ПроверяемыеИндексы.Добавить("RUCBTRBBBNS");
				
				ПроверяемыеИндексы.Добавить("RUMBTRAAANS");
				ПроверяемыеИндексы.Добавить("RUMBTRAANS");
				ПроверяемыеИндексы.Добавить("RUMBTRANS");
				ПроверяемыеИндексы.Добавить("RUMBTRBBBNS");
				
				ПроверяемыеИндексы.Добавить("RUCBCP3A3YNS");
				ПроверяемыеИндексы.Добавить("RUCBCPAA3YNS");
				ПроверяемыеИндексы.Добавить("RUCBCPA3YNS");
				ПроверяемыеИндексы.Добавить("RUCBCPBBBNS");

			КонецЕсли;
			
			#КонецОбласти
			
			Запрос = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	БиржевыеИндексы.Ссылка КАК БиржевойИндекс
				|ПОМЕСТИТЬ _ПроверяемыеИндексы
				|ИЗ
				|	Справочник.БиржевыеИндексы КАК БиржевыеИндексы
				|ГДЕ
				|	БиржевыеИндексы.Код В(&ПроверяемыеИндексы)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	_ПроверяемыеИндексы.БиржевойИндекс КАК БиржевойИндекс
				|ИЗ
				|	_ПроверяемыеИндексы КАК _ПроверяемыеИндексы
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
				|		ПО (ЗначенияБиржевыхИндексов.Биржа = &Биржа)
				|			И (ЗначенияБиржевыхИндексов.БиржевойИндекс = _ПроверяемыеИндексы.БиржевойИндекс)
				|			И (ЗначенияБиржевыхИндексов.Период = &ДатаПроверкиКотировок)
				|ГДЕ
				|	ЗначенияБиржевыхИндексов.БиржевойИндекс ЕСТЬ NULL");
			
			Запрос.УстановитьПараметр("ПроверяемыеИндексы",		ПроверяемыеИндексы);
			Запрос.УстановитьПараметр("Биржа",					ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
			Запрос.УстановитьПараметр("ДатаПроверкиКотировок",	ДатаТорговММВБ);
			
			Если Не Запрос.Выполнить().Пустой() Тогда
				СтрокаСообщений = СтрокаСообщений + ?(СтрокаСообщений = "", "", ", ") + "индексы ММВБ (" + Формат(ДатаТорговММВБ, "ДФ=dd.MM.yyyy") + ")";
				Результат = Ложь;	
			КонецЕсли;
			
		КонецЕсли;

		#КонецОбласти
		
	КонецЕсли;
	
	Если ССРасчетныеНРД Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	РасчетныеЦеныНРД.ЦеннаяБумага КАК ЦеннаяБумага
			|ИЗ
			|	РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
			|ГДЕ
			|	РасчетныеЦеныНРД.Период = &ДатаПроверкиКотировок
			|	И РасчетныеЦеныНРД.VERSION = """"";
		
		Запрос.УстановитьПараметр("ДатаПроверкиКотировок", ДатаТорговММВБ);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			СтрокаСообщений = СтрокаСообщений + ?(СтрокаСообщений="","",", ") + "справедливые цены НРД по старой методике ("+Формат(ДатаТорговММВБ,"ДФ=dd.MM.yyyy")+")";
			Результат = Ложь;	
		КонецЕсли;

		Если ДатаТорговММВБ >= Дата(2018, 1, 1) Тогда
		
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	РасчетныеЦеныНРД.ЦеннаяБумага КАК ЦеннаяБумага
				|ИЗ
				|	РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
				|ГДЕ
				|	РасчетныеЦеныНРД.Период = &ДатаПроверкиКотировок
				|	И РасчетныеЦеныНРД.VERSION = ""2""";
			
			Запрос.УстановитьПараметр("ДатаПроверкиКотировок", ДатаТорговММВБ);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если РезультатЗапроса.Пустой() Тогда
				СтрокаСообщений = СтрокаСообщений + ?(СтрокаСообщений="","",", ") + "справедливые цены НРД по новой методике ("+Формат(ДатаТорговММВБ,"ДФ=dd.MM.yyyy")+")";
				Результат = Ложь;	
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПараметрыКривойБД Тогда
		Запрос = Новый Запрос("
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ПараметрыКривойБескупоннойДоходности.ВидПараметра КАК ВидПараметра
			|ИЗ
			|	РегистрСведений.ПараметрыКривойБескупоннойДоходности КАК ПараметрыКривойБескупоннойДоходности
			|ГДЕ
			|	ПараметрыКривойБескупоннойДоходности.Период = &ДатаПроверкиКотировок
			|");
		Запрос.УстановитьПараметр("ДатаПроверкиКотировок", ДатаТорговММВБ);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			СтрокаСообщений = СтрокаСообщений + ?(СтрокаСообщений="","",", ") + "параметры кривой бескупонной доходности ("+Формат(ДатаТорговММВБ,"ДФ=dd.MM.yyyy")+")";
			Результат = Ложь;	
		КонецЕсли;
	КонецЕсли;
	
	Если РасчетныеЦеныRUData Тогда
		Запрос = Новый Запрос("
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	РасчетныеЦеныRUData.ЦеннаяБумага КАК ЦеннаяБумага
			|ИЗ
			|	РегистрСведений.РасчетныеЦеныRUData КАК РасчетныеЦеныRUData
			|ГДЕ
			|	РасчетныеЦеныRUData.Период = &ДатаПроверкиКотировок
			|");
		Запрос.УстановитьПараметр("ДатаПроверкиКотировок", ДатаТорговММВБ);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			СтрокаСообщений = СтрокаСообщений + ?(СтрокаСообщений="","",", ") + "расчетные цены RU Data ("+Формат(ДатаТорговММВБ,"ДФ=dd.MM.yyyy")+")";
			Результат = Ложь;	
		КонецЕсли;
	КонецЕсли;
	
	Если КурсыВалют Тогда
		ВалютаРубли = ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");
		
		Если ВалютаРубли = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось найти объект по имени 'Валюта_Российский_рубль'. Проверка кусов валют не выполнена.");	
		Иначе
			Запрос = Новый Запрос("
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	КурсыВалют.Период КАК Период
				|ИЗ
				|	РегистрСведений.КурсыВалют КАК КурсыВалют
				|ГДЕ
				|	КурсыВалют.Период = &ДатаПроверкиКотировок
				|	И КурсыВалют.Валюта <> &ВалютаРубли  
				|");
			Запрос.УстановитьПараметр("ДатаПроверкиКотировок", ДатаПроверкиКотировок);
			Запрос.УстановитьПараметр("ВалютаРубли", ВалютаРубли);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если РезультатЗапроса.Пустой() Тогда
				СтрокаСообщений = СтрокаСообщений + ?(СтрокаСообщений="","",", ") + "курсы валют ("+Формат(ДатаПроверкиКотировок,"ДФ=dd.MM.yyyy")+")";
				Результат = Ложь;	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	Если КлиринговыеОтчетыСПФИ Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	СделкаСПФИ.Ссылка КАК СделкаСПФИ
			|ИЗ
			|	Документ.СделкаСПФИ КАК СделкаСПФИ
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьСПФИ КАК СтоимостьСПФИ
			|		ПО (СтоимостьСПФИ.СПФИ = СделкаСПФИ.Ссылка)
			|			И (НАЧАЛОПЕРИОДА(СтоимостьСПФИ.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ДатаПроверкиКотировок, ДЕНЬ))
			|ГДЕ
			|	СделкаСПФИ.Проведен
			|	И НАЧАЛОПЕРИОДА(СделкаСПФИ.ДатаИсполнения, ДЕНЬ) >= НАЧАЛОПЕРИОДА(&ДатаПроверкиКотировок, ДЕНЬ)
			|	И НАЧАЛОПЕРИОДА(СделкаСПФИ.Дата, ДЕНЬ) <= НАЧАЛОПЕРИОДА(&ДатаПроверкиКотировок, ДЕНЬ)
			|	И СтоимостьСПФИ.Период ЕСТЬ NULL
			|	И СделкаСПФИ.Организация = &Организация";
		
		Запрос.УстановитьПараметр("ДатаПроверкиКотировок", ДатаТорговММВБ);
		Запрос.УстановитьПараметр("Организация", ПараметрыСеанса.ТекущаяОрганизация);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() Тогда
			СтрокаСообщений = СтрокаСообщений + ?(СтрокаСообщений="","",", ") + "клиринговые отчеты на рынке СПФИ ("+Формат(ДатаТорговММВБ,"ДФ=dd.MM.yyyy")+")";
			Результат = Ложь;	
		КонецЕсли;
		
	КонецЕсли;	
	
	Если СтрокаСообщений <> "" Тогда
		СтрокаСообщений = "Отсутствуют загружаемые данные на "+Формат(ДатаКотировок,"ДФ=dd.MM.yyyy")+": "+СтрокаСообщений;
	КонецЕсли;
	
	Возврат Результат;	
	
КонецФункции

Процедура ДобавитьСуммыВВалютахНоминалаИУчета(ТаблицаКотировок, ДляФиксацииСтоимости, ЦельРасчета, ВариантРасчетаОценочнойСтоимости, Объект, ИспользоватьРасчетныйКупон)
	
	// Дополняем нужными колонками	
	
	Если ДляФиксацииСтоимости И ТипЗнч(Объект) = Тип("Структура") Тогда
		ТаблицаКотировок.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	КонецЕсли;
	
	Если ТаблицаКотировок.Колонки.Найти("ОценочнаяСуммаВВалютеУчета") = Неопределено Тогда
		ТаблицаКотировок.Колонки.Добавить("ОценочнаяСуммаВВалютеУчета", Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	КонецЕсли;
	
	Если ТаблицаКотировок.Колонки.Найти("ОценочнаяСуммаКупонаВВалютеУчета") = Неопределено Тогда
		ТаблицаКотировок.Колонки.Добавить("ОценочнаяСуммаКупонаВВалютеУчета", Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	КонецЕсли;

	РынокОблигации 	= Перечисления.РынкиЦенныхБумаг.Облигации;
	РынокДоли 		= Перечисления.РынкиЦенныхБумаг.Доли;
	
	// Получаем нужные курсы валют
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаКотировок.НомерСтроки КАК НомерСтроки,
		|	_ТаблицаКотировок.ВалютаКотировки КАК ВалютаКотировки,
		|	_ТаблицаКотировок.ВалютаКотировкиКупона КАК ВалютаКотировкиКупона,
		|	НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(_ТаблицаКотировок.ДатаКотировки КАК ДАТА), ДЕНЬ) КАК ДатаКотировки,
		|	НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(_ТаблицаКотировок.ДатаКотировкиКупона КАК ДАТА), ДЕНЬ) КАК ДатаКотировкиКупона,
		|	_ТаблицаКотировок.ВалютаНоминала КАК ВалютаНоминала
		|ПОМЕСТИТЬ _ТаблицаКотировок
		|ИЗ
		|	&ТаблицаКотировок КАК _ТаблицаКотировок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаКотировок.НомерСтроки КАК НомерСтроки,
		|	КурсыВалютыУчета.Курс КАК КурсВалютыУчетаКурс,
		|	КурсыВалютыУчета.Кратность КАК КурсВалютыУчетаКратность,
		|	КурсыВалютНоминала.Курс КАК КурсВалютыНоминалаКурс,
		|	КурсыВалютНоминала.Кратность КАК КурсВалютыНоминалаКратность,
		|	КурсыВалютыКотировки.Курс КАК КурсВалютыКотировкиКурс,
		|	КурсыВалютыКотировки.Кратность КАК КурсВалютыКотировкиКратность,
		|	КурсыВалютыНоминалаНаДатуКотировки.Курс КАК КурсВалютыНоминалаНаДатуКотировкиКурс,
		|	КурсыВалютыНоминалаНаДатуКотировки.Кратность КАК КурсВалютыНоминалаНаДатуКотировкиКратность,
		|	КурсыВалютыКотировкиКупона.Курс КАК КурсВалютыКотировкиКупонаКурс,
		|	КурсыВалютыКотировкиКупона.Кратность КАК КурсВалютыКотировкиКупонаКратность,
		|	КурсыВалютыНоминалаНаДатуКотировкиКупона.Курс КАК КурсВалютыНоминалаНаДатуКотировкиКупонаКурс,
		|	КурсыВалютыНоминалаНаДатуКотировкиКупона.Кратность КАК КурсВалютыНоминалаНаДатуКотировкиКупонаКратность
		|ИЗ
		|	_ТаблицаКотировок КАК _ТаблицаКотировок
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютНоминала
		|		ПО (КурсыВалютНоминала.Валюта = _ТаблицаКотировок.ВалютаНоминала)
		|			И (КурсыВалютНоминала.Период = &Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютыУчета
		|		ПО (КурсыВалютыУчета.Валюта = &ВалютаУчета)
		|			И (КурсыВалютыУчета.Период = &Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютыКотировки
		|		ПО (КурсыВалютыКотировки.Валюта = _ТаблицаКотировок.ВалютаКотировки)
		|			И (КурсыВалютыКотировки.Период = _ТаблицаКотировок.ДатаКотировки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютыНоминалаНаДатуКотировки
		|		ПО (КурсыВалютыНоминалаНаДатуКотировки.Валюта = _ТаблицаКотировок.ВалютаНоминала)
		|			И (КурсыВалютыНоминалаНаДатуКотировки.Период = _ТаблицаКотировок.ДатаКотировки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютыКотировкиКупона
		|		ПО (КурсыВалютыКотировкиКупона.Валюта = _ТаблицаКотировок.ВалютаКотировкиКупона)
		|			И (КурсыВалютыКотировкиКупона.Период = _ТаблицаКотировок.ДатаКотировкиКупона)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютыНоминалаНаДатуКотировкиКупона
		|		ПО (КурсыВалютыНоминалаНаДатуКотировкиКупона.Валюта = _ТаблицаКотировок.ВалютаНоминала)
		|			И (КурсыВалютыНоминалаНаДатуКотировкиКупона.Период = _ТаблицаКотировок.ДатаКотировкиКупона)");
	
	ВалютаУчета		= Объект.Организация.ВалютаУчета;
	РынокОблигации	= Перечисления.РынкиЦенныхБумаг.Облигации;
	
	Запрос.УстановитьПараметр("ТаблицаКотировок", ТаблицаКотировок);
	Запрос.УстановитьПараметр("ВалютаУчета", 	  ВалютаУчета);
	Запрос.УстановитьПараметр("Период", 	  	  НачалоДня(Объект.Дата));
	
	ТаблицаКурсовВалют = Запрос.Выполнить().Выгрузить();
	ТаблицаКурсовВалют.Индексы.Добавить("НомерСтроки");	
	
	// Собственный курс может быть точнее, чем в регистрах,
	// поэтому увеличиваем точность до максимальной
	
	РаботаСКоллекциями.ТаблицаЗначений_ОбновитьТочностьКолонок(ТаблицаКурсовВалют,
		Новый Структура("КурсВалютыНоминалаКурс", Метаданные.ОпределяемыеТипы.КурсВалюты.Тип));		
		
	#Область Варианты_округления_валютных_сумм_при_расчете_сумм_в_валюте_учета 	
	
	ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета = РаботаСПереоценкой.ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета(
		ВариантРасчетаОценочнойСтоимости, Объект.СчетДоверительногоУправления, Объект.Дата); 
		
	РассчитыватьСуммуВВалютеУчетаОтОкругленнойВалютнойСуммы = (ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСумму <> "НеОкруглять");	
		
	Если РассчитыватьСуммуВВалютеУчетаОтОкругленнойВалютнойСуммы Тогда
		Если ТипЗнч(ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСумму) <> Тип("Число") Тогда
			ВызватьИсключение СтрШаблон("Неизвестный вариант округления валютной суммы '%1'", ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСумму);
		КонецЕсли;
	КонецЕсли;
	
	РассчитыватьСуммуКупонаВВалютеУчетаОтОкругленнойВалютнойСуммы = (ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСуммуКупона <> "НеОкруглять");	
	
	Если РассчитыватьСуммуКупонаВВалютеУчетаОтОкругленнойВалютнойСуммы Тогда
		Если ТипЗнч(ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСуммуКупона) <> Тип("Число") Тогда
			ВызватьИсключение СтрШаблон("Неизвестный вариант округления валютной суммы купона '%1'", ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСуммуКупона);
		КонецЕсли;
	КонецЕсли;
	
	#КонецОбласти
	
	Для Каждого СтрокаТаблицы Из ТаблицаКотировок Цикл
		
		СтрокаКурсов = ТаблицаКурсовВалют.Найти(СтрокаТаблицы.НомерСтроки, "НомерСтроки");
		
		// Если задан собственный курс, берем его
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.КурсВалютыНоминала) Тогда
			СтрокаКурсов.КурсВалютыНоминалаКурс			= СтрокаТаблицы.КурсВалютыНоминала;
			СтрокаКурсов.КурсВалютыНоминалаКратность	= 1;
		КонецЕсли;
		
		// В валюте номинала
		
		Если СтрокаТаблицы.ЦенаКотировки <> 0 Тогда
			
			Если СтрокаТаблицы.ВалютаКотировки <> СтрокаТаблицы.ВалютаНоминала Тогда
				СтрокаТаблицы.РыночнаяЦена = СтрокаТаблицы.ЦенаКотировки * СтрокаКурсов.КурсВалютыКотировкиКурс / СтрокаКурсов.КурсВалютыКотировкиКратность / СтрокаКурсов.КурсВалютыНоминалаНаДатуКотировкиКурс * СтрокаКурсов.КурсВалютыНоминалаНаДатуКотировкиКратность;
			Иначе
				СтрокаТаблицы.РыночнаяЦена = СтрокаТаблицы.ЦенаКотировки;
			КонецЕсли;
			
			Если СтрокаТаблицы.Рынок = РынокДоли Тогда 
				СтрокаТаблицы.РыночнаяСумма = СтрокаТаблицы.РыночнаяЦена; // Оценщик дает стоимость имеющегося размера доли
			Иначе
				СтрокаТаблицы.РыночнаяСумма = СтрокаТаблицы.РыночнаяЦена * СтрокаТаблицы.Количество;
			КонецЕсли;
			
		Иначе
			
			СтрокаТаблицы.РыночнаяЦена = 0;
			СтрокаТаблицы.РыночнаяСумма = 0;
			
		КонецЕсли;
		
		Если СтрокаТаблицы.Рынок = РынокОблигации Тогда
			
			Если СтрокаТаблицы.ЦенаКотировкиКупона <> 0 Тогда
				
				Если СтрокаТаблицы.ВалютаРыночнойЦеныКупона = СтрокаТаблицы.ВалютаНоминала И СтрокаТаблицы.РыночнаяЦенаКупона <> 0 Тогда
					// Уже все рассчитано	
				ИначеЕсли СтрокаТаблицы.ВалютаКотировкиКупона <> СтрокаТаблицы.ВалютаНоминала Тогда
					СтрокаТаблицы.РыночнаяЦенаКупона = СтрокаТаблицы.ЦенаКотировкиКупона * СтрокаКурсов.КурсВалютыКотировкиКупонаКурс / СтрокаКурсов.КурсВалютыКотировкиКупонаКратность / СтрокаКурсов.КурсВалютыНоминалаНаДатуКотировкиКупонаКурс * СтрокаКурсов.КурсВалютыНоминалаНаДатуКотировкиКупонаКратность;
				Иначе
					СтрокаТаблицы.РыночнаяЦенаКупона = СтрокаТаблицы.ЦенаКотировкиКупона;
				КонецЕсли;
				
				СтрокаТаблицы.РыночнаяСуммаКупона = СтрокаТаблицы.РыночнаяЦенаКупона * СтрокаТаблицы.Количество;
				
			Иначе
				
				СтрокаТаблицы.РыночнаяЦенаКупона = 0;
				СтрокаТаблицы.РыночнаяСуммаКупона = 0;
				
			КонецЕсли;
			
		КонецЕсли;
		
		//в валюте учета
		
		// Заполняем рыночные цены из оценочных или наоборот
		
		Если СтрокаТаблицы.РыночнаяЦена = 0 Тогда
			СтрокаТаблицы.РыночнаяЦена = СтрокаТаблицы.ОценочнаяЦена;
		Иначе
			СтрокаТаблицы.ОценочнаяЦена = СтрокаТаблицы.РыночнаяЦена;
		КонецЕсли;
		
		Если СтрокаТаблицы.РыночнаяЦенаПроцент = 0 Тогда
			СтрокаТаблицы.РыночнаяЦенаПроцент = СтрокаТаблицы.ОценочнаяЦенаПроцент;
		Иначе
			СтрокаТаблицы.ОценочнаяЦенаПроцент = СтрокаТаблицы.РыночнаяЦенаПроцент;
		КонецЕсли;
		
		Если СтрокаТаблицы.РыночнаяЦенаКупона = 0 Тогда
			СтрокаТаблицы.РыночнаяЦенаКупона = СтрокаТаблицы.ОценочнаяЦенаКупона;
		ИначеЕсли СтрокаТаблицы.ОценочнаяЦенаКупона = 0 Тогда 
			СтрокаТаблицы.ОценочнаяЦенаКупона = СтрокаТаблицы.РыночнаяЦенаКупона;
		ИначеЕсли НЕ ИспользоватьРасчетныйКупон Тогда // Рыночный и оценочный в данном случаем могут отличаться!!!
			СтрокаТаблицы.ОценочнаяЦенаКупона = СтрокаТаблицы.РыночнаяЦенаКупона;
		КонецЕсли;		
		
		// Пересчет рыночной цены и обновление сумм
		
		Если СтрокаТаблицы.РыночнаяЦена = 0 И СтрокаТаблицы.ЦенаКотировки <> 0 Тогда
			СтрокаТаблицы.РыночнаяЦена = СтрокаТаблицы.ЦенаКотировки * СтрокаКурсов.КурсВалютыКотировкиКурс / СтрокаКурсов.КурсВалютыКотировкиКратность / СтрокаКурсов.КурсВалютыНоминалаНаДатуКотировкиКурс * СтрокаКурсов.КурсВалютыНоминалаНаДатуКотировкиКратность;
		КонецЕсли;
				
		Если СтрокаТаблицы.РыночнаяЦена = 0 Тогда
			СтрокаТаблицы.РыночнаяСумма		= 0;
			СтрокаТаблицы.ОценочнаяЦена		= 0;
			СтрокаТаблицы.ОценочнаяСумма	= 0;
		Иначе
			Если СтрокаТаблицы.Рынок = Перечисления.РынкиЦенныхБумаг.Доли Тогда
				СтрокаТаблицы.РыночнаяСумма		= СтрокаТаблицы.РыночнаяЦена;
			Иначе
				СтрокаТаблицы.РыночнаяСумма		= СтрокаТаблицы.РыночнаяЦена * СтрокаТаблицы.Количество;
			КонецЕсли;
			СтрокаТаблицы.ОценочнаяЦена		= СтрокаТаблицы.РыночнаяЦена;
			СтрокаТаблицы.ОценочнаяСумма	= СтрокаТаблицы.РыночнаяСумма;
		КонецЕсли;
		
		// По умолчанию рассчитываем без округлений
		
		СтрокаТаблицы.ОценочныеДисконтПремияВВалютеУчета				= СтрокаТаблицы.ОценочныеДисконтПремия * СтрокаКурсов.КурсВалютыНоминалаКурс / СтрокаКурсов.КурсВалютыНоминалаКратность / СтрокаКурсов.КурсВалютыУчетаКурс * СтрокаКурсов.КурсВалютыУчетаКратность;
		СтрокаТаблицы.ОценочнаяКорректировкаЭСПВВалютеУчета				= СтрокаТаблицы.ОценочнаяКорректировкаЭСП * СтрокаКурсов.КурсВалютыНоминалаКурс / СтрокаКурсов.КурсВалютыНоминалаКратность / СтрокаКурсов.КурсВалютыУчетаКурс * СтрокаКурсов.КурсВалютыУчетаКратность;
		СтрокаТаблицы.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета	= СтрокаТаблицы.ОценочнаяРазницаППНеНаблюдаемыеДанные * СтрокаКурсов.КурсВалютыНоминалаКурс / СтрокаКурсов.КурсВалютыНоминалаКратность / СтрокаКурсов.КурсВалютыУчетаКурс * СтрокаКурсов.КурсВалютыУчетаКратность;
			
		Если СтрокаТаблицы.Рынок = РынокОблигации Тогда
			СтрокаТаблицы.РыночнаяСуммаКупона	= СтрокаТаблицы.РыночнаяЦенаКупона * СтрокаТаблицы.Количество;
			СтрокаТаблицы.ОценочнаяСуммаКупона	= СтрокаТаблицы.ОценочнаяЦенаКупона * СтрокаТаблицы.Количество;			
		КонецЕсли;
		
		// Округляем до нужной точности
		
		Если ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Согласие
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ОПК
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ОПК2018
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Согласие2019
		Тогда
			
			Если СтрокаТаблицы.ВалютаНоминала <> ВалютаУчета Тогда 
				СтрокаТаблицы.ОценочнаяЦена					= Окр(СтрокаТаблицы.ОценочнаяЦена, 4);
				СтрокаТаблицы.ОценочнаяСумма				= СтрокаТаблицы.ОценочнаяЦена * СтрокаТаблицы.Количество;
				СтрокаТаблицы.ОценочнаяСуммаВВалютеУчета	= Окр(СтрокаТаблицы.ОценочнаяЦена * СтрокаКурсов.КурсВалютыНоминалаКурс / СтрокаКурсов.КурсВалютыНоминалаКратность / СтрокаКурсов.КурсВалютыУчетаКурс * СтрокаКурсов.КурсВалютыУчетаКратность, 6) * СтрокаТаблицы.Количество;
				
				Если СтрокаТаблицы.Рынок = РынокОблигации Тогда
					СтрокаТаблицы.ОценочнаяСуммаКупона				= Окр(СтрокаТаблицы.ОценочнаяЦенаКупона, 2) *  СтрокаТаблицы.Количество;
					СтрокаТаблицы.ОценочнаяСуммаКупонаВВалютеУчета	= Окр(СтрокаТаблицы.ОценочнаяЦенаКупона, 2) *  СтрокаТаблицы.Количество * СтрокаКурсов.КурсВалютыНоминалаКурс / СтрокаКурсов.КурсВалютыНоминалаКратность / СтрокаКурсов.КурсВалютыУчетаКурс * СтрокаКурсов.КурсВалютыУчетаКратность;
				КонецЕсли;
			Иначе
				СтрокаТаблицы.ОценочнаяЦена					= Окр(СтрокаТаблицы.ОценочнаяЦена, 6);
				СтрокаТаблицы.ОценочнаяСумма				= Окр(СтрокаТаблицы.ОценочнаяЦена * СтрокаТаблицы.Количество, 2);
				СтрокаТаблицы.ОценочнаяСуммаВВалютеУчета	= СтрокаТаблицы.ОценочнаяСумма;
				
				Если СтрокаТаблицы.Рынок = РынокОблигации Тогда
					СтрокаТаблицы.ОценочнаяСуммаКупона				= Окр(СтрокаТаблицы.ОценочнаяЦенаКупона, 2) *  СтрокаТаблицы.Количество;
					СтрокаТаблицы.ОценочнаяСуммаКупонаВВалютеУчета	= СтрокаТаблицы.ОценочнаяСуммаКупона;
				КонецЕсли;
			КонецЕсли;

		ИначеЕсли СтрокаТаблицы.ВалютаНоминала = ВалютаУчета Тогда 
			
			СтрокаТаблицы.ОценочнаяСумма					= Окр(СтрокаТаблицы.ОценочнаяСумма, 2);
			СтрокаТаблицы.ОценочнаяСуммаКупона				= Окр(СтрокаТаблицы.ОценочнаяСуммаКупона, 2);
			СтрокаТаблицы.ОценочнаяСуммаВВалютеУчета		= СтрокаТаблицы.ОценочнаяСумма;
			СтрокаТаблицы.ОценочнаяСуммаКупонаВВалютеУчета	= СтрокаТаблицы.ОценочнаяСуммаКупона;
			
		ИначеЕсли ЦельРасчета = Справочники.ЦелиРасчета.БухгалтерскийУчет Тогда
			
			СтрокаТаблицы.ОценочнаяСумма				= Окр(СтрокаТаблицы.ОценочнаяЦена * СтрокаТаблицы.Количество, 4);
			СтрокаТаблицы.ОценочнаяСуммаВВалютеУчета	= СтрокаТаблицы.ОценочнаяСумма * СтрокаКурсов.КурсВалютыНоминалаКурс / СтрокаКурсов.КурсВалютыНоминалаКратность / СтрокаКурсов.КурсВалютыУчетаКурс * СтрокаКурсов.КурсВалютыУчетаКратность;
			
			Если СтрокаТаблицы.Рынок = РынокОблигации Тогда
				СтрокаТаблицы.ОценочнаяСуммаКупона				= Окр(СтрокаТаблицы.ОценочнаяСуммаКупона, 4);
				СтрокаТаблицы.ОценочнаяСуммаКупонаВВалютеУчета	= СтрокаТаблицы.ОценочнаяСуммаКупона * СтрокаКурсов.КурсВалютыНоминалаКурс / СтрокаКурсов.КурсВалютыНоминалаКратность / СтрокаКурсов.КурсВалютыУчетаКурс * СтрокаКурсов.КурсВалютыУчетаКратность;
			КонецЕсли;
			
		Иначе			
			
			Если ЦельРасчета.ТолькоДляФиксацииСтоимостиОценки ИЛИ НЕ РассчитыватьСуммуВВалютеУчетаОтОкругленнойВалютнойСуммы Тогда // #Хардкод по задаче #375298. Ждем рефакторинга
				СтрокаТаблицы.ОценочнаяСуммаВВалютеУчета = СтрокаТаблицы.ОценочнаяЦена * СтрокаТаблицы.Количество * СтрокаКурсов.КурсВалютыНоминалаКурс / СтрокаКурсов.КурсВалютыНоминалаКратность / СтрокаКурсов.КурсВалютыУчетаКурс * СтрокаКурсов.КурсВалютыУчетаКратность;			
			Иначе
				СтрокаТаблицы.ОценочнаяСуммаВВалютеУчета = СтрокаТаблицы.ОценочнаяСумма * СтрокаКурсов.КурсВалютыНоминалаКурс / СтрокаКурсов.КурсВалютыНоминалаКратность / СтрокаКурсов.КурсВалютыУчетаКурс * СтрокаКурсов.КурсВалютыУчетаКратность;
			КонецЕсли;
			
			СтрокаТаблицы.ОценочнаяСумма = Окр(СтрокаТаблицы.ОценочнаяСумма, 2);
			
			Если СтрокаТаблицы.Рынок = РынокОблигации Тогда
				
				ОценочнаяСуммаКупона = СтрокаТаблицы.ОценочнаяЦенаКупона * СтрокаТаблицы.Количество; // через отдельную переменную, т.к. в таблице для колонки задана точность	
				
				Если РассчитыватьСуммуКупонаВВалютеУчетаОтОкругленнойВалютнойСуммы Тогда
					ОценочнаяСуммаКупона = Окр(ОценочнаяСуммаКупона, ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСуммуКупона);
				КонецЕсли;
				
				СтрокаТаблицы.ОценочнаяСуммаКупона				= Окр(СтрокаТаблицы.ОценочнаяСуммаКупона, 2);
				СтрокаТаблицы.ОценочнаяСуммаКупонаВВалютеУчета	= ОценочнаяСуммаКупона * СтрокаКурсов.КурсВалютыНоминалаКурс / СтрокаКурсов.КурсВалютыНоминалаКратность / СтрокаКурсов.КурсВалютыУчетаКурс * СтрокаКурсов.КурсВалютыУчетаКратность;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры	

Функция РассчитатьБалансовуюСтоимостьАктивов(ДатаПереоценки, Организация, СчетДоверительногоУправления, ЦельРасчета)
	
	ВалютаБаланса = 0;

	Если ЦельРасчета <> Справочники.ЦелиРасчета.ЕдиныйПланСчетов Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не реализован расчет объема портфеля для оценки валюты баланса!");
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток,
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет.Вид КАК ВидСчета,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика КАК ДополнительнаяАналитика
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&ДатаПереоценки,
		|			,
		|			,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Организация = &Организация) КАК ЕдиныйБухгалтерскийУчетОстатки";

	Запрос.УстановитьПараметр("ДатаПереоценки", Новый Граница(КонецДня(ДатаПереоценки), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		КодСчета = ВыборкаДетальныеЗаписи.Счет.Код;
		КодСчетаРодителя = ВыборкаДетальныеЗаписи.Счет.Родитель.Код;
		Если КодСчета = "47903" Тогда
			Если ВыборкаДетальныеЗаписи.ДополнительнаяАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеУправляющего Тогда
				ВалютаБаланса =  ВалютаБаланса + ВыборкаДетальныеЗаписи.СуммаОстаток;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если КодСчетаРодителя = "206" ИЛИ КодСчетаРодителя = "205" ИЛИ КодСчетаРодителя = "202" 
			ИЛИ КодСчетаРодителя = "306" ИЛИ КодСчетаРодителя = "603"  
			ИЛИ КодСчетаРодителя = "470" Тогда
			ВалютаБаланса =  ВалютаБаланса + ВыборкаДетальныеЗаписи.СуммаОстаток;
			Продолжить;
		КонецЕсли;
		Если КодСчетаРодителя = "501" ИЛИ КодСчетаРодителя = "502" ИЛИ КодСчетаРодителя = "503" 
			ИЛИ КодСчетаРодителя = "504" ИЛИ КодСчетаРодителя = "505" 
			ИЛИ КодСчетаРодителя = "506" ИЛИ КодСчетаРодителя = "507" ИЛИ КодСчетаРодителя = "509" Тогда
			ВалютаБаланса =  ВалютаБаланса + ВыборкаДетальныеЗаписи.СуммаОстаток;
			Продолжить;
		КонецЕсли;
		Если КодСчета = "47423" ИЛИ КодСчета = "47422" Тогда
			ВалютаБаланса =  ВалютаБаланса + ВыборкаДетальныеЗаписи.СуммаОстаток;
			Продолжить;
		ИначеЕсли КодСчета = "47407" ИЛИ КодСчета = "47408" Тогда
			Продолжить;
		КонецЕсли;
		Если Лев(КодСчета, 1) = "7" ИЛИ Лев(КодСчета, 1) = "9" Тогда
			Продолжить;
		КонецЕсли;
		Если ВыборкаДетальныеЗаписи.ВидСчета  <> ВидСчета.Пассивный Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Счет " + ВыборкаДетальныеЗаписи.Счет + " не включен в объем средств в управлении");
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВалютаБаланса;
	
КонецФункции

Функция ОпределитьНаличиеПорученияНаПереоценку(Организация, СчетДоверительногоУправления, ДатаПереоценки, ВидУчета, ВидАктива) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ВидУчета",						ВидУчета);
	Запрос.УстановитьПараметр("ВидАктива",						ВидАктива);

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПорученияНаПереоценку.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.ПорученияНаПереоценку КАК ПорученияНаПереоценку
		|ГДЕ
		|	ПорученияНаПереоценку.Организация = &Организация
		|	И ПорученияНаПереоценку.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПорученияНаПереоценку.ДатаПереоценки = &ДатаПереоценки
		|	И ПорученияНаПереоценку.ВидУчета = &ВидУчета
		|	И ПорученияНаПереоценку.ВидАктива = &ВидАктива";
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ПолучитьТаблицуКотировок(Объект, МенеджерВременныхТаблиц, РабочаяДатаПереоценки)

	Запрос = Новый Запрос;
	
	Организация 					= Объект.Организация;
	СчетДоверительногоУправления 	= Объект.СчетДоверительногоУправления;
	ВидУчета 						= Объект.ВидУчета;
	Период 							= НачалоДня(Объект.Дата);
	ВариантРасчетаСтоимости 		= Объект.ВариантРасчетаОценочнойСтоимости;
	
	ЦельРасчета						= Неопределено;
	ТолькоБумагиВРЕПО				= Ложь;

	ЭтоПереоценкаЦенныхБумаг = (ТипЗнч(Объект) = Тип("ДокументОбъект.ПереоценкаЦенныхБумаг"));

	Если ЭтоПереоценкаЦенныхБумаг Тогда
		ЦельРасчета = БухгалтерскийУчет.ОпределитьЦельРасчетаПоВидуУчета(ВидУчета);
	Иначе
		Объект.Свойство("ЦельРасчета", ЦельРасчета);
		Если НЕ Объект.Свойство("ТолькоБумагиВРЕПО", ТолькоБумагиВРЕПО) Тогда
			ТолькоБумагиВРЕПО = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(Объект) = Тип("Структура") И Объект.Свойство("РассчитыватьЦены") Тогда
		РассчитыватьЦены = Объект.РассчитыватьЦены;
	Иначе
		РассчитыватьЦены = Не ЭтоПереоценкаЦенныхБумаг;
	КонецЕсли;
	
	#Область Помещаем_таблицу_партий_и_стоимость_переоценки_в_ВТ
	
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		
		Если ТипЗнч(Объект) = Тип("Структура") Тогда
			ЦенныеБумаги = Объект.ЦенныеБумаги;
		Иначе
			ЦенныеБумаги = Объект.ЦенныеБумаги.Выгрузить();
		КонецЕсли; 
		
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
		|	НЕОПРЕДЕЛЕНО КАК ТипЗадолженности,
		|	БухПартииЦенныхБумагОстатки.Партия КАК Основание,
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.Партия.Дата КАК ДатаПартии,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
		|	ВЫБОР
		|		КОГДА &ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|			ТОГДА (БухПартииЦенныхБумагОстатки.СтоимостьОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаОстаток + БухПартииЦенныхБумагОстатки.ИндексацияНоминалаОстаток) / БухПартииЦенныхБумагОстатки.КоличествоОстаток
		|		ИНАЧЕ (БухПартииЦенныхБумагОстатки.СтоимостьОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаОстаток) / БухПартииЦенныхБумагОстатки.КоличествоОстаток
		|	КОНЕЦ КАК БалансоваяЦена,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследних.Номинал, 0) = 0
		|						ТОГДА 0
		|					ИНАЧЕ ВЫБОР
		|							КОГДА &ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|								ТОГДА (БухПартииЦенныхБумагОстатки.СтоимостьОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаОстаток + БухПартииЦенныхБумагОстатки.ИндексацияНоминалаОстаток) / БухПартииЦенныхБумагОстатки.КоличествоОстаток / НоминалыЦенныхБумагСрезПоследних.Номинал * 100
		|							ИНАЧЕ (БухПартииЦенныхБумагОстатки.СтоимостьОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаОстаток) / БухПартииЦенныхБумагОстатки.КоличествоОстаток / НоминалыЦенныхБумагСрезПоследних.Номинал * 100
		|						КОНЕЦ
		|				КОНЕЦ
		|		ИНАЧЕ (БухПартииЦенныхБумагОстатки.СтоимостьОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаОстаток) / БухПартииЦенныхБумагОстатки.КоличествоОстаток
		|	КОНЕЦ КАК БалансоваяЦенаПроцент,
		|	ВЫБОР
		|		КОГДА &ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|			ТОГДА БухПартииЦенныхБумагОстатки.СтоимостьОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаОстаток + БухПартииЦенныхБумагОстатки.ИндексацияНоминалаОстаток
		|		ИНАЧЕ БухПартииЦенныхБумагОстатки.СтоимостьОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаОстаток
		|	КОНЕЦ КАК БалансоваяСумма,
		|	(БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток) / БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК БалансоваяЦенаКупона,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток КАК БалансоваяСуммаКупона,
		|	ВЫБОР
		|		КОГДА &ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|			ТОГДА БухПартииЦенныхБумагОстатки.ИндексацияНоминалаОстаток
		|		ИНАЧЕ БухПартииЦенныхБумагОстатки.ИндексацияНоминалаЗаВремяВладенияОстаток
		|	КОНЕЦ КАК БалансоваяИндексацияНоминала,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаОстаток КАК Переоценка,
		|	0 КАК ПереоценкаНаБалансе,
		|	0 КАК ПереоценкаНаБалансеВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток КАК ПереоценкаКупона,
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияОстаток КАК НачальныеДисконтПремия,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток КАК БалансовыеДисконтПремия,
		|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток КАК БалансоваяРазницаППНеНаблюдаемыеДанные,
		|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальнаяОстаток КАК НачальнаяРазницаППНеНаблюдаемыеДанные,
		|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток КАК БалансоваяКорректировкаЭСП,
		|	БухПартииЦенныхБумагОстатки.РасходыПриПокупкеВСтоимостиОстаток КАК РасходыПриПокупкеВСтоимости,
		|	ВЫБОР
		|		КОГДА &ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|			ТОГДА БухПартииЦенныхБумагОстатки.СтоимостьВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.ИндексацияНоминалаОстаток
		|		ИНАЧЕ БухПартииЦенныхБумагОстатки.СтоимостьВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток
		|	КОНЕЦ КАК БалансоваяСуммаВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаВВалютеУчетаОстаток КАК БалансоваяСуммаКупонаВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток КАК ПереоценкаВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаВВалютеУчетаОстаток КАК ПереоценкаКупонаВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйВВалютеУчетаОстаток КАК БалансовыеДисконтПремияВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПВВалютеУчетаОстаток КАК БалансоваяКорректировкаЭСПВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчетаОстаток КАК БалансоваяРазницаППНеНаблюдаемыеДанныеВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.СуммаРезервовПодОбесценениеОстаток КАК СуммаРезервовПодОбесценение,
		|	БухПартииЦенныхБумагОстатки.СтоимостьОстаток КАК Стоимость,
		|	БухПартииЦенныхБумагОстатки.СтоимостьВВалютеУчетаОстаток КАК СтоимостьВВалютеУчета
		|ПОМЕСТИТЬ ТаблицаПартийЦБ
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета
		|				И &Условия) КАК БухПартииЦенныхБумагОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&Период, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|ГДЕ
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток <> 0
		|";
		
		Если ТолькоБумагиВРЕПО Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухПартииЦенныхБумаг", "БухПартииЦенныхБумагПроданныеВРепо");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВЫБРАТЬ РАЗРЕШЕННЫЕ", "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагПроданныеВРепоОстатки.ПродажаРЕПО КАК ПродажаРЕПО,
			|	БухПартииЦенныхБумагПроданныеВРепоОстатки.СтрокаПродажиРЕПО КАК СтрокаПродажиРЕПО,
			| ");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условия", "УчетныйАктивЕПС <> ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО) И &Условия");
			
		
		КонецЕсли;
		
		Если РассчитыватьЦены Тогда
		
			Запрос.Текст = Запрос.Текст + ";
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьПереоценки.Период КАК Период,
			|	СтоимостьПереоценки.Регистратор КАК Регистратор,
			|	СтоимостьПереоценки.НомерСтроки КАК НомерСтроки,
			|	СтоимостьПереоценки.Активность КАК Активность,
			|	СтоимостьПереоценки.Организация КАК Организация,
			|	СтоимостьПереоценки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СтоимостьПереоценки.ВидУчета КАК ВидУчета,
			|	СтоимостьПереоценки.Рынок КАК Рынок,
			|	СтоимостьПереоценки.ВидЦеныОценки КАК ВидЦеныОценки,
			|	СтоимостьПереоценки.ЦельРасчета КАК ЦельРасчета,
			|	СтоимостьПереоценки.Сумма КАК Сумма,
			|	СтоимостьПереоценки.ЦенаКупона КАК Купон,
			|	СтоимостьПереоценки.Количество КАК Количество,
			|	СтоимостьПереоценки.ВидЦены КАК ВидЦены,
			|	СтоимостьПереоценки.УровеньОценки КАК УровеньОценки,
			|	СтоимостьПереоценки.ДатаЦены КАК ДатаЦены,
			|	СтоимостьПереоценки.ЦенаКотировки КАК ЦенаКотировки,
			|	СтоимостьПереоценки.ВалютаКотировки КАК ВалютаКотировки,
			|	СтоимостьПереоценки.Источник КАК Источник,
			|	НЕОПРЕДЕЛЕНО КАК ТипЗадолженности,
			|	СтоимостьПереоценки.Партия КАК Основание,
			|	СтоимостьПереоценки.РучнойВвод КАК РучнойВвод,
			|	СтоимостьПереоценки.Партия КАК Партия,
			|	СтоимостьПереоценки.СтрокаПартии КАК СтрокаПартии,
			|	СтоимостьПереоценки.КурсВалютыНоминала КАК КурсВалютыНоминала
			|ПОМЕСТИТЬ СтоимостьПереоценки
			|ИЗ
			|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
			|ГДЕ
			|	СтоимостьПереоценки.Период = &ДатаЦен
			|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И (&ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ЕдиныйПланСчетов)
			|				И СтоимостьПереоценки.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
			|			ИЛИ СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета)";
			
			Если ТолькоБумагиВРЕПО Тогда
				Запрос.Текст = Запрос.Текст + " И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)";
			КонецЕсли;
		КонецЕсли;
				
		Если ЦенныеБумаги = Неопределено Или ЦенныеБумаги.Количество() = 0 ИЛИ ЭтоПереоценкаЦенныхБумаг ИЛИ ТолькоБумагиВРЕПО Тогда
			// формируем выборку по всем остаткам
			Запрос.УстановитьПараметр("Условия", Истина);
		Иначе
			// устанавливаем отбор по таблице, в зависимости от переданных колонок
			Условия = "";
			Для каждого Колонка Из ЦенныеБумаги.Колонки Цикл
				Если Колонка.Имя = "ЦеннаяБумага" ИЛИ Колонка.Имя = "Рынок" ИЛИ Колонка.Имя = "Партия" Тогда
					Если СтрДлина(Условия) = 0 Тогда
						Условия = "(" + Колонка.Имя;
					Иначе
						Условия = Условия + ", " + Колонка.Имя;
					КонецЕсли; 
				КонецЕсли; 
			КонецЦикла; 
			Условия = Условия + ") В (&ЦенныеБумаги)";
			Запрос.УстановитьПараметр("ЦенныеБумаги", ЦенныеБумаги);
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условия", Условия);
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(Период), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("ДатаЦен", НачалоДня(Период));
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ЦельРасчета", ЦельРасчета);
		
		Запрос.Выполнить();
		
	Иначе
		
		//проверим, если оценочных цен нет, то запросим.
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("СтоимостьПереоценки") = Неопределено И РассчитыватьЦены Тогда
			//в регистр не пишется ТипЗадолженности и Основание, т.к. они заполняются только при динамическом расчете
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьПереоценки.Период КАК Период,
			|	СтоимостьПереоценки.Регистратор КАК Регистратор,
			|	СтоимостьПереоценки.НомерСтроки КАК НомерСтроки,
			|	СтоимостьПереоценки.Активность КАК Активность,
			|	СтоимостьПереоценки.Организация КАК Организация,
			|	СтоимостьПереоценки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	НЕОПРЕДЕЛЕНО КАК ТипЗадолженности,
			|	СтоимостьПереоценки.Партия КАК Основание,
			|	СтоимостьПереоценки.Партия КАК Партия,
			|	СтоимостьПереоценки.СтрокаПартии КАК СтрокаПартии,
			|	СтоимостьПереоценки.ВидУчета КАК ВидУчета,
			|	СтоимостьПереоценки.Рынок КАК Рынок,
			|	СтоимостьПереоценки.ВидЦеныОценки КАК ВидЦеныОценки,
			|	СтоимостьПереоценки.ЦельРасчета КАК ЦельРасчета,
			|	СтоимостьПереоценки.ЦенаКупона КАК Купон,
			|	СтоимостьПереоценки.Количество КАК Количество,
			|	СтоимостьПереоценки.ВидЦены КАК ВидЦены,
			|	СтоимостьПереоценки.УровеньОценки КАК УровеньОценки,
			|	СтоимостьПереоценки.ДатаЦены КАК ДатаЦены,
			|	СтоимостьПереоценки.Цена КАК Цена,
			|	СтоимостьПереоценки.Сумма КАК Сумма,
			|	СтоимостьПереоценки.ЦенаКотировки КАК ЦенаКотировки,
			|	СтоимостьПереоценки.ВалютаКотировки КАК ВалютаКотировки,
			|	СтоимостьПереоценки.Источник КАК Источник,
			|	СтоимостьПереоценки.РучнойВвод КАК РучнойВвод,
			|	СтоимостьПереоценки.КурсВалютыНоминала КАК КурсВалютыНоминала
			|ПОМЕСТИТЬ СтоимостьПереоценки
			|ИЗ
			|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
			|ГДЕ
			|	СтоимостьПереоценки.Период = &ДатаЦен
			|	И СтоимостьПереоценки.Организация = &Организация
			|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета
			|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)";
			
			Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
			Запрос.УстановитьПараметр("Организация", Организация);
			Запрос.УстановитьПараметр("ДатаЦен", НачалоДня(Период));
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("ЦельРасчета", ЦельРасчета);
			
