	|	ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяЦена КАК ОценочнаяЦена,
	|	ПереоценкаЦенныхБумагЦенныеБумаги.ВалютаНоминала КАК ВалютаНоминала,
	|	ПереоценкаЦенныхБумагЦенныеБумаги.КурсВалютыНоминала КАК КурсВалютыНоминала,
	|	СУММА(ПереоценкаЦенныхБумагЦенныеБумаги.Количество) КАК Количество,
	|	СУММА(ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяСумма) КАК ОценочнаяСумма,
	|	СУММА(ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяСуммаВВалютеУчета) КАК ОценочнаяСуммаВВалютеУчета,
	|	СУММА(ПереоценкаЦенныхБумагЦенныеБумаги.КоличествоСтрок) КАК КоличествоСтрок
	|ПОМЕСТИТЬ ЦенныеБумагиСГруппировкой
	|ИЗ
	|	ПереоценкаЦенныхБумагЦенныеБумаги КАК ПереоценкаЦенныхБумагЦенныеБумаги
	|
	|СГРУППИРОВАТЬ ПО
	|	ПереоценкаЦенныхБумагЦенныеБумаги.ИсточникЦены,
	|	ПереоценкаЦенныхБумагЦенныеБумаги.ЦеннаяБумага,
	|	ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяЦена,
	|	ПереоценкаЦенныхБумагЦенныеБумаги.ВалютаНоминала,
	|	ПереоценкаЦенныхБумагЦенныеБумаги.КурсВалютыНоминала
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦенныеБумагиСГруппировкой.КоличествоСтрок КАК КоличествоСтрок,
	|	ЦенныеБумагиСГруппировкой.ИсточникЦены КАК ИсточникЦены,
	|	ЦенныеБумагиСГруппировкой.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ЦенныеБумагиСГруппировкой.Количество КАК Количество,
	|	ЦенныеБумагиСГруппировкой.ОценочнаяЦена КАК ОценочнаяЦена,
	|	ЦенныеБумагиСГруппировкой.ОценочнаяСумма КАК ОценочнаяСумма,
	|	ВЫБОР
	|		КОГДА ЦенныеБумагиСГруппировкой.ВалютаНоминала <> &ВалютаУчета
	|			ТОГДА ВЫРАЗИТЬ(ЦенныеБумагиСГруппировкой.Количество * ЦенныеБумагиСГруппировкой.ОценочнаяЦена КАК ЧИСЛО(27, 4))
	|		ИНАЧЕ ВЫРАЗИТЬ(ЦенныеБумагиСГруппировкой.Количество * ЦенныеБумагиСГруппировкой.ОценочнаяЦена КАК ЧИСЛО(27, 2))
	|	КОНЕЦ КАК ОценочнаяСуммаРасчет,
	|	ВЫБОР
	|		КОГДА ЦенныеБумагиСГруппировкой.ВалютаНоминала <> &ВалютаУчета
	|			ТОГДА (ВЫРАЗИТЬ(ЦенныеБумагиСГруппировкой.Количество * ЦенныеБумагиСГруппировкой.ОценочнаяЦена КАК ЧИСЛО(27, 4))) - (ВЫРАЗИТЬ(ЦенныеБумагиСГруппировкой.ОценочнаяСумма КАК ЧИСЛО(27, 4)))
	|		ИНАЧЕ (ВЫРАЗИТЬ(ЦенныеБумагиСГруппировкой.Количество * ЦенныеБумагиСГруппировкой.ОценочнаяЦена КАК ЧИСЛО(27, 2))) - (ВЫРАЗИТЬ(ЦенныеБумагиСГруппировкой.ОценочнаяСумма КАК ЧИСЛО(27, 2)))
	|	КОНЕЦ КАК Погрешность,
	|	ВЫБОР
	|		КОГДА ЦенныеБумагиСГруппировкой.КурсВалютыНоминала > 0
	|			ТОГДА ЦенныеБумагиСГруппировкой.КурсВалютыНоминала
	|		ИНАЧЕ КурсыВалют.Курс
	|	КОНЕЦ КАК Курс,
	|	ВЫБОР
	|		КОГДА ЦенныеБумагиСГруппировкой.КурсВалютыНоминала > 0
	|			ТОГДА 1
	|		ИНАЧЕ КурсыВалют.Кратность
	|	КОНЕЦ КАК Кратность,
	|	ВЫРАЗИТЬ(ЦенныеБумагиСГруппировкой.ОценочнаяСуммаВВалютеУчета КАК ЧИСЛО(27, 2)) КАК ОценочнаяСуммаВВалютеУчета
	|ИЗ
	|	ЦенныеБумагиСГруппировкой КАК ЦенныеБумагиСГруппировкой
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
	|		ПО ЦенныеБумагиСГруппировкой.ВалютаНоминала = КурсыВалют.Валюта
	|			И (КурсыВалют.Период = &Период)
	|ГДЕ
	|	(ЦенныеБумагиСГруппировкой.Количество * ЦенныеБумагиСГруппировкой.ОценочнаяЦена <> ЦенныеБумагиСГруппировкой.ОценочнаяСумма
	|			ИЛИ ВЫБОР
	|				КОГДА ЦенныеБумагиСГруппировкой.КурсВалютыНоминала > 0
	|					ТОГДА ЦенныеБумагиСГруппировкой.КурсВалютыНоминала <> 1
	|				ИНАЧЕ КурсыВалют.Курс <> 1
	|						ИЛИ КурсыВалют.Кратность <> 1
	|			КОНЕЦ)
	|	И ЦенныеБумагиСГруппировкой.КоличествоСтрок > 1";
	
	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		Запрос.УстановитьПараметр("ЦенныеБумаги", Объект.ЦенныеБумаги);
	Иначе 
		Запрос.УстановитьПараметр("ЦенныеБумаги", Объект.ЦенныеБумаги.Выгрузить(,"ИсточникЦены,ЦеннаяБумага,Количество,ОценочнаяЦена,ОценочнаяСумма,ОценочнаяСуммаВВалютеУчета,КурсВалютыНоминала,УчетныйАктивЕПС"));
	КонецЕсли;
	Запрос.УстановитьПараметр("Период", НачалоДня(Объект.Дата));
	
	ВалютаУчета = Объект.Организация.ВалютаУчета;
	
	Запрос.УстановитьПараметр("ВалютаУчета", ВалютаУчета);
	
	Если ТипЗнч(ТочностьВалютнойСуммы) = Тип("Число") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЧИСЛО(27, 4)", СтрШаблон("ЧИСЛО(27, %1)", ТочностьВалютнойСуммы));
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Расхождения = РезультатЗапроса.Выгрузить();
	
	Для каждого СтрокаРасхождения Из Расхождения Цикл
		
		ПогрешностьКРаспределению = СтрокаРасхождения.Погрешность;
		
		КоличествоКРаспределению = СтрокаРасхождения.Количество;
		
		СтрокиСЦеннойБумагой = Объект.ЦенныеБумаги.НайтиСтроки(Новый Структура("ЦеннаяБумага", СтрокаРасхождения.ЦеннаяБумага));
		
		Если СтрокаРасхождения.Курс = 1 И СтрокаРасхождения.Кратность = 1 Тогда // рублевые бумаги
			
			Если ЭтоЕПС И Объект.Дата > '20230101' И БухгалтерскийУчетЕПС.ЭтоКлиентГруппыБудущее(Объект.СчетДоверительногоУправления, Объект.Дата) Тогда // сбивается для рублевых
				ПогрешностьКРаспределению = Окр(СтрокаРасхождения.ОценочнаяЦена * СтрокаРасхождения.Количество, 2) - Окр(СтрокаРасхождения.ОценочнаяСумма, 2);
			КонецЕсли;
			
			ПогрешностьКРаспределениюВВалютеУчета = ПогрешностьКРаспределению;
			
		Иначе // валютные бумаги
			Если (ТипЗнч(СтрокаРасхождения.ЦеннаяБумага) = Тип("СправочникСсылка.Акции") // валютные акции с котировкой с ММВБ
				И СтрокаРасхождения.Курс <> 1
				И СтрокаРасхождения.ИсточникЦены = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ").ЮрФизЛицо)
				ИЛИ Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(Объект.СчетДоверительногоУправления, Объект.Дата) = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Большой") Тогда 
				
				ОценочнаяСуммаВВалютеУчетаРасчет = Окр(СтрокаРасхождения.ОценочнаяЦена * СтрокаРасхождения.Количество * СтрокаРасхождения.Курс / СтрокаРасхождения.Кратность, 2);
			Иначе // все остальное
				ОценочнаяСуммаВВалютеУчетаРасчет = Окр(СтрокаРасхождения.ОценочнаяСуммаРасчет * СтрокаРасхождения.Курс / СтрокаРасхождения.Кратность, 2);
				
			КонецЕсли;
			ПогрешностьКРаспределениюВВалютеУчета = ОценочнаяСуммаВВалютеУчетаРасчет - СтрокаРасхождения.ОценочнаяСуммаВВалютеУчета;
			
		КонецЕсли;
			
		Если ПогрешностьКРаспределению = 0 И ПогрешностьКРаспределениюВВалютеУчета = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если НастройкиПоВидуУчета.МетодУчетаПогрешностиОкругления = Перечисления.МетодыУчетаПогрешностиОкругления.РавномерноеРаспределение
			ИЛИ НЕ ЭтоЕПС Тогда
		
			Для каждого СтрокаСЦеннойБумагой Из СтрокиСЦеннойБумагой Цикл
				
				Если СтрокаСЦеннойБумагой.ОценочнаяЦена <> СтрокаРасхождения.ОценочнаяЦена Тогда
					Продолжить;
				КонецЕсли;
				
				Погрешность = 0;
				Если ОкруглитьДляВалютныхСумм Тогда
					
					Если КоличествоКРаспределению <> 0 Тогда
						Погрешность = Окр(ПогрешностьКРаспределению / КоличествоКРаспределению * СтрокаСЦеннойБумагой.Количество, 2);
					КонецЕсли;
					
				КонецЕсли;
				
				ПогрешностьВВалютеУчета = 0;
				Если ОкруглитьДляСуммВВалютеУчета Тогда
					
					Если КоличествоКРаспределению <> 0 Тогда
						ПогрешностьВВалютеУчета = Окр(ПогрешностьКРаспределениюВВалютеУчета / КоличествоКРаспределению * СтрокаСЦеннойБумагой.Количество, 2);
					КонецЕсли;
					
				КонецЕсли;
				
				Если Погрешность <> 0 ИЛИ ПогрешностьВВалютеУчета <> 0 Тогда
					
					СтрокаСЦеннойБумагой.ОценочнаяСумма = СтрокаСЦеннойБумагой.ОценочнаяСумма + Погрешность;
					Если СтрокаСЦеннойБумагой.ЦеннаяБумага.ВалютаНоминала = ВалютаУчета Тогда
						СтрокаСЦеннойБумагой.ОценочнаяСуммаВВалютеУчета = СтрокаСЦеннойБумагой.ОценочнаяСуммаВВалютеУчета + Погрешность;
					Иначе
						СтрокаСЦеннойБумагой.ОценочнаяСуммаВВалютеУчета = СтрокаСЦеннойБумагой.ОценочнаяСуммаВВалютеУчета + ПогрешностьВВалютеУчета;
					КонецЕсли;
					
					ПогрешностьКРаспределению = ПогрешностьКРаспределению - Погрешность;
					ПогрешностьКРаспределениюВВалютеУчета = ПогрешностьКРаспределениюВВалютеУчета - ПогрешностьВВалютеУчета;
				КонецЕсли;
				
				КоличествоКРаспределению = КоличествоКРаспределению - СтрокаСЦеннойБумагой.Количество;
				
			КонецЦикла;
			
		ИначеЕсли НастройкиПоВидуУчета.МетодУчетаПогрешностиОкругления = Перечисления.МетодыУчетаПогрешностиОкругления.НаСтрокуСНаибольшимКоличеством Тогда
			
			СтрокаСНаибольшимКоличеством = Неопределено;
			НаибольшееКоличество = 0;
			
			Для каждого СтрокаСЦеннойБумагой Из СтрокиСЦеннойБумагой Цикл
				
				Если СтрокаСЦеннойБумагой.ОценочнаяЦена <> СтрокаРасхождения.ОценочнаяЦена Тогда
					Продолжить;
				КонецЕсли;
				
				Если НаибольшееКоличество < СтрокаСЦеннойБумагой.Количество
					ИЛИ (НаибольшееКоличество = СтрокаСЦеннойБумагой.Количество
						И СтрокаСЦеннойБумагой.Партия.Дата > СтрокаСНаибольшимКоличеством.Партия.Дата) Тогда
				
					СтрокаСНаибольшимКоличеством = СтрокаСЦеннойБумагой;
					НаибольшееКоличество = СтрокаСЦеннойБумагой.Количество;
					
				КонецЕсли;
				
			КонецЦикла;
			
			СтрокаСНаибольшимКоличеством.ОценочнаяСумма = СтрокаСНаибольшимКоличеством.ОценочнаяСумма + ПогрешностьКРаспределению;
			Если СтрокаСНаибольшимКоличеством.ЦеннаяБумага.ВалютаНоминала = ВалютаУчета Тогда
				СтрокаСНаибольшимКоличеством.ОценочнаяСуммаВВалютеУчета = СтрокаСНаибольшимКоличеством.ОценочнаяСуммаВВалютеУчета + ПогрешностьКРаспределению;
			Иначе
				СтрокаСНаибольшимКоличеством.ОценочнаяСуммаВВалютеУчета = СтрокаСНаибольшимКоличеством.ОценочнаяСуммаВВалютеУчета + ПогрешностьКРаспределениюВВалютеУчета;
			КонецЕсли;
			
		ИначеЕсли НастройкиПоВидуУчета.МетодУчетаПогрешностиОкругления = Перечисления.МетодыУчетаПогрешностиОкругления.НаПоследнююПартию Тогда
			
			СтрокаСПоследнейПартией = СтрокиСЦеннойБумагой[СтрокиСЦеннойБумагой.Количество() - 1];
			
			СтрокаСПоследнейПартией.ОценочнаяСумма = СтрокаСПоследнейПартией.ОценочнаяСумма + ПогрешностьКРаспределению;
			Если СтрокаСПоследнейПартией.ЦеннаяБумага.ВалютаНоминала = ВалютаУчета Тогда
				СтрокаСПоследнейПартией.ОценочнаяСуммаВВалютеУчета = СтрокаСПоследнейПартией.ОценочнаяСуммаВВалютеУчета + ПогрешностьКРаспределению;
			Иначе
				СтрокаСПоследнейПартией.ОценочнаяСуммаВВалютеУчета = СтрокаСПоследнейПартией.ОценочнаяСуммаВВалютеУчета + ПогрешностьКРаспределениюВВалютеУчета;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РаспределитьПогрешностьОкругленияКупонаЦенныхБумагНаПартии(Объект, ЦельРасчета, НастройкиЦелейРасчета, ОкруглитьДляВалютныхСумм, ОкруглитьДляСуммВВалютеУчета, Отказ, ТочностьВалютнойСуммы = Неопределено) Экспорт
	
	Если Объект.ЦенныеБумаги.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ОкруглитьДляВалютныхСумм Тогда
		ОкруглитьДляСуммВВалютеУчета = Истина;
	КонецЕсли;
	
	ЭтоЕПС = ЦельРасчета = Справочники.ЦелиРасчета.ЕдиныйПланСчетов;
	ЭтоНУ = ЦельРасчета = Справочники.ЦелиРасчета.НалоговыйУчет;
	
	Если ЭтоНУ Тогда // для цели расчета НУ нет настроек
		ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет;
	Иначе
		ВидУчета = ОпределитьВидУчета(Объект.Организация, Объект.СчетДоверительногоУправления, ЦельРасчета, Объект.Дата);
	КонецЕсли;
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, ВидУчета, Отказ);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦенныеБумаги.Рынок КАК Рынок,
	|	ЦенныеБумаги.ИсточникЦены КАК ИсточникЦены,
	|	ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ЦенныеБумаги.Количество КАК Количество,
	|	ЦенныеБумаги.ОценочнаяЦенаКупона КАК ОценочнаяЦенаКупона,
	|	ЦенныеБумаги.ОценочнаяСуммаКупона КАК ОценочнаяСуммаКупона,
	|	ЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета КАК ОценочнаяСуммаКупонаВВалютеУчета,
	|	ЦенныеБумаги.КурсВалютыНоминала КАК КурсВалютыНоминала,
	|	1 КАК КоличествоСтрок
	|ПОМЕСТИТЬ ПереоценкаЦенныхБумагЦенныеБумаги1
	|ИЗ
	|	&ЦенныеБумаги КАК ЦенныеБумаги
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.ИсточникЦены КАК ИсточникЦены,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага КАК ЦеннаяБумага,
	|	Облигации.ВалютаНоминала КАК ВалютаНоминала,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.Количество КАК Количество,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.ОценочнаяЦенаКупона КАК ОценочнаяЦенаКупона,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.ОценочнаяСуммаКупона КАК ОценочнаяСуммаКупона,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.ОценочнаяСуммаКупонаВВалютеУчета КАК ОценочнаяСуммаКупонаВВалютеУчета,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.КурсВалютыНоминала КАК КурсВалютыНоминала,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.КоличествоСтрок КАК КоличествоСтрок
	|ПОМЕСТИТЬ ПереоценкаЦенныхБумагЦенныеБумаги
	|ИЗ
	|	ПереоценкаЦенныхБумагЦенныеБумаги1 КАК ПереоценкаЦенныхБумагЦенныеБумаги1
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
	|		ПО ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага = Облигации.Ссылка
	|ГДЕ
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПереоценкаЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяЦенаКупона КАК ОценочнаяЦенаКупона,
	|	ПереоценкаЦенныхБумагЦенныеБумаги.ВалютаНоминала КАК ВалютаНоминала,
	|	ПереоценкаЦенныхБумагЦенныеБумаги.КурсВалютыНоминала КАК КурсВалютыНоминала,
	|	СУММА(ПереоценкаЦенныхБумагЦенныеБумаги.Количество) КАК Количество,
	|	СУММА(ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяСуммаКупона) КАК ОценочнаяСуммаКупона,
	|	СУММА(ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета) КАК ОценочнаяСуммаКупонаВВалютеУчета,
	|	СУММА(ПереоценкаЦенныхБумагЦенныеБумаги.КоличествоСтрок) КАК КоличествоСтрок
	|ПОМЕСТИТЬ ЦенныеБумагиСГруппировкой
	|ИЗ
	|	ПереоценкаЦенныхБумагЦенныеБумаги КАК ПереоценкаЦенныхБумагЦенныеБумаги
	|
	|СГРУППИРОВАТЬ ПО
	|	ПереоценкаЦенныхБумагЦенныеБумаги.ЦеннаяБумага,
	|	ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяЦенаКупона,
	|	ПереоценкаЦенныхБумагЦенныеБумаги.ВалютаНоминала,
	|	ПереоценкаЦенныхБумагЦенныеБумаги.КурсВалютыНоминала
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦенныеБумагиСГруппировкой.КоличествоСтрок КАК КоличествоСтрок,
	|	ЦенныеБумагиСГруппировкой.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ЦенныеБумагиСГруппировкой.Количество КАК Количество,
	|	ЦенныеБумагиСГруппировкой.ОценочнаяЦенаКупона КАК ОценочнаяЦенаКупона,
	|	ЦенныеБумагиСГруппировкой.ОценочнаяСуммаКупона КАК ОценочнаяСуммаКупона,
	|	ВЫБОР
	|		КОГДА &ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.БухгалтерскийУчет)
	|			ТОГДА ВЫРАЗИТЬ(ЦенныеБумагиСГруппировкой.Количество * ЦенныеБумагиСГруппировкой.ОценочнаяЦенаКупона КАК ЧИСЛО(21, 4))
	|		ИНАЧЕ ВЫРАЗИТЬ(ЦенныеБумагиСГруппировкой.Количество * ЦенныеБумагиСГруппировкой.ОценочнаяЦенаКупона КАК ЧИСЛО(21, 2))
	|	КОНЕЦ КАК ОценочнаяСуммаКупонаРасчет,
	|	ВЫБОР
	|		КОГДА &ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.БухгалтерскийУчет)
	|			ТОГДА (ВЫРАЗИТЬ(ЦенныеБумагиСГруппировкой.Количество * ЦенныеБумагиСГруппировкой.ОценочнаяЦенаКупона КАК ЧИСЛО(21, 4))) - (ВЫРАЗИТЬ(ЦенныеБумагиСГруппировкой.ОценочнаяСуммаКупона КАК ЧИСЛО(21, 4)))
	|		ИНАЧЕ (ВЫРАЗИТЬ(ЦенныеБумагиСГруппировкой.Количество * ЦенныеБумагиСГруппировкой.ОценочнаяЦенаКупона КАК ЧИСЛО(21, 2))) - (ВЫРАЗИТЬ(ЦенныеБумагиСГруппировкой.ОценочнаяСуммаКупона КАК ЧИСЛО(21, 2)))
	|	КОНЕЦ КАК Погрешность,
	|	ВЫБОР
	|		КОГДА ЦенныеБумагиСГруппировкой.КурсВалютыНоминала > 0
	|			ТОГДА ЦенныеБумагиСГруппировкой.КурсВалютыНоминала
	|		ИНАЧЕ КурсыВалют.Курс
	|	КОНЕЦ КАК Курс,
	|	ВЫБОР
	|		КОГДА ЦенныеБумагиСГруппировкой.КурсВалютыНоминала > 0
	|			ТОГДА 1
	|		ИНАЧЕ КурсыВалют.Кратность
	|	КОНЕЦ КАК Кратность,
	|	ЦенныеБумагиСГруппировкой.ОценочнаяСуммаКупонаВВалютеУчета КАК ОценочнаяСуммаКупонаВВалютеУчета
	|ИЗ
	|	ЦенныеБумагиСГруппировкой КАК ЦенныеБумагиСГруппировкой
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
	|		ПО ЦенныеБумагиСГруппировкой.ВалютаНоминала = КурсыВалют.Валюта
	|			И (КурсыВалют.Период = &Период)
	|ГДЕ
	|	(ЦенныеБумагиСГруппировкой.Количество * ЦенныеБумагиСГруппировкой.ОценочнаяЦенаКупона <> ЦенныеБумагиСГруппировкой.ОценочнаяСуммаКупона
	|			ИЛИ ВЫБОР
	|				КОГДА ЦенныеБумагиСГруппировкой.КурсВалютыНоминала > 0
	|					ТОГДА ЦенныеБумагиСГруппировкой.КурсВалютыНоминала <> 1
	|				ИНАЧЕ КурсыВалют.Курс <> 1
	|						ИЛИ КурсыВалют.Кратность <> 1
	|			КОНЕЦ)
	|	И ЦенныеБумагиСГруппировкой.КоличествоСтрок > 1";
	
	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		Запрос.УстановитьПараметр("ЦенныеБумаги", Объект.ЦенныеБумаги);
	Иначе 
		Запрос.УстановитьПараметр("ЦенныеБумаги", Объект.ЦенныеБумаги.Выгрузить(,"Рынок,ИсточникЦены,ЦеннаяБумага,Количество,ОценочнаяЦенаКупона,ОценочнаяСуммаКупона,ОценочнаяСуммаКупонаВВалютеУчета,КурсВалютыНоминала"));
	КонецЕсли;
	Запрос.УстановитьПараметр("Период", НачалоДня(Объект.Дата));
	Запрос.УстановитьПараметр("ЦельРасчета", ЦельРасчета);
	
	Если ТипЗнч(ТочностьВалютнойСуммы) = Тип("Число") Тогда
		ТочностьЦеныОценки = ТочностьВалютнойСуммы;
	ИначеЕсли ЭтоЕПС Тогда
		ТочностьЦеныОценки = 2;
	ИначеЕсли ЭтоНУ Тогда
		ТочностьЦеныОценки = ПолучитьТочностьРасчетаОценочнойСтоимости(Новый Структура("ТочностьЦеныОценки", 0));
	Иначе
		ТочностьЦеныОценки = ПолучитьТочностьРасчетаОценочнойСтоимости(НастройкиЦелейРасчета);
	КонецЕсли;
	
	ФорматЦены = "ЧИСЛО(27, " + СокрЛП(ТочностьЦеныОценки) + ")";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЧИСЛО(21, 2)", ФорматЦены);
	
	РезультатЗапроса = Запрос.Выполнить();
	Расхождения = РезультатЗапроса.Выгрузить();
	
	ВалютаУчета = Объект.Организация.ВалютаУчета;
	
	МассивДефолтныхОблигациПоКоторымПродолжаемСчитатьПогрешность = Новый Массив;
	МассивДефолтныхОблигациПоКоторымПродолжаемСчитатьПогрешность.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1Пропертиз_Дол"));
	МассивДефолтныхОблигациПоКоторымПродолжаемСчитатьПогрешность.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1Пропертиз_До2"));
	
	Для каждого СтрокаРасхождения Из Расхождения Цикл
		
		ПогрешностьКРаспределению = СтрокаРасхождения.Погрешность;  
		КоличествоКРаспределению = СтрокаРасхождения.Количество;
		
		ОценочнаяСуммаКупона = СтрокаРасхождения.Количество * СтрокаРасхождения.ОценочнаяЦенаКупона;
		
		Если ТипЗнч(ТочностьВалютнойСуммы) = Тип("Число") Тогда
			ОценочнаяСуммаКупона = Окр(ОценочнаяСуммаКупона, ТочностьВалютнойСуммы);
		КонецЕсли;
		
		ОценочнаяСуммаКупонаВВалютеУчетаРасчет = Окр(ОценочнаяСуммаКупона * СтрокаРасхождения.Курс / СтрокаРасхождения.Кратность, 2);
		ПогрешностьКупонаКРаспределениюВВалютеУчета = ОценочнаяСуммаКупонаВВалютеУчетаРасчет - СтрокаРасхождения.ОценочнаяСуммаКупонаВВалютеУчета;
		
		Если ПогрешностьКРаспределению = 0 И ПогрешностьКупонаКРаспределениюВВалютеУчета = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиСЦеннойБумагой = Объект.ЦенныеБумаги.НайтиСтроки(Новый Структура("ЦеннаяБумага", СтрокаРасхождения.ЦеннаяБумага));
		
		Если НастройкиПоВидуУчета.МетодУчетаПогрешностиОкругления = Перечисления.МетодыУчетаПогрешностиОкругления.РавномерноеРаспределение
			ИЛИ НЕ ЭтоЕПС Тогда
		
			Для каждого СтрокаСЦеннойБумагой Из СтрокиСЦеннойБумагой Цикл
				
				Если СтрокаСЦеннойБумагой.ОценочнаяЦенаКупона <> СтрокаРасхождения.ОценочнаяЦенаКупона Тогда
					Продолжить;
				КонецЕсли;
				
				Если ЭтоЕПС И СтрокаСЦеннойБумагой.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.Дефолт 
					И МассивДефолтныхОблигациПоКоторымПродолжаемСчитатьПогрешность.Найти(СтрокаСЦеннойБумагой.ЦеннаяБумага) = Неопределено Тогда 
					Продолжить;
				КонецЕсли;
				
				Если ОкруглитьДляВалютныхСумм Тогда
					Погрешность = Окр(ПогрешностьКРаспределению / КоличествоКРаспределению * СтрокаСЦеннойБумагой.Количество, 2);
				Иначе
					Погрешность = 0;
				КонецЕсли;
				
				Если ОкруглитьДляСуммВВалютеУчета Тогда
					ПогрешностьКупонаВВалютеУчета = Окр(ПогрешностьКупонаКРаспределениюВВалютеУчета / КоличествоКРаспределению * СтрокаСЦеннойБумагой.Количество, 2);
				КонецЕсли;
				
				Если Погрешность <> 0 ИЛИ ПогрешностьКупонаВВалютеУчета <> 0 Тогда
					
					СтрокаСЦеннойБумагой.ОценочнаяСуммаКупона = СтрокаСЦеннойБумагой.ОценочнаяСуммаКупона + Погрешность;
					Если СтрокаСЦеннойБумагой.ЦеннаяБумага.ВалютаНоминала = ВалютаУчета Тогда
						СтрокаСЦеннойБумагой.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаСЦеннойБумагой.ОценочнаяСуммаКупонаВВалютеУчета + Погрешность;
					Иначе
						СтрокаСЦеннойБумагой.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаСЦеннойБумагой.ОценочнаяСуммаКупонаВВалютеУчета + ПогрешностьКупонаВВалютеУчета;
					КонецЕсли;
					
					ПогрешностьКРаспределению = ПогрешностьКРаспределению - Погрешность;
					ПогрешностьКупонаКРаспределениюВВалютеУчета = ПогрешностьКупонаКРаспределениюВВалютеУчета - ПогрешностьКупонаВВалютеУчета;
				КонецЕсли;
				
				КоличествоКРаспределению = КоличествоКРаспределению - СтрокаСЦеннойБумагой.Количество;
				
			КонецЦикла;
			
		ИначеЕсли НастройкиПоВидуУчета.МетодУчетаПогрешностиОкругления = Перечисления.МетодыУчетаПогрешностиОкругления.НаСтрокуСНаибольшимКоличеством Тогда
			
			СтрокаСНаибольшимКоличеством = Неопределено;
			НаибольшееКоличество = 0;
			
			Для каждого СтрокаСЦеннойБумагой Из СтрокиСЦеннойБумагой Цикл
				
				Если СтрокаСЦеннойБумагой.ОценочнаяЦена <> СтрокаРасхождения.ОценочнаяЦена Тогда
					Продолжить;
				КонецЕсли;
				
				Если НаибольшееКоличество < СтрокаСЦеннойБумагой.Количество
					ИЛИ (НаибольшееКоличество = СтрокаСЦеннойБумагой.Количество
						И СтрокаСЦеннойБумагой.Партия.Дата > СтрокаСНаибольшимКоличеством.Партия.Дата) Тогда
				
					СтрокаСНаибольшимКоличеством = СтрокаСЦеннойБумагой;
					НаибольшееКоличество = СтрокаСЦеннойБумагой.Количество;
					
				КонецЕсли;
				
			КонецЦикла;
			
			СтрокаСНаибольшимКоличеством.ОценочнаяСуммаКупона = СтрокаСНаибольшимКоличеством.ОценочнаяСуммаКупона + ПогрешностьКРаспределению;
			Если СтрокаСНаибольшимКоличеством.ЦеннаяБумага.ВалютаНоминала = ВалютаУчета Тогда
				СтрокаСНаибольшимКоличеством.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаСНаибольшимКоличеством.ОценочнаяСуммаКупонаВВалютеУчета + ПогрешностьКРаспределению;
			Иначе
				СтрокаСНаибольшимКоличеством.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаСНаибольшимКоличеством.ОценочнаяСуммаКупонаВВалютеУчета + ПогрешностьКупонаКРаспределениюВВалютеУчета;
			КонецЕсли;
			
		ИначеЕсли НастройкиПоВидуУчета.МетодУчетаПогрешностиОкругления = Перечисления.МетодыУчетаПогрешностиОкругления.НаПоследнююПартию Тогда
			
			СтрокаСПоследнейПартией = СтрокиСЦеннойБумагой[СтрокиСЦеннойБумагой.Количество() - 1];
			
			СтрокаСПоследнейПартией.ОценочнаяСуммаКупона = СтрокаСПоследнейПартией.ОценочнаяСуммаКупона + ПогрешностьКРаспределению;
			Если СтрокаСПоследнейПартией.ЦеннаяБумага.ВалютаНоминала = ВалютаУчета Тогда
				СтрокаСПоследнейПартией.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаСПоследнейПартией.ОценочнаяСуммаКупонаВВалютеУчета + ПогрешностьКРаспределению;
			Иначе
				СтрокаСПоследнейПартией.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаСПоследнейПартией.ОценочнаяСуммаКупонаВВалютеУчета + ПогрешностьКупонаКРаспределениюВВалютеУчета;
			КонецЕсли;
			
		КонецЕсли;			
	КонецЦикла;
	
КонецПроцедуры

Процедура РаспределитьПогрешностьОкругленияПервоначальногоПризнанияЦенныхБумагНаПартии(Объект, ЦельРасчета, НастройкиЦелейРасчета, ОкруглитьДляВалютныхСумм, ОкруглитьДляСуммВВалютеУчета, Отказ) Экспорт
	
	Если Объект.ЦенныеБумаги.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ОкруглитьДляВалютныхСумм Тогда
		ОкруглитьДляСуммВВалютеУчета = Истина;
	КонецЕсли;
	
	// Оставим только облигации
	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		ТЗЦенныеБумаги = Объект.ЦенныеБумаги.Скопировать(Объект.ЦенныеБумаги.НайтиСтроки(Новый Структура("Рынок", Перечисления.РынкиЦенныхБумаг.Облигации)));
	Иначе 
		ТЗЦенныеБумаги = Объект.ЦенныеБумаги.Выгрузить(Объект.ЦенныеБумаги.НайтиСтроки(Новый Структура("Рынок", Перечисления.РынкиЦенныхБумаг.Облигации)));
	КонецЕсли;
	
	// Оставим только те, у которых было п/п и оно начислялось
	КоличествоСтрок = ТЗЦенныеБумаги.Количество();
	Для Инд = 1 По КоличествоСтрок Цикл
		СтрокаТЗ = ТЗЦенныеБумаги[КоличествоСтрок - Инд];
		Если СтрокаТЗ.НачальнаяРазницаППНеНаблюдаемыеДанные = 0
			ИЛИ СтрокаТЗ.БалансоваяРазницаППНеНаблюдаемыеДанные = СтрокаТЗ.ОценочнаяРазницаППНеНаблюдаемыеДанные Тогда
			ТЗЦенныеБумаги.Удалить(СтрокаТЗ);
		КонецЕсли;
	КонецЦикла;
	
	// посчитаем разницу п/п на пакет
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления);
	
	// найдем даты покупок, и определим ПравильныйУчетПервоначальногоПризнания
	ТЗЦенныеБумаги.Колонки.Добавить("ДатаПокупки", Новый ОписаниеТипов("Дата"));
	ТЗЦенныеБумаги.Колонки.Добавить("ПравильныйУчетПервоначальногоПризнания", Новый ОписаниеТипов("Булево"));
	Для Каждого СтрокаТЗЦенныеБумаги Из ТЗЦенныеБумаги Цикл
		Если ТипЗнч(СтрокаТЗЦенныеБумаги.Партия) = Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда
			СтрокаВвод = СтрокаТЗЦенныеБумаги.Партия.ЦенныеБумаги.Найти(СтрокаТЗЦенныеБумаги.СтрокаПартии, "СтрокаПартии");
			СтрокаТЗЦенныеБумаги.ДатаПокупки = СтрокаВвод.ДатаПокупки;
		Иначе
			СтрокаТЗЦенныеБумаги.ДатаПокупки = НачалоДня(СтрокаТЗЦенныеБумаги.Партия.Дата);
		КонецЕсли;
		
		НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
			НастройкиУчетаОбщие,
			СтрокаТЗЦенныеБумаги.ЦеннаяБумага,
			СтрокаТЗЦенныеБумаги.УчетныйАктивЕПС,
			СтрокаТЗЦенныеБумаги.Партия,
			СтрокаТЗЦенныеБумаги.СтрокаПартии);
			
		СтрокаТЗЦенныеБумаги.ПравильныйУчетПервоначальногоПризнания = НастройкиУчетаЦеннойБумаги.ПравильныйУчетПервоначальногоПризнания;
	КонецЦикла;
	
	// создадим свернутую таблицу
	ПоляПП = "Количество,БалансоваяРазницаППНеНаблюдаемыеДанные,БалансоваяРазницаППНеНаблюдаемыеДанныеВВалютеУчета,ОценочнаяРазницаППНеНаблюдаемыеДанные,ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета,НачальнаяРазницаППНеНаблюдаемыеДанные";
	
	ТЗЦенныеБумагиСвернутые = ТЗЦенныеБумаги.Скопировать(, "ЦеннаяБумага,ДатаПокупки,УчетныйАктивЕПС,ПравильныйУчетПервоначальногоПризнания," + ПоляПП);
	
	ТЗЦенныеБумагиСвернутые.Свернуть("ЦеннаяБумага,ДатаПокупки,УчетныйАктивЕПС,ПравильныйУчетПервоначальногоПризнания", ПоляПП);
	
	ТЗЦенныеБумагиСвернутые.Колонки.Добавить("ОценочнаяРазницаППНеНаблюдаемыеДанныеРасчетная", Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	
	Для Каждого СтрокаТЗЦенныеБумагиСвернутые Из ТЗЦенныеБумагиСвернутые Цикл
		
		НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(НастройкиУчетаОбщие, СтрокаТЗЦенныеБумагиСвернутые.ЦеннаяБумага, СтрокаТЗЦенныеБумагиСвернутые.УчетныйАктивЕПС);
	
		ЗнакНачальнойРазницыПервоначальногоПризнания = ?(СтрокаТЗЦенныеБумагиСвернутые.НачальнаяРазницаППНеНаблюдаемыеДанные > 0, 1, -1);
		
		НачальнаяРазницаПервоначальногоПризнанияПлюс 	= СтрокаТЗЦенныеБумагиСвернутые.НачальнаяРазницаППНеНаблюдаемыеДанные * ЗнакНачальнойРазницыПервоначальногоПризнания;
		БалансоваяРазницаПервоначальногоПризнанияПлюс	= СтрокаТЗЦенныеБумагиСвернутые.БалансоваяРазницаППНеНаблюдаемыеДанные * ЗнакНачальнойРазницыПервоначальногоПризнания;
		
		ДатаНачалаРасчетаРазницыПП = СтрокаТЗЦенныеБумагиСвернутые.ДатаПокупки;
		
		СчитаемПоСтарому = Не СтрокаТЗЦенныеБумагиСвернутые.ПравильныйУчетПервоначальногоПризнания;
		
		Если СчитаемПоСтарому 
			ИЛИ (СтрокаТЗЦенныеБумагиСвернутые.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финконсалт")
					И Объект.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN118")) Тогда
		
				// плясать надо не от начальной, а от балансовой. пишу это потому, что не уверен до конца, но будущее утверждает так
			НачальнаяРазницаПервоначальногоПризнанияПлюс = БалансоваяРазницаПервоначальногоПризнанияПлюс;
			
			НачалоРасчета = НачалоКвартала(Объект.Дата);
			Если Объект.Дата >= '20210101' Тогда // с 01.01.2021 будущее перешли на ежемесячный расчет корректировки ПП
				НачалоРасчета = НачалоМесяца(Объект.Дата);
			КонецЕсли;
			
			Если ДатаНачалаРасчетаРазницыПП < НачалоРасчета Тогда
				ДатаНачалаРасчетаРазницыПП = НачалоДня(НачалоРасчета - 1); // считаем с конца прошлого отчетного периода (квартала)
			КонецЕсли;
		
		КонецЕсли;
		
		НачальнаяРазницаПервоначальногоПризнанияПлюс = НачальнаяРазницаПервоначальногоПризнанияПлюс / СтрокаТЗЦенныеБумагиСвернутые.Количество;
		
		
		ДанныеПереоценки = Новый Структура;
		ДанныеПереоценки.Вставить("ДатаПереоценки", Объект.Дата);
		ДанныеПереоценки.Вставить("Количество", СтрокаТЗЦенныеБумагиСвернутые.Количество);
		ДанныеПереоценки.Вставить("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
		ДанныеПереоценки.Вставить("УчетныйАктивЕПС", СтрокаТЗЦенныеБумагиСвернутые.УчетныйАктивЕПС);
		
		ДанныеПокупки = Новый Структура;
		ДанныеПокупки.Вставить("НачальныйДисконт", НачальнаяРазницаПервоначальногоПризнанияПлюс);
		ДанныеПокупки.Вставить("ДатаПокупки", ДатаНачалаРасчетаРазницыПП);
		ДанныеПокупки.Вставить("ЦенаПокупки", 0);
		
		ДанныеРасчетаРазницыПервоначальногоПризнания = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремии(СтрокаТЗЦенныеБумагиСвернутые.ЦеннаяБумага,	НастройкиУчетаЦеннойБумаги, ДанныеПереоценки, ДанныеПокупки, Отказ);
				
		Если ДанныеРасчетаРазницыПервоначальногоПризнания.ОценочныеДисконтПремия > БалансоваяРазницаПервоначальногоПризнанияПлюс Тогда
		
			ДанныеРасчетаРазницыПервоначальногоПризнания.ОценочныеДисконтПремия = БалансоваяРазницаПервоначальногоПризнанияПлюс;
			ДанныеРасчетаРазницыПервоначальногоПризнания.ИзменениеДисконтаПремии =  БалансоваяРазницаПервоначальногоПризнанияПлюс - НачальнаяРазницаПервоначальногоПризнанияПлюс * СтрокаТЗЦенныеБумагиСвернутые.Количество;
		
		КонецЕсли;
		
		СтрокаТЗЦенныеБумагиСвернутые.ОценочнаяРазницаППНеНаблюдаемыеДанныеРасчетная = ДанныеРасчетаРазницыПервоначальногоПризнания.ОценочныеДисконтПремия * ЗнакНачальнойРазницыПервоначальногоПризнания;
	
	КонецЦикла;
	
	// теперь будем разбивать копейки
	Для каждого СтрокаТЗЦенныеБумагиСвернутые Из ТЗЦенныеБумагиСвернутые Цикл
	
		Если СтрокаТЗЦенныеБумагиСвернутые.ОценочнаяРазницаППНеНаблюдаемыеДанныеРасчетная = СтрокаТЗЦенныеБумагиСвернутые.ОценочнаяРазницаППНеНаблюдаемыеДанные Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоКРаспределению = СтрокаТЗЦенныеБумагиСвернутые.Количество;
		ПогрешностьКРаспределению = СтрокаТЗЦенныеБумагиСвернутые.ОценочнаяРазницаППНеНаблюдаемыеДанныеРасчетная - СтрокаТЗЦенныеБумагиСвернутые.ОценочнаяРазницаППНеНаблюдаемыеДанные;
		
		СтрокиСЦеннойБумагой = Объект.ЦенныеБумаги.НайтиСтроки(Новый Структура("ЦеннаяБумага,УчетныйАктивЕПС", СтрокаТЗЦенныеБумагиСвернутые.ЦеннаяБумага, СтрокаТЗЦенныеБумагиСвернутые.УчетныйАктивЕПС));
		Для каждого СтрокаСЦеннойБумагой Из СтрокиСЦеннойБумагой Цикл
			
			Погрешность = Окр(ПогрешностьКРаспределению / КоличествоКРаспределению * СтрокаСЦеннойБумагой.Количество, 2);
			
			Если Погрешность <> 0 Тогда
				СтрокаСЦеннойБумагой.ОценочнаяРазницаППНеНаблюдаемыеДанные = СтрокаСЦеннойБумагой.ОценочнаяРазницаППНеНаблюдаемыеДанные + Погрешность;
				СтрокаСЦеннойБумагой.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета = СтрокаСЦеннойБумагой.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета + Погрешность;
				
				ПогрешностьКРаспределению = ПогрешностьКРаспределению - Погрешность;
			КонецЕсли;
			
			КоличествоКРаспределению = КоличествоКРаспределению - СтрокаСЦеннойБумагой.Количество;
			
			Если КоличествоКРаспределению = 0 Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РаспределитьПогрешностьОкругленияВалютныхСуммЕПС(Объект, Отказ) Экспорт
	
	Если Объект.ЦенныеБумаги.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, Отказ);

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦенныеБумаги.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
	|	ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ЦенныеБумаги.Количество КАК Количество,
	|	ЦенныеБумаги.КурсВалютыНоминала КАК КурсВалютыНоминала,
	|	ВЫБОР
	|		КОГДА ЦенныеБумаги.НачальныеДисконтПремия < 0
	|			ТОГДА ЦенныеБумаги.ОценочныеДисконтПремия
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ОценочныйДисконт,
	|	ВЫБОР
	|		КОГДА ЦенныеБумаги.НачальныеДисконтПремия > 0
	|			ТОГДА ЦенныеБумаги.ОценочныеДисконтПремия
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ОценочнаяПремия,
	|	ВЫБОР
	|		КОГДА ЦенныеБумаги.НачальныеДисконтПремия < 0
	|			ТОГДА ЦенныеБумаги.ОценочныеДисконтПремияВВалютеУчета
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ОценочныйДисконтВВалютеУчета,
	|	ВЫБОР
	|		КОГДА ЦенныеБумаги.НачальныеДисконтПремия > 0
	|			ТОГДА ЦенныеБумаги.ОценочныеДисконтПремияВВалютеУчета
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ОценочнаяПремияВВалютеУчета,
	|	ЦенныеБумаги.ОценочнаяКорректировкаЭСП КАК ОценочнаяКорректировкаЭСП,
	|	ЦенныеБумаги.ОценочнаяКорректировкаЭСПВВалютеУчета КАК ОценочнаяКорректировкаЭСПВВалютеУчета,
	|	ЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанные КАК ОценочнаяРазницаППНеНаблюдаемыеДанные,
	|	ЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета КАК ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета,
	|	1 КАК КоличествоСтрок
	|ПОМЕСТИТЬ ПереоценкаЦенныхБумагЦенныеБумаги1
	|ИЗ
	|	&ЦенныеБумаги КАК ЦенныеБумаги
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ВЫРАЗИТЬ(ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала КАК ВалютаНоминала,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.Количество КАК Количество,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.КурсВалютыНоминала КАК КурсВалютыНоминала,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.ОценочныйДисконт КАК ОценочныйДисконт,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.ОценочнаяПремия КАК ОценочнаяПремия,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.ОценочныйДисконтВВалютеУчета КАК ОценочныйДисконтВВалютеУчета,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.ОценочнаяПремияВВалютеУчета КАК ОценочнаяПремияВВалютеУчета,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.ОценочнаяКорректировкаЭСП КАК ОценочнаяКорректировкаЭСП,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.ОценочнаяКорректировкаЭСПВВалютеУчета КАК ОценочнаяКорректировкаЭСПВВалютеУчета,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.ОценочнаяРазницаППНеНаблюдаемыеДанные КАК ОценочнаяРазницаППНеНаблюдаемыеДанные,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета КАК ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.КоличествоСтрок КАК КоличествоСтрок
	|ПОМЕСТИТЬ ПереоценкаЦенныхБумагЦенныеБумаги
	|ИЗ
	|	ПереоценкаЦенныхБумагЦенныеБумаги1 КАК ПереоценкаЦенныхБумагЦенныеБумаги1
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага) = ТИП(Справочник.Облигации)
	|	И ВЫРАЗИТЬ(ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала <> &ВалютаУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПереоценкаЦенныхБумагЦенныеБумаги.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
	|	ПереоценкаЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ПереоценкаЦенныхБумагЦенныеБумаги.ВалютаНоминала КАК ВалютаНоминала,
	|	ПереоценкаЦенныхБумагЦенныеБумаги.КурсВалютыНоминала КАК КурсВалютыНоминала,
	|	СУММА(ПереоценкаЦенныхБумагЦенныеБумаги.Количество) КАК Количество,
	|	СУММА(ПереоценкаЦенныхБумагЦенныеБумаги.ОценочныйДисконт) КАК ОценочныйДисконт,
	|	СУММА(ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяПремия) КАК ОценочнаяПремия,
	|	СУММА(ПереоценкаЦенныхБумагЦенныеБумаги.ОценочныйДисконтВВалютеУчета) КАК ОценочныйДисконтВВалютеУчета,
	|	СУММА(ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяПремияВВалютеУчета) КАК ОценочнаяПремияВВалютеУчета,
	|	СУММА(ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяКорректировкаЭСП) КАК ОценочнаяКорректировкаЭСП,
	|	СУММА(ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяКорректировкаЭСПВВалютеУчета) КАК ОценочнаяКорректировкаЭСПВВалютеУчета,
	|	СУММА(ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанные) КАК ОценочнаяРазницаППНеНаблюдаемыеДанные,
	|	СУММА(ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета) КАК ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета,
	|	СУММА(ПереоценкаЦенныхБумагЦенныеБумаги.КоличествоСтрок) КАК КоличествоСтрок
