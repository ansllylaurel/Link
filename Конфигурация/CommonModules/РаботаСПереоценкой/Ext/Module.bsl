Функция ПолучитьПремииЗаСубординированность(Клиент, Дата) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Клиент КАК Клиент
		|ПОМЕСТИТЬ _КлиентыДУ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КлиентыДУ.Клиент
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Дата, СчетДоверительногоУправления = &Клиент) КАК КлиентыДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Облигации.Ссылка КАК ЦеннаяБумага,
		|	ПремияЗаСубординированность.ЗначениеПоказателя КАК ПроцентПремии
		|ИЗ
		|	Справочник.Облигации КАК Облигации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
		|			ПроцентныеПоказатели.ЗначениеПоказателя КАК ЗначениеПоказателя
		|		ИЗ
		|			РегистрСведений.ПроцентныеПоказатели КАК ПроцентныеПоказатели
		|		ГДЕ
		|			ПроцентныеПоказатели.Показатель = ЗНАЧЕНИЕ(Перечисление.ВидыПроцентныхПоказателей.ПремияЗаСубординированность)
		|			И ПроцентныеПоказатели.Прогноз = ЛОЖЬ
		|			И ПроцентныеПоказатели.Период <= &Дата
		|			И ПроцентныеПоказатели.ДатаЗначения <= &Дата
		|			И ПроцентныеПоказатели.Источник В
		|					(ВЫБРАТЬ
		|						_КлиентыДУ.Клиент
		|					ИЗ
		|						_КлиентыДУ КАК _КлиентыДУ)
		|		
		|		УПОРЯДОЧИТЬ ПО
		|			ПроцентныеПоказатели.ДатаЗначения УБЫВ,
		|			ПроцентныеПоказатели.Период УБЫВ) КАК ПремияЗаСубординированность
		|		ПО (ИСТИНА)
		|ГДЕ
		|	Облигации.Субординированность
		|	И Облигации.ГосударственныйРегистрационныйНомер <> """"");
	
	Запрос.УстановитьПараметр("Клиент",	Клиент);
	Запрос.УстановитьПараметр("Дата",	Дата);
		
	ТаблицаПремий = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаПремий;
	
