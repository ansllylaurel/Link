		|		КОГДА КотировкиАктивногоРынкаММВБ.LEGALCLOSEPRICE > 0
		|				И КотировкиАктивногоРынкаММВБ.VALUE <> 0
		|				И КотировкиАктивногоРынкаММВБ.CLOSE <> 0
		|			ТОГДА ЛОЖЬ
		|		КОГДА КотировкиАктивногоРынкаММВБ.ЦеннаяБумага ЕСТЬ NULL
		|				И (_ДефолтПоКупону.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|					ИЛИ _НеисполнениеОферты.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|					ИЛИ _ДефолтПоТелу.ЦеннаяБумага ЕСТЬ НЕ NULL )
		|			ТОГДА ИСТИНА
		|		КОГДА РасчетныеЦеныНРДНаДатуПереоценки.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|			ТОГДА ЛОЖЬ
		|		КОГДА РасчетныеЦеныНРДНаПоследнююДатуТоргов.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|			ТОГДА ЛОЖЬ
		|	КОНЕЦ КАК ПризнакиДефолта
		|ПОМЕСТИТЬ ОцененныеБумаги
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Дефолты КАК _Банкротство
		|		ПО (_Банкротство.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (_Банкротство.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.Банкротство))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Дефолты КАК _НеисполнениеОферты
		|		ПО (_НеисполнениеОферты.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (_НеисполнениеОферты.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ИсполнениеОферты))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Дефолты КАК _ДефолтПоКупону
		|		ПО (_ДефолтПоКупону.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (_ДефолтПоКупону.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.КупонныеВыплаты))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Дефолты КАК _ДефолтПоТелу
		|		ПО (_ДефолтПоТелу.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (_ДефолтПоТелу.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации))
		|		ЛЕВОЕ СОЕДИНЕНИЕ КотировкиАктивногоРынкаММВБ КАК КотировкиАктивногоРынкаММВБ
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ АктивныйРынокММВБПриоритетРежимаТоргов КАК ПриоритетРежимаТорговПоОбъему
		|			ПО (ПриоритетРежимаТорговПоОбъему.ЦеннаяБумага = КотировкиАктивногоРынкаММВБ.ЦеннаяБумага)
		|				И (ПриоритетРежимаТорговПоОбъему.РежимТоргов = КотировкиАктивногоРынкаММВБ.РежимТоргов)
		|				И (ПриоритетРежимаТорговПоОбъему.Приоритет = 1)
		|		ПО (КотировкиАктивногоРынкаММВБ.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРДНаДатуПереоценки
		|		ПО (РасчетныеЦеныНРДНаДатуПереоценки.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (РасчетныеЦеныНРДНаДатуПереоценки.Рынок = ТаблицаЦБ.Рынок)
		|			И (РасчетныеЦеныНРДНаДатуПереоценки.Период = &ДатаПереоценки)
		|			И (&ТолькоНаблюдаемыеЦены = ЛОЖЬ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРДНаПоследнююДатуТоргов
		|		ПО (РасчетныеЦеныНРДНаПоследнююДатуТоргов.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (РасчетныеЦеныНРДНаПоследнююДатуТоргов.Рынок = ТаблицаЦБ.Рынок)
		|			И (РасчетныеЦеныНРДНаПоследнююДатуТоргов.Период = &ПоследняяДатаТоргов)
		|			И (&ТолькоНаблюдаемыеЦены = ЛОЖЬ)
		|ГДЕ
		|	ВЫБОР
		|			КОГДА _Банкротство.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|				ТОГДА ИСТИНА
		|			КОГДА КотировкиАктивногоРынкаММВБ.WAPRICE > 0
		|					И КотировкиАктивногоРынкаММВБ.BID > 0
		|					И КотировкиАктивногоРынкаММВБ.OFFER > 0
		|					И (КотировкиАктивногоРынкаММВБ.WAPRICE МЕЖДУ КотировкиАктивногоРынкаММВБ.BID И КотировкиАктивногоРынкаММВБ.OFFER)
		|				ТОГДА ИСТИНА
		|			КОГДА КотировкиАктивногоРынкаММВБ.LEGALCLOSEPRICE > 0
		|					И КотировкиАктивногоРынкаММВБ.VALUE <> 0
		|					И КотировкиАктивногоРынкаММВБ.CLOSE <> 0
		|				ТОГДА ИСТИНА
		|			КОГДА КотировкиАктивногоРынкаММВБ.ЦеннаяБумага ЕСТЬ NULL
		|					И (_ДефолтПоКупону.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|						ИЛИ _НеисполнениеОферты.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|						ИЛИ _ДефолтПоТелу.ЦеннаяБумага ЕСТЬ НЕ NULL )
		|				ТОГДА ИСТИНА
		|			КОГДА РасчетныеЦеныНРДНаДатуПереоценки.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|				ТОГДА ИСТИНА
		|			КОГДА РасчетныеЦеныНРДНаПоследнююДатуТоргов.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|				ТОГДА ИСТИНА
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА ВЫРАЗИТЬ(ВЫРАЗИТЬ((ВЫРАЗИТЬ(ОцененныеБумаги.СправедливаяЦена * ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100 КАК ЧИСЛО(23, 6)) КАК ЧИСЛО(27, 10))
		|			ИНАЧЕ ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(ОцененныеБумаги.ВалютаЦены, 0) КАК Валюта,
		|	ЕСТЬNULL(ОцененныеБумаги.ВалютаЦены, 0) КАК ВалютаКотировки,
		|	ЕСТЬNULL(ОцененныеБумаги.ВидЦены, 0) КАК ВидЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(ОцененныеБумаги.Источник, 0) КАК Источник,
		|	ЕСТЬNULL(ОцененныеБумаги.ПризнакиДефолта, ЛОЖЬ) КАК ПризнакиДефолта,
		|	0 КАК Купон,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаКупона,
		|	ТаблицаЦБ.ТоргуетсяНаММВБ КАК ТоргуетсяНаММВБ
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОцененныеБумаги КАК ОцененныеБумаги
		|		ПО (ОцененныеБумаги.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)";
		
	#КонецОбласти	
	
	ТолькоНаблюдаемыеЦены		= ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены;
	
	ОсновнойКалендарьКотировок	= Константы.ОсновнойКалендарьКотировок.Получить();
	ОбщероссийскийКалендарь		= Справочники.Календари.Общероссийский;
	
	БиржаММВБ					= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	НРД							= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");	
	
	ПоследняяДатаТоргов			= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки));
	ПоследнийРабочийДень		= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(ОбщероссийскийКалендарь, НачалоДня(ДатаПереоценки));
	ТорговыхДнейНазад10			= Справочники.Календари.ДобавитьКДатеРабочиеДни(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки), -10);
	РабочихДнейНазад10			= Справочники.Календари.ДобавитьКДатеРабочиеДни(ОбщероссийскийКалендарь, НачалоДня(ДатаПереоценки), -10);
	
	Запрос = Новый Запрос;	
	
	Запрос.УстановитьПараметр("Организация",					ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ПараметрыОценки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ",				ТаблицаЦБ);
	
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены",			ТолькоНаблюдаемыеЦены);
	
	Запрос.УстановитьПараметр("ММВБ",							БиржаММВБ);
	Запрос.УстановитьПараметр("НРД",							НРД);
	
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",			ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10",			ТорговыхДнейНазад10);
	Запрос.УстановитьПараметр("РабочихДнейНазад10",				РабочихДнейНазад10);
	
	#Область Вспомогательный_запрос_количества_котировок	
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаСпискаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(*) КАК КоличествоКотировок
		|ИЗ
		|	РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ПО КотировкиТорговыхПлощадок.ЦеннаяБумага = ИсходнаяТаблицаЦБ.ЦеннаяБумага
		|			И (КотировкиТорговыхПлощадок.Период = &ПоследняяДатаТоргов)";

	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;	
	
	РезультатЗапросаКотировок = Запрос.Выполнить().Выбрать();
	Если РезультатЗапросаКотировок.Следующий() Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПЕРВЫЕ 1000000", Формат(РезультатЗапросаКотировок.КоличествоКотировок, "ЧН=; ЧГ=; ЧФ='ПЕРВЫЕ Ч'")); 
	КонецЕсли;
	
	#КонецОбласти
	
	Запрос.Текст = ТекстЗапроса; 
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Согласие 2019 (ЕПС)", "Предварительная таблица стоимостей ЦБ", , , "ИсходнаяТаблицаЦБ, АктивныйРынокММВБПриоритетРежимаТоргов_Служебный");
	КонецЕсли;
	
	Если ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;
	
	// Расчетные цены 	

	ВыполненРасчетЦены = Ложь;	
	
	ВалютаРубли = ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"); 	
	
	ПараметрыДенежногоПотока = Новый Структура;
	ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",	Ложь);
	ПараметрыДенежногоПотока.Вставить("Дата",				ДатаПереоценки);
	ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",		КонецДня(ДатаПереоценки));
	
	ПараметрыРасчетаРейтинга = ПолучитьПараметрыРасчетаРейтингаПоУмолчанию(ПараметрыОценки.СчетДоверительногоУправления, ДатаПереоценки);
	ПараметрыРасчетаРейтинга.Вставить("ИсточникТаблицыСоответствияРейтингов",	Справочники.ВнешниеСистемы.Газфонд);
	ПараметрыРасчетаРейтинга.Вставить("ТолькоНаблюдаемыеДанные",				Ложь);
	ПараметрыРасчетаРейтинга.Вставить("ТолькоЭмитент",							Ложь);
	
	ПараметрыРасчетаКредитногоСпреда = Новый Структура;
	ПараметрыРасчетаКредитногоСпреда.Вставить("ВариантРасчетаКредитногоСпреда",	"РазностьИндексовЧистыхЦенГосударственныхИКорпоративныхОблигаций");			
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 Тогда
			Продолжить;			
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
			
			Если СтрокаСтоимостейЦБ.ТоргуетсяНаММВБ Тогда
			
				#Область Расчет_на_основе_корректировки_исторической_цены
				
				// Справедливая стоимость акций, обращающихся на ММВБ,
				// определяется в соответствии с моделью оценки,
				// основанной на корректировке исторической цены (CAPM).
				// Применяем при отсутствии цены не более 10 торговых дней
				
				ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, ОсновнойКалендарьКотировок, , 6, Отказ, РасшифровкаРасчета); 
				
				Если ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
				КонецЕсли;
				
				#КонецОбласти
				
			КонецЕсли;

		ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			Если СтрокаСтоимостейЦБ.ПризнакиДефолта Тогда
			
				#Область Рынок_неактивный_и_эмитент_не_выполнил_обязательства  
				
				// Cправедливая стоимость долговых ценных бумаг определяется как дисконтированная стоимость будущих денежных потоков
				// с учетом корректировки (ожидаемых потерь по денежному потоку) по ставкам кривой безрисковых доходностей.
				// Оценка ожидаемых потерь определяется по следующей формуле:
				//
				// EL = EAD * LGD * PD / 100
				//			
				// EAD		– размер кредитного требования
				// LGD		- потери в случае дефолта
				// PD		- вероятность дефолта, выраженная в процентах
				//			
				// Считаем EAD = CF(i), поэтому коэффициент корректировки потока k = 1 - LGD * PD / 100 
				
				ДенежныеПотоки = Справочники.Облигации.ПолучитьДенежныйПоток(СтрокаСтоимостейЦБ.ЦеннаяБумага, ПараметрыДенежногоПотока, ПараметрыОценки, Отказ, РасшифровкаРасчета);
				
				Если ДенежныеПотоки.Количество() = 0 Тогда
					
					// Дефолт
					
					СтрокаСтоимостейЦБ.Стоимость		= 0;
					СтрокаСтоимостейЦБ.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.Дефолт;
					СтрокаСтоимостейЦБ.УровеньОценки	= 3;
					СтрокаСтоимостейЦБ.Источник			= СтрокаСтоимостейЦБ.Источник;
					СтрокаСтоимостейЦБ.ВалютаКотировки	= СтрокаСтоимостейЦБ.ВалютаНоминала;
					СтрокаСтоимостейЦБ.ДатаЦены			= ДатаПереоценки;
					
					Если РасшифровкаРасчета <> Неопределено Тогда
						ПараметрыРасчетаЦен = Новый Структура("БудущиеПотоки, ОписаниеЦены, Значение", "Отсутствуют", "Дисконтированная стоимость будущих денежных потоков", 0);
						РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "", "Результат расчета цены", ПараметрыРасчетаЦен);
					КонецЕсли;
					
					ЦенаЗаполнена = Истина;
					
				Иначе
					
					ПараметрыРасчетаРейтингаСПризнакамиДефолта = ПолучитьПараметрыРасчетаРейтингаПоУмолчанию(ПараметрыОценки.СчетДоверительногоУправления, ДатаПереоценки);
					ПараметрыРасчетаРейтингаСПризнакамиДефолта.Вставить("ВариантРасчетаОценочнойСтоимости",		ПараметрыОценки.ВариантРасчетаСправедливойСтоимости);
					ПараметрыРасчетаРейтингаСПризнакамиДефолта.Вставить("ИсточникТаблицыСоответствияРейтингов",	Справочники.ВнешниеСистемы.ОПК);
					ПараметрыРасчетаРейтингаСПризнакамиДефолта.Вставить("УчитыватьВидРейтинга",					Истина);
					
					ТаблицаВероятностейДефолта = ПолучитьРейтинговыеГруппыИВероятностиДефолта(СтрокаСтоимостейЦБ.Источник, ДатаПереоценки, ПараметрыРасчетаРейтингаСПризнакамиДефолта, РасшифровкаРасчета);
					
					Если ТаблицаВероятностейДефолта.Количество() = 0
						ИЛИ ТаблицаВероятностейДефолта[0].ВероятностьДефолта = NULL		
					Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
							СтрШаблон("Ошибка расчета вероятности дефолта эмитента ценной бумаги ""%1""", СтрокаСтоимостейЦБ.ЦеннаяБумага), , , , Отказ);
						Продолжить;
					КонецЕсли;
					
					ВероятностьДефолта				= ТаблицаВероятностейДефолта[0].ВероятностьДефолта / 100;
					УровеньПотерь					= ПолучитьУровеньПотерьВСлучаеДефолта(ПараметрыОценки.ВариантРасчетаСправедливойСтоимости, ДатаПереоценки); 
					КоэффициентКорректировкиПотока	= 1 - УровеньПотерь * ВероятностьДефолта;		
					
					ЦенаЗаполнена = ЗаполнитьДисконтированнойПоЗначениямКБДСтоимостью(СтрокаСтоимостейЦБ, ДатаПереоценки, ПараметрыОценки, 3, , , КоэффициентКорректировкиПотока, 2, ДенежныеПотоки, Отказ, РасшифровкаРасчета);
					
				КонецЕсли;			
				
				Если ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
				КонецЕсли;
				
				#КонецОбласти
				
			ИначеЕсли СтрокаСтоимостейЦБ.ВалютаНоминала = ВалютаРубли Тогда
				
				// Перенесено из ЗаполнитьПереоценкуСогласие2019
					
				ЦенаЗаполнена = ЗаполнитьДисконтированнойПоЗначениямКБДСтоимостью(СтрокаСтоимостейЦБ, ДатаПереоценки, ПараметрыОценки, 2, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, , 2, ПараметрыДенежногоПотока, Отказ, РасшифровкаРасчета);
					
				Если ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
				КонецЕсли;
					
			Иначе
					
				// Cправедливая стоимость долговых ценных бумаг, номинированных в иностранной валюте,
				// определяется аналогично долговым ценным бумагам, номинированным в рублях, со следующими изменениями:
				// r(i) – доходность наиболее близкого, в терминах дюрации, выпуска суверенных бумаг,
				// валюта которого соответсвует валюте оцениваемой облигации (выпуск-бенчмарк)
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Расчет справедливой стоимости долговой ценной бумаги ""%1"", номинированной в иностранной валюте, не реализован.", СтрокаСтоимостейЦБ.ЦеннаяБумага));
					
			КонецЕсли;
				
		КонецЕсли;

	КонецЦикла;
	
	// Дополняем расшифровку при необходимости
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Получить цены Согласие 2019 (ЕПС)", "После расчета цен", ТаблицаСтоимостейЦБ.Скопировать());	
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныОПК(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок,
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ1
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Акции.ОсновнойВыпуск,
		|	Акции.ОсновнойВыпуск.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок,
		|	Акции.ОсновнойВыпуск.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ
		|ИЗ
		|	Справочник.Акции КАК Акции
		|		ЛЕВОЕ СОЕДИНЕНИЕ ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ПО (ИсходнаяТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка)
		|ГДЕ
		|	Акции.ОсновнойВыпуск <> ЗНАЧЕНИЕ(Справочник.Акции.пустаяСсылка)
		|;
		|"
		
		+"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		 |	ИсходнаяТаблицаЦБ1.ЦеннаяБумага КАК ЦеннаяБумага,
		 |	ИсходнаяТаблицаЦБ1.ВалютаНоминала КАК ВалютаНоминала,
		 |	ИсходнаяТаблицаЦБ1.Рынок КАК Рынок,
		 |	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		 |	ЕСТЬNULL(Облигации.ДатаНачалаОбращения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаОбращения,
		 |	ЕСТЬNULL(Облигации.ДатаНачалаРазмещения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаРазмещения,
		 |	ВЫБОР
		 |		КОГДА ИсходнаяТаблицаЦБ1.УчетныйАктивЦБРФ В (&БумагиНерезидентов)
		 |			ТОГДА ВЫБОР
		 |					КОГДА ИсходнаяТаблицаЦБ1.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		 |						ТОГДА ВЫБОР
		 |								КОГДА ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ1.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		 |										ИЛИ ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ1.ЦеннаяБумага КАК Справочник.Облигации).Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗ)
		 |										ИЛИ ИсходнаяТаблицаЦБ1.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств)
		 |										ИЛИ РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация)
		 |									ТОГДА ИСТИНА
		 |								ИНАЧЕ ЛОЖЬ
		 |							КОНЕЦ
		 |					ИНАЧЕ ЛОЖЬ
		 |				КОНЕЦ
		 |		КОГДА ИсходнаяТаблицаЦБ1.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		 |			ТОГДА ВЫБОР
		 |					КОГДА ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ1.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		 |							ИЛИ ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ1.ЦеннаяБумага КАК Справочник.Облигации).Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗ)
		 |						ТОГДА ИСТИНА
		 |					ИНАЧЕ ЛОЖЬ
		 |				КОНЕЦ
		 |		ИНАЧЕ ЛОЖЬ
		 |	КОНЕЦ КАК БиржевойРынокНеАктивен,
		 |	ВЫБОР
		 |		КОГДА ИсходнаяТаблицаЦБ1.УчетныйАктивЦБРФ В (&БумагиНерезидентов)
		 |			ТОГДА ЛОЖЬ
		 |		КОГДА ИсходнаяТаблицаЦБ1.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		 |			ТОГДА ВЫБОР
		 |					КОГДА ИсходнаяТаблицаЦБ1.ЦеннаяБумага.Подкатегория = &ОВОЗ
		 |						ТОГДА ЛОЖЬ
		 |					ИНАЧЕ ИСТИНА
		 |				КОНЕЦ
		 |		ИНАЧЕ ИСТИНА
		 |	КОНЕЦ КАК ЦБРФ
		 |ПОМЕСТИТЬ ТаблицаЦБ
		 |ИЗ
		 |	ИсходнаяТаблицаЦБ1 КАК ИсходнаяТаблицаЦБ1
		 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		 |		ПО ИсходнаяТаблицаЦБ1.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		 |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		 |		ПО ИсходнаяТаблицаЦБ1.ЦеннаяБумага = Облигации.Ссылка
		 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		 |				&ДатаПереоценки,
		 |				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		 |					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		 |		ПО (ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ1.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		 |;
		 |
		 |////////////////////////////////////////////////////////////////////////////////
		 |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		 |	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		 |	ТаблицаЦБ.Номинал КАК Номинал,
		 |	КотировкиЦенныхБумаг.Рынок КАК Рынок,
		 |	КотировкиЦенныхБумаг.Биржа КАК Биржа,
		 |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КотировкиЦенныхБумаг.Период) КАК КоличествоКотировок,
		 |	СУММА(КотировкиЦенныхБумаг.NUMTRADES) КАК NUMTRADES,
		 |	СУММА(КотировкиЦенныхБумаг.VALUE) КАК VALUE
		 |ПОМЕСТИТЬ АктивныйРынокММВБ90Дней
		 |ИЗ
		 |	ТаблицаЦБ КАК ТаблицаЦБ
		 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиЦенныхБумаг
		 |		ПО ТаблицаЦБ.Рынок = КотировкиЦенныхБумаг.Рынок
		 |			И ТаблицаЦБ.ЦеннаяБумага = КотировкиЦенныхБумаг.ЦеннаяБумага
		 |			И (КотировкиЦенныхБумаг.РежимТоргов.ОсновнойРежим)
		 |ГДЕ
		 |	КотировкиЦенныхБумаг.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -90)
		 |	И КотировкиЦенныхБумаг.Период <= &ДатаПереоценки
		 |	И КотировкиЦенныхБумаг.Биржа = &ММВБ
		 |	И НЕ ТаблицаЦБ.БиржевойРынокНеАктивен
		 |
		 |СГРУППИРОВАТЬ ПО
		 |	ТаблицаЦБ.ЦеннаяБумага,
		 |	ТаблицаЦБ.Номинал,
		 |	КотировкиЦенныхБумаг.Рынок,
		 |	КотировкиЦенныхБумаг.Биржа
		 |
		 |ИМЕЮЩИЕ
		 |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КотировкиЦенныхБумаг.Период) > 0 И
		 |	КОЛИЧЕСТВО(КотировкиЦенныхБумаг.WAPRICE) > 0 И
		 |	СУММА(КотировкиЦенныхБумаг.NUMTRADES) >= 3 И
		 |	СУММА(КотировкиЦенныхБумаг.VALUE) > 500000
		 |;
		 |
		 |////////////////////////////////////////////////////////////////////////////////
		 |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		 |	""Т.к. кроме ММВБ других котировок нет, то выбор основного рынка пока не делаем"" КАК Поле1,
		 |	АктивныйРынокММВБ90Дней.ЦеннаяБумага КАК ЦеннаяБумага,
		 |	АктивныйРынокММВБ90Дней.Номинал КАК Номинал,
		 |	АктивныйРынокММВБ90Дней.Рынок КАК Рынок,
		 |	АктивныйРынокММВБ90Дней.Биржа КАК Биржа
		 |ПОМЕСТИТЬ ОсновныеРынкиЦБ
		 |ИЗ
		 |	АктивныйРынокММВБ90Дней КАК АктивныйРынокММВБ90Дней
		 |;
		 |
		 |////////////////////////////////////////////////////////////////////////////////
		 |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		 |	КотировкиТорговыхПлощадокСводныеСрезПоследних.Период КАК Период,
		 |	КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа КАК Биржа,
		 |	КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE КАК WAPRICE,
		 |	КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE_DATE КАК WAPRICE_DATE,
		 |	ОсновныеРынкиЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		 |	ОсновныеРынкиЦБ.Рынок КАК Рынок,
		 |	КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта КАК Валюта
		 |ПОМЕСТИТЬ КотировкиОсновногоРынкаЦБ
		 |ИЗ
		 |	ОсновныеРынкиЦБ КАК ОсновныеРынкиЦБ
		 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		 |				&ДатаПереоценки,
		 |				Биржа = &ММВБ
		 |					И РежимТоргов.ОсновнойРежим) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
		 |		ПО ОсновныеРынкиЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага
		 |			И ОсновныеРынкиЦБ.Биржа = КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа
		 |			И ОсновныеРынкиЦБ.Рынок = КотировкиТорговыхПлощадокСводныеСрезПоследних.Рынок
		 |;
		 |
		 |////////////////////////////////////////////////////////////////////////////////
		 |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		 |	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		 |	ТаблицаЦБ.Рынок КАК Рынок,
		 |	ВЫБОР
		 |		КОГДА ЕСТЬNULL(КотировкиОсновногоРынкаЦБ.WAPRICE, 0) > 0
		 |			ТОГДА КотировкиОсновногоРынкаЦБ.WAPRICE
		 |		КОГДА ЕСТЬNULL(Котировки_Bloomberg_BGN.WAPRICE_DATE, ДАТАВРЕМЯ(1890, 1, 1, 0, 0, 0)) > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -90)
		 |			ТОГДА Котировки_Bloomberg_BGN.WAPRICE
		 |		КОГДА ЕСТЬNULL(Котировки_Bloomberg_BVAL.CLOSE_DATE, ДАТАВРЕМЯ(1890, 1, 1, 0, 0, 0)) > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -90)
		 |			ТОГДА Котировки_Bloomberg_BVAL.CLOSE
		 |		ИНАЧЕ 0
		 |	КОНЕЦ КАК СправедливаяЦена,
		 |	ВЫБОР
		 |		КОГДА ЕСТЬNULL(КотировкиОсновногоРынкаЦБ.WAPRICE, 0) > 0
		 |			ТОГДА КотировкиОсновногоРынкаЦБ.WAPRICE_DATE
