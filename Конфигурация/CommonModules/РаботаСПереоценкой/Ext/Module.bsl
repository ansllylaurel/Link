									|ИЗ
									|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
									|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаЦБ КАК _ТаблицаЦБ
									|		ПО (_ТаблицаЦБ.ЦеннаяБумага = СтоимостьПереоценки.ЦеннаяБумага)
									|ГДЕ
									|	СтоимостьПереоценки.Период < &ДатаПереоценки
									|	И СтоимостьПереоценки.Организация = &Организация
									|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
									|	И СтоимостьПереоценки.ВидУчета = &ВидУчета
									|	И СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета
									|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
									|	И СтоимостьПереоценки.ВидЦены = ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.РасчетнаяЦена)
									|	И СтоимостьПереоценки.ДатаЦены МЕЖДУ &ТорговыхДнейНазад23 И ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -1)
									|;
									|
									|////////////////////////////////////////////////////////////////////////////////
									|ВЫБРАТЬ РАЗРЕШЕННЫЕ
									|	_ЦеныРассчитанныеРанее.ЦеннаяБумага КАК ЦеннаяБумага,
									|	_ЦеныРассчитанныеРанее.Стоимость КАК Стоимость,
									|	_ЦеныРассчитанныеРанее.ВидЦены КАК ВидЦены,
									|	_ЦеныРассчитанныеРанее.ДатаЦены КАК ДатаЦены,
									|	_ЦеныРассчитанныеРанее.УровеньОценки КАК УровеньОценки,
									|	_ЦеныРассчитанныеРанее.ВалютаКотировки КАК ВалютаКотировки
									|ИЗ
									|	_ЦеныРассчитанныеРанее КАК _ЦеныРассчитанныеРанее
									|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
									|			_ЦеныРассчитанныеРанее.ЦеннаяБумага КАК ЦеннаяБумага,
									|			_ЦеныРассчитанныеРанее.УровеньОценки КАК УровеньОценки,
									|			МАКСИМУМ(_ЦеныРассчитанныеРанее.ДатаЦены) КАК ДатаЦены
									|		ИЗ
									|			_ЦеныРассчитанныеРанее КАК _ЦеныРассчитанныеРанее
									|		
									|		СГРУППИРОВАТЬ ПО
									|			_ЦеныРассчитанныеРанее.ЦеннаяБумага,
									|			_ЦеныРассчитанныеРанее.УровеньОценки) КАК ПоследниеЦены
									|		ПО (ПоследниеЦены.ЦеннаяБумага = _ЦеныРассчитанныеРанее.ЦеннаяБумага)
									|			И (ПоследниеЦены.УровеньОценки = _ЦеныРассчитанныеРанее.УровеньОценки)
									|			И (ПоследниеЦены.ДатаЦены = _ЦеныРассчитанныеРанее.ДатаЦены)");
									
								ТорговыхДнейНазад23 = Справочники.Календари.ДобавитьКДатеРабочиеДни(КалендарьКотировок, НачалоДня(ДатаПереоценки), -23);	
									
								Запрос.УстановитьПараметр("ТаблицаСтоимостейЦБ",		  ТаблицаСтоимостейЦБ);
								Запрос.УстановитьПараметр("ДатаПереоценки",				  ДатаПереоценки);
								Запрос.УстановитьПараметр("ТорговыхДнейНазад23",		  ТорговыхДнейНазад23);
								Запрос.УстановитьПараметр("Организация",				  ПараметрыОценки.Организация);
								Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыОценки.СчетДоверительногоУправления);
								Запрос.УстановитьПараметр("ВидУчета",					  ПараметрыОценки.ВидУчета);
								Запрос.УстановитьПараметр("ЦельРасчета",				  ?(ПараметрыОценки.Свойство("ЦельРасчета"), ПараметрыОценки.ЦельРасчета, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении));
								
								ЦеныРассчитанныеРанее = Запрос.Выполнить().Выгрузить();
								
								Если РасшифровкаРасчета <> Неопределено Тогда
									РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Расчетные цены", ЦеныРассчитанныеРанее.Скопировать());
								КонецЕсли;
								
								#КонецОбласти
								
							КонецЕсли;										
							
							ЦеныРассчитанныеРанееТекущейЦБ = ЦеныРассчитанныеРанее.Скопировать(Новый Структура("ЦеннаяБумага, УровеньОценки", СтрокаСтоимостейЦБ.ЦеннаяБумага, СтрокаСтоимостейЦБ.УровеньОценки)); 
							
							Если ЦеныРассчитанныеРанееТекущейЦБ.Количество() > 0 Тогда
								
								ЗаполнитьЗначенияСвойств(СтрокаСтоимостейЦБ, ЦеныРассчитанныеРанееТекущейЦБ[0]);
								
							КонецЕсли;
							
						КонецЕсли;							
						
						#КонецОбласти
							
					ИначеЕсли СтрокаСтоимостейЦБ.ТипЦены = ТипыЦен.РасчетнаяЦенаМодель2 Тогда 	
						
						#Область Расчет_на_основе_корректировки_исторической_цены					
						
						// Справедливая стоимость акций определяется в соответствии с моделью оценки,
						// основанной на корректировке исторической цены (CAPM).
						
						ПараметрыCAPM = Новый Структура("ГлубинаПоиска, Календарь"); 
						
						Если ДатаПереоценки >= '20200601' Тогда
							
							// Применяем при отсутствии цены не более 10 торговых дней
							
							ПараметрыCAPM.ГлубинаПоиска	= 10;
							ПараметрыCAPM.Календарь		= КалендарьКотировок;
							
						Иначе
							
							// Не более 30 календарных дней или 22 торговых дня
							
							КалендарныхДнейНазад30 = НачалоДня(ДатаПереоценки) - 30 * 86400;
							
							Если КалендарныхДнейНазад30 < ТорговыхДнейНазад22 Тогда
								ПараметрыCAPM.ГлубинаПоиска	= 30;
								ПараметрыCAPM.Календарь		= Неопределено;
							Иначе
								ПараметрыCAPM.ГлубинаПоиска	= 22;
								ПараметрыCAPM.Календарь		= КалендарьКотировок;
							КонецЕсли;
							
						КонецЕсли;
						
						ЦенаПоCAPM = ПолучитьЦенуНаОсновеКорректировкиИсторическойЦены(ПараметрыОценки, ДатаПереоценки, СтрокаСтоимостейЦБ, ПараметрыCAPM.ГлубинаПоиска, ПараметрыCAPM.Календарь, , Отказ, РасшифровкаОперации);  
						
						Если ЦенаПоCAPM <> Неопределено Тогда
							
							// Полученная цена округляется до такого же количества знаков после запятой, как биржевая котировка
							
							РазрядностьДробнойЧасти = Макс(СтрДлина(ЦенаПоCAPM.ПоследняяНаблюдаемаяЦена % 1) - 2, 0);
							
							СтрокаСтоимостейЦБ.Стоимость		= Окр(ЦенаПоCAPM.РасчетнаяСтоимость, РазрядностьДробнойЧасти);
							СтрокаСтоимостейЦБ.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена; 
							СтрокаСтоимостейЦБ.Источник			= Справочники.ЮрФизЛица.ПустаяСсылка();
							СтрокаСтоимостейЦБ.УровеньОценки	= 2;
							СтрокаСтоимостейЦБ.ДатаЦены			= ДатаПереоценки;
							СтрокаСтоимостейЦБ.ВалютаКотировки	= СтрокаСтоимостейЦБ.ВалютаНоминала;

						КонецЕсли;						
						
						#КонецОбласти						
						
					КонецЕсли;
					
				КонецЕсли;
				
				#Область Проверка_цены
				
				Если СтрокаСтоимостейЦБ.Стоимость <> 0 Тогда
					
					Если РасшифровкаРасчета <> Неопределено Тогда
						ПараметрыРасчета = РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(СтрокаСтоимостейЦБ);
						РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Проверяемая цена", ПараметрыРасчета);
					КонецЕсли;
					
					ПроверкаПройдена = Истина;
					
					// Проверка изменения ценового индекса
					
					Если СтрокаСтоимостейЦБ.ПроверитьИзменениеЦеновогоИндекса Тогда
						ПроверкаПройдена = ПроверитьИзменениеЦеновогоИндексаОблигацийСоответствующейКатегории(СтрокаСтоимостейЦБ.ЦеннаяБумага, СтрокаСтоимостейЦБ.ДатаЦены, ПараметрыОценки, ДатаПереоценки, Отказ, РасшифровкаОперации);
					КонецЕсли;
					
					// Проверка спреда доходности
					
					Если ПроверкаПройдена И СтрокаСтоимостейЦБ.ПроверитьСпредДоходности Тогда
						
						Если КредитныйСпред = Неопределено Тогда
							КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, Отказ, РасшифровкаОперации);	
						КонецЕсли;
						
						ПроверкаПройдена = ПроверитьЦенуПоСпредуДоходности(СтрокаСтоимостейЦБ, ПараметрыОценки, КредитныйСпред, ДатаПереоценки, Отказ, РасшифровкаОперации);
						
					КонецЕсли;
					
					// Цена найдена и проверена
					
					Если ПроверкаПройдена Тогда
						
						ЦенаНайдена = Истина;
						ЗаполнитьЗначенияСвойств(ИтоговаяТаблица.Добавить(), СтрокаСтоимостейЦБ); 		
						Прервать;
						
					ИначеЕсли РасшифровкаРасчета <> Неопределено Тогда
						
						РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Результат проверки", Новый Структура("Описание", "Проверка цены не пройдена"));
						
					КонецЕсли;
					
				ИначеЕсли РасшифровкаРасчета <> Неопределено Тогда
					
					РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Результат анализа", Новый Структура("Описание", "Цена не найдена"));
					
				КонецЕсли;
				
				#КонецОбласти
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если Не ЦенаНайдена Тогда
			ЗаполнитьЗначенияСвойств(ИтоговаяТаблица.Добавить(), СтрокаЦеннойБумаги); 		
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ИтоговаяТаблица;	

КонецФункции

Функция ПолучитьЦеныПФР2020(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ИсходнаяТаблицаЦБ");
	ПоместитьСведенияОТоргахЦеннымиБумагамиВМенеджерВременныхТаблиц(Запрос, "_ИсходнаяТаблицаЦБ", ДатаПереоценки, 10, "_СведенияОТоргахЦеннымиБумагами");
	ПоместитьТаблицуДатРасчетныхЦенПаевВМенеджерВременныхТаблиц(Запрос, "_ИсходнаяТаблицаЦБ", ДатаПереоценки, "_ТаблицаДатРасчетныхЦенПаев");

	ТочностьЦенВторогоУровняИНиже = 5;
	
	#Область Основной_запрос	
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	Эмитенты.Ссылка КАК Эмитент,
		|	Эмитенты.ЮрФизЛицо КАК ЮрЛицоЭмитента
		|ПОМЕСТИТЬ _ЭмитентыЦенныхБумаг
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Векселя КАК Векселя
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Векселя.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеРасписки КАК ДепозитарныеРасписки
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = ДепозитарныеРасписки.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = ИпотечныеСертификатыУчастия.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|		ПО (Эмитенты.Ссылка = ВЫБОР
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|					ТОГДА Акции.Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|					ТОГДА Облигации.Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|					ТОГДА Векселя.Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|					ТОГДА ДепозитарныеРасписки.Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|					ТОГДА ИпотечныеСертификатыУчастия.Эмитент
		|			КОНЕЦ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(ТоргуетсяНаММВБ.Активен, ЛОЖЬ) КАК ТоргуетсяНаММВБ,
		|	_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента КАК Эмитент,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЭмитентРоссийский,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация), ЛОЖЬ) КАК ЭмитентМеждународнаяФинОрганизация,
		|	ЕСТЬNULL(Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ), ЛОЖЬ) КАК ОблигацияОВОЗ,
		|	ВЫБОР
		|		КОГДА Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ)
		|				ИЛИ РеквизитыЮрЛицаЭмитента.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|		КОГДА РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка))
		|				ИЛИ _ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА &ММВБ
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	КОНЕЦ КАК ОсновнаяПлощадка,
		|	ПоследняяДатаТоргов.Дата КАК ПоследняяДатаТоргов,
		|	ТорговыхДнейНазад10.Дата КАК ТорговыхДнейНазад10,
		|	НачалоЭтапаРазмещения.Период КАК НачалоЭтапаРазмещения
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						_ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ИСТИНА
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
