	КалендарьКотировок				= Константы.ОсновнойКалендарьКотировок.Получить();
	
	РабочихДнейНазад10				= Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ДатаПереоценки), -10);
	ПоследнийТорговыйДень			= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьКотировок, НачалоДня(ДатаПереоценки));
	ПоследнийТорговыйДеньБлумберг	= РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки, Блумберг);		
	ДополнительныеДатыЦенНРД		= Новый Массив;
	
	Если ДатаПереоценки >= '20200101' Тогда
		
		// #418135: берем цену НРД на дату оценки, а если ее нет, то из последнего торгового или рабочего дня
				
		ДополнительныеДатыЦенНРД.Добавить(НачалоДня(ДатаПереоценки));		
		ДополнительныеДатыЦенНРД.Добавить(Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоДня(ДатаПереоценки))); // последний рабочий день
				
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследнийТорговыйДеньБлумберг",	ПоследнийТорговыйДеньБлумберг);
	Запрос.УстановитьПараметр("ДополнительныеДатыЦенНРД",		ДополнительныеДатыЦенНРД);
	
	Запрос.УстановитьПараметр("ММВБ",							ММВБ);
	Запрос.УстановитьПараметр("Блумберг",						Блумберг);
	Запрос.УстановитьПараметр("НРД",							НРД);
	Запрос.УстановитьПараметр("Режим_BGN",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	Запрос.УстановитьПараметр("ДоступныДанныеBloomberg",		ПроверитьДоступностьДанныхBloomberg(ДатаПереоценки));
	
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены",			ТолькоНаблюдаемыеЦены);
	
	// Настройки методики
	Запрос.УстановитьПараметр("ВключатьРежимРПС",											ДатаПереоценки < '20190731');
	Запрос.УстановитьПараметр("ПроверятьОбъемСделокАктивногоРынкаВПоследнийТорговыйДень",	ДатаПереоценки >= '20200101');
	Запрос.УстановитьПараметр("ПроверятьЦенуЗакрытияВПоследнийТорговыйДень",				ДатаПереоценки >= '20200101');
	Запрос.УстановитьПараметр("ПроверятьМетодикуНРД",										ДатаПереоценки >= '20200101');
	Запрос.УстановитьПараметр("ВключатьИностранныеЕврооблигацииВГруппуОВОЗРФиПрочее",		ДатаПереоценки >= '20200101');
	Запрос.УстановитьПараметр("ОцениватьОВОЗРФПоНРД",										ДатаПереоценки >= '20210101');
	Запрос.УстановитьПараметр("ОцениватьОВОЗРФПоБлумбергу",									ДатаПереоценки < '20200101' ИЛИ ДатаПереоценки >= '20210101');
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Традиция 2019 ЕПС", "Предварительная таблица стоимостей ЦБ", , , "ОцениваемаяТаблицаЦБ, ЭмитентыЦенныхБумаг");		
	КонецЕсли;
	
	Если ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;
	
	#Область Получение_неоцененных_российских_облигаций_находящихся_в_периоде_размещения_и_оценка_их_по_цене_размещения
	
	// Отбор бумаг, по которым требуются данные партий
	
	СтрокиДляДозаполненияИзПартий = Новый Массив;	
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены) Тогда
			Продолжить;			
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.ЭмитентРоссийский Тогда
			
			Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		
				Если ДатаПереоценки >= '20200101' Тогда

					// Находимся в периоде размещения	
					
					Если (ДатаПереоценки >= СтрокаСтоимостейЦБ.НачалоПериодаРазмещения И СтрокаСтоимостейЦБ.НачалоПериодаРазмещения > '00010101') 
						И (ДатаПереоценки < СтрокаСтоимостейЦБ.КонецПериодаРазмещения ИЛИ СтрокаСтоимостейЦБ.КонецПериодаРазмещения = '00010101')
					Тогда
						СтрокиДляДозаполненияИзПартий.Добавить(СтрокаСтоимостейЦБ); 
					КонецЕсли;
					
				Иначе

					// Прошло не более 10 рабочих дней от размещения

					Если СтрокаСтоимостейЦБ.НачалоПериодаРазмещения >= РабочихДнейНазад10 Тогда
						СтрокиДляДозаполненияИзПартий.Добавить(СтрокаСтоимостейЦБ); 
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;

	КонецЦикла;
	
	// Дозаполнение по данным партий
	
	Если СтрокиДляДозаполненияИзПартий.Количество() > 0 И ПараметрыОценки.Свойство("ПараметрыПолученияПартий") И ПараметрыОценки.ПараметрыПолученияПартий <> Неопределено Тогда
		
		#Область Получение_партий		
		
		МенеджерВТ = Новый МенеджерВременныхТаблиц;
		
		ОписаниеОбъекта = Новый Структура("ЦельРасчета, ВидУчета, Организация, СчетДоверительногоУправления, Ссылка, Дата",
			ПараметрыОценки.ПараметрыПолученияПартий.ЦельРасчета,
			ПараметрыОценки.ПараметрыПолученияПартий.ВидУчета,
			ПараметрыОценки.Организация,
			ПараметрыОценки.СчетДоверительногоУправления,
			Документы.РегистрацияСтоимостиПереоценки.ПустаяСсылка(),
			КонецДня(ДатаПереоценки));			
			
		РаботаСПереоценкой.ПолучитьЦенныеБумаги(ОписаниеОбъекта, МенеджерВТ, "ТаблицаПартийЦБ", ПараметрыОценки.ПараметрыПолученияПартий, , , РасшифровкаРасчета);
		
		ЗапросПартий = Новый Запрос;
		ЗапросПартий.МенеджерВременныхТаблиц = МенеджерВТ;
		ЗапросПартий.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЦеннаяБумага, Рынок, Партия, СтрокаПартии			
			|ИЗ
			|	ТаблицаПартийЦБ КАК ТаблицаПартийЦБ";
		
		#КонецОбласти
		
		ТаблицаПартий = ЗапросПартий.Выполнить().Выгрузить();
		
		Для Каждого СтрокаСтоимостейЦБ Из СтрокиДляДозаполненияИзПартий Цикл
			
			СтрокиПартий = ТаблицаПартий.НайтиСтроки(Новый Структура("ЦеннаяБумага", СтрокаСтоимостейЦБ.ЦеннаяБумага));
			
			Для Каждого СтрокаПартии Из СтрокиПартий Цикл
			
				#Область Первичное_размещение
				
				// Эмуляция структуры таблицы переоценки		
				СтрокаПереоценкиЦБ = Новый Структура("ЦеннаяБумага, Рынок, Партия, СтрокаПартии, Биржа, ИсточникЦены, ПолеЦены, УровеньОценки, ДатаКотировки, ЦенаКотировки, ВалютаКотировки, РыночнаяЦена, РыночнаяЦенаПроцент");
				ЗаполнитьЗначенияСвойств(СтрокаПереоценкиЦБ, СтрокаПартии);
				
				Если ДатаПереоценки >= '20200101' Тогда 
					
					// в день приобретения применяется цена приобретения
					
					УсловияПримененияЦеныРазмещения	= Новый Структура("КоличествоДней, ПриоритетыЦен", 0, "ЦенаПриобретения");
					ПараметрыЦеныРазмещения			= Неопределено;
					
				Иначе	
					
					// Справедливой стоимостью ценных бумаг, приобретенных на этапе размещения, является цена размещения.
					// С даты появления цен, позволяющих произвести оценку по данным активного основного рынка, справедливая стоимость определяется в общем порядке. 
					// При отсутствии указанных цен в течение 10 рабочих дней с даты размещения применяется цена размещения,
					// скорректированная пропорционально на изменение ключевой ставки Банка России за период с даты размещения до даты оценки.
					// Начиная с 11 дня справедливая стоимость определяется в общем порядке.					
					
					УсловияПримененияЦеныРазмещения	= Новый Структура("КоличествоДней, Календарь, ПриоритетыЦен, ОтсутствиеЦенАктивногоРынкаСНачалаРазмещения", 10, Справочники.Календари.Общероссийский, "Цена1Уровня, ЦенаПриобретения", Истина);
					ПараметрыЦеныРазмещения			= Новый Структура("ПропорциональноИзменениюКлючевойСтавки", Истина);

				КонецЕсли;	
					
				Если ЗаполнитьПервичноеРазмещение(СтрокаПереоценкиЦБ, ДатаПереоценки, ПараметрыОценки, УсловияПримененияЦеныРазмещения, ПараметрыЦеныРазмещения, Отказ, РасшифровкаРасчета) Тогда
					
					ЗаполнитьЗначенияСвойств(СтрокаСтоимостейЦБ, СтрокаПереоценкиЦБ);
					
					СтрокаСтоимостейЦБ.Стоимость	= СтрокаПереоценкиЦБ.РыночнаяЦена;
					СтрокаСтоимостейЦБ.ДатаЦены		= СтрокаПереоценкиЦБ.ДатаКотировки;
					СтрокаСтоимостейЦБ.Источник		= СтрокаПереоценкиЦБ.ИсточникЦены;
					СтрокаСтоимостейЦБ.ВидЦены		= СтрокаПереоценкиЦБ.ПолеЦены;
					
					Прервать;

				КонецЕсли;
				
				#КонецОбласти
			
			КонецЦикла;
		
		КонецЦикла;
		
	КонецЕсли;
	
	#КонецОбласти
		
	// Расчет цен и заполнение купона

	Если ДатаПереоценки >= '20200101' Тогда
		ПараметрыОценки.Вставить("ТочностьКБД", 2); // в процентах до 2 знаков после запятой
	КонецЕсли;	
		
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);					
	ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	
	КоэффициентыСущественныхСобытий = Новый Структура;
	КоэффициентыСущественныхСобытий.Вставить("ИзмененаКлючеваяСтавкаЦБРФ_ЕвропейскогоЦБ_ФРССША", 1);
	КоэффициентыСущественныхСобытий.Вставить("ВведеныСанкцииПротивЭмитента",					 1);
	КоэффициентыСущественныхСобытий.Вставить("ЗначительныеТехногенныеКатастрофы",				 1);
	КоэффициентыСущественныхСобытий.Вставить("ИзмененКредитныйРейтингЭмитента",					 1);
	КоэффициентыСущественныхСобытий.Вставить("ДефолтПоБумагамЭмитента",							 1);
	
	ПараметрыОценкиПоМоделиСущественныхСобытий = Новый Структура;
	ПараметрыОценкиПоМоделиСущественныхСобытий.Вставить("ПараметрыПоискаЦены",				Новый Структура("Календарь, УровеньОценки", КалендарьКотировок, 1));
	ПараметрыОценкиПоМоделиСущественныхСобытий.Вставить("КоэффициентыСущественныхСобытий",	КоэффициентыСущественныхСобытий);
	
	ЦеныНРД = Новый Соответствие;
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены) Тогда
			Продолжить;			
		КонецЕсли;
		
		// Расчетные цены
	
		Если СтрокаСтоимостейЦБ.ОВОЗРФИПрочие И ДатаПереоценки >= '20210101' Тогда
			
			Если НачалоДня(ДатаПереоценки) <> ПоследнийТорговыйДень Тогда
			
				#Область Уровень_2_Расчет_основанный_на_изменениях_существенных_событий
				
				ЦенаПредыдущегоРабочегоДня = ПолучитьПоследнююНаблюдаемуюЦенуСУчетомСущественныхСобытий(СтрокаСтоимостейЦБ.ЦеннаяБумага, ПараметрыОценки, ДатаПереоценки, ПараметрыОценкиПоМоделиСущественныхСобытий.ПараметрыПоискаЦены, ПараметрыОценкиПоМоделиСущественныхСобытий.КоэффициентыСущественныхСобытий, Отказ, РасшифровкаРасчета);
				
				Если ЦенаПредыдущегоРабочегоДня <> Неопределено Тогда
					
					СтрокаСтоимостейЦБ.Стоимость		= ЦенаПредыдущегоРабочегоДня.Стоимость;
					СтрокаСтоимостейЦБ.ВидЦены			= ЦенаПредыдущегоРабочегоДня.ВидЦены;
					СтрокаСтоимостейЦБ.Источник			= ЦенаПредыдущегоРабочегоДня.Источник;
					СтрокаСтоимостейЦБ.УровеньОценки	= 2;
					СтрокаСтоимостейЦБ.ДатаЦены			= ЦенаПредыдущегоРабочегоДня.ДатаЦены;
					СтрокаСтоимостейЦБ.ВалютаКотировки	= ЦенаПредыдущегоРабочегоДня.ВалютаКотировки;
					
					Продолжить;
					
				КонецЕсли;						
				
				#КонецОбласти
								
			КонецЕсли;
			
		ИначеЕсли СтрокаСтоимостейЦБ.ЭмитентРоссийский Тогда
			
			Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				
				#Область Уровень_2_Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков_DCF
				
				Если ДатаПереоценки >= '20200101' Тогда
					
					ЦенаЗаполнена = ЗаполнитьДисконтированнойПоЗначениямКБДСтоимостью(СтрокаСтоимостейЦБ, ДатаПереоценки, ПараметрыОценки, 2, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, , 5, ПараметрыДенежногоПотока, Отказ, РасшифровкаРасчета);
					
					Если ЦенаЗаполнена Тогда
						Продолжить;
					КонецЕсли;

				Иначе
					
					#Область Расчет_цены_до_01_01_2020
					
					ПараметрыОценки.Вставить("ТочностьСтавкиДисконтирования", 2);
					
					PV = РассчитатьЦенуПоДисконтированнойПоБезрисковойСтавкеДоходностиСтоимости(СтрокаСтоимостейЦБ.ЦеннаяБумага, ПараметрыОценки, ДатаПереоценки, ПараметрыДенежногоПотока, Истина, СтрокаСтоимостейЦБ.Купон, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, 5, Отказ, РасшифровкаРасчета);
					
					Если Отказ = Ложь И PV > 0 Тогда
						
						// Если PV > OFFER, то брать OFFER
						// Если PV < BID, то брать BID
						
						#Область Получение_котировок_основного_рынка
						
						ЗапросКотировокОсновногоРынка = Новый Запрос( 
							"ВЫБРАТЬ РАЗРЕШЕННЫЕ
							|	КотировкиЦенныхБумаг.Рынок КАК Рынок,
							|	КотировкиЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
							|	КотировкиЦенныхБумаг.Биржа КАК Биржа,
							|	КотировкиЦенныхБумаг.Период КАК Период,
							|	КотировкиЦенныхБумаг.РежимТоргов КАК РежимТоргов,
							|	КотировкиЦенныхБумаг.Валюта КАК Валюта,
							|	КотировкиЦенныхБумаг.BID КАК BID,
							|	КотировкиЦенныхБумаг.OFFER КАК OFFER,
							|	КотировкиЦенныхБумаг.VOLUME КАК ОбъемСделокВКоличествеБумаг,
							|	КотировкиЦенныхБумаг.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность КАК ОбъемСделокВВалютеУчета
							|ПОМЕСТИТЬ КотировкиОсновногоРынкаММВБ
							|ИЗ
							|	РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиЦенныхБумаг
							|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
							|		ПО (КурсыВалют.Период = &ДатаПереоценки)
							|			И (КурсыВалют.Валюта = КотировкиЦенныхБумаг.Валюта)
							|ГДЕ
							|	КотировкиЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага
							|	И КотировкиЦенныхБумаг.Рынок = &Рынок
							|	И КотировкиЦенныхБумаг.Биржа = &ММВБ
							|	И КотировкиЦенныхБумаг.РежимТоргов.ОсновнойРежим
							|	И КотировкиЦенныхБумаг.Период = &ДатаПереоценки
							|;
							|
							|////////////////////////////////////////////////////////////////////////////////
							|ВЫБРАТЬ РАЗРЕШЕННЫЕ
							|	КотировкиОсновногоРынкаММВБ.ЦеннаяБумага КАК ЦеннаяБумага,
							|	КотировкиОсновногоРынкаММВБ.РежимТоргов КАК РежимТоргов,
							|	КотировкиОсновногоРынкаММВБ.ОбъемСделокВКоличествеБумаг КАК ОбъемСделокВКоличествеБумаг,
							|	КотировкиОсновногоРынкаММВБ.ОбъемСделокВВалютеУчета КАК ОбъемСделокВВалютеУчета,
							|	КОЛИЧЕСТВО(КотировкиОсновногоРынкаММВБ1.РежимТоргов) КАК Приоритет
							|ПОМЕСТИТЬ ОсновнойРынокММВБПриоритетРежимаТорговПоОбъему
							|ИЗ
							|	КотировкиОсновногоРынкаММВБ КАК КотировкиОсновногоРынкаММВБ
							|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КотировкиОсновногоРынкаММВБ КАК КотировкиОсновногоРынкаММВБ1
							|		ПО КотировкиОсновногоРынкаММВБ.ЦеннаяБумага = КотировкиОсновногоРынкаММВБ1.ЦеннаяБумага
							|			И КотировкиОсновногоРынкаММВБ.ОбъемСделокВКоличествеБумаг <= КотировкиОсновногоРынкаММВБ1.ОбъемСделокВКоличествеБумаг
							|			И КотировкиОсновногоРынкаММВБ.ОбъемСделокВВалютеУчета <= КотировкиОсновногоРынкаММВБ1.ОбъемСделокВВалютеУчета
							|
							|СГРУППИРОВАТЬ ПО
							|	КотировкиОсновногоРынкаММВБ.ЦеннаяБумага,
							|	КотировкиОсновногоРынкаММВБ.РежимТоргов,
							|	КотировкиОсновногоРынкаММВБ.ОбъемСделокВКоличествеБумаг,
							|	КотировкиОсновногоРынкаММВБ.ОбъемСделокВВалютеУчета
							|;
							|
							|////////////////////////////////////////////////////////////////////////////////
							|ВЫБРАТЬ РАЗРЕШЕННЫЕ
							|	КотировкиОсновногоРынкаММВБ.Биржа КАК Биржа,
							|	КотировкиОсновногоРынкаММВБ.РежимТоргов КАК РежимТоргов,
							|	ВЫБОР
							|		КОГДА КотировкиОсновногоРынкаММВБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
							|			ТОГДА (ВЫРАЗИТЬ(КотировкиОсновногоРынкаММВБ.BID * &Номинал КАК ЧИСЛО(27, 10))) / 100
							|		ИНАЧЕ КотировкиОсновногоРынкаММВБ.BID
							|	КОНЕЦ КАК BID,
							|	ВЫБОР
							|		КОГДА КотировкиОсновногоРынкаММВБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
							|			ТОГДА (ВЫРАЗИТЬ(КотировкиОсновногоРынкаММВБ.OFFER * &Номинал КАК ЧИСЛО(27, 10))) / 100
							|		ИНАЧЕ КотировкиОсновногоРынкаММВБ.OFFER
							|	КОНЕЦ КАК OFFER,
							|	КотировкиОсновногоРынкаММВБ.Период КАК Период
							|ИЗ
							|	КотировкиОсновногоРынкаММВБ КАК КотировкиОсновногоРынкаММВБ
							|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОсновнойРынокММВБПриоритетРежимаТорговПоОбъему КАК ПриоритетРежимаТорговПоОбъему
							|		ПО (ПриоритетРежимаТорговПоОбъему.ЦеннаяБумага = КотировкиОсновногоРынкаММВБ.ЦеннаяБумага)
							|			И (ПриоритетРежимаТорговПоОбъему.РежимТоргов = КотировкиОсновногоРынкаММВБ.РежимТоргов)
							|			И (ПриоритетРежимаТорговПоОбъему.Приоритет = 1)");
						
						ЗапросКотировокОсновногоРынка.УстановитьПараметр("ДатаПереоценки",		ДатаПереоценки);
						ЗапросКотировокОсновногоРынка.УстановитьПараметр("ЦеннаяБумага",		СтрокаСтоимостейЦБ.ЦеннаяБумага);
						ЗапросКотировокОсновногоРынка.УстановитьПараметр("Рынок",				СтрокаСтоимостейЦБ.Рынок);
						ЗапросКотировокОсновногоРынка.УстановитьПараметр("Номинал",				СтрокаСтоимостейЦБ.Номинал);
						ЗапросКотировокОсновногоРынка.УстановитьПараметр("ММВБ",				ММВБ);

						КотировкиОсновногоРынка = ЗапросКотировокОсновногоРынка.Выполнить().Выбрать();
						
						#КонецОбласти
						
						Если КотировкиОсновногоРынка.Следующий() Тогда
							OFFER	= КотировкиОсновногоРынка.OFFER;
							BID		= КотировкиОсновногоРынка.BID;
						Иначе
							OFFER	= Неопределено;
							BID		= Неопределено;
						КонецЕсли;
						
						Если ЗначениеЗаполнено(OFFER) И PV > OFFER Тогда
							СтрокаСтоимостейЦБ.Стоимость	= OFFER;
							СтрокаСтоимостейЦБ.ВидЦены		= Перечисления.ИсточникиЦеныДляПереоценки.ЦенаПредложения;
						ИначеЕсли ЗначениеЗаполнено(BID) И PV < BID Тогда
							СтрокаСтоимостейЦБ.Стоимость	= BID;
							СтрокаСтоимостейЦБ.ВидЦены		= Перечисления.ИсточникиЦеныДляПереоценки.ЦенаСпроса;
						Иначе
							СтрокаСтоимостейЦБ.Стоимость	= PV;
							СтрокаСтоимостейЦБ.ВидЦены		= Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена; 
						КонецЕсли;
						
						СтрокаСтоимостейЦБ.Биржа			= Справочники.Биржи.ПустаяСсылка();
						СтрокаСтоимостейЦБ.Источник			= Справочники.ЮрФизЛица.ПустаяСсылка();
						СтрокаСтоимостейЦБ.УровеньОценки	= 2;
						СтрокаСтоимостейЦБ.ДатаЦены			= ДатаПереоценки;
						СтрокаСтоимостейЦБ.ВалютаКотировки	= СтрокаСтоимостейЦБ.ВалютаНоминала;					
						
						Если РасшифровкаРасчета <> Неопределено Тогда
							ПараметрыРасчетаЦен = Новый Структура("ЦенаPV, ЦенаOFFER, ЦенаBID, Цена", PV, OFFER, BID, СтрокаСтоимостейЦБ.Стоимость);
							РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Параметры расчета цены (уровень 2)", ПараметрыРасчетаЦен);
						КонецЕсли;
						
						Продолжить;
						
					ИначеЕсли РасшифровкаРасчета <> Неопределено Тогда
						
						ПараметрыРасчетаЦен = Новый Структура("ЦенаPV", "Ошибка расчета или ЦенаPV = 0");
						РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Параметры расчета цены (уровень 2)", ПараметрыРасчетаЦен);
						
					КонецЕсли;
							
					#КонецОбласти
					
				КонецЕсли;

				#КонецОбласти
				
			ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
				
				#Область Уровень_2_Расчет_на_основе_корректировки_исторической_цены_CAPM					
				
				// Уровень 2. Справедливая стоимость акций, обращающихся на российских
				// и иностранных фондовых биржах, определяется в соответствии с моделью оценки,
				// основанной на корректировке исторической цены (CAPM).
				// Применяем при отсутствии цены не более 10 рабочих дней
				
				ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, Справочники.Календари.Общероссийский, , , Отказ, РасшифровкаРасчета);  
				
				Если ЦенаЗаполнена Тогда
					Продолжить;
				КонецЕсли;
				
				#КонецОбласти					
				
			КонецЕсли;
			
		КонецЕсли;

		Если ДатаПереоценки >= '20210101' Тогда
			
			#Область Уровень_3_Расчетная_цена_НРД_3_уровня
		
			// Цена, рассчитанная НРД по методологиям, утвержденным 01.12.2017 и позднее, основанная на следующих методах:
			// - Метод факторного разложения цены;
			// - Иных методах оценки, отвечающих критериям исходных данных 3-го уровня в соответствии с МСФО13
			
			Если ЦеныНРД.Получить(СтрокаСтоимостейЦБ.ПоследнийТорговыйДень) = Неопределено Тогда
				
				ДатыЦенНРД = Новый Массив;
				
				РаботаСКоллекциями.ДополнитьМассив(ДатыЦенНРД, ДополнительныеДатыЦенНРД);
				РаботаСКоллекциями.ДополнитьМассив(ДатыЦенНРД, СтрокаСтоимостейЦБ.ПоследнийТорговыйДень);
				
				ЦеныНРД.Вставить(СтрокаСтоимостейЦБ.ПоследнийТорговыйДень, ПолучитьЦеныНРД(ТаблицаСтоимостейЦБ, ДатыЦенНРД, РасшифровкаРасчета));
					
			КонецЕсли;
			
			ЦеныНРДТекущейЦБ = ЦеныНРД.Получить(СтрокаСтоимостейЦБ.ПоследнийТорговыйДень).Скопировать(
				Новый Структура("ЦеннаяБумага, VERSION, METHOD_NUMBER", СтрокаСтоимостейЦБ.ЦеннаяБумага, "2", "3"));						
			
			Если ЦеныНРДТекущейЦБ.Количество() > 0 Тогда
			
				СтрокаСтоимостейЦБ.Стоимость		= ЦеныНРДТекущейЦБ[0].Цена;
				СтрокаСтоимостейЦБ.ДатаЦены			= ЦеныНРДТекущейЦБ[0].ДатаЦены;
				СтрокаСтоимостейЦБ.УровеньОценки	= 3;
				СтрокаСтоимостейЦБ.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД;
				СтрокаСтоимостейЦБ.Источник			= НРД;
				СтрокаСтоимостейЦБ.ВалютаКотировки	= СтрокаСтоимостейЦБ.ВалютаНоминала;

				Продолжить;
				
			КонецЕсли;

			#КонецОбласти

		КонецЕсли;
		
	КонецЦикла;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "Таблица стоимостей ЦБ", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;

КонецФункции

Функция ПолучитьЦеныТранснефти2018(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	КалендарьКотировок		= Константы.ОсновнойКалендарьКотировок.Получить();	
	КалендарьОбщероссийский	= Справочники.Календари.Общероссийский;
	
	ПоследнийРабочийДень	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьОбщероссийский, НачалоДня(ДатаПереоценки));
	ПоследняяДатаТоргов		= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьКотировок, НачалоДня(ДатаПереоценки));	
	
	БратьЦеныПредыдущегоДня = Ложь;
	
	Если ДатаПереоценки >= Дата(2019, 01, 01) Тогда // с 1го января переоценка идет каждый день по ценам предыдущего ТОРГОГОГО дня!
		
		Если ПоследняяДатаТоргов <> ДатаПереоценки Тогда // если у нас неторговый день
			
			// берем котировки предыдущего дня
			Если КонецМесяца(ПоследняяДатаТоргов) < ДатаПереоценки Тогда
				ДеньВзятияЦен = КонецМесяца(ПоследняяДатаТоргов);
			Иначе
				ДеньВзятияЦен = ПоследняяДатаТоргов;
			КонецЕсли;
			
			БратьЦеныПредыдущегоДня = Истина;
			
		КонецЕсли;
		
	Иначе
		
		Если ПоследнийРабочийДень <> ДатаПереоценки // если у нас нерабочий день
			И (ПоследняяДатаТоргов <> ДатаПереоценки ИЛИ КонецМесяца(ДатаПереоценки) <> КонецДня(ДатаПереоценки)) // это не торговый день в "отчетную дату" (конец месяца)
		Тогда 
			
			// берем котировки предыдущего дня
			Если КонецМесяца(ПоследнийРабочийДень) < ДатаПереоценки Тогда
				ДеньВзятияЦен = Макс(ПоследнийРабочийДень, КонецМесяца(ПоследнийРабочийДень));
			Иначе
				ДеньВзятияЦен = ПоследнийРабочийДень;
			КонецЕсли;
			
			БратьЦеныПредыдущегоДня = Истина;
			
		КонецЕсли;
	
	КонецЕсли;	
	
	Если БратьЦеныПредыдущегоДня Тогда
		
		#Область Берем_цены_предыдущего_дня
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СтоимостьПереоценки.Рынок КАК Рынок,
			|	СтоимостьПереоценки.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
			|	СтоимостьПереоценки.ЦеннаяБумага.ВалютаНоминала КАК ВалютаКупона,
			|	СтоимостьПереоценки.ЦенаКотировки КАК Стоимость,
			|	СтоимостьПереоценки.ВидЦены КАК ВидЦены,
			|	СтоимостьПереоценки.ДатаЦены КАК ДатаЦены,
			|	СтоимостьПереоценки.УровеньОценки КАК УровеньОценки,
			|	СтоимостьПереоценки.Источник КАК Источник,
			|	СтоимостьПереоценки.ВалютаКотировки КАК ВалютаКотировки,
			|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал
			|ИЗ
			|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних КАК НоминалыЦенныхБумагСрезПоследних
			|		ПО СтоимостьПереоценки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
			|ГДЕ
			|	СтоимостьПереоценки.Период = &Период
			|	И СтоимостьПереоценки.Организация = &Организация
			|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И СтоимостьПереоценки.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
			|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
			|	И СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ЕдиныйПланСчетов)";
		
		Запрос.УстановитьПараметр("Период", НачалоДня(ДеньВзятияЦен));
		Запрос.УстановитьПараметр("Организация", ПараметрыОценки.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыОценки.СчетДоверительногоУправления);
		
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Получить цены Транснефти 2018 (ЕПС)", "Таблица стоимостей ЦБ за " + Формат(ДеньВзятияЦен, "ДФ=dd.MM.yyyy"), ТаблицаСтоимостейЦБ.Скопировать());
		КонецЕсли;
		
		Возврат ТаблицаСтоимостейЦБ;
		
		#КонецОбласти	
		
	КонецЕсли;	
	
	#Область Основной_запрос	
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаСпискаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
