					КонецЕсли;
					
				КонецЕсли;						
				
				#КонецОбласти
			
		 	ИначеЕсли ИностранныеУчетныеАктивы.Найти(ЦеннаяБумага.УчетныйАктивЦБРФ) = Неопределено 
				И СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации
			Тогда					
				
				//нужно протянуть индикатор по бумаге. Пока отложено
				//Расчет_на_основе_корректировки_исторической_цены					

			КонецЕсли;

		КонецЦикла;
		
		#КонецОбласти
		
	Иначе
		
		#Область Первоначальная_версия_методики
		
		#Область Основной_запрос	
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
