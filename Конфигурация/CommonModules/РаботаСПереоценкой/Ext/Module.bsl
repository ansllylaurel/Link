	ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_FWB"));
    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Насдак"));
    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_HKEX"));
	
	ММВБ		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	Блумберг	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
	НРД			= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");	
	
	КалендарьКотировок			= Константы.ОсновнойКалендарьКотировок.Получить();	
	ПоследняяДатаТоргов			= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьКотировок, НачалоДня(ДатаПереоценки));	
	ПоследняяДатаТорговБлумберг	= РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки, Блумберг);	
	
	ВариантТестаЦеныНРД = "по BID и OFFER";
	Если ДатаПереоценки >= '20210122' Тогда
		ВариантТестаЦеныНРД = "по BID и OFFER при наличии их и спреда";
	КонецЕсли;	
	
	// Цена на дату оценки (или на последний ближайший торговый день, если дата определения СЧА является не торговым днем
	// и цена для этого дня не рассчитывалась), рассчитанная НКО ЗАО НРД
	
	БратьЦеныНРДНаДатуТоргов = Истина;

	// Для государственных ценных бумаг, облигаций российских эмитентов, акций российских эмитентов, облигаций иностранных государств
	// и акций иностранных эмитентов, российских и иностранных депозитарных расписок на акции иностранных эмитентов
	
	ОцениватьАкцииИОблигацииКромеОВОЗРФТолькоПоЦенеНРД = Ложь;
	
	Если НачалоДня(ДатаПереоценки) <> ПоследняяДатаТоргов И ПоследняяДатаТоргов <> '20220225' Тогда // убираем это ограничение с 25.02.2022 до возобновления торгов (#418072)
	
		// Если на всех доступных и наблюдаемых биржевых площадках был неторговый день на дату определения СЧА,
		// в случае изменения ключевой ставки расчет стоимости осуществляется на основе цены НРД,
		// а в случае ее отсутствия на дату оценки - на основе экспертного суждения Фонда
		
		ИзмениласьКлючеваяСтавка = РегистрыСведений.ПроцентныеПоказатели.ПоказательИзменилсяЗаПериод(Перечисления.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ, ПоследняяДатаТоргов, ДатаПереоценки);

		Если ИзмениласьКлючеваяСтавка = Истина Тогда
			ОцениватьАкцииИОблигацииКромеОВОЗРФТолькоПоЦенеНРД	= Истина;
			БратьЦеныНРДНаДатуТоргов							= Ложь;
		КонецЕсли;
	
	КонецЕсли;

	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберг",	ПоследняяДатаТорговБлумберг);
	Запрос.УстановитьПараметр("КалендарныхДнейНазад35",			НачалоДня(ДатаПереоценки) - 35 * 86400);
	
	Запрос.УстановитьПараметр("ММВБ",							ММВБ);
	Запрос.УстановитьПараметр("НРД",							НРД);
	Запрос.УстановитьПараметр("Блумберг",						Блумберг);
	Запрос.УстановитьПараметр("ДоступныеБиржи",					ДоступныеБиржи);
	Запрос.УстановитьПараметр("ДоступныДанныеBloomberg",		ПроверитьДоступностьДанныхBloomberg(ДатаПереоценки));
	
