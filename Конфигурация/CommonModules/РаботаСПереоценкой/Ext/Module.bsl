		|		ЛЕВОЕ СОЕДИНЕНИЕ ОсновныеПлощадкиЦБ КАК ОсновныеПлощадкиЦБ
		|		ПО (ОсновныеПлощадкиЦБ.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ КотировкиОсновнойПлощадки КАК КотировкиОсновнойПлощадки
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ КотировкиОсновнойПлощадкиПриоритетРежимаТорговПоОбъему КАК ПриоритетРежимаТорговПоОбъему
		|			ПО (ПриоритетРежимаТорговПоОбъему.ЦеннаяБумага = КотировкиОсновнойПлощадки.ЦеннаяБумага)
		|				И (ПриоритетРежимаТорговПоОбъему.РежимТоргов = КотировкиОсновнойПлощадки.РежимТоргов)
		|				И (ПриоритетРежимаТорговПоОбъему.Приоритет = 1)
		|		ПО (КотировкиОсновнойПлощадки.ЦеннаяБумага = ОсновныеПлощадкиЦБ.ЦеннаяБумага)";
	
	#КонецОбласти
	
	ТолькоНаблюдаемыеЦены = ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены;
	
	ДоступныеБиржи = Новый Массив;
	ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_SPBEX"));
    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_СПВБ"));
	
	Если ДатаПереоценки < '20230401' Тогда
		
		ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_LSE"));
		ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_NYSE"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Amsterdam"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Brussels"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Lisbon"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Paris"));
		ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_AMEX"));
		ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_FWB"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Насдак"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_HKEX"));
		
	КонецЕсли;
		
	ММВБ		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	Блумберг	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
	НРД			= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");	
	
	КалендарьКотировок			= Константы.ОсновнойКалендарьКотировок.Получить();	
	ПоследняяДатаТоргов			= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьКотировок, НачалоДня(ДатаПереоценки));	
	ПоследняяДатаТорговБлумберг	= РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки, Блумберг);	
	
	БратьЦеныНРДНаДатуТоргов					= Ложь;
	ТестироватьЦеныНРД							= Ложь;
	ВключатьГраницыВСпредПриТестированииЦенНРД	= Ложь;
	ОцениватьАкцииИОблигацииТолькоПоЦенеНРД		= Ложь;
	
	Если ДатаПереоценки >= '20210101' Тогда
	
	    #Область Параметры_оценки_СЧА_с_2021_года
		
		// Цена на дату оценки (или на последний ближайший торговый день, если дата определения СЧА является не торговым днем
		// и цена для этого дня не рассчитывалась), рассчитанная НКО ЗАО НРД
		
		БратьЦеныНРДНаДатуТоргов = Истина;
		
		// Цена НРД используется при условии подтверждения ее корректности.
		// Цена НРД признается корректной, если данная цена находится в пределах спрэда по спросу и предложению на основном,
		// а при отсутствии основного на наиболее предпочтительном рынке (для ПАО «Московская биржа» bid и offer) на указанную дату
		
		ТестироватьЦеныНРД = Истина;

		// В правилах спред задан как интервал, а не как отрезок (#381514)
		
		ВключатьГраницыВСпредПриТестированииЦенНРД = ТестироватьЦеныНРД И (ДатаПереоценки < '20210630');
		
		// Для государственных ценных бумаг, облигаций российских эмитентов, акций российских эмитентов, облигаций иностранных государств
		// и акций иностранных эмитентов, российских и иностранных депозитарных расписок на акции иностранных эмитентов
		
		Если НачалоДня(ДатаПереоценки) <> ПоследняяДатаТоргов И ПоследняяДатаТоргов <> '20220225' Тогда // убираем это ограничение с 25.02.2022 до возобновления торгов (#418072)
		
			// Если на всех доступных и наблюдаемых биржевых площадках был неторговый день на дату определения СЧА,
			// в случае изменения ключевой ставки расчет стоимости осуществляется на основе цены НРД,
			// а в случае ее отсутствия на дату оценки - на основе экспертного суждения Фонда
				
			ИзмениласьКлючеваяСтавка = РегистрыСведений.ПроцентныеПоказатели.ПоказательИзменилсяЗаПериод(Перечисления.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ, ПоследняяДатаТоргов, ДатаПереоценки);

			Если ИзмениласьКлючеваяСтавка = Истина Тогда
				ОцениватьАкцииИОблигацииТолькоПоЦенеНРД	= Истина;
				БратьЦеныНРДНаДатуТоргов				= Ложь;
			КонецЕсли;
		
		КонецЕсли;
	
		#КонецОбласти
		
	КонецЕсли;	
	
	ДоступныДанныеБлумберг									  = ПроверитьДоступностьДанныхBloomberg(ДатаПереоценки);
	ОцениватьБумагиМеждународногоВнебиржевогоРынкаПоБлумбергу = ДоступныДанныеБлумберг И ДатаПереоценки < '20230401';
	
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберг",	ПоследняяДатаТорговБлумберг);
	Запрос.УстановитьПараметр("КалендарныхДнейНазад35",			НачалоДня(ДатаПереоценки) - 35 * 86400);
	
	Запрос.УстановитьПараметр("ММВБ",					 ММВБ);
	Запрос.УстановитьПараметр("НРД",					 НРД);
	Запрос.УстановитьПараметр("Блумберг",				 Блумберг);
	Запрос.УстановитьПараметр("ДоступныеБиржи",			 ДоступныеБиржи);
	Запрос.УстановитьПараметр("ДоступныДанныеBloomberg", ДоступныДанныеБлумберг);
	
	Запрос.УстановитьПараметр("Режим_BGN",		ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL",		ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	Запрос.УстановитьПараметр("ВалютаРубли",	ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	Запрос.УстановитьПараметр("БратьЦеныНРДНаДатуТоргов",									БратьЦеныНРДНаДатуТоргов);
	Запрос.УстановитьПараметр("ТестироватьЦеныНРД",											ТестироватьЦеныНРД);
	Запрос.УстановитьПараметр("ВключатьГраницыВСпредПриТестированииЦенНРД",					ВключатьГраницыВСпредПриТестированииЦенНРД);
	Запрос.УстановитьПараметр("ОцениватьАкцииИОблигацииТолькоПоЦенеНРД",					ОцениватьАкцииИОблигацииТолькоПоЦенеНРД);
	Запрос.УстановитьПараметр("ОцениватьБумагиМеждународногоВнебиржевогоРынкаПоБлумбергу",	ОцениватьБумагиМеждународногоВнебиржевогоРынкаПоБлумбергу);
	
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены", ТолькоНаблюдаемыеЦены);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Национального 2020 (ЕПС)", "Таблица стоимостей ЦБ");		
	КонецЕсли;
	
	Если ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;
	
	// Расчетные цены 	
	
	ВыполненРасчетЦены = Ложь;	
	
	ЦеныНРДНаДатуОценки				= Неопределено;
	ЦеныНРДПоследнегоТорговогоДня	= Новый Соответствие;
	
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);	
	ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	
	ПараметрыРасчетаСтоимостиПоАналогам = Новый Структура;
	ПараметрыРасчетаСтоимостиПоАналогам.Вставить("ВариантРасчета",	 Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020);
	ПараметрыРасчетаСтоимостиПоАналогам.Вставить("ПараметрыЗапроса", Запрос.Параметры);
	
	ПараметрыОценки.Вставить("ПараметрыРасчетаСтоимостиПоАналогам",	ПараметрыРасчетаСтоимостиПоАналогам);
	ПараметрыОценки.Вставить("ТочностьКБД",							2);
	
	Если ДатаПереоценки < '20200701' Тогда
		ПараметрыОценки.Вставить("ТочностьДисконтированногоПотока", 6);
	КонецЕсли;	
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены) ИЛИ СтрокаСтоимостейЦБ.ОценкаПоАмортизированнойСтоимости Тогда
			Продолжить;
		КонецЕсли;
		
		// Требуется расчет цены
		
		ОшибкаРасчета = Ложь;
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			Если СтрокаСтоимостейЦБ.СчитаемЧтоДефолт Тогда
				Если РасшифровкаРасчета <> Неопределено Тогда	
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Оценка дефолтных долговых ценных бумаг", Новый Структура("Описание", "Оценка дефолтных долговых ценных бумаг не реализована"));
				КонецЕсли;		
				Продолжить;	
			КонецЕсли;
			
			Если СтрокаСтоимостейЦБ.ОсновнойРынок <> "НРД"
				И (СтрокаСтоимостейЦБ.ОсновнойРынок <> "Международный внебиржевой рынок" ИЛИ ОцениватьБумагиМеждународногоВнебиржевогоРынкаПоБлумбергу)
			Тогда
				
				#Область Расчет_PV_по_ставке_рассчитанной_по_аналогам
				
				ЦенаЗаполнена = ЗаполнитьДисконтированнойПоСтавкеРассчитаннойПоАналогамСтоимостью(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 2, ПараметрыДенежногоПотока, , ОшибкаРасчета, РасшифровкаРасчета);
				
				Если ОшибкаРасчета Тогда
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
					Продолжить;
				ИначеЕсли ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
					Продолжить;
				КонецЕсли;
				
				УведомитьОбОтсутствииАналогов(СтрокаСтоимостейЦБ.ЦеннаяБумага, ПараметрыОценки, ДатаПереоценки);  
				
				#КонецОбласти
				
			КонецЕсли;			
			
			Если СтрокаСтоимостейЦБ.ОсновнойРынок = "Российская торговая площадка"
				ИЛИ СтрокаСтоимостейЦБ.ОсновнойРынок = "Российский внебиржевой рынок"
				ИЛИ СтрокаСтоимостейЦБ.ОсновнойРынок = "НРД"
			Тогда
			
			    #Область Расчетная_цена_НРД_3_уровня
			
				// Цена, рассчитанная НРД по методологиям, утвержденным 01.12.2017 и позднее, основанная на следующих методах:
				// - Метод факторного разложения цены;
				// - Иных методах оценки, отвечающих критериям исходных данных 3-го уровня в соответствии с МСФО13
				
				Если ЦеныНРДНаДатуОценки = Неопределено Тогда
					ЦеныНРДНаДатуОценки = ПолучитьЦеныНРД(ТаблицаСтоимостейЦБ, НачалоДня(ДатаПереоценки), РасшифровкаРасчета);
				КонецЕсли;
				
				ЦеныНРДТекущейЦБ = ЦеныНРДНаДатуОценки.Скопировать(Новый Структура("ЦеннаяБумага, VERSION, METHOD_NUMBER", СтрокаСтоимостейЦБ.ЦеннаяБумага, "2", "3")); 
				
				Если ЦеныНРДТекущейЦБ.Количество() = 0 И БратьЦеныНРДНаДатуТоргов Тогда
					
					Если ЦеныНРДПоследнегоТорговогоДня.Получить(СтрокаСтоимостейЦБ.ПоследняяДатаТоргов) = Неопределено Тогда
						ЦеныНРДПоследнегоТорговогоДня.Вставить(
							СтрокаСтоимостейЦБ.ПоследняяДатаТоргов,
							ПолучитьЦеныНРД(ТаблицаСтоимостейЦБ, ПоследняяДатаТоргов, РасшифровкаРасчета));
					КонецЕсли;	
						
					ЦеныНРДТекущейЦБ = ЦеныНРДПоследнегоТорговогоДня[СтрокаСтоимостейЦБ.ПоследняяДатаТоргов].Скопировать(
						Новый Структура("ЦеннаяБумага, VERSION, METHOD_NUMBER", СтрокаСтоимостейЦБ.ЦеннаяБумага, "2", "3")); 
						
				КонецЕсли;
				
				Если ЦеныНРДТекущейЦБ.Количество() > 0 Тогда

					ЦенаНРД	= ЦеныНРДТекущейЦБ[0].Цена;
					OFFER	= СтрокаСтоимостейЦБ.OFFER * СтрокаСтоимостейЦБ.Номинал / 100;
					BID		= СтрокаСтоимостейЦБ.BID * СтрокаСтоимостейЦБ.Номинал / 100;
					
					Если НЕ ТестироватьЦеныНРД
						ИЛИ СтрокаСтоимостейЦБ.ОсновнойРынок = "НРД"
						ИЛИ OFFER = 0 ИЛИ BID = 0
						ИЛИ BID < ЦенаНРД И ЦенаНРД < OFFER 	
						ИЛИ OFFER < ЦенаНРД И ЦенаНРД < BID 	
					Тогда
						
						СтрокаСтоимостейЦБ.Стоимость	= ЦенаНРД;
						СтрокаСтоимостейЦБ.ДатаЦены		= ЦеныНРДТекущейЦБ[0].ДатаЦены;
						СтрокаСтоимостейЦБ.ВидЦены		= Перечисления.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД;
						СтрокаСтоимостейЦБ.Источник		= НРД;
						
					ИначеЕсли МатематическиеФункции.МодульЧисла(ЦенаНРД - OFFER) < МатематическиеФункции.МодульЧисла(ЦенаНРД - BID) Тогда
						
						СтрокаСтоимостейЦБ.Стоимость	= OFFER;
						СтрокаСтоимостейЦБ.ДатаЦены		= СтрокаСтоимостейЦБ.ПоследняяДатаТоргов;
						СтрокаСтоимостейЦБ.ВидЦены 		= Перечисления.ИсточникиЦеныДляПереоценки.ЦенаПредложения;
						СтрокаСтоимостейЦБ.Источник		= СтрокаСтоимостейЦБ.ОсновнаяПлощадка.ЮрФизЛицо;
						
					Иначе
						
						СтрокаСтоимостейЦБ.Стоимость	= BID;
						СтрокаСтоимостейЦБ.ДатаЦены		= СтрокаСтоимостейЦБ.ПоследняяДатаТоргов;
						СтрокаСтоимостейЦБ.ВидЦены		= Перечисления.ИсточникиЦеныДляПереоценки.ЦенаСпроса;
						СтрокаСтоимостейЦБ.Источник		= СтрокаСтоимостейЦБ.ОсновнаяПлощадка.ЮрФизЛицо;
											
					КонецЕсли;
						
					СтрокаСтоимостейЦБ.УровеньОценки	= 3;
					СтрокаСтоимостейЦБ.ВалютаКотировки	= СтрокаСтоимостейЦБ.ВалютаНоминала;

					Если РасшифровкаРасчета <> Неопределено И ТестироватьЦеныНРД И СтрокаСтоимостейЦБ.ОсновнойРынок <> "НРД" Тогда
						ПараметрыРасчетаЦен = Новый Структура("Описание, ЦенаНРД, OFFER, BID, Цена",
							"Цена НРД должна попадать в спред BID и OFFER, иначе берется ближайшая граница спреда", ЦенаНРД, OFFER, BID, СтрокаСтоимостейЦБ.Стоимость);
						РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Тестирование цены НРД", ПараметрыРасчетаЦен);
					КонецЕсли;					
					
					ВыполненРасчетЦены = Истина;
					Продолжить;
					
				КонецЕсли;

				#КонецОбласти
				
				Если СтрокаСтоимостейЦБ.ОсновнойРынок <> "НРД" Тогда
				
					#Область Расчет_PV_по_ставкам_КБД_скорректированным_на_кредитный_спред
					
					ЦенаЗаполнена = ЗаполнитьДисконтированнойПоЗначениямКБДСтоимостью(СтрокаСтоимостейЦБ, ДатаПереоценки, ПараметрыОценки, 3, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, , , ПараметрыДенежногоПотока, ОшибкаРасчета, РасшифровкаРасчета);
					
					Если ОшибкаРасчета Тогда
						ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
						Продолжить;
					ИначеЕсли ЦенаЗаполнена Тогда 
						ВыполненРасчетЦены = Истина;
						Продолжить;
					КонецЕсли;
					
					#КонецОбласти
					
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда	
			
			Если СтрокаСтоимостейЦБ.ОсновнойРынок = "Российская торговая площадка"
				ИЛИ СтрокаСтоимостейЦБ.ОсновнойРынок = "Иностранная торговая площадка"
			Тогда
			
				#Область Расчет_на_основе_корректировки_исторической_цены
				
				// Справедливая стоимость акций, обращающихся на российских и иностранных фондовых биржах,
				// определяется в соответствии с моделью оценки, основанной на корректировке исторической цены (CAPM).
				// Применяем при отсутствии цены не более 10 рабочих дней
				
				ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, Справочники.Календари.Общероссийский, 3, , ОшибкаРасчета, РасшифровкаРасчета);  
				
				Если ОшибкаРасчета Тогда
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
					Продолжить;
				ИначеЕсли ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
				КонецЕсли;

				#КонецОбласти
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "После расчета цен", ТаблицаСтоимостейЦБ.Скопировать());	
	КонецЕсли;
		
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныТранснефти2020(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)

	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ИсходнаяТаблицаЦБ");
	ПоместитьБумагиОцениваемыеПоАмортизированнойСтоимостиВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки, ДатаПереоценки, "_ИсходнаяТаблицаЦБ");
	ПоместитьСтатусыЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "_ИсходнаяТаблицаЦБ"); 
	ПоместитьЭмитентовЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "_ИсходнаяТаблицаЦБ");	
	ПоместитьСведенияОТоргахЦеннымиБумагамиВМенеджерВременныхТаблиц(Запрос, "_ИсходнаяТаблицаЦБ", ДатаПереоценки, 10, "_СведенияОТоргахЦеннымиБумагами");	
	ПоместитьОценкиПоНоминалуДляПогашенныхЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления, ДатаПереоценки);
	
	#Область Основной_запрос	
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	_ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(Облигации.ДатаНачалаОбращения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаОбращения,
		|	ЕСТЬNULL(Облигации.ДатаНачалаРазмещения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаРазмещения,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, НЕОПРЕДЕЛЕНО) КАК ДатаПогашения,
		|	ЕСТЬNULL(Облигации.ДатаПогашения <> ДАТАВРЕМЯ(1, 1, 1)
		|			И Облигации.ДатаПогашения < ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -7), ЛОЖЬ) КАК СчитаемЧтоДефолт,
		|	ЕСТЬNULL(Облигации.ВалютаНоминала = &ВалютаРубли, ЛОЖЬ) КАК ОблигацияРублевая,
		|	ЕСТЬNULL(Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ), ЛОЖЬ) КАК ОблигацияОВОЗ,
		|	ЕСТЬNULL(Облигации.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств), ЛОЖЬ) КАК ОблигацияИнострГосударства,
		|	ЕСТЬNULL(Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|			И НЕ РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЕврооблигацияИнострЭмитента,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЭмитентРоссийский,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация), ЛОЖЬ) КАК ЭмитентМеждународнаяФинОрганизация,
		|	ЕСТЬNULL(_ЭмитентыЦенныхБумаг.Банкрот, ЛОЖЬ) КАК ЭмитентБанкрот,
		|	_ЭмитентыЦенныхБумаг.ДатаБанкротства КАК ЭмитентДатаБанкротства,
		|	_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента КАК Эмитент,
		|	_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК ОценкаПоАмортизированнойСтоимости,
		|	_ЦБПоНоминальнойСтоимостиПослеПогашения.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК ОценкаПоНоминалу,
		|	_СведенияОТоргахЦеннымиБумагами.Дата КАК ПоследняяДатаТоргов
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						_ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ИСТИНА
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|					ГДЕ
