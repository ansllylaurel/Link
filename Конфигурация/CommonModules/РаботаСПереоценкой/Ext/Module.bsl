	ММВБ						= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");	
	НРД							= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");	
	Блумберг					= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
	
	ОсновнойКалендарьКотировок	= Константы.ОсновнойКалендарьКотировок.Получить();	
	ПоследняяДатаТорговБлумберг	= РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки, Блумберг);
	РабочихДнейНазад10			= Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ДатаПереоценки), -10);
	
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберг",	ПоследняяДатаТорговБлумберг);
	Запрос.УстановитьПараметр("РабочихДнейНазад10",				РабочихДнейНазад10);
	
	Запрос.УстановитьПараметр("ММВБ",					 ММВБ);	
	Запрос.УстановитьПараметр("НРД",					 НРД);
	Запрос.УстановитьПараметр("Блумберг",				 Блумберг);
	Запрос.УстановитьПараметр("ДоступныДанныеBloomberg", ПроверитьДоступностьДанныхBloomberg(ДатаПереоценки));
	
	Запрос.УстановитьПараметр("Режим_BGN",				ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL",				ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	Запрос.УстановитьПараметр("ВалютаРубли",			ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены",	ТолькоНаблюдаемыеЦены);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены УГМК-Перспектива 2021", "Таблица стоимостей ЦБ", , , "ИсходнаяТаблицаЦБ, _БумагиОцениваемыеПоАмортизированнойСтоимости, _ЦБПоНоминальнойСтоимостиПослеПогашения, ЭмитентыЦенныхБумаг");
	КонецЕсли;
	
	Если ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;
	
	// Расчетные цены 	
	
	ВыполненРасчетЦены = Ложь;	
	
	ПараметрыОценки.Вставить("ТочностьСтавкиДисконтирования", 2);
	ПараметрыОценки.Вставить("ТочностьDCF",					  4);
	
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		Если СтрокаСтоимостейЦБ.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.Номинал Тогда
			Продолжить; // Для погашенных ЦБ дополнительные действия не требуются
		КонецЕсли;	
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены) ИЛИ СтрокаСтоимостейЦБ.ОценкаПоАмортизированнойСтоимости Тогда
			Продолжить;
		КонецЕсли;
		
		// Расчетные цены
		
		ОшибкаРасчета = Ложь;
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			Если СтрокаСтоимостейЦБ.ЭмитентРоссийский И Не СтрокаСтоимостейЦБ.ОблигацияОВОЗРФ Тогда
			
				#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков
				
				ЦенаЗаполнена = ЗаполнитьДисконтированнойПоБезрисковойСтавкеДоходностиСтоимостью(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, ПараметрыДенежногоПотока, , 2, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, , Отказ, РасшифровкаРасчета);
		
				Если ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
				КонецЕсли;
				
				#КонецОбласти
			
			КонецЕсли;
			
		ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
			
			Если СтрокаСтоимостейЦБ.ЭмитентРоссийский И СтрокаСтоимостейЦБ.ТоргуетсяНаММВБ Тогда
			
				#Область Расчет_на_основе_корректировки_исторической_цены					
				
				// Справедливая стоимость акций российских эмитентов, допущенных к торгам на ММВБ,
				// определяется в соответствии с моделью оценки, основанной на корректировке исторической цены (CAPM).
				// Применяем при отсутствии наблюдаемой цены не более 10 торговых дней
				
				ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, ОсновнойКалендарьКотировок, , 6, Отказ, РасшифровкаРасчета);  
				
				Если ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
				КонецЕсли;
				
				#КонецОбласти					
			
			КонецЕсли;
			
		КонецЕсли;

	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "После расчета цен", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;	

КонецФункции

Функция ПолучитьЦеныБлагосостояния2020(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)

	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ИсходнаяТаблицаЦБ");
	ПоместитьБумагиОцениваемыеПоАмортизированнойСтоимостиВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки, ДатаПереоценки, "_ИсходнаяТаблицаЦБ");
	ПоместитьТаблицуДатРасчетныхЦенПаевВМенеджерВременныхТаблиц(Запрос, "_ИсходнаяТаблицаЦБ", ДатаПереоценки, "_ТаблицаДатРасчетныхЦенПаев");
	
	#Область Основной_запрос	
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПриоритетыЦен.ВидАктива КАК ВидАктива,
		|	ПриоритетыЦен.ТоргуетсяНаММВБ КАК ТоргуетсяНаММВБ,
		|	ПриоритетыЦен.ВыпущеныВРФ КАК ВыпущеныВРФ,
		|	ПриоритетыЦен.ВходитВИндексММВБ КАК ВходитВИндексММВБ,
		|	ПриоритетыЦен.ВидЦены КАК ВидЦены,
		|	ПриоритетыЦен.Уровень КАК Уровень,
		|	ПриоритетыЦен.Приоритет КАК Приоритет,
		|	ПриоритетыЦен.ПроверитьИзменениеЦеновогоИндекса КАК ПроверитьИзменениеЦеновогоИндекса,
		|	ПриоритетыЦен.ПроверитьСпредДоходности КАК ПроверитьСпредДоходности,
		|	ПриоритетыЦен.ПроверитьОбъемТорговЗаДень КАК ПроверитьОбъемТорговЗаДень,
		|	ПриоритетыЦен.ПроверитьВхождениеВСпредЦенСпросаИПредложения КАК ПроверитьВхождениеВСпредЦенСпросаИПредложения,
		|	ПриоритетыЦен.Примечание КАК Примечание
		|ПОМЕСТИТЬ _ПриоритетыЦен
		|ИЗ
		|	&ПриоритетыЦен КАК ПриоритетыЦен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтатусыЦенныхБумагСрезПоследних.Рынок КАК Рынок,
		|	СтатусыЦенныхБумагСрезПоследних.Период КАК Период,
		|	СтатусыЦенныхБумагСрезПоследних.Статус КАК Статус,
		|	СтатусыЦенныхБумагСрезПоследних.Биржа КАК Биржа
		|ПОМЕСТИТЬ _СтатусыЦенныхБумаг
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						_ИсходнаяТаблицаЦБ.ЦеннаяБумага
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО (СтатусыЦенныхБумагСрезПоследних.Рынок = _ИсходнаяТаблицаЦБ.Рынок)
		|			И (СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|			И (СтатусыЦенныхБумагСрезПоследних.Активен)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЕСТЬNULL(Эмитенты.ЮрФизЛицо, _ТаблицаДатРасчетныхЦенПаев.ПаевойИнвестиционныйФонд) КАК Эмитент,
		|	ЕСТЬNULL(Эмитенты.ЮрФизЛицо, РеквизитыПИФ.УправляющаяКомпания.ЮрФизЛицо) КАК ЮрЛицоЭмитента,
		|	_ТаблицаДатРасчетныхЦенПаев.ТипПИФ КАК ТипПИФ,
		|	РасчетныеЦеныПаев.КоличествоПаев КАК ОбщееКоличествоПаевПИФ,
		|	РасчетныеЦеныПаев.Период КАК ДатаЦеныПая,
		|	РасчетныеЦеныПаев.РасчетнаяЦена КАК ЦенаПая
		|ПОМЕСТИТЬ _ЭмитентыЦенныхБумаг
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Векселя КАК Векселя
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Векселя.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеРасписки КАК ДепозитарныеРасписки
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = ДепозитарныеРасписки.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = ИпотечныеСертификатыУчастия.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|		ПО (Эмитенты.Ссылка = ВЫБОР
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|					ТОГДА Акции.Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|					ТОГДА Облигации.Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|					ТОГДА Векселя.Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|					ТОГДА ДепозитарныеРасписки.Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|					ТОГДА ИпотечныеСертификатыУчастия.Эмитент
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаДатРасчетныхЦенПаев КАК _ТаблицаДатРасчетныхЦенПаев
		|		ПО (_ТаблицаДатРасчетныхЦенПаев.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев КАК РасчетныеЦеныПаев
		|		ПО (РасчетныеЦеныПаев.ЦеннаяБумага = _ТаблицаДатРасчетныхЦенПаев.ЦеннаяБумага)
		|			И (РасчетныеЦеныПаев.Период = _ТаблицаДатРасчетныхЦенПаев.Дата)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ПаевойИнвестиционныйФонд, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						_ТаблицаДатРасчетныхЦенПаев.ПаевойИнвестиционныйФонд,
		|						ИСТИНА
		|					ИЗ
		|						_ТаблицаДатРасчетныхЦенПаев)) КАК РеквизитыПИФ
		|		ПО (РеквизитыПИФ.ПаевойИнвестиционныйФонд = _ТаблицаДатРасчетныхЦенПаев.ПаевойИнвестиционныйФонд)
		|ГДЕ
		|	(_ТаблицаДатРасчетныхЦенПаев.ПаевойИнвестиционныйФонд ЕСТЬ НЕ NULL 
		|			ИЛИ Эмитенты.Ссылка ЕСТЬ НЕ NULL )
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная), ЛОЖЬ)
		|		И НЕ ЕСТЬNULL(Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ), ЛОЖЬ) КАК ГосударственнаяЦБРФ,
		|	_ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|		И ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ)
		|		И НЕ ЕСТЬNULL(Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная), ЛОЖЬ)
		|		И НЕ ЕСТЬNULL(Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ), ЛОЖЬ) КАК ОблигацияРоссийскогоЭмитента,
		|	ЕСТЬNULL(Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ), ЛОЖЬ) КАК ОблигацияОВОЗРФ,
		|	ЕСТЬNULL(Облигации.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств), ЛОЖЬ) КАК ОблигацияИнострГосударства,
		|	ЕСТЬNULL(Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация), ЛОЖЬ)
