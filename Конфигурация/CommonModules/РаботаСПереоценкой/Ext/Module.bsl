		|	ЕСТЬNULL(ОцененныеБумаги.ВидЦены, 0) КАК ВидЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, ЕСТЬNULL(ОцененныеБумаги.Источник, 0)) КАК Источник,
		|	0 КАК Купон,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаКупона,
