		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦБУровень2 КАК _ЦБУровень2
		|		ПО (_ЦБУровень2.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						_ТаблицаЦБ.ЦеннаяБумага
		|					ИЗ
		|						_ТаблицаЦБ
		|					ГДЕ
		|						_ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))) КАК РасчетныеЦеныПаев
		|		ПО (РасчетныеЦеныПаев.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (РасчетныеЦеныПаев.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, МЕСЯЦ, -6))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФ
		|		ПО (Паи.ПаевойИнвестиционныйФонд = РеквизитыПИФ.ПаевойИнвестиционныйФонд)
		|ГДЕ
		|	_ЦБУровень1.ЦеннаяБумага ЕСТЬ NULL
		|	И _ЦБУровень2.ЦеннаяБумага ЕСТЬ NULL
		|	И НЕ &ТолькоНаблюдаемыеЦены
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦБУровень1.Рынок КАК Рынок,
		|	_ЦБУровень1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ЦБУровень1.ВалютаНоминала КАК ВалютаНоминала,
		|	_ЦБУровень1.УровеньОценки КАК УровеньОценки,
		|	_ЦБУровень1.ВидЦены КАК ВидЦены,
		|	_ЦБУровень1.СправедливаяЦена КАК СправедливаяЦена,
		|	_ЦБУровень1.ВалютаЦены КАК ВалютаКотировки,
		|	_ЦБУровень1.ВалютаЦены КАК Валюта,
		|	_ЦБУровень1.ДатаЦены КАК ДатаЦены,
		|	_ЦБУровень1.Источник КАК Источник
		|ПОМЕСТИТЬ _ОцененныеБумаги
		|ИЗ
		|	_ЦБУровень1 КАК _ЦБУровень1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦБУровень2.Рынок,
		|	_ЦБУровень2.ЦеннаяБумага,
		|	_ЦБУровень2.ВалютаНоминала,
		|	_ЦБУровень2.УровеньОценки,
		|	_ЦБУровень2.ВидЦены,
		|	_ЦБУровень2.СправедливаяЦена,
		|	_ЦБУровень2.ВалютаЦены,
		|	_ЦБУровень2.ВалютаЦены,
		|	_ЦБУровень2.ДатаЦены,
		|	_ЦБУровень2.Источник
		|ИЗ
		|	_ЦБУровень2 КАК _ЦБУровень2
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦБУровень3.Рынок,
		|	_ЦБУровень3.ЦеннаяБумага,
		|	_ЦБУровень3.ВалютаНоминала,
		|	_ЦБУровень3.УровеньОценки,
		|	_ЦБУровень3.ВидЦены,
		|	_ЦБУровень3.СправедливаяЦена,
		|	_ЦБУровень3.ВалютаЦены,
		|	_ЦБУровень3.ВалютаЦены,
		|	_ЦБУровень3.ДатаЦены,
		|	_ЦБУровень3.Источник
		|ИЗ
		|	_ЦБУровень3 КАК _ЦБУровень3
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ТаблицаЦБ.Номинал КАК Номинал,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(ОцененныеБумаги.СправедливаяЦена * _ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|			ИНАЧЕ ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(ОцененныеБумаги.Валюта, 0) КАК Валюта,
		|	ЕСТЬNULL(ОцененныеБумаги.ВалютаКотировки, 0) КАК ВалютаКотировки,
		|	ЕСТЬNULL(ОцененныеБумаги.ВидЦены, 0) КАК ВидЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, ЕСТЬNULL(ОцененныеБумаги.Источник, 0)) КАК Источник,
		|	0 КАК Купон,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаКупона,
		|	_ТаблицаЦБ.ОблигацияСПлавающейСтавкойИлиНоминалом КАК ОблигацияСПлавающейСтавкойИлиНоминалом,
		|	_ТаблицаЦБ.ЭмитентРоссийский КАК ЭмитентРоссийский,
		|	_ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости КАК ОценкаПоАмортизированнойСтоимости
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОцененныеБумаги КАК ОцененныеБумаги
		|		ПО (ОцененныеБумаги.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (Биржи.Ссылка = ОцененныеБумаги.Источник)
		|ГДЕ
		|	НЕ _ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ТаблицаЦБ.Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага,
		|	_ТаблицаЦБ.ВалютаНоминала,
		|	_ТаблицаЦБ.Номинал,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	_ТаблицаЦБ.ВалютаНоминала,
		|	0,
		|	0,
		|	_ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|ГДЕ
		|	_ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости";
	
	#КонецОбласти	
	
	ТолькоНаблюдаемыеЦены		= ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены;
	
	ММВБ						= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");	
	НРД							= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");	
	
	ОбщероссийскийКалендарь		= Справочники.Календари.Общероссийский;
	ОсновнойКалендарьКотировок	= Константы.ОсновнойКалендарьКотировок.Получить();	
	КалендарныхДнейНазад35		= НачалоДня(ДатаПереоценки) - 34 * 3600 * 24;
	ПоследняяДатаТоргов			= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки));
	
	// Используем цену НРД, рассчитанную не ранее последнего торгового дня
	
	Если НачалоДня(ДатаПереоценки) = ПоследняяДатаТоргов Тогда
		ДатыЦенНРД = ПоследняяДатаТоргов;
	Иначе
		ДатыЦенНРД = Новый Массив;	
		
		ДатаЦены = НачалоДня(ДатаПереоценки);
		Пока ДатаЦены >= ПоследняяДатаТоргов Цикл
			ДатыЦенНРД.Добавить(ДатаЦены);
			ДатаЦены = ДатаЦены - 86400;
		КонецЦикла;		
	КонецЕсли;
	
	ДоступныеБиржи = Новый Массив;
	ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
		
	ОблигацииСПлавающейСтавкойИлиНоминалом = Справочники.Облигации.ПолучитьОблигацииСПлавающейСтавкойИлиНоминалом(ТаблицаЦБ, ДатаПереоценки, Ложь, Ложь, РасшифровкаРасчета);
		
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены",					ТолькоНаблюдаемыеЦены);
		
	Запрос.УстановитьПараметр("ДоступныеБиржи",							ДоступныеБиржи);
	Запрос.УстановитьПараметр("ММВБ",									ММВБ);
	Запрос.УстановитьПараметр("НРД",									НРД);
	Запрос.УстановитьПараметр("Блумберг",  								ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("Режим_BGN",								ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL",								ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	Запрос.УстановитьПараметр("ВалютаРубли",							ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	Запрос.УстановитьПараметр("ДатаПереоценки",							ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",					ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("ДатыЦенНРД",								ДатыЦенНРД);
	Запрос.УстановитьПараметр("КалендарныхДнейНазад35",					КалендарныхДнейНазад35);
	
	Запрос.УстановитьПараметр("ОблигацииСПлавающейСтавкойИлиНоминалом",	ОблигацииСПлавающейСтавкойИлиНоминалом);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Федерации 2021", "Промежуточная таблица стоимостей ЦБ", , , "_ТаблицаСпискаЦБ, _ЭмитентыЦенныхБумаг");		
	КонецЕсли;
	
	Если ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;
	
	// Расчетные цены 	
	
	ВыполненРасчетЦены = Ложь;
	
	ПараметрыОценки.Вставить("ТочностьКБД", 4); // в базисных пунктах до 2 знаков после запятой (в процентах до 4 знаков)
	
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
	
	ЦеныНРД = Неопределено;
			
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены) ИЛИ СтрокаСтоимостейЦБ.ОценкаПоАмортизированнойСтоимости Тогда
			Продолжить;
		КонецЕсли;
		
		// Расчетные цены
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			Если Не СтрокаСтоимостейЦБ.ОблигацияСПлавающейСтавкойИлиНоминалом
				ИЛИ ДатаПереоценки >= '20210201' // #360160: Федерация, Будущее и Телеком-Союз говорят выполнять расчет по модели для этой бумаги																					 
					И СтрокаСтоимостейЦБ.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Сбербанк_002P") // Сбербанк ПАО, 4-02-01481-B-002P, 10000000.00 RUB
			Тогда		
			
				#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков
				
				ПараметрыДенежногоПотока = ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, СтрокаСтоимостейЦБ.ЦеннаяБумага, Отказ);
				
				ЗаполнитьДисконтированнойПоЗначениямКБДСтоимостью(СтрокаСтоимостейЦБ, ДатаПереоценки, ПараметрыОценки, 2, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, , 2, ПараметрыДенежногоПотока, Отказ, РасшифровкаРасчета);
				
				Если ЗначениеЗаполнено(СтрокаСтоимостейЦБ.Стоимость) И Отказ = Ложь Тогда 
					ВыполненРасчетЦены = Истина;
					Продолжить;
				КонецЕсли;
					
				#КонецОбласти
			
			КонецЕсли;			

			#Область Расчетная_цена_НРД_3_уровня
		
			// Цена, рассчитанная НРД по методике, основанной на факторном разложения
			
			Если ЦеныНРД = Неопределено Тогда
				ЦеныНРД = ПолучитьЦеныНРД(ТаблицаСтоимостейЦБ, ДатыЦенНРД, РасшифровкаРасчета);
			КонецЕсли;

			ЦеныНРДТекущейЦБ = ЦеныНРД.НайтиСтроки(Новый Структура("ЦеннаяБумага, VERSION, METHOD_NUMBER", СтрокаСтоимостейЦБ.ЦеннаяБумага, "2", "3")); 
			
			Если ЦеныНРДТекущейЦБ.Количество() > 0 Тогда

				СтрокаСтоимостейЦБ.Стоимость		= ЦеныНРДТекущейЦБ[0].Цена;
				СтрокаСтоимостейЦБ.ДатаЦены			= ЦеныНРДТекущейЦБ[0].ДатаЦены;
				СтрокаСтоимостейЦБ.УровеньОценки	= 3;
				СтрокаСтоимостейЦБ.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД;
				СтрокаСтоимостейЦБ.Источник			= НРД;
				СтрокаСтоимостейЦБ.ВалютаКотировки	= СтрокаСтоимостейЦБ.ВалютаНоминала;

				ВыполненРасчетЦены = Истина;
				Продолжить;
				
			КонецЕсли;

			#КонецОбласти
			
		ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
			
			Если СтрокаСтоимостейЦБ.ЭмитентРоссийский Тогда
			
				#Область Расчет_на_основе_корректировки_исторической_цены					
				
				// Справедливая стоимость акций российских эмитентов, допущенным к торгам на ММВБ,
				// определяется в соответствии с моделью оценки, основанной на корректировке исторической цены (CAPM).
				// Применяем при отсутствии цены не более 10 рабочих дней
				
				ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, ОбщероссийскийКалендарь, , 2, Отказ, РасшифровкаРасчета);
				
				Если ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
					Продолжить;
				КонецЕсли;
				
				#КонецОбласти					
			
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "Таблица стоимостей ЦБ", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;	

КонецФункции

Функция ПолучитьЦеныБудущего2020(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	// Наблюдаемыми ценами считаем биржевые цены, а также цены НРД, посчитанные методами 1 и 2
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ТаблицаСпискаЦБ");
	ПоместитьЭмитентовЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "_ТаблицаСпискаЦБ");	
	ПоместитьСведенияОТоргахЦеннымиБумагамиВМенеджерВременныхТаблиц(Запрос, "_ТаблицаСпискаЦБ", ДатаПереоценки, 1, "_СведенияОТоргахЦеннымиБумагами");	
	ПоместитьБумагиОцениваемыеПоАмортизированнойСтоимостиВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки, ДатаПереоценки, "_ТаблицаСпискаЦБ");
	
	#Область Основной_запрос	
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	_ТаблицаСпискаЦБ.ВалютаНоминала = &ВалютаРубли КАК НоминированаВРублях,
		|	ЕСТЬNULL(Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ), ЛОЖЬ) КАК ОВОЗРФ,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЭмитентРоссийский,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК ТоргуетсяНаММВБ,
		|	_ТаблицаСпискаЦБ.ЦеннаяБумага В (&ОблигацииСПлавающейСтавкойИлиНоминалом) КАК ОблигацияСПлавающейСтавкойИлиНоминалом,
		|	_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК ОценкаПоАмортизированнойСтоимости,
		|	ЕСТЬNULL(_СведенияОТоргахЦеннымиБумагами.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ПоследняяДатаТоргов
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО (Облигации.Ссылка = _ТаблицаСпискаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЭмитентыЦенныхБумаг КАК _ЭмитентыЦенныхБумаг
		|		ПО (_ЭмитентыЦенныхБумаг.ЦеннаяБумага = _ТаблицаСпискаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ИСТИНА
		|					ИЗ
		|						_ТаблицаСпискаЦБ КАК ИсходнаяТаблицаЦБ
		|					ГДЕ
		|						ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО _ТаблицаСпискаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента
		|					ИЗ
		|						_ЭмитентыЦенныхБумаг)) КАК РеквизитыЮрЛицаЭмитента
		|		ПО (РеквизитыЮрЛицаЭмитента.ЮрФизЛицо = _ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, Статус, Биржа, Рынок) В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже),
		|						&ММВБ,
		|						ИсходнаяТаблицаЦБ.Рынок
		|					ИЗ
		|						_ТаблицаСпискаЦБ КАК ИсходнаяТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО _ТаблицаСпискаЦБ.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _БумагиОцениваемыеПоАмортизированнойСтоимости КАК _БумагиОцениваемыеПоАмортизированнойСтоимости
		|		ПО (_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага = _ТаблицаСпискаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СведенияОТоргахЦеннымиБумагами КАК _СведенияОТоргахЦеннымиБумагами
		|		ПО (_СведенияОТоргахЦеннымиБумагами.ЦеннаяБумага = _ТаблицаСпискаЦБ.ЦеннаяБумага)
		|			И (_СведенияОТоргахЦеннымиБумагами.ТорговыхДнейНазад = 1)
		|;
