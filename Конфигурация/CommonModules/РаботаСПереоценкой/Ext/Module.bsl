		// временное решение: пока не разберемся как надо
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И Не ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВалютаКупона) Тогда
			СтрокаСтоимостейЦБ.ВалютаКупона = СтрокаСтоимостейЦБ.ВалютаНоминала;
			СтрокаСтоимостейЦБ.Купон        = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
		КонецЕсли;
		
		// Если цена определена или оцениваем по новой методике недопущенный к торгам пай,
		// то оценивать по партиям не нужно
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0
			ИЛИ (НЕ (ДатаПереоценки < Дата(2018, 3, 31) ИЛИ ПараметрыОценки.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ"))
					И СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Паи
					И НЕ СтрокаСтоимостейЦБ.ДопущенКТоргам)
		Тогда
			Продолжить;			
		КонецЕсли;
		
		СтрокиДляДозаполненияИзПартий.Добавить(СтрокаСтоимостейЦБ);
		
	КонецЦикла;
					
	// Дозаполнение данными из партий
	
	Если ДатаПереоценки >= Дата(2018, 3, 31) И СтрокиДляДозаполненияИзПартий.Количество() > 0 И ПараметрыОценки.ПараметрыПолученияПартий <> Неопределено Тогда 		
		ЗаполнитьЦенамиПокупкиПриОтсутствииУчетаНаПартиях(ДатаПереоценки, ТаблицаСтоимостейЦБ, СтрокиДляДозаполненияИзПартий, ПараметрыОценки, РасшифровкаРасчета);	
	КонецЕсли;	
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныРЭМ2022(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено) 
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ИсходнаяТаблицаЦБ");
	ПоместитьТаблицуДатРасчетныхЦенПаевВМенеджерВременныхТаблиц(Запрос, "_ИсходнаяТаблицаЦБ", ДатаПереоценки, "_ТаблицаДатРасчетныхЦенПаев");	
	
	#Область Текст_запроса
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИностранныеБиржи.Биржа КАК Биржа,
		|	ИностранныеБиржи.Приоритет КАК Приоритет
		|ПОМЕСТИТЬ _ПриоритетыИностранныхБирж
		|ИЗ
		|	&ИностранныеБиржи КАК ИностранныеБиржи
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	ЕСТЬNULL(ПроизводныеФинансовыеИнструменты.Валюта, _ИсходнаяТаблицаЦБ.ВалютаНоминала) КАК ВалютаНоминала,
		|	_ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ
		|ПОМЕСТИТЬ _ТаблицаЦБОсновнойВыпуск
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПроизводныеФинансовыеИнструменты КАК ПроизводныеФинансовыеИнструменты
		|		ПО (ПроизводныеФинансовыеИнструменты.Ссылка = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Акции.ОсновнойВыпуск,
		|	_ИсходнаяТаблицаЦБ.Рынок,
		|	Акции.ОсновнойВыпуск.ВалютаНоминала,
		|	Акции.ОсновнойВыпуск.УчетныйАктивЦБРФ
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО (Акции.Ссылка = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|			И (Акции.ОсновнойВыпуск <> ЗНАЧЕНИЕ(Справочник.Акции.ПустаяСсылка))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЕСТЬNULL(Эмитенты.ЮрФизЛицо, РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо) КАК ЮрЛицоЭмитента
		|ПОМЕСТИТЬ _ЭмитентыЦенныхБумаг
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|		ПО (Эмитенты.Ссылка = ВЫБОР
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|					ТОГДА ВЫРАЗИТЬ(_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.Акции).Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|					ТОГДА ВЫРАЗИТЬ(_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|					ТОГДА ВЫРАЗИТЬ(_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.Векселя).Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|					ТОГДА ВЫРАЗИТЬ(_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|					ТОГДА ВЫРАЗИТЬ(_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФСрезПоследних
		|		ПО (ВЫБОР
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|					ТОГДА РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд = ВЫРАЗИТЬ(_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд
		|			КОНЕЦ)
		|ГДЕ
		|	ЕСТЬNULL(Эмитенты.ЮрФизЛицо, РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо) ЕСТЬ НЕ NULL 
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ТаблицаЦБОсновнойВыпуск.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБОсновнойВыпуск.Рынок КАК Рынок,
		|	ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследних.Номинал, 0) КАК Номинал,
		|	_ТаблицаЦБОсновнойВыпуск.ВалютаНоминала КАК ВалютаНоминала,
		|	_ТаблицаЦБОсновнойВыпуск.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБОсновнойВыпуск.ЦеннаяБумага) = ТИП(Справочник.ДепозитарныеРасписки)
		|			ТОГДА ДепозитарныеРасписки.Эмитент.ЮрФизЛицо
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБОсновнойВыпуск.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|			ТОГДА ИпотечныеСертификатыУчастия.Эмитент.ЮрФизЛицо
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|	КОНЕЦ КАК ЭмитентДепозитарнойРасписки,
		|	Облигации.Оригинатор КАК КонечныйЗаемщик,
		|	РеквизитыЭмитентовСрезПоследних.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)) КАК ЭмитентРоссийский
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	_ТаблицаЦБОсновнойВыпуск КАК _ТаблицаЦБОсновнойВыпуск
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ТаблицаЦБОсновнойВыпуск.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеРасписки КАК ДепозитарныеРасписки
		|		ПО _ТаблицаЦБОсновнойВыпуск.ЦеннаяБумага = ДепозитарныеРасписки.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия
		|		ПО _ТаблицаЦБОсновнойВыпуск.ЦеннаяБумага = ИпотечныеСертификатыУчастия.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						_ТаблицаЦБОсновнойВыпуск.ЦеннаяБумага
		|					ИЗ
		|						_ТаблицаЦБОсновнойВыпуск)) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО _ТаблицаЦБОсновнойВыпуск.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЭмитентыЦенныхБумаг КАК _ЭмитентыЦенныхБумаг
		|		ПО _ТаблицаЦБОсновнойВыпуск.ЦеннаяБумага = _ЭмитентыЦенныхБумаг.ЦеннаяБумага
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.языки.Русский)) КАК РеквизитыЭмитентовСрезПоследних
		|		ПО (_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента = РеквизитыЭмитентовСрезПоследних.ЮрФизЛицо)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Рынок,
		|	ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ДопущенныеКТоргам
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(Биржа, Статус, Рынок, ЦеннаяБумага) В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						&ММВБ КАК Биржа,
		|						ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже) КАК Статус,
		|						_ТаблицаЦБ.Рынок КАК Рынок,
		|						_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|					ИЗ
		|						_ТаблицаЦБ КАК _ТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО (СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (СтатусыЦенныхБумагСрезПоследних.Активен)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	КотировкиТорговыхПлощадок.Биржа.ЮрФизЛицо КАК ИсточникКотировок,
		|	КотировкиТорговыхПлощадок.РежимТоргов КАК РежимТоргов,
		|	КотировкиТорговыхПлощадок.Валюта КАК ВалютаТоргов,
		|	ВЫБОР
		|		КОГДА _ДопущенныеКТоргам.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|				И КотировкиТорговыхПлощадок.MARKETPRICE3 <> 0
		|			ТОГДА ВЫБОР
		|					КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|						ТОГДА КотировкиТорговыхПлощадок.MARKETPRICE3 * _ТаблицаЦБ.Номинал / 100
		|					ИНАЧЕ КотировкиТорговыхПлощадок.MARKETPRICE3
		|				КОНЕЦ
		|	КОНЕЦ КАК СправедливаяЦена,
		|	ВЫБОР
		|		КОГДА _ДопущенныеКТоргам.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|				И КотировкиТорговыхПлощадок.MARKETPRICE3 <> 0
		|			ТОГДА ВЫБОР
		|					КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|						ТОГДА _ТаблицаЦБ.ВалютаНоминала
		|					ИНАЧЕ КотировкиТорговыхПлощадок.Валюта
		|				КОНЕЦ
		|	КОНЕЦ КАК ВалютаКотировки,
		|	ВЫБОР
		|		КОГДА _ДопущенныеКТоргам.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|				И КотировкиТорговыхПлощадок.MARKETPRICE3 <> 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.РыночнаяЦена3)
		|	КОНЕЦ КАК ПолеЦены,
		|	ВЫБОР
		|		КОГДА _ДопущенныеКТоргам.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|				И КотировкиТорговыхПлощадок.MARKETPRICE3 <> 0
		|			ТОГДА КотировкиТорговыхПлощадок.Период
		|	КОНЕЦ КАК ДатаЦены,
		|	КотировкиТорговыхПлощадок.ACCINT КАК Купон,
		|	КотировкиТорговыхПлощадок.Валюта КАК ВалютаКупона
		|ПОМЕСТИТЬ _ММВБ
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДопущенныеКТоргам КАК _ДопущенныеКТоргам
		|		ПО (_ДопущенныеКТоргам.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.Рынок = _ТаблицаЦБ.Рынок)
		|			И (КотировкиТорговыхПлощадок.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Период = &ДатаКотировок)
		|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ИспользоватьЦенуЗакрытияДляОтдельныхАктивов
		|				ТОГДА _ТаблицаЦБ.ЭмитентРоссийский
		|						И НЕ ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) В (ТИП(Справочник.Паи), ТИП(Справочник.ДепозитарныеРасписки))
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ТаблицаЦБ.ЦеннаяБумага,
		|	_ТаблицаЦБ.Рынок,
		|	КотировкиТорговыхПлощадок.Биржа.ЮрФизЛицо,
		|	КотировкиТорговыхПлощадок.РежимТоргов,
		|	КотировкиТорговыхПлощадок.Валюта,
		|	ВЫБОР
		|		КОГДА _ДопущенныеКТоргам.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|			ТОГДА ВЫБОР
		|					КОГДА КотировкиТорговыхПлощадок.LEGALCLOSEPRICE <> 0
		|						ТОГДА ВЫБОР
		|								КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|									ТОГДА КотировкиТорговыхПлощадок.LEGALCLOSEPRICE * _ТаблицаЦБ.Номинал / 100
		|								ИНАЧЕ КотировкиТорговыхПлощадок.LEGALCLOSEPRICE
		|							КОНЕЦ
		|					КОГДА КотировкиТорговыхПлощадок.MARKETPRICE3 <> 0
