	Запрос.УстановитьПараметр("ИностранныеУчетныеАктивы", 		ИностранныеУчетныеАктивы);
	Запрос.УстановитьПараметр("ДоступныДанныеBloomberg",		ДоступныДанныеБлумберг);
	
	Запрос.УстановитьПараметр("ОцениватьОВОЗРФиИностранныеБумагиПоБлумбергу",			ОцениватьОВОЗРФиИностранныеБумагиПоБлумбергу);
	Запрос.УстановитьПараметр("ПриоритетРоссийскихПлощадокПередИностранными",			ПриоритетРоссийскихПлощадокПередИностранными);
	Запрос.УстановитьПараметр("ПроверкаЦенРежимовТорговВПорядкеВыбораОсновногоРынка",	ПроверкаЦенРежимовТорговВПорядкеВыбораОсновногоРынка);
	Запрос.УстановитьПараметр("ПриоритетРежимовТорговСРасчетамиВВалютеНоминала",		ПриоритетРежимовТорговСРасчетамиВВалютеНоминала);
	Запрос.УстановитьПараметр("ЕдиныйПорядокОпределенияКупона",							ЕдиныйПорядокОпределенияКупона);
		
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ДополнительноИключаемыеТаблицы = "";
		
		#Область Дополнительные_параметры_в_зависимости_от_алгоритма_проверки_цен
		
		Если ПроверкаЦенРежимовТорговВПорядкеВыбораОсновногоРынка Тогда
			ОписаниеПодбораЦен =
				"Проверяются цены режима торгов с наилучшим объемом согласно критериям выбора основного рынка.
				|Если ни одна из цен по данному режиму торгов не может быть использована, проверяются цены
				|следующего режима торгов в порядке уменьшения объема согласно критериям выбора основного рынка.";
		Иначе
			ОписаниеПодбораЦен			   = "Проверяются только цены режима торгов с наилучшим объемом согласно критериям выбора основного рынка.";
			ДополнительноИключаемыеТаблицы = "_ПервыйУровень_ПрошедшиеПроверку";
		КонецЕсли;
		
		Если ПриоритетРежимовТорговСРасчетамиВВалютеНоминала Тогда
			ОписаниеПодбораЦен = ОписаниеПодбораЦен + Символы.ПС + "Режимы торгов с расчетами в валюте номинала в приоритете перед остальными.";
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ОписаниеПодбораЦен", ОписаниеПодбораЦен);	       
		
		#КонецОбласти
		
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены СЧА ОПИФ/ЗПИФ 2021", "Таблица стоимостей ЦБ", , , "_РеквизитыОблигаций, _ПриоритетОсновныхРынков_Служебный, _ОсновнойРынокПриоритетРежимаТоргов_Служебный" + ?(ПустаяСтрока(ДополнительноИключаемыеТаблицы), "", ", " + ДополнительноИключаемыеТаблицы));		
	КонецЕсли;
	
	Если ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;
	
	// Расчетные цены	
	
	ВыполненРасчетЦены	= Ложь;
	ВалютаРубли			= ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");
	
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	
	КоэффициентыСущественныхСобытий = Новый Структура;
	КоэффициентыСущественныхСобытий.Вставить("ИзмененаКлючеваяСтавкаЦБРФ_ЕвропейскогоЦБ_ФРССША", 1);
	КоэффициентыСущественныхСобытий.Вставить("ВведеныСанкцииПротивЭмитента",					 1);
	КоэффициентыСущественныхСобытий.Вставить("ЗначительныеТехногенныеКатастрофы",				 1);
	КоэффициентыСущественныхСобытий.Вставить("ИзмененКредитныйРейтингЭмитента",					 1);
	КоэффициентыСущественныхСобытий.Вставить("ДефолтПоБумагамЭмитента",							 1);
	
	ПараметрыОценкиПоМоделиСущественныхСобытий = Новый Структура;
	ПараметрыОценкиПоМоделиСущественныхСобытий.Вставить("ПараметрыПоискаЦены",				Новый Структура("Календарь, УровеньОценки", ОсновнойКалендарьКотировок, 1));
	ПараметрыОценкиПоМоделиСущественныхСобытий.Вставить("КоэффициентыСущественныхСобытий",	КоэффициентыСущественныхСобытий);	
	
	Если Не ПараметрыОценки.Свойство("ВариантРасчетаОценочнойСтоимости") Тогда
		ПараметрыОценки.Вставить("ВариантРасчетаОценочнойСтоимости", ПараметрыОценки.ВариантРасчетаСправедливойСтоимости);
	КонецЕсли;
	
	ЦеныНРДНаДатуОценки = Неопределено;
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		Если ЕдиныйПорядокОпределенияКупона И СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И Не ЗначениеЗаполнено(СтрокаСтоимостейЦБ.Купон) Тогда
			Если ДатаПереоценки >= '20230901' Тогда
				ТочностьКупона					= РаботаСЦеннымиБумагами.ТочностьРасчетногоКупона(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, СтрокаСтоимостейЦБ.ВалютаНоминала, ПараметрыОценки.СчетДоверительногоУправления);
				СтрокаСтоимостейЦБ.Купон		= РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления, , ТочностьКупона);
				СтрокаСтоимостейЦБ.ВалютаКупона	= СтрокаСтоимостейЦБ.ВалютаНоминала;
			Иначе
				СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления, , СтрокаСтоимостейЦБ.ВалютаКупона);
			КонецЕсли;
		КонецЕсли;
		
		// Уведомление о цене BVAL
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены) Тогда
			
			Если СтрокаСтоимостейЦБ.РежимТоргов = Режим_BVAL Тогда
				УведомитьОбОценкеПоЦенеBloombergBVAL(СтрокаСтоимостейЦБ.ЦеннаяБумага, ПараметрыОценки, ДатаПереоценки);
			КонецЕсли;		
			
			Продолжить;			
			
		КонецЕсли;
		
		// Расчет цены
		
		ОшибкаРасчета = Ложь;
		
		Если СтрокаСтоимостейЦБ.ВидАктива = "ИностранныеЦБ" ИЛИ СтрокаСтоимостейЦБ.ВидАктива = "ОВОЗРФиДР" Тогда
		
			Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции
				ИЛИ СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Паи
				ИЛИ СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.ДепозитарныеРасписки
				ИЛИ СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации
			Тогда

			    Если ДатаПереоценки < '20260101' И НачалоДня(ДатаПереоценки) <> СтрокаСтоимостейЦБ.ПоследнийТорговыйДень Тогда
			
					#Область Расчет_основанный_на_изменениях_существенных_событий
					
					ЦенаПредыдущегоРабочегоДня = ПолучитьПоследнююНаблюдаемуюЦенуСУчетомСущественныхСобытий(СтрокаСтоимостейЦБ.ЦеннаяБумага, ПараметрыОценки, ДатаПереоценки, ПараметрыОценкиПоМоделиСущественныхСобытий.ПараметрыПоискаЦены, ПараметрыОценкиПоМоделиСущественныхСобытий.КоэффициентыСущественныхСобытий, ОшибкаРасчета, РасшифровкаРасчета);
					
					Если ОшибкаРасчета Тогда
						
						ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
						Продолжить;
						
					ИначеЕсли ЦенаПредыдущегоРабочегоДня <> Неопределено Тогда
						
						СтрокаСтоимостейЦБ.Стоимость		= ЦенаПредыдущегоРабочегоДня.Стоимость;
						СтрокаСтоимостейЦБ.ВидЦены			= ЦенаПредыдущегоРабочегоДня.ВидЦены; 
						СтрокаСтоимостейЦБ.Источник			= ЦенаПредыдущегоРабочегоДня.Источник;
						СтрокаСтоимостейЦБ.УровеньОценки	= 2;
						СтрокаСтоимостейЦБ.ДатаЦены			= ЦенаПредыдущегоРабочегоДня.ДатаЦены;
						СтрокаСтоимостейЦБ.ВалютаКотировки	= ЦенаПредыдущегоРабочегоДня.ВалютаКотировки;					
						
						Если РасшифровкаРасчета <> Неопределено Тогда
							РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Цена предыдущего рабочего дня", ЦенаПредыдущегоРабочегоДня);
						КонецЕсли;

						Если ДатаПереоценки >= '20230701' И СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
							
							// Нужно уведомить об оценке по цене меньшего приоритета, т.к. перед ней должны быть:
							// - средняя индикативная цена, определенная по методике "Cbonds Estimation Onshore"
							// - индексная цена, определенная по методике RUDIP RUS (по исходным данным, относящимся к 1 или 2 уровню)
							
							ОписаниеПриоритетныхЦен = "средняя индикативная цена Cbonds Estimation Onshore; индексная цена RUDIP RUS (1 или 2 уровня)";
							
							ДобавитьЦеннуюБумагуВДополнительныеСвойстваОценки(ПараметрыОценки, СтрокаСтоимостейЦБ.ЦеннаяБумага, "ОценкиПоЦенеСМеньшимПриоритетом", ОписаниеПриоритетныхЦен);
							
						КонецЕсли;
						
						ВыполненРасчетЦены = Истина;
						Продолжить;
						
					КонецЕсли;						
					
					#КонецОбласти
					
				КонецЕсли;						
				
			КонецЕсли;						
			
		КонецЕсли;
				
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции
			ИЛИ СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Паи
		Тогда
	
			#Область Расчет_на_основе_корректировки_исторической_цены					
			
			// Модель оценки, основанная на корректировке исторической цены (CAPM).
			// Применяем при отсутствии цены не более 30 рабочих дней
			
			ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 30, Справочники.Календари.Общероссийский, , , ОшибкаРасчета, РасшифровкаРасчета);  
			
			Если ОшибкаРасчета Тогда
				ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
				Продолжить;
			ИначеЕсли ЦенаЗаполнена Тогда
				ВыполненРасчетЦены = Истина;
				Продолжить;
			КонецЕсли;
			
			#КонецОбласти					
			
		ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда					
			
			Если ДатаПереоценки >= '20230317' Тогда
			
				#Область Расчетная_цена_НРД_3_уровня
			
				Если ЦеныНРДНаДатуОценки = Неопределено Тогда
					ЦеныНРДНаДатуОценки = ПолучитьЦеныНРД(ТаблицаСтоимостейЦБ, НачалоДня(ДатаПереоценки), РасшифровкаРасчета);
				КонецЕсли;
				
				ЦеныНРДТекущейЦБ = ЦеныНРДНаДатуОценки.Скопировать(Новый Структура("ЦеннаяБумага, VERSION, METHOD_NUMBER", СтрокаСтоимостейЦБ.ЦеннаяБумага, "2", "3")); 
				
				Если ЦеныНРДТекущейЦБ.Количество() > 0 Тогда

					СтрокаСтоимостейЦБ.Стоимость		= ЦеныНРДТекущейЦБ[0].Цена;
					СтрокаСтоимостейЦБ.ДатаЦены			= ЦеныНРДТекущейЦБ[0].ДатаЦены;
					СтрокаСтоимостейЦБ.УровеньОценки	= 3;
					СтрокаСтоимостейЦБ.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД;
					СтрокаСтоимостейЦБ.Источник			= НРД;
					СтрокаСтоимостейЦБ.ВалютаКотировки	= СтрокаСтоимостейЦБ.ВалютаНоминала;

					ВыполненРасчетЦены = Истина;
					Продолжить;
					
				КонецЕсли;

				#КонецОбласти
				
			КонецЕсли;
			
			УровеньОценкиДляДисконтированнойСтоимости = ?(ДатаПереоценки >= '20260101', 2, 3);
			Если СтрокаСтоимостейЦБ.ВалютаНоминала = ВалютаРубли Тогда
				
				#Область Расчет_по_модели_дисконтирования_по_ставкам_КБД_стоимости_будущих_денежных_потоков
				
				ЦенаЗаполнена = ЗаполнитьДисконтированнойПоЗначениямКБДСтоимостью(СтрокаСтоимостейЦБ, ДатаПереоценки, ПараметрыОценки, УровеньОценкиДляДисконтированнойСтоимости, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, , 2, ПараметрыДенежногоПотока, ОшибкаРасчета, РасшифровкаРасчета);

				Если ОшибкаРасчета Тогда
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
					Продолжить;
				ИначеЕсли ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
					Продолжить;
				КонецЕсли;
				
				#КонецОбласти
				
			ИначеЕсли ДатаПереоценки >= '20230317' Тогда
				
				Если ЗначениеЗаполнено(СтрокаСтоимостейЦБ.РоссийскийЗаемщик) Тогда
			
					#Область Расчет_по_модели_дисконтирования_по_ставкам_КБД_стоимости_будущих_денежных_потоков_пересчитанной_по_форвардному_валютному_курсу
					
					ЦенаЗаполнена = ЗаполнитьДисконтированнойПоЗначениямКБДСтоимостьюПоФорвардномуВалютномуКурсу(СтрокаСтоимостейЦБ, ДатаПереоценки, ПараметрыОценки, УровеньОценкиДляДисконтированнойСтоимости, 2, ПараметрыДенежногоПотока, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, ОшибкаРасчета, РасшифровкаРасчета);
						
					Если ОшибкаРасчета Тогда	
						ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
						Продолжить;
					ИначеЕсли ЦенаЗаполнена Тогда
						ВыполненРасчетЦены = Истина;
						Продолжить;
					КонецЕсли;
					
					#КонецОбласти
					
				КонецЕсли;

			Иначе
				
				#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков_с_использованием_аналогов_или_ставки_LIBOR						
				
				// Для еврооблигаций, номинированных в долларах США:
				
				// 1.1 Если для оцениваемой долговой ценной бумаги основным рынком является биржевой рынок,
				// то медианный кредитный спред (CrSpread) рассчитывается на основании выбранных управляющей
				// компанией ДУ Фонда аналогичных долговых ценных бумаг, для которых на дату расчета СЧА (или
				// в предыдущий торговый день, если дата определения СЧА является не торговым днем) рынок признается активным.
				
				// 1.2 Если для оцениваемой долговой ценной бумаги основным рынком является внебиржевой рынок,
				// то медианный кредитный спред (CrSpread) рассчитывается на основании выбранных управляющей
				// компанией ДУ Фонда аналогичных долговых ценных бумаг, для которых на дату расчета СЧА (или
				// в предыдущий торговый день, если дата определения СЧА является не торговым днем)
				// есть цены BGN, BVAL (Score равен или выше 6) или НКО АО НРД.
				
				// 2. В случае невозможности определить цену по предыдущему методу, и облигации номинированы в долларах США,
				// справедливая стоимость облигации определяется путем дисконтирования стоимости будущих купонных платежей,
				// а также номинала по ставкам кривой безрисковых доходностей, скорректированных на кредитный спред.

				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Расчет справедливой стоимости долговой ценной бумаги ""%1"", номинированной в иностранной валюте, не реализован.", СтрокаСтоимостейЦБ.ЦеннаяБумага));
				
				ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
					
				#КонецОбласти
				
			КонецЕсли;

		КонецЕсли;
		
	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "С учетом параметров расчета цены", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;

КонецФункции

Функция ПолучитьЦеныЗПИФУКПИ(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Если ДатаПереоценки >= Дата(2021,7,1) Тогда
		
		#Область Методика_от_01_07_2021		
		
		#Область Основной_запрос	
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала,
			|	ТаблицаСпискаЦБ.Рынок КАК Рынок
			|ПОМЕСТИТЬ _ТаблицаСпискаЦБ
			|ИЗ
			|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	ЦеннаяБумага,
			|	Рынок
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СтатусыЦенныхБумагСрезПоследних.Рынок КАК Рынок,
			|	СтатусыЦенныхБумагСрезПоследних.Период КАК Период,
			|	СтатусыЦенныхБумагСрезПоследних.Статус КАК Статус,
			|	СтатусыЦенныхБумагСрезПоследних.Биржа КАК Биржа
			|ПОМЕСТИТЬ _СтатусыЦенныхБумаг
			|ИЗ
			|	_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(&ДатаОценки, ) КАК СтатусыЦенныхБумагСрезПоследних
			|		ПО _ТаблицаСпискаЦБ.Рынок = СтатусыЦенныхБумагСрезПоследних.Рынок
			|			И _ТаблицаСпискаЦБ.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага
			|			И (СтатусыЦенныхБумагСрезПоследних.Активен)
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	ЦеннаяБумага,
			|	Рынок
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДефолтыПоОблигациямСрезПоследних.Облигация КАК Облигация
			|ПОМЕСТИТЬ _ДефолтПоОблигациям
			|ИЗ
			|	РегистрСведений.ДефолтыПоОблигациям.СрезПоследних(
			|			&ДатаОценки,
			|			Облигация В
			|				(ВЫБРАТЬ
			|					ВЫРАЗИТЬ(_ТаблицаСпискаЦБ.ЦеннаяБумага КАК Справочник.Облигации) КАК Облигация
			|				ИЗ
			|					_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
			|				ГДЕ
			|					_ТаблицаСпискаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Облигации)) КАК ДефолтыПоОблигациямСрезПоследних
			|ГДЕ
