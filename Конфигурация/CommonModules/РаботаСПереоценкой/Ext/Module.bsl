		|					И КотировкиАктивногоРынкаММВБ.OFFER > 0
		|				ТОГДА ИСТИНА
		|			КОГДА КотировкиАктивногоРынкаММВБ.BID МЕЖДУ КотировкиАктивногоРынкаММВБ.WAPRICE И КотировкиАктивногоРынкаММВБ.OFFER
		|					И КотировкиАктивногоРынкаММВБ.WAPRICE > 0
		|					И КотировкиАктивногоРынкаММВБ.OFFER > 0
		|				ТОГДА ИСТИНА
		|			КОГДА КотировкиАктивногоРынкаММВБ.OFFER МЕЖДУ КотировкиАктивногоРынкаММВБ.BID И КотировкиАктивногоРынкаММВБ.WAPRICE
		|					И КотировкиАктивногоРынкаММВБ.BID > 0
		|					И КотировкиАктивногоРынкаММВБ.WAPRICE > 0
		|				ТОГДА ИСТИНА
		|			КОГДА КотировкиАктивногоРынкаММВБ.LEGALCLOSEPRICE > 0
		|					И КотировкиАктивногоРынкаММВБ.VALUE > 0
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	2 КАК УровеньОценки,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД) КАК ВидЦены,
		|	ВЫБОР
		|		КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА РасчетныеЦеныНРД.RATE
		|		ИНАЧЕ РасчетныеЦеныНРД.PRICE
		|	КОНЕЦ КАК СправедливаяЦена,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаЦены,
		|	РасчетныеЦеныНРД.Период КАК ДатаЦены,
		|	&НРД КАК Источник
		|ПОМЕСТИТЬ ЦБУровень2
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
		|		ПО (РасчетныеЦеныНРД.Рынок = ТаблицаЦБ.Рынок)
		|			И (РасчетныеЦеныНРД.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (РасчетныеЦеныНРД.Период = &ПоследняяДатаТоргов)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЦБУровень1 КАК ЦБУровень1
		|		ПО (ЦБУровень1.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|ГДЕ
		|	ЦБУровень1.ЦеннаяБумага ЕСТЬ NULL
		|	И НЕ &ТолькоНаблюдаемыеЦены
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	3 КАК УровеньОценки,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СЧА) КАК ВидЦены,
		|	РасчетныеЦеныПаев.РасчетнаяЦена КАК СправедливаяЦена,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаЦены,
		|	РасчетныеЦеныПаев.Период КАК ДатаЦены,
		|	РеквизитыПИФ.УправляющаяКомпания.ЮрФизЛицо КАК Источник
		|ПОМЕСТИТЬ ЦБУровень3
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
		|		ПО (Паи.Ссылка = ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЦБУровень1 КАК ЦБУровень1
		|		ПО (ЦБУровень1.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЦБУровень2 КАК ЦБУровень2
		|		ПО (ЦБУровень2.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						ТаблицаЦБ.ЦеннаяБумага
		|					ИЗ
		|						ТаблицаЦБ
		|					ГДЕ
		|						ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))) КАК РасчетныеЦеныПаев
		|		ПО (РасчетныеЦеныПаев.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (РасчетныеЦеныПаев.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, МЕСЯЦ, -6))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФ
		|		ПО (Паи.ПаевойИнвестиционныйФонд = РеквизитыПИФ.ПаевойИнвестиционныйФонд)
		|ГДЕ
		|	ЦБУровень1.ЦеннаяБумага ЕСТЬ NULL
		|	И ЦБУровень2.ЦеннаяБумага ЕСТЬ NULL
		|	И НЕ &ТолькоНаблюдаемыеЦены
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦБУровень1.Рынок КАК Рынок,
		|	ЦБУровень1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЦБУровень1.ВалютаНоминала КАК ВалютаНоминала,
		|	ЦБУровень1.УровеньОценки КАК УровеньОценки,
		|	ЦБУровень1.ВидЦены КАК ВидЦены,
		|	ЦБУровень1.СправедливаяЦена КАК СправедливаяЦена,
		|	ЦБУровень1.ВалютаЦены КАК ВалютаКотировки,
		|	ЦБУровень1.ВалютаЦены КАК Валюта,
		|	ЦБУровень1.ДатаЦены КАК ДатаЦены,
		|	ЦБУровень1.Источник КАК Источник
		|ПОМЕСТИТЬ ОцененныеБумаги
		|ИЗ
		|	ЦБУровень1 КАК ЦБУровень1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЦБУровень2.Рынок,
		|	ЦБУровень2.ЦеннаяБумага,
		|	ЦБУровень2.ВалютаНоминала,
		|	ЦБУровень2.УровеньОценки,
		|	ЦБУровень2.ВидЦены,
		|	ЦБУровень2.СправедливаяЦена,
		|	ЦБУровень2.ВалютаЦены,
		|	ЦБУровень2.ВалютаЦены,
		|	ЦБУровень2.ДатаЦены,
		|	ЦБУровень2.Источник
		|ИЗ
		|	ЦБУровень2 КАК ЦБУровень2
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЦБУровень3.Рынок,
		|	ЦБУровень3.ЦеннаяБумага,
		|	ЦБУровень3.ВалютаНоминала,
		|	ЦБУровень3.УровеньОценки,
		|	ЦБУровень3.ВидЦены,
		|	ЦБУровень3.СправедливаяЦена,
		|	ЦБУровень3.ВалютаЦены,
		|	ЦБУровень3.ВалютаЦены,
		|	ЦБУровень3.ДатаЦены,
		|	ЦБУровень3.Источник
		|ИЗ
		|	ЦБУровень3 КАК ЦБУровень3
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(ОцененныеБумаги.СправедливаяЦена * ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|			ИНАЧЕ ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(ОцененныеБумаги.Валюта, 0) КАК Валюта,
		|	ЕСТЬNULL(ОцененныеБумаги.ВалютаКотировки, 0) КАК ВалютаКотировки,
		|	ЕСТЬNULL(ОцененныеБумаги.ВидЦены, 0) КАК ВидЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, ЕСТЬNULL(ОцененныеБумаги.Источник, 0)) КАК Источник,
		|	0 КАК Купон,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаКупона
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОцененныеБумаги КАК ОцененныеБумаги
		|		ПО (ОцененныеБумаги.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (Биржи.Ссылка = ОцененныеБумаги.Источник)");
	
	#КонецОбласти	
	
	ТолькоНаблюдаемыеЦены		= ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены;
	
	ММВБ						= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");	
	НРД							= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");	
	
	ОсновнойКалендарьКотировок	= Константы.ОсновнойКалендарьКотировок.Получить();	
	ТорговыхДнейНазад10			= Справочники.Календари.ДобавитьКДатеРабочиеДни(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки), -10);
	ПоследняяДатаТоргов			= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки));
	
	Запрос.УстановитьПараметр("ММВБ",					ММВБ);	
	Запрос.УстановитьПараметр("НРД",					НРД);
	
	Запрос.УстановитьПараметр("ДатаПереоценки",			ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",	ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10",	ТорговыхДнейНазад10);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ",		ТаблицаЦБ);
	
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены",	ТолькоНаблюдаемыеЦены);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Федерации", "Промежуточная таблица стоимостей ЦБ");		
	КонецЕсли;
	
	Если ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;
	
	// Расчетные цены 	
	
	ВыполненРасчетЦены = Ложь;	
	
	ПараметрыДенежногоПотока		 = ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	ПараметрыРасчетаРейтинга		 = ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда = ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены) Тогда
			Продолжить;
		КонецЕсли;
		
		// Расчетные цены
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков
			
			ДенежныйПоток				= Справочники.Облигации.ПолучитьДенежныйПоток(СтрокаСтоимостейЦБ.ЦеннаяБумага, ПараметрыДенежногоПотока, ПараметрыОценки, Отказ, РасшифровкаРасчета);
			БезрисковаяСтавкаДоходности	= РаботаСПоказателямиФинансовыхИнструментов.РассчитатьБезрисковуюСтавкуДоходности(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ДенежныйПоток, Отказ);
			
			Если Отказ Тогда
				Продолжить;
			КонецЕсли;
			
			КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, Отказ, РасшифровкаРасчета);
			Если КредитныйСпред.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			МедианаКредитногоСпреда	= КредитныйСпред[0].Медиана;
			СтавкаДисконтирования	= Окр(БезрисковаяСтавкаДоходности + МедианаКредитногоСпреда / 100, 2);
			
			ПриведеннаяСтоимость	= Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтавкаДисконтирования, ДатаПереоценки), 4);
			Цена					= Окр(ПриведеннаяСтоимость - СтрокаСтоимостейЦБ.Купон, 2);
			
			Если Цена > 0 Тогда

				СтрокаСтоимостейЦБ.Стоимость		= Цена;
				СтрокаСтоимостейЦБ.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена; 
				СтрокаСтоимостейЦБ.Источник			= Справочники.ЮрФизЛица.ПустаяСсылка();
				СтрокаСтоимостейЦБ.УровеньОценки	= 2;
				СтрокаСтоимостейЦБ.ДатаЦены			= ДатаПереоценки;
				СтрокаСтоимостейЦБ.ВалютаКотировки	= СтрокаСтоимостейЦБ.ВалютаНоминала;					
				
				Если РасшифровкаРасчета <> Неопределено Тогда
					ПараметрыРасчетаЦен = Новый Структура("БезрисковаяСтавкаДоходности, МедианаКредитногоСпреда, СтавкаДисконтирования, ПриведеннаяСтоимость, Купон, Цена", БезрисковаяСтавкаДоходности, МедианаКредитногоСпреда, СтавкаДисконтирования, ПриведеннаяСтоимость, СтрокаСтоимостейЦБ.Купон, Цена);
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Цена, рассчитанная по модели дисконтирования стоимости будущих денежных потоков", ПараметрыРасчетаЦен);
				КонецЕсли;

				ВыполненРасчетЦены = Истина;
				
			КонецЕсли;
			
			#КонецОбласти
			
		ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
			
			#Область Расчет_на_основе_корректировки_исторической_цены					
			
			// Справедливая стоимость акций российских эмитентов, допущенным к торгам на ММВБ,
			// определяется в соответствии с моделью оценки, основанной на корректировке исторической цены (CAPM).
			// Применяем при отсутствии цены не более 10 рабочих дней
			
			ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, , , 5, Отказ, РасшифровкаРасчета);  
			
			Если ЦенаЗаполнена Тогда
				ВыполненРасчетЦены = Истина;
			КонецЕсли;
			
			#КонецОбласти					
			
		КонецЕсли;

	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "Таблица стоимостей ЦБ", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;	

КонецФункции

Функция ПолучитьЦеныФедерации2020(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Если Не ПараметрыОценки.Свойство("ОцениватьПоСправедливойСтоимости") И ДатаПереоценки < '20201117' Тогда
		ПараметрыОценки.Вставить("ОцениватьПоСправедливойСтоимости", Истина); // До этой даты по амортизированной стоимости бумаги не оценивали	
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "ИсходнаяТаблицаЦБ");
	ПоместитьБумагиОцениваемыеПоАмортизированнойСтоимостиВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки, ДатаПереоценки, "ИсходнаяТаблицаЦБ");

	#Область Основной_запрос	
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ), ЛОЖЬ) КАК ОВОЗРФ,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, НЕОПРЕДЕЛЕНО) КАК ДатаПогашения,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК ТоргуетсяНаММВБ,
		|	_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК ОценкаПоАмортизированнойСтоимости
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ИСТИНА
		|					ИЗ
		|						ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|					ГДЕ
		|						ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, Статус, Биржа, Рынок) В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже),
		|						&ММВБ,
		|						ИсходнаяТаблицаЦБ.Рынок
		|					ИЗ
		|						ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _БумагиОцениваемыеПоАмортизированнойСтоимости КАК _БумагиОцениваемыеПоАмортизированнойСтоимости
		|		ПО (_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага = ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.Период КАК Период,
		|	КотировкиТорговыхПлощадок.Валюта КАК Валюта,
		|	КотировкиТорговыхПлощадок.РежимТоргов КАК РежимТоргов,
		|	КотировкиТорговыхПлощадок.NUMTRADES КАК КоличествоСделок,
		|	КотировкиТорговыхПлощадок.VALUE КАК ОбъемСделок,
		|	КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ КотировкиММВБЗаПоследние10ТорговыхДней
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.Рынок = ТаблицаЦБ.Рынок)
		|			И (КотировкиТорговыхПлощадок.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим
		|				ИЛИ КотировкиТорговыхПлощадок.РежимТоргов.РЕПО
		|					И НЕ &ТолькоОсновнойРынок
		|				ИЛИ КотировкиТорговыхПлощадок.РежимТоргов.РежимПереговорныхСделок
		|					И НЕ &ТолькоОсновнойРынок)
		|			И (КотировкиТорговыхПлощадок.Период МЕЖДУ &ТорговыхДнейНазад10 И &ДатаПереоценки)
		|			И (НЕ ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта)
		|			И (КотировкиТорговыхПлощадок.Период = КурсыВалют.Период)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиММВБЗаПоследние10ТорговыхДней.Период КАК Период,
		|	СУММА(КотировкиММВБЗаПоследние10ТорговыхДней.КоличествоСделок) КАК КоличествоСделок,
		|	СУММА(КотировкиММВБЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета) КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ ИтогиММВБЗаПоследние10ТорговыхДней
		|ИЗ
		|	КотировкиММВБЗаПоследние10ТорговыхДней КАК КотировкиММВБЗаПоследние10ТорговыхДней
		|
		|СГРУППИРОВАТЬ ПО
		|	КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага,
		|	КотировкиММВБЗаПоследние10ТорговыхДней.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	&ММВБ КАК Биржа,
		|	СделкиЗаПоследние10ТорговыхДней.КоличествоСделок КАК КоличествоСделок,
		|	СделкиЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ АктивныйРынокММВБ
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ИтогиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага КАК ЦеннаяБумага,
		|			СУММА(ИтогиММВБЗаПоследние10ТорговыхДней.КоличествоСделок) КАК КоличествоСделок,
		|			СУММА(ИтогиММВБЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета) КАК ОбъемСделокВВалютеУчета
		|		ИЗ
		|			ИтогиММВБЗаПоследние10ТорговыхДней КАК ИтогиММВБЗаПоследние10ТорговыхДней
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ИтогиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага) КАК СделкиЗаПоследние10ТорговыхДней
		|		ПО (СделкиЗаПоследние10ТорговыхДней.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (СделкиЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета > 500000)
		|			И (СделкиЗаПоследние10ТорговыхДней.КоличествоСделок >= 10)
		|ГДЕ
		|	ТаблицаЦБ.ТоргуетсяНаММВБ
		|	И НЕ ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости
		|	И НЕ ТаблицаЦБ.ОВОЗРФ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АктивныйРынокММВБ.Рынок КАК Рынок,
		|	АктивныйРынокММВБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	АктивныйРынокММВБ.Биржа КАК Биржа,
		|	КотировкиЦенныхБумаг.Период КАК Период,
		|	КотировкиЦенныхБумаг.РежимТоргов КАК РежимТоргов,
		|	КотировкиЦенныхБумаг.Валюта КАК Валюта,
		|	КотировкиЦенныхБумаг.BID КАК BID,
		|	КотировкиЦенныхБумаг.OFFER КАК OFFER,
		|	КотировкиЦенныхБумаг.WAPRICE КАК WAPRICE,
		|	КотировкиЦенныхБумаг.VALUE КАК VALUE,
		|	КотировкиЦенныхБумаг.VOLUME КАК VOLUME,
		|	КотировкиЦенныхБумаг.LEGALCLOSEPRICE КАК LEGALCLOSEPRICE,
		|	КотировкиЦенныхБумаг.VOLUME КАК ОбъемСделокВКоличествеБумаг,
		|	КотировкиЦенныхБумаг.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ КотировкиАктивногоРынкаММВБ
		|ИЗ
		|	АктивныйРынокММВБ КАК АктивныйРынокММВБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиЦенныхБумаг
		|		ПО (КотировкиЦенныхБумаг.ЦеннаяБумага = АктивныйРынокММВБ.ЦеннаяБумага)
		|			И (КотировкиЦенныхБумаг.Рынок = АктивныйРынокММВБ.Рынок)
		|			И (КотировкиЦенныхБумаг.Биржа = АктивныйРынокММВБ.Биржа)
		|			И (КотировкиЦенныхБумаг.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиЦенныхБумаг.Период = &ПоследняяДатаТоргов)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КурсыВалют.Период = &ДатаПереоценки)
		|			И (КурсыВалют.Валюта = КотировкиЦенныхБумаг.Валюта)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиАктивногоРынкаММВБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиАктивногоРынкаММВБ.РежимТоргов КАК РежимТоргов,
		|	КотировкиАктивногоРынкаММВБ.ОбъемСделокВКоличествеБумаг КАК ОбъемСделокВКоличествеБумаг,
		|	КотировкиАктивногоРынкаММВБ.ОбъемСделокВВалютеУчета КАК ОбъемСделокВВалютеУчета,
		|	КОЛИЧЕСТВО(КотировкиАктивногоРынкаММВБ1.РежимТоргов) КАК Приоритет
		|ПОМЕСТИТЬ АктивныйРынокММВБПриоритетРежимаТорговПоОбъему
		|ИЗ
		|	КотировкиАктивногоРынкаММВБ КАК КотировкиАктивногоРынкаММВБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КотировкиАктивногоРынкаММВБ КАК КотировкиАктивногоРынкаММВБ1
		|		ПО КотировкиАктивногоРынкаММВБ.ЦеннаяБумага = КотировкиАктивногоРынкаММВБ1.ЦеннаяБумага
		|			И КотировкиАктивногоРынкаММВБ.ОбъемСделокВКоличествеБумаг <= КотировкиАктивногоРынкаММВБ1.ОбъемСделокВКоличествеБумаг
		|			И КотировкиАктивногоРынкаММВБ.ОбъемСделокВВалютеУчета <= КотировкиАктивногоРынкаММВБ1.ОбъемСделокВВалютеУчета
		|
		|СГРУППИРОВАТЬ ПО
		|	КотировкиАктивногоРынкаММВБ.ЦеннаяБумага,
		|	КотировкиАктивногоРынкаММВБ.РежимТоргов,
		|	КотировкиАктивногоРынкаММВБ.ОбъемСделокВКоличествеБумаг,
		|	КотировкиАктивногоРынкаММВБ.ОбъемСделокВВалютеУчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	КотировкиАктивногоРынкаММВБ.Биржа КАК Источник,
		|	КотировкиАктивногоРынкаММВБ.РежимТоргов КАК РежимТоргов,
		|	ВЫБОР
		|		КОГДА КотировкиАктивногоРынкаММВБ.WAPRICE МЕЖДУ КотировкиАктивногоРынкаММВБ.BID И КотировкиАктивногоРынкаММВБ.OFFER
		|				И КотировкиАктивногоРынкаММВБ.BID > 0
		|				И КотировкиАктивногоРынкаММВБ.OFFER > 0
		|			ТОГДА КотировкиАктивногоРынкаММВБ.WAPRICE
		|		КОГДА КотировкиАктивногоРынкаММВБ.BID МЕЖДУ КотировкиАктивногоРынкаММВБ.WAPRICE И КотировкиАктивногоРынкаММВБ.OFFER
		|				И КотировкиАктивногоРынкаММВБ.WAPRICE > 0
		|				И КотировкиАктивногоРынкаММВБ.OFFER > 0
		|			ТОГДА КотировкиАктивногоРынкаММВБ.BID
		|		КОГДА КотировкиАктивногоРынкаММВБ.LEGALCLOSEPRICE > 0
		|				И КотировкиАктивногоРынкаММВБ.VALUE > 0
		|			ТОГДА КотировкиАктивногоРынкаММВБ.LEGALCLOSEPRICE
		|	КОНЕЦ КАК СправедливаяЦена,
		|	КотировкиАктивногоРынкаММВБ.Период КАК ДатаЦены,
		|	1 КАК УровеньОценки,
		|	ВЫБОР
		|		КОГДА КотировкиАктивногоРынкаММВБ.WAPRICE МЕЖДУ КотировкиАктивногоРынкаММВБ.BID И КотировкиАктивногоРынкаММВБ.OFFER
		|				И КотировкиАктивногоРынкаММВБ.BID > 0
		|				И КотировкиАктивногоРынкаММВБ.OFFER > 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СредневзвешеннаяЦена)
		|		КОГДА КотировкиАктивногоРынкаММВБ.BID МЕЖДУ КотировкиАктивногоРынкаММВБ.WAPRICE И КотировкиАктивногоРынкаММВБ.OFFER
		|				И КотировкиАктивногоРынкаММВБ.WAPRICE > 0
		|				И КотировкиАктивногоРынкаММВБ.OFFER > 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ЦенаСпроса)
		|		КОГДА КотировкиАктивногоРынкаММВБ.LEGALCLOSEPRICE > 0
		|				И КотировкиАктивногоРынкаММВБ.VALUE > 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ЦенаЗакрытия)
		|	КОНЕЦ КАК ВидЦены,
		|	ВЫБОР
		|		КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ТаблицаЦБ.ВалютаНоминала
		|		ИНАЧЕ КотировкиАктивногоРынкаММВБ.Валюта
		|	КОНЕЦ КАК ВалютаЦены
		|ПОМЕСТИТЬ ЦБУровень1
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КотировкиАктивногоРынкаММВБ КАК КотировкиАктивногоРынкаММВБ
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ АктивныйРынокММВБПриоритетРежимаТорговПоОбъему КАК ПриоритетРежимаТорговПоОбъему
		|			ПО (ПриоритетРежимаТорговПоОбъему.ЦеннаяБумага = КотировкиАктивногоРынкаММВБ.ЦеннаяБумага)
		|				И (ПриоритетРежимаТорговПоОбъему.РежимТоргов = КотировкиАктивногоРынкаММВБ.РежимТоргов)
		|				И (ПриоритетРежимаТорговПоОбъему.Приоритет = 1)
		|		ПО (КотировкиАктивногоРынкаММВБ.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|ГДЕ
		|	ВЫБОР
		|			КОГДА КотировкиАктивногоРынкаММВБ.WAPRICE МЕЖДУ КотировкиАктивногоРынкаММВБ.BID И КотировкиАктивногоРынкаММВБ.OFFER
		|					И КотировкиАктивногоРынкаММВБ.BID > 0
		|					И КотировкиАктивногоРынкаММВБ.OFFER > 0
		|				ТОГДА ИСТИНА
		|			КОГДА КотировкиАктивногоРынкаММВБ.BID МЕЖДУ КотировкиАктивногоРынкаММВБ.WAPRICE И КотировкиАктивногоРынкаММВБ.OFFER
		|					И КотировкиАктивногоРынкаММВБ.WAPRICE > 0
		|					И КотировкиАктивногоРынкаММВБ.OFFER > 0
		|				ТОГДА ИСТИНА
		|			КОГДА КотировкиАктивногоРынкаММВБ.LEGALCLOSEPRICE > 0
		|					И КотировкиАктивногоРынкаММВБ.VALUE > 0
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|	И НЕ ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	2 КАК УровеньОценки,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД) КАК ВидЦены,
		|	ВЫБОР
		|		КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА РасчетныеЦеныНРД.RATE
		|		ИНАЧЕ РасчетныеЦеныНРД.PRICE
		|	КОНЕЦ КАК СправедливаяЦена,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаЦены,
		|	РасчетныеЦеныНРД.Период КАК ДатаЦены,
		|	&НРД КАК Источник
		|ПОМЕСТИТЬ ЦБУровень2
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
		|		ПО (РасчетныеЦеныНРД.Рынок = ТаблицаЦБ.Рынок)
		|			И (РасчетныеЦеныНРД.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (РасчетныеЦеныНРД.Период = &ДатаЦенНРД)
		|			И (ВЫБОР
		|				КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|					ТОГДА РасчетныеЦеныНРД.VERSION = ""2""
		|							И РасчетныеЦеныНРД.METHOD_NUMBER В (""1"", ""2"")
		|				КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|					ТОГДА РасчетныеЦеныНРД.VERSION <> """"
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЦБУровень1 КАК ЦБУровень1
		|		ПО (ЦБУровень1.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|ГДЕ
		|	ЦБУровень1.ЦеннаяБумага ЕСТЬ NULL
		|	И НЕ &ТолькоНаблюдаемыеЦены
		|	И НЕ ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	3 КАК УровеньОценки,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СЧА) КАК ВидЦены,
		|	РасчетныеЦеныПаев.РасчетнаяЦена КАК СправедливаяЦена,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаЦены,
		|	РасчетныеЦеныПаев.Период КАК ДатаЦены,
		|	РеквизитыПИФ.УправляющаяКомпания.ЮрФизЛицо КАК Источник
		|ПОМЕСТИТЬ ЦБУровень3
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
		|		ПО (Паи.Ссылка = ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЦБУровень1 КАК ЦБУровень1
		|		ПО (ЦБУровень1.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЦБУровень2 КАК ЦБУровень2
		|		ПО (ЦБУровень2.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						ТаблицаЦБ.ЦеннаяБумага
		|					ИЗ
		|						ТаблицаЦБ
		|					ГДЕ
		|						ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))) КАК РасчетныеЦеныПаев
		|		ПО (РасчетныеЦеныПаев.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (РасчетныеЦеныПаев.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, МЕСЯЦ, -6))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФ
		|		ПО (Паи.ПаевойИнвестиционныйФонд = РеквизитыПИФ.ПаевойИнвестиционныйФонд)
		|ГДЕ
		|	ЦБУровень1.ЦеннаяБумага ЕСТЬ NULL
		|	И ЦБУровень2.ЦеннаяБумага ЕСТЬ NULL
		|	И НЕ &ТолькоНаблюдаемыеЦены
		|	И НЕ ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦБУровень1.Рынок КАК Рынок,
		|	ЦБУровень1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЦБУровень1.ВалютаНоминала КАК ВалютаНоминала,
		|	ЦБУровень1.УровеньОценки КАК УровеньОценки,
		|	ЦБУровень1.ВидЦены КАК ВидЦены,
		|	ЦБУровень1.СправедливаяЦена КАК СправедливаяЦена,
		|	ЦБУровень1.ВалютаЦены КАК ВалютаКотировки,
		|	ЦБУровень1.ВалютаЦены КАК Валюта,
		|	ЦБУровень1.ДатаЦены КАК ДатаЦены,
		|	ЦБУровень1.Источник КАК Источник
		|ПОМЕСТИТЬ ОцененныеБумаги
		|ИЗ
		|	ЦБУровень1 КАК ЦБУровень1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЦБУровень2.Рынок,
		|	ЦБУровень2.ЦеннаяБумага,
		|	ЦБУровень2.ВалютаНоминала,
		|	ЦБУровень2.УровеньОценки,
		|	ЦБУровень2.ВидЦены,
		|	ЦБУровень2.СправедливаяЦена,
		|	ЦБУровень2.ВалютаЦены,
		|	ЦБУровень2.ВалютаЦены,
		|	ЦБУровень2.ДатаЦены,
		|	ЦБУровень2.Источник
		|ИЗ
		|	ЦБУровень2 КАК ЦБУровень2
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЦБУровень3.Рынок,
		|	ЦБУровень3.ЦеннаяБумага,
		|	ЦБУровень3.ВалютаНоминала,
		|	ЦБУровень3.УровеньОценки,
		|	ЦБУровень3.ВидЦены,
		|	ЦБУровень3.СправедливаяЦена,
		|	ЦБУровень3.ВалютаЦены,
		|	ЦБУровень3.ВалютаЦены,
		|	ЦБУровень3.ДатаЦены,
		|	ЦБУровень3.Источник
		|ИЗ
		|	ЦБУровень3 КАК ЦБУровень3
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(ОцененныеБумаги.СправедливаяЦена * ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|			ИНАЧЕ ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(ОцененныеБумаги.Валюта, 0) КАК Валюта,
		|	ЕСТЬNULL(ОцененныеБумаги.ВалютаКотировки, 0) КАК ВалютаКотировки,
		|	ЕСТЬNULL(ОцененныеБумаги.ВидЦены, 0) КАК ВидЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, ЕСТЬNULL(ОцененныеБумаги.Источник, 0)) КАК Источник,
		|	0 КАК Купон,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаКупона,
		|	ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости КАК ОценкаПоАмортизированнойСтоимости
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОцененныеБумаги КАК ОцененныеБумаги
		|		ПО (ОцененныеБумаги.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (Биржи.Ссылка = ОцененныеБумаги.Источник)
		|ГДЕ
		|	НЕ ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТаблицаЦБ.Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.ВалютаНоминала,
		|	ТаблицаЦБ.Номинал,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	ТаблицаЦБ.ВалютаНоминала,
		|	ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|ГДЕ
		|	ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости";
	
	#КонецОбласти	
	
	ТолькоНаблюдаемыеЦены		= ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены;
	
	ММВБ						= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");	
	НРД							= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");	
	
	ОсновнойКалендарьКотировок	= Константы.ОсновнойКалендарьКотировок.Получить();	
	ТорговыхДнейНазад10			= Справочники.Календари.ДобавитьКДатеРабочиеДни(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки), -10);
	ПоследняяДатаТоргов			= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки));
	ПоследнийРабочийДень		= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоДня(ДатаПереоценки));
	
	// Если это неторговый нерабочий день, то берем цены НРД на последний рабочий день, в остальных случаях на дату оценки
	
	Если НачалоДня(ДатаПереоценки) <> ПоследнийРабочийДень И НачалоДня(ДатаПереоценки) <> ПоследняяДатаТоргов Тогда
		ДатаЦенНРД = ПоследнийРабочийДень;
	Иначе
		ДатаЦенНРД = НачалоДня(ДатаПереоценки);	
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("ММВБ",					ММВБ);	
	Запрос.УстановитьПараметр("НРД",					НРД);
	
	Запрос.УстановитьПараметр("ДатаПереоценки",			ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",	ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10",	ТорговыхДнейНазад10);
	Запрос.УстановитьПараметр("ДатаЦенНРД",				ДатаЦенНРД);
	
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены",	ТолькоНаблюдаемыеЦены);
	Запрос.УстановитьПараметр("ТолькоОсновнойРынок",	ДатаПереоценки >= Дата(2020, 01, 13));
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Федерации", "Промежуточная таблица стоимостей ЦБ");		
	КонецЕсли;
	
	Если ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;
	
	// Расчетные цены 	
	
	ВыполненРасчетЦены = Ложь;	
			
	ПараметрыОценки.Вставить("ТочностьКБД", 2); // в процентах до 2 знаков после запятой
	ПараметрыОценки.Вставить("ТочностьDCF", 5);
	
	ПараметрыРасчетаРейтинга		 = ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда = ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);			

	ЦеныНРДНаДатуОценки = Неопределено;
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены) ИЛИ СтрокаСтоимостейЦБ.ОценкаПоАмортизированнойСтоимости Тогда
			Продолжить;
		КонецЕсли;
		
		// Расчетные цены
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				
			ОшибкаРасчета = Ложь;
			
			РассчитатьЦенуПоМоделиПриведеннойСтоимости = 
				НЕ (СокрЛП(ПараметрыОценки.СчетДоверительногоУправления) = "НПФ ФЕДЕРАЦИЯ АО ПН"
					И (СокрЛП(СтрокаСтоимостейЦБ.ЦеннаяБумага) = "КАМАЗ ПАО, 4-09-55010-D, 1000.00 RUB"
						ИЛИ СокрЛП(СтрокаСтоимостейЦБ.ЦеннаяБумага) = "КАМАЗ ПАО, 4-10-55010-D, 1000.00 RUB"
						ИЛИ СокрЛП(СтрокаСтоимостейЦБ.ЦеннаяБумага) = "КАМАЗ ПАО, 4-11-55010-D, 1000.00 RUB"));
			
			Если РассчитатьЦенуПоМоделиПриведеннойСтоимости Тогда
			
				#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков
				
				ПараметрыДенежногоПотока = ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, СтрокаСтоимостейЦБ.ЦеннаяБумага, Отказ);
			
				ЗаполнитьДисконтированнойПоЗначениямКБДСтоимостью(СтрокаСтоимостейЦБ, ДатаПереоценки, ПараметрыОценки, 2, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, , 5, ПараметрыДенежногоПотока, ОшибкаРасчета, РасшифровкаРасчета); 

				Если ОшибкаРасчета Тогда
					Отказ = Истина;
					Продолжить;
				ИначеЕсли ЗначениеЗаполнено(СтрокаСтоимостейЦБ.Стоимость) Тогда 
					ВыполненРасчетЦены = Истина;
				КонецЕсли;
				
				#КонецОбласти
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаСтоимостейЦБ.Стоимость) Тогда
				
				#Область Цена_НРД_рассчитанная_по_методике_основанной_на_факторном_разложении
				
				Если ЦеныНРДНаДатуОценки = Неопределено Тогда
					ЦеныНРДНаДатуОценки = ПолучитьЦеныНРД(ТаблицаСтоимостейЦБ, ДатаЦенНРД, РасшифровкаРасчета);
				КонецЕсли;
				
				ЦеныНРДТекущейЦБ = ЦеныНРДНаДатуОценки.Скопировать(Новый Структура("ЦеннаяБумага, VERSION, METHOD_NUMBER", СтрокаСтоимостейЦБ.ЦеннаяБумага, "2", "3")); 
				Если ЦеныНРДТекущейЦБ.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаСтоимостейЦБ.Стоимость		= ЦеныНРДТекущейЦБ[0].Цена;
				СтрокаСтоимостейЦБ.ДатаЦены			= ЦеныНРДТекущейЦБ[0].ДатаЦены;
				СтрокаСтоимостейЦБ.УровеньОценки	= 3;
				СтрокаСтоимостейЦБ.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД;
				СтрокаСтоимостейЦБ.Источник			= НРД;
				СтрокаСтоимостейЦБ.ВалютаКотировки	= СтрокаСтоимостейЦБ.ВалютаНоминала;

				ВыполненРасчетЦены = Истина;

				#КонецОбласти
				
			КонецЕсли;
			
		ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
			
			#Область Расчет_на_основе_корректировки_исторической_цены					
			
			// Справедливая стоимость акций российских эмитентов, допущенным к торгам на ММВБ,
			// определяется в соответствии с моделью оценки, основанной на корректировке исторической цены (CAPM).
			// Применяем при отсутствии цены не более 10 рабочих дней
			
			ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, , , 5, Отказ, РасшифровкаРасчета);  
			
			Если ЦенаЗаполнена Тогда
				ВыполненРасчетЦены = Истина;
			КонецЕсли;			
			
			#КонецОбласти					
			
		КонецЕсли;

	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "Таблица стоимостей ЦБ", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;	

КонецФункции

Функция ПолучитьЦеныФедерации2021(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ИсходнаяТаблицаЦБ");
	ПоместитьБумагиОцениваемыеПоАмортизированнойСтоимостиВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки, ДатаПереоценки, "_ИсходнаяТаблицаЦБ");
	
	#Область Основной_запрос	
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	Эмитенты.Ссылка КАК Эмитент,
		|	Эмитенты.ЮрФизЛицо КАК ЮрЛицоЭмитента
		|ПОМЕСТИТЬ _ЭмитентыЦенныхБумаг
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Векселя КАК Векселя
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Векселя.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеРасписки КАК ДепозитарныеРасписки
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = ДепозитарныеРасписки.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = ИпотечныеСертификатыУчастия.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|		ПО (Эмитенты.Ссылка = ВЫБОР
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|					ТОГДА Акции.Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|					ТОГДА Облигации.Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|					ТОГДА Векселя.Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|					ТОГДА ДепозитарныеРасписки.Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|					ТОГДА ИпотечныеСертификатыУчастия.Эмитент
		|			КОНЕЦ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала = &ВалютаРубли КАК НоминированаВРублях,
		|	ЕСТЬNULL(Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ), ЛОЖЬ) КАК ОВОЗРФ,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЭмитентРоссийский,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК ТоргуетсяНаММВБ,
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага В (&ОблигацииСПлавающейСтавкойИлиНоминалом) КАК ОблигацияСПлавающейСтавкойИлиНоминалом,
		|	_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК ОценкаПоАмортизированнойСтоимости
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО (Облигации.Ссылка = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЭмитентыЦенныхБумаг КАК _ЭмитентыЦенныхБумаг
		|		ПО (_ЭмитентыЦенныхБумаг.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ИСТИНА
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|					ГДЕ
		|						ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента
		|					ИЗ
		|						_ЭмитентыЦенныхБумаг)) КАК РеквизитыЮрЛицаЭмитента
		|		ПО (РеквизитыЮрЛицаЭмитента.ЮрФизЛицо = _ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, Статус, Биржа, Рынок) В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже),
		|						&ММВБ,
		|						ИсходнаяТаблицаЦБ.Рынок
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _БумагиОцениваемыеПоАмортизированнойСтоимости КАК _БумагиОцениваемыеПоАмортизированнойСтоимости
		|		ПО (_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	КотировкиТорговыхПлощадок.Период КАК Период,
		|	КотировкиТорговыхПлощадок.Валюта КАК Валюта,
		|	КотировкиТорговыхПлощадок.Биржа КАК Биржа,
		|	КотировкиТорговыхПлощадок.РежимТоргов КАК РежимТоргов,
		|	КотировкиТорговыхПлощадок.NUMTRADES КАК ОбъемСделокВКоличествеСделок,
		|	КотировкиТорговыхПлощадок.VOLUME КАК ОбъемСделокВКоличествеБумаг,
		|	КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность КАК ОбъемСделокВВалютеУчета,
		|	КотировкиТорговыхПлощадок.Период = &ПоследняяДатаТоргов
		|		И КотировкиТорговыхПлощадок.NUMTRADES > 0 КАК НаличиеСделкиВПоследнийТорговыйДень
		|ПОМЕСТИТЬ _КотировкиЗаПоследние35КалендарныхДней
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.Рынок = _ТаблицаЦБ.Рынок)
		|			И (КотировкиТорговыхПлощадок.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Биржа В (&ДоступныеБиржи))
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадок.Период МЕЖДУ &КалендарныхДнейНазад35 И &ДатаПереоценки)
		|			И (НЕ _ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта)
		|			И (КурсыВалют.Период = &ДатаПереоценки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИтогиТорговЗаПоследние35КалендарныхДней.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИтогиТорговЗаПоследние35КалендарныхДней.Рынок КАК Рынок,
		|	ИтогиТорговЗаПоследние35КалендарныхДней.ВалютаНоминала КАК ВалютаНоминала,
		|	&ММВБ КАК Биржа,
		|	ИтогиТорговЗаПоследние35КалендарныхДней.ОбъемСделокВКоличествеСделок КАК ОбъемСделокВКоличествеСделок,
		|	ИтогиТорговЗаПоследние35КалендарныхДней.ОбъемСделокВКоличествеБумаг КАК ОбъемСделокВКоличествеБумаг,
		|	ИтогиТорговЗаПоследние35КалендарныхДней.ОбъемСделокВВалютеУчета КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ _АктивныеРынки
		|ИЗ
		|	(ВЫБРАТЬ
		|		КотировкиЗаПоследние35КалендарныхДней.ЦеннаяБумага КАК ЦеннаяБумага,
		|		КотировкиЗаПоследние35КалендарныхДней.Рынок КАК Рынок,
		|		КотировкиЗаПоследние35КалендарныхДней.ВалютаНоминала КАК ВалютаНоминала,
		|		СУММА(КотировкиЗаПоследние35КалендарныхДней.ОбъемСделокВКоличествеСделок) КАК ОбъемСделокВКоличествеСделок,
		|		СУММА(КотировкиЗаПоследние35КалендарныхДней.ОбъемСделокВКоличествеБумаг) КАК ОбъемСделокВКоличествеБумаг,
		|		СУММА(КотировкиЗаПоследние35КалендарныхДней.ОбъемСделокВВалютеУчета) КАК ОбъемСделокВВалютеУчета,
		|		МАКСИМУМ(КотировкиЗаПоследние35КалендарныхДней.НаличиеСделкиВПоследнийТорговыйДень) КАК НаличиеСделкиВПоследнийТорговыйДень
		|	ИЗ
		|		_КотировкиЗаПоследние35КалендарныхДней КАК КотировкиЗаПоследние35КалендарныхДней
		|	
		|	СГРУППИРОВАТЬ ПО
		|		КотировкиЗаПоследние35КалендарныхДней.ЦеннаяБумага,
		|		КотировкиЗаПоследние35КалендарныхДней.Рынок,
		|		КотировкиЗаПоследние35КалендарныхДней.ВалютаНоминала) КАК ИтогиТорговЗаПоследние35КалендарныхДней
		|ГДЕ
		|	ИтогиТорговЗаПоследние35КалендарныхДней.ОбъемСделокВВалютеУчета > 500000
		|	И ИтогиТорговЗаПоследние35КалендарныхДней.ОбъемСделокВКоличествеСделок >= 10
		|	И ИтогиТорговЗаПоследние35КалендарныхДней.НаличиеСделкиВПоследнийТорговыйДень
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_АктивныйРынокММВБ.Рынок КАК Рынок,
		|	_АктивныйРынокММВБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_АктивныйРынокММВБ.Биржа КАК Биржа,
		|	КотировкиЦенныхБумаг.Период КАК Период,
		|	КотировкиЦенныхБумаг.РежимТоргов КАК РежимТоргов,
		|	КотировкиЦенныхБумаг.Валюта КАК Валюта,
		|	ВЫБОР
		|		КОГДА _АктивныйРынокММВБ.ВалютаНоминала = КотировкиЦенныхБумаг.Валюта
		|			ТОГДА 1
		|		ИНАЧЕ 2
