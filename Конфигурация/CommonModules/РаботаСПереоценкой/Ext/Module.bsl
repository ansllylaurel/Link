		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(_ОцененныеБумаги.СправедливаяЦена * _ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|			ИНАЧЕ _ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(_ОцененныеБумаги.ВалютаКотировки, 0) КАК ВалютаКотировки,
		|	ЕСТЬNULL(_ОцененныеБумаги.ВидЦены, 0) КАК ВидЦены,
		|	ЕСТЬNULL(_ОцененныеБумаги.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(_ОцененныеБумаги.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, ЕСТЬNULL(_ОцененныеБумаги.Источник, 0)) КАК Источник,
		|	0 КАК Купон,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаКупона
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОцененныеБумаги КАК _ОцененныеБумаги
		|		ПО (_ОцененныеБумаги.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (Биржи.Ссылка = _ОцененныеБумаги.Источник)";

	#КонецОбласти
	
	ИностранныеУчетныеАктивы = Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();	
	
	ММВБ		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	Блумберг	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
	Режим_BGN	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN");
	
	КалендарьКотировок			= Константы.ОсновнойКалендарьКотировок.Получить();
	ОбщероссийскийКалендарь		= Справочники.Календари.Общероссийский;
	
	ПоследняяДатаТоргов			= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьКотировок, НачалоДня(ДатаПереоценки));	
	КалендарныхДнейНазад30		= НачалоДня(ДатаПереоценки) - 30 * 86400;
	РабочихДнейНазад30			= Справочники.Календари.ДобавитьКДатеРабочиеДни(ОбщероссийскийКалендарь, НачалоДня(ДатаПереоценки), -30);
	
	Запрос.УстановитьПараметр("ДатаПереоценки",				ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",		ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("КалендарныхДнейНазад30",		КалендарныхДнейНазад30);
	Запрос.УстановитьПараметр("РабочихДнейНазад30",			РабочихДнейНазад30);
	
	Запрос.УстановитьПараметр("ИностранныеУчетныеАктивы",	ИностранныеУчетныеАктивы);
	Запрос.УстановитьПараметр("ММВБ",						ММВБ);
	Запрос.УстановитьПараметр("Блумберг",					Блумберг);
	Запрос.УстановитьПараметр("Режим_BGN",					Режим_BGN);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Югории (редакция от 01.07.2021)", "Таблица стоимостей ЦБ", , , "_ИсходнаяТаблицаЦБ, _БумагиОцениваемыеПоАмортизированнойСтоимости, _СтатусыЦенныхБумаг, _ЭмитентыЦенныхБумаг, _ПроверкаОтсутствияНесколькихКотировок");		
	КонецЕсли;
	
	#Область Проверка_отсутствия_нескольких_котировок
	
	ПроверкаОтсутствияНесколькихКотировок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ПроверкаОтсутствияНесколькихКотировок"].ПолучитьДанные().Выбрать();
	Пока ПроверкаОтсутствияНесколькихКотировок.Следующий() Цикл
		ТекстОшибки = СтрШаблон("Для бумаги '%1' на %2 на основном рынке имеется несколько котировок, но приоритет котировок не задан.",
			ПроверкаОтсутствияНесколькихКотировок.ЦеннаяБумага,
			Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , , , Отказ);
	КонецЦикла;
	
	#КонецОбласти
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления, , СтрокаСтоимостейЦБ.ВалютаКупона);
		КонецЕсли;	
	КонецЦикла;
	
	Возврат ТаблицаСтоимостейЦБ;	
	
КонецФункции

Функция ПолучитьЦеныЮгории2022(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)

	// Основной рынок:
	// - еврооблигации, бумаги МФО, ц/б ин. государств - внебиржа (bloomberg);
	// - допущенные к торгам на ММВБ - ММВБ;
	// - прочие - внебиржа (bloomberg).

	// Активный рынок:
	// - биржа: есть котировка WAPRICE на дату расчета;
	// - внебиржа: были котировки BGN BID в течение последних 30 календарных дней, включая дату расчета.

	// Оценка бумаг 1 уровня:
	// 1.1 биржа:
	//     1.1 WAPRICE на дату расчета;
	//     1.2 ближайшая котировка WAPRICE за последние 30 календарных дней, не включая дату расчета;
	//     1.3 цена BGN BID на дату расчета.
	// 1.2 внебиржа: цена BGN BID на дату расчета.

	// Оценка бумаг 2 уровня:
	// 2.1 Облигации кроме флоатеров и имеющих сложную структуру выпуска, включающие рублевые облигации, либо допущенные к торгам в РФ облигации (кроме российских еврооблигаций):
	//     2.1.1 НРД 1 или 2 метода;
	//     2.1.2 цена приобретения в течение 10 раб. дней с даты приобретения при приобретении на размещении и отсутствии цены НРД в течение 10 раб. дней с даты приобретения;
	//     2.1.3 цена по модели PV.
	// 2.2 Облигации-флоатеры или имеющие сложную структуру выпуска, включающие рублевые облигации, либо допущенные к торгам в РФ облигации (кроме российских еврооблигаций):
	//     2.2.1 НРД 1 или 2 метода.
	// 2.3 Российские акции, либо рублевые акции, либо допущенные к торгам в РФ акции:
	//     2.3.1 НРД;
	//     2.1.3 цена по модели CAPM в случае отсутствия наблюдаемой цены не более 10 рабочих дней.
	// 2.4 Паи российских открытых ПИФ:
	//     2.4.1 расчетная цена пая.
	// 2.5 Иностранные облигации и российские еврооблигации:
	//     2.5.1 цена BGN BID на дату расчета;
	//     2.5.2 цена BVAL CLOSE на дату расчета;
	//     2.5.3 НРД 1 или 2 метода;
	//     2.5.4 Цена по модели PV.
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ИсходнаяТаблицаЦБ");
	ПоместитьСтатусыЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "_ИсходнаяТаблицаЦБ"); 
	ПоместитьЭмитентовЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "_ИсходнаяТаблицаЦБ");
	ПоместитьСведенияОТоргахЦеннымиБумагамиВМенеджерВременныхТаблиц(Запрос, "_ИсходнаяТаблицаЦБ", ДатаПереоценки, 1, "_СведенияОТоргахЦеннымиБумагами");		
	ПоместитьТаблицуДатРасчетныхЦенПаевВМенеджерВременныхТаблиц(Запрос, "_ИсходнаяТаблицаЦБ", ДатаПереоценки, "_ТаблицаДатРасчетныхЦенПаев");
	
	#Область Основной_запрос
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	_ТоргуетсяНаММВБ.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК ТоргуетсяНаММВБ,
		|	_ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ В (&ИностранныеУчетныеАктивы) КАК ИностраннаяЦБ,
		|	ЕСТЬNULL(Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация), ЛОЖЬ) КАК Еврооблигация,
		|	_ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ В (ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ВекселяИностранногоГосударства)) КАК ЦБИностранногоГосударства,
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага В (&ОблигацииСПлавающейСтавкойИлиНоминалом) КАК ОблигацияСПлавающейСтавкойИлиНоминалом,
		|	_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента КАК Эмитент,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация), ЛОЖЬ) КАК ЭмитентМеждународнаяФинОрганизация,
		|	ВЫБОР
		|		КОГДА _ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ В (&ИностранныеУчетныеАктивы)
		|				И (Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|					ИЛИ _ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ В (ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ВекселяИностранногоГосударства))
		|					ИЛИ РеквизитыЮрЛицаЭмитента.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация))
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|		КОГДА _ТоргуетсяНаММВБ.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|			ТОГДА &ММВБ
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	КОНЕЦ КАК ОсновнойРынок,
		|	ЛОЖЬ КАК ОценкаПоАмортизированнойСтоимости,
		|	_СведенияОТоргахЦеннымиБумагами.Дата КАК ПоследняяДатаТоргов
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						_ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ИСТИНА
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|					ГДЕ
		|						_ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СтатусыЦенныхБумаг КАК _ТоргуетсяНаММВБ
		|		ПО (_ТоргуетсяНаММВБ.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|			И (_ТоргуетсяНаММВБ.Биржа = &ММВБ)
		|			И (_ТоргуетсяНаММВБ.Статус = ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЭмитентыЦенныхБумаг КАК _ЭмитентыЦенныхБумаг
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = _ЭмитентыЦенныхБумаг.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента
		|					ИЗ
		|						_ЭмитентыЦенныхБумаг)) КАК РеквизитыЮрЛицаЭмитента
		|		ПО (_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента = РеквизитыЮрЛицаЭмитента.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СведенияОТоргахЦеннымиБумагами КАК _СведенияОТоргахЦеннымиБумагами
		|		ПО (_СведенияОТоргахЦеннымиБумагами.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|			И (_СведенияОТоргахЦеннымиБумагами.ТорговыхДнейНазад = 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа КАК Биржа,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.РежимТоргов КАК РежимТоргов,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта КАК Валюта,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE КАК WAPRICE,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE_DATE КАК WAPRICE_DATE,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.BID КАК BID,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE КАК BID_DATE,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.OFFER КАК OFFER,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.OFFER_DATE КАК OFFER_DATE
		|ПОМЕСТИТЬ _СводныеКотировкиТорговыхПлощадокСРежимами
		|ИЗ
		|	РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|			&ДатаПереоценки,
		|			РежимТоргов.ОсновнойРежим
		|				И (ЦеннаяБумага, Рынок, Биржа) В
		|					(ВЫБРАТЬ
		|						_ТаблицаЦБ.ЦеннаяБумага,
		|						_ТаблицаЦБ.Рынок,
		|						_ТаблицаЦБ.ОсновнойРынок
		|					ИЗ
		|						_ТаблицаЦБ КАК _ТаблицаЦБ
		|					ГДЕ
		|						_ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости = ЛОЖЬ)) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СводныеКотировки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_СводныеКотировки.Биржа КАК Биржа,
		|	_СводныеКотировки.Валюта КАК Валюта,
		|	Котировка_WAPRICE.WAPRICE КАК WAPRICE,
		|	Котировка_WAPRICE.WAPRICE_DATE КАК WAPRICE_DATE,
		|	МАКСИМУМ(Котировка_WAPRICE.РежимТоргов) КАК WAPRICE_РежимТоргов,
		|	Котировка_BID.BID КАК BID,
