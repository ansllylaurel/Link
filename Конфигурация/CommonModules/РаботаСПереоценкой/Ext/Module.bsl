						БалансоваяСтоимость	= Окр((1030015319.13 - 306501223.6) / 1045544 * СтрокаЦенныеБумаги.Количество, 2);
					КонецЕсли;
					БалансоваяЦена = БалансоваяСтоимость / СтрокаЦенныеБумаги.Количество;
				КонецЕсли;			
				
				// #Техдолг #Хардкод #324120 Начальную стоимость Вейла, прошедшего реклассификацию, считаем по данным на 30.06.2020
				Если ДатаПереоценки >= '20200630' //#698380
					И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВейлФинанс")			// ВЕЙЛ ФИНАНС ООО, 4-01-36435-R, 1000.00 RUB
					И ПараметрыОценки.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN084")	// НПФ БУДУЩЕЕ АО ПН 030518-2 #698380
					И НачалоДня(ДатаВводаПартии) = '20190321'
				Тогда
					// Тело + Переоценка, взятые на 30.06.2020
					Если СокрЛП(БалансовыеДанныеНаУтро.НомерСделки) = "ВР0728" Тогда
						БалансоваяСтоимость	= Окр((1680791000.00 - 492723881.65) / 1680791 * СтрокаЦенныеБумаги.Количество, 2);
					ИначеЕсли СокрЛП(БалансовыеДанныеНаУтро.НомерСделки) = "ВР0729" Тогда
						БалансоваяСтоимость	= Окр((277000000.00 - 81202550.00) / 277000 * СтрокаЦенныеБумаги.Количество, 2);
					ИначеЕсли СокрЛП(БалансовыеДанныеНаУтро.НомерСделки) = "07400-000007" Тогда
						БалансоваяСтоимость	= Окр((545244000.00 - 159838278.6) / 545244 * СтрокаЦенныеБумаги.Количество, 2);
					ИначеЕсли СокрЛП(БалансовыеДанныеНаУтро.НомерСделки) = "07400-000008" Тогда
						БалансоваяСтоимость	= Окр((3991000.00 - 1169961.65) / 3991 * СтрокаЦенныеБумаги.Количество, 2);
					ИначеЕсли СокрЛП(БалансовыеДанныеНаУтро.НомерСделки) = "07400-000009" Тогда
						БалансоваяСтоимость	= Окр((39740000.00 - 11649781.00) / 39740 * СтрокаЦенныеБумаги.Количество, 2);
					ИначеЕсли СокрЛП(БалансовыеДанныеНаУтро.НомерСделки) = "07400-000010" Тогда
						БалансоваяСтоимость	= Окр((40805000.00 - 11961985.75) / 40805 * СтрокаЦенныеБумаги.Количество, 2);
					ИначеЕсли СокрЛП(БалансовыеДанныеНаУтро.НомерСделки) = "07400-000528" Тогда
						БалансоваяСтоимость	= Окр((599773371.92 - 193737265.15) / 660881 * СтрокаЦенныеБумаги.Количество, 2);
					ИначеЕсли СокрЛП(БалансовыеДанныеНаУтро.НомерСделки) = "074OU-000055" Тогда
						БалансоваяСтоимость	= Окр((258811687.43 - 77053598.05) / 262847 * СтрокаЦенныеБумаги.Количество, 2);
					ИначеЕсли СокрЛП(БалансовыеДанныеНаУтро.НомерСделки) = "074OU-000058" Тогда
						БалансоваяСтоимость	= Окр((494058492.67 - 147016777.05) / 501507 * СтрокаЦенныеБумаги.Количество, 2);
					ИначеЕсли СокрЛП(БалансовыеДанныеНаУтро.НомерСделки) = "07400-001526" Тогда
						БалансоваяСтоимость	= Окр((1030015319.13 - 306501223.6) / 1045544 * СтрокаЦенныеБумаги.Количество, 2);
					КонецЕсли;
					БалансоваяЦена = БалансоваяСтоимость / СтрокаЦенныеБумаги.Количество;
				КонецЕсли;			
				
					
				// #Техдолг #Хардкод #348229 Начальную стоимость Финконсалт, прошедшего реклассификацию, считаем по данным на 01.12.2020
				Если ДатаПереоценки >= '20201201'
					И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финконсалт")			// ООО Финконсалт, 4B02-02-00342-R-001P, 1000.00 RUB
					И ПараметрыОценки.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN110")	// Эволюция  НПФ АО  ПН 250219-9(Образование 250219-9)
				Тогда	
					БалансоваяСтоимость	= (364844000.00 - 36120.31 - 1240000.00 + 36432120.31); // СС - Дисконт - Купон, взятые на 01.12.2020
					БалансоваяЦена		= БалансоваяСтоимость / 400000;
				КонецЕсли;				

				// #596212 - точность цены от биржи не удовлетворяет расчету суммы
				Если ДатаПереоценки >= '20250331'
					И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин26246")			
					И ПараметрыОценки.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN084")	
					И СтрокаЦенныеБумаги.ДатаПартии = '20250320093000'
					И ТипЗнч(СтрокаЦенныеБумаги.Партия) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке")
				Тогда
				
					_Сделка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаЦенныеБумаги.Партия, "Основание");
					_НомерСделки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(_Сделка, "НомерСделки");
					
					Если _НомерСделки = "12720507043" Тогда
						БалансоваяЦена		= 4024679582.49 / 4611259;
						БалансоваяСтоимость = БалансоваяЦена * СтрокаЦенныеБумаги.Количество;
					КонецЕсли;
					
				КонецЕсли;				
				
				#КонецОбласти
				
				Если БалансоваяЦена = Неопределено Тогда
					
					ИзменениеНоминала = ?(СведенияОБумаге.Амортизационная, СтрокаПокупки.НоминалПриПокупке - СведенияОБумаге.Номинал, 0);		
					
					Если СтрокаПокупки.НачальныйДисконт >= 0 ИЛИ НастройкиУчета.СтоимостьТелаРавнаНоминалу Тогда // Бумага куплена с премией или по схеме УГМК (у них всчегда номинал был)
						БалансоваяЦена = СтрокаПокупки.НоминалПриПокупке; // пляшем от номинала
					ИначеЕсли СведенияОБумаге.Амортизационная 
						И (ТипЗнч(СтрокаЦенныеБумаги.Партия) = Тип("ДокументСсылка.РеклассификацияАктивовЕПС")
							ИЛИ СтрокаПокупки.ДатаПокупки = '20250101') Тогда // косвенный признак (((
						// в 1.1.25 были ВПЕРВЫЕ произведены реклассы амортизационных бумаг из СС в АС 
						// для реклассифицированных бумаг пришлось использовать косвенный признак ДатаПокупки = '20250101'
						// т.к. при расчете СЧА нет информации о том, что ввели бумагу ранее реклассифицированную
						// СтрокаПокупки.ЦенаПокупкиНачальная брать нельзя т.к. от рекласса начинается новая жизнь
						// но и СтрокаПокупки.ЦенаПокупки тоже брать нельзя т.к. при реклассе в нее попадает переоценка
						// единственный вариант - берем из партий на утро
						// это может сломаться в день амортизации, но ни у одной из этих бумаг эти дни не попадают на конец месяца, поэтосму пофиг
						СтрокиБалансовыеДанныеНаУтро = ДополнительныеСвойства.БалансовыеДанныеНаУтро.НайтиСтроки(Новый Структура("Партия, СтрокаПартии", СтрокаЦенныеБумаги.Партия, СтрокаЦенныеБумаги.СтрокаПартии));
						
						БалансоваяЦена = СтрокиБалансовыеДанныеНаУтро[0].БалансоваяСуммаВВалютеУчета / СтрокаЦенныеБумаги.Количество;
						ИзменениеНоминала = 0; // мы уже взяли данные на утро, не нужно изменени номинала учитывать
					Иначе
						БалансоваяЦена = СтрокаПокупки.ЦенаПокупкиНачальная; // пляшем от начальной покупки
						Если НастройкиУчета.РасчетКорректировкиЭСПМетодомОтНСД И (НачалоДня(ДатаВводаПартии) <> НачалоДня(ДатаПереоценки)) Тогда
							БалансоваяЦена = БалансовыеДанныеНаУтро.Стоимость / СтрокаЦенныеБумаги.Количество;
						КонецЕсли;
					КонецЕсли;
					
					БалансоваяЦена		= БалансоваяЦена - ИзменениеНоминала;
					БалансоваяСтоимость	= БалансоваяЦена * СтрокаЦенныеБумаги.Количество;		
					
				КонецЕсли;
				
			КонецЕсли;
			
			НачальнаяРазницаППНеНаблюдаемыеДанные = БалансовыеДанныеНаУтро.НачальнаяРазницаППНеНаблюдаемыеДанные;
			
			Если ОценочнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = Неопределено Тогда
				ОценочнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = ДанныеРасчета.ОценочнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные;
			КонецЕсли;

			// Расчет цены и суммы СЧА из слагаемых
			
			Если РасчетЦеныОтСтоимостиПоЭСП Тогда // Так быстрее и правильнее, но увы расходится с бухгалтерией
				
				ЦенаСЧА = ДанныеРасчета.СтоимостьПоЭСП
					- ОценочнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные / СтрокаЦенныеБумаги.Количество
					- СтрокаЦенныеБумаги.ОценочнаяЦенаКупона;
					
				СтоимостьСЧА = ЦенаСЧА * СтрокаЦенныеБумаги.Количество;
					
			Иначе							
					
				АмортизированнаяСтоимость = РассчитатьАмортизированнуюСтоимостьПоДаннымПартий(
					ПравильныйУчетПП, ВключатьРазницуПервоначальногоПризнанияВБалансовуюСтоимость,
					БалансоваяСтоимость, НачальнаяРазницаППНеНаблюдаемыеДанные, ОценочнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные, ДанныеРасчета.ОценочныеДисконтПремия,
					ДанныеРасчета.ОценочнаяКорректировкаЭСП, СуммаРезервовПодОбесценение, СтрокаЦенныеБумаги.Количество, БалансоваяЦена);
					
				ЦенаСЧА		 = АмортизированнаяСтоимость.Цена;
				СтоимостьСЧА = АмортизированнаяСтоимость.Сумма;
			
			КонецЕсли;
						
			СтоимостьБух = БалансоваяСтоимость
				+ НачальнаяРазницаППНеНаблюдаемыеДанные
				+ СтрокаЦенныеБумаги.ОценочнаяЦенаКупона * СтрокаЦенныеБумаги.Количество
				+ ДанныеРасчета.ОценочныеДисконтПремия
				+ ДанныеРасчета.ОценочнаяКорректировкаЭСП
				+ СуммаРезервовПодОбесценение;
						
			СтрокаЦенныеБумаги.РыночнаяЦена			= ЦенаСЧА;
			СтрокаЦенныеБумаги.ЦенаКотировки		= СтрокаЦенныеБумаги.РыночнаяЦена;
			СтрокаЦенныеБумаги.ВалютаКотировки		= СведенияОБумаге.ВалютаНоминала;
			СтрокаЦенныеБумаги.РыночнаяЦенаПроцент	= СтрокаЦенныеБумаги.РыночнаяЦена / СтрокаПокупки.НоминалТекущий * 100;
			СтрокаЦенныеБумаги.Биржа				= Справочники.Биржи.ПустаяСсылка();
			СтрокаЦенныеБумаги.ИсточникЦены			= ПараметрыОценки.Клиент;
			СтрокаЦенныеБумаги.ПолеЦены 			= Перечисления.ИсточникиЦеныДляПереоценки.АмортизированнаяСтоимость;
			СтрокаЦенныеБумаги.УровеньОценки		= 1;
			СтрокаЦенныеБумаги.ДатаКотировки 		= ДатаПереоценки;
			
			#Область Расшифровка_расчета
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				
				ЭСП = ?(ДанныеРасчета.Свойство("ЭСПКорректировка") И ДанныеРасчета.ЭСПКорректировка > 0,
					Метаданные.ОпределяемыеТипы.ЭффективнаяПроцентнаяСтавка.Тип.ПривестиЗначение(ДанныеРасчета.ЭСПКорректировка),
					Неопределено);
				
				ПараметрыРасчетаЦен = Новый Структура;
				ПараметрыРасчетаЦен.Вставить("Описание",					Описание);
				ПараметрыРасчетаЦен.Вставить("БалансоваяСумма",				БалансоваяСтоимость);
				ПараметрыРасчетаЦен.Вставить("НачальнаяРазницаПП",			НачальнаяРазницаППНеНаблюдаемыеДанные);
				ПараметрыРасчетаЦен.Вставить("ОценочнаяРазницаПП",			ОценочнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные);
				ПараметрыРасчетаЦен.Вставить("ОценочныеДисконтПремия",		ДанныеРасчета.ОценочныеДисконтПремия);
				ПараметрыРасчетаЦен.Вставить("ЭСП",							ЭСП);
				ПараметрыРасчетаЦен.Вставить("ОценочнаяКорректировкаЭСП",	ДанныеРасчета.ОценочнаяКорректировкаЭСП);
				ПараметрыРасчетаЦен.Вставить("РезервыПодОбесценение",		СуммаРезервовПодОбесценение);
				ПараметрыРасчетаЦен.Вставить("СтоимостьСЧА",				СтоимостьСЧА);
				ПараметрыРасчетаЦен.Вставить("Цена",						ЦенаСЧА);
				ПараметрыРасчетаЦен.Вставить("АмортизированнаяСтоимость",	СтоимостьБух);

				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , , ПараметрыРасчетаЦен);
				
			КонецЕсли;
			
			#КонецОбласти

		КонецЕсли;
		
		#КонецОбласти
		
	ИначеЕсли РасчетСтоимости = "ОтПоследнейПоЭСП" Тогда
		
		#Область Стоимость_по_ЭСП_плюс_изменения_дисконт_премии
		
		// Изменения от последней цены, рассчитанной по ЭСП
		
		Если Не ДополнительныеСвойства.Свойство("ДанныеНаПредыдущиеДаты")
			ИЛИ ДополнительныеСвойства.ДанныеНаПредыдущиеДаты[ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП] = Неопределено
		Тогда
		
			#Область Получение_суммы_балансовой_дисконт_премии_и_настроек_учета_на_дату_последней_цены_по_ЭСП
			
			Если Не ДополнительныеСвойства.Свойство("ДанныеНаПредыдущиеДаты") Тогда
				ДополнительныеСвойства.Вставить("ДанныеНаПредыдущиеДаты", Новый Соответствие);		
			КонецЕсли;
			
			ОтборДатЗапретаПартий = РегистрыСведений.ДатыЗапретаРедактирования.СформироватьСтруктуруОтбораДатЗапрета(ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления, Перечисления.ГруппыЗапретаРедактирования.Партии, ПараметрыОценки.ВидУчета);
			
			ДанныеНаДатуПоследнейЦеныПоЭСП = Новый Структура;
			ДанныеНаДатуПоследнейЦеныПоЭСП.Вставить("ОстаткиПартий",		 СоставляющиеАмортизированнойСтоимостиПоДаннымПартий(Новый Граница(КонецДня(ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП), ВидГраницы.Включая), ПараметрыОценки));
			ДанныеНаДатуПоследнейЦеныПоЭСП.Вставить("НастройкиУчета",		 БухгалтерскийУчет.ОпределитьНастройкиУчета(ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП, ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления));
			ДанныеНаДатуПоследнейЦеныПоЭСП.Вставить("ЕстьДатыЗапретаПартий", РегистрыСведений.ДатыЗапретаРедактирования.ПроверитьЗапретРедактирования(ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП, ОтборДатЗапретаПартий));
			
			ДополнительныеСвойства.ДанныеНаПредыдущиеДаты.Вставить(ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП, ДанныеНаДатуПоследнейЦеныПоЭСП);	
			
			#КонецОбласти
			
		КонецЕсли;

		ДанныеНаДатуПоследнейЦеныПоЭСП = ДополнительныеСвойства.ДанныеНаПредыдущиеДаты[ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП];
		ОстаткиПартийНаПредыдущиеДаты  = ДанныеНаДатуПоследнейЦеныПоЭСП.ОстаткиПартий.НайтиСтроки(Новый Структура("Партия, СтрокаПартии", СтрокаЦенныеБумаги.Партия, СтрокаЦенныеБумаги.СтрокаПартии))[0];
		ЕстьДатыЗапретаПартий		   = ДанныеНаДатуПоследнейЦеныПоЭСП.ЕстьДатыЗапретаПартий;
		
		#Область Проверка_дат_запрета_партий_на_даты_предыдущей_стоимости
			
		Если Не ЕстьДатыЗапретаПартий Тогда // Прежде чем использовать остатки партий на предыдущую дату, нужно быть уверенным, что они рассчитаны
			
			ТекстОшибки = СтрШаблон("Ошибка расчета АС партии '%1 (строка %2)' от предыдущей стоимости: не установлена дата запрета редактирования партий на %3",
				СтрокаЦенныеБумаги.Партия, СтрокаЦенныеБумаги.СтрокаПартии, Формат(ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП, "ДФ=dd.MM.yyyy"));
					
			Если РасшифровкаРасчета = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			Иначе
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , , Новый Структура("Результат", ТекстОшибки));
			КонецЕсли;
			
			РаботаСПереоценкой.ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаЦенныеБумаги);
			
			Возврат Ложь;
			
		КонецЕсли;
		
		#КонецОбласти
		
		// Изменение дисконт-премии
		
		БалансоваяДисконтПремияНаПредыдущуюПереоценку =
			Окр(ОстаткиПартийНаПредыдущиеДаты.БалансовыеДисконтПремия / ОстаткиПартийНаПредыдущиеДаты.Количество * СтрокаЦенныеБумаги.Количество, 2);
			
		Если ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП = НачалоДня(ДатаВводаПартии) Тогда
			
			ДисконтПремияНаПредыдущуюПереоценку = БалансоваяДисконтПремияНаПредыдущуюПереоценку; // в день ввода расчетная премия может отличаться от зафиксированной в акте, но брать нужно, как в нем
			
		Иначе
			
			ДанныеПереоценкиНаПредыдущуюПереоценку = РаботаСКоллекциями.СкопироватьСтруктуру(ДанныеПереоценкиДляДисконтПремии);
			ДанныеПереоценкиНаПредыдущуюПереоценку.Вставить("ДатаПереоценки", ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП);
			ДанныеПереоценкиНаПредыдущуюПереоценку.Вставить("Количество",	  ОстаткиПартийНаПредыдущиеДаты.Количество);
			
			Если ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП = '20221231'
				И (ПараметрыОценки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_УГМК") И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Автодор_001")) // АО "НПФ "ПЕРСПЕКТИВА": Автодор, 4B02-01-00011-T-003P, 1000.00 RUB
					ИЛИ (ПараметрыОценки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар") И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_МФиНП_НСО_021")) // НПФ Достойное БУДУЩЕЕ АО: МФ и НП НСО, RU34021ANO0, 1000.00 RUB
					ИЛИ (ПараметрыОценки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар") И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_СПетербург_003")) // НПФ Достойное БУДУЩЕЕ АО: Санкт-Петербург, RU35003GSP0, 1000.00 RUB
			Тогда 
				НастройкиУчетаНаПредыдущуюПереоценку = ДанныеНаДатуПоследнейЦеныПоЭСП.НастройкиУчета;
			Иначе
				НастройкиУчетаНаПредыдущуюПереоценку = НастройкиУчета;	
			КонецЕсли;
			
			Если ДанныеПереоценкиНаПредыдущуюПереоценку.ДатаПереоценки = '20241231' Тогда // в этот день бумаги последний раз были на счете 503, а 1.1.25 их перенесли на 504
				МассивОблигацийРеклассифицированныхНа504ПриПереходеНаМСФО9 = Кэширование.ПолучитьОблигацииРеклассифицированныеНа504ПриПереходеНаМСФО9(ПараметрыОценки.СчетДоверительногоУправления);
				Если МассивОблигацийРеклассифицированныхНа504ПриПереходеНаМСФО9.Найти(СтрокаЦенныеБумаги.ЦеннаяБумага) <> Неопределено Тогда // бумага перешла с 503 на 504
					ДанныеПереоценкиНаПредыдущуюПереоценку.УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСДПрочихРезидентов; // укажем ПРАВИЛЬНЫЙ актив - любой из 503х
				КонецЕсли;
			КонецЕсли;
			
			ДисконтПремияНаПредыдущуюПереоценкуНаПрежнееКоличество = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремии(СтрокаЦенныеБумаги.ЦеннаяБумага, НастройкиУчетаНаПредыдущуюПереоценку, ДанныеПереоценкиНаПредыдущуюПереоценку, ДанныеПокупкиДляДисконтПремии, Отказ);
			
			ДисконтПремияНаПредыдущуюПереоценку = Окр(ДисконтПремияНаПредыдущуюПереоценкуНаПрежнееКоличество.ОценочныеДисконтПремия / ОстаткиПартийНаПредыдущиеДаты.Количество * СтрокаЦенныеБумаги.Количество, 2);	
				
			Если СтрокаПокупки.НачальныйДисконт > 0 И ДисконтПремияНаПредыдущуюПереоценку > БалансоваяДисконтПремияНаПредыдущуюПереоценку		// недосписали премии
				ИЛИ СтрокаПокупки.НачальныйДисконт < 0 И ДисконтПремияНаПредыдущуюПереоценку < БалансоваяДисконтПремияНаПредыдущуюПереоценку	// недоначислили дисконта
			Тогда
				ДисконтПремияНаПредыдущуюПереоценку = БалансоваяДисконтПремияНаПредыдущуюПереоценку;	
			КонецЕсли;
		
		КонецЕсли;
		
		БалансовыеДисконтПремияНаДатуПереоценки = БалансовыеДанныеНаУтро.БалансовыеДисконтПремия;
		
		ДисконтПремияНаДатуПереоценкиНаТекущееКоличество = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремии(СтрокаЦенныеБумаги.ЦеннаяБумага, НастройкиУчета, ДанныеПереоценкиДляДисконтПремии, ДанныеПокупкиДляДисконтПремии, Отказ);
		
		ДисконтПремияНаДатуПереоценки = Окр(ДисконтПремияНаДатуПереоценкиНаТекущееКоличество.ОценочныеДисконтПремия, 2);		
			
		Если СтрокаПокупки.НачальныйДисконт > 0 И ДисконтПремияНаДатуПереоценки > БалансовыеДисконтПремияНаДатуПереоценки		// недосписали премии
			ИЛИ СтрокаПокупки.НачальныйДисконт < 0 И ДисконтПремияНаДатуПереоценки < БалансовыеДисконтПремияНаДатуПереоценки И НЕ СведенияОБумаге.ЭтоДеньПогашенияНоминала	// недоначислили дисконта, но не в день амортизации
		Тогда
			ДисконтПремияНаДатуПереоценки = БалансовыеДисконтПремияНаДатуПереоценки;	
		КонецЕсли;
		
		// Изменение резервов под обесценение
		
		СуммаРезервовПодОбесценениеНаПредыдущуюПереоценку = 
			-Окр(ОстаткиПартийНаПредыдущиеДаты.СуммаРезервовПодОбесценение / ОстаткиПартийНаПредыдущиеДаты.Количество * СтрокаЦенныеБумаги.Количество, 2);
			
		// Цена на предыдущую оценку	
		
		Если ЦенаНаПредыдущуюПереоценку = Неопределено Тогда
			
			Если СтоимостьНаПредыдущуюПереоценку <> Неопределено Тогда
				
				ЦенаНаПредыдущуюПереоценку = СтоимостьНаПредыдущуюПереоценку.Цена;
				
			ИначеЕсли ОстаткиПартийНаПредыдущиеДаты.Количество = СтрокаЦенныеБумаги.Количество Тогда
				
				#Область Получение_последней_посчитанной_по_ЭСП_стоимости
				
				ЗапросСтоимостиНаПредыдущуюПереоценку = Новый Запрос(
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	СтоимостьПереоценки.Цена КАК Цена,
					|	СтоимостьПереоценки.Сумма КАК Сумма
					|ИЗ
					|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
					|ГДЕ
					|	СтоимостьПереоценки.Период = &Период
					|	И СтоимостьПереоценки.Организация = &Организация
					|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
					|	И СтоимостьПереоценки.ЦеннаяБумага = &ЦеннаяБумага
					|	И СтоимостьПереоценки.ВидУчета = &ВидУчета
					|	И СтоимостьПереоценки.Рынок = &Рынок
					|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
					|	И СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета
					|	И СтоимостьПереоценки.Партия = &Партия
					|	И СтоимостьПереоценки.СтрокаПартии = &СтрокаПартии");
				
				ЗапросСтоимостиНаПредыдущуюПереоценку.УстановитьПараметр("Период",							ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП);
				ЗапросСтоимостиНаПредыдущуюПереоценку.УстановитьПараметр("Организация",						ПараметрыОценки.Организация);
				ЗапросСтоимостиНаПредыдущуюПереоценку.УстановитьПараметр("СчетДоверительногоУправления",	ПараметрыОценки.СчетДоверительногоУправления);
				ЗапросСтоимостиНаПредыдущуюПереоценку.УстановитьПараметр("ЦеннаяБумага",					СтрокаЦенныеБумаги.ЦеннаяБумага);
				ЗапросСтоимостиНаПредыдущуюПереоценку.УстановитьПараметр("ВидУчета",						ПараметрыОценки.ВидУчета);
				ЗапросСтоимостиНаПредыдущуюПереоценку.УстановитьПараметр("Рынок",							СтрокаЦенныеБумаги.Рынок);
				ЗапросСтоимостиНаПредыдущуюПереоценку.УстановитьПараметр("ЦельРасчета",						ПараметрыОценки.ЦельРасчета);
				ЗапросСтоимостиНаПредыдущуюПереоценку.УстановитьПараметр("Партия",							СтрокаЦенныеБумаги.Партия);
				ЗапросСтоимостиНаПредыдущуюПереоценку.УстановитьПараметр("СтрокаПартии",					СтрокаЦенныеБумаги.СтрокаПартии);				
				
				// это могут быть непроведенные реклассы от которых отказались 31.07.25
				Если ПараметрыОценки.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ")
					И ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП = '20250731' Тогда
				
					ПолучитьПартииНепроведенныхРекласовОтКоторыхОтказались = Кэширование.ПолучитьПартииНепроведенныхРекласовОтКоторыхОтказались();
					
					СтрокиПНРОКО = ПолучитьПартииНепроведенныхРекласовОтКоторыхОтказались.НайтиСтроки(
						Новый Структура("СчетДоверительногоУправления,ЦеннаяБумага,ПартияЗачисление,СтрокаПартииЗачисление",
							ПараметрыОценки.СчетДоверительногоУправления,
							СтрокаЦенныеБумаги.ЦеннаяБумага,
							СтрокаЦенныеБумаги.Партия,
							СтрокаЦенныеБумаги.СтрокаПартии));
					Если СтрокиПНРОКО.Количество() = 1 Тогда
						ЗапросСтоимостиНаПредыдущуюПереоценку.УстановитьПараметр("Партия",		СтрокиПНРОКО[0].ПартияСписания);
						ЗапросСтоимостиНаПредыдущуюПереоценку.УстановитьПараметр("СтрокаПартии",СтрокиПНРОКО[0].СтрокаПартииСписание);				
					КонецЕсли;
					
				КонецЕсли;
				
				РезультатЗапросаСтоимости = ЗапросСтоимостиНаПредыдущуюПереоценку.Выполнить();
				
				Если РезультатЗапросаСтоимости.Пустой() Тогда
					
					#Область Расчет_цен_на_предыдущую_переоценку_бумаг_по_АС
					
					ОшибкаРасчета = Ложь;
					
					Если ДополнительныеСвойства.Свойство("СтоимостиНаПредыдущуюПереоценку") Тогда
						СтоимостиПереоценки = ДополнительныеСвойства.СтоимостиНаПредыдущуюПереоценку.Получить(ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП);
					КонецЕсли;
						
					Если СтоимостиПереоценки = Неопределено Тогда	
						
						ЗапросБумагОцениваемыхПоАС = Новый МенеджерВременныхТаблиц;
						
						ПоместитьБумагиОцениваемыеПоАмортизированнойСтоимостиВМенеджерВременныхТаблиц(
							ЗапросБумагОцениваемыхПоАС, ПараметрыОценки, ДатаПереоценки, СтрокаЦенныеБумаги.Владелец().Скопировать(), "_БумагиПоАС");
						
						ПредыдущаяПереоценка = Новый Структура("Организация, СчетДоверительногоУправления, ЦельРасчета, ВидУчета, Дата");
						ЗаполнитьЗначенияСвойств(ПредыдущаяПереоценка, ПараметрыОценки);
						ПредыдущаяПереоценка.Дата = ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП;
						
						РегистрацияСтоимостиПереоценки = Документы.РегистрацияСтоимостиПереоценки.СоздатьДокумент();
						ЗаполнитьЗначенияСвойств(РегистрацияСтоимостиПереоценки, ПредыдущаяПереоценка);
						РегистрацияСтоимостиПереоценки.ДополнительныеСвойства.Вставить("ФильтрПоЦеннойБумаге", ЗапросБумагОцениваемыхПоАС.Таблицы["_БумагиПоАС"].ПолучитьДанные().Выгрузить().ВыгрузитьКолонку("ЦеннаяБумага"));
						
						РегистрацияСтоимостиПереоценки.ЗаполнитьСтоимостьПереоценки(Истина, Ложь, ОшибкаРасчета);
						
						СтоимостиПереоценки = РегистрацияСтоимостиПереоценки.СтоимостиПереоценки;			
						
						Если Не ДополнительныеСвойства.Свойство("СтоимостиНаПредыдущуюПереоценку") Тогда
							ДополнительныеСвойства.Вставить("СтоимостиНаПредыдущуюПереоценку", Новый Соответствие);
						КонецЕсли;
						ДополнительныеСвойства.СтоимостиНаПредыдущуюПереоценку.Вставить(ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП, СтоимостиПереоценки);

					КонецЕсли;	
					
					Если Не ОшибкаРасчета Тогда
						
						НайденныеСтроки = СтоимостиПереоценки.НайтиСтроки(Новый Структура("Партия, СтрокаПартии", СтрокаЦенныеБумаги.Партия, СтрокаЦенныеБумаги.СтрокаПартии));
						
						Если НайденныеСтроки.Количество() > 0 Тогда
							СтоимостьНаПредыдущуюПереоценку = НайденныеСтроки[0];	
						Иначе
							ОшибкаРасчета = Истина;		
						КонецЕсли;
						
					КонецЕсли;					
					
					#КонецОбласти
					
					Если ОшибкаРасчета Тогда
					
						ТекстОшибки = СтрШаблон("Ошибка расчета АС от предыдущей стоимости: стоимость %1 (%2, строка %3) на %4 не зарегистрирована",
							СтрокаЦенныеБумаги.ЦеннаяБумага,
							СтрокаЦенныеБумаги.Партия,
							СтрокаЦенныеБумаги.СтрокаПартии,
							Формат(ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП, "ДФ=dd.MM.yyyy"));
						
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , , , Отказ);
						
						Если РасшифровкаРасчета <> Неопределено Тогда
							ПараметрыРасчетаЦен = Новый Структура("СтоимостьНаПредыдущуюПереоценку", ТекстОшибки);
							РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , , ПараметрыРасчетаЦен);
						КонецЕсли;
						
						Возврат Ложь;
						
					КонецЕсли;
					
				Иначе
					
					СтоимостьНаПредыдущуюПереоценку = РезультатЗапросаСтоимости.Выгрузить()[0];
					
				КонецЕсли;
				
				#КонецОбласти
			
				ЦенаНаПредыдущуюПереоценку = СтоимостьНаПредыдущуюПереоценку.Цена;	
				
			Иначе
			
				// В случае изменения количества цену рассчитываем из составляющих амортизированной суммы,
				// уменьшенных пропорционально выводимому количеству
				
				КоэффициентВывода = 1 - СтрокаЦенныеБумаги.Количество / ОстаткиПартийНаПредыдущиеДаты.Количество;
				
				АмортизированнаяСтоимостьНаПредыдущуюПереоценку = РассчитатьАмортизированнуюСтоимостьПоДаннымПартий(
					ПравильныйУчетПП, ВключатьРазницуПервоначальногоПризнанияВБалансовуюСтоимость,
					ОстаткиПартийНаПредыдущиеДаты.БалансоваяСуммаВВалютеУчета - Окр(ОстаткиПартийНаПредыдущиеДаты.БалансоваяСуммаВВалютеУчета * КоэффициентВывода, 2),
					ОстаткиПартийНаПредыдущиеДаты.НачальнаяРазницаППНеНаблюдаемыеДанные - Окр(ОстаткиПартийНаПредыдущиеДаты.НачальнаяРазницаППНеНаблюдаемыеДанные * КоэффициентВывода, 2),
					ОстаткиПартийНаПредыдущиеДаты.ОценочнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные - Окр(ОстаткиПартийНаПредыдущиеДаты.ОценочнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные * КоэффициентВывода, 2),
					ДисконтПремияНаПредыдущуюПереоценку,
					ОстаткиПартийНаПредыдущиеДаты.ОценочнаяКорректировкаЭСП - Окр(ОстаткиПартийНаПредыдущиеДаты.ОценочнаяКорректировкаЭСП * КоэффициентВывода, 2),
					СуммаРезервовПодОбесценениеНаПредыдущуюПереоценку,
					СтрокаЦенныеБумаги.Количество);
					
				ЦенаНаПредыдущуюПереоценку = АмортизированнаяСтоимостьНаПредыдущуюПереоценку.Цена;	

			КонецЕсли;
			
		КонецЕсли;
		
		// Итоговая стоимость
		
		ИзменениеНоминала = ?(СведенияОБумаге.Амортизационная, ОстаткиПартийНаПредыдущиеДаты.Номинал - СведенияОБумаге.Номинал, 0);
		
		Если ИзменениеНоминала <> 0 И СтрокаПокупки.НачальныйДисконт < 0 Тогда
			
			АмортизацииЗаПериод = БухгалтерскийУчетЕПС.ПолучитьТаблицуАмортизаций(
				СтрокаЦенныеБумаги.ЦеннаяБумага,
				ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП,
				ДатаПереоценки);
				
			Если АмортизацииЗаПериод.Количество() > 1 Тогда
				
				СтрокаАмортизаций = АмортизацииЗаПериод[0];
				
				ИзменениеНоминала = Обработки.РасчетПартий.ОпределитьСуммуСписанияТелаПриАмортизации(
					СтрокаЦенныеБумаги.ЦеннаяБумага,
					СтрокаАмортизаций.Дата,
					ДанныеПокупкиДляДисконтПремии.ДатаПокупки,
					ДанныеПокупкиДляДисконтПремии.ЦенаПокупки,
					ДисконтПремияНаДатуПереоценки / СтрокаЦенныеБумаги.Количество,
					НастройкиУчета);
					
			КонецЕсли;
		
		КонецЕсли;
		
		Цена =
			ЦенаНаПредыдущуюПереоценку
			- ИзменениеНоминала
			- ДисконтПремияНаПредыдущуюПереоценку / СтрокаЦенныеБумаги.Количество
			+ ДисконтПремияНаДатуПереоценки / СтрокаЦенныеБумаги.Количество
			- СуммаРезервовПодОбесценениеНаПредыдущуюПереоценку / СтрокаЦенныеБумаги.Количество
			+ СуммаРезервовПодОбесценение / СтрокаЦенныеБумаги.Количество
			+ ПроизвольнаяКорректировка / СтрокаЦенныеБумаги.Количество;
		
		АмортизированнаяСтоимость =
			Окр(ЦенаНаПредыдущуюПереоценку * СтрокаЦенныеБумаги.Количество, 2)
			- Окр(ИзменениеНоминала * СтрокаЦенныеБумаги.Количество, 2)
			- ДисконтПремияНаПредыдущуюПереоценку
			+ ДисконтПремияНаДатуПереоценки
			- СуммаРезервовПодОбесценениеНаПредыдущуюПереоценку
			+ СуммаРезервовПодОбесценение
			+ ПроизвольнаяКорректировка;
			
		СтрокаЦенныеБумаги.РыночнаяЦена			= Цена;
		СтрокаЦенныеБумаги.ЦенаКотировки		= СтрокаЦенныеБумаги.РыночнаяЦена;
		СтрокаЦенныеБумаги.ВалютаКотировки		= СведенияОБумаге.ВалютаНоминала;
		СтрокаЦенныеБумаги.Биржа				= Справочники.Биржи.ПустаяСсылка();
		СтрокаЦенныеБумаги.ИсточникЦены			= Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ПараметрыОценки.СчетДоверительногоУправления, ДатаПереоценки);
		СтрокаЦенныеБумаги.ПолеЦены 			= Перечисления.ИсточникиЦеныДляПереоценки.АмортизированнаяСтоимость;
		СтрокаЦенныеБумаги.УровеньОценки		= 1;			
		СтрокаЦенныеБумаги.ДатаКотировки 		= ДатаПереоценки;

		#Область Расшифровка_расчета
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			
			ПараметрыРасчетаЦен = Новый Структура;
			ПараметрыРасчетаЦен.Вставить("Описание",							Описание);
			ПараметрыРасчетаЦен.Вставить("СуммаНаПредыдущуюПереоценку",			Окр(ЦенаНаПредыдущуюПереоценку * СтрокаЦенныеБумаги.Количество, 2));
			ПараметрыРасчетаЦен.Вставить("ДисконтПремияНаПредыдущуюПереоценку",	ДисконтПремияНаПредыдущуюПереоценку);
			ПараметрыРасчетаЦен.Вставить("ДисконтПремияНаДатуПереоценки",		ДисконтПремияНаДатуПереоценки);
			ПараметрыРасчетаЦен.Вставить("РезервыНаПредыдущуюПереоценку",		СуммаРезервовПодОбесценениеНаПредыдущуюПереоценку);
			ПараметрыРасчетаЦен.Вставить("РезервыНаДатуПереоценки",				СуммаРезервовПодОбесценение);
			ПараметрыРасчетаЦен.Вставить("ПроизвольнаяКорректировка",			ПроизвольнаяКорректировка);
			ПараметрыРасчетаЦен.Вставить("АмортизированнаяСтоимость",			АмортизированнаяСтоимость);
			ПараметрыРасчетаЦен.Вставить("Цена",								Цена);
			
			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , , ПараметрыРасчетаЦен);
			
		КонецЕсли;
		
		#КонецОбласти
		
		#КонецОбласти	
		
	ИначеЕсли РасчетСтоимости = "ПоДаннымПартий" Тогда
		
		#Область Стоимость_по_данным_регистра_партий
		
		Если Не ДополнительныеСвойства.Свойство("ОстаткиПартийНаКонецДня") Тогда
			ДополнительныеСвойства.Вставить("ОстаткиПартийНаКонецДня", СоставляющиеАмортизированнойСтоимостиПоДаннымПартий(Новый Граница(КонецДня(ДатаПереоценки), ВидГраницы.Включая), ПараметрыОценки));
		КонецЕсли;
		
		ОстаткиПартии = ДополнительныеСвойства.ОстаткиПартийНаКонецДня.НайтиСтроки(Новый Структура("Партия, СтрокаПартии", СтрокаЦенныеБумаги.Партия, СтрокаЦенныеБумаги.СтрокаПартии)); 		

		Если ОстаткиПартии.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон("Отсуствуют остатки партии '%1 (строка %2)'. Возможно партии еще не рассчитаны.", СтрокаЦенныеБумаги.Партия, СтрокаЦенныеБумаги.СтрокаПартии), , , , Отказ);
			Возврат Ложь;
		Иначе
			ОстаткиПартии = ОстаткиПартии[0];
		КонецЕсли;
		
		АмортизированнаяСтоимость = РассчитатьАмортизированнуюСтоимостьПоДаннымПартий(
			ПравильныйУчетПП, ВключатьРазницуПервоначальногоПризнанияВБалансовуюСтоимость,
			ОстаткиПартии.БалансоваяСуммаВВалютеУчета,
			ОстаткиПартии.НачальнаяРазницаППНеНаблюдаемыеДанные,
			ОстаткиПартии.ОценочнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
			ОстаткиПартии.ОценочныеДисконтПремия,
			ОстаткиПартии.ОценочнаяКорректировкаЭСП,
			СуммаРезервовПодОбесценение,
			СтрокаЦенныеБумаги.Количество);
			
		ЦенаСЧА		 = АмортизированнаяСтоимость.Цена;
		СтоимостьСЧА = АмортизированнаяСтоимость.Сумма;					
					
		СтрокаЦенныеБумаги.РыночнаяЦена			= ЦенаСЧА;
		СтрокаЦенныеБумаги.ЦенаКотировки		= СтрокаЦенныеБумаги.РыночнаяЦена;
		СтрокаЦенныеБумаги.ВалютаКотировки		= СтрокаЦенныеБумаги.ВалютаНоминала;
		СтрокаЦенныеБумаги.РыночнаяЦенаПроцент	= СтрокаЦенныеБумаги.РыночнаяЦена / СтрокаПокупки.НоминалТекущий * 100;
		СтрокаЦенныеБумаги.Биржа				= Справочники.Биржи.ПустаяСсылка();
		СтрокаЦенныеБумаги.ИсточникЦены			= ПараметрыОценки.Клиент;
		СтрокаЦенныеБумаги.ПолеЦены 			= Перечисления.ИсточникиЦеныДляПереоценки.АмортизированнаяСтоимость;
		СтрокаЦенныеБумаги.УровеньОценки		= 1;
		СтрокаЦенныеБумаги.ДатаКотировки 		= ДатаПереоценки;
		
		#Область Расшифровка_расчета
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			
			ПараметрыРасчетаЦен = Новый Структура;
			ПараметрыРасчетаЦен.Вставить("Описание",					Описание);
			ПараметрыРасчетаЦен.Вставить("БалансоваяСумма",				ОстаткиПартии.БалансоваяСуммаВВалютеУчета);
			ПараметрыРасчетаЦен.Вставить("НачальнаяРазницаПП",			ОстаткиПартии.НачальнаяРазницаППНеНаблюдаемыеДанные);
			ПараметрыРасчетаЦен.Вставить("ОценочнаяРазницаПП",			ОстаткиПартии.ОценочнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные);
			ПараметрыРасчетаЦен.Вставить("ОценочныеДисконтПремия",		ОстаткиПартии.ОценочныеДисконтПремия);
			ПараметрыРасчетаЦен.Вставить("ОценочнаяКорректировкаЭСП",	ОстаткиПартии.ОценочнаяКорректировкаЭСП);
			ПараметрыРасчетаЦен.Вставить("РезервыПодОбесценение",		СуммаРезервовПодОбесценение);
			ПараметрыРасчетаЦен.Вставить("СтоимостьСЧА",				СтоимостьСЧА);
			ПараметрыРасчетаЦен.Вставить("Цена",						ЦенаСЧА);

			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , , ПараметрыРасчетаЦен);
			
		КонецЕсли;
		
		#КонецОбласти
		
		#КонецОбласти	
	
	ИначеЕсли РасчетСтоимости = "СправедливаяСтоимостьПлюсРасходы" Тогда
	
		#Область Справедливая_стоимость_плюс_расходы
		
		#Область Оценка_бумаги_по_СС	
		
		Если Не ДополнительныеСвойства.Свойство("СправедливаяСтоимостьБумагОцениваемыхПоАмортизированнойСтоимости") Тогда
			ДополнительныеСвойства.Вставить("СправедливаяСтоимостьБумагОцениваемыхПоАмортизированнойСтоимости", Новый Соответствие);		
		КонецЕсли;
		
		ОшибкаРасчета = Ложь;
		
		СправедливаяСтоимость = ДополнительныеСвойства.СправедливаяСтоимостьБумагОцениваемыхПоАмортизированнойСтоимости.Получить(СтрокаЦенныеБумаги.ЦеннаяБумага); 
		
		Если СправедливаяСтоимость = Неопределено Тогда
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				РасшифровкаРасчетаСС = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, "Расчет справедливой стоимости бумаги", , , Истина);
			КонецЕсли;
			
			ПараметрыОценкиПоСС = РаботаСКоллекциями.СкопироватьСтруктуру(ПараметрыОценки);
			ПараметрыОценкиПоСС.Вставить("ОцениватьПоСправедливойСтоимости", Истина);
			
			ТаблицаОцениваемыхПоСС = СтрокаЦенныеБумаги.Владелец().СкопироватьКолонки("Рынок, ЦеннаяБумага");
			
			ЗаполнитьЗначенияСвойств(ТаблицаОцениваемыхПоСС.Добавить(), СтрокаЦенныеБумаги);
			
			ОцененныеПоСС = РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС(ПараметрыОценкиПоСС, НачалоДня(ДатаПереоценки), ТаблицаОцениваемыхПоСС, , ОшибкаРасчета, РасшифровкаРасчетаСС);
			
			Если Не ОшибкаРасчета Тогда
				ОцененныеПоСС = ОцененныеПоСС.Скопировать(Новый Структура("ЦеннаяБумага", СтрокаЦенныеБумаги.ЦеннаяБумага)); // иногда оценка выполняется по другим бумагам и они могут оказаться оцененными, но нам не нужны	
			КонецЕсли;
			
			Если Не ОшибкаРасчета И ОцененныеПоСС.Количество() = 1 И ОцененныеПоСС[0].Стоимость <> 0 Тогда
				СправедливаяСтоимость = ОцененныеПоСС[0];
			Иначе
				СправедливаяСтоимость = Новый Структура("Стоимость", Неопределено);
				ОшибкаРасчета = Истина;
			КонецЕсли;
			
			ДополнительныеСвойства.СправедливаяСтоимостьБумагОцениваемыхПоАмортизированнойСтоимости.Вставить(СтрокаЦенныеБумаги.ЦеннаяБумага, СправедливаяСтоимость);	
			
		КонецЕсли;
			
		Если СправедливаяСтоимость.Стоимость = Неопределено Тогда	
			
			ТекстОшибки = СтрШаблон("Ошибка расчета справедливой стоимости '%1' на %2 для расчета стоимости первоначального признания",
				СтрокаЦенныеБумаги.ЦеннаяБумага, Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy"));
				
			Если ОшибкаРасчета Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , , , Отказ);
			КонецЕсли;
				
			Если РасшифровкаРасчета <> Неопределено Тогда
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , , Новый Структура("Результат", ТекстОшибки));
			КонецЕсли;
			
			Возврат Ложь;
			
		КонецЕсли;
			
		#КонецОбласти
		
		СтрокаЦенныеБумаги.РыночнаяЦена			= СправедливаяСтоимость.Стоимость + СтрокаПокупки.ДопРасходы;
		СтрокаЦенныеБумаги.ЦенаКотировки		= СтрокаЦенныеБумаги.РыночнаяЦена;
		СтрокаЦенныеБумаги.ВалютаКотировки		= СтрокаЦенныеБумаги.ВалютаНоминала;
		СтрокаЦенныеБумаги.РыночнаяЦенаПроцент	= СтрокаЦенныеБумаги.РыночнаяЦена / СтрокаПокупки.НоминалТекущий * 100;
		СтрокаЦенныеБумаги.Биржа				= Справочники.Биржи.ПустаяСсылка();
		СтрокаЦенныеБумаги.ИсточникЦены			= ПараметрыОценки.Клиент;
		СтрокаЦенныеБумаги.ПолеЦены 			= Перечисления.ИсточникиЦеныДляПереоценки.АмортизированнаяСтоимость;
		СтрокаЦенныеБумаги.УровеньОценки		= 1;
		СтрокаЦенныеБумаги.ДатаКотировки 		= ДатаПереоценки;
		
		#Область Расшифровка_расчета
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			
			ПараметрыРасчетаЦен = Новый Структура;
			ПараметрыРасчетаЦен.Вставить("Описание",				Описание);
			ПараметрыРасчетаЦен.Вставить("СправедливаяСтоимость",	СправедливаяСтоимость.Стоимость);
			ПараметрыРасчетаЦен.Вставить("Расходы",					СтрокаПокупки.ДопРасходы);
			ПараметрыРасчетаЦен.Вставить("Цена",					СтрокаЦенныеБумаги.РыночнаяЦена);
			ПараметрыРасчетаЦен.Вставить("Количество",				СтрокаЦенныеБумаги.Количество);
			ПараметрыРасчетаЦен.Вставить("Сумма",					Окр(СтрокаЦенныеБумаги.РыночнаяЦена * СтрокаЦенныеБумаги.Количество, 2));

			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , , ПараметрыРасчетаЦен);
			
		КонецЕсли;
		
		#КонецОбласти
		
		#КонецОбласти
		
	КонецЕсли;
	
	Возврат Истина;	
	
КонецФункции

// Заполняет строку переоценки по данным расчета дисконтированной стоимости будущих денежных потоков по указанной ставке доходности
//
// Параметры:
//	СтрокаЦенныеБумаги					- СтрокаТаблицыЗначений -  
//	ПараметрыОценки						- Структура - см. РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС 
//	ДатаПереоценки						- Дата - 
//	ДанныеОДенежномПотоке				- ТаблицаЗначений - будущие денежные потоки
//										- Структура - параметры получения денежного потока
//	СтавкаДисконтирования				- Число - ставка дисконтирования
//	УровеньОценки						- Число -   
//	ТочностьЦены						- Число - округление до указанного числа знаков после запятой,
//										- Неопределено - цена не округляется
//	Отказ								- Булево - 
//	РасшифровкаРасчета					- Структура, Неопределено - 
//
// Возвращаемое значение:
//	ЦенаЗаполнена - Булево - Истина, если удалось рассчитать и заполнить цену
//
Функция ЗаполнитьДисконтированнойСтоимостью(СтрокаЦенныеБумаги, ПараметрыОценки, ДатаПереоценки, ДанныеОДенежномПотоке, СтавкаДисконтирования, УровеньОценки, ТочностьЦены = Неопределено, Отказ, РасшифровкаРасчета = Неопределено)
	
	ВыполненРасчетЦены = Ложь;
	
	// Расчет купона	
	
	Если ТипЗнч(СтрокаЦенныеБумаги) = Тип("СтрокаТаблицыЗначений")
		И СтрокаЦенныеБумаги.Владелец().Колонки.Найти("Купон") <> Неопределено 
		И ЗначениеЗаполнено(СтрокаЦенныеБумаги.Купон)
	Тогда
		Купон = СтрокаЦенныеБумаги.Купон;
	Иначе
		Купон = Справочники.Облигации.ПолучитьКупон(СтрокаЦенныеБумаги.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
	КонецЕсли;
	
	Цена = РассчитатьЦенуПоДисконтированнойСтоимости(СтрокаЦенныеБумаги.ЦеннаяБумага, ПараметрыОценки, ДатаПереоценки, ДанныеОДенежномПотоке, СтавкаДисконтирования, Купон, ТочностьЦены, Отказ, РасшифровкаРасчета);
	
	// Заполнение цены
	
	Если ЗначениеЗаполнено(Цена) И Цена > 0 Тогда

		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("Биржа",				Справочники.Биржи.ПустаяСсылка());
		СтруктураДанных.Вставить("ИсточникЦены",		Справочники.ЮрФизЛица.ПустаяСсылка());
		СтруктураДанных.Вставить("Источник",			Справочники.ЮрФизЛица.ПустаяСсылка());
		СтруктураДанных.Вставить("ПолеЦены", 			Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена);
		СтруктураДанных.Вставить("ВидЦены", 			Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена);
		СтруктураДанных.Вставить("УровеньОценки",		УровеньОценки);
		СтруктураДанных.Вставить("ДатаКотировки",		ДатаПереоценки);
		СтруктураДанных.Вставить("ДатаЦены",			ДатаПереоценки);
		СтруктураДанных.Вставить("ВалютаКотировки",		СтрокаЦенныеБумаги.ВалютаНоминала);
		СтруктураДанных.Вставить("Стоимость",			Цена);
		СтруктураДанных.Вставить("ЦенаКотировки",		Цена);
		СтруктураДанных.Вставить("РыночнаяЦена",		Цена);
		СтруктураДанных.Вставить("РыночнаяЦенаПроцент",	Цена / Справочники.Облигации.ПолучитьНоминал(СтрокаЦенныеБумаги.ЦеннаяБумага, ДатаПереоценки) * 100);
		
		ЗаполнитьЗначенияСвойств(СтрокаЦенныеБумаги, СтруктураДанных); 
		
		ВыполненРасчетЦены = Истина;
		
	КонецЕсли;	
	
	Возврат ВыполненРасчетЦены;
	
КонецФункции

// Заполняет строку переоценки по данным расчета дисконтированной стоимости будущих денежных потоков по безрисковой ставке доходности
//
// Параметры:
//	СтрокаЦенныеБумаги					- СтрокаТаблицыЗначений -  
//	ПараметрыОценки						- Структура - см. РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС 
//	ДатаПереоценки						- Дата - 
//	ДанныеОДенежномПотоке				- ТаблицаЗначений - будущие денежные потоки
//										- Структура - параметры получения денежного потока
//	РассчитыватьНоминальнуюСтавку		- Булево - если ЛОЖЬ, то для бумаг с индексируемым номиналом ставка будет браться из YIELDCLOSE регистра котировок, иначе ставка будет рассчитана 
//	УровеньОценки						- Число -   
//	ДанныеОКредитномСпреде				- ТаблицаЗначений - кредитный спред
//										- Структура - ключи структуры соответствуют параметрам функции РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред
//										- Неопределено - расчет спреда не выполняется, медиана равна 0   
//	ПараметрыРасчетаРейтинга			- Структура - ключи структуры соответствуют параметрам функции РаботаСПоказателямиФинансовыхИнструментов.ПоместитьРейтинговыеГруппыСубъектовВМенеджерВременныхТаблиц,
//										- Неопределено - расчет спреда не выполняется
//	ТочностьЦены						- Число - округление до указанного числа знаков после запятой,
//										- Неопределено - цена не округляется
//	Отказ								- Булево - 
//	РасшифровкаРасчета					- Структура, Неопределено - 
//
// Возвращаемое значение:
//	ЦенаЗаполнена - Булево - Истина, если удалось рассчитать и заполнить цену
//
Функция ЗаполнитьДисконтированнойПоБезрисковойСтавкеДоходностиСтоимостью(СтрокаЦенныеБумаги, ПараметрыОценки, ДатаПереоценки, ДанныеОДенежномПотоке, РассчитыватьНоминальнуюСтавку = Ложь, УровеньОценки, ДанныеОКредитномСпреде = Неопределено, ПараметрыРасчетаРейтинга = Неопределено, ТочностьЦены = Неопределено, Отказ, РасшифровкаРасчета = Неопределено)
	
	ВыполненРасчетЦены = Ложь;
		
	// Расчет купона	
	
	Если ТипЗнч(СтрокаЦенныеБумаги) = Тип("СтрокаТаблицыЗначений")
		И СтрокаЦенныеБумаги.Владелец().Колонки.Найти("Купон") <> Неопределено 
		И ЗначениеЗаполнено(СтрокаЦенныеБумаги.Купон)
	Тогда
		Купон = СтрокаЦенныеБумаги.Купон;
	Иначе
		Купон = Справочники.Облигации.ПолучитьКупон(СтрокаЦенныеБумаги.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
	КонецЕсли;
	
	Цена = РассчитатьЦенуПоДисконтированнойПоБезрисковойСтавкеДоходностиСтоимости(СтрокаЦенныеБумаги.ЦеннаяБумага, ПараметрыОценки, ДатаПереоценки, ДанныеОДенежномПотоке, РассчитыватьНоминальнуюСтавку, Купон, ДанныеОКредитномСпреде, ПараметрыРасчетаРейтинга, ТочностьЦены, Отказ, РасшифровкаРасчета);
	
	// Расчет и заполнение цены
	
	Если ЗначениеЗаполнено(Цена) И Цена > 0 Тогда

		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("Биржа",				Справочники.Биржи.ПустаяСсылка());
		СтруктураДанных.Вставить("ИсточникЦены",		Справочники.ЮрФизЛица.ПустаяСсылка());
		СтруктураДанных.Вставить("Источник",			Справочники.ЮрФизЛица.ПустаяСсылка());
		СтруктураДанных.Вставить("ПолеЦены", 			Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена);
		СтруктураДанных.Вставить("ВидЦены", 			Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена);
		СтруктураДанных.Вставить("УровеньОценки",		УровеньОценки);
		СтруктураДанных.Вставить("ДатаКотировки",		ДатаПереоценки);
		СтруктураДанных.Вставить("ДатаЦены",			ДатаПереоценки);
		СтруктураДанных.Вставить("ВалютаКотировки",		СтрокаЦенныеБумаги.ВалютаНоминала);
		СтруктураДанных.Вставить("Стоимость",			Цена);
		СтруктураДанных.Вставить("ЦенаКотировки",		Цена);
		СтруктураДанных.Вставить("РыночнаяЦена",		Цена);
		СтруктураДанных.Вставить("РыночнаяЦенаПроцент",	Цена / Справочники.Облигации.ПолучитьНоминал(СтрокаЦенныеБумаги.ЦеннаяБумага, ДатаПереоценки) * 100);
		
		ЗаполнитьЗначенияСвойств(СтрокаЦенныеБумаги, СтруктураДанных); 
		
		ВыполненРасчетЦены = Истина;
		
	КонецЕсли;	
	
	Возврат ВыполненРасчетЦены;
	
КонецФункции

// Заполняет строку переоценки по данным расчета дисконтированной стоимости будущих денежных потоков по формуле:
//                    CF(i) * k
// СС = Σ —————————————————————————————————— 
//                                t(i) - t(0)
//                                ——————————— 
//        (1 + r(i) + CrSpread) ^      T
//			
// CF(i)    – будущие денежные потоки по долговой ценной бумаге
// k		- коэффициент (k) корректировки потока (например, в результате оценки ожидаемых потерь в случае дефолта)
// r(i)     – доходность кривой бескупонной доходности (G-кривая), соответствующая дате выплаты i-го денежного потока
// CrSpread – медианное значение кредитного спреда облигационного индекса
// t(i)     – дата i-го платежа
// t(0)		– дата оценки
// T		– количество календарных дней в году, к которому относится платеж
//
// Параметры:
//	СтрокаЦенныеБумаги					- СтрокаТаблицыЗначений -  
//	ДатаПереоценки						- Дата - 
//	ПараметрыОценки						- Структура - см. РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС 
//	УровеньОценки						- Число -   
//	ДанныеОКредитномСпреде				- ТаблицаЗначений - кредитный спред
//										- Структура - ключи структуры соответствуют параметрам функции РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред
//										- Неопределено - расчет спреда не выполняется, медиана равна 0   
//	ПараметрыРасчетаРейтинга			- Структура - ключи структуры соответствуют параметрам функции РаботаСПоказателямиФинансовыхИнструментов.ПоместитьРейтинговыеГруппыСубъектовВМенеджерВременныхТаблиц,
//										- Неопределено - расчет спреда не выполняется
//	КоэффициентКорректировкиПотока		- Число - коэффициент (k) корректировки потока
//	ТочностьЦены						- Число - округление до указанного числа знаков после запятой,
//				 						- Неопределено - цена не округляется
//	ДанныеОДенежномПотоке				- ТаблицаЗначений - будущие денежные потоки
//										- Структура - параметры получения денежного потока
//	Отказ								- Булево - 
//	РасшифровкаРасчета					- Структура, Неопределено - 
//
// Возвращаемое значение:
//	ЦенаЗаполнена - Булево - Истина, если удалось рассчитать и заполнить цену
//
Функция ЗаполнитьДисконтированнойПоЗначениямКБДСтоимостью(СтрокаЦенныеБумаги, ДатаПереоценки, ПараметрыОценки, УровеньОценки = 3, ДанныеОКредитномСпреде = Неопределено, ПараметрыРасчетаРейтинга = Неопределено, КоэффициентКорректировкиПотока = 1, ТочностьЦены = Неопределено, ДанныеОДенежномПотоке = Неопределено, Отказ, РасшифровкаРасчета = Неопределено)
	
	ВыполненРасчетЦены = Ложь;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расчет цены по стоимости, дисконтированной по ставке КБД в точке, соответствующей дате потока", , , Истина);
	КонецЕсли;	
	
	ОшибкаРасчета = Ложь;
	
	// Расчет медианы кредитного спреда	
	
	Если ДанныеОКредитномСпреде = Неопределено Тогда
		
		МедианаКредитногоСпреда = 0;		
		
	Иначе
		
		Если ТипЗнч(ДанныеОКредитномСпреде) = Тип("ТаблицаЗначений") Тогда
			КредитныйСпред = ДанныеОКредитномСпреде;
		Иначе
			КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(
				СтрокаЦенныеБумаги.ЦеннаяБумага, ДатаПереоценки, ПараметрыРасчетаРейтинга, ДанныеОКредитномСпреде, ОшибкаРасчета, РасшифровкаОперации);
		КонецЕсли;
				
		Если Не ОшибкаРасчета И ТипЗнч(КредитныйСпред) = Тип("ТаблицаЗначений") И КредитныйСпред.Количество() > 0 Тогда
			МедианаКредитногоСпреда	= КредитныйСпред[0].Медиана / 10000;
		Иначе
			Возврат Ложь;
		КонецЕсли;		
		
	КонецЕсли;
	
	// Расчет купона	
	
	Если ТипЗнч(СтрокаЦенныеБумаги) = Тип("СтрокаТаблицыЗначений")
		И СтрокаЦенныеБумаги.Владелец().Колонки.Найти("Купон") <> Неопределено 
		И ЗначениеЗаполнено(СтрокаЦенныеБумаги.Купон)
	Тогда
		Купон = СтрокаЦенныеБумаги.Купон;
	Иначе
		Купон = Справочники.Облигации.ПолучитьКупон(СтрокаЦенныеБумаги.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
	КонецЕсли; 
	
	// Получаем денежный поток
	
	Если ТипЗнч(ДанныеОДенежномПотоке) = Тип("Структура") Тогда
		
		Если ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020
			И ДатаПереоценки >= '20230101' Тогда
		
			ОтборПоТипамОфертПоОблигациям = Новый Структура;
			ОтборПоТипамОфертПоОблигациям.Вставить("ЗначениеОтбора1", Перечисления.ТипыОфертПоОблигациям.Досрочно);
			ОтборПоТипамОфертПоОблигациям.Вставить("ЗначениеОтбора2", Перечисления.ТипыОфертПоОблигациям.ОфертаПродажа);
			
			ДанныеОДенежномПотоке.Вставить("ОтборПоТипамОфертПоОблигациям", ОтборПоТипамОфертПоОблигациям);
		
		КонецЕсли;
		
		ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(СтрокаЦенныеБумаги.ЦеннаяБумага, ДанныеОДенежномПотоке, ПараметрыОценки, ОшибкаРасчета, РасшифровкаОперации);
	Иначе
		ДенежныйПоток = ДанныеОДенежномПотоке;
	КонецЕсли;		
		
	Если ОшибкаРасчета Тогда
		Отказ = Истина;
		Возврат Ложь;
	КонецЕсли;

	// Расчет дисконтированной стоимости	
	
	ДисконтированнаяСтоимость = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимостьПоЗначениямКривойБескупоннойДоходности(
		ДенежныйПоток, ДатаПереоценки, МедианаКредитногоСпреда, КоэффициентКорректировкиПотока, ПараметрыОценки, ОшибкаРасчета, РасшифровкаОперации);
		
	Если ОшибкаРасчета Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Ошибка расчета амортизированной стоимости '%1' по значениям КБД", СтрокаЦенныеБумаги.ЦеннаяБумага), , , , Отказ);
		Возврат Ложь;
	КонецЕсли;
	
	Если ПараметрыОценки.Свойство("ТочностьDCF") Тогда
		ДисконтированнаяСтоимостьДоОкругления	= ДисконтированнаяСтоимость;
		ДисконтированнаяСтоимость				= Окр(ДисконтированнаяСтоимость, ПараметрыОценки.ТочностьDCF);
	КонецЕсли; 
	
	// Заполнение цены
	
	Цена = ДисконтированнаяСтоимость - Купон;
		
	Если Цена > 0 Тогда
		
		Если ТочностьЦены <> Неопределено Тогда
			Цена = Окр(Цена, ТочностьЦены);
		КонецЕсли;
	
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("Биржа",				Справочники.Биржи.ПустаяСсылка());
		СтруктураДанных.Вставить("ИсточникЦены",		Справочники.ЮрФизЛица.ПустаяСсылка());
		СтруктураДанных.Вставить("Источник",			Справочники.ЮрФизЛица.ПустаяСсылка());
		СтруктураДанных.Вставить("ПолеЦены", 			Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена);
		СтруктураДанных.Вставить("ВидЦены", 			Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена);
		СтруктураДанных.Вставить("УровеньОценки",		УровеньОценки);
		СтруктураДанных.Вставить("ДатаКотировки",		ДатаПереоценки);
		СтруктураДанных.Вставить("ДатаЦены",			ДатаПереоценки);
		СтруктураДанных.Вставить("ВалютаКотировки",		СтрокаЦенныеБумаги.ВалютаНоминала);
		СтруктураДанных.Вставить("Стоимость",			Цена);
		СтруктураДанных.Вставить("ЦенаКотировки",		Цена);
		СтруктураДанных.Вставить("РыночнаяЦена",		Цена);
		СтруктураДанных.Вставить("РыночнаяЦенаПроцент",	Цена / Справочники.Облигации.ПолучитьНоминал(СтрокаЦенныеБумаги.ЦеннаяБумага, ДатаПереоценки) * 100);
		
		ЗаполнитьЗначенияСвойств(СтрокаЦенныеБумаги, СтруктураДанных); 
		
		Если РасшифровкаОперации <> Неопределено Тогда
			ПараметрыРасчетаЦен = Новый Структура;
			Если ПараметрыОценки.Свойство("ТочностьDCF") Тогда
				ПараметрыРасчетаЦен.Вставить("ДисконтированнаяСтоимостьДоОкругления", ДисконтированнаяСтоимостьДоОкругления);
			КонецЕсли;
			ПараметрыРасчетаЦен.Вставить("ДисконтированнаяСтоимость",	ДисконтированнаяСтоимость);
			ПараметрыРасчетаЦен.Вставить("Купон",						Купон);
			ПараметрыРасчетаЦен.Вставить("Цена",						Цена);
			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, "", "Результат расчета цены", ПараметрыРасчетаЦен);
		КонецЕсли;
		
		ВыполненРасчетЦены = Истина;
		
	КонецЕсли;
	
	Возврат ВыполненРасчетЦены;
				
КонецФункции

// Заполняет строку переоценки по данным расчета дисконтированной стоимости будущих денежных потоков по формуле:
//                    CF(i) * FX(i)
// СС = Σ —————————————————————————————————— 
//                                t(i) - t(0)
//                                ——————————— 
//        (1 + r(i) + CrSpread) ^      T
//			
// CF(i)    – будущие денежные потоки по долговой ценной бумаге
// r(i)     – доходность кривой бескупонной доходности (G-кривая), соответствующая дате выплаты i-го денежного потока
// CrSpread – медианное значение кредитного спреда облигационного индекса
// t(i)     – дата i-го платежа
// t(0)		– дата оценки
// T		– количество календарных дней в году, к которому относится платеж
//
// При этом, денежные потоки конвертируются в рубли по форвардному валютному курсу, рассчитанному по следующей формуле:
//				                     
//				                 t(i) - t(0)				                     
//				                ————————————
//                   1 + Gru  ^      365
//  FX(i) = FX(0) * ————————— 
//                   1 + Gfx 
//				
//где
//  FX(i)	– форвардный курс рубля на дату t(0) на срок (t(i) - t(0))/365, в руб. за ед. валюты;
//  FX(0)	– текущий курс рубля на дату t(0), за ед. валюты;
//  Gru		- ставка рублевой КБД на дату t(0), в десятичных долях;
//  Gfx		– ставка валютной КБД (USD или EUR) на дату t(0), в десятичных долях; 
//  ti		– даты денежных потоков облигации
//
// Параметры:
//	СтрокаЦенныеБумаги					- СтрокаТаблицыЗначений -  
//	ДатаПереоценки						- Дата - 
//	ПараметрыОценки						- Структура - см. РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС 
//	УровеньОценки						- Число -   
//	ДанныеОДенежномПотоке				- ТаблицаЗначений - будущие денежные потоки
//										- Структура - параметры получения денежного потока
//	ДанныеОКредитномСпреде				- ТаблицаЗначений - кредитный спред
//										- Структура - ключи структуры соответствуют параметрам функции РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред
//										- Неопределено - расчет спреда не выполняется, медиана равна 0   
//	ПараметрыРасчетаРейтинга			- Структура - ключи структуры соответствуют параметрам функции РаботаСПоказателямиФинансовыхИнструментов.ПоместитьРейтинговыеГруппыСубъектовВМенеджерВременныхТаблиц,
//										- Неопределено - расчет спреда не выполняется
//	ТочностьЦены						- Число - округление до указанного числа знаков после запятой,
//				 						- Неопределено - цена не округляется
//	Отказ								- Булево - 
//	РасшифровкаРасчета					- Структура, Неопределено - 
//
// Возвращаемое значение:
//	ЦенаЗаполнена - Булево - Истина, если удалось рассчитать и заполнить цену
//
Функция ЗаполнитьДисконтированнойПоЗначениямКБДСтоимостьюПоФорвардномуВалютномуКурсу(СтрокаЦенныеБумаги, ДатаПереоценки, ПараметрыОценки, УровеньОценки = 3, ТочностьЦены = Неопределено, ДанныеОДенежномПотоке = Неопределено, ДанныеОКредитномСпреде = Неопределено, ПараметрыРасчетаРейтинга = Неопределено, Отказ, РасшифровкаРасчета = Неопределено)
	
	ВыполненРасчетЦены = Ложь;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расчет цены по стоимости, дисконтированной по ставке КБД в точке, соответствующей дате потока", , , Истина);
	КонецЕсли;	
	
	ПараметрыРасчетаФорвардногоКурса = Новый Структура;
	Если ПараметрыОценки.Свойство("ПараметрыРасчетаФорвардногоКурса") И ПараметрыОценки.ПараметрыРасчетаФорвардногоКурса <> Неопределено Тогда
		ПараметрыРасчетаФорвардногоКурса = ПараметрыОценки.ПараметрыРасчетаФорвардногоКурса	
	КонецЕсли;
		
	ОшибкаРасчета = Ложь;
	
	// Расчет медианы кредитного спреда	
	
	Если ДанныеОКредитномСпреде = Неопределено Тогда
		
		МедианаКредитногоСпреда = 0;		
		
	Иначе
		
		Если ТипЗнч(ДанныеОКредитномСпреде) = Тип("ТаблицаЗначений") Тогда
			КредитныйСпред = ДанныеОКредитномСпреде;
		Иначе
			КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(
				СтрокаЦенныеБумаги.ЦеннаяБумага, ДатаПереоценки, ПараметрыРасчетаРейтинга, ДанныеОКредитномСпреде, ОшибкаРасчета, РасшифровкаОперации);
		КонецЕсли;
				
		Если Не ОшибкаРасчета И ТипЗнч(КредитныйСпред) = Тип("ТаблицаЗначений") И КредитныйСпред.Количество() > 0 Тогда
			МедианаКредитногоСпреда	= КредитныйСпред[0].Медиана / 10000;
		Иначе
			Возврат Ложь;
		КонецЕсли;		
		
	КонецЕсли;
	
	// Расчет купона	
	
	Если ТипЗнч(СтрокаЦенныеБумаги) = Тип("СтрокаТаблицыЗначений")
		И СтрокаЦенныеБумаги.Владелец().Колонки.Найти("Купон") <> Неопределено 
		И ЗначениеЗаполнено(СтрокаЦенныеБумаги.Купон)
	Тогда
		Купон = СтрокаЦенныеБумаги.Купон;
	Иначе
		Купон = Справочники.Облигации.ПолучитьКупон(СтрокаЦенныеБумаги.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
	КонецЕсли; 
	
	// Получаем денежный поток
	
	Если ДанныеОДенежномПотоке = Неопределено Тогда
		ДанныеОДенежномПотоке = ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, СтрокаЦенныеБумаги.ЦеннаяБумага, ОшибкаРасчета); 
	КонецЕсли;
	
	Если Не ОшибкаРасчета Тогда
		
		Если ТипЗнч(ДанныеОДенежномПотоке) = Тип("Структура") Тогда
			ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(СтрокаЦенныеБумаги.ЦеннаяБумага, ДанныеОДенежномПотоке, ПараметрыОценки, ОшибкаРасчета, РасшифровкаОперации);
		Иначе
			ДенежныйПоток = ДанныеОДенежномПотоке;
		КонецЕсли;		
		
	КонецЕсли;
		
	// Курс валюты номинала
				
	Если Не ОшибкаРасчета Тогда
		
		КурсКратностьВалютыНоминала	= РегистрыСведений.КурсыВалют.Получить(ДатаПереоценки, Новый Структура("Валюта", СтрокаЦенныеБумаги.ВалютаНоминала));
		
		Если КурсКратностьВалютыНоминала.Кратность = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон("Ошибка определения курса валюты номинала '%1' на %2", СтрокаЦенныеБумаги.ЦеннаяБумага, Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy")), , , , ОшибкаРасчета);
		Иначе
			КурсВалютыНоминала = КурсКратностьВалютыНоминала.Курс / КурсКратностьВалютыНоминала.Кратность;
		КонецЕсли;
		
	КонецЕсли;	

	// Вид КБД по валюте номинала
	
	Если Не ОшибкаРасчета Тогда
		
		Если СтрокаЦенныеБумаги.ВалютаНоминала = ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Доллар_США") Тогда
		
			ВидКривой = Перечисления.ВидыКривойБескупоннойДоходности.США;
			
		ИначеЕсли СтрокаЦенныеБумаги.ВалютаНоминала = ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_ЕВРО") Тогда
			
			Если ПараметрыРасчетаФорвардногоКурса.Свойство("ИспользоватьИндексыГосударственныхОблигацийЗоныЕвроСРейтингомААА")
				И ПараметрыРасчетаФорвардногоКурса.ИспользоватьИндексыГосударственныхОблигацийЗоныЕвроСРейтингомААА = Истина
			Тогда
				ВидКривой = Перечисления.ВидыКривойБескупоннойДоходности.ЕврозонаААА;
			Иначе
				ВидКривой = Перечисления.ВидыКривойБескупоннойДоходности.Еврозона;
			КонецЕсли;
			
		Иначе
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить вид КБД для валюты " + СтрокаЦенныеБумаги.ВалютаНоминала, , , , ОшибкаРасчета);
			
		КонецЕсли;	
		
	КонецЕсли;	

	// Дисконтирование потоков

	Если Не ОшибкаРасчета Тогда

		Если РасшифровкаРасчета <> Неопределено Тогда
			РасшифровкаРасчетаВалютнойКБД = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, СтрШаблон("Расчет значения КБД '%1'", ВидКривой), , , Истина);
		КонецЕсли;	
		
		ТочностьКБД						= Неопределено;
		ТочностьДисконтированногоПотока	= Неопределено;
		
		Если ТипЗнч(ПараметрыОценки) = Тип("Структура") Тогда
			ПараметрыОценки.Свойство("ТочностьКБД",						ТочностьКБД);
			ПараметрыОценки.Свойство("ТочностьДисконтированногоПотока",	ТочностьДисконтированногоПотока);
		КонецЕсли;
		
		БудущиеПотоки = ДенежныйПоток.Скопировать(, "Дата, Поток");
		БудущиеПотоки.Колонки.Добавить("КоличествоДней",					Новый ОписаниеТипов("Число"));
		БудущиеПотоки.Колонки.Добавить("КоличествоЛет",						Новый ОписаниеТипов("Число"));
		БудущиеПотоки.Колонки.Добавить("ЗначениеРублевойКБД",				Новый ОписаниеТипов("Число"));
		БудущиеПотоки.Колонки.Добавить("ЗначениеВалютнойКБД",				Новый ОписаниеТипов("Число"));
		БудущиеПотоки.Колонки.Добавить("КоэффициентКорректировкиПотока",	Новый ОписаниеТипов("Число"));
		БудущиеПотоки.Колонки.Добавить("СкорректированныйПоток",			Новый ОписаниеТипов("Число"));
		БудущиеПотоки.Колонки.Добавить("СтавкаКБД",							Новый ОписаниеТипов("Число"));
		БудущиеПотоки.Колонки.Добавить("ДисконтированныйПоток",				Новый ОписаниеТипов("Число"));		
		
		Для Каждого Поток Из БудущиеПотоки Цикл
			
			Поток.КоличествоДней = ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(Поток.Дата, ДатаПереоценки);
			Поток.КоличествоЛет	 = Поток.КоличествоДней / 365;
			
			СрокИндексов = ?(ПараметрыРасчетаФорвардногоКурса.Свойство("СрокИндексов"), ПараметрыРасчетаФорвардногоКурса.СрокИндексов, Неопределено);
			
			Если ЗначениеЗаполнено(СрокИндексов) И БудущиеПотоки.Индекс(Поток) > 0 Тогда
				
				Поток.ЗначениеРублевойКБД = БудущиеПотоки[0].ЗначениеРублевойКБД;
				Поток.ЗначениеВалютнойКБД = БудущиеПотоки[0].ЗначениеВалютнойКБД;
				
			Иначе
				
				ДатаЗначенияВалютнойКБД = Неопределено;
				
				Если СрокИндексов = Неопределено Тогда
					СрокИндексов = Поток.КоличествоЛет;		
				КонецЕсли;
				
				Поток.ЗначениеРублевойКБД = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьЗначениеКривойБескупоннойДоходности(ДатаПереоценки, СрокИндексов, , ОшибкаРасчета);
				Поток.ЗначениеВалютнойКБД = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьЗначениеКривойБескупоннойДоходности(ДатаПереоценки, СрокИндексов, ВидКривой, ОшибкаРасчета, ДатаЗначенияВалютнойКБД, РасшифровкаРасчетаВалютнойКБД);
				
				Если ОшибкаРасчета Тогда
					Прервать;
				КонецЕсли;
					
				Если ДатаЗначенияВалютнойКБД < ДатаПереоценки Тогда
					
					// Запоминаем использованные в оценке КБД иностранных государств
					
					КлючКБД = СтрШаблон("КБД для валюты '%1' на срок 1 год за %2", СтрокаЦенныеБумаги.ВалютаНоминала, Формат(ДатаЗначенияВалютнойКБД, "ДФ=dd.MM.yyyy"));
					
					ДобавитьЦеннуюБумагуВДополнительныеСвойстваОценки(ПараметрыОценки, СтрокаЦенныеБумаги.ЦеннаяБумага, "ИспользованныеКБД", КлючКБД);
					
				КонецЕсли;				
				
			КонецЕсли;
			
			Поток.КоэффициентКорректировкиПотока = КурсВалютыНоминала * Pow((1 + Поток.ЗначениеРублевойКБД / 100) / (1 + Поток.ЗначениеВалютнойКБД / 100), Поток.КоличествоЛет);
			Поток.СкорректированныйПоток		 = Поток.Поток * Поток.КоэффициентКорректировкиПотока;
			
			ЗначениеКБД = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьЗначениеКривойБескупоннойДоходности(ДатаПереоценки, Поток.КоличествоЛет, , ОшибкаРасчета);
			
			Если ОшибкаРасчета Тогда
				Прервать;
			КонецЕсли;
			
			Поток.СтавкаКБД = ?(ТочностьКБД = Неопределено, ЗначениеКБД, Окр(ЗначениеКБД, ТочностьКБД)) / 100;
			
			ДисконтированныйПоток = Поток.СкорректированныйПоток / Pow(1 + Поток.СтавкаКБД + МедианаКредитногоСпреда, Поток.КоличествоЛет);
			
			Поток.ДисконтированныйПоток	= ?(ТочностьДисконтированногоПотока = Неопределено, ДисконтированныйПоток, Окр(ДисконтированныйПоток, ТочностьДисконтированногоПотока));
			
		КонецЦикла;

	КонецЕсли;						

	Если ОшибкаРасчета Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Ошибка расчета дисконтированной стоимости '%1' по значениям КБД", СтрокаЦенныеБумаги.ЦеннаяБумага), , , , Отказ);
		Возврат Ложь;
	КонецЕсли;
	
	ДисконтированнаяСтоимость = БудущиеПотоки.Итог("ДисконтированныйПоток");				
	
	Если ПараметрыОценки.Свойство("ТочностьDCF") Тогда
		ДисконтированнаяСтоимостьДоОкругления	= ДисконтированнаяСтоимость;
		ДисконтированнаяСтоимость				= Окр(ДисконтированнаяСтоимость, ПараметрыОценки.ТочностьDCF);
	КонецЕсли; 
	
	// Расчет и заполнение цены

	КупонВРублях = СтрокаЦенныеБумаги.Купон * КурсВалютыНоминала;
	
	Если ПараметрыРасчетаФорвардногоКурса.Свойство("ТочностьКупонаВРублях") Тогда
		КупонВРубляхДоОкругления	= КупонВРублях;
		КупонВРублях				= Окр(КупонВРублях, ПараметрыРасчетаФорвардногоКурса.ТочностьКупонаВРублях);
	КонецЕсли; 
	
	Цена = ДисконтированнаяСтоимость - КупонВРублях;

	Если Цена > 0 Тогда
		
		Если ТочностьЦены <> Неопределено Тогда
			ЦенаДоОкругления = Цена;
			Цена			 = Окр(Цена, ТочностьЦены);
		КонецЕсли;
	
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("Биржа",				Справочники.Биржи.ПустаяСсылка());
		СтруктураДанных.Вставить("ИсточникЦены",		Справочники.ЮрФизЛица.ПустаяСсылка());
		СтруктураДанных.Вставить("Источник",			Справочники.ЮрФизЛица.ПустаяСсылка());
		СтруктураДанных.Вставить("ПолеЦены", 			Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена);
		СтруктураДанных.Вставить("ВидЦены", 			Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена);
		СтруктураДанных.Вставить("УровеньОценки",		УровеньОценки);
		СтруктураДанных.Вставить("ДатаКотировки",		ДатаПереоценки);
		СтруктураДанных.Вставить("ДатаЦены",			ДатаПереоценки);
		СтруктураДанных.Вставить("ВалютаКотировки",		ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
		СтруктураДанных.Вставить("Стоимость",			Цена);
		СтруктураДанных.Вставить("ЦенаКотировки",		Цена);
		СтруктураДанных.Вставить("РыночнаяЦена",		Цена);
		СтруктураДанных.Вставить("РыночнаяЦенаПроцент",	Цена / Справочники.Облигации.ПолучитьНоминал(СтрокаЦенныеБумаги.ЦеннаяБумага, ДатаПереоценки) * 100);
		
		ЗаполнитьЗначенияСвойств(СтрокаЦенныеБумаги, СтруктураДанных); 
		
		Если РасшифровкаОперации <> Неопределено Тогда
			
			#Область Расшифровка_расчета
			
			ПараметрыРасчетаЦен = Новый Структура;
			ПараметрыРасчетаЦен.Вставить("КурсВалютыНоминала",							КурсВалютыНоминала);			
			
			Если ПараметрыОценки.Свойство("ТочностьDCF") Тогда
				ПараметрыРасчетаЦен.Вставить("ДисконтированнаяСтоимостьДоОкругления",	ДисконтированнаяСтоимостьДоОкругления);
			КонецЕсли;
			ПараметрыРасчетаЦен.Вставить("ДисконтированнаяСтоимость",					ДисконтированнаяСтоимость);
			
			ПараметрыРасчетаЦен.Вставить("КупонВВалютеНоминала",						СтрокаЦенныеБумаги.Купон);			
			Если ПараметрыРасчетаФорвардногоКурса.Свойство("ТочностьКупонаВРублях") Тогда
				ПараметрыРасчетаЦен.Вставить("КупонВРубляхДоОкругления",				КупонВРубляхДоОкругления);			
			КонецЕсли; 
			ПараметрыРасчетаЦен.Вставить("Купон",										КупонВРублях);
			
			Если ТочностьЦены <> Неопределено Тогда
				ПараметрыРасчетаЦен.Вставить("ЦенаДоОкругления",						ЦенаДоОкругления);
			КонецЕсли;
			ПараметрыРасчетаЦен.Вставить("Цена",										Цена);
			
			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Дисконтирование денежных потоков по ставке КБД в точке, соответствующей дате потока", БудущиеПотоки);
			
			РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаОперации, "Результат расчета цены", ПараметрыРасчетаЦен, , , Истина);
			
			#КонецОбласти			
			
		КонецЕсли;
		
		ВыполненРасчетЦены = Истина;
		
	КонецЕсли;
	
	Возврат ВыполненРасчетЦены;
				
КонецФункции

// Заполняет строку переоценки по данным расчета дисконтированной стоимости будущих денежных потоков по ставке дисконтирования, рассчитанной по аналогичным ценным бумагам
//
// Параметры:
//	СтрокаЦенныеБумаги		- СтрокаТаблицыЗначений -  
//	ПараметрыОценки			- Структура				- см. РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС 
//	ДатаПереоценки			- Дата					- дата переоценки
//	УровеньОценки			- Число					- уровень оценки  
//	ДанныеОДенежномПотоке	- ТаблицаЗначений		- будущие денежные потоки
//							- Структура				- параметры получения денежного потока
//	ТочностьЦены			- Число					- округление до указанного числа знаков после запятой,
//							- Неопределено			- цена не округляется
//	Отказ					- Булево				- 
//	РасшифровкаРасчета		- Структура				- структура расшифровки
//							- Неопределено			- без расшифровки
//
// Возвращаемое значение:
//	ЦенаЗаполнена - Булево - Истина, если удалось рассчитать и заполнить цену
//
Функция ЗаполнитьДисконтированнойПоСтавкеРассчитаннойПоАналогамСтоимостью(СтрокаЦенныеБумаги, ПараметрыОценки, ДатаПереоценки, УровеньОценки, ДанныеОДенежномПотоке = Неопределено, ТочностьЦены = Неопределено, Отказ, РасшифровкаРасчета = Неопределено)
	
	Если ТипЗнч(СтрокаЦенныеБумаги.ЦеннаяБумага) <> Тип("СправочникСсылка.Облигации") Тогда
		Возврат Ложь;
	ИначеЕсли Не ПараметрыОценки.Свойство("ПараметрыРасчетаСтоимостиПоАналогам") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Для методики '%1' не заполнены параметры расчета приведенной стоимости по аналогам.", ПараметрыОценки.ВариантРасчетаСправедливойСтоимости), , , , Отказ);
		Возврат Ложь;	
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расчет цены по стоимости, дисконтированной по ставке, рассчитанной по аналогам", , , Истина);
	КонецЕсли;

	// Автоматический подбор аналогов	
	
	КонтрольСЧА = ПараметрыОценки.Свойство("ДополнительныеСвойства") И ТипЗнч(ПараметрыОценки.ДополнительныеСвойства) = Тип("Структура") И ПараметрыОценки.ДополнительныеСвойства.Свойство("КонтрольСЧА");
	Если Не КонтрольСЧА Тогда
		АвтоматическийПодборАналогов = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(Неопределено, "АвтоматическийПодборАналогов", ПараметрыОценки.Клиент);
		Если АвтоматическийПодборАналогов = Истина Тогда
			ПодобратьАналогиЦеннойБумаги(СтрокаЦенныеБумаги, ПараметрыОценки, ДатаПереоценки, Отказ, РасшифровкаОперации);
		КонецЕсли;
	КонецЕсли;

	// Выбор варианта
	
	ПараметрыРасчетаСтоимостиПоАналогам			= ПараметрыОценки.ПараметрыРасчетаСтоимостиПоАналогам;
	ПараметрыЗапроса							= ПараметрыРасчетаСтоимостиПоАналогам.ПараметрыЗапроса;
	ТестироватьРасчетнуюЦенуНаВхождениеВСпред	= Ложь;
	ОтборАналогов								= Новый Структура("Назначение, ТолькоСВалютойНоминалаЦеннойБумаги", Перечисления.ЦелиИспользованияАналогов.РасчетСтавкиДисконтирования, Истина);
	
	Если ПараметрыРасчетаСтоимостиПоАналогам.ВариантРасчета = Справочники.ВариантыРасчетаОценочнойСтоимости.ОПК2018 Тогда
		
		#Область Расчет_по_методике_ОПК_2018
		
		Запрос = Новый Запрос;
		
		ПоместитьАналогиЦенныхБумагВМенеджерВременныхТаблиц(Запрос, СтрокаЦенныеБумаги.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.Организация, ПараметрыОценки.Клиент, ОтборАналогов, "_Аналоги"); 
		
		// Расчет только для ММВБ, так как другие биржи не предоставляют необходимые данные
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КотировкиТорговыхПлощадок.VOLUME КАК VOLUME,
			|	КотировкиТорговыхПлощадок.VALUE КАК VALUE,
			|	КотировкиТорговыхПлощадок.YIELDATWAP КАК YIELDATWAP,
			|	_Аналоги.Аналог КАК Аналог,
			|	КотировкиТорговыхПлощадок.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
			|	КотировкиТорговыхПлощадок.Валюта КАК ВалютаКотировки
			|ПОМЕСТИТЬ _ДанныеКотировокАналогов
			|ИЗ
			|	_Аналоги КАК _Аналоги
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
			|		ПО _Аналоги.Аналог = КотировкиТорговыхПлощадок.ЦеннаяБумага
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
			|		ПО (КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта)
			|			И (КурсыВалют.Период = &Период)
			|ГДЕ
			|	КотировкиТорговыхПлощадок.Биржа = &ММВБ
			|	И КотировкиТорговыхПлощадок.Период = &Период
			|	И КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим
			|	И КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность >= 1000000
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ДанныеКотировокАналогов.Аналог) КАК Количество
			|ПОМЕСТИТЬ _КоличествоАналогов
			|ИЗ
			|	_ДанныеКотировокАналогов КАК _ДанныеКотировокАналогов
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(СУММА(ВЫБОР
			|				КОГДА _КоличествоАналогов.Количество < 3
			|					ТОГДА 0
			|				ИНАЧЕ _ДанныеКотировокАналогов.YIELDATWAP * _ДанныеКотировокАналогов.VALUE
			|			КОНЕЦ), 0) КАК Числитель,
			|	ЕСТЬNULL(СУММА(ВЫБОР
			|				КОГДА _КоличествоАналогов.Количество < 3
			|					ТОГДА 0
			|				ИНАЧЕ _ДанныеКотировокАналогов.VALUE
			|			КОНЕЦ), 0) КАК Знаменатель,
			|	_ДанныеКотировокАналогов.ВалютаНоминала КАК ВалютаНоминала,
			|	_ДанныеКотировокАналогов.ВалютаКотировки КАК ВалютаКотировки
			|ПОМЕСТИТЬ _ИтоговыеСуммы
			|ИЗ
			|	_ДанныеКотировокАналогов КАК _ДанныеКотировокАналогов,
			|	_КоличествоАналогов КАК _КоличествоАналогов
			|
			|СГРУППИРОВАТЬ ПО
			|	_ДанныеКотировокАналогов.ВалютаНоминала,
			|	_ДанныеКотировокАналогов.ВалютаКотировки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ИтоговыеСуммы.Числитель / _ИтоговыеСуммы.Знаменатель КАК СтавкаДисконтирования,
			|	_ИтоговыеСуммы.ВалютаНоминала КАК ВалютаНоминала,
			|	_ИтоговыеСуммы.ВалютаКотировки КАК ВалютаКотировки,
			|	_ИтоговыеСуммы.ВалютаКотировки КАК ВалютаКупона
			|ИЗ
			|	_ИтоговыеСуммы КАК _ИтоговыеСуммы
			|ГДЕ
			|	_ИтоговыеСуммы.Знаменатель <> 0
			|	И _ИтоговыеСуммы.Числитель <> 0";
			
		Запрос.УстановитьПараметр("Период",	ДатаПереоценки);
		Запрос.УстановитьПараметр("ММВБ",	ПараметрыЗапроса.ММВБ);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Не Выборка.Следующий() Тогда // Ставка не рассчитана, поэтому переходим на следующий уровень оценки
			
			Если РасшифровкаОперации <> Неопределено Тогда
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Расчет цены по аналогам", Новый Структура("Аналоги", "Нет аналогов"));
			КонецЕсли;
			
			Возврат Ложь; 
			
		КонецЕсли;		
		
		СтавкаДисконтирования = Выборка.СтавкаДисконтирования;
		
		#КонецОбласти
		
	ИначеЕсли ПараметрыРасчетаСтоимостиПоАналогам.ВариантРасчета = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020
		Или ПараметрыРасчетаСтоимостиПоАналогам.ВариантРасчета = Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2020 Тогда
		
		#Область Расчет_по_методике_Национальный2020_и_Транснефть2020
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ДатаПереоценки",	ДатаПереоценки);
		
		Если СтрокаЦенныеБумаги.ОсновнойРынок = "Российская торговая площадка" Тогда
			
			ТестироватьРасчетнуюЦенуНаВхождениеВСпред = Истина;
		
			#Область Ставка_дисконтирования_как_средневзвешенная_доходность_к_погашению_рассчитанная_по_аналогам_по_объему_сделок
				
			Если РасшифровкаРасчета <> Неопределено Тогда
				РасшифровкаОперации.Имя = "Расчет цены по стоимости, дисконтированной по ставке равной средневзвешенной доходности к погашению, рассчитанной по аналогам по объему сделок";
			КонецЕсли;
					
			Если Не ПараметрыРасчетаСтоимостиПоАналогам.Свойство("КотировкиАналогов") Тогда
				
				#Область Котировки_аналогов
				
				#Область Заполнение_параметров_проверки_аналогов_по_умолчанию
				
				Если Не ПараметрыРасчетаСтоимостиПоАналогам.Свойство("ПараметрыПроверкиАналогов") Тогда
					ПараметрыРасчетаСтоимостиПоАналогам.Вставить("ПараметрыПроверкиАналогов", Новый Структура);
				КонецЕсли;
				
				ПараметрыПроверкиАналогов = ПараметрыРасчетаСтоимостиПоАналогам.ПараметрыПроверкиАналогов;
				
				Если Не ПараметрыПроверкиАналогов.Свойство("ГлубинаСделокРоссийскойПлощадки") Тогда
					ПараметрыПроверкиАналогов.Вставить("ГлубинаСделокРоссийскойПлощадки", 10);
				КонецЕсли;
				
				Если Не ПараметрыПроверкиАналогов.Свойство("ОбъемСделокВВалютеУчетаРоссийскойПлощадки") Тогда
					ПараметрыПроверкиАналогов.Вставить("ОбъемСделокВВалютеУчетаРоссийскойПлощадки", "500000");
				КонецЕсли;
				
				Если Не ПараметрыПроверкиАналогов.Свойство("ОбъемСделокВШтукахРоссийскойПлощадки") Тогда
					ПараметрыПроверкиАналогов.Вставить("ОбъемСделокВШтукахРоссийскойПлощадки", "500");
				КонецЕсли;
				
				#КонецОбласти
				
				СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(
					СтрокаЦенныеБумаги.Владелец(), "_ТаблицаЦБ", Запрос, Истина,
					Новый Структура("ЦеннаяБумага, Рынок, Биржа, ПоследняяДатаТоргов", "ЦеннаяБумага", "Рынок", "ОсновнаяПлощадка", "ПоследняяДатаТоргов"),
					СтрШаблон("ОсновнойРынок = ""%1"" И Стоимость = 0", СтрокаЦенныеБумаги.ОсновнойРынок));
					
				ПоместитьАналогиЦенныхБумагВМенеджерВременныхТаблиц(Запрос, "_ТаблицаЦБ", ДатаПереоценки, ПараметрыОценки.Организация, ПараметрыОценки.Клиент, ОтборАналогов, "_Аналоги");   
				ПоместитьСведенияОТоргахЦеннымиБумагамиВМенеджерВременныхТаблиц(Запрос, "_Аналоги", ДатаПереоценки, ПараметрыПроверкиАналогов.ГлубинаСделокРоссийскойПлощадки, "_СведенияОТоргахАналогами", "Аналог");    
				
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
					|	_ТаблицаЦБ.Биржа КАК Биржа,
					|	_Аналоги.Аналог КАК Аналог,
					|	СУММА(КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность) КАК ОбъемСделокВВалютеУчета,
					|	СУММА(КотировкиТорговыхПлощадок.VOLUME) КАК ОбъемСделокВШтуках,
					|	ВЫБОР
					|		КОГДА _ТаблицаЦБ.Биржа = &ММВБ
					|			ТОГДА ""ОбъемСделокВВалютеУчета за &ГлубинаСделок >= &ОбъемСделокВВалютеУчета""
					|		ИНАЧЕ ""ОбъемСделокВШтуках за &ГлубинаСделок >= &ОбъемСделокВШтуках""
					|	КОНЕЦ КАК Условие,
					|	ЕСТЬNULL(ВЫБОР
					|			КОГДА _ТаблицаЦБ.Биржа = &ММВБ
					|				ТОГДА СУММА(КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность) >= &ОбъемСделокВВалютеУчета
					|			ИНАЧЕ СУММА(КотировкиТорговыхПлощадок.VOLUME) >= &ОбъемСделокВШтуках
					|		КОНЕЦ, ЛОЖЬ) КАК ПроверкаПройдена
					|ПОМЕСТИТЬ _ОбъемСделокПоАналогам
					|ИЗ
					|	_ТаблицаЦБ КАК _ТаблицаЦБ
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Аналоги КАК _Аналоги
					|		ПО (_Аналоги.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СведенияОТоргахАналогами КАК _СведенияОТоргахАналогами
					|		ПО (_СведенияОТоргахАналогами.ЦеннаяБумага = _Аналоги.Аналог)
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
					|		ПО (КотировкиТорговыхПлощадок.ЦеннаяБумага = _Аналоги.Аналог)
					|			И (КотировкиТорговыхПлощадок.Рынок = _ТаблицаЦБ.Рынок)
					|			И (КотировкиТорговыхПлощадок.Биржа = _ТаблицаЦБ.Биржа)
					|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
					|			И (КотировкиТорговыхПлощадок.Период = _СведенияОТоргахАналогами.Дата)
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
					|		ПО (КурсыВалют.Валюта = КотировкиТорговыхПлощадок.Валюта)
					|			И (КурсыВалют.Период = &ДатаПереоценки)
					|
					|СГРУППИРОВАТЬ ПО
					|	_ТаблицаЦБ.ЦеннаяБумага,
					|	_ТаблицаЦБ.Биржа,
					|	_Аналоги.Аналог
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_ОбъемСделокПоАналогам.ЦеннаяБумага КАК ЦеннаяБумага,
					|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ОбъемСделокПоАналогам.Аналог) КАК Количество,
					|	""Количество аналогов >= 3"" КАК Условие,
					|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ОбъемСделокПоАналогам.Аналог) >= 3 КАК ПроверкаПройдена
					|ПОМЕСТИТЬ _КоличествоАналоговПрошедшихПроверкуПоОбъемуСделок
					|ИЗ
					|	_ОбъемСделокПоАналогам КАК _ОбъемСделокПоАналогам
					|ГДЕ
					|	_ОбъемСделокПоАналогам.ПроверкаПройдена
					|
					|СГРУППИРОВАТЬ ПО
					|	_ОбъемСделокПоАналогам.ЦеннаяБумага
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
					|	_ТаблицаЦБ.Биржа КАК Биржа,
					|	_Аналоги.Аналог КАК Аналог,
					|	_Аналоги.Клиент КАК Клиент,
					|	КотировкиТорговыхПлощадок.YIELDATWAP КАК YIELDATWAP,
					|	КотировкиТорговыхПлощадок.VALUE КАК VALUE,
					|	КотировкиТорговыхПлощадок.VOLUME КАК VOLUME,
					|	КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность КАК VALUE_ВВалютеУчета,
					|	КотировкиТорговыхПлощадок.YIELDATWAP * КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность КАК YIELDATWAP_VALUE_ВВалютеУчета,
					|	КотировкиТорговыхПлощадок.WAPRICE КАК WAPRICE,
					|	КотировкиТорговыхПлощадок.LEGALCLOSEPRICE КАК LEGALCLOSEPRICE,
					|	КотировкиТорговыхПлощадок.BID КАК BID,
					|	КотировкиТорговыхПлощадок.OFFER КАК OFFER,
					|	НоминалыАналогов.Номинал КАК Номинал
					|ИЗ
					|	_ТаблицаЦБ КАК _ТаблицаЦБ
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Аналоги КАК _Аналоги
					|		ПО _ТаблицаЦБ.ЦеннаяБумага = _Аналоги.ЦеннаяБумага
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КоличествоАналоговПрошедшихПроверкуПоОбъемуСделок КАК _КоличествоАналогов
					|		ПО (_КоличествоАналогов.ЦеннаяБумага = _Аналоги.ЦеннаяБумага)
					|			И (_КоличествоАналогов.ПроверкаПройдена)
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ОбъемСделокПоАналогам КАК _ОбъемСделокПоАналогам
					|		ПО (_ОбъемСделокПоАналогам.ЦеннаяБумага = _Аналоги.ЦеннаяБумага)
					|			И (_ОбъемСделокПоАналогам.Аналог = _Аналоги.Аналог)
					|			И (_ОбъемСделокПоАналогам.ПроверкаПройдена)
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
					|		ПО (КотировкиТорговыхПлощадок.Биржа = _ТаблицаЦБ.Биржа)
					|			И (КотировкиТорговыхПлощадок.ЦеннаяБумага = _Аналоги.Аналог)
					|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
					|			И (КотировкиТорговыхПлощадок.Период = _ТаблицаЦБ.ПоследняяДатаТоргов)
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
					|		ПО (КурсыВалют.Валюта = КотировкиТорговыхПлощадок.Валюта)
					|			И (КурсыВалют.Период = &ДатаПереоценки)
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
					|				&ДатаПереоценки,
					|				ЦеннаяБумага В
					|					(ВЫБРАТЬ
					|						_Аналоги.Аналог
					|					ИЗ
					|						_Аналоги)) КАК НоминалыАналогов
					|		ПО (НоминалыАналогов.ЦеннаяБумага = _Аналоги.Аналог)";
				
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОбъемСделокВВалютеУчета", ПараметрыПроверкиАналогов.ОбъемСделокВВалютеУчетаРоссийскойПлощадки);
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОбъемСделокВШтуках",		 ПараметрыПроверкиАналогов.ОбъемСделокВШтукахРоссийскойПлощадки);
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ГлубинаСделок",			 ПолучитьСклоненияСтрокиПоЧислу("", ПараметрыПроверкиАналогов.ГлубинаСделокРоссийскойПлощадки, "торговый день", "Л = ru_RU")[0]);
				
				Запрос.УстановитьПараметр("ММВБ", ПараметрыЗапроса.ММВБ);
				
				Если РасшифровкаОперации = Неопределено Тогда
					КотировкиАналогов = Запрос.Выполнить().Выгрузить();
				Иначе
					КотировкиАналогов = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаОперации, Запрос, "Получение котировок аналогов", "Котировки аналогов", , , , Истина);
				КонецЕсли;
				
				ПараметрыРасчетаСтоимостиПоАналогам.Вставить("КотировкиАналогов", КотировкиАналогов);
				
				#КонецОбласти

			КонецЕсли;
			
			КотировкиАналоговТекущейЦБ = ПараметрыРасчетаСтоимостиПоАналогам.КотировкиАналогов.Скопировать(Новый Структура("ЦеннаяБумага", СтрокаЦенныеБумаги.ЦеннаяБумага)); 
			Если КотировкиАналоговТекущейЦБ.Количество() < 3 Тогда
				Если РасшифровкаОперации <> Неопределено Тогда
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Расчет цены по аналогам", Новый Структура("Аналоги", "Нет аналогов"));
				КонецЕсли;
				Возврат Ложь;
			КонецЕсли;				
			
			Если СтрокаЦенныеБумаги.ОсновнаяПлощадка = ПараметрыЗапроса.ММВБ Тогда
				
				// Если основной рынок - ММВБ, то ставка дисконтирования
				//					
				//     Σ YIELDATWAP(i) * VALUE(i)
				// r = ——————————————————————————
				//             Σ VALUE(i)
				
				VALUE_ВВалютеУчета_Итог = КотировкиАналоговТекущейЦБ.Итог("VALUE_ВВалютеУчета");
				
				Если VALUE_ВВалютеУчета_Итог = 0 Тогда
					Если РасшифровкаОперации <> Неопределено Тогда
						РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Расчет цены по аналогам", Новый Структура("Аналоги", "Не удалось рассчитать ставку дисконтирования, т.к. Σ VALUE(i) = 0"));
					КонецЕсли;
					Возврат Ложь;
				КонецЕсли;
				
				СтавкаДисконтирования = КотировкиАналоговТекущейЦБ.Итог("YIELDATWAP_VALUE_ВВалютеУчета") / VALUE_ВВалютеУчета_Итог;
				
			Иначе
				
				// Если основной рынок - иная российская биржа, то ставка дисконтирования
				//					
				//     Σ YTM(i) * VOLUME(i)
				// r = ———————————————————
				//         Σ VOLUME(i)
				//					
				// YTM - эффективная доходность от цены в порядке убывания:
				// 1. средневзвешенная цена;
				// 2. цена закрытия
				// 3. средняя величина между ценами предложения и спроса
				
				КотировкиАналоговТекущейЦБ.Колонки.Добавить("ДоходностьОтЦены",			Новый ОписаниеТипов("ПеречислениеСсылка.ИсточникиЦеныДляПереоценки"));
				КотировкиАналоговТекущейЦБ.Колонки.Добавить("YTM",						Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(27, 10)));
				КотировкиАналоговТекущейЦБ.Колонки.Добавить("YTM_VOLUME",				Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(27, 10)));
				
				Для Каждого КотировкиАналога Из КотировкиАналоговТекущейЦБ Цикл
					
					Если КотировкиАналога.WAPRICE > 0 Тогда
						КотировкаАналога = КотировкиАналога.WAPRICE;
						КотировкиАналога.ДоходностьОтЦены = Перечисления.ИсточникиЦеныДляПереоценки.СредневзвешеннаяЦена;
					ИначеЕсли КотировкиАналога.LEGALCLOSEPRICE > 0 Тогда
						КотировкаАналога = КотировкиАналога.LEGALCLOSEPRICE;
						КотировкиАналога.ДоходностьОтЦены = Перечисления.ИсточникиЦеныДляПереоценки.ЦенаЗакрытия;
					Иначе
						КотировкаАналога = (КотировкиАналога.BID + КотировкиАналога.OFFER) / 2;
						КотировкиАналога.ДоходностьОтЦены = Перечисления.ИсточникиЦеныДляПереоценки.СредняяТочкаСпреда;
					КонецЕсли;
						
					КотировкиАналога.YTM = Справочники.Облигации.ПолучитьДоходностьИДюрацию(
						КотировкиАналога.Аналог, Ложь, ДатаПереоценки, КотировкаАналога * КотировкиАналога.Номинал / 100, ПараметрыОценки.СчетДоверительногоУправления, , ДатаПереоценки).Доходность;
						
					КотировкиАналога.YTM_VOLUME = КотировкиАналога.YTM * КотировкиАналога.VOLUME;
					
				КонецЦикла;
				
				Если РасшифровкаОперации <> Неопределено Тогда
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Расчет ставки дисконтирования", КотировкиАналоговТекущейЦБ.Скопировать());
				КонецЕсли;
				
				СтавкаДисконтирования = КотировкиАналоговТекущейЦБ.Итог("YTM_VOLUME") / КотировкиАналоговТекущейЦБ.Итог("VOLUME");		

			КонецЕсли;
			
			СтавкаДисконтирования = Окр(СтавкаДисконтирования, 6);
			
			#КонецОбласти
			
		ИначеЕсли СтрокаЦенныеБумаги.ОсновнойРынок = "Российский внебиржевой рынок" Тогда
			
			#Область Ставка_дисконтирования_как_среднее_доходностей_к_погашению_рассчитанное_по_аналогам_по_котировкам_НРД

			Если РасшифровкаРасчета <> Неопределено Тогда
				РасшифровкаОперации.Имя = "Расчет цены по стоимости, дисконтированной по ставке равной средней доходностей к погашению, рассчитанной по аналогам по котировкам_НРД";
			КонецЕсли;
			
			Если Не ПараметрыРасчетаСтоимостиПоАналогам.Свойство("КотировкиАналоговНРД") Тогда
				
				#Область Котировки_аналогов
				
				СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(
					СтрокаЦенныеБумаги.Владелец(), "_ТаблицаЦБ", Запрос, Истина, "ЦеннаяБумага, Рынок, ПоследняяДатаТоргов",
					СтрШаблон("ОсновнойРынок = ""%1"" И Стоимость = 0", СтрокаЦенныеБумаги.ОсновнойРынок));
					
				ПоместитьАналогиЦенныхБумагВМенеджерВременныхТаблиц(Запрос, "_ТаблицаЦБ", ДатаПереоценки, ПараметрыОценки.Организация, ПараметрыОценки.Клиент, ОтборАналогов, "_Аналоги");   
				
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
					|	_Аналоги.Аналог КАК Аналог,
					|	_Аналоги.Клиент КАК Клиент,
					|	РасчетныеЦеныНРД.RATE КАК RATE,
					|	РасчетныеЦеныНРД.VERSION КАК VERSION,
					|	РасчетныеЦеныНРД.METHOD_NUMBER КАК METHOD_NUMBER,
					|	""Есть цена НРД (VERSION = 2 И METHOD_NUMBER В (1, 2)) на дату оценки"" КАК Условие,
					|	ЕСТЬNULL(РасчетныеЦеныНРД.RATE > 0
					|			И РасчетныеЦеныНРД.VERSION = ""2""
					|			И РасчетныеЦеныНРД.METHOD_NUMBER В (""1"", ""2""), ЛОЖЬ) КАК ПроверкаПройдена
					|ПОМЕСТИТЬ _ЦеныНРД
					|ИЗ
					|	_ТаблицаЦБ КАК _ТаблицаЦБ
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Аналоги КАК _Аналоги
					|		ПО (_Аналоги.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
					|		ПО (РасчетныеЦеныНРД.ЦеннаяБумага = _Аналоги.Аналог)
					|			И (РасчетныеЦеныНРД.Рынок = _ТаблицаЦБ.Рынок)
					|			И (РасчетныеЦеныНРД.Период = _ТаблицаЦБ.ПоследняяДатаТоргов)
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_ЦеныНРД.ЦеннаяБумага КАК ЦеннаяБумага,
					|	СУММА(ВЫБОР
					|			КОГДА _ЦеныНРД.ПроверкаПройдена
					|				ТОГДА 1
					|		КОНЕЦ) КАК Количество,
					|	""Количество аналогов >= 3"" КАК Условие,
					|	ЕСТЬNULL(СУММА(ВЫБОР
					|				КОГДА _ЦеныНРД.ПроверкаПройдена
					|					ТОГДА 1
					|			КОНЕЦ) >= 3, ЛОЖЬ) КАК ПроверкаПройдена
					|ПОМЕСТИТЬ _КоличествоАналогов
					|ИЗ
					|	_ЦеныНРД КАК _ЦеныНРД
					|
					|СГРУППИРОВАТЬ ПО
					|	_ЦеныНРД.ЦеннаяБумага
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_ЦеныНРД.ЦеннаяБумага КАК ЦеннаяБумага,
					|	_ЦеныНРД.Аналог КАК Аналог,
					|	_ЦеныНРД.Клиент КАК Клиент,
					|	_ЦеныНРД.RATE КАК RATE,
					|	НоминалыАналогов.Номинал КАК Номинал
					|ИЗ
					|	_ЦеныНРД КАК _ЦеныНРД
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КоличествоАналогов КАК _КоличествоАналогов
					|		ПО (_КоличествоАналогов.ЦеннаяБумага = _ЦеныНРД.ЦеннаяБумага)
					|			И (_КоличествоАналогов.ПроверкаПройдена)
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
					|				&ДатаПереоценки,
					|				ЦеннаяБумага В
					|					(ВЫБРАТЬ
					|						_ЦеныНРД.Аналог
					|					ИЗ
					|						_ЦеныНРД)) КАК НоминалыАналогов
					|		ПО (НоминалыАналогов.ЦеннаяБумага = _ЦеныНРД.Аналог)
					|ГДЕ
					|	_ЦеныНРД.ПроверкаПройдена";
				
				Если РасшифровкаОперации = Неопределено Тогда
					КотировкиАналоговНРД = Запрос.Выполнить().Выгрузить();
				Иначе
					КотировкиАналоговНРД = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаОперации, Запрос, "Получение котировок НРД аналогов", "Котировки аналогов", , , , Истина);
				КонецЕсли;
				
				ПараметрыРасчетаСтоимостиПоАналогам.Вставить("КотировкиАналоговНРД", КотировкиАналоговНРД);
				
