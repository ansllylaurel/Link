		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						_ТаблицаЦБ.ЦеннаяБумага
		|					ИЗ
		|						_ТаблицаЦБ
		|					ГДЕ
		|						_ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))) КАК РасчетныеЦеныПаев
		|		ПО (РасчетныеЦеныПаев.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (РасчетныеЦеныПаев.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, МЕСЯЦ, -6))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФ
		|		ПО (Паи.ПаевойИнвестиционныйФонд = РеквизитыПИФ.ПаевойИнвестиционныйФонд)
		|ГДЕ
		|	_ЦБУровень1.ЦеннаяБумага ЕСТЬ NULL
		|	И _ЦБУровень2.ЦеннаяБумага ЕСТЬ NULL
		|	И НЕ &ТолькоНаблюдаемыеЦены
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦБУровень1.Рынок КАК Рынок,
		|	_ЦБУровень1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ЦБУровень1.ВалютаНоминала КАК ВалютаНоминала,
		|	_ЦБУровень1.УровеньОценки КАК УровеньОценки,
		|	_ЦБУровень1.ВидЦены КАК ВидЦены,
		|	_ЦБУровень1.СправедливаяЦена КАК СправедливаяЦена,
		|	_ЦБУровень1.ВалютаЦены КАК ВалютаКотировки,
		|	_ЦБУровень1.ВалютаЦены КАК Валюта,
		|	_ЦБУровень1.ДатаЦены КАК ДатаЦены,
		|	_ЦБУровень1.Источник КАК Источник,
		|	_ЦБУровень1.РежимТоргов КАК РежимТоргов
		|ПОМЕСТИТЬ _ОцененныеБумаги
		|ИЗ
		|	_ЦБУровень1 КАК _ЦБУровень1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦБУровень2.Рынок,
		|	_ЦБУровень2.ЦеннаяБумага,
		|	_ЦБУровень2.ВалютаНоминала,
		|	_ЦБУровень2.УровеньОценки,
		|	_ЦБУровень2.ВидЦены,
		|	_ЦБУровень2.СправедливаяЦена,
		|	_ЦБУровень2.ВалютаЦены,
		|	_ЦБУровень2.ВалютаЦены,
		|	_ЦБУровень2.ДатаЦены,
		|	_ЦБУровень2.Источник,
		|	_ЦБУровень2.РежимТоргов
		|ИЗ
		|	_ЦБУровень2 КАК _ЦБУровень2
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦБУровень3.Рынок,
		|	_ЦБУровень3.ЦеннаяБумага,
		|	_ЦБУровень3.ВалютаНоминала,
		|	_ЦБУровень3.УровеньОценки,
		|	_ЦБУровень3.ВидЦены,
		|	_ЦБУровень3.СправедливаяЦена,
		|	_ЦБУровень3.ВалютаЦены,
		|	_ЦБУровень3.ВалютаЦены,
		|	_ЦБУровень3.ДатаЦены,
		|	_ЦБУровень3.Источник,
		|	NULL
		|ИЗ
		|	_ЦБУровень3 КАК _ЦБУровень3
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ТаблицаЦБ.Номинал КАК Номинал,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(ОцененныеБумаги.СправедливаяЦена * _ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|			ИНАЧЕ ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(ОцененныеБумаги.Валюта, 0) КАК Валюта,
		|	ЕСТЬNULL(ОцененныеБумаги.ВалютаКотировки, 0) КАК ВалютаКотировки,
		|	ЕСТЬNULL(ОцененныеБумаги.ВидЦены, 0) КАК ВидЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, ЕСТЬNULL(ОцененныеБумаги.Источник, 0)) КАК Источник,
		|	ЕСТЬNULL(ОцененныеБумаги.РежимТоргов, 0) КАК РежимТоргов,
		|	_КотировкиКупонов.Купон КАК Купон,
		|	_КотировкиКупонов.ВалютаКупона КАК ВалютаКупона,
		|	_ТаблицаЦБ.ОблигацияСПлавающейСтавкойИлиНоминалом КАК ОблигацияСПлавающейСтавкойИлиНоминалом,
		|	_ТаблицаЦБ.ЭмитентРоссийский КАК ЭмитентРоссийский,
		|	_ТаблицаЦБ.НоминированаВРублях КАК НоминированаВРублях,
		|	_ТаблицаЦБ.ТоргуетсяНаММВБ КАК ТоргуетсяНаММВБ,
		|	_ТаблицаЦБ.ПоследняяДатаТоргов КАК ПоследняяДатаТоргов,
		|	_ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости КАК ОценкаПоАмортизированнойСтоимости
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОцененныеБумаги КАК ОцененныеБумаги
		|		ПО (ОцененныеБумаги.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (Биржи.Ссылка = ОцененныеБумаги.Источник)
		|		ЛЕВОЕ СОЕДИНЕНИЕ #КотировкиКупонов# КАК _КотировкиКупонов
		|		ПО (_КотировкиКупонов.Облигация = _ТаблицаЦБ.ЦеннаяБумага)";

	// Источник данных о купонах	
	
	ТаблицаКупонов = "_КотировкиКупонов";
	
	Если ДатаПереоценки >= '20230101' Тогда
		ПоместитьКотировкиКупоновВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, ПараметрыОценки.ВариантРасчетаСправедливойСтоимости, "_ТаблицаСпискаЦБ", ТаблицаКупонов);
	Иначе	
		ТаблицаКупонов = "(ВЫБРАТЬ NULL КАК Облигация, ВЫРАЗИТЬ(NULL КАК ЧИСЛО) КАК Купон, ВЫРАЗИТЬ(NULL КАК Справочник.Валюты) КАК ВалютаКупона)";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#КотировкиКупонов#", ТаблицаКупонов);
	
	// Варианты проверки цены закрытия 1-го уровня
	
	ВариантыПроверкиЦеныЗакрытияПервогоУровня = Новый Структура("ОбъемТорговНеРавенНулю, ВхождениеВСпредЦенСпросаИПредложения", "Объем торгов не равен нулю", "Вхождение в спред цен спроса и предложения");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВариантПроверкиЦеныЗакрытияПервогоУровня_ОбъемТорговНеРавенНулю",				"""" + ВариантыПроверкиЦеныЗакрытияПервогоУровня.ОбъемТорговНеРавенНулю + """");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВариантПроверкиЦеныЗакрытияПервогоУровня_ВхождениеВСпредЦенСпросаИПредложения",	"""" + ВариантыПроверкиЦеныЗакрытияПервогоУровня.ВхождениеВСпредЦенСпросаИПредложения + """");
	
	#КонецОбласти	
	
	ТолькоНаблюдаемыеЦены		= ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены;
	
	ММВБ						= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");	
	НРД							= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");	

	Блумберг					= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
	Режим_BGN					= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN");
	Режим_BVAL					= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL");

	ОбщероссийскийКалендарь		= Справочники.Календари.Общероссийский;
	КалендарныхДнейНазад35		= НачалоДня(ДатаПереоценки) - 34 * 3600 * 24;
	
	ДоступныеБиржи = Новый Массив;
	ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
		
	ВариантПроверкиЦеныЗакрытияПервогоУровня = ?(ДатаПереоценки >= '20230401',
		ВариантыПроверкиЦеныЗакрытияПервогоУровня.ВхождениеВСпредЦенСпросаИПредложения,
		ВариантыПроверкиЦеныЗакрытияПервогоУровня.ОбъемТорговНеРавенНулю);
		
	ДляОтдельныхОблигацийОФЗНаПервомУровнеПроверятьЦенуЗакрытияТолькоПоОбъемуТоргов = ДатаПереоценки >= '20250606';
	ОблигацииОФЗСОтдельнойПроверкойЦеныЗакрытияНаПервомУровне = ОблигацииОФЗСОтдельнойПроверкойЦеныЗакрытияНаПервомУровнеДляМетодикиБудущее2020(ТаблицаЦБ, ДатаПереоценки);
	
	Если ДатаПереоценки >= '20210101' Тогда
		ИгнорироватьТипОблигацииНРД												= Истина;
		ИспользоватьЦенуНРДДляАкций												= Истина;
		ИспользоватьКотировкиBloombergBGNДляАктивовВИностраннойВалюте			= Истина;
		ИспользоватьКотировкиBloombergBVALТолькоДляАктивовВИностраннойВалюте	= Истина;
		ПриоритетЦенНРДНадКотировкамиBloomberg									= Ложь;
	Иначе
		ИгнорироватьТипОблигацииНРД												= Ложь;
		МетодикиНРДРасчетаЦенОблигаций2Уровня									= РаботаСКоллекциями.ЗначенияВМассив("bond");
		МетодикиНРДРасчетаЦенОблигаций3Уровня									= РаботаСКоллекциями.ЗначенияВМассив("bond", "floating_bond");
		ИспользоватьЦенуНРДДляАкций												= Ложь;
		ИспользоватьКотировкиBloombergBGNДляАктивовВИностраннойВалюте			= Ложь;
		ИспользоватьКотировкиBloombergBVALТолькоДляАктивовВИностраннойВалюте	= Ложь;
		ПриоритетЦенНРДНадКотировкамиBloomberg									= Истина;
	КонецЕсли;
	
	ПриПроверкеАктивностиРынкаИсключатьРЕПОсРПС = ДатаПереоценки >= '20240301';
	
	ИностранныеУчетныеАктивы				= Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();
	ОпределятьПлавающиеОблигации			= (ДатаПереоценки >= '20200301');
	ОблигацииСПлавающейСтавкойИлиНоминалом	= ?(ОпределятьПлавающиеОблигации,
		Справочники.Облигации.ПолучитьОблигацииСПлавающейСтавкойИлиНоминалом(ТаблицаЦБ, ДатаПереоценки, Ложь, Ложь, РасшифровкаРасчета),
		Новый Массив);
		
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены",					ТолькоНаблюдаемыеЦены);
	
	Запрос.УстановитьПараметр("ДоступныеБиржи",							ДоступныеБиржи);
	Запрос.УстановитьПараметр("ММВБ",									ММВБ);
	Запрос.УстановитьПараметр("НРД",									НРД);
	Запрос.УстановитьПараметр("Блумберг",  								Блумберг);
	Запрос.УстановитьПараметр("Режим_BGN",								Режим_BGN);
	Запрос.УстановитьПараметр("Режим_BVAL",								Режим_BVAL);
	Запрос.УстановитьПараметр("ВалютаРубли",							ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	Запрос.УстановитьПараметр("ИностранныеУчетныеАктивы",				ИностранныеУчетныеАктивы);
	Запрос.УстановитьПараметр("ОпределятьПлавающиеОблигации",			ОпределятьПлавающиеОблигации);
	Запрос.УстановитьПараметр("ОблигацииСПлавающейСтавкойИлиНоминалом",	ОблигацииСПлавающейСтавкойИлиНоминалом);
	
	Запрос.УстановитьПараметр("ДатаПереоценки",							ДатаПереоценки);
	Запрос.УстановитьПараметр("КалендарныхДнейНазад35",					КалендарныхДнейНазад35);
	
	Запрос.УстановитьПараметр("ИгнорироватьТипОблигацииНРД",											ИгнорироватьТипОблигацииНРД);
	Запрос.УстановитьПараметр("МетодикиНРДРасчетаЦенОблигаций2Уровня",									МетодикиНРДРасчетаЦенОблигаций2Уровня);
	Запрос.УстановитьПараметр("ИспользоватьЦенуНРДДляАкций",											ИспользоватьЦенуНРДДляАкций);
	Запрос.УстановитьПараметр("ИспользоватьКотировкиBloombergBGNДляАктивовВИностраннойВалюте",			ИспользоватьКотировкиBloombergBGNДляАктивовВИностраннойВалюте);
	Запрос.УстановитьПараметр("ИспользоватьКотировкиBloombergBVALТолькоДляАктивовВИностраннойВалюте",	ИспользоватьКотировкиBloombergBVALТолькоДляАктивовВИностраннойВалюте);
	Запрос.УстановитьПараметр("ПриоритетЦенНРДНадКотировкамиBloomberg",									ПриоритетЦенНРДНадКотировкамиBloomberg);
	Запрос.УстановитьПараметр("ВариантПроверкиЦеныЗакрытияПервогоУровня",								ВариантПроверкиЦеныЗакрытияПервогоУровня);
	Запрос.УстановитьПараметр("ПриПроверкеАктивностиРынкаИсключатьРЕПОсРПС",							ПриПроверкеАктивностиРынкаИсключатьРЕПОсРПС);
	
	Запрос.УстановитьПараметр("ДляОтдельныхОблигацийОФЗНаПервомУровнеПроверятьЦенуЗакрытияТолькоПоОбъемуТоргов",
				ДляОтдельныхОблигацийОФЗНаПервомУровнеПроверятьЦенуЗакрытияТолькоПоОбъемуТоргов);
	Запрос.УстановитьПараметр("ОблигацииОФЗСОтдельнойПроверкойЦеныЗакрытияНаПервомУровне",
				ОблигацииОФЗСОтдельнойПроверкойЦеныЗакрытияНаПервомУровне);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Будущего 2020", "Промежуточная таблица стоимостей ЦБ", , , "_ТаблицаСпискаЦБ, _ЭмитентыЦенныхБумаг");		
	КонецЕсли;
	
	// Расчетные цены 	
	
	ВыполненРасчетЦены = Ложь;
	
	ПараметрыОценки.Вставить("ТочностьКБД", 4); // КБД берем в базисных пунктах (1бп = 0,01%), полученное значение округляем до 2 знаков после запятой
	ПараметрыОценки.Вставить("ТочностьDCF", 2); // При дисконтировании промежуточные округления не производятся, полученный результат округляется с точностью до 2 знаков после запятой
	
	ПараметрыОценки.Вставить("ПараметрыРасчетаФорвардногоКурса", Новый Структура("ТочностьКупонаВРублях", 2));

	Если ДатаПереоценки >= '20230401' Тогда
		ПараметрыОценки.Вставить("ТочностьСтавкиДисконтирования", 4);
	КонецЕсли;
	
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
	
	ЦеныПоследнегоТорговогоДняНРД = Новый Соответствие;
			
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И Не ЗначениеЗаполнено(СтрокаСтоимостейЦБ.Купон) Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления, , СтрокаСтоимостейЦБ.ВалютаКупона);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены) ИЛИ СтрокаСтоимостейЦБ.ОценкаПоАмортизированнойСтоимости Тогда
			
			Если СтрокаСтоимостейЦБ.УровеньОценки = 2 И СтрокаСтоимостейЦБ.РежимТоргов = Режим_BVAL Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Для ""%1"" за %2 применена корректировка Bloomberg BVAL. Убедитесь, что Score >= 6!", СтрокаСтоимостейЦБ.ЦеннаяБумага, Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy")));
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		Если ТолькоНаблюдаемыеЦены Тогда
			Продолжить;
		КонецЕсли;
		
		// Расчетные цены
		
		ОшибкаРасчета = Ложь;
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			Если ДатаПереоценки >= '20230201' И Не СтрокаСтоимостейЦБ.НоминированаВРублях Тогда 
				
				#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков_по_форвардному_валютному_курсу
				
				ЦенаЗаполнена = ЗаполнитьДисконтированнойПоЗначениямКБДСтоимостьюПоФорвардномуВалютномуКурсу(СтрокаСтоимостейЦБ, ДатаПереоценки, ПараметрыОценки, 2, 2, , ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, ОшибкаРасчета, РасшифровкаРасчета);
					
				Если ОшибкаРасчета Тогда
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
					Продолжить;
				ИначеЕсли ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
					Продолжить;
				КонецЕсли;			
					
				#КонецОбласти				
				
			ИначеЕсли Не СтрокаСтоимостейЦБ.ОблигацияСПлавающейСтавкойИлиНоминалом
				И НЕ СтрокаСтоимостейЦБ.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_РЖД_001Б-02")
				ИЛИ ДатаПереоценки >= '20210201' // #360160: Федерация, Будущее и Телеком-Союз говорят выполнять расчет по модели для этой бумаги																					 
					И СтрокаСтоимостейЦБ.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Сбербанк_002P") // Сбербанк ПАО, 4-02-01481-B-002P, 10000000.00 RUB
			Тогда		
			
				#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков
				
				ПараметрыДенежногоПотока = ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, СтрокаСтоимостейЦБ.ЦеннаяБумага, ОшибкаРасчета);
				
				Если Не ОшибкаРасчета Тогда
					ЦенаЗаполнена = ЗаполнитьДисконтированнойПоЗначениямКБДСтоимостью(СтрокаСтоимостейЦБ, ДатаПереоценки, ПараметрыОценки, 2, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, , 2, ПараметрыДенежногоПотока, ОшибкаРасчета, РасшифровкаРасчета);
				КонецЕсли;	
					
				Если ОшибкаРасчета Тогда
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
					Продолжить;
				ИначеЕсли ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
					Продолжить;
				КонецЕсли;			
					
				#КонецОбласти
			
			КонецЕсли;			

			#Область Расчетная_цена_НРД_3_уровня
		
			// Цена, рассчитанная НРД по методике, основанной на факторном разложения
			
			Если ЦеныПоследнегоТорговогоДняНРД.Получить(СтрокаСтоимостейЦБ.ПоследняяДатаТоргов) = Неопределено Тогда
				ЦеныПоследнегоТорговогоДняНРД.Вставить(
					СтрокаСтоимостейЦБ.ПоследняяДатаТоргов,
					ПолучитьЦеныНРД(ТаблицаСтоимостейЦБ, Новый СтандартныйПериод(СтрокаСтоимостейЦБ.ПоследняяДатаТоргов, ДатаПереоценки), РасшифровкаРасчета));
			КонецЕсли;

			ЦеныНРДТекущейЦБ = ЦеныПоследнегоТорговогоДняНРД[СтрокаСтоимостейЦБ.ПоследняяДатаТоргов].НайтиСтроки(
				Новый Структура("ЦеннаяБумага, VERSION, METHOD_NUMBER", СтрокаСтоимостейЦБ.ЦеннаяБумага, "2", "3")); 
			
			Если ЦеныНРДТекущейЦБ.Количество() > 0
				И (ИгнорироватьТипОблигацииНРД ИЛИ МетодикиНРДРасчетаЦенОблигаций3Уровня.Найти(ЦеныНРДТекущейЦБ[0].TYPE) <> Неопределено)
			Тогда

				СтрокаСтоимостейЦБ.Стоимость		= ЦеныНРДТекущейЦБ[0].Цена;
				СтрокаСтоимостейЦБ.ДатаЦены			= ЦеныНРДТекущейЦБ[0].ДатаЦены;
				СтрокаСтоимостейЦБ.УровеньОценки	= 3;
				СтрокаСтоимостейЦБ.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД;
				СтрокаСтоимостейЦБ.Источник			= НРД;
				СтрокаСтоимостейЦБ.ВалютаКотировки	= СтрокаСтоимостейЦБ.ВалютаНоминала;

				ВыполненРасчетЦены = Истина;
				Продолжить;
				
			КонецЕсли;

			#КонецОбласти
			
		ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
			
			Если СтрокаСтоимостейЦБ.ЭмитентРоссийский Тогда
			
				#Область Расчет_на_основе_корректировки_исторической_цены					
				
				// Справедливая стоимость акций российских эмитентов, допущенным к торгам на ММВБ,
				// определяется в соответствии с моделью оценки, основанной на корректировке исторической цены (CAPM).
				// Если бумага торгуется, применяем при отсутствии наблюдаемой цены не более 10 рабочих дней, иначе не более 45 рабочих дней
				
				ТочностьЦены = ?(ДатаПереоценки >= '20210101', 2, 5);
				
				Если ДатаПереоценки >= '20230110'
					И СтрокаСтоимостейЦБ.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Акция_Россети")	// Россети ПАО, 1-01-65018-D, 0.50 RUB
				Тогда
					ГлубинаПоиска = 100; // Фонд попросил не ограничивать срок 10 рабочими днями (#462192)
				ИначеЕсли СтрокаСтоимостейЦБ.ТоргуетсяНаММВБ ИЛИ ДатаПереоценки < '20230401' Тогда
					ГлубинаПоиска = 10;
				Иначе
					ГлубинаПоиска = 45;
				КонецЕсли;
				
				ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, ГлубинаПоиска, ОбщероссийскийКалендарь, , ТочностьЦены, ОшибкаРасчета, РасшифровкаРасчета);
				
				Если ОшибкаРасчета Тогда
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
					Продолжить;
				ИначеЕсли ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
					Продолжить;
				КонецЕсли;			
				
				#КонецОбласти					
			
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "Таблица стоимостей ЦБ", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;	

КонецФункции

Функция ПолучитьЦеныНационального2020(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "ИсходнаяТаблицаЦБ");
	ПоместитьБумагиОцениваемыеПоАмортизированнойСтоимостиВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки, ДатаПереоценки, "ИсходнаяТаблицаЦБ");

	#Область Основной_запрос	
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтатусыЦенныхБумагСрезПоследних.Рынок КАК Рынок,
		|	СтатусыЦенныхБумагСрезПоследних.Период КАК Период,
		|	СтатусыЦенныхБумагСрезПоследних.Статус КАК Статус,
		|	СтатусыЦенныхБумагСрезПоследних.Биржа КАК Биржа,
		|	ЕСТЬNULL(РеквизитыЮрЛицаБиржи.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК РоссийскаяБиржа
		|ПОМЕСТИТЬ СтатусыЦенныхБумаг
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага
		|					ИЗ
		|						ИсходнаяТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.Рынок = СтатусыЦенныхБумагСрезПоследних.Рынок
		|			И ИсходнаяТаблицаЦБ.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|			И (СтатусыЦенныхБумагСрезПоследних.Активен)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						Биржи.ЮрФизЛицо
		|					ИЗ
		|						Справочник.Биржи КАК Биржи
		|					ГДЕ
		|						Биржи.Ссылка В (&ДоступныеБиржи))) КАК РеквизитыЮрЛицаБиржи
		|		ПО (РеквизитыЮрЛицаБиржи.ЮрФизЛицо = СтатусыЦенныхБумагСрезПоследних.Биржа.ЮрФизЛицо)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	Эмитенты.Ссылка КАК Эмитент,
		|	Эмитенты.ЮрФизЛицо КАК ЮрЛицоЭмитента,
		|	Эмитенты.ДатаБанкротства КАК ДатаБанкротства,
		|	Эмитенты.ДатаБанкротства <> ДАТАВРЕМЯ(1, 1, 1)
		|		И Эмитенты.ДатаБанкротства <= &ДатаПереоценки КАК Банкрот
		|ПОМЕСТИТЬ ЭмитентыЦенныхБумаг
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Векселя КАК Векселя
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Векселя.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеРасписки КАК ДепозитарныеРасписки
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = ДепозитарныеРасписки.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = ИпотечныеСертификатыУчастия.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|		ПО (Эмитенты.Ссылка = ВЫБОР
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|					ТОГДА Акции.Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|					ТОГДА Облигации.Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|					ТОГДА Векселя.Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|					ТОГДА ДепозитарныеРасписки.Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|					ТОГДА ИпотечныеСертификатыУчастия.Эмитент
		|			КОНЕЦ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(Облигации.ДатаНачалаОбращения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаОбращения,
		|	ЕСТЬNULL(Облигации.ДатаНачалаРазмещения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаРазмещения,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, НЕОПРЕДЕЛЕНО) КАК ДатаПогашения,
		|	ЕСТЬNULL(Облигации.ДатаПогашения <> ДАТАВРЕМЯ(1, 1, 1)
		|			И Облигации.ДатаПогашения < ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -7), ЛОЖЬ) КАК СчитаемЧтоДефолт,
		|	ЕСТЬNULL(Облигации.ВалютаНоминала = &ВалютаРубли, ЛОЖЬ) КАК ОблигацияРублевая,
		|	ЕСТЬNULL(Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ), ЛОЖЬ) КАК ОблигацияОВОЗ,
		|	ЕСТЬNULL(Облигации.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств), ЛОЖЬ) КАК ОблигацияИнострГосударства,
		|	ЕСТЬNULL(Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|			И НЕ РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЕврооблигацияИнострЭмитента,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЭмитентРоссийский,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация), ЛОЖЬ) КАК ЭмитентМеждународнаяФинОрганизация,
		|	ЕСТЬNULL(ЭмитентыЦенныхБумаг.Банкрот, ЛОЖЬ) КАК ЭмитентБанкрот,
		|	ЭмитентыЦенныхБумаг.ДатаБанкротства КАК ЭмитентДатаБанкротства,
		|	ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента КАК Эмитент,
		|	_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК ОценкаПоАмортизированнойСтоимости
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ИСТИНА
