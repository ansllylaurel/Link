		|								КОГДА РАЗНОСТЬДАТ(&ДатаПереоценки, Уровень2_1ЦеныПоследнихСделок.ДатаПогашения, ГОД) <= 5
		|									ТОГДА ЗначенияБиржевыхИндексовНаДатуПоследнейСделки.БиржевойИндекс.Код = ""RUCBTR5Y""
		|								КОГДА РАЗНОСТЬДАТ(&ДатаПереоценки, Уровень2_1ЦеныПоследнихСделок.ДатаПогашения, ГОД) > 5
		|									ТОГДА ЗначенияБиржевыхИндексовНаДатуПоследнейСделки.БиржевойИндекс.Код = ""RUCBTR5Y""
		|								ИНАЧЕ ЛОЖЬ
		|							КОНЕЦ
		|					КОГДА Уровень2_1ЦеныПоследнихСделок.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|							И (Уровень2_1ЦеныПоследнихСделок.КатегорияОблигации = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная)
		|								ИЛИ Уровень2_1ЦеныПоследнихСделок.КатегорияОблигации = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Муниципальная))
		|							И Уровень2_1ЦеныПоследнихСделок.ДатаПогашения <> ДАТАВРЕМЯ(1, 1, 1)
		|						ТОГДА ВЫБОР
		|								КОГДА РАЗНОСТЬДАТ(&ДатаПереоценки, Уровень2_1ЦеныПоследнихСделок.ДатаПогашения, ГОД) = 0
		|									ТОГДА ЗначенияБиржевыхИндексовНаДатуПоследнейСделки.БиржевойИндекс.Код = ""RUMBITR1Y""
		|								КОГДА РАЗНОСТЬДАТ(&ДатаПереоценки, Уровень2_1ЦеныПоследнихСделок.ДатаПогашения, ГОД) <= 3
		|									ТОГДА ЗначенияБиржевыхИндексовНаДатуПоследнейСделки.БиржевойИндекс.Код = ""RUMBITR3Y""
		|								КОГДА РАЗНОСТЬДАТ(&ДатаПереоценки, Уровень2_1ЦеныПоследнихСделок.ДатаПогашения, ГОД) > 3
		|									ТОГДА ЗначенияБиржевыхИндексовНаДатуПоследнейСделки.БиржевойИндекс.Код = ""RUMBITR3+""
		|								ИНАЧЕ ЛОЖЬ
		|							КОНЕЦ
		|					ИНАЧЕ ЛОЖЬ
		|				КОНЕЦ)
		|				И Уровень2_1ЦеныПоследнихСделок.CLOSE_DATE = ЗначенияБиржевыхИндексовНаДатуПоследнейСделки.Период
		|		ПО ТаблицаЦБ.Рынок = Уровень2_1ЦеныПоследнихСделок.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = Уровень2_1ЦеныПоследнихСделок.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Уровень2_1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	Уровень2_1.Биржа КАК Биржа,
		|	Уровень2_1.Номинал КАК Номинал,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(Уровень2_1.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА Уровень2_1.СправедливаяЦена * Уровень2_1.Номинал / 100
		|		ИНАЧЕ Уровень2_1.СправедливаяЦена
		|	КОНЕЦ КАК Стоимость,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(Уровень2_1.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА Уровень2_1.ВалютаНоминала
		|		ИНАЧЕ Уровень2_1.ВалютаКотировки
		|	КОНЕЦ КАК ВалютаКотировки,
		|	Уровень2_1.ПолеКотировки КАК ВидЦены,
		|	Уровень2_1.ДатаКотировки КАК ДатаЦены,
		|	Уровень2_1.УровеньОценки КАК УровеньОценки,
		|	Уровень2_1.Рынок КАК Рынок,
		|	Биржи.ЮрФизЛицо КАК Источник
		|ИЗ
		|	Уровень2_1 КАК Уровень2_1
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО Уровень2_1.Биржа = Биржи.Ссылка";
		
	ПоследняяДатаТоргов = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки));
	ПоследнийРабочийДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский,НачалоДня(ДатаПереоценки));
	ТорговыхДнейНазад90 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -90);
	ТорговыхДнейНазад10 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -10);
	
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	Запрос.УстановитьПараметр("Организация", ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов", ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыОценки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад90", ТорговыхДнейНазад90);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10", ТорговыхДнейНазад10);
	Запрос.УстановитьПараметр("ММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	
	Запрос.УстановитьПараметр("Блумберг", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("Режим_BGN", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	
	Запрос.УстановитьПараметр("Рубли", ПараметрыОценки.Организация.ВалютаУчета);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);
	
	ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныТрадиции2019(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "ИсходнаяТаблицаЦБ");
	ПоместитьЦенныеБумагиДополненныеОсновнымиВыпускамиВМенеджерВременныхТаблиц(Запрос, "ИсходнаяТаблицаЦБ", "ОцениваемаяТаблицаЦБ");
	ПоместитьЭмитентовЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "ОцениваемаяТаблицаЦБ", "ЭмитентыЦенныхБумаг");
	ПоместитьСведенияОТоргахЦеннымиБумагамиВМенеджерВременныхТаблиц(Запрос, "ОцениваемаяТаблицаЦБ", ДатаПереоценки, 10, "_СведенияОТоргахЦеннымиБумагами");	
	ПоместитьТаблицуДатРасчетныхЦенПаевВМенеджерВременныхТаблиц(Запрос, "ИсходнаяТаблицаЦБ", ДатаПереоценки, "_ТаблицаДатРасчетныхЦенПаев");
	
	#Область Текст_запроса
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОцениваемаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОцениваемаяТаблицаЦБ.ОсновнойВыпуск КАК ОсновнойВыпуск,
		|	ОцениваемаяТаблицаЦБ.Рынок КАК Рынок,
		|	ОцениваемаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ОцениваемаяТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК ТоргуетсяНаММВБ,
		|	ЕСТЬNULL(НачалоПериодаРазмещения.Период, ДАТАВРЕМЯ(1, 1, 1)) КАК НачалоПериодаРазмещения,
		|	ЕСТЬNULL(КонецПериодаРазмещения.Период, ДАТАВРЕМЯ(1, 1, 1)) КАК КонецПериодаРазмещения,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПогашения,
		|	ЕСТЬNULL(Облигации.ДатаПогашения <> ДАТАВРЕМЯ(1, 1, 1)
		|			И Облигации.ДатаПогашения <= &ДатаПереоценки, ЛОЖЬ) КАК Погашена,
		|	ЕСТЬNULL(Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ)
		|			ИЛИ РеквизитыЮрЛицаЭмитента.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация)
		|			ИЛИ &ВключатьИностранныеЕврооблигацииВГруппуОВОЗРФиПрочее
		|				И Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|				И НЕ РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ОВОЗРФиПрочие,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЭмитентРоссийский,
		|	ЕСТЬNULL(ЭмитентыЦенныхБумаг.Банкрот, ЛОЖЬ) КАК ЭмитентБанкрот,
		|	ЭмитентыЦенныхБумаг.ДатаБанкротства КАК ЭмитентДатаБанкротства,
		|	ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента КАК Эмитент,
		|	_СведенияОТоргахЦеннымиБумагами.Дата КАК ПоследнийТорговыйДень
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ОцениваемаяТаблицаЦБ КАК ОцениваемаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						ОцениваемаяТаблицаЦБ.ЦеннаяБумага,
		|						ИСТИНА
		|					ИЗ
		|						ОцениваемаяТаблицаЦБ КАК ОцениваемаяТаблицаЦБ
		|					ГДЕ
		|						ОцениваемаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ОцениваемаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ОцениваемаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, Статус, Биржа, Рынок) В
		|					(ВЫБРАТЬ
		|						ОцениваемаяТаблицаЦБ.ЦеннаяБумага,
		|						ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже),
		|						&ММВБ,
		|						ОцениваемаяТаблицаЦБ.Рынок
		|					ИЗ
		|						ОцениваемаяТаблицаЦБ КАК ОцениваемаяТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО ОцениваемаяТаблицаЦБ.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, Статус, Биржа, Рынок, Активен) В
		|					(ВЫБРАТЬ
		|						ОцениваемаяТаблицаЦБ.ЦеннаяБумага,
		|						ЗНАЧЕНИЕ(Перечисление.ЖизненныйЦиклЦенныхБумаг.ВРазмещении),
		|						ЗНАЧЕНИЕ(Справочник.Биржи.ПустаяСсылка),
		|						ОцениваемаяТаблицаЦБ.Рынок,
		|						ИСТИНА
		|					ИЗ
		|						ОцениваемаяТаблицаЦБ КАК ОцениваемаяТаблицаЦБ)) КАК НачалоПериодаРазмещения
		|		ПО (НачалоПериодаРазмещения.ЦеннаяБумага = ОцениваемаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, Статус, Биржа, Рынок) В
		|					(ВЫБРАТЬ
		|						ОцениваемаяТаблицаЦБ.ЦеннаяБумага,
		|						ЗНАЧЕНИЕ(Перечисление.ЖизненныйЦиклЦенныхБумаг.ВРазмещении),
		|						ЗНАЧЕНИЕ(Справочник.Биржи.ПустаяСсылка),
		|						ОцениваемаяТаблицаЦБ.Рынок
		|					ИЗ
		|						ОцениваемаяТаблицаЦБ КАК ОцениваемаяТаблицаЦБ)) КАК КонецПериодаРазмещения
		|		ПО (КонецПериодаРазмещения.ЦеннаяБумага = ОцениваемаяТаблицаЦБ.ЦеннаяБумага)
		|			И (КонецПериодаРазмещения.Активен = ЛОЖЬ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЭмитентыЦенныхБумаг КАК ЭмитентыЦенныхБумаг
		|		ПО (ЭмитентыЦенныхБумаг.ЦеннаяБумага = ОцениваемаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента
		|					ИЗ
		|						ЭмитентыЦенныхБумаг)) КАК РеквизитыЮрЛицаЭмитента
		|		ПО (РеквизитыЮрЛицаЭмитента.ЮрФизЛицо = ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СведенияОТоргахЦеннымиБумагами КАК _СведенияОТоргахЦеннымиБумагами
		|		ПО (_СведенияОТоргахЦеннымиБумагами.ЦеннаяБумага = ОцениваемаяТаблицаЦБ.ЦеннаяБумага)
		|			И (_СведенияОТоргахЦеннымиБумагами.ТорговыхДнейНазад = 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	КотировкиТорговыхПлощадок.Период КАК Период,
		|	СУММА(КотировкиТорговыхПлощадок.NUMTRADES) КАК КоличествоСделок,
		|	СУММА(КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность) КАК ОбъемСделокВВалютеУчета,
		|	МАКСИМУМ(КотировкиТорговыхПлощадок.LEGALCLOSEPRICE) КАК ЦенаЗакрытия,
		|	МАКСИМУМ(КотировкиТорговыхПлощадок.CLOSE) КАК ЦенаПоследнейСделки
		|ПОМЕСТИТЬ ТоргиММВБЗаПоследние10ТорговыхДней
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СведенияОТоргахЦеннымиБумагами КАК _СведенияОТоргахЦеннымиБумагами
		|		ПО (_СведенияОТоргахЦеннымиБумагами.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.Рынок = ТаблицаЦБ.Рынок)
		|			И (КотировкиТорговыхПлощадок.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадок.Период = _СведенияОТоргахЦеннымиБумагами.Дата)
