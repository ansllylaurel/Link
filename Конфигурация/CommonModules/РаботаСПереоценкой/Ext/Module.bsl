		|	КОНЕЦ КАК ДатаКотировки,
		|	ВЫБОР
		|		КОГДА ЦеныММВБ_1Уровень.СправедливаяЦена > 0
		|			ТОГДА ЦеныММВБ_1Уровень.УровеньОценки
		|		КОГДА ЕСТЬNULL(РасчетныеЦеныНРДСрезПоследних.PRICE, 0) > 0
		|			ТОГДА 2
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УровеньОценки,
		|	ВЫБОР
		|		КОГДА ЦеныММВБ_1Уровень.СправедливаяЦена > 0
		|			ТОГДА ВЫБОР
		|					КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|						ТОГДА ТаблицаЦБ.ВалютаНоминала
		|					ИНАЧЕ ЦеныММВБ_1Уровень.ВалютаКотировки
		|				КОНЕЦ
		|		КОГДА ЕСТЬNULL(РасчетныеЦеныНРДСрезПоследних.PRICE, 0) > 0
		|			ТОГДА ТаблицаЦБ.ВалютаНоминала
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ВалютаКотировки,
		|	ВЫБОР
		|		КОГДА ЦеныММВБ_1Уровень.СправедливаяЦена > 0
		|			ТОГДА ЦеныММВБ_1Уровень.ИсточникКотировки
		|		КОГДА ЕСТЬNULL(РасчетныеЦеныНРДСрезПоследних.PRICE, 0) > 0
		|			ТОГДА &НРД
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ИсточникКотировки,
		|	ЦеныММВБ_1Уровень.МеждународныйВнебиржевойРынок КАК МеждународныйВнебиржевойРынок
		|ПОМЕСТИТЬ НРД_Уровень2
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЦеныММВБ_1Уровень КАК ЦеныММВБ_1Уровень
		|		ПО ТаблицаЦБ.Рынок = ЦеныММВБ_1Уровень.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = ЦеныММВБ_1Уровень.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|					ИЗ
		|						ТаблицаЦБ КАК ТаблицаЦБ)) КАК РасчетныеЦеныНРДСрезПоследних
		|		ПО ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныНРДСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НРД_Уровень2.ЦеннаяБумага КАК ЦеннаяБумага,
		|	НРД_Уровень2.Рынок КАК Рынок,
		|	НРД_Уровень2.Номинал КАК Номинал,
		|	НРД_Уровень2.ПолеКотировки КАК ВидЦены,
		|	НРД_Уровень2.ДатаКотировки КАК ДатаЦены,
		|	НРД_Уровень2.УровеньОценки КАК УровеньОценки,
		|	НРД_Уровень2.ИсточникКотировки КАК Источник,
		|	НРД_Уровень2.ВалютаКотировки КАК ВалютаКотировки,
		|	НРД_Уровень2.ВалютаНоминала КАК ВалютаНоминала,
		|	НРД_Уровень2.ВалютаКотировки КАК ВалютаКупона,
		|	ЕСТЬNULL(Биржи.Ссылка, ЗНАЧЕНИЕ(Справочник.Биржи.ПустаяСсылка)) КАК Биржа,
		|	НРД_Уровень2.СправедливаяЦена КАК Стоимость,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК ТоргуетсяНаММВБ
		|ИЗ
		|	НРД_Уровень2 КАК НРД_Уровень2
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО НРД_Уровень2.ИсточникКотировки = Биржи.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				Статус = ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже)
		|					И Биржа = &ММВБ
		|					И ЦеннаяБумага В
		|						(ВЫБРАТЬ
		|							ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|						ИЗ
		|							ТаблицаЦБ КАК ТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО НРД_Уровень2.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага";
	
	#КонецОбласти
	
	ИностранныеУчетныеАктивы		= Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();	
	ОсновнойКалендарьКотировок		= Константы.ОсновнойКалендарьКотировок.Получить();
	ПоследняяДатаТоргов				= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки));
	ТорговыхДнейНазад10				= Справочники.Календари.ДобавитьКДатеРабочиеДни(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки), -10);
	
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",			ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10",			ТорговыхДнейНазад10);
	Запрос.УстановитьПараметр("ММВБ",							ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("НРД", 							ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("ИностранныеУчетныеАктивы",		ИностранныеУчетныеАктивы);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены НПФ Национальный 2018 (ЕПС)", "Таблица стоимостей ЦБ");		
	КонецЕсли;
	
	ЗаполнитьНеоцененныеБумагиРасчетнымиЦенамиНационального2018(ПараметрыОценки, ДатаПереоценки, ТаблицаСтоимостейЦБ, Ложь, Ложь, РасшифровкаРасчета);
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныНационального2019(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, РасшифровкаРасчета = Неопределено)
	
	#Область Основной_запрос
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаСпискаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	ЕСТЬNULL(Облигации.ДатаНачалаОбращения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаОбращения,
		|	ЕСТЬNULL(Облигации.ДатаНачалаРазмещения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаРазмещения,
		|	ВЫБОР
		|		КОГДА Облигации.ДатаПогашения ЕСТЬ NULL
		|				ИЛИ Облигации.ДатаПогашения = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ Облигации.ДатаПогашения
		|	КОНЕЦ КАК ДатаПогашения
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.Банкротство)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК Банкротство,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ИсполнениеОферты)
		|					И ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.НеисполнениеОферты)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК НеисполнениеОферты,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.КупонныеВыплаты)
		|					И ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ДефотПоКупону,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации)
		|					И ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт)
		|				ТОГДА ИСТИНА
		|			КОГДА ТаблицаЦБ.ДатаПогашения <> НЕОПРЕДЕЛЕНО
		|				ТОГДА ВЫБОР
		|						КОГДА ТаблицаЦБ.ДатаПогашения < ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -7)
		|							ТОГДА ИСТИНА
		|						ИНАЧЕ ЛОЖЬ
		|					КОНЕЦ
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ДефолтПоТелу,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ТаблицаЦБ.УчетныйАктивЦБРФ В (&ИностранныеУчетныеАктивы)
		|				ТОГДА ВЫБОР
		|						КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|							ТОГДА ВЫБОР
		|									КОГДА ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|											ИЛИ ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗ)
		|											ИЛИ ТаблицаЦБ.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств)
		|											ИЛИ РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация)
		|										ТОГДА 2
		|									ИНАЧЕ 1
		|								КОНЕЦ
		|						ИНАЧЕ 1
		|					КОНЕЦ
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ВидЦеныБлумберга,
		|	ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо КАК ЮрФизЛицоЭмитента
		|ПОМЕСТИТЬ _Дефолты
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДефолтыПоОблигациям.СрезПоследних(
		|				&ДатаПереоценки,
		|				Облигация В
		|						(ВЫБРАТЬ
		|							ТаблицаЦБ.ЦеннаяБумага
		|						ИЗ
		|							ТаблицаЦБ КАК ТаблицаЦБ)
		|					И (ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.Банкротство)
		|						ИЛИ ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации)
		|						ИЛИ ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.КупонныеВыплаты)
		|						ИЛИ ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ИсполнениеОферты))) КАК ДефолтыПоОблигациямСрезПоследних
		|		ПО ТаблицаЦБ.ЦеннаяБумага = ДефолтыПоОблигациямСрезПоследних.Облигация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаЦБ.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаЦБ.Рынок КАК Рынок
		|ПОМЕСТИТЬ АктивныйРынокММВБ10Дней
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадок.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
		|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта)
		|			И (КурсыВалют.Период = &ДатаПереоценки)
		|ГДЕ
		|	КотировкиТорговыхПлощадок.Период >= &ТорговыхДнейНазад10
		|	И КотировкиТорговыхПлощадок.Период <= &ДатаПереоценки
		|	И КотировкиТорговыхПлощадок.Биржа = &ММВБ
		|
		|СГРУППИРОВАТЬ ПО
