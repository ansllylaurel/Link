		|		КОГДА КотировкиТорговыхПлощадок.WAPRICE > 0
		|			ТОГДА 1
		|		КОГДА КотировкиТорговыхПлощадок.LEGALCLOSEPRICE > 0
		|			ТОГДА 1
		|		КОГДА РасчетныеЦеныНРД.PRICE > 0
		|			ТОГДА 2
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УровеньОценки,
		|	После5.Номинал КАК Номинал,
		|	После5.ВалютаНоминала КАК ВалютаНоминала,
		|	После5.СтрокаТаблицыМетодики КАК СтрокаТаблицыМетодики
		|ПОМЕСТИТЬ После6
		|ИЗ
		|	После5 КАК После5
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.ЦеннаяБумага = После5.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Период = &ПоследняяДатаТоргов)
		|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадок.WAPRICE > 0
		|				ИЛИ КотировкиТорговыхПлощадок.LEGALCLOSEPRICE > 0)
		|			И (После5.СтрокаТаблицыМетодики = 6)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
		|		ПО (РасчетныеЦеныНРД.ЦеннаяБумага = После5.ЦеннаяБумага)
		|			И (РасчетныеЦеныНРД.Период = &ПоследняяДатаТоргов)
		|			И (После5.СтрокаТаблицыМетодики = 6)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	После6.ЦеннаяБумага КАК ЦеннаяБумага,
		|	После6.Рынок КАК Рынок,
		|	После6.Стоимость КАК Стоимость,
		|	После6.ВалютаКотировки КАК ВалютаКотировки,
		|	После6.Источник КАК Источник,
		|	После6.ВидЦены КАК ВидЦены,
		|	После6.ДатаЦены КАК ДатаЦены,
		|	После6.УровеньОценки КАК УровеньОценки,
		|	После6.Номинал КАК Номинал,
		|	После6.ВалютаНоминала КАК ВалютаНоминала
		|ИЗ
		|	После6 КАК После6";
	
	#КонецОбласти	
	
	ДоступныДанныеRUData = (ДатаПереоценки < '20220928');
	
	ММВБ		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	НРД			= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");
	Интерфакс	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Интерфакс");
	
	ПоследняяДатаТоргов = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(), НачалоДня(ДатаПереоценки));
	
	Запрос.УстановитьПараметр("ДатаПереоценки",			?(ДатаПереоценки < '20200327', ПоследняяДатаТоргов, ДатаПереоценки));
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",	?(ДатаПереоценки < '20220228' ИЛИ ДатаПереоценки >= '20221231', ПоследняяДатаТоргов, НачалоДня(ДатаПереоценки)));
	
	Запрос.УстановитьПараметр("ММВБ",					ММВБ);
	Запрос.УстановитьПараметр("НРД",					НРД);
	
	Запрос.УстановитьПараметр("Интерфакс",				Интерфакс);
	Запрос.УстановитьПараметр("ИсточникДанныхRUDIP",	ОбщегоНазначения.ПолучитьИменованныйОбъект("RUData_RUDIP"));
	Запрос.УстановитьПараметр("ИсточникДанныхRUDATA65",	ОбщегоНазначения.ПолучитьИменованныйОбъект("RUData_Ebonds"));
	Запрос.УстановитьПараметр("ИсточникДанныхTRAX",		ОбщегоНазначения.ПолучитьИменованныйОбъект("RUData_TRAX"));
	Запрос.УстановитьПараметр("ДоступныДанныеRUData",	ДоступныДанныеRUData);	
	
	Запрос.УстановитьПараметр("ВалютаРубли",			ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, , "Таблица стоимостей ЦБ");		
	КонецЕсли;
	
	// Расчетные цены 	
	
	ВыполненРасчетЦены = Ложь;	
	
	ЦенныеБумагиОцениваемыеПоЦенамRUDataДляУведомления = Новый Массив;
	
	Если ДатаПереоценки >= '20220228' Тогда
		
		// Расчет цен
		
		ПараметрыДенежногоПотока = Новый Структура;
		ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",	Ложь);
		ПараметрыДенежногоПотока.Вставить("Дата",				ДатаПереоценки);
		ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",		КонецДня(ДатаПереоценки));

		ПараметрыРасчетаРейтинга			= Неопределено;
		ПараметрыРасчетаКредитногоСпреда	= Неопределено;
		
		Для Каждого СтрокаСтоимости Из ТаблицаСтоимостейЦБ Цикл
			
			Если ЗначениеЗаполнено(СтрокаСтоимости.ВидЦены) Тогда
				
				Продолжить;
				
			ИначеЕсли СтрокаСтоимости.Источник = Интерфакс И Не ДоступныДанныеRUData Тогда // Уведомим, что не хватает цен RU Data	
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Ошибка расчета цены '%1': на %2 отсутствуют цены RU Data", СтрокаСтоимости.ЦеннаяБумага, Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy")));
					
				ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимости);
				Продолжить;
				
			КонецЕсли;
				
			Если СтрокаСтоимости.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				
				ЦенаЗаполнена = ЗаполнитьДисконтированнойПоБезрисковойСтавкеДоходностиСтоимостью(СтрокаСтоимости, ПараметрыОценки, ДатаПереоценки, ПараметрыДенежногоПотока, , 2, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, , Отказ, РасшифровкаРасчета);
				
				Если ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;

	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "После расчета цен", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныГазфонда(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
		
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "ИсходнаяТаблицаЦБ");
	ПоместитьБумагиОцениваемыеПоАмортизированнойСтоимостиВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки, ДатаПереоценки, "ИсходнаяТаблицаЦБ");
	ПоместитьОценкиПоНоминалуДляПогашенныхЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления, ДатаПереоценки);
	
	#Область Основной_запрос	
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ1
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Акции.ОсновнойВыпуск,
		|	Акции.ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок,
		|	Акции.УчетныйАктивЦБРФ
		|ИЗ
		|	Справочник.Акции КАК Акции
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ПО (ИсходнаяТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка)
		|ГДЕ
		|	Акции.ОсновнойВыпуск <> ЗНАЧЕНИЕ(Справочник.Акции.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ1.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ1.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ1.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ВЫБОР
		|		КОГДА ИсходнаяТаблицаЦБ1.УчетныйАктивЦБРФ В (&БумагиНерезидентов)
		|			ТОГДА ЛОЖЬ
		|		КОГДА ИсходнаяТаблицаЦБ1.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА Облигации.Подкатегория = &ОВОЗ
		|						ТОГДА ЛОЖЬ
		|					КОГДА Облигации.ВалютаНоминала <> &ВалютаРубли
		|						ТОГДА ЛОЖЬ
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЦБРФ,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, НЕОПРЕДЕЛЕНО) КАК ДатаПогашения,
		|	_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК ОценкаПоАмортизированнойСтоимости
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ1 КАК ИсходнаяТаблицаЦБ1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ1.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ1.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _БумагиОцениваемыеПоАмортизированнойСтоимости КАК _БумагиОцениваемыеПоАмортизированнойСтоимости
		|		ПО (_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага = ИсходнаяТаблицаЦБ1.ЦеннаяБумага)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.Период КАК Период,
		|	КотировкиТорговыхПлощадок.Валюта КАК Валюта,
		|	КотировкиТорговыхПлощадок.РежимТоргов КАК РежимТоргов,
		|	СУММА(КотировкиТорговыхПлощадок.NUMTRADES) КАК КоличествоСделок,
		|	СУММА(КотировкиТорговыхПлощадок.VALUE) КАК ОбъемСделок,
		|	СУММА(КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность) КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ КотировкиММВБЗаПоследние10ТорговыхДней
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.Рынок = ТаблицаЦБ.Рынок)
		|			И (КотировкиТорговыхПлощадок.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадок.Период МЕЖДУ &ТорговыхДнейНазад10 И &ДатаПереоценки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта)
		|			И (КотировкиТорговыхПлощадок.Период = КурсыВалют.Период)
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.Период,
		|	КотировкиТорговыхПлощадок.Валюта,
		|	КотировкиТорговыхПлощадок.РежимТоргов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиММВБЗаПоследние10ТорговыхДней.Период КАК Период,
		|	СУММА(КотировкиММВБЗаПоследние10ТорговыхДней.КоличествоСделок) КАК КоличествоСделок,
		|	СУММА(КотировкиММВБЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета) КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ ИтогиММВБЗаПоследние10ТорговыхДней
		|ИЗ
		|	КотировкиММВБЗаПоследние10ТорговыхДней КАК КотировкиММВБЗаПоследние10ТорговыхДней
		|
		|СГРУППИРОВАТЬ ПО
		|	КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага,
		|	КотировкиММВБЗаПоследние10ТорговыхДней.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	&ММВБ КАК Биржа,
		|	СделкиЗаПоследние10ТорговыхДней.КоличествоСделок КАК КоличествоСделок,
		|	СделкиЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ АктивныйРынокММВБПоОбъемуСделок
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ИтогиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага КАК ЦеннаяБумага,
		|			СУММА(ИтогиММВБЗаПоследние10ТорговыхДней.КоличествоСделок) КАК КоличествоСделок,
		|			СУММА(ИтогиММВБЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета) КАК ОбъемСделокВВалютеУчета,
		|			МАКСИМУМ(ВЫБОР
		|					КОГДА ИтогиММВБЗаПоследние10ТорговыхДней.Период = &ПоследняяДатаТоргов
		|						ТОГДА ИтогиММВБЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета
		|				КОНЕЦ) КАК ОбъемСделокВПоследнийТорговыйДень
		|		ИЗ
		|			ИтогиММВБЗаПоследние10ТорговыхДней КАК ИтогиММВБЗаПоследние10ТорговыхДней
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ИтогиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага) КАК СделкиЗаПоследние10ТорговыхДней
		|		ПО (СделкиЗаПоследние10ТорговыхДней.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (СделкиЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета >= 500000)
		|			И (СделкиЗаПоследние10ТорговыхДней.КоличествоСделок >= 10)
		|			И (СделкиЗаПоследние10ТорговыхДней.ОбъемСделокВПоследнийТорговыйДень > 0
		|				ИЛИ НЕ &ПроверятьОбъемСделокАктивногоРынкаВПоследнийТорговыйДень)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
