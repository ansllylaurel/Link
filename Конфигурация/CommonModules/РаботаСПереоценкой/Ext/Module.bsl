		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.Номинал КАК Номинал,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(_ОцененныеБумаги.СправедливаяЦена * _ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|			ИНАЧЕ _ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(_ОцененныеБумаги.Валюта, 0) КАК Валюта,
		|	ЕСТЬNULL(_ОцененныеБумаги.ВалютаКотировки, 0) КАК ВалютаКотировки,
		|	ЕСТЬNULL(_ОцененныеБумаги.ВидЦены, 0) КАК ВидЦены,
		|	ЕСТЬNULL(_ОцененныеБумаги.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(_ОцененныеБумаги.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, ЕСТЬNULL(_ОцененныеБумаги.Источник, 0)) КАК Источник,
		|	0 КАК Купон,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаКупона,
		|	_ТаблицаЦБ.НоминированаВРублях КАК НоминированаВРублях,
		|	_ТаблицаЦБ.ЭмитентРоссийский КАК ЭмитентРоссийский
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОцененныеБумаги КАК _ОцененныеБумаги
		|		ПО (_ОцененныеБумаги.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (Биржи.Ссылка = _ОцененныеБумаги.Источник)";

	#КонецОбласти	
	
	ММВБ	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	НРД		= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");
	
	ТорговыхДнейНазад10		= Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(), НачалоДня(ДатаПереоценки), -10);
	ПоследнийТорговыйДень	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(), НачалоДня(ДатаПереоценки));
	ДатаЦенНРД				= НачалоДня(ДатаПереоценки);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ",				ТаблицаЦБ);
	
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10",			ТорговыхДнейНазад10);
	Запрос.УстановитьПараметр("ПоследнийТорговыйДень",			ПоследнийТорговыйДень);
	Запрос.УстановитьПараметр("ДатаПереоценки",					НачалоДня(ДатаПереоценки));
	Запрос.УстановитьПараметр("ДатаЦенНРД",						ДатаЦенНРД);
	
	Запрос.УстановитьПараметр("ММВБ",							ММВБ);
	Запрос.УстановитьПараметр("НРД",							НРД);
	Запрос.УстановитьПараметр("ВалютаРубли",					ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));

	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены СЧА ЗПИФк ФДЦБ 2021", "Предварительная таблица стоимостей ЦБ");		
	КонецЕсли;
	
	Если ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;
	
	// Расчетные цены
	
	ВыполненРасчетЦены = Ложь;
	
	Если ДатаПереоценки >= '20230403' Тогда
		ПараметрыОценки.Вставить("ТочностьКБД", 2);
	КонецЕсли;
	
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	
	ЦеныНРДНаДатуОценки = Неопределено;
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления, , СтрокаСтоимостейЦБ.ВалютаКупона);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены) Тогда
			Продолжить;
		КонецЕсли;
		
		// Расчет цены
		
		ОшибкаРасчета = Ложь;
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации
			И СтрокаСтоимостейЦБ.ЭмитентРоссийский И СтрокаСтоимостейЦБ.НоминированаВРублях
		Тогда
					
			#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков 
			
			ЦенаЗаполнена = ЗаполнитьДисконтированнойПоБезрисковойСтавкеДоходностиСтоимостью(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, ПараметрыДенежногоПотока, Истина, 2, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, 4, ОшибкаРасчета, РасшифровкаРасчета);
		
			Если ОшибкаРасчета Тогда
				Отказ = Истина;
				Продолжить;
			ИначеЕсли ЦенаЗаполнена Тогда
				ВыполненРасчетЦены = Истина;
				Продолжить;
			КонецЕсли;
			
			#КонецОбласти
			
			#Область Расчетные_цены_3_уровня_по_методике_НРД_после_2018_года					
			
			Если ЦеныНРДНаДатуОценки = Неопределено Тогда
				ЦеныНРДНаДатуОценки = ПолучитьЦеныНРД(ТаблицаСтоимостейЦБ, ДатаЦенНРД, РасшифровкаРасчета);
			КонецЕсли;
			
			ЦеныНРДТекущейЦБ = ЦеныНРДНаДатуОценки.Скопировать(Новый Структура("ЦеннаяБумага, VERSION, METHOD_NUMBER", СтрокаСтоимостейЦБ.ЦеннаяБумага, "2", "3")); 
			
			Если ЦеныНРДТекущейЦБ.Количество() > 0 Тогда

				СтрокаСтоимостейЦБ.Стоимость		= ЦеныНРДТекущейЦБ[0].Цена;
				СтрокаСтоимостейЦБ.ДатаЦены			= ЦеныНРДТекущейЦБ[0].ДатаЦены;
				СтрокаСтоимостейЦБ.УровеньОценки	= 3;
				СтрокаСтоимостейЦБ.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД;
				СтрокаСтоимостейЦБ.Источник			= НРД;
				СтрокаСтоимостейЦБ.ВалютаКотировки	= СтрокаСтоимостейЦБ.ВалютаНоминала;

				ВыполненРасчетЦены = Истина;
				Продолжить;
				
			КонецЕсли;
			
			#КонецОбласти
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "Таблица стоимостей ЦБ", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;	
	
КонецФункции

Функция ПолучитьЦеныПИФ2021(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ТаблицаСпискаЦБ");
	ПоместитьСведенияОТоргахЦеннымиБумагамиВМенеджерВременныхТаблиц(Запрос, "_ТаблицаСпискаЦБ", ДатаПереоценки, 10, "_СведенияОТоргахЦеннымиБумагами");
	ПоместитьСтатусыЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "_ТаблицаСпискаЦБ");
	ПоместитьЭмитентовЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "_ТаблицаСпискаЦБ");	
	
	ЕдиныйПорядокОпределенияКупона = (ДатаПереоценки >= '20220729');
	
	Если ЕдиныйПорядокОпределенияКупона Тогда
		ПоместитьКотировкиКупоновВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, ПараметрыОценки.ВариантРасчетаСправедливойСтоимости, "_ТаблицаСпискаЦБ", "_КотировкиКупонов");
	КонецЕсли;
	
	#Область Основной_запрос	
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Облигации.Ссылка КАК Ссылка,
		|	Облигации.Категория КАК Категория,
		|	Облигации.Подкатегория КАК Подкатегория,
		|	Облигации.Оригинатор КАК КонечныйЗаемщик
		|ПОМЕСТИТЬ _РеквизитыОблигаций
		|ИЗ
		|	_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ТаблицаСпискаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ИностранныеУчетныеАктивы
		|ИЗ
		|	_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
		|ГДЕ
		|	_ТаблицаСпискаЦБ.УчетныйАктивЦБРФ В(&ИностранныеУчетныеАктивы)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаСпискаЦБ.Рынок КАК Рынок
		|ПОМЕСТИТЬ _ИсключенияИзИностранныхУчетныхАктивов
		|ИЗ
		|	_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЭмитентыЦенныхБумаг КАК _ЭмитентыЦенныхБумаг
		|		ПО (_ЭмитентыЦенныхБумаг.ЦеннаяБумага = _ТаблицаСпискаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОценки,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента
		|					ИЗ
		|						_ЭмитентыЦенныхБумаг)) КАК РеквизитыЭмитента
		|		ПО (_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента = РеквизитыЭмитента.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыОблигаций КАК Облигация
		|		ПО (Облигация.Ссылка = _ТаблицаСпискаЦБ.ЦеннаяБумага)
		|ГДЕ
		|	(_ТаблицаСпискаЦБ.УчетныйАктивЦБРФ В (ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ВекселяИностранногоГосударства))
		|			ИЛИ РеквизитыЭмитента.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация)
		|			ИЛИ _ТаблицаСпискаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				И Облигация.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|				И НЕ РеквизитыЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка))
		|			ИЛИ _ТаблицаСпискаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				И Облигация.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	_ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА _ИсключенияИзИностранныхУчетныхАктивов.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|			ТОГДА ""ОВОЗРФиДР""
		|		КОГДА _ИностранныеУчетныеАктивы.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|			ТОГДА ""ИностранныеЦБ""
		|		ИНАЧЕ ""РоссийскиеЦБ""
		|	КОНЕЦ КАК ВидАктива,
		|	_СведенияОТоргахЦеннымиБумагами.Дата КАК ПоследнийТорговыйДень
		|ПОМЕСТИТЬ _ВидыАктивов
		|ИЗ
		|	_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ИностранныеУчетныеАктивы КАК _ИностранныеУчетныеАктивы
		|		ПО _ТаблицаСпискаЦБ.ЦеннаяБумага = _ИностранныеУчетныеАктивы.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ИсключенияИзИностранныхУчетныхАктивов КАК _ИсключенияИзИностранныхУчетныхАктивов
		|		ПО _ТаблицаСпискаЦБ.ЦеннаяБумага = _ИсключенияИзИностранныхУчетныхАктивов.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СведенияОТоргахЦеннымиБумагами КАК _СведенияОТоргахЦеннымиБумагами
		|		ПО (_СведенияОТоргахЦеннымиБумагами.ЦеннаяБумага = _ТаблицаСпискаЦБ.ЦеннаяБумага)
		|			И (_СведенияОТоргахЦеннымиБумагами.ТорговыхДнейНазад = 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Биржи.Ссылка КАК Биржа,
		|	РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)) КАК РоссийскаяБиржа
		|ПОМЕСТИТЬ _ДоступныеБиржи
		|ИЗ
		|	Справочник.Биржи КАК Биржи
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОценки,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						Биржи.ЮрФизЛицо
		|					ИЗ
		|						Справочник.Биржи КАК Биржи
		|					ГДЕ
		|						Биржи.Ссылка В (&ДоступныеБиржи))) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО Биржи.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	Биржи.Ссылка В(&ДоступныеБиржи)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(Котировки_Bloomberg_BGN.ЦеннаяБумага, Котировки_Bloomberg_BVAL.ЦеннаяБумага) КАК ЦеннаяБумага,
		|	ЕСТЬNULL(Котировки_Bloomberg_BGN.Рынок, Котировки_Bloomberg_BVAL.Рынок) КАК Рынок,
		|	ЕСТЬNULL(Котировки_Bloomberg_BGN.Биржа, Котировки_Bloomberg_BVAL.Биржа) КАК Биржа,
		|	ЕСТЬNULL(Котировки_Bloomberg_BGN.РежимТоргов, Котировки_Bloomberg_BVAL.РежимТоргов) КАК РежимТоргов
		|ПОМЕСТИТЬ _КотировкиБлумберг
		|ИЗ
		|	_ВидыАктивов КАК _ВидыАктивов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК Котировки_Bloomberg_BGN
		|		ПО _ВидыАктивов.Рынок = Котировки_Bloomberg_BGN.Рынок
		|			И _ВидыАктивов.ЦеннаяБумага = Котировки_Bloomberg_BGN.ЦеннаяБумага
		|			И (Котировки_Bloomberg_BGN.Период = &ДатаОценки)
		|			И (Котировки_Bloomberg_BGN.Биржа = &Блумберг)
		|			И (Котировки_Bloomberg_BGN.РежимТоргов = &Режим_BGN)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК Котировки_Bloomberg_BVAL
		|		ПО _ВидыАктивов.Рынок = Котировки_Bloomberg_BVAL.Рынок
		|			И _ВидыАктивов.ЦеннаяБумага = Котировки_Bloomberg_BVAL.ЦеннаяБумага
		|			И (Котировки_Bloomberg_BVAL.Период = &ДатаОценки)
		|			И (Котировки_Bloomberg_BVAL.Биржа = &Блумберг)
		|			И (Котировки_Bloomberg_BVAL.РежимТоргов = &Режим_BVAL)
		|ГДЕ
		|	_ВидыАктивов.ВидАктива В (""ИностранныеЦБ"", ""ОВОЗРФиДР"")
		|	И ЕСТЬNULL(Котировки_Bloomberg_BGN.CLOSE, Котировки_Bloomberg_BVAL.CLOSE) <> 0
		|	И &ДоступныДанныеBloomberg
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КотировкиТорговыхПлощадок.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.Рынок КАК Рынок,
		|	КотировкиТорговыхПлощадок.Биржа КАК Биржа,
		|	_ДоступныеБиржи.РоссийскаяБиржа КАК РоссийскаяБиржа
		|ПОМЕСТИТЬ _РынкиВКоторыхЕстьЦенаВДеньОценки
		|ИЗ
		|	_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ВидыАктивов КАК _ВидыАктивов
		|		ПО (_ВидыАктивов.ЦеннаяБумага = _ТаблицаСпискаЦБ.ЦеннаяБумага)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДоступныеБиржи КАК _ДоступныеБиржи
		|			ПО (_ДоступныеБиржи.Биржа = КотировкиТорговыхПлощадок.Биржа)
		|		ПО (КотировкиТорговыхПлощадок.ЦеннаяБумага = _ТаблицаСпискаЦБ.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Рынок = _ТаблицаСпискаЦБ.Рынок)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадок.Период = &ДатаОценки)
		|			И (КотировкиТорговыхПлощадок.BID <> 0
		|					И (КотировкиТорговыхПлощадок.BID МЕЖДУ КотировкиТорговыхПлощадок.LOW И КотировкиТорговыхПлощадок.HIGH)
		|				ИЛИ КотировкиТорговыхПлощадок.LEGALCLOSEPRICE <> 0
		|					И КотировкиТорговыхПлощадок.VOLUME <> 0
		|				ИЛИ КотировкиТорговыхПлощадок.WAPRICE <> 0)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СтатусыЦенныхБумаг КАК _ТоргуетсяНаБирже
		|		ПО (_ТоргуетсяНаБирже.ЦеннаяБумага = _ТаблицаСпискаЦБ.ЦеннаяБумага)
		|			И (_ТоргуетсяНаБирже.Биржа = _ДоступныеБиржи.Биржа)
		|			И (_ТоргуетсяНаБирже.Статус = ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже))
		|ГДЕ
		|	(_ВидыАктивов.ВидАктива = ""ИностранныеЦБ""
		|			ИЛИ _ДоступныеБиржи.РоссийскаяБиржа
		|				И _ТоргуетсяНаБирже.ЦеннаяБумага ЕСТЬ НЕ NULL )
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиТорговыхПлощадок.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.Рынок КАК Рынок,
		|	КотировкиТорговыхПлощадок.Биржа КАК Биржа,
