		|						ТОГДА ИсходнаяТаблицаЦБ.Количество * ЦБУровень1_ДоУсловия3АктивногоРынка.СправедливаяЦена * ВЫБОР
		|								КОГДА РАЗНОСТЬДАТ(АктивныйРынок3Условие1.ДатаТ0, &ДатаПереоценки, МЕСЯЦ) >= 6
		|									ТОГДА 0.2
		|								ИНАЧЕ 0.2 * РАЗНОСТЬДАТ(АктивныйРынок3Условие1.ДатаТ0, &ДатаПереоценки, ДЕНЬ) / (365 / 2)
		|							КОНЕЦ <= АктивныйРынок3Условие1.ОбъемТоргов
		|					КОГДА АктивныйРынок3Условие1.Рынок = &Облигации
		|							И (АктивныйРынок3Условие1.КатегорияОблигации <> ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная)
		|								И АктивныйРынок3Условие1.КатегорияОблигации <> ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная)
		|								И АктивныйРынок3Условие1.КатегорияОблигации <> ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Муниципальная))
		|							И АктивныйРынок3Условие1.Критерий1
		|						ТОГДА ИсходнаяТаблицаЦБ.Количество * ЦБУровень1_ДоУсловия3АктивногоРынка.СправедливаяЦена * ВЫБОР
		|								КОГДА РАЗНОСТЬДАТ(АктивныйРынок3Условие1.ДатаТ0, &ДатаПереоценки, МЕСЯЦ) >= 6
		|									ТОГДА 0.3
		|								ИНАЧЕ 0.3 * РАЗНОСТЬДАТ(АктивныйРынок3Условие1.ДатаТ0, &ДатаПереоценки, ДЕНЬ) / (365 / 2)
		|							КОНЕЦ <= АктивныйРынок3Условие1.ОбъемТоргов
		|					КОГДА АктивныйРынок3Условие1.Рынок = &Облигации
		|							И АктивныйРынок3Условие1.Критерий2
		|						ТОГДА ИсходнаяТаблицаЦБ.Количество * ЦБУровень1_ДоУсловия3АктивногоРынка.СправедливаяЦена * ВЫБОР
		|								КОГДА РАЗНОСТЬДАТ(АктивныйРынок3Условие1.ДатаТ0, &ДатаПереоценки, МЕСЯЦ) >= 6
		|									ТОГДА 1
		|								ИНАЧЕ 1 * РАЗНОСТЬДАТ(АктивныйРынок3Условие1.ДатаТ0, &ДатаПереоценки, ДЕНЬ) / (365 / 2)
		|							КОНЕЦ <= АктивныйРынок3Условие1.ОбъемТоргов
		|					ИНАЧЕ ЛОЖЬ
		|				КОНЕЦ
		|			ТОГДА 1
		|		КОГДА ЦБУровень1_ДоУсловия3АктивногоРынка.СправедливаяЦена > 0
		|			ТОГДА 2
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УровеньОценки,
		|	ЦБУровень1_ДоУсловия3АктивногоРынка.Валюта КАК Валюта
		|ПОМЕСТИТЬ ЦБУровень1
		|ИЗ
		|	ЦБУровень1_ДоУсловия3АктивногоРынка КАК ЦБУровень1_ДоУсловия3АктивногоРынка
		|		ЛЕВОЕ СОЕДИНЕНИЕ АктивныйРынок3Условие1 КАК АктивныйРынок3Условие1
		|		ПО ЦБУровень1_ДоУсловия3АктивногоРынка.ЦеннаяБумага = АктивныйРынок3Условие1.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ПО ЦБУровень1_ДоУсловия3АктивногоРынка.Рынок = ИсходнаяТаблицаЦБ.Рынок
		|			И ЦБУровень1_ДоУсловия3АктивногоРынка.ЦеннаяБумага = ИсходнаяТаблицаЦБ.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦБУровень1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЦБУровень1.Рынок КАК Рынок,
		|	ЦБУровень1.Биржа КАК Биржа,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЦБУровень1.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ЦБУровень1.СправедливаяЦена * ЦБУровень1.Номинал / 100
		|		ИНАЧЕ ЦБУровень1.СправедливаяЦена
		|	КОНЕЦ КАК Стоимость,
		|	ЦБУровень1.Номинал КАК Номинал,
		|	ЦБУровень1.ПолеКотировки КАК ВидЦены,
		|	ЦБУровень1.ДатаКотировки КАК ДатаЦены,
		|	Биржи.ЮрФизЛицо КАК Источник,
		|	ЦБУровень1.УровеньОценки КАК УровеньОценки,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЦБУровень1.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА Облигации.ВалютаНоминала
		|		ИНАЧЕ ЦБУровень1.Валюта
		|	КОНЕЦ КАК ВалютаКотировки
		|ИЗ
		|	ЦБУровень1 КАК ЦБУровень1
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО ЦБУровень1.Биржа = Биржи.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ЦБУровень1.ЦеннаяБумага = Облигации.Ссылка
		|ГДЕ
		|	ЦБУровень1.СправедливаяЦена <> 0";
		
	ПоследняяДатаТоргов = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки));
		
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	Запрос.УстановитьПараметр("Организация", ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов", ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыОценки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Акции", Перечисления.РынкиЦенныхБумаг.Акции);
	Запрос.УстановитьПараметр("Облигации", Перечисления.РынкиЦенныхБумаг.Облигации);
	Запрос.УстановитьПараметр("Паи", Перечисления.РынкиЦенныхБумаг.Паи);
	Запрос.УстановитьПараметр("ММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);
	
	
	ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныСтройкомплекса(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, РасшифровкаРасчета = Неопределено) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(Облигации.ДатаНачалаОбращения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаОбращения,
		|	ЕСТЬNULL(Облигации.ДатаНачалаРазмещения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаРазмещения
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|;
		|"+"
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	КотировкиЦенныхБумаг.Рынок КАК Рынок,
		|	КотировкиЦенныхБумаг.Биржа КАК Биржа,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КотировкиЦенныхБумаг.Период) КАК КоличествоКотировок
		|ПОМЕСТИТЬ АктивныйРынокММВБ30Дней
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиЦенныхБумаг
		|		ПО ТаблицаЦБ.Рынок = КотировкиЦенныхБумаг.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиЦенныхБумаг.ЦеннаяБумага
		|			И (КотировкиЦенныхБумаг.РежимТоргов.ОсновнойРежим)
		|ГДЕ
		|	КотировкиЦенныхБумаг.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|	И КотировкиЦенныхБумаг.Период <= &ДатаПереоценки
		|	И (КотировкиЦенныхБумаг.NUMTRADES > 0
		|			ИЛИ КотировкиЦенныхБумаг.BID > 0)
		|	И КотировкиЦенныхБумаг.Биржа = &ММВБ
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал,
		|	КотировкиЦенныхБумаг.Рынок,
		|	КотировкиЦенныхБумаг.Биржа
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КотировкиЦенныхБумаг.Период) > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АктивныйРынокММВБ30Дней.ЦеннаяБумага КАК ЦеннаяБумага,
		|	АктивныйРынокММВБ30Дней.Номинал КАК Номинал,
		|	АктивныйРынокММВБ30Дней.КоличествоКотировок КАК КоличествоКотировок,
		|	АктивныйРынокММВБ30Дней.Рынок КАК Рынок,
		|	АктивныйРынокММВБ30Дней.Биржа КАК Биржа,
		|	СУММА(КотировкиЦенныхБумаг.NUMTRADES) КАК NUMTRADES,
		|	СУММА(КотировкиЦенныхБумаг.VALUE) КАК VALUE
		|ПОМЕСТИТЬ АктивыйРынокММВБОбъемТорговПоКоличеству
		|ИЗ
		|	АктивныйРынокММВБ30Дней КАК АктивныйРынокММВБ30Дней
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиЦенныхБумаг
		|		ПО АктивныйРынокММВБ30Дней.ЦеннаяБумага = КотировкиЦенныхБумаг.ЦеннаяБумага
		|			И АктивныйРынокММВБ30Дней.Рынок = КотировкиЦенныхБумаг.Рынок
		|			И АктивныйРынокММВБ30Дней.Биржа = КотировкиЦенныхБумаг.Биржа
		|			И (КотировкиЦенныхБумаг.РежимТоргов.ОсновнойРежим)
		|ГДЕ
		|	КотировкиЦенныхБумаг.Период >= &РабочихДнейНазад10
		|	И КотировкиЦенныхБумаг.Период <= &ДатаПереоценки
		|	И КотировкиЦенныхБумаг.Биржа = &ММВБ
		|
		|СГРУППИРОВАТЬ ПО
		|	АктивныйРынокММВБ30Дней.ЦеннаяБумага,
		|	АктивныйРынокММВБ30Дней.Номинал,
		|	АктивныйРынокММВБ30Дней.КоличествоКотировок,
		|	АктивныйРынокММВБ30Дней.Рынок,
		|	АктивныйРынокММВБ30Дней.Биржа
		|
		|ИМЕЮЩИЕ
		|	СУММА(КотировкиЦенныхБумаг.NUMTRADES) >= 10
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АктивыйРынокММВБОбъемТорговПоКоличеству.ЦеннаяБумага КАК ЦеннаяБумага,
		|	АктивыйРынокММВБОбъемТорговПоКоличеству.Номинал КАК Номинал,
		|	АктивыйРынокММВБОбъемТорговПоКоличеству.КоличествоКотировок КАК КоличествоКотировок,
		|	АктивыйРынокММВБОбъемТорговПоКоличеству.Рынок КАК Рынок,
		|	АктивыйРынокММВБОбъемТорговПоКоличеству.Биржа КАК Биржа,
		|	СУММА(КотировкиЦенныхБумаг.NUMTRADES) КАК NUMTRADES,
		|	СУММА(КотировкиЦенныхБумаг.VALUE) КАК VALUE
		|ПОМЕСТИТЬ АктивыйРынокММВБОбъемТоргов
		|ИЗ
		|	АктивыйРынокММВБОбъемТорговПоКоличеству КАК АктивыйРынокММВБОбъемТорговПоКоличеству
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиЦенныхБумаг
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|			ПО КотировкиЦенныхБумаг.Валюта = КурсыВалют.Валюта
		|				И (КурсыВалют.Период = &ДатаПереоценки)
		|		ПО АктивыйРынокММВБОбъемТорговПоКоличеству.ЦеннаяБумага = КотировкиЦенныхБумаг.ЦеннаяБумага
		|			И АктивыйРынокММВБОбъемТорговПоКоличеству.Рынок = КотировкиЦенныхБумаг.Рынок
		|			И АктивыйРынокММВБОбъемТорговПоКоличеству.Биржа = КотировкиЦенныхБумаг.Биржа
		|			И (КотировкиЦенныхБумаг.РежимТоргов.ОсновнойРежим)
		|ГДЕ
		|	КотировкиЦенныхБумаг.Период >= &РабочихДнейНазад10
		|	И КотировкиЦенныхБумаг.Период <= &ДатаПереоценки
		|	И КотировкиЦенныхБумаг.Биржа = &ММВБ
		|
		|СГРУППИРОВАТЬ ПО
		|	АктивыйРынокММВБОбъемТорговПоКоличеству.ЦеннаяБумага,
		|	АктивыйРынокММВБОбъемТорговПоКоличеству.Номинал,
		|	АктивыйРынокММВБОбъемТорговПоКоличеству.КоличествоКотировок,
		|	АктивыйРынокММВБОбъемТорговПоКоличеству.Рынок,
		|	АктивыйРынокММВБОбъемТорговПоКоличеству.Биржа
		|
		|ИМЕЮЩИЕ
		|	СУММА(КотировкиЦенныхБумаг.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность) >= 500000
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""Т.к. кроме ММВБ других котировок нет, то выбор основного рынка пока не делаем"" КАК Поле1,
		|	АктивыйРынокММВБОбъемТоргов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	АктивыйРынокММВБОбъемТоргов.Номинал КАК Номинал,
		|	АктивыйРынокММВБОбъемТоргов.Рынок КАК Рынок,
		|	АктивыйРынокММВБОбъемТоргов.Биржа КАК Биржа
		|ПОМЕСТИТЬ ОсновныеРынкиЦБ
		|ИЗ
		|	АктивыйРынокММВБОбъемТоргов КАК АктивыйРынокММВБОбъемТоргов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОсновныеРынкиЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОсновныеРынкиЦБ.Рынок КАК Рынок,
		|	ОсновныеРынкиЦБ.Биржа КАК Биржа,
		|	МАКСИМУМ(КотировкиЦенныхБумаг.Период) КАК Период,
		|	ОсновныеРынкиЦБ.Номинал КАК Номинал
		|ПОМЕСТИТЬ ОтборКотировокПоОбъемуСделок
		|ИЗ
		|	ОсновныеРынкиЦБ КАК ОсновныеРынкиЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиЦенныхБумаг
