		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФк_ФДЦБ
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2018 И ДатаПереоценки < '20190401'
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2018 И ДатаПереоценки < '20190401'		
	Тогда
		
		ПараметрыРасчетаКредитногоСпреда.Вставить("ОтклонениеКредитногоСпреда", 0);

	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом
		И ПараметрыОценки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар")
	Тогда

		ПараметрыРасчетаКредитногоСпреда.Вставить("ВариантРасчетаКредитногоСпреда", "РазностьИндексовЧистыхЦенГосударственныхИКорпоративныхОблигаций");			

	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Не удалось получить параметры расчета кредитного спреда по методике '%1' на %2",
				ПараметрыОценки.ВариантРасчетаСправедливойСтоимости, Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy")), , , , Отказ);	
		
	КонецЕсли;	
	
	// Кредитный спред последней рейтинговой группы определяется как значение кредитного спреда предыдущей рейтинговой группы, ...

	Если ПараметрыРасчетаКредитногоСпреда.Свойство("ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы")
		И ПараметрыРасчетаКредитногоСпреда.ВариантРасчетаКредитногоСпредаПоследнейРейтинговойГруппы = "ПоЗначениюПредыдущейРейтинговойГруппы"
	Тогда
	
		Если ПараметрыОценки.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Газфонд") Тогда
			Если ДатаПереоценки >= '20191101' Тогда 
				ПараметрыРасчетаКредитногоСпреда.Вставить("ОтклонениеКредитногоСпредаПоследнейРейтинговойГруппы", 13); // ... увеличенное на 13 базисных пунктов (#285777)
			Иначе 
				ПараметрыРасчетаКредитногоСпреда.Вставить("ОтклонениеКредитногоСпредаПоследнейРейтинговойГруппы", 10); // ... увеличенное на 10 базисных пунктов (#259787)
			КонецЕсли;
		КонецЕсли;
	
		Если ДатаПереоценки >= '20200506' И ПараметрыОценки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФОПФ") Тогда
			ПараметрыРасчетаКредитногоСпреда.Вставить("ОтклонениеКредитногоСпредаПоследнейРейтинговойГруппы", 13);  // ... увеличенное на 13 базисных пунктов (#317054)
		КонецЕсли;
		
		Если ДатаПереоценки >= '20210603' И ПараметрыОценки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФВолгаКапитал") Тогда
			ПараметрыРасчетаКредитногоСпреда.Вставить("ОтклонениеКредитногоСпредаПоследнейРейтинговойГруппы", 748); // ... увеличенное на 748 базисных пунктов (#380050)
		КонецЕсли;
		
		Если ДатаПереоценки >= '20221019'
			И (ПараметрыОценки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Атомфонд")
				ИЛИ ПараметрыОценки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Атомгарант"))
		Тогда
			ПараметрыРасчетаКредитногоСпреда.Вставить("ОтклонениеКредитногоСпредаПоследнейРейтинговойГруппы", 25); // ... увеличенное на 25 базисных пунктов (#452166)
		КонецЕсли;
		
	КонецЕсли;
	
	// Премии за субординированность
	
	ПараметрыРасчетаКредитногоСпреда.Вставить("ПремииЗаСубординированность", ПолучитьПремииЗаСубординированность(ПараметрыОценки.Клиент, ДатаПереоценки));
	
	Возврат ПараметрыРасчетаКредитногоСпреда;
	
КонецФункции

Функция ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, ЦеннаяБумага = Неопределено, Отказ = Ложь) Экспорт
	
	ПараметрыДенежногоПотока = Новый Структура;
	
	Если ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_Нефтегарант2018 И ДатаПереоценки >= '20200101'
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Федерация И ДатаПереоценки < '20200101'
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Перспектива2020
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Эволюция2021
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Эволюция2021_2
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФк_ФДЦБ2021
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Югория
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Югория2022
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Доверие
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020 И ДатаПереоценки >= '20210101'
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Гефест
	Тогда
	
		ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",								Ложь);
		ПараметрыДенежногоПотока.Вставить("Дата",											ДатаПереоценки);
		ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",									КонецДня(ДатаПереоценки));
		ПараметрыДенежногоПотока.Вставить("УчитыватьИзмененениеКупонаСНаступленияПериода",	Истина);		
		
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2020 
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Ростех Тогда
		
		ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",								Ложь);
		ПараметрыДенежногоПотока.Вставить("Дата",											ДатаПереоценки);
		ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",									КонецДня(ДатаПереоценки));
		ПараметрыДенежногоПотока.Вставить("ВариантРасчетаКупонаКОферте",					"ОтПрогнозногоЗначенияСтавки");
		ПараметрыДенежногоПотока.Вставить("ОбъединятьПотокиПоПериоду",						Истина);	

	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ППА2018 И ДатаПереоценки >= '20200101' Тогда
		
		УчитыватьКупонКОферте = ?(ДатаПереоценки >= '20200707', "УчитыватьКупонТолькоПриОбъявленнойСтавке", Истина);
		
		ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",								Ложь);
		ПараметрыДенежногоПотока.Вставить("Дата",											ДатаПереоценки);
		ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",									КонецДня(ДатаПереоценки));
		ПараметрыДенежногоПотока.Вставить("УчитыватьКупонКОферте",							УчитыватьКупонКОферте);
		
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Федерация И ДатаПереоценки >= '20200101'
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Федерация2021
	Тогда

		УчитыватьКупонКОферте = Истина;	
		
		Если ДатаПереоценки >= '20200217' Тогда
			РеквизитыОблигации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЦеннаяБумага, "Тип, БазоваяСтавка");
			Если РеквизитыОблигации.Тип = Перечисления.ТипыОблигаций.КупоннаяПК И Не ЗначениеЗаполнено(РеквизитыОблигации.БазоваяСтавка) Тогда
				УчитыватьКупонКОферте = "УчитыватьКупонТолькоПриОбъявленнойСтавке";	
			КонецЕсли;
		КонецЕсли;
		
		ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",								Ложь);
		ПараметрыДенежногоПотока.Вставить("Дата",											ДатаПереоценки);
		ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",									КонецДня(ДатаПереоценки));
		ПараметрыДенежногоПотока.Вставить("УчитыватьКупонКОферте",							УчитыватьКупонКОферте);
		ПараметрыДенежногоПотока.Вставить("УчитыватьИзмененениеКупонаСНаступленияПериода",	Истина);
		
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ХантыМансийский2020 Тогда
		
		УчитыватьКупонКОферте = Истина;	
		
		Если ДатаПереоценки >= '20200527' Тогда
			РеквизитыОблигации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЦеннаяБумага, "Тип, БазоваяСтавка");
			Если РеквизитыОблигации.Тип = Перечисления.ТипыОблигаций.КупоннаяПК Тогда
				УчитыватьКупонКОферте = "УчитыватьКупонТолькоПриОбъявленнойСтавке";	
			КонецЕсли;
		КонецЕсли;
		
		ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",								Ложь);
		ПараметрыДенежногоПотока.Вставить("Дата",											ДатаПереоценки);
		ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",									КонецДня(ДатаПереоценки));
		ПараметрыДенежногоПотока.Вставить("УчитыватьКупонКОферте",							УчитыватьКупонКОферте);
		ПараметрыДенежногоПотока.Вставить("УчитыватьИзмененениеКупонаСНаступленияПериода",	Истина);
		
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПФР2020 Тогда
		
		УчитыватьКупонКОферте = Истина;
		
		Если ДатаПереоценки >= '20200801' Тогда
		 	РеквизитыОблигации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЦеннаяБумага, "Тип, БазоваяСтавка");
			Если РеквизитыОблигации.Тип = Перечисления.ТипыОблигаций.КупоннаяПК И Не ЗначениеЗаполнено(РеквизитыОблигации.БазоваяСтавка) Тогда
				УчитыватьКупонКОферте = "УчитыватьКупонТолькоПриОбъявленнойСтавке";
			КонецЕсли;
		КонецЕсли;
		
		ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",		Ложь);
		ПараметрыДенежногоПотока.Вставить("Дата",					ДатаПереоценки);
		ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",			КонецДня(ДатаПереоценки));
		ПараметрыДенежногоПотока.Вставить("УчитыватьКупонКОферте",	УчитыватьКупонКОферте);
		
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Газфонд
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФк_ФДЦБ
	Тогда
		
		ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",								Ложь);
		ПараметрыДенежногоПотока.Вставить("Дата",											ДатаПереоценки);
		ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",									КонецДня(ДатаПереоценки));
		ПараметрыДенежногоПотока.Вставить("УчитыватьИзмененениеКупонаСНаступленияПериода",	ДатаПереоценки >= '20200101');	
		
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ОПК2018
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Аквилон
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Стройкомплекс2018
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2018
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2019
	Тогда
	
		// Прогнать контроль СЧА по методикам, поставив округление купона - может просто не расходились.
		// Пример расчетной цены без округления купона к оферте у НПФ СТРОЙКОМПЛЕКС ПН АО за 31.10.2018,
		// но там заведено профсуждение, правда, без приоритетной цены.
		// #Техдолг
		
		ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",								Ложь);
		ПараметрыДенежногоПотока.Вставить("Дата",											ДатаПереоценки);
		ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",									КонецДня(ДатаПереоценки));
		ПараметрыДенежногоПотока.Вставить("ТочностьОкругления",								Неопределено);
		
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Большой
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020_2
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Стройкомплекс2021		
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Аквилон2021
	Тогда
		
		ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",								Ложь);
		ПараметрыДенежногоПотока.Вставить("Дата",											ДатаПереоценки);
		ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",									КонецДня(ДатаПереоценки));
		ПараметрыДенежногоПотока.Вставить("ОбъединятьПотокиПоПериоду",						Истина);	
		
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Традиция2019
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2018
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2018
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2018		
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Сургутнефтегаз2020
