КонецПроцедуры

#КонецОбласти

#Область Получить_ценные_бумаги

Процедура ПолучитьЦенныеБумаги(ОбъектДокумента, МенеджерВременныхТаблиц, ИмяТаблицы, ПараметрыПолученияПартий = Неопределено, РасчетПартий = Неопределено, ТаблицаПлановыхОпераций = Неопределено, РасшифровкаРасчета = Неопределено, ПоВидамОстатков = Ложь) Экспорт

	Если ПараметрыПолученияПартий = Неопределено Тогда
		ПараметрыПолученияПартий = Новый Структура;
		ПараметрыПолученияПартий.Вставить("УчестьПартииКПолучению", Ложь);
		ПараметрыПолученияПартий.Вставить("УчестьБумагиТПлюс", Ложь);
		ПараметрыПолученияПартий.Вставить("УчестьБумагиПоРЕПО", Ложь);
		ПараметрыПолученияПартий.Вставить("УчестьСрочныеКонтракты", Ложь);
		ПараметрыПолученияПартий.Вставить("КоличественныйРасчет", Ложь);
	ИначеЕсли Не ПараметрыПолученияПартий.Свойство("КоличественныйРасчет") Тогда 
		ПараметрыПолученияПартий.Вставить("КоличественныйРасчет", Ложь);
	КонецЕсли;
	
	Если ТипЗнч(ОбъектДокумента.Ссылка) = Тип("ДокументСсылка.РегистрацияСтоимостиПереоценки") Тогда
		//переоценка - на конец дня
		ПолучитьОстаткиНа = Новый Граница(КонецДня(ОбъектДокумента.Дата), ВидГраницы.Включая);
	Иначе
		// на момент ДО документа 
		ПолучитьОстаткиНа = Новый Граница(ОбъектДокумента.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	Если ОбъектДокумента.ЦельРасчета.ТолькоДляФиксацииСтоимостиОценки Тогда
		ПолучитьЦенныеБумагиДляСЧА(ОбъектДокумента, МенеджерВременныхТаблиц, ИмяТаблицы, ПараметрыПолученияПартий, РасчетПартий, ТаблицаПлановыхОпераций, ПолучитьОстаткиНа, РасшифровкаРасчета, ПоВидамОстатков);
	Иначе
		ПолучитьЦенныеБумагиДляЕПС(ОбъектДокумента, МенеджерВременныхТаблиц, ИмяТаблицы, ПолучитьОстаткиНа, РасшифровкаРасчета);
	КонецЕсли;	
	
	Если ОбъектДокумента.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ПФР_Траст")
		ИЛИ ОбъектДокумента.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ПФР_РЭМ")	
	Тогда

	    НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(ОбъектДокумента.Дата, ОбъектДокумента.Организация, ОбъектДокумента.СчетДоверительногоУправления, ОбъектДокумента.ЦельРасчета, Истина);
	
		Если НастройкиОценки.ВыполнятьРасчетПоУказаниюЦБ5419 ИЛИ НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316 Тогда
	
			#Область Динамический_расчет_партий_по_FIFO	
			
			Отказ = Ложь;
			
			СчетДляУчета = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления);
			
			НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
				КонецДня(ОбъектДокумента.Дата),
				ОбъектДокумента.Организация,
				СчетДляУчета,
				ОбъектДокумента.ВидУчета,
				Отказ);
				
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
			
			Если НастройкиПоВидуУчета.МетодОценкиСтоимости = Перечисления.МетодыОценкиСтоимости.ПоСреднему Тогда
				
				// партии принудительно рассчитаем по FIFO как минимум с даты "заморозки",
				// либо с даты запрета редактирования партий, если она стоит раньше
				
				Если НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316 Тогда
					НачалоЗаморозкиСтоимости = '20220218';
				ИначеЕсли НастройкиОценки.ВыполнятьРасчетПоУказаниюЦБ5419 Тогда
					НачалоЗаморозкиСтоимости = '20200301';
				КонецЕсли;
				
				НастройкиПоВидуУчета.МетодОценкиСтоимости = Перечисления.МетодыОценкиСтоимости.ФИФО;
				
				#Область Получение_даты_запрета_редактирования_партий
				
				ЗапросДатыЗапрета = Новый Запрос(
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования
					|ИЗ
					|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
					|ГДЕ
					|	ДатыЗапретаРедактирования.Организация = &Организация
					|	И ДатыЗапретаРедактирования.СчетДоверительногоУправления = &СчетДоверительногоУправления
					|	И ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии)
					|	И ДатыЗапретаРедактирования.ВидУчета = &ВидУчета");
				
				ЗапросДатыЗапрета.УстановитьПараметр("Организация",                  ОбъектДокумента.Организация);
				ЗапросДатыЗапрета.УстановитьПараметр("СчетДоверительногоУправления", СчетДляУчета);
				ЗапросДатыЗапрета.УстановитьПараметр("ВидУчета",                     ОбъектДокумента.ВидУчета);
				
				ВыборкаДатыЗапрета = ЗапросДатыЗапрета.Выполнить().Выбрать();
				Если ВыборкаДатыЗапрета.Следующий() Тогда
					ДатаЗапретаРедактированияПартий = ВыборкаДатыЗапрета.ДатаЗапретаРедактирования;
				Иначе
					ДатаЗапретаРедактированияПартий = Дата(1, 1, 1);
				КонецЕсли;
				
				Если ДатаЗапретаРедактированияПартий < НачалоЗаморозкиСтоимости Тогда
					ВызватьИсключение "Для оценки бумаг по указанию ЦБ РФ дата запрета редактирования не должна быть меньше " + Формат(НачалоЗаморозкиСтоимости, "ДФ=dd.MM.yyyy");
				КонецЕсли;
				
				#КонецОбласти
				
				ПараметрыДинамическогоРасчетаПартий = Новый Структура;
				ПараметрыДинамическогоРасчетаПартий.Вставить("Организация", 					ОбъектДокумента.Организация);
				ПараметрыДинамическогоРасчетаПартий.Вставить("СчетДоверительногоУправления", 	СчетДляУчета);
				ПараметрыДинамическогоРасчетаПартий.Вставить("ВидУчета", 						ОбъектДокумента.ВидУчета);
				ПараметрыДинамическогоРасчетаПартий.Вставить("НачалоПериода", 					НачалоЗаморозкиСтоимости);
				ПараметрыДинамическогоРасчетаПартий.Вставить("КонецПериода", 					КонецДня(ОбъектДокумента.Дата));
				ПараметрыДинамическогоРасчетаПартий.Вставить("ТаблицаПлановыхОпераций", 		Неопределено);
				ПараметрыДинамическогоРасчетаПартий.Вставить("ОбъектДокумента", 				ОбъектДокумента);
				ПараметрыДинамическогоРасчетаПартий.Вставить("НастройкиПоВидуУчета",			НастройкиПоВидуУчета);
				ПараметрыДинамическогоРасчетаПартий.Вставить("КоличественныйРасчет",			ПараметрыПолученияПартий.КоличественныйРасчет);
				
				РасчетПартийФИФО = ДинамическийРасчетПартий(ПараметрыДинамическогоРасчетаПартий);
				
				МенеджерВременныхТаблицФИФО = Новый МенеджерВременныхТаблиц;
				
				Если ОбъектДокумента.ЦельРасчета.ТолькоДляФиксацииСтоимостиОценки Тогда
					
					ПолучитьЦенныеБумагиДляСЧА(ОбъектДокумента, МенеджерВременныхТаблицФИФО, ИмяТаблицы, ПараметрыПолученияПартий, РасчетПартийФИФО, ТаблицаПлановыхОпераций, ПолучитьОстаткиНа, РасшифровкаРасчета, ПоВидамОстатков);
					
				Иначе
					
					ПараметрыПолученияПартийПоСреднему = Новый Структура;
					ПараметрыПолученияПартийПоСреднему.Вставить("УчестьПартииКПолучению",	Истина);
					ПараметрыПолученияПартийПоСреднему.Вставить("УчестьБумагиТПлюс",		Ложь);
					ПараметрыПолученияПартийПоСреднему.Вставить("УчестьБумагиПоРЕПО",		Истина);
					ПараметрыПолученияПартийПоСреднему.Вставить("УчестьСрочныеКонтракты",	Ложь);					
					
					ПолучитьЦенныеБумагиДляСЧА(ОбъектДокумента, МенеджерВременныхТаблицФИФО, ИмяТаблицы, ПараметрыПолученияПартийПоСреднему, РасчетПартийФИФО, ТаблицаПлановыхОпераций, ПолучитьОстаткиНа, РасшифровкаРасчета, Ложь);		
					
				КонецЕсли;
				
				Если НастройкиОценки.ВыполнятьРасчетПоУказаниюЦБ5419 Тогда
					ПодменямыеБумаги = РаботаСПереоценкой.ЦенныеБумагиСРасчетомСтоимостиВСоответствииСУказаниемЦБРФ5419У(ОбъектДокумента.СчетДоверительногоУправления);
				Иначе
					ПодменямыеБумаги = Неопределено;
				КонецЕсли;

				ЗапросПодменыПартий = Новый Запрос;
				ЗапросПодменыПартий.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
				ЗапросПодменыПартий.УстановитьПараметр("ПодменямыеБумаги",	 ПодменямыеБумаги);
				ЗапросПодменыПартий.УстановитьПараметр("ПодменятьВсеБумаги", Не ЗначениеЗаполнено(ПодменямыеБумаги));
				
				// Подмена партий "_КонечныеОстаткиПартий"
				
				Если ОбъектДокумента.ЦельРасчета.ТолькоДляФиксацииСтоимостиОценки Тогда
					
					ЗапросПодменыПартий.УстановитьПараметр("КонечныеОстаткиПартий", МенеджерВременныхТаблицФИФО.Таблицы["_КонечныеОстаткиПартий"].ПолучитьДанные().Выгрузить());
					
					ЗапросПодменыПартий.Текст = 
					    "ВЫБРАТЬ РАЗРЕШЕННЫЕ * ПОМЕСТИТЬ _КонечныеОстаткиПартий_ФИФО ИЗ &КонечныеОстаткиПартий КАК КонечныеОстаткиПартий;
						|						
						|ВЫБРАТЬ РАЗРЕШЕННЫЕ * ПОМЕСТИТЬ _КонечныеОстаткиПартий_Врем ИЗ _КонечныеОстаткиПартий;
						|
						|УНИЧТОЖИТЬ _КонечныеОстаткиПартий;
						|
						|ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	_КонечныеОстаткиПартий_Врем.*,
						|	ЕСТЬNULL(_КонечныеОстаткиПартий_ФИФО.Партия, НЕОПРЕДЕЛЕНО) КАК Партия,
						|	ЕСТЬNULL(_КонечныеОстаткиПартий_ФИФО.СтрокаПартии, 0) КАК СтрокаПартии,
						|	ЕСТЬNULL(_КонечныеОстаткиПартий_ФИФО.Количество, _КонечныеОстаткиПартий_Врем.Количество) КАК Количество,
					    |	ЕСТЬNULL(_КонечныеОстаткиПартий_ФИФО.СуммаРезервовПодОбесценение, _КонечныеОстаткиПартий_Врем.СуммаРезервовПодОбесценение) КАК СуммаРезервовПодОбесценение
						|ПОМЕСТИТЬ _КонечныеОстаткиПартий
						|ИЗ
						|	_КонечныеОстаткиПартий_Врем КАК _КонечныеОстаткиПартий_Врем
						|	ЛЕВОЕ СОЕДИНЕНИЕ _КонечныеОстаткиПартий_ФИФО КАК _КонечныеОстаткиПартий_ФИФО
						|	ПО _КонечныеОстаткиПартий_ФИФО.ЦеннаяБумага = _КонечныеОстаткиПартий_Врем.ЦеннаяБумага
						|		И (&ПодменятьВсеБумаги
						|			ИЛИ _КонечныеОстаткиПартий_ФИФО.ЦеннаяБумага В (&ПодменямыеБумаги))
						|		И &ПоВидамОстатков
						|;
						|
						|УНИЧТОЖИТЬ _КонечныеОстаткиПартий_Врем;
						|УНИЧТОЖИТЬ _КонечныеОстаткиПартий_ФИФО"; 
					
					Если ПоВидамОстатков Тогда
						ЗапросПодменыПартий.Текст = СтрЗаменить(ЗапросПодменыПартий.Текст, "&ПоВидамОстатков",
							"	_КонечныеОстаткиПартий_ФИФО.КПоступлению = _КонечныеОстаткиПартий_Врем.КПоступлению 
							|	И _КонечныеОстаткиПартий_ФИФО.ПоРЕПО = _КонечныеОстаткиПартий_Врем.ПоРЕПО");
					Иначе
						ЗапросПодменыПартий.Текст = СтрЗаменить(ЗапросПодменыПартий.Текст, "&ПоВидамОстатков", "ИСТИНА");	
					КонецЕсли;
					
					ЗапросПодменыПартий.Выполнить();
					
				Иначе
					
					// Без _КонечныеОстаткиПартий для ЕПС, БУ и НУ в РаботаСПереоценкой.ЗаполнитьЦенныеБумаги все равно берет из регистров
					
					ЗапросПодменыПартий.УстановитьПараметр("КонечныеОстаткиПартий", МенеджерВременныхТаблицФИФО.Таблицы["_КонечныеОстаткиПартий"].ПолучитьДанные().Выгрузить());
					
					ЗапросПодменыПартий.Текст = 
					    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					    |	КонечныеОстаткиПартий.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
					    |	КонечныеОстаткиПартий.Рынок КАК Рынок,
					    |	КонечныеОстаткиПартий.ЦеннаяБумага КАК ЦеннаяБумага,
					    |	КонечныеОстаткиПартий.Количество КАК Количество,
					    |	КонечныеОстаткиПартий.СуммаРезервовПодОбесценение КАК СуммаРезервовПодОбесценение,
					    |	ВЫБОР
					    |		КОГДА &ПодменятьВсеБумаги
					    |				ИЛИ КонечныеОстаткиПартий.ЦеннаяБумага В (&ПодменямыеБумаги)
					    |			ТОГДА КонечныеОстаткиПартий.Партия
					    |		ИНАЧЕ НЕОПРЕДЕЛЕНО
					    |	КОНЕЦ КАК Партия,
					    |	ВЫБОР
					    |		КОГДА &ПодменятьВсеБумаги
					    |				ИЛИ КонечныеОстаткиПартий.ЦеннаяБумага В (&ПодменямыеБумаги)
					    |			ТОГДА КонечныеОстаткиПартий.СтрокаПартии
					    |		ИНАЧЕ НЕОПРЕДЕЛЕНО
					    |	КОНЕЦ КАК СтрокаПартии
					    |ПОМЕСТИТЬ _КонечныеОстаткиПартий_Врем
					    |ИЗ
					    |	&КонечныеОстаткиПартий КАК КонечныеОстаткиПартий
					    |;
					    |
					    |////////////////////////////////////////////////////////////////////////////////
					    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
					    |	_КонечныеОстаткиПартий_Врем.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
					    |	_КонечныеОстаткиПартий_Врем.Рынок КАК Рынок,
					    |	_КонечныеОстаткиПартий_Врем.ЦеннаяБумага КАК ЦеннаяБумага,
					    |	_КонечныеОстаткиПартий_Врем.Партия КАК Партия,
					    |	_КонечныеОстаткиПартий_Врем.СтрокаПартии КАК СтрокаПартии,
					    |	СУММА(_КонечныеОстаткиПартий_Врем.Количество) КАК Количество,
					    |	СУММА(_КонечныеОстаткиПартий_Врем.СуммаРезервовПодОбесценение) КАК СуммаРезервовПодОбесценение
					    |ПОМЕСТИТЬ _КонечныеОстаткиПартий
					    |ИЗ
					    |	_КонечныеОстаткиПартий_Врем КАК _КонечныеОстаткиПартий_Врем
					    |
					    |СГРУППИРОВАТЬ ПО
					    |	_КонечныеОстаткиПартий_Врем.ЦеннаяБумага,
					    |	_КонечныеОстаткиПартий_Врем.Партия,
					    |	_КонечныеОстаткиПартий_Врем.СтрокаПартии,
					    |	_КонечныеОстаткиПартий_Врем.УчетныйАктивЕПС,
					    |	_КонечныеОстаткиПартий_Врем.Рынок
					    |;
					    |
					    |////////////////////////////////////////////////////////////////////////////////
					    |УНИЧТОЖИТЬ _КонечныеОстаткиПартий_Врем";
					
					ЗапросПодменыПартий.Выполнить();

				КонецЕсли;
				
				ЗапросПодменыПартий.УстановитьПараметр(ИмяТаблицы, МенеджерВременныхТаблицФИФО.Таблицы[ИмяТаблицы].ПолучитьДанные().Выгрузить());
				
				ЗапросПодменыПартий.Текст = 
				    "ВЫБРАТЬ РАЗРЕШЕННЫЕ * ПОМЕСТИТЬ _ИмяТаблицы_ФИФО ИЗ &ИмяТаблицы КАК ИмяТаблицы;
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ * ПОМЕСТИТЬ _ИмяТаблицы_Врем ИЗ ИмяТаблицы;
					|УНИЧТОЖИТЬ ИмяТаблицы;
					|
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_ИмяТаблицы_Врем.*,
					|	ЕСТЬNULL(_ИмяТаблицы_ФИФО.Партия, НЕОПРЕДЕЛЕНО) КАК Партия,
					|	ЕСТЬNULL(_ИмяТаблицы_ФИФО.СтрокаПартии, 0) КАК СтрокаПартии,
					|	ЕСТЬNULL(_ИмяТаблицы_ФИФО.Количество, _ИмяТаблицы_Врем.Количество) КАК Количество,
					|	ЕСТЬNULL(_ИмяТаблицы_ФИФО.СуммаРезервовПодОбесценение, _ИмяТаблицы_Врем.СуммаРезервовПодОбесценение) КАК СуммаРезервовПодОбесценение
					|ПОМЕСТИТЬ ИмяТаблицы
					|ИЗ
					|	_ИмяТаблицы_Врем КАК _ИмяТаблицы_Врем
					|	ЛЕВОЕ СОЕДИНЕНИЕ _ИмяТаблицы_ФИФО КАК _ИмяТаблицы_ФИФО
					|	ПО _ИмяТаблицы_ФИФО.ЦеннаяБумага = _ИмяТаблицы_Врем.ЦеннаяБумага
					|		И (&ПодменятьВсеБумаги
					|			ИЛИ _ИмяТаблицы_ФИФО.ЦеннаяБумага В (&ПодменямыеБумаги))
					|;
					|
					|УНИЧТОЖИТЬ _ИмяТаблицы_Врем;
					|УНИЧТОЖИТЬ _ИмяТаблицы_ФИФО"; 
				
				ЗапросПодменыПартий.Текст = СтрЗаменить(ЗапросПодменыПартий.Текст, "ИмяТаблицы", ИмяТаблицы);			
								
				ЗапросПодменыПартий.Выполнить();
				
			КонецЕсли;
			
			#КонецОбласти

		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьЦенныеБумагиДляСЧА(ОбъектДокумента, МенеджерВременныхТаблиц, ИмяТаблицы, ПараметрыПолученияПартий, РасчетПартий, ТаблицаПлановыхОпераций, ПолучитьОстаткиНа, РасшифровкаРасчета = Неопределено, ПоВидамОстатков)

	УчестьПартииКПолучению 	= ПараметрыПолученияПартий.УчестьПартииКПолучению;
	УчестьБумагиТПлюс 		= ПараметрыПолученияПартий.УчестьБумагиТПлюс;
	УчестьБумагиПоРЕПО 		= ПараметрыПолученияПартий.УчестьБумагиПоРЕПО;
	УчестьСрочныеКонтракты 	= ПараметрыПолученияПартий.УчестьСрочныеКонтракты;
	
	СчетДляУчета = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления);	
	
	Если ОбъектДокумента.ЦельРасчета.ТолькоДляФиксацииСтоимостиОценки И РасчетПартий = Неопределено Тогда	
		
		// Иногда для целей оценки мы начинаем рассчитывать стоимости до того, как рассчитаны бух. партии ценных бумаг,
		//   ибо расчет партий процесс долгий и сложный, т.к. включает в себя переоценки, которые делает только бухгалтерия.
		//   От партий нам нужны же только количества. Чтобы не быть зависимыми от бухгалтерии мы запустим эмуляцию расчета 
		//   партий сами. Датой начала периода расчета при этом возьмем дату запрета редактирования по соответствующему
		//   виду учета, ибо ничего другого всё равно пока нет
		
		#Область Контроль_даты_запрета
		
		ЗапросДатыЗапрета = Новый Запрос;
		ЗапросДатыЗапрета.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования
			|ИЗ
			|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
			|ГДЕ
			|	ДатыЗапретаРедактирования.Организация = &Организация
			|	И ДатыЗапретаРедактирования.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии)
			|	И ДатыЗапретаРедактирования.ВидУчета = &ВидУчета";
		
		ЗапросДатыЗапрета.УстановитьПараметр("Организация",                  ОбъектДокумента.Организация);
		ЗапросДатыЗапрета.УстановитьПараметр("СчетДоверительногоУправления", СчетДляУчета);
		ЗапросДатыЗапрета.УстановитьПараметр("ВидУчета",                     ОбъектДокумента.ВидУчета);
		
		Выборка = ЗапросДатыЗапрета.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ДатаЗапретаРедактированияПартий = Выборка.ДатаЗапретаРедактирования;
		Иначе
			ДатаЗапретаРедактированияПартий = Дата(1, 1, 1);
		КонецЕсли;
		
		#КонецОбласти 
		
		Если КонецДня(ДатаЗапретаРедактированияПартий) < КонецДня(ОбъектДокумента.Дата) Тогда 
			
			#Область Динамический_расчет_партий
			
			ПараметрыДинамическогоРасчетаПартий = Новый Структура;
			ПараметрыДинамическогоРасчетаПартий.Вставить("Организация", 					ОбъектДокумента.Организация);
			ПараметрыДинамическогоРасчетаПартий.Вставить("СчетДоверительногоУправления", 	СчетДляУчета);
			ПараметрыДинамическогоРасчетаПартий.Вставить("ВидУчета", 						ОбъектДокумента.ВидУчета);
			ПараметрыДинамическогоРасчетаПартий.Вставить("НачалоПериода", 					НачалоДня(ДатаЗапретаРедактированияПартий) + 86400);
			ПараметрыДинамическогоРасчетаПартий.Вставить("КонецПериода", 					КонецДня(ОбъектДокумента.Дата));
			ПараметрыДинамическогоРасчетаПартий.Вставить("ТаблицаПлановыхОпераций", 		ТаблицаПлановыхОпераций);
			ПараметрыДинамическогоРасчетаПартий.Вставить("ОбъектДокумента", 				ОбъектДокумента);
			ПараметрыДинамическогоРасчетаПартий.Вставить("НастройкиПоВидуУчета", 			Неопределено);
			ПараметрыДинамическогоРасчетаПартий.Вставить("КоличественныйРасчет", 			ПараметрыПолученияПартий.КоличественныйРасчет);
			
			РасчетПартий = ДинамическийРасчетПартий(ПараметрыДинамическогоРасчетаПартий);
			
			#КонецОбласти
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Если расчет партий не потребовался, берем данные из регистров,
	// Иначе из результатов расчета
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Период",                       	ПолучитьОстаткиНа);
	Запрос.УстановитьПараметр("Организация",                  	ОбъектДокумента.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	СчетДляУчета);
	Запрос.УстановитьПараметр("ВидУчета", 						ОбъектДокумента.ВидУчета);
	Запрос.УстановитьПараметр("УчестьБумагиПоРЕПО",				УчестьБумагиПоРЕПО);
	Запрос.УстановитьПараметр("УчестьПартииКПолучению",			УчестьПартииКПолучению);
	Запрос.УстановитьПараметр("УчестьСрочныеКонтракты",			УчестьСрочныеКонтракты);
	
	Если РасчетПартий = Неопределено Тогда
		
		#Область Остатки_партий_из_регистров
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагПроданныеВРЕПООстатки.Рынок КАК Рынок,
			|	БухПартииЦенныхБумагПроданныеВРЕПООстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	БухПартииЦенныхБумагПроданныеВРЕПООстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	БухПартииЦенныхБумагПроданныеВРЕПООстатки.Партия КАК Партия,
			|	БухПартииЦенныхБумагПроданныеВРЕПООстатки.СтрокаПартии КАК СтрокаПартии,
			|	БухПартииЦенныхБумагПроданныеВРЕПООстатки.КоличествоОстаток КАК Количество,
			|	БухПартииЦенныхБумагПроданныеВРЕПООстатки.СуммаРезервовПодОбесценениеОстаток КАК СуммаРезервовПодОбесценение,
			|	БухПартииЦенныхБумагПроданныеВРЕПООстатки.ПродажаРЕПО КАК ПродажаРЕПО
			|ПОМЕСТИТЬ _КонечныеОстаткиПартийПроданныхВРепо
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумагПроданныеВРепо.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагПроданныеВРЕПООстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.Рынок КАК Рынок,
			|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка) КАК УчетныйАктивЕПС,
			|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.Партия КАК Партия,
			|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтрокаПартии КАК СтрокаПартии,
			|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.КоличествоОстаток КАК Количество
			|ПОМЕСТИТЬ _КонечныеОстаткиПартийКупленныхПоРепо
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагКупленныеПоРЕПООстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагКПолучениюОстатки.Рынок КАК Рынок,
			|	БухПартииЦенныхБумагКПолучениюОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	БухПартииЦенныхБумагКПолучениюОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	БухПартииЦенныхБумагКПолучениюОстатки.Партия КАК Партия,
			|	БухПартииЦенныхБумагКПолучениюОстатки.СтрокаПартии КАК СтрокаПартии,
			|	БухПартииЦенныхБумагКПолучениюОстатки.КоличествоОстаток КАК Количество
			|ПОМЕСТИТЬ _КонечныеОстаткиПартийКПоступлению
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумагКПолучению.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагКПолучениюОстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Фьючерсы) КАК Рынок,
			|	БухПартииСрочныхКонтрактовОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	БухПартииСрочныхКонтрактовОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	БухПартииСрочныхКонтрактовОстатки.Партия КАК Партия,
			|	БухПартииСрочныхКонтрактовОстатки.СтрокаПартии КАК СтрокаПартии,
			|	БухПартииСрочныхКонтрактовОстатки.КоличествоОстаток КАК Количество
			|ПОМЕСТИТЬ _КонечныеОстаткиПартийСрочныеКонтракты
			|ИЗ
			|	РегистрНакопления.БухПартииСрочныхКонтрактов.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидУчета = &ВидУчета) КАК БухПартииСрочныхКонтрактовОстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
			|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
			|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
			|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
			|	БухПартииЦенныхБумагОстатки.СуммаРезервовПодОбесценениеОстаток КАК СуммаРезервовПодОбесценение
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагОстатки";		

		КонечныеОстаткиПартий = Запрос.Выполнить().Выгрузить();		
		
		РасчетПартий = Новый Структура;
		РасчетПартий.Вставить("КонечныеОстаткиПартий",				  	КонечныеОстаткиПартий);
		РасчетПартий.Вставить("КонечныеОстаткиПартийКПоступлению",	  	МенеджерВременныхТаблиц.Таблицы["_КонечныеОстаткиПартийКПоступлению"].ПолучитьДанные().Выгрузить());
		РасчетПартий.Вставить("КонечныеОстаткиПартийКупленныхПоРепо", 	МенеджерВременныхТаблиц.Таблицы["_КонечныеОстаткиПартийКупленныхПоРепо"].ПолучитьДанные().Выгрузить());
		РасчетПартий.Вставить("КонечныеОстаткиПартийПроданныхВРепо",  	МенеджерВременныхТаблиц.Таблицы["_КонечныеОстаткиПартийПроданныхВРепо"].ПолучитьДанные().Выгрузить());
		РасчетПартий.Вставить("КонечныеОстаткиПартийСрочныеКонтракты",  МенеджерВременныхТаблиц.Таблицы["_КонечныеОстаткиПартийСрочныеКонтракты"].ПолучитьДанные().Выгрузить());
		РасчетПартий.Вставить("НачалоПериода",						  	НачалоДня(ОбъектДокумента.Дата));
		РасчетПартий.Вставить("КонецПериода",						  	КонецДня(ОбъектДокумента.Дата));
		РасчетПартий.Вставить("ВидУчета",							  	ОбъектДокумента.ВидУчета);
		
		#КонецОбласти
		
	Иначе
		
		#Область Рассчитанные_остатки_партий
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КонечныеОстаткиПартийКПоступлению.Рынок КАК Рынок,
			|	КонечныеОстаткиПартийКПоступлению.ЦеннаяБумага КАК ЦеннаяБумага,
			|	КонечныеОстаткиПартийКПоступлению.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	КонечныеОстаткиПартийКПоступлению.Партия КАК Партия,
			|	КонечныеОстаткиПартийКПоступлению.СтрокаПартии КАК СтрокаПартии,
			|	КонечныеОстаткиПартийКПоступлению.Количество КАК Количество
			|ПОМЕСТИТЬ _КонечныеОстаткиПартийКПоступлению
			|ИЗ
			|	&КонечныеОстаткиПартийКПоступлению КАК КонечныеОстаткиПартийКПоступлению
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КонечныеОстаткиПартийКупленныхПоРепо.Рынок КАК Рынок,
			|	КонечныеОстаткиПартийКупленныхПоРепо.ЦеннаяБумага КАК ЦеннаяБумага,
			|	КонечныеОстаткиПартийКупленныхПоРепо.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	КонечныеОстаткиПартийКупленныхПоРепо.Партия КАК Партия,
			|	КонечныеОстаткиПартийКупленныхПоРепо.СтрокаПартии КАК СтрокаПартии,
			|	КонечныеОстаткиПартийКупленныхПоРепо.Количество КАК Количество
			|ПОМЕСТИТЬ _КонечныеОстаткиПартийКупленныхПоРепо
			|ИЗ
			|	&КонечныеОстаткиПартийКупленныхПоРепо КАК КонечныеОстаткиПартийКупленныхПоРепо
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КонечныеОстаткиПартийСрочныеКонтракты.Рынок КАК Рынок,
			|	КонечныеОстаткиПартийСрочныеКонтракты.ЦеннаяБумага КАК ЦеннаяБумага,
			|	КонечныеОстаткиПартийСрочныеКонтракты.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	КонечныеОстаткиПартийСрочныеКонтракты.Партия КАК Партия,
			|	КонечныеОстаткиПартийСрочныеКонтракты.СтрокаПартии КАК СтрокаПартии,
			|	КонечныеОстаткиПартийСрочныеКонтракты.Количество КАК Количество
			|ПОМЕСТИТЬ _КонечныеОстаткиПартийСрочныеКонтракты
			|ИЗ
			|	&КонечныеОстаткиПартийСрочныеКонтракты КАК КонечныеОстаткиПартийСрочныеКонтракты";
		
		Запрос.УстановитьПараметр("КонечныеОстаткиПартийКПоступлению",		РасчетПартий.КонечныеОстаткиПартийКПоступлению);
		Запрос.УстановитьПараметр("КонечныеОстаткиПартийКупленныхПоРепо",	РасчетПартий.КонечныеОстаткиПартийКупленныхПоРепо);
		Запрос.УстановитьПараметр("КонечныеОстаткиПартийСрочныеКонтракты",	РасчетПартий.КонечныеОстаткиПартийСрочныеКонтракты);
		
		Запрос.Выполнить();
		
		КонечныеОстаткиПартий = РасчетПартий.КонечныеОстаткиПартий;		
		
		#КонецОбласти
		
	КонецЕсли;
	
	#Область УчестьБумагиТПлюс
	
	Если УчестьБумагиТПлюс Тогда
	
		ЗапросТПлюс = Новый Запрос;
		ЗапросТПлюс.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗадолженностиПоЦеннымБумагамОстатки.Рынок КАК Рынок,
			|	ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ЗадолженностиПоЦеннымБумагамОстатки.Основание КАК Основание,
			|	СУММА(ВЫБОР
			|			КОГДА ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|				ТОГДА ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток
			|			ИНАЧЕ -ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток
			|		КОНЕЦ) КАК Количество
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)) КАК ЗадолженностиПоЦеннымБумагамОстатки
			|
			|СГРУППИРОВАТЬ ПО
			|	ЗадолженностиПоЦеннымБумагамОстатки.Основание,
			|	ЗадолженностиПоЦеннымБумагамОстатки.Рынок,
			|	ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага";
		
		ЗапросТПлюс.УстановитьПараметр("Организация",					ОбъектДокумента.Организация);
		ЗапросТПлюс.УстановитьПараметр("Период",						Новый Граница(КонецДня(ОбъектДокумента.Дата), ВидГраницы.Включая));
		ЗапросТПлюс.УстановитьПараметр("СчетДоверительногоУправления",	ОбъектДокумента.СчетДоверительногоУправления);
		
		ВыборкаДетальныеЗаписи = ЗапросТПлюс.Выполнить().Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ИзменениеПоЦеннойБумаге = ВыборкаДетальныеЗаписи.Количество;
			
			Если ИзменениеПоЦеннойБумаге < 0 Тогда 
				
				ИзменениеПоЦеннойБумаге = -ИзменениеПоЦеннойБумаге;
				ПартииКУдалению = Новый Массив;
				
				// уменьшим партии
				Для каждого СтрокаКонечныеОстаткиПартий Из КонечныеОстаткиПартий Цикл
					
					Если СтрокаКонечныеОстаткиПартий.ЦеннаяБумага <> ВыборкаДетальныеЗаписи.ЦеннаяБумага Тогда
						Продолжить
					КонецЕсли;
					
					Если СтрокаКонечныеОстаткиПартий.Количество > ИзменениеПоЦеннойБумаге Тогда
						СтрокаКонечныеОстаткиПартий.Количество = СтрокаКонечныеОстаткиПартий.Количество - ИзменениеПоЦеннойБумаге;
						ИзменениеПоЦеннойБумаге = 0;
						Прервать;
					Иначе
						ИзменениеПоЦеннойБумаге = ИзменениеПоЦеннойБумаге - СтрокаКонечныеОстаткиПартий.Количество;
						СтрокаКонечныеОстаткиПартий.Количество = 0;
						ПартииКУдалению.Добавить(СтрокаКонечныеОстаткиПартий);
					КонецЕсли;
				
				КонецЦикла;
				
				Для каждого СтрокаПартииКУдалению Из ПартииКУдалению Цикл
					КонечныеОстаткиПартий.Удалить(СтрокаПартииКУдалению);
				КонецЦикла;
				
				Если ИзменениеПоЦеннойБумаге <> 0 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По Т+ продали больше бумаг, чем есть в наличии '" + ОбъектДокумента.СчетДоверительногоУправления + "', " + ВыборкаДетальныеЗаписи.ЦеннаяБумага + ", " + ОбъектДокумента.Дата, ОбъектДокумента);
				КонецЕсли;
				
			ИначеЕсли ИзменениеПоЦеннойБумаге > 0 Тогда 
				
				// добавим партию
				СтрокиБумага = КонечныеОстаткиПартий.НайтиСтроки(Новый Структура("ЦеннаяБумага", ВыборкаДетальныеЗаписи.ЦеннаяБумага));
				Если СтрокиБумага.Количество() > 0 Тогда
					УчетныйАктивЕПС = СтрокиБумага[0].УчетныйАктивЕПС;
				Иначе
					УчетныйАктивЕПС = БухгалтерскийУчет.ОпределитьУчетныйАктивЕПС(ОбъектДокумента.Дата, ВыборкаДетальныеЗаписи.Рынок, ВыборкаДетальныеЗаписи.ЦеннаяБумага, СчетДляУчета);
				КонецЕсли;
				
				НоваяПартия = КонечныеОстаткиПартий.Добавить();
				
				НоваяПартия.Рынок = ВыборкаДетальныеЗаписи.Рынок;
				НоваяПартия.ЦеннаяБумага				= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				НоваяПартия.УчетныйАктивЕПС				= УчетныйАктивЕПС;
				НоваяПартия.Партия						= ВыборкаДетальныеЗаписи.Основание;
				НоваяПартия.СтрокаПартии				= 1;
				НоваяПартия.Количество					= ИзменениеПоЦеннойБумаге;
				НоваяПартия.СуммаРезервовПодОбесценение	= 0;
				
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЕсли;
	
	#КонецОбласти 	
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонечныеОстаткиПартий_Партии.Рынок КАК Рынок,
		|	КонечныеОстаткиПартий_Партии.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КонечныеОстаткиПартий_Партии.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	КонечныеОстаткиПартий_Партии.Партия КАК Партия,
