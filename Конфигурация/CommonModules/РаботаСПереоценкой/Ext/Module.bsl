		Запрос.УстановитьПараметр("ДатаОценкиБез10Дней",		Справочники.Календари.ДобавитьКДатеРабочиеДни(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки), -10));
		Запрос.УстановитьПараметр("ДатаОценкиБез30Дней",		Справочники.Календари.ДобавитьКДатеРабочиеДни(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки), -30));
		Запрос.УстановитьПараметр("ПоследнийТорговыйДень",		Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки)));
		
