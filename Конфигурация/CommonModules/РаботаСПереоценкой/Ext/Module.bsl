		|				И (НЕ АктивныйРынокБлумберг.ЦеннаяБумага ЕСТЬ NULL
		|					ИЛИ &ДатаПереоценки >= ДАТАВРЕМЯ(2017, 6, 8, 0, 0, 0))
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УровеньОценки,
		|	ВЫБОР
		|		КОГДА КотировкиСПб.СправедливаяЦена > 0
		|			ТОГДА КотировкиСПб.ПолеПереоценки
		|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.CLOSE_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|				И (НЕ АктивныйРынокБлумберг.ЦеннаяБумага ЕСТЬ NULL
		|					ИЛИ &ДатаПереоценки >= ДАТАВРЕМЯ(2017, 6, 8, 0, 0, 0))
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СредняяЦенаЗакрытия)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПолеКотировки,
		|	ВЫБОР
		|		КОГДА КотировкиСПб.СправедливаяЦена > 0
		|			ТОГДА КотировкиСПб.Биржа
		|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.CLOSE_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|				И (НЕ АктивныйРынокБлумберг.ЦеннаяБумага ЕСТЬ NULL
		|					ИЛИ &ДатаПереоценки >= ДАТАВРЕМЯ(2017, 6, 8, 0, 0, 0))
		|			ТОГДА Биржи.ЮрФизЛицо
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Биржа,
		|	ВЫБОР
		|		КОГДА КотировкиСПб.СправедливаяЦена > 0
		|			ТОГДА КотировкиСПб.ДатаЦены
		|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.CLOSE_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|				И (НЕ АктивныйРынокБлумберг.ЦеннаяБумага ЕСТЬ NULL
		|					ИЛИ &ДатаПереоценки >= ДАТАВРЕМЯ(2017, 6, 8, 0, 0, 0))
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.CLOSE_DATE
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ДатаЦены,
		|	ВЫБОР
		|		КОГДА КотировкиСПб.СправедливаяЦена > 0
		|			ТОГДА КотировкиСПб.ВалютаКотировки
		|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.CLOSE_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|				И (НЕ АктивныйРынокБлумберг.ЦеннаяБумага ЕСТЬ NULL
		|					ИЛИ &ДатаПереоценки >= ДАТАВРЕМЯ(2017, 6, 8, 0, 0, 0))
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ВалютаКотировки
		|ПОМЕСТИТЬ КотировкиБлумберг
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ КотировкиСПб КАК КотировкиСПб
		|		ПО ТаблицаЦБ.Рынок = КотировкиСПб.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиСПб.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(&ДатаПереоценки, Биржа = &Блумберг И РежимТоргов = &Режим_BGN) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|			ПО КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа = Биржи.Ссылка
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадокСводныеСрезПоследних.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ АктивныйРынокБлумберг КАК АктивныйРынокБлумберг
		|		ПО ТаблицаЦБ.Рынок = АктивныйРынокБлумберг.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = АктивныйРынокБлумберг.ЦеннаяБумага
		|ГДЕ
		|	(АктивныйРынокБлумберг.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|			ИЛИ КотировкиСПб.ЦеннаяБумага ЕСТЬ НЕ NULL )
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ВЫБОР
		|		КОГДА КотировкиБлумберг.СправедливаяЦена > 0
		|			ТОГДА ВЫБОР
		|					КОГДА ТИПЗНАЧЕНИЯ(ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|						ТОГДА КотировкиБлумберг.СправедливаяЦена * ТаблицаЦБ.Номинал / 100
		|					ИНАЧЕ КотировкиБлумберг.СправедливаяЦена
		|				КОНЕЦ
		|		ИНАЧЕ ЕСТЬNULL(РасчетныеЦеныНРДСрезПоследних.PRICE, 0)
		|	КОНЕЦ КАК СправедливаяЦена,
		|	ВЫБОР
		|		КОГДА КотировкиБлумберг.СправедливаяЦена > 0
		|			ТОГДА КотировкиБлумберг.УровеньОценки
		|		КОГДА РасчетныеЦеныНРДСрезПоследних.PRICE ЕСТЬ НЕ NULL 
		|			ТОГДА 2
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УровеньОценки,
		|	ВЫБОР
		|		КОГДА КотировкиБлумберг.СправедливаяЦена > 0
		|			ТОГДА КотировкиБлумберг.ПолеКотировки
		|		КОГДА РасчетныеЦеныНРДСрезПоследних.PRICE ЕСТЬ НЕ NULL 
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПолеКотировки,
		|	ВЫБОР
		|		КОГДА КотировкиБлумберг.СправедливаяЦена > 0
		|			ТОГДА КотировкиБлумберг.Биржа
		|		КОГДА РасчетныеЦеныНРДСрезПоследних.PRICE ЕСТЬ НЕ NULL 
		|			ТОГДА &НРД
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Биржа,
		|	ВЫБОР
		|		КОГДА КотировкиБлумберг.СправедливаяЦена > 0
		|			ТОГДА КотировкиБлумберг.ДатаЦены
		|		КОГДА ЕСТЬNULL(РасчетныеЦеныНРДСрезПоследних.PRICE, 0) <> 0
		|			ТОГДА РасчетныеЦеныНРДСрезПоследних.Период
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ДатаЦены,
		|	ВЫБОР
		|		КОГДА КотировкиБлумберг.СправедливаяЦена > 0
		|			ТОГДА ВЫБОР
		|					КОГДА ТИПЗНАЧЕНИЯ(ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|						ТОГДА ТаблицаЦБ.ВалютаНоминала
		|					ИНАЧЕ КотировкиБлумберг.ВалютаКотировки
		|				КОНЕЦ
		|		ИНАЧЕ ТаблицаЦБ.ВалютаНоминала
		|	КОНЕЦ КАК ВалютаКотировки
		|ПОМЕСТИТЬ Котировки2УровеньНСД
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ КотировкиБлумберг КАК КотировкиБлумберг
		|		ПО ТаблицаЦБ.Рынок = КотировкиБлумберг.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиБлумберг.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД.СрезПоследних(&ДатаПереоценки, ) КАК РасчетныеЦеныНРДСрезПоследних
		|		ПО ТаблицаЦБ.Рынок = РасчетныеЦеныНРДСрезПоследних.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныНРДСрезПоследних.ЦеннаяБумага
		|			И (РасчетныеЦеныНРДСрезПоследних.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Котировки2УровеньНСД.ЦеннаяБумага КАК ЦеннаяБумага,
		|	Котировки2УровеньНСД.Рынок КАК Рынок,
		|	Котировки2УровеньНСД.УровеньОценки КАК УровеньОценки,
		|	Котировки2УровеньНСД.СправедливаяЦена КАК Стоимость,
		|	Котировки2УровеньНСД.ПолеКотировки КАК ВидЦены,
		|	Котировки2УровеньНСД.Биржа КАК Источник,
		|	Котировки2УровеньНСД.ДатаЦены КАК ДатаЦены,
		|	Котировки2УровеньНСД.Номинал КАК Номинал,
		|	Котировки2УровеньНСД.ВалютаКотировки КАК ВалютаКотировки,
		|	""цены облигаций привели к деньгам при получении цен НРД"" КАК Примечание
		|ИЗ
		|	Котировки2УровеньНСД КАК Котировки2УровеньНСД
		|ГДЕ
		|	Котировки2УровеньНСД.СправедливаяЦена <> 0";
		
	//ТорговыхДнейНазад10 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки)-1, -10);
	ТорговыхДнейНазад10 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -10);
		
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	Запрос.УстановитьПараметр("СтатусОбращается", Перечисления.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10", ТорговыхДнейНазад10);
	Запрос.УстановитьПараметр("ММВБ", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("СПб", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_СПб"));
	
	Запрос.УстановитьПараметр("Блумберг", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("Режим_BGN", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	
	Запрос.УстановитьПараметр("Рубли", ПараметрыОценки.Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("НРД", ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("Организация", ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыОценки.СчетДоверительногоУправления);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);//ЦенныеБумаги.Выгрузить()
	
	ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаСтоимостейЦБ;
КонецФункции

Функция ПолучитьЦеныППА(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СправедливаяЦена,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УровеньОценки,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ДатаЦены,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.РыночнаяЦена2)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПолеКотировки,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Биржа,
		|	ТаблицаЦБ.Рынок
		|ПОМЕСТИТЬ КотировкиР2
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|				&ДатаПереоценки,
		|				Биржа = &ММВБ
		|					И РежимТоргов.ОсновнойРежим) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадокСводныеСрезПоследних.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.Рынок,
		|	КотировкиТорговыхПлощадок.РежимТоргов.ТПлюс КАК ТПлюс,
		|	МАКСИМУМ(КотировкиТорговыхПлощадок.Период) КАК Период,
		|	КотировкиТорговыхПлощадок.РежимТоргов
		|ПОМЕСТИТЬ ДатыКотировокОсновныхТорговММВБ
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадок.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
		|ГДЕ
		|	КотировкиТорговыхПлощадок.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|	И КотировкиТорговыхПлощадок.Период <= &ДатаПереоценки
		|	И КотировкиТорговыхПлощадок.VOLUME > 0
		|	И КотировкиТорговыхПлощадок.Биржа = &ММВБ
		|	И КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим
