	Запрос.УстановитьПараметр("БратьЦеныНРДНаДатуТоргов",							БратьЦеныНРДНаДатуТоргов);
	Запрос.УстановитьПараметр("ОцениватьАкцииИОблигацииКромеОВОЗРФТолькоПоЦенеНРД",	ОцениватьАкцииИОблигацииКромеОВОЗРФТолькоПоЦенеНРД);
	
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены", ТолькоНаблюдаемыеЦены);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Стройкомплекса 2021", "Таблица стоимостей ЦБ", , , "_ИсходнаяТаблицаЦБ, _БумагиОцениваемыеПоАмортизированнойСтоимости, _СтатусыЦенныхБумаг, _ЭмитентыЦенныхБумаг");
	КонецЕсли;
	
	Если ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;
	
	// Расчетные цены 	
	
	ВыполненРасчетЦены = Ложь;	
	
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);	
	ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	
	ПараметрыРасчетаСтоимостиПоАналогам = Новый Структура;
	ПараметрыРасчетаСтоимостиПоАналогам.Вставить("ВариантРасчета",	 Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020);
	ПараметрыРасчетаСтоимостиПоАналогам.Вставить("ПараметрыЗапроса", Запрос.Параметры);
	
	ПараметрыОценки.Вставить("ПараметрыРасчетаСтоимостиПоАналогам", ПараметрыРасчетаСтоимостиПоАналогам);
	ПараметрыОценки.Вставить("ТочностьСрокаДоПогашения",			Неопределено); // не округляем
	ПараметрыОценки.Вставить("ТочностьСтавкиДисконтирования",		6);
	ПараметрыОценки.Вставить("ТочностьДисконтированногоПотока",		6);
		
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены)
			ИЛИ СтрокаСтоимостейЦБ.ОсновнойРынок = "НРД" И ОцениватьАкцииИОблигацииКромеОВОЗРФТолькоПоЦенеНРД
		Тогда
			Продолжить;
		КонецЕсли;
		
		// Требуется расчет цены
		
		ОшибкаРасчета = Ложь;
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			Если СтрокаСтоимостейЦБ.СчитаемЧтоДефолт Тогда
				Если РасшифровкаРасчета <> Неопределено Тогда	
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Оценка дефолтных долговых ценных бумаг", Новый Структура("Описание", "Оценка дефолтных долговых ценных бумаг не реализована"));
				КонецЕсли;		
				Продолжить;	
			КонецЕсли;
			
			// Расчет PV 
			
			РассчитыватьСтавкуДисконтированияПоАналогам = (ДатаПереоценки < '20211229' ИЛИ СтрокаСтоимостейЦБ.ОсновнойРынок <> "Российская торговая площадка");	
			
			Если РассчитыватьСтавкуДисконтированияПоАналогам Тогда
				ЦенаЗаполнена = ЗаполнитьДисконтированнойПоСтавкеРассчитаннойПоАналогамСтоимостью(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 3, ПараметрыДенежногоПотока, , ОшибкаРасчета, РасшифровкаРасчета);
			Иначе
				ЦенаЗаполнена = ЗаполнитьДисконтированнойПоБезрисковойСтавкеДоходностиСтоимостью(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, ПараметрыДенежногоПотока, Истина, 3, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, 6, ОшибкаРасчета, РасшифровкаРасчета); 
			КонецЕсли;
				
			Если ОшибкаРасчета Тогда
				ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
				Продолжить;
			ИначеЕсли ЦенаЗаполнена Тогда
				ВыполненРасчетЦены = Истина;
				Продолжить;
			КонецЕсли;			

		ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда	
			
			Если СтрокаСтоимостейЦБ.ОсновнойРынок = "Российская торговая площадка"
				ИЛИ СтрокаСтоимостейЦБ.ОсновнойРынок = "Иностранная торговая площадка"
			Тогда
			
				#Область Расчет_на_основе_корректировки_исторической_цены
				
				// Справедливая стоимость акций, обращающихся на российских и иностранных фондовых биржах,
				// определяется в соответствии с моделью оценки, основанной на корректировке исторической цены (CAPM).
				// Применяем при отсутствии цены не более 10 рабочих дней
				
				ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, Справочники.Календари.Общероссийский, 3, , ОшибкаРасчета, РасшифровкаРасчета);  
				
				Если ОшибкаРасчета Тогда
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
				ИначеЕсли ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
				КонецЕсли;

				#КонецОбласти
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "После расчета цен", ТаблицаСтоимостейЦБ.Скопировать());	
	КонецЕсли;
		
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныНационального2020_2(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "ИсходнаяТаблицаЦБ");
	ПоместитьБумагиОцениваемыеПоАмортизированнойСтоимостиВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки, ДатаПереоценки, "ИсходнаяТаблицаЦБ");
	ПоместитьСтатусыЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "ИсходнаяТаблицаЦБ"); 
	ПоместитьЭмитентовЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "ИсходнаяТаблицаЦБ");	
	ПоместитьСведенияОТоргахЦеннымиБумагамиВМенеджерВременныхТаблиц(Запрос, "ИсходнаяТаблицаЦБ", ДатаПереоценки, 10, "_СведенияОТоргахЦеннымиБумагами");	
		
	#Область Основной_запрос	
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(Облигации.ДатаНачалаОбращения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаОбращения,
		|	ЕСТЬNULL(Облигации.ДатаНачалаРазмещения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаРазмещения,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, НЕОПРЕДЕЛЕНО) КАК ДатаПогашения,
		|	ЕСТЬNULL(Облигации.ДатаПогашения <> ДАТАВРЕМЯ(1, 1, 1)
		|			И Облигации.ДатаПогашения < ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -7), ЛОЖЬ) КАК СчитаемЧтоДефолт,
		|	ЕСТЬNULL(Облигации.ВалютаНоминала = &ВалютаРубли, ЛОЖЬ) КАК ОблигацияРублевая,
		|	ЕСТЬNULL(Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ), ЛОЖЬ) КАК ОблигацияОВОЗ,
		|	ЕСТЬNULL(Облигации.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств), ЛОЖЬ) КАК ОблигацияИнострГосударства,
		|	ЕСТЬNULL(Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|			И НЕ РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЕврооблигацияИнострЭмитента,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЭмитентРоссийский,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация), ЛОЖЬ) КАК ЭмитентМеждународнаяФинОрганизация,
		|	ЕСТЬNULL(_ЭмитентыЦенныхБумаг.Банкрот, ЛОЖЬ) КАК ЭмитентБанкрот,
		|	_ЭмитентыЦенныхБумаг.ДатаБанкротства КАК ЭмитентДатаБанкротства,
		|	_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента КАК Эмитент,
		|	_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК ОценкаПоАмортизированнойСтоимости,
		|	_СведенияОТоргахЦеннымиБумагами.Дата КАК ПоследняяДатаТоргов
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ИСТИНА
		|					ИЗ
		|						ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|					ГДЕ
		|						ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЭмитентыЦенныхБумаг КАК _ЭмитентыЦенныхБумаг
		|		ПО (_ЭмитентыЦенныхБумаг.ЦеннаяБумага = ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента
		|					ИЗ
		|						_ЭмитентыЦенныхБумаг)) КАК РеквизитыЮрЛицаЭмитента
		|		ПО (РеквизитыЮрЛицаЭмитента.ЮрФизЛицо = _ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _БумагиОцениваемыеПоАмортизированнойСтоимости КАК _БумагиОцениваемыеПоАмортизированнойСтоимости
		|		ПО (_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага = ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СведенияОТоргахЦеннымиБумагами КАК _СведенияОТоргахЦеннымиБумагами
		|		ПО (_СведенияОТоргахЦеннымиБумагами.ЦеннаяБумага = ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|			И (_СведенияОТоргахЦеннымиБумагами.ТорговыхДнейНазад = 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА &ОцениватьАкцииИОблигацииТолькоПоЦенеНРД
		|				И ТаблицаЦБ.Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))
		|			ТОГДА ""НРД""
		|		КОГДА ДопущенныеКТоргам.РоссийскаяБиржа
		|				И НЕ ТаблицаЦБ.ЕврооблигацияИнострЭмитента
		|				И НЕ ТаблицаЦБ.ЭмитентМеждународнаяФинОрганизация
		|				И НЕ ТаблицаЦБ.ОблигацияИнострГосударства
		|			ТОГДА ""Российская торговая площадка""
		|		КОГДА ТаблицаЦБ.ЭмитентРоссийский
		|				И (ТаблицаЦБ.ОблигацияРублевая
		|					ИЛИ ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции))
		|			ТОГДА ""Российский внебиржевой рынок""
		|		КОГДА ДопущенныеКТоргам.ЦеннаяБумага ЕСТЬ NULL
		|				ИЛИ ТаблицаЦБ.ЕврооблигацияИнострЭмитента
		|				ИЛИ ТаблицаЦБ.ЭмитентМеждународнаяФинОрганизация
		|				ИЛИ ТаблицаЦБ.ОблигацияИнострГосударства
		|				ИЛИ ТаблицаЦБ.ОблигацияОВОЗ
		|			ТОГДА ""Международный внебиржевой рынок""
		|		ИНАЧЕ ""Иностранная торговая площадка""
		|	КОНЕЦ КАК ОсновнойРынок,
		|	ТаблицаЦБ.ПоследняяДатаТоргов КАК ПоследняяДатаТоргов
		|ПОМЕСТИТЬ ОсновныеРынкиЦБ
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_СтатусыЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|			ЕСТЬNULL(МАКСИМУМ(РеквизитыЮрЛицаБиржи.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка))), ЛОЖЬ) КАК РоссийскаяБиржа
		|		ИЗ
		|			_СтатусыЦенныхБумаг КАК _СтатусыЦенныхБумаг
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|						&ДатаПереоценки,
		|						(Подразделение, Язык, ЮрФизЛицо) В
		|							(ВЫБРАТЬ
		|								ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|								ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|								Биржи.ЮрФизЛицо
		|							ИЗ
		|								Справочник.Биржи КАК Биржи
		|							ГДЕ
		|								Биржи.Ссылка В (&ДоступныеБиржи))) КАК РеквизитыЮрЛицаБиржи
		|				ПО (РеквизитыЮрЛицаБиржи.ЮрФизЛицо = _СтатусыЦенныхБумаг.Биржа.ЮрФизЛицо)
		|		ГДЕ
		|			_СтатусыЦенныхБумаг.Статус = ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже)
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_СтатусыЦенныхБумаг.ЦеннаяБумага) КАК ДопущенныеКТоргам
		|		ПО (ДопущенныеКТоргам.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|ГДЕ
		|	НЕ ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОсновныеРынкиЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_СтатусыЦенныхБумаг.Биржа КАК Биржа,
		|	ЕСТЬNULL(СУММА(КотировкиТорговыхПлощадок.NUMTRADES), 0) КАК КоличествоСделок,
		|	ЕСТЬNULL(СУММА(КотировкиТорговыхПлощадок.VALUE), 0) КАК ОбъемСделок,
		|	ЕСТЬNULL(СУММА(КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность), 0) КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней
		|ИЗ
		|	ОсновныеРынкиЦБ КАК ОсновныеРынкиЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СтатусыЦенныхБумаг КАК _СтатусыЦенныхБумаг
		|		ПО (_СтатусыЦенныхБумаг.ЦеннаяБумага = ОсновныеРынкиЦБ.ЦеннаяБумага)
		|			И (_СтатусыЦенныхБумаг.Статус = ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.ЦеннаяБумага = ОсновныеРынкиЦБ.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Рынок = ОсновныеРынкиЦБ.Рынок)
		|			И (КотировкиТорговыхПлощадок.Биржа = _СтатусыЦенныхБумаг.Биржа)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадок.Период МЕЖДУ &КалендарныхДнейНазад35 И &ДатаПереоценки)
