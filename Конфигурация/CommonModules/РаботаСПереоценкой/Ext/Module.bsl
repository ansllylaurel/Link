		|	_КотировкиВВалютеНоминала.ДатаПогашения,
		|	_КотировкиВВалютеНоминала.ДатаНачалаОбращения,
		|	_КотировкиВВалютеНоминала.ДатаНачалаРазмещения,
		|	_КотировкиВВалютеНоминала.ПолеЦены,
		|	_КотировкиВВалютеНоминала.УровеньОценки,
		|	_КотировкиВВалютеНоминала.КурсВалютыНоминала КАК КурсВалютыНоминала,
		|	ВЫРАЗИТЬ(0.0 КАК &ТипЧислаСумма) КАК РыночнаяСумма,
		|	ВЫРАЗИТЬ(0.0 КАК &ТипЧислаСумма) КАК РыночнаяСуммаКупона,
		|	КурсыВалютыУчета.Курс КАК КурсВалютыУчетаКурс,
		|	КурсыВалютыУчета.Кратность КАК КурсВалютыУчетаКратность,
		|	КурсыВалютыНоминалаНаДатуОценки.Курс КАК КурсВалютыНоминалаНаДатуОценкиКурс,
		|	КурсыВалютыНоминалаНаДатуОценки.Кратность КАК КурсВалютыНоминалаНаДатуОценкиКратность
		|ИЗ
		|	_КотировкиВВалютеНоминала КАК _КотировкиВВалютеНоминала
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютыУчета
		|		ПО &ВалютаУчета = КурсыВалютыУчета.Валюта И КурсыВалютыУчета.Период = &Период
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютыНоминалаНаДатуОценки
		|		ПО _КотировкиВВалютеНоминала.ВалютаНоминала = КурсыВалютыНоминалаНаДатуОценки.Валюта И КурсыВалютыНоминалаНаДатуОценки.Период = &Период
		|УПОРЯДОЧИТЬ ПО
		|	_КотировкиВВалютеНоминала.Рынок,
		|	_КотировкиВВалютеНоминала.ЦеннаяБумага,
		|	_КотировкиВВалютеНоминала.Партия,
		|	_КотировкиВВалютеНоминала.СтрокаПартии;
		|";
		
	Запрос.УстановитьПараметр("ПолучатьЦеныПаев",				ВариантРасчетаСтоимости.Родитель = Справочники.ВариантыРасчетаОценочнойСтоимости.Бухгалтерия);
	Запрос.УстановитьПараметр("РабочаяДатаПереоценки",			РабочаяДатаПереоценки);
	Запрос.УстановитьПараметр("Период",							Период);
	Запрос.УстановитьПараметр("ВалютаУчета",					Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления); 
	
	// Возникают ситуации, когда превышается допустимая длина числа в SQL, поэтому в запросе приводим числа к точности, необходимой для данного счета ДУ
	
	НастройкиОценки = ОпределитьНастройкиОценки(Период, Организация, СчетДоверительногоУправления, ЦельРасчета, Истина);
	Если НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Неопределено И НЕ ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определен вариант оценки для цели '" + ЦельРасчета + "' для клиента " + СчетДоверительногоУправления);
		Возврат Неопределено;
	КонецЕсли;
	
	ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета = ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета(
		ВариантРасчетаСтоимости, СчетДоверительногоУправления, Период);
	 	
	ОкруглятьВалютнуюЦену = (ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСумму <> "НеОкруглять");	
		
	Если ОкруглятьВалютнуюЦену Тогда
		Если ТипЗнч(ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСумму) <> Тип("Число") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Неизвестный вариант округления валютной суммы '%1'", ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСумму));
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	ОкруглятьВалютнуюЦенуКупона = (ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСуммуКупона <> "НеОкруглять");	
	
	Если ОкруглятьВалютнуюЦенуКупона Тогда
		Если ТипЗнч(ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСуммуКупона) <> Тип("Число") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Неизвестный вариант округления валютной суммы купона '%1'", ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСуммуКупона));
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	ТипЧислаСумма						= Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип.КвалификаторыЧисла;
	ТочностьРасчетаОценочнойСтоимости	= ПолучитьТочностьРасчетаОценочнойСтоимости(НастройкиОценки);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТипЧислаЦенаТела",
		"ЧИСЛО(" + Строка(ТипЧислаСумма.Разрядность) + ", "
		+  Строка(?(ОкруглятьВалютнуюЦену, ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСумму, ТочностьРасчетаОценочнойСтоимости)) + ")");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТипЧислаЦенаКупона",
		"ЧИСЛО(" + Строка(ТипЧислаСумма.Разрядность) + ", "
		+  Строка(?(ОкруглятьВалютнуюЦенуКупона, ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСуммуКупона, ТочностьРасчетаОценочнойСтоимости)) + ")");	
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТипЧислаСумма", "ЧИСЛО(" + Строка(ТипЧислаСумма.Разрядность) + ", " +  Строка(ТипЧислаСумма.РазрядностьДробнойЧасти) + ")");
		
	ТипЧислаКоличество = Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип.КвалификаторыЧисла;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТипЧислаКоличество", "ЧИСЛО(" + Строка(ТипЧислаКоличество.Разрядность) + ", " +  Строка(ТипЧислаКоличество.РазрядностьДробнойЧасти) + ")");
	
	ТипЧислаЦенаПроцент = Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦенаПроцент.Тип.КвалификаторыЧисла;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТипЧислаЦенаПроцент", "ЧИСЛО(" + Строка(ТипЧислаЦенаПроцент.Разрядность) + ", " +  Строка(ТипЧислаЦенаПроцент.РазрядностьДробнойЧасти) + ")");
	
	ТипЧислаЦена = Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип.КвалификаторыЧисла;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТипЧислаЦена", "ЧИСЛО(" + Строка(ТипЧислаЦена.Разрядность) + ", " +  Строка(ТочностьРасчетаОценочнойСтоимости) + ")");
    	
	Если ТолькоБумагиВРЕПО Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "_Котировки.Партия КАК Партия," , "_Котировки.Партия КАК Партия, _Котировки.ПродажаРЕПО КАК ПродажаРЕПО,");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "_Котировки.СтрокаПартии КАК СтрокаПартии," , "_Котировки.СтрокаПартии КАК СтрокаПартии, _Котировки.СтрокаПродажиРЕПО КАК СтрокаПродажиРЕПО,");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "_КотировкиВВалютеНоминала.Партия КАК Партия," , "_КотировкиВВалютеНоминала.Партия КАК Партия, _КотировкиВВалютеНоминала.ПродажаРЕПО КАК ПродажаРЕПО,");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "_КотировкиВВалютеНоминала.СтрокаПартии КАК СтрокаПартии," , "_КотировкиВВалютеНоминала.СтрокаПартии КАК СтрокаПартии, _КотировкиВВалютеНоминала.СтрокаПродажиРЕПО КАК СтрокаПродажиРЕПО,");
		
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
