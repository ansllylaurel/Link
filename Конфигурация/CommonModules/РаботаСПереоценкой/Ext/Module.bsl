		|			ИНАЧЕ _ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(_ОцененныеБумаги.Валюта, 0) КАК Валюта,
		|	ЕСТЬNULL(_ОцененныеБумаги.ВалютаКотировки, 0) КАК ВалютаКотировки,
		|	ЕСТЬNULL(_ОцененныеБумаги.ДатаЦены, 0) КАК ДатаЦены,
		|	0 КАК Купон,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаКупона,
		|	_ТаблицаЦБ.ПоследняяДатаТоргов КАК ПоследняяДатаТоргов,
		|	ЕСТЬNULL(_КотировкиОсновногоРынка.BID, 0) КАК BID,
		|	ЕСТЬNULL(_КотировкиОсновногоРынка.OFFER, 0) КАК OFFER
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОцененныеБумаги КАК _ОцененныеБумаги
		|		ПО (_ОцененныеБумаги.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (Биржи.Ссылка = _ОцененныеБумаги.Источник)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КотировкиОсновногоРынка КАК _КотировкиОсновногоРынка
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ОсновнойРынокПриоритетРежимаТорговПоВалютеКотировкиИОбъему КАК ПриоритетРежимаТоргов
		|			ПО (ПриоритетРежимаТоргов.ЦеннаяБумага = _КотировкиОсновногоРынка.ЦеннаяБумага)
		|				И (ПриоритетРежимаТоргов.РежимТоргов = _КотировкиОсновногоРынка.РежимТоргов)
		|		ПО (_КотировкиОсновногоРынка.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)";
	
	#КонецОбласти	
	
	ТолькоНаблюдаемыеЦены = ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены;
	
	ММВБ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	
	ПроверятьАктивностьРынкаПоНаличиюТорговВДеньОценки	= (ДатаПереоценки >= '20230101');
	ПриоритетЦеныЗакрытияПередСредневзвешенной			= (ДатаПереоценки >= '20210101');
	ТестироватьЦенуЗакрытия								= (ДатаПереоценки < '20230101');
	ОцениватьПоЦенеСпросаНа1Уровне						= (ДатаПереоценки >= '20230101');	
	БратьЦеныНРДНеПозднееПоследнегоТорговогоДня			= (ДатаПереоценки >= '20210101');
	УровеньЦенНРДПоМетодуРасчета						= (ДатаПереоценки >= '20230101');	
	ТестироватьСкорректированнуюИсторическуюЦену		= (ДатаПереоценки >= '20210101' И ДатаПереоценки < '20230101');
	ТестироватьРассчитаннуюПоАналогамЦену				= (ДатаПереоценки < '20230101');
	
	Запрос.УстановитьПараметр("ДатаПереоценки",			ДатаПереоценки);
	
	Запрос.УстановитьПараметр("ММВБ",					ММВБ);
	Запрос.УстановитьПараметр("НРД",					ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("Блумберг",				ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));	
	Запрос.УстановитьПараметр("Режим_BGN",				ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL",				ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	Запрос.УстановитьПараметр("ВалютаРубли",			ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	Запрос.УстановитьПараметр("ПроверятьАктивностьРынкаПоНаличиюТорговВДеньОценки",	ПроверятьАктивностьРынкаПоНаличиюТорговВДеньОценки);
	Запрос.УстановитьПараметр("ПриоритетЦеныЗакрытия",								ПриоритетЦеныЗакрытияПередСредневзвешенной);
	Запрос.УстановитьПараметр("ТестироватьЦенуЗакрытия",							ТестироватьЦенуЗакрытия);
	Запрос.УстановитьПараметр("ОцениватьПоЦенеСпросаНа1Уровне",						ОцениватьПоЦенеСпросаНа1Уровне);
	Запрос.УстановитьПараметр("БратьЦеныНРДНеПозднееПоследнегоТорговогоДня",		БратьЦеныНРДНеПозднееПоследнегоТорговогоДня);
	Запрос.УстановитьПараметр("УровеньЦенНРДПоМетодуРасчета",						УровеньЦенНРДПоМетодуРасчета);
	Запрос.УстановитьПараметр("ТестироватьСкорректированнуюИсторическуюЦену",		ТестироватьСкорректированнуюИсторическуюЦену);
	Запрос.УстановитьПараметр("ТестироватьРассчитаннуюПоАналогамЦену",				ТестироватьРассчитаннуюПоАналогамЦену);
	
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены",	ТолькоНаблюдаемыеЦены);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Сургутнефтегаз 2020", "Таблица стоимостей ЦБ", , , "_ИсходнаяТаблицаЦБ, _ТаблицаДатРасчетныхЦенПаев, _ЭмитентыЦенныхБумаг, _СводныеКотировкиТорговыхПлощадокСРежимами, _ОцененныеБумаги");
	КонецЕсли;
	
	Если ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;
	
	// Расчетные цены 	
	
	ВыполненРасчетЦены = Ложь;	
	
	ПараметрыДенежногоПотока = ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	ОтборАналогов			 = Новый Структура("Назначение, ТолькоСВалютойНоминалаЦеннойБумаги", Перечисления.ЦелиИспользованияАналогов.РасчетСтавкиДисконтирования, Истина);
	
	КотировкиАналогов = Неопределено;
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления, , СтрокаСтоимостейЦБ.ВалютаКупона);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДатаПереоценки >= '20220101' И СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков_по_аналогам							
			
			// Ставка дисконтирования как средневзвешенная доходность к погашению, рассчитанная по аналогам по объему сделок
				
			Если КотировкиАналогов = Неопределено Тогда
				
				#Область Котировки_аналогов
				
				Запрос = Новый Запрос;
				Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
								
				СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаСтоимостейЦБ, "_ТаблицаЦБ", Запрос, Истина, "ЦеннаяБумага, Рынок", "Стоимость = 0");
				
				ПоместитьАналогиЦенныхБумагВМенеджерВременныхТаблиц(Запрос, "_ТаблицаЦБ", ДатаПереоценки, ПараметрыОценки.Организация, ПараметрыОценки.Клиент, ОтборАналогов, "_Аналоги");   
				
				// Получаем активность рынка для аналогов
				
				ОшибкаРасчета = Ложь;

				ТаблицаАналогов = Запрос.МенеджерВременныхТаблиц.Таблицы["_Аналоги"].ПолучитьДанные().Выгрузить().Скопировать(, "Аналог");
				ТаблицаАналогов.Свернуть("Аналог");
				ТаблицаАналогов.Колонки.Аналог.Имя = "ЦеннаяБумага";
				ТаблицаАналогов.Колонки.Добавить("Рынок", Новый ОписаниеТипов("ПеречислениеСсылка.РынкиЦенныхБумаг"));
				ТаблицаАналогов.ЗаполнитьЗначения(Перечисления.РынкиЦенныхБумаг.Облигации, "Рынок");
				
				ПараметрыОценкиБумаг = Новый Структура;
				ПараметрыОценкиБумаг.Вставить("Организация",							ПараметрыОценки.Организация);
				ПараметрыОценкиБумаг.Вставить("СчетДоверительногоУправления",			ПараметрыОценки.СчетДоверительногоУправления);
				ПараметрыОценкиБумаг.Вставить("ВидУчета",								Неопределено);
				ПараметрыОценкиБумаг.Вставить("ВариантРасчетаСправедливойСтоимости",	ПараметрыОценки.ВариантРасчетаОценочнойСтоимости);
				ПараметрыОценкиБумаг.Вставить("ПараметрыПолученияПартий",				Неопределено);
				ПараметрыОценкиБумаг.Вставить("Клиент",									ПараметрыОценки.Клиент);
				ПараметрыОценкиБумаг.Вставить("ТолькоНаблюдаемыеЦены",					Истина);
				
				ТаблицаСтоимостиАналогов = РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС(ПараметрыОценкиБумаг, НачалоДня(ПараметрыДенежногоПотока.ДатаПереоценки), ТаблицаАналогов, , ОшибкаРасчета);

				Если ОшибкаРасчета Тогда
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						СтрШаблон("Ошибка проверки активности рынка аналогов на %1 для расчета ставки дисконтирования '%2'",
							Формат(ПараметрыДенежногоПотока.ДатаПереоценки, "ДФ=dd.MM.yyyy"), СтрокаСтоимостейЦБ.ЦеннаяБумага), , , , Отказ);
					
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);		
					Продолжить;
					
				КонецЕсли;
			
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ТаблицаСтоимостей.ЦеннаяБумага КАК ЦеннаяБумага,
					|	ТаблицаСтоимостей.Стоимость КАК Цена,
					|	ТаблицаСтоимостей.УровеньОценки КАК УровеньОценки,
					|	ТаблицаСтоимостей.УровеньОценки = 1 КАК ПроверкаПройдена
					|ПОМЕСТИТЬ _ТаблицаСтоимостейАналогов
					|ИЗ
					|	&ТаблицаСтоимостей КАК ТаблицаСтоимостей
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_Аналоги.ЦеннаяБумага КАК ЦеннаяБумага,
					|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ТаблицаСтоимостейАналогов.ЦеннаяБумага) КАК Количество,
					|	""Количество аналогов >= 3"" КАК Условие,
					|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ТаблицаСтоимостейАналогов.ЦеннаяБумага) >= 3 КАК ПроверкаПройдена
					|ПОМЕСТИТЬ _КоличествоАналоговПрошедшихПроверкуАктивностиРынка
					|ИЗ
					|	_Аналоги КАК _Аналоги
					|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаСтоимостейАналогов КАК _ТаблицаСтоимостейАналогов
					|		ПО (_ТаблицаСтоимостейАналогов.ЦеннаяБумага = _Аналоги.Аналог)
					|			И (_ТаблицаСтоимостейАналогов.ПроверкаПройдена)
					|
					|СГРУППИРОВАТЬ ПО
					|	_Аналоги.ЦеннаяБумага
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_Аналоги.ЦеннаяБумага КАК ЦеннаяБумага,
					|	_Аналоги.Аналог КАК Аналог,
					|	_Аналоги.Клиент КАК Клиент,
					|	КотировкиТорговыхПлощадок.YIELDATWAP КАК YIELDATWAP,
					|	КотировкиТорговыхПлощадок.VALUE КАК VALUE,
					|	КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность КАК VALUE_ВВалютеУчета,
					|	КотировкиТорговыхПлощадок.YIELDATWAP * КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность КАК YIELDATWAP_VALUE_ВВалютеУчета,
					|	КотировкиТорговыхПлощадок.WAPRICE КАК WAPRICE,
					|	КотировкиТорговыхПлощадок.LEGALCLOSEPRICE КАК LEGALCLOSEPRICE,
					|	КотировкиТорговыхПлощадок.BID КАК BID,
					|	КотировкиТорговыхПлощадок.OFFER КАК OFFER,
					|	НоминалыАналогов.Номинал КАК Номинал
					|ИЗ
					|	_Аналоги КАК _Аналоги
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КоличествоАналоговПрошедшихПроверкуАктивностиРынка КАК _КоличествоАналогов
					|		ПО (_КоличествоАналогов.ЦеннаяБумага = _Аналоги.ЦеннаяБумага)
					|			И (_КоличествоАналогов.ПроверкаПройдена)
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаСтоимостейАналогов КАК _ТаблицаСтоимостейАналогов
					|		ПО (_ТаблицаСтоимостейАналогов.ЦеннаяБумага = _Аналоги.Аналог)
					|			И (_ТаблицаСтоимостейАналогов.ПроверкаПройдена)
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
					|		ПО (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
					|			И (КотировкиТорговыхПлощадок.ЦеннаяБумага = _Аналоги.Аналог)
					|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
					|			И (КотировкиТорговыхПлощадок.Период = &ПоследняяДатаТоргов)
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
					|		ПО (КурсыВалют.Валюта = КотировкиТорговыхПлощадок.Валюта)
					|			И (КурсыВалют.Период = &ДатаПереоценки)
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
					|				&ДатаПереоценки,
					|				ЦеннаяБумага В
					|					(ВЫБРАТЬ
					|						_Аналоги.Аналог
					|					ИЗ
					|						_Аналоги)) КАК НоминалыАналогов
					|		ПО (НоминалыАналогов.ЦеннаяБумага = _Аналоги.Аналог)";
				
				Запрос.УстановитьПараметр("ТаблицаСтоимостей",		ТаблицаСтоимостиАналогов);
				Запрос.УстановитьПараметр("ПоследняяДатаТоргов",	СтрокаСтоимостейЦБ.ПоследняяДатаТоргов);
				Запрос.УстановитьПараметр("ММВБ",					ММВБ);
				
				Если РасшифровкаРасчета = Неопределено Тогда
					КотировкиАналогов = Запрос.Выполнить().Выгрузить();
				Иначе
					КотировкиАналогов = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получение котировок аналогов", "Котировки аналогов", , , , Истина);
				КонецЕсли;
					
				#КонецОбласти

			КонецЕсли;
			
			КотировкиАналоговТекущейЦБ = КотировкиАналогов.Скопировать(Новый Структура("ЦеннаяБумага", СтрокаСтоимостейЦБ.ЦеннаяБумага)); 
			Если КотировкиАналоговТекущейЦБ.Количество() < 3 Тогда
				Если РасшифровкаРасчета <> Неопределено Тогда
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Расчет цены по аналогам", Новый Структура("Аналоги", "Нет аналогов"));
				КонецЕсли;
				Продолжить;
			КонецЕсли;				
			
			//     Σ YIELDATWAP(i) * VALUE(i)
			// r = ——————————————————————————
			//             Σ VALUE(i)
			
			СтавкаДисконтирования = КотировкиАналоговТекущейЦБ.Итог("YIELDATWAP_VALUE_ВВалютеУчета") / КотировкиАналоговТекущейЦБ.Итог("VALUE_ВВалютеУчета");		
			
			ДенежныйПоток			= Справочники.Облигации.ПолучитьДенежныйПоток(СтрокаСтоимостейЦБ.ЦеннаяБумага, ПараметрыДенежногоПотока, ПараметрыОценки, Отказ, РасшифровкаРасчета);
			ПриведеннаяСтоимость	= РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтавкаДисконтирования, ДатаПереоценки, ПараметрыОценки);
			РасчетнаяЦена			= ПриведеннаяСтоимость - СтрокаСтоимостейЦБ.Купон; 	
				
			OFFER	= СтрокаСтоимостейЦБ.OFFER * СтрокаСтоимостейЦБ.Номинал / 100;
			BID		= СтрокаСтоимостейЦБ.BID * СтрокаСтоимостейЦБ.Номинал / 100;
			
			Если НЕ ТестироватьРассчитаннуюПоАналогамЦену
				ИЛИ (OFFER = 0 ИЛИ BID = 0
					ИЛИ BID < РасчетнаяЦена И РасчетнаяЦена < OFFER 	
					ИЛИ OFFER < РасчетнаяЦена И РасчетнаяЦена < BID) 	
			Тогда
				
				СтрокаСтоимостейЦБ.Стоимость		= РасчетнаяЦена;
				СтрокаСтоимостейЦБ.ДатаЦены			= ДатаПереоценки;
				СтрокаСтоимостейЦБ.УровеньОценки	= 2;
				СтрокаСтоимостейЦБ.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
				СтрокаСтоимостейЦБ.Источник			= КотировкиАналоговТекущейЦБ[0].Клиент;
				СтрокаСтоимостейЦБ.ВалютаКотировки	= СтрокаСтоимостейЦБ.ВалютаНоминала;

				Если РасшифровкаРасчета <> Неопределено Тогда
					ПараметрыРасчетаЦен = Новый Структура("СтавкаДисконтирования, ПриведеннаяСтоимость, НКД, РасчетнаяЦена, OFFER, BID, ТестироватьЦену, Цена",
						СтавкаДисконтирования, ПриведеннаяСтоимость, СтрокаСтоимостейЦБ.Купон, РасчетнаяЦена, OFFER, BID, ТестироватьРассчитаннуюПоАналогамЦену, СтрокаСтоимостейЦБ.Стоимость);
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Расчет по модели дисконтирования стоимости будущих денежных потоков", ПараметрыРасчетаЦен);
				КонецЕсли;
			
				ВыполненРасчетЦены = Истина;
				
			КонецЕсли;

			#КонецОбласти
			
		КонецЕсли;

	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "После расчета цен", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;	
	
КонецФункции

Функция ПолучитьЦеныНефтегарантаСЧА(Организация, СчетДоверительногоУправления, ДатаПереоценки, ТаблицаЦБ, РасшифровкаРасчета = Неопределено) 
	
	// согласно письму делаем такой хардход
	Если ДатаПереоценки >= Дата(2018, 06, 29)  Тогда
		
		// У нас последний день месяца - ДА!
		Если КонецМесяца(ДатаПереоценки) = КонецДня(ДатаПереоценки) Тогда
			
			ПоследнийТорговыйДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(), НачалоДня(ДатаПереоценки));
			
			// Он не торговый? - ДА!
            Если НачалоДня(ПоследнийТорговыйДень) <> НачалоДня(ДатаПереоценки) Тогда
			
				// Считать справедливую? - НЕТ!
				// Взять справедливую последнего торгогого дня? - ДА!
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
					|	СтоимостьПереоценки.Рынок КАК Рынок,
					|	СтоимостьПереоценки.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
					|	СтоимостьПереоценки.ЦеннаяБумага.ВалютаНоминала КАК ВалютаКупона,
					|	СтоимостьПереоценки.ЦенаКотировки КАК Стоимость,
					|	СтоимостьПереоценки.ВидЦены КАК ВидЦены,
					|	СтоимостьПереоценки.ДатаЦены КАК ДатаЦены,
					|	СтоимостьПереоценки.УровеньОценки КАК УровеньОценки,
					|	СтоимостьПереоценки.Источник КАК Источник,
					|	СтоимостьПереоценки.ВалютаКотировки КАК ВалютаКотировки,
					|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
					|	0 КАК Купон
					|ИЗ
					|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних КАК НоминалыЦенныхБумагСрезПоследних
					|		ПО СтоимостьПереоценки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
					|ГДЕ
					|	СтоимостьПереоценки.Период = &Период
					|	И СтоимостьПереоценки.Организация = &Организация
					|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
					|	И СтоимостьПереоценки.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
					|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
					|	И СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ЕдиныйПланСчетов)
					|	И &ФильтрПоЦБ";
				
				Запрос.УстановитьПараметр("Период", НачалоДня(ПоследнийТорговыйДень));
				Запрос.УстановитьПараметр("Организация", Организация);
				Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);

				Если РасшифровкаРасчета = Неопределено Тогда
					Запрос.УстановитьПараметр("ФильтрПоЦБ", Истина);
				Иначе
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрПоЦБ", "СтоимостьПереоценки.ЦеннаяБумага = &ФильтрПоЦБ");
					Запрос.УстановитьПараметр("ФильтрПоЦБ", РасшифровкаРасчета.ЦеннаяБумага);
				КонецЕсли;
				
				ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
				
				Если РасшифровкаРасчета <> Неопределено Тогда
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат запроса", "Cправедливые цены последнего торгового дня", ТаблицаСтоимостейЦБ.Скопировать());		
				КонецЕсли;
				
				// Ну и купон посчитать конечно потом.
				Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
				
					Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
					
						СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, СчетДоверительногоУправления);
					
					КонецЕсли;
				
				КонецЦикла;
				
				Если РасшифровкаРасчета <> Неопределено Тогда
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "После заполнения расчетного купона", ТаблицаСтоимостейЦБ.Скопировать());		
				КонецЕсли;
				
				Возврат ТаблицаСтоимостейЦБ;
				
			КонецЕсли;
		
		КонецЕсли;
	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(Облигации.ДатаНачалаОбращения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаОбращения,
		|	ЕСТЬNULL(Облигации.ДатаНачалаРазмещения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаРазмещения,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК Торгуется,
		|	ЕСТЬNULL(Облигации.ДатаПогашения <> ДАТАВРЕМЯ(1, 1, 1)
		|			И Облигации.ДатаПогашения < ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -7), ЛОЖЬ) КАК СчитаемЧтоДефолт,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, НЕОПРЕДЕЛЕНО) КАК ДатаПогашения,
		|	Облигации.Эмитент.ЮрФизЛицо КАК ЭмитентОблигации
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				Статус = ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже)
		|					И Биржа = &ММВБ
		|					И ЦеннаяБумага В
		|						(ВЫБРАТЬ
		|							ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|						ИЗ
		|							ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиТорговыхПлощадок.Рынок КАК Рынок,
		|	КотировкиТорговыхПлощадок.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.Период КАК Период,
		|	СУММА(КотировкиТорговыхПлощадок.NUMTRADES) КАК NUMTRADES,
		|	СУММА(КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность) КАК VALUE
		|ПОМЕСТИТЬ _КотировкиММВБЗаПоследние10ТорговыхДней
		|ИЗ
		|	РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаЦБ КАК ТаблицаЦБ
		|		ПО КотировкиТорговыхПлощадок.Рынок = ТаблицаЦБ.Рынок
		|			И КотировкиТорговыхПлощадок.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага
		|			И (КотировкиТорговыхПлощадок.Период >= &ТорговыхДнейНазад10)
		|			И (КотировкиТорговыхПлощадок.Период <= &ДатаПереоценки)
		|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		|			И (НЕ КотировкиТорговыхПлощадок.РежимТоргов.РЕПО
		|				ИЛИ &ВключатьРежимРепо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта
		|			И КотировкиТорговыхПлощадок.Период = КурсыВалют.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	КотировкиТорговыхПлощадок.Рынок,
		|	КотировкиТорговыхПлощадок.ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	&ДатаПереоценки КАК Период,
		|	&ММВБ КАК Биржа,
		|	КоличествоСделокЗаПоследние10ТорговыхДней.NUMTRADES КАК NUMTRADES,
		|	МаксОбъемТорговЗаПоследние10ТорговыхДней.VALUE КАК VALUE
		|ПОМЕСТИТЬ АктивыйРынокММВБОбъемТоргов
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_КотировкиММВБЗаПоследние10ТорговыхДней.Рынок КАК Рынок,
		|			_КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага КАК ЦеннаяБумага,
		|			СУММА(_КотировкиММВБЗаПоследние10ТорговыхДней.NUMTRADES) КАК NUMTRADES
		|		ИЗ
		|			_КотировкиММВБЗаПоследние10ТорговыхДней КАК _КотировкиММВБЗаПоследние10ТорговыхДней
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_КотировкиММВБЗаПоследние10ТорговыхДней.Рынок,
		|			_КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага) КАК КоличествоСделокЗаПоследние10ТорговыхДней
		|		ПО ТаблицаЦБ.Рынок = КоличествоСделокЗаПоследние10ТорговыхДней.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КоличествоСделокЗаПоследние10ТорговыхДней.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_КотировкиММВБЗаПоследние10ТорговыхДней.Рынок КАК Рынок,
		|			_КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага КАК ЦеннаяБумага,
		|			МАКСИМУМ(_КотировкиММВБЗаПоследние10ТорговыхДней.VALUE) КАК VALUE
		|		ИЗ
		|			_КотировкиММВБЗаПоследние10ТорговыхДней КАК _КотировкиММВБЗаПоследние10ТорговыхДней
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_КотировкиММВБЗаПоследние10ТорговыхДней.Рынок,
		|			_КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага) КАК МаксОбъемТорговЗаПоследние10ТорговыхДней
		|		ПО ТаблицаЦБ.Рынок = МаксОбъемТорговЗаПоследние10ТорговыхДней.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = МаксОбъемТорговЗаПоследние10ТорговыхДней.ЦеннаяБумага
		|ГДЕ
		|	КоличествоСделокЗаПоследние10ТорговыхДней.NUMTRADES >= 10
		|	И МаксОбъемТорговЗаПоследние10ТорговыхДней.VALUE >= 500000
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""Т.к. кроме ММВБ других котировок нет, то выбор основного рынка пока не делаем"" КАК Комментарий,
		|	АктивыйРынокММВБОбъемТоргов.Рынок КАК Рынок,
		|	АктивыйРынокММВБОбъемТоргов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	&ДатаПереоценки КАК Период,
		|	АктивыйРынокММВБОбъемТоргов.Биржа КАК Биржа
		|ПОМЕСТИТЬ ОсновныеРынкиЦБ
		|ИЗ
		|	АктивыйРынокММВБОбъемТоргов КАК АктивыйРынокММВБОбъемТоргов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиЦенныхБумагСводныеСрезПоследних.Период КАК Период,
		|	КотировкиЦенныхБумагСводныеСрезПоследних.Биржа КАК Биржа,
		|	ЕСТЬNULL(КотировкиЦенныхБумаг.WAPRICE, 0) КАК WAPRICE,
