Процедура ЗаполнитьПервичноеРазмещениеВолгиКапитал(СтрокаПереоценкиЦБ, ДатаПереоценки, ОбъектДокумента) Экспорт
	//первичное размещение
	ТекСделка = СтрокаПереоценкиЦБ.Партия;
	ТекЦБ = СтрокаПереоценкиЦБ.ЦеннаяБумага;
	Если ТипЗнч(ТекСделка) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
		ТекСделка = ТекСделка.Основание;
	КонецЕсли;
	Если СтрокаПереоценкиЦБ.РыночнаяЦена = 0 И СтрокаПереоценкиЦБ.УровеньОценки<>1 И ТипЗнч(ТекСделка) = Тип("ДокументСсылка.Сделка") И ТекСделка.ПервичноеРазмещение Тогда
        //по приобретению
		Если СтрокаПереоценкиЦБ.РыночнаяЦена = 0 Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток + БухПартииЦенныхБумагОстатки.РасходыПриПокупкеВСтоимостиОстаток КАК ФактическиеЗатраты,
				|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
				|	НоминалыЦенныхБумагСрезПоследнихПриПокупке.Номинал КАК НоминалПриПокупке
				|ИЗ
				|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
				|			&НаКонецДня,
				|			СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И Рынок = &Рынок
				|				И ЦеннаяБумага = &ЦеннаяБумага
				|				И УчетныйАктивЕПС = &УчетныйАктивЕПС
				|				И Партия = &Партия
				|				И СтрокаПартии = &СтрокаПартии
				|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагОстатки
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследних
				|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПокупки, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследнихПриПокупке
				|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследнихПриПокупке.ЦеннаяБумага";
			
			Запрос.УстановитьПараметр("ВидУчета", ОбъектДокумента.ВидУчета);
			Запрос.УстановитьПараметр("НаКонецДня", Новый Граница(КонецДня(ДатаПереоценки), ВидГраницы.Включая));
			Запрос.УстановитьПараметр("Партия", СтрокаПереоценкиЦБ.Партия);
			Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
			Запрос.УстановитьПараметр("ДатаПокупки", НачалоДня(СтрокаПереоценкиЦБ.Партия.Дата));
			Запрос.УстановитьПараметр("Рынок", СтрокаПереоценкиЦБ.Рынок);
			Запрос.УстановитьПараметр("СтрокаПартии", СтрокаПереоценкиЦБ.СтрокаПартии);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("УчетныйАктивЕПС", СтрокаПереоценкиЦБ.УчетныйАктивЕПС);
			Запрос.УстановитьПараметр("ЦеннаяБумага", СтрокаПереоценкиЦБ.ЦеннаяБумага);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
				СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.ЦенаПриобретения;
				СтрокаПереоценкиЦБ.УровеньОценки = 1;
				СтрокаПереоценкиЦБ.ДатаКотировки = СтрокаПереоценкиЦБ.Партия.Дата;
				
				Стоимость = ВыборкаДетальныеЗаписи.ФактическиеЗатраты;
				СтрокаПереоценкиЦБ.РыночнаяЦена = Стоимость * ВыборкаДетальныеЗаписи.Номинал/ ВыборкаДетальныеЗаписи.НоминалПриПокупке / СтрокаПереоценкиЦБ.Количество;
				Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
					
					СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = Стоимость / ВыборкаДетальныеЗаписи.Номинал * 100;
					//СтрокаПереоценкиЦБ.ОценочнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент;
					
				КонецЕсли;
				СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
				СтрокаПереоценкиЦБ.ВалютаКотировки = ТекЦБ.ВалютаНоминала;
				
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	//уровень2
	Если СтрокаПереоценкиЦБ.РыночнаяЦена = 0 
		И (СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции ИЛИ СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации) Тогда
		
		ММВБ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СУММА(БухПартииЦенныхБумагОстатки.СтоимостьОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаОстаток + БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток + БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток + БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток) КАК Поле1,
			|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага,
			|	СУММА(КотировкиТорговыхПлощадок10Дней.VALUE) КАК VALUE
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
			|			&КонецДняПереоценки,
			|			СчетДоверительногоУправления = &CчетДоверительногоУправления
			|				И Рынок = &Рынок
			|				И ЦеннаяБумага = &ЦеннаяБумага
			|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагОстатки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок10Дней
			|		ПО БухПартииЦенныхБумагОстатки.Рынок = КотировкиТорговыхПлощадок10Дней.Рынок
			|			И БухПартииЦенныхБумагОстатки.ЦеннаяБумага = КотировкиТорговыхПлощадок10Дней.ЦеннаяБумага
			|			И (КотировкиТорговыхПлощадок10Дней.РежимТоргов.ОсновнойРежим)
			|			И (КотировкиТорговыхПлощадок10Дней.Биржа = &ММВБ)
			|			И (КотировкиТорговыхПлощадок10Дней.Период МЕЖДУ &ТорговыхДнейНазад10 И &ДатаПереоценки)
			|
			|СГРУППИРОВАТЬ ПО
			|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага
			|
			|ИМЕЮЩИЕ
			|	СУММА(БухПартииЦенныхБумагОстатки.СтоимостьОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаОстаток + БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток + БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток + БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток) <= СУММА(КотировкиТорговыхПлощадок10Дней.VALUE) * 0.001";
			
			
		ТорговыхДнейНазад10 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -10);
		ТорговыхДнейНазад90 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -90);
		
		Запрос.УстановитьПараметр("CчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ВидУчета", ОбъектДокумента.ВидУчета);
		Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
		Запрос.УстановитьПараметр("КонецДняПереоценки", Новый Граница(КонецДня(ДатаПереоценки), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("ММВБ", ММВБ);
		Запрос.УстановитьПараметр("Рынок", СтрокаПереоценкиЦБ.Рынок);
		Запрос.УстановитьПараметр("ТорговыхДнейНазад10", ?(СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции, ТорговыхДнейНазад10, ТорговыхДнейНазад90));
		Запрос.УстановитьПараметр("ЦеннаяБумага", ТекЦБ);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи1 = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи1.Следующий() Цикл
			//получим цену спроса на 10 или 90 дней
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
				|	ВЫБОР
				|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
				|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID * НоминалыЦенныхБумагСрезПоследних.Номинал / 100
				|		ИНАЧЕ КотировкиТорговыхПлощадокСводныеСрезПоследних.BID
				|	КОНЕЦ КАК BID,
				|	КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE КАК BID_DATE,
				|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа.ЮрФизЛицо КАК ИсточникЦены,
				|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта КАК Валюта
				|ИЗ
				|	РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
				|			&ДатаПереоценки,
				|			РежимТоргов.ОсновнойРежим
				|				И Рынок = &Рынок
				|				И ЦеннаяБумага = &ЦеннаяБумага
				|				И Биржа = &ММВБ) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследних
				|		ПО КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
				|ГДЕ
				|	КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE >= &ТорговыхДнейНазад90
				|	И КотировкиТорговыхПлощадокСводныеСрезПоследних.BID > 0";
			
			Запрос.УстановитьПараметр("ТорговыхДнейНазад90", ?(СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции, ТорговыхДнейНазад10, ТорговыхДнейНазад90));
			Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
			Запрос.УстановитьПараметр("ММВБ", ММВБ);
			Запрос.УстановитьПараметр("Рынок", СтрокаПереоценкиЦБ.Рынок);
			Запрос.УстановитьПараметр("ЦеннаяБумага", ТекЦБ);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				СтрокаПереоценкиЦБ.Биржа = ММВБ;
				СтрокаПереоценкиЦБ.ИсточникЦены = ВыборкаДетальныеЗаписи.ИсточникЦены;
				СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.ЦенаСпроса;
				СтрокаПереоценкиЦБ.УровеньОценки = 2;
				СтрокаПереоценкиЦБ.ДатаКотировки = ВыборкаДетальныеЗаписи.BID_DATE;
				
				СтрокаПереоценкиЦБ.РыночнаяЦена =  ВыборкаДетальныеЗаписи.BID;
				Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
					СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦена / ВыборкаДетальныеЗаписи.Номинал * 100;
				КонецЕсли;
				
				СтрокаПереоценкиЦБ.ЦенаКотировки =  СтрокаПереоценкиЦБ.РыночнаяЦена;
				СтрокаПереоценкиЦБ.ВалютаКотировки =  ВыборкаДетальныеЗаписи.Валюта;
				
				Прервать;
			КонецЦикла;
	
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПервичноеРазмещениеВолгиКапитал2018(СтрокаПереоценкиЦБ, ДатаПереоценки, ОбъектДокумента) Экспорт
	
	Если ЗначениеЗаполнено(СтрокаПереоценкиЦБ.РыночнаяЦена) ИЛИ СтрокаПереоценкиЦБ.УровеньОценки = 1 Тогда
		Возврат;
	КонецЕсли;
	
	//первичное размещение
	
	ТекЦБ = СтрокаПереоценкиЦБ.ЦеннаяБумага;
	
	ТекСделка = СтрокаПереоценкиЦБ.Партия;
	ДатаПокупки = НачалоДня(ТекСделка.Дата);
	Если ТипЗнч(ТекСделка) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
		ТекСделка = ТекСделка.Основание;
	КонецЕсли;
	
	Если ТипЗнч(ТекСделка) = Тип("ДокументСсылка.Сделка") И ТекСделка.ПервичноеРазмещение 
		И ДатаПокупки + 30 * 86400  >= ДатаПереоценки Тогда
		
		Если ДатаПокупки = ДатаПереоценки 
			ИЛИ НЕ ЗначениеЗаполнено(СтрокаПереоценкиЦБ.ПолеЦены)
			И ТекСделка.РежимБиржевыхТоргов.Аукцион Тогда // И СтрНайти(НРег(ТекСделка.РежимБиржевыхТоргов.Наименование), "аукцион") > 0 Тогда
			
			//по приобретению
			МассивТиповПартии = Новый Массив;
			МассивТиповПартии.Добавить(Тип("ДокументСсылка.Сделка"));
			МассивТиповПартии.Добавить(Тип("ДокументСсылка.СделкаРЕПО"));
			МассивТиповПартии.Добавить(Тип("ДокументСсылка.ПоставкаЦенныхБумаг"));
			МассивТиповПартии.Добавить(Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке"));
			МассивТиповПартии.Добавить(Тип("ДокументСсылка.ВводЦенныхБумаг"));
			
			ТаблицаЦБ = Новый ТаблицаЗначений;
			ТаблицаЦБ.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов( "Число"));
			ТаблицаЦБ.Колонки.Добавить("ЦеннаяБумага", Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
			ТаблицаЦБ.Колонки.Добавить("Партия", Новый ОписаниеТипов(МассивТиповПартии));
			ТаблицаЦБ.Колонки.Добавить("СтрокаПартии", Новый ОписаниеТипов("Число"));
			ТаблицаЦБ.Колонки.Добавить("УчетныйАктивЕПС", Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
			ТаблицаЦБ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
			
			Строка = ТаблицаЦБ.Добавить();
			Строка.НомерСтроки = 1;
			Строка.ЦеннаяБумага = ТекЦБ;
			Строка.Партия = СтрокаПереоценкиЦБ.Партия;
			Строка.СтрокаПартии = СтрокаПереоценкиЦБ.СтрокаПартии;
			Строка.УчетныйАктивЕПС = СтрокаПереоценкиЦБ.УчетныйАктивЕПС;
			Строка.Количество = СтрокаПереоценкиЦБ.Количество;
			
			ДатыПокупкиИЦены = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(ТаблицаЦБ, ОбъектДокумента.СчетДоверительногоУправления ,ДатаПереоценки).Выгрузить();
			Если ДатыПокупкиИЦены.Количество() > 0 Тогда
				
				ТекСтрокаДатИЦен = ДатыПокупкиИЦены[0];
				
				СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.ЦенаПриобретения;
				СтрокаПереоценкиЦБ.УровеньОценки = ?(ДатаПокупки = ДатаПереоценки, 1, 3);
				СтрокаПереоценкиЦБ.ДатаКотировки = ДатаПокупки;
				
				НоминалНаДатуПокупки = Справочники.Облигации.ПолучитьНоминал(ТекЦБ, СтрокаПереоценкиЦБ.ДатаКотировки);
				НоминалТекущий		 = Справочники.Облигации.ПолучитьНоминал(ТекЦБ, ДатаПереоценки);
				СтрокаПереоценкиЦБ.РыночнаяЦена = ТекСтрокаДатИЦен.ЦенаПокупки * НоминалТекущий/ НоминалНаДатуПокупки;
				СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
				СтрокаПереоценкиЦБ.ВалютаКотировки = ТекЦБ.ВалютаНоминала;
				
				Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
					СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦена / НоминалТекущий * 100;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПервичноеРазмещениеСогласия(СтрокаПереоценкиЦБ, ДатаПереоценки, ОбъектДокумента) Экспорт
	//первичное размещение
	ТекСделка = СтрокаПереоценкиЦБ.Партия;
	ТекЦБ = СтрокаПереоценкиЦБ.ЦеннаяБумага;
	Если ТипЗнч(ТекСделка) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
		ТекСделка = ТекСделка.Основание;
	КонецЕсли;
	Если СтрокаПереоценкиЦБ.РыночнаяЦена = 0 И СтрокаПереоценкиЦБ.УровеньОценки<>1 И ТипЗнч(ТекСделка) = Тип("ДокументСсылка.Сделка") И ТекСделка.ПервичноеРазмещение Тогда
		Если (НачалоДня(ДатаПереоценки) - НачалоДня(СтрокаПереоценкиЦБ.Партия.Дата)) / 86400 > 90 Тогда 
			Возврат;
		КонецЕсли;
        //по приобретению
		Если СтрокаПереоценкиЦБ.РыночнаяЦена = 0 Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток КАК СтоимостьПриобретения,
				|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
				|	НоминалыЦенныхБумагСрезПоследнихПриПокупке.Номинал КАК НоминалПриПокупке
				|ИЗ
				|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
				|			&НаКонецДня,
				|			СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И Рынок = &Рынок
				|				И ЦеннаяБумага = &ЦеннаяБумага
				|				И УчетныйАктивЕПС = &УчетныйАктивЕПС
				|				И Партия = &Партия
				|				И СтрокаПартии = &СтрокаПартии
				|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагОстатки
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследних
				|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПокупки, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследнихПриПокупке
				|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследнихПриПокупке.ЦеннаяБумага";
			
			Запрос.УстановитьПараметр("ВидУчета", ОбъектДокумента.ВидУчета);
			Запрос.УстановитьПараметр("НаКонецДня", Новый Граница(КонецДня(ДатаПереоценки), ВидГраницы.Включая));
			Запрос.УстановитьПараметр("Партия", СтрокаПереоценкиЦБ.Партия);
			Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
			Запрос.УстановитьПараметр("ДатаПокупки", НачалоДня(СтрокаПереоценкиЦБ.Партия.Дата));
			Запрос.УстановитьПараметр("Рынок", СтрокаПереоценкиЦБ.Рынок);
			Запрос.УстановитьПараметр("СтрокаПартии", СтрокаПереоценкиЦБ.СтрокаПартии);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("УчетныйАктивЕПС", СтрокаПереоценкиЦБ.УчетныйАктивЕПС);
			Запрос.УстановитьПараметр("ЦеннаяБумага", СтрокаПереоценкиЦБ.ЦеннаяБумага);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
				СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.ЦенаПриобретения;
				СтрокаПереоценкиЦБ.УровеньОценки = 1;
				СтрокаПереоценкиЦБ.ДатаКотировки = СтрокаПереоценкиЦБ.Партия.Дата;
				
				Стоимость = ВыборкаДетальныеЗаписи.СтоимостьПриобретения;
				СтрокаПереоценкиЦБ.РыночнаяЦена = Стоимость * ВыборкаДетальныеЗаписи.Номинал/ ВыборкаДетальныеЗаписи.НоминалПриПокупке / СтрокаПереоценкиЦБ.Количество;
				Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
					
					СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦена / ВыборкаДетальныеЗаписи.Номинал * 100;
					//СтрокаПереоценкиЦБ.ОценочнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент;
					
				КонецЕсли;
				СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
				СтрокаПереоценкиЦБ.ВалютаКотировки = ТекЦБ.ВалютаНоминала;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПервичноеРазмещениеОПК(СтрокаПереоценкиЦБ, ДатаПереоценки, ОбъектДокумента) Экспорт
	//первичное размещение
	ТекСделка = СтрокаПереоценкиЦБ.Партия;
	ТекЦБ = СтрокаПереоценкиЦБ.ЦеннаяБумага;
	Если ТипЗнч(ТекСделка) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
		ТекСделка = ТекСделка.Основание;
	КонецЕсли;
	Если СтрокаПереоценкиЦБ.РыночнаяЦена = 0 И СтрокаПереоценкиЦБ.УровеньОценки<>1 И ТипЗнч(ТекСделка) = Тип("ДокументСсылка.Сделка") И ТекСделка.ПервичноеРазмещение Тогда
		Если (НачалоДня(ДатаПереоценки) - НачалоДня(СтрокаПереоценкиЦБ.Партия.Дата)) / 86400 > 90 Тогда 
			Возврат;
		КонецЕсли;
        //по приобретению
		Если СтрокаПереоценкиЦБ.РыночнаяЦена = 0 Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток + БухПартииЦенныхБумагОстатки.РасходыПриПокупкеВСтоимостиОстаток КАК ФактическиеЗатраты,
				|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
				|	НоминалыЦенныхБумагСрезПоследнихПриПокупке.Номинал КАК НоминалПриПокупке
				|ИЗ
				|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
				|			&НаКонецДня,
				|			СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И Рынок = &Рынок
				|				И ЦеннаяБумага = &ЦеннаяБумага
				|				И УчетныйАктивЕПС = &УчетныйАктивЕПС
				|				И Партия = &Партия
				|				И СтрокаПартии = &СтрокаПартии
				|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагОстатки
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследних
				|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПокупки, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследнихПриПокупке
				|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследнихПриПокупке.ЦеннаяБумага";
			
			Запрос.УстановитьПараметр("ВидУчета", ОбъектДокумента.ВидУчета);
			Запрос.УстановитьПараметр("НаКонецДня", Новый Граница(КонецДня(ДатаПереоценки), ВидГраницы.Включая));
			Запрос.УстановитьПараметр("Партия", СтрокаПереоценкиЦБ.Партия);
			Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
			Запрос.УстановитьПараметр("ДатаПокупки", НачалоДня(СтрокаПереоценкиЦБ.Партия.Дата));
			Запрос.УстановитьПараметр("Рынок", СтрокаПереоценкиЦБ.Рынок);
			Запрос.УстановитьПараметр("СтрокаПартии", СтрокаПереоценкиЦБ.СтрокаПартии);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("УчетныйАктивЕПС", СтрокаПереоценкиЦБ.УчетныйАктивЕПС);
			Запрос.УстановитьПараметр("ЦеннаяБумага", СтрокаПереоценкиЦБ.ЦеннаяБумага);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
				СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.ЦенаПриобретения;
				СтрокаПереоценкиЦБ.УровеньОценки = 1;
				СтрокаПереоценкиЦБ.ДатаКотировки = СтрокаПереоценкиЦБ.Партия.Дата;
				
				Стоимость = ВыборкаДетальныеЗаписи.ФактическиеЗатраты;
				СтрокаПереоценкиЦБ.РыночнаяЦена = Стоимость * ВыборкаДетальныеЗаписи.Номинал/ ВыборкаДетальныеЗаписи.НоминалПриПокупке / СтрокаПереоценкиЦБ.Количество;
				СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
				СтрокаПереоценкиЦБ.ВалютаКотировки = ТекЦБ.ВалютаНоминала;
				Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
					
					СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = Стоимость / ВыборкаДетальныеЗаписи.Номинал * 100;
					//СтрокаПереоценкиЦБ.ОценочнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент;
					
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПервичноеРазмещениеРЭМ(СтрокаПереоценкиЦБ, ДатаПереоценки, ОбъектДокумента) Экспорт
	//цена приобретения или последняя оценочная
	ТекПартия = СтрокаПереоценкиЦБ.Партия;
	ТекЦБ = СтрокаПереоценкиЦБ.ЦеннаяБумага;
	Если СтрокаПереоценкиЦБ.РыночнаяЦена = 0 Тогда
		//получим последнюю оценочную цену
		ДатаОценочнойЦены = Дата(1,1,1);
		ОценочнаяЦена = 0;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьПереоценкиСрезПоследних.Период КАК Период,
			|	СтоимостьПереоценкиСрезПоследних.ВидЦены КАК ВидЦены,
			|	СтоимостьПереоценкиСрезПоследних.УровеньОценки КАК УровеньОценки,
			|	СтоимостьПереоценкиСрезПоследних.ДатаЦены КАК ДатаЦены,
			|	СтоимостьПереоценкиСрезПоследних.Источник КАК Источник,
			|	СтоимостьПереоценкиСрезПоследних.ЦенаКотировки КАК ЦенаКотировки,
			|	СтоимостьПереоценкиСрезПоследних.ВалютаКотировки КАК ВалютаКотировки,
			|	СтоимостьПереоценкиСрезПоследних.Цена КАК Цена,
			|	ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследнихНаДатуОценки.Номинал, 0) КАК НоминалТекущий
			|ИЗ
			|	РегистрСведений.СтоимостьПереоценки.СрезПоследних(
			|			&ДатаПереоценки,
			|			СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)
			|				И ЦеннаяБумага = &ЦеннаяБумага) КАК СтоимостьПереоценкиСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследнихНаДатуОценки
			|		ПО СтоимостьПереоценкиСрезПоследних.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследнихНаДатуОценки.ЦеннаяБумага";
		
		Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки - 86400);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ЦеннаяБумага", ТекЦБ);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если  ВыборкаДетальныеЗаписи.Следующий() Тогда
			ДатаОценочнойЦены = ВыборкаДетальныеЗаписи.Период;
			ОценочнаяЦена = ВыборкаДетальныеЗаписи.Цена;
		КонецЕсли;
		
		Если ТекПартия.Дата > ДатаОценочнойЦены Тогда
			//по приобретению
			МассивТиповПартии = Новый Массив;
			МассивТиповПартии.Добавить(Тип("ДокументСсылка.Сделка"));
			МассивТиповПартии.Добавить(Тип("ДокументСсылка.СделкаРЕПО"));
			МассивТиповПартии.Добавить(Тип("ДокументСсылка.ПоставкаЦенныхБумаг"));
			МассивТиповПартии.Добавить(Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке"));
			МассивТиповПартии.Добавить(Тип("ДокументСсылка.ВводЦенныхБумаг"));
			
			ТаблицаЦБ = Новый ТаблицаЗначений;
			ТаблицаЦБ.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов( "Число"));
			ТаблицаЦБ.Колонки.Добавить("ЦеннаяБумага", Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
			ТаблицаЦБ.Колонки.Добавить("Партия", Новый ОписаниеТипов(МассивТиповПартии));
			ТаблицаЦБ.Колонки.Добавить("СтрокаПартии", Новый ОписаниеТипов("Число"));
			ТаблицаЦБ.Колонки.Добавить("УчетныйАктивЕПС", Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
			ТаблицаЦБ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
			
			Строка = ТаблицаЦБ.Добавить();
			Строка.НомерСтроки = 1;
			Строка.ЦеннаяБумага = ТекЦБ;
			Строка.Партия = СтрокаПереоценкиЦБ.Партия;
			Строка.СтрокаПартии = СтрокаПереоценкиЦБ.СтрокаПартии;
			Строка.УчетныйАктивЕПС = СтрокаПереоценкиЦБ.УчетныйАктивЕПС;
			Строка.Количество = СтрокаПереоценкиЦБ.Количество;
			
			ДатыПокупкиИЦены = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(ТаблицаЦБ, ОбъектДокумента.СчетДоверительногоУправления ,ДатаПереоценки).Выгрузить();
			Если ДатыПокупкиИЦены.Количество() > 0 Тогда
				
				ТекСтрокаДатИЦен = ДатыПокупкиИЦены[0];
				
				СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.ЦенаПриобретения;
				СтрокаПереоценкиЦБ.УровеньОценки = 1;
				СтрокаПереоценкиЦБ.ДатаКотировки = СтрокаПереоценкиЦБ.Партия.Дата;
				
				НоминалНаДатуПокупки = Справочники.Облигации.ПолучитьНоминал(ТекЦБ, СтрокаПереоценкиЦБ.ДатаКотировки);
				НоминалТекущий		 = Справочники.Облигации.ПолучитьНоминал(ТекЦБ, ДатаПереоценки);
				СтрокаПереоценкиЦБ.РыночнаяЦена = ТекСтрокаДатИЦен.ЦенаПокупки * НоминалТекущий/ НоминалНаДатуПокупки;
				СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
				СтрокаПереоценкиЦБ.ВалютаКотировки = ТекЦБ.ВалютаНоминала;
				
				Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
					СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦена / НоминалТекущий * 100;
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли ДатаОценочнойЦены <> Дата(1,1,1) Тогда
			//по последней оценке
			СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
			СтрокаПереоценкиЦБ.ИсточникЦены = ВыборкаДетальныеЗаписи.Источник;
			СтрокаПереоценкиЦБ.ПолеЦены = ВыборкаДетальныеЗаписи.ВидЦены;
			СтрокаПереоценкиЦБ.УровеньОценки = ВыборкаДетальныеЗаписи.УровеньОценки;
			СтрокаПереоценкиЦБ.ДатаКотировки = ВыборкаДетальныеЗаписи.ДатаЦены;
			
			НоминалНаДатуПредыдущейОценки = Справочники.Облигации.ПолучитьНоминал(ТекЦБ, ВыборкаДетальныеЗаписи.Период);
			СтрокаПереоценкиЦБ.РыночнаяЦена = ВыборкаДетальныеЗаписи.Цена * ВыборкаДетальныеЗаписи.НоминалТекущий/ НоминалНаДатуПредыдущейОценки;
			СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
			СтрокаПереоценкиЦБ.ВалютаКотировки = ТекЦБ.ВалютаНоминала;
			
			Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
				СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦена / ВыборкаДетальныеЗаписи.НоминалТекущий * 100;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПервичноеРазмещениеРПИ(СтрокаПереоценкиЦБ, ДатаПереоценки, ОбъектДокумента) Экспорт
	//цена приобретения или последняя оценочная
	ТекПартия = СтрокаПереоценкиЦБ.Партия;
	ТекЦБ = СтрокаПереоценкиЦБ.ЦеннаяБумага;
	Если СтрокаПереоценкиЦБ.РыночнаяЦена = 0 
		ИЛИ СтрокаПереоценкиЦБ.ИсточникЦены = ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg").ЮрФизЛицо		
		И СтрокаПереоценкиЦБ.Партия.Дата >= СтрокаПереоценкиЦБ.ДатаКотировки
		Тогда
		
		Если ТипЗнч(ТекПартия) = Тип("ДокументСсылка.СделкаРЕПО") 
			И СтрокаПереоценкиЦБ.Партия.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			
			Возврат;
		ИначеЕсли ТипЗнч(ТекПартия) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг") 
			И СтрокаПереоценкиЦБ.Партия.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			Возврат;
		КонецЕсли;
			
		//для недопущенных к обращению (п.2.13)
		Если РегистрыСведений.СтатусыЦенныхБумаг.ПолучитьСтатус(ТекЦБ,Перечисления.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже,,,ДатаПереоценки, Ложь) Тогда
			Возврат;
		КонецЕсли;
		
		//по приобретению
		МассивТиповПартии = Новый Массив;
		МассивТиповПартии.Добавить(Тип("ДокументСсылка.Сделка"));
		МассивТиповПартии.Добавить(Тип("ДокументСсылка.СделкаРЕПО"));
		МассивТиповПартии.Добавить(Тип("ДокументСсылка.ПоставкаЦенныхБумаг"));
		МассивТиповПартии.Добавить(Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке"));
		МассивТиповПартии.Добавить(Тип("ДокументСсылка.ВводЦенныхБумаг"));
		
		ТаблицаЦБ = Новый ТаблицаЗначений;
		ТаблицаЦБ.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов( "Число"));
		ТаблицаЦБ.Колонки.Добавить("ЦеннаяБумага", Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
		ТаблицаЦБ.Колонки.Добавить("Партия", Новый ОписаниеТипов(МассивТиповПартии));
		ТаблицаЦБ.Колонки.Добавить("СтрокаПартии", Новый ОписаниеТипов("Число"));
		ТаблицаЦБ.Колонки.Добавить("УчетныйАктивЕПС", Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
		ТаблицаЦБ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
		
		Строка = ТаблицаЦБ.Добавить();
		Строка.НомерСтроки = 1;
		Строка.ЦеннаяБумага = ТекЦБ;
		Строка.Партия = СтрокаПереоценкиЦБ.Партия;
		Строка.СтрокаПартии = СтрокаПереоценкиЦБ.СтрокаПартии;
		Строка.УчетныйАктивЕПС = СтрокаПереоценкиЦБ.УчетныйАктивЕПС;
		Строка.Количество = СтрокаПереоценкиЦБ.Количество;
		
		ДатыПокупкиИЦены = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(ТаблицаЦБ, ОбъектДокумента.СчетДоверительногоУправления ,ДатаПереоценки, Ложь);
		Если НЕ ДатыПокупкиИЦены.пустой() Тогда
			
			ТекСтрокаДатИЦен = ДатыПокупкиИЦены.Выгрузить()[0];
			
			СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
			СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
			СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.ЦенаПриобретения;
			СтрокаПереоценкиЦБ.УровеньОценки = 1;
			СтрокаПереоценкиЦБ.ДатаКотировки = СтрокаПереоценкиЦБ.Партия.Дата;
			
			НоминалНаДатуПокупки = Справочники.Облигации.ПолучитьНоминал(ТекЦБ, СтрокаПереоценкиЦБ.ДатаКотировки);
			НоминалТекущий		 = Справочники.Облигации.ПолучитьНоминал(ТекЦБ, ДатаПереоценки);
			СтрокаПереоценкиЦБ.РыночнаяЦена = ТекСтрокаДатИЦен.ЦенаПокупки * НоминалТекущий/ НоминалНаДатуПокупки;
			СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
			СтрокаПереоценкиЦБ.ВалютаКотировки = ТекЦБ.ВалютаНоминала;
			
			Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
				СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦена / НоминалТекущий * 100;
			КонецЕсли;
			
		КонецЕсли;
		
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПервичноеРазмещениеЛонгТермИнвестментс(СтрокаПереоценкиЦБ, ДатаПереоценки, ОбъектДокумента) Экспорт
	//цена приобретения или последняя оценочная
