		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				РасчетныеЦеныНРД.ЦеннаяБумага КАК ЦеннаяБумага,
		|				МАКСИМУМ(РасчетныеЦеныНРД.Период) КАК Период
		|			ИЗ
		|				РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаЦБ КАК _ТаблицаЦБ
		|					ПО (_ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныНРД.ЦеннаяБумага)
		|						И (_ТаблицаЦБ.Рынок = РасчетныеЦеныНРД.Рынок)
		|						И (РасчетныеЦеныНРД.Период В (&ДатаПереоценки, _ТаблицаЦБ.ПоследняяДатаТоргов))
		|			
		|			СГРУППИРОВАТЬ ПО
		|				РасчетныеЦеныНРД.ЦеннаяБумага) КАК ДатыЦенНРД
		|			ПО (ДатыЦенНРД.ЦеннаяБумага = РасчетныеЦеныНРД.ЦеннаяБумага)
		|				И (ДатыЦенНРД.Период = РасчетныеЦеныНРД.Период)
		|		ПО (РасчетныеЦеныНРД.Рынок = _ТаблицаЦБ.Рынок)
		|			И (РасчетныеЦеныНРД.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (_ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))
		|			И (РасчетныеЦеныНРД.RATE > 0)
		|			И (РасчетныеЦеныНРД.VERSION = ""2"")
		|			И (РасчетныеЦеныНРД.METHOD_NUMBER В (""1"", ""2""))
		|ГДЕ
		|	_ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости = ЛОЖЬ
		|	И _ЦБУровень1.ЦеннаяБумага ЕСТЬ NULL
		|	И ВЫБОР
		|			КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА ИСТИНА
		|			КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|					И РасчетныеЦеныНРД.PRICE > 0
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	РасчетныеЦеныНРД.RATE КАК СправедливаяЦена,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаКотировки,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД) КАК ВидЦены,
		|	РасчетныеЦеныНРД.Период КАК ДатаЦены,
		|	3 КАК УровеньОценки,
		|	&НРД КАК Источник,
		|	NULL КАК РежимТоргов
		|ПОМЕСТИТЬ _ЦБУровень3
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦБУровень1 КАК _ЦБУровень1
		|		ПО (_ЦБУровень1.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦБУровень2 КАК _ЦБУровень2
		|		ПО (_ЦБУровень2.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				РасчетныеЦеныНРД.ЦеннаяБумага КАК ЦеннаяБумага,
		|				МАКСИМУМ(РасчетныеЦеныНРД.Период) КАК Период
		|			ИЗ
		|				РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаЦБ КАК _ТаблицаЦБ
		|					ПО (_ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныНРД.ЦеннаяБумага)
		|						И (_ТаблицаЦБ.Рынок = РасчетныеЦеныНРД.Рынок)
		|						И (РасчетныеЦеныНРД.Период В (&ДатаПереоценки, _ТаблицаЦБ.ПоследняяДатаТоргов))
		|			
		|			СГРУППИРОВАТЬ ПО
		|				РасчетныеЦеныНРД.ЦеннаяБумага) КАК ДатыЦенНРД
		|			ПО (ДатыЦенНРД.ЦеннаяБумага = РасчетныеЦеныНРД.ЦеннаяБумага)
		|				И (ДатыЦенНРД.Период = РасчетныеЦеныНРД.Период)
		|		ПО (РасчетныеЦеныНРД.Рынок = _ТаблицаЦБ.Рынок)
		|			И (РасчетныеЦеныНРД.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (_ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))
		|			И (РасчетныеЦеныНРД.VERSION = ""2"")
		|			И (РасчетныеЦеныНРД.METHOD_NUMBER = ""3"")
		|			И (РасчетныеЦеныНРД.RATE > 0)
		|ГДЕ
		|	_ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости = ЛОЖЬ
		|	И _ЦБУровень1.ЦеннаяБумага ЕСТЬ NULL
		|	И _ЦБУровень2.ЦеннаяБумага ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦБУровень1.Рынок КАК Рынок,
		|	_ЦБУровень1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ЦБУровень1.УровеньОценки КАК УровеньОценки,
		|	_ЦБУровень1.ВидЦены КАК ВидЦены,
		|	_ЦБУровень1.СправедливаяЦена КАК СправедливаяЦена,
		|	_ЦБУровень1.ВалютаКотировки КАК ВалютаКотировки,
		|	_ЦБУровень1.ВалютаКотировки КАК Валюта,
		|	_ЦБУровень1.ДатаЦены КАК ДатаЦены,
		|	_ЦБУровень1.Источник КАК Источник,
		|	_ЦБУровень1.РежимТоргов КАК РежимТоргов
		|ПОМЕСТИТЬ _ОцененныеБумаги
		|ИЗ
		|	_ЦБУровень1 КАК _ЦБУровень1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦБУровень2.Рынок,
		|	_ЦБУровень2.ЦеннаяБумага,
		|	_ЦБУровень2.УровеньОценки,
		|	_ЦБУровень2.ВидЦены,
		|	_ЦБУровень2.СправедливаяЦена,
		|	_ЦБУровень2.ВалютаКотировки,
		|	_ЦБУровень2.ВалютаКотировки,
		|	_ЦБУровень2.ДатаЦены,
		|	_ЦБУровень2.Источник,
		|	_ЦБУровень2.РежимТоргов
		|ИЗ
		|	_ЦБУровень2 КАК _ЦБУровень2
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦБУровень3.Рынок,
		|	_ЦБУровень3.ЦеннаяБумага,
		|	_ЦБУровень3.УровеньОценки,
		|	_ЦБУровень3.ВидЦены,
		|	_ЦБУровень3.СправедливаяЦена,
		|	_ЦБУровень3.ВалютаКотировки,
		|	_ЦБУровень3.ВалютаКотировки,
		|	_ЦБУровень3.ДатаЦены,
		|	_ЦБУровень3.Источник,
		|	_ЦБУровень3.РежимТоргов
		|ИЗ
		|	_ЦБУровень3 КАК _ЦБУровень3
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.Номинал КАК Номинал,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(_ОцененныеБумаги.СправедливаяЦена * _ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|			ИНАЧЕ _ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(_ОцененныеБумаги.ВалютаКотировки, 0) КАК ВалютаКотировки,
		|	ЕСТЬNULL(_ОцененныеБумаги.ВидЦены, 0) КАК ВидЦены,
		|	ЕСТЬNULL(_ОцененныеБумаги.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(_ОцененныеБумаги.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, ЕСТЬNULL(_ОцененныеБумаги.Источник, 0)) КАК Источник,
		|	ЕСТЬNULL(_ОцененныеБумаги.РежимТоргов, 0) КАК РежимТоргов,
		|	0 КАК Купон,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаКупона,
		|	_ТаблицаЦБ.ОблигацияСПлавающейСтавкойИлиНоминалом КАК ОблигацияСПлавающейСтавкойИлиНоминалом,
		|	_ТаблицаЦБ.ИностраннаяЦБ КАК ИностраннаяЦБ,
		|	_ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости КАК ОценкаПоАмортизированнойСтоимости
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОцененныеБумаги КАК _ОцененныеБумаги
		|		ПО (_ОцененныеБумаги.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (Биржи.Ссылка = _ОцененныеБумаги.Источник)";

	#КонецОбласти
	
	ИностранныеУчетныеАктивы				= Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();	
	ОблигацииСПлавающейСтавкойИлиНоминалом	= Справочники.Облигации.ПолучитьОблигацииСПлавающейСтавкойИлиНоминалом(ТаблицаЦБ, ДатаПереоценки, Ложь, Ложь, РасшифровкаРасчета);
	
	ММВБ		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	НРД			= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");	
		
	Запрос.УстановитьПараметр("ДатаПереоценки",							ДатаПереоценки);
		
	Запрос.УстановитьПараметр("ММВБ",									ММВБ);
	Запрос.УстановитьПараметр("НРД",									НРД);
	
	Запрос.УстановитьПараметр("ИностранныеУчетныеАктивы",				ИностранныеУчетныеАктивы);
	Запрос.УстановитьПараметр("ОблигацииСПлавающейСтавкойИлиНоминалом",	ОблигацииСПлавающейСтавкойИлиНоминалом);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Югории 2022", "Таблица стоимостей ЦБ", , , "_ИсходнаяТаблицаЦБ, _ТаблицаДатРасчетныхЦенПаев, _БумагиОцениваемыеПоАмортизированнойСтоимости, _СтатусыЦенныхБумаг, _ЭмитентыЦенныхБумаг, _ПроверкаОтсутствияНесколькихКотировок, _ОцененныеБумаги");		
	КонецЕсли;
	
	#Область Проверка_отсутствия_нескольких_котировок
	
	ПроверкаОтсутствияНесколькихКотировок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ПроверкаОтсутствияНесколькихКотировок"].ПолучитьДанные().Выбрать();
	Пока ПроверкаОтсутствияНесколькихКотировок.Следующий() Цикл
		ТекстОшибки = СтрШаблон("Для бумаги '%1' на %2 на основном рынке имеется несколько котировок, но приоритет котировок не задан.",
			ПроверкаОтсутствияНесколькихКотировок.ЦеннаяБумага,
			Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , , , Отказ);
	КонецЦикла;
	
	#КонецОбласти
	
	Если ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;	
		
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		// Заполнение купона		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления, , СтрокаСтоимостейЦБ.ВалютаКупона);
		КонецЕсли;	
			
	КонецЦикла;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "После расчета цен", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;	

КонецФункции

Функция ПолучитьЦеныЮгорииСтрахование(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)

	ДатаДействияПравил = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(
		, "ДатаНачалаКонтроляСтраховыхКомпанийПоПравилам710П", ПараметрыОценки.СчетДоверительногоУправления); 
		
	Если ДатаДействияПравил <> Неопределено И  ДатаДействияПравил <= ДатаПереоценки Тогда
		Возврат ПолучитьЦеныЮгорииСтрахование710П(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);
	КонецЕсли;

	
	Запрос = Новый Запрос();
	
	// Активный рынок
	// Основной рынок = ММВБ
	// Активный внебиржевой рынок = хотя бы одна котировка за последние 30 дней, включая дату расчета
	// 1 ур = котируется на активных рынках
	// 2ур = косвенная, на неактивных рынках     (цены НКЦ
	// 3ур = экспертная
	//     осн рынок цб в торгах - ММВБ
	//    рублевые облигации и акции рос. эмитентов - российский внебиржевой рынок
	//   иностранные цб -- Любые иностр. рынки
	//  котировка -     1)  WAPRICE в день расчета,  2) WAPRICE за предыдущие 30 дней, 3) расчетные цены НКЦ, 4) BGN (Last_bid) Bloomberg
	// внебиржевой рынок, нне допущенные к торгам на ММВБ -       BGN (Last_bid) Bloomberg
	
	СрокПризнанияРынкаАктивным = 30;
	СрокДействияКотировок = 29;
	
	#Область Запрос
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ТаблицаСпискаЦБ.Рынок КАК Рынок
	|ПОМЕСТИТЬ _ИсходнаяТаблицаЦБ
	|ИЗ
	|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
	|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
	|	Облигации.Категория КАК КатегорияОблигаций,
	|	ЕСТЬNULL(ЕСТЬNULL(Акции.РазмерЭмиссииШт, Облигации.РазмерЭмиссииШт), РасчетныеЦеныПаевСрезПоследних.КоличествоПаев) КАК ОбъемВыпуска,
	|	ВЫБОР
	|		КОГДА Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
	|			ТОГДА &Блумберг
	|		ИНАЧЕ &ММВБ
	|	КОНЕЦ КАК БиржаПоУмолчанию
	|ПОМЕСТИТЬ _ТаблицаЦБ
	|ИЗ
	|	_ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
	|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
	|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
	|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(
	|				&ДатаПереоценки,
	|				ЦеннаяБумага В
	|					(ВЫБРАТЬ
	|						ТаблицаЦБ.ЦеннаяБумага
	|					ИЗ
	|						_ИсходнаяТаблицаЦБ КАК ТаблицаЦБ)) КАК РасчетныеЦеныПаевСрезПоследних
	|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага
	|ПОМЕСТИТЬ _БылиКотировкиЗаПоследние30Дней
	|ИЗ
	|	РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
	|			&ДатаПереоценки,
	|			РежимТоргов.ОсновнойРежим
	|				И ЦеннаяБумага В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						_ТаблицаЦБ.ЦеннаяБумага
	|					ИЗ
	|						_ИсходнаяТаблицаЦБ КАК _ТаблицаЦБ)
	|				И ВЫБОР
	|					КОГДА ЦеннаяБумага ССЫЛКА Справочник.Облигации
	|							И ВЫРАЗИТЬ(ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
	|						ТОГДА Биржа = &Блумберг
	|					ИНАЧЕ Биржа = &ММВБ
	|				КОНЕЦ) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
	|ГДЕ
	|	ВЫБОР
	|			КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	|					И ВЫРАЗИТЬ(КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
	|				ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.LASTPRICE_DATE
	|			ИНАЧЕ КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE_DATE
	|		КОНЕЦ >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -1 * &СрокПризнанияРынкаАктивным)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_ТаблицаЦБ.Рынок КАК Рынок,
	|	_ТаблицаЦБ.Номинал КАК Номинал,
	|	_ТаблицаЦБ.КатегорияОблигаций КАК КатегорияОблигаций,
	|	_ТаблицаЦБ.ОбъемВыпуска КАК ОбъемВыпуска,
	|	_ТаблицаЦБ.БиржаПоУмолчанию КАК БиржаПоУмолчанию,
	|	ВЫБОР
	|		КОГДА НЕ _БылиКотировкиЗаПоследние30Дней.ЦеннаяБумага ЕСТЬ NULL
	|			ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК УровеньОценки
	|ПОМЕСТИТЬ _ТаблицаЦБСУровнямиОценки
	|ИЗ
	|	_ТаблицаЦБ КАК _ТаблицаЦБ
	|		ЛЕВОЕ СОЕДИНЕНИЕ _БылиКотировкиЗаПоследние30Дней КАК _БылиКотировкиЗаПоследние30Дней
	|		ПО _ТаблицаЦБ.ЦеннаяБумага = _БылиКотировкиЗаПоследние30Дней.ЦеннаяБумага
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КотировкиТорговыхПлощадок.WAPRICE КАК WAPRICE,
	|	КотировкиТорговыхПлощадок.WAPRICE_DATE КАК WAPRICE_DATE,
	|	КотировкиТорговыхПлощадок.Рынок КАК Рынок,
	|	КотировкиТорговыхПлощадок.ЦеннаяБумага КАК ЦеннаяБумага,
	|	КотировкиТорговыхПлощадок.Биржа КАК Биржа,
	|	КотировкиТорговыхПлощадок.Валюта КАК Валюта
	|ПОМЕСТИТЬ _ВсеКотировкиТорговыхПлощадок
	|ИЗ
	|	РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
	|			&ДатаПереоценки,
	|			Биржа = &ММВБ
	|				И РежимТоргов.ОсновнойРежим
	|				И НЕ WAPRICE ЕСТЬ NULL
	|				И ЦеннаяБумага В
	|					(ВЫБРАТЬ
	|						ИсходнаяТаблицаЦБ.ЦеннаяБумага
	|					ИЗ
	|						_ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ)
	|				И WAPRICE_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -1 * &СрокДействияКотировок)) КАК КотировкиТорговыхПлощадок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ВсеКотировкиТорговыхПлощадок.WAPRICE КАК WAPRICE,
	|	_ВсеКотировкиТорговыхПлощадок.WAPRICE_DATE КАК WAPRICE_DATE,
	|	_ВсеКотировкиТорговыхПлощадок.Рынок КАК Рынок,
	|	_ВсеКотировкиТорговыхПлощадок.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_ВсеКотировкиТорговыхПлощадок.Биржа КАК Биржа,
	|	_ВсеКотировкиТорговыхПлощадок.Валюта КАК Валюта
	|ПОМЕСТИТЬ _ДействующиеКотировкиТорговыхПлощадок
	|ИЗ
	|	_ВсеКотировкиТорговыхПлощадок КАК _ВсеКотировкиТорговыхПлощадок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			МАКСИМУМ(_ВсеКотировкиТорговыхПлощадок.WAPRICE_DATE) КАК WAPRICE_DATE,
	|			_ВсеКотировкиТорговыхПлощадок.ЦеннаяБумага КАК ЦеннаяБумага,
	|			_ВсеКотировкиТорговыхПлощадок.Биржа КАК Биржа,
	|			_ВсеКотировкиТорговыхПлощадок.Валюта КАК Валюта,
	|			_ВсеКотировкиТорговыхПлощадок.Рынок КАК Рынок
	|		ИЗ
	|			_ВсеКотировкиТорговыхПлощадок КАК _ВсеКотировкиТорговыхПлощадок
	|		
	|		СГРУППИРОВАТЬ ПО
	|			_ВсеКотировкиТорговыхПлощадок.ЦеннаяБумага,
	|			_ВсеКотировкиТорговыхПлощадок.Биржа,
	|			_ВсеКотировкиТорговыхПлощадок.Валюта,
	|			_ВсеКотировкиТорговыхПлощадок.Рынок) КАК _ПоследниеКотировкиФильтр
	|		ПО _ВсеКотировкиТорговыхПлощадок.WAPRICE_DATE = _ПоследниеКотировкиФильтр.WAPRICE_DATE
	|			И _ВсеКотировкиТорговыхПлощадок.Рынок = _ПоследниеКотировкиФильтр.Рынок
	|			И _ВсеКотировкиТорговыхПлощадок.Биржа = _ПоследниеКотировкиФильтр.Биржа
	|			И _ВсеКотировкиТорговыхПлощадок.ЦеннаяБумага = _ПоследниеКотировкиФильтр.ЦеннаяБумага
	|			И _ВсеКотировкиТорговыхПлощадок.Валюта = _ПоследниеКотировкиФильтр.Валюта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ТаблицаЦБ.Номинал КАК Номинал,
	|	ТаблицаЦБ.Рынок КАК Рынок,
	|	ВЫБОР
	|		КОГДА НЕ КотировкиММВБ.WAPRICE ЕСТЬ NULL
	|			ТОГДА КотировкиММВБ.WAPRICE
	|		КОГДА НЕ РасчетныеЦеныНРДСрезПоследних.RATE ЕСТЬ NULL
	|			ТОГДА РасчетныеЦеныНРДСрезПоследних.RATE
	|		КОГДА НЕ КотировкиБлумберг.LASTPRICE ЕСТЬ NULL
	|			ТОГДА КотировкиБлумберг.LASTPRICE
	|	КОНЕЦ КАК СправедливаяЦена,
	|	ВЫБОР
	|		КОГДА НЕ КотировкиММВБ.WAPRICE ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СредневзвешеннаяЦена)
	|		КОГДА НЕ РасчетныеЦеныНРДСрезПоследних.RATE ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД)
	|		КОГДА НЕ КотировкиБлумберг.LASTPRICE ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ЦенаПоследнейСделки)
	|	КОНЕЦ КАК ПолеПереоценки,
	|	ВЫБОР
	|		КОГДА КотировкиБлумберг.LASTPRICE ЕСТЬ NULL
	|				И КотировкиММВБ.WAPRICE ЕСТЬ NULL
	|				И НЕ РасчетныеЦеныНРДСрезПоследних.RATE ЕСТЬ NULL
	|			ТОГДА &НРД
	|		ИНАЧЕ Биржи.ЮрФизЛицо
	|	КОНЕЦ КАК Биржа,
	|	ВЫБОР
	|		КОГДА НЕ КотировкиММВБ.WAPRICE ЕСТЬ NULL
	|			ТОГДА КотировкиММВБ.WAPRICE_DATE
	|		КОГДА НЕ РасчетныеЦеныНРДСрезПоследних.RATE ЕСТЬ NULL
	|			ТОГДА РасчетныеЦеныНРДСрезПоследних.Период
	|		КОГДА НЕ КотировкиБлумберг.LASTPRICE ЕСТЬ NULL
	|			ТОГДА КотировкиБлумберг.LASTPRICE_DATE
	|	КОНЕЦ КАК ДатаЦены,
	|	ТаблицаЦБ.УровеньОценки КАК УровеньОценки,
	|	ВЫБОР
	|		КОГДА НЕ КотировкиММВБ.WAPRICE ЕСТЬ NULL
	|			ТОГДА КотировкиММВБ.Валюта
	|		КОГДА НЕ РасчетныеЦеныНРДСрезПоследних.RATE ЕСТЬ NULL
	|			ТОГДА РасчетныеЦеныНРДСрезПоследних.ЦеннаяБумага.ВалютаНоминала
	|		КОГДА НЕ КотировкиБлумберг.LASTPRICE ЕСТЬ NULL
	|			ТОГДА КотировкиБлумберг.Валюта
	|	КОНЕЦ КАК ВалютаКотировки
	|ПОМЕСТИТЬ _Котировки
	|ИЗ
	|	_ТаблицаЦБСУровнямиОценки КАК ТаблицаЦБ
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ДействующиеКотировкиТорговыхПлощадок КАК КотировкиММВБ
	|		ПО ТаблицаЦБ.Рынок = КотировкиММВБ.Рынок
	|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиММВБ.ЦеннаяБумага
	|			И ТаблицаЦБ.БиржаПоУмолчанию = КотировкиММВБ.Биржа
	|			И (ТаблицаЦБ.УровеньОценки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
	|				&ДатаПереоценки,
	|				Биржа = &Блумберг
	|					И РежимТоргов = &Режим_BGN
	|					И НЕ LASTPRICE ЕСТЬ NULL
	|					И НЕ LASTPRICE_DATE ЕСТЬ NULL
	|					И ЦеннаяБумага В
	|						(ВЫБРАТЬ
	|							ИсходнаяТаблицаЦБ.ЦеннаяБумага
	|						ИЗ
	|							_ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ)) КАК КотировкиБлумберг
	|		ПО ТаблицаЦБ.Рынок = КотировкиБлумберг.Рынок
	|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиБлумберг.ЦеннаяБумага
	|			И ТаблицаЦБ.БиржаПоУмолчанию = КотировкиБлумберг.Биржа
	|			И (ТаблицаЦБ.УровеньОценки = 1
	|				ИЛИ КотировкиБлумберг.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -1 * &СрокПризнанияРынкаАктивным))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
	|		ПО (Биржи.Ссылка = ЕСТЬNULL(КотировкиБлумберг.Биржа, КотировкиММВБ.Биржа))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД.СрезПоследних(
	|				&ДатаПереоценки,
	|				ЦеннаяБумага В
	|					(ВЫБРАТЬ
	|						ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
	|					ИЗ
	|						_ИсходнаяТаблицаЦБ КАК ТаблицаЦБ)) КАК РасчетныеЦеныНРДСрезПоследних
	|		ПО ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныНРДСрезПоследних.ЦеннаяБумага
	|			И (ТаблицаЦБ.УровеньОценки > 1)
	|			И (ТаблицаЦБ.БиржаПоУмолчанию = &ММВБ)
	|			И (РасчетныеЦеныНРДСрезПоследних.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -1 * &СрокПризнанияРынкаАктивным))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ТаблицаЦБ.Рынок КАК Рынок,
	|	ТаблицаЦБ.Номинал КАК Номинал,
	|	ЕСТЬNULL(Котировки.СправедливаяЦена, 0) * ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
	|			ТОГДА ТаблицаЦБ.Номинал / 100
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Стоимость,
	|	Котировки.ПолеПереоценки КАК ВидЦены,
	|	Котировки.ДатаЦены КАК ДатаЦены,
	|	Котировки.УровеньОценки КАК УровеньОценки,
	|	Котировки.Биржа КАК Источник,
	|	Котировки.ВалютаКотировки КАК ВалютаКотировки
	|ИЗ
	|	_ТаблицаЦБ КАК ТаблицаЦБ
	|		ЛЕВОЕ СОЕДИНЕНИЕ _Котировки КАК Котировки
	|		ПО ТаблицаЦБ.ЦеннаяБумага = Котировки.ЦеннаяБумага";
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);	       
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);	 
	Запрос.УстановитьПараметр("ММВБ", 		ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));	
	
	Запрос.УстановитьПараметр("Блумберг", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));	
	Запрос.УстановитьПараметр("Режим_BGN", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));	
	
	Запрос.УстановитьПараметр("НРД", 		ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("Организация", ПараметрыОценки.Организация);	       
	Запрос.УстановитьПараметр("СрокДействияКотировок", СрокДействияКотировок);  	
	Запрос.УстановитьПараметр("СрокПризнанияРынкаАктивным", СрокПризнанияРынкаАктивным); 

	#КонецОбласти
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Югории Страхование (ЕПС)", "Таблица стоимостей ЦБ");		
	Иначе
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныЮгорииСтрахование710П(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)

	Запрос = Новый Запрос();
	
	// Активный рынок
	// Основной рынок = ММВБ
	// Активный внебиржевой рынок = хотя бы одна котировка за последние 30 дней, включая дату расчета
	// warpeice ММВБ на дату переоценки 1ур
	// 1)  WAPRICE в день расчета,  2) WAPRICE за предыдущие 30 дней,3) LAST BID на дату оценнки, 4) •	цена BGN (Bloomberg generic).	
	СрокПризнанияРынкаАктивным = 30;
	СрокДействияКотировок = 29;
	
	#Область Запрос
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ТаблицаСпискаЦБ.Рынок КАК Рынок
	|ПОМЕСТИТЬ _ИсходнаяТаблицаЦБ
	|ИЗ
	|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
	|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
	|	Облигации.Категория КАК КатегорияОблигаций,
	|	ЕСТЬNULL(ЕСТЬNULL(Акции.РазмерЭмиссииШт, Облигации.РазмерЭмиссииШт), РасчетныеЦеныПаевСрезПоследних.КоличествоПаев) КАК ОбъемВыпуска,
	|	ВЫБОР
	|		КОГДА Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
	|			ТОГДА &Блумберг
	|		ИНАЧЕ &ММВБ
	|	КОНЕЦ КАК БиржаПоУмолчанию
	|ПОМЕСТИТЬ _ТаблицаЦБ
	|ИЗ
	|	_ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
	|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
	|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
	|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(
	|				&ДатаПереоценки,
	|				ЦеннаяБумага В
	|					(ВЫБРАТЬ
	|						ТаблицаЦБ.ЦеннаяБумага
	|					ИЗ
	|						_ИсходнаяТаблицаЦБ КАК ТаблицаЦБ)) КАК РасчетныеЦеныПаевСрезПоследних
	|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага
	|ПОМЕСТИТЬ _БылиКотировкиЗаПоследние30Дней
	|ИЗ
	|	РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
	|			&ДатаПереоценки,
	|			РежимТоргов.ОсновнойРежим
	|				И ЦеннаяБумага В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						_ТаблицаЦБ.ЦеннаяБумага
	|					ИЗ
	|						_ИсходнаяТаблицаЦБ КАК _ТаблицаЦБ)
	|				И ВЫБОР
	|					КОГДА ЦеннаяБумага ССЫЛКА Справочник.Облигации
	|							И ВЫРАЗИТЬ(ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
	|						ТОГДА Биржа = &Блумберг
	|					ИНАЧЕ Биржа = &ММВБ
	|				КОНЕЦ) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
	|ГДЕ
	|	ВЫБОР
	|			КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	|					И ВЫРАЗИТЬ(КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
	|				ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.LASTPRICE_DATE
	|			ИНАЧЕ КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE_DATE
	|		КОНЕЦ >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -1 * &СрокПризнанияРынкаАктивным)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_ТаблицаЦБ.Рынок КАК Рынок,
	|	_ТаблицаЦБ.Номинал КАК Номинал,
	|	_ТаблицаЦБ.КатегорияОблигаций КАК КатегорияОблигаций,
	|	_ТаблицаЦБ.ОбъемВыпуска КАК ОбъемВыпуска,
	|	_ТаблицаЦБ.БиржаПоУмолчанию КАК БиржаПоУмолчанию,
	|	ВЫБОР
	|		КОГДА НЕ _БылиКотировкиЗаПоследние30Дней.ЦеннаяБумага ЕСТЬ NULL
	|			ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК УровеньОценки
	|ПОМЕСТИТЬ _ТаблицаЦБСУровнямиОценки
	|ИЗ
	|	_ТаблицаЦБ КАК _ТаблицаЦБ
	|		ЛЕВОЕ СОЕДИНЕНИЕ _БылиКотировкиЗаПоследние30Дней КАК _БылиКотировкиЗаПоследние30Дней
	|		ПО _ТаблицаЦБ.ЦеннаяБумага = _БылиКотировкиЗаПоследние30Дней.ЦеннаяБумага
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КотировкиТорговыхПлощадок.WAPRICE КАК WAPRICE,
	|	КотировкиТорговыхПлощадок.WAPRICE_DATE КАК WAPRICE_DATE,
	|	КотировкиТорговыхПлощадок.Рынок КАК Рынок,
	|	КотировкиТорговыхПлощадок.ЦеннаяБумага КАК ЦеннаяБумага,
	|	КотировкиТорговыхПлощадок.Биржа КАК Биржа,
	|	КотировкиТорговыхПлощадок.Валюта КАК Валюта
	|ПОМЕСТИТЬ _ВсеКотировкиТорговыхПлощадок
	|ИЗ
	|	РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
	|			&ДатаПереоценки,
	|			Биржа = &ММВБ
	|				И РежимТоргов.ОсновнойРежим
	|				И НЕ WAPRICE ЕСТЬ NULL
	|				И ЦеннаяБумага В
	|					(ВЫБРАТЬ
	|						ИсходнаяТаблицаЦБ.ЦеннаяБумага
	|					ИЗ
	|						_ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ)
	|				И WAPRICE_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -1 * &СрокДействияКотировок)) КАК КотировкиТорговыхПлощадок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ВсеКотировкиТорговыхПлощадок.WAPRICE КАК WAPRICE,
	|	_ВсеКотировкиТорговыхПлощадок.WAPRICE_DATE КАК WAPRICE_DATE,
	|	_ВсеКотировкиТорговыхПлощадок.Рынок КАК Рынок,
	|	_ВсеКотировкиТорговыхПлощадок.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_ВсеКотировкиТорговыхПлощадок.Биржа КАК Биржа,
	|	_ВсеКотировкиТорговыхПлощадок.Валюта КАК Валюта
	|ПОМЕСТИТЬ _ДействующиеКотировкиТорговыхПлощадок
	|ИЗ
	|	_ВсеКотировкиТорговыхПлощадок КАК _ВсеКотировкиТорговыхПлощадок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			МАКСИМУМ(_ВсеКотировкиТорговыхПлощадок.WAPRICE_DATE) КАК WAPRICE_DATE,
	|			_ВсеКотировкиТорговыхПлощадок.ЦеннаяБумага КАК ЦеннаяБумага,
	|			_ВсеКотировкиТорговыхПлощадок.Биржа КАК Биржа,
	|			_ВсеКотировкиТорговыхПлощадок.Валюта КАК Валюта,
	|			_ВсеКотировкиТорговыхПлощадок.Рынок КАК Рынок
	|		ИЗ
	|			_ВсеКотировкиТорговыхПлощадок КАК _ВсеКотировкиТорговыхПлощадок
	|		
	|		СГРУППИРОВАТЬ ПО
	|			_ВсеКотировкиТорговыхПлощадок.ЦеннаяБумага,
	|			_ВсеКотировкиТорговыхПлощадок.Биржа,
	|			_ВсеКотировкиТорговыхПлощадок.Валюта,
	|			_ВсеКотировкиТорговыхПлощадок.Рынок) КАК _ПоследниеКотировкиФильтр
	|		ПО _ВсеКотировкиТорговыхПлощадок.WAPRICE_DATE = _ПоследниеКотировкиФильтр.WAPRICE_DATE
	|			И _ВсеКотировкиТорговыхПлощадок.Рынок = _ПоследниеКотировкиФильтр.Рынок
	|			И _ВсеКотировкиТорговыхПлощадок.Биржа = _ПоследниеКотировкиФильтр.Биржа
	|			И _ВсеКотировкиТорговыхПлощадок.ЦеннаяБумага = _ПоследниеКотировкиФильтр.ЦеннаяБумага
	|			И _ВсеКотировкиТорговыхПлощадок.Валюта = _ПоследниеКотировкиФильтр.Валюта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ТаблицаЦБ.Номинал КАК Номинал,
	|	ТаблицаЦБ.Рынок КАК Рынок,
	|	ВЫБОР
	|		КОГДА НЕ КотировкиММВБ.WAPRICE ЕСТЬ NULL
	|			ТОГДА КотировкиММВБ.WAPRICE
	|		КОГДА НЕ КотировкиБлумберг.LASTPRICE ЕСТЬ NULL
	|			ТОГДА КотировкиБлумберг.LASTPRICE
	|	КОНЕЦ КАК СправедливаяЦена,
	|	ВЫБОР
	|		КОГДА НЕ КотировкиММВБ.WAPRICE ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СредневзвешеннаяЦена)
	|		КОГДА НЕ КотировкиБлумберг.LASTPRICE ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ЦенаПоследнейСделки)
	|	КОНЕЦ КАК ПолеПереоценки,
	|	Биржи.ЮрФизЛицо КАК Биржа,
	|	ВЫБОР
	|		КОГДА НЕ КотировкиММВБ.WAPRICE ЕСТЬ NULL
	|			ТОГДА КотировкиММВБ.WAPRICE_DATE
	|		КОГДА НЕ КотировкиБлумберг.LASTPRICE ЕСТЬ NULL
	|			ТОГДА КотировкиБлумберг.LASTPRICE_DATE
	|	КОНЕЦ КАК ДатаЦены,
	|	ТаблицаЦБ.УровеньОценки КАК УровеньОценки,
	|	ВЫБОР
	|		КОГДА НЕ КотировкиММВБ.WAPRICE ЕСТЬ NULL
	|			ТОГДА КотировкиММВБ.Валюта
	|		КОГДА НЕ КотировкиБлумберг.LASTPRICE ЕСТЬ NULL
	|			ТОГДА КотировкиБлумберг.Валюта
	|	КОНЕЦ КАК ВалютаКотировки
	|ПОМЕСТИТЬ _Котировки
	|ИЗ
	|	_ТаблицаЦБСУровнямиОценки КАК ТаблицаЦБ
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ДействующиеКотировкиТорговыхПлощадок КАК КотировкиММВБ
	|		ПО ТаблицаЦБ.Рынок = КотировкиММВБ.Рынок
	|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиММВБ.ЦеннаяБумага
	|			И ТаблицаЦБ.БиржаПоУмолчанию = КотировкиММВБ.Биржа
	|			И (ТаблицаЦБ.УровеньОценки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
	|				&ДатаПереоценки,
	|				Биржа = &Блумберг
	|					И РежимТоргов = &Режим_BGN
	|					И НЕ LASTPRICE ЕСТЬ NULL
	|					И НЕ LASTPRICE_DATE ЕСТЬ NULL
	|					И ЦеннаяБумага В
	|						(ВЫБРАТЬ
	|							ИсходнаяТаблицаЦБ.ЦеннаяБумага
	|						ИЗ
	|							_ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ)) КАК КотировкиБлумберг
	|		ПО ТаблицаЦБ.Рынок = КотировкиБлумберг.Рынок
	|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиБлумберг.ЦеннаяБумага
	|			И ТаблицаЦБ.БиржаПоУмолчанию = КотировкиБлумберг.Биржа
	|			И (ТаблицаЦБ.УровеньОценки = 1
	|				ИЛИ КотировкиБлумберг.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -1 * &СрокПризнанияРынкаАктивным))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
	|		ПО (Биржи.Ссылка = ЕСТЬNULL(КотировкиБлумберг.Биржа, КотировкиММВБ.Биржа))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ТаблицаЦБ.Рынок КАК Рынок,
	|	ТаблицаЦБ.Номинал КАК Номинал,
	|	ЕСТЬNULL(Котировки.СправедливаяЦена, 0) * ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
	|			ТОГДА ТаблицаЦБ.Номинал / 100
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Стоимость,
	|	Котировки.ПолеПереоценки КАК ВидЦены,
	|	Котировки.ДатаЦены КАК ДатаЦены,
	|	Котировки.УровеньОценки КАК УровеньОценки,
	|	Котировки.Биржа КАК Источник,
	|	Котировки.ВалютаКотировки КАК ВалютаКотировки
	|ИЗ
	|	_ТаблицаЦБ КАК ТаблицаЦБ
	|		ЛЕВОЕ СОЕДИНЕНИЕ _Котировки КАК Котировки
	|		ПО ТаблицаЦБ.ЦеннаяБумага = Котировки.ЦеннаяБумага";
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);	       
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);	 
	Запрос.УстановитьПараметр("ММВБ", 		ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));	
	
	Запрос.УстановитьПараметр("Блумберг", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));	
	Запрос.УстановитьПараметр("Режим_BGN", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));	
	 
	Запрос.УстановитьПараметр("Организация", ПараметрыОценки.Организация);	       
	Запрос.УстановитьПараметр("СрокДействияКотировок", СрокДействияКотировок);  	
	Запрос.УстановитьПараметр("СрокПризнанияРынкаАктивным", СрокПризнанияРынкаАктивным); 

	#КонецОбласти
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Югории Страхование (ЕПС)", "Таблица стоимостей ЦБ");		
	Иначе
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныВСК(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	#Область Основной_запрос
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ИсходнаяТаблицаЦБ");
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ВЫБОР
		|		КОГДА (_ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.АОИ)
		|				ИЛИ _ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.АОИБанков)
		|				ИЛИ _ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.АПИ)
		|				ИЛИ _ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.АПИБанков))
		|				И СтатусыЦенныхБумагСрезПоследних.Активен
		|			ТОГДА 1
		|		КОГДА (_ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковРезидентов)
		|				ИЛИ _ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииГосударства)
		|				ИЛИ _ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихРезидентов)
