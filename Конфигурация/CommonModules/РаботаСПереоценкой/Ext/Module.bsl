		|				И (ЦБУровень1_1.OFFER_DATE = &ДатаПереоценки
		|					ИЛИ ЦБУровень1_1.OFFER_DATE = &ПоследнийТорговыйДень)
		|				И ЦБУровень1_1.BID_DATE = ЦБУровень1_1.OFFER_DATE
		|				И (ЦБУровень1_1.OFFER - ЦБУровень1_1.BID) / ЦБУровень1_1.BID < 0.05
		|			ТОГДА 2
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УровеньОценки,
		|	ЦБУровень1_1.Рынок КАК Рынок,
		|	ЦБУровень1_1.Биржа КАК Биржа
		|ПОМЕСТИТЬ РасчетСС1
		|ИЗ
		|	ЦБУровень1_1 КАК ЦБУровень1_1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиЦенныхБумаг КАК КотировкиЦенныхБумаг
		|		ПО ЦБУровень1_1.Рынок = КотировкиЦенныхБумаг.Рынок
		|			И ЦБУровень1_1.Биржа = КотировкиЦенныхБумаг.Биржа
		|			И ЦБУровень1_1.LAST_WAPRICE_DATE = КотировкиЦенныхБумаг.Период
		|			И ЦБУровень1_1.ЦеннаяБумага = КотировкиЦенныхБумаг.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиЦенныхБумаг КАК КотировкиЦенныхБумаг1
		|		ПО ЦБУровень1_1.Рынок = КотировкиЦенныхБумаг1.Рынок
		|			И ЦБУровень1_1.Биржа = КотировкиЦенныхБумаг1.Биржа
		|			И ЦБУровень1_1.CLOSE_DATE = КотировкиЦенныхБумаг1.Период
		|			И ЦБУровень1_1.ЦеннаяБумага = КотировкиЦенныхБумаг1.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиЦенныхБумаг КАК КотировкиЦенныхБумаг2
		|		ПО ЦБУровень1_1.Рынок = КотировкиЦенныхБумаг2.Рынок
		|			И ЦБУровень1_1.Биржа = КотировкиЦенныхБумаг2.Биржа
		|			И ЦБУровень1_1.BID_DATE = КотировкиЦенныхБумаг2.Период
		|			И ЦБУровень1_1.ЦеннаяБумага = КотировкиЦенныхБумаг2.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КотировкиТорговыхПлощадок.Период) КАК Период,
		|	КотировкиТорговыхПлощадок.Биржа КАК Биржа
		|ПОМЕСТИТЬ АктивныйРынокБлумберг
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадок.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
		|			И (КотировкиТорговыхПлощадок.Биржа = &Блумберг)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов = &Режим_BGN)
		|			И (НЕ ТаблицаЦБ.Торгуется)
		|ГДЕ
		|	КотировкиТорговыхПлощадок.Период МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30) И &ДатаПереоценки
		|	И КотировкиТорговыхПлощадок.WAPRICE <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.Рынок,
		|	КотировкиТорговыхПлощадок.Биржа
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КотировкиТорговыхПлощадок.Период) >= 10
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ВЫБОР
		|		КОГДА ТаблицаЦБ.СчитаемЧтоДефолт
		|			ТОГДА 0
		|		КОГДА РасчетСС1.УровеньОценки = 1
		|			ТОГДА РасчетСС1.СправедливаяЦена
		|		КОГДА ЕСТЬNULL(АктивныйРынокБлумберг.Период, 0) <> 0
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE
		|		КОГДА ЕСТЬNULL(РасчетныеЦеныНРД.ЦеннаяБумага, 0) <> 0
		|			ТОГДА ВЫБОР
		|					КОГДА ТИПЗНАЧЕНИЯ(ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|						ТОГДА РасчетныеЦеныНРД.RATE
		|					ИНАЧЕ РасчетныеЦеныНРД.PRICE
		|				КОНЕЦ
		|		КОГДА РасчетСС1.УровеньОценки = 2
		|			ТОГДА РасчетСС1.СправедливаяЦена
		|		КОГДА ЕСТЬNULL(КотировкиТорговыхПлощадокСводныеСрезПоследних.BID, 0) <> 0
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СправедливаяЦена,
		|	ВЫБОР
		|		КОГДА ТаблицаЦБ.СчитаемЧтоДефолт
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.Дефолт)
		|		КОГДА РасчетСС1.УровеньОценки = 1
		|			ТОГДА РасчетСС1.ПолеКотировки
		|		КОГДА ЕСТЬNULL(АктивныйРынокБлумберг.Период, 0) <> 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СредняяЦенаЗакрытия)
		|		КОГДА ЕСТЬNULL(РасчетныеЦеныНРД.ЦеннаяБумага, 0) <> 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД)
		|		КОГДА РасчетСС1.УровеньОценки = 2
		|			ТОГДА РасчетСС1.ПолеКотировки
		|		КОГДА ЕСТЬNULL(КотировкиТорговыхПлощадокСводныеСрезПоследних.BID, 0) <> 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ЦенаСпроса)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПолеКотировки,
		|	ВЫБОР
		|		КОГДА ТаблицаЦБ.СчитаемЧтоДефолт
		|			ТОГДА ТаблицаЦБ.ДатаПогашения
		|		КОГДА РасчетСС1.УровеньОценки = 1
		|			ТОГДА РасчетСС1.ДатаКотировки
		|		КОГДА ЕСТЬNULL(АктивныйРынокБлумберг.Период, 0) <> 0
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE_DATE
		|		КОГДА ЕСТЬNULL(РасчетныеЦеныНРД.ЦеннаяБумага, 0) <> 0
		|			ТОГДА &ДатаПереоценкиНРД
		|		КОГДА РасчетСС1.УровеньОценки = 2
		|			ТОГДА РасчетСС1.ДатаКотировки
		|		КОГДА ЕСТЬNULL(КотировкиТорговыхПлощадокСводныеСрезПоследних.BID, 0) <> 0
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ДатаКотировки,
		|	ВЫБОР
		|		КОГДА ТаблицаЦБ.СчитаемЧтоДефолт
		|			ТОГДА 1
		|		КОГДА РасчетСС1.УровеньОценки = 1
		|			ТОГДА РасчетСС1.УровеньОценки
		|		КОГДА ЕСТЬNULL(АктивныйРынокБлумберг.Период, 0) <> 0
		|			ТОГДА 1
		|		КОГДА ЕСТЬNULL(РасчетныеЦеныНРД.ЦеннаяБумага, 0) <> 0
		|			ТОГДА 2
		|		КОГДА РасчетСС1.УровеньОценки = 2
		|			ТОГДА РасчетСС1.УровеньОценки
		|		КОГДА ЕСТЬNULL(КотировкиТорговыхПлощадокСводныеСрезПоследних.BID, 0) <> 0
		|			ТОГДА 2
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УровеньОценки,
		|	ВЫБОР
		|		КОГДА ТаблицаЦБ.СчитаемЧтоДефолт
		|			ТОГДА ТаблицаЦБ.ЭмитентОблигации
		|		КОГДА РасчетСС1.УровеньОценки = 1
		|			ТОГДА РасчетСС1.Биржа
		|		КОГДА ЕСТЬNULL(АктивныйРынокБлумберг.Период, 0) <> 0
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа
		|		КОГДА ЕСТЬNULL(РасчетныеЦеныНРД.ЦеннаяБумага, 0) <> 0
		|			ТОГДА &НРД
		|		КОГДА РасчетСС1.УровеньОценки = 2
		|			ТОГДА РасчетСС1.Биржа
		|		КОГДА ЕСТЬNULL(КотировкиТорговыхПлощадокСводныеСрезПоследних.BID, 0) <> 0
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Биржа
		|ПОМЕСТИТЬ РасчетСС
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РасчетСС1 КАК РасчетСС1
		|		ПО ТаблицаЦБ.Рынок = РасчетСС1.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = РасчетСС1.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ АктивныйРынокБлумберг КАК АктивныйРынокБлумберг
		|		ПО ТаблицаЦБ.Рынок = АктивныйРынокБлумберг.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = АктивныйРынокБлумберг.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|				&ДатаПереоценки,
		|				Биржа = &Блумберг
		|					И РежимТоргов = &Режим_BGN) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадокСводныеСрезПоследних.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
		|		ПО ТаблицаЦБ.Рынок = РасчетныеЦеныНРД.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныНРД.ЦеннаяБумага
		|			И (РасчетныеЦеныНРД.Период = &ДатаПереоценкиНРД)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасчетСС.ЦеннаяБумага КАК ЦеннаяБумага,
		|	РасчетСС.Рынок КАК Рынок,
		|	РасчетСС.ВалютаНоминала КАК ВалютаНоминала,
		|	РасчетСС.Номинал КАК Номинал,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(РасчетСС.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА (ВЫРАЗИТЬ(РасчетСС.СправедливаяЦена * РасчетСС.Номинал КАК ЧИСЛО(27, 10))) / 100
		|		ИНАЧЕ РасчетСС.СправедливаяЦена
		|	КОНЕЦ КАК Стоимость,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(РасчетСС.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА РасчетСС.ВалютаНоминала
		|		ИНАЧЕ &Валюта
		|	КОНЕЦ КАК Валюта,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(РасчетСС.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА РасчетСС.ВалютаНоминала
		|		ИНАЧЕ &Валюта
		|	КОНЕЦ КАК ВалютаКотировки,
		|	0 КАК Купон,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(РасчетСС.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА РасчетСС.ВалютаНоминала
		|		ИНАЧЕ &Валюта
		|	КОНЕЦ КАК ВалютаКупона,
		|	РасчетСС.ПолеКотировки КАК ВидЦены,
		|	РасчетСС.ДатаКотировки КАК ДатаЦены,
		|	РасчетСС.УровеньОценки КАК УровеньОценки,
		|	РасчетСС.Биржа КАК Биржа,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, РасчетСС.Биржа) КАК Источник
		|ИЗ
		|	РасчетСС КАК РасчетСС
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО РасчетСС.Биржа = Биржи.Ссылка";
		
	ТорговыхДнейНазад10 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -10);
	ПоследнийТорговыйДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки));
	
	Запрос.УстановитьПараметр("ПоследнийТорговыйДень", ПоследнийТорговыйДень);
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	Запрос.УстановитьПараметр("ДатаПереоценкиНРД", НачалоДня(ДатаПереоценки));
	Запрос.УстановитьПараметр("ММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	
	Запрос.УстановитьПараметр("Блумберг"	, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("Режим_BGN"	, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10", ТорговыхДнейНазад10);
	Запрос.УстановитьПараметр("НРД", ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("ВключатьРежимРепо", ДатаПереоценки < Дата(2018, 12, 6));
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);
	
	// #ТехническийДолг
	Запрос.УстановитьПараметр("Валюта", Организация.ВалютаУчета);
	// #ТехническийДолг
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Расчет СЧА Нефтегарант 2018", "Таблица стоимостей ЦБ");		
	Иначе
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
	
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, СчетДоверительногоУправления);
		
		КонецЕсли;
	
	КонецЦикла;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "После заполнения купона", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;
КонецФункции

Функция ПолучитьЦеныСургутнефтегазСтрахование(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)

	Запрос = Новый Запрос();
	
	// Уровень 1: Справедливой стоимостью признается  Рыночная цена 3 (MARKETPRICE3) в режиме основных торгов , 
	// в качестве основного рынка определена торговая площадка ПАО «Московская биржа» на дату оценки или на ближайший 
	// торговый день, если дата оценки является неторговым днем.   
	//	
	// Рынок признается неактивным: Если в течение последних 90 торговых дней совершено менее 10 сделок/ или сделки отсутствую; 
	// Общий объем сделок, совершенных в течение последних 90 торговых  дней, составил менее 500 тыс руб.  

	// Уровень 2: Для оценки справедливой стоимости ц/б, по которым рынок признан неактивным, используются котировки НРД на дату оценки 
	//	или на ближайший предыдущий день (в пределах 10 торговых дней), если на дату оценки котировка не расчитывалась.	
			
	СрокПризнанияРынкаАктивным = 90;
	МинимальныйОбъемСделок = 500000;
	МинимальноеКоличествоСделок = 10;
	СрокДействияКотировокНРД = 10;
	
	#Область Запрос
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ТаблицаСпискаЦБ.Рынок КАК Рынок
	|ПОМЕСТИТЬ _ИсходнаяТаблицаЦБ
	|ИЗ
	|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
	|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
	|	Облигации.Категория КАК КатегорияОблигаций,
	|	ЕСТЬNULL(ЕСТЬNULL(Акции.РазмерЭмиссииШт, Облигации.РазмерЭмиссииШт), РасчетныеЦеныПаевСрезПоследних.КоличествоПаев) КАК ОбъемВыпуска,
	|	&ММВБ КАК БиржаПоУмолчанию
	|ПОМЕСТИТЬ _ТаблицаЦБ
	|ИЗ
	|	_ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
	|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
	|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
	|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(
	|				&ДатаПереоценки,
	|				ЦеннаяБумага В
	|					(ВЫБРАТЬ
	|						ТаблицаЦБ.ЦеннаяБумага
	|					ИЗ
	|						_ИсходнаяТаблицаЦБ КАК ТаблицаЦБ)) КАК РасчетныеЦеныПаевСрезПоследних
	|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
	|ПОМЕСТИТЬ _БумагиВАктивномРынке
	|ИЗ
	|	_ТаблицаЦБ КАК _ТаблицаЦБ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадокСводные
	|		ПО _ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокСводные.ЦеннаяБумага
	|			И _ТаблицаЦБ.БиржаПоУмолчанию = КотировкиТорговыхПлощадокСводные.Биржа
	|ГДЕ
	|	КотировкиТорговыхПлощадокСводные.РежимТоргов.ОсновнойРежим
	|	И КотировкиТорговыхПлощадокСводные.Период МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -1 * &СрокПризнанияРынкаАктивным) И &ДатаПереоценки
	|
	|СГРУППИРОВАТЬ ПО
	|	_ТаблицаЦБ.ЦеннаяБумага,
	|	_ТаблицаЦБ.ОбъемВыпуска
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(КотировкиТорговыхПлощадокСводные.NUMTRADES) > &МинимальноеКоличествоСделок И
	|	СУММА(КотировкиТорговыхПлощадокСводные.VOLUME) >= &МинимальныйОбъемСделок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_ТаблицаЦБ.Рынок КАК Рынок,
	|	_ТаблицаЦБ.Номинал КАК Номинал,
	|	_ТаблицаЦБ.КатегорияОблигаций КАК КатегорияОблигаций,
	|	_ТаблицаЦБ.ОбъемВыпуска КАК ОбъемВыпуска,
	|	_ТаблицаЦБ.БиржаПоУмолчанию КАК БиржаПоУмолчанию,
	|	ВЫБОР
	|		КОГДА НЕ _БумагиВАктивномРынке.ЦеннаяБумага ЕСТЬ NULL
	|			ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК УровеньОценки
	|ПОМЕСТИТЬ _ТаблицаЦБСУровнямиОценки
	|ИЗ
	|	_ТаблицаЦБ КАК _ТаблицаЦБ
	|		ЛЕВОЕ СОЕДИНЕНИЕ _БумагиВАктивномРынке КАК _БумагиВАктивномРынке
	|		ПО _ТаблицаЦБ.ЦеннаяБумага = _БумагиВАктивномРынке.ЦеннаяБумага
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КотировкиТорговыхПлощадок.MARKETPRICE3 КАК MARKETPRICE3,
	|	КотировкиТорговыхПлощадок.MARKETPRICE3_DATE КАК MARKETPRICE3_DATE,
	|	КотировкиТорговыхПлощадок.Рынок КАК Рынок,
	|	КотировкиТорговыхПлощадок.ЦеннаяБумага КАК ЦеннаяБумага,
	|	КотировкиТорговыхПлощадок.Биржа КАК Биржа,
	|	КотировкиТорговыхПлощадок.Валюта КАК Валюта
	|ПОМЕСТИТЬ _ВсеКотировкиТорговыхПлощадок
	|ИЗ
	|	РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
	|			&ДатаПереоценки,
	|			Биржа = &ММВБ
	|				И РежимТоргов.ОсновнойРежим
	|				И НЕ MARKETPRICE3 ЕСТЬ NULL
	|				И ЦеннаяБумага В
	|					(ВЫБРАТЬ
	|						ИсходнаяТаблицаЦБ.ЦеннаяБумага
	|					ИЗ
	|						_ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ)
	|				И MARKETPRICE3_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -1 * &СрокПризнанияРынкаАктивным)) КАК КотировкиТорговыхПлощадок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ВсеКотировкиТорговыхПлощадок.MARKETPRICE3 КАК MARKETPRICE3,
	|	_ВсеКотировкиТорговыхПлощадок.MARKETPRICE3_DATE КАК MARKETPRICE3_DATE,
	|	_ВсеКотировкиТорговыхПлощадок.Рынок КАК Рынок,
	|	_ВсеКотировкиТорговыхПлощадок.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_ВсеКотировкиТорговыхПлощадок.Биржа КАК Биржа,
	|	_ВсеКотировкиТорговыхПлощадок.Валюта КАК Валюта
	|ПОМЕСТИТЬ _ДействующиеКотировкиТорговыхПлощадок
	|ИЗ
	|	_ВсеКотировкиТорговыхПлощадок КАК _ВсеКотировкиТорговыхПлощадок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			МАКСИМУМ(_ВсеКотировкиТорговыхПлощадок.MARKETPRICE3_DATE) КАК MARKETPRICE3_DATE,
	|			_ВсеКотировкиТорговыхПлощадок.Рынок КАК Рынок,
	|			_ВсеКотировкиТорговыхПлощадок.ЦеннаяБумага КАК ЦеннаяБумага,
	|			_ВсеКотировкиТорговыхПлощадок.Биржа КАК Биржа,
	|			_ВсеКотировкиТорговыхПлощадок.Валюта КАК Валюта
	|		ИЗ
	|			_ВсеКотировкиТорговыхПлощадок КАК _ВсеКотировкиТорговыхПлощадок
	|		
	|		СГРУППИРОВАТЬ ПО
	|			_ВсеКотировкиТорговыхПлощадок.Рынок,
	|			_ВсеКотировкиТорговыхПлощадок.ЦеннаяБумага,
	|			_ВсеКотировкиТорговыхПлощадок.Биржа,
	|			_ВсеКотировкиТорговыхПлощадок.Валюта) КАК ПоследниеКотировкиФильтр
	|		ПО (ПоследниеКотировкиФильтр.Рынок = _ВсеКотировкиТорговыхПлощадок.Рынок
	|				И _ВсеКотировкиТорговыхПлощадок.ЦеннаяБумага = ПоследниеКотировкиФильтр.ЦеннаяБумага
	|				И _ВсеКотировкиТорговыхПлощадок.Биржа = ПоследниеКотировкиФильтр.Биржа
	|				И _ВсеКотировкиТорговыхПлощадок.Валюта = ПоследниеКотировкиФильтр.Валюта)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ТаблицаЦБ.Номинал КАК Номинал,
	|	ТаблицаЦБ.Рынок КАК Рынок,
	|	ВЫБОР
	|		КОГДА НЕ КотировкиММВБ.MARKETPRICE3 ЕСТЬ NULL
	|			ТОГДА КотировкиММВБ.MARKETPRICE3
	|		КОГДА НЕ РасчетныеЦеныНРДСрезПоследних.RATE ЕСТЬ NULL
	|			ТОГДА РасчетныеЦеныНРДСрезПоследних.RATE
	|	КОНЕЦ КАК СправедливаяЦена,
	|	ВЫБОР
	|		КОГДА НЕ КотировкиММВБ.MARKETPRICE3 ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.РыночнаяЦена3)
	|		КОГДА НЕ РасчетныеЦеныНРДСрезПоследних.RATE ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД)
	|	КОНЕЦ КАК ПолеПереоценки,
	|	ВЫБОР
	|		КОГДА КотировкиММВБ.MARKETPRICE3 ЕСТЬ NULL
	|				И НЕ РасчетныеЦеныНРДСрезПоследних.RATE ЕСТЬ NULL
	|			ТОГДА &НРД
	|		ИНАЧЕ Биржи.ЮрФизЛицо
	|	КОНЕЦ КАК Биржа,
	|	ВЫБОР
	|		КОГДА НЕ КотировкиММВБ.MARKETPRICE3 ЕСТЬ NULL
	|			ТОГДА КотировкиММВБ.MARKETPRICE3_DATE
	|		КОГДА НЕ РасчетныеЦеныНРДСрезПоследних.RATE ЕСТЬ NULL
	|			ТОГДА РасчетныеЦеныНРДСрезПоследних.Период
	|	КОНЕЦ КАК ДатаЦены,
	|	ТаблицаЦБ.УровеньОценки КАК УровеньОценки,
	|	ВЫБОР
	|		КОГДА НЕ КотировкиММВБ.MARKETPRICE3 ЕСТЬ NULL
	|			ТОГДА КотировкиММВБ.Валюта
	|		КОГДА НЕ РасчетныеЦеныНРДСрезПоследних.RATE ЕСТЬ NULL
	|			ТОГДА РасчетныеЦеныНРДСрезПоследних.ЦеннаяБумага.ВалютаНоминала
	|	КОНЕЦ КАК ВалютаКотировки
	|ПОМЕСТИТЬ _Котировки
	|ИЗ
	|	_ТаблицаЦБСУровнямиОценки КАК ТаблицаЦБ
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ДействующиеКотировкиТорговыхПлощадок КАК КотировкиММВБ
	|		ПО ТаблицаЦБ.Рынок = КотировкиММВБ.Рынок
	|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиММВБ.ЦеннаяБумага
	|			И ТаблицаЦБ.БиржаПоУмолчанию = КотировкиММВБ.Биржа
	|			И (ТаблицаЦБ.УровеньОценки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
	|		ПО (Биржи.Ссылка = КотировкиММВБ.Биржа)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД.СрезПоследних(
	|				&ДатаПереоценки,
	|				ЦеннаяБумага В
	|					(ВЫБРАТЬ
	|						ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
	|					ИЗ
	|						_ИсходнаяТаблицаЦБ КАК ТаблицаЦБ)) КАК РасчетныеЦеныНРДСрезПоследних
	|		ПО ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныНРДСрезПоследних.ЦеннаяБумага
	|			И (ТаблицаЦБ.УровеньОценки > 1)
	|			И (ТаблицаЦБ.БиржаПоУмолчанию = &ММВБ)
	|			И (РасчетныеЦеныНРДСрезПоследних.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -1 * &СрокДействияКотировокНРД))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ТаблицаЦБ.Рынок КАК Рынок,
	|	ТаблицаЦБ.Номинал КАК Номинал,
	|	ЕСТЬNULL(Котировки.СправедливаяЦена, 0) * ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
	|			ТОГДА ТаблицаЦБ.Номинал / 100
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Стоимость,
	|	Котировки.ПолеПереоценки КАК ВидЦены,
	|	Котировки.ДатаЦены КАК ДатаЦены,
	|	Котировки.УровеньОценки КАК УровеньОценки,
	|	Котировки.Биржа КАК Источник,
	|	Котировки.ВалютаКотировки КАК ВалютаКотировки
	|ИЗ
	|	_ТаблицаЦБ КАК ТаблицаЦБ
	|		ЛЕВОЕ СОЕДИНЕНИЕ _Котировки КАК Котировки
	|		ПО ТаблицаЦБ.ЦеннаяБумага = Котировки.ЦеннаяБумага";
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);	       
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);	 
	Запрос.УстановитьПараметр("ММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));	 	
	
	Запрос.УстановитьПараметр("НРД", ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("Организация", ПараметрыОценки.Организация);	       	
	Запрос.УстановитьПараметр("СрокПризнанияРынкаАктивным", СрокПризнанияРынкаАктивным);	
	Запрос.УстановитьПараметр("СрокДействияКотировокНРД", СрокДействияКотировокНРД);	
	Запрос.УстановитьПараметр("МинимальныйОбъемСделок", МинимальныйОбъемСделок);
	Запрос.УстановитьПараметр("МинимальноеКоличествоСделок", МинимальноеКоличествоСделок); 

	#КонецОбласти
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Югории Страхование (ЕПС)", "Таблица стоимостей ЦБ");		
	Иначе
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныФедерации(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)

	Если ДатаПереоценки >= Дата(2020, 1, 1) Тогда
		Возврат ПолучитьЦеныФедерации2020(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);
	КонецЕсли;
	
	#Область Основной_запрос	
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ), ЛОЖЬ) КАК ОВОЗРФ,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, НЕОПРЕДЕЛЕНО) КАК ДатаПогашения,
