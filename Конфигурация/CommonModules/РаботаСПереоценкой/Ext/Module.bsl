			НоваяСтрока.ВероятностьДефолта = 9.59;
			
			НоваяСтрока = РейтинговыеГруппыИВероятностиДефолта.Добавить();
			НоваяСтрока.СтрокаСопоставления = 17;
			НоваяСтрока.РейтинговаяГруппа = 4;
			НоваяСтрока.ВероятностьДефолта = 18.70;
			
			НоваяСтрока = РейтинговыеГруппыИВероятностиДефолта.Добавить();
			НоваяСтрока.СтрокаСопоставления = 18;
			НоваяСтрока.РейтинговаяГруппа = 4;
			НоваяСтрока.ВероятностьДефолта = 26.86;
			
			#КонецОбласти			
			
		КонецЕсли;

	КонецЕсли;
	
	Если РейтинговыеГруппыИВероятностиДефолта.Количество() = 0 Тогда
		Возврат РейтинговыеГруппыИВероятностиДефолта;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Если СубъектРейтинга = "СвязанныйКонтрагент" Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Значение КАК Справочник.ЮрФизЛица) КАК Субъект,
			|	ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Объект КАК Документ.НачислениеЗадолженности) КАК ОснованиеЗадолженности
			|ПОМЕСТИТЬ _СубъектыРейтинга
			|ИЗ
			|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ДополнительныеСведения КАК СвойствоСвязанныйКонтрагент
			|		ПО (СвойствоСвязанныйКонтрагент.Ключ = ""СвязанныйКонтрагент"")
			|			И (СвойствоСвязанныйКонтрагент.Ссылка = ЗначенияДополнительныхСведений.Свойство)";
		
		Запрос.Выполнить();
		
		ИнформацияОСубъекте = Неопределено;

	Иначе
		
		ИнформацияОСубъекте = СубъектРейтинга;
		
	КонецЕсли;		
	
	РаботаСПоказателямиФинансовыхИнструментов.ПоместитьРейтинговыеГруппыСубъектовВМенеджерВременныхТаблиц(Запрос, ИнформацияОСубъекте, Дата, ПараметрыРасчетаРейтинга, "_РейтинговыеГруппы");
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РейтинговыеГруппыИВероятностиДефолта.СтрокаСопоставления КАК СтрокаСопоставления,
		|	РейтинговыеГруппыИВероятностиДефолта.РейтинговаяГруппа КАК РейтинговаяГруппа,
		|	РейтинговыеГруппыИВероятностиДефолта.ВероятностьДефолта КАК ВероятностьДефолта
		|ПОМЕСТИТЬ _РейтинговыеГруппыИВероятностиДефолта
		|ИЗ
		|	&РейтинговыеГруппыИВероятностиДефолта КАК РейтинговыеГруппыИВероятностиДефолта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РейтинговыеГруппы.Субъект КАК Субъект,
		|	_РейтинговыеГруппы.НомерГруппы КАК СтрокаСопоставления,
		|	_РейтинговыеГруппыИВероятностиДефолта.РейтинговаяГруппа КАК РейтинговаяГруппа,
		|	_РейтинговыеГруппыИВероятностиДефолта.ВероятностьДефолта КАК ВероятностьДефолта
		|ИЗ
		|	_РейтинговыеГруппы КАК _РейтинговыеГруппы
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РейтинговыеГруппыИВероятностиДефолта КАК _РейтинговыеГруппыИВероятностиДефолта
		|		ПО (_РейтинговыеГруппыИВероятностиДефолта.СтрокаСопоставления = _РейтинговыеГруппы.НомерГруппы)";
	
	Если СубъектРейтинга = "СвязанныйКонтрагент" Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"_РейтинговыеГруппы.Субъект КАК Субъект",
			"_РейтинговыеГруппы.Субъект КАК Субъект,
			|	_СубъектыРейтинга.ОснованиеЗадолженности КАК ОснованиеЗадолженности");
			
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"_РейтинговыеГруппы КАК _РейтинговыеГруппы",
			"_РейтинговыеГруппы КАК _РейтинговыеГруппы
			|		ЛЕВОЕ СОЕДИНЕНИЕ _СубъектыРейтинга КАК _СубъектыРейтинга
			|		ПО (_СубъектыРейтинга.Субъект = _РейтинговыеГруппы.Субъект)");
		
	КонецЕсли;		
	
	Запрос.УстановитьПараметр("РейтинговыеГруппыИВероятностиДефолта", РейтинговыеГруппыИВероятностиДефолта);  
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ВероятностиДефолта = Запрос.Выполнить().Выгрузить();	
	Иначе
		ВероятностиДефолта = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Расчет рейтинговой группы и вероятности дефолта", "Вероятность дефолта", , , , Истина);		
	КонецЕсли;
	
	Возврат ВероятностиДефолта;
	
КонецФункции

Функция ПолучитьУровеньПотерьВСлучаеДефолта(ВариантРасчетаОценочнойСтоимости, Период) Экспорт
	
	УровеньПотерь = 0;		
	
	// Коэффициент указан в методике
	
	Если ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ОПК2018
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Согласие2019
	Тогда
	
		Если Период >= '20190831' Тогда
			
			УровеньПотерь = 0.4835;
			
		ИначеЕсли Период >= '20190101' Тогда
			
			УровеньПотерь = 0.4615;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат УровеньПотерь;	
	
КонецФункции

Функция ПолучитьКалендарьДляСчетаДУ(Организация, СчетДоверительногоУправления, Период) Экспорт

	КалендарьКлиента = БухгалтерскийУчет.ОпределитьНастройкуУчета(Период, Организация, СчетДоверительногоУправления, "КалендарьДляОпределенияРабочихДней");
	
	Если ЗначениеЗаполнено(КалендарьКлиента) Тогда
		Возврат КалендарьКлиента;
	Иначе
		Возврат Справочники.Календари.Общероссийский;
	КонецЕсли;

КонецФункции

Функция ОпределитьПараметрыНачисленияКорректировкиЭСП(ПараметрыОценки, НастройкиУчета, ДатаПереоценки, СтрокаПереоценкиЦБ, ДатаПокупки, ДатаВводаПартии)
	
	ВидУчетаДляНастроек = ПараметрыОценки.ВидУчета;
	Если ВидУчетаДляНастроек <> Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		ВидУчетаДляНастроек = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
	КонецЕсли;
	
	НастройкиУчетаАктива = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(ДатаПереоценки, ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления, СтрокаПереоценкиЦБ.УчетныйАктивЕПС, ВидУчетаДляНастроек);
	НастройкиУчетаАктива = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
		НастройкиУчетаАктива,
		СтрокаПереоценкиЦБ.ЦеннаяБумага,
		СтрокаПереоценкиЦБ.УчетныйАктивЕПС,
		СтрокаПереоценкиЦБ.Партия,
		СтрокаПереоценкиЦБ.СтрокаПартии);
	
	ПериодичностьНачисленияКорректировкиЭСП = НастройкиУчетаАктива.ПериодичностьНачисленияКорректировкиЭСП;
	Если Не ЗначениеЗаполнено(ПериодичностьНачисленияКорректировкиЭСП) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("На %1 для клиента %2 не указана периодичность начисления корректировки ЭСП для вида актива %3",
				ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления, СтрокаПереоценкиЦБ.УчетныйАктивЕПС));
				
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыНачисленияЭСП = Новый Структура;
	ПараметрыНачисленияЭСП.Вставить("НачислятьКорректировкуЭСП",				Ложь);
	ПараметрыНачисленияЭСП.Вставить("ПериодичностьНачисленияКорректировкиЭСП",	ПериодичностьНачисленияКорректировкиЭСП);
	ПараметрыНачисленияЭСП.Вставить("ДатаПоследнейЦеныПоЭСП",					Неопределено);
	ПараметрыНачисленияЭСП.Вставить("ДатаПервойЦеныПоЭСП",						Неопределено);
	ПараметрыНачисленияЭСП.Вставить("НаОснованииРешенияКлиента",				Неопределено);
	ПараметрыНачисленияЭСП.Вставить("Используется",								Истина);

	// Если не используется, то корректировку не начисляем
	
	РешениеКлиентаПоЭСП = РегистрыСведений.РешенияКлиентовПоЗначениямЭСП.ПолучитьПоПартии(СтрокаПереоценкиЦБ.ЦеннаяБумага, СтрокаПереоценкиЦБ.Партия, СтрокаПереоценкиЦБ.СтрокаПартии, ДатаПереоценки);
	
	Если РешениеКлиентаПоЭСП <> Неопределено Тогда
		
		ПараметрыНачисленияЭСП.Вставить("Используется", РешениеКлиентаПоЭСП.Используется);
		
		Если Не РешениеКлиентаПоЭСП.Используется Тогда
			Возврат ПараметрыНачисленияЭСП;
		КонецЕсли;
		
	КонецЕсли;
	
	// Начисление корректировки ЭСП при вводе или выводе ц/б
	
	Если НастройкиУчетаАктива.НачислятьКорректировкуЭСПВДеньОперации
		И ПараметрыОценки.ДополнительныеСвойства.Свойство("ОценкаПриВводеВыводеЦенныхБумаг") И ПараметрыОценки.ДополнительныеСвойства.ОценкаПриВводеВыводеЦенныхБумаг
		И Не НастройкиУчета.НеСчитатьВводыВыводыЦенныхБумагОперациямиДляНачисленияПроцентногоДохода
	Тогда
		ПараметрыНачисленияЭСП.НачислятьКорректировкуЭСП = Истина;
		Возврат ПараметрыНачисленияЭСП;
	КонецЕсли;
	
	// Иногда оценку нужно выполнять по ЭСП вне зависимости от настроек периодичности 
	
	Если ПараметрыОценки.ДополнительныеСвойства.Свойство("РассчитыватьАмортизированнуюСтоимостьПоЭСП") И ПараметрыОценки.ДополнительныеСвойства.РассчитыватьАмортизированнуюСтоимостьПоЭСП Тогда
		ПараметрыНачисленияЭСП.НачислятьКорректировкуЭСП = Истина;
		Возврат ПараметрыНачисленияЭСП;		
	КонецЕсли;
	
	// Начисление в соответствии с настройками учета
	
	КалендарьДляСчетаДУ = ПолучитьКалендарьДляСчетаДУ(ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления, ДатаПереоценки);
	
	Если ПериодичностьНачисленияКорректировкиЭСП = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
		
		ПараметрыНачисленияЭСП.НачислятьКорректировкуЭСП = Истина; // При ежедневном начислении корректировки расчет по ЭСП выполняется во все дни формирования СЧА (#363581)
		
		
	ИначеЕсли ПериодичностьНачисленияКорректировкиЭСП = Перечисления.ПериодичностьПереоценкиАктивов.Ежегодно
		ИЛИ ПериодичностьНачисленияКорректировкиЭСП = Перечисления.ПериодичностьПереоценкиАктивов.Ежеквартально
		ИЛИ ПериодичностьНачисленияКорректировкиЭСП = Перечисления.ПериодичностьПереоценкиАктивов.Ежемесячно
		Тогда
		
		Если НачалоДня(ДатаПереоценки) = НачалоДня(БухгалтерскийУчетЕПС.ПоследнийДеньПериода(ДатаПереоценки, ПериодичностьНачисленияКорректировкиЭСП)) Тогда 
			ПараметрыНачисленияЭСП.НачислятьКорректировкуЭСП = Истина;
		Иначе
			ПараметрыНачисленияЭСП.ДатаПоследнейЦеныПоЭСП	= 
				Макс(ПараметрыОценки.ДополнительныеСвойства.ДатаПоследнейРеформацииБаланса,
					НачалоДня(БухгалтерскийУчетЕПС.ПервыйДеньПериода(ДатаПереоценки, ПериодичностьНачисленияКорректировкиЭСП) - 1));
			ПараметрыНачисленияЭСП.ДатаПервойЦеныПоЭСП		= КонецДня(БухгалтерскийУчетЕПС.ПоследнийДеньПериода(ДатаПокупки, ПериодичностьНачисленияКорректировкиЭСП));
			Если НачалоДня(ПараметрыНачисленияЭСП.ДатаПервойЦеныПоЭСП) > ПараметрыНачисленияЭСП.ДатаПоследнейЦеныПоЭСП Тогда
				ПараметрыНачисленияЭСП.ДатаПервойЦеныПоЭСП = КонецДня(ПараметрыНачисленияЭСП.ДатаПоследнейЦеныПоЭСП);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ПериодичностьНачисленияКорректировкиЭСП = Перечисления.ПериодичностьПереоценкиАктивов.ЕжемесячноВПоследнийРабочийДень Тогда
		
		Если НачалоДня(ДатаПереоценки) = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьДляСчетаДУ, НачалоДня(КонецМесяца(ДатаПереоценки))) Тогда 
			ПараметрыНачисленияЭСП.НачислятьКорректировкуЭСП = Истина;
		Иначе
			ПараметрыНачисленияЭСП.ДатаПоследнейЦеныПоЭСП	= 
				Макс(ПараметрыОценки.ДополнительныеСвойства.ДатаПоследнейРеформацииБаланса,
					Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьДляСчетаДУ, НачалоДня(НачалоМесяца(ДатаПереоценки) - 1)));
			ПараметрыНачисленияЭСП.ДатаПервойЦеныПоЭСП		= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьДляСчетаДУ, КонецМесяца(ДатаПокупки));
			Если НачалоДня(ПараметрыНачисленияЭСП.ДатаПервойЦеныПоЭСП) > ПараметрыНачисленияЭСП.ДатаПоследнейЦеныПоЭСП Тогда
				ПараметрыНачисленияЭСП.ДатаПервойЦеныПоЭСП = КонецДня(ПараметрыНачисленияЭСП.ДатаПоследнейЦеныПоЭСП);
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		// Не начислять
		
		Возврат ПараметрыНачисленияЭСП;
		
	КонецЕсли;

	// Расчет стоимости по ЭСП также следует выполнять
	// при получении от клиента сведений о будущих денежных потоках
	// уточнение с '20250605' - от регистрации потоков пляшем, но в день регистрации потоков ничего не делаем
	// все теперь регулируется настройкой НачислятьКорректировкуЭСПВДеньОперации см. ЗаполнитьАмортизированнойСтоимостью
	
	Если Не ПараметрыНачисленияЭСП.НачислятьКорректировкуЭСП Тогда	
		
		РешенияКлиентовПоБудущимПотокам = Справочники.Облигации.ПолучитьРешенияКлиентовПоПрогнозируемымДенежнымПотокам(
			ПараметрыОценки.Организация,
			ПараметрыОценки.Клиент,
			СтрокаПереоценкиЦБ.ЦеннаяБумага,
			?(КонецДня(ДатаПереоценки) < ПараметрыНачисленияЭСП.ДатаПервойЦеныПоЭСП, НачалоДня(ДатаПокупки), КонецДня(ПараметрыНачисленияЭСП.ДатаПоследнейЦеныПоЭСП) + 1),
			КонецДня(ДатаПереоценки),
			ДатаПереоценки);
			
		РешенияКлиентовПоБудущимПотокам.Сортировать("Дата");
			
		СтрокаРешенияКлиента = РешенияКлиентовПоБудущимПотокам.Найти(НачалоДня(ДатаПереоценки), "Дата");
			
		Если СтрокаРешенияКлиента <> Неопределено И ДатаПереоценки < '20250605' Тогда
			
			УчитыватьРешенияКлиента = Истина;
			
			Если СтрокаРешенияКлиента.Дата = '20250101' Тогда // при переходе на МСФО9 были заведены решения, но их учитывать не нужно для реклассифицированных бумаг
			
				МассивОблигацийРеклассифицированныхНа504ПриПереходеНаМСФО9 = 
					Кэширование.ПолучитьОблигацииРеклассифицированныеНа504ПриПереходеНаМСФО9(ПараметрыОценки.СчетДоверительногоУправления);
					
				УчитыватьРешенияКлиента = (МассивОблигацийРеклассифицированныхНа504ПриПереходеНаМСФО9.Найти(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Неопределено);
				
			КонецЕсли;
			
			Если УчитыватьРешенияКлиента Тогда
				ПараметрыНачисленияЭСП.НачислятьКорректировкуЭСП	= Истина;
				ПараметрыНачисленияЭСП.НаОснованииРешенияКлиента	= СтрокаРешенияКлиента.Документ; 
			КонецЕсли;
			
		ИначеЕсли РешенияКлиентовПоБудущимПотокам.Количество() > 0 Тогда
			ПараметрыНачисленияЭСП.ДатаПоследнейЦеныПоЭСП		= РешенияКлиентовПоБудущимПотокам[РешенияКлиентовПоБудущимПотокам.Количество() - 1].Дата;
			ПараметрыНачисленияЭСП.НаОснованииРешенияКлиента	= РешенияКлиентовПоБудущимПотокам[РешенияКлиентовПоБудущимПотокам.Количество() - 1].Документ;
			
			// раньше они регались регистром потоков в день-1, сейчас настройками в день0, но нам нужен день-1
			Если ДатаПереоценки >= '20250605' 
				И НЕ(СтрокаПереоценкиЦБ.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_РЖД_ОАО_005")
					И ДатаПереоценки >= '20260211' И ДатаПереоценки < '20260213')
				// у этих ДБ ПН вечно все через 1 место... 
			Тогда 
				ПараметрыНачисленияЭСП.ДатаПоследнейЦеныПоЭСП		= ПараметрыНачисленияЭСП.ДатаПоследнейЦеныПоЭСП - 24 * 60 * 60;
			КонецЕсли;
		КонецЕсли;		
			
	КонецЕсли;

	Если НЕ ПараметрыНачисленияЭСП.НачислятьКорректировкуЭСП 
		И ПараметрыОценки.ДополнительныеСвойства.Свойство("БлижайшаяРанняяДатаОбъединенияВГруппеБудущее")
		И ПараметрыНачисленияЭСП.ДатаПоследнейЦеныПоЭСП < ПараметрыОценки.ДополнительныеСвойства.БлижайшаяРанняяДатаОбъединенияВГруппеБудущее Тогда
	
		ПараметрыНачисленияЭСП.ДатаПоследнейЦеныПоЭСП = ПараметрыОценки.ДополнительныеСвойства.БлижайшаяРанняяДатаОбъединенияВГруппеБудущее;
		ПараметрыНачисленияЭСП.ДатаПервойЦеныПоЭСП = КонецДня(ПараметрыНачисленияЭСП.ДатаПоследнейЦеныПоЭСП);
	
	КонецЕсли;
	
	// Дата цены по ЭСП не может быть раньше даты покупки и даты ввода
	
	Если ПараметрыНачисленияЭСП.НачислятьКорректировкуЭСП
		ИЛИ ПараметрыНачисленияЭСП.ДатаПоследнейЦеныПоЭСП < НачалоДня(ДатаПокупки)
		ИЛИ ПараметрыНачисленияЭСП.ДатаПоследнейЦеныПоЭСП < НачалоДня(ДатаВводаПартии)
	Тогда
		ПараметрыНачисленияЭСП.ДатаПоследнейЦеныПоЭСП = Неопределено;
		ПараметрыНачисленияЭСП.НаОснованииРешенияКлиента = Неопределено;
	КонецЕсли;	

	Если ПараметрыНачисленияЭСП.НачислятьКорректировкуЭСП
		ИЛИ ПараметрыНачисленияЭСП.ДатаПервойЦеныПоЭСП < НачалоДня(ДатаПокупки)
	Тогда
		ПараметрыНачисленияЭСП.ДатаПервойЦеныПоЭСП = Неопределено;
	КонецЕсли;	
	
	Возврат ПараметрыНачисленияЭСП;	
	
КонецФункции

Функция ЦенныеБумагиСРасчетомСтоимостиВСоответствииСУказаниемЦБРФ5419У(СчетДоверительногоУправления) Экспорт
	
	ЦенныеБумаги = Новый Массив;	
	
	Если СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ПФР_Траст")
		ИЛИ СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ПФР_РЭМ")	
	Тогда
	
		// #323767: у ПФР подмену следует выполнять только для двух бумаг
		
		ЦенныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Акция_Сбербанк_10301481B"));
		ЦенныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Акция_Газпром_10200028А"));
		
	КонецЕсли;
	
	Возврат ЦенныеБумаги;
	
КонецФункции

Функция ПолучитьПутьКФайлуОценочнойСтоимостиПредоставленнойКлиентом(СчетДоверительногоУправления, ДатаОценки, ЕПС = Ложь) Экспорт

	Если ЕПС Тогда
		Каталог		= ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("СчетаДоверительногоУправления.ШаблонФайловОценочнойСтоимостиЦенныхБумагПредоставленнойКлиентомЕПС", СчетДоверительногоУправления, ДатаОценки);
		ИмяФайла	= ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("СчетаДоверительногоУправления.ШаблонИмениФайлаСОценочнойСтоимостьюЦенныхБумагПредоставленнойКлиентомЗаДеньЕПС", СчетДоверительногоУправления, ДатаОценки);
		ПутьКФайлу	= Каталог + ?(Прав(Каталог, 1) <> "\", "\", "") + ИмяФайла;
	Иначе
		ПутьКФайлу = ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("СчетаДоверительногоУправления.ШаблонФайловОценочнойСтоимостиЦенныхБумагПредоставленнойКлиентом", СчетДоверительногоУправления, ДатаОценки);
	КонецЕсли;
	
	Возврат ПутьКФайлу;

КонецФункции

Функция СпособОценкиПогашенныхЦенныхБумаг(ПараметрыОценки) Экспорт
		
	Если ПараметрыОценки.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении Тогда
			
		Если БухгалтерскийУчет.ОпределитьНастройкуУчета(ПараметрыОценки.Дата, ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления, "СписыватьПриПолномПогашенииВМоментПогашения") Тогда
			
			СпособОценкиПогашенныхБумаг = "СписыватьПриПолномПогашенииВМоментПогашения";
			
		ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ И ПараметрыОценки.Дата < '20230201'
			ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФондФилософии
			ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Газфонд
			ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2020 И ПараметрыОценки.Дата < '20210101'
			ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Перспектива2020
			ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020
			ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Доверие
			ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФОГФ
			ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РПИ2023
		Тогда
				
			СпособОценкиПогашенныхБумаг = "ОцениватьПоОстаткуЗадолженности";
			
		Иначе
			
			СпособОценкиПогашенныхБумаг = "ОцениватьПоНулевойСтоимостиСВидомЦеныПогашена";
			
		КонецЕсли;
		
	Иначе
		
		СпособОценкиПогашенныхБумаг = "ОцениватьПоБалансовойСтоимости";
		
	КонецЕсли;
		
	Возврат СпособОценкиПогашенныхБумаг;
	
КонецФункции

#КонецОбласти

#Область Распределение_погрешности_округления

Процедура РаспределитьПогрешностьОкругленияСтоимостиЦенныхБумагНаПартии(Объект, ЦельРасчета, НастройкиЦелейРасчета, ОкруглитьДляВалютныхСумм, ОкруглитьДляСуммВВалютеУчета, Отказ, ТочностьВалютнойСуммы = Неопределено) Экспорт
	
	Если Объект.ЦенныеБумаги.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ОкруглитьДляВалютныхСумм Тогда
		ОкруглитьДляСуммВВалютеУчета = Истина;
	КонецЕсли;
	
	ЭтоЕПС = ЦельРасчета = Справочники.ЦелиРасчета.ЕдиныйПланСчетов;
	ЭтоНУ = ЦельРасчета = Справочники.ЦелиРасчета.НалоговыйУчет;
	
	Если ЭтоНУ Тогда // для цели расчета НУ нет настроек
		ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет;
	Иначе
		ВидУчета = ОпределитьВидУчета(Объект.Организация, Объект.СчетДоверительногоУправления, ЦельРасчета, Объект.Дата);
	КонецЕсли;
	
	// #465841 - С 1.1.23 клиенты группы будущее не округляют валютные суммы при расчете рублевых: поставил наш максимум - 12
	Если ЭтоЕПС 
		И (Объект.Дата > '20230101' И БухгалтерскийУчетЕПС.ЭтоКлиентГруппыБудущее(Объект.СчетДоверительногоУправления, Объект.Дата)
			// Аналогично НПФы Волги не округляют, но так как у них валютные бумаги появились только в сентябре 25го, условий по начальной дате ставить не стал, а конечная дата опредлена письмом
			ИЛИ (Объект.Дата < '20250925' 
				И Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(Объект.СчетДоверительногоУправления, Объект.Дата) 
					= ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФВолгаКапитал"))
			// #667653 - С 1.9.25 Югория тоже не округляет валютные суммы при расчете рублевых: поставил наш максимум - 12
			ИЛИ (Объект.Дата > '20250901'
				И Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(Объект.СчетДоверительногоУправления, Объект.Дата) 
					= ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ГСКЮгория"))
			// И Национальный тоже с 08.12.25
			ИЛИ (Объект.Дата > '20251208'
				И Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(Объект.СчетДоверительногоУправления, Объект.Дата) 
					= ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Национальный"))) Тогда
		ТочностьВалютнойСуммы = Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти;

	КонецЕсли;

	Если ЭтоЕПС // Волга согласно письму с 25.9.25 округляет до 2х
		И Объект.Дата >= '20250925' 
		И Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(Объект.СчетДоверительногоУправления, Объект.Дата) 
			= ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФВолгаКапитал") Тогда
	
		ТочностьВалютнойСуммы = 2; 
	
	КонецЕсли;
	
	
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, ВидУчета, Отказ);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦенныеБумаги.ИсточникЦены КАК ИсточникЦены,
	|	ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ЦенныеБумаги.Количество КАК Количество,
	|	ЦенныеБумаги.ОценочнаяЦена КАК ОценочнаяЦена,
	|	ЦенныеБумаги.ОценочнаяСумма КАК ОценочнаяСумма,
	|	ЦенныеБумаги.ОценочнаяСуммаВВалютеУчета КАК ОценочнаяСуммаВВалютеУчета,
	|	ЦенныеБумаги.КурсВалютыНоминала КАК КурсВалютыНоминала,
	|	1 КАК КоличествоСтрок,
	|	ВЫРАЗИТЬ(ЦенныеБумаги.УчетныйАктивЕПС КАК Справочник.УчетныеАктивыЕПС) КАК УчетныйАктивЕПС
	|ПОМЕСТИТЬ ПереоценкаЦенныхБумагЦенныеБумаги1
	|ИЗ
	|	&ЦенныеБумаги КАК ЦенныеБумаги
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.ИсточникЦены КАК ИсточникЦены,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ВЫБОР
	|		КОГДА ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	|			ТОГДА ВЫРАЗИТЬ(ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала
	|		КОГДА ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага ССЫЛКА Справочник.Акции
	|			ТОГДА ВЫРАЗИТЬ(ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага КАК Справочник.Акции).ВалютаНоминала
	|		КОГДА ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага ССЫЛКА Справочник.Паи
	|			ТОГДА ВЫРАЗИТЬ(ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага КАК Справочник.Паи).ВалютаНоминала
	|		КОГДА ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага ССЫЛКА Справочник.Векселя
	|			ТОГДА ВЫРАЗИТЬ(ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага КАК Справочник.Векселя).ВалютаНоминала
	|		КОГДА ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
	|			ТОГДА ВЫРАЗИТЬ(ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).ВалютаНоминала
	|		КОГДА ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
	|			ТОГДА ВЫРАЗИТЬ(ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ВалютаНоминала
	|		КОГДА ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага ССЫЛКА Справочник.Доли
	|			ТОГДА ВЫРАЗИТЬ(ПереоценкаЦенныхБумагЦенныеБумаги1.ЦеннаяБумага КАК Справочник.Доли).ВалютаНоминала
	|	КОНЕЦ КАК ВалютаНоминала,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.Количество КАК Количество,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.ОценочнаяЦена КАК ОценочнаяЦена,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.ОценочнаяСумма КАК ОценочнаяСумма,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.ОценочнаяСуммаВВалютеУчета КАК ОценочнаяСуммаВВалютеУчета,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.КурсВалютыНоминала КАК КурсВалютыНоминала,
	|	ПереоценкаЦенныхБумагЦенныеБумаги1.КоличествоСтрок КАК КоличествоСтрок
	|ПОМЕСТИТЬ ПереоценкаЦенныхБумагЦенныеБумаги
	|ИЗ
	|	ПереоценкаЦенныхБумагЦенныеБумаги1 КАК ПереоценкаЦенныхБумагЦенныеБумаги1
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ПереоценкаЦенныхБумагЦенныеБумаги1.УчетныйАктивЕПС = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			КОГДА &Период < ДАТАВРЕМЯ(2023, 7, 1)
