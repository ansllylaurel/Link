		|		ПО (РасчетныеЦеныПаев.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (РасчетныеЦеныПаев.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, МЕСЯЦ, -6))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФ
		|		ПО (Паи.ПаевойИнвестиционныйФонд = РеквизитыПИФ.ПаевойИнвестиционныйФонд)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЦБУровень1 КАК ЦБУровень1
		|		ПО (ЦБУровень1.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЦБУровень2 КАК ЦБУровень2
		|		ПО (ЦБУровень2.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|ГДЕ
		|	ЦБУровень1.ЦеннаяБумага ЕСТЬ NULL
		|	И ЦБУровень2.ЦеннаяБумага ЕСТЬ NULL
		|	И НЕ &ТолькоНаблюдаемыеЦены
		|	И ВЫБОР
		|			КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|					И ТаблицаЦБ.ЭмитентРоссийский
		|				ТОГДА ВЫБОР
		|						КОГДА &ДатаПереоценки >= ДАТАВРЕМЯ(2020, 5, 27)
		|							ТОГДА РасчетныеЦеныНРД.RATE > 0
		|									И РасчетныеЦеныНРД.VERSION = ""2""
		|									И РасчетныеЦеныНРД.METHOD_NUMBER = ""3""
		|						ИНАЧЕ РасчетныеЦеныНРД.RATE > 0
		|								И РасчетныеЦеныНРД.TYPE = ""bond""
		|								И РасчетныеЦеныНРД.VERSION = ""2""
		|								И РасчетныеЦеныНРД.METHOD_NUMBER = ""3""
		|					КОНЕЦ
		|			КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|				ТОГДА РасчетныеЦеныПаев.РасчетнаяЦена > 0
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦБУровень1.Рынок КАК Рынок,
		|	ЦБУровень1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЦБУровень1.ВалютаНоминала КАК ВалютаНоминала,
		|	ЦБУровень1.УровеньОценки КАК УровеньОценки,
		|	ЦБУровень1.ВидЦены КАК ВидЦены,
		|	ЦБУровень1.СправедливаяЦена КАК СправедливаяЦена,
		|	ЦБУровень1.ВалютаЦены КАК ВалютаКотировки,
		|	ЦБУровень1.ВалютаЦены КАК Валюта,
		|	ЦБУровень1.ДатаЦены КАК ДатаЦены,
		|	ЦБУровень1.Источник КАК Источник
		|ПОМЕСТИТЬ ОцененныеБумаги
		|ИЗ
		|	ЦБУровень1 КАК ЦБУровень1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЦБУровень2.Рынок,
		|	ЦБУровень2.ЦеннаяБумага,
		|	ЦБУровень2.ВалютаНоминала,
		|	ЦБУровень2.УровеньОценки,
		|	ЦБУровень2.ВидЦены,
		|	ЦБУровень2.СправедливаяЦена,
		|	ЦБУровень2.ВалютаЦены,
		|	ЦБУровень2.ВалютаЦены,
		|	ЦБУровень2.ДатаЦены,
		|	ЦБУровень2.Источник
		|ИЗ
		|	ЦБУровень2 КАК ЦБУровень2
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЦБУровень3.Рынок,
		|	ЦБУровень3.ЦеннаяБумага,
		|	ЦБУровень3.ВалютаНоминала,
		|	ЦБУровень3.УровеньОценки,
		|	ЦБУровень3.ВидЦены,
		|	ЦБУровень3.СправедливаяЦена,
		|	ЦБУровень3.ВалютаЦены,
		|	ЦБУровень3.ВалютаЦены,
		|	ЦБУровень3.ДатаЦены,
		|	ЦБУровень3.Источник
		|ИЗ
		|	ЦБУровень3 КАК ЦБУровень3
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(ОцененныеБумаги.СправедливаяЦена * ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|			ИНАЧЕ ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(ОцененныеБумаги.Валюта, 0) КАК Валюта,
		|	ЕСТЬNULL(ОцененныеБумаги.ВалютаКотировки, 0) КАК ВалютаКотировки,
		|	ЕСТЬNULL(ОцененныеБумаги.ВидЦены, 0) КАК ВидЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, ЕСТЬNULL(ОцененныеБумаги.Источник, 0)) КАК Источник,
		|	0 КАК Купон,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаКупона,
		|	ТаблицаЦБ.ЭмитентРоссийский КАК ЭмитентРоссийский,
		|	ТаблицаЦБ.ТипОблигации КАК ТипОблигации
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОцененныеБумаги КАК ОцененныеБумаги
		|		ПО (ОцененныеБумаги.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (Биржи.Ссылка = ОцененныеБумаги.Источник)";
	
	#КонецОбласти
	
	ТолькоНаблюдаемыеЦены = ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены;
	
	ММВБ		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	НРД			= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");
	Блумберг	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
	Режим_BGN	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN");
	Режим_BVAL	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL");
	ВалютаРубли	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");
	
	ПоследняяДатаТорговБлумберга = РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки, Блумберг);	
	
	Запрос.УстановитьПараметр("ММВБ",					ММВБ);	
	Запрос.УстановитьПараметр("НРД",					НРД);
	Запрос.УстановитьПараметр("Блумберг",				Блумберг);
	Запрос.УстановитьПараметр("Режим_BGN",				Режим_BGN);
	Запрос.УстановитьПараметр("Режим_BVAL",				Режим_BVAL);
	Запрос.УстановитьПараметр("ВалютаРубли",			ВалютаРубли);
	
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберга",	ПоследняяДатаТорговБлумберга);
	
	Запрос.УстановитьПараметр("ДоступныДанныеBloomberg",		ПроверитьДоступностьДанныхBloomberg(ДатаПереоценки));
	Запрос.УстановитьПараметр("ОцениватьОВОЗРФПоБлумбергу",		ДатаПереоценки < '20230401');
	
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены",	ТолькоНаблюдаемыеЦены);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Ханты-Мансийский 2020 (ЕПС)", "Таблица стоимостей ЦБ", , , "_ИсходнаяТаблицаЦБ, _ЭмитентыЦенныхБумаг");		
	КонецЕсли;
	
	Если ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;	
	
	// Расчетные цены 	
	
	ВыполненРасчетЦены = Ложь;
	
	ПараметрыОценки.Вставить("ТочностьСтавкиДисконтирования", 2);
	
	Если ДатаПереоценки >= '20230401' Тогда
		ПараметрыОценки.Вставить("ТочностьКБД",						2);
		ПараметрыОценки.Вставить("ТочностьДисконтированногоПотока",	2);
	КонецЕсли;
	
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены) Тогда
			Продолжить;
		КонецЕсли;
		
		// Расчетные цены
		
		ОшибкаРасчета = Ложь;
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда

			Если СтрокаСтоимостейЦБ.ЭмитентРоссийский Тогда
				
				// Государственные ценные бумаги РФ
				// Ценные бумаги субъектов РФ и органов местного самоуправления
				// Облигации российских эмитентов
				// Облигация внешних облигационных займов РФ
			
				#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков
				
				ТочностьЦены = ?(ДатаПереоценки >= '20200527', 2, 5);
				
				ПараметрыДенежногоПотока = ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, СтрокаСтоимостейЦБ.ЦеннаяБумага, Отказ);
				
				ЦенаЗаполнена = ЗаполнитьДисконтированнойПоБезрисковойСтавкеДоходностиСтоимостью(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, ПараметрыДенежногоПотока, , 3, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, ТочностьЦены, ОшибкаРасчета, РасшифровкаРасчета);
				
				Если ОшибкаРасчета Тогда
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
				ИначеЕсли ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
				КонецЕсли;
				
				#КонецОбласти
				
			КонецЕсли;
			
		ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
			
			Если СтрокаСтоимостейЦБ.ЭмитентРоссийский Тогда
			
				#Область Расчет_на_основе_корректировки_исторической_цены					
				
				// Справедливая стоимость акций российских эмитентов в соответствии
				// с моделью оценки, основанной на корректировке исторической цены (CAPM).
				// Применяем при отсутствии цены не более 10 рабочих дней
				
				ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, Справочники.Календари.Общероссийский, 3, , ОшибкаРасчета, РасшифровкаРасчета);  
				
				Если ОшибкаРасчета Тогда
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
				ИначеЕсли ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
				КонецЕсли;
				
				#КонецОбласти
				
			КонецЕсли;
			
		КонецЕсли;

	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "Таблица стоимостей ЦБ", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныРЭМ(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено) 
	
	Запрос = Новый Запрос;
	
	Если ДатаПереоценки < Дата(2018, 3, 31) ИЛИ ПараметрыОценки.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда
		
		#Область Для_РПИ_или_до_31_03_2018
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ТаблицаСпискаЦБ.Рынок КАК Рынок
			|ПОМЕСТИТЬ _ТаблицаСпискаЦБ
			|ИЗ
			|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Облигации.Ссылка КАК Ссылка
			|ПОМЕСТИТЬ _Облигации_2_5
			|ИЗ
			|	_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
			|		ПО _ТаблицаСпискаЦБ.ЦеннаяБумага = Облигации.Ссылка
			|ГДЕ
			|	Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	Облигации.Ссылка
			|ИЗ
			|	_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
			|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
			|						&ПоследнийТорговыйДень,
			|						Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
			|							И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
			|							И ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация)) КАК РеквизитыЮридическихЛицСрезПоследних
			|				ПО Эмитенты.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
			|			ПО Облигации.Эмитент = Эмитенты.Ссылка
			|		ПО _ТаблицаСпискаЦБ.ЦеннаяБумага = Облигации.Ссылка
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	Облигации.Ссылка
			|ИЗ
			|	_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
			|		ПО _ТаблицаСпискаЦБ.ЦеннаяБумага = Облигации.Ссылка
			|ГДЕ
			|	Облигации.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	Облигации.Ссылка
			|ИЗ
			|	_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
