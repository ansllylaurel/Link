	Запрос.УстановитьПараметр("ММВБ_2_2_1_БратьКупонТолькоНаДатуОценки", 		ММВБ_2_2_1_БратьКупонТолькоНаДатуОценки);
	Запрос.УстановитьПараметр("Купоны_2_2_БратьКупонТолькоВКонецМесяца",		Купоны_2_2_БратьКупонТолькоВКонецМесяца);
	Запрос.УстановитьПараметр("До_П_2_2_5_ПриоритетКупонаКотировокЦенныхБумаг",	До_П_2_2_5_ПриоритетКупонаКотировокЦенныхБумаг);
		
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены РЭМ (ЕПС)", "Таблица стоимостей ЦБ", , , "_СтоимостьПереоценкиСрезПоследних");		
	КонецЕсли;
	
	СтрокиДляДозаполненияИзПартий = Новый Массив;		
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		Если СтрокаСтоимостейЦБ.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.Номинал Или СтрокаСтоимостейЦБ.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.Дефолт Тогда			
