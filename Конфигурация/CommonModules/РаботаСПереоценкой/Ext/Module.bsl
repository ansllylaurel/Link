	Запрос.УстановитьПараметр("ТорговыхДнейНазад10",				ТорговыхДнейНазад10);
	Запрос.УстановитьПараметр("БумагиНерезидентов",					ИностранныеУчетныеАктивы);
	Запрос.УстановитьПараметр("ОВОЗ",								Перечисления.ВидыГосударственныхОблигаций.ОВОЗ);
	
	Запрос.УстановитьПараметр("ПроверятьОбъемСделокАктивногоРынкаВПоследнийТорговыйДень", ДатаПереоценки >= '20200101');
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Газфонда", "Промежуточная таблица стоимостей ЦБ");		
	КонецЕсли;
	
	// Проверка адекватности и расчет цен
	
	ПараметрыОценки.Вставить("ТочностьСтавкиДисконтирования", 2);
	
	ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
	
	Для Каждого СтрокаСтоимости Из ТаблицаСтоимостейЦБ Цикл
		
		Если СтрокаСтоимости.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.Номинал Тогда
			
			Продолжить; // Цену получили в запросе, доп. обработка не требуется
			
		ИначеЕсли СтрокаСтоимости.ОценкаПоАмортизированнойСтоимости Тогда
			
			// Амортизированную стоимость считаем в процедуре ЗаполнитьПереоценкуГазфонда, т.к. она зависит от даты и стоимости покупки 
			 		
		Иначе
			
			ЦеннаяБумага = СтрокаСтоимости.ЦеннаяБумага;
			
			Если СтрокаСтоимости.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				
				СтрокаСтоимости.Купон				= Справочники.Облигации.ПолучитьКупон(ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
				
				НоминалНаДату						= СтрокаСтоимости.Номинал / 100;
				
				РейтинговаяГруппа					= Неопределено;
				КредитныйСпред						= Неопределено;
				ДенежныйПоток						= Неопределено;
				БезрисковаяСтавкаДоходности			= Неопределено;
				
			Иначе
				
				НоминалНаДату						= 1;
				
			КонецЕсли;			
			
			// Активный рынок		
			
			Если СтрокаСтоимости.КотировкаАктивногоРынка > 0 Тогда
				
				Если СтрокаСтоимости.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.РыночнаяЦена2 Тогда
					
					СтрокаСтоимости.УровеньОценки	= 1;
					СтрокаСтоимости.Источник		= СтрокаСтоимости.БиржаЮрФизЛицо;
					СтрокаСтоимости.Стоимость		= СтрокаСтоимости.КотировкаАктивногоРынка * НоминалНаДату;
					
					Если СтрокаСтоимости.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
						СтрокаСтоимости.ВалютаКотировки = СтрокаСтоимости.ВалютаНоминала;
					КонецЕсли;
					
					Продолжить;
					
				Иначе
					
					ПроверкаНаАдекватность = ПроверитьЦенуНаАдекватность(ЦеннаяБумага, СтрокаСтоимости.КотировкаАктивногоРынка * НоминалНаДату, ДатаПереоценки, ПараметрыОценки, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, ПараметрыДенежногоПотока, СтрокаСтоимости.Купон, РейтинговаяГруппа, КредитныйСпред, ДенежныйПоток, БезрисковаяСтавкаДоходности, Отказ, РасшифровкаРасчета); 
					
					Если ПроверкаНаАдекватность = Неопределено Тогда
						
						Продолжить;

					ИначеЕсли ПроверкаНаАдекватность Тогда
						
						СтрокаСтоимости.УровеньОценки	= 1;
						СтрокаСтоимости.Источник		= СтрокаСтоимости.БиржаЮрФизЛицо;
						СтрокаСтоимости.Стоимость		= СтрокаСтоимости.КотировкаАктивногоРынка * НоминалНаДату;
						
						Если СтрокаСтоимости.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
							СтрокаСтоимости.ВалютаКотировки = СтрокаСтоимости.ВалютаНоминала;
						КонецЕсли;
						
						Продолжить;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			// Рынок признается неактивным
			
			Если ТолькоНаблюдаемыеЦены Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаСтоимости.ДатаПогашения)
				И НачалоДня(ДатаПереоценки) >= СтрокаСтоимости.ДатаПогашения + 10 * 86400 
			Тогда
			
				// Бумаги с признаками обесценения
				
				СтрокаСтоимости.УровеньОценки	= 3;
				СтрокаСтоимости.Источник		= ЦеннаяБумага.Эмитент.ЮрФизЛицо;
				СтрокаСтоимости.Стоимость		= 0;
				СтрокаСтоимости.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.Дефолт;
				СтрокаСтоимости.ВалютаКотировки	= СтрокаСтоимости.ВалютаНоминала;
				СтрокаСтоимости.ДатаЦены		= СтрокаСтоимости.ДатаПогашения + 10 * 86400;
				
				Продолжить;

			КонецЕсли;
			
			Если СтрокаСтоимости.ЦБРФ Тогда
				
				// Алгоритм 1. Бумаги российских эмитентов, либо номинированные в рублях, либо допущенные к торгам в РФ
				
				Если СтрокаСтоимости.СводныеКотировки_MARKETPRICE2_DATE >= ТорговыхДнейНазад30 И ДатаПереоценки < '20200101'
					ИЛИ СтрокаСтоимости.СводныеКотировки_MARKETPRICE2_DATE >= ТорговыхДнейНазад20
				Тогда
				
					// 2.A (только для долговых)
					
					Если СтрокаСтоимости.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации
						И СтрокаСтоимости.MARKETPRICE2 > 0
					Тогда
					
						ПроверкаНаАдекватность = ПроверитьЦенуНаАдекватность(ЦеннаяБумага, СтрокаСтоимости.MARKETPRICE2 * НоминалНаДату, ДатаПереоценки, ПараметрыОценки, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, ПараметрыДенежногоПотока, СтрокаСтоимости.Купон, РейтинговаяГруппа, КредитныйСпред, ДенежныйПоток, БезрисковаяСтавкаДоходности, Отказ, РасшифровкаРасчета);
						
						Если ПроверкаНаАдекватность = Неопределено Тогда
							
							Продолжить;
							
						ИначеЕсли ПроверкаНаАдекватность Тогда
							
							СтрокаСтоимости.УровеньОценки	= 2;
							СтрокаСтоимости.Источник		= СтрокаСтоимости.БиржаЮрФизЛицо;
							СтрокаСтоимости.Стоимость		= СтрокаСтоимости.MARKETPRICE2 * НоминалНаДату;
							СтрокаСтоимости.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.РыночнаяЦена2;
							СтрокаСтоимости.ДатаЦены		= ДатаПереоценки;
							СтрокаСтоимости.ВалютаКотировки	= СтрокаСтоимости.ВалютаНоминала; 
							
							Продолжить;
							
						КонецЕсли;
						
					КонецЕсли;
					
					// 2.B
					
					Если СтрокаСтоимости.ЦенаНРД > 0 Тогда
					
						ПроверкаНаАдекватность = ПроверитьЦенуНаАдекватность(ЦеннаяБумага, СтрокаСтоимости.ЦенаНРД, ДатаПереоценки, ПараметрыОценки, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, ПараметрыДенежногоПотока, СтрокаСтоимости.Купон, РейтинговаяГруппа, КредитныйСпред, ДенежныйПоток, БезрисковаяСтавкаДоходности, Отказ, РасшифровкаРасчета); 
						
						Если ПроверкаНаАдекватность = Неопределено Тогда
							
							Продолжить;
							
						ИначеЕсли ПроверкаНаАдекватность Тогда
							
							СтрокаСтоимости.УровеньОценки	= 2;
							СтрокаСтоимости.Источник		= НРД;
							СтрокаСтоимости.Стоимость		= СтрокаСтоимости.ЦенаНРД;
							СтрокаСтоимости.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД;
							СтрокаСтоимости.ДатаЦены		= СтрокаСтоимости.ДатаЦеныНРД;
							СтрокаСтоимости.ВалютаКотировки	= СтрокаСтоимости.ВалютаНоминала;
							
							Продолжить;
							
						КонецЕсли;

					КонецЕсли;
					
				КонецЕсли;

				// 2.C 
				
				Если СтрокаСтоимости.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
					
					Если ДенежныйПоток = Неопределено Тогда
						ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ПараметрыДенежногоПотока, ПараметрыОценки, Отказ, РасшифровкаРасчета);
						Если ДенежныйПоток = Неопределено Тогда
							Продолжить;
						КонецЕсли;
					КонецЕсли;
					
					Если КредитныйСпред = Неопределено Тогда
						ДанныеОРейтинге = РаботаСКоллекциями.СкопироватьСтруктуру(ПараметрыРасчетаРейтинга);
						Если РейтинговаяГруппа <> Неопределено Тогда
							ДанныеОРейтинге.Вставить("РейтинговаяГруппа", РейтинговаяГруппа);
						КонецЕсли;
						
						КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(ЦеннаяБумага, ДатаПереоценки, ДанныеОРейтинге, ПараметрыРасчетаКредитногоСпреда, Отказ, РасшифровкаРасчета);				
					КонецЕсли;
					
					ЦенаЗаполнена = ЗаполнитьДисконтированнойПоБезрисковойСтавкеДоходностиСтоимостью(СтрокаСтоимости, ПараметрыОценки, ДатаПереоценки, ДенежныйПоток, , 2, КредитныйСпред, , 4, Отказ, РасшифровкаРасчета);
					
					Если ЦенаЗаполнена Тогда
						Продолжить;
					КонецЕсли;
						
				КонецЕсли;				
				
				// 2.D (только акции российских эмитентов, допущенные к торгам на ММВБ)
				
				Если СтрокаСтоимости.Рынок = Перечисления.РынкиЦенныхБумаг.Акции И СтрокаСтоимости.Торгуется Тогда
					
					#Область Расчет_на_основе_корректировки_исторической_цены					
					
					// Справедливая стоимость акций российских эмитентов, допущенным к торгам на ММВБ,
					// определяется в соответствии с моделью оценки, основанной на корректировке исторической цены (CAPM).
					// Применяем при отсутствии цены не более 10 рабочих дней
					
					ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимости, ПараметрыОценки, ДатаПереоценки, 10, ОсновнойКалендарьКотировок, , , Отказ, РасшифровкаРасчета);
					
					#КонецОбласти					
					
				КонецЕсли;

				// 3.A
				
				Если СтрокаСтоимости.Рынок = Перечисления.РынкиЦенныхБумаг.Паи Тогда
					
					#Область Расчетная_цена_пая					
					
					Запрос = Новый Запрос(
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена КАК РасчетнаяЦена,
						|	РасчетныеЦеныПаевСрезПоследних.Период КАК Период,
						|	РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо КАК ПИФ
						|ИЗ
						|	Справочник.Паи КАК Паи
						|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &Ссылка) КАК РасчетныеЦеныПаевСрезПоследних
						|		ПО Паи.Ссылка = РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага
						|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФСрезПоследних
						|		ПО Паи.ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд
						|ГДЕ
						|	Паи.Ссылка = &Ссылка");
					
					Запрос.УстановитьПараметр("ДатаПереоценки",	ДатаПереоценки);
					Запрос.УстановитьПараметр("Ссылка",			ЦеннаяБумага);
					
					ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
					
					Если ВыборкаДетальныеЗаписи.Следующий() Тогда

						СтрокаСтоимости.УровеньОценки	= 3;
						СтрокаСтоимости.Источник		= ВыборкаДетальныеЗаписи.ПИФ;
						СтрокаСтоимости.Стоимость		= ВыборкаДетальныеЗаписи.РасчетнаяЦена;
						СтрокаСтоимости.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.СЧА;
						СтрокаСтоимости.ДатаЦены		= ВыборкаДетальныеЗаписи.Период;
						СтрокаСтоимости.ВалютаКотировки	= СтрокаСтоимости.ВалютаНоминала;
						
						Если РасшифровкаРасчета <> Неопределено Тогда
							ПараметрыРасчетаЦен = Новый Структура("Примечание, РасчетнаяЦена", "Расчетная цена пая", ВыборкаДетальныеЗаписи.РасчетнаяЦена);
							РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Получить цены Газфонда", "Параметры расчета цены", ПараметрыРасчетаЦен);
						КонецЕсли;
						
						Продолжить;

					КонецЕсли;
					
					#КонецОбласти
					
				КонецЕсли;				
				
			Иначе
				
				// Алгоритм 2. Бумаги иностранных эмитентов, либо номинированные в иностранной валюте
				
				// 2.A и 2.B
				
				Если СтрокаСтоимости.BGN > 0 ИЛИ СтрокаСтоимости.BVAL > 0 Тогда
					
					// По умолчанию проверка на адекватность котировок Блумберг не осуществляется, если это отдельно не заявлено Фондом. Пока не заявлено
					
					СтрокаСтоимости.УровеньОценки	= 2;
					СтрокаСтоимости.Источник		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
					СтрокаСтоимости.Стоимость		= ?(СтрокаСтоимости.BGN > 0, СтрокаСтоимости.BGN, СтрокаСтоимости.BVAL);
					СтрокаСтоимости.ВидЦены			= ?(СтрокаСтоимости.BGN > 0, Перечисления.ИсточникиЦеныДляПереоценки.СредняяЦенаЗакрытия, Перечисления.ИсточникиЦеныДляПереоценки.СредневзвешеннаяЦена);
					СтрокаСтоимости.ДатаЦены		= СтрокаСтоимости.ДатаЦеныБлумберга;
					СтрокаСтоимости.ВалютаКотировки	= ?(СтрокаСтоимости.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации, СтрокаСтоимости.ВалютаНоминала, СтрокаСтоимости.ВалютаБлумберга); 

					Продолжить;
					
				КонецЕсли;
				
			КонецЕсли;
		
		КонецЕсли;
				
		СтрокаСтоимости.ВидЦены		= Перечисления.ИсточникиЦеныДляПереоценки.ПустаяСсылка();
		СтрокаСтоимости.ДатаЦены	= 0;
		
	КонецЦикла;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "Таблица стоимостей ЦБ", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныМегаруссСтрахование710П(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено) 

	// 1. Обл, акции рос. эмитентов, паи зпиф - Цена закрытия на дату, предшествующую дате оценки. Критерий активности рынка - есть цена закрытия на дату оценки.
	//   внебиржа  = НФА (нет данных)
	//   еврооблигации - Bloomberg generic mid/last
	//   паи (интервальные и открытые) - цены паев 	
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ИсходнаяТаблицаЦБ");
	ПоместитьСтатусыЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "_ИсходнаяТаблицаЦБ");
	
	#Область Основной_запрос
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВложенныйЗапрос.Рынок КАК Рынок,
		|	ВложенныйЗапрос.Биржа КАК Биржа,
		|	ВложенныйЗапрос.РежимТоргов КАК РежимТоргов,
		|	ВложенныйЗапрос.Цена КАК Цена,
		|	ВложенныйЗапрос.ДатаЦены КАК ДатаЦены,
		|	ВложенныйЗапрос.ВидЦены КАК ВидЦены,
		|	ВложенныйЗапрос.Валюта КАК Валюта,
		|	ВложенныйЗапрос.Валюта = ВложенныйЗапрос.ВалютаНоминала КАК КотировкаВВалютеНоминала,
		|	ВложенныйЗапрос.ОбъемСделокШтукБумаг КАК ОбъемСделокШтукБумаг,
