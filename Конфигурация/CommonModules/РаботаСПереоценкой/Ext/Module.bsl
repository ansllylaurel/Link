		|	КОНЕЦ КАК ВалютаКотировки,
		|	ВЫБОР
		|		КОГДА ЦеныММВБ_1Уровень.СправедливаяЦена > 0
		|			ТОГДА ЦеныММВБ_1Уровень.ИсточникКотировки
		|		КОГДА ЕСТЬNULL(РасчетныеЦеныНРДСрезПоследних.PRICE, 0) > 0
		|			ТОГДА &НРД
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ИсточникКотировки
		|ПОМЕСТИТЬ НРД_Уровень2
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЦеныММВБ_1Уровень КАК ЦеныММВБ_1Уровень
		|		ПО ТаблицаЦБ.Рынок = ЦеныММВБ_1Уровень.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = ЦеныММВБ_1Уровень.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|					ИЗ
		|						ТаблицаЦБ КАК ТаблицаЦБ)) КАК РасчетныеЦеныНРДСрезПоследних
		|		ПО ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныНРДСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ВЫБОР
		|		КОГДА НРД_Уровень2.СправедливаяЦена > 0
		|			ТОГДА НРД_Уровень2.СправедливаяЦена
		|		КОГДА ТаблицаЦБ.ВидЦеныБлумберга >= 1
		|				И ЕСТЬNULL(Котировки_Bloomberg_BGN.CLOSE, 0) > 0
		|			ТОГДА ВЫБОР
		|					КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|						ТОГДА Котировки_Bloomberg_BGN.CLOSE * ТаблицаЦБ.Номинал / 100
		|					ИНАЧЕ Котировки_Bloomberg_BGN.CLOSE
		|				КОНЕЦ
		|		КОГДА ТаблицаЦБ.ВидЦеныБлумберга = 2
		|				И ЕСТЬNULL(Котировки_Bloomberg_BVAL.CLOSE, 0) > 0
		|			ТОГДА ВЫБОР
		|					КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|						ТОГДА Котировки_Bloomberg_BVAL.CLOSE * ТаблицаЦБ.Номинал / 100
		|					ИНАЧЕ Котировки_Bloomberg_BVAL.CLOSE
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СправедливаяЦена,
		|	ВЫБОР
		|		КОГДА НРД_Уровень2.СправедливаяЦена > 0
		|			ТОГДА НРД_Уровень2.ПолеКотировки
		|		КОГДА ТаблицаЦБ.ВидЦеныБлумберга >= 1
		|				И ЕСТЬNULL(Котировки_Bloomberg_BGN.CLOSE, 0) > 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныдляПереоценки.СредняяЦенаЗакрытия)
		|		КОГДА ТаблицаЦБ.ВидЦеныБлумберга = 2
		|				И ЕСТЬNULL(Котировки_Bloomberg_BVAL.CLOSE, 0) > 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныдляПереоценки.СредневзвешеннаяЦена)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПолеКотировки,
		|	ВЫБОР
		|		КОГДА НРД_Уровень2.СправедливаяЦена > 0
		|			ТОГДА НРД_Уровень2.ДатаКотировки
		|		КОГДА ТаблицаЦБ.ВидЦеныБлумберга >= 1
		|				И ЕСТЬNULL(Котировки_Bloomberg_BGN.CLOSE, 0) > 0
		|			ТОГДА Котировки_Bloomberg_BGN.Период
		|		КОГДА ТаблицаЦБ.ВидЦеныБлумберга = 2
		|				И ЕСТЬNULL(Котировки_Bloomberg_BVAL.CLOSE, 0) > 0
		|			ТОГДА Котировки_Bloomberg_BVAL.Период
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ДатаКотировки,
		|	ВЫБОР
		|		КОГДА НРД_Уровень2.СправедливаяЦена > 0
		|			ТОГДА НРД_Уровень2.УровеньОценки
		|		КОГДА ТаблицаЦБ.ВидЦеныБлумберга >= 1
		|				И ЕСТЬNULL(Котировки_Bloomberg_BGN.CLOSE, 0) > 0
		|			ТОГДА 1
		|		КОГДА ТаблицаЦБ.ВидЦеныБлумберга = 2
		|				И ЕСТЬNULL(Котировки_Bloomberg_BVAL.CLOSE, 0) > 0
		|			ТОГДА 2
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УровеньОценки,
		|	ВЫБОР
		|		КОГДА НРД_Уровень2.СправедливаяЦена > 0
		|			ТОГДА НРД_Уровень2.ИсточникКотировки
		|		КОГДА ТаблицаЦБ.ВидЦеныБлумберга >= 1
		|				И ЕСТЬNULL(Котировки_Bloomberg_BGN.CLOSE, 0) > 0
		|			ТОГДА Котировки_Bloomberg_BGN.Биржа.ЮрФизЛицо
		|		КОГДА ТаблицаЦБ.ВидЦеныБлумберга = 2
		|				И ЕСТЬNULL(Котировки_Bloomberg_BVAL.CLOSE, 0) > 0
		|			ТОГДА Котировки_Bloomberg_BVAL.Биржа.ЮрФизЛицо
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ИсточникКотировки,
		|	ВЫБОР
		|		КОГДА НРД_Уровень2.СправедливаяЦена > 0
		|			ТОГДА НРД_Уровень2.ВалютаКотировки
		|		КОГДА ТаблицаЦБ.ВидЦеныБлумберга >= 1
		|				И ЕСТЬNULL(Котировки_Bloomberg_BGN.CLOSE, 0) > 0
		|			ТОГДА ВЫБОР
		|					КОГДА Котировки_Bloomberg_BGN.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|						ТОГДА ТаблицаЦБ.ВалютаНоминала
		|					ИНАЧЕ Котировки_Bloomberg_BGN.Валюта
		|				КОНЕЦ
		|		КОГДА ТаблицаЦБ.ВидЦеныБлумберга = 2
		|				И ЕСТЬNULL(Котировки_Bloomberg_BVAL.CLOSE, 0) > 0
		|			ТОГДА ВЫБОР
		|					КОГДА Котировки_Bloomberg_BVAL.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|						ТОГДА ТаблицаЦБ.ВалютаНоминала
		|					ИНАЧЕ Котировки_Bloomberg_BVAL.Валюта
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ВалютаКотировки,
		|	ТаблицаЦБ.ВидЦеныБлумберга КАК ВидЦеныБлумберга
		|ПОМЕСТИТЬ КотировкиБлумбергУровень1
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ НРД_Уровень2 КАК НРД_Уровень2
		|		ПО ТаблицаЦБ.ЦеннаяБумага = НРД_Уровень2.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК Котировки_Bloomberg_BGN
		|		ПО (НРД_Уровень2.Рынок = Котировки_Bloomberg_BGN.Рынок)
		|			И (НРД_Уровень2.ЦеннаяБумага = Котировки_Bloomberg_BGN.ЦеннаяБумага)
		|			И (Котировки_Bloomberg_BGN.Биржа = &Блумберг)
		|			И (Котировки_Bloomberg_BGN.РежимТоргов = &Режим_BGN)
		|			И (Котировки_Bloomberg_BGN.Период = &ПоследняяДатаТорговБлумберга)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК Котировки_Bloomberg_BVAL
		|		ПО (НРД_Уровень2.Рынок = Котировки_Bloomberg_BVAL.Рынок)
		|			И (НРД_Уровень2.ЦеннаяБумага = Котировки_Bloomberg_BVAL.ЦеннаяБумага)
		|			И (Котировки_Bloomberg_BVAL.Биржа = &Блумберг)
		|			И (Котировки_Bloomberg_BVAL.РежимТоргов = &Режим_BVAL)
		|			И (Котировки_Bloomberg_BVAL.Период = &ПоследняяДатаТорговБлумберга)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиБлумбергУровень1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиБлумбергУровень1.Рынок КАК Рынок,
		|	КотировкиБлумбергУровень1.Номинал КАК Номинал,
		|	КотировкиБлумбергУровень1.ПолеКотировки КАК ВидЦены,
		|	КотировкиБлумбергУровень1.ДатаКотировки КАК ДатаЦены,
		|	КотировкиБлумбергУровень1.УровеньОценки КАК УровеньОценки,
		|	КотировкиБлумбергУровень1.ИсточникКотировки КАК Источник,
		|	КотировкиБлумбергУровень1.ВалютаКотировки КАК ВалютаКотировки,
		|	КотировкиБлумбергУровень1.ВалютаНоминала КАК ВалютаНоминала,
		|	КотировкиБлумбергУровень1.ВалютаКотировки КАК ВалютаКупона,
		|	ЕСТЬNULL(Биржи.Ссылка, ЗНАЧЕНИЕ(Справочник.Биржи.ПустаяСсылка)) КАК Биржа,
		|	КотировкиБлумбергУровень1.СправедливаяЦена КАК Стоимость,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК ТоргуетсяНаММВБ,
		|	КотировкиБлумбергУровень1.ВидЦеныБлумберга КАК ВидЦеныБлумберга
		|ИЗ
		|	КотировкиБлумбергУровень1 КАК КотировкиБлумбергУровень1
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО КотировкиБлумбергУровень1.ИсточникКотировки = Биржи.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				Статус = ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже)
		|					И Биржа = &ММВБ
		|					И ЦеннаяБумага В
		|						(ВЫБРАТЬ
		|							ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|						ИЗ
		|							ТаблицаЦБ КАК ТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО КотировкиБлумбергУровень1.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага";

	#КонецОбласти
	
	ПоследняяДатаТорговБлумберга	= РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки);	
	ПоследняяДатаТоргов				= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки));
	ТорговыхДнейНазад10				= Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -10);
	
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",			ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10",			ТорговыхДнейНазад10);
	Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберга",	ПоследняяДатаТорговБлумберга);
	
	Запрос.УстановитьПараметр("ММВБ",							ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("Блумберг",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	
	Запрос.УстановитьПараметр("Режим_BGN",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	
	Запрос.УстановитьПараметр("НРД",							ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("ИностранныеУчетныеАктивы",		Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы());
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ",				ТаблицаЦБ);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Стройкомплекс 2018 (ЕПС)", "Таблица стоимостей ЦБ");		
	КонецЕсли;
	
	ЗаполнитьНеоцененныеБумагиРасчетнымиЦенамиНационального2018(ПараметрыОценки, ДатаПереоценки, ТаблицаСтоимостейЦБ, Ложь, Истина, РасшифровкаРасчета);
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныСургутнефтегаза(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаСпискаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	ЕСТЬNULL(Облигации.ДатаНачалаОбращения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаОбращения,
		|	ЕСТЬNULL(Облигации.ДатаНачалаРазмещения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаРазмещения
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	КотировкиТорговыхПлощадок.Рынок КАК Рынок,
		|	КотировкиТорговыхПлощадок.Биржа КАК Биржа,
		|	КотировкиТорговыхПлощадок.Валюта КАК Валюта,
		|	КурсыВалют.Кратность КАК Кратность,
		|	КурсыВалют.Курс КАК Курс
		|ПОМЕСТИТЬ АктивныйРынокММВБ90Дней
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|			ПО КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта
		|				И (КурсыВалют.Период = &ДатаПереоценки)
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадок.Рынок
