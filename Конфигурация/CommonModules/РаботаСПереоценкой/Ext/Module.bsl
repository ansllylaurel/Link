		|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ЦенаСпроса)
		|				ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ЦенаПредложения)
		|			КОНЕЦ
		|	КОНЕЦ КАК ВидЦены,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаЦены,
		|	ВЫБОР
		|		КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА РасчетныеЦеныНРД.RATE
		|		ИНАЧЕ РасчетныеЦеныНРД.PRICE
		|	КОНЕЦ КАК ЦенаНРД,
		|	ЕСТЬNULL(_КотировкиОсновногоРынка.BID, 0) КАК BID,
		|	ЕСТЬNULL(_КотировкиОсновногоРынка.OFFER, 0) КАК OFFER,
		|	""Цена НРД должна попадать в спред BID и OFFER, иначе берется ближайшая граница спреда"" КАК Примечание
		|ПОМЕСТИТЬ _ЦБУровень2
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ОсновныеРынкиЦБ КАК _ОсновныеРынкиЦБ
		|		ПО (_ОсновныеРынкиЦБ.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦБУровень1 КАК _ЦБУровень1
		|		ПО (_ЦБУровень1.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КотировкиОсновногоРынка КАК _КотировкиОсновногоРынка
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КотировкиОсновногоРынкаПриоритетРежимаТорговПоОбъему КАК _ПриоритетРежимаТорговПоОбъему
		|			ПО (_ПриоритетРежимаТорговПоОбъему.ЦеннаяБумага = _КотировкиОсновногоРынка.ЦеннаяБумага)
		|				И (_ПриоритетРежимаТорговПоОбъему.РежимТоргов = _КотировкиОсновногоРынка.РежимТоргов)
		|				И (_ПриоритетРежимаТорговПоОбъему.Приоритет = 1)
		|		ПО (_КотировкиОсновногоРынка.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				РасчетныеЦеныНРД.ЦеннаяБумага КАК ЦеннаяБумага,
		|				МАКСИМУМ(РасчетныеЦеныНРД.Период) КАК Период
		|			ИЗ
		|				РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаЦБ КАК _ТаблицаЦБ
		|					ПО (_ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныНРД.ЦеннаяБумага)
		|						И (_ТаблицаЦБ.Рынок = РасчетныеЦеныНРД.Рынок)
		|			ГДЕ
		|				РасчетныеЦеныНРД.VERSION = ""2""
		|				И РасчетныеЦеныНРД.METHOD_NUMBER В (""1"", ""2"")
		|				И (РасчетныеЦеныНРД.Период = &ДатаПереоценки
		|						ИЛИ РасчетныеЦеныНРД.Период = _ТаблицаЦБ.ПоследняяДатаТоргов)
		|			
		|			СГРУППИРОВАТЬ ПО
		|				РасчетныеЦеныНРД.ЦеннаяБумага) КАК ДатыЦенНРД
		|			ПО (ДатыЦенНРД.ЦеннаяБумага = РасчетныеЦеныНРД.ЦеннаяБумага)
		|				И (ДатыЦенНРД.Период = РасчетныеЦеныНРД.Период)
		|		ПО (РасчетныеЦеныНРД.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (РасчетныеЦеныНРД.Рынок = _ТаблицаЦБ.Рынок)
		|ГДЕ
		|	_ЦБУровень1.ЦеннаяБумага ЕСТЬ NULL
		|	И НЕ &ТолькоНаблюдаемыеЦены
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦБУровень1.Рынок КАК Рынок,
		|	_ЦБУровень1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ЦБУровень1.ВалютаНоминала КАК ВалютаНоминала,
		|	_ЦБУровень1.УровеньОценки КАК УровеньОценки,
		|	_ЦБУровень1.ВидЦены КАК ВидЦены,
		|	_ЦБУровень1.СправедливаяЦена КАК СправедливаяЦена,
		|	_ЦБУровень1.ВалютаЦены КАК ВалютаКотировки,
		|	_ЦБУровень1.ВалютаЦены КАК Валюта,
		|	_ЦБУровень1.ДатаЦены КАК ДатаЦены,
		|	_ЦБУровень1.Источник КАК Источник,
		|	_ЦБУровень1.РежимТоргов КАК РежимТоргов
		|ПОМЕСТИТЬ _ОцененныеБумаги
		|ИЗ
		|	_ЦБУровень1 КАК _ЦБУровень1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦБУровень2.Рынок,
		|	_ЦБУровень2.ЦеннаяБумага,
		|	_ЦБУровень2.ВалютаНоминала,
		|	_ЦБУровень2.УровеньОценки,
		|	_ЦБУровень2.ВидЦены,
		|	_ЦБУровень2.СправедливаяЦена,
		|	_ЦБУровень2.ВалютаЦены,
		|	_ЦБУровень2.ВалютаЦены,
		|	_ЦБУровень2.ДатаЦены,
		|	_ЦБУровень2.Источник,
		|	_ЦБУровень2.РежимТоргов
		|ИЗ
		|	_ЦБУровень2 КАК _ЦБУровень2
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	""Российская торговая площадка"" КАК ОсновнойРынок,
		|	ОцененныеБумаги.Источник КАК ОсновнаяПлощадка,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ТаблицаЦБ.Номинал КАК Номинал,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(ОцененныеБумаги.СправедливаяЦена * _ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|			ИНАЧЕ ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(ОцененныеБумаги.Валюта, 0) КАК Валюта,
		|	ЕСТЬNULL(ОцененныеБумаги.ВалютаКотировки, 0) КАК ВалютаКотировки,
		|	ЕСТЬNULL(ОцененныеБумаги.ВидЦены, 0) КАК ВидЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, ЕСТЬNULL(ОцененныеБумаги.Источник, 0)) КАК Источник,
		|	ЕСТЬNULL(ОцененныеБумаги.РежимТоргов, 0) КАК РежимТоргов,
		|	_ТаблицаЦБ.ЭмитентРоссийский КАК ЭмитентРоссийский,
		|	_ТаблицаЦБ.ПоследняяДатаТоргов КАК ПоследняяДатаТоргов,
		|	0 КАК Купон,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаКупона,
		|	_ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости КАК ОценкаПоАмортизированнойСтоимости,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(_КотировкиАктивногоРынка.BID * _ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|			ИНАЧЕ _КотировкиАктивногоРынка.BID
		|		КОНЕЦ, 0) КАК BID,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(_КотировкиАктивногоРынка.OFFER * _ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|			ИНАЧЕ _КотировкиАктивногоРынка.OFFER
		|		КОНЕЦ, 0) КАК OFFER
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОцененныеБумаги КАК ОцененныеБумаги
		|		ПО (ОцененныеБумаги.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (Биржи.Ссылка = ОцененныеБумаги.Источник)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КотировкиАктивногоРынка КАК _КотировкиАктивногоРынка
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПриоритетРежимаТорговПоВалюте КАК ПриоритетРежимаТорговПоВалюте
		|			ПО (ПриоритетРежимаТорговПоВалюте.ЦеннаяБумага = _КотировкиАктивногоРынка.ЦеннаяБумага)
		|				И (ПриоритетРежимаТорговПоВалюте.РежимТоргов = _КотировкиАктивногоРынка.РежимТоргов)
		|		ПО (_КотировкиАктивногоРынка.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)";

	#КонецОбласти	
			
	ТолькоНаблюдаемыеЦены = ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены;
	
	ММВБ		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");	
	НРД			= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");	
	
	ЮрФизЛицоММВБ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ММВБ, "ЮрФизЛицо");
	
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
		
	Запрос.УстановитьПараметр("ММВБ",							ММВБ);	
	Запрос.УстановитьПараметр("НРД",							НРД);
	
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены",			ТолькоНаблюдаемыеЦены);  
	
	Запрос.УстановитьПараметр("ММВБ_РТС", 						ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС"));
	
	Запрос.УстановитьПараметр("КалендарныхДнейНазад35", 		НачалоДня(ДатаПереоценки) - 34 * 3600 * 24);
	
	ТестироватьНРДНаСпредBidИOffer	= (ДатаПереоценки >= '20260101');
	ИспользоватьЦеныНРДНаУровне3	= (ДатаПереоценки >= '20260101');

	Запрос.УстановитьПараметр("ТестироватьНРДНаСпредBidИOffer",	ТестироватьНРДНаСпредBidИOffer);
	Запрос.УстановитьПараметр("ИспользоватьЦеныНРДНаУровне3",	ИспользоватьЦеныНРДНаУровне3);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Методика Ростех", "Таблица стоимостей ЦБ", , , "_ИсходнаяТаблицаЦБ, _ЭмитентыЦенныхБумаг, _ТаблицаДатРасчетныхЦенПаев");
	КонецЕсли;
	
	Если ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;
	
	// Расчетные цены 	
	ВыполненРасчетЦены = Ложь;	
	
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);	
	ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	
	ПараметрыРасчетаСтоимостиПоАналогам = Новый Структура;
	ПараметрыРасчетаСтоимостиПоАналогам.Вставить("ВариантРасчета",	 Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020);
	ПараметрыРасчетаСтоимостиПоАналогам.Вставить("ПараметрыЗапроса", Запрос.Параметры);
	
	ПараметрыОценки.Вставить("ПараметрыРасчетаСтоимостиПоАналогам", ПараметрыРасчетаСтоимостиПоАналогам);
	ПараметрыОценки.Вставить("ТочностьДисконтированногоПотока",		6);

	ПоследняяДатаТоргов			= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(), НачалоДня(ДатаПереоценки));
	
	ЦеныНРДНаДатуОценки = Неопределено;
	ЦеныНРДПоследнегоТорговогоДня = Неопределено;
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления, , СтрокаСтоимостейЦБ.ВалютаКупона);
		КонецЕсли;
			
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 
			ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены)
			ИЛИ СтрокаСтоимостейЦБ.ОценкаПоАмортизированнойСтоимости
		Тогда
			Продолжить;
		КонецЕсли;
		
		// Требуется расчет цены
		
		ОшибкаРасчета = Ложь;
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
					
			#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков_по_ставке_рассчитанной_по_аналогам
			
			ЦенаЗаполнена = ЗаполнитьДисконтированнойПоСтавкеРассчитаннойПоАналогамСтоимостью(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 2, ПараметрыДенежногоПотока, 2, ОшибкаРасчета, РасшифровкаРасчета);
				
			#КонецОбласти
				
			#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков_по_безрисковой_ставке_доходности
			
			Если Не ЦенаЗаполнена Тогда
								    					
				ОшибкаРасчета = Ложь;
				ЦенаЗаполнена = ЗаполнитьДисконтированнойПоБезрисковойСтавкеДоходностиСтоимостью(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, ПараметрыДенежногоПотока, Истина, 2, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, 2, ОшибкаРасчета, РасшифровкаРасчета);
				
				Если ОшибкаРасчета Тогда
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
					Продолжить;
				ИначеЕсли ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
					Продолжить;
				КонецЕсли;
					
			КонецЕсли; 	
				
			#КонецОбласти
			
			Если ОшибкаРасчета Тогда
				ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
				Продолжить;
			ИначеЕсли ЦенаЗаполнена Тогда
				ВыполненРасчетЦены = Истина;
				Продолжить;
			КонецЕсли;			

		ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда	
						
			#Область Расчет_на_основе_корректировки_исторической_цены
			
			// Справедливая стоимость акций, обращающихся на российских и иностранных фондовых биржах,
			// определяется в соответствии с моделью оценки, основанной на корректировке исторической цены (CAPM).
			// Применяем при отсутствии цены не более 10 рабочих дней
			
			ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, Справочники.Календари.Общероссийский, 2,, ОшибкаРасчета, РасшифровкаРасчета);  
			
			Если ОшибкаРасчета Тогда
				ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
				Продолжить;
			ИначеЕсли ЦенаЗаполнена Тогда
				ВыполненРасчетЦены = Истина;
				Продолжить;
			КонецЕсли;			

			#КонецОбласти
						
		КонецЕсли;
		
		Если Не ЦенаЗаполнена И ИспользоватьЦеныНРДНаУровне3
			И (СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации
				Или СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции)
		Тогда
		
			#Область Расчетная_цена_НРД_3_уровня

			Если ЦеныНРДНаДатуОценки = Неопределено Тогда
				ЦеныНРДНаДатуОценки = ПолучитьЦеныНРД(ТаблицаСтоимостейЦБ, НачалоДня(ДатаПереоценки), РасшифровкаРасчета);
			КонецЕсли;

			ЦеныНРДТекущейЦБ = ЦеныНРДНаДатуОценки.Скопировать(Новый Структура("ЦеннаяБумага, VERSION, METHOD_NUMBER", СтрокаСтоимостейЦБ.ЦеннаяБумага, "2", "3")); 

			Если ЦеныНРДТекущейЦБ.Количество() = 0 И НачалоДня(ДатаПереоценки) <> ПоследняяДатаТоргов Тогда
				Если ЦеныНРДПоследнегоТорговогоДня = Неопределено Тогда
					ЦеныНРДПоследнегоТорговогоДня = ПолучитьЦеныНРД(ТаблицаСтоимостейЦБ, ПоследняяДатаТоргов, РасшифровкаРасчета);
				КонецЕсли;	
					
				ЦеныНРДТекущейЦБ = ЦеныНРДПоследнегоТорговогоДня.Скопировать(Новый Структура("ЦеннаяБумага, VERSION, METHOD_NUMBER", СтрокаСтоимостейЦБ.ЦеннаяБумага, "2", "3")); 
			КонецЕсли;

			Если ЦеныНРДТекущейЦБ.Количество() > 0 Тогда

				ЦенаНРД	= ЦеныНРДТекущейЦБ[0].Цена;
				BID		= СтрокаСтоимостейЦБ.BID;
				OFFER	= СтрокаСтоимостейЦБ.OFFER;
													
				Если OFFER = 0 ИЛИ BID = 0
					ИЛИ BID < ЦенаНРД И ЦенаНРД < OFFER 	
					ИЛИ OFFER < ЦенаНРД И ЦенаНРД < BID 	
				Тогда
					
					СтрокаСтоимостейЦБ.Стоимость	= ЦенаНРД;
					СтрокаСтоимостейЦБ.ДатаЦены		= ЦеныНРДТекущейЦБ[0].ДатаЦены;
					СтрокаСтоимостейЦБ.ВидЦены		= Перечисления.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД;
					СтрокаСтоимостейЦБ.Источник		= НРД;
					
				ИначеЕсли МатематическиеФункции.МодульЧисла(ЦенаНРД - OFFER) < МатематическиеФункции.МодульЧисла(ЦенаНРД - BID) Тогда
					
					СтрокаСтоимостейЦБ.Стоимость	= OFFER;
					СтрокаСтоимостейЦБ.ДатаЦены		= СтрокаСтоимостейЦБ.ПоследняяДатаТоргов;
					СтрокаСтоимостейЦБ.ВидЦены 		= Перечисления.ИсточникиЦеныДляПереоценки.ЦенаПредложения;
					СтрокаСтоимостейЦБ.Источник		= ЮрФизЛицоММВБ;
					
				Иначе
					
					СтрокаСтоимостейЦБ.Стоимость	= BID;
					СтрокаСтоимостейЦБ.ДатаЦены		= СтрокаСтоимостейЦБ.ПоследняяДатаТоргов;
					СтрокаСтоимостейЦБ.ВидЦены		= Перечисления.ИсточникиЦеныДляПереоценки.ЦенаСпроса;
					СтрокаСтоимостейЦБ.Источник		= ЮрФизЛицоММВБ;
										
				КонецЕсли;
					
				СтрокаСтоимостейЦБ.УровеньОценки	= 3;
				СтрокаСтоимостейЦБ.ВалютаКотировки	= СтрокаСтоимостейЦБ.ВалютаНоминала;

				Если РасшифровкаРасчета <> Неопределено Тогда
					ПараметрыРасчетаЦен = Новый Структура("Описание, ЦенаНРД, OFFER, BID, Цена",
						"Цена НРД должна попадать в спред BID и OFFER, иначе берется ближайшая граница спреда", ЦенаНРД, OFFER, BID, СтрокаСтоимостейЦБ.Стоимость);
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Тестирование цены НРД", ПараметрыРасчетаЦен);
				КонецЕсли;					
				
				ВыполненРасчетЦены = Истина;
				Продолжить;
				
			КонецЕсли;
			
			#КонецОбласти
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ОблигацииОФЗСОтдельнойПроверкойЦеныЗакрытияНаПервомУровнеДляМетодикиБудущее2020(ТаблицаЦБ, ДатаПереоценки)
	
	Результат = Новый Массив;
	Если ДатаПереоценки < '20251101' Тогда
		
		// Сначала были письма с перечислением конкретных выпусков ОФЗ
		Результат.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин29026"));
		Результат.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин29027"));
		Результат.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин29028"));		
		
	ИначеЕсли ДатаПереоценки >= '20251114' Тогда
		
		// Далее было выпущено другое письмо:
		// для целей оценки справедливой стоимости облигаций федерального займа РФ с плавающим купонным доходом ... с даты начала размещения 
		// выпуска облигаций федерального займа РФ с плавающим купонным доходом до его включения Ценовым Центром НРД в список инструментов, оцениваемых
		// по Методике оценки облигаций с плавающей структурой платежей (до даты, на которую получены данные по оценке выпуска Ценовым Центром НРД)
		
		Запрос = Новый Запрос(		
		    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		    |	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		    |ПОМЕСТИТЬ _ТаблицаЦБ
		    |ИЗ
		    |	&ТаблицаЦБ КАК ТаблицаЦБ
		    |;
		    |
		    |////////////////////////////////////////////////////////////////////////////////
		    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		    |	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		    |	Облигации.ДатаНачалаРазмещения КАК ДатаНачалаРазмещения
		    |ПОМЕСТИТЬ _ОФЗСПеременнымКупоном
		    |ИЗ
		    |	_ТаблицаЦБ КАК _ТаблицаЦБ
		    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		    |		ПО _ТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		    |			И (Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная))
		    |			И (Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОФЗ))
		    |			И (Облигации.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыОблигаций.КупоннаяПК))
		    |;
		    |
		    |////////////////////////////////////////////////////////////////////////////////
		    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		    |	_ОФЗСПеременнымКупоном.ЦеннаяБумага КАК ЦеннаяБумага
		    |ИЗ
		    |	_ОФЗСПеременнымКупоном КАК _ОФЗСПеременнымКупоном
		    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
		    |		ПО _ОФЗСПеременнымКупоном.ЦеннаяБумага = РасчетныеЦеныНРД.ЦеннаяБумага
		    |			И (РасчетныеЦеныНРД.Период <= &ДатаПереоценки)
		    |			И (РасчетныеЦеныНРД.Период >= _ОФЗСПеременнымКупоном.ДатаНачалаРазмещения)
		    |ГДЕ
		    |	РасчетныеЦеныНРД.ЦеннаяБумага ЕСТЬ NULL");
		
		Запрос.УстановитьПараметр("ТаблицаЦБ",		ТаблицаЦБ);
		Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
		
		Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЦеннаяБумага");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Вспомогательные_функции

// Помещает биржевые индексы, соответствующие ценным бумагам согласно методике оценки, в менеджер временных таблиц
//
// Параметры:
//	ИсточникВременныхТаблиц	- Запрос, МенеджерВременныхТаблиц	- источник временных таблиц
//	ПараметрыОценки			- Структура							- см. РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС
//	Период					- Дата								- дата, на которую подбираются индексы
//	ЦенныеБумаги			- Строка							- имя временной таблицы с бумагами, состав см. в ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц
//	ИмяВременнойТаблицы		- Строка							- имя таблицы, под которым она будет создана в менеджере
//	Отказ					- Булево							- выходной параметр, при ошибке устанавливается в значение Истина
//
Процедура ПоместитьБиржевыеИндексыСоответствующиеЦеннымБумагамВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, ПараметрыОценки, Период, ЦенныеБумаги, ИмяВременнойТаблицы = "_БиржевыеИндексыЦенныхБумаг", Отказ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СистемныеФункции.МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц);
	
	СохраняемыеТаблицы = СистемныеФункции.ПолучитьИменаВременныхТаблицЗапроса(Запрос);
	СохраняемыеТаблицы.Добавить(ИмяВременнойТаблицы);
	
	// Помещаем во временную таблицу
	
	Если ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Сургутнефтегаз2020 И Период >= '20230619' Тогда
		
		#Область СНГ_с_19_06_2023
		
		ПараметрыРасчетаРейтинга = ПолучитьПараметрыРасчетаРейтингаПоУмолчанию(ПараметрыОценки.СчетДоверительногоУправления, Период);
		ПараметрыРасчетаРейтинга.Вставить("ИсточникТаблицыСоответствияРейтингов",	Справочники.ВнешниеСистемы.Сургутнефтегаз20230619);
		ПараметрыРасчетаРейтинга.Вставить("УчитыватьВидРейтинга",					Истина);
		ПараметрыРасчетаРейтинга.Вставить("УчитыватьПриоритетРейтингов",			Истина);
		
		СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(
			ЦенныеБумаги, "_СубъектыРейтингаДляПодбораИндекса", Запрос, , Новый Структура("Субъект", "ЦеннаяБумага"));
		
		РаботаСПоказателямиФинансовыхИнструментов.ПоместитьРейтинговыеГруппыСубъектовВМенеджерВременныхТаблиц(
			Запрос, "_СубъектыРейтингаДляПодбораИндекса", Период, ПараметрыРасчетаРейтинга, "_РейтинговыеГруппыДляПодбораИндекса");
		
		ПоместитьДюрацииОблигацийВМенеджерВременныхТаблиц(Запрос, Период, ЦенныеБумаги, "_ДюрацииОблигаций");
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СоответствующийБиржевойИндекс.Ссылка КАК БиржевойИндекс,
			|	ЕСТЬNULL(Облигации.Категория, НЕОПРЕДЕЛЕНО) КАК КатегорияОблигации,
			|	ЕСТЬNULL(_ДюрацииОблигаций.Значение, НЕОПРЕДЕЛЕНО) КАК СрокОблигации,
			|	_РейтинговыеГруппы.НомерГруппы КАК РейтинговаяГруппа
			|ПОМЕСТИТЬ #БиржевыеИндексыЦенныхБумаг#
			|ИЗ
			|	#ЦенныеБумаги# КАК _ЦенныеБумаги
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
			|		ПО (Облигации.Ссылка = _ЦенныеБумаги.ЦеннаяБумага)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _РейтинговыеГруппыДляПодбораИндекса КАК _РейтинговыеГруппы
			|		ПО (_РейтинговыеГруппы.Субъект = _ЦенныеБумаги.ЦеннаяБумага)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ДюрацииОблигаций КАК _ДюрацииОблигаций
			|		ПО (_ДюрацииОблигаций.ЦеннаяБумага = _ЦенныеБумаги.ЦеннаяБумага)
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БиржевыеИндексы КАК СоответствующийБиржевойИндекс
			|		ПО (ВЫБОР
			|				КОГДА _ЦенныеБумаги.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
			|					ТОГДА СоответствующийБиржевойИндекс.Код = ""IMOEX""
			|				КОГДА _ЦенныеБумаги.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|					ТОГДА ВЫБОР
			|							КОГДА Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная)
			|								ТОГДА ВЫБОР
			|										КОГДА _ДюрацииОблигаций.Значение = 0
			|											ТОГДА СоответствующийБиржевойИндекс.Код = ""RUGBITR1Y""
			|										КОГДА _ДюрацииОблигаций.Значение <= 3
			|											ТОГДА СоответствующийБиржевойИндекс.Код = ""RUGBITR3Y""
			|										КОГДА _ДюрацииОблигаций.Значение <= 5
			|											ТОГДА СоответствующийБиржевойИндекс.Код = ""RUGBITR5Y""
			|										КОГДА _ДюрацииОблигаций.Значение <= 10
			|											ТОГДА СоответствующийБиржевойИндекс.Код = ""RUGBITR10Y""
			|									КОНЕЦ
			|							КОГДА Облигации.Категория В (ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная), ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация), ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Ипотечная))
			|								ТОГДА ВЫБОР
			|										КОГДА _ДюрацииОблигаций.Значение = 0
			|											ТОГДА СоответствующийБиржевойИндекс.Код = ""RUCBITR1Y""
			|										КОГДА _ДюрацииОблигаций.Значение <= 3
			|											ТОГДА ВЫБОР
			|													КОГДА _РейтинговыеГруппы.НомерГруппы = 1
			|														ТОГДА СоответствующийБиржевойИндекс.Код = ""RUCBTR3A3YNS""
			|													КОГДА _РейтинговыеГруппы.НомерГруппы = 2
			|														ТОГДА СоответствующийБиржевойИндекс.Код = ""RUCBTRAA3YNS""
			|													КОГДА _РейтинговыеГруппы.НомерГруппы = 3
			|														ТОГДА СоответствующийБиржевойИндекс.Код = ""RUCBTRA3YNS""
			|												КОНЕЦ
			|										КОГДА _ДюрацииОблигаций.Значение > 3
			|											ТОГДА ВЫБОР
			|													КОГДА _РейтинговыеГруппы.НомерГруппы = 1
			|														ТОГДА СоответствующийБиржевойИндекс.Код = ""RUCBTR3A5YNS""
			|													КОГДА _РейтинговыеГруппы.НомерГруппы = 2
			|														ТОГДА СоответствующийБиржевойИндекс.Код = ""RUCBTRAA5YNS""
			|													КОГДА _РейтинговыеГруппы.НомерГруппы = 3
			|														ТОГДА СоответствующийБиржевойИндекс.Код = ""RUCBTRA5YNS""
			|												КОНЕЦ
			|									КОНЕЦ
			|							КОГДА Облигации.Категория В (ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная), ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Муниципальная))
			|								ТОГДА ВЫБОР
			|										КОГДА _ДюрацииОблигаций.Значение = 0
			|											ТОГДА СоответствующийБиржевойИндекс.Код = ""RUMBITR1Y""
			|										КОГДА _ДюрацииОблигаций.Значение <= 3
			|											ТОГДА ВЫБОР
			|													КОГДА _РейтинговыеГруппы.НомерГруппы = 1
			|														ТОГДА СоответствующийБиржевойИндекс.Код = ""RUMBTR3A3YNS""
			|													КОГДА _РейтинговыеГруппы.НомерГруппы = 2
			|														ТОГДА СоответствующийБиржевойИндекс.Код = ""RUMBTRAA3YNS""
			|													КОГДА _РейтинговыеГруппы.НомерГруппы = 3
			|														ТОГДА СоответствующийБиржевойИндекс.Код = ""RUMBTRA3YNS""
