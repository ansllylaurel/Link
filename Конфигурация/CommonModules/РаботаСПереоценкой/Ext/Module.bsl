	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныРыночная3(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	               |	ТаблицаСпискаЦБ.Рынок КАК Рынок
	               |ПОМЕСТИТЬ _ЦенныеБумаги
	               |ИЗ
	               |	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ЦеннаяБумага,
	               |	Рынок
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
	               |	_ЦенныеБумаги.Рынок КАК Рынок,
	               |	ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследних.Номинал, 0) КАК Номинал,
	               |	ЕСТЬNULL(КотировкиЦенныхБумаг.MARKETPRICE3, 0) * ВЫБОР
	               |		КОГДА КотировкиЦенныхБумаг.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
	               |			ТОГДА ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследних.Номинал, 0) / 100
	               |		ИНАЧЕ 1
	               |	КОНЕЦ КАК Стоимость,
	               |	КотировкиЦенныхБумаг.Валюта КАК ВалютаНоминала,
	               |	ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.РыночнаяЦена3) КАК ВидЦены,
	               |	КотировкиЦенныхБумаг.Биржа.ЮрФизЛицо КАК Источник,
	               |	ЕСТЬNULL(КотировкиЦенныхБумаг.MARKETPRICE3_DATE, ДАТАВРЕМЯ(1980, 1, 1)) КАК ДатаЦены,
	               |	1 КАК УровеньОценки,
	               |	ЕСТЬNULL(КотировкиЦенныхБумаг.ACCINT, 0) КАК Купон,
	               |	КотировкиЦенныхБумаг.Валюта КАК ВалютаКупона
	               |ИЗ
	               |	_ЦенныеБумаги КАК _ЦенныеБумаги
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиЦенныхБумагСводные.СрезПоследних(&ДатаОценки, Биржа = &БиржаММВБ) КАК КотировкиЦенныхБумаг
	               |		ПО _ЦенныеБумаги.ЦеннаяБумага = КотировкиЦенныхБумаг.ЦеннаяБумага
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаОценки, ) КАК НоминалыЦенныхБумагСрезПоследних
	               |		ПО _ЦенныеБумаги.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага";
		
	
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыОценки.СчетДоверительногоУправления);	       
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);	       
	Запрос.УстановитьПараметр("ДатаОценки", НачалоДня(ДатаПереоценки));	 	
	Запрос.УстановитьПараметр("БиржаММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Рыночная 3 (ЕПС)", "Таблица стоимостей ЦБ");		
	Иначе
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Для каждого СтрокаТаблицы из ТаблицаСтоимостейЦБ Цикл
		
		Если ТипЗнч(СтрокаТаблицы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
			
			Если СтрокаТаблицы.Купон = Null Тогда
				СтрокаТаблицы.Купон   = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(СтрокаТаблицы.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
				СтрокаТаблицы.ВалютаКупона = СтрокаТаблицы.ЦеннаяБумага.ВалютаНоминала;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "После заполнения расчетного купона", ТаблицаСтоимостейЦБ.Скопировать());		
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;

КонецФункции

Функция ПолучитьЦеныЗПИФкФДЦБ(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	#Область Основной_запрос	
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	Эмитенты.Ссылка КАК Эмитент,
		|	Эмитенты.ЮрФизЛицо КАК ЮрЛицоЭмитента
		|ПОМЕСТИТЬ ЭмитентыЦенныхБумаг
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|		ПО (Эмитенты.Ссылка = ВЫБОР
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|					ТОГДА ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.Акции).Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|					ТОГДА ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|					ТОГДА ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.Векселя).Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|					ТОГДА ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|					ТОГДА ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент
		|			КОНЕЦ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала = &ВалютаРубли КАК НоминированаВРублях,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК ТоргуетсяНаММВБ,
		|	ЕСТЬNULL(Облигации.ДатаПогашения <> ДАТАВРЕМЯ(1, 1, 1)
		|			И Облигации.ДатаПогашения < ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -7), ЛОЖЬ) КАК СчитаемЧтоДефолт,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, НЕОПРЕДЕЛЕНО) КАК ДатаПогашения,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЭмитентРоссийский,
		|	ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента КАК Эмитент
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ИСТИНА
		|					ИЗ
		|						ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|					ГДЕ
		|						ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, Статус, Биржа, Рынок) В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже),
		|						&ММВБ,
		|						ИсходнаяТаблицаЦБ.Рынок
		|					ИЗ
		|						ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЭмитентыЦенныхБумаг КАК ЭмитентыЦенныхБумаг
		|		ПО (ЭмитентыЦенныхБумаг.ЦеннаяБумага = ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента
		|					ИЗ
		|						ЭмитентыЦенныхБумаг)) КАК РеквизитыЮрЛицаЭмитента
		|		ПО (РеквизитыЮрЛицаЭмитента.ЮрФизЛицо = ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА ТаблицаЦБ.ТоргуетсяНаММВБ
		|				И ТаблицаЦБ.ЭмитентРоссийский
		|			ТОГДА &ММВБ
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК Биржа
		|ПОМЕСТИТЬ ОсновныеРынкиЦБ
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОсновныеРынкиЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.Период КАК Период,
		|	КотировкиТорговыхПлощадок.Валюта КАК Валюта,
		|	КотировкиТорговыхПлощадок.РежимТоргов КАК РежимТоргов,
		|	СУММА(КотировкиТорговыхПлощадок.NUMTRADES) КАК КоличествоСделок,
		|	СУММА(КотировкиТорговыхПлощадок.VALUE) КАК ОбъемСделок,
		|	СУММА(КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность) КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ КотировкиММВБЗаПоследние10ТорговыхДней
		|ИЗ
		|	ОсновныеРынкиЦБ КАК ОсновныеРынкиЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.Рынок = ОсновныеРынкиЦБ.Рынок)
		|			И (КотировкиТорговыхПлощадок.ЦеннаяБумага = ОсновныеРынкиЦБ.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Биржа = ОсновныеРынкиЦБ.Биржа)
		|			И (КотировкиТорговыхПлощадок.Период МЕЖДУ &ТорговыхДнейНазад10 И &ДатаПереоценки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта)
		|			И (КотировкиТорговыхПлощадок.Период = КурсыВалют.Период)
		|ГДЕ
		|	ОсновныеРынкиЦБ.Биржа = &ММВБ
		|
		|СГРУППИРОВАТЬ ПО
		|	ОсновныеРынкиЦБ.ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.Период,
		|	КотировкиТорговыхПлощадок.Валюта,
		|	КотировкиТорговыхПлощадок.РежимТоргов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиММВБЗаПоследние10ТорговыхДней.Период КАК Период,
		|	СУММА(КотировкиММВБЗаПоследние10ТорговыхДней.КоличествоСделок) КАК КоличествоСделок,
		|	СУММА(КотировкиММВБЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета) КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ ИтогиММВБЗаПоследние10ТорговыхДней
		|ИЗ
		|	КотировкиММВБЗаПоследние10ТорговыхДней КАК КотировкиММВБЗаПоследние10ТорговыхДней
		|
		|СГРУППИРОВАТЬ ПО
		|	КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага,
		|	КотировкиММВБЗаПоследние10ТорговыхДней.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОсновныеРынкиЦБ.Рынок КАК Рынок,
		|	ОсновныеРынкиЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОсновныеРынкиЦБ.Биржа КАК Биржа,
		|	СУММА(ИтогиММВБЗаПоследние10ТорговыхДней.КоличествоСделок) КАК КоличествоСделок,
		|	СУММА(ИтогиММВБЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета) КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ АктивыйРынокММВБ
		|ИЗ
		|	ОсновныеРынкиЦБ КАК ОсновныеРынкиЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИтогиММВБЗаПоследние10ТорговыхДней КАК ИтогиММВБЗаПоследние10ТорговыхДней
		|		ПО (ИтогиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага = ОсновныеРынкиЦБ.ЦеннаяБумага)
		|
		|СГРУППИРОВАТЬ ПО
		|	ОсновныеРынкиЦБ.Рынок,
		|	ОсновныеРынкиЦБ.ЦеннаяБумага,
		|	ОсновныеРынкиЦБ.Биржа
		|
		|ИМЕЮЩИЕ
		|	СУММА(ИтогиММВБЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета) >= 500000 И
		|	СУММА(ИтогиММВБЗаПоследние10ТорговыхДней.КоличествоСделок) >= 10
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АктивыйРынокММВБ.Рынок КАК Рынок,
		|	АктивыйРынокММВБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	АктивыйРынокММВБ.Биржа КАК Биржа,
		|	КотировкиЦенныхБумаг.Период КАК Период,
		|	КотировкиЦенныхБумаг.РежимТоргов КАК РежимТоргов,
