		|			ТОГДА ВЫРАЗИТЬ(_ПоследняяОценочнаяСтоимостьНаДатуЦены.Цена * _ПоследняяОценочнаяСтоимостьНаДатуЦены.НоминалНаДатуОценки / НоминалыНаПоследнююОценку.Номинал КАК ЧИСЛО(1, 0))
		|		ИНАЧЕ _ПоследняяОценочнаяСтоимостьНаДатуЦены.Цена
		|	КОНЕЦ КАК Стоимость,
		|	_ПоследняяОценочнаяСтоимостьНаДатуЦены.ВалютаЦены КАК ВалютаКотировки,
		|	_ПоследняяОценочнаяСтоимостьНаДатуЦены.Источник КАК Источник,
		|	_ПоследняяОценочнаяСтоимостьНаДатуЦены.ДатаЦены КАК ДатаЦены,
		|	_ПоследняяОценочнаяСтоимостьНаДатуЦены.УровеньОценки КАК УровеньОценки,
		|	_ПоследняяОценочнаяСтоимостьНаДатуЦены.ВидЦены КАК ВидЦены,
		|	_ПоследняяОценочнаяСтоимостьНаДатуЦены.ДатаОценки КАК ДатаОценки
		|ПОМЕСТИТЬ _ПоследняяОценочнаяСтоимость
		|ИЗ
		|	_ПоследняяОценочнаяСтоимостьНаДатуЦены КАК _ПоследняяОценочнаяСтоимостьНаДатуЦены
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыНаПоследнююОценку
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				_ПоследняяОценочнаяСтоимостьНаДатуЦены.ЦеннаяБумага КАК ЦеннаяБумага,
		|				МАКСИМУМ(НоминалыЦенныхБумаг.Период) КАК Период
		|			ИЗ
		|				_ПоследняяОценочнаяСтоимостьНаДатуЦены КАК _ПоследняяОценочнаяСтоимостьНаДатуЦены
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|					ПО (НоминалыЦенныхБумаг.ЦеннаяБумага = _ПоследняяОценочнаяСтоимостьНаДатуЦены.ЦеннаяБумага)
		|						И (НоминалыЦенныхБумаг.Период <= _ПоследняяОценочнаяСтоимостьНаДатуЦены.ДатаОценки)
		|			
		|			СГРУППИРОВАТЬ ПО
		|				_ПоследняяОценочнаяСтоимостьНаДатуЦены.ЦеннаяБумага) КАК ДатыИзмененийНоминала
		|			ПО (ДатыИзмененийНоминала.ЦеннаяБумага = НоминалыНаПоследнююОценку.ЦеннаяБумага)
		|				И (ДатыИзмененийНоминала.Период = НоминалыНаПоследнююОценку.Период)
		|		ПО (НоминалыНаПоследнююОценку.ЦеннаяБумага = _ПоследняяОценочнаяСтоимостьНаДатуЦены.ЦеннаяБумага)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОцененныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ОцененныеБумаги.Рынок КАК Рынок,
		|	_ОцененныеБумаги.Номинал КАК Номинал,
		|	_ОцененныеБумаги.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	_ОцененныеБумаги.ВалютаНоминала КАК ВалютаНоминала,
		|	_ОцененныеБумаги.Стоимость КАК Стоимость,
		|	_ОцененныеБумаги.ВалютаКотировки КАК ВалютаКотировки,
		|	_ОцененныеБумаги.Источник КАК Источник,
		|	_ОцененныеБумаги.ДатаЦены КАК ДатаЦены,
		|	0 КАК УровеньОценки,
		|	_ОцененныеБумаги.ВидЦены КАК ВидЦены,
		|	ЕСТЬNULL(_ОцененныеБумаги.Купон, 0) КАК Купон,
		|	ВЫБОР
		|		КОГДА _ОцененныеБумаги.Купон ЕСТЬ NULL
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|		ИНАЧЕ _ОцененныеБумаги.ВалютаКупона
		|	КОНЕЦ КАК ВалютаКупона,
		|	НЕ _ДопущенныеКТоргам.ЦеннаяБумага ЕСТЬ NULL КАК ДопущенКТоргам,
		|	_ОцененныеБумаги.РоссийскийЗаемщик КАК РоссийскийЗаемщик
		|ИЗ
		|	_ОцененныеБумаги КАК _ОцененныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДопущенныеКТоргам КАК _ДопущенныеКТоргам
		|		ПО _ОцененныеБумаги.ЦеннаяБумага = _ДопущенныеКТоргам.ЦеннаяБумага";	

	ТипЦены = Метаданные.РегистрыСведений.СтоимостьПереоценки.Ресурсы.Цена.Тип.КвалификаторыЧисла;
			
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЧИСЛО(1, 0)", СтрШаблон("ЧИСЛО(%1, %2)", ТипЦены.Разрядность, ТипЦены.РазрядностьДробнойЧасти));
		
	#КонецОбласти
	
	АкцииПаиРаспискиНерезидентов = Новый Массив;
	АкцииПаиРаспискиНерезидентов.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.АкцииБанковНерезидентов);
	АкцииПаиРаспискиНерезидентов.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.АкцииБанковНерезидентовНеБумаги);
	АкцииПаиРаспискиНерезидентов.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.ПаиФондовНерезидентов);
	АкцииПаиРаспискиНерезидентов.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.ПаиФондовНерезидентовНеБумаги);
	АкцииПаиРаспискиНерезидентов.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.ПрочиеАкцииНерезидентов);
	АкцииПаиРаспискиНерезидентов.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.ПрочиеАкцииНерезидентовНеБумаги);
	АкцииПаиРаспискиНерезидентов.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.ДепозитарныеРаспискиНерезидентов);
	
	ИностранныеОблигации = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииНерезидентов();
	ИностранныеОблигации.Добавить(Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств);
	
	ИностранныеБиржи = Новый ТаблицаЗначений;
	ИностранныеБиржи.Колонки.Добавить("Биржа",		Новый ОписаниеТипов("СправочникСсылка.Биржи"));
	ИностранныеБиржи.Колонки.Добавить("Приоритет",	Новый ОписаниеТипов("Число"));

	ДобавитьСтрокуТаблицыПриоритетаБирж(ИностранныеБиржи, 1, "Биржа_FWB");
	ДобавитьСтрокуТаблицыПриоритетаБирж(ИностранныеБиржи, 2, "Биржа_LSE");
	ДобавитьСтрокуТаблицыПриоритетаБирж(ИностранныеБиржи, 3, "Биржа_NYSE");
	ДобавитьСтрокуТаблицыПриоритетаБирж(ИностранныеБиржи, 4, "Биржа_NYSE_Arca");
	ДобавитьСтрокуТаблицыПриоритетаБирж(ИностранныеБиржи, 5, "Биржа_Насдак");		
	ДобавитьСтрокуТаблицыПриоритетаБирж(ИностранныеБиржи, 6, "Биржа_HKEX");								
	ДобавитьСтрокуТаблицыПриоритетаБирж(ИностранныеБиржи, 7, "Биржа_Сингапур");		
	ДобавитьСтрокуТаблицыПриоритетаБирж(ИностранныеБиржи, 8, "Биржа_Токио");	 		
	
	НастройкиЦелиРасчета = БухгалтерскийУчет.ОпределитьНастройкиЦелиРасчета(
		ДатаПереоценки, ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
		
	ВидыЦенПослеПогашения = Новый Массив;
	ВидыЦенПослеПогашения.Добавить(Перечисления.ИсточникиЦеныДляПереоценки.Погашена);
	ВидыЦенПослеПогашения.Добавить(Перечисления.ИсточникиЦеныДляПереоценки.Номинал);
	ВидыЦенПослеПогашения.Добавить(Перечисления.ИсточникиЦеныДляПереоценки.Дефолт);
		
	КалендарьКотировок		= Константы.ОсновнойКалендарьКотировок.Получить();
	ПоследнийТорговыйДень	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьКотировок, НачалоДня(ДатаПереоценки));
	ТорговыхДнейНазад90		= Справочники.Календари.ДобавитьКДатеРабочиеДни(КалендарьКотировок, НачалоДня(ДатаПереоценки), -90);
		
	ВалютаРубли	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");	

	Запрос.УстановитьПараметр("Организация", 					ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ПараметрыОценки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", 				ТаблицаЦБ);
	
	Запрос.УстановитьПараметр("ВидУчета",						НастройкиЦелиРасчета.ВидУчетаДляОстатковПартий);
	Запрос.УстановитьПараметр("ВалютаУчета",					ПараметрыОценки.Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("ВидыЦенПослеПогашения",			ВидыЦенПослеПогашения);
	
	Запрос.УстановитьПараметр("ММВБ",							ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("НРД",							ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследнийТорговыйДень", 			ПоследнийТорговыйДень);
	
	// Правило для даты котировок изменилось в июле 2023 года, но заметили только в январе 2025, поэтому применяем с декабря 2024
	Запрос.УстановитьПараметр("ДатаКотировок",					?(ДатаПереоценки >= '20241201', ПоследнийТорговыйДень, ДатаПереоценки)); 
	Запрос.УстановитьПараметр("ТорговыхДнейНазад90", 			ТорговыхДнейНазад90);
	
	Запрос.УстановитьПараметр("ИностранныеБиржи", 				ИностранныеБиржи);
	Запрос.УстановитьПараметр("АкцииПаиРаспискиНерезидентов", 	АкцииПаиРаспискиНерезидентов);
	Запрос.УстановитьПараметр("ИностранныеОблигации",			ИностранныеОблигации);

	// Изменения методики
	
	ПриОтсутствииЦеныОцениватьИностранныеОблигацииПоПоследнейЦенеИлиЦенеПриобретения = (ДатаПереоценки >= '20221121');
	
	// В нерабочие концы месяца использование расчетной цены для ин.облигаций запрещено
	РазрешеноИспользованиеРасчетнойЦеныДляИностранныхОблигаций = ДатаПереоценки < '20260101' 
		И (ДатаПереоценки < '20221121'
			ИЛИ КонецДня(ДатаПереоценки) <> КонецМесяца(ДатаПереоценки)
			ИЛИ Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ДатаПереоценки));
	
	Запрос.УстановитьПараметр("ПриОтсутствииЦеныОцениватьИностранныеОблигацииПоПоследнейЦенеИлиЦенеПриобретения", ПриОтсутствииЦеныОцениватьИностранныеОблигацииПоПоследнейЦенеИлиЦенеПриобретения);

	Запрос.УстановитьПараметр("ИспользоватьЦенуЗакрытияДляОтдельныхАктивов", ДатаПереоценки >= '20260101');
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены РЭМ (ЕПС)", "Таблица стоимостей ЦБ", , , "_ПоследняяОценочнаяСтоимостьНаДатуЦены, _ПоследняяОценочнаяСтоимость");		
	КонецЕсли;
	
	// Расчетные цены
	
	ПараметрыОценки.Вставить("ПараметрыРасчетаФорвардногоКурса", Новый Структура("СрокИндексов, ИспользоватьИндексыГосударственныхОблигацийЗоныЕвроСРейтингомААА", 1, Истина));

	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	
	СтрокиДляДозаполненияИзПартий	= Новый Массив;		
	МассивЦББезЦенДляУведомления	= Новый Массив;
	ПоследняяОценочнаяСтоимость		= Неопределено;
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		Если ВидыЦенПослеПогашения.Найти(СтрокаСтоимостейЦБ.ВидЦены) <> Неопределено Тогда			
			Продолжить; // Дополнительная обработка не требуется
		КонецЕсли;
		
		Если ДатаПереоценки >= '20251128' И СтрокаСтоимостейЦБ.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин12840111V") Тогда
			
			ТочностьКупонаВВалютеНоминала = 2;			
			СтрокаСтоимостейЦБ.Купон  = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления, , СтрокаСтоимостейЦБ.ВалютаКупона,, ТочностьКупонаВВалютеНоминала);
			
		ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И Не ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВалютаКупона) Тогда
			
			СтрокаСтоимостейЦБ.Купон  = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления, , СтрокаСтоимостейЦБ.ВалютаКупона);
			
		КонецЕсли; 
				
		// Если цена не определена
		
		Если СтрокаСтоимостейЦБ.Стоимость = 0 Тогда
			
			ОшибкаРасчета = Ложь;
			
			ЭтоИностранныеОблигации = (ИностранныеОблигации.Найти(СтрокаСтоимостейЦБ.УчетныйАктивЦБРФ) <> Неопределено);
			
			// Иностранные облигации с заемщиком из России
			
			Если ЭтоИностранныеОблигации И ЗначениеЗаполнено(СтрокаСтоимостейЦБ.РоссийскийЗаемщик) И РазрешеноИспользованиеРасчетнойЦеныДляИностранныхОблигаций Тогда
		
				#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков
				
				// Для облигаций, номинированных в иностранной валюте, и в отношении которых известен конечный заемщик, при этом «страной риска» заемщика является Россия,
				// стоимость ценной бумаги определяется путем дисконтирования стоимости будущих потоков, скорректированных на кредитный спред.
				// При этом, денежные потоки конвертируются в рубли по форвардному валютному курсу, где:
				//  Gru	- годовая ставка рублевой КБД;
				//  Gfx	– годовая ставка валютной КБД; 
				
				ЦенаЗаполнена = ЗаполнитьДисконтированнойПоЗначениямКБДСтоимостьюПоФорвардномуВалютномуКурсу(СтрокаСтоимостейЦБ, ДатаПереоценки, ПараметрыОценки, 3, 2, ПараметрыДенежногоПотока, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, ОшибкаРасчета, РасшифровкаРасчета);
					
				Если ОшибкаРасчета Тогда	
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
					Продолжить;
				ИначеЕсли ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
					Продолжить;
				КонецЕсли;
				
				#КонецОбласти
				
			КонецЕсли;
			
			// Если еще не оценили, попробуем по последней цене
			
			Если СтрокаСтоимостейЦБ.Стоимость = 0 Тогда
				
				#Область Заполнение_по_последней_оценочной_стоимости

				Если ПоследняяОценочнаяСтоимость = Неопределено Тогда
					ПоследняяОценочнаяСтоимость = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_ПоследняяОценочнаяСтоимость").Выгрузить();
				    ПоследняяОценочнаяСтоимость.Индексы.Добавить("ЦеннаяБумага");
				КонецЕсли;
				
				ПоследняяОценочнаяСтоимостьБумаги = ПоследняяОценочнаяСтоимость.Найти(СтрокаСтоимостейЦБ.ЦеннаяБумага, "ЦеннаяБумага");
				
				Если ПоследняяОценочнаяСтоимостьБумаги <> Неопределено Тогда
					ЗаполнитьЗначенияСвойств(СтрокаСтоимостейЦБ, ПоследняяОценочнаяСтоимостьБумаги);
				КонецЕсли;

				Если РасшифровкаРасчета <> Неопределено Тогда
					
					#Область Расшифровка_расчета
					
					ПараметрыРасчетаЦен = ?(ПоследняяОценочнаяСтоимостьБумаги = Неопределено,
						Новый Структура("Описание", "Нет сведений о последней оценочной стоимости"),
						РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(ПоследняяОценочнаяСтоимостьБумаги));
					
					РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "Оценка по последней оценочной стоимости", ПараметрыРасчетаЦен);
					
					#КонецОбласти
					
				КонецЕсли;

				#КонецОбласти
				
			КонецЕсли;
			
			// Если еще не оценили, попробуем по партии
			
			Если СтрокаСтоимостейЦБ.Стоимость = 0
				И ПараметрыОценки.ПараметрыПолученияПартий <> Неопределено
				И Не (СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Паи И Не СтрокаСтоимостейЦБ.ДопущенКТоргам) // недопущенный к торгам пай оценивать по партиям не нужно
				И Не (ЭтоИностранныеОблигации И Не ПриОтсутствииЦеныОцениватьИностранныеОблигацииПоПоследнейЦенеИлиЦенеПриобретения)
			Тогда
				СтрокиДляДозаполненияИзПартий.Добавить(СтрокаСтоимостейЦБ);
			КонецЕсли;
			
		КонецЕсли;
		
		// Проверяем цены иностранных акций, паев, депозитарных расписок		
			
		Если АкцииПаиРаспискиНерезидентов.Найти(СтрокаСтоимостейЦБ.УчетныйАктивЦБРФ) <> Неопределено 			
			И (Не ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ДатаЦены) 
				Или СтрокаСтоимостейЦБ.ДатаЦены < ДатаПереоценки)
		Тогда
			МассивЦББезЦенДляУведомления.Добавить(СтрокаСтоимостейЦБ.ЦеннаяБумага);						
		КонецЕсли;

	КонецЦикла;
					
	// Формируем уведомления
	
	УведомитьОбОтсутствииЦены(МассивЦББезЦенДляУведомления, ПараметрыОценки, ДатаПереоценки);
	
	// Дозаполнение данными из партий
	
	Если СтрокиДляДозаполненияИзПартий.Количество() > 0 Тогда		
		ЗаполнитьЦенамиПокупкиПриОтсутствииУчетаНаПартиях(ДатаПереоценки, ТаблицаСтоимостейЦБ, СтрокиДляДозаполненияИзПартий, ПараметрыОценки, РасшифровкаРасчета);		
	КонецЕсли;	
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныРПИ2023(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, РасшифровкаРасчета = Неопределено) 
	
	#Область РПИ_с_20марта2023
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала
		|ПОМЕСТИТЬ _ТаблицаСпискаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Облигации.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _Облигации_ОВОЗРФ_ИДругиеИсключения
		|ИЗ
		|	_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ТаблицаСпискаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|ГДЕ
		|	Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Облигации.Ссылка
		|ИЗ
		|	_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|						&ПоследнийТорговыйДень,
		|						Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|							И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|							И ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация)) КАК РеквизитыЮридическихЛицСрезПоследних
		|				ПО Эмитенты.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|			ПО Облигации.Эмитент = Эмитенты.Ссылка
		|		ПО _ТаблицаСпискаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Облигации.Ссылка
		|ИЗ
		|	_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ТаблицаСпискаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|ГДЕ
		|	(Облигации.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств)
		|			ИЛИ Облигации.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихНерезидентов))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	_ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала
		|ПОМЕСТИТЬ _ТаблицаСпискаЦБОсновнойВыпуск
		|ИЗ
		|	_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Акции.ОсновнойВыпуск,
		|	_ТаблицаСпискаЦБ.Рынок,
		|	Акции.ОсновнойВыпуск.ВалютаНоминала
		|ИЗ
		|	_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО _ТаблицаСпискаЦБ.ЦеннаяБумага = Акции.Ссылка
		|ГДЕ
		|	Акции.ОсновнойВыпуск <> ЗНАЧЕНИЕ(Справочник.Акции.пустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ТаблицаСпискаЦБОсновнойВыпуск.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаСпискаЦБОсновнойВыпуск.Рынок КАК Рынок,
		|	ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследних.Номинал, 0) КАК Номинал,
		|	_ТаблицаСпискаЦБОсновнойВыпуск.ВалютаНоминала КАК ВалютаНоминала
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	_ТаблицаСпискаЦБОсновнойВыпуск КАК _ТаблицаСпискаЦБОсновнойВыпуск
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО _ТаблицаСпискаЦБОсновнойВыпуск.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Рынок,
		|	ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИностранныеБиржиСПриоритетом.ВалютаНоминала КАК ВалютаНоминала,
		|	ИностранныеБиржиСПриоритетом.Биржа КАК Биржа,
		|	ИностранныеБиржиСПриоритетом.Приоритет КАК Приоритет
		|ПОМЕСТИТЬ _ИностранныеБиржиСПриоритетом
		|ИЗ
		|	&ИностранныеБиржиСПриоритетом КАК ИностранныеБиржиСПриоритетом
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Биржи.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _ИностранныеБиржиПеречень
		|ИЗ
		|	Справочник.Биржи КАК Биржи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЮрФизЛицо В
		|					(ВЫБРАТЬ
		|						Биржи.ЮрФизЛицо КАК ЮрФизЛицо
		|					ИЗ
		|						Справочник.Биржи КАК Биржи)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО Биржи.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации <> &Россия
		|	И Биржи.Ссылка <> &Блумберг
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.Номинал КАК Номинал,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа КАК Биржа,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.LEGALCLOSEPRICE КАК LEGALCLOSEPRICE,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.LEGALCLOSEPRICE_DATE КАК LEGALCLOSEPRICE_DATE,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.VOLUME КАК VOLUME,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.VOLUME_DATE КАК VOLUME_DATE,
		|	ЕСТЬNULL(_ИностранныеБиржиСПриоритетом.Приоритет, 0) КАК Приоритет,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта КАК Валюта
		|ПОМЕСТИТЬ _КромеОВОЗРФ_СИтогамиТоргов
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ИностранныеБиржиСПриоритетом КАК _ИностранныеБиржиСПриоритетом
		|		ПО _ТаблицаЦБ.ВалютаНоминала = _ИностранныеБиржиСПриоритетом.ВалютаНоминала
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|						(ВЫБРАТЬ
		|							_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|						ИЗ
		|							_ТаблицаЦБ КАК _ТаблицаЦБ)
		|					И Биржа В
		|						(ВЫБРАТЬ
		|							_ИностранныеБиржиПеречень.Ссылка КАК Ссылка
		|						ИЗ
		|							_ИностранныеБиржиПеречень КАК _ИностранныеБиржиПеречень)) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
		|		ПО _ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага
		|			И (КотировкиТорговыхПлощадокСводныеСрезПоследних.LEGALCLOSEPRICE > 0)
		|			И (КотировкиТорговыхПлощадокСводныеСрезПоследних.VOLUME > 0)
		|			И (КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа = _ИностранныеБиржиСПриоритетом.Биржа)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И ЮрФизЛицо В
		|						(ВЫБРАТЬ
		|							_ТаблицаЦБ.ЦеннаяБумага.Эмитент.ЮрФизЛицо
		|						ИЗ
		|							_ТаблицаЦБ КАК _ТаблицаЦБ)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО _ТаблицаЦБ.ЦеннаяБумага.Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	НЕ _ТаблицаЦБ.ЦеннаяБумага В
		|				(ВЫБРАТЬ
		|					_Облигации_ОВОЗРФ_ИДругиеИсключения.Ссылка КАК Ссылка
		|				ИЗ
		|					_Облигации_ОВОЗРФ_ИДругиеИсключения КАК _Облигации_ОВОЗРФ_ИДругиеИсключения)
		|	И РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации <> &Россия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КромеОВОЗРФ_СИтогамиТоргов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	МИНИМУМ(_КромеОВОЗРФ_СИтогамиТоргов.Приоритет) КАК Приоритет
		|ПОМЕСТИТЬ _КромеОВОЗРФ_БиржаСПриоритетом
		|ИЗ
		|	_КромеОВОЗРФ_СИтогамиТоргов КАК _КромеОВОЗРФ_СИтогамиТоргов
		|ГДЕ
		|	_КромеОВОЗРФ_СИтогамиТоргов.Приоритет <> 0
		|	И _КромеОВОЗРФ_СИтогамиТоргов.LEGALCLOSEPRICE_DATE = &ДатаПереоценки
		|
		|СГРУППИРОВАТЬ ПО
		|	_КромеОВОЗРФ_СИтогамиТоргов.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КромеОВОЗРФ_СИтогамиТоргов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	МАКСИМУМ(_КромеОВОЗРФ_СИтогамиТоргов.VOLUME) КАК VOLUME
		|ПОМЕСТИТЬ _КромеОВОЗРФ_БиржаБезПриоритета
		|ИЗ
		|	_КромеОВОЗРФ_СИтогамиТоргов КАК _КромеОВОЗРФ_СИтогамиТоргов
		|ГДЕ
		|	_КромеОВОЗРФ_СИтогамиТоргов.Приоритет = 0
		|	И _КромеОВОЗРФ_СИтогамиТоргов.LEGALCLOSEPRICE_DATE = &ДатаПереоценки
		|
		|СГРУППИРОВАТЬ ПО
		|	_КромеОВОЗРФ_СИтогамиТоргов.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КромеОВОЗРФ_СИтогамиТоргов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	МАКСИМУМ(_КромеОВОЗРФ_СИтогамиТоргов.LEGALCLOSEPRICE_DATE) КАК LEGALCLOSEPRICE_DATE
		|ПОМЕСТИТЬ _КромеОВОЗРФ_БиржаСПоследнейЦеной
		|ИЗ
		|	_КромеОВОЗРФ_СИтогамиТоргов КАК _КромеОВОЗРФ_СИтогамиТоргов
		|ГДЕ
		|	_КромеОВОЗРФ_СИтогамиТоргов.LEGALCLOSEPRICE_DATE > &ДатаПереоценки
		|
		|СГРУППИРОВАТЬ ПО
		|	_КромеОВОЗРФ_СИтогамиТоргов.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КромеОВОЗРФ_СИтогамиТоргов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_КромеОВОЗРФ_СИтогамиТоргов.LEGALCLOSEPRICE_DATE КАК LEGALCLOSEPRICE_DATE,
		|	МАКСИМУМ(_КромеОВОЗРФ_СИтогамиТоргов.VOLUME) КАК VOLUME
