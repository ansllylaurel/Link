		|		ПО ТаблицаЦБ.Рынок = Котировки_Bloomberg_BVAL.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = Котировки_Bloomberg_BVAL.ЦеннаяБумага
		|			И (Котировки_Bloomberg_BVAL.Период = &ПоследняяДатаТорговБлумберга)
		|			И (Котировки_Bloomberg_BVAL.Биржа = &Блумберг)
		|			И (Котировки_Bloomberg_BVAL.РежимТоргов = &Режим_BVAL)
		|			И (&ДоступныДанныеBloomberg)
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_СводныеКотировкиТорговыхПлощадок.ЦеннаяБумага КАК ЦеннаяБумага,
		|			_СводныеКотировкиТорговыхПлощадок.MARKETPRICE2_DATE КАК MARKETPRICE2_DATE,
		|			МАКСИМУМ(_СводныеКотировкиТорговыхПлощадок.MARKETPRICE2) КАК MARKETPRICE2
		|		ИЗ
		|			_СводныеКотировкиТорговыхПлощадок КАК _СводныеКотировкиТорговыхПлощадок
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|					_СводныеКотировкиТорговыхПлощадок.ЦеннаяБумага КАК ЦеннаяБумага,
		|					МАКСИМУМ(_СводныеКотировкиТорговыхПлощадок.MARKETPRICE2_DATE) КАК MARKETPRICE2_DATE
		|				ИЗ
