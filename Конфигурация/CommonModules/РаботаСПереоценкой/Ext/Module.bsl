		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦБУровень1 КАК _ЦБУровень1
		|		ПО (_ЦБУровень1.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦБУровень2 КАК _ЦБУровень2
		|		ПО (_ЦБУровень2.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						_ТаблицаЦБ.ЦеннаяБумага
		|					ИЗ
		|						_ТаблицаЦБ
		|					ГДЕ
		|						_ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))) КАК РасчетныеЦеныПаев
		|		ПО (РасчетныеЦеныПаев.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (РасчетныеЦеныПаев.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, МЕСЯЦ, -6))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФ
		|		ПО (Паи.ПаевойИнвестиционныйФонд = РеквизитыПИФ.ПаевойИнвестиционныйФонд)
		|ГДЕ
		|	_ЦБУровень1.ЦеннаяБумага ЕСТЬ NULL
		|	И _ЦБУровень2.ЦеннаяБумага ЕСТЬ NULL
		|	И НЕ &ТолькоНаблюдаемыеЦены
		|	И НЕ _ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦБУровень1.Рынок КАК Рынок,
		|	_ЦБУровень1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ЦБУровень1.ВалютаНоминала КАК ВалютаНоминала,
		|	_ЦБУровень1.УровеньОценки КАК УровеньОценки,
		|	_ЦБУровень1.ВидЦены КАК ВидЦены,
		|	_ЦБУровень1.СправедливаяЦена КАК СправедливаяЦена,
		|	_ЦБУровень1.ВалютаЦены КАК ВалютаКотировки,
		|	_ЦБУровень1.ВалютаЦены КАК Валюта,
		|	_ЦБУровень1.ДатаЦены КАК ДатаЦены,
		|	_ЦБУровень1.Источник КАК Источник
		|ПОМЕСТИТЬ _ОцененныеБумаги
		|ИЗ
		|	_ЦБУровень1 КАК _ЦБУровень1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦБУровень2.Рынок,
		|	_ЦБУровень2.ЦеннаяБумага,
		|	_ЦБУровень2.ВалютаНоминала,
		|	_ЦБУровень2.УровеньОценки,
		|	_ЦБУровень2.ВидЦены,
		|	_ЦБУровень2.СправедливаяЦена,
		|	_ЦБУровень2.ВалютаЦены,
		|	_ЦБУровень2.ВалютаЦены,
		|	_ЦБУровень2.ДатаЦены,
		|	_ЦБУровень2.Источник
		|ИЗ
		|	_ЦБУровень2 КАК _ЦБУровень2
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦБУровень3.Рынок,
		|	_ЦБУровень3.ЦеннаяБумага,
		|	_ЦБУровень3.ВалютаНоминала,
		|	_ЦБУровень3.УровеньОценки,
		|	_ЦБУровень3.ВидЦены,
		|	_ЦБУровень3.СправедливаяЦена,
		|	_ЦБУровень3.ВалютаЦены,
		|	_ЦБУровень3.ВалютаЦены,
		|	_ЦБУровень3.ДатаЦены,
		|	_ЦБУровень3.Источник
		|ИЗ
		|	_ЦБУровень3 КАК _ЦБУровень3
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ТаблицаЦБ.Номинал КАК Номинал,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(_ОцененныеБумаги.СправедливаяЦена * _ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|			ИНАЧЕ _ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(_ОцененныеБумаги.Валюта, 0) КАК Валюта,
		|	ЕСТЬNULL(_ОцененныеБумаги.ВалютаКотировки, 0) КАК ВалютаКотировки,
		|	ЕСТЬNULL(_ОцененныеБумаги.ВидЦены, 0) КАК ВидЦены,
		|	ЕСТЬNULL(_ОцененныеБумаги.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(_ОцененныеБумаги.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, ЕСТЬNULL(_ОцененныеБумаги.Источник, 0)) КАК Источник,
		|	0 КАК Купон,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаКупона,
		|	_ТаблицаЦБ.СчитаемЧтоДефолт КАК СчитаемЧтоДефолт,
		|	_ОсновныеПлощадкиЦБ.ОсновнойРынок КАК ОсновнойРынок,
		|	_ОсновныеПлощадкиЦБ.ОсновнаяПлощадка КАК ОсновнаяПлощадка,
		|	_ОсновныеПлощадкиЦБ.ПоследняяДатаТоргов КАК ПоследняяДатаТоргов,
		|	ЕСТЬNULL(_КотировкиОсновнойПлощадки.BID, 0) КАК BID,
		|	ЕСТЬNULL(_КотировкиОсновнойПлощадки.OFFER, 0) КАК OFFER,
		|	_ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости КАК ОценкаПоАмортизированнойСтоимости
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОцененныеБумаги КАК _ОцененныеБумаги
		|		ПО (_ОцененныеБумаги.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (Биржи.Ссылка = _ОцененныеБумаги.Источник)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОсновныеПлощадкиЦБ КАК _ОсновныеПлощадкиЦБ
		|		ПО (_ОсновныеПлощадкиЦБ.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КотировкиОсновнойПлощадки КАК _КотировкиОсновнойПлощадки
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КотировкиОсновнойПлощадкиПриоритетРежимаТорговПоОбъему КАК _ПриоритетРежимаТорговПоОбъему
		|			ПО (_ПриоритетРежимаТорговПоОбъему.ЦеннаяБумага = _КотировкиОсновнойПлощадки.ЦеннаяБумага)
		|				И (_ПриоритетРежимаТорговПоОбъему.РежимТоргов = _КотировкиОсновнойПлощадки.РежимТоргов)
		|				И (_ПриоритетРежимаТорговПоОбъему.Приоритет = 1)
		|		ПО (_КотировкиОсновнойПлощадки.ЦеннаяБумага = _ОсновныеПлощадкиЦБ.ЦеннаяБумага)";
	
	#КонецОбласти
	
	ТолькоНаблюдаемыеЦены = ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены;
	
	ДоступныеБиржи = Новый Массив;
	ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_SPBEX"));
	ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_СПВБ"));
	
	Если ДатаПереоценки < '20230401' Тогда	
	
		ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_LSE"));
		ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_NYSE"));
		ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Amsterdam"));
		ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Brussels"));
		ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Lisbon"));
		ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Paris"));
		ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_AMEX"));
		ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_FWB"));
		ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Насдак"));
		ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_HKEX"));
		
	КонецЕсли;
		
	ММВБ		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	Блумберг	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
	НРД			= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");	
	
	КалендарьКотировок			= Константы.ОсновнойКалендарьКотировок.Получить();	
	ПоследняяДатаТоргов			= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьКотировок, НачалоДня(ДатаПереоценки));	
	ПоследняяДатаТорговБлумберг	= РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки, Блумберг);	
	
	ДоступныДанныеБлумберг									  = ПроверитьДоступностьДанныхBloomberg(ДатаПереоценки);
	ОцениватьАкцииИОблигацииКромеОВОЗРФТолькоПоЦенеНРД		  = Ложь;
	ОцениватьБумагиМеждународногоВнебиржевогоРынкаПоБлумбергу = ДоступныДанныеБлумберг И ДатаПереоценки < '20230401';	
	ОцениватьБумагиМеждународногоВнебиржевогоРынкаПоЦенамНРД  = ДатаПереоценки >= '20230401';
	
	ВариантТестаЦеныНРД = "по HIGHBID и LOWOFFER при их наличии";
	Если ДатаПереоценки >= '20210126' Тогда
		ВариантТестаЦеныНРД = "по BID и OFFER при наличии их и спреда";
	КонецЕсли;
	
	// Цена на дату оценки (или на последний ближайший торговый день, если дата определения СЧА является не торговым днем
	// и цена для этого дня не рассчитывалась), рассчитанная НКО ЗАО НРД
	
	БратьЦеныНРДНаДатуТоргов = Истина;

	// Для государственных ценных бумаг, облигаций российских эмитентов, акций российских эмитентов, облигаций иностранных государств
	// и акций иностранных эмитентов, российских и иностранных депозитарных расписок на акции иностранных эмитентов
	
	Если НачалоДня(ДатаПереоценки) <> ПоследняяДатаТоргов И ПоследняяДатаТоргов <> '20220225' Тогда // убираем это ограничение с 25.02.2022 до возобновления торгов (#418072)
	
		// Если на всех доступных и наблюдаемых биржевых площадках был неторговый день на дату определения СЧА,
		// в случае изменения ключевой ставки расчет стоимости осуществляется на основе цены НРД,
		// а в случае ее отсутствия на дату оценки - на основе экспертного суждения Фонда
		
		ИзмениласьКлючеваяСтавка = РегистрыСведений.ПроцентныеПоказатели.ПоказательИзменилсяЗаПериод(Перечисления.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ, ПоследняяДатаТоргов, ДатаПереоценки);

		Если ИзмениласьКлючеваяСтавка = Истина Тогда
			ОцениватьАкцииИОблигацииКромеОВОЗРФТолькоПоЦенеНРД	= Истина;
			БратьЦеныНРДНаДатуТоргов							= Ложь;
		КонецЕсли;
	
	КонецЕсли;

	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберг",	ПоследняяДатаТорговБлумберг);
	Запрос.УстановитьПараметр("КалендарныхДнейНазад35",			НачалоДня(ДатаПереоценки) - 35 * 86400);
	
	Запрос.УстановитьПараметр("ММВБ",							ММВБ);
	Запрос.УстановитьПараметр("НРД",							НРД);
	Запрос.УстановитьПараметр("Блумберг",						Блумберг);
	Запрос.УстановитьПараметр("ДоступныеБиржи",					ДоступныеБиржи);
	Запрос.УстановитьПараметр("ДоступныДанныеBloomberg",		ДоступныДанныеБлумберг);
	
	Запрос.УстановитьПараметр("Режим_BGN",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	Запрос.УстановитьПараметр("ВалютаРубли",					ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	Запрос.УстановитьПараметр("ВариантТестаЦеныНРД",										ВариантТестаЦеныНРД);
	Запрос.УстановитьПараметр("БратьЦеныНРДНаДатуТоргов",									БратьЦеныНРДНаДатуТоргов);
	Запрос.УстановитьПараметр("ОцениватьАкцииИОблигацииКромеОВОЗРФТолькоПоЦенеНРД",			ОцениватьАкцииИОблигацииКромеОВОЗРФТолькоПоЦенеНРД);
	Запрос.УстановитьПараметр("ОцениватьБумагиМеждународногоВнебиржевогоРынкаПоБлумбергу",	ОцениватьБумагиМеждународногоВнебиржевогоРынкаПоБлумбергу);
	Запрос.УстановитьПараметр("ОцениватьБумагиМеждународногоВнебиржевогоРынкаПоЦенамНРД",	ОцениватьБумагиМеждународногоВнебиржевогоРынкаПоЦенамНРД);
	
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены", ТолькоНаблюдаемыеЦены);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Аквилона 2021", "Таблица стоимостей ЦБ", , , "_ИсходнаяТаблицаЦБ, _БумагиОцениваемыеПоАмортизированнойСтоимости, _СтатусыЦенныхБумаг, _ЭмитентыЦенныхБумаг");		
	КонецЕсли;
	
	Если ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;
	
	// Расчетные цены 	
	
	ВыполненРасчетЦены = Ложь;	
	
	ПараметрыДенежногоПотока = ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	
	ПараметрыРасчетаСтоимостиПоАналогам = Новый Структура;
	ПараметрыРасчетаСтоимостиПоАналогам.Вставить("ВариантРасчета",	 Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020);
	ПараметрыРасчетаСтоимостиПоАналогам.Вставить("ПараметрыЗапроса", Запрос.Параметры);
	
	ПараметрыОценки.Вставить("ПараметрыРасчетаСтоимостиПоАналогам", ПараметрыРасчетаСтоимостиПоАналогам);
	ПараметрыОценки.Вставить("ТочностьДисконтированногоПотока",		6);
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены)
			ИЛИ СтрокаСтоимостейЦБ.ОсновнойРынок = "НРД" И ОцениватьАкцииИОблигацииКромеОВОЗРФТолькоПоЦенеНРД
			ИЛИ СтрокаСтоимостейЦБ.ОценкаПоАмортизированнойСтоимости
		Тогда
			Продолжить;
		КонецЕсли;
		
		// Требуется расчет цены
		
		ОшибкаРасчета = Ложь;
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			Если СтрокаСтоимостейЦБ.СчитаемЧтоДефолт Тогда
				Если РасшифровкаРасчета <> Неопределено Тогда	
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Оценка дефолтных долговых ценных бумаг", Новый Структура("Описание", "Оценка дефолтных долговых ценных бумаг не реализована"));
				КонецЕсли;		
				Продолжить;	
			ИначеЕсли СтрокаСтоимостейЦБ.ОсновнойРынок = "Международный внебиржевой рынок" И Не ОцениватьБумагиМеждународногоВнебиржевогоРынкаПоБлумбергу Тогда
				Продолжить;	
			КонецЕсли;
			
			// Расчет PV по ставке, рассчитанной по аналогам
			
			ЦенаЗаполнена = ЗаполнитьДисконтированнойПоСтавкеРассчитаннойПоАналогамСтоимостью(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 3, ПараметрыДенежногоПотока, , ОшибкаРасчета, РасшифровкаРасчета);
			
			Если ОшибкаРасчета Тогда
				ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
				Продолжить;
			ИначеЕсли ЦенаЗаполнена Тогда
				ВыполненРасчетЦены = Истина;
				Продолжить;
			КонецЕсли;			

		ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда	
			
			Если СтрокаСтоимостейЦБ.ОсновнойРынок = "Российская торговая площадка"
				ИЛИ СтрокаСтоимостейЦБ.ОсновнойРынок = "Иностранная торговая площадка"
			Тогда
			
				#Область Расчет_на_основе_корректировки_исторической_цены
				
				// Справедливая стоимость акций, обращающихся на российских и иностранных фондовых биржах,
				// определяется в соответствии с моделью оценки, основанной на корректировке исторической цены (CAPM).
				// Применяем при отсутствии цены не более 10 рабочих дней
				
				ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, Справочники.Календари.Общероссийский, 3, , ОшибкаРасчета, РасшифровкаРасчета);  
				
				Если ОшибкаРасчета Тогда
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
					Продолжить;
				ИначеЕсли ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
					Продолжить;
				КонецЕсли;			

				#КонецОбласти
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "После расчета цен", ТаблицаСтоимостейЦБ.Скопировать());	
	КонецЕсли;
		
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныБольшого(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ИсходнаяТаблицаЦБ");
	ПоместитьБумагиОцениваемыеПоАмортизированнойСтоимостиВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки, ДатаПереоценки, "_ИсходнаяТаблицаЦБ");
	ПоместитьСтатусыЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "_ИсходнаяТаблицаЦБ"); 
	ПоместитьЭмитентовЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "_ИсходнаяТаблицаЦБ");
	ПоместитьСведенияОТоргахЦеннымиБумагамиВМенеджерВременныхТаблиц(Запрос, "_ИсходнаяТаблицаЦБ", ДатаПереоценки, 10, "_СведенияОТоргахЦеннымиБумагами");

	#Область Основной_запрос	
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	_ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, НЕОПРЕДЕЛЕНО) КАК ДатаПогашения,
		|	_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента КАК Эмитент,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЭмитентРоссийский,
		|	_ЭмитентыЦенныхБумаг.ДатаБанкротства КАК ДатаБанкротстваЭмитента,
		|	ЕСТЬNULL(_ЭмитентыЦенныхБумаг.Банкрот, ЛОЖЬ) КАК ЭмитентБанкрот,
		|	ЕСТЬNULL(Облигации.ДатаПогашения < &РабочихДнейНазад7
		|				И Облигации.ДатаПогашения <> ДАТАВРЕМЯ(1, 1, 1), ЛОЖЬ)
		|		ИЛИ ЕСТЬNULL(_ЭмитентыЦенныхБумаг.Банкрот, ЛОЖЬ) КАК СчитаемЧтоДефолт,
		|	_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК ОценкаПоАмортизированнойСтоимости,
		|	_СведенияОТоргахЦеннымиБумагами.Дата КАК ПоследняяДатаТоргов
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						_ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ИСТИНА
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|					ГДЕ
		|						_ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЭмитентыЦенныхБумаг КАК _ЭмитентыЦенныхБумаг
		|		ПО (_ЭмитентыЦенныхБумаг.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента
		|					ИЗ
		|						_ЭмитентыЦенныхБумаг)) КАК РеквизитыЮрЛицаЭмитента
		|		ПО (РеквизитыЮрЛицаЭмитента.ЮрФизЛицо = _ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _БумагиОцениваемыеПоАмортизированнойСтоимости КАК _БумагиОцениваемыеПоАмортизированнойСтоимости
		|		ПО (_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СведенияОТоргахЦеннымиБумагами КАК _СведенияОТоргахЦеннымиБумагами
		|		ПО (_СведенияОТоргахЦеннымиБумагами.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|			И (_СведенияОТоргахЦеннымиБумагами.ТорговыхДнейНазад = 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СтатусыЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫРАЗИТЬ(_СтатусыЦенныхБумаг.Биржа КАК Справочник.Биржи) КАК Биржа,
		|	ЕСТЬNULL(СУММА(КотировкиТорговыхПлощадок.NUMTRADES), 0) КАК КоличествоСделок,
		|	ЕСТЬNULL(СУММА(КотировкиТорговыхПлощадок.VALUE), 0) КАК ОбъемСделок,
		|	ЕСТЬNULL(СУММА(КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность), 0) КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ _ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СтатусыЦенныхБумаг КАК _СтатусыЦенныхБумаг
		|		ПО (_СтатусыЦенныхБумаг.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.ЦеннаяБумага = _СтатусыЦенныхБумаг.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Рынок = _СтатусыЦенныхБумаг.Рынок)
		|			И (КотировкиТорговыхПлощадок.Биржа = _СтатусыЦенныхБумаг.Биржа)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадок.Период МЕЖДУ &КалендарныхДнейНазад35 И &ДатаПереоценки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КурсыВалют.Валюта = КотировкиТорговыхПлощадок.Валюта)
		|			И (КурсыВалют.Период = КотировкиТорговыхПлощадок.Период)
		|ГДЕ
		|	_ТаблицаЦБ.СчитаемЧтоДефолт = ЛОЖЬ
		|	И _ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости = ЛОЖЬ
		|	И _СтатусыЦенныхБумаг.Статус = ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже)
		|	И _СтатусыЦенныхБумаг.Биржа В(&ДоступныеБиржи)
		|	И НЕ &ОцениватьТолькоПоЦенеНРД
		|
		|СГРУППИРОВАТЬ ПО
		|	_СтатусыЦенныхБумаг.ЦеннаяБумага,
		|	_СтатусыЦенныхБумаг.Биржа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней.Биржа КАК Биржа,
		|	ЕСТЬNULL(РеквизитыЮрЛицаБиржи.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК РоссийскаяБиржа,
		|	_ТаблицаЦБ.ПоследняяДатаТоргов КАК ПоследняяДатаТоргов
		|ПОМЕСТИТЬ _ОсновныеРынки
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней КАК _ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней.ЦеннаяБумага КАК ЦеннаяБумага,
		|				ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней.ОбъемСделокВВалютеУчета КАК ОбъемСделокВВалютеУчета,
		|				МАКСИМУМ(ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней.КоличествоСделок) КАК КоличествоСделок
		|			ИЗ
		|				_ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней КАК ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|						ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней.ЦеннаяБумага КАК ЦеннаяБумага,
		|						МАКСИМУМ(ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней.ОбъемСделокВВалютеУчета) КАК ОбъемСделокВВалютеУчета
		|					ИЗ
		|						_ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней КАК ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней
		|					
		|					СГРУППИРОВАТЬ ПО
		|						ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней.ЦеннаяБумага) КАК Приоритет1
		|					ПО (Приоритет1.ЦеннаяБумага = ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней.ЦеннаяБумага)
		|						И (Приоритет1.ОбъемСделокВВалютеУчета = ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней.ОбъемСделокВВалютеУчета)
		|			
		|			СГРУППИРОВАТЬ ПО
		|				ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней.ЦеннаяБумага,
		|				ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней.ОбъемСделокВВалютеУчета) КАК Приоритет2
		|			ПО (Приоритет2.ЦеннаяБумага = _ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней.ЦеннаяБумага)
		|				И (Приоритет2.ОбъемСделокВВалютеУчета = _ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней.ОбъемСделокВВалютеУчета)
		|				И (Приоритет2.КоличествоСделок = _ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней.КоличествоСделок)
		|		ПО (_ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						Биржи.ЮрФизЛицо
		|					ИЗ
		|						Справочник.Биржи КАК Биржи
		|					ГДЕ
		|						Биржи.Ссылка В (&ДоступныеБиржи))) КАК РеквизитыЮрЛицаБиржи
		|		ПО (РеквизитыЮрЛицаБиржи.ЮрФизЛицо = _ОбъемСделокНаДоступныхПлощадкахЗа35КалендарныхДней.Биржа.ЮрФизЛицо)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиТорговыхПлощадок.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.Период КАК Период,
		|	КотировкиТорговыхПлощадок.Валюта КАК Валюта,
		|	КотировкиТорговыхПлощадок.РежимТоргов КАК РежимТоргов,
		|	КотировкиТорговыхПлощадок.NUMTRADES КАК КоличествоСделок,
		|	КотировкиТорговыхПлощадок.VALUE КАК ОбъемСделок,
		|	КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ _КотировкиЗаПоследние10ТорговыхДней
		|ИЗ
		|	_ОсновныеРынки КАК _ОсновныеРынки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СведенияОТоргахЦеннымиБумагами КАК _СведенияОТоргахЦеннымиБумагами
		|		ПО (_СведенияОТоргахЦеннымиБумагами.ЦеннаяБумага = _ОсновныеРынки.ЦеннаяБумага)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
