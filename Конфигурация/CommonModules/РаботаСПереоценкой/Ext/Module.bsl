		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА ВЫБОР
		|						КОГДА &ОкруглятьЦеныНРДДо4Знаков
		|							ТОГДА ВЫРАЗИТЬ((ВЫРАЗИТЬ(ОцененныеБумаги.СправедливаяЦена * ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100 КАК ЧИСЛО(27, 4))
		|						ИНАЧЕ (ВЫРАЗИТЬ(ОцененныеБумаги.СправедливаяЦена * ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|					КОНЕЦ
		|			ИНАЧЕ ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(ОцененныеБумаги.Валюта, 0) КАК Валюта,
		|	ЕСТЬNULL(ОцененныеБумаги.ВалютаКотировки, 0) КАК ВалютаКотировки,
		|	ЕСТЬNULL(ОцененныеБумаги.ВидЦены, 0) КАК ВидЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(ОцененныеБумаги.Биржа, 0) КАК Биржа,
		|	ЕСТЬNULL(ОцененныеБумаги.Источник, ЕСТЬNULL(Биржи.ЮрФизЛицо, 0)) КАК Источник,
