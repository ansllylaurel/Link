		|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
		|	И СтоимостьПереоценки.УровеньОценки = 1
		|	И СтоимостьПереоценки.ВидЦены <> ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ЦенаПриобретения)
		|
		|СГРУППИРОВАТЬ ПО
		|	СтоимостьПереоценки.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦенныеБумагиНаРазмещении.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ДатыЦенАктивногоРынкаПриПервичномРазмещении.ДатаАктивногоРынка КАК ДатаАктивногоРынкаПриПервичномРазмещении,
		|	КлючевыеСтавкиЦБРФ.ДатаЗначения КАК ДатаИзменияКлючевойСтавкиЦБРФ
		|ПОМЕСТИТЬ _ДатыПримененияОбщихУсловийДляПервичногоРазмещения
		|ИЗ
		|	_ЦенныеБумагиНаРазмещении КАК _ЦенныеБумагиНаРазмещении
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыЦенАктивногоРынкаПриПервичномРазмещении КАК _ДатыЦенАктивногоРынкаПриПервичномРазмещении
		|		ПО _ЦенныеБумагиНаРазмещении.ЦеннаяБумага = _ДатыЦенАктивногоРынкаПриПервичномРазмещении.ЦеннаяБумага,
		|	(ВЫБРАТЬ ПЕРВЫЕ 1
		|		ПроцентныеПоказатели.ДатаЗначения КАК ДатаЗначения
		|	ИЗ
		|		РегистрСведений.ПроцентныеПоказатели КАК ПроцентныеПоказатели
		|	ГДЕ
		|		ПроцентныеПоказатели.Показатель = ЗНАЧЕНИЕ(Перечисление.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ)
		|		И ПроцентныеПоказатели.Прогноз = ЛОЖЬ
		|		И ПроцентныеПоказатели.Период <= &ДатаПереоценки
		|		И ПроцентныеПоказатели.ДатаЗначения <= &ДатаПереоценки
		|	
		|	УПОРЯДОЧИТЬ ПО
		|		ПроцентныеПоказатели.ДатаЗначения УБЫВ,
		|		ПроцентныеПоказатели.Период УБЫВ) КАК КлючевыеСтавкиЦБРФ
		|ГДЕ
		|	&ДатаПереоценки >= ДАТАВРЕМЯ(2020, 8, 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ТаблицаЦБ.Номинал КАК Номинал,
		|	ЕСТЬNULL(_ТаблицаЦБ.Стоимость, 0) КАК СтоимостьДоОкругления,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА _ТаблицаЦБ.УровеньОценки >= 2
		|				ТОГДА ВЫРАЗИТЬ(_ТаблицаЦБ.Стоимость КАК ЧИСЛО(1, 0))
		|			ИНАЧЕ _ТаблицаЦБ.Стоимость
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(_ТаблицаЦБ.Валюта, 0) КАК Валюта,
		|	ЕСТЬNULL(_ТаблицаЦБ.ВалютаКотировки, 0) КАК ВалютаКотировки,
		|	ЕСТЬNULL(_ТаблицаЦБ.ВидЦены, 0) КАК ВидЦены,
		|	ЕСТЬNULL(_ТаблицаЦБ.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(_ТаблицаЦБ.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, ЕСТЬNULL(_ТаблицаЦБ.Источник, 0)) КАК Источник,
		|	0 КАК Купон,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаКупона,
		|	_ТаблицаЦБ.ОсновнаяПлощадка КАК ОсновнаяПлощадка,
		|	_ТаблицаЦБ.ЭмитентРоссийский КАК ЭмитентРоссийский,
		|	_ТаблицаЦБ.НачалоЭтапаРазмещения КАК НачалоЭтапаРазмещения,
		|	ЕСТЬNULL(_ДатыПримененияОбщихУсловийДляПервичногоРазмещения.ДатаАктивногоРынкаПриПервичномРазмещении, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаАктивногоРынкаПриПервичномРазмещении,
		|	ЕСТЬNULL(_ДатыПримененияОбщихУсловийДляПервичногоРазмещения.ДатаИзменияКлючевойСтавкиЦБРФ, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаИзменияКлючевойСтавкиЦБРФ,
		|	ЕСТЬNULL(_ДатыПримененияОбщихУсловийДляПервичногоРазмещения.ДатаАктивногоРынкаПриПервичномРазмещении, ДАТАВРЕМЯ(1, 1, 1)) МЕЖДУ _ТаблицаЦБ.НачалоЭтапаРазмещения И &ДатаПереоценки
		|		ИЛИ ЕСТЬNULL(_ДатыПримененияОбщихУсловийДляПервичногоРазмещения.ДатаИзменияКлючевойСтавкиЦБРФ, ДАТАВРЕМЯ(1, 1, 1)) МЕЖДУ _ТаблицаЦБ.НачалоЭтапаРазмещения И &ДатаПереоценки КАК ПрименяютсяОбщиеУсловияДляПервичногоРазмещения,
		|	_ТаблицаЦБ.ТорговыхДнейНазад10 КАК ТорговыхДнейНазад10
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|		_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|		_ТаблицаЦБ.Рынок КАК Рынок,
		|		_ТаблицаЦБ.Номинал КАК Номинал,
		|		_ТаблицаЦБ.ЭмитентРоссийский КАК ЭмитентРоссийский,
		|		_ТаблицаЦБ.ОсновнаяПлощадка КАК ОсновнаяПлощадка,
		|		_ТаблицаЦБ.ПоследняяДатаТоргов КАК ПоследняяДатаТоргов,
		|		_ТаблицаЦБ.ТорговыхДнейНазад10 КАК ТорговыхДнейНазад10,
		|		_ТаблицаЦБ.НачалоЭтапаРазмещения КАК НачалоЭтапаРазмещения,
		|		_ОцененныеБумаги.УровеньОценки КАК УровеньОценки,
		|		_ОцененныеБумаги.ВидЦены КАК ВидЦены,
		|		_ОцененныеБумаги.ВалютаКотировки КАК ВалютаКотировки,
		|		_ОцененныеБумаги.Валюта КАК Валюта,
		|		_ОцененныеБумаги.ДатаЦены КАК ДатаЦены,
		|		_ОцененныеБумаги.Источник КАК Источник,
		|		ВЫБОР
		|			КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(_ОцененныеБумаги.СправедливаяЦена * _ТаблицаЦБ.Номинал КАК ЧИСЛО(2, 0))) / 100
		|			ИНАЧЕ _ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ КАК Стоимость
		|	ИЗ
		|		_ТаблицаЦБ КАК _ТаблицаЦБ
		|			ЛЕВОЕ СОЕДИНЕНИЕ _ОцененныеБумаги КАК _ОцененныеБумаги
		|			ПО (_ОцененныеБумаги.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)) КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (Биржи.Ссылка = _ТаблицаЦБ.Источник)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыПримененияОбщихУсловийДляПервичногоРазмещения КАК _ДатыПримененияОбщихУсловийДляПервичногоРазмещения
		|		ПО _ТаблицаЦБ.ЦеннаяБумага = _ДатыПримененияОбщихУсловийДляПервичногоРазмещения.ЦеннаяБумага";
	
	ТипЦены = Метаданные.РегистрыСведений.СтоимостьПереоценки.Ресурсы.Цена.Тип.КвалификаторыЧисла;

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЧИСЛО(1, 0)", СтрШаблон("ЧИСЛО(%1, %2)", ТипЦены.Разрядность, ТочностьЦенВторогоУровняИНиже));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЧИСЛО(2, 0)", СтрШаблон("ЧИСЛО(%1, %2)", ТипЦены.Разрядность, ТипЦены.РазрядностьДробнойЧасти - 2));

	#КонецОбласти
	
	ТолькоНаблюдаемыеЦены = ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены;
	
	ММВБ		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	НРД			= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");
	ВалютаРубли	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");	
	
	КалендарьКотировок	= Константы.ОсновнойКалендарьКотировок.Получить();
	ПоследняяДатаТоргов	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьКотировок, НачалоДня(ДатаПереоценки));
	ТорговыхДнейНазад10	= Справочники.Календари.ДобавитьКДатеРабочиеДни(КалендарьКотировок, НачалоДня(ДатаПереоценки), -10);
	
	Запрос.УстановитьПараметр("Организация", 					ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ПараметрыОценки.СчетДоверительногоУправления);
		
	Запрос.УстановитьПараметр("ММВБ",					ММВБ);
	Запрос.УстановитьПараметр("НРД",					НРД);
	
	Запрос.УстановитьПараметр("ДатаПереоценки",			ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",	ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10",	ТорговыхДнейНазад10);

	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", 		ТаблицаЦБ);
	
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены",	ТолькоНаблюдаемыеЦены);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены ПФР 2020", "Промежуточная таблица стоимостей ЦБ", , , "_ИсходнаяТаблицаЦБ, _ТаблицаДатРасчетныхЦенПаев, _ЭмитентыЦенныхБумаг, _ОцененныеБумаги");
	КонецЕсли;
	
	Если ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;	
	
	// Расчет цены и купона	
	
	ВыполненРасчетЦены = Ложь;	
	
	ПараметрыОценки.Вставить("ТочностьКБД", 2);
	
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
	Если Не ПараметрыОценки.Свойство("ВариантРасчетаОценочнойСтоимости") Тогда
		ПараметрыОценки.Вставить("ВариантРасчетаОценочнойСтоимости", ПараметрыОценки.ВариантРасчетаСправедливойСтоимости);
	КонецЕсли;
	
	Для Каждого СтрокаЦеннойБумаги Из ТаблицаСтоимостейЦБ Цикл
		
		ОшибкаРасчета = Ложь;
		
		Если СтрокаЦеннойБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
			
			Если СтрокаЦеннойБумаги.Стоимость = 0 И СтрокаЦеннойБумаги.ЭмитентРоссийский Тогда
			
				#Область Расчет_на_основе_корректировки_исторической_цены					
				
				// Справедливая стоимость акций определяется в соответствии с моделью оценки,
				// основанной на корректировке исторической цены (CAPM).
				// Применяется при отсутствии цены не более 10 рабочих дней
				
				ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаЦеннойБумаги, ПараметрыОценки, ДатаПереоценки, 10, Справочники.Календари.Общероссийский, , ТочностьЦенВторогоУровняИНиже, ОшибкаРасчета, РасшифровкаРасчета);  
				
				Если ОшибкаРасчета Тогда
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаЦеннойБумаги);
					Продолжить;
				ИначеЕсли ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
					Продолжить;
				КонецЕсли;			
				
				#КонецОбласти
				
			КонецЕсли;

		ИначеЕсли СтрокаЦеннойБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			СтрокаЦеннойБумаги.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаЦеннойБумаги.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления, , СтрокаЦеннойБумаги.ВалютаКупона);
			
			#Область Оценка_по_цене_размещения
			
			ПрименяетсяЦенаРазмещения = Ложь;
			
			// Партионный учет у ПФР не ведется, поэтому проверить, что бумага куплена при первичном размещении, нельзя. 			
			Если ДатаПереоценки < '20200801' Тогда
				// До 01.08.2020 просто оценим по номиналу в первый день размещения.
				ПрименяетсяЦенаРазмещения = СтрокаЦеннойБумаги.УровеньОценки <> 1 И СтрокаЦеннойБумаги.НачалоЭтапаРазмещения = ДатаПереоценки;
			Иначе
				// С 01.08.2020 цена размещения действует 10 торговых дней, если за этот период не было цен активного рынка и не было изменения ключевой ставки ЦБ РФ	
				ПрименяетсяЦенаРазмещения = СтрокаЦеннойБумаги.УровеньОценки <> 1
											И ЗначениеЗаполнено(СтрокаЦеннойБумаги.НачалоЭтапаРазмещения) И СтрокаЦеннойБумаги.НачалоЭтапаРазмещения <= ДатаПереоценки 
											И ЗначениеЗаполнено(СтрокаЦеннойБумаги.ТорговыхДнейНазад10) И СтрокаЦеннойБумаги.НачалоЭтапаРазмещения >= СтрокаЦеннойБумаги.ТорговыхДнейНазад10
											И ДатаПереоценки <= Справочники.Календари.ДобавитьКДатеРабочиеДни(КалендарьКотировок, СтрокаЦеннойБумаги.НачалоЭтапаРазмещения, 10)
											И Не СтрокаЦеннойБумаги.ПрименяютсяОбщиеУсловияДляПервичногоРазмещения;
			КонецЕсли;
			
			Если ПрименяетсяЦенаРазмещения Тогда 				
				
				СтрокаЦеннойБумаги.Стоимость		= СтрокаЦеннойБумаги.Номинал;
				СтрокаЦеннойБумаги.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.ЦенаПриобретения; 
				СтрокаЦеннойБумаги.Источник			= Справочники.ЮрФизЛица.ПустаяСсылка();
				СтрокаЦеннойБумаги.УровеньОценки	= 1;
				СтрокаЦеннойБумаги.ДатаЦены			= СтрокаЦеннойБумаги.НачалоЭтапаРазмещения;
				СтрокаЦеннойБумаги.ВалютаКотировки	= СтрокаЦеннойБумаги.ВалютаНоминала;					
				
				ВыполненРасчетЦены = Истина;  			
					
			КонецЕсли;
			
			#КонецОбласти
			
			Если СтрокаЦеннойБумаги.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаЦеннойБумаги.ВидЦены) Тогда
				Продолжить;	
			КонецЕсли;	
			
			ПараметрыДенежногоПотока = ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, СтрокаЦеннойБумаги.ЦеннаяБумага, ОшибкаРасчета);
			
			Если ОшибкаРасчета Тогда
				ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаЦеннойБумаги);
				Продолжить;
			КонецЕсли;			
			
			Если СтрокаЦеннойБумаги.ЭмитентРоссийский И СтрокаЦеннойБумаги.ВалютаНоминала = ВалютаРубли И СтрокаЦеннойБумаги.ОсновнаяПлощадка = ММВБ Тогда
				
				#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков
				
				ЦенаЗаполнена = ЗаполнитьДисконтированнойПоЗначениямКБДСтоимостью(СтрокаЦеннойБумаги, ДатаПереоценки, ПараметрыОценки, ?(ДатаПереоценки >= '20200801', 3, 2), ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, , ТочностьЦенВторогоУровняИНиже, ПараметрыДенежногоПотока, ОшибкаРасчета, РасшифровкаРасчета);
				
				Если ОшибкаРасчета Тогда
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаЦеннойБумаги);
					Продолжить;
				ИначеЕсли ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
					Продолжить;
				КонецЕсли;			
				
				#КонецОбласти
				
			ИначеЕсли ДатаПереоценки >= '20230401' И СтрокаЦеннойБумаги.ВалютаНоминала <> ВалютаРубли Тогда

				#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков_по_форвардному_валютному_курсу
				
				ЦенаЗаполнена = ЗаполнитьДисконтированнойПоЗначениямКБДСтоимостьюПоФорвардномуВалютномуКурсу(СтрокаЦеннойБумаги, ДатаПереоценки, ПараметрыОценки, 3, 2, ПараметрыДенежногоПотока, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, ОшибкаРасчета, РасшифровкаРасчета);
					
				Если ОшибкаРасчета Тогда
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаЦеннойБумаги);
					Продолжить;
				ИначеЕсли ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
					Продолжить;
				КонецЕсли;			
					
				#КонецОбласти

			КонецЕсли;
			
		КонецЕсли;		
		
	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "Таблица стоимостей ЦБ", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныДоверия(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "ИсходнаяТаблицаЦБ");
	ПоместитьБумагиОцениваемыеПоАмортизированнойСтоимостиВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки, ДатаПереоценки, "ИсходнаяТаблицаЦБ");
	ПоместитьОценкиПоНоминалуДляПогашенныхЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления, ДатаПереоценки);
	
	#Область Основной_запрос	
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтатусыЦенныхБумагСрезПоследних.Рынок КАК Рынок,
		|	СтатусыЦенныхБумагСрезПоследних.Период КАК Период,
		|	СтатусыЦенныхБумагСрезПоследних.Статус КАК Статус,
		|	СтатусыЦенныхБумагСрезПоследних.Биржа КАК Биржа,
		|	ЕСТЬNULL(РеквизитыЮрЛицаБиржи.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК РоссийскаяБиржа
		|ПОМЕСТИТЬ СтатусыЦенныхБумаг
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага
		|					ИЗ
		|						ИсходнаяТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.Рынок = СтатусыЦенныхБумагСрезПоследних.Рынок
		|			И ИсходнаяТаблицаЦБ.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|			И (СтатусыЦенныхБумагСрезПоследних.Активен)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						Биржи.ЮрФизЛицо
		|					ИЗ
		|						Справочник.Биржи КАК Биржи)) КАК РеквизитыЮрЛицаБиржи
		|		ПО (РеквизитыЮрЛицаБиржи.ЮрФизЛицо = СтатусыЦенныхБумагСрезПоследних.Биржа.ЮрФизЛицо)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	Эмитенты.Ссылка КАК Эмитент,
		|	Эмитенты.ЮрФизЛицо КАК ЮрЛицоЭмитента,
		|	Эмитенты.ДатаБанкротства КАК ДатаБанкротства,
		|	Эмитенты.ДатаБанкротства <> ДАТАВРЕМЯ(1, 1, 1)
		|		И Эмитенты.ДатаБанкротства <= &ДатаПереоценки КАК Банкрот
		|ПОМЕСТИТЬ ЭмитентыЦенныхБумаг
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
