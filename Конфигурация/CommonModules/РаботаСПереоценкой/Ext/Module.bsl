		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиУровень1.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|				&ДатаПереоценки,
		|				Биржа = &ММВБ
		|					И РежимТоргов.ОсновнойРежим) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадокСводныеСрезПоследних.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВолатильностьАкции КАК ВолатильностьАкции
		|		ПО ТаблицаЦБ.Рынок = ВолатильностьАкции.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = ВолатильностьАкции.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ((ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации)) = Облигации.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
		|		ПО (КотировкиТорговыхПлощадокСводныеСрезПоследних.CLOSE_DATE = ЗначенияБиржевыхИндексов.Период)
		|			И (ВЫБОР
		|				КОГДА (Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.Категорииоблигаций.Государственная)
		|						ИЛИ Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.Категорииоблигаций.Субфедеральная))
		|						И ЗначенияБиржевыхИндексов.БиржевойИндекс.Код = ""RGBI""
		|					ТОГДА ИСТИНА
		|				КОГДА (Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.Категорииоблигаций.Корпоративная)
		|						ИЛИ Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.Категорииоблигаций.Еврооблигация)
		|						ИЛИ Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.Категорииоблигаций.Ипотечная))
		|						И ЗначенияБиржевыхИндексов.БиржевойИндекс.Код = ""RUCBICP""
		|					ТОГДА ИСТИНА
		|				КОГДА Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.Категорииоблигаций.Муниципальная)
		|						И ЗначенияБиржевыхИндексов.БиржевойИндекс.Код = ""RUMBICP""
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов.СрезПоследних(&ДатаПереоценки, ) КАК ЗначенияБиржевыхИндексовСрезПоследних
		|		ПО (ВЫБОР
		|				КОГДА (Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.Категорииоблигаций.Государственная)
		|						ИЛИ Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.Категорииоблигаций.Субфедеральная))
		|						И ЗначенияБиржевыхИндексовСрезПоследних.БиржевойИндекс.Код = ""RGBI""
		|					ТОГДА ИСТИНА
		|				КОГДА (Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.Категорииоблигаций.Корпоративная)
		|						ИЛИ Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.Категорииоблигаций.Еврооблигация)
		|						ИЛИ Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.Категорииоблигаций.Ипотечная))
		|						И ЗначенияБиржевыхИндексовСрезПоследних.БиржевойИндекс.Код = ""RUCBICP""
		|					ТОГДА ИСТИНА
		|				КОГДА Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.Категорииоблигаций.Муниципальная)
		|						И ЗначенияБиржевыхИндексовСрезПоследних.БиржевойИндекс.Код = ""RUMBICP""
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПаевыеИнвестиционныеФонды КАК ПаевыеИнвестиционныеФонды
		|			ПО Паи.ПаевойИнвестиционныйФонд = ПаевыеИнвестиционныеФонды.Ссылка
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(&ДатаПереоценки, ) КАК РасчетныеЦеныПаевСрезПоследних
		|			ПО Паи.Ссылка = РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФСрезПоследних
		|			ПО (Паи.ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|		ПО ((ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Паи)) = Паи.Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиУровень2.ЦеннаяБумага,
		|	КотировкиУровень2.Рынок,
		|	КотировкиУровень2.Номинал,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(КотировкиУровень2.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА КотировкиУровень2.СправедливаяЦена * КотировкиУровень2.Номинал / 100
		|		ИНАЧЕ КотировкиУровень2.СправедливаяЦена
		|	КОНЕЦ КАК Стоимость,
		|	КотировкиУровень2.СправедливаяЦена,
		|	КотировкиУровень2.УровеньОценки,
		|	КотировкиУровень2.ДатаЦены,
		|	КотировкиУровень2.ПолеКотировки КАК ВидЦены,
		|	КотировкиУровень2.ИсточникКотировки КАК Источник
		|ИЗ
		|	КотировкиУровень2 КАК КотировкиУровень2";
		
	//ТорговыхДнейНазад10 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки)-1, -10);
	ТорговыхДнейНазад10 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -10);
	ТорговыхДнейНазад21 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -21);
	ТорговыхДнейНазад63 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -63);
		
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10", ТорговыхДнейНазад10);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад21", ТорговыхДнейНазад21);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад63", ТорговыхДнейНазад63);
	Запрос.УстановитьПараметр("ММВБ", 		ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("СПб", 		ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_СПб"));
	Запрос.УстановитьПараметр("Блумберг", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("Режим_BGN", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Рубли", ПараметрыОценки.Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("НРД", ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("Организация", ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыОценки.СчетДоверительногоУправления);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);//ЦенныеБумаги.Выгрузить()
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Благосостояние (ЕПС)", "Таблица стоимостей ЦБ");		
	Иначе
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	// проверим существенность (п.2.4)
	
	Для Каждого СтрокаЦенныеБумаги Из ТаблицаСтоимостейЦБ Цикл
		ЗаполнитьПереоценкуБлагосостояния(СтрокаЦенныеБумаги, ДатаПереоценки, ПараметрыОценки, РасшифровкаРасчета);
	КонецЦикла;

	Возврат ТаблицаСтоимостейЦБ;

КонецФункции

Функция ПолучитьЦеныБлагосостояния2019(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "ИсходнаяТаблицаЦБ");
	ПоместитьБумагиОцениваемыеПоАмортизированнойСтоимостиВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки, ДатаПереоценки, "ИсходнаяТаблицаЦБ");
	
	#Область Основной_запрос	
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	Эмитенты.Ссылка КАК Эмитент,
		|	Эмитенты.ЮрФизЛицо КАК ЮрЛицоЭмитента
		|ПОМЕСТИТЬ ЭмитентыЦенныхБумаг
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Векселя КАК Векселя
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Векселя.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеРасписки КАК ДепозитарныеРасписки
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = ДепозитарныеРасписки.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = ИпотечныеСертификатыУчастия.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|		ПО (Эмитенты.Ссылка = ВЫБОР
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|					ТОГДА Акции.Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|					ТОГДА Облигации.Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|					ТОГДА Векселя.Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|					ТОГДА ДепозитарныеРасписки.Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|					ТОГДА ИпотечныеСертификатыУчастия.Эмитент
		|			КОНЕЦ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК ТоргуетсяНаММВБ,
		|	ЕСТЬNULL(Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация), ЛОЖЬ) КАК Еврооблигация,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЭмитентРоссийский,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация), ЛОЖЬ) КАК ЭмитентМеждународнаяФинОрганизация,
		|	_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК ОценкаПоАмортизированнойСтоимости
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ИСТИНА
		|					ИЗ
		|						ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|					ГДЕ
		|						ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, Статус, Биржа, Рынок) В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже),
		|						&ММВБ,
		|						ИсходнаяТаблицаЦБ.Рынок
		|					ИЗ
		|						ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЭмитентыЦенныхБумаг КАК ЭмитентыЦенныхБумаг
		|		ПО (ЭмитентыЦенныхБумаг.ЦеннаяБумага = ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента
		|					ИЗ
		|						ЭмитентыЦенныхБумаг)) КАК РеквизитыЮрЛицаЭмитента
		|		ПО (РеквизитыЮрЛицаЭмитента.ЮрФизЛицо = ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _БумагиОцениваемыеПоАмортизированнойСтоимости КАК _БумагиОцениваемыеПоАмортизированнойСтоимости
		|		ПО (_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага = ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
