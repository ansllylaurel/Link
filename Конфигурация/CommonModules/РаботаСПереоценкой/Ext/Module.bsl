	Запрос.УстановитьПараметр("КалендарныхДнейНазад30", НачалоДня(ДатаПереоценки) - 30 * 86400);
	Запрос.УстановитьПараметр("ММВБ", 					ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("НРД", 					ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("ЮрФизЛицо_ММВБ", 		ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ПАО_ММВБ"));
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Средневзвешенная 2022 (ЕПС)", "Таблица стоимостей ЦБ");		
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТаблицаСтоимостейЦБ Цикл
		Если СтрокаТаблицы.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаТаблицы.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаТаблицы.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления, , СтрокаТаблицы.ВалютаКупона);
		КонецЕсли;
	КонецЦикла;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "После заполнения купона", ТаблицаСтоимостейЦБ.Скопировать());		
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;

КонецФункции

Функция ПолучитьЦеныСургутнефтегаза2020(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)

	Запрос = Новый Запрос;	
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ИсходнаяТаблицаЦБ");
	ПоместитьЭмитентовЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "_ИсходнаяТаблицаЦБ");
	ПоместитьСведенияОТоргахЦеннымиБумагамиВМенеджерВременныхТаблиц(Запрос, "_ИсходнаяТаблицаЦБ", ДатаПереоценки, 20, "_СведенияОТоргахЦеннымиБумагами");	
	ПоместитьТаблицуДатРасчетныхЦенПаевВМенеджерВременныхТаблиц(Запрос, "_ИсходнаяТаблицаЦБ", ДатаПереоценки, "_ТаблицаДатРасчетныхЦенПаев");
	ПоместитьБиржевыеИндексыСоответствующиеЦеннымБумагамВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки, ДатаПереоценки, "_ИсходнаяТаблицаЦБ", "_БиржевыеИндексыЦенныхБумаг", Отказ);
	
	#Область Текст_запроса
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.КупонныеВыплаты)
		|					И ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ДефолтПоКупону,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ИсполнениеОферты)
		|					И ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.НеисполнениеОферты)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК НеисполнениеОферты,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации)
		|					И ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ДефолтПоТелу,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.Банкротство)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК Банкротство,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.Банкротство)
		|				ТОГДА ДефолтыПоОблигациямСрезПоследних.Период
		|			ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
		|		КОНЕЦ) КАК ДатаБанкротства
		|ПОМЕСТИТЬ _Дефолты
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДефолтыПоОблигациям.СрезПоследних(
		|				&ДатаПереоценки,
		|				Облигация В
		|						(ВЫБРАТЬ
		|							_ИсходнаяТаблицаЦБ.ЦеннаяБумага
		|						ИЗ
		|							_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|						ГДЕ
		|							_ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))
		|					И (ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.Банкротство)
		|						ИЛИ ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации)
		|						ИЛИ ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.КупонныеВыплаты)
		|						ИЛИ ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ИсполнениеОферты))) КАК ДефолтыПоОблигациямСрезПоследних
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = ДефолтыПоОблигациямСрезПоследних.Облигация
		|
		|СГРУППИРОВАТЬ ПО
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала = &ВалютаРубли КАК НоминированаВРублях,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПогашенияОблигации,
		|	ЕСТЬNULL(Облигации.Категория, НЕОПРЕДЕЛЕНО) КАК КатегорияОблигации,
		|	ЕСТЬNULL(Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация), ЛОЖЬ) КАК Еврооблигация,
		|	_БиржевыеИндексыЦенныхБумаг.БиржевойИндекс КАК СоответствующийБиржевойИндекс,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК ТоргуетсяНаММВБ,
		|	_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента КАК Эмитент,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЭмитентРоссийский,
		|	_Дефолты.Банкротство
		|		ИЛИ _Дефолты.ДефолтПоТелу
		|		ИЛИ _Дефолты.НеисполнениеОферты
		|		ИЛИ _Дефолты.ДефолтПоКупону
		|		ИЛИ _ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			И Облигации.ДатаПогашения <> ДАТАВРЕМЯ(1, 1, 1)
		|			И ВЫБОР
		|				КОГДА РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка))
		|					ТОГДА Облигации.ДатаПогашения < ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -10)
		|				ИНАЧЕ Облигации.ДатаПогашения < ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|			КОНЕЦ КАК ПризнакиОбесценения,
		|	_Дефолты.Банкротство КАК Банкротство,
		|	_Дефолты.ДатаБанкротства КАК ДатаБанкротства,
		|	ПоследняяДатаТоргов.Дата КАК ПоследняяДатаТоргов,
		|	ТорговыхДнейНазад10.Дата КАК ТорговыхДнейНазад10,
		|	ТорговыхДнейНазад20.Дата КАК ТорговыхДнейНазад20
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО (Облигации.Ссылка = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						_ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ИСТИНА
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|					ГДЕ
		|						_ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО (НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, Статус, Биржа, Рынок) В
		|					(ВЫБРАТЬ
		|						_ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже),
		|						&ММВБ,
		|						_ИсходнаяТаблицаЦБ.Рынок
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО (СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЭмитентыЦенныхБумаг КАК _ЭмитентыЦенныхБумаг
		|		ПО (_ЭмитентыЦенныхБумаг.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента
		|					ИЗ
		|						_ЭмитентыЦенныхБумаг)) КАК РеквизитыЮрЛицаЭмитента
		|		ПО (РеквизитыЮрЛицаЭмитента.ЮрФизЛицо = _ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Дефолты КАК _Дефолты
		|		ПО (_Дефолты.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СведенияОТоргахЦеннымиБумагами КАК ПоследняяДатаТоргов
		|		ПО (ПоследняяДатаТоргов.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|			И (ПоследняяДатаТоргов.ТорговыхДнейНазад = 1)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СведенияОТоргахЦеннымиБумагами КАК ТорговыхДнейНазад10
		|		ПО (ТорговыхДнейНазад10.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|			И (ТорговыхДнейНазад10.ТорговыхДнейНазад = 10)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СведенияОТоргахЦеннымиБумагами КАК ТорговыхДнейНазад20
		|		ПО (ТорговыхДнейНазад20.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|			И (ТорговыхДнейНазад20.ТорговыхДнейНазад = 20)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _БиржевыеИндексыЦенныхБумаг КАК _БиржевыеИндексыЦенныхБумаг
		|		ПО (_БиржевыеИндексыЦенныхБумаг.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.Биржа КАК Биржа,
		|	КотировкиТорговыхПлощадок.Период КАК Период,
		|	КотировкиТорговыхПлощадок.Валюта КАК Валюта,
		|	КотировкиТорговыхПлощадок.РежимТоргов КАК РежимТоргов,
		|	КотировкиТорговыхПлощадок.NUMTRADES КАК КоличествоСделок,
		|	КотировкиТорговыхПлощадок.VALUE КАК ОбъемСделок,
		|	КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность КАК ОбъемСделокВВалютеУчета,
		|	КотировкиТорговыхПлощадок.Период = _ТаблицаЦБ.ПоследняяДатаТоргов КАК ПоследнийДеньТоргов
		|ПОМЕСТИТЬ _КотировкиЗаПоследние10ТорговыхДней
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СведенияОТоргахЦеннымиБумагами КАК _СведенияОТоргахЦеннымиБумагами
		|		ПО (_СведенияОТоргахЦеннымиБумагами.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (_СведенияОТоргахЦеннымиБумагами.ТорговыхДнейНазад <= 10)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Рынок = _ТаблицаЦБ.Рынок)
		|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадок.Период = _СведенияОТоргахЦеннымиБумагами.Дата)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта)
		|			И (КотировкиТорговыхПлощадок.Период = КурсыВалют.Период)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КотировкиЗаПоследние10ТорговыхДней.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_КотировкиЗаПоследние10ТорговыхДней.Биржа КАК Биржа,
		|	_КотировкиЗаПоследние10ТорговыхДней.Период КАК Период,
		|	СУММА(_КотировкиЗаПоследние10ТорговыхДней.КоличествоСделок) КАК КоличествоСделок,
		|	СУММА(_КотировкиЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета) КАК ОбъемСделокВВалютеУчета,
		|	_КотировкиЗаПоследние10ТорговыхДней.ПоследнийДеньТоргов КАК ПоследнийДеньТоргов
		|ПОМЕСТИТЬ _ИтогиЗаПоследние10ТорговыхДней
		|ИЗ
		|	_КотировкиЗаПоследние10ТорговыхДней КАК _КотировкиЗаПоследние10ТорговыхДней
		|
		|СГРУППИРОВАТЬ ПО
		|	_КотировкиЗаПоследние10ТорговыхДней.ЦеннаяБумага,
		|	_КотировкиЗаПоследние10ТорговыхДней.Биржа,
		|	_КотировкиЗаПоследние10ТорговыхДней.Период,
		|	_КотировкиЗаПоследние10ТорговыхДней.ПоследнийДеньТоргов
		|;
