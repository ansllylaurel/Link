		|		КОГДА РасчетСС1.УровеньОценки = 2
		|			ТОГДА РасчетСС1.СправедливаяЦена
		|		КОГДА РАЗНОСТЬДАТ(&ДатаПереоценки, ВЫРАЗИТЬ(ЕСТЬNULL(КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE, 0) КАК ДАТА), ДЕНЬ) <= 30
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СправедливаяЦена,
		|	ВЫБОР
		|		КОГДА РасчетСС1.УровеньОценки = 1
		|			ТОГДА РасчетСС1.ПолеКотировки
		|		КОГДА ЕСТЬNULL(АктивныйРынокБлумберг.Период, 0) <> 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СредняяЦенаЗакрытия)
		|		КОГДА РасчетСС1.УровеньОценки = 2
		|			ТОГДА РасчетСС1.ПолеКотировки
		|		КОГДА РАЗНОСТЬДАТ(&ДатаПереоценки, ВЫРАЗИТЬ(ЕСТЬNULL(КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE, 0) КАК ДАТА), ДЕНЬ) <= 30
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ЦенаСпроса)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПолеКотировки,
		|	ВЫБОР
		|		КОГДА РасчетСС1.УровеньОценки = 1
		|			ТОГДА РасчетСС1.ДатаКотировки
		|		КОГДА ЕСТЬNULL(АктивныйРынокБлумберг.Период, 0) <> 0
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE_DATE
		|		КОГДА РасчетСС1.УровеньОценки = 2
		|			ТОГДА РасчетСС1.ДатаКотировки
		|		КОГДА РАЗНОСТЬДАТ(&ДатаПереоценки, ВЫРАЗИТЬ(ЕСТЬNULL(КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE, 0) КАК ДАТА), ДЕНЬ) <= 30
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ДатаКотировки,
		|	ВЫБОР
		|		КОГДА РасчетСС1.УровеньОценки = 1
		|			ТОГДА РасчетСС1.УровеньОценки
		|		КОГДА ЕСТЬNULL(АктивныйРынокБлумберг.Период, 0) <> 0
		|			ТОГДА 1
		|		КОГДА РасчетСС1.УровеньОценки = 2
		|			ТОГДА РасчетСС1.УровеньОценки
		|		КОГДА РАЗНОСТЬДАТ(&ДатаПереоценки, ВЫРАЗИТЬ(ЕСТЬNULL(КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE, 0) КАК ДАТА), ДЕНЬ) <= 30
		|			ТОГДА 2
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УровеньОценки,
		|	ВЫБОР
		|		КОГДА РасчетСС1.УровеньОценки = 1
		|			ТОГДА РасчетСС1.Биржа
		|		КОГДА ЕСТЬNULL(АктивныйРынокБлумберг.Период, 0) <> 0
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа
		|		КОГДА РасчетСС1.УровеньОценки = 2
		|			ТОГДА РасчетСС1.Биржа
		|		КОГДА РАЗНОСТЬДАТ(&ДатаПереоценки, ВЫРАЗИТЬ(ЕСТЬNULL(КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE, 0) КАК ДАТА), ДЕНЬ) <= 30
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Биржа,
		|	ВЫБОР
		|		КОГДА РасчетСС1.УровеньОценки = 1
		|			ТОГДА РасчетСС1.ВалютаКотировки
		|		КОГДА ЕСТЬNULL(АктивныйРынокБлумберг.Период, 0) <> 0
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта
		|		КОГДА РасчетСС1.УровеньОценки = 2
		|			ТОГДА РасчетСС1.ВалютаКотировки
		|		КОГДА РАЗНОСТЬДАТ(&ДатаПереоценки, ВЫРАЗИТЬ(ЕСТЬNULL(КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE, 0) КАК ДАТА), ДЕНЬ) <= 30
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ВалютаКотировки, ТаблицаЦБ.ВалютаНоминала
		|ПОМЕСТИТЬ РасчетСС
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РасчетСС1 КАК РасчетСС1
		|		ПО ТаблицаЦБ.Рынок = РасчетСС1.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = РасчетСС1.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ АктивныйРынокБлумберг КАК АктивныйРынокБлумберг
		|		ПО ТаблицаЦБ.Рынок = АктивныйРынокБлумберг.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = АктивныйРынокБлумберг.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(&ДатаПереоценки, Биржа = &Блумберг И РежимТоргов = &Режим_BGN) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадокСводныеСрезПоследних.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасчетСС.ЦеннаяБумага КАК ЦеннаяБумага,
		|	РасчетСС.Рынок КАК Рынок,
		|	РасчетСС.Номинал КАК Номинал,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(РасчетСС.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА РасчетСС.СправедливаяЦена * РасчетСС.Номинал / 100
		|		ИНАЧЕ РасчетСС.СправедливаяЦена
		|	КОНЕЦ КАК Стоимость,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(РасчетСС.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА РасчетСС.ВалютаНоминала
		|		ИНАЧЕ РасчетСС.ВалютаКотировки
		|	КОНЕЦ КАК ВалютаКотировки,
		|	РасчетСС.ПолеКотировки КАК ВидЦены,
		|	РасчетСС.ДатаКотировки КАК ДатаЦены,
		|	РасчетСС.УровеньОценки КАК УровеньОценки,
		|	Биржи.ЮрФизЛицо КАК Источник
		|ИЗ
		|	РасчетСС КАК РасчетСС
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО РасчетСС.Биржа = Биржи.Ссылка
		|ГДЕ
		|	РасчетСС.СправедливаяЦена <> 0";
		
	РабочихДнейНазад10 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -10);
	КалендарныхДнейНазад = НачалоДня(ДатаПереоценки) - 30 * 86400;
		
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	Запрос.УстановитьПараметр("ММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	
	Запрос.УстановитьПараметр("Блумберг", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("Режим_BGN", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	
	Запрос.УстановитьПараметр("Организация", ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыОценки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("РабочихДнейНазад10", РабочихДнейНазад10);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Стройкомплекс (ЕПС)", "Таблица стоимостей ЦБ");		
	Иначе
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;
КонецФункции

Функция ПолучитьЦеныСтройкомплекса2018(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	#Область Основной_запрос
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	ТаблицаСпискаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	ВЫБОР
		|		КОГДА ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ В (&ИностранныеУчетныеАктивы)
		|			ТОГДА ВЫБОР
		|					КОГДА ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|						ТОГДА ВЫБОР
		|								КОГДА ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|										ИЛИ ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗ)
		|										ИЛИ ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств)
		|										ИЛИ РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация)
		|									ТОГДА 2
		|								ИНАЧЕ 1
		|							КОНЕЦ
		|					ИНАЧЕ 1
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ВидЦеныБлумберга,
		|	ЕСТЬNULL(Облигации.ДатаНачалаОбращения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаОбращения,
		|	ЕСТЬNULL(Облигации.ДатаНачалаРазмещения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаРазмещения
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаЦБ.Рынок КАК Рынок
		|ПОМЕСТИТЬ АктивныйРынокММВБ10Дней
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадок.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
		|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта)
		|			И (КурсыВалют.Период = &ДатаПереоценки)
		|ГДЕ
		|	КотировкиТорговыхПлощадок.Период >= &ТорговыхДнейНазад10
		|	И КотировкиТорговыхПлощадок.Период <= &ДатаПереоценки
		|	И КотировкиТорговыхПлощадок.Биржа = &ММВБ
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал,
		|	ТаблицаЦБ.ВалютаНоминала,
		|	ТаблицаЦБ.Рынок
		|
		|ИМЕЮЩИЕ
		|	СУММА(КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность) >= 500000 И
		|	СУММА(КотировкиТорговыхПлощадок.NUMTRADES) >= 10
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	КотировкиТорговыхПлощадок.Рынок КАК Рынок,
		|	КотировкиТорговыхПлощадок.Биржа КАК Биржа,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(КотировкиТорговыхПлощадок.CLOSE, 0) > 0
		|				И ЕСТЬNULL(КотировкиТорговыхПлощадок.BID, 0) > 0
		|				И ЕСТЬNULL(КотировкиТорговыхПлощадок.OFFER, 0) > 0
		|				И ЕСТЬNULL(КотировкиТорговыхПлощадок.BID, 0) <= ЕСТЬNULL(КотировкиТорговыхПлощадок.CLOSE, 0)
		|				И ЕСТЬNULL(КотировкиТорговыхПлощадок.CLOSE, 0) <= ЕСТЬNULL(КотировкиТорговыхПлощадок.OFFER, 0)
		|				И ЕСТЬNULL(КотировкиТорговыхПлощадок.NUMTRADES, 0) >= 10
		|			ТОГДА КотировкиТорговыхПлощадок.CLOSE
		|		КОГДА ЕСТЬNULL(КотировкиТорговыхПлощадок.LEGALCLOSEPRICE, 0) > 0
		|				И ЕСТЬNULL(КотировкиТорговыхПлощадок.CLOSE, 0) > 0
		|				И ЕСТЬNULL(КотировкиТорговыхПлощадок.VALUE, 0) > 0
