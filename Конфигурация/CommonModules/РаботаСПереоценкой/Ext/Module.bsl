		|			КОГДА КотировкиОсновногоРынкаБлумбергBVAL.BID <> 0
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	3 КАК УровеньОценки,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СЧА) КАК ВидЦены,
		|	РасчетныеЦеныПаев.РасчетнаяЦена КАК СправедливаяЦена,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаЦены,
		|	РасчетныеЦеныПаев.Период КАК ДатаЦены,
		|	NULL КАК Биржа,
		|	РеквизитыПИФ.УправляющаяКомпания.ЮрФизЛицо КАК Источник
		|ПОМЕСТИТЬ _ЦБУровень3
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
		|		ПО (Паи.Ссылка = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦБУровень1 КАК _ЦБУровень1
		|		ПО (_ЦБУровень1.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦБУровень2 КАК _ЦБУровень2
		|		ПО (_ЦБУровень2.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						_ТаблицаЦБ.ЦеннаяБумага
		|					ИЗ
		|						_ТаблицаЦБ
		|					ГДЕ
		|						_ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))) КАК РасчетныеЦеныПаев
		|		ПО (РасчетныеЦеныПаев.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (РасчетныеЦеныПаев.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, МЕСЯЦ, -6))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФ
		|		ПО (Паи.ПаевойИнвестиционныйФонд = РеквизитыПИФ.ПаевойИнвестиционныйФонд)
		|ГДЕ
		|	_ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости = ЛОЖЬ
		|	И _ЦБУровень1.ЦеннаяБумага ЕСТЬ NULL
		|	И _ЦБУровень2.ЦеннаяБумага ЕСТЬ NULL
		|	И НЕ &ТолькоНаблюдаемыеЦены
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦБУровень1.Рынок КАК Рынок,
		|	_ЦБУровень1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ЦБУровень1.ВалютаНоминала КАК ВалютаНоминала,
		|	_ЦБУровень1.УровеньОценки КАК УровеньОценки,
		|	_ЦБУровень1.ВидЦены КАК ВидЦены,
		|	_ЦБУровень1.СправедливаяЦена КАК СправедливаяЦена,
		|	_ЦБУровень1.ВалютаЦены КАК ВалютаКотировки,
		|	_ЦБУровень1.ВалютаЦены КАК Валюта,
		|	_ЦБУровень1.ДатаЦены КАК ДатаЦены,
		|	_ЦБУровень1.Биржа КАК Биржа,
		|	_ЦБУровень1.Источник КАК Источник
		|ПОМЕСТИТЬ _ОцененныеБумаги
		|ИЗ
		|	_ЦБУровень1 КАК _ЦБУровень1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦБУровень2.Рынок,
		|	_ЦБУровень2.ЦеннаяБумага,
		|	_ЦБУровень2.ВалютаНоминала,
		|	_ЦБУровень2.УровеньОценки,
		|	_ЦБУровень2.ВидЦены,
		|	_ЦБУровень2.СправедливаяЦена,
		|	_ЦБУровень2.ВалютаЦены,
		|	_ЦБУровень2.ВалютаЦены,
		|	_ЦБУровень2.ДатаЦены,
		|	_ЦБУровень2.Биржа,
		|	_ЦБУровень2.Источник
		|ИЗ
		|	_ЦБУровень2 КАК _ЦБУровень2
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦБУровень3.Рынок,
		|	_ЦБУровень3.ЦеннаяБумага,
		|	_ЦБУровень3.ВалютаНоминала,
		|	_ЦБУровень3.УровеньОценки,
		|	_ЦБУровень3.ВидЦены,
		|	_ЦБУровень3.СправедливаяЦена,
		|	_ЦБУровень3.ВалютаЦены,
		|	_ЦБУровень3.ВалютаЦены,
		|	_ЦБУровень3.ДатаЦены,
		|	_ЦБУровень3.Биржа,
		|	_ЦБУровень3.Источник
		|ИЗ
		|	_ЦБУровень3 КАК _ЦБУровень3
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ТаблицаЦБ.Номинал КАК Номинал,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(_ОцененныеБумаги.СправедливаяЦена * _ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|			ИНАЧЕ _ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(_ОцененныеБумаги.Валюта, 0) КАК Валюта,
		|	ЕСТЬNULL(_ОцененныеБумаги.ВалютаКотировки, 0) КАК ВалютаКотировки,
		|	ЕСТЬNULL(_ОцененныеБумаги.ВидЦены, 0) КАК ВидЦены,
		|	ЕСТЬNULL(_ОцененныеБумаги.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(_ОцененныеБумаги.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(_ОцененныеБумаги.Биржа, 0) КАК Биржа,
		|	ЕСТЬNULL(_ОцененныеБумаги.Источник, ЕСТЬNULL(Биржи.ЮрФизЛицо, 0)) КАК Источник,
		|	0 КАК Купон,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаКупона,
		|	_ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости КАК ОценкаПоАмортизированнойСтоимости
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОцененныеБумаги КАК _ОцененныеБумаги
		|		ПО (_ОцененныеБумаги.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (Биржи.Ссылка = _ОцененныеБумаги.Биржа)
		|ГДЕ
		|	НЕ _ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ТаблицаЦБ.Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага,
		|	_ТаблицаЦБ.ВалютаНоминала,
		|	_ТаблицаЦБ.Номинал,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	_ТаблицаЦБ.ВалютаНоминала,
		|	_ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|ГДЕ
		|	_ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости";
	
	#КонецОбласти
	
	ТолькоНаблюдаемыеЦены			= ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены;
	
	ТорговыхДнейНазад10				= Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(), НачалоДня(ДатаПереоценки), -10);
	ПоследнийТорговыйДень			= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(), НачалоДня(ДатаПереоценки));
	ПоследняяДатаТорговБлумберга	= РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки);		
	ДатаПереоценкиНРД				= НачалоДня(ДатаПереоценки);
	
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10",			ТорговыхДнейНазад10);
	Запрос.УстановитьПараметр("ПоследнийТорговыйДень",			ПоследнийТорговыйДень);
	Запрос.УстановитьПараметр("ПоследнийДеньТорговБлумберг",	ПоследняяДатаТорговБлумберга);
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ДатаПереоценкиНРД",				ДатаПереоценкиНРД);
	
	Запрос.УстановитьПараметр("ММВБ",							ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("НРД",							ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("Блумберг",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("Режим_BGN",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	Запрос.УстановитьПараметр("ВалютаРубли",					ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	Запрос.УстановитьПараметр("РежимОблигацииТ0",				ОбщегоНазначения.ПолучитьИменованныйОбъект("РежимТоргов_Т0_Облигации"));
	Запрос.УстановитьПараметр("РежимОблигацииТПлюсUSD",			ОбщегоНазначения.ПолучитьИменованныйОбъект("РежимТоргов_Т+_Облига_USD"));	
	
	// В этот день было письмо от фонда, в котором пояснялось, что для торгующихся на ММВБ бумаг, номинированных в иностранной валюте, 
	// нужно проверять совокупный объекм торгов, а также сначала смотреть котировку в валюте; если нет подходящей, смотреть котировку в рублях.
	Запрос.УстановитьПараметр("ДатаНачалаИспользованияСовокупногоОбъемаТоргов", '20200203');
	
	// Изменение алгоритма для уровня 2.
	// С этого дня, после очередного письма из фонда:
	// при определении справедливой стоимости рублевой облигации по 2 пункту алгоритма, 
	// надлежит использовать цену на момент окончания торговой сессии, рассчитанную биржей на дату оценки, 
	// вне зависимости от того, в каких режимах были зафиксированы сделки, 
	// упоминаемые в 1-м абзаце пункта 2 раздела «Оценка по исходным данным 2 уровня».
	Запрос.УстановитьПараметр("ДатаНачалаПроверкиСделокПоВсемРежимамДляWaprice", '20200422');
	
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены", ТолькоНаблюдаемыеЦены);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены СЧА Нефтегаранта 2020", "Промежуточная таблица стоимостей ЦБ", , , "_ИсходнаяТаблицаЦБ, _БумагиОцениваемыеПоАмортизированнойСтоимости, _ЭмитентыЦенныхБумаг");		
	КонецЕсли;
	
	Если ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;
	
	// Расчетные цены 		
	
	ВыполненРасчетЦены = Ложь;
	
	ПараметрыОценки.Вставить("ПараметрыМоделиCAPM", Новый Структура("ТочностьБета", 4));
	ПараметрыОценки.Вставить("ТочностьКБД", 2); // в процентах до 2 знаков после запятой
	ПараметрыОценки.Вставить("ТочностьDCF", 5);
	
	ПараметрыДенежногоПотока		 = ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	ПараметрыРасчетаРейтинга		 = ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда = ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);			
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены) ИЛИ СтрокаСтоимостейЦБ.ОценкаПоАмортизированнойСтоимости Тогда
			Продолжить;
		КонецЕсли;

		// Расчет цены 		
		
		ОшибкаРасчета = Ложь;
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков
			
			// Ставка дисконтирования зависит от ставки КБД и медианы кредитного спреда
			// В этой методике ставка КБД рассчитывается не от средневзвешенного срока денежного потока, а отдельно для каждого денежного потока
			
			Если ДатаПереоценки >= '20200907' Тогда
				ТочностьЦены	= 2;
				УровеньОценки	= 3;
			Иначе
				ТочностьЦены	= 5;
				УровеньОценки	= 2;
			КонецЕсли;
			
			ЗаполнитьДисконтированнойПоЗначениямКБДСтоимостью(СтрокаСтоимостейЦБ, ДатаПереоценки, ПараметрыОценки, УровеньОценки, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, , ТочностьЦены, ПараметрыДенежногоПотока, ОшибкаРасчета, РасшифровкаРасчета);
			
			Если ОшибкаРасчета Тогда
				Отказ = Истина;
			ИначеЕсли ЗначениеЗаполнено(СтрокаСтоимостейЦБ.Стоимость) Тогда 
				ВыполненРасчетЦены = Истина;
			КонецЕсли;
			
			#КонецОбласти
			
		ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
			
			#Область Расчет_на_основе_корректировки_исторической_цены					
			
			// Справедливая стоимость акций российских эмитентов, допущенным к торгам на ММВБ,
			// определяется в соответствии с моделью оценки, основанной на корректировке исторической цены (CAPM).
			// Применяем при отсутствии цены не более 10 рабочих дней
			
			ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, Справочники.Календари.Общероссийский, , 4, Отказ, РасшифровкаРасчета);  
						
			Если ЦенаЗаполнена Тогда
				ВыполненРасчетЦены = Истина;
			КонецЕсли;
			
			#КонецОбласти					
			
		КонецЕсли;

	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "Таблица стоимостей ЦБ", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныЭволюции2021(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ТаблицаСпискаЦБ");
