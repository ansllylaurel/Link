		   |			ПО КотировкиБлумберг.Биржа = Биржи.Ссылка
		   |		ПО ТаблицаЦБ.Рынок = КотировкиБлумберг.Рынок
		   |			И ТаблицаЦБ.ЦеннаяБумага = КотировкиБлумберг.ЦеннаяБумага
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
		   |		ПО ТаблицаЦБ.Рынок = РасчетныеЦеныНРД.Рынок
		   |			И ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныНРД.ЦеннаяБумага
		   |			И (РасчетныеЦеныНРД.Период = &ДатаПереоценки)
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(&ДатаПереоценки, ) КАК РасчетныеЦеныПаевСрезПоследних
		   |		ПО ((ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Паи)) = РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага)
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФСрезПоследних
		   |		ПО (ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		   |;
		   |
		   |////////////////////////////////////////////////////////////////////////////////
		   |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		   |	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		   |	ТаблицаЦБ.Рынок КАК Рынок,
		   |	ТаблицаЦБ.Номинал КАК Номинал,
		   |	ВЫБОР
		   |		КОГДА КотировкиНРДиПаи.СправедливаяЦена > 0
		   |			ТОГДА КотировкиНРДиПаи.СправедливаяЦена
		   |		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		   |			ТОГДА ВЫБОР
		   |					КОГДА ТИПЗНАЧЕНИЯ(ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		   |						ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID * ТаблицаЦБ.Номинал / 100
		   |					ИНАЧЕ КотировкиТорговыхПлощадокСводныеСрезПоследних.BID
		   |				КОНЕЦ
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК СправедливаяЦена,
		   |	ВЫБОР
		   |		КОГДА КотировкиНРДиПаи.СправедливаяЦена > 0
		   |			ТОГДА КотировкиНРДиПаи.УровеньОценки
		   |		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		   |			ТОГДА 2
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК УровеньОценки,
		   |	ВЫБОР
		   |		КОГДА КотировкиНРДиПаи.СправедливаяЦена > 0
		   |			ТОГДА КотировкиНРДиПаи.ДатаЦены
		   |		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		   |			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК ДатаЦены,
		   |	ВЫБОР
		   |		КОГДА КотировкиНРДиПаи.СправедливаяЦена > 0
		   |			ТОГДА КотировкиНРДиПаи.ПолеКотировки
		   |		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		   |			ТОГДА ЗНАЧЕНИЕ(перечисление.ИсточникиЦеныДляПереоценки.ЦенаСпроса)
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК ПолеКотировки,
		   |	ВЫБОР
		   |		КОГДА КотировкиНРДиПаи.СправедливаяЦена > 0
		   |			ТОГДА КотировкиНРДиПаи.ИсточникЦены
		   |		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		   |			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа.ЮрФизЛицо
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК ИсточникЦены,
		   |	ВЫБОР
		   |		КОГДА КотировкиНРДиПаи.СправедливаяЦена > 0
		   |			ТОГДА КотировкиНРДиПаи.ВалютаКотировки
		   |		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		   |			ТОГДА ВЫБОР
		   |					КОГДА ТИПЗНАЧЕНИЯ(ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		   |						ТОГДА ТаблицаЦБ.ВалютаНоминала
		   |					ИНАЧЕ КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта
		   |				КОНЕЦ
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК ВалютаКотировки
		   |ПОМЕСТИТЬ КотировкиРТСБоард
		   |ИЗ
		   |	ТаблицаЦБ КАК ТаблицаЦБ
		   |		ЛЕВОЕ СОЕДИНЕНИЕ КотировкиНРДиПаи КАК КотировкиНРДиПаи
		   |		ПО ТаблицаЦБ.Рынок = КотировкиНРДиПаи.Рынок
		   |			И ТаблицаЦБ.ЦеннаяБумага = КотировкиНРДиПаи.ЦеннаяБумага
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(&ДатаПереоценки, Биржа = &РТС) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
		   |		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадокСводныеСрезПоследних.Рынок
		   |			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага
		   |;
		   |
		   |////////////////////////////////////////////////////////////////////////////////
		   |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		   |	КотировкиРТСБоард.ЦеннаяБумага КАК ЦеннаяБумага,
		   |	КотировкиРТСБоард.Рынок КАК Рынок,
		   |	КотировкиРТСБоард.Номинал КАК Номинал,
		   |	КотировкиРТСБоард.УровеньОценки КАК УровеньОценки,
		   |	КотировкиРТСБоард.ДатаЦены КАК ДатаЦены,
		   |	КотировкиРТСБоард.ПолеКотировки КАК ВидЦены,
		   |	КотировкиРТСБоард.ИсточникЦены КАК Источник,
		   |	КотировкиРТСБоард.СправедливаяЦена КАК Стоимость,
		   |	КотировкиРТСБоард.ВалютаКотировки КАК ВалютаКотировки,
		   |	""Цены облигаций приведены к деньгам при получении цен НРД"" КАК Примечание
		   |ИЗ
		   |	КотировкиРТСБоард КАК КотировкиРТСБоард";
		
	ТорговыхДнейНазад10 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -10);
		
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10", ТорговыхДнейНазад10);
	Запрос.УстановитьПараметр("ММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("РТС", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_РТС"));
	
	Запрос.УстановитьПараметр("Блумберг", ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	
	Запрос.УстановитьПараметр("Режим_BGN"	, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL"	, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	
	Запрос.УстановитьПараметр("Рубли", ПараметрыОценки.Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("НРД", ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("Организация", ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыОценки.СчетДоверительногоУправления);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);
	
	ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаСтоимостейЦБ;

КонецФункции

Функция ПолучитьЦеныНационального(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(Облигации.ВалютаНоминала, &Рубли) <> &Рубли КАК Евробонд,
		|	ЕСТЬNULL(Облигации.ВалютаНоминала, &Рубли) КАК ВалютаНоминала
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|			ПО НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага = Облигации.Ссылка
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	КотировкиТорговыхПлощадок.Валюта КАК Валюта,
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КотировкиТорговыхПлощадок.Период) КАК Период,
		|	СУММА(КотировкиТорговыхПлощадок.NUMTRADES) КАК NUMTRADES,
		|	СУММА(КотировкиТорговыхПлощадок.VALUE) КАК VALUE,
		|	КурсыВалют.Валюта КАК Валюта1,
		|	КурсыВалют.Курс КАК Курс,
		|	КурсыВалют.Кратность КАК Кратность,
		|	ТаблицаЦБ.Евробонд КАК Евробонд
		|ПОМЕСТИТЬ АктивныйРынокММВБ
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|			ПО КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта
		|				И (КурсыВалют.Период = &ДатаПереоценки)
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадок.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
		|			И (КотировкиТорговыхПлощадок.NUMTRADES > 0)
		|ГДЕ
		|	КотировкиТорговыхПлощадок.Биржа = &ММВБ
		|	И КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим
		|	И КотировкиТорговыхПлощадок.Период МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -90) И &ДатаПереоценки
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал,
		|	ТаблицаЦБ.Рынок,
		|	КотировкиТорговыхПлощадок.Валюта,
		|	КурсыВалют.Валюта,
		|	КурсыВалют.Курс,
		|	КурсыВалют.Кратность,
		|	ТаблицаЦБ.Евробонд
		|
		|ИМЕЮЩИЕ
		|	(НЕ ТаблицаЦБ.Евробонд
		|			И СУММА(КотировкиТорговыхПлощадок.NUMTRADES) > 0
		|		ИЛИ ТаблицаЦБ.Евробонд
		|			И СУММА(КотировкиТорговыхПлощадок.NUMTRADES) >= 2
		|			И СУММА(КотировкиТорговыхПлощадок.VALUE) * КурсыВалют.Курс / КурсыВалют.Кратность >= 1500000)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	КотировкиТорговыхПлощадок.Валюта КАК Валюта,
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КотировкиТорговыхПлощадок.Период) КАК Период,
		|	СУММА(КотировкиТорговыхПлощадок.NUMTRADES) КАК NUMTRADES,
		|	СУММА(КотировкиТорговыхПлощадок.VALUE) КАК VALUE,
		|	КурсыВалют.Валюта КАК Валюта1,
		|	КурсыВалют.Курс КАК Курс,
		|	КурсыВалют.Кратность КАК Кратность,
		|	ТаблицаЦБ.Евробонд КАК Евробонд
		|ПОМЕСТИТЬ АктивныйРынокСПб
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|			ПО КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта
		|				И (КурсыВалют.Период = &ДатаПереоценки)
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадок.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
		|			И (КотировкиТорговыхПлощадок.NUMTRADES > 0)
		|ГДЕ
		|	КотировкиТорговыхПлощадок.Биржа = &СПБ
		|	И КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим
		|	И КотировкиТорговыхПлощадок.Период МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -90) И &ДатаПереоценки
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал,
		|	ТаблицаЦБ.Рынок,
		|	КотировкиТорговыхПлощадок.Валюта,
		|	КурсыВалют.Валюта,
		|	КурсыВалют.Курс,
		|	КурсыВалют.Кратность,
		|	ТаблицаЦБ.Евробонд
		|
		|ИМЕЮЩИЕ
		|	(НЕ ТаблицаЦБ.Евробонд
		|			И СУММА(КотировкиТорговыхПлощадок.NUMTRADES) > 0
		|		ИЛИ ТаблицаЦБ.Евробонд
		|			И СУММА(КотировкиТорговыхПлощадок.NUMTRADES) >= 2
		|			И СУММА(КотировкиТорговыхПлощадок.VALUE) * КурсыВалют.Курс / КурсыВалют.Кратность >= 1500000)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(АктивныйРынокММВБ.VALUE, 0) >= ЕСТЬNULL(АктивныйРынокСПб.VALUE, 0)
		|			ТОГДА ВЫБОР
		|					КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследнихММВБ.MARKETPRICE2_DATE = &ДатаПереоценки
		|						ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследнихММВБ.MARKETPRICE2
		|					ИНАЧЕ 0
		|				КОНЕЦ
		|		КОГДА ЕСТЬNULL(АктивныйРынокСПб.VALUE, 0) > 0
