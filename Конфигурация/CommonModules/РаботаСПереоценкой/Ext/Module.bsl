			|			И _ВторойУровень.ЦеннаяБумага = КотировкиЦенныхБумаг.ЦеннаяБумага
			|			И (КотировкиЦенныхБумаг.Биржа = &ММВБ)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦеныПродавцаИПокупателя КАК _ЦеныПродавцаИПокупателя
			|		ПО _ВторойУровень.ЦеннаяБумага = _ЦеныПродавцаИПокупателя.ЦеннаяБумага");

		#КонецОбласти	
					                                                                 
		ДоступныеБиржи = Новый Массив;
		
