		|			ТОГДА _ДействующиеСводныеКотировкиЦБ.Цена * НоминалыЦенныхБумагСрезПоследних.Номинал / 100
		|		ИНАЧЕ _ДействующиеСводныеКотировкиЦБ.Цена
		|	КОНЕЦ КАК Цена,
		|	_ДействующиеСводныеКотировкиЦБ.ВидЦены КАК ВидЦены,
		|	_ДействующиеСводныеКотировкиЦБ.ДатаЦены КАК ДатаЦены,
		|	1 КАК УровеньОценки,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, _ДействующиеСводныеКотировкиЦБ.Биржа) КАК Источник,
		|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток / БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК ЦенаПартии,
		|	БухПартииЦенныхБумагОстатки.Партия.Дата КАК ДатаПартии,
		|	_ДействующиеСводныеКотировкиЦБ.Валюта КАК Валюта,
		|	_ДействующиеСводныеКотировкиЦБ.ПорядокБумаг КАК ПорядокБумаг
		|ПОМЕСТИТЬ _ИсходнаяТаблицаЦБсЦенамиПартий
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СводныеКотировкиЦБ КАК _ДействующиеСводныеКотировкиЦБ
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПриоритетКотировокЦБ КАК _ПриоритетКотировокЦБ
		|			ПО (_ПриоритетКотировокЦБ.ЦеннаяБумага = _ДействующиеСводныеКотировкиЦБ.ЦеннаяБумага)
		|				И (_ПриоритетКотировокЦБ.Биржа = _ДействующиеСводныеКотировкиЦБ.Биржа)
		|				И (_ПриоритетКотировокЦБ.РежимТоргов = _ДействующиеСводныеКотировкиЦБ.РежимТоргов)
		|				И (_ПриоритетКотировокЦБ.Приоритет = 1)
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = _ДействующиеСводныеКотировкиЦБ.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (_ДействующиеСводныеКотировкиЦБ.Биржа = Биржи.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						_ИсходнаяТаблицаЦБ.ЦеннаяБумага
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ)) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				КОНЕЦПЕРИОДА(&ДатаПереоценки, ДЕНЬ),
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ЦеннаяБумага В
		|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|							_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|						ИЗ
		|							_ИсходнаяТаблицаЦБ)
		|					И ТИПЗНАЧЕНИЯ(Партия) В (ТИП(Документ.ВводЦенныхБумаг), ТИП(Документ.Сделка))) КАК БухПартииЦенныхБумагОстатки
		|		ПО (БухПартииЦенныхБумагОстатки.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|			И (КОНЕЦПЕРИОДА(БухПартииЦенныхБумагОстатки.Партия.Дата, ДЕНЬ) = КОНЕЦПЕРИОДА(&ДатаПереоценки, ДЕНЬ))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБсЦенамиПартий.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБсЦенамиПартий.Рынок КАК Рынок,
		|	_ИсходнаяТаблицаЦБсЦенамиПартий.ВалютаНоминала КАК ВалютаНоминала,
		|	_ИсходнаяТаблицаЦБсЦенамиПартий.Номинал КАК Номинал,
		|	ЕСТЬNULL(_ИсходнаяТаблицаЦБсЦенамиПартий.ЦенаПартии, _ИсходнаяТаблицаЦБсЦенамиПартий.Цена) КАК Стоимость,
		|	ВЫБОР
		|		КОГДА _ИсходнаяТаблицаЦБсЦенамиПартий.ЦенаПартии ЕСТЬ NULL
		|			ТОГДА _ИсходнаяТаблицаЦБсЦенамиПартий.ВидЦены
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ЦенаПриобретения)
		|	КОНЕЦ КАК ВидЦены,
		|	ВЫБОР
		|		КОГДА _ИсходнаяТаблицаЦБсЦенамиПартий.ЦенаПартии ЕСТЬ NULL
		|			ТОГДА _ИсходнаяТаблицаЦБсЦенамиПартий.ДатаЦены
		|		ИНАЧЕ НАЧАЛОПЕРИОДА(_ИсходнаяТаблицаЦБсЦенамиПартий.ДатаПартии, ДЕНЬ)
		|	КОНЕЦ КАК ДатаЦены,
		|	ВЫБОР
		|		КОГДА _ИсходнаяТаблицаЦБсЦенамиПартий.ЦенаПартии ЕСТЬ NULL
		|			ТОГДА _ИсходнаяТаблицаЦБсЦенамиПартий.УровеньОценки
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УровеньОценки,
		|	ВЫБОР
		|		КОГДА _ИсходнаяТаблицаЦБсЦенамиПартий.ЦенаПартии ЕСТЬ NULL
		|			ТОГДА _ИсходнаяТаблицаЦБсЦенамиПартий.Источник
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Источник,
		|	ВЫБОР
		|		КОГДА _ИсходнаяТаблицаЦБсЦенамиПартий.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА _ИсходнаяТаблицаЦБсЦенамиПартий.ВалютаНоминала
		|		ИНАЧЕ ЕСТЬNULL(_ИсходнаяТаблицаЦБсЦенамиПартий.Валюта, 0)
		|	КОНЕЦ КАК ВалютаКотировки
		|ИЗ
		|	_ИсходнаяТаблицаЦБсЦенамиПартий КАК _ИсходнаяТаблицаЦБсЦенамиПартий
		|
		|УПОРЯДОЧИТЬ ПО
		|	_ИсходнаяТаблицаЦБсЦенамиПартий.ПорядокБумаг";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1000000", Формат(Кэширование.КоличествоЗаписейТаблицы("РегистрСведений.КотировкиТорговыхПлощадок"), "ЧН=; ЧГ=; ЧФ='ПЕРВЫЕ Ч'"));
	
	#КонецОбласти
	
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки); 
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ПараметрыОценки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация",					ПараметрыОценки.Организация);		
	
	Запрос.УстановитьПараметр("БиржаММВБ",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ")); 			
	Запрос.УстановитьПараметр("Блумберг",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));	
	Запрос.УстановитьПараметр("Режим_BVAL",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));		       
	Запрос.УстановитьПараметр("ВалютаРубли",					ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Мегарусс (Страхование) (ЕПС)", "Таблица стоимостей ЦБ", , , "_ПриоритетКотировокЦБ_Служебный");
	КонецЕсли;

	Возврат ТаблицаСтоимостейЦБ; 	
	
КонецФункции

Функция ПолучитьЦеныСредневзвешенная_УКПИ(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
				
	Запрос = Новый Запрос();	
		# Область Текст_запроса		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала
		|ПОМЕСТИТЬ _ТаблицаСпискаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЦеннаяБумага,
		|	Рынок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследних.Номинал, 0) КАК Номинал
		|ПОМЕСТИТЬ _ИсходнаяТаблицаЦБ
		|ИЗ
		|	_ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|					ИЗ
		|						_ТаблицаСпискаЦБ КАК ИсходнаяТаблицаЦБ)) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ТаблицаСпискаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЦеннаяБумага,
		|	Рынок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ.Номинал КАК Номинал,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала
		|ПОМЕСТИТЬ _АктивныйРынокММВБ20Дней
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта)
		|ГДЕ
		|	КотировкиТорговыхПлощадок.Период <= &ДатаПереоценки
		|	И КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим
		|	И КотировкиТорговыхПлощадок.Период > ВЫБОР
		|			КОГДА &ДатаПереоценки < ДАТАВРЕМЯ(2022, 1, 1, 0, 0, 0)
		|				ТОГДА ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -20)
		|			КОГДА &ДатаПереоценки < ДАТАВРЕМЯ(2024, 1, 1, 0, 0, 0)
		|				ТОГДА ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -21)
		|			ИНАЧЕ ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|		КОНЕЦ
		|	И КотировкиТорговыхПлощадок.Биржа = &ММВБ
		|	И КурсыВалют.Период = &ДатаПереоценки
		|
		|СГРУППИРОВАТЬ ПО
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.Рынок,
		|	ИсходнаяТаблицаЦБ.Номинал,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала,
		|	КотировкиТорговыхПлощадок.Валюта
		|
		|ИМЕЮЩИЕ
		|	(&ДатаПереоценки < ДАТАВРЕМЯ(2022, 1, 1, 0, 0, 0)
		|			И (СУММА(КотировкиТорговыхПлощадок.NUMTRADES) >= 10
		|				ИЛИ СУММА(КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность) >= 500000)
		|		ИЛИ СУММА(КотировкиТорговыхПлощадок.NUMTRADES) >= 10
		|			И СУММА(КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность) >= 500000)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АктивныйРынокММВБ20Дней.ЦеннаяБумага КАК ЦеннаяБумага,
		|	АктивныйРынокММВБ20Дней.Рынок КАК Рынок,
		|	КотировкиТорговыхПлощадокСрезПоследних.РежимТоргов КАК РежимТоргов,
		|	АктивныйРынокММВБ20Дней.Номинал КАК Номинал,
		|	АктивныйРынокММВБ20Дней.ВалютаНоминала КАК ВалютаНоминала,
		|	КотировкиТорговыхПлощадокСрезПоследних.Валюта КАК ВалютаКотировки,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА АктивныйРынокММВБ20Дней.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(КотировкиТорговыхПлощадокСрезПоследних.WAPRICE * АктивныйРынокММВБ20Дней.Номинал КАК ЧИСЛО(27, 10))) / 100
		|			ИНАЧЕ КотировкиТорговыхПлощадокСрезПоследних.WAPRICE
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(КотировкиТорговыхПлощадокСрезПоследних.WAPRICE_DATE, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаЦены,
		|	КотировкиТорговыхПлощадокСрезПоследних.Биржа.ЮрФизЛицо КАК Источник,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СредневзвешеннаяЦена) КАК ВидЦены,
		|	КотировкиТорговыхПлощадокСрезПоследних.VALUE КАК VOLUME
		|ПОМЕСТИТЬ _АктивныйРынокКотировки
		|ИЗ
		|	_АктивныйРынокММВБ20Дней КАК АктивныйРынокММВБ20Дней
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|						(ВЫБРАТЬ
		|							ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|						ИЗ
		|							_АктивныйРынокММВБ20Дней КАК ИсходнаяТаблицаЦБ)
		|					И Биржа = &ММВБ) КАК КотировкиТорговыхПлощадокСрезПоследних
		|		ПО АктивныйРынокММВБ20Дней.ЦеннаяБумага = КотировкиТорговыхПлощадокСрезПоследних.ЦеннаяБумага
		|			И АктивныйРынокММВБ20Дней.Рынок = КотировкиТорговыхПлощадокСрезПоследних.Рынок
		|			И (КотировкиТорговыхПлощадокСрезПоследних.РежимТоргов.ОсновнойРежим)
		|ГДЕ
		|	КотировкиТорговыхПлощадокСрезПоследних.WAPRICE <> 0
		|	И КотировкиТорговыхПлощадокСрезПоследних.WAPRICE_DATE > ВЫБОР
		|			КОГДА &ДатаПереоценки < ДАТАВРЕМЯ(2022, 1, 1, 0, 0, 0)
		|				ТОГДА ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -20)
		|			КОГДА &ДатаПереоценки < ДАТАВРЕМЯ(2024, 1, 1, 0, 0, 0)
		|				ТОГДА ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -21)
		|			ИНАЧЕ ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивныйРынокКотировки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_АктивныйРынокКотировки.Рынок КАК Рынок,
		|	_АктивныйРынокКотировки.Номинал КАК Номинал,
		|	_АктивныйРынокКотировки.ВалютаНоминала КАК ВалютаНоминала,
