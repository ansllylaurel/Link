			|			ТОГДА РасчетныеЦеныНРДСрезПоследних.Период
			|		КОГДА _ПервыйУровень.Цена ЕСТЬ NULL
			|				И Котировки_Bloomberg_BGN.CLOSE <> 0
			|				И (_ПервыйУровень.ВидАктива = ""ОВОЗРФиДР""
			|					ИЛИ ВЫРАЗИТЬ(_ПервыйУровень.ЦеннаяБумага КАК Справочник.Облигации).УчетныйАктивЦБРФ В (ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковНерезидентов), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковНерезидентовНеБумаги), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихНерезидентов), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихНерезидентовНеБумаги)))
			|			ТОГДА Котировки_Bloomberg_BGN.Период
			|		КОГДА _ПервыйУровень.Цена ЕСТЬ NULL
			|				И Котировки_Bloomberg_BVAL.CLOSE <> 0
			|				И (_ПервыйУровень.ВидАктива = ""ОВОЗРФиДР""
			|					ИЛИ ВЫРАЗИТЬ(_ПервыйУровень.ЦеннаяБумага КАК Справочник.Облигации).УчетныйАктивЦБРФ В (ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковНерезидентов), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковНерезидентовНеБумаги), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихНерезидентов), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихНерезидентовНеБумаги)))
			|			ТОГДА Котировки_Bloomberg_BVAL.Период
			|		ИНАЧЕ _ПервыйУровень.ДатаЦены
			|	КОНЕЦ КАК ДатаЦены,
			|	ВЫБОР
			|		КОГДА Котировки_Bloomberg_BGN.Валюта ЕСТЬ НЕ NULL 
			|			ТОГДА Котировки_Bloomberg_BGN.Валюта
			|		КОГДА Котировки_Bloomberg_BVAL.Валюта ЕСТЬ НЕ NULL 
			|			ТОГДА Котировки_Bloomberg_BVAL.Валюта
			|		ИНАЧЕ _ПервыйУровень.ВалютаКупона
			|	КОНЕЦ КАК ВалютаКупона,
			|	_ПервыйУровень.ОсновнойРежимТоргов КАК ОсновнойРежимТоргов,
			|	_ПервыйУровень.ВидАктива КАК ВидАктива
			|ПОМЕСТИТЬ _ВторойУровень
			|ИЗ
			|	_ПервыйУровень КАК _ПервыйУровень
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРДСрезПоследних
			|		ПО (&ДатаОценки = РасчетныеЦеныНРДСрезПоследних.Период)
			|			И _ПервыйУровень.Рынок = РасчетныеЦеныНРДСрезПоследних.Рынок
			|			И _ПервыйУровень.ЦеннаяБумага = РасчетныеЦеныНРДСрезПоследних.ЦеннаяБумага
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК Котировки_Bloomberg_BGN
			|		ПО (_ПервыйУровень.ВидАктива <> ""РоссийскиеЦБ"")
			|			И _ПервыйУровень.Рынок = Котировки_Bloomberg_BGN.Рынок
			|			И _ПервыйУровень.ЦеннаяБумага = Котировки_Bloomberg_BGN.ЦеннаяБумага
			|			И (Котировки_Bloomberg_BGN.Период = &ДатаОценки)
			|			И (Котировки_Bloomberg_BGN.Биржа = &Блумберг)
			|			И (Котировки_Bloomberg_BGN.РежимТоргов = &Режим_BGN)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК Котировки_Bloomberg_BVAL
			|		ПО (_ПервыйУровень.ВидАктива <> ""РоссийскиеЦБ"")
			|			И _ПервыйУровень.Рынок = Котировки_Bloomberg_BVAL.Рынок
			|			И _ПервыйУровень.ЦеннаяБумага = Котировки_Bloomberg_BVAL.ЦеннаяБумага
			|			И (Котировки_Bloomberg_BVAL.Период = &ДатаОценки)
			|			И (Котировки_Bloomberg_BVAL.Биржа = &Блумберг)
			|			И (Котировки_Bloomberg_BVAL.РежимТоргов = &Режим_BVAL)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ВторойУровень.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_ВторойУровень.Рынок КАК Рынок,
			|	_ВторойУровень.Номинал КАК Номинал,
			|	_ВторойУровень.ВалютаНоминала КАК ВалютаНоминала,
			|	ЕСТЬNULL(_ВторойУровень.Стоимость, 0) * ВЫБОР
			|		КОГДА _ВторойУровень.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|				И _ВторойУровень.Источник <> &НРД
			|			ТОГДА _ВторойУровень.Номинал / 100
			|		ИНАЧЕ 1
			|	КОНЕЦ КАК Стоимость,
			|	ЕСТЬNULL(_ВторойУровень.Источник, 0) КАК Источник,
			|	ЕСТЬNULL(_ВторойУровень.ДатаЦены, 0) КАК ДатаЦены,
			|	ЕСТЬNULL(_ВторойУровень.УровеньОценки, 0) КАК УровеньОценки,
			|	ЕСТЬNULL(_ВторойУровень.ВидЦены, 0) КАК ВидЦены,
			|	ЕСТЬNULL(_ВторойУровень.Купон, КотировкиЦенныхБумаг.ACCINT) КАК Купон,
			|	ВЫБОР
			|		КОГДА _ВторойУровень.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|			ТОГДА ВЫБОР
			|					КОГДА _ВторойУровень.Купон ЕСТЬ НЕ NULL 
			|						ТОГДА _ВторойУровень.ВалютаКупона
			|					ИНАЧЕ ВЫБОР
			|							КОГДА КотировкиЦенныхБумаг.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
			|								ТОГДА _ВторойУровень.ВалютаНоминала
			|							ИНАЧЕ КотировкиЦенныхБумаг.Валюта
			|						КОНЕЦ
			|				КОНЕЦ
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
			|	КОНЕЦ КАК ВалютаКупона,
			|	_ВторойУровень.ВалютаКотировок КАК ВалютаКотировок,
			|	_ВторойУровень.ВалютаКотировок КАК ВалютаКотировки,
			|	_ВторойУровень.ОсновнойРежимТоргов КАК ОсновнойРежимТоргов,
			|	_ВторойУровень.ВидАктива КАК ВидАктива
			|ИЗ
			|	_ВторойУровень КАК _ВторойУровень
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиЦенныхБумаг КАК КотировкиЦенныхБумаг
			|		ПО (_ВторойУровень.Купон ЕСТЬ NULL)
			|			И (КотировкиЦенныхБумаг.Период = &ДатаОценки)
			|			И _ВторойУровень.Рынок = КотировкиЦенныхБумаг.Рынок
			|			И _ВторойУровень.ЦеннаяБумага = КотировкиЦенныхБумаг.ЦеннаяБумага
			|			И (КотировкиЦенныхБумаг.Биржа = &ММВБ)");

		#КонецОбласти	
					                                                                 
		ДоступныеБиржи = Новый Массив;
		
		ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_LSE"));
		ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_NYSE"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_NYSE_Arca"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_HKEX"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_FRNK"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Amsterdam"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Brussels"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Lisbon"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_London"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Paris"));
		
		ОсновнойКалендарьКотировок	= Константы.ОсновнойКалендарьКотировок.Получить();
		ИностранныеУчетныеАктивы	= Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();	

		Запрос.УстановитьПараметр("ТаблицаСпискаЦБ",			ТаблицаЦБ);	       
		
		Запрос.УстановитьПараметр("ДатаОценки",					НачалоДня(ДатаПереоценки));	 	
		Запрос.УстановитьПараметр("ДатаОценкиБез10Дней",		Справочники.Календари.ДобавитьКДатеРабочиеДни(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки), -10));
		Запрос.УстановитьПараметр("ДатаОценкиБез30Дней",		Справочники.Календари.ДобавитьКДатеРабочиеДни(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки), -30));
		Запрос.УстановитьПараметр("ПоследнийТорговыйДень",		Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки)));
		
		Запрос.УстановитьПараметр("ММВБ",      					ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));			
		Запрос.УстановитьПараметр("Блумберг",  					ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
		Запрос.УстановитьПараметр("НРД",       					ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
		Запрос.УстановитьПараметр("Режим_BGN",					ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
		Запрос.УстановитьПараметр("Режим_BVAL",					ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
		
		Запрос.УстановитьПараметр("ДоступныеБиржи", 			ДоступныеБиржи);
		Запрос.УстановитьПараметр("ИностранныеУчетныеАктивы", 	ИностранныеУчетныеАктивы);
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены СЧА ЗПИФ 2018", "Таблица стоимостей ЦБ");		
		Иначе
			ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
		КонецЕсли;
		
		Если ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены Тогда
			Возврат ТаблицаСтоимостейЦБ;
		КонецЕсли;	
		
		// Расчетные цены	
		
		ТорговыхДнейНазад30	= Справочники.Календари.ДобавитьКДатеРабочиеДни(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки), -30);
		ВалютаРубли			= ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");
		
		КоэффициентыСущественныхСобытий = Новый Структура;
		КоэффициентыСущественныхСобытий.Вставить("ИзмененаКлючеваяСтавкаЦБРФ",			1);
		КоэффициентыСущественныхСобытий.Вставить("ВведеныСанкцииПротивЭмитента",		1);
		КоэффициентыСущественныхСобытий.Вставить("ЗначительныеТехногенныеКатастрофы",	1);
		КоэффициентыСущественныхСобытий.Вставить("ДефолтПоБумагамЭмитента",				1);	
		
		Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
			
			Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				Если СтрокаСтоимостейЦБ.Купон = NULL Тогда
					СтрокаСтоимостейЦБ.Купон 	= Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
					СтрокаСтоимостейЦБ.ВалютаКупона = СтрокаСтоимостейЦБ.ВалютаНоминала;
				КонецЕсли;
			КонецЕсли;
			
			Если СтрокаСтоимостейЦБ.УровеньОценки = 1 Тогда
				Продолжить;
			КонецЕсли;
			
			ЦеннаяБумага = СтрокаСтоимостейЦБ.ЦеннаяБумага;
			
			Если НЕ Справочники.Календари.ЭтоРабочийДень(Константы.ОсновнойКалендарьКотировок.Получить(), ДатаПереоценки) Тогда	
				
				#Область Расчет_основанный_на_изменениях_существенных_событий
				
				//проверить отсутсвие 
				
				ПараметрыПоискаЦены = Новый Структура("УровеньОценки", 1);
				
				ЦенаПредыдущегоРабочегоДня = ПолучитьПоследнююНаблюдаемуюЦенуСУчетомСущественныхСобытий(СтрокаСтоимостейЦБ.ЦеннаяБумага, ПараметрыОценки, ДатаПереоценки, ПараметрыПоискаЦены, КоэффициентыСущественныхСобытий, Отказ, РасшифровкаРасчета);
				
				Если ЦенаПредыдущегоРабочегоДня <> Неопределено Тогда
					
					СтрокаСтоимостейЦБ.Стоимость		= ЦенаПредыдущегоРабочегоДня.Стоимость;
					СтрокаСтоимостейЦБ.ВидЦены			= ЦенаПредыдущегоРабочегоДня.ВидЦены; 
					СтрокаСтоимостейЦБ.Источник			= ЦенаПредыдущегоРабочегоДня.Источник;
					СтрокаСтоимостейЦБ.УровеньОценки	= 2;
					СтрокаСтоимостейЦБ.ДатаЦены			= ЦенаПредыдущегоРабочегоДня.ДатаЦены;
					СтрокаСтоимостейЦБ.ВалютаКотировки	= ЦенаПредыдущегоРабочегоДня.ВалютаКотировки;					
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Использована цена предыдущего рабочего дня для "+ЦеннаяБумага+" за "+Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy")+". Проверьте коэффициенты!");
					
					Если РасшифровкаРасчета <> Неопределено Тогда
						РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Получить цены СЧА ЗПИФ УКПИ", "Цена предыдущего рабочего дня", ЦенаПредыдущегоРабочегоДня);
					КонецЕсли;
					
					Продолжить;
						
				КонецЕсли;						
				
				#КонецОбласти
				
			КонецЕсли;
				
			Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции
				ИЛИ (СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Паи 
					И ИностранныеУчетныеАктивы.Найти(ЦеннаяБумага.УчетныйАктивЦБРФ) <> Неопределено)
			Тогда

				#Область Расчет_на_основе_корректировки_исторической_цены					
				
				// Модель оценки, основанная на корректировке исторической цены (CAPM).
				// Применяем при отсутствии цены не более 30 рабочих дней
				
				ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, Справочники.Календари.Общероссийский, , , Отказ, РасшифровкаРасчета);  
				
				Если ЦенаЗаполнена Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Применена корректировка исторической цены для "+ЦеннаяБумага+" за "+Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy")+".");
					Продолжить;
				КонецЕсли;
				
				#КонецОбласти
				
			КонецЕсли;
			
			Если СтрокаСтоимостейЦБ.УровеньОценки = 2 Тогда
				Если СтрокаСтоимостейЦБ.Источник = ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg").ЮрФизЛицо
					И СтрокаСтоимостейЦБ.ВидЦены =  Перечисления.ИсточникиЦеныДляПереоценки.СредневзвешеннаяЦена
				Тогда
					//это BVAL
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Применена корректировка BVAL Bloomberg для "+ЦеннаяБумага+" за "+Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy")+". Убедитесь, что Score >= 6!");
				КонецЕсли;
				
				Продолжить;
			КонецЕсли;
			
			// Иностранные или ОВОЗРФ и др.
			Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Доли Тогда
				
				// не задан классификатор учетных активов ЦБ РФ
				
			ИначеЕсли ИностранныеУчетныеАктивы.Найти(ЦеннаяБумага.УчетныйАктивЦБРФ) <> Неопределено
				ИЛИ СтрокаСтоимостейЦБ.ВидАктива = "ОВОЗРФиДР"	
			Тогда // для иностранных и ОВОЗРФ

				#Область Расчет_основанный_на_изменениях_существенных_событий												
				
				ПараметрыПоискаЦены = Новый Структура("УровеньОценки", 2);
				
				ЦенаПредыдущегоРабочегоДня = ПолучитьПоследнююНаблюдаемуюЦенуСУчетомСущественныхСобытий(СтрокаСтоимостейЦБ.ЦеннаяБумага, ПараметрыОценки, ДатаПереоценки, ПараметрыПоискаЦены, КоэффициентыСущественныхСобытий, Отказ, РасшифровкаРасчета);
				
				Если ЦенаПредыдущегоРабочегоДня <> Неопределено Тогда
					
					Если ЦенаПредыдущегоРабочегоДня.Источник = ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg").ЮрФизЛицо Тогда 
						
						СтрокаСтоимостейЦБ.Стоимость		= ЦенаПредыдущегоРабочегоДня.Стоимость;
						СтрокаСтоимостейЦБ.ВидЦены			= ЦенаПредыдущегоРабочегоДня.ВидЦены; 
						СтрокаСтоимостейЦБ.Источник			= ЦенаПредыдущегоРабочегоДня.Источник;
						СтрокаСтоимостейЦБ.УровеньОценки	= 2;
						СтрокаСтоимостейЦБ.ДатаЦены			= ЦенаПредыдущегоРабочегоДня.ДатаЦены;
						СтрокаСтоимостейЦБ.ВалютаКотировки	= ЦенаПредыдущегоРабочегоДня.ВалютаКотировки;					
						
						Если РасшифровкаРасчета <> Неопределено Тогда
							РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Получить цены СЧА ЗПИФ 2018", "Цена предыдущего рабочего дня", ЦенаПредыдущегоРабочегоДня);
						КонецЕсли;

						Продолжить;
						
					КонецЕсли;
					
				КонецЕсли;						
				
				#КонецОбласти
			
		 	ИначеЕсли ИностранныеУчетныеАктивы.Найти(ЦеннаяБумага.УчетныйАктивЦБРФ) = Неопределено 
				И СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации
			Тогда					
				
				//нужно протянуть индикатор по бумаге. Пока отложено
				//Расчет_на_основе_корректировки_исторической_цены					

			КонецЕсли;

		КонецЦикла;
		
		#КонецОбласти
		
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда //И ПараметрыРасчетаЦен <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Получить цены СЧА ЗПИФ 2018", "С учетом параметров расчета цены", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
		
	Возврат ТаблицаСтоимостейЦБ;

КонецФункции

Функция ПолучитьЦеныБлагосостояния(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал,
		|	ТаблицаЦБ.Рынок,
		|	СУММА(ЕСТЬNULL(КотировкиТорговыхПлощадокАкции.NUMTRADES, 0)) КАК АкцииNUMTRADES,
		|	СУММА(ЕСТЬNULL(КотировкиТорговыхПлощадокАкции.VALUE, 0) * ВЫБОР
		|			КОГДА Валюты.Ссылка = &Рубли
		|				ТОГДА 1
		|			ИНАЧЕ КурсыВалют.Курс / КурсыВалют.Кратность
		|		КОНЕЦ) КАК АкцииVALUE,
		|	СУММА(ЕСТЬNULL(КотировкиТорговыхПлощадокОблигации.NUMTRADES, 0)) КАК ОблигацииNUMTRADES,
		|	СУММА(ЕСТЬNULL(КотировкиТорговыхПлощадокОблигации.VALUE, 0) * ВЫБОР
		|			КОГДА Валюты.Ссылка = &Рубли
		|				ТОГДА 1
		|			ИНАЧЕ КурсыВалют.Курс / КурсыВалют.Кратность
		|		КОНЕЦ) КАК ОблигацииVALUE,
		|	СУММА(ЕСТЬNULL(КотировкиТорговыхПлощадокПаи.NUMTRADES, 0)) КАК ПаиNUMTRADES,
		|	СУММА(ЕСТЬNULL(КотировкиТорговыхПлощадокПаи.VALUE, 0) * ВЫБОР
		|			КОГДА Валюты.Ссылка = &Рубли
		|				ТОГДА 1
		|			ИНАЧЕ КурсыВалют.Курс / КурсыВалют.Кратность
		|		КОНЕЦ) КАК ПаиVALUE,
		|	Валюты.Ссылка,
		|	КурсыВалют.Курс,
		|	КурсыВалют.Кратность,
		|	ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.КоличествоПаев, 0) * ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена, 0) КАК ОбъемВыпущенныхПаев,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КотировкиТорговыхПлощадокАкции.Период) КАК ТорговыеДниАкции
		|ПОМЕСТИТЬ АктивныйРынокММВБ_Котировки
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадокАкции
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадокАкции.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокАкции.ЦеннаяБумага
		|			И (КотировкиТорговыхПлощадокАкции.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции))
		|			И (КотировкиТорговыхПлощадокАкции.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадокАкции.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадокАкции.VALUE > 0)
		|			И (КотировкиТорговыхПлощадокАкции.Период МЕЖДУ &ТорговыхДнейНазад10 И &ДатаПереоценки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадокОблигации
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадокОблигации.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокОблигации.ЦеннаяБумага
		|			И (КотировкиТорговыхПлощадокОблигации.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))
		|			И (КотировкиТорговыхПлощадокОблигации.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадокОблигации.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадокОблигации.Период МЕЖДУ &ТорговыхДнейНазад21 И &ДатаПереоценки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадокПаи
		|		ПО ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокПаи.ЦеннаяБумага
		|			И (КотировкиТорговыхПлощадокПаи.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))
		|			И (КотировкиТорговыхПлощадокПаи.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадокПаи.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадокПаи.Период МЕЖДУ &ТорговыхДнейНазад63 И &ДатаПереоценки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПаевыеИнвестиционныеФонды КАК ПаевыеИнвестиционныеФонды
		|			ПО Паи.ПаевойИнвестиционныйФонд = ПаевыеИнвестиционныеФонды.Ссылка
		|				И (ПаевыеИнвестиционныеФонды.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Открытый))
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(&ДатаПереоценки, ) КАК РасчетныеЦеныПаевСрезПоследних
		|			ПО Паи.Ссылка = РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага
		|		ПО ((ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Паи)) = Паи.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|			ПО Валюты.Ссылка = КурсыВалют.Валюта
		|				И (КурсыВалют.Период = &ДатаПереоценки)
		|		ПО (КотировкиТорговыхПлощадокАкции.Валюта = Валюты.Ссылка
		|				ИЛИ КотировкиТорговыхПлощадокОблигации.Валюта = Валюты.Ссылка
		|				ИЛИ КотировкиТорговыхПлощадокПаи.Валюта = Валюты.Ссылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал,
		|	ТаблицаЦБ.Рынок,
		|	Валюты.Ссылка,
		|	КурсыВалют.Курс,
		|	КурсыВалют.Кратность,
		|	ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.КоличествоПаев, 0) * ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена, 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АктивныйРынокММВБ_Котировки.ЦеннаяБумага,
		|	АктивныйРынокММВБ_Котировки.Рынок,
		|	АктивныйРынокММВБ_Котировки.Номинал
		|ПОМЕСТИТЬ АктивныйРынокММВБ
		|ИЗ
		|	АктивныйРынокММВБ_Котировки КАК АктивныйРынокММВБ_Котировки
		|ГДЕ
		|	ВЫБОР
		|			КОГДА АктивныйРынокММВБ_Котировки.АкцииNUMTRADES >= 100
		|					И АктивныйРынокММВБ_Котировки.АкцииVALUE / ВЫБОР
		|						КОГДА АктивныйРынокММВБ_Котировки.ТорговыеДниАкции = 0
		|							ТОГДА 1
		|						ИНАЧЕ АктивныйРынокММВБ_Котировки.ТорговыеДниАкции
		|					КОНЕЦ >= 1000000
		|				ТОГДА ИСТИНА
		|			КОГДА АктивныйРынокММВБ_Котировки.ОблигацииNUMTRADES >= 5
		|					И АктивныйРынокММВБ_Котировки.ОблигацииVALUE >= 1000000
		|				ТОГДА ИСТИНА
		|			КОГДА АктивныйРынокММВБ_Котировки.ПаиVALUE / ВЫБОР
		|					КОГДА ЕСТЬNULL(АктивныйРынокММВБ_Котировки.ОбъемВыпущенныхПаев, 0) = 0
		|						ТОГДА 1
		|					ИНАЧЕ АктивныйРынокММВБ_Котировки.ОбъемВыпущенныхПаев
		|				КОНЕЦ > 0.01
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.Рынок,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КотировкиТорговыхПлощадок.Период) КАК Период
		|ПОМЕСТИТЬ АктивныйРынокБлумберг
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО ((ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации)) = (ВЫРАЗИТЬ(КотировкиТорговыхПлощадок.ЦеннаяБумага КАК Справочник.Облигации)))
		|			И (КотировкиТорговыхПлощадок.Период МЕЖДУ &ТорговыхДнейНазад21 И &ДатаПереоценки)
		|			И (КотировкиТорговыхПлощадок.CLOSE <> 0)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов = &Режим_BGN)
		|ГДЕ
		|	ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.Рынок
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КотировкиТорговыхПлощадок.Период) >= 10
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал,
		|	ТаблицаЦБ.Рынок,
		|	ВЫБОР
		|		КОГДА АктивныйРынокММВБ.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|			ТОГДА ВЫБОР
		|					КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследнихММВБ.BID <= КотировкиТорговыхПлощадокСводныеСрезПоследнихММВБ.WAPRICE
		|							И КотировкиТорговыхПлощадокСводныеСрезПоследнихММВБ.WAPRICE <= КотировкиТорговыхПлощадокСводныеСрезПоследнихММВБ.OFFER
		|						ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследнихММВБ.WAPRICE
		|					ИНАЧЕ 0
		|				КОНЕЦ
		|		КОГДА РасчетныеЦеныПаевСрезПоследних.Период ЕСТЬ НЕ NULL 
		|			ТОГДА РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена
		|		КОГДА АктивныйРынокБлумберг.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследнихБлумберг.CLOSE
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СправедливаяЦена,
		|	ВЫБОР
		|		КОГДА АктивныйРынокММВБ.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|			ТОГДА ВЫБОР
		|					КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследнихММВБ.BID <= КотировкиТорговыхПлощадокСводныеСрезПоследнихММВБ.WAPRICE
		|							И КотировкиТорговыхПлощадокСводныеСрезПоследнихММВБ.WAPRICE <= КотировкиТорговыхПлощадокСводныеСрезПоследнихММВБ.OFFER
		|						ТОГДА 1
		|					ИНАЧЕ 0
		|				КОНЕЦ
		|		КОГДА РасчетныеЦеныПаевСрезПоследних.Период ЕСТЬ НЕ NULL 
		|			ТОГДА 1
		|		КОГДА АктивныйРынокБлумберг.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УровеньОценки,
		|	ВЫБОР
		|		КОГДА АктивныйРынокММВБ.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|			ТОГДА ВЫБОР
		|					КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследнихММВБ.BID <= КотировкиТорговыхПлощадокСводныеСрезПоследнихММВБ.WAPRICE
		|							И КотировкиТорговыхПлощадокСводныеСрезПоследнихММВБ.WAPRICE <= КотировкиТорговыхПлощадокСводныеСрезПоследнихММВБ.OFFER
		|						ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследнихММВБ.WAPRICE_DATE
		|					ИНАЧЕ 0
		|				КОНЕЦ
