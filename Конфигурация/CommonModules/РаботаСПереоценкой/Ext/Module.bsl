	#КонецОбласти

	ДанныеПокупкиДляДисконтПремии.Вставить("НачальныйДисконт",	СтрокаПокупки.НачальныйДисконт);
	ДанныеПокупкиДляДисконтПремии.Вставить("ДатаПокупки",		СтрокаПокупки.ДатаПокупкиНачальная);
	ДанныеПокупкиДляДисконтПремии.Вставить("ЦенаПокупки",		СтрокаПокупки.ЦенаПокупкиНачальная);
	
	ДанныеПереоценкиДляДисконтПремии.Вставить("ДатаПереоценки",					КонецДня(ДатаПереоценки));
	ДанныеПереоценкиДляДисконтПремии.Вставить("Количество",						СтрокаЦенныеБумаги.Количество);
	ДанныеПереоценкиДляДисконтПремии.Вставить("СчетДоверительногоУправления",	ПараметрыОценки.СчетДоверительногоУправления);
	ДанныеПереоценкиДляДисконтПремии.Вставить("УчетныйАктивЕПС",				СтрокаЦенныеБумаги.УчетныйАктивЕПС);	
	
	// Некоторые методики в день покупки оценивают по СС, увеличенной на затраты, непосредственно связанные с приобретением актива
	
	МетодикиСОценкойПоССВДеньПокупки = Новый Массив;
	
	Если ДатаПереоценки >= '20220101' Тогда
		МетодикиСОценкойПоССВДеньПокупки.Добавить(Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020_2);
		МетодикиСОценкойПоССВДеньПокупки.Добавить(Справочники.ВариантыРасчетаОценочнойСтоимости.Аквилон2021);
	КонецЕсли;	
	
	// В день покупки не учитываются заведенные корректировкой регистра
	// значения НачальнаяРазницаППНеНаблюдаемыеДанные и БалансоваяРазницаППНеНаблюдаемыеДанные.
	// Поэтому сделаю небольшой трюк, если он хорошо себя покажет, то растиражирую его для избавления от хардкода сумм
	
	Если НачалоДня(ДатаПереоценки) = '20220224'		// #417210
		ИЛИ НачалоДня(ДатаПереоценки) = '20220707'	// #437488
	Тогда
	
		#Область Заполнение_разницы_первоначального_признания_из_корректировки_регистра
			
		Если Не ДополнительныеСвойства.Свойство("КорректировкиРегистра") Тогда
			
			#Область Получаем_корректировки_регистра_в_день_оценки
			
			Запрос = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ПартииЦенныхБумаг.Партия КАК Партия,
				|	ПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
				|	СУММА(ВЫБОР
				|			КОГДА ПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
				|				ТОГДА ПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная
				|			ИНАЧЕ -ПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная
				|		КОНЕЦ) КАК НачальнаяРазницаППНеНаблюдаемыеДанные,
				|	СУММА(ВЫБОР
				|			КОГДА ПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
				|				ТОГДА ПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета
				|			ИНАЧЕ -ПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета
				|		КОНЕЦ) КАК БалансоваяРазницаППНеНаблюдаемыеДанные
				|ИЗ
				|	РегистрНакопления.БухПартииЦенныхБумаг КАК ПартииЦенныхБумаг
				|ГДЕ
				|	ТИПЗНАЧЕНИЯ(ПартииЦенныхБумаг.Регистратор) = ТИП(Документ.КорректировкаРегистров)
				|	И ПартииЦенныхБумаг.Организация = &Организация
				|	И ПартииЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
				|	И ПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
				|	И ПартииЦенныхБумаг.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
				|	И ПартииЦенныхБумаг.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
				|	И ПартииЦенныхБумаг.Активность
				|
				|СГРУППИРОВАТЬ ПО
				|	ПартииЦенныхБумаг.Партия,
				|	ПартииЦенныхБумаг.СтрокаПартии");
			
			Запрос.УстановитьПараметр("Организация",					ПараметрыОценки.Организация);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ПараметрыОценки.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("Период",							ДатаПереоценки);
		
		    ДополнительныеСвойства.Вставить("КорректировкиРегистра", Запрос.Выполнить().Выгрузить());
			
