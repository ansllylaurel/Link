// Заполняет строку переоценки по данным размещения
//
// Параметры:
//	СтрокаПереоценкиЦБ - СтрокаТаблицыЗначений, Структура - строка таблицы значений как в ТЧ Документ.ПереоценкаЦенныхБумаг, либо структура с аналогичными ключами 
//	ДатаПереоценки - Дата - дата переоценки
//	ПараметрыОценки - Структура - см. РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС
//	УсловияПрименения - Структура - условия применения цены размещения. Возможные ключи структуры:
//		ПриоритетыЦен - Строка, Массив - Строка преобразуется в массив по разделителю ", "
//   		Значения массива должны быть типа Перечисление.ИсточникиЦеныДляПереоценки, Строка:
// 	 			Если Строка, то либо имя значения перечисления ИсточникиЦеныДляПереоценки, либо:
//   				ЛюбаяЦена - любая цена
//   				Цена1Уровня - любая цена с уровнем оценки 1
//  				БиржеваяЦена - любая цена с источником цены ММВБ
//					ЦенаБлумберг - любая цена с источником цены Блумберг
//				Если значение массива заканчивается на "_1уровень", "_2уровень" и т.п., то в приоритете цены соответствующего уровня
//			Если приоритет не задан, значит по методике подходит любая цена
//      КоличествоДней - Число, Строка -
//			Если Число - количество дней, в течении которых разрешено брать цену размещения в соответствии с ключом Календарь
//			Если Строка, то предопределеное значение "МесяцОтНачалаОбращения" - месяц от свойства ДатаНачалаОбращения облигации
//		Календарь - СправочникСсылка.Календари, Неопределено - в зависимости от значения: 
//			Общероссийский календарь - количество рабочих дней
//			Календарь котировок - количество торговых дней
//			Неопределено - количество календарных дней
//		Аукцион - Булево - в зависимости от значения:
//			Истина - бумага должна быть приобретена на аукционе
//			Ложь - бумага не должна быть приобретена на аукционе
//		ОтсутствиеСделокСНачалаРазмещения - Булево - проверяет отсутствие сделок на бирже в основном режиме торгов с даты размещения до даты переоценки (включительно)
//		ОтсутствиеЦенАктивногоРынкаСНачалаРазмещения - Булево - проверяет отсутствие цен 1 уровня в оценках с даты размещения до даты переоценки
//		ОтсутствиеПартийКупленныхНаВторичномРынкеВДеньПриобретенияНаПервичномРазмещении - Булево - проверяет отсутствие в портфеле партий бумаги, купленных на вторичном рынке в день приобретения бумаги на первичном размещении
//		ОтсутствиеЦенНРДСНачалаРазмещения - Булево - проверяет отсутствие цен НРД в оценках с даты размещения до даты переоценки
//	ПараметрыЦены - Структура - при применении цены размещения СтрокаПереоценкиЦБ заполняется значениями этой структуры.
//		Также в соответствии со значениями ключей выполняется расчет цены:
//			ПропорциональноИзменениюКлючевойСтавки - Булево - цена будет скорректирована пропорционально изменению ключевой ставки ЦБ РФ
//	Отказ - Булево - выходной параметр, при ошибке устанавливается в значение Истина
//	РасшифровкаРасчета - 
//
Функция ЗаполнитьПервичноеРазмещение(СтрокаПереоценкиЦБ, ДатаПереоценки, ПараметрыОценки, УсловияПрименения, ПараметрыЦены = Неопределено, Отказ = Ложь, РасшифровкаРасчета = Неопределено)
	
	// Подготовка параметров
	
	#Область Проверка_и_обработка_входящих_параметров

	Если Не ЗначениеЗаполнено(СтрокаПереоценкиЦБ.Партия) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПараметрыЦены = Неопределено Тогда
		ПараметрыЦены = Новый Структура;
	КонецЕсли;
	
	Если Не УсловияПрименения.Свойство("ПриоритетыЦен") Тогда
		ПриоритетыЦен = Новый Массив;
	ИначеЕсли ТипЗнч(УсловияПрименения.ПриоритетыЦен) = Тип("Строка") Тогда
		ПриоритетыЦен = СтрРазделить(УсловияПрименения.ПриоритетыЦен, ", ", Ложь);
	ИначеЕсли ТипЗнч(УсловияПрименения.ПриоритетыЦен) = Тип("Массив") Тогда
		ПриоритетыЦен = УсловияПрименения.ПриоритетыЦен;
	Иначе
		ВызватьИсключение "Некорректное значение параметра 'УсловияПрименения.ПриоритетыЦен'";
	КонецЕсли;

	Если ПриоритетыЦен.Количество() = 0 Тогда
		ПриоритетыЦен.Добавить("ЛюбаяЦена");	
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		ПараметрыРасчетаЦен = Новый Структура("ПриоритетЦеныРазмещения", СтрСоединить(ПриоритетыЦен, ", "));
		РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, СтрШаблон("Проверка цены размещения '%1 (строка %2)'", СтрокаПереоценкиЦБ.Партия, СтрокаПереоценкиЦБ.СтрокаПартии), , , Истина);
	КонецЕсли;	
	
	#КонецОбласти
	
	// Проверка приоритета цены размещения
	
	Если ЗначениеЗаполнено(СтрокаПереоценкиЦБ.РыночнаяЦена) Тогда
		
		#Область Проверка_приоритета_цены_размещения
	
		ПроверкаПриоритетаЦеныПройдена = Истина;
		
		Для Каждого ВидПриоритетнойЦены Из ПриоритетыЦен Цикл
			
			// Если указаны дополнительные параметры цены, то нужно учесть и их
			
			УровеньПриоритетнойЦены = Неопределено;
			
			Если ТипЗнч(ВидПриоритетнойЦены) = Тип("Строка") И СтрНайти(ВидПриоритетнойЦены, "_") > 0 Тогда
				
				ПараметрыПриоритетнойЦены = СтрРазделить(ВидПриоритетнойЦены, "_");
				
				НеобработанныеПараметры = Новый Массив;
				
				Для Каждого ПараметрПриоритетнойЦены Из ПараметрыПриоритетнойЦены Цикл
					Если СтрЗаканчиваетсяНа(НРег(ПараметрПриоритетнойЦены), "уровень") Тогда
						УровеньПриоритетнойЦены = Цел(Лев(ПараметрПриоритетнойЦены, СтрДлина(ПараметрПриоритетнойЦены) - СтрДлина("уровень")));
					Иначе
						НеобработанныеПараметры.Добавить(ПараметрПриоритетнойЦены);
					КонецЕсли;
				КонецЦикла;
				
				ВидПриоритетнойЦены = СтрСоединить(НеобработанныеПараметры, "_");
				
			КонецЕсли;
			
			// Если указана строка, поищем ее в значениях перечисления
			
			Если Метаданные.Перечисления.ИсточникиЦеныДляПереоценки.ЗначенияПеречисления.Найти(ВидПриоритетнойЦены) <> Неопределено Тогда
				ВидПриоритетнойЦены = Перечисления.ИсточникиЦеныДляПереоценки[ВидПриоритетнойЦены];
			КонецЕсли;
			
			// Проверка по виду текущей цены
			
			НайденаБолееПриоритетнаяЦена = Ложь;
			
			Если ВидПриоритетнойЦены = Перечисления.ИсточникиЦеныДляПереоценки.ЦенаПриобретения Тогда
				
				Прервать;
				
			ИначеЕсли ВидПриоритетнойЦены = "ЛюбаяЦена" Тогда
				
				НайденаБолееПриоритетнаяЦена = Истина;
				
			ИначеЕсли ВидПриоритетнойЦены = "Цена1Уровня" Тогда
				
				Если СтрокаПереоценкиЦБ.УровеньОценки = 1 Тогда
					НайденаБолееПриоритетнаяЦена = Истина;
				КонецЕсли;
				
			ИначеЕсли ВидПриоритетнойЦены = "БиржеваяЦена" Тогда
				
				Если ЗначениеЗаполнено(СтрокаПереоценкиЦБ.ИсточникЦены) Тогда

					ММВБ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
					Если ЗначениеЗаполнено(ММВБ) И СтрокаПереоценкиЦБ.ИсточникЦены = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ММВБ, "ЮрФизЛицо") Тогда
						НайденаБолееПриоритетнаяЦена = Истина;
					КонецЕсли;

				КонецЕсли;
					
			ИначеЕсли ВидПриоритетнойЦены = "ЦенаБлумберг" Тогда
				
				Если ЗначениеЗаполнено(СтрокаПереоценкиЦБ.ИсточникЦены) Тогда
				
					Блумберг = ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");			
					Если ЗначениеЗаполнено(Блумберг) И СтрокаПереоценкиЦБ.ИсточникЦены = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Блумберг, "ЮрФизЛицо") Тогда
						НайденаБолееПриоритетнаяЦена = Истина;
					КонецЕсли;

				КонецЕсли;

			ИначеЕсли ТипЗнч(ВидПриоритетнойЦены) = Тип("ПеречислениеСсылка.ИсточникиЦеныДляПереоценки") Тогда
				
				Если СтрокаПереоценкиЦБ.ПолеЦены = ВидПриоритетнойЦены Тогда
					НайденаБолееПриоритетнаяЦена = Истина;
				КонецЕсли;
				
			Иначе
				
				ВызватьИсключение "Некорректный вид цены " + ВидПриоритетнойЦены;
				
			КонецЕсли;
			
			// Проверка по уровню цены
			
			Если НайденаБолееПриоритетнаяЦена И УровеньПриоритетнойЦены <> Неопределено Тогда
					
				Если ЗначениеЗаполнено(СтрокаПереоценкиЦБ.УровеньОценки)
					И СтрокаПереоценкиЦБ.УровеньОценки > УровеньПриоритетнойЦены
				Тогда
					НайденаБолееПриоритетнаяЦена = Ложь;
				КонецЕсли;
				
			КонецЕсли;
			
			// Если найдена более приоритетная цена, значит проверку по приоритету не прошли
			
			Если НайденаБолееПриоритетнаяЦена Тогда
				ПроверкаПриоритетаЦеныПройдена = Ложь;
				Прервать;
			КонецЕсли;

		КонецЦикла;
	
		// Сообщаем, если проверка не прошла
	
		Если Не ПроверкаПриоритетаЦеныПройдена Тогда
			Если РасшифровкаРасчета <> Неопределено Тогда
				ПараметрыРасчетаЦен.Вставить("ПроверкаПриоритетаЦеныПройдена", "Найдена цена приоритетнее цены размещения");
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Параметры оценки", ПараметрыРасчетаЦен, Истина);
			КонецЕсли;
			Возврат Ложь;
		КонецЕсли;
	
		#КонецОбласти

	КонецЕсли;
	
	// Проверка, что это сделка с первичным размещением
	
	#Область Получение_свойств_сделки_с_первичным_размещением
	
	Если ПараметрыОценки.Свойство("СделкиСПервичнымРазмещением") Тогда
		СделкиСПервичнымРазмещением = ПараметрыОценки.СделкиСПервичнымРазмещением;
	ИначеЕсли ТипЗнч(СтрокаПереоценкиЦБ) = Тип("СтрокаТаблицыЗначений") Тогда
		СделкиСПервичнымРазмещением = ПолучитьСделкиСПервичнымРазмещениемЦенныхБумаг(СтрокаПереоценкиЦБ.Владелец());
		ПараметрыОценки.Вставить("СделкиСПервичнымРазмещением", СделкиСПервичнымРазмещением);
	Иначе
		СделкиСПервичнымРазмещением = Неопределено;
	КонецЕсли;
		
	Если СделкиСПервичнымРазмещением = Неопределено Тогда	
		СвойстваСделки = ПолучитьСвойстваСделкиСПервичнымРазмещениемЦенныхБумаг(СтрокаПереоценкиЦБ.Партия);
	Иначе
		СвойстваСделки = СделкиСПервичнымРазмещением.Найти(СтрокаПереоценкиЦБ.Партия, "Партия");
	КонецЕсли;

	Если СвойстваСделки = Неопределено Тогда
		Если РасшифровкаРасчета <> Неопределено Тогда
			ПараметрыРасчетаЦен.Вставить("ПроверкаСделки", "Сделка '" + Строка(СтрокаПереоценкиЦБ.Партия) + "' не совершена на размещении");
			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Параметры оценки", ПараметрыРасчетаЦен, Истина);
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	#КонецОбласти
		
	// Два варианта проверки срока давности:
	// 1. если нужно попасть в период размещения (например, месяц от начала обращения или на этапе размещения)
	// 2. количество дней с даты приобретения

	ДатаРазмещения = ПолучитьДатуРазмещенияЦеннойБумаги(СтрокаПереоценкиЦБ.ЦеннаяБумага, СвойстваСделки.Дата);

	#Область Проверка_срока_давности	
	
	КоличествоДней = ?(УсловияПрименения.Свойство("КоличествоДней"), УсловияПрименения.КоличествоДней, Неопределено);
	
	Если КоличествоДней = "МесяцОтНачалаОбращения" Тогда
		
		ОцениватьПоРазмещениюДо = ДобавитьМесяц(СтрокаПереоценкиЦБ.ЦеннаяБумага.ДатаНачалаОбращения, 1) - 86400;
		
		ПроверкаСрокаДавностиПройдена = (ДатаПереоценки <= ОцениватьПоРазмещениюДо);	
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			РаботаСКоллекциями.ДополнитьСтруктуру(ПараметрыРасчетаЦен, Новый Структура("СрокОценки, ДатаНачалаОбращения, ОцениватьПоРазмещениюДо",
				"Месяц от начала обращения", СтрокаПереоценкиЦБ.ЦеннаяБумага.ДатаНачалаОбращения, ОцениватьПоРазмещениюДо), Истина);	
		КонецЕсли;
		
	Иначе
			
		// С даты размещения не прошло [КоличествоДней] рабочих/торговых/календарных дней.
		// Проверяем срок давности от даты переоценки, а не от даты сделки,
		// т.к. рабочий календарь для старых сделок может быть не заведен (например, у ППА бумага куплена в 2013 году)
		
		Календарь = ?(УсловияПрименения.Свойство("Календарь"), УсловияПрименения.Календарь, Неопределено);
		
		Если ЗначениеЗаполнено(Календарь) Тогда
			ОцениватьПоРазмещениюС = Справочники.Календари.ДобавитьКДатеРабочиеДни(Календарь, ДатаПереоценки, -КоличествоДней);
		Иначе
			ОцениватьПоРазмещениюС = ДатаПереоценки - КоличествоДней * 86400;
		КонецЕсли;
		
		ПроверкаСрокаДавностиПройдена = (ОцениватьПоРазмещениюС <= ДатаРазмещения);	
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			ВидКалендаря = ?(Календарь = Неопределено, "календарных", ?(Календарь = Справочники.Календари.Общероссийский, "рабочих", "торговых"));
			РаботаСКоллекциями.ДополнитьСтруктуру(ПараметрыРасчетаЦен, Новый Структура("СрокОценки, ДатаРазмещения, ОцениватьПоРазмещениюС",
				"В течение " + Строка(КоличествоДней) + " " + ВидКалендаря + " дней с даты размещения", ДатаРазмещения, ОцениватьПоРазмещениюС), Истина);	
		КонецЕсли;
		
	КонецЕсли;
	
	// Сообщаем, если проверка не прошла
	
	Если Не ПроверкаСрокаДавностиПройдена Тогда
		Если РасшифровкаРасчета <> Неопределено Тогда
			ПараметрыРасчетаЦен.Вставить("ПроверкаСрокаДавности", "Срок оценки по размещению истек");
			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Параметры оценки", ПараметрыРасчетаЦен, Истина);
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	#КонецОбласти

	// На аукционе или нет проверяем только после проверки срока давности,
	// т.к. у древних сделок РежимБиржевыхТоргов, из которого берется Аукцион, не заполнялся

	Аукцион = ?(УсловияПрименения.Свойство("Аукцион"), УсловияПрименения.Аукцион, Неопределено);
	
	Если Аукцион <> Неопределено Тогда
		
		#Область Проверка_совершения_сделки_на_аукционе
		
		ПроверкаСделкиНаАкционе = Истина;
		
		Если ТипЗнч(СвойстваСделки.Аукцион) <> Тип("Булево") Тогда
			Если СвойстваСделки.МестоХранения <> Справочники.МестаХранения.ВнебиржевойРынок Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось проверить совершение сделки '%1' на аукционе", СвойстваСделки.Сделка), СвойстваСделки.Сделка, , , Отказ);
			КонецЕсли;
			ПроверкаСделкиНаАкционе = Ложь;
		ИначеЕсли СвойстваСделки.Аукцион <> Аукцион Тогда
			ПроверкаСделкиНаАкционе = Ложь;
		КонецЕсли;
		
		Если Не ПроверкаСделкиНаАкционе Тогда
			Если РасшифровкаРасчета <> Неопределено Тогда
				РаботаСКоллекциями.ДополнитьСтруктуру(ПараметрыРасчетаЦен, Новый Структура("ПроверкаАукциона, РезультатПроверки",
					Формат(Аукцион, "БЛ='Не должна быть на аукционе'; БИ='Должна быть на аукционе'"),
					Формат(Аукцион, "БЛ='Сделка совершена на аукционе'; БИ='Сделка не совершена на аукционе'")), Истина);	
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Параметры оценки", ПараметрыРасчетаЦен, Истина);
			КонецЕсли;
			Возврат Ложь;
		КонецЕсли;
		
		#КонецОбласти

	КонецЕсли;
	
	// В случае, когда выпуск ценных бумаг приобретен на бирже в день первичного размещения,
	// а также этот же выпуск приобретен в тот же день на вторичном рынке после первичного размещения,
	// то данный выпуск бумаг оценивается в день покупки в общем порядке по справедливой стоимости

	ПроверитьОтсутствиеПартийКупленныхНаВторичномРынкеВДеньПриобретенияНаПервичномРазмещении = УсловияПрименения.Свойство("ОтсутствиеПартийКупленныхНаВторичномРынкеВДеньПриобретенияНаПервичномРазмещении") И УсловияПрименения.ОтсутствиеПартийКупленныхНаВторичномРынкеВДеньПриобретенияНаПервичномРазмещении; 
	
	Если ПроверитьОтсутствиеПартийКупленныхНаВторичномРынкеВДеньПриобретенияНаПервичномРазмещении Тогда
		
		#Область Проверка_отсутствия_партий_купленных_на_вторичном_рынке_в_день_приобретения_на_первичном_размещении
		
		Если Не ПараметрыОценки.Свойство("СделкиСовершенныеНаВторичномРынке") Тогда
			
			#Область Получение_сделок_совершенных_на_вторичном_рынке
			
			Запрос = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	СделкиСПервичнымРазмещением.Сделка КАК Сделка
				|ПОМЕСТИТЬ _СделкиСПервичнымРазмещением
				|ИЗ
				|	&СделкиСПервичнымРазмещением КАК СделкиСПервичнымРазмещением
				|
				|ИНДЕКСИРОВАТЬ ПО
				|	Сделка
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	УсловияСделок.Сделка КАК Сделка,
				|	УсловияСделок.ЦеннаяБумага КАК ЦеннаяБумага,
				|	НАЧАЛОПЕРИОДА(УсловияСделок.Период, ДЕНЬ) КАК ДатаСделки
				|ИЗ
				|	РегистрСведений.УсловияСделок КАК УсловияСделок
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделок КАК УсловияСделокСПервичнымРазмещением
				|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СделкиСПервичнымРазмещением КАК _СделкиСПервичнымРазмещением
				|			ПО УсловияСделокСПервичнымРазмещением.Регистратор = _СделкиСПервичнымРазмещением.Сделка
				|		ПО УсловияСделок.Организация = УсловияСделокСПервичнымРазмещением.Организация
				|			И УсловияСделок.СчетДоверительногоУправления = УсловияСделокСПервичнымРазмещением.СчетДоверительногоУправления
				|			И УсловияСделок.Рынок = УсловияСделокСПервичнымРазмещением.Рынок
				|			И УсловияСделок.ЦеннаяБумага = УсловияСделокСПервичнымРазмещением.ЦеннаяБумага
				|			И (ТИПЗНАЧЕНИЯ(УсловияСделок.Регистратор) = ТИП(Документ.Сделка))
				|			И (НАЧАЛОПЕРИОДА(УсловияСделок.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(УсловияСделокСПервичнымРазмещением.Период, ДЕНЬ))
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК ДокументСделка
				|		ПО (ДокументСделка.Ссылка = УсловияСделок.Сделка)
				|			И (ДокументСделка.РежимБиржевыхТоргов В
				|				(ВЫБРАТЬ
				|					РежимыБиржевыхТоргов.Ссылка
				|				ИЗ
				|					Справочник.РежимыБиржевыхТоргов КАК РежимыБиржевыхТоргов
				|				ГДЕ
				|					РежимыБиржевыхТоргов.ПервичноеРазмещение = ЛОЖЬ))");

			Запрос.УстановитьПараметр("СделкиСПервичнымРазмещением", СделкиСПервичнымРазмещением);

			СделкиСовершенныеНаВторичномРынке = Запрос.Выполнить().Выгрузить();
			СделкиСовершенныеНаВторичномРынке.Индексы.Добавить("ЦеннаяБумага, ДатаСделки");
			
			ПараметрыОценки.Вставить("СделкиСовершенныеНаВторичномРынке", СделкиСовершенныеНаВторичномРынке);
			
			#КонецОбласти
			
		КонецЕсли;	
		
		СделкиПоБумагеСовершенныеНаВторичномРынке = ПараметрыОценки.СделкиСовершенныеНаВторичномРынке.НайтиСтроки(Новый Структура("ЦеннаяБумага, ДатаСделки", СтрокаПереоценкиЦБ.ЦеннаяБумага, НачалоДня(СвойстваСделки.Дата)));
		
		Если СделкиПоБумагеСовершенныеНаВторичномРынке.Количество() > 0 Тогда

			Если РасшифровкаРасчета <> Неопределено Тогда
				РаботаСКоллекциями.ДополнитьСтруктуру(ПараметрыРасчетаЦен, Новый Структура("СделкаСовершеннаяНаВторичномРынке, Описание",
					СделкиПоБумагеСовершенныеНаВторичномРынке[0].Сделка, "Цену размещения использовать нельзя в связи с наличием партий, купленных на вторичном рынке в день приобретения на первичном размещении"));
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Проверка отсутствия партий, купленных на вторичном рынке", ПараметрыРасчетаЦен);
			КонецЕсли;

			Возврат Ложь;

		КонецЕсли;		
		
		#КонецОбласти
		
	КонецЕсли;	
	
	// Цену размещения допускается брать при отсутствии вторичного обращения на бирже.
	// Моментом начала вторичного обращения следует считать совершение первой сделки на бирже
	
	ПроверитьОтсутствиеСделокСНачалаРазмещения = УсловияПрименения.Свойство("ОтсутствиеСделокСНачалаРазмещения") И УсловияПрименения.ОтсутствиеСделокСНачалаРазмещения;
	
	Если ПроверитьОтсутствиеСделокСНачалаРазмещения Тогда
		
		#Область Проверка_отсутствия_сделок_в_основном_режиме_торгов_с_момента_размещения
		
		// Основной режим торгов возможен только на бирже,
		// поэтому дополнительные фильтры для не бирж (например, bloomberg) не нужны 
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	КотировкиТорговыхПлощадок.Период КАК Период,
			|	КотировкиТорговыхПлощадок.Биржа КАК Биржа,
			|	КотировкиТорговыхПлощадок.РежимТоргов КАК РежимТоргов
			|ИЗ
			|	РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
			|ГДЕ
			|	КотировкиТорговыхПлощадок.ЦеннаяБумага = &ЦеннаяБумага
			|	И КотировкиТорговыхПлощадок.Рынок = &Рынок
			|	И КотировкиТорговыхПлощадок.Период МЕЖДУ &ДатаРазмещения И &ДатаПереоценки
			|	И КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим
			|	И КотировкиТорговыхПлощадок.NUMTRADES > 0
			|
			|УПОРЯДОЧИТЬ ПО
			|	Период");
		
		Запрос.УстановитьПараметр("ЦеннаяБумага",	СтрокаПереоценкиЦБ.ЦеннаяБумага);
		Запрос.УстановитьПараметр("Рынок",			СтрокаПереоценкиЦБ.Рынок);
		Запрос.УстановитьПараметр("ДатаПереоценки",	ДатаПереоценки);
		Запрос.УстановитьПараметр("ДатаРазмещения",	ДатаРазмещения);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() Тогда

			Если РасшифровкаРасчета <> Неопределено Тогда
				СведенияОСделке = РезультатЗапроса.Выгрузить()[0];
				РаботаСКоллекциями.ДополнитьСтруктуру(ПараметрыРасчетаЦен, Новый Структура("ДатаПервойСделки, Биржа, РежимТоргов, Описание",
					Формат(СведенияОСделке.Период, "ДФ=dd.MM.yyyy"), СведенияОСделке.Биржа, СведенияОСделке.РежимТоргов, "Цену размещения использовать нельзя в связи с началом вторичного обращения"), Истина);	
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Проверка отсутствия сделок", ПараметрыРасчетаЦен);
			КонецЕсли;

			Возврат Ложь;

		КонецЕсли;		
		
		#КонецОбласти
		
	КонецЕсли;	
	
	// С даты появления цен, позволяющих произвести оценку по данным активного основного рынка,
	// справедливая стоимость определяется в общем порядке
	
	ПроверитьОтсутствиеЦенАктивногоРынкаСНачалаРазмещения = УсловияПрименения.Свойство("ОтсутствиеЦенАктивногоРынкаСНачалаРазмещения") И УсловияПрименения.ОтсутствиеЦенАктивногоРынкаСНачалаРазмещения;
	
	Если ПроверитьОтсутствиеЦенАктивногоРынкаСНачалаРазмещения Тогда
		
		#Область Проверка_отсутствия_цен_активного_рынка_в_предыдущей_переоценке
		
		ЗапросСтоимостиНаПредыдущуюПереоценку = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	СтоимостьПереоценки.Период КАК Период,
			|	СтоимостьПереоценки.ВидЦены КАК ВидЦены,
			|	СтоимостьПереоценки.УровеньОценки КАК УровеньОценки
			|ИЗ
			|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
			|ГДЕ
			|	СтоимостьПереоценки.Организация = &Организация
			|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета
			|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
			|	И СтоимостьПереоценки.Рынок = &Рынок
			|	И СтоимостьПереоценки.ЦеннаяБумага = &ЦеннаяБумага
			|	И СтоимостьПереоценки.ВидУчета = &ВидУчета
			|	И СтоимостьПереоценки.Период МЕЖДУ &ДатаРазмещения И &ДатаПереоценки
			|	И СтоимостьПереоценки.УровеньОценки = 1
			|	И СтоимостьПереоценки.Цена > 0
			|	И СтоимостьПереоценки.ВидЦены <> ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ЦенаПриобретения)
			|
			|УПОРЯДОЧИТЬ ПО
			|	Период");
		
		ЗапросСтоимостиНаПредыдущуюПереоценку.УстановитьПараметр("ДатаПереоценки",					НачалоДня(ДатаПереоценки) - 1);
		ЗапросСтоимостиНаПредыдущуюПереоценку.УстановитьПараметр("ДатаРазмещения",					ДатаРазмещения);
		ЗапросСтоимостиНаПредыдущуюПереоценку.УстановитьПараметр("Организация",						ПараметрыОценки.Организация);
		ЗапросСтоимостиНаПредыдущуюПереоценку.УстановитьПараметр("СчетДоверительногоУправления",	ПараметрыОценки.СчетДоверительногоУправления);
		ЗапросСтоимостиНаПредыдущуюПереоценку.УстановитьПараметр("ЦеннаяБумага",					СтрокаПереоценкиЦБ.ЦеннаяБумага);
		ЗапросСтоимостиНаПредыдущуюПереоценку.УстановитьПараметр("Рынок",							СтрокаПереоценкиЦБ.Рынок);
		
		Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(ПараметрыОценки, "ЦельРасчета") И ЗначениеЗаполнено(ПараметрыОценки.ЦельРасчета) Тогда
			ЗапросСтоимостиНаПредыдущуюПереоценку.УстановитьПараметр("ЦельРасчета", ПараметрыОценки.ЦельРасчета);
		Иначе
			ЗапросСтоимостиНаПредыдущуюПереоценку.Текст = СтрЗаменить(ЗапросСтоимостиНаПредыдущуюПереоценку.Текст, "И СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета" , "");
		КонецЕсли;
		
		Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(ПараметрыОценки, "ВидУчета") И ЗначениеЗаполнено(ПараметрыОценки.ВидУчета) Тогда
			ЗапросСтоимостиНаПредыдущуюПереоценку.УстановитьПараметр("ВидУчета", ПараметрыОценки.ВидУчета);
		Иначе
			ЗапросСтоимостиНаПредыдущуюПереоценку.Текст = СтрЗаменить(ЗапросСтоимостиНаПредыдущуюПереоценку.Текст, "И СтоимостьПереоценки.ВидУчета = &ВидУчета" , "");
		КонецЕсли;
		
		РезультатЗапросаСтоимости = ЗапросСтоимостиНаПредыдущуюПереоценку.Выполнить();
		
		Если Не РезультатЗапросаСтоимости.Пустой() Тогда

			Если РасшифровкаРасчета <> Неопределено Тогда
				ПредыдущаяСтоимость = РезультатЗапросаСтоимости.Выгрузить()[0]; 
				РаботаСКоллекциями.ДополнитьСтруктуру(ПараметрыРасчетаЦен, Новый Структура("ПредыдущаяПереоценка, ВидЦеныНаПредыдущуюПереоценку, Описание",
					Формат(ПредыдущаяСтоимость.Период, "ДФ=dd.MM.yyyy"), ПредыдущаяСтоимость.ВидЦены, "Цену размещения использовать нельзя, т.к. в предыдущую оценку использовалась цена активного рынка"), Истина);	
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Проверка отсутствия цен активного рынка", ПараметрыРасчетаЦен);
			КонецЕсли;

			Возврат Ложь;

		КонецЕсли;	
		
		#КонецОбласти
		
	КонецЕсли;	
	
	ПроверитьОтсутствиеАктивногоРынкаСУчетомРПССначалаРазмещения = УсловияПрименения.Свойство("ОтсутствиеАктивногоРынкаСУчетомРПССНачалаРазмещения") 
		И УсловияПрименения.ОтсутствиеАктивногоРынкаСУчетомРПССНачалаРазмещения;
		
	Если ПроверитьОтсутствиеАктивногоРынкаСУчетомРПССначалаРазмещения Тогда
		
		#Область Проверка_отсутствия_активного_рынка_с_учетом_РПС
				
		Запрос = Новый Запрос(			
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВложенныйЗапрос.ОбъемСделокВКоличествеСделок КАК ОбъемСделокВКоличествеСделок,
			|	ВложенныйЗапрос.ОбъемСделокВВалютеУчета КАК ОбъемСделокВВалютеУчета,
			|	ВложенныйЗапрос.НаличиеСделкиИЦенВПоследнийТорговыйДень КАК НаличиеСделкиИЦенВПоследнийТорговыйДень
			|ИЗ
			|	(ВЫБРАТЬ
			|		СУММА(КотировкиТорговыхПлощадок.NUMTRADES) КАК ОбъемСделокВКоличествеСделок,
			|		СУММА(КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность) КАК ОбъемСделокВВалютеУчета,
			|		МАКСИМУМ(ВЫБОР
			|				КОГДА КотировкиТорговыхПлощадок.Период = &ПоследняяДатаТоргов
			|					ТОГДА КотировкиТорговыхПлощадок.NUMTRADES > 0
			|							И (КотировкиТорговыхПлощадок.MARKETPRICE2 > 0
			|								ИЛИ КотировкиТорговыхПлощадок.WAPRICE > 0
			|								ИЛИ КотировкиТорговыхПлощадок.LEGALCLOSEPRICE > 0)
			|				ИНАЧЕ ИСТИНА
			|			КОНЕЦ) КАК НаличиеСделкиИЦенВПоследнийТорговыйДень
			|	ИЗ
			|		РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
			|			ПО КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта
			|				И КотировкиТорговыхПлощадок.Период = КурсыВалют.Период
			|	ГДЕ
			|		КотировкиТорговыхПлощадок.Рынок = &Рынок
			|		И КотировкиТорговыхПлощадок.ЦеннаяБумага = &ЦеннаяБумага
			|		И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим
			|				ИЛИ КотировкиТорговыхПлощадок.РежимТоргов.РежимПереговорныхСделок
			|					И ВЫБОР
			|						КОГДА &ИсключитьРежимыАукционИАдресныеЗаявки
			|							ТОГДА НЕ КотировкиТорговыхПлощадок.РежимТоргов.Аукцион
			|									И НЕ КотировкиТорговыхПлощадок.РежимТоргов.ПервичноеРазмещение
			|						ИНАЧЕ ИСТИНА
			|					КОНЕЦ)
			|		И НЕ КотировкиТорговыхПлощадок.РежимТоргов.РЕПО
			|		И КотировкиТорговыхПлощадок.Период МЕЖДУ &КалендарныхДнейНазад35 И &ДатаПереоценки) КАК ВложенныйЗапрос
			|ГДЕ
			|	ВложенныйЗапрос.ОбъемСделокВВалютеУчета > 500000
			|	И ВложенныйЗапрос.ОбъемСделокВКоличествеСделок >= 10
			|	И ВложенныйЗапрос.НаличиеСделкиИЦенВПоследнийТорговыйДень");
			
		Запрос.УстановитьПараметр("ЦеннаяБумага",			СтрокаПереоценкиЦБ.ЦеннаяБумага);
		Запрос.УстановитьПараметр("Рынок",					СтрокаПереоценкиЦБ.Рынок);
		Запрос.УстановитьПараметр("ДатаПереоценки",			ДатаПереоценки);
