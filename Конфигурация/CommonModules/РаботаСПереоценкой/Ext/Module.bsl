		|		КОГДА НРД_Уровень2.ВидЦеныБлумберга >= 1
		|				И ЕСТЬNULL(Котировки_Bloomberg_BGN.CLOSE, 0) > 0
		|			ТОГДА 1
		|		КОГДА НРД_Уровень2.ВидЦеныБлумберга = 2
		|				И ЕСТЬNULL(Котировки_Bloomberg_BVAL.CLOSE, 0) > 0
		|			ТОГДА 2
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УровеньОценки,
		|	ВЫБОР
		|		КОГДА НРД_Уровень2.СправедливаяЦена > 0
		|			ТОГДА НРД_Уровень2.ИсточникКотировки
		|		КОГДА НРД_Уровень2.ВидЦеныБлумберга >= 1
		|				И ЕСТЬNULL(Котировки_Bloomberg_BGN.CLOSE, 0) > 0
		|			ТОГДА Котировки_Bloomberg_BGN.Биржа.ЮрФизЛицо
		|		КОГДА НРД_Уровень2.ВидЦеныБлумберга = 2
		|				И ЕСТЬNULL(Котировки_Bloomberg_BVAL.CLOSE, 0) > 0
		|			ТОГДА Котировки_Bloomberg_BVAL.Биржа.ЮрФизЛицо
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ИсточникКотировки,
		|	ВЫБОР
		|		КОГДА НРД_Уровень2.СправедливаяЦена > 0
		|			ТОГДА НРД_Уровень2.ВалютаКотировки
		|		КОГДА НРД_Уровень2.ВидЦеныБлумберга >= 1
		|				И ЕСТЬNULL(Котировки_Bloomberg_BGN.CLOSE, 0) > 0
		|			ТОГДА ВЫБОР
		|					КОГДА Котировки_Bloomberg_BGN.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|						ТОГДА ТаблицаЦБ.ВалютаНоминала
		|					ИНАЧЕ Котировки_Bloomberg_BGN.Валюта
		|				КОНЕЦ
		|		КОГДА НРД_Уровень2.ВидЦеныБлумберга = 2
		|				И ЕСТЬNULL(Котировки_Bloomberg_BVAL.CLOSE, 0) > 0
		|			ТОГДА ВЫБОР
		|					КОГДА Котировки_Bloomberg_BVAL.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|						ТОГДА ТаблицаЦБ.ВалютаНоминала
		|					ИНАЧЕ Котировки_Bloomberg_BVAL.Валюта
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ВалютаКотировки,
		|	НРД_Уровень2.ВидЦеныБлумберга КАК ВидЦеныБлумберга
		|ПОМЕСТИТЬ КотировкиБлумбергУровень1
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ НРД_Уровень2 КАК НРД_Уровень2
		|		ПО ТаблицаЦБ.ЦеннаяБумага = НРД_Уровень2.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК Котировки_Bloomberg_BGN
		|		ПО (НРД_Уровень2.Рынок = Котировки_Bloomberg_BGN.Рынок)
		|			И (НРД_Уровень2.ЦеннаяБумага = Котировки_Bloomberg_BGN.ЦеннаяБумага)
		|			И (Котировки_Bloomberg_BGN.Биржа = &Блумберг)
		|			И (Котировки_Bloomberg_BGN.РежимТоргов = &Режим_BGN)
		|			И (Котировки_Bloomberg_BGN.Период = &ПоследняяДатаТорговБлумберга)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК Котировки_Bloomberg_BVAL
		|		ПО (НРД_Уровень2.Рынок = Котировки_Bloomberg_BVAL.Рынок)
		|			И (НРД_Уровень2.ЦеннаяБумага = Котировки_Bloomberg_BVAL.ЦеннаяБумага)
		|			И (Котировки_Bloomberg_BVAL.Биржа = &Блумберг)
		|			И (Котировки_Bloomberg_BVAL.РежимТоргов = &Режим_BVAL)
		|			И (Котировки_Bloomberg_BVAL.Период = &ПоследняяДатаТорговБлумберга)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиБлумбергУровень1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиБлумбергУровень1.Рынок КАК Рынок,
		|	КотировкиБлумбергУровень1.Номинал КАК Номинал,
		|	КотировкиБлумбергУровень1.ВалютаНоминала КАК ВалютаНоминала,
		|	КотировкиБлумбергУровень1.ВалютаНоминала КАК ВалютаКупона,
		|	КотировкиБлумбергУровень1.ПолеКотировки КАК ВидЦены,
		|	КотировкиБлумбергУровень1.ДатаКотировки КАК ДатаЦены,
		|	КотировкиБлумбергУровень1.УровеньОценки КАК УровеньОценки,
		|	КотировкиБлумбергУровень1.ИсточникКотировки КАК Источник,
		|	КотировкиБлумбергУровень1.ВалютаКотировки КАК ВалютаКотировки,
		|	ЕСТЬNULL(Биржи.Ссылка, ЗНАЧЕНИЕ(Справочник.Биржи.ПустаяСсылка)) КАК Биржа,
		|	КотировкиБлумбергУровень1.СправедливаяЦена КАК Стоимость,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК ТоргуетсяНаММВБ,
		|	КотировкиБлумбергУровень1.ВидЦеныБлумберга КАК ВидЦеныБлумберга
		|ИЗ
		|	КотировкиБлумбергУровень1 КАК КотировкиБлумбергУровень1
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО КотировкиБлумбергУровень1.ИсточникКотировки = Биржи.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				Статус = ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже)
		|					И Биржа = &ММВБ
		|					И ЦеннаяБумага В
		|						(ВЫБРАТЬ
		|							ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|						ИЗ
		|							ТаблицаЦБ КАК ТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО КотировкиБлумбергУровень1.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага");
	
	#КонецОбласти	
	
	БиржаММВБ		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	БиржаБлумберг	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
	
	ИностранныеУчетныеАктивы = Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();	
	
	ПоследняяДатаТорговБлумберга	= РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки, БиржаБлумберг);	
	ТорговыхДнейНазад10				= Справочники.Календари.ДобавитьКДатеРабочиеДни(КалендарьКотировок, НачалоДня(ДатаПереоценки), -10);
	
	Запрос.УстановитьПараметр("Организация",					ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ПараметрыОценки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Клиент",							ПараметрыОценки.Клиент);
	
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",			ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10",			ТорговыхДнейНазад10);
	Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберга",	ПоследняяДатаТорговБлумберга);
	
	Запрос.УстановитьПараметр("ММВБ",		БиржаММВБ);
	Запрос.УстановитьПараметр("Блумберг",	БиржаБлумберг);
	
	Запрос.УстановитьПараметр("НРД",		ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("Режим_BGN",	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL",	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	
	Запрос.УстановитьПараметр("ИностранныеУчетныеАктивы", ИностранныеУчетныеАктивы);
	
	// Настройки методики
	Запрос.УстановитьПараметр("БратьЦенуСпросаНаВторомУровнеОценки",	ДатаПереоценки < '20190101');	
	Запрос.УстановитьПараметр("БратьЦеныНРДВПроцентах",					ДатаПереоценки >= '20190715');
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Транснефти 2018 (ЕПС)", "Таблица стоимостей ЦБ");		
	КонецЕсли;
	
	// Расчетные цены
	
	ПараметрыОценки.Вставить("ТочностьСтавкиДисконтирования",	6);	// округление ставки дисконтирования до 6 знаков по письму от 16.03.2018	
	ПараметрыОценки.Вставить("ТочностьДисконтированногоПотока", 6);
		
	ЗаполнитьНеоцененныеБумагиРасчетнымиЦенамиНационального2018(ПараметрыОценки, ДатаПереоценки, ТаблицаСтоимостейЦБ, Истина, Истина, РасшифровкаРасчета);
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныАтомфонда(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ1
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Акции.ОсновнойВыпуск,
		|	ИсходнаяТаблицаЦБ.Рынок,
		|	Акции.УчетныйАктивЦБРФ
		|ИЗ
		|	Справочник.Акции КАК Акции
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ПО (ИсходнаяТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка)
		|ГДЕ
		|	Акции.ОсновнойВыпуск <> ЗНАЧЕНИЕ(Справочник.Акции.пустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КонвертацияЦенныхБумаг.ЦеннаяБумага,
		|	КонвертацияЦенныхБумаг.Рынок,
		|	КонвертацияЦенныхБумаг.ЦеннаяБумага.УчетныйАктивЦБРФ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КонвертацияЦенныхБумаг КАК КонвертацияЦенныхБумаг
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = КонвертацияЦенныхБумаг.ЦеннаяБумагаНовая
		|;"
		+
		"
		|
		|////////////////////////////////////////////////////////////////////////////////
		|"
		+
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ1.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ1.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ВЫБОР
		|		КОГДА ИсходнаяТаблицаЦБ1.УчетныйАктивЦБРФ В (&БумагиНерезидентов)
		|			ТОГДА ЛОЖЬ
		|		КОГДА ИсходнаяТаблицаЦБ1.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА ИсходнаяТаблицаЦБ1.ЦеннаяБумага.Подкатегория = &ОВОЗ
		|						ТОГДА ЛОЖЬ
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЦБРФ
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ1 КАК ИсходнаяТаблицаЦБ1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ1.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ЕСТЬNULL(КотировкиТорговыхПлощадок.MARKETPRICE2, 0) КАК MARKETPRICE2,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.Период ЕСТЬ NULL
		|			ТОГДА 0
		|		КОГДА ТаблицаЦБ.ЦБРФ
		|			ТОГДА ВЫБОР
		|					КОГДА КотировкиТорговыхПлощадок.OFFER = 0
		|							ИЛИ КотировкиТорговыхПлощадок.BID = 0
		|							ИЛИ КотировкиТорговыхПлощадок.MARKETPRICE2 = 0
		|						ТОГДА 0
		|					КОГДА КотировкиТорговыхПлощадок.OFFER < КотировкиТорговыхПлощадок.BID
		|						ТОГДА 0
		|					КОГДА -5 <= (КотировкиТорговыхПлощадок.OFFER - КотировкиТорговыхПлощадок.BID) / КотировкиТорговыхПлощадок.BID * 100
		|							И (КотировкиТорговыхПлощадок.OFFER - КотировкиТорговыхПлощадок.BID) / КотировкиТорговыхПлощадок.BID * 100 <= 5
		|						ТОГДА ВЫБОР
		|								КОГДА КотировкиТорговыхПлощадок.BID <= КотировкиТорговыхПлощадок.MARKETPRICE2
		|										И КотировкиТорговыхПлощадок.MARKETPRICE2 <= КотировкиТорговыхПлощадок.OFFER
		|									ТОГДА КотировкиТорговыхПлощадок.MARKETPRICE2
		|								КОГДА КотировкиТорговыхПлощадок.MARKETPRICE2 <= КотировкиТорговыхПлощадок.BID
		|										И КотировкиТорговыхПлощадок.BID <= КотировкиТорговыхПлощадок.OFFER
		|									ТОГДА КотировкиТорговыхПлощадок.BID
		|								КОГДА КотировкиТорговыхПлощадок.BID <= КотировкиТорговыхПлощадок.OFFER
		|										И КотировкиТорговыхПлощадок.OFFER <= КотировкиТорговыхПлощадок.MARKETPRICE2
		|									ТОГДА ВЫРАЗИТЬ((КотировкиТорговыхПлощадок.BID + КотировкиТорговыхПлощадок.OFFER) / 2 КАК ЧИСЛО(19, 4))
		|								ИНАЧЕ 0
		|							КОНЕЦ
		|					ИНАЧЕ 0
		|				КОНЕЦ
		|		ИНАЧЕ ВЫБОР
		|				КОГДА КотировкиТорговыхПлощадок.OFFER = 0
		|						ИЛИ КотировкиТорговыхПлощадок.BID = 0
		|						ИЛИ КотировкиТорговыхПлощадок.LEGALCLOSEPRICE = 0
		|					ТОГДА 0
		|				КОГДА КотировкиТорговыхПлощадок.OFFER < КотировкиТорговыхПлощадок.BID
		|					ТОГДА 0
		|				КОГДА -5 <= (КотировкиТорговыхПлощадок.OFFER - КотировкиТорговыхПлощадок.BID) / КотировкиТорговыхПлощадок.BID * 100
		|						И (КотировкиТорговыхПлощадок.OFFER - КотировкиТорговыхПлощадок.BID) / КотировкиТорговыхПлощадок.BID * 100 <= 5
		|					ТОГДА ВЫБОР
		|							КОГДА КотировкиТорговыхПлощадок.BID <= КотировкиТорговыхПлощадок.LEGALCLOSEPRICE
		|									И КотировкиТорговыхПлощадок.LEGALCLOSEPRICE <= КотировкиТорговыхПлощадок.OFFER
		|								ТОГДА КотировкиТорговыхПлощадок.LEGALCLOSEPRICE
