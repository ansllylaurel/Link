		|			И (КотировкиБлумбергBVAL.РежимТоргов = &Режим_BVAL)
		|			И (КотировкиБлумбергBVAL.Период = &ПоследняяДатаТорговБлумберг)
		|			И (_ТаблицаЦБ.ИностраннаяЦБ
		|				ИЛИ _ТаблицаЦБ.Еврооблигация)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаДатРасчетныхЦенПаев КАК _ТаблицаДатРасчетныхЦенПаев
		|		ПО (_ТаблицаДатРасчетныхЦенПаев.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (_ТаблицаДатРасчетныхЦенПаев.ТипПИФ = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Открытый))
		|			И (_ТаблицаЦБ.ИностраннаяЦБ = ЛОЖЬ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев КАК РасчетныеЦеныПаев
		|		ПО (РасчетныеЦеныПаев.ЦеннаяБумага = _ТаблицаДатРасчетныхЦенПаев.ЦеннаяБумага)
		|			И (РасчетныеЦеныПаев.Период = _ТаблицаДатРасчетныхЦенПаев.Дата)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ПаевойИнвестиционныйФонд, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						_ТаблицаДатРасчетныхЦенПаев.ПаевойИнвестиционныйФонд,
		|						ИСТИНА
		|					ИЗ
		|						_ТаблицаДатРасчетныхЦенПаев)) КАК РеквизитыПИФ
		|		ПО (РеквизитыПИФ.ПаевойИнвестиционныйФонд = _ТаблицаДатРасчетныхЦенПаев.ПаевойИнвестиционныйФонд)
		|ГДЕ
		|	_ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости = ЛОЖЬ
		|	И _ЦБУровень1.ЦеннаяБумага ЕСТЬ NULL
		|	И ВЫБОР
		|			КОГДА КотировкиБлумбергBGN.BID > 0
		|				ТОГДА ИСТИНА
		|			КОГДА КотировкиБлумбергBVAL.CLOSE > 0
		|				ТОГДА ИСТИНА
		|			КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|					И РасчетныеЦеныНРД.RATE > 0
		|				ТОГДА ИСТИНА
		|			КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|					И РасчетныеЦеныНРД.PRICE > 0
		|				ТОГДА ИСТИНА
		|			КОГДА РасчетныеЦеныПаев.РасчетнаяЦена > 0
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦБУровень1.Рынок КАК Рынок,
		|	_ЦБУровень1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ЦБУровень1.УровеньОценки КАК УровеньОценки,
		|	_ЦБУровень1.ВидЦены КАК ВидЦены,
		|	_ЦБУровень1.СправедливаяЦена КАК СправедливаяЦена,
		|	_ЦБУровень1.ВалютаКотировки КАК ВалютаКотировки,
		|	_ЦБУровень1.ВалютаКотировки КАК Валюта,
		|	_ЦБУровень1.ДатаЦены КАК ДатаЦены,
		|	_ЦБУровень1.Источник КАК Источник,
		|	_ЦБУровень1.РежимТоргов КАК РежимТоргов
		|ПОМЕСТИТЬ _ОцененныеБумаги
		|ИЗ
		|	_ЦБУровень1 КАК _ЦБУровень1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦБУровень2.Рынок,
		|	_ЦБУровень2.ЦеннаяБумага,
		|	_ЦБУровень2.УровеньОценки,
		|	_ЦБУровень2.ВидЦены,
		|	_ЦБУровень2.СправедливаяЦена,
		|	_ЦБУровень2.ВалютаКотировки,
		|	_ЦБУровень2.ВалютаКотировки,
		|	_ЦБУровень2.ДатаЦены,
		|	_ЦБУровень2.Источник,
		|	_ЦБУровень2.РежимТоргов
		|ИЗ
		|	_ЦБУровень2 КАК _ЦБУровень2
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.Номинал КАК Номинал,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(_ОцененныеБумаги.СправедливаяЦена * _ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|			ИНАЧЕ _ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(_ОцененныеБумаги.ВалютаКотировки, 0) КАК ВалютаКотировки,
		|	ЕСТЬNULL(_ОцененныеБумаги.ВидЦены, 0) КАК ВидЦены,
		|	ЕСТЬNULL(_ОцененныеБумаги.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(_ОцененныеБумаги.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, ЕСТЬNULL(_ОцененныеБумаги.Источник, 0)) КАК Источник,
		|	ЕСТЬNULL(_ОцененныеБумаги.РежимТоргов, 0) КАК РежимТоргов,
		|	0 КАК Купон,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаКупона,
		|	_ТаблицаЦБ.ОблигацияСПлавающейСтавкойИлиНоминалом КАК ОблигацияСПлавающейСтавкойИлиНоминалом,
		|	_ТаблицаЦБ.ИностраннаяЦБ КАК ИностраннаяЦБ,
		|	_ТаблицаЦБ.ОценкаПоАмортизированнойСтоимости КАК ОценкаПоАмортизированнойСтоимости
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОцененныеБумаги КАК _ОцененныеБумаги
		|		ПО (_ОцененныеБумаги.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (Биржи.Ссылка = _ОцененныеБумаги.Источник)";

	#КонецОбласти
	
	ИностранныеУчетныеАктивы				= Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();	
	ОблигацииСПлавающейСтавкойИлиНоминалом	= Справочники.Облигации.ПолучитьОблигацииСПлавающейСтавкойИлиНоминалом(ТаблицаЦБ, ДатаПереоценки, Ложь, Ложь, РасшифровкаРасчета);
	
	ММВБ		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	НРД			= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");	
	Блумберг	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
	Режим_BGN	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN");
	Режим_BVAL	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL");
	
	ПоследняяДатаТорговБлумберг	= РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки, Блумберг);
	КалендарныхДнейНазад30		= НачалоДня(ДатаПереоценки) - 30 * 86400;
	
	ПроверятьЦеныПервогоУровняНаВхождениеВСпредЦенСпросаИПредложения = Ложь;
	
	Запрос.УстановитьПараметр("ДатаПереоценки",							ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберг",			ПоследняяДатаТорговБлумберг);
	Запрос.УстановитьПараметр("КалендарныхДнейНазад30",					КалендарныхДнейНазад30);
	
	Запрос.УстановитьПараметр("ММВБ",									ММВБ);
	Запрос.УстановитьПараметр("НРД",									НРД);
	Запрос.УстановитьПараметр("Блумберг",								Блумберг);
	Запрос.УстановитьПараметр("Режим_BGN",								Режим_BGN);
	Запрос.УстановитьПараметр("Режим_BVAL",								Режим_BVAL);
	
	Запрос.УстановитьПараметр("ИностранныеУчетныеАктивы",				ИностранныеУчетныеАктивы);
	Запрос.УстановитьПараметр("ОблигацииСПлавающейСтавкойИлиНоминалом",	ОблигацииСПлавающейСтавкойИлиНоминалом);
	
	Запрос.УстановитьПараметр("ПроверятьЦеныПервогоУровняНаВхождениеВСпредЦенСпросаИПредложения", ПроверятьЦеныПервогоУровняНаВхождениеВСпредЦенСпросаИПредложения);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Югории 2022", "Таблица стоимостей ЦБ", , , "_ИсходнаяТаблицаЦБ, _ТаблицаДатРасчетныхЦенПаев, _БумагиОцениваемыеПоАмортизированнойСтоимости, _СтатусыЦенныхБумаг, _ЭмитентыЦенныхБумаг, _ПроверкаОтсутствияНесколькихКотировок, _ОцененныеБумаги");		
	КонецЕсли;
	
	#Область Проверка_отсутствия_нескольких_котировок
	
	ПроверкаОтсутствияНесколькихКотировок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ПроверкаОтсутствияНесколькихКотировок"].ПолучитьДанные().Выбрать();
	Пока ПроверкаОтсутствияНесколькихКотировок.Следующий() Цикл
		ТекстОшибки = СтрШаблон("Для бумаги '%1' на %2 на основном рынке имеется несколько котировок, но приоритет котировок не задан.",
			ПроверкаОтсутствияНесколькихКотировок.ЦеннаяБумага,
			Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , , , Отказ);
	КонецЦикла;
	
	#КонецОбласти
	
	Если ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;	
	
	// Расчетные цены	
	
	ВыполненРасчетЦены = Ложь;
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления, , СтрокаСтоимостейЦБ.ВалютаКупона);
		КонецЕсли;	
		
		// Уведомление о цене BVAL
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены) ИЛИ СтрокаСтоимостейЦБ.ОценкаПоАмортизированнойСтоимости Тогда
			
			Если СтрокаСтоимостейЦБ.РежимТоргов = Режим_BVAL Тогда
				УведомитьОбОценкеПоЦенеBloombergBVAL(СтрокаСтоимостейЦБ.ЦеннаяБумага, ПараметрыОценки, ДатаПереоценки);
			КонецЕсли;		
			
			Продолжить;			
			
		КонецЕсли;
		
		// Расчет цен
		
		ОшибкаРасчета = Ложь;
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			Если Не СтрокаСтоимостейЦБ.ОблигацияСПлавающейСтавкойИлиНоминалом Тогда
				
				// Цена по PV:
				// нет параметров определения рейтинговой группы и расчета кредитного спреда,
				// поэтому пока не оцениваем  
				// Ошибку не регистрируем, т. к. это может быть первичное размещение. Выводим в расшифровку
				
				Если РасшифровкаРасчета <> Неопределено Тогда
					
					ТекстРезультата = СтрШаблон("Для расчета цены '%1' по PV не заданы параметры определения рейтинговой группы и расчета кредитного спреда", СтрокаСтоимостейЦБ.ЦеннаяБумага);					
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Расчет по PV", Новый Структура("Комментарий", ТекстРезультата));
					
				КонецЕсли;
								
			КонецЕсли;
			
		ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
			
			Если Не СтрокаСтоимостейЦБ.ИностраннаяЦБ Тогда
				
				#Область Расчет_на_основе_корректировки_исторической_цены					
				
				// Модель оценки, основанная на корректировке исторической цены (CAPM).
				// Применяем при отсутствии цены не более 10 рабочих дней
				
				ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, Справочники.Календари.Общероссийский, , 2, ОшибкаРасчета, РасшифровкаРасчета);  
				
				Если ОшибкаРасчета Тогда
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
				ИначеЕсли ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
				КонецЕсли;
				
				#КонецОбласти
			
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "После расчета цен", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;	

КонецФункции

Функция ПолучитьЦеныЮгории2026(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ИсходнаяТаблицаЦБ");
	ПоместитьСтатусыЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "_ИсходнаяТаблицаЦБ"); 
	ПоместитьЭмитентовЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "_ИсходнаяТаблицаЦБ");
	ПоместитьСведенияОТоргахЦеннымиБумагамиВМенеджерВременныхТаблиц(Запрос, "_ИсходнаяТаблицаЦБ", ДатаПереоценки, 1, "_СведенияОТоргахЦеннымиБумагами");		
	ПоместитьТаблицуДатРасчетныхЦенПаевВМенеджерВременныхТаблиц(Запрос, "_ИсходнаяТаблицаЦБ", ДатаПереоценки, "_ТаблицаДатРасчетныхЦенПаев");
	
	#Область Основной_запрос
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	_ТоргуетсяНаММВБ.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК ТоргуетсяНаММВБ,
		|	_ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ В (&ИностранныеУчетныеАктивы) КАК ИностраннаяЦБ,
		|	ЕСТЬNULL(Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация), ЛОЖЬ) КАК Еврооблигация,
		|	_ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ В (ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ВекселяИностранногоГосударства)) КАК ЦБИностранногоГосударства,
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага В (&ОблигацииСПлавающейСтавкойИлиНоминалом) КАК ОблигацияСПлавающейСтавкойИлиНоминалом,
		|	_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента КАК Эмитент,
