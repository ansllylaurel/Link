		|	_ТаблицаЦБ.ВалютаНоминала,
		|	ЕСТЬNULL(Котировки_Bloomberg_BGN.CLOSE, Котировки_Bloomberg_BVAL.CLOSE),
		|	2,
		|	&Блумберг,
		|	ЕСТЬNULL(Котировки_Bloomberg_BGN.РежимТоргов, Котировки_Bloomberg_BVAL.РежимТоргов),
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(Котировки_Bloomberg_BGN.CLOSE, 0) > 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныдляПереоценки.СредняяЦенаЗакрытия)
		|		КОГДА ЕСТЬNULL(Котировки_Bloomberg_BVAL.CLOSE, 0) > 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныдляПереоценки.СредневзвешеннаяЦена)
		|	КОНЕЦ,
		|	ЕСТЬNULL(Котировки_Bloomberg_BGN.Период, Котировки_Bloomberg_BVAL.Период),
		|	ЕСТЬNULL(Котировки_Bloomberg_BGN.Валюта, Котировки_Bloomberg_BVAL.Валюта)
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок.СрезПоследних(
		|				&ДатаПереоценки,
		|				Биржа = &Блумберг
		|					И РежимТоргов = &Режим_BGN) КАК Котировки_Bloomberg_BGN
		|		ПО _ТаблицаЦБ.Рынок = Котировки_Bloomberg_BGN.Рынок
		|			И _ТаблицаЦБ.ЦеннаяБумага = Котировки_Bloomberg_BGN.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок.СрезПоследних(
		|				&ДатаПереоценки,
		|				Биржа = &Блумберг
		|					И РежимТоргов = &Режим_BVAL) КАК Котировки_Bloomberg_BVAL
		|		ПО _ТаблицаЦБ.Рынок = Котировки_Bloomberg_BVAL.Рынок
		|ГДЕ
		|	_ТаблицаЦБ.ОценкаПоНоминалу = ЛОЖЬ
		|	И _ТаблицаЦБ.ОВОЗРФ
		|	И (НЕ Котировки_Bloomberg_BGN.РежимТоргов ЕСТЬ NULL
		|			ИЛИ НЕ Котировки_Bloomberg_BVAL.РежимТоргов ЕСТЬ NULL)
		|	И &ДоступныДанныеBloomberg
		|	И &ОценкаЕврооблигацийПоЦенамБлумберг
		|	И НЕ &ТолькоНаблюдаемыеЦены
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	3 КАК УровеньОценки,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СЧА) КАК ВидЦены,
		|	РасчетныеЦеныПаев.РасчетнаяЦена КАК СправедливаяЦена,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаЦены,
		|	РасчетныеЦеныПаев.Период КАК ДатаЦены,
		|	РеквизитыПИФ.УправляющаяКомпания.ЮрФизЛицо КАК Источник
		|ПОМЕСТИТЬ _ЦБУровень3
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
		|		ПО _ТаблицаЦБ.ЦеннаяБумага = Паи.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦБУровень1 КАК _ЦБУровень1
		|		ПО _ТаблицаЦБ.ЦеннаяБумага = _ЦБУровень1.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦБУровень2 КАК _ЦБУровень2
		|		ПО _ТаблицаЦБ.ЦеннаяБумага = _ЦБУровень2.ЦеннаяБумага
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						_ТаблицаЦБ.ЦеннаяБумага
		|					ИЗ
		|						_ТаблицаЦБ
		|					ГДЕ
		|						_ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))) КАК РасчетныеЦеныПаев
		|		ПО _ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныПаев.ЦеннаяБумага
		|			И (РасчетныеЦеныПаев.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, МЕСЯЦ, -6))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФ
		|		ПО (Паи.ПаевойИнвестиционныйФонд = РеквизитыПИФ.ПаевойИнвестиционныйФонд)
		|ГДЕ
		|	_ЦБУровень1.ЦеннаяБумага ЕСТЬ NULL
		|	И _ЦБУровень2.ЦеннаяБумага ЕСТЬ NULL
		|	И НЕ &ТолькоНаблюдаемыеЦены
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ТаблицаЦБ.Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага,
		|	_ТаблицаЦБ.ВалютаНоминала,
		|	3,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД),
		|	ВЫБОР
		|		КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА РасчетныеЦеныНРД.RATE
		|		ИНАЧЕ РасчетныеЦеныНРД.PRICE
		|	КОНЕЦ,
		|	_ТаблицаЦБ.ВалютаНоминала,
		|	РасчетныеЦеныНРД.Период,
		|	&НРД
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦБУровень1 КАК _ЦБУровень1
		|		ПО _ТаблицаЦБ.ЦеннаяБумага = _ЦБУровень1.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦБУровень2 КАК _ЦБУровень2
		|		ПО (_ТаблицаЦБ.ЦеннаяБумага = _ЦБУровень1.ЦеннаяБумага)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				РасчетныеЦеныНРД.ЦеннаяБумага КАК ЦеннаяБумага,
		|				МАКСИМУМ(РасчетныеЦеныНРД.Период) КАК Период
		|			ИЗ
		|				РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаЦБ КАК _ТаблицаЦБ
		|					ПО (_ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныНРД.ЦеннаяБумага)
		|						И (_ТаблицаЦБ.Рынок = РасчетныеЦеныНРД.Рынок)
		|						И (_ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))
		|						И (НЕ _ТаблицаЦБ.НоминированаВРублях)
		|			ГДЕ
		|				РасчетныеЦеныНРД.VERSION = ""2""
		|				И РасчетныеЦеныНРД.METHOD_NUMBER = ""3""
		|				И (РасчетныеЦеныНРД.TYPE В (&МетодикиНРД)
		|						ИЛИ &ИгнорироватьТипОблигацииНРД)
		|				И РасчетныеЦеныНРД.Период В (_ТаблицаЦБ.ПоследняяДатаТоргов, &ДатаПереоценки)
		|			
		|			СГРУППИРОВАТЬ ПО
		|				РасчетныеЦеныНРД.ЦеннаяБумага) КАК ДатыЦенНРД
		|			ПО (ДатыЦенНРД.ЦеннаяБумага = РасчетныеЦеныНРД.ЦеннаяБумага)
		|				И (ДатыЦенНРД.Период = РасчетныеЦеныНРД.Период)
		|		ПО _ТаблицаЦБ.Рынок = РасчетныеЦеныНРД.Рынок
		|			И _ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныНРД.ЦеннаяБумага
		|ГДЕ
		|	_ТаблицаЦБ.ОценкаПоНоминалу = ЛОЖЬ
		|	И _ЦБУровень1.ЦеннаяБумага ЕСТЬ NULL
		|	И _ЦБУровень2.ЦеннаяБумага ЕСТЬ NULL
		|	И &ОценкаЕврооблигацийПоЦенамНРД
		|	И НЕ &ТолькоНаблюдаемыеЦены
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦБУровень1.Рынок КАК Рынок,
		|	_ЦБУровень1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ЦБУровень1.ВалютаНоминала КАК ВалютаНоминала,
		|	_ЦБУровень1.УровеньОценки КАК УровеньОценки,
		|	_ЦБУровень1.ВидЦены КАК ВидЦены,
		|	_ЦБУровень1.СправедливаяЦена КАК СправедливаяЦена,
		|	_ЦБУровень1.ВалютаЦены КАК ВалютаКотировки,
		|	_ЦБУровень1.ВалютаЦены КАК Валюта,
		|	_ЦБУровень1.ДатаЦены КАК ДатаЦены,
		|	_ЦБУровень1.Источник КАК Источник
		|ПОМЕСТИТЬ _ОцененныеБумаги
		|ИЗ
		|	_ЦБУровень1 КАК _ЦБУровень1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦБУровень2.Рынок,
		|	_ЦБУровень2.ЦеннаяБумага,
		|	_ЦБУровень2.ВалютаНоминала,
		|	_ЦБУровень2.УровеньОценки,
		|	_ЦБУровень2.ВидЦены,
		|	_ЦБУровень2.СправедливаяЦена,
		|	_ЦБУровень2.ВалютаЦены,
		|	_ЦБУровень2.ВалютаЦены,
		|	_ЦБУровень2.ДатаЦены,
		|	_ЦБУровень2.Источник
		|ИЗ
		|	_ЦБУровень2 КАК _ЦБУровень2
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦБУровень3.Рынок,
		|	_ЦБУровень3.ЦеннаяБумага,
		|	_ЦБУровень3.ВалютаНоминала,
		|	_ЦБУровень3.УровеньОценки,
		|	_ЦБУровень3.ВидЦены,
		|	_ЦБУровень3.СправедливаяЦена,
		|	_ЦБУровень3.ВалютаЦены,
		|	_ЦБУровень3.ВалютаЦены,
		|	_ЦБУровень3.ДатаЦены,
		|	_ЦБУровень3.Источник
		|ИЗ
		|	_ЦБУровень3 КАК _ЦБУровень3
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ТаблицаЦБ.Номинал КАК Номинал,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(_ОцененныеБумаги.СправедливаяЦена * _ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|			ИНАЧЕ _ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(_ОцененныеБумаги.Валюта, 0) КАК Валюта,
		|	ЕСТЬNULL(_ОцененныеБумаги.ВалютаКотировки, 0) КАК ВалютаКотировки,
		|	ЕСТЬNULL(_ОцененныеБумаги.ВидЦены, 0) КАК ВидЦены,
		|	ЕСТЬNULL(_ОцененныеБумаги.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(_ОцененныеБумаги.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, ЕСТЬNULL(_ОцененныеБумаги.Источник, 0)) КАК Источник,
		|	0 КАК Купон,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаКупона
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОцененныеБумаги КАК _ОцененныеБумаги
		|		ПО _ТаблицаЦБ.ЦеннаяБумага = _ОцененныеБумаги.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (Биржи.Ссылка = _ОцененныеБумаги.Источник)";
	
	#КонецОбласти	
	
	ТолькоНаблюдаемыеЦены		= ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены;	
	
	ММВБ						= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	НРД							= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");
	Блумберг					= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
	КлиентДУ					= Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ПараметрыОценки.СчетДоверительногоУправления, ДатаПереоценки);
	
	ОценкаЕврооблигацийПоЦенамБлумберг	= ДатаПереоценки < '20230101';
	ОценкаЕврооблигацийПоЦенамНРД		= ДатаПереоценки >= '20230101';
	
	ИгнорироватьТипОблигацииНРД = Ложь;
	
	МетодикиНРД = Новый Массив;
	МетодикиНРД.Добавить("bond");
	
	Если ДатаПереоценки >= '20210101' Тогда
		
		МетодикиНРД.Добавить("floating_bond");
		МетодикиНРД.Добавить("mortgage_bond");
		
		// с 01.01.2022 по 01.04.2023 методика определения стоимости облигаций без международных рейтингов
		// была только в методике НПФ Волга-Капитал (#410789, #409295, #475621)
		
		Если ДатаПереоценки < '20220101'
			ИЛИ ДатаПереоценки >= '20230401'
			ИЛИ КлиентДУ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФВолгаКапитал")
		Тогда
			МетодикиНРД.Добавить("unrated_bond");
		КонецЕсли;
		
		// с 01.01.2023 добавилась оценка еврооблигаций (включая ОВОЗРФ) по ценам НРД (#464895)
		
		Если ОценкаЕврооблигацийПоЦенамНРД Тогда
			МетодикиНРД.Добавить("corp_euro_bond");
			МетодикиНРД.Добавить("euro_bond");
		КонецЕсли;
		
		// с 01.01.2025 добавилась оценка субординированных облигаций
		МетодикиНРД.Добавить("subord_bond");
		
		ИгнорироватьТипОблигацииНРД = (КлиентДУ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФОПФ"));
		
	Иначе
		
		ИгнорироватьТипОблигацииНРД = (КлиентДУ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФВолгаКапитал")
			ИЛИ КлиентДУ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФОПФ"));
			
	КонецЕсли;
	
	ОсновнойКалендарьКотировок	= Константы.ОсновнойКалендарьКотировок.Получить();	
	ТорговыхДнейНазад10			= Справочники.Календари.ДобавитьКДатеРабочиеДни(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки), -10);
	ПоследняяДатаТоргов			= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки));
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 		ПараметрыОценки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ММВБ",								ММВБ);	
	Запрос.УстановитьПараметр("НРД",								НРД);
	Запрос.УстановитьПараметр("Блумберг",							Блумберг);
	Запрос.УстановитьПараметр("Режим_BGN",							ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL",							ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	Запрос.УстановитьПараметр("ВалютаРубли",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	Запрос.УстановитьПараметр("ДатаПереоценки",						ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",				ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10",				ТорговыхДнейНазад10);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ",					ТаблицаЦБ);
	
	Запрос.УстановитьПараметр("ИгнорироватьТипОблигацииНРД", 		ИгнорироватьТипОблигацииНРД);
	Запрос.УстановитьПараметр("МетодикиНРД",						МетодикиНРД);
	
	Запрос.УстановитьПараметр("ДоступныДанныеBloomberg",			ПроверитьДоступностьДанныхBloomberg(ДатаПереоценки));
	Запрос.УстановитьПараметр("ОценкаЕврооблигацийПоЦенамБлумберг", ОценкаЕврооблигацийПоЦенамБлумберг);
	Запрос.УстановитьПараметр("ОценкаЕврооблигацийПоЦенамНРД",		ОценкаЕврооблигацийПоЦенамНРД);
	
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены",				ТолькоНаблюдаемыеЦены);	
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Атомфонда", "Промежуточная таблица стоимостей ЦБ");		
	КонецЕсли;
	
	Если ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;	
	
	// Расчетные цены 	
	
	ВыполненРасчетЦены = Ложь;	
	
	ПараметрыОценки.Вставить("ТочностьСтавкиДисконтирования", 2);
	ПараметрыОценки.Вставить("ПараметрыМоделиCAPM",			  Новый Структура("Бета", 1));
	
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		Если СтрокаСтоимостейЦБ.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.Номинал Тогда
			Продолжить; // Для погашенных ЦБ дополнительные действия не требуются
		КонецЕсли;
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда  
			
			ТочностьКупонаВВалютеНоминала = Неопределено;
			Если СтрокаСтоимостейЦБ.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин12840111V") Тогда
				ТочностьКупонаВВалютеНоминала = 2;
			КонецЕсли;			
			
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления,,,, ТочностьКупонаВВалютеНоминала);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены) Тогда
			Продолжить;
		КонецЕсли;
		
		// Расчетные цены
		
		ОшибкаРасчета = Ложь;
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков
						
			ЦенаЗаполнена = ЗаполнитьДисконтированнойПоБезрисковойСтавкеДоходностиСтоимостью(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, ПараметрыДенежногоПотока, , 2, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, 4, ОшибкаРасчета, РасшифровкаРасчета);
				
			Если ОшибкаРасчета Тогда
				ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
				Продолжить;
			ИначеЕсли ЦенаЗаполнена Тогда
				ВыполненРасчетЦены = Истина;
			КонецЕсли;
			
			#КонецОбласти
			
		ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
			
			#Область Расчет_на_основе_корректировки_исторической_цены					
			
			// Справедливая стоимость акций российских эмитентов, допущенным к торгам на ММВБ,
			// определяется в соответствии с моделью оценки, основанной на корректировке исторической цены (CAPM).
			// Применяем при отсутствии цены не более 10 торговых дней
			
			ТочностьЦены = ?(ДатаПереоценки >= '20210101', 6, 5);
			Календарь	 = ?(ДатаПереоценки >= '20210101', ОсновнойКалендарьКотировок, Неопределено);
			
			ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, Календарь, , ТочностьЦены, ОшибкаРасчета, РасшифровкаРасчета);
			
			Если ОшибкаРасчета Тогда
				ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
				Продолжить;
			ИначеЕсли ЦенаЗаполнена Тогда
				ВыполненРасчетЦены = Истина;
			КонецЕсли;
			
			#КонецОбласти					
			
		КонецЕсли;

	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "Таблица стоимостей ЦБ", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныАквилон(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	#Область Основной_запрос
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаСпискаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	ЕСТЬNULL(Облигации.ДатаНачалаОбращения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаОбращения,
		|	ЕСТЬNULL(Облигации.ДатаНачалаРазмещения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаРазмещения,
		|	ВЫБОР
		|		КОГДА Облигации.ДатаПогашения ЕСТЬ NULL
		|				ИЛИ Облигации.ДатаПогашения = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ Облигации.ДатаПогашения
		|	КОНЕЦ КАК ДатаПогашенияОблигации
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.Банкротство)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК Банкротство,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ИсполнениеОферты)
		|					И ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.НеисполнениеОферты)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК НеисполнениеОферты,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.КупонныеВыплаты)
		|					И ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ДефотПоКупону,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации)
		|					И ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт)
		|				ТОГДА ИСТИНА
		|			КОГДА ТаблицаЦБ.ДатаПогашенияОблигации <> НЕОПРЕДЕЛЕНО
		|				ТОГДА ВЫБОР
		|						КОГДА ТаблицаЦБ.ДатаПогашенияОблигации < ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -7)
		|							ТОГДА ИСТИНА
		|						ИНАЧЕ ЛОЖЬ
		|					КОНЕЦ
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ДефолтПоТелу,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ТаблицаЦБ.УчетныйАктивЦБРФ В (&ИностранныеУчетныеАктивы)
		|				ТОГДА ВЫБОР
		|						КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|							ТОГДА ВЫБОР
		|									КОГДА ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|											ИЛИ ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗ)
		|											ИЛИ ТаблицаЦБ.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств)
		|											ИЛИ РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация)
		|										ТОГДА 2
		|									ИНАЧЕ 1
		|								КОНЕЦ
		|						ИНАЧЕ 1
		|					КОНЕЦ
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ВидЦеныБлумберга,
		|	ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо КАК ЮрФизЛицоЭмитента
		|ПОМЕСТИТЬ _Дефолты
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДефолтыПоОблигациям.СрезПоследних(
		|				&ДатаПереоценки,
		|				Облигация В
		|						(ВЫБРАТЬ
		|							ТаблицаЦБ.ЦеннаяБумага
		|						ИЗ
		|							ТаблицаЦБ КАК ТаблицаЦБ)
		|					И (ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.Банкротство)
		|						ИЛИ ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации)
		|						ИЛИ ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.КупонныеВыплаты)
		|						ИЛИ ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ИсполнениеОферты))) КАК ДефолтыПоОблигациямСрезПоследних
		|		ПО ТаблицаЦБ.ЦеннаяБумага = ДефолтыПоОблигациямСрезПоследних.Облигация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаЦБ.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаЦБ.Рынок КАК Рынок
		|ПОМЕСТИТЬ АктивныйРынокММВБ10Дней
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадок.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
		|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта)
		|			И (КурсыВалют.Период = &ДатаПереоценки)
		|ГДЕ
		|	КотировкиТорговыхПлощадок.Период >= &ТорговыхДнейНазад10
		|	И КотировкиТорговыхПлощадок.Период <= &ДатаПереоценки
		|	И КотировкиТорговыхПлощадок.Биржа = &ММВБ
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал,
		|	ТаблицаЦБ.ВалютаНоминала,
		|	ТаблицаЦБ.Рынок
		|
		|ИМЕЮЩИЕ
		|	СУММА(КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность) >= 500000 И
		|	СУММА(КотировкиТорговыхПлощадок.NUMTRADES) >= 10
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	КотировкиТорговыхПлощадок.Биржа КАК Биржа,
		|	ВЫБОР
		|		КОГДА ТаблицаЦБ.УчетныйАктивЦБРФ В (&ИностранныеУчетныеАктивы)
		|			ТОГДА ВЫБОР
		|					КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|						ТОГДА ВЫБОР
