		|				И (ДатыЦенНРД.Период = РасчетныеЦеныНРД.Период)
		|		ПО (РасчетныеЦеныНРД.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (РасчетныеЦеныНРД.Рынок = ТаблицаЦБ.Рынок)
		|			И (ВЫБОР
		|				КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|						И ТаблицаЦБ.НоминированаВРублях
		|					ТОГДА РасчетныеЦеныНРД.VERSION = ""2""
		|							И РасчетныеЦеныНРД.METHOD_NUMBER В (""1"", ""2"")
		|							И (РасчетныеЦеныНРД.TYPE В (&МетодикиРублевыхОблигацийНРД)
		|								ИЛИ &ИгнорироватьТипОблигацииНРД)
		|				ИНАЧЕ РасчетныеЦеныНРД.VERSION <> """"
		|			КОНЕЦ)
		|ГДЕ
		|	ТаблицаЦБ.СчитаемЧтоДефолт = ЛОЖЬ
		|	И ЦБУровень1.ЦеннаяБумага ЕСТЬ NULL
		|	И НЕ &ТолькоНаблюдаемыеЦены
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	РеквизитыПИФ.УправляющаяКомпания.ЮрФизЛицо КАК Источник,
		|	РасчетныеЦеныПаев.РасчетнаяЦена КАК СправедливаяЦена,
		|	РасчетныеЦеныПаев.Период КАК ДатаЦены,
		|	3 КАК УровеньОценки,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СЧА) КАК ВидЦены,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаЦены
		|ПОМЕСТИТЬ ЦБУровень3
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
		|		ПО (Паи.Ссылка = ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЦБУровень1 КАК ЦБУровень1
		|		ПО (ЦБУровень1.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЦБУровень2 КАК ЦБУровень2
		|		ПО (ЦБУровень2.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						ТаблицаЦБ.ЦеннаяБумага
		|					ИЗ
		|						ТаблицаЦБ
		|					ГДЕ
		|						ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))) КАК РасчетныеЦеныПаев
		|		ПО (РасчетныеЦеныПаев.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (РасчетныеЦеныПаев.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, МЕСЯЦ, -6))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФ
		|		ПО (Паи.ПаевойИнвестиционныйФонд = РеквизитыПИФ.ПаевойИнвестиционныйФонд)
		|ГДЕ
		|	ЦБУровень1.ЦеннаяБумага ЕСТЬ NULL
		|	И ЦБУровень2.ЦеннаяБумага ЕСТЬ NULL
		|	И НЕ &ТолькоНаблюдаемыеЦены
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦБУровень1.Рынок КАК Рынок,
		|	ЦБУровень1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЦБУровень1.ВалютаНоминала КАК ВалютаНоминала,
		|	ЦБУровень1.УровеньОценки КАК УровеньОценки,
		|	ЦБУровень1.ВидЦены КАК ВидЦены,
		|	ЦБУровень1.СправедливаяЦена КАК СправедливаяЦена,
		|	ЦБУровень1.ВалютаЦены КАК ВалютаКотировки,
		|	ЦБУровень1.ВалютаЦены КАК Валюта,
		|	ЦБУровень1.ДатаЦены КАК ДатаЦены,
		|	ЦБУровень1.Источник КАК Источник
		|ПОМЕСТИТЬ ОцененныеБумаги
		|ИЗ
		|	ЦБУровень1 КАК ЦБУровень1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЦБУровень2.Рынок,
		|	ЦБУровень2.ЦеннаяБумага,
		|	ЦБУровень2.ВалютаНоминала,
		|	ЦБУровень2.УровеньОценки,
		|	ЦБУровень2.ВидЦены,
		|	ЦБУровень2.СправедливаяЦена,
		|	ЦБУровень2.ВалютаЦены,
		|	ЦБУровень2.ВалютаЦены,
		|	ЦБУровень2.ДатаЦены,
		|	ЦБУровень2.Источник
		|ИЗ
		|	ЦБУровень2 КАК ЦБУровень2
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЦБУровень3.Рынок,
		|	ЦБУровень3.ЦеннаяБумага,
		|	ЦБУровень3.ВалютаНоминала,
		|	ЦБУровень3.УровеньОценки,
		|	ЦБУровень3.ВидЦены,
		|	ЦБУровень3.СправедливаяЦена,
		|	ЦБУровень3.ВалютаЦены,
		|	ЦБУровень3.ВалютаЦены,
		|	ЦБУровень3.ДатаЦены,
		|	ЦБУровень3.Источник
		|ИЗ
		|	ЦБУровень3 КАК ЦБУровень3
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(ОцененныеБумаги.СправедливаяЦена * ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|			ИНАЧЕ ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(ОцененныеБумаги.Валюта, 0) КАК Валюта,
		|	ЕСТЬNULL(ОцененныеБумаги.ВалютаКотировки, 0) КАК ВалютаКотировки,
		|	ЕСТЬNULL(ОцененныеБумаги.ВидЦены, 0) КАК ВидЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(ОцененныеБумаги.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, ЕСТЬNULL(ОцененныеБумаги.Источник, 0)) КАК Источник,
		|	0 КАК Купон,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаКупона,
		|	ТаблицаЦБ.СчитаемЧтоДефолт КАК СчитаемЧтоДефолт,
		|	ТаблицаЦБ.ЭмитентРоссийский КАК ЭмитентРоссийский,
		|	ТаблицаЦБ.ТоргуетсяНаММВБ КАК ТоргуетсяНаММВБ
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОцененныеБумаги КАК ОцененныеБумаги
		|		ПО (ОцененныеБумаги.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (Биржи.Ссылка = ОцененныеБумаги.Источник)";
	
	#КонецОбласти
	
	ТолькоНаблюдаемыеЦены = ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены;
	
	ДоступныеБиржи = Новый Массив;
	ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	
	ММВБ		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	Блумберг	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
	НРД			= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");	
	
	КалендарьКотировок			= Константы.ОсновнойКалендарьКотировок.Получить();	
	ПоследняяДатаТоргов			= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьКотировок, НачалоДня(ДатаПереоценки));	
	ПоследняяДатаТорговБлумберг	= РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки, Блумберг);	
	ТорговыхДнейНазад10			= Справочники.Календари.ДобавитьКДатеРабочиеДни(КалендарьКотировок, НачалоДня(ДатаПереоценки), -10);
	
	МетодикиРублевыхОблигацийНРД = Новый Массив;
	
	Если ДатаПереоценки >= '20210101' Тогда
		МетодикиРублевыхОблигацийНРД.Добавить("bond");
		МетодикиРублевыхОблигацийНРД.Добавить("floating_bond");
		МетодикиРублевыхОблигацийНРД.Добавить("mortgage_bond");
		МетодикиРублевыхОблигацийНРД.Добавить("unrated_bond");
	КонецЕсли;
	
	ИгнорироватьТипОблигацииНРД = (МетодикиРублевыхОблигацийНРД.Количество() = 0);
	
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",			ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберг",	ПоследняяДатаТорговБлумберг);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10",			ТорговыхДнейНазад10);
	
	Запрос.УстановитьПараметр("ММВБ",							ММВБ);
	Запрос.УстановитьПараметр("НРД",							НРД);
	Запрос.УстановитьПараметр("Блумберг",						Блумберг);
	
	Запрос.УстановитьПараметр("Режим_BGN",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	Запрос.УстановитьПараметр("ВалютаРубли",					ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	Запрос.УстановитьПараметр("ДоступныеБиржи",					ДоступныеБиржи);
	
	Запрос.УстановитьПараметр("ИгнорироватьТипОблигацииНРД",	ИгнорироватьТипОблигацииНРД);
	Запрос.УстановитьПараметр("МетодикиРублевыхОблигацийНРД",	МетодикиРублевыхОблигацийНРД);
	
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены",			ТолькоНаблюдаемыеЦены);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Доверия", "Таблица стоимостей ЦБ");		
	КонецЕсли;
	
	Если ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;
	
	// Расчетные цены 	
	
	ВыполненРасчетЦены = Ложь;	
	
	ПараметрыОценки.Вставить("ПараметрыМоделиCAPM",				Новый Структура("Бета", 1));
	ПараметрыОценки.Вставить("ТочностьСтавкиДисконтирования",	2);
	ПараметрыОценки.Вставить("ТочностьDCF",						4);

	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	
	ЦеныНРДНаДатуОценки					= Неопределено;
	ЦеныНРДПоследнегоТорговогоДня		= Неопределено;
	ЦеныПоследнегоТорговогоДняBloomberg	= Неопределено;
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		Если СтрокаСтоимостейЦБ.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.Номинал Тогда
			Продолжить; // Для погашенных ЦБ дополнительные действия не требуются
		КонецЕсли;

		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены) Тогда
			Продолжить;
		КонецЕсли;
		
		// Требуется расчет цены
		
		ОшибкаРасчета = Ложь;
		
		Если ДатаПереоценки >= '20200301' Тогда
		
			Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				
				#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков							
				
				ЦенаЗаполнена = ЗаполнитьДисконтированнойПоБезрисковойСтавкеДоходностиСтоимостью(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, ПараметрыДенежногоПотока, , 2, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, , Отказ, РасшифровкаРасчета);
				
				Если ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
				КонецЕсли;				
				
				#КонецОбласти
				
				Если СтрокаСтоимостейЦБ.Стоимость = 0 Тогда
					
					#Область Расчетные_цены_3_метода_по_методике_НРД_после_2018_года					
					
					Если ЦеныНРДНаДатуОценки = Неопределено Тогда
						ЦеныНРДНаДатуОценки = ПолучитьЦеныНРД(ТаблицаСтоимостейЦБ, НачалоДня(ДатаПереоценки), РасшифровкаРасчета);
					КонецЕсли;
					
					ЦеныНРДТекущейЦБ = ЦеныНРДНаДатуОценки.Скопировать(Новый Структура("ЦеннаяБумага, VERSION, METHOD_NUMBER", СтрокаСтоимостейЦБ.ЦеннаяБумага, "2", "3")); 
					
					Если ЦеныНРДТекущейЦБ.Количество() = 0 Тогда
						Если ЦеныНРДПоследнегоТорговогоДня = Неопределено Тогда
							ЦеныНРДПоследнегоТорговогоДня = ПолучитьЦеныНРД(ТаблицаСтоимостейЦБ, ПоследняяДатаТоргов, РасшифровкаРасчета);
						КонецЕсли;	
							
						ЦеныНРДТекущейЦБ = ЦеныНРДПоследнегоТорговогоДня.Скопировать(Новый Структура("ЦеннаяБумага, VERSION, METHOD_NUMBER", СтрокаСтоимостейЦБ.ЦеннаяБумага, "2", "3")); 
					КонецЕсли;
					
					Если ЦеныНРДТекущейЦБ.Количество() > 0 Тогда

						СтрокаСтоимостейЦБ.Стоимость		= ЦеныНРДТекущейЦБ[0].Цена;
						СтрокаСтоимостейЦБ.ДатаЦены			= ЦеныНРДТекущейЦБ[0].ДатаЦены;
						СтрокаСтоимостейЦБ.УровеньОценки	= 3;
						СтрокаСтоимостейЦБ.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД;
						СтрокаСтоимостейЦБ.Источник			= НРД;
						СтрокаСтоимостейЦБ.ВалютаКотировки	= СтрокаСтоимостейЦБ.ВалютаНоминала;

						ВыполненРасчетЦены = Истина;
						
					КонецЕсли;
					
					#КонецОбласти
			
				КонецЕсли;

			ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда	
				
				Если СтрокаСтоимостейЦБ.ЭмитентРоссийский И СтрокаСтоимостейЦБ.ТоргуетсяНаММВБ Тогда
				
					#Область Расчет_на_основе_корректировки_исторической_цены
					
					// Справедливая стоимость акций российских эмитентов, допущенным к торгам на ММВБ,
					// определяется в соответствии с моделью оценки, основанной на корректировке исторической цены (CAPM).
					// Применяем при отсутствии цены не более 10 торговых дней
					
					ТочностьЦены = ?(ДатаПереоценки >= '20210101', 6, Неопределено);
					
					ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, КалендарьКотировок, , ТочностьЦены, Отказ, РасшифровкаРасчета);
					
					Если ЦенаЗаполнена Тогда
						ВыполненРасчетЦены = Истина;
					КонецЕсли;
					
					#КонецОбласти
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			#Область Расчетные_цены_по_методике_НРД_после_2018_года

			// По письму НПФ Доверие от 31.12.2019 в спецдеп:
			// до 01.03.2020 можно брать цену НРД по методикам, утвержденным 21.02.2018
			
			Если ЦеныНРДНаДатуОценки = Неопределено Тогда
				ЦеныНРДНаДатуОценки = ПолучитьЦеныНРД(ТаблицаСтоимостейЦБ, НачалоДня(ДатаПереоценки), РасшифровкаРасчета);
			КонецЕсли;
			
			ЦеныНРДТекущейЦБ = ЦеныНРДНаДатуОценки.Скопировать(Новый Структура("ЦеннаяБумага, VERSION", СтрокаСтоимостейЦБ.ЦеннаяБумага, "2")); 
			
			Если ЦеныНРДТекущейЦБ.Количество() = 0 Тогда
				Если ЦеныНРДПоследнегоТорговогоДня = Неопределено Тогда
					ЦеныНРДПоследнегоТорговогоДня = ПолучитьЦеныНРД(ТаблицаСтоимостейЦБ, ПоследняяДатаТоргов, РасшифровкаРасчета);
				КонецЕсли;	
					
				ЦеныНРДТекущейЦБ = ЦеныНРДПоследнегоТорговогоДня.Скопировать(Новый Структура("ЦеннаяБумага, VERSION", СтрокаСтоимостейЦБ.ЦеннаяБумага, "2")); 
			КонецЕсли;
			
			Если ЦеныНРДТекущейЦБ.Количество() > 0 Тогда
				
				СтрокаСтоимостейЦБ.Стоимость		= ЦеныНРДТекущейЦБ[0].Цена;
				СтрокаСтоимостейЦБ.ДатаЦены			= ЦеныНРДТекущейЦБ[0].ДатаЦены;
				СтрокаСтоимостейЦБ.УровеньОценки	= 3;
				СтрокаСтоимостейЦБ.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД;
				СтрокаСтоимостейЦБ.Источник			= НРД;
				СтрокаСтоимостейЦБ.ВалютаКотировки	= СтрокаСтоимостейЦБ.ВалютаНоминала;

				ВыполненРасчетЦены = Истина;
				
			КонецЕсли;

			#КонецОбласти

		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость = 0 И Не СтрокаСтоимостейЦБ.ЭмитентРоссийский Тогда

			#Область Цены_Bloomberg			
			
			Если ЦеныПоследнегоТорговогоДняBloomberg = Неопределено Тогда
				
				#Область Получение_цен_Bloomberg_последнего_торгового_дня
					
				Запрос = Новый Запрос( 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ТаблицаСтоимостейЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
					|	ТаблицаСтоимостейЦБ.Рынок КАК Рынок,
					|	ТаблицаСтоимостейЦБ.Номинал КАК Номинал
					|ПОМЕСТИТЬ ТаблицаЦБ
					|ИЗ
					|	&ТаблицаСтоимостейЦБ КАК ТаблицаСтоимостейЦБ
					|ГДЕ
					|	ТаблицаСтоимостейЦБ.Стоимость = 0
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ТаблицаЦБ.Рынок КАК Рынок,
					|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
					|	ВЫБОР
					|		КОГДА КотировкиБлумбергBGN.CLOSE ЕСТЬ НЕ NULL 
					|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ЦенаПоследнейСделки)
					|		КОГДА КотировкиБлумбергBVAL.WAPRICE ЕСТЬ НЕ NULL 
					|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СредневзвешеннаяЦена)
					|	КОНЕЦ КАК ВидЦены,
					|	&ПоследняяДатаТорговБлумберг КАК ДатаЦены,
					|	ВЫБОР
					|		КОГДА КотировкиБлумбергBGN.CLOSE ЕСТЬ НЕ NULL 
					|			ТОГДА КотировкиБлумбергBGN.CLOSE
					|		КОГДА КотировкиБлумбергBVAL.WAPRICE ЕСТЬ НЕ NULL 
					|			ТОГДА КотировкиБлумбергBVAL.WAPRICE
					|	КОНЕЦ КАК Цена,
					|	ВЫБОР
					|		КОГДА КотировкиБлумбергBGN.CLOSE ЕСТЬ НЕ NULL 
					|			ТОГДА КотировкиБлумбергBGN.РежимТоргов
					|		КОГДА КотировкиБлумбергBVAL.WAPRICE ЕСТЬ НЕ NULL 
					|			ТОГДА КотировкиБлумбергBVAL.РежимТоргов
					|	КОНЕЦ КАК РежимТоргов
					|ИЗ
					|	ТаблицаЦБ КАК ТаблицаЦБ
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиБлумбергBGN
					|		ПО (КотировкиБлумбергBGN.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
					|			И (КотировкиБлумбергBGN.Рынок = ТаблицаЦБ.Рынок)
					|			И (КотировкиБлумбергBGN.Биржа = &Блумберг)
					|			И (КотировкиБлумбергBGN.РежимТоргов = &Режим_BGN)
					|			И (КотировкиБлумбергBGN.Период = &ПоследняяДатаТорговБлумберг)
					|			И (КотировкиБлумбергBGN.CLOSE <> 0)
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиБлумбергBVAL
					|		ПО (КотировкиБлумбергBVAL.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
					|			И (КотировкиБлумбергBVAL.Рынок = ТаблицаЦБ.Рынок)
					|			И (КотировкиБлумбергBVAL.Биржа = &Блумберг)
					|			И (КотировкиБлумбергBVAL.РежимТоргов = &Режим_BVAL)
					|			И (КотировкиБлумбергBVAL.Период = &ПоследняяДатаТорговБлумберг)
					|			И (КотировкиБлумбергBVAL.WAPRICE <> 0)
					|ГДЕ
					|	(КотировкиБлумбергBGN.CLOSE ЕСТЬ НЕ NULL 
					|			ИЛИ КотировкиБлумбергBVAL.WAPRICE ЕСТЬ НЕ NULL )");
				
				Запрос.УстановитьПараметр("Блумберг",					 Блумберг);
				Запрос.УстановитьПараметр("Режим_BGN",					 ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
				Запрос.УстановитьПараметр("Режим_BVAL",					 ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
				Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберг", ПоследняяДатаТорговБлумберг);				
				Запрос.УстановитьПараметр("ТаблицаСтоимостейЦБ",		 ТаблицаСтоимостейЦБ);
				
				ЦеныПоследнегоТорговогоДняBloomberg = Запрос.Выполнить().Выгрузить();
				
				Если РасшифровкаРасчета <> Неопределено Тогда
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Цены Bloomberg последнего торгового дня", ЦеныПоследнегоТорговогоДняBloomberg.Скопировать());
				КонецЕсли;					

				#КонецОбласти
				
			КонецЕсли;

			ЦеныBloombergТекущейЦБ = ЦеныПоследнегоТорговогоДняBloomberg.Скопировать(Новый Структура("ЦеннаяБумага", СтрокаСтоимостейЦБ.ЦеннаяБумага)); 
			
			Если ЦеныBloombergТекущейЦБ.Количество() > 0 Тогда

				СтрокаСтоимостейЦБ.Стоимость		= ЦеныBloombergТекущейЦБ[0].Цена;
				СтрокаСтоимостейЦБ.ДатаЦены			= ЦеныBloombergТекущейЦБ[0].ДатаЦены;
				СтрокаСтоимостейЦБ.УровеньОценки	= 2;
				СтрокаСтоимостейЦБ.ВидЦены			= ЦеныBloombergТекущейЦБ[0].ВидЦены;
				СтрокаСтоимостейЦБ.Источник			= Блумберг;
				СтрокаСтоимостейЦБ.ВалютаКотировки	= СтрокаСтоимостейЦБ.ВалютаНоминала;

				ВыполненРасчетЦены = Истина;
				
			КонецЕсли;
			
			#КонецОбласти
			
		КонецЕсли;		
		
	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "После расчета цен", ТаблицаСтоимостейЦБ.Скопировать());	
	КонецЕсли;
		
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныСбербанкаСтрахование(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	#Область Основной_запрос	
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаСпискаЦБ.Количество КАК Количество
		|ПОМЕСТИТЬ _ТаблицаСпискаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	_ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	СУММА(_ТаблицаСпискаЦБ.Количество) КАК Количество
		|ПОМЕСТИТЬ _ИсходнаяТаблицаЦБ
		|ИЗ
		|	_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
		|
		|СГРУППИРОВАТЬ ПО
		|	_ТаблицаСпискаЦБ.ЦеннаяБумага,
		|	_ТаблицаСпискаЦБ.Рынок,
		|	_ТаблицаСпискаЦБ.ВалютаНоминала
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	Эмитенты.Ссылка КАК Эмитент,
		|	Эмитенты.ЮрФизЛицо КАК ЮрЛицоЭмитента
		|ПОМЕСТИТЬ _ЭмитентыЦенныхБумаг
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Векселя КАК Векселя
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Векселя.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеРасписки КАК ДепозитарныеРасписки
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = ДепозитарныеРасписки.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = ИпотечныеСертификатыУчастия.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|		ПО (Эмитенты.Ссылка = ВЫБОР
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|					ТОГДА Акции.Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|					ТОГДА Облигации.Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|					ТОГДА Векселя.Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|					ТОГДА ДепозитарныеРасписки.Эмитент
		|				КОГДА _ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|					ТОГДА ИпотечныеСертификатыУчастия.Эмитент
		|			КОНЕЦ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	_ИсходнаяТаблицаЦБ.Количество КАК Количество,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента КАК Эмитент,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК ТоргуетсяНаММВБ,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, НЕОПРЕДЕЛЕНО) КАК ДатаПогашения,
		|	ЕСТЬNULL(Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация), ЛОЖЬ) КАК Еврооблигация,
		|	ЕСТЬNULL(Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная), ЛОЖЬ) КАК КорпоративнаяОблигация,
		|	ЕСТЬNULL(Облигации.Категория В (ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная), ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Муниципальная)), ЛОЖЬ) КАК ГосударственнаяОблигация,
		|	ЕСТЬNULL(Облигации.ДатаПогашения <> ДАТАВРЕМЯ(1, 1, 1)
		|			И Облигации.ДатаПогашения <= &КалендарныхДнейНазад90, ЛОЖЬ) КАК СчитаемЧтоДефолт
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЭмитентыЦенныхБумаг КАК _ЭмитентыЦенныхБумаг
		|		ПО (_ЭмитентыЦенныхБумаг.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО (Облигации.Ссылка = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						_ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ИСТИНА
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|					ГДЕ
		|						_ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО (НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, Статус, Биржа, Рынок) В
		|					(ВЫБРАТЬ
		|						_ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже),
		|						&ММВБ,
		|						_ИсходнаяТаблицаЦБ.Рынок
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО (СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа КАК Биржа,
