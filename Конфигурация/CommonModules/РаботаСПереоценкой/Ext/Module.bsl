		|		ПО (Котировки_Bloomberg_BGN.Рынок = _ПервыйУровень.Рынок)
		|			И (Котировки_Bloomberg_BGN.ЦеннаяБумага = _ПервыйУровень.ЦеннаяБумага)
		|			И (Котировки_Bloomberg_BGN.Период = &ДатаОценки)
		|			И (Котировки_Bloomberg_BGN.Биржа = &Блумберг)
		|			И (Котировки_Bloomberg_BGN.РежимТоргов = &Режим_BGN)
		|			И (_ПервыйУровень.ВидАктива <> ""РоссийскиеЦБ"")
		|			И (&ДоступныДанныеBloomberg)
		|			И (&ОцениватьОВОЗРФиИностранныеБумагиПоБлумбергу)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК Котировки_Bloomberg_BVAL
		|		ПО (Котировки_Bloomberg_BVAL.Рынок = _ПервыйУровень.Рынок)
		|			И (Котировки_Bloomberg_BVAL.ЦеннаяБумага = _ПервыйУровень.ЦеннаяБумага)
		|			И (Котировки_Bloomberg_BVAL.Период = &ДатаОценки)
		|			И (Котировки_Bloomberg_BVAL.Биржа = &Блумберг)
		|			И (Котировки_Bloomberg_BVAL.РежимТоргов = &Режим_BVAL)
		|			И (_ПервыйУровень.ВидАктива <> ""РоссийскиеЦБ"")
		|			И (&ДоступныДанныеBloomberg)
		|			И (&ОцениватьОВОЗРФиИностранныеБумагиПоБлумбергу)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВторойУровень.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ВторойУровень.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	_ВторойУровень.ВалютаНоминала КАК ВалютаНоминала,
		|	ЕСТЬNULL(_ВторойУровень.Стоимость, 0) * ВЫБОР
		|		КОГДА _ВторойУровень.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА НоминалыЦенныхБумагСрезПоследних.Номинал / 100
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК Стоимость,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, ЕСТЬNULL(_ВторойУровень.Источник, 0)) КАК Источник,
		|	ЕСТЬNULL(_ВторойУровень.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(_ВторойУровень.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(_ВторойУровень.ВидЦены, 0) КАК ВидЦены,
		|	ВЫБОР
		|		КОГДА _ВторойУровень.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА _ВторойУровень.ВалютаНоминала
		|		ИНАЧЕ _ВторойУровень.ВалютаКотировок
		|	КОНЕЦ КАК ВалютаКотировки,
		|	_ВторойУровень.РежимТоргов КАК РежимТоргов,
		|	_ВторойУровень.ВидАктива КАК ВидАктива,
		|	_ВторойУровень.ПоследнийТорговыйДень КАК ПоследнийТорговыйДень,
		|	ВЫБОР
		|		КОГДА &ЕдиныйПорядокОпределенияКупона
		|			ТОГДА _КотировкиКупонов.Купон
		|		ИНАЧЕ ЕСТЬNULL(_ВторойУровень.Купон, КотировкиЦенныхБумаг.ACCINT)
		|	КОНЕЦ КАК Купон,
		|	ВЫБОР
		|		КОГДА &ЕдиныйПорядокОпределенияКупона
		|			ТОГДА _КотировкиКупонов.ВалютаКупона
		|		КОГДА _ВторойУровень.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА _ВторойУровень.Купон ЕСТЬ НЕ NULL 
		|						ТОГДА _ВторойУровень.ВалютаКупона
		|					ИНАЧЕ ВЫБОР
		|							КОГДА КотировкиЦенныхБумаг.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|								ТОГДА _ВторойУровень.ВалютаНоминала
		|							ИНАЧЕ КотировкиЦенныхБумаг.Валюта
		|						КОНЕЦ
		|				КОНЕЦ
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|	КОНЕЦ КАК ВалютаКупона,
		|	ВЫБОР
		|		КОГДА РеквизитыКонечногоЗаемщика.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка))
		|			ТОГДА _РеквизитыОблигаций.КонечныйЗаемщик
		|	КОНЕЦ КАК РоссийскийЗаемщик
		|ИЗ
		|	_ВторойУровень КАК _ВторойУровень
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (Биржи.Ссылка = _ВторойУровень.Источник)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаОценки,
		|				ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						_ВторойУровень.ЦеннаяБумага
		|					ИЗ
		|						_ВторойУровень
		|					ГДЕ
		|						ТИПЗНАЧЕНИЯ(_ВторойУровень.ЦеннаяБумага) = ТИП(Справочник.Облигации))) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО _ВторойУровень.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ #КотировкиКупонов# КАК _КотировкиКупонов
		|		ПО (_КотировкиКупонов.Облигация = _ВторойУровень.ЦеннаяБумага)
		|			И (&ЕдиныйПорядокОпределенияКупона)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиЦенныхБумаг КАК КотировкиЦенныхБумаг
		|		ПО (КотировкиЦенныхБумаг.Рынок = _ВторойУровень.Рынок)
		|			И (КотировкиЦенныхБумаг.ЦеннаяБумага = _ВторойУровень.ЦеннаяБумага)
		|			И (КотировкиЦенныхБумаг.Биржа = &ММВБ)
		|			И (КотировкиЦенныхБумаг.Период = &ДатаОценки)
		|			И (_ВторойУровень.ПоследнийТорговыйДень <> &ДатаОценки
		|				ИЛИ _ВторойУровень.Купон ЕСТЬ NULL)
		|			И (НЕ &ЕдиныйПорядокОпределенияКупона)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыОблигаций КАК _РеквизитыОблигаций
		|		ПО (_РеквизитыОблигаций.Ссылка = _ВторойУровень.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОценки,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						_РеквизитыОблигаций.КонечныйЗаемщик
		|					ИЗ
		|						_РеквизитыОблигаций)) КАК РеквизитыКонечногоЗаемщика
		|		ПО (РеквизитыКонечногоЗаемщика.ЮрФизЛицо = _РеквизитыОблигаций.КонечныйЗаемщик)";

	#Область Вспомогательный_запрос_количества_котировок_на_дату_оценки	
	
	ЗапросКоличестваКотировок = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КотировкиТорговыхПлощадок.Биржа) КАК КоличествоТорговыхПлощадок,
		|	КОЛИЧЕСТВО(*) КАК КоличествоКотировок
		|ИЗ
		|	РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|ГДЕ
		|	КотировкиТорговыхПлощадок.Период = &ДатаОценки");

	ЗапросКоличестваКотировок.УстановитьПараметр("ДатаОценки", НачалоДня(ДатаПереоценки));
	
	СтатистикаПоКотировкамНаДатуОЦенки = ЗапросКоличестваКотировок.Выполнить().Выгрузить()[0];
	
	#КонецОбласти	
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1000000", Формат(СтатистикаПоКотировкамНаДатуОЦенки.КоличествоТорговыхПлощадок * ТаблицаЦБ.Количество(), "ЧН=; ЧГ=; ЧФ='ПЕРВЫЕ Ч'"));;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 2000000", Формат(СтатистикаПоКотировкамНаДатуОЦенки.КоличествоКотировок, "ЧН=; ЧГ=; ЧФ='ПЕРВЫЕ Ч'"));;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#КотировкиКупонов#",
		?(ЕдиныйПорядокОпределенияКупона, "_КотировкиКупонов", "(ВЫБРАТЬ NULL КАК Облигация, NULL КАК Купон, NULL КАК ВалютаКупона)"));
	
	#КонецОбласти	
	
	#Область Заполнение_доступных_бирж
	
	ДоступныеБиржи = Новый Массив;
	ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	
	Если ДатаПереоценки >= '20240301' Тогда
		ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_SPBEX"));
	Иначе
		ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_NYSE"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_NYSE_Arca"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_HKEX"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_FWB"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_LSE"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Paris"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Lisbon"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Brussels"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Amsterdam"));
	    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_London"));
	КонецЕсли;
	
	#КонецОбласти
	
	ОсновнойКалендарьКотировок	= Константы.ОсновнойКалендарьКотировок.Получить();
	ИностранныеУчетныеАктивы	= Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();	

	ММВБ		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
