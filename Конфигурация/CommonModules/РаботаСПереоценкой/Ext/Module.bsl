	ММВБ_2_2_1_БратьКупонТолькоНаДатуОценки			= (ДатаПереоценки >= '20220228');
	Купоны_2_2_БратьКупонТолькоВКонецМесяца			= (ДатаПереоценки >= '20220228');
	До_П_2_2_5_ПриоритетКупонаКотировокЦенныхБумаг	= (ДатаПереоценки <= '20220228');
	
