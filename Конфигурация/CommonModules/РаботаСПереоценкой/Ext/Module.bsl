		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(ОцененныеБумаги.СправедливаяЦена * ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|			ИНАЧЕ ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(ОцененныеБумаги.Валюта, 0) КАК Валюта,
