	Запрос.УстановитьПараметр("ДатаЦенНРД",						ДатаЦенНРД);
	
	Запрос.УстановитьПараметр("ММВБ",							ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("НРД",							ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("ВалютаРубли",					ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));

	Если РасшифровкаРасчета <> Неопределено Тогда
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Расчет СЧА ЗПИФк ФДЦБ", "Предварительная таблица стоимостей ЦБ");		
	Иначе
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Если ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;
	
	// Расчетные цены
	
	ПараметрыОценки.Вставить("ТочностьСтавкиДисконтирования", 2);
	
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены) Тогда
			Продолжить;
		КонецЕсли;
		
		// Расчет цены
		
		Если СтрокаСтоимостейЦБ.ЭмитентРоссийский Тогда
			
			Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				
				Если СтрокаСтоимостейЦБ.НоминированаВРублях Тогда
					
					#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков 
					
					// Цена, рассчитанная по модели дисконтирования стоимости будущих денежных потоков (DCF)
					
					ЗаполнитьДисконтированнойПоБезрисковойСтавкеДоходностиСтоимостью(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, ПараметрыДенежногоПотока, Истина, 2, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, , Отказ, РасшифровкаРасчета);

					#КонецОбласти
						
				КонецЕсли;
				
			Иначе
				
				#Область Расчет_на_основе_корректировки_исторической_цены				
				
				// Справедливая стоимость ценных бумаг, обращающихся на российских и иностранных фондовых биржах,
				// определяется в соответствии с моделью оценки, основанной на корректировке исторической цены. 				
				// Применяем при отсутствии цены не более 10 рабочих дней
				
				ПоследняяНаблюдаемаяЦена = ПолучитьПоследнююНаблюдаемуюЦену(ПараметрыОценки, ДатаПереоценки, СтрокаСтоимостейЦБ.ЦеннаяБумага, 10, Справочники.Календари.Общероссийский, Отказ);
				
				Если ПоследняяНаблюдаемаяЦена = Неопределено Тогда
					Если РасшифровкаРасчета <> Неопределено Тогда	
						ПараметрыРасчетаЦен = Новый Структура("НаблюдаемаяЦена", "За последние 10 рабочих дней не найдена");
						РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Получить цены СЧА ЗПИФк ФДЦБ", "Параметры расчета цены (уровень 2)", ПараметрыРасчетаЦен);
					КонецЕсли;
					
					Продолжить;
				КонецЕсли;				 
				
				// Расчет корректировки цены
				
				Если РасшифровкаРасчета <> Неопределено Тогда	
					ПараметрыРасчетаЦен = Новый Структура("НаблюдаемаяЦена, ДатаПоследнейЦены, Расчет", ПоследняяНаблюдаемаяЦена.Стоимость, ПоследняяНаблюдаемаяЦена.ДатаПоследнейЦены, "Расчет не реализован");
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Получить цены СЧА ЗПИФк ФДЦБ", "Параметры расчета цены (уровень 2)", ПараметрыРасчетаЦен);
				КонецЕсли;
				
				#КонецОбласти
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "Таблица стоимостей ЦБ", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;	
	
КонецФункции

Функция ПолучитьЦеныЗПИФкФДЦБ2021(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ);
	ПоместитьЭмитентовЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "_ИсходнаяТаблицаЦБ");	
	
	#Область Основной_запрос	
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала = &ВалютаРубли КАК НоминированаВРублях,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК ТоргуетсяНаММВБ,
		|	ЕСТЬNULL(Облигации.ДатаПогашения <> ДАТАВРЕМЯ(1, 1, 1)
		|			И Облигации.ДатаПогашения < ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -7), ЛОЖЬ) КАК СчитаемЧтоДефолт,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, НЕОПРЕДЕЛЕНО) КАК ДатаПогашения,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЭмитентРоссийский,
		|	_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента КАК Эмитент
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						_ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ИСТИНА
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|					ГДЕ
		|						_ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, Статус, Биржа, Рынок) В
		|					(ВЫБРАТЬ
		|						_ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже),
		|						&ММВБ,
		|						_ИсходнаяТаблицаЦБ.Рынок
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЭмитентыЦенныхБумаг КАК _ЭмитентыЦенныхБумаг
		|		ПО (_ЭмитентыЦенныхБумаг.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента
		|					ИЗ
		|						_ЭмитентыЦенныхБумаг)) КАК РеквизитыЮрЛицаЭмитента
		|		ПО (РеквизитыЮрЛицаЭмитента.ЮрФизЛицо = _ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА _ТаблицаЦБ.ТоргуетсяНаММВБ
		|				И _ТаблицаЦБ.ЭмитентРоссийский
		|			ТОГДА &ММВБ
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК Биржа
		|ПОМЕСТИТЬ _ОсновныеРынкиЦБ
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОсновныеРынкиЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.Период КАК Период,
		|	КотировкиТорговыхПлощадок.РежимТоргов КАК РежимТоргов,
		|	КотировкиТорговыхПлощадок.Валюта КАК Валюта,
		|	КотировкиТорговыхПлощадок.NUMTRADES КАК КоличествоСделок,
		|	КотировкиТорговыхПлощадок.VALUE КАК ОбъемСделок,
		|	КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ _КотировкиММВБЗаПоследние10ТорговыхДней
		|ИЗ
		|	_ОсновныеРынкиЦБ КАК _ОсновныеРынкиЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.Рынок = _ОсновныеРынкиЦБ.Рынок)
		|			И (КотировкиТорговыхПлощадок.ЦеннаяБумага = _ОсновныеРынкиЦБ.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Биржа = _ОсновныеРынкиЦБ.Биржа)
		|			И (КотировкиТорговыхПлощадок.Период МЕЖДУ &ТорговыхДнейНазад10 И &ДатаПереоценки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта)
		|			И (КотировкиТорговыхПлощадок.Период = КурсыВалют.Период)
		|ГДЕ
		|	_ОсновныеРынкиЦБ.Биржа = &ММВБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_КотировкиММВБЗаПоследние10ТорговыхДней.Период КАК Период,
		|	СУММА(_КотировкиММВБЗаПоследние10ТорговыхДней.КоличествоСделок) КАК КоличествоСделок,
		|	СУММА(_КотировкиММВБЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета) КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ _ИтогиММВБЗаПоследние10ТорговыхДней
		|ИЗ
		|	_КотировкиММВБЗаПоследние10ТорговыхДней КАК _КотировкиММВБЗаПоследние10ТорговыхДней
		|
		|СГРУППИРОВАТЬ ПО
		|	_КотировкиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага,
		|	_КотировкиММВБЗаПоследние10ТорговыхДней.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОсновныеРынкиЦБ.Рынок КАК Рынок,
		|	_ОсновныеРынкиЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ОсновныеРынкиЦБ.Биржа КАК Биржа,
		|	СУММА(_ИтогиММВБЗаПоследние10ТорговыхДней.КоличествоСделок) КАК КоличествоСделок,
		|	СУММА(_ИтогиММВБЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета) КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ _АктивыйРынокММВБ
		|ИЗ
		|	_ОсновныеРынкиЦБ КАК _ОсновныеРынкиЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ИтогиММВБЗаПоследние10ТорговыхДней КАК _ИтогиММВБЗаПоследние10ТорговыхДней
		|		ПО (_ИтогиММВБЗаПоследние10ТорговыхДней.ЦеннаяБумага = _ОсновныеРынкиЦБ.ЦеннаяБумага)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ОсновныеРынкиЦБ.Рынок,
		|	_ОсновныеРынкиЦБ.ЦеннаяБумага,
		|	_ОсновныеРынкиЦБ.Биржа
		|
		|ИМЕЮЩИЕ
		|	СУММА(_ИтогиММВБЗаПоследние10ТорговыхДней.ОбъемСделокВВалютеУчета) > 500000 И
		|	СУММА(_ИтогиММВБЗаПоследние10ТорговыхДней.КоличествоСделок) >= 10
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивыйРынокММВБ.Рынок КАК Рынок,
		|	_АктивыйРынокММВБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_АктивыйРынокММВБ.Биржа КАК Биржа,
		|	КотировкиЦенныхБумаг.Период КАК Период,
		|	КотировкиЦенныхБумаг.РежимТоргов КАК РежимТоргов,
		|	КотировкиЦенныхБумаг.Валюта КАК Валюта,
		|	КотировкиЦенныхБумаг.BID КАК BID,
		|	КотировкиЦенныхБумаг.OFFER КАК OFFER,
		|	КотировкиЦенныхБумаг.HIGH КАК HIGH,
		|	КотировкиЦенныхБумаг.LOW КАК LOW,
		|	КотировкиЦенныхБумаг.WAPRICE КАК WAPRICE,
		|	КотировкиЦенныхБумаг.VALUE КАК VALUE,
		|	КотировкиЦенныхБумаг.LEGALCLOSEPRICE КАК LEGALCLOSEPRICE,
		|	КотировкиЦенныхБумаг.VOLUME КАК ОбъемСделокШтукБумаг,
		|	КотировкиЦенныхБумаг.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ _КотировкиАктивногоРынкаММВБ
		|ИЗ
		|	_АктивыйРынокММВБ КАК _АктивыйРынокММВБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиЦенныхБумаг
		|		ПО (КотировкиЦенныхБумаг.ЦеннаяБумага = _АктивыйРынокММВБ.ЦеннаяБумага)
		|			И (КотировкиЦенныхБумаг.Рынок = _АктивыйРынокММВБ.Рынок)
		|			И (КотировкиЦенныхБумаг.Биржа = _АктивыйРынокММВБ.Биржа)
		|			И (КотировкиЦенныхБумаг.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиЦенныхБумаг.Период = &ПоследнийТорговыйДень)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КурсыВалют.Период = &ДатаПереоценки)
