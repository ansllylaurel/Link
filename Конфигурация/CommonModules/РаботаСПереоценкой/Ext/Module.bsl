		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Югории Страхование (ЕПС)", "Таблица стоимостей ЦБ", , , "_ИсходнаяТаблицаЦБ, _ПриоритетРежимаТорговКотировокММВБ_Служебный");		
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныПредоставленныеКлиентом(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, ТаблицаСтоимостей, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;

	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ТаблицаЦБ");

	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаСтоимостей, "_СтоимостиПредоставленныеКлиентом", Запрос.МенеджерВременныхТаблиц);

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СтоимостиПредоставленныеКлиентом.*
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СтоимостиПредоставленныеКлиентом КАК _СтоимостиПредоставленныеКлиентом
		|		ПО _СтоимостиПредоставленныеКлиентом.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага";

	ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();

	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "", "Стоимости, предоставленные клиентом", ТаблицаСтоимостейЦБ); 
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныФОГФ(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено) 
	
	#Область Текст_запроса
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок
		|ПОМЕСТИТЬ _ТаблицаСпискаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	ВЫБОР
		|		КОГДА _ТаблицаСпискаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаСпискаЦБ.ЦеннаяБумага КАК Справочник.Акции).ВалютаНоминала
		|		КОГДА _ТаблицаСпискаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаСпискаЦБ.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала
		|		КОГДА _ТаблицаСпискаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаСпискаЦБ.ЦеннаяБумага КАК Справочник.Паи).ВалютаНоминала
		|		КОГДА _ТаблицаСпискаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаСпискаЦБ.ЦеннаяБумага КАК Справочник.Векселя).ВалютаНоминала
		|		КОГДА _ТаблицаСпискаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаСпискаЦБ.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).ВалютаНоминала
		|		КОГДА _ТаблицаСпискаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаСпискаЦБ.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ВалютаНоминала
		|	КОНЕЦ КАК ВалютаНоминала,
		|	ВЫБОР
		|		КОГДА _ТаблицаСпискаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаСпискаЦБ.ЦеннаяБумага КАК Справочник.Акции).УчетныйАктивЦБРФ
		|		КОГДА _ТаблицаСпискаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаСпискаЦБ.ЦеннаяБумага КАК Справочник.Облигации).УчетныйАктивЦБРФ
		|		КОГДА _ТаблицаСпискаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаСпискаЦБ.ЦеннаяБумага КАК Справочник.Паи).УчетныйАктивЦБРФ
		|		КОГДА _ТаблицаСпискаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаСпискаЦБ.ЦеннаяБумага КАК Справочник.Векселя).УчетныйАктивЦБРФ
		|		КОГДА _ТаблицаСпискаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаСпискаЦБ.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).УчетныйАктивЦБРФ
		|		КОГДА _ТаблицаСпискаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаСпискаЦБ.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).УчетныйАктивЦБРФ
		|	КОНЕЦ КАК УчетныйАктивЦБРФ,
		|	ВЫБОР
		|		КОГДА _ТаблицаСпискаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаСпискаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ)
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОВОЗРФ
		|ПОМЕСТИТЬ _ТаблицаСпискаЦБОсновнойВыпуск
		|ИЗ
		|	_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Акции.ОсновнойВыпуск,
		|	_ТаблицаСпискаЦБ.Рынок,
		|	Акции.ОсновнойВыпуск.ВалютаНоминала,
		|	Акции.ОсновнойВыпуск.УчетныйАктивЦБРФ,
		|	ЛОЖЬ
		|ИЗ
		|	_ТаблицаСпискаЦБ КАК _ТаблицаСпискаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО _ТаблицаСпискаЦБ.ЦеннаяБумага = Акции.Ссылка
		|ГДЕ
		|	Акции.ОсновнойВыпуск <> ЗНАЧЕНИЕ(Справочник.Акции.)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ТаблицаСпискаЦБОсновнойВыпуск.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаСпискаЦБОсновнойВыпуск.Рынок КАК Рынок,
		|	ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследних.Номинал, 0) КАК Номинал,
		|	_ТаблицаСпискаЦБОсновнойВыпуск.ВалютаНоминала КАК ВалютаНоминала,
		|	_ТаблицаСпискаЦБОсновнойВыпуск.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	_ТаблицаСпискаЦБОсновнойВыпуск.ОВОЗРФ КАК ОВОЗРФ
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	_ТаблицаСпискаЦБОсновнойВыпуск КАК _ТаблицаСпискаЦБОсновнойВыпуск
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО _ТаблицаСпискаЦБОсновнойВыпуск.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Рынок,
		|	ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.MARKETPRICE3 <> 0
		|			ТОГДА ВЫБОР
		|					КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|						ТОГДА КотировкиТорговыхПлощадок.MARKETPRICE3 * _ТаблицаЦБ.Номинал / 100
		|					ИНАЧЕ КотировкиТорговыхПлощадок.MARKETPRICE3
		|				КОНЕЦ
		|	КОНЕЦ КАК СправедливаяЦена,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.MARKETPRICE3 <> 0
		|			ТОГДА КотировкиТорговыхПлощадок.Биржа.ЮрФизЛицо
		|	КОНЕЦ КАК ИсточникКотировок,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.MARKETPRICE3 <> 0
		|			ТОГДА КотировкиТорговыхПлощадок.Период
		|	КОНЕЦ КАК ДатаЦены,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.MARKETPRICE3 <> 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.РыночнаяЦена3)
		|	КОНЕЦ КАК ПолеЦены,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.MARKETPRICE3 <> 0
		|			ТОГДА КотировкиТорговыхПлощадок.Валюта
		|	КОНЕЦ КАК Валюта,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.Период = &ДатаПереоценки
		|			ТОГДА КотировкиТорговыхПлощадок.ACCINT
		|	КОНЕЦ КАК Купон,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.Период = &ДатаПереоценки
		|			ТОГДА КотировкиТорговыхПлощадок.Валюта
		|	КОНЕЦ КАК ВалютаКупона
		|ПОМЕСТИТЬ _ММВБ
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО _ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадок.Рынок
		|			И _ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
		|ГДЕ
		|	КотировкиТорговыхПлощадок.Период = &ПоследнийТорговыйДень
		|	И КотировкиТорговыхПлощадок.Биржа = &ММВБ
		|	И КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	КотировкиЦенныхБумаг.ACCINT КАК Купон,
		|	ВЫБОР
		|		КОГДА КотировкиЦенныхБумаг.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			ТОГДА _ТаблицаЦБ.ВалютаНоминала
		|		ИНАЧЕ КотировкиЦенныхБумаг.Валюта
		|	КОНЕЦ КАК ВалютаКупона
		|ПОМЕСТИТЬ _КупоныКонцаМесяца
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиЦенныхБумаг КАК КотировкиЦенныхБумаг
		|		ПО (КотировкиЦенныхБумаг.Рынок = _ТаблицаЦБ.Рынок)
		|			И (КотировкиЦенныхБумаг.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (КотировкиЦенныхБумаг.Период = &ДатаПереоценки)
		|			И (КотировкиЦенныхБумаг.Биржа = &ММВБ)
		|			И (&ПоследнийТорговыйДень <> &ДатаПереоценки)
		|			И (КОНЕЦПЕРИОДА(&ДатаПереоценки, ДЕНЬ) = КОНЕЦПЕРИОДА(&ДатаПереоценки, МЕСЯЦ))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА НЕ ОплатаОснования.Ссылка ЕСТЬ NULL
		|			ТОГДА 0
		|		ИНАЧЕ _ТаблицаЦБ.Номинал
		|	КОНЕЦ КАК СправедливаяЦена,
		|	ВЫБОР
		|		КОГДА НЕ ОплатаОснования.Ссылка ЕСТЬ NULL
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|		ИНАЧЕ СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага.Эмитент.ЮрФизЛицо
		|	КОНЕЦ КАК ИсточникКотировок,
		|	ВЫБОР
		|		КОГДА НЕ ОплатаОснования.Ссылка ЕСТЬ NULL
		|			ТОГДА ОплатаОснования.Ссылка.Дата
		|		ИНАЧЕ СтатусыЦенныхБумагСрезПоследних.Период
		|	КОНЕЦ КАК ДатаЦены,
		|	ВЫБОР
		|		КОГДА НЕ ОплатаОснования.Ссылка ЕСТЬ NULL
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.Погашена)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.Номинал)
		|	КОНЕЦ КАК ПолеЦены,
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	0 КАК Купон,
		|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК ВалютаКупона,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаКотировки
		|ПОМЕСТИТЬ _ПослеПогашения
		|ИЗ
		|	Справочник.Облигации КАК Облигации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаЦБ КАК _ТаблицаЦБ
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|					&ДатаПереоценки,
		|					Статус = ЗНАЧЕНИЕ(Перечисление.ЖизненныйЦиклЦенныхБумаг.Погашен)
		|						И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)) КАК СтатусыЦенныхБумагСрезПоследних
		|			ПО _ТаблицаЦБ.Рынок = СтатусыЦенныхБумагСрезПоследних.Рынок
		|				И _ТаблицаЦБ.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПогашениеЦеннойБумаги КАК ПогашениеЦеннойБумаги
		|				ЛЕВОЕ СОЕДИНЕНИЕ Документ.Оплата.Основания КАК ОплатаОснования
		|				ПО ПогашениеЦеннойБумаги.Ссылка = ОплатаОснования.Основание
		|					И (ОплатаОснования.Ссылка.Проведен)
		|			ПО _ТаблицаЦБ.Рынок = ПогашениеЦеннойБумаги.Рынок
		|				И _ТаблицаЦБ.ЦеннаяБумага = ПогашениеЦеннойБумаги.ЦеннаяБумага
		|				И (ПогашениеЦеннойБумаги.Проведен)
		|				И (ПогашениеЦеннойБумаги.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|				И (ПогашениеЦеннойБумаги.ВидПогашения = ЗНАЧЕНИЕ(Перечисление.ВидыПогашения.ПолноеПогашение))
		|		ПО Облигации.Ссылка = _ТаблицаЦБ.ЦеннаяБумага
		|ГДЕ
		|	СтатусыЦенныхБумагСрезПоследних.Активен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.MARKETPRICE3 <> 0
		|			ТОГДА ВЫБОР
		|					КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|						ТОГДА КотировкиТорговыхПлощадок.MARKETPRICE3 * _ТаблицаЦБ.Номинал / 100
		|					ИНАЧЕ КотировкиТорговыхПлощадок.MARKETPRICE3
		|				КОНЕЦ
		|	КОНЕЦ КАК СправедливаяЦена,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.MARKETPRICE3 <> 0
		|			ТОГДА КотировкиТорговыхПлощадок.Биржа.ЮрФизЛицо
		|	КОНЕЦ КАК ИсточникКотировок,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.MARKETPRICE3 <> 0
		|			ТОГДА КотировкиТорговыхПлощадок.Период
		|	КОНЕЦ КАК ДатаЦены,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.MARKETPRICE3 <> 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.РыночнаяЦена3)
		|	КОНЕЦ КАК ПолеЦены,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.MARKETPRICE3 <> 0
		|			ТОГДА КотировкиТорговыхПлощадок.Валюта
		|	КОНЕЦ КАК Валюта,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.Период = &ДатаПереоценки
		|			ТОГДА КотировкиТорговыхПлощадок.ACCINT
		|	КОНЕЦ КАК Купон,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.Период = &ДатаПереоценки
		|			ТОГДА КотировкиТорговыхПлощадок.Валюта
		|	КОНЕЦ КАК ВалютаКупона
		|ПОМЕСТИТЬ _Биржа_СПВБ
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО _ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадок.Рынок
		|			И _ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
		|ГДЕ
		|	КотировкиТорговыхПлощадок.Период = &ПоследнийТорговыйДень
		|	И КотировкиТорговыхПлощадок.Биржа = &Биржа_СПВБ
		|	И КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим
		|	И НЕ _ТаблицаЦБ.ОВОЗРФ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(СтоимостьПереоценки.Период) КАК Период,
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ДатыПоследнихЦен
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаЦБ КАК _ТаблицаЦБ
		|		ПО СтоимостьПереоценки.Рынок = _ТаблицаЦБ.Рынок
		|			И СтоимостьПереоценки.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага
		|ГДЕ
		|	СтоимостьПереоценки.Организация = &Организация
		|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета
		|	И СтоимостьПереоценки.ВидУчета = &ВидУчета
		|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
		|	И СтоимостьПереоценки.Период < &ДатаПереоценки
		|
		|СГРУППИРОВАТЬ ПО
		|	СтоимостьПереоценки.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.Период КАК Период,
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтоимостьПереоценки.ДатаЦены КАК ДатаЦены,
		|	СтоимостьПереоценки.Источник КАК ИсточникКотировок,
		|	СтоимостьПереоценки.ВидЦены КАК ПолеЦены,
		|	СтоимостьПереоценки.ВалютаКотировки КАК ВалютаКотировки,
		|	СтоимостьПереоценки.Цена КАК СправедливаяЦена
		|ПОМЕСТИТЬ _ПоследниеЦены
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|ГДЕ
		|	СтоимостьПереоценки.Организация = &Организация
		|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета
		|	И СтоимостьПереоценки.ВидУчета = &ВидУчета
		|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
		|	И (СтоимостьПереоценки.Период, СтоимостьПереоценки.ЦеннаяБумага) В
		|			(ВЫБРАТЬ
		|				_ДатыПоследнихЦен.Период,
		|				_ДатыПоследнихЦен.ЦеннаяБумага
		|			ИЗ
		|				_ДатыПоследнихЦен)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	_ТаблицаЦБ.Номинал КАК Номинал,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ЕСТЬNULL(_ПослеПогашения.СправедливаяЦена, ЕСТЬNULL(_ММВБ.СправедливаяЦена, ЕСТЬNULL(_ММВБ_ВалютаУчета.СправедливаяЦена, ЕСТЬNULL(_Биржа_СПВБ.СправедливаяЦена, ЕСТЬNULL(_ПоследниеЦены.СправедливаяЦена, 0))))) КАК Стоимость,
		|	ЕСТЬNULL(_ПослеПогашения.ИсточникКотировок, ЕСТЬNULL(_ММВБ.ИсточникКотировок, ЕСТЬNULL(_ММВБ_ВалютаУчета.ИсточникКотировок, ЕСТЬNULL(_Биржа_СПВБ.ИсточникКотировок, ЕСТЬNULL(_ПоследниеЦены.ИсточникКотировок, 0))))) КАК Источник,
		|	ЕСТЬNULL(_ПослеПогашения.ДатаЦены, ЕСТЬNULL(_ММВБ.ДатаЦены, ЕСТЬNULL(_ММВБ_ВалютаУчета.ДатаЦены, ЕСТЬNULL(_Биржа_СПВБ.ДатаЦены, ЕСТЬNULL(_ПоследниеЦены.ДатаЦены, 0))))) КАК ДатаЦены,
		|	0 КАК УровеньОценки,
		|	ЕСТЬNULL(_ПослеПогашения.ПолеЦены, ЕСТЬNULL(_ММВБ.ПолеЦены, ЕСТЬNULL(_ММВБ_ВалютаУчета.ПолеЦены, ЕСТЬNULL(_Биржа_СПВБ.ПолеЦены, ЕСТЬNULL(_ПоследниеЦены.ПолеЦены, ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ПустаяСсылка)))))) КАК ВидЦены,
		|	ЕСТЬNULL(_ПослеПогашения.Купон, ЕСТЬNULL(_КупоныКонцаМесяца.Купон, ЕСТЬNULL(_ММВБ.Купон, _ММВБ_ВалютаУчета.Купон))) КАК Купон,
		|	ЕСТЬNULL(_ПослеПогашения.ВалютаКупона, ЕСТЬNULL(_КупоныКонцаМесяца.ВалютаКупона, ЕСТЬNULL(_ММВБ.ВалютаКупона, _ММВБ_ВалютаУчета.ВалютаКупона))) КАК ВалютаКупона,
		|	ЕСТЬNULL(_ПослеПогашения.ВалютаКотировки, ЕСТЬNULL(_ММВБ.Валюта, ЕСТЬNULL(_ММВБ_ВалютаУчета.Валюта, ЕСТЬNULL(_Биржа_СПВБ.Валюта, _ПоследниеЦены.ВалютаКотировки)))) КАК ВалютаКотировки
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПослеПогашения КАК _ПослеПогашения
		|		ПО _ТаблицаЦБ.Рынок = _ПослеПогашения.Рынок
		|			И _ТаблицаЦБ.ЦеннаяБумага = _ПослеПогашения.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ММВБ КАК _ММВБ
		|		ПО _ТаблицаЦБ.Рынок = _ММВБ.Рынок
		|			И _ТаблицаЦБ.ЦеннаяБумага = _ММВБ.ЦеннаяБумага
		|			И _ТаблицаЦБ.ВалютаНоминала = _ММВБ.Валюта
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Биржа_СПВБ КАК _Биржа_СПВБ
		|		ПО _ТаблицаЦБ.Рынок = _Биржа_СПВБ.Рынок
		|			И _ТаблицаЦБ.ЦеннаяБумага = _Биржа_СПВБ.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПоследниеЦены КАК _ПоследниеЦены
		|		ПО _ТаблицаЦБ.ЦеннаяБумага = _ПоследниеЦены.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КупоныКонцаМесяца КАК _КупоныКонцаМесяца
		|		ПО _ТаблицаЦБ.Рынок = _КупоныКонцаМесяца.Рынок
		|			И _ТаблицаЦБ.ЦеннаяБумага = _КупоныКонцаМесяца.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ММВБ КАК _ММВБ_ВалютаУчета
		|		ПО _ТаблицаЦБ.Рынок = _ММВБ_ВалютаУчета.Рынок
		|			И _ТаблицаЦБ.ЦеннаяБумага = _ММВБ_ВалютаУчета.ЦеннаяБумага
		|			И (_ММВБ_ВалютаУчета.Валюта = &ВалютаУчета)";
	
	#КонецОбласти		
	
	НастройкиЦелиРасчета = БухгалтерскийУчет.ОпределитьНастройкиЦелиРасчета(ДатаПереоценки, ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
	
	КалендарьКотировок		= Константы.ОсновнойКалендарьКотировок.Получить();
	ПоследнийТорговыйДень	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьКотировок, НачалоДня(ДатаПереоценки));
	
	ВидыЦенПослеПогашения = Новый Массив;
	ВидыЦенПослеПогашения.Добавить(Перечисления.ИсточникиЦеныДляПереоценки.Погашена);
	ВидыЦенПослеПогашения.Добавить(Перечисления.ИсточникиЦеныДляПереоценки.Номинал);
	ВидыЦенПослеПогашения.Добавить(Перечисления.ИсточникиЦеныДляПереоценки.Дефолт);
	
	Запрос.УстановитьПараметр("Организация", 					ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ПараметрыОценки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", 				ТаблицаЦБ);
	
	Запрос.УстановитьПараметр("ВидУчета",						НастройкиЦелиРасчета.ВидУчетаДляОстатковПартий);
	Запрос.УстановитьПараметр("ВалютаУчета",					ПараметрыОценки.Организация.ВалютаУчета);
	
	Запрос.УстановитьПараметр("ММВБ",							ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("Биржа_СПВБ",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_СПВБ"));
		
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследнийТорговыйДень", 			ПоследнийТорговыйДень);    	
			
	Запрос.УстановитьПараметр("ДатаПереоценки", 				ДатаПереоценки);
	Запрос.УстановитьПараметр("ЦельРасчета", 					ПараметрыОценки.ЦельРасчета);
			
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены ФОГФ", "Таблица стоимостей ЦБ", , , "_СтоимостьПереоценкиСрезПоследних");		
	КонецЕсли;
	
	СтрокиДляДозаполненияИзПартий = Новый Массив;		
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		Если ВидыЦенПослеПогашения.Найти(СтрокаСтоимостейЦБ.ВидЦены) <> Неопределено Тогда			
			Продолжить; // Дополнительная обработка не требуется
		КонецЕсли;
						
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И Не ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВалютаКупона) Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления, , СтрокаСтоимостейЦБ.ВалютаКупона);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость = 0 Тогда
			СтрокиДляДозаполненияИзПартий.Добавить(СтрокаСтоимостейЦБ);
		КонецЕсли;
		
	КонецЦикла;
					
	// Дозаполнение данными из партий	
	Если СтрокиДляДозаполненияИзПартий.Количество() > 0 И ПараметрыОценки.ПараметрыПолученияПартий <> Неопределено Тогда  		
		ЗаполнитьЦенамиПокупкиПриОтсутствииУчетаНаПартиях(ДатаПереоценки, ТаблицаСтоимостейЦБ, СтрокиДляДозаполненияИзПартий, ПараметрыОценки, РасшифровкаРасчета);	
	КонецЕсли;	
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныГефеста(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ИсходнаяТаблицаЦБ");
	ПоместитьЭмитентовЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "_ИсходнаяТаблицаЦБ");
	ПоместитьСведенияОТоргахЦеннымиБумагамиВМенеджерВременныхТаблиц(Запрос, "_ИсходнаяТаблицаЦБ", ДатаПереоценки, 10, "_СведенияОТоргахЦеннымиБумагами");
	ПоместитьТаблицуДатРасчетныхЦенПаевВМенеджерВременныхТаблиц(Запрос, "_ИсходнаяТаблицаЦБ", ДатаПереоценки, "_ТаблицаДатРасчетныхЦенПаев");
	
	#Область Основной_запрос	
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ), ЛОЖЬ) КАК ОблигацияОВОЗРФ,
		|	_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента КАК Эмитент,
		|	ЕСТЬNULL(_ЭмитентыЦенныхБумаг.Банкрот, ЛОЖЬ) КАК ЭмитентБанкрот,
		|	_ЭмитентыЦенныхБумаг.ДатаБанкротства КАК ЭмитентДатаБанкротства,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЭмитентРоссийский,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация), ЛОЖЬ) КАК ЭмитентМеждународнаяФинОрганизация,
		|	_СведенияОТоргахЦеннымиБумагами.Дата КАК ПоследняяДатаТоргов
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЭмитентыЦенныхБумаг КАК _ЭмитентыЦенныхБумаг
