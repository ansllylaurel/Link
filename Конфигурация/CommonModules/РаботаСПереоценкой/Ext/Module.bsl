		|				И ЕСТЬNULL(РасчетныеЦеныНРДСрезПоследних.PRICE, 0) > 0
		|			ТОГДА &НРД
		|		КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|				И ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена, 0) > 0
		|				И РасчетныеЦеныПаевСрезПоследних.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, МЕСЯЦ, -6)
		|			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ИсточникЦены
		|ПОМЕСТИТЬ КотировкиНРДиПаи
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ КотировкиБлумберг КАК КотировкиБлумберг
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|			ПО КотировкиБлумберг.Биржа = Биржи.Ссылка
		|		ПО ТаблицаЦБ.Рынок = КотировкиБлумберг.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиБлумберг.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД.СрезПоследних(&ДатаПереоценки, ) КАК РасчетныеЦеныНРДСрезПоследних
		|		ПО ТаблицаЦБ.Рынок = РасчетныеЦеныНРДСрезПоследних.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныНРДСрезПоследних.ЦеннаяБумага
		|			И (&ДатаПереоценки < ДАТАВРЕМЯ(2017, 4, 1, 0, 0, 0)
		|					И РасчетныеЦеныНРДСрезПоследних.Период = &ПоследняяТорговоРабочаяДата
		|				ИЛИ &ДатаПереоценки >= ДАТАВРЕМЯ(2017, 4, 1, 0, 0, 0)
		|					И РасчетныеЦеныНРДСрезПоследних.Период >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(&ДатаПереоценки, ) КАК РасчетныеЦеныПаевСрезПоследних
		|		ПО ((ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Паи)) = РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФСрезПоследних
		|		ПО ((ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Паи)).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.Рынок,
		|	ТаблицаЦБ.Номинал,
		|	ВЫБОР
		|		КОГДА КотировкиНРДиПаи.СправедливаяЦена > 0
		|			ТОГДА КотировкиНРДиПаи.СправедливаяЦена
		|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|			ТОГДА ВЫБОР
		|					КОГДА ТИПЗНАЧЕНИЯ(ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|						ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID * ТаблицаЦБ.Номинал / 100
		|					ИНАЧЕ КотировкиТорговыхПлощадокСводныеСрезПоследних.BID
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СправедливаяЦена,
		|	ВЫБОР
		|		КОГДА КотировкиНРДиПаи.СправедливаяЦена > 0
		|			ТОГДА КотировкиНРДиПаи.УровеньОценки
		|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|			ТОГДА 2
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УровеньОценки,
		|	ВЫБОР
		|		КОГДА КотировкиНРДиПаи.СправедливаяЦена > 0
		|			ТОГДА КотировкиНРДиПаи.ДатаЦены
		|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ДатаЦены,
		|	ВЫБОР
		|		КОГДА КотировкиНРДиПаи.СправедливаяЦена > 0
		|			ТОГДА КотировкиНРДиПаи.ПолеКотировки
		|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|			ТОГДА ЗНАЧЕНИЕ(перечисление.ИсточникиЦеныДляПереоценки.ЦенаСпроса)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПолеКотировки,
		|	ВЫБОР
		|		КОГДА КотировкиНРДиПаи.СправедливаяЦена > 0
		|			ТОГДА КотировкиНРДиПаи.ИсточникЦены
		|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE > ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа.ЮрФизЛицо
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ИсточникЦены
		|ПОМЕСТИТЬ КотировкиРТСБоард
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ КотировкиНРДиПаи КАК КотировкиНРДиПаи
		|		ПО ТаблицаЦБ.Рынок = КотировкиНРДиПаи.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиНРДиПаи.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(&ДатаПереоценки, Биржа = &РТС) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадокСводныеСрезПоследних.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиРТСБоард.ЦеннаяБумага,
		|	КотировкиРТСБоард.Рынок,
		|	КотировкиРТСБоард.Номинал,
		|	КотировкиРТСБоард.УровеньОценки,
		|	КотировкиРТСБоард.ДатаЦены,
		|	КотировкиРТСБоард.ПолеКотировки КАК ВидЦены,
		|	КотировкиРТСБоард.ИсточникЦены КАК Источник,
		|	КотировкиРТСБоард.СправедливаяЦена КАК Стоимость,
		|	""Цены облигаций приведены к деньгам при получении цен НРД"" КАК Поле1
		|ИЗ
		|	КотировкиРТСБоард КАК КотировкиРТСБоард";
		
	ТорговыхДнейНазад10 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -10);
	ПоследняяДатаТоргов = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки));
	ПоследняяРабочаяДата = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский,НачалоДня(ДатаПереоценки));
	ПоследняяТорговоРабочаяДата = Мин(ПоследняяДатаТоргов, ПоследняяРабочаяДата);
		
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10", ТорговыхДнейНазад10);
	Запрос.УстановитьПараметр("ПоследняяТорговоРабочаяДата", ПоследняяТорговоРабочаяДата);
	Запрос.УстановитьПараметр("ММВБ", 		ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("РТС", 		ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_РТС"));
	Запрос.УстановитьПараметр("Блумберг", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("Режим_BGN", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Рубли", ПараметрыОценки.Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("НРД", 		ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("Организация", ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыОценки.СчетДоверительногоУправления);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);//ЦенныеБумаги.Выгрузить()
	
	ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаСтоимостейЦБ;
КонецФункции

Функция ПолучитьЦеныППА2018(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "ИсходнаяТаблицаЦБ");
	ПоместитьСведенияОТоргахЦеннымиБумагамиВМенеджерВременныхТаблиц(Запрос, "ИсходнаяТаблицаЦБ", ДатаПереоценки, 10, "_СведенияОТоргахЦеннымиБумагами");	
	
	#Область Текст_запроса
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	Эмитенты.Ссылка КАК Эмитент,
		|	Эмитенты.ЮрФизЛицо КАК ЮрЛицоЭмитента
		|ПОМЕСТИТЬ _ЭмитентыЦенныхБумаг
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Векселя КАК Векселя
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Векселя.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеРасписки КАК ДепозитарныеРасписки
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = ДепозитарныеРасписки.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = ИпотечныеСертификатыУчастия.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|		ПО (Эмитенты.Ссылка = ВЫБОР
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|					ТОГДА Акции.Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|					ТОГДА Облигации.Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|					ТОГДА Векселя.Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|					ТОГДА ДепозитарныеРасписки.Эмитент
		|				КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|					ТОГДА ИпотечныеСертификатыУчастия.Эмитент
		|			КОНЕЦ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(Облигации.ДатаНачалаОбращения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаОбращения,
		|	ЕСТЬNULL(Облигации.ДатаНачалаРазмещения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаРазмещения,
		|	_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента КАК Эмитент,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЭмитентРоссийский,
		|	_СведенияОТоргахЦеннымиБумагами.Дата КАК ПоследняяДатаТоргов
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЭмитентыЦенныхБумаг КАК _ЭмитентыЦенныхБумаг
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|					&ДатаПереоценки,
		|					(Подразделение, Язык, ЮрФизЛицо) В
		|						(ВЫБРАТЬ
		|							ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|							ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|							_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента
		|						ИЗ
		|							_ЭмитентыЦенныхБумаг)) КАК РеквизитыЮрЛицаЭмитента
		|			ПО (РеквизитыЮрЛицаЭмитента.ЮрФизЛицо = _ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента)
		|		ПО (_ЭмитентыЦенныхБумаг.ЦеннаяБумага = ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СведенияОТоргахЦеннымиБумагами КАК _СведенияОТоргахЦеннымиБумагами
		|		ПО (_СведенияОТоргахЦеннымиБумагами.ЦеннаяБумага = ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|			И (_СведенияОТоргахЦеннымиБумагами.ТорговыхДнейНазад = 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ АктивныйРынокММВБ10Дней
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СведенияОТоргахЦеннымиБумагами КАК _СведенияОТоргахЦеннымиБумагами
		|		ПО (_СведенияОТоргахЦеннымиБумагами.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.Рынок = ТаблицаЦБ.Рынок)
		|			И (КотировкиТорговыхПлощадок.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадок.Период = _СведенияОТоргахЦеннымиБумагами.Дата)
		|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
