		КонецЕсли;	
		
		// Расчетные цены	
		
		ТорговыхДнейНазад30	= Справочники.Календари.ДобавитьКДатеРабочиеДни(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки), -30);
