	ДобавитьСтрокуТаблицыПриоритетаБирж(ИностранныеБиржи, 1, "Биржа_LSE",					ВалютаДоллары);
	ДобавитьСтрокуТаблицыПриоритетаБирж(ИностранныеБиржи, 2, "Биржа_NYSE",					ВалютаДоллары);
	ДобавитьСтрокуТаблицыПриоритетаБирж(ИностранныеБиржи, 3, "Биржа_HKEX",					ВалютаДоллары);
	ДобавитьСтрокуТаблицыПриоритетаБирж(ИностранныеБиржи, 1, "Биржа_LSE",					ВалютаЕвро);
	ДобавитьСтрокуТаблицыПриоритетаБирж(ИностранныеБиржи, 2, "Биржа_FRNK",					ВалютаЕвро);
	ДобавитьСтрокуТаблицыПриоритетаБирж(ИностранныеБиржи, 3, "Биржа_Euronext_Amsterdam",	ВалютаЕвро);
	ДобавитьСтрокуТаблицыПриоритетаБирж(ИностранныеБиржи, 4, "Биржа_Euronext_Brussels",		ВалютаЕвро);		
	ДобавитьСтрокуТаблицыПриоритетаБирж(ИностранныеБиржи, 5, "Биржа_Euronext_Lisbon",		ВалютаЕвро);		
	ДобавитьСтрокуТаблицыПриоритетаБирж(ИностранныеБиржи, 6, "Биржа_Euronext_London",		ВалютаЕвро);		
	ДобавитьСтрокуТаблицыПриоритетаБирж(ИностранныеБиржи, 7, "Биржа_Euronext_Paris",		ВалютаЕвро);

	ИностранныеУчетныеАктивы = Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();	
	
	ТорговыхДнейНазад30 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -30);
	
	Запрос.УстановитьПараметр("ИностранныеБиржиСПриоритетом", 	ИностранныеБиржи);
	Запрос.УстановитьПараметр("ИностранныеУчетныеАктивы", 		ИностранныеУчетныеАктивы);
	Запрос.УстановитьПараметр("Россия", 						Справочники.СтраныМира.Россия);
	Запрос.УстановитьПараметр("BGN", 						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("BVAL", 						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	Запрос.УстановитьПараметр("ДоступныДанныеBloomberg",		ПроверитьДоступностьДанныхBloomberg(ДатаПереоценки));		
	Запрос.УстановитьПараметр("ТорговыхДнейНазад30", 			ТорговыхДнейНазад30);
	Запрос.УстановитьПараметр("НРД",       		ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	
	
	НастройкиЦелиРасчета = БухгалтерскийУчет.ОпределитьНастройкиЦелиРасчета(ДатаПереоценки, ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
	
	ПоследнийТорговыйДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(), НачалоДня(ДатаПереоценки));
	ПоследнийРабочийДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоДня(ДатаПереоценки));
	ТорговыхДнейНазад90 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -90);
	
	Запрос.УстановитьПараметр("ВидУчета", 		НастройкиЦелиРасчета.ВидУчетаДляОстатковПартий);
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	Запрос.УстановитьПараметр("ММВБ",			ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("Блумберг", 		ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("Режим_BGN", 		ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("ПоследнийТорговыйДень", 			ПоследнийТорговыйДень);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад90", 			ТорговыхДнейНазад90);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ПараметрыОценки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", 				ТаблицаЦБ);
	Запрос.УстановитьПараметр("ВалютаУчета", 					ПараметрыОценки.Организация.ВалютаУчета);
		
	Если РасшифровкаРасчета <> Неопределено Тогда
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены РПИ (ЕПС)", "Таблица стоимостей ЦБ");		
	Иначе
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	// #техдолг
	// временное решение: пока не разберемся как надо
	Для каждого СтрокаТаблицаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		Если СтрокаТаблицаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И Не ЗначениеЗаполнено(СтрокаТаблицаСтоимостейЦБ.ВалютаКупона) Тогда
			СтрокаТаблицаСтоимостейЦБ.ВалютаКупона = СтрокаТаблицаСтоимостейЦБ.ВалютаНоминала;
			СтрокаТаблицаСтоимостейЦБ.Купон        = Справочники.Облигации.ПолучитьКупон(СтрокаТаблицаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаСтоимостейЦБ;
КонецФункции

Функция ПолучитьЦеныАОНаско(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ) 

	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ТаблицаСпискаЦБ.Рынок КАК Рынок
	|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
	|ИЗ
	|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
	|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
	|	Облигации.ДатаНачалаОбращения КАК ДатаНачалаОбращения,
	|	Облигации.ДатаНачалаРазмещения КАК ДатаНачалаРазмещения,
	|	Облигации.ЦенаРазмещения КАК ЦенаРазмещения,
	|	РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена КАК РасчетнаяЦенаПая,
	|	РасчетныеЦеныПаевСрезПоследних.Период КАК ДатаРасчетнойЦеныПая
	|ПОМЕСТИТЬ ТаблицаЦБ
	|ИЗ
	|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
	|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
	|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(&ДатаПереоценки, ) КАК РасчетныеЦеныПаевСрезПоследних
	|		ПО (РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага = ИсходнаяТаблицаЦБ.ЦеннаяБумага)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ТаблицаЦБ.Номинал КАК Номинал,
	|	ТаблицаЦБ.Рынок КАК Рынок,
	|	ВЫБОР
	|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
	|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК СправедливаяЦена,
	|	1 КАК УровеньОценки,
	|	ВЫБОР
	|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СредневзвешеннаяЦена)
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК ПолеПереоценки,
	|	ВЫБОР
	|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
	|			ТОГДА Биржи.ЮрФизЛицо
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК Биржа,
	|	ВЫБОР
	|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE_DATE >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -30)
	|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE_DATE
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК ДатаЦены
	|ПОМЕСТИТЬ КотировкиММВБ
	|ИЗ
	|	ТаблицаЦБ КАК ТаблицаЦБ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
	|				&ДатаПереоценки,
	|				Биржа = &ММВБ
	|					И РежимТоргов.ОсновнойРежим) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
	|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадокСводныеСрезПоследних.Рынок
	|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
	|		ПО (КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа = Биржи.Ссылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ТаблицаЦБ.Рынок КАК Рынок,
	|	ТаблицаЦБ.Номинал КАК Номинал,
	|	ВЫБОР
	|		КОГДА КотировкиММВБ.СправедливаяЦена ЕСТЬ NULL
	|			ТОГДА ВЫБОР
	|					КОГДА ТИПЗНАЧЕНИЯ(ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Паи)
	|						ТОГДА ЕСТЬNULL(ТаблицаЦБ.РасчетнаяЦенаПая, 0)
	|					КОГДА ТИПЗНАЧЕНИЯ(ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
	|							И (ТаблицаЦБ.ДатаНачалаОбращения ЕСТЬ NULL
	|								ИЛИ &ДатаПереоценки < ТаблицаЦБ.ДатаНачалаОбращения)
	|						ТОГДА ЕСТЬNULL(ТаблицаЦБ.ЦенаРазмещения, 0)
	|				КОНЕЦ
	|		ИНАЧЕ КотировкиММВБ.СправедливаяЦена
	|	КОНЕЦ * ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
	|			ТОГДА ТаблицаЦБ.Номинал / 100
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Стоимость,
	|	ВЫБОР
	|		КОГДА КотировкиММВБ.СправедливаяЦена ЕСТЬ NULL
	|			ТОГДА ВЫБОР
	|					КОГДА ТИПЗНАЧЕНИЯ(ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Паи)
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СЧА)
	|					КОГДА ТИПЗНАЧЕНИЯ(ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
	|							И (ТаблицаЦБ.ДатаНачалаОбращения ЕСТЬ NULL
	|								ИЛИ &ДатаПереоценки < ТаблицаЦБ.ДатаНачалаОбращения)
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ЦенаПриобретения)
	|				КОНЕЦ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СредневзвешеннаяЦена)
	|	КОНЕЦ КАК ВидЦены,
	|	ВЫБОР
	|		КОГДА КотировкиММВБ.СправедливаяЦена ЕСТЬ NULL
	|			ТОГДА ВЫБОР
	|					КОГДА ТИПЗНАЧЕНИЯ(ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Паи)
	|						ТОГДА ТаблицаЦБ.ДатаРасчетнойЦеныПая
	|					КОГДА ТИПЗНАЧЕНИЯ(ТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
	|							И (ТаблицаЦБ.ДатаНачалаОбращения ЕСТЬ NULL
	|								ИЛИ &ДатаПереоценки < ТаблицаЦБ.ДатаНачалаОбращения)
	|						ТОГДА ТаблицаЦБ.ДатаНачалаРазмещения
	|				КОНЕЦ
	|		ИНАЧЕ КотировкиММВБ.ДатаЦены
	|	КОНЕЦ КАК ДатаЦены,
	|	ВЫБОР
	|		КОГДА КотировкиММВБ.СправедливаяЦена ЕСТЬ NULL
	|			ТОГДА 2
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК УровеньОценки,
	|	КотировкиММВБ.Биржа КАК Источник,
	|	(БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток + БухПартииЦенныхБумагОстатки.СтоимостьПокупкиКупонаОстаток) / БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК ЦенаПартии,
	|	БухПартииЦенныхБумагОстатки.Партия.Дата КАК ДатаПартии
	|ПОМЕСТИТЬ _СтоимостиЦенныхБумагСЦенамиПартий
	|ИЗ
	|	ТаблицаЦБ КАК ТаблицаЦБ
	|		ЛЕВОЕ СОЕДИНЕНИЕ КотировкиММВБ КАК КотировкиММВБ
	|		ПО ТаблицаЦБ.ЦеннаяБумага = КотировкиММВБ.ЦеннаяБумага
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
	|				КОНЕЦПЕРИОДА(&ДатаПереоценки, ДЕНЬ),
	|				Организация = &Организация
	|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|					И ЦеннаяБумага В
	|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|							ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
	|						ИЗ
	|							ИсходнаяТаблицаЦБ)
	|					И (Партия ССЫЛКА Документ.ВводЦенныхБумаг
	|						ИЛИ Партия ССЫЛКА Документ.Сделка)
	|					И КОНЕЦПЕРИОДА(Партия.Дата, ДЕНЬ) = КОНЕЦПЕРИОДА(&ДатаПереоценки, ДЕНЬ)) КАК БухПартииЦенныхБумагОстатки
	|		ПО ТаблицаЦБ.ЦеннаяБумага = БухПартииЦенныхБумагОстатки.ЦеннаяБумага
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_СтоимостиЦенныхБумагСЦенамиПартий.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_СтоимостиЦенныхБумагСЦенамиПартий.Рынок КАК Рынок,
	|	_СтоимостиЦенныхБумагСЦенамиПартий.Номинал КАК Номинал,
	|	ЕСТЬNULL(_СтоимостиЦенныхБумагСЦенамиПартий.ЦенаПартии, _СтоимостиЦенныхБумагСЦенамиПартий.Стоимость) КАК Стоимость,
	|	ВЫБОР
	|		КОГДА _СтоимостиЦенныхБумагСЦенамиПартий.ЦенаПартии ЕСТЬ NULL
	|			ТОГДА _СтоимостиЦенныхБумагСЦенамиПартий.ВидЦены
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ЦенаПриобретения)
	|	КОНЕЦ КАК ВидЦены,
	|	ЕСТЬNULL(_СтоимостиЦенныхБумагСЦенамиПартий.ДатаПартии, _СтоимостиЦенныхБумагСЦенамиПартий.ДатаЦены) КАК ДатаЦены,
	|	_СтоимостиЦенныхБумагСЦенамиПартий.УровеньОценки КАК УровеньОценки,
	|	_СтоимостиЦенныхБумагСЦенамиПартий.Источник КАК Источник
	|ИЗ
	|	_СтоимостиЦенныхБумагСЦенамиПартий КАК _СтоимостиЦенныхБумагСЦенамиПартий";
				   
	ПоследнийРабочийДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоДня(ДатаПереоценки));	
	ПредыдущийРабочийДень = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ДатаПереоценки), -1);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);	       
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);			       
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыОценки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", ПараметрыОценки.Организация);		
	Запрос.УстановитьПараметр("ММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));	
		
	ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();

	Возврат ТаблицаСтоимостейЦБ;

				   
КонецФункции

Функция ПолучитьЦеныСОГеополис(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено) 
	
	 // В портфеле ценных бумаг СО "ГЕОПОЛИС" из ценных бумаг имеются только облигации (в т.ч. еврооблигации), акции.(11/04/17)
	 // Методика определения справедливой цены: справедливой ценой признается цена спроса (Bid) на последний рабочий день до или во время переоценки.
	 // Если котировки на указанную дату нет, рассматривается цена спроса (Bid) в предыдущий рабочий день.
	 // Основной рынок для всех ценных бумаг, за исключением еврооблигаций - ММВБ
	 // Для еврооблигаций - Франкфуртская биржа, FWB
	
	Запрос = Новый Запрос;

	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ИсходнаяТаблицаЦБ");
	
	#Область Основной_запрос
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	КотировкиТорговыхПлощадокСводные.Биржа КАК Биржа,
		|	КотировкиТорговыхПлощадокСводные.Биржа = ВЫБОР
		|		КОГДА Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|			ТОГДА &ОсновнаяБиржаКотировокЕврооблигаций
		|		ИНАЧЕ &ОсновнаяБиржаКотировок
		|	КОНЕЦ КАК КотировкаОсновнойБиржи,
		|	КотировкиТорговыхПлощадокСводные.РежимТоргов КАК РежимТоргов,
		|	КотировкиТорговыхПлощадокСводные.Валюта КАК Валюта,
		|	КотировкиТорговыхПлощадокСводные.Валюта = ИсходнаяТаблицаЦБ.ВалютаНоминала КАК КотировкаВВалютеНоминала,
		|	КотировкиТорговыхПлощадокСводные.BID КАК BID,
		|	КотировкиТорговыхПлощадокСводные.BID_DATE КАК BID_DATE,
		|	КотировкиТорговыхПлощадок.VOLUME КАК ОбъемСделокШтукБумаг,
		|	КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ _СводныеКотировкиЦБ
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ЦеннаяБумага, Рынок) В
		|					(ВЫБРАТЬ
		|						_ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|						_ИсходнаяТаблицаЦБ.Рынок
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ)) КАК КотировкиТорговыхПлощадокСводные
		|		ПО (КотировкиТорговыхПлощадокСводные.ЦеннаяБумага = ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадокСводные.Рынок = ИсходнаяТаблицаЦБ.Рынок)
		|			И (КотировкиТорговыхПлощадокСводные.BID_DATE >= &ПредыдущийРабочийДень)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.ЦеннаяБумага = КотировкиТорговыхПлощадокСводные.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Рынок = КотировкиТорговыхПлощадокСводные.Рынок)
		|			И (КотировкиТорговыхПлощадок.Биржа = КотировкиТорговыхПлощадокСводные.Биржа)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов = КотировкиТорговыхПлощадокСводные.РежимТоргов)
		|			И (КотировкиТорговыхПлощадок.Период = КотировкиТорговыхПлощадокСводные.BID_DATE)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО (Облигации.Ссылка = ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КурсыВалют.Валюта = КотировкиТорговыхПлощадокСводные.Валюта)
		|			И (КурсыВалют.Период = &ДатаПереоценки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1000000
		|	_СводныеКотировкиЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_СводныеКотировкиЦБ.Биржа КАК Биржа,
		|	_СводныеКотировкиЦБ.РежимТоргов КАК РежимТоргов,
		|	_СводныеКотировкиЦБ.BID_DATE КАК BID_DATE,
		|	_СводныеКотировкиЦБ.КотировкаОсновнойБиржи КАК КотировкаОсновнойБиржи,
		|	_СводныеКотировкиЦБ.КотировкаВВалютеНоминала КАК КотировкаВВалютеНоминала,
		|	_СводныеКотировкиЦБ.ОбъемСделокШтукБумаг КАК ОбъемСделокШтукБумаг,
		|	_СводныеКотировкиЦБ.ОбъемСделокВВалютеУчета КАК ОбъемСделокВВалютеУчета,
		|	АВТОНОМЕРЗАПИСИ() КАК Приоритет
		|ПОМЕСТИТЬ _ПриоритетКотировокЦБ_Служебный
		|ИЗ
		|	_СводныеКотировкиЦБ КАК _СводныеКотировкиЦБ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЦеннаяБумага,
		|	КотировкаОсновнойБиржи УБЫВ,
		|	BID_DATE УБЫВ,
		|	КотировкаВВалютеНоминала УБЫВ,
		|	ОбъемСделокШтукБумаг УБЫВ,
		|	ОбъемСделокВВалютеУчета УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Приоритет.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_Приоритет.Биржа КАК Биржа,
		|	_Приоритет.РежимТоргов КАК РежимТоргов,
		|	_Приоритет.BID_DATE КАК BID_DATE,
		|	_Приоритет.КотировкаОсновнойБиржи КАК КотировкаОсновнойБиржи,
		|	_Приоритет.КотировкаВВалютеНоминала КАК КотировкаВВалютеНоминала,
		|	_Приоритет.ОбъемСделокШтукБумаг КАК ОбъемСделокШтукБумаг,
		|	_Приоритет.ОбъемСделокВВалютеУчета КАК ОбъемСделокВВалютеУчета,
		|	_Приоритет.Приоритет - НачальныеНомераВГруппе.Приоритет + 1 КАК Приоритет
		|ПОМЕСТИТЬ _ПриоритетКотировокЦБ
		|ИЗ
		|	_ПриоритетКотировокЦБ_Служебный КАК _Приоритет
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_Приоритет.ЦеннаяБумага КАК ЦеннаяБумага,
		|			МИНИМУМ(_Приоритет.Приоритет) КАК Приоритет
		|		ИЗ
		|			_ПриоритетКотировокЦБ_Служебный КАК _Приоритет
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_Приоритет.ЦеннаяБумага) КАК НачальныеНомераВГруппе
		|		ПО (НачальныеНомераВГруппе.ЦеннаяБумага = _Приоритет.ЦеннаяБумага)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(_СводныеКотировкиЦБ.BID, 0) * ВЫБОР
		|		КОГДА _ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА НоминалыЦенныхБумагСрезПоследних.Номинал / 100
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК Стоимость,
		|	ВЫБОР
		|		КОГДА _СводныеКотировкиЦБ.BID ЕСТЬ НЕ NULL 
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ЦенаСпроса)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ВидЦены,
		|	ЕСТЬNULL(_СводныеКотировкиЦБ.BID_DATE, 0) КАК ДатаЦены,
		|	ВЫБОР
		|		КОГДА _СводныеКотировкиЦБ.BID ЕСТЬ НЕ NULL 
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УровеньОценки,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, 0) КАК Источник,
		|	ВЫБОР
		|		КОГДА _ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА _ИсходнаяТаблицаЦБ.ВалютаНоминала
		|		ИНАЧЕ ЕСТЬNULL(_СводныеКотировкиЦБ.Валюта, 0)
		|	КОНЕЦ КАК ВалютаКотировки
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СводныеКотировкиЦБ КАК _СводныеКотировкиЦБ
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПриоритетКотировокЦБ КАК _ПриоритетКотировокЦБ
		|			ПО (_ПриоритетКотировокЦБ.ЦеннаяБумага = _СводныеКотировкиЦБ.ЦеннаяБумага)
		|				И (_ПриоритетКотировокЦБ.Биржа = _СводныеКотировкиЦБ.Биржа)
		|				И (_ПриоритетКотировокЦБ.РежимТоргов = _СводныеКотировкиЦБ.РежимТоргов)
		|				И (_ПриоритетКотировокЦБ.Приоритет = 1)
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = _СводныеКотировкиЦБ.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (_СводныеКотировкиЦБ.Биржа = Биржи.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						_ИсходнаяТаблицаЦБ.ЦеннаяБумага
		|					ИЗ
		|						_ИсходнаяТаблицаЦБ)) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1000000", Формат(Кэширование.КоличествоЗаписейТаблицы("РегистрСведений.КотировкиТорговыхПлощадок"), "ЧН=; ЧГ=; ЧФ='ПЕРВЫЕ Ч'"));
	
	#КонецОбласти
	
	ПредыдущийРабочийДень = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ДатаПереоценки), -1);
	
	Запрос.УстановитьПараметр("ДатаПереоценки",							ДатаПереоценки);	
	Запрос.УстановитьПараметр("ПредыдущийРабочийДень",					ПредыдущийРабочийДень);	
	
	Запрос.УстановитьПараметр("ОсновнаяБиржаКотировок",					ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));	
	Запрос.УстановитьПараметр("ОсновнаяБиржаКотировокЕврооблигаций",	ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_FWB"));
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены СО Геополис 2018 (ЕПС)", "Таблица стоимостей ЦБ", , , "_ПриоритетКотировокЦБ_Служебный");
	КонецЕсли;

	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныСАОГеополис(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено) 
	 
	Запрос = Новый Запрос;

	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ИсходнаяТаблицаЦБ");
	
	#Область Основной_запрос
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ЕСТЬNULL(Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация), ЛОЖЬ) КАК Еврооблигация,
		|	ВЫБОР
		|		КОГДА Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|			ТОГДА &Блумберг
		|		ИНАЧЕ &ММВБ
		|	КОНЕЦ КАК ОсновнаяБиржа
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиТорговыхПлощадокСводные.Рынок КАК Рынок,
		|	КотировкиТорговыхПлощадокСводные.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадокСводные.Биржа КАК Биржа,
		|	КотировкиТорговыхПлощадокСводные.РежимТоргов КАК РежимТоргов,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадокСводные.Биржа = &Блумберг
		|			ТОГДА КотировкиТорговыхПлощадокСводные.CLOSE
		|		КОГДА КотировкиТорговыхПлощадокСводные.MARKETPRICE3 > 0
		|				И КотировкиТорговыхПлощадокСводные.MARKETPRICE3_DATE >= &ПоследнийРабочийДень
		|			ТОГДА КотировкиТорговыхПлощадокСводные.MARKETPRICE3
		|		КОГДА КотировкиТорговыхПлощадокСводные.ADMITTEDQUOTE > 0
		|			ТОГДА КотировкиТорговыхПлощадокСводные.ADMITTEDQUOTE
		|	КОНЕЦ КАК Цена,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадокСводные.Биржа = &Блумберг
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ЦенаСпроса)
		|		КОГДА КотировкиТорговыхПлощадокСводные.MARKETPRICE3 > 0
		|				И КотировкиТорговыхПлощадокСводные.MARKETPRICE3_DATE >= &ПоследнийРабочийДень
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.РыночнаяЦена3)
		|		КОГДА КотировкиТорговыхПлощадокСводные.ADMITTEDQUOTE > 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СредневзвешеннаяЦена)
		|	КОНЕЦ КАК ВидЦены,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадокСводные.Биржа = &Блумберг
