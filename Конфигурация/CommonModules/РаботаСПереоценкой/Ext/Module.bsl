	ПараметрыРасчетаРейтинга = ПолучитьПараметрыРасчетаРейтингаПоУмолчанию(ПараметрыОценки.СчетДоверительногоУправления, ДатаПереоценки);
	ПараметрыРасчетаРейтинга.Вставить("ИсточникТаблицыСоответствияРейтингов", Справочники.ВнешниеСистемы.Атом_РасчетСС);

	ПараметрыРасчетаКредитногоСпреда = Новый Структура;
	ПараметрыРасчетаКредитногоСпреда.Вставить("ОтклонениеКредитногоСпреда", 50); //параметр УП, может меняться со временем. При изменении также поменять переменную в процедуре ЗаполнитьПереоценкуАтомфонда			
	
	РынокОблигации = Перечисления.РынкиЦенныхБумаг.Облигации;
	Для Каждого СтрокаСтоимости Из ТаблицаСтоимостейЦБ Цикл
		ЦеннаяБумага = СтрокаСтоимости.ЦеннаяБумага;
		Рынок = СтрокаСтоимости.Рынок;
		
		Если Рынок = РынокОблигации Тогда
			НоминалНаДату				= Справочники.Облигации.ПолучитьНоминал(ЦеннаяБумага, ДатаПереоценки);
			Купон						= Справочники.Облигации.ПолучитьКупон(ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
			РейтинговаяГруппа			= Неопределено;
			КредитныйСпред				= Неопределено;
			БезрисковаяСтавкаДоходности	= Неопределено;
			
			ПараметрыДенежногоПотока = Новый Структура;
			ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",		Ложь);
			ПараметрыДенежногоПотока.Вставить("Дата",					ДатаПереоценки);
			ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",			ДатаПереоценки);
			
			ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ПараметрыДенежногоПотока, ПараметрыОценки, Отказ, РасшифровкаРасчета);
		Иначе
			НоминалНаДату = 100;
		КонецЕсли;
		
		Если СтрокаСтоимости.СправедливаяЦена>0 Тогда
			Если СтрокаСтоимости.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.РыночнаяЦена2 Тогда
				СтрокаСтоимости.УровеньОценки = 1;//ок
				СтрокаСтоимости.Источник = СтрокаСтоимости.БиржаЮрФизЛицо;
				СтрокаСтоимости.Стоимость = СтрокаСтоимости.СправедливаяЦена * НоминалНаДату /100;
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Если СтрокаСтоимости.СправедливаяЦена > 0 Тогда
			ПроверкаНаАдекватность = ПроверитьЦенуНаАдекватность(ЦеннаяБумага, СтрокаСтоимости.СправедливаяЦена * НоминалНаДату /100, ДатаПереоценки, ПараметрыОценки, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, , Купон, РейтинговаяГруппа, КредитныйСпред, ДенежныйПоток, БезрисковаяСтавкаДоходности, Отказ, РасшифровкаРасчета); 
			Если ПроверкаНаАдекватность Тогда
				СтрокаСтоимости.УровеньОценки = 1;//ок
				СтрокаСтоимости.Источник = СтрокаСтоимости.БиржаЮрФизЛицо;
				СтрокаСтоимости.Стоимость = СтрокаСтоимости.СправедливаяЦена * НоминалНаДату /100;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		//рынок признается неактивным
		
		Если СтрокаСтоимости.ЦБРФ Тогда
			//2.а - только для долговых
			Если Рынок = РынокОблигации И СтрокаСтоимости.MARKETPRICE2 > 0 Тогда
				ПроверкаНаАдекватность = ПроверитьЦенуНаАдекватность(ЦеннаяБумага, СтрокаСтоимости.MARKETPRICE2 * НоминалНаДату /100, ДатаПереоценки, ПараметрыОценки, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, , Купон, РейтинговаяГруппа, КредитныйСпред, ДенежныйПоток, БезрисковаяСтавкаДоходности, Отказ, РасшифровкаРасчета); 
				Если ПроверкаНаАдекватность Тогда
					СтрокаСтоимости.УровеньОценки = 1;//ок
					СтрокаСтоимости.Источник = СтрокаСтоимости.БиржаЮрФизЛицо;
					СтрокаСтоимости.Стоимость = СтрокаСтоимости.MARKETPRICE2 * НоминалНаДату /100;
					СтрокаСтоимости.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.РыночнаяЦена2;
					СтрокаСтоимости.ДатаЦены = СтрокаСтоимости.MARKETPRICE2_DATE;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			//2.в
			Если СтрокаСтоимости.ЦенаНРД > 0 Тогда
				//проверка адекватности только для долговых
				Если Рынок = РынокОблигации Тогда
					ПроверкаНаАдекватность = ПроверитьЦенуНаАдекватность(ЦеннаяБумага, СтрокаСтоимости.ЦенаНРД, ДатаПереоценки, ПараметрыОценки, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, , Купон, РейтинговаяГруппа, КредитныйСпред, ДенежныйПоток, БезрисковаяСтавкаДоходности, Отказ, РасшифровкаРасчета); 
				Иначе
					ПроверкаНаАдекватность = Истина;
				КонецЕсли;
				Если ПроверкаНаАдекватность Тогда
					СтрокаСтоимости.УровеньОценки = 2;//ок
					СтрокаСтоимости.Источник = ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");
					СтрокаСтоимости.Стоимость = СтрокаСтоимости.ЦенаНРД;
					СтрокаСтоимости.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД;
					СтрокаСтоимости.ДатаЦены = СтрокаСтоимости.ДатаЦеныНРД;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		Иначе
			//по умолчанию проверка на адекватность котировок Блумберг не осуществляется, если это отдельно не заявлено Фондом. Пока не заявлено
			Если СтрокаСтоимости.BGN > 0 ИЛИ СтрокаСтоимости.BVAL > 0 Тогда
				СтрокаСтоимости.УровеньОценки = 2;
				СтрокаСтоимости.Источник = ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
				СтрокаСтоимости.Стоимость = ?(СтрокаСтоимости.BGN > 0, СтрокаСтоимости.BGN, СтрокаСтоимости.BVAL);
				СтрокаСтоимости.ВидЦены = ?(СтрокаСтоимости.BGN > 0, Перечисления.ИсточникиЦеныДляПереоценки.СредняяЦенаЗакрытия, Перечисления.ИсточникиЦеныДляПереоценки.СредневзвешеннаяЦена);
				СтрокаСтоимости.ДатаЦены = СтрокаСтоимости.ДатаЦеныБлумберга;
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		
		//вынесено в процедуру ЗаполнитьПереоценкуАтомфонда, т.к. зависит от даты покупки 
		////2.с - только для долговых российских бумаг. Для иностранных ЦБ пропускается. 
		////3.а
		////3.с (как 2.с, но по кредитному спреду бумаги, а не эмитента)
		
		СтрокаСтоимости.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.ПустаяСсылка();
		СтрокаСтоимости.ДатаЦены = 0;
		
	КонецЦикла;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "После проверки цены на адекватность", ТаблицаСтоимостейЦБ.Скопировать());		
	КонецЕсли;	
	
	Возврат ТаблицаСтоимостейЦБ;
КонецФункции

Функция ПолучитьЦеныАтомфонда2018(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)

	Если Не ПараметрыОценки.Свойство("ОцениватьПоСправедливойСтоимости") И ДатаПереоценки < '20190101' Тогда
		ПараметрыОценки.Вставить("ОцениватьПоСправедливойСтоимости", Истина); // До этой даты по амортизированной стоимости бумаги не оценивали	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "ИсходнаяТаблицаЦБ");
	ПоместитьБумагиОцениваемыеПоАмортизированнойСтоимостиВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки, ДатаПереоценки, "ИсходнаяТаблицаЦБ");
	
	#Область Текст_запроса	
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ1
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Акции.ОсновнойВыпуск,
		|	ИсходнаяТаблицаЦБ.Рынок,
		|	Акции.УчетныйАктивЦБРФ
		|ИЗ
		|	Справочник.Акции КАК Акции
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ПО (ИсходнаяТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка)
		|ГДЕ
		|	Акции.ОсновнойВыпуск <> ЗНАЧЕНИЕ(Справочник.Акции.пустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КонвертацияЦенныхБумаг.ЦеннаяБумага,
		|	КонвертацияЦенныхБумаг.Рынок,
		|	КонвертацияЦенныхБумаг.ЦеннаяБумага.УчетныйАктивЦБРФ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КонвертацияЦенныхБумаг КАК КонвертацияЦенныхБумаг
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = КонвертацияЦенныхБумаг.ЦеннаяБумагаНовая
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ1.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ1.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ1.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ВЫБОР
		|		КОГДА ИсходнаяТаблицаЦБ1.УчетныйАктивЦБРФ В (&БумагиНерезидентов)
		|			ТОГДА ЛОЖЬ
		|		КОГДА ИсходнаяТаблицаЦБ1.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА ИсходнаяТаблицаЦБ1.ЦеннаяБумага.Подкатегория = &ОВОЗ
		|						ТОГДА ЛОЖЬ
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЦБРФ,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, НЕОПРЕДЕЛЕНО) КАК ДатаПогашения,
		|	_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК ОценкаПоАмортизированнойСтоимости
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ1 КАК ИсходнаяТаблицаЦБ1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ1.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ1.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _БумагиОцениваемыеПоАмортизированнойСтоимости КАК _БумагиОцениваемыеПоАмортизированнойСтоимости
		|		ПО (_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага = ИсходнаяТаблицаЦБ1.ЦеннаяБумага)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа КАК Биржа,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.РежимТоргов КАК РежимТоргов,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта КАК Валюта,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2 КАК MARKETPRICE2,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE КАК MARKETPRICE2_DATE
		|ПОМЕСТИТЬ _СводныеКотировкиТорговыхПлощадокСРежимами
		|ИЗ
		|	РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|			&ДатаПереоценки,
		|			РежимТоргов.ОсновнойРежим
		|				И Биржа = &ММВБ
		|				И ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|					ИЗ
		|						ТаблицаЦБ КАК ТаблицаЦБ)) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_СводныеКотировки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_СводныеКотировки.Биржа КАК Биржа,
		|	_СводныеКотировки.Валюта КАК Валюта,
		|	Котировка_MARKETPRICE2.MARKETPRICE2_DATE КАК MARKETPRICE2_DATE,
		|	Котировка_MARKETPRICE2.MARKETPRICE2 КАК MARKETPRICE2
		|ПОМЕСТИТЬ _СводныеКотировкиТорговыхПлощадок
		|ИЗ
		|	(ВЫБРАТЬ
		|		_СводныеКотировкиСРежимами.ЦеннаяБумага КАК ЦеннаяБумага,
		|		_СводныеКотировкиСРежимами.Биржа КАК Биржа,
		|		_СводныеКотировкиСРежимами.Валюта КАК Валюта,
		|		МАКСИМУМ(_СводныеКотировкиСРежимами.MARKETPRICE2_DATE) КАК MARKETPRICE2_DATE
		|	ИЗ
		|		_СводныеКотировкиТорговыхПлощадокСРежимами КАК _СводныеКотировкиСРежимами
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_СводныеКотировкиСРежимами.ЦеннаяБумага,
		|		_СводныеКотировкиСРежимами.Биржа,
		|		_СводныеКотировкиСРежимами.Валюта) КАК _СводныеКотировки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СводныеКотировкиТорговыхПлощадокСРежимами КАК Котировка_MARKETPRICE2
		|		ПО (Котировка_MARKETPRICE2.ЦеннаяБумага = _СводныеКотировки.ЦеннаяБумага)
		|			И (Котировка_MARKETPRICE2.Валюта = _СводныеКотировки.Валюта)
		|			И (Котировка_MARKETPRICE2.Биржа = _СводныеКотировки.Биржа)
		|			И (Котировка_MARKETPRICE2.MARKETPRICE2_DATE = _СводныеКотировки.MARKETPRICE2_DATE)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ЕСТЬNULL(КотировкиТорговыхПлощадок.MARKETPRICE2, 0) КАК MARKETPRICE2,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.Период ЕСТЬ NULL
		|			ТОГДА 0
		|		КОГДА ТаблицаЦБ.ЦБРФ
		|			ТОГДА ВЫБОР
		|					КОГДА КотировкиТорговыхПлощадок.OFFER = 0
		|							ИЛИ КотировкиТорговыхПлощадок.BID = 0
		|							ИЛИ КотировкиТорговыхПлощадок.MARKETPRICE2 = 0
		|						ТОГДА 0
		|					КОГДА КотировкиТорговыхПлощадок.OFFER < КотировкиТорговыхПлощадок.BID
