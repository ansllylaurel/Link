		|			И (КотировкиБлумбергBVAL.РежимТоргов = &Режим_BVAL)
		|			И (КотировкиБлумбергBVAL.Период = &ПоследняяДатаТорговБлумберг)
		|			И (КотировкиБлумбергBVAL.WAPRICE <> 0)
		|ГДЕ
		|	ТаблицаЦБ.СчитаемЧтоДефолт = ЛОЖЬ
		|	И ЦБУровень1.ЦеннаяБумага ЕСТЬ NULL
		|	И НЕ &ТолькоНаблюдаемыеЦены
		|	И (КотировкиБлумбергBGN.CLOSE ЕСТЬ НЕ NULL 
		|			ИЛИ КотировкиБлумбергBVAL.WAPRICE ЕСТЬ НЕ NULL )
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	РеквизитыПИФ.УправляющаяКомпания.ЮрФизЛицо КАК Источник,
		|	РасчетныеЦеныПаев.РасчетнаяЦена КАК СправедливаяЦена,
		|	РасчетныеЦеныПаев.Период КАК ДатаЦены,
		|	3 КАК УровеньОценки,
