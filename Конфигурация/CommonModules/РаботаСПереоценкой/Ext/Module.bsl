	|	ЦенныеБумагиСГруппировкой.КоличествоСтрок > 1";
	
	
	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		Запрос.УстановитьПараметр("ЦенныеБумаги", Объект.ЦенныеБумаги);
	Иначе 
		Запрос.УстановитьПараметр("ЦенныеБумаги", Объект.ЦенныеБумаги.Выгрузить(,"УчетныйАктивЕПС,ЦеннаяБумага,Количество,КурсВалютыНоминала,НачальныеДисконтПремия,
		|ОценочныеДисконтПремия,ОценочныеДисконтПремияВВалютеУчета,ОценочнаяКорректировкаЭСП,ОценочнаяКорректировкаЭСПВВалютеУчета,ОценочнаяРазницаППНеНаблюдаемыеДанные,ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета"));
	КонецЕсли;
	Запрос.УстановитьПараметр("Период", НачалоДня(Объект.Дата));
	
	ВалютаУчета = Объект.Организация.ВалютаУчета;
	
	Запрос.УстановитьПараметр("ВалютаУчета", ВалютаУчета);
		
	РезультатЗапроса = Запрос.Выполнить();
	Расхождения = РезультатЗапроса.Выгрузить();
	
	Для каждого СтрокаРасхождения Из Расхождения Цикл
		
		ПогрешностьДисконтКРаспределениюВВалютеУчета = 0;
		ПогрешностьПремияКРаспределениюВВалютеУчета = 0;
		ПогрешностьКорректировкаЭСПКРаспределениюВВалютеУчета = 0;
		ПогрешностьРазницаППНеНаблюдаемыеДанныеКРаспределениюВВалютеУчета = 0;
		
		СтрокиСЦеннойБумагой = Объект.ЦенныеБумаги.НайтиСтроки(Новый Структура("ЦеннаяБумага,УчетныйАктивЕПС", СтрокаРасхождения.ЦеннаяБумага, СтрокаРасхождения.УчетныйАктивЕПС));
		
		КоличествоКРаспределениюДисконт = 0;
		КоличествоКРаспределениюПремия = 0;
		КоличествоКРаспределениюКорректировкаЭСП = 0;
		КоличествоКРаспределениюРазницаПП = 0;
		
		Для каждого СтрокаСЦеннойБумагой Из СтрокиСЦеннойБумагой Цикл
			Если СтрокаСЦеннойБумагой.НачальныеДисконтПремия < 0 Тогда
				КоличествоКРаспределениюДисконт = КоличествоКРаспределениюДисконт + СтрокаСЦеннойБумагой.Количество;
			ИначеЕсли СтрокаСЦеннойБумагой.НачальныеДисконтПремия > 0 Тогда
				КоличествоКРаспределениюПремия = КоличествоКРаспределениюПремия + СтрокаСЦеннойБумагой.Количество;
			КонецЕсли;
			Если СтрокаСЦеннойБумагой.ОценочнаяКорректировкаЭСП <> 0 Тогда
				КоличествоКРаспределениюКорректировкаЭСП = КоличествоКРаспределениюКорректировкаЭСП + СтрокаСЦеннойБумагой.Количество;
			КонецЕсли;
			Если СтрокаСЦеннойБумагой.ОценочнаяРазницаППНеНаблюдаемыеДанные <> 0 Тогда
				КоличествоКРаспределениюРазницаПП = КоличествоКРаспределениюРазницаПП + СтрокаСЦеннойБумагой.Количество;
			КонецЕсли;
		КонецЦикла;
		
		ОценочныйДисконтВВалютеУчетаРасчет = Окр(СтрокаРасхождения.ОценочныйДисконт * СтрокаРасхождения.Курс / СтрокаРасхождения.Кратность, 2);
		ОценочнаяПремияВВалютеУчетаРасчет = Окр(СтрокаРасхождения.ОценочнаяПремия * СтрокаРасхождения.Курс / СтрокаРасхождения.Кратность, 2);
		ОценочнаяКорректировкаЭСПВВалютеУчетаРасчет = Окр(СтрокаРасхождения.ОценочнаяКорректировкаЭСП * СтрокаРасхождения.Курс / СтрокаРасхождения.Кратность, 2);
		ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчетаРасчет = Окр(СтрокаРасхождения.ОценочнаяРазницаППНеНаблюдаемыеДанные * СтрокаРасхождения.Курс / СтрокаРасхождения.Кратность, 2);
		
		ПогрешностьДисконтКРаспределениюВВалютеУчета = ОценочныйДисконтВВалютеУчетаРасчет - СтрокаРасхождения.ОценочныйДисконтВВалютеУчета;
		ПогрешностьПремияКРаспределениюВВалютеУчета = ОценочнаяПремияВВалютеУчетаРасчет - СтрокаРасхождения.ОценочнаяПремияВВалютеУчета;
		ПогрешностьКорректировкаЭСПКРаспределениюВВалютеУчета = ОценочнаяКорректировкаЭСПВВалютеУчетаРасчет - СтрокаРасхождения.ОценочнаяКорректировкаЭСПВВалютеУчета;
		ПогрешностьРазницаППНеНаблюдаемыеДанныеКРаспределениюВВалютеУчета = ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчетаРасчет - СтрокаРасхождения.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета;
			
		Если ПогрешностьДисконтКРаспределениюВВалютеУчета = 0 
			И ПогрешностьПремияКРаспределениюВВалютеУчета = 0 
			И ПогрешностьКорректировкаЭСПКРаспределениюВВалютеУчета = 0 
			И ПогрешностьРазницаППНеНаблюдаемыеДанныеКРаспределениюВВалютеУчета = 0 
			Тогда
			Продолжить;
		КонецЕсли;
		
		Если НастройкиПоВидуУчета.МетодУчетаПогрешностиОкругления = Перечисления.МетодыУчетаПогрешностиОкругления.РавномерноеРаспределение Тогда
		
			Для каждого СтрокаСЦеннойБумагой Из СтрокиСЦеннойБумагой Цикл
				
				ПогрешностьДисконтВВалютеУчета = 0;
				ПогрешностьПремияВВалютеУчета = 0;
				ПогрешностьКорректировкаЭСПВВалютеУчета = 0;
			    ПогрешностьРазницаППНеНаблюдаемыеВВалютеУчета = 0;
				
				Если СтрокаСЦеннойБумагой.НачальныеДисконтПремия < 0 И КоличествоКРаспределениюДисконт <> 0 Тогда
					ПогрешностьДисконтВВалютеУчета = Окр(ПогрешностьДисконтКРаспределениюВВалютеУчета / КоличествоКРаспределениюДисконт * СтрокаСЦеннойБумагой.Количество, 2);
				ИначеЕсли СтрокаСЦеннойБумагой.НачальныеДисконтПремия > 0 И КоличествоКРаспределениюПремия <> 0 Тогда
					ПогрешностьПремияВВалютеУчета = Окр(ПогрешностьПремияКРаспределениюВВалютеУчета / КоличествоКРаспределениюПремия * СтрокаСЦеннойБумагой.Количество, 2);
				КонецЕсли;
				Если СтрокаСЦеннойБумагой.ОценочнаяКорректировкаЭСП <> 0 И КоличествоКРаспределениюКорректировкаЭСП <> 0 Тогда
					ПогрешностьКорректировкаЭСПВВалютеУчета = Окр(ПогрешностьКорректировкаЭСПКРаспределениюВВалютеУчета / КоличествоКРаспределениюКорректировкаЭСП * СтрокаСЦеннойБумагой.Количество, 2);
				КонецЕсли;
				Если СтрокаСЦеннойБумагой.ОценочнаяРазницаППНеНаблюдаемыеДанные <> 0 И КоличествоКРаспределениюРазницаПП <> 0 Тогда
					ПогрешностьРазницаППНеНаблюдаемыеВВалютеУчета = Окр(ПогрешностьРазницаППНеНаблюдаемыеДанныеКРаспределениюВВалютеУчета / КоличествоКРаспределениюРазницаПП * СтрокаСЦеннойБумагой.Количество, 2);
				КонецЕсли;
				
				Если ПогрешностьДисконтВВалютеУчета <> 0
					ИЛИ ПогрешностьПремияВВалютеУчета <> 0
					ИЛИ ПогрешностьКорректировкаЭСПВВалютеУчета <> 0
					ИЛИ ПогрешностьРазницаППНеНаблюдаемыеВВалютеУчета <> 0 Тогда
					
					СтрокаСЦеннойБумагой.ОценочныеДисконтПремияВВалютеУчета = СтрокаСЦеннойБумагой.ОценочныеДисконтПремияВВалютеУчета + ПогрешностьДисконтВВалютеУчета + ПогрешностьПремияВВалютеУчета;
					СтрокаСЦеннойБумагой.ОценочнаяКорректировкаЭСПВВалютеУчета = СтрокаСЦеннойБумагой.ОценочнаяКорректировкаЭСПВВалютеУчета + ПогрешностьКорректировкаЭСПВВалютеУчета;
					СтрокаСЦеннойБумагой.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета = СтрокаСЦеннойБумагой.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета + ПогрешностьРазницаППНеНаблюдаемыеВВалютеУчета;
					
					ПогрешностьДисконтКРаспределениюВВалютеУчета = ПогрешностьДисконтКРаспределениюВВалютеУчета - ПогрешностьДисконтВВалютеУчета;
					ПогрешностьПремияКРаспределениюВВалютеУчета = ПогрешностьПремияКРаспределениюВВалютеУчета - ПогрешностьПремияВВалютеУчета;
					ПогрешностьКорректировкаЭСПКРаспределениюВВалютеУчета = ПогрешностьКорректировкаЭСПКРаспределениюВВалютеУчета - ПогрешностьКорректировкаЭСПВВалютеУчета;
					ПогрешностьРазницаППНеНаблюдаемыеДанныеКРаспределениюВВалютеУчета = ПогрешностьРазницаППНеНаблюдаемыеДанныеКРаспределениюВВалютеУчета - ПогрешностьРазницаППНеНаблюдаемыеВВалютеУчета;
				КонецЕсли;
				
				Если СтрокаСЦеннойБумагой.НачальныеДисконтПремия < 0 Тогда
					КоличествоКРаспределениюДисконт = КоличествоКРаспределениюДисконт - СтрокаСЦеннойБумагой.Количество;
				ИначеЕсли СтрокаСЦеннойБумагой.НачальныеДисконтПремия > 0 Тогда
					КоличествоКРаспределениюПремия = КоличествоКРаспределениюПремия - СтрокаСЦеннойБумагой.Количество;
				КонецЕсли;
				
				Если СтрокаСЦеннойБумагой.ОценочнаяКорректировкаЭСП <> 0 Тогда
					КоличествоКРаспределениюКорректировкаЭСП = КоличествоКРаспределениюКорректировкаЭСП - СтрокаСЦеннойБумагой.Количество;
				КонецЕсли;
				
				Если СтрокаСЦеннойБумагой.ОценочнаяРазницаППНеНаблюдаемыеДанные <> 0 Тогда
					КоличествоКРаспределениюРазницаПП = КоличествоКРаспределениюРазницаПП - СтрокаСЦеннойБумагой.Количество;
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли НастройкиПоВидуУчета.МетодУчетаПогрешностиОкругления = Перечисления.МетодыУчетаПогрешностиОкругления.НаСтрокуСНаибольшимКоличеством Тогда
			
			СтрокаСНаибольшимКоличеством = Неопределено;
			СтрокаСНаибольшимДисконт = Неопределено;
			СтрокаСНаибольшимПремия = Неопределено;
			НаибольшееКоличество = 0;
			НаибольшееКоличествоДисконт = 0;
			НаибольшееКоличествоПремия = 0;
			
			Для каждого СтрокаСЦеннойБумагой Из СтрокиСЦеннойБумагой Цикл
				
				Если НаибольшееКоличество < СтрокаСЦеннойБумагой.Количество
					ИЛИ (НаибольшееКоличество = СтрокаСЦеннойБумагой.Количество
						И СтрокаСЦеннойБумагой.Партия.Дата > СтрокаСНаибольшимКоличеством.Партия.Дата) Тогда
				
					СтрокаСНаибольшимКоличеством = СтрокаСЦеннойБумагой;
					НаибольшееКоличество = СтрокаСЦеннойБумагой.Количество;
					
				КонецЕсли;
				
				Если СтрокаСЦеннойБумагой.НачальныеДисконтПремия < 0
						И (НаибольшееКоличествоДисконт < СтрокаСЦеннойБумагой.Количество
						ИЛИ (НаибольшееКоличествоДисконт = СтрокаСЦеннойБумагой.Количество
							И СтрокаСЦеннойБумагой.Партия.Дата > СтрокаСНаибольшимДисконт.Партия.Дата)) Тогда
				
					СтрокаСНаибольшимДисконт = СтрокаСЦеннойБумагой;
					НаибольшееКоличествоДисконт = СтрокаСЦеннойБумагой.Количество;
					
				КонецЕсли;
					
				Если СтрокаСЦеннойБумагой.НачальныеДисконтПремия > 0
						И (НаибольшееКоличествоПремия < СтрокаСЦеннойБумагой.Количество
						ИЛИ (НаибольшееКоличествоПремия = СтрокаСЦеннойБумагой.Количество
							И СтрокаСЦеннойБумагой.Партия.Дата > СтрокаСНаибольшимПремия.Партия.Дата)) Тогда
				
					СтрокаСНаибольшимПремия = СтрокаСЦеннойБумагой;
					НаибольшееКоличествоПремия = СтрокаСЦеннойБумагой.Количество;
					
				КонецЕсли;
				
			КонецЦикла;
			
			СтрокаСНаибольшимДисконт.ОценочныеДисконтПремияВВалютеУчета = СтрокаСНаибольшимДисконт.ОценочныеДисконтПремияВВалютеУчета + ПогрешностьДисконтКРаспределениюВВалютеУчета;
			СтрокаСНаибольшимПремия.ОценочныеДисконтПремияВВалютеУчета = СтрокаСНаибольшимПремия.ОценочныеДисконтПремияВВалютеУчета + ПогрешностьПремияКРаспределениюВВалютеУчета;
			СтрокаСНаибольшимКоличеством.ОценочнаяКорректировкаЭСПВВалютеУчета = СтрокаСНаибольшимКоличеством.ОценочнаяКорректировкаЭСПВВалютеУчета + ПогрешностьКорректировкаЭСПВВалютеУчета;
			СтрокаСНаибольшимКоличеством.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета = СтрокаСНаибольшимКоличеством.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета + ПогрешностьРазницаППНеНаблюдаемыеВВалютеУчета;
			
		ИначеЕсли НастройкиПоВидуУчета.МетодУчетаПогрешностиОкругления = Перечисления.МетодыУчетаПогрешностиОкругления.НаПоследнююПартию Тогда
			
			СтрокаСПоследнейПартией = СтрокиСЦеннойБумагой[СтрокиСЦеннойБумагой.Количество() - 1];
			
			СтрокаСПоследнейДисконт = Неопределено;
			СтрокаСПоследнейПремия = Неопределено;
			Для каждого СтрокаСЦеннойБумагой Из СтрокиСЦеннойБумагой Цикл
				Если СтрокаСЦеннойБумагой.НачальныеДисконтПремия < 0 Тогда
					СтрокаСПоследнейДисконт = СтрокаСЦеннойБумагой;
				ИначеЕсли СтрокаСЦеннойБумагой.НачальныеДисконтПремия > 0 Тогда
					СтрокаСПоследнейПремия = СтрокаСЦеннойБумагой;
				КонецЕсли;
			КонецЦикла;
			
			// доделать
			СтрокаСПоследнейДисконт.ОценочныеДисконтПремияВВалютеУчета = СтрокаСПоследнейПартией.ОценочныеДисконтПремияВВалютеУчета + ПогрешностьДисконтКРаспределениюВВалютеУчета;
			СтрокаСПоследнейПремия.ОценочныеДисконтПремияВВалютеУчета = СтрокаСПоследнейПартией.ОценочныеДисконтПремияВВалютеУчета + ПогрешностьПремияКРаспределениюВВалютеУчета;
			СтрокаСПоследнейПартией.ОценочнаяКорректировкаЭСПВВалютеУчета = СтрокаСПоследнейПартией.ОценочнаяКорректировкаЭСПВВалютеУчета + ПогрешностьКорректировкаЭСПВВалютеУчета;
			СтрокаСПоследнейПартией.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета = СтрокаСПоследнейПартией.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета + ПогрешностьРазницаППНеНаблюдаемыеВВалютеУчета;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Определение_дат_переоценок

Процедура ДобавитьДатыОпераций(ДатыПереоценки, ДатаНачала, ДатаОкончания, СчетДоверительногоУправления, ВидУчета)

	// Определяем даты, исключая отмененные сделки
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОперацииСЦеннымиБумагами.Регистратор КАК Регистратор,
		|	ОперацииСЦеннымиБумагами.Основание КАК Основание
		|ПОМЕСТИТЬ _ОтменыСделок
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|ГДЕ
		|	ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления В(&СписокСтратегий)
		|	И ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.ОтменаСделки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НАЧАЛОПЕРИОДА(ОперацииСЦеннымиБумагами.ДатаОперации, ДЕНЬ) КАК ДатаОперации
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|ГДЕ
		|	ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И (ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.ВводЦенныхБумаг
		|			ИЛИ ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.ВыводЦенныхБумаг
		|			ИЛИ ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.ИсполнениеОбязательствПоСделке
		|			ИЛИ ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.ПогашениеКупона
		|			ИЛИ ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.ПогашениеЦеннойБумаги
		|			ИЛИ ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.ПоставкаЦенныхБумаг
		|			ИЛИ ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.Сделка
		|			ИЛИ ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.СделкаРЕПО)
		|	И НЕ ОперацииСЦеннымиБумагами.Регистратор В
		|				(ВЫБРАТЬ
		|					_ОтменыСделок.Основание
		|				ИЗ
		|					_ОтменыСделок КАК _ОтменыСделок)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ПорученияНаПереоценку.ДатаПереоценки
		|ИЗ
		|	РегистрСведений.ПорученияНаПереоценку КАК ПорученияНаПереоценку
		|ГДЕ
		|	ПорученияНаПереоценку.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПорученияНаПереоценку.ВидУчета = &ВидУчета
		|	И ПорученияНаПереоценку.Активность
		|	И ПорученияНаПереоценку.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивовДляПорученийНаПереоценку.ЦенныеБумаги)
		|	И ПорученияНаПереоценку.ДатаПереоценки >= &ДатаНачала
		|	И ПорученияНаПереоценку.ДатаПереоценки <= &ДатаОкончания";
		
	Запрос.УстановитьПараметр("ДатаНачала",						ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",					ДатаОкончания);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СписокСтратегий",				Справочники.СчетаДоверительногоУправления.ПолучитьМассивСчетовПоДоговоруДУ(СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("ВидУчета",						ВидУчета);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		РаботаСКоллекциями.ДополнитьМассив(ДатыПереоценки, Выборка.ДатаОперации, Истина);
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьТаблицуДатПереоценкиСУчетомРеформацииБалансов(СчетДоверительногоУправления, ДатаНачала, ДатаОкончания, МассивДатПереоценки)
	
	//скорректируем с учетом реформаций      
	// если переоценка ежедневно, то дата реформации, попадающая в период переоценки, будет отработана в первом подзапросе
	// если переоценка, например, ежемесячно, и в дату реформации нет переоценок, то второй подзапрос добавит в список  дату реформации 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДанныеКалендаря.Дата КАК Дата,
		|	ДанныеКалендаря.Дата = ЕСТЬNULL(РеформацииБалансов.ДатаРеформации, ДАТАВРЕМЯ(1, 1, 1)) КАК Реформация,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА РеформацииБалансовПредыдущие.ДатаРеформации ЕСТЬ NULL
		|				ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		|			ИНАЧЕ ДОБАВИТЬКДАТЕ(РеформацииБалансовПредыдущие.ДатаРеформации, ДЕНЬ, 1)
		|		КОНЕЦ) КАК СледующийДеньПослеПредыдущейРеформации
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеформацииБалансов КАК РеформацииБалансов
		|		ПО (РеформацииБалансов.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|			И (РеформацииБалансов.ДатаРеформации = ДанныеКалендаря.Дата)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеформацииБалансов КАК РеформацииБалансовПредыдущие
		|		ПО ДанныеКалендаря.Дата > РеформацииБалансовПредыдущие.ДатаРеформации
		|			И (РеформацииБалансовПредыдущие.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|ГДЕ
		|	ДанныеКалендаря.Дата В(&ДатыПереоценок)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеКалендаря.Дата,
		|	ДанныеКалендаря.Дата = ЕСТЬNULL(РеформацииБалансов.ДатаРеформации, ДАТАВРЕМЯ(1, 1, 1))
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	РеформацииБалансов.ДатаРеформации,
		|	ИСТИНА,
		|	ВЫБОР
		|		КОГДА РеформацииБалансовПредыдущие.ДатаРеформации ЕСТЬ NULL
		|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		|		ИНАЧЕ ДОБАВИТЬКДАТЕ(РеформацииБалансовПредыдущие.ДатаРеформации, ДЕНЬ, 1)
		|	КОНЕЦ
		|ИЗ
		|	РегистрСведений.РеформацииБалансов КАК РеформацииБалансов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеформацииБалансов КАК РеформацииБалансовПредыдущие
		|		ПО (РеформацииБалансовПредыдущие.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|			И (РеформацииБалансовПредыдущие.ДатаРеформации < РеформацииБалансов.ДатаРеформации)
		|ГДЕ
		|	РеформацииБалансов.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И РеформацииБалансов.ДатаРеформации < &ОкончаниеПериода
		|	И РеформацииБалансов.ДатаРеформации >= &НачалоПериода
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";

	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ДатаОкончания);
	Запрос.УстановитьПараметр("НачалоПериода", ДатаНачала);
	Запрос.УстановитьПараметр("ДатыПереоценок", МассивДатПереоценки);
 	
	Возврат Запрос.Выполнить().Выгрузить(); 
	
КонецФункции	

Функция ОпределитьДатыПереоценокЗаПериод(СчетДоверительногоУправления, ВидУчета, ДатаНачала, ДатаОкончания) Экспорт
	
	МассивДатПереоценки = Новый Массив; 
	ФормированиеСпискаЗакончено = Ложь;
	
	Если ТипЗнч(ВидУчета) = Тип("Строка") Тогда
		ВидУчета = Перечисления.ВидыУчета[ВидУчета];
	КонецЕсли;
	
	ДатаНачала = НачалоДня(ДатаНачала);
	ДатаОкончания = КонецДня(ДатаОкончания);        

	
	Если ЗначениеЗаполнено(СчетДоверительногоУправления.ДатаРасторжения) И СчетДоверительногоУправления.ДатаРасторжения < ДатаОкончания Тогда
		РаботаСКоллекциями.ДополнитьМассив(МассивДатПереоценки, СчетДоверительногоУправления.ДатаРасторжения, Истина);  
	КонецЕсли;
	
	Если ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НастройкиУчетаАктивовЕПССрезПоследних.ПериодичностьПереоценки КАК ПериодичностьПереоценки,
			|	НастройкиУчетаАктивовЕПССрезПоследних.ПериодичностьНачисленияПроцентныхДоходов КАК ПериодичностьНачисленияПроцентныхДоходов,
			|	НастройкиУчетаАктивовЕПССрезПоследних.УчетныйАктив КАК УчетныйАктив,
			|	&ДатаНачала КАК Период,
			|	НастройкиУчетаАктивовЕПССрезПоследних.ПереоцениватьВДеньОперации КАК ПереоцениватьВДеньОперации,
			|	НастройкиУчетаАктивовЕПССрезПоследних.НачислятьПроцентныеДоходыВДеньОперации КАК НачислятьПроцентныеДоходыВДеньОперации,
			|	НастройкиУчетаАктивовЕПССрезПоследних.ПереоцениватьВНерабочиеДни КАК ПереоцениватьВНерабочиеДни,
			|	НастройкиУчетаАктивовЕПССрезПоследних.НачислятьПроцентныеДоходыВНерабочиеДни КАК НачислятьПроцентныеДоходыВНерабочиеДни,
			|	НастройкиУчетаАктивовЕПССрезПоследних.ПериодичностьНачисленияКорректировкиЭСП КАК ПериодичностьНачисленияКорректировкиЭСП
			|ПОМЕСТИТЬ СменаПериодов
			|ИЗ
			|	РегистрСведений.НастройкиУчетаАктивовЕПС.СрезПоследних(
			|			&ДатаНачала,
			|			СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидУчета = &ВидУчета) КАК НастройкиУчетаАктивовЕПССрезПоследних
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	НастройкиУчетаАктивовЕПС.ПериодичностьПереоценки,
			|	НастройкиУчетаАктивовЕПС.ПериодичностьНачисленияПроцентныхДоходов,
			|	НастройкиУчетаАктивовЕПС.УчетныйАктив,
			|	НастройкиУчетаАктивовЕПС.Период,
			|	НастройкиУчетаАктивовЕПС.ПереоцениватьВДеньОперации,
			|	НастройкиУчетаАктивовЕПС.НачислятьПроцентныеДоходыВДеньОперации,
			|	НастройкиУчетаАктивовЕПС.ПереоцениватьВНерабочиеДни,
			|	НастройкиУчетаАктивовЕПС.НачислятьПроцентныеДоходыВНерабочиеДни,
			|	НастройкиУчетаАктивовЕПС.ПериодичностьНачисленияКорректировкиЭСП
			|ИЗ
			|	РегистрСведений.НастройкиУчетаАктивовЕПС КАК НастройкиУчетаАктивовЕПС
			|ГДЕ
			|	НастройкиУчетаАктивовЕПС.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И НастройкиУчетаАктивовЕПС.ВидУчета = &ВидУчета
			|	И НастройкиУчетаАктивовЕПС.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СменаПериодов.УчетныйАктив КАК УчетныйАктив,
			|	СменаПериодов.Период КАК ПериодС,
			|	СменаПериодов.ПериодичностьПереоценки КАК ПериодичностьПереоценки,
			|	СменаПериодов.ПереоцениватьВДеньОперации КАК ПереоцениватьВДеньОперации,
			|	СменаПериодов.ПереоцениватьВНерабочиеДни КАК ПереоцениватьВНерабочиеДни,
			|	СменаПериодов.ПериодичностьНачисленияПроцентныхДоходов КАК ПериодичностьНачисленияПроцентныхДоходов,
			|	СменаПериодов.НачислятьПроцентныеДоходыВДеньОперации КАК НачислятьПроцентныеДоходыВДеньОперации,
			|	СменаПериодов.НачислятьПроцентныеДоходыВНерабочиеДни КАК НачислятьПроцентныеДоходыВНерабочиеДни,
			|	ЕСТЬNULL(МИНИМУМ(СменаПериодов1.Период), НЕОПРЕДЕЛЕНО) КАК ПериодПо,
			|	СменаПериодов.ПериодичностьНачисленияКорректировкиЭСП КАК ПериодичностьНачисленияКорректировкиЭСП
			|ИЗ
			|	СменаПериодов КАК СменаПериодов
			|		ЛЕВОЕ СОЕДИНЕНИЕ СменаПериодов КАК СменаПериодов1
			|		ПО СменаПериодов.УчетныйАктив = СменаПериодов1.УчетныйАктив
			|			И СменаПериодов.Период < СменаПериодов1.Период
			|
			|СГРУППИРОВАТЬ ПО
			|	СменаПериодов.УчетныйАктив,
			|	СменаПериодов.Период,
			|	СменаПериодов.ПериодичностьПереоценки,
			|	СменаПериодов.ПереоцениватьВДеньОперации,
			|	СменаПериодов.ПереоцениватьВНерабочиеДни,
			|	СменаПериодов.ПериодичностьНачисленияПроцентныхДоходов,
			|	СменаПериодов.НачислятьПроцентныеДоходыВДеньОперации,
			|	СменаПериодов.НачислятьПроцентныеДоходыВНерабочиеДни,
			|	СменаПериодов.ПериодичностьНачисленияКорректировкиЭСП";
		
		Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
		Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ДатаОкончанияВариантаПереоценки = ВыборкаДетальныеЗаписи.ПериодПо;
			ДатаОкончанияВариантаПереоценки = ?(ДатаОкончанияВариантаПереоценки = Неопределено, ДатаОкончания, ДатаОкончанияВариантаПереоценки);
			
			ДельтаМесяцев = 0;
			
			Если (ВыборкаДетальныеЗаписи.ПериодичностьПереоценки = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно)
				ИЛИ (ВыборкаДетальныеЗаписи.ПериодичностьНачисленияПроцентныхДоходов = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно)
				ИЛИ (ВыборкаДетальныеЗаписи.ПериодичностьНачисленияКорректировкиЭСП = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно) Тогда
				ТекДата = ДатаНачала;
				Пока ТекДата <= ДатаОкончанияВариантаПереоценки Цикл
					РаботаСКоллекциями.ДополнитьМассив(МассивДатПереоценки, ТекДата, Истина);
					ТекДата = ТекДата + 86400;
				КонецЦикла;   
				
				Прервать;

			Иначе
				ДельтаМесяцев = 1;
			КонецЕсли;
			
			Если ДельтаМесяцев > 0 Тогда
				ТекДата = ?(ДельтаМесяцев = 1, НачалоДня(КонецМесяца(ДатаНачала)), ?(ДельтаМесяцев = 3, НачалоДня(КонецКвартала(ДатаНачала)), НачалоДня(КонецГода(ДатаНачала))));
				Пока ТекДата <= ДатаОкончания Цикл
					РаботаСКоллекциями.ДополнитьМассив(МассивДатПереоценки, ТекДата, Истина);
					ТекДата = НачалоДня(КонецМесяца(ДобавитьМесяц(ТекДата, ДельтаМесяцев)));
				КонецЦикла;
			КонецЕсли;
			
			Если (ВыборкаДетальныеЗаписи.ПереоцениватьВДеньОперации ИЛИ ВыборкаДетальныеЗаписи.НачислятьПроцентныеДоходыВДеньОперации) Тогда
				
				ДобавитьДатыОпераций(МассивДатПереоценки, ДатаНачала, ДатаОкончания, СчетДоверительногоУправления, ВидУчета);
				
			КонецЕсли;

		КонецЦикла;
		
	Иначе //Не ЕПС	
		
		Если СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
			
			Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеКалендаря.Дата КАК Дата
			|ИЗ
			|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|ГДЕ
			|	ДанныеКалендаря.Календарь = &Календарь
			|	И ДанныеКалендаря.ВидДня В(ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
			|	И ДанныеКалендаря.Дата МЕЖДУ &НачалоПериода И &КонецПериода
			|
			|УПОРЯДОЧИТЬ ПО
			|	Дата");
			
			Запрос.УстановитьПараметр("Календарь", Справочники.Календари.Общероссийский);
			Запрос.УстановитьПараметр("НачалоПериода", ДатаНачала);
			Запрос.УстановитьПараметр("КонецПериода",  ДатаОкончания);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				РаботаСКоллекциями.ДополнитьМассив(МассивДатПереоценки, НачалоДня(Выборка.Дата), Истина);	
			КонецЦикла;
				
		Иначе
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	НастройкиУчетаАктивовСрезПоследних.ПериодичностьПереоценки КАК ПериодичностьПереоценки,
				|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив КАК УчетныйАктив,
				|	&ДатаНачала КАК Период,
				|	НастройкиУчетаАктивовСрезПоследних.ПереоцениватьВДеньОперации КАК ПереоцениватьВДеньОперации,
				|	НастройкиУчетаАктивовСрезПоследних.ПереоцениватьВНерабочиеДни КАК ПереоцениватьВНерабочиеДни
				|ПОМЕСТИТЬ СменаПериодов
				|ИЗ
				|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
				|			&ДатаНачала,
				|			СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И ВидУчета = &ВидУчета) КАК НастройкиУчетаАктивовСрезПоследних
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	НастройкиУчетаАктивов.ПериодичностьПереоценки,
				|	НастройкиУчетаАктивов.УчетныйАктив,
				|	НастройкиУчетаАктивов.Период,
				|	НастройкиУчетаАктивов.ПереоцениватьВДеньОперации,
				|	НастройкиУчетаАктивов.ПереоцениватьВНерабочиеДни
				|ИЗ
				|	РегистрСведений.НастройкиУчетаАктивов КАК НастройкиУчетаАктивов
				|ГДЕ
				|	НастройкиУчетаАктивов.СчетДоверительногоУправления = &СчетДоверительногоУправления
				|	И НастройкиУчетаАктивов.ВидУчета = &ВидУчета
				|	И НастройкиУчетаАктивов.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	СменаПериодов.УчетныйАктив КАК УчетныйАктив,
				|	СменаПериодов.Период КАК ПериодС,
				|	СменаПериодов.ПериодичностьПереоценки КАК ПериодичностьПереоценки,
				|	СменаПериодов.ПереоцениватьВДеньОперации КАК ПереоцениватьВДеньОперации,
				|	СменаПериодов.ПереоцениватьВНерабочиеДни КАК ПереоцениватьВНерабочиеДни,
				|	ЕСТЬNULL(МИНИМУМ(СменаПериодов1.Период), НЕОПРЕДЕЛЕНО) КАК ПериодПо
				|ИЗ
				|	СменаПериодов КАК СменаПериодов
				|		ЛЕВОЕ СОЕДИНЕНИЕ СменаПериодов КАК СменаПериодов1
				|		ПО СменаПериодов.УчетныйАктив = СменаПериодов1.УчетныйАктив
				|			И СменаПериодов.Период < СменаПериодов1.Период
				|
				|СГРУППИРОВАТЬ ПО
				|	СменаПериодов.УчетныйАктив,
				|	СменаПериодов.Период,
				|	СменаПериодов.ПериодичностьПереоценки,
				|	СменаПериодов.ПереоцениватьВДеньОперации,
				|	СменаПериодов.ПереоцениватьВНерабочиеДни";
			
			Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
			Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
			Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
			
			ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				ДатаОкончанияВариантаПереоценки = ВыборкаДетальныеЗаписи.ПериодПо;
				ДатаОкончанияВариантаПереоценки = ?(ДатаОкончанияВариантаПереоценки = Неопределено, ДатаОкончания, ДатаОкончанияВариантаПереоценки);
				
				ДельтаМесяцев = 0;
				
				Если (ВыборкаДетальныеЗаписи.ПериодичностьПереоценки = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно) Тогда
					
					ТекДата = ДатаНачала;
					
					Пока ТекДата <= ДатаОкончанияВариантаПереоценки Цикл
						
						РаботаСКоллекциями.ДополнитьМассив(МассивДатПереоценки, ТекДата, Истина);
						ТекДата = ТекДата + 86400;
						
					КонецЦикла;
					
					ФормированиеСпискаЗакончено = Истина;   
					Прервать;
					
				Иначе
					
					ДельтаМесяцев = 1;
					
				КонецЕсли;
				
				Если ДельтаМесяцев > 0 Тогда
					
					ТекДата = ?(ДельтаМесяцев = 1, 
									НачалоДня(КонецМесяца(ДатаНачала)), 
									?(ДельтаМесяцев = 3, 
											НачалоДня(КонецКвартала(ДатаНачала)),
											НачалоДня(КонецГода(ДатаНачала))));
					
					Пока ТекДата <= ДатаОкончания Цикл
												
						РаботаСКоллекциями.ДополнитьМассив(МассивДатПереоценки, ТекДата, Истина);
						ТекДата = НачалоДня(КонецМесяца(ДобавитьМесяц(ТекДата, ДельтаМесяцев)));
						
					КонецЦикла;
					
				КонецЕсли;
				
				Если ВыборкаДетальныеЗаписи.ПереоцениватьВДеньОперации Тогда
					
					ДобавитьДатыОпераций(МассивДатПереоценки, ДатаНачала, ДатаОкончания, СчетДоверительногоУправления, ВидУчета);
					
				КонецЕсли;

			КонецЦикла;
			
			// считается, что у всех в конце месяца
			// оставлю на случай, если неправильно заполнены настройки учета
			ТекущаяДатаПереоценки = НачалоДня(КонецМесяца(ДатаНачала));
			
			Пока НЕ ФормированиеСпискаЗакончено И (ТекущаяДатаПереоценки <= ДатаОкончания И ТекущаяДатаПереоценки <= КонецМесяца(ДатаОкончания)) Цикл
				РаботаСКоллекциями.ДополнитьМассив(МассивДатПереоценки, НачалоДня(ТекущаяДатаПереоценки), Истина);
				ТекущаяДатаПереоценки = НачалоДня(КонецМесяца(ДобавитьМесяц(ТекущаяДатаПереоценки, 1)));
			КонецЦикла;
			
			//по валютным бумагам д.б. перекурсовки в даты операций
			Если НЕ ФормированиеСпискаЗакончено Тогда 
				
				Запрос = Новый Запрос; 
				Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	НастройкиПоВидуУчетаСрезПоследних.ПериодичностьПерекурсовкиВалютныхАктивовИОбязательств КАК ПериодичностьПерекурсовкиВалютныхАктивовИОбязательств,
				|	&ДатаНачала КАК Период,
				|	НастройкиПоВидуУчетаСрезПоследних.ПерекурсовыватьВНерабочиеДни КАК ПерекурсовыватьВНерабочиеДни,
				|	НастройкиПоВидуУчетаСрезПоследних.ПерекурсовыватьВалютныеАктивыВМоментОперации КАК ПерекурсовыватьВалютныеАктивыВМоментОперации
				|ПОМЕСТИТЬ СменаПериодов
				|ИЗ
				|	РегистрСведений.НастройкиПоВидуУчета.СрезПоследних(
				|			&ДатаНачала,
				|			СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И ВидУчета = &ВидУчета) КАК НастройкиПоВидуУчетаСрезПоследних
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	НастройкиПоВидуУчета.ПериодичностьПерекурсовкиВалютныхАктивовИОбязательств,
				|	НастройкиПоВидуУчета.Период,
				|	НастройкиПоВидуУчета.ПерекурсовыватьВНерабочиеДни,
				|	НастройкиПоВидуУчета.ПерекурсовыватьВалютныеАктивыВМоментОперации
				|ИЗ
				|	РегистрСведений.НастройкиПоВидуУчета КАК НастройкиПоВидуУчета
				|ГДЕ
				|	НастройкиПоВидуУчета.СчетДоверительногоУправления = &СчетДоверительногоУправления
				|	И НастройкиПоВидуУчета.ВидУчета = &ВидУчета
				|	И НастройкиПоВидуУчета.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	НАЧАЛОПЕРИОДА(ОстаткиЦенныхБумаг.Период, ДЕНЬ) КАК ДатаОперации,
				|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОстаткиЦенныхБумаг.ЦеннаяБумага.ВалютаНоминала) КАК ЦеннаяБумагаВалютаНоминала
				|ПОМЕСТИТЬ _ДатыОперацийСВалютнымиБумагами
				|ИЗ
				|	РегистрНакопления.ОстаткиЦенныхБумаг КАК ОстаткиЦенныхБумаг
				|ГДЕ
				|	ОстаткиЦенныхБумаг.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
				|	И ОстаткиЦенныхБумаг.Рынок <> ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
				|	И ОстаткиЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
				|	И ОстаткиЦенныхБумаг.ЦеннаяБумага.ВалютаНоминала <> ОстаткиЦенныхБумаг.Организация.ВалютаУчета
				|
				|СГРУППИРОВАТЬ ПО
				|	НАЧАЛОПЕРИОДА(ОстаткиЦенныхБумаг.Период, ДЕНЬ)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	СменаПериодов.Период КАК ПериодС,
				|	СменаПериодов.ПериодичностьПерекурсовкиВалютныхАктивовИОбязательств КАК ПериодичностьПерекурсовки,
				|	СменаПериодов.ПерекурсовыватьВалютныеАктивыВМоментОперации КАК ПерекурсовыватьВалютныеАктивыВМоментОперации,
				|	ЕСТЬNULL(МИНИМУМ(СменаПериодов1.Период), НЕОПРЕДЕЛЕНО) КАК ПериодПо
				|ИЗ
				|	СменаПериодов КАК СменаПериодов
				|		ЛЕВОЕ СОЕДИНЕНИЕ СменаПериодов КАК СменаПериодов1
				|		ПО СменаПериодов.Период < СменаПериодов1.Период
				|
				|СГРУППИРОВАТЬ ПО
				|	СменаПериодов.Период,
				|	СменаПериодов.ПериодичностьПерекурсовкиВалютныхАктивовИОбязательств,
				|	СменаПериодов.ПерекурсовыватьВалютныеАктивыВМоментОперации,
				|	СменаПериодов.ПерекурсовыватьВНерабочиеДни";	
				
				ВалютныеУчетныеАктивы = Новый Массив;
				ВалютныеУчетныеАктивы.Добавить(Справочники.УчетныеАктивы.Еврооблигации);
				ВалютныеУчетныеАктивы.Добавить(Справочники.УчетныеАктивы.ЕврооблигацииКупон);
				ВалютныеУчетныеАктивы.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалюте);
				ВалютныеУчетныеАктивы.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалютеКупон);
				
				Запрос.УстановитьПараметр("ВалютныеУчетныеАктивы", ВалютныеУчетныеАктивы);
				Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
				Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
				Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
				Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
				
				ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
				
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					ДатаОкончанияВариантаПереоценки = ВыборкаДетальныеЗаписи.ПериодПо;
					ДатаОкончанияВариантаПереоценки = ?(ДатаОкончанияВариантаПереоценки = Неопределено, ДатаОкончания, ДатаОкончанияВариантаПереоценки);
					
					ДельтаМесяцев = 0;
					
					Если (ВыборкаДетальныеЗаписи.ПериодичностьПерекурсовки = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно) Тогда
						ТекДата = ДатаНачала;
						Пока ТекДата <= ДатаОкончанияВариантаПереоценки Цикл
							РаботаСКоллекциями.ДополнитьМассив(МассивДатПереоценки, ТекДата, Истина);
							ТекДата = ТекДата + 86400;
						КонецЦикла;     
						
						Прервать;
					Иначе
						ДельтаМесяцев = 1;
					КонецЕсли;
					
					Если ДельтаМесяцев > 0 Тогда
						ТекДата = ?(ДельтаМесяцев = 1, НачалоДня(КонецМесяца(ДатаНачала)), ?(ДельтаМесяцев = 3, НачалоДня(КонецКвартала(ДатаНачала)), НачалоДня(КонецГода(ДатаНачала))));
						Пока ТекДата <= ДатаОкончания Цикл
							РаботаСКоллекциями.ДополнитьМассив(МассивДатПереоценки, ТекДата, Истина);
							ТекДата = НачалоДня(КонецМесяца(ДобавитьМесяц(ТекДата, ДельтаМесяцев)));
						КонецЦикла;
					КонецЕсли;
					
					Если (ВыборкаДетальныеЗаписи.ПериодичностьПерекурсовки = Перечисления.ПериодичностьПереоценкиАктивов.ЕжегодноИПослеПриобретенийИРеализаций
						ИЛИ ВыборкаДетальныеЗаписи.ПериодичностьПерекурсовки = Перечисления.ПериодичностьПереоценкиАктивов.ЕжеквартальноИПослеПриобретенийИРеализаций
						ИЛИ ВыборкаДетальныеЗаписи.ПериодичностьПерекурсовки = Перечисления.ПериодичностьПереоценкиАктивов.ЕжемесячноИПослеПриобретенийИРеализаций
						ИЛИ ВыборкаДетальныеЗаписи.ПериодичностьПерекурсовки = Перечисления.ПериодичностьПереоценкиАктивов.ПослеПриобретенийИРеализаций
						ИЛИ ВыборкаДетальныеЗаписи.ПерекурсовыватьВалютныеАктивыВМоментОперации) Тогда     
						
						ДатыОперацийСВалютнымиБумагами = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ДатыОперацийСВалютнымиБумагами").ПолучитьДанные().Выгрузить();
						
						Для каждого ДатаОперацийСВалютнымиБумагами из ДатыОперацийСВалютнымиБумагами Цикл
							РаботаСКоллекциями.ДополнитьМассив(МассивДатПереоценки, ДатаОперацийСВалютнымиБумагами.ДатаОперации, Истина);
						КонецЦикла;
						
					КонецЕсли;
				КонецЦикла;  
			КонецЕсли;		
		КонецЕсли;
		
	КонецЕсли;    
	
	Если МассивДатПереоценки.Найти(НачалоДня(ДатаОкончания)) = Неопределено Тогда
		//если нет переоценки на дату окончания периода - добавляем ее отдельно
		МассивДатПереоценки.Добавить(НачалоДня(ДатаОкончания));
	КонецЕсли;
			
	//перенесем данные в таблицу       
	ДатыПереоценки = ПолучитьТаблицуДатПереоценкиСУчетомРеформацииБалансов(СчетДоверительногоУправления, ДатаНачала, ДатаОкончания, МассивДатПереоценки);  
	
	Возврат ДатыПереоценки;
		
КонецФункции

#КонецОбласти

// Возвращает цены в соответствии с методиками клиента
// 
// Параметры:
//	ПараметрыОценки - Структура - должна содержать поля:
//		Организация - 
//		СчетДоверительногоУправления - 
//		ВидУчета -  
//		ВариантРасчетаСправедливойСтоимости -  
//		ПараметрыПолученияПартий - Структура - параметры в соотв. с РаботаСПереоценкой.ПолучитьПараметрыПолученияПартийПоМетодике  
//	ДатаПереоценки - Дата - дата переоценки 
//	ТаблицаЦБИсходная - ТаблицаЗначений - должна содержать колонки Рынок и ЦеннаяБумага
//	ТаблицаСтоимостей - ТаблицаЗначений, Неопределено - Таблица стоимостей, предоставленная клиентом
//	Отказ - Булево -
//	РасшифровкаРасчета - Структура, Неопределено - 
//
// Возвращаемое значение:
//	ТаблицаСтоимостейЦБ - ТаблицаЗначений - содержит колонки: ЦеннаяБумага, Стоимость, ВидЦены, УровеньЦены, ДатаЦены, Источник
//
Функция РассчитатьСтоимостьПереоценкиЕПС(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБИсходная, ТаблицаСтоимостей = Неопределено, Отказ, РасшифровкаРасчета = Неопределено) Экспорт
		
	#Область Дополнение_таблицы_ЦБ_общими_реквизитами 	
	
	Если ТаблицаЦБИсходная.Колонки.Найти("ВалютаНоминала") = Неопределено
		ИЛИ ТаблицаЦБИсходная.Колонки.Найти("УчетныйАктивЦБРФ") = Неопределено
	Тогда
	
		// дополним таблицу ценных бумаг дополнительными реквизитыми
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТаблицаЦБ", ТаблицаЦБИсходная);
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТаблицаЦБИсходная.Рынок КАК Рынок,
			|	ТаблицаЦБИсходная.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ТаблицаЦБИсходная.Количество КАК Количество
			|ПОМЕСТИТЬ _ТаблицаЦБ
			|ИЗ
			|	&ТаблицаЦБ КАК ТаблицаЦБИсходная
			|ГДЕ
			|	&ФильтрПоЦБ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ТаблицаЦБ.Рынок КАК Рынок,
			|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_ТаблицаЦБ.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
			|	_ТаблицаЦБ.ЦеннаяБумага.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
			|	_ТаблицаЦБ.Количество КАК Количество
			|ИЗ
			|	_ТаблицаЦБ КАК _ТаблицаЦБ";
		
		Если ТаблицаЦБИсходная.Колонки.Найти("Количество") = Неопределено Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаЦБИсходная.Количество", "0");
		КонецЕсли;
		
		Если РасшифровкаРасчета = Неопределено ИЛИ Не РасшифровкаРасчета.Свойство("ЦеннаяБумага") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрПоЦБ", "ИСТИНА");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрПоЦБ", "ТаблицаЦБИсходная.ЦеннаяБумага = &ФильтрПоЦБ");
			Запрос.УстановитьПараметр("ФильтрПоЦБ", РасшифровкаРасчета.ЦеннаяБумага);
		КонецЕсли;
		
		ТаблицаЦБ = Запрос.Выполнить().Выгрузить();
	
	Иначе
		
		ТаблицаЦБ = ТаблицаЦБИсходная;
		
	КонецЕсли;
	
	#КонецОбласти
	
	Если Не (ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены) Тогда
		
		#Область Исключаем_из_оценки_бумаги_с_приоритетной_оценочной_ценой
		
		ЦенныеБумагиСПриоритетнымиЦенами = ТаблицаЦБ.СкопироватьКолонки();
		ЦенныеБумагиСПриоритетнымиЦенами.Колонки.Добавить("СтрокиОценочнойСтоимости");
		
		Если Не ПараметрыОценки.Свойство("ДополнительныеСвойства") ИЛИ ПараметрыОценки.ДополнительныеСвойства = Неопределено Тогда
			ПараметрыОценки.Вставить("ДополнительныеСвойства", Новый Структура);
		КонецЕсли;
		
		Если ПараметрыОценки.ДополнительныеСвойства.Свойство("ОценкиСтоимости") Тогда
			ОценкиСтоимости = ПараметрыОценки.ДополнительныеСвойства.ОценкиСтоимости;
		Иначе
			ОценкиСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПолучитьОценкиСтоимости(
				ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления, ДатаПереоценки, ПараметрыОценки.ВариантРасчетаСправедливойСтоимости);
			ПараметрыОценки.ДополнительныеСвойства.Вставить("ОценкиСтоимости", ОценкиСтоимости);
		КонецЕсли;
		
		Для НомСтр = 1 - ТаблицаЦБ.Количество() По 0 Цикл
			
			СтрокаЦеннойБумаги = ТаблицаЦБ[-НомСтр];
			
			НайденныеСтроки = ОценкиСтоимости.НайтиСтроки(Новый Структура("ЦеннаяБумага, ПовышенныйПриоритет, ОценкаЦены", СтрокаЦеннойБумаги.ЦеннаяБумага, Истина, Истина));
		
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				СтрокаЦеннойБумагиСПриоритетнойЦеной = ЦенныеБумагиСПриоритетнымиЦенами.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаЦеннойБумагиСПриоритетнойЦеной, СтрокаЦеннойБумаги);
				СтрокаЦеннойБумагиСПриоритетнойЦеной.СтрокиОценочнойСтоимости = НайденныеСтроки;
				
				ТаблицаЦБ.Удалить(СтрокаЦеннойБумаги);
				
			КонецЕсли;
			
		КонецЦикла;
		
		#КонецОбласти
		
	КонецЕсли;
	
	ТаблицаСтоимостейЦБ = Неопределено;
	
	// Используемые методики
	Если ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Сбербанк Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныСбербанка(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.СбербанкСтрахование Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныСбербанкаСтрахование(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Традиция Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныТрадиции(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Традиция2019 Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныТрадиции2019(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);		
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Стройкомплекс2018 Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныСтройкомплекса2018(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Стройкомплекс Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныСтройкомплекса(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Сургутнефтегаз Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныСургутнефтегаза(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Сургутнефтегаз2020 Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныСургутнефтегаза2020(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2018 Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныТранснефти2018(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2020 Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныТранснефти2020(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);		
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Перспектива2020 И ДатаПереоценки < '20210101' Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныУГМКПерспективы2020(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Перспектива2020 И ДатаПереоценки >= '20210101' Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныУГМКПерспективы2021(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);	
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2018 Тогда
		ТаблицаСтоимостейЦБ = ПолучитьЦеныАтомфонда2018(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020 Тогда
		ТаблицаСтоимостейЦБ = ПолучитьЦеныАтомфонда2020(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныАтомфонда(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Лукойл Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныЛукойла(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныНационального(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2018 Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныНационального2018(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2019 Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныНационального2019(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020 Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныНационального2020(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020_2 Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныНационального2020_2(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);		
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Аквилон2021 Тогда 
		ТаблицаСтоимостейЦБ = ПолучитьЦеныАквилона2021(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета);
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Большой Тогда 
