		|		КОГДА КотировкиБлумбергУровень1.ПолеКотировки > 0
		|			ТОГДА КотировкиБлумбергУровень1.ИсточникКотировки
		|		ИНАЧЕ &ММВБ
		|	КОНЕЦ КАК Источник,
		|	КотировкиБлумбергУровень1.ВалютаКотировки КАК ВалютаКотировки,
		|	ЕСТЬNULL(Биржи.Ссылка, ЗНАЧЕНИЕ(Справочник.Биржи.ПустаяСсылка)) КАК Биржа,
		|	КотировкиБлумбергУровень1.СправедливаяЦена КАК Стоимость,
		|	ТаблицаЦБ.ТоргуетсяНаММВБ КАК ТоргуетсяНаММВБ
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ КотировкиБлумбергУровень1 КАК КотировкиБлумбергУровень1
		|		ПО ТаблицаЦБ.ЦеннаяБумага = КотировкиБлумбергУровень1.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (КотировкиБлумбергУровень1.ИсточникКотировки = Биржи.ЮрФизЛицо)");
	
	#КонецОбласти	
	
	БиржаММВБ						= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	Блумберг						= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");	
	ИностранныеУчетныеАктивы		= Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();	   	
	ПоследняяДатаТорговБлумберга	= РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки, Блумберг);	
	ПоследняяДатаТоргов				= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки));
	ТорговыхДнейНазад10				= Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -10);
	
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",			ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10",			ТорговыхДнейНазад10);
	Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберга",	ПоследняяДатаТорговБлумберга);
	
	Запрос.УстановитьПараметр("ММВБ",							БиржаММВБ);
	Запрос.УстановитьПараметр("НРД",							ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("Блумберг",						Блумберг);
	
	Запрос.УстановитьПараметр("Режим_BGN",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	
	Запрос.УстановитьПараметр("ИностранныеУчетныеАктивы",		ИностранныеУчетныеАктивы);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ",				ТаблицаЦБ);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены ОПК 2018 (ЕПС)", "Таблица стоимостей ЦБ", , , "ИсходнаяТаблицаЦБ");
	КонецЕсли;
	
	// Расчетные цены
	
	СтрокиДляРасчета = ТаблицаСтоимостейЦБ.НайтиСтроки(Новый Структура("ВидЦены, Источник", Перечисления.ИсточникиЦеныдляПереоценки.РасчетнаяЦена, БиржаММВБ));	
	
	Если СтрокиДляРасчета.Количество() > 0 Тогда

		ВалютаРубли = ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"); 	

		ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
		ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
		ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);

		ПараметрыРасчетаСтоимостиПоАналогам = Новый Структура;
		ПараметрыРасчетаСтоимостиПоАналогам.Вставить("ВариантРасчета",	 Справочники.ВариантыРасчетаОценочнойСтоимости.ОПК2018);
		ПараметрыРасчетаСтоимостиПоАналогам.Вставить("ПараметрыЗапроса", Запрос.Параметры);		
		
		ПараметрыОценки.Вставить("ПараметрыРасчетаСтоимостиПоАналогам", ПараметрыРасчетаСтоимостиПоАналогам);
		
		ТаблицаСпросовИПредложений = Неопределено;
		
		МассивСтрокКУдалению = Новый Массив;		
		
		Для Каждого СтрокаДляРасчета Из СтрокиДляРасчета Цикл
			
			// Расчет PV по ставке, рассчитанной по аналогам
			
 			ЗаполнитьДисконтированнойПоСтавкеРассчитаннойПоАналогамСтоимостью(СтрокаДляРасчета, ПараметрыОценки, ДатаПереоценки, 2, ПараметрыДенежногоПотока, 5, Ложь, РасшифровкаРасчета);
			
			Если СтрокаДляРасчета.Стоимость <> 0 Тогда
				
				Если ТаблицаСпросовИПредложений = Неопределено Тогда
		
					#Область Получение_таблицы_цен_спроса_и_предложения 
				
					// получим биды и офферы для контроля аналогов
					
					Запрос.Текст = 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
						|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
						|	ТаблицаСпискаЦБ.Рынок КАК Рынок
						|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ1
						|ИЗ
						|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	ИсходнаяТаблицаЦБ1.Рынок КАК Рынок,
						|	ИсходнаяТаблицаЦБ1.ЦеннаяБумага КАК ЦеннаяБумага,
						|	ЕСТЬNULL(КотировкиТорговыхПлощадок.BID, 0) * ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследних.Номинал, 0) / 100 КАК BID,
						|	ЕСТЬNULL(КотировкиТорговыхПлощадок.OFFER, 0) * ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследних.Номинал, 0) / 100 КАК OFFER
						|ИЗ
						|	ИсходнаяТаблицаЦБ1 КАК ИсходнаяТаблицаЦБ1
						|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
						|		ПО ИсходнаяТаблицаЦБ1.Рынок = КотировкиТорговыхПлощадок.Рынок
						|			И ИсходнаяТаблицаЦБ1.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
						|			И (КотировкиТорговыхПлощадок.Период = &ДатаПереоценки)
						|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
						|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
						|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
						|		ПО ИсходнаяТаблицаЦБ1.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
						|ГДЕ
						|	ИсходнаяТаблицаЦБ1.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
						|	И (ЕСТЬNULL(КотировкиТорговыхПлощадок.BID, 0) > 0
						|			ИЛИ ЕСТЬNULL(КотировкиТорговыхПлощадок.OFFER, 0) > 0)";
		
					ТаблицаСпросовИПредложений = Запрос.Выполнить().Выгрузить();
					
					Если РасшифровкаРасчета <> Неопределено Тогда
						РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Таблица спросов и предложений", ТаблицаСпросовИПредложений.Скопировать());
					КонецЕсли;		
					
					#КонецОбласти
					
				КонецЕсли;					
				
				СтрокиСпросовИПредложений = ТаблицаСпросовИПредложений.НайтиСтроки(Новый Структура("ЦеннаяБумага", СтрокаДляРасчета.ЦеннаяБумага));	
				
				Если СтрокиСпросовИПредложений.Количество() > 0 Тогда
					
					Если СтрокаДляРасчета.Стоимость > СтрокиСпросовИПредложений[0].OFFER Тогда
						
						СтрокаДляРасчета.Стоимость = СтрокиСпросовИПредложений[0].OFFER;
						СтрокаДляРасчета.ВидЦены = Перечисления.ИсточникиЦеныдляПереоценки.ЦенаПредложения;
						СтрокаДляРасчета.Источник = БиржаММВБ.ЮрФизЛицо;
						
					ИначеЕсли СтрокаДляРасчета.Стоимость < СтрокиСпросовИПредложений[0].BID Тогда
						
						СтрокаДляРасчета.Стоимость = СтрокиСпросовИПредложений[0].BID;	
						СтрокаДляРасчета.ВидЦены = Перечисления.ИсточникиЦеныдляПереоценки.ЦенаСпроса;
						СтрокаДляРасчета.Источник = БиржаММВБ.ЮрФизЛицо;
						
					КонецЕсли;
					
				КонецЕсли;
				
				Продолжить;

			КонецЕсли;
			
			// Перенесено из ЗаполнитьПереоценкуОПК2018
	
			Если СтрокаДляРасчета.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				
				// Cправедливая стоимость долговых ценных бумаг, определяется как дисконтированная стоимость будущих денежных потоков
				// (кроме случаев, когда основным рынком для долговых ценных бумаг является внебиржевой рынок)
				
				// Если ценная бумага не допущена к торгам на ПАО «Московская биржа»,
				// основным рынком в отношении данной ценной бумаги признается внебиржевой рынок,
				// даже в отсутствие информации об объеме торгов на нем.	
			
				Если СтрокаДляРасчета.ТоргуетсяНаММВБ Тогда

					Если СтрокаДляРасчета.ВалютаНоминала = ВалютаРубли Тогда
						
						ЦенаЗаполнена = ЗаполнитьДисконтированнойПоЗначениямКБДСтоимостью(СтрокаДляРасчета, ДатаПереоценки, ПараметрыОценки, 2, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, , 2, ПараметрыДенежногоПотока, Отказ, РасшифровкаРасчета);
						
						Если ЦенаЗаполнена Тогда
							Продолжить;
						КонецЕсли;
						
					Иначе
						
						// Cправедливая стоимость долговых ценных бумаг, номинированных в долларах США,
						// определяется аналогично долговым ценным бумагам, номинированным в рублях, со следующими изменениями:
						// r(i) – ставка кривой бескупонной доходности казначейских облигаций США, соответствующая дате выплаты i-го денежного потока.
						// Ставка кривой бескупонной доходности казначейских облигаций США определяется
						// с помощью функции «GC I25» информационно-аналитического агентства Bloomberg
						
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
							СтрШаблон("Расчет справедливой стоимости долговой ценной бумаги ""%1"", номинированной в иностранной валюте, не реализован.", СтрокаДляРасчета.ЦеннаяБумага));
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			// Строки, для которых не рассчитали стоимость, удалим из таблицы
			
			МассивСтрокКУдалению.Добавить(СтрокаДляРасчета);

		КонецЦикла;
		
		Для Каждого СтрокаКУдалению Из МассивСтрокКУдалению Цикл
			ТаблицаСтоимостейЦБ.Удалить(СтрокаКУдалению);	
		КонецЦикла;
		
		Если РасшифровкаРасчета <> Неопределено Тогда	
			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "После расчета цен", ТаблицаСтоимостейЦБ.Скопировать());	
		КонецЕсли;

	КонецЕсли;
		
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныСогласия(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, РасшифровкаРасчета = Неопределено) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок,
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ1
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Акции.ОсновнойВыпуск,
		|	Акции.ОсновнойВыпуск.ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок,
		|	Акции.ОсновнойВыпуск.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ
		|ИЗ
		|	Справочник.Акции КАК Акции
		|		ЛЕВОЕ СОЕДИНЕНИЕ ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ПО (ИсходнаяТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка)
		|ГДЕ
		|	Акции.ОсновнойВыпуск <> ЗНАЧЕНИЕ(Справочник.Акции.пустаяСсылка)
		|;
		|"
		
		+"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		 |	ИсходнаяТаблицаЦБ1.ЦеннаяБумага КАК ЦеннаяБумага,
		 |	ИсходнаяТаблицаЦБ1.Рынок КАК Рынок,
		 |	ИсходнаяТаблицаЦБ1.ВалютаНоминала КАК ВалютаНоминала,
		 |	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		 |	ЕСТЬNULL(Облигации.ДатаНачалаОбращения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаОбращения,
		 |	ЕСТЬNULL(Облигации.ДатаНачалаРазмещения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаРазмещения,
		 |	ВЫБОР
		 |		КОГДА ИсходнаяТаблицаЦБ1.УчетныйАктивЦБРФ В (&БумагиНерезидентов)
		 |			ТОГДА ВЫБОР
		 |					КОГДА ИсходнаяТаблицаЦБ1.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		 |						ТОГДА ВЫБОР
		 |								КОГДА ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ1.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		 |										ИЛИ ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ1.ЦеннаяБумага КАК Справочник.Облигации).Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗ)
		 |										ИЛИ ИсходнаяТаблицаЦБ1.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств)
		 |										ИЛИ РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация)
		 |									ТОГДА ИСТИНА
		 |								ИНАЧЕ ЛОЖЬ
		 |							КОНЕЦ
		 |					ИНАЧЕ ЛОЖЬ
		 |				КОНЕЦ
		 |		КОГДА ИсходнаяТаблицаЦБ1.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		 |			ТОГДА ВЫБОР
		 |					КОГДА ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ1.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		 |							ИЛИ ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ1.ЦеннаяБумага КАК Справочник.Облигации).Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗ)
		 |						ТОГДА ИСТИНА
		 |					ИНАЧЕ ЛОЖЬ
		 |				КОНЕЦ
