	ПоследняяДатаТорговБлумберга	= РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки, Блумберг);	
		
	РабочихДнейНазад10				= Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -10);
	ПоследняяДатаТоргов				= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки));
	
	ИностранныеУчетныеАктивы		= Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();
	
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберга", ПоследняяДатаТорговБлумберга);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов", ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("НРД", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("ММВБ", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	
	Запрос.УстановитьПараметр("Блумберг", Блумберг);
	
	Запрос.УстановитьПараметр("Режим_BGN"	, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL"	, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	
	Запрос.УстановитьПараметр("Организация", ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("Рубли", ПараметрыОценки.Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыОценки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("РабочихДнейНазад10", РабочихДнейНазад10);
	Запрос.УстановитьПараметр("БумагиНерезидентов", ИностранныеУчетныеАктивы);
	Запрос.УстановитьПараметр("ОВОЗ", Перечисления.ВидыГосударственныхОблигаций.ОВОЗ);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Ливанова (ЕПС)", "Таблица стоимостей ЦБ");		
	Иначе
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	ТаблицаСтоимостейЦБ.Колонки.Добавить("Источник", Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	
	ПараметрыРасчетаРейтинга = ПолучитьПараметрыРасчетаРейтингаПоУмолчанию(ПараметрыОценки.СчетДоверительногоУправления, ДатаПереоценки);
	ПараметрыРасчетаРейтинга.Вставить("ИсточникТаблицыСоответствияРейтингов", Справочники.ВнешниеСистемы.НПФ_ОПФ);

	ПараметрыРасчетаКредитногоСпреда = Новый Структура;
	ПараметрыРасчетаКредитногоСпреда.Вставить("ОтклонениеКредитногоСпреда", 50); //параметр УП, может меняться со временем. При изменении также поменять переменную в процедуре ЗаполнитьПереоценкуАтомфонда			
	
	РынокОблигации = Перечисления.РынкиЦенныхБумаг.Облигации;
	Для Каждого СтрокаСтоимости Из ТаблицаСтоимостейЦБ Цикл
		ЦеннаяБумага = СтрокаСтоимости.ЦеннаяБумага;
		Рынок = СтрокаСтоимости.Рынок;
		
		Если Рынок = РынокОблигации Тогда
			НоминалНаДату				= Справочники.Облигации.ПолучитьНоминал(ЦеннаяБумага, ДатаПереоценки);
			Купон						= Справочники.Облигации.ПолучитьКупон(ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
			РейтинговаяГруппа			= Неопределено;
			КредитныйСпред				= Неопределено;
			БезрисковаяСтавкаДоходности	= Неопределено;
			
			ПараметрыДенежногоПотока = Новый Структура;
			ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",		Ложь);
			ПараметрыДенежногоПотока.Вставить("Дата",					ДатаПереоценки);
			ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",			ДатаПереоценки);
			
			ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ПараметрыДенежногоПотока, ПараметрыОценки, Отказ, РасшифровкаРасчета);
		Иначе
			НоминалНаДату = 100;
		КонецЕсли;
		
		Если СтрокаСтоимости.СправедливаяЦена>0 Тогда
			Если СтрокаСтоимости.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.РыночнаяЦена2 Тогда
				СтрокаСтоимости.УровеньОценки = 1;//ок
				СтрокаСтоимости.Источник = СтрокаСтоимости.БиржаЮрФизЛицо;
				СтрокаСтоимости.Стоимость = СтрокаСтоимости.СправедливаяЦена * НоминалНаДату /100;
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Если СтрокаСтоимости.СправедливаяЦена > 0 Тогда
			ПроверкаНаАдекватность = ПроверитьЦенуНаАдекватность(ЦеннаяБумага, СтрокаСтоимости.СправедливаяЦена * НоминалНаДату /100, ДатаПереоценки, ПараметрыОценки, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, , Купон, РейтинговаяГруппа, КредитныйСпред, ДенежныйПоток, БезрисковаяСтавкаДоходности, Отказ, РасшифровкаРасчета); 
			Если ПроверкаНаАдекватность Тогда
				СтрокаСтоимости.УровеньОценки = 1;//ок
				СтрокаСтоимости.Источник = СтрокаСтоимости.БиржаЮрФизЛицо;
				СтрокаСтоимости.Стоимость = СтрокаСтоимости.СправедливаяЦена * НоминалНаДату /100;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		//рынок признается неактивным
		
		Если СтрокаСтоимости.ЦБРФ Тогда
			//2.а - только для долговых
			Если Рынок = РынокОблигации И СтрокаСтоимости.MARKETPRICE2 > 0 Тогда
				ПроверкаНаАдекватность = ПроверитьЦенуНаАдекватность(ЦеннаяБумага, СтрокаСтоимости.MARKETPRICE2 * НоминалНаДату /100, ДатаПереоценки, ПараметрыОценки, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, , Купон, РейтинговаяГруппа, КредитныйСпред, ДенежныйПоток, БезрисковаяСтавкаДоходности, Отказ, РасшифровкаРасчета); 
				Если ПроверкаНаАдекватность Тогда
					СтрокаСтоимости.УровеньОценки = 1;//ок
					СтрокаСтоимости.Источник = СтрокаСтоимости.БиржаЮрФизЛицо;
					СтрокаСтоимости.Стоимость = СтрокаСтоимости.MARKETPRICE2 * НоминалНаДату /100;
					СтрокаСтоимости.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.РыночнаяЦена2;
					СтрокаСтоимости.ДатаЦены = СтрокаСтоимости.MARKETPRICE2_DATE;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			//2.в
			Если СтрокаСтоимости.ЦенаНРД > 0 Тогда
				//проверка адекватности только для долговых
				Если Рынок = РынокОблигации Тогда
					ПроверкаНаАдекватность = ПроверитьЦенуНаАдекватность(ЦеннаяБумага, СтрокаСтоимости.ЦенаНРД, ДатаПереоценки, ПараметрыОценки, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, , Купон, РейтинговаяГруппа, КредитныйСпред, ДенежныйПоток, БезрисковаяСтавкаДоходности, Отказ, РасшифровкаРасчета); 
				Иначе
					ПроверкаНаАдекватность = Истина;
				КонецЕсли;
				Если ПроверкаНаАдекватность Тогда
					СтрокаСтоимости.УровеньОценки = 2;//ок
					СтрокаСтоимости.Источник = ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");
					СтрокаСтоимости.Стоимость = СтрокаСтоимости.ЦенаНРД;
					СтрокаСтоимости.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД;
					СтрокаСтоимости.ДатаЦены = СтрокаСтоимости.ДатаЦеныНРД;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		Иначе
			//по умолчанию проверка на адекватность котировок Блумберг не осуществляется, если это отдельно не заявлено Фондом. Пока не заявлено
			Если СтрокаСтоимости.BGN > 0 ИЛИ СтрокаСтоимости.BVAL > 0 Тогда
				СтрокаСтоимости.УровеньОценки = 2;
				СтрокаСтоимости.Источник = ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
				СтрокаСтоимости.Стоимость = ?(СтрокаСтоимости.BGN > 0, СтрокаСтоимости.BGN, СтрокаСтоимости.BVAL);
				СтрокаСтоимости.ВидЦены = ?(СтрокаСтоимости.BGN > 0, Перечисления.ИсточникиЦеныДляПереоценки.СредняяЦенаЗакрытия, Перечисления.ИсточникиЦеныДляПереоценки.СредневзвешеннаяЦена);
				СтрокаСтоимости.ДатаЦены = СтрокаСтоимости.ДатаЦеныБлумберга;
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		//вынесено в процедуру ЗаполнитьПереоценкуАтомфонда, т.к. зависит от даты покупки 
		////2.с - только для долговых российских бумаг. Для иностранных ЦБ пропускается. 
		////3.а
		////3.с (как 2.с, но по кредитному спреду бумаги, а не эмитента)
		
		СтрокаСтоимости.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.ПустаяСсылка();
		СтрокаСтоимости.ДатаЦены = 0;
		
	КонецЦикла;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "После проверки цены на адекватность", ТаблицаСтоимостейЦБ.Скопировать());		
	КонецЕсли;	
	
	Возврат ТаблицаСтоимостейЦБ;
КонецФункции

Функция ПолучитьЦеныЛиванова2018(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	ИсходнаяТаблицаЦБ.Рынок,
		   |	ВЫБОР
		   |		КОГДА ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ)
		   |			ТОГДА ИСТИНА
		   |		КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств)
		   |			ТОГДА ИСТИНА
		   |		КОГДА ИсходнаяТаблицаЦБ.ЦеннаяБумага.УчетныйАктивЦБРФ В (&ИностранныеУчетныеАктивы)
		   |				И ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		   |			ТОГДА ИСТИНА
		   |		КОГДА РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма ЕСТЬ NULL
		   |			ТОГДА ЛОЖЬ
		   |		КОГДА РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация)
		   |			ТОГДА ИСТИНА
		   |		ИНАЧЕ ЛОЖЬ
		   |	КОНЕЦ КАК ВнебиржевойРынок,
			|	НоминалыЦенныхБумагСрезПоследних.Номинал,
			|	ЕСТЬNULL(Облигации.ДатаНачалаОбращения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаОбращения,
			|	ЕСТЬNULL(Облигации.ДатаНачалаРазмещения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаРазмещения
			|ПОМЕСТИТЬ ТаблицаЦБ
			|ИЗ
			|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
			|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
			|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&ДатаПереоценки, Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний) И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		   |		ПО (ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|;
		|"+"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		   |	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		   |	ТаблицаЦБ.Номинал КАК Номинал,
		   |	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		   |	ТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		   |	ТаблицаЦБ.Рынок КАК Рынок
		   |ПОМЕСТИТЬ АктивныйРынокММВБ10Дней
		   |ИЗ
		   |	ТаблицаЦБ КАК ТаблицаЦБ
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		   |		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадок.Рынок
		   |			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
		   |			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		   |			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		   |		ПО (КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта)
		   |			И (КурсыВалют.Период = &ДатаПереоценки)
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадокПоследнийРабочийДень
		   |		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадокПоследнийРабочийДень.Рынок
		   |			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокПоследнийРабочийДень.ЦеннаяБумага
		   |			И (КотировкиТорговыхПлощадокПоследнийРабочийДень.Биржа = &ММВБ)
		   |			И (КотировкиТорговыхПлощадокПоследнийРабочийДень.РежимТоргов.ОсновнойРежим)
		   |			И (КотировкиТорговыхПлощадокПоследнийРабочийДень.Период = &ПоследняяДатаТоргов)
		   |ГДЕ
		   |	КотировкиТорговыхПлощадок.Период >= &ТорговыхДнейНазад10
		   |	И КотировкиТорговыхПлощадок.Период <= &ДатаПереоценки
		   |	И КотировкиТорговыхПлощадок.Биржа = &ММВБ
		   |	И (ЕСТЬNULL(КотировкиТорговыхПлощадокПоследнийРабочийДень.BID, 0) > 0
		   |			ИЛИ ЕСТЬNULL(КотировкиТорговыхПлощадокПоследнийРабочийДень.WAPRICE, 0) > 0)
		   |
		   |СГРУППИРОВАТЬ ПО
