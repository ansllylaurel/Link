		КорректировкиРегистра = ДополнительныеСвойства.КорректировкиРегистра.НайтиСтроки(Новый Структура("Партия, СтрокаПартии", СтрокаЦенныеБумаги.Партия, СтрокаЦенныеБумаги.СтрокаПартии));
		
