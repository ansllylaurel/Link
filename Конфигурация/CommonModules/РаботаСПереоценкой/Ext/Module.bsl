//	ИмяВременнойТаблицы		- Строка							- имя таблицы, под которым она будет создана в менеджере
//
Процедура ПоместитьДюрацииОблигацийВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, Период, ЦенныеБумаги, ИмяВременнойТаблицы = "_ДюрацииОблигаций")
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СистемныеФункции.МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц);
	
	// Помещаем во временную таблицу
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫРАЗИТЬ(МАКСИМУМ(КотировкиТорговыхПлощадок.DURATION) / 365 - 0.5 КАК ЧИСЛО(3, 0)) КАК Значение
		|ПОМЕСТИТЬ #ДюрацииОблигаций#
		|ИЗ
		|	#ЦенныеБумаги# КАК _ЦенныеБумаги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.ЦеннаяБумага = _ЦенныеБумаги.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Рынок = _ЦенныеБумаги.Рынок)
		|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадок.Период = &ПоследняяДатаТоргов)
		|ГДЕ
		|	_ЦенныеБумаги.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЦенныеБумаги.ЦеннаяБумага
		|
		|ИМЕЮЩИЕ
		|	МАКСИМУМ(КотировкиТорговыхПлощадок.DURATION) > 0";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ДюрацииОблигаций#",	ИмяВременнойТаблицы); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ЦенныеБумаги#",		ЦенныеБумаги);
	
	КалендарьКотировок	= Константы.ОсновнойКалендарьКотировок.Получить();
	ПоследняяДатаТоргов	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьКотировок, НачалоДня(Период));
	
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов", ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("ММВБ",				 ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
		
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ПоместитьСведенияОТоргахЦеннымиБумагамиВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, ЦенныеБумаги, Период, ГлубинаТорговыхДней, ИмяВременнойТаблицы = "_СведенияОТоргахЦеннымиБумагами", ПолеЦеннойБумаги = "ЦеннаяБумага") Экспорт
	
	// Календарь беру глубиной год (~240 торговых дней вполне достаточно),
	// значит записей будет максимум 366 дней * количество бумаг
	
	Если ГлубинаТорговыхДней >= 240 Тогда
		ВызватьИсключение "Превышена максимально допустимая глубина торговых дней";
	КонецЕсли;
	
	// Определяем источник временных таблиц		
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СистемныеФункции.МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц);
	
	// Сведения о торгах ценными бумагами:
	// 07.01.2022 - 07.01.2022: фьючерсы
	// 28.02.2022 - 20.03.2022: фьючерсы
	// 21.03.2022 - 23.03.2022: фьючерсы, ОФЗ
	// 24.03.2022 - 25.03.2022: фьючерсы, ОФЗ, 33 акции
	// 28.03.2022 - 28.03.2022: фьючерсы, ОФЗ, российские корпоративные/региональные/муниципальные облигации, российские акции
	// 29.03.2022 - 29.03.2022: фьючерсы, облигации (за исключением еврооблигаций), российские акции, иностранные акции из индекса мосбиржи, паи
	// 30.03.2022 - 13.07.2022: фьючерсы, облигации (за исключением еврооблигаций), российские акции, иностранные акции из списка, паи
	// 14.07.2022 - 31.12.2022: фьючерсы, облигации (из еврооблигаций только МинФин), российские акции, иностранные акции из списка, паи
	// 01.01.2023 -           : все в соответствии с общим календарем торгов
	
	#Область Текст_запроса
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТИП(Справочник.ПроизводныеФинансовыеИнструменты) КАК ТипБумаги,
		|	NULL КАК Ссылка,
		|	NULL КАК Иностранная,
		|	NULL КАК Категория,
		|	NULL КАК Подкатегория,
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _ДниТорговИнструментами
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &ОсновнойКалендарьКотировок
		|	И (ДанныеКалендаря.Дата = ДАТАВРЕМЯ(2022, 1, 7)
		|			ИЛИ ДанныеКалендаря.Дата МЕЖДУ ДАТАВРЕМЯ(2022, 2, 28) И ДАТАВРЕМЯ(2022, 3, 4)
		|			ИЛИ ДанныеКалендаря.Дата МЕЖДУ ДАТАВРЕМЯ(2022, 3, 9) И ДАТАВРЕМЯ(2022, 3, 11)
		|			ИЛИ ДанныеКалендаря.Дата МЕЖДУ ДАТАВРЕМЯ(2022, 3, 14) И ДАТАВРЕМЯ(2022, 3, 18)
		|			ИЛИ ДанныеКалендаря.Дата МЕЖДУ ДАТАВРЕМЯ(2022, 3, 21) И ДАТАВРЕМЯ(2022, 3, 25)
		|			ИЛИ ДанныеКалендаря.Дата МЕЖДУ ДАТАВРЕМЯ(2022, 3, 28) И ДАТАВРЕМЯ(2022, 12, 31)
		|				И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)))
		|	И &ПереопределениеВключено
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТИП(Справочник.Облигации),
		|	NULL,
		|	NULL,
		|	ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная),
		|	ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОФЗ),
		|	ДанныеКалендаря.Дата
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &ОсновнойКалендарьКотировок
		|	И (ДанныеКалендаря.Дата МЕЖДУ ДАТАВРЕМЯ(2022, 3, 21) И ДАТАВРЕМЯ(2022, 3, 25)
		|			ИЛИ ДанныеКалендаря.Дата = ДАТАВРЕМЯ(2022, 3, 28))
		|	И &ПереопределениеВключено
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТИП(Справочник.Облигации),
		|	NULL,
		|	ЛОЖЬ,
		|	КорпоративныеРегиональныеМуниципальные.Категория,
		|	NULL,
		|	ДанныеКалендаря.Дата
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря,
		|	(ВЫБРАТЬ
		|		ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная) КАК Категория
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Муниципальная)) КАК КорпоративныеРегиональныеМуниципальные
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &ОсновнойКалендарьКотировок
		|	И ДанныеКалендаря.Дата = ДАТАВРЕМЯ(2022, 3, 28)
		|	И &ПереопределениеВключено
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТИП(Справочник.Облигации),
		|	NULL,
		|	NULL,
		|	КатегорииИсключаяЕврооблигации.Категория,
		|	ВЫБОР
		|		КОГДА КатегорииИсключаяЕврооблигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОФЗ)
		|	КОНЕЦ,
		|	ДанныеКалендаря.Дата
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря,
		|	(ВЫБРАТЬ
		|		КатегорииОблигаций.Ссылка КАК Категория
		|	ИЗ
		|		Перечисление.КатегорииОблигаций КАК КатегорииОблигаций
		|	ГДЕ
		|		КатегорииОблигаций.Ссылка <> ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)) КАК КатегорииИсключаяЕврооблигации
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &ОсновнойКалендарьКотировок
		|	И ДанныеКалендаря.Дата МЕЖДУ ДАТАВРЕМЯ(2022, 3, 29) И ДАТАВРЕМЯ(2022, 12, 31)
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|	И &ПереопределениеВключено
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТИП(Справочник.Облигации),
		|	NULL,
		|	NULL,
		|	ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная),
		|	ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ),
		|	ДанныеКалендаря.Дата
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &ОсновнойКалендарьКотировок
		|	И ДанныеКалендаря.Дата МЕЖДУ ДАТАВРЕМЯ(2022, 7, 14) И ДАТАВРЕМЯ(2022, 12, 31)
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|	И &ПереопределениеВключено
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТИП(Справочник.Акции),
		|	КодыММВБ.Объект,
		|	NULL,
		|	NULL,
		|	NULL,
		|	ДанныеКалендаря.Дата
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах КАК КодыММВБ
		|		ПО (КодыММВБ.ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ))
		|			И (КодыММВБ.Код В (""AFLT"", ""ALRS"", ""CBOM"", ""CHMF"", ""DSKY"", ""ENPG"", ""FEES"", ""GAZP"", ""GMKN"", ""HYDR"", ""IRAO"", ""LKOH"", ""MAGN"", ""MGNT"", ""MOEX"", ""MTSS"", ""NLMK"", ""NVTK"", ""PHOR"", ""PIKK"", ""PLZL"", ""ROSN"", ""RTKM"", ""RUAL"", ""SBER"", ""SBERP"", ""SNGS"", ""SNGSP"", ""TATN"", ""TATNP"", ""TRNFP"", ""VTBR"", ""AFKS""))
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &ОсновнойКалендарьКотировок
		|	И ДанныеКалендаря.Дата МЕЖДУ ДАТАВРЕМЯ(2022, 3, 24) И ДАТАВРЕМЯ(2022, 3, 25)
		|	И &ПереопределениеВключено
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТИП(Справочник.Акции),
		|	NULL,
		|	ЛОЖЬ,
		|	NULL,
		|	NULL,
		|	ДанныеКалендаря.Дата
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &ОсновнойКалендарьКотировок
		|	И ДанныеКалендаря.Дата МЕЖДУ ДАТАВРЕМЯ(2022, 3, 28) И ДАТАВРЕМЯ(2022, 12, 31)
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|	И &ПереопределениеВключено
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТИП(Справочник.Акции),
		|	КодыММВБ.Объект,
		|	ИСТИНА,
		|	NULL,
		|	NULL,
		|	ДанныеКалендаря.Дата
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах КАК КодыММВБ
		|		ПО (КодыММВБ.ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ))
		|			И (КодыММВБ.Код В (""FIVE"", ""FIXP"", ""GLTR"", ""HHRU"", ""OZON"", ""POGR"", ""POLY"", ""TCSG"", ""VKCO"", ""YNDX""))
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &ОсновнойКалендарьКотировок
		|	И ДанныеКалендаря.Дата = ДАТАВРЕМЯ(2022, 3, 29)
		|	И &ПереопределениеВключено
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТИП(Справочник.Акции),
		|	КодыММВБ.Объект,
		|	ИСТИНА,
		|	NULL,
		|	NULL,
		|	ДанныеКалендаря.Дата
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах КАК КодыММВБ
		|		ПО (КодыММВБ.ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ))
		|			И (КодыММВБ.Код В (""AGRO"", ""CIAN"", ""EM44"", ""ETLN"", ""FIVE"", ""FIXP"", ""GEMC"", ""GLTR"", ""HHRU"", ""HMSG"", ""LNTA"", ""MDMG"", ""OKEY"", ""OZON"", ""POGR"", ""POLY"", ""QIWI"", ""SFTL"", ""TCSG"", ""VKCO"", ""YNDX"", ""VEON-RX""))
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &ОсновнойКалендарьКотировок
		|	И ДанныеКалендаря.Дата МЕЖДУ ДАТАВРЕМЯ(2022, 3, 30) И ДАТАВРЕМЯ(2022, 12, 31)
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|	И &ПереопределениеВключено
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТИП(Справочник.Паи),
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	ДанныеКалендаря.Дата
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &ОсновнойКалендарьКотировок
		|	И ДанныеКалендаря.Дата МЕЖДУ ДАТАВРЕМЯ(2022, 3, 29) И ДАТАВРЕМЯ(2022, 12, 31)
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|	И &ПереопределениеВключено
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДниТорговИнструментами.Дата КАК Дата
		|ПОМЕСТИТЬ _ПереопределяемыеДни
		|ИЗ
		|	_ДниТорговИнструментами КАК _ДниТорговИнструментами
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1000000
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ДанныеКалендаря.Дата КАК Дата,
		|	НЕ _ПереопределяемыеДни.Дата ЕСТЬ NULL КАК ПереопределяемыейДень,
		|	_ДниТорговИнструментами.ТипБумаги КАК ТипБумаги,
		|	_ДниТорговИнструментами.Подкатегория КАК Подкатегория,
		|	АВТОНОМЕРЗАПИСИ() КАК НомерЗаписи
		|ПОМЕСТИТЬ _ДанныеКалендаря
		|ИЗ
		|	#ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО _ТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ПО (ДанныеКалендаря.Календарь = &ОсновнойКалендарьКотировок)
		|			И (ДанныеКалендаря.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(&Период, ГОД, -1) И &Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДниТорговИнструментами КАК _ДниТорговИнструментами
		|		ПО (_ДниТорговИнструментами.Дата = ДанныеКалендаря.Дата)
		|			И (ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.ЦеннаяБумага) = _ДниТорговИнструментами.ТипБумаги)
		|			И (_ДниТорговИнструментами.Ссылка ЕСТЬ NULL
		|				ИЛИ _ДниТорговИнструментами.Ссылка = _ТаблицаЦБ.ЦеннаяБумага)
		|			И (_ДниТорговИнструментами.Иностранная ЕСТЬ NULL
		|				ИЛИ _ДниТорговИнструментами.Иностранная = (ЕСТЬNULL(Облигации.УчетныйАктивЦБРФ, Акции.УчетныйАктивЦБРФ) В (&ИностранныеУчетныеАктивы)))
		|			И (_ДниТорговИнструментами.Категория ЕСТЬ NULL
		|				ИЛИ _ДниТорговИнструментами.Категория = Облигации.Категория)
		|			И (_ДниТорговИнструментами.Подкатегория ЕСТЬ NULL
		|				ИЛИ _ДниТорговИнструментами.Подкатегория = Облигации.Подкатегория)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПереопределяемыеДни КАК _ПереопределяемыеДни
		|		ПО (_ПереопределяемыеДни.Дата = ДанныеКалендаря.Дата)
		|ГДЕ
		|	(НЕ _ДниТорговИнструментами.Дата ЕСТЬ NULL
		|			ИЛИ _ПереопределяемыеДни.Дата ЕСТЬ NULL
		|				И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)))
		|
		|УПОРЯДОЧИТЬ ПО
		|	_ТаблицаЦБ.ЦеннаяБумага,
		|	ДанныеКалендаря.Дата УБЫВ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЦеннаяБумага,
		|	НомерЗаписи
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеКалендаря.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ДанныеКалендаря.Дата КАК Дата,
		|	_ДанныеКалендаря.НомерЗаписи - НачальныеЗаписиПоБумагам.НомерЗаписи + 1 КАК ТорговыхДнейНазад
		|ПОМЕСТИТЬ #СведенияОТоргахЦеннымиБумагами
		|ИЗ
		|	_ДанныеКалендаря КАК _ДанныеКалендаря
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_ДанныеКалендаря.ЦеннаяБумага КАК ЦеннаяБумага,
		|			МИНИМУМ(_ДанныеКалендаря.НомерЗаписи) КАК НомерЗаписи
		|		ИЗ
		|			_ДанныеКалендаря КАК _ДанныеКалендаря
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_ДанныеКалендаря.ЦеннаяБумага) КАК НачальныеЗаписиПоБумагам
		|		ПО _ДанныеКалендаря.ЦеннаяБумага = НачальныеЗаписиПоБумагам.ЦеннаяБумага
		|			И (_ДанныеКалендаря.НомерЗаписи < НачальныеЗаписиПоБумагам.НомерЗаписи + &ГлубинаТорговыхДней)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЦеннаяБумага,
		|	ТорговыхДнейНазад
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ДниТорговИнструментами
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ПереопределяемыеДни
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ДанныеКалендаря";
	
	#КонецОбласти
	
	Если ТипЗнч(ЦенныеБумаги) = Тип("Строка") Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ТаблицаЦБ", СтрШаблон("(ВЫБРАТЬ РАЗЛИЧНЫЕ %1 КАК ЦеннаяБумага ИЗ %2)", ПолеЦеннойБумаги, ЦенныеБумаги));
		
		КоличествоБумаг = СистемныеФункции.КоличествоЗаписейВременнойТаблицы(Запрос, ЦенныеБумаги); 
		
	Иначе
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ТаблицаЦБ", "(ВЫБРАТЬ &ЦенныеБумаги КАК ЦеннаяБумага)");
		
		КоличествоБумаг = 1;
		
	КонецЕсли;	
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1000000", "ПЕРВЫЕ " + Формат(366 * КоличествоБумаг, "ЧН=; ЧГ="));
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ #СведенияОТоргахЦеннымиБумагами", "ПОМЕСТИТЬ " + ИмяВременнойТаблицы); 
	
	Запрос.УстановитьПараметр("ОсновнойКалендарьКотировок",	Константы.ОсновнойКалендарьКотировок.Получить());
	Запрос.УстановитьПараметр("ИностранныеУчетныеАктивы",	Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы());
	Запрос.УстановитьПараметр("Период",						Период);
	Запрос.УстановитьПараметр("ЦенныеБумаги",				ЦенныеБумаги);
	Запрос.УстановитьПараметр("ГлубинаТорговыхДней",		ГлубинаТорговыхДней);
	Запрос.УстановитьПараметр("ПереопределениеВключено",	Период < '20230101');
	
	Запрос.Выполнить();	
	
КонецПроцедуры

// Помещает оценки по номиналу для погашенных ценных бумаг в менеджер временных таблиц
//
// Параметры:
//  ИсточникВременныхТаблиц			- Запрос, МенеджерВременныхТаблиц - источник временных таблиц
//  Организация						- СправочникСсылка.Организации - 
//  СчетДоверительногоУправления	- СправочникСсылка.СчетаДоверительногоУправления - 
//  ДатаПереоценки					- Дата - 
//
Процедура ПоместитьОценкиПоНоминалуДляПогашенныхЦенныхБумагВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, Организация, СчетДоверительногоУправления, ДатаПереоценки)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СистемныеФункции.МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц);
	
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	
	Запрос.Текст = 		
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиЦенныхБумагЗаблокированныеОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОстаткиЦенныхБумагЗаблокированныеОстатки.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК СправедливаяЦена,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.Номинал) КАК ПолеЦены,
		|	0 КАК Купон,
		|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК ВалютаКупона,
		|	ВЫРАЗИТЬ(ОстаткиЦенныхБумагЗаблокированныеОстатки.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо КАК ИсточникКотировок,
		|	ВЫРАЗИТЬ(ОстаткиЦенныхБумагЗаблокированныеОстатки.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала КАК ВалютаКотировки,
		|	НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).Дата, ДЕНЬ) КАК ДатаЦены
		|ПОМЕСТИТЬ _ЦБПоНоминальнойСтоимостиПослеПогашения
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумагЗаблокированные.Остатки(
		|			КОНЕЦПЕРИОДА(&ДатаПереоценки, ДЕНЬ),
		|			ВидБлокировкиАктива = ЗНАЧЕНИЕ(Перечисление.ВидыБлокировокАктивов.Погашение)
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхбумаг.Облигации)) КАК ОстаткиЦенныхБумагЗаблокированныеОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|				&ДатаПереоценки,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации)
		|					И НЕ Аванс) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|		ПО (ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага = ОстаткиЦенныхБумагЗаблокированныеОстатки.ЦеннаяБумага
		|				И НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).Дата, ДЕНЬ) <= &ДатаПереоценки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ОстаткиЦенныхБумагЗаблокированныеОстатки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЦеннаяБумага";
		
	Запрос.Выполнить();  	
	
КонецПроцедуры

// Помещает бумаги, оцениваемые только по амортизированной стоимости, в менеджер временных таблиц
//
// Параметры:
//  ИсточникВременныхТаблиц	- Запрос, МенеджерВременныхТаблиц - источник временных таблиц
//  ПараметрыОценки			- Структура - см. РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС
//  ДатаПереоценки			- Дата - 
//  ЦенныеБумаги			- Строка - имя временной таблицы с бумагами, состав см. в ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц
//							- ТаблицаЗначений - таблица с бумагами, должна содержать колонки Рынок и ЦеннаяБумага 
//  ИмяВременнойТаблицы		- Строка -
//
Процедура ПоместитьБумагиОцениваемыеПоАмортизированнойСтоимостиВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, ПараметрыОценки, ДатаПереоценки, ЦенныеБумаги, ИмяВременнойТаблицы = "_БумагиОцениваемыеПоАмортизированнойСтоимости")
	
	// Определяем источник временных таблиц		
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СистемныеФункции.МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц);
	
	// 1. Если в параметрах пришли сведения о партиях ценных бумаг, то берем учетный актив ЕПС из них.
	//    Если в таблице партий нет сведений об учетных активах, значит это расчет без партий (считаются прочие ценные бумаги или по новой схеме расчета),
	//    следовательно рассчитывать АС не требуется.
	// 2. В противном случае берем партии из регистра. Сюда должен попасть расчет стоимости бумаг для бухгалтерии (ЕПС, БУ, НУ). 
	
	ТребуетсяРасчетАмортизированнойСтоимости =
		Не (ПараметрыОценки.Свойство("ОцениватьПоСправедливойСтоимости") И ПараметрыОценки.ОцениватьПоСправедливойСтоимости)
		И Не (ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены)
		И ИспользуетсяОценкаПоАмортизированнойСтоимости(ПараметрыОценки.ВариантРасчетаСправедливойСтоимости, ДатаПереоценки);
	
	Если ТребуетсяРасчетАмортизированнойСтоимости Тогда
		
		Если ПараметрыОценки.Свойство("ТаблицаПартийЦБ") Тогда
			
			Если ПараметрыОценки.ТаблицаПартийЦБ.Колонки.Найти("УчетныйАктивЕПС") = Неопределено Тогда
				
				ТребуетсяРасчетАмортизированнойСтоимости = Ложь;
				
			Иначе
				
				#Область Запрос_из_таблицы_партий
				
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
					|	_ТаблицаПартийЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
					|	_ТаблицаПартийЦБ.УчетныйАктивЕПС В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПСД), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения)) КАК ОценкаПоАмортизированнойСтоимости
					|ПОМЕСТИТЬ _ВариантыОценкиБумаг
					|ИЗ
					|	&ТаблицаПартийЦБ КАК _ТаблицаПартийЦБ
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_ВариантыОценкиБумаг.ЦеннаяБумага КАК ЦеннаяБумага
					|ПОМЕСТИТЬ #БумагиОцениваемыеПоАмортизированнойСтоимости
					|ИЗ
					|	_ВариантыОценкиБумаг КАК _ВариантыОценкиБумаг
					|ГДЕ
					|	_ВариантыОценкиБумаг.ЦеннаяБумага В(&ЦенныеБумаги)
					|
					|СГРУППИРОВАТЬ ПО
					|	_ВариантыОценкиБумаг.ЦеннаяБумага
					|
					|ИМЕЮЩИЕ
					|	МИНИМУМ(_ВариантыОценкиБумаг.ОценкаПоАмортизированнойСтоимости) = ИСТИНА
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|УНИЧТОЖИТЬ _ВариантыОценкиБумаг";
				
				Запрос.УстановитьПараметр("ТаблицаПартийЦБ", ПараметрыОценки.ТаблицаПартийЦБ);
				
				#КонецОбласти
				
			КонецЕсли;
			
		Иначе
			
			#Область Запрос_из_регистра_партий
			
			// #406740 если бумага есть еще по РЕПО от однозначно относить её к АС нельзя - но РЕПО нужна будет СС
			// т.к. возник перецедент: купили по РЕПО (оценим по СС) 
			// и в тот же день купили обычной сделкой и классифицировали по АС (оценивать не надо)
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ВариантыОценкиБумаг.ЦеннаяБумага КАК ЦеннаяБумага
				|ПОМЕСТИТЬ #БумагиОцениваемыеПоАмортизированнойСтоимости
				|ИЗ
				|	(ВЫБРАТЬ
				|		БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
				|		БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПСД), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения)) КАК ОценкаПоАмортизированнойСтоимости
				|	ИЗ
				|		РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
				|				&КонецДняПереоценкиГраницаВключая,
				|				Организация = &Организация
				|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|					И ВидУчета = &ВидУчета
				|					И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
				|					И ЦеннаяБумага В (&ЦенныеБумаги)) КАК БухПартииЦенныхБумагОстатки
				|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО.Остатки(
				|					&КонецДняПереоценкиГраницаВключая,
				|					Организация = &Организация
				|						И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|						И ВидУчета = &ВидУчета
				|						И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
				|						И ЦеннаяБумага В (&ЦенныеБумаги)) КАК БухПартииЦенныхБумагКупленныеПоРЕПООстатки
				|			ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ЦеннаяБумага
				|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумагКПолучению.Остатки(
				|					&КонецДняПереоценкиГраницаВключая,
				|					Организация = &Организация
				|						И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|						И ВидУчета = &ВидУчета
				|						И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
				|						И ЦеннаяБумага В (&ЦенныеБумаги)) КАК БухПартииЦенныхБумагКПолучениюОстатки
				|			ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = БухПартииЦенныхБумагКПолучениюОстатки.ЦеннаяБумага
				|	ГДЕ
				|		БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ЦеннаяБумага ЕСТЬ NULL
				|		И БухПартииЦенныхБумагКПолучениюОстатки.ЦеннаяБумага ЕСТЬ NULL) КАК ВариантыОценкиБумаг
				|
				|СГРУППИРОВАТЬ ПО
				|	ВариантыОценкиБумаг.ЦеннаяБумага
				|
				|ИМЕЮЩИЕ
				|	МИНИМУМ(ВариантыОценкиБумаг.ОценкаПоАмортизированнойСтоимости) = ИСТИНА";
			
			Запрос.УстановитьПараметр("Организация",						ПараметрыОценки.Организация);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления",		ПараметрыОценки.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("ВидУчета",							ПараметрыОценки.ВидУчета);
			Запрос.УстановитьПараметр("КонецДняПереоценкиГраницаВключая",	Новый Граница(КонецДня(ДатаПереоценки), ВидГраницы.Включая));
				
			#КонецОбласти

		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ТребуетсяРасчетАмортизированнойСтоимости Тогда
	
		#Область Запрос_заглушка
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 0
			|	ЗНАЧЕНИЕ(Справочник.Облигации.ПустаяСсылка) КАК ЦеннаяБумага
			|ПОМЕСТИТЬ #БумагиОцениваемыеПоАмортизированнойСтоимости";
		
		#КонецОбласти
		
	Иначе
		
		Если ТипЗнч(ЦенныеБумаги) = Тип("Строка") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЦенныеБумаги", СтрЗаменить("ВЫБРАТЬ _ИсходнаяТаблицаЦБ.ЦеннаяБумага ИЗ _ИсходнаяТаблицаЦБ", "_ИсходнаяТаблицаЦБ", ЦенныеБумаги));
		ИначеЕсли ТипЗнч(ЦенныеБумаги) = Тип("ТаблицаЗначений") Тогда
			Запрос.УстановитьПараметр("ЦенныеБумаги", ЦенныеБумаги.Скопировать(Новый Структура("Рынок", Перечисления.РынкиЦенныхБумаг.Облигации), "ЦеннаяБумага").ВыгрузитьКолонку(0));
		Иначе
			ВызватьИсключение СтрШаблон("Некорректный тип параметра 'ЦенныеБумаги': '%1'", ТипЗнч(ЦенныеБумаги));
		КонецЕсли;	
		
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ #БумагиОцениваемыеПоАмортизированнойСтоимости", "ПОМЕСТИТЬ " + ИмяВременнойТаблицы); 
	
	Запрос.Выполнить();	
	
КонецПроцедуры

// Помещает уникальные строки таблицы ценных бумаг в менеджер временных таблиц
//
// Параметры:
//  ИсточникВременныхТаблиц	- Запрос, МенеджерВременныхТаблиц	- источник временных таблиц
//  ТаблицаЦБ				- ТаблицаЗначений					- таблица с бумагами, должна содержать колонки Рынок, ЦеннаяБумага, ВалютаНоминала и УчетныйАктивЦБРФ 
//  ИмяВременнойТаблицы		- Строка							- имя таблицы, под которым она будет создана в менеджере
//
Процедура ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, ТаблицаЦБ, ИмяВременнойТаблицы = "_ИсходнаяТаблицаЦБ")
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(
		ТаблицаЦБ, ИмяВременнойТаблицы, ИсточникВременныхТаблиц, Истина, "ЦеннаяБумага, Рынок, ВалютаНоминала, УчетныйАктивЦБРФ");  
	
КонецПроцедуры

// Помещает ценные бумаги, дополненные основными выпускам акций, в менеджер временных таблиц
//
// Параметры:
//  ИсточникВременныхТаблиц	- Запрос, МенеджерВременныхТаблиц - источник временных таблиц
//  ЦенныеБумаги			- Строка - имя временной таблицы с бумагами, состав см. в ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц
//  ИмяВременнойТаблицы		- Строка -
//
Процедура ПоместитьЦенныеБумагиДополненныеОсновнымиВыпускамиВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, ЦенныеБумаги, ИмяВременнойТаблицы = "_ЦенныеБумагиДополненныеОсновнымиВыпусками")
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СистемныеФункции.МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц);
	
	// Помещаем во временную таблицу
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	Акции.ОсновнойВыпуск КАК ОсновнойВыпуск
		|ПОМЕСТИТЬ _ОсновныеВыпуски
		|ИЗ
		|	#ЦенныеБумаги# КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО (Акции.Ссылка = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|			И (Акции.ОсновнойВыпуск <> ЗНАЧЕНИЕ(Справочник.Акции.ПустаяСсылка))
		|			И (Акции.ВалютаНоминала = _ИсходнаяТаблицаЦБ.ВалютаНоминала)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОсновныеВыпуски.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ОсновныеВыпуски.Рынок КАК Рынок,
		|	_ОсновныеВыпуски.ВалютаНоминала КАК ВалютаНоминала,
		|	_ОсновныеВыпуски.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	_ОсновныеВыпуски.ОсновнойВыпуск КАК ОсновнойВыпуск
		|ПОМЕСТИТЬ #ЦенныеБумагиДополненныеОсновнымиВыпусками#
		|ИЗ
		|	_ОсновныеВыпуски КАК _ОсновныеВыпуски
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_ОсновныеВыпуски.ОсновнойВыпуск,
		|	_ОсновныеВыпуски.Рынок,
		|	_ОсновныеВыпуски.ВалютаНоминала,
		|	_ОсновныеВыпуски.ОсновнойВыпуск.УчетныйАктивЦБРФ,
		|	NULL
		|ИЗ
		|	_ОсновныеВыпуски КАК _ОсновныеВыпуски
		|ГДЕ
		|	_ОсновныеВыпуски.ОсновнойВыпуск ЕСТЬ НЕ NULL 
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ОсновныеВыпуски";	
	
	Если ТипЗнч(ЦенныеБумаги) = Тип("Строка") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ЦенныеБумаги#", ЦенныеБумаги);
	Иначе
		ВызватьИсключение СтрШаблон("Некорректный тип параметра 'ЦенныеБумаги': '%1'", ТипЗнч(ЦенныеБумаги));
	КонецЕсли;	
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ #ЦенныеБумагиДополненныеОсновнымиВыпусками#", "ПОМЕСТИТЬ " + ИмяВременнойТаблицы); 
	
	Запрос.Выполнить();	
	
КонецПроцедуры

// Помещает статусы ценных бумаг в менеджер временных таблиц
//
// Параметры:
//  ИсточникВременныхТаблиц	- Запрос, МенеджерВременныхТаблиц - источник временных таблиц
//  ДатаПереоценки			- Дата - 
//  ЦенныеБумаги			- Строка - имя временной таблицы с бумагами, состав см. в ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц
//							- ТаблицаЗначений - таблица с бумагами, должна содержать колонки Рынок и ЦеннаяБумага 
//  ИмяВременнойТаблицы		- Строка -
//
Процедура ПоместитьСтатусыЦенныхБумагВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, ДатаПереоценки, ЦенныеБумаги, ИмяВременнойТаблицы = "_СтатусыЦенныхБумаг")
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СистемныеФункции.МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц);
	
	// Помещаем во временную таблицу
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтатусыЦенныхБумагСрезПоследних.Рынок КАК Рынок,
		|	СтатусыЦенныхБумагСрезПоследних.Период КАК Период,
		|	СтатусыЦенныхБумагСрезПоследних.Статус КАК Статус,
		|	СтатусыЦенныхБумагСрезПоследних.Биржа КАК Биржа
		|ПОМЕСТИТЬ #СтатусыЦенныхБумаг
		|ИЗ
		|	РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага В (&ЦенныеБумаги)) КАК СтатусыЦенныхБумагСрезПоследних
		|ГДЕ
		|	СтатусыЦенныхБумагСрезПоследних.Активен";	
	
	Если ТипЗнч(ЦенныеБумаги) = Тип("Строка") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЦенныеБумаги", СтрЗаменить("ВЫБРАТЬ _ИсходнаяТаблицаЦБ.ЦеннаяБумага ИЗ _ИсходнаяТаблицаЦБ", "_ИсходнаяТаблицаЦБ", ЦенныеБумаги));
	ИначеЕсли ТипЗнч(ЦенныеБумаги) = Тип("ТаблицаЗначений") Тогда
		Запрос.УстановитьПараметр("ЦенныеБумаги", ЦенныеБумаги.Скопировать(Неопределено, "ЦеннаяБумага").ВыгрузитьКолонку(0));
	Иначе
		ВызватьИсключение СтрШаблон("Некорректный тип параметра 'ЦенныеБумаги': '%1'", ТипЗнч(ЦенныеБумаги));
	КонецЕсли;	
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ #СтатусыЦенныхБумаг", "ПОМЕСТИТЬ " + ИмяВременнойТаблицы); 
	
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);	
	
	Запрос.Выполнить();	
	
КонецПроцедуры

// Помещает зарегистрированные аналоги ценных бумаг в менеджер временных таблиц
//
// Параметры:
//  ИсточникВременныхТаблиц	- Запрос, МенеджерВременныхТаблиц		- источник временных таблиц
//  ЦенныеБумаги			- Строка								- имя временной таблицы с бумагами (должна присутствовать колонка ЦеннаяБумага)
//							- ОпределяемыеТипы.ЦенныеБумаги			- ценная бумага
//							- Неопределено							- аналоги всех бумаг по клиенту
//  ДатаПереоценки			- Дата									- дата
//  Организация				- СправочникСсылка.Организации			- организация
//  Клиент					- СправочникСсылка.ЮрФизЛица			- юр./физ. лицо клиента
//	Отбор					- Структура								- структура позволяет установить отбор по ключам:
//								Назначение								- ПеречислениеСсылка.ЦелиИспользованияАналогов, Строка - цель использования аналогов (строка должна совпадать с идентификатором значения перечисления ЦелиИспользованияАналогов)
//								ВалютаНоминала							- СправочникСсылка.Валюты						- валюта номинала аналогов
//								ТолькоСВалютойНоминалаЦеннойБумаги		- Булево										- валюта номинала аналогов должна совпадать с валютой номинала ценной бумаги
//							- Неопределено							- без отбора
//  ИмяВременнойТаблицы		- Строка								- имя временной таблицы, в которую будут помещены аналоги
//
Процедура ПоместитьАналогиЦенныхБумагВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, ЦенныеБумаги, ДатаПереоценки, Организация, Клиент, Отбор = Неопределено, ИмяВременнойТаблицы = "_АналогиЦенныхБумаг") Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СистемныеФункции.МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	АналогиЦенныхБумагСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	АналогиЦенныхБумагСрезПоследних.Аналог КАК Аналог,
		|	АналогиЦенныхБумагСрезПоследних.Клиент КАК Клиент,
		|	АналогиЦенныхБумагСрезПоследних.Назначение КАК Назначение
		|ПОМЕСТИТЬ #АналогиЦенныхБумаг#
		|ИЗ
		|	РегистрСведений.АналогиЦенныхБумаг.СрезПоследних(
		|			&ДатаПереоценки,
		|			(Организация, Клиент, ЦеннаяБумага) В
		|					(ВЫБРАТЬ
		|						&Организация КАК Организация,
		|						&Клиент КАК Клиент,
		|						ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага
		|					ИЗ
		|						#ЦенныеБумаги# КАК ЦенныеБумаги)
		|				И &ОтборПоНазначению) КАК АналогиЦенныхБумагСрезПоследних
		|ГДЕ
		|	АналогиЦенныхБумагСрезПоследних.ДатаОкончанияДействия >= НАЧАЛОПЕРИОДА(&ДатаПереоценки, ДЕНЬ)
		|	И &ОтборПоВалютеНоминала
		|	И &ОтборПоСовпадениюСВалютойНоминалаЦеннойБумаги";	
	
	#Область Фильтр_по_ценным_бумагам
	
	Если ТипЗнч(ЦенныеБумаги) = Тип("Строка") Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ЦенныеБумаги#", ЦенныеБумаги);
		
	ИначеЕсли Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип.СодержитТип(ТипЗнч(ЦенныеБумаги)) Тогда
		
		Если ЦенныеБумаги = Неопределено Тогда // Все аналоги по клиенту
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "(Организация, Клиент, ЦеннаяБумага)", "(Организация, Клиент, НЕОПРЕДЕЛЕНО)");
		КонецЕсли;		
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ЦенныеБумаги#", "(ВЫБРАТЬ &ЦеннаяБумага КАК ЦеннаяБумага)");
		Запрос.УстановитьПараметр("ЦеннаяБумага", ЦенныеБумаги);
		
	Иначе
		ВызватьИсключение СтрШаблон("Некорректный тип параметра 'ЦенныеБумаги': '%1'", ТипЗнч(ЦенныеБумаги));
	КонецЕсли;	
	
	#КонецОбласти	
	
	#Область Устанавливаем_отборы
	
	СтруктураОтборов = Новый Структура("Назначение, ВалютаНоминала, ТолькоСВалютойНоминалаЦеннойБумаги");
	
	Если Отбор <> Неопределено Тогда
		РаботаСКоллекциями.ДополнитьСтруктуру(СтруктураОтборов, Отбор, Истина);
	КонецЕсли;
	
	Для Каждого ЭлементОтбора Из СтруктураОтборов Цикл
		
		ОшибкаТипаПараметра = Ложь;
		ЗначениеПараметра	= ЭлементОтбора.Значение;
		
		Если ЭлементОтбора.Ключ = "Назначение" Тогда

			#Область Отбор_по_цели_использования
			
			ПараметрОтбора	= "ОтборПоНазначению";
			ТекстОтбора		= "Назначение В (&Назначение, ЗНАЧЕНИЕ(Перечисление.ЦелиИспользованияАналогов.ПустаяСсылка))";
			
			Если ЭлементОтбора.Значение = Неопределено Тогда
				ТекстОтбора = "ИСТИНА";
			ИначеЕсли ТипЗнч(ЭлементОтбора.Значение) = Тип("Строка") Тогда
				ЗначениеПараметра = Перечисления.ЦелиИспользованияАналогов[ЭлементОтбора.Значение];
			ИначеЕсли ТипЗнч(ЭлементОтбора.Значение) <> Тип("ПеречислениеСсылка.ЦелиИспользованияАналогов") Тогда
				ОшибкаТипаПараметра = Истина;	
			КонецЕсли;
			
			#КонецОбласти
			
		ИначеЕсли ЭлементОтбора.Ключ = "ВалютаНоминала" Тогда
			
			#Область Отбор_по_валюте_номинала_аналогов
			
			ПараметрОтбора	= "ОтборПоВалютеНоминала";
			ТекстОтбора		= "АналогиЦенныхБумагСрезПоследних.Аналог.ВалютаНоминала В (&ВалютаНоминала)";
			
			Если ЭлементОтбора.Значение = Неопределено Тогда
				ТекстОтбора = "ИСТИНА";	
			ИначеЕсли ТипЗнч(ЭлементОтбора.Значение) <> Тип("СправочникСсылка.Валюты") Тогда
				ОшибкаТипаПараметра = Истина;	
			КонецЕсли;
			
			#КонецОбласти
			
		ИначеЕсли ЭлементОтбора.Ключ = "ТолькоСВалютойНоминалаЦеннойБумаги" Тогда

			#Область Валюты_номинала_аналогов_должны_совпадать_с_валютой_номинала_ценной_бумаги
			
			ПараметрОтбора	= "ОтборПоСовпадениюСВалютойНоминалаЦеннойБумаги";
			ТекстОтбора		= "АналогиЦенныхБумагСрезПоследних.Аналог.ВалютаНоминала = АналогиЦенныхБумагСрезПоследних.ЦеннаяБумага.ВалютаНоминала";
			
			Если ЭлементОтбора.Значение = Неопределено ИЛИ ЭлементОтбора.Значение = Ложь Тогда
				ТекстОтбора = "ИСТИНА";	
			ИначеЕсли ТипЗнч(ЭлементОтбора.Значение) <> Тип("Булево") Тогда
				ОшибкаТипаПараметра = Истина;	
			КонецЕсли;
			
			#КонецОбласти
			
		Иначе
			ВызватьИсключение СтрШаблон("Неизвестный ключ отбора: %1", ЭлементОтбора.Ключ);
		КонецЕсли;
		
		Если ОшибкаТипаПараметра Тогда
			ВызватьИсключение СтрШаблон("Некорректный тип параметра '%1': '%2'", ЭлементОтбора.Ключ, ТипЗнч(ЭлементОтбора.Значение));
		КонецЕсли;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&" + ПараметрОтбора, ТекстОтбора);
		
		Запрос.УстановитьПараметр(ЭлементОтбора.Ключ, ЗначениеПараметра);
		
	КонецЦикла;
	
	#КонецОбласти
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ #АналогиЦенныхБумаг#", "ПОМЕСТИТЬ " + ИмяВременнойТаблицы);
	
	Запрос.УстановитьПараметр("ДатаПереоценки",	ДатаПереоценки);
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("Клиент",			Клиент);
	
	Запрос.Выполнить();
	
КонецПроцедуры

// Помещает эмитентов ценных бумаг в менеджер временных таблиц
//
// Параметры:
//  ИсточникВременныхТаблиц	- Запрос, МенеджерВременныхТаблиц - источник временных таблиц
//  ДатаПереоценки			- Дата - 
//  ЦенныеБумаги			- Строка - имя временной таблицы с бумагами, состав см. в ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц
//  ИмяВременнойТаблицы		- Строка -
//
Процедура ПоместитьЭмитентовЦенныхБумагВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, ДатаПереоценки, ЦенныеБумаги, ИмяВременнойТаблицы = "_ЭмитентыЦенныхБумаг")
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СистемныеФункции.МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц);
	
	// Помещаем во временную таблицу
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЕСТЬNULL(Эмитенты.Ссылка, Паи.ПаевойИнвестиционныйФонд) КАК Эмитент,
		|	ЕСТЬNULL(Эмитенты.ЮрФизЛицо, РеквизитыПИФ.УправляющаяКомпания.ЮрФизЛицо) КАК ЮрЛицоЭмитента,
		|	Эмитенты.ДатаБанкротства КАК ДатаБанкротства,
		|	Эмитенты.ДатаБанкротства <> ДАТАВРЕМЯ(1, 1, 1)
		|		И Эмитенты.ДатаБанкротства <= &ДатаПереоценки КАК Банкрот
		|ПОМЕСТИТЬ #ЭмитентыЦенныхБумаг
		|ИЗ
		|	#ЦенныеБумаги КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Акции.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Векселя КАК Векселя
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Векселя.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеРасписки КАК ДепозитарныеРасписки
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = ДепозитарныеРасписки.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = ИпотечныеСертификатыУчастия.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|		ПО (Эмитенты.Ссылка = ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(_ИсходнаяТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|					ТОГДА Акции.Эмитент
		|				КОГДА ТИПЗНАЧЕНИЯ(_ИсходнаяТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|					ТОГДА Облигации.Эмитент
		|				КОГДА ТИПЗНАЧЕНИЯ(_ИсходнаяТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|					ТОГДА Векселя.Эмитент
		|				КОГДА ТИПЗНАЧЕНИЯ(_ИсходнаяТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.ДепозитарныеРасписки)
		|					ТОГДА ДепозитарныеРасписки.Эмитент
		|				КОГДА ТИПЗНАЧЕНИЯ(_ИсходнаяТаблицаЦБ.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|					ТОГДА ИпотечныеСертификатыУчастия.Эмитент
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Паи.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(
		|				&ДатаПереоценки,
		|				(ПаевойИнвестиционныйФонд, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						Паи.ПаевойИнвестиционныйФонд,
		|						ИСТИНА
		|					ИЗ
		|						Справочник.Паи КАК Паи
		|							ВНУТРЕННЕЕ СОЕДИНЕНИЕ #ЦенныеБумаги КАК _ИсходнаяТаблицаЦБ
		|							ПО
		|								_ИсходнаяТаблицаЦБ.ЦеннаяБумага = Паи.Ссылка)) КАК РеквизитыПИФ
		|		ПО (РеквизитыПИФ.ПаевойИнвестиционныйФонд = Паи.ПаевойИнвестиционныйФонд)
		|ГДЕ
		|	(Эмитенты.Ссылка ЕСТЬ НЕ NULL 
		|			ИЛИ Паи.ПаевойИнвестиционныйФонд ЕСТЬ НЕ NULL )";	
	
	Если ТипЗнч(ЦенныеБумаги) = Тип("Строка") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ЦенныеБумаги", ЦенныеБумаги);
	Иначе
		ВызватьИсключение СтрШаблон("Некорректный тип параметра 'ЦенныеБумаги': '%1'", ТипЗнч(ЦенныеБумаги));
	КонецЕсли;	
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ #ЭмитентыЦенныхБумаг", "ПОМЕСТИТЬ " + ИмяВременнойТаблицы); 
	
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);	
	
	Запрос.Выполнить();	
	
КонецПроцедуры

// Помещает даты расчета цен паев с учетом даты возникновения основания прекращения ПИФ в менеджер временных таблиц
//
// Параметры:
//  ИсточникВременныхТаблиц	- Запрос, МенеджерВременныхТаблиц - источник временных таблиц
//  ЦенныеБумаги			- Строка, СправочникСсылка.Паи - имя временной таблицы с бумагами (состав см. в ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц), либо ценная бумага
//  Период					- Дата - 
//  ИмяВременнойТаблицы		- Строка -
//
Процедура ПоместитьТаблицуДатРасчетныхЦенПаевВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, ЦенныеБумаги, Период, ИмяВременнойТаблицы = "_ТаблицаДатРасчетныхЦенПаев")
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СистемныеФункции.МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц);
	
	Запрос.Текст = 		
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДатыРасчетаЦенПаевПоТипуПИФ.Тип КАК Тип,
		|	ДатыРасчетаЦенПаевПоТипуПИФ.Дата КАК Дата
		|ПОМЕСТИТЬ _ДатыРасчетаЦенПаевПоТипуПИФ
		|ИЗ
		|	&ДатыРасчетаЦенПаевПоТипуПИФ КАК ДатыРасчетаЦенПаевПоТипуПИФ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	Паи.ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд,
		|	ПИФ.Тип КАК ТипПИФ,
		|	ДатыПрекращенияПИФ.Значение КАК ДатаПрекращенияПИФ,
		|	ВЫБОР
		|		КОГДА ДатыПрекращенияПИФ.Значение <= &Период
		|				И ДатыПрекращенияПИФ.Значение <> ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ДатыПрекращенияПИФ.Значение
		|		ИНАЧЕ _ДатыРасчетаЦенПаевПоТипуПИФ.Дата
		|	КОНЕЦ КАК Дата
		|ПОМЕСТИТЬ #ТаблицаДатРасчетныхЦенПаев
		|ИЗ
		|	#ТаблицаЦБ КАК _ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
		|		ПО (Паи.Ссылка = _ТаблицаЦБ.ЦеннаяБумага)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПаевыеИнвестиционныеФонды КАК ПИФ
		|		ПО (ПИФ.Ссылка = Паи.ПаевойИнвестиционныйФонд)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыРасчетаЦенПаевПоТипуПИФ КАК _ДатыРасчетаЦенПаевПоТипуПИФ
		|		ПО (_ДатыРасчетаЦенПаевПоТипуПИФ.Тип = ПИФ.Тип)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ДатыПрекращенияПИФ
		|		ПО (ДатыПрекращенияПИФ.Объект = ПИФ.Ссылка)
		|			И (ДатыПрекращенияПИФ.Свойство = &СвойствоДатаПрекращенияПИФ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ДатыРасчетаЦенПаевПоТипуПИФ";
	
	Если ТипЗнч(ЦенныеБумаги) = Тип("Строка") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ТаблицаЦБ", ЦенныеБумаги);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ТаблицаЦБ", "(ВЫБРАТЬ &ЦенныеБумаги КАК ЦеннаяБумага)");
	КонецЕсли;	
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ #ТаблицаДатРасчетныхЦенПаев", "ПОМЕСТИТЬ " + ИмяВременнойТаблицы); 

	СвойствоДатаПрекращенияПИФ = ПланыВидовХарактеристик.ДополнительныеСведения.НайтиПоРеквизиту("Ключ", "ДатаВозникновенияОснованияПрекращенияФонда");
	
	#Область Заполняем_даты_расчета_цен_паев_по_типу_ПИФ
	
	ДатыРасчетаЦенПаевПоТипуПИФ = Новый ТаблицаЗначений;
	ДатыРасчетаЦенПаевПоТипуПИФ.Колонки.Добавить("Тип",	 Новый ОписаниеТипов("ПеречислениеСсылка.ТипыПифовВЗависимостиОтЛиквидности"));
	ДатыРасчетаЦенПаевПоТипуПИФ.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	
	НоваяСтрока			= ДатыРасчетаЦенПаевПоТипуПИФ.Добавить();
	НоваяСтрока.Тип		= Перечисления.ТипыПифовВЗависимостиОтЛиквидности.Открытый;
	НоваяСтрока.Дата	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, Период);
	
	НоваяСтрока		= ДатыРасчетаЦенПаевПоТипуПИФ.Добавить();
	НоваяСтрока.Тип	= Перечисления.ТипыПифовВЗависимостиОтЛиквидности.Закрытый;
	
	Если Период < Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоДня(КонецМесяца(Период))) Тогда
		НоваяСтрока.Дата = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоДня(КонецМесяца(НачалоМесяца(Период)-24*60*60)));
	Иначе
		НоваяСтрока.Дата = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоДня(КонецМесяца(Период)));
	КонецЕсли;
	
	#КонецОбласти	
	
	Запрос.УстановитьПараметр("Период", 					 НачалоДня(Период));
	Запрос.УстановитьПараметр("СвойствоДатаПрекращенияПИФ",	 СвойствоДатаПрекращенияПИФ);
	Запрос.УстановитьПараметр("ДатыРасчетаЦенПаевПоТипуПИФ", ДатыРасчетаЦенПаевПоТипуПИФ);
	
	Запрос.Выполнить();	
	
КонецПроцедуры

// Помещает котировки купонов ценных бумаг в соответствии с приоритетом источников, заданным методикой, в менеджер временных таблиц
//
// Параметры:
//  ИсточникВременныхТаблиц	- Запрос, МенеджерВременныхТаблиц						- источник временных таблиц
//  ДатаПереоценки			- Дата													- 
//  ВариантРасчетаСтоимости	- СправочникСсылка.ВариантыРасчетаОценочнойСтоимости	- методика оценки
//  ЦенныеБумаги			- Строка												- имя временной таблицы с бумагами, состав см. в ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц
//							- ТаблицаЗначений										- таблица с бумагами, должна содержать колонки Рынок и ЦеннаяБумага 
//  ИмяВременнойТаблицы		- Строка												-
//
Процедура ПоместитьКотировкиКупоновВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, ДатаПереоценки, ВариантРасчетаСтоимости, ЦенныеБумаги, ИмяВременнойТаблицы = "_КотировкиКупона")
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СистемныеФункции.МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиКупона.Облигация КАК Облигация,
		|	КотировкиКупона.ВалютаКупона КАК ВалютаКупона,
		|	ВЫБОР
		|		КОГДА &ПриоритетИсточников = &ПриоритетИсточников_Блумберг_Площадки_Котировки
		|			ТОГДА ЕСТЬNULL(КотировкиКупона.КупонБлумберг, ЕСТЬNULL(КотировкиКупона.КупонММВБ, КотировкиКупона.КупонКотировкиЦенныхБумаг))
		|		КОГДА &ПриоритетИсточников = &ПриоритетИсточников_Площадки_Котировки_Блумберг
		|			ТОГДА ЕСТЬNULL(КотировкиКупона.КупонММВБ, ЕСТЬNULL(КотировкиКупона.КупонКотировкиЦенныхБумагВРублях, ЕСТЬNULL(КотировкиКупона.КупонБлумберг, КотировкиКупона.КупонКотировкиЦенныхБумаг)))
		|	КОНЕЦ КАК Купон,
		|	ВЫБОР
		|		КОГДА &ПриоритетИсточников = &ПриоритетИсточников_Блумберг_Площадки_Котировки
		|			ТОГДА ЕСТЬNULL(КотировкиКупона.КупонБлумберг_Период, ЕСТЬNULL(КотировкиКупона.КупонММВБ_Период, КотировкиКупона.КупонКотировкиЦенныхБумаг_Период))
		|		КОГДА &ПриоритетИсточников = &ПриоритетИсточников_Площадки_Котировки_Блумберг
		|			ТОГДА ЕСТЬNULL(КотировкиКупона.КупонММВБ_Период, ЕСТЬNULL(КотировкиКупона.КупонКотировкиЦенныхБумагВРублях_Период, ЕСТЬNULL(КотировкиКупона.КупонБлумберг_Период, КотировкиКупона.КупонКотировкиЦенныхБумаг_Период)))
		|	КОНЕЦ КАК ДатаКупона,
		|	&ПриоритетИсточников КАК ПриоритетИсточников,
		|	КотировкиКупона.КупонММВБ КАК КупонММВБ,
		|	КотировкиКупона.КупонММВБ_Период КАК КупонММВБ_Период,
		|	КотировкиКупона.КупонБлумберг КАК КупонБлумберг,
		|	КотировкиКупона.КупонБлумберг_Период КАК КупонБлумберг_Период,
		|	КотировкиКупона.КупонКотировкиЦенныхБумаг КАК КупонКотировкиЦБ,
		|	КотировкиКупона.КупонКотировкиЦенныхБумаг_Период КАК КупонКотировкиЦБ_Период,
		|	КотировкиКупона.КупонКотировкиЦенныхБумагВРублях КАК КупонКотировкиЦБВРублях,
		|	КотировкиКупона.КупонКотировкиЦенныхБумагВРублях_Период КАК КупонКотировкиЦБВРублях_Период
		|ПОМЕСТИТЬ #КотировкиКупона#
		|ИЗ
		|	(ВЫБРАТЬ
		|		Облигации.Ссылка КАК Облигация,
		|		МИНИМУМ(ЕСТЬNULL(КотировкиТорговыхПлощадокММВБВалютаНоминала.Валюта, ЕСТЬNULL(КотировкиТорговыхПлощадокММВБВалютаУчета.Валюта, ЕСТЬNULL(КотировкиЦенныхБумаг.Валюта, КотировкиТорговыхПлощадокБлумберг.Валюта)))) КАК ВалютаКупона,
		|		МИНИМУМ(ЕСТЬNULL(КотировкиТорговыхПлощадокММВБВалютаНоминала.ACCINT, КотировкиТорговыхПлощадокММВБВалютаУчета.ACCINT)) КАК КупонММВБ,
		|		МИНИМУМ(ЕСТЬNULL(КотировкиТорговыхПлощадокММВБВалютаНоминала.Период, КотировкиТорговыхПлощадокММВБВалютаУчета.Период)) КАК КупонММВБ_Период,
		|		МИНИМУМ(КотировкиТорговыхПлощадокБлумберг.ACCINT) КАК КупонБлумберг,
		|		МИНИМУМ(КотировкиТорговыхПлощадокБлумберг.Период) КАК КупонБлумберг_Период,
		|		МИНИМУМ(КотировкиЦенныхБумаг.ACCINT) КАК КупонКотировкиЦенныхБумаг,
		|		МИНИМУМ(КотировкиЦенныхБумаг.Период) КАК КупонКотировкиЦенныхБумаг_Период,
		|		ВЫБОР
		|			КОГДА МИНИМУМ(Облигации.ВалютаНоминала) = &ВалютаРубли
		|				ТОГДА МИНИМУМ(КотировкиЦенныхБумаг.ACCINT)
		|		КОНЕЦ КАК КупонКотировкиЦенныхБумагВРублях,
		|		ВЫБОР
		|			КОГДА МИНИМУМ(Облигации.ВалютаНоминала) = &ВалютаРубли
		|				ТОГДА МИНИМУМ(КотировкиЦенныхБумаг.Период)
		|		КОНЕЦ КАК КупонКотировкиЦенныхБумагВРублях_Период
		|	ИЗ
		|		Справочник.Облигации КАК Облигации
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадокММВБВалютаНоминала
		|			ПО (КотировкиТорговыхПлощадокММВБВалютаНоминала.ЦеннаяБумага = Облигации.Ссылка)
		|				И (КотировкиТорговыхПлощадокММВБВалютаНоминала.Период = &Период)
		|				И (КотировкиТорговыхПлощадокММВБВалютаНоминала.Биржа = &ММВБ)
		|				И (КотировкиТорговыхПлощадокММВБВалютаНоминала.Валюта = Облигации.ВалютаНоминала)
		|				И (НЕ КотировкиТорговыхПлощадокММВБВалютаНоминала.ЦеннаяБумага В (&ОблигацииСРасчетнымКупоном))
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадокММВБВалютаУчета
		|			ПО (КотировкиТорговыхПлощадокММВБВалютаУчета.ЦеннаяБумага = Облигации.Ссылка)
		|				И (КотировкиТорговыхПлощадокММВБВалютаУчета.Период = &Период)
		|				И (КотировкиТорговыхПлощадокММВБВалютаУчета.Биржа = &ММВБ)
		|				И (КотировкиТорговыхПлощадокММВБВалютаУчета.Валюта = &ВалютаРубли)
		|				И (НЕ КотировкиТорговыхПлощадокММВБВалютаУчета.ЦеннаяБумага В (&ОблигацииСРасчетнымКупоном))
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадокБлумберг
		|			ПО (КотировкиТорговыхПлощадокБлумберг.ЦеннаяБумага = Облигации.Ссылка)
		|				И (КотировкиТорговыхПлощадокБлумберг.Период = &Период)
		|				И (КотировкиТорговыхПлощадокБлумберг.Биржа = &Блумберг)
		|				И (КотировкиТорговыхПлощадокБлумберг.РежимТоргов = &Режим_BGN)
		|				И (КотировкиТорговыхПлощадокБлумберг.Валюта = Облигации.ВалютаНоминала)
		|				И (&ДоступныДанныеBloomberg)
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиЦенныхБумаг КАК КотировкиЦенныхБумаг
		|			ПО (КотировкиЦенныхБумаг.ЦеннаяБумага = Облигации.Ссылка)
		|				И (КотировкиЦенныхБумаг.Период = &Период)
		|				И (КотировкиЦенныхБумаг.Биржа = &ММВБ)
		|				И (НЕ КотировкиЦенныхБумаг.ЦеннаяБумага В (&ОблигацииСРасчетнымКупоном))
		|				И (КотировкиЦенныхБумаг.Валюта В (Облигации.ВалютаНоминала, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)))
		|	ГДЕ
		|		Облигации.Ссылка В(&ЦенныеБумаги)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		Облигации.Ссылка) КАК КотировкиКупона";
	
	Запрос.УстановитьПараметр("ЦенныеБумаги", ЦенныеБумаги);
	
	Если ТипЗнч(ЦенныеБумаги) = Тип("Строка") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЦенныеБумаги",
			СтрЗаменить("ВЫБРАТЬ РАЗЛИЧНЫЕ ЦеннаяБумага ИЗ _ИсходнаяТаблицаЦБ ГДЕ Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)", "_ИсходнаяТаблицаЦБ", ЦенныеБумаги));
	ИначеЕсли ТипЗнч(ЦенныеБумаги) = Тип("ТаблицаЗначений") Тогда
		Запрос.УстановитьПараметр("ЦенныеБумаги", ЦенныеБумаги.Скопировать(Новый Структура("Рынок", Перечисления.РынкиЦенныхБумаг.Облигации), "ЦеннаяБумага").ВыгрузитьКолонку(0));
	Иначе
		ВызватьИсключение СтрШаблон("Некорректный тип параметра 'ЦенныеБумаги': '%1'", ТипЗнч(ЦенныеБумаги));
	КонецЕсли;	
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ #КотировкиКупона#", "ПОМЕСТИТЬ " + ИмяВременнойТаблицы); 
	
	#Область Заполняем_приоритеты_источников
	
	ПриоритетыИсточников = Новый Структура;
	ПриоритетыИсточников.Вставить("Блумберг_Площадки_Котировки", "Блумберг - Площадки - Котировки");
	ПриоритетыИсточников.Вставить("Площадки_Котировки_Блумберг", "Площадки - Котировки - Блумберг");
	
	Для каждого Приоритет Из ПриоритетыИсточников Цикл
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПриоритетИсточников_" + Приоритет.Ключ, """" + Приоритет.Значение + """");
	КонецЦикла; 
		
	#КонецОбласти 
	
	Если ВариантРасчетаСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2018
		ИЛИ ВариантРасчетаСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2020
		ИЛИ ВариантРасчетаСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2021
	Тогда
	    Запрос.УстановитьПараметр("ПриоритетИсточников", ПриоритетыИсточников.Блумберг_Площадки_Котировки); // порядок взятия: Блумберг - Площадки - Котировки
	Иначе
	    Запрос.УстановитьПараметр("ПриоритетИсточников", ПриоритетыИсточников.Площадки_Котировки_Блумберг); // порядок взятия: Площадки - Котировки - Блумберг
	КонецЕсли;
	
	МассивОблигацииСРасчетнымКупоном = Новый Массив();
	ОблигацииСРасчетнымКупоном = РаботаСЦеннымиБумагами.ПолучитьОблигацииСРасчетнымКупоном();
	Для каждого СтрокаОблигацииСРасчетнымКупоном Из ОблигацииСРасчетнымКупоном Цикл
		Если (СтрокаОблигацииСРасчетнымКупоном.ДатаНачала <= ДатаПереоценки ИЛИ СтрокаОблигацииСРасчетнымКупоном.ДатаНачала = '00010101')
			И (СтрокаОблигацииСРасчетнымКупоном.ДатаОкончания >= ДатаПереоценки ИЛИ СтрокаОблигацииСРасчетнымКупоном.ДатаОкончания = '00010101') Тогда
		
			МассивОблигацииСРасчетнымКупоном.Добавить(СтрокаОблигацииСРасчетнымКупоном.Облигация);
			
		КонецЕсли;
	КонецЦикла;
	Запрос.УстановитьПараметр("ОблигацииСРасчетнымКупоном",	МассивОблигацииСРасчетнымКупоном);
	
	Запрос.УстановитьПараметр("Период", 					ДатаПереоценки);
	Запрос.УстановитьПараметр("ММВБ",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("Блумберг",					ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("Режим_BGN",					ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("ВалютаРубли",				ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	Запрос.УстановитьПараметр("ДоступныДанныеBloomberg",	ПроверитьДоступностьДанныхBloomberg(ДатаПереоценки));	
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ДобавитьСтрокуТаблицыПриоритетаБирж(ТаблицаБирж, Приоритет, Биржа, ВалютаНоминала = Неопределено)
	
	СтрокаТаблицы = ТаблицаБирж.Добавить();

	СтрокаТаблицы.Приоритет	= Приоритет;
	СтрокаТаблицы.Биржа		= ?(ТипЗнч(Биржа) = Тип("Строка"), ОбщегоНазначения.ПолучитьИменованныйОбъект(Биржа), Биржа);

	Если ВалютаНоминала <> Неопределено Тогда
		СтрокаТаблицы.ВалютаНоминала = ВалютаНоминала;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСтрокуПриоритетаЦены(ПриоритетыЦен, ОписаниеАктива, ВидЦены, Приоритет, Уровень = Неопределено, ПроверкиЦены = Неопределено, Примечание = "")

	СтрокаПриоритетаЦены = ПриоритетыЦен.Добавить();
	
	ЗаполнитьЗначенияСвойств(СтрокаПриоритетаЦены, ОписаниеАктива);
	
	СтрокаПриоритетаЦены.ВидЦены	= ВидЦены;
	СтрокаПриоритетаЦены.Уровень	= ?(Уровень = Неопределено, Цел(Приоритет), Уровень);
	СтрокаПриоритетаЦены.Приоритет	= Приоритет;
	СтрокаПриоритетаЦены.Примечание	= Примечание;
	
	Если ПроверкиЦены <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(СтрокаПриоритетаЦены, ПроверкиЦены);
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьСтрокиПриоритетаЦен(ПриоритетыЦен, ОписаниеАктива, ПараметрыОтбора)

	СтруктураПоиска = РаботаСКоллекциями.СкопироватьСтруктуру(ОписаниеАктива);
	РаботаСКоллекциями.ДополнитьСтруктуру(СтруктураПоиска, ПараметрыОтбора);
	Если СтруктураПоиска.Свойство("Приоритет") Тогда
		СтруктураПоиска.Приоритет = Строка(СтруктураПоиска.Приоритет);		
	КонецЕсли;
	
	СтрокиПриоритетаЦены = ПриоритетыЦен.НайтиСтроки(СтруктураПоиска);
	
	Для Каждого СтрокаПриоритетаЦены Из СтрокиПриоритетаЦены Цикл
		ПриоритетыЦен.Удалить(СтрокаПриоритетаЦены);
	КонецЦикла;
	
КонецПроцедуры

Процедура СкопироватьПриоритетыЦен(ПриоритетыЦен, ОписаниеАктиваПриемник, ОписаниеАктиваИсточник, ПараметрыОтбора)
	
	СтруктураПоиска = РаботаСКоллекциями.СкопироватьСтруктуру(ОписаниеАктиваИсточник);
	РаботаСКоллекциями.ДополнитьСтруктуру(СтруктураПоиска, ПараметрыОтбора);
	Если СтруктураПоиска.Свойство("Приоритет") Тогда
		СтруктураПоиска.Приоритет = Строка(СтруктураПоиска.Приоритет);		
	КонецЕсли;
	
	АналогичныеПриоритеты = ПриоритетыЦен.Скопировать(СтруктураПоиска);
	
	Для Каждого ПолеОписания Из ОписаниеАктиваПриемник Цикл
		АналогичныеПриоритеты.ЗаполнитьЗначения(ПолеОписания.Значение, ПолеОписания.Ключ);
	КонецЦикла;

	РаботаСКоллекциями.ТаблицаЗначений_Дополнить(АналогичныеПриоритеты, ПриоритетыЦен);	
	
КонецПроцедуры

Функция ПроверитьИзменениеЦеновогоИндексаОблигацийСоответствующейКатегории(ЦеннаяБумага, ДатаЦены, ПараметрыОценки, ДатаПереоценки, Отказ, РасшифровкаРасчета = Неопределено)
	
	Если ТипЗнч(ЦеннаяБумага) <> Тип("СправочникСсылка.Облигации") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Не удалось выполнить проверку существенности изменения рыночных условий для цены '%1': некорректный тип ценной бумаги.", ЦеннаяБумага), , , , Отказ);	
		Возврат Истина;	
	КонецЕсли;
		
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДопустимыеОтклоненияИндексов.КодИндекса КАК КодИндекса,
		|	ДопустимыеОтклоненияИндексов.Индекс КАК Индекс,
		|	ДопустимыеОтклоненияИндексов.ДопустимоеОтклонение КАК ДопустимоеОтклонение
		|ПОМЕСТИТЬ ДопустимыеОтклоненияИндексов
		|ИЗ
		|	&ДопустимыеОтклоненияИндексов КАК ДопустимыеОтклоненияИндексов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Облигации.Ссылка КАК ЦеннаяБумага,
		|	Облигации.Категория КАК Категория,
		|	ДопустимыеОтклоненияИндексов.Индекс КАК Индекс,
		|	ДопустимыеОтклоненияИндексов.ДопустимоеОтклонение КАК ДопустимоеОтклонение
		|ПОМЕСТИТЬ Индексы
		|ИЗ
		|	Справочник.Облигации КАК Облигации
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДопустимыеОтклоненияИндексов КАК ДопустимыеОтклоненияИндексов
		|		ПО (ВЫБОР
		|				КОГДА Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная)
		|					ТОГДА ДопустимыеОтклоненияИндексов.КодИндекса = ""RGBI""
		|				КОГДА Облигации.Категория В (ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Муниципальная), ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная))
		|					ТОГДА ДопустимыеОтклоненияИндексов.КодИндекса = ""RUMBICP""
		|				ИНАЧЕ ДопустимыеОтклоненияИндексов.КодИндекса = ""RUCBICP""
		|			КОНЕЦ)
		|ГДЕ
		|	Облигации.Ссылка = &ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Индексы.Индекс КАК Индекс,
		|	ЗначенияИндексовНаДатуЦены.CLOSE КАК ЗначениеИндексаНаДатуЦены,
		|	ЗначенияИндексовНаДатуПереоценки.CLOSE КАК ЗначениеИндексаНаДатуПереоценки,
		|	ЗначенияИндексовНаДатуПереоценки.CLOSE / ЗначенияИндексовНаДатуЦены.CLOSE КАК КоэффициентИзмененияИндекса,
		|	Индексы.ДопустимоеОтклонение КАК ДопустимоеОтклонение,
		|	ЗначенияИндексовНаДатуПереоценки.CLOSE / ЗначенияИндексовНаДатуЦены.CLOSE МЕЖДУ 1 - Индексы.ДопустимоеОтклонение И 1 + Индексы.ДопустимоеОтклонение КАК ПроверкаПройдена
		|ИЗ
		|	Индексы КАК Индексы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияИндексовНаДатуЦены
		|		ПО (ЗначенияИндексовНаДатуЦены.Биржа = &ММВБ)
		|			И (ЗначенияИндексовНаДатуЦены.БиржевойИндекс = Индексы.Индекс)
		|			И (ЗначенияИндексовНаДатуЦены.Период = &ДатаИндексаЦены)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияИндексовНаДатуПереоценки
		|		ПО (ЗначенияИндексовНаДатуПереоценки.Биржа = &ММВБ)
		|			И (ЗначенияИндексовНаДатуПереоценки.БиржевойИндекс = Индексы.Индекс)
		|			И (ЗначенияИндексовНаДатуПереоценки.Период = &ПоследняяДатаТоргов)");
	
	ДопустимыеОтклоненияИндексов = ПолучитьЗначенияДопустимогоОтклоненияЦеновогоИндексаОблигаций(ПараметрыОценки, ДатаПереоценки, Отказ, РасшифровкаРасчета);
	
	КалендарьКотировок	= Константы.ОсновнойКалендарьКотировок.Получить();
	ПоследняяДатаТоргов	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьКотировок, НачалоДня(ДатаПереоценки));
	ДатаИндексаЦены		= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьКотировок, ДатаЦены);
	
	Запрос.УстановитьПараметр("ЦеннаяБумага",					ЦеннаяБумага);
	Запрос.УстановитьПараметр("ДатаЦены",						ДатаЦены);
	Запрос.УстановитьПараметр("ДатаИндексаЦены",				ДатаИндексаЦены);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",			ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("ММВБ",							ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("ДопустимыеОтклоненияИндексов",	ДопустимыеОтклоненияИндексов);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ИзменениеЦеновогоИндекса = Запрос.Выполнить().Выгрузить();
	Иначе
		ИзменениеЦеновогоИндекса = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Расчет изменения ценового индекса", "Изменение ценового индекса", , , "ДопустимыеОтклоненияИндексов", Истина);
	КонецЕсли;
	
	Если ИзменениеЦеновогоИндекса.Количество() = 0
		ИЛИ ИзменениеЦеновогоИндекса[0].ПроверкаПройдена = NULL
	Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Не удалось выполнить проверку существенности изменения рыночных условий для цены '%1'", ЦеннаяБумага), , , , Отказ);
		Возврат Истина;
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		ПараметрыРасчета = Новый Структура("КоэффициентИзмененияИндекса, ЛеваяГраница, ПраваяГраница, ПроверкаПройдена",
			ИзменениеЦеновогоИндекса[0].КоэффициентИзмененияИндекса, 1 - ИзменениеЦеновогоИндекса[0].ДопустимоеОтклонение, 1 + ИзменениеЦеновогоИндекса[0].ДопустимоеОтклонение, ИзменениеЦеновогоИндекса[0].ПроверкаПройдена);
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Проверка существенности изменения рыночных условий", ПараметрыРасчета);
	КонецЕсли;
	
	Возврат ИзменениеЦеновогоИндекса[0].ПроверкаПройдена;  
	
КонецФункции

Функция ПроверитьЦенуПоСпредуДоходности(СтрокаСтоимостейЦБ, ПараметрыОценки, КредитныйСпред, ДатаПереоценки, Отказ, РасшифровкаРасчета = Неопределено)
	
	РезультатПроверки	= Неопределено;
	ОшибкаРасчета		= Ложь;
	
	// Расчет спреда доходности бумаги к КБД в точке дюрации бумаги 
	
	ДоходностьИДюрация = Справочники.Облигации.ПолучитьДоходностьИДюрацию(СтрокаСтоимостейЦБ.ЦеннаяБумага, Ложь, ДатаПереоценки, СтрокаСтоимостейЦБ.Стоимость, ПараметрыОценки.СчетДоверительногоУправления, , КонецДня(ДатаПереоценки), Истина, СтрокаСтоимостейЦБ.Купон);
	
	Если ПараметрыОценки.Свойство("ТочностьДюрации") Тогда
		ДоходностьИДюрация.Дюрация = Окр(ДоходностьИДюрация.Дюрация, ПараметрыОценки.ТочностьДюрации); 		
	КонецЕсли;
	
	ЗначениеКБД = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьЗначениеКривойБескупоннойДоходности(ДатаПереоценки, ДоходностьИДюрация.Дюрация / 365, , ОшибкаРасчета); 
	
	Если Не ОшибкаРасчета Тогда
		
		Если ПараметрыОценки.Свойство("ТочностьДоходностиКПогашению") Тогда
			ДоходностьИДюрация.Доходность = Окр(ДоходностьИДюрация.Доходность, ПараметрыОценки.ТочностьДоходностиКПогашению); 		
		КонецЕсли;
		
		Если ПараметрыОценки.Свойство("ТочностьКБД") Тогда
			ЗначениеКБД = Окр(ЗначениеКБД, ПараметрыОценки.ТочностьКБД); 		
		КонецЕсли;
		
		СпредДоходности = ДоходностьИДюрация.Доходность - ЗначениеКБД;
		Если СпредДоходности < 0 Тогда
			СпредДоходности = -СпредДоходности;
		КонецЕсли;	
			
		// Проверяем, что кредитный спред рассчитан корректно
		
		Если ТипЗнч(КредитныйСпред) = Тип("ТаблицаЗначений") И КредитныйСпред.Количество() > 0 Тогда
		
			МинимумКредитногоСпреда	 = КредитныйСпред[0].МинимумКредитногоСпреда / 100;
			МаксимумКредитногоСпреда = КредитныйСпред[0].МаксимумКредитногоСпреда / 100;
			
			РезультатПроверки = (СпредДоходности >= МинимумКредитногоСпреда) И (СпредДоходности <= МаксимумКредитногоСпреда);
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				ПараметрыРасчета = Новый Структура("Цена, Доходность, ДюрацияДней, ДюрацияЛет, ЗначениеКБД, СпредДоходности, МинимумКредитногоСпреда, МаксимумКредитногоСпреда, ПроверкаПройдена",
					СтрокаСтоимостейЦБ.Стоимость, Окр(ДоходностьИДюрация.Доходность, 10), Окр(ДоходностьИДюрация.Дюрация, 10), Окр(ДоходностьИДюрация.Дюрация / 365, 4), Окр(ЗначениеКБД, 10), Окр(СпредДоходности, 10), МинимумКредитногоСпреда, МаксимумКредитногоСпреда, РезультатПроверки);
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Проверка цены по вхождению спреда доходности к КБД в точке дюрации в диапазон кредитного спреда рейтинговой группы облигации", ПараметрыРасчета);
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;
	
	// Если ошибка, сообщаем об этом, но считаем проверку пройденой
	
	Если РезультатПроверки = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Не удалось выполнить проверку вхождения спреда доходности облигации к КБД в точке дюрации облигации в диапазон кредитного спреда рейтинговой группы облигации для цены '%1'", СтрокаСтоимостейЦБ.ЦеннаяБумага), , , , Отказ);
		Возврат Истина;
	КонецЕсли;
	
	Возврат РезультатПроверки;	

КонецФункции

Функция ПолучитьЗначенияДопустимогоОтклоненияЦеновогоИндексаОблигаций(ПараметрыОценки, ДатаПереоценки, Отказ, РасшифровкаРасчета = Неопределено)
	
	Если ПараметрыОценки.Свойство("ДопустимыеОтклоненияЦеновыхИндексов") Тогда
		Возврат ПараметрыОценки.ДопустимыеОтклоненияЦеновыхИндексов;
	КонецЕсли;
	
	// Таблицу ценовых индексов предоставляет клиент
	
	Если ПараметрыОценки.Свойство("Клиент") Тогда
		Клиент = ПараметрыОценки.Клиент;
	Иначе
		Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ПараметрыОценки.СчетДоверительногоУправления, ДатаПереоценки);
		ПараметрыОценки.Вставить("Клиент", Клиент);
	КонецЕсли;
	
	Если СокрЛП(Клиент) = "НПФ БЛАГОСОСТОЯНИЕ АО" Тогда
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БиржевыеИндексы.Код КАК КодИндекса,
			|	БиржевыеИндексы.Ссылка КАК Индекс,
			|	ВЫБОР
			|		КОГДА &ДатаПереоценки >= ДАТАВРЕМЯ(2021, 7, 1)
			|			ТОГДА ВЫБОР
			|					КОГДА БиржевыеИндексы.Код = ""RGBI""
			|						ТОГДА 0.0214
			|					КОГДА БиржевыеИндексы.Код = ""RUMBICP""
			|						ТОГДА 0.0167
			|					КОГДА БиржевыеИндексы.Код = ""RUCBICP""
			|						ТОГДА 0.008
			|				КОНЕЦ
			|		КОГДА &ДатаПереоценки >= ДАТАВРЕМЯ(2021, 1, 1)
			|			ТОГДА ВЫБОР
			|					КОГДА БиржевыеИндексы.Код = ""RGBI""
			|						ТОГДА 0.0452
			|					КОГДА БиржевыеИндексы.Код = ""RUMBICP""
			|						ТОГДА 0.0346
			|					КОГДА БиржевыеИндексы.Код = ""RUCBICP""
			|						ТОГДА 0.0209
			|				КОНЕЦ
			|		КОГДА &ДатаПереоценки >= ДАТАВРЕМЯ(2020, 7, 31)
			|			ТОГДА ВЫБОР
			|					КОГДА БиржевыеИндексы.Код = ""RGBI""
			|						ТОГДА 0.0446
			|					КОГДА БиржевыеИндексы.Код = ""RUMBICP""
			|						ТОГДА 0.037
			|					КОГДА БиржевыеИндексы.Код = ""RUCBICP""
			|						ТОГДА 0.0208
			|				КОНЕЦ
			|		ИНАЧЕ ВЫБОР
			|				КОГДА БиржевыеИндексы.Код = ""RGBI""
			|					ТОГДА 0.0156
			|				КОГДА БиржевыеИндексы.Код = ""RUMBICP""
			|					ТОГДА 0.0194
			|				КОГДА БиржевыеИндексы.Код = ""RUCBICP""
			|					ТОГДА 0.0073
			|			КОНЕЦ
			|	КОНЕЦ КАК ДопустимоеОтклонение
			|ИЗ
			|	Справочник.БиржевыеИндексы КАК БиржевыеИндексы
			|ГДЕ
			|	БиржевыеИндексы.Код В (""RGBI"", ""RUMBICP"", ""RUCBICP"")");

		Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
		
		ДопустимыеОтклоненияЦеновыхИндексов = Запрос.Выполнить().Выгрузить();		
		
	Иначе	
		
		ДопустимыеОтклоненияЦеновыхИндексов = Новый ТаблицаЗначений;
		ДопустимыеОтклоненияЦеновыхИндексов.Колонки.Добавить("КодИндекса",			 Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(Метаданные.Справочники.БиржевыеИндексы.ДлинаКода, ДопустимаяДлина.Переменная)));	
		ДопустимыеОтклоненияЦеновыхИндексов.Колонки.Добавить("Индекс",				 Новый ОписаниеТипов("СправочникСсылка.БиржевыеИндексы"));
		ДопустимыеОтклоненияЦеновыхИндексов.Колонки.Добавить("ДопустимоеОтклонение", Новый ОписаниеТипов("Число")); 
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Для клиента '%1' не заданы значения допустимого отклонения ценового индекса облигаций", Клиент), , , , Отказ);
		
	КонецЕсли;
	
	ПараметрыОценки.Вставить("ДопустимыеОтклоненияЦеновыхИндексов", ДопустимыеОтклоненияЦеновыхИндексов);
	
	Если РасшифровкаРасчета <> Неопределено Тогда 
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Допустимые отклонения ценовых индексов облигаций", ДопустимыеОтклоненияЦеновыхИндексов.Скопировать());
	КонецЕсли;
	
	Возврат ДопустимыеОтклоненияЦеновыхИндексов;
	
КонецФункции

// Возвращает последние на указанные даты цены НРД бумаг с нулевой стоимостью
//
// Параметры:
//	ТаблицаСтоимостейЦБ - ТаблицаЗначений	- таблица значений, содержащая колонки ЦеннаяБумага, Рынок, Номинал, Стоимость
//	ДатыЦен				- Дата				- дата, на которуе требуются цены НРД.
//						- Массив			- будет возвращена последняя рассчитанная цена из массива дат, входящих в массив 
//						- СтандартныйПериод	- будет возвращена последняя рассчитанная цена из дат, входящих в период 
//	РасшифровкаРасчета	- Структура			- структура расшифровки расчета
//						- Неопределено		- без расшифровки
//
// Возвращаемое значение:
//	ЦеныНРД				- ТаблицаЗначений	- таблица цен НРД
//
Функция ПолучитьЦеныНРД(ТаблицаСтоимостейЦБ, ДатыЦен, РасшифровкаРасчета = Неопределено)
	
	Запрос = Новый Запрос( 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаСтоимостейЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСтоимостейЦБ.Рынок КАК Рынок,
		|	ТаблицаСтоимостейЦБ.Номинал КАК Номинал
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	&ТаблицаСтоимостейЦБ КАК ТаблицаСтоимостейЦБ
		|ГДЕ
		|	ТаблицаСтоимостейЦБ.Стоимость = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.Рынок КАК Рынок,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	РасчетныеЦеныНРД.Период КАК ДатаЦены,
		|	ВЫБОР
		|		КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА (ВЫРАЗИТЬ(РасчетныеЦеныНРД.RATE * ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|		ИНАЧЕ РасчетныеЦеныНРД.PRICE
		|	КОНЕЦ КАК Цена,
		|	РасчетныеЦеныНРД.TYPE КАК TYPE,
		|	РасчетныеЦеныНРД.VERSION КАК VERSION,
		|	РасчетныеЦеныНРД.METHOD_NUMBER КАК METHOD_NUMBER
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				РасчетныеЦеныНРД.ЦеннаяБумага КАК ЦеннаяБумага,
		|				МАКСИМУМ(РасчетныеЦеныНРД.Период) КАК Период
		|			ИЗ
		|				РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаЦБ КАК ТаблицаЦБ
		|					ПО (ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныНРД.ЦеннаяБумага)
		|						И (ТаблицаЦБ.Рынок = РасчетныеЦеныНРД.Рынок)
		|			ГДЕ
		|				&ФильтрДат
		|			
		|			СГРУППИРОВАТЬ ПО
		|				РасчетныеЦеныНРД.ЦеннаяБумага) КАК ДатыЦенНРД
		|			ПО (ДатыЦенНРД.ЦеннаяБумага = РасчетныеЦеныНРД.ЦеннаяБумага)
		|				И (ДатыЦенНРД.Период = РасчетныеЦеныНРД.Период)
		|		ПО (РасчетныеЦеныНРД.Рынок = ТаблицаЦБ.Рынок)
		|			И (РасчетныеЦеныНРД.ЦеннаяБумага = ТаблицаЦБ.ЦеннаяБумага)");

	Если ТипЗнч(ДатыЦен) = Тип("СтандартныйПериод") Тогда
		
		ФильтрДат = "РасчетныеЦеныНРД.Период МЕЖДУ &ДатаНачала И &ДатаОкончания";
		
		Запрос.УстановитьПараметр("ДатаНачала",		ДатыЦен.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания",	ДатыЦен.ДатаОкончания);
		
	Иначе
		
		ФильтрДат = "РасчетныеЦеныНРД.Период В(&ДатыЦен)";
		
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрДат", ФильтрДат);
	
	Запрос.УстановитьПараметр("ТаблицаСтоимостейЦБ",	ТаблицаСтоимостейЦБ);
	Запрос.УстановитьПараметр("ДатыЦен",				ДатыЦен);
	
	ЦеныНРД = Запрос.Выполнить().Выгрузить();
	ЦеныНРД.Индексы.Добавить("ЦеннаяБумага");
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		МассивДат = ?(ДатыЦен = Тип("Массив"), ДатыЦен, РаботаСКоллекциями.ЗначениеВМассив(ДатыЦен));  
		
		ПредставлениеДат = Новый Массив;
		Для Каждого ДатаЦены Из МассивДат Цикл 
			ПредставлениеДат.Добавить(Формат(ДатаЦены, "ДФ=dd.MM.yyyy"));	
		КонецЦикла;
		
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Цены НРД на " + СтрСоединить(ПредставлениеДат, ", "), ЦеныНРД.Скопировать());
	КонецЕсли;
	
	Возврат ЦеныНРД;
	
КонецФункции

Функция ПроверитьЦенуНаАдекватность(ЦеннаяБумага, Цена, Дата, ПараметрыОценки, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, ПараметрыДенежногоПотока, Купон, РейтинговаяГруппа = Неопределено, КредитныйСпред = Неопределено, ДенежныйПоток = Неопределено, БезрисковаяСтавкаДоходности = Неопределено, Отказ, РасшифровкаРасчета = Неопределено)

	Если РасшифровкаРасчета <> Неопределено Тогда
		РасшифровкаФункции = Новый Структура("ЦеннаяБумага, Цена", ЦеннаяБумага, Цена);		
	КонецЕсли;
	
	ЦенаАдекватна = Ложь;	
	
	Если ТипЗнч(ЦеннаяБумага) <> Тип("СправочникСсылка.Облигации") Тогда
		
		ЦенаАдекватна = Истина;
		
	ИначеЕсли ЦеннаяБумага.УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииГосударства Тогда
		
		ЦенаАдекватна = Истина;
		
	Иначе
		
		ДатаВыкупа = Справочники.Облигации.ПолучитьДатуИЦенуВыкупа(ЦеннаяБумага, Дата, , ПараметрыОценки.СчетДоверительногоУправления).ДатаВыкупа;

		Если ДатаВыкупа < ДобавитьМесяц(Дата, 6) Тогда
			
			ЦенаАдекватна = Истина;
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				РасшифровкаФункции.Вставить("ДатаВыкупа", ДатаВыкупа);
				РасшифровкаФункции.Вставить("УсловиеАдекватности", "ДатаВыкупа < ДобавитьМесяц(ДатаПереоценки, 6)");
			КонецЕсли;
			
		Иначе
			
			ТребуетсяРасчетКредитногоСпреда = Истина;
			
			// Определеяем рейтинговую группу бумаги
			
			Если РейтинговаяГруппа = Неопределено Тогда
				РейтинговаяГруппа = РаботаСПоказателямиФинансовыхИнструментов.ОпределитьРейтинговуюГруппу(ЦеннаяБумага, Дата, ПараметрыРасчетаРейтинга, , РасшифровкаРасчета);
			КонецЕсли;

			Если Дата >= '20190801' Тогда 
				Если Не ЗначениеЗаполнено(РейтинговаяГруппа) ИЛИ РейтинговаяГруппа = 4 Тогда
					ТребуетсяРасчетКредитногоСпреда	= Ложь;
					ЦенаАдекватна					= (РейтинговаяГруппа = 4);
				КонецЕсли;
			КонецЕсли;
			
			Если ТребуетсяРасчетКредитногоСпреда Тогда 
				
				// Рассчитываем кредитный спред
				
				ОшибкаРасчета = Ложь;
				
				Если КредитныйСпред = Неопределено Тогда
					ДанныеОРейтинге = РаботаСКоллекциями.СкопироватьСтруктуру(ПараметрыРасчетаРейтинга);
					ДанныеОРейтинге.Вставить("РейтинговаяГруппа", РейтинговаяГруппа);

					КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(ЦеннаяБумага, Дата, ДанныеОРейтинге, ПараметрыРасчетаКредитногоСпреда, ОшибкаРасчета, РасшифровкаРасчета);				
				КонецЕсли;
				
				// Собственно проверка цены на адекватность
				
				Если Не ОшибкаРасчета И ТипЗнч(КредитныйСпред) = Тип("ТаблицаЗначений") И КредитныйСпред.Количество() > 0 Тогда 
					
					Если ДенежныйПоток = Неопределено Тогда
						ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ПараметрыДенежногоПотока, ПараметрыОценки, Отказ, РасшифровкаРасчета);				
						Если ДенежныйПоток = Неопределено Тогда
							Возврат Неопределено;
						КонецЕсли;
					КонецЕсли;
					
					Если БезрисковаяСтавкаДоходности = Неопределено Тогда
						БезрисковаяСтавкаДоходности	= РаботаСПоказателямиФинансовыхИнструментов.РассчитатьБезрисковуюСтавкуДоходности(ЦеннаяБумага, Дата, ДенежныйПоток, Отказ);
					КонецЕсли;	
					
					ЗначенияКредитногоСпреда = КредитныйСпред[0];
					
					МинимальнаяЦена  = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, БезрисковаяСтавкаДоходности + Окр(ЗначенияКредитногоСпреда.МаксимумКредитногоСпреда / 100, 2), Дата) - Купон, 4);
					МаксимальнаяЦена = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, БезрисковаяСтавкаДоходности + Окр(ЗначенияКредитногоСпреда.МинимумКредитногоСпреда  / 100, 2), Дата) - Купон, 4);
					
					Если МинимальнаяЦена <= Цена и Цена <= МаксимальнаяЦена //почему-то минимальная цена больше максимальной
						ИЛИ МаксимальнаяЦена <= Цена и Цена <= МинимальнаяЦена
					Тогда
						ЦенаАдекватна = Истина;
					КонецЕсли;
					
					Если РасшифровкаРасчета <> Неопределено Тогда
						РасшифровкаФункции.Вставить("БезрисковаяСтавкаДоходности",	БезрисковаяСтавкаДоходности);
						РасшифровкаФункции.Вставить("МинимальнаяЦена",				МинимальнаяЦена);
						РасшифровкаФункции.Вставить("МаксимальнаяЦена",				МаксимальнаяЦена);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РасшифровкаФункции.Вставить("ЦенаАдекватна", ЦенаАдекватна);
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расшифровка функции", "Проверка цены на адекватность", РасшифровкаФункции);		
	КонецЕсли;	
	
	Возврат ЦенаАдекватна;
	
КонецФункции

Процедура ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаЦенныеБумаги) Экспорт
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Биржа",				Справочники.Биржи.ПустаяСсылка());
	СтруктураДанных.Вставить("ИсточникЦены",		Справочники.ЮрФизЛица.ПустаяСсылка());
	СтруктураДанных.Вставить("Источник",			Справочники.ЮрФизЛица.ПустаяСсылка());
	СтруктураДанных.Вставить("ПолеЦены", 			Перечисления.ИсточникиЦеныДляПереоценки.ОшибкаРасчета);
	СтруктураДанных.Вставить("ВидЦены", 			Перечисления.ИсточникиЦеныДляПереоценки.ОшибкаРасчета);
	СтруктураДанных.Вставить("УровеньОценки",		0);
	СтруктураДанных.Вставить("ДатаКотировки",		'00010101');
	СтруктураДанных.Вставить("ДатаЦены",			'00010101');
	СтруктураДанных.Вставить("ВалютаКотировки",		СтрокаЦенныеБумаги.ВалютаНоминала);
	СтруктураДанных.Вставить("Цена",				0);
	СтруктураДанных.Вставить("Стоимость",			0);
	СтруктураДанных.Вставить("ЦенаКотировки",		0);
	СтруктураДанных.Вставить("РыночнаяЦена",		0);
	СтруктураДанных.Вставить("РыночнаяЦенаПроцент",	0);
	
	ЗаполнитьЗначенияСвойств(СтрокаЦенныеБумаги, СтруктураДанных);	
	
КонецПроцедуры

Функция ПроверитьДоступностьДанныхBloomberg(ДатаПереоценки)
	
	Возврат (ДатаПереоценки <= '20220403'); // #428359	
	
КонецФункции

Процедура УведомитьОбОтсутствииАналогов(ЦеннаяБумага, ПараметрыОценки, ДатаПереоценки)

	// Уведомим, что нет аналогов и оценка будет выполнена на следующем уровне методике
	
	ПолноеИмяИсточника 	= "Документ.РегистрацияСтоимостиАктивов.ЗаполнитьДокументыРегистрацииСтоимости.ОповещениеОбОтсутствииАналогов";
	Тема				= СтрШаблон("Оценка '%1' на %2 в '%3' при отсутствии аналогов", ЦеннаяБумага, Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy"), ПараметрыОценки.СчетДоверительногоУправления);
	Текст				= СтрШаблон("У бумаги '%1' на %2 для '%3' отсутствуют зарегистрированные аналоги или оценка по ним не может быть выполнена. Справедливая стоимость бумаги будет оценена согласно методике по цене с меньшим приоритетом.", ЦеннаяБумага, Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy"), ПараметрыОценки.Клиент);
	
	ДобавитьУведомление(ПараметрыОценки, ПолноеИмяИсточника, Тема, Текст);	
	
КонецПроцедуры

Процедура УведомитьОбОценкеПоЦенеBloombergBVAL(ЦеннаяБумага, ПараметрыОценки, ДатаПереоценки)

	// Уведомим, что выполнена оценка по BVAL и необходимо проверить Score
	
	ПолноеИмяИсточника 	= "Документ.РегистрацияСтоимостиАктивов.ЗаполнитьДокументыРегистрацииСтоимости.ОповещениеОбОценкеПоЦенеBloombergBVAL";
	Тема				= СтрШаблон("Оценка '%1' на %2 в '%3' по цене Bloomberg BVAL", ЦеннаяБумага, Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy"), ПараметрыОценки.СчетДоверительногоУправления);
	Текст				= СтрШаблон("Для ""%1"" за %2 применена котировка Bloomberg BVAL. Убедитесь, что Score >= 6!", ЦеннаяБумага, Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy"));
	
	ДобавитьУведомление(ПараметрыОценки, ПолноеИмяИсточника, Тема, Текст);	
	
КонецПроцедуры

Процедура УведомитьОбОтсутствииЦены(МассивЦенныхБумаг, ПараметрыОценки, ДатаПереоценки)

	Если МассивЦенныхБумаг.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Уведомим, что у ценных бумаг нет цен на дату переоценки 
	
	ПолноеИмяИсточника 	= "Документ.РегистрацияСтоимостиАктивов.ЗаполнитьДокументыРегистрацииСтоимости.ОповещениеОбОтсутствииЦены";
	Тема				= СтрШаблон("Отсутствуют цены на %1 по '%2'", Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy"), ПараметрыОценки.СчетДоверительногоУправления);
	
	Текст = СтрШаблон("Отсутствуют цены на %1 по счету ДУ '%2' у ценных бумаг:" + Символы.ПС + "%3",
		Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy"),
		ПараметрыОценки.СчетДоверительногоУправления,
		СтрСоединить(МассивЦенныхБумаг, Символы.ПС));
	
	ДобавитьУведомление(ПараметрыОценки, ПолноеИмяИсточника, Тема, Текст);	
	
КонецПроцедуры

Процедура УведомитьОНеобходимостиПроверитьАктуальностьИспользованногоЗначенияКБДИностранныхОблигаций(ПараметрыОценки, ДатаПереоценки)

	Если Не ПараметрыОценки.Свойство("ДополнительныеСвойства")
		ИЛИ ТипЗнч(ПараметрыОценки.ДополнительныеСвойства) <> Тип("Структура")
		ИЛИ Не ПараметрыОценки.ДополнительныеСвойства.Свойство("ИспользованныеКБД")
		ИЛИ ПараметрыОценки.ДополнительныеСвойства.ИспользованныеКБД.Количество() = 0
	Тогда
		Возврат;
	КонецЕсли;
	
	ПолноеИмяИсточника 	= "Документ.РегистрацияСтоимостиАктивов.ЗаполнитьДокументыРегистрацииСтоимости.ОповещениеОбОценкеСИспользованиемСтарогоЗначенияКБДИностранныхОблигаций";
	Тема				= СтрШаблон("Расчет СЧА '%1' за %2 с использованием значений КБД ин.государств", ПараметрыОценки.СчетДоверительногоУправления, Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy"));
	
	Текст = "При оценке бумаг были использованы ставки КБД иностранных государств, действующие до даты оценки. Необходимо проверить их актуальность.";
	
	Для каждого КлючЗначение Из ПараметрыОценки.ДополнительныеСвойства.ИспользованныеКБД Цикл
		Текст = Текст + Символы.ПС + СтрШаблон("- %1: '%2'", КлючЗначение.Ключ, СтрСоединить(КлючЗначение.Значение, "', '"));
	КонецЦикла; 
	
	ДобавитьУведомление(ПараметрыОценки, ПолноеИмяИсточника, Тема, Текст);	
	
	ПолноеИмяИсточника 	= "Обработка.ФормированиеБухгалтерскогоУчета.РассчитатьСтоимостиПереоценки.ОповещениеОбОценкеСИспользованиемСтарогоЗначенияКБДИностранныхОблигаций";
	
	ЦельРасчета = Неопределено;
	ВидУчета = Неопределено;
	ПараметрыОценки.Свойство("ЦельРасчета", ЦельРасчета);
	ПараметрыОценки.Свойство("ВидУчета", ВидУчета);
	
	// Косвенный признак того что данная переоценка была вызвана из Формирования бухгалтерского учета в режиме формирования ЕПС
	Если ЦельРасчета = Справочники.ЦелиРасчета.ЕдиныйПланСчетов И ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		ДобавитьУведомление(ПараметрыОценки, ПолноеИмяИсточника, Тема, Текст);	
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьУведомление(ПараметрыОценки, ПолноеИмяИсточника, Тема, Текст)

	КонтрольСЧА = ПараметрыОценки.Свойство("ДополнительныеСвойства") И ТипЗнч(ПараметрыОценки.ДополнительныеСвойства) = Тип("Структура") И ПараметрыОценки.ДополнительныеСвойства.Свойство("КонтрольСЧА");
	
	Если Не КонтрольСЧА Тогда
		
		Если ПараметрыОценки.Свойство("ДополнительныеСвойства") И ТипЗнч(ПараметрыОценки.ДополнительныеСвойства) = Тип("Структура") Тогда
			
			ДополнительныеСвойства = ПараметрыОценки.ДополнительныеСвойства;
			
			Если Не ДополнительныеСвойства.Свойство("Оповещения") Тогда
				ДополнительныеСвойства.Вставить("Оповещения", Новый Массив);	
			ИначеЕсли ОповещениеЕстьВМассивеОповещений(ДополнительныеСвойства.Оповещения, Текст) Тогда 
				Возврат;
			КонецЕсли;
			
			РеквизитыОповещения = Новый Структура("Организация, Тема, Текст");
			РеквизитыОповещения.Организация	= ПараметрыОценки.Организация;
			РеквизитыОповещения.Тема		= Тема;
			РеквизитыОповещения.Текст		= Текст;
			
			Оповещение = Новый Структура;
			Оповещение.Вставить("ПолноеИмяИсточника",	ПолноеИмяИсточника);
			Оповещение.Вставить("ТипСобытия",			Перечисления.ТипыСобытий.ВнешнийВызов);
			Оповещение.Вставить("РеквизитыОповещения",	РеквизитыОповещения);
			
			ДополнительныеСвойства.Оповещения.Добавить(Оповещение);
			
		КонецЕсли;
				
	КонецЕсли;
	
КонецПроцедуры

Функция ОповещениеЕстьВМассивеОповещений(МассивОповещений, ТекстОповещения)
	
	Для Каждого Оповещение Из МассивОповещений Цикл
		Если Оповещение.РеквизитыОповещения.Текст = ТекстОповещения Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Процедура ЗаполнитьЦенамиПокупкиПриОтсутствииУчетаНаПартиях(ДатаПереоценки, ТаблицаСтоимостейЦБ, СтрокиДляДозаполненияИзПартий, ПараметрыОценки, РасшифровкаРасчета = Неопределено)
	
	#Область Получение_партий		
		
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Если Не ПараметрыОценки.ДополнительныеСвойства.Свойство("РасчетПартий") Тогда
		ПараметрыОценки.ДополнительныеСвойства.Вставить("РасчетПартий", Неопределено);		
	КонецЕсли;	
	
	ПараметрыОценки.ПараметрыПолученияПартий.УчестьБумагиПоРЕПО = Истина;
	
	ОписаниеОбъекта = Новый Структура("ЦельРасчета, ВидУчета, Организация, СчетДоверительногоУправления, Ссылка, Дата",
		ПараметрыОценки.ПараметрыПолученияПартий.ЦельРасчета,
		ПараметрыОценки.ПараметрыПолученияПартий.ВидУчета,
		ПараметрыОценки.Организация,
		ПараметрыОценки.СчетДоверительногоУправления,
		Документы.РегистрацияСтоимостиПереоценки.ПустаяСсылка(),
		КонецДня(ДатаПереоценки));
	
	РаботаСПереоценкой.ПолучитьЦенныеБумаги(
		ОписаниеОбъекта, МенеджерВТ, "ТаблицаПартийЦБ", ПараметрыОценки.ПараметрыПолученияПартий, ПараметрыОценки.ДополнительныеСвойства.РасчетПартий, , РасшифровкаРасчета);
	
	ЗапросПартий = Новый Запрос;
	ЗапросПартий.МенеджерВременныхТаблиц = МенеджерВТ;
	ЗапросПартий.Текст = 	
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	ТаблицаПартийЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	    |	ТаблицаПартийЦБ.Рынок КАК Рынок,
	    |	ТаблицаПартийЦБ.Партия КАК Партия,
	    |	ТаблицаПартийЦБ.СтрокаПартии КАК СтрокаПартии,
	    |	ТаблицаПартийЦБ.Количество КАК Количество,
	    |	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка) КАК УчетныйАктивЕПС,
	    |	0 КАК НомерСтроки
	    |ИЗ
	    |	ТаблицаПартийЦБ КАК ТаблицаПартийЦБ";
	
	#КонецОбласти
	
	ТаблицаПартий		= ЗапросПартий.Выполнить().Выгрузить();
	ДатыПокупкиИЦены	= БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(ТаблицаПартий, ПараметрыОценки.СчетДоверительногоУправления, ДатаПереоценки, Ложь).Выгрузить();		
			
	Для Каждого СтрокаСтоимостейЦБ Из СтрокиДляДозаполненияИзПартий Цикл
		
		ДатыПокупкиИЦеныЦеннойБумаги = ДатыПокупкиИЦены.НайтиСтроки(Новый Структура("ЦеннаяБумага", СтрокаСтоимостейЦБ.ЦеннаяБумага));
		Если ДатыПокупкиИЦеныЦеннойБумаги.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		#Область Получение_цены_приобретения
		
		// по задаче #529101 у Скороходова А.А. на партиях была произведена замена "CBOM Finance p.l.c., XS1964558339, 1000.00 USD" на "Московский Кредитный Банк ПАО, 4-20-01978-B, 1000.00 USD"
		// поэтому, по задаче #533010 делаю обратную подмену для целей СЧА и ИД
		Если ПараметрыОценки.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_СкороходовАА")
			И СтрокаСтоимостейЦБ.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_МКБ_020") Тогда
		
			ТекСтрокаДатИЦен = Новый Структура("ДатаПокупки, ЦеннаяБумага, ЦенаПокупки, НоминалПриПокупке, НоминалТекущий",
				'20240313151301', СтрокаСтоимостейЦБ.ЦеннаяБумага, 1005.08979795735, 1000, 1000);
			
		Иначе
			// Если сделок было несколько, цены покупки могут различаться,
			// значит нужно, чтобы оценка шла в разрезе партий, а это не реализовано.
			ТекСтрокаДатИЦен = ДатыПокупкиИЦеныЦеннойБумаги[0];	
		КонецЕсли;
		
		СтрокаСтоимостейЦБ.Источник			= Справочники.ЮрФизЛица.ПустаяСсылка();
		СтрокаСтоимостейЦБ.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.ЦенаПриобретения;
		СтрокаСтоимостейЦБ.ДатаЦены			= ТекСтрокаДатИЦен.ДатаПокупки;
		СтрокаСтоимостейЦБ.УровеньОценки	= 1;
		СтрокаСтоимостейЦБ.ВалютаКотировки	= СтрокаСтоимостейЦБ.ВалютаНоминала;
		
		Если ТипЗнч(ТекСтрокаДатИЦен.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
			СтрокаСтоимостейЦБ.Стоимость = ТекСтрокаДатИЦен.ЦенаПокупки * ТекСтрокаДатИЦен.НоминалТекущий / ТекСтрокаДатИЦен.НоминалПриПокупке;
		Иначе
			СтрокаСтоимостейЦБ.Стоимость = ТекСтрокаДатИЦен.ЦенаПокупки;
		КонецЕсли;
			
		#КонецОбласти
	
	КонецЦикла;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "Таблица стоимостей ЦБ (по данным партий)", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьЦеннуюБумагуВДополнительныеСвойстваОценки(ПараметрыОценки, ЦеннаяБумага, КлючСвойства, КлючГруппыБумаг)	
	
	Если Не ПараметрыОценки.Свойство("ДополнительныеСвойства") ИЛИ ПараметрыОценки.ДополнительныеСвойства = Неопределено Тогда
		ПараметрыОценки.Вставить("ДополнительныеСвойства", Новый Структура);
	КонецЕсли;

	Если Не ПараметрыОценки.ДополнительныеСвойства.Свойство(КлючСвойства) Тогда
		ПараметрыОценки.ДополнительныеСвойства.Вставить(КлючСвойства, Новый Соответствие);
	КонецЕсли;

	Свойство = ПараметрыОценки.ДополнительныеСвойства[КлючСвойства];
	Бумаги	 = Свойство.Получить(КлючГруппыБумаг);

	Если Бумаги = Неопределено Тогда
		Бумаги = Новый Массив;
		Свойство.Вставить(КлючГруппыБумаг, Бумаги);
	КонецЕсли;

	Если Бумаги.Найти(ЦеннаяБумага) = Неопределено Тогда
		Бумаги.Добавить(ЦеннаяБумага);
	КонецЕсли;
	
КонецПроцедуры

// Добавляет уведомление, что необходимо проверить отсутствие более приоритетных цен,
// если есть бумаги, оцененные по цене с меньшим приоритетом согласно методике
//
// Параметры:
//	ПараметрыОценки	- Структура - см. РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС
//  ДатаПереоценки	- Дата		- дата переоценки
//
Процедура УведомитьОНеобходимостиПроверитьОтсутствиеЦенБолееВысокогоПриоритета(ПараметрыОценки, ДатаПереоценки)

	Если Не ПараметрыОценки.Свойство("ДополнительныеСвойства")
		ИЛИ ТипЗнч(ПараметрыОценки.ДополнительныеСвойства) <> Тип("Структура")
		ИЛИ Не ПараметрыОценки.ДополнительныеСвойства.Свойство("ОценкиПоЦенеСМеньшимПриоритетом")
		ИЛИ ПараметрыОценки.ДополнительныеСвойства.ОценкиПоЦенеСМеньшимПриоритетом.Количество() = 0
	Тогда
		Возврат;
	КонецЕсли;

	ПолноеИмяИсточника 	= "Документ.РегистрацияСтоимостиАктивов.ЗаполнитьДокументыРегистрацииСтоимости.ОповещениеОбОценкеПоЦенеСМеньшимПриоритетом";
	Тема				= СтрШаблон("Расчет СЧА '%1' за %2 с оценкой по ценам с меньшим приоритетом", ПараметрыОценки.СчетДоверительногоУправления, Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy"));

	Текст = "Оценка бумаг выполнена по ценам с меньшим приоритетом. Необходимо проверить отсутствие следующих цен, указанных перед ними в методике:";
	
	Для каждого КлючЗначение Из ПараметрыОценки.ДополнительныеСвойства.ОценкиПоЦенеСМеньшимПриоритетом Цикл
		Текст = Текст + Символы.ПС + СтрШаблон("- %1: '%2'", КлючЗначение.Ключ, СтрСоединить(КлючЗначение.Значение, "', '"));
	КонецЦикла; 
	
	ДобавитьУведомление(ПараметрыОценки, ПолноеИмяИсточника, Тема, Текст);	
	
КонецПроцедуры

#КонецОбласти

#Область Заполнить_переоценку

Процедура ЗаполнитьПереоценкуАтомфонда(СтрокаПереоценкиЦБ, ДатаПереоценки, ОбъектДокумента, Отказ) Экспорт
	
	Если СтрокаПереоценкиЦБ.РыночнаяЦена = 0 И СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.ПустаяСсылка() Тогда
		
		ДатаРасчетаКредитногоСпреда = БухгалтерскийУчетЕПС.ОпределитьДатуПокупкиПартии(СтрокаПереоценкиЦБ.Партия, СтрокаПереоценкиЦБ.СтрокаПартии);
		Если ДатаПереоценки = НачалоДня(КонецМесяца(ДатаПереоценки)) И ДатаРасчетаКредитногоСпреда < ДатаПереоценки Тогда 
			ДатаРасчетаКредитногоСпреда = ДатаПереоценки
		ИначеЕсли ДатаРасчетаКредитногоСпреда < НачалоМесяца(ДатаПереоценки) - 24*60*60 Тогда
			ДатаРасчетаКредитногоСпреда = НачалоМесяца(ДатаПереоценки) - 24*60*60
		КонецЕсли;
		
		ЦеннаяБумага = СтрокаПереоценкиЦБ.ЦеннаяБумага;
		МассивИноставнныхАктивов = Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();
		ЭтоИностраннаяЦБ = МассивИноставнныхАктивов.Найти(ЦеннаяБумага.УчетныйАктивЦБРФ) <> Неопределено ИЛИ СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И ЦеннаяБумага.Подкатегория = Перечисления.ВидыГосударственныхОблигаций.ОВОЗ;
		
		ПараметрыРасчетаРейтинга = ПолучитьПараметрыРасчетаРейтингаПоУмолчанию(ОбъектДокумента.СчетДоверительногоУправления, ДатаПереоценки);
		ПараметрыРасчетаРейтинга.Вставить("ИсточникТаблицыСоответствияРейтингов",	Справочники.ВнешниеСистемы.Атом_РасчетСС);
		ПараметрыРасчетаРейтинга.Вставить("ТолькоНаблюдаемыеДанные",				Истина);
		ПараметрыРасчетаРейтинга.Вставить("ТолькоЭмитент",							Истина);
		
		ПараметрыРасчетаКредитногоСпреда = Новый Структура;
		ПараметрыРасчетаКредитногоСпреда.Вставить("ОтклонениеКредитногоСпреда", 50); //указано в учетной политике
	
		//2.с - только для долговых российских бумаг. Для иностранных ЦБ пропускается. 
		Если СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И НЕ ЭтоИностраннаяЦБ Тогда
			КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(ЦеннаяБумага, ДатаРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, Отказ);
			Если КредитныйСпред.Количество() > 0 Тогда
				
				ПараметрыДенежногоПотока = Новый Структура;
				ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",	Ложь);
				ПараметрыДенежногоПотока.Вставить("Дата",				ДатаПереоценки);
				ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",		ДатаПереоценки);
				
				ДенежныйПоток				= Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ПараметрыДенежногоПотока, ОбъектДокумента, Отказ);
				БезрисковаяСтавкаДоходности = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьБезрисковуюСтавкуДоходности(ЦеннаяБумага, ДатаПереоценки, ДенежныйПоток, Отказ);
				
				ЗначенияКредитногоСпреда			= КредитныйСпред[0];
				НаблюдаемоеЗначениеКредитногоСпреда	= ЗначенияКредитногоСпреда.Медиана;
				СтавкаДисконтирования				= Окр(БезрисковаяСтавкаДоходности + НаблюдаемоеЗначениеКредитногоСпреда / 100, 2);
				
				Цена = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтавкаДисконтирования, ДатаПереоценки)
					- Справочники.Облигации.ПолучитьКупон(ЦеннаяБумага,ДатаПереоценки, ОбъектДокумента.СчетДоверительногоУправления), 4);
				
				Если Цена > 0 Тогда
					
					СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
					СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
					СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
					СтрокаПереоценкиЦБ.УровеньОценки = 2;
					СтрокаПереоценкиЦБ.ДатаКотировки = ДатаПереоценки;
					
					СтрокаПереоценкиЦБ.РыночнаяЦена = Цена;
					СтрокаПереоценкиЦБ.ЦенаКотировки = Цена;
					СтрокаПереоценкиЦБ.ВалютаКотировки = СтрокаПереоценкиЦБ.ЦеннаяБумага.ВалютаНоминала;
					//СтрокаПереоценкиЦБ.РыночнаяСумма = СтрокаПереоценкиЦБ.РыночнаяЦена * СтрокаПереоценкиЦБ.Количество;
					
					//СтрокаПереоценкиЦБ.ОценочнаяЦена = СтрокаПереоценкиЦБ.РыночнаяЦена;
					//СтрокаПереоценкиЦБ.ОценочнаяСумма = СтрокаПереоценкиЦБ.РыночнаяСумма;
					
					Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
						
						СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = Цена / Справочники.Облигации.ПолучитьНоминал(ЦеннаяБумага, ДатаПереоценки) * 100;
						//СтрокаПереоценкиЦБ.ОценочнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент;
						
					КонецЕсли;
					
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		//3.а
		Если СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Паи И НЕ ЭтоИностраннаяЦБ Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена КАК РасчетнаяЦена,
				|	РасчетныеЦеныПаевСрезПоследних.Период КАК Период,
				|	РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо КАК ПИФ
				|ИЗ
				|	РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &Ссылка) КАК РасчетныеЦеныПаевСрезПоследних
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
				|		ПО РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага = Паи.Ссылка
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФСрезПоследних
				|		ПО (ВЫРАЗИТЬ(РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
				|ГДЕ
				|	Паи.Ссылка = &Ссылка";
			
			Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
			Запрос.УстановитьПараметр("Ссылка", ЦеннаяБумага);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ИсточникЦены = ВыборкаДетальныеЗаписи.ПИФ;
				СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.СЧА;
				СтрокаПереоценкиЦБ.УровеньОценки = 3;//возможен 2?
				СтрокаПереоценкиЦБ.ДатаКотировки = ВыборкаДетальныеЗаписи.Период;
				
				СтрокаПереоценкиЦБ.РыночнаяЦена = ВыборкаДетальныеЗаписи.РасчетнаяЦена;
				СтрокаПереоценкиЦБ.ЦенаКотировки = ВыборкаДетальныеЗаписи.РасчетнаяЦена;
				СтрокаПереоценкиЦБ.ВалютаКотировки = ЦеннаяБумага.ВалютаНоминала;
				//СтрокаПереоценкиЦБ.РыночнаяСумма = СтрокаПереоценкиЦБ.РыночнаяЦена * СтрокаПереоценкиЦБ.Количество;
				
				//СтрокаПереоценкиЦБ.ОценочнаяЦена = СтрокаПереоценкиЦБ.РыночнаяЦена;
				//СтрокаПереоценкиЦБ.ОценочнаяСумма = СтрокаПереоценкиЦБ.РыночнаяСумма;
				
				Возврат;
			КонецЦикла;
			
		КонецЕсли;
		
		//3.с (как 2.с, но по кредитному спреду бумаги, а не эмитента)
		ПараметрыРасчетаРейтинга.ТолькоЭмитент = Ложь;
		
		КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(ЦеннаяБумага, ДатаРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, Отказ);
		Если КредитныйСпред.Количество() > 0 Тогда
			
			ПараметрыДенежногоПотока = Новый Структура;
			ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",	Ложь);
			ПараметрыДенежногоПотока.Вставить("Дата",				ДатаПереоценки);
			ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",		ДатаПереоценки);

			ДенежныйПоток				= Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ПараметрыДенежногоПотока, ОбъектДокумента, Отказ);
			БезрисковаяСтавкаДоходности	= РаботаСПоказателямиФинансовыхИнструментов.РассчитатьБезрисковуюСтавкуДоходности(ЦеннаяБумага, ДатаПереоценки, ДенежныйПоток, Отказ);
			
			ЗначенияКредитногоСпреда			= КредитныйСпред[0];
			НаблюдаемоеЗначениеКредитногоСпреда = ЗначенияКредитногоСпреда.Медиана;
			СтавкаДисконтирования				= Окр(БезрисковаяСтавкаДоходности + НаблюдаемоеЗначениеКредитногоСпреда / 100, 2);
			
			Цена = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтавкаДисконтирования, ДатаПереоценки)
				- Справочники.Облигации.ПолучитьКупон(ЦеннаяБумага, ДатаПереоценки, ОбъектДокумента.СчетДоверительногоУправления), 4);
			
			Если Цена > 0 Тогда
				
				СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
				СтрокаПереоценкиЦБ.УровеньОценки = 3;
				СтрокаПереоценкиЦБ.ДатаКотировки = ДатаПереоценки;
				
				СтрокаПереоценкиЦБ.РыночнаяЦена = Цена;
				СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
				СтрокаПереоценкиЦБ.ВалютаКотировки = ЦеннаяБумага.ВалютаНоминала;
				//СтрокаПереоценкиЦБ.РыночнаяСумма = СтрокаПереоценкиЦБ.РыночнаяЦена * СтрокаПереоценкиЦБ.Количество;
				
				//СтрокаПереоценкиЦБ.ОценочнаяЦена = СтрокаПереоценкиЦБ.РыночнаяЦена;
				//СтрокаПереоценкиЦБ.ОценочнаяСумма = СтрокаПереоценкиЦБ.РыночнаяСумма;
				
				Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
					
					СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = Цена / Справочники.Облигации.ПолучитьНоминал(ЦеннаяБумага, ДатаПереоценки) * 100;
					//СтрокаПереоценкиЦБ.ОценочнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент;
					
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
		
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьПереоценкуАтомфонда2018(СтрокаПереоценкиЦБ, ДатаПереоценки, ОбъектДокумента, ПремииЗаСубординированность, НастройкиУчета, Отказ, РасшифровкаРасчета = Неопределено) Экспорт
	
	Если СтрокаПереоценкиЦБ.РыночнаяЦена <> 0 ИЛИ СтрокаПереоценкиЦБ.ПолеЦены <> Перечисления.ИсточникиЦеныДляПереоценки.ПустаяСсылка() Тогда
		Возврат;	
	КонецЕсли;		

	// #ТехническийДолг тут сбер частично прав - купон-то не определен еще...
	УчитыватьКупонКОферте = Истина;
	Если ДатаПереоценки < '20180328'
		И СокрЛП(СтрокаПереоценкиЦБ.ЦеннаяБумага.Наименование) = "РЖД ОАО, 4-42-65045-D, 1000.00 RUB"
	Тогда
		УчитыватьКупонКОферте = Ложь; 
	КонецЕсли;
		
	ДатаРасчетаКредитногоСпреда = ДатаПереоценки;
	
	ЦеннаяБумага = СтрокаПереоценкиЦБ.ЦеннаяБумага;
	МассивИноставнныхАктивов = Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();
	ЭтоИностраннаяЦБ = МассивИноставнныхАктивов.Найти(ЦеннаяБумага.УчетныйАктивЦБРФ) <> Неопределено ИЛИ СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И ЦеннаяБумага.Подкатегория = Перечисления.ВидыГосударственныхОблигаций.ОВОЗ;
	
	ПараметрыРасчетаРейтинга = ПолучитьПараметрыРасчетаРейтингаПоУмолчанию(ОбъектДокумента.СчетДоверительногоУправления, ДатаПереоценки);
	ПараметрыРасчетаРейтинга.Вставить("ИсточникТаблицыСоответствияРейтингов",	Справочники.ВнешниеСистемы.Атом_РасчетСС);
	ПараметрыРасчетаРейтинга.Вставить("ТолькоНаблюдаемыеДанные",				Истина);
	ПараметрыРасчетаРейтинга.Вставить("ТолькоЭмитент",							Ложь);
	
	ПараметрыРасчетаКредитногоСпреда = Новый Структура;
	ПараметрыРасчетаКредитногоСпреда.Вставить("ОтклонениеКредитногоСпреда",		50); //указано в учетной политике
	ПараметрыРасчетаКредитногоСпреда.Вставить("ПремииЗаСубординированность",	ПремииЗаСубординированность);	
	
	ПараметрыДенежногоПотока = Новый Структура;
	ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",								Ложь);
	ПараметрыДенежногоПотока.Вставить("Дата",											ДатаПереоценки);
	ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",									КонецДня(ДатаПереоценки));
	ПараметрыДенежногоПотока.Вставить("УчитыватьКупонКОферте",							УчитыватьКупонКОферте);
	ПараметрыДенежногоПотока.Вставить("УчитыватьИзмененениеКупонаСНаступленияПериода",	Истина);				
	
	//2.с - только для долговых российских бумаг. Для иностранных ЦБ пропускается. 
	Если СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И НЕ ЭтоИностраннаяЦБ Тогда
		
		КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(ЦеннаяБумага, ДатаРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, Отказ, РасшифровкаРасчета); 
		
		Если КредитныйСпред.Количество() > 0 Тогда
			
			ДенежныйПоток				= Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ПараметрыДенежногоПотока, ОбъектДокумента.СчетДоверительногоУправления, Отказ, РасшифровкаРасчета);
			БезрисковаяСтавкаДоходности	= РаботаСПоказателямиФинансовыхИнструментов.РассчитатьБезрисковуюСтавкуДоходности(ЦеннаяБумага, ДатаПереоценки, ДенежныйПоток, Отказ);
			
			ЗначенияКредитногоСпреда			= КредитныйСпред[0];
			НаблюдаемоеЗначениеКредитногоСпреда	= ЗначенияКредитногоСпреда.Медиана;
			СтавкаДисконтирования				= Окр(БезрисковаяСтавкаДоходности + НаблюдаемоеЗначениеКредитногоСпреда / 100, 2);
			
			Цена = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтавкаДисконтирования, ДатаПереоценки)
				- Справочники.Облигации.ПолучитьКупон(ЦеннаяБумага, ДатаПереоценки, ОбъектДокумента.СчетДоверительногоУправления), 4);
			
			Если Цена > 0 Тогда
				
				СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
				СтрокаПереоценкиЦБ.УровеньОценки = 2;
				СтрокаПереоценкиЦБ.ДатаКотировки = ДатаПереоценки;
				
				СтрокаПереоценкиЦБ.РыночнаяЦена = Цена;
				СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
				СтрокаПереоценкиЦБ.ВалютаКотировки = ЦеннаяБумага.ВалютаНоминала;
				//СтрокаПереоценкиЦБ.РыночнаяСумма = СтрокаПереоценкиЦБ.РыночнаяЦена * СтрокаПереоценкиЦБ.Количество;
				
				//СтрокаПереоценкиЦБ.ОценочнаяЦена = СтрокаПереоценкиЦБ.РыночнаяЦена;
				//СтрокаПереоценкиЦБ.ОценочнаяСумма = СтрокаПереоценкиЦБ.РыночнаяСумма;
				
				Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
					СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = Цена / Справочники.Облигации.ПолучитьНоминал(ЦеннаяБумага, ДатаПереоценки) * 100;
					//СтрокаПереоценкиЦБ.ОценочнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент;
				КонецЕсли;
				
				Если РасшифровкаРасчета <> Неопределено Тогда
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка Атомфонда 2018", "Денежный поток", ДенежныйПоток.Скопировать());
					
					ПараметрыРасчетаЦен = Новый Структура("МедианаКредитногоСпреда, БезрисковаяСтавкаДоходности, НаблюдаемоеЗначениеКредитногоСпреда, Цена", ЗначенияКредитногоСпреда.Медиана, БезрисковаяСтавкаДоходности, НаблюдаемоеЗначениеКредитногоСпреда, Цена);
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка Атомфонда 2018", "Параметры расчета цены", ПараметрыРасчетаЦен);
				КонецЕсли;
				
				Возврат;

			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	//3.а
	Если СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Паи И НЕ ЭтоИностраннаяЦБ Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена КАК РасчетнаяЦена,
			|	РасчетныеЦеныПаевСрезПоследних.Период КАК Период,
			|	РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо КАК ПИФ
			|ИЗ
			|	РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &Ссылка) КАК РасчетныеЦеныПаевСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
			|		ПО РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага = Паи.Ссылка
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФСрезПоследних
			|		ПО (ВЫРАЗИТЬ(РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
			|ГДЕ
			|	Паи.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
		Запрос.УстановитьПараметр("Ссылка", ЦеннаяБумага);
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда

			СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
			СтрокаПереоценкиЦБ.ИсточникЦены = ВыборкаДетальныеЗаписи.ПИФ;
			СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.СЧА;
			СтрокаПереоценкиЦБ.УровеньОценки = 3;//возможен 2?
			СтрокаПереоценкиЦБ.ДатаКотировки = ВыборкаДетальныеЗаписи.Период;
			
			СтрокаПереоценкиЦБ.РыночнаяЦена = ВыборкаДетальныеЗаписи.РасчетнаяЦена;
			СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
			СтрокаПереоценкиЦБ.ВалютаКотировки = ЦеннаяБумага.ВалютаНоминала;
			//СтрокаПереоценкиЦБ.РыночнаяСумма = СтрокаПереоценкиЦБ.РыночнаяЦена * СтрокаПереоценкиЦБ.Количество;
			
			//СтрокаПереоценкиЦБ.ОценочнаяЦена = СтрокаПереоценкиЦБ.РыночнаяЦена;
			//СтрокаПереоценкиЦБ.ОценочнаяСумма = СтрокаПереоценкиЦБ.РыночнаяСумма;
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				ПараметрыРасчетаЦен = Новый Структура("Примечание, РасчетнаяЦена", "Расчетная цена пая", ВыборкаДетальныеЗаписи.РасчетнаяЦена);
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка Атомфонда 2018", "Параметры расчета цены", ПараметрыРасчетаЦен);
			КонецЕсли;
			
			Возврат;

		КонецЕсли;
		
	КонецЕсли;
	
	//3.с (как 2.с, но по кредитному спреду бумаги, а не эмитента)
	КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(ЦеннаяБумага, ДатаРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, Отказ, РасшифровкаРасчета);
	
	Если КредитныйСпред.Количество() > 0 Тогда
		
		ДенежныйПоток				= Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ПараметрыДенежногоПотока, ОбъектДокумента.СчетДоверительногоУправления, Отказ, РасшифровкаРасчета);
		БезрисковаяСтавкаДоходности	= РаботаСПоказателямиФинансовыхИнструментов.РассчитатьБезрисковуюСтавкуДоходности(ЦеннаяБумага, ДатаПереоценки, ДенежныйПоток, Отказ);
	
		ЗначенияКредитногоСпреда			= КредитныйСпред[0];
		НаблюдаемоеЗначениеКредитногоСпреда	= ЗначенияКредитногоСпреда.Медиана;
		СтавкаДисконтирования				= Окр(БезрисковаяСтавкаДоходности + НаблюдаемоеЗначениеКредитногоСпреда / 100, 2);
		
		Цена = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтавкаДисконтирования, ДатаПереоценки)
			- Справочники.Облигации.ПолучитьКупон(ЦеннаяБумага, ДатаПереоценки, ОбъектДокумента.СчетДоверительногоУправления), 4);
		
		Если Цена > 0 Тогда
			
			СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
			СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
			СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
			СтрокаПереоценкиЦБ.УровеньОценки = 3;
			СтрокаПереоценкиЦБ.ДатаКотировки = ДатаПереоценки;
			
			СтрокаПереоценкиЦБ.РыночнаяЦена = Цена;
			СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
			СтрокаПереоценкиЦБ.ВалютаКотировки = ЦеннаяБумага.ВалютаНоминала;
			//СтрокаПереоценкиЦБ.РыночнаяСумма = СтрокаПереоценкиЦБ.РыночнаяЦена * СтрокаПереоценкиЦБ.Количество;
			
			//СтрокаПереоценкиЦБ.ОценочнаяЦена = СтрокаПереоценкиЦБ.РыночнаяЦена;
			//СтрокаПереоценкиЦБ.ОценочнаяСумма = СтрокаПереоценкиЦБ.РыночнаяСумма;
			
			Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
				СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = Цена / Справочники.Облигации.ПолучитьНоминал(ЦеннаяБумага, ДатаПереоценки) * 100;
				//СтрокаПереоценкиЦБ.ОценочнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент;
			КонецЕсли;
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка Атомфонда 2018", "Денежный поток", ДенежныйПоток.Скопировать());
				
				ПараметрыРасчетаЦен = Новый Структура("МедианаКредитногоСпреда, БезрисковаяСтавкаДоходности, НаблюдаемоеЗначениеКредитногоСпреда, Цена", ЗначенияКредитногоСпреда.Медиана, БезрисковаяСтавкаДоходности, НаблюдаемоеЗначениеКредитногоСпреда, Цена);
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка Атомфонда 2018", "Параметры расчета цены", ПараметрыРасчетаЦен);
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЕсли;
			
КонецПроцедуры

Процедура ЗаполнитьПереоценкуБлагосостояния(СтрокаПереоценкиЦБ, ДатаПереоценки, ОбъектДокумента, РасшифровкаРасчета = Неопределено) Экспорт
	
	//оценим несущественность, если нет цены и возьмем bid или ask
	
	Если СтрокаПереоценкиЦБ.УровеньОценки = 1 Тогда
		Возврат;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ЦеннаяБумага,
		|	&Рынок
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал,
		|	ТаблицаЦБ.Рынок,
		|	СУММА(ЕСТЬNULL(КотировкиТорговыхПлощадокАкции.NUMTRADES, 0)) КАК АкцииNUMTRADES,
		|	СУММА(ЕСТЬNULL(КотировкиТорговыхПлощадокАкции.VALUE, 0) * ВЫБОР
		|			КОГДА Валюты.Ссылка = &Рубли
		|				ТОГДА 1
		|			ИНАЧЕ КурсыВалют.Курс / КурсыВалют.Кратность
		|		КОНЕЦ) КАК АкцииVALUE,
		|	СУММА(ЕСТЬNULL(КотировкиТорговыхПлощадокОблигации.NUMTRADES, 0)) КАК ОблигацииNUMTRADES,
		|	СУММА(ЕСТЬNULL(КотировкиТорговыхПлощадокОблигации.VALUE, 0) * ВЫБОР
		|			КОГДА Валюты.Ссылка = &Рубли
		|				ТОГДА 1
		|			ИНАЧЕ КурсыВалют.Курс / КурсыВалют.Кратность
		|		КОНЕЦ) КАК ОблигацииVALUE,
		|	СУММА(ЕСТЬNULL(КотировкиТорговыхПлощадокПаи.NUMTRADES, 0)) КАК ПаиNUMTRADES,
		|	СУММА(ЕСТЬNULL(КотировкиТорговыхПлощадокПаи.VALUE, 0) * ВЫБОР
		|			КОГДА Валюты.Ссылка = &Рубли
		|				ТОГДА 1
		|			ИНАЧЕ КурсыВалют.Курс / КурсыВалют.Кратность
		|		КОНЕЦ) КАК ПаиVALUE,
		|	Валюты.Ссылка,
		|	КурсыВалют.Курс,
		|	КурсыВалют.Кратность,
		|	ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.КоличествоПаев, 0) * ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена, 0) КАК ОбъемВыпущенныхПаев,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КотировкиТорговыхПлощадокАкции.Период) КАК ТорговыеДниАкции
		|ПОМЕСТИТЬ АктивныйРынокММВБ_Котировки
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадокАкции
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадокАкции.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокАкции.ЦеннаяБумага
		|			И (КотировкиТорговыхПлощадокАкции.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции))
		|			И (КотировкиТорговыхПлощадокАкции.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадокАкции.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадокАкции.VALUE > 0)
		|			И (КотировкиТорговыхПлощадокАкции.Период МЕЖДУ &ТорговыхДнейНазад10 И &ДатаПереоценки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадокОблигации
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадокОблигации.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокОблигации.ЦеннаяБумага
		|			И (КотировкиТорговыхПлощадокОблигации.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))
		|			И (КотировкиТорговыхПлощадокОблигации.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадокОблигации.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадокОблигации.Период МЕЖДУ &ТорговыхДнейНазад21 И &ДатаПереоценки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадокПаи
		|		ПО ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокПаи.ЦеннаяБумага
		|			И (КотировкиТорговыхПлощадокПаи.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))
		|			И (КотировкиТорговыхПлощадокПаи.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадокПаи.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадокПаи.Период МЕЖДУ &ТорговыхДнейНазад63 И &ДатаПереоценки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПаевыеИнвестиционныеФонды КАК ПаевыеИнвестиционныеФонды
		|			ПО Паи.ПаевойИнвестиционныйФонд = ПаевыеИнвестиционныеФонды.Ссылка
		|				И (ПаевыеИнвестиционныеФонды.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Открытый))
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(&ДатаПереоценки, ) КАК РасчетныеЦеныПаевСрезПоследних
		|			ПО Паи.Ссылка = РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага
		|		ПО ТаблицаЦБ.ЦеннаяБумага = Паи.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|			ПО Валюты.Ссылка = КурсыВалют.Валюта
		|				И (КурсыВалют.Период = &ДатаПереоценки)
		|		ПО (КотировкиТорговыхПлощадокАкции.Валюта = Валюты.Ссылка
		|				ИЛИ КотировкиТорговыхПлощадокОблигации.Валюта = Валюты.Ссылка
		|				ИЛИ КотировкиТорговыхПлощадокПаи.Валюта = Валюты.Ссылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал,
		|	ТаблицаЦБ.Рынок,
		|	Валюты.Ссылка,
		|	КурсыВалют.Курс,
		|	КурсыВалют.Кратность,
		|	ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.КоличествоПаев, 0) * ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена, 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АктивныйРынокММВБ_Котировки.ЦеннаяБумага,
		|	АктивныйРынокММВБ_Котировки.Рынок,
		|	АктивныйРынокММВБ_Котировки.Номинал
		|ПОМЕСТИТЬ АктивныйРынокММВБ
		|ИЗ
		|	АктивныйРынокММВБ_Котировки КАК АктивныйРынокММВБ_Котировки
		|ГДЕ
		|	ВЫБОР
		|			КОГДА АктивныйРынокММВБ_Котировки.АкцииNUMTRADES >= 100
		|					И АктивныйРынокММВБ_Котировки.АкцииVALUE / ВЫБОР
		|						КОГДА АктивныйРынокММВБ_Котировки.ТорговыеДниАкции = 0
		|							ТОГДА 1
		|						ИНАЧЕ АктивныйРынокММВБ_Котировки.ТорговыеДниАкции
		|					КОНЕЦ >= 1000000
		|				ТОГДА ИСТИНА
		|			КОГДА АктивныйРынокММВБ_Котировки.ОблигацииNUMTRADES >= 5
		|					И АктивныйРынокММВБ_Котировки.ОблигацииVALUE >= 1000000
		|				ТОГДА ИСТИНА
		|			КОГДА АктивныйРынокММВБ_Котировки.ПаиVALUE / ВЫБОР
		|					КОГДА ЕСТЬNULL(АктивныйРынокММВБ_Котировки.ОбъемВыпущенныхПаев, 0) = 0
		|						ТОГДА 1
		|					ИНАЧЕ АктивныйРынокММВБ_Котировки.ОбъемВыпущенныхПаев
		|				КОНЕЦ > 0.01
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(БухПартииЦенныхБумагОстатки.СтоимостьОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаОстаток + БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток + БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток + БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток) КАК СтоимостьЦБ,
		|	АктивныйРынокММВБ.ЦеннаяБумага,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE_DATE,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.OFFER,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.OFFER_DATE,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.BID,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE,
		|	АктивныйРынокММВБ.Номинал,
		|	АктивныйРынокММВБ.Рынок,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа.ЮрФизЛицо
		|ПОМЕСТИТЬ СущественностьИАктивность
		|ИЗ
		|	АктивныйРынокММВБ КАК АктивныйРынокММВБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&ДатаОценки,
		|				СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = &ВидУчета
		|					И Рынок = &Рынок
		|					И ЦеннаяБумага = &ЦеннаяБумага) КАК БухПартииЦенныхБумагОстатки
		|		ПО АктивныйРынокММВБ.Рынок = БухПартииЦенныхБумагОстатки.Рынок
		|			И АктивныйРынокММВБ.ЦеннаяБумага = БухПартииЦенныхБумагОстатки.ЦеннаяБумага,
		|	РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|			&ДатаПереоценки,
		|			Биржа = &ММВБ
		|				И РежимТоргов.ОсновнойРежим
		|				И Рынок = &Рынок
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	АктивныйРынокММВБ.ЦеннаяБумага,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE_DATE,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.OFFER,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.OFFER_DATE,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.BID,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.BID_DATE,
		|	АктивныйРынокММВБ.Номинал,
		|	АктивныйРынокММВБ.Рынок,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа.ЮрФизЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СущественностьИАктивность.ЦеннаяБумага,
		|	СущественностьИАктивность.Рынок,
		|	СущественностьИАктивность.Номинал,
		|	ВЫБОР
		|		КОГДА СущественностьИАктивность.СтоимостьЦБ < 100000000
		|			ТОГДА СущественностьИАктивность.WAPRICE
		|		КОГДА СущественностьИАктивность.СтоимостьЦБ > 100000000
		|				И СущественностьИАктивность.BID >= СущественностьИАктивность.OFFER
		|			ТОГДА СущественностьИАктивность.BID
		|		КОГДА СущественностьИАктивность.СтоимостьЦБ > 100000000
		|				И СущественностьИАктивность.BID < СущественностьИАктивность.OFFER
		|			ТОГДА СущественностьИАктивность.OFFER
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СправедливаяЦена,
		|	ВЫБОР
		|		КОГДА СущественностьИАктивность.СтоимостьЦБ < 100000000
		|			ТОГДА СущественностьИАктивность.WAPRICE_DATE
		|		КОГДА СущественностьИАктивность.СтоимостьЦБ > 100000000
		|				И СущественностьИАктивность.BID >= СущественностьИАктивность.OFFER
		|			ТОГДА СущественностьИАктивность.BID_DATE
		|		КОГДА СущественностьИАктивность.СтоимостьЦБ > 100000000
		|				И СущественностьИАктивность.BID < СущественностьИАктивность.OFFER
		|			ТОГДА СущественностьИАктивность.OFFER_DATE
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ДатаЦены,
		|	ВЫБОР
		|		КОГДА СущественностьИАктивность.СтоимостьЦБ < 100000000
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныдляПереоценки.СредневзвешеннаяЦена)
		|		КОГДА СущественностьИАктивность.СтоимостьЦБ > 100000000
		|				И СущественностьИАктивность.BID >= СущественностьИАктивность.OFFER
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныдляПереоценки.ЦенаСпроса)
		|		КОГДА СущественностьИАктивность.СтоимостьЦБ > 100000000
		|				И СущественностьИАктивность.BID < СущественностьИАктивность.OFFER
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныдляПереоценки.ЦенаПредложения)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПолеКотировки,
		|	ВЫБОР
		|		КОГДА СущественностьИАктивность.СтоимостьЦБ < 100000000
		|			ТОГДА 1
		|		КОГДА СущественностьИАктивность.СтоимостьЦБ > 100000000
		|				И СущественностьИАктивность.BID >= СущественностьИАктивность.OFFER
		|			ТОГДА 1
		|		КОГДА СущественностьИАктивность.СтоимостьЦБ > 100000000
		|				И СущественностьИАктивность.BID < СущественностьИАктивность.OFFER
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УровеньЦены,
		|	СущественностьИАктивность.БиржаЮрФизЛицо,
		|	СущественностьИАктивность.СтоимостьЦБ
		|ПОМЕСТИТЬ ЦенаССущественностью
		|ИЗ
		|	СущественностьИАктивность КАК СущественностьИАктивность
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦенаССущественностью.ЦеннаяБумага,
		|	ЦенаССущественностью.Рынок,
		|	ЦенаССущественностью.Номинал,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЦенаССущественностью.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ЦенаССущественностью.СправедливаяЦена * ЦенаССущественностью.Номинал / 100
		|		ИНАЧЕ ЦенаССущественностью.СправедливаяЦена
		|	КОНЕЦ КАК Стоимость,
		|	ЦенаССущественностью.ДатаЦены,
		|	ЦенаССущественностью.ПолеКотировки КАК ВидЦены,
		|	ЦенаССущественностью.УровеньЦены,
		|	ЦенаССущественностью.БиржаЮрФизЛицо КАК Источник,
		|	ЦенаССущественностью.СтоимостьЦБ
		|ИЗ
		|	ЦенаССущественностью КАК ЦенаССущественностью
		|ГДЕ
		|	ЦенаССущественностью.СправедливаяЦена > 0";
	
	ТорговыхДнейНазад10 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -10);
	ТорговыхДнейНазад21 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -21);
	ТорговыхДнейНазад63 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -63);
		
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10", ТорговыхДнейНазад10);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад21", ТорговыхДнейНазад21);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад63", ТорговыхДнейНазад63);
	Запрос.УстановитьПараметр("ВидУчета", ОбъектДокумента.ВидУчета);
	Запрос.УстановитьПараметр("Рубли", ОбъектДокумента.Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("ДатаОценки", Новый Граница(КонецДня(ДатаПереоценки), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Рынок", СтрокаПереоценкиЦБ.Рынок);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦеннаяБумага", СтрокаПереоценкиЦБ.ЦеннаяБумага);
	Запрос.УстановитьПараметр("ММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		СущественностьИАктивность = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Переоценка Благосостояния", "Переоценка Благосостояния", "Выборка");		
	Иначе
		СущественностьИАктивность = Запрос.Выполнить().Выбрать();
	КонецЕсли;
	
	Пока СущественностьИАктивность.Следующий() Цикл
		
		//в методике написано мутно, не учтено условие на 500 млн.руб. Т.к. возможно методика использоваться не будет, ставлю предупреждение
		Если СущественностьИАктивность.СтоимостьЦБ  <= 100000000 Тогда
			
			Если ТипЗнч(ОбъектДокумента) = Тип("Структура") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не учтено условие на превышение 500 млн.руб общей суммой отклонения. Обратитесь к программистам. ЦБ = "+СтрокаПереоценкиЦБ.ЦеннаяБумага);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не учтено условие на превышение 500 млн.руб общей суммой отклонения. Обратитесь к программистам. ЦБ = "+СтрокаПереоценкиЦБ.ЦеннаяБумага, ОбъектДокумента.Ссылка);
			КонецЕсли;
			
		КонецЕсли;
		
		СтрокаПереоценкиЦБ.Источник			= СущественностьИАктивность.Источник;
		СтрокаПереоценкиЦБ.ВидЦены			= СущественностьИАктивность.ВидЦены;
		СтрокаПереоценкиЦБ.УровеньОценки	= СущественностьИАктивность.УровеньЦены;
		СтрокаПереоценкиЦБ.ДатаЦены			= СущественностьИАктивность.ДатаЦены;
		СтрокаПереоценкиЦБ.Стоимость		= СущественностьИАктивность.Стоимость;
		
	КонецЦикла;
			
КонецПроцедуры

Процедура ЗаполнитьПереоценкуЛиванова(СтрокаПереоценкиЦБ, ДатаПереоценки, ОбъектДокумента, Отказ) Экспорт
	
	Если СтрокаПереоценкиЦБ.РыночнаяЦена = 0 И СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.ПустаяСсылка() Тогда
		
		ДатаРасчетаКредитногоСпреда = БухгалтерскийУчетЕПС.ОпределитьДатуПокупкиПартии(СтрокаПереоценкиЦБ.Партия, СтрокаПереоценкиЦБ.СтрокаПартии);
		Если ДатаПереоценки = НачалоДня(КонецМесяца(ДатаПереоценки)) И ДатаРасчетаКредитногоСпреда < ДатаПереоценки Тогда 
			ДатаРасчетаКредитногоСпреда = ДатаПереоценки
		ИначеЕсли ДатаРасчетаКредитногоСпреда < НачалоМесяца(ДатаПереоценки) - 24*60*60 Тогда
			ДатаРасчетаКредитногоСпреда = НачалоМесяца(ДатаПереоценки) - 24*60*60
		КонецЕсли;
		
		ЦеннаяБумага = СтрокаПереоценкиЦБ.ЦеннаяБумага;
		МассивИноставнныхАктивов = Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();
		ЭтоИностраннаяЦБ = МассивИноставнныхАктивов.Найти(ЦеннаяБумага.УчетныйАктивЦБРФ) <> Неопределено ИЛИ СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И ЦеннаяБумага.Подкатегория = Перечисления.ВидыГосударственныхОблигаций.ОВОЗ;
		
		ПараметрыРасчетаРейтинга = ПолучитьПараметрыРасчетаРейтингаПоУмолчанию(ОбъектДокумента.СчетДоверительногоУправления, ДатаПереоценки);
		ПараметрыРасчетаРейтинга.Вставить("ИсточникТаблицыСоответствияРейтингов",	Справочники.ВнешниеСистемы.НПФ_ОПФ);
		ПараметрыРасчетаРейтинга.Вставить("ТолькоНаблюдаемыеДанные",				Истина);
		ПараметрыРасчетаРейтинга.Вставить("ТолькоЭмитент",							Истина);

		ПараметрыРасчетаКредитногоСпреда = Новый Структура;
		ПараметрыРасчетаКредитногоСпреда.Вставить("ОтклонениеКредитногоСпреда", 50); //указано в учетной политике
	
		//2.с - только для долговых российских бумаг. Для иностранных ЦБ пропускается. 
		Если СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И НЕ ЭтоИностраннаяЦБ Тогда
			КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(ЦеннаяБумага, ДатаРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, Отказ);
			Если КредитныйСпред.Количество() > 0 Тогда
				
				ПараметрыДенежногоПотока = Новый Структура;
				ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",	Ложь);
				ПараметрыДенежногоПотока.Вставить("Дата",				ДатаПереоценки);
				ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",		ДатаПереоценки);
				
				ДенежныйПоток						= Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ПараметрыДенежногоПотока, ОбъектДокумента, Отказ);
				НаблюдаемоеЗначениеКредитногоСпреда	= КредитныйСпред[0].Медиана;
				БезрисковаяСтавкаДоходности			= РаботаСПоказателямиФинансовыхИнструментов.РассчитатьБезрисковуюСтавкуДоходности(ЦеннаяБумага, ДатаПереоценки, ДенежныйПоток, Отказ);
				СтавкаДисконтирования				= Окр(БезрисковаяСтавкаДоходности + НаблюдаемоеЗначениеКредитногоСпреда / 100, 2);
				
				Цена = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтавкаДисконтирования, ДатаПереоценки)
					- Справочники.Облигации.ПолучитьКупон(ЦеннаяБумага, ДатаПереоценки, ОбъектДокумента.СчетДоверительногоУправления), 4);
				
				Если Цена > 0 Тогда
					
					СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
					СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
					СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
					СтрокаПереоценкиЦБ.УровеньОценки = 2;
					СтрокаПереоценкиЦБ.ДатаКотировки = ДатаПереоценки;
					
					СтрокаПереоценкиЦБ.РыночнаяЦена = Цена;
					СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
					СтрокаПереоценкиЦБ.ВалютаКотировки = ЦеннаяБумага.ВалютаНоминала;
					//СтрокаПереоценкиЦБ.РыночнаяСумма = СтрокаПереоценкиЦБ.РыночнаяЦена * СтрокаПереоценкиЦБ.Количество;
					
					//СтрокаПереоценкиЦБ.ОценочнаяЦена = СтрокаПереоценкиЦБ.РыночнаяЦена;
					//СтрокаПереоценкиЦБ.ОценочнаяСумма = СтрокаПереоценкиЦБ.РыночнаяСумма;
					
					Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
						
						СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = Цена / Справочники.Облигации.ПолучитьНоминал(ЦеннаяБумага, ДатаПереоценки) * 100;
						//СтрокаПереоценкиЦБ.ОценочнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент;
						
					КонецЕсли;
					
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		//3.а
		Если СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Паи И НЕ ЭтоИностраннаяЦБ Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена КАК РасчетнаяЦена,
				|	РасчетныеЦеныПаевСрезПоследних.Период КАК Период,
				|	РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо КАК ПИФ
				|ИЗ
				|	РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &Ссылка) КАК РасчетныеЦеныПаевСрезПоследних
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
				|		ПО РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага = Паи.Ссылка
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФСрезПоследних
				|		ПО (ВЫРАЗИТЬ(РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
				|ГДЕ
				|	Паи.Ссылка = &Ссылка";
			
			Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
			Запрос.УстановитьПараметр("Ссылка", ЦеннаяБумага);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ИсточникЦены = ВыборкаДетальныеЗаписи.ПИФ;
				СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.СЧА;
				СтрокаПереоценкиЦБ.УровеньОценки = 3;//возможен 2?
				СтрокаПереоценкиЦБ.ДатаКотировки = ВыборкаДетальныеЗаписи.Период;
				
				СтрокаПереоценкиЦБ.РыночнаяЦена = ВыборкаДетальныеЗаписи.РасчетнаяЦена;
				СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
				СтрокаПереоценкиЦБ.ВалютаКотировки = ЦеннаяБумага.ВалютаНоминала;
				//СтрокаПереоценкиЦБ.РыночнаяСумма = СтрокаПереоценкиЦБ.РыночнаяЦена * СтрокаПереоценкиЦБ.Количество;
				
				//СтрокаПереоценкиЦБ.ОценочнаяЦена = СтрокаПереоценкиЦБ.РыночнаяЦена;
				//СтрокаПереоценкиЦБ.ОценочнаяСумма = СтрокаПереоценкиЦБ.РыночнаяСумма;
				
				Возврат;
			КонецЦикла;
			
		КонецЕсли;
		
		//3.с (как 2.с, но по кредитному спреду бумаги, а не эмитента)
		ПараметрыРасчетаРейтинга.ТолькоЭмитент = Ложь;
		
		КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(ЦеннаяБумага, ДатаРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, Отказ); 
		Если КредитныйСпред.Количество() > 0 Тогда
			
			ПараметрыДенежногоПотока = Новый Структура;
			ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",		Ложь);
			ПараметрыДенежногоПотока.Вставить("Дата",					ДатаПереоценки);
			ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",			ДатаПереоценки);
			
			ДенежныйПоток						= Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ПараметрыДенежногоПотока, ОбъектДокумента, Отказ);
			НаблюдаемоеЗначениеКредитногоСпреда	= КредитныйСпред[0].Медиана;
			БезрисковаяСтавкаДоходности			= РаботаСПоказателямиФинансовыхИнструментов.РассчитатьБезрисковуюСтавкуДоходности(ЦеннаяБумага, ДатаПереоценки, ДенежныйПоток, Отказ);
			СтавкаДисконтирования				= Окр(БезрисковаяСтавкаДоходности + НаблюдаемоеЗначениеКредитногоСпреда/100, 2);
			
			Цена = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтавкаДисконтирования, ДатаПереоценки)
				- Справочники.Облигации.ПолучитьКупон(ЦеннаяБумага, ДатаПереоценки, ОбъектДокумента.СчетДоверительногоУправления), 4);
			
			Если Цена > 0 Тогда
				
				СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
				СтрокаПереоценкиЦБ.УровеньОценки = 3;
				СтрокаПереоценкиЦБ.ДатаКотировки = ДатаПереоценки;
				
				СтрокаПереоценкиЦБ.РыночнаяЦена = Цена;
				СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
				СтрокаПереоценкиЦБ.ВалютаКотировки = ЦеннаяБумага.ВалютаНоминала;
				//СтрокаПереоценкиЦБ.РыночнаяСумма = СтрокаПереоценкиЦБ.РыночнаяЦена * СтрокаПереоценкиЦБ.Количество;
				
				//СтрокаПереоценкиЦБ.ОценочнаяЦена = СтрокаПереоценкиЦБ.РыночнаяЦена;
				//СтрокаПереоценкиЦБ.ОценочнаяСумма = СтрокаПереоценкиЦБ.РыночнаяСумма;
				
				Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
					
					СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = Цена / Справочники.Облигации.ПолучитьНоминал(ЦеннаяБумага, ДатаПереоценки) * 100;
					//СтрокаПереоценкиЦБ.ОценочнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент;
					
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
		
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьПереоценкуППА2018(СтрокаПереоценкиЦБ, ДатаПереоценки, ОбъектДокумента, Отказ, РасшифровкаРасчета = Неопределено) Экспорт
	
	// Цена при первичном размещении
	
	Если ДатаПереоценки >= '20181229' Тогда // c 29го методика изменилась, первичное размещение считаем 10 дней, если цены не появились, дальше - как обычно
		
		УсловияПримененияЦеныРазмещения = Новый Структура("КоличествоДней, Календарь", 10, Справочники.Календари.Общероссийский);
		ПараметрыЦеныРазмещения			= Новый Структура("ПропорциональноИзменениюКлючевойСтавки, УровеньОценки", Истина, 2);
		
		Если ДатаПереоценки >= '20200101' Тогда
			УсловияПримененияЦеныРазмещения.Вставить("ОтсутствиеЦенАктивногоРынкаСНачалаРазмещения", Истина);
			УсловияПримененияЦеныРазмещения.Вставить("ПриоритетыЦен", "Цена1Уровня, ЦенаПриобретения");
		Иначе
			УсловияПримененияЦеныРазмещения.Вставить("ПриоритетыЦен", "ЛюбаяЦена, ЦенаПриобретения");
			ПараметрыЦеныРазмещения.Вставить("ЗаполнитьИсточникЦеныПоБирже", Истина);
		КонецЕсли;
		
		Если ЗаполнитьПервичноеРазмещение(СтрокаПереоценкиЦБ, ДатаПереоценки, ОбъектДокумента, УсловияПримененияЦеныРазмещения, ПараметрыЦеныРазмещения, Отказ, РасшифровкаРасчета) Тогда 
			Возврат;	
		КонецЕсли;
		
	КонецЕсли;	
	
	// Расчетные цены с 01.01.2020 считаются в ПолучитьЦеныППА2018
	
	Если ДатаПереоценки < '20200101' Тогда	
	
		#Область Расчетные_цены
		
		Если СтрокаПереоценкиЦБ.РыночнаяЦена <> 0 ИЛИ СтрокаПереоценкиЦБ.ПолеЦены <> Перечисления.ИсточникиЦеныДляПереоценки.ПустаяСсылка() Тогда
			Возврат;	
		КонецЕсли;
		
		// Пока это рыба, т.к. хоть ППА2018 и сваливается в PV и спред, но нужно выяснить как
		// Возврат;
		
		УчитыватьКупонКОферте = Истина;
		
		ДатаРасчетаКредитногоСпреда = ДатаПереоценки;
		//ДатаРасчетаКредитногоСпреда = БухгалтерскийУчетЕПС.ОпределитьДатуПокупкиПартии(СтрокаПереоценкиЦБ.Партия, СтрокаПереоценкиЦБ.СтрокаПартии);
		//Если ДатаПереоценки = НачалоДня(КонецМесяца(ДатаПереоценки)) И ДатаРасчетаКредитногоСпреда < ДатаПереоценки Тогда 
		//	ДатаРасчетаКредитногоСпреда = ДатаПереоценки
		//ИначеЕсли ДатаРасчетаКредитногоСпреда < НачалоМесяца(ДатаПереоценки) - 24*60*60 Тогда
		//	ДатаРасчетаКредитногоСпреда = НачалоМесяца(ДатаПереоценки) - 24*60*60
		//КонецЕсли;
		
		ЦеннаяБумага = СтрокаПереоценкиЦБ.ЦеннаяБумага;
		МассивИноставнныхАктивов = Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();
		ЭтоИностраннаяЦБ = МассивИноставнныхАктивов.Найти(ЦеннаяБумага.УчетныйАктивЦБРФ) <> Неопределено ИЛИ СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И ЦеннаяБумага.Подкатегория = Перечисления.ВидыГосударственныхОблигаций.ОВОЗ;
		
		ПараметрыРасчетаРейтинга = ПолучитьПараметрыРасчетаРейтингаПоУмолчанию(ОбъектДокумента.СчетДоверительногоУправления, ДатаПереоценки);
		
		Если ДатаПереоценки < Дата(2020,1,1) Тогда
			ПараметрыРасчетаРейтинга.Вставить("ИсточникТаблицыСоответствияРейтингов",	Справочники.ВнешниеСистемы.Атом_РасчетСС);
		Иначе
			ПараметрыРасчетаРейтинга.Вставить("ИсточникТаблицыСоответствияРейтингов",	Справочники.ВнешниеСистемы.Газфонд);
		КонецЕсли;
		
		ПараметрыРасчетаРейтинга.Вставить("ТолькоНаблюдаемыеДанные",				Истина);
		ПараметрыРасчетаРейтинга.Вставить("ТолькоЭмитент",							Ложь);

		ПараметрыРасчетаКредитногоСпреда = Новый Структура;
		
		Если ДатаПереоценки < Дата(2020,1,1) Тогда
			ПараметрыРасчетаКредитногоСпреда.Вставить("ОтклонениеКредитногоСпреда", 50); //указано в учетной политике	
		Иначе
			ПараметрыРасчетаКредитногоСпреда.Вставить("ОтклонениеКредитногоСпреда", 0);
		КонецЕсли;
		
		Если ДатаПереоценки >= Дата(2020, 1, 1) Тогда
			ПараметрыРасчетаКредитногоСпреда.Вставить("ВариантРасчетаКредитногоСпреда", "СУчетомЗначенийКБДВТочкеДюрацииИндекса");
		КонецЕсли;
		
		//2.с - только для долговых российских бумаг. Для иностранных ЦБ пропускается. 
		Если СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И НЕ ЭтоИностраннаяЦБ Тогда
			
			КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(ЦеннаяБумага, ДатаРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, Отказ);
			
			Если КредитныйСпред.Количество() > 0 Тогда
				
				ПараметрыДенежногоПотока = Новый Структура;
				ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",		Ложь);
				ПараметрыДенежногоПотока.Вставить("Дата",					ДатаПереоценки);
				ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",			ДатаПереоценки);
				ПараметрыДенежногоПотока.Вставить("УчитыватьКупонКОферте",	УчитыватьКупонКОферте);
				
				ДенежныйПоток				= Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ПараметрыДенежногоПотока, ОбъектДокумента, Отказ);
				БезрисковаяСтавкаДоходности	= РаботаСПоказателямиФинансовыхИнструментов.РассчитатьБезрисковуюСтавкуДоходности(ЦеннаяБумага, ДатаПереоценки, ДенежныйПоток, Отказ);
				
				ЗначенияКредитногоСпреда			= КредитныйСпред[0];
				НаблюдаемоеЗначениеКредитногоСпреда	= ЗначенияКредитногоСпреда.Медиана;
				СтавкаДисконтирования				= Окр(БезрисковаяСтавкаДоходности + НаблюдаемоеЗначениеКредитногоСпреда / 100, 2);
				
				Цена = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтавкаДисконтирования, ДатаПереоценки)
					- Справочники.Облигации.ПолучитьКупон(ЦеннаяБумага, ДатаПереоценки, ОбъектДокумента.СчетДоверительногоУправления), 5);
				
				Если Цена > 0 Тогда
					
					СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
					СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
					СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
					СтрокаПереоценкиЦБ.УровеньОценки = 2;
					СтрокаПереоценкиЦБ.ДатаКотировки = ДатаПереоценки;
					
					СтрокаПереоценкиЦБ.РыночнаяЦена = Цена;
					СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
					СтрокаПереоценкиЦБ.ВалютаКотировки = ЦеннаяБумага.ВалютаНоминала;
					//СтрокаПереоценкиЦБ.РыночнаяСумма = СтрокаПереоценкиЦБ.РыночнаяЦена * СтрокаПереоценкиЦБ.Количество;
					
					//СтрокаПереоценкиЦБ.ОценочнаяЦена = СтрокаПереоценкиЦБ.РыночнаяЦена;
					//СтрокаПереоценкиЦБ.ОценочнаяСумма = СтрокаПереоценкиЦБ.РыночнаяСумма;
					
					Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
						СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = Цена / Справочники.Облигации.ПолучитьНоминал(ЦеннаяБумага, ДатаПереоценки) * 100;
						//СтрокаПереоценкиЦБ.ОценочнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент;
					КонецЕсли;
					
					Если РасшифровкаРасчета <> Неопределено Тогда
						РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка ППА 2018", "Денежный поток", ДенежныйПоток.Скопировать());
						
						ПараметрыРасчетаЦен = Новый Структура("МедианаКредитногоСпреда, БезрисковаяСтавкаДоходности, НаблюдаемоеЗначениеКредитногоСпреда, Цена", ЗначенияКредитногоСпреда.Медиана, БезрисковаяСтавкаДоходности, НаблюдаемоеЗначениеКредитногоСпреда, Цена);
						РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка ППА 2018", "Параметры расчета цены", ПараметрыРасчетаЦен);
					КонецЕсли;
					
					Возврат;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		//3.а
		Если СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Паи И НЕ ЭтоИностраннаяЦБ Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена КАК РасчетнаяЦена,
				|	РасчетныеЦеныПаевСрезПоследних.Период КАК Период,
				|	РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо КАК ПИФ
				|ИЗ
				|	РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &Ссылка) КАК РасчетныеЦеныПаевСрезПоследних
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
				|		ПО РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага = Паи.Ссылка
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФСрезПоследних
				|		ПО (ВЫРАЗИТЬ(РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
				|ГДЕ
				|	Паи.Ссылка = &Ссылка";
			
			Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
			Запрос.УстановитьПараметр("Ссылка", ЦеннаяБумага);
			
			ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				
				СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ИсточникЦены = ВыборкаДетальныеЗаписи.ПИФ;
				СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.СЧА;
				СтрокаПереоценкиЦБ.УровеньОценки = 3;//возможен 2?
				СтрокаПереоценкиЦБ.ДатаКотировки = ВыборкаДетальныеЗаписи.Период;
				
				СтрокаПереоценкиЦБ.РыночнаяЦена = ВыборкаДетальныеЗаписи.РасчетнаяЦена;
				СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
				СтрокаПереоценкиЦБ.ВалютаКотировки = ЦеннаяБумага.ВалютаНоминала;
				//СтрокаПереоценкиЦБ.РыночнаяСумма = СтрокаПереоценкиЦБ.РыночнаяЦена * СтрокаПереоценкиЦБ.Количество;
				
				//СтрокаПереоценкиЦБ.ОценочнаяЦена = СтрокаПереоценкиЦБ.РыночнаяЦена;
				//СтрокаПереоценкиЦБ.ОценочнаяСумма = СтрокаПереоценкиЦБ.РыночнаяСумма;
				
				Если РасшифровкаРасчета <> Неопределено Тогда
					ПараметрыРасчетаЦен = Новый Структура("Примечание, РасчетнаяЦена", "Расчетная цена пая", ВыборкаДетальныеЗаписи.РасчетнаяЦена);
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка ППА 2018", "Параметры расчета цены", ПараметрыРасчетаЦен);
				КонецЕсли;
				
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;
		
		//3.с (как 2.с, но по кредитному спреду бумаги, а не эмитента)
		КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(ЦеннаяБумага, ДатаРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, Отказ); 
		
		Если КредитныйСпред.Количество() > 0 Тогда
			
			ПараметрыДенежногоПотока = Новый Структура;
			ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",		Ложь);
			ПараметрыДенежногоПотока.Вставить("Дата",					ДатаПереоценки);
			ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",			ДатаПереоценки);
			ПараметрыДенежногоПотока.Вставить("УчитыватьКупонКОферте",	УчитыватьКупонКОферте);
			
			ДенежныйПоток				= Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ПараметрыДенежногоПотока, ОбъектДокумента, Отказ);
			БезрисковаяСтавкаДоходности	= РаботаСПоказателямиФинансовыхИнструментов.РассчитатьБезрисковуюСтавкуДоходности(ЦеннаяБумага, ДатаПереоценки, ДенежныйПоток, Отказ);
			
			ЗначенияКредитногоСпреда			= КредитныйСпред[0];
			НаблюдаемоеЗначениеКредитногоСпреда	= ЗначенияКредитногоСпреда.Медиана;
			СтавкаДисконтирования				= Окр(БезрисковаяСтавкаДоходности + НаблюдаемоеЗначениеКредитногоСпреда / 100, 2);
			
			Цена = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтавкаДисконтирования, ДатаПереоценки)
				- Справочники.Облигации.ПолучитьКупон(ЦеннаяБумага, ДатаПереоценки, ОбъектДокумента.СчетДоверительногоУправления), 4);
			
			Если Цена > 0 Тогда
				
				СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
				СтрокаПереоценкиЦБ.УровеньОценки = 3;
				СтрокаПереоценкиЦБ.ДатаКотировки = ДатаПереоценки;
				
				СтрокаПереоценкиЦБ.РыночнаяЦена = Цена;
				СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
				СтрокаПереоценкиЦБ.ВалютаКотировки = ЦеннаяБумага.ВалютаНоминала;
				//СтрокаПереоценкиЦБ.РыночнаяСумма = СтрокаПереоценкиЦБ.РыночнаяЦена * СтрокаПереоценкиЦБ.Количество;
				
				//СтрокаПереоценкиЦБ.ОценочнаяЦена = СтрокаПереоценкиЦБ.РыночнаяЦена;
				//СтрокаПереоценкиЦБ.ОценочнаяСумма = СтрокаПереоценкиЦБ.РыночнаяСумма;
				
				Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
					СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = Цена / Справочники.Облигации.ПолучитьНоминал(ЦеннаяБумага, ДатаПереоценки) * 100;
					//СтрокаПереоценкиЦБ.ОценочнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент;
				КонецЕсли;
				
				Если РасшифровкаРасчета <> Неопределено Тогда
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка ППА 2018", "Денежный поток", ДенежныйПоток.Скопировать());
					
					ПараметрыРасчетаЦен = Новый Структура("МедианаКредитногоСпреда, БезрисковаяСтавкаДоходности, НаблюдаемоеЗначениеКредитногоСпреда, Цена", ЗначенияКредитногоСпреда.Медиана, БезрисковаяСтавкаДоходности, НаблюдаемоеЗначениеКредитногоСпреда, Цена);
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка ППА 2018", "Параметры расчета цены", ПараметрыРасчетаЦен);
				КонецЕсли;
				
			КонецЕсли;

		КонецЕсли;
		
		#КонецОбласти
		
	КонецЕсли;
				
КонецПроцедуры

Процедура ЗаполнитьПереоценкуСбербанка(СтрокаПереоценкиЦБ, ДатаПереоценки, ОбъектДокумента, ТаблицаДатИЦенПокупки, НастройкиУчета, Отказ, РасшифровкаРасчета = Неопределено) Экспорт
	
	КлиентДУ = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ОбъектДокумента.СчетДоверительногоУправления, ДатаПереоценки);
	
	// PV по ЭСП	
	
	Если СтрокаПереоценкиЦБ.УчетныйАктивЕПС.Родитель = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСД
		ИЛИ СтрокаПереоценкиЦБ.УчетныйАктивЕПС.Родитель = Справочники.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения
	Тогда
		
		Если ТаблицаДатИЦенПокупки = Неопределено Тогда
			ТаблицаДатИЦенПокупки = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(СтрокаПереоценкиЦБ.Владелец(), ОбъектДокумента.СчетДоверительногоУправления, ДатаПереоценки).Выгрузить();
		КонецЕсли;
		
		СтрокиПокупки = ТаблицаДатИЦенПокупки.НайтиСтроки(Новый Структура("ЦеннаяБумага,Партия,СтрокаПартии",СтрокаПереоценкиЦБ.ЦеннаяБумага, СтрокаПереоценкиЦБ.Партия, СтрокаПереоценкиЦБ.СтрокаПартии));
		Если СтрокиПокупки.Количество()=0 Тогда
			Если ТипЗнч(ОбъектДокумента) = Тип("Структура") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдены цена и дата покупки для ЦБ " + СтрокаПереоценкиЦБ.ЦеннаяБумага + " из партии " + СтрокаПереоценкиЦБ.Партия + ", строка " + СтрокаПереоценкиЦБ.СтрокаПартии,,,, Отказ);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдены цена и дата покупки для ЦБ " + СтрокаПереоценкиЦБ.ЦеннаяБумага + " из партии " + СтрокаПереоценкиЦБ.Партия + ", строка " + СтрокаПереоценкиЦБ.СтрокаПартии, ОбъектДокумента.Ссылка,,, Отказ);
			КонецЕсли;	
			Возврат;
		КонецЕсли;
		СтрокаПокупки = СтрокиПокупки[0];
		
		Если НастройкиУчета.РассчитыватьЭСПДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоПогашения Тогда
			СчитаемДоПогашения = Истина;
		Иначе
			СчитаемДоПогашения = Ложь;
		КонецЕсли;
		
		ПараметрыДенежногоПотока = Новый Структура;
		ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",	СчитаемДоПогашения);
		ПараметрыДенежногоПотока.Вставить("Дата",				ДатаПереоценки);
		ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",		ДатаПереоценки);
		
		ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(СтрокаПереоценкиЦБ.ЦеннаяБумага, ПараметрыДенежногоПотока, ОбъектДокумента, Отказ); 
		
		ЭСП = БухгалтерскийУчет.РассчитатьДоходностьИДюрациюПоПотоку(ДенежныйПоток, СтрокаПокупки.ДатаПокупки, СтрокаПокупки.ЦенаПокупки).Доходность;
		
		РыночнаяЦена = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, ЭСП, ДатаПереоценки)
			- Справочники.Облигации.ПолучитьКупон(СтрокаПереоценкиЦБ.ЦеннаяБумага, ДатаПереоценки, ОбъектДокумента.СчетДоверительногоУправления), 8);
		
		СтрокаПереоценкиЦБ.РыночнаяЦена			= РыночнаяЦена;	
		СтрокаПереоценкиЦБ.ЦенаКотировки		= СтрокаПереоценкиЦБ.РыночнаяЦена;
		СтрокаПереоценкиЦБ.ВалютаКотировки		= СтрокаПереоценкиЦБ.ЦеннаяБумага.ВалютаНоминала;
		СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент  = СтрокаПереоценкиЦБ.РыночнаяЦена / СтрокаПокупки.НоминалТекущий * 100;
		СтрокаПереоценкиЦБ.Биржа				= Справочники.Биржи.ПустаяСсылка();
		СтрокаПереоценкиЦБ.ИсточникЦены			= КлиентДУ;
		СтрокаПереоценкиЦБ.ПолеЦены 		    = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
		СтрокаПереоценкиЦБ.ДатаКотировки 		= ДатаПереоценки;
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка Сбербанка", "Денежный поток", ДенежныйПоток.Скопировать());
			
			ПараметрыРасчетаЦен = Новый Структура("ЭСП", Окр(ЭСП, 7));
			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка Сбербанка", "Параметры переоценки Сбербанка", ПараметрыРасчетаЦен);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	// п. 2.6.1. для приобретенных при первичном размещении, до даты начала вторичного обращения,
	// но не позднее 30 календарных дней с даты первичного размещения - берем цену приобретения	
	
	Если ЗначениеЗаполнено(СтрокаПереоценкиЦБ.ДатаНачалаОбращения)
		И ЗначениеЗаполнено(СтрокаПереоценкиЦБ.ДатаНачалаРазмещения) 
		И ДатаПереоценки < СтрокаПереоценкиЦБ.ДатаНачалаОбращения
	Тогда
	
	    УсловияПримененияЦеныРазмещения	= Новый Структура("КоличествоДней, ПриоритетыЦен", 30, "ЦенаПриобретения");
		ПараметрыЦеныРазмещения			= Новый Структура("ИсточникЦены, ПолеЦены", КлиентДУ, Перечисления.ИсточникиЦеныДляПереоценки.БалансоваяЦена);
		
		Если ЗаполнитьПервичноеРазмещение(СтрокаПереоценкиЦБ, ДатаПереоценки, ОбъектДокумента, УсловияПримененияЦеныРазмещения, ПараметрыЦеныРазмещения, Отказ, РасшифровкаРасчета) Тогда
			Возврат;
		КонецЕсли;

	КонецЕсли;
	
	// PV по усредненной ставке доходности за 6 торговых дней	
	
	Если СтрокаПереоценкиЦБ.РыночнаяЦена = 0 И СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = 0 Тогда 
		
		ТекЦБ = СтрокаПереоценкиЦБ.ЦеннаяБумага;
		
		Если ТипЗнч(ТекЦБ) = Тип("СправочникСсылка.Облигации") Тогда
			
			Если ТаблицаДатИЦенПокупки = Неопределено Тогда
				ТаблицаДатИЦенПокупки = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(СтрокаПереоценкиЦБ.Владелец(), ОбъектДокумента.СчетДоверительногоУправления, ДатаПереоценки).Выгрузить();
			КонецЕсли;
			
			СтрокиПокупки = ТаблицаДатИЦенПокупки.НайтиСтроки(Новый Структура("ЦеннаяБумага,Партия,СтрокаПартии",СтрокаПереоценкиЦБ.ЦеннаяБумага, СтрокаПереоценкиЦБ.Партия, СтрокаПереоценкиЦБ.СтрокаПартии));
			Если СтрокиПокупки.Количество() = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдены цена и дата покупки для ЦБ " + СтрокаПереоценкиЦБ.ЦеннаяБумага + " из партии " + СтрокаПереоценкиЦБ.Партия + ", строка " + СтрокаПереоценкиЦБ.СтрокаПартии, ?(ТипЗнч(ОбъектДокумента) = Тип("Структура"), Неопределено, ОбъектДокумента.Ссылка), , , Отказ);
				Возврат;
			КонецЕсли;
			
			ДатаПокупки = СтрокиПокупки[0].ДатаПокупки;
			ЦенаПокупки = СтрокиПокупки[0].ЦенаПокупки;

			ПараметрыДенежногоПотока = Новый Структура;
			ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",	Ложь);
			ПараметрыДенежногоПотока.Вставить("Дата",				ДатаПокупки);
			ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",		ДатаПереоценки);
			
			ДенежныйПотокНаДатуПокупки			= Справочники.Облигации.ПолучитьДенежныйПоток(ТекЦБ, ПараметрыДенежногоПотока, ОбъектДокумента, Отказ);
			ДоходностьПокупки					= Справочники.Облигации.ПолучитьДоходностьИДюрацию(ТекЦБ, Ложь, ДатаПокупки, ЦенаПокупки, ОбъектДокумента.СчетДоверительногоУправления, , ДатаПереоценки).Доходность;
			ДоходностьБескупоннаяНаДатуПокупки	= РаботаСПоказателямиФинансовыхИнструментов.РассчитатьНоминальнуюБезрисковуюСтавкуДоходности(ТекЦБ, ДатаПокупки, ДенежныйПотокНаДатуПокупки, Отказ);
			
			ДельтаЗ = ДоходностьПокупки - ДоходностьБескупоннаяНаДатуПокупки;
			
			УсредненнаяСтавкаДоходностиЗа6Дней = 0;
			
			Запрос = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 6
				|	ДанныеКалендаря.Дата КАК Дата
				|ИЗ
				|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
				|ГДЕ
				|	ДанныеКалендаря.Календарь = &КалендарьТорговый
				|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
				|	И ДанныеКалендаря.Дата <= &ДатаПереоценки
				|
				|УПОРЯДОЧИТЬ ПО
				|	ДанныеКалендаря.Дата УБЫВ");
			
			Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
			Запрос.УстановитьПараметр("КалендарьТорговый", Константы.ОсновнойКалендарьКотировок.Получить());
			
			ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				ПараметрыДенежногоПотока = Новый Структура;
				ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",	Ложь);
				ПараметрыДенежногоПотока.Вставить("Дата",				ВыборкаДетальныеЗаписи.Дата);
				ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",		ДатаПереоценки);
				
				ДенежныйПотокНаДату					= Справочники.Облигации.ПолучитьДенежныйПоток(ТекЦБ, ПараметрыДенежногоПотока, ОбъектДокумента, Отказ);
				УсредненнаяСтавкаДоходностиЗа6Дней	= УсредненнаяСтавкаДоходностиЗа6Дней + РаботаСПоказателямиФинансовыхИнструментов.РассчитатьНоминальнуюБезрисковуюСтавкуДоходности(ТекЦБ, ВыборкаДетальныеЗаписи.Дата, ДенежныйПотокНаДату, Отказ);
				
			КонецЦикла;
			
			УсредненнаяСтавкаДоходностиЗа6Дней = УсредненнаяСтавкаДоходностиЗа6Дней / 6;
			
			ПараметрыДенежногоПотока = Новый Структура;
			ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",	Ложь);
			ПараметрыДенежногоПотока.Вставить("Дата",				ДатаПереоценки);
			ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",		ДатаПереоценки);
				
			ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(СтрокаПереоценкиЦБ.ЦеннаяБумага, ПараметрыДенежногоПотока, ОбъектДокумента, Отказ); 
			
			РыночнаяЦена = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, УсредненнаяСтавкаДоходностиЗа6Дней + ДельтаЗ, ДатаПереоценки)
			 	- Справочники.Облигации.ПолучитьКупон(ТекЦБ, ДатаПереоценки, ОбъектДокумента.СчетДоверительногоУправления);
			
	        СтрокаПереоценкиЦБ.РыночнаяЦена 		= РыночнаяЦена;
			СтрокаПереоценкиЦБ.ЦенаКотировки 		= СтрокаПереоценкиЦБ.РыночнаяЦена;
	        СтрокаПереоценкиЦБ.ВалютаКотировки 		= ТекЦБ.ВалютаНоминала;
			СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент  = СтрокаПереоценкиЦБ.РыночнаяЦена *100 / Справочники.Облигации.ПолучитьНоминал(ТекЦБ, ДатаПереоценки);
			СтрокаПереоценкиЦБ.Биржа				= Справочники.Биржи.ПустаяСсылка();
			СтрокаПереоценкиЦБ.ИсточникЦены			= КлиентДУ;
			СтрокаПереоценкиЦБ.ПолеЦены 		    = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
			СтрокаПереоценкиЦБ.ДатаКотировки 		= ДатаПереоценки;
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				ПараметрыРасчетаЦен = Новый Структура("ДоходностьПокупки, ДоходностьБескупоннаяНаДатуПокупки, УсредненнаяСтавкаДоходностиЗа6Дней", ДоходностьПокупки, ДоходностьБескупоннаяНаДатуПокупки, УсредненнаяСтавкаДоходностиЗа6Дней);
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка Сбербанка", "Параметры переоценки Сбербанка", ПараметрыРасчетаЦен);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПереоценкуСЧАНефтегарант2018(СтрокаПереоценкиЦБ, ДатаПереоценки, Объект, Отказ, РасшифровкаРасчета = Неопределено) Экспорт
	
	Если СтрокаПереоценкиЦБ.ПолеЦены <> Перечисления.ИсточникиЦеныДляПереоценки.ПустаяСсылка() Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		
		ПараметрыДенежногоПотока = Новый Структура;
		ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",		Истина);
		ПараметрыДенежногоПотока.Вставить("Дата",					СтрокаПереоценкиЦБ.ЦеннаяБумага.ДатаНачалаРазмещения);
		ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",			СтрокаПереоценкиЦБ.ЦеннаяБумага.ДатаОкончанияРазмещения);

		ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(СтрокаПереоценкиЦБ.ЦеннаяБумага, ПараметрыДенежногоПотока, Объект, Отказ, РасшифровкаРасчета); 
		
		// Доходность при размещении берется из открытых источников (RusBonds, CBonds и др.).
		// У нас она не хранится, поэтому мы ее рассчитываем, но т.к. у них она с округлением, округляем и мы.
			
		ТочностьЭСП = 2;
		
		ЭСП = Окр(БухгалтерскийУчет.РассчитатьДоходностьИДюрациюПоПотоку(
			ДенежныйПоток, СтрокаПереоценкиЦБ.ЦеннаяБумага.ДатаНачалаРазмещения, СтрокаПереоценкиЦБ.ЦеннаяБумага.Номинал).Доходность, ТочностьЭСП);
			
		РыночнаяЦена = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, ЭСП, ДатаПереоценки)
			- Справочники.Облигации.ПолучитьКупон(СтрокаПереоценкиЦБ.ЦеннаяБумага, ДатаПереоценки, Объект.СчетДоверительногоУправления), 2);
			
		СтрокаПереоценкиЦБ.РыночнаяЦена			= РыночнаяЦена;
		СтрокаПереоценкиЦБ.ЦенаКотировки		= СтрокаПереоценкиЦБ.РыночнаяЦена;
		СтрокаПереоценкиЦБ.ВалютаКотировки		= СтрокаПереоценкиЦБ.ЦеннаяБумага.ВалютаНоминала;
		СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент  = СтрокаПереоценкиЦБ.РыночнаяЦена / Справочники.Облигации.ПолучитьНоминал(СтрокаПереоценкиЦБ.ЦеннаяБумага, ДатаПереоценки) * 100;
		СтрокаПереоценкиЦБ.Биржа				= Справочники.Биржи.ПустаяСсылка();
		СтрокаПереоценкиЦБ.ИсточникЦены			= Справочники.ЮрФизЛица.ПустаяСсылка();
		СтрокаПереоценкиЦБ.ПолеЦены 		    = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
		СтрокаПереоценкиЦБ.ДатаКотировки 		= ДатаПереоценки;
		СтрокаПереоценкиЦБ.УровеньОценки 		= 3;
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			ПараметрыРасчетаЦен = Новый Структура("ЭСП, Цена", Окр(ЭСП, 7), СтрокаПереоценкиЦБ.РыночнаяЦена);
			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка СЧА Нефтегарант 2018", "Параметры переоценки СЧА Нефтегарант 2018", ПараметрыРасчетаЦен);
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПереоценкуСЧАПФР(СтрокаПереоценкиЦБ, ДатаПереоценки, ОбъектДокумента, Отказ, РасшифровкаРасчета = Неопределено) Экспорт
	
	Если СтрокаПереоценкиЦБ.РыночнаяЦена <> 0 ИЛИ СтрокаПереоценкиЦБ.ПолеЦены <> Перечисления.ИсточникиЦеныДляПереоценки.ПустаяСсылка() Тогда
		Возврат;	
	КонецЕсли;
	
	// Пока это рыба, т.к. хоть ПФР и сваливается в PV и спред, но нужно выяснить как
	// Возврат;
	
	УчитыватьКупонКОферте = Истина;
	
	ДатаРасчетаКредитногоСпреда = ДатаПереоценки;
	//ДатаРасчетаКредитногоСпреда = БухгалтерскийУчетЕПС.ОпределитьДатуПокупкиПартии(СтрокаПереоценкиЦБ.Партия, СтрокаПереоценкиЦБ.СтрокаПартии);
	//Если ДатаПереоценки = НачалоДня(КонецМесяца(ДатаПереоценки)) И ДатаРасчетаКредитногоСпреда < ДатаПереоценки Тогда 
	//	ДатаРасчетаКредитногоСпреда = ДатаПереоценки
	//ИначеЕсли ДатаРасчетаКредитногоСпреда < НачалоМесяца(ДатаПереоценки) - 24*60*60 Тогда
	//	ДатаРасчетаКредитногоСпреда = НачалоМесяца(ДатаПереоценки) - 24*60*60
	//КонецЕсли;
	
	ЦеннаяБумага = СтрокаПереоценкиЦБ.ЦеннаяБумага;
	МассивИноставнныхАктивов = Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();
	ЭтоИностраннаяЦБ = МассивИноставнныхАктивов.Найти(ЦеннаяБумага.УчетныйАктивЦБРФ) <> Неопределено ИЛИ СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И ЦеннаяБумага.Подкатегория = Перечисления.ВидыГосударственныхОблигаций.ОВОЗ;
	
	ПараметрыРасчетаРейтинга = ПолучитьПараметрыРасчетаРейтингаПоУмолчанию(ОбъектДокумента.СчетДоверительногоУправления, ДатаПереоценки);
	ПараметрыРасчетаРейтинга.Вставить("ИсточникТаблицыСоответствияРейтингов",	Справочники.ВнешниеСистемы.Атом_РасчетСС);
	ПараметрыРасчетаРейтинга.Вставить("ТолькоНаблюдаемыеДанные",				Истина);
	ПараметрыРасчетаРейтинга.Вставить("ТолькоЭмитент",							Ложь);

	ПараметрыРасчетаКредитногоСпреда = Новый Структура;
	ПараметрыРасчетаКредитногоСпреда.Вставить("ОтклонениеКредитногоСпреда", 50); //указано в учетной политике
	
	//2.с - только для долговых российских бумаг. Для иностранных ЦБ пропускается. 
	Если СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И НЕ ЭтоИностраннаяЦБ Тогда
		
		КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(ЦеннаяБумага, ДатаРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, Отказ);
		
		Если КредитныйСпред.Количество() > 0 Тогда
			
			ПараметрыДенежногоПотока = Новый Структура;
			ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",		Ложь);
			ПараметрыДенежногоПотока.Вставить("Дата",					ДатаПереоценки);
			ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",			ДатаПереоценки);
			ПараметрыДенежногоПотока.Вставить("УчитыватьКупонКОферте",	УчитыватьКупонКОферте);
		
			ДенежныйПоток				= Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ПараметрыДенежногоПотока, ОбъектДокумента, Отказ, РасшифровкаРасчета);
			БезрисковаяСтавкаДоходности	= РаботаСПоказателямиФинансовыхИнструментов.РассчитатьБезрисковуюСтавкуДоходности(ЦеннаяБумага, ДатаПереоценки, ДенежныйПоток, Отказ);
			
			ЗначенияКредитногоСпреда			= КредитныйСпред[0];
			НаблюдаемоеЗначениеКредитногоСпреда	= ЗначенияКредитногоСпреда.Медиана;
			СтавкаДисконтирования				= Окр(БезрисковаяСтавкаДоходности + НаблюдаемоеЗначениеКредитногоСпреда / 100, 2);
			
			Цена = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтавкаДисконтирования, ДатаПереоценки)
				- Справочники.Облигации.ПолучитьКупон(ЦеннаяБумага, ДатаПереоценки, ОбъектДокумента.СчетДоверительногоУправления), 4);
			
			Если Цена > 0 Тогда
				
				СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
				СтрокаПереоценкиЦБ.УровеньОценки = 2;
				СтрокаПереоценкиЦБ.ДатаКотировки = ДатаПереоценки;
				
				СтрокаПереоценкиЦБ.РыночнаяЦена = Цена;
				СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
				СтрокаПереоценкиЦБ.ВалютаКотировки = ЦеннаяБумага.ВалютаНоминала;
				//СтрокаПереоценкиЦБ.РыночнаяСумма = СтрокаПереоценкиЦБ.РыночнаяЦена * СтрокаПереоценкиЦБ.Количество;
				
				//СтрокаПереоценкиЦБ.ОценочнаяЦена = СтрокаПереоценкиЦБ.РыночнаяЦена;
				//СтрокаПереоценкиЦБ.ОценочнаяСумма = СтрокаПереоценкиЦБ.РыночнаяСумма;
				
				Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
					СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = Цена / Справочники.Облигации.ПолучитьНоминал(ЦеннаяБумага, ДатаПереоценки) * 100;
					//СтрокаПереоценкиЦБ.ОценочнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент;
				КонецЕсли;
				
				Если РасшифровкаРасчета <> Неопределено Тогда
					ПараметрыРасчетаЦен = Новый Структура("МедианаКредитногоСпреда, БезрисковаяСтавкаДоходности, НаблюдаемоеЗначениеКредитногоСпреда, Цена", ЗначенияКредитногоСпреда.Медиана, БезрисковаяСтавкаДоходности, НаблюдаемоеЗначениеКредитногоСпреда, Цена);
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка СЧА ПФР", "Параметры расчета цены", ПараметрыРасчетаЦен);
				КонецЕсли;
				
				Возврат;

			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	//3.а
	Если СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Паи И НЕ ЭтоИностраннаяЦБ Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена КАК РасчетнаяЦена,
			|	РасчетныеЦеныПаевСрезПоследних.Период КАК Период,
			|	РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо КАК ПИФ
			|ИЗ
			|	РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &Ссылка) КАК РасчетныеЦеныПаевСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
			|		ПО РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага = Паи.Ссылка
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФСрезПоследних
			|		ПО (ВЫРАЗИТЬ(РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
			|ГДЕ
			|	Паи.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
		Запрос.УстановитьПараметр("Ссылка", ЦеннаяБумага);
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			
			СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
			СтрокаПереоценкиЦБ.ИсточникЦены = ВыборкаДетальныеЗаписи.ПИФ;
			СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.СЧА;
			СтрокаПереоценкиЦБ.УровеньОценки = 3;//возможен 2?
			СтрокаПереоценкиЦБ.ДатаКотировки = ВыборкаДетальныеЗаписи.Период;
			
			СтрокаПереоценкиЦБ.РыночнаяЦена = ВыборкаДетальныеЗаписи.РасчетнаяЦена;
			СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
			СтрокаПереоценкиЦБ.ВалютаКотировки = ЦеннаяБумага.ВалютаНоминала;
			//СтрокаПереоценкиЦБ.РыночнаяСумма = СтрокаПереоценкиЦБ.РыночнаяЦена * СтрокаПереоценкиЦБ.Количество;
			
			//СтрокаПереоценкиЦБ.ОценочнаяЦена = СтрокаПереоценкиЦБ.РыночнаяЦена;
			//СтрокаПереоценкиЦБ.ОценочнаяСумма = СтрокаПереоценкиЦБ.РыночнаяСумма;
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				ПараметрыРасчетаЦен = Новый Структура("Примечание, РасчетнаяЦена", "Расчетная цена пая", ВыборкаДетальныеЗаписи.РасчетнаяЦена);
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка СЧА ПФР", "Параметры расчета цены", ПараметрыРасчетаЦен);
			КонецЕсли;
			
			Возврат;

		КонецЕсли;
		
	КонецЕсли;
	
	//3.с (как 2.с, но по кредитному спреду бумаги, а не эмитента)
	КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(ЦеннаяБумага, ДатаРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, Отказ);
	
	Если КредитныйСпред.Количество() > 0 Тогда
		
		ПараметрыДенежногоПотока = Новый Структура;
		ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",		Ложь);
		ПараметрыДенежногоПотока.Вставить("Дата",					ДатаПереоценки);
		ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",			ДатаПереоценки);
		ПараметрыДенежногоПотока.Вставить("УчитыватьКупонКОферте",	УчитыватьКупонКОферте);
		
		ДенежныйПоток				= Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ПараметрыДенежногоПотока, ОбъектДокумента, Отказ, РасшифровкаРасчета);
		БезрисковаяСтавкаДоходности	= РаботаСПоказателямиФинансовыхИнструментов.РассчитатьБезрисковуюСтавкуДоходности(ЦеннаяБумага, ДатаПереоценки, ДенежныйПоток, Отказ);
		
		ЗначенияКредитногоСпреда			= КредитныйСпред[0];
		НаблюдаемоеЗначениеКредитногоСпреда	= ЗначенияКредитногоСпреда.Медиана;
		СтавкаДисконтирования				= Окр(БезрисковаяСтавкаДоходности + НаблюдаемоеЗначениеКредитногоСпреда / 100, 2);
		
		Цена = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтавкаДисконтирования, ДатаПереоценки)
			- Справочники.Облигации.ПолучитьКупон(ЦеннаяБумага, ДатаПереоценки, ОбъектДокумента.СчетДоверительногоУправления), 4);
		
		Если Цена > 0 Тогда
			
			СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
			СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
			СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
			СтрокаПереоценкиЦБ.УровеньОценки = 3;
			СтрокаПереоценкиЦБ.ДатаКотировки = ДатаПереоценки;
			
			СтрокаПереоценкиЦБ.РыночнаяЦена = Цена;
			СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
			СтрокаПереоценкиЦБ.ВалютаКотировки = ЦеннаяБумага.ВалютаНоминала;
			//СтрокаПереоценкиЦБ.РыночнаяСумма = СтрокаПереоценкиЦБ.РыночнаяЦена * СтрокаПереоценкиЦБ.Количество;
			
			//СтрокаПереоценкиЦБ.ОценочнаяЦена = СтрокаПереоценкиЦБ.РыночнаяЦена;
			//СтрокаПереоценкиЦБ.ОценочнаяСумма = СтрокаПереоценкиЦБ.РыночнаяСумма;
			
			Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
				СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = Цена / Справочники.Облигации.ПолучитьНоминал(ЦеннаяБумага, ДатаПереоценки) * 100;
				//СтрокаПереоценкиЦБ.ОценочнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент;
			КонецЕсли;
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				ПараметрыРасчетаЦен = Новый Структура("МедианаКредитногоСпреда, БезрисковаяСтавкаДоходности, НаблюдаемоеЗначениеКредитногоСпреда, Цена", ЗначенияКредитногоСпреда.Медиана, БезрисковаяСтавкаДоходности, НаблюдаемоеЗначениеКредитногоСпреда, Цена);
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка СЧА ПФР", "Параметры расчета цены", ПараметрыРасчетаЦен);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ЗаполнитьПереоценкуСЧАПФРНоваяМетодика(СтрокаПереоценкиЦБ, ДатаПереоценки, СчетДоверительногоУправления, Отказ, РасшифровкаРасчета = Неопределено) Экспорт
	
	Если СтрокаПереоценкиЦБ.Стоимость <> 0 Тогда
		Возврат;	
	КонецЕсли;		
		
	УчитыватьКупонКОферте = Истина;
	ДатаРасчетаКредитногоСпреда = ДатаПереоценки;
	
	ЦеннаяБумага = СтрокаПереоценкиЦБ.ЦеннаяБумага;
	МассивИноставнныхАктивов = Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();
	ЭтоИностраннаяЦБ = МассивИноставнныхАктивов.Найти(ЦеннаяБумага.УчетныйАктивЦБРФ) <> Неопределено ИЛИ СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И ЦеннаяБумага.Подкатегория = Перечисления.ВидыГосударственныхОблигаций.ОВОЗ;
	
	ПараметрыРасчетаРейтинга = ПолучитьПараметрыРасчетаРейтингаПоУмолчанию(СчетДоверительногоУправления, ДатаПереоценки);
	ПараметрыРасчетаРейтинга.Вставить("ИсточникТаблицыСоответствияРейтингов",	Справочники.ВнешниеСистемы.Атом_РасчетСС);
	ПараметрыРасчетаРейтинга.Вставить("ТолькоНаблюдаемыеДанные",				Истина);
	ПараметрыРасчетаРейтинга.Вставить("ТолькоЭмитент",							Ложь);

	ПараметрыРасчетаКредитногоСпреда = Новый Структура;
	ПараметрыРасчетаКредитногоСпреда.Вставить("ОтклонениеКредитногоСпреда", 50); //указано в учетной политике
	
	//2.с - только для долговых российских бумаг. Для иностранных ЦБ пропускается. 
	Если СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И НЕ ЭтоИностраннаяЦБ Тогда
		
		КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(ЦеннаяБумага, ДатаРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, Отказ);
		
		Если КредитныйСпред.Количество() > 0 Тогда
			
			ПараметрыДенежногоПотока = Новый Структура;
			ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",		Ложь);
			ПараметрыДенежногоПотока.Вставить("Дата",					ДатаПереоценки);
			ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",			ДатаПереоценки);
			ПараметрыДенежногоПотока.Вставить("УчитыватьКупонКОферте",	УчитыватьКупонКОферте);
			
			ДенежныйПоток				= Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ПараметрыДенежногоПотока, СчетДоверительногоУправления, Отказ, РасшифровкаРасчета);			
			БезрисковаяСтавкаДоходности	= РаботаСПоказателямиФинансовыхИнструментов.РассчитатьБезрисковуюСтавкуДоходности(ЦеннаяБумага, ДатаПереоценки, ДенежныйПоток, Отказ);
			
			ЗначенияКредитногоСпреда			= КредитныйСпред[0];
			НаблюдаемоеЗначениеКредитногоСпреда	= ЗначенияКредитногоСпреда.Медиана;
			СтавкаДисконтирования				= Окр(БезрисковаяСтавкаДоходности + НаблюдаемоеЗначениеКредитногоСпреда / 100, 2);
			
			Цена = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтавкаДисконтирования, ДатаПереоценки)
				- Справочники.Облигации.ПолучитьКупон(ЦеннаяБумага, ДатаПереоценки, СчетДоверительногоУправления), 5);
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка СЧА ПФР (новая методика)", "Денежный поток", ДенежныйПоток.Скопировать());
				
				ПараметрыРасчетаЦен = Новый Структура("МедианаКредитногоСпреда, БезрисковаяСтавкаДоходности, НаблюдаемоеЗначениеКредитногоСпреда, Цена", ЗначенияКредитногоСпреда.Медиана, БезрисковаяСтавкаДоходности, НаблюдаемоеЗначениеКредитногоСпреда, Цена);
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка СЧА ПФР (новая методика)", "Параметры переоценки СЧА ПФР (новая методика)", ПараметрыРасчетаЦен);
			КонецЕсли;

			Если Цена > 0 Тогда
				СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
				СтрокаПереоценкиЦБ.Источник = Справочники.ЮрФизЛица.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
				СтрокаПереоценкиЦБ.УровеньОценки = 2;
				СтрокаПереоценкиЦБ.ДатаЦены = ДатаПереоценки;
				
				СтрокаПереоценкиЦБ.Стоимость = Цена;
				СтрокаПереоценкиЦБ.ВалютаКотировки = ЦеннаяБумага.ВалютаНоминала;
				
				Возврат;
			КонецЕсли;

		КонецЕсли;
		
	КонецЕсли;
	
	//3.а
	Если СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Паи И НЕ ЭтоИностраннаяЦБ Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена КАК РасчетнаяЦена,
			|	РасчетныеЦеныПаевСрезПоследних.Период КАК Период,
			|	РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо КАК ПИФ
			|ИЗ
			|	РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &Ссылка) КАК РасчетныеЦеныПаевСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
			|		ПО РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага = Паи.Ссылка
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФСрезПоследних
			|		ПО (ВЫРАЗИТЬ(РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
			|ГДЕ
			|	Паи.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
		Запрос.УстановитьПараметр("Ссылка", ЦеннаяБумага);
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
			СтрокаПереоценкиЦБ.Источник = ВыборкаДетальныеЗаписи.ПИФ;
			СтрокаПереоценкиЦБ.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.СЧА;
			СтрокаПереоценкиЦБ.УровеньОценки = 3;//возможен 2?
			СтрокаПереоценкиЦБ.ДатаЦены = ВыборкаДетальныеЗаписи.Период;
			
			СтрокаПереоценкиЦБ.Стоимость = ВыборкаДетальныеЗаписи.РасчетнаяЦена;
			СтрокаПереоценкиЦБ.ВалютаКотировки = ЦеннаяБумага.ВалютаНоминала;
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				ПараметрыРасчетаЦен = Новый Структура("РасчетнаяЦена, Период, ПИФ", ВыборкаДетальныеЗаписи.РасчетнаяЦена, ВыборкаДетальныеЗаписи.Период, ВыборкаДетальныеЗаписи.ПИФ);
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка СЧА ПФР (новая методика)", "Расчетные цены паев", ПараметрыРасчетаЦен);
			КонецЕсли;
			
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	//3.с (как 2.с, но по кредитному спреду бумаги, а не эмитента)
	КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(ЦеннаяБумага, ДатаРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, Отказ);
	Если КредитныйСпред.Количество() > 0 Тогда

		ПараметрыДенежногоПотока = Новый Структура;
		ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",		Ложь);
		ПараметрыДенежногоПотока.Вставить("Дата",					ДатаПереоценки);
		ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",			ДатаПереоценки);
		ПараметрыДенежногоПотока.Вставить("УчитыватьКупонКОферте",	УчитыватьКупонКОферте);
		
		ДенежныйПоток				= Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ПараметрыДенежногоПотока, СчетДоверительногоУправления, Отказ, РасшифровкаРасчета);
		БезрисковаяСтавкаДоходности	= РаботаСПоказателямиФинансовыхИнструментов.РассчитатьБезрисковуюСтавкуДоходности(ЦеннаяБумага, ДатаПереоценки, ДенежныйПоток, Отказ);
		
		ЗначенияКредитногоСпреда			= КредитныйСпред[0];
		НаблюдаемоеЗначениеКредитногоСпреда	= ЗначенияКредитногоСпреда.Медиана;
		СтавкаДисконтирования				= Окр(БезрисковаяСтавкаДоходности + НаблюдаемоеЗначениеКредитногоСпреда / 100, 2);
		
		Цена = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтавкаДисконтирования, ДатаПереоценки)
			- Справочники.Облигации.ПолучитьКупон(ЦеннаяБумага, ДатаПереоценки, СчетДоверительногоУправления), 5);
		
		Если Цена > 0 Тогда
			СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
			СтрокаПереоценкиЦБ.Источник = Справочники.ЮрФизЛица.ПустаяСсылка();
			СтрокаПереоценкиЦБ.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
			СтрокаПереоценкиЦБ.УровеньОценки = 3;
			СтрокаПереоценкиЦБ.ДатаЦены = ДатаПереоценки;
			
			СтрокаПереоценкиЦБ.Стоимость = Цена;
			СтрокаПереоценкиЦБ.ВалютаКотировки = ЦеннаяБумага.ВалютаНоминала;
		КонецЕсли;
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка СЧА ПФР (новая методика)", "Денежный поток", ДенежныйПоток.Скопировать());
			
			ПараметрыРасчетаЦен = Новый Структура("МедианаКредитногоСпреда, БезрисковаяСтавкаДоходности, НаблюдаемоеЗначениеКредитногоСпреда, Цена", ЗначенияКредитногоСпреда.Медиана, БезрисковаяСтавкаДоходности, НаблюдаемоеЗначениеКредитногоСпреда, Цена);
			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка СЧА ПФР (новая методика)", "Параметры переоценки СЧА ПФР (новая методика)", ПараметрыРасчетаЦен);
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПереоценкуТранснефти(СтрокаПереоценкиЦБ, ДатаПереоценки, ОбъектДокумента) Экспорт
	
	//оценим несущественность, если нет цены и возьмем средневзвес
	
	Если СтрокаПереоценкиЦБ.РыночнаяЦена = 0 И СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.ПустаяСсылка() Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага,
			|	СУММА(БухПартииЦенныхБумагОстатки.СтоимостьОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаОстаток + БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток + БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток + БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток) КАК СтоимостьЦБ
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
			|			&ДатаОценки,
			|			СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидУчета = &ВидУчета
			|				И Рынок = &Рынок
			|				И ЦеннаяБумага = &ЦеннаяБумага) КАК БухПартииЦенныхБумагОстатки
			|
			|СГРУППИРОВАТЬ ПО
			|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага
			|
			|ИМЕЮЩИЕ
			|	СУММА(БухПартииЦенныхБумагОстатки.СтоимостьОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаОстаток + БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток + БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток + БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток) <= 1000000";
		
		Запрос.УстановитьПараметр("ВидУчета", ОбъектДокумента.ВидУчета);
		Запрос.УстановитьПараметр("ДатаОценки", Новый Граница(КонецДня(ДатаПереоценки), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("Рынок", СтрокаПереоценкиЦБ.Рынок);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ЦеннаяБумага", СтрокаПереоценкиЦБ.ЦеннаяБумага);
		
		НеСущественность = Запрос.Выполнить().Выбрать();
		
		Пока НеСущественность.Следующий() Цикл
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ВЫБОР
				|		КОГДА ТИПЗНАЧЕНИЯ(&ЦеннаяБумага) = ТИП(Справочник.Облигации)
				|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE * НоминалыЦенныхБумагСрезПоследних.Номинал / 100
				|		ИНАЧЕ КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE
				|	КОНЕЦ КАК WAPRICE,
				|	КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE_DATE КАК WAPRICE_DATE,
				|	Биржи.ЮрФизЛицо КАК Источник,
				|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
				|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта КАК Валюта
				|ИЗ
				|	РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
				|			&ДатаПереоценки,
				|			Рынок = &Рынок
				|				И ЦеннаяБумага = &ЦеннаяБумага
				|				И Биржа = &ММВБ
				|				И РежимТоргов.ОсновнойРежим) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
				|		ПО КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа = Биржи.Ссылка
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследних
				|		ПО КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага";
			
			Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
			Запрос.УстановитьПараметр("ММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
			Запрос.УстановитьПараметр("Рынок", СтрокаПереоценкиЦБ.Рынок);
			Запрос.УстановитьПараметр("ЦеннаяБумага", СтрокаПереоценкиЦБ.ЦеннаяБумага);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				Если ВыборкаДетальныеЗаписи.WAPRICE>0 Тогда
					Если ВыборкаДетальныеЗаписи.WAPRICE_DATE<СтрокаПереоценкиЦБ.Партия.Дата Тогда
						Продолжить;
					КонецЕсли;
				Иначе
					Продолжить;
				КонецЕсли;
				
				СтрокаПереоценкиЦБ.ИсточникЦены = ВыборкаДетальныеЗаписи.Источник;
				СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.СредневзвешеннаяЦена;
				СтрокаПереоценкиЦБ.УровеньОценки = 3;
				СтрокаПереоценкиЦБ.ДатаКотировки = ВыборкаДетальныеЗаписи.WAPRICE_DATE;
				
				Стоимость = ВыборкаДетальныеЗаписи.WAPRICE;
				СтрокаПереоценкиЦБ.РыночнаяЦена = Стоимость;
				СтрокаПереоценкиЦБ.РыночнаяСумма = СтрокаПереоценкиЦБ.РыночнаяЦена * СтрокаПереоценкиЦБ.Количество;
				СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
				СтрокаПереоценкиЦБ.ВалютаКотировки = ВыборкаДетальныеЗаписи.Валюта;
				СтрокаПереоценкиЦБ.ОценочнаяЦена = СтрокаПереоценкиЦБ.РыночнаяЦена;
				СтрокаПереоценкиЦБ.ОценочнаяСумма = СтрокаПереоценкиЦБ.РыночнаяСумма;
				
				Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
					СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = Стоимость / ВыборкаДетальныеЗаписи.Номинал * 100;
					СтрокаПереоценкиЦБ.ОценочнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент;
				КонецЕсли;
				
			КонецЦикла;
			
	        //иначе - по приобретению
			Если СтрокаПереоценкиЦБ.РыночнаяЦена = 0 Тогда
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток + БухПартииЦенныхБумагОстатки.РасходыПриПокупкеВСтоимостиОстаток КАК ФактическиеЗатраты,
					|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
					|	НоминалыЦенныхБумагСрезПоследнихПриПокупке.Номинал КАК НоминалПриПокупке
					|ИЗ
					|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
					|			&НаКонецДня,
					|			СчетДоверительногоУправления = &СчетДоверительногоУправления
					|				И Рынок = &Рынок
					|				И ЦеннаяБумага = &ЦеннаяБумага
					|				И УчетныйАктивЕПС = &УчетныйАктивЕПС
					|				И Партия = &Партия
					|				И СтрокаПартии = &СтрокаПартии
					|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагОстатки
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследних
					|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПокупки, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследнихПриПокупке
					|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследнихПриПокупке.ЦеннаяБумага";
				
				Запрос.УстановитьПараметр("ВидУчета", ОбъектДокумента.ВидУчета);
				Запрос.УстановитьПараметр("НаКонецДня", Новый Граница(КонецДня(ДатаПереоценки), ВидГраницы.Включая));
				Запрос.УстановитьПараметр("Партия", СтрокаПереоценкиЦБ.Партия);
				Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
				Запрос.УстановитьПараметр("ДатаПокупки", НачалоДня(СтрокаПереоценкиЦБ.Партия.Дата));
				Запрос.УстановитьПараметр("Рынок", СтрокаПереоценкиЦБ.Рынок);
				Запрос.УстановитьПараметр("СтрокаПартии", СтрокаПереоценкиЦБ.СтрокаПартии);
				Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
				Запрос.УстановитьПараметр("УчетныйАктивЕПС", СтрокаПереоценкиЦБ.УчетныйАктивЕПС);
				Запрос.УстановитьПараметр("ЦеннаяБумага", СтрокаПереоценкиЦБ.ЦеннаяБумага);
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
					СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
					СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
					СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.ЦенаПриобретения;
					СтрокаПереоценкиЦБ.УровеньОценки = 3;
					СтрокаПереоценкиЦБ.ДатаКотировки = СтрокаПереоценкиЦБ.Партия.Дата;
					
					Стоимость = ВыборкаДетальныеЗаписи.ФактическиеЗатраты;
					СтрокаПереоценкиЦБ.РыночнаяЦена = Стоимость;
					СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяСумма;
					СтрокаПереоценкиЦБ.ВалютаКотировки = СтрокаПереоценкиЦБ.ЦеннаяБумага.ВалютаНоминала;
					
					Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
						СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = Стоимость / ВыборкаДетальныеЗаписи.Номинал * 100;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;

		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПереоценкуУГМКПерспективы(СтрокаПереоценкиЦБ, ДатаПереоценки, ВалютаБаланса, ОбъектДокумента) Экспорт
	
	//оценим несущественность, если нет цены и возьмем средневзвес
	
	Если СтрокаПереоценкиЦБ.РыночнаяЦена = 0 И СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.ПустаяСсылка() Тогда
		
		Если ВалютаБаланса = Неопределено Тогда
			ВалютаБаланса = РассчитатьБалансовуюСтоимостьАктивов(ДатаПереоценки, ОбъектДокумента.Организация, ОбъектДокумента.СчетДоверительногоУправления, ОбъектДокумента.ЦельРасчета);		
		КонецЕсли;		
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СУММА(БухПартииЦенныхБумагОстатки.СтоимостьОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаОстаток + БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток + БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток + БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток) КАК СтоимостьЦБ
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
			|			&ДатаОценки,
			|			СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидУчета = &ВидУчета
			|				И Рынок = &Рынок
			|				И ЦеннаяБумага = &ЦеннаяБумага) КАК БухПартииЦенныхБумагОстатки
			|
			|СГРУППИРОВАТЬ ПО
			|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага
			|
			|ИМЕЮЩИЕ
			|	СУММА(БухПартииЦенныхБумагОстатки.СтоимостьОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаОстаток + БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток + БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток + БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток) < &ВалютаБаланса * 0.03";
		
		Запрос.УстановитьПараметр("ВидУчета", ОбъектДокумента.ВидУчета);
		Запрос.УстановитьПараметр("ДатаОценки", Новый Граница(КонецДня(ДатаПереоценки),ВидГраницы.Включая));
		Запрос.УстановитьПараметр("Рынок", СтрокаПереоценкиЦБ.Рынок);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ВалютаБаланса", ВалютаБаланса);
		Запрос.УстановитьПараметр("ЦеннаяБумага", СтрокаПереоценкиЦБ.ЦеннаяБумага);
		
		НеСущественность = Запрос.Выполнить().Выбрать();
		
		Пока НеСущественность.Следующий() Цикл
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ВЫБОР
				|		КОГДА ТИПЗНАЧЕНИЯ(&ЦеннаяБумага) = ТИП(Справочник.Облигации)
				|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.CLOSE * НоминалыЦенныхБумагСрезПоследних.Номинал / 100
				|		ИНАЧЕ КотировкиТорговыхПлощадокСводныеСрезПоследних.CLOSE
				|	КОНЕЦ КАК CLOSE,
				|	КотировкиТорговыхПлощадокСводныеСрезПоследних.CLOSE_DATE КАК CLOSE_DATE,
				|	Биржи.ЮрФизЛицо КАК Источник,
				|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
				|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта КАК Валюта
				|ИЗ
				|	РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
				|			&ДатаПереоценки,
				|			Рынок = &Рынок
				|				И ЦеннаяБумага = &ЦеннаяБумага
				|				И Биржа = &ММВБ
				|				И РежимТоргов.ОсновнойРежим) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
				|		ПО КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа = Биржи.Ссылка
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследних
				|		ПО КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага";
			
			Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
			Запрос.УстановитьПараметр("ММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
			Запрос.УстановитьПараметр("Рынок", СтрокаПереоценкиЦБ.Рынок);
			Запрос.УстановитьПараметр("ЦеннаяБумага", СтрокаПереоценкиЦБ.ЦеннаяБумага);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Если ВыборкаДетальныеЗаписи.CLOSE>0 Тогда
					//Если ВыборкаДетальныеЗаписи.CLOSE_DATE<СтрокаПереоценкиЦБ.Партия.Дата Тогда
					//	Продолжить;
					//КонецЕсли;
				Иначе
					Продолжить;
				КонецЕсли;
				СтрокаПереоценкиЦБ.ИсточникЦены = ВыборкаДетальныеЗаписи.Источник;
				СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.ЦенаЗакрытия;
				СтрокаПереоценкиЦБ.УровеньОценки = 2;
				СтрокаПереоценкиЦБ.ДатаКотировки = ВыборкаДетальныеЗаписи.CLOSE_DATE;
				
				Стоимость = ВыборкаДетальныеЗаписи.CLOSE;
				СтрокаПереоценкиЦБ.РыночнаяЦена = Стоимость;
				СтрокаПереоценкиЦБ.ЦенаКотировки = Стоимость;
				СтрокаПереоценкиЦБ.ВалютаКотировки = ВыборкаДетальныеЗаписи.Валюта;
				
				Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
					
					СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = Стоимость / ВыборкаДетальныеЗаписи.Номинал * 100;
					
				КонецЕсли;
				
			КонецЦикла;
			
			//иначе - по приобретению
			Если СтрокаПереоценкиЦБ.РыночнаяЦена = 0 Тогда
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				| БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток + БухПартииЦенныхБумагОстатки.РасходыПриПокупкеВСтоимостиОстаток КАК ФактическиеЗатраты,
				| ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследних.Номинал, 0) КАК НоминалТекущий,
				| ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследнихПриПокупке.Номинал, 0) КАК НоминалПриПокупке
				|ИЗ
				| РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
				|   &НаКонецДня,
				|   СчетДоверительногоУправления = &СчетДоверительногоУправления
				|    И Рынок = &Рынок
				|    И ЦеннаяБумага = &ЦеннаяБумага
				|    И УчетныйАктивЕПС = &УчетныйАктивЕПС
				|    И Партия = &Партия
				|    И СтрокаПартии = &СтрокаПартии
				|    И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагОстатки
				|  ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследних
				|  ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
				|  ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПокупки, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследнихПриПокупке
				|  ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследнихПриПокупке.ЦеннаяБумага";
				
				Запрос.УстановитьПараметр("ВидУчета", ОбъектДокумента.ВидУчета);
				Запрос.УстановитьПараметр("НаКонецДня", Новый Граница(КонецДня(ДатаПереоценки), ВидГраницы.Включая));
				Запрос.УстановитьПараметр("Партия", СтрокаПереоценкиЦБ.Партия);
				Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
				Запрос.УстановитьПараметр("ДатаПокупки", НачалоДня(СтрокаПереоценкиЦБ.Партия.Дата));
				Запрос.УстановитьПараметр("Рынок", СтрокаПереоценкиЦБ.Рынок);
				Запрос.УстановитьПараметр("СтрокаПартии", СтрокаПереоценкиЦБ.СтрокаПартии);
				Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
				Запрос.УстановитьПараметр("УчетныйАктивЕПС", СтрокаПереоценкиЦБ.УчетныйАктивЕПС);
				Запрос.УстановитьПараметр("ЦеннаяБумага", СтрокаПереоценкиЦБ.ЦеннаяБумага);
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					
					СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
					СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
					СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.ЦенаПриобретения;
					СтрокаПереоценкиЦБ.УровеньОценки = 3;
					СтрокаПереоценкиЦБ.ДатаКотировки = СтрокаПереоценкиЦБ.Партия.Дата;
					
					Стоимость = ВыборкаДетальныеЗаписи.ФактическиеЗатраты;
					
					Если ВыборкаДетальныеЗаписи.НоминалПриПокупке = 0 Тогда
						
						СтрокаПереоценкиЦБ.РыночнаяЦена = Стоимость;
						
						Если ТипЗнч(ОбъектДокумента) = Тип("Структура") Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определен номинал для ценной бумаги " + СтрокаПереоценкиЦБ.ЦеннаяБумага.Наименование);
						Иначе
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определен номинал для ценной бумаги " + СтрокаПереоценкиЦБ.ЦеннаяБумага.Наименование, ОбъектДокумента.Ссылка);
						КонецЕсли;
						
					Иначе
						
						СтрокаПереоценкиЦБ.РыночнаяЦена = Стоимость * ВыборкаДетальныеЗаписи.НоминалТекущий / ВыборкаДетальныеЗаписи.НоминалПриПокупке;
						
					КонецЕсли;
					
					Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
						
						СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = Стоимость / ВыборкаДетальныеЗаписи.НоминалТекущий * 100;
						
					КонецЕсли;
					
					СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
					СтрокаПереоценкиЦБ.ВалютаКотировки =  СтрокаПереоценкиЦБ.ЦеннаяБумага.ВалютаКотировки;
					
				КонецЦикла;
			КонецЕсли
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПереоценкуУГМКПерспективы2018(СтрокаПереоценкиЦБ, ДатаПереоценки, ВалютаБаланса, ТаблицаДатИЦенПокупки, ОбъектДокумента, Отказ, РасшифровкаРасчета = Неопределено) Экспорт
	
	//оценим несущественность, если нет цены и возьмем средневзвес
	
	Если СтрокаПереоценкиЦБ.ЦенаКотировки <> 0 ИЛИ СтрокаПереоценкиЦБ.ПолеЦены <> Перечисления.ИсточникиЦеныДляПереоценки.ПустаяСсылка() Тогда
		Возврат;	
	КонецЕсли;
	
	Если ДатаПереоценки < Дата(2018, 9, 1) Тогда
		
		//с 2018 года существенность 5%
		
		Если ВалютаБаланса = Неопределено Тогда
			ВалютаБаланса = РассчитатьБалансовуюСтоимостьАктивов(ДатаПереоценки, ОбъектДокумента.Организация, ОбъектДокумента.СчетДоверительногоУправления, ОбъектДокумента.ЦельРасчета);		
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СУММА(БухПартииЦенныхБумагОстатки.СтоимостьОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаОстаток + БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток + БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток + БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток) КАК СтоимостьЦБ
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
			|			&ДатаОценки,
			|			СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидУчета = &ВидУчета
			|				И Рынок = &Рынок
			|				И ЦеннаяБумага = &ЦеннаяБумага) КАК БухПартииЦенныхБумагОстатки
			|
			|СГРУППИРОВАТЬ ПО
			|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага
			|
			|ИМЕЮЩИЕ
			|	СУММА(БухПартииЦенныхБумагОстатки.СтоимостьОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаОстаток + БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток + БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток + БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток) < &ВалютаБаланса * 0.05";
		
		Запрос.УстановитьПараметр("ВидУчета", ОбъектДокумента.ВидУчета);
		Запрос.УстановитьПараметр("ДатаОценки", Новый Граница(КонецДня(ДатаПереоценки),ВидГраницы.Включая));
		Запрос.УстановитьПараметр("Рынок", СтрокаПереоценкиЦБ.Рынок);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ВалютаБаланса", ВалютаБаланса);
		Запрос.УстановитьПараметр("ЦеннаяБумага", СтрокаПереоценкиЦБ.ЦеннаяБумага);
		
		НеСущественность = Запрос.Выполнить().Выбрать().Следующий();
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СУММА(БухПартииЦенныхБумагОстатки.СтоимостьОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаОстаток + БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток + БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток + БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток) КАК СтоимостьЦБЭтогоВида
			|ПОМЕСТИТЬ _СтоимостьБумаг
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
			|			&ДатаОценки,
			|			СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидУчета = &ВидУчета
			|				И ВЫБОР
			|					КОГДА (&Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
			|							ИЛИ &Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))
			|							И (Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
			|								ИЛИ Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))
			|						ТОГДА ИСТИНА
			|					КОГДА &Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|							И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|						ТОГДА ИСТИНА
			|					ИНАЧЕ ЛОЖЬ
			|				КОНЕЦ) КАК БухПартииЦенныхБумагОстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СУММА(БухПартииЦенныхБумагОстатки.СтоимостьОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаОстаток + БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток + БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток + БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток) КАК СтоимостьЦБ,
			|	СтоимостьБумаг.СтоимостьЦБЭтогоВида КАК СтоимостьЦБЭтогоВида
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
			|			&ДатаОценки,
			|			СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидУчета = &ВидУчета
			|				И Рынок = &Рынок
			|				И ЦеннаяБумага = &ЦеннаяБумага) КАК БухПартииЦенныхБумагОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ _СтоимостьБумаг КАК СтоимостьБумаг
			|		ПО (ИСТИНА)
			|
			|СГРУППИРОВАТЬ ПО
			|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага,
			|	СтоимостьБумаг.СтоимостьЦБЭтогоВида";
		
		Запрос.УстановитьПараметр("ВидУчета", ОбъектДокумента.ВидУчета);
		Запрос.УстановитьПараметр("ДатаОценки", Новый Граница(КонецДня(ДатаПереоценки),ВидГраницы.Включая));
		Запрос.УстановитьПараметр("Рынок", СтрокаПереоценкиЦБ.Рынок);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ЦеннаяБумага", СтрокаПереоценкиЦБ.ЦеннаяБумага);
		
		НеСущественность = Ложь;
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			НеСущественность =  ВыборкаДетальныеЗаписи.СтоимостьЦБ/ВыборкаДетальныеЗаписи.СтоимостьЦБЭтогоВида < 0.05;
		КонецЕсли;
		
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		ПараметрыРасчетаЦен = Новый Структура("НеСущественность", НеСущественность);
	КонецЕсли;
	
	Если НеСущественность Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(&ЦеннаяБумага) = ТИП(Справочник.Облигации)
			|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.LEGALCLOSEPRICE * НоминалыЦенныхБумагСрезПоследних.Номинал / 100
			|		ИНАЧЕ КотировкиТорговыхПлощадокСводныеСрезПоследних.LEGALCLOSEPRICE
			|	КОНЕЦ КАК LEGALCLOSEPRICE,
			|	КотировкиТорговыхПлощадокСводныеСрезПоследних.LEGALCLOSEPRICE_DATE КАК LEGALCLOSEPRICE_DATE,
			|	Биржи.ЮрФизЛицо КАК Источник,
			|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
			|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта КАК Валюта
			|ИЗ
			|	РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
			|			&ДатаПереоценки,
			|			Рынок = &Рынок
			|				И ЦеннаяБумага = &ЦеннаяБумага
			|				И Биржа = &ММВБ
			|				И РежимТоргов.ОсновнойРежим) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
			|		ПО КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа = Биржи.Ссылка
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследних
			|		ПО КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага";
		
		Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
		Запрос.УстановитьПараметр("ММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
		Запрос.УстановитьПараметр("Рынок", СтрокаПереоценкиЦБ.Рынок);
		Запрос.УстановитьПараметр("ЦеннаяБумага", СтрокаПереоценкиЦБ.ЦеннаяБумага);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ВыборкаДетальныеЗаписи.LEGALCLOSEPRICE > 0 Тогда
				Если ВыборкаДетальныеЗаписи.LEGALCLOSEPRICE_DATE < НачалоДня(СтрокаПереоценкиЦБ.Партия.Дата) И ДатаПереоценки > Дата(2018, 9, 1) Тогда 
					Продолжить;
				КонецЕсли;
			Иначе
				Продолжить;
			КонецЕсли;
			
			СтрокаПереоценкиЦБ.Биржа 			= Справочники.Биржи.ПустаяСсылка();
			СтрокаПереоценкиЦБ.ИсточникЦены 	= ВыборкаДетальныеЗаписи.Источник;
			СтрокаПереоценкиЦБ.ПолеЦены 		= Перечисления.ИсточникиЦеныДляПереоценки.ЦенаЗакрытия;
			СтрокаПереоценкиЦБ.УровеньОценки 	= 2;
			СтрокаПереоценкиЦБ.ДатаКотировки 	= ВыборкаДетальныеЗаписи.LEGALCLOSEPRICE_DATE;
			
			Стоимость 							= ВыборкаДетальныеЗаписи.LEGALCLOSEPRICE;
			СтрокаПереоценкиЦБ.РыночнаяЦена 	= Стоимость;
			СтрокаПереоценкиЦБ.ЦенаКотировки 	= СтрокаПереоценкиЦБ.РыночнаяЦена;
			СтрокаПереоценкиЦБ.ВалютаКотировки 	= ВыборкаДетальныеЗаписи.Валюта;
			СтрокаПереоценкиЦБ.РыночнаяСумма 	= СтрокаПереоценкиЦБ.РыночнаяЦена * СтрокаПереоценкиЦБ.Количество;
			СтрокаПереоценкиЦБ.ОценочнаяЦена 	= СтрокаПереоценкиЦБ.РыночнаяЦена;
			СтрокаПереоценкиЦБ.ОценочнаяСумма 	= СтрокаПереоценкиЦБ.РыночнаяСумма;
			
			Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
				СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент 	= Стоимость / ВыборкаДетальныеЗаписи.Номинал * 100;
				СтрокаПереоценкиЦБ.ОценочнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент;
				СтрокаПереоценкиЦБ.ВалютаКотировки 		= СтрокаПереоценкиЦБ.ЦеннаяБумага.ВалютаНоминала;
			КонецЕсли;
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				ПараметрыРасчетаЦен.Вставить("ПолеЦены", "LEGALCLOSEPRICE");
				ПараметрыРасчетаЦен.Вставить("РыночнаяЦена", Стоимость);
			КонецЕсли;			
			
		КонецЦикла;
		
		//иначе - по приобретению
		
		Если СтрокаПереоценкиЦБ.ЦенаКотировки = 0 Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток + БухПартииЦенныхБумагОстатки.РасходыПриПокупкеВСтоимостиОстаток КАК ФактическиеЗатраты,
				|	ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследних.Номинал, 0) КАК НоминалТекущий,
				|	ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследнихПриПокупке.Номинал, 0) КАК НоминалПриПокупке,
				|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК КоличествоОстаток
				|ИЗ
				|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
				|			&НаКонецДня,
				|			СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И Рынок = &Рынок
				|				И ЦеннаяБумага = &ЦеннаяБумага
				|				И УчетныйАктивЕПС = &УчетныйАктивЕПС
				|				И Партия = &Партия
				|				И СтрокаПартии = &СтрокаПартии
				|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагОстатки
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследних
				|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПокупки, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследнихПриПокупке
				|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследнихПриПокупке.ЦеннаяБумага";
			
			Запрос.УстановитьПараметр("ВидУчета", ОбъектДокумента.ВидУчета);
			Запрос.УстановитьПараметр("НаКонецДня", Новый Граница(КонецДня(ДатаПереоценки), ВидГраницы.Включая));
			Запрос.УстановитьПараметр("Партия", СтрокаПереоценкиЦБ.Партия);
			Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
			Запрос.УстановитьПараметр("ДатаПокупки", НачалоДня(СтрокаПереоценкиЦБ.Партия.Дата));
			Запрос.УстановитьПараметр("Рынок", СтрокаПереоценкиЦБ.Рынок);
			Запрос.УстановитьПараметр("СтрокаПартии", СтрокаПереоценкиЦБ.СтрокаПартии);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("УчетныйАктивЕПС", СтрокаПереоценкиЦБ.УчетныйАктивЕПС);
			Запрос.УстановитьПараметр("ЦеннаяБумага", СтрокаПереоценкиЦБ.ЦеннаяБумага);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
				СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.ЦенаПриобретения;
				СтрокаПереоценкиЦБ.УровеньОценки = ?(ДатаПереоценки>= Дата(2019,1,1),1,3);
				СтрокаПереоценкиЦБ.ДатаКотировки = СтрокаПереоценкиЦБ.Партия.Дата;
				
				Стоимость = ВыборкаДетальныеЗаписи.ФактическиеЗатраты;
				КоличествоОстаток = ВыборкаДетальныеЗаписи.КоличествоОстаток;
				
				Если ВыборкаДетальныеЗаписи.НоминалПриПокупке = 0 Тогда
					
					СтрокаПереоценкиЦБ.РыночнаяЦена = Стоимость / КоличествоОстаток;
					//СтрокаПереоценкиЦБ.РыночнаяСумма = СтрокаПереоценкиЦБ.РыночнаяЦена * СтрокаПереоценкиЦБ.Количество;
					
					Если ТипЗнч(ОбъектДокумента) = Тип("Структура") Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определен номинал для ценной бумаги " + СтрокаПереоценкиЦБ.ЦеннаяБумага.Наименование);
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определен номинал для ценной бумаги " + СтрокаПереоценкиЦБ.ЦеннаяБумага.Наименование, ОбъектДокумента.Ссылка);
					КонецЕсли;
					
				Иначе
					
					СтрокаПереоценкиЦБ.РыночнаяЦена = Стоимость * ВыборкаДетальныеЗаписи.НоминалТекущий / ВыборкаДетальныеЗаписи.НоминалПриПокупке / КоличествоОстаток;
					//СтрокаПереоценкиЦБ.РыночнаяСумма = СтрокаПереоценкиЦБ.РыночнаяЦена * СтрокаПереоценкиЦБ.Количество * ВыборкаДетальныеЗаписи.НоминалТекущий / ВыборкаДетальныеЗаписи.НоминалПриПокупке;
					
				КонецЕсли;
				
				Если ТипЗнч(СтрокаПереоценкиЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
					СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = Стоимость / ВыборкаДетальныеЗаписи.НоминалТекущий * 100;
				КонецЕсли;
				
				СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
				СтрокаПереоценкиЦБ.ВалютаКотировки = СтрокаПереоценкиЦБ.ЦеннаяБумага.ВалютаНоминала;
				
				Если РасшифровкаРасчета <> Неопределено Тогда
					ПараметрыРасчетаЦен.Вставить("ПолеЦены", "ЦенаПриобретения");
					ПараметрыРасчетаЦен.Вставить("РыночнаяЦена", Стоимость / КоличествоОстаток);
				КонецЕсли;
			
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		
		//существенность!!!
		
	КонецЕсли;
			
	Если СтрокаПереоценкиЦБ.ЦенаКотировки = 0 и СтрокаПереоценкиЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		
		ИностранныеАктивы = Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();
		
		Если ИностранныеАктивы.Найти(СтрокаПереоценкиЦБ.ЦеннаяБумага.УчетныйАктивЦБРФ) = Неопределено
			И СтрокаПереоценкиЦБ.ЦеннаяБумага.Категория <> Перечисления.КатегорииОблигаций.Еврооблигация
		Тогда
		
			ПараметрыДенежногоПотока = Новый Структура;
			ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",		Ложь);
			ПараметрыДенежногоПотока.Вставить("Дата",					ДатаПереоценки);
			ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",			ДатаПереоценки);
			
			ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(СтрокаПереоценкиЦБ.ЦеннаяБумага, ПараметрыДенежногоПотока, ОбъектДокумента, Отказ, РасшифровкаРасчета);
			ДоходностьКПогашению = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьНоминальнуюБезрисковуюСтавкуДоходности(СтрокаПереоценкиЦБ.ЦеннаяБумага, ДатаПереоценки, ДенежныйПоток, Ложь);
			
			Если ТаблицаДатИЦенПокупки = Неопределено Тогда
				ТаблицаДатИЦенПокупки = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(СтрокаПереоценкиЦБ.Владелец(), ОбъектДокумента.СчетДоверительногоУправления, ДатаПереоценки).Выгрузить();
			КонецЕсли;
			
			СтрокиПокупки = ТаблицаДатИЦенПокупки.НайтиСтроки(Новый Структура("ЦеннаяБумага,Партия,СтрокаПартии", СтрокаПереоценкиЦБ.ЦеннаяБумага, СтрокаПереоценкиЦБ.Партия, СтрокаПереоценкиЦБ.СтрокаПартии));
			Если СтрокиПокупки.Количество() = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдены цена и дата покупки для ЦБ " + СтрокаПереоценкиЦБ.ЦеннаяБумага + " из партии " + СтрокаПереоценкиЦБ.Партия + ", строка " + СтрокаПереоценкиЦБ.СтрокаПартии, ?(ТипЗнч(ОбъектДокумента) = Тип("Структура"), Неопределено, ОбъектДокумента.Ссылка), , , Отказ);
				Возврат;
			КонецЕсли;
			
			ДатаПокупки = СтрокиПокупки[0].ДатаПокупки;
			ЦенаПокупки = СтрокиПокупки[0].ЦенаПокупки;

			ДоходностьИДюрация = Справочники.Облигации.ПолучитьДоходностьИДюрацию(СтрокаПереоценкиЦБ.ЦеннаяБумага, Ложь, ДатаПокупки, ЦенаПокупки, ОбъектДокумента.СчетДоверительногоУправления, , ДатаПереоценки);
			Дюрация = ДоходностьИДюрация.Дюрация;
			ДюрацияВГодах = Дюрация / 365;
			
			#Область Подбор_соответствующего_бумаге_индекса
			
			КодИндекса = "";
			
			Если СтрокаПереоценкиЦБ.ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Государственная Тогда
				
				Если ДюрацияВГодах < 1 Тогда
					КодИндекса = "RUGBITR1Y";
				ИначеЕсли ДюрацияВГодах < 3 Тогда
					КодИндекса = "RUGBITR3Y";
				ИначеЕсли ДюрацияВГодах < 5 Тогда
					КодИндекса = "RUGBITR5Y";
				ИначеЕсли ДюрацияВГодах < 10 Тогда
					КодИндекса = "RUGBITR10Y";
				Иначе
					КодИндекса = "RUGBITR5+";
				КонецЕсли;
				
			Иначе
				
				// Определим рейтинг
				
				ПараметрыРасчетаРейтинга = Новый Структура;
				ПараметрыРасчетаРейтинга.Вставить("РейтингЦеннойБумаги",					Истина);
				ПараметрыРасчетаРейтинга.Вставить("ИсточникТаблицыСоответствияРейтингов",	Справочники.ВнешниеСистемы.УГМК_Перспектива);
				ПараметрыРасчетаРейтинга.Вставить("ТолькоНаблюдаемыеДанные",				Ложь);
				ПараметрыРасчетаРейтинга.Вставить("КоличествоРейтинговыхГрупп",				4);
				
				ГруппаРейтингов = РаботаСПоказателямиФинансовыхИнструментов.ОпределитьРейтинговуюГруппу(СтрокаПереоценкиЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыРасчетаРейтинга, , РасшифровкаРасчета);
				
				Если СтрокаПереоценкиЦБ.ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Корпоративная Тогда
					
					Если ДюрацияВГодах < 1 Тогда
						КодИндекса = "RUCBITR1Y";
					ИначеЕсли ДюрацияВГодах < 3 Тогда
						Если ГруппаРейтингов = 1 Тогда
							КодИндекса = "RUCBITRBBB3Y";
						ИначеЕсли ГруппаРейтингов = 2 Тогда
							КодИндекса = "RUCBITRBB3Y";
						ИначеЕсли ГруппаРейтингов = 3 Тогда
							КодИндекса = "RUCBITRB3Y";
						Иначе
							КодИндекса = "RUCBTR3Y";
						КонецЕсли;
					ИначеЕсли ДюрацияВГодах < 5 Тогда
						Если ГруппаРейтингов = 1 Тогда
							КодИндекса = "RUCBITRBBB5Y";
						ИначеЕсли ГруппаРейтингов = 2 Тогда
							КодИндекса = "RUCBITRBB5Y";
						Иначе
							КодИндекса = "RUCBTR5Y";
						КонецЕсли;
					Иначе
						Если ГруппаРейтингов = 1 Тогда
							КодИндекса = "RUCBITRBBB3+";
						ИначеЕсли ГруппаРейтингов = 2 Тогда
							КодИндекса = "RUCBITRBB3+";
						Иначе
							КодИндекса = "RUCBITR3+";
						КонецЕсли;
					КонецЕсли;
					
				ИначеЕсли СтрокаПереоценкиЦБ.ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Муниципальная
					ИЛИ СтрокаПереоценкиЦБ.ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Субфедеральная
				Тогда
				
					Если ДюрацияВГодах < 1 Тогда
						КодИндекса = "RUMBITR1Y";
					ИначеЕсли ДюрацияВГодах < 3 Тогда
						Если ГруппаРейтингов = 1 Тогда
							КодИндекса = "RUMBITRBBB3Y";
						ИначеЕсли ГруппаРейтингов = 2 Тогда
							КодИндекса = "RUMBITRBB3Y";
						Иначе
							КодИндекса = "RUMBITR3Y";
						КонецЕсли;
					Иначе
						Если ГруппаРейтингов = 1 Тогда
							КодИндекса = "RUMBITRBBB3+";
						Иначе
							КодИндекса = "RUMBITR3+ ";
						КонецЕсли;
					КонецЕсли;
					
				ИначеЕсли СтрокаПереоценкиЦБ.ЦеннаяБумага.Категория <> Перечисления.КатегорииОблигаций.Ипотечная Тогда
					
					КодИндекса = "RUABITR";
					
				Иначе
					
					// еврооблигации 
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если КодИндекса = ""  Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлено соответствие бумаги " + СтрокаПереоценкиЦБ.ЦеннаяБумага + " индексу. Цена не будет рассчитана");
				Возврат;
			КонецЕсли;
			
			#КонецОбласти
			
			ЗначениеИндекса = РегистрыСведений.ЗначенияБиржевыхИндексов.ПолучитьПоследнее(ДатаПереоценки, Новый Структура("Биржа, БиржевойИндекс", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"), Справочники.БиржевыеИндексы.НайтиПоКоду(КодИндекса)));
			ДоходностьИндекса = ЗначениеИндекса.YIELD;
			ДоходностьПоДюрации = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьЗначениеКривойБескупоннойДоходности(ДатаПереоценки, Дюрация, , Отказ);
			
			ПремияЗаКредитныйРиск = ДоходностьИндекса - ДоходностьПоДюрации;
			СтавкаДисконтирования = ?(ДатаПереоценки > Дата(2019,01,01), ДоходностьИндекса, ДоходностьКПогашению + ПремияЗаКредитныйРиск);
			
			СтрокаПереоценкиЦБ.РыночнаяЦена = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтавкаДисконтирования, ДатаПереоценки)
				- Справочники.Облигации.ПолучитьКупон(СтрокаПереоценкиЦБ.ЦеннаяБумага, ДатаПереоценки, ОбъектДокумента.СчетДоверительногоУправления);
			
			СтрокаПереоценкиЦБ.Биржа = Справочники.Биржи.ПустаяСсылка();
			СтрокаПереоценкиЦБ.ИсточникЦены = Справочники.ЮрФизЛица.ПустаяСсылка();
			СтрокаПереоценкиЦБ.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
			СтрокаПереоценкиЦБ.УровеньОценки = 3;
			СтрокаПереоценкиЦБ.ДатаКотировки = ДатаПереоценки;
			СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент = СтрокаПереоценкиЦБ.РыночнаяЦена / Справочники.Облигации.ПолучитьНоминал(СтрокаПереоценкиЦБ.ЦеннаяБумага, ДатаПереоценки) * 100;
			СтрокаПереоценкиЦБ.ЦенаКотировки = СтрокаПереоценкиЦБ.РыночнаяЦена;
			СтрокаПереоценкиЦБ.ВалютаКотировки = СтрокаПереоценкиЦБ.ВалютаНоминала;
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				ПараметрыРасчетаЦен.Вставить("КодИндекса", КодИндекса);
				ПараметрыРасчетаЦен.Вставить("ДоходностьКПогашению", ДоходностьКПогашению);
				ПараметрыРасчетаЦен.Вставить("Дюрация", Дюрация);
				ПараметрыРасчетаЦен.Вставить("ДоходностьИндекса", ДоходностьИндекса);
				ПараметрыРасчетаЦен.Вставить("ДоходностьПоДюрации", ДоходностьПоДюрации);
				ПараметрыРасчетаЦен.Вставить("ПремияЗаКредитныйРиск", ПремияЗаКредитныйРиск);
			КонецЕсли;

		КонецЕсли;
		
	КонецЕсли;
				
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Переоценка УГМК Перспективы 2018", "Параметры расчета цены", ПараметрыРасчетаЦен);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Заполнить_первичное_размещение

Функция ПолучитьЦенуРазмещения(ЦеннаяБумага, Сделка, ДатаПереоценки, ДатаСделки = Неопределено, ПараметрыЦены, РасшифровкаРасчета = Неопределено)
	
	Перем ЦенаРазмещения; 	
	
	Запрос = Новый Запрос(			
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	НАЧАЛОПЕРИОДА(Сделка.Дата, ДЕНЬ) КАК ДатаКотировки,
		|	Сделка.ВалютаСделки КАК ВалютаКотировки,
		|	ЦенныеБумагиСделки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЦенныеБумагиСделки.Цена КАК ЦенаПокупки,
		|	НоминалыЦенныхБумаг.Номинал КАК Номинал,
		|	НоминалыЦенныхБумагПриПокупке.Номинал КАК НоминалПриПокупке,
		|	КлючевыеСтавкиЦБРФ.ЗначениеПоказателя КАК КлючеваяСтавка,
		|	КлючевыеСтавкиЦБРФПриПокупке.ЗначениеПоказателя КАК КлючеваяСтавкаПриПокупке
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.ЦенныеБумаги КАК ЦенныеБумагиСделки
		|		ПО (ЦенныеБумагиСделки.Ссылка = Сделка.Ссылка)
		|			И (ЦенныеБумагиСделки.ЦеннаяБумага = &ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумаг
		|		ПО (НоминалыЦенныхБумаг.ЦеннаяБумага = ЦенныеБумагиСделки.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаСделки, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагПриПокупке
		|		ПО (НоминалыЦенныхБумагПриПокупке.ЦеннаяБумага = ЦенныеБумагиСделки.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
		|			ПроцентныеПоказатели.ЗначениеПоказателя КАК ЗначениеПоказателя
		|		ИЗ
		|			РегистрСведений.ПроцентныеПоказатели КАК ПроцентныеПоказатели
		|		ГДЕ
		|			&ПропорциональноИзменениюКлючевойСтавки
		|			И ПроцентныеПоказатели.Показатель = ЗНАЧЕНИЕ(Перечисление.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ)
		|			И ПроцентныеПоказатели.Прогноз = ЛОЖЬ
		|			И ПроцентныеПоказатели.Период <= &ДатаПереоценки
		|			И ПроцентныеПоказатели.ДатаЗначения <= &ДатаПереоценки
		|	
		|		УПОРЯДОЧИТЬ ПО
		|			ПроцентныеПоказатели.ДатаЗначения УБЫВ,
		|			ПроцентныеПоказатели.Период УБЫВ) КАК КлючевыеСтавкиЦБРФ
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
		|			ПроцентныеПоказатели.ЗначениеПоказателя КАК ЗначениеПоказателя
		|		ИЗ
		|			РегистрСведений.ПроцентныеПоказатели КАК ПроцентныеПоказатели
		|		ГДЕ
		|			&ПропорциональноИзменениюКлючевойСтавки
		|			И ПроцентныеПоказатели.Показатель = ЗНАЧЕНИЕ(Перечисление.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ)
		|			И ПроцентныеПоказатели.Прогноз = ЛОЖЬ
		|			И ПроцентныеПоказатели.Период <= &ДатаСделки
		|			И ПроцентныеПоказатели.ДатаЗначения <= &ДатаСделки
		|	
		|		УПОРЯДОЧИТЬ ПО
		|			ПроцентныеПоказатели.ДатаЗначения УБЫВ,
		|			ПроцентныеПоказатели.Период УБЫВ) КАК КлючевыеСтавкиЦБРФПриПокупке
		|		ПО (ИСТИНА)
		|ГДЕ
		|	Сделка.Ссылка = &Сделка");
	
	ПропорциональноИзменениюКлючевойСтавки = ПараметрыЦены.Свойство("ПропорциональноИзменениюКлючевойСтавки") И ПараметрыЦены.ПропорциональноИзменениюКлючевойСтавки; 
	
	Запрос.УстановитьПараметр("Сделка",									Сделка);
	Запрос.УстановитьПараметр("ДатаСделки",								?(ДатаСделки = Неопределено, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сделка, "Дата"), ДатаСделки));
	Запрос.УстановитьПараметр("ЦеннаяБумага",							ЦеннаяБумага);			
	Запрос.УстановитьПараметр("ДатаПереоценки",							ДатаПереоценки);
	Запрос.УстановитьПараметр("ПропорциональноИзменениюКлючевойСтавки",	ПропорциональноИзменениюКлючевойСтавки);	
	
	РезультатЗапроса = Запрос.Выполнить();	
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		ЦенаРазмещения						= РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(РезультатЗапроса.Выгрузить()[0]);
		КоэффициентИзмененияКлючевойСтавки	= ?(ПропорциональноИзменениюКлючевойСтавки, ЦенаРазмещения.КлючеваяСтавка / ЦенаРазмещения.КлючеваяСтавкаПриПокупке, 1);
		
		ЭтоОблигация						= (ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Облигации"));
		КоэффициентИзмененияНоминала		= ?(ЭтоОблигация, ЦенаРазмещения.Номинал / ЦенаРазмещения.НоминалПриПокупке, 1);
		
		ЦенаРазмещения.Вставить("РыночнаяЦена",			ЦенаРазмещения.ЦенаПокупки * КоэффициентИзмененияНоминала * КоэффициентИзмененияКлючевойСтавки);
		ЦенаРазмещения.Вставить("РыночнаяЦенаПроцент",	?(ЭтоОблигация, ЦенаРазмещения.РыночнаяЦена / ЦенаРазмещения.Номинал * 100, 0));
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "", "Цена размещения" + ?(ПропорциональноИзменениюКлючевойСтавки, ", скорректированная пропорционально на изменение ключевой ставки Банка России", ""), ЦенаРазмещения);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЦенаРазмещения;
	
КонецФункции

Функция ПолучитьСвойстваСделкиСПервичнымРазмещениемЦенныхБумаг(Партия)
	
	Если ТипЗнч(Партия) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
		Сделка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Партия, "Основание");
	Иначе
		Сделка = Партия;
	КонецЕсли;
		
	Если ТипЗнч(Сделка) = Тип("ДокументСсылка.Сделка") Тогда
		СвойстваСделки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Сделка,
			Новый Структура("Дата, ПервичноеРазмещение, Сделка, Аукцион, МестоХранения, Биржа", "Дата", "РежимБиржевыхТоргов.ПервичноеРазмещение", "Ссылка", "РежимБиржевыхТоргов.Аукцион", "МестоХранения", "МестоХранения.Биржа"));
	Иначе
		СвойстваСделки = Новый Структура("ПервичноеРазмещение", Ложь); // Первичное размещение только у обычных сделок, поэтому свойства других сделок нам не интересны
	КонецЕсли;	
	
	Возврат ?(СвойстваСделки.ПервичноеРазмещение, СвойстваСделки, Неопределено);	
		
КонецФункции

Функция ПолучитьСделкиСПервичнымРазмещениемЦенныхБумаг(ТаблицаПереоценкиЦБ)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаПереоценкиЦБ.Партия КАК Партия
		|ПОМЕСТИТЬ _Партии
		|ИЗ
		|	&ТаблицаПереоценкиЦБ КАК ТаблицаПереоценкиЦБ
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(ТаблицаПереоценкиЦБ.Партия) В (ТИП(Документ.Сделка), ТИП(Документ.ИсполнениеОбязательствПоСделке))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Партия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Партии.Партия КАК Партия,
		|	ИсполнениеОбязательствПоСделке.Основание КАК Сделка
		|ПОМЕСТИТЬ _Сделки
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Партии КАК _Партии
		|		ПО (_Партии.Партия = ИсполнениеОбязательствПоСделке.Ссылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_Партии.Партия,
		|	_Партии.Партия
		|ИЗ
		|	_Партии КАК _Партии
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(_Партии.Партия) = ТИП(Документ.Сделка)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Сделка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Сделки.Партия КАК Партия,
		|	ДокументСделка.Ссылка КАК Сделка,
		|	ДокументСделка.Дата КАК Дата,
		|	ДокументСделка.РежимБиржевыхТоргов.ПервичноеРазмещение КАК ПервичноеРазмещение,
		|	ДокументСделка.РежимБиржевыхТоргов.Аукцион КАК Аукцион,
		|	ДокументСделка.МестоХранения КАК МестоХранения,
		|	ДокументСделка.МестоХранения.Биржа КАК Биржа
		|ИЗ
		|	Документ.Сделка КАК ДокументСделка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Сделки КАК _Сделки
		|		ПО (_Сделки.Сделка = ДокументСделка.Ссылка)
		|ГДЕ
		|	ДокументСделка.РежимБиржевыхТоргов.ПервичноеРазмещение = ИСТИНА");
	
	Запрос.УстановитьПараметр("ТаблицаПереоценкиЦБ", ТаблицаПереоценкиЦБ);
	
	СделкиСПервичнымРазмещением = Запрос.Выполнить().Выгрузить();
	СделкиСПервичнымРазмещением.Индексы.Добавить("Партия");
	
	Возврат СделкиСПервичнымРазмещением;	
	
КонецФункции

