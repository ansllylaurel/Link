		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ВсеАналоги КАК _ВсеАналоги
		|		ПО (_ВсеАналоги.ЦеннаяБумага = _АнализируемыеЦенныеБумаги.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СведенияОТоргахАналогами КАК _СведенияОТоргахАналогами
		|		ПО (_СведенияОТоргахАналогами.ЦеннаяБумага = _ВсеАналоги.Аналог)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.ЦеннаяБумага = _ВсеАналоги.Аналог)
		|			И (КотировкиТорговыхПлощадок.Рынок = _ВсеАналоги.Рынок)
		|			И (КотировкиТорговыхПлощадок.Биржа = _АнализируемыеЦенныеБумаги.Биржа)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадок.Период = _СведенияОТоргахАналогами.Дата)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КурсыВалют.Валюта = КотировкиТорговыхПлощадок.Валюта)
		|			И (КурсыВалют.Период = &Период)
		|
		|СГРУППИРОВАТЬ ПО
		|	_АнализируемыеЦенныеБумаги.ЦеннаяБумага,
		|	_АнализируемыеЦенныеБумаги.Биржа,
		|	_ВсеАналоги.Аналог
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АнализируемыеЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ВсеАналоги.Аналог КАК Аналог,
		|	_ВсеАналоги.ISINАналога КАК ISINАналога,
		|	_ВсеАналоги.ДюрацияАналога КАК ДюрацияАналога,
		|	_ВсеАналоги.ГруппаДюрацииАналога КАК ГруппаДюрацииАналога,
		|	_ВсеАналоги.ГруппаРейтингаЭмитентаАналога КАК ГруппаРейтингаЭмитента,
		|	_ВсеАналоги.ГруппаПоТипуЭмитентаАналога КАК ГруппаПоТипуЭмитента,
		|	_ВсеАналоги.ВалютаНоминалаАналога КАК ВалютаНоминала,
		|	_ВсеАналоги.ОтрасльАналога КАК Отрасль,
		|	_ОбъемСделокПоАналогам.ОбъемСделокВВалютеУчета КАК ОбъемСделокВВалютеУчета
		|ПОМЕСТИТЬ _НайденныеАналоги
		|ИЗ
		|	_АнализируемыеЦенныеБумаги КАК _АнализируемыеЦенныеБумаги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ВсеАналоги КАК _ВсеАналоги
		|		ПО _АнализируемыеЦенныеБумаги.ЦеннаяБумага = _ВсеАналоги.ЦеннаяБумага
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ОбъемСделокПоАналогам КАК _ОбъемСделокПоАналогам
		|		ПО (_ОбъемСделокПоАналогам.ЦеннаяБумага = _ВсеАналоги.ЦеннаяБумага)
		|			И (_ОбъемСделокПоАналогам.Аналог = _ВсеАналоги.Аналог)
		|			И (_ОбъемСделокПоАналогам.ПроверкаПройдена)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ПОМЕСТИТЬ _КоличествоНайденныхАналогов
		|ИЗ
		|	_НайденныеАналоги КАК _НайденныеАналоги";	
	
	#КонецОбласти
	
	МинимальноеКоличествоАналогов = ?(ПараметрыПоиска.Свойство("МинимальноеКоличествоАналогов"), ПараметрыПоиска.МинимальноеКоличествоАналогов, Неопределено);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		Запрос.Выполнить();		
	Иначе
		
		#Область Запрос_с_расшифровкой_результата
		
		ИсключаемыеИзРасшифровкиТаблицы = "_АнализируемыеЦенныеБумаги, _Дюрации, _Отрасли, _ВсеЦенныеБумаги, _СубъектыРейтинга, _ГруппаРейтинговЭмитентов, _СегментыВсехЦенныхБумаг, _СведенияОТоргахАналогами, _КоличествоНайденныхАналогов";
		Если МинимальноеКоличествоАналогов = Неопределено Тогда
			ИсключаемыеИзРасшифровкиТаблицы = ИсключаемыеИзРасшифровкиТаблицы + ", _НайденныеАналоги";
		КонецЕсли;
		
		РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Поиск аналогов", "Аналоги", Неопределено, , ИсключаемыеИзРасшифровкиТаблицы, Истина); 
		
		// Поместим параметры расчета рейтинга в расшифровку параметров запроса
		
		РасшифровкаПоиска = РаботаСДокументами.НайтиОперациюРасшифровкиРасчета(РасшифровкаРасчета, "Поиск аналогов");
		
		Если РасшифровкаПоиска <> Неопределено Тогда
			
			РасшифровкаПараметровЗапроса = РаботаСДокументами.НайтиОперациюРасшифровкиРасчета(РасшифровкаПоиска, "ПараметрыЗапроса");
			
			Если РасшифровкаПараметровЗапроса <> Неопределено Тогда
				
				РасшифровкаПараметровЗапроса.Представление			= ""; // Если там ТЗ, то она будет без представления, если массив операций - ничего не изменится
				РасшифровкаПараметровЗапроса.ВыводитьВСвернутомВиде = Ложь;
				
				РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаПараметровЗапроса, "Параметры расчета рейтинга", ПараметрыПоиска.ПараметрыРасчетаРейтинга, , Истина, Истина);
				
				РасшифровкаПараметровЗапроса.Имя		   			= "ПараметрыПоиска";
				РасшифровкаПараметровЗапроса.Представление			= "Параметры поиска";
				РасшифровкаПараметровЗапроса.ВыводитьВСвернутомВиде = Истина;
				
			КонецЕсли;

		КонецЕсли;
		
		#КонецОбласти
		
	КонецЕсли;
	
	// Подбираем подходящие аналоги	
	
	Если МинимальноеКоличествоАналогов <> Неопределено Тогда
	
		#Область Подбор_наиболее_подходящих_аналогов
		
		// Согласно методике на дату переоценки должно действовать как минимум 3 аналога.
		// Отметим нужное количество с учетом уже зарегистрированных.
		// Приоритет аналогов: выбранные ранее, общий эмитент
		
		ОтборАналогов = Новый Структура("Назначение, ТолькоСВалютойНоминалаЦеннойБумаги", Перечисления.ЦелиИспользованияАналогов.РасчетСтавкиДисконтирования, Истина);
		
		РаботаСПереоценкой.ПоместитьАналогиЦенныхБумагВМенеджерВременныхТаблиц(
			Запрос, "_АнализируемыеЦенныеБумаги", Период, ПараметрыОценки.Организация, ПараметрыОценки.Клиент, ОтборАналогов, "_ЗарегистрированныеАналоги");
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_АнализируемыеЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
			|	КОЛИЧЕСТВО(_ЗарегистрированныеАналоги.Аналог) КАК Количество
			|ПОМЕСТИТЬ _КоличествоДействующихАналогов
			|ИЗ
			|	_АнализируемыеЦенныеБумаги КАК _АнализируемыеЦенныеБумаги
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗарегистрированныеАналоги КАК _ЗарегистрированныеАналоги
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _НайденныеАналоги КАК _НайденныеАналоги
			|			ПО (_НайденныеАналоги.ЦеннаяБумага = _ЗарегистрированныеАналоги.ЦеннаяБумага)
			|				И (_НайденныеАналоги.Аналог = _ЗарегистрированныеАналоги.Аналог)
			|		ПО (_ЗарегистрированныеАналоги.ЦеннаяБумага = _АнализируемыеЦенныеБумаги.ЦеннаяБумага)
			|
			|СГРУППИРОВАТЬ ПО
			|	_АнализируемыеЦенныеБумаги.ЦеннаяБумага
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	АналогиЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
			|	АналогиЦенныхБумаг.Аналог КАК Аналог,
			|	МАКСИМУМ(АналогиЦенныхБумаг.ДатаОкончанияДействия) КАК ДатаПоследнегоИспользования
			|ПОМЕСТИТЬ _РанееВыбранныеАналоги
			|ИЗ
			|	РегистрСведений.АналогиЦенныхБумаг КАК АналогиЦенныхБумаг
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _АнализируемыеЦенныеБумаги КАК _АнализируемыеЦенныеБумаги
			|		ПО (_АнализируемыеЦенныеБумаги.ЦеннаяБумага = АналогиЦенныхБумаг.ЦеннаяБумага)
			|ГДЕ
			|	АналогиЦенныхБумаг.Организация = &Организация
			|	И АналогиЦенныхБумаг.Клиент = &Клиент
			|	И АналогиЦенныхБумаг.Период <= &Период
			|
			|СГРУППИРОВАТЬ ПО
			|	АналогиЦенныхБумаг.ЦеннаяБумага,
			|	АналогиЦенныхБумаг.Аналог
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1000000
			|	_НайденныеАналоги.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_НайденныеАналоги.Аналог КАК Аналог,
			|	_СвойстваЦеннойБумаги.Эмитент = _СвойстваАналога.Эмитент КАК ОбщийЭмитент,
			|	ЕСТЬNULL(_РанееВыбранныеАналоги.ДатаПоследнегоИспользования, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПоследнегоИспользования,
			|	АВТОНОМЕРЗАПИСИ() КАК ПриоритетАналога
			|ПОМЕСТИТЬ _УпорядоченныеНовыеАналоги
			|ИЗ
			|	_НайденныеАналоги КАК _НайденныеАналоги
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗарегистрированныеАналоги КАК _ЗарегистрированныеАналоги
			|		ПО (_ЗарегистрированныеАналоги.ЦеннаяБумага = _НайденныеАналоги.ЦеннаяБумага)
			|			И (_ЗарегистрированныеАналоги.Аналог = _НайденныеАналоги.Аналог)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеЦенныеБумаги КАК _СвойстваЦеннойБумаги
			|		ПО (_СвойстваЦеннойБумаги.ЦеннаяБумага = _НайденныеАналоги.ЦеннаяБумага)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеЦенныеБумаги КАК _СвойстваАналога
			|		ПО (_СвойстваАналога.ЦеннаяБумага = _НайденныеАналоги.ЦеннаяБумага)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _РанееВыбранныеАналоги КАК _РанееВыбранныеАналоги
			|		ПО (_РанееВыбранныеАналоги.ЦеннаяБумага = _НайденныеАналоги.ЦеннаяБумага)
			|			И (_РанееВыбранныеАналоги.Аналог = _НайденныеАналоги.Аналог)
			|ГДЕ
			|	_ЗарегистрированныеАналоги.Аналог ЕСТЬ NULL
			|
			|УПОРЯДОЧИТЬ ПО
			|	ЦеннаяБумага,
			|	ДатаПоследнегоИспользования УБЫВ,
			|	ОбщийЭмитент УБЫВ,
			|	Аналог
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_НайденныеАналоги.*
			|ИЗ
			|	_НайденныеАналоги КАК _НайденныеАналоги
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _УпорядоченныеНовыеАналоги КАК _УпорядоченныеНовыеАналоги
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КоличествоДействующихАналогов КАК _КоличествоДействующихАналогов
			|			ПО (_КоличествоДействующихАналогов.ЦеннаяБумага = _УпорядоченныеНовыеАналоги.ЦеннаяБумага)
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|				_УпорядоченныеНовыеАналоги.ЦеннаяБумага КАК ЦеннаяБумага,
			|				МИНИМУМ(_УпорядоченныеНовыеАналоги.ПриоритетАналога) КАК ПриоритетАналога
			|			ИЗ
			|				_УпорядоченныеНовыеАналоги КАК _УпорядоченныеНовыеАналоги
			|			
			|			СГРУППИРОВАТЬ ПО
			|				_УпорядоченныеНовыеАналоги.ЦеннаяБумага) КАК НачальныеНомераВГруппе
			|			ПО (_УпорядоченныеНовыеАналоги.ЦеннаяБумага = НачальныеНомераВГруппе.ЦеннаяБумага)
			|				И (_УпорядоченныеНовыеАналоги.ПриоритетАналога МЕЖДУ НачальныеНомераВГруппе.ПриоритетАналога И НачальныеНомераВГруппе.ПриоритетАналога + &МинимальноеКоличествоАналогов - _КоличествоДействующихАналогов.Количество - 1)
			|		ПО (_УпорядоченныеНовыеАналоги.ЦеннаяБумага = _НайденныеАналоги.ЦеннаяБумага)
			|			И (_УпорядоченныеНовыеАналоги.Аналог = _НайденныеАналоги.Аналог)";
		
		КоличествоНайденныхАналогов = Запрос.МенеджерВременныхТаблиц.Таблицы["_КоличествоНайденныхАналогов"].ПолучитьДанные().Выгрузить()[0].Количество;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1000000", "ПЕРВЫЕ " + Формат(КоличествоНайденныхАналогов, "ЧН=; ЧГ="));
		
		Запрос.УстановитьПараметр("МинимальноеКоличествоАналогов", ПараметрыПоиска.МинимальноеКоличествоАналогов);
		Запрос.УстановитьПараметр("Организация",				   ПараметрыОценки.Организация);
		Запрос.УстановитьПараметр("Клиент",						   ПараметрыОценки.Клиент);
		
		ПодобранныеАналоги = Запрос.Выполнить().Выгрузить();		
		
		#КонецОбласти		
		
	Иначе
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	*
			|ИЗ
			|	_НайденныеАналоги КАК _НайденныеАналоги
			|
			|УПОРЯДОЧИТЬ ПО
			|	_НайденныеАналоги.ЦеннаяБумага,
			|	_НайденныеАналоги.Аналог
			|АВТОУПОРЯДОЧИВАНИЕ";
				
		ПодобранныеАналоги = Запрос.Выполнить().Выгрузить();		
		
	КонецЕсли;
	
	Возврат ПодобранныеАналоги;	
	
КонецФункции

Функция ПолучитьДюрацииПоДаннымБиржи(ЦенныеБумаги, Период, Биржа, ПоследняяДатаТоргов = Неопределено)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЦенныеБумаги.Рынок КАК Рынок
		|ПОМЕСТИТЬ _ЦенныеБумаги
		|ИЗ
		|	&ЦенныеБумаги КАК ЦенныеБумаги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.DURATION КАК Дюрация,
		|	Номиналы.Номинал КАК Номинал,
		|	ЛОЖЬ КАК РасчетноеЗначение
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.ЦеннаяБумага = _ЦенныеБумаги.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Рынок = _ЦенныеБумаги.Рынок)
		|			И (КотировкиТорговыхПлощадок.Биржа = &Биржа)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадок.Период = &ПоследняяДатаТоргов)
		|			И (КотировкиТорговыхПлощадок.DURATION > 0)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК Номиналы
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|				МАКСИМУМ(НоминалыЦенныхБумаг.Период) КАК Период
		|			ИЗ
		|				_ЦенныеБумаги КАК _ЦенныеБумаги
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|					ПО (НоминалыЦенныхБумаг.ЦеннаяБумага = _ЦенныеБумаги.ЦеннаяБумага)
		|						И (НоминалыЦенныхБумаг.Период <= &Период)
		|			
		|			СГРУППИРОВАТЬ ПО
		|				_ЦенныеБумаги.ЦеннаяБумага) КАК ДатыИзмененийНоминала
		|			ПО (ДатыИзмененийНоминала.ЦеннаяБумага = Номиналы.ЦеннаяБумага)
		|				И (ДатыИзмененийНоминала.Период = Номиналы.Период)
		|		ПО (Номиналы.ЦеннаяБумага = _ЦенныеБумаги.ЦеннаяБумага)");
	
	Если ПоследняяДатаТоргов = Неопределено Тогда
		ПоследняяДатаТоргов = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(), НачалоДня(Период));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ЦенныеБумаги",			ЦенныеБумаги);
	Запрос.УстановитьПараметр("Биржа",					Биржа);
	Запрос.УстановитьПараметр("Период",					Период);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",	ПоследняяДатаТоргов);

	Возврат Запрос.Выполнить().Выгрузить();
		
КонецФункции

#КонецОбласти

#Область Получение_параметров_и_настроек_расчета

// Получает настройки из регистра сведений НастройкиЦелейРасчета
//
// Параметры:
//	Период - 
//	Организация - 
//	СчетДоверительногоУправления - 
//	ЦельРасчета - 
//	ПриОтсутствииПроверятьНастройкиСледующегоДня - Булево - если на [Период] не будет настроек, то будут получены настройки на [Период + 24*60*60]
//
// Возвращаемое значение:
//	НастройкиОценки - Структура - заполняется ресурсами регистра НастройкиЦелейРасчета
//
Функция ОпределитьНастройкиОценки(Период, Организация, СчетДоверительногоУправления, ЦельРасчета, ПриОтсутствииПроверятьНастройкиСледующегоДня = Ложь) Экспорт
	
	СписокРесурсов = "";
	Для каждого Ресурс Из Метаданные.РегистрыСведений.НастройкиЦелейРасчета.Ресурсы Цикл
		СписокРесурсов = СписокРесурсов + Ресурс.Имя + ",";
	КонецЦикла;
	Настройки = Новый Структура(Лев(СписокРесурсов, СтрДлина(СписокРесурсов) - 1));

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиЦелейРасчетаСрезПоследних.*
		|ИЗ
		|	РегистрСведений.НастройкиЦелейРасчета.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ЦельРасчета = &ЦельРасчета) КАК НастройкиЦелейРасчетаСрезПоследних";
		
	Запрос.УстановитьПараметр("Период",                       Период);
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦельРасчета", ЦельРасчета);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Настройки, Выборка, СписокРесурсов);
	КонецЦикла;

	Если Настройки.ВариантРасчетаОценочнойСтоимости = Неопределено И ПриОтсутствииПроверятьНастройкиСледующегоДня Тогда
		//если это переоценка перед началом учета
		Настройки = ОпределитьНастройкиОценки(Период + 24*60*60, Организация, СчетДоверительногоУправления, ЦельРасчета);
	КонецЕсли;
	
	// Проверяем, требуется ли оценивать активы в соответствии с письмами/указаниями ЦБ РФ
	
	#Область ВыполнятьРасчетПоУказаниюЦБ5419
	
	// Указание ЦБ РФ № 5419-У от 24.03.2020
	
	ВыполнятьРасчетПоУказаниюЦБ5419 = Ложь;
	
	Если Период >= '20200301' И Период <= '20201231235959' Тогда
		
		ДатаНачалаРасчетаПоУказанию = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(Неопределено, "ДатаНачалаРасчетаПоУказаниюЦБ5419", СчетДоверительногоУправления);
		
		Если ЗначениеЗаполнено(ДатаНачалаРасчетаПоУказанию) И Период >= ДатаНачалаРасчетаПоУказанию Тогда
			
			// #319555: для договора управления резервами страховых компаний не выполнять расчет для оценки объектов в управлении
			
			ВидДоговораДоверительногоУправления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
			
			Если Не ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении
				ИЛИ Не ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний
			Тогда
				ВыполнятьРасчетПоУказаниюЦБ5419	= Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Настройки.Вставить("ВыполнятьРасчетПоУказаниюЦБ5419", ВыполнятьРасчетПоУказаниюЦБ5419);
	
	#КонецОбласти
	
	#Область ВыполнятьРасчетПоПисьмуЦБ0185316
	
	// Информационное письмо ЦБ РФ № ИН-018-53/16 от 25.02.2022
	
	ВыполнятьРасчетПоПисьмуЦБ0185316 = Ложь;
	
	Если Период >= '20220218' И Период <= '20221231235959' Тогда
		
		ДатаОкончанияРасчета = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(Неопределено, "ДатаОкончанияРасчетаПоПисьмуЦБ0185316", СчетДоверительногоУправления);
		
		Если Не ЗначениеЗаполнено(ДатаОкончанияРасчета) ИЛИ Период <= КонецДня(ДатаОкончанияРасчета) Тогда
		
			ДатаНачалаРасчета = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(Неопределено, "ДатаНачалаРасчетаПоПисьмуЦБ0185316", СчетДоверительногоУправления);
			
			Если ЗначениеЗаполнено(ДатаНачалаРасчета) И Период >= ДатаНачалаРасчета Тогда
				
				ВыполнятьРасчетПоПисьмуЦБ0185316 = Истина;
					
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Настройки.Вставить("ВыполнятьРасчетПоПисьмуЦБ0185316", ВыполнятьРасчетПоПисьмуЦБ0185316);
	
	#КонецОбласти	
	
	Возврат Настройки;
	
КонецФункции

// Иногда необходимо округлять валютную сумму до 2-х знаков, а затем умножать на курс 
Функция ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета(ВариантРасчетаОценочнойСтоимости, СчетДоверительногоУправления, Период) Экспорт
	
	ВариантыОкругленияВалютныхСумм = Новый Структура("ОкруглятьСумму, ОкруглятьСуммуКупона", "НеОкруглять", "НеОкруглять");
	
	Если ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_Нефтегарант2018 Тогда
		
		Если Период >= '20190418' Тогда
			ВариантыОкругленияВалютныхСумм.ОкруглятьСумму = 2;
		КонецЕсли;
		
	ИначеЕсли ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом Тогда
		
		Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период);
		
		Если Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар") Тогда
			
			// #Техдолг #380591		
			// По методике нужно округлять до количества разрядов дробной части валюты,
			// но пока бумаги были только с валютами с 2 знаками в дробной части
			
			ВариантыОкругленияВалютныхСумм.ОкруглятьСумму		= 2;
			ВариантыОкругленияВалютныхСумм.ОкруглятьСуммуКупона	= 2;
		
		КонецЕсли;
		
	ИначеЕсли ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020 И Период >= '20250922' Тогда
		
		// По письму Волги-Капитал от 25.09.2025 валютную цену ЦБ тоже нужно округлять                                          
		Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период);
		Если Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФВолгаКапитал") И Период >= '20250925' Тогда
			ВариантыОкругленияВалютныхСумм.ОкруглятьСумму = 2;
		КонецЕсли;
				
		ВариантыОкругленияВалютныхСумм.ОкруглятьСуммуКупона	= 2;
		
	ИначеЕсли ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020_2 И Период >= '20251031' Тогда
		
		//#ТехДолг пока у Национального одна валютная облигация. Нужно объединить настройки округления и их вызовы
		ВариантыОкругленияВалютныхСумм.ОкруглятьСуммуКупона	= 2;	
		
	ИначеЕсли ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ХантыМансийский2020 И Период >= '20251107' Тогда
		
		//#ТехДолг аналогичный
		ВариантыОкругленияВалютныхСумм.ОкруглятьСуммуКупона	= 2;		
		
	КонецЕсли;
	
	Возврат ВариантыОкругленияВалютныхСумм;
	
КонецФункции

Функция ОпределитьВидУчета(Организация, СчетДоверительногоУправления, ЦельРасчета, НаДату) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиЦелейРасчетаСрезПоследних.ВидУчетаДляОстатковПартий КАК ВидУчетаДляОстатковПартий
		|ИЗ
		|	РегистрСведений.НастройкиЦелейРасчета.СрезПоследних(
		|			&НаДату,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ЦельРасчета = &ЦельРасчета) КАК НастройкиЦелейРасчетаСрезПоследних");
	
	Запрос.УстановитьПараметр("НаДату", 					  НаДату);
	Запрос.УстановитьПараметр("Организация", 				  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦельРасчета", 				  ЦельРасчета);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.ВидУчетаДляОстатковПартий;
	КонецЕсли;                                                    
	
	Возврат Перечисления.ВидыУчета.ПустаяСсылка();  		
	
КонецФункции

Функция ПолучитьТочностьРасчетаОценочнойСтоимости(НастройкиЦелиРасчета) Экспорт
	
	ТочностьРасчетаОценочнойСтоимости = НастройкиЦелиРасчета.ТочностьЦеныОценки;
	
	Если ТочностьРасчетаОценочнойСтоимости = 0 ИЛИ ТочностьРасчетаОценочнойСтоимости = Неопределено Тогда
		ТипЧислаЦена					  = Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип.КвалификаторыЧисла;
		ТочностьРасчетаОценочнойСтоимости = ТипЧислаЦена.РазрядностьДробнойЧасти;	
	КонецЕсли;
	
	Возврат ТочностьРасчетаОценочнойСтоимости;
	
КонецФункции

Функция ПолучитьПараметрыПолученияПартийПоМетодике(ЦельРасчета, ВидУчета, ВариантРасчетаСправедливойСтоимости, Дата, РасшифровкаРасчета = Неопределено, СчетДоверительногоУправления = Неопределено) Экспорт
	
	ПараметрыПартий = Новый Структура("ЦельРасчета, ВидУчета, ВариантРасчетаСправедливойСтоимости, Дата, УчестьПартииКПолучению, УчестьБумагиТПлюс, УчестьБумагиПоРЕПО, УчестьСрочныеКонтракты",
		ЦельРасчета,
		ВидУчета,
		ВариантРасчетаСправедливойСтоимости,
		НачалоДня(Дата));	
	
	Если ЦельРасчета = Справочники.ЦелиРасчета.КонтрольИнвестиционнойДекларации Или РасшифровкаРасчета <> Неопределено Тогда
		
		ПараметрыПартий.УчестьПартииКПолучению	= Истина;
		ПараметрыПартий.УчестьБумагиТПлюс 		= Ложь;
		ПараметрыПартий.УчестьБумагиПоРЕПО 		= Истина;
		ПараметрыПартий.УчестьСрочныеКонтракты 	= Ложь;
		
	Иначе
		
		ПараметрыПартий.УчестьПартииКПолучению	= Истина; // для ЕПС (бух-ии, НУ), для СЧА не используется
		ПараметрыПартий.УчестьБумагиТПлюс		= Ложь; // для СЧА, для  (бух-ии, НУ) ЕПС не используется
		ПараметрыПартий.УчестьБумагиПоРЕПО		= Ложь;
		ПараметрыПартий.УчестьСрочныеКонтракты 	= Ложь;
		
		// Заполняем по параметрам получения остатков
		
		//#Техдолг
		//ПараметрыОстатков = Справочники.ВариантыРасчетаОценочнойСтоимости.ПолучитьПараметрыПолученияОстатковЦенныхБумаг(ВариантРасчетаСправедливойСтоимости);
		//
		//Если ПараметрыОстатков <> Неопределено Тогда
		//	
		//	ПараметрыПартий.УчестьБумагиТПлюс	= ЗначениеЗаполнено(ПараметрыОстатков.ТипыЗадолженностейПоЦеннымБумагам);
		//	ПараметрыПартий.УчестьБумагиПоРЕПО	= Не ПараметрыОстатков.НеУчитыватьЦБКупленныеПоРЕПО;
		//	
		//КонецЕсли;

		// Захардкодим остальные
		
		Если ЦельРасчета.ТолькоДляФиксацииСтоимостиОценки Тогда // это цель расчета - СЧА (Оценка объектов в управлении)
		
			ПараметрыПартий.УчестьПартииКПолучению = Ложь;
			
			Если (ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ОПК2018 И НачалоДня(Дата) < '20190101') ИЛИ
				(ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2018) ИЛИ
				(ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Стройкомплекс2018 И НачалоДня(Дата)<'20180126') // эти считают Т+ сразу
			Тогда 
				ПараметрыПартий.УчестьБумагиТПлюс = Истина;
			КонецЕсли;
			
			//странно, что купленные по РЕПО не учитываются в составе остатков у всех
			Если ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ И НачалоДня(Дата) < '20200811'
				ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФондФилософии
				ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РПИ 
				ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ЛонгТермИнвестментс
			Тогда
				ПараметрыПартий.УчестьБумагиПоРЕПО = Истина;
			КонецЕсли;
			
			Если ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ И НачалоДня(Дата) >= '20200811' Тогда
				
				СтараяМетодикаРЭМ =
					СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Солидарность") И НачалоДня(Дата) < '20200913'
					ИЛИ СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_СМиАУ") И НачалоДня(Дата) < '20200913'
					ИЛИ СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ПАУ_ЦФО") И НачалоДня(Дата) < '20200913'
					ИЛИ СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Росинфокоминвест");
					
				Если СтараяМетодикаРЭМ Тогда
					ПараметрыПартий.УчестьБумагиПоРЕПО = Истина;		
				КонецЕсли;
					
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПараметрыПартий; 	
	
КонецФункции

Функция ПолучитьПараметрыРасчетаРейтингаПоУмолчанию(СчетДоверительногоУправления, Период)
	
	ПараметрыРасчетаРейтингаПоУмолчанию = Новый Структура;		
	
	ПараметрыРасчетаРейтингаПоУмолчанию.Вставить("РейтинговаяГруппаГосударственныхОблигаций", 1);
	
	Если Период >= '20221220' Тогда
		
		СпециализированныйДепозитарий = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "СпециализированныйДепозитарий");
		
		Если СпециализированныйДепозитарий = ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_Инфинитум")
			ИЛИ СпециализированныйДепозитарий = ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НСД")	
		Тогда
			ПараметрыРасчетаРейтингаПоУмолчанию.Вставить("РейтинговаяГруппаБумагСГарантиейРФПриОтсутствииРейтингаВыпускаИЭмитента", 1);
		КонецЕсли;
		
	ИначеЕсли Период >= '20201207' Тогда
		
		// #286299: с этой даты используем все рейтинги
	
	ИначеЕсли Период >= '20200901' Тогда
		
		СпециализированныйДепозитарий = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "СпециализированныйДепозитарий");
		
		ПараметрыРасчетаРейтингаПоУмолчанию.Вставить("ИсключатьДляРублевыхОблигацийРейтингFitchRatings",
			СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Газфонд")
				ИЛИ СпециализированныйДепозитарий = ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_Инфинитум"));
		
	ИначеЕсли Период >= '20191021' Тогда
		
		ПараметрыРасчетаРейтингаПоУмолчанию.Вставить("ИсключатьДляРублевыхОблигацийРейтингFitchRatings", Истина);			
		
	КонецЕсли;
	
	Возврат ПараметрыРасчетаРейтингаПоУмолчанию; 
	
КонецФункции

