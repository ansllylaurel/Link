		МассивТиповПартии.Добавить(Тип("ДокументСсылка.СделкаРЕПО"));
		МассивТиповПартии.Добавить(Тип("ДокументСсылка.ПоставкаЦенныхБумаг"));
		МассивТиповПартии.Добавить(Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке"));
		МассивТиповПартии.Добавить(Тип("ДокументСсылка.ВводЦенныхБумаг"));
		
