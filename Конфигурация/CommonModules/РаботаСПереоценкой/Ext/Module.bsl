
#Область Общие_функции_заполнения_стоимости

// Заполняет строку переоценки по данным расчета амортизированной стоимости
//
// Параметры:
//	СтрокаЦенныеБумаги - СтрокаТаблицыЗначений -  
//	ДатаПереоценки - Дата - 
//	ПараметрыОценки - ДокументОбъект, Структура - см. РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС 
//	ТаблицаДатИЦенПокупки - ТаблицаЗначений - таблица дат и цен покупки
//	НастройкиУчета - Структура - общие настройки учета клиента
//	Отказ - Булево - 
//	РасшифровкаРасчета - Структура, Неопределено - 
//
Функция ЗаполнитьАмортизированнойСтоимостью(СтрокаЦенныеБумаги, ДатаПереоценки, ПараметрыОценки, ТаблицаДатИЦенПокупки, НастройкиУчета, Отказ, РасшифровкаРасчета = Неопределено)
	
	#Область Реклассифицированные_корректировкой_регистра_бумаги_в_день_реклассификации
	
	// Процедура может быть вызвана для заполнения документа или для получения цены,
	// но ДополнительныеСвойства должны быть и там и там
	
	Если ТипЗнч(ПараметрыОценки) = Тип("Структура") Тогда
		Если Не ПараметрыОценки.Свойство("ДополнительныеСвойства") Тогда
			ПараметрыОценки.Вставить("ДополнительныеСвойства", Новый Структура);				
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеСвойства = ПараметрыОценки.ДополнительныеСвойства;	
	
	Если ДатаПереоценки = '20200630'
		И ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020
	Тогда

		// 30.06.2020 Будущее и Телекомы произвели реклассификацию активов.
		// Активы ужасны и 1С еще не умеет рассчитывать корректировку ЭСП по ним,
		// поэтому в бухгалтерии данные посчитаны обработкой и внесены корректировкой.
		// Подбробнее #324511 и #324120
							
		Если Не ДополнительныеСвойства.Свойство("РасчетАмортизированнойСтоимости") Тогда
			
			РеклассифицированныеБумаги = Новый Массив;
		
			Если ПараметрыОценки.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN118") Тогда // НПФ БУДУЩЕЕ АО ПН 040319-4
				РеклассифицированныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВейлФинанс"));
				РеклассифицированныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_БизнесКонсалтиг"));
				РеклассифицированныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_БКЗ_ФИНАНС"));
				РеклассифицированныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Магистраль_002"));
				РеклассифицированныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ТМ-энергоФинанс"));
				РеклассифицированныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Пересвет"));
			ИначеЕсли ПараметрыОценки.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PR116") Тогда // НПФ БУДУЩЕЕ АО ПР_040319-2
				РеклассифицированныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финстоун"));
				РеклассифицированныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВейлФинанс"));
				РеклассифицированныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_БКЗ_ФИНАНС"));
				РеклассифицированныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_БизнесКонсалтиг"));
				РеклассифицированныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ТМ-энергоФинанс"));
			ИначеЕсли ПараметрыОценки.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN112") Тогда // НПФ Телеком-Союз АО ПН 250219-11
				РеклассифицированныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ТМ-энергоФинанс"));
				РеклассифицированныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_БКЗ_ФИНАНС"));
				РеклассифицированныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Магистраль_002"));
			ИначеЕсли ПараметрыОценки.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PR111") Тогда // НПФ Телеком-Союз АО ПР 250219-6
				РеклассифицированныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_БКЗ_ФИНАНС"));
				РеклассифицированныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_БизнесКонсалтиг"));
				РеклассифицированныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ТМ-энергоФинанс"));
				РеклассифицированныеБумаги.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финстоун"));
			КонецЕсли;
			
			ДополнительныеСвойства.Вставить("РасчетАмортизированнойСтоимости",
				СоставляющиеАмортизированнойСтоимостиПоДаннымПартий(
					Новый Граница(КонецДня(ДатаПереоценки), ВидГраницы.Включая),
					ПараметрыОценки,
					РеклассифицированныеБумаги));
			
		КонецЕсли;
		
		// Партии для бэка считаются динамически, при этом обработка расчета партий не учитывает корректировки,
		// поэтому класс активов берем из запроса
		
		РезультатРасчетаПоПартии = ДополнительныеСвойства.РасчетАмортизированнойСтоимости.НайтиСтроки(Новый Структура("Партия, СтрокаПартии", СтрокаЦенныеБумаги.Партия, СтрокаЦенныеБумаги.СтрокаПартии)); 		
		Если РезультатРасчетаПоПартии.Количество() = 1 Тогда
			ЗаполнитьЗначенияСвойств(СтрокаЦенныеБумаги, РезультатРасчетаПоПартии[0], "УчетныйАктивЕПС");
		ИначеЕсли РезультатРасчетаПоПартии.Количество() > 1 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон("На остатках партии '%1 (строка %2)' числятся различные учетные активы ЕПС", СтрокаЦенныеБумаги.Партия, СтрокаЦенныеБумаги.СтрокаПартии), , , , Отказ);
			Возврат Ложь;
		КонецЕсли;
			
	КонецЕсли;
	
	#КонецОбласти
	
	Если Не ОценкаПоАмортизированнойСтоимости(СтрокаЦенныеБумаги.Рынок, СтрокаЦенныеБумаги.УчетныйАктивЕПС, ПараметрыОценки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, СтрШаблон("Расчет амортизированной стоимости партии '%1 (строка %2)'", СтрокаЦенныеБумаги.Партия, СтрокаЦенныеБумаги.СтрокаПартии));
	КонецЕсли;
	
	#Область Получение_балансовых_данных_на_утро
	
	БалансовыеДанныеНаУтро = Новый Структура("БалансовыеДисконтПремия, БалансоваяРазницаППНеНаблюдаемыеДанные, НачальнаяРазницаППНеНаблюдаемыеДанные, ЗадолженностьПоПогашениюКупона, Количество, Стоимость, НомерСделки", 0, 0, 0, 0, 0, 0, "");
	
	Если Не ДополнительныеСвойства.Свойство("БалансовыеДанныеНаУтро") Тогда
		ДополнительныеСвойства.Вставить("БалансовыеДанныеНаУтро", СоставляющиеАмортизированнойСтоимостиПоДаннымПартий(НачалоДня(ДатаПереоценки), ПараметрыОценки));
	КонецЕсли;
	
	СтрокиБалансовыеДанныеНаУтро = ДополнительныеСвойства.БалансовыеДанныеНаУтро.НайтиСтроки(Новый Структура("Партия, СтрокаПартии", СтрокаЦенныеБумаги.Партия, СтрокаЦенныеБумаги.СтрокаПартии));
	
	// Приводим данные к текущему остатку ценных бумаг
	
	Если СтрокиБалансовыеДанныеНаУтро.Количество() > 0 Тогда
		БалансовыеДанныеНаУтро.Количество								= ?(СтрокиБалансовыеДанныеНаУтро[0].Количество = 0, СтрокаЦенныеБумаги.Количество, СтрокиБалансовыеДанныеНаУтро[0].Количество);
		БалансовыеДанныеНаУтро.БалансовыеДисконтПремия					= Окр(СтрокиБалансовыеДанныеНаУтро[0].БалансовыеДисконтПремия / БалансовыеДанныеНаУтро.Количество * СтрокаЦенныеБумаги.Количество, 2);
		БалансовыеДанныеНаУтро.БалансоваяРазницаППНеНаблюдаемыеДанные	= Окр(СтрокиБалансовыеДанныеНаУтро[0].БалансоваяРазницаППНеНаблюдаемыеДанные / БалансовыеДанныеНаУтро.Количество * СтрокаЦенныеБумаги.Количество, 2);
		БалансовыеДанныеНаУтро.НачальнаяРазницаППНеНаблюдаемыеДанные	= Окр(СтрокиБалансовыеДанныеНаУтро[0].НачальнаяРазницаППНеНаблюдаемыеДанные / БалансовыеДанныеНаУтро.Количество * СтрокаЦенныеБумаги.Количество, 2);
		БалансовыеДанныеНаУтро.ЗадолженностьПоПогашениюКупона			= Окр(СтрокиБалансовыеДанныеНаУтро[0].ЗадолженностьПоПогашениюКупона / БалансовыеДанныеНаУтро.Количество * СтрокаЦенныеБумаги.Количество, 2);
		БалансовыеДанныеНаУтро.Стоимость								= Окр(СтрокиБалансовыеДанныеНаУтро[0].Стоимость / БалансовыеДанныеНаУтро.Количество * СтрокаЦенныеБумаги.Количество, 2);
		БалансовыеДанныеНаУтро.НомерСделки								= СтрокиБалансовыеДанныеНаУтро[0].НомерСделки;
	КонецЕсли;
	
	#КонецОбласти
	
	// Получаем сведения о партии
	
	#Область Получение_сведений_о_покупке
	
	Если ТаблицаДатИЦенПокупки = Неопределено Тогда
		ТаблицаДатИЦенПокупки = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(СтрокаЦенныеБумаги.Владелец(), ПараметрыОценки.СчетДоверительногоУправления, ДатаПереоценки).Выгрузить();
	КонецЕсли;
	
	СтрокиПокупки = ТаблицаДатИЦенПокупки.НайтиСтроки(Новый Структура("Партия, СтрокаПартии", СтрокаЦенныеБумаги.Партия, СтрокаЦенныеБумаги.СтрокаПартии));
	
	Если СтрокиПокупки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдены цена и дата покупки для ЦБ " + СтрокаЦенныеБумаги.ЦеннаяБумага + " из партии " + СтрокаЦенныеБумаги.Партия + ", строка " + СтрокаЦенныеБумаги.СтрокаПартии, ПараметрыОценки, , , Отказ);
		Возврат Ложь;
	КонецЕсли;
	
	СтрокаПокупки = СтрокиПокупки[0];
	
	Если ЗначениеЗаполнено(СтрокаПокупки.ДатаПогашения) И СтрокаПокупки.ДатаПогашения < ДатаПереоценки Тогда
		Возврат Ложь; // Бумага уже погашена
	КонецЕсли;
	
	Если НастройкиУчета.РассчитыватьДисконтПремиюОтДатыРеклассификации Тогда
		СтрокаПокупки.ДатаПокупкиНачальная = СтрокаПокупки.ДатаПокупки;
		СтрокаПокупки.ЦенаПокупкиНачальная = СтрокаПокупки.ЦенаПокупки;
	КонецЕсли;
	
	ЭтоВведенныйРекласс	= ТипЗнч(СтрокаЦенныеБумаги.Партия) = Тип("ДокументСсылка.РеклассификацияАктивовЕПС") И Не СтрокаЦенныеБумаги.Партия.Проведен;
	
	Если ЭтоВведенныйРекласс Тогда
		
		#Область Поиск_ввода_рекласса
		
		ЗапросВвода = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ВводЦенныхБумаг.Дата КАК ДатаВвода
			|ИЗ
			|	Документ.ВводЦенныхБумаг КАК ВводЦенныхБумаг
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ТабличнаяЧастьВвода
			|		ПО (ТабличнаяЧастьВвода.Ссылка = ВводЦенныхБумаг.Ссылка)
			|			И (ТабличнаяЧастьВвода.РеклассификацияАктивовЕПС = &Партия)
			|			И (ТабличнаяЧастьВвода.СтрокаРеклассификации = &СтрокаПартии)
			|ГДЕ
			|	ВводЦенныхБумаг.Организация = &Организация
			|	И ВводЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И ВводЦенныхБумаг.Проведен");
		
		ЗапросВвода.УстановитьПараметр("Организация",					ПараметрыОценки.Организация);
		ЗапросВвода.УстановитьПараметр("СчетДоверительногоУправления",	ПараметрыОценки.СчетДоверительногоУправления);
		ЗапросВвода.УстановитьПараметр("Партия",						СтрокаЦенныеБумаги.Партия);
		ЗапросВвода.УстановитьПараметр("СтрокаПартии",					СтрокаЦенныеБумаги.СтрокаПартии);
		
		ВыборкаЗапросаВвода = ЗапросВвода.Выполнить().Выбрать();
		
		Если ВыборкаЗапросаВвода.Следующий() Тогда
			ДатаВводаПартии = ВыборкаЗапросаВвода.ДатаВвода;	
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон("Не удалось определить дату ввода партии '%1 (строка %2)'", СтрокаЦенныеБумаги.Партия, СтрокаЦенныеБумаги.СтрокаПартии));
			Возврат Неопределено;				
		КонецЕсли;
		
		#КонецОбласти
		
	Иначе
		
		ДатаВводаПартии = СтрокаЦенныеБумаги.ДатаПартии;
		
	КонецЕсли;
	
	#КонецОбласти
	
	СуммаРезервовПодОбесценение = -СтрокаЦенныеБумаги.СуммаРезервовПодОбесценение;
	
	// #621712
	// согласно методике Будущего, необходимо рассчитывать ЭСП и АС в дни регистрации сведений о потоках
	// по согласованию с бухгалтерией они в день расчета АС регистрируют настройку НачислятьКорректировкуЭСПВДеньОперации - это пока самое точное
	// это еще не финальный вариант, будут доработки
	ПараметрыОценки.ДополнительныеСвойства.Вставить("РассчитыватьАмортизированнуюСтоимостьПоЭСП", Ложь);
	Если ДатаПереоценки >= '20250604' И ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020 Тогда
		
		Если НЕ ПараметрыОценки.ДополнительныеСвойства.Свойство("БумагиПоКоторымИзменилисьПотоки") Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	ЗначенияНастроекУчетаЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага
				|ИЗ
				|	РегистрСведений.ЗначенияНастроекУчетаЦенныхБумаг КАК ЗначенияНастроекУчетаЦенныхБумаг
				|ГДЕ
				|	ЗначенияНастроекУчетаЦенныхБумаг.Организация = &Организация
				|	И ЗначенияНастроекУчетаЦенныхБумаг.Клиент = &Клиент
				|	И ЗначенияНастроекУчетаЦенныхБумаг.Рынок = &Рынок
				|	И ЗначенияНастроекУчетаЦенныхБумаг.Период = &Период
				|	И НЕ ЗначенияНастроекУчетаЦенныхБумаг.Отключить
				|	И ЗначенияНастроекУчетаЦенныхБумаг.Настройка = &Настройка
				|	И (ВЫРАЗИТЬ(ЗначенияНастроекУчетаЦенныхБумаг.ЗначениеНастройки КАК БУЛЕВО)) = ИСТИНА";

			Запрос.УстановитьПараметр("Организация", ПараметрыОценки.Организация);
			Запрос.УстановитьПараметр("Клиент", ПараметрыОценки.Клиент);
			Запрос.УстановитьПараметр("Рынок", Перечисления.РынкиЦенныхБумаг.Облигации);
			Запрос.УстановитьПараметр("Период", ДатаПереоценки);
			Запрос.УстановитьПараметр("Настройка", ПланыВидовХарактеристик.НастройкиУчетаЦенныхБумаг.НачислятьКорректировкуЭСПВДеньОперации);
			
			ПараметрыОценки.ДополнительныеСвойства.Вставить("БумагиПоКоторымИзменилисьПотоки", Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЦеннаяБумага"));
			
		КонецЕсли;
		
		Если ПараметрыОценки.ДополнительныеСвойства.БумагиПоКоторымИзменилисьПотоки.Найти(СтрокаЦенныеБумаги.ЦеннаяБумага) <> Неопределено Тогда 
			ПараметрыОценки.ДополнительныеСвойства.Вставить("РассчитыватьАмортизированнуюСтоимостьПоЭСП", Истина);
		КонецЕсли;
	ИначеЕсли ДатаПереоценки > '20251219' И ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Ростех Тогда	
		ПараметрыОценки.ДополнительныеСвойства.Вставить("РассчитыватьАмортизированнуюСтоимостьПоЭСП", Истина); // для СЧА Ростех считает ежедневно!
	КонецЕсли;
	
	Если НЕ ПараметрыОценки.ДополнительныеСвойства.Свойство("ЭтоДеньРеформацииБаланса") Тогда
		РеформацииБалансов = РегистрыСведений.РеформацииБалансов.ПолучитьДатыРеформацийЗаПериод(
			ПараметрыОценки.СчетДоверительногоУправления,
			ДатаПереоценки,
			ДатаПереоценки);
		ЭтоДеньРеформацииБаланса = (РеформацииБалансов.Количество() > 0);
		ПараметрыОценки.ДополнительныеСвойства.Вставить("ЭтоДеньРеформацииБаланса", ЭтоДеньРеформацииБаланса);
	КонецЕсли;
	
	ПараметрыОценки.ДополнительныеСвойства.РассчитыватьАмортизированнуюСтоимостьПоЭСП = 
		ПараметрыОценки.ДополнительныеСвойства.РассчитыватьАмортизированнуюСтоимостьПоЭСП
		ИЛИ ПараметрыОценки.ДополнительныеСвойства.ЭтоДеньРеформацииБаланса;
		
	Если НЕ ПараметрыОценки.ДополнительныеСвойства.Свойство("ДатаПоследнейРеформацииБаланса") Тогда
		// сдвинем на день назад т.к. дата начала учета это следующий день после реформации баланса
		ДатаПоследнейРеформацииБаланса = БухгалтерскийУчетЕПС.ОпределитьДатуНачалаБухгалтерскогоПериода(
			ДатаПереоценки,
			ПараметрыОценки.Организация,
			ПараметрыОценки.СчетДоверительногоУправления) - 24 * 60 * 60; 
	    ПараметрыОценки.ДополнительныеСвойства.Вставить("ДатаПоследнейРеформацииБаланса", ДатаПоследнейРеформацииБаланса);
	КонецЕсли;

	ПараметрыОценки.ДополнительныеСвойства.Вставить("БлижайшаяРанняяДатаОбъединенияВГруппеБудущее", '00010101');
	Если ПараметрыОценки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Будущее") Тогда
		ПараметрыОценки.ДополнительныеСвойства.БлижайшаяРанняяДатаОбъединенияВГруппеБудущее = БухгалтерскийУчетЕПС.ПолучитьБлижайшуюРаннююДатуОбъединенияВГруппеБудущее(НачалоДня(ДатаПереоценки));
	КонецЕсли;
	
	// Определяем параметры начисления корректировки ЭСП	
	ПараметрыНачисленияКорректировкиЭСП = ОпределитьПараметрыНачисленияКорректировкиЭСП(ПараметрыОценки, НастройкиУчета, ДатаПереоценки, СтрокаЦенныеБумаги, СтрокаПокупки.ДатаПокупки, ДатаВводаПартии);
	Если ПараметрыНачисленияКорректировкиЭСП = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;			
	
	#Область Получение_сведений_о_бумаге
	
	// Последний купон получаю на предыдущий день, т.к. бывает, что окончание купона не совпадает с началом следующего купона
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Облигации.ВалютаНоминала КАК ВалютаНоминала,
		|	Облигации.Амортизационная КАК Амортизационная,
		|	ПоследнийНоминал.Номинал КАК Номинал,
		|	ЕСТЬNULL(ПоследнийНоминал.Период = &ДатаПереоценки, ЛОЖЬ) КАК ЭтоДеньПогашенияНоминала,
		|	ЕСТЬNULL(ПоследнийКупон.ДатаОкончанияКупона = &ДатаПереоценки, ЛОЖЬ) КАК ЭтоДеньПогашенияКупона,
		|	ЕСТЬNULL(ПоследнийНоминал.СуммаИзменения, 0) КАК СуммаИзменения
		|ИЗ
		|	Справочник.Облигации КАК Облигации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага = &ЦеннаяБумага) КАК ПоследнийНоминал
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям.СрезПоследних(ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -1), Облигация = &ЦеннаяБумага) КАК ПоследнийКупон
		|		ПО (ИСТИНА)
		|ГДЕ
		|	Облигации.Ссылка = &ЦеннаяБумага");
	
	Запрос.УстановитьПараметр("ЦеннаяБумага",	СтрокаЦенныеБумаги.ЦеннаяБумага);
	Запрос.УстановитьПараметр("ДатаПереоценки",	НачалоДня(ДатаПереоценки));
	
	СведенияОБумаге = Запрос.Выполнить().Выгрузить()[0];
	
	#КонецОбласти
	
	// Определяем параметры расчета амортизированной стоимости
	
	ВключатьРазницуПервоначальногоПризнанияВБалансовуюСтоимость = Истина; // Вариант учета разницы ПП №1. Подробнее у Коли (#Техдолг)
	// Проверил вызовы этой функции и на самом деле в функцию передается не НастройкиУчета а НастройкиУчетаЦеннойБумаги
	ПравильныйУчетПП											= (ДатаПереоценки >= '20200401') И НастройкиУчета.ПравильныйУчетПервоначальногоПризнания; // #Техдолг #Хардкод #310934
	
	
	ТочностьЦены						= Неопределено;	
	ДанныеПокупкиДляДисконтПремии		= Новый Структура;
	ДанныеПереоценкиДляДисконтПремии	= Новый Структура;
	РасчетЦеныОтСтоимостиПоЭСП			= Ложь;
	
	ПроизвольнаяКорректировка									= 0;
	ОценочнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные	= Неопределено;
	ЦенаНаПредыдущуюПереоценку									= Неопределено;
	СтоимостьНаПредыдущуюПереоценку								= Неопределено;
	
	#Область Дополнительные_сведения_о_партиях_и_настройки_расчета_клиентов
	
	МассивСчетовФедерации = Новый Массив();
	МассивСчетовФедерации.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ФедерацияПН"));
	МассивСчетовФедерации.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ФедерацияПНВР"));
	МассивСчетовФедерации.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ФедерацияПНРОПС"));
	МассивСчетовФедерации.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ФедерацияПНСВ"));
	
	Если ПараметрыОценки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Эволюция") Тогда // НПФ Эволюция АО
	
		#Область Эволюция
	
	    // #348229: Для Эволюции для СЧА, в отличие от ЕПС, начисляем корректировку по ЭСП ежедневно
		// #373767: Начиная с 30.04.2021 опять начисляем с периодичностью как в ЕПС.
		
		Если ПараметрыОценки.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении И ДатаПереоценки < '20210430' Тогда
			ПараметрыНачисленияКорректировкиЭСП.НачислятьКорректировкуЭСП = Истина;
		КонецЕсли;
	
		#КонецОбласти
		
	ИначеЕсли ПараметрыОценки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_Сбербанк") Тогда // Сбербанка НПФ
		
		#Область Сбербанк
		
		Если ДатаПереоценки < '20191206' Тогда 	
			РасчетЦеныОтСтоимостиПоЭСП = Истина;
		КонецЕсли;
		
		#КонецОбласти
				
	ИначеЕсли ПараметрыОценки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Федерация") // НПФ ФЕДЕРАЦИЯ АО
		ИЛИ (ДатаПереоценки >= '20250917'																	// а с 17.09.25 
			И ПараметрыОценки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Будущее")      // еще и НПФ Будущее
			И МассивСчетовФедерации.Найти(ПараметрыОценки.СчетДоверительногоУправления) <> Неопределено)	// + фильтр по счетам ДУ
		ИЛИ (НачалоДня(СтрокаЦенныеБумаги.Партия.Дата) = '20251023' 										// 23.10.25 
			И ПараметрыОценки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Будущее")		// уже в чисто Будущиские портфели
			И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВЭБ.РФ_291")) // перебросили ВЭБ 291, но для него эти хардкоды нужно выполнить
		Тогда 
	
		#Область Федерация		
	
		// ВЭБ.РФ для СЧА до смены спецдепа считаем по своему алгоритму
		
		Если ПараметрыОценки.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении 		
			И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВЭБ.РФ_291")	// ВЭБ.РФ, 4B02-291-00004-T-001P, 1000.00 RUB 
			И НачалоДня(СтрокаПокупки.ДатаПокупки) = '20201117'
		Тогда
		
		    ВключатьРазницуПервоначальногоПризнанияВБалансовуюСтоимость = Ложь; // Вариант учета разницы ПП №2. Подробнее у Коли (#Техдолг)
		
			Если ДатаПереоценки < '20210303' Тогда
				
				// Считаем АС от цены, равной СС бумаги в день покупки, а затем полученную цену округляем до 2 знаков после запятой и пересчитываем итоговую стоимость (#347672)
			
				СтрокаПокупки.ЦенаПокупки		= 1019.52;
				СтрокаПокупки.ДопРасходы		= СтрокаПокупки.ЦенаПокупки - СтрокаПокупки.НоминалПриПокупке;
				СтрокаПокупки.НачальныйДисконт	= СтрокаПокупки.ДопРасходы;
				
				ТочностьЦены = 2;
				
				ПараметрыНачисленияКорректировкиЭСП.НачислятьКорректировкуЭСП	= Ложь;
				ПараметрыНачисленияКорректировкиЭСП.НаОснованииРешенияКлиента	= Неопределено;
				ПараметрыНачисленияКорректировкиЭСП.ДатаПервойЦеныПоЭСП			= Неопределено;
			
			ИначеЕсли ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП = '20210228' Тогда
			
				// Считаем аналогично бухгалтерии, а у нее цена на 28.02.2021 была другая (#365145):
				// АС = Тело + Дисконт/Премия + Корректировка ЭСП + Разница ПП
				
				Если ПараметрыОценки.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ФедерацияПН") Тогда			// НПФ ФЕДЕРАЦИЯ АО ПН
					ЦенаНаПредыдущуюПереоценку = (200000000.00 + 23585.16 + -213666.74 + 3879000.00) / 200000;
				ИначеЕсли ПараметрыОценки.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ФедерацияПНВР") Тогда	// НПФ ФЕДЕРАЦИЯ АО ПН ВР
					ЦенаНаПредыдущуюПереоценку = (600000.00 + 70.76 + -640.99 + 11637.00) / 600;
				ИначеЕсли ПараметрыОценки.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ФедерацияПНРОПС") Тогда	// НПФ ФЕДЕРАЦИЯ АО ПН РОПС
					ЦенаНаПредыдущуюПереоценку = (1300000.00 + 153.30 + -1388.83 + 25213.50) / 1300;
				ИначеЕсли ПараметрыОценки.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ФедерацияПНСВ") Тогда	// НПФ ФЕДЕРАЦИЯ АО ПН СВ
					ЦенаНаПредыдущуюПереоценку = (400000.00 + 47.17 + -427.33 + 7758.00) / 400;
				КонецЕсли;
				
			Иначе
				
				ВключатьРазницуПервоначальногоПризнанияВБалансовуюСтоимость = Истина; // Вариант учета разницы ПП №1. Подробнее у Коли (#Техдолг)
				
			КонецЕсли;
			
		КонецЕсли;
		
		#КонецОбласти
		
	ИначеЕсли ПараметрыОценки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Будущее") Тогда // НПФ БУДУЩЕЕ АО
		
		#Область Будущее
		
		ВключатьРазницуПервоначальногоПризнанияВБалансовуюСтоимость = (СтрокаПокупки.ДатаПокупки >= '20220707' // До 07.07.2022 по умолчанию был вариант учета разницы ПП №2
			ИЛИ (ДатаПереоценки = '20240329' ИЛИ ДатаПереоценки = '20240403') И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ДП_Роснфт2P7")); // НК Роснефть ПАО, 4B02-07-00122-A-002P, 1000.00 RUB 
		
		// Для бумаги "НК Роснефть ПАО, 4B02-07-00122-A-002P, 1000.00 RUB" портфеля "НПФ БУДУЩЕЕ АО ПН"
		// до 04.07.2019 есть разница выполняется расчет по бэку или по бухгалтерии
		
		Если ДатаПереоценки < '20190704'
			И ПараметрыОценки.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN084")	// НПФ БУДУЩЕЕ АО ПН 
			И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ДП_Роснфт2P7")		// НК Роснефть ПАО, 4B02-07-00122-A-002P, 1000.00 RUB
		Тогда
			ДанныеПереоценкиДляДисконтПремии.Вставить("ЦельРасчета", ПараметрыОценки.ЦельРасчета);
		КонецЕсли;
		
	    // 30.06.2019 в бухгалтерию пришло письмо об использовании своей даты оферты,
		// но бэк-офис и спецдеп считали по-старому, поэтому на эту дату не сходимся.
		// Однако 04.07.2017 клиент написал, чтобы и они использовали новую дату оферты,
		// поэтому мы должны начать совпадать с бухгалтерией, но так как мы пляшем
		// от последней стоимости по ЭСП, которая у нас 30.06.2019 зафиксирована по-иному,
		// то ее придется рассчитать.
		
		Если ДатаПереоценки >= '20190704' И ДатаПереоценки < '20190930'														// До следующей ежеквартальной переоценки 30.09.2019
			И ПараметрыОценки.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN084")	// НПФ БУДУЩЕЕ АО ПН 
			И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ДП_Роснфт2P7")		// НК Роснефть ПАО, 4B02-07-00122-A-002P, 1000.00 RUB
		Тогда
		
			Если ДополнительныеСвойства.Свойство("СтоимостиНаПредыдущуюПереоценку") Тогда
				СтоимостиПереоценки = ДополнительныеСвойства.СтоимостиНаПредыдущуюПереоценку.Получить(СтрокаЦенныеБумаги.ЦеннаяБумага);
			КонецЕсли;
				
			Если СтоимостиПереоценки = Неопределено Тогда	
				
				ПредыдущаяПереоценка = Новый Структура("Организация, СчетДоверительногоУправления, ЦельРасчета, ВидУчета, Дата");
				ЗаполнитьЗначенияСвойств(ПредыдущаяПереоценка, ПараметрыОценки);
				ПредыдущаяПереоценка.Дата = '20190630';
				
				РегистрацияСтоимостиПереоценки = Документы.РегистрацияСтоимостиПереоценки.СоздатьДокумент();
				ЗаполнитьЗначенияСвойств(РегистрацияСтоимостиПереоценки, ПредыдущаяПереоценка);
				
				ТаблицаЦенныхБумаг = СтрокаЦенныеБумаги.Владелец().Скопировать(Новый Структура("ЦеннаяБумага", СтрокаЦенныеБумаги.ЦеннаяБумага), "Рынок, ЦеннаяБумага, УчетныйАктивЕПС, Партия, СтрокаПартии, Количество, СуммаРезервовПодОбесценение");
