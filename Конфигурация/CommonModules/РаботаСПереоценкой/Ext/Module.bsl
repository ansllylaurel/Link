	#КонецОбласти
	
	ТолькоНаблюдаемыеЦены		= ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены;
	
	ММВБ						= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	НРД							= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");
	
	ОсновнойКалендарьКотировок	= Константы.ОсновнойКалендарьКотировок.Получить();
	ПоследняяДатаТоргов			= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки));
	ТорговыхДнейНазад10			= Справочники.Календари.ДобавитьКДатеРабочиеДни(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки), -10);
	
	Запрос.УстановитьПараметр("ММВБ",					ММВБ);
	Запрос.УстановитьПараметр("НРД",					НРД);
	
	Запрос.УстановитьПараметр("ДатаПереоценки",			ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",	ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10",	ТорговыхДнейНазад10);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ",		ТаблицаЦБ);
	
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены",	ТолькоНаблюдаемыеЦены);
	
	Запрос.УстановитьПараметр("БратьЦеныНРДВПроцентах",	ДатаПереоценки >= '20200707');
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены ППА 2018 (ЕПС)", "Таблица стоимостей ЦБ", , , "ИсходнаяТаблицаЦБ, _ЭмитентыЦенныхБумаг");		
	КонецЕсли;
	
	Если ТолькоНаблюдаемыеЦены ИЛИ ДатаПереоценки < Дата(2020, 1, 1) Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;
	
	// Расчетные цены 	
	
	ВыполненРасчетЦены = Ложь;	
	
	ПараметрыОценки.Вставить("ТочностьСтавкиДисконтирования", 2);
	
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
		КонецЕсли;
		
		// Расчетные цены
		
		Если (ЗначениеЗаполнено(СтрокаСтоимостейЦБ.Стоимость) ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены))
			И ЗначениеЗаполнено(СтрокаСтоимостейЦБ.УровеньОценки)
			И СтрокаСтоимостейЦБ.УровеньОценки < 3
		Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.ЭмитентРоссийский Тогда
		
			Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				
				#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков
				
				ЦенаЗаполнена = ЗаполнитьДисконтированнойПоБезрисковойСтавкеДоходностиСтоимостью(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, ПараметрыДенежногоПотока, , 2, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, 2, Отказ, РасшифровкаРасчета);
				
				Если ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
				КонецЕсли;
				
				#КонецОбласти
				
			ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
				
				#Область Расчет_на_основе_корректировки_исторической_цены					
				
				// Справедливая стоимость акций российских эмитентов, допущенным к торгам на ММВБ,
				// определяется в соответствии с моделью оценки, основанной на корректировке исторической цены (CAPM).
				// Применяем при отсутствии цены не более 10 рабочих дней
				
				ТочностьЦеныCAPM			   = ?(ДатаПереоценки >= '20200707', 2, 5);
				КалендарьПоискаНаблюдаемойЦены = ?(ДатаПереоценки >= '20200707', Справочники.Календари.Общероссийский, Неопределено); 
				
				ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, КалендарьПоискаНаблюдаемойЦены, , ТочностьЦеныCAPM, Отказ, РасшифровкаРасчета);  
				
				Если ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
				КонецЕсли;
				
				#КонецОбласти					
				
			КонецЕсли;
			
		КонецЕсли;

	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "Таблица стоимостей ЦБ", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныБудущего(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, РасшифровкаРасчета = Неопределено)
	
	ИностранныеУчетныеАктивы = Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 30
	|	КотировкиТорговыхПлощадок.Период КАК Период
	|ИЗ
	|	РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
	|ГДЕ
	|	КотировкиТорговыхПлощадок.Биржа = &Блумберг
	|	И КотировкиТорговыхПлощадок.Период <= &ДатаПереоценки
	|	И (КотировкиТорговыхПлощадок.РежимТоргов = &Режим_BVAL
	|				И КотировкиТорговыхПлощадок.CLOSE > 0
	|			ИЛИ КотировкиТорговыхПлощадок.РежимТоргов = &Режим_BGN
	|				И (КотировкиТорговыхПлощадок.BID > 0
	|					ИЛИ КотировкиТорговыхПлощадок.CLOSE > 0
	|					ИЛИ КотировкиТорговыхПлощадок.OFFER > 0))
	|
	|СГРУППИРОВАТЬ ПО
	|	КотировкиТорговыхПлощадок.Период
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	Запрос.УстановитьПараметр("Блумберг"	, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	Запрос.УстановитьПараметр("Режим_BGN"	, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL"	, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТорговыхДнейБлумбергаНазад30 = ВыборкаДетальныеЗаписи.Период;
		Прервать;
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал,
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	ЕСТЬNULL(Облигации.ДатаНачалаОбращения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаОбращения,
		|	ЕСТЬNULL(Облигации.ДатаНачалаРазмещения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаРазмещения
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|;
		|" + "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		   |	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		   |	ТаблицаЦБ.Номинал КАК Номинал,
		   |	ТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		   |	ТаблицаЦБ.Рынок КАК Рынок,
		   |	КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа КАК Биржа,
		   |	ВЫБОР
		   |		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= &ТорговыхДнейНазад31
		   |			ТОГДА ВЫБОР
		   |					КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		   |						ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2 * ТаблицаЦБ.Номинал / 100
		   |					ИНАЧЕ КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2
		   |				КОНЕЦ
		   |		КОГДА РасчетныеЦеныНРДСрезПоследних.Период >= &ТорговыхДнейНазад90
		   |			ТОГДА ВЫБОР
		   |					КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		   |						ТОГДА РасчетныеЦеныНРДСрезПоследних.RATE * ТаблицаЦБ.Номинал / 100
		   |					ИНАЧЕ РасчетныеЦеныНРДСрезПоследних.PRICE
		   |				КОНЕЦ
		   |		КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		   |					И НЕ ТаблицаЦБ.УчетныйАктивЦБРФ В (&ИностранныеУчетныеАктивы)
		   |				ИЛИ ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		   |				ИЛИ ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		   |				ИЛИ ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		   |			ТОГДА ВЫБОР
		   |					КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE < &ТорговыхДнейНазад31
		   |							И КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= &ТорговыхДнейНазад90
		   |						ТОГДА ВЫБОР
		   |								КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		   |									ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2 * ТаблицаЦБ.Номинал / 100
		   |								ИНАЧЕ КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2
		   |							КОНЕЦ
		   |					КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE3_DATE < &ТорговыхДнейНазад31
		   |							И КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE3_DATE >= &ТорговыхДнейНазад90
		   |						ТОГДА ВЫБОР
		   |								КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		   |									ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE3 * ТаблицаЦБ.Номинал / 100
		   |								ИНАЧЕ КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE3
		   |							КОНЕЦ
		   |					ИНАЧЕ 0
		   |				КОНЕЦ
		   |		КОГДА ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена, 0) > 0
		   |			ТОГДА РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК СправедливаяЦена,
		   |	ВЫБОР
		   |		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= &ТорговыхДнейНазад31
		   |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.РыночнаяЦена2)
		   |		КОГДА РасчетныеЦеныНРДСрезПоследних.Период >= &ТорговыхДнейНазад90
		   |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД)
		   |		КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		   |					И НЕ ТаблицаЦБ.УчетныйАктивЦБРФ В (&ИностранныеУчетныеАктивы)
		   |				ИЛИ ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		   |				ИЛИ ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		   |				ИЛИ ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		   |			ТОГДА ВЫБОР
		   |					КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE < &ТорговыхДнейНазад31
		   |							И КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= &ТорговыхДнейНазад90
		   |						ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.РыночнаяЦена2)
		   |					КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE3_DATE < &ТорговыхДнейНазад31
		   |							И КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE3_DATE >= &ТорговыхДнейНазад90
		   |						ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.РыночнаяЦена3)
		   |					ИНАЧЕ 0
		   |				КОНЕЦ
		   |		КОГДА ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена, 0) > 0
		   |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СЧА)
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК ПолеКотировки,
		   |	ВЫБОР
		   |		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= &ТорговыхДнейНазад31
		   |			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа.ЮрФизЛицо
		   |		КОГДА РасчетныеЦеныНРДСрезПоследних.Период >= &ТорговыхДнейНазад90
		   |			ТОГДА &НРД
		   |		КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		   |					И НЕ ТаблицаЦБ.УчетныйАктивЦБРФ В (&ИностранныеУчетныеАктивы)
		   |				ИЛИ ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		   |				ИЛИ ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		   |				ИЛИ ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		   |			ТОГДА ВЫБОР
		   |					КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE < &ТорговыхДнейНазад31
		   |							И КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= &ТорговыхДнейНазад90
		   |						ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа.ЮрФизЛицо
		   |					КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE3_DATE < &ТорговыхДнейНазад31
		   |							И КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE3_DATE >= &ТорговыхДнейНазад90
		   |						ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа.ЮрФизЛицо
		   |					ИНАЧЕ 0
		   |				КОНЕЦ
		   |		КОГДА ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена, 0) > 0
		   |			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК ИсточникКотировки,
		   |	ВЫБОР
		   |		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= &ТорговыхДнейНазад31
		   |			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE
		   |		КОГДА РасчетныеЦеныНРДСрезПоследних.Период >= &ТорговыхДнейНазад90
		   |			ТОГДА РасчетныеЦеныНРДСрезПоследних.Период
		   |		КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		   |					И НЕ ТаблицаЦБ.УчетныйАктивЦБРФ В (&ИностранныеУчетныеАктивы)
		   |				ИЛИ ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		   |				ИЛИ ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		   |				ИЛИ ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		   |			ТОГДА ВЫБОР
		   |					КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE < &ТорговыхДнейНазад31
		   |							И КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= &ТорговыхДнейНазад90
		   |						ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE
		   |					КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE3_DATE < &ТорговыхДнейНазад31
		   |							И КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE3_DATE >= &ТорговыхДнейНазад90
		   |						ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE3_DATE
		   |					ИНАЧЕ 0
		   |				КОНЕЦ
		   |		КОГДА ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена, 0) > 0
		   |			ТОГДА РасчетныеЦеныПаевСрезПоследних.Период
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК ДатаКотировки,
		   |	ВЫБОР
		   |		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= &ТорговыхДнейНазад31
		   |			ТОГДА 1
		   |		КОГДА РасчетныеЦеныНРДСрезПоследних.Период >= &ТорговыхДнейНазад90
		   |			ТОГДА 2
		   |		КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		   |					И НЕ ТаблицаЦБ.УчетныйАктивЦБРФ В (&ИностранныеУчетныеАктивы)
		   |				ИЛИ ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		   |				ИЛИ ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		   |				ИЛИ ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		   |			ТОГДА ВЫБОР
		   |					КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE < &ТорговыхДнейНазад31
		   |							И КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= &ТорговыхДнейНазад90
		   |						ТОГДА 3
		   |					КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE3_DATE < &ТорговыхДнейНазад31
		   |							И КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE3_DATE >= &ТорговыхДнейНазад90
		   |						ТОГДА 3
		   |					ИНАЧЕ 0
		   |				КОНЕЦ
		   |		КОГДА ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена, 0) > 0
		   |			ТОГДА 3
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК УровеньОценки,
		   |	ВЫБОР
		   |		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= &ТорговыхДнейНазад31
		   |			ТОГДА ВЫБОР
		   |					КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		   |						ТОГДА ТаблицаЦБ.ВалютаНоминала
		   |					ИНАЧЕ КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта
		   |				КОНЕЦ
		   |		КОГДА РасчетныеЦеныНРДСрезПоследних.Период >= &ТорговыхДнейНазад90
		   |			ТОГДА ТаблицаЦБ.ВалютаНоминала
		   |		КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		   |					И НЕ ТаблицаЦБ.УчетныйАктивЦБРФ В (&ИностранныеУчетныеАктивы)
		   |				ИЛИ ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		   |				ИЛИ ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		   |				ИЛИ ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		   |			ТОГДА ВЫБОР
		   |					КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE < &ТорговыхДнейНазад31
		   |							И КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE >= &ТорговыхДнейНазад90
		   |						ТОГДА ВЫБОР
		   |								КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		   |									ТОГДА ТаблицаЦБ.ВалютаНоминала
		   |								ИНАЧЕ КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта
		   |							КОНЕЦ
		   |					КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE3_DATE < &ТорговыхДнейНазад31
		   |							И КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE3_DATE >= &ТорговыхДнейНазад90
		   |						ТОГДА ВЫБОР
		   |								КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		   |									ТОГДА ТаблицаЦБ.ВалютаНоминала
		   |								ИНАЧЕ КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта
		   |							КОНЕЦ
		   |					ИНАЧЕ 0
		   |				КОНЕЦ
		   |		КОГДА ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена, 0) > 0
		   |			ТОГДА ТаблицаЦБ.ВалютаНоминала
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК ВалютаКотировки,
		   |	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала
		   |ПОМЕСТИТЬ Цены
		   |ИЗ
		   |	ТаблицаЦБ КАК ТаблицаЦБ
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД.СрезПоследних(
		   |				&ДатаПереоценки,
		   |				ЦеннаяБумага В
		   |					(ВЫБРАТЬ
		   |						ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		   |					ИЗ
		   |						ТаблицаЦБ КАК ТаблицаЦБ)) КАК РасчетныеЦеныНРДСрезПоследних
		   |		ПО ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныНРДСрезПоследних.ЦеннаяБумага
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		   |				&ДатаПереоценки,
		   |				РежимТоргов.ОсновнойРежим
		   |					И Биржа = &ММВБ
		   |					И ЦеннаяБумага В
		   |						(ВЫБРАТЬ
		   |							ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		   |						ИЗ
		   |							ТаблицаЦБ КАК ТаблицаЦБ)) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
		   |		ПО ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних КАК РасчетныеЦеныПаевСрезПоследних
		   |		ПО ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФСрезПоследних
		   |		ПО ((ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Паи)).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		   |ГДЕ
		   |	КотировкиТорговыхПлощадокСводныеСрезПоследних.Период = &ПоследняяДатаТоргов
		   |	И КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа = &ММВБ
		   |	И КотировкиТорговыхПлощадокСводныеСрезПоследних.РежимТоргов.ОсновнойРежим
		   |;
		   |
		   |////////////////////////////////////////////////////////////////////////////////
		   |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		   |	Цены.ЦеннаяБумага КАК ЦеннаяБумага,
		   |	Цены.Рынок КАК Рынок,
		   |	Цены.Номинал КАК Номинал,
		   |	Цены.ПолеКотировки КАК ВидЦены,
		   |	Цены.ДатаКотировки КАК ДатаЦены,
		   |	Цены.УровеньОценки КАК УровеньОценки,
		   |	Цены.ИсточникКотировки КАК Источник,
		   |	Цены.ВалютаНоминала КАК ВалютаНоминала,
		   |	Цены.ВалютаКотировки КАК ВалютаКупона,
		   |	Цены.ВалютаКотировки КАК ВалютаКотировки,
		   |	ЗНАЧЕНИЕ(Справочник.Биржи.ПустаяСсылка) КАК Биржа,
		   |	Цены.СправедливаяЦена КАК Стоимость
		   |ИЗ
		   |	Цены КАК Цены";
		
	ПоследняяДатаТоргов = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки));
	ПоследнийРабочийДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский,НачалоДня(ДатаПереоценки));
	ТорговыхДнейНазад31 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки)-86400, -30); // 30 предшествующих(!) торговых дней
	ТорговыхДнейНазад90 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -90);
	
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	Запрос.УстановитьПараметр("Организация", ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов", ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыОценки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад31", ТорговыхДнейНазад31);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад90", ТорговыхДнейНазад90);
	Запрос.УстановитьПараметр("ТорговыхДнейБлумбергаНазад30", ТорговыхДнейБлумбергаНазад30);
	Запрос.УстановитьПараметр("ММВБ", 		ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("Блумберг", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("Рубли", ПараметрыОценки.Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("НРД", ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("ИностранныеУчетныеАктивы", ИностранныеУчетныеАктивы);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены ППА 2018 (ЕПС)", "Таблица стоимостей ЦБ");		
	Иначе
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныБудущего201218(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, РасшифровкаРасчета = Неопределено)
	
	Если Не ПараметрыОценки.Свойство("ОцениватьПоСправедливойСтоимости") И ДатаПереоценки < '20190131' Тогда
		ПараметрыОценки.Вставить("ОцениватьПоСправедливойСтоимости", Истина); // До этой даты по амортизированной стоимости бумаги не оценивали	
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "ИсходнаяТаблицаЦБ");
	ПоместитьБумагиОцениваемыеПоАмортизированнойСтоимостиВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки, ДатаПереоценки, "ИсходнаяТаблицаЦБ");
	
	#Область Текст_запроса	
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(Облигации.ДатаНачалаОбращения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаОбращения,
		|	ЕСТЬNULL(Облигации.ДатаНачалаРазмещения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаРазмещения,
		|	_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК ОценкаПоАмортизированнойСтоимости
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _БумагиОцениваемыеПоАмортизированнойСтоимости КАК _БумагиОцениваемыеПоАмортизированнойСтоимости
		|		ПО (_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага = ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа КАК Биржа,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.РежимТоргов КАК РежимТоргов,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта КАК Валюта,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2 КАК MARKETPRICE2,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE КАК MARKETPRICE2_DATE
		|ПОМЕСТИТЬ _СводныеКотировкиТорговыхПлощадокСРежимами
		|ИЗ
		|	РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|			&ДатаПереоценки,
		|			РежимТоргов.ОсновнойРежим
		|				И Биржа = &ММВБ
		|				И ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|					ИЗ
		|						ТаблицаЦБ КАК ТаблицаЦБ)) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_СводныеКотировки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_СводныеКотировки.Биржа КАК Биржа,
		|	_СводныеКотировки.Валюта КАК Валюта,
		|	Котировка_MARKETPRICE2.MARKETPRICE2_DATE КАК MARKETPRICE2_DATE,
		|	Котировка_MARKETPRICE2.MARKETPRICE2 КАК MARKETPRICE2
		|ПОМЕСТИТЬ _СводныеКотировкиТорговыхПлощадок
		|ИЗ
		|	(ВЫБРАТЬ
		|		_СводныеКотировкиСРежимами.ЦеннаяБумага КАК ЦеннаяБумага,
		|		_СводныеКотировкиСРежимами.Биржа КАК Биржа,
		|		_СводныеКотировкиСРежимами.Валюта КАК Валюта,
		|		МАКСИМУМ(_СводныеКотировкиСРежимами.MARKETPRICE2_DATE) КАК MARKETPRICE2_DATE
		|	ИЗ
		|		_СводныеКотировкиТорговыхПлощадокСРежимами КАК _СводныеКотировкиСРежимами
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_СводныеКотировкиСРежимами.ЦеннаяБумага,
		|		_СводныеКотировкиСРежимами.Биржа,
		|		_СводныеКотировкиСРежимами.Валюта) КАК _СводныеКотировки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СводныеКотировкиТорговыхПлощадокСРежимами КАК Котировка_MARKETPRICE2
