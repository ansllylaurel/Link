		|			И (РасчетныеЦеныНРД.Период = &ДатаЦенНРД)
		|			И (РасчетныеЦеныНРД.VERSION = ""2"")
		|			И (РасчетныеЦеныНРД.METHOD_NUMBER В (""1"", ""2""))
		|ГДЕ
