		РасчетСтоимости	= "ОтПоследнейПоЭСП";
		Описание		= "Стоимость при первоначальном признании + амортизированная дисконт/премия";
		ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП = НачалоДня(ДатаВводаПартии); // До первой оценки по ЭСП считаем от указанной при ПП стоимости
	ИначеЕсли ПолученаВводомЦенныхБумаг И НачалоДня(ДатаВводаПартии) = НачалоДня(ДатаПереоценки) Тогда
		РасчетСтоимости	= "ПоДаннымПартий";
		Описание		= "Указанная при вводе ценной бумаги стоимость";
	ИначеЕсли ПолученаВводомЦенныхБумаг И ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП = Неопределено Тогда
		РасчетСтоимости	= "ОтПоследнейПоЭСП";
		Описание		= "Указанная при вводе ценной бумаги стоимость + амортизированная дисконт/премия";
		ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП = НачалоДня(ДатаВводаПартии); // До первой оценки по ЭСП считаем от указанной при вводе стоимости
	ИначеЕсли ПараметрыНачисленияКорректировкиЭСП.НаОснованииРешенияКлиента <> Неопределено Тогда
		РасчетСтоимости	= "ОтПоследнейПоЭСП";
		Описание		= СтрШаблон("Стоимость по ЭСП на %1 (решение клиента о прогнозируемых потоках) + амортизированная дисконт/премия", Формат(ПараметрыНачисленияКорректировкиЭСП.ДатаПоследнейЦеныПоЭСП, "ДФ=dd.MM.yyyy"));
	ИначеЕсли ПараметрыНачисленияКорректировкиЭСП.ДатаПервойЦеныПоЭСП = Неопределено			// Вообще не считать корректировку ЭСП
		ИЛИ КонецДня(ДатаПереоценки) < ПараметрыНачисленияКорректировкиЭСП.ДатаПервойЦеныПоЭСП	// С момента покупки день расчета корректировки по ЭСП еще не наступил
		ИЛИ Год(СтрокаПокупки.ДатаПокупки) = 2018 И ДатаПереоценки < '20190331'					// Ранее считался как-то странно и без учета разницы первоначального признания
	Тогда
		РасчетСтоимости	= "ОтДатыПокупки";
		Описание		= "Стоимость покупки, уменьшенная на амортизированную дисконт/премию";
	Иначе
		РасчетСтоимости	= "ОтПоследнейПоЭСП";
		Описание		= "Последняя рассчитанная по ЭСП стоимость + амортизированная дисконт/премия";
	КонецЕсли;
	
	Если РасчетСтоимости = "ОтДатыПокупки" Тогда 
	
		#Область Стоимость_покупки_плюс_изменения_дисконт_премии				
	
		// Если переоценку еще не выполняли,
		// то берем стоимость покупки, уменьшенную на амортизированную дисконт/премию

		ИзменениеНоминала = ?(СведенияОБумаге.Амортизационная, СтрокаПокупки.НоминалПриПокупке - СведенияОБумаге.Номинал, 0);		
		
		БалансоваяЦена		= ?(СтрокаПокупки.НачальныйДисконт >= 0 ИЛИ НастройкиУчета.СтоимостьТелаРавнаНоминалу, СтрокаПокупки.НоминалПриПокупке, СтрокаПокупки.ЦенаПокупкиНачальная) - ИзменениеНоминала;
		БалансоваяСтоимость	= БалансоваяЦена * СтрокаЦенныеБумаги.Количество;		
		
		БалансовыеДисконтПремия = БалансовыеДанныеНаУтро.БалансовыеДисконтПремия;
		
		Если НачалоДня(СтрокаПокупки.ДатаПокупки) = НачалоДня(ДатаПереоценки) Тогда // В день покупки в партиях на балансе еще ничего нет
			БалансовыеДисконтПремия = СтрокаПокупки.НачальныйДисконт * СтрокаЦенныеБумаги.Количество;
		КонецЕсли;
		
		РасчетДисконтПремии = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремии(СтрокаЦенныеБумаги.ЦеннаяБумага, НастройкиУчета, ДанныеПереоценкиДляДисконтПремии, ДанныеПокупкиДляДисконтПремии, Отказ);

		ОценочныеДисконтПремия = Окр(РасчетДисконтПремии.ОценочныеДисконтПремия, 2);	
		
		Если СтрокаПокупки.НачальныйДисконт > 0 И ОценочныеДисконтПремия > БалансовыеДисконтПремия		// недосписали премии
			ИЛИ СтрокаПокупки.НачальныйДисконт < 0 И ОценочныеДисконтПремия < БалансовыеДисконтПремия	// недоначислили дисконта
		Тогда
			ОценочныеДисконтПремия = БалансовыеДисконтПремия;	
		КонецЕсли;		
		
		НачальнаяРазницаППНеНаблюдаемыеДанные = БалансовыеДанныеНаУтро.НачальнаяРазницаППНеНаблюдаемыеДанные;
		ОценочнаяРазницаППНеНаблюдаемыеДанные = НачальнаяРазницаППНеНаблюдаемыеДанные; // Периодичность разницы ПП совпадает с периодичностью корректировки ЭСП	
			
		АмортизированнаяСтоимость = РассчитатьАмортизированнуюСтоимостьПоДаннымПартий(
			ПравильныйУчетПП, ВключатьРазницуПервоначальногоПризнанияВБалансовуюСтоимость,
			БалансоваяСтоимость, НачальнаяРазницаППНеНаблюдаемыеДанные, ОценочнаяРазницаППНеНаблюдаемыеДанные, ОценочныеДисконтПремия,
			0, СуммаРезервовПодОбесценение, СтрокаЦенныеБумаги.Количество, БалансоваяЦена);
			
		Цена		 = АмортизированнаяСтоимость.Цена;
		СтоимостьСЧА = АмортизированнаяСтоимость.Сумма;		
		
		Если ТочностьЦены <> Неопределено Тогда
			ЦенаДоОкругления = Цена;	
			Цена			 = Окр(Цена, ТочностьЦены);
			СтоимостьСЧА	 = Окр(Цена * СтрокаЦенныеБумаги.Количество, 2);	
		КонецЕсли;		
		
		СтрокаЦенныеБумаги.РыночнаяЦена			= Цена;
		СтрокаЦенныеБумаги.ЦенаКотировки		= СтрокаЦенныеБумаги.РыночнаяЦена;
		СтрокаЦенныеБумаги.ВалютаКотировки		= СведенияОБумаге.ВалютаНоминала;
		СтрокаЦенныеБумаги.Биржа				= Справочники.Биржи.ПустаяСсылка();
		СтрокаЦенныеБумаги.ИсточникЦены			= ПараметрыОценки.Клиент;
		СтрокаЦенныеБумаги.ПолеЦены 			= Перечисления.ИсточникиЦеныДляПереоценки.АмортизированнаяСтоимость;
		СтрокаЦенныеБумаги.УровеньОценки		= 1;			
		СтрокаЦенныеБумаги.ДатаКотировки 		= ДатаПереоценки;					
		
		#Область Расшифровка_расчета					
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			
			ПараметрыРасчетаЦен = Новый Структура;
			ПараметрыРасчетаЦен.Вставить("Описание",					Описание);
			ПараметрыРасчетаЦен.Вставить("БалансоваяСумма",				БалансоваяСтоимость);
			ПараметрыРасчетаЦен.Вставить("НачальнаяРазницаПП",			НачальнаяРазницаППНеНаблюдаемыеДанные);
			ПараметрыРасчетаЦен.Вставить("ОценочнаяРазницаПП",			ОценочнаяРазницаППНеНаблюдаемыеДанные);
			ПараметрыРасчетаЦен.Вставить("ОценочныеДисконтПремия",		ОценочныеДисконтПремия);
			ПараметрыРасчетаЦен.Вставить("РезервыПодОбесценение",		СуммаРезервовПодОбесценение);
			ПараметрыРасчетаЦен.Вставить("СтоимостьСЧА",				СтоимостьСЧА);
			
			Если ТочностьЦены <> Неопределено Тогда
				ПараметрыРасчетаЦен.Вставить("ЦенаДоОкругления",		ЦенаДоОкругления);
				ПараметрыРасчетаЦен.Вставить("ТочностьЦены",			ТочностьЦены);
			КонецЕсли;
			
			ПараметрыРасчетаЦен.Вставить("Цена",						Цена);

			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , , ПараметрыРасчетаЦен);
			
		КонецЕсли;
		
		#КонецОбласти
		
		#КонецОбласти
			
	ИначеЕсли РасчетСтоимости = "ПоЭСП" Тогда  
		
		#Область Стоимость_по_ЭСП				
		
		// Оценка в конце квартала
		
		ДанныеРасчета								= Неопределено;
		НастройкиУчета.ВариантУчетаКупонногоДохода	= Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке; // ЭСП независимо от настроек
		Биржа										= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
		
		Если ДополнительныеСвойства.Свойство("РасчетАмортизированнойСтоимости") Тогда
			РезультатРасчетаПоПартии = ДополнительныеСвойства.РасчетАмортизированнойСтоимости.НайтиСтроки(Новый Структура("Партия, СтрокаПартии", СтрокаЦенныеБумаги.Партия, СтрокаЦенныеБумаги.СтрокаПартии)); 		
			Если РезультатРасчетаПоПартии.Количество() = 1 Тогда
				ДанныеРасчета = РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(РезультатРасчетаПоПартии[0]);
			КонецЕсли;
		КонецЕсли;
		
		Если ДанныеРасчета = Неопределено Тогда
			
			#Область Определение_балансовых_дисконт_премии
			
			БалансовыеДисконтПремия = БалансовыеДанныеНаУтро.БалансовыеДисконтПремия;
			
			Если НачалоДня(СтрокаПокупки.ДатаПокупки) = НачалоДня(ДатаПереоценки) Тогда
				
				// В день покупки в партиях на балансе еще ничего нет

				БалансовыеДисконтПремия = СтрокаПокупки.НачальныйДисконт * СтрокаЦенныеБумаги.Количество;
				
			ИначеЕсли ПолученаВводомЦенныхБумаг И НачалоДня(ДатаВводаПартии) = НачалоДня(ДатаПереоценки) Тогда	
				
				// В день ввода в партиях на балансе еще ничего нет
				
				ДисконтПремияНаДатуПереоценки = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремии(СтрокаЦенныеБумаги.ЦеннаяБумага, НастройкиУчета, ДанныеПереоценкиДляДисконтПремии, ДанныеПокупкиДляДисконтПремии, Отказ).ОценочныеДисконтПремия;	
					
				БалансовыеДисконтПремия = Окр(ДисконтПремияНаДатуПереоценки, 2);
				
				Если СтрокаПокупки.НачальныйДисконт >= 0 Тогда
				
					БалансовыеДанныеНаУтро.Стоимость = СтрокаЦенныеБумаги.Количество * СтрокаЦенныеБумаги.Номинал;
					
				Иначе
					
					БалансовыеДанныеНаУтро.Стоимость = СтрокаЦенныеБумаги.Количество * (СтрокаЦенныеБумаги.Номинал - СтрокаПокупки.НачальныйДисконт);
					
				КонецЕсли;
					
			Иначе	
				
				// Дисконт/премия начисляется также в документах ПогашениеКупона и ПогашениеЦеннойБумаги,
				// значит в день погашения в момент расчета стоимости по ЭСП балансовая дисконт/премия будет отличаться от утренней
				
				Если СведенияОБумаге.ЭтоДеньПогашенияКупона ИЛИ СведенияОБумаге.ЭтоДеньПогашенияНоминала Тогда
					
					ДисконтПремияНаДатуПереоценки = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремии(СтрокаЦенныеБумаги.ЦеннаяБумага, НастройкиУчета, ДанныеПереоценкиДляДисконтПремии, ДанныеПокупкиДляДисконтПремии, Отказ).ОценочныеДисконтПремия;
					Если Не(СтрокаПокупки.НачальныйДисконт > 0 И ДисконтПремияНаДатуПереоценки > БалансовыеДисконтПремия	// недосписали премии
						ИЛИ СтрокаПокупки.НачальныйДисконт < 0 И ДисконтПремияНаДатуПереоценки < БалансовыеДисконтПремия)	// недоначислили дисконта
					Тогда
						БалансовыеДисконтПремия = Окр(ДисконтПремияНаДатуПереоценки, 2);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			#КонецОбласти
			
			ДанныеПереоценки = Новый Структура;
			ДанныеПереоценки.Вставить("ДатаПереоценки",												  КонецДня(ДатаПереоценки));
			ДанныеПереоценки.Вставить("Партия",														  СтрокаПокупки.Партия);
			ДанныеПереоценки.Вставить("СтрокаПартии",												  СтрокаПокупки.СтрокаПартии);
			ДанныеПереоценки.Вставить("БалансовыйДисконт",											  БалансовыеДисконтПремия);
			ДанныеПереоценки.Вставить("УчетныйАктивЕПС",											  СтрокаЦенныеБумаги.УчетныйАктивЕПС);
			ДанныеПереоценки.Вставить("Количество",													  СтрокаЦенныеБумаги.Количество);
			ДанныеПереоценки.Вставить("ОценочнаяСуммаКупона",										  СтрокаЦенныеБумаги.ОценочнаяЦенаКупона * СтрокаЦенныеБумаги.Количество);
			ДанныеПереоценки.Вставить("БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", БалансовыеДанныеНаУтро.БалансоваяРазницаППНеНаблюдаемыеДанные);
			ДанныеПереоценки.Вставить("СчетДоверительногоУправления", 								  ПараметрыОценки.СчетДоверительногоУправления);
			
			СтоимостьТела = БалансовыеДанныеНаУтро.Стоимость;
			Если СведенияОБумаге.Амортизационная И СведенияОБумаге.ЭтоДеньПогашенияНоминала И СведенияОБумаге.СуммаИзменения <> 0 Тогда
				СтоимостьТела = СтоимостьТела - СтрокаЦенныеБумаги.Количество * СведенияОБумаге.СуммаИзменения; 
			КонецЕсли;
			ДанныеПереоценки.Вставить("Стоимость",													  СтоимостьТела);
			
			ДанныеПокупки = Новый Структура;
			ДанныеПокупки.Вставить("НачальныйДисконт",												СтрокаПокупки.НачальныйДисконт);
			ДанныеПокупки.Вставить("ДатаПокупки",													СтрокаПокупки.ДатаПокупки);
			ДанныеПокупки.Вставить("ДатаПокупкиНачальная",											СтрокаПокупки.ДатаПокупкиНачальная);
			ДанныеПокупки.Вставить("КорректировкаЭСПНачальная",										СтрокаПокупки.КорректировкаЭСПНачальная);
			ДанныеПокупки.Вставить("ЦенаПокупки",													СтрокаПокупки.ЦенаПокупки);
			ДанныеПокупки.Вставить("ЦенаПокупкиКупона",												СтрокаПокупки.ЦенаКупона);
			ДанныеПокупки.Вставить("НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные",	БалансовыеДанныеНаУтро.НачальнаяРазницаППНеНаблюдаемыеДанные / СтрокаЦенныеБумаги.Количество);
			ДанныеПокупки.Вставить("ЦенаПокупкиНачальная", 											СтрокаПокупки.ЦенаПокупкиНачальная);

			ДанныеРасчета = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремииИКорректировкуПоЭСПИРазницуПервоначальногоПризнания(СтрокаЦенныеБумаги.ЦеннаяБумага, ДанныеПереоценки, ДанныеПокупки, НастройкиУчета, Отказ);				
				
			Если ДанныеРасчета.СтоимостьПоЭСП <> 0 Тогда	
			
				Если ДанныеРасчета.ЭСПКорректировка < 0 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка расчета ЭСП для " + СтрокаЦенныеБумаги.ЦеннаяБумага + " из партии " + СтрокаЦенныеБумаги.Партия + ", строка " + СтрокаЦенныеБумаги.СтрокаПартии,,,, Отказ);
					Возврат Ложь;
				КонецЕсли;
				
				// Если рассчитываем стоимость по ЭСП при получении от клиента сведений о будущих денежных потоках,
				// то корректировать разницу первоначального признания не требуется
				
				Если ПараметрыНачисленияКорректировкиЭСП.НаОснованииРешенияКлиента = Неопределено Тогда
					
					ВидУчетаДляНастроек = ПараметрыОценки.ВидУчета;
					Если ВидУчетаДляНастроек <> Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
						ВидУчетаДляНастроек = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
					КонецЕсли;
					
					НастройкиВидаУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(КонецДня(ДатаПереоценки), ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления, ВидУчетаДляНастроек, Отказ);	
					Если Отказ Тогда
						Возврат Ложь;
					КонецЕсли;

					Если (НастройкиВидаУчета.УчитыватьПогрешностьОкругленияНаПартиях ИЛИ НастройкиВидаУчета.УчитыватьПогрешностьОкругленияНаПартияхВВалютеУчета)
						И Не БухгалтерскийУчетЕПС.ОтключенаОценкаРазницыПервоначальногоПризнания(НастройкиУчета, СтрокаПокупки.Партия, СтрокаПокупки.СтрокаПартии, СтрокаЦенныеБумаги.ЦеннаяБумага, СтрокаЦенныеБумаги.УчетныйАктивЕПС, ДатаПереоценки)
					Тогда
						
						#Область Распределение_погрешности_округления_первоначального_признания_ценных_бумаг_на_партии
						
						ТребуетсяРаспределениеПогрешности	= Неопределено;
						ПогрешностиПоПакетуПартий			= Неопределено;
						
						Если ДополнительныеСвойства.Свойство("РаспределениеПогрешностиОкругленияППНаПартии") Тогда
						
							РаспределениеПогрешностиОкругленияППНаПартии = ДополнительныеСвойства.РаспределениеПогрешностиОкругленияППНаПартии.Получить(НачалоДня(СтрокаПокупки.ДатаПокупки));
							Если РаспределениеПогрешностиОкругленияППНаПартии <> Неопределено Тогда 
								ТребуетсяРаспределениеПогрешности	= РаспределениеПогрешностиОкругленияППНаПартии.ТребуетсяРаспределениеПогрешности;
								ПогрешностиПоПакетуПартий			= РаспределениеПогрешностиОкругленияППНаПартии.ПогрешностиПоПакетуПартий;
							КонецЕсли;
						
						КонецЕсли;
						
						Если ТребуетсяРаспределениеПогрешности = Неопределено Тогда
							
							РазрядностьОкругления = СтрокаЦенныеБумаги.Владелец().Колонки.ОценочнаяРазницаППНеНаблюдаемыеДанные.ТипЗначения;
							
							ПакетПартий = СтрокаЦенныеБумаги.Владелец().Скопировать(Новый Структура("ЦеннаяБумага", СтрокаЦенныеБумаги.ЦеннаяБумага), "Партия, СтрокаПартии, Количество, БалансоваяРазницаППНеНаблюдаемыеДанные, ОценочнаяРазницаППНеНаблюдаемыеДанные");
							ПакетПартий.Колонки.Добавить("ДатаПокупки", Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
							ПакетПартий.Колонки.Добавить("Погрешность", РазрядностьОкругления);
							
							Для Каждого СтрокаПартии Из ПакетПартий Цикл
								СтрокаПартии.ДатаПокупки = ТаблицаДатИЦенПокупки.НайтиСтроки(Новый Структура("Партия, СтрокаПартии", СтрокаПартии.Партия, СтрокаПартии.СтрокаПартии))[0].ДатаПокупки;
							КонецЦикла;
							
							ПакетПартий = ПакетПартий.Скопировать(Новый Структура("ДатаПокупки", НачалоДня(СтрокаПокупки.ДатаПокупки)));
							
							Если ПакетПартий.Количество() = 0 Тогда
								
								ТребуетсяРаспределениеПогрешности = Ложь;	
								
							Иначе
								
								// Получим сумму, которая будет без применения корректировки
								НачалоПериода = НачалоКвартала(ДатаПереоценки);
								Если ДатаПереоценки >= '20210101'  Тогда
									НачалоПериода = НачалоМесяца(ДатаПереоценки);
								КонецЕсли;
								
								ДатаНачалаРасчетаРазницыПП = ?(СтрокаПокупки.ДатаПокупки < НачалоПериода, НачалоДня(НачалоПериода - 1), СтрокаПокупки.ДатаПокупки);
								
								Для Каждого Партия Из ПакетПартий Цикл
									
									СтрокиБалансовыеДанныеНаУтро = ДополнительныеСвойства.БалансовыеДанныеНаУтро.НайтиСтроки(Новый Структура("Партия, СтрокаПартии", Партия.Партия, Партия.СтрокаПартии));
	
									Если СтрокиБалансовыеДанныеНаУтро.Количество() = 0 Тогда
										Продолжить;
									КонецЕсли;
									
									БалансовоеКоличество				   = ?(СтрокиБалансовыеДанныеНаУтро[0].Количество = 0, Партия.Количество, СтрокиБалансовыеДанныеНаУтро[0].Количество);
									БалансоваяРазницаППНеНаблюдаемыеДанные = Окр(СтрокиБалансовыеДанныеНаУтро[0].БалансоваяРазницаППНеНаблюдаемыеДанные / БалансовоеКоличество * Партия.Количество, 2);
									
									ДанныеПереоценкиПоПартии = Новый Структура;
									ДанныеПереоценкиПоПартии.Вставить("ДатаПереоценки",					КонецДня(ДатаПереоценки));
									ДанныеПереоценкиПоПартии.Вставить("Количество",						Партия.Количество);
									ДанныеПереоценкиПоПартии.Вставить("СчетДоверительногоУправления",	ПараметрыОценки.СчетДоверительногоУправления);
									ДанныеПереоценкиПоПартии.Вставить("УчетныйАктивЕПС",				СтрокаЦенныеБумаги.УчетныйАктивЕПС);
									
									ДанныеПокупкиПоПартии = Новый Структура;
									ДанныеПокупкиПоПартии.Вставить("НачальныйДисконт",	БалансоваяРазницаППНеНаблюдаемыеДанные / Партия.Количество);
									ДанныеПокупкиПоПартии.Вставить("ДатаПокупки",		ДатаНачалаРасчетаРазницыПП);
									ДанныеПокупкиПоПартии.Вставить("ЦенаПокупки",		0);
									
									ДанныеРасчетаРазницыПервоначальногоПризнания = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремии(СтрокаЦенныеБумаги.ЦеннаяБумага, НастройкиУчета, ДанныеПереоценкиПоПартии, ДанныеПокупкиПоПартии, Отказ);
										
									Партия.БалансоваяРазницаППНеНаблюдаемыеДанные = БалансоваяРазницаППНеНаблюдаемыеДанные;
									Партия.ОценочнаяРазницаППНеНаблюдаемыеДанные  = ДанныеРасчетаРазницыПервоначальногоПризнания.ОценочныеДисконтПремия;
									
								КонецЦикла;
								
								// Получим сумму по пакету партий
								
								ПакетПартийСвернутый = ПакетПартий.Скопировать(); 
								ПакетПартийСвернутый.Свернуть("", "Количество, БалансоваяРазницаППНеНаблюдаемыеДанные, ОценочнаяРазницаППНеНаблюдаемыеДанные");
								
								ИтогиПоПакетуПартий = ПакетПартийСвернутый[0];
								
								ДанныеПереоценкиПоПакету = Новый Структура;
								ДанныеПереоценкиПоПакету.Вставить("ДатаПереоценки",					КонецДня(ДатаПереоценки));
								ДанныеПереоценкиПоПакету.Вставить("Количество",						ИтогиПоПакетуПартий.Количество);
								ДанныеПереоценкиПоПакету.Вставить("СчетДоверительногоУправления",	ПараметрыОценки.СчетДоверительногоУправления);
								ДанныеПереоценкиПоПакету.Вставить("УчетныйАктивЕПС",				СтрокаЦенныеБумаги.УчетныйАктивЕПС);
								
								ДанныеПокупкиПоПакету = Новый Структура;
								ДанныеПокупкиПоПакету.Вставить("НачальныйДисконт",	ИтогиПоПакетуПартий.БалансоваяРазницаППНеНаблюдаемыеДанные / ИтогиПоПакетуПартий.Количество);
								ДанныеПокупкиПоПакету.Вставить("ДатаПокупки",		ДатаНачалаРасчетаРазницыПП);
								ДанныеПокупкиПоПакету.Вставить("ЦенаПокупки",		0);
								
								ДанныеРасчетаРазницыПервоначальногоПризнания = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремии(СтрокаЦенныеБумаги.ЦеннаяБумага, НастройкиУчета, ДанныеПереоценкиПоПакету, ДанныеПокупкиПоПакету, Отказ);
								
								ОценочнаяРазницаППНеНаблюдаемыеДанныеРасчетная = РазрядностьОкругления.ПривестиЗначение(ДанныеРасчетаРазницыПервоначальногоПризнания.ОценочныеДисконтПремия);	
									
								// Если они отличаются, то корректировку следует применять
									
								ТребуетсяРаспределениеПогрешности = (ИтогиПоПакетуПартий.ОценочнаяРазницаППНеНаблюдаемыеДанные <> ОценочнаяРазницаППНеНаблюдаемыеДанныеРасчетная);
								
								Если ТребуетсяРаспределениеПогрешности Тогда
									
									КоличествоКРаспределению	= ИтогиПоПакетуПартий.Количество;
									ПогрешностьКРаспределению	= ОценочнаяРазницаППНеНаблюдаемыеДанныеРасчетная - ИтогиПоПакетуПартий.ОценочнаяРазницаППНеНаблюдаемыеДанные;
									
									Для Каждого Партия Из ПакетПартий Цикл
										
										Партия.Погрешность = ПогрешностьКРаспределению / КоличествоКРаспределению * Партия.Количество;
										
										Если Партия.Погрешность <> 0 Тогда
											ПогрешностьКРаспределению = ПогрешностьКРаспределению - Партия.Погрешность;
										КонецЕсли;
										
										КоличествоКРаспределению = КоличествоКРаспределению - Партия.Количество;
										
									КонецЦикла;
									
									ПогрешностиПоПакетуПартий = ПакетПартий;
									
								КонецЕсли;
								
							КонецЕсли;									
							
