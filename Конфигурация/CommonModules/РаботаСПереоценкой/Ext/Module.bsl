	Возврат РезультатФункции;		
		
КонецФункции

Функция РассчитатьАмортизированнуюСтоимостьПоДаннымПартий(ПравильныйУчетПП, ВключатьРазницуППВБалансовуюСтоимость, БалансоваяСтоимость, НачальнаяРазницаПП, РазницаПП, ДисконтПремия, КорректировкаЭСП, РезервыПодОбесценение, Количество, БалансоваяЦена = Неопределено)
	
	Если ПравильныйУчетПП Тогда
				
		#Область Расчет_цены_для_счетов_с_правильным_учетом_ПП			
	
		Если ВключатьРазницуППВБалансовуюСтоимость Тогда
			НачальнаяРазницаПП = 0;
		КонецЕсли;										
		
		Цена = ?(БалансоваяЦена = Неопределено, 0, БалансоваяЦена)
			 + (?(БалансоваяЦена = Неопределено, БалансоваяСтоимость, 0)
			 	- НачальнаяРазницаПП
				+ РазницаПП
				+ ДисконтПремия
				+ КорректировкаЭСП
				+ РезервыПодОбесценение) / Количество;
				
		Сумма = БалансоваяСтоимость
	        - НачальнаяРазницаПП
			+ РазницаПП
			+ ДисконтПремия
			+ КорректировкаЭСП
			+ РезервыПодОбесценение;
			
		#КонецОбласти
							
	Иначе
		
		#Область Расчет_цены_для_счетов_с_неправильным_учетом_ПП			
		
		Если ВключатьРазницуППВБалансовуюСтоимость Тогда
			РазницаПП = 0;
		КонецЕсли;										
		
		Цена = ?(БалансоваяЦена = Неопределено, 0, БалансоваяЦена)
			+ (?(БалансоваяЦена = Неопределено, БалансоваяСтоимость, 0)
				+ НачальнаяРазницаПП
				- РазницаПП
				+ ДисконтПремия
				+ КорректировкаЭСП
				+ РезервыПодОбесценение) / Количество;
				
		Сумма = БалансоваяСтоимость
			+ НачальнаяРазницаПП
			- РазницаПП
			+ ДисконтПремия
			+ КорректировкаЭСП
			+ РезервыПодОбесценение;
				
		#КонецОбласти						
			
	КонецЕсли;	
	
	Возврат Новый Структура("Цена, Сумма", Цена, Сумма);	
	
КонецФункции

Функция СоставляющиеАмортизированнойСтоимостиПоДаннымПартий(Период, ПараметрыОценки, ЦенныеБумаги = Неопределено)
	
	ЗапросПартий = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.СтоимостьВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.ИндексацияНоминалаОстаток КАК БалансоваяСуммаВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйВВалютеУчетаОстаток КАК БалансовыеДисконтПремия,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйВВалютеУчетаОстаток КАК ОценочныеДисконтПремия,
		|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПВВалютеУчетаОстаток КАК ОценочнаяКорректировкаЭСП,
		|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчетаОстаток КАК БалансоваяРазницаППНеНаблюдаемыеДанные,
		|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчетаОстаток КАК ОценочнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальнаяОстаток КАК НачальнаяРазницаППНеНаблюдаемыеДанные,
		|	БухПартииЦенныхБумагОстатки.СуммаРезервовПодОбесценениеОстаток КАК СуммаРезервовПодОбесценение,
		|	БухПартииЦенныхБумагОстатки.ЗадолженностьПоПогашениюКупонаВВалютеУчетаОстаток КАК ЗадолженностьПоПогашениюКупона,
		|	БухПартииЦенныхБумагОстатки.СтоимостьОстаток КАК Стоимость,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
		|	НоминалыЦенныхБумаг.Номинал КАК Номинал,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.Сделка)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.Партия КАК Документ.Сделка).НомерСделки
		|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
		|			ТОГДА ВЫРАЗИТЬ(ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.Партия КАК Документ.ИсполнениеОбязательствПоСделке).Основание КАК Документ.Сделка).НомерСделки
		|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ВводЦенныхБумаг)
		|			ТОГДА ВводЦенныхБумагЦенныеБумаги.НомерСделки
		|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.РеклассификацияАктивовЕПС)
		|			ТОГДА РеклассификацияАктивовЕПСПартии.НомерСделки
		|		ИНАЧЕ """"""""
		|	КОНЕЦ КАК НомерСделки
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				И &ФильтрЦенныхБумаг) КАК БухПартииЦенныхБумагОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&Период, &ФильтрЦенныхБумаг) КАК НоминалыЦенныхБумаг
		|		ПО (НоминалыЦенныхБумаг.ЦеннаяБумага = БухПартииЦенныхБумагОстатки.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО БухПартииЦенныхБумагОстатки.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|			И БухПартииЦенныхБумагОстатки.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеклассификацияАктивовЕПС.Партии КАК РеклассификацияАктивовЕПСПартии
		|		ПО БухПартииЦенныхБумагОстатки.Партия = РеклассификацияАктивовЕПСПартии.Ссылка
		|			И БухПартииЦенныхБумагОстатки.СтрокаПартии = РеклассификацияАктивовЕПСПартии.НомерСтроки");

	ЗапросПартий.Текст = СтрЗаменить(ЗапросПартий.Текст, "&ФильтрЦенныхБумаг", ?(ЦенныеБумаги = Неопределено, "ИСТИНА", "ЦеннаяБумага В (&ЦенныеБумаги)"));
	
	ЗапросПартий.УстановитьПараметр("Период",						Период);
	ЗапросПартий.УстановитьПараметр("Организация",					ПараметрыОценки.Организация);
	ЗапросПартий.УстановитьПараметр("СчетДоверительногоУправления",	ПараметрыОценки.СчетДоверительногоУправления);
	ЗапросПартий.УстановитьПараметр("ЦенныеБумаги",					ЦенныеБумаги);
	
	Возврат ЗапросПартий.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область Общие_функции_расчета_цены

// Поиск наблюдаемой цены не более [ГлубинаПоиска] дней
//
// Параметры:
//	ПараметрыОценки - Структура - см. РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС 
//	ДатаПереоценки - Дата - исключая эту дату
//	ЦеннаяБумага - ОпределяемыеТипы.ЦенныеБумаги -   
//	ГлубинаПоиска - Число - глубина поиска в днях в соответствии с параметром Календарь
//	Календарь - СправочникСсылка.Календари, Неопределено - в зависимости от значения: 
//		Общероссийский календарь - глубина поиска в рабочих днях
//		Календарь котировок - глубина поиска в торговых днях
//		Неопределено - глубина поиска в календарных днях
//
// Возвращаемое значение:
//	ПоследняяНаблюдаемаяЦена - Структура - содержит поля как в РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС + ДатаПоследнейЦены
Функция ПолучитьПоследнююНаблюдаемуюЦену(ПараметрыОценки, ДатаПереоценки, ЦеннаяБумага, ГлубинаПоиска, Знач Календарь = Неопределено, Отказ)
	
	#Область Запрос_максимально_дальней_даты
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ДанныеКалендаряНаЗаданнуюГлубину.Дата КАК Дата
		|ИЗ
		|	(ВЫБРАТЬ ПЕРВЫЕ 999
		|		ДанныеКалендаря.Дата КАК Дата
		|	ИЗ
		|		РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|	ГДЕ
		|		ДанныеКалендаря.Календарь = &Календарь
		|		И ДанныеКалендаря.ВидДня В(&ВидыДней)
		|		И ДанныеКалендаря.Дата < &ДатаПереоценки
		|	
		|	УПОРЯДОЧИТЬ ПО
		|		Дата УБЫВ) КАК ДанныеКалендаряНаЗаданнуюГлубину
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДанныеКалендаряНаЗаданнуюГлубину.Дата");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 999", "ПЕРВЫЕ " + Формат(ГлубинаПоиска, "ЧН=; ЧГ="));	
	
	ВидыДней = Новый Массив;
	
	Если Календарь = Неопределено Тогда
		Календарь	 = Справочники.Календари.Общероссийский;
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ДанныеКалендаря.ВидДня В (&ВидыДней)", "");
	Иначе
		ВидыДней.Добавить(Перечисления.ВидыДнейКалендаря.Рабочий);
		ВидыДней.Добавить(Перечисления.ВидыДнейКалендаря.Предпраздничный);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДатаПереоценки",	ДатаПереоценки);
	Запрос.УстановитьПараметр("Календарь",		Календарь);
	Запрос.УстановитьПараметр("ВидыДней",		ВидыДней);
	
	#КонецОбласти
	
	МаксимальноДальняяДата = Запрос.Выполнить().Выгрузить()[0].Дата;
	
	ТаблицаТекущейЦБ = Новый ТаблицаЗначений;
	ТаблицаТекущейЦБ.Колонки.Добавить("Рынок",			Метаданные.РегистрыСведений.СтоимостьПереоценки.Измерения.Рынок.Тип);
	ТаблицаТекущейЦБ.Колонки.Добавить("ЦеннаяБумага",	Метаданные.РегистрыСведений.СтоимостьПереоценки.Измерения.ЦеннаяБумага.Тип);
	
	СтрокаТаблицы = ТаблицаТекущейЦБ.Добавить();
	СтрокаТаблицы.ЦеннаяБумага	= ЦеннаяБумага;
	СтрокаТаблицы.Рынок			= РаботаСЦеннымиБумагамиКлиентСервер.РынокПоЦеннойБумаге(ЦеннаяБумага);
	
	ОшибкаРасчета			 = Ложь;
	ПоследняяНаблюдаемаяЦена = Неопределено;
	ДатаПоследнейЦены		 = НачалоДня(НачалоДня(ДатаПереоценки) - 1);
	
	Пока ДатаПоследнейЦены >= МаксимальноДальняяДата Цикл
		
		ПараметрыПолученияНаблюдаемойЦены = Новый Структура;
		ПараметрыПолученияНаблюдаемойЦены.Вставить("Организация",							ПараметрыОценки.Организация);
		ПараметрыПолученияНаблюдаемойЦены.Вставить("СчетДоверительногоУправления",			ПараметрыОценки.СчетДоверительногоУправления);
		ПараметрыПолученияНаблюдаемойЦены.Вставить("ВидУчета",								Неопределено);
		ПараметрыПолученияНаблюдаемойЦены.Вставить("ВариантРасчетаСправедливойСтоимости",	ПараметрыОценки.ВариантРасчетаСправедливойСтоимости);
		ПараметрыПолученияНаблюдаемойЦены.Вставить("ПараметрыПолученияПартий",				Неопределено);
		ПараметрыПолученияНаблюдаемойЦены.Вставить("Клиент",								ПараметрыОценки.Клиент);
		ПараметрыПолученияНаблюдаемойЦены.Вставить("ТолькоНаблюдаемыеЦены",					Истина);
		
		ТаблицаСтоимостиЦБПредыдущихДней = РассчитатьСтоимостьПереоценкиЕПС(ПараметрыПолученияНаблюдаемойЦены, ДатаПоследнейЦены, ТаблицаТекущейЦБ, , ОшибкаРасчета);		
		
		Если ОшибкаРасчета Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Ошибка поиска последней наблюдаемой цены %1", ЦеннаяБумага), , , , Отказ);
			Прервать;
		ИначеЕсли ТаблицаСтоимостиЦБПредыдущихДней.Количество() > 0 И ТаблицаСтоимостиЦБПредыдущихДней[0].Стоимость > 0 Тогда
			ПоследняяНаблюдаемаяЦена = ТаблицаСтоимостиЦБПредыдущихДней[0];
			Прервать;
		КонецЕсли;						
		
		ДатаПоследнейЦены = ДатаПоследнейЦены - 86400;
		
	КонецЦикла;
	
	Если ПоследняяНаблюдаемаяЦена <> Неопределено Тогда
		ПоследняяНаблюдаемаяЦена = РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(ПоследняяНаблюдаемаяЦена);
		ПоследняяНаблюдаемаяЦена.Вставить("ДатаПоследнейЦены", ПоследняяНаблюдаемаяЦена.ДатаЦены);
	КонецЕсли;
	
	Возврат ПоследняяНаблюдаемаяЦена;
	
КонецФункции	

// Ищет последнюю зарегистрированную цену 1 или 2 уровня на заданную глубину поиска
//
// Параметры:
//	ПараметрыОценки - Структура - см. РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС 
//	ДатаПереоценки - Дата - исключая эту дату
//	ЦеннаяБумага - ОпределяемыеТипы.ЦенныеБумаги -   
//	ГлубинаПоиска - Число - глубина поиска в днях в соответствии с параметром Календарь
//	Календарь - СправочникСсылка.Календари, Неопределено - в зависимости от значения: 
//		Общероссийский календарь - глубина поиска в рабочих днях
//		Календарь котировок - глубина поиска в торговых днях
//		Неопределено - глубина поиска в календарных днях
//
// Возвращаемое значение:
//	ПоследняяНаблюдаемаяЦена - Структура со свойствами "Стоимость" и "ДатаПоследнейЦены"
//
Функция ПоследняяЦенаПервогоИлиВторогоУровня(ПараметрыОценки, ДатаПереоценки, ЦеннаяБумага, ГлубинаПоиска, Знач Календарь = Неопределено)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ДанныеКалендаряНаЗаданнуюГлубину.Дата КАК Дата
		|ИЗ
		|	(ВЫБРАТЬ ПЕРВЫЕ 999
		|		ДанныеКалендаря.Дата КАК Дата
		|	ИЗ
		|		РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|	ГДЕ
		|		ДанныеКалендаря.Календарь = &Календарь
		|		И ДанныеКалендаря.ВидДня В(&ВидыДней)
		|		И ДанныеКалендаря.Дата < &ДатаПереоценки
		|	
		|	УПОРЯДОЧИТЬ ПО
		|		Дата УБЫВ) КАК ДанныеКалендаряНаЗаданнуюГлубину
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДанныеКалендаряНаЗаданнуюГлубину.Дата");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 999", "ПЕРВЫЕ " + Формат(ГлубинаПоиска, "ЧН=; ЧГ="));	
	
	ВидыДней = Новый Массив;
	
	Если Календарь = Неопределено Тогда
		Календарь	 = Справочники.Календари.Общероссийский;
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ДанныеКалендаря.ВидДня В (&ВидыДней)", "");
	Иначе
		ВидыДней.Добавить(Перечисления.ВидыДнейКалендаря.Рабочий);
		ВидыДней.Добавить(Перечисления.ВидыДнейКалендаря.Предпраздничный);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДатаПереоценки",	ДатаПереоценки);
	Запрос.УстановитьПараметр("Календарь",		Календарь);
	Запрос.УстановитьПараметр("ВидыДней",		ВидыДней);
	
	МаксимальноДальняяДата = Запрос.Выполнить().Выгрузить()[0].Дата;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СтоимостьПереоценки.Цена КАК Цена,
		|	СтоимостьПереоценки.Период КАК Период
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|ГДЕ
		|	СтоимостьПереоценки.Период < &ДатаПереоценки
		|	И СтоимостьПереоценки.Период >= &МаксимальноДальняяДата
		|	И СтоимостьПереоценки.Организация = &Организация
		|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета
		|	И СтоимостьПереоценки.Рынок = &Рынок
		|	И СтоимостьПереоценки.ЦеннаяБумага = &ЦеннаяБумага
		|	И СтоимостьПереоценки.ВидУчета = &ВидУчета
		|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
		|	И СтоимостьПереоценки.УровеньОценки В (1, 2)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СтоимостьПереоценки.Период УБЫВ";
	
	Запрос.УстановитьПараметр("МаксимальноДальняяДата",			МаксимальноДальняяДата);
	Запрос.УстановитьПараметр("Организация", 					ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ПараметрыОценки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦельРасчета", 					ПараметрыОценки.ЦельРасчета);
	Запрос.УстановитьПараметр("ЦеннаяБумага", 					ЦеннаяБумага);
	Запрос.УстановитьПараметр("Рынок", 							РаботаСЦеннымиБумагамиКлиентСервер.РынокПоЦеннойБумаге(ЦеннаяБумага));
	Запрос.УстановитьПараметр("ВидУчета", 						ПараметрыОценки.ВидУчета);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Новый Структура("Стоимость, ДатаПоследнейЦены", Выборка.Цена, Выборка.Период), Неопределено);		
		
КонецФункции

// Рассчитывает цену в соответствии с моделью оценки, основанной на корректировке исторической цены (CAPM)
//
// Параметры:
//	ПараметрыОценки - Структура - см. РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС 
//	ДатаПереоценки - Дата - исключая эту дату
//	СтрокаСтоимостейЦБ - СтрокаТаблицыЗначений - строка таблицы значений как в РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС  
//	ГлубинаПоиска - см. РаботаСПереоценкой.ПолучитьПоследнююНаблюдаемуюЦену
//	Календарь - см. РаботаСПереоценкой.ПолучитьПоследнююНаблюдаемуюЦену 
//	ТочностьЦены - Число - округление до указанного числа знаков после запятой,
//				 - Неопределено - цена не округляется
//	Отказ - Булево - 
//	РасшифровкаРасчета - Структура, Неопределено - 
//
// Возвращаемое значение:
//	РезультатыРасчета - Структура - содержит поля РасчетнаяСтоимость, ОжидаемаяДоходность и др. 	
//
Функция ПолучитьЦенуНаОсновеКорректировкиИсторическойЦены(ПараметрыОценки, ДатаПереоценки, СтрокаСтоимостейЦБ, ГлубинаПоиска, Календарь = Неопределено, ТочностьЦены = Неопределено, Отказ, РасшифровкаРасчета = Неопределено)
	
	ПоследняяНаблюдаемаяЦена = ПолучитьПоследнююНаблюдаемуюЦену(ПараметрыОценки, ДатаПереоценки, СтрокаСтоимостейЦБ.ЦеннаяБумага, ГлубинаПоиска, Календарь, Отказ);
	
	Если ПоследняяНаблюдаемаяЦена = Неопределено Тогда
		Если РасшифровкаРасчета <> Неопределено Тогда	
			ПредставлениеДней	= Справочники.Календари.СтрокаСДнями(ГлубинаПоиска, Календарь);
			ПараметрыРасчетаЦен	= Новый Структура("НаблюдаемаяЦена", "На глубину " + ПредставлениеДней + " не найдена");
			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Параметры расчета цены", ПараметрыРасчетаЦен);
		КонецЕсли;
		
		Возврат Неопределено;
	КонецЕсли;
	
	#Область Уведомляем_при_приближении_окончания_взятия_цены
	
	Если Календарь = Неопределено Тогда
		ДнейОтНаблюдаемойЦены = ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(ДатаПереоценки, ПоследняяНаблюдаемаяЦена.ДатаПоследнейЦены);
	Иначе
		ДнейОтНаблюдаемойЦены = Справочники.Календари.КоличествоРабочихДней(Календарь, ПоследняяНаблюдаемаяЦена.ДатаПоследнейЦены, ДатаПереоценки);
	КонецЕсли;
	
	ОсталосьДней = ГлубинаПоиска - ДнейОтНаблюдаемойЦены;
	
	Если ГлубинаПоиска <= 10 И ОсталосьДней <= 1
		ИЛИ ГлубинаПоиска > 10 И ОсталосьДней <= 10 
	Тогда
	
		ПолноеИмяИсточника 	= "Документ.РегистрацияСтоимостиАктивов.ЗаполнитьДокументыРегистрацииСтоимости.ОповещениеПриДлительномОтсутствииНаблюдаемойЦены";
		Тема				= СтрШаблон("Оценка '%1' на %2 в '%3' при длительном отсутствии наблюдаемой цены", СтрокаСтоимостейЦБ.ЦеннаяБумага, Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy"), ПараметрыОценки.СчетДоверительногоУправления);
		Текст				= СтрШаблон("У бумаги '%1' длительное время отсутствует наблюдаемая цена, до окончания оценки по CAPM осталось %2.", СтрокаСтоимостейЦБ.ЦеннаяБумага, Справочники.Календари.СтрокаСДнями(ОсталосьДней, Календарь));
		
		ДобавитьУведомление(ПараметрыОценки, ПолноеИмяИсточника, Тема, Текст);	
	
	КонецЕсли;
	
	#КонецОбласти
	
	РасчетОтПоследнейОпределеннойЦеныПервогоИлиВторогоУровня = (ДатаПереоценки < '20240329');
	
	Если РасчетОтПоследнейОпределеннойЦеныПервогоИлиВторогоУровня Тогда
		
		#Область Получение_последней_определенной_цены_1_и_2_уровня
		
		ПоследняяОпределеннаяЦена = ПоследняяЦенаПервогоИлиВторогоУровня(ПараметрыОценки, ДатаПереоценки, СтрокаСтоимостейЦБ.ЦеннаяБумага, ГлубинаПоиска, Календарь);
		
		Если ПоследняяОпределеннаяЦена = Неопределено Тогда
			Если РасшифровкаРасчета <> Неопределено Тогда	
				ПредставлениеДней	= Справочники.Календари.СтрокаСДнями(ГлубинаПоиска, Календарь);
				ПараметрыРасчетаЦен	= Новый Структура("ПоследняяОпределеннаяЦена", "На глубину " + ПредставлениеДней + " не найдена");
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Параметры расчета цены", ПараметрыРасчетаЦен);
			КонецЕсли;
			
			Возврат Неопределено;
		КонецЕсли;	
		
		#КонецОбласти
		
		ПараметрыИсторическойЦены = ПоследняяОпределеннаяЦена;
	Иначе	
		ПараметрыИсторическойЦены = ПоследняяНаблюдаемаяЦена;
	КонецЕсли;
	
	// Рыночный индикатор
	
	ММВБ						= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");	
	ОсновнойКалендарьКотировок	= Константы.ОсновнойКалендарьКотировок.Получить();	
	ПредшествующийТорговыйДень	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(ОсновнойКалендарьКотировок, НачалоДня(НачалоДня(ДатаПереоценки) - 1));
	ТорговыхДнейНазад45			= Справочники.Календари.ДобавитьКДатеРабочиеДни(ОсновнойКалендарьКотировок, ПредшествующийТорговыйДень, -45);	
	
	#Область Запрос_данных_по_рыночному_индикатору
	
	ЗапросДанныхПоИндикатору = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	БиржевыеИндексы.Ссылка КАК Индикатор
		|ПОМЕСТИТЬ _РыночныйИндикатор
		|ИЗ
		|	Справочник.БиржевыеИндексы КАК БиржевыеИндексы
		|ГДЕ
		|	БиржевыеИндексы.Код = &КодИндикатора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначениеИндикатораТекущее.Валюта КАК ВалютаТекущегоИндикатора,
		|	ЗначениеИндикатораТекущее.CLOSE КАК ТекущийИндикатор,
		|	ВЫБОР
		|		КОГДА КурсыВалютТекущегоИндикатора.Валюта = КурсыВалютНоминала.Валюта
		|			ТОГДА ЗначениеИндикатораТекущее.CLOSE
		|		ИНАЧЕ ЗначениеИндикатораТекущее.CLOSE * КурсыВалютТекущегоИндикатора.Курс * КурсыВалютНоминала.Кратность / КурсыВалютТекущегоИндикатора.Кратность / КурсыВалютНоминала.Курс
		|	КОНЕЦ КАК ТекущийИндикаторВВалютеНоминала,
		|	ЗначениеИндикатораПоследнейЦены.Валюта КАК ВалютаИндикатораНаДатуПоследнейЦены,
		|	ЗначениеИндикатораПоследнейЦены.CLOSE КАК ИндикаторНаДатуПоследнейЦены,
		|	ВЫБОР
		|		КОГДА КурсыВалютИндикатораНаДатуПоследнейЦены.Валюта = КурсыВалютНоминала.Валюта
		|			ТОГДА ЗначениеИндикатораПоследнейЦены.CLOSE
		|		ИНАЧЕ ЗначениеИндикатораПоследнейЦены.CLOSE * КурсыВалютИндикатораНаДатуПоследнейЦены.Курс * КурсыВалютНоминала.Кратность / КурсыВалютИндикатораНаДатуПоследнейЦены.Кратность / КурсыВалютНоминала.Курс
		|	КОНЕЦ КАК ИндикаторНаДатуПоследнейЦеныВВалютеНоминала,
		|	ВЫБОР
		|		КОГДА КурсыВалютТекущегоИндикатора.Валюта = КурсыВалютНоминала.Валюта
		|			ТОГДА ЗначениеИндикатораТекущее.CLOSE
		|		ИНАЧЕ ЗначениеИндикатораТекущее.CLOSE * КурсыВалютТекущегоИндикатора.Курс * КурсыВалютНоминала.Кратность / КурсыВалютТекущегоИндикатора.Кратность / КурсыВалютНоминала.Курс
		|	КОНЕЦ / ВЫБОР
		|		КОГДА КурсыВалютИндикатораНаДатуПоследнейЦены.Валюта = КурсыВалютНоминала.Валюта
		|			ТОГДА ЗначениеИндикатораПоследнейЦены.CLOSE
		|		ИНАЧЕ ЗначениеИндикатораПоследнейЦены.CLOSE * КурсыВалютИндикатораНаДатуПоследнейЦены.Курс * КурсыВалютНоминала.Кратность / КурсыВалютИндикатораНаДатуПоследнейЦены.Кратность / КурсыВалютНоминала.Курс
		|	КОНЕЦ - 1 КАК ДоходностьИндикатора
		|ПОМЕСТИТЬ _ДоходностьРыночногоИндикатора
		|ИЗ
		|	_РыночныйИндикатор КАК _РыночныйИндикатор
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов.СрезПоследних(
		|				&ДатаПереоценки,
		|				(Биржа, БиржевойИндекс) В
		|					(ВЫБРАТЬ
		|						&ММВБ,
		|						_РыночныйИндикатор.Индикатор
		|					ИЗ
		|						_РыночныйИндикатор)) КАК ЗначениеИндикатораТекущее
		|		ПО (ЗначениеИндикатораТекущее.БиржевойИндекс = _РыночныйИндикатор.Индикатор)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов.СрезПоследних(
		|				&ДатаИсторическойЦены,
		|				(Биржа, БиржевойИндекс) В
		|					(ВЫБРАТЬ
		|						&ММВБ,
		|						_РыночныйИндикатор.Индикатор
		|					ИЗ
		|						_РыночныйИндикатор)) КАК ЗначениеИндикатораПоследнейЦены
		|		ПО (ЗначениеИндикатораПоследнейЦены.БиржевойИндекс = _РыночныйИндикатор.Индикатор)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютТекущегоИндикатора
		|		ПО (КурсыВалютТекущегоИндикатора.Валюта = ЗначениеИндикатораТекущее.Валюта)
		|			И (КурсыВалютТекущегоИндикатора.Период = &ДатаПереоценки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютИндикатораНаДатуПоследнейЦены
		|		ПО (КурсыВалютИндикатораНаДатуПоследнейЦены.Валюта = ЗначениеИндикатораТекущее.Валюта)
		|			И (КурсыВалютИндикатораНаДатуПоследнейЦены.Период = &ДатаПереоценки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютНоминала
		|		ПО (КурсыВалютНоминала.Валюта = &ВалютаНоминала)
		|			И (КурсыВалютНоминала.Период = &ДатаПереоценки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _ТорговыеДни
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &КалендарьКотировок
		|	И ДанныеКалендаря.Дата МЕЖДУ &ТорговыхДнейНазад45 И &ПредшествующийТорговыйДень
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначениеИндикатораТекущее.Период КАК Период,
		|	ЗначениеИндикатораТекущее.Валюта КАК Валюта,
		|	ЗначениеИндикатораТекущее.CLOSE КАК Значение,
		|	ВЫБОР
		|		КОГДА КурсыВалютУчета.Валюта = КурсыВалютНоминала.Валюта
		|			ТОГДА ЗначениеИндикатораТекущее.CLOSE
		|		ИНАЧЕ ЗначениеИндикатораТекущее.CLOSE * КурсыВалютУчета.Курс * КурсыВалютНоминала.Кратность / КурсыВалютУчета.Кратность / КурсыВалютНоминала.Курс
		|	КОНЕЦ КАК ЗначениеВВалютеНоминала,
		|	ЛОЖЬ КАК ПоследнийИзвестный
		|ПОМЕСТИТЬ _ЗначенияРыночногоИндикатора
		|ИЗ
		|	_ТорговыеДни КАК _ТорговыеДни
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _РыночныйИндикатор КАК _РыночныйИндикатор
		|		ПО (ИСТИНА)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначениеИндикатораТекущее
		|		ПО (ЗначениеИндикатораТекущее.Биржа = &ММВБ)
		|			И (ЗначениеИндикатораТекущее.БиржевойИндекс = _РыночныйИндикатор.Индикатор)
		|			И (ЗначениеИндикатораТекущее.Период = _ТорговыеДни.Дата)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютУчета
		|		ПО (КурсыВалютУчета.Валюта = ЗначениеИндикатораТекущее.Валюта)
		|			И (КурсыВалютУчета.Период = &ПредшествующийТорговыйДень)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютНоминала
		|		ПО (КурсыВалютНоминала.Валюта = &ВалютаНоминала)
		|			И (КурсыВалютНоминала.Период = &ПредшествующийТорговыйДень)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПоследнийИзвестныйИндикатор.Период,
		|	ПоследнийИзвестныйИндикатор.Валюта,
		|	ПоследнийИзвестныйИндикатор.CLOSE,
		|	ВЫБОР
		|		КОГДА КурсыВалютУчета.Валюта = КурсыВалютНоминала.Валюта
		|			ТОГДА ПоследнийИзвестныйИндикатор.CLOSE
		|		ИНАЧЕ ПоследнийИзвестныйИндикатор.CLOSE * КурсыВалютУчета.Курс * КурсыВалютНоминала.Кратность / КурсыВалютУчета.Кратность / КурсыВалютНоминала.Курс
		|	КОНЕЦ,
		|	ИСТИНА
		|ИЗ
		|	РегистрСведений.ЗначенияБиржевыхИндексов.СрезПоследних(
		|			ДОБАВИТЬКДАТЕ(&ТорговыхДнейНазад45, ДЕНЬ, -1),
		|			(Биржа, БиржевойИндекс) В
		|				(ВЫБРАТЬ
		|					&ММВБ,
		|					_РыночныйИндикатор.Индикатор
		|				ИЗ
		|					_РыночныйИндикатор)) КАК ПоследнийИзвестныйИндикатор
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютУчета
		|		ПО (КурсыВалютУчета.Валюта = ПоследнийИзвестныйИндикатор.Валюта)
		|			И (КурсыВалютУчета.Период = &ПредшествующийТорговыйДень)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютНоминала
		|		ПО (КурсыВалютНоминала.Валюта = &ВалютаНоминала)
		|			И (КурсыВалютНоминала.Период = &ПредшествующийТорговыйДень)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Бета КАК Бета
		|ПОМЕСТИТЬ _ПараметрыКоэффициентаБета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РыночныйИндикатор.Индикатор КАК Индикатор,
		|	_ДоходностьРыночногоИндикатора.ТекущийИндикаторВВалютеНоминала КАК ТекущийИндикатор,
		|	_ДоходностьРыночногоИндикатора.ИндикаторНаДатуПоследнейЦеныВВалютеНоминала КАК ИндикаторНаДатуПоследнейЦены,
		|	_ДоходностьРыночногоИндикатора.ДоходностьИндикатора КАК ДоходностьИндикатора,
		|	_ПараметрыКоэффициентаБета.Бета КАК Бета
		|ИЗ
		|	_РыночныйИндикатор КАК _РыночныйИндикатор,
		|	_ДоходностьРыночногоИндикатора КАК _ДоходностьРыночногоИндикатора,
		|	_ПараметрыКоэффициентаБета КАК _ПараметрыКоэффициентаБета");
		
		// Коэффициент Бета
		
		Если ПараметрыОценки.Свойство("ПараметрыМоделиCAPM") И ПараметрыОценки.ПараметрыМоделиCAPM.Свойство("Бета") Тогда
		
			ЗапросДанныхПоИндикатору.УстановитьПараметр("Бета", ПараметрыОценки.ПараметрыМоделиCAPM.Бета);
			
		Иначе

			ЗапросДанныхПоИндикатору.Текст = СтрЗаменить(ЗапросДанныхПоИндикатору.Текст,
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	&Бета КАК Бета
				|ПОМЕСТИТЬ _ПараметрыКоэффициентаБета",
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	КотировкиЦенныхБумаг.Валюта КАК Валюта,
				|	КотировкиЦенныхБумаг.Период КАК Период,
				|	КотировкиЦенныхБумаг.РежимТоргов КАК РежимТоргов,
				|	КотировкиЦенныхБумаг.LEGALCLOSEPRICE КАК ЦенаЗакрытия,
				|	ВЫБОР
				|		КОГДА КурсыВалютУчета.Валюта = КурсыВалютНоминала.Валюта
				|			ТОГДА КотировкиЦенныхБумаг.LEGALCLOSEPRICE
				|		ИНАЧЕ КотировкиЦенныхБумаг.LEGALCLOSEPRICE * КурсыВалютУчета.Курс * КурсыВалютНоминала.Кратность / КурсыВалютУчета.Кратность / КурсыВалютНоминала.Курс
				|	КОНЕЦ КАК ЦенаЗакрытияВВалютеНоминала,
				|	КотировкиЦенныхБумаг.LEGALCLOSEPRICE * КурсыВалютУчета.Курс / КурсыВалютУчета.Кратность КАК ЦенаЗакрытияВВалютеУчета,
				|	КотировкиЦенныхБумаг.VOLUME КАК ОбъемСделокВКоличествеБумаг,
				|	КотировкиЦенныхБумаг.VALUE * КурсыВалютУчета.Курс / КурсыВалютУчета.Кратность КАК ОбъемСделокВВалютеУчета
				|ПОМЕСТИТЬ _КотировкиММВБ
				|ИЗ
				|	_ТорговыеДни КАК _ТорговыеДни
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиЦенныхБумаг
				|		ПО (КотировкиЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага)
				|			И (КотировкиЦенныхБумаг.Рынок = &Рынок)
				|			И (КотировкиЦенныхБумаг.Биржа = &ММВБ)
				|			И (КотировкиЦенныхБумаг.Период = _ТорговыеДни.Дата)
				|			И (КотировкиЦенныхБумаг.РежимТоргов.ОсновнойРежим)
				|			И (КотировкиЦенныхБумаг.LEGALCLOSEPRICE <> 0)
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютУчета
				|		ПО (КурсыВалютУчета.Валюта = КотировкиЦенныхБумаг.Валюта)
				|			И (КурсыВалютУчета.Период = &ПредшествующийТорговыйДень)
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютНоминала
				|		ПО (КурсыВалютНоминала.Валюта = &ВалютаНоминала)
				|			И (КурсыВалютНоминала.Период = &ПредшествующийТорговыйДень)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_КотировкиММВБ.Период КАК Период,
				|	_КотировкиММВБ.РежимТоргов КАК РежимТоргов,
				|	_КотировкиММВБ.ОбъемСделокВКоличествеБумаг КАК ОбъемСделокВКоличествеБумаг,
				|	_КотировкиММВБ.ОбъемСделокВВалютеУчета КАК ОбъемСделокВВалютеУчета,
				|	КОЛИЧЕСТВО(_КотировкиММВБ1.РежимТоргов) КАК Приоритет
				|ПОМЕСТИТЬ _КотировкиММВБПриоритетРежимаТорговПоОбъему
				|ИЗ
				|	_КотировкиММВБ КАК _КотировкиММВБ
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КотировкиММВБ КАК _КотировкиММВБ1
				|		ПО _КотировкиММВБ.Период = _КотировкиММВБ1.Период
				|			И _КотировкиММВБ.ОбъемСделокВКоличествеБумаг <= _КотировкиММВБ1.ОбъемСделокВКоличествеБумаг
				|			И _КотировкиММВБ.ОбъемСделокВВалютеУчета <= _КотировкиММВБ1.ОбъемСделокВВалютеУчета
				|
				|СГРУППИРОВАТЬ ПО
				|	_КотировкиММВБ.Период,
				|	_КотировкиММВБ.РежимТоргов,
				|	_КотировкиММВБ.ОбъемСделокВКоличествеБумаг,
				|	_КотировкиММВБ.ОбъемСделокВВалютеУчета
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_КотировкиММВБ.Период КАК Период,
				|	_КотировкиММВБ.ЦенаЗакрытияВВалютеНоминала КАК ЦенаЗакрытия,
				|	_ЗначенияРыночногоИндикатора.ЗначениеВВалютеНоминала КАК ЗначениеИндикатора
				|ПОМЕСТИТЬ _СопоставленныеПоказатели
				|ИЗ
				|	_КотировкиММВБ КАК _КотировкиММВБ
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КотировкиММВБПриоритетРежимаТорговПоОбъему КАК _КотировкиММВБПриоритетРежимаТорговПоОбъему
				|		ПО (_КотировкиММВБПриоритетРежимаТорговПоОбъему.РежимТоргов = _КотировкиММВБ.РежимТоргов)
				|			И (_КотировкиММВБПриоритетРежимаТорговПоОбъему.Период = _КотировкиММВБ.Период)
				|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияРыночногоИндикатора КАК _ЗначенияРыночногоИндикатора
				|		ПО (_ЗначенияРыночногоИндикатора.Период = _КотировкиММВБ.Период)
				|			И (_ЗначенияРыночногоИндикатора.ПоследнийИзвестный = ЛОЖЬ)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_СопоставленныеПоказатели.Период КАК Период,
				|	_СопоставленныеПоказатели.ЦенаЗакрытия КАК ЦенаЗакрытия,
				|	ЕСТЬNULL(_СопоставленныеПоказатели.ЗначениеИндикатора, ПоследниеИзвестныеИндикаторы.ЗначениеВВалютеНоминала) КАК ЗначениеИндикатора
				|ПОМЕСТИТЬ _ДозаполненныеПоказатели
				|ИЗ
				|	_СопоставленныеПоказатели КАК _СопоставленныеПоказатели
				|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				|			ПоказателиСПустотами.Период КАК Период,
				|			МАКСИМУМ(_ЗначенияРыночногоИндикатора.Период) КАК ДатаПоследнегоИзвестного
				|		ИЗ
				|			_СопоставленныеПоказатели КАК ПоказателиСПустотами
				|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ЗначенияРыночногоИндикатора КАК _ЗначенияРыночногоИндикатора
				|				ПО (_ЗначенияРыночногоИндикатора.Период < ПоказателиСПустотами.Период)
				|		ГДЕ
				|			ПоказателиСПустотами.ЗначениеИндикатора ЕСТЬ NULL
				|		
				|		СГРУППИРОВАТЬ ПО
				|			ПоказателиСПустотами.Период) КАК ДатыИндикаторов
				|		ПО (ДатыИндикаторов.Период = _СопоставленныеПоказатели.Период)
				|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияРыночногоИндикатора КАК ПоследниеИзвестныеИндикаторы
				|		ПО (ПоследниеИзвестныеИндикаторы.Период = ДатыИндикаторов.ДатаПоследнегоИзвестного)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	Показатели.Период КАК Период,
				|	(ВЫРАЗИТЬ(Показатели.ЦенаЗакрытия КАК ЧИСЛО(27, 10))) / ПредыдущиеПоказатели.ЦенаЗакрытия - 1 КАК ДоходностьАктива,
				|	(ВЫРАЗИТЬ(Показатели.ЗначениеИндикатора КАК ЧИСЛО(27, 10))) / ПредыдущиеПоказатели.ЗначениеИндикатора - 1 КАК ДоходностьИндикатора
				|ПОМЕСТИТЬ _Доходности
				|ИЗ
				|	_ДозаполненныеПоказатели КАК Показатели
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				|			ТекущийПериод.Период КАК Период,
				|			МАКСИМУМ(ПредыдущийПериод.Период) КАК ПредыдущийПериод
				|		ИЗ
				|			_ДозаполненныеПоказатели КАК ТекущийПериод
				|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДозаполненныеПоказатели КАК ПредыдущийПериод
				|				ПО (ПредыдущийПериод.Период < ТекущийПериод.Период)
				|		
				|		СГРУППИРОВАТЬ ПО
				|			ТекущийПериод.Период) КАК Периоды
				|		ПО Показатели.Период = Периоды.Период
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДозаполненныеПоказатели КАК ПредыдущиеПоказатели
				|		ПО (ПредыдущиеПоказатели.Период = Периоды.ПредыдущийПериод)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	(ВЫРАЗИТЬ(СУММА((_Доходности.ДоходностьАктива - ИтогиПоДоходностиАктива.СредняяДоходность) * (_Доходности.ДоходностьИндикатора - ИтогиПоДоходностиИндикатора.СредняяДоходность)) КАК ЧИСЛО(27, 10))) / (МАКСИМУМ(ИтогиПоДоходностиАктива.ВсегоЗначений) - 1) КАК КовариацияДоходностей,
				|	(ВЫРАЗИТЬ(СУММА((_Доходности.ДоходностьИндикатора - ИтогиПоДоходностиИндикатора.СредняяДоходность) * (_Доходности.ДоходностьИндикатора - ИтогиПоДоходностиИндикатора.СредняяДоходность)) КАК ЧИСЛО(27, 10))) / (МАКСИМУМ(ИтогиПоДоходностиИндикатора.ВсегоЗначений) - 1) КАК ДисперсияДоходностиИндикатора
				|ПОМЕСТИТЬ _ПараметрыКоэффициентаБета
				|ИЗ
				|	_Доходности КАК _Доходности,
				|	(ВЫБРАТЬ
				|		СРЕДНЕЕ(_Доходности.ДоходностьИндикатора) КАК СредняяДоходность,
				|		КОЛИЧЕСТВО(*) КАК ВсегоЗначений
				|	ИЗ
				|		_Доходности КАК _Доходности) КАК ИтогиПоДоходностиИндикатора,
				|	(ВЫБРАТЬ
				|		СРЕДНЕЕ(_Доходности.ДоходностьАктива) КАК СредняяДоходность,
				|		КОЛИЧЕСТВО(*) КАК ВсегоЗначений
				|	ИЗ
				|		_Доходности КАК _Доходности) КАК ИтогиПоДоходностиАктива");			
			
			ЗапросДанныхПоИндикатору.Текст = СтрЗаменить(ЗапросДанныхПоИндикатору.Текст,
				"_ПараметрыКоэффициентаБета.Бета",
				"_ПараметрыКоэффициентаБета.КовариацияДоходностей / _ПараметрыКоэффициентаБета.ДисперсияДоходностиИндикатора");

		КонецЕсли;
	
	#КонецОбласти
	
	ЗапросДанныхПоИндикатору.УстановитьПараметр("КодИндикатора",				"IMOEX");
	ЗапросДанныхПоИндикатору.УстановитьПараметр("ДатаПереоценки",				ДатаПереоценки);
	ЗапросДанныхПоИндикатору.УстановитьПараметр("ДатаИсторическойЦены",			ПараметрыИсторическойЦены.ДатаПоследнейЦены);
	ЗапросДанныхПоИндикатору.УстановитьПараметр("ПредшествующийТорговыйДень",	ПредшествующийТорговыйДень);
	ЗапросДанныхПоИндикатору.УстановитьПараметр("ТорговыхДнейНазад45",			ТорговыхДнейНазад45);
	ЗапросДанныхПоИндикатору.УстановитьПараметр("КалендарьКотировок",			ОсновнойКалендарьКотировок);
	ЗапросДанныхПоИндикатору.УстановитьПараметр("ММВБ",							ММВБ);
	ЗапросДанныхПоИндикатору.УстановитьПараметр("ЦеннаяБумага",					СтрокаСтоимостейЦБ.ЦеннаяБумага);
	ЗапросДанныхПоИндикатору.УстановитьПараметр("Рынок",						СтрокаСтоимостейЦБ.Рынок);
	ЗапросДанныхПоИндикатору.УстановитьПараметр("ВалютаНоминала",				СтрокаСтоимостейЦБ.ВалютаНоминала);
	
	ДанныеПоИндикатору = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, ЗапросДанныхПоИндикатору, , "Расчет по значениям рыночного индикатора", "Выборка");
	
	Если Не ДанныеПоИндикатору.Следующий() ИЛИ ДанныеПоИндикатору.ДоходностьИндикатора = NULL Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	// Расчет БСД
	
	ОшибкаРасчета = Ложь;
	
	ТочностьБета = ?(ПараметрыОценки.Свойство("ПараметрыМоделиCAPM") И ПараметрыОценки.ПараметрыМоделиCAPM.Свойство("ТочностьБета"), ПараметрыОценки.ПараметрыМоделиCAPM.ТочностьБета, 5); 
	Бета		 = Окр(ДанныеПоИндикатору.Бета, ТочностьБета);
	
	Если Бета = 1 Тогда
		
		// Если Бета = 1, то БСД считать не нужно
		
		БСД				= 0;
		БСД_Приведенная = 0;
		
	Иначе
		
		// БСД как значение КБД на интервале в 1 год с точностью до 2 знаков после запятой (в процентном выражении)
		
		БСД = Окр(РаботаСПоказателямиФинансовыхИнструментов.РассчитатьЗначениеКривойБескупоннойДоходности(ДатаПереоценки, 1, , ОшибкаРасчета), 2);
		
		Если ОшибкаРасчета Тогда
			Отказ = Истина;
			
			Если РасшифровкаРасчета <> Неопределено Тогда	
				ПараметрыРасчетаЦен = Новый Структура("БезрисковаяСтавкаДоходности", "Ошибка расчета");
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Параметры расчета цены", ПараметрыРасчетаЦен);
			КонецЕсли;
			
			Возврат Неопределено;
		КонецЕсли;					
			
		БСД_Приведенная = (БСД / 365) * ((ДатаПереоценки - ПараметрыИсторическойЦены.ДатаПоследнейЦены) / 86400);						
		
	КонецЕсли;	
	
	ДоходностьРыночногоИндикатора	= ДанныеПоИндикатору.ДоходностьИндикатора;
	ОжидаемаяДоходность				= БСД_Приведенная / 100 + Бета * (ДоходностьРыночногоИндикатора - БСД_Приведенная / 100);
	РасчетнаяСтоимость				= ПараметрыИсторическойЦены.Стоимость * (1 + ОжидаемаяДоходность);
	Цена							= ?(ТочностьЦены = Неопределено, РасчетнаяСтоимость, Окр(РасчетнаяСтоимость, ТочностьЦены));
	
	// Формируем результат расчета
	
	РезультатыРасчета = Новый Структура;
	РезультатыРасчета.Вставить("ПоследняяНаблюдаемаяЦена",		ПоследняяНаблюдаемаяЦена.Стоимость);
	РезультатыРасчета.Вставить("ДатаПоследнейНаблюдаемойЦены",	ПоследняяНаблюдаемаяЦена.ДатаПоследнейЦены);
	РезультатыРасчета.Вставить("ОписаниеИсторическойЦены",		?(РасчетОтПоследнейОпределеннойЦеныПервогоИлиВторогоУровня, "Последняя зарегистрированная цена 1 или 2 уровня", "Последняя наблюдаемая цена"));	
	РезультатыРасчета.Вставить("ИсторическаяЦена",				ПараметрыИсторическойЦены.Стоимость);
	РезультатыРасчета.Вставить("ДатаИсторическойЦены",			ПараметрыИсторическойЦены.ДатаПоследнейЦены);
	РезультатыРасчета.Вставить("ОжидаемаяДоходность",			ОжидаемаяДоходность);
	РезультатыРасчета.Вставить("БСД",							БСД);
	РезультатыРасчета.Вставить("БСД_Приведенная",				БСД_Приведенная);
	РезультатыРасчета.Вставить("Бета",							Бета);
	РезультатыРасчета.Вставить("ДоходностьРыночногоИндикатора",	ДоходностьРыночногоИндикатора);
	РезультатыРасчета.Вставить("РасчетнаяСтоимость",			РасчетнаяСтоимость);
	РезультатыРасчета.Вставить("ТочностьЦены",					ТочностьЦены);
	РезультатыРасчета.Вставить("Цена",							Цена);
		
	Если РасшифровкаРасчета <> Неопределено Тогда	
		ПараметрыРасчетаЦен = РаботаСКоллекциями.СкопироватьСтруктуру(РезультатыРасчета);
		
		ПараметрыРасчетаЦен.БСД_Приведенная					= Окр(ПараметрыРасчетаЦен.БСД_Приведенная, 10);
		ПараметрыРасчетаЦен.ДоходностьРыночногоИндикатора	= Окр(ПараметрыРасчетаЦен.ДоходностьРыночногоИндикатора, 10);
		ПараметрыРасчетаЦен.РасчетнаяСтоимость				= Окр(ПараметрыРасчетаЦен.РасчетнаяСтоимость, 10);
		ПараметрыРасчетаЦен.Цена							= ?(ТочностьЦены = Неопределено, Окр(ПараметрыРасчетаЦен.Цена, 10), ПараметрыРасчетаЦен.Цена);

		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "РасчетПоCAPM", ПараметрыРасчетаЦен, "Расчет по модели оценки, основанной на корректировке исторической цены (CAPM)", , Истина);
	КонецЕсли;		
		
	Возврат РезультатыРасчета;	
	
КонецФункции

// Возвращает цену предыдущего рабочего/торгового дня, если не произошло существенных событий
//
// Параметры:
//	ЦеннаяБумага					- ОпределяемыеТипы.ЦенныеБумаги -   
//	ПараметрыОценки					- Структура - см. РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС 
//	ДатаПереоценки					- Дата - 
//	ПараметрыПоискаЦены				- Структура, Неопределено - параметры поиска цены.
//						  				Ключи структуры:
//											Календарь - календарь, по которому берется цена предыдущего дня
//											УровеньОценки - уровень оценки, который должен быть у найденной цены
//	КоэффициентыСущественныхСобытий	- Структура - коэффициенты, применяемые к цене при наступлении существенных событий. Ключи структуры соответствуют событиям, значения - коэффициентам.
//										Ключи структуры:
//											ИзмененаКлючеваяСтавкаЦБРФ - изменена ключевая ставка ЦБ РФ
//											ИзмененаКлючеваяСтавкаФРССША - изменена ключевая ставка ФРС США
//											ИзмененаКлючеваяСтавкаЦБРФ_ЕвропейскогоЦБ_ФРССША - изменена ключевая ставка ЦБ РФ (для российских торговых площадок), Европейского центрального банка (для европейских торговых площадок), ФРС США (для прочих)
//											ВведеныСанкцииПротивЭмитента - введены санкции против эмитента
//											ЗначительныеТехногенныеКатастрофы - значительные техногенные катастрофы
//											ИзмененКредитныйРейтингЭмитента - изменен кредитный рейтинг эмитента
//											ДефолтПоБумагамЭмитента - дефолт по бумагам эмитента
//	Отказ							- Булево -
//	РасшифровкаРасчета 				- Структура, Неопределено - 
//
// Возвращаемое значение:
//	ЦенаПредыдущегоДня				- Структура - содержит поля как в РаботаСПереоценкой.ПолучитьПоследнююНаблюдаемуюЦену,
//								 	  Неопределено - если цена не найдена или существенные события привели ее к нулю
//
Функция ПолучитьПоследнююНаблюдаемуюЦенуСУчетомСущественныхСобытий(ЦеннаяБумага, ПараметрыОценки, ДатаПереоценки, ПараметрыПоискаЦены = Неопределено, КоэффициентыСущественныхСобытий, Отказ = Ложь, РасшифровкаРасчета = Неопределено)

	Если РасшифровкаРасчета <> Неопределено Тогда
		РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расчет по модели оценки, основанной на изменениях существенных событий", , , Истина);
	КонецЕсли;
	
	#Область Проверка_параметров_функции_и_заполнение_параметров_по_умолчанию
	
	Если КоэффициентыСущественныхСобытий = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заданы критерии существенных событий", , , , Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПараметрыПоискаЦены = Неопределено Тогда
		ПараметрыПоискаЦены = Новый Структура;
	КонецЕсли;
	
	Если Не ПараметрыПоискаЦены.Свойство("Календарь") Тогда
		ПараметрыПоискаЦены.Вставить("Календарь", Справочники.Календари.Общероссийский);	
	КонецЕсли;
	
	#КонецОбласти
	
	// Определяем цену последнего рабочего дня
	
	ЦенаПредыдущегоДня = ПолучитьПоследнююНаблюдаемуюЦену(ПараметрыОценки, ДатаПереоценки, ЦеннаяБумага, 1, ПараметрыПоискаЦены.Календарь, Отказ);
	
	Если ЦенаПредыдущегоДня = Неопределено Тогда
		
		Если РасшифровкаРасчета <> Неопределено Тогда	
			РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаОперации, "РезультатПоиска",
				Новый Структура("ЦенаПредыдущегоДня", "Наблюдаемая цена не определена"),
				"Поиск цены предыдущего " + ?(ПараметрыПоискаЦены.Календарь = Неопределено, "календарного", ?(ПараметрыПоискаЦены.Календарь = Справочники.Календари.Общероссийский, "рабочего", "торгового")) + " дня");
		КонецЕсли;
		
		Возврат Неопределено;
		
	ИначеЕсли РасшифровкаРасчета <> Неопределено Тогда
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаОперации, "РезультатПоиска",
			ЦенаПредыдущегоДня,
			"Цена предыдущего " + ?(ПараметрыПоискаЦены.Календарь = Неопределено, "календарного", ?(ПараметрыПоискаЦены.Календарь = Справочники.Календари.Общероссийский, "рабочего", "торгового")) + " дня");
		
	КонецЕсли;
	
	// Проверям, можем ли мы брать эту цену по условиям методики
	
	Если ПараметрыПоискаЦены.Свойство("УровеньОценки") Тогда
		Если ЦенаПредыдущегоДня.УровеньОценки <> ПараметрыПоискаЦены.УровеньОценки Тогда
			Если РасшифровкаРасчета <> Неопределено Тогда	
				РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаОперации, "РезультатПроверки",
					Новый Структура("ЦенаПредыдущегоДня", СтрШаблон("Уровень цены предыдущего рабочего дня не равен %1", ПараметрыПоискаЦены.УровеньОценки)),
					"Проверка цены предыдущего рабочего дня");
			КонецЕсли;
			
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	// Получаем коэффициенты	
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДатаПереоценки",			ДатаПереоценки);
	Запрос.УстановитьПараметр("ПредыдущийРабочийДень",	ЦенаПредыдущегоДня.ДатаПоследнейЦены);
	Запрос.УстановитьПараметр("ЦеннаяБумага",			ЦеннаяБумага);
	
	#Область Помещаем_в_ВТ_сведения_об_эмитенте_бумаги
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Эмитенты.Ссылка КАК Эмитент,
		|	Эмитенты.ЮрФизЛицо КАК ЮрЛицоЭмитента
		|ПОМЕСТИТЬ _Эмитент
		|ИЗ
		|	Справочник.Акции КАК ЦеннаяБумага
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|		ПО ЦеннаяБумага.Эмитент = Эмитенты.Ссылка
		|			И (ЦеннаяБумага.Ссылка = &ЦеннаяБумага)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Эмитенты.Ссылка,
		|	Эмитенты.ЮрФизЛицо
		|ИЗ
		|	Справочник.Облигации КАК ЦеннаяБумага
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|		ПО ЦеннаяБумага.Эмитент = Эмитенты.Ссылка
		|			И (ЦеннаяБумага.Ссылка = &ЦеннаяБумага)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Эмитенты.Ссылка,
		|	Эмитенты.ЮрФизЛицо
		|ИЗ
		|	Справочник.ДепозитарныеРасписки КАК ЦеннаяБумага
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|		ПО ЦеннаяБумага.Эмитент = Эмитенты.Ссылка
		|			И (ЦеннаяБумага.Ссылка = &ЦеннаяБумага)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	УправляющиеКомпании.Ссылка,
		|	УправляющиеКомпании.ЮрФизЛицо
		|ИЗ
		|	Справочник.УправляющиеКомпании КАК УправляющиеКомпании
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(
		|				&ДатаПереоценки,
		|				ПаевойИнвестиционныйФонд В
		|					(ВЫБРАТЬ
		|						Паи.ПаевойИнвестиционныйФонд
		|					ИЗ
		|						Справочник.Паи КАК Паи
		|					ГДЕ
		|						Паи.Ссылка = &ЦеннаяБумага)) КАК РеквизитыПИФ
		|		ПО (РеквизитыПИФ.УправляющаяКомпания = УправляющиеКомпании.Ссылка)";
	
	Запрос.Выполнить();
	
	#КонецОбласти
	
	Для Каждого Коэффициент Из КоэффициентыСущественныхСобытий Цикл
		
		Если ЦенаПредыдущегоДня.Стоимость = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ЗначениеКоэффициента = Неопределено;
		
		Если Коэффициент.Ключ = "ИзмененаКлючеваяСтавкаЦБРФ"
			ИЛИ Коэффициент.Ключ = "ИзмененаКлючеваяСтавкаФРССША"
			ИЛИ Коэффициент.Ключ = "ИзмененаКлючеваяСтавкаЦБРФ_ЕвропейскогоЦБ_ФРССША"
		Тогда
			
			#Область Проверка_изменения_ключевой_ставки	
			
			Если Коэффициент.Ключ = "ИзмененаКлючеваяСтавкаЦБРФ"
				ИЛИ Коэффициент.Ключ = "ИзмененаКлючеваяСтавкаЦБРФ_ЕвропейскогоЦБ_ФРССША"
					И (ЦенаПредыдущегоДня.Источник = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ").ЮрФизЛицо
						ИЛИ ЦенаПредыдущегоДня.Источник = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_SPBEX").ЮрФизЛицо
						ИЛИ ЦенаПредыдущегоДня.Источник = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_СПВБ").ЮрФизЛицо
						ИЛИ ЦенаПредыдущегоДня.Источник = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_СПб").ЮрФизЛицо)
			Тогда
			
				ИзмениласьКлючеваяСтавка = РегистрыСведений.ПроцентныеПоказатели.ПоказательИзменилсяЗаПериод(
					Перечисления.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ, ЦенаПредыдущегоДня.ДатаПоследнейЦены, ДатаПереоценки,,, РасшифровкаОперации);

				Если ИзмениласьКлючеваяСтавка <> Неопределено Тогда
					ЗначениеКоэффициента = ?(ИзмениласьКлючеваяСтавка, 0, Коэффициент.Значение);			
				КонецЕсли;
					
			КонецЕсли;	

			#КонецОбласти	
			
		ИначеЕсли Коэффициент.Ключ = "ВведеныСанкцииПротивЭмитента" Тогда
			
		ИначеЕсли Коэффициент.Ключ = "ЗначительныеТехногенныеКатастрофы" Тогда
			
		ИначеЕсли Коэффициент.Ключ = "ИзмененКредитныйРейтингЭмитента" Тогда
			
			#Область Проверка_изменения_кредитного_рейтинга_эмитента	
	
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЕСТЬNULL(РейтингиЭмитентаНаДатуПереоценки.РейтинговоеАгентство, РейтингиЭмитентаНаПредыдущийРабочийДень.РейтинговоеАгентство) КАК РейтинговоеАгентство,
				|	ЕСТЬNULL(РейтингиЭмитентаНаДатуПереоценки.Шкала, РейтингиЭмитентаНаПредыдущийРабочийДень.Шкала) КАК Шкала,
				|	РейтингиЭмитентаНаДатуПереоценки.Рейтинг КАК РейтингНаДатуПереоценки,
				|	РейтингиЭмитентаНаДатуПереоценки.ЗначениеРейтинга КАК ЗначениеРейтингаНаДатуПереоценки,
				|	РейтингиЭмитентаНаПредыдущийРабочийДень.Рейтинг КАК РейтингНаПредыдущийРабочийДень,
				|	РейтингиЭмитентаНаПредыдущийРабочийДень.ЗначениеРейтинга КАК ЗначениеРейтингаНаПредыдущийРабочийДень
				|ПОМЕСТИТЬ _ИзмененияРейтинга
				|ИЗ
				|	РегистрСведений.Рейтинги.СрезПоследних(
				|			&ДатаПереоценки,
				|			Субъект В
				|					(ВЫБРАТЬ
				|						_Эмитент.ЮрЛицоЭмитента
				|					ИЗ
				|						_Эмитент КАК _Эмитент)
				|				И Агрегатор = &РуДата
				|				И Шкала.ВидРейтинга = ЗНАЧЕНИЕ(Перечисление.ВидыРейтингов.Кредитный)
				|				И (Шкала.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1)
				|					ИЛИ Шкала.ДатаПереходаВАрхив > &ДатаПереоценки)) КАК РейтингиЭмитентаНаДатуПереоценки
				|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.Рейтинги.СрезПоследних(
				|				&ПредыдущийРабочийДень,
				|				Субъект В
				|						(ВЫБРАТЬ
				|							_Эмитент.ЮрЛицоЭмитента
				|						ИЗ
				|							_Эмитент КАК _Эмитент)
				|					И Агрегатор = &РуДата
				|					И Шкала.ВидРейтинга = ЗНАЧЕНИЕ(Перечисление.ВидыРейтингов.Кредитный)
				|					И (Шкала.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1)
				|						ИЛИ Шкала.ДатаПереходаВАрхив > &ПредыдущийРабочийДень)) КАК РейтингиЭмитентаНаПредыдущийРабочийДень
				|		ПО (РейтингиЭмитентаНаПредыдущийРабочийДень.РейтинговоеАгентство = РейтингиЭмитентаНаДатуПереоценки.РейтинговоеАгентство)
				|			И (РейтингиЭмитентаНаПредыдущийРабочийДень.Шкала = РейтингиЭмитентаНаДатуПереоценки.Шкала)
				|ГДЕ
				|	(РейтингиЭмитентаНаДатуПереоценки.Рейтинг <> РейтингиЭмитентаНаПредыдущийРабочийДень.Рейтинг
				|			ИЛИ РейтингиЭмитентаНаДатуПереоценки.ЗначениеРейтинга <> РейтингиЭмитентаНаПредыдущийРабочийДень.ЗначениеРейтинга)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	КОЛИЧЕСТВО(*) > 0 КАК ИзменилсяКредитныйРейтинг
				|ИЗ
				|	_ИзмененияРейтинга КАК _ИзмененияРейтинга";

			Запрос.УстановитьПараметр("РуДата", Справочники.ВнешниеСистемы.РуДата);
			
			Если РасшифровкаРасчета = Неопределено Тогда
				СущественноеСобытие = Запрос.Выполнить().Выбрать();
			Иначе
				СущественноеСобытие = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаОперации, Запрос, "Проверка изменения кредитного рейтинга эмитента", "Результат проверки", "Выборка", "_ИзмененияРейтинга", , Истина);		
			КонецЕсли;
			
			Если СущественноеСобытие.Следующий() Тогда
				ЗначениеКоэффициента = ?(СущественноеСобытие.ИзменилсяКредитныйРейтинг, 0, Коэффициент.Значение);	
			КонецЕсли;
	
			#КонецОбласти	
			
		ИначеЕсли Коэффициент.Ключ = "ДефолтПоБумагамЭмитента" Тогда
			
			#Область Проверка_дефолта_по_бумагам_эмитента	
	
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	ДефолтыПоОблигациям.Облигация КАК ЦеннаяБумага
				|ПОМЕСТИТЬ _ДефолтныеБумаги
				|ИЗ
				|	РегистрСведений.ДефолтыПоОблигациям.СрезПоследних(
				|			&ДатаПереоценки,
				|			Облигация В
				|				(ВЫБРАТЬ
				|					Облигации.Ссылка
				|				ИЗ
				|					Справочник.Облигации КАК Облигации
				|						ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Эмитент
				|						ПО
				|							_Эмитент.Эмитент = Облигации.Эмитент)) КАК ДефолтыПоОблигациям
				|ГДЕ
				|	ДефолтыПоОблигациям.СтатусДефолта В (ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт), ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.ТехническийДефолт))
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	КОЛИЧЕСТВО(*) > 0 КАК ЕстьДефолтныеБумаги
				|ИЗ
				|	_ДефолтныеБумаги КАК _ДефолтныеБумаги";

			Запрос.УстановитьПараметр("РуДата", Справочники.ВнешниеСистемы.РуДата);
			
			Если РасшифровкаРасчета = Неопределено Тогда
				СущественноеСобытие = Запрос.Выполнить().Выбрать();
			Иначе
				СущественноеСобытие = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаОперации, Запрос, "Проверка дефолта по бумагам эмитента", "Результат проверки", "Выборка", "_ДефолтныеБумаги", , Истина);		
			КонецЕсли;
			
			Если СущественноеСобытие.Следующий() Тогда
				ЗначениеКоэффициента = ?(СущественноеСобытие.ЕстьДефолтныеБумаги, 0, Коэффициент.Значение);	
			КонецЕсли;
	
			#КонецОбласти

		Иначе
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Неизвестный критерий существенных событий '%2'", Коэффициент.Ключ), , , , Отказ);
			Возврат Неопределено;
			
		КонецЕсли;
		
		// По умолчанию считаем, что события не произошли
		
		Если ЗначениеКоэффициента = Неопределено Тогда
			
			ЗначениеКоэффициента = Коэффициент.Значение;	
			
			Если РасшифровкаРасчета <> Неопределено Тогда	
				РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаОперации, "РезультатПроверкиКритерия",
					Новый Структура("Результат", "Проверка не выполнялась"),
					СтрШаблон("Проверка критерия существенных событий '%1'", Коэффициент.Ключ));
			КонецЕсли;

		КонецЕсли;
		
		ЦенаПредыдущегоДня.Стоимость = ЦенаПредыдущегоДня.Стоимость * ЗначениеКоэффициента;
		
	КонецЦикла;	
	
	Возврат ?(ЦенаПредыдущегоДня.Стоимость = 0, Неопределено, ЦенаПредыдущегоДня); 
	
КонецФункции

// Рассчитать цену по дисконтированной стоимости будущих денежных потоков по безрисковой ставке доходности
//
// Параметры:
//	ЦеннаяБумага						- СправочникСсылка.Облигации -  
//	ПараметрыОценки						- Структура - см. РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС 
//	ДатаПереоценки						- Дата - 
//	ДанныеОДенежномПотоке				- ТаблицаЗначений - будущие денежные потоки
//										- Структура - параметры получения денежного потока
//	РассчитыватьНоминальнуюСтавку		- Булево - если ЛОЖЬ, то для бумаг с индексируемым номиналом ставка будет браться из YIELDCLOSE регистра котировок, иначе ставка будет рассчитана 
//	ДанныеОКредитномСпреде				- ТаблицаЗначений - кредитный спред
//										- Структура - ключи структуры соответствуют параметрам функции РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред
//										- Неопределено - расчет спреда не выполняется, медиана равна 0   
//	ПараметрыРасчетаРейтинга			- Структура - ключи структуры соответствуют параметрам функции РаботаСПоказателямиФинансовыхИнструментов.ПоместитьРейтинговыеГруппыСубъектовВМенеджерВременныхТаблиц,
//										- Неопределено - расчет спреда не выполняется
//	ТочностьЦены						- Число - округление до указанного числа знаков после запятой,
//										- Неопределено - цена не округляется
//	Отказ								- Булево - 
//	РасшифровкаРасчета					- Структура, Неопределено - 
//
// Возвращаемое значение:
//	Цена - Число, Неопределено - Неопределено, если не удалось рассчитать цену
//
Функция РассчитатьЦенуПоДисконтированнойПоБезрисковойСтавкеДоходностиСтоимости(ЦеннаяБумага, ПараметрыОценки, ДатаПереоценки, ДанныеОДенежномПотоке, РассчитыватьНоминальнуюСтавку = Ложь, Купон = Неопределено, ДанныеОКредитномСпреде = Неопределено, ПараметрыРасчетаРейтинга = Неопределено, ТочностьЦены = Неопределено, Отказ = Ложь, РасшифровкаРасчета = Неопределено)
	
	ОшибкаРасчета = Ложь;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расчет цены по стоимости, дисконтированной по безрисковой ставке доходности", , , Истина);
	КонецЕсли;
	
	// Расчет медианы кредитного спреда	
	
	Если ДанныеОКредитномСпреде = Неопределено Тогда
		
		МедианаКредитногоСпреда = 0;		
		
	Иначе
		
		Если ТипЗнч(ДанныеОКредитномСпреде) = Тип("ТаблицаЗначений") Тогда
			КредитныйСпред = ДанныеОКредитномСпреде;
		Иначе
			КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(
				ЦеннаяБумага, ДатаПереоценки, ПараметрыРасчетаРейтинга, ДанныеОКредитномСпреде, ОшибкаРасчета, РасшифровкаОперации);
		КонецЕсли;		
				
		Если Не ОшибкаРасчета И ТипЗнч(КредитныйСпред) = Тип("ТаблицаЗначений") И КредитныйСпред.Количество() > 0 Тогда
			МедианаКредитногоСпреда	= КредитныйСпред[0].Медиана / 100;
		Иначе
			Возврат Неопределено;
		КонецЕсли;		
		
	КонецЕсли;
	
	// Получаем денежный поток
	
	Если ТипЗнч(ДанныеОДенежномПотоке) = Тип("ТаблицаЗначений") Тогда
		ДенежныйПоток = ДанныеОДенежномПотоке;
	Иначе
		ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ДанныеОДенежномПотоке, ПараметрыОценки, ОшибкаРасчета, РасшифровкаОперации);
	КонецЕсли;	
		
	Если ОшибкаРасчета Тогда
		Отказ = Истина;
		Возврат Неопределено;
	КонецЕсли;	
	
	// Расчет безрисковой ставки доходности
	
	ТочностьСрокаДоПогашения	= ?(ПараметрыОценки.Свойство("ТочностьСрокаДоПогашения"), ПараметрыОценки.ТочностьСрокаДоПогашения, 4);
	ТочностьСтавкиБСД			= ?(ПараметрыОценки.Свойство("ТочностьСтавкиДисконтирования"), Неопределено, 2); // ставку БСД не округляем, т.к. полученная от нее ставка диск-я будет округлена далее при расчете цены
	
	Если РассчитыватьНоминальнуюСтавку Тогда
		БезрисковаяСтавкаДоходности = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьНоминальнуюБезрисковуюСтавкуДоходности(ЦеннаяБумага, ДатаПереоценки, ДенежныйПоток, ОшибкаРасчета, ТочностьСрокаДоПогашения, ТочностьСтавкиБСД, РасшифровкаОперации);
	Иначе
		БезрисковаяСтавкаДоходности = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьБезрисковуюСтавкуДоходности(ЦеннаяБумага, ДатаПереоценки, ДенежныйПоток, ОшибкаРасчета, РасшифровкаОперации);
	КонецЕсли;
		
	Если ОшибкаРасчета Тогда
		Отказ = Истина;
		Возврат Неопределено;
	КонецЕсли;
	
	// Расчет дисконтированной стоимости
	
	СтавкаДисконтирования = БезрисковаяСтавкаДоходности + МедианаКредитногоСпреда;
	
	Если ПараметрыОценки.Свойство("ТочностьСтавкиДисконтирования") Тогда
		СтавкаДисконтированияДоОкругления	= СтавкаДисконтирования;
		СтавкаДисконтирования				= Окр(СтавкаДисконтирования, ПараметрыОценки.ТочностьСтавкиДисконтирования);
	КонецЕсли; 
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		
		ПараметрыРасчетаЦен = Новый Структура;
		ПараметрыРасчетаЦен.Вставить("БезрисковаяСтавкаДоходности",				БезрисковаяСтавкаДоходности);
		ПараметрыРасчетаЦен.Вставить("МедианаКредитногоСпреда",					МедианаКредитногоСпреда);
		
		Если ПараметрыОценки.Свойство("ТочностьСтавкиДисконтирования") Тогда
			ПараметрыРасчетаЦен.Вставить("СтавкаДисконтированияДоОкругления",	СтавкаДисконтированияДоОкругления);
			ПараметрыРасчетаЦен.Вставить("ТочностьСтавкиДисконтирования",		ПараметрыОценки.ТочностьСтавкиДисконтирования);
		КонецЕсли;
		
		ПараметрыРасчетаЦен.Вставить("СтавкаДисконтирования",					СтавкаДисконтирования);
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаОперации, "РасчетСтавкиДисконтирования", ПараметрыРасчетаЦен, "Расчет ставки дисконтирования");
			
	КонецЕсли;	
	
	Возврат РассчитатьЦенуПоДисконтированнойСтоимости(ЦеннаяБумага, ПараметрыОценки, ДатаПереоценки, ДенежныйПоток, СтавкаДисконтирования, Купон, ТочностьЦены, Отказ, РасшифровкаОперации);
	
КонецФункции

Функция РассчитатьЦенуПоДисконтированнойСтоимости(ЦеннаяБумага, ПараметрыОценки, ДатаПереоценки, ДанныеОДенежномПотоке, СтавкаДисконтирования, Купон = Неопределено, ТочностьЦены = Неопределено, Отказ = Ложь, РасшифровкаРасчета = Неопределено)
	
	ОшибкаРасчета = Ложь;
	
	// Получаем денежный поток
	
	Если ТипЗнч(ДанныеОДенежномПотоке) = Тип("ТаблицаЗначений") Тогда
		ДенежныйПоток = ДанныеОДенежномПотоке;
	Иначе
		ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ДанныеОДенежномПотоке, ПараметрыОценки, ОшибкаРасчета, РасшифровкаРасчета);
	КонецЕсли;	
		
	Если ОшибкаРасчета Тогда
		Отказ = Истина;
		Возврат Неопределено;
	КонецЕсли;	
	
	ДисконтированнаяСтоимость = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтавкаДисконтирования, ДатаПереоценки, ПараметрыОценки, Отказ, РасшифровкаРасчета);
	
	Если ПараметрыОценки.Свойство("ТочностьDCF") Тогда
		ДисконтированнаяСтоимостьДоОкругления	= ДисконтированнаяСтоимость;
		ДисконтированнаяСтоимость				= Окр(ДисконтированнаяСтоимость, ПараметрыОценки.ТочностьDCF);
	КонецЕсли; 
	
	// Расчет купона	
	
	Если Купон = Неопределено Тогда
		Купон = Справочники.Облигации.ПолучитьКупон(ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
	КонецЕсли;
	
	// Расчет и заполнение цены
	
	Цена = ДисконтированнаяСтоимость - Купон;
	
	Если ТочностьЦены <> Неопределено Тогда
		Цена = Окр(Цена, ТочностьЦены);
	КонецЕсли;

	Если РасшифровкаРасчета <> Неопределено Тогда
		
		ПараметрыРасчетаЦен = Новый Структура;
		ПараметрыРасчетаЦен.Вставить("СтавкаДисконтирования",						СтавкаДисконтирования);
		Если ПараметрыОценки.Свойство("ТочностьДисконтированногоПотока") Тогда
			ПараметрыРасчетаЦен.Вставить("ТочностьДисконтированногоПотока",			ПараметрыОценки.ТочностьДисконтированногоПотока);
		КонецЕсли;
		Если ПараметрыОценки.Свойство("ТочностьDCF") Тогда
			ПараметрыРасчетаЦен.Вставить("ДисконтированнаяСтоимостьДоОкругления",	ДисконтированнаяСтоимостьДоОкругления);
		КонецЕсли;
		ПараметрыРасчетаЦен.Вставить("ДисконтированнаяСтоимость",					ДисконтированнаяСтоимость);
		ПараметрыРасчетаЦен.Вставить("Купон",										Купон);
		ПараметрыРасчетаЦен.Вставить("Цена",										Цена);
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "РассчитатьЦенуПоДисконтированнойСтоимости",
			ПараметрыРасчетаЦен, "Цена, рассчитанная по модели дисконтирования стоимости будущих денежных потоков");
			
	КонецЕсли;		
	
	Возврат Цена;	
	
КонецФункции	
	
#КонецОбласти

#Область Получение_цен_по_методике

Функция ПолучитьЦеныСбербанка(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Количество КАК Количество,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДОБАВИТЬКДАТЕ(&ПоследняяДатаТоргов, ДЕНЬ, -6) КАК НачалоНедели,
		|	&ПоследняяДатаТоргов КАК КонецНедели,
		|	&Акции КАК Рынок
		|ПОМЕСТИТЬ ДатыКоличестваСделок
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДОБАВИТЬКДАТЕ(&ПоследняяДатаТоргов, ДЕНЬ, -13),
		|	ДОБАВИТЬКДАТЕ(&ПоследняяДатаТоргов, ДЕНЬ, -7),
		|	&Акции
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДОБАВИТЬКДАТЕ(&ПоследняяДатаТоргов, ДЕНЬ, -20),
		|	ДОБАВИТЬКДАТЕ(&ПоследняяДатаТоргов, ДЕНЬ, -14),
		|	&Акции
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДОБАВИТЬКДАТЕ(&ПоследняяДатаТоргов, ДЕНЬ, -27),
		|	ДОБАВИТЬКДАТЕ(&ПоследняяДатаТоргов, ДЕНЬ, -21),
		|	&Акции
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДОБАВИТЬКДАТЕ(&ПоследняяДатаТоргов, ДЕНЬ, -6),
		|	&ПоследняяДатаТоргов,
		|	&Паи
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДОБАВИТЬКДАТЕ(&ПоследняяДатаТоргов, ДЕНЬ, -13),
		|	ДОБАВИТЬКДАТЕ(&ПоследняяДатаТоргов, ДЕНЬ, -7),
		|	&Паи
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДОБАВИТЬКДАТЕ(&ПоследняяДатаТоргов, ДЕНЬ, -20),
		|	ДОБАВИТЬКДАТЕ(&ПоследняяДатаТоргов, ДЕНЬ, -14),
		|	&Паи
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДОБАВИТЬКДАТЕ(&ПоследняяДатаТоргов, ДЕНЬ, -27),
		|	ДОБАВИТЬКДАТЕ(&ПоследняяДатаТоргов, ДЕНЬ, -21),
		|	&Паи
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДОБАВИТЬКДАТЕ(&ПоследняяДатаТоргов, МЕСЯЦ, -6),
		|	&ПоследняяДатаТоргов,
		|	&Облигации
