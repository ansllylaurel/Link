			КонецЕсли;

			КотировкиАналоговТекущейЦБ = ПараметрыРасчетаСтоимостиПоАналогам.КотировкиАналоговНРД.Скопировать(Новый Структура("ЦеннаяБумага", СтрокаЦенныеБумаги.ЦеннаяБумага));
			Если КотировкиАналоговТекущейЦБ.Количество() = 0 Тогда
				Если РасшифровкаОперации <> Неопределено Тогда
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Расчет цены по аналогам", Новый Структура("Аналоги", "Нет аналогов"));
				КонецЕсли;
				Возврат Ложь;
			КонецЕсли;

			// Расчет ставка дисконтирования:
			//					
			//     Σ YTM(i)
			// r = ————————
			//        N
			//					
			// YTM - эффективная доходность от котировки НРД аналогичной облигации
			
			КотировкиАналоговТекущейЦБ.Колонки.Добавить("YTM", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(27, 10)));
			
			Для Каждого КотировкиАналога Из КотировкиАналоговТекущейЦБ Цикл
					
				КотировкиАналога.YTM = Справочники.Облигации.ПолучитьДоходностьИДюрацию(
					КотировкиАналога.Аналог, Ложь, ДатаПереоценки, КотировкиАналога.RATE * КотировкиАналога.Номинал / 100, ПараметрыОценки.СчетДоверительногоУправления, , ДатаПереоценки).Доходность;
				
			КонецЦикла;
			
			Если РасшифровкаОперации <> Неопределено Тогда
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Расчет ставки дисконтирования", КотировкиАналоговТекущейЦБ.Скопировать());
			КонецЕсли;
			
			СтавкаДисконтирования = Окр(КотировкиАналоговТекущейЦБ.Итог("YTM") / КотировкиАналоговТекущейЦБ.Количество(), 6);		
			
			#КонецОбласти

		ИначеЕсли СтрокаЦенныеБумаги.ОсновнойРынок = "Международный внебиржевой рынок" Тогда

			#Область Ставка_дисконтирования_как_среднее_доходностей_к_погашению_рассчитанное_по_аналогам_по_котировкам_BGN

			Если РасшифровкаРасчета <> Неопределено Тогда
				РасшифровкаОперации.Имя = "Расчет цены по стоимости, дисконтированной по ставке равной средней доходностей к погашению, рассчитанной по аналогам по котировкам BGN";
			КонецЕсли;

			Если Не ПараметрыРасчетаСтоимостиПоАналогам.Свойство("КотировкиАналоговБлумберг") Тогда
				
				#Область Котировки_аналогов
				
				СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(
					СтрокаЦенныеБумаги.Владелец(), "_ТаблицаЦБ", Запрос, Истина, "ЦеннаяБумага, Рынок",
					СтрШаблон("ОсновнойРынок = ""%1"" И Стоимость = 0", СтрокаЦенныеБумаги.ОсновнойРынок));
					
				ПоместитьАналогиЦенныхБумагВМенеджерВременныхТаблиц(Запрос, "_ТаблицаЦБ", ДатаПереоценки, ПараметрыОценки.Организация, ПараметрыОценки.Клиент, ОтборАналогов, "_Аналоги");   
				
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
					|	_Аналоги.Аналог КАК Аналог,
					|	_Аналоги.Клиент КАК Клиент,
					|	Котировки_Bloomberg_BGN.CLOSE КАК CLOSE,
					|	""Есть цена BGN (Last Price) на дату оценки"" КАК Условие,
					|	ЕСТЬNULL(Котировки_Bloomberg_BGN.CLOSE > 0, ЛОЖЬ) КАК ПроверкаПройдена
					|ПОМЕСТИТЬ _ЦеныBloomberg
					|ИЗ
					|	_ТаблицаЦБ КАК _ТаблицаЦБ
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Аналоги КАК _Аналоги
					|		ПО (_Аналоги.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК Котировки_Bloomberg_BGN
					|		ПО (Котировки_Bloomberg_BGN.ЦеннаяБумага = _Аналоги.Аналог)
					|			И (Котировки_Bloomberg_BGN.Рынок = _ТаблицаЦБ.Рынок)
					|			И (Котировки_Bloomberg_BGN.Биржа = &Блумберг)
					|			И (Котировки_Bloomberg_BGN.РежимТоргов = &Режим_BGN)
					|			И (Котировки_Bloomberg_BGN.Период = &ПоследняяДатаТорговБлумберг)
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_ЦеныBloomberg.ЦеннаяБумага КАК ЦеннаяБумага,
					|	СУММА(ВЫБОР
					|			КОГДА _ЦеныBloomberg.ПроверкаПройдена
					|				ТОГДА 1
					|		КОНЕЦ) КАК Количество,
					|	""Количество аналогов >= 3"" КАК Условие,
					|	ЕСТЬNULL(СУММА(ВЫБОР
					|				КОГДА _ЦеныBloomberg.ПроверкаПройдена
					|					ТОГДА 1
					|			КОНЕЦ) >= 3, ЛОЖЬ) КАК ПроверкаПройдена
					|ПОМЕСТИТЬ _КоличествоАналогов
					|ИЗ
					|	_ЦеныBloomberg КАК _ЦеныBloomberg
					|
					|СГРУППИРОВАТЬ ПО
					|	_ЦеныBloomberg.ЦеннаяБумага
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_ЦеныBloomberg.ЦеннаяБумага КАК ЦеннаяБумага,
					|	_ЦеныBloomberg.Аналог КАК Аналог,
					|	_ЦеныBloomberg.Клиент КАК Клиент,
					|	_ЦеныBloomberg.CLOSE КАК CLOSE,
					|	НоминалыАналогов.Номинал КАК Номинал
					|ИЗ
					|	_ЦеныBloomberg КАК _ЦеныBloomberg
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КоличествоАналогов КАК _КоличествоАналогов
					|		ПО (_КоличествоАналогов.ЦеннаяБумага = _ЦеныBloomberg.ЦеннаяБумага)
					|			И (_КоличествоАналогов.ПроверкаПройдена)
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
					|				&ДатаПереоценки,
					|				ЦеннаяБумага В
					|					(ВЫБРАТЬ
					|						_ЦеныBloomberg.Аналог
					|					ИЗ
					|						_ЦеныBloomberg)) КАК НоминалыАналогов
					|		ПО (НоминалыАналогов.ЦеннаяБумага = _ЦеныBloomberg.Аналог)
					|ГДЕ
					|	_ЦеныBloomberg.ПроверкаПройдена";
				
				Запрос.УстановитьПараметр("Блумберг",						ПараметрыЗапроса.Блумберг);
				Запрос.УстановитьПараметр("Режим_BGN",						ПараметрыЗапроса.Режим_BGN);
				Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберг",	ПараметрыЗапроса.ПоследняяДатаТорговБлумберг);
				
				Если РасшифровкаОперации = Неопределено Тогда
					КотировкиАналоговБлумберг = Запрос.Выполнить().Выгрузить();
				Иначе
					КотировкиАналоговБлумберг = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаОперации, Запрос, "Получение котировок Блумберг аналогов", "Котировки аналогов", , , , Истина);
				КонецЕсли;
				
				ПараметрыРасчетаСтоимостиПоАналогам.Вставить("КотировкиАналоговБлумберг", КотировкиАналоговБлумберг);
				
				#КонецОбласти

			КонецЕсли;

			КотировкиАналоговТекущейЦБ = ПараметрыРасчетаСтоимостиПоАналогам.КотировкиАналоговБлумберг.Скопировать(Новый Структура("ЦеннаяБумага", СтрокаЦенныеБумаги.ЦеннаяБумага));
			Если КотировкиАналоговТекущейЦБ.Количество() = 0 Тогда
				Если РасшифровкаОперации <> Неопределено Тогда
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Расчет цены по аналогам", Новый Структура("Аналоги", "Нет аналогов"));
				КонецЕсли;
				Возврат Ложь;
			КонецЕсли;

			// Расчет ставка дисконтирования:
			//					
			//     Σ YTM(i)
			// r = ————————
			//        N
			//					
			// YTM - эффективная доходность от котировки BGN (Last Price) аналогичной облигации
			
			КотировкиАналоговТекущейЦБ.Колонки.Добавить("YTM", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(27, 10)));
			
			Для Каждого КотировкиАналога Из КотировкиАналоговТекущейЦБ Цикл
					
				КотировкиАналога.YTM = Справочники.Облигации.ПолучитьДоходностьИДюрацию(
					КотировкиАналога.Аналог, Ложь, ДатаПереоценки, КотировкиАналога.CLOSE * КотировкиАналога.Номинал / 100, ПараметрыОценки.СчетДоверительногоУправления, , ДатаПереоценки).Доходность;
				
			КонецЦикла;
			
			Если РасшифровкаОперации <> Неопределено Тогда
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Расчет ставки дисконтирования", КотировкиАналоговТекущейЦБ.Скопировать());
			КонецЕсли;
			
			СтавкаДисконтирования = Окр(КотировкиАналоговТекущейЦБ.Итог("YTM") / КотировкиАналоговТекущейЦБ.Количество(), 6);		
			
			#КонецОбласти

		КонецЕсли;
			
		#КонецОбласти		
	
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Вариант расчета ставки дисконтирования по аналогам '%1' не реализован.", ПараметрыРасчетаСтоимостиПоАналогам.ВариантРасчета), , , , Отказ);
			
		Возврат Ложь;
		
	КонецЕсли;
	
	// Рассчитываем дисконтированную стоимость и заполняем цену 
	
	ВыполненРасчетЦены = ЗаполнитьДисконтированнойСтоимостью(СтрокаЦенныеБумаги, ПараметрыОценки, ДатаПереоценки, ДанныеОДенежномПотоке, СтавкаДисконтирования, УровеньОценки, ТочностьЦены, Отказ, РасшифровкаОперации);
	
	Если ВыполненРасчетЦены Тогда
		
		#Область Заполнение_переданным_источником_цены
		
		Если ПараметрыРасчетаСтоимостиПоАналогам.Свойство("ИсточникЦены") Тогда
			
			СтруктураИсточник = Новый Структура;
			СтруктураИсточник.Вставить("Источник",		ПараметрыРасчетаСтоимостиПоАналогам.ИсточникЦены);
			СтруктураИсточник.Вставить("ИсточникЦены",	ПараметрыРасчетаСтоимостиПоАналогам.ИсточникЦены);
			
			ЗаполнитьЗначенияСвойств(СтрокаЦенныеБумаги, СтруктураИсточник);
			
		КонецЕсли;
		
		#КонецОбласти
		
		Если ТестироватьРасчетнуюЦенуНаВхождениеВСпред Тогда
		
			#Область Тестирование_цены_на_вхождение_в_спред_цен_спроса_и_предложения
			
			РасчетнаяЦена = СтрокаЦенныеБумаги.Стоимость;
			
			OFFER	= СтрокаЦенныеБумаги.OFFER * СтрокаЦенныеБумаги.Номинал / 100;
			BID		= СтрокаЦенныеБумаги.BID * СтрокаЦенныеБумаги.Номинал / 100;

			Если OFFER = 0 ИЛИ BID = 0
				ИЛИ BID < РасчетнаяЦена И РасчетнаяЦена < OFFER 	
				ИЛИ OFFER < РасчетнаяЦена И РасчетнаяЦена < BID
					И ?(ПараметрыРасчетаСтоимостиПоАналогам.ВариантРасчета = Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2020, ДатаПереоценки < '20260101', Истина)
			Тогда
				
				// Проверка пройдена, оставляем как есть
				
			ИначеЕсли Pow(РасчетнаяЦена - OFFER, 2) < Pow(РасчетнаяЦена - BID, 2) Тогда
				
				СтрокаЦенныеБумаги.Стоимость		= OFFER;
				СтрокаЦенныеБумаги.ДатаЦены			= СтрокаЦенныеБумаги.ПоследняяДатаТоргов;
				СтрокаЦенныеБумаги.УровеньОценки	= ?(ДатаПереоценки >= '20201208', УровеньОценки, 1);
				СтрокаЦенныеБумаги.ВидЦены 			= Перечисления.ИсточникиЦеныДляПереоценки.ЦенаПредложения;
				СтрокаЦенныеБумаги.Источник			= СтрокаЦенныеБумаги.ОсновнаяПлощадка.ЮрФизЛицо;
				СтрокаЦенныеБумаги.ВалютаКотировки	= СтрокаЦенныеБумаги.ВалютаНоминала;
				
			Иначе
				
				СтрокаЦенныеБумаги.Стоимость		= BID;
				СтрокаЦенныеБумаги.ДатаЦены			= СтрокаЦенныеБумаги.ПоследняяДатаТоргов;
				СтрокаЦенныеБумаги.УровеньОценки	= ?(ДатаПереоценки >= '20201208', УровеньОценки, 1);
				СтрокаЦенныеБумаги.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.ЦенаСпроса;
				СтрокаЦенныеБумаги.Источник			= СтрокаЦенныеБумаги.ОсновнаяПлощадка.ЮрФизЛицо;
				СтрокаЦенныеБумаги.ВалютаКотировки	= СтрокаЦенныеБумаги.ВалютаНоминала;
									
			КонецЕсли;		
			
			Если РасшифровкаОперации <> Неопределено Тогда
			
				#Область Расшифровка_цены
				
				ПараметрыРасчетаЦен = Новый Структура;
				ПараметрыРасчетаЦен.Вставить("РасчетнаяЦена",	РасчетнаяЦена);	
				ПараметрыРасчетаЦен.Вставить("OFFER",			OFFER);	
				ПараметрыРасчетаЦен.Вставить("BID",				BID);	
				ПараметрыРасчетаЦен.Вставить("Условие",			"Цена попадает в спред, иначе ближайшая граница спреда");	
				ПараметрыРасчетаЦен.Вставить("Цена",			СтрокаЦенныеБумаги.Стоимость);	
				
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Результат тестирования цены", ПараметрыРасчетаЦен);
				
				#КонецОбласти
			
			КонецЕсли;
			
			#КонецОбласти

		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ВыполненРасчетЦены;	
		
КонецФункции

// #Техдолг перенести в ЗаполнитьДисконтированнойПоСтавкеРассчитаннойПоАналогамСтоимостью
Процедура ЗаполнитьНеоцененныеБумагиРасчетнымиЦенамиНационального2018(ПараметрыОценки, ДатаПереоценки, ТаблицаСтоимостейЦБ, ТестироватьЦенуТолькоПриНаличииСпреда, ЦенуИностранныхАктивовРассчитыватьПоБлумбергу, РасшифровкаРасчета)	

	Если ТаблицаСтоимостейЦБ.Найти(0, "Стоимость") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОсновнойКалендарьКотировок	= Константы.ОсновнойКалендарьКотировок.Получить();
	ПоследняяДатаТоргов			= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки));
	ОтборАналогов				= Новый Структура("Назначение, ТолькоСВалютойНоминалаЦеннойБумаги", Перечисления.ЦелиИспользованияАналогов.РасчетСтавкиДисконтирования, Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаПереоценки",		 ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов", ПоследняяДатаТоргов);
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаСтоимостейЦБ, "_НеоцененныеБумаги", Запрос, Истина, "ЦеннаяБумага, ТоргуетсяНаММВБ", "Стоимость = 0");

	ПоместитьАналогиЦенныхБумагВМенеджерВременныхТаблиц(Запрос, "_НеоцененныеБумаги", ДатаПереоценки, ПараметрыОценки.Организация, ПараметрыОценки.Клиент, ОтборАналогов, "_АналогичныеЦБ"); 

	ТаблицаСтавокДисконтирования		= Неопределено;
	ТаблицаЦенНРДиБлумбергДляАналогов	= Неопределено;
	ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки);
	
	Для Каждого СтрокаТаблицыСтоимостейЦБ ИЗ ТаблицаСтоимостейЦБ Цикл
		
		Если СтрокаТаблицыСтоимостейЦБ.Стоимость <> 0 ИЛИ СтрокаТаблицыСтоимостейЦБ.Рынок <> Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			Продолжить;
		КонецЕсли;
		
		ЦеннаяБумага = СтрокаТаблицыСтоимостейЦБ.ЦеннаяБумага;
		
		Если СтрокаТаблицыСтоимостейЦБ.ТоргуетсяНаММВБ
			И (Не ЦенуИностранныхАктивовРассчитыватьПоБлумбергу ИЛИ СтрокаТаблицыСтоимостейЦБ.ВидЦеныБлумберга = 0)
		Тогда
			
			#Область Облигации_российских_эмитентов_допущенные_к_торгам
			
			Если ТаблицаСтавокДисконтирования = Неопределено Тогда
				
				#Область Расчет_ставок_дисконтирования_по_аналогам

				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_АналогичныеЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
					|	_АналогичныеЦБ.Аналог КАК Аналог,
					|	СУММА(КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность) КАК ОбъемСделокЗа10Дней
					|ПОМЕСТИТЬ _АналогиПослеПроверкиОбъемаСделок
					|ИЗ
					|	_АналогичныеЦБ КАК _АналогичныеЦБ
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _НеоцененныеБумаги КАК _НеоцененныеБумаги
					|		ПО (_НеоцененныеБумаги.ЦеннаяБумага = _АналогичныеЦБ.ЦеннаяБумага)
					|			И (_НеоцененныеБумаги.ТоргуетсяНаММВБ)
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
					|		ПО _АналогичныеЦБ.Аналог = КотировкиТорговыхПлощадок.ЦеннаяБумага
					|			И (КотировкиТорговыхПлощадок.Период МЕЖДУ &ТорговыхДнейНазад10 И &ДатаПереоценки)
					|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
					|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
					|		ПО (КурсыВалют.Валюта = КотировкиТорговыхПлощадок.Валюта)
					|			И (КурсыВалют.Период = &ДатаПереоценки)
					|
					|СГРУППИРОВАТЬ ПО
					|	_АналогичныеЦБ.ЦеннаяБумага,
					|	_АналогичныеЦБ.Аналог
					|
					|ИМЕЮЩИЕ
					|	СУММА(КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность) > 500000
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_АналогиПослеПроверкиОбъемаСделок.ЦеннаяБумага КАК ЦеннаяБумага,
					|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _АналогиПослеПроверкиОбъемаСделок.Аналог) КАК Количество
					|ПОМЕСТИТЬ _КоличествоАналогов
					|ИЗ
					|	_АналогиПослеПроверкиОбъемаСделок КАК _АналогиПослеПроверкиОбъемаСделок
					|
					|СГРУППИРОВАТЬ ПО
					|	_АналогиПослеПроверкиОбъемаСделок.ЦеннаяБумага
					|
					|ИМЕЮЩИЕ
					|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _АналогиПослеПроверкиОбъемаСделок.Аналог) >= 3
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_КоличествоАналогов.ЦеннаяБумага КАК ЦеннаяБумага,
					|	СУММА(КотировкиТорговыхПлощадок.YIELDATWAP * КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность) КАК Делимое,
					|	СУММА(КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность) КАК Делитель
					|ПОМЕСТИТЬ _ДляРасчетаСтавки
					|ИЗ
					|	_КоличествоАналогов КАК _КоличествоАналогов
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _АналогиПослеПроверкиОбъемаСделок КАК _АналогиПослеПроверкиОбъемаСделок
					|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
					|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
					|				ПО КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта
					|			ПО _АналогиПослеПроверкиОбъемаСделок.Аналог = КотировкиТорговыхПлощадок.ЦеннаяБумага
					|		ПО _КоличествоАналогов.ЦеннаяБумага = _АналогиПослеПроверкиОбъемаСделок.ЦеннаяБумага
					|ГДЕ
					|	КотировкиТорговыхПлощадок.Период = &ПоследняяДатаТоргов
					|	И КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим
					|	И КотировкиТорговыхПлощадок.Биржа = &ММВБ
					|	И КурсыВалют.Период = &ДатаПереоценки
					|
					|СГРУППИРОВАТЬ ПО
					|	_КоличествоАналогов.ЦеннаяБумага
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_ДляРасчетаСтавки.ЦеннаяБумага КАК ЦеннаяБумага,
					|	_ДляРасчетаСтавки.Делимое / _ДляРасчетаСтавки.Делитель КАК СтавкаДисконтирования,
					|	ЕСТЬNULL(КотировкиТорговыхПлощадок.OFFER, 0) КАК OFFER,
					|	ЕСТЬNULL(КотировкиТорговыхПлощадок.BID, 0) КАК BID
					|ИЗ
					|	_ДляРасчетаСтавки КАК _ДляРасчетаСтавки
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
					|		ПО _ДляРасчетаСтавки.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
					|			И (КотировкиТорговыхПлощадок.Период = &ПоследняяДатаТоргов)
					|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
					|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)";

				БиржаММВБ			= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
				ТорговыхДнейНазад10 = Справочники.Календари.ДобавитьКДатеРабочиеДни(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки), -10);

				Запрос.УстановитьПараметр("ТорговыхДнейНазад10",	ТорговыхДнейНазад10);
				Запрос.УстановитьПараметр("ММВБ",					БиржаММВБ);

				ТаблицаСтавокДисконтирования = Запрос.Выполнить().Выгрузить();

				Если РасшифровкаРасчета <> Неопределено Тогда
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Таблица ставок дисконтирования", ТаблицаСтавокДисконтирования.Скопировать());	
				КонецЕсли;				
				
				#КонецОбласти
				
			КонецЕсли;
			
			СтрокаСтавкиДисконтирования = ТаблицаСтавокДисконтирования.Найти(ЦеннаяБумага, "ЦеннаяБумага");
			
			Если СтрокаСтавкиДисконтирования = Неопределено Тогда // нет аналогов
				Если РасшифровкаРасчета <> Неопределено Тогда
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Параметры расчета цен", Новый Структура("Аналоги", "Нет аналогов"));
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			
			СтавкаДисконтирования = СтрокаСтавкиДисконтирования.СтавкаДисконтирования;
			
			Если ПараметрыОценки.Свойство("ТочностьСтавкиДисконтирования") Тогда
				СтавкаДисконтированияДоОкругления	= СтавкаДисконтирования;
				СтавкаДисконтирования				= Окр(СтавкаДисконтирования, ПараметрыОценки.ТочностьСтавкиДисконтирования);
			КонецЕсли; 			
			
			ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ПараметрыДенежногоПотока, ПараметрыОценки, , РасшифровкаРасчета);
			
			ПриведеннаяСтоимость = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтавкаДисконтирования, ДатаПереоценки, ПараметрыОценки)
				- Справочники.Облигации.ПолучитьКупон(ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
				
			ЦенаBID		= СтрокаСтавкиДисконтирования.BID * СтрокаТаблицыСтоимостейЦБ.Номинал / 100;	
			ЦенаOFFER	= СтрокаСтавкиДисконтирования.OFFER * СтрокаТаблицыСтоимостейЦБ.Номинал / 100;	
				
			Если ТестироватьЦенуТолькоПриНаличииСпреда И СтрокаСтавкиДисконтирования.OFFER = 0 и СтрокаСтавкиДисконтирования.BID = 0 тогда
				
				СтрокаТаблицыСтоимостейЦБ.Стоимость			= ПриведеннаяСтоимость;
				СтрокаТаблицыСтоимостейЦБ.ДатаЦены			= ДатаПереоценки;
				СтрокаТаблицыСтоимостейЦБ.УровеньОценки		= 3;
				СтрокаТаблицыСтоимостейЦБ.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
				СтрокаТаблицыСтоимостейЦБ.Источник			= ПараметрыОценки.Клиент;
				СтрокаТаблицыСтоимостейЦБ.ВалютаКотировки	= СтрокаТаблицыСтоимостейЦБ.ВалютаНоминала;
				
			ИначеЕсли ПриведеннаяСтоимость > ЦенаOFFER Тогда
				
				СтрокаТаблицыСтоимостейЦБ.Стоимость			= ЦенаOFFER;
				СтрокаТаблицыСтоимостейЦБ.ДатаЦены			= ПоследняяДатаТоргов;
				СтрокаТаблицыСтоимостейЦБ.УровеньОценки		= 1;
				СтрокаТаблицыСтоимостейЦБ.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.ЦенаПредложения;
				СтрокаТаблицыСтоимостейЦБ.Источник			= БиржаММВБ.ЮрФизЛицо;
				СтрокаТаблицыСтоимостейЦБ.ВалютаКотировки	= СтрокаТаблицыСтоимостейЦБ.ВалютаНоминала;
				
			ИначеЕсли ПриведеннаяСтоимость < ЦенаBID Тогда
				
				СтрокаТаблицыСтоимостейЦБ.Стоимость			= ЦенаBID;
				СтрокаТаблицыСтоимостейЦБ.ДатаЦены			= ПоследняяДатаТоргов;
				СтрокаТаблицыСтоимостейЦБ.УровеньОценки		= 1;
				СтрокаТаблицыСтоимостейЦБ.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.ЦенаСпроса;
				СтрокаТаблицыСтоимостейЦБ.Источник			= БиржаММВБ.ЮрФизЛицо;
				СтрокаТаблицыСтоимостейЦБ.ВалютаКотировки	= СтрокаТаблицыСтоимостейЦБ.ВалютаНоминала;
				
			Иначе	
				
				СтрокаТаблицыСтоимостейЦБ.Стоимость			= ПриведеннаяСтоимость;
				СтрокаТаблицыСтоимостейЦБ.ДатаЦены			= ДатаПереоценки;
				СтрокаТаблицыСтоимостейЦБ.УровеньОценки		= 3;
				СтрокаТаблицыСтоимостейЦБ.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
				СтрокаТаблицыСтоимостейЦБ.Источник			= ПараметрыОценки.Клиент;
				СтрокаТаблицыСтоимостейЦБ.ВалютаКотировки	= СтрокаТаблицыСтоимостейЦБ.ВалютаНоминала;
				
			КонецЕсли;
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				
				#Область Расшифровка_цены
				
				ПараметрыРасчетаЦен = Новый Структура;
				
				Если ПараметрыОценки.Свойство("ТочностьСтавкиДисконтирования") Тогда
					ПараметрыРасчетаЦен.Вставить("СтавкаДисконтированияДоОкругления",	СтавкаДисконтированияДоОкругления);
					ПараметрыРасчетаЦен.Вставить("ТочностьСтавкиДисконтирования",		ПараметрыОценки.ТочностьСтавкиДисконтирования);
				КонецЕсли;
				
				ПараметрыРасчетаЦен.Вставить("СтавкаДисконтирования",					СтавкаДисконтирования);
				ПараметрыРасчетаЦен.Вставить("ПриведеннаяСтоимость",					ПриведеннаяСтоимость);
				ПараметрыРасчетаЦен.Вставить("BID",										ЦенаBID);
				ПараметрыРасчетаЦен.Вставить("OFFER",									ЦенаOFFER);
				ПараметрыРасчетаЦен.Вставить("ТестироватьЦенуТолькоПриНаличииСпреда",	ТестироватьЦенуТолькоПриНаличииСпреда);
				ПараметрыРасчетаЦен.Вставить("Условие",									"если больше OFFER, то OFFER; если меньше BID, то BID");
				ПараметрыРасчетаЦен.Вставить("Цена",									СтрокаТаблицыСтоимостейЦБ.Стоимость);
				
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Параметры расчета цен", ПараметрыРасчетаЦен);
				
				#КонецОбласти
				
			КонецЕсли;
			
			#КонецОбласти
			
		Иначе // тестирование не проводилось
			
			#Область Облигации_иностранных_эмитентов_или_недопущенные_к_торгам
			
			Если ТаблицаЦенНРДиБлумбергДляАналогов = Неопределено Тогда
				
				#Область Получение_цен_НРД_и_Блумберг_для_необращающихся_на_ММВБ

				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_АналогичныеЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
					|	_АналогичныеЦБ.Аналог КАК Аналог,
					|	ЕСТЬNULL(РасчетныеЦеныНРД.PRICE, 0) КАК PRICE,
					|	ЕСТЬNULL(КотировкиТорговыхПлощадок.CLOSE, 0) КАК CLOSE
					|ИЗ
					|	_АналогичныеЦБ КАК _АналогичныеЦБ
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _НеоцененныеБумаги КАК _НеоцененныеБумаги
					|		ПО (_НеоцененныеБумаги.ЦеннаяБумага = _АналогичныеЦБ.ЦеннаяБумага)
					|			И (НЕ _НеоцененныеБумаги.ТоргуетсяНаММВБ)
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
					|		ПО (РасчетныеЦеныНРД.ЦеннаяБумага = _АналогичныеЦБ.Аналог)
					|			И (РасчетныеЦеныНРД.Период = &ПоследняяДатаТоргов)
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
					|		ПО (КотировкиТорговыхПлощадок.ЦеннаяБумага = _АналогичныеЦБ.Аналог)
					|			И (КотировкиТорговыхПлощадок.Биржа = &Блумберг)
					|			И (КотировкиТорговыхПлощадок.РежимТоргов = &Режим_BGN)
					|			И (КотировкиТорговыхПлощадок.Период = &ПоследняяДатаТорговБлумберга)";				
				
				Запрос.УстановитьПараметр("Блумберг",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
				Запрос.УстановитьПараметр("Режим_BGN",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
				Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберга",	РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки));

				ТаблицаЦенНРДиБлумбергДляАналогов = Запрос.Выполнить().Выгрузить();

				Если РасшифровкаРасчета <> Неопределено Тогда
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Таблица цен НРД и Блумберг на аналоги", ТаблицаЦенНРДиБлумбергДляАналогов.Скопировать());	
				КонецЕсли;
				
				#КонецОбласти
				
			КонецЕсли;
			
			СтрокиАналогов = ТаблицаЦенНРДиБлумбергДляАналогов.НайтиСтроки(Новый Структура("ЦеннаяБумага", ЦеннаяБумага));
			
			Если СтрокиАналогов.Количество() = 0 Тогда // нет аналогов
				Если РасшифровкаРасчета <> Неопределено Тогда
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Параметры расчета цен", Новый Структура("Аналоги", "Нет аналогов"));
				КонецЕсли;
				Продолжить;
			КонецЕсли;

			КоличествоАналогов = 0;
			СуммаДоходностей = 0;
			
			Для Каждого Аналог Из СтрокиАналогов Цикл
				
				ТекущаяЦена = ?(ЦенуИностранныхАктивовРассчитыватьПоБлумбергу И СтрокаТаблицыСтоимостейЦБ.ВидЦеныБлумберга <> 0, Аналог.CLOSE, Аналог.PRICE);
				
				Если ТекущаяЦена = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(Аналог.Аналог, ПараметрыДенежногоПотока, ПараметрыОценки, , РасшифровкаРасчета); 
			
				ЭффективнаяДоходность = БухгалтерскийУчет.РассчитатьДоходностьИДюрациюПоПотоку(ДенежныйПоток, ДатаПереоценки, ТекущаяЦена).Доходность;
				
				КоличествоАналогов = КоличествоАналогов + 1;
				СуммаДоходностей = СуммаДоходностей + ЭффективнаяДоходность;
				
				Если РасшифровкаРасчета <> Неопределено Тогда
					ПараметрыРасчетаЦен = Новый Структура("ЭффективнаяДоходность, СуммаДоходностей", ЭффективнаяДоходность, СуммаДоходностей);
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Параметры расчета цен " + Строка(Аналог.Аналог), ПараметрыРасчетаЦен);
				КонецЕсли;

			КонецЦикла;
			
			Если КоличествоАналогов < 3 ИЛИ СуммаДоходностей = 0 Тогда 
				Если РасшифровкаРасчета <> Неопределено Тогда
					ПараметрыРасчетаЦен = Новый Структура("КоличествоАналогов, СуммаДоходностей", КоличествоАналогов, СуммаДоходностей);
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Параметры расчета цен " + Строка(ЦеннаяБумага), ПараметрыРасчетаЦен);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			
			СтавкаДисконтирования = СуммаДоходностей / КоличествоАналогов;

			Если ПараметрыОценки.Свойство("ТочностьСтавкиДисконтирования") Тогда
				СтавкаДисконтированияДоОкругления	= СтавкаДисконтирования;
				СтавкаДисконтирования				= Окр(СтавкаДисконтирования, ПараметрыОценки.ТочностьСтавкиДисконтирования);
			КонецЕсли;
			
			ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ПараметрыДенежногоПотока, ПараметрыОценки, , РасшифровкаРасчета);
			
			ПриведеннаяСтоимость = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, СтавкаДисконтирования, ДатаПереоценки, ПараметрыОценки)
				- Справочники.Облигации.ПолучитьКупон(ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);
			
			СтрокаТаблицыСтоимостейЦБ.Стоимость			= ПриведеннаяСтоимость;
			СтрокаТаблицыСтоимостейЦБ.ДатаЦены			= ДатаПереоценки;
			СтрокаТаблицыСтоимостейЦБ.УровеньОценки		= 3;
			СтрокаТаблицыСтоимостейЦБ.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
			СтрокаТаблицыСтоимостейЦБ.Источник			= ПараметрыОценки.Клиент;
			СтрокаТаблицыСтоимостейЦБ.ВалютаКотировки	= СтрокаТаблицыСтоимостейЦБ.ВалютаНоминала;

			Если РасшифровкаРасчета <> Неопределено Тогда
				
				#Область Расшифровка_цены
				
				ПараметрыРасчетаЦен = Новый Структура;
				
				Если ПараметрыОценки.Свойство("ТочностьСтавкиДисконтирования") Тогда
					ПараметрыРасчетаЦен.Вставить("СтавкаДисконтированияДоОкругления",	СтавкаДисконтированияДоОкругления);
					ПараметрыРасчетаЦен.Вставить("ТочностьСтавкиДисконтирования",		ПараметрыОценки.ТочностьСтавкиДисконтирования);
				КонецЕсли;
				
				ПараметрыРасчетаЦен.Вставить("СтавкаДисконтирования",					СтавкаДисконтирования);
				ПараметрыРасчетаЦен.Вставить("ПриведеннаяСтоимость",					ПриведеннаяСтоимость);
				
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Параметры расчета цен", ПараметрыРасчетаЦен);
				
				#КонецОбласти
				
			КонецЕсли;
			
			#КонецОбласти
			
		КонецЕсли;		
		
	КонецЦикла;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "После расчета цен", ТаблицаСтоимостейЦБ.Скопировать());	
	КонецЕсли;

КонецПроцедуры

// Заполняет строку переоценки в соответствии с моделью оценки, основанной на корректировке исторической цены (CAPM)
//
// Параметры:
//	СтрокаЦенныеБумаги - СтрокаТаблицыЗначений - строка таблицы значений как в РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС  
//	ПараметрыОценки - Структура - см. РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС 
//	ДатаПереоценки - Дата - 
//	ГлубинаПоиска - см. РаботаСПереоценкой.ПолучитьПоследнююНаблюдаемуюЦену
//	Календарь - см. РаботаСПереоценкой.ПолучитьПоследнююНаблюдаемуюЦену 
//	УровеньОценки - Число -   
//	ТочностьЦены - Число - округление до указанного числа знаков после запятой,
//				 - Неопределено - цена не округляется
//	Отказ - Булево - 
//	РасшифровкаРасчета - Структура, Неопределено - 
//
// Возвращаемое значение:
//	ЦенаЗаполнена - Булево - Истина, если удалось рассчитать и заполнить цену
//
Функция ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаЦенныеБумаги, ПараметрыОценки, ДатаПереоценки, ГлубинаПоиска, Календарь = Неопределено, УровеньОценки = 2, ТочностьЦены = Неопределено, Отказ, РасшифровкаРасчета = Неопределено)
	
	ВыполненРасчетЦены = Ложь;	
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расчет по модели оценки, основанной на корректировке исторической цены (CAPM)", , , Истина);
	КонецЕсли;
	
	РасчетПоCAPM = ПолучитьЦенуНаОсновеКорректировкиИсторическойЦены(ПараметрыОценки, ДатаПереоценки, СтрокаЦенныеБумаги, ГлубинаПоиска, Календарь, ТочностьЦены, Отказ, РасшифровкаОперации);  
	
	Если РасчетПоCAPM <> Неопределено Тогда

		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("Биржа",				Справочники.Биржи.ПустаяСсылка());
		СтруктураДанных.Вставить("ИсточникЦены",		Справочники.ЮрФизЛица.ПустаяСсылка());
		СтруктураДанных.Вставить("Источник",			Справочники.ЮрФизЛица.ПустаяСсылка());
		СтруктураДанных.Вставить("ПолеЦены", 			Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена);
		СтруктураДанных.Вставить("ВидЦены", 			Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена);
		СтруктураДанных.Вставить("УровеньОценки",		УровеньОценки);
		СтруктураДанных.Вставить("ДатаКотировки",		ДатаПереоценки);
		СтруктураДанных.Вставить("ДатаЦены",			ДатаПереоценки);
		СтруктураДанных.Вставить("ВалютаКотировки",		СтрокаЦенныеБумаги.ВалютаНоминала);
		СтруктураДанных.Вставить("Стоимость",			РасчетПоCAPM.Цена);
		СтруктураДанных.Вставить("ЦенаКотировки",		РасчетПоCAPM.Цена);
		СтруктураДанных.Вставить("РыночнаяЦена",		РасчетПоCAPM.Цена);
		
		ЗаполнитьЗначенияСвойств(СтрокаЦенныеБумаги, СтруктураДанных); 
		
		ВыполненРасчетЦены = Истина;
		
	КонецЕсли;

	Возврат ВыполненРасчетЦены;
		
КонецФункции

#Область Вспомогательные_функции

Функция ОценкаПоАмортизированнойСтоимости(Рынок, УчетныйАктивЕПС, ПараметрыОценки = Неопределено)
	
	// Амортизированную стоимость считаем только для облигаций, отнесенных к соответствующей группе учетных активов,
	// при отсутствии режима оценки только по справедливой стоимости
	
	Если ТипЗнч(ПараметрыОценки) = Тип("Структура")
		И ПараметрыОценки.Свойство("ОцениватьПоСправедливойСтоимости")
		И ПараметрыОценки.ОцениватьПоСправедливойСтоимости
	Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не (Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И ЗначениеЗаполнено(УчетныйАктивЕПС)) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УчетныеАктивыОцениваемыеПоАС = Кэширование.УчетныеАктивыОцениваемыеПоАмортизированнойСтоимости(); 
	
	Возврат (УчетныеАктивыОцениваемыеПоАС.Найти(УчетныйАктивЕПС) <> Неопределено);
	
КонецФункции

