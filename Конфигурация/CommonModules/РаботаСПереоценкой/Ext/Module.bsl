		|ПОМЕСТИТЬ _ОцененныеБумаги
		|ИЗ
		|	_Уровень1 КАК _Уровень1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_Уровень2.Рынок,
		|	_Уровень2.ЦеннаяБумага,
		|	_Уровень2.ВалютаНоминала,
		|	_Уровень2.УровеньОценки,
		|	_Уровень2.ВидЦены,
		|	_Уровень2.СправедливаяЦена,
		|	_Уровень2.ВалютаЦены,
		|	_Уровень2.ВалютаЦены,
		|	_Уровень2.ДатаЦены,
		|	_Уровень2.Источник
		|ИЗ
		|	_Уровень2 КАК _Уровень2
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	_ТаблицаЦБ.Номинал КАК Номинал,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА _ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА (ВЫРАЗИТЬ(_ОцененныеБумаги.СправедливаяЦена * _ТаблицаЦБ.Номинал КАК ЧИСЛО(27, 10))) / 100
		|			ИНАЧЕ _ОцененныеБумаги.СправедливаяЦена
		|		КОНЕЦ, 0) КАК Стоимость,
		|	ЕСТЬNULL(_ОцененныеБумаги.Валюта, 0) КАК Валюта,
		|	ЕСТЬNULL(_ОцененныеБумаги.ВалютаКотировки, 0) КАК ВалютаКотировки,
		|	ЕСТЬNULL(_ОцененныеБумаги.ВидЦены, 0) КАК ВидЦены,
		|	ЕСТЬNULL(_ОцененныеБумаги.ДатаЦены, 0) КАК ДатаЦены,
		|	ЕСТЬNULL(_ОцененныеБумаги.УровеньОценки, 0) КАК УровеньОценки,
		|	ЕСТЬNULL(Биржи.ЮрФизЛицо, ЕСТЬNULL(_ОцененныеБумаги.Источник, 0)) КАК Источник,
		|	0 КАК Купон,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаКупона,
		|	_ТаблицаЦБ.ЭмитентРоссийский КАК ЭмитентРоссийский,
		|	_ТаблицаЦБ.ОблигацияОВОЗРФ КАК ОблигацияОВОЗРФ,
		|	_ТаблицаЦБ.ЭмитентМеждународнаяФинОрганизация КАК ЭмитентМеждународнаяФинОрганизация
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОцененныеБумаги КАК _ОцененныеБумаги
		|		ПО (_ОцененныеБумаги.ЦеннаяБумага = _ТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		|		ПО (Биржи.Ссылка = _ОцененныеБумаги.Источник)";
	
	#КонецОбласти	
	
	ДоступныеБиржи = Новый Массив;
	ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_NYSE"));
	ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Насдак"));
	ДоступныеБиржи.Добавить("Шанхайская фондовая биржа (Shanghai Stock Exchange)");
	ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Токио"));
    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_LSE"));
	ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_HKEX"));
    ДоступныеБиржи.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_FWB"));
	
	ТолькоНаблюдаемыеЦены = ПараметрыОценки.Свойство("ТолькоНаблюдаемыеЦены") И ПараметрыОценки.ТолькоНаблюдаемыеЦены;
	
	ММВБ		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");	
	НРД			= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");	
	Блумберг	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
	
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберг",	РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки, Блумберг));
	
	Запрос.УстановитьПараметр("ММВБ",							ММВБ);	
	Запрос.УстановитьПараметр("НРД",							НРД);
	Запрос.УстановитьПараметр("ДоступныеБиржи",					ДоступныеБиржи);	
	
	Запрос.УстановитьПараметр("Блумберг",						Блумберг);
	Запрос.УстановитьПараметр("Режим_BGN",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	Запрос.УстановитьПараметр("ДоступныДанныеBloomberg",		ПроверитьДоступностьДанныхBloomberg(ДатаПереоценки));
	
	Запрос.УстановитьПараметр("ТолькоНаблюдаемыеЦены",			ТолькоНаблюдаемыеЦены);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Методика Гефест", "Таблица стоимостей ЦБ", , , "_ИсходнаяТаблицаЦБ, _ЭмитентыЦенныхБумаг, _ТаблицаДатРасчетныхЦенПаев, _ИтогиЗаПоследние10ТорговыхДнейПоРежимамТоргов");
	КонецЕсли;
	
	Если ТолькоНаблюдаемыеЦены Тогда
		Возврат ТаблицаСтоимостейЦБ;
	КонецЕсли;
	
	// Расчетные цены 	
	
	ВыполненРасчетЦены = Ложь;	
	
	ПараметрыОценки.Вставить("ТочностьСрокаДоДатыПотока",	2);
	ПараметрыОценки.Вставить("ПараметрыМоделиCAPM",			Новый Структура("ТочностьБета", 6));
	
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	
	ЦеныНРД = Неопределено;
	
	Для Каждого СтрокаСтоимостейЦБ Из ТаблицаСтоимостейЦБ Цикл
		
		// Заполнение купона
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаСтоимостейЦБ.Купон = Справочники.Облигации.ПолучитьКупон(СтрокаСтоимостейЦБ.ЦеннаяБумага, ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления, , СтрокаСтоимостейЦБ.ВалютаКупона);
		КонецЕсли;
		
		Если СтрокаСтоимостейЦБ.Стоимость <> 0 ИЛИ ЗначениеЗаполнено(СтрокаСтоимостейЦБ.ВидЦены) Тогда
			Продолжить;
		КонецЕсли;
		
		// Расчет цены
		
		ОшибкаРасчета = Ложь;
		
		Если СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			Если СтрокаСтоимостейЦБ.ЭмитентРоссийский И Не СтрокаСтоимостейЦБ.ОблигацияОВОЗРФ И Не СтрокаСтоимостейЦБ.ЭмитентМеждународнаяФинОрганизация Тогда
				ПриоритетыЦен = РаботаСКоллекциями.ЗначенияВМассив("НРД 3 уровня", "PV 3 уровня");
			Иначе
				ПриоритетыЦен = РаботаСКоллекциями.ЗначенияВМассив("PV 2 уровня", "НРД 3 уровня");
			КонецЕсли;
			
			Для Каждого ВидЦены Из ПриоритетыЦен Цикл
				
				Если ВидЦены = "PV 2 уровня" ИЛИ ВидЦены = "PV 3 уровня" Тогда
				
					#Область Расчет_по_модели_дисконтирования_стоимости_будущих_денежных_потоков
					
					УровеньОценки = ?(ВидЦены = "PV 2 уровня", 2, 3);
					
					ЦенаЗаполнена = ЗаполнитьДисконтированнойПоЗначениямКБДСтоимостью(СтрокаСтоимостейЦБ, ДатаПереоценки, ПараметрыОценки, УровеньОценки, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, , 2, ПараметрыДенежногоПотока, ОшибкаРасчета, РасшифровкаРасчета);
					
					Если ОшибкаРасчета ИЛИ ЦенаЗаполнена Тогда
						Прервать;
					КонецЕсли;
					
					#КонецОбласти
					
				ИначеЕсли ВидЦены = "НРД 3 уровня" Тогда
					
					#Область Расчетная_цена_НРД_3_уровня

					Если ЦеныНРД = Неопределено Тогда
						ЦеныНРД = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_РасчетныеЦеныНРД").Выгрузить();
						ЦеныНРД.Индексы.Добавить("ЦеннаяБумага");
					КонецЕсли;

					ЦеныНРДТекущейЦБ = ЦеныНРД.НайтиСтроки(Новый Структура("ЦеннаяБумага, VERSION, METHOD_NUMBER", СтрокаСтоимостейЦБ.ЦеннаяБумага, "2", "3"));

					Если ЦеныНРДТекущейЦБ.Количество() > 0 Тогда

						СтрокаСтоимостейЦБ.Стоимость		= ЦеныНРДТекущейЦБ[0].Цена * СтрокаСтоимостейЦБ.Номинал / 100;
						СтрокаСтоимостейЦБ.ДатаЦены			= ЦеныНРДТекущейЦБ[0].ДатаЦены;
						СтрокаСтоимостейЦБ.УровеньОценки	= 3;
						СтрокаСтоимостейЦБ.ВидЦены			= Перечисления.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД;
						СтрокаСтоимостейЦБ.Источник			= НРД;
						СтрокаСтоимостейЦБ.ВалютаКотировки	= СтрокаСтоимостейЦБ.ВалютаНоминала;

						ЦенаЗаполнена = Истина;
						Прервать;
						
					КонецЕсли;

					#КонецОбласти

				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Неизвестный вид цены '%1'", ВидЦены), , , , ОшибкаРасчета);
					Прервать;
				КонецЕсли;
			
			КонецЦикла;
			
			Если ОшибкаРасчета Тогда
				ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
				Продолжить;
			ИначеЕсли ЦенаЗаполнена Тогда
				ВыполненРасчетЦены = Истина;
				Продолжить;
			КонецЕсли;
			
		ИначеЕсли СтрокаСтоимостейЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
			
			Если СтрокаСтоимостейЦБ.ЭмитентРоссийский Тогда
			
				#Область Расчет_на_основе_корректировки_исторической_цены					
				
				// Справедливая стоимость акций, обращающихся на российских и иностранных фондовых биржах,
				// определяется в соответствии с моделью оценки, основанной на корректировке исторической цены (CAPM)
				// Применяем при отсутствии наблюдаемой цены не более 10 рабочих дней
				
				ЦенаЗаполнена = ЗаполнитьНаОсновеКорректировкиИсторическойЦены(СтрокаСтоимостейЦБ, ПараметрыОценки, ДатаПереоценки, 10, Справочники.Календари.Общероссийский, 2, 2, ОшибкаРасчета, РасшифровкаРасчета);  
				
				Если ОшибкаРасчета Тогда
					ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаСтоимостейЦБ);
					Продолжить;
				ИначеЕсли ЦенаЗаполнена Тогда
					ВыполненРасчетЦены = Истина;
					Продолжить;
				КонецЕсли;
				
				#КонецОбласти					
			
			КонецЕсли;
			
		КонецЕсли;

	КонецЦикла;
	
	Если ВыполненРасчетЦены И РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "После расчета цен", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;
	
	Возврат ТаблицаСтоимостейЦБ;	

КонецФункции

Функция ПолучитьЦеныРостеха(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)

	Запрос = Новый Запрос;
	
	ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(Запрос, ТаблицаЦБ, "_ИсходнаяТаблицаЦБ");
	ПоместитьЭмитентовЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "_ИсходнаяТаблицаЦБ");
	ПоместитьСтатусыЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ДатаПереоценки, "_ИсходнаяТаблицаЦБ"); 
	ПоместитьСведенияОТоргахЦеннымиБумагамиВМенеджерВременныхТаблиц(Запрос, "_ИсходнаяТаблицаЦБ", ДатаПереоценки, 1, "_СведенияОТоргахЦеннымиБумагами");
	ПоместитьТаблицуДатРасчетныхЦенПаевВМенеджерВременныхТаблиц(Запрос, "_ИсходнаяТаблицаЦБ", ДатаПереоценки, "_ТаблицаДатРасчетныхЦенПаев");
	ПоместитьБумагиОцениваемыеПоАмортизированнойСтоимостиВМенеджерВременныхТаблиц(Запрос, ПараметрыОценки, ДатаПереоценки, "_ИсходнаяТаблицаЦБ");
		
	#Область Основной_запрос	
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	_ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(Облигации.Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗРФ), ЛОЖЬ) КАК ОблигацияОВОЗРФ,
		|	_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента КАК Эмитент,
		|	ЕСТЬNULL(_ЭмитентыЦенныхБумаг.Банкрот, ЛОЖЬ) КАК ЭмитентБанкрот,
		|	_ЭмитентыЦенныхБумаг.ДатаБанкротства КАК ЭмитентДатаБанкротства,
		|	_БумагиОцениваемыеПоАмортизированнойСтоимости.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК ОценкаПоАмортизированнойСтоимости,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)), ЛОЖЬ) КАК ЭмитентРоссийский,
		|	ЕСТЬNULL(РеквизитыЮрЛицаЭмитента.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация), ЛОЖЬ) КАК ЭмитентМеждународнаяФинОрганизация,
		|	_ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи) КАК ПайИнвестиционногоФонда,
		|	_СведенияОТоргахЦеннымиБумагами.Дата КАК ПоследняяДатаТоргов
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЭмитентыЦенныхБумаг КАК _ЭмитентыЦенныхБумаг
		|		ПО (_ЭмитентыЦенныхБумаг.ЦеннаяБумага = _ИсходнаяТаблицаЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						_ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента
		|					ИЗ
		|						_ЭмитентыЦенныхБумаг)) КАК РеквизитыЮрЛицаЭмитента
		|		ПО (РеквизитыЮрЛицаЭмитента.ЮрФизЛицо = _ЭмитентыЦенныхБумаг.ЮрЛицоЭмитента)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
