			|	КОНЕЦ КАК ДатаЦены,
			|	ВЫБОР
			|		КОГДА _До_П_2_2_5.Стоимость = 0
			|				И НЕ _До_П_2_2_5.ВидЦены = ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.Дефолт)
			|			ТОГДА ЕСТЬNULL(СтоимостьПереоценкиСрезПоследних.УровеньОценки, 0)
			|		ИНАЧЕ _До_П_2_2_5.УровеньОценки
			|	КОНЕЦ КАК УровеньОценки,
			|	ВЫБОР
			|		КОГДА _До_П_2_2_5.Стоимость = 0
			|				И НЕ _До_П_2_2_5.ВидЦены = ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.Дефолт)
			|			ТОГДА ЕСТЬNULL(СтоимостьПереоценкиСрезПоследних.ВидЦены, 0)
