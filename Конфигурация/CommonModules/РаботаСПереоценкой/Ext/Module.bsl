		   |					ИНАЧЕ Котировки_Bloomberg_BGN.Валюта
		   |				КОНЕЦ
		   |		КОГДА ЕСТЬNULL(Котировки_Bloomberg_BVAL.CLOSE, 0) > 0
		   |			ТОГДА ВЫБОР
		   |					КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		   |						ТОГДА ТаблицаЦБ.ВалютаНоминала
		   |					ИНАЧЕ Котировки_Bloomberg_BVAL.Валюта
		   |				КОНЕЦ
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК ВалютаКотировки,
		   |	ВЫБОР
		   |		КОГДА ЦеныММВБ_1Уровень.СправедливаяЦена > 0
		   |			ТОГДА ЦеныММВБ_1Уровень.ИсточникКотировки
		   |		КОГДА ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.Период, ДАТАВРЕМЯ(1890, 1, 1, 0, 0, 0)) >= ДОБАВИТЬКДАТЕ(&ДатаПереоценки, МЕСЯЦ, -1)
		   |			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
		   |		КОГДА ЕСТЬNULL(РасчетныеЦеныНРДСрезПоследних.PRICE, 0) > 0
		   |			ТОГДА &НРД
		   |		КОГДА ЕСТЬNULL(Котировки_Bloomberg_BGN.CLOSE, 0) > 0
		   |			ТОГДА Котировки_Bloomberg_BGN.Биржа.ЮрФизЛицо
		   |		КОГДА ЕСТЬNULL(Котировки_Bloomberg_BVAL.CLOSE, 0) > 0
		   |			ТОГДА Котировки_Bloomberg_BVAL.Биржа.ЮрФизЛицо
		   |		ИНАЧЕ 0
		   |	КОНЕЦ КАК ИсточникКотировки,
		   |	ЕСТЬNULL(ЦеныММВБ_1Уровень.АктивныйВнебиржевойРынок, ИСТИНА) КАК АктивныйВнебиржевойРынок
		   |ПОМЕСТИТЬ НРД_Уровень2
		   |ИЗ
		   |	ТаблицаЦБ КАК ТаблицаЦБ
		   |		ЛЕВОЕ СОЕДИНЕНИЕ ЦеныММВБ_1Уровень КАК ЦеныММВБ_1Уровень
		   |		ПО ТаблицаЦБ.Рынок = ЦеныММВБ_1Уровень.Рынок
		   |			И ТаблицаЦБ.ЦеннаяБумага = ЦеныММВБ_1Уровень.ЦеннаяБумага
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД.СрезПоследних(
		   |				&ДатаПереоценки,
		   |				ЦеннаяБумага В
		   |					(ВЫБРАТЬ
		   |						ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		   |					ИЗ
		   |						ТаблицаЦБ КАК ТаблицаЦБ)) КАК РасчетныеЦеныНРДСрезПоследних
		   |		ПО ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныНРДСрезПоследних.ЦеннаяБумага
		   |		ЛЕВОЕ СОЕДИНЕНИЕ АктивныйРынокММВБ10Дней КАК АктивныйРынокММВБ10Дней
		   |		ПО ТаблицаЦБ.ЦеннаяБумага = АктивныйРынокММВБ10Дней.ЦеннаяБумага
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(
		   |				&ДатаПереоценки,
		   |				ЦеннаяБумага В
		   |					(ВЫБРАТЬ
		   |						ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		   |					ИЗ
		   |						ТаблицаЦБ КАК ТаблицаЦБ)) КАК РасчетныеЦеныПаевСрезПоследних
		   |		ПО ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК Котировки_Bloomberg_BGN
		   |		ПО ТаблицаЦБ.ЦеннаяБумага = Котировки_Bloomberg_BGN.ЦеннаяБумага
		   |			И (Котировки_Bloomberg_BGN.Период = &ПоследняяДатаТорговБлумберга)
		   |			И (Котировки_Bloomberg_BGN.Биржа = &Блумберг)
		   |			И (Котировки_Bloomberg_BGN.РежимТоргов = &Режим_BGN)
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК Котировки_Bloomberg_BVAL
		   |		ПО ТаблицаЦБ.ЦеннаяБумага = Котировки_Bloomberg_BVAL.ЦеннаяБумага
		   |			И (Котировки_Bloomberg_BVAL.Период = &ПоследняяДатаТорговБлумберга)
		   |			И (Котировки_Bloomberg_BVAL.Биржа = &Блумберг)
		   |			И (Котировки_Bloomberg_BVAL.РежимТоргов = &Режим_BVAL)
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаПереоценки, ) КАК РеквизитыПИФСрезПоследних
		   |		ПО (ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		   |;
		   |
		   |////////////////////////////////////////////////////////////////////////////////
		   |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		   |	НРД_Уровень2.ЦеннаяБумага КАК ЦеннаяБумага,
		   |	НРД_Уровень2.Рынок КАК Рынок,
		   |	НРД_Уровень2.Номинал КАК Номинал,
		   |	НРД_Уровень2.ВалютаНоминала КАК ВалютаНоминала,
		   |	НРД_Уровень2.ВалютаКотировки КАК ВалютаКупона,		   
		   |	НРД_Уровень2.ПолеКотировки КАК ВидЦены,
		   |	НРД_Уровень2.ДатаКотировки КАК ДатаЦены,
		   |	НРД_Уровень2.УровеньОценки КАК УровеньОценки,
		   |	НРД_Уровень2.ВалютаКотировки КАК ВалютаКотировки,
		   |	НРД_Уровень2.СправедливаяЦена КАК Стоимость,
		   |	ЕСТЬNULL(Биржи.Ссылка, ЗНАЧЕНИЕ(Справочник.Биржи.ПустаяСсылка)) КАК Биржа,
		   |	НРД_Уровень2.ИсточникКотировки КАК Источник,
		   |	НРД_Уровень2.АктивныйВнебиржевойРынок КАК АктивныйВнебиржевойРынок
		   |ИЗ
		   |	НРД_Уровень2 КАК НРД_Уровень2
		   |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
		   |		ПО НРД_Уровень2.ИсточникКотировки = Биржи.ЮрФизЛицо";
		
	Блумберг						= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
	ИностранныеУчетныеАктивы		= Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();	
	ПоследняяДатаТорговБлумберга	= РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки, Блумберг);	
	//ПоследняяДатаТоргов			= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки)-1);
	ПоследняяДатаТоргов				= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки));
	ПоследнийРабочийДень			= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский,НачалоДня(ДатаПереоценки));
	//ТорговыхДнейНазад90			= Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -90);
	ТорговыхДнейНазад10				= Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ДатаПереоценки), -10);
	
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("Организация",					ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ПараметрыОценки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ",				ТаблицаЦБ);
	
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",			ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10",			ТорговыхДнейНазад10);
	Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберга",	ПоследняяДатаТорговБлумберга);
	
	Запрос.УстановитьПараметр("ММВБ",		ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("НРД",		ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	Запрос.УстановитьПараметр("Блумберг",	Блумберг);
	Запрос.УстановитьПараметр("Режим_BGN",	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL",	ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));

	Запрос.УстановитьПараметр("ИностранныеУчетныеАктивы",	ИностранныеУчетныеАктивы);
	Запрос.УстановитьПараметр("Рубли",						ПараметрыОценки.Организация.ВалютаУчета);
	
	// Настройки методики
	Запрос.УстановитьПараметр("БратьЦеныНРДВПроцентах", ДатаПереоценки >= '20190715');
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Ливанов 2018 (ЕПС)", "Таблица стоимостей ЦБ");		
	Иначе
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	// Расчетные цены
	
	ПараметрыОценки.Вставить("ТочностьСтавкиДисконтирования", 2);
	
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
	
	Для Каждого СтрокаТаблицыСтоимостей из ТаблицаСтоимостейЦБ Цикл
		
		Если СтрокаТаблицыСтоимостей.Стоимость = 0 Тогда
			
			// 2.с - только для долговых российских бумаг. Для иностранных ЦБ пропускается. 
			// зачем тут условие про АктивныйВнебиржевойРынок - не помню, пусть будет пока
			
			Если СтрокаТаблицыСтоимостей.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И СтрокаТаблицыСтоимостей.АктивныйВнебиржевойРынок Тогда
				
				Если ИностранныеУчетныеАктивы.Найти(СтрокаТаблицыСтоимостей.ЦеннаяБумага.УчетныйАктивЦБРФ) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				ЗаполнитьДисконтированнойПоБезрисковойСтавкеДоходностиСтоимостью(СтрокаТаблицыСтоимостей, ПараметрыОценки, ДатаПереоценки, ПараметрыДенежногоПотока, Истина, 2, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, 4, Отказ, РасшифровкаРасчета);	
					
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныХантыМансийского(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ММВБКотировкиТорговыхПлощадокСводныеСрезПоследних.Рынок КАК Рынок,
		|	ЕСТЬNULL(ММВБКотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2, 0) КАК MARKETPRICE2,
		|	ЕСТЬNULL(ММВБКотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE, 0) КАК MARKETPRICE2_DATE,
		|	ЕСТЬNULL(Котировки_Bloomberg_BGN.CLOSE, 0) КАК CLOSE,
		|	ЕСТЬNULL(Котировки_Bloomberg_BGN.CLOSE_DATE, 0) КАК CLOSE_DATE,
		|	ЕСТЬNULL(Котировки_Bloomberg_BVAL.CLOSE, 0) КАК ADMITTEDQUOTE,
		|	ЕСТЬNULL(Котировки_Bloomberg_BVAL.CLOSE_DATE, 0) КАК ADMITTEDQUOTE_DATE,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ММВБКотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2, 0) > 0
		|			ТОГДА ВЫБОР
		|					КОГДА ММВБКотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE = &ПоследнийТорговыйДень
		|						ТОГДА ММВБКотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2
		|					ИНАЧЕ 0
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Стоимость,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ММВБКотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2, 0) > 0
		|			ТОГДА ВЫБОР
		|					КОГДА ММВБКотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE = &ПоследнийТорговыйДень
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.источникиЦеныДляПереоценки.РыночнаяЦена2)
		|					ИНАЧЕ 0
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ВидЦены,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ММВБКотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2, 0) > 0
		|			ТОГДА ВЫБОР
		|					КОГДА ММВБКотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE = &ПоследнийТорговыйДень
		|						ТОГДА 1
		|					ИНАЧЕ 0
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УровеньОценки,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ММВБКотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2, 0) > 0
		|			ТОГДА ВЫБОР
		|					КОГДА ММВБКотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE = &ПоследнийТорговыйДень
		|						ТОГДА ММВБКотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE
		|					ИНАЧЕ 0
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ДатаЦены,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ММВБКотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2, 0) > 0
		|			ТОГДА ВЫБОР
		|					КОГДА ММВБКотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE = &ПоследнийТорговыйДень
		|						ТОГДА ММВБКотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа.ЮрФизЛицо
		|					ИНАЧЕ 0
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Источник,
		|	ЕСТЬNULL(Котировки_Bloomberg_BGN.LISTNAME, 0) КАК LISTNAME,
		|	ЕСТЬNULL(Котировки_Bloomberg_BGN.LISTNAME_DATE, 0) КАК LISTNAME_DATE,
		|	ЕСТЬNULL(РасчетныеЦеныНРДСрезПоследних.Период, ДАТАВРЕМЯ(1890, 1, 1)) КАК НРД_Период,
		|	ЕСТЬNULL(РасчетныеЦеныНРДСрезПоследних.PRICE, 0) КАК НРД_PRICE,
		|	ЕСТЬNULL(РасчетныеЦеныНРДСрезПоследних.RATE, 0) КАК НРД_RATE
		|ПОМЕСТИТЬ АктивныйРынокММВБ90Дней
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|				&ПоследнийТорговыйДень,
		|				РежимТоргов.ОсновнойРежим
		|					И Биржа = &ММВБ) КАК ММВБКотировкиТорговыхПлощадокСводныеСрезПоследних
		|		ПО ТаблицаЦБ.Рынок = ММВБКотировкиТорговыхПлощадокСводныеСрезПоследних.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = ММВБКотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|				&ПоследнийТорговыйДень,
		|				Биржа = &Блумберг
		|					И РежимТоргов = &Режим_BGN) КАК Котировки_Bloomberg_BGN
		|		ПО ТаблицаЦБ.Рынок = Котировки_Bloomberg_BGN.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = Котировки_Bloomberg_BGN.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|				&ПоследнийТорговыйДень,
		|				Биржа = &Блумберг
		|					И РежимТоргов = &Режим_BVAL) КАК Котировки_Bloomberg_BVAL
		|		ПО ТаблицаЦБ.Рынок = Котировки_Bloomberg_BVAL.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = Котировки_Bloomberg_BVAL.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД.СрезПоследних(&ПоследнийТорговыйДень, ) КАК РасчетныеЦеныНРДСрезПоследних
		|		ПО ТаблицаЦБ.Рынок = РасчетныеЦеныНРДСрезПоследних.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = РасчетныеЦеныНРДСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АктивныйРынокММВБ90Дней.ЦеннаяБумага КАК ЦеннаяБумага,
		|	АктивныйРынокММВБ90Дней.Номинал КАК Номинал,
		|	АктивныйРынокММВБ90Дней.Рынок КАК Рынок,
		|	ВЫБОР
		|		КОГДА АктивныйРынокММВБ90Дней.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА АктивныйРынокММВБ90Дней.Стоимость * АктивныйРынокММВБ90Дней.Номинал / 100
		|		ИНАЧЕ АктивныйРынокММВБ90Дней.Стоимость
		|	КОНЕЦ КАК Стоимость,
		|	АктивныйРынокММВБ90Дней.ВидЦены КАК ВидЦены,
		|	АктивныйРынокММВБ90Дней.УровеньОценки КАК УровеньОценки,
		|	АктивныйРынокММВБ90Дней.ДатаЦены КАК ДатаЦены,
		|	АктивныйРынокММВБ90Дней.Источник КАК Источник,
		|	АктивныйРынокММВБ90Дней.CLOSE КАК CLOSE,
		|	АктивныйРынокММВБ90Дней.CLOSE_DATE КАК CLOSE_DATE,
		|	АктивныйРынокММВБ90Дней.ADMITTEDQUOTE КАК ADMITTEDQUOTE,
		|	АктивныйРынокММВБ90Дней.ADMITTEDQUOTE_DATE КАК ADMITTEDQUOTE_DATE,
		|	АктивныйРынокММВБ90Дней.LISTNAME КАК LISTNAME,
		|	АктивныйРынокММВБ90Дней.LISTNAME_DATE КАК LISTNAME_DATE,
		|	АктивныйРынокММВБ90Дней.MARKETPRICE2 КАК MARKETPRICE2,
		|	АктивныйРынокММВБ90Дней.MARKETPRICE2_DATE КАК MARKETPRICE2_DATE,
		|	АктивныйРынокММВБ90Дней.НРД_Период КАК НРД_Период,
		|	АктивныйРынокММВБ90Дней.НРД_PRICE КАК НРД_PRICE,
		|	АктивныйРынокММВБ90Дней.НРД_RATE КАК НРД_RATE
		|ИЗ
		|	АктивныйРынокММВБ90Дней КАК АктивныйРынокММВБ90Дней";
		
		
	ПоследнийТорговыйДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(), НачалоДня(ДатаПереоценки));
	ПоследнийРабочийДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоДня(ДатаПереоценки));
	
	ММВБ 		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	Блумберг 	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
	НРД 		= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");
	
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	Запрос.УстановитьПараметр("ММВБ", ММВБ);
	Запрос.УстановитьПараметр("Блумберг", Блумберг);
	Запрос.УстановитьПараметр("ПоследнийТорговыйДень", ПоследнийТорговыйДень);
	Запрос.УстановитьПараметр("Режим_BGN"	, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL"	, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ", ТаблицаЦБ);
	
	ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	
	ЭтоПН = ПараметрыОценки.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями;
	КлиентДУ = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ПараметрыОценки.СчетДоверительногоУправления, ДатаПереоценки);
	
	Для Каждого СтрокаТаблицыСтоимостейЦБ из ТаблицаСтоимостейЦБ Цикл
		
		Если СтрокаТаблицыСтоимостейЦБ.Стоимость <> 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицыСтоимостейЦБ.MARKETPRICE2>0 Тогда
			
			MARKETPRICE2Руб = ?(ТипЗнч(СтрокаТаблицыСтоимостейЦБ.Ценнаябумага) = Тип("СправочникСсылка.Облигации"),
				 СтрокаТаблицыСтоимостейЦБ.MARKETPRICE2 * СтрокаТаблицыСтоимостейЦБ.Номинал / 100,
				 СтрокаТаблицыСтоимостейЦБ.MARKETPRICE2);
				 
			Если СтрокаТаблицыСтоимостейЦБ.MARKETPRICE2_DATE >= ДобавитьМесяц(ДатаПереоценки, -3) Тогда

				Если ТипЗнч(СтрокаТаблицыСтоимостейЦБ.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации")
					И СтрокаТаблицыСтоимостейЦБ.ЦеннаяБумага.ДатаПогашения <> '00010101'
					И СтрокаТаблицыСтоимостейЦБ.ЦеннаяБумага.ДатаПогашения <= ДатаПереоценки
				Тогда
				
					//Погашенные облигации нужно брать - по 100%
					 
					СтрокаТаблицыСтоимостейЦБ.Стоимость = СтрокаТаблицыСтоимостейЦБ.Номинал;
					СтрокаТаблицыСтоимостейЦБ.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.Погашена;
					 
				Иначе
					
					СтрокаТаблицыСтоимостейЦБ.Стоимость = РаботаСЦеннымиБумагами.ПолучитьРыночнуюЦену(СтрокаТаблицыСтоимостейЦБ.ЦеннаяБумага, 
						ДатаПереоценки, ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления, СтрокаТаблицыСтоимостейЦБ.MARKETPRICE2_DATE, 
						MARKETPRICE2Руб);
					
					СтрокаТаблицыСтоимостейЦБ.ВидЦены = ?(ЭтоПН, Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦенаДляПН, Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦенаДляПР);
					СтрокаТаблицыСтоимостейЦБ.УровеньОценки = 1;
					СтрокаТаблицыСтоимостейЦБ.ДатаЦены = ДатаПереоценки;
					СтрокаТаблицыСтоимостейЦБ.Источник = ММВБ.ЮрФизЛицо;
					
				КонецЕсли;

			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрокаТаблицыСтоимостейЦБ.Стоимость = 0 И СтрокаТаблицыСтоимостейЦБ.ADMITTEDQUOTE <> 0 Тогда //для необращающихся на организованном рынке 
			
			Если СтрокаТаблицыСтоимостейЦБ.LISTNAME_DATE <> ПоследнийРабочийДень Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен BVAL Score за " + Формат(ПоследнийРабочийДень, "ДФ=dd.MM.yyyy") + " для " + СтрокаТаблицыСтоимостейЦБ.ЦеннаяБумага);
				Продолжить;
			КонецЕсли;
			
			Если СтрокаТаблицыСтоимостейЦБ.CLOSE_DATE <= СтрокаТаблицыСтоимостейЦБ.ADMITTEDQUOTE_DATE 
				И СтрокаТаблицыСтоимостейЦБ.CLOSE_DATE>=ДобавитьМесяц(ДатаПереоценки, -3)
				И СтрокаТаблицыСтоимостейЦБ.LISTNAME >= 7 Тогда
				
				СтрокаТаблицыСтоимостейЦБ.УровеньОценки = 1;
				СтрокаТаблицыСтоимостейЦБ.Источник = Блумберг.ЮрФизЛицо;
				СтрокаТаблицыСтоимостейЦБ.Стоимость = ?(ТипЗнч(СтрокаТаблицыСтоимостейЦБ.Ценнаябумага) = Тип("СправочникСсылка.Облигации"),
				 СтрокаТаблицыСтоимостейЦБ.CLOSE * СтрокаТаблицыСтоимостейЦБ.Номинал / 100,
				 СтрокаТаблицыСтоимостейЦБ.CLOSE);

				СтрокаТаблицыСтоимостейЦБ.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.СредняяЦенаЗакрытия;
				СтрокаТаблицыСтоимостейЦБ.ДатаЦены = СтрокаТаблицыСтоимостейЦБ.CLOSE_DATE;
				
			ИначеЕсли СтрокаТаблицыСтоимостейЦБ.CLOSE_DATE > СтрокаТаблицыСтоимостейЦБ.ADMITTEDQUOTE_DATE 
				И СтрокаТаблицыСтоимостейЦБ.ADMITTEDQUOTE_DATE>=ДобавитьМесяц(ДатаПереоценки, -3) 
				И СтрокаТаблицыСтоимостейЦБ.LISTNAME >= 7 Тогда
				
				СтрокаТаблицыСтоимостейЦБ.УровеньОценки = 1;
				СтрокаТаблицыСтоимостейЦБ.Источник = Блумберг.ЮрФизЛицо;
				СтрокаТаблицыСтоимостейЦБ.Стоимость = ?(ТипЗнч(СтрокаТаблицыСтоимостейЦБ.Ценнаябумага) = Тип("СправочникСсылка.Облигации"),
				 СтрокаТаблицыСтоимостейЦБ.ADMITTEDQUOTE * СтрокаТаблицыСтоимостейЦБ.Номинал / 100,
				 СтрокаТаблицыСтоимостейЦБ.ADMITTEDQUOTE);
				СтрокаТаблицыСтоимостейЦБ.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.СредневзвешеннаяЦена;
				СтрокаТаблицыСтоимостейЦБ.ДатаЦены = СтрокаТаблицыСтоимостейЦБ.ADMITTEDQUOTE_DATE;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрокаТаблицыСтоимостейЦБ.Стоимость = 0 И СтрокаТаблицыСтоимостейЦБ.НРД_Период >= ДобавитьМесяц(ДатаПереоценки, -3) Тогда
			Если СтрокаТаблицыСтоимостейЦБ.НРД_PRICE <>0 Тогда
				СтрокаТаблицыСтоимостейЦБ.Стоимость = СтрокаТаблицыСтоимостейЦБ.НРД_PRICE;
			Иначе
				СтрокаТаблицыСтоимостейЦБ.Стоимость = ?(ТипЗнч(СтрокаТаблицыСтоимостейЦБ.Ценнаябумага) = Тип("СправочникСсылка.Облигации"),
				 СтрокаТаблицыСтоимостейЦБ.НРД_RATE * СтрокаТаблицыСтоимостейЦБ.Номинал / 100,
				 СтрокаТаблицыСтоимостейЦБ.НРД_RATE);
			КонецЕсли;
			
			СтрокаТаблицыСтоимостейЦБ.УровеньОценки = 2;
			СтрокаТаблицыСтоимостейЦБ.Источник = НРД;
			СтрокаТаблицыСтоимостейЦБ.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД;
			СтрокаТаблицыСтоимостейЦБ.ДатаЦены = СтрокаТаблицыСтоимостейЦБ.НРД_Период;
			
		КонецЕсли;

	КонецЦикла;
	
	Возврат ТаблицаСтоимостейЦБ;
КонецФункции

Функция ПолучитьЦеныХантыМансийского2018(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	#Область Текст_запроса
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаСпискаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ЕСТЬNULL(Облигации.ДатаНачалаОбращения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаОбращения,
		|	ЕСТЬNULL(Облигации.ДатаНачалаРазмещения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаРазмещения
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал КАК Номинал,
		|	ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаЦБ.Рынок КАК Рынок
		|ПОМЕСТИТЬ АктивныйРынокММВБ10Дней
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО ТаблицаЦБ.Рынок = КотировкиТорговыхПлощадок.Рынок
		|			И ТаблицаЦБ.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
		|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта)
		|			И (КурсыВалют.Период = &ДатаПереоценки)
		|ГДЕ
		|	КотировкиТорговыхПлощадок.Период >= &ТорговыхДнейНазад10
		|	И КотировкиТорговыхПлощадок.Период <= &ДатаПереоценки
		|	И КотировкиТорговыхПлощадок.Биржа = &ММВБ
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал,
		|	ТаблицаЦБ.ВалютаНоминала,
		|	ТаблицаЦБ.Рынок
		|
		|ИМЕЮЩИЕ
		|	СУММА(КотировкиТорговыхПлощадок.VALUE * КурсыВалют.Курс / КурсыВалют.Кратность) >= 500000 И
		|	СУММА(КотировкиТорговыхПлощадок.NUMTRADES) >= 10
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Номинал КАК Номинал,
