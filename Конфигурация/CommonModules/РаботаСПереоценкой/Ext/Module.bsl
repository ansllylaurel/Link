		   |		ПО Блумберг_Уровень2.ИсточникКотировки = Биржи.ЮрФизЛицо");
	
	#КонецОбласти
	
	ММВБ		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	НРД			= ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД");
	Блумберг	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
	Режим_BGN	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN");
	
	ОсновнойКалендарьКотировок = Константы.ОсновнойКалендарьКотировок.Получить();
	
	ПоследняяДатаТоргов				= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки));
	ПоследняяДатаТорговБлумберга	= РегистрыСведений.КотировкиТорговыхПлощадок.ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки, Блумберг);	
	ТорговыхДнейНазад10				= Справочники.Календари.ДобавитьКДатеРабочиеДни(ОсновнойКалендарьКотировок, НачалоДня(ДатаПереоценки), -10);
	
	Запрос.УстановитьПараметр("ММВБ",		ММВБ);
	Запрос.УстановитьПараметр("НРД",		НРД);
	Запрос.УстановитьПараметр("Блумберг",	Блумберг);
	Запрос.УстановитьПараметр("Режим_BGN",	Режим_BGN);		
	
	Запрос.УстановитьПараметр("ДатаПереоценки",					ДатаПереоценки);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",			ПоследняяДатаТоргов);
	Запрос.УстановитьПараметр("ПоследняяДатаТорговБлумберга",	ПоследняяДатаТорговБлумберга);
	Запрос.УстановитьПараметр("ТорговыхДнейНазад10",			ТорговыхДнейНазад10);
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ",				ТаблицаЦБ);
	
	// Настройки методики	
	Запрос.УстановитьПараметр("БратьЦеныНРДВПроцентах", ДатаПереоценки >= '20190715');
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ТаблицаСтоимостейЦБ = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаСтоимостейЦБ = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить цены Волга-Капитал 2018 (ЕПС)", "Таблица стоимостей ЦБ");		
	КонецЕсли;
	
	ИностранныеЦенныеБумаги = Неопределено;
		
	ПараметрыОценки.Вставить("ТочностьСтавкиДисконтирования", 2);
	
	ПараметрыРасчетаРейтинга			= ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыРасчетаКредитногоСпреда	= ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
	ПараметрыДенежногоПотока			= ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, , Отказ);
					
	Для Каждого СтрокаТаблицыСтоимостей из ТаблицаСтоимостейЦБ Цикл
		
		Если СтрокаТаблицыСтоимостей.Стоимость = 0 Тогда
			
			Если СтрокаТаблицыСтоимостей.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				
				ЦеннаяБумага = СтрокаТаблицыСтоимостей.ЦеннаяБумага;
				
				Если ЗначениеЗаполнено(ЦеннаяБумага.ДатаПогашения) И ЦеннаяБумага.ДатаПогашения + 10 * 86400 <= ДатаПереоценки Тогда
					СтрокаТаблицыСтоимостей.Биржа = Справочники.Биржи.ПустаяСсылка();
					СтрокаТаблицыСтоимостей.Источник = Справочники.ЮрФизЛица.ПустаяСсылка();
					СтрокаТаблицыСтоимостей.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.Дефолт;
					СтрокаТаблицыСтоимостей.УровеньОценки = 1;
					СтрокаТаблицыСтоимостей.ДатаЦены = ЦеннаяБумага.ДатаПогашения + 10 * 86400;
					СтрокаТаблицыСтоимостей.Стоимость = 0;
					СтрокаТаблицыСтоимостей.ВалютаКотировки = ЦеннаяБумага.ВалютаНоминала;
					
					Если РасшифровкаРасчета <> Неопределено Тогда
						ПараметрыРасчетаЦен = Новый Структура("ДатаПогашенияПлюс10Дней, ДатаПереоценки", ЦеннаяБумага.ДатаПогашения + 10 * 86400, ДатаПереоценки);
						РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Получить цены Волга-Капитал 2018 (ЕПС)", "Параметры расчета цены", ПараметрыРасчетаЦен);
					КонецЕсли;
					
					Продолжить;
				КонецЕсли;
				
				Если ИностранныеЦенныеБумаги = Неопределено Тогда
					ИностранныеЦенныеБумаги = Справочники.КлассификаторУчетныхАктивовЦБРФ.ИностранныеУчетныеАктивы();
				КонецЕсли;
				
				Если ИностранныеЦенныеБумаги.Найти(ЦеннаяБумага.УчетныйАктивЦБРФ) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
							
				ЗаполнитьДисконтированнойПоБезрисковойСтавкеДоходностиСтоимостью(СтрокаТаблицыСтоимостей, ПараметрыОценки, ДатаПереоценки, ПараметрыДенежногоПотока, Истина, 3, ПараметрыРасчетаКредитногоСпреда, ПараметрыРасчетаРейтинга, 4, Отказ, РасшифровкаРасчета);
					
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если РасшифровкаРасчета <> Неопределено И ПараметрыРасчетаЦен <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Получить цены Волга-Капитал 2018 (ЕПС)", "С учетом параметров расчета цены", ТаблицаСтоимостейЦБ.Скопировать());
	КонецЕсли;	
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции

Функция ПолучитьЦеныОПК2018(ПараметрыОценки, ДатаПереоценки, ТаблицаЦБ, Отказ, РасшифровкаРасчета = Неопределено)
	
	#Область Текст_запроса	
	
	Запрос = Новый Запрос( 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСпискаЦБ.Рынок КАК Рынок,
		|	ТаблицаСпискаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	ТаблицаСпискаЦБ.ВалютаНоминала КАК ВалютаНоминала
		|ПОМЕСТИТЬ ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсходнаяТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала,
		|	ИсходнаяТаблицаЦБ.Рынок КАК Рынок,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	ЕСТЬNULL(Облигации.ДатаНачалаОбращения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаОбращения,
		|	ЕСТЬNULL(Облигации.ДатаНачалаРазмещения, НЕОПРЕДЕЛЕНО) КАК ДатаНачалаРазмещения,
		|	ЕСТЬNULL(Облигации.ДатаПогашения, НЕОПРЕДЕЛЕНО) КАК ДатаПогашения,
		|	ВЫБОР
		|		КОГДА ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ В (&ИностранныеУчетныеАктивы)
		|			ТОГДА ВЫБОР
		|					КОГДА ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|						ТОГДА ВЫБОР
		|								КОГДА ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|										ИЛИ ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗ)
		|										ИЛИ ИсходнаяТаблицаЦБ.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств)
		|										ИЛИ РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация)
		|									ТОГДА ИСТИНА
		|								ИНАЧЕ ЛОЖЬ
		|							КОНЕЦ
		|					ИНАЧЕ ЛОЖЬ
		|				КОНЕЦ
		|		КОГДА ИсходнаяТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|							ИЛИ ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗ)
		|						ТОГДА ИСТИНА
		|					ИНАЧЕ ЛОЖЬ
		|				КОНЕЦ
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК БиржевойРынокНеАктивен,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК ТоргуетсяНаММВБ
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаПереоценки,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (ВЫРАЗИТЬ(ИсходнаяТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
		|				&ДатаПереоценки,
		|				Биржа = &ММВБ
		|					И Статус = ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже)
		|					И ЦеннаяБумага В
		|						(ВЫБРАТЬ
		|							ИсходнаяТаблицаЦБ.ЦеннаяБумага
		|						ИЗ
		|							ИсходнаяТаблицаЦБ КАК ИсходнаяТаблицаЦБ)) КАК СтатусыЦенныхБумагСрезПоследних
		|		ПО ИсходнаяТаблицаЦБ.ЦеннаяБумага = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.Банкротство)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК Банкротство,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ИсполнениеОферты)
		|					И ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.НеисполнениеОферты)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК НеисполнениеОферты,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.КупонныеВыплаты)
		|					И ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ДефотПоКупону,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации)
		|					И ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт)
		|				ТОГДА ИСТИНА
		|			КОГДА ТаблицаЦБ.ДатаПогашения <> НЕОПРЕДЕЛЕНО
		|					И ТаблицаЦБ.ДатаПогашения <> ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА ВЫБОР
		|						КОГДА ТаблицаЦБ.ДатаПогашения < ДОБАВИТЬКДАТЕ(&ДатаПереоценки, ДЕНЬ, -7)
		|							ТОГДА ИСТИНА
		|						ИНАЧЕ ЛОЖЬ
		|					КОНЕЦ
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ДефолтПоТелу,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ТаблицаЦБ.УчетныйАктивЦБРФ В (&ИностранныеУчетныеАктивы)
		|				ТОГДА ВЫБОР
		|						КОГДА ТаблицаЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|							ТОГДА ВЫБОР
		|									КОГДА ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|											ИЛИ ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Подкатегория = ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ОВОЗ)
		|											ИЛИ ТаблицаЦБ.УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств)
		|											ИЛИ РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.МеждународнаяФинансоваяОрганизация)
		|										ТОГДА 2
		|									ИНАЧЕ 1
		|								КОНЕЦ
		|						ИНАЧЕ 1
		|					КОНЕЦ
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ВидЦеныБлумберга,
		|	ВЫРАЗИТЬ(ТаблицаЦБ.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо КАК ЮрФизЛицоЭмитента
		|ПОМЕСТИТЬ _Дефолты
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДефолтыПоОблигациям.СрезПоследних(
		|				&ДатаПереоценки,
		|				Облигация В
		|						(ВЫБРАТЬ
		|							ТаблицаЦБ.ЦеннаяБумага
		|						ИЗ
		|							ТаблицаЦБ КАК ТаблицаЦБ)
		|					И (ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.Банкротство)
		|						ИЛИ ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации)
