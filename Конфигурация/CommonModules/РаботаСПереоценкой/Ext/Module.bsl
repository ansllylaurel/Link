		Если Не РезультатЗапроса.Пустой() Тогда

			Если РасшифровкаРасчета <> Неопределено Тогда
				
				РаботаСКоллекциями.ДополнитьСтруктуру(
					ПараметрыРасчетаЦен, 
					Новый Структура(
						"Описание",
						"Цену размещения использовать нельзя, т.к. рынок уже был активным"), Истина);	
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Проверка отсутствия активного рынка", ПараметрыРасчетаЦен);
				
			КонецЕсли;

			Возврат Ложь;

		КонецЕсли;
		
		#КонецОбласти
		
	КонецЕсли;
		
	// С даты появления цен НРД справедливая стоимость определяется в общем порядке
	
	ПроверитьОтсутствиеЦенНРДСНачалаРазмещения = УсловияПрименения.Свойство("ОтсутствиеЦенНРДСНачалаРазмещения") И УсловияПрименения.ОтсутствиеЦенНРДСНачалаРазмещения;
	
	Если ПроверитьОтсутствиеЦенНРДСНачалаРазмещения Тогда
		
		#Область Проверка_отсутствия_цен_НРД_с_момента_размещения
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	РасчетныеЦеныНРД.Период КАК Период
			|ИЗ
			|	РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
			|ГДЕ
			|	РасчетныеЦеныНРД.ЦеннаяБумага = &ЦеннаяБумага
			|	И РасчетныеЦеныНРД.Рынок = &Рынок
			|	И РасчетныеЦеныНРД.Период МЕЖДУ &ДатаРазмещения И &ДатаПереоценки
			|	И РасчетныеЦеныНРД.PRICE > 0
			|
			|УПОРЯДОЧИТЬ ПО
			|	Период");
		
		Запрос.УстановитьПараметр("ЦеннаяБумага",	СтрокаПереоценкиЦБ.ЦеннаяБумага);
		Запрос.УстановитьПараметр("Рынок",			СтрокаПереоценкиЦБ.Рынок);
		Запрос.УстановитьПараметр("ДатаПереоценки",	ДатаПереоценки);
		Запрос.УстановитьПараметр("ДатаРазмещения",	ДатаРазмещения);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() Тогда

			Если РасшифровкаРасчета <> Неопределено Тогда
				СведенияОЦенеНРД = РезультатЗапроса.Выгрузить()[0];
				РаботаСКоллекциями.ДополнитьСтруктуру(ПараметрыРасчетаЦен, Новый Структура("ДатаПервойЦеныНРД, Описание",
					Формат(СведенияОЦенеНРД.Период, "ДФ=dd.MM.yyyy"), "Цену размещения использовать нельзя, т.к. НРД уже предоставляет цены"), Истина);	
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Проверка отсутствия цен НРД", ПараметрыРасчетаЦен);
			КонецЕсли;

			Возврат Ложь;

		КонецЕсли;		
		
		#КонецОбласти
		
	КонецЕсли;	
	
	// Получаем цену размещения
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Параметры оценки", ПараметрыРасчетаЦен, Истина);
	КонецЕсли;
	
	ЦенаРазмещения = ПолучитьЦенуРазмещения(СтрокаПереоценкиЦБ.ЦеннаяБумага, СвойстваСделки.Сделка, ДатаПереоценки, СвойстваСделки.Дата, ПараметрыЦены, РасшифровкаОперации);
	
	Если ЦенаРазмещения = Неопределено Тогда
		Если РасшифровкаРасчета <> Неопределено Тогда
			ПараметрыРасчетаЦен = Новый Структура("Описание", "Не удалось получить цену размещения");
			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Результат оценки по цене размещения", ПараметрыРасчетаЦен, Истина);
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;	
		
	СтрокаПереоценкиЦБ.Биржа				= ?(ЗначениеЗаполнено(СвойстваСделки.Биржа), СвойстваСделки.Биржа, Справочники.Биржи.ПустаяСсылка());
	СтрокаПереоценкиЦБ.ИсточникЦены			= Справочники.ЮрФизЛица.ПустаяСсылка();
	СтрокаПереоценкиЦБ.ПолеЦены				= Перечисления.ИсточникиЦеныДляПереоценки.ЦенаПриобретения;
	СтрокаПереоценкиЦБ.УровеньОценки		= 1;
	СтрокаПереоценкиЦБ.ДатаКотировки		= ЦенаРазмещения.ДатаКотировки;
	СтрокаПереоценкиЦБ.ЦенаКотировки		= ЦенаРазмещения.РыночнаяЦена;
	СтрокаПереоценкиЦБ.ВалютаКотировки		= ЦенаРазмещения.ВалютаКотировки;
	СтрокаПереоценкиЦБ.РыночнаяЦена			= ЦенаРазмещения.РыночнаяЦена;
	СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент	= ЦенаРазмещения.РыночнаяЦенаПроцент;
	
	Если ПараметрыЦены.Свойство("ЗаполнитьИсточникЦеныПоБирже") И ПараметрыЦены.ЗаполнитьИсточникЦеныПоБирже Тогда
		СтрокаПереоценкиЦБ.ИсточникЦены	= СтрокаПереоценкиЦБ.Биржа.ЮрФизЛицо;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(СтрокаПереоценкиЦБ, ПараметрыЦены);
	
	Возврат Истина;
	
КонецФункции

Процедура ЗаполнитьПервичноеРазмещениеСургутнефтегаза(СтрокаПереоценкиЦБ, ДатаПереоценки) Экспорт
	//первичное размещение если нет рынка
	Если СтрокаПереоценкиЦБ.РыночнаяЦена <> 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекСделка = СтрокаПереоценкиЦБ.Партия;
	Если ТипЗнч(ТекСделка) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
		ТекСделка = ТекСделка.Основание;
	КонецЕсли;
	Если ТипЗнч(ТекСделка) = Тип("ДокументСсылка.Сделка") И ТекСделка.ПервичноеРазмещение Тогда
		ТекЦБ = СтрокаПереоценкиЦБ.ЦеннаяБумага;
		Если ТипЗнч(ТекЦБ) = Тип("СправочникСсылка.Облигации") Тогда
			ДатаРазмещенияС  = ТекЦБ.ДатаНачалаРазмещения;
			ДатаРазмещенияПо = ТекЦБ.ДатаОкончанияРазмещения;
		ИначеЕсли ТипЗнч(ТекЦБ) = Тип("СправочникСсылка.Акции") Тогда
			ДатаРазмещенияС  = НачалоДня(ТекСделка.Дата);
			ДатаРазмещенияПо = ДатаРазмещенияС + 30*86400;//т.к. разъяснений не было, пока ставлю 30 дней от покупки. Отправила письмо Капашиловой 11.01.17.
		Иначе
			Возврат;
		КонецЕсли;
		Если ДатаРазмещенияПо > ДатаПереоценки Тогда
			Возврат;
		КонецЕсли;
		
		БиржаММВБ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КотировкиТорговыхПлощадокСводныеСрезПоследних.РежимТоргов КАК РежимТоргов,
			|	КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE КАК WAPRICE,
			|	КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE_DATE КАК WAPRICE_DATE,
			|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта КАК Валюта
			|ИЗ
			|	РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
			|			&ДатаПереоценки,
			|			Биржа = &ММВБ
			|				И Рынок = &Рынок
			|				И ЦеннаяБумага = &ЦеннаяБумага
			|				И РежимТоргов.ОсновнойРежим) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних";
		Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
		Запрос.УстановитьПараметр("ММВБ", БиржаММВБ);
		Запрос.УстановитьПараметр("ЦеннаяБумага", СтрокаПереоценкиЦБ.ЦеннаяБумага);
		Запрос.УстановитьПараметр("Рынок", СтрокаПереоценкиЦБ.Рынок);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			Возврат;
		КонецЕсли;
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Сердневзвешенная = ВыборкаДетальныеЗаписи.WAPRICE;
			
			СтрокаПереоценкиЦБ.Биржа				= БиржаММВБ;
			СтрокаПереоценкиЦБ.ИсточникЦены			= БиржаММВБ.ЮрФизЛицо;
			СтрокаПереоценкиЦБ.ПолеЦены 			= Перечисления.ИсточникиЦеныДляПереоценки.СредневзвешеннаяЦена;
			СтрокаПереоценкиЦБ.ДатаКотировки 		= ВыборкаДетальныеЗаписи.WAPRICE_DATE;
			
			Если ТипЗнч(ТекЦБ)=Тип("СправочникСсылка.Облигации") Тогда
				СтрокаПереоценкиЦБ.РыночнаяЦенаПроцент  = Сердневзвешенная;
				СтрокаПереоценкиЦБ.РыночнаяЦена  = Сердневзвешенная * СтрокаПереоценкиЦБ.Номинал / 100;
			Иначе 
				СтрокаПереоценкиЦБ.РыночнаяЦена  = Сердневзвешенная;
			КонецЕсли;
			СтрокаПереоценкиЦБ.ЦенаКотировки  	= СтрокаПереоценкиЦБ.РыночнаяЦена;
			СтрокаПереоценкиЦБ.ВалютаКотировки  = ВыборкаДетальныеЗаписи.Валюта;
			
			Прервать;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

