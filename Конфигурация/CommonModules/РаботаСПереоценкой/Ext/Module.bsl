		|	ЕСТЬNULL(КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE2_DATE, ДАТАВРЕМЯ(1890, 1, 1, 0, 0, 0)) КАК СводныеКотировки_MARKETPRICE2_DATE,
		|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК Торгуется,
