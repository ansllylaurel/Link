Процедура ПолучитьЦенныеБумагиДляЕПС(ОбъектДокумента, МенеджерВременныхТаблиц, ИмяТаблицы, ПолучитьОстаткиНа, РасшифровкаРасчета = Неопределено)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
		|	БухПартииЦенныхБумагОстатки.СуммаРезервовПодОбесценениеОстаток КАК СуммаРезервовПодОбесценение
		|ПОМЕСТИТЬ #ИмяТаблицы#
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета
		|				И &ФильтрПоЦеннойБумаге) КАК БухПартииЦенныхБумагОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ЦеннаяБумага,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.Рынок,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.КоличествоОстаток,
		|	0
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета
		|				И &ФильтрПоЦеннойБумаге) КАК БухПартииЦенныхБумагКупленныеПоРЕПООстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	БухПартииЦенныхБумагКПолучениюОстатки.ЦеннаяБумага,
		|	БухПартииЦенныхБумагКПолучениюОстатки.Рынок,
		|	БухПартииЦенныхБумагКПолучениюОстатки.КоличествоОстаток,
		|	0
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумагКПолучению.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета
		|				И &ФильтрПоЦеннойБумаге) КАК БухПартииЦенныхБумагКПолучениюОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.ЦеннаяБумага,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.Рынок,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.КоличествоОстаток,
		|	0
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумагПроданныеВРепо.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета
		|				И &ФильтрПоЦеннойБумаге) КАК БухПартииЦенныхБумагПроданныеВРепоОстатки";
	
	ЗаполнитьФильтрПоЦеннойБумагеВЗапросе(Запрос, ОбъектДокумента, РасшифровкаРасчета);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ИмяТаблицы#", ИмяТаблицы);
	
	Запрос.УстановитьПараметр("Период",                       	ПолучитьОстаткиНа);
	Запрос.УстановитьПараметр("Организация",                  	ОбъектДокумента.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ОбъектДокумента.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета", 						ОбъектДокумента.ВидУчета);
	
	РезультатЗапроса = Запрос.Выполнить();

КонецПроцедуры

Функция ДинамическийРасчетПартий(ПараметрыДинамическогоРасчетаПартий, ДинамическийРасчет = Истина) Экспорт

	Отказ = Ложь;
	
	РасчетПартий = Обработки.РасчетПартий.Создать();
	
	РасчетПартий.Организация                  = ПараметрыДинамическогоРасчетаПартий.Организация;
	РасчетПартий.СчетДоверительногоУправления = ПараметрыДинамическогоРасчетаПартий.СчетДоверительногоУправления;
	РасчетПартий.ВидУчета                     = ПараметрыДинамическогоРасчетаПартий.ВидУчета;
	РасчетПартий.НачалоПериода                = ПараметрыДинамическогоРасчетаПартий.НачалоПериода;
	РасчетПартий.КонецПериода                 = ПараметрыДинамическогоРасчетаПартий.КонецПериода;
	РасчетПартий.ТаблицаПлановыхОпераций	  = ПараметрыДинамическогоРасчетаПартий.ТаблицаПлановыхОпераций;
	Если ПараметрыДинамическогоРасчетаПартий.КоличественныйРасчет Тогда
		РасчетПартий.ВариантРасчета			  = Перечисления.ВариантыРасчетаПартий.РасчетТолькоКоличества;
	Иначе
		РасчетПартий.ВариантРасчета			  = Перечисления.ВариантыРасчетаПартий.РасчетКоличестваДляБумагПоАССуммы;
	КонецЕсли;
	
	МассивСообщенийПользователю = ПолучитьСообщенияПользователю(Истина);
		
	РасчетПартий.РассчитатьПартии(Отказ, ПараметрыДинамическогоРасчетаПартий.НастройкиПоВидуУчета);
	
	СообщенияРасчетПартий = Неопределено;
	ТекстСообщенийПользователю = ОбщегоНазначения.ПолучитьТекстСообщенийПользователю(Символы.ПС, Истина, СообщенияРасчетПартий);
	
	ОбщегоНазначения.ВывестиСообщенияПользователю(МассивСообщенийПользователю);
	ОбщегоНазначения.ВывестиСообщенияПользователю(СообщенияРасчетПартий);
	
	Если Отказ Тогда
		
		ТекстОшибки = "Ошибка получения ценных бумаг при динамическом расчете партий" + ?(ПустаяСтрока(ТекстСообщенийПользователю), "", Символы.ПС + ТекстСообщенийПользователю);
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	ОбъектДокумента = ПараметрыДинамическогоРасчетаПартий.ОбъектДокумента;
	
	Если РаботаСПользователями.ЭтоПолноправныйПользователь() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведен динамический расчет партий по '" + ОбъектДокумента.СчетДоверительногоУправления + "' за период с " + РасчетПартий.НачалоПериода + " по " + РасчетПартий.КонецПериода, ОбъектДокумента);
	КонецЕсли;

	Возврат РасчетПартий;
	
КонецФункции

Процедура ЗаполнитьФильтрПоЦеннойБумагеВЗапросе(Запрос, ПараметрыОценки, РасшифровкаРасчета = Неопределено)
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрПоЦеннойБумаге", "ЦеннаяБумага = &ФильтрПоЦеннойБумаге");
		Запрос.УстановитьПараметр("ФильтрПоЦеннойБумаге", РасшифровкаРасчета.ЦеннаяБумага);
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ПолеСуществует(ПараметрыОценки, "ДополнительныеСвойства")
		И ПараметрыОценки.ДополнительныеСвойства.Свойство("ФильтрПоЦеннойБумаге")
	Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрПоЦеннойБумаге", "ЦеннаяБумага В (&ФильтрПоЦеннойБумаге)");
		Запрос.УстановитьПараметр("ФильтрПоЦеннойБумаге", ПараметрыОценки.ДополнительныеСвойства.ФильтрПоЦеннойБумаге);
	Иначе
		Запрос.УстановитьПараметр("ФильтрПоЦеннойБумаге", Истина);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Поиск_аналогичных_ценных_бумаг

Процедура ПодобратьАналогиЦеннойБумаги(СтрокаПереоценкиЦБ, ПараметрыОценки, ДатаПереоценки, Отказ, РасшифровкаРасчета = Неопределено)
	
	// Получаем таблицу анализируемых ценных бумаг	
	
	ТаблицаЦБ = Новый ТаблицаЗначений;
	ТаблицаЦБ.Колонки.Добавить("ЦеннаяБумага",	Метаданные.РегистрыСведений.СтоимостьПереоценки.Измерения.ЦеннаяБумага.Тип);
	ТаблицаЦБ.Колонки.Добавить("Рынок", 		Метаданные.РегистрыСведений.СтоимостьПереоценки.Измерения.Рынок.Тип);
	ТаблицаЦБ.Колонки.Добавить("Биржа", 		Новый ОписаниеТипов("СправочникСсылка.Биржи"));
	
	СтрокаЦБ = ТаблицаЦБ.Добавить();
	СтрокаЦБ.ЦеннаяБумага	= СтрокаПереоценкиЦБ.ЦеннаяБумага;
	СтрокаЦБ.Рынок			= СтрокаПереоценкиЦБ.Рынок;
	СтрокаЦБ.Биржа			= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");	
	
	// Добавляем блокировку, чтобы никто одновременно с нами не регистрировал аналоги
	
	НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
	
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.АналогиЦенныхБумаг");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Организация",		ПараметрыОценки.Организация);
	ЭлементБлокировки.УстановитьЗначение("Клиент",			ПараметрыОценки.Клиент);
	ЭлементБлокировки.УстановитьЗначение("ЦеннаяБумага",	СтрокаПереоценкиЦБ.ЦеннаяБумага);
	БлокировкаДанных.Заблокировать();
		
	// Выполняем поиск аналогов
	
	ПараметрыПоиска = РаботаСПереоценкой.ПолучитьПараметрыПоискаАналогичныхБумаг(ПараметрыОценки, ДатаПереоценки);
		
	ПодобранныеАналоги = РаботаСПереоценкой.НайтиАналогичныеЦенныеБумаги(ТаблицаЦБ, ПараметрыОценки, ДатаПереоценки, ПараметрыПоиска, , РасшифровкаРасчета); 
	
	Если ПодобранныеАналоги.Количество() = 0 Тогда
		ЗафиксироватьТранзакцию();
		Возврат;
	КонецЕсли;
	
	// Выполняем регистрацию подобранных аналогов
	
	ТекстОшибкиРегистрацииАналогов = СтрШаблон("Ошибка регистрации аналогичных ценных бумаг '%1' на %2 для клиента '%3'",
		СтрокаПереоценкиЦБ.ЦеннаяБумага, Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy"), ПараметрыОценки.Клиент);
	
	Попытка
		
		РегистрацияАналогов = Документы.РегистрацияПредоставленныхКлиентомСведенийОЦенныхБумагах.СоздатьДокумент();
		РегистрацияАналогов.Дата				= РаботаСДокументами.ПолучитьВремяДокумента(ДатаПереоценки, РегистрацияАналогов.Ссылка);
		РегистрацияАналогов.Организация			= ПараметрыОценки.Организация;
		РегистрацияАналогов.Клиент				= ПараметрыОценки.Клиент;
		РегистрацияАналогов.ЦеннаяБумага		= СтрокаПереоценкиЦБ.ЦеннаяБумага;
		РегистрацияАналогов.ДатаНачалаДействия	= ДатаПереоценки;
		РегистрацияАналогов.Ответственный		= РаботаСПользователями.ТекущийПользователь();
		
		Для Каждого ОписаниеАналога Из ПодобранныеАналоги Цикл
			СтрокаАналога = РегистрацияАналогов.Аналоги.Добавить();
			СтрокаАналога.ЦеннаяБумага			= ОписаниеАналога.Аналог;
			СтрокаАналога.ДатаОкончанияДействия	= ДатаПереоценки;
		КонецЦикла;
		
		РегистрацияАналогов.Записать(РежимЗаписиДокумента.Проведение);
		
	Исключение
		
		ОтменитьТранзакцию();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиРегистрацииАналогов + ":" + Символы.ПС + ОписаниеОшибки(), , , , Отказ);
		Возврат;
		
	КонецПопытки;
		
	ЗафиксироватьТранзакцию();
		
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		СтрШаблон("Зарегистрированы аналогичные ценные бумаги '%1' на %2 для клиента '%3'", СтрокаПереоценкиЦБ.ЦеннаяБумага, Формат(ДатаПереоценки, "ДФ=dd.MM.yyyy"), ПараметрыОценки.Клиент), РегистрацияАналогов);
	
	// Удаляем ранее полученные аналоги, т.к. после добавления новых они потеряли актуальность
	
	Если ПараметрыОценки.Свойство("ПараметрыРасчетаСтоимостиПоАналогам") Тогда
		Если ПараметрыОценки.ПараметрыРасчетаСтоимостиПоАналогам.Свойство("КотировкиАналогов") Тогда
			ПараметрыОценки.ПараметрыРасчетаСтоимостиПоАналогам.Удалить("КотировкиАналогов");
		КонецЕсли;
	КонецЕсли;
	
	// Запоминаем созданные документы
	
	Если ПараметрыОценки.Свойство("ДополнительныеСвойства") И ТипЗнч(ПараметрыОценки.ДополнительныеСвойства) = Тип("Структура") Тогда
		
		ДополнительныеСвойства = ПараметрыОценки.ДополнительныеСвойства;
		
		Если Не ДополнительныеСвойства.Свойство("СозданныеДокументы") Тогда
			ДополнительныеСвойства.Вставить("СозданныеДокументы", Новый Массив);	
		КонецЕсли;
		
		ДополнительныеСвойства.СозданныеДокументы.Добавить(РегистрацияАналогов);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПараметрыПоискаАналогичныхБумаг(ПараметрыОценки, ДатаПереоценки) Экспорт
	
	ПараметрыПоиска = Новый Структура;
	
	// Параметры расчета рейтинга
	
	РейтинговыеАгентства = Новый СписокЗначений;
	РейтинговыеАгентства.Добавить(Справочники.РейтинговыеАгентства.StandardAndPoors);
	РейтинговыеАгентства.Добавить(Справочники.РейтинговыеАгентства.FitchRatings);
	РейтинговыеАгентства.Добавить(Справочники.РейтинговыеАгентства.Moodys);
	
	Если ПараметрыОценки.ВариантРасчетаСправедливойСтоимости <> Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2020 ИЛИ ДатаПереоценки >= '20230401' Тогда
		РейтинговыеАгентства.Добавить(Справочники.РейтинговыеАгентства.RAEX);
		РейтинговыеАгентства.Добавить(Справочники.РейтинговыеАгентства.АКРА);
	КонецЕсли;	
	
	Если ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020_2 И ДатаПереоценки >= '20230401'
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Аквилон2021 И ДатаПереоценки >= '20230401'
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2020 И ДатаПереоценки >= '20230401'
	Тогда
		РейтинговыеАгентства.Добавить(Справочники.РейтинговыеАгентства.НКР);
		РейтинговыеАгентства.Добавить(Справочники.РейтинговыеАгентства.НРА);
	КонецЕсли;
	
	ПараметрыРасчетаРейтинга = Новый Структура;
	ПараметрыРасчетаРейтинга.Вставить("РейтинговыеАгентства", РейтинговыеАгентства);
	ПараметрыРасчетаРейтинга.Вставить("УчитыватьВидРейтинга", Истина);
	
	Если ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020_2 Тогда
		
		ПараметрыРасчетаРейтинга.Вставить("ТолькоНаблюдаемыеДанные",				Истина);
		ПараметрыРасчетаРейтинга.Вставить("ИсточникТаблицыСоответствияРейтингов",	Справочники.ВнешниеСистемы.Национальный);	
		
	ИначеЕсли ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Аквилон2021 И ДатаПереоценки >= '20230401'
		ИЛИ ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2020 И ДатаПереоценки >= '20230401'
	Тогда
		
		ПараметрыРасчетаРейтинга.Вставить("ИсточникТаблицыСоответствияРейтингов",			Справочники.ВнешниеСистемы.Будущее);
		ПараметрыРасчетаРейтинга.Вставить("ПриоритетРоссийскихАгентствПередИностранными",	Истина);
		
	Иначе
		
		ПараметрыРасчетаРейтинга.Вставить("ТолькоНаблюдаемыеДанные",				Ложь);
		ПараметрыРасчетаРейтинга.Вставить("ИсточникТаблицыСоответствияРейтингов",	Справочники.ВнешниеСистемы.Газфонд);
		
	КонецЕсли;
	
	Если ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020_2 И ДатаПереоценки >= '20230401' Тогда
		ПараметрыРасчетаРейтинга.Вставить("РейтинговаяГруппаГосударственныхОблигаций", 1);	
	КонецЕсли;

	ПараметрыПоиска.Вставить("ПараметрыРасчетаРейтинга", ПараметрыРасчетаРейтинга);
	
	// Проверка объема сделок
	
	Если ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2020 Тогда
		ПараметрыПоиска.Вставить("ВариантПроверкиОбъемаСделокАналогов", ?(ДатаПереоценки >= '20230130', "ПоМетодикеТранснефть2023", "ПоМетодикеТранснефть2020"));
	КонецЕсли;
	
	Если ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2020 Тогда
		ПараметрыПоиска.Вставить("ГлубинаПроверкиОбъемаСделок", 1);
	Иначе
		ПараметрыПоиска.Вставить("ГлубинаПроверкиОбъемаСделок", 10);
	КонецЕсли;
	
	ПараметрыПоиска.Вставить("ПроверятьНаличиеСделокНаДатуРасчета", Истина);
	
	// Параметры сопоставления дюрации
	
	Если ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020_2 Тогда
		ПараметрыПоиска.Вставить("ВариантГруппировкиПоДюрации", "ПоОтклонению");
		ПараметрыПоиска.Вставить("ДопустимоеОтклонениеДюрации", 30);
	КонецЕсли;
	
	ПараметрыПоиска.Вставить("РассчитыватьДюрациюПриОтсутствииДанныхММВБ", Истина);
	
	// Прочее
	
	Если ПараметрыОценки.ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020_2 Тогда
		ПараметрыПоиска.Вставить("ГруппироватьПоОтраслям", Истина);
	КонецЕсли;
	
	ПараметрыПоиска.Вставить("МинимальноеКоличествоАналогов", 3);
	
	Возврат ПараметрыПоиска;
	
КонецФункции

Функция НайтиАналогичныеЦенныеБумаги(ЦенныеБумаги, ПараметрыОценки, Период, ПараметрыПоиска, МенеджерВременныхТаблиц = Неопределено, РасшифровкаРасчета = Неопределено) Экспорт
	
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли;	
	
	#Область Заполняем_параметры_поиска_аналогов_по_умолчанию
	
	Если Не ПараметрыПоиска.Свойство("ПараметрыРасчетаРейтинга") Тогда
		ПараметрыПоиска.Вставить("ПараметрыРасчетаРейтинга", Неопределено);		
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыПоиска.ПараметрыРасчетаРейтинга) = Тип("Структура")
		И ПараметрыПоиска.ПараметрыРасчетаРейтинга.Свойство("РейтинговаяГруппаГосударственныхОблигаций")
	Тогда
		РейтинговаяГруппаГосударственныхОблигаций = ПараметрыПоиска.ПараметрыРасчетаРейтинга.РейтинговаяГруппаГосударственныхОблигаций;
	Иначе
		РейтинговаяГруппаГосударственныхОблигаций = Неопределено;
	КонецЕсли;
	
	Если Не ПараметрыПоиска.Свойство("ГлубинаПроверкиОбъемаСделок") Тогда
		ПараметрыПоиска.Вставить("ГлубинаПроверкиОбъемаСделок", 10);		
	КонецЕсли;
	
	Если Не ПараметрыПоиска.Свойство("ВариантПроверкиОбъемаСделокАналогов") Тогда
		ПараметрыПоиска.Вставить("ВариантПроверкиОбъемаСделокАналогов", Неопределено);		
	КонецЕсли;
	
	Если Не ПараметрыПоиска.Свойство("ВариантГруппировкиПоДюрации") Тогда
		ПараметрыПоиска.Вставить("ВариантГруппировкиПоДюрации", Неопределено);		
	КонецЕсли;
	
	Если Не ПараметрыПоиска.Свойство("ДопустимоеОтклонениеДюрации") Тогда
		ПараметрыПоиска.Вставить("ДопустимоеОтклонениеДюрации", 0);		
	КонецЕсли;	
	
	Если Не ПараметрыПоиска.Свойство("ГруппироватьПоОтраслям") Тогда
		ПараметрыПоиска.Вставить("ГруппироватьПоОтраслям", Ложь);		
	КонецЕсли;
	
	Если Не ПараметрыПоиска.Свойство("РассчитыватьДюрациюПриОтсутствииДанныхММВБ") Тогда
		ПараметрыПоиска.Вставить("РассчитыватьДюрациюПриОтсутствииДанныхММВБ", Ложь);		
	КонецЕсли;
	
	Если Не ПараметрыПоиска.Свойство("ПроверятьНаличиеСделокНаДатуРасчета") Тогда
		ПараметрыПоиска.Вставить("ПроверятьНаличиеСделокНаДатуРасчета", Ложь);		
	КонецЕсли;	
	
	#КонецОбласти
	
	#Область Текст_запроса_аналогов
	
	ММВБ				= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	ВалютаРубли			= ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");
	ПоследняяДатаТоргов	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(), НачалоДня(Период));
	
	Дюрации = ПолучитьДюрацииПоДаннымБиржи(ЦенныеБумаги, Период, ММВБ, ПоследняяДатаТоргов);
	Для Каждого СтрокаДюрации Из Дюрации Цикл
		Если Не ЗначениеЗаполнено(СтрокаДюрации.Дюрация)
			И ПараметрыПоиска.РассчитыватьДюрациюПриОтсутствииДанныхММВБ	
		Тогда
			СтрокаДюрации.Дюрация = Справочники.Облигации.ПолучитьДоходностьИДюрацию(СтрокаДюрации.ЦеннаяБумага, Ложь, НачалоДня(Период), СтрокаДюрации.Номинал, , ММВБ).Дюрация; 
			СтрокаДюрации.РасчетноеЗначение = Истина;	
		КонецЕсли;
	КонецЦикла;	
	
	Запрос = Новый Запрос;  
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Период",										Период);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",						ПоследняяДатаТоргов);
	
	Запрос.УстановитьПараметр("РейтинговаяГруппаГосударственныхОблигаций",	РейтинговаяГруппаГосударственныхОблигаций);
	
	Запрос.УстановитьПараметр("ВариантПроверкиОбъемаСделокАналогов",		ПараметрыПоиска.ВариантПроверкиОбъемаСделокАналогов);
	Запрос.УстановитьПараметр("ПроверятьНаличиеСделокНаДатуРасчета",		ПараметрыПоиска.ПроверятьНаличиеСделокНаДатуРасчета);	
	
	Запрос.УстановитьПараметр("ВариантГруппировкиПоДюрации",				ПараметрыПоиска.ВариантГруппировкиПоДюрации);
	Запрос.УстановитьПараметр("ДопустимоеОтклонениеДюрации",				ПараметрыПоиска.ДопустимоеОтклонениеДюрации);
	Запрос.УстановитьПараметр("РассчитыватьДюрациюПриОтсутствииДанныхММВБ",	ПараметрыПоиска.РассчитыватьДюрациюПриОтсутствииДанныхММВБ);
	
	Запрос.УстановитьПараметр("ГруппироватьПоОтраслям",						ПараметрыПоиска.ГруппироватьПоОтраслям);
	
	Запрос.УстановитьПараметр("ММВБ",										ММВБ);	
	Запрос.УстановитьПараметр("ВалютаРубли",								ВалютаРубли);
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ЦенныеБумаги, "_АнализируемыеЦенныеБумаги", Запрос, , "ЦеннаяБумага, Рынок, Биржа"); 
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(Дюрации,		"_Дюрации",					  Запрос, , "ЦеннаяБумага, Дюрация, РасчетноеЗначение"); 
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Облигации.Ссылка КАК ЦеннаяБумага,
		|	ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации) КАК Рынок,
		|	Облигации.ВалютаНоминала КАК ВалютаНоминала,
		|	Облигации.Категория КАК Категория,
		|	Облигации.УчетныйАктивЦБРФ КАК УчетныйАктивЦБРФ,
		|	Эмитенты.ЮрФизЛицо КАК Эмитент,
		|	ЕСТЬNULL(КотировкиММВБ.DURATION, _Дюрации.Дюрация) КАК Дюрация,
		|	КотировкиММВБ.DURATION ЕСТЬ NULL
		|		И _Дюрации.РасчетноеЗначение КАК РасчетнаяДюрация
		|ПОМЕСТИТЬ _ВсеЦенныеБумаги
		|ИЗ
		|	Справочник.Облигации КАК Облигации
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|		ПО (Эмитенты.Ссылка = Облигации.Эмитент)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Дюрации КАК _Дюрации
		|		ПО (_Дюрации.ЦеннаяБумага = Облигации.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиММВБ
