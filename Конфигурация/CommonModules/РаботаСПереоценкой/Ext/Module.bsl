	Блумберг	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
	Режим_BGN	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN");
	Режим_BVAL	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL");	
	
	ДоступныДанныеБлумберг								 = ПроверитьДоступностьДанныхBloomberg(ДатаПереоценки);
	ОцениватьОВОЗРФиИностранныеБумагиПоБлумбергу		 = (ДоступныДанныеБлумберг И ДатаПереоценки < '20230701');
	ПриоритетРоссийскихПлощадокПередИностранными		 = ДатаПереоценки >= '20230901';
	ПриоритетРежимовТорговСРасчетамиВВалютеНоминала		 = ДатаПереоценки < '20230901';
	ПроверкаЦенРежимовТорговВПорядкеВыбораОсновногоРынка = ДатаПереоценки >= '20230901';
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ",				ТаблицаЦБ);	       
	
