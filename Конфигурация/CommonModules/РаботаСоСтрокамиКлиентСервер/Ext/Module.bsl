
// Формирует строку повторяющихся символов заданной длины.
//
// Параметры:
//  Символ      - Строка - символ, из которого будет формироваться строка.
//  ДлинаСтроки - Число  - требуемая длина результирующей РаботаСоСтрокамиКлиентСервер.
//
// Возвращаемое значение:
//  Строка - строка, состоящая из повторяющихся символов.
//
Функция СформироватьСтрокуСимволов(Знач Символ, Знач ДлинаСтроки) Экспорт
	
	Результат = "";
	
	Для Счетчик = 1 По ДлинаСтроки Цикл
		Результат = Результат + Символ;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ФормаМножественногоЧисла(Знач КоличествоОбъектов, ОдинОбъект, ДваОбъекта, ПятьОбъектов) Экспорт
	
	// Изменим знак целого числа, иначе отрицательные числа будут неправильно преобразовываться
	Если КоличествоОбъектов < 0 Тогда
		КоличествоОбъектов = -1 * КоличествоОбъектов;
	КонецЕсли;
	
	// для нецелых чисел - всегда вторая форма
	Если КоличествоОбъектов <> Цел(КоличествоОбъектов) Тогда 
		Возврат ДваОбъекта;
	КонецЕсли;
	
	// остаток
	Остаток = КоличествоОбъектов % 10;
	Если (КоличествоОбъектов > 10) И (КоличествоОбъектов < 20) Тогда
		// для второго десятка - всегда третья форма
		Возврат ПятьОбъектов;
		
	ИначеЕсли Остаток = 1 Тогда
		Возврат ОдинОбъект;
		
	ИначеЕсли (Остаток > 1) И (Остаток < 5) Тогда
		Возврат ДваОбъекта;
		
	Иначе
		Возврат ПятьОбъектов;
		
	КонецЕсли;
	
КонецФункции // ФормаМножественногоЧисла

Функция ДатаИзСтрокиДДММГГГГ(СтрокаДДММГГГГ, ВремяЧЧММСС = "", ЗаменятьПустуюДатуНа01011980 = Ложь, ГодНачалаСтолетия = 1953) Экспорт

	ИсходнаяСтрокаДДММГГГГ = СтрокаДДММГГГГ;
	ИсходнаяСтрокаЧЧММСС = ВремяЧЧММСС;
	ДатаКакДата = Дата(1, 1, 1);
	
	Если СокрЛП(СтрокаДДММГГГГ) = ".  ." Или ПустаяСтрока(СтрокаДДММГГГГ) Или СтрокаДДММГГГГ = ". ." Тогда
		Возврат ?(ЗаменятьПустуюДатуНа01011980, Дата(1980, 1, 1), ДатаКакДата);
	КонецЕсли;
	
	СтрокаДДММГГГГ = СокрЛП(СтрокаДДММГГГГ);
	ВремяЧЧММСС    = СокрЛП(ВремяЧЧММСС);
	
	// в отличие от 7.7, 1С8 не умеет вариационно преобразовывать к дате строки формата "ДД.ММ.ГГ"
	//  - 1с 8.х Дата("01.01.01") = '01.01.0001'
	//  - 1с 7.7 Дата("01.01.53") = '01.01.2053'; Дата("01.01.54") = '01.01.1954' (при дате начала столетия 1953)
	
	Если СтрДлина(СтрокаДДММГГГГ) = 8 Тогда
		
		СтолетиеДатыНачала = Цел(ГодНачалаСтолетия / 100);
		ГодыДатаНачала     = ГодНачалаСтолетия % 100;
		
		СтрокаДДММГГГГ = СтрЗаменить(СтрокаДДММГГГГ, ".", Символы.ПС);
		ГодДатыСтрокой = СтрПолучитьСтроку(СтрокаДДММГГГГ, 3);
		
		Если ЗначениеЗаполнено(ГодДатыСтрокой) И ТолькоЦифрыВСтроке(ГодДатыСтрокой) Тогда
			ГодыДаты = Число(ГодДатыСтрокой);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось преобразовать к дате строку [" + ИсходнаяСтрокаДДММГГГГ + "]. Ошибка при определении года даты.");
			Возврат Неопределено;
		КонецЕсли;

		ПолныеГодыДаты = (СтолетиеДатыНачала + ?(ГодыДаты <= ГодыДатаНачала, 1, 0)) * 100 + ГодыДаты;
		
		СтрокаДДММГГГГ = СтрПолучитьСтроку(СтрокаДДММГГГГ, 1) + "." + СтрПолучитьСтроку(СтрокаДДММГГГГ, 2) + "." + Формат(ПолныеГодыДаты, "ЧГ=");
		
	КонецЕсли;
	
	Если ПустаяСтрока(ВремяЧЧММСС) Тогда
		ВремяЧЧММСС = "00:00:00";
	КонецЕсли;
	
	Если Не ПустаяСтрока(СтрокаДДММГГГГ) Тогда
		Попытка
			ДатаКакДата = Дата(СтрокаДДММГГГГ + " " + ВремяЧЧММСС);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось преобразовать к дате строку [" + ИсходнаяСтрокаДДММГГГГ + ?(ПустаяСтрока(ИсходнаяСтрокаЧЧММСС), "", " " + ИсходнаяСтрокаЧЧММСС) + "]");
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Возврат ДатаКакДата;
	
КонецФункции // ДатаИзСтрокиДДММГГГГ

