// ВИЗУАЛИЗАЦИЯ ФОРМАТОВ
//	Добавляет переносы и табы, для корректной физуализации 

//Преобразует строку JSON
Функция ФорматСтрокиJSON(Знач СтрокаJSON) Экспорт
	
	Результат	= "";
	Уровень		= 0;
	
	Для НомерСимвола = 1 По СтрДлина(СтрокаJSON) Цикл
		
		ТекущийСимвол = Сред(СтрокаJSON, НомерСимвола, 1);
		Если ТекущийСимвол = Символы.ПС ИЛИ ТекущийСимвол = Символы.Таб Тогда
			Продолжить;
		ИначеЕсли ТекущийСимвол = "{" ИЛИ ТекущийСимвол = "[" Тогда
			Уровень = Уровень + 1;
			Результат = Результат + ТекущийСимвол;
			Результат = Результат + Символы.ПС + Табуляция(Уровень);
		ИначеЕсли ТекущийСимвол = "}" ИЛИ ТекущийСимвол = "]" Тогда
			Уровень = Уровень - 1;
			Результат = Результат + Символы.ПС;
			Результат = Результат + Табуляция(Уровень) + ТекущийСимвол;
		ИначеЕсли ТекущийСимвол = "," Тогда
			Результат = Результат + ТекущийСимвол;
			Результат = Результат + Символы.ПС + Табуляция(Уровень);
		Иначе
			Результат = Результат + ТекущийСимвол;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

