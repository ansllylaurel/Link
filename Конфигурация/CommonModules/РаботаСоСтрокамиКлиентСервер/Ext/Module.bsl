// ОПРЕДЕЛЕНИЕ ФОРМАТА СТРОКИ

Функция ЭтоJSON(Знач СтрокаДанных) Экспорт
	
	СтрокаДанных = СокрЛП(СтрокаДанных);
	
	Возврат (Лев(СтрокаДанных, 1) = "{"
			И Прав(СтрокаДанных, 1) = "}");
	
КонецФункции

