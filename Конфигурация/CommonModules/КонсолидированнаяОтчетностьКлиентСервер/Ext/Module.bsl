Функция ИтоговаяЯчейкаПервыйРасчет(ЭтаФорма, ИмяРаздела, ИмяЯчейки, Ячейка) Экспорт
	// #ЧисткаИтогов
	
	Если ИмяРаздела = "" Тогда
		Возврат ЛОЖЬ;
	КонецЕсли;
	
	Если ЭтаФорма.мСтруктураРасчетаИтогов = Неопределено Тогда
		ЭтаФорма.мСтруктураРасчетаИтогов = Новый Структура;
		
	КонецЕсли;
	
	// если еще нет ветки ИмяРаздела, добавим
	Если НЕ ЭтаФорма.мСтруктураРасчетаИтогов.Свойство(ИмяРаздела) Тогда
		ЭтаФорма.мСтруктураРасчетаИтогов.Вставить(ИмяРаздела, Новый Структура);
	КонецЕсли;
	
	// В ветке ИмяРаздела поищем ячейку ИмяЯчейки
	// если её еще нет, значит это первое заполнение ячейки и нужно:
	// 1. очистить ячейку - результат
	// 2. очистить данные в расшифровке.
	
	Если НЕ ЭтаФорма.мСтруктураРасчетаИтогов[ИмяРаздела].Свойство(ИмяЯчейки) Тогда
		
		// очистим ячейку
		Ячейка.Значение = 0;
		
		// добавляем ветку ИмяЯчейки
		ЭтаФорма.мСтруктураРасчетаИтогов[ИмяРаздела].Вставить(ИмяЯчейки);
		
		Возврат Истина; //это первый расчет
		
	КонецЕсли;
	
	Возврат ЛОЖЬ; //уже не первый расчет
	
КонецФункции

Функция ОкруглитьЧислоПоФормату(ИсходноеЧисло, Точность, Делитель = 1) Экспорт
	
	пДелитель = ?(Делитель = 0, 1, Делитель);
	ОкругленноеЧисло = Окр(ИсходноеЧисло / пДелитель, Точность) * пДелитель;
	
	Возврат ОкругленноеЧисло;
	
КонецФункции

Процедура РасчетИтоговНачало(ЭтаФорма, ИмяРаздела) Экспорт
	// #ЧисткаИтогов
	
	Если ИмяРаздела = "" Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.мСтруктураРасчетаИтогов = Неопределено Тогда
		ЭтаФорма.мСтруктураРасчетаИтогов = Новый Структура;
		
	КонецЕсли;
	
	// Если уже есть итоги по разделу ИмяРаздела, то удалим ветку из структуры.
	Если ЭтаФорма.мСтруктураРасчетаИтогов.Свойство(ИмяРаздела) Тогда
		ЭтаФорма.мСтруктураРасчетаИтогов.Удалить(ИмяРаздела);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПоказатьПериод(Форма, ОргДатаРегистрации) Экспорт
	
	ВидПериода = ВидПериодаОтчета(Форма, ОргДатаРегистрации);
	
	Если ВидПериода = "Нестандартный" Тогда
		СтрПериодОтчета = ПредставлениеПериода(Форма.мДатаНачалаПериодаОтчета, Форма.мДатаКонцаПериодаОтчета);
	ИначеЕсли ВидПериода = "Сокращенный" Тогда
		СтрПериодОтчета = Формат(Форма.мДатаНачалаПериодаОтчета, "ДФ=dd.MM.yyyy")
			+ " - " + Формат(Форма.мДатаКонцаПериодаОтчета, "ДФ='ММММ гггг'");
	ИначеЕсли ВидПериода = "Стандартный" Тогда
		Если Месяц(Форма.мДатаКонцаПериодаОтчета) = 1 Тогда
			СтрПериодОтчета = Формат(Форма.мДатаКонцаПериодаОтчета, "ДФ='ММММ гггг'") + " г.";
		Иначе
			СтрПериодОтчета = "Январь - " + Формат(Форма.мДатаКонцаПериодаОтчета, "ДФ='ММММ гггг'") + " г.";
		КонецЕсли;
	КонецЕсли;
	
	Форма.ПолеВыбораПериодичностиПоказаПериода = СтрПериодОтчета;
	
	Если НЕ (Форма.ИмяФормы = "Отчет.РегламентированныйОтчетБалансРСБУ.Форма.ОсновнаяФорма"
			ИЛИ Форма.ИмяФормы = "Отчет.РегламентированныйОтчетОФинансовыхРезультатахРСБУ.Форма.ОсновнаяФорма") Тогда     
		
		ПараметрыОтбора = Новый Структура("ВидДеятельностиОрганизации, НКО, МСФО9", Форма.ВидДеятельностиОрганизации, Форма.НКО, Форма.МСФО9);
		Если ТипЗнч(Форма.НастройкиОтчета) = Тип("Структура") Тогда
			ПараметрыОтбора.Вставить("ФормаОтчета", Форма.НастройкиОтчета.ВыбраннаяФорма); 		
		КонецЕсли; 
	КонецЕсли;
	
	КоличествоФорм = КонсолидированнаяОтчетностьКлиентСервер.КоличествоФормСоответствующихВыбранномуПериоду(Форма, ПараметрыОтбора);
	Если КоличествоФорм >= 1 Тогда
		Форма.Элементы.ПолеРедакцияФормы.Видимость    = КоличествоФорм > 1;
		Форма.Элементы.ОткрытьФормуОтчета.Доступность = Истина;
	Иначе
		Форма.Элементы.ПолеРедакцияФормы.Видимость    = Ложь;
		Форма.Элементы.ОткрытьФормуОтчета.Доступность = Ложь;
		Форма.ОписаниеНормативДок = "Отсутствует в программе.";
	КонецЕсли;
	
	КонсолидированнаяОтчетностьКлиентСервер.ВыборФормыРегламентированногоОтчетаПоУмолчанию(Форма, ПараметрыОтбора);

	// В РезультирующаяТаблица - действующие на выбранный период формы.
	// Заполним список выбора форм отчетности.
	Форма.Элементы.ПолеРедакцияФормы.СписокВыбора.Очистить();
	
	Для Каждого ЭлФорма Из Форма.РезультирующаяТаблица Цикл
		Форма.Элементы.ПолеРедакцияФормы.СписокВыбора.Добавить(ЭлФорма.РедакцияФормы);
	КонецЦикла;
	
	Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(Форма, "ОтчетЗаПоследнийКвартал") Тогда
		ДоступностьОтчетаЗаПоследнийКвартал = (Месяц(Форма.мДатаКонцаПериодаОтчета) = 6 или Месяц(Форма.мДатаКонцаПериодаОтчета) = 9 или Месяц(Форма.мДатаКонцаПериодаОтчета) = 12);
		Форма.Элементы.ОтчетЗаПоследнийКвартал.Доступность = ДоступностьОтчетаЗаПоследнийКвартал;
	КонецЕсли;

КонецПроцедуры

Функция ВидПериодаОтчета(Форма, ОргДатаРегистрации) Экспорт
	
	Если Форма.НестандартныйПериод Тогда
	    Возврат "Нестандартный";
	КонецЕсли;
	
	ДатаРегистрации = НачалоДня(ОргДатаРегистрации);
	ДатаНачалаОбычногоПериода = НачалоГода(Форма.мДатаКонцаПериодаОтчета);
	
	Если (ДатаРегистрации > ДатаНачалаОбычногоПериода И ДатаРегистрации < Форма.мДатаКонцаПериодаОтчета) Тогда
		Возврат "Сокращенный";
	Иначе
		Возврат "Стандартный";
	КонецЕсли;
	
КонецФункции