Функция КоличествоДоступныхОрганизаций(Знач Пользователь = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Пользователь = Неопределено Тогда
		Пользователь = ТекущийПользователь();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(Пользователи.Организация) КАК КоличествоОрганизаций
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.ИдентификаторПользователяИБ = &ИдентификаторПользователяИБ
		|	И Пользователи.Организация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|	И НЕ Пользователи.ВходЗапрещен";
		
	Запрос.УстановитьПараметр("ИдентификаторПользователяИБ", Пользователь.ИдентификаторПользователяИБ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		КоличествоОрганизаций = Выборка.КоличествоОрганизаций;
	Иначе
		КоличествоОрганизаций = 0;
	КонецЕсли;	
		
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат КоличествоОрганизаций;
	
КонецФункции // КоличествоДоступныхОрганизаций

Функция ДоступныеПользователи(Пользователь = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДоступныеПользователи = Новый Соответствие;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Пользователи.Организация КАК Организация,
		|	Пользователи.Ссылка КАК Пользователь
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК ТекущийПользователь
		|		ПО (ТекущийПользователь.Ссылка = &Пользователь)
		|			И (ТекущийПользователь.ИдентификаторПользователяИБ = Пользователи.ИдентификаторПользователяИБ)
		|ГДЕ
		|	Пользователи.Организация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)");
		
	Запрос.УстановитьПараметр("Пользователь", ?(Пользователь = Неопределено, ТекущийПользователь(), Пользователь));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДоступныеПользователи.Вставить(Выборка.Организация, Выборка.Пользователь);
	КонецЦикла;	
		
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ДоступныеПользователи;

КонецФункции

Функция ЭтоНеуказанныйПользователь(Пользователь = Неопределено) Экспорт
	
	ПроверяемыйПользователь				= ?(Пользователь = Неопределено, ТекущийПользователь(), Пользователь);
	СвойстваНеуказанногоПользователя	= СвойстваНеуказанногоПользователя();
	
	Возврат (ПроверяемыйПользователь = СвойстваНеуказанногоПользователя.Ссылка);
	
КонецФункции

// Процедура - Проверить права доступа к документам подсистемы документооборот
//
Процедура ПроверитьПраваДоступаКДокументамПодсистемыДокументооборот() Экспорт

	Ошибки = Новый Массив;
	Если Не ПараметрыСеанса.ДоступныВсеСчетаДоверительногоУправления Тогда
		
		ДоступныеРолиКонтролераУК = Новый Массив;
		ДоступныеРолиКонтролераСК = Новый Массив;
		
		Для каждого Роль Из Метаданные.Роли Цикл
		
			Если СтрНачинаетсяС(Роль.Имя, "КонтрольУправляющихКомпаний") И РольДоступна(Роль) Тогда
				ДоступныеРолиКонтролераУК.Добавить(Роль);
			ИначеЕсли СтрНачинаетсяС(Роль.Имя, "КонтрольСтраховыхКомпаний") И РольДоступна(Роль) Тогда
				Если РольДоступна(Метаданные.Роли.Документооборот) 
					Или РольДоступна(Метаданные.Роли.ДокументооборотПросмотр) 
					Или РольДоступна(Метаданные.Роли.ДокументооборотРегистрацияДокументов) Тогда
					ДоступныеРолиКонтролераСК.Добавить(Роль);
				КонецЕсли; 				
			КонецЕсли; 
			
		КонецЦикла; 
		
		Если ДоступныеРолиКонтролераУК.Количество() > 0 Тогда
		    // Если контролеру УК назначены ограничения по счетам ДУ - возможны два вида проблем:
			// 1. Роли подсистемы Документооборот не назначены. Пользователь будет видеть только документы, у которых 
			// в табличной части Договоры пристутствуют счета ДУ, причем, доступ должен быть ко всем счетам ДУ документа.
			// 2. Роли подсистемы Документооборот назначены. Пользователь будет иметь доступ ко всем документам без учета РЛС
			Ошибки.Добавить("Обнаружен конфликт настройки доступа к счетам ДУ у пользователя " + ПараметрыСеанса.ТекущийПользователь + Символы.ПС + 
				"Включены ограничения доступа совместно с " + ?(ДоступныеРолиКонтролераУК.Количество() = 1, "ролью ", "ролями ") + 
				СтрСоединить(ДоступныеРолиКонтролераУК, " и "));
		КонецЕсли;
		
		Если ДоступныеРолиКонтролераСК.Количество() > 0 Тогда
			// Пользователю одновременно назначены роли подсистемы Документооборот и контролера СК. 
			// РЛС будет нормально работать, если не назначать роли подсистемы Документооборот, т.к. 
			// во входящих и исходящих документах СК в табличной части Договоры всегда есть одна строка, содержащая счет ДУ.
			// В противном случае, пользователь будет иметь доступ ко всем документам без учета РЛС
			Ошибки.Добавить("Обнаружен конфликт настройки доступа к счетам ДУ у пользователя " + ПараметрыСеанса.ТекущийПользователь + Символы.ПС +
				"Включены ограничения доступа совместно с " + ?(ДоступныеРолиКонтролераСК.Количество() = 1, "ролью ", "ролями ") + 
				СтрСоединить(ДоступныеРолиКонтролераСК, " и "));
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если Ошибки.Количество() > 0 Тогда
	
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(СтрСоединить(Ошибки, Символы.ПС), "РаботаСПользователями.ПроверитьПраваДоступаКДокументамПодсистемыДокументооборот", Неопределено);
	
	КонецЕсли; 

КонецПроцедуры

//Проверяет текущего пользователя по доменному имени 
Функция ЭтоПолноправныйБухгалтерУКПИ() Экспорт
	
	Если ПараметрыСеанса.ТекущийПользователь = ОбщегоНазначения.ПолучитьИменованныйОбъект("Пользователь_КожуховаУКПИ")
		ИЛИ ПараметрыСеанса.ТекущийПользователь = ОбщегоНазначения.ПолучитьИменованныйОбъект("Пользователь_КаплинаУКПИ") Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции
