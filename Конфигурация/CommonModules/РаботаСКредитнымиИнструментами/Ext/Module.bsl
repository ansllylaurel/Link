		Для Каждого СтрокаДанных Из КредитныеИнструментыРасчитанныеПолностью.Получить(СтрокаНастройки.ДатаРасчетаКорректировкиЭСП) Цикл
			Если СтрокаНастройки.КредитныйИнструмент = СтрокаДанных.КредитныйИнструмент Тогда 
				ЗаполнитьЗначенияСвойств(НоваяСтрокаКредитныхИнструментов, СтрокаДанных);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		//Если корректировка расчитывается в другой день, пересчитаем номинал и процент на дату оценки
		Если СтрокаНастройки.ДатаРасчетаКорректировкиЭСП <> СтрокаНастройки.ДатаОценки Тогда
			Если КредитныеИнструментыРасчитанныеЛинейно.Получить(СтрокаНастройки.ДатаОценки) = Неопределено Тогда
				КредитныеИнструментыРасчитанныеЛинейно.Вставить(СтрокаНастройки.ДатаОценки, ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправления(СчетДоверительногоУправления, СтрокаНастройки.ДатаОценки, ТипКредитногоИнструмента, , НеУчитыватьКредитныеИнструментыПослеДатыЗакрытия));
			КонецЕсли;
			
			Для Каждого СтрокаДанных Из КредитныеИнструментыРасчитанныеЛинейно.Получить(СтрокаНастройки.ДатаОценки) Цикл
				Если СтрокаНастройки.КредитныйИнструмент = СтрокаДанных.КредитныйИнструмент Тогда 
					ЗаполнитьЗначенияСвойств(НоваяСтрокаКредитныхИнструментов, СтрокаДанных);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если СтрокаНастройки.НеПоказыватьОтрицательныеПроценты
			И НЕ СтрокаНастройки.НеУчитывать580ПИОтнестиКорректировкуНаТело
			И НоваяСтрокаКредитныхИнструментов.Проценты + НоваяСтрокаКредитныхИнструментов.ПроцентыЭСП < 0 Тогда
			НоваяСтрокаКредитныхИнструментов.Проценты = 0;
			НоваяСтрокаКредитныхИнструментов.ПроцентыЭСП = 0;
		КонецЕсли;
	
	КонецЦикла;
	
	Если МенеджерВременныхТаблиц <> Неопределено 
	   И МенеджерВременныхТаблиц.Таблицы.Найти("_РасшифровкаСтоимостиАктивовПоРыночнойСтавке") <> Неопределено
	   И НЕ Отказ Тогда //если отказ расшифровка уже добавлена
		СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(КредитныеИнструментыПоРычночнойСтавке, "_РасшифровкаСтоимостиАктивовПоРыночнойСтавке", МенеджерВременныхТаблиц);
	КонецЕсли;
	
	Возврат КредитныеИнструментыПоРычночнойСтавке;
	
КонецФункции

// Функция возвращает стоимость депозитов по счёту ДУ по рычночной ставке: получение остатков и применение настроек проверки на рыночность
Функция ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправленияПоРыночнойСтавке(СчетДоверительногоУправления, Знач Период, ЦельРасчета, 
	ТипКредитногоИнструмента = Неопределено, НеУчитыватьКредитныеИнструментыПослеДатыЗакрытия = Ложь, МенеджерВременныхТаблиц = Неопределено, Отказ = Ложь) Экспорт
	
	КредитныеИнструменты = ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправления(СчетДоверительногоУправления, Период, ТипКредитногоИнструмента, , НеУчитыватьКредитныеИнструментыПослеДатыЗакрытия);
	
	КредитныеИнструментыПоРычночнойСтавке = РаботаСоСтоимостьюПоРыночнойСтавке.ПолучитьСтоимостьКредитныхИнструментовПоРыночнойСтавке(КредитныеИнструменты, СчетДоверительногоУправления, Период, ЦельРасчета, МенеджерВременныхТаблиц, Отказ);
	
	Возврат КредитныеИнструментыПоРычночнойСтавке;
	
КонецФункции

Функция НазваниеКредитногоИнструментаРодительныйПадеж(КредитныйИнструмент) Экспорт
	
	Если ТипЗнч(КредитныйИнструмент) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда	
		Возврат "депозитного вклада";
	ИначеЕсли ТипЗнч(КредитныйИнструмент) = Тип("СправочникСсылка.Займы") Тогда
		Если КредитныйИнструмент.ВидКредитногоИнструмента = Перечисления.ВидыКредитныхИнструментов.Выданный Тогда
			Возврат "займа выданного";
		Иначе
			Возврат "займа полученного";
		КонецЕсли; 
	Иначе 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неизвестный кредитный инструмент!", КредитныйИнструмент);
		Возврат "";
	КонецЕсли;
КонецФункции

Функция ПолучитьСтоимостиПросроченныхЗаймовПоСчетуДоверительногоУправления(СчетДоверительногоУправления, Знач Период, 
	НеУчитыватьКредитныеИнструментыПослеДатыЗакрытия = Ложь, МенеджерВременныхТаблиц = Неопределено, Отказ = Ложь) Экспорт
		
	//не передавать цель в качестве параметра, для других целей функция не используется
	ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;
	
	//Линейно. Просроченная задолженность по рынку не оценивается
	СтоимостьКредитныхИнструментов = ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправления(СчетДоверительногоУправления, Период, Перечисления.ВидыАктивов.ДебиторскаяЗадолженность, , 
			НеУчитыватьКредитныеИнструментыПослеДатыЗакрытия);
			
	КоличествоПросроченныхЗаймов = СтоимостьКредитныхИнструментов.Количество();
	Если КоличествоПросроченныхЗаймов>0 И Период >= Дата(2022,6,21) Тогда		
		//#434641 - дефолт		
		ДефолтныйЗайм = ОбщегоНазначения.ПолучитьИменованныйОбъект("ПросрочкаЗаймаКотенко_РПИ");
		Для сц = - КоличествоПросроченныхЗаймов + 1 По 0 Цикл
			СтрокаСтоимостиКредитныхИнструментов = СтоимостьКредитныхИнструментов.Получить(сц);
			Если СтрокаСтоимостиКредитныхИнструментов.Основание = ДефолтныйЗайм Тогда
				СтоимостьКредитныхИнструментов.Удалить(СтрокаСтоимостиКредитныхИнструментов);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
			
	Если СтоимостьКредитныхИнструментов.Колонки.Найти("СуммаРезерва") = Неопределено Тогда
		СтоимостьКредитныхИнструментов.Колонки.Добавить("СуммаРезерва", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 2)));
	КонецЕсли;
	Если СтоимостьКредитныхИнструментов.Колонки.Найти("ЕстьОбесценение") = Неопределено Тогда
		СтоимостьКредитныхИнструментов.Колонки.Добавить("ЕстьОбесценение", Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	Если СтоимостьКредитныхИнструментов.Колонки.Найти("Актив") = Неопределено Тогда
		СтоимостьКредитныхИнструментов.Колонки.Добавить("Актив", Новый ОписаниеТипов("СправочникСсылка.Займы"));
		СтоимостьКредитныхИнструментов.ЗагрузитьКолонку(СтоимостьКредитныхИнструментов.ВыгрузитьКолонку("КредитныйИнструмент"), "Актив");
	КонецЕсли;
	
	РаботаСоСтоимостьюПоРыночнойСтавке.ПрименитьОбесценение(СтоимостьКредитныхИнструментов, СчетДоверительногоУправления, Период, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении, Отказ);
	
	Возврат СтоимостьКредитныхИнструментов;
	
КонецФункции

// Функция возвращает справедливую стоимость погашаемой суммы займа
Функция ПолучитьСправедливуюСтоимостьПогашенияКредитногоИнструмента(ДокументЗакрытияКредитногоИнструмента, Знач Период, Отказ = Ложь) Экспорт
	
	Результат = 0;
	
	//не передавать цель в качестве параметра, для других целей функция не используется
	ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗакрытиеКредитногоИнструмента.Дата КАК Дата,
		|	ЗакрытиеКредитногоИнструмента.КредитныйИнструмент КАК КредитныйИнструмент,
		|	ЗакрытиеКредитногоИнструмента.Сумма КАК Сумма,
		|	ВЫБОР
		|		КОГДА Займы.ВидКредитногоИнструмента = ЗНАЧЕНИЕ(перечисление.ВидыКредитныхИнструментов.Выданный)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыАктивовДляПроверкиНаРыночность.ЗаймыВыданные)
		|		КОГДА Займы.ВидКредитногоИнструмента = ЗНАЧЕНИЕ(перечисление.ВидыКредитныхИнструментов.Полученный)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыАктивовДляПроверкиНаРыночность.ЗаймыПолученные)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыАктивовДляПроверкиНаРыночность.Депозиты)
		|	КОНЕЦ КАК ВидАктива
		|ИЗ
		|	Документ.ЗакрытиеКредитногоИнструмента КАК ЗакрытиеКредитногоИнструмента
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Займы КАК Займы
		|		ПО ЗакрытиеКредитногоИнструмента.КредитныйИнструмент = Займы.Ссылка
		|ГДЕ
		|	ЗакрытиеКредитногоИнструмента.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументЗакрытияКредитногоИнструмента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Результат = ДокументЗакрытияКредитногоИнструмента.Сумма;
		//Заполним денежный поток погашения
		ПотокПоЗакрытию = ПолучитьСтруктуруТаблицыСтоимостиКредитныхИнструментов();
		
		СтрокаПотока = ПотокПоЗакрытию.Добавить();
		СтрокаПотока.КредитныйИнструмент = ВыборкаДетальныеЗаписи.КредитныйИнструмент;
		СтрокаПотока.Основание = ДокументЗакрытияКредитногоИнструмента;
		
		СтрокаПотока.ВидАктива = ВыборкаДетальныеЗаписи.ВидАктива;
		СтрокаПотока.ДатаДенежногоПотока = ПолучитьДатуПогашенияКредитногоИнструмента(ВыборкаДетальныеЗаписи.КредитныйИнструмент, ВыборкаДетальныеЗаписи.Дата);
		СтрокаПотока.Проценты = 0;
		СтрокаПотока.Задолженность = 0;
		СтрокаПотока.Номинал = ВыборкаДетальныеЗаписи.Сумма;
		
		ПотокиПоАктивуПоРыночнойСтавке = РаботаСоСтоимостьюПоРыночнойСтавке.ПолучитьСтоимостьКредитныхИнструментовПоРыночнойСтавке(
											ПотокПоЗакрытию,
											ДокументЗакрытияКредитногоИнструмента.СчетДоверительногоУправления, 
											Период, 
											ЦельРасчета,, 
											Отказ); 
											
		Для Каждого Поток из ПотокиПоАктивуПоРыночнойСтавке Цикл
			Результат = Результат + Поток.ПроцентыЭСП + Поток.СуммаРезерва;
		КонецЦикла;	
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьРасчетныйСчетВозвратаДенежныхСредств(Дата, Организация, КредитныйИнструмент) Экспорт
	
	//Для Займов вида "Полученный" с счета "РасчетныйСчетВозвратаДенежныхСредств" списываются денежные средства.
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий КАК ДатаНачалаДействияУсловий,
		|	УсловияКредитныхИнструментовСрезПоследних.РасчетныйСчетВозвратаДенежныхСредств КАК РасчетныйСчетВозвратаДенежныхСредств
		|ПОМЕСТИТЬ _ВсеУсловияКредитногоИнструмента
		|ИЗ
		|	РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
		|			&Дата,
		|			Организация = &организация
		|				И КредитныйИнструмент = &КредитныйИнструмент) КАК УсловияКредитныхИнструментовСрезПоследних
		|ГДЕ
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий <= &Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	_ВсеУсловияКредитногоИнструмента.РасчетныйСчетВозвратаДенежныхСредств КАК РасчетныйСчетВозвратаДенежныхСредств
		|ИЗ
		|	_ВсеУсловияКредитногоИнструмента КАК _ВсеУсловияКредитногоИнструмента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_ВсеУсловияКредитногоИнструмента.КредитныйИнструмент КАК КредитныйИнструмент,
		|			МАКСИМУМ(_ВсеУсловияКредитногоИнструмента.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
		|		ИЗ
		|			_ВсеУсловияКредитногоИнструмента КАК _ВсеУсловияКредитногоИнструмента
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_ВсеУсловияКредитногоИнструмента.КредитныйИнструмент) КАК ВложенныйЗапрос
		|		ПО _ВсеУсловияКредитногоИнструмента.КредитныйИнструмент = ВложенныйЗапрос.КредитныйИнструмент
		|			И _ВсеУсловияКредитногоИнструмента.ДатаНачалаДействияУсловий = ВложенныйЗапрос.ДатаНачалаДействияУсловий";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("КредитныйИнструмент", КредитныйИнструмент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.РасчетныйСчетВозвратаДенежныхСредств;	
	КонецЦикла;
		
КонецФункции

Функция НеобходимоЗаполнениеЗначенияРасчетногоСчетаВозвратаДенежныхСредств(Организация, КредитныйИнструмент) Экспорт
	
	// Реквизит заполняем только для УК РЭМ и Траст, кроме биржевых депозитов
	
	Возврат (Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ")
				Или Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"))
		И Не ЭтоБиржевойДепозит(КредитныйИнструмент); 
	
КонецФункции
 
Функция ЭтоБиржевойДепозит(КредитныйИнструмент) Экспорт
	
	Возврат ТипЗнч(КредитныйИнструмент) = Тип("СправочникСсылка.ДепозитныеВклады")
		И ЗначениеЗаполнено(КредитныйИнструмент)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КредитныйИнструмент, "МестоХранения") = Справочники.МестаХранения.ММВБ_ДепозитыСЦК;
	
КонецФункции
