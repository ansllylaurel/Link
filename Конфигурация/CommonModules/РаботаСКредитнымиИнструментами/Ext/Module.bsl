	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		
		ЭтоДепозитныйВклад = ТипЗнч(Выборка.КредитныйИнструмент) = Тип("СправочникСсылка.ДепозитныеВклады");
		ЭтоЗаймПолученный = НЕ ЭтоДепозитныйВклад И Выборка.КредитныйИнструмент.ВидКредитногоИнструмента = Перечисления.ВидыКредитныхИнструментов.Полученный;
		
		//#техдолг: надо бы вынести признак для погашения с фиксацией в регистре НоминалыКредитныхИнструментов на случай ввода начальных остатков.
		// или в УсловияКредитныхИнструментов, но часто одну формулировку читают по-разному, поэтому прав заимодавец или как договорятся :)
		//Проценты при частичном погашении могут выплачиваться на погашаему сумму или на всю сумму. Других вариантов пока не было
		ПриЧастичномПогашенииВыплачиваютсяПроцентыНаПогашаемуюСумму = ЭтоЗаймПолученный;
		
		СтрокиНоминаловКредитногоИнструмента = НоминалыКредитныхИнструментов.НайтиСтроки(Новый Структура("КредитныйИнструмент",Выборка.КредитныйИнструмент));
		СтрокиНоминаловКредитныхИнструментовПоДатамПогашения = НоминалыКредитныхИнструментовПоДатамПогашения.НайтиСтроки(Новый Структура("КредитныйИнструмент",Выборка.КредитныйИнструмент));

		
		ВыборкаДетальныеЗаписи = Выборка.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			//цикл по потокам номиналов частичного погашения. Потоки номиналов частичного размещения делить не надо.
			
			Если СтрокиНоминаловКредитныхИнструментовПоДатамПогашения.Количество() <> 1 Тогда
				//для каждой строки установим сумму номинала, актуальную(!) на период расчета процентов
				Для Каждого СтрокаНоминаловКредитныхИнструментовПоДатамПогашения ИЗ СтрокиНоминаловКредитныхИнструментовПоДатамПогашения Цикл
					СтрокаНоминаловКредитныхИнструментовПоДатамПогашения.Номинал = 0;
					Для Каждого СтрокаНоминаловКредитногоИнструмента ИЗ СтрокиНоминаловКредитногоИнструмента Цикл
						Если СтрокаНоминаловКредитногоИнструмента.ДатаДенежногоПотока < ВыборкаДетальныеЗаписи.НачалоПериода Тогда
							Продолжить;
						КонецЕсли;
						Если СтрокаНоминаловКредитногоИнструмента.ДатаДенежногоПотока = СтрокаНоминаловКредитныхИнструментовПоДатамПогашения.ДатаДенежногоПотока Тогда
							СтрокаНоминаловКредитныхИнструментовПоДатамПогашения.Номинал = СтрокаНоминаловКредитныхИнструментовПоДатамПогашения.Номинал + СтрокаНоминаловКредитногоИнструмента.Номинал;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			Иначе
				//частичных погашений не было, считаем общей суммой
			КонецЕсли;
			
			Для Каждого СтрокаНоминаловКредитныхИнструментовПоДатамПогашения из СтрокиНоминаловКредитныхИнструментовПоДатамПогашения Цикл
				
				ТекущийНоминал = СтрокаНоминаловКредитныхИнструментовПоДатамПогашения.Номинал;
				
				Если ТекущийНоминал = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				ДатаНачалаПериодаРасчетаПроцентов = ВыборкаДетальныеЗаписи.НачалоПериода;
				
				Пока ДатаНачалаПериодаРасчетаПроцентов < ВыборкаДетальныеЗаписи.ОкончаниеПериода Цикл 
					
					ВыплатаПоГрафику = Истина;
					
					//если нужно разделить большой период на части, кратные периоду выплаты процентов (месяц/квартал), то считаем по конечную дату периода включительно
					ЭтоКонецПериодаВыплатыПроцентовЗайма = Ложь;
					
					Если ВыборкаДетальныеЗаписи.ПериодичностьВыплатыПроцентов = Перечисления.ПериодичностиВыплатыПроцентов.Ежемесячно Тогда
						ДатаОкончанияПериодаРасчетаПроцентов = НачалоДня(КонецМесяца(ДатаНачалаПериодаРасчетаПроцентов + 86400));
						ЭтоКонецПериодаВыплатыПроцентовЗайма = НЕ ЭтоДепозитныйВклад;
					ИначеЕсли ВыборкаДетальныеЗаписи.ПериодичностьВыплатыПроцентов = Перечисления.ПериодичностиВыплатыПроцентов.Ежеквартально Тогда
						ДатаОкончанияПериодаРасчетаПроцентов = НачалоДня(КонецКвартала(ДатаНачалаПериодаРасчетаПроцентов + 86400));
						ЭтоКонецПериодаВыплатыПроцентовЗайма = НЕ ЭтоДепозитныйВклад;
					Иначе
						ДатаОкончанияПериодаРасчетаПроцентов = ВыборкаДетальныеЗаписи.ОкончаниеПериода;
					КонецЕсли;
					
					ДатаНачисленияПоЗайму = 0;
					//для непогашенных номиналов. Проценты по погашенным номиналам рассчитаны общей суммой и оплачены
					Если СтрокаНоминаловКредитныхИнструментовПоДатамПогашения.ДатаДенежногоПотока > Период Тогда
						//для займов полученных - последний рабочий день месяца (методика ЗПИФ_УКПИ)
						Если ЭтоЗаймПолученный  Тогда
							ДатаНачисленияПоЗайму = НачалоДня(Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоДня(КонецМесяца(ДатаОкончанияПериодаРасчетаПроцентов-86400))));
							ПоследнийРабочийДеньМесяца = НачалоДня(Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоДня(КонецМесяца(ДатаНачалаПериодаРасчетаПроцентов))));
							Если ПоследнийРабочийДеньМесяца < НачалоДня(ДатаНачалаПериодаРасчетаПроцентов) Тогда
								//если последний рабочий день уже прошел, считаем с нерабочего конца месяца за следующий месяц 
								ПоследнийРабочийДеньМесяца = НачалоДня(Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоДня(КонецМесяца(ДобавитьМесяц(ДатаНачалаПериодаРасчетаПроцентов,1)))));
							КонецЕсли;
							Если ПоследнийРабочийДеньМесяца > НачалоДня(ДатаНачалаПериодаРасчетаПроцентов) Тогда
								Если ПоследнийРабочийДеньМесяца < НачалоДня(ДатаОкончанияПериодаРасчетаПроцентов) Тогда
									//прибавляем день, т.к. займы считаем днями
									ДатаОкончанияПериодаРасчетаПроцентов = ПоследнийРабочийДеньМесяца + 86400;
									ДатаНачисленияПоЗайму = НачалоДня(Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоДня(КонецМесяца(ДатаОкончанияПериодаРасчетаПроцентов-86400))));
								КонецЕсли;
							КонецЕсли;	
						КонецЕсли;
					ИначеЕсли ПриЧастичномПогашенииВыплачиваютсяПроцентыНаПогашаемуюСумму Тогда
						ДатаНачисленияПоЗайму = СтрокаНоминаловКредитныхИнструментовПоДатамПогашения.ДатаДенежногоПотока;
					КонецЕсли;
					
					//дата выплаты
					ДатаДенежногоПотока= ДатаОкончанияПериодаРасчетаПроцентов;
					
					Если ВыборкаДетальныеЗаписи.ПериодичностьВыплатыПроцентов = Перечисления.ПериодичностиВыплатыПроцентов.ВКонцеСрока Тогда
						
						ДатаДенежногоПотока	= ВыборкаДетальныеЗаписи.ДатаПогашения;
					
					Иначе
						
						//для займов проценты выплачиваются на следующий день по окончании периода расчета процентов
						Если НЕ ЭтоДепозитныйВклад Тогда
							ДатаДенежногоПотока = ДатаОкончанияПериодаРасчетаПроцентов + 86400;
						КонецЕсли;
						
						//решили что для депозитов тоже надо по рабочим дням считать потоки
						Если ДатаДенежногоПотока > ВыборкаДетальныеЗаписи.ДатаПогашения Тогда
							ДатаДенежногоПотока = ВыборкаДетальныеЗаписи.ДатаПогашения;
						КонецЕсли;
						Если  ДатаДенежногоПотока <> ВыборкаДетальныеЗаписи.ДатаПогашения Тогда
							ДатаДенежногоПотока		= Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ДатаДенежногоПотока),1);
						КонецЕсли;
						
					КонецЕсли;
					
					Если ДатаОкончанияПериодаРасчетаПроцентов > ВыборкаДетальныеЗаписи.ОкончаниеПериода Тогда
						ДатаОкончанияПериодаРасчетаПроцентов = ВыборкаДетальныеЗаписи.ОкончаниеПериода;
						ЭтоКонецПериодаВыплатыПроцентовЗайма = Ложь;
						ВыплатаПоГрафику = ВыборкаДетальныеЗаписи.ОкончаниеПериода < Период;
					КонецЕсли;
					
					Если НЕ ЭтоДепозитныйВклад
						И ВыборкаДетальныеЗаписи.ПоследнийПериод Тогда
						//считаем по дату окончания включительно
						ЭтоКонецПериодаВыплатыПроцентовЗайма = Истина;
					КонецЕсли;

					Дни = РасчетВисокосныхИОбычныхДней(ДатаНачалаПериодаРасчетаПроцентов, ДатаОкончанияПериодаРасчетаПроцентов + ?(ЭтоКонецПериодаВыплатыПроцентовЗайма,86400,0), ЭтоДепозитныйВклад);
					
					ПроцентыНачисленныеВПериоде = ТекущийНоминал * ВыборкаДетальныеЗаписи.Процент / 100 * (Дни["Дней365"] / 365 + Дни["Дней366"] / 366);
					
					КонецПериодаНачисленияПроцентов = ДатаОкончанияПериодаРасчетаПроцентов - ?(НЕ ЭтоДепозитныйВклад,86400,0);
					
					НоваяСтрокаСтоимостиКредитныхИнструментов = СтоимостьКредитныхИнструментов.Добавить();
					НоваяСтрокаСтоимостиКредитныхИнструментов.КредитныйИнструмент		= Выборка.КредитныйИнструмент;
					НоваяСтрокаСтоимостиКредитныхИнструментов.ВидАктива					= ВыборкаДетальныеЗаписи.ВидАктива;
					НоваяСтрокаСтоимостиКредитныхИнструментов.Основание					= ВыборкаДетальныеЗаписи.Основание;
					НоваяСтрокаСтоимостиКредитныхИнструментов.Период					= КонецПериодаНачисленияПроцентов;
					НоваяСтрокаСтоимостиКредитныхИнструментов.Номинал					= ТекущийНоминал;
					НоваяСтрокаСтоимостиКредитныхИнструментов.Процент					= ВыборкаДетальныеЗаписи.Процент;
					НоваяСтрокаСтоимостиКредитныхИнструментов.Проценты					= ПроцентыНачисленныеВПериоде;
					НоваяСтрокаСтоимостиКредитныхИнструментов.Операция					= ?(ЗначениеЗаполнено(ПроцентыНачисленныеВПериоде), "Начисление с " + Формат(ДатаНачалаПериодаРасчетаПроцентов, "ДФ=dd.MM.yyyy") + " по " + Формат(ДатаОкончанияПериодаРасчетаПроцентов, "ДФ=dd.MM.yyyy"), "");
					НоваяСтрокаСтоимостиКредитныхИнструментов.ДатаНачисления 			= ?(ЭтоДепозитныйВклад, 
											КонецПериодаНачисленияПроцентов, 
											?(ДатаНачисленияПоЗайму=0,ПолучитьКонецПроцентногоПериода(КонецПериодаНачисленияПроцентов, ВыборкаДетальныеЗаписи.ПериодичностьВыплатыПроцентов,  ВыборкаДетальныеЗаписи.ДатаПогашения),ДатаНачисленияПоЗайму));
					НоваяСтрокаСтоимостиКредитныхИнструментов.ДатаДенежногоПотока		= ДатаДенежногоПотока;
					
					НоваяСтрокаСтоимостиКредитныхИнструментов.ДатаПогашенияНоминала		= СтрокаНоминаловКредитныхИнструментовПоДатамПогашения.ДатаДенежногоПотока;
					Если Не ЭтоДепозитныйВклад И Не ПриЧастичномПогашенииВыплачиваютсяПроцентыНаПогашаемуюСумму Тогда
						//заменить на ближайщую дату погашения текущих процентов при частичном или полном погашении. Для просроченных займов отсутствует
						ДатаПогашенияТекущегоНоминала = ПолучитьДатуПогашенияТекущегоНоминала(СтрокиНоминаловКредитныхИнструментовПоДатамПогашения, КонецПериодаНачисленияПроцентов); 
						Если ЗначениеЗаполнено(ДатаПогашенияТекущегоНоминала) Тогда
							НоваяСтрокаСтоимостиКредитныхИнструментов.ДатаПогашенияНоминала = ДатаПогашенияТекущегоНоминала;
						КонецЕсли;
					КонецЕсли;
					
					Если ВыплатаПоГрафику И ЭтоДепозитныйВклад
						И НЕ ВыборкаДетальныеЗаписи.ПериодичностьВыплатыПроцентов = Перечисления.ПериодичностиВыплатыПроцентов.ВКонцеСрока
						И НЕ ВыборкаДетальныеЗаписи.ПериодичностьВыплатыПроцентов = Перечисления.ПериодичностиВыплатыПроцентов.Авансом Тогда 
						НоваяСтрокаСтоимостиКредитныхИнструментов.Задолженность		= ПроцентыНачисленныеВПериоде;
					КонецЕсли;

					ДатаНачалаПериодаРасчетаПроцентов = ДатаОкончанияПериодаРасчетаПроцентов + ?(ЭтоКонецПериодаВыплатыПроцентовЗайма,86400,0);
					
				КонецЦикла;
				
			КонецЦикла;	
		КонецЦикла;
		
	КонецЦикла;
	
	//округлить по периодам выплаты процентов
	ДатыНачисленияПроцентовКредитныхИнструментов = СтоимостьКредитныхИнструментов.Скопировать(,"КредитныйИнструмент, Основание, ДатаНачисления, ДатаПогашенияНоминала");
	ДатыНачисленияПроцентовКредитныхИнструментов.Свернуть("КредитныйИнструмент, Основание, ДатаНачисления, ДатаПогашенияНоминала");
	Для Каждого СтрокаДатНачисления из ДатыНачисленияПроцентовКредитныхИнструментов Цикл
		СтрокиСтоимости = СтоимостьКредитныхИнструментов.НайтиСтроки(Новый Структура("КредитныйИнструмент, Основание, ДатаНачисления, ДатаПогашенияНоминала",
			СтрокаДатНачисления.КредитныйИнструмент,СтрокаДатНачисления.Основание,СтрокаДатНачисления.ДатаНачисления, СтрокаДатНачисления.ДатаПогашенияНоминала));
		//оставим погрешность в той строке, в которой она накопилась.	
		ПогрешностьОкругления = 0;
		Для Каждого СтрокаСтоимости из СтрокиСтоимости Цикл
			Если Лев(СтрокаСтоимости.Операция, 13) <> "Начисление с " Тогда
				Продолжить;
			КонецЕсли;
			ПогрешностьОкругления = ПогрешностьОкругления + СтрокаСтоимости.Проценты;
			СтрокаСтоимости.Проценты = Окр(ПогрешностьОкругления, 2);			
			ПогрешностьОкругления = ПогрешностьОкругления - СтрокаСтоимости.Проценты;
		КонецЦикла;				
	КонецЦикла;
	
КонецФункции

Функция ПолучитьДатуПогашенияТекущегоНоминала(СтрокиНоминаловКредитныхИнструментовПоДатамПогашения, ДатаНачисления)
	
	ДатаЧастичногоПогашения = Дата(1,1,1);
	
	Для Каждого СтрокаНоминала из СтрокиНоминаловКредитныхИнструментовПоДатамПогашения Цикл
		Если СтрокаНоминала.Номинал = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаНоминала.ДатаДенежногоПотока >= ДатаНачисления 
			И (ДатаЧастичногоПогашения > СтрокаНоминала.ДатаДенежногоПотока ИЛИ НЕ ЗначениеЗаполнено(ДатаЧастичногоПогашения)) 
		Тогда
			ДатаЧастичногоПогашения = СтрокаНоминала.ДатаДенежногоПотока;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДатаЧастичногоПогашения;
	
КонецФункции

Функция ПолучитьКонецПроцентногоПериода(Дата, ПериодичностьВыплатыПроцентов, ДатаПогашения)
	
	Результат = Дата;
	
	Если ПериодичностьВыплатыПроцентов = Перечисления.ПериодичностиВыплатыПроцентов.Ежемесячно Тогда
		Результат = НачалоДня(КонецМесяца(Дата));
	ИначеЕсли ПериодичностьВыплатыПроцентов = Перечисления.ПериодичностиВыплатыПроцентов.Ежеквартально Тогда
		Результат = НачалоДня(КонецКвартала(Дата));
	ИначеЕсли ПериодичностьВыплатыПроцентов = Перечисления.ПериодичностиВыплатыПроцентов.ВКонцеСрока Тогда
		Результат	= ДатаПогашения;
	Иначе
		Результат = Дата;
	КонецЕсли;
	
	Если  Результат > ДатаПогашения Тогда
		Результат	= ДатаПогашения;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

Функция ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправленияДляБухгалтерскойПереоценки(Организация, СчетДоверительногоУправления, Период, ВидУчета, ТипКредитногоИнструмента = Неопределено) Экспорт

	ИмяДвижений = Метаданные.Перечисления.ВидыУчета.ЗначенияПеречисления[Перечисления.ВидыУчета.Индекс(ВидУчета)].Имя;
	
	УчитыватьДосрочноПолученныеПроцентыВДоходахБудущихПериодов = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
		Период,
		Организация,
		СчетДоверительногоУправления,
		Справочники.УчетныеАктивы.ДепозитныеВклады,
		ВидУчета,
		"УчитыватьДосрочноПолученныеПроцентыВДоходахБудущихПериодов");
		
	Если УчитыватьДосрочноПолученныеПроцентыВДоходахБудущихПериодов Тогда
			
		Депозиты = ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправления(СчетДоверительногоУправления, Период, ТипКредитногоИнструмента, Истина,, Истина);
		
		ВидыСубконто = Новый Массив;
	    ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги);
		
		Для каждого СтрокаДепозиты Из Депозиты Цикл
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	БухгалтерскийУчетОбороты.СуммаОборотДт
				|ИЗ
				|	РегистрБухгалтерии.БухгалтерскийУчет.Обороты(
				|			&НачалоПериода,
				|			&КонецПериода,
				|			Период,
				|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ДоходыБудущихПериодов),
				|			&ВидыСубконто,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И Субконто1 = &ДепозитныйВклад,
				|			,
				|			) КАК БухгалтерскийУчетОбороты";
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", ИмяДвижений);
				
			Запрос.УстановитьПараметр("Валюта", СтрокаДепозиты.КредитныйИнструмент.БанковскийСчет.Валюта);
			Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
			Запрос.УстановитьПараметр("НачалоПериода", СтрокаДепозиты.КредитныйИнструмент.ДатаРегистрации);
			Запрос.УстановитьПараметр("КонецПериода", НачалоДня(Период));
			Запрос.УстановитьПараметр("Организация", Организация);
			Запрос.УстановитьПараметр("ДепозитныйВклад", СтрокаДепозиты.КредитныйИнструмент);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
			
			ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				СтрокаДепозиты.Проценты = Окр(Окр(СтрокаДепозиты.Проценты, 3), 2) - ВыборкаДетальныеЗаписи.СуммаОборотДт;
			КонецЕсли;
			
		КонецЦикла;

		Возврат Депозиты;
		
	Иначе
		Возврат ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправления(СчетДоверительногоУправления, Период, ТипКредитногоИнструмента,,, Истина);
	КонецЕсли;

КонецФункции

// Функция возвращает стоимость депозитов по счёту ду на &Период для РСА: Номинал и Проценты, корректировка ЭСП уже учтена в процентах (или номинале).
// ПоРыночнойСтавке: Ложь - линейный расчёт, Истина - расчёт по рыночоной ставке
Функция ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправленияДляРСА(СчетДоверительногоУправления, Знач Период, ТипКредитногоИнструмента = Неопределено, 
	НеУчитыватьКредитныеИнструментыПослеДатыЗакрытия = Ложь, ПоРыночнойСтавке = Истина, МенеджерВременныхТаблиц = Неопределено, Отказ = Ложь) Экспорт	
	
	//не передавать цель в качестве параметра, для других целей функция не используется
	ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;
	
	Если ПоРыночнойСтавке Тогда
		СтоимостьКредитныхИнструментов = ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправленияПоРыночнойСтавкеСУчетомПериодичностиОценки(СчетДоверительногоУправления, 
			Период, ЦельРасчета, ТипКредитногоИнструмента, НеУчитыватьКредитныеИнструментыПослеДатыЗакрытия, МенеджерВременныхТаблиц, Отказ);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	НеУчитывать580ПИОтнестиКорректировкуНаТело.Объект КАК ДепозитныйВклад
			|ИЗ
			|	РегистрСведений.ЗначенияДополнительныхСведений КАК НеУчитывать580ПИОтнестиКорректировкуНаТело
			|ГДЕ
			|	НеУчитывать580ПИОтнестиКорректировкуНаТело.Свойство.Ключ = ""НеУчитывать580ПИОтнестиКорректировкуНаТело""
			|	И НеУчитывать580ПИОтнестиКорректировкуНаТело.Объект В(&МассивДепозитов)
			|	И НеУчитывать580ПИОтнестиКорректировкуНаТело.Значение = ИСТИНА";
		
		Запрос.УстановитьПараметр("МассивДепозитов", СтоимостьКредитныхИнструментов.ВыгрузитьКолонку("КредитныйИнструмент"));
		
		ДепозитыКорректировкаЭСПВТеле = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДепозитныйВклад");
		
		Для Каждого СтрокаСтоимостиКредитныхИнструментов Из СтоимостьКредитныхИнструментов Цикл
			Если ДепозитыКорректировкаЭСПВТеле.Найти(СтрокаСтоимостиКредитныхИнструментов.КредитныйИнструмент) = Неопределено Тогда
				СтрокаСтоимостиКредитныхИнструментов.Проценты = СтрокаСтоимостиКредитныхИнструментов.Проценты + СтрокаСтоимостиКредитныхИнструментов.ПроцентыЭСП;
			Иначе
				СтрокаСтоимостиКредитныхИнструментов.Номинал = СтрокаСтоимостиКредитныхИнструментов.Номинал + СтрокаСтоимостиКредитныхИнструментов.ПроцентыЭСП;
			КонецЕсли;
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОценкиСтоимостиПрочихАктивовСрезПоследних.СубъектАналитики КАК Займ,
			|	ОценкиСтоимостиПрочихАктивовСрезПоследних.Стоимость КАК Стоимость
			|ИЗ
			|	РегистрСведений.ОценкиСтоимостиПрочихАктивов.СрезПоследних(
			|			&Период,
			|			СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.Займы)) КАК ОценкиСтоимостиПрочихАктивовСрезПоследних
			|ГДЕ
			|	ОценкиСтоимостиПрочихАктивовСрезПоследних.ДатаОкончанияДействия >= &Период
			|	И ОценкиСтоимостиПрочихАктивовСрезПоследних.СубъектАналитики В(&МассивЗаймов)";
		
		Запрос.УстановитьПараметр("Период", Период);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("МассивЗаймов", СтоимостьКредитныхИнструментов.ВыгрузитьКолонку("КредитныйИнструмент"));
		
		ЗаймыСПрофОценкой = Запрос.Выполнить().Выгрузить();
		
		Для Каждого СтрокаЗаймыСПрофОценкой Из ЗаймыСПрофОценкой Цикл
			СтрокаЗайма = СтоимостьКредитныхИнструментов.Найти(СтрокаЗаймыСПрофОценкой.Займ, "КредитныйИнструмент");
			Если СтрокаЗайма <> Неопределено Тогда
				СтрокаСтоимостиКредитныхИнструментов.Номинал  = СтрокаЗаймыСПрофОценкой.Стоимость;
				СтрокаСтоимостиКредитныхИнструментов.Проценты = 0;
				СтрокаСтоимостиКредитныхИнструментов.ПроцентыЭСП = 0;
			КонецЕсли;
		КонецЦикла;
		
	Иначе //Линейно
		СтоимостьКредитныхИнструментов = ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправления(СчетДоверительногоУправления, Период, ТипКредитногоИнструмента, , 
			НеУчитыватьКредитныеИнструментыПослеДатыЗакрытия);
	КонецЕсли;
	
	Если СтоимостьКредитныхИнструментов.Колонки.Найти("СуммаРезерва") = Неопределено Тогда
		СтоимостьКредитныхИнструментов.Колонки.Добавить("СуммаРезерва", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 2)));
	КонецЕсли;
	
	Возврат СтоимостьКредитныхИнструментов;
	
КонецФункции

// Функция определяет стоимость депозитов с учётом периодичности оценки, периодичности расчёта корректировки ЭСП - подходит для всех целей расчёта.
Функция ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправленияПоРыночнойСтавкеСУчетомПериодичностиОценки(СчетДоверительногоУправления, Знач Период, 
	ЦельРасчета, ТипКредитногоИнструмента = Неопределено, НеУчитыватьКредитныеИнструментыПослеДатыЗакрытия = Ложь, МенеджерВременныхТаблиц = Неопределено, Отказ = Ложь) Экспорт
	
	ПоследнийДеньМесяца			= КонецДня(?(КонецДня(Период) = КонецМесяца(Период), Период, КонецМесяца(ДобавитьМесяц(Период, -1))));
	ПоследнийРабочийДеньМесяца	= КонецДня(Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ПоследнийДеньМесяца));
	
	
	КредитныеИнструменты = ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправления(СчетДоверительногоУправления, Период, ТипКредитногоИнструмента, , НеУчитыватьКредитныеИнструментыПослеДатыЗакрытия);

	//Настройки на дату оценки
	Запрос = Новый Запрос;

	#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КредитныеИнструменты.КредитныйИнструмент КАК КредитныйИнструмент,
		|	КредитныеИнструменты.ВидАктива КАК ВидАктива
		|ПОМЕСТИТЬ _КредитныеИнструменты0
		|ИЗ
		|	&КредитныеИнструменты КАК КредитныеИнструменты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КредитныеИнструменты.КредитныйИнструмент КАК КредитныйИнструмент,
		|	КредитныеИнструменты.ВидАктива КАК ВидАктива,
		|	ВЫБОР
		|		КОГДА НЕ КредитныеИнструменты.ВидАктива В (&ВидыАктивовЗависимыеОтВидаКонтрагента)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.)
		|		КОГДА ТИПЗНАЧЕНИЯ(КредитныеИнструменты.КредитныйИнструмент) = ТИП(Справочник.Займы)
		|			ТОГДА УсловияКредитныхИнструментовСрезПоследних.Контрагент.ВидЮрФизЛица
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.)
		|	КОНЕЦ КАК ВидКонтрагента
		|ПОМЕСТИТЬ _КредитныеИнструменты
		|ИЗ
		|	_КредитныеИнструменты0 КАК КредитныеИнструменты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Займы КАК Займы
		|		ПО КредитныеИнструменты.КредитныйИнструмент = Займы.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|			УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
		|			УсловияКредитныхИнструментовСрезПоследних.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
		|			УсловияКредитныхИнструментовСрезПоследних.Процент КАК Процент,
		|			УсловияКредитныхИнструментовСрезПоследних.Контрагент КАК Контрагент
		|		ИЗ
		|			(ВЫБРАТЬ
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|				МАКСИМУМ(УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
		|			ИЗ
		|				РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
		|						&Период,
		|						ДатаНачалаДействияУсловий <= &Период
		|							И КредитныйИнструмент В
		|								(ВЫБРАТЬ
		|									_КредитныеИнструменты0.КредитныйИнструмент КАК КредитныйИнструмент
		|								ИЗ
		|									_КредитныеИнструменты0 КАК _КредитныеИнструменты0)) КАК УсловияКредитныхИнструментовСрезПоследних
		|			ГДЕ
		|				УсловияКредитныхИнструментовСрезПоследних.Действует
		|			
		|			СГРУППИРОВАТЬ ПО
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент) КАК АктуальныеДатыНачалаДействия
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
		|						&Период,
		|						ДатаНачалаДействияУсловий <= &Период
		|							И КредитныйИнструмент В
		|								(ВЫБРАТЬ
		|									_КредитныеИнструменты0.КредитныйИнструмент КАК КредитныйИнструмент
		|								ИЗ
		|									_КредитныеИнструменты0 КАК _КредитныеИнструменты0)) КАК УсловияКредитныхИнструментовСрезПоследних
		|				ПО АктуальныеДатыНачалаДействия.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|					И АктуальныеДатыНачалаДействия.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК УсловияКредитныхИнструментовСрезПоследних
		|		ПО КредитныеИнструменты.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.КредитныйИнструмент КАК КредитныйИнструмент,
		|	МАКСИМУМ(ВложенныйЗапрос.Период) КАК Период
		|ПОМЕСТИТЬ _МинимальныеДатыРасчета
		|ИЗ
		|	(ВЫБРАТЬ
		|		_КредитныеИнструменты.КредитныйИнструмент КАК КредитныйИнструмент,
		|		ВЫРАЗИТЬ(_КредитныеИнструменты.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).ДатаРегистрации КАК Период
		|	ИЗ
		|		_КредитныеИнструменты КАК _КредитныеИнструменты
		|	ГДЕ
		|		_КредитныеИнструменты.КредитныйИнструмент ССЫЛКА Справочник.ДепозитныеВклады
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		_КредитныеИнструменты.КредитныйИнструмент,
		|		НоминалыКредитныхИнструментовСрезПервых.Период
		|	ИЗ
		|		_КредитныеИнструменты КАК _КредитныеИнструменты
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыКредитныхИнструментов.СрезПервых(
		|					,
		|					КредитныйИнструмент В
		|						(ВЫБРАТЬ
		|							_КредитныеИнструменты.КредитныйИнструмент КАК КредитныйИнструмент
		|						ИЗ
		|							_КредитныеИнструменты КАК _КредитныеИнструменты
		|						ГДЕ
		|							_КредитныеИнструменты.КредитныйИнструмент ССЫЛКА Справочник.Займы)) КАК НоминалыКредитныхИнструментовСрезПервых
		|			ПО _КредитныеИнструменты.КредитныйИнструмент = НоминалыКредитныхИнструментовСрезПервых.КредитныйИнструмент
		|	ГДЕ
