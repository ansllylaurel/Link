// ПРОВЕРКА СУЩЕСТВОВАНИЯ ИСПОЛНИТЕЛЕЙ

Функция ЕстьИсполнитель(ИмяРегистраИсполнителей, РеквизитыИсполнителя) Экспорт
	
	// дата, организация и счет доверительного управления обязательны для заполнения
	// у всех видов исполнителей
	Если Не ЗначениеЗаполнено(РеквизитыИсполнителя.Организация)
		Или Не ЗначениеЗаполнено(РеквизитыИсполнителя.СчетДоверительногоУправления)
		Или Не ЗначениеЗаполнено(РеквизитыИсполнителя.Дата)
	Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация",                  РеквизитыИсполнителя.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", РеквизитыИсполнителя.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаЗакрытия",                 НачалоДня(РеквизитыИсполнителя.Дата));
	
	Если       ИмяРегистраИсполнителей = "ИсполнителиПоДенежнымСредствамСобственные" Тогда
		// проверять имеет смысл только тогда, когда р/счет выбран
		Если Не ЗначениеЗаполнено(РеквизитыИсполнителя.РасчетныйСчет) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет
			|ИЗ
			|	РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
			|ГДЕ
			|	(ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия >= &ДатаЗакрытия
			|			ИЛИ ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))
			|	И ИсполнителиПоДенежнымСредствамСобственные.Организация = &Организация
			|	И ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет = &РасчетныйСчет";
			
		Запрос.УстановитьПараметр("РасчетныйСчет", РеквизитыИсполнителя.РасчетныйСчет);
			
	ИначеЕсли ИмяРегистраИсполнителей = "ИсполнителиПоДенежнымСредствамБрокерские" Тогда
		// проверять имеет смысл только тогда, когда р/счет выбран
		Если Не ЗначениеЗаполнено(РеквизитыИсполнителя.РасчетныйСчет) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ИсполнителиПоДенежнымСредствамБрокерские.РасчетныйСчет
			|ИЗ
			|	РегистрСведений.ИсполнителиПоДенежнымСредствамБрокерские КАК ИсполнителиПоДенежнымСредствамБрокерские
			|ГДЕ
			|	(ИсполнителиПоДенежнымСредствамБрокерские.ДатаЗакрытия >= &ДатаЗакрытия
			|			ИЛИ ИсполнителиПоДенежнымСредствамБрокерские.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))
			|	И ИсполнителиПоДенежнымСредствамБрокерские.Организация = &Организация
			|	И ИсполнителиПоДенежнымСредствамБрокерские.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И ИсполнителиПоДенежнымСредствамБрокерские.РасчетныйСчет = &РасчетныйСчет
			|	И ИсполнителиПоДенежнымСредствамБрокерские.Брокер = &Брокер";
		
		Запрос.УстановитьПараметр("РасчетныйСчет", РеквизитыИсполнителя.РасчетныйСчет);
		Запрос.УстановитьПараметр("Брокер",        РеквизитыИсполнителя.Брокер);
		
	ИначеЕсли ИмяРегистраИсполнителей = "ИсполнителиПоЦеннымБумагам" Тогда
		// проверять имеет смысл только тогда, когда счет депо выбран
		Если Не ЗначениеЗаполнено(РеквизитыИсполнителя.ДепозитарныйСчет) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет
			|ИЗ
			|	РегистрСведений.ИсполнителиПоЦеннымБумагам КАК ИсполнителиПоЦеннымБумагам
			|ГДЕ
			|	(ИсполнителиПоЦеннымБумагам.ДатаЗакрытия >= &ДатаЗакрытия
			|			ИЛИ ИсполнителиПоЦеннымБумагам.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))
			|	И ИсполнителиПоЦеннымБумагам.Организация = &Организация
			|	И ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет = &ДепозитарныйСчет";
			
		Запрос.УстановитьПараметр("ДепозитарныйСчет", РеквизитыИсполнителя.ДепозитарныйСчет);
		
	КонецЕсли;
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции // ЕстьИсполнитель
