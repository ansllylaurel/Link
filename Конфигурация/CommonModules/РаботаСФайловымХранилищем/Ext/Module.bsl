
Процедура ДобавитьКомандуПрисоединенныеФайлы(Форма, ОсновнойРеквизит) Экспорт

	ВладелецПрисоединенныхФайлов = Метаданные.ОпределяемыеТипы.ВладелецПрисоединенныхФайлов;
	Если ВладелецПрисоединенныхФайлов.Тип.СодержитТип(ТипЗнч(ОсновнойРеквизит)) Тогда
		
		ОбщаяКоманда = Форма.КоманднаяПанель.ПодчиненныеЭлементы.Найти("ФормаОбщаяКомандаПрисоединенныеФайлы");
		Если ОбщаяКоманда <> Неопределено Тогда
			ОбщаяКоманда.Видимость = Ложь;
		КонецЕсли; 
		
		ИмяКоманды = "ОткрытьПрисоединенныеФайлы";
		
		Если Форма.Команды.Найти(ИмяКоманды) = Неопределено Тогда
			КомандаФормы = Форма.Команды.Добавить(ИмяКоманды);
			КомандаФормы.Действие = "Подключаемый_ОткрытьПрисоединенныеФайлы";
			КомандаФормы.Картинка = БиблиотекаКартинок.Скрепка;
			КомандаФормы.Заголовок = "Присоединенные файлы";
			КомандаФормы.Подсказка = "Присоединенные файлы";
			КомандаФормы.ИзменяетСохраняемыеДанные = Ложь;
			КомандаФормы.Отображение = ОтображениеКнопки.Картинка;
		КонецЕсли;
		
		НовыйЭлемент = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Форма.КоманднаяПанель);
		НовыйЭлемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
		НовыйЭлемент.ИмяКоманды = ИмяКоманды;

	КонецЕсли;
	
КонецПроцедуры

Функция КраткоеПредставлениеРазмера(Знач Размер) Экспорт
	
	Если Размер = 0 Тогда
		Возврат "-";
	ИначеЕсли Размер < 1024 * 10 Тогда // < 10 Кб
		Возврат СтрШаблон("%1 Кб", Формат(Макс(1, Окр(Размер / 1024, 1, 1)), "ЧГ=0"));
	ИначеЕсли Размер < 1024 * 1024 Тогда // < 1 Мб
		Возврат СтрШаблон("%1 Кб", Формат(Цел(Размер / 1024), "ЧГ=0"));
	ИначеЕсли Размер < 1024 * 1024 * 10 Тогда // < 10 Мб
		Возврат СтрШаблон("%1 Мб", Формат(Окр(Размер / 1024 / 1024, 1, 1), "ЧГ=0"));
	Иначе // >= 10 Мб
		Возврат СтрШаблон("%1 Мб", Формат(Цел(Размер / 1024 / 1024), "ЧГ=0"));
	КонецЕсли;
	
КонецФункции

#Область Работа_с_файловым_хранилищем_через_веб_сервис

#Область Интерфейс

// Используется для получения настроек подключения к файловому хранилищу
//
// Возвращаемое значение:
//	Структура, содержащая параметры подключения
//		свойства структуры:
//			АдресВебСервиса								- строка с URL веб-сервиса файлового хранилища
//			АутентификацияОС							- булево, флаг определяющий тип подключения через аутентификацию ОС или через указание пользователя и пароля
//			ИмяПользователя								- строка с именем пользователя
//			ПарольПользователя							- строка с паролем пользователя
//			ИдентификаторОбщейПапкиФайлов				- строка с уникальным идентификатором общей папки файлов в файловом хранилище
//			АдресВебСервисаТестовогоФайловогоХранилища	- строка с URL веб-сервиса тестового файлового хранилища
//
//	В случае, если настройки не заданы, или данные в константе, в которой хранятся настройки не соответствуют ожидаемым, возвращаемое значение = Неопределено
//
Функция ПолучитьНастройкиПодключенияКФайловомуХранилищу() Экспорт
	
	Попытка
		Настройки = XMLЗначение(Тип("ХранилищеЗначения"), Константы.НастройкиПодключенияКФайловомуХранилищу.Получить()).Получить();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Настройки;
	
КонецФункции

// Создает новый файл в файловом хранилище, записывая в него переданные двоичные данные
//
//	Параметры:
//	ДанныеФайла	- структура с описанием файла
//		свойства структуры:
//			Адрес					- адрес временного хранилища, по которому находятся двоичные данные файла
//			Имя						- имя файла (без расширения)
//			Расширение				- расширение файла (без точки)
//			НаименованиеВладельца	- строковое представление владельца файла (в результате будет создана папка с таким наименованием, куда будет помещен файл)
//			ИдентификаторВладельца	- строка с идентификатором владельца (идентификатор добавляется к имени папки)
//			ТипВладельца			- строковое представление типа владельца (в результате будет создана папка с таким наименованием, куда будет помещена папка с именем владельца)
//	Организация	- Организация для которой создается файл (по организации определяется папка хранения). Если организация не указана, будет использована общая папка.
//	              Если организация указана, но идентификатор папки для нее не задан, будет вызвано исключение.
//	ОтложеннаяВыгрузка - признак того что это работа с отчетностью. Отчетность сначала сохраняется в буферный регистр ВременноеХранилищеОтчетов.
//
// Возвращаемое значение:
//  Структура - содержащая идентификаторы файла и версии
//		свойства структуры:
//			ИдентификаторФайла	- строка с идентификатором файла в файловом хранилище для последующего получения файла
//			ИдентификаторВерсии	- строка с идентификатором первой версии файла
//
Функция СоздатьФайл(ДанныеФайла, Организация = Неопределено, ОтложеннаяВыгрузка = Ложь) Экспорт
	
	Если ОтложеннаяВыгрузка Тогда
		
		Попытка
			ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайла.Адрес);
		Исключение
			ВызватьИсключение "При получении данных файла из временного хранилища произошла ошибка: " + ОписаниеОшибки();
		КонецПопытки;
		
		Попытка
			НоваяЗапись = РегистрыСведений.ВременноеХранилищеОтчетов.СоздатьМенеджерЗаписи();
			НоваяЗапись.Период = ТекущаяДата();
			НоваяЗапись.ЭкземплярОтчета = ДанныеФайла.Экземпляр;
			НоваяЗапись.ИдентификаторВерсии = Строка(Новый УникальныйИдентификатор);
			НоваяЗапись.ДвоичныеДанные = Новый ХранилищеЗначения(ДвоичныеДанныеФайла);
			НоваяЗапись.Имя = ДанныеФайла.Имя;
			НоваяЗапись.Расширение = ДанныеФайла.Расширение;
			НоваяЗапись.Записать();		
		Исключение
			ВызватьИсключение "При выполнении запроса создания файла произошла ошибка: " + ОписаниеОшибки();
		КонецПопытки;
		
		
		Результат = Новый Структура;
		
		Результат.Вставить("ИдентификаторФайла",	"");
		Результат.Вставить("ИдентификаторВерсии",	НоваяЗапись.ИдентификаторВерсии);
		
	Иначе	
		
		НастройкиПодключения = ПолучитьНастройкиПодключенияКФайловомуХранилищу();
		
		Если НастройкиПодключения = Неопределено Тогда
			ВызватьИсключение "Не указаны настройки подключения к файловому хранилищу!";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Организация) Тогда
			
			Если НЕ ЗначениеЗаполнено(Организация.ИдентификаторПапкиВФайловомХранилище) Тогда
				ВызватьИсключение СтрШаблон("Для организации %1 не указан идентификатор папки файлов в файловом хранилище!", Организация);
			Иначе
				ИдентификаторПапкиФайлов = Организация.ИдентификаторПапкиВФайловомХранилище;
			КонецЕсли;
			
		Иначе
			
			Если НЕ НастройкиПодключения.Свойство("ИдентификаторОбщейПапкиФайлов")
				ИЛИ НЕ ЗначениеЗаполнено(НастройкиПодключения.ИдентификаторОбщейПапкиФайлов) Тогда
				ВызватьИсключение "Не указан идентификатор общей папки файлов в файловом хранилище!";
			Иначе
				ИдентификаторПапкиФайлов = НастройкиПодключения.ИдентификаторОбщейПапкиФайлов;
			КонецЕсли;
			
		КонецЕсли;
		
		ПроксиВебСервиса = ПолучитьПроксиВебСервисаФайловогоХранилища(НастройкиПодключения);
		
		Попытка
			Запрос = СоздатьОбъект(ПроксиВебСервиса, "DMAddLinkedFileRequest");
		Исключение
			ВызватьИсключение "При создании запроса для добавления файла произошла ошибка: " + ОписаниеОшибки();
		КонецПопытки;
		
		Запрос.rootFolderID = ИдентификаторПапкиФайлов;
		
		Попытка
			Запрос.file = СоздатьОбъект(ПроксиВебСервиса, "DMFile");
		Исключение
			ВызватьИсключение "При создании объекта файла произошла ошибка: " + ОписаниеОшибки();
		КонецПопытки;
		
		Попытка
			Запрос.file.externalObject = СоздатьОбъект(ПроксиВебСервиса, "ExternalObject");
		Исключение
			ВызватьИсключение "При создании внешнего объекта для привязки файла произошла ошибка: " + ОписаниеОшибки();
		КонецПопытки;
		
		Запрос.file.externalObject.name	= ДанныеФайла.НаименованиеВладельца;
		Запрос.file.externalObject.ID	= ДанныеФайла.ИдентификаторВладельца;
		Запрос.file.externalObject.type	= ДанныеФайла.ТипВладельца;
		
		Попытка
			ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайла.Адрес);
		Исключение
			ВызватьИсключение "При получении данных файла из временного хранилища произошла ошибка: " + ОписаниеОшибки();
		КонецПопытки;
		
		Запрос.file.objectID					= СоздатьObjectID(ПроксиВебСервиса, "", "DMFile");
		Запрос.file.binaryData					= ДвоичныеДанныеФайла;
		Запрос.file.name						= ДанныеФайла.Имя;
		Запрос.file.extension					= ДанныеФайла.Расширение;
		Запрос.file.size						= ДвоичныеДанныеФайла.Размер();
		
		ДатаСеанса = ТекущаяДатаСеанса();
		
		Запрос.file.modificationDate			= ДатаСеанса;
		Запрос.file.modificationDateUniversal	= УниверсальноеВремя(ДатаСеанса);
		
		Попытка
			Ответ = ПроксиВебСервиса.execute(Запрос);
		Исключение
			ВызватьИсключение "При выполнении запроса создания файла произошла ошибка: " + ОписаниеОшибки();
		КонецПопытки;
		
		ПроверитьВозвратВебСервиса(ПроксиВебСервиса, Ответ);
		
		Результат = Новый Структура;
		
		Результат.Вставить("ИдентификаторФайла",	Ответ.file.objectID.ID);
		Результат.Вставить("ИдентификаторВерсии",	ПолучитьИдентификаторАктивнойВерсии(Ответ.file.objectID, ПроксиВебСервиса));
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Блокирует файл файловом хранилище по идентификатору
//
//	Параметры:
//	Идентификатор	- строка с уникальным идентификатором файла, полученным при создании файла
//	Организация		- организация, которой принадлежит файл
//
Процедура ЗаблокироватьФайл(Идентификатор) Экспорт
	
	ПроксиВебСервиса = ПолучитьПроксиВебСервисаФайловогоХранилища();
	
	Попытка
		ИдентификаторФайла = СоздатьObjectID(ПроксиВебСервиса, Идентификатор, "DMFile");
	Исключение
		ВызватьИсключение СтрШаблон("При создании идентификатора файла (%1) в хранилище произошла ошибка:%2", Идентификатор, Символы.ПС + ОписаниеОшибки());
	КонецПопытки;
	
	Если НЕ ФайлСвободен(ИдентификаторФайла, ПроксиВебСервиса) Тогда
		ВызватьИсключение СтрШаблон("Файл (%1) заблокирован для редактирования! Повторная блокировка невозможна.", Идентификатор);
	КонецЕсли;
	
	УстановитьБлокировкуФайла(ПроксиВебСервиса, ИдентификаторФайла);
	
КонецПроцедуры

// Снимает блокировку файла в хранилище по идентификатору
//
//	Параметры:
//	Идентификатор		- строка с уникальным идентификатором файла, полученным при создании файла
//
Процедура РазблокироватьФайл(Идентификатор, Организация) Экспорт
	
	ПроксиВебСервиса = ПолучитьПроксиВебСервисаФайловогоХранилища();
	
	Попытка
		ИдентификаторФайла = СоздатьObjectID(ПроксиВебСервиса, Идентификатор, "DMFile");
	Исключение
		ВызватьИсключение СтрШаблон("При создании идентификатора файла (%1) в хранилище произошла ошибка:%2", Идентификатор, Символы.ПС + ОписаниеОшибки());
	КонецПопытки;
	
	Если ФайлСвободен(ИдентификаторФайла, ПроксиВебСервиса) Тогда
		ВызватьИсключение СтрШаблон("Файл (%1) не заблокирован для редактирования!", Идентификатор);
	КонецЕсли;
	
	СнятьБлокировкуФайла(ПроксиВебСервиса, ИдентификаторФайла);
	
КонецПроцедуры

// Создает новую версию существующего в хранилище файла по идентификатору
//	при этом до создания новой версии файл в хранилище блокируется, а после создания новой версии, блокировка снимается
//
//	Параметры:
//	Идентификатор		- строка с уникальным идентификатором файла, полученным при создании файла
//	Адрес				- адрес временного хранилища, по которому находятся двоичные данные файла
//	Расширение			- расширение файла (без точки)
//	ОтложеннаяВыгрузка	- признак того что это работа с отчетностью. Отчетность сначала сохраняется в буферный регистр ВременноеХранилищеОтчетов.
//	ЭкземплярОтчета 	- строка с идентификатором первой версии файла, необходимо при ЭтоОтчетность = Истина
//	ИмяФайла        	- Имя файла, необходимо при ЭтоОтчетность = Истина
//
// Возвращаемое значение:
//  Строка с идентификатором новой версии
//
Функция ОбновитьФайл(Идентификатор, Адрес, Расширение, ОтложеннаяВыгрузка = Ложь, ЭкземплярОтчета = Неопределено, ИмяФайла = "") Экспорт
	
	Если ОтложеннаяВыгрузка Тогда
		
		Попытка
			ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(Адрес);
		Исключение
			ВызватьИсключение "При получении данных файла из временного хранилища произошла ошибка: " + ОписаниеОшибки();
		КонецПопытки;
		
		НоваяЗапись = РегистрыСведений.ВременноеХранилищеОтчетов.СоздатьМенеджерЗаписи();
		НоваяЗапись.Период = ТекущаяДата();
		НоваяЗапись.ЭкземплярОтчета = ЭкземплярОтчета;
		НоваяЗапись.ИдентификаторВерсии = Строка(Новый УникальныйИдентификатор);
		НоваяЗапись.ДвоичныеДанные = Новый ХранилищеЗначения(ДвоичныеДанныеФайла);
		НоваяЗапись.Имя = ИмяФайла;
		НоваяЗапись.Расширение = Расширение;
		НоваяЗапись.ИдентификаторФайла = Идентификатор;
		НоваяЗапись.Записать();		
		
		Возврат НоваяЗапись.ИдентификаторВерсии;
		
	Иначе	
		
		// Получаем прокси веб-сервиса
		ПроксиВебСервиса = ПолучитьПроксиВебСервисаФайловогоХранилища();
		
		// Создаем идентификатор файла в хранилище
		Попытка
			ИдентификаторФайла = СоздатьObjectID(ПроксиВебСервиса, Идентификатор, "DMFile");
		Исключение
			ВызватьИсключение СтрШаблон("При создании идентификатора файла (%1) файловом хранилище произошла ошибка:%2", Идентификатор, Символы.ПС + ОписаниеОшибки());
		КонецПопытки;
		
		Если НЕ ФайлСвободен(ИдентификаторФайла, ПроксиВебСервиса) Тогда
			ВызватьИсключение СтрШаблон("Файл (%1) захвачен для редактирования!", Идентификатор);
		КонецЕсли;
		
		// Блокируем файл
		УстановитьБлокировкуФайла(ПроксиВебСервиса, ИдентификаторФайла);
		
		// Создаем новую версию файла
		Попытка
			Запрос = СоздатьОбъект(ПроксиВебСервиса, "DMUpdateRequest");
		Исключение
			ВызватьИсключение СтрШаблон("При создании запроса обновления файла (%1) в файловом хранилище произошла ошибка:%2", Идентификатор, Символы.ПС + ОписаниеОшибки());
		КонецПопытки;
		
		СписокОбъектов = Запрос.objects;
		
		Попытка
			ОбъектФайл = СоздатьОбъект(ПроксиВебСервиса, "DMFile");
		Исключение
			ВызватьИсключение СтрШаблон("При создании объекта файла (%1) в файловом хранилище произошла ошибка:%2", Идентификатор, Символы.ПС + ОписаниеОшибки());
		КонецПопытки;
		
		ОбъектФайл.objectID	= ИдентификаторФайла;
		ОбъектФайл.name		= "";
		
		Попытка
			ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(Адрес);
		Исключение
			ВызватьИсключение СтрШаблон("При получении данных файла(%1) произошла ошибка:%2", Идентификатор, Символы.ПС + ОписаниеОшибки());
		КонецПопытки;
		
		ДатаСеанса = ТекущаяДатаСеанса();
		
		ОбъектФайл.binaryData					= ДвоичныеДанныеФайла;
		ОбъектФайл.size							= ДвоичныеДанныеФайла.Размер();
		ОбъектФайл.extension					= Расширение;
		ОбъектФайл.modificationDate				= ДатаСеанса;
		ОбъектФайл.modificationDateUniversal	= УниверсальноеВремя(ДатаСеанса);
		
		СписокОбъектов.Добавить(ОбъектФайл);
		
		Попытка
			Ответ = ПроксиВебСервиса.execute(Запрос);
		Исключение
			ВызватьИсключение СтрШаблон("При выполнении запроса создания новой версии файла (%1) произошла ошибка:%2", Идентификатор, Символы.ПС + ОписаниеОшибки());
		КонецПопытки;
		
		ПроверитьВозвратВебСервиса(ПроксиВебСервиса, Ответ);
		
		// Разблокируем файл
		//	#Return
		//	Считать ли операцию по созданию версии невыполненной, если не смогли только снять блокировку?
		Попытка
			СнятьБлокировкуФайла(ПроксиВебСервиса, ИдентификаторФайла);
		Исключение
			// При попытке в дальнейшем изменить файл, пользователь получит ошибку, но номер создание и номер версии мы зафиксируем
		КонецПопытки;
		
		Возврат ПолучитьИдентификаторАктивнойВерсии(ИдентификаторФайла, ПроксиВебСервиса);
		
	КонецЕсли;
	
КонецФункции

