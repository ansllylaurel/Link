Функция ПолучитьСвойствоXDTO(ОбъектXDTO, ИмяСвойства)
	
	Если ОбъектXDTO = Неопределено
	 ИЛИ  ОбъектXDTO.Свойства().Получить(ИмяСвойства) = Неопределено 
	 ИЛИ ТипЗнч(ОбъектXDTO[ИмяСвойства]) = Тип("ОбъектXDTO") Тогда
		Возврат "";
	Иначе
		Возврат ОбъектXDTO[ИмяСвойства];	
	КонецЕсли;
	
КонецФункции

Функция ПроверкаТелефонаДляОповещения(ТелефонДляОповещения, ТекстОшибки = "") Экспорт
	
	Если ПустаяСтрока(ТелефонДляОповещения) Тогда
		Возврат Истина; //телефон может быть не указан, не проверяем
	КонецЕсли;
	
	НедопустимыеСимволы = Новый Массив;
	
	Для НомерСимвола = 1 По СтрДлина(ТелефонДляОповещения) Цикл
		Символ = Сред(ТелефонДляОповещения, НомерСимвола, 1);
		КодСмв = КодСимвола(Символ);
		Если КодСмв < 48 ИЛИ КодСмв > 57 Тогда
			НедопустимыеСимволы.Добавить("'" + Символ + "'");
		КонецЕсли;
	КонецЦикла;
	
	Если НедопустимыеСимволы.Количество() > 0 Тогда
		ТекстОшибки = " содержит недопустимые символы: " + СтрСоединить(НедопустимыеСимволы, ",");
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ СтрНачинаетсяС(ТелефонДляОповещения, "79") Тогда
		ТекстОшибки = " должен начинаться с '79'";
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции
