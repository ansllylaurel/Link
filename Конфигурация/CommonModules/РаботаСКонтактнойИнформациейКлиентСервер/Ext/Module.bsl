// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Дополняет представление адреса строкой.
//
// Параметры:
//	Дополнение - Строка - дополнение адреса.
//	СтрокаКонкатенации - Строка - строка конкатенации.
//	Представление - Строка - представление адреса.
//
Процедура ДополнитьПредставлениеАдреса(Дополнение, СтрокаКонкатенации, Представление)
	
	Если Дополнение <> "" Тогда
		Представление = Представление + СтрокаКонкатенации + Дополнение;
	КонецЕсли;
	
КонецПроцедуры

// Возвращает строку значения по свойству структуры.
// 
// Параметры:
//	Ключ - Строка - ключ структуры.
//  Структура - Структура - передаваемая структура.
//
// Возвращаемое значение - ПустаяСтрока или ПроизвольныйТип - значение.
//
Функция ЗначениеПоКлючуСтруктуры(Ключ, Структура)
	
	Значение	= Неопределено;
	
	Если Структура.Свойство(Ключ, Значение) Тогда 
		Возврат Строка(Значение);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции	

// Возвращает строку списка полей.
//
// Параметры:
//	СоответствиеПолей - Соответствие - соответствие полей.
//	
// Возвращаемое значение - Строка - преобразованное соответствие в строку.
//
Функция ПреобразоватьСписокПолейВСтроку(СоответствиеПолей) Экспорт
	
	Результат = "";
	Для Каждого Элемент Из СоответствиеПолей Цикл
		
		Значение = Элемент.Значение;
		Если ПустаяСтрока(Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Результат = Результат + ?(Результат = "", "", Символы.ПС) + 
			Элемент.Представление + "=" + СтрЗаменить(Значение, Символы.ПС, Символы.ПС + Символы.Таб);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает список значений. Преобразует строку полей в список значений.
//
// Параметры:
//	СтрокаПолей - Строка - строка полей.
//
// Возвращаемое значение - Список значений - список значений полей.
//
Функция ПреобразоватьСтрокуВСписокПолей(СтрокаПолей) Экспорт
	
	Результат = Новый СписокЗначений;
	ПоследнийЭлемент = Неопределено;
	
	Для Итерация = 1 По СтрЧислоСтрок(СтрокаПолей) Цикл
		ПолученнаяСтрока = СтрПолучитьСтроку(СтрокаПолей, Итерация);
		Если Лев(ПолученнаяСтрока, 1) = Символы.Таб Тогда
			Если ПоследнийЭлемент <> Неопределено Тогда
				ПоследнийЭлемент.Значение = ПоследнийЭлемент.Значение + Символы.ПС + Сред(ПолученнаяСтрока, 2);
			КонецЕсли;
		Иначе
			ПозицияСимвола = Найти(ПолученнаяСтрока, "=");
			Если ПозицияСимвола <> 0 Тогда
				ПоследнийЭлемент = Результат.Добавить(Сред(ПолученнаяСтрока, ПозицияСимвола + 1), Лев(ПолученнаяСтрока, ПозицияСимвола - 1));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция АдресФИАСВСтруктуру(ЗначенияПолей, Представление = "") Экспорт
	
	СтруктураАдреса = Новый Структура("Комментарий, ПредставлениеАдреса, Страна, ВнутригРайон, Город, НаселенныйПункт, Округ, Район, Регион, КодРегиона, Улица, КодАдресаФИАС, Индекс, ТипДома, Дом, ТипСтроения, Строение, ТипПомещения, Помещение");
	СтруктураАдреса.Вставить("ДополнительныеАдресныеЭлементы", Новый Массив);
	
	Если ТипЗнч(ЗначенияПолей) <> Тип("Строка") 
		ИЛИ Не СтрНачинаетсяС(СокрЛ(ЗначенияПолей), "<") Тогда
		СтруктураАдреса.Комментарий	= Представление;
		Возврат СтруктураАдреса; //это не XML
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ЗначенияПолей);
	
	ДанныеXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	
	СтруктураАдреса.ПредставлениеАдреса = ДанныеXDTO.Представление;
	СтруктураАдреса.Страна				= ДанныеXDTO.Состав.Страна;
	СтруктураАдреса.Комментарий			= ПолучитьСвойствоXDTO(ДанныеXDTO, "Комментарий");

	Если ТипЗнч(ДанныеXDTO.Состав.Состав) <> Тип("Строка") Тогда
		СтруктураАдреса.ВнутригРайон	= ПолучитьСвойствоXDTO(ДанныеXDTO.Состав.Состав, "ВнутригРайон");
		СтруктураАдреса.Город			= ПолучитьСвойствоXDTO(ДанныеXDTO.Состав.Состав, "Город");
		СтруктураАдреса.НаселенныйПункт	= ПолучитьСвойствоXDTO(ДанныеXDTO.Состав.Состав, "НаселПункт");
		СтруктураАдреса.Округ			= ПолучитьСвойствоXDTO(ДанныеXDTO.Состав.Состав, "Округ");
		СтруктураАдреса.Район			= ПолучитьСвойствоXDTO(ДанныеXDTO.Состав.Состав.СвРайМО, "Район");
		СтруктураАдреса.Регион			= ПолучитьСвойствоXDTO(ДанныеXDTO.Состав.Состав, "СубъектРФ");
		СтруктураАдреса.КодРегиона		= ПолучитьСвойствоXDTO(ДанныеXDTO.Состав.Состав, "КодСубъектаРФ");
		СтруктураАдреса.Улица			= ПолучитьСвойствоXDTO(ДанныеXDTO.Состав.Состав, "Улица");
		СтруктураАдреса.КодАдресаФИАС	= ПолучитьСвойствоXDTO(ДанныеXDTO.Состав.Состав, "КодАдресаФИАС");
		
		Для Каждого ДопАдрЭл Из ДанныеXDTO.Состав.Состав.ДопАдрЭл Цикл
			Если ДопАдрЭл.ТипАдрЭл = "10100000" Тогда
				СтруктураАдреса.Индекс = ДопАдрЭл.Значение;
			ИначеЕсли Найти("1010,1020,1030", ДопАдрЭл.Номер.Тип) > 0 Тогда	
				СтруктураАдреса.ТипДома = ДопАдрЭл.Номер.Тип;
				СтруктураАдреса.Дом		= ДопАдрЭл.Номер.Значение;
			ИначеЕсли Найти("1050,1060,1080,1070,1040", ДопАдрЭл.Номер.Тип) > 0 Тогда
				СтруктураАдреса.ТипСтроения = ДопАдрЭл.Номер.Тип;
				СтруктураАдреса.Строение	= ДопАдрЭл.Номер.Значение;
			ИначеЕсли Найти("2010,2030,2040,2020,2050,2060", ДопАдрЭл.Номер.Тип) > 0 Тогда
				СтруктураАдреса.ТипПомещения	= ДопАдрЭл.Номер.Тип;
				СтруктураАдреса.Помещение		= ДопАдрЭл.Номер.Значение;
			КонецЕсли;
			
			Если ТипЗнч(ДопАдрЭл.Номер) = Тип("ОбъектXDTO") Тогда
				СтруктураАдреса.ДополнительныеАдресныеЭлементы.Добавить(Новый Структура("Тип,Значение", ДопАдрЭл.Номер.Тип, ДопАдрЭл.Номер.Значение));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтруктураАдреса;
	
КонецФункции

Функция ПолучитьКодыАдресныхЭлементов() Экспорт

	КодыАдресныхЭлементов = Новый Соответствие;
	ТипыАдресныхЭлементов = ПолучитьТипыАдресныхЭлементов();
	
	Для Каждого ТипАдресногоЭлемента Из ТипыАдресныхЭлементов Цикл
		КодыАдресныхЭлементов.Вставить(ТипАдресногоЭлемента.Значение, ТипАдресногоЭлемента.Ключ);
	КонецЦикла;	
	
	Возврат КодыАдресныхЭлементов;
	
КонецФункции
	
