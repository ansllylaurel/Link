Функция ОпределитьНастройкиУчетаЦенныхБумаг(Период, Организация, СчетДоверительногоУправления, ИмяМетода) Экспорт

	Если ИмяМетода = "ПолучитьСписокНастроекДляРасчета" Тогда
		СписокНастроек = ПланыВидовХарактеристик.НастройкиУчетаЦенныхБумаг.ПолучитьСписокНастроекДляРасчета();
	ИначеЕсли ИмяМетода = "ПолучитьСписокНастроекДляПереоценки" Тогда
		СписокНастроек = ПланыВидовХарактеристик.НастройкиУчетаЦенныхБумаг.ПолучитьСписокНастроекДляПереоценки();
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _Клиент
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.Рынок КАК Рынок,
		|	ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.Настройка КАК Настройка,
		|	ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЗначениеНастройки КАК ЗначениеНастройки,
		|	ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.Настройка.ИмяПредопределенныхДанных КАК Имя,
		|	ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.Партия КАК Партия,
		|	ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.СтрокаПартии КАК СтрокаПартии
		|ИЗ
		|	РегистрСведений.ЗначенияНастроекУчетаЦенныхБумаг.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Настройка В (&Настройки)) КАК ЗначенияНастроекУчетаЦенныхБумагСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Клиент КАК _Клиент
		|		ПО ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.Клиент = _Клиент.Клиент
		|ГДЕ
		|	НЕ ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.Отключить";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	Если СписокНастроек = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Настройка В (&Настройки)", "");
	Иначе
		Запрос.УстановитьПараметр("Настройки", СписокНастроек);
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьОблигацииРеклассифицированныеНа504ПриПереходеНаМСФО9(СчетДоверительногоУправления) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	РеклассификацияАктивовЕПС.ЦеннаяБумага КАК ЦеннаяБумага
		|ИЗ
		|	Документ.РеклассификацияАктивовЕПС КАК РеклассификацияАктивовЕПС
		|ГДЕ
		|	РеклассификацияАктивовЕПС.Дата = ДАТАВРЕМЯ(2025, 1, 1)
		|	И РеклассификацияАктивовЕПС.Проведен
		|	И РеклассификацияАктивовЕПС.Организация = &Организация
		|	И РеклассификацияАктивовЕПС.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И РеклассификацияАктивовЕПС.УчетныйАктивЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения)
		|	И РеклассификацияАктивовЕПС.УчетныйАктивЕПССтарый.Родитель В (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПСД), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток))";
	
	Запрос.УстановитьПараметр("Организация", ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ")); // для группы будущее же, значит Траст
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЦеннаяБумага");

КонецФункции

Функция ПолучитьПартииНепроведенныхРекласовОтКоторыхОтказались() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КорректировкаРегистров.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _Корректировки
		|ИЗ
		|	Документ.КорректировкаРегистров КАК КорректировкаРегистров
		|ГДЕ
		|	КорректировкаРегистров.Дата = ДАТАВРЕМЯ(2025, 7, 31, 23, 59, 59)
		|	И КорректировкаРегистров.Организация = &Организация
		|	И КорректировкаРегистров.Комментарий ПОДОБНО ""Убираем непроведенные реклассы""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагСписание.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	БухПартииЦенныхБумагСписание.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагСписание.Партия КАК ПартияСписания,
		|	БухПартииЦенныхБумагСписание.СтрокаПартии КАК СтрокаПартииСписание,
		|	БухПартииЦенныхБумагЗачисление.Партия КАК ПартияЗачисление,
		|	БухПартииЦенныхБумагЗачисление.СтрокаПартии КАК СтрокаПартииЗачисление
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумагСписание
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумагЗачисление
		|		ПО (БухПартииЦенныхБумагЗачисление.Регистратор В
		|				(ВЫБРАТЬ
		|					_Корректировки.Ссылка
		|				ИЗ
		|					_Корректировки))
		|			И (БухПартииЦенныхБумагСписание.Регистратор В
		|				(ВЫБРАТЬ
		|					_Корректировки.Ссылка
		|				ИЗ
		|					_Корректировки))
		|			И (БухПартииЦенныхБумагЗачисление.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))
		|			И (БухПартииЦенныхБумагСписание.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход))
		|			И (БухПартииЦенныхБумагЗачисление.Количество = БухПартииЦенныхБумагСписание.Количество)
		|			И (БухПартииЦенныхБумагЗачисление.Стоимость = БухПартииЦенныхБумагСписание.Стоимость)
		|			И (БухПартииЦенныхБумагЗачисление.ДисконтПремияНачисленный = БухПартииЦенныхБумагСписание.ДисконтПремияНачисленный)
		|			И (БухПартииЦенныхБумагЗачисление.КорректировкаЭСП = БухПартииЦенныхБумагСписание.КорректировкаЭСП)";
	
	Запрос.УстановитьПараметр("Организация", ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"));
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции
