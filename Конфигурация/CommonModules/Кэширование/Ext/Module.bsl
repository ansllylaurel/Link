
Функция ОпределитьНастройкуУчета(Период, Организация, СчетДоверительногоУправления, ИмяНастройки) Экспорт
	// Расчетные настройки
	ЗначениеНастройки = Неопределено;
	Если БухгалтерскийУчет.ОпределитьРасчетнуюНастройкуУчета(Период, Организация, СчетДоверительногоУправления, ИмяНастройки, ЗначениеНастройки) Тогда
		Возврат ЗначениеНастройки;
	КонецЕсли;       
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаОбщиеСрезПоследних." + ИмяНастройки + "
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаОбщиеСрезПоследних";
		
	Запрос.УстановитьПараметр("Период",                       Период);
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка[ИмяНастройки];
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции // ОпределитьНастройкуУчета

Функция ПолучитьДатуИЦенуВыкупа(Облигация, Дата, ДатаПокупки, СчетДоверительногоУправления, ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона, ИгнорироватьИнформациюОбОбязательномДосрочномПогашении, ОтборПоТипамОфертПоОблигациям, ДелатьОтборПоДатеОбъявления) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	УсловияОферт.ДатаВыкупа КАК ДатаВыкупа,
		|	УсловияОферт.Цена КАК Цена
		|ПОМЕСТИТЬ _Оферты
		|ИЗ
		|	РегистрСведений.УсловияОферт КАК УсловияОферт
		|ГДЕ
		|	УсловияОферт.Облигация = &Облигация
		|	И УсловияОферт.ДатаВыкупа >= &Дата
		|	И &ОтборПоДатеОбъявления 
		|	И &ОтборПоТипамОфертПоОблигациям 
		|	И &УчитыватьОбъявлениеОбязательногоДосрочногоПогашения
		|	И НЕ УсловияОферт.ТолькоДляФизическихЛиц
		|	И (&ДатаПокупки = НЕОПРЕДЕЛЕНО
		|			ИЛИ УсловияОферт.АкцептПо = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ИЛИ УсловияОферт.АкцептПо > &ДатаПокупки)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаВыкупа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Оферты.Цена КАК Цена,
		|	ЕСТЬNULL(КупонныйДоходПоОблигациям.ДатаОкончанияКупона, Оферты.ДатаВыкупа) КАК ДатаВыкупа
		|ИЗ
		|	_Оферты КАК Оферты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|		ПО Оферты.ДатаВыкупа >= КупонныйДоходПоОблигациям.ДатаОкончанияКупона
		|			И (КупонныйДоходПоОблигациям.Облигация = &Облигация)
		|			И (&ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона)
		|
		|УПОРЯДОЧИТЬ ПО
		|	КупонныйДоходПоОблигациям.ДатаОкончанияКупона УБЫВ");
	
	
	Если СчетДоверительногоУправления = Неопределено Тогда
		ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона = Ложь;
		УчитыватьОбъявлениеОбязательногоДосрочногоПогашения = Истина;
	Иначе
		
		Если ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона = Неопределено Тогда
		
			ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона =
				БухгалтерскийУчет.ОпределитьНастройкуУчета(Дата, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, "ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона");
				
		КонецЕсли;
		
		Если ИгнорироватьИнформациюОбОбязательномДосрочномПогашении = Неопределено Тогда
		
			ИгнорироватьИнформациюОбОбязательномДосрочномПогашении = 
				БухгалтерскийУчет.ОпределитьНастройкуУчета(Дата, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, "ИгнорироватьИнформациюОбОбязательномДосрочномПогашении");
			
		КонецЕсли;
		
		Если Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВЭБ.РФ_431") Тогда
			
			Если Дата >= '20230501' И БухгалтерскийУчетЕПС.ЭтоКлиентГруппыБудущее(СчетДоверительногоУправления, Дата) Тогда // #483764 с 1.5.23 группа будущее настройкой начинает игнорировать инфу об обяз.доср.погаш. а по этй бумаге не игнорит
			
				ИгнорироватьИнформациюОбОбязательномДосрочномПогашении = Ложь;
				
			Иначе
				
				МассивСчетовСАФМАР = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
					ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар"),
					ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
					Дата);
			
				ЭтоКлиентСАФМАР = (МассивСчетовСАФМАР.Найти(СчетДоверительногоУправления) <> Неопределено);
				
				Если ЭтоКлиентСАФМАР Тогда
					ИгнорироватьИнформациюОбОбязательномДосрочномПогашении = Ложь;
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ГТЛК_011") И Дата >= '20230101' Тогда // ГТЛК АО, 4B02-11-32432-H-001P, 1000.00 USD
			
			// #465403 #Хардкод #Техдолг
			
			Если СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_СафмарПН") Тогда // НПФ Достойное БУДУЩЕЕ  АО ПН
				ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона = Ложь;
			КонецЕсли;
			
		КонецЕсли;		
		
		Если НЕ ИгнорироватьИнформациюОбОбязательномДосрочномПогашении Тогда
			УчитыватьОбъявлениеОбязательногоДосрочногоПогашения = Истина;
		Иначе // игнорируем объявление досрочного погашения до самого дня погашения
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УчитыватьОбъявлениеОбязательногоДосрочногоПогашения",
				"(УсловияОферт.ТипОферты <> ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.Досрочно) ИЛИ УсловияОферт.ДатаВыкупа = НАЧАЛОПЕРИОДА(&Дата, День))");
		КонецЕсли;
			
	КонецЕсли;	
	
	ОтборПоДатеОбъявления = "(УсловияОферт.ДатаОбъявления = ДАТАВРЕМЯ(1, 1, 1) ИЛИ УсловияОферт.ДатаОбъявления <= &Дата)";
	Если НЕ ДелатьОтборПоДатеОбъявления ИЛИ Облигация.ДатаПогашения = '00010101' Тогда // для бессрочной бумаги оферты берем без учета объявления (#362218, #380983)
		ОтборПоДатеОбъявления = "ИСТИНА";
	КонецЕсли;	
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоДатеОбъявления", ОтборПоДатеОбъявления);
	
	Если ЗначениеЗаполнено(ОтборПоТипамОфертПоОблигациям) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоТипамОфертПоОблигациям", "УсловияОферт.ТипОферты В(&ОтборПоТипамОфертПоОблигациям)");
		
		МассивОтборПоТипамОфертПоОблигациям = Новый Массив;
		
		Если ТипЗнч(ОтборПоТипамОфертПоОблигациям) = Тип("Структура") Тогда
			Для Каждого ЗначениеОтборПоТипамОфертПоОблигациям Из ОтборПоТипамОфертПоОблигациям Цикл
				Если ИгнорироватьИнформациюОбОбязательномДосрочномПогашении И ЗначениеОтборПоТипамОфертПоОблигациям.Значение = Перечисления.ТипыОфертПоОблигациям.Досрочно Тогда
					Продолжить;	
				Иначе	
					МассивОтборПоТипамОфертПоОблигациям.Добавить(ЗначениеОтборПоТипамОфертПоОблигациям.Значение);
				КонецЕсли;	
			КонецЦикла;	
		ИначеЕсли ТипЗнч(ОтборПоТипамОфертПоОблигациям) = Тип("ПеречислениеСсылка.ТипыОфертПоОблигациям") Тогда	
			Если ИгнорироватьИнформациюОбОбязательномДосрочномПогашении И ОтборПоТипамОфертПоОблигациям <> Перечисления.ТипыОфертПоОблигациям.Досрочно Тогда
				МассивОтборПоТипамОфертПоОблигациям.Добавить(ОтборПоТипамОфертПоОблигациям);	
			КонецЕсли;	
		КонецЕсли;	
			
		Запрос.УстановитьПараметр("ОтборПоТипамОфертПоОблигациям", 								МассивОтборПоТипамОфертПоОблигациям);
	Иначе
		Запрос.УстановитьПараметр("ОтборПоТипамОфертПоОблигациям", 								Истина);
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("Облигация",													Облигация);
	Запрос.УстановитьПараметр("Дата",														Дата);
	Запрос.УстановитьПараметр("ДатаПокупки",												ДатаПокупки);
	Запрос.УстановитьПараметр("ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона", ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона);
	Запрос.УстановитьПараметр("УчитыватьОбъявлениеОбязательногоДосрочногоПогашения", 		УчитыватьОбъявлениеОбязательногоДосрочногоПогашения);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		ДатаВыкупа	= ВыборкаДетальныеЗаписи.ДатаВыкупа;
		ЦенаВыкупа	= ВыборкаДетальныеЗаписи.Цена;
		
	Иначе
		
		РеквизитыОблигации	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Облигация, "ДатаПогашения, ИндексируемыйНоминал, Амортизационная");
		ДатаВыкупа			= ?(ЗначениеЗаполнено(РеквизитыОблигации.ДатаПогашения), РеквизитыОблигации.ДатаПогашения, Неопределено);
		
		Если РеквизитыОблигации.ИндексируемыйНоминал И (ДатаВыкупа = Неопределено ИЛИ ДатаВыкупа > Дата)
			ИЛИ РеквизитыОблигации.Амортизационная И ДатаВыкупа = Неопределено
		Тогда 
			ЦенаВыкупа = Неопределено;
		Иначе
			ЦенаВыкупа = Справочники.Облигации.ПолучитьНоминал(Облигация, ДатаВыкупа);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Новый Структура("ДатаВыкупа, ЦенаВыкупа", ДатаВыкупа, ЦенаВыкупа); 
	
КонецФункции

Функция СчетаДоверительногоУправленияКлиента(Клиент, Организация, Период) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.Организация КАК Организация
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО (СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления)
		|			И (СчетаДоверительногоУправления.Организация = &Организация)
		|			И (НЕ СчетаДоверительногоУправления.ПометкаУдаления)
		|			И (СчетаДоверительногоУправления.ДатаЗаключения <= &Период)
		|			И (СчетаДоверительногоУправления.ДатаРасторжения > &Период
		|				ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|ГДЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент = &Клиент");
	
	Запрос.УстановитьПараметр("Период",		 Период);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Клиент",		 Клиент);
			
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция УчетныеАктивыОцениваемыеПоАмортизированнойСтоимости() Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УчетныеАктивыЕПС.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|ГДЕ
		|	УчетныеАктивыЕПС.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПСД), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ВекселяДоПогашения))");
			
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	
КонецФункции

Функция ВидЗадолженностиСвязанСПартиями(ВидЗадолженности) Экспорт

	МассивВидовЗадолженностиСвязанныхСПартиями = Новый Массив;
	
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоТорговойКомиссии);
	
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюВекселя);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюКупона);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюОблигации);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюПая);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоВозвратуКупонногоДохода);
	
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоСделке);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоФорвардуПоставки);
	
	Возврат (МассивВидовЗадолженностиСвязанныхСПартиями.Найти(ВидЗадолженности) <> Неопределено);

КонецФункции

Функция ОбъявленаОбязательнаяДосрочнаяОферта(Облигация, Дата) Экспорт

	ПараметрыОферты = Новый Структура("Объявлена,ДатаВыкупа,Цена", Ложь, '00010101', 0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(УсловияОферт.ДатаВыкупа) КАК ДатаВыкупа
		|ПОМЕСТИТЬ _ДатаДосрочнойОферты
		|ИЗ
		|	РегистрСведений.УсловияОферт КАК УсловияОферт
		|ГДЕ
		|	УсловияОферт.Облигация = &Облигация
		|	И УсловияОферт.ДатаОбъявления <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|	И УсловияОферт.ДатаОбъявления <= &ДатаОбъявления
		|	И УсловияОферт.ТипОферты = ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.Досрочно)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИСТИНА КАК Объявлена,
		|	УсловияОферт.ДатаВыкупа КАК ДатаВыкупа,
		|	УсловияОферт.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.УсловияОферт КАК УсловияОферт
		|ГДЕ
		|	УсловияОферт.Облигация = &Облигация
		|	И УсловияОферт.ТипОферты = ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.Досрочно)
		|	И УсловияОферт.ДатаВыкупа В
		|			(ВЫБРАТЬ
		|				_ДатаДосрочнойОферты.ДатаВыкупа
		|			ИЗ
		|				_ДатаДосрочнойОферты)";
	
	Запрос.УстановитьПараметр("ДатаОбъявления", Дата);
	Запрос.УстановитьПараметр("Облигация", Облигация);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыОферты, ВыборкаДетальныеЗаписи);
	КонецЕсли;

	Возврат ПараметрыОферты;
	
КонецФункции

Функция ПолучитьНоминал(Облигация, Дата) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НоминалыЦенныхБумагСрезПоследних.Номинал
		|ИЗ
		|	РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&Дата, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ЦеннаяБумага", Облигация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Номинал;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

