
#Область Получение_расчетного_купона

Функция ПолучитьРасчетныйКупон(ЦеннаяБумага, Период, СчетДоверительногоУправления, НаУтро = Ложь, ТочностьОкругления = 2, ДанныеКупона = Неопределено) Экспорт

	Если ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финстандарт") Тогда		
		Возврат РассчитатьКотировкуКупона_Финстандарт(Период, 0);
	ИначеЕсли ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_АрчерФинанс") Тогда
	
		Если Период >= '20221031' Тогда // все, банкрот, фиксируем купон на 15.05.2022
			Возврат 501.84;	
		Иначе
			Возврат РассчитатьКотировкуКупона_АрчерФинанс(Период);
		КонецЕсли;
		
	ИначеЕсли ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финстоун") И Период >= '20180111' Тогда
	
		Если Период >= '20221031' Тогда // все, банкрот, фиксируем купон на 30.03.2022
			Возврат 474.03;
		Иначе
			Возврат РассчитатьКотировкуКупона_Финстоун(Период);
		КонецЕсли;
		
	ИначеЕсли ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОткрытиеХолдинг") Тогда
		
		Если Период >= '20180125' И Период < '20200722' Тогда
			Возврат РассчитатьКотировкуКупона_ОткрытиеХолдинг4B0203(ЦеннаяБумага, Период);
			
		ИначеЕсли Период >= '20221117' Тогда // все, банкрот, фиксируем купон на УТРО(!!!) 20.07.2022, с этой даты все клиенты признали его банкротом
			Возврат 0.04;
		ИначеЕсли Период >= '20221031' // а с этой даты его признали банкротом все, кроме Сафмара - они опять не такие как все
			И Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период) <> ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар") Тогда 
			Возврат 0.04;
		КонецЕсли;
		
	ИначеЕсли ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОткрХолдинг_004") Тогда
		
		Если Период >= '20221117' Тогда // все, банкрот, фиксируем купон на УТРО(!!!) 20.07.2022, с этой даты все клиенты признали его банкротом
			Возврат 0.02;
		ИначеЕсли Период >= '20221031' // а с этой даты его признали банкротом все, кроме Сафмара - они опять не такие как все
			И Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период) <> ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар") Тогда 
			Возврат 0.02;
		КонецЕсли;
		
	ИначеЕсли ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ГазпромКап_001") И Период >= '20221011' И Период < '20221028' Тогда
		Возврат ПолучитьКотировкуКупона_ГазпромКап40136400R003P(Период);
	ИначеЕсли ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Роснефть_005") И Период >= '20240223' И Период <= '20240227' Тогда
		
		// эмитент не объявил купон и бумага, скорее всего, пойдет на оферту 28.02.24 (https://www.moex.com/n67861?nt=101)
		// вечером 26.02.24 эмитент таки дал ставку, но мы начинаем использовать ее с 27.02.24
		Если Период < '20240227' Тогда
			Возврат 0; 
		Иначе // прогнувшись под СД ВТБ, клиенты Ханты, ППА и СФР решили и 27.02.24 считать купон нулевым
			КлиентДоверительногоУправления = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период);
			Если КлиентДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_ППА")
				ИЛИ КлиентДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФХантыМансийский")
				ИЛИ КлиентДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ПФР") Тогда
				
				Возврат 0
			
			КонецЕсли;
			
		КонецЕсли;

	// временная срочная затыка пока не реализовал формулу
	ИначеЕсли (ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин29026")
				ИЛИ ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин29027"))
		И Период >= '20241213' И Период <= '20241215' Тогда
		
		Если ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин29026") Тогда
			Если Период = '20241213' Тогда
				Возврат 5.17;
			ИначеЕсли Период = '20241214' Тогда
				Возврат 5.74;
			ИначеЕсли Период = '20241215' Тогда
				Возврат 6.31;
			КонецЕсли;
		ИначеЕсли ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин29027") Тогда
			Если Период = '20241213' Тогда
				Возврат 1.15;
			ИначеЕсли Период = '20241214' Тогда
				Возврат 1.71;
			ИначеЕсли Период = '20241215' Тогда
				Возврат 2.28;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВЭБ_РФ_ВЭБ2Р-50") Тогда
	
		Возврат РассчитатьКотировкуКупонаПоИндексуРУОНИАиСпреду(ЦеннаяБумага, Период, 2.3);
		
	ИначеЕсли ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВЭБ.РФ_210") Тогда
		
		Возврат РассчитатьКотировкуКупонаПоИндексуРУОНИАиСпреду(ЦеннаяБумага, Период, 1.75);	
		
	ИначеЕсли ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВЭБ_РФ_ПБО_002Р_52") Тогда
		
		Возврат РассчитатьКотировкуКупонаПоИндексуРУОНИАиСпреду(ЦеннаяБумага, Период, 1.85);	
		
	КонецЕсли;
	
	// для бумаг с реструктуризацией купонных платежей
	Добавка = 0; 
	Если ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_БизнесКонсалтиг")
		ИЛИ ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_БКЗ_ФИНАНС")
		ИЛИ ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ТМ-энергоФинанс")
		ИЛИ ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1_Груп_Финанс") Тогда
		
		Если НаУтро Тогда
			Добавка = ПолучитьДобавкуПоБумагамСРеструктуризацией(ЦеннаяБумага, Период - 1);
		Иначе
			Добавка = ПолучитьДобавкуПоБумагамСРеструктуризацией(ЦеннаяБумага, Период);
		КонецЕсли;
	
	КонецЕсли;
	
	#Область ПропертизФинанс01_для_Будущего_и_ТелекомСоюза_с_03_10_2020 
	
	Если Период >= '20201003' И Период < '20201118'
		И ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1_ПропертизФин")
	Тогда
	
		МассивСчетовБудущее = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
			ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_БУДУЩЕЕ"), ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"), Период);
		МассивСчетовТелекомСоюз = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
			ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_ТелекомСоюз"), ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"), Период);
	
		Если МассивСчетовБудущее.Найти(СчетДоверительногоУправления) <> Неопределено
			ИЛИ МассивСчетовТелекомСоюз.Найти(СчетДоверительногоУправления) <> Неопределено
		Тогда
			Возврат 0;
		КонецЕсли;
		
	КонецЕсли;
	
	#КонецОбласти	
	
	Если ДанныеКупона = Неопределено Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	МАКСИМУМ(КупонныйДоходПоОблигациям.Период) КАК Период,
			|	МАКСИМУМ(КупонныйДоходПоОблигациям.НомерКупона) КАК НомерКупона
			|ПОМЕСТИТЬ НашПериод
			|ИЗ
			|	Справочник.Облигации КАК Облигации
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
			|		ПО (КупонныйДоходПоОблигациям.Облигация = Облигации.Ссылка)
			|ГДЕ
			|	Облигации.Ссылка = &ЦеннаяБумага
			|	И КупонныйДоходПоОблигациям.Период <= &Период
			|	И (Облигации.ДатаПогашения >= &Период
			|			ИЛИ Облигации.ДатаПогашения = ДАТАВРЕМЯ(1, 1, 1))
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НашПериод.Период КАК Период,
			|	КупонныйДоходПоОблигациям.СтавкаКупона КАК Процент,
			|	КупонныйДоходПоОблигациям.СуммаКупона КАК СуммаКупона,
			|	КупонныйДоходПоОблигациям.Срок КАК Срок,
			|	КупонныйДоходПоОблигациям.ДатаОкончанияКупона КАК ДатаОкончанияКупона,
			|	ФормулыРасчетаСтавокКупоновСрезПоследних.ФормулаРасчетаСтавки КАК ФормулаРасчетаСтавки,
			|	КупонныйДоходПоОблигациям.СтавкаКупона <> 0
			|		И КупонныйДоходПоОблигациям.СтавкаОпределена
			|		И КупонныйДоходПоОблигациям.ДатаПубликации <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
			|		И КупонныйДоходПоОблигациям.ДатаПубликации < &Период КАК СтавкаОпределена,
			|	КупонныйДоходПоОблигациям.Облигация.ИндексируемыйНоминал КАК ИндексируемыйНоминал,
			|	КупонныйДоходПоОблигациям.Облигация.Категория КАК Категория,
			|	КупонныйДоходПоОблигациям.Облигация.БазаРасчета КАК БазаРасчета
			|ИЗ
			|	НашПериод КАК НашПериод
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
			|		ПО НашПериод.Период = КупонныйДоходПоОблигациям.Период
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФормулыРасчетаСтавокКупонов.СрезПоследних(&Период, Облигация = &ЦеннаяБумага) КАК ФормулыРасчетаСтавокКупоновСрезПоследних
			|		ПО НашПериод.НомерКупона = ФормулыРасчетаСтавокКупоновСрезПоследних.НомерКупона
			|ГДЕ
			|	КупонныйДоходПоОблигациям.Облигация = &ЦеннаяБумага";

		Запрос.УстановитьПараметр("Период", Период);
		Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);

		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();

		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			
			НачалоПериода = ВыборкаДетальныеЗаписи.Период;
			Процент = ВыборкаДетальныеЗаписи.Процент;
			СуммаКупона = ВыборкаДетальныеЗаписи.СуммаКупона;
			Срок = ВыборкаДетальныеЗаписи.Срок;
			ДатаОкончанияКупона = ВыборкаДетальныеЗаписи.ДатаОкончанияКупона;
			ФормулаРасчетаСтавки = ВыборкаДетальныеЗаписи.ФормулаРасчетаСтавки;
			ИндексируемыйНоминал = ВыборкаДетальныеЗаписи.ИндексируемыйНоминал;
			Категория = ВыборкаДетальныеЗаписи.Категория;
			НачалоНоминалы = Неопределено;
			СтавкаОпределена = ВыборкаДетальныеЗаписи.СтавкаОпределена;
			БазаРасчета = ВыборкаДетальныеЗаписи.БазаРасчета;
			
		Иначе
			Возврат 0 + Добавка;
		КонецЕсли;
		
	Иначе
		
		НачалоПериода = ДанныеКупона.Период;
		Процент = ДанныеКупона.Процент;
		СуммаКупона = ДанныеКупона.СуммаКупона;
		Срок = ДанныеКупона.Срок;
		ДатаОкончанияКупона = ДанныеКупона.ДатаОкончанияКупона;
		ФормулаРасчетаСтавки = ДанныеКупона.ФормулаРасчетаСтавки;
		ИндексируемыйНоминал = ДанныеКупона.ИндексируемыйНоминал;
		Категория = ДанныеКупона.Категория;
		НачалоНоминалы = ДанныеКупона.ПериодНоминала;
		СтавкаОпределена = ДанныеКупона.СтавкаОпределена;
		БазаРасчета = ДанныеКупона.БазаРасчета;
		
	КонецЕсли;
	
	Если НаУтро И ДатаОкончанияКупона = Период Тогда
		Возврат СуммаКупона; 
	КонецЕсли;
	
	Если ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ПСБ_013") // ждем когда матрикс чухнется и исправит, а пока хардкодим
		ИЛИ ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Промсвязьбанк") Тогда
	
		БазаРасчета = Перечисления.БазыРасчетаОблигаций.Act365Fixed;
		
	ИначеЕсли ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ГазпромКап_004")
		ИЛИ ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ГазпромКапиталООО_014")
		ИЛИ ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ГазпромКапиталООО_015")
		ИЛИ ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ГазпромКапиталООО_016") Тогда
		
		БазаРасчета = Перечисления.БазыРасчетаОблигаций.ActICMA;
		
	КонецЕсли;
	
	// Ситуация: что по облигациям бывают торги в режиме «Размещение: Адресные заявки» до того как начнутся купонные периоды
	// В эти дни в котировках купон равен нулю, но проверка начинает считать купон за этот день и падает из-за отсутствия купонного периода
	// Пример: облигация «Сбербанк ПАО, 4B02-582-01481-B-001P, 1000.00 RUB»
	// Это условие по отработке этого момента
	Если НачалоПериода = Null Тогда
		Возврат 0;	
	КонецЕсли;
	
	// Тут идут хардкоды для замещающих облигаций, у них начало купона условное(для правильного расчета должно быть другое) и Матрикс дает направильную ставку
	Если Период >= '20221122' И Период < '20230127'
		И ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Газпромкап7доп")
	Тогда
		НачалоПериода = '20220727';
		Процент = 2.95;
	КонецЕсли;
	
	Если Период >= '20230220' И Период < '20230321'
		И ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ГазпромКапиталООО_014")
	Тогда
		НачалоПериода = '20220321';
		Процент = 4.364;
	КонецЕсли;
	
	Если Период >= '20230301' И Период < '20230415'
		И ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ГазпромКапиталООО_016")
	Тогда
		НачалоПериода = '20220415';
		Процент = 2.95;
	КонецЕсли;
	
	Если Период >= '20221110'
		И ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_CBOM_Finance_XS1601094755")
	Тогда
		Процент = 8.974;
	КонецЕсли;
	
	Если Период >= '20231115' И Период < '20231130'
		И ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ГТЛК_003")
	Тогда
		НачалоПериода = '20230531';
		Процент = 5.125;
	КонецЕсли;
	
	Если Период >= '20231130' И Период < '20240218'
		И ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ГТЛК_005_НеBO")
	Тогда
		НачалоПериода = '20230818';
		Процент = 4.949;
	КонецЕсли;
	
	Если Период >= '20231205' И Период < '20240311'
		И ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_НорильскийНикель_005")
	Тогда
		НачалоПериода = '20230911';
		Процент = 2.55;
	КонецЕсли;	
	
	Если Период >= '20240614' И Период < '20250602'
