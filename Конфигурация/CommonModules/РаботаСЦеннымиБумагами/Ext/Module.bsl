Функция ПолучитьОблигацииСРасчетнымКупономНаДату(НаДату) Экспорт 

	ТаблицаОблигаций = ПолучитьОблигацииСРасчетнымКупоном();
	
	МассивОблигаций = Новый Массив();
	
	Для каждого СтрокаТаблицыОблигаций Из ТаблицаОблигаций Цикл
		Если (СтрокаТаблицыОблигаций.ДатаНачала = '00010101' ИЛИ СтрокаТаблицыОблигаций.ДатаНачала <= НаДату)
			И (СтрокаТаблицыОблигаций.ДатаОкончания = '00010101' ИЛИ СтрокаТаблицыОблигаций.ДатаОкончания >= НаДату) Тогда
			МассивОблигаций.Добавить(СтрокаТаблицыОблигаций.Облигация);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивОблигаций;

КонецФункции 

Функция ПолучитьДатыПримененияРасчетногоКупона(Облигация) Экспорт 

	ТаблицаОблигаций = ПолучитьОблигацииСРасчетнымКупоном();
	
	СтрокиОблигации = ТаблицаОблигаций.НайтиСтроки(Новый Структура("Облигация", Облигация));
	Если СтрокиОблигации.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
	    Возврат Новый Структура("ДатаНачала,ДатаОкончания", СтрокиОблигации[0].ДатаНачала, СтрокиОблигации[0].ДатаОкончания);
	КонецЕсли;

КонецФункции 

// В переданном документе заполняет ценные бумаги по ISIN и находит партии по номеру и дате сделки
//
//	Параметры:
//		ДокументОбъект 				- Объект документа 
//		АдресВоВременномХранилище 	- Строка - адрес файла Excel во временном хранилище
//
Процедура ЗаполнитьЦенныеБумагиИПартииПоДаннымФайлаExcel(ДокументОбъект, АдресВоВременномХранилище) Экспорт
	
	Если ЭтоАдресВременногоХранилища(АдресВоВременномХранилище) Тогда
		
		ПутьКФайлу				= ПолучитьИмяВременногоФайла("xlsx");
			
		ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
		ДвоичныеДанныеФайла.Записать(ПутьКФайлу);
		
		УдалитьИзВременногоХранилища(АдресВоВременномХранилище);
		
	Иначе
		Возврат;
	КонецЕсли;

	ЗаполнитьПартии = ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ВыводЦенныхБумаг");
	
	ТаблицаФайла = Новый ТабличныйДокумент;
	ТаблицаФайла.Прочитать(ПутьКФайлу, СпособЧтенияЗначенийТабличногоДокумента.Текст);
	МассивСтрокФайла = Новый Массив;
	
	ИсходныеДанныеПоЦеннымБумагам = ДокументОбъект.ЦенныеБумаги.Выгрузить();
		
	ИсходныеДанныеПоЦеннымБумагам.Колонки.Добавить("ISIN", 				Новый ОписаниеТипов("Строка",,,, 	Новый КвалификаторыСтроки(30)));
	ИсходныеДанныеПоЦеннымБумагам.Колонки.Добавить("НомерСделки", 		Новый ОписаниеТипов("Строка",,,, 	Новый КвалификаторыСтроки(16)));
	ИсходныеДанныеПоЦеннымБумагам.Колонки.Добавить("НомерСтрокиФайла", 	Новый ОписаниеТипов("Число",,,		Новый КвалификаторыЧисла(10, 0)));
	
	// Если в файле несколько закладок, они загружаются в отдельные области
	// Найдем область, соответствующую первой закладке
	НомерПоследнейСтрокиОбласти = 0;
	Для Каждого ТекОбласть Из ТаблицаФайла.Области Цикл
		Если ТекОбласть.Верх = 1 Тогда
			НомерПоследнейСтрокиОбласти = ТекОбласть.Низ;
			Прервать;                     		
		КонецЕсли;
	КонецЦикла;	
	
	Если НомерПоследнейСтрокиОбласти = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка чтения файла");
		Возврат;		
	КонецЕсли;
	
	Отказ = Ложь;
	НомерПервойСтрокиДанных = 0;
	Для НомСтр = 1 По НомерПоследнейСтрокиОбласти Цикл
		
		Количество = СтрЗаменить(ТаблицаФайла.Область(НомСтр, 7,НомСтр, 7).Текст, Символы.НПП, "");
		
		Если Количество = "" Тогда	
			Продолжить;
		КонецЕсли;
		
		Если НомерПервойСтрокиДанных = 0 И РаботаСоСтрокамиКлиентСервер.ТолькоЦифрыВСтроке(СтрЗаменить(Количество, ",", ""), , Ложь) Тогда 
			// Нашли количество - считаем, что это первая строка данных
			НомерПервойСтрокиДанных = НомСтр;			
		ИначеЕсли НомерПервойСтрокиДанных = 0 Тогда
			Продолжить;
		КонецЕсли;
				
		ISIN = СокрЛП(ТаблицаФайла.Область(НомСтр, 4,НомСтр, 4).Текст);
		
		НоваяСтрока = ИсходныеДанныеПоЦеннымБумагам.Добавить();
		
		НоваяСтрока.ISIN				= ISIN;
		НоваяСтрока.НомерСтрокиФайла	= НомСтр;
		   		
		Попытка			
			НоваяСтрока.Количество = Число(Количество);
		Исключение                             			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("При загрузке из файла произошла ошибка: %1!%2Строка №%3. Загрузка прервана",  + ОписаниеОшибки(), Символы.ПС, НоваяСтрока.НомерСтрокиФайла),,,, Отказ);			
			Прервать;                          			
		КонецПопытки;

		// В поручении другие колонки не заполняем
		Если Не ЗаполнитьПартии Тогда		
			Продолжить;
		КонецЕсли;
		
		// В выводе дополняем данными по партиям
		НоваяСтрока.НомерСделки = СокрЛП(СтрЗаменить(ТаблицаФайла.Область(НомСтр, 5,НомСтр, 5).Текст, Символы.НПП, ""));
		
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Загрузка завершена. Обработано " + Строка(НомерПоследнейСтрокиОбласти) + " строк.");
	
	КоличествоСтрокДанных = ИсходныеДанныеПоЦеннымБумагам.Количество();
	Если КоличествоСтрокДанных = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НомерПоследнейСтрокиДанных = ИсходныеДанныеПоЦеннымБумагам[КоличествоСтрокДанных - 1].НомерСтрокиФайла;	
	
	#Область Текст_запроса
	
	Запрос = Новый Запрос(
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	ИсходныеДанныеПоЦеннымБумагам.НомерСтрокиФайла КАК НомерСтроки,
	    |	ИсходныеДанныеПоЦеннымБумагам.ISIN КАК ISIN,
	    |	ИсходныеДанныеПоЦеннымБумагам.НомерСделки КАК НомерСделки,
	    |	ИсходныеДанныеПоЦеннымБумагам.Количество КАК Количество
	    |ПОМЕСТИТЬ _ИсходныеДанныеПоЦеннымБумагам
	    |ИЗ
	    |	&ИсходныеДанныеПоЦеннымБумагам КАК ИсходныеДанныеПоЦеннымБумагам
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_ИсходныеДанныеПоЦеннымБумагам.НомерСтроки КАК НомерСтроки,
	    |	ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
	    |	_ИсходныеДанныеПоЦеннымБумагам.ISIN КАК ISIN,
	    |	_ИсходныеДанныеПоЦеннымБумагам.НомерСделки КАК НомерСделки,
	    |	_ИсходныеДанныеПоЦеннымБумагам.Количество КАК Количество,
	    |	КодыВТорговыхСистемахСрезПоследних.Объект ЕСТЬ НЕ NULL  КАК ЦеннаяБумагаНайдена
	    |ПОМЕСТИТЬ _ЦенныеБумаги
	    |ИЗ
	    |	_ИсходныеДанныеПоЦеннымБумагам КАК _ИсходныеДанныеПоЦеннымБумагам
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
	    |		ПО _ИсходныеДанныеПоЦеннымБумагам.ISIN = КодыВТорговыхСистемахСрезПоследних.Код
	    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
	    |				&Период,
	    |				Организация = &Организация
	    |					И СчетДоверительногоУправления = &СчетДоверительногоУправления
	    |					И ДепозитарныйСчет = &ДепозитарныйСчет
	    |					И Рынок = &Рынок) КАК ОстаткиЦенныхБумагОстатки
	    |		ПО (КодыВТорговыхСистемахСрезПоследних.Объект = ОстаткиЦенныхБумагОстатки.ЦеннаяБумага)
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
	    |	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
	    |	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
	    |	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
	    |	ВЫБОР
	    |		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.Сделка)
	    |			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.Партия КАК Документ.Сделка).НомерСделки
	    |		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
	    |			ТОГДА ВЫРАЗИТЬ(ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.Партия КАК Документ.ИсполнениеОбязательствПоСделке).Основание КАК Документ.Сделка).НомерСделки
	    |		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ВводЦенныхБумаг)
	    |			ТОГДА ВводЦенныхБумагЦенныеБумаги.НомерСделки
	    |		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.РеклассификацияАктивовЕПС)
	    |			ТОГДА РеклассификацияАктивовЕПСПартии.НомерСделки
	    |		ИНАЧЕ """"
	    |	КОНЕЦ КАК НомерСделки,
	    |	БухПартииЦенныхБумагОстатки.Партия.Дата КАК ДатаПартии,
	    |	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК КоличествоНаПартии
	    |ПОМЕСТИТЬ _БухПартииЦенныхБумагОстатки
	    |ИЗ
	    |	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
	    |			&Период,
	    |			Организация = &Организация
	    |				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	    |				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
	    |				И Рынок = &Рынок) КАК БухПартииЦенныхБумагОстатки
	    |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
	    |		ПО БухПартииЦенныхБумагОстатки.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
	    |			И БухПартииЦенныхБумагОстатки.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
	    |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеклассификацияАктивовЕПС.Партии КАК РеклассификацияАктивовЕПСПартии
	    |		ПО БухПартииЦенныхБумагОстатки.Партия = РеклассификацияАктивовЕПСПартии.Ссылка
	    |			И БухПартииЦенныхБумагОстатки.СтрокаПартии = РеклассификацияАктивовЕПСПартии.НомерСтроки
	    |ГДЕ
	    |	&ЗаполнитьПартии
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
	    |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ БухПартииЦенныхБумагОстатки.Партия) КАК Партия,
	    |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ БухПартииЦенныхБумагОстатки.СтрокаПартии) КАК СтрокаПартии
	    |ПОМЕСТИТЬ _БухПартииЦенныхБумагОстаткиСОднойПартией
	    |ИЗ
	    |	_БухПартииЦенныхБумагОстатки КАК БухПартииЦенныхБумагОстатки
	    |
	    |СГРУППИРОВАТЬ ПО
	    |	БухПартииЦенныхБумагОстатки.ЦеннаяБумага
	    |
	    |ИМЕЮЩИЕ
	    |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ БухПартииЦенныхБумагОстатки.Партия) = 1 И
	    |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ БухПартииЦенныхБумагОстатки.СтрокаПартии) = 1
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
	    |	_БухПартииЦенныхБумагОстатки.Партия КАК Партия,
	    |	_БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
	    |	_БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
	    |	_БухПартииЦенныхБумагОстатки.НомерСделки КАК НомерСделки,
	    |	_БухПартииЦенныхБумагОстатки.ДатаПартии КАК ДатаПартии,
	    |	_БухПартииЦенныхБумагОстатки.КоличествоНаПартии КАК КоличествоНаПартии,
	    |	_БухПартииЦенныхБумагОстаткиСОднойПартией.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК ОднаПартия
	    |ПОМЕСТИТЬ _БухПартииЦенныхБумагОстаткиСПризнакомОднойПартии
	    |ИЗ
	    |	_БухПартииЦенныхБумагОстатки КАК _БухПартииЦенныхБумагОстатки
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _БухПартииЦенныхБумагОстаткиСОднойПартией КАК _БухПартииЦенныхБумагОстаткиСОднойПартией
	    |		ПО _БухПартииЦенныхБумагОстатки.ЦеннаяБумага = _БухПартииЦенныхБумагОстаткиСОднойПартией.ЦеннаяБумага
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_ЦенныеБумаги.ISIN КАК ISIN,
	    |	_ЦенныеБумаги.НомерСтроки КАК НомерСтроки,
	    |	_ЦенныеБумаги.НомерСделки КАК НомерСделки,
	    |	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
	    |	_ЦенныеБумаги.Количество КАК Количество,
	    |	_ЦенныеБумаги.ЦеннаяБумагаНайдена КАК ЦеннаяБумагаНайдена,
	    |	_ЦенныеБумаги.НомерСделки <> """" КАК ЕстьНомерСделки,
	    |	_ЦенныеБумаги.НомерСделки <> """"
	    |			И _БухПартииЦенныхБумагОстаткиСПризнакомОднойПартии.Партия ЕСТЬ НЕ NULL 
	    |		ИЛИ _БухПартииЦенныхБумагОстаткиСПризнакомОднойПартии.Партия ЕСТЬ НЕ NULL  КАК ПартияНайдена,
	    |	_БухПартииЦенныхБумагОстаткиСПризнакомОднойПартии.Партия КАК Партия,
	    |	_БухПартииЦенныхБумагОстаткиСПризнакомОднойПартии.СтрокаПартии КАК СтрокаПартии,
	    |	_БухПартииЦенныхБумагОстаткиСПризнакомОднойПартии.ДатаПартии КАК ДатаПартии,
	    |	_БухПартииЦенныхБумагОстаткиСПризнакомОднойПартии.КоличествоНаПартии КАК КоличествоНаПартии,
	    |	_БухПартииЦенныхБумагОстаткиСПризнакомОднойПартии.УчетныйАктивЕПС КАК УчетныйАктивЕПС
	    |ПОМЕСТИТЬ _Результат
	    |ИЗ
	    |	_ЦенныеБумаги КАК _ЦенныеБумаги
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _БухПартииЦенныхБумагОстаткиСПризнакомОднойПартии КАК _БухПартииЦенныхБумагОстаткиСПризнакомОднойПартии
	    |		ПО _ЦенныеБумаги.ЦеннаяБумага = _БухПартииЦенныхБумагОстаткиСПризнакомОднойПартии.ЦеннаяБумага
	    |			И (ВЫБОР
	    |				КОГДА _ЦенныеБумаги.НомерСделки <> """"
	    |					ТОГДА _ЦенныеБумаги.НомерСделки = _БухПартииЦенныхБумагОстаткиСПризнакомОднойПартии.НомерСделки
	    |				ИНАЧЕ _БухПартииЦенныхБумагОстаткиСПризнакомОднойПартии.УчетныйАктивЕПС В (&УчетныеАктивыПоАС)
	    |						И _БухПартииЦенныхБумагОстаткиСПризнакомОднойПартии.ОднаПартия
	    |			КОНЕЦ)
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_Результат.ЦеннаяБумага КАК ЦеннаяБумага,
	    |	_Результат.Количество КАК Количество,
	    |	ЗНАЧЕНИЕ(Документ.Сделка.) КАК Партия,
	    |	0 КАК СтрокаПартии,
	    |	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.) КАК УчетныйАктивЕПС
	    |ИЗ
	    |	_Результат КАК _Результат
	    |ГДЕ
	    |	_Результат.УчетныйАктивЕПС ЕСТЬ NULL");
	
	#КонецОбласти
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Организация",					ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ДокументОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Рынок",							ДокументОбъект.Рынок);
	Запрос.УстановитьПараметр("ДепозитарныйСчет",				ДокументОбъект.ДепозитарныйСчет);
	Запрос.УстановитьПараметр("ИсходныеДанныеПоЦеннымБумагам",	ИсходныеДанныеПоЦеннымБумагам);
	Запрос.УстановитьПараметр("Период",							Новый Граница(ДокументОбъект.Дата, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ЗаполнитьПартии",				ЗаполнитьПартии);
	Запрос.УстановитьПараметр("УчетныеАктивыПоАС", 				Кэширование.УчетныеАктивыОцениваемыеПоАмортизированнойСтоимости());
	
	ЦенныеБумагиБезУчетныхАктивов = Запрос.Выполнить().Выгрузить();	
	
	Отказ = Ложь;
	Если ЗаполнитьПартии Тогда
		ЗаполнитьУчетныеАктивыЕПСИПоместитьВМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц, ДокументОбъект.Дата, ДокументОбъект, ЦенныеБумагиБезУчетныхАктивов, "_ЦенныеБумагиСУчетнымиАктивамиЕПС", Отказ);
	КонецЕсли;
	
	// Если Отказ = Истина, используем исходную таблицу, без дозаполненных учетных активов ЕПС	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Результат.ISIN КАК ISIN,
		|	_Результат.НомерСтроки КАК НомерСтроки,
		|	_Результат.НомерСделки КАК НомерСделки,
		|	_Результат.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_Результат.Количество КАК Количество,
		|	_Результат.КоличествоНаПартии КАК КоличествоНаПартии,
		|	_Результат.ЦеннаяБумагаНайдена КАК ЦеннаяБумагаНайдена,
		|	_Результат.ПартияНайдена КАК ПартияНайдена,
		|	_Результат.ЕстьНомерСделки КАК ЕстьНомерСделки,
		|	_Результат.Партия КАК Партия,
		|	_Результат.СтрокаПартии КАК СтрокаПартии,
		|	_Результат.ДатаПартии КАК ДатаПартии,
		|	&УчетныйАктивЕПС КАК УчетныйАктивЕПС
		|ИЗ
		|	_Результат КАК _Результат
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки,
		|	ДатаПартии,
		|	СтрокаПартии";
	
	Если Отказ Или Не ЗаполнитьПартии Тогда 		
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УчетныйАктивЕПС", "_Результат.УчетныйАктивЕПС");
		
	Иначе	
			
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "_Результат КАК _Результат", "_Результат КАК _Результат		    
			|ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумагиСУчетнымиАктивамиЕПС КАК _ЦенныеБумагиСУчетнымиАктивамиЕПС
			|ПО _Результат.ЦеннаяБумага = _ЦенныеБумагиСУчетнымиАктивамиЕПС.ЦеннаяБумага
			|И _Результат.НомерСтроки = _ЦенныеБумагиСУчетнымиАктивамиЕПС.НомерСтроки");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УчетныйАктивЕПС", "ЕСТЬNULL(_Результат.УчетныйАктивЕПС, _ЦенныеБумагиСУчетнымиАктивамиЕПС.УчетныйАктивЕПС)");
		
	КонецЕсли;

	ЦенныеБумаги = Запрос.Выполнить().Выгрузить();	
	
	Если ДокументОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
		ТипЦБСтрокой = "акцию";
	ИначеЕсли ДокументОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		ТипЦБСтрокой = "облигацию";
	Иначе
		ТипЦБСтрокой = "пай";
	КонецЕсли;
	
	// Проверяем, все ли ценные бумаги найдены по ISIN
	СтрокиСПустымиЦБ = ЦенныеБумаги.НайтиСтроки(Новый Структура("ЦеннаяБумагаНайдена", Ложь));
	Для Каждого СтрокаСПустойЦБ Из СтрокиСПустымиЦБ Цикл		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось определить %1 по ISIN '%2'! Строка  №%3 файла. Загрузка прервана", ТипЦБСтрокой, СтрокаСПустойЦБ.ISIN, СтрокаСПустойЦБ.НомерСтроки));	
	КонецЦикла;
	
	Если ЗаполнитьПартии Тогда
		
		// Проверяем, все ли партии найдены
		СтрокиСПустымиПартиями = ЦенныеБумаги.НайтиСтроки(Новый Структура("ПартияНайдена, ЕстьНомерСделки", Ложь, Истина));
		Для Каждого СтрокаСПустойПартией Из СтрокиСПустымиПартиями Цикл		
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось найти партию для ценной бумаги %1 по номеру сделки '%2'! Строка №%3 файла", СтрокаСПустойПартией.ЦеннаяБумага, СтрокаСПустойПартией.НомерСделки, СтрокаСПустойПартией.НомерСтроки));	
		КонецЦикла;
		
		// Распределяем загружаемое количество по FIFO в партиях
		КоличествоСтрокТаблицы = ЦенныеБумаги.Количество();		
		МассивСтрокКУдалению = Новый Массив;
		
		Для НомерСтроки = НомерПервойСтрокиДанных По НомерПоследнейСтрокиДанных Цикл
			
			СтрокиПоПартии = ЦенныеБумаги.НайтиСтроки(Новый Структура("НомерСтроки", НомерСтроки));
			
			// Если несколько строк, нужно распределить количество
			КоличествоНайденныхСтрок = СтрокиПоПартии.Количество();
			Если КоличествоНайденныхСтрок > 1 Тогда
				
				КоличествоКРаспределению = СтрокиПоПартии[0].Количество;
				Для Сч = 0 По КоличествоНайденныхСтрок - 1 Цикл	
					Если КоличествоКРаспределению = 0 Тогда
						МассивСтрокКУдалению.Добавить(СтрокиПоПартии[Сч]);
						Продолжить;
					КонецЕсли;
					СтрокиПоПартии[Сч].Количество = ?(КоличествоКРаспределению >= СтрокиПоПартии[Сч].КоличествоНаПартии, СтрокиПоПартии[Сч].КоличествоНаПартии, КоличествоКРаспределению);
					КоличествоКРаспределению = КоличествоКРаспределению - СтрокиПоПартии[Сч].Количество;
				КонецЦикла;
				
				Если КоличествоКРаспределению > 0 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось распределить %1 шт %2 по партиям! Строка №%3 файла", КоличествоКРаспределению, СтрокиПоПартии[Сч].ЦеннаяБумага,  СтрокиПоПартии[Сч].НомерСтроки)); 
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого СтрокаКУдалению Из МассивСтрокКУдалению Цикл
			ЦенныеБумаги.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
	Иначе
		// При загрузке в поручение просто сворачиваем, в нем нет данных по партиям
		ЦенныеБумаги.Свернуть("ЦеннаяБумага", "Количество");		
	КонецЕсли;
		
	ДокументОбъект.ЦенныеБумаги.Загрузить(ЦенныеБумаги);
	
КонецПроцедуры

// Для переданной таблицы ценных бумаг заполняет учетный актив ЕПС и помещает результат в менеджер временных таблиц
//
//	Параметры:
//		- МенеджерВременныхТаблиц 	- менеджер временны таблиц
//		- Период					- Дата среза	
//      - ДанныеОбъекта				- данные исходного документа
//      - ТаблицаЦенныхБумаг		- таблица значений с ценными бумагами
//      - ИмяВременнойТаблицы		- имя временной таблицы для помещения результата
//
Процедура ЗаполнитьУчетныеАктивыЕПСИПоместитьВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц, Период, ДанныеОбъекта, ТаблицаЦенныхБумаг, ИмяВременнойТаблицы = "_УчетныеАктивыЕПС", Отказ = Ложь) Экспорт
	
	// Получаем учетный актив ЕПС из таблицы,
	// а если он там не указан, то исходя из остатков на партиях	
	Запрос = Новый Запрос(		
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Партия В (НЕОПРЕДЕЛЕНО, &ПустыеСсылкиПартий)
		|		И ТаблицаЦБ.СтрокаПартии = 0 КАК НетДанныхОПартии,
		|	ТаблицаЦБ.Партия КАК Партия,
		|	ТаблицаЦБ.СтрокаПартии КАК СтрокаПартии,
		|	ТаблицаЦБ.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ТаблицаЦБ.Количество КАК Количество,
		|	АВТОНОМЕРЗАПИСИ() КАК НомерСтроки
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	&ТаблицаЦБ КАК ТаблицаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество
		|ПОМЕСТИТЬ _ОстаткиПартий
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И Рынок = &Рынок
		|				И ЦеннаяБумага В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_ТаблицаЦБ.ЦеннаяБумага
		|					ИЗ
		|						_ТаблицаЦБ)) КАК БухПартииЦенныхБумагОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.НомерСтроки КАК НомерСтроки,
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.НетДанныхОПартии КАК НетДанныхОПартии,
		|	_ТаблицаЦБ.Партия КАК Партия,
		|	_ТаблицаЦБ.СтрокаПартии КАК СтрокаПартии,
		|	_ТаблицаЦБ.Количество КАК Количество,
		|	ЕСТЬNULL(_ОстаткиПартий.УчетныйАктивЕПС, ЕСТЬNULL(_НераспределенныеУчетныеАктивыПартий.УчетныйАктивЕПС, _ТаблицаЦБ.УчетныйАктивЕПС)) КАК УчетныйАктивЕПС,
		|	_ОстаткиПартий.УчетныйАктивЕПС ЕСТЬ НЕ NULL 
		|		ИЛИ _НераспределенныеУчетныеАктивыПартий.УчетныйАктивЕПС ЕСТЬ НЕ NULL  КАК ПодборПоДаннымОстатковПартий
		|ПОМЕСТИТЬ _ТаблицаСЗаполненнымиУчетнымиАктивами
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиПартий КАК _ОстаткиПартий
		|		ПО _ТаблицаЦБ.ЦеннаяБумага = _ОстаткиПартий.ЦеннаяБумага
		|			И _ТаблицаЦБ.Партия = _ОстаткиПартий.Партия
		|			И _ТаблицаЦБ.СтрокаПартии = _ОстаткиПартий.СтрокаПартии
		|			И (_ТаблицаЦБ.УчетныйАктивЕПС = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка))
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			_ОстаткиПартий.ЦеннаяБумага КАК ЦеннаяБумага,
		|			_ОстаткиПартий.УчетныйАктивЕПС КАК УчетныйАктивЕПС
		|		ИЗ
		|			_ОстаткиПартий КАК _ОстаткиПартий
		|				ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаЦБ КАК _ТаблицаЦБ
		|				ПО (_ТаблицаЦБ.ЦеннаяБумага = _ОстаткиПартий.ЦеннаяБумага)
		|					И (_ТаблицаЦБ.Партия = _ОстаткиПартий.Партия)
		|					И (_ТаблицаЦБ.СтрокаПартии = _ОстаткиПартий.СтрокаПартии)
		|					И (_ТаблицаЦБ.Количество >= _ОстаткиПартий.Количество)
		|		ГДЕ
		|			_ТаблицаЦБ.ЦеннаяБумага ЕСТЬ NULL) КАК _НераспределенныеУчетныеАктивыПартий
		|		ПО _ТаблицаЦБ.ЦеннаяБумага = _НераспределенныеУчетныеАктивыПартий.ЦеннаяБумага
		|			И (_ТаблицаЦБ.НетДанныхОПартии)
		|			И (_ТаблицаЦБ.УчетныйАктивЕПС = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаСЗаполненнымиУчетнымиАктивами.НомерСтроки КАК НомерСтроки,
		|	_ТаблицаСЗаполненнымиУчетнымиАктивами.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаСЗаполненнымиУчетнымиАктивами.Партия КАК Партия,
		|	_ТаблицаСЗаполненнымиУчетнымиАктивами.СтрокаПартии КАК СтрокаПартии,
		|	_ТаблицаСЗаполненнымиУчетнымиАктивами.Количество КАК Количество,
		|	_ТаблицаСЗаполненнымиУчетнымиАктивами.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	_ТаблицаСЗаполненнымиУчетнымиАктивами.ПодборПоДаннымОстатковПартий КАК ПодборПоДаннымОстатковПартий,
		|	_ТаблицаСЗаполненнымиУчетнымиАктивами.УчетныйАктивЕПС В (&УчетныеАктивыОцениваемыеПоАС) КАК ОценкаПоАмортизированнойСтоимости
		|ПОМЕСТИТЬ #ИмяВременнойТаблицы#
		|ИЗ
		|	_ТаблицаСЗаполненнымиУчетнымиАктивами КАК _ТаблицаСЗаполненнымиУчетнымиАктивами
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаСЗаполненнымиУчетнымиАктивами.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ЦенныеБумагиСРазличнымиУчетнымиАктивамиНаОстатках
		|ИЗ
		|	_ТаблицаСЗаполненнымиУчетнымиАктивами КАК _ТаблицаСЗаполненнымиУчетнымиАктивами
		|ГДЕ
		|	_ТаблицаСЗаполненнымиУчетнымиАктивами.ПодборПоДаннымОстатковПартий
		|	И _ТаблицаСЗаполненнымиУчетнымиАктивами.НетДанныхОПартии
		|
		|СГРУППИРОВАТЬ ПО
		|	_ТаблицаСЗаполненнымиУчетнымиАктивами.ЦеннаяБумага
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ТаблицаСЗаполненнымиУчетнымиАктивами.УчетныйАктивЕПС) > 1");

	УчетныеАктивыОцениваемыеПоАС = Кэширование.УчетныеАктивыОцениваемыеПоАмортизированнойСтоимости();
	ПустыеСсылкиПартий			 = СистемныеФункции.ПустыеСсылкиСоставногоТипа(Метаданные.ОпределяемыеТипы.Партия.Тип);
	
	Запрос.УстановитьПараметр("Период",						  Новый Граница(Период, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация",                  ДанныеОбъекта.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ДанныеОбъекта.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Рынок",                        ДанныеОбъекта.Рынок);
	Запрос.УстановитьПараметр("ТаблицаЦБ",					  ТаблицаЦенныхБумаг);
	Запрос.УстановитьПараметр("ПустыеСсылкиПартий",			  ПустыеСсылкиПартий);
	Запрос.УстановитьПараметр("УчетныеАктивыОцениваемыеПоАС", УчетныеАктивыОцениваемыеПоАС);

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ИмяВременнойТаблицы#", ИмяВременнойТаблицы);
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Выполнить();

	// Если не удалось определить, как оцениваются бумаги - по СС или по АС, то сообщаем об этом и прерываем оценку		
	БумагиСРазличнымиУчетнымиАктивамиНаОстатках = МенеджерВременныхТаблиц.Таблицы["_ЦенныеБумагиСРазличнымиУчетнымиАктивамиНаОстатках"].ПолучитьДанные().Выгрузить();
	
	Если БумагиСРазличнымиУчетнымиАктивамиНаОстатках.Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Не удалось однозначно определить учетный актив ЕПС для некоторых ценных бумаг:
				|- %1", СтрСоединить(БумагиСРазличнымиУчетнымиАктивамиНаОстатках.ВыгрузитьКолонку(0), Символы.ПС + "- ")), , , , Отказ);		
	КонецЕсли;
		
КонецПроцедуры 