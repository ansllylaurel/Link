Процедура СоздатьДвиженияРегистраНоминалыДляПервоначальногоНоминала(ЦеннаяБумага, ДатаРегистрации = '19800101')
			
	НоминалыПерваяЗапись = РегистрыСведений.НоминалыЦенныхБумаг.СоздатьМенеджерЗаписи();
	НоминалыПерваяЗапись.Период       = ДатаРегистрации;
	НоминалыПерваяЗапись.ЦеннаяБумага = ЦеннаяБумага;
	НоминалыПерваяЗапись.Прочитать();
	
	НоминалыПерваяЗапись.Период       = ДатаРегистрации;
	НоминалыПерваяЗапись.ЦеннаяБумага = ЦеннаяБумага;
	НоминалыПерваяЗапись.Номинал      = ЦеннаяБумага.Номинал;
	НоминалыПерваяЗапись.Записать();
		
КонецПроцедуры // СоздатьДвиженияРегистраНоминалыДляПервоначальногоНоминала

Функция ВыполнитьДвиженияПоРегиструСведенийНоминалыДляПервоначальногоНоминала(ЦеннаяБумага, ДатаРегистрации = '19800101') Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
	|	Номиналы.Период,
	|	Номиналы.ЦеннаяБумага,
	|	Номиналы.Номинал
	|ИЗ
	|	РегистрСведений.НоминалыЦенныхБумаг КАК Номиналы
	|ГДЕ
	|	Номиналы.ЦеннаяБумага = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ЦеннаяБумага);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Количество()=0  Тогда  
		СоздатьДвиженияРегистраНоминалыДляПервоначальногоНоминала(ЦеннаяБумага, ДатаРегистрации);
	ИначеЕсли ВыборкаДетальныеЗаписи.Количество()>=1 Тогда
		ВыборкаДетальныеЗаписи.Следующий();
		ВыборкаДетальныеЗаписи.Получить(0);
		Если (ДатаРегистрации < ВыборкаДетальныеЗаписи.Период) или ((ДатаРегистрации = ВыборкаДетальныеЗаписи.Период) и (ВыборкаДетальныеЗаписи.Номинал<>ЦеннаяБумага.Номинал)) Тогда
			СоздатьДвиженияРегистраНоминалыДляПервоначальногоНоминала(ЦеннаяБумага, ДатаРегистрации);
		ИначеЕсли (ДатаРегистрации > ВыборкаДетальныеЗаписи.Период) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru = 'Существует значение номинала, введенное "+Формат(ВыборкаДетальныеЗаписи.Период,"ДФ=dd.MM.yyyy")+" (ранее "+Формат(ДатаРегистрации, "ДФ=dd.MM.yyyy")+").'");
			Сообщение.Сообщить();
			Возврат Истина;	
		КонецЕсли; 
	КонецЕсли; 
	
    Возврат Ложь;	
	
КонецФункции // ВыполнитьДвиженияПоРегиструСведенийНоминалыДляПервоначальногоНоминала

