// ДатаКотировки - дата, на которую рассчитываем котировку купона
Функция РассчитатьКотировкуКупона_АрчерФинанс(ДатаКотировки) Экспорт
	
	//КД= КД1+ КД2, где
	//КД – величина купонного дохода по одной Облигации за 8 купонный период
	//КД1 – величина купонного дохода по одной Облигации за 1-ый Расчетный период 8-го купонного периода, которая рассчитывается по формуле:
	//КД1 = 9,25% * N *(T2 – T1) / (365 * 100%)
	//КД2 – величина купонного дохода по одной Облигации за 2-ой Расчетный период 8-го купонного периода, которая рассчитывается по формуле: КД2 = (С * N) * (Т3-Т2)) / (365 * 100%).
	//N – номинальная стоимость одной Облигации.
	//C = ОФЗ + 4,5%, где;
	//C – процентная ставка (в процентах годовых) по второму Расчетному периоду 8-го купонного периода.
	//ОФЗ – значение точки на кривой бескупонной доходности 
	//государственных ценных бумаг (ОФЗ) со сроком до погашения 1 (один) год (G-кривая), 
	//публикуемое на официальном сайте Биржи 
	//по адресу http:	//moex.com/ru/marketdata/indices/state/yieldcurve/ или по иному адресу, 
	//если такой будет определен Биржей после даты регистрации настоящих изменений Банком России, по состоянию 
	//на конец 7 (седьмого) рабочего дня, предшествующего дате начала второго Расчетного периода 8-го купонного периода (в процентах годовых).  	
	//T1 – дата начала 1 Расчетного периода 8 купонного периода, которой является дата начала 8 купонного периода;
	//Т2 - дата окончания 1 Расчетного периода 8 купонного периода и одновременно дата начала 2 Расчетного периода 8 купонного периода, которая наступает 31.05.2018 г.
	//Т3 - дата окончания 8 купонного периода, которая наступает 23.03.2027 г.
	//
	//Поскольку в рамках новации 03.04.2018 было погашение купона на 0.01 руб на облигацию, дата Т1 - 03.04.2018 г.  	
	
	ДатаРасчета = НачалоДня(ДатаКотировки);

	Если ДатаРасчета > '20270323' Тогда
		// После окончания купонного периода не рассчитываем
		Возврат 0;
	ИначеЕсли ДатаРасчета > '20200129' Тогда // с 30.01.2020 возвращаемся к расчету "как у ММВБ"
		ДатаНачалаКД1 = '20171003';
		ДатаНачалаКД2 = '20180531';
	Иначе
		ДатаНачалаКД1 = '20180403';
		ДатаНачалаКД2 = '20180531';
	КонецЕсли;
	
	ДнейКД1 	  = (ДатаНачалаКД2 - ДатаНачалаКД1) / 86400;
	ДнейКД2 	  = (ДатаРасчета - ДатаНачалаКД2) / 86400;
	
	КД1 = Окр(1000 * 0.0925 * ДнейКД1 / 365, 2, 1);
	КД2 = 1000 * 0.1114 * ДнейКД2 / 365;
	
	Возврат Окр(КД1 + КД2, 2, 1);
	
КонецФункции

// ДатаКотировки - дата, на которую рассчитываем котировку купона
// ТекущаяКотировкаКупона - котировка купона, загруженная с ММВБ
// КурсВалютыНоминала - курс, по которому нужна рассчитать котировку.
Функция РассчитатьКотировкуКупона_Финстандарт(ДатаКотировки, ТекущаяКотировкаКупона, КурсВалютыНоминала = 1) Экспорт	
	
	//13-й купонный период делится на три подпериода:
	// 1. 25.05.2018 - 30.11.2018, ставка 8.22%;
	// 2. 30.11.2018 - 25.05.2019, ставка 10.6%;
	// 3. 25.05.2019 - 22.05.2020, ставка 10.6%;
	ДатаРасчета = НачалоДня(ДатаКотировки);
	                             	
	Если ДатаРасчета > '20200522' Или ДатаРасчета < '20180525' Тогда
		// До и после окончания купонного периода с особым порядком расчета не рассчитываем
		Возврат ТекущаяКотировкаКупона;
	КонецЕсли;
	
	Сумма_1Подпериод = 0;
	Сумма_2Подпериод = 0;
	Сумма_3Подпериод = 0;
	
	// Рассчитываем Сумма_1Подпериод
	ДатаРасчета_1Подпериод = ?(ДатаРасчета >= '20181130', '20181130', ДатаРасчета);
	Сумма_1Подпериод = Окр(РассчитатьКупон(Перечисления.БазыРасчетаОблигаций.Act365Fixed, '20180525', ДатаРасчета_1Подпериод, 1000, 8.22), 2, 1);
	
	// Рассчитываем Сумма_2Подпериод
	Если ДатаРасчета > '20181130' Тогда
		ДатаРасчета_2Подпериод = ?(ДатаРасчета >= '20190525', '20190525', ДатаРасчета);
		Сумма_2Подпериод = Окр(РассчитатьКупон(Перечисления.БазыРасчетаОблигаций.Act365Fixed, '20181130', ДатаРасчета_2Подпериод, 1000, 10.6), 2, 1);
	КонецЕсли;
			
	// Рассчитываем Сумма_3Подпериод
	Если ДатаРасчета > '20190525' Тогда
		Сумма_3Подпериод = Окр(РассчитатьКупон(Перечисления.БазыРасчетаОблигаций.Act365Fixed, '20190525', ДатаРасчета, 1000 + Сумма_1Подпериод + Сумма_2Подпериод, 10.6), 2, 1);
	КонецЕсли;
	
	Возврат Окр((Сумма_1Подпериод + Сумма_2Подпериод + Сумма_3Подпериод) * КурсВалютыНоминала, 2, 1);
	
КонецФункции

// ДатаКотировки - дата, на которую рассчитываем котировку купона
// ТекущаяКотировкаКупона - котировка купона, загруженная с ММВБ
// КурсВалютыНоминала - курс, по которому нужна рассчитать котировку.
Функция РассчитатьКотировкуКупона_Финстоун(ДатаКотировки) Экспорт	
	
	//9-й купонный период делится на 6 подпериодов:
	// 1й подпериод делится 2 подподпериода
	//	1.1. 11.01.2018	28.02.2018	9,25
	//	1.2. 28.02.2018	10.01.2019	9,86
	//	2.   10.01.2019	09.01.2020	11,3
	//	3.   09.01.2020	07.01.2021	9,02
	//	4.   07.01.2021	06.01.2022	7,93
	//	5.   06.01.2022	05.01.2023	н/о
	//	6.   05.01.2023	04.01.2024	н/о

	ДатаРасчета = НачалоДня(ДатаКотировки);
	
	СуммаКупона = 0;
	
	СуммаКупона = СуммаКупона + Окр(РассчитатьКупон(Перечисления.БазыРасчетаОблигаций.Act365Fixed, '20180111', '20180228', 1000, 9.25), 2, 1);
	
	Если ДатаРасчета > '20180228' Тогда
		СуммаКупона = СуммаКупона + Окр(РассчитатьКупон(Перечисления.БазыРасчетаОблигаций.Act365Fixed, '20180228', '20190110', 1000, 9.86), 2, 1);
	КонецЕсли;
	
	Если ДатаРасчета > '20190110' Тогда
		СуммаКупона = СуммаКупона + Окр(РассчитатьКупон(Перечисления.БазыРасчетаОблигаций.Act365Fixed, '20190110', '20200109', 1097.52, 11.3), 2, 1);
	КонецЕсли;
	
	Если ДатаРасчета > '20200109' Тогда
		СуммаКупона = СуммаКупона + Окр(РассчитатьКупон(Перечисления.БазыРасчетаОблигаций.Act365Fixed, '20200109', '20210107', 1221.2, 9.02), 2, 1);
	КонецЕсли;
	
	Если ДатаРасчета > '20210107' Тогда
		СуммаКупона = СуммаКупона + Окр(РассчитатьКупон(Перечисления.БазыРасчетаОблигаций.Act365Fixed, '20210107', '20220106', 1331.05, 7.93), 2, 1);
	КонецЕсли;
	
	Если ДатаРасчета > '20220106' Тогда
		СуммаКупона = СуммаКупона + Окр(РассчитатьКупон(Перечисления.БазыРасчетаОблигаций.Act365Fixed, '20220106', ДатаРасчета, 1436.31, 11.55), 2, 1);
	КонецЕсли;
	
	Если ДатаРасчета > '20230105' Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По облигации 'Финстоун ООО, 4-01-36431-R, 1000.00 RUB' срочно необходимо исправить расчет купона! В данный момент расчет неправильный!");
	КонецЕсли;
	
	Возврат СуммаКупона;
	
КонецФункции

