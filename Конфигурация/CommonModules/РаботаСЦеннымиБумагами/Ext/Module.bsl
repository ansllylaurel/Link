			И ЦеннаяБумага.Эмитент.ЮрФизЛицо = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ПрМосквыВЛицеДФ")
		ИЛИ БазаРасчета = Перечисления.БазыРасчетаОблигаций.ActICMA
		И ЦеннаяБумага <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Беларусь_BYM000001917") //постановление Министерства финансов Республики Беларусь от 11 июля 2018 г. №51
		Тогда 
			
		// Считаем по методике ММВБ
		ДнейВПериоде = (НачалоДня(Период) - НачалоДня(НачалоПериода)) / (60 * 60 * 24);
		
		Если БазаРасчета = Перечисления.БазыРасчетаОблигаций._30E360 Тогда // у валютных госбумаг нужно учитывать базу расчета
			ДнейВПериоде = (Год(Период) - Год(НачалоПериода)) * 360 + (Месяц(Период) - Месяц(НачалоПериода)) * 30 + (Мин(30, День(Период)) - Мин(30, День(НачалоПериода)));
		КонецЕсли;			
		
		Добавка = 0;
		// по этой бумаге Минфин дал таблицу купонов до 1.5.23 и там странные добавки
		Если ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин52005") Тогда
			Если НачалоДня(Период) = '20230407' Тогда
				Добавка = -0.02;
			ИначеЕсли Период >= '20230319' И Период < '20230323' ИЛИ Период >= '20230327' И Период < '20230424' Тогда
				Добавка = -0.01;
			КонецЕсли;
		КонецЕсли;
		
		Возврат Окр(СуммаКупона * ДнейВПериоде / Срок, ТочностьОкругления, 1) + Добавка;
		
	КонецЕсли;
	
	Если НачалоНоминалы = Неопределено Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	МАКСИМУМ(НоминалыЦенныхБумаг.Период) КАК Период
			|ИЗ
			|	РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
			|ГДЕ
			|	НоминалыЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага
			|	И НоминалыЦенныхБумаг.Период < &Период";

		Запрос.УстановитьПараметр("Период", Период);
		Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);

		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();

		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			НачалоНоминалы = ВыборкаДетальныеЗаписи.Период;
		Иначе //Данные по номиналу берем из карточки т.к. истории номиналов нет
			Номинал = ЦеннаяБумага.Номинал;
			
			Купон = РассчитатьКупон(БазаРасчета, НачалоПериода, Период, Номинал, Процент);
			Возврат Окр(Купон, ТочностьОкругления, 1) + Добавка;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НоминалыЦенныхБумаг.Период КАК НачалоПериода,
		|	НоминалыЦенныхБумаг.Номинал,
		|	МИНИМУМ(НоминалыЦенныхБумаг1.Период) КАК КонецПериода
		|ИЗ
		|	РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг1
		|		ПО НоминалыЦенныхБумаг.ЦеннаяБумага = НоминалыЦенныхБумаг1.ЦеннаяБумага
		|			И НоминалыЦенныхБумаг.Период < НоминалыЦенныхБумаг1.Период
		|ГДЕ
		|	НоминалыЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага
		|	И НоминалыЦенныхБумаг.Период >= &ПериодНачало
		|
		|СГРУППИРОВАТЬ ПО
		|	НоминалыЦенныхБумаг.Период,
		|	НоминалыЦенныхБумаг.Номинал
		|
		|УПОРЯДОЧИТЬ ПО
		|	НачалоПериода";

	Запрос.УстановитьПараметр("ПериодНачало", Мин(НачалоПериода, НачалоНоминалы));
	Запрос.УстановитьПараметр("КонецПериода", Период);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Купон = 0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НачалоПериодаРасчета = Макс(НачалоПериода, ВыборкаДетальныеЗаписи.НачалоПериода);
		Если ВыборкаДетальныеЗаписи.КонецПериода = NULL Тогда
			КонецПериодаРасчета = Период;
		Иначе
			КонецПериодаРасчета = Мин(Период, ВыборкаДетальныеЗаписи.КонецПериода);	
		КонецЕсли;
		
		Если НачалоПериодаРасчета >= Период Тогда
			Прервать;
		КонецЕсли;
		
		КупонЗаПериод = РассчитатьКупон(БазаРасчета, НачалоПериодаРасчета, КонецПериодаРасчета, ВыборкаДетальныеЗаписи.Номинал, Процент);
		
		Купон = Купон + КупонЗаПериод;
		
	КонецЦикла;

	Возврат Окр(Купон, ТочностьОкругления, 1) + Добавка;
	
КонецФункции

Функция РассчитатьКупон(БазаРасчета, ДатаНачала, ДатаОкончания, Номинал, Процент, ПотерянныйДень = 0) Экспорт
	
	// По этим базам считается по всему периоду
	Если БазаРасчета = Перечисления.БазыРасчетаОблигаций.Act365L ИЛИ БазаРасчета = Перечисления.БазыРасчетаОблигаций.Act365Fixed Тогда 
		
		Возврат (НачалоДня(ДатаОкончания) - НачалоДня(ДатаНачала)) / (24 * 60 * 60) * Номинал * Процент / 100 / КоличествоДнейВГоду(БазаРасчета, ДатаОкончания);

	// По остальным базам нужно делать цикл по годам и вызывать эту же функцию рекурсивно для каждого года
	ИначеЕсли Год(ДатаНачала) <> Год(ДатаОкончания) Тогда
		
		// за 1ый год, он неполный
		Купон = РассчитатьКупон(БазаРасчета, ДатаНачала, НачалоДня(КонецГода(ДатаНачала)), Номинал, Процент, 1);
		
		// за все полные года, входящие в купонный период
		КоличествоПолныхЛет = Год(ДатаОкончания) - Год(ДатаНачала) - 1;
		Для Сч = 1 По КоличествоПолныхЛет Цикл
			Купон = Купон + РассчитатьКупон(БазаРасчета, Дата(Год(ДатаНачала) + Сч, 1, 1), Дата(Год(ДатаНачала) + Сч, 12, 31), Номинал, Процент, 1);
		КонецЦикла;
		
		// за последний год, он неполный
		Купон = Купон + РассчитатьКупон(БазаРасчета, НачалоДня(НачалоГода(ДатаОкончания)), ДатаОкончания, Номинал, Процент);
		
		Возврат Купон;
		
	// А это расчет за один год
	Иначе
		// это 2 очень редкие, почти неиспользуемые базы, поэтому долго не прилетало
		Если БазаРасчета = Перечисления.БазыРасчетаОблигаций.ActICMA
			ИЛИ БазаРасчета = Перечисления.БазыРасчетаОблигаций.Act365 Тогда
			КоличествоДней = (ДатаОкончания - ДатаНачала) / 86400;
		Иначе
			КоличествоДней = (Месяц(ДатаОкончания) - Месяц(ДатаНачала)) * 30
				+ ПолучитьДеньМесяцаПоБазеРасчета(ДатаОкончания, БазаРасчета, ДатаНачала)
				- ПолучитьДеньМесяцаПоБазеРасчета(ДатаНачала, БазаРасчета, ДатаНачала);
		КонецЕсли;
		
		КоличествоДней = КоличествоДней + ПотерянныйДень; //при разбивании периода на до НГ и после НГ теряется один день, нужно его компенсировать.
		
		Возврат КоличествоДней * Номинал * Процент / 100 / КоличествоДнейВГоду(БазаРасчета, ДатаОкончания);
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДеньМесяцаПоБазеРасчета(Дата, БазаРасчета, Дата2)

	Если БазаРасчета = Перечисления.БазыРасчетаОблигаций._30E360 Тогда
	
		Возврат Мин(30, День(Дата));
		
	ИначеЕсли БазаРасчета = Перечисления.БазыРасчетаОблигаций._30E360_ISDA Тогда
		
		// если D=31 или D-последний день февраля, то D=30
		
		Возврат ?(КонецДня(Дата) = КонецМесяца(Дата), 30, День(Дата));
		
	ИначеЕсли БазаРасчета = Перечисления.БазыРасчетаОблигаций._30360US Тогда
		
		// если D1=31 или D1-последний день февраля, то D1=30
		// если D2=31 и D1=31 или D1-последний день февраля и D2-последний день февраля, то D2=30
		
		Если Дата = Дата2 Тогда // считаем D1 
			Возврат ?(КонецДня(Дата) = КонецМесяца(Дата), 30, День(Дата));
		Иначе // считаем D2
			Если День(Дата) = 31 И День(Дата2) = 31 
				ИЛИ Месяц(Дата) = 2 И Месяц(Дата2) = 2 И КонецДня(Дата) = КонецМесяца(Дата) И КонецДня(Дата2) = КонецМесяца(Дата2)
			Тогда
				Возврат 30;
			Иначе
				Возврат День(Дата);
			КонецЕсли;
		КонецЕсли;
	Иначе
		
		Возврат День(Дата);
		
	КонецЕсли;

КонецФункции

Функция КоличествоДнейВГоду(БазаРасчета, Дата)
	
	Если БазаРасчета = Перечисления.БазыРасчетаОблигаций.Act365Fixed Тогда
		Возврат 365;
	ИначеЕсли БазаРасчета = Перечисления.БазыРасчетаОблигаций.Act360 Тогда
		Возврат 360;
	ИначеЕсли БазаРасчета = Перечисления.БазыРасчетаОблигаций.Act365 Тогда
		Возврат (КонецГода(Дата) + 1 - НачалоГода(Дата)) / 86400;
	ИначеЕсли БазаРасчета = Перечисления.БазыРасчетаОблигаций.Act365L Тогда
		Возврат (КонецГода(Дата) + 1 - НачалоГода(Дата)) / 86400;
	ИначеЕсли БазаРасчета = Перечисления.БазыРасчетаОблигаций._30E360 Тогда
		Возврат 360;
	ИначеЕсли БазаРасчета = Перечисления.БазыРасчетаОблигаций.ActICMA Тогда 
		Возврат (КонецГода(Дата) + 1 - НачалоГода(Дата)) / 86400;
	КонецЕсли;
	
КонецФункции

// Возвращает необходимость расчета купона в случаях, когда ММВБ перестает считать НКД
//
// Параметры:
//	ЦеннаяБумага	- СправочникСсылка.Облигации	- облигация
//	Период			- Дата							- дата
//
// Возвращаемое значение:
//	Булево - Истина, когда требуется расчет купона 
//
Функция ТребуетсяРасчетКупона(ЦеннаяБумага, Период) Экспорт
	
	// Иногда ММВБ перестает считать НКД определенных бумаг, тогда по ним в котировках купона приходят 0.
	// В таких случаях требуется выполнять расчет купона самостоятельно
	
	ТребуетсяРасчетКупона = Ложь;
	
	Если Период >= '20190925' И ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_БизнесКонсалтиг")
		ИЛИ Период >= '20190925' И ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_БКЗ_ФИНАНС")
		ИЛИ Период >= '20190925' И ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ТМ-энергоФинанс")
		ИЛИ Период >= '20210504' И ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Alliance20")
		ИЛИ Период >= '20210526' И ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОВКФинанс") И Период < '20211124' // исключил дату погашения
		ИЛИ Период = '20240227' И ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Роснефть_005")
		ИЛИ Период >= '20240530' И ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1_ПропертизФин")
	Тогда
		ТребуетсяРасчетКупона = Истина;	
	КонецЕсли;
	
	Возврат ТребуетсяРасчетКупона;
	
КонецФункции

Функция ТочностьРасчетногоКупона(ЦеннаяБумага, Период, ВалютаНоминала = Неопределено, СчетДоверительногоУправления = Неопределено) Экспорт
	
	ТочностьКупона = 2;
		
	Если ВалютаНоминала = Неопределено Тогда 
		ВалютаНоминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЦеннаяБумага, "ВалютаНоминала");
	КонецЕсли;
	
	Если ВалютаНоминала <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль")		// точность 4 знака нужна для валютных бумаг
		И ЦеннаяБумага <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1Пропертиз_Дол")		// по этим бумагам точность 2 - ММВБ не дает по ним купона и мы считаем до 2х
		И ЦеннаяБумага <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1Пропертиз_До2")
		И ЦеннаяБумага <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ГТЛК_011")
		И ЦеннаяБумага <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ГазпромКапиталООО_006") // по этой бумаге точность задана в проспекте эмиссии
		И ЦеннаяБумага <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин12840111V")		// по этой бумаге точность задана в проспекте эмиссии
	Тогда
		ТочностьКупонаДляОблигацийВВалюте = Неопределено;
		Если СчетДоверительногоУправления <> Неопределено Тогда
			БухгалтерскийУчет.ОпределитьРасчетнуюНастройкуУчета(Период, Неопределено, СчетДоверительногоУправления, "ТочностьРасчетногоКупонаДляОблигацийВВалюте", ТочностьКупонаДляОблигацийВВалюте);
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ТочностьКупонаДляОблигацийВВалюте) Тогда
			ТочностьКупона = ТочностьКупонаДляОблигацийВВалюте;
		Иначе 	
			ТочностьКупона = 4;
		КонецЕсли;	
	КонецЕсли;
	
	Если ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_CBOM_4.7_01/29/25")
		И НачалоДня(Период) = '20231230' Тогда
	
		ТочностьКупона = 6;
	
	КонецЕсли;
	
	Возврат ТочностьКупона;
	
КонецФункции

#Область Корректировки_купона

Функция РассчитатьКотировкуКупонаПоСреднейСтавкеРУОНИА(ЦеннаяБумага, ДатаКотировки, Добавка = 0, Смещение = 7, СмещениеВКалендарныхДнях = Истина)
	
	Если СмещениеВКалендарныхДнях Тогда
		СмещениеКупонногоПериода = Смещение;	
	Иначе
		СмещениеКупонногоПериода = 0;	
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(КупонныйДоходПоОблигациям.Период) КАК ДатаНачалаПериодаКупона
		|ИЗ
		|	РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|ГДЕ
		|	КупонныйДоходПоОблигациям.Облигация = &Облигация
		|	И КупонныйДоходПоОблигациям.Период <= &Период";
	
	Запрос.УстановитьПараметр("Облигация", ЦеннаяБумага);
	Запрос.УстановитьПараметр("Период", ДатаКотировки);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ВыборкаДетальныеЗаписи.ДатаНачалаПериодаКупона = ДатаКотировки Тогда
			Возврат 0;
		ИначеЕсли ВыборкаДетальныеЗаписи.ДатаНачалаПериодаКупона = NULL Тогда // запросили за дату ранее начала расчетов купонов
			Возврат 0;
		Иначе
			ДатаНачалаРуониа = ВыборкаДетальныеЗаписи.ДатаНачалаПериодаКупона - (СмещениеКупонногоПериода - 1) * 60 * 60 * 24;
		КонецЕсли;
	Иначе
		Возврат 0;
	КонецЕсли;
	
	ДатаОкончанияРуониа = ДатаКотировки - СмещениеКупонногоПериода * 60 * 60 * 24;

	
	Запрос = Новый Запрос;
	
	Если СмещениеВКалендарныхДнях Тогда
			
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеКалендаря.Дата КАК Дата
			|ПОМЕСТИТЬ _Дни
			|ИЗ
			|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|ГДЕ
			|	ДанныеКалендаря.Календарь = &Календарь
			|	И ДанныеКалендаря.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Дни.Дата КАК Дата,
			|	МАКСИМУМ(ЗначенияБиржевыхИндексов.Период) КАК Период
			|ПОМЕСТИТЬ _ДниРуониа
			|ИЗ
			|	_Дни КАК _Дни
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
			|		ПО _Дни.Дата >= ЗначенияБиржевыхИндексов.Период
			|			И (ЗначенияБиржевыхИндексов.Биржа = &Биржа)
			|			И (ЗначенияБиржевыхИндексов.БиржевойИндекс = &БиржевойИндекс)
			|
			|СГРУППИРОВАТЬ ПО
			|	_Дни.Дата
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВЫБОР
			|		КОГДА РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(_ДниРуониа.Дата, ГОД), КОНЕЦПЕРИОДА(_ДниРуониа.Дата, ГОД), ДЕНЬ) = 364
			|			ТОГДА ВЫРАЗИТЬ((ЗначенияБиржевыхИндексов.CLOSE + &Добавка) * 1000 / 365 / 100 КАК ЧИСЛО(21, 19))
			|		ИНАЧЕ ВЫРАЗИТЬ((ЗначенияБиржевыхИндексов.CLOSE + &Добавка) * 1000 / &ДнейВВисокосномГоду / 100 КАК ЧИСЛО(21, 19))
			|	КОНЕЦ КАК СтавкаЗаДень,
			|	_ДниРуониа.Дата КАК Дата
			|ИЗ
			|	_ДниРуониа КАК _ДниРуониа
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
			|		ПО _ДниРуониа.Период = ЗначенияБиржевыхИндексов.Период
			|			И (ЗначенияБиржевыхИндексов.Биржа = &Биржа)
			|			И (ЗначенияБиржевыхИндексов.БиржевойИндекс = &БиржевойИндекс)
			|ИТОГИ
			|	СУММА(СтавкаЗаДень)
			|ПО
			|	ОБЩИЕ";
		
	Иначе
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеКалендаря.Дата КАК Дата
			|ПОМЕСТИТЬ _Дни
			|ИЗ
			|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|ГДЕ
			|	ДанныеКалендаря.Календарь = &Календарь
			|	И ДанныеКалендаря.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, &Смещение - 30) И ДОБАВИТЬКДАТЕ(&ДатаОкончания, ДЕНЬ, 15)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 999
			|	ДанныеКалендаря.Дата КАК Дата,
			|	АВТОНОМЕРЗАПИСИ() КАК ПорядковыйНомерДня
			|ПОМЕСТИТЬ _ДниРабочие
			|ИЗ
			|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|ГДЕ
			|	ДанныеКалендаря.Календарь = &Календарь
			|	И ДанныеКалендаря.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, &Смещение - 30) И ДОБАВИТЬКДАТЕ(&ДатаОкончания, ДЕНЬ, 15)
			|	И (ДанныеКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий)
			|			ИЛИ ДанныеКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
			|
			|УПОРЯДОЧИТЬ ПО
			|	Дата
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДниРабочие.Дата КАК Дата,
			|	_ДниРабочие.ПорядковыйНомерДня КАК ПорядковыйНомерДня,
			|	МАКСИМУМ(_ДниРабочиеСоСмещением.Дата) КАК ДатаСоСмещением
			|ПОМЕСТИТЬ _ДниРабочиеСоСмещением
			|ИЗ
			|	_ДниРабочие КАК _ДниРабочие
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ДниРабочие КАК _ДниРабочиеСоСмещением
			|		ПО (_ДниРабочие.ПорядковыйНомерДня >= _ДниРабочиеСоСмещением.ПорядковыйНомерДня - &Смещение)
			|
			|СГРУППИРОВАТЬ ПО
			|	_ДниРабочие.Дата,
			|	_ДниРабочие.ПорядковыйНомерДня
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Дни.Дата КАК Дата,
			|	ВЫБОР
			|		КОГДА _Дни.Дата = _ДниРабочиеСоСмещением.Дата
			|			ТОГДА _ДниРабочиеСоСмещением.ПорядковыйНомерДня
			|		ИНАЧЕ _ДниРабочиеСоСмещением.ПорядковыйНомерДня + 1
			|	КОНЕЦ КАК ПорядковыйНомерДня
			|ПОМЕСТИТЬ _ДниИБлижайшиеРабочиеДниСУчетомВыходногоИлиПраздничного
			|ИЗ
			|	_Дни КАК _Дни
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ДниРабочиеСоСмещением КАК _ДниРабочиеСоСмещением
			|		ПО _Дни.Дата >= _ДниРабочиеСоСмещением.Дата
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДниИБлижайшиеРабочиеДниСУчетомВыходногоИлиПраздничного.Дата КАК Дата,
			|	МАКСИМУМ(_ДниИБлижайшиеРабочиеДниСУчетомВыходногоИлиПраздничного.ПорядковыйНомерДня) КАК ПорядковыйНомерДня
			|ПОМЕСТИТЬ _ДниИБлижайшиеРабочиеДниСУчетомВыходногоИлиПраздничногоСГруппировкой
			|ИЗ
			|	_ДниИБлижайшиеРабочиеДниСУчетомВыходногоИлиПраздничного КАК _ДниИБлижайшиеРабочиеДниСУчетомВыходногоИлиПраздничного
			|
			|СГРУППИРОВАТЬ ПО
			|	_ДниИБлижайшиеРабочиеДниСУчетомВыходногоИлиПраздничного.Дата
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Дни.Дата КАК Дата,
			|	МАКСИМУМ(_ДниРабочиеСоСмещением.ДатаСоСмещением) КАК БлижайшийРабочийДень,
			|	МАКСИМУМ(_ДниРабочиеСоСмещением.ПорядковыйНомерДня) КАК ПорядковыйНомерДня
			|ПОМЕСТИТЬ _ДниИБлижайшиеРабочиеДни
			|ИЗ
			|	_Дни КАК _Дни
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ДниРабочиеСоСмещением КАК _ДниРабочиеСоСмещением
			|		ПО _Дни.Дата >= _ДниРабочиеСоСмещением.Дата
			|
			|СГРУППИРОВАТЬ ПО
			|	_Дни.Дата
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_Дни.Дата КАК Дата,
			|	_ДниИБлижайшиеРабочиеДни.БлижайшийРабочийДень КАК БлижайшийРабочийДеньСоСмещением
			|ПОМЕСТИТЬ _ДниИБлижайшиеРабочиеДниСоСмещением
			|ИЗ
			|	_ДниИБлижайшиеРабочиеДниСУчетомВыходногоИлиПраздничногоСГруппировкой КАК _Дни
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ДниИБлижайшиеРабочиеДни КАК _ДниИБлижайшиеРабочиеДни
			|		ПО _Дни.ПорядковыйНомерДня = _ДниИБлижайшиеРабочиеДни.ПорядковыйНомерДня
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДниИБлижайшиеРабочиеДниСоСмещением.Дата КАК Дата,
			|	МАКСИМУМ(ЗначенияБиржевыхИндексов.Период) КАК Период
			|ПОМЕСТИТЬ _ДниРУОНИА
			|ИЗ
			|	_ДниИБлижайшиеРабочиеДниСоСмещением КАК _ДниИБлижайшиеРабочиеДниСоСмещением
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
			|		ПО _ДниИБлижайшиеРабочиеДниСоСмещением.БлижайшийРабочийДеньСоСмещением >= ЗначенияБиржевыхИндексов.Период
			|			И (ЗначенияБиржевыхИндексов.Биржа = &Биржа)
			|			И (ЗначенияБиржевыхИндексов.БиржевойИндекс = &БиржевойИндекс)
			|ГДЕ
			|	_ДниИБлижайшиеРабочиеДниСоСмещением.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
			|
			|СГРУППИРОВАТЬ ПО
			|	_ДниИБлижайшиеРабочиеДниСоСмещением.Дата
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВЫБОР
			|		КОГДА РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(_ДниРУОНИА.Дата, ГОД), КОНЕЦПЕРИОДА(_ДниРУОНИА.Дата, ГОД), ДЕНЬ) = 364
			|			ТОГДА ВЫРАЗИТЬ((ЗначенияБиржевыхИндексов.CLOSE + &Добавка) * 1000 / 365 / 100 КАК ЧИСЛО(21, 19))
			|		ИНАЧЕ ВЫРАЗИТЬ((ЗначенияБиржевыхИндексов.CLOSE + &Добавка) * 1000 / &ДнейВВисокосномГоду / 100 КАК ЧИСЛО(21, 19))
			|	КОНЕЦ КАК СтавкаЗаДень,
			|	_ДниРУОНИА.Дата КАК Дата
			|ИЗ
			|	_ДниРУОНИА КАК _ДниРУОНИА
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
			|		ПО _ДниРУОНИА.Период = ЗначенияБиржевыхИндексов.Период
			|			И (ЗначенияБиржевыхИндексов.Биржа = &Биржа)
			|			И (ЗначенияБиржевыхИндексов.БиржевойИндекс = &БиржевойИндекс)
			|ИТОГИ
			|	СУММА(СтавкаЗаДень)
			|ПО
			|	ОБЩИЕ";
		
			КоличествоДнейВКупонномПериоде = (НачалоДня(ДатаОкончанияРуониа) - НачалоДня(ДатаНачалаРуониа)) / (60 * 60 * 24);
		
		    Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 999", "ПЕРВЫЕ " + Формат(КоличествоДнейВКупонномПериоде + 30 + Смещение, "ЧЦ=15; ЧДЦ=0; ЧН=1; ЧГ=0"));
		
	КонецЕсли;	
	
	// для госбумаг при расчете всегда учитывается високосность независимо от базы расчета, указанной в карточке
	Если ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Государственная
		ИЛИ ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Субфедеральная
		ИЛИ ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Муниципальная Тогда
	
		ДнейВВисокосномГоду = 366;
		
	// для корпоративных бумаг мы зависим от базы расчета - если она Fixed, то високосность не считаем
	ИначеЕсли ЦеннаяБумага.БазаРасчета = Перечисления.БазыРасчетаОблигаций.Act365Fixed
		ИЛИ ЦеннаяБумага.БазаРасчета = Перечисления.БазыРасчетаОблигаций.Act365 Тогда
		
		ДнейВВисокосномГоду = 365;
		
	// а если не Fixed, то считаем
	Иначе
		
		ДнейВВисокосномГоду = 366;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Биржа", ОбщегоНазначения.ПолучитьИменованныйОбъект("СРО_НФА"));
	Запрос.УстановитьПараметр("БиржевойИндекс", ОбщегоНазначения.ПолучитьИменованныйОбъект("Индекс_РУОНИА"));
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаРуониа);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончанияРуониа);
	Запрос.УстановитьПараметр("Календарь", Справочники.Календари.Общероссийский);
	Запрос.УстановитьПараметр("Добавка", Добавка);
	Запрос.УстановитьПараметр("ДнейВВисокосномГоду", ДнейВВисокосномГоду);
	Запрос.УстановитьПараметр("Смещение", -Смещение);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОбщийИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ВыборкаОбщийИтог.Следующий();		// Общий итог
	
	Возврат Окр(ВыборкаОбщийИтог.СтавкаЗаДень, 2);
	
КонецФункции

Функция РассчитатьКотировкуКупонаПоСреднейЗаПериодСреднейСтавкиРУОНИА(ЦеннаяБумага, ДатаКотировки, Добавка = 0, ДнейОтступа = 0, ДнейПрошлогоПериода = Неопределено)
	
	РеквизитыЦеннойБумаги = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЦеннаяБумага, "ДатаНачалаОбращения, ДатаПогашения, Категория, БазаРасчета, УчетныйАктивЦБРФ, Эмитент");

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(КупонныйДоходПоОблигациям.Период) КАК ДатаНачалаПериодаКупона
		|ПОМЕСТИТЬ _НачалоКупонногоПериода
		|ИЗ
		|	РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|ГДЕ
		|	КупонныйДоходПоОблигациям.Облигация = &Облигация
		|	И КупонныйДоходПоОблигациям.Период <= &Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(КупонныйДоходПоОблигациям.Период) КАК ДатаОкончанияПериодаКупона
		|ПОМЕСТИТЬ _ОкочаниеКупонногоПериода
		|ИЗ
		|	РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|ГДЕ
		|	КупонныйДоходПоОблигациям.Облигация = &Облигация
		|	И КупонныйДоходПоОблигациям.Период >= &Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(_НачалоКупонногоПериода.ДатаНачалаПериодаКупона) КАК ДатаНачалаПериодаКупона,
		|	МАКСИМУМ(КупонныйДоходПоОблигациям.Период) КАК ДатаНачалаПрошлогоПериодаКупона,
		|	МИНИМУМ(_ОкочаниеКупонногоПериода.ДатаОкончанияПериодаКупона) КАК ДатаОкончанияПериодаКупона
		|ИЗ
		|	_НачалоКупонногоПериода КАК _НачалоКупонногоПериода
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|		ПО (КупонныйДоходПоОблигациям.Период < _НачалоКупонногоПериода.ДатаНачалаПериодаКупона)
		|			И (КупонныйДоходПоОблигациям.Облигация = &Облигация)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОкочаниеКупонногоПериода КАК _ОкочаниеКупонногоПериода
		|		ПО (ИСТИНА)";
	
	Запрос.УстановитьПараметр("Облигация", ЦеннаяБумага);
	Запрос.УстановитьПараметр("Период", ДатаКотировки);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ВыборкаДетальныеЗаписи.ДатаНачалаПериодаКупона = ДатаКотировки Тогда
			Возврат 0;
		ИначеЕсли ВыборкаДетальныеЗаписи.ДатаНачалаПериодаКупона = NULL Тогда // запросили за дату ранее начала расчетов купонов
			Возврат 0;
		Иначе
			ДатаНачалаПериодаКупона = ВыборкаДетальныеЗаписи.ДатаНачалаПериодаКупона;
			Если ДнейПрошлогоПериода = Неопределено И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДатаНачалаПрошлогоПериодаКупона) Тогда
				ДнейПрошлогоПериода = (НачалоДня(ВыборкаДетальныеЗаписи.ДатаНачалаПериодаКупона) - НачалоДня(ВыборкаДетальныеЗаписи.ДатаНачалаПрошлогоПериодаКупона)) / (60 * 60 * 24);	
			ИначеЕсли ДнейПрошлогоПериода = Неопределено И Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДатаНачалаПрошлогоПериодаКупона) Тогда
				ДнейПрошлогоПериода = (НачалоДня(ВыборкаДетальныеЗаписи.ДатаНачалаПериодаКупона) - НачалоДня(РеквизитыЦеннойБумаги.ДатаНачалаОбращения)) / (60 * 60 * 24);	
			КонецЕсли;	
			
			ДатаОкончанияПериодаКупона = ВыборкаДетальныеЗаписи.ДатаОкончанияПериодаКупона;
			Если Не ЗначениеЗаполнено(ДатаОкончанияПериодаКупона) Тогда
				ДатаОкончанияПериодаКупона = РеквизитыЦеннойБумаги.ДатаПогашения;	
			КонецЕсли;	
		КонецЕсли;
	Иначе
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _Дни
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &Календарь
		|	И ДанныеКалендаря.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(&ДатаОкончанияПредидущегоКупонногоПериода, ДЕНЬ, -1 * &ДнейПрошлогоПериода), МЕСЯЦ, -2) И &ДатаОкончанияПредидущегоКупонногоПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Дни.Дата КАК Дата,
		|	МАКСИМУМ(ЗначенияБиржевыхИндексов.Период) КАК Период
		|ПОМЕСТИТЬ _ДниРуониа
		|ИЗ
		|	_Дни КАК _Дни
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
		|		ПО _Дни.Дата >= ЗначенияБиржевыхИндексов.Период
		|			И (ЗначенияБиржевыхИндексов.Биржа = &Биржа)
		|			И (ЗначенияБиржевыхИндексов.БиржевойИндекс = &БиржевойИндекс)
		|
		|СГРУППИРОВАТЬ ПО
		|	_Дни.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(_ДниРуониа.Период) КАК ПериодМаксимум,
		|	МИНИМУМ(ДОБАВИТЬКДАТЕ(_ДниРуониа.Период, ДЕНЬ, -1 * &ДнейПрошлогоПериода)) КАК ПериодМинимум
		|ПОМЕСТИТЬ _ДниРуониаМаксимумМинимум
		|ИЗ
		|	_ДниРуониа КАК _ДниРуониа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _ДниСреднееРуониаХХДней
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДниРуониаМаксимумМинимум КАК _ДниРуониаМаксимумМинимум
		|		ПО (ИСТИНА)
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &Календарь
		|	И ДанныеКалендаря.Дата МЕЖДУ _ДниРуониаМаксимумМинимум.ПериодМинимум И _ДниРуониаМаксимумМинимум.ПериодМаксимум
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ДниРуониаМаксимумМинимум
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДниСреднееРуониаХХДней.Дата КАК Период,
		|	МАКСИМУМ(ЗначенияБиржевыхИндексов.Период) КАК ПериодЗначенияБиржевыхИндексов
		|ПОМЕСТИТЬ _ДниДляСрезПоследнихРуониаЗаХХДней
		|ИЗ
		|	_ДниСреднееРуониаХХДней КАК _ДниСреднееРуониаХХДней
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
		|		ПО _ДниСреднееРуониаХХДней.Дата >= ЗначенияБиржевыхИндексов.Период
		|			И (ЗначенияБиржевыхИндексов.Биржа = &Биржа)
		|			И (ЗначенияБиржевыхИндексов.БиржевойИндекс = &БиржевойИндекс)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДниСреднееРуониаХХДней.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДниДляСрезПоследнихРуониаЗаХХДней.Период КАК Период,
		|	ЗначенияБиржевыхИндексов.CLOSE КАК CLOSE
		|ПОМЕСТИТЬ _СрезПоследнихРуониаЗаХХДней
		|ИЗ
		|	_ДниДляСрезПоследнихРуониаЗаХХДней КАК _ДниДляСрезПоследнихРуониаЗаХХДней
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
		|		ПО (ЗначенияБиржевыхИндексов.Биржа = &Биржа)
		|			И (ЗначенияБиржевыхИндексов.БиржевойИндекс = &БиржевойИндекс)
		|			И (ЗначенияБиржевыхИндексов.Период = _ДниДляСрезПоследнихРуониаЗаХХДней.ПериодЗначенияБиржевыхИндексов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ДниДляСрезПоследнихРуониаЗаХХДней
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДниРуониа.Дата КАК Дата,
		|	(ВЫРАЗИТЬ(СУММА(ЗначенияБиржевыхИндексов.CLOSE) / &ДнейПрошлогоПериода КАК ЧИСЛО(15, 2))) + &Добавка КАК ПроцентКупона
		|ПОМЕСТИТЬ _ПроцентКупона
		|ИЗ
		|	_ДниРуониа КАК _ДниРуониа
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СрезПоследнихРуониаЗаХХДней КАК ЗначенияБиржевыхИндексов
		|		ПО _ДниРуониа.Дата >= ЗначенияБиржевыхИндексов.Период
		|			И (ЗначенияБиржевыхИндексов.Период > ДОБАВИТЬКДАТЕ(_ДниРуониа.Дата, ДЕНЬ, -&ДнейПрошлогоПериода))
		|ГДЕ
		|	_ДниРуониа.Дата = ДОБАВИТЬКДАТЕ(&ДатаОкончанияПредидущегоКупонногоПериода, ДЕНЬ, &ДнейОтступа)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДниРуониа.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&ДатаКотировки, ГОД), КОНЕЦПЕРИОДА(&ДатаКотировки, ГОД), ДЕНЬ) = 364
		|			ТОГДА РАЗНОСТЬДАТ(&ДатаОкончанияПредидущегоКупонногоПериода, &ДатаКотировки, ДЕНЬ) * _ПроцентКупона.ПроцентКупона * 1000 / 365 / 100
		|		ИНАЧЕ РАЗНОСТЬДАТ(&ДатаОкончанияПредидущегоКупонногоПериода, &ДатаКотировки, ДЕНЬ) * _ПроцентКупона.ПроцентКупона * 1000 / &ДнейВВисокосномГоду / 100
		|	КОНЕЦ КАК КотировкаКупона,
		|	ВЫБОР
		|		КОГДА РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&ДатаОкончанияПредидущегоКупонногоПериода, ГОД), КОНЕЦПЕРИОДА(&ДатаОкончанияПериодаКупона, ГОД), ДЕНЬ) = 364
		|			ТОГДА РАЗНОСТЬДАТ(&ДатаОкончанияПредидущегоКупонногоПериода, &ДатаОкончанияПериодаКупона, ДЕНЬ) * _ПроцентКупона.ПроцентКупона * 1000 / 365 / 100
		|		ИНАЧЕ РАЗНОСТЬДАТ(&ДатаОкончанияПредидущегоКупонногоПериода, &ДатаОкончанияПериодаКупона, ДЕНЬ) * _ПроцентКупона.ПроцентКупона * 1000 / &ДнейВВисокосномГоду / 100
		|	КОНЕЦ КАК СуммаКупона
		|ИЗ
		|	_ПроцентКупона КАК _ПроцентКупона";
	
	// для госбумаг при расчете всегда учитывается високосность независимо от базы расчета, указанной в карточке
	Если РеквизитыЦеннойБумаги.Категория = Перечисления.КатегорииОблигаций.Государственная
		ИЛИ РеквизитыЦеннойБумаги.Категория = Перечисления.КатегорииОблигаций.Субфедеральная
		ИЛИ РеквизитыЦеннойБумаги.Категория = Перечисления.КатегорииОблигаций.Муниципальная Тогда
	
		ДнейВВисокосномГоду = 366;
		
	// для корпоративных бумаг мы зависим от базы расчета - если она Fixed, то високосность не считаем
	ИначеЕсли РеквизитыЦеннойБумаги.БазаРасчета = Перечисления.БазыРасчетаОблигаций.Act365Fixed
		ИЛИ РеквизитыЦеннойБумаги.БазаРасчета = Перечисления.БазыРасчетаОблигаций.Act365 Тогда
		
		ДнейВВисокосномГоду = 365;
		
	// а если не Fixed, то считаем
	Иначе
		
		ДнейВВисокосномГоду = 366;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Биржа", ОбщегоНазначения.ПолучитьИменованныйОбъект("СРО_НФА"));
	Запрос.УстановитьПараметр("БиржевойИндекс", ОбщегоНазначения.ПолучитьИменованныйОбъект("Индекс_РУОНИА"));
	Запрос.УстановитьПараметр("Календарь", Справочники.Календари.Общероссийский);
	Запрос.УстановитьПараметр("Добавка", Добавка);
	Запрос.УстановитьПараметр("ДнейВВисокосномГоду", ДнейВВисокосномГоду);
	Запрос.УстановитьПараметр("ДатаКотировки", ДатаКотировки);
	Запрос.УстановитьПараметр("ДнейОтступа", ДнейОтступа);
	Запрос.УстановитьПараметр("ДнейПрошлогоПериода", ДнейПрошлогоПериода);
	Запрос.УстановитьПараметр("ДатаОкончанияПредидущегоКупонногоПериода", ДатаНачалаПериодаКупона);
	Запрос.УстановитьПараметр("ДатаОкончанияПериодаКупона", ДатаОкончанияПериодаКупона);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОбщийИтог = РезультатЗапроса.Выбрать();
	
	ВыборкаОбщийИтог.Следующий();		// Общий итог
	
	Если РеквизитыЦеннойБумаги.Категория = Перечисления.КатегорииОблигаций.Государственная
		И РеквизитыЦеннойБумаги.УчетныйАктивЦБРФ <> Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств // появилась облигация Казахии и поломала схему
		ИЛИ РеквизитыЦеннойБумаги.Категория = Перечисления.КатегорииОблигаций.Субфедеральная // #426153 - прав-во Москвы по формуле для ОФЗ с 1го апреля 2022
			И ДатаКотировки >= '20220401'
			И РеквизитыЦеннойБумаги.Эмитент.ЮрФизЛицо = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ПрМосквыВЛицеДФ")
		ИЛИ РеквизитыЦеннойБумаги.БазаРасчета = Перечисления.БазыРасчетаОблигаций.ActICMA
		Тогда 
			
		// Считаем по методике ММВБ
		ДнейВПериоде = (НачалоДня(ДатаКотировки) - НачалоДня(ДатаНачалаПериодаКупона)) / (60 * 60 * 24);
		Срок = (НачалоДня(ДатаОкончанияПериодаКупона) - НачалоДня(ДатаНачалаПериодаКупона)) / (60 * 60 * 24);
		СуммаКупона = Окр(ВыборкаОбщийИтог.СуммаКупона, 2);
		
		Если РеквизитыЦеннойБумаги.БазаРасчета = Перечисления.БазыРасчетаОблигаций._30E360 Тогда // у валютных госбумаг нужно учитывать базу расчета
			ДнейВПериоде = (Год(ДатаКотировки) - Год(ДатаНачалаПериодаКупона)) * 360 + (Месяц(ДатаКотировки) - Месяц(ДатаНачалаПериодаКупона)) * 30 + (Мин(30, День(ДатаКотировки)) - Мин(30, День(ДатаНачалаПериодаКупона)));
		КонецЕсли;			
		
		Возврат Окр(СуммаКупона * ДнейВПериоде / Срок, 2);
		
	Иначе
		
		Возврат Окр(ВыборкаОбщийИтог.КотировкаКупона, 2);
		
	КонецЕсли;
	
КонецФункции

Функция РассчитатьКотировкуКупонаПоСреднейСтавкеРефинансирования(ЦеннаяБумага, ДатаКотировки, Добавка = 0, Смещение = 7, СмещениеВКалендарныхДнях = Истина, Точность = 0)

	Если СмещениеВКалендарныхДнях Тогда
		СмещениеКупонногоПериода = Смещение;	
	Иначе
		СмещениеКупонногоПериода = 0;	
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(КупонныйДоходПоОблигациям.Период) КАК ДатаНачалаПериодаКупона
		|ИЗ
		|	РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|ГДЕ
		|	КупонныйДоходПоОблигациям.Облигация = &Облигация
		|	И КупонныйДоходПоОблигациям.Период <= &Период";
	
	Запрос.УстановитьПараметр("Облигация", ЦеннаяБумага);
	Запрос.УстановитьПараметр("Период", ДатаКотировки);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ВыборкаДетальныеЗаписи.ДатаНачалаПериодаКупона = ДатаКотировки Тогда
			Возврат 0;
		ИначеЕсли ВыборкаДетальныеЗаписи.ДатаНачалаПериодаКупона = NULL Тогда // запросили за дату ранее начала расчетов купонов
			Возврат 0;
		Иначе
			ДатаНачалаКлючевая = ВыборкаДетальныеЗаписи.ДатаНачалаПериодаКупона - (СмещениеКупонногоПериода - 1) * 60 * 60 * 24;
		КонецЕсли;
	Иначе
		Возврат 0;
	КонецЕсли;
	
	ДатаОкончанияКлючевая = ДатаКотировки - СмещениеКупонногоПериода * 60 * 60 * 24;

	Если СмещениеВКалендарныхДнях Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеКалендаря.Дата КАК Дата
			|ПОМЕСТИТЬ _Дни
			|ИЗ
			|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|ГДЕ
			|	ДанныеКалендаря.Календарь = &Календарь
			|	И ДанныеКалендаря.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Дни.Дата КАК Дата,
			|	МАКСИМУМ(ПроцентныеПоказатели.ДатаЗначения) КАК ДатаЗначения
			|ПОМЕСТИТЬ _ДниКлючевая
			|ИЗ
			|	_Дни КАК _Дни
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПроцентныеПоказатели КАК ПроцентныеПоказатели
			|		ПО _Дни.Дата >= ПроцентныеПоказатели.ДатаЗначения
			|			И (ПроцентныеПоказатели.Показатель = &КлючеваяСтавка)
			|			И (ПроцентныеПоказатели.Источник = &ЦБРФ)
			|
			|СГРУППИРОВАТЬ ПО
			|	_Дни.Дата
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВЫБОР
			|		КОГДА РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(_ДниКлючевая.Дата, ГОД), КОНЕЦПЕРИОДА(_ДниКлючевая.Дата, ГОД), ДЕНЬ) = 364
			|			ТОГДА ВЫРАЗИТЬ((ПроцентныеПоказатели.ЗначениеПоказателя + &Добавка) * 1000 / 365 / 100 КАК ЧИСЛО(21, 19))
			|		ИНАЧЕ ВЫРАЗИТЬ((ПроцентныеПоказатели.ЗначениеПоказателя + &Добавка) * 1000 / &ДнейВВисокосномГоду / 100 КАК ЧИСЛО(21, 19))
			|	КОНЕЦ КАК СтавкаЗаДень,
			|	_ДниКлючевая.Дата КАК Дата
			|ИЗ
			|	_ДниКлючевая КАК _ДниКлючевая
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПроцентныеПоказатели КАК ПроцентныеПоказатели
			|		ПО _ДниКлючевая.ДатаЗначения = ПроцентныеПоказатели.ДатаЗначения
			|			И (ПроцентныеПоказатели.Показатель = &КлючеваяСтавка)
			|			И (ПроцентныеПоказатели.Источник = &ЦБРФ)
			|ИТОГИ
			|	СУММА(СтавкаЗаДень)
			|ПО
			|	ОБЩИЕ";
		
	Иначе	
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеКалендаря.Дата КАК Дата
			|ПОМЕСТИТЬ _Дни
			|ИЗ
			|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|ГДЕ
			|	ДанныеКалендаря.Календарь = &Календарь
			|	И ДанныеКалендаря.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, &Смещение - 30) И ДОБАВИТЬКДАТЕ(&ДатаОкончания, ДЕНЬ, 15)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 999
			|	ДанныеКалендаря.Дата КАК Дата,
			|	АВТОНОМЕРЗАПИСИ() КАК ПорядковыйНомерДня
			|ПОМЕСТИТЬ _ДниРабочие
			|ИЗ
			|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|ГДЕ
			|	ДанныеКалендаря.Календарь = &Календарь
			|	И ДанныеКалендаря.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, &Смещение - 30) И ДОБАВИТЬКДАТЕ(&ДатаОкончания, ДЕНЬ, 15)
			|	И (ДанныеКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий)
			|			ИЛИ ДанныеКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
			|
			|УПОРЯДОЧИТЬ ПО
			|	Дата
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДниРабочие.Дата КАК Дата,
			|	_ДниРабочие.ПорядковыйНомерДня КАК ПорядковыйНомерДня,
			|	МАКСИМУМ(_ДниРабочиеСоСмещением.Дата) КАК ДатаСоСмещением
			|ПОМЕСТИТЬ _ДниРабочиеСоСмещением
			|ИЗ
			|	_ДниРабочие КАК _ДниРабочие
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ДниРабочие КАК _ДниРабочиеСоСмещением
			|		ПО (_ДниРабочие.ПорядковыйНомерДня >= _ДниРабочиеСоСмещением.ПорядковыйНомерДня - &Смещение)
			|
			|СГРУППИРОВАТЬ ПО
			|	_ДниРабочие.Дата,
			|	_ДниРабочие.ПорядковыйНомерДня
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Дни.Дата КАК Дата,
			|	ВЫБОР
			|		КОГДА _Дни.Дата = _ДниРабочиеСоСмещением.Дата
			|			ТОГДА _ДниРабочиеСоСмещением.ПорядковыйНомерДня
			|		ИНАЧЕ _ДниРабочиеСоСмещением.ПорядковыйНомерДня + 1
			|	КОНЕЦ КАК ПорядковыйНомерДня
			|ПОМЕСТИТЬ _ДниИБлижайшиеРабочиеДниСУчетомВыходногоИлиПраздничного
			|ИЗ
			|	_Дни КАК _Дни
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ДниРабочиеСоСмещением КАК _ДниРабочиеСоСмещением
			|		ПО _Дни.Дата >= _ДниРабочиеСоСмещением.Дата
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДниИБлижайшиеРабочиеДниСУчетомВыходногоИлиПраздничного.Дата КАК Дата,
			|	МАКСИМУМ(_ДниИБлижайшиеРабочиеДниСУчетомВыходногоИлиПраздничного.ПорядковыйНомерДня) КАК ПорядковыйНомерДня
			|ПОМЕСТИТЬ _ДниИБлижайшиеРабочиеДниСУчетомВыходногоИлиПраздничногоСГруппировкой
			|ИЗ
			|	_ДниИБлижайшиеРабочиеДниСУчетомВыходногоИлиПраздничного КАК _ДниИБлижайшиеРабочиеДниСУчетомВыходногоИлиПраздничного
			|
			|СГРУППИРОВАТЬ ПО
			|	_ДниИБлижайшиеРабочиеДниСУчетомВыходногоИлиПраздничного.Дата
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Дни.Дата КАК Дата,
			|	МАКСИМУМ(_ДниРабочиеСоСмещением.ДатаСоСмещением) КАК БлижайшийРабочийДень,
			|	МАКСИМУМ(_ДниРабочиеСоСмещением.ПорядковыйНомерДня) КАК ПорядковыйНомерДня
			|ПОМЕСТИТЬ _ДниИБлижайшиеРабочиеДни
			|ИЗ
			|	_Дни КАК _Дни
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ДниРабочиеСоСмещением КАК _ДниРабочиеСоСмещением
			|		ПО _Дни.Дата >= _ДниРабочиеСоСмещением.Дата
			|
			|СГРУППИРОВАТЬ ПО
			|	_Дни.Дата
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_Дни.Дата КАК Дата,
			|	_ДниИБлижайшиеРабочиеДни.БлижайшийРабочийДень КАК БлижайшийРабочийДеньСоСмещением
			|ПОМЕСТИТЬ _ДниИБлижайшиеРабочиеДниСоСмещением
			|ИЗ
			|	_ДниИБлижайшиеРабочиеДниСУчетомВыходногоИлиПраздничногоСГруппировкой КАК _Дни
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ДниИБлижайшиеРабочиеДни КАК _ДниИБлижайшиеРабочиеДни
			|		ПО _Дни.ПорядковыйНомерДня = _ДниИБлижайшиеРабочиеДни.ПорядковыйНомерДня
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДниИБлижайшиеРабочиеДниСоСмещением.Дата КАК Дата,
			|	МАКСИМУМ(ПроцентныеПоказатели.Период) КАК Период
			|ПОМЕСТИТЬ _ДниКлючевая
			|ИЗ
			|	_ДниИБлижайшиеРабочиеДниСоСмещением КАК _ДниИБлижайшиеРабочиеДниСоСмещением
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПроцентныеПоказатели КАК ПроцентныеПоказатели
			|		ПО _ДниИБлижайшиеРабочиеДниСоСмещением.БлижайшийРабочийДеньСоСмещением >= ПроцентныеПоказатели.Период
			|			И (ПроцентныеПоказатели.Показатель = &КлючеваяСтавка)
			|			И (ПроцентныеПоказатели.Источник = &ЦБРФ)
			|ГДЕ
			|	_ДниИБлижайшиеРабочиеДниСоСмещением.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
			|
			|СГРУППИРОВАТЬ ПО
			|	_ДниИБлижайшиеРабочиеДниСоСмещением.Дата
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВЫБОР
			|		КОГДА РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(_ДниКлючевая.Дата, ГОД), КОНЕЦПЕРИОДА(_ДниКлючевая.Дата, ГОД), ДЕНЬ) = 364
			|			ТОГДА ВЫРАЗИТЬ((ПроцентныеПоказатели.ЗначениеПоказателя + &Добавка) * 1000 / 365 / 100 КАК ЧИСЛО(21, 19))
			|		ИНАЧЕ ВЫРАЗИТЬ((ПроцентныеПоказатели.ЗначениеПоказателя + &Добавка) * 1000 / &ДнейВВисокосномГоду / 100 КАК ЧИСЛО(21, 19))
			|	КОНЕЦ КАК СтавкаЗаДень,
			|	_ДниКлючевая.Дата КАК Дата
			|ИЗ
			|	_ДниКлючевая КАК _ДниКлючевая
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПроцентныеПоказатели КАК ПроцентныеПоказатели
			|		ПО _ДниКлючевая.Период = ПроцентныеПоказатели.Период
			|			И (ПроцентныеПоказатели.Показатель = &КлючеваяСтавка)
			|			И (ПроцентныеПоказатели.Источник = &ЦБРФ)
			|ИТОГИ
			|	СУММА(СтавкаЗаДень)
			|ПО
			|	ОБЩИЕ";
		
			КоличествоДнейВКупонномПериоде = (НачалоДня(ДатаОкончанияКлючевая) - НачалоДня(ДатаНачалаКлючевая)) / (60 * 60 * 24);
		
		    Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 999", "ПЕРВЫЕ " + Формат(КоличествоДнейВКупонномПериоде + 30 + Смещение, "ЧЦ=15; ЧДЦ=0; ЧН=1; ЧГ=0"));
	КонецЕсли;	
	
	Если Точность <> 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЧИСЛО(21, 19)", СтрШаблон("ЧИСЛО(21, %1)", Точность));
	КонецЕсли;
	
	// для госбумаг при расчете всегда учитывается високосность независимо от базы расчета, указанной в карточке
	Если ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Государственная
		ИЛИ ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Субфедеральная
		ИЛИ ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Муниципальная Тогда
	
		ДнейВВисокосномГоду = 366;
		
	// для корпоративных бумаг мы зависим от базы расчета - если она Fixed, то високосность не считаем
	ИначеЕсли ЦеннаяБумага.БазаРасчета = Перечисления.БазыРасчетаОблигаций.Act365Fixed
		ИЛИ ЦеннаяБумага.БазаРасчета = Перечисления.БазыРасчетаОблигаций.Act365 Тогда
		
		ДнейВВисокосномГоду = 365;
		
	// а если не Fixed, то считаем
	Иначе
		
		ДнейВВисокосномГоду = 366;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("КлючеваяСтавка", Перечисления.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ);
	Запрос.УстановитьПараметр("ЦБРФ", ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрЛицо_ЦБРФ"));
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаКлючевая);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончанияКлючевая);
	Запрос.УстановитьПараметр("Календарь", Справочники.Календари.Общероссийский);
	Запрос.УстановитьПараметр("Добавка", Добавка);
	Запрос.УстановитьПараметр("ДнейВВисокосномГоду", ДнейВВисокосномГоду);
	Запрос.УстановитьПараметр("Смещение", -Смещение);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОбщийИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ВыборкаОбщийИтог.Следующий();		// Общий итог
	
	Возврат Окр(ВыборкаОбщийИтог.СтавкаЗаДень, 2);
	
КонецФункции

Функция РассчитатьКотировкуКупонаПоИндексуРУОНИА(Период, НачалоПериода, Номинал)

	ДатаДляДелимого = НачалоДня(Период) - 7 * 60 * 60 * 24;
	ДатаДляДелителя = НачалоДня(НачалоПериода) - 7 * 60 * 60 * 24;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ЗначенияБиржевыхИндексовДелимое.CLOSE / ЗначенияБиржевыхИндексовДелитель.CLOSE - 1 КАК НКДвДоляхНоминала
		|ИЗ
		|	РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексовДелимое,
		|	РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексовДелитель
		|ГДЕ
		|	ЗначенияБиржевыхИндексовДелимое.Биржа = &Биржа
		|	И ЗначенияБиржевыхИндексовДелимое.БиржевойИндекс = &БиржевойИндекс
		|	И ЗначенияБиржевыхИндексовДелитель.Биржа = &Биржа
		|	И ЗначенияБиржевыхИндексовДелитель.БиржевойИндекс = &БиржевойИндекс
		|	И ЗначенияБиржевыхИндексовДелимое.Период = &ПериодДелимое
		|	И ЗначенияБиржевыхИндексовДелитель.Период = &ПериодДелитель";
	
	Запрос.УстановитьПараметр("Биржа", ОбщегоНазначения.ПолучитьИменованныйОбъект("СРО_НФА"));
	Запрос.УстановитьПараметр("БиржевойИндекс", ОбщегоНазначения.ПолучитьИменованныйОбъект("Срочное_РУОНИА"));
	Запрос.УстановитьПараметр("ПериодДелимое", ДатаДляДелимого);
	Запрос.УстановитьПараметр("ПериодДелитель", ДатаДляДелителя);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат Окр(ВыборкаДетальныеЗаписи.НКДвДоляхНоминала * Номинал, 2);
	Иначе
		Возврат 0; //Техдолг: зарегать ошибку
	КонецЕсли;
	
КонецФункции

Функция РассчитатьКотировкуКупона_ОткрытиеХолдинг4B0203(ЦеннаяБумага, ДатаКотировки)

	// Данные cbonds
	// Два расчетных периода: первый с 26.07.2017 по 24.01.2018 со ставкой 11.5% годовых, второй - с 24.01.2018 по 22.07.2020 со ставкой 12.42% годовых.	
	
	Возврат Окр(РассчитатьКупон(Перечисления.БазыРасчетаОблигаций.Act365Fixed, '20170726', '20180124', 1000, 11.5), 2, 1)
			+ Окр(РассчитатьКупон(Перечисления.БазыРасчетаОблигаций.Act365Fixed, '20180124', НачалоДня(ДатаКотировки), 1000, 12.42), 2, 1);

КонецФункции

Функция РассчитатьКотировкуКупонаПоИндексуРУОНИАиСпреду(ЦеннаяБумага, ДатаКотировки, Спред)

   // Данные cbonds
   //1-8 купоны: Rj = (max (((Index Endj-7/Index Startj-7) - 1) ; 0) * B/Tj * 100%) + S, где: <br>
   //IndexStart j-7 - значение индекса RUONIA для 7-го календарного дня, предшествующего Start j (Start j-7), публикуемое на официальном сайте Банка России в информационно-телекоммуникационной сети "Интернет". <br>
   //В случае отсутствия опубликованного значения индекса RUONIA для Start j-7 (в том числе, если Start j-7 является выходным или праздничным днем в Российской Федерации), значение индекса RUONIA принимается равным последнему значению индекса RUONIA, опубликованному Банком России до даты Start j-7. <br>
   //IndexEnd j-7 - значение индекса RUONIA для 7-го календарного дня, предшествующего End j (End j-7), публикуемое на официальном сайте Банка России в информационно-телекоммуникационной сети "Интернет". <br>
   //В случае отсутствия опубликованного значения индекса RUONIA для End j-7 (в том числе, если End j-7 является выходным или праздничным днем в Российской Федерации), значение индекса RUONIA принимается равной последнему значению индекса RUONIA, опубликованному Банком России до даты End j-7. <br>
   //S - спред, в процентах годовых <br>
   //Tj - длительность j-го купонного периода, в днях, определяемая как End j - Start j; <br>
   //В - база расчета, определяемая по формуле: B = 1/((w/366)+(1-w)/365) <br>
   //w - доля календарных дней високосного года в периоде, за который осуществляется расчет КД за j-ый купонный период. При расчете применяются календарные дни за те же даты, за которые применяются значения индекса RUONIA, используемые для расчета НКД за данный период.
   
   
   
   Запрос = Новый Запрос;
   Запрос.Текст = 
   "ВЫБРАТЬ РАЗРЕШЕННЫЕ
   |	МАКСИМУМ(КупонныйДоходПоОблигациям.Период) КАК Период,
   |	МАКСИМУМ(КупонныйДоходПоОблигациям.НомерКупона) КАК НомерКупона
   |ПОМЕСТИТЬ НашПериод
   |ИЗ
   |	Справочник.Облигации КАК Облигации
   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
   |		ПО (КупонныйДоходПоОблигациям.Облигация = Облигации.Ссылка)
   |ГДЕ
   |	Облигации.Ссылка = &ЦеннаяБумага
   |	И КупонныйДоходПоОблигациям.Период <= &ДатаКотировки
   |	И (Облигации.ДатаПогашения >= &ДатаКотировки
   |			ИЛИ Облигации.ДатаПогашения = ДАТАВРЕМЯ(1, 1, 1))
   |;
   |
   |////////////////////////////////////////////////////////////////////////////////
   |ВЫБРАТЬ РАЗРЕШЕННЫЕ
   |	НашПериод.Период КАК Период,
   |	КупонныйДоходПоОблигациям.Срок КАК Срок,
   |	КупонныйДоходПоОблигациям.ДатаОкончанияКупона КАК ДатаОкончанияКупона
   |ИЗ
   |	НашПериод КАК НашПериод
   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
   |		ПО НашПериод.Период = КупонныйДоходПоОблигациям.Период
   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФормулыРасчетаСтавокКупонов.СрезПоследних(&ДатаКотировки, Облигация = &ЦеннаяБумага) КАК ФормулыРасчетаСтавокКупоновСрезПоследних
   |		ПО НашПериод.НомерКупона = ФормулыРасчетаСтавокКупоновСрезПоследних.НомерКупона
   |ГДЕ
   |	КупонныйДоходПоОблигациям.Облигация = &ЦеннаяБумага";
   
   Запрос.УстановитьПараметр("ДатаКотировки", ДатаКотировки);
   Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);
   
