Функция ПолучитьНоминалИВалютуЦеннойБумаги(ЦеннаяБумага, Период) Экспорт
	
	НоминалИВалютаЦеннойБумаги = Новый Структура("Номинал, ВалютаНоминала");
	
	Если ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Акции") Тогда
		ЗаполнитьЗначенияСвойств(НоминалИВалютаЦеннойБумаги, ЦеннаяБумага);
	ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Векселя") Тогда
		ЗаполнитьЗначенияСвойств(НоминалИВалютаЦеннойБумаги, ЦеннаяБумага);
	ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НоминалыЦенныхБумагСрезПоследних.Номинал,
			|	НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала
			|ИЗ
			|	РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&Период, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследних";
			
		Запрос.Параметры.Вставить("Период",       Период);
		Запрос.Параметры.Вставить("ЦеннаяБумага", ЦеннаяБумага);
			
		Выборка = Запрос.Выполнить().Выбрать();	
		
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(НоминалИВалютаЦеннойБумаги, Выборка);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Паи") Тогда
		НоминалИВалютаЦеннойБумаги.Номинал = 0;
		НоминалИВалютаЦеннойБумаги.ВалютаНоминала = ЦеннаяБумага.ВалютаНоминала;
	ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.ДепозитарныеРасписки") Тогда
		НоминалИВалютаЦеннойБумаги.Номинал = 0;
		НоминалИВалютаЦеннойБумаги.ВалютаНоминала = ЦеннаяБумага.ВалютаНоминала;
	КонецЕсли;
	
	Возврат НоминалИВалютаЦеннойБумаги;
	
КонецФункции

Функция ЗаполнитьНоминалыИСуммыВсегоВТаблице(ЦенныеБумаги, Период, Организация = Неопределено) Экспорт
	
	Если ЦенныеБумаги.Количество() = 0 Тогда
		Возврат ЦенныеБумаги;
	КонецЕсли;
	
	// чтобы порядок строк в полученной таблице совпадал с порядком строк в исходной таблице,
	// упорядочим результат по номеру строки
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ЦеннаяБумага КАК ЦеннаяБумага,
		|	&СуммаВсего КАК СуммаВсего,
		|	&СуммаВсегоВВалютеУчета КАК СуммаВсегоВВалютеУчета,
		|	&СуммаВсегоРынок КАК СуммаВсегоРынок,
		|	&СуммаВсегоРынокВВалютеУчета КАК СуммаВсегоРынокВВалютеУчета,
		|	ЦенныеБумаги.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ _ЦенныеБумаги
		|ИЗ
		|	&ЦенныеБумаги КАК ЦенныеБумаги
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ВалютаУчета КАК ВалютаУчета,
		|	&ВсеПоляЦенныхБумаг КАК ВсеПоляЦенныхБумаг,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА Акции.ВалютаНоминала
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА Векселя.ВалютаНоминала
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА Облигации.ВалютаНоминала
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА Паи.ВалютаНоминала
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.ДепозитарныеРасписки)
		|			ТОГДА ДепозитарныеРасписки.ВалютаНоминала
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|			ТОГДА ИпотечныеСертификатыУчастия.ВалютаНоминала
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.ПроизводныеФинансовыеИнструменты)
		|				И ПроизводныеФинансовыеИнструменты.ТипПроизводногоФинансовогоИнструмента В (ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Фьючерс), ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Опцион))
		|			ТОГДА ПроизводныеФинансовыеИнструменты.Валюта
		|	КОНЕЦ КАК ВалютаНоминала,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА Акции.Номинал
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА Векселя.Номинал
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА НоминалыЦенныхБумагСрезПоследних.Номинал
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА 0
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.ДепозитарныеРасписки)
		|			ТОГДА 0
		|	КОНЕЦ КАК Номинал
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = Акции.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Векселя КАК Векселя
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = Векселя.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = Паи.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеРасписки КАК ДепозитарныеРасписки
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = ДепозитарныеРасписки.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = ИпотечныеСертификатыУчастия.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПроизводныеФинансовыеИнструменты КАК ПроизводныеФинансовыеИнструменты
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = ПроизводныеФинансовыеИнструменты.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
		|				&Период,
		|				ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						_ЦенныеБумаги.ЦеннаяБумага
		|					ИЗ
		|						_ЦенныеБумаги
		|					ГДЕ
		|						ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации))) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|
		|УПОРЯДОЧИТЬ ПО
		|	_ЦенныеБумаги.НомерСтроки");
	
	ИсключаемыеПоля = Новый Массив;
	ИсключаемыеПоля.Добавить("НомерСтроки");
	ИсключаемыеПоля.Добавить("Номинал");
	ИсключаемыеПоля.Добавить("ВалютаНоминала");

	РасчетПоляВсего = "";
	Если ЦенныеБумаги.Колонки.Найти("Сумма") <> Неопределено
		И ЦенныеБумаги.Колонки.Найти("СуммаКупона") <> Неопределено
	Тогда
		РасчетПоляВсего = "Сумма + СуммаКупона КАК СуммаВсего,";
		ИсключаемыеПоля.Добавить("СуммаВсего");
	КонецЕсли;
	
	РасчетПоляВсегоВВалютеУчета = "";
	Если ЦенныеБумаги.Колонки.Найти("СуммаВВалютеУчета") <> Неопределено
		И ЦенныеБумаги.Колонки.Найти("СуммаКупонаВВалютеУчета") <> Неопределено
	Тогда
		РасчетПоляВсего = "СуммаВВалютеУчета + СуммаКупонаВВалютеУчета КАК СуммаВсегоВВалютеУчета,";
		ИсключаемыеПоля.Добавить("СуммаВсегоВВалютеУчета");
	КонецЕсли;
	
	РасчетПоляВсегоРынок = "";
	Если ЦенныеБумаги.Колонки.Найти("СуммаРынок") <> Неопределено
		И ЦенныеБумаги.Колонки.Найти("СуммаКупонаРынок") <> Неопределено
	Тогда
		РасчетПоляВсегоРынок = "СуммаРынок + СуммаКупонаРынок КАК СуммаВсегоРынок,";
		ИсключаемыеПоля.Добавить("СуммаВсегоРынок");
	КонецЕсли;	
	
	РасчетПоляВсегоРынокВВалютеУчета = "";
	Если ЦенныеБумаги.Колонки.Найти("СуммаРынокВВалютеУчета") <> Неопределено
		И ЦенныеБумаги.Колонки.Найти("СуммаКупонаРынокВВалютеУчета") <> Неопределено
	Тогда
		РасчетПоляВсегоРынокВВалютеУчета = "СуммаРынокВВалютеУчета + СуммаКупонаРынокВВалютеУчета КАК СуммаВсегоРынокВВалютеУчета,";
		ИсключаемыеПоля.Добавить("СуммаВсегоРынокВВалютеУчета");
	КонецЕсли;
	
	РасчетПоляВалютаУчета = "";
	Если Организация <> Неопределено
		И ЦенныеБумаги.Колонки.Найти("ВалютаУчета") <> Неопределено
	Тогда
		РасчетПоляВалютаУчета = "ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).ВалютаУчета КАК ВалютаУчета,";
		ИсключаемыеПоля.Добавить("ВалютаУчета");
	КонецЕсли;
	
	ИсключаемыеПоляСтрокой  = СтрСоединить(ИсключаемыеПоля, ", ");
	ПоляТаблицыДляЗапроса = РаботаСКоллекциями.ПолучитьПоляТаблицыДляЗапроса(ЦенныеБумаги, , ИсключаемыеПоляСтрокой);

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЦеннаяБумага КАК ЦеннаяБумага",									ПоляТаблицыДляЗапроса);		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СуммаВсего КАК СуммаВсего,",										РасчетПоляВсего);		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СуммаВсегоВВалютеУчета КАК СуммаВсегоВВалютеУчета,",				РасчетПоляВсегоВВалютеУчета);		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СуммаВсегоРынок КАК СуммаВсегоРынок,",							РасчетПоляВсегоРынок);		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СуммаВсегоРынокВВалютеУчета КАК СуммаВсегоРынокВВалютеУчета,",	РасчетПоляВсегоРынокВВалютеУчета);		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВсеПоляЦенныхБумаг КАК ВсеПоляЦенныхБумаг",						"_ЦенныеБумаги.*");		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВалютаУчета КАК ВалютаУчета,",									РасчетПоляВалютаУчета);
	
	Запрос.УстановитьПараметр("Период",			Период);
	Запрос.УстановитьПараметр("ЦенныеБумаги",	ЦенныеБумаги);
	Запрос.УстановитьПараметр("Организация",	Организация);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ЗаполнитьКотировкиНоминалыИСуммыВсегоВТаблице(ЦенныеБумаги, Период, Рынок, Биржа, КлиентЯвляетсяНПФилиПН, Организация = Неопределено) Экспорт
	Если ЦенныеБумаги.Количество() = 0 Тогда
		Возврат ЦенныеБумаги;
	КонецЕсли;
	
	ТекстЗапросаДляКотировок = СформироватьТекстЗапросаДляКотировок(Рынок, КлиентЯвляетсяНПФилиПН);
	Если ТекстЗапросаДляКотировок = "" Тогда
		Если Организация <> Неопределено И ЦенныеБумаги.Колонки.Найти("ВалютаУчета") <> Неопределено Тогда
			ЦенныеБумаги.ЗаполнитьЗначения(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета"), "ВалютаУчета");
		КонецЕсли;
		
		Возврат ЦенныеБумаги;
	КонецЕсли;
	
	РасчетПоляВсегоРынокВВалютеУчета = "";
	Если ЦенныеБумаги.Колонки.Найти("СуммаРынокВВалютеУчета") <> Неопределено
		И ЦенныеБумаги.Колонки.Найти("СуммаКупонаРынокВВалютеУчета") <> Неопределено 
	Тогда
		РасчетПоляВсегоРынокВВалютеУчета = "ЦенныеБумаги.СуммаРынокВВалютеУчета + ЦенныеБумаги.СуммаКупонаРынокВВалютеУчета КАК СуммаВсегоРынокВВалютеУчета,";
	КонецЕсли;
	
	РасчетныеПоля = "СуммаВсего, СуммаВсегоРынок, СуммаВсегоРынокВВалютеУчета, Номинал, ВалютаНоминала, Котировка, КотировкаВПроцентах, КупонКотировка";
	
	Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ " + РаботаСКоллекциями.ПолучитьПоляТаблицыДляЗапроса(ЦенныеБумаги, , РасчетныеПоля) + ",
		|	" + РасчетПоляВсегоРынокВВалютеУчета + "
		|	ЦенныеБумаги.Сумма + ЦенныеБумаги.СуммаКупона КАК СуммаВсего,
		|	ЦенныеБумаги.СуммаРынок + ЦенныеБумаги.СуммаКупонаРынок КАК СуммаВсегоРынок
		|ПОМЕСТИТЬ _ЦенныеБумаги
		|ИЗ
		|	&ЦенныеБумаги КАК ЦенныеБумаги
		|ИНДЕКСИРОВАТЬ ПО
		|	ЦеннаяБумага; " + ТекстЗапросаДляКотировок);
	
	Запрос.УстановитьПараметр("ЦенныеБумаги", ЦенныеБумаги);
	Запрос.УстановитьПараметр("Период",       Период);
	Запрос.УстановитьПараметр("Рынок",        Рынок);
	Запрос.УстановитьПараметр("Биржа",        Биржа);
	Запрос.УстановитьПараметр("Организация",  Организация);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции // ЗаполнитьКотировкиНоминалыИСуммыВсегоВТаблице

Функция СформироватьТекстЗапросаДляКотировок(Рынок, КлиентЯвляетсяНПФилиПН)
	ТекстЗапроса =
	#Область ЧастичныйТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Период КАК Период,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.РежимТоргов КАК РежимТоргов,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта КАК Валюта,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ВалютныеПары), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Опционы), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Фьючерсы))
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага.Валюта
		|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия))
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага.ВалютаНоминала
		|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага.БазоваяЦБ.ВалютаНоминала
		|	КОНЕЦ КАК ВалютаНоминала,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя))
		|			ТОГДА КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага.Номинал
		|	КОНЕЦ КАК Номинал,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.ACCINT КАК ACCINT,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.ACCINT_DATE КАК ACCINT_DATE,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE3 КАК MARKETPRICE3,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.MARKETPRICE3_DATE КАК MARKETPRICE3_DATE
		|ПОМЕСТИТЬ _ПоследниеКотировки
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|				&Период,
		|				РежимТоргов.ОсновнойРежим
		|					И ЦеннаяБумага В
		|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|							_ЦенныеБумаги.ЦеннаяБумага
		|						ИЗ
		|							_ЦенныеБумаги КАК _ЦенныеБумаги)
		|					И Биржа = &Биржа
		|					И Рынок = &Рынок) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	_ЦенныеБумаги.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПоследниеКотировки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	МАКСИМУМ(_ПоследниеКотировки.MARKETPRICE3_DATE) КАК MARKETPRICE3_DATE
		|ПОМЕСТИТЬ _ДатыПоследнихЗначенийКотировок
		|ИЗ
		|	_ПоследниеКотировки КАК _ПоследниеКотировки
		|
		|СГРУППИРОВАТЬ ПО
		|	_ПоследниеКотировки.ЦеннаяБумага
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	_ПоследниеКотировки.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПоследниеКотировки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	МАКСИМУМ(_ПоследниеКотировки.Период) КАК МаксимальныйПериод,
		|	МАКСИМУМ(ДатыПоследнихЗначенийMARKETPRICE3.MARKETPRICE3_DATE) КАК MARKETPRICE3_DATE,
		|	ВЫБОР
		|		КОГДА МАКСИМУМ(НЕ ДатыПоследнихЗначенийACCINT.ЦеннаяБумага ЕСТЬ NULL
		|					И _ПоследниеКотировки.Валюта = _ПоследниеКотировки.ВалютаНоминала)
		|			ТОГДА МАКСИМУМ(ВЫБОР
		|						КОГДА НЕ ДатыПоследнихЗначенийACCINT.ЦеннаяБумага ЕСТЬ NULL
		|								И _ПоследниеКотировки.Валюта = _ПоследниеКотировки.ВалютаНоминала
		|							ТОГДА _ПоследниеКотировки.РежимТоргов
		|					КОНЕЦ)
		|		ИНАЧЕ МАКСИМУМ(ВЫБОР
		|					КОГДА НЕ ДатыПоследнихЗначенийACCINT.ЦеннаяБумага ЕСТЬ NULL
		|						ТОГДА _ПоследниеКотировки.РежимТоргов
		|				КОНЕЦ)
		|	КОНЕЦ КАК РежимТорговДляACCINT,
		|	ВЫБОР
		|		КОГДА МАКСИМУМ(НЕ ДатыПоследнихЗначенийMARKETPRICE3.ЦеннаяБумага ЕСТЬ NULL
		|					И _ПоследниеКотировки.Валюта = _ПоследниеКотировки.ВалютаНоминала
		|					И _ПоследниеКотировки.MARKETPRICE3 <> 0)
		|			ТОГДА МАКСИМУМ(ВЫБОР
		|						КОГДА НЕ ДатыПоследнихЗначенийMARKETPRICE3.ЦеннаяБумага ЕСТЬ NULL
		|								И _ПоследниеКотировки.Валюта = _ПоследниеКотировки.ВалютаНоминала
		|								И _ПоследниеКотировки.MARKETPRICE3 <> 0
		|							ТОГДА _ПоследниеКотировки.РежимТоргов
		|					КОНЕЦ)
		|		ИНАЧЕ МАКСИМУМ(ВЫБОР
		|					КОГДА НЕ ДатыПоследнихЗначенийMARKETPRICE3.ЦеннаяБумага ЕСТЬ NULL
		|							И _ПоследниеКотировки.MARKETPRICE3 <> 0
		|						ТОГДА _ПоследниеКотировки.РежимТоргов
		|				КОНЕЦ)
		|	КОНЕЦ КАК РежимТорговДляMARKETPRICE3
		|ПОМЕСТИТЬ _РежимыТорговПоследнихКотировок
		|ИЗ
		|	_ПоследниеКотировки КАК _ПоследниеКотировки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыПоследнихЗначенийКотировок КАК ДатыПоследнихЗначенийACCINT
		|		ПО _ПоследниеКотировки.ЦеннаяБумага = ДатыПоследнихЗначенийACCINT.ЦеннаяБумага
		|			И (_ПоследниеКотировки.Период = &Период)
		|			И (_ПоследниеКотировки.ACCINT_DATE = &Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыПоследнихЗначенийКотировок КАК ДатыПоследнихЗначенийMARKETPRICE3
		|		ПО _ПоследниеКотировки.ЦеннаяБумага = ДатыПоследнихЗначенийMARKETPRICE3.ЦеннаяБумага
		|			И _ПоследниеКотировки.MARKETPRICE3_DATE = ДатыПоследнихЗначенийMARKETPRICE3.MARKETPRICE3_DATE
		|ГДЕ
		|	(НЕ ДатыПоследнихЗначенийACCINT.ЦеннаяБумага ЕСТЬ NULL
		|			ИЛИ НЕ ДатыПоследнихЗначенийMARKETPRICE3.ЦеннаяБумага ЕСТЬ NULL)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ПоследниеКотировки.ЦеннаяБумага
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	_ПоследниеКотировки.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ДатыПоследнихЗначенийКотировок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_РежимыТорговПоследнихКотировок.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЕСТЬNULL(ПоследниеКотировкиДляACCINT.ВалютаНоминала, ПоследниеКотировкиДляMARKETPRICE3.ВалютаНоминала) КАК ВалютаНоминала,
		|	ЕСТЬNULL(ПоследниеКотировкиДляACCINT.Номинал, ПоследниеКотировкиДляMARKETPRICE3.Номинал) КАК Номинал,
		|	ЕСТЬNULL(КупоныВыходногоДня.Период, _РежимыТорговПоследнихКотировок.МаксимальныйПериод) КАК Период,
		|	ВЫБОР
		|		КОГДА НЕ КупоныВыходногоДня.Период ЕСТЬ NULL
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ПоследниеКотировкиДляACCINT.РежимТоргов
		|	КОНЕЦ КАК РежимТорговДляACCINT,
		|	ПоследниеКотировкиДляMARKETPRICE3.РежимТоргов КАК РежимТорговДляMARKETPRICE3,
		|	ЕСТЬNULL(КупоныВыходногоДня.ACCINT, ПоследниеКотировкиДляACCINT.ACCINT) КАК ACCINT,
		|	ПоследниеКотировкиДляMARKETPRICE3.MARKETPRICE3 КАК MARKETPRICE3,
		|	ПоследниеКотировкиДляMARKETPRICE3.MARKETPRICE3_DATE КАК MARKETPRICE3_DATE
		|ПОМЕСТИТЬ _КотировкиЦенныхБумаг
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РежимыТорговПоследнихКотировок КАК _РежимыТорговПоследнихКотировок
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = _РежимыТорговПоследнихКотировок.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПоследниеКотировки КАК ПоследниеКотировкиДляACCINT
		|		ПО (_РежимыТорговПоследнихКотировок.ЦеннаяБумага = ПоследниеКотировкиДляACCINT.ЦеннаяБумага)
		|			И (_РежимыТорговПоследнихКотировок.РежимТорговДляACCINT = ПоследниеКотировкиДляACCINT.РежимТоргов)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПоследниеКотировки КАК ПоследниеКотировкиДляMARKETPRICE3
		|		ПО (_РежимыТорговПоследнихКотировок.ЦеннаяБумага = ПоследниеКотировкиДляMARKETPRICE3.ЦеннаяБумага)
		|			И (_РежимыТорговПоследнихКотировок.РежимТорговДляMARKETPRICE3 = ПоследниеКотировкиДляMARKETPRICE3.РежимТоргов)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупоныВыходногоДня КАК КупоныВыходногоДня
		|		ПО (КупоныВыходногоДня.Период = &Период)
		|			И (_ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Облигации)
		|			И _ЦенныеБумаги.ЦеннаяБумага = КупоныВыходногоДня.Облигация
		|			И (ПоследниеКотировкиДляACCINT.ЦеннаяБумага ЕСТЬ NULL
		|				ИЛИ НЕ ПоследниеКотировкиДляACCINT.ЦеннаяБумага ЕСТЬ NULL
		|					И КупоныВыходногоДня.Биржа = &Биржа)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	_РежимыТорговПоследнихКотировок.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ПоследниеКотировки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _РежимыТорговПоследнихКотировок";
	#КонецОбласти
	
	Если Рынок = Перечисления.РынкиЦенныхБумаг.Паи Тогда
		#Область ЧастичныйТекстЗапроса
		ТекстЗапроса = ТекстЗапроса + "
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ЦенныеБумаги.*,
			|	0 КАК Номинал,
			|	_КотировкиЦенныхБумаг.ВалютаНоминала КАК ВалютаНоминала,
			|	ЕСТЬNULL(_КотировкиЦенныхБумаг.MARKETPRICE3, 0) КАК Котировка,
			|	Организации.ВалютаУчета КАК ВалютаУчета
			|ИЗ
			|	_ЦенныеБумаги КАК _ЦенныеБумаги
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КотировкиЦенныхБумаг КАК _КотировкиЦенныхБумаг
			|		ПО _ЦенныеБумаги.ЦеннаяБумага = _КотировкиЦенныхБумаг.ЦеннаяБумага
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
			|		ПО Организации.Ссылка = &Организация";
		#КонецОбласти
		
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		#Область ЧастичныйТекстЗапроса
		ТекстЗапроса = ТекстЗапроса + "
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ЦенныеБумаги.*,
			|	_КотировкиЦенныхБумаг.ВалютаНоминала КАК ВалютаНоминала,
			|	ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследних.Номинал, 0) КАК Номинал,
			|	ЕСТЬNULL(_КотировкиЦенныхБумаг.MARKETPRICE3, 0) КАК КотировкаВПроцентах,
			|	ЕСТЬNULL(_КотировкиЦенныхБумаг.MARKETPRICE3, 0) * ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследних.Номинал, 0) / 100. КАК Котировка,
			|	ЕСТЬNULL(_КотировкиЦенныхБумаг.ACCINT, 0) КАК КупонКотировка,
			|	Организации.ВалютаУчета КАК ВалютаУчета
			|ИЗ
			|	_ЦенныеБумаги КАК _ЦенныеБумаги
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КотировкиЦенныхБумаг КАК _КотировкиЦенныхБумаг
			|		ПО _ЦенныеБумаги.ЦеннаяБумага = _КотировкиЦенныхБумаг.ЦеннаяБумага
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
			|			&Период,
			|			ЦеннаяБумага В(
			|				ВЫБРАТЬ
			|					_ЦенныеБумаги.ЦеннаяБумага
			|				ИЗ
			|					_ЦенныеБумаги
			|			)
			|		) КАК НоминалыЦенныхБумагСрезПоследних
			|		ПО _ЦенныеБумаги.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
			|		ПО Организации.Ссылка = &Организация";
		#КонецОбласти
			
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Акции Или Рынок = Перечисления.РынкиЦенныхБумаг.Векселя Тогда
		#Область ЧастичныйТекстЗапроса
		ТекстЗапроса = ТекстЗапроса + "
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ЦенныеБумаги.*,
			|	_КотировкиЦенныхБумаг.Номинал КАК Номинал,
			|	_КотировкиЦенныхБумаг.ВалютаНоминала КАК ВалютаНоминала,
			|	ЕСТЬNULL(_КотировкиЦенныхБумаг.MARKETPRICE3, 0) КАК Котировка,
			|	Организации.ВалютаУчета КАК ВалютаУчета
			|ИЗ
			|	_ЦенныеБумаги КАК _ЦенныеБумаги
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КотировкиЦенныхБумаг КАК _КотировкиЦенныхБумаг
			|		ПО _ЦенныеБумаги.ЦеннаяБумага = _КотировкиЦенныхБумаг.ЦеннаяБумага
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
			|		ПО Организации.Ссылка = &Организация";
		#КонецОбласти
		
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.ДепозитарныеРасписки Тогда
		#Область ЧастичныйТекстЗапроса
		ТекстЗапроса = ТекстЗапроса + "
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ЦенныеБумаги.*,
			|	0 КАК Номинал,
			|	_КотировкиЦенныхБумаг.ВалютаНоминала КАК ВалютаНоминала,
			|	ЕСТЬNULL(_КотировкиЦенныхБумаг.MARKETPRICE3, 0) КАК Котировка,
			|	Организации.ВалютаУчета КАК ВалютаУчета
			|ИЗ
			|	_ЦенныеБумаги КАК _ЦенныеБумаги
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КотировкиЦенныхБумаг КАК _КотировкиЦенныхБумаг
			|		ПО _ЦенныеБумаги.ЦеннаяБумага = _КотировкиЦенныхБумаг.ЦеннаяБумага
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
			|		ПО Организации.Ссылка = &Организация";
		#КонецОбласти
	Иначе
		Возврат "";
	КонецЕсли;

	Если КлиентЯвляетсяНПФилиПН Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "MARKETPRICE3", "MARKETPRICE2");
	КонецЕсли;
	
	// Чтобы порядок строк в полученной таблице совпадал с порядком строк в исходной таблице, упорядочим результат по номеру строки
	ТекстЗапроса = ТекстЗапроса + Символы.ПС +
		"УПОРЯДОЧИТЬ ПО
		|	_ЦенныеБумаги.НомерСтроки";
	
	Возврат ТекстЗапроса;
КонецФункции

////////////////////////////////////////////////////////////////////////////////

Функция КонтрагентПоЦеннойБумаге(ЦеннаяБумага, Период = Неопределено) Экспорт
		
	Если ЗначениеЗаполнено(ЦеннаяБумага)  Тогда
		ТипЦБ = ТипЗнч(ЦеннаяБумага);
		
		Если ТипЦБ = Тип("СправочникСсылка.Паи")  Тогда
			ТекПериод = ?(Период = Неопределено, ТекущаяДата(), Период);
			УправляющаяКомпания = Справочники.УправляющиеКомпании.ПолучитьУправляющуюКомпаниюПИФДляПаяНаДату(ТекПериод, ЦеннаяБумага);
			Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УправляющаяКомпания, "ЮрФизЛицо");
		ИначеЕсли ТипЦБ = Тип("СправочникСсылка.Закладные")  Тогда
			Возврат ЦеннаяБумага.Банк.ЮрФизЛицо;	
		ИначеЕсли ТипЦБ = Тип("СправочникСсылка.Доли")  Тогда
			Возврат ЦеннаяБумага.ЮрЛицо;	
		Иначе
			Возврат ЦеннаяБумага.Эмитент.ЮрФизЛицо;
		КонецЕсли;	
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции 

Функция ПолучитьРасчетнуюЦенуПая(ЦеннаяБумага, Период) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена
		|ИЗ
		|	РегистрСведений.РасчетныеЦеныПаев.СрезПоследних(&Период, ЦеннаяБумага = &ЦеннаяБумага) КАК РасчетныеЦеныПаевСрезПоследних";

	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);

	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
	
		Возврат ВыборкаДетальныеЗаписи.РасчетнаяЦена;
	
	КонецЕсли;
	
	Возврат 0;

КонецФункции

Процедура РассчитатьРыночнуюЦену(ТаблицаКотировок, ПараметрыРасчета, РабочаяДатаПереоценки) Экспорт

	СчетДоверительногоУправления 	= ПараметрыРасчета.СчетДоверительногоУправления;
	ВариантРасчетаСтоимости 		= ПараметрыРасчета.ВариантРасчетаОценочнойСтоимости;
	Организация = ПараметрыРасчета.Организация;
	Период 		= НачалоДня(ПараметрыРасчета.Дата);
	
	СоответствиеПериодов = Новый Соответствие;
	ТекущийПериод = Неопределено;
	
	Для каждого СтрокаТаблицыКотировок Из ТаблицаКотировок Цикл
		
		Если СтрокаТаблицыКотировок.Рынок = Перечисления.РынкиЦенныхБумаг.Паи 
			И НЕ СтрокаТаблицыКотировок.ДатаКотировки = РабочаяДатаПереоценки Тогда //Пай по сча если не на дату
			
			РасчетнаяЦенаПая = СтрокаТаблицыКотировок.РасчетнаяЦенаПая;
			Если РасчетнаяЦенаПая <> 0 Тогда
				
				СтрокаТаблицыКотировок.ОценочнаяЦена 		= РасчетнаяЦенаПая;
				СтрокаТаблицыКотировок.ОценочнаяЦенаПроцент = РасчетнаяЦенаПая;
				СтрокаТаблицыКотировок.ОценочнаяСумма 		= СтрокаТаблицыКотировок.ОценочнаяЦена * СтрокаТаблицыКотировок.Количество;
				СтрокаТаблицыКотировок.ПолеЦены 			= Перечисления.ИсточникиЦеныДляПереоценки.СЧА;
				
			КонецЕсли;
								
		ИначеЕсли СтрокаТаблицыКотировок.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации 
			И СтрокаТаблицыКотировок.ДатаПогашения <= Период Тогда //Погашенные облигации нужно брать - по 100%
		
			СтрокаТаблицыКотировок.ОценочнаяЦена 		= СтрокаТаблицыКотировок.Номинал;
			СтрокаТаблицыКотировок.ОценочнаяЦенаПроцент = 100;
			СтрокаТаблицыКотировок.ОценочнаяСумма 		= СтрокаТаблицыКотировок.ОценочнаяЦена * СтрокаТаблицыКотировок.Количество;
			СтрокаТаблицыКотировок.ПолеЦены 			= Перечисления.ИсточникиЦеныДляПереоценки.Погашена;
			
		ИначеЕсли (ВариантРасчетаСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная2ДляПенсионныхНакоплений ИЛИ ВариантРасчетаСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная2ДляПенсионныхРезервов)
			И СтрокаТаблицыКотировок.ДатаКотировки = РабочаяДатаПереоценки Тогда
			
			СтрокаТаблицыКотировок.ОценочнаяЦена 		= СтрокаТаблицыКотировок.РыночнаяЦена;
			СтрокаТаблицыКотировок.ОценочнаяЦенаПроцент = СтрокаТаблицыКотировок.РыночнаяЦенаПроцент;
			СтрокаТаблицыКотировок.ОценочнаяСумма 		= СтрокаТаблицыКотировок.ОценочнаяЦена * СтрокаТаблицыКотировок.Количество;
			СтрокаТаблицыКотировок.ПолеЦены 			= Перечисления.ИсточникиЦеныДляПереоценки.РыночнаяЦена;
			
		ИначеЕсли СтрокаТаблицыКотировок.ТребуетсяРасчет Тогда
			// Котировка не в дату. Заполняем соответствие периодов и ценных бумаг, по которым требуется расчет
			ТекущийПериод = СтрокаТаблицыКотировок.ДатаКотировки;
			Если СоответствиеПериодов.Получить(ТекущийПериод) = Неопределено Тогда
				МассивЦенныхБумаг = Новый Массив;
				МассивЦенныхБумаг.Добавить(СтрокаТаблицыКотировок.ЦеннаяБумага);
				СоответствиеПериодов.Вставить(ТекущийПериод, МассивЦенныхБумаг);
			ИначеЕсли СоответствиеПериодов[ТекущийПериод].Найти(СтрокаТаблицыКотировок.ЦеннаяБумага) = Неопределено Тогда
				СоответствиеПериодов[ТекущийПериод].Добавить(СтрокаТаблицыКотировок.ЦеннаяБумага);
			КонецЕсли;
		КонецЕсли; 
	КонецЦикла; 
	Запрос = Новый Запрос;
		Запрос.Текст =  
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОстаткиЦенныхБумагОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ПОМЕСТИТЬ _НачальныеОстатки
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ЦеннаяБумага В (&ЦенныеБумаги)) КАК ОстаткиЦенныхБумагОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(ОперацииСЦеннымиБумагами.ДатаОперации, ДЕНЬ) КАК ДатаОперации,
		|	ОперацииСЦеннымиБумагами.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА ОперацииСЦеннымиБумагами.Сумма
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаПриход,
		|	ВЫБОР
		|		КОГДА ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА ОперацииСЦеннымиБумагами.Количество
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоПриход,
		|	ВЫБОР
		|		КОГДА ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|			ТОГДА ОперацииСЦеннымиБумагами.Сумма
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаРасход,
		|	ВЫБОР
		|		КОГДА ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|			ТОГДА ОперацииСЦеннымиБумагами.Количество
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоРасход
		|ПОМЕСТИТЬ _ОперацииСЦеннымиБумагами
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|ГДЕ
		|	ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОперацииСЦеннымиБумагами.ЦеннаяБумага В(&ЦенныеБумаги)
		|	И (ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Операция) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
		|			ИЛИ ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Операция) = ТИП(Документ.ПоставкаЦенныхБумаг)
		|			ИЛИ ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Операция) = ТИП(Документ.Сделка)
		|				И НЕ ВЫРАЗИТЬ(ОперацииСЦеннымиБумагами.Операция КАК Документ.Сделка).ОтложенноеИсполнение)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ОперацииСЦеннымиБумагами.ДатаОперации, ДЕНЬ),
		|	ОперацииСЦеннымиБумагами.ЦеннаяБумага,
		|	ВводЦенныхБумагЦенныеБумаги.СуммаРынок,
		|	ОперацииСЦеннымиБумагами.Количество,
		|	0,
		|	0
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО ОперацииСЦеннымиБумагами.Операция = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|			И ОперацииСЦеннымиБумагами.ЦеннаяБумага = ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага
		|			И ОперацииСЦеннымиБумагами.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
		|ГДЕ
		|	ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОперацииСЦеннымиБумагами.ЦеннаяБумага В(&ЦенныеБумаги)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ОперацииСЦеннымиБумагами.ДатаОперации, ДЕНЬ),
		|	ОперацииСЦеннымиБумагами.ЦеннаяБумага,
		|	0,
		|	0,
		|	ВыводЦенныхБумагЦенныеБумаги.СуммаРынок,
		|	ОперацииСЦеннымиБумагами.Количество
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыводЦенныхБумаг.ЦенныеБумаги КАК ВыводЦенныхБумагЦенныеБумаги
		|		ПО ОперацииСЦеннымиБумагами.Операция = ВыводЦенныхБумагЦенныеБумаги.Ссылка
		|			И ОперацииСЦеннымиБумагами.ЦеннаяБумага = ВыводЦенныхБумагЦенныеБумаги.ЦеннаяБумага
		|ГДЕ
		|	ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОперацииСЦеннымиБумагами.ЦеннаяБумага В(&ЦенныеБумаги)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_ОперацииСЦеннымиБумагами.ЦеннаяБумага, _НачальныеОстатки.ЦеннаяБумага) КАК ЦеннаяБумага,
		|	ЕСТЬNULL(_ОперацииСЦеннымиБумагами.ДатаОперации, &НачалоПериода) КАК ДатаОперации,
		|	СУММА(ЕСТЬNULL(_ОперацииСЦеннымиБумагами.СуммаПриход, 0)) КАК СуммаПриход,
		|	СУММА(ЕСТЬNULL(_ОперацииСЦеннымиБумагами.КоличествоПриход, 0)) КАК КоличествоПриход,
		|	СУММА(ЕСТЬNULL(_ОперацииСЦеннымиБумагами.СуммаРасход, 0)) КАК СуммаРасход,
		|	СУММА(ЕСТЬNULL(_ОперацииСЦеннымиБумагами.КоличествоРасход, 0)) КАК КоличествоРасход,
		|	МАКСИМУМ(ЕСТЬNULL(_НачальныеОстатки.КоличествоОстаток, 0)) КАК КоличествоНачальное
		|ПОМЕСТИТЬ _ОперацииСЦеннымиБумагамиИНачальныеОстатки
		|ИЗ
		|	_ОперацииСЦеннымиБумагами КАК _ОперацииСЦеннымиБумагами
		|		ПОЛНОЕ СОЕДИНЕНИЕ _НачальныеОстатки КАК _НачальныеОстатки
		|		ПО _ОперацииСЦеннымиБумагами.ЦеннаяБумага = _НачальныеОстатки.ЦеннаяБумага
		|
		|СГРУППИРОВАТЬ ПО
		|	_ОперацииСЦеннымиБумагами.ДатаОперации,
		|	ЕСТЬNULL(_ОперацииСЦеннымиБумагами.ЦеннаяБумага, _НачальныеОстатки.ЦеннаяБумага)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОперацииСЦеннымиБумагамиСПериодомНоминала.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ОперацииСЦеннымиБумагамиСПериодомНоминала.ДатаОперации КАК ДатаОперации,
		|	_ОперацииСЦеннымиБумагамиСПериодомНоминала.СуммаПриход КАК СуммаПриход,
		|	_ОперацииСЦеннымиБумагамиСПериодомНоминала.КоличествоПриход КАК КоличествоПриход,
		|	_ОперацииСЦеннымиБумагамиСПериодомНоминала.СуммаРасход КАК СуммаРасход,
		|	_ОперацииСЦеннымиБумагамиСПериодомНоминала.КоличествоРасход КАК КоличествоРасход,
		|	_ОперацииСЦеннымиБумагамиСПериодомНоминала.КоличествоНачальное КАК КоличествоНачальное,
		|	_ОперацииСЦеннымиБумагамиСПериодомНоминала.ПериодНоминала КАК ПериодНоминала,
		|	НоминалыЦенныхБумаг.Номинал КАК НоминалОперации
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ОперацииСЦеннымиБумагамиИНачальныеОстатки.КоличествоНачальное КАК КоличествоНачальное,
		|		МАКСИМУМ(НоминалыЦенныхБумаг.Период) КАК ПериодНоминала,
		|		_ОперацииСЦеннымиБумагамиИНачальныеОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|		_ОперацииСЦеннымиБумагамиИНачальныеОстатки.ДатаОперации КАК ДатаОперации,
		|		_ОперацииСЦеннымиБумагамиИНачальныеОстатки.СуммаПриход КАК СуммаПриход,
		|		_ОперацииСЦеннымиБумагамиИНачальныеОстатки.КоличествоПриход КАК КоличествоПриход,
		|		_ОперацииСЦеннымиБумагамиИНачальныеОстатки.СуммаРасход КАК СуммаРасход,
		|		_ОперацииСЦеннымиБумагамиИНачальныеОстатки.КоличествоРасход КАК КоличествоРасход
		|	ИЗ
		|		_ОперацииСЦеннымиБумагамиИНачальныеОстатки КАК _ОперацииСЦеннымиБумагамиИНачальныеОстатки
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|			ПО _ОперацииСЦеннымиБумагамиИНачальныеОстатки.ЦеннаяБумага = НоминалыЦенныхБумаг.ЦеннаяБумага
		|				И _ОперацииСЦеннымиБумагамиИНачальныеОстатки.ДатаОперации >= НоминалыЦенныхБумаг.Период
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ОперацииСЦеннымиБумагамиИНачальныеОстатки.КоличествоНачальное,
		|		_ОперацииСЦеннымиБумагамиИНачальныеОстатки.ДатаОперации,
		|		_ОперацииСЦеннымиБумагамиИНачальныеОстатки.ЦеннаяБумага,
		|		_ОперацииСЦеннымиБумагамиИНачальныеОстатки.СуммаПриход,
		|		_ОперацииСЦеннымиБумагамиИНачальныеОстатки.КоличествоПриход,
		|		_ОперацииСЦеннымиБумагамиИНачальныеОстатки.СуммаРасход,
		|		_ОперацииСЦеннымиБумагамиИНачальныеОстатки.КоличествоРасход) КАК _ОперацииСЦеннымиБумагамиСПериодомНоминала
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|		ПО (_ОперацииСЦеннымиБумагамиСПериодомНоминала.ЦеннаяБумага = НоминалыЦенныхБумаг.ЦеннаяБумага)
		|			И (_ОперацииСЦеннымиБумагамиСПериодомНоминала.ПериодНоминала = НоминалыЦенныхБумаг.Период)
		|
		|УПОРЯДОЧИТЬ ПО
		|	_ОперацииСЦеннымиБумагамиСПериодомНоминала.ДатаОперации
		|ИТОГИ
		|	МАКСИМУМ(КоличествоНачальное)
		|ПО
		|	ЦеннаяБумага";
	
	Для каждого ЭлементСоответствия Из СоответствиеПериодов Цикл
		
		// Выполняем расчет
		ДатаКотировки = ЭлементСоответствия.Ключ;
		МассивЦенныхБумаг = ЭлементСоответствия.Значение;
		
		
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("Период", 		Новый Граница(КонецДня(ДатаКотировки), ВидГраницы.Включая));	
		Запрос.УстановитьПараметр("НачалоПериода", 	КонецДня(ДатаКотировки) + 1);
		Запрос.УстановитьПараметр("КонецПериода", 	КонецДня(Период));
		Запрос.УстановитьПараметр("Организация", 	Организация);
		Запрос.УстановитьПараметр("ЦенныеБумаги", 	МассивЦенныхБумаг);

		Результат = Запрос.Выполнить();
		
		ВыборкаЦенныеБумаги = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаЦенныеБумаги.Следующий() Цикл
			
			НайденныеСтроки = ТаблицаКотировок.НайтиСтроки(Новый Структура("ЦеннаяБумага", ВыборкаЦенныеБумаги.ЦеннаяБумага));
			
			РасчетнаяРыночнаяЦена = НайденныеСтроки[0].РыночнаяЦена;
			НоминалНаДатуРасчета =  НайденныеСтроки[0].Номинал;
			
			КоличествоНачальное = ВыборкаЦенныеБумаги.КоличествоНачальное;
			ВыборкаОперацииСЦеннымиБумагами = ВыборкаЦенныеБумаги.Выбрать();
			
			Пока ВыборкаОперацииСЦеннымиБумагами.Следующий() Цикл
				
				КоэффициентИзмененияНоминала = 1;
				
				Если ТипЗнч(ВыборкаЦенныеБумаги.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда				
					НоминалНаДатуОперации 			= ВыборкаОперацииСЦеннымиБумагами.НоминалОперации;
					Если НоминалНаДатуОперации <> 0 Тогда						
						КоэффициентИзмененияНоминала 	= НоминалНаДатуРасчета/НоминалНаДатуОперации;
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На дату операции " + ВыборкаОперацииСЦеннымиБумагами.ДатаОперации + " у ценной бумаги " + ВыборкаОперацииСЦеннымиБумагами.ЦеннаяБумага + " обнаружен нулевой номинал. Расчетная цена не может быть определена.");
					КонецЕсли; 
				КонецЕсли; 

			
				Если КоличествоНачальное + ВыборкаОперацииСЦеннымиБумагами.КоличествоПриход + ВыборкаОперацииСЦеннымиБумагами.КоличествоРасход <> 0 Тогда
				
					РасчетнаяРыночнаяЦена = (РасчетнаяРыночнаяЦена * КоличествоНачальное + ВыборкаОперацииСЦеннымиБумагами.СуммаПриход*КоэффициентИзмененияНоминала + ВыборкаОперацииСЦеннымиБумагами.СуммаРасход*КоэффициентИзмененияНоминала) 
											/ (КоличествоНачальное + ВыборкаОперацииСЦеннымиБумагами.КоличествоПриход + ВыборкаОперацииСЦеннымиБумагами.КоличествоРасход);
				
				КонецЕсли;
										
				КоличествоНачальное = КоличествоНачальное + ВыборкаОперацииСЦеннымиБумагами.КоличествоПриход - ВыборкаОперацииСЦеннымиБумагами.КоличествоРасход;
				
			КонецЦикла;
			
			Для каждого СтрокаКотировок Из НайденныеСтроки Цикл
			
				СтрокаКотировок.ОценочнаяЦена 	= РасчетнаяРыночнаяЦена;
				
				// Перестало работать получение расчетных цен в 2017 г. (например, для отчета о состоянии портфеля).
				// Пока переносим расчетную цену в рыночную
				СтрокаКотировок.РыночнаяЦена 	= РасчетнаяРыночнаяЦена;
				СтрокаКотировок.ИсточникЦены 	= Справочники.ЮрФизЛица.ПустаяСсылка();
				
				Если СтрокаКотировок.Номинал <> 0 Тогда
					СтрокаКотировок.ОценочнаяЦенаПроцент = СтрокаКотировок.ОценочнаяЦена / СтрокаКотировок.Номинал * 100;
				Иначе
					СтрокаКотировок.ОценочнаяЦенаПроцент = СтрокаКотировок.ОценочнаяЦена;
				КонецЕсли;
				
				СтрокаКотировок.ОценочнаяСумма 	= СтрокаКотировок.ОценочнаяЦена * СтрокаКотировок.Количество;
				СтрокаКотировок.ПолеЦены 		= Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦенаДляПН;	
			
			КонецЦикла; 
					
		КонецЦикла; 
		
	КонецЦикла;

	РассчитатьСтоимостьДефолтныхОблигаций(ТаблицаКотировок, ПараметрыРасчета);
		
КонецПроцедуры

Процедура РассчитатьОценочнуюСтоимостьПоПриказу07_67ФСФР(ПараметрыРасчета, ТаблицаЦенныхБумаг) Экспорт

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =  
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал
		|ПОМЕСТИТЬ _НоминалыЦенныхБумагНаДатуПредыдущейОценки
		|ИЗ
		|	РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПредыдущейОценки, ЦеннаяБумага В (&ЦенныеБумаги)) КАК НоминалыЦенныхБумагСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОперацииСЦеннымиБумагами.Операция КАК Сделка,
		|	НАЧАЛОПЕРИОДА(ОперацииСЦеннымиБумагами.ДатаОперации, ДЕНЬ) КАК ДатаОперации,
		|	ОперацииСЦеннымиБумагами.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА ОперацииСЦеннымиБумагами.Количество
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоПриход,
		|	ВЫБОР
		|		КОГДА ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|			ТОГДА ОперацииСЦеннымиБумагами.Количество
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоРасход
		|ПОМЕСТИТЬ _СделкиЗаПериод
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|ГДЕ
		|	ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОперацииСЦеннымиБумагами.ЦеннаяБумага В(&ЦенныеБумаги)
		|	И ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Операция) = ТИП(Документ.Сделка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СделкиЗаПериодСПериодомНоминала.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_СделкиЗаПериодСПериодомНоминала.ДатаОперации КАК ДатаОперации,
		|	_СделкиЗаПериодСПериодомНоминала.ПериодНоминала КАК ПериодНоминала,
		|	НоминалыЦенныхБумаг.Номинал КАК НоминалОперации,
		|	_СделкиЗаПериодСПериодомНоминала.КоличествоПриход КАК КоличествоПриход,
		|	_СделкиЗаПериодСПериодомНоминала.КоличествоРасход КАК КоличествоРасход,
		|	УсловияСделокСрезПоследних.Цена КАК Цена,
		|	УсловияСделокСрезПоследних.КурсОплаты КАК Курс,
		|	УсловияСделокСрезПоследних.ВалютаОплаты КАК Валюта
		|ПОМЕСТИТЬ _ДанныеСделок
		|ИЗ
		|	(ВЫБРАТЬ
		|		_СделкиЗаПериод.ДатаОперации КАК ДатаОперации,
		|		_СделкиЗаПериод.ЦеннаяБумага КАК ЦеннаяБумага,
		|		МАКСИМУМ(НоминалыЦенныхБумаг.Период) КАК ПериодНоминала,
		|		_СделкиЗаПериод.КоличествоПриход КАК КоличествоПриход,
		|		_СделкиЗаПериод.КоличествоРасход КАК КоличествоРасход,
		|		_СделкиЗаПериод.Сделка КАК Сделка
		|	ИЗ
		|		_СделкиЗаПериод КАК _СделкиЗаПериод
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|			ПО _СделкиЗаПериод.ЦеннаяБумага = НоминалыЦенныхБумаг.ЦеннаяБумага
		|				И _СделкиЗаПериод.ДатаОперации >= НоминалыЦенныхБумаг.Период
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_СделкиЗаПериод.ДатаОперации,
		|		_СделкиЗаПериод.ЦеннаяБумага,
		|		_СделкиЗаПериод.КоличествоПриход,
		|		_СделкиЗаПериод.КоличествоРасход,
		|		_СделкиЗаПериод.Сделка) КАК _СделкиЗаПериодСПериодомНоминала
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|		ПО _СделкиЗаПериодСПериодомНоминала.ЦеннаяБумага = НоминалыЦенныхБумаг.ЦеннаяБумага
		|			И _СделкиЗаПериодСПериодомНоминала.ПериодНоминала = НоминалыЦенныхБумаг.Период
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделок.СрезПоследних(
		|				&КонецПериода,
		|				Организация = &Организация
		|					И Сделка В
		|						(ВЫБРАТЬ
		|							_СделкиЗаПериод.Сделка КАК Сделка
		|						ИЗ
		|							_СделкиЗаПериод КАК _СделкиЗаПериод)) КАК УсловияСделокСрезПоследних
		|		ПО _СделкиЗаПериодСПериодомНоминала.Сделка = УсловияСделокСрезПоследних.Сделка
		|			И _СделкиЗаПериодСПериодомНоминала.ЦеннаяБумага = УсловияСделокСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеСделок.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ДанныеСделок.ДатаОперации КАК ДатаОперации,
		|	_ДанныеСделок.ПериодНоминала КАК ПериодНоминала,
		|	_ДанныеСделок.НоминалОперации КАК НоминалОперации,
		|	_ДанныеСделок.КоличествоПриход КАК КоличествоПриход,
		|	_ДанныеСделок.КоличествоРасход КАК КоличествоРасход,
		|	ВЫБОР
		|		КОГДА КурсыВалют.Курс ЕСТЬ NULL
		|			ТОГДА ВЫБОР
		|					КОГДА _ДанныеСделок.Курс <> НЕОПРЕДЕЛЕНО
		|						ТОГДА _ДанныеСделок.Цена * (ВЫРАЗИТЬ(_ДанныеСделок.Курс КАК ЧИСЛО))
		|					ИНАЧЕ _ДанныеСделок.Цена
		|				КОНЕЦ
		|		ИНАЧЕ _ДанныеСделок.Цена * КурсыВалют.Курс / КурсыВалют.Кратность
		|	КОНЕЦ КАК Цена
		|ПОМЕСТИТЬ _ДанныеДляРасчета
		|ИЗ
		|	_ДанныеСделок КАК _ДанныеСделок
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО _ДанныеСделок.Валюта = КурсыВалют.Валюта
		|			И (ВЫБОР
		|				КОГДА _ДанныеСделок.Курс <> НЕОПРЕДЕЛЕНО
		|						И ТИПЗНАЧЕНИЯ(_ДанныеСделок.Курс) = ТИП(ЧИСЛО)
		|					ТОГДА _ДанныеСделок.Курс = КурсыВалют.Период
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ)";
	#КонецОбласти
	
	Запрос.УстановитьПараметр("Организация",					ПараметрыРасчета.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ПараметрыРасчета.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаПредыдущейОценки",			ПараметрыРасчета.ДатаПредыдущейОценки);
	Запрос.УстановитьПараметр("НачалоПериода",					КонецДня(ПараметрыРасчета.ДатаПредыдущейОценки) + 1);
	Запрос.УстановитьПараметр("КонецПериода",					КонецДня(ПараметрыРасчета.ДатаОценки));
	Запрос.УстановитьПараметр("ЦенныеБумаги",					ТаблицаЦенныхБумаг.ВыгрузитьКолонку("ЦеннаяБумага"));
	
	Запрос.Выполнить();
	
	НоминалыНаДатуПредыдущейОценки	= Запрос.МенеджерВременныхТаблиц.Таблицы["_НоминалыЦенныхБумагНаДатуПредыдущейОценки"].ПолучитьДанные().Выгрузить();
	ДанныеДляРасчета				= Запрос.МенеджерВременныхТаблиц.Таблицы["_ДанныеДляРасчета"].ПолучитьДанные().Выгрузить();
	
	Для Каждого ТекСтрока Из ТаблицаЦенныхБумаг Цикл
		
		Если ТекСтрока.Стоимость = 0 И ТекСтрока.ТребуетсяРасчет Тогда
			
			Отбор = Новый Структура;
			Отбор.Вставить("ЦеннаяБумага", ТекСтрока.ЦеннаяБумага);
			                                                                                                                              
			ДанныеСделок	= ДанныеДляРасчета.НайтиСтроки(Отбор);
			Номинал			= НоминалыНаДатуПредыдущейОценки.НайтиСтроки(Отбор);
			
			Если ДанныеСделок.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если Номинал.Количество() = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На дату предыдущей оценки (" + Формат(ПараметрыРасчета.ДатаПредудыщейОценки, "ДФ=dd.MM.yyyy") + ") у ценной бумаги " + ТекСтрока.ЦеннаяБумага + " обнаружен нулевой номинал. Расчетная цена не может быть определена.");
				Продолжить;
			Иначе
				НоминалНаДатуПредыдущейОценки = Номинал[0];
			КонецЕсли;
			
			ОбщаяСумма		= 0;
			ОбщееКоличество	= 0;
			
			Расчитывать = Истина;
			
			Для Каждого Сделка Из ДанныеСделок Цикл
				
				КоэффициентИзмененияНоминала = 1;
				
				Если ТипЗнч(ТекСтрока.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда				
					НоминалНаДатуОперации 			= Сделка.НоминалОперации;
					Если НоминалНаДатуОперации <> 0 Тогда						
						КоэффициентИзмененияНоминала = НоминалНаДатуПредыдущейОценки/НоминалНаДатуОперации;
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На дату операции " + Сделка.ДатаОперации + " у ценной бумаги " + Сделка.ЦеннаяБумага + " обнаружен нулевой номинал. Расчетная цена не может быть определена.");
						Расчитывать = Ложь;
						Прервать;
					КонецЕсли; 
				КонецЕсли;
				
				ОбщаяСумма		= ОбщаяСумма + КоэффициентИзмененияНоминала * Сделка.КоличествоПриход * Сделка.Цена + КоэффициентИзмененияНоминала * Сделка.КоличествоРасход * Сделка.Цена;
				ОбщееКоличество	= ОбщееКоличество + Сделка.КоличествоПриход + Сделка.КоличествоРасход;
				
			КонецЦикла;
			
			Если Расчитывать Тогда
				ТекСтрока.Стоимость		= (ТекСтрока.ЦенаДляРасчета * ТекСтрока.КоличествоДляРасчета + ОбщаяСумма) / (ТекСтрока.КоличествоДляРасчета + ОбщееКоличество);
				ТекСтрока.УровеньОценки	= 2;
				ТекСтрока.Источник		= Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

Процедура РассчитатьСтоимостьДефолтныхОблигаций(ТаблицаКотировок, ПараметрыРасчета) Экспорт
	
	Если ТипЗнч(ПараметрыРасчета) = Тип("ДокументОбъект.ПереоценкаЦенныхБумаг") Тогда
		ЦельРасчета = БухгалтерскийУчет.ОпределитьЦельРасчетаПоВидуУчета(ПараметрыРасчета.ВидУчета);
	Иначе
		ПараметрыРасчета.Свойство("ЦельРасчета",  ЦельРасчета);
	КонецЕсли;
	
	// Процедура применяется только для вариантов расчета оценочной стоимости Р2 для ПН и Р2 для ПР
	Если (ПараметрыРасчета.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная2ДляПенсионныхНакоплений
		ИЛИ ПараметрыРасчета.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная2ДляПенсионныхРезервов) Тогда
	
		// Учитываем пункт положений для ПН/ПР:
		// В случае неисполнения предусмотренного облигацией обязательства по выплате суммы основного долга, рыночная стоимость таких облигаций 
		// по истечении 7 дней с даты окончания срока исполнения указанного обязательства определяется по формуле:
	    //
		//  S = max[0, ((0.7 - (i - 7) * 0.03) * P0 * Q)]
		//
	    // где:
		// S  - рыночная стоимость облигаций на дату расчета рыночной стоимости активов, составляющих инвестиционный портфель;
		// P0 - рыночная цена (средняя цена) указанных облигаций на дату истечения предусмотренного ими срока исполнения обязательств по выплате суммы основного долга;
		// Q  - количество указанных облигаций в инвестиционном портфеле;
		// i  - количество полных календарных дней, прошедших с даты окончания срока исполнения обязательств по выплате суммы основного долга, предусмотренной указанными облигациями;
	    //
		// 1. Получаем бумаги в дефолте по погашению тела облигации и просроченные неоплаченные погашения тела
		// 2. Получаем рыночные цены для этих бумаг на соответсвующие даты
		// 3. Применяем формулу.
		//
		// Коэффициент (0.7 - (i - 7) * 0.03) становится отрицательным при i >= 31, т. е. если срок задолженности 
		// по погашению тела более 30 дней, рыночная стоимость облигаций по этой формуле равна нулю.
		// Дата отсчета задолженности: если в документе "Погашение ЦБ" заполнена плановая дата оплаты, используем ее, иначе - дату погашения ценной бумаги.

		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.Партия КАК Партия,
		|	_ТаблицаЦБ.Количество КАК Количество,
		|	_ТаблицаЦБ.СтрокаПартии КАК СтрокаПартии,
		|	_ТаблицаЦБ.РыночнаяСумма КАК РыночнаяСумма
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	&ТаблицаЦБ КАК _ТаблицаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Облигации.Ссылка КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.Партия КАК Партия,
		|	_ТаблицаЦБ.СтрокаПартии КАК СтрокаПартии,
		|	_ТаблицаЦБ.Количество КАК Количество,
		|	_ТаблицаЦБ.РыночнаяСумма КАК РыночнаяСумма
		|ПОМЕСТИТЬ _ТаблицаОблигаций
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДефолтыПоОблигациямСрезПоследних.Облигация КАК Облигация,
		|	ДефолтыПоОблигациямСрезПоследних.СтатусДефолта КАК СтатусДефолта,
		|	ДефолтыПоОблигациямСрезПоследних.Период КАК Период,
		|	РАЗНОСТЬДАТ(ДефолтыПоОблигациямСрезПоследних.Облигация.ДатаПогашения, &Период, ДЕНЬ) КАК ДнейЗадолженности
		|ПОМЕСТИТЬ _ДефолтыПоОблигациям
		|ИЗ
		|	РегистрСведений.ДефолтыПоОблигациям.СрезПоследних(
		|			&Период,
		|			Облигация В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_ТаблицаОблигаций.ЦеннаяБумага
		|					ИЗ
		|						_ТаблицаОблигаций КАК _ТаблицаОблигаций)
		|				И ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации)) КАК ДефолтыПоОблигациямСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОстатки.Основание) = ТИП(Документ.ПогашениеЦеннойБумаги)
		|			ТОГДА ВЫБОР
		|					КОГДА ЗадолженностиПоДенежнымСредствамОстатки.Основание.ДатаОплатыПлановая = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|						ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.Основание.ЦеннаяБумага.ДатаПогашения
		|					ИНАЧЕ ЗадолженностиПоДенежнымСредствамОстатки.Основание.ДатаОплатыПлановая
		|				КОНЕЦ
		|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|	КОНЕЦ КАК ДатаЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Организация КАК Организация,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК СуммаОстаток,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК СуммаКупонаОстаток
		|ПОМЕСТИТЬ _ЗадолженностьПоПогашениюЦБ
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюОблигации), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации))
		|				И ТИПЗНАЧЕНИЯ(Основание) = ТИП(Документ.ПогашениеЦеннойБумаги)) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание.ЦеннаяБумага В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				_ТаблицаОблигаций.ЦеннаяБумага
		|			ИЗ
		|				_ТаблицаОблигаций КАК _ТаблицаОблигаций)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	МАКСИМУМ(СтоимостьПереоценки.Период) КАК ДатаЦены,
		|	СтоимостьПереоценки.Цена КАК Цена,
		|	_ЗадолженностьПоПогашениюЦБ.ДатаЗадолженности КАК ДатаЗадолженности
		|ПОМЕСТИТЬ _ТаблицаСтоимости_Рынок
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗадолженностьПоПогашениюЦБ КАК _ЗадолженностьПоПогашениюЦБ
		|		ПО СтоимостьПереоценки.ЦеннаяБумага = _ЗадолженностьПоПогашениюЦБ.ЦеннаяБумага
		|ГДЕ
		|	СтоимостьПереоценки.ЦеннаяБумага В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				_ЗадолженностьПоПогашениюЦБ.ЦеннаяБумага
		|			ИЗ
		|				_ЗадолженностьПоПогашениюЦБ КАК _ЗадолженностьПоПогашениюЦБ)
		|	И СтоимостьПереоценки.Организация = &Организация
		|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьПереоценки.ВидУчета = &ВидУчета
		|	И СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета
		|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
		|	И ВЫБОР
		|			КОГДА &ЭтоР2ДляПН
		|				ТОГДА СтоимостьПереоценки.Период = ЕСТЬNULL(_ЗадолженностьПоПогашениюЦБ.ДатаЗадолженности, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		|			КОГДА &ЭтоР2ДляПР
		|				ТОГДА СтоимостьПереоценки.Период < ЕСТЬNULL(_ЗадолженностьПоПогашениюЦБ.ДатаЗадолженности, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	СтоимостьПереоценки.ЦеннаяБумага,
		|	СтоимостьПереоценки.Цена,
		|	_ЗадолженностьПоПогашениюЦБ.ДатаЗадолженности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_ТаблицаСтоимости_Рынок.ЦеннаяБумага, _ДефолтыПоОблигациям.Облигация) КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА _ДефолтыПоОблигациям.ДнейЗадолженности > &МаксимальноеКоличествоДнейДляРасчета
		|				ИЛИ РАЗНОСТЬДАТ(_ТаблицаСтоимости_Рынок.ДатаЗадолженности, &Период, ДЕНЬ) > &МаксимальноеКоличествоДнейДляРасчета
		|			ТОГДА 0
		|		КОГДА РАЗНОСТЬДАТ(_ТаблицаСтоимости_Рынок.ДатаЗадолженности, &Период, ДЕНЬ) <= &МинимальноеКоличествоДнейДляРасчета
		|			ТОГДА -1
		|		ИНАЧЕ (0.7 - (РАЗНОСТЬДАТ(_ТаблицаСтоимости_Рынок.ДатаЗадолженности, &Период, ДЕНЬ) - 7) * 0.03) * _ТаблицаСтоимости_Рынок.Цена
		|	КОНЕЦ КАК РыночнаяСтоимость,
		|	ВЫБОР
		|		КОГДА _ДефолтыПоОблигациям.ДнейЗадолженности > &МаксимальноеКоличествоДнейДляРасчета
		|				ИЛИ РАЗНОСТЬДАТ(_ТаблицаСтоимости_Рынок.ДатаЗадолженности, &Период, ДЕНЬ) > &МаксимальноеКоличествоДнейДляРасчета
		|			ТОГДА ""Стоимость0""
		|		КОГДА РАЗНОСТЬДАТ(_ТаблицаСтоимости_Рынок.ДатаЗадолженности, &Период, ДЕНЬ) <= &МинимальноеКоличествоДнейДляРасчета
		|			ТОГДА ""ТекущаяСтоимость""
		|		ИНАЧЕ ""ПоФормуле""
		|	КОНЕЦ КАК ПрименениеФормулы
		|ИЗ
		|	_ТаблицаСтоимости_Рынок КАК _ТаблицаСтоимости_Рынок
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ДефолтыПоОблигациям КАК _ДефолтыПоОблигациям
		|		ПО _ТаблицаСтоимости_Рынок.ЦеннаяБумага = _ДефолтыПоОблигациям.Облигация";
		
		Запрос.УстановитьПараметр("МаксимальноеКоличествоДнейДляРасчета", 30);
		Запрос.УстановитьПараметр("МинимальноеКоличествоДнейДляРасчета",  7);
		Запрос.УстановитьПараметр("ТаблицаЦБ", 							  ТаблицаКотировок);
		Запрос.УстановитьПараметр("Организация", 						  ПараметрыРасчета.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", 		  ПараметрыРасчета.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ЭтоР2ДляПН", 						  ПараметрыРасчета.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная2ДляПенсионныхНакоплений);
		Запрос.УстановитьПараметр("ЭтоР2ДляПР", 						  ПараметрыРасчета.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная2ДляПенсионныхРезервов);     
		Запрос.УстановитьПараметр("ВидУчета", 						  	  ПараметрыРасчета.ВидУчета);
		Запрос.УстановитьПараметр("ЦельРасчета", 						  ЦельРасчета);
		Запрос.УстановитьПараметр("Период",  							  НачалоДня(ПараметрыРасчета.Дата));
		
		СтоимостьДефолтныхЦБ = Запрос.Выполнить().Выгрузить();
		Для Каждого ТекСтрокаДефолтнойЦБ Из СтоимостьДефолтныхЦБ Цикл
			
			Если ТекСтрокаДефолтнойЦБ.ПрименениеФормулы = "ТекущаяСтоимость" Тогда
				Продолжить;
			КонецЕсли;
			
			ТекОтбор = Новый Структура("ЦеннаяБумага", ТекСтрокаДефолтнойЦБ.ЦеннаяБумага);
			НайдСтроки = ТаблицаКотировок.НайтиСтроки(ТекОтбор);
			
			Для Каждого НайдСтрока Из НайдСтроки Цикл
				Если ТекСтрокаДефолтнойЦБ.ПрименениеФормулы = "Стоимость0" Тогда
					НайдСтрока.РыночнаяСумма = 0;	
					НайдСтрока.ОценочнаяСумма = 0;	
				Иначе
					НайдСтрока.РыночнаяСумма = НайдСтрока.Количество * ТекСтрокаДефолтнойЦБ.РыночнаяСтоимость;
					НайдСтрока.ОценочнаяСумма = НайдСтрока.Количество * ТекСтрокаДефолтнойЦБ.РыночнаяСтоимость;
				КонецЕсли;	
			КонецЦикла;
			
		КонецЦикла;
	
	КонецЕсли;
	
КонецПроцедуры // РассчитатьСтоимостьДефолтныхОблигаций	
	
Функция ПолучитьРыночнуюЦену(ЦеннаяБумага, Период, Организация, СчетДоверительногоУправления, ДатаКотировки, РыночнаяЦена) Экспорт

	КоличествоНачальное = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиЦенныхБумагОстатки.КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК ОстаткиЦенныхБумагОстатки";

	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(ДатаКотировки), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);

	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		КоличествоНачальное = ВыборкаДетальныеЗаписи.КоличествоОстаток;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(ОперацииСЦеннымиБумагами.ДатаОперации, ДЕНЬ) КАК ДатаОперации,
		|	ВЫБОР
		|		КОГДА ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА ОперацииСЦеннымиБумагами.Сумма
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаПриход,
		|	ВЫБОР
		|		КОГДА ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА ОперацииСЦеннымиБумагами.Количество
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоПриход,
		|	ВЫБОР
		|		КОГДА ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|			ТОГДА ОперацииСЦеннымиБумагами.Сумма
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаРасход,
		|	ВЫБОР
		|		КОГДА ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|			ТОГДА ОперацииСЦеннымиБумагами.Количество
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоРасход
		|ПОМЕСТИТЬ ОперацииСЦеннымиБумагами
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|ГДЕ
		|	ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОперацииСЦеннымиБумагами.ЦеннаяБумага = &ЦеннаяБумага
		|	И (ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Операция) = ТИП(Документ.ВводЦенныхБумаг)
		|			ИЛИ ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Операция) = ТИП(Документ.ВыводЦенныхБумаг)
		|			ИЛИ ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Операция) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
		|			ИЛИ ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Операция) = ТИП(Документ.ПоставкаЦенныхБумаг)
		|			ИЛИ ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Операция) = ТИП(Документ.Сделка)
		|				И НЕ ВЫРАЗИТЬ(ОперацииСЦеннымиБумагами.Операция КАК Документ.Сделка).ОтложенноеИсполнение)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОперацииСЦеннымиБумагами.ДатаОперации,
		|	СУММА(ОперацииСЦеннымиБумагами.СуммаПриход) КАК СуммаПриход,
		|	СУММА(ОперацииСЦеннымиБумагами.КоличествоПриход) КАК КоличествоПриход,
		|	СУММА(ОперацииСЦеннымиБумагами.СуммаРасход) КАК СуммаРасход,
		|	СУММА(ОперацииСЦеннымиБумагами.КоличествоРасход) КАК КоличествоРасход
		|ИЗ
		|	ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|
		|СГРУППИРОВАТЬ ПО
		|	ОперацииСЦеннымиБумагами.ДатаОперации
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОперацииСЦеннымиБумагами.ДатаОперации";

	Запрос.УстановитьПараметр("НачалоПериода", КонецДня(ДатаКотировки) + 1);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Период));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);

	ОперацииСЦеннымиБумагами = Запрос.Выполнить().Выгрузить();
	
	РасчетнаяРыночнаяЦена = РыночнаяЦена;
	
	Для каждого СтрокаОпераций Из ОперацииСЦеннымиБумагами Цикл
		
		Если КоличествоНачальное + СтрокаОпераций.КоличествоПриход + СтрокаОпераций.КоличествоРасход <> 0 Тогда
		
			РасчетнаяРыночнаяЦена = (РасчетнаяРыночнаяЦена * КоличествоНачальное + СтрокаОпераций.СуммаПриход + СтрокаОпераций.СуммаРасход) 
									/ (КоличествоНачальное + СтрокаОпераций.КоличествоПриход + СтрокаОпераций.КоличествоРасход);
		
		КонецЕсли;
								
		КоличествоНачальное = КоличествоНачальное + СтрокаОпераций.КоличествоПриход - СтрокаОпераций.КоличествоРасход;
		
	КонецЦикла;
	
	Возврат РасчетнаяРыночнаяЦена;

КонецФункции

Функция ПолучитьКупонныйДоходЗаПериод(ЦеннаяБумага, ДатаНачала, ДатаОкончания, СчетДоверительногоУправления) Экспорт

	НачальныйКупон = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(ЦеннаяБумага, НачалоДня(ДатаНачала), СчетДоверительногоУправления, Истина);
	КонечныйКупон = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(ЦеннаяБумага, НачалоДня(ДатаОкончания), СчетДоверительногоУправления, Истина);
	
	КупонЗаПериод = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(СУММА(КупонныйДоходПоОблигациям.СуммаКупона), 0) КАК СуммаКупона
		|ИЗ
		|	РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|ГДЕ
		|	КупонныйДоходПоОблигациям.Облигация = &Облигация
		|	И КупонныйДоходПоОблигациям.ДатаОкончанияКупона >= &НачалоПериода
		|	И КупонныйДоходПоОблигациям.ДатаОкончанияКупона < &ОкончаниеПериода";
	
	Запрос.УстановитьПараметр("Облигация", ЦеннаяБумага);
	Запрос.УстановитьПараметр("НачалоПериода", ДатаНачала);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ДатаОкончания);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		КупонЗаПериод = ВыборкаДетальныеЗаписи.СуммаКупона;
	КонецЕсли;

	Возврат КонечныйКупон - НачальныйКупон + КупонЗаПериод;

КонецФункции 

Функция ОпределитьУровниРейтингов(Объект, Дата)

	СписокАгентств = Новый Массив;
	СписокАгентств.Добавить(Справочники.РейтинговыеАгентства.FitchRatings);
	СписокАгентств.Добавить(Справочники.РейтинговыеАгентства.Moodys);
	СписокАгентств.Добавить(Справочники.РейтинговыеАгентства.StandardAndPoors);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РейтингиСрезПоследних.РейтинговоеАгентство,
		|	РейтингиСрезПоследних.УровеньРейтинга
		|ИЗ
		|	РегистрСведений.Рейтинги.СрезПоследних(
		|			&Период,
		|			Субъект = &Объект
		|					И РейтинговоеАгентство В (&СписокАгентств)
		|					И Шкала.Наименование = ""Долгосрочный Межд. рейтинг в нац. вал.""
		|				ИЛИ Шкала.Наименование = ""Долгосрочный Межд. рейтинг в нац. валюте""
		|				ИЛИ Шкала.Наименование = ""Долгосрочный Межд. рейтинг в нац. валюте"") КАК РейтингиСрезПоследних";
	
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("СписокАгентств", СписокАгентств);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	//1 - лучше, чем BBB-, 2 - от BB- до BBB-, 3 - от B- до BB-
	СписокУровней = Новый Массив;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.РейтинговоеАгентство = Справочники.РейтинговыеАгентства.FitchRatings Тогда
			
			Если ВыборкаДетальныеЗаписи.УровеньРейтинга >= 69 Тогда // BBB-
				СписокУровней.Добавить(1);
			ИначеЕсли ВыборкаДетальныеЗаписи.УровеньРейтинга >= 59 Тогда // BB-
				СписокУровней.Добавить(2);
			ИначеЕсли ВыборкаДетальныеЗаписи.УровеньРейтинга >= 49 Тогда // B-
				СписокУровней.Добавить(3);
			КонецЕсли;
			
		ИначеЕсли ВыборкаДетальныеЗаписи.РейтинговоеАгентство = Справочники.РейтинговыеАгентства.Moodys Тогда
			
			Если ВыборкаДетальныеЗаписи.УровеньРейтинга >= 61 Тогда // Baa3-
				СписокУровней.Добавить(1);
			ИначеЕсли ВыборкаДетальныеЗаписи.УровеньРейтинга >= 51 Тогда // Ba3-
				СписокУровней.Добавить(2);
			ИначеЕсли ВыборкаДетальныеЗаписи.УровеньРейтинга >= 41 Тогда // B3-
				СписокУровней.Добавить(3);
			КонецЕсли;
			
		ИначеЕсли ВыборкаДетальныеЗаписи.РейтинговоеАгентство = Справочники.РейтинговыеАгентства.StandardAndPoors Тогда
			
			Если ВыборкаДетальныеЗаписи.УровеньРейтинга >= 89 Тогда // BBB-
				СписокУровней.Добавить(1);
			ИначеЕсли ВыборкаДетальныеЗаписи.УровеньРейтинга >= 79 Тогда // BB-
				СписокУровней.Добавить(2);
			ИначеЕсли ВыборкаДетальныеЗаписи.УровеньРейтинга >= 69 Тогда // B-
				СписокУровней.Добавить(3);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если СписокУровней.Количество() = 0 Тогда
	    Возврат ОпределитьУровниРейтингов(Объект.Эмитент.ЮрФизЛицо, Дата);
	Иначе
	    Возврат СписокУровней;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьИндексыДляОблигации(Облигация, Дата, ДатаПогашения = Неопределено) Экспорт

	Если ТипЗнч(Облигация) <> Тип("СправочникСсылка.Облигации") Тогда
		Возврат Справочники.БиржевыеИндексы.ПустаяСсылка();
	КонецЕсли;
	
	Если ДатаПогашения = Неопределено Тогда
		ЛетДоПогашения = Облигация.ДатаПогашения - Дата; //вполне возможно, что тут надо считать не срок а дюрацию, но точно не известно
	Иначе
		ЛетДоПогашения = ДатаПогашения - Дата; //вполне возможно, что тут надо считать не срок а дюрацию, но точно не известно
	КонецЕсли;
	
	МассивКодовИндексов = Новый Массив;
	
	Если Облигация.Категория = Перечисления.КатегорииОблигаций.Государственная Тогда
		Если ЛетДоПогашения <= 365 * 86400 Тогда
			МассивКодовИндексов.Добавить("RUGBICP1Y");
		ИначеЕсли ЛетДоПогашения <= 3 * 365 * 86400 Тогда
			МассивКодовИндексов.Добавить("RUGBICP3Y");
		ИначеЕсли ЛетДоПогашения <= 5 * 365 * 86400 Тогда
			МассивКодовИндексов.Добавить("RUGBICP5Y");
		Иначе
			МассивКодовИндексов.Добавить("RUGBICP5+");
		КонецЕсли;
	ИначеЕсли Облигация.Категория = Перечисления.КатегорииОблигаций.Муниципальная ИЛИ Облигация.Категория = Перечисления.КатегорииОблигаций.Субфедеральная Тогда
		Если ЛетДоПогашения <= 365 * 86400 Тогда
			МассивКодовИндексов.Добавить("RUMBITR1Y");
		Иначе
			УровниРейтингов = ОпределитьУровниРейтингов(Облигация, Дата); 
			//1 - лучше, чем BBB-, 2 - от BB- до BBB-, 3 - от B- до BB-
			Для каждого УровеньРейтинга Из УровниРейтингов Цикл
				Если УровеньРейтинга = 1 Тогда
					Если ЛетДоПогашения <= 3 * 365 * 86400 Тогда
						МассивКодовИндексов.Добавить("RUMBITRBBB3Y");
					Иначе
					    МассивКодовИндексов.Добавить("RUMBITRBBB3+");
					КонецЕсли;
				ИначеЕсли УровеньРейтинга = 2 И ЛетДоПогашения <= 3 * 365 * 86400 Тогда
					МассивКодовИндексов.Добавить("RUMBITRBB3Y");
				КонецЕсли;
			КонецЦикла;
			
			Если МассивКодовИндексов.Количество() = 0 Тогда // Ничего не добавили
				Если ЛетДоПогашения <= 3 * 365 * 86400 Тогда
					МассивКодовИндексов.Добавить("RUMBITR3Y");
				Иначе
					МассивКодовИндексов.Добавить("RUMBITR3+");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе //остались корпоративные
		
		Если ЛетДоПогашения <= 365 * 86400 Тогда
			МассивКодовИндексов.Добавить("RUCBITR1Y");
		ИначеЕсли ЛетДоПогашения <= 3 * 365 * 86400 Тогда
			
			УровниРейтингов = ОпределитьУровниРейтингов(Облигация, Дата); 
			//1 - лучше, чем BBB-, 2 - от BB- до BBB-, 3 - от B- до BB-
			Для каждого УровеньРейтинга Из УровниРейтингов Цикл
				Если УровеньРейтинга = 1 Тогда
					МассивКодовИндексов.Добавить("RUCBITRBBB3Y");
				ИначеЕсли УровеньРейтинга = 2 Тогда
					МассивКодовИндексов.Добавить("RUCBITRBB3Y");
				ИначеЕсли УровеньРейтинга = 3 Тогда
					МассивКодовИндексов.Добавить("RUCBITRB3Y");
				КонецЕсли;
			КонецЦикла;
			
			Если МассивКодовИндексов.Количество() = 0 Тогда // Ничего не добавили
				МассивКодовИндексов.Добавить("RUCBTR3Y");
			КонецЕсли;
			
		ИначеЕсли ЛетДоПогашения <= 5 * 365 * 86400 Тогда
			
			УровниРейтингов = ОпределитьУровниРейтингов(Облигация, Дата); 
			//1 - лучше, чем BBB-, 2 - от BB- до BBB-, 3 - от B- до BB-
			Для каждого УровеньРейтинга Из УровниРейтингов Цикл
				Если УровеньРейтинга = 1 Тогда
					МассивКодовИндексов.Добавить("RUCBITRBBB5Y");
				ИначеЕсли УровеньРейтинга = 2 Тогда
					МассивКодовИндексов.Добавить("RUCBITRBB5Y");
				КонецЕсли;
			КонецЦикла;
			
			Если МассивКодовИндексов.Количество() = 0 Тогда // Ничего не добавили
				МассивКодовИндексов.Добавить("RUCBTR5Y");
			КонецЕсли;
			
		Иначе
			
			УровниРейтингов = ОпределитьУровниРейтингов(Облигация, Дата); 
			//1 - лучше, чем BBB-, 2 - от BB- до BBB-, 3 - от B- до BB-
			Для каждого УровеньРейтинга Из УровниРейтингов Цикл
				Если УровеньРейтинга = 1 Тогда
					МассивКодовИндексов.Добавить("RUCBITRBBB3+");
				ИначеЕсли УровеньРейтинга = 2 Тогда
					МассивКодовИндексов.Добавить("RUCBITRBB3+");
				КонецЕсли;
			КонецЦикла;
			
			Если МассивКодовИндексов.Количество() = 0 Тогда // Ничего не добавили
				МассивКодовИндексов.Добавить("RUCBITR3+");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БиржевыеИндексы.Ссылка
		|ИЗ
		|	Справочник.БиржевыеИндексы КАК БиржевыеИндексы
		|ГДЕ
		|	БиржевыеИндексы.Код В (&Коды)";
	
	Запрос.УстановитьПараметр("Коды", МассивКодовИндексов);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ПолучитьЗначенияИндексовДляОблигации(Облигация, Дата, ДатаПогашения = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияБиржевыхИндексовСрезПоследних.YIELD КАК Доходность,
		|	ЗначенияБиржевыхИндексовСрезПоследних.БиржевойИндекс.Код КАК КодИндекса
		|ИЗ
		|	РегистрСведений.ЗначенияБиржевыхИндексов.СрезПоследних(
		|			&Период,
		|			Биржа = &Биржа
		|				И БиржевойИндекс В (&БиржевыеИндексы)) КАК ЗначенияБиржевыхИндексовСрезПоследних";
	
	Запрос.УстановитьПараметр("Биржа", ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС").Биржа);
	Запрос.УстановитьПараметр("БиржевыеИндексы", ПолучитьИндексыДляОблигации(Облигация, Дата, ДатаПогашения));
	Запрос.УстановитьПараметр("Период", Дата);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	МассивЗначенийИндексов = Новый Массив;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивЗначенийИндексов.Добавить(Новый Структура("КодИндекса,Доходность", ВыборкаДетальныеЗаписи.КодИндекса, ВыборкаДетальныеЗаписи.Доходность));
	КонецЦикла;
	
	Возврат МассивЗначенийИндексов;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////

Процедура РассчитатьСводныеКотировки(ИмяРегистра, Отбор, Отказ) Экспорт
	Если ЗначениеЗаполнено(Отбор.ЦеннаяБумага.Значение)
		И Не ОбщегоНазначения.ОбъектСуществуетВБазеДанных(Отбор.ЦеннаяБумага.Значение)
	Тогда
		// Идёт непосредственное удаление ведущего объекта и ничего пересчитывать не надо
		Возврат;
	КонецЕсли;
	
	Если Не Отбор.Период.Использование Или Не ЗначениеЗаполнено(Отбор.Период.Значение) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запись котировок без установленного отбора по периоду не поддерживается",,,, Отказ);
		Возврат;
	КонецЕсли;
	
	КотировкиМД = Метаданные.РегистрыСведений[ИмяРегистра];
	
	ОтборБезПериода = Новый Структура;
	
	ИзмеренияСтрокой       = "";
	УсловиеСрезаСводных    = "";
	УсловиеОтбораКотировок = "";
	УсловиеСоединения      = "";
	РасчетныеПоляСводныхКотировок = "&Период КАК Период";
	
	Для Каждого ИзмерениеМД Из КотировкиМД.Измерения Цикл
		Если Отбор[ИзмерениеМД.Имя].Использование Тогда
			ОтборБезПериода.Вставить(ИзмерениеМД.Имя, Отбор[ИзмерениеМД.Имя].Значение);
			
			УсловиеСрезаСводных = УсловиеСрезаСводных + ?(ПустаяСтрока(УсловиеСрезаСводных), "", " И ") + ИзмерениеМД.Имя + " = &" + ИзмерениеМД.Имя;
			УсловиеОтбораКотировок = УсловиеОтбораКотировок + ?(ПустаяСтрока(УсловиеОтбораКотировок), "", " И ")
				+ "Котировки." + ИзмерениеМД.Имя + " = &" + ИзмерениеМД.Имя;
		КонецЕсли;
		
		ИзмеренияСтрокой  = ИзмеренияСтрокой + ?(ПустаяСтрока(ИзмеренияСтрокой), "", ", ") + ИзмерениеМД.Имя;
		РасчетныеПоляСводныхКотировок = РасчетныеПоляСводныхКотировок + "," + Символы.ПС + Символы.Таб + "ЕСТЬNULL(Котировки." + ИзмерениеМД.Имя
			+ ", КотировкиСводныеСрезПоследних." + ИзмерениеМД.Имя + ") КАК " + ИзмерениеМД.Имя;
		УсловиеСоединения = УсловиеСоединения + ?(ПустаяСтрока(УсловиеСоединения), "", Символы.ПС + Символы.Таб + Символы.Таб + Символы.Таб + " И ")
			+ "Котировки." + ИзмерениеМД.Имя + " = КотировкиСводныеСрезПоследних." + ИзмерениеМД.Имя;
	КонецЦикла;
	
	ШаблонРесурса =
		"	ВЫБОР КОГДА ЕСТЬNULL(Котировки.Ресурс, 0) <> 0 ТОГДА Котировки.Ресурс ИНАЧЕ КотировкиСводныеСрезПоследних.Ресурс КОНЕЦ КАК Ресурс,
		|	ВЫБОР КОГДА ЕСТЬNULL(Котировки.Ресурс, 0) <> 0 ТОГДА &Период ИНАЧЕ КотировкиСводныеСрезПоследних.Ресурс_DATE КОНЕЦ КАК Ресурс_DATE";
	
	Ресурсы = Новый Массив;
	
	Для Каждого РесурсМД Из КотировкиМД.Ресурсы Цикл
		Ресурсы.Добавить(РесурсМД.Имя);
		
		РасчетныеПоляСводныхКотировок = РасчетныеПоляСводныхКотировок + "," + Символы.ПС;
		
		Если НРег(РесурсМД.Имя) = "валюта" Тогда
			РасчетныеПоляСводныхКотировок = РасчетныеПоляСводныхКотировок + "	ЕСТЬNULL(Котировки.Валюта, КотировкиСводныеСрезПоследних.Валюта) КАК Валюта";
		ИначеЕсли НРег(РесурсМД.Имя) = "accint" Тогда
			РасчетныеПоляСводныхКотировок = РасчетныеПоляСводныхКотировок +
				"	Котировки.ACCINT КАК ACCINT,
				|	Котировки.Период КАК ACCINT_DATE";
		Иначе
			РасчетныеПоляСводныхКотировок = РасчетныеПоляСводныхКотировок + СтрЗаменить(ШаблонРесурса, "Ресурс", РесурсМД.Имя)
		КонецЕсли;
	КонецЦикла;
	
	ДатаРасчета = Отбор.Период.Значение;
	
	// Сводные котировки рассчитываются на каждую дату из таблицы котировок.
	//	В 99% случаев мы качаем котировки за вчерашний день, поэтому этот день
	//	рассчитаем в запросе, а последующие дни уже в цикле
	
	НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
	
	// Блокировка
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений." + ИмяРегистра + "Сводные");
	ЭлементБлокировкиДанных.УстановитьЗначение("Период", Новый Диапазон(ДатаРасчета, ));
	Для Каждого КлючЗнач Из ОтборБезПериода Цикл
		ЭлементБлокировкиДанных.УстановитьЗначение(КлючЗнач.Ключ, КлючЗнач.Значение);
	КонецЦикла;
	БлокировкаДанных.Заблокировать();
	
	Запрос = Новый Запрос;
	// Запрос нельзя редактировать через конструктор, т.к. он зависит от параметров.
	//	Если потребуется сделать его совместимым к изменениям через конструктор, нужно добавить для
	//		"&РасчетныеПоляСводныхКотировокНаДатуРасчета КАК РасчетныеПоляСводныхКотировокНаДатуРасчета" вместо "*"
	//		у временной таблицы _СводныеКотировкиНаДатуРасчета замену на текст, который аналогичен тому, что лежит под фразой
	//		"&РасчетныеПоляСводныхКотировок КАК РасчетныеПоляСводныхКотировок", но с учётом того, что нужно брать параметры
	//		из таблицы _ПолныеСводныеКотировки, а не Котировки или КотировкиСводныеСрезПоследних.
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&РасчетныеПоляСводныхКотировок КАК РасчетныеПоляСводныхКотировок,
		|	НЕ Котировки.Период ЕСТЬ NULL КАК КотировкаНаДатуРасчета
		|ПОМЕСТИТЬ _ПолныеСводныеКотировки
		|ИЗ
		|	(ВЫБРАТЬ
		|		*
		|	ИЗ
		|		РегистрСведений.КотировкиТорговыхПлощадок КАК Котировки
		|	ГДЕ
		|		Котировки.Период = &Период
		|		И &УсловиеОтбораКотировок
		|	) КАК Котировки
		|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|			ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, -1),
		|			&УсловиеСрезаСводных
		|		) КАК КотировкиСводныеСрезПоследних
		|		ПО (&УсловиеСоединения)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	*
		|ПОМЕСТИТЬ _СводныеКотировкиНаДатуРасчета
		|ИЗ
		|	_ПолныеСводныеКотировки КАК _ПолныеСводныеКотировки
		|ГДЕ
		|	_ПолныеСводныеКотировки.КотировкаНаДатуРасчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Котировки.Период КАК Период
		|ПОМЕСТИТЬ _ПериодыСводныхКотировокПозжеДатыРасчета
		|ИЗ
		|	РегистрСведений.КотировкиТорговыхПлощадокСводные КАК Котировки
		|ГДЕ
		|	Котировки.Период > &Период
		|	И &УсловиеОтбораКотировок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	*
		|ИЗ
		|	РегистрСведений.КотировкиТорговыхПлощадок КАК Котировки
		|ГДЕ
		|	Котировки.Период > &Период
		|	И &УсловиеОтбораКотировок
		|ИТОГИ ПО
		|	Период";
	#КонецОбласти
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "КотировкиТорговыхПлощадок", ИмяРегистра);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбораКотировок", УсловиеОтбораКотировок);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСрезаСводных", УсловиеСрезаСводных);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСоединения", УсловиеСоединения);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&РасчетныеПоляСводныхКотировок КАК РасчетныеПоляСводныхКотировок", РасчетныеПоляСводныхКотировок);
	
	Запрос.УстановитьПараметр("Период", ДатаРасчета);
	Для Каждого КлючЗнач Из ОтборБезПериода Цикл
		Запрос.УстановитьПараметр(КлючЗнач.Ключ, КлючЗнач.Значение);
	КонецЦикла;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	РезультатЗапрос = Запрос.Выполнить();
	
	// Запись сводных котировок на дату расчёта
	НаборСводныхКотировок = РегистрыСведений[ИмяРегистра + "Сводные"].СоздатьНаборЗаписей();
	
	Для Каждого КлючЗнач Из ОтборБезПериода Цикл
		НаборСводныхКотировок.Отбор[КлючЗнач.Ключ].Установить(КлючЗнач.Значение);
	КонецЦикла;
	
	НаборСводныхКотировок.Отбор.Период.Установить(ДатаРасчета);
	
	НаборСводныхКотировок.Загрузить(Запрос.МенеджерВременныхТаблиц.Таблицы["_СводныеКотировкиНаДатуРасчета"].ПолучитьДанные().Выгрузить());
	НаборСводныхКотировок.Записать();
	
	// Удаление сводных котировок за даты позже даты расчёта
	_ПериодыСводныхКотировокПозжеДатыРасчета =
		Запрос.МенеджерВременныхТаблиц.Таблицы["_ПериодыСводныхКотировокПозжеДатыРасчета"].ПолучитьДанные().Выгрузить().ВыгрузитьКолонку("Период");
	
	Для Каждого Период Из _ПериодыСводныхКотировокПозжеДатыРасчета Цикл
		НаборСводныхКотировок.Отбор.Период.Установить(Период);
		НаборСводныхКотировок.Очистить();
		НаборСводныхКотировок.Записать();
	КонецЦикла;
	
	// Дорасчёт сводных котировок, введённых позже
	СводныеКотировки = Запрос.МенеджерВременныхТаблиц.Таблицы["_ПолныеСводныеКотировки"].ПолучитьДанные().Выгрузить();
	
	ВыборкаПериод = РезультатЗапрос.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПериод.Следующий() Цикл
		НаборСводныхКотировок.Отбор.Период.Установить(ВыборкаПериод.Период);
		НаборСводныхКотировок.Очистить();
		
		Выборка = ВыборкаПериод.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ЗаписьСводныхКотировок = НаборСводныхКотировок.Добавить();
			ЗаполнитьЗначенияСвойств(ЗаписьСводныхКотировок, Выборка, "Период, " + ИзмеренияСтрокой);
			
			ОтборЗаписи = Новый Структура(ИзмеренияСтрокой);
			ЗаполнитьЗначенияСвойств(ОтборЗаписи, Выборка, ИзмеренияСтрокой);
			
			СтрокиСводныеКотировки = СводныеКотировки.НайтиСтроки(ОтборЗаписи);
			
			Если СтрокиСводныеКотировки.Количество() = 0 Тогда
				СтрокаСводныеКотировки = СводныеКотировки.Добавить();
			ИначеЕсли СтрокиСводныеКотировки.Количество() = 1 Тогда
				СтрокаСводныеКотировки = СтрокиСводныеКотировки[0];
			Иначе
				ВызватьИсключение "Ошибка расчета сводных котировок: неоднозначные сводные котировки";
			КонецЕсли;
			
			Для Каждого Ресурс Из Ресурсы Цикл
				Если Ресурс = "Валюта" Тогда
					ЗаписьСводныхКотировок.Валюта = Выборка.Валюта;
				Иначе
					Если Выборка[Ресурс] <> 0 Или Ресурс = "ACCINT" Тогда // Купон может быть 0
						ЗаписьСводныхКотировок[Ресурс] = Выборка[Ресурс];
						ЗаписьСводныхКотировок[Ресурс + "_DATE"] = Выборка.Период;
					Иначе
						ЗаписьСводныхКотировок[Ресурс] = СтрокаСводныеКотировки[Ресурс];
						ЗаписьСводныхКотировок[Ресурс + "_DATE"] = СтрокаСводныеКотировки[Ресурс + "_DATE"];
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			ЗаполнитьЗначенияСвойств(СтрокаСводныеКотировки, ЗаписьСводныхКотировок,, "Период");
		КонецЦикла;
		НаборСводныхКотировок.Записать();
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
КонецПроцедуры // РассчитатьСводныеКотировки

////////////////////////////////////////////////////////////////////////////////

Функция ПолучитьЗапросПортфеляЦенныхБумаг(Организация, Период, ФильтрЦенныхБумаг, РасшифровкаПоОснованию = Ложь, РасшифровкаПоКонтрагенту = Ложь, РасшифровкаПоЦеннойБумаге = Ложь, ПоместитьВоВременнуюТаблицу = Ложь, ИмяВременнойТаблицы = "_ПортфельЦенныхБумаг", МенеджерВременныхТаблиц = Неопределено) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоЦеннымБумагамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоЦеннымБумагамОстатки.Основание КАК Основание,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ПОМЕСТИТЬ _ЗадолженностиПоЦеннымБумагамОстатки
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(&Период, &ФильтрЦенныхБумаг) КАК ЗадолженностиПоЦеннымБумагамОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА &РасшифровкаПоОснованию
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК Основание,
		|	ВЫБОР
		|		КОГДА &РасшифровкаПоКонтрагенту
		|			ТОГДА ВЫБОР
		|					КОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|						ТОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.Брокер.ЮрФизЛицо
		|					ИНАЧЕ _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.Контрагент
		|				КОНЕЦ
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК Контрагент,
		|	ВЫБОР
		|		КОГДА &РасшифровкаПоЦеннойБумаге
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ЦеннаяБумага
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК ЦеннаяБумага,
		|	0 КАК КоличествоОстаток,
		|	ВЫБОР
		|		КОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.КоличествоОстаток - ЕСТЬNULL(_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.КоличествоОстаток, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПроданоВРЕПО,
		|	ВЫБОР
		|		КОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.КоличествоОстаток - ЕСТЬNULL(_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.КоличествоОстаток, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КупленоПоРЕПО,
		|	0 КАК ПроданоТПлюс,
		|	0 КАК КупленоТПлюс
		|ПОМЕСТИТЬ _ЗадолженностиИОстаткиЦБ
		|ИЗ
		|	_ЗадолженностиПоЦеннымБумагамОстатки КАК _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗадолженностиПоЦеннымБумагамОстатки КАК _ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО
		|		ПО _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.СчетДоверительногоУправления = _ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.СчетДоверительногоУправления
		|			И _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание = _ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.Основание
		|			И (_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.ЦеннаяБумага = _ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.ЦеннаяБумага)
		|			И (_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО))
		|ГДЕ
		|	_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗадолженностиПоВторойЧастиРЕПООстатки.СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА &РасшифровкаПоОснованию
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА &РасшифровкаПоКонтрагенту
		|			ТОГДА ВЫБОР
		|					КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|						ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Брокер.ЮрФизЛицо
		|					ИНАЧЕ ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Контрагент
		|				КОНЕЦ
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА &РасшифровкаПоЦеннойБумаге
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.ЦеннаяБумага
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ,
		|	0,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	0,
		|	0
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.Остатки(&Период, &ФильтрЦенныхБумаг) КАК ЗадолженностиПоВторойЧастиРЕПООстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЗадолженностиПоЦеннымБумагамТПлюс.СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА &РасшифровкаПоОснованию
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамТПлюс.Основание
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА &РасшифровкаПоКонтрагенту
		|			ТОГДА ВЫБОР
		|					КОГДА _ЗадолженностиПоЦеннымБумагамТПлюс.Основание.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|						ТОГДА _ЗадолженностиПоЦеннымБумагамТПлюс.Основание.Брокер.ЮрФизЛицо
		|					ИНАЧЕ _ЗадолженностиПоЦеннымБумагамТПлюс.Основание.Контрагент
		|				КОНЕЦ
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА &РасшифровкаПоЦеннойБумаге
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамТПлюс.ЦеннаяБумага
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ,
		|	0,
		|	0,
		|	0,
		|	ВЫБОР
		|		КОГДА _ЗадолженностиПоЦеннымБумагамТПлюс.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамТПлюс.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА _ЗадолженностиПоЦеннымБумагамТПлюс.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамТПлюс.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ
		|ИЗ
		|	_ЗадолженностиПоЦеннымБумагамОстатки КАК _ЗадолженностиПоЦеннымБумагамТПлюс
		|ГДЕ
		|	НЕ _ЗадолженностиПоЦеннымБумагамТПлюс.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления,
		|	НЕОПРЕДЕЛЕНО,
		|	ВЫБОР
		|		КОГДА &РасшифровкаПоКонтрагенту
		|			ТОГДА ОстаткиЦенныхБумагОстатки.ЦеннаяБумага.Эмитент.ЮрФизЛицо
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА &РасшифровкаПоЦеннойБумаге
		|			ТОГДА ОстаткиЦенныхБумагОстатки.ЦеннаяБумага
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ,
		|	ОстаткиЦенныхБумагОстатки.КоличествоОстаток,
		|	0,
		|	0,
		|	0,
		|	0
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(&Период, &ФильтрЦенныхБумаг) КАК ОстаткиЦенныхБумагОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗадолженностиИОстаткиЦБ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ЗадолженностиИОстаткиЦБ.Основание КАК Основание,
		|	_ЗадолженностиИОстаткиЦБ.Контрагент КАК Контрагент,
		|	_ЗадолженностиИОстаткиЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(_ЗадолженностиИОстаткиЦБ.КоличествоОстаток) КАК КоличествоОстаток,
		|	СУММА(_ЗадолженностиИОстаткиЦБ.ПроданоВРЕПО) КАК ПроданоВРЕПО,
		|	СУММА(_ЗадолженностиИОстаткиЦБ.КупленоПоРЕПО) КАК КупленоПоРЕПО,
		|	СУММА(_ЗадолженностиИОстаткиЦБ.ПроданоТПлюс) КАК ПроданоТПлюс,
		|	СУММА(_ЗадолженностиИОстаткиЦБ.КупленоТПлюс) КАК КупленоТПлюс
		|ПОМЕСТИТЬ _ПортфельЦенныхБумаг
		|ИЗ
		|	_ЗадолженностиИОстаткиЦБ КАК _ЗадолженностиИОстаткиЦБ
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЗадолженностиИОстаткиЦБ.СчетДоверительногоУправления,
		|	_ЗадолженностиИОстаткиЦБ.Основание,
		|	_ЗадолженностиИОстаткиЦБ.Контрагент,
		|	_ЗадолженностиИОстаткиЦБ.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ЗадолженностиПоЦеннымБумагамОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ЗадолженностиИОстаткиЦБ");
	
	Запрос.УстановитьПараметр("Организация",						Организация);
	Запрос.УстановитьПараметр("Период",								Период);
	Запрос.УстановитьПараметр("РасшифровкаПоОснованию",				РасшифровкаПоОснованию);
	Запрос.УстановитьПараметр("РасшифровкаПоКонтрагенту",			РасшифровкаПоКонтрагенту);
	Запрос.УстановитьПараметр("РасшифровкаПоЦеннойБумаге",			РасшифровкаПоЦеннойБумаге);	
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрЦенныхБумаг",	ФильтрЦенныхБумаг);	
	
	Если Не ЗначениеЗаполнено(ИмяВременнойТаблицы) Тогда
		ИмяВременнойТаблицы = "_ПортфельЦенныхБумаг";
	КонецЕсли;
	
	// Когда нужно поместить результат в менеджер ВТ:
	//  - если в менеджере есть ВТ, то ничего не делаем
	//  - если в менеджере нет ВТ, то формируем запрос для получения данных из регистров и помещения их в ВТ
	// Когда не нужно помещать результат в менеджер ВТ:
	//  - если в менеджере есть ВТ, формируем запрос на получение данных из ВТ
	//  - если в менеджере нет ВТ, то формируем запрос для получения данных из регистров
	
	Если ПоместитьВоВременнуюТаблицу Тогда
		
		Если МенеджерВременныхТаблиц = Неопределено Тогда
			МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		КонецЕсли;
		
		Если МенеджерВременныхТаблиц.Таблицы.Найти(ИмяВременнойТаблицы) = Неопределено Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ _ПортфельЦенныхБумаг", "ПОМЕСТИТЬ " + ИмяВременнойТаблицы);	
		Иначе
			Запрос.Текст = "";
		КонецЕсли;

		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
	Иначе
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ _ПортфельЦенныхБумаг", "");	
		
		Если МенеджерВременныхТаблиц <> Неопределено
			И МенеджерВременныхТаблиц.Таблицы.Найти(ИмяВременнойТаблицы) <> Неопределено
		Тогда
		
			Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
			
			Запрос.Текст = СтрШаблон("ВЫБРАТЬ РАЗРЕШЕННЫЕ * ИЗ %1", ИмяВременнойТаблицы);	
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат Запрос;	
	
КонецФункции

Функция ПолучитьЦенныеБумагиКлиента(Клиент, Организация, Период, РасшифровкаПоОснованию = Ложь, РасшифровкаПоКонтрагенту = Ложь, РасшифровкаПоЦеннойБумаге = Ложь, ПоместитьВоВременнуюТаблицу = Ложь, ИмяВременнойТаблицы = "_ЦенныеБумагиКлиента", МенеджерВременныхТаблиц = Неопределено) Экспорт
	
	// Получаем действующие счета д/у клиента
	
	ИмяВременнойТаблицыСчетовКлиента = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(Клиент, Организация, Период, Истина, , МенеджерВременныхТаблиц);
	
	// Получаем ценные бумаги	
	
	ФильтрЦенныхБумаг = СтрШаблон("(Организация, СчетДоверительногоУправления) В (ВЫБРАТЬ Организация, СчетДоверительногоУправления ИЗ %1)", ИмяВременнойТаблицыСчетовКлиента);
		
	Запрос = ПолучитьЗапросПортфеляЦенныхБумаг(Организация, Период, ФильтрЦенныхБумаг, РасшифровкаПоОснованию, РасшифровкаПоКонтрагенту, РасшифровкаПоЦеннойБумаге, ПоместитьВоВременнуюТаблицу, ИмяВременнойТаблицы, МенеджерВременныхТаблиц);
	
	Если ПоместитьВоВременнуюТаблицу Тогда
		
		Если ЗначениеЗаполнено(Запрос.Текст) Тогда // если ВТ уже есть, то выполнять нечего
			Запрос.Выполнить();
		КонецЕсли;
		
		РезультатФункции = ИмяВременнойТаблицы;
		
	Иначе
		
		Если Запрос.МенеджерВременныхТаблиц = Неопределено Тогда // он должен быть задействован для получения счетов д/у клиента
			Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		КонецЕсли;		
		
		РезультатФункции = Запрос.Выполнить().Выгрузить();		
		
	КонецЕсли;
	
	Возврат РезультатФункции;	
	
КонецФункции

Функция ПолучитьПортфельЦенныхБумаг(Организация, СчетДоверительногоУправления, ЦенныеБумаги = Неопределено, Период, РасшифровкаПоОснованию = Ложь, РасшифровкаПоКонтрагенту = Ложь, РасшифровкаПоЦеннойБумаге = Ложь) Экспорт
	
	// Получаем фильтр ценных бумаг	
	
	ТЗ_ЦенныеБумаги = Новый ТаблицаЗначений;
	ТЗ_ЦенныеБумаги.Колонки.Добавить("ЦеннаяБумага", Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
	Если ТипЗнч(ЦенныеБумаги) = Тип("ТаблицаЗначений") Тогда
		ТЗ_ЦенныеБумаги = ЦенныеБумаги;
	ИначеЕсли ТипЗнч(ЦенныеБумаги) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ТЗ_ЦенныеБумаги.Добавить(), ЦенныеБумаги);
	ИначеЕсли ЦенныеБумаги = Неопределено Тогда
		ТЗ_ЦенныеБумаги.Добавить();
	Иначе
		ВызватьИсключение "Некорректное значение параметра ""ЦенныеБумаги""";
	КонецЕсли;	
	
	Если ЦенныеБумаги = Неопределено Тогда
		ФильтрЦенныхБумаг = "(Организация, СчетДоверительногоУправления) В (ВЫБРАТЬ Организация, СчетДоверительногоУправления ИЗ _ЦенныеБумаги)";
	Иначе	
		ФильтрЦенныхБумаг = "(Организация, СчетДоверительногоУправления, Рынок, ЦеннаяБумага) В (ВЫБРАТЬ Организация, СчетДоверительногоУправления, Рынок, ЦеннаяБумага ИЗ _ЦенныеБумаги)";
	КонецЕсли;	
	
	// Компонуем запрос	
	
	Запрос = ПолучитьЗапросПортфеляЦенныхБумаг(Организация, Период, ФильтрЦенныхБумаг, РасшифровкаПоОснованию, РасшифровкаПоКонтрагенту, РасшифровкаПоЦеннойБумаге);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	&Организация КАК Организация,
		|	&СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|		КОГДА ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
		|		КОГДА ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
		|		КОГДА ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Закладные
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Закладные)
		|		КОГДА ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|		КОГДА ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|		КОГДА ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|		КОГДА ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.ВалютныеПары
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ВалютныеПары)
		|		КОГДА ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Доли
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли)
		|		КОГДА ВЫРАЗИТЬ(ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Фьючерс)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Фьючерсы)
		|		КОГДА ВЫРАЗИТЬ(ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Опцион)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Опционы)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ПустаяСсылка)
		|	КОНЕЦ КАК Рынок,
		|	ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ЦенныеБумаги
		|ИЗ
		|	&ЦенныеБумаги КАК ЦенныеБумаги
		|;" + Запрос.Текст;
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦенныеБумаги",					ТЗ_ЦенныеБумаги);

	Возврат Запрос.Выполнить().Выгрузить();
 
КонецФункции

