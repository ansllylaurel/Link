
Процедура НастроитьВидимостьИДоступностьРасчетногоСчетаИСвязанныхРеквизитов(Форма) Экспорт
	
	Элементы                     = Форма.Элементы;
	ДетализацияПоРасчетномуСчету = Форма.ДетализацияПоРасчетномуСчету;
	
	// элементы, зависящие от детализации по р/с
	Элементы.КомандаВыбратьИсполнителяПоДенежнымСредствам.Видимость = ДетализацияПоРасчетномуСчету;
	Элементы.РасчетныйСчет.Видимость                                = ДетализацияПоРасчетномуСчету;
		
КонецПроцедуры // НастроитьВидимостьИДоступностьРасчетногоСчетаИСвязанныхРеквизитов

Процедура НастроитьВидимостьБрокераСделкиИСвязанныхРеквизитов(Форма) Экспорт
	
	Элементы            = Форма.Элементы;
	ЭтоБрокерскаяСделка = (Форма.СделкаЧерезБрокера = 1);
	
	Элементы.Брокер.Видимость = ЭтоБрокерскаяСделка;
	
КонецПроцедуры // НастроитьВидимостьБрокераИСвязанныхРеквизитов

// Определяет, какой использован счет внутреннего учета: ДУ или СОБ
Процедура ЗаполнитьВидСчетаВнутреннегоУчета(Форма, ИмяОсновногоРеквизита = "Объект", ИмяПоляКлюча = "Ссылка") Экспорт
	
	СчетДоверительногоУправления = Форма[ИмяОсновногоРеквизита].СчетДоверительногоУправления;
	Если ЗначениеЗаполнено(СчетДоверительногоУправления) Тогда
		ВидДоговора				 = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
		ВидСчетаВнутреннегоУчета = ?(ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.Собственный"), "СОБ", "ДУ");	
	Иначе
		ВидСчетаВнутреннегоУчета = "";
	КонецЕсли;
	#Если Сервер Тогда
	Если Метаданные.Подсистемы.КоллективныеИнвестиции.Состав.Содержит(Форма[ИмяОсновногоРеквизита].Ссылка.Метаданные()) Тогда 
		ВидСчетаВнутреннегоУчета = "";
	КонецЕсли;	
	#КонецЕсли	
	
	Элементы = Форма.Элементы;	
	
	ЭлементСчетДУ = Элементы.Найти("СчетДоверительногоУправления");
	Если ЭлементСчетДУ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	#Если Сервер Тогда 
		ЭлементСчетДУ.Заголовок					= "Счет";
		ЭлементСчетДУ.АвтоМаксимальнаяШирина	= Ложь;
		ЭлементСчетДУ.МаксимальнаяШирина		= 36;
		
		ЭлементГруппаСчетДУ	= Элементы.Найти("ГруппаСчетДоверительногоУправления");	
		Если ЭлементГруппаСчетДУ = Неопределено Тогда
			ЭлементГруппаСчетДУ = Элементы.Вставить("ГруппаСчетДоверительногоУправления", Тип("ГруппаФормы"), ЭлементСчетДУ.Родитель, ЭлементСчетДУ);
			ЭлементГруппаСчетДУ.Вид					= ВидГруппыФормы.ОбычнаяГруппа;
			ЭлементГруппаСчетДУ.Отображение			= ОтображениеОбычнойГруппы.Нет;
			ЭлементГруппаСчетДУ.Группировка			= ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
			ЭлементГруппаСчетДУ.ОтображатьЗаголовок	= Ложь;
			
			Элементы.Переместить(ЭлементСчетДУ, ЭлементГруппаСчетДУ); 
			
			ЭлементГруппаСчетДУ.Видимость = Истина;	
		КонецЕсли;
	#КонецЕсли
	
	ЭлементВидСчетаВнутреннегоУчета = Элементы.Найти("ВидСчетаВнутреннегоУчета");
	Если ЭлементВидСчетаВнутреннегоУчета = Неопределено Тогда
		#Если Сервер Тогда 
			ЭлементВидСчетаВнутреннегоУчета = Форма.Элементы.Добавить("ВидСчетаВнутреннегоУчета", Тип("ДекорацияФормы"), ЭлементГруппаСчетДУ);
			ЭлементВидСчетаВнутреннегоУчета.Подсказка					= "Вид счета внутреннего учета (ДУ или СОБ)";
			ЭлементВидСчетаВнутреннегоУчета.Шрифт						= ШрифтыСтиля.ВажнаяИнформацияНаФормеШрифт;
			ЭлементВидСчетаВнутреннегоУчета.ЦветТекста					= WebЦвета.ЗеленыйЛес;
			ЭлементВидСчетаВнутреннегоУчета.РастягиватьПоГоризонтали	= Ложь;
			ЭлементВидСчетаВнутреннегоУчета.Ширина						= 3;
			ЭлементВидСчетаВнутреннегоУчета.ГоризонтальноеПоложение		= ГоризонтальноеПоложениеЭлемента.Центр;
			Если Не ПустаяСтрока(ВидСчетаВнутреннегоУчета) Тогда
				ЭлементВидСчетаВнутреннегоУчета.Видимость					= Истина;
			Иначе
				ЭлементВидСчетаВнутреннегоУчета.Видимость					= Ложь;
			КонецЕсли;	
		#Иначе
			Возврат;
		#КонецЕсли
	КонецЕсли;
	
	ЭлементВидСчетаВнутреннегоУчета.Заголовок = ВидСчетаВнутреннегоУчета;

КонецПроцедуры

Процедура УстановитьСостояниеДокумента(Форма, Состояние, Категория = Неопределено) Экспорт
	
	ЭлементГруппаСостояниеДокумента	= Форма.Элементы.Найти("ГруппаСостояниеДокумента");
	Если ЭлементГруппаСостояниеДокумента = Неопределено Тогда
		#Если Сервер Тогда 
			ЭлементГруппаСостояниеДокумента = Форма.Элементы.Вставить("ГруппаСостояниеДокумента", Тип("ГруппаФормы"), , Форма.ПодчиненныеЭлементы[0]);
			ЭлементГруппаСостояниеДокумента.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			ЭлементГруппаСостояниеДокумента.ОтображатьЗаголовок = Ложь;
		#Иначе
			Возврат;	
		#КонецЕсли
	КонецЕсли;
	ЭлементГруппаСостояниеДокумента.Видимость = Истина;	
	
	ЭлементСостояниеДокумента = Форма.Элементы.Найти("СостояниеДокумента");
	
	Если ЭлементСостояниеДокумента = Неопределено Тогда
		#Если Сервер Тогда 
			ЭлементСостояниеДокумента = Форма.Элементы.Добавить("СостояниеДокумента", Тип("ДекорацияФормы"), ЭлементГруппаСостояниеДокумента);
			ЭлементСостояниеДокумента.Шрифт						= ШрифтыСтиля.ВажнаяИнформацияНаФормеШрифт;
			ЭлементСостояниеДокумента.АвтоМаксимальнаяШирина	= Ложь;
			ЭлементСостояниеДокумента.Видимость					= Истина;
			ЭлементСостояниеДокумента.УстановитьДействие("ОбработкаНавигационнойСсылки", "Подключаемый_СостояниеДокументаОбработкаНавигационнойСсылки");
		#Иначе
			Возврат;	
		#КонецЕсли
	КонецЕсли;
	
	СостоянияДокумента = ПолучитьСостоянияДокумента(Форма);
	Если СостоянияДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Категория = Неопределено Тогда
		СостоянияДокумента.Добавить(Состояние);
	Иначе
		СостояниеНайдено = Ложь;
		
		Для Каждого СостояниеДокумента Из СостоянияДокумента Цикл
			Если СостояниеДокумента.Представление = Категория Тогда
				СостояниеДокумента.Значение = Состояние;
				СостояниеНайдено = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не СостояниеНайдено Тогда
			СостоянияДокумента.Добавить(Состояние, Категория);
		КонецЕсли;
	КонецЕсли;
	
	МассивСостояний = Новый Массив;
	Для Каждого СостояниеДокумента Из СостоянияДокумента Цикл
		Если ЗначениеЗаполнено(СостояниеДокумента.Значение) Тогда
			МассивСостояний.Добавить(СостояниеДокумента.Значение);
			МассивСостояний.Добавить(" ");
		КонецЕсли;
	КонецЦикла;
	
	ЭлементСостояниеДокумента.Заголовок	= Новый ФорматированнаяСтрока(МассивСостояний); 		
	
КонецПроцедуры

Функция ПолучитьСостоянияДокумента(Форма)
	
	Если Не ОбщегоНазначенияКлиентСервер.ПолеСуществует(Форма, "СостоянияДокумента") Тогда
		#Если Сервер Тогда 
			ДобавляемыеРеквизиты = Новый Массив();
			ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СостоянияДокумента", Новый ОписаниеТипов("СписокЗначений")));
			
			Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		#Иначе
			Возврат Неопределено;	
		#КонецЕсли
	КонецЕсли;
	
	ТекущееСостояние = Форма.СостоянияДокумента; 	
	
	Возврат ТекущееСостояние;

КонецФункции

Функция РеквизитОбязателенДляЗаполнения(ДанныеДокумента, РеквизитИмя) Экспорт
	
	Если ТипЗнч(ДанныеДокумента.Ссылка) = Тип("ДокументСсылка.ВводДенежныхСредств") И РеквизитИмя = "Основание" Тогда
		
		Возврат (ДанныеДокумента.ВидОперации = ПредопределенноеЗначение("Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтПайщика")
					Или ДанныеДокумента.ВидОперации = ПредопределенноеЗначение("Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствПриНеудачномВыводеДенежныхСредствПайщику"));
				
	КонецЕсли;
				
	Возврат Истина;			
	
КонецФункции

// Устанавливает видимость декораций согласования на формах документов ПоручениеНаДвижениеДенежныхСредств, ПоручениеНаДвижениеЦенныхБумаг
// в зависимости от необходимости согласования и статуса согласования
//	
//	Параметры:
//		Форма - Форма документа ПоручениеНаДвижениеДенежныхСредств или ПоручениеНаДвижениеЦенныхБумаг
//
Процедура НастроитьВидимостьДекорацийСогласованияПорученияНаВыводАктивов(Форма) Экспорт
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект; 
	
	СтруктураРеквизитов = Новый Структура("Дата, Организация, СчетДоверительногоУправления, ТипЗадолженности, Проведен, Ссылка"); 
	ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, Объект);

	ТребуетсяСогласование = РаботаСДокументами.ТребуетсяСогласованиеПорученияНаВыводАктивов(СтруктураРеквизитов);
	Согласовано = Ложь;
	Отменено = Ложь;
	
	Если ТребуетсяСогласование Тогда
		
		Согласовано = РаботаСДокументами.ПоручениеНаВыводАктивовСогласовано(Объект.Ссылка, ТекущаяДата());
		
		Если Не Согласовано Тогда
			Отменено = РаботаСДокументами.ПоручениеНаВыводАктивовОтменено(Объект.Ссылка);
		КонецЕсли;
		
	КонецЕсли;
		
	Элементы.ДекорацияСогласовано.Видимость           = Согласовано;	
	Элементы.ДекорацияОтменено.Видимость              = Отменено;	                                           	
	Элементы.ДекорацияТребуетсяСогласование.Видимость = ТребуетсяСогласование И Не Согласовано И Не Отменено;
	
КонецПроцедуры

#Область Согласование_Документов

// Отображает/скрывает карту маршрута на форме поручения на вывод денежных средств или ценных бумаг
// 
//	Параметры:
//		Форма - Форма документа ПоручениеНаДвижениеДенежныхСредств Или ПоручениеНаДвижениеЦенныхБумаг
//
Процедура ПоказатьСкрытьКартуМаршрутаСогласованияПорученияНаВыводАктивов(Форма) Экспорт
	
	Элементы 	= Форма.Элементы;
	Объект		= Форма.Объект;
	
	//Пока документ не проведен, бизнес-процесса нет
	Если Не Объект.Проведен Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Непроведенное поручение не может быть согласовано");
		Возврат;
	КонецЕсли;
	
	Элементы.КартаСогласования.Видимость = Не Элементы.КартаСогласования.Видимость;
	
	Если Элементы.КартаСогласования.Видимость Тогда
		
		КартаСогласования = РаботаСДокументами.ПолучитьКартуСогласованияПорученияНаВыводАктивов(Объект.Ссылка, Объект.Организация);
		Если КартаСогласования <> Неопределено Тогда 
			Форма.КартаСогласования = КартаСогласования;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//Для вводов-выводов денежных средств и ценных бумаг проверяется необходимость заполнения контрагента
Функция ТребуетсяПроверкаЗаполненияЗначенияКонтрагента(Объект) Экспорт
	
	ЭтоПоручениеНаВыводЦБ = ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ПоручениеНаДвижениеЦенныхБумаг");
	
	ДатаДляПроверки = ?(Объект.Дата = '00010101', ТекущаяДата(), Объект.Дата);
	Если ДатаДляПроверки >= РаботаСДокументами.ДатаНачалаПроверкиЗаполненияКонтрагента(ЭтоПоручениеНаВыводЦБ) Тогда
		Возврат Истина;
	Иначе
		
		ВидДоговораДоверительногоУправления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
		
		Если ДатаДляПроверки >= РаботаСДокументами.ДатаНачалаПроверкиЗаполненияКонтрагентаВоВводахВыводахДенежныхСредствИЦенныхБумагКлиентовНПФ(ЭтоПоручениеНаВыводЦБ)
				И (ВидДоговораДоверительногоУправления = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями")
					Или ВидДоговораДоверительногоУправления = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами")
					Или ВидДоговораДоверительногоУправления = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов")) Тогда
					
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
		
КонецФункции

#КонецОбласти

#Область Расчет_надбавок_и_скидок_ПИФ

Функция РассчитатьКоличествоПаевИСуммуНадбавки(СуммаЗачисления, РасчетнаяСтоимостьПая, ПараметрыНадбавки) Экспорт

	ПрименяетсяНадбавка = ПараметрыНадбавки.ПрименяютсяНадбавкиИСкидки;
	
	Если ПрименяетсяНадбавка Тогда
		
		ЗаявкаЧерезАгента = Истина;
		Если ПараметрыНадбавки.Свойство("ЗаявкаЧерезАгента") Тогда
			ЗаявкаЧерезАгента = ПараметрыНадбавки.ЗаявкаЧерезАгента;
		КонецЕсли;
		
		ПредельнаяСуммаНадбавки = 0;
		Если ПараметрыНадбавки.Свойство("ПредельнаяСуммаНадбавки") Тогда
			ПредельнаяСуммаНадбавки = ПараметрыНадбавки.ПредельнаяСуммаНадбавки;
		КонецЕсли;
		
		ПрименяетсяНадбавка = ЗаявкаЧерезАгента
			И (ПредельнаяСуммаНадбавки = 0 ИЛИ СуммаЗачисления < ПредельнаяСуммаНадбавки);
		
	КонецЕсли;

	Количество = Окр(СуммаЗачисления
					/ (РасчетнаяСтоимостьПая	
					+ ?(ПрименяетсяНадбавка, 
						РасчетнаяСтоимостьПая * ПараметрыНадбавки.СтавкаНадбавки / 100,
						0)),
				5, 1);
				
	СуммаНадбавки = ?(ПрименяетсяНадбавка, 
					Окр(РасчетнаяСтоимостьПая * ПараметрыНадбавки.СтавкаНадбавки / 100 * Количество, 2, 1),
					0);

									
	Возврат Новый Структура("Количество, СуммаНадбавки", Количество, СуммаНадбавки);
	
КонецФункции

#КонецОбласти

Функция ТребуетсяСозданиеДвиженийПоНДФЛ(Дата) Экспорт
	
	Если Дата >= '20260101' Тогда 
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции
