
Процедура ПередЗаписью(Объект) Экспорт
	
	ЗапомнитьТекущиеРеквизитыСправочника(Объект);
	
КонецПроцедуры // ПередЗаписью

Процедура ЗапомнитьТекущиеРеквизитыСправочника(Объект)
	
	ЭтоНовый = Объект.ЭтоНовый();
	
	Объект.ДополнительныеСвойства.Вставить("ЭтоНовый", ЭтоНовый);

	Если ЭтоНовый Тогда
		Возврат;
	КонецЕсли;
	
	ЗнчРеквизитов = Новый Структура();
	
	ИсключаемыеПоля = Новый Массив();
	ИсключаемыеПоля.Добавить("Ссылка");
	ИсключаемыеПоля.Добавить("ВерсияДанных");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Справочник.*
		|ИЗ
		|	Справочник." + Объект.Метаданные().Имя + " КАК Справочник
		|ГДЕ
		|	Справочник.Ссылка = &Ссылка";
		
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);	
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Для каждого Колонка Из РезультатЗапроса.Колонки Цикл
			Если ИсключаемыеПоля.Найти(Колонка.Имя) = Неопределено Тогда
				ЗнчРеквизитов.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Объект.ДополнительныеСвойства.Вставить("ПредЗначенияРеквизитов", ЗнчРеквизитов);
	
КонецПроцедуры

Функция ИзмененыРеквизитыРеквизитыСправочника(Объект, Знач Реквизиты, ИсключаемыеПоля = "", Отказ) Экспорт
	
	Если Объект.ДополнительныеСвойства.Свойство("ПредЗначенияРеквизитов") Тогда
		ПредЗначенияРеквизитов = Объект.ДополнительныеСвойства.ПредЗначенияРеквизитов;	
	Иначе	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для " + Объект + " нет возможности проверить изменялись ли реквизиты.", Объект,,, Отказ);
		Возврат Ложь;
	КонецЕсли; 
	
	ИсключаемыеПоля = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИсключаемыеПоля,, Истина, Истина);	
	ИсключаемыеПоля.Добавить("Ссылка");
	ИсключаемыеПоля.Добавить("ВерсияДанных");
		
	Если ТипЗнч(Реквизиты) <> Тип("Массив") Тогда
		Реквизиты = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(Реквизиты,, Истина, Истина);		
	КонецЕсли; 
	
	Для каждого Реквизит Из Реквизиты Цикл
		Если ИсключаемыеПоля.Найти(Реквизит) = Неопределено И Объект[Реквизит] <> ПредЗначенияРеквизитов[Реквизит] Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции
