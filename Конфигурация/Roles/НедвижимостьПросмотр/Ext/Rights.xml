	<restrictionTemplate>
		<name>ДанныеТекущейОрганизации</name>
		<condition>    ТекущаяТаблица
ИЗ
    #ТекущаяТаблица КАК ТекущаяТаблица
ГДЕ
    ТекущаяТаблица.Организация = &amp;ТекущаяОрганизация
    ИЛИ ТекущаяТаблица.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
    ИЛИ &amp;ЭтоФоновоеЗадание</condition>
	</restrictionTemplate>
	<restrictionTemplate>
		<name>ПоОрганизацииИСчетуДУ</name>
		<condition>#Если НЕ &amp;ЭтоФоновоеЗадание #Тогда
        ТекущаяТаблица
    ИЗ
        #ТекущаяТаблица КАК ТекущаяТаблица
    #Если &amp;КонтрольДоступаКСчетамДоверительногоУправления И НЕ &amp;ДоступныВсеСчетаДоверительногоУправления #Тогда
        ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДоступныеСчетаДоверительногоУправления КАК ДоступныеСчетаДоверительногоУправления
        ПО ТекущаяТаблица.СчетДоверительногоУправления = ДоступныеСчетаДоверительногоУправления.СчетДоверительногоУправления
        И ДоступныеСчетаДоверительногоУправления.Пользователь = &amp;ТекущийПользователь
    #Иначе
        ГДЕ ТекущаяТаблица.Организация = &amp;ТекущаяОрганизация
    #КонецЕсли
#КонецЕсли</condition>
	</restrictionTemplate>
