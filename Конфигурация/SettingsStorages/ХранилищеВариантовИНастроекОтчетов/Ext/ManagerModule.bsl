
Процедура ОбработкаЗагрузки(КлючОбъекта, КлючНастроек, Настройки, ОписаниеНастроек, Пользователь)
	
	УстановитьПривилегированныйРежим(Истина);
	ВариантСсылка = Справочники.ВариантыОтчетов.ПолучитьСсылку(КлючНастроек);
	УстановитьПривилегированныйРежим(Ложь);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВариантСсылка", ВариантСсылка);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВариантыОтчетов.Настройки КАК Настройки
		|ИЗ
		|	Справочник.ВариантыОтчетов КАК ВариантыОтчетов
		|ГДЕ
		|	ВариантыОтчетов.Ссылка = &ВариантСсылка";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Настройки = Выборка.Настройки.Получить();
	Иначе
		Настройки = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаСохранения(КлючОбъекта, КлючНастроек, Настройки, ОписаниеНастроек, Пользователь)
	
	ВариантСсылка = Справочники.ВариантыОтчетов.ПолучитьСсылку(КлючНастроек);
	ВариантОбъект = ВариантСсылка.ПолучитьОбъект();
	ВариантОбъект.Настройки = Новый ХранилищеЗначения(Настройки, Новый СжатиеДанных(9));
	ВариантОбъект.Записать();
	
КонецПроцедуры
