
Процедура ЗаполнитьДолжностныеЛица(МВТ, Организация, Период, СписокЮрФизЛиц = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.УстановитьПараметр("Период",					Период);
	Запрос.УстановитьПараметр("Организация",			Организация);
	Запрос.УстановитьПараметр("СписокЮрФизЛиц",			СписокЮрФизЛиц);
	Запрос.УстановитьПараметр("ОтборСписокЮрФизЛиц",	СписокЮрФизЛиц <> Неопределено);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВнутренниеПеречниСрезПоследних.Организация КАК Организация,
		|	ВнутренниеПеречниСрезПоследних.Объект.Код КАК ИдентификаторЛица,
		|	ВнутренниеПеречниСрезПоследних.Объект КАК ДолжностноеЛицо,
		|	МАКСИМУМ(Сотрудники.Ссылка ЕСТЬ НЕ NULL ) КАК Сотрудник
		|ПОМЕСТИТЬ _ДолжностныеЛица_Предварительно
		|ИЗ
		|	РегистрСведений.ВнутренниеПеречни.СрезПоследних(
		|			&Период,
		|			(&Организация = НЕОПРЕДЕЛЕНО
		|				ИЛИ Организация = &Организация)
		|				И ВидПеречня В (ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ДолжностныеЛицаНАУФОР), ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ДолжностныеЛицаПН))) КАК ВнутренниеПеречниСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
		|		ПО ВнутренниеПеречниСрезПоследних.Организация = Сотрудники.Организация
		|			И ВнутренниеПеречниСрезПоследних.Объект = Сотрудники.ЮрФизЛицо
		|ГДЕ
		|	ВнутренниеПеречниСрезПоследних.Действует
		|	И (&ОтборСписокЮрФизЛиц = ЛОЖЬ
		|			ИЛИ ВнутренниеПеречниСрезПоследних.Объект В (&СписокЮрФизЛиц))
		|
		|СГРУППИРОВАТЬ ПО
		|	ВнутренниеПеречниСрезПоследних.Организация,
		|	ВнутренниеПеречниСрезПоследних.Объект,
		|	ВнутренниеПеречниСрезПоследних.Объект.Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДолжностныеЛица_Предварительно.ИдентификаторЛица КАК ИдентификаторЛица,
		|	_ДолжностныеЛица_Предварительно.ДолжностноеЛицо КАК ЮрФизЛицо,
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.Фамилия + "" "" + РеквизитыСотрудниковОрганизацииСрезПоследних.Имя + "" "" + РеквизитыСотрудниковОрганизацииСрезПоследних.Отчество КАК ФИО,
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.ДатаРождения КАК ДатаРождения,
		|	_ДолжностныеЛица_Предварительно.Организация КАК Организация,
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.Фамилия КАК Фамилия,
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.Имя КАК Имя,
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.Отчество КАК Отчество
		|ПОМЕСТИТЬ _ДолжностныеЛица
		|ИЗ
		|	_ДолжностныеЛица_Предварительно КАК _ДолжностныеЛица_Предварительно
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
		|				&Период,
		|				(&Организация = НЕОПРЕДЕЛЕНО
		|					ИЛИ Организация = &Организация)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыСотрудниковОрганизацииСрезПоследних
		|		ПО _ДолжностныеЛица_Предварительно.ДолжностноеЛицо = РеквизитыСотрудниковОрганизацииСрезПоследних.ЮрФизЛицо
		|			И _ДолжностныеЛица_Предварительно.Организация = РеквизитыСотрудниковОрганизацииСрезПоследних.Организация
		|ГДЕ
		|	_ДолжностныеЛица_Предварительно.Сотрудник
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ДолжностныеЛица_Предварительно.ИдентификаторЛица,
		|	_ДолжностныеЛица_Предварительно.ДолжностноеЛицо,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаРождения,
		|	_ДолжностныеЛица_Предварительно.Организация,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество
		|ИЗ
		|	_ДолжностныеЛица_Предварительно КАК _ДолжностныеЛица_Предварительно
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				(&Организация = НЕОПРЕДЕЛЕНО
		|					ИЛИ Организация = &Организация)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ПО _ДолжностныеЛица_Предварительно.ДолжностноеЛицо = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|			И _ДолжностныеЛица_Предварительно.Организация = РеквизитыФизическихЛицАнкетныеСрезПоследних.Организация
		|ГДЕ
		|	НЕ _ДолжностныеЛица_Предварительно.Сотрудник";
	
	Запрос.Выполнить();
	
КонецПроцедуры