
Функция ПолучитьЗначенияНастроекУчетаДоходовПоЦеннымБумагам(ТаблицаФормы, Дата, Организация) Экспорт
	
	ПоляТаблицы = "";
	
	Для Каждого Поле Из ТаблицаФормы.Колонки Цикл
		
		Если Поле.Имя = "Брокер" Или Поле.Имя = "РасчетныйСчет" Или Поле.Имя = "ДетализацияПоРасчетномуСчету" Или Поле.Имя = "ОплатаЧерезБрокера" Тогда
			Продолжить;
		КонецЕсли;
		
		ПоляТаблицы = ПоляТаблицы + ?(ПоляТаблицы = "", "", "," + Символы.ПС) + "	_ТаблицаФормы." + Поле.Имя + " КАК " + Поле.Имя;
		
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаФормы.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ТаблицаФормы.ВалютаОплаты КАК ВалютаОплаты,
		|	&Звездочка КАК Звездочка
		|ПОМЕСТИТЬ _ТаблицаФормы
		|ИЗ
		|	&ТаблицаФормы КАК ТаблицаФормы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.Брокер КАК Брокер,
		|	НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.РасчетныйСчет КАК РасчетныйСчет,
		|	ВЫБОР КОГДА НастройкиУчетаБэкОфисаСрезПоследних.ДетализацияПоРасчетномуСчету ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ НастройкиУчетаБэкОфисаСрезПоследних.ДетализацияПоРасчетномуСчету
		|	КОНЕЦ КАК ДетализацияПоРасчетномуСчету,
		|	ВЫБОР
		|		КОГДА НЕ(НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.Брокер ЕСТЬ NULL
		|					ИЛИ НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка))
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОплатаЧерезБрокера,
		|	&ПоляТаблицы КАК ПоляТаблицы
		|ИЗ
		|	_ТаблицаФормы КАК _ТаблицаФормы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаДоходовПоЦеннымБумагам.СрезПоследних(&Дата, Организация = &Организация) КАК НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних
		|		ПО _ТаблицаФормы.СчетДоверительногоУправления = НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.СчетДоверительногоУправления
		|			И _ТаблицаФормы.ВалютаОплаты = НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.Валюта
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаБэкОфиса.СрезПоследних(&Дата, Организация = &Организация) КАК НастройкиУчетаБэкОфисаСрезПоследних
		|		ПО (НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.Брокер = НастройкиУчетаБэкОфисаСрезПоследних.Брокер)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*"); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляТаблицы КАК ПоляТаблицы", ПоляТаблицы); 
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ТаблицаФормы", ТаблицаФормы);
		
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции 

Функция ПолучитьРасчетныйСчетИзНастроек(Организация, СчетДоверительногоУправления, Валюта) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.РасчетныйСчет КАК РасчетныйСчет
		|ИЗ
		|	РегистрСведений.НастройкиУчетаДоходовПоЦеннымБумагам.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Валюта = &Валюта) КАК НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Организация", Организация);
    Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 		
		Возврат Выборка.РасчетныйСчет;	
	КонецЕсли;
	
КонецФункции
