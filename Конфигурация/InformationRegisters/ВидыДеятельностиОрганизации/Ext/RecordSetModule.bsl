
////////////////////////////////////////////////////////////////////////////////
// ПРЕДОПРЕДЕЛЕННЫЕ

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("ОбработкаПроверкиЗаполненияОтказ", Отказ);
	
КонецПроцедуры  // ОбработкаПроверкиЗаполнения

Процедура ПередЗаписью(Отказ, Замещение)
	
	// блокирующие проверки
	УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
	
	ВидыДеятельности = Новый Массив();
	ВидыДеятельности.Добавить(Новый Структура("Имя, ФункциональнаяРольРодП", "Брокерская",   "брокерской компании"));
	ВидыДеятельности.Добавить(Новый Структура("Имя, ФункциональнаяРольРодП", "Депозитарная", "депозитарной компании"));
	ВидыДеятельности.Добавить(Новый Структура("Имя, ФункциональнаяРольРодП", "Управляющая",  "управляющей компании"));
	
	Для каждого Запись Из ЭтотОбъект Цикл
		Для каждого ВидДеятельности Из ВидыДеятельности Цикл
			
			Если Запись[ВидДеятельности.Имя] Тогда
				Если      Не ЗначениеЗаполнено(Запись[ВидДеятельности.Имя + "Компания"]) Тогда
					// соответствующая функциональная роль должна быть заполнено
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для организации «" + Запись.Организация + "» при заполненном виде деятельности «" + ВидДеятельности.Имя + "» не заполнена " + НРег(ВидДеятельности.Имя) + " компания.");
					Отказ = Истина;
					
				ИначеЕсли Запись.Организация.ЮрФизЛицо <> Запись[ВидДеятельности.Имя + "Компания"].ЮрФизЛицо Тогда
					// юр. лицо функциональной роли должно совпадать с юр. лицом организации
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Юр. лицо организации «" + Запись.Организация + "» не совпадает с юр. лицом " + ВидДеятельности.ФункциональнаяРольРодП + " «" + Запись[ВидДеятельности.Имя + "Компания"] + "».");
					Отказ = Истина;
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// очистим функциональные роли, если сняты флажки
	Для каждого Запись Из ЭтотОбъект Цикл
		Если Не Запись.Брокерская И ЗначениеЗаполнено(Запись.БрокерскаяКомпания) Тогда
			Запись.БрокерскаяКомпания = Неопределено;
		КонецЕсли;	
		
		Если Не Запись.Депозитарная И ЗначениеЗаполнено(Запись.ДепозитарнаяКомпания) Тогда
			Запись.ДепозитарнаяКомпания = Неопределено;
		КонецЕсли;	
		
		Если Не Запись.Управляющая И ЗначениеЗаполнено(Запись.УправляющаяКомпания) Тогда
			Запись.УправляющаяКомпания = Неопределено;
		КонецЕсли;	
	КонецЦикла;

КонецПроцедуры  // ПередЗаписью
