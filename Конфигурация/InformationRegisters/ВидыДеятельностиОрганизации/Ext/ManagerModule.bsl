
Процедура ЗарегистрироватьВидДеятельности(ФункциональнаяРоль)
	
	// проверим, является ли юр. лицо функиональной роли организацией
	Если ТипЗнч(ФункциональнаяРоль) = Тип("СправочникСсылка.Организации") Тогда
		Организация = ФункциональнаяРоль;
		
		ФункциональныеРолиПоВидамДеятельности = Справочники.ЮрФизЛица.ПолучитьФункциональныеРоли(Организация.ЮрФизЛицо, "БрокерскиеКомпании, ДепозитарныеКомпании, УправляющиеКомпании", Ложь);
		
		// дополним описание функциональных ролей видами деятельности
		Для каждого ФункциональнаяРольПоВидуДеятельности Из ФункциональныеРолиПоВидамДеятельности Цикл
			Если      ФункциональнаяРольПоВидуДеятельности.ВидФункциональнойРоли = "БрокерскиеКомпании"   Тогда
				ФункциональнаяРольПоВидуДеятельности.Вставить("ВидДеятельности", "Брокерская");
			ИначеЕсли ФункциональнаяРольПоВидуДеятельности.ВидФункциональнойРоли = "ДепозитарныеКомпании" Тогда
				ФункциональнаяРольПоВидуДеятельности.Вставить("ВидДеятельности", "Депозитарная");
			ИначеЕсли ФункциональнаяРольПоВидуДеятельности.ВидФункциональнойРоли = "УправляющиеКомпании"  Тогда
				ФункциональнаяРольПоВидуДеятельности.Вставить("ВидДеятельности", "Управляющая");
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		// проверим, является ли юр. лицо функиональной роли организацией
		Организация = Справочники.ЮрФизЛица.ПолучитьФункциональнуюРоль(ФункциональнаяРоль.ЮрФизЛицо, "Организации");
		Если Не ЗначениеЗаполнено(Организация) Тогда
			Возврат;
		КонецЕсли;
		
		ФункциональныеРолиПоВидамДеятельности = Новый Массив();
		
		Если      ТипЗнч(ФункциональнаяРоль) = Тип("СправочникСсылка.БрокерскиеКомпании")   Тогда
			ФункциональныеРолиПоВидамДеятельности.Добавить(Новый Структура("ВидДеятельности, ФункциональнаяРоль", "Брокерская", ФункциональнаяРоль));
		ИначеЕсли ТипЗнч(ФункциональнаяРоль) = Тип("СправочникСсылка.ДепозитарныеКомпании") Тогда
			ФункциональныеРолиПоВидамДеятельности.Добавить(Новый Структура("ВидДеятельности, ФункциональнаяРоль", "Депозитарная", ФункциональнаяРоль));
		ИначеЕсли ТипЗнч(ФункциональнаяРоль) = Тип("СправочникСсылка.УправляющиеКомпании")  Тогда
			ФункциональныеРолиПоВидамДеятельности.Добавить(Новый Структура("ВидДеятельности, ФункциональнаяРоль", "Управляющая", ФункциональнаяРоль));
		КонецЕсли;
	КонецЕсли;
	
	// установим блокировку на запись по организации
	Если Не МонопольныйРежим() Тогда
		Блокировка = Новый БлокировкаДанных;
		
		БлокировкаВидаДеятельностиОрганизации = Блокировка.Добавить("РегистрСведений.ВидыДеятельностиОрганизации");
		БлокировкаВидаДеятельностиОрганизации.УстановитьЗначение("Организация", Организация);
		БлокировкаВидаДеятельностиОрганизации.Режим = РежимБлокировкиДанных.Исключительный;
		
		Блокировка.Заблокировать();
	КонецЕсли;

	// найдем нужную запись
	МенеджерЗаписи = РегистрыСведений.ВидыДеятельностиОрганизации.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Организация = Организация;
	МенеджерЗаписи.Прочитать();
	
	// изменим вид дейстельности
	Если Не МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.Организация = Организация;
	КонецЕсли;
	
	Для каждого ФункциональнаяРольПоВидуДуятельности Из ФункциональныеРолиПоВидамДеятельности Цикл
		ТекФункциональнаяРоль = ФункциональнаяРольПоВидуДуятельности.ФункциональнаяРоль;
		
		МенеджерЗаписи[ФункциональнаяРольПоВидуДуятельности.ВидДеятельности]              = Не ТекФункциональнаяРоль.ПометкаУдаления;
		МенеджерЗаписи[ФункциональнаяРольПоВидуДуятельности.ВидДеятельности + "Компания"] = ?(ТекФункциональнаяРоль.ПометкаУдаления, Неопределено, ТекФункциональнаяРоль);
	КонецЦикла;
		
	МенеджерЗаписи.Записать();
	
КонецПроцедуры // ЗарегистрироватьВидДеятельности

Процедура ОтменитьРегистрациюВидаДеятельности(ФункциональнаяРоль)
	
	Если      ТипЗнч(ФункциональнаяРоль) = Тип("СправочникСсылка.БрокерскиеКомпании")   Тогда
		ВидДеятельности       = "Брокерская";
		ИмяФункциональнойРоли = "БрокерскаяКомпания";
	ИначеЕсли ТипЗнч(ФункциональнаяРоль) = Тип("СправочникСсылка.ДепозитарныеКомпании") Тогда
		ВидДеятельности       = "Депозитарная";
		ИмяФункциональнойРоли = "ДепозитарнаяКомпания";
	ИначеЕсли ТипЗнч(ФункциональнаяРоль) = Тип("СправочникСсылка.УправляющиеКомпании")  Тогда
		ВидДеятельности       = "Управляющая";
		ИмяФункциональнойРоли = "УправляющаяКомпания";
	Иначе
		Возврат;
	КонецЕсли;
	
	// проверим, установлена ли переданная функциональная роль для какой-нибудь организации
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВидыДеятельностиОрганизации.Организация
		|ИЗ
		|	РегистрСведений.ВидыДеятельностиОрганизации КАК ВидыДеятельностиОрганизации
		|ГДЕ
		|	ВидыДеятельностиОрганизации." + ИмяФункциональнойРоли + " = &ФункциональнаяРоль";
		
	Запрос.УстановитьПараметр("ФункциональнаяРоль", ФункциональнаяРоль);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		// установим блокировку на требуемую запись
		Блокировка = Новый БлокировкаДанных;
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ВидыДеятельностиОрганизации");
		ЭлементБлокировки.УстановитьЗначение("Организация", Выборка.Организация);
		
		Блокировка.Заблокировать();
		
		// удалим вид деятельности, соответствующий функциональной роли
		МенеджерЗаписи = РегистрыСведений.ВидыДеятельностиОрганизации.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Организация = Выборка.Организация;
		МенеджерЗаписи.Прочитать();
		
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи[ВидДеятельности]       = Неопределено;
			МенеджерЗаписи[ИмяФункциональнойРоли] = Неопределено;
		КонецЕсли;
		
		МенеджерЗаписи.Записать();		
	КонецЕсли;
	
КонецПроцедуры // ОтменитьРегистрациюВидаДеятельности

Процедура ПриЗаписиОбъекта(Объект) Экспорт
	
	Если Объект.ПометкаУдаления Тогда
		ОтменитьРегистрациюВидаДеятельности(Объект.Ссылка);
	Иначе
		ЗарегистрироватьВидДеятельности(Объект.Ссылка);
	КонецЕсли;		
	
КонецПроцедуры // ПриЗаписиОбъекта