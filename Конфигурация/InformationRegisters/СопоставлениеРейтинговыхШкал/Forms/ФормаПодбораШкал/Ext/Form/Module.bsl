Процедура СправочникСписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Структура = Новый Структура;
	Структура.Вставить("ДобавитьВоВсеСтрокиСопоставления", ЭтаФорма.ДобавитьВоВсеСтрокиСопоставления);
	Структура.Вставить("ОтборПоЭталоннойШкале", ЭтаФорма.ОтборПоЭталоннойШкале);
	Структура.Вставить("Значение", Значение);
	
	ОповеститьОВыборе(Структура);
	
КонецПроцедуры
