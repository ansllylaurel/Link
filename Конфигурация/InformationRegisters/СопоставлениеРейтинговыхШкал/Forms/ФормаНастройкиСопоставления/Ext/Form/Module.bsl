// КОМАНДЫ ФОРМЫ

&НаКлиенте
Процедура ЗаполнитьПоНаименованию(Команда)
	
	ЗаполнитьПоНаименованиюНаСервере(Элементы.ДанныеСтрокСопоставления.ТекущиеДанные.ПолучитьИдентификатор());
	
КонецПроцедуры

&НаКлиенте
Процедура Подбор(Команда)
	
	Если Элементы.СтрокиСопоставления.ТекущиеДанные = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать строку сопоставления", , "СтрокиСопоставления");
	Иначе
		ПараметрыФормы = Новый Структура("РежимВыбора, МножественныйВыбор", Истина, Истина);
		ОткрытьФормуМодально("РегистрСведений.СопоставлениеРейтинговыхШкал.Форма.ФормаПодбораШкал", ПараметрыФормы, Элементы.ДанныеСтрокСопоставления);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИзменения(Команда)
	ЗаписатьИзмененияНаСервере();
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ДобавитьСтрокиСопоставления(ВыбранноеЗначение, СтрокаСопоставления)

	Для каждого Шкала Из ВыбранноеЗначение.Значение Цикл
			
		НоваяСтрока = ЭтаФорма.ДанныеСтрокСопоставления.Добавить();
		НоваяСтрока.ШкалаРейтингаЭталонная 	= Шкала;
		НоваяСтрока.СтрокаСопоставления 	= СтрокаСопоставления;
		НоваяСтрока.ОтборПоЭталоннойШкале 	= ВыбранноеЗначение.ОтборПоЭталоннойШкале;

	КонецЦикла;

КонецПроцедуры

&НаСервере 
Процедура ПрочитатьДанныеРегистра()

	ЭтаФорма.ДанныеСтрокСопоставления.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СопоставлениеРейтинговыхШкалСрезПоследних.СтрокаСопоставления КАК СтрокаСопоставления,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ШкалаРейтингаЭталонная,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМинимальное,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМаксимальное,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ОтборПоЭталоннойШкале
		|ИЗ
		|	РегистрСведений.СопоставлениеРейтинговыхШкал.СрезПоследних(&Период, Источник = &Источник) КАК СопоставлениеРейтинговыхШкалСрезПоследних
		|ГДЕ
		|	СопоставлениеРейтинговыхШкалСрезПоследних.Активно
		|
		|УПОРЯДОЧИТЬ ПО
		|	СтрокаСопоставления,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ШкалаРейтингаЭталонная.Владелец,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ШкалаРейтингаЭталонная.Наименование";
	
	Запрос.УстановитьПараметр("Источник", ЭтаФорма.Источник);
	Запрос.УстановитьПараметр("Период", ЭтаФорма.Период);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ЭтаФорма.ДанныеСтрокСопоставления.Добавить(), Выборка);
	КонецЦикла;
	
	ТаблицаЗначений = ЭтаФорма.ДанныеСтрокСопоставления.Выгрузить(, "СтрокаСопоставления");
	ТаблицаЗначений.Свернуть("СтрокаСопоставления");
	ТаблицаЗначений.Сортировать("СтрокаСопоставления");
	
	ЭтаФорма.СтрокиСопоставления.ЗагрузитьЗначения(ТаблицаЗначений.ВыгрузитьКолонку("СтрокаСопоставления"));
	Элементы.СтрокиСопоставления.ТекущаяСтрока = 0;
	
	ЭтаФорма.Модифицированность = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьМодифицированностьЗаписатьИзменения()

	Если ЭтаФорма.Модифицированность И Вопрос("Данные изменены. Сохранить внесенные изменения", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
	
		ЗаписатьИзменения(Неопределено);
		
	КонецЕсли; 

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПоСтроке(ТекущиеДанные)

	Если Не ТекущиеДанные = Неопределено Тогда
	
		Элементы.ДанныеСтрокСопоставления.ОтборСтрок = Новый ФиксированнаяСтруктура("СтрокаСопоставления", ТекущиеДанные.Значение);
	
	КонецЕсли; 	

КонецПроцедуры

&НаСервере 
Процедура ЗаписатьИзмененияНаСервере(Дата = Неопределено)

	Дата = ?(Дата = Неопределено, ЭтаФорма.Период, Дата);
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СопоставлениеРейтинговыхШкалСрезПоследних.СтрокаСопоставления,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ШкалаРейтингаЭталонная,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.Активно,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМинимальное,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМаксимальное,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ОтборПоЭталоннойШкале
		|ПОМЕСТИТЬ _ТекущиеЗначения
		|ИЗ
		|	РегистрСведений.СопоставлениеРейтинговыхШкал.СрезПоследних(&Период, Источник = &Источник) КАК СопоставлениеРейтинговыхШкалСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СопоставлениеРейтинговыхШкалСрезПоследних.СтрокаСопоставления,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ШкалаРейтингаЭталонная,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМинимальное,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМаксимальное,
		|	ИСТИНА КАК Активно,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ОтборПоЭталоннойШкале
		|ПОМЕСТИТЬ _НовыеЗначения
		|ИЗ
		|	&НовыеЗначения КАК СопоставлениеРейтинговыхШкалСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТекущиеЗначения.СтрокаСопоставления,
		|	_ТекущиеЗначения.ШкалаРейтингаЭталонная,
		|	НЕ _НовыеЗначения.СтрокаСопоставления ЕСТЬ NULL  КАК Активно,
		|	_ТекущиеЗначения.ЗначениеМинимальное,
		|	_ТекущиеЗначения.ЗначениеМаксимальное,
		|	_ТекущиеЗначения.ОтборПоЭталоннойШкале
		|ИЗ
		|	_ТекущиеЗначения КАК _ТекущиеЗначения
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НовыеЗначения КАК _НовыеЗначения
		|		ПО (_НовыеЗначения.СтрокаСопоставления = _ТекущиеЗначения.СтрокаСопоставления)
		|			И (_НовыеЗначения.ШкалаРейтингаЭталонная = _ТекущиеЗначения.ШкалаРейтингаЭталонная)
		|ГДЕ
		|	_НовыеЗначения.СтрокаСопоставления ЕСТЬ NULL 
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_НовыеЗначения.СтрокаСопоставления,
		|	_НовыеЗначения.ШкалаРейтингаЭталонная,
		|	_НовыеЗначения.Активно,
		|	_НовыеЗначения.ЗначениеМинимальное,
		|	_НовыеЗначения.ЗначениеМаксимальное,
		|	_НовыеЗначения.ОтборПоЭталоннойШкале
		|ИЗ
		|	_ТекущиеЗначения КАК _ТекущиеЗначения
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НовыеЗначения КАК _НовыеЗначения
		|		ПО (_НовыеЗначения.СтрокаСопоставления = _ТекущиеЗначения.СтрокаСопоставления)
		|			И (_НовыеЗначения.ШкалаРейтингаЭталонная = _ТекущиеЗначения.ШкалаРейтингаЭталонная)
		|ГДЕ
		|	(_ТекущиеЗначения.Активно <> _НовыеЗначения.Активно
		|			ИЛИ _ТекущиеЗначения.ЗначениеМинимальное <> _НовыеЗначения.ЗначениеМинимальное
		|			ИЛИ _ТекущиеЗначения.ЗначениеМаксимальное <> _НовыеЗначения.ЗначениеМаксимальное
		|			ИЛИ _ТекущиеЗначения.ОтборПоЭталоннойШкале <> _НовыеЗначения.ОтборПоЭталоннойШкале)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_НовыеЗначения.СтрокаСопоставления,
		|	_НовыеЗначения.ШкалаРейтингаЭталонная,
		|	_НовыеЗначения.Активно,
		|	_НовыеЗначения.ЗначениеМинимальное,
		|	_НовыеЗначения.ЗначениеМаксимальное,
		|	_НовыеЗначения.ОтборПоЭталоннойШкале
		|ИЗ
		|	_НовыеЗначения КАК _НовыеЗначения
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТекущиеЗначения КАК _ТекущиеЗначения
		|		ПО _НовыеЗначения.СтрокаСопоставления = _ТекущиеЗначения.СтрокаСопоставления
		|			И _НовыеЗначения.ШкалаРейтингаЭталонная = _ТекущиеЗначения.ШкалаРейтингаЭталонная
		|ГДЕ
		|	_ТекущиеЗначения.СтрокаСопоставления ЕСТЬ NULL ";
	
	Запрос.УстановитьПараметр("НовыеЗначения", ЭтаФорма.ДанныеСтрокСопоставления.Выгрузить());	
	Запрос.УстановитьПараметр("Источник", ЭтаФорма.Источник);
	Запрос.УстановитьПараметр("Период", Дата);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
	
		Запись = РегистрыСведений.СопоставлениеРейтинговыхШкал.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Период 		= Дата;
		Запись.Источник 	= ЭтаФорма.Источник;
		Запись.Агрегатор 	= Запись.ШкалаРейтингаЭталонная.Агрегатор;
		Запись.ТипШкалы 	= Запись.ШкалаРейтингаЭталонная.ТипШкалы;
		Запись.Срок			= Запись.ШкалаРейтингаЭталонная.Срок;
		Запись.ВидРейтинга	= Запись.ШкалаРейтингаЭталонная.ВидРейтинга;
		Запись.РейтинговоеАгенство = Запись.ШкалаРейтингаЭталонная.Владелец;
		
		Запись.Записать();
	
	КонецЦикла; 
	
	ЭтаФорма.Модифицированность = Ложь;

КонецПроцедуры
 
&НаСервере
Процедура ЗаполнитьПоНаименованиюНаСервере(Идентификатор)

	ТекущиеДанные = ЭтаФорма.ДанныеСтрокСопоставления.НайтиПоИдентификатору(Идентификатор);
	ТекущееАгентство = ТекущиеДанные.ШкалаРейтингаЭталонная.Владелец;
	ИмяПоля = Элементы.ДанныеСтрокСопоставления.ТекущийЭлемент.Имя;
	НаименованиеТекущегоЗначения = ТекущиеДанные[ИмяПоля].Наименование;
	
	Для каждого СтрокаДанных Из ЭтаФорма.ДанныеСтрокСопоставления Цикл
	
		Если СтрокаДанных.СтрокаСопоставления = ТекущиеДанные.СтрокаСопоставления И 
			СтрокаДанных.ШкалаРейтингаЭталонная.Владелец = ТекущееАгентство И Не ЗначениеЗаполнено(СтрокаДанных[ИмяПоля]) Тогда
		
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			               |	ЗначенияРейтингов.Ссылка
			               |ИЗ
			               |	Справочник.ЗначенияРейтингов КАК ЗначенияРейтингов
			               |ГДЕ
			               |	ЗначенияРейтингов.Владелец = &Шкала
			               |	И ЗначенияРейтингов.Наименование = &Наименование";
			Запрос.УстановитьПараметр("Шкала", СтрокаДанных.ШкалаРейтингаЭталонная);
			Запрос.УстановитьПараметр("Наименование", НаименованиеТекущегоЗначения);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
			
				СтрокаДанных[ИмяПоля] = Выборка.Ссылка;
			
			КонецЕсли; 
		
		КонецЕсли; 
	
	КонецЦикла; 

КонецПроцедуры

&НаКлиенте
Процедура УстановитьНаДату(Команда)
	
	Дата = ЭтаФорма.Период;
	Если ВвестиДату(Дата, "Введите дату", ЧастиДаты.Дата) Тогда
		ЗаписатьИзмененияНаСервере(Дата);
	КонецЕсли;
		
КонецПроцедуры




