&НаКлиенте
Процедура СтрокиСопоставленияПриИзменении(Элемент)
	УстановитьОтборПоСтроке(Элемент.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура СтрокиСопоставленияПередУдалением(Элемент, Отказ)
	
	ПараметрыОтбора = Новый Структура("СтрокаСопоставления", Элементы.СтрокиСопоставления.ТекущиеДанные.Значение);
	НайденныеСтроки = ЭтаФорма.ДанныеСтрокСопоставления.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество() > 0 Тогда 
		
		Если Вопрос("Для данной строки сопоставления существуют записи.
			|Существующие записи будут удалены. Продолжить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да  Тогда
		
			Для каждого СтрокаСопоставления Из НайденныеСтроки Цикл
			
				ЭтаФорма.ДанныеСтрокСопоставления.Удалить(СтрокаСопоставления);
			
			КонецЦикла;
			
		Иначе
			
			Отказ = Истина;
		
		КонецЕсли; 
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СтрокиСопоставленияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.Источник) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать источник сопоставления", , "Источник", , Отказ);
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.Период) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо указать дату начала действия сопоставления", , "Период", , Отказ);
	КонецЕсли; 
	
	Если Копирование Тогда
		
		Отказ = Истина;
		НомерНовойСтроки = Элементы.СтрокиСопоставления.ТекущиеДанные.Значение + 1;
		Если ВвестиЧисло(НомерНовойСтроки, "Введите номер новой строки", 5, 0) Тогда
		
			ПараметрыОтбора = Новый Структура("СтрокаСопоставления", Элементы.СтрокиСопоставления.ТекущиеДанные.Значение);
			НайденныеСтроки = ЭтаФорма.ДанныеСтрокСопоставления.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				Если Вопрос("Скопировать стстав шкал из текущей строки?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да  Тогда
				
					Для каждого СтрокаСопоставления Из НайденныеСтроки Цикл
						
						НоваяСтрока = ЭтаФорма.ДанныеСтрокСопоставления.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСопоставления, , "СтрокаСопоставления, ЗначениеМинимальное, ЗначениеМаксимальное");
						НоваяСтрока.СтрокаСопоставления = НомерНовойСтроки;
										
					КонецЦикла;
				
				КонецЕсли; 
				
			КонецЕсли;
			
			НоваяСтрока = ЭтаФорма.СтрокиСопоставления.Добавить(НомерНовойСтроки);
			Элементы.СтрокиСопоставления.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
		
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокиСопоставленияПриАктивизацииСтроки(Элемент)
	УстановитьОтборПоСтроке(Элемент.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура СтрокиСопоставленияЗначениеОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	КоличествоНайденных = 0;
	Для каждого СтрокаСопоставления Из ЭтаФорма.СтрокиСопоставления Цикл
	
		Если СтрокаСопоставления.Значение = Число(Текст) Тогда
		
			КоличествоНайденных = КоличествоНайденных + 1;
		
		КонецЕсли; 
	
	КонецЦикла;
	
	Если КоличествоНайденных > 0 Тогда
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Строка с номером " + Текст + " уже существует.", , "СтрокиСопоставления");
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.Добавить(0);
		СтандартнаяОбработка = Ложь;
		Возврат;
	
	КонецЕсли; 
	
	ПараметрыОтбора = Новый Структура("СтрокаСопоставления", Элементы.СтрокиСопоставления.ТекущиеДанные.Значение);
	НайденныеСтроки = ЭтаФорма.ДанныеСтрокСопоставления.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(1, "Удалить");
		Кнопки.Добавить(2, "Изменить");
		Кнопки.Добавить(3, "Отмена");
		Ответ = Вопрос("Для данной строки сопоставления существуют записи. 
			|Удалить существующие записи или изменить номер строки на новый?", Кнопки, , 1);
		Если Ответ = 1 Тогда
		
			 Для каждого СтрокаСопоставления Из НайденныеСтроки Цикл
			
				ЭтаФорма.ДанныеСтрокСопоставления.Удалить(СтрокаСопоставления);
			
			КонецЦикла;
			
		ИначеЕсли Ответ = 2 Тогда 
			
			Для каждого СтрокаСопоставления Из НайденныеСтроки Цикл
			
				СтрокаСопоставления.СтрокаСопоставления = Текст;
			
			КонецЦикла;
			
		Иначе
			
			ДанныеВыбора = Новый СписокЗначений;
			ДанныеВыбора.Добавить(Элементы.СтрокиСопоставления.ТекущиеДанные.Значение);
			СтандартнаяОбработка = Ложь;
		
		КонецЕсли; 
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеСтрокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Элементы.СтрокиСопоставления.ТекущиеДанные = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать строку сопоставления", , "СтрокиСопоставления", , Отказ);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ДанныеСтрокПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.СтрокаСопоставления = Элементы.СтрокиСопоставления.ТекущиеДанные.Значение;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеСтрокСопоставленияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
	
		Если ВыбранноеЗначение.ДобавитьВоВсеСтрокиСопоставления Тогда
		
			Для каждого Строка Из ЭтаФорма.СтрокиСопоставления Цикл
			
				ДобавитьСтрокиСопоставления(ВыбранноеЗначение, Строка.Значение);
			
			КонецЦикла; 
			
		Иначе 
			
			 ДобавитьСтрокиСопоставления(ВыбранноеЗначение, Элементы.СтрокиСопоставления.ТекущиеДанные.Значение);
		
		КонецЕсли; 
		
		ЭтаФорма.Модифицированность = Истина;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеСтрокСопоставленияПриАктивизацииЯчейки(Элемент)
	
	Если Не Элементы.Найти("ДанныеСтрокСопоставленияЗаполнитьЗначенияПоНаименованию") = Неопределено Тогда
	
		Если Элемент.ТекущийЭлемент.Имя = "ЗначениеМинимальное" ИЛИ 
			Элемент.ТекущийЭлемент.Имя = "ЗначениеМаксимальное" Тогда
		
			Элементы.ДанныеСтрокСопоставленияЗаполнитьЗначенияПоНаименованию.Доступность = Истина;
			
		Иначе
			
			Элементы.ДанныеСтрокСопоставленияЗаполнитьЗначенияПоНаименованию.Доступность = Ложь;		
		
		КонецЕсли; 
	
	КонецЕсли; 
	
КонецПроцедуры


