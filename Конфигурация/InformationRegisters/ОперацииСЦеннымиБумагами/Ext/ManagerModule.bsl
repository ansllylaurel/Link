Функция ПолучитьОписаниеТаблицыПлановыхОпераций() Экспорт

	ТаблицаПлановыхОпераций = Новый ТаблицаЗначений;
	МетаданныеОпераций = Метаданные.РегистрыСведений.ОперацииСЦеннымиБумагами;
	
	ТаблицаПлановыхОпераций.Колонки.Добавить("Период", 			Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТаблицаПлановыхОпераций.Колонки.Добавить("МоментВремени", 	Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТаблицаПлановыхОпераций.Колонки.Добавить("УчетныйАктивЕПС", Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
	ТаблицаПлановыхОпераций.Колонки.Добавить("Регистратор", 	МетаданныеОпераций.СтандартныеРеквизиты.Регистратор.Тип);
	ТаблицаПлановыхОпераций.Колонки.Добавить("Партия",		 	Метаданные.ОпределяемыеТипы.Партия.Тип);
	ТаблицаПлановыхОпераций.Колонки.Добавить("СтрокаПартии", 	МетаданныеОпераций.Измерения.СтрокаПартии.Тип);
	ТаблицаПлановыхОпераций.Колонки.Добавить("ЧастьСделкиРЕПО",	МетаданныеОпераций.Измерения.ЧастьСделкиРЕПО.Тип);
	ТаблицаПлановыхОпераций.Колонки.Добавить("ВидДвижения",		МетаданныеОпераций.Измерения.ВидДвижения.Тип);
	ТаблицаПлановыхОпераций.Колонки.Добавить("Рынок", 			МетаданныеОпераций.Измерения.Рынок.Тип);
	ТаблицаПлановыхОпераций.Колонки.Добавить("ЦеннаяБумага", 	МетаданныеОпераций.Измерения.ЦеннаяБумага.Тип);
	ТаблицаПлановыхОпераций.Колонки.Добавить("ВалютаСделки",	МетаданныеОпераций.Измерения.Валюта.Тип);
	ТаблицаПлановыхОпераций.Колонки.Добавить("Основание",		МетаданныеОпераций.Измерения.Основание.Тип);
	ТаблицаПлановыхОпераций.Колонки.Добавить("Количество", 		МетаданныеОпераций.Ресурсы.Количество.Тип);
	ТаблицаПлановыхОпераций.Колонки.Добавить("ДатаПоставки", 	МетаданныеОпераций.Ресурсы.ДатаПоставки.Тип);
	ТаблицаПлановыхОпераций.Колонки.Добавить("ДатаОплаты", 		МетаданныеОпераций.Ресурсы.ДатаОплаты.Тип);
	
	ТаблицаПлановыхОпераций.Колонки.Добавить("СуммаНаОднуОблигацию", 	МетаданныеОпераций.Ресурсы.Сумма.Тип);
	ТаблицаПлановыхОпераций.Колонки.Добавить("ДатаФиксации", 			Новый ОписаниеТипов("Дата"));
	ТаблицаПлановыхОпераций.Колонки.Добавить("ВидПогашения", 			Новый ОписаниеТипов("ПеречислениеСсылка.ВидыПогашения"));
	ТаблицаПлановыхОпераций.Колонки.Добавить("Сумма", 					МетаданныеОпераций.Ресурсы.Сумма.Тип);
	ТаблицаПлановыхОпераций.Колонки.Добавить("СуммаКупона", 			МетаданныеОпераций.Ресурсы.СуммаКупона.Тип);
		
	Возврат ТаблицаПлановыхОпераций;

КонецФункции
 
Процедура ПолучитьПлановыеСделки(Запрос)

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоЦеннымБумагамОстатки.Основание.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|			ТОГДА ЗНАЧЕНИЕ(Документ.ПоставкаЦенныхБумаг.ПустаяСсылка)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Документ.ИсполнениеОбязательствПоСделке.ПустаяСсылка)
		|	КОНЕЦ КАК Регистратор,
		|	ЗадолженностиПоЦеннымБумагамОстатки.Основание КАК Основание,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|	КОНЕЦ КАК ВидДвижения,
		|	ЗадолженностиПоЦеннымБумагамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоЦеннымБумагамОстатки.Рынок КАК Рынок,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЗадолженностиПоЦеннымБумагамОстатки.Валюта КАК Валюта,
		|	ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.СуммаОстаток КАК СуммаОстаток,
		|	ЗадолженностиПоЦеннымБумагамОстатки.СуммаКупонаОстаток КАК СуммаКупонаОстаток
		|ПОМЕСТИТЬ _ЗадолженностиПоСедлкам
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
		|			&грКонецПериода,
		|			ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЗадолженностиПоЦеннымБумагамОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗНАЧЕНИЕ(Документ.СделкаРепо.ПустаяСсылка) КАК Регистратор,
		|	ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО КАК Основание,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|	КОНЕЦ КАК ВидДвижения,
		|	ЗадолженностиПоВторойЧастиРЕПООстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоВторойЧастиРЕПООстатки.Рынок КАК Рынок,
		|	ЗадолженностиПоВторойЧастиРЕПООстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЗадолженностиПоВторойЧастиРЕПООстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	ЗадолженностиПоВторойЧастиРЕПООстатки.Валюта КАК Валюта,
		|	2 КАК ЧастьСделкиРЕПО,
		|	ЗадолженностиПоВторойЧастиРЕПООстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоВторойЧастиРЕПООстатки.СуммаОстаток КАК СуммаОстаток,
		|	ЗадолженностиПоВторойЧастиРЕПООстатки.СуммаКупонаОстаток КАК СуммаКупонаОстаток,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО) КАК ВидЗадолженности
		|ПОМЕСТИТЬ _ЗадолженностиПоСедлкамРЕПО
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.Остатки(
		|			&грКонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЗадолженностиПоВторойЧастиРЕПООстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Документ.ПоставкаЦенныхБумаг.ПустаяСсылка),
		|	ЗадолженностиПоЦеннымБумагамОстатки.Основание,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|	КОНЕЦ,
		|	ЗадолженностиПоЦеннымБумагамОстатки.СчетДоверительногоУправления,
		|	ЗадолженностиПоЦеннымБумагамОстатки.Рынок,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага,
		|	ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток,
		|	ЗадолженностиПоЦеннымБумагамОстатки.Валюта,
		|	0,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.СуммаОстаток,
		|	ЗадолженностиПоЦеннымБумагамОстатки.СуммаКупонаОстаток,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
		|			&грКонецПериода,
		|			ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЗадолженностиПоЦеннымБумагамОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоЦеннымБумагамОстатки.Основание.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|			ТОГДА ЗНАЧЕНИЕ(Документ.ПоставкаЦенныхБумаг.ПустаяСсылка)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Документ.ИсполнениеОбязательствПоСделке.ПустаяСсылка)
		|	КОНЕЦ,
		|	ЗадолженностиПоЦеннымБумагамОстатки.Основание,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|	КОНЕЦ,
		|	ЗадолженностиПоЦеннымБумагамОстатки.СчетДоверительногоУправления,
		|	ЗадолженностиПоЦеннымБумагамОстатки.Рынок,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага,
		|	ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток,
		|	ЗадолженностиПоЦеннымБумагамОстатки.Валюта,
		|	1,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.СуммаОстаток,
		|	ЗадолженностиПоЦеннымБумагамОстатки.СуммаКупонаОстаток,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
		|			&грКонецПериода,
		|			ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО)
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЗадолженностиПоЦеннымБумагамОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияСделокСрезПоследних.ДатаПоставки КАК Период,
		|	_ЗадолженностиПоСедлкам.Регистратор КАК Регистратор,
		|	НЕОПРЕДЕЛЕНО КАК ЧастьСделкиРЕПО,
		|	_ЗадолженностиПоСедлкам.ВидДвижения КАК ВидДвижения,
		|	_ЗадолженностиПоСедлкам.Рынок КАК Рынок,
		|	_ЗадолженностиПоСедлкам.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ЗадолженностиПоСедлкам.Валюта КАК ВалютаСделки,
		|	_ЗадолженностиПоСедлкам.Основание КАК Основание,
		|	_ЗадолженностиПоСедлкам.КоличествоОстаток КАК Количество,
		|	УсловияСделокСрезПоследних.ДатаПоставки КАК ДатаПоставки,
		|	УсловияСделокСрезПоследних.ДатаОплаты КАК ДатаОплаты,
		|	_ЗадолженностиПоСедлкам.ТипЗадолженности КАК ТипЗадолженности,
		|	_ЗадолженностиПоСедлкам.ВидЗадолженности КАК ВидЗадолженности,
		|	_ЗадолженностиПоСедлкам.СуммаОстаток КАК СуммаОстаток,
		|	_ЗадолженностиПоСедлкам.СуммаКупонаОстаток КАК СуммаКупонаОстаток,
		|	СделкаДокумент.Контрагент КАК Контрагент,
		|	СделкаДокумент.МестоХранения КАК МестоХранения,
		|	СделкаДокумент.Брокер КАК Брокер,
		|	СделкаДокумент.РасчетныйСчет КАК РасчетныйСчет,
		|	УсловияСделокСрезПоследних.РаздельноеИсполнение КАК РаздельноеИсполнение,
		|	УсловияСделокСрезПоследних.ОтложенноеИсполнение КАК ОтложенноеИсполнение
		|ПОМЕСТИТЬ _ПлановыеСделки
		|ИЗ
		|	_ЗадолженностиПоСедлкам КАК _ЗадолженностиПоСедлкам
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделок.СрезПоследних(
		|				&КонецПериода,
		|				Организация = &Организация
		|					И Сделка В
		|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|							_ЗадолженностиПоСедлкам.Основание
		|						ИЗ
		|							_ЗадолженностиПоСедлкам)) КАК УсловияСделокСрезПоследних
		|		ПО _ЗадолженностиПоСедлкам.Основание = УсловияСделокСрезПоследних.Сделка
		|			И _ЗадолженностиПоСедлкам.Рынок = УсловияСделокСрезПоследних.Рынок
		|			И _ЗадолженностиПоСедлкам.ЦеннаяБумага = УсловияСделокСрезПоследних.ЦеннаяБумага
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК СделкаДокумент
		|		ПО _ЗадолженностиПоСедлкам.Основание = СделкаДокумент.Ссылка
		|ГДЕ
		|	УсловияСделокСрезПоследних.ДатаПоставки < &КонецПериода
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	УсловияСделокСрезПоследних.ДатаПоставки,
		|	_ЗадолженностиПоСедлкамРЕПО.Регистратор,
		|	_ЗадолженностиПоСедлкамРЕПО.ЧастьСделкиРЕПО,
		|	_ЗадолженностиПоСедлкамРЕПО.ВидДвижения,
		|	_ЗадолженностиПоСедлкамРЕПО.Рынок,
		|	_ЗадолженностиПоСедлкамРЕПО.ЦеннаяБумага,
		|	_ЗадолженностиПоСедлкамРЕПО.Валюта,
		|	_ЗадолженностиПоСедлкамРЕПО.Основание,
		|	_ЗадолженностиПоСедлкамРЕПО.КоличествоОстаток,
		|	УсловияСделокСрезПоследних.ДатаПоставки,
		|	УсловияСделокСрезПоследних.ДатаОплаты,
		|	_ЗадолженностиПоСедлкамРЕПО.ТипЗадолженности,
		|	_ЗадолженностиПоСедлкамРЕПО.ВидЗадолженности,
		|	_ЗадолженностиПоСедлкамРЕПО.СуммаОстаток,
		|	_ЗадолженностиПоСедлкамРЕПО.СуммаКупонаОстаток,
		|	СделкаРЕПОДокумент.Контрагент,
		|	СделкаРЕПОДокумент.МестоХранения,
		|	СделкаРЕПОДокумент.Брокер,
		|	СделкаРЕПОДокумент.РасчетныйСчет,
		|	УсловияСделокСрезПоследних.РаздельноеИсполнение,
		|	УсловияСделокСрезПоследних.ОтложенноеИсполнение
		|ИЗ
		|	_ЗадолженностиПоСедлкамРЕПО КАК _ЗадолженностиПоСедлкамРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|				&КонецПериода,
		|				Организация = &Организация
		|					И ЧастьСделкиРЕПО = 2
		|					И СделкаРЕПО В
		|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
