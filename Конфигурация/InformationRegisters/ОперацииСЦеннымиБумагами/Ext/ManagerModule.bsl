
Процедура ПолучитьТаблицуПлановыхОпераций(Параметры, МенеджерВременныхТаблиц) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("грКонецПериода", 				Новый Граница(КонецДня(Параметры.Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонецПериода", 					КонецДня(Параметры.Период));
	Запрос.УстановитьПараметр("ТекущаяДата", 					НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("НачДатаСФиксациями", 			ДобавитьМесяц(ТекущаяДатаСеанса(), -1));
	Запрос.УстановитьПараметр("Организация", 					Параметры.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	Параметры.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ТипыОферт", 						Параметры.ТипыОферт);
	Запрос.УстановитьПараметр("ВсеТипыОферт", 					Параметры.ТипыОферт = Неопределено);
	
	Запрос.УстановитьПараметр("БрокерЦенныеБумаги", 			Параметры.БрокерЦенныеБумаги);
	Запрос.УстановитьПараметр("РасчетныйСчетЦенныеБумаги", 		Параметры.РасчетныйСчетЦенныеБумаги);
	
	ПолучитьПлановыеСделки(Запрос);
	ПолучитьПлановыеКупоныОфертыИПогашения(Запрос, Параметры);
	ПолучитьЗадолженностиПоДСКПогашению(Запрос);
	ПолучитьЗакрытыеДепозиты(Запрос);
	ПолучитьЗакрытыеМНО(Запрос);
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.Валюта КАК Валюта,
		|	НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.Брокер КАК Брокер,
		|	НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.РасчетныйСчет КАК РасчетныйСчет
		|ПОМЕСТИТЬ _НастройкиУчетаДоходовПоЦБ
		|ИЗ
		|	РегистрСведений.НастройкиУчетаДоходовПоЦеннымБумагам.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА _ПлановыеСделки.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА ВЫБОР
		|					КОГДА _ПлановыеСделки.ЧастьСделкиРЕПО = НЕОПРЕДЕЛЕНО
		|						ТОГДА ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(_ПлановыеСделки.Период, ДЕНЬ), МИНУТА, -9)
		|					ИНАЧЕ ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(_ПлановыеСделки.Период, ДЕНЬ), МИНУТА, -8)
		|				КОНЕЦ
		|		ИНАЧЕ ВЫБОР
		|				КОГДА _ПлановыеСделки.ЧастьСделкиРЕПО = НЕОПРЕДЕЛЕНО
		|					ТОГДА ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(_ПлановыеСделки.Период, ДЕНЬ), МИНУТА, -7)
		|				ИНАЧЕ ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(_ПлановыеСделки.Период, ДЕНЬ), МИНУТА, -6)
		|			КОНЕЦ
		|	КОНЕЦ КАК Период,
		|	_ПлановыеСделки.Регистратор КАК Регистратор,
		|	_ПлановыеСделки.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
		|	_ПлановыеСделки.ВидДвижения КАК ВидДвижения,
		|	_ПлановыеСделки.Рынок КАК Рынок,
		|	_ПлановыеСделки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ПлановыеСделки.ВалютаСделки КАК ВалютаСделки,
		|	_ПлановыеСделки.Основание КАК Основание,
		|	_ПлановыеСделки.Количество КАК Количество,
		|	_ПлановыеСделки.ДатаПоставки КАК ДатаПоставки,
		|	_ПлановыеСделки.ДатаОплаты КАК ДатаОплаты,
		|	НЕОПРЕДЕЛЕНО КАК СуммаНаОднуОблигацию,
		|	НЕОПРЕДЕЛЕНО КАК ДатаФиксации,
		|	НЕОПРЕДЕЛЕНО КАК ВидПогашения,
		|	_ПлановыеСделки.СуммаОстаток КАК Сумма,
		|	_ПлановыеСделки.СуммаКупонаОстаток КАК СуммаКупона,
		|	НЕОПРЕДЕЛЕНО КАК КоличествоВРЕПОКупон,
		|	НЕОПРЕДЕЛЕНО КАК КоличествоПоРЕПОКупон,
		|	НЕОПРЕДЕЛЕНО КАК ВалютаНоминала,
		|	НЕОПРЕДЕЛЕНО КАК ТипОферты,
		|	ИСТИНА КАК ПлановыеДанные,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК МоментВремени,
		|	_ПлановыеСделки.ТипЗадолженности КАК ТипЗадолженности,
		|	_ПлановыеСделки.ВидЗадолженности КАК ВидЗадолженности,
		|	_ПлановыеСделки.Контрагент КАК Контрагент,
		|	_ПлановыеСделки.МестоХранения КАК МестоХранения,
		|	_ПлановыеСделки.Брокер КАК Брокер,
		|	_ПлановыеСделки.РасчетныйСчет КАК РасчетныйСчет,
		|	0 КАК СтрокаПартии,
		|	_ПлановыеСделки.РаздельноеИсполнение КАК РаздельноеИсполнение,
		|	_ПлановыеСделки.ОтложенноеИсполнение КАК ОтложенноеИсполнение,
		|	_ПлановыеСделки.Регистратор КАК Партия
		|ПОМЕСТИТЬ _ПлановыеДанные_Операции
		|ИЗ
		|	_ПлановыеСделки КАК _ПлановыеСделки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(_ПлановыеКупоны.Период, ДЕНЬ), МИНУТА, -5),
		|	_ПлановыеКупоны.Регистратор,
		|	НЕОПРЕДЕЛЕНО,
		|	_ПлановыеКупоны.ВидДвижения,
		|	_ПлановыеКупоны.Рынок,
		|	_ПлановыеКупоны.ЦеннаяБумага,
		|	NULL,
		|	НЕОПРЕДЕЛЕНО,
		|	СУММА(_ПлановыеКупоны.Количество),
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	_ПлановыеКупоны.СуммаНаОднуОблигацию,
		|	_ПлановыеКупоны.ДатаФиксации,
		|	НЕОПРЕДЕЛЕНО,
		|	NULL,
		|	СУММА(_ПлановыеКупоны.СуммаНаОднуОблигацию * _ПлановыеКупоны.Количество),
		|	СУММА(_ПлановыеКупоны.КоличествоВРЕПОКупон),
		|	СУММА(_ПлановыеКупоны.КоличествоПоРЕПОКупон),
		|	_ПлановыеКупоны.ВалютаНоминала,
		|	НЕОПРЕДЕЛЕНО,
		|	ИСТИНА,
		|	ДАТАВРЕМЯ(1, 1, 1),
		|	ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская),
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона),
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	0,
		|	NULL,
		|	NULL,
		|	_ПлановыеКупоны.Регистратор
		|ИЗ
		|	_ПлановыеКупоны КАК _ПлановыеКупоны
		|
		|СГРУППИРОВАТЬ ПО
		|	_ПлановыеКупоны.СуммаНаОднуОблигацию,
		|	_ПлановыеКупоны.ДатаФиксации,
		|	_ПлановыеКупоны.ВидДвижения,
		|	_ПлановыеКупоны.Рынок,
		|	_ПлановыеКупоны.ЦеннаяБумага,
		|	ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(_ПлановыеКупоны.Период, ДЕНЬ), МИНУТА, -5),
		|	_ПлановыеКупоны.ВалютаНоминала,
		|	_ПлановыеКупоны.Регистратор,
		|	_ПлановыеКупоны.Регистратор
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(_ПлановыеОферты.Период, ДЕНЬ), МИНУТА, -4),
		|	_ПлановыеОферты.Регистратор,
		|	НЕОПРЕДЕЛЕНО,
		|	_ПлановыеОферты.ВидДвижения,
		|	_ПлановыеОферты.Рынок,
		|	_ПлановыеОферты.Облигация,
		|	NULL,
		|	НЕОПРЕДЕЛЕНО,
		|	_ПлановыеОферты.КоличествоОстаток,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	_ПлановыеОферты.Цена,
		|	НЕОПРЕДЕЛЕНО,
		|	_ПлановыеОферты.ВидПогашения,
		|	NULL,
		|	NULL,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	_ПлановыеОферты.ВалютаНоминала,
		|	_ПлановыеОферты.ТипОферты,
		|	ИСТИНА,
		|	ДАТАВРЕМЯ(1, 1, 1),
		|	ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская),
		|	ВЫБОР
		|		КОГДА _ПлановыеОферты.Регистратор = ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка)
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации)
		|	КОНЕЦ,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	0,
		|	NULL,
		|	NULL,
		|	_ПлановыеОферты.Регистратор
		|ИЗ
		|	_ПлановыеОферты КАК _ПлановыеОферты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(_ПлановыеПогашения.Период, ДЕНЬ), МИНУТА, -3),
		|	_ПлановыеПогашения.Регистратор,
		|	НЕОПРЕДЕЛЕНО,
		|	_ПлановыеПогашения.ВидДвижения,
		|	_ПлановыеПогашения.Рынок,
		|	_ПлановыеПогашения.ЦеннаяБумага,
		|	NULL,
		|	НЕОПРЕДЕЛЕНО,
		|	_ПлановыеПогашения.КоличествоОстатокОблигации,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	_ПлановыеПогашения.СуммаИзмененияНоминалаОблигации,
		|	НЕОПРЕДЕЛЕНО,
		|	_ПлановыеПогашения.ВидПогашения,
		|	_ПлановыеПогашения.ОжидаемаяСуммаОблигации,
		|	NULL,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	_ПлановыеПогашения.ВалютаНоминала,
		|	НЕОПРЕДЕЛЕНО,
		|	ИСТИНА,
		|	ДАТАВРЕМЯ(1, 1, 1),
		|	ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская),
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации),
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	0,
		|	NULL,
		|	NULL,
		|	_ПлановыеПогашения.Регистратор
		|ИЗ
		|	_ПлановыеПогашения КАК _ПлановыеПогашения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗадолженностиПоДСКПогашению.Основание КАК Основание,
		|	_ЗадолженностиПоДСКПогашению.ТипЗадолженности КАК ТипЗадолженности,
		|	_ЗадолженностиПоДСКПогашению.ВидЗадолженности КАК ВидЗадолженности,
		|	_ЗадолженностиПоДСКПогашению.ВалютаСделки КАК Валюта,
		|	_ЗадолженностиПоДСКПогашению.Контрагент КАК Контрагент,
		|	ЛОЖЬ КАК Аванс,
		|	-_ЗадолженностиПоДСКПогашению.Сумма КАК Сумма,
		|	-_ЗадолженностиПоДСКПогашению.СуммаКупона КАК СуммаКупона
		|ПОМЕСТИТЬ _ПлановыеДанные_ЗадолженностиПоДС
		|ИЗ
		|	_ЗадолженностиПоДСКПогашению КАК _ЗадолженностиПоДСКПогашению
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ПлановыеСделки.Регистратор,
		|	_ПлановыеСделки.ТипЗадолженности,
		|	_ПлановыеСделки.ВидЗадолженности,
		|	_ПлановыеСделки.ВалютаСделки,
		|	_ПлановыеСделки.Контрагент,
		|	ЛОЖЬ,
		|	ВЫБОР
		|		КОГДА _ПлановыеСделки.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА -1
		|		ИНАЧЕ 1
		|	КОНЕЦ * _ПлановыеСделки.СуммаОстаток,
		|	ВЫБОР
		|		КОГДА _ПлановыеСделки.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА -1
		|		ИНАЧЕ 1
		|	КОНЕЦ * _ПлановыеСделки.СуммаКупонаОстаток
		|ИЗ
		|	_ПлановыеСделки КАК _ПлановыеСделки
		|ГДЕ
		|	_ПлановыеСделки.ЧастьСделкиРЕПО = 2
		|	И НЕ(_ПлановыеСделки.ДатаОплаты МЕЖДУ &ТекущаяДата И &КонецПериода)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер, ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)) КАК Брокер,
		|	ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка) КАК МестоХранения,
		|	ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка) КАК РасчетныйСчет,
		|	_ПлановыеОферты.ВалютаНоминала КАК Валюта,
		|	_ПлановыеОферты.КоличествоОстаток * (_ПлановыеОферты.Цена + ЕСТЬNULL(_Купоны.Купон, 0)) КАК Сумма
		|ПОМЕСТИТЬ _ПлановыеДанные_ОстаткиДС
		|ИЗ
		|	_ПлановыеОферты КАК _ПлановыеОферты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|			ПО Облигации.Эмитент = Эмитенты.Ссылка
		|		ПО _ПлановыеОферты.Облигация = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|				&КонецПериода,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&КонецПериода, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|			ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания)
		|		ПО (КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ОсновнойБрокер)
		|			И (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|				ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &КонецПериода)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Купоны КАК _Купоны
		|		ПО _ПлановыеОферты.Облигация = _Купоны.Облигация
		|ГДЕ
		|	(_ПлановыеОферты.ТипОферты = ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.ОфертаПродажа)
