		|
		|ВЫБРАТЬ
		|	_ОстаткиОблигаций.ДатаПогашения,
		|	ЗНАЧЕНИЕ(Документ.ПогашениеЦеннойБумаги.ПустаяСсылка),
		|	ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации),
		|	_ОстаткиОблигаций.Облигация,
		|	СУММА(_ОстаткиОблигаций.КоличествоОстаток),
		|	ВложенныйЗапрос.Номинал,
		|	СУММА(_ОстаткиОблигаций.КоличествоОстаток * ВложенныйЗапрос.Номинал),
		|	ЗНАЧЕНИЕ(Перечисление.ВидыПогашения.ПолноеПогашение),
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход),
		|	_ОстаткиОблигаций.ВалютаНоминала
		|ИЗ
		|	_ОстаткиОблигаций КАК _ОстаткиОблигаций
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			НоминалыЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|			НоминалыЦенныхБумаг.Номинал КАК Номинал
		|		ИЗ
		|			(ВЫБРАТЬ
		|				НоминалыЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|				МАКСИМУМ(НоминалыЦенныхБумаг.Период) КАК Период
		|			ИЗ
		|				_ОстаткиОблигаций КАК _ОстаткиОблигаций
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|					ПО _ОстаткиОблигаций.Облигация = НоминалыЦенныхБумаг.ЦеннаяБумага
		|						И _ОстаткиОблигаций.ДатаПогашения >= НоминалыЦенныхБумаг.Период
		|			
		|			СГРУППИРОВАТЬ ПО
		|				НоминалыЦенныхБумаг.ЦеннаяБумага) КАК ВложенныйЗапрос
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|				ПО ВложенныйЗапрос.ЦеннаяБумага = НоминалыЦенныхБумаг.ЦеннаяБумага
		|					И ВложенныйЗапрос.Период = НоминалыЦенныхБумаг.Период) КАК ВложенныйЗапрос
		|		ПО _ОстаткиОблигаций.Облигация = ВложенныйЗапрос.ЦеннаяБумага
		|			И (_ОстаткиОблигаций.Период <= _ОстаткиОблигаций.ДатаПогашения)
		|ГДЕ
		|	_ОстаткиОблигаций.ДатаПогашения МЕЖДУ &ТекущаяДата И &КонецПериода
		|
		|СГРУППИРОВАТЬ ПО
		|	_ОстаткиОблигаций.Облигация,
		|	ВложенныйЗапрос.Номинал,
		|	_ОстаткиОблигаций.ДатаПогашения,
		|	_ОстаткиОблигаций.ВалютаНоминала
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияОферт.ДатаВыкупа КАК Период,
		|	ВЫБОР
		|		КОГДА УсловияОферт.ТипОферты = ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.ОфертаПокупка)
		|				ИЛИ УсловияОферт.ТипОферты = ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.Досрочно)
		|			ТОГДА ЗНАЧЕНИЕ(Документ.ПогашениеЦеннойБумаги.ПустаяСсылка)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка)
		|	КОНЕЦ КАК Регистратор,
		|	ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации) КАК Рынок,
		|	_ОстаткиОблигаций.Облигация КАК Облигация,
		|	_ОстаткиОблигаций.КоличествоОстаток КАК КоличествоОстаток,
		|	УсловияОферт.ТипОферты КАК ТипОферты,
		|	УсловияОферт.Цена КАК Цена,
		|	_ОстаткиОблигаций.ВалютаНоминала КАК ВалютаНоминала,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход) КАК ВидДвижения,
		|	ВЫБОР
		|		КОГДА УсловияОферт.ТипОферты = ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.ОфертаПокупка)
		|				ИЛИ УсловияОферт.ТипОферты = ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.Досрочно)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыПогашения.Оферта)
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК ВидПогашения
		|ПОМЕСТИТЬ _ПлановыеОферты
		|ИЗ
		|	_ОстаткиОблигаций КАК _ОстаткиОблигаций
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияОферт КАК УсловияОферт
		|		ПО _ОстаткиОблигаций.Облигация = УсловияОферт.Облигация
		|			И (НЕ УсловияОферт.ТолькоДляФизическихЛиц)
		|			И (УсловияОферт.ДатаВыкупа МЕЖДУ &ТекущаяДата И &КонецПериода)
		|			И (_ОстаткиОблигаций.Период <= КОНЕЦПЕРИОДА(УсловияОферт.ДатаВыкупа, ДЕНЬ))
		|			И (&ВсеТипыОферт
		|				ИЛИ УсловияОферт.ТипОферты В (&ТипыОферт))";
	
	Запрос.Выполнить();
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ПлановыеОферты.Облигация КАК Облигация
		|ИЗ
		|	_ПлановыеОферты КАК _ПлановыеОферты
		|ГДЕ
		|	(_ПлановыеОферты.ТипОферты = ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.ОфертаПродажа)
		|			ИЛИ _ПлановыеОферты.ТипОферты = ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.ДопОферта))";
	
	Облигации = Запрос.Выполнить().Выгрузить();
	Облигации.Колонки.Добавить("Купон", Метаданные.РегистрыСведений.КотировкиТорговыхПлощадок.Ресурсы.ACCINT.Тип);
	
	Для каждого СтрокаОблигаций Из Облигации Цикл
		СтрокаОблигаций.Купон = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(
			СтрокаОблигаций.Облигация, 
			НачалоДня(Параметры.Период), 
			Параметры.СчетДоверительногоУправления);
	КонецЦикла;
	
	Запрос.УстановитьПараметр("Купоны", Облигации);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Купоны.Облигация КАК Облигация,
		|	Купоны.Купон КАК Купон
		|ПОМЕСТИТЬ _Купоны
		|ИЗ
		|	&Купоны КАК Купоны";
	
	Запрос.Выполнить();

КонецПроцедуры
 
Процедура ПолучитьЗадолженностиПоДСКПогашению(Запрос)

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК СуммаОстаток,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК СуммаКупонаОстаток
		|ПОМЕСТИТЬ _ЗадолженностиПоДС
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			&грКонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И НЕ Аванс) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗадолженностиПоДС.ТипЗадолженности КАК ТипЗадолженности,
		|	_ЗадолженностиПоДС.ВидЗадолженности КАК ВидЗадолженности,
		|	_ЗадолженностиПоДС.Валюта КАК ВалютаСделки,
		|	_ЗадолженностиПоДС.Основание КАК Основание,
		|	_ЗадолженностиПоДС.СуммаОстаток КАК Сумма,
		|	_ЗадолженностиПоДС.СуммаКупонаОстаток КАК СуммаКупона,
		|	_ЗадолженностиПоДС.Контрагент КАК Контрагент
		|ПОМЕСТИТЬ _ЗадолженностиПоДСКПогашению
		|ИЗ
		|	_ЗадолженностиПоДС КАК _ЗадолженностиПоДС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
		|		ПО _ЗадолженностиПоДС.Основание = НачислениеЗадолженности.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыеДатыОплат КАК ПлановыеДатыОплат
		|		ПО (ПлановыеДатыОплат.Организация = &Организация)
		|			И (ПлановыеДатыОплат.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|			И _ЗадолженностиПоДС.Основание = ПлановыеДатыОплат.Основание
		|			И _ЗадолженностиПоДС.ВидЗадолженности = ПлановыеДатыОплат.ВидЗадолженности
		|			И (ПлановыеДатыОплат.ДатаОплаты МЕЖДУ &ТекущаяДата И &КонецПериода)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_ЗадолженностиПоДС.ТипЗадолженности,
		|	_ЗадолженностиПоДС.ВидЗадолженности,
		|	_ЗадолженностиПоДС.Валюта,
		|	_ЗадолженностиПоДС.Основание,
		|	_ЗадолженностиПоДС.СуммаОстаток,
		|	_ЗадолженностиПоДС.СуммаКупонаОстаток,
		|	_ЗадолженностиПоДС.Контрагент
		|ИЗ
		|	_ЗадолженностиПоДС КАК _ЗадолженностиПоДС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаСВалютой КАК СделкаСВалютой
		|		ПО _ЗадолженностиПоДС.Основание = СделкаСВалютой.Ссылка
		|			И (СделкаСВалютой.ОтложенноеИсполнение
		|				И (СделкаСВалютой.ДатаИсполнения МЕЖДУ &ТекущаяДата И &КонецПериода))
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_ЗадолженностиПоДС.ТипЗадолженности,
		|	_ЗадолженностиПоДС.ВидЗадолженности,
		|	_ЗадолженностиПоДС.Валюта,
		|	_ЗадолженностиПоДС.Основание,
		|	_ЗадолженностиПоДС.СуммаОстаток,
		|	_ЗадолженностиПоДС.СуммаКупонаОстаток,
		|	_ЗадолженностиПоДС.Контрагент
		|ИЗ
		|	_ЗадолженностиПоДС КАК _ЗадолженностиПоДС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделок.СрезПоследних(&КонецПериода, Организация = &Организация) КАК УсловияСделокСрезПоследних
		|		ПО _ЗадолженностиПоДС.Основание = УсловияСделокСрезПоследних.Сделка
		|			И (_ЗадолженностиПоДС.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке))
		|			И (УсловияСделокСрезПоследних.ДатаОплаты МЕЖДУ &ТекущаяДата И &КонецПериода)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_ЗадолженностиПоДС.ТипЗадолженности,
		|	_ЗадолженностиПоДС.ВидЗадолженности,
		|	_ЗадолженностиПоДС.Валюта,
		|	_ЗадолженностиПоДС.Основание,
		|	_ЗадолженностиПоДС.СуммаОстаток,
		|	_ЗадолженностиПоДС.СуммаКупонаОстаток,
		|	_ЗадолженностиПоДС.Контрагент
		|ИЗ
		|	_ЗадолженностиПоДС КАК _ЗадолженностиПоДС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(&КонецПериода, Организация = &Организация) КАК УсловияСделокРЕПОСрезПоследних
		|		ПО _ЗадолженностиПоДС.Основание = УсловияСделокРЕПОСрезПоследних.СделкаРЕПО
		|			И _ЗадолженностиПоДС.ВидЗадолженности = УсловияСделокРЕПОСрезПоследних.ВидЗадолженности
		|			И (УсловияСделокРЕПОСрезПоследних.ДатаОплаты МЕЖДУ &ТекущаяДата И &КонецПериода)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_ЗадолженностиПоДС.ТипЗадолженности,
		|	_ЗадолженностиПоДС.ВидЗадолженности,
		|	_ЗадолженностиПоДС.Валюта,
		|	_ЗадолженностиПоДС.Основание,
		|	_ЗадолженностиПоДС.СуммаОстаток,
		|	_ЗадолженностиПоДС.СуммаКупонаОстаток,
		|	_ЗадолженностиПоДС.Контрагент
		|ИЗ
		|	_ЗадолженностиПоДС КАК _ЗадолженностиПоДС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НачислениеДивидендов КАК НачислениеДивидендов
		|		ПО _ЗадолженностиПоДС.Основание = НачислениеДивидендов.Ссылка
		|			И (НачислениеДивидендов.ДатаОплатыПлановая МЕЖДУ &ТекущаяДата И &КонецПериода)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_ЗадолженностиПоДС.ТипЗадолженности,
		|	_ЗадолженностиПоДС.ВидЗадолженности,
		|	_ЗадолженностиПоДС.Валюта,
		|	_ЗадолженностиПоДС.Основание,
		|	_ЗадолженностиПоДС.СуммаОстаток,
		|	_ЗадолженностиПоДС.СуммаКупонаОстаток,
		|	_ЗадолженностиПоДС.Контрагент
		|ИЗ
		|	_ЗадолженностиПоДС КАК _ЗадолженностиПоДС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПогашениеЦеннойБумаги КАК ПогашениеЦеннойБумаги
		|		ПО _ЗадолженностиПоДС.Основание = ПогашениеЦеннойБумаги.Ссылка
		|			И (ПогашениеЦеннойБумаги.ДатаОплатыПлановая МЕЖДУ &ТекущаяДата И &КонецПериода)";
	Запрос.Выполнить();

КонецПроцедуры
 
Процедура ПолучитьЗакрытыеДепозиты(Запрос)

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
		|	ДенежныеСредстваВКредитныхИнструментахОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент КАК ДепозитныйВклад,
		|	0 КАК Сумма,
		|	БанковскиеСчета.Валюта КАК Валюта,
		|	УсловияКредитныхИнструментовСрезПоследних.РасчетныйСчетВозвратаДенежныхСредств КАК РасчетныйСчет,
		|	ВЫБОР
		|		КОГДА ДепозитныеВклады.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|		ИНАЧЕ ДепозитныеВклады.МестоХранения
		|	КОНЕЦ КАК МестоХранения
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.Остатки(
		|			&грКонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)) КАК ДенежныеСредстваВКредитныхИнструментахОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|			УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
		|			УсловияКредитныхИнструментовСрезПоследних.РасчетныйСчетВозвратаДенежныхСредств КАК РасчетныйСчетВозвратаДенежныхСредств
		|		ИЗ
		|			(ВЫБРАТЬ
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|				МАКСИМУМ(УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
		|			ИЗ
		|				РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&грКонецПериода, ) КАК УсловияКредитныхИнструментовСрезПоследних
		|			ГДЕ
		|				УсловияКредитныхИнструментовСрезПоследних.Действует
		|			
		|			СГРУППИРОВАТЬ ПО
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент) КАК АктуальныеДатыНачалаДействия
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&грКонецПериода, ) КАК УсловияКредитныхИнструментовСрезПоследних
		|				ПО АктуальныеДатыНачалаДействия.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|					И АктуальныеДатыНачалаДействия.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК УсловияКредитныхИнструментовСрезПоследних
		|		ПО ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		|			ПО ДепозитныеВклады.БанковскийСчет = БанковскиеСчета.Ссылка
		|		ПО ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент = ДепозитныеВклады.Ссылка
		|ГДЕ
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения МЕЖДУ &ТекущаяДата И &КонецПериода";
	
	Депозиты = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ТекСтрока Из Депозиты Цикл
		ТекСтрока.Сумма = РаботаСКредитнымиИнструментами.ПолучитьСтоимостьКредитногоИнструмента(ТекСтрока.ДепозитныйВклад, ТекСтрока.ДатаПогашения, ТекСтрока.СчетДоверительногоУправления);
	КонецЦикла; 
	
	Запрос.УстановитьПараметр("ПлановыеДепозиты", Депозиты);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПлановыеДепозиты.МестоХранения КАК МестоХранения,
		|	ПлановыеДепозиты.РасчетныйСчет КАК РасчетныйСчет,
		|	ПлановыеДепозиты.Валюта КАК Валюта,
		|	ПлановыеДепозиты.Сумма КАК Сумма
		|ПОМЕСТИТЬ _ПлановыеДепозиты
		|ИЗ
		|	&ПлановыеДепозиты КАК ПлановыеДепозиты";
	
	Запрос.Выполнить();

КонецПроцедуры
 
Процедура ПолучитьЗакрытыеМНО(Запрос)

	Запрос.УстановитьПараметр("грКонецТекущегоДня", Новый Граница(КонецДня(Запрос.Параметры.ТекущаяДата), ВидГраницы.Включая));
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДенежныеСредстваМНООстатки.МНО КАК МНО,
		|	ДенежныеСредстваМНООстатки.РасчетныйСчет КАК РасчетныйСчет,
		|	БанковскиеСчета.Валюта КАК Валюта,
		|	0 КАК СуммаПроцентов,
		|	ДокументМНО.ДатаВозврата КАК ДатаВозврата,
		|	ДокументМНО.Дата КАК Дата,
		|	ДокументМНО.Сумма КАК Сумма,
		|	ДокументМНО.Процент КАК Процент
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваМНО.Остатки(
		|			&грКонецТекущегоДня,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ДенежныеСредстваМНООстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.МНО КАК ДокументМНО
		|		ПО ДенежныеСредстваМНООстатки.МНО = ДокументМНО.Ссылка
		|			И (ДокументМНО.ДатаВозврата МЕЖДУ &ТекущаяДата И &КонецПериода)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		|		ПО ДенежныеСредстваМНООстатки.РасчетныйСчет = БанковскиеСчета.Ссылка";
	
	МНО = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ТекСтрока Из МНО Цикл
		ТекСтрока.СуммаПроцентов = РаботаСМНО.РасчетСуммыМНО(ТекСтрока, ТекСтрока.ДатаВозврата);
	КонецЦикла; 
	
	Запрос.УстановитьПараметр("ПлановыеМНО", МНО);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПлановыеМНО.РасчетныйСчет КАК РасчетныйСчет,
		|	ПлановыеМНО.Валюта КАК Валюта,
		|	ПлановыеМНО.СуммаПроцентов КАК Сумма
		|ПОМЕСТИТЬ _ПлановыеМНО
		|ИЗ
		|	&ПлановыеМНО КАК ПлановыеМНО";
	
	Запрос.Выполнить();

КонецПроцедуры
 
