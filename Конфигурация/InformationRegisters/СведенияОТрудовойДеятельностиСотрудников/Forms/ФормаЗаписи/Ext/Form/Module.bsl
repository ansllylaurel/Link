
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустой() Тогда
		Запись.НомерПоПорядку = 0;
		
		Если Параметры.ЗначениеКопирования.Пустой()
			И НЕ (Параметры.ЗначенияЗаполнения.Свойство("Организация") И ЗначениеЗаполнено(Параметры.ЗначенияЗаполнения.Организация)) Тогда
			Запись.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

