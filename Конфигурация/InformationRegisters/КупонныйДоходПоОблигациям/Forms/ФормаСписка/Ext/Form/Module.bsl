
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Если открыли из карточки облигации, то будет стоять отбор
	
	Если Параметры.Отбор.Свойство("Облигация") Тогда
		Элементы.Облигация.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьФормулыРасчетаСтавокКупонов(Команда)

	Купоны = Новый Массив;
	
	Для Каждого ВыделеннаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		
		ДанныеСтроки = Элементы.Список.ДанныеСтроки(ВыделеннаяСтрока);
		
		Купоны.Добавить(Новый Структура("Облигация, НомерКупона", ДанныеСтроки.Облигация, ДанныеСтроки.НомерКупона));
		
	КонецЦикла;
	
	// Передаем отобранные купоны в форму группового заполнения формул
	
	Если Купоны.Количество() > 0 Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Купоны", Купоны);
		
		ОбновленныеКупоны = ОткрытьФормуМодально("РегистрСведений.ФормулыРасчетаСтавокКупонов.Форма.ФормаГрупповогоЗаполнения", ПараметрыФормы, ЭтаФорма);
		
		Если ТипЗнч(ОбновленныеКупоны) = Тип("Массив") И ОбновленныеКупоны.Количество() > 0 Тогда
			
			Ответ = Вопрос("Обновить данные?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
			
			Если Ответ = КодВозвратаДиалога.Да Тогда
				ОбновитьДанные(ОбновленныеКупоны);	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанные(Купоны)

	// Т.к. обновление купонов идет через справочник облигации,
	// то получим все уникальные облигации и обновим их
	
	Облигации = Новый ТаблицаЗначений;
	Облигации.Колонки.Добавить("Объект", Новый ОписаниеТипов("СправочникСсылка.Облигации"));
	Облигации.Индексы.Добавить("Объект");
	
	Для Каждого ОписаниеКупона Из Купоны Цикл
		Если Облигации.Найти(ОписаниеКупона.Облигация, "Объект") = Неопределено Тогда
			Облигации.Добавить().Объект = ОписаниеКупона.Облигация;
		КонецЕсли;
	КонецЦикла;
	
	// Обновление через НСИ
	
	ГруппаОбъектов					= Справочники.ГруппыИмпортируемыхОбъектов.Облигации;
	НеСообщатьОбИзмененииОбъектов	= Истина;
	НеСообщатьОбОтсутствииИзменений	= Истина;
	
	РаботаСВнешнимиСистемами.ОбновитьОбъектыИзМатрикс(ГруппаОбъектов, Облигации, НеСообщатьОбИзмененииОбъектов, НеСообщатьОбОтсутствииИзменений);
		
	Элементы.Список.Обновить();
	
КонецПроцедуры
