
#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Запись.СчетДоверительногоУправления) Тогда
		
		ЭтаФорма.ВидДоговораДоверительногоУправления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
					Запись.СчетДоверительногоУправления,
					"ВидДоговораДоверительногоУправления");
					
	КонецЕсли;
				
	Если Запись.ИсходныйКлючЗаписи.Пустой()	
		И ЭтаФорма.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов
		Тогда
		
			Запись.ИспользоватьНастройкиУчетнойПолитикиЕПС 	= Истина;
			Запись.ВариантРасчетаПроцентовПоСделкамРЕПО 	= Неопределено;
			Запись.КритерийСущественностиОтклоненияССТПлюс 	= 0;
			Запись.ТочностьРасчетнойСтавкиРЕПО 				= 0;
			
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры  

#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура ВариантРасчетаПроцентовПоСделкамРЕПОПриИзменении(Элемент)
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	РаботаСФормамиКлиентСервер.ОчиститьЗначенияСкрытыхПолей(ЭтаФорма, Новый Структура("ТочностьРасчетнойСтавкиРЕПО", "Запись.ТочностьРасчетнойСтавкиРЕПО"));
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьНастройкиУчетнойПолитикиЕПСПриИзменении(Элемент)
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	МассивРеквизитовДляОчистки = Новый Массив;
	МассивРеквизитовДляОчистки.Добавить("Запись.ВариантРасчетаПроцентовПоСделкамРЕПО");
	МассивРеквизитовДляОчистки.Добавить("Запись.ТочностьРасчетнойСтавкиРЕПО");
	МассивРеквизитовДляОчистки.Добавить("Запись.КритерийСущественностиОтклоненияССТПлюс");
	
	РаботаСФормамиКлиентСервер.ОчиститьЗначенияСкрытыхПолей(ЭтаФорма, Новый Структура("ГруппаРЕПО", МассивРеквизитовДляОчистки));
	
КонецПроцедуры

#КонецОбласти 

#Область Прочие_процедуры_и_функции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Элементы	= Форма.Элементы;
	Запись		= Форма.Запись;	
	
	Элементы.ГруппаРЕПО.Видимость 								= Не Запись.ИспользоватьНастройкиУчетнойПолитикиЕПС;
	Элементы.ТочностьРасчетнойСтавкиРЕПО.Видимость 				= Запись.ВариантРасчетаПроцентовПоСделкамРЕПО = ПредопределенноеЗначение("Перечисление.ВариантыРасчетаПроцентовПоСделкамРЕПО.ПоРасчетнойСтавке");	
	Элементы.КритерийСущественностиОтклоненияССТПлюс.Видимость	= Не Запись.ИспользоватьНастройкиУчетнойПолитикиЕПС;
	
	Элементы.ПриостановленРасчетСЧА.Видимость = Форма.ВидДоговораДоверительногоУправления = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда");
	
КонецПроцедуры 

&НаСервере
Процедура СчетДоверительногоУправленияПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Запись.СчетДоверительногоУправления) Тогда
		
		ЭтаФорма.ВидДоговораДоверительногоУправления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
					Запись.СчетДоверительногоУправления,
					"ВидДоговораДоверительногоУправления");

		НастроитьВидимостьИДоступность(ЭтаФорма);			
					
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	СчетДоверительногоУправленияПриИзмененииНаСервере();
КонецПроцедуры
	
#КонецОбласти
