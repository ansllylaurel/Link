
Функция ПолучитьГруппировкиОбщихНастроек() Экспорт
	
	РесурсыСГруппировкой = Новый ТаблицаЗначений;
	
	РесурсыСГруппировкой.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	РесурсыСГруппировкой.Колонки.Добавить("Синоним", Новый ОписаниеТипов("Строка"));
	РесурсыСГруппировкой.Колонки.Добавить("Группа", Новый ОписаниеТипов("Строка"));

	МакетГруппировки = РегистрыСведений.НастройкиФормированияСЧА.ПолучитьМакет("ГруппировкаНастроек");
	
	НомСтр = 2;
	
	Пока СокрЛП(МакетГруппировки.Область(НомСтр, 1).Текст) <> "" Цикл
		
		НоваяСтрокаРесурсыСГруппировкой = РесурсыСГруппировкой.Добавить(); 
		
		НоваяСтрокаРесурсыСГруппировкой.Имя = СокрЛП(МакетГруппировки.Область(НомСтр, 1).Текст);
		НоваяСтрокаРесурсыСГруппировкой.Группа = СокрЛП(МакетГруппировки.Область(НомСтр, 2).Текст);
		
		Если СокрЛП(НоваяСтрокаРесурсыСГруппировкой.Группа) = "" Тогда
		
			НоваяСтрокаРесурсыСГруппировкой.Группа = "Прочие";
		
		КонецЕсли;
		
		НомСтр = НомСтр + 1;
	
	КонецЦикла;
	
	Для каждого РесурсРегистра Из Метаданные.РегистрыСведений.НастройкиФормированияСЧА.Ресурсы Цикл
		
		СтрокаРесурсыСГруппировкой = РесурсыСГруппировкой.Найти(РесурсРегистра.Имя, "Имя");
		
		Если СтрокаРесурсыСГруппировкой = Неопределено Тогда
		
			НоваяСтрокаРесурсыСГруппировкой = РесурсыСГруппировкой.Добавить(); 
			
			НоваяСтрокаРесурсыСГруппировкой.Имя = РесурсРегистра.Имя;
			НоваяСтрокаРесурсыСГруппировкой.Синоним = РесурсРегистра.Синоним;
			НоваяСтрокаРесурсыСГруппировкой.Группа = "Прочие";
			
		Иначе
			
			СтрокаРесурсыСГруппировкой.Синоним = РесурсРегистра.Синоним;
			
		КонецЕсли;
	
	КонецЦикла;
	
	РесурсыСГруппировкой.Сортировать("Группа,Имя");
	
	Возврат РесурсыСГруппировкой;

КонецФункции 

Функция ПолучитьБлижайшуюДатуФормированияСЧА(Организация, СчетДоверительногоУправления, Период) Экспорт

	ПоследнийРабочийДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, Период);
	
	Если Период = ПоследнийРабочийДень Тогда
	
		ДатаФормированияСЧА = Период;
		
	Иначе
		
		ОтсутствуютНастройки = Ложь;
		ДатаФормированияСЧА = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПредыдущегоРасчетаСЧА(СчетДоверительногоУправления, КонецДня(Период)+1, ОтсутствуютНастройки);
		
		Если ОтсутствуютНастройки Тогда	
			ТекстОшибки = РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку("Для клиента %1 не заданы настройки формирования СЧА на %2", СчетДоверительногоУправления, Формат(Период, "ДФ=dd.MM.yyyy"));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			Возврат Неопределено;
		ИначеЕсли ДатаФормированияСЧА = Неопределено Тогда	
			ТекстОшибки = РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку("Для клиента %1 не удалось получить дату предыдущего расчета СЧА. Возможно, не заданы настройки формирования СЧА на %2", СчетДоверительногоУправления, Формат(Период, "ДФ=dd.MM.yyyy"));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			Возврат Неопределено;
		КонецЕсли; 
		
		Если ПоследнийРабочийДень > ДатаФормированияСЧА Тогда
			ДатаФормированияСЧА = ПоследнийРабочийДень;
		КонецЕсли;
	КонецЕсли; 
	
	Возврат НачалоДня(ДатаФормированияСЧА);
	
КонецФункции
 
Функция ОпределитьНастройки(Период, Организация, СчетДоверительногоУправления, Отказ = Ложь) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	НастройкиФормированияСЧАСрезПоследних.*
		|ИЗ
		|	РегистрСведений.НастройкиФормированияСЧА.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиФормированияСЧАСрезПоследних");
		
	Запрос.УстановитьПараметр("Период",                       Период);
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		
		Ресурсы = Новый Массив;
		Для Каждого Ресурс Из Метаданные.РегистрыСведений.НастройкиФормированияСЧА.Ресурсы Цикл
			Ресурсы.Добавить(Ресурс.Имя);
		КонецЦикла;
		СписокРесурсов = СтрСоединить(Ресурсы, ","); 
		
		Настройки = Новый Структура(СписокРесурсов);
		ЗаполнитьЗначенияСвойств(Настройки, Выборка, СписокРесурсов);
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("На %1 для клиента %2 не заданы настройки формирования СЧА", Формат(Период, "ДФ=dd.MM.yyyy"), СчетДоверительногоУправления), , , , Отказ);
			
		Настройки = Неопределено;	
		
	КонецЕсли;

	Возврат Настройки;
	
КонецФункции

Функция ДатаНачалаИспользованияНастроекУчетнойПолитикиЕПСПриРасчетеСЧА() Экспорт
	
	Возврат '20240412';
	
КонецФункции

Функция ЕжедневноеФормированиеСЧА(Период, Организация, СчетДоверительногоУправления) Экспорт
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	НастройкиФормированияСЧАСрезПоследних.Период КАК Период
		|ИЗ
		|	РегистрСведений.НастройкиФормированияСЧА.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиФормированияСЧАСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НастройкиРегламентныхДействий.Настройки КАК НастройкиРегламентныхДействийНастройки
		|		ПО НастройкиФормированияСЧАСрезПоследних.ПериодичностьРасчетаСЧА = НастройкиРегламентныхДействийНастройки.Ссылка
		|			И (НастройкиРегламентныхДействийНастройки.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПереоценкиАктивов.Ежедневно))");
		
	Запрос.УстановитьПараметр("Период",                       Период);
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);

	Результат = Запрос.Выполнить();
	Возврат Не Результат.Пустой();
КонецФункции
