&НаСервере
Процедура ВидимостьЕжедневнойКредиторки()
	Текст = "ВЫБРАТЬ
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Договор = &Договор) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиФормированияСЧА.СрезПоследних(&Период, Организация = &Организация) КАК НастройкиФормированияСЧАСрезПоследних
		|		ПО (ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = НастройкиФормированияСЧАСрезПоследних.СчетДоверительногоУправления)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НастройкиРегламентныхДействий.Настройки КАК НастройкиРегламентныхДействийНастройки
		|		ПО (НастройкиФормированияСЧАСрезПоследних.ПериодичностьРасчетаСЧА = НастройкиРегламентныхДействийНастройки.Ссылка)
		|ГДЕ
		|	НастройкиРегламентныхДействийНастройки.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПереоценкиАктивов.Ежедневно)
		|";

	Запрос = Новый Запрос(Текст);

	Запрос.УстановитьПараметр("Договор", ЭтотОбъект.Запись.Договор);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Запись.Организация);
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Запись.Период);
	ЭтаФорма.Элементы.НастройкаРасчетаЕжедневнойКредиторки.Видимость = Не Запрос.Выполнить().Пустой();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Ключ.Пустой() Тогда
		ЭтотОбъект.Запись.Организация = Параметры.ЗначенияЗаполнения.Договор.Организация;
	КонецЕсли;
	ВидимостьЕжедневнойКредиторки();
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	ВидимостьЕжедневнойКредиторки();
КонецПроцедуры
