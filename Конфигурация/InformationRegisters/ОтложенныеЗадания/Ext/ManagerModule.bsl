
Функция ПолучитьТаблицуПараметровПараллельногоЗапускаОтложенныхЗаданий() Экспорт

	ТаблицаПараметров = Новый ТаблицаЗначений;
	ТаблицаПараметров.Колонки.Добавить("Объект",            Метаданные.РегистрыСведений.ОтложенныеЗадания.Измерения.Объект.Тип);
	ТаблицаПараметров.Колонки.Добавить("КоличествоПотоков", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1, 0, ДопустимыйЗнак.Неотрицательный)));
	
	НоваяСтрока = ТаблицаПараметров.Добавить();
	НоваяСтрока.Объект            = "Обработки.КонтрольСЧА";
	НоваяСтрока.КоличествоПотоков = 3;
	
	Возврат ТаблицаПараметров;

КонецФункции

// Проверяет, что зарегистрировано отложенное задание с плановой датой запуска в указанном периоде,
// находящееся в одном из заданных состояний
//	
//	Параметры:
//		- ДатаНачала 	- начало периода проверки
//		- ДатаОкончания - окончание периода проверки
//		- ПараметрыЗадания - структура с параметрами задания:
//				- Организация 	- организация
//				- Объект 		- СправочникСсылка.ДополнительныеОтчетыИОбработки или Строка
//				- Команда 		- Строка
//				- Состояния 	- ПеречислениСсылка.СостоянияОтложенныхЗаданий или Массив со значениями этого перечисления
//
Функция ЕстьОтложенноеЗадание(ДатаНачала, ДатаОкончания, ПараметрыЗадания) Экспорт
	
	Запрос = Новый Запрос(		 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОтложенныеЗадания.Идентификатор КАК Идентификатор
		|ИЗ
		|	РегистрСведений.ОтложенныеЗадания КАК ОтложенныеЗадания
		|ГДЕ
		|	ОтложенныеЗадания.Объект = &Объект
		|	И ОтложенныеЗадания.Организация = &Организация
		|	И ОтложенныеЗадания.ДатаЗапускаПлан МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ОтложенныеЗадания.Команда = &Команда
		|	И ОтложенныеЗадания.Состояние В (&Состояния)");
	
	Запрос.УстановитьПараметр("Объект", 			ПараметрыЗадания.Объект);
	Запрос.УстановитьПараметр("Организация", 		ПараметрыЗадания.Организация);	
	Запрос.УстановитьПараметр("Команда", 			ПараметрыЗадания.Команда);
	Запрос.УстановитьПараметр("Состояния", 			ПараметрыЗадания.Состояния);
	Запрос.УстановитьПараметр("ДатаНачала", 		НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", 		КонецДня(ДатаОкончания));
	
	Возврат Не Запрос.Выполнить().Пустой();
		
КонецФункции