
Процедура ПередЗаписью(Отказ, Замещение)
	
	// блокирующие проверки
	УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
	
	Для каждого Запись Из ЭтотОбъект Цикл
		
		Если ТипЗнч(Запись.Операция) = Тип("ДокументСсылка.СтрокаБанковскойВыписки") И Не ЭтоРазмещениеЗаймаПолученного(Запись.Операция) Тогда
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.Операция, "ВидДвижения") = Перечисления.ВидыДвижений.Приход Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя акцептовать документ [" + Запись.Операция + "] с видом движения [Приход] (допускается только при размещении займов полученных)",,,, Отказ);
			КонецЕсли;
		КонецЕсли;	
		
		Если Запись.ВидАкцепта = Перечисления.ВидыАкцептов.МНОСрочный30Дней4ПроцентаУКПИ 
			И Запись.Организация <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Длинный акцент МНО применим только для УКПИ!",,,, Отказ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Запись.Срок)
			И Не (Запись.ВидАкцепта = Перечисления.ВидыАкцептов.МНОСрочный30Дней4ПроцентаУКПИ
				Или Запись.ВидАкцепта = Перечисления.ВидыАкцептов.МНО И ТипЗнч(Запись.Операция) = Тип("СправочникСсылка.БанковскиеСчета")
				Или Запись.ВидАкцепта = Перечисления.ВидыАкцептов.ПереводСБрокерскогоСчетаНаРасчетный И ТипЗнч(Запись.Операция) = Тип("СправочникСсылка.ДоговорыБрокерскогоОбслуживания")) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Недопустимо заполнение срока для вида акцепта [" + Запись.ВидАкцепта + "]!",,,, Отказ);
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

#Область Прочие_процедуры_и_функции

Функция ЭтоРазмещениеЗаймаПолученного(СтрокаБанковскойВыписки)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеестрПлатежей.ДвижениеДенежныхСредств КАК Документ
		|ИЗ
		|	РегистрСведений.РеестрПлатежей КАК РеестрПлатежей
		|ГДЕ
		|	РеестрПлатежей.СтрокаБанковскойВыписки = &СтрокаБанковскойВыписки
		|	И ВЫРАЗИТЬ(ВЫРАЗИТЬ(РеестрПлатежей.ДвижениеДенежныхСредств КАК Документ.РазмещениеКредитногоИнструмента).КредитныйИнструмент КАК Справочник.Займы).ВидКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ВидыКредитныхИнструментов.Полученный)");
	
	Запрос.УстановитьПараметр("СтрокаБанковскойВыписки", СтрокаБанковскойВыписки);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

#КонецОбласти