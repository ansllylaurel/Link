Функция СчетаДоверительногоУправленияКлиента(Клиент, Организация, Период, ПоместитьВоВременнуюТаблицу = Ложь, ИмяВременнойТаблицы = "_СчетаДоверительногоУправленияКлиента", МенеджерВременныхТаблиц = Неопределено) Экспорт
	
	// Когда нужно поместить результат в менеджер ВТ:
	//  - если в менеджере есть ВТ, то ничего не делаем
	//  - если в менеджере нет ВТ, то формируем запрос для получения данных из регистров и помещения их в ВТ
	// Когда не нужно помещать результат в менеджер ВТ:
	//  - если в менеджере есть ВТ, формируем запрос на получение данных из ВТ
	//  - если в менеджере нет ВТ, то формируем запрос для получения данных из регистров
	
	Если МенеджерВременныхТаблиц <> Неопределено
		И МенеджерВременныхТаблиц.Таблицы.Найти(ИмяВременнойТаблицы) <> Неопределено
	Тогда
		
		Если ПоместитьВоВременнуюТаблицу Тогда
			РезультатФункции = ИмяВременнойТаблицы;	
		Иначе
			РезультатФункции = МенеджерВременныхТаблиц.Таблицы[ИмяВременнойТаблицы].ПолучитьДанные().Выгрузить().ВыгрузитьКолонку("СчетДоверительногоУправления");
		КонецЕсли;
		
	Иначе
		
		СчетаДоверительногоУправленияКлиента = Кэширование.СчетаДоверительногоУправленияКлиента(Клиент, Организация, Период);

		Если ПоместитьВоВременнуюТаблицу Тогда
			
			Если МенеджерВременныхТаблиц = Неопределено Тогда
				МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			КонецЕсли;	
			
			Запрос = Новый Запрос("ВЫБРАТЬ * ПОМЕСТИТЬ _СчетаДоверительногоУправленияКлиента ИЗ &СчетаДоверительногоУправленияКлиента КАК СчетаДоверительногоУправленияКлиента");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ _СчетаДоверительногоУправленияКлиента", "ПОМЕСТИТЬ " + ИмяВременнойТаблицы);	
			Запрос.УстановитьПараметр("СчетаДоверительногоУправленияКлиента", СчетаДоверительногоУправленияКлиента);
			Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
			Запрос.Выполнить();
			
			РезультатФункции = ИмяВременнойТаблицы;
			
		Иначе
			
			РезультатФункции = СчетаДоверительногоУправленияКлиента.ВыгрузитьКолонку("СчетДоверительногоУправления");
			
		КонецЕсли;	
		
	КонецЕсли;	
	
	Возврат РезультатФункции;
	
КонецФункции

Функция СпециализированныйДепозитарийКлиента(Клиент, Организация, Период) Экспорт
	
	// Считается, что у клиента может быть только один спецдеп.
	// Если не так, считаем это ошибкой.
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Период);
	
	СчетаДоверительногоУправленияКлиента(Клиент, Организация, Период, Истина, "_СчетаКлиента", Запрос.МенеджерВременныхТаблиц);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_СчетаКлиента.СчетДоверительногоУправления.СпециализированныйДепозитарий КАК СпециализированныйДепозитарий
		|ИЗ
		|	_СчетаКлиента КАК _СчетаКлиента
		|ГДЕ
		|	_СчетаКлиента.СчетДоверительногоУправления.СпециализированныйДепозитарий <> ЗНАЧЕНИЕ(Справочник.ДепозитарныеКомпании.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество() > 1 Тогда
		ВызватьИсключение СтрШаблон("Для клиента '%1' на %2 определено несколько специализированных депозитариев!", Клиент, Формат(Период, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	Возврат ?(РезультатЗапроса.Следующий(), РезультатЗапроса.СпециализированныйДепозитарий, Неопределено);	
	
	
КонецФункции