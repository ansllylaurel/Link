
Процедура ПередЗаписью(Отказ, Замещение)
	
	Для каждого Запись Из ЭтотОбъект Цикл
		Если Не ЗначениеЗаполнено(Запись.Клиент) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Клиент"" не заполнено", ЭтотОбъект, "Клиент",, Отказ);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	УниверсальныеМеханизмы.ЗаполнитьОрганизациюИзВедущегоИзмерения(ЭтотОбъект, "СчетДоверительногоУправления");
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если Не Отказ Тогда
		
		// синхронизиуем клиентов счетов д/у с подчиненными стратегиями (операция крайне редкая, так что
		// искать расхождения не будем)
		СчетаДоверительногоУправления = Новый Массив;
		
		Для каждого Запись Из ЭтотОбъект Цикл
			Если СчетаДоверительногоУправления.Найти(Запись.СчетДоверительногоУправления) = Неопределено Тогда
				СчетаДоверительногоУправления.Добавить(Запись.СчетДоверительногоУправления);
			КонецЕсли;
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КлиентыДоверительногоУправления.Период,
			|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
			|	КлиентыДоверительногоУправления.Клиент
			|ИЗ
			|	РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ПО (СчетаДоверительногоУправления.Родитель = КлиентыДоверительногоУправления.СчетДоверительногоУправления)
			|ГДЕ
			|	КлиентыДоверительногоУправления.СчетДоверительногоУправления В(&СчетДоверительногоУправления)
			|ИТОГИ ПО
			|	СчетДоверительногоУправления";
			
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетаДоверительногоУправления);
			
		ВыборкаСчетаДоверительногоУправления = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСчетаДоверительногоУправления.Следующий() Цикл
			
			НаборЗаписей = РегистрыСведений.КлиентыДоверительногоУправления.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.СчетДоверительногоУправления.Установить(ВыборкаСчетаДоверительногоУправления.СчетДоверительногоУправления);
			
			НаборЗаписей.Прочитать();
			НаборЗаписей.Очистить();
			
			Выборка = ВыборкаСчетаДоверительногоУправления.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), Выборка);
			КонецЦикла;
			
			НаборЗаписей.Записать();
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры
