
&НаКлиентеНаСервереБезКонтекста
Процедура ОграничитьТипКлиента(Форма)
	
	Элементы = Форма.Элементы;
	
	Если      Форма.ТипКлиента = 1 Тогда
		Элементы.Клиент.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица");
	ИначеЕсли Форма.ТипКлиента = 2 Тогда
		Элементы.Клиент.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ПаевыеИнвестиционныеФонды");
	КонецЕсли;
	
КонецПроцедуры // ОграничитьТипКлиента

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ТипЗнч(Запись.Клиент) = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды") Тогда
		ЭтаФорма.ТипКлиента = 2;
	Иначе
		ЭтаФорма.ТипКлиента = 1; // в т.ч. по умолчанию для новых записей
	КонецЕсли;
	
	ОграничитьТипКлиента(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипКлиентаПриИзменении(Элемент)
	
	ОграничитьТипКлиента(ЭтаФорма);
	
КонецПроцедуры
