
#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Организация = ПараметрыСеанса.ТекущаяОрганизация;
	ДатаСверки = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДата(), -2);
	ПериодСверки.ДатаОкончания = ДатаСверки;
	ПериодСверки.ДатаНачала = НачалоМесяца(ДатаСверки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьИспользуемоеИмяФайла();
	УстановитьВидимость();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если РежимФормирования = 0 Тогда
		ПроверяемыеРеквизиты.Добавить("ДатаСверки");
	Иначе
		Если ПериодСверки.ДатаНачала = '00010101' Или ПериодСверки.ДатаОкончания = '00010101' Тогда                        			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Некорректно указан период сверки",, "ПериодСверки",, Отказ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура РежимФормированияПриИзменении(Элемент)
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаСверкиПриИзменении(Элемент)
	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НЕАКТУАЛЬНОСТЬ");
	
	УстановитьИспользуемоеИмяФайла();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодСверкиПриИзменении(Элемент)
	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НЕАКТУАЛЬНОСТЬ");
	
	УстановитьИспользуемоеИмяФайла();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветственныйНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Параметрыформы = РаботаСОтчетами.ПолучитьПараметрыФормыВыбораКонтактногоЛица(Новый Структура("Организация, КонтактноеЛицо", Организация, Ответственный));
	
	ОткрытьФормуМодально("РегистрСведений.КонтактныеЛица.ФормаСписка", ПараметрыФормы, Элемент, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОтветственныйОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(ВыбранноеЗначение);
	
	ВыбранноеЗначение = СтруктураДанныхКонтактногоЛица.КонтактноеЛицо;

КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаСформировать(Команда)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьАктСверкиНаСервере();
	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат);

КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаСервере
Процедура СформироватьАктСверкиНаСервере()
	
	Результат.Очистить();
	Расшифровка.Очистить();
	
	Если РежимФормирования = 0 Тогда
		Расхождения = Неопределено;
		Результат = РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.ПолучитьАктСверки(Организация, ДатаСверки, Ответственный, Расхождения);
		
		Если Расхождения <> Неопределено Тогда
			Расшифровка = Расхождения;
		КонецЕсли;
		
	Иначе
				
		РабочиеДни = Справочники.Календари.ПолучитьРабочиеДниПериода(Справочники.Календари.Общероссийский, ПериодСверки.ДатаНачала, ПериодСверки.ДатаОкончания);
		
		Для Каждого РабочийДень Из РабочиеДни Цикл	
			
			Расхождения = Неопределено;
			АктСверки = РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.ПолучитьАктСверки(Организация, РабочийДень, Ответственный, Расхождения);
			Результат.Вывести(АктСверки);
			Результат.ВывестиГоризонтальныйРазделительСтраниц();
			
			Если Расхождения <> Неопределено Тогда
				Расшифровка.Вывести(Расхождения);
				Расшифровка.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
					
		КонецЦикла;
		
	КонецЕсли;
	
	Результат.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	Результат.АвтоМасштаб			= Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт
	
	Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НЕАКТУАЛЬНОСТЬ");
	УстановитьИспользуемоеИмяФайла();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьИспользуемоеИмяФайла()
	
	Элементы.Результат.ИспользуемоеИмяФайла = "Акт сверки за " + Формат(ДатаСверки, "ДФ=dd.MM.yyyy") + " " + СокрЛП(Организация) + ".docx";
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимость()
	
	Элементы.ДатаСверки.Видимость 	= РежимФормирования = 0;
	Элементы.ПериодСверки.Видимость = РежимФормирования = 1;
	
КонецПроцедуры

#КонецОбласти


