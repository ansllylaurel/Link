&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
    Перем ВыполненноеДействие, ПараметрВыполненногоДействия;
    
    Если ЭтоАдресВременногоХранилища(АдресРасшифровки) И ЭтоАдресВременногоХранилища(АдресСКД) Тогда
		СтандартнаяОбработка = Ложь;
		
		ПоляЭлементаРасшифровки = ПолучитьПоляЭлементаРасшифровки(Расшифровка, АдресРасшифровки);
        
		ДоступныеДействия		= Новый Массив;
		ДополнительныеДействия	= Новый СписокЗначений;
		
		Если ПоляЭлементаРасшифровки.Свойство("СчетДоверительногоУправления") Тогда
			ЕстьПравоНаСверку = РаботаСПользователями.РолиДоступны("ОперацииБэкОфиса");
			
			Если ПоляЭлементаРасшифровки.Свойство("Основание") Тогда
				
				Если ЕстьПравоНаСверку Тогда
					ДополнительныеДействия.Добавить("ВыполнитьСверку", "Выполнить сверку");
					
					Если ПоляЭлементаРасшифровки.Пройдена <> Истина Тогда
						ДополнительныеДействия.Добавить("ПодтвердитьСверкуВручную", "Подтвердить сверку (вручную)");
					КонецЕсли;
				КонецЕсли;
				
			Иначе
				
				Если ПоляЭлементаРасшифровки.ИтоговыйСтатус <> Истина И ЕстьПравоНаСверку Тогда
					ДополнительныеДействия.Добавить("ПодтвердитьСверкиКлиентаВручную", "Подтвердить сверки клиента (вручную)");
				КонецЕсли;

				ДополнительныеДействия.Добавить("ОткрытьКарточкуКлиента", "Карточка клиента");
				
			КонецЕсли;
			
			ДополнительныеДействия.Добавить("ИсторияСверок", "История сверок");	
		КонецЕсли;
		
		ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(АдресРасшифровки, Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСКД));
		ОбработкаРасшифровки.ВыбратьДействие(Расшифровка, ВыполненноеДействие, ПараметрВыполненногоДействия, ДоступныеДействия, ДополнительныеДействия);		
		
		Если ВыполненноеДействие = "ОткрытьКарточкуКлиента" Тогда
			
			ОткрытьЗначение(ПоляЭлементаРасшифровки.СчетДоверительногоУправления);
			
		ИначеЕсли ВыполненноеДействие = "ПодтвердитьСверкуВручную" Тогда
			
			ПодтвердитьСверкуВручную(ЭтаФорма.Организация, ПоляЭлементаРасшифровки.СчетДоверительногоУправления, ПоляЭлементаРасшифровки.ПериодСверки, ПоляЭлементаРасшифровки.Основание);
			
		ИначеЕсли ВыполненноеДействие = "ПодтвердитьСверкиКлиентаВручную" Тогда
			
			ПодтвердитьСверкиКлиентаВручную(ЭтаФорма.Организация, ПоляЭлементаРасшифровки.СчетДоверительногоУправления, ПоляЭлементаРасшифровки.ПериодСверки);
			
		ИначеЕсли ВыполненноеДействие = "ИсторияСверок" Тогда
			
			ПоказатьИсториюСверок(ЭтаФорма.Организация, ПоляЭлементаРасшифровки.СчетДоверительногоУправления, ПоляЭлементаРасшифровки.ПериодСверки);
			
		ИначеЕсли ВыполненноеДействие = "ВыполнитьСверку" Тогда
			
			ВыполнитьСверку(ЭтаФорма.Организация, ПоляЭлементаРасшифровки.СчетДоверительногоУправления, ПоляЭлементаРасшифровки.ПериодСверки, ПоляЭлементаРасшифровки.Основание);
			
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаВвестиПериод(Команда)
	ДиалогВыбораПериода = Новый ДиалогРедактированияСтандартногоПериода();
	ДиалогВыбораПериода.Период.ДатаНачала		= ЭтаФорма.Период.ДатаНачала;
	ДиалогВыбораПериода.Период.ДатаОкончания	= ЭтаФорма.Период.ДатаОкончания;
	
	Если ДиалогВыбораПериода.Редактировать() Тогда 
		ЭтаФорма.Период.ДатаНачала		= ДиалогВыбораПериода.Период.ДатаНачала;
		ЭтаФорма.Период.ДатаОкончания	= ДиалогВыбораПериода.Период.ДатаОкончания;
		
		ПриИзмененииПараметровОтчета(ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаСформировать(Команда)

	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	СкомпоноватьРезультатНаСервере();	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПроверитьОтсутствиеНеподтвержденныхОпераций(Команда)

	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если Период.ДатаОкончания > ТекущаяДата() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Период проверки не должен быть позже вчерашнего дня.", , "Период.ДатаОкончания");
		Возврат;
	ИначеЕсли (Период.ДатаОкончания - Период.ДатаНачала) / 86400 > 5 Тогда
		Если Вопрос("Проверка за большой период может занять продолжительное время." + Символы.ПС + "Продолжить?" , РежимДиалогаВопрос.ОКОтмена) <> КодВозвратаДиалога.ОК Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ОтборКлиентов = Неопределено;
	Если ЭтаФорма.РежимОтбора = 1 Тогда
		ОтборКлиентов = ЭтаФорма.СчетДоверительногоУправления;
	ИначеЕсли ЭтаФорма.РежимОтбора = 2 Тогда
		ОтборКлиентов = ЭтаФорма.ВидДеятельности;
	КонецЕсли;
	
	ДатаСверки = ТекущаяДата();
	Если Не ВвестиДату(ДатаСверки, "Время сверки", ЧастиДаты.ДатаВремя) Тогда 		
		Возврат;
	КонецЕсли;	
	
	ЗафиксироватьРезультатыСверкиСЖурналомПодтверждений(
		ЭтаФорма.Период.ДатаНачала,
		ЭтаФорма.Период.ДатаОкончания,
		ЭтаФорма.Организация,
		ОтборКлиентов,
		ДатаСверки
	);
	
	Если Вопрос("Проверка выполнена. Обновить журнал сверок?" , РежимДиалогаВопрос.ОКОтмена) = КодВозвратаДиалога.ОК Тогда
		СкомпоноватьРезультатНаСервере();	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаАктСверки(Команда)
	
	ОткрытьФорму("РегистрСведений.ЖурналСверокПоВнутреннемуУчету.Форма.ФормаАктаСверки");
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Функция СкомпоноватьРезультатНаСервере(ПараметрыОтбора = Неопределено, ИсторияСверок = Ложь, ВыводВОсновнойДокумент = Истина)
	
	Если ПараметрыОтбора = Неопределено Тогда
		ПараметрыОтбора = СформироватьСтруктуруПараметровОтбора();
		
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, ЭтаФорма);
		
		ПараметрыОтбора.ДатаНачала		= ЭтаФорма.Период.ДатаНачала;
		ПараметрыОтбора.ДатаОкончания	= ЭтаФорма.Период.ДатаОкончания;
		ПараметрыОтбора.Основание		= ?(ЭтаФорма.ФильтрПоОснованию, ЭтаФорма.Основание, Неопределено);
	КонецЕсли;
	
	Если ВыводВОсновнойДокумент Тогда
		ДокументРезультат = ЭтаФорма.Результат;
	Иначе
		ДокументРезультат = Новый ТабличныйДокумент;
		
		ДокументРезультат.ТолькоПросмотр = Истина;
		ДокументРезультат.ОтображатьСетку = Ложь;
		ДокументРезультат.ОтображатьЗаголовки = Ложь;
	КонецЕсли;
	
	ДокументРезультат.Очистить();
	
	СхемаКомпоновкиДанных = РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.ПолучитьМакет("ЖурналСверок");
	
	// Параметры отчета
	НастройкиКомпоновки = ?(ИсторияСверок, СхемаКомпоновкиДанных.ВариантыНастроек.ИсторияСверок.Настройки, СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ИсторияСверок",		ИсторияСверок);
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("Организация",			ПараметрыОтбора.Организация);
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаНачала",			ПараметрыОтбора.ДатаНачала);
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаОкончания",		ПараметрыОтбора.ДатаОкончания);
	
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("БрокерГПБ",			ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ"));
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("БрокерБКРегион",		ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион"));
	
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ДепозитарийБКРегион",	ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_БК_Регион"));
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ДепозитарийДКРегион",	ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_ДК_Регион"));
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ДепозитарийНСД",		ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НСД"));
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ДепозитарийИнфинитум",	ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_Инфинитум"));
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ДепозитарийВТБ",		ОбщегоНазначения.ПолучитьИменованныйОбъект("СпецДепозитарий_ВТБ"));
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ДепозитарийГПБ",		ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_ГПБ"));
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ДепозитарийРСД",		ОбщегоНазначения.ПолучитьИменованныйОбъект("СпецДепозитарий_Сбербанка"));
	
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ПредставлениеПериода",	ПредставлениеПериода(НастройкиКомпоновки.ПараметрыДанных.Элементы.Найти("ДатаНачала").Значение, НастройкиКомпоновки.ПараметрыДанных.Элементы.Найти("ДатаОкончания").Значение));
	
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("КодыИсключаемыхПортфелей", РаботаСКоллекциями.ЗначениеВМассив("О")); // НЕОПРЕДЕЛЁН
	
	НастройкиКомпоновки.ПараметрыДанных.Элементы.Найти("СчетДоверительногоУправления").Использование = Ложь;
	НастройкиКомпоновки.ПараметрыДанных.Элементы.Найти("ВидДеятельности").Использование = Ложь;
	
	Если ПараметрыОтбора.РежимОтбора = 1 Тогда
		НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("СчетДоверительногоУправления", ПараметрыОтбора.СчетДоверительногоУправления);
	ИначеЕсли ПараметрыОтбора.РежимОтбора = 2 Тогда 
		НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ВидДеятельности", ПараметрыОтбора.ВидДеятельности);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОтбора.Основание) Тогда
		НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("Основание", ПараметрыОтбора.Основание);
	Иначе
		НастройкиКомпоновки.ПараметрыДанных.Элементы.Найти("Основание").Использование = Ложь;		
	КонецЕсли;
	
	Если Не ИсторияСверок И ПараметрыОтбора.ТолькоНепройденныеСверки Тогда
		НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ТолькоНепройденныеСверки", Истина);
	Иначе
		НастройкиКомпоновки.ПараметрыДанных.Элементы.Найти("ТолькоНепройденныеСверки").Использование = Ложь;		
	КонецЕсли;
	
	Если ПараметрыОтбора.СкрыватьСобственныеСчета Тогда
		НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("СкрыватьСобственныеСчета", Истина);
	Иначе
		НастройкиКомпоновки.ПараметрыДанных.Элементы.Найти("СкрыватьСобственныеСчета").Использование = Ложь;		
	КонецЕсли;
	
	// Фиксируем запуск процедуры
	Механизм = "РегистрСведений.ЖурналСверокПоВнутреннемуУчету.ЖурналСверок";
	Сессия = ЗарегистрироватьНовуюСессиюРаботыВнутреннихМеханизмов(Механизм, НастройкиКомпоновки);	
	
	// Формируем отчет
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновки, ДанныеРасшифровки);
	
	Если Не ВыводВОсновнойДокумент Тогда
		ДанныеРасшифровки = Неопределено;
	КонецЕсли;
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);
	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументРезультат, Механизм, Истина, ОриентацияСтраницы.Портрет);		
	
	// Фиксируем завершение процедуры
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
	Если ВыводВОсновнойДокумент Тогда
		ЭтаФорма.АдресСКД			= ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, ЭтаФорма.УникальныйИдентификатор);
		ЭтаФорма.АдресРасшифровки	= ПоместитьВоВременноеХранилище(ДанныеРасшифровки, ЭтаФорма.УникальныйИдентификатор);
			
		РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НеИспользовать");
		
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДокументРезультат; 
	
КонецФункции

#Область Вспомогательные_функции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступностьЭлементовФормы(ЭтаФорма)

	Элементы = ЭтаФорма.Элементы;		
	
	ПериодДень = (ЭтаФорма.ВидПериода = "День");
	Элементы.ГруппаПериодДатаОкончания.Видимость	= Не ПериодДень;
	Элементы.ВвестиПериод.Видимость					= Не ПериодДень;
	
	Элементы.СчетДоверительногоУправления.Видимость	= (ЭтаФорма.РежимОтбора = 1);
	Элементы.ВидДеятельности.Видимость				= (ЭтаФорма.РежимОтбора = 2);
	Элементы.Основание.Доступность					= (ЭтаФорма.ФильтрПоОснованию);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииПараметровОтчета(ЭтаФорма)
	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(ЭтаФорма.Элементы.Результат, "НеАктуальность");		
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьСтруктуруПараметровОтбора(Организация = Неопределено, ДатаНачала = Неопределено, ДатаОкончания = Неопределено, РежимОтбора = Неопределено, СчетДоверительногоУправления = Неопределено, ВидДеятельности = Неопределено, Основание = Неопределено, ТолькоНепройденныеСверки = Ложь, СкрыватьСобственныеСчета = Ложь)
	
	ПараметрыОтбора = Новый Структура;
	
	ПараметрыОтбора.Вставить("Организация",						Организация);
	ПараметрыОтбора.Вставить("ДатаНачала",						ДатаНачала);
	ПараметрыОтбора.Вставить("ДатаОкончания",					ДатаОкончания);
	ПараметрыОтбора.Вставить("РежимОтбора",						РежимОтбора);
	ПараметрыОтбора.Вставить("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	ПараметрыОтбора.Вставить("ВидДеятельности",					ВидДеятельности);
	ПараметрыОтбора.Вставить("Основание",						Основание);
	ПараметрыОтбора.Вставить("ТолькоНепройденныеСверки",		ТолькоНепройденныеСверки);
	ПараметрыОтбора.Вставить("СкрыватьСобственныеСчета",		СкрыватьСобственныеСчета);
	
	Возврат ПараметрыОтбора;	
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗарегистрироватьНовуюСессиюРаботыВнутреннихМеханизмов(Механизм, НастройкиКомпоновки)
	
	ПараметрыВыполнения	= Новый Соответствие;
	Описание			= "";	
	
	Для Каждого ПараметрДанных Из НастройкиКомпоновки.ПараметрыДанных.Элементы Цикл
		Если ПараметрДанных.Использование Тогда
			ПараметрыВыполнения.Вставить(Строка(ПараметрДанных.Параметр), ПараметрДанных.Значение);
			Описание = Описание + Строка(ПараметрДанных.Параметр) + ": " + ПараметрДанных.Значение + Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		Новый ХранилищеЗначения(ПараметрыВыполнения, Новый СжатиеДанных(9)),
		Описание
	);		

	Возврат Сессия;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПоляЭлементаРасшифровки(Расшифровка = Неопределено, АдресРасшифровки = Неопределено, Знач ЭлементРасшифровки = Неопределено, Знач ДанныеРасшифровки = Неопределено, ПоляЭлементаРасшифровки = Неопределено)
	
	Если ПоляЭлементаРасшифровки = Неопределено Тогда 
		ПоляЭлементаРасшифровки = Новый Структура;
	КонецЕсли;
	
	Если ДанныеРасшифровки = Неопределено Тогда 
		ДанныеРасшифровки = ПолучитьИзВременногоХранилища(АдресРасшифровки);
	КонецЕсли;
	
	Если ЭлементРасшифровки = Неопределено Тогда 
		ЭлементРасшифровки = ДанныеРасшифровки.Элементы[Расшифровка];
	КонецЕсли;

	Если ТипЗнч(ЭлементРасшифровки) = Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
		Для Каждого ПолеРасшифровки Из ЭлементРасшифровки.ПолучитьПоля() Цикл
			ПоляЭлементаРасшифровки.Вставить(ПолеРасшифровки.Поле, ПолеРасшифровки.Значение);	
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого ПолеРодителя Из ЭлементРасшифровки.ПолучитьРодителей() Цикл
		ПолучитьПоляЭлементаРасшифровки( , , ПолеРодителя, ДанныеРасшифровки, ПоляЭлементаРасшифровки);	
	КонецЦикла;	
	
	Возврат ПоляЭлементаРасшифровки;
    
КонецФункции

&НаКлиенте
Процедура ПодтвердитьСверкуВручную(Организация, СчетДоверительногоУправления, ПериодСверки, Основание)
	Если Вопрос("Подтвердить вручную сверку на основании """ + Строка(Основание) + """?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ДатаСверки = ТекущаяДата();
	
	Если ВвестиДату(ДатаСверки, "Время сверки", ЧастиДаты.ДатаВремя) Тогда 		
		ПодтвердитьСверкуВручнуюНаСервере(Организация, СчетДоверительногоУправления, ПериодСверки, Основание, ДатаСверки);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПодтвердитьСверкуВручнуюНаСервере(Организация, СчетДоверительногоУправления, ПериодСверки, Основание, ДатаСверки)
	
	РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.ЗафиксироватьРезультатСверки(
		Организация,
		СчетДоверительногоУправления,
		ПериодСверки,
		Основание,
		Истина,
		Истина,
		ДатаСверки
	);	
	
	СкомпоноватьРезультатНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьСверкиКлиентаВручную(Организация, СчетДоверительногоУправления, ПериодСверки)
	Если Вопрос("Подтвердить вручную сверки клиента за " + Формат(ПериодСверки, "ДФ=dd.MM.yyyy") + "?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ДатаСверки = ТекущаяДата();
	
	Если ВвестиДату(ДатаСверки, "Время сверки", ЧастиДаты.ДатаВремя) Тогда 		
		ПодтвердитьСверкиКлиентаВручнуюНаСервере(Организация, СчетДоверительногоУправления, ПериодСверки, ДатаСверки);
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПодтвердитьСверкиКлиентаВручнуюНаСервере(Организация, СчетДоверительногоУправления, ПериодСверки, ДатаСверки)
	
	МассивНепройденныхСверок = РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.ПолучитьНепройденныеСверкиКлиента(Организация, СчетДоверительногоУправления, ПериодСверки, ДатаСверки);	
	
	Для Каждого ОснованиеСверки Из МассивНепройденныхСверок Цикл
		РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.ЗафиксироватьРезультатСверки(
			Организация,
			СчетДоверительногоУправления,
			ПериодСверки,
			ОснованиеСверки,
			Истина,
			Истина,
			ДатаСверки
		);
	КонецЦикла;
	
	СкомпоноватьРезультатНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИсториюСверок(Организация, СчетДоверительногоУправления, ПериодСверки)
	
	ПараметрыОтбора = СформироватьСтруктуруПараметровОтбора(
		Организация, ПериодСверки, ПериодСверки, 1, СчетДоверительногоУправления, , ?(ЭтаФорма.ФильтрПоОснованию, ЭтаФорма.Основание, Неопределено));
	
	ДокументРезультат = СкомпоноватьРезультатНаСервере(ПараметрыОтбора, Истина, Ложь);
	
	Если ТипЗнч(ДокументРезультат) = Тип("ТабличныйДокумент") Тогда
		ДокументРезультат.Показать("История сверок '" + СокрЛП(СчетДоверительногоУправления) + "' за " + Формат(ПериодСверки, "ДФ=dd.MM.yyyy")); 			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСверку(Организация, СчетДоверительногоУправления, ПериодСверки, Основание)
	
	Если Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ЖурналПодтвержденийОпераций") Тогда
		
		ПараметрыЗаполнения = Новый Структура("Организация, РежимОтбора, СчетДоверительногоУправления, Период, ВидПериода, ФиксироватьРезультатСверки",
			Организация,
			1, // по счету в/у
			СчетДоверительногоУправления,
			Новый СтандартныйПериод(ПериодСверки, ПериодСверки),
			"День",
			Ложь
		);
		
		ПараметрыФормы	= Новый Структура("ПараметрыЗаполнения, СформироватьПриОткрытии", ПараметрыЗаполнения, Истина); 
		КлючФормы		= Строка(Организация.УникальныйИдентификатор()) + "-" + Строка(СчетДоверительногоУправления.УникальныйИдентификатор()) + Формат(ПериодСверки, "ДФ=-dd.MM.yyyy"); 
		
		ОткрытьФорму("РегистрСведений.ПодтверждениеОперацийБэкОфиса.Форма.ФормаЖурналаПодтверждений", ПараметрыФормы, ЭтаФорма, КлючФормы);
		
	ИначеЕсли Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетБрокераГПБ")
		ИЛИ Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетБрокераБКРегион")
		ИЛИ Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.СводныйОтчетОбОстаткахНаБанковскихСчетах")
		ИЛИ Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетДепозитарияБКРегион")
		ИЛИ Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетДепозитарияДКРегион")
		ИЛИ Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетДепозитарияНСД")
		ИЛИ Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетДепозитарияВТБ")
		ИЛИ Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетДепозитарияИнфинитум")
		ИЛИ Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетДепозитарияСбербанка")
		ИЛИ Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетДепозитарияГПБ")
		ИЛИ Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетРегистратораНРК")
	Тогда
		
		Если Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетБрокераГПБ") Тогда
			ИмяОбъекта = "_СверкаСБрокеромГПБ";
		ИначеЕсли Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетБрокераБКРегион") Тогда
			ИмяОбъекта = "_СверкаСБрокеромБКРегион";	
		ИначеЕсли Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.СводныйОтчетОбОстаткахНаБанковскихСчетах") Тогда
			ИмяОбъекта = "_ОстаткиДенежныхСредств";
		ИначеЕсли Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетДепозитарияБКРегион")
			ИЛИ Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетДепозитарияДКРегион")
			ИЛИ Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетДепозитарияНСД")
			ИЛИ Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетДепозитарияВТБ")
			ИЛИ Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетДепозитарияИнфинитум")
			ИЛИ Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетДепозитарияСбербанка")
			ИЛИ Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетДепозитарияГПБ")
			ИЛИ Основание = ПредопределенноеЗначение("Справочник.ВнешниеСистемы.ОтчетРегистратораНРК") 
		Тогда
			ИмяОбъекта = "_СверкаСДепозитарием";
		КонецЕсли;
		
		ИмяФормыОбработки = ПодключитьВнешнююОбработку(ИмяОбъекта);
		Если Не ЗначениеЗаполнено(ИмяФормыОбработки) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обработка '" + ИмяОбъекта + "' не найдена");
		КонецЕсли;
		
		ПараметрыФормы	= Новый Структура("Организация, ДатаСверки, РежимОтбора, СчетДоверительногоУправления", Организация, ПериодСверки, 1, СчетДоверительногоУправления);
		КлючФормы		= Строка(Организация.УникальныйИдентификатор()) + Формат(ПериодСверки, "ДФ=-dd.MM.yyyy"); 
		
		ОткрытьФорму(ИмяФормыОбработки, ПараметрыФормы, ЭтаФорма, КлючФормы);
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сверка на основании '" + Строка(Основание) + "' не реализована");
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодключитьВнешнююОбработку(ИмяОбъекта)
	
	СсылкаНаОбработку = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта", ИмяОбъекта);	
	
	Если Не ЗначениеЗаполнено(СсылкаНаОбработку) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяПодключенногоОбъекта	= РаботаСДополнительнымиОтчетамиИОбработками.ПодключитьВнешнююОбработку(СсылкаНаОбработку);
	ВидОбъекта				= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбработку, "Вид");
	
	Если ВидОбъекта = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет Тогда
		Возврат "ВнешнийОтчет." + ИмяПодключенногоОбъекта + ".Форма";
	Иначе
		Возврат "ВнешняяОбработка." + ИмяПодключенногоОбъекта + ".Форма";
	КонецЕсли;

КонецФункции

&НаСервереБезКонтекста
Процедура ЗафиксироватьРезультатыСверкиСЖурналомПодтверждений(ДатаНачала, ДатаОкончания, Организация, ОтборКлиентов = Неопределено, ДатаСверки = Неопределено)
	
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатыСверки = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПолучитьРезультатыСверкиСЖурналомПодтверждений(
		ДатаНачала,
		ДатаОкончания,
		Организация,
		ОтборКлиентов
	);
	
	НачатьТранзакцию();	
	
	Для Каждого РезультатСверки Из РезультатыСверки Цикл
		РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.ЗафиксироватьРезультатСверки(
			РезультатСверки.Организация,
			РезультатСверки.СчетДоверительногоУправления,
			РезультатСверки.ПериодСверки,
			Справочники.ВнешниеСистемы.ЖурналПодтвержденийОпераций,
			РезультатСверки.Пройдена,
			Ложь,
			ДатаСверки
		);			
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

#КонецОбласти
