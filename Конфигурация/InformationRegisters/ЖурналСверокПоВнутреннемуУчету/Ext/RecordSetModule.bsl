Процедура ПередЗаписью(Отказ, Замещение)
	
	// Дозаполнение данных
	ТекущийПользователь	= РаботаСПользователями.ТекущийПользователь();
	КэшЗамещающих		= ?(ЭтотОбъект.Количество() > 1, Новый Соответствие, Неопределено);
	
	Для Каждого Запись Из ЭтотОбъект Цикл
		
		Если Не ЗначениеЗаполнено(Запись.Ответственный) Тогда
			Запись.Ответственный = ТекущийПользователь;
		КонецЕсли;
		
		ЗамещающийПользователь = ПолучитьЗамещающегоПользователя(Запись, КэшЗамещающих);
		Если ЗамещающийПользователь <> Неопределено Тогда
			Запись.Ответственный = ЗамещающийПользователь;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьЗамещающегоПользователя(Запись, КэшЗамещающих)
	
	Если КэшЗамещающих <> Неопределено Тогда
		КлючЗамещения = XMLСтрока(Запись.Ответственный) + "_" + Формат(Запись.Период, "ДФ=dd.MM.yyyy");
		
		ЗамещающийПользователь = КэшЗамещающих.Получить(КлючЗамещения);
		Если ЗамещающийПользователь = Ложь Тогда
			Возврат Неопределено;
		ИначеЕсли ЗамещающийПользователь <> Неопределено Тогда 
			Возврат ЗамещающийПользователь;
		КонецЕсли;
	КонецЕсли;
	
	ЗамещающийПользователь = РегистрыСведений.ОтветственныеЗаОперации.ОпределитьОтветственного(Запись.Организация, Метаданные().Имя, Неопределено, Запись.Период, Запись.Ответственный); 
	
	Если КэшЗамещающих <> Неопределено Тогда
		КэшЗамещающих.Вставить(КлючЗамещения, ?(ЗамещающийПользователь = Неопределено, Ложь, ЗамещающийПользователь));
	КонецЕсли;
		
	Возврат ЗамещающийПользователь;
		
КонецФункции