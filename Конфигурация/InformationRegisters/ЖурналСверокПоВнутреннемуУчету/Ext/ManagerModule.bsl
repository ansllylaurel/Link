Функция ЗафиксироватьРезультатСверки(Организация, СчетДоверительногоУправления, ПериодСверки, Основание = Неопределено, Пройдена = Истина, РучнойРежим = Истина, ДатаСверки = Неопределено, Примечание = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(Основание) И ТипЗнч(Основание) <> Тип("СправочникСсылка.ВнешниеСистемы") Тогда
		ВызватьИсключение "Неизвестный тип основания сверки """ + Строка(Основание) + """";		
	КонецЕсли;
	
	РезультатСверки = РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.СоздатьМенеджерЗаписи();
	РезультатСверки.Период							= ?(ДатаСверки = Неопределено, ТекущаяДата(), ДатаСверки);
	РезультатСверки.Организация						= Организация;
	РезультатСверки.СчетДоверительногоУправления	= СчетДоверительногоУправления;
	РезультатСверки.ПериодСверки					= ПериодСверки;
	РезультатСверки.Основание						= Основание;
	РезультатСверки.Пройдена						= Пройдена;
	РезультатСверки.РучнойРежим						= РучнойРежим;	
	РезультатСверки.Примечание						= Примечание;
	РезультатСверки.Записать(Истина);
	
	ЗаписьЖурнала = Новый Структура("Период, Организация, СчетДоверительногоУправления, ПериодСверки, Основание, Ответственный, Пройдена, РучнойРежим, Примечание");
	ЗаполнитьЗначенияСвойств(ЗаписьЖурнала, РезультатСверки);
	
	Возврат ЗаписьЖурнала;
	
КонецФункции

Функция ПолучитьРезультатСверки(Организация, СчетДоверительногоУправления, ПериодСверки, Основание = Неопределено) Экспорт
	
	Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖурналСверокПоВнутреннемуУчетуСрезПоследних.Пройдена КАК Пройдена
		|ИЗ
		|	РегистрСведений.ЖурналСверокПоВнутреннемуУчету.СрезПоследних(
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ПериодСверки = &ПериодСверки
		|				И Основание = &Основание) КАК ЖурналСверокПоВнутреннемуУчетуСрезПоследних
		|");
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ПериодСверки", ПериодСверки);
	Запрос.УстановитьПараметр("Основание", ?(Основание = Неопределено, Справочники.ВнешниеСистемы.ПустаяСсылка(), Основание));
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Возврат РезультатЗапроса.Выгрузить()[0].Пройдена;  	
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

Функция ПолучитьНепройденныеСверкиКлиента(Организация, СчетДоверительногоУправления, ПериодСверки, Период = Неопределено) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Организация КАК Организация,
		|	&СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	&ПериодСверки КАК ПериодСверки,
		|	ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЖурналПодтвержденийОпераций) КАК Основание
		|ПОМЕСТИТЬ _ПлановыеСверкиКлиентов
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	&Организация,
		|	&СчетДоверительногоУправления,
		|	&ПериодСверки,
		|	ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.СводныйОтчетОбОстаткахНаБанковскихСчетах)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	&Организация,
		|	&СчетДоверительногоУправления,
		|	&ПериодСверки,
		|	ВЫБОР
		|		КОГДА КодыКлиентовУБрокеров.Брокер = &БрокерГПБ
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ОтчетБрокераГПБ)
		|		КОГДА КодыКлиентовУБрокеров.Брокер = &БрокерБКРегион
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ОтчетБрокераБКРегион)
		|		ИНАЧЕ ""Отчет брокера "" + КодыКлиентовУБрокеров.Брокер.Наименование
		|	КОНЕЦ
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&ПериодСверки,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КодыКлиентовУБрокеров
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ПериодСверки, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = КодыКлиентовУБрокеров.ДоговорБрокерскогоОбслуживания)
		|ГДЕ
		|	(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &ПериодСверки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_ПлановыеСверкиКлиентов.Основание, ЖурналСверок.Основание) КАК Основание
		|ИЗ
		|	_ПлановыеСверкиКлиентов КАК _ПлановыеСверкиКлиентов
		|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналСверокПоВнутреннемуУчету.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ПериодСверки = &ПериодСверки) КАК ЖурналСверок
		|		ПО (ЖурналСверок.Организация = _ПлановыеСверкиКлиентов.Организация)
		|			И (ЖурналСверок.СчетДоверительногоУправления = _ПлановыеСверкиКлиентов.СчетДоверительногоУправления)
		|			И (ЖурналСверок.ПериодСверки = _ПлановыеСверкиКлиентов.ПериодСверки)
		|			И (ЖурналСверок.Основание = _ПлановыеСверкиКлиентов.Основание)
		|ГДЕ
		|	ЕСТЬNULL(ЖурналСверок.Пройдена, ЛОЖЬ) = ЛОЖЬ");
	
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ПериодСверки",					ПериодСверки);
	
	Запрос.УстановитьПараметр("БрокерГПБ",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ"));
	Запрос.УстановитьПараметр("БрокерБКРегион",					ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион"));
	
	Запрос.УстановитьПараметр("Период",							Период);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Основание");

КонецФункции

#Область Формирование_акта_сверки

// Возвращает табличный документ с актом сверки документов внутреннего учета
//
//	Параметры:
// 		Организация - Организация
//		ДатаСверки - Дата сверки
// 		Ответственный - Строка с ФИО ответственного за сверку
//
Функция ПолучитьАктСверки(Организация, ДатаСверки, Ответственный, Расшифровка = Неопределено) Экспорт
	
	Макет = РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.ПолучитьМакет("АктСверки");
		
	Результат = Новый ТабличныйДокумент;
	
	ПараметрыДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(Новый Структура("Организация, ДатаСверки, Ответственный", Организация, ДатаСверки, Ответственный), "Организация, ДатаСверки, Ответственный");
	
	Механизм = "РегистрСведений.ЖурналСверокПоВнутреннемуУчету.АктСверки";
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыДляСбораСтатистики.Хранилище, ПараметрыДляСбораСтатистики.Описание);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	СформироватьТекстЗапросаДляАктаСверки(Запрос);
	
	Запрос.УстановитьПараметр("ДатаСверки", 				ДатаСверки);
	Запрос.УстановитьПараметр("Организация", 				Организация);
	
	Запрос.УстановитьПараметр("КодыИсключаемыхПортфелей", 	РаботаСКоллекциями.ЗначениеВМассив("О")); // НЕОПРЕДЕЛЁН;
		
	Запрос.УстановитьПараметр("ВидДеятельности", 			Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами);
	Запрос.УстановитьПараметр("ПоследнийРабочийДеньМесяца", Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, КонецМесяца(ДатаСверки), -1));
	
	Запрос.УстановитьПараметр("БрокерБКРегион", 			ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион"));
	Запрос.УстановитьПараметр("БрокерГПБ", 					ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ"));
	
	Запрос.УстановитьПараметр("ДепозитарийБКРегион", 		ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_БК_Регион"));
	Запрос.УстановитьПараметр("ДепозитарийВТБ", 			ОбщегоНазначения.ПолучитьИменованныйОбъект("СпецДепозитарий_ВТБ"));
	Запрос.УстановитьПараметр("ДепозитарийГПБ", 			ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_ГПБ"));
	Запрос.УстановитьПараметр("ДепозитарийДКРегион", 		ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_ДК_Регион"));
	Запрос.УстановитьПараметр("ДепозитарийИнфинитум", 		ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_Инфинитум"));
	Запрос.УстановитьПараметр("ДепозитарийНСД",	 			ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НСД"));
	Запрос.УстановитьПараметр("ДепозитарийНФОТехнологии",	ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НФО_Технологии"));
	Запрос.УстановитьПараметр("ДепозитарийРСД", 			ОбщегоНазначения.ПолучитьИменованныйОбъект("СпецДепозитарий_Сбербанка"));
	Запрос.УстановитьПараметр("ОсновнойКалендарьКотировок",	Константы.ОсновнойКалендарьКотировок.Получить());
	
	Запрос.Выполнить();
		
	ОбластьШапка 	= Макет.ПолучитьОбласть("Шапка");
	ОбластьПодвал 	= Макет.ПолучитьОбласть("Подвал");
	
	ОбластьШапка.Параметры.ДатаСверки 	= Формат(ДатаСверки, "ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.Организация 	= ПолучитьНаименованиеОрганизации(Организация, ДатаСверки);
	
	Результат.Вывести(ОбластьШапка);
		
	ИтогиСверки = Запрос.МенеджерВременныхТаблиц.Таблицы["_ИтогиПоВидамСверки"].ПолучитьДанные().Выгрузить();
	ИтогиСверки.Сортировать("ВидСверки");
	            	
	Для Каждого СтрокаИтога Из ИтогиСверки Цикл
		
		ОбластьСтрока = Макет.ПолучитьОбласть(СтрокаИтога.ВидСверки);
		
		Если СтрокаИтога.Пройдена Тогда
			ОбластьСтрока.Рисунки.Удалить(ОбластьСтрока.Рисунки.Получить(3));
			ОбластьСтрока.Рисунки.Удалить(ОбластьСтрока.Рисунки.Получить(2));		
		Иначе
			ОбластьСтрока.Рисунки.Удалить(ОбластьСтрока.Рисунки.Получить(1));
			ОбластьСтрока.Рисунки.Удалить(ОбластьСтрока.Рисунки.Получить(0));		
		КонецЕсли;
		
		ОбластьСтрока.Параметры.ВремяПоследнейСверки = Формат(СтрокаИтога.ВремяПоследнейСверки, "ДФ='dd.MM.yyyy HH:mm'");		
		Результат.Вывести(ОбластьСтрока);
				
	КонецЦикла;
	
	ОбластьПодвал.Параметры.Ответственный = Ответственный;
	Результат.Вывести(ОбластьПодвал);
	
	// Выводим расшифровку по несверенным, если они есть
	ТаблицаРасшифровки = Запрос.МенеджерВременныхТаблиц.Таблицы["_Расшифровка"].ПолучитьДанные().Выгрузить();
	
	Если ТаблицаРасшифровки.Количество() > 0 Тогда
	
		ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент();
		РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(ПараметрыВывода, ТаблицаРасшифровки, , "Дата сверки " + Формат(ДатаСверки, "ДФ=dd.MM.yyyy"), , Истина);
		РаботаСОтчетами.УстановитьШиринуКолонок(ПараметрыВывода);
		Расшифровка = ПараметрыВывода.ДокументРезультат;
		
	КонецЕсли;	
	
	//Закрываем сессию
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
	Возврат Результат;
	
КонецФункции

Функция ПолучитьНаименованиеОрганизации(Организация, Дата)

	Запрос = Новый Запрос( 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихАнкетныеЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И ЮрФизЛицо = &ЮрФизЛицо
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихАнкетныеЛицСрезПоследних");
	
	Запрос.УстановитьПараметр("Дата", 			Дата);
	Запрос.УстановитьПараметр("Организация", 	Организация);
	Запрос.УстановитьПараметр("ЮрФизЛицо", 		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ЮрФизЛицо"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПолноеНаименованиеПоУставу;
	КонецЕсли; 
	
	Возврат "";
	
КонецФункции

Процедура СформироватьТекстЗапросаДляАктаСверки(Запрос)
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Дата КАК Дата,
		|	ДанныеКалендаря.ВидДня КАК ВидДня
		|ПОМЕСТИТЬ _ДеньСверки
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаря.Дата = &ДатаСверки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЖурналПодтвержденийОпераций) КАК Основание,
		|	""ПодтверждениеОпераций"" КАК ВидСверки
		|ПОМЕСТИТЬ _ВидСверкиПоОснованию
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.СводныйОтчетОбОстаткахНаБанковскихСчетах),
		|	""ОстаткиНаСчетах""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ОтчетБрокераБКРегион),
		|	""ОстаткиНаСчетах""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ОтчетБрокераГПБ),
		|	""ОстаткиНаСчетах""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
