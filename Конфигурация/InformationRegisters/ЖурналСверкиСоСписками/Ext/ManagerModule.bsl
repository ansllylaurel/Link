
#Область Сверка_с_террористами

// Функция - Выполняет сверку юр./физ. лиц со списком террористов
// Результат сверки фиксируется в журнале
// 
// Параметры:
//	ПроверяемыеЛица	 - Массив - (Необязательный) Содержит массив проверяемых юр./физ. лиц
//	ОшибкиСверки	 - Структура - (Необязательный, Выходной) В случае ошибок сверки возвращает структуру с описанием ошибок
//						(см. РаботаСВнешнимиСистемами.ПолучитьРезультатСверкиСоСпискомТеррористовВMatrix) 
//	ОтчетОСверке	 - ТабличныйДокумент - (Необязательный, Выходной) Отчет о результатах сверки
//						Если указан табличный документ, то в него выводится отчет
// 
// Возвращаемое значение:
//	ТаблицаЗначений, Неопределено - таблица успешно прошедших проверку лиц, Неопределено - в случае ошибки
//									(см. возвращаемое значение РаботаСВнешнимиСистемами.ПолучитьРезультатСверкиСоСпискомТеррористовВMatrix)
//
//
Функция ВыполнитьСверкуСоСпискомТеррористовВMatrix(ПроверяемыеЛица = Неопределено, ОшибкиСверки = Неопределено, ОтчетОСверке = Неопределено, ДополнительныеСвойстваЗаписи = Неопределено) Экспорт
	ПроверенныеЛица = РаботаСВнешнимиСистемами.ПолучитьРезультатСверкиСоСпискомТеррористовВMatrix(ПроверяемыеЛица, ОшибкиСверки);
	
	Если ПроверенныеЛица <> Неопределено Тогда	
		ЗаписатьРезультатыСверкиВРегистр(ТекущаяДата(),, Справочники.ВидыПеречнейОбъектов.СписокТеррористов, ПроверенныеЛица, ДополнительныеСвойстваЗаписи);
		
		// Формируем отчет при необходимости
		Если ОтчетОСверке <> Неопределено Тогда
			СформироватьОтчетОСверкеСоСпискомТеррористов(ОтчетОСверке, ПроверенныеЛица, ОшибкиСверки);		
		КонецЕсли;
		
	// Произошли ошибки
	Иначе
		ОтчетОСверке = Неопределено;	
	КонецЕсли;
	
	Возврат ПроверенныеЛица;
КонецФункции

Функция СформироватьОтчетОСверкеСоСпискомТеррористов(ТаблДок, ПроверенныеЛица, ОшибкиСверки)
	// Параметры макета
	Макет = РегистрыСведений.ЖурналСверкиСоСписками.ПолучитьМакет("МакетОтчета");
	ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент(,, Макет, ТаблДок);
	// Найденные совпадения
	НайденныеСовпадения = ПроверенныеЛица.НайтиСтроки(Новый Структура("Пройдена", Ложь));
	Если НайденныеСовпадения.Количество() > 0 Тогда
		РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(
			ПараметрыВывода, 
			НайденныеСовпадения, 
			Новый Структура("НомерСтроки, ЮрФизЛицо, Комментарий", "№ п/п", "Юр. / физ. лицо", "Комментарий"), 
			"Лица, имеющие совпадения со списком террористов");
	КонецЕсли;
	
	// Ошибки поиска кода в системе Матрих
	ОшибкиПоискаКодаВоВнешнейСистеме = Неопределено;	
	Если ОшибкиСверки <> Неопределено И ОшибкиСверки.Свойство("ОшибкиПоискаКодаВоВнешнейСистеме", ОшибкиПоискаКодаВоВнешнейСистеме) Тогда
		РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(
			ПараметрыВывода,
			ОшибкиПоискаКодаВоВнешнейСистеме,
			Новый Структура("НомерСтроки, Ссылка", "№ п/п", "Юр. / физ. лицо"),
			"Ошибки поиска внешнего кода в системе Матрих"
		);
	КонецЕсли;
	
	// Непроверенные лица
	НеПроверенныеЛица = Неопределено;
	Если ОшибкиСверки <> Неопределено И ОшибкиСверки.Свойство("НеПроверенныеЛица", НеПроверенныеЛица) Тогда
		РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(
			ПараметрыВывода,
			НеПроверенныеЛица,
			Новый Структура("НомерСтроки, Ссылка, Комментарий", "№ п/п", "Юр. / физ. лицо", "Комментарий"),
			"Непроверенные лица"
		);
	КонецЕсли;

	// Успешно прошедшие проверки
	ПрошедшиеПроверку = ПроверенныеЛица.НайтиСтроки(Новый Структура("Пройдена", Истина));
	Если ПрошедшиеПроверку.Количество() > 0 Тогда
		РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(
			ПараметрыВывода,
			ПрошедшиеПроверку,
			Новый Структура("НомерСтроки, ЮрФизЛицо, Комментарий", "№ п/п", "Юр. / физ. лицо", "Комментарий"),
			"Лица, прошедшие проверку"
		);
	КонецЕсли;	
	
	// Автоширина колонок
	РаботаСОтчетами.ПодобратьШиринуКолонокТаблицыОтчета(ТаблДок, 1, 2, ТаблДок.ВысотаТаблицы, ТаблДок.ШиринаТаблицы, 60);
	
	// Заполняем настройки печати по умочанию
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ТаблДок, "РезультатСверкиСоСпискомТеррористовВMatrix", Истина, ОриентацияСтраницы.Портрет);	
	
	Возврат ТаблДок;	
КонецФункции

#КонецОбласти

#Область Сверка_с_лицами_с_замороженными_счетами

