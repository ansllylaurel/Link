КонецФункции

#КонецОбласти

#Область Сверка_со_списком_отказников

// Функция - Выполняет сверку юр./физ. лиц со списком отказников
// Результат сверки фиксируется в журнале
// 
// Параметры:
//  Организация - список лиц приходит через ЛК, а значит загружается с отбором по организации
//	ПроверяемыеЛица	 - Массив - (Необязательный) Содержит массив проверяемых юр./физ. лиц
//  ИдентификаторСписка - Число - при запуске сверки пользователь выбирает перечень, при загрузке анкеты юр/физ лица необходимо проверить по всем перечням
//	ОшибкиСверки	 - Структура - (Необязательный, Выходной) В случае ошибок сверки возвращает структуру с описанием ошибок
//						(см. РаботаСВнешнимиСистемами.ПолучитьРезультатСверкиСоСпискомЛицСЗамороженнымиСчетамиВMatrix) 
//	ОтчетОСверке	 - ТабличныйДокумент - (Необязательный, Выходной) Отчет о результатах сверки
//						Если указан табличный документ, то в него выводится отчет
// 
// Возвращаемое значение:
//	ТаблицаЗначений, Неопределено - таблица успешно прошедших проверку лиц, Неопределено - в случае ошибки
//									(см. возвращаемое значение РаботаСВнешнимиСистемами.ПолучитьРезультатСверкиСоСпискомЛицСЗамороженнымиСчетамиВMatrix)
//
//
Функция ВыполнитьСверкуСоСпискомОтказников(Организация, ПроверяемыеЛица = Неопределено, ИдентификаторСписка = 0, ДатаСверки = Неопределено,  ОшибкиСверки = Неопределено, ОтчетОСверке = Неопределено, ДополнительныеСвойстваЗаписи = Неопределено) Экспорт
	
	Если ДатаСверки = Неопределено Тогда
		ДатаСверки = ТекущаяДата();
	КонецЕсли;
	
	ПроверенныеЛица = РаботаСВнешнимиСистемами.ПолучитьРезультатСверкиСоСпискомОтказников(Организация, ДатаСверки, ПроверяемыеЛица, ИдентификаторСписка, ОшибкиСверки);
	
	Если ПроверенныеЛица <> Неопределено Тогда	
		ЗаписатьРезультатыСверкиВРегистр(ДатаСверки, Организация, Справочники.ВидыПеречнейОбъектов.СписокОтказников, ПроверенныеЛица, ДополнительныеСвойстваЗаписи);
		
		// Формируем отчет при необходимости
		Если ОтчетОСверке <> Неопределено Тогда
			СформироватьОтчетОСверкеСоСписком(ОтчетОСверке, ПроверенныеЛица, ОшибкиСверки, "Лица, имеющие совпадения со списоком лиц, которым отказано в операции с ДС, открытии или закрытии депозитного вклада");
		КонецЕсли;
		
	// Произошли ошибки
	Иначе
		ОтчетОСверке = Неопределено;	
	КонецЕсли;
	
	Возврат ПроверенныеЛица;
КонецФункции

Функция ПоказателиСверкиСоСпискомОтказников(ВидЮрФизЛица) Экспорт
	
	Показатели = Новый Массив;
	
	Если ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
		
		Показатели.Добавить("Фамилия");
		Показатели.Добавить("Имя");
		Показатели.Добавить("Отчество");
		Показатели.Добавить("ДатаРождения");
		Показатели.Добавить("ИНН");
		Показатели.Добавить("СерияУдостоверенияЛичности");
		Показатели.Добавить("НомерУдостоверенияЛичности");
		
	ИначеЕсли ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
		
		Показатели.Добавить("ПолноеНаименованиеПоУставу");
		Показатели.Добавить("КраткоеНаименованиеПоУставу");
		Показатели.Добавить("ИНН");
		Показатели.Добавить("ОГРН");
		Показатели.Добавить("TIN");
		
	КонецЕсли;
	
	Возврат Показатели;
	
КонецФункции

#КонецОбласти

#Область Сверка_со_списком_недействительных_паспортов

Функция ВыполнитьСверкуСоСпискомНедействительныхПаспортов(Организация, ПроверяемыеЛица = Неопределено, ОшибкиСверки = Неопределено, ОтчетОСверке = Неопределено, ДополнительныеСвойстваЗаписи = Неопределено) Экспорт
	
	ПроверенныеЛица = РаботаСВнешнимиСистемами.ПолучитьРезультатСверкиСоСпискомНедействительныхПаспортов(Организация, ТекущаяДата(), ПроверяемыеЛица, ОшибкиСверки);
	
	Если ПроверенныеЛица <> Неопределено Тогда	
		// Обновляем данные
		ЗаписатьРезультатыСверкиВРегистр(НачалоДня(ТекущаяДата()), Организация, Справочники.ВидыПеречнейОбъектов.СписокНедействительныхПаспортов, ПроверенныеЛица, ДополнительныеСвойстваЗаписи);
		
		// Формируем отчет при необходимости
		Если ОтчетОСверке <> Неопределено Тогда
			ОтчетОСверке = РезультатыСверкиСоСпискомНедействительныхПаспортов(Организация, Справочники.ВидыПеречнейОбъектов.СписокНедействительныхПаспортов, НачалоДня(ТекущаяДата()), ПроверенныеЛица.ВыгрузитьКолонку("ЮрФизЛицо"));
		КонецЕсли;
		
	// Произошли ошибки
	Иначе
		ОтчетОСверке = Неопределено;	
	КонецЕсли;
	
	Возврат ПроверенныеЛица;
	
КонецФункции

Функция ПоказателиСверкиСоСпискомНедействительныхПаспортов(ВидЮрФизЛица) Экспорт
	
	Показатели = Новый Массив;
	
	Если ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
		
		Показатели.Добавить("СерияУдостоверенияЛичности");
		Показатели.Добавить("НомерУдостоверенияЛичности");

	КонецЕсли;
	
	Возврат Показатели;
	
КонецФункции

Функция ВыполнитьСверкуСоСпискомНедействительныхПаспортовОтложенно(Организация, Субъект) Экспорт

	Если ОбщегоНазначения.ЗначениеПараметраСеанса("ФормированиеДвиженийПоРегистрамБэкОфиса") Тогда
		
		Если ТипЗнч(Субъект) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
			ФизЛицо = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(Субъект, ТекущаяДата());
		ИначеЕсли ТипЗнч(Субъект) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
			ФизЛицо = Субъект;
		Иначе
			ВызватьИсключение "Параметр 'Субъект' может быть либо счетом доверительного управления, либо юр./физ. лицом";
		КонецЕсли;
		
		Если ФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
		
			Параметры = Новый Структура;
			
			Параметры.Вставить("Организация",	Организация);
			Параметры.Вставить("ЮрФизЛицо",		ФизЛицо);
			
			РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание("РегистрыСведений.ЖурналСверкиСоСписками", "ВыполнитьСверкуСоСпискомНедействительныхПаспортов", Параметры, 15, Истина);
		
		КонецЕсли; 
		
	КонецЕсли;

КонецФункции 

Процедура ПроверитьРезультатОтложеннойСверкиСоСпискомНедействительныхПаспортов(Организация, Субъект, ДатаАктуальности, ДатаЗапускаСверки, Отказ) Экспорт

	Если ОбщегоНазначения.ЗначениеПараметраСеанса("ФормированиеДвиженийПоРегистрамБэкОфиса") Тогда
		
		Если ТипЗнч(Субъект) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
			ФизЛицо = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(Субъект, ТекущаяДата());
		ИначеЕсли ТипЗнч(Субъект) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
			ФизЛицо = Субъект;
		Иначе
			ВызватьИсключение "Параметр 'Субъект' может быть либо счетом доверительного управления, либо юр./физ. лицом";
		КонецЕсли;  		
		
		Если ФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
		
			ТекстЗапроса = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЖурналСверкиСоСпискамиСрезПоследних.Период КАК Период,
				|	ЖурналСверкиСоСпискамиСрезПоследних.Пройдена КАК Пройдена
				|ИЗ
				|	РегистрСведений.ЖурналСверкиСоСписками.СрезПоследних(
				|			&ДатаАктуальности,
				|			Организация = &Организация
				|				И ВидПеречня = &ВидПеречня
				|				И ЮрФизЛицо = &ЮрФизЛицо) КАК ЖурналСверкиСоСпискамиСрезПоследних
				|ГДЕ
				|	ЖурналСверкиСоСпискамиСрезПоследних.Пройдена
				|	И ЖурналСверкиСоСпискамиСрезПоследних.Период >= &ДатаЗапускаСверки";
			
			Запрос = Новый Запрос(ТекстЗапроса);
			Запрос.УстановитьПараметр("ДатаАктуальности", 	ДатаАктуальности);
			Запрос.УстановитьПараметр("ДатаЗапускаСверки", 	ДатаЗапускаСверки);
			Запрос.УстановитьПараметр("Организация", 		Организация);
			Запрос.УстановитьПараметр("ВидПеречня", 		Справочники.ВидыПеречнейОбъектов.СписокНедействительныхПаспортов);
			Запрос.УстановитьПараметр("ЮрФизЛицо", 			ФизЛицо);
			
			Результат = Запрос.Выполнить();
			
			Если Результат.Пустой() Тогда
				
				ТекстСообщения = СтрШаблон("Паспорт физического лица '%1' недействителен. Необходимо обновить данные физического лица", ФизЛицо);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ); 
			
			КонецЕсли; 
		
		КонецЕсли;
	
	КонецЕсли; 

КонецПроцедуры 

#КонецОбласти

#Область Сверка_со_списком_дисквалифицированных_лиц

Функция ВыполнитьСверкуСоСпискомДисквалифицированныхЛиц(Организация, ПроверяемыеЛица = Неопределено, ДатаСверки = Неопределено,  ОшибкиСверки = Неопределено, ОтчетОСверке = Неопределено, ДополнительныеСвойстваЗаписи = Неопределено) Экспорт
	
	Если ДатаСверки = Неопределено Тогда
		ДатаСверки = ТекущаяДата();
	КонецЕсли;
	
	ПроверенныеЛица = РаботаСВнешнимиСистемами.ПолучитьРезультатСверкиСоСпискомДисквалифицированныхЛиц(Организация, ДатаСверки, ПроверяемыеЛица);
	
	Если ПроверенныеЛица <> Неопределено Тогда	
		// Обновляем данные
		ЗаписатьРезультатыСверкиВРегистр(ДатаСверки, Организация, Справочники.ВидыПеречнейОбъектов.СписокДисквалифицированныхЛиц, ПроверенныеЛица, ДополнительныеСвойстваЗаписи);
		
		// Формируем отчет при необходимости
		Если ОтчетОСверке <> Неопределено Тогда
			ОтчетОСверке = РезультатыСверкиСоСпискомДисквалифицированныхЛиц(Организация, Справочники.ВидыПеречнейОбъектов.СписокДисквалифицированныхЛиц, НачалоДня(ТекущаяДата()), ПроверенныеЛица.ВыгрузитьКолонку("ЮрФизЛицо")); 
		КонецЕсли;
		
	// Произошли ошибки
	Иначе
		ОтчетОСверке = Неопределено;	
	КонецЕсли;
	
	Возврат ПроверенныеЛица;
	
КонецФункции

Функция ПоказателиСверкиСоСпискомДисквалифицированныхЛиц(ВидЮрФизЛица) Экспорт
	
