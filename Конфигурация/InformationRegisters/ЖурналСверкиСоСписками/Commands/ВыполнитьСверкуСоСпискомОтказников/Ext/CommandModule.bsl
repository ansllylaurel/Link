&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	СписокПеречней = ПолучитьСписокПеречней();
	
	Если СписокПеречней.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Перечень не загружен!");
		Возврат;	
	КонецЕсли;	
	
	ВыбранныйЭлемент = СписокПеречней.ВыбратьЭлемент("Выберите список лиц для сверки");
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтчетОСверке = ВыполнитьСверкуСоСпискомОтказников(ВыбранныйЭлемент.Значение);
	
	Если ОтчетОСверке = Неопределено Тогда
		ПоказатьПредупреждение(, "При выполнении сверки прозошли ошибки!");
		Возврат;	
	КонецЕсли;
	ОтчетОСверке.Показать("Результат сверки со списоком лиц, которым отказано в операции с ДС, открытии или закрытии депозитного вклада");	
	
	ОповеститьОбИзменении(Тип("РегистрСведенийКлючЗаписи.ЖурналСверкиСоСписками"));
КонецПроцедуры

&НаСервере
Функция ВыполнитьСверкуСоСпискомОтказников(ПараметрыСписка)
	
	ОтчетОСверке = Новый ТабличныйДокумент;

	Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	ДополнительныеСвойстваЗаписи = Новый Структура;
	ДополнительныеСвойстваЗаписи.Вставить("ДатаПоследнейСверки", ПараметрыСписка.ДатаСписка + (ТекущаяДата() - НачалоДня(ТекущаяДата()))); // дата списка с текущим временем
	
	РегистрыСведений.ЖурналСверкиСоСписками.ВыполнитьСверкуСоСпискомОтказников(Организация,, ПараметрыСписка.Идентификтор, ПараметрыСписка.ДатаСписка,, ОтчетОСверке, ДополнительныеСвойстваЗаписи);

	Возврат ОтчетОСверке;
	
КонецФункции

&НаСервере
Функция ПолучитьСписокПеречней()
	
	Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");

	УникальныйИдентификаторОрганизации = Строка(Организация.УникальныйИдентификатор());
	Source_Id = 6;
	
	СтрокаСоединения = РаботаСВнешнимиСистемами.СтрокаСоединенияСExternals();
	
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("Идентификтор"	, Новый ОписаниеТипов("Число"));
	ТипыКолонок.Вставить("ИмяФайла"		, Новый ОписаниеТипов("Строка"));
	ТипыКолонок.Вставить("ДатаИмпорта"	, Новый ОписаниеТипов("Дата"));
	ТипыКолонок.Вставить("ДатаСписка"	, Новый ОписаниеТипов("Дата"));
	
	ТекстЗапроса = 
		"SELECT 
		|	Files.id AS Идентификтор,
		|	Files.File_Name AS ИмяФайла,
		|	MAX(Files.Upload_Time) AS ДатаИмпорта,
		|	MAX(RefusalList.Period) AS ДатаСписка
		|FROM
		|	[Externals].[dbo].[Files] AS Files
		|LEFT JOIN
		|	[Externals].[dbo].[RefusalList] AS RefusalList
		|	ON RefusalList.File_Id = Files.Id
		|Where
		|	RefusalList.[Organization] = '&Organization'
		|	AND RefusalList.[Source_Id] = &Source_Id
		|GROUP BY
		|	Files.id,
		|	Files.File_Name
		|ORDER BY
		|	MAX(Files.Upload_Time) Desc";

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Organization"	, УникальныйИдентификаторОрганизации);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Source_Id"		, Source_Id);
	
	РезультатЗапроса = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса, ТипыКолонок);
	
	СписокПеречней = Новый СписокЗначений;
	
	Если РезультатЗапроса <> Неопределено Тогда
		Для Каждого СтрокаРезультата Из РезультатЗапроса Цикл
			ПараметрыСписка = Новый Структура("Идентификтор, ДатаСписка", СтрокаРезультата.Идентификтор, СтрокаРезультата.ДатаСписка);
			СписокПеречней.Добавить(ПараметрыСписка, СтрокаРезультата.ИмяФайла + "(Дата импорта: " + СтрокаРезультата.ДатаИмпорта + ")");
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокПеречней;
	
КонецФункции




