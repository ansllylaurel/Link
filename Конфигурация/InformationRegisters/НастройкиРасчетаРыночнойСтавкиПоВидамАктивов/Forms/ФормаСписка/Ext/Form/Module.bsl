
#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Период = ТекущаяДата();
	Параметры.Отбор.Свойство("Субъект", ЭтаФорма.Субъект);
	
	СписокДействующихНастроекПоСчетуДУ.Параметры.УстановитьЗначениеПараметра("Период", ЭтаФорма.Период);
	СписокДействующихНастроекПоСчетуДУ.Параметры.УстановитьЗначениеПараметра("Субъект", ЭтаФорма.Субъект);
	
	Если ТипЗнч(ЭтаФорма.Субъект) <> Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		ПолеГруппировки = СписокДействующихНастроекПоСчетуДУ.Группировка.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("СчетДоверительногоУправления");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура СписокДействующихНастроекПоСчетуДУВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ПараметрыФормы = Новый Структура("Ключ", СоздатьКлючЗаписиНастройкиРасчетаРыночнойСтавкиПоВидамАктивов(ВыбраннаяСтрока));
	ОткрытьФорму("РегистрСведений.НастройкиРасчетаРыночнойСтавкиПоВидамАктивов.ФормаЗаписи", ПараметрыФормы, ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура Создать(Команда)
	
	ОткрытьФорму("РегистрСведений.НастройкиРасчетаРыночнойСтавкиПоВидамАктивов.ФормаЗаписи",, ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура Копировать(Команда)
	
	ПараметрыФормы	= Новый Структура;
	
	Если Элементы.СписокДействующихНастроекПоСчетуДУ.ТекущиеДанные <> Неопределено Тогда
		ПараметрыФормы.Вставить("ЗначениеКопирования", СоздатьКлючЗаписиНастройкиРасчетаРыночнойСтавкиПоВидамАктивов(Элементы.СписокДействующихНастроекПоСчетуДУ.ТекущиеДанные));
	КонецЕсли;

	ОткрытьФорму("РегистрСведений.НастройкиРасчетаРыночнойСтавкиПоВидамАктивов.ФормаЗаписи", ПараметрыФормы, ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаКлиенте
Функция СоздатьКлючЗаписиНастройкиРасчетаРыночнойСтавкиПоВидамАктивов(Источник)
	
	ПараметрыКлюча = Новый Структура("Период,Организация,Субъект,Субъект,Валюта,ЦельРасчета,ВидАктива,ВидКонтрагента");
	ЗаполнитьЗначенияСвойств(ПараметрыКлюча, Источник);
	
	Возврат СоздатьКлючЗаписиНастройкиРасчетаРыночнойСтавкиПоВидамАктивовНаСервере(ПараметрыКлюча);
	
КонецФункции

&НаСервереБезКонтекста
Функция СоздатьКлючЗаписиНастройкиРасчетаРыночнойСтавкиПоВидамАктивовНаСервере(ПараметрыКлюча)
	
	Возврат РегистрыСведений.НастройкиРасчетаРыночнойСтавкиПоВидамАктивов.СоздатьКлючЗаписи(ПараметрыКлюча);
	
КонецФункции

&НаКлиенте
Процедура НаДатуПриИзменении(Элемент)
	
	СписокДействующихНастроекПоСчетуДУ.Параметры.УстановитьЗначениеПараметра("Период", ЭтаФорма.Период);
	
КонецПроцедуры

#КонецОбласти




