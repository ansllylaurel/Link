
////////////////////////////////////////////////////////////////////////////////
// ПРЕДОПРЕДЕЛЕННЫЕ

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("ОбработкаПроверкиЗаполненияОтказ", Отказ);
	
КонецПроцедуры // ОбработкаПроверкиЗаполнения

Процедура ПередЗаписью(Отказ, Замещение)
	
	// блокирующие проверки
	УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
	
	Для каждого Запись Из ЭтотОбъект Цикл
		
		// у счета не должно быть подчиненных разделов
		Если Запись.ДепозитарныйСчет.ПодчиненныеРазделы Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Депозитарный счет «" + Запись.ДепозитарныйСчет + "» содержит подчиненные разделы",,,, Отказ);
		КонецЕсли;		
		
		// организации в исполнителе и счете должны совпадать
		Если Запись.Организация <> Запись.ДепозитарныйСчет.Организация Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Организация «" + Запись.Организация + "» не совпадает с организацией «" + Запись.ДепозитарныйСчет.Организация
				+ "» выбранной в счете депо «" + Запись.ДепозитарныйСчет + "»",,,, Отказ);
		КонецЕсли;
		
		// если депозитарный счет закрыт, то исполнитель тоже должен быть закрыт
		ДатаЗакрытияСчета = Запись.ДепозитарныйСчет.ДатаЗакрытия;
		
		Если ЗначениеЗаполнено(ДатаЗакрытияСчета) Тогда
			Если Запись.ДатаЗакрытия > ДатаЗакрытияСчета Или Не ЗначениеЗаполнено(Запись.ДатаЗакрытия) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата закрытия исполнителя по счету депо «" + Запись.ДепозитарныйСчет + "» не должна быть позднее даты закрытия счета " + Формат(ДатаЗакрытияСчета, "ДФ=dd.MM.yyyy"),,,, Отказ);
			КонецЕсли;
		КонецЕсли;
		
		Справочники.ДепозитарныеСчета.КонтрольВладельцаСчетаДепо(Запись.ДепозитарныйСчет, Запись.Организация, Отказ); 
		
	КонецЦикла;

КонецПроцедуры // ПередЗаписью
