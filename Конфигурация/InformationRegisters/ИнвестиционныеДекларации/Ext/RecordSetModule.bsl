Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МетаданныеРегистра = ЭтотОбъект.Метаданные();
	
	Для каждого Запись Из ЭтотОбъект Цикл
		
		ЭтоНазначение = ЗначениеЗаполнено(Запись.НазначениеИнвестиционнойДекларации);
		
		Если Запись.Активность И
			(ЭтоНазначение И Не Запись.Действует
				Или Не ЭтоНазначение И Запись.Действует) Тогда
				
			// выводим сообщение, аналогичное стандартному сообщению платформы об ошибке заполнения записи
			
			ЗначенияИзмерений = Новый Массив;
			ЗначенияИзмерений.Добавить(Формат(Запись.Период, "ДФ=dd.MM.yyyy"));
			Для каждого Значение Из МетаданныеРегистра.Измерения Цикл
				ЗначенияИзмерений.Добавить(Запись[Значение.Имя]);
			КонецЦикла; 
			
			ОписаниеОшибки = ?(ЭтоНазначение, 
				"При заполненном поле ""Назначение инвестиционной декларации"" должен быть установлен флаг ""Действует""!", 
				"Если флаг ""Действует"" не установелн, поле ""Назначение инвестиционной декларации"" должно быть пустым!");
			
			ТекстСообщения = СтрШаблон("Запись не верна! %1:" + Символы.ПС + "%2: %3, (Регистр сведений: %4; Номер строки: %5)", 
			    ОписаниеОшибки,
				МетаданныеРегистра.Имя,
				СтрСоединить(ЗначенияИзмерений, ", "), 
				МетаданныеРегистра.Синоним,
				Запись.НомерСтроки);
				
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ); 
		
		КонецЕсли; 
	
	КонецЦикла; 

	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);

КонецПроцедуры

Процедура ПередЗаписью(Отказ, Замещение)
	
	// блокирующие проверки
	УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);

КонецПроцедуры

