&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ЭтаФорма.ЭтоСохраненнаяЗапись = Истина;	
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма, "Запись", "ИсходныйКлючЗаписи", Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.ЭтоКорректировкаЗаписи = (Параметры.Свойство("КорректировкаЗаписи") И Параметры.КорректировкаЗаписи);	
	ЭтаФорма.ЭтоОтменаПодтверждения = (Параметры.Свойство("ОтменаПодтверждения") И Параметры.ОтменаПодтверждения)
											ИЛИ (ЭтаФорма.ЭтоСохраненнаяЗапись И НЕ Запись.Подтверждена);
	
	ЗаполнитьРеквизитыПодтвержденияПИФ();
	
	Если ЭтаФорма.РежимПодтвержденияПИФ > 0 Тогда
		
		Элементы.Основание.Доступность = Ложь;
		Элементы.Основание.РежимВыбораИзСписка = Ложь;
		
	Иначе
		
		ДоступныеОснования = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПолучитьДоступныеОснования();	
		Элементы.Основание.СписокВыбора.ЗагрузитьЗначения(ДоступныеОснования);	
	
	КонецЕсли; 
	
	Если Не ЭтаФорма.ЭтоСохраненнаяЗапись Тогда
		Запись.Подтверждена = Не ЭтаФорма.ЭтоОтменаПодтверждения;
		Запись.РучнойРежим = Истина;
		Если ЭтаФорма.РежимПодтвержденияПИФ > 0 Тогда
			Запись.Основание = "Подтверждено спец. депозитарием";
		КонецЕсли; 		
	КонецЕсли;

	ПриЧтенииСозданииНаСервере();	
	
	ЭтаФорма.ЭтоПолноправныйПользователь = РаботаСПользователями.ЭтоПолноправныйПользователь();
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЭтаФорма.ЭтоСохраненнаяЗапись = Истина;	
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("ПодтверждениеОперации", Запись.Операция);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	Если Не ЗавершениеРаботы Тогда
		Если ТекущаяЗаписьУдалена(Запись.ИсходныйКлючЗаписи) Тогда
			Оповестить("ПодтверждениеОперации", Запись.Операция);
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПодтвердитьОперацию(Команда)

	Если ЭтоСохраненнаяЗапись Тогда	
		
		ОповещениеПриЗакрытииДочернегоОкна = Новый ОписаниеОповещения("ПриЗакрытииДочернегоОкна", ЭтаФорма);
		
		ЗначенияЗаполнения = Новый Структура("Операция, Организация, Основание", Запись.Операция, Запись.Организация, Запись.Основание);
		ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
		
		ОткрытьФорму("РегистрСведений.ПодтверждениеОперацийБэкОфиса.ФормаЗаписи", ПараметрыФормы, ЭтаФорма, , , , ОповещениеПриЗакрытииДочернегоОкна, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		Если Не ПроверитьКорректностьДанных() Тогда
			Возврат;
		КонецЕсли;
		
		Если ЭтаФорма.РежимПодтвержденияПИФ = 2 Тогда
		
			ВыводитьПредупреждение = Ложь;
			
			Для каждого СтрокаСверкаСИнтерфакс Из ЭтаФорма.СверкаСИнтерфакс Цикл
				Если СтрокаСверкаСИнтерфакс.ЗначениеПоДанным1С <> СтрокаСверкаСИнтерфакс.ЗначениеПоДаннымИнтерфакс Тогда
					ВыводитьПредупреждение = Истина;
					Прервать;
				КонецЕсли; 
			КонецЦикла; 
			
			Если ВыводитьПредупреждение И Вопрос("Данные Интерфакс не совпадают с данными 1С. Подтвердить операцию?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
				Возврат;
			КонецЕсли; 
		
		КонецЕсли; 
		
		ЭтаФорма.Записать();
		ЭтаФорма.Закрыть(Истина);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаОтменитьПодтверждение(Команда)
	
	Если ЭтоСохраненнаяЗапись Тогда
		
		ОповещениеПриЗакрытииДочернегоОкна = Новый ОписаниеОповещения("ПриЗакрытииДочернегоОкна", ЭтаФорма);
		
		ЗначенияЗаполнения = Новый Структура("Операция, Организация, Основание", Запись.Операция, Запись.Организация, Запись.Основание);
		ПараметрыФормы = Новый Структура("ЗначенияЗаполнения, ОтменаПодтверждения", ЗначенияЗаполнения, Истина);
		
		ОткрытьФорму("РегистрСведений.ПодтверждениеОперацийБэкОфиса.ФормаЗаписи", ПараметрыФормы, ЭтаФорма, , , , ОповещениеПриЗакрытииДочернегоОкна, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе	
		
		Если Не ПроверитьКорректностьДанных() Тогда
			Возврат;
		КонецЕсли;
		
		ЭтаФорма.Записать();
		ЭтаФорма.Закрыть(Истина);	
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСохранитьИЗакрыть(Команда)

	Если Не ПроверитьКорректностьДанных() Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.Записать();
	ЭтаФорма.Закрыть(Истина);	
	
КонецПроцедуры	

&НаКлиенте
Процедура КомандаПодтвердитьИОтправить(Команда)
	
	Если Не ПроверитьКорректностьДанных() Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.Записать();
	
	Если Отправить() Тогда
		ПоказатьПредупреждение(Новый ОписаниеОповещения("КомандаПодтвердитьИОтправитьЗавершение", ЭтотОбъект, Новый Структура("ЗакрытьФорму", Истина)), "Выгрузка завершена");
	Иначе
		ЭтаФорма.ЭтоКорректировкаЗаписи = Истина;
		ЭтаФорма.ЭтоСохраненнаяЗапись = Истина;	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтправить(Команда)
	
	Если Не ЭтаФорма.ЭтоПодтверждениеПоследнейСЧА Тогда
		Если ЭтоПолноправныйПользователь Тогда
			ПоказатьВопрос(Новый ОписаниеОповещения("КомандаОтправитьЗавершение", ЭтотОбъект), "Внимание! Дата последнего расчета СЧА отличается от даты документа. Выполнить отправку на сайт?", РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет, "Внимание!");
		Иначе
			ДатаДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.Операция, "Дата");
			ПоказатьПредупреждение(Неопределено, СтрШаблон("Отправка возможна только за %1. Если необходимо выполнить отправку за %2 - обратитесь к администратору", Формат(ЭтаФорма.ДатаРасчетаСЧАНаТекущийМомент, "ДФ=dd.MM.yyyy"), Формат(ДатаДокумента, "ДФ=dd.MM.yyyy")));
		КонецЕсли; 
	Иначе
		ОтправитьБезПодтверждения();
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтправитьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ОтправитьБезПодтверждения();
	КонецЕсли; 

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьБезПодтверждения()
	
	Если Отправить() Тогда
		ПоказатьПредупреждение(Новый ОписаниеОповещения("КомандаПодтвердитьИОтправитьЗавершение", ЭтотОбъект, Новый Структура("ЗакрытьФорму", Ложь)), "Выгрузка завершена");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаПодтвердитьИОтправитьЗавершение(ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.ЗакрытьФорму Тогда
		ЭтаФорма.Закрыть(Истина);
	КонецЕсли; 

КонецПроцедуры

#Область Вспомогательные_функции

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ТребуетсяОтправка = (ЭтаФорма.РежимПодтвержденияПИФ = 3 И ЭтаФорма.ЭтоПодтверждениеПоследнейСЧА)
			Или (ЭтаФорма.РежимПодтвержденияПИФ = 4 И ЭтаФорма.ДатаРасчетаСЧА >= '20210226')
			Или ЭтаФорма.РежимПодтвержденияПИФ = 5;
	
	Если ЭтаФорма.ЭтоКорректировкаЗаписи Тогда
	
		Элементы.ФормаПодтвердитьОперацию.Видимость				= Ложь;
		Элементы.ФормаКомандаПодтвердитьИОтправить.Видимость	= Ложь;
		Элементы.ФормаОтменитьПодтверждение.Видимость			= Ложь;
		Элементы.ФормаСохранитьИЗакрыть.Видимость				= Истина;	
		Элементы.ПредставлениеСтатуса.Видимость					= Ложь;
		Элементы.ГруппаПодтверждение.Видимость					= Истина;
		Элементы.ФормаКомандаОтправить.Видимость				= ТребуетсяОтправка И (ЭтоСохраненнаяЗапись <> ЭтоОтменаПодтверждения);
			
	Иначе
		
		Элементы.ФормаПодтвердитьОперацию.Видимость				= (ЭтоСохраненнаяЗапись = ЭтоОтменаПодтверждения) И Не ТребуетсяОтправка;
		Элементы.ФормаКомандаПодтвердитьИОтправить.Видимость	= (ЭтоСохраненнаяЗапись = ЭтоОтменаПодтверждения) И ТребуетсяОтправка;
		Элементы.ФормаОтменитьПодтверждение.Видимость			= (ЭтоСохраненнаяЗапись <> ЭтоОтменаПодтверждения);
		Элементы.ФормаСохранитьИЗакрыть.Видимость				= Ложь;	
		Элементы.ПредставлениеСтатуса.Видимость					= Истина;
		Элементы.ГруппаПодтверждение.Видимость					= Ложь;
		Элементы.ФормаКомандаОтправить.Видимость				= Ложь;
				
	КонецЕсли; 
	
	Элементы.ГруппаРеквизитыПодтвержденияПИФ.Видимость = ЭтаФорма.РежимПодтвержденияПИФ > 0;
	
	Элементы.ФормаПодтвердитьОперацию.КнопкаПоУмолчанию				= (Не ЭтаФорма.ЭтоКорректировкаЗаписи И Не ЭтоСохраненнаяЗапись И Не ЭтоОтменаПодтверждения И Не ТребуетсяОтправка);
	Элементы.ФормаКомандаПодтвердитьИОтправить.КнопкаПоУмолчанию	= (Не ЭтаФорма.ЭтоКорректировкаЗаписи И Не ЭтоСохраненнаяЗапись И Не ЭтоОтменаПодтверждения И ТребуетсяОтправка);
	Элементы.ФормаОтменитьПодтверждение.КнопкаПоУмолчанию			= (Не ЭтаФорма.ЭтоКорректировкаЗаписи И Не ЭтоСохраненнаяЗапись И ЭтоОтменаПодтверждения);
	
	Элементы.ФормаЗакрыть.КнопкаПоУмолчанию							= (Не ЭтаФорма.ЭтоКорректировкаЗаписи И ЭтоСохраненнаяЗапись);	
	Элементы.ФормаСохранитьИЗакрыть.КнопкаПоУмолчанию				= ЭтаФорма.ЭтоКорректировкаЗаписи;	
	
	ЭтаФорма.ТолькоПросмотр			= (Не ЭтаФорма.ЭтоКорректировкаЗаписи И ЭтоСохраненнаяЗапись);
	ЭтаФорма.Заголовок				= ?(ЭтоСохраненнаяЗапись, "Запись журнала подтверждений", ?(ЭтоОтменаПодтверждения, "Отмена подтверждения операции", "Подтверждение операции"));
	ЭтаФорма.ПредставлениеСтатуса	= ?(ЭтоСохраненнаяЗапись, ?(ЭтоОтменаПодтверждения, "Не подтверждена", "Подтверждена" + ?(Запись.РучнойРежим, " вручную", "")) , "");
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьКорректностьДанных()
	
	Отказ = Ложь;	
	
	Если Запись.Подтверждена И Не ЗначениеЗаполнено(Запись.Основание) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Основание""", , "Запись.Основание", , Отказ);		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Запись.Период) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Время записи""", , "Запись.Период", , Отказ);		
	КонецЕсли;	
	
	Если Не Отказ И Запись.Подтверждена Тогда
		ВремяОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.Операция, "Дата");
		
		Если Запись.Период < ВремяОперации Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Время подтверждения не должно быть раньше времени операции " + Строка(ВремяОперации), , , , Отказ);		
		КонецЕсли;
	КонецЕсли;	
	
	Если Не Отказ Тогда
		
		Если ЭтоСохраненнаяЗапись Тогда
			
			ИсходнаяЗапись		= ПолучитьИсходнуюЗапись(Запись.ИсходныйКлючЗаписи);
			ВремяКрайнейЗаписи	= Неопределено;
			
			Если ЭтоПерваяЗапись(ИсходнаяЗапись) Тогда
				Если ЕстьБолееРанниеЗаписи(ИсходнаяЗапись, Запись.Период, ВремяКрайнейЗаписи) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Время записи должно быть раньше " + Строка(ВремяКрайнейЗаписи), , , , Отказ);		
				КонецЕсли;
			ИначеЕсли ЭтоПоследняяЗапись(ИсходнаяЗапись) Тогда
				Если ЕстьБолееПоздниеЗаписи(ИсходнаяЗапись, Запись.Период, ВремяКрайнейЗаписи) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Время записи должно быть позже " + Строка(ВремяКрайнейЗаписи), , , , Отказ);		
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			
			ПоследняяЗаписьЖурналаПодтверждений = ПолучитьПоследнююЗаписьЖурналаПодтверждений(Запись.Операция);
			Если ПоследняяЗаписьЖурналаПодтверждений <> Неопределено Тогда
				Если ЭтоОтменаПодтверждения <> ПоследняяЗаписьЖурналаПодтверждений.Подтверждена Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запись о подтверждении\отмене подтверждения внесена другим пользователем " + Строка(ПоследняяЗаписьЖурналаПодтверждений.Период), , , , Отказ);		
				ИначеЕсли ПоследняяЗаписьЖурналаПодтверждений.Период >= Запись.Период Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Время добавляемой записи " + Строка(Запись.Период) + " должно быть позже времени последней записи журнала " + Строка(ПоследняяЗаписьЖурналаПодтверждений.Период), , , , Отказ);		
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат (Не Отказ); 	
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИсходнуюЗапись(КлючЗаписи)
	
	ИсходнаяЗапись = Новый Структура("Организация, Операция, Период");
	
	ЗаполнитьЗначенияСвойств(ИсходнаяЗапись, КлючЗаписи); 
	
	Возврат ИсходнаяЗапись;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоПерваяЗапись(ИсходнаяЗапись)
	
	ПерваяЗапись = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПолучитьПервуюЗаписьЖурналаПодтверждений(ИсходнаяЗапись.Операция);	
	Если ЗначениеЗаполнено(ПерваяЗапись) И ПерваяЗапись.Период <> ИсходнаяЗапись.Период Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЕстьБолееРанниеЗаписи(ИсходнаяЗапись, НовоеВремяЗаписи, ВремяКрайнейЗаписи = Неопределено)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ПодтверждениеОперацийБэкОфиса.Период КАК Период
		|ИЗ
		|	РегистрСведений.ПодтверждениеОперацийБэкОфиса КАК ПодтверждениеОперацийБэкОфиса
		|ГДЕ
		|	ПодтверждениеОперацийБэкОфиса.Операция = &Операция
		|	И ПодтверждениеОперацийБэкОфиса.Организация = &Организация
		|	И ПодтверждениеОперацийБэкОфиса.Период <> &Период
		|	И ПодтверждениеОперацийБэкОфиса.Период <= &НовоеВремяЗаписи
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПодтверждениеОперацийБэкОфиса.Период");
	Запрос.УстановитьПараметр("Операция", ИсходнаяЗапись.Операция);
	Запрос.УстановитьПараметр("Организация", ИсходнаяЗапись.Организация);
	Запрос.УстановитьПараметр("Период", ИсходнаяЗапись.Период);
	Запрос.УстановитьПараметр("НовоеВремяЗаписи", НовоеВремяЗаписи);	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ВремяКрайнейЗаписи = Неопределено;
		Возврат Ложь;
	Иначе
		ВремяКрайнейЗаписи = РезультатЗапроса.Выгрузить()[0].Период;
		Возврат Истина;
	КонецЕсли;	

КонецФункции

&НаСервереБезКонтекста
Функция ЭтоПоследняяЗапись(ИсходнаяЗапись)
	
	ПоследняяЗапись = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПолучитьПоследнююЗаписьЖурналаПодтверждений(ИсходнаяЗапись.Операция);	
	Если ЗначениеЗаполнено(ПоследняяЗапись) И ПоследняяЗапись.Период <> ИсходнаяЗапись.Период Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЕстьБолееПоздниеЗаписи(ИсходнаяЗапись, НовоеВремяЗаписи, ВремяКрайнейЗаписи = Неопределено)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ПодтверждениеОперацийБэкОфиса.Период КАК Период
		|ИЗ
		|	РегистрСведений.ПодтверждениеОперацийБэкОфиса КАК ПодтверждениеОперацийБэкОфиса
		|ГДЕ
		|	ПодтверждениеОперацийБэкОфиса.Операция = &Операция
		|	И ПодтверждениеОперацийБэкОфиса.Организация = &Организация
		|	И ПодтверждениеОперацийБэкОфиса.Период <> &Период
		|	И ПодтверждениеОперацийБэкОфиса.Период >= &НовоеВремяЗаписи
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПодтверждениеОперацийБэкОфиса.Период УБЫВ");
	Запрос.УстановитьПараметр("Операция", ИсходнаяЗапись.Операция);
	Запрос.УстановитьПараметр("Организация", ИсходнаяЗапись.Организация);
	Запрос.УстановитьПараметр("Период", ИсходнаяЗапись.Период);
	Запрос.УстановитьПараметр("НовоеВремяЗаписи", НовоеВремяЗаписи);	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ВремяКрайнейЗаписи = Неопределено;
		Возврат Ложь;
	Иначе
		ВремяКрайнейЗаписи = РезультатЗапроса.Выгрузить()[0].Период;
		Возврат Истина;
	КонецЕсли;	
	
КонецФункции

