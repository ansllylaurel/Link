	МенеждерЗаписи.Прочитать();
	
	Возврат Не МенеждерЗаписи.Выбран();
	
КонецФункции
 
&НаСервере
Процедура ЗаполнитьРеквизитыПодтвержденияПИФ()

	ЭтаФорма.РежимПодтвержденияПИФ = 0;
	Элементы.ГруппаСверкаСИнтерфакс.Видимость = Ложь;
	
	Если ТипЗнч(Запись.Операция) = Тип("ДокументСсылка.РегистрацияСтоимостиАктивов") Тогда
		
		// Режммы работы формы для разных ПИФов:
		// 0. Обычная форма подтверждения (не ПИФ)
		// 1. Отправка не поддерживается (закрытый ПИФ, паи не торгуются на бирже)
		// 2. Необходима сверка с Интерфаксом (паи торгуются на бирже)
		// 3. Поддерживается выгрузка в матрикс и на сайт в момент подтверждения (открытый ПИФ, паи не торгуются на бирже либо данные уже отправлены на сайт Интерфакс и совпадают с данными системы)
		// 4. Поддерживается выгрузка в матрикс и отправка оповещений в момент подтверждения (закрытый ПИФ, предназначенный для квалифицированных инвесторов)
		// 5. Поддерживается выгрузка в матрикс, на сайт и отправка оповещений в момент подтверждения (закрытый ПИФ, прописан адрес сайта)
		
		Запрос = Новый Запрос;
		РеквизитыРСА = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Запись.Операция, "Организация, СчетДоверительногоУправления, Дата");
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", РеквизитыРСА.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("Организация", РеквизитыРСА.Организация);
		Запрос.УстановитьПараметр("Период", РеквизитыРСА.Дата);
		
		#Область ТекстЗапроса
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ПаевыеИнвестиционныеФонды.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Закрытый) КАК Закрытый,
			|	ЕСТЬNULL(СтатусыЦенныхБумагСрезПоследних.Активен, ЛОЖЬ) КАК ТоргуетсяНаБирже,
			|	ЗначенияДополнительныхСведенийИнтерфакс.Значение КАК АдресСайтаИнтерфакс,
			|	ЕСТЬNULL(ЗначенияДополнительныхСведенийСайт.Значение, """") КАК АдресСайтаПИФ,
			|	УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.ПредназначенДляКвалИнвесторов КАК ПредназначенДляКвалИнвесторов
			|ИЗ
			|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПаевыеИнвестиционныеФонды КАК ПаевыеИнвестиционныеФонды
			|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = ПаевыеИнвестиционныеФонды.Ссылка
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
			|		ПО (Паи.ПаевойИнвестиционныйФонд = КлиентыДоверительногоУправленияСрезПоследних.Клиент)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг.СрезПоследних(
			|				&Период,
			|				Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
			|					И Статус = ЗНАЧЕНИЕ(Перечисление.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже)) КАК СтатусыЦенныхБумагСрезПоследних
			|		ПО (Паи.Ссылка = СтатусыЦенныхБумагСрезПоследних.ЦеннаяБумага)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийИнтерфакс
			|		ПО (ЗначенияДополнительныхСведенийИнтерфакс.Объект = &Организация)
			|			И (ЗначенияДополнительныхСведенийИнтерфакс.Свойство.Ключ = ""Обработка.ОтправкаДанныхПИФНаСайтИнтерфакс"")
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийСайт
			|		ПО (ЗначенияДополнительныхСведенийСайт.Объект = &СчетДоверительногоУправления)
			|			И (ЗначенияДополнительныхСведенийСайт.Свойство.Ключ = ""Обработка.ОтправкаДанныхПИФНаСайт"")
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияПравилПаевогоИнвестиционногоФонда.СрезПоследних(&Период, ) КАК УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних
			|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.ПаевойИнвестиционныйФонд";			
		#КонецОбласти 
		
		ЭтоРПИ = РеквизитыРСА.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ");
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
		
			ЭтаФорма.ДатаРасчетаСЧА = РеквизитыРСА.Дата;
			ЭтаФорма.ПредыдущаяДатаРасчетаСЧА = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПредыдущегоРасчетаСЧА(РеквизитыРСА.СчетДоверительногоУправления, РеквизитыРСА.Дата);
			
			Если ЭтоРПИ Тогда
				// хардкод: В УКПИ бывают ЗПИФ с ежедневными расчётом СЧА, выгрузкой на сайт и в Матрикс
				// А есть, которые торгуются на бирже, но выгружаются ежемесячно, в т.ч. на Интерфакс
				Если Выборка.Закрытый Тогда
					ЭтаФорма.ДатаРасчетаСЧАНаТекущийМомент = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПредыдущегоРасчетаСЧА(РеквизитыРСА.СчетДоверительногоУправления, НачалоДня(ТекущаяДатаСеанса()), Ложь);
					ЭтаФорма.ЭтоПодтверждениеПоследнейСЧА = (ЭтаФорма.ДатаРасчетаСЧАНаТекущийМомент = НачалоДня(РеквизитыРСА.Дата));
					Если (ЭтаФорма.ЭтоПодтверждениеПоследнейСЧА) И (Не ПустаяСтрока(Выборка.АдресСайтаПИФ)) Тогда
						Если ДанныеНаСайтВыгружены(РеквизитыРСА.Организация, РеквизитыРСА.СчетДоверительногоУправления, Выборка.АдресСайтаПИФ) Тогда
							ЭтаФорма.РежимПодтвержденияПИФ = 4;
						Иначе
							ЭтаФорма.РежимПодтвержденияПИФ = 5;
						КонецЕсли;
					ИначеЕсли ЭтаФорма.ЭтоПодтверждениеПоследнейСЧА И Выборка.ПредназначенДляКвалИнвесторов Тогда
						ЭтаФорма.РежимПодтвержденияПИФ = 4;
					Иначе
						ЭтаФорма.РежимПодтвержденияПИФ = 1;
					КонецЕсли;
				Иначе
					ЭтаФорма.ДатаРасчетаСЧАНаТекущийМомент = РегистрыСведений.НастройкиФормированияСЧА.ПолучитьБлижайшуюДатуФормированияСЧА(РеквизитыРСА.Организация, РеквизитыРСА.СчетДоверительногоУправления, НачалоДня(ТекущаяДатаСеанса())-1);
					ЭтаФорма.ЭтоПодтверждениеПоследнейСЧА = (ЭтаФорма.ДатаРасчетаСЧАНаТекущийМомент = НачалоДня(РеквизитыРСА.Дата));
					ЭтаФорма.РежимПодтвержденияПИФ = 3;
				КонецЕсли; 

				Если ЭтаФорма.ЭтоПодтверждениеПоследнейСЧА Тогда
					Если Выборка.ТоргуетсяНаБирже И Не ДанныеНаСайтеИнтерфаксКорректны(Выборка, РеквизитыРСА) Тогда
						ЭтаФорма.РежимПодтвержденияПИФ = 2;
					КонецЕсли;
					Элементы.ГруппаСверкаСИнтерфакс.Видимость = Выборка.ТоргуетсяНаБирже И (Не ПустаяСтрока(Выборка.АдресСайтаИнтерфакс));
					Элементы.КомандаПолучитьДанныеИнтерфаксИзБуфераОбмена.Видимость = (ЭтаФорма.РежимПодтвержденияПИФ = 2);
				КонецЕсли;
				
				Элементы.ДекорацияБиржевойПИФ_2.Видимость         = (ЭтаФорма.РежимПодтвержденияПИФ = 2);
				Элементы.ДекорацияКартинкаБиржевойПИФ_2.Видимость = (ЭтаФорма.РежимПодтвержденияПИФ = 2);
				Элементы.ДекорацияБиржевойПИФ_3.Видимость         = (ЭтаФорма.РежимПодтвержденияПИФ = 3);
				
				Если ЭтаФорма.ДатаРасчетаСЧАНаТекущийМомент = НачалоДня(РеквизитыРСА.Дата) Тогда
					Элементы.ДатаРасчетаСЧАНаТекущийМомент.ЦветТекста = WebЦвета.Зеленый;
				КонецЕсли; 
			Иначе
				Если Выборка.Закрытый Тогда
					// хардкод: ЗПИФ по методике рассчитывается в последний рабочий день месяца. СЧА на сайт не выгружаем
					ЭтаФорма.ДатаРасчетаСЧАНаТекущийМомент = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоМесяца(ТекущаяДатаСеанса())-1);
					Если Выборка.ПредназначенДляКвалИнвесторов Тогда
						ЭтаФорма.РежимПодтвержденияПИФ = 4;
					Иначе
						ЭтаФорма.РежимПодтвержденияПИФ = 1;
					КонецЕсли; 
				Иначе
					ЭтаФорма.ДатаРасчетаСЧАНаТекущийМомент = РегистрыСведений.НастройкиФормированияСЧА.ПолучитьБлижайшуюДатуФормированияСЧА(РеквизитыРСА.Организация, РеквизитыРСА.СчетДоверительногоУправления, НачалоДня(ТекущаяДатаСеанса())-1);
					ЭтаФорма.ЭтоПодтверждениеПоследнейСЧА  = (ЭтаФорма.ДатаРасчетаСЧАНаТекущийМомент = НачалоДня(РеквизитыРСА.Дата));
					ЭтаФорма.РежимПодтвержденияПИФ = 3;
				КонецЕсли; 
										
				Если Выборка.ТоргуетсяНаБирже И Не ДанныеНаСайтеИнтерфаксКорректны(Выборка, РеквизитыРСА) Тогда
					ЭтаФорма.РежимПодтвержденияПИФ = 2;
				КонецЕсли;
				
				Элементы.ГруппаСверкаСИнтерфакс.Видимость = Выборка.ТоргуетсяНаБирже;
				Элементы.КомандаПолучитьДанныеИнтерфаксИзБуфераОбмена.Видимость = (ЭтаФорма.РежимПодтвержденияПИФ = 2);
				
				Элементы.ДекорацияБиржевойПИФ_2.Видимость         = (ЭтаФорма.РежимПодтвержденияПИФ = 2);
				Элементы.ДекорацияКартинкаБиржевойПИФ_2.Видимость = (ЭтаФорма.РежимПодтвержденияПИФ = 2);
				Элементы.ДекорацияБиржевойПИФ_3.Видимость         = (ЭтаФорма.РежимПодтвержденияПИФ = 3);
				
				Если ЭтаФорма.ДатаРасчетаСЧАНаТекущийМомент = НачалоДня(РеквизитыРСА.Дата) Тогда
					Элементы.ДатаРасчетаСЧАНаТекущийМомент.ЦветТекста = WebЦвета.Зеленый;
				КонецЕсли; 
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЕсли; 

КонецПроцедуры

&НаСервере
Функция ДанныеНаСайтВыгружены(Организация, СчетДоверительногоУправления, АдресСайтаПИФ)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период", ЭтаФорма.ДатаРасчетаСЧА);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказатели.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|ГДЕ
		|	ФинансовыеПоказатели.Активность
		|	И ФинансовыеПоказатели.Период = &Период
		|	И ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
		|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|;";
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтоимостиССайтаКомпании = Обработки.ОтправкаДанныхПИФНаСайт.ПолучитьСтоимостиССайтаКомпании(Организация, АдресСайтаПИФ, ЭтаФорма.ДатаРасчетаСЧА);
		Если СтоимостиССайтаКомпании.СЧА = Выборка.Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

&НаСервере
Функция ДанныеНаСайтеИнтерфаксКорректны(ДанныеПИФ, ДанныеРСА)

	Если ПустаяСтрока(ДанныеПИФ.АдресСайтаИнтерфакс) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЮрФизЛицо", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеРСА.Организация, "ЮрФизЛицо"));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ДанныеРСА.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период", ЭтаФорма.ДатаРасчетаСЧА);
	Запрос.УстановитьПараметр("ПредыдущийПериод", ЭтаФорма.ПредыдущаяДатаРасчетаСЧА);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказатели.Период КАК Период,
		|	ФинансовыеПоказатели.ВидПоказателя КАК ВидПоказателя,
		|	ФинансовыеПоказатели.Значение КАК Значение
		|ПОМЕСТИТЬ _ФинансовыеПоказатели
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|ГДЕ
		|	ФинансовыеПоказатели.Активность
		|	И ФинансовыеПоказатели.Период В (&Период, &ПредыдущийПериод)
		|	И ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
		|	И ФинансовыеПоказатели.ВидПоказателя В (ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьПая), ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	ЕСТЬNULL(_СЧА.Значение, 0) КАК СЧА,
		|	ЕСТЬNULL(_СтоимостьПая.Значение, 0) КАК СтоимостьПая,
		|	ЕСТЬNULL(_ПредыдущаяСЧА.Значение, 0) КАК ПредыдущаяСЧА,
		|	ЕСТЬNULL(_ПредыдущаяСтоимостьПая.Значение, 0) КАК ПредыдущаяСтоимостьПая
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо = &ЮрФизЛицо) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ФинансовыеПоказатели КАК _СЧА
		|		ПО (_СЧА.Период = &Период)
		|			И (_СЧА.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ФинансовыеПоказатели КАК _СтоимостьПая
		|		ПО (_СтоимостьПая.Период = &Период)
		|			И (_СтоимостьПая.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьПая))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ФинансовыеПоказатели КАК _ПредыдущаяСЧА
		|		ПО (_ПредыдущаяСЧА.Период = &ПредыдущийПериод)
		|			И (_ПредыдущаяСЧА.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ФинансовыеПоказатели КАК _ПредыдущаяСтоимостьПая
		|		ПО (_ПредыдущаяСтоимостьПая.Период = &ПредыдущийПериод)
		|			И (_ПредыдущаяСтоимостьПая.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьПая))";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Выборка.Следующий();
	Отказ = Ложь;
	
	СтоимостиССайтаИнтерфакс = РаботаСВнешнимиСистемамиКлиентСервер.ПолучиьСтоимостиССайтаИнтерфакс(ДанныеПИФ.АдресСайтаИнтерфакс, Выборка.ПолноеНаименованиеПоУставу, ЭтаФорма.ДатаРасчетаСЧА, ЭтаФорма.ПредыдущаяДатаРасчетаСЧА);
	ЭтаФорма.СверкаСИнтерфакс.Очистить();
	
	Для каждого КлючЗначение Из СтоимостиССайтаИнтерфакс Цикл
		
		НоваяСтрока = ЭтаФорма.СверкаСИнтерфакс.Добавить();
		НоваяСтрока.Ключ = КлючЗначение.Ключ;
		НоваяСтрока.Показатель = ПолучитьИмяПоказателя(КлючЗначение.Ключ);
		НоваяСтрока.ЗначениеПоДанным1С = Выборка[КлючЗначение.Ключ];
		НоваяСтрока.ЗначениеПоДаннымИнтерфакс = КлючЗначение.Значение;
		
		Отказ = Отказ Или (КлючЗначение.Значение <> Выборка[КлючЗначение.Ключ]);
		
	КонецЦикла; 
	
	Возврат Не Отказ;

КонецФункции

&НаСервере
Функция ПолучитьИмяПоказателя(Ключ)

	Период = ?(СтрНачинаетсяС(Ключ, "Предыдущая"), ЭтаФорма.ПредыдущаяДатаРасчетаСЧА, ЭтаФорма.ДатаРасчетаСЧА);
	ИмяПоказателя = ?(СтрЗаканчиваетсяНа(Ключ, "СЧА"), "Стоимость чистых активов, руб., на ", "Расчетная стоимость инвестиционного пая руб, на ");
	
	Возврат ИмяПоказателя + Формат(Период, "ДФ=dd.MM.yyyy")

КонецФункции
 
&НаКлиенте
Функция Отправить()

	ДатаВыгрузки = ТекущаяДата();
	Если Не (ВвестиДату(ДатаВыгрузки, "Дата публикации на сайте") И ЗначениеЗаполнено(ДатаВыгрузки)) Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	РеквизитыОперации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Запись.Операция, "Организация, Дата, СчетДоверительногоУправления");
	РеквизитыОперации.Вставить("ПутьКФайлу", 		КаталогВременныхФайлов() + "xml.xml");
	РеквизитыОперации.Вставить("Брокер", 			ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион"));
	РеквизитыОперации.Вставить("ДатаПодтверждения", ДатаВыгрузки);
	
	ПараметрыФормы = Новый Структура("ПараметрыОбработки, ЭтоПодтверждениеСЧА", РеквизитыОперации, Истина); 
	
	Попытка
		ФормаОбработки = ПолучитьФорму("Обработка.ОтправкаДанныхПИФНаСайт.Форма.Форма", ПараметрыФормы, ЭтаФорма, ЭтаФорма);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Недостаточно прав для отправки данных ПИФ на сайт");
		Возврат Ложь;
	КонецПопытки;
	
	Если РежимПодтвержденияПИФ = 4 Тогда
		Возврат ФормаОбработки.ОтправитьВMatrix();
	Иначе
		Возврат ФормаОбработки.Выгрузить() И ФормаОбработки.Отправить(Истина);
	КонецЕсли; 

КонецФункции

&НаКлиенте
Процедура КомандаПолучитьДанныеИнтерфаксИзБуфераОбмена(Команда)
	
	Для каждого СтрокаСверкаСИнтерфакс Из ЭтаФорма.СверкаСИнтерфакс Цикл
		СтрокаСверкаСИнтерфакс.ЗначениеПоДаннымИнтерфакс = 0;
	КонецЦикла; 
	
	Попытка
		COMОбъект = Новый COMОбъект("htmlfile");
		Буфер = COMОбъект.ParentWindow.ClipboardData.Getdata("text");
	Исключение
		ВвестиСтроку(Буфер, "Не удалось получить данные из буфера обмена.
			|Вставьте данные вручную", , Истина);
		ДобавитьЗаписьОбОшибке(Запись.Операция);
	КонецПопытки;
		
	Если СтрЧислоСтрок(Буфер) <> 13 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Формат данных в буфере обмена не соответствует формату данных Интерфакс");
		Возврат;
	КонецЕсли;
	
	ФорматДаты = "ДФ=dd.MM.yyyy";
	
	Попытка
		
		ДатаРасчетаСЧАИнтерфакс = Дата(СтрПолучитьСтроку(Буфер, 4) + " 00:00:00");
		
		Если ЭтаФорма.ДатаРасчетаСЧА <> ДатаРасчетаСЧАИнтерфакс Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата подтверждаемой СЧА '" + Формат(ЭтаФорма.ДатаРасчетаСЧА, ФорматДаты) + 
				"' не соответствует дате в буфере обмена '" + Формат(ДатаРасчетаСЧАИнтерфакс, ФорматДаты) + "'");
			Возврат;	
		КонецЕсли; 
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В буфере обмена не удалось найти текущую дату");
		Возврат;
	КонецПопытки; 
	
	Попытка
		
		ПредыдущаяДатаРасчетаСЧАИнтерфакс = Дата(СтрПолучитьСтроку(Буфер, 2) + " 00:00:00");
		
		Если ЭтаФорма.ПредыдущаяДатаРасчетаСЧА <> ПредыдущаяДатаРасчетаСЧАИнтерфакс Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Предыдущая дата по данным 1С '" + Формат(ЭтаФорма.ПредыдущаяДатаРасчетаСЧА, ФорматДаты) + 
				"' не соответствует дате в буфере обмена '" + Формат(ПредыдущаяДатаРасчетаСЧАИнтерфакс, ФорматДаты) + "'");
			Возврат;	
		КонецЕсли; 
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В буфере обмена не удалось найти предыдущую дату");
		Возврат;
	КонецПопытки; 
	
	СтоимостиИнтерфакс = Новый Структура("СтоимостьПая, СЧА, ПредыдущаяСтоимостьПая, ПредыдущаяСЧА", 
		СтрПолучитьСтроку(Буфер, 12),
		СтрПолучитьСтроку(Буфер, 8),
		СтрПолучитьСтроку(Буфер, 11),
		СтрПолучитьСтроку(Буфер, 7));
		
	Для каждого СтоимостьИнтерфакс Из СтоимостиИнтерфакс Цикл
	
		Попытка
			СтоимостиИнтерфакс[СтоимостьИнтерфакс.Ключ] = Число(СтоимостьИнтерфакс.Значение);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В буфере обмена не удалось найти показатель '" + ПолучитьИмяПоказателя(СтоимостьИнтерфакс.Ключ) + "'");
			СтоимостиИнтерфакс[СтоимостьИнтерфакс.Ключ] = 0;
		КонецПопытки; 
		
		НайденныеСтроки = ЭтаФорма.СверкаСИнтерфакс.НайтиСтроки(Новый Структура("Ключ", СтоимостьИнтерфакс.Ключ));
		НайденныеСтроки[0].ЗначениеПоДаннымИнтерфакс = СтоимостьИнтерфакс.Значение;
		
	КонецЦикла; 
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьЗаписьОбОшибке(Ссылка)

	Описание = "Не удалось получить информацию из буфера обмена";
	
	НоваяЗадача = Задачи.ОшибкиРегламентыхЗаданий.СоздатьЗадачу();
	НоваяЗадача.Дата = ТекущаяДатаСеанса();
	НоваяЗадача.Наименование = Описание;
	НоваяЗадача.ТекстЗадачи = Описание;
	НоваяЗадача.Источник = "Подтверждение СЧА ПИФ по документу " + Ссылка;
	НоваяЗадача.ГруппаПользователей = Справочники.ГруппыПользователей.ВсеПользователи;
	НоваяЗадача.Записать();	

КонецПроцедуры

#КонецОбласти
