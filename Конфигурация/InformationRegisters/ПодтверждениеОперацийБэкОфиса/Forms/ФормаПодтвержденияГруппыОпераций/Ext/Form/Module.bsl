&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ВыбранныеОперации = Неопределено;
	Если Не Параметры.Свойство("Операции", ВыбранныеОперации) ИЛИ ВыбранныеОперации = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан или не заполнен параметр 'Операции'", , , , Отказ);
		Возврат;
	КонецЕсли;
	
	НеподтвержденныхОперации = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ИсключитьПодтвержденныеОперации(ВыбранныеОперации);
	
	ЭтаФорма.Операции.Загрузить(НеподтвержденныхОперации);
	УстановитьФлажки(ЭтаФорма, Истина);
	
	Если НеподтвержденныхОперации.Количество() <> ВыбранныеОперации.Количество() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Несколько операций, подтвержденных ранее, были исключены из списка");	
	КонецЕсли;
	
	ДоступныеОснования = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПолучитьДоступныеОснования();	
	Элементы.Основание.СписокВыбора.ЗагрузитьЗначения(ДоступныеОснования);
КонецПроцедуры

&НаКлиенте
Процедура ОперацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.Операции.ТекущиеДанные;
	
	ОткрытьЗначение(ТекущиеДанные.Операция);
КонецПроцедуры

&НаКлиенте
Процедура ОперацииПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура КомандаПодтвердитьОперации(Команда)
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ПодтвержденныеОперации = ПодтвердитьГруппуОперацийНаСервере();
	
	Оповестить("ПодтверждениеОперации", ПодтвержденныеОперации);
	
	Если ЭтаФорма.Операции.Количество() = 0 Тогда
		ЭтаФорма.Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьФлажки(Команда)
	УстановитьФлажки(ЭтаФорма, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьФлажки(Команда)
	УстановитьФлажки(ЭтаФорма, Истина);
КонецПроцедуры

&НаСервере
Функция ПодтвердитьГруппуОперацийНаСервере()
	ВыбранныеОперации = ЭтаФорма.Операции.Выгрузить(Новый Структура("Выбран", Истина)).ВыгрузитьКолонку("Операция");	
	
	ПодтвержденныеОперации = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПодтвердитьОперации(ВыбранныеОперации, ЭтаФорма.Основание, ЭтаФорма.ДатаПодтверждения, ЭтаФорма.Примечание);
	ПодтвержденныеОперации.Индексы.Добавить("Операция");	
	
	БылоОпераций = ЭтаФорма.Операции.Количество();
	Для н = -БылоОпераций По -1 Цикл
		СтрокаОперации = ЭтаФорма.Операции[-1-н];
		Если ПодтвержденныеОперации.Найти(СтрокаОперации.Операция, "Операция") = Неопределено Тогда
			СтрокаОперации.Выбран = Истина;		
		Иначе
			ЭтаФорма.Операции.Удалить(СтрокаОперации);		
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПодтвержденныеОперации.ВыгрузитьКолонку("Операция"); 
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьФлажки(ЭтаФорма, ЗначениеФлажка)
	Для Каждого СтрокаОперации Из ЭтаФорма.Операции Цикл
		СтрокаОперации.Выбран = ЗначениеФлажка; 		
	КонецЦикла;
КонецПроцедуры