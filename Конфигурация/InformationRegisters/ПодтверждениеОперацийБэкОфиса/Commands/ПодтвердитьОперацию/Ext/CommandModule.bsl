&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ПараметрКоманды.Количество() > 1 Тогда
		
		Для каждого Ссылка Из ПараметрКоманды Цикл
			Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.РегистрацияСтоимостиАктивов") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для документа 'Регистрация стоимости активов' групповое подтверждение операций не поддерживается");
				Возврат;
			КонецЕсли; 
		КонецЦикла; 
		
		ПараметрыФормы = Новый Структура("Операции", ПараметрКоманды);
		ОткрытьФорму("РегистрСведений.ПодтверждениеОперацийБэкОфиса.Форма.ФормаПодтвержденияГруппыОпераций", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка, , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли ДоступноПодтверждениеОперации(ПараметрКоманды) Тогда
		
		ПараметрыФормы = Новый Структура("Операция", ПараметрКоманды[0]);
		ОткрытьФорму("РегистрСведений.ПодтверждениеОперацийБэкОфиса.Форма.ФормаИсторияПодтвержденияОперации", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка, , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДоступноПодтверждениеОперации(ПараметрКоманды)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПараметрКоманды", ПараметрКоманды[0]);
	Запрос.УстановитьПараметр("ТекущаяДата", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрКоманды[0], "Дата"));
	Если ПараметрКоманды[0].Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РегистрацияСтоимостиАктивов.Ссылка КАК Ссылка,
			|	""дата прекращения"" КАК Причина,
			|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
			|		ИЛИ (КОНЕЦПЕРИОДА(ЕСТЬNULL(СчетаДоверительногоУправления.ДатаРасторжения, ДАТАВРЕМЯ(3999, 12, 31)), ДЕНЬ) <= КОНЕЦПЕРИОДА(РегистрацияСтоимостиАктивов.Дата, ДЕНЬ)
			|		И СчетаДоверительногоУправления.ДатаРасторжения <> ДАТАВРЕМЯ(1, 1, 1)) КАК Ошибка
			|ИЗ
			|	Документ.РегистрацияСтоимостиАктивов КАК РегистрацияСтоимостиАктивов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ПО РегистрацияСтоимостиАктивов.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
			|ГДЕ
			|	РегистрацияСтоимостиАктивов.Ссылка = &ПараметрКоманды";
	Иначе
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РегистрацияСтоимостиАктивов.Ссылка КАК Ссылка,
			|	""дата возникновения основания прекращения фонда"" КАК Причина,
			|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
			|		ИЛИ КОНЕЦПЕРИОДА(ЕСТЬNULL(ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Значение КАК ДАТА), ДАТАВРЕМЯ(3999, 12, 31)), ДЕНЬ) <= КОНЕЦПЕРИОДА(РегистрацияСтоимостиАктивов.Дата, ДЕНЬ) КАК Ошибка
			|ИЗ
			|	Документ.РегистрацияСтоимостиАктивов КАК РегистрацияСтоимостиАктивов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ПО РегистрацияСтоимостиАктивов.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ТекущаяДата, ) КАК КлиентыДоверительногоУправления
			|		ПО РегистрацияСтоимостиАктивов.СчетДоверительногоУправления = КлиентыДоверительногоУправления.СчетДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
			|		ПО ((ВЫРАЗИТЬ(КлиентыДоверительногоУправления.Клиент КАК Справочник.ПаевыеИнвестиционныеФонды)) = ЗначенияДополнительныхСведений.Объект)
			|			И (ЗначенияДополнительныхСведений.Свойство.Ключ = ""ДатаВозникновенияОснованияПрекращенияФонда"")
			|ГДЕ
			|	РегистрацияСтоимостиАктивов.Ссылка = &ПараметрКоманды";
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Отказ = Ложь;
	
	Если Выборка.Следующий() И Выборка.Ошибка Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Для документа '%1' подтверждение операций не поддерживается, т.к. %2 меньше, чем дата документа", Выборка.Ссылка, Выборка.Причина),,,, Отказ);
	КонецЕсли; 
	
	Возврат Не Отказ;

КонецФункции
 
