Функция ПолучитьПодтверждаемыеВидыОпераций() Экспорт
	ПодтверждаемыеВидыОпераций = Новый Массив;
	
	Для Каждого ТипОперации Из Метаданные.ОпределяемыеТипы.ПодтверждаемыеОперацииБэкОфиса.Тип.Типы() Цикл
		ИмяТипа = Метаданные.НайтиПоТипу(ТипОперации).Имя;
		Если ИмяТипа <> "РегистрацияСтоимостиАктивов" Тогда
			ПодтверждаемыеВидыОпераций.Добавить(Перечисления.ВидыОперацийБэкОфиса[ИмяТипа]);		
		КонецЕсли; 
	КонецЦикла;
	
	Возврат ПодтверждаемыеВидыОпераций;	
КонецФункции

#Область Сведения_о_подтверждении_операций

Функция ОперацияПодтверждена(Операция, СведенияОПодтверждении = Неопределено) Экспорт
	
	СведенияОПодтверждении = ПолучитьПоследнююЗаписьЖурналаПодтверждений(Операция);
	
	Возврат ?(СведенияОПодтверждении = Неопределено, Ложь, СведенияОПодтверждении.Подтверждена);
КонецФункции

Функция ПолучитьПоследнююЗаписьЖурналаПодтверждений(Операция) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПодтверждениеОперацийБэкОфиса.Период КАК Период,
		|	ПодтверждениеОперацийБэкОфиса.Организация КАК Организация,
		|	ПодтверждениеОперацийБэкОфиса.Операция КАК Операция,
		|	ПодтверждениеОперацийБэкОфиса.Подтверждена КАК Подтверждена,
		|	ПодтверждениеОперацийБэкОфиса.Основание КАК Основание,
		|	ПодтверждениеОперацийБэкОфиса.Ответственный КАК Ответственный,
		|	ПодтверждениеОперацийБэкОфиса.РучнойРежим КАК РучнойРежим,
		|	ПодтверждениеОперацийБэкОфиса.Примечание КАК Примечание
		|ИЗ
		|	РегистрСведений.ПодтверждениеОперацийБэкОфиса.СрезПоследних(, Операция = &Операция) КАК ПодтверждениеОперацийБэкОфиса");
	Запрос.УстановитьПараметр("Операция", Операция);
	
	УстановитьПривилегированныйРежим(Истина);	
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);	
	
	ЗаписьЖурналаПодтверждений = РезультатЗапроса.Выгрузить()[0];
	
	СведенияОПодтверждении = Новый Структура("Период, Организация, Операция, Подтверждена, Основание, Ответственный, РучнойРежим, Примечание");
	ЗаполнитьЗначенияСвойств(СведенияОПодтверждении, ЗаписьЖурналаПодтверждений);
	
	Возврат СведенияОПодтверждении;	
	
КонецФункции

