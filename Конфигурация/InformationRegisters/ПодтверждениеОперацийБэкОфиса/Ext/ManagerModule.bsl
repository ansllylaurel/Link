КонецФункции

Функция ИсключитьПодтвержденныеОперации(Операции) Экспорт
	ПроверяемыеОперации = Новый ТаблицаЗначений;
	ПроверяемыеОперации.Колонки.Добавить("Операция", Метаданные.ОпределяемыеТипы.ПодтверждаемыеОперацииБэкОфиса.Тип);

	Для н = 1 По Операции.Количество() Цикл
		ПроверяемыеОперации.Добавить();
	КонецЦикла; 
	ПроверяемыеОперации.ЗагрузитьКолонку(Операции, "Операция");
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПроверяемыеОперации.Операция КАК Операция
		|ПОМЕСТИТЬ _ПроверяемыеОперации
		|ИЗ
		|	&ПроверяемыеОперации КАК _ПроверяемыеОперации
		|ГДЕ
		|	_ПроверяемыеОперации.Операция <> НЕОПРЕДЕЛЕНО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПроверяемыеОперации.Операция КАК Операция
		|ИЗ
		|	_ПроверяемыеОперации КАК _ПроверяемыеОперации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПодтверждениеОперацийБэкОфиса.СрезПоследних(
		|				,
		|				(Операция, ИСТИНА) В
		|					(ВЫБРАТЬ
		|						_ПроверяемыеОперации.Операция,
		|						ИСТИНА
		|					ИЗ
		|						_ПроверяемыеОперации)) КАК ПодтверждениеОперацийБэкОфиса
		|		ПО (ПодтверждениеОперацийБэкОфиса.Операция = _ПроверяемыеОперации.Операция)
		|			И (ПодтверждениеОперацийБэкОфиса.Подтверждена = ИСТИНА)
		|ГДЕ
		|	ПодтверждениеОперацийБэкОфиса.Операция ЕСТЬ NULL");
	Запрос.УстановитьПараметр("ПроверяемыеОперации", ПроверяемыеОперации);
		
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Возвращает операции со временем внесения более поздним, чем указанная дата
//
// Параметры:
//	Операции	- ТаблицаЗначений	- таблица операций с колонками "Организация", "Операция"
//	Период		- Дата				- дата, позднее которой должна быть внесена операция 
//
// Возвращаемое значение:
//	- ТаблицаЗначений	- таблица операций с колонками "Операция", "ВремяВнесения"
//	- Неопределено		- если таких операций нет
//
Функция ОперацииВнесенныеПозднее(Операции, Период) Экспорт
	
	Если Операции.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Период);
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(Операции, "_Операции", Запрос, , "Организация, Операция", , "Организация, Операция");
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Операции.Операция КАК Операция,
		|	ВнесениеОпераций.Период КАК ВремяВнесения
		|ИЗ
		|	_Операции КАК _Операции
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПодтверждениеОперацийБэкОфиса КАК ВнесениеОпераций
		|		ПО (ВнесениеОпераций.Организация = _Операции.Организация)
		|			И (ВнесениеОпераций.Операция = _Операции.Операция)
		|			И ((ВЫРАЗИТЬ(ВнесениеОпераций.Примечание КАК СТРОКА(15))) = ""Внесение записи"")
		|			И (ВнесениеОпераций.Период >= &Период)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат ?(РезультатЗапроса.Пустой(), Неопределено, РезультатЗапроса.Выгрузить());
	
КонецФункции

#КонецОбласти

#Область Подтверждение_и_отмена_подтверждения_операций

Функция ПодтвердитьОперации(Операции, Основание, ДатаПодтверждения, Примечание, РучнойРежим = Истина) Экспорт
	НеподтвержденныеОперации = ИсключитьПодтвержденныеОперации(Операции);
	Если НеподтвержденныеОперации.Количество() = 0 Тогда
		Возврат НеподтвержденныеОперации;
	КонецЕсли;
	
	Для Каждого МетаРесурс Из Метаданные.РегистрыСведений.ПодтверждениеОперацийБэкОфиса.СтандартныеРеквизиты Цикл
		НеподтвержденныеОперации.Колонки.Добавить(МетаРесурс.Имя, МетаРесурс.Тип); 	
	КонецЦикла;	
	Для Каждого МетаРесурс Из Метаданные.РегистрыСведений.ПодтверждениеОперацийБэкОфиса.Ресурсы Цикл
		НеподтвержденныеОперации.Колонки.Добавить(МетаРесурс.Имя, МетаРесурс.Тип); 	
	КонецЦикла;
	
	НеподтвержденныеОперации.ЗаполнитьЗначения(ДатаПодтверждения, "Период");	
	НеподтвержденныеОперации.ЗаполнитьЗначения(Истина, "Подтверждена");	
	НеподтвержденныеОперации.ЗаполнитьЗначения(Основание, "Основание");
	НеподтвержденныеОперации.ЗаполнитьЗначения(Примечание, "Примечание");
	НеподтвержденныеОперации.ЗаполнитьЗначения(РучнойРежим, "РучнойРежим");
	
	ПодтверждениеОперацийБэкОфиса = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.СоздатьНаборЗаписей();
	ПодтверждениеОперацийБэкОфиса.Загрузить(НеподтвержденныеОперации);
	ПодтверждениеОперацийБэкОфиса.Записать(Ложь);
	
	Возврат НеподтвержденныеОперации; 
КонецФункции

Процедура ОтменитьПодтверждениеОперации(Операция, Основание = Неопределено, Примечание = Неопределено, РучнойРежим = Истина, ВремяЗаписи = Неопределено) Экспорт
	
	ЭтоСсылкаНаОперацию		= СтрНачинаетсяС(XMLТипЗнч(Операция).ИмяТипа, "DocumentRef");
	ОперацияСсылка			= ?(ЭтоСсылкаНаОперацию, Операция, Операция.Ссылка);
	СведенияОПодтверждении	= Неопределено;
	
	Если ОперацияПодтверждена(ОперацияСсылка, СведенияОПодтверждении) Тогда		
		УстановитьПривилегированныйРежим(Истина);	
		
		ОтменаПодтверждения = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.СоздатьМенеджерЗаписи();
		
		ЗаполнитьЗначенияСвойств(ОтменаПодтверждения, СведенияОПодтверждении);
		
		ОтменаПодтверждения.Период			= ?(ВремяЗаписи = Неопределено, Макс(ТекущаяДата(), СведенияОПодтверждении.Период + 1), ВремяЗаписи);
		ОтменаПодтверждения.Подтверждена	= Ложь;	
		ОтменаПодтверждения.Основание		= ?(Основание = Неопределено, СведенияОПодтверждении.Основание, Основание);
		ОтменаПодтверждения.Примечание		= Примечание;
		ОтменаПодтверждения.РучнойРежим		= РучнойРежим;	
		
		ОтменаПодтверждения.Записать(Истина);
		
		УстановитьПривилегированныйРежим(Ложь);	
	КонецЕсли;
	
КонецПроцедуры

Функция ДобавитьЗаписьВЖурналПодтверждений(Операция, Подтверждена = Истина, Основание, Примечание, РучнойРежим = Истина, ВремяЗаписи = Неопределено) Экспорт
	ЭтоСсылкаНаОперацию = СтрНачинаетсяС(XMLТипЗнч(Операция).ИмяТипа, "DocumentRef");
	
	Если ВремяЗаписи = Неопределено Тогда
		ВремяЗаписи = ТекущаяДата();
	КонецЕсли;
	
	ПодтверждениеОперацийБэкОфиса = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.СоздатьМенеджерЗаписи();
	ПодтверждениеОперацийБэкОфиса.Период						= ВремяЗаписи;
	ПодтверждениеОперацийБэкОфиса.Операция						= ?(ЭтоСсылкаНаОперацию, Операция, Операция.Ссылка);
	ПодтверждениеОперацийБэкОфиса.Организация					= ?(ЭтоСсылкаНаОперацию, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Операция, "Организация"), Операция.Организация);
	ПодтверждениеОперацийБэкОфиса.Подтверждена					= Подтверждена;
	ПодтверждениеОперацийБэкОфиса.Основание						= Основание;
	ПодтверждениеОперацийБэкОфиса.Примечание					= Примечание;
	ПодтверждениеОперацийБэкОфиса.РучнойРежим					= РучнойРежим;	
	ПодтверждениеОперацийБэкОфиса.Записать(Истина);
	
	СведенияОПодтверждении = Новый Структура("Основание, Ответственный, РучнойРежим, Примечание, Период");
	ЗаполнитьЗначенияСвойств(СведенияОПодтверждении, ПодтверждениеОперацийБэкОфиса);
	
	Возврат СведенияОПодтверждении; 
КонецФункции

#Область Операции_с_брокером

Функция СформироватьСтруктуруОтбораОперацийСБрокером(Организация, СчетДоверительногоУправления = Неопределено, Брокер, НачалоПериода, КонецПериода) Экспорт
	
	ОтборОперацийСБрокером = Новый Структура;
	ОтборОперацийСБрокером.Вставить("Организация",					Организация);
	ОтборОперацийСБрокером.Вставить("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	ОтборОперацийСБрокером.Вставить("Брокер",						Брокер);
	ОтборОперацийСБрокером.Вставить("НачалоПериода",				НачалоПериода);
	ОтборОперацийСБрокером.Вставить("КонецПериода",					КонецПериода);
	
	Возврат ОтборОперацийСБрокером;
	
КонецФункции

// Подтверждает операции с брокером
//
// Параметры:
//	СведенияОбОперациях	- ТаблицаЗначений		- таблица неподтвержденных операций (состав колонок см. в ПолучитьНеподтвержденныеОперацииСБрокером)
//						- Структура				- параметры получения неподтвержденных операций (см. СформироватьСтруктуруОтбораОперацийСБрокером)
//	ВремяПодтверждения	- Дата, Неопределено	- время подтверждения. Если не указано, то используется текущее время
//	ВремяВнесения		- Дата, Неопределено	- время внесения. Если не указано, то запись о внесении не добавляется 
//
// Возвращаемое значение:
//	ПодтвержденныеОперации - ТаблицаЗначений - колонки соответствуют колонкам регистра ПодтверждениеОперацийБэкОфиса + колонка ПредставлениеОперации  
//
Функция ПодтвердитьОперацииСБрокером(СведенияОбОперациях, ВремяПодтверждения = Неопределено, ВремяВнесения = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);	
	
	Если ТипЗнч(СведенияОбОперациях) = Тип("Структура") Тогда
		
		Если ТипЗнч(СведенияОбОперациях.Брокер) <> Тип("СправочникСсылка.БрокерскиеКомпании") ИЛИ Не ЗначениеЗаполнено(СведенияОбОперациях.Брокер) Тогда
			ВызватьИсключение "Передано некорректное значение параметра 'Брокер'";	
		КонецЕсли;
		
		НеподтвержденныеОперации = ПолучитьНеподтвержденныеОперацииСБрокером(СведенияОбОперациях.Организация, СведенияОбОперациях.СчетДоверительногоУправления, СведенияОбОперациях.Брокер, СведенияОбОперациях.НачалоПериода, СведенияОбОперациях.КонецПериода);
		
	Иначе
		
		НеподтвержденныеОперации = СведенияОбОперациях;
		
	КонецЕсли;
		
	НеподтвержденныеОперации.Колонки.Добавить("Основание",		Метаданные.РегистрыСведений.ПодтверждениеОперацийБэкОфиса.Ресурсы.Основание.Тип);
	НеподтвержденныеОперации.Колонки.Добавить("Подтверждена",	Метаданные.РегистрыСведений.ПодтверждениеОперацийБэкОфиса.Ресурсы.Подтверждена.Тип);
	НеподтвержденныеОперации.Колонки.Добавить("Период",			Метаданные.РегистрыСведений.ПодтверждениеОперацийБэкОфиса.СтандартныеРеквизиты.Период.Тип);
	
	// Установим время внесения, если оно передано
	
	Если ЗначениеЗаполнено(ВремяВнесения) Тогда
		
		НачатьТранзакцию();	
		
		ВремяВнесенияОпераций = НеподтвержденныеОперации.Скопировать();
		ВремяВнесенияОпераций.ЗаполнитьЗначения("Отчет брокера",	"Основание");  		
		ВремяВнесенияОпераций.ЗаполнитьЗначения(ВремяВнесения,		"Период");
		ВремяВнесенияОпераций.ЗаполнитьЗначения("Внесение записи",	"Примечание");

		Для Каждого Запись Из ВремяВнесенияОпераций Цикл
			
			// Время внесения можно корректировать только у определенных операций
			
			Если ТипЗнч(Запись.Операция) = Тип("ДокументСсылка.Маржа")
				ИЛИ ТипЗнч(Запись.Операция) = Тип("ДокументСсылка.НачислениеЗадолженности")
				ИЛИ ТипЗнч(Запись.Операция) = Тип("ДокументСсылка.Оплата")
			Тогда
			
			    Если ТипЗнч(Запись.Операция) = Тип("ДокументСсылка.НачислениеЗадолженности")
					ИЛИ ТипЗнч(Запись.Операция) = Тип("ДокументСсылка.Оплата")
				Тогда
					ВидЗадолженности = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.Операция, "ВидЗадолженности");
					Если ВидЗадолженности <> Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии
						И ВидЗадолженности <> Справочники.ВидыЗадолженности.ПоТорговойКомиссии
					Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
			
				ПодтверждениеОперацийБэкОфиса = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.СоздатьНаборЗаписей();
				
				ПодтверждениеОперацийБэкОфиса.Отбор.Организация.Установить(Запись.Организация);
				ПодтверждениеОперацийБэкОфиса.Отбор.Операция.Установить(Запись.Операция);
				
				ЗаполнитьЗначенияСвойств(ПодтверждениеОперацийБэкОфиса.Добавить(), Запись);
				
				ПодтверждениеОперацийБэкОфиса.Записать(Истина);
			
			КонецЕсли;
			
		КонецЦикла;

		ЗафиксироватьТранзакцию();
		
	КонецЕсли;
	
	// Установим время подтверждения 
	
	ВремяПодтвержденияОпераций = ?(ЗначениеЗаполнено(ВремяПодтверждения), ВремяПодтверждения, ТекущаяДата());
	
	НеподтвержденныеОперации.ЗаполнитьЗначения("Отчет брокера",				"Основание");  		
	НеподтвержденныеОперации.ЗаполнитьЗначения(Истина,						"Подтверждена");  		
	НеподтвержденныеОперации.ЗаполнитьЗначения(ВремяПодтвержденияОпераций,	"Период");  		
	
	ПодтверждениеОперацийБэкОфиса = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.СоздатьНаборЗаписей();
	ПодтверждениеОперацийБэкОфиса.Загрузить(НеподтвержденныеОперации);
	ПодтверждениеОперацийБэкОфиса.Записать(Ложь);	
	
	УстановитьПривилегированныйРежим(Ложь);	
	
	Возврат НеподтвержденныеОперации;

КонецФункции

Функция ПолучитьНеподтвержденныеОперацииСБрокером(Организация, СчетДоверительногоУправления = Неопределено, Брокер, Знач НачалоПериода, Знач КонецПериода, ДляПодтвержденияОтчетомБрокера = Истина) Экспорт
	
	Если ТипЗнч(Брокер) <> Тип("СправочникСсылка.БрокерскиеКомпании") ИЛИ Не ЗначениеЗаполнено(Брокер) Тогда
		ВызватьИсключение "Передано некорректное значение параметра 'Брокер'";	
	КонецЕсли;
	
	// Подтверждаем операции только после 01.10.2017
	НачалоПериода	= Макс('20171001', НачалоПериода);
	КонецПериода	= Макс('20171001', КонецПериода);
	
	// В журнале
	ОперацииСБрокером = Новый Массив;
	ОперацииСБрокером.Добавить(Перечисления.ВидыОперацийБэкОфиса.Маржа);
	ОперацииСБрокером.Добавить(Перечисления.ВидыОперацийБэкОфиса.НачислениеЗадолженности);
	ОперацииСБрокером.Добавить(Перечисления.ВидыОперацийБэкОфиса.Оплата);
	ОперацииСБрокером.Добавить(Перечисления.ВидыОперацийБэкОфиса.Сделка);
	ОперацииСБрокером.Добавить(Перечисления.ВидыОперацийБэкОфиса.СделкаРЕПО);
	ОперацииСБрокером.Добавить(Перечисления.ВидыОперацийБэкОфиса.СделкаСВалютой);
	
	// По основанию:
	// ОтменаСделки
	// ИзменениеУсловийСделки
	// ИсполнениеОбязательствПоСделке
	
	// Для ПереводДенежныхСредств должно быть два подтверждения:
	// отчет брокера (брокер-получатель) и банковская выписка
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖурналОперацийБэкОфиса.Документ КАК Документ
		|ПОМЕСТИТЬ _ПереводыДенежныхСредствСБанком
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПереводДенежныхСредств КАК ПереводДенежныхСредств
		|		ПО (ПереводДенежныхСредств.Ссылка = ЖурналОперацийБэкОфиса.Документ)
		|			И (&Брокер В (ПереводДенежныхСредств.Брокер, ПереводДенежныхСредств.БрокерПолучатель))
		|			И (ПереводДенежныхСредств.Брокер <> ПереводДенежныхСредств.БрокерПолучатель)
		|ГДЕ
		|	ЖурналОперацийБэкОфиса.Организация = &Организация
		|	И ЖурналОперацийБэкОфиса.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЖурналОперацийБэкОфиса.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.ПереводДенежныхСредств)
		|	И (ЖурналОперацийБэкОфиса.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|			ИЛИ &СчетДоверительногоУправления = НЕОПРЕДЕЛЕНО)
		|	И ЖурналОперацийБэкОфиса.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументов.Проведен)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПереводДенежныхСредств.Ссылка КАК Ссылка,
		|	ПереводДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _ПереводыДенежныхСредствСПодтвержденнымиПоступлениямиНаСчетБанка
		|ИЗ
		|	Документ.ПереводДенежныхСредств КАК ПереводДенежныхСредств
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПереводыДенежныхСредствСБанком КАК _ПереводыДенежныхСредствСБанком
		|		ПО ПереводДенежныхСредств.Ссылка = _ПереводыДенежныхСредствСБанком.Документ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеестрПлатежей КАК РеестрПлатежей
		|		ПО (РеестрПлатежей.Регистратор = ПереводДенежныхСредств.Ссылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ПереводДенежныхСредств.Ссылка,
		|	ПереводДенежныхСредств.СчетДоверительногоУправления
		|
		|ИМЕЮЩИЕ
		|	(ПереводДенежныхСредств.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|		ИЛИ ПереводДенежныхСредств.Сумма = СУММА(ВЫБОР
		|				КОГДА РеестрПлатежей.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|					ТОГДА РеестрПлатежей.Сумма
		|				ИНАЧЕ 0
		|			КОНЕЦ)) И
		|	(ПереводДенежныхСредств.БрокерПолучатель <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|		ИЛИ ПереводДенежныхСредств.Сумма = СУММА(ВЫБОР
		|				КОГДА РеестрПлатежей.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|					ТОГДА РеестрПлатежей.Сумма
		|				ИНАЧЕ 0
		|			КОНЕЦ))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖурналОперацийБэкОфиса.Документ КАК Операция,
		|	ЖурналОперацийБэкОфиса.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	"""" КАК Примечание
		|ПОМЕСТИТЬ _ОперацииБрокера
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|ГДЕ
		|	ЖурналОперацийБэкОфиса.Организация = &Организация
		|	И ЖурналОперацийБэкОфиса.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЖурналОперацийБэкОфиса.ВидОперации В(&ОперацииСБрокером)
		|	И (ЖурналОперацийБэкОфиса.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|			ИЛИ &СчетДоверительногоУправления = НЕОПРЕДЕЛЕНО)
		|	И ЖурналОперацийБэкОфиса.Брокер = &Брокер
		|	И ЖурналОперацийБэкОфиса.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументов.Проведен)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Сделка.Ссылка,
		|	Сделка.СчетДоверительногоУправления,
		|	""""
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|ГДЕ
		|	Сделка.Организация = &Организация
		|	И (Сделка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|			ИЛИ &СчетДоверительногоУправления = НЕОПРЕДЕЛЕНО)
		|	И Сделка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Сделка.Проведен = ИСТИНА
		|	И Сделка.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И Сделка.Брокер = &Брокер
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИсполнениеОбязательствПоСделке.Ссылка,
		|	ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления,
		|	""""
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|ГДЕ
		|	ИсполнениеОбязательствПоСделке.Организация = &Организация
		|	И (ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|			ИЛИ &СчетДоверительногоУправления = НЕОПРЕДЕЛЕНО)
		|	И ИсполнениеОбязательствПоСделке.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ИсполнениеОбязательствПоСделке.Проведен = ИСТИНА
		|	И ИсполнениеОбязательствПоСделке.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И ИсполнениеОбязательствПоСделке.Основание.Брокер = &Брокер
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЖурналОперацийБэкОфиса.Документ,
		|	ЖурналОперацийБэкОфиса.СчетДоверительногоУправления,
		|	""""
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтменаСделки КАК ОтменаСделки
		|		ПО (ОтменаСделки.Ссылка = ЖурналОперацийБэкОфиса.Документ)
		|			И (ОтменаСделки.Сделка.Брокер = &Брокер)
		|ГДЕ
		|	ЖурналОперацийБэкОфиса.Организация = &Организация
		|	И ЖурналОперацийБэкОфиса.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЖурналОперацийБэкОфиса.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.ОтменаСделки)
		|	И (ЖурналОперацийБэкОфиса.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|			ИЛИ &СчетДоверительногоУправления = НЕОПРЕДЕЛЕНО)
		|	И ЖурналОперацийБэкОфиса.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументов.Проведен)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЖурналОперацийБэкОфиса.Документ,
		|	ЖурналОперацийБэкОфиса.СчетДоверительногоУправления,
		|	""""
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеУсловийСделки КАК ИзменениеУсловийСделки
		|		ПО (ИзменениеУсловийСделки.Ссылка = ЖурналОперацийБэкОфиса.Документ)
		|			И (ИзменениеУсловийСделки.Основание.Брокер = &Брокер)
		|ГДЕ
		|	ЖурналОперацийБэкОфиса.Организация = &Организация
		|	И ЖурналОперацийБэкОфиса.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЖурналОперацийБэкОфиса.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.ИзменениеУсловийСделки)
		|	И (ЖурналОперацийБэкОфиса.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|			ИЛИ &СчетДоверительногоУправления = НЕОПРЕДЕЛЕНО)
		|	И ЖурналОперацийБэкОфиса.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументов.Проведен)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЖурналОперацийБэкОфиса.Документ,
		|	ЖурналОперацийБэкОфиса.СчетДоверительногоУправления,
		|	""""
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|		ПО (ИсполнениеОбязательствПоСделке.Ссылка = ЖурналОперацийБэкОфиса.Документ)
		|			И (ИсполнениеОбязательствПоСделке.Основание.Брокер = &Брокер)
		|ГДЕ
		|	ЖурналОперацийБэкОфиса.Организация = &Организация
		|	И ЖурналОперацийБэкОфиса.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЖурналОперацийБэкОфиса.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.ИсполнениеОбязательствПоСделке)
		|	И (ЖурналОперацийБэкОфиса.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|			ИЛИ &СчетДоверительногоУправления = НЕОПРЕДЕЛЕНО)
		|	И ЖурналОперацийБэкОфиса.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументов.Проведен)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЖурналОперацийБэкОфиса.Документ,
		|	ЖурналОперацийБэкОфиса.СчетДоверительногоУправления,
		|	""""
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПереводДенежныхСредств КАК ПереводДенежныхСредств
		|		ПО (ПереводДенежныхСредств.Ссылка = ЖурналОперацийБэкОфиса.Документ)
		|			И (&Брокер В (ПереводДенежныхСредств.Брокер, ПереводДенежныхСредств.БрокерПолучатель))
		|			И (ПереводДенежныхСредств.Брокер = ПереводДенежныхСредств.БрокерПолучатель)
		|ГДЕ
		|	ЖурналОперацийБэкОфиса.Организация = &Организация
		|	И ЖурналОперацийБэкОфиса.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЖурналОперацийБэкОфиса.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.ПереводДенежныхСредств)
		|	И (ЖурналОперацийБэкОфиса.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|			ИЛИ &СчетДоверительногоУправления = НЕОПРЕДЕЛЕНО)
		|	И ЖурналОперацийБэкОфиса.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументов.Проведен)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПереводДенежныхСредств.Ссылка,
		|	ПереводДенежныхСредств.СчетДоверительногоУправления,
		|	""Поступление на счет банка подтверждено банковскими выписками""
		|ИЗ
		|	_ПереводыДенежныхСредствСПодтвержденнымиПоступлениямиНаСчетБанка КАК ПереводДенежныхСредств 
		|ГДЕ
		|	&ДляПодтвержденияОтчетомБрокера
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПереводДенежныхСредств.Ссылка,
		|	ПереводДенежныхСредств.СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА ПодтвержденыеПоступлениямиНаСчетБанка.Ссылка ЕСТЬ NULL 
		|			ТОГДА ""Поступление на счет банка не подтверждено банковскими выписками""
		|		ИНАЧЕ """"
		|	КОНЕЦ
		|ИЗ
		|	Документ.ПереводДенежныхСредств КАК ПереводДенежныхСредств
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПереводыДенежныхСредствСБанком КАК _ПереводыДенежныхСредствСБанком
		|		ПО ПереводДенежныхСредств.Ссылка = _ПереводыДенежныхСредствСБанком.Документ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПереводыДенежныхСредствСПодтвержденнымиПоступлениямиНаСчетБанка КАК ПодтвержденыеПоступлениямиНаСчетБанка
		|		ПО ПодтвержденыеПоступлениямиНаСчетБанка.Ссылка = ПереводДенежныхСредств.Ссылка
		|ГДЕ
		|	НЕ &ДляПодтвержденияОтчетомБрокера
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Организация КАК Организация,
		|	_ОперацииБрокера.Операция КАК Операция,
		|	_ОперацииБрокера.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ПРЕДСТАВЛЕНИЕССЫЛКИ(_ОперацииБрокера.Операция) КАК ПредставлениеОперации,
		|	_ОперацииБрокера.Примечание КАК Примечание
		|ИЗ
		|	_ОперацииБрокера КАК _ОперацииБрокера
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПодтверждениеОперацийБэкОфиса.СрезПоследних(
		|				,
		|				(Операция, Организация) В
		|					(ВЫБРАТЬ
		|						_ОперацииБрокера.Операция,
		|						&Организация
		|					ИЗ
		|						_ОперацииБрокера)) КАК ПодтверждениеОперацийБэкОфиса
		|		ПО (ПодтверждениеОперацийБэкОфиса.Организация = &Организация)
		|			И (ПодтверждениеОперацийБэкОфиса.Операция = _ОперацииБрокера.Операция)
		|			И (ПодтверждениеОперацийБэкОфиса.Подтверждена = ИСТИНА)
		|ГДЕ
		|	ПодтверждениеОперацийБэкОфиса.Организация ЕСТЬ NULL");
	
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Брокер",							Брокер);
	Запрос.УстановитьПараметр("НачалоПериода",					НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",					КонецПериода);
	Запрос.УстановитьПараметр("ОперацииСБрокером",				ОперацииСБрокером);
	Запрос.УстановитьПараметр("ДляПодтвержденияОтчетомБрокера",	ДляПодтвержденияОтчетомБрокера);

	НеподтвержденныеОперации = Запрос.Выполнить().Выгрузить();
	
	Возврат НеподтвержденныеОперации;	
	
КонецФункции

#КонецОбласти

#Область Операции_с_депозитарием

Функция ПодтвердитьОперацииСДепозитарием(Организация, СчетДоверительногоУправления, ДепозитарнаяКомпания, Знач НачалоПериода, Знач КонецПериода) Экспорт
	
	Если ТипЗнч(ДепозитарнаяКомпания) <> Тип("СправочникСсылка.ДепозитарныеКомпании") ИЛИ Не ЗначениеЗаполнено(ДепозитарнаяКомпания) Тогда
		ВызватьИсключение "Передано некорректное значение параметра 'ДепозитарнаяКомпания'";	
	КонецЕсли;
	
	// Подтверждаем операции только после 01.10.2017	
	НачалоПериода	= Макс('20171001', НачалоПериода);
	КонецПериода	= Макс('20171001', КонецПериода);
	
	// В журнале по свойствам ДепозитарныйСчет.Депозитарий:	
	ОперацииСДепозитарием = Новый Массив;
	ОперацииСДепозитарием.Добавить(Перечисления.ВидыОперацийБэкОфиса.ВводЦенныхБумаг);
	ОперацииСДепозитарием.Добавить(Перечисления.ВидыОперацийБэкОфиса.ВыводЦенныхБумаг);
	ОперацииСДепозитарием.Добавить(Перечисления.ВидыОперацийБэкОфиса.СнятиеЦеннойБумагиСУчета);
	ОперацииСДепозитарием.Добавить(Перечисления.ВидыОперацийБэкОфиса.СписаниеЦеннойБумаги);
	
	// Для следующих документов ищем по свойствам:
	// - КонвертацияЦенныхБумаг: ЦенныеБумаги.ДепозитарныйСчет.Депозитарий
	// - ПоставкаЦенныхБумаг: когда Депозитарий и ЦенныеБумаги.ДепозитарныйСчет.Депозитарий являются проверяемым депозитарием 
	// - ПереводЦенныхБумаг: когда оба счета проверяемого депозитария, либо по второму депозитарию ранее выполнена сверка
	
	// Заполним соответствие депозитарных компаний и их отчетов			
	ДепозитарныеКомпанииИОтчеты = Новый ТаблицаЗначений;
	ДепозитарныеКомпанииИОтчеты.Колонки.Добавить("ДепозитарнаяКомпания", Новый ОписаниеТипов("СправочникСсылка.ДепозитарныеКомпании"));
	ДепозитарныеКомпанииИОтчеты.Колонки.Добавить("ОтчетДепозитария", Новый ОписаниеТипов("СправочникСсылка.ВнешниеСистемы"));
	
	ЗаполнитьЗначенияСвойств(ДепозитарныеКомпанииИОтчеты.Добавить(), Новый Структура("ДепозитарнаяКомпания, ОтчетДепозитария", ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_БК_Регион"), Справочники.ВнешниеСистемы.ОтчетДепозитарияБКРегион));
	ЗаполнитьЗначенияСвойств(ДепозитарныеКомпанииИОтчеты.Добавить(), Новый Структура("ДепозитарнаяКомпания, ОтчетДепозитария", ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_ДК_Регион"), Справочники.ВнешниеСистемы.ОтчетДепозитарияДКРегион));
	ЗаполнитьЗначенияСвойств(ДепозитарныеКомпанииИОтчеты.Добавить(), Новый Структура("ДепозитарнаяКомпания, ОтчетДепозитария", ОбщегоНазначения.ПолучитьИменованныйОбъект("СпецДепозитарий_ВТБ"), Справочники.ВнешниеСистемы.ОтчетДепозитарияВТБ));
	ЗаполнитьЗначенияСвойств(ДепозитарныеКомпанииИОтчеты.Добавить(), Новый Структура("ДепозитарнаяКомпания, ОтчетДепозитария", ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_Инфинитум"), Справочники.ВнешниеСистемы.ОтчетДепозитарияИнфинитум));
	ЗаполнитьЗначенияСвойств(ДепозитарныеКомпанииИОтчеты.Добавить(), Новый Структура("ДепозитарнаяКомпания, ОтчетДепозитария", ОбщегоНазначения.ПолучитьИменованныйОбъект("СпецДепозитарий_Сбербанка"), Справочники.ВнешниеСистемы.ОтчетДепозитарияСбербанка));
	ЗаполнитьЗначенияСвойств(ДепозитарныеКомпанииИОтчеты.Добавить(), Новый Структура("ДепозитарнаяКомпания, ОтчетДепозитария", ОбщегоНазначения.ПолучитьИменованныйОбъект("Регистратор_НРК"), Справочники.ВнешниеСистемы.ОтчетРегистратораНРК));	
	
	// Ищем подходящие операции		
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитарныеКомпанииИОтчеты.ДепозитарнаяКомпания КАК ДепозитарнаяКомпания,
		|	ДепозитарныеКомпанииИОтчеты.ОтчетДепозитария КАК ОтчетДепозитария
		|ПОМЕСТИТЬ _ДепозитарныеКомпанииИОтчеты
		|ИЗ
		|	&ДепозитарныеКомпанииИОтчеты КАК ДепозитарныеКомпанииИОтчеты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЖурналОперацийБэкОфиса.Документ КАК Документ
		|ПОМЕСТИТЬ _ПоставкиЦенныхБумагОтДругогоДепозитария
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоставкаЦенныхБумаг КАК ПоставкаЦенныхБумаг
		|		ПО (ПоставкаЦенныхБумаг.Ссылка = ЖурналОперацийБэкОфиса.Документ)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоставкаЦенныхБумаг.ЦенныеБумаги КАК ПоставкаЦенныхБумагЦенныеБумаги
		|		ПО (ПоставкаЦенныхБумагЦенныеБумаги.Ссылка = ПоставкаЦенныхБумаг.Ссылка)
		|			И (ПоставкаЦенныхБумагЦенныеБумаги.ДепозитарныйСчет.Депозитарий <> &ДепозитарнаяКомпания)
		|ГДЕ
		|	ЖурналОперацийБэкОфиса.Организация = &Организация
		|	И ЖурналОперацийБэкОфиса.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЖурналОперацийБэкОфиса.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.ПоставкаЦенныхБумаг)
		|	И ЖурналОперацийБэкОфиса.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ЖурналОперацийБэкОфиса.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументов.Проведен)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЖурналОперацийБэкОфиса.Документ КАК Документ
		|ПОМЕСТИТЬ _КонвертацияЦенныхБумагОтДругогоДепозитария
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КонвертацияЦенныхБумаг.ЦенныеБумаги КАК КонвертацияЦенныхБумагЦенныеБумаги
		|		ПО (КонвертацияЦенныхБумагЦенныеБумаги.Ссылка = ЖурналОперацийБэкОфиса.Документ)
		|			И (КонвертацияЦенныхБумагЦенныеБумаги.ДепозитарныйСчет.Депозитарий = &ДепозитарнаяКомпания)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КонвертацияЦенныхБумаг.ЦенныеБумаги КАК КонвертацияЦенныхБумагЦенныеБумагиОтДругогоДепозитария
		|		ПО (КонвертацияЦенныхБумагЦенныеБумагиОтДругогоДепозитария.Ссылка = КонвертацияЦенныхБумагЦенныеБумаги.Ссылка)
		|			И (КонвертацияЦенныхБумагЦенныеБумагиОтДругогоДепозитария.ДепозитарныйСчет.Депозитарий <> &ДепозитарнаяКомпания)
		|ГДЕ
		|	ЖурналОперацийБэкОфиса.Организация = &Организация
		|	И ЖурналОперацийБэкОфиса.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЖурналОперацийБэкОфиса.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.КонвертацияЦенныхБумаг)
		|	И ЖурналОперацийБэкОфиса.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ЖурналОперацийБэкОфиса.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументов.Проведен)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖурналОперацийБэкОфиса.Документ КАК Операция,
		|	"""" КАК Примечание
		|ПОМЕСТИТЬ _ОперацииДепозитария
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|ГДЕ
		|	ЖурналОперацийБэкОфиса.Организация = &Организация
		|	И ЖурналОперацийБэкОфиса.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЖурналОперацийБэкОфиса.ВидОперации В(&ОперацииСДепозитарием)
		|	И ЖурналОперацийБэкОфиса.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ЖурналОперацийБэкОфиса.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументов.Проведен)
		|	И ВЫБОР
		|			КОГДА ЖурналОперацийБэкОфиса.Документ ССЫЛКА Документ.ВводЦенныхБумаг
		|				ТОГДА ВЫРАЗИТЬ(ЖурналОперацийБэкОфиса.Документ КАК Документ.ВводЦенныхБумаг).ДепозитарныйСчет.Депозитарий = &ДепозитарнаяКомпания
		|			КОГДА ЖурналОперацийБэкОфиса.Документ ССЫЛКА Документ.ВыводЦенныхБумаг
		|				ТОГДА ВЫРАЗИТЬ(ЖурналОперацийБэкОфиса.Документ КАК Документ.ВыводЦенныхБумаг).ДепозитарныйСчет.Депозитарий = &ДепозитарнаяКомпания
		|			КОГДА ЖурналОперацийБэкОфиса.Документ ССЫЛКА Документ.СнятиеЦеннойБумагиСУчета
		|				ТОГДА ВЫРАЗИТЬ(ЖурналОперацийБэкОфиса.Документ КАК Документ.СнятиеЦеннойБумагиСУчета).ДепозитарныйСчет.Депозитарий = &ДепозитарнаяКомпания
		|			КОГДА ЖурналОперацийБэкОфиса.Документ ССЫЛКА Документ.СписаниеЦеннойБумаги
		|				ТОГДА ВЫРАЗИТЬ(ЖурналОперацийБэкОфиса.Документ КАК Документ.СписаниеЦеннойБумаги).ДепозитарныйСчет.Депозитарий = &ДепозитарнаяКомпания
		|		КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЖурналОперацийБэкОфиса.Документ,
		|	""""
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоставкаЦенныхБумаг КАК ПоставкаЦенныхБумаг
		|		ПО (ПоставкаЦенныхБумаг.Ссылка = ЖурналОперацийБэкОфиса.Документ)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоставкаЦенныхБумаг.ЦенныеБумаги КАК ПоставкаЦенныхБумагЦенныеБумаги
		|		ПО (ПоставкаЦенныхБумагЦенныеБумаги.Ссылка = ПоставкаЦенныхБумаг.Ссылка)
		|			И (ПоставкаЦенныхБумагЦенныеБумаги.ДепозитарныйСчет.Депозитарий = &ДепозитарнаяКомпания)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПоставкиЦенныхБумагОтДругогоДепозитария КАК _ПоставкиЦенныхБумагОтДругогоДепозитария
		|		ПО (_ПоставкиЦенныхБумагОтДругогоДепозитария.Документ = ЖурналОперацийБэкОфиса.Документ)
		|ГДЕ
		|	ЖурналОперацийБэкОфиса.Организация = &Организация
		|	И ЖурналОперацийБэкОфиса.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЖурналОперацийБэкОфиса.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.ПоставкаЦенныхБумаг)
		|	И ЖурналОперацийБэкОфиса.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ЖурналОперацийБэкОфиса.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументов.Проведен)
		|	И _ПоставкиЦенныхБумагОтДругогоДепозитария.Документ ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЖурналОперацийБэкОфиса.Документ,
		|	""""
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КонвертацияЦенныхБумаг.ЦенныеБумаги КАК КонвертацияЦенныхБумагЦенныеБумаги
		|		ПО (КонвертацияЦенныхБумагЦенныеБумаги.Ссылка = ЖурналОперацийБэкОфиса.Документ)
		|			И (КонвертацияЦенныхБумагЦенныеБумаги.ДепозитарныйСчет.Депозитарий = &ДепозитарнаяКомпания)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КонвертацияЦенныхБумагОтДругогоДепозитария КАК _КонвертацияЦенныхБумагОтДругогоДепозитария
		|		ПО (_КонвертацияЦенныхБумагОтДругогоДепозитария.Документ = ЖурналОперацийБэкОфиса.Документ)
		|ГДЕ
		|	ЖурналОперацийБэкОфиса.Организация = &Организация
		|	И ЖурналОперацийБэкОфиса.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЖурналОперацийБэкОфиса.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.КонвертацияЦенныхБумаг)
		|	И ЖурналОперацийБэкОфиса.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ЖурналОперацийБэкОфиса.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументов.Проведен)
		|	И _КонвертацияЦенныхБумагОтДругогоДепозитария.Документ ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЖурналОперацийБэкОфиса.Документ,
		|	""""
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПереводЦенныхБумаг КАК ПереводЦенныхБумаг
		|		ПО (ПереводЦенныхБумаг.Ссылка = ЖурналОперацийБэкОфиса.Документ)
		|			И (ПереводЦенныхБумаг.ДепозитарныйСчет.Депозитарий = &ДепозитарнаяКомпания)
		|			И (ПереводЦенныхБумаг.ДепозитарныйСчетПолучатель.Депозитарий = &ДепозитарнаяКомпания)
		|ГДЕ
		|	ЖурналОперацийБэкОфиса.Организация = &Организация
		|	И ЖурналОперацийБэкОфиса.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЖурналОперацийБэкОфиса.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.ПереводЦенныхБумаг)
		|	И ЖурналОперацийБэкОфиса.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ЖурналОперацийБэкОфиса.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументов.Проведен)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЖурналОперацийБэкОфиса.Документ,
		|	""На основе сверок с отчетами обоих депозитариев""
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПереводЦенныхБумаг КАК ПереводЦенныхБумаг
		|		ПО (ПереводЦенныхБумаг.Ссылка = ЖурналОперацийБэкОфиса.Документ)
		|			И (&ДепозитарнаяКомпания В (ПереводЦенныхБумаг.ДепозитарныйСчет.Депозитарий, ПереводЦенныхБумаг.ДепозитарныйСчетПолучатель.Депозитарий))
		|			И (ПереводЦенныхБумаг.ДепозитарныйСчет.Депозитарий <> ПереводЦенныхБумаг.ДепозитарныйСчетПолучатель.Депозитарий)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДепозитарныеКомпанииИОтчеты КАК _ДепозитарныеКомпанииИОтчеты
		|		ПО (_ДепозитарныеКомпанииИОтчеты.ДепозитарнаяКомпания = ВЫБОР
		|				КОГДА ПереводЦенныхБумаг.ДепозитарныйСчет.Депозитарий = &ДепозитарнаяКомпания
		|					ТОГДА ПереводЦенныхБумаг.ДепозитарныйСчетПолучатель.Депозитарий
		|				ИНАЧЕ ПереводЦенныхБумаг.ДепозитарныйСчет.Депозитарий
		|			КОНЕЦ)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналСверокПоВнутреннемуУчету.СрезПоследних(
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЖурналСверокПоВнутреннемуУчету
		|		ПО (ЖурналСверокПоВнутреннемуУчету.ПериодСверки = НАЧАЛОПЕРИОДА(ПереводЦенныхБумаг.Дата, ДЕНЬ))
		|			И (ЖурналСверокПоВнутреннемуУчету.Основание = _ДепозитарныеКомпанииИОтчеты.ОтчетДепозитария)
		|			И (ЖурналСверокПоВнутреннемуУчету.Пройдена = ИСТИНА)
		|ГДЕ
		|	ЖурналОперацийБэкОфиса.Организация = &Организация
		|	И ЖурналОперацийБэкОфиса.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЖурналОперацийБэкОфиса.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.ПереводЦенныхБумаг)
		|	И ЖурналОперацийБэкОфиса.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ЖурналОперацийБэкОфиса.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументов.Проведен)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ДатаПодтверждения КАК Период,
		|	&Организация КАК Организация,
		|	_ОперацииДепозитария.Операция КАК Операция,
		|	ПРЕДСТАВЛЕНИЕССЫЛКИ(_ОперацииДепозитария.Операция) КАК ПредставлениеОперации,
		|	ИСТИНА КАК Подтверждена,
		|	""Отчет депозитария"" КАК Основание,
		|	ЛОЖЬ КАК РучнойРежим,
		|	_ОперацииДепозитария.Примечание КАК Примечание,
		|	&СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	_ОперацииДепозитария КАК _ОперацииДепозитария
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПодтверждениеОперацийБэкОфиса.СрезПоследних(
		|				,
		|				(Операция, Организация) В
		|					(ВЫБРАТЬ
		|						_ОперацииДепозитария.Операция,
		|						&Организация
		|					ИЗ
		|						_ОперацииДепозитария)) КАК ПодтверждениеОперацийБэкОфиса
		|		ПО (ПодтверждениеОперацийБэкОфиса.Организация = &Организация)
		|			И (ПодтверждениеОперацийБэкОфиса.Операция = _ОперацииДепозитария.Операция)
		|			И (ПодтверждениеОперацийБэкОфиса.Подтверждена = ИСТИНА)
		|ГДЕ
		|	ПодтверждениеОперацийБэкОфиса.Организация ЕСТЬ NULL");
		
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДепозитарнаяКомпания",			ДепозитарнаяКомпания);
	Запрос.УстановитьПараметр("НачалоПериода",					НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",					КонецПериода);
	Запрос.УстановитьПараметр("ОперацииСДепозитарием",			ОперацииСДепозитарием);
	Запрос.УстановитьПараметр("ДепозитарныеКомпанииИОтчеты",	ДепозитарныеКомпанииИОтчеты);	
	Запрос.УстановитьПараметр("ДатаПодтверждения",				ТекущаяДата());
	
	УстановитьПривилегированныйРежим(Истина);	
	
	НеподтвержденныеОперации = Запрос.Выполнить().Выгрузить();		
	
	ПодтверждениеОперацийБэкОфиса = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.СоздатьНаборЗаписей();
	ПодтверждениеОперацийБэкОфиса.Отбор.Организация.Установить(Организация);
	ПодтверждениеОперацийБэкОфиса.Загрузить(НеподтвержденныеОперации);
	ПодтверждениеОперацийБэкОфиса.Записать(Ложь);	
	
	УстановитьПривилегированныйРежим(Ложь);	
	
	Возврат НеподтвержденныеОперации;
КонецФункции

