Функция ПолучитьРезультатыСверкиСЖурналомПодтверждений(ДатаНачала, ДатаОкончания, Организация, ОтборКлиентов = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ДатаНачала) ИЛИ Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для получения результатов сверки должны быть заданы границы периода");
		Возврат Неопределено;
	КонецЕсли;	
	        
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделка.Организация КАК Организация,
		|	Сделка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Сделка.Ссылка КАК Операция,
		|	НАЧАЛОПЕРИОДА(Сделка.Дата, ДЕНЬ) КАК ДатаОперации
		|ПОМЕСТИТЬ _ОперацииКлиента
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|ГДЕ
		|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.Сделка) В (&ПодтверждаемыеВидыОпераций)
		|	И Сделка.Организация = &Организация
		|	И Сделка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И Сделка.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И Сделка.Проведен = ИСТИНА
		|	И &СчетДоверительногоУправления В (Сделка.СчетДоверительногоУправления, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИсполнениеОбязательствПоСделке.Организация,
		|	ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления,
		|	ИсполнениеОбязательствПоСделке.Ссылка,
		|	НАЧАЛОПЕРИОДА(ИсполнениеОбязательствПоСделке.Дата, ДЕНЬ)
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|ГДЕ
		|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.ИсполнениеОбязательствПоСделке) В (&ПодтверждаемыеВидыОпераций)
		|	И ИсполнениеОбязательствПоСделке.Организация = &Организация
		|	И ИсполнениеОбязательствПоСделке.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ИсполнениеОбязательствПоСделке.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И ИсполнениеОбязательствПоСделке.Проведен = ИСТИНА
		|	И &СчетДоверительногоУправления В (ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЖурналОперацийБэкОфиса.Организация,
		|	ЖурналОперацийБэкОфиса.СчетДоверительногоУправления,
		|	ЖурналОперацийБэкОфиса.Документ,
		|	НАЧАЛОПЕРИОДА(ЖурналОперацийБэкОфиса.Дата, ДЕНЬ)
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|ГДЕ
		|	ЖурналОперацийБэкОфиса.ВидОперации В(&ПодтверждаемыеВидыОпераций)
		|	И НЕ(ЖурналОперацийБэкОфиса.Документ ССЫЛКА Документ.ПоручениеНаДвижениеДенежныхСредств
		|				И ВЫРАЗИТЬ(ЖурналОперацийБэкОфиса.Документ КАК Документ.ПоручениеНаДвижениеДенежныхСредств).СпособПередачи = ЗНАЧЕНИЕ(Перечисление.СпособыПередачиПоручений.ВнутренняяСистема))
		|	И ЖурналОперацийБэкОфиса.Организация = &Организация
		|	И ЖурналОперацийБэкОфиса.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ЖурналОперацийБэкОфиса.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументов.Проведен)
		|	И &СчетДоверительногоУправления В (ЖурналОперацийБэкОфиса.СчетДоверительногоУправления, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ОперацииКлиента.Организация КАК Организация,
		|	_ОперацииКлиента.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОперацииКлиента.ДатаОперации КАК ДатаОперации,
		|	ЕСТЬNULL(ПодтверждениеОперацийБэкОфиса.Подтверждена, ЛОЖЬ) КАК ОперацияПодтверждена
		|ПОМЕСТИТЬ _ПроверенныеКлиенты
		|ИЗ
		|	_ОперацииКлиента КАК _ОперацииКлиента
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПодтверждениеОперацийБэкОфиса.СрезПоследних(
		|				,
		|				(Организация, Операция) В
		|					(ВЫБРАТЬ
		|						_ОперацииКлиента.Организация,
		|						_ОперацииКлиента.Операция
		|					ИЗ
		|						_ОперацииКлиента)) КАК ПодтверждениеОперацийБэкОфиса
		|		ПО (ПодтверждениеОперацийБэкОфиса.Организация = _ОперацииКлиента.Организация)
		|			И (ПодтверждениеОперацийБэкОфиса.Операция = _ОперацииКлиента.Операция)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _ДниСверок
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаря.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.СчетДоверительногоУправления.Организация КАК Организация,
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВложенныйЗапрос.Дата КАК ПериодСверки
		|ПОМЕСТИТЬ _ДниСверокКлиентов
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ДниСверок.Дата КАК Дата,
		|		СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|		ЛицензииДоговоровДоверительногоУправления.Лицензия КАК Лицензия,
		|		МАКСИМУМ(ЛицензииДоговоровДоверительногоУправления.Период) КАК ПериодЛицензии
		|	ИЗ
		|		_ДниСверок КАК _ДниСверок
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|			ПО (СчетаДоверительногоУправления.Организация = &Организация)
		|				И (НЕ СчетаДоверительногоУправления.ПометкаУдаления)
		|				И (СчетаДоверительногоУправления.ДатаЗаключения <= _ДниСверок.Дата)
		|				И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= _ДниСверок.Дата)
		|				И (&СчетДоверительногоУправления В (СчетаДоверительногоУправления.Ссылка, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка)))
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления КАК ЛицензииДоговоровДоверительногоУправления
		|			ПО (ЛицензииДоговоровДоверительногоУправления.Организация = &Организация)
		|				И (СчетаДоверительногоУправления.Ссылка = ЛицензииДоговоровДоверительногоУправления.СчетДоверительногоУправления)
		|				И _ДниСверок.Дата >= ЛицензииДоговоровДоверительногоУправления.Период
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ДниСверок.Дата,
		|		СчетаДоверительногоУправления.Ссылка,
		|		ЛицензииДоговоровДоверительногоУправления.Лицензия) КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления КАК ЛицензииДоговоровДоверительногоУправления
		|		ПО ВложенныйЗапрос.ПериодЛицензии = ЛицензииДоговоровДоверительногоУправления.Период
		|			И (ЛицензииДоговоровДоверительногоУправления.Организация = &Организация)
		|			И ВложенныйЗапрос.СчетДоверительногоУправления = ЛицензииДоговоровДоверительногоУправления.СчетДоверительногоУправления
		|			И ВложенныйЗапрос.Лицензия = ЛицензииДоговоровДоверительногоУправления.Лицензия
		|			И (ЛицензииДоговоровДоверительногоУправления.Действует)
		|ГДЕ
		|	&ВидДеятельности В (ЛицензииДоговоровДоверительногоУправления.Лицензия.ВидДеятельности, ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.ПустаяСсылка))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДниСверокКлиентов.Организация КАК Организация,
		|	_ДниСверокКлиентов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДниСверокКлиентов.ПериодСверки КАК ПериодСверки,
		|	МИНИМУМ(ЕСТЬNULL(_ПроверенныеКлиенты.ОперацияПодтверждена, ИСТИНА)) КАК Пройдена
		|ИЗ
		|	_ДниСверокКлиентов КАК _ДниСверокКлиентов
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПроверенныеКлиенты КАК _ПроверенныеКлиенты
		|		ПО (_ПроверенныеКлиенты.Организация = _ДниСверокКлиентов.Организация)
		|			И (_ПроверенныеКлиенты.СчетДоверительногоУправления = _ДниСверокКлиентов.СчетДоверительногоУправления)
		|			И (_ПроверенныеКлиенты.ДатаОперации = _ДниСверокКлиентов.ПериодСверки)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДниСверокКлиентов.Организация,
		|	_ДниСверокКлиентов.СчетДоверительногоУправления,
		|	_ДниСверокКлиентов.ПериодСверки");
	
	СчетДоверительногоУправления	= Справочники.СчетаДоверительногоУправления.ПустаяСсылка();
	ВидДеятельности					= Справочники.ВидыДеятельности.ПустаяСсылка();
	
	Если ТипЗнч(ОтборКлиентов) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		СчетДоверительногоУправления = ОтборКлиентов;
	ИначеЕсли ТипЗнч(ОтборКлиентов) = Тип("СправочникСсылка.ВидыДеятельности") Тогда
		ВидДеятельности = ОтборКлиентов;
	ИначеЕсли ОтборКлиентов <> Неопределено Тогда
		ВызватьИсключение "Неизвестный тип отбора клиентов """ + Строка(ОтборКлиентов) + """";
	КонецЕсли;	
		
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("ДатаНачала",						ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",					ДатаОкончания);
	Запрос.УстановитьПараметр("ПодтверждаемыеВидыОпераций",		ПолучитьПодтверждаемыеВидыОпераций());
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидДеятельности",				ВидДеятельности);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
