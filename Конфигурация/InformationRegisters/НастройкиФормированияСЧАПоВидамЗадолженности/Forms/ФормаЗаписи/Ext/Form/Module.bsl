
#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	 ОбновитьКомментарийНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ЭЛЕМЕНТОВ_ФОРМЫ

&НаСервере
Процедура ПериодПриИзмененииНаСервере()
	
	ОбновитьКомментарийНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	ПериодПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СчетДоверительногоУправленияПриИзмененииНаСервере()
	
	ОбновитьКомментарийНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	СчетДоверительногоУправленияПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ВидЗадолженностиПриИзмененииНаСервере()
	
	ОбновитьКомментарийНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидЗадолженностиПриИзменении(Элемент)
	
	ВидЗадолженностиПриИзмененииНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СЛУЖЕБНЫЕ_ПРОЦЕДУРЫ_И_ФУНКЦИИ

&НаСервере
Процедура ОбновитьКомментарийНаСервере()
	
	ПоказатьКомментарий = Ложь;
	
	// Проверяем, что можно выполнить дальнейшую проверку
	Если (ЗначениеЗаполнено(Запись.СчетДоверительногоУправления) И ЗначениеЗаполнено(Запись.Организация) И Запись.Период >= '20191231') 
		И ЗначениеЗаполнено(Запись.ВидЗадолженности) И Запись.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.НДФЛ) Тогда
		
		// Для методики РЭМ нужно показывать комментарий
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиЦелейРасчетаСрезПоследних.ВариантРасчетаОценочнойСтоимости = ЗНАЧЕНИЕ(Справочник.ВариантыРасчетаОценочнойСтоимости.РЭМ) КАК ПоказатьКомментарий
		|ИЗ
		|	РегистрСведений.НастройкиЦелейРасчета.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)) КАК НастройкиЦелейРасчетаСрезПоследних";
		
		Запрос.УстановитьПараметр("Период", 						Запись.Период);
		Запрос.УстановитьПараметр("Организация", 					Запись.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	Запись.СчетДоверительногоУправления);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ПоказатьКомментарий = Выборка.ПоказатьКомментарий;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(ЭтаФорма.Комментарий) И Не ПоказатьКомментарий Тогда
		ЭтаФорма.Комментарий = "";
	ИначеЕсли ПустаяСтрока(ЭтаФорма.Комментарий) И ПоказатьКомментарий Тогда
		ЭтаФорма.Комментарий = "Для методики РЭМ с 31.12.2019 г. кредиторская задолженность по НДФЛ по умолчанию не включается в СЧА";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти