
Процедура ПередЗаписью(Отказ, Замещение)
	
	Для Каждого Запись Из ЭтотОбъект Цикл 
		Если Запись.ИсключенИзРеестра Тогда
			Если ЗначениеЗаполнено(Запись.ДержательРеестра) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При исключении из реестра 'Держатель реестра' должен быть пустой",,,, Отказ);
			КонецЕсли;
			Если ЗначениеЗаполнено(Запись.НомерВРеестре) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При исключении из реестра 'Номер в реестре' должен быть пустой",,,, Отказ);
			КонецЕсли;
			
		Иначе
			Если НЕ ЗначениеЗаполнено(Запись.ДержательРеестра) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле 'Держатель реестра'",,,, Отказ);
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Запись.НомерВРеестре) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле 'Номер в реестре'",,,, Отказ);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


