
Функция ЗаписатьНомер(Номер, ВнешняяСистема, СубъектСсылка, КлючЗаписи = "", ОповеститьОбОшибке = Истина) Экспорт
	
	РезультатЗаписи = Ложь;
	
	УстановитьПривилегированныйРежим(Истина);
				
	Попытка
		
		Запись = РегистрыСведений.НомераТранзакций.СоздатьМенеджерЗаписи();
	
		Запись.Субъект                 = СубъектСсылка;
		Запись.ВнешняяСистема          = ВнешняяСистема;
		Запись.УникальныйИдентификатор = Новый УникальныйИдентификатор;
		Запись.Номер                   = Номер;
		
		Если ЗначениеЗаполнено(КлючЗаписи) Тогда
			Запись.Ключ = КлючЗаписи;
		КонецЕсли;

		Запись.Записать();
		
		РезультатЗаписи = Истина;
		
	Исключение
		
		Если ОповеститьОбОшибке Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка записи номера [" + Номер + "] в регистр [Номера транзакций], субъект записи [" + СубъектСсылка + "]." + Символы.ПС + ОписаниеОшибки());
		КонецЕсли;
		
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);

	Возврат РезультатЗаписи;
		
КонецФункции