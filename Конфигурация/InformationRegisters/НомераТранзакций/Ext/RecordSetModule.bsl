
////////////////////////////////////////////////////////////////////////////////
// ПРЕДОПРЕДЕЛЕННЫЕ

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Для каждого Запись Из ЭтотОбъект Цикл
		
		Если Запись.ВнешняяСистема = Справочники.ВнешниеСистемы.ПерваяФорма Тогда
			
			ПроверяемыеРеквизиты.Добавить("УникальныйИдентификатор");
			ПроверяемыеРеквизиты.Добавить("Ключ");
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;

	ЭтотОбъект.ДополнительныеСвойства.Вставить("ОбработкаПроверкиЗаполненияОтказ", Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, Замещение)
	
	УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
		
	ЕстьЗаписьДанныхИзПервойФормы = (ЭтотОбъект.Выгрузить(, "ВнешняяСистема").Найти(Справочники.ВнешниеСистемы.ПерваяФорма, "ВнешняяСистема") <> Неопределено);
	
	Если ЕстьЗаписьДанныхИзПервойФормы Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НомераТранзакций.Субъект КАК Субъект,
			|	НомераТранзакций.УникальныйИдентификатор КАК УникальныйИдентификатор,
			|	НомераТранзакций.Ключ КАК Ключ,
			|	НомераТранзакций.Номер КАК Номер
			|ПОМЕСТИТЬ _НомераТранзакций
			|ИЗ
			|	РегистрСведений.НомераТранзакций КАК НомераТранзакций
			|ГДЕ
			|	НомераТранзакций.ВнешняяСистема = &ПерваяФорма
			|	И НЕ НомераТранзакций.Субъект ССЫЛКА Документ.Распоряжение
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_НомераТранзакций.УникальныйИдентификатор КАК Значение,
			|	""В регистре """"Номера транзакций"""" присутствует запись с уникальным идентификатором [%1]"" КАК ТекстОшибки
			|ИЗ
			|	_НомераТранзакций КАК _НомераТранзакций
			|
			|СГРУППИРОВАТЬ ПО
			|	_НомераТранзакций.УникальныйИдентификатор
			|
			|ИМЕЮЩИЕ
			|	СУММА(1) > 1
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_НомераТранзакций.Ключ,
			|	""В регистре """"Номера транзакций"""" уже присутствует запись с ключом [%1]""
			|ИЗ
			|	_НомераТранзакций КАК _НомераТранзакций
			|
			|СГРУППИРОВАТЬ ПО
			|	_НомераТранзакций.Ключ
			|
			|ИМЕЮЩИЕ
			|	СУММА(1) > 1
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_НомераТранзакций.Номер,
			|	""В регистре """"Номера транзакций"""" уже присутствует запись с номером [%1]""
			|ИЗ
			|	_НомераТранзакций КАК _НомераТранзакций
			|
			|СГРУППИРОВАТЬ ПО
			|	_НомераТранзакций.Номер
			|
			|ИМЕЮЩИЕ
			|	СУММА(1) > 1";
		
		Запрос.УстановитьПараметр("ПерваяФорма", Справочники.ВнешниеСистемы.ПерваяФорма);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Выборка.ТекстОшибки, Выборка.Значение),,,, Отказ);	
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры
