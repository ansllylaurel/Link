Процедура ПередЗаписью(Отказ, Замещение)
	
	// Банковские выписки не должны быть помечены на удаление
	СообщениеОбОшибке = Неопределено;	
	Если Не ПроверитьСтрокиБанковскойВыписки(СообщениеОбОшибке) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбОшибке, , , , Отказ);
	КонецЕсли;
	
КонецПроцедуры

#Область Вспомогательные_функции

// Банковские выписки не должны быть помечены на удаление
Функция ПроверитьСтрокиБанковскойВыписки(СообщениеОбОшибке = Неопределено)

	// Если записи удаляются, то проверку не выполняем
	Если ЭтотОбъект.Количество() = 0 Тогда
		Возврат Истина;	
	КонецЕсли;
	
	Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ 
		|	_НовыйНаборЗаписей.СтрокаБанковскойВыписки
		|ПОМЕСТИТЬ
		|	_НовыйНаборЗаписей
		|ИЗ
		|	&НовыйНаборЗаписей КАК _НовыйНаборЗаписей
		|;
		|
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ 
		|	_НовыйНаборЗаписей.СтрокаБанковскойВыписки КАК СтрокаБанковскойВыписки 
		|ИЗ
		|	_НовыйНаборЗаписей КАК _НовыйНаборЗаписей
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СтрокаБанковскойВыписки КАК БанковскиеВыписки
		|		ПО БанковскиеВыписки.Ссылка = _НовыйНаборЗаписей.СтрокаБанковскойВыписки
		|			И БанковскиеВыписки.ПометкаУдаления = ИСТИНА
		|");
	Запрос.УстановитьПараметр("НовыйНаборЗаписей", ЭтотОбъект.Выгрузить(, "СтрокаБанковскойВыписки"));
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		НепрошедшиеПроверку	= РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("СтрокаБанковскойВыписки");
		
		Если НепрошедшиеПроверку.Количество() = 1 Тогда
			СообщениеОбОшибке = "Документ '" + Строка(НепрошедшиеПроверку[0]) + "' помечен на удаление и не может быть зарегистрирован в реестре платежей!";
		Иначе
			СообщениеОбОшибке = "Документы '" + СтрСоединить(НепрошедшиеПроверку, "', '") + "' помечены на удаление и не могут быть зарегистрированы в реестре платежей!";
		КонецЕсли;
		
		Возврат Ложь;
	КонецЕсли;	
	
	Возврат Истина;

КонецФункции

Процедура ПриЗаписи(Отказ, Замещение)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СтрокиБанковскойВыписки", ЭтотОбъект.Выгрузить(, "СтрокаБанковскойВыписки").ВыгрузитьКолонку("СтрокаБанковскойВыписки"));
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеестрПлатежей.СтрокаБанковскойВыписки КАК СтрокаБанковскойВыписки,
		|	РеестрПлатежей.СтрокаБанковскойВыписки.Сумма КАК СуммаСтрокиБанковскойВыписки,
		|	СУММА(РеестрПлатежей.Сумма) КАК СуммаПлатежей
		|ПОМЕСТИТЬ _Оплаты
		|ИЗ
		|	РегистрСведений.РеестрПлатежей КАК РеестрПлатежей
		|ГДЕ
		|	РеестрПлатежей.СтрокаБанковскойВыписки В(&СтрокиБанковскойВыписки)
		|
		|СГРУППИРОВАТЬ ПО
		|	РеестрПлатежей.СтрокаБанковскойВыписки,
		|	РеестрПлатежей.СтрокаБанковскойВыписки.Сумма
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Оплаты.СтрокаБанковскойВыписки КАК СтрокаБанковскойВыписки,
		|	_Оплаты.СуммаСтрокиБанковскойВыписки КАК СуммаСтрокиБанковскойВыписки,
		|	_Оплаты.СуммаПлатежей КАК СуммаПлатежей
		|ИЗ
		|	_Оплаты КАК _Оплаты
		|ГДЕ
		|	_Оплаты.СуммаСтрокиБанковскойВыписки < _Оплаты.СуммаПлатежей";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 0 Тогда
		
		Отказ = Истина;
		
		СообщениеОбОшибке = "";
		
		Пока Выборка.Следующий() Цикл
			СообщениеОбОшибке = ?(ЗначениеЗаполнено(СообщениеОбОшибке), СообщениеОбОшибке + Символы.ПС, "") + "
								|По '" + Строка(Выборка.СтрокаБанковскойВыписки) + "' превышена сумма в документах оплаты!
								|Сумма строки банковской выписки: " + Формат(Выборка.СуммаСтрокиБанковскойВыписки, "ЧДЦ=2") + "
								|Cумма в документах оплаты: " + Формат(Выборка.СуммаПлатежей, "ЧДЦ=2") + ".";
		КонецЦикла;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбОшибке);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
