
////////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Запись.ИсходныйКлючЗаписи.Пустой() Тогда
		Запись.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	КонецЕсли;	
	
	ПриСозданииЧтенииНаСервере();
	
КонецПроцедуры // ПриСозданииНаСервере

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПриСозданииЧтенииНаСервере();
	
КонецПроцедуры // ПриЧтенииНаСервере

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// если флажки управляющие видимостью реквизитов установлены, то соответствуюшие реквизиты должны быть заполнены
	Если ЭтаФорма.ИсполнительЗакрыт И Не ЗначениеЗаполнено(Запись.ДатаЗакрытия) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена поле ""Дата закрытия""",, "ДатаЗакрытия", "Запись", Отказ);
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ИсполнительЗакрытПриИзменении(Элемент)
	
	Если Не ЭтаФорма.ИсполнительЗакрыт Тогда
		Запись.ДатаЗакрытия = Неопределено;
	КонецЕсли;
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры // ИсполнительЗакрытПриИзменении

&НаКлиенте
Процедура РасчетныйСчетПриИзменении(Элемент)
	
	// изменение даты закрытия
	ДатаЗакрытияСчета = РаботаСНормативноСправочнойИнформацией.ПолучитьДатуЗакрытияСчетаПоДоговору(Запись.РасчетныйСчет);
	
	Если ЗначениеЗаполнено(ДатаЗакрытияСчета)
		И (Запись.ДатаЗакрытия > ДатаЗакрытияСчета Или Не ЗначениеЗаполнено(Запись.ДатаЗакрытия))
	Тогда
		Запись.ДатаЗакрытия        = ДатаЗакрытияСчета;
		ЭтаФорма.ИсполнительЗакрыт = Истина;
	КонецЕсли;
	
	НастроитьВидимостьДоступность(ЭтаФорма);

КонецПроцедуры // РасчетныйСчетПриИзменении

////////////////////////////////////////////////////////////////////////////////
// КОМАНДЫ ФОРМЫ

&НаКлиенте
Процедура КомандаЗакрытьДоговор(Команда)
	
	Если ЭтаФорма.Модифицированность ИЛИ Запись.ИсходныйКлючЗаписи.Пустой() Тогда
		Если Вопрос("Перед закрытием исполнителя необходимо сохранить внесенные изменения. Сохранить?", РежимДиалогаВопрос.ОКОтмена) <> КодВозвратаДиалога.ОК Тогда
			Возврат;
		КонецЕсли;
		
		Если Не РаботаСФормамиКлиентСервер.ЗаписатьФорму(ЭтаФорма) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ДоговорБанковскогоОбслуживания	= РаботаСИсполнителями.ПолучитьДоговор(Запись.ИсходныйКлючЗаписи);	
	КорневойЭлемент					= ?(ЗначениеЗаполнено(ДоговорБанковскогоОбслуживания), ДоговорБанковскогоОбслуживания, Запись.РасчетныйСчет);	
	
	АдресДереваДочернихЭлементов = РаботаСИсполнителями.ПолучитьДочерниеЭлементы(КорневойЭлемент, , "ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)", , ЭтаФорма.УникальныйИдентификатор);
	Если ЗначениеЗаполнено(АдресДереваДочернихЭлементов) Тогда
		ДополнительныеРеквизиты = Новый Массив;
		ДополнительныеРеквизиты.Добавить(Новый Структура("Имя, ТипЗначения, Заголовок, Значение", "ДатаЗакрытия", Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.Дата)), "Дата закрытия", ТекущаяДата()));
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("РежимВыбора",					Истина);
		ДополнительныеПараметры.Вставить("МножественныйВыбор",			Истина);
		ДополнительныеПараметры.Вставить("ВидимыеКолонки",				"Представление");
		ДополнительныеПараметры.Вставить("ОтмеченныеЭлементы",			Новый Структура("Элемент", Запись.ИсходныйКлючЗаписи));
		ДополнительныеПараметры.Вставить("ДополнительныеРеквизиты",		ДополнительныеРеквизиты);
		ДополнительныеПараметры.Вставить("ПутьКДаннымКартинкиСтроки",	"ДеревоЗначений.ДанныеКартинки");
		ДополнительныеПараметры.Вставить("КартинкаСтрок",				БиблиотекаКартинок.РегистрСведенийЗапись);
		
		РезультатВопроса = РаботаСФормамиКлиент.ПоказатьДеревоЗначений(АдресДереваДочернихЭлементов, "При закрытии исполнителя можно закрыть вышестоящие элементы:", ЭтаФорма, РежимДиалогаВопрос.ОКОтмена, КодВозвратаДиалога.ОК, "Закрытие исполнителя", ДополнительныеПараметры);
		Если РезультатВопроса <> КодВозвратаДиалога.ОК Тогда
			Возврат;
		КонецЕсли;
		
		РаботаСИсполнителями.ЗакрытьДеревоЭлементов(ДополнительныеПараметры.АдресДереваЗначений, ДополнительныеПараметры.ДополнительныеРеквизиты.ДатаЗакрытия);
		
		ЭтотОбъект.Прочитать();
	КонецЕсли;	
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ

&НаСервере
Процедура ПриСозданииЧтенииНаСервере()

	ЭтаФорма.ИсполнительЗакрыт = ЗначениеЗаполнено(Запись.ДатаЗакрытия);
	                		
	НастроитьВидимостьДоступность(ЭтаФорма);	

КонецПроцедуры // ПриСозданииЧтенииНаСервере

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступность(ЭтаФорма)
	
	Элементы = ЭтаФорма.Элементы;
	
	Элементы.ИсполнительЗакрыт.Видимость		= ЭтаФорма.ИсполнительЗакрыт;	
	Элементы.ДатаЗакрытия.Видимость				= ЭтаФорма.ИсполнительЗакрыт;
	Элементы.КомандаЗакрытьДоговор.Видимость	= Не Элементы.ДатаЗакрытия.Видимость;			
	
КонецПроцедуры // НастроитьВидимостьДоступность