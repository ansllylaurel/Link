
////////////////////////////////////////////////////////////////////////////////
// ПРЕДОПРЕДЕЛЕННЫЕ

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, Замещение)
	
	РеквизитыАдреса = Новый Массив;
	РеквизитыАдреса.Добавить("ЮридическийАдрес");
	РеквизитыАдреса.Добавить("ФактическийАдрес");
	РеквизитыАдреса.Добавить("ПочтовыйАдрес");
	
	// блокирующие проверки
	УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
	
	Для Каждого Запись Из ЭтотОбъект Цикл
		
		РегистрыСведений.РеквизитыЮридическихЛиц.ПроверитьРеквизитыЮрлица(Запись, Отказ);
		
		Если Запись.ОрганизационноПравоваяФорма = Справочники.ОрганизационноПравовыеФормы.ФондНеЯвляющийсяЮрЛицом Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбор ОПФ '" + Запись.ОрганизационноПравоваяФорма + "' в анкетных реквизитах запрещен", Запись.Регистратор,, "Объект.ОрганизационноПравоваяФорма", Отказ);
		КонецЕсли;
		
		// проверяем адреса
		Для Каждого Элемент из РеквизитыАдреса Цикл
			Если ПустаяСтрока(Запись[Элемент]) И НЕ ПустаяСтрока(Запись[Элемент + "ФИАС"]) Тогда 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("'" + Элемент +  "'" + " не заполнен, но реквизит '" + Элемент+ "ФИАС' не пустой", Запись.Регистратор,, "Объект." + Элемент, Отказ);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры
