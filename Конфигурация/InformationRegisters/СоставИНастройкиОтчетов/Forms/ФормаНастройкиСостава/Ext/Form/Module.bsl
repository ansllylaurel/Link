
#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастройкаФормировать = ПланыВидовХарактеристик.НастройкиОтчетов.Формировать;
	
	Режим								= Параметры.Режим;	// Просмотр / Редактирование / Добавление / ОтменаФормирования.
	ТипСубъекта							= Параметры.ТипСубъекта;
	ДатаНастройки						= Параметры.Период;
	Организация							= Параметры.Организация;
	Клиент								= Параметры.Клиент;
	Примечание							= Параметры.Примечание;	
	НоваяЗаписьДляОтменыФормирования 	= Параметры.НоваяЗаписьДляОтменыФормирования;	
	Период								= Параметры.Период;
	
	Если Режим <> "Добавление" Тогда
		
		Отчет			= Параметры.Отчет;
		Периодичность	= Параметры.Периодичность;
		ВидДоговора		= Параметры.ВидДоговора;
		Договор			= Параметры.Договор;
		
		ЗначенияКлючаЗаписи = Новый Структура;
		
		ЗначенияКлючаЗаписи.Вставить("Период",			ДатаНастройки);
		ЗначенияКлючаЗаписи.Вставить("Организация",		Организация);
		ЗначенияКлючаЗаписи.Вставить("Отчет",			Отчет);
		ЗначенияКлючаЗаписи.Вставить("Периодичность",	Периодичность);
		ЗначенияКлючаЗаписи.Вставить("Настройка",		НастройкаФормировать);
		
		Если ТипСубъекта = "Договор" Тогда
			ЗначенияКлючаЗаписи.Вставить("Субъект",		Договор);
		Иначе
			ЗначенияКлючаЗаписи.Вставить("Субъект",		Клиент);
		КонецЕсли;
		
		Если ТипСубъекта = "ВидДоговора" Тогда
			ЗначенияКлючаЗаписи.Вставить("ВидДоговора",	ВидДоговора);
		Иначе
			ЗначенияКлючаЗаписи.Вставить("ВидДоговора",	ПустойВидДоговора);
		КонецЕсли;
		
		КлючЗаписи = РегистрыСведений.СоставИНастройкиОтчетов.СоздатьКлючЗаписи(ЗначенияКлючаЗаписи);
		
		// При редактировании блокируем запись.
		Если Режим = "Редактирование" Или (Режим = "ОтменаФормирования" И Не НоваяЗаписьДляОтменыФормирования) Тогда
			Если НЕ УстановитьБлокировку(Отказ) Тогда
				Возврат;
			ИначеЕсли НЕ РегистрыСведений.СоставИНастройкиОтчетов.ПроверитьНаличиеЗаписей(ЗначенияКлючаЗаписи) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запись не найдена! Возможно запись была изменена или удалена. Обновите данные.",,,,Отказ);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьЗначениеНастройки();
		ЗаполнитьИсториюНаСервере();
		
		Если Режим = "ОтменаФормирования" Тогда
			Формировать = Ложь;
		КонецЕсли;
		
	Иначе
		Формировать	= Истина;
	КонецЕсли;
	
	УстановитьЗаголовокФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьИДоступностьЭлементов();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ТипСубъекта = "Клиент" Тогда
		ПроверяемыеРеквизиты.Добавить("Клиент");
	ИначеЕсли ТипСубъекта = "ВидДоговора" Тогда
		ПроверяемыеРеквизиты.Добавить("Клиент");
		ПроверяемыеРеквизиты.Добавить("ВидДоговора");
	Иначе
		ПроверяемыеРеквизиты.Добавить("Договор");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если Режим = "Редактирование" Тогда
		СнятьБлокировкуЗаписи();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура ИсторияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанныеИстория = Элементы.История.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Режим",			"Просмотр");
	ПараметрыФормы.Вставить("ТипСубъекта",		?(ЗначениеЗаполнено(ТекущиеДанныеИстория.ТипСубъекта), ТекущиеДанныеИстория.ТипСубъекта, ТипСубъекта));
	ПараметрыФормы.Вставить("Период",			ТекущиеДанныеИстория.ДатаНастройки);
	ПараметрыФормы.Вставить("Организация",		Организация);
	ПараметрыФормы.Вставить("Клиент",			Клиент);
	ПараметрыФормы.Вставить("ВидДоговора",		ВидДоговора);
	ПараметрыФормы.Вставить("Договор",			Договор);
	ПараметрыФормы.Вставить("Отчет",			Отчет);
	ПараметрыФормы.Вставить("Периодичность",	Периодичность);
	
	ОткрытьФормуМодально("РегистрСведений.СоставИНастройкиОтчетов.Форма.ФормаНастройкиСостава", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипСубъектаПриИзменении(Элемент)
	
	УстановитьВидимостьИДоступностьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура УнаследованоОтНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуМодально("РегистрСведений.СоставИНастройкиОтчетов.Форма.ФормаНастройкиСостава", ПараметрыФормыНаследуемойНастройки, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНастройкиПриИзменении(Элемент)
		
	Если Режим = "ОтменаФормирования" И Не НоваяЗаписьДляОтменыФормирования Тогда
		НоваяЗаписьДляОтменыФормирования = Период <> ДатаНастройки;
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура Записать(Команда)
	
	Если ПроверитьЗаполнение()
		И (ТипСубъекта = "Договор"
			ИЛИ ИзменениеПодтверждено()) Тогда
			
		ЗафиксироватьЗначенияКлючаЗаписи();
		
		Если Режим = "Редактирование" Тогда
			ДатаДляПроверкиНаличияЗаписи = ДатаНастройки;
		Иначе
			ДатаДляПроверкиНаличияЗаписи = ЗначенияКлючаЗаписи.Период;
		КонецЕсли;
		
		Если ЕстьЗапись(ДатаДляПроверкиНаличияЗаписи) Тогда
			Если Вопрос(СтрШаблон("На %1 уже есть запись. Заменить новой записью?", Формат(ДатаДляПроверкиНаличияЗаписи, "ДФ=dd.MM.yyyy")), РежимДиалогаВопрос.ОКОтмена) = КодВозвратаДиалога.ОК Тогда
				Замещение = Истина;
			Иначе
				Возврат;
			КонецЕсли;
		Иначе
			Замещение = Ложь;
		КонецЕсли;
		
		ЗаписатьЗначение(Замещение);
	КонецЕсли;
	
	ОбновитьФормуПослеЗаписи();
	
	УстановитьВидимостьИДоступностьЭлементов(); // Т.к. режим мог измениться.
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	Если ПроверитьЗаполнение()
		И (ТипСубъекта = "Договор"
			ИЛИ ИзменениеПодтверждено()) Тогда
			
		ЗафиксироватьЗначенияКлючаЗаписи();
		
		Если Режим = "Редактирование" Или Режим = "ОтменаФормирования" Тогда
			ДатаДляПроверкиНаличияЗаписи = ДатаНастройки;
		Иначе
			ДатаДляПроверкиНаличияЗаписи = ЗначенияКлючаЗаписи.Период;
		КонецЕсли;
		
		Если ЕстьЗапись(ДатаДляПроверкиНаличияЗаписи) Тогда
			Если Вопрос(СтрШаблон("На %1 уже есть запись. Заменить новой записью?", Формат(ДатаДляПроверкиНаличияЗаписи, "ДФ=dd.MM.yyyy")), РежимДиалогаВопрос.ОКОтмена) = КодВозвратаДиалога.ОК Тогда
				Замещение = Истина;
			Иначе
				Возврат;
			КонецЕсли;
		Иначе
			Замещение = Ложь;
		КонецЕсли;
		
		Если ЗаписатьЗначение(Замещение) Тогда
			Закрыть(Истина);
		КонецЕсли;
		
	Иначе
		ЗаполнитьИсторию();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИсторию(Команда)
	
	ЗаполнитьИсторию();
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	Заголовок = СтрШаблон("Настройка состава отчетов (%1)", Режим);
	
КонецПроцедуры

&НаКлиенте
Функция ИзменениеПодтверждено()
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("ДатаНастройки",	ДатаНастройки);
	ПараметрыФормы.Вставить("Организация",		Организация);
	ПараметрыФормы.Вставить("Отчет",			Отчет);
	ПараметрыФормы.Вставить("Периодичность",	Периодичность);
	ПараметрыФормы.Вставить("Клиент", 			Клиент);
	ПараметрыФормы.Вставить("ВидДоговора",		?(ТипСубъекта = "Клиент", Неопределено, ВидДоговора));
	
	Если Режим = "Редактирование" Тогда
		ПараметрыФормы.Вставить("Событие",		"Изменение");
		ПараметрыФормы.Вставить("СтарыйПериод",	ЗначенияКлючаЗаписи.Период);
	Иначе
		ПараметрыФормы.Вставить("Событие",		"Добавление");
	КонецЕсли;
	
	РезультатПодтверждения = ОткрытьФормуМодально("РегистрСведений.СоставИНастройкиОтчетов.Форма.ФормаПредупрежденияПриИзмененииСостава", ПараметрыФормы, ЭтаФорма);
	
	Если Режим = "Редактирование"
		И РезультатПодтверждения <> Неопределено Тогда
		ДатаНастройки = РезультатПодтверждения;
	КонецЕсли;
	
	Возврат РезультатПодтверждения <> Неопределено;
	
КонецФункции

&НаСервере
Функция ЗаписатьЗначение(Замещение = Ложь)
	
	Если Режим = "Добавление" Или Режим = "ОтменаФормирования" Или НЕ ЗначениеЗаполнено(УнаследованоОт) Тогда
		ВидЗначения = Перечисления.ВидыЗначенияНастроекОтчетов.Собственное;
	Иначе
		ВидЗначения = Перечисления.ВидыЗначенияНастроекОтчетов.ПоУмолчанию;
	КонецЕсли;
	
	Результат = Истина;
	
	Если Режим = "Добавление" Или Режим = "ОтменаФормирования" Тогда
		Если РегистрыСведений.СоставИНастройкиОтчетов.ДобавитьЗапись(ЗначенияКлючаЗаписи, ВидЗначения, Формировать, Замещение, Примечание) Тогда
			// Если не удалось заблокировать запись - переходим в режим просмотра, если получилось - редактирование.
			Если НЕ УстановитьБлокировку() Тогда
				Режим = "Просмотр";
			Иначе
				Режим = "Редактирование";
			КонецЕсли;
			
			УстановитьЗаголовокФормы();
		Иначе
			Результат = Ложь;
		КонецЕсли;
	// Режим редактирования.
	Иначе
		Если РегистрыСведений.СоставИНастройкиОтчетов.ИзменитьДатуИЗначениеНастройки(ЗначенияКлючаЗаписи, ДатаНастройки, ВидЗначения, Формировать, Замещение, Примечание) Тогда
			// Снимаем блокировку записи со старой датой.
			СнятьБлокировкуЗаписи();
			
			// Меняем период в значениях ключа записи.
			ЗначенияКлючаЗаписи.Вставить("Период", ДатаНастройки);
			
			Если НЕ УстановитьБлокировку() Тогда
				// Если не удалось заблокировать запись - переходим в режим просмотра.
				Режим = "Просмотр";
				УстановитьЗаголовокФормы();
			КонецЕсли;
		Иначе
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбновитьФормуПослеЗаписи()
	
	ЗаполнитьЗначениеНастройки();
	
	ЗаполнитьИсториюНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗафиксироватьЗначенияКлючаЗаписи()
	
	Если Режим = "Добавление" Или НоваяЗаписьДляОтменыФормирования Тогда
		
		ЗначенияКлючаЗаписи = Новый Структура;
		
		ЗначенияКлючаЗаписи.Вставить("Период",			ДатаНастройки);
		ЗначенияКлючаЗаписи.Вставить("Организация",		Организация);
		ЗначенияКлючаЗаписи.Вставить("Отчет",			Отчет);
		ЗначенияКлючаЗаписи.Вставить("Периодичность",	Периодичность);
		ЗначенияКлючаЗаписи.Вставить("Настройка",		НастройкаФормировать);
		
		Если ТипСубъекта = "Договор" Тогда
			ЗначенияКлючаЗаписи.Вставить("Субъект", Договор);
		Иначе
			ЗначенияКлючаЗаписи.Вставить("Субъект", Клиент);
		КонецЕсли;
		
		Если ТипСубъекта = "ВидДоговора" Тогда
			ЗначенияКлючаЗаписи.Вставить("ВидДоговора", ВидДоговора);
		Иначе
			ЗначенияКлючаЗаписи.Вставить("ВидДоговора", ПустойВидДоговора);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕстьЗапись(ДатаДляПроверкиНаличияЗаписи)
	
	НаборЗаписей = РегистрыСведений.СоставИНастройкиОтчетов.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.Период.Установить(ДатаДляПроверкиНаличияЗаписи);
	
	Для Каждого Поле Из ЗначенияКлючаЗаписи Цикл
		Если Поле.Ключ = "Период" Тогда
			Продолжить;
		КонецЕсли;
		
		НаборЗаписей.Отбор[Поле.Ключ].Установить(Поле.Значение);
	КонецЦикла;
	
	НаборЗаписей.Прочитать();
	
	Возврат НаборЗаписей.Количество() > 0;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьИсториюНаСервере()
	
	Если Режим = "Добавление" Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("ТипСубъекта",		ТипСубъекта);
	Запрос.УстановитьПараметр("Клиент",				Клиент);
	Запрос.УстановитьПараметр("Договор",			Договор);
	Запрос.УстановитьПараметр("ВидДоговора",		ВидДоговора);
	Запрос.УстановитьПараметр("Отчет",				Отчет);
	Запрос.УстановитьПараметр("Периодичность",		Периодичность);
	Запрос.УстановитьПараметр("ПустаяДата",			Дата(1, 1, 1));
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоставИНастройкиОтчетов.Период КАК Период,
		|	СоставИНастройкиОтчетов.Приоритет КАК Приоритет,
		|	СоставИНастройкиОтчетов.ВидЗначения КАК ВидЗначения,
		|	СоставИНастройкиОтчетов.Значение КАК Значение,
		|	СоставИНастройкиОтчетов.Примечание КАК Примечание
		|ПОМЕСТИТЬ _ВсеНастройки
		|ИЗ
		|	РегистрСведений.СоставИНастройкиОтчетов КАК СоставИНастройкиОтчетов
		|ГДЕ
		|	СоставИНастройкиОтчетов.Настройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиОтчетов.Формировать)
		|	И СоставИНастройкиОтчетов.Организация = &Организация
		|	И ВЫБОР
		|			КОГДА &ТипСубъекта = ""Клиент""
		|				ТОГДА СоставИНастройкиОтчетов.Субъект = &Клиент
		|						И СоставИНастройкиОтчетов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|			КОГДА &ТипСубъекта = ""ВидДоговора""
		|				ТОГДА СоставИНастройкиОтчетов.Субъект = &Клиент
		|						И (СоставИНастройкиОтчетов.ВидДоговора = &ВидДоговора
		|							ИЛИ СоставИНастройкиОтчетов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка))
		|			КОГДА &ТипСубъекта = ""Договор""
		|				ТОГДА СоставИНастройкиОтчетов.Субъект = &Клиент
		|							И (СоставИНастройкиОтчетов.ВидДоговора = &ВидДоговора
		|								ИЛИ СоставИНастройкиОтчетов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка))
		|						ИЛИ СоставИНастройкиОтчетов.Субъект = &Договор
		|		КОНЕЦ
		|	И СоставИНастройкиОтчетов.Отчет = &Отчет
		|	И СоставИНастройкиОтчетов.Периодичность = &Периодичность
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеНастройки.Приоритет КАК Приоритет,
		|	_ВсеНастройки.Период КАК Период,
		|	_ВсеНастройки.Значение КАК Значение,
		|	_ВсеНастройки.Примечание КАК Примечание
		|ПОМЕСТИТЬ _ДатыИЗначенияНастроек
		|ИЗ
		|	_ВсеНастройки КАК _ВсеНастройки
		|ГДЕ
		|	_ВсеНастройки.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ВидыЗначенияНастроекОтчетов.Собственное)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДатыИЗначенияНастроек.Приоритет КАК Приоритет,
		|	_ДатыИЗначенияНастроек.Значение КАК Значение,
		|	_ДатыИЗначенияНастроек.Период КАК НачалоПериода,
		|	МИНИМУМ(ЕСТЬNULL(_ВсеНастройки.Период, &ПустаяДата)) КАК КонецПериода,
		|	_ДатыИЗначенияНастроек.Примечание КАК Примечание
		|ПОМЕСТИТЬ _ПериодыДействияЗначенийНастроек
		|ИЗ
		|	_ДатыИЗначенияНастроек КАК _ДатыИЗначенияНастроек
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеНастройки КАК _ВсеНастройки
		|		ПО _ДатыИЗначенияНастроек.Приоритет = _ВсеНастройки.Приоритет
		|			И _ДатыИЗначенияНастроек.Период < _ВсеНастройки.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДатыИЗначенияНастроек.Приоритет,
		|	_ДатыИЗначенияНастроек.Период,
		|	_ДатыИЗначенияНастроек.Значение,
		|	_ДатыИЗначенияНастроек.Примечание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПериодыДействияЗначенийНастроек.НачалоПериода КАК Дата
		|ПОМЕСТИТЬ _ДатыИзмененияЗачений
		|ИЗ
		|	_ПериодыДействияЗначенийНастроек КАК _ПериодыДействияЗначенийНастроек
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_ПериодыДействияЗначенийНастроек.КонецПериода
		|ИЗ
		|	_ПериодыДействияЗначенийНастроек КАК _ПериодыДействияЗначенийНастроек
		|ГДЕ
		|	_ПериодыДействияЗначенийНастроек.КонецПериода <> &ПустаяДата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДатыИзмененияЗачений.Дата КАК Дата,
		|	МАКСИМУМ(ЕСТЬNULL(_ПериодыДействияЗначенийНастроек.Приоритет, 0)) КАК Приоритет
		|ПОМЕСТИТЬ _ПриоритетыДействующихНастроекНаДатыИзменений
		|ИЗ
		|	_ДатыИзмененияЗачений КАК _ДатыИзмененияЗачений
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПериодыДействияЗначенийНастроек КАК _ПериодыДействияЗначенийНастроек
		|		ПО _ДатыИзмененияЗачений.Дата >= _ПериодыДействияЗначенийНастроек.НачалоПериода
		|			И (_ПериодыДействияЗначенийНастроек.КонецПериода = &ПустаяДата
		|				ИЛИ _ДатыИзмененияЗачений.Дата < _ПериодыДействияЗначенийНастроек.КонецПериода)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДатыИзмененияЗачений.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ПриоритетыДействующихНастроекНаДатыИзменений.Дата КАК ДатаНастройки,
		|	ЕСТЬNULL(_ПериодыДействияЗначенийНастроек1.Значение, ЛОЖЬ) КАК Формировать,
		|	ВЫБОР
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет = 0
		|			ТОГДА """"
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет = 12
		|			ТОГДА ""Клиент""
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет = 18
		|			ТОГДА ""ВидДоговора""
		|		ИНАЧЕ ""Договор""
		|	КОНЕЦ КАК ТипСубъекта,
		|	_ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет КАК Приоритет,
		|	ЕСТЬNULL(_ПериодыДействияЗначенийНастроек1.Примечание, """") КАК Примечание
		|ИЗ
		|	_ПриоритетыДействующихНастроекНаДатыИзменений КАК _ПриоритетыДействующихНастроекНаДатыИзменений
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПериодыДействияЗначенийНастроек КАК _ПериодыДействияЗначенийНастроек
		|		ПО (_ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет = _ПериодыДействияЗначенийНастроек.Приоритет
		|					И _ПриоритетыДействующихНастроекНаДатыИзменений.Дата = _ПериодыДействияЗначенийНастроек.НачалоПериода
		|				ИЛИ _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет < _ПериодыДействияЗначенийНастроек.Приоритет
		|					И _ПриоритетыДействующихНастроекНаДатыИзменений.Дата = _ПериодыДействияЗначенийНастроек.КонецПериода)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПериодыДействияЗначенийНастроек КАК _ПериодыДействияЗначенийНастроек1
		|		ПО _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет = _ПериодыДействияЗначенийНастроек1.Приоритет
		|			И _ПриоритетыДействующихНастроекНаДатыИзменений.Дата >= _ПериодыДействияЗначенийНастроек1.НачалоПериода
		|			И (_ПериодыДействияЗначенийНастроек1.КонецПериода = &ПустаяДата
		|				ИЛИ _ПриоритетыДействующихНастроекНаДатыИзменений.Дата < _ПериодыДействияЗначенийНастроек1.КонецПериода)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаНастройки";
	#КонецОбласти
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = История.Добавить();
		
		НоваяСтрока.ДатаНастройки			= Выборка.ДатаНастройки;
		НоваяСтрока.Формировать				= Выборка.Формировать;
		НоваяСтрока.ТипСубъекта				= Выборка.ТипСубъекта;
		НоваяСтрока.Примечание 				= Выборка.Примечание;
		
		Если ТипСубъекта <> Выборка.ТипСубъекта Тогда
			НоваяСтрока.СобственноеЗначение = Ложь;
			
			Если ЗначениеЗаполнено(Выборка.ТипСубъекта) Тогда
				Если Выборка.ТипСубъекта = "ВидДоговора" Тогда
					НоваяСтрока.УнаследованоОт	= СтрШаблон("Вид договора '%1' клиента '%2'", ВидДоговора, Клиент);
				Иначе
					НоваяСтрока.УнаследованоОт	= СтрШаблон("Клиент '%1'", Клиент);
				КонецЕсли;
			Иначе
				НоваяСтрока.УнаследованоОт	= СтрШаблон("Нет данных для наследования. Используется значение по умолчанию");
			КонецЕсли;
		Иначе
			НоваяСтрока.СобственноеЗначение = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИсторию()
	
	История.Очистить();
	
	ЗаполнитьИсториюНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьИДоступностьЭлементов()
	
	// Видимость.
	Элементы.ФормаЗаписатьИЗакрыть.Видимость	= Режим <> "Просмотр";
	Элементы.ФормаЗаписать.Видимость			= Режим <> "Просмотр";
	Элементы.Организация.Видимость				= НЕ ЗначениеЗаполнено(Организация);
	Элементы.ВидДоговора.Видимость				= ТипСубъекта = "ВидДоговора";
	Элементы.Договор.Видимость					= ТипСубъекта = "Договор";
	Элементы.Формировать.Видимость				= Режим <> "Добавление";
	Элементы.Примечание.Видимость				= Истина;
	Элементы.УнаследованоОт.Видимость			= Режим <> "Добавление" И ТипСубъекта <> "Клиент" И ЗначениеЗаполнено(УнаследованоОт);
	Элементы.ГруппаИстория.Видимость			= Режим <> "Добавление";
	Элементы.ИсторияУнаследованоОт.Видимость	= ТипСубъекта <> "Клиент";
	
	// Доступность.
	Элементы.ТипСубъекта.ТолькоПросмотр		= Режим <> "Добавление";
	Элементы.Организация.ТолькоПросмотр		= Режим <> "Добавление";
	Элементы.ВидДоговора.ТолькоПросмотр		= Режим <> "Добавление";
	Элементы.Договор.ТолькоПросмотр			= Режим <> "Добавление";
	Элементы.Периодичность.ТолькоПросмотр	= Режим <> "Добавление";
	Элементы.Отчет.ТолькоПросмотр			= Режим <> "Добавление";
	Элементы.ДатаНастройки.ТолькоПросмотр	= Режим = "Просмотр";	
	Элементы.Формировать.ТолькоПросмотр		= Режим <> "Добавление";	
	Элементы.Примечание.ТолькоПросмотр		= Режим = "Просмотр";
	
КонецПроцедуры

&НаСервере
Функция УстановитьБлокировку(Отказ = Ложь)
	
	КлючЗаписи = РегистрыСведений.СоставИНастройкиОтчетов.СоздатьКлючЗаписи(ЗначенияКлючаЗаписи);
	
	Попытка
		ЗаблокироватьДанныеДляРедактирования(КлючЗаписи, , ЭтаФорма.УникальныйИдентификатор);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось заблокировать запись! Данные заблокированы другим сеансом.",,,, Отказ);
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьЗначениеНастройки()
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период",			ЗначенияКлючаЗаписи.Период);
	Запрос.УстановитьПараметр("Организация",	ЗначенияКлючаЗаписи.Организация);
	Запрос.УстановитьПараметр("Отчет",			ЗначенияКлючаЗаписи.Отчет);
	Запрос.УстановитьПараметр("Периодичность",	ЗначенияКлючаЗаписи.Периодичность);
	Запрос.УстановитьПараметр("ТипСубъекта",	ТипСубъекта);
	Запрос.УстановитьПараметр("Клиент",			Клиент);
	Запрос.УстановитьПараметр("ВидДоговора",	ВидДоговора);
	Запрос.УстановитьПараметр("Договор",		Договор);
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(СоставИНастройкиОтчетовСрезПоследних.Субъект) = ТИП(Справочник.СчетаДоверительногоУправления)
		|			ТОГДА ""Договор""
		|		КОГДА СоставИНастройкиОтчетовСрезПоследних.ВидДоговора <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|			ТОГДА ""ВидДоговора""
		|		ИНАЧЕ ""Клиент""
		|	КОНЕЦ КАК ТипСубъекта,
		|	СоставИНастройкиОтчетовСрезПоследних.Значение КАК Формировать,
		|	СоставИНастройкиОтчетовСрезПоследних.Период КАК Период,
		|	СоставИНастройкиОтчетовСрезПоследних.Организация КАК Организация,
		|	СоставИНастройкиОтчетовСрезПоследних.Субъект КАК Клиент,
		|	СоставИНастройкиОтчетовСрезПоследних.ВидДоговора КАК ВидДоговора,
		|	СоставИНастройкиОтчетовСрезПоследних.Отчет КАК Отчет,
		|	СоставИНастройкиОтчетовСрезПоследних.Периодичность КАК Периодичность
		|ИЗ
		|	РегистрСведений.СоставИНастройкиОтчетов.СрезПоследних(
		|			&Период,
		|			Настройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиОтчетов.Формировать)
		|				И Организация = &Организация
		|				И Отчет = &Отчет
		|				И Периодичность = &Периодичность
		|				И ВЫБОР
		|					КОГДА &ТипСубъекта = ""Клиент""
		|						ТОГДА Субъект = &Клиент
		|								И ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|					КОГДА &ТипСубъекта = ""ВидДоговора""
		|						ТОГДА Субъект = &Клиент
		|								И (ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|									ИЛИ ВидДоговора = &ВидДоговора)
		|					ИНАЧЕ Субъект = &Клиент
		|								И (ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|									ИЛИ ВидДоговора = &ВидДоговора)
		|							ИЛИ Субъект = &Договор
		|				КОНЕЦ) КАК СоставИНастройкиОтчетовСрезПоследних
		|ГДЕ
		|	СоставИНастройкиОтчетовСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ВидыЗначенияНастроекОтчетов.Собственное)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СоставИНастройкиОтчетовСрезПоследних.Приоритет УБЫВ";
	#КонецОбласти
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Формировать = Выборка.Формировать;
			
		// Заполняем данные о субъекте наследуемой настройки.
		Если Выборка.ТипСубъекта <> ТипСубъекта Тогда
			Если Выборка.ТипСубъекта = "Клиент" Тогда
				УнаследованоОт = СтрШаблон("Клиент '%1'", Клиент);
			Иначе
				УнаследованоОт = СтрШаблон("Вид договора '%1' клиента '%2'", ВидДоговора, Клиент);
			КонецЕсли;
			
			ПараметрыФормыНаследуемойНастройки = Новый Структура;
			
			ПараметрыФормыНаследуемойНастройки.Вставить("Режим",			"Просмотр");
			ПараметрыФормыНаследуемойНастройки.Вставить("ТипСубъекта",		Выборка.ТипСубъекта);
			ПараметрыФормыНаследуемойНастройки.Вставить("Период",			Выборка.Период);
			ПараметрыФормыНаследуемойНастройки.Вставить("Организация",		Выборка.Организация);
			ПараметрыФормыНаследуемойНастройки.Вставить("Клиент",			Выборка.Клиент);
			ПараметрыФормыНаследуемойНастройки.Вставить("ВидДоговора",		Выборка.ВидДоговора);
			ПараметрыФормыНаследуемойНастройки.Вставить("Договор",			Справочники.СчетаДоверительногоУправления.ПустаяСсылка());
			ПараметрыФормыНаследуемойНастройки.Вставить("Отчет",			Выборка.Отчет);
			ПараметрыФормыНаследуемойНастройки.Вставить("Периодичность",	Выборка.Периодичность);
						
		КонецЕсли;
	Иначе
		Формировать		= Ложь;
		УнаследованоОт	= "Нет данных для наследования. Используется значение по умолчанию";
		Элементы.УнаследованоОт.Гиперссылка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СнятьБлокировкуЗаписи()
	
	КлючЗаписи = РегистрыСведений.СоставИНастройкиОтчетов.СоздатьКлючЗаписи(ЗначенияКлючаЗаписи);
	
	Попытка
		РазблокироватьДанныеДляРедактирования(КлючЗаписи, ЭтаФорма.УникальныйИдентификатор);
	Исключение
		// Смысла что-то сообщать пользователю - нет. Платформа сама через некоторое время снимет блокировку.
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти