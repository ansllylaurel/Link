		|	Договор,
		|	Отчет,
		|	Периодичность";
	
	#КонецОбласти	
	
	ВыборкаКлиенты = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаКлиенты.Следующий() Цикл
		
		НоваяСтрокаКлиент = Дерево.ПолучитьЭлементы().Добавить();
		
		НоваяСтрокаКлиент.Уровень		= 0;
		НоваяСтрокаКлиент.Субъект		= ВыборкаКлиенты.Клиент;
		НоваяСтрокаКлиент.Представление	= ВыборкаКлиенты.Клиент;
		
		ВыборкаВидыДоговоров = ВыборкаКлиенты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаВидыДоговоров.Следующий() Цикл
			
			НоваяСтрокаВидДоговора = НоваяСтрокаКлиент.ПолучитьЭлементы().Добавить();
			
			НоваяСтрокаВидДоговора.Уровень			= 1;
			НоваяСтрокаВидДоговора.Субъект			= ВыборкаВидыДоговоров.ВидДоговора;
			НоваяСтрокаВидДоговора.Представление	= ВыборкаВидыДоговоров.ВидДоговора;
			
			ВыборкаПролонгация = ВыборкаВидыДоговоров.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаПролонгация.Следующий() Цикл
			
				ВыборкаДоговоры = ВыборкаПролонгация.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаДоговоры.Следующий() Цикл
					
					НоваяСтрокаДоговор = НоваяСтрокаВидДоговора.ПолучитьЭлементы().Добавить();
					
					НоваяСтрокаДоговор.Уровень						= 2;
					НоваяСтрокаДоговор.Субъект						= ВыборкаДоговоры.Договор;
					НоваяСтрокаДоговор.Представление				= ВыборкаДоговоры.Договор;
					НоваяСтрокаДоговор.АвтоматическаяПролонгация 	= ВыборкаДоговоры.АвтоматическаяПролонгация;
					
					ВыборкаОтчеты = ВыборкаДоговоры.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
					Пока ВыборкаОтчеты.Следующий() Цикл
						
						НоваяСтрокаОтчет = НоваяСтрокаДоговор.ПолучитьЭлементы().Добавить();
						
						НоваяСтрокаОтчет.Уровень					= 3;
						НоваяСтрокаОтчет.Субъект					= ВыборкаОтчеты.Отчет;
						НоваяСтрокаОтчет.Представление				= ВыборкаОтчеты.Отчет;
						НоваяСтрокаОтчет.АвтоматическаяПролонгация 	= ВыборкаОтчеты.АвтоматическаяПролонгация;
						
						ВыборкаПериодичности = ВыборкаОтчеты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
						
						Пока ВыборкаПериодичности.Следующий() Цикл
							
							НоваяСтрокаПериодичность = НоваяСтрокаОтчет.ПолучитьЭлементы().Добавить();
							
							НоваяСтрокаПериодичность.Уровень					= 4;
							НоваяСтрокаПериодичность.Субъект					= ВыборкаПериодичности.Периодичность;
							НоваяСтрокаПериодичность.Представление				= ВыборкаПериодичности.Периодичность;
							НоваяСтрокаПериодичность.АвтоматическаяПролонгация 	= ВыборкаПериодичности.АвтоматическаяПролонгация;
							
							Выборка = ВыборкаПериодичности.Выбрать();
							
							Пока Выборка.Следующий() Цикл
								НоваяСтрока = НоваяСтрокаПериодичность.ПолучитьЭлементы().Добавить();
								
								НоваяСтрока.Уровень						= 5;
								НоваяСтрока.НачалоПериода				= Выборка.НачалоПериода;
								НоваяСтрока.КонецПериода				= Выборка.КонецПериода;
								НоваяСтрока.Представление				= "С " + Формат(Выборка.НачалоПериода, "ДФ=dd.MM.yyyy") + ?(Выборка.АвтоматическаяПролонгация, " (необходима пролонгация договора)", ?(ЗначениеЗаполнено(Выборка.КонецПериода), " по " + Формат(Выборка.КонецПериода, "ДФ=dd.MM.yyyy"), ""));
								НоваяСтрока.АвтоматическаяПролонгация 	= Выборка.АвтоматическаяПролонгация;
								
							КонецЦикла;
							
						КонецЦикла;
						
					КонецЦикла;
					
				КонецЦикла;
				
			КонецЦикла;	
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

