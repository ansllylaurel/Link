
#Область Команды_формы

&НаКлиенте
Процедура Принять(Команда)
	
	Закрыть(ДатаНастройки);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура СвернутьРазвернутьУровниДерева(Коллекция)
	
	Для Каждого Элемент Из Коллекция Цикл
		
		Если Элемент.Уровень = 4 Тогда
			Элементы.Дерево.Свернуть(Элемент.ПолучитьИдентификатор());
		Иначе
			Элементы.Дерево.Развернуть(Элемент.ПолучитьИдентификатор());
			
			СвернутьРазвернутьУровниДерева(Элемент.ПолучитьЭлементы());
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНастройкиПриИзменении(Элемент)
	
	ЗаполнитьФорму();
	
	СвернутьРазвернутьУровниДерева(Дерево.ПолучитьЭлементы());
	
КонецПроцедуры

#КонецОбласти

#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДатаНастройки		= Параметры.ДатаНастройки;
	Организация			= Параметры.Организация;
	Клиент				= Параметры.Клиент;
	ВидДоговора			= Параметры.ВидДоговора;
	Договор				= Параметры.Договор;
	Отчет				= Параметры.Отчет;
	Периодичность		= Параметры.Периодичность;
	Настройка			= Параметры.Настройка;
	УровеньНастройки	= Параметры.УровеньНастройки;
	Событие				= Параметры.Событие;
	СтарыйПериод		= Параметры.СтарыйПериод;
	
	Элементы.Предупреждение.Заголовок = СтрШаблон(
											"Внимание!
											|Настройка '%1' изменит значение для следующих отчетов договоров:",
											Строка(Настройка));
	
	Элементы.ДатаНастройки.Видимость = Событие <> "Удаление";
	
	ЗаполнитьФорму();
	
КонецПроцедуры

#КонецОбласти

#Область Прочие_процедуры_и_функции

&НаСервере
Процедура ЗаполнитьФорму()
	
	Дерево.ПолучитьЭлементы().Очистить();
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ДатаНастройки",		ДатаНастройки);
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("Клиент",				Клиент);
	Запрос.УстановитьПараметр("ВидДоговора",		ВидДоговора);
	Запрос.УстановитьПараметр("Договор",			Договор);
	Запрос.УстановитьПараметр("Отчет",				Отчет);
	Запрос.УстановитьПараметр("Периодичность",		Периодичность);
	Запрос.УстановитьПараметр("Настройка",			Настройка);
	Запрос.УстановитьПараметр("УровеньНастройки",	УровеньНастройки);
	Запрос.УстановитьПараметр("Событие",			Событие);
	Запрос.УстановитьПараметр("СтарыйПериод",		СтарыйПериод);
	Запрос.УстановитьПараметр("ПустаяДата",			Дата(1, 1, 1));
	Запрос.УстановитьПараметр("ОбщиеНастройки",		РаботаСОтчетами.ПолучитьОбщиеНастройки());
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НастройкиОтчетов.Ссылка КАК Настройка
		|ПОМЕСТИТЬ _ОбщиеНастройки
		|ИЗ
		|	ПланВидовХарактеристик.НастройкиОтчетов КАК НастройкиОтчетов
		|ГДЕ
		|	НастройкиОтчетов.Ссылка В(&ОбщиеНастройки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НазначенияНастроек.Отчет КАК Отчет,
		|	ПериодичностьПредоставленияОтчетности.Ссылка КАК Периодичность,
		|	ПериодДействияИзменяемойНастройки.НачалоПериода КАК НачалоПериода,
		|	ПериодДействияИзменяемойНастройки.КонецПериода КАК КонецПериода
		|ПОМЕСТИТЬ _ПериодДействияНастройки
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ОбщиеНастройки.Настройка КАК Настройка,
		|		Отчеты.Ссылка КАК Отчет
		|	ИЗ
		|		_ОбщиеНастройки КАК _ОбщиеНастройки
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Отчеты КАК Отчеты
		|			ПО (НЕ Отчеты.ПометкаУдаления)
		|				И (НЕ Отчеты.ЭтоГруппа)
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		НазначенияНастроекОтчетов.Настройка,
		|		НазначенияНастроекОтчетов.Отчет
		|	ИЗ
		|		РегистрСведений.НазначенияНастроекОтчетов КАК НазначенияНастроекОтчетов
		|	ГДЕ
		|		НЕ НазначенияНастроекОтчетов.Настройка.ЭтоГруппа) КАК НазначенияНастроек
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Перечисление.ПериодичностьПредоставленияОтчетности КАК ПериодичностьПредоставленияОтчетности
		|		ПО (ВЫБОР
		|				КОГДА &Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.ПустаяСсылка)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ПериодичностьПредоставленияОтчетности.Ссылка = &Периодичность
		|			КОНЕЦ)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			&ДатаНастройки КАК НачалоПериода,
		|			ЕСТЬNULL(МИНИМУМ(СоставИНастройкиОтчетов.Период), &ПустаяДата) КАК КонецПериода
		|		ИЗ
		|			РегистрСведений.СоставИНастройкиОтчетов КАК СоставИНастройкиОтчетов
		|		ГДЕ
		|			СоставИНастройкиОтчетов.Период > &ДатаНастройки
		|			И СоставИНастройкиОтчетов.Организация = &Организация
		|			И СоставИНастройкиОтчетов.Субъект = &Клиент
		|			И СоставИНастройкиОтчетов.ВидДоговора = &ВидДоговора
		|			И СоставИНастройкиОтчетов.Отчет = &Отчет
		|			И СоставИНастройкиОтчетов.Периодичность = &Периодичность
		|			И СоставИНастройкиОтчетов.Настройка = &Настройка
		|			И ВЫБОР
		|					КОГДА &Событие = ""Изменение""
		|						ТОГДА СоставИНастройкиОтчетов.Период <> &СтарыйПериод
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ) КАК ПериодДействияИзменяемойНастройки
		|		ПО (ИСТИНА)
		|ГДЕ
		|	НазначенияНастроек.Настройка = &Настройка
		|	И ВЫБОР
		|			КОГДА &Отчет = ЗНАЧЕНИЕ(Справочник.Отчеты.ПустаяСсылка)
		|				ТОГДА ИСТИНА
		|			КОГДА ВЫРАЗИТЬ(&Отчет КАК Справочник.Отчеты).ЭтоГруппа
		|				ТОГДА НазначенияНастроек.Отчет В ИЕРАРХИИ (&Отчет)
		|			ИНАЧЕ НазначенияНастроек.Отчет = &Отчет
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправления.Клиент КАК Клиент,
		|	КлиентыДоверительногоУправления.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговора,
		|	КлиентыДоверительногоУправления.СчетДоверительногоУправления КАК Договор,
		|	КлиентыДоверительногоУправления.Период КАК Период,
		|	КлиентыДоверительногоУправления.СчетДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
		|	ЕСТЬNULL(УсловияДоговоровДоверительногоУправленияСрезПоследних.АвтоматическаяПролонгация, ЛОЖЬ) КАК АвтоматическаяПролонгация
		|ПОМЕСТИТЬ _КлиентыДУ
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровДоверительногоУправления.СрезПоследних(&ДатаНастройки, Организация = &Организация) КАК УсловияДоговоровДоверительногоУправленияСрезПоследних
		|		ПО КлиентыДоверительногоУправления.Организация = УсловияДоговоровДоверительногоУправленияСрезПоследних.Организация
		|			И КлиентыДоверительногоУправления.СчетДоверительногоУправления = УсловияДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	КлиентыДоверительногоУправления.Организация = &Организация
		|	И (КлиентыДоверительногоУправления.СчетДоверительногоУправления.ДатаРасторжения = &ПустаяДата
		|			ИЛИ КлиентыДоверительногоУправления.СчетДоверительногоУправления.ДатаРасторжения >= &ДатаНастройки
		|			ИЛИ ЕСТЬNULL(УсловияДоговоровДоверительногоУправленияСрезПоследних.АвтоматическаяПролонгация, ЛОЖЬ) = ИСТИНА)
		|	И ВЫБОР
		|			КОГДА &Договор <> ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка)
		|				ТОГДА КлиентыДоверительногоУправления.СчетДоверительногоУправления = &Договор
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &ВидДоговора <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|				ТОГДА КлиентыДоверительногоУправления.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = &ВидДоговора
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлиентыДУ.Клиент КАК Клиент,
		|	_КлиентыДУ.ВидДоговора КАК ВидДоговора,
		|	_КлиентыДУ.Договор КАК Договор,
		|	_КлиентыДУ.Период КАК НачалоПериода,
		|	МИНИМУМ(ЕСТЬNULL(_КлиентыДУ1.Период, &ПустаяДата)) КАК КонецПериода
		|ПОМЕСТИТЬ _ПериодыПринадлежностиКлиентам
		|ИЗ
		|	_КлиентыДУ КАК _КлиентыДУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КлиентыДУ КАК _КлиентыДУ1
		|		ПО _КлиентыДУ.Договор = _КлиентыДУ1.Договор
		|			И _КлиентыДУ.Период < _КлиентыДУ1.Период
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &Клиент = НЕОПРЕДЕЛЕНО
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ _КлиентыДУ.Клиент = &Клиент
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	_КлиентыДУ.Договор,
		|	_КлиентыДУ.ВидДоговора,
		|	_КлиентыДУ.Клиент,
		|	_КлиентыДУ.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоставИНастройкиОтчетов.Субъект КАК Субъект,
		|	СоставИНастройкиОтчетов.ВидДоговора КАК ВидДоговора,
		|	СоставИНастройкиОтчетов.Отчет КАК Отчет,
		|	СоставИНастройкиОтчетов.Периодичность КАК Периодичность,
		|	СоставИНастройкиОтчетов.ВидЗначения КАК ВидЗначения,
		|	СоставИНастройкиОтчетов.Значение КАК Формировать,
		|	СоставИНастройкиОтчетов.Приоритет КАК Приоритет,
		|	СоставИНастройкиОтчетов.Период КАК Период
		|ПОМЕСТИТЬ _НастройкиСостава
		|ИЗ
		|	РегистрСведений.СоставИНастройкиОтчетов КАК СоставИНастройкиОтчетов
		|ГДЕ
		|	СоставИНастройкиОтчетов.Организация = &Организация
		|	И СоставИНастройкиОтчетов.Настройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиОтчетов.Формировать)
		|	И (СоставИНастройкиОтчетов.Субъект В
		|				(ВЫБРАТЬ
		|					_ПериодыПринадлежностиКлиентам.Договор КАК Договор
		|				ИЗ
		|					_ПериодыПринадлежностиКлиентам КАК _ПериодыПринадлежностиКлиентам)
		|			ИЛИ (СоставИНастройкиОтчетов.Субъект, СоставИНастройкиОтчетов.ВидДоговора) В
		|				(ВЫБРАТЬ
		|					_ПериодыПринадлежностиКлиентам.Клиент КАК Клиент,
		|					ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка) КАК ВидДоговора
		|				ИЗ
		|					_ПериодыПринадлежностиКлиентам КАК _ПериодыПринадлежностиКлиентам
		|		
		|				ОБЪЕДИНИТЬ ВСЕ
		|		
		|				ВЫБРАТЬ
		|					_ПериодыПринадлежностиКлиентам.Клиент,
		|					_ПериодыПринадлежностиКлиентам.ВидДоговора
		|				ИЗ
		|					_ПериодыПринадлежностиКлиентам КАК _ПериодыПринадлежностиКлиентам))
		|	И (СоставИНастройкиОтчетов.Отчет, СоставИНастройкиОтчетов.Периодичность) В
		|			(ВЫБРАТЬ
		|				_ПериодДействияНастройки.Отчет КАК Отчет,
		|				_ПериодДействияНастройки.Периодичность КАК Периодичность
		|			ИЗ
		|				_ПериодДействияНастройки КАК _ПериодДействияНастройки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_НастройкиСостава.Субъект) = ТИП(Справочник.СчетаДоверительногоУправления)
		|			ТОГДА ""Договор""
		|		КОГДА _НастройкиСостава.ВидДоговора <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|			ТОГДА ""ВидДоговора""
		|		ИНАЧЕ ""Клиент""
		|	КОНЕЦ КАК ТипСубъекта,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_НастройкиСостава.Субъект) = ТИП(Справочник.СчетаДоверительногоУправления)
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ _НастройкиСостава.Субъект
		|	КОНЕЦ КАК Клиент,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_НастройкиСостава.Субъект) = ТИП(Справочник.СчетаДоверительногоУправления)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|		ИНАЧЕ _НастройкиСостава.ВидДоговора
		|	КОНЕЦ КАК ВидДоговора,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_НастройкиСостава.Субъект) = ТИП(Справочник.СчетаДоверительногоУправления)
		|			ТОГДА ВЫРАЗИТЬ(_НастройкиСостава.Субъект КАК Справочник.СчетаДоверительногоУправления)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка)
		|	КОНЕЦ КАК Договор,
		|	_НастройкиСостава.Отчет КАК Отчет,
		|	_НастройкиСостава.Периодичность КАК Периодичность,
		|	_НастройкиСостава.ВидЗначения КАК ВидЗначения,
		|	_НастройкиСостава.Формировать КАК Формировать,
		|	_НастройкиСостава.Приоритет КАК Приоритет,
		|	_НастройкиСостава.Период КАК НачалоПериода,
		|	МИНИМУМ(ЕСТЬNULL(_НастройкиСостава1.Период, &ПустаяДата)) КАК КонецПериода
		|ПОМЕСТИТЬ _ПериодыДействияНастроекСостава
		|ИЗ
		|	_НастройкиСостава КАК _НастройкиСостава
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НастройкиСостава КАК _НастройкиСостава1
		|		ПО _НастройкиСостава.Субъект = _НастройкиСостава1.Субъект
		|			И _НастройкиСостава.ВидДоговора = _НастройкиСостава1.ВидДоговора
		|			И _НастройкиСостава.Отчет = _НастройкиСостава1.Отчет
		|			И _НастройкиСостава.Периодичность = _НастройкиСостава1.Периодичность
		|			И _НастройкиСостава.Период < _НастройкиСостава1.Период
		|ГДЕ
		|	_НастройкиСостава.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ВидыЗначенияНастроекОтчетов.Собственное)
