		ОбновитьПакеты();
	Иначе
		ОчиститьПакеты();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПакетыПриАктивизацииСтроки(Элемент)
	
	ОбновитьСостав();
	
	ТекущиеДанные = Элементы.Пакеты.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		Если НЕ ТекущиеДанные.ВыводитьФормирование Тогда
			Элементы.ВидСостава.Доступность = Ложь;
		Иначе
			Элементы.ВидСостава.Доступность = Истина;
		КонецЕсли;
	Иначе
		Элементы.ВидСостава.Доступность = Ложь;
		УстановитьТекущуюСтрокуСостава();
	КонецЕсли;
	
КонецПроцедуры

