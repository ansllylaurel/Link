	ПараметрыФормы = ПолучитьПараметрыФормыНастройкиСостава("Просмотр");
	
	Если ПараметрыФормы <> Неопределено Тогда
		ОткрытьФормуСостава(ПараметрыФормы);
		ОбновитьПакеты();
	КонецЕсли;
	
КонецПроцедуры

