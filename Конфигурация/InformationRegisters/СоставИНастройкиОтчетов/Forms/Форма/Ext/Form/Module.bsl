#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПолноправныйПользователь = РаботаСПользователями.ЭтоПолноправныйПользователь();
	
	Клиент = Параметры.Клиент;
	
	ПоСостояниюНа = ТекущаяДата();
	
	Если ПолноправныйПользователь Тогда
		НовыйЭлемент = Элементы.Добавить("Организация", Тип("ПолеФормы"), Элементы.ВерхЛево);
		НовыйЭлемент.Вид					= ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.КнопкаОчистки			= Истина;
		НовыйЭлемент.КнопкаОткрытия			= Ложь;
		НовыйЭлемент.КнопкаСоздания			= Ложь;
		НовыйЭлемент.ПоложениеЗаголовка		= ПоложениеЗаголовкаЭлементаФормы.Верх;
	Иначе
		НовыйЭлемент = Элементы.Добавить("Организация", Тип("ПолеФормы"), Элементы.ВерхЛево);
		НовыйЭлемент.Вид				= ВидПоляФормы.ПолеНадписи;
		НовыйЭлемент.Гиперссылка		= Истина;
		НовыйЭлемент.ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Нет;
	КонецЕсли;
	
	НовыйЭлемент.ПутьКДанным = "Организация";
	
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "ОрганизацияПриИзменении");
	
	Если Параметры.Отбор <> Неопределено
		И Параметры.Отбор.Свойство("Договор")
		И ЗначениеЗаполнено(Параметры.Отбор.Договор) Тогда
		
		ВидДоговораДоговор	= Параметры.Отбор.Договор;
		Организация			= ВидДоговораДоговор.Организация;
		
		Элементы.Организация.ТолькоПросмотр			= Истина;
		Элементы.ВидДоговораДоговор.ТолькоПросмотр	= Истина;
		
	Иначе
		Организация = ПараметрыСеанса.ТекущаяОрганизация;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ГруппировкаПакетов = "" Тогда
		ГруппировкаПакетов = "ПоПериодичности";
	КонецЕсли;
	
	ОбновитьПакеты();
	
КонецПроцедуры

#КонецОбласти

