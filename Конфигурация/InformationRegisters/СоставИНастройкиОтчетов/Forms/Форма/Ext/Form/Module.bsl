&НаКлиенте
Процедура ПакетыОтключитьФормирование(Команда)
	
	Если Не ЗначениеЗаполнено(ВидДоговораДоговор) Тогда
		Если Вопрос("Поле 'Вид договора / договор' не заполнено, поэтому отчеты будут отключены у всех договоров клиента! Продолжить?'", РежимДиалогаВопрос.ДаНет,,, "Внимание!!!") = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;		
	
	ДатаОтключения = ПоСостояниюНа;
	Если Не ВвестиЗначение(ДатаОтключения, "Укажите дату отключения формирования отчетов", Новый ОписаниеТипов("Дата",,,,, Новый КвалификаторыДаты(ЧастиДаты.Дата))) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрокаПакеты = Элементы.Пакеты.ТекущиеДанные;
	СтруктураОтбора = ПолучитьСтруктуруОтбораОтчетов(ТекущаяСтрокаПакеты);
			
	ОтключитьФормирование(СтруктураОтбора, Клиент, ВидДоговораДоговор, ПоСостояниюНа, ДатаОтключения);
		
	ОбновитьПакеты();

КонецПроцедуры

