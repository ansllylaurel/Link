КонецПроцедуры

&НаСервере
Функция ЕстьЗапись(КлючЗаписи)
	
	НаборЗаписей = РегистрыСведений.СоставИНастройкиОтчетов.СоздатьНаборЗаписей();
	
	Для Каждого Поле Из КлючЗаписи Цикл
		НаборЗаписей.Отбор[Поле.Ключ].Установить(Поле.Значение);
	КонецЦикла;
	
	НаборЗаписей.Прочитать();
	
	Возврат НаборЗаписей.Количество() > 0;
	
КонецФункции

&НаКлиенте
Процедура ИзменитьНастройку(Событие)
	
	ТекущиеДанныеПакетов	= Элементы.Пакеты.ТекущиеДанные;
	ТекущиеДанныеСостав		= Элементы.Состав.ТекущиеДанные;
	ТекущиеДанныеНастройки	= Элементы.Настройки.ТекущиеДанные;
	
	ДатаНастройки			= ?(Событие = "Удаление", ТекущиеДанныеНастройки.ДатаНастройки, ПоСостояниюНа);
	
	Если УровеньНастройки <> 24 Тогда
		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("Настройка",		ТекущиеДанныеНастройки.Настройка);
		ПараметрыФормы.Вставить("ДатаНастройки",	ДатаНастройки);
		ПараметрыФормы.Вставить("Организация",		ТекущиеДанныеПакетов.Организация);
		ПараметрыФормы.Вставить("Событие",			Событие);
		ПараметрыФормы.Вставить("УровеньНастройки",	УровеньНастройки);
		ПараметрыФормы.Вставить("Клиент", 			ТекущиеДанныеСостав.Клиент);
		ПараметрыФормы.Вставить("ВидДоговора",		ТекущиеДанныеСостав.ВидДоговора);
		ПараметрыФормы.Вставить("Договор",			ТекущиеДанныеСостав.Договор);
		ПараметрыФормы.Вставить("Отчет",			?(ЗначениеЗаполнено(ТекущиеДанныеПакетов.Отчет), ТекущиеДанныеПакетов.Отчет, ТекущиеДанныеПакетов.ГруппаОтчетов));
		ПараметрыФормы.Вставить("Периодичность",	ТекущиеДанныеПакетов.Периодичность);
		
		РезультатПодтверждения = ОткрытьФормуМодально("РегистрСведений.СоставИНастройкиОтчетов.Форма.ФормаПредупрежденияПриИзмененииНастройки", ПараметрыФормы, ЭтаФорма);
		
		Если РезультатПодтверждения = Неопределено Тогда
			Возврат;
		Иначе
			ДатаНастройки = РезультатПодтверждения;
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияКлючаЗаписи = Новый Структура;
	
	ЗначенияКлючаЗаписи.Вставить("Организация",		ТекущиеДанныеПакетов.Организация);
	ЗначенияКлючаЗаписи.Вставить("Периодичность",	ТекущиеДанныеПакетов.Периодичность);
	ЗначенияКлючаЗаписи.Вставить("Настройка",		ТекущиеДанныеНастройки.Настройка);
	ЗначенияКлючаЗаписи.Вставить("Отчет",			?(ЗначениеЗаполнено(ТекущиеДанныеПакетов.Отчет), ТекущиеДанныеПакетов.Отчет, ТекущиеДанныеПакетов.ГруппаОтчетов));
	
	Если УровеньНастройки < 7 Тогда
		ЗначенияКлючаЗаписи.Вставить("Субъект",		Неопределено);
		ЗначенияКлючаЗаписи.Вставить("ВидДоговора",	ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка"));
	ИначеЕсли УровеньНастройки < 13 Тогда
		ЗначенияКлючаЗаписи.Вставить("Субъект",		ТекущиеДанныеСостав.Клиент);
		ЗначенияКлючаЗаписи.Вставить("ВидДоговора",	ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка"));
	ИначеЕсли УровеньНастройки < 19 Тогда
		ЗначенияКлючаЗаписи.Вставить("Субъект",		ТекущиеДанныеСостав.Клиент);
		ЗначенияКлючаЗаписи.Вставить("ВидДоговора",	ТекущиеДанныеНастройки.ВидДоговора);
	Иначе
		ЗначенияКлючаЗаписи.Вставить("Субъект",		ТекущиеДанныеСостав.Договор);
		ЗначенияКлючаЗаписи.Вставить("ВидДоговора",	ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка"));
	КонецЕсли;
	
	ЗначенияКлючаЗаписи.Вставить("Период", ДатаНастройки);
	
	Если Событие = "Наследование" Тогда
		
		Если ЕстьЗапись(ЗначенияКлючаЗаписи) Тогда
			Если Вопрос(СтрШаблон("На %1 уже есть запись. Заменить новой записью?", Формат(ЗначенияКлючаЗаписи.Период, "ДФ=dd.MM.yyyy")), РежимДиалогаВопрос.ОКОтмена) = КодВозвратаДиалога.ОК Тогда
				Замещение = Истина;
			Иначе
				Возврат;
			КонецЕсли;
		Иначе
			Замещение = Ложь;
		КонецЕсли;
		
		ДобавитьЗаписьНастройкиНаСервере(ЗначенияКлючаЗаписи, "ПоУмолчанию", Замещение);
		
	Иначе
		УдалитьЗаписьНастройки(ЗначенияКлючаЗаписи);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНастройки()
	
	ТекущиеДанныеНастройки = Элементы.Настройки.ТекущиеДанные;
	
	Если ТекущиеДанныеНастройки = Неопределено Тогда
		ТекущаяНастройка = Неопределено;
	Иначе
		ТекущаяНастройка = ТекущиеДанныеНастройки.Настройка;
	КонецЕсли;
	
	Настройки.Очистить();
	
	ТекущиеДанныеПакеты	= Элементы.Пакеты.ТекущиеДанные;
	ТекущиеДанныеСостав	= Элементы.Состав.ТекущиеДанные;
	
	Если ТекущиеДанныеПакеты <> Неопределено
		И ТекущиеДанныеСостав <> Неопределено Тогда
		ЗаполнитьНастройки(ТекущиеДанныеПакеты.ПолучитьИдентификатор(), ТекущиеДанныеСостав.ПолучитьИдентификатор());
	КонецЕсли;
	
	Если Настройки.Количество() > 0
		И ТекущаяНастройка <> Неопределено Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("Настройка", ТекущаяНастройка);
		
		НайденныеСтроки = Настройки.НайтиСтроки(Отбор);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			Элементы.Настройки.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ОткрытьФормуНастройки(ПараметрыФормы)
	
	Возврат ОткрытьФормуМодально("РегистрСведений.СоставИНастройкиОтчетов.Форма.ФормаРедактированияНастройки", ПараметрыФормы, ЭтаФорма);	
	
КонецФункции

&НаКлиенте
Функция ПолучитьПараметрыФормыЗначенияНастройки(Режим)
	
	ТекущиеДанныеПакеты		= Элементы.Пакеты.ТекущиеДанные;
	ТекущиеДанныеСостав		= Элементы.Состав.ТекущиеДанные;
	ТекущиеДанныеНастройки	= Элементы.Настройки.ТекущиеДанные;
		
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Режим", Режим);
	
	Если Режим <> "Добавление" Тогда
		
		Если Режим = "Редактирование" И НЕ ЗначениеЗаполнено(ТекущиеДанныеНастройки.ДатаНастройки) Тогда
		    ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для выбранного уровня настройки отсутствует запись регистра!");
			Возврат Неопределено;
		КонецЕсли;
		
		ПараметрыФормы.Вставить("Период", ?(ЗначениеЗаполнено(ТекущиеДанныеНастройки.ДатаНастройки), ТекущиеДанныеНастройки.ДатаНастройки, ТекущиеДанныеНастройки.ДатаНаследуемойНастройки));
		
	Иначе
		ПараметрыФормы.Вставить("Период", ПоСостояниюНа);
	КонецЕсли;
	
	ПараметрыФормы.Вставить("Настройка",		ТекущиеДанныеНастройки.Настройка);
	ПараметрыФормы.Вставить("Организация",		ТекущиеДанныеПакеты.Организация);
	ПараметрыФормы.Вставить("Клиент",			Клиент);
	ПараметрыФормы.Вставить("ГруппаОтчетов",	ТекущиеДанныеПакеты.ГруппаОтчетов);
	ПараметрыФормы.Вставить("Отчет",			ТекущиеДанныеПакеты.Отчет);
	ПараметрыФормы.Вставить("ТипСубъекта",		ТекущиеДанныеСостав.Уровень);
	ПараметрыФормы.Вставить("ВидДоговора",		ТекущиеДанныеСостав.ВидДоговора);
	ПараметрыФормы.Вставить("Договор",			ТекущиеДанныеСостав.Договор);
	// Периодичность передаем только когда открывается настройка с указанием периодичности (четные приоритеты).
	ПараметрыФормы.Вставить("Периодичность",	?(Цел(УровеньНастройки/2) = УровеньНастройки/2, ТекущиеДанныеПакеты.Периодичность, Неопределено));
	ПараметрыФормы.Вставить("УровеньНастройки",	УровеньНастройки);
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаКлиенте
Процедура СвернутьВетку(Ветка)
	
	Для Каждого ДочерняяВетка Из Ветка.ПолучитьЭлементы() Цикл
		СвернутьВетку(ДочерняяВетка);
	КонецЦикла;
	
	Элементы.Пакеты.Свернуть(Ветка.ПолучитьИдентификатор());
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПоместитьДействующиеДоговорыКлиентаВЗапрос(Запрос, ОтборПоОрганизацииТолькоПриЗаполненномПараметре = Ложь)
	
	Если Запрос.МенеджерВременныхТаблиц = Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли;
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Организация КАК Организация,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговора,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК Договор
		|ПОМЕСТИТЬ _ДействующиеДоговорыКлиента
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&Период,
		|			Организация В (&Организация)
		|				И ВЫБОР
		|					КОГДА &Договор <> НЕОПРЕДЕЛЕНО
		|						ТОГДА СчетДоверительногоУправления = &Договор
		|					КОГДА &ВидДоговора <> НЕОПРЕДЕЛЕНО
		|						ТОГДА СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = &ВидДоговора
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровДоверительногоУправления.СрезПоследних(
		|				&Период,
		|				Организация В (&Организация)
		|					И ВЫБОР
		|						КОГДА &Договор <> НЕОПРЕДЕЛЕНО
		|							ТОГДА СчетДоверительногоУправления = &Договор
		|						КОГДА &ВидДоговора <> НЕОПРЕДЕЛЕНО
		|							ТОГДА СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = &ВидДоговора
		|						ИНАЧЕ ИСТИНА
		|					КОНЕЦ) КАК УсловияДоговоровДоверительногоУправленияСрезПоследних
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = УсловияДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент = &Клиент
		|	И КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаЗаключения <= &Период
		|	И (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения = &ПустаяДата
		|			ИЛИ КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения >= &Период
		|			ИЛИ УсловияДоговоровДоверительногоУправленияСрезПоследних.АвтоматическаяПролонгация)";
	
	Если ОтборПоОрганизацииТолькоПриЗаполненномПараметре И Не ЗначениеЗаполнено(Запрос.Параметры.Организация) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Организация В (&Организация)", "ИСТИНА");
	КонецЕсли;
	
	Запрос.Выполнить();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтключитьФормирование(СтруктураОтбора, Клиент, ВидДоговораДоговор, ПоСостояниюНа, ДатаОтключения)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период",			ПоСостояниюНа);
	Запрос.УстановитьПараметр("Организация",	СтруктураОтбора.Организация);
	Запрос.УстановитьПараметр("Клиент",			Клиент);
	Запрос.УстановитьПараметр("Периодичность",	СтруктураОтбора.Периодичность);
	Запрос.УстановитьПараметр("Отчет",			СтруктураОтбора.Отчет);
	Запрос.УстановитьПараметр("ПустаяДата",		Дата(1, 1, 1));
	Запрос.УстановитьПараметр("ДатаОтключения", ДатаОтключения);
	
	Договор		= Неопределено;
	ВидДоговора	= Неопределено;
	
	Если ЗначениеЗаполнено(ВидДоговораДоговор) Тогда
		Если ТипЗнч(ВидДоговораДоговор) = Тип("ПеречислениеСсылка.ВидыДоговоровДоверительногоУправления") Тогда
			ВидДоговора	= ВидДоговораДоговор;
		Иначе
			Договор		= ВидДоговораДоговор;
			ВидДоговора	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидДоговораДоговор, "ВидДоговораДоверительногоУправления");
		КонецЕсли;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Договор",		Договор);
	Запрос.УстановитьПараметр("ВидДоговора",	ВидДоговора);
	
	ПоместитьДействующиеДоговорыКлиентаВЗапрос(Запрос);
	
	#Область Текст_запроса
	
	Запрос.Текст =	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА &Договор <> НЕОПРЕДЕЛЕНО
		|			ТОГДА &Договор
		|		ИНАЧЕ СоставИНастройкиОтчетовСрезПоследних.Субъект
		|	КОНЕЦ КАК Субъект,
		|	ВЫБОР
		|		КОГДА &Договор <> НЕОПРЕДЕЛЕНО
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		КОГДА &ВидДоговора <> НЕОПРЕДЕЛЕНО
		|			ТОГДА &ВидДоговора
		|		ИНАЧЕ СоставИНастройкиОтчетовСрезПоследних.ВидДоговора
		|	КОНЕЦ КАК ВидДоговора,
		|	&ДатаОтключения КАК Период,
		|	СоставИНастройкиОтчетовСрезПоследних.Организация КАК Организация,
		|	СоставИНастройкиОтчетовСрезПоследних.Отчет КАК Отчет,
		|	СоставИНастройкиОтчетовСрезПоследних.Периодичность КАК Периодичность,
		|	СоставИНастройкиОтчетовСрезПоследних.Приоритет КАК Приоритет,
		|	СоставИНастройкиОтчетовСрезПоследних.Настройка КАК Настройка
		|ИЗ
		|	РегистрСведений.СоставИНастройкиОтчетов.СрезПоследних(
		|			&Период,
		|			Настройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиОтчетов.Формировать)
		|				И Организация В (&Организация)
		|				И Отчет В (&Отчет)
		|				И Периодичность В (&Периодичность)
		|				И ВЫБОР
		|					КОГДА &Договор <> НЕОПРЕДЕЛЕНО
		|						ТОГДА ТИПЗНАЧЕНИЯ(Субъект) <> ТИП(Справочник.СчетаДоверительногоУправления)
		|									И Субъект = &Клиент
		|									И (ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|										ИЛИ ВидДоговора = &ВидДоговора)
		|								ИЛИ ТИПЗНАЧЕНИЯ(Субъект) = ТИП(Справочник.СчетаДоверительногоУправления)
		|									И Субъект = &Договор
		|					КОГДА &ВидДоговора <> НЕОПРЕДЕЛЕНО
		|						ТОГДА ТИПЗНАЧЕНИЯ(Субъект) <> ТИП(Справочник.СчетаДоверительногоУправления)
		|									И Субъект = &Клиент
		|									И (ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|										ИЛИ ВидДоговора = &ВидДоговора)
		|								ИЛИ ТИПЗНАЧЕНИЯ(Субъект) = ТИП(Справочник.СчетаДоверительногоУправления)
		|									И ВЫРАЗИТЬ(Субъект КАК Справочник.СчетаДоверительногоУправления).ВидДоговораДоверительногоУправления = &ВидДоговора
		|					ИНАЧЕ Субъект = &Клиент
		|							ИЛИ Субъект В
		|								(ВЫБРАТЬ
		|									_ДействующиеДоговорыКлиента.Договор
		|								ИЗ
		|									_ДействующиеДоговорыКлиента)
		|				КОНЕЦ) КАК СоставИНастройкиОтчетовСрезПоследних
		|ГДЕ
		|	СоставИНастройкиОтчетовСрезПоследних.Значение = ИСТИНА";

	#КонецОбласти
	 
	Выборка = Запрос.Выполнить().Выбрать();
	 
	Пока Выборка.Следующий() Цикл
		РегистрыСведений.СоставИНастройкиОтчетов.ДобавитьЗапись(Выборка, Перечисления.ВидыЗначенияНастроекОтчетов.Собственное, Ложь, Ложь);
	КонецЦикла;
	 
КонецФункции

&НаКлиенте
Функция ПолучитьСтруктуруОтбораОтчетов(ДанныеФормыДерево)
	
	МассивОрганизаций 	= Новый Массив;	
	МассивПериодичности = Новый Массив;
	МассивОтчетов		= Новый Массив;
	
	МассивОрганизаций.Добавить(ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация"));
	
	СтруктураРезультата = Новый Структура("Организация, Периодичность, Отчет", МассивОрганизаций, МассивПериодичности, МассивОтчетов);	
	
	ЗаполнитьМассивыОтбораОтчетов(ДанныеФормыДерево, СтруктураРезультата);
	
	Возврат СтруктураРезультата;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьМассивыОтбораОтчетов(ДанныеФормыДерево, СтруктураРезультата)
	
	Если ЗначениеЗаполнено(ДанныеФормыДерево.Организация) Тогда
		РаботаСКоллекциями.ДополнитьМассив(СтруктураРезультата.Организация, ДанныеФормыДерево.Организация, Истина);
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ДанныеФормыДерево.Периодичность) Тогда
		РаботаСКоллекциями.ДополнитьМассив(СтруктураРезультата.Периодичность, ДанныеФормыДерево.Периодичность, Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеФормыДерево.Отчет) Тогда
		РаботаСКоллекциями.ДополнитьМассив(СтруктураРезультата.Отчет, ДанныеФормыДерево.Отчет, Истина);
	КонецЕсли;

	Для Каждого СтрокаДерева Из ДанныеФормыДерево.ПолучитьЭлементы() Цикл
		ЗаполнитьМассивыОтбораОтчетов(СтрокаДерева, СтруктураРезультата)	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти