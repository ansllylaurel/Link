#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Режим				= Параметры.Режим;
	Настройка			= Параметры.Настройка;
	Организация			= Параметры.Организация;
	ТипСубъекта			= Параметры.ТипСубъекта;
	Клиент				= Параметры.Клиент;
	ДатаНастройки		= Параметры.Период;
	ВидДоговора			= Параметры.ВидДоговора;
	Договор				= Параметры.Договор;
	ГруппаОтчетов		= Параметры.ГруппаОтчетов;
	Отчет				= Параметры.Отчет;
	Периодичность		= Параметры.Периодичность;
	УровеньНастройки	= Параметры.УровеньНастройки;
	
	Элементы.КомментарийКЗначениюНастройки.Видимость	= Настройка.Код = "МаксимальныйРазмерФайлаДляВыгрузкиВЭДО" ИЛИ Настройка.Код = "МаксимальныйСуммарныйРазмерфайловПисьма";
	Элементы.Значение.КнопкаРегулирования				= (Настройка.Код = "МаксимальныйРазмерФайлаДляВыгрузкиВЭДО" ИЛИ Настройка.Код = "МаксимальныйСуммарныйРазмерфайловПисьма") И Режим <> "Просмотр";
	
	Если УровеньНастройки < 3
		ИЛИ УровеньНастройки >= 7 И УровеньНастройки < 9 
		ИЛИ УровеньНастройки >= 13 И УровеньНастройки < 15 
		ИЛИ УровеньНастройки >= 19 И УровеньНастройки < 21 Тогда
		ТипОтчета = "ВсеОтчеты";
	ИначеЕсли УровеньНастройки >= 3 И УровеньНастройки < 5 
		ИЛИ УровеньНастройки >= 9 И УровеньНастройки < 11 
		ИЛИ УровеньНастройки >= 15 И УровеньНастройки < 17
		ИЛИ УровеньНастройки >= 21 И УровеньНастройки < 23 Тогда
		ТипОтчета = "ГруппаОтчетов";
	Иначе
		ТипОтчета = "Отчет";
	КонецЕсли;
	
	Если Режим <> "Добавление" Тогда
		
		ЗначенияКлючаЗаписи = Новый Структура;
		
		ЗначенияКлючаЗаписи.Вставить("Период",			ДатаНастройки);
		ЗначенияКлючаЗаписи.Вставить("Организация",		Организация);
		ЗначенияКлючаЗаписи.Вставить("Периодичность",	Периодичность);
		ЗначенияКлючаЗаписи.Вставить("Настройка",		Настройка);
		
		Если ТипСубъекта = "Организация" Тогда
			ЗначенияКлючаЗаписи.Вставить("Субъект", Неопределено);
		ИначеЕсли ТипСубъекта = "Договор" Тогда
			ЗначенияКлючаЗаписи.Вставить("Субъект", Договор);
		Иначе
			ЗначенияКлючаЗаписи.Вставить("Субъект", Клиент);
		КонецЕсли;
		
		Если ТипСубъекта = "ВидДоговора" Тогда
			ЗначенияКлючаЗаписи.Вставить("ВидДоговора",	ВидДоговора);
		Иначе
			ЗначенияКлючаЗаписи.Вставить("ВидДоговора",	Перечисления.ВидыДоговоровДоверительногоУправления.ПустаяСсылка());
		КонецЕсли;
		
		ЗначенияКлючаЗаписи.Вставить("Отчет", ?(ЗначениеЗаполнено(Отчет), Отчет, ГруппаОтчетов));
		
		КлючЗаписи = РегистрыСведений.СоставИНастройкиОтчетов.СоздатьКлючЗаписи(ЗначенияКлючаЗаписи);
		
		// При редактировании блокируем запись.
		Если Режим = "Редактирование" Тогда
			Если НЕ УстановитьБлокировку(Отказ) Тогда
				Возврат;
			ИначеЕсли НЕ РегистрыСведений.СоставИНастройкиОтчетов.ПроверитьНаличиеЗаписей(ЗначенияКлючаЗаписи) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запись не найдена! Возможно запись была изменена или удалена. Обновите данные.",,,,Отказ);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьЗначениеНастройки();
		ЗаполнитьИсториюНаСервере();
		
	Иначе
		Значение = Настройка.ТипЗначения.ПривестиЗначение();
	КонецЕсли;
	
	УстановитьЗаголовокФормы();
	
	Если Настройка.Код = "ПутьКФайлу"
		ИЛИ Настройка.Код = "КаталогОтправленныхОтчетов"
		ИЛИ Настройка.Код = "КаталогФайловДляОтправкиПоЭДО"
		ИЛИ Настройка.Код = "КаталогФайловСОшибкойОтправкиПоЭДО"
		ИЛИ Настройка.Код = "ИмяФайла"
		ИЛИ Настройка.Код = "ТемаПисьма" Тогда
		
		Элементы.Значение.МногострочныйРежим									= Истина;
		Элементы.Значение.ПоложениеЗаголовка									= ПоложениеЗаголовкаЭлементаФормы.Лево;
		Элементы.Значение.ОтображениеПодсказки									= ОтображениеПодсказки.Кнопка;
		Элементы.Значение.Подсказка												= "Описание шаблонов можно посмотреть во встроенной справке (F1)";
		Элементы.ЗначениеКонтекстноеМенюКонструкторФорматнойСтроки.Видимость	= Режим <> "Просмотр";
		
	КонецЕсли;
	
	Если Настройка.Код = "МаксимальныйРазмерФайлаДляВыгрузкиВЭДО" ИЛИ Настройка.Код = "МаксимальныйСуммарныйРазмерфайловПисьма" Тогда
		
		ЗначениеВКБ	= 0;
		ЗначениеВМБ	= 0;
		
		Если ЗначениеЗаполнено(Значение) Тогда
			ЗначениеВКБ	= Значение/1024;
			ЗначениеВМБ	= Значение/1048576;
		КонецЕсли;
		
		Элементы.КомментарийКЗначениюНастройки.Заголовок = СтрШаблон("%1 (КБ) / %2 (МБ)", Формат(ЗначениеВКБ, "ЧДЦ=2; ЧН=0; ЧГ=0"), Формат(ЗначениеВМБ, "ЧДЦ=2; ЧН=0; ЧГ=0"));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
	УстановитьВидимостьИДоступностьЭлементов();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// Если тип не содержит число, добавляем значение в проверяемые реквизиты
	Если НЕ Настройка.ТипЗначения.СодержитТип(Тип("Число"))
		И НЕ Настройка.ТипЗначения.СодержитТип(Тип("Дата")) Тогда
		ПроверяемыеРеквизиты.Добавить("Значение");
	КонецЕсли;
	
	ПроверяемыеРеквизиты.Добавить("ДатаНастройки");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если Режим = "Редактирование" Тогда
		СнятьБлокировкуЗаписи();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура ТипСубъектаПриИзменении(Элемент)
	
	УстановитьВидимостьИДоступностьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипОтчетаПриИзменении(Элемент)
	
	УстановитьВидимостьИДоступностьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанныеИстория = Элементы.История.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Режим",			"Просмотр");
	ПараметрыФормы.Вставить("Настройка",		Настройка);
	ПараметрыФормы.Вставить("Организация",		Организация);
	ПараметрыФормы.Вставить("Период",			ТекущиеДанныеИстория.ДатаНастройки);
	ПараметрыФормы.Вставить("ТипСубъекта",		?(ЗначениеЗаполнено(ТекущиеДанныеИстория.ТипСубъекта), ТекущиеДанныеИстория.ТипСубъекта, ТипСубъекта));
	ПараметрыФормы.Вставить("Клиент",			Клиент);
	ПараметрыФормы.Вставить("ВидДоговора",		ВидДоговора);
	ПараметрыФормы.Вставить("Договор",			Договор);
	ПараметрыФормы.Вставить("ГруппаОтчетов",	ГруппаОтчетов);
	ПараметрыФормы.Вставить("Отчет",			Отчет);
	// Периодичность передаем только когда открывается настройка с указанием периодичности (четные приоритеты).
	ПараметрыФормы.Вставить("Периодичность",	?(Цел(ТекущиеДанныеИстория.Приоритет/2) = ТекущиеДанныеИстория.Приоритет/2, Периодичность, Неопределено));
	ПараметрыФормы.Вставить("УровеньНастройки",	ТекущиеДанныеИстория.Приоритет);
	
	ОткрытьФормуМодально("РегистрСведений.СоставИНастройкиОтчетов.Форма.ФормаРедактированияНастройки", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура УнаследованоОтНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуМодально("РегистрСведений.СоставИНастройкиОтчетов.Форма.ФормаРедактированияНастройки", ПараметрыФормыНаследуемойНастройки, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеПриИзменении(Элемент)
	
	Если Элементы.КомментарийКЗначениюНастройки.Видимость Тогда
		
		ЗначениеВКБ	= 0;
		ЗначениеВМБ	= 0;
		
		Если ЗначениеЗаполнено(Значение) Тогда
			ЗначениеВКБ	= Значение/1024;
			ЗначениеВМБ	= Значение/1048576;
		КонецЕсли;
		
		Элементы.КомментарийКЗначениюНастройки.Заголовок = СтрШаблон("%1 (КБ) / %2 (МБ)", Формат(ЗначениеВКБ, "ЧДЦ=2; ЧН=0; ЧГ=0"), Формат(ЗначениеВМБ, "ЧДЦ=2; ЧН=0; ЧГ=0"));
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КонструкторФорматнойСтроки(Команда)
	
	Конструктор = Новый КонструкторФорматнойСтроки(Элементы.Значение.ВыделенныйТекст);
	Конструктор.ДоступныеТипы = Новый ОписаниеТипов("Дата");
	
	Если Конструктор.ОткрытьМодально() Тогда
		Элементы.Значение.ВыделенныйТекст = Конструктор.Текст;
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	Если ПроверитьЗаполнение()
		И (ТипСубъекта = "Договор" И ТипОтчета = "Отчет" И ЗначениеЗаполнено(Периодичность)
			ИЛИ ИзменениеПодтверждено()) Тогда
			
		ЗафиксироватьЗначенияКлючаЗаписи();
		
		Если Режим = "Редактирование" Тогда
			ДатаДляПроверкиНаличияЗаписи = ДатаНастройки;
		Иначе
			ДатаДляПроверкиНаличияЗаписи = ЗначенияКлючаЗаписи.Период;
		КонецЕсли;
		
		Если ЕстьЗапись(ДатаДляПроверкиНаличияЗаписи) Тогда
			Если Вопрос(СтрШаблон("На %1 уже есть запись. Заменить новой записью?", Формат(ДатаДляПроверкиНаличияЗаписи, "ДФ=dd.MM.yyyy")), РежимДиалогаВопрос.ОКОтмена) = КодВозвратаДиалога.ОК Тогда
				Замещение = Истина;
			Иначе
				Возврат;
			КонецЕсли;
		Иначе
			Замещение = Ложь;
		КонецЕсли;
		
		Если ЗаписатьЗначение(Замещение) Тогда
			Закрыть(Истина);
		КонецЕсли;
		
	Иначе
		ЗаполнитьИсторию();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)
	
	Если ПроверитьЗаполнение()
		И (ТипСубъекта = "Договор" И ТипОтчета = "Отчет" И ЗначениеЗаполнено(Периодичность)
			ИЛИ ИзменениеПодтверждено()) Тогда
			
		ЗафиксироватьЗначенияКлючаЗаписи();
		
		Если Режим = "Редактирование" Тогда
			ДатаДляПроверкиНаличияЗаписи = ДатаНастройки;
		Иначе
			ДатаДляПроверкиНаличияЗаписи = ЗначенияКлючаЗаписи.Период;
		КонецЕсли;
		
		Если ЕстьЗапись(ДатаДляПроверкиНаличияЗаписи) Тогда
			Если Вопрос(СтрШаблон("На %1 уже есть запись. Заменить новой записью?", Формат(ДатаДляПроверкиНаличияЗаписи, "ДФ=dd.MM.yyyy")), РежимДиалогаВопрос.ОКОтмена) = КодВозвратаДиалога.ОК Тогда
				Замещение = Истина;
			Иначе
				Возврат;
			КонецЕсли;
		Иначе
			Замещение = Ложь;
		КонецЕсли;
		
		ЗаписатьЗначение(Замещение);
		
		ОбновитьФормуПослеЗаписи();
		
		УстановитьВидимостьИДоступностьЭлементов(); // Т.к. режим мог измениться.
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	Заголовок = СтрШаблон("Значение настройки (%1)", Режим);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьИДоступностьЭлементов()
	
	// Видимость.
	Элементы.ФормаЗаписатьИЗакрыть.Видимость	= Режим <> "Просмотр";
	Элементы.ФормаЗаписать.Видимость			= Режим <> "Просмотр";
	Элементы.Клиент.Видимость					= ТипСубъекта <> "Организация";
	Элементы.ВидДоговора.Видимость				= ТипСубъекта = "ВидДоговора";
	Элементы.Договор.Видимость					= ТипСубъекта = "Договор";
	Элементы.ГруппаОтчетов.Видимость			= ТипОтчета = "ГруппаОтчетов";
	Элементы.Отчет.Видимость					= ТипОтчета = "Отчет";
	Элементы.УнаследованоОт.Видимость			= Режим <> "Добавление" И ЗначениеЗаполнено(УнаследованоОт);
	Элементы.ГруппаИстория.Видимость			= Режим <> "Добавление";
	
	// Доступность.
	Элементы.ТипСубъекта.ТолькоПросмотр		= Режим <> "Добавление";
	Элементы.ВидДоговора.ТолькоПросмотр		= Режим <> "Добавление";
	Элементы.Договор.ТолькоПросмотр			= Режим <> "Добавление";
	Элементы.ТипОтчета.ТолькоПросмотр		= Режим <> "Добавление";
	Элементы.ГруппаОтчетов.ТолькоПросмотр	= Режим <> "Добавление";
	Элементы.Отчет.ТолькоПросмотр			= Режим <> "Добавление";
	Элементы.Периодичность.ТолькоПросмотр	= Режим <> "Добавление";
	Элементы.Значение.ТолькоПросмотр		= Режим = "Просмотр" ИЛИ Режим = "Редактирование" И ЗначениеЗаполнено(УнаследованоОт);
	Элементы.ДатаНастройки.ТолькоПросмотр	= Режим = "Просмотр";
	
КонецПроцедуры

&НаСервере
Функция УстановитьБлокировку(Отказ = Ложь)
	
	КлючЗаписи = РегистрыСведений.СоставИНастройкиОтчетов.СоздатьКлючЗаписи(ЗначенияКлючаЗаписи);
	
	Попытка
		ЗаблокироватьДанныеДляРедактирования(КлючЗаписи, , ЭтаФорма.УникальныйИдентификатор);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось заблокировать запись! Данные заблокированы другим сеансом.",,,, Отказ);
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьИсториюНаСервере()
	
	Если Режим = "Добавление" Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Настройка",			Настройка);
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("ТипСубъекта",		ТипСубъекта);
	Запрос.УстановитьПараметр("Клиент",				Клиент);
	Запрос.УстановитьПараметр("Договор",			Договор);
	Запрос.УстановитьПараметр("ВидДоговора",		ВидДоговора);
	Запрос.УстановитьПараметр("ТипОтчета",			ТипОтчета);
	Запрос.УстановитьПараметр("ГруппаОтчетов",		ГруппаОтчетов);
	Запрос.УстановитьПараметр("Отчет",				Отчет);
	Запрос.УстановитьПараметр("Периодичность",		Периодичность);
	Запрос.УстановитьПараметр("ПустаяДата",			Дата(1, 1, 1));
	Запрос.УстановитьПараметр("УровеньНастройки",	УровеньНастройки);
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоставИНастройкиОтчетов.Период КАК Период,
		|	СоставИНастройкиОтчетов.Приоритет КАК Приоритет,
		|	СоставИНастройкиОтчетов.ВидЗначения КАК ВидЗначения,
		|	СоставИНастройкиОтчетов.Значение КАК Значение,
		|	СоставИНастройкиОтчетов.Периодичность КАК Периодичность
		|ПОМЕСТИТЬ _ВсеНастройки
		|ИЗ
		|	РегистрСведений.СоставИНастройкиОтчетов КАК СоставИНастройкиОтчетов
		|ГДЕ
		|	СоставИНастройкиОтчетов.Настройка = &Настройка
		|	И СоставИНастройкиОтчетов.Организация = &Организация
		|	И ВЫБОР
		|			КОГДА &ТипСубъекта = ""Организация""
		|				ТОГДА СоставИНастройкиОтчетов.Субъект = НЕОПРЕДЕЛЕНО
		|			КОГДА &ТипСубъекта = ""Клиент""
		|					ИЛИ &ТипСубъекта = ""ВидДоговора""
		|				ТОГДА СоставИНастройкиОтчетов.Субъект = НЕОПРЕДЕЛЕНО
		|						ИЛИ СоставИНастройкиОтчетов.Субъект = &Клиент
		|			КОГДА &ТипСубъекта = ""Договор""
		|				ТОГДА СоставИНастройкиОтчетов.Субъект = НЕОПРЕДЕЛЕНО
		|						ИЛИ СоставИНастройкиОтчетов.Субъект = &Клиент
		|						ИЛИ СоставИНастройкиОтчетов.Субъект = &Договор
		|		КОНЕЦ
		|	И (СоставИНастройкиОтчетов.ВидДоговора = &ВидДоговора
		|			ИЛИ СоставИНастройкиОтчетов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка))
		|	И ВЫБОР
		|			КОГДА &ТипОтчета = ""ВсеОтчеты""
		|				ТОГДА СоставИНастройкиОтчетов.Отчет = ЗНАЧЕНИЕ(Справочник.Отчеты.ПустаяСсылка)
		|			КОГДА &ТипОтчета = ""ГруппаОтчетов""
		|				ТОГДА СоставИНастройкиОтчетов.Отчет = ЗНАЧЕНИЕ(Справочник.Отчеты.ПустаяСсылка)
		|						ИЛИ СоставИНастройкиОтчетов.Отчет = &ГруппаОтчетов
		|			ИНАЧЕ СоставИНастройкиОтчетов.Отчет = ЗНАЧЕНИЕ(Справочник.Отчеты.ПустаяСсылка)
		|					ИЛИ СоставИНастройкиОтчетов.Отчет = &ГруппаОтчетов
		|					ИЛИ СоставИНастройкиОтчетов.Отчет = &Отчет
		|		КОНЕЦ
		|	И (СоставИНастройкиОтчетов.Периодичность = &Периодичность
		|			ИЛИ СоставИНастройкиОтчетов.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.ПустаяСсылка))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеНастройки.Приоритет КАК Приоритет,
		|	_ВсеНастройки.Период КАК Период,
		|	_ВсеНастройки.Значение КАК Значение,
		|	_ВсеНастройки.Периодичность КАК Периодичность
		|ПОМЕСТИТЬ _ДатыИЗначенияНастроек
		|ИЗ
		|	_ВсеНастройки КАК _ВсеНастройки
		|ГДЕ
		|	_ВсеНастройки.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ВидыЗначенияНастроекОтчетов.Собственное)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДатыИЗначенияНастроек.Приоритет КАК Приоритет,
		|	_ДатыИЗначенияНастроек.Значение КАК Значение,
		|	_ДатыИЗначенияНастроек.Период КАК НачалоПериода,
		|	МИНИМУМ(ЕСТЬNULL(_ВсеНастройки.Период, &ПустаяДата)) КАК КонецПериода,
		|	_ДатыИЗначенияНастроек.Периодичность КАК Периодичность
		|ПОМЕСТИТЬ _ПериодыДействияЗначенийНастроек
		|ИЗ
		|	_ДатыИЗначенияНастроек КАК _ДатыИЗначенияНастроек
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеНастройки КАК _ВсеНастройки
		|		ПО _ДатыИЗначенияНастроек.Приоритет = _ВсеНастройки.Приоритет
		|			И _ДатыИЗначенияНастроек.Период < _ВсеНастройки.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДатыИЗначенияНастроек.Приоритет,
		|	_ДатыИЗначенияНастроек.Период,
		|	_ДатыИЗначенияНастроек.Значение,
		|	_ДатыИЗначенияНастроек.Периодичность
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПериодыДействияЗначенийНастроек.НачалоПериода КАК Дата
		|ПОМЕСТИТЬ _ДатыИзмененияЗачений
		|ИЗ
		|	_ПериодыДействияЗначенийНастроек КАК _ПериодыДействияЗначенийНастроек
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_ПериодыДействияЗначенийНастроек.КонецПериода
		|ИЗ
		|	_ПериодыДействияЗначенийНастроек КАК _ПериодыДействияЗначенийНастроек
		|ГДЕ
		|	_ПериодыДействияЗначенийНастроек.КонецПериода <> &ПустаяДата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДатыИзмененияЗачений.Дата КАК Дата,
		|	МАКСИМУМ(ЕСТЬNULL(_ПериодыДействияЗначенийНастроек.Приоритет, 0)) КАК Приоритет
		|ПОМЕСТИТЬ _ПриоритетыДействующихНастроекНаДатыИзменений
		|ИЗ
		|	_ДатыИзмененияЗачений КАК _ДатыИзмененияЗачений
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПериодыДействияЗначенийНастроек КАК _ПериодыДействияЗначенийНастроек
		|		ПО _ДатыИзмененияЗачений.Дата >= _ПериодыДействияЗначенийНастроек.НачалоПериода
		|			И (_ПериодыДействияЗначенийНастроек.КонецПериода = &ПустаяДата
		|				ИЛИ _ДатыИзмененияЗачений.Дата < _ПериодыДействияЗначенийНастроек.КонецПериода)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДатыИзмененияЗачений.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ПриоритетыДействующихНастроекНаДатыИзменений.Дата КАК ДатаНастройки,
		|	ЕСТЬNULL(_ПериодыДействияЗначенийНастроек1.Значение, НЕОПРЕДЕЛЕНО) КАК Значение,
		|	ВЫБОР
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет = 0
		|			ТОГДА ""Нет данных для наследования. Используется значение по умолчанию""
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет = &УровеньНастройки
		|			ТОГДА """"
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет МЕЖДУ 1 И 2
		|			ТОГДА ""Организация""
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет МЕЖДУ 3 И 4
		|			ТОГДА ""Группа отчетов организации""
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет МЕЖДУ 5 И 6
		|			ТОГДА ""Отчет организации""
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет МЕЖДУ 7 И 8
		|			ТОГДА ""Клиент""
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет МЕЖДУ 9 И 10
		|			ТОГДА ""Группа отчетов клиента""
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет МЕЖДУ 11 И 12
		|			ТОГДА ""Отчет клиента""
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет МЕЖДУ 13 И 14
		|			ТОГДА ""Вид договора""
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет МЕЖДУ 15 И 16
		|			ТОГДА ""Группа отчетов вида договора""
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет МЕЖДУ 17 И 18
		|			ТОГДА ""Отчет вида договора""
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет МЕЖДУ 19 И 20
		|			ТОГДА ""Договор""
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет МЕЖДУ 21 И 22
		|			ТОГДА ""Группа отчетов договора""
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет = 23
		|			ТОГДА ""Отчет договора""
		|	КОНЕЦ КАК УнаследованоОт,
		|	ЕСТЬNULL(_ПериодыДействияЗначенийНастроек1.Периодичность, НЕОПРЕДЕЛЕНО) КАК Периодичность,
		|	_ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет КАК Приоритет,
		|	ВЫБОР
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет = 0
		|			ТОГДА """"
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет МЕЖДУ 1 И 6
		|			ТОГДА ""Организация""
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет МЕЖДУ 7 И 12
		|			ТОГДА ""Клиент""
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет МЕЖДУ 13 И 20
		|			ТОГДА ""Вид договора""
		|		КОГДА _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет МЕЖДУ 19 И 24
		|			ТОГДА ""Договор""
		|	КОНЕЦ КАК ТипСубъекта
		|ИЗ
		|	_ПриоритетыДействующихНастроекНаДатыИзменений КАК _ПриоритетыДействующихНастроекНаДатыИзменений
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПериодыДействияЗначенийНастроек КАК _ПериодыДействияЗначенийНастроек
		|		ПО (_ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет = _ПериодыДействияЗначенийНастроек.Приоритет
		|					И _ПриоритетыДействующихНастроекНаДатыИзменений.Дата = _ПериодыДействияЗначенийНастроек.НачалоПериода
		|				ИЛИ _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет < _ПериодыДействияЗначенийНастроек.Приоритет
		|					И _ПриоритетыДействующихНастроекНаДатыИзменений.Дата = _ПериодыДействияЗначенийНастроек.КонецПериода)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПериодыДействияЗначенийНастроек КАК _ПериодыДействияЗначенийНастроек1
		|		ПО _ПриоритетыДействующихНастроекНаДатыИзменений.Приоритет = _ПериодыДействияЗначенийНастроек1.Приоритет
		|			И _ПриоритетыДействующихНастроекНаДатыИзменений.Дата >= _ПериодыДействияЗначенийНастроек1.НачалоПериода
		|			И (_ПериодыДействияЗначенийНастроек1.КонецПериода = &ПустаяДата
		|				ИЛИ _ПриоритетыДействующихНастроекНаДатыИзменений.Дата < _ПериодыДействияЗначенийНастроек1.КонецПериода)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаНастройки";
	#КонецОбласти
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = История.Добавить();
		
		НоваяСтрока.ДатаНастройки	= Выборка.ДатаНастройки;
		НоваяСтрока.Значение		= Выборка.Значение;
		НоваяСтрока.Приоритет		= Выборка.Приоритет;
		НоваяСтрока.ТипСубъекта		= Выборка.ТипСубъекта;
		
		Если ЗначениеЗаполнено(Выборка.УнаследованоОт) Тогда
			Если ЗначениеЗаполнено(Выборка.Периодичность) Тогда
				НоваяСтрока.УнаследованоОт = Выборка.УнаследованоОт + " (" + НРег(Строка(Выборка.Периодичность)) + ")";
			Иначе
				НоваяСтрока.УнаследованоОт = Выборка.УнаследованоОт;
			КонецЕсли;
			
			Если Выборка.УнаследованоОт = "Нет записей для наследования. Используется значение по умолчанию" Тогда
				Элементы.УнаследованоОт.Гиперссылка = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначениеНастройки()
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период",			ЗначенияКлючаЗаписи.Период);
	Запрос.УстановитьПараметр("Организация",	ЗначенияКлючаЗаписи.Организация);
	Запрос.УстановитьПараметр("Периодичность",	ЗначенияКлючаЗаписи.Периодичность);
	Запрос.УстановитьПараметр("Настройка",		ЗначенияКлючаЗаписи.Настройка);
	Запрос.УстановитьПараметр("ТипСубъекта",	ТипСубъекта);
	Запрос.УстановитьПараметр("Клиент",			Клиент);
	Запрос.УстановитьПараметр("ВидДоговора",	ВидДоговора);
	Запрос.УстановитьПараметр("Договор",		Договор);
	Запрос.УстановитьПараметр("ТипОтчета",		ТипОтчета);
	Запрос.УстановитьПараметр("ГруппаОтчетов",	ГруппаОтчетов);
	Запрос.УстановитьПараметр("Отчет",			Отчет);
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ВЫБОР
		|		КОГДА СоставИНастройкиОтчетовСрезПоследних.Субъект = НЕОПРЕДЕЛЕНО
		|			ТОГДА ""Организация""
		|		КОГДА ТИПЗНАЧЕНИЯ(СоставИНастройкиОтчетовСрезПоследних.Субъект) = ТИП(Справочник.СчетаДоверительногоУправления)
		|			ТОГДА ""Договор""
		|		КОГДА СоставИНастройкиОтчетовСрезПоследних.ВидДоговора <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|			ТОГДА ""ВидДоговора""
		|		ИНАЧЕ ""Клиент""
		|	КОНЕЦ КАК ТипСубъекта,
		|	ВЫБОР
		|		КОГДА СоставИНастройкиОтчетовСрезПоследних.Отчет = ЗНАЧЕНИЕ(Справочник.Отчеты.ПустаяСсылка)
		|			ТОГДА ""ВсеОтчеты""
		|		КОГДА СоставИНастройкиОтчетовСрезПоследних.Отчет.ЭтоГруппа
		|			ТОГДА ""ГруппаОтчетов""
		|		ИНАЧЕ ""Отчет""
		|	КОНЕЦ КАК ТипОтчета,
		|	СоставИНастройкиОтчетовСрезПоследних.Значение КАК Значение,
		|	СоставИНастройкиОтчетовСрезПоследних.Приоритет КАК Приоритет,
		|	СоставИНастройкиОтчетовСрезПоследних.Настройка КАК Настройка,
		|	СоставИНастройкиОтчетовСрезПоследних.Организация КАК Организация,
		|	СоставИНастройкиОтчетовСрезПоследних.Период КАК Период,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(СоставИНастройкиОтчетовСрезПоследних.Субъект) <> ТИП(Справочник.СчетаДоверительногоУправления)
		|			ТОГДА СоставИНастройкиОтчетовСрезПоследних.Субъект
		|	КОНЕЦ КАК Клиент,
		|	СоставИНастройкиОтчетовСрезПоследних.ВидДоговора КАК ВидДоговора,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(СоставИНастройкиОтчетовСрезПоследних.Субъект) = ТИП(Справочник.СчетаДоверительногоУправления)
		|			ТОГДА СоставИНастройкиОтчетовСрезПоследних.Субъект
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка)
		|	КОНЕЦ КАК Договор,
		|	ВЫБОР
		|		КОГДА СоставИНастройкиОтчетовСрезПоследних.Отчет.ЭтоГруппа
		|			ТОГДА СоставИНастройкиОтчетовСрезПоследних.Отчет
		|		КОГДА СоставИНастройкиОтчетовСрезПоследних.Отчет.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Отчеты.ПустаяСсылка)
		|			ТОГДА СоставИНастройкиОтчетовСрезПоследних.Отчет.Родитель
		|		ИНАЧЕ СоставИНастройкиОтчетовСрезПоследних.Отчет.Родитель.Родитель
		|	КОНЕЦ КАК ГруппаОтчетов,
		|	ВЫБОР
		|		КОГДА НЕ СоставИНастройкиОтчетовСрезПоследних.Отчет.ЭтоГруппа
		|			ТОГДА СоставИНастройкиОтчетовСрезПоследних.Отчет
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Отчеты.ПустаяСсылка)
		|	КОНЕЦ КАК Отчет,
		|	СоставИНастройкиОтчетовСрезПоследних.Периодичность КАК Периодичность
		|ИЗ
		|	РегистрСведений.СоставИНастройкиОтчетов.СрезПоследних(
		|			&Период,
		|			Настройка = &Настройка
		|				И Организация = &Организация
		|				И (Периодичность = &Периодичность
		|					ИЛИ Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.ПустаяСсылка))
		|				И ВЫБОР
		|					КОГДА &ТипСубъекта = ""Организация""
		|						ТОГДА Субъект = НЕОПРЕДЕЛЕНО
		|								И ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|					КОГДА &ТипСубъекта = ""Клиент""
		|						ТОГДА Субъект = НЕОПРЕДЕЛЕНО
		|									И ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|								ИЛИ Субъект = &Клиент
		|									И ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|					КОГДА &ТипСубъекта = ""ВидДоговора""
		|						ТОГДА Субъект = НЕОПРЕДЕЛЕНО
		|									И ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|								ИЛИ Субъект = &Клиент
		|									И (ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|										ИЛИ ВидДоговора = &ВидДоговора)
		|					ИНАЧЕ Субъект = НЕОПРЕДЕЛЕНО
		|								И ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|							ИЛИ Субъект = &Клиент
		|								И (ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|									ИЛИ ВидДоговора = &ВидДоговора)
		|							ИЛИ Субъект = &Договор
		|				КОНЕЦ
		|				И ВЫБОР
		|					КОГДА &ТипОтчета = ""ВсеОтчеты""
		|						ТОГДА Отчет = ЗНАЧЕНИЕ(Справочник.Отчеты.ПустаяСсылка)
		|					КОГДА &ТипОтчета = ""ГруппаОтчетов""
		|						ТОГДА Отчет = ЗНАЧЕНИЕ(Справочник.Отчеты.ПустаяСсылка)
		|								ИЛИ Отчет = &ГруппаОтчетов
		|					ИНАЧЕ Отчет = ЗНАЧЕНИЕ(Справочник.Отчеты.ПустаяСсылка)
		|							ИЛИ Отчет = &ГруппаОтчетов
		|							ИЛИ Отчет = &Отчет
		|				КОНЕЦ) КАК СоставИНастройкиОтчетовСрезПоследних
		|ГДЕ
		|	СоставИНастройкиОтчетовСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ВидыЗначенияНастроекОтчетов.Собственное)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СоставИНастройкиОтчетовСрезПоследних.Приоритет УБЫВ";
	#КонецОбласти
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Значение = Выборка.Значение;
		
		// Заполняем данные о субъекте и типе отчета наследуемой настройки.
		Если Выборка.ТипСубъекта <> ТипСубъекта ИЛИ Выборка.ТипОтчета <> ТипОтчета Тогда
			
			Если Выборка.ТипОтчета = "ВсеОтчеты" Тогда
				Если Выборка.ТипСубъекта = "Организация" Тогда
					УнаследованоОт = СтрШаблон("Организация '%1'", Организация);
				ИначеЕсли Выборка.ТипСубъекта = "Клиент" Тогда
					УнаследованоОт = СтрШаблон("Клиент '%1'", Клиент);
				ИначеЕсли Выборка.ТипСубъекта = "ВидДоговора" Тогда
					УнаследованоОт = СтрШаблон("Вид договора '%1' клиента '%2'", ВидДоговора, Клиент);
				Иначе
					УнаследованоОт = СтрШаблон("Договор '%1'", Договор);
				КонецЕсли;
			ИначеЕсли Выборка.ТипОтчета = "ГруппаОтчетов" Тогда
				Если Выборка.ТипСубъекта = "Организация" Тогда
					УнаследованоОт = СтрШаблон("Группа отчетов '%1' организации '%2'", ГруппаОтчетов, Организация);
				ИначеЕсли Выборка.ТипСубъекта = "Клиент" Тогда
					УнаследованоОт = СтрШаблон("Группа отчетов '%1' клиента '%2'", ГруппаОтчетов, Клиент);
				ИначеЕсли Выборка.ТипСубъекта = "ВидДоговора" Тогда
					УнаследованоОт = СтрШаблон("Группа отчетов '%1' вида договора '%2' клиента '%3'", ГруппаОтчетов, ВидДоговора, Клиент);
				Иначе
					УнаследованоОт = СтрШаблон("Группа отчетов '%1' договора '%2'", ГруппаОтчетов, Договор);
				КонецЕсли;
			Иначе
				Если Выборка.ТипСубъекта = "Организация" Тогда
					УнаследованоОт = СтрШаблон("Отчет '%1' организации '%2'", Отчет, Организация);
				ИначеЕсли Выборка.ТипСубъекта = "Клиент" Тогда
					УнаследованоОт = СтрШаблон("Отчет '%1' клиента '%2'", Отчет, Клиент);
				ИначеЕсли Выборка.ТипСубъекта = "ВидДоговора" Тогда
					УнаследованоОт = СтрШаблон("Отчет '%1' вида договора '%2' клиента '%3'", Отчет, ВидДоговора, Клиент);
				Иначе
					УнаследованоОт = СтрШаблон("Отчет '%1' договора '%2'", Отчет, Договор);
				КонецЕсли;
			КонецЕсли;
			
			ПараметрыФормыНаследуемойНастройки = Новый Структура;
			
			ПараметрыФормыНаследуемойНастройки.Вставить("Режим",			"Просмотр");
			ПараметрыФормыНаследуемойНастройки.Вставить("Настройка",		Выборка.Настройка);
			ПараметрыФормыНаследуемойНастройки.Вставить("Организация",		Выборка.Организация);
			ПараметрыФормыНаследуемойНастройки.Вставить("Период",			Выборка.Период);
			ПараметрыФормыНаследуемойНастройки.Вставить("ТипСубъекта",		Выборка.ТипСубъекта);
			ПараметрыФормыНаследуемойНастройки.Вставить("Клиент",			Выборка.Клиент);
			ПараметрыФормыНаследуемойНастройки.Вставить("ВидДоговора",		Выборка.ВидДоговора);
			ПараметрыФормыНаследуемойНастройки.Вставить("Договор",			Выборка.Договор);
			ПараметрыФормыНаследуемойНастройки.Вставить("ГруппаОтчетов",	Выборка.ГруппаОтчетов);
			ПараметрыФормыНаследуемойНастройки.Вставить("Отчет",			Выборка.Отчет);
			ПараметрыФормыНаследуемойНастройки.Вставить("Периодичность",	Выборка.Периодичность);
			ПараметрыФормыНаследуемойНастройки.Вставить("УровеньНастройки",	Выборка.Приоритет);
			
		КонецЕсли;
	Иначе
		Значение		= Неопределено;
		УнаследованоОт	= "Нет данных для наследования. Используется значение по умолчанию";
		Элементы.УнаследованоОт.Гиперссылка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ИзменениеПодтверждено()
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Настройка",		Настройка);
	ПараметрыФормы.Вставить("ДатаНастройки",	ДатаНастройки);
	ПараметрыФормы.Вставить("Организация",		Организация);
	ПараметрыФормы.Вставить("Периодичность",	Периодичность);
	
	Если Режим = "Редактирование" Тогда
		ПараметрыФормы.Вставить("Событие",		"Изменение");
		ПараметрыФормы.Вставить("СтарыйПериод",	ЗначенияКлючаЗаписи.Период);
	Иначе
		ПараметрыФормы.Вставить("Событие",		"Добавление");
	КонецЕсли;
	
	Если ТипСубъекта = "Клиент"
		ИЛИ ТипСубъекта = "ВидДоговора" Тогда
		ПараметрыФормы.Вставить("Клиент", Клиент);
	Иначе
		ПараметрыФормы.Вставить("Клиент", Неопределено);
	КонецЕсли;
	
	Если ТипСубъекта = "ВидДоговора" Тогда
		ПараметрыФормы.Вставить("ВидДоговора", ВидДоговора);
	Иначе
		ПараметрыФормы.Вставить("ВидДоговора", ПустойВидДоговора);
	КонецЕсли;
	
	Если ТипСубъекта = "Договор" Тогда
		ПараметрыФормы.Вставить("Договор", Договор);
	Иначе
		ПараметрыФормы.Вставить("Договор", ПустойДоговор);
	КонецЕсли;
	
	Если ТипОтчета = "ВсеОтчеты" Тогда
		ПараметрыФормы.Вставить("Отчет", ПустойОтчет);
	ИначеЕсли ТипОтчета = "ГруппаОтчетов" Тогда
		ПараметрыФормы.Вставить("Отчет", ГруппаОтчетов);
	Иначе
		ПараметрыФормы.Вставить("Отчет", Отчет);
	КонецЕсли;
	
	Если Режим = "Добавление" Тогда
		Если ТипСубъекта = "Клиент" Тогда
			УровеньНовойНастройки = 7;
		ИначеЕсли ТипСубъекта = "ВидДоговора" Тогда
			УровеньНовойНастройки = 13;
		Иначе
			УровеньНовойНастройки = 19;
		КонецЕсли;
		
		Если ТипОтчета = "ГруппаОтчетов" Тогда
			УровеньНовойНастройки = УровеньНовойНастройки + 2;
		ИначеЕсли ТипОтчета = "Отчет" Тогда
			УровеньНовойНастройки = УровеньНовойНастройки + 4;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Периодичность) Тогда
			УровеньНовойНастройки = УровеньНовойНастройки + 1;
		КонецЕсли;
	Иначе
		УровеньНовойНастройки = УровеньНастройки;
		
		ПараметрыФормы.Вставить("СтарыйПериод", );
	КонецЕсли;
	
	ПараметрыФормы.Вставить("УровеньНастройки",	УровеньНовойНастройки);
	
	РезультатПодтверждения = ОткрытьФормуМодально("РегистрСведений.СоставИНастройкиОтчетов.Форма.ФормаПредупрежденияПриИзмененииНастройки", ПараметрыФормы, ЭтаФорма);
	
	Если РезультатПодтверждения <> Неопределено Тогда
		ДатаНастройки = РезультатПодтверждения;
	КонецЕсли;
	
	Возврат РезультатПодтверждения <> Неопределено;
	
КонецФункции

&НаСервере
Процедура СнятьБлокировкуЗаписи()
	
	КлючЗаписи = РегистрыСведений.СоставИНастройкиОтчетов.СоздатьКлючЗаписи(ЗначенияКлючаЗаписи);
	
	Попытка
		РазблокироватьДанныеДляРедактирования(КлючЗаписи, ЭтаФорма.УникальныйИдентификатор);
	Исключение
		// Смысла что-то сообщать пользователю - нет. Платформа сама через некоторое время снимет блокировку.
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗафиксироватьЗначенияКлючаЗаписи()
	
	Если Режим = "Добавление" Тогда
		
		ЗначенияКлючаЗаписи = Новый Структура;
		
		ЗначенияКлючаЗаписи.Вставить("Период",			ДатаНастройки);
		ЗначенияКлючаЗаписи.Вставить("Организация",		Организация);
		ЗначенияКлючаЗаписи.Вставить("Периодичность",	Периодичность);
		ЗначенияКлючаЗаписи.Вставить("Настройка",		Настройка);
		
		Если ТипСубъекта = "Организация" Тогда
			ЗначенияКлючаЗаписи.Вставить("Субъект", Неопределено);
		ИначеЕсли ТипСубъекта = "Договор" Тогда
			ЗначенияКлючаЗаписи.Вставить("Субъект", Договор);
		Иначе
			ЗначенияКлючаЗаписи.Вставить("Субъект", Клиент);
		КонецЕсли;
		
		Если ТипСубъекта = "ВидДоговора" Тогда
			ЗначенияКлючаЗаписи.Вставить("ВидДоговора", ВидДоговора);
		Иначе
			ЗначенияКлючаЗаписи.Вставить("ВидДоговора", ПустойВидДоговора);
		КонецЕсли;
		
		Если ТипОтчета = "Отчет" Тогда
			ЗначенияКлючаЗаписи.Вставить("Отчет", Отчет);
		ИначеЕсли ТипОтчета = "ГруппаОтчетов" Тогда
			ЗначенияКлючаЗаписи.Вставить("Отчет", ГруппаОтчетов);
		Иначе
			ЗначенияКлючаЗаписи.Вставить("Отчет", ПустойОтчет);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕстьЗапись(ДатаДляПроверкиНаличияЗаписи)
	
	НаборЗаписей = РегистрыСведений.СоставИНастройкиОтчетов.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.Период.Установить(ДатаДляПроверкиНаличияЗаписи);
	
	Для Каждого Поле Из ЗначенияКлючаЗаписи Цикл
		Если Поле.Ключ = "Период" Тогда
			Продолжить;
		КонецЕсли;
		
		НаборЗаписей.Отбор[Поле.Ключ].Установить(Поле.Значение);
	КонецЦикла;
	
	НаборЗаписей.Прочитать();
	
	Возврат НаборЗаписей.Количество() > 0;
	
КонецФункции

&НаСервере
Функция ЗаписатьЗначение(Замещение = Ложь)
	
	Если Режим = "Добавление" ИЛИ НЕ ЗначениеЗаполнено(УнаследованоОт) Тогда
		ВидЗначения = Перечисления.ВидыЗначенияНастроекОтчетов.Собственное;
	Иначе
		ВидЗначения = Перечисления.ВидыЗначенияНастроекОтчетов.ПоУмолчанию;
	КонецЕсли;
	
	Результат = Истина;
	
	Если Режим = "Добавление" Тогда
		Если РегистрыСведений.СоставИНастройкиОтчетов.ДобавитьЗапись(ЗначенияКлючаЗаписи, ВидЗначения, Значение, Замещение) Тогда
			// Если не удалось заблокировать запись - переходим в режим просмотра, если получилось - редактирование.
			Если НЕ УстановитьБлокировку() Тогда
				Режим = "Просмотр";
			Иначе
				Режим = "Редактирование";
			КонецЕсли;
			
			УстановитьЗаголовокФормы();
		Иначе
			Результат = Ложь;
		КонецЕсли;
	// Режим редактирования.
	Иначе
		Если РегистрыСведений.СоставИНастройкиОтчетов.ИзменитьДатуИЗначениеНастройки(ЗначенияКлючаЗаписи, ДатаНастройки, ВидЗначения, Значение, Замещение) Тогда
			// Снимаем блокировку записи со старой датой.
			СнятьБлокировкуЗаписи();
			
			// Меняем период в значениях ключа записи.
			ЗначенияКлючаЗаписи.Вставить("Период", ДатаНастройки);
			
			Если НЕ УстановитьБлокировку() Тогда
				// Если не удалось заблокировать запись - переходим в режим просмотра.
				Режим = "Просмотр";
				УстановитьЗаголовокФормы();
			КонецЕсли;
		Иначе
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьИсторию()
	
	История.Очистить();
	
	ЗаполнитьИсториюНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьФормуПослеЗаписи()
	
	ЗаполнитьЗначениеНастройки();
	
	ЗаполнитьИсториюНаСервере();
	
КонецПроцедуры

#КонецОбласти