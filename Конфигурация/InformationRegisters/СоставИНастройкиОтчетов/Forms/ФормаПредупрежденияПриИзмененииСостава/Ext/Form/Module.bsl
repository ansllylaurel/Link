#Область Команды_формы

&НаКлиенте
Процедура Принять(Команда)
	
	Закрыть(ДатаНастройки);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура ДатаНастройкиПриИзменении(Элемент)
	
	ЗаполнитьФорму();
	
	СвернутьРазвернутьУровниДерева(Дерево.ПолучитьЭлементы());
	
КонецПроцедуры

#КонецОбласти

#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДатаНастройки	= Параметры.ДатаНастройки;
	Организация		= Параметры.Организация;
	Отчет			= Параметры.Отчет;
	Периодичность	= Параметры.Периодичность;
	Клиент			= Параметры.Клиент;
	ВидДоговора		= Параметры.ВидДоговора;
	Событие			= Параметры.Событие;
	СтарыйПериод	= Параметры.СтарыйПериод;
	
	Элементы.Предупреждение.Заголовок = СтрШаблон(
											"Внимание!
											|Порядок формирования отчета '%1' (%2) изменится для следующих договоров:",
											Строка(Отчет),
											НРег(Строка(Периодичность)));
											
	Элементы.ДатаНастройки.Видимость = Событие = "Изменение";
	
	ЗаполнитьФорму();
	
КонецПроцедуры

#КонецОбласти

#Область Прочие_процедуры_и_функции

&НаКлиенте
Процедура СвернутьРазвернутьУровниДерева(Коллекция)
	
	Для Каждого Элемент Из Коллекция Цикл
		
		Если Элемент.Уровень = 1 Тогда
			Элементы.Дерево.Свернуть(Элемент.ПолучитьИдентификатор());
		Иначе
			Элементы.Дерево.Развернуть(Элемент.ПолучитьИдентификатор());
			
			СвернутьРазвернутьУровниДерева(Элемент.ПолучитьЭлементы());
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФорму()
	
	Дерево.ПолучитьЭлементы().Очистить();
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ДатаНастройки",	ДатаНастройки);
	Запрос.УстановитьПараметр("ПустаяДата",		Дата(1,1,1));
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("ВидДоговора",	ВидДоговора);
	Запрос.УстановитьПараметр("Клиент",			Клиент);
	Запрос.УстановитьПараметр("Отчет",			Отчет);
	Запрос.УстановитьПараметр("Периодичность",	Периодичность);
	Запрос.УстановитьПараметр("Событие",		Событие);
	Запрос.УстановитьПараметр("СтарыйПериод",	СтарыйПериод);
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ДатаНастройки КАК НачалоПериода,
		|	ЕСТЬNULL(МИНИМУМ(ДОБАВИТЬКДАТЕ(СоставИНастройкиОтчетов.Период, ДЕНЬ, -1)), &ПустаяДата) КАК КонецПериода
		|ПОМЕСТИТЬ _ПериодДействияНастройки
		|ИЗ
		|	РегистрСведений.СоставИНастройкиОтчетов КАК СоставИНастройкиОтчетов
		|ГДЕ
		|	СоставИНастройкиОтчетов.Период > &ДатаНастройки
		|	И СоставИНастройкиОтчетов.Организация = &Организация
		|	И СоставИНастройкиОтчетов.Субъект = &Клиент
		|	И СоставИНастройкиОтчетов.ВидДоговора = &ВидДоговора
		|	И СоставИНастройкиОтчетов.Отчет = &Отчет
		|	И СоставИНастройкиОтчетов.Периодичность = &Периодичность
		|	И СоставИНастройкиОтчетов.Настройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиОтчетов.Формировать)
		|	И ВЫБОР
		|			КОГДА &Событие = ""Изменение""
		|				ТОГДА СоставИНастройкиОтчетов.Период <> &СтарыйПериод
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправления.Клиент КАК Клиент,
		|	КлиентыДоверительногоУправления.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговора,
		|	КлиентыДоверительногоУправления.СчетДоверительногоУправления КАК Договор,
		|	КлиентыДоверительногоУправления.Период КАК Период,
		|	ЕСТЬNULL(УсловияДоговоровДоверительногоУправленияСрезПоследних.АвтоматическаяПролонгация, ЛОЖЬ) КАК АвтоматическаяПролонгация
		|ПОМЕСТИТЬ _ДанныеРегистраКлиентыДУ
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровДоверительногоУправления.СрезПоследних(&ДатаНастройки, Организация = &Организация) КАК УсловияДоговоровДоверительногоУправленияСрезПоследних
		|		ПО КлиентыДоверительногоУправления.Организация = УсловияДоговоровДоверительногоУправленияСрезПоследних.Организация
		|			И КлиентыДоверительногоУправления.СчетДоверительногоУправления = УсловияДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	КлиентыДоверительногоУправления.Организация = &Организация
		|	И (&ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|			ИЛИ КлиентыДоверительногоУправления.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = &ВидДоговора)
		|	И (КлиентыДоверительногоУправления.СчетДоверительногоУправления.ДатаРасторжения = &ПустаяДата
		|			ИЛИ КлиентыДоверительногоУправления.СчетДоверительногоУправления.ДатаРасторжения >= &ДатаНастройки
		|			ИЛИ ЕСТЬNULL(УсловияДоговоровДоверительногоУправленияСрезПоследних.АвтоматическаяПролонгация, ЛОЖЬ) = ИСТИНА)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеРегистраКлиентыДУ.Период КАК Период,
		|	_ДанныеРегистраКлиентыДУ.ВидДоговора КАК ВидДоговора,
		|	_ДанныеРегистраКлиентыДУ.Договор КАК Договор,
		|	_ДанныеРегистраКлиентыДУ.АвтоматическаяПролонгация КАК АвтоматическаяПролонгация
		|ПОМЕСТИТЬ _ВсеДоговорыКлиента
		|ИЗ
		|	_ДанныеРегистраКлиентыДУ КАК _ДанныеРегистраКлиентыДУ
		|ГДЕ
		|	_ДанныеРегистраКлиентыДУ.Клиент = &Клиент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеДоговорыКлиента.ВидДоговора КАК ВидДоговора,
		|	_ВсеДоговорыКлиента.Договор КАК Договор,
		|	_ВсеДоговорыКлиента.Период КАК НачалоПериода,
		|	МИНИМУМ(ВЫБОР
		|			КОГДА _ДанныеРегистраКлиентыДУ.Период ЕСТЬ NULL
		|				ТОГДА ВЫБОР
		|						КОГДА _ВсеДоговорыКлиента.Договор.ДатаРасторжения <> &ПустаяДата
		|							ТОГДА _ВсеДоговорыКлиента.Договор.ДатаРасторжения
		|						ИНАЧЕ &ПустаяДата
		|					КОНЕЦ
		|			КОГДА _ВсеДоговорыКлиента.Договор.ДатаРасторжения <> &ПустаяДата
		|					И _ВсеДоговорыКлиента.Договор.ДатаРасторжения < _ДанныеРегистраКлиентыДУ.Период
		|				ТОГДА _ВсеДоговорыКлиента.Договор.ДатаРасторжения
		|			ИНАЧЕ ДОБАВИТЬКДАТЕ(_ДанныеРегистраКлиентыДУ.Период, ДЕНЬ, -1)
		|		КОНЕЦ) КАК КонецПериода,
		|	_ВсеДоговорыКлиента.АвтоматическаяПролонгация КАК АвтоматическаяПролонгация
		|ПОМЕСТИТЬ _ПериодыПринадлежностиКлиенту
		|ИЗ
		|	_ВсеДоговорыКлиента КАК _ВсеДоговорыКлиента
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеРегистраКлиентыДУ КАК _ДанныеРегистраКлиентыДУ
		|		ПО _ВсеДоговорыКлиента.ВидДоговора = _ДанныеРегистраКлиентыДУ.ВидДоговора
		|			И _ВсеДоговорыКлиента.Договор = _ДанныеРегистраКлиентыДУ.Договор
		|			И _ВсеДоговорыКлиента.Период < _ДанныеРегистраКлиентыДУ.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВсеДоговорыКлиента.ВидДоговора,
		|	_ВсеДоговорыКлиента.Договор,
		|	_ВсеДоговорыКлиента.Период,
		|	_ВсеДоговорыКлиента.АвтоматическаяПролонгация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПериодыПринадлежностиКлиенту.ВидДоговора КАК ВидДоговора,
		|	_ПериодыПринадлежностиКлиенту.Договор КАК Договор,
		|	ВЫБОР
		|		КОГДА _ПериодДействияНастройки.НачалоПериода >= _ПериодыПринадлежностиКлиенту.НачалоПериода
		|			ТОГДА _ПериодДействияНастройки.НачалоПериода
		|		ИНАЧЕ _ПериодыПринадлежностиКлиенту.НачалоПериода
		|	КОНЕЦ КАК НачалоПериода,
		|	ВЫБОР
		|		КОГДА _ПериодДействияНастройки.КонецПериода = &ПустаяДата
		|			ТОГДА _ПериодыПринадлежностиКлиенту.КонецПериода
		|		КОГДА _ПериодыПринадлежностиКлиенту.КонецПериода = &ПустаяДата
		|			ТОГДА _ПериодДействияНастройки.КонецПериода
		|		КОГДА _ПериодДействияНастройки.КонецПериода < _ПериодыПринадлежностиКлиенту.КонецПериода
		|			ТОГДА _ПериодДействияНастройки.КонецПериода
		|		ИНАЧЕ _ПериодыПринадлежностиКлиенту.КонецПериода
		|	КОНЕЦ КАК КонецПериода,
		|	_ПериодыПринадлежностиКлиенту.АвтоматическаяПролонгация КАК АвтоматическаяПролонгация
		|ПОМЕСТИТЬ _ПериодыДействияНастройкиДляДоговоровКлиента
		|ИЗ
		|	_ПериодыПринадлежностиКлиенту КАК _ПериодыПринадлежностиКлиенту
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПериодДействияНастройки КАК _ПериодДействияНастройки
		|		ПО (_ПериодыПринадлежностиКлиенту.НачалоПериода >= _ПериодДействияНастройки.НачалоПериода
		|					И (_ПериодДействияНастройки.КонецПериода = &ПустаяДата
		|						ИЛИ _ПериодыПринадлежностиКлиенту.НачалоПериода <= _ПериодДействияНастройки.КонецПериода
		|						ИЛИ _ПериодыПринадлежностиКлиенту.АвтоматическаяПролонгация)
		|				ИЛИ _ПериодДействияНастройки.НачалоПериода > _ПериодыПринадлежностиКлиенту.НачалоПериода
		|					И (_ПериодыПринадлежностиКлиенту.КонецПериода = &ПустаяДата
		|						ИЛИ _ПериодДействияНастройки.НачалоПериода <= _ПериодыПринадлежностиКлиенту.КонецПериода
		|						ИЛИ _ПериодыПринадлежностиКлиенту.АвтоматическаяПролонгация))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА СоставИНастройкиОтчетов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|			ТОГДА ""Договор""
		|		ИНАЧЕ ""ВидДоговора""
		|	КОНЕЦ КАК ТипСубъектаНастройки,
		|	ВЫБОР
		|		КОГДА СоставИНастройкиОтчетов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|			ТОГДА СоставИНастройкиОтчетов.Субъект
		|		ИНАЧЕ СоставИНастройкиОтчетов.ВидДоговора
		|	КОНЕЦ КАК СубъектНастройки,
		|	СоставИНастройкиОтчетов.ВидЗначения КАК ВидЗначения,
		|	СоставИНастройкиОтчетов.Период КАК Период
		|ПОМЕСТИТЬ _ВсеНастройкиДоговоровИВидовДоговоров
		|ИЗ
		|	РегистрСведений.СоставИНастройкиОтчетов КАК СоставИНастройкиОтчетов
		|ГДЕ
		|	СоставИНастройкиОтчетов.Организация = &Организация
		|	И СоставИНастройкиОтчетов.Отчет = &Отчет
		|	И СоставИНастройкиОтчетов.Периодичность = &Периодичность
		|	И СоставИНастройкиОтчетов.Настройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиОтчетов.Формировать)
		|	И (ВЫБОР
		|				КОГДА &ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|					ТОГДА СоставИНастройкиОтчетов.Субъект = &Клиент
		|							И СоставИНастройкиОтчетов.ВидДоговора <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ
		|			ИЛИ СоставИНастройкиОтчетов.Субъект В
		|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|					_ВсеДоговорыКлиента.Договор КАК Договор
		|				ИЗ
		|					_ВсеДоговорыКлиента КАК _ВсеДоговорыКлиента))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеНастройкиДоговоровИВидовДоговоров.ТипСубъектаНастройки КАК ТипСубъектаНастройки,
		|	_ВсеНастройкиДоговоровИВидовДоговоров.СубъектНастройки КАК СубъектНастройки,
		|	_ВсеНастройкиДоговоровИВидовДоговоров.Период КАК НачалоПериода,
		|	МИНИМУМ(ЕСТЬNULL(ДОБАВИТЬКДАТЕ(_ВсеНастройкиДоговоровИВидовДоговоров1.Период, ДЕНЬ, -1), &ПустаяДата)) КАК КонецПериода
		|ПОМЕСТИТЬ _ПериодыСобственнойНастройки
		|ИЗ
		|	_ВсеНастройкиДоговоровИВидовДоговоров КАК _ВсеНастройкиДоговоровИВидовДоговоров
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеНастройкиДоговоровИВидовДоговоров КАК _ВсеНастройкиДоговоровИВидовДоговоров1
		|		ПО _ВсеНастройкиДоговоровИВидовДоговоров.ТипСубъектаНастройки = _ВсеНастройкиДоговоровИВидовДоговоров1.ТипСубъектаНастройки
		|			И _ВсеНастройкиДоговоровИВидовДоговоров.СубъектНастройки = _ВсеНастройкиДоговоровИВидовДоговоров1.СубъектНастройки
		|			И _ВсеНастройкиДоговоровИВидовДоговоров.Период < _ВсеНастройкиДоговоровИВидовДоговоров1.Период
		|ГДЕ
		|	_ВсеНастройкиДоговоровИВидовДоговоров.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ВидыЗначенияНастроекОтчетов.Собственное)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВсеНастройкиДоговоровИВидовДоговоров.Период,
		|	_ВсеНастройкиДоговоровИВидовДоговоров.СубъектНастройки,
		|	_ВсеНастройкиДоговоровИВидовДоговоров.ТипСубъектаНастройки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПериодыДействияНастройкиДляДоговоровКлиента.ВидДоговора КАК ВидДоговора,
		|	_ПериодыДействияНастройкиДляДоговоровКлиента.Договор КАК Договор,
		|	ВЫБОР
		|		КОГДА _ПериодыСобственнойНастройки.СубъектНастройки ЕСТЬ NULL
		|			ТОГДА _ПериодыДействияНастройкиДляДоговоровКлиента.НачалоПериода
		|		ИНАЧЕ ВЫБОР
		|				КОГДА _ПериодыДействияНастройкиДляДоговоровКлиента.НачалоПериода > _ПериодыСобственнойНастройки.НачалоПериода
		|					ТОГДА _ПериодыДействияНастройкиДляДоговоровКлиента.НачалоПериода
		|				ИНАЧЕ _ПериодыСобственнойНастройки.НачалоПериода
		|			КОНЕЦ
		|	КОНЕЦ КАК НачалоПериода,
		|	ВЫБОР
		|		КОГДА _ПериодыСобственнойНастройки.СубъектНастройки ЕСТЬ NULL
