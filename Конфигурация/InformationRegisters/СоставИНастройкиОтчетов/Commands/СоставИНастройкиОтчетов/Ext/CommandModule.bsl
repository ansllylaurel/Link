
&НаСервере
Функция ПолучитьПараметрыФормы(ПараметрКоманды)
	
	ПараметрыФормы = Новый Структура;
	
	Если ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		Запрос = Новый Запрос;
		
		Запрос.УстановитьПараметр("ТекущаяДата",	ТекущаяДата());
		Запрос.УстановитьПараметр("Договор",		ПараметрКоманды);
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
			|ИЗ
			|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
			|			&ТекущаяДата,
			|			СчетДоверительногоУправления = &Договор) КАК КлиентыДоверительногоУправленияСрезПоследних";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ПараметрыФормы.Вставить("Клиент",	Выборка.Клиент);
			ПараметрыФормы.Вставить("Отбор",	Новый Структура("Договор", ПараметрКоманды));
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		ПараметрыФормы.Вставить("Клиент", ПараметрКоманды);
	КонецЕсли;
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ПараметрыФормы = ПолучитьПараметрыФормы(ПараметрКоманды);
	
	Если ПараметрыФормы <> Неопределено Тогда
		ОткрытьФорму("РегистрСведений.СоставИНастройкиОтчетов.Форма.Форма", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить клиента по договору доверительного управления!");
	КонецЕсли;
	
КонецПроцедуры
