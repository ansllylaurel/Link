
#Область АктивностьДоговоровПоВидамДеятельности

Функция ПолучитьАктивностьДоговоровПоВидамДеятельности(Отбор) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ПоместитьВЗапросАктивностьДоговоровПоВидамДеятельности(Запрос, Отбор);
	
	Возврат Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_АктивностьДоговоровПоВидамДеятельности").ПолучитьДанные().Выгрузить();
	
КонецФункции

Функция ПолучитьИзмененияВАктивностиДоговоровПоВидамДеятельности(Отбор, ПредыдущаяАктивностьДоговоровПоВидамДеятельности) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ПредыдущаяАктивностьДоговоровПоВидамДеятельности", ПредыдущаяАктивностьДоговоровПоВидамДеятельности);
	
	ПоместитьВЗапросАктивностьДоговоровПоВидамДеятельности(Запрос, Отбор);
	ПоместитьВЗапросИзмененияВАктивностиДоговоровПоВидамДеятельности(Запрос);
	
	Возврат Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ИзмененияВАктивностиДоговоровПоВидамДеятельности").ПолучитьДанные().Выгрузить();
	
КонецФункции

Функция ПоместитьВЗапросАктивностьДоговоровПоВидамДеятельности(Запрос, Отбор)
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДоговорыСчетовДоверительногоУправления.Период КАК Период,
		|	ДоговорыСчетовДоверительногоУправления.Организация КАК Организация,
		|	ДоговорыСчетовДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДоговорыСчетовДоверительногоУправления.Договор КАК Договор
		|ПОМЕСТИТЬ _ДоговорыСчетовДУ
		|ИЗ
		|	РегистрСведений.ДоговорыСчетовДоверительногоУправления КАК ДоговорыСчетовДоверительногоУправления
		|ГДЕ
		|	&ЭлементОтбора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДоговорыСчетовДУ.Период КАК Период,
		|	ДоговорыСчетовДУ.Организация КАК Организация,
		|	ДоговорыСчетовДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДоговорыСчетовДУ.Договор КАК Договор
		|ПОМЕСТИТЬ _ПериодыДоговоров
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ДоговорыСчетовДУ.Период КАК Период,
		|		_ДоговорыСчетовДУ.Организация КАК Организация,
		|		_ДоговорыСчетовДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		_ДоговорыСчетовДУ.Договор КАК Договор
		|	ИЗ
		|		_ДоговорыСчетовДУ КАК _ДоговорыСчетовДУ
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		ЛицензииДоговоровДоверительногоУправления.Период,
		|		_ДоговорыСчетовДУ.Организация,
		|		_ДоговорыСчетовДУ.СчетДоверительногоУправления,
		|		_ДоговорыСчетовДУ.Договор
		|	ИЗ
		|		_ДоговорыСчетовДУ КАК _ДоговорыСчетовДУ
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления КАК ЛицензииДоговоровДоверительногоУправления
		|			ПО _ДоговорыСчетовДУ.СчетДоверительногоУправления = ЛицензииДоговоровДоверительногоУправления.СчетДоверительногоУправления
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ДоговорыСчетовДУ.Организация,
		|		_ДоговорыСчетовДУ.Договор,
		|		ЛицензииДоговоровДоверительногоУправления.Период,
		|		_ДоговорыСчетовДУ.СчетДоверительногоУправления
		|	
		|	ИМЕЮЩИЕ
		|		МИНИМУМ(_ДоговорыСчетовДУ.Период) <= ЛицензииДоговоровДоверительногоУправления.Период) КАК ДоговорыСчетовДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеПериодовСЛицензиями.Период КАК Период,
		|	_ДанныеПериодовСЛицензиями.Организация КАК Организация,
		|	_ДанныеПериодовСЛицензиями.Договор КАК Договор,
		|	ЛицензииДоговоровДоверительногоУправления.Лицензия.ВидДеятельности КАК ВидДеятельности
		|ПОМЕСТИТЬ _ПериодыДоговоровСВидамиДеятельности
		|ИЗ
		|	(ВЫБРАТЬ
		|		ПериодыДоговоровДоверительногоУправления.Период КАК Период,
		|		ПериодыДоговоровДоверительногоУправления.Организация КАК Организация,
		|		ДоговорыСчетовДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		ПериодыДоговоровДоверительногоУправления.Договор КАК Договор,
		|		ЛицензииДоговоровДоверительногоУправления.Лицензия КАК Лицензия,
		|		МАКСИМУМ(ЛицензииДоговоровДоверительногоУправления.Период) КАК ПериодЛицензий
		|	ИЗ
		|		(ВЫБРАТЬ
		|			_ПериодыДоговоров.Организация КАК Организация,
		|			_ПериодыДоговоров.Договор КАК Договор,
		|			_ПериодыДоговоров.Период КАК Период,
		|			ДоговорыСчетовДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|			МАКСИМУМ(ДоговорыСчетовДоверительногоУправления.Период) КАК ПериодДоговоров
		|		ИЗ
		|			_ПериодыДоговоров КАК _ПериодыДоговоров
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления КАК ДоговорыСчетовДоверительногоУправления
		|				ПО _ПериодыДоговоров.Организация = ДоговорыСчетовДоверительногоУправления.Организация
		|					И _ПериодыДоговоров.Договор = ДоговорыСчетовДоверительногоУправления.Договор
		|					И _ПериодыДоговоров.Период >= ДоговорыСчетовДоверительногоУправления.Период
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_ПериодыДоговоров.Организация,
		|			_ПериодыДоговоров.Договор,
		|			_ПериодыДоговоров.Период,
		|			ДоговорыСчетовДоверительногоУправления.СчетДоверительногоУправления) КАК ПериодыДоговоровДоверительногоУправления
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления КАК ДоговорыСчетовДоверительногоУправления
		|			ПО ПериодыДоговоровДоверительногоУправления.Организация = ДоговорыСчетовДоверительногоУправления.Организация
		|				И ПериодыДоговоровДоверительногоУправления.Договор = ДоговорыСчетовДоверительногоУправления.Договор
		|				И ПериодыДоговоровДоверительногоУправления.СчетДоверительногоУправления = ДоговорыСчетовДоверительногоУправления.СчетДоверительногоУправления
		|				И ПериодыДоговоровДоверительногоУправления.ПериодДоговоров = ДоговорыСчетовДоверительногоУправления.Период
		|				И (ДоговорыСчетовДоверительногоУправления.Активный)
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления КАК ЛицензииДоговоровДоверительногоУправления
		|			ПО (ДоговорыСчетовДоверительногоУправления.СчетДоверительногоУправления = ЛицензииДоговоровДоверительногоУправления.СчетДоверительногоУправления)
		|				И ПериодыДоговоровДоверительногоУправления.Период >= ЛицензииДоговоровДоверительногоУправления.Период
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ПериодыДоговоровДоверительногоУправления.Организация,
		|		ПериодыДоговоровДоверительногоУправления.Договор,
		|		ПериодыДоговоровДоверительногоУправления.Период,
		|		ДоговорыСчетовДоверительногоУправления.СчетДоверительногоУправления,
		|		ЛицензииДоговоровДоверительногоУправления.Лицензия) КАК _ДанныеПериодовСЛицензиями
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления КАК ЛицензииДоговоровДоверительногоУправления
		|		ПО _ДанныеПериодовСЛицензиями.СчетДоверительногоУправления = ЛицензииДоговоровДоверительногоУправления.СчетДоверительногоУправления
		|			И _ДанныеПериодовСЛицензиями.ПериодЛицензий = ЛицензииДоговоровДоверительногоУправления.Период
		|			И _ДанныеПериодовСЛицензиями.Лицензия = ЛицензииДоговоровДоверительногоУправления.Лицензия
		|			И (ЛицензииДоговоровДоверительногоУправления.Действует)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПериодыДоговоров.Период КАК Период,
		|	_ПериодыДоговоров.Организация КАК Организация,
		|	_ПериодыДоговоров.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ПериодыДоговоров.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДУ,
		|	_ПериодыДоговоров.Договор КАК Договор,
		|	_ПериодыДоговоров.Договор.ВидДоговора КАК ВидДоговора,
		|	_ПериодыДоговоров.Договор.НомерДоговора КАК НомерДоговора,
		|	_ВидыДеятельностиДоговоров.ВидДеятельности КАК ВидДеятельности,
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия КАК Стратегия,
		|	_ПериодыДоговоровСВидамиДеятельности.ВидДеятельности ЕСТЬ НЕ NULL  КАК Активный,
		|	УсловияДоговоровДоверительногоУправленияСрезПоследних.НаименованиеЦелевогоКапитала КАК НаименованиеЦелевогоКапитала
		|ПОМЕСТИТЬ _АктивностьДоговоровПоВидамДеятельности
		|ИЗ
		|	_ПериодыДоговоров КАК _ПериодыДоговоров
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			_ПериодыДоговоровСВидамиДеятельности.Организация КАК Организация,
		|			_ПериодыДоговоровСВидамиДеятельности.Договор КАК Договор,
		|			_ПериодыДоговоровСВидамиДеятельности.ВидДеятельности КАК ВидДеятельности
		|		ИЗ
		|			_ПериодыДоговоровСВидамиДеятельности КАК _ПериодыДоговоровСВидамиДеятельности
		|		ГДЕ
		|			_ПериодыДоговоровСВидамиДеятельности.ВидДеятельности ЕСТЬ НЕ NULL ) КАК _ВидыДеятельностиДоговоров
		|		ПО _ПериодыДоговоров.Организация = _ВидыДеятельностиДоговоров.Организация
		|			И _ПериодыДоговоров.Договор = _ВидыДеятельностиДоговоров.Договор
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПериодыДоговоровСВидамиДеятельности КАК _ПериодыДоговоровСВидамиДеятельности
		|		ПО _ПериодыДоговоров.Организация = _ПериодыДоговоровСВидамиДеятельности.Организация
		|			И _ПериодыДоговоров.Договор = _ПериодыДоговоровСВидамиДеятельности.Договор
		|			И _ПериодыДоговоров.Период = _ПериодыДоговоровСВидамиДеятельности.Период
		|			И (_ВидыДеятельностиДоговоров.ВидДеятельности = _ПериодыДоговоровСВидамиДеятельности.ВидДеятельности)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(&Период, ) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
		|		ПО _ПериодыДоговоров.Организация = СтратегииИндивидуальногоИнвестированияСрезПоследних.Организация
		|			И _ПериодыДоговоров.СчетДоверительногоУправления = СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровДоверительногоУправления.СрезПоследних(&Период, ) КАК УсловияДоговоровДоверительногоУправленияСрезПоследних
		|		ПО _ПериодыДоговоров.Организация = УсловияДоговоровДоверительногоУправленияСрезПоследних.Организация
		|			И _ПериодыДоговоров.СчетДоверительногоУправления = УсловияДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления";
	
	УстановитьОтборПоДоговорам(Запрос, Отбор);
	
	Запрос.Выполнить();
	
КонецФункции

Функция ПоместитьВЗапросИзмененияВАктивностиДоговоровПоВидамДеятельности(Запрос)
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Период КАК Период,
		|	ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Организация КАК Организация,
		|	ПредыдущаяАктивностьДоговоровПоВидамДеятельности.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ПредыдущаяАктивностьДоговоровПоВидамДеятельности.ВидДоговораДУ КАК ВидДоговораДУ,
		|	ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Договор КАК Договор,
		|	ПредыдущаяАктивностьДоговоровПоВидамДеятельности.НомерДоговора КАК НомерДоговора,
		|	ПредыдущаяАктивностьДоговоровПоВидамДеятельности.ВидДеятельности КАК ВидДеятельности,
		|	ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Стратегия КАК Стратегия,
		|	ПредыдущаяАктивностьДоговоровПоВидамДеятельности.НаименованиеЦелевогоКапитала КАК НаименованиеЦелевогоКапитала,
		|	ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Активный КАК Активный
		|ПОМЕСТИТЬ _ПредыдущаяАктивностьДоговоровПоВидамДеятельности
		|ИЗ
		|	&ПредыдущаяАктивностьДоговоровПоВидамДеятельности КАК ПредыдущаяАктивностьДоговоровПоВидамДеятельности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Период, _АктивностьДоговоровПоВидамДеятельности.Период) КАК Период,
		|	ЕСТЬNULL(_ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Организация, _АктивностьДоговоровПоВидамДеятельности.Организация) КАК Организация,
		|	ЕСТЬNULL(_ПредыдущаяАктивностьДоговоровПоВидамДеятельности.СчетДоверительногоУправления, _АктивностьДоговоровПоВидамДеятельности.СчетДоверительногоУправления) КАК СчетДоверительногоУправления,
		|	ЕСТЬNULL(_ПредыдущаяАктивностьДоговоровПоВидамДеятельности.ВидДоговораДУ, _АктивностьДоговоровПоВидамДеятельности.ВидДоговораДУ) КАК ВидДоговораДУ,
		|	ЕСТЬNULL(_ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Договор, _АктивностьДоговоровПоВидамДеятельности.Договор) КАК Договор,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Договор, _АктивностьДоговоровПоВидамДеятельности.Договор) ССЫЛКА Справочник.ДоговорыБрокерскогоОбслуживания
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.БрокерскогоОбслуживания)
		|		КОГДА ЕСТЬNULL(_ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Договор, _АктивностьДоговоровПоВидамДеятельности.Договор) ССЫЛКА Справочник.Договоры
		|			ТОГДА ВЫРАЗИТЬ(ЕСТЬNULL(_ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Договор, _АктивностьДоговоровПоВидамДеятельности.Договор) КАК Справочник.Договоры).ВидДоговора
		|	КОНЕЦ КАК ВидДоговора,
		|	ЕСТЬNULL(_ПредыдущаяАктивностьДоговоровПоВидамДеятельности.НомерДоговора, _АктивностьДоговоровПоВидамДеятельности.НомерДоговора) КАК НомерДоговора,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Договор, _АктивностьДоговоровПоВидамДеятельности.Договор) ССЫЛКА Справочник.ДоговорыБрокерскогоОбслуживания
		|			ТОГДА ВЫРАЗИТЬ(ЕСТЬNULL(_ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Договор, _АктивностьДоговоровПоВидамДеятельности.Договор) КАК Справочник.ДоговорыБрокерскогоОбслуживания).Контрагент
		|		КОГДА ЕСТЬNULL(_ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Договор, _АктивностьДоговоровПоВидамДеятельности.Договор) ССЫЛКА Справочник.Договоры
		|			ТОГДА ВЫРАЗИТЬ(ЕСТЬNULL(_ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Договор, _АктивностьДоговоровПоВидамДеятельности.Договор) КАК Справочник.Договоры).Контрагент
		|	КОНЕЦ КАК Контрагент,
		|	ЕСТЬNULL(_ПредыдущаяАктивностьДоговоровПоВидамДеятельности.ВидДеятельности, _АктивностьДоговоровПоВидамДеятельности.ВидДеятельности) КАК ВидДеятельности,
		|	_ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Активный ЕСТЬ NULL КАК НоваяСвязь,
		|	ЕСТЬNULL(_ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Стратегия, _АктивностьДоговоровПоВидамДеятельности.Стратегия) КАК Стратегия,
		|	ЕСТЬNULL(_ПредыдущаяАктивностьДоговоровПоВидамДеятельности.НаименованиеЦелевогоКапитала, _АктивностьДоговоровПоВидамДеятельности.НаименованиеЦелевогоКапитала) КАК НаименованиеЦелевогоКапитала,
		|	ЕСТЬNULL(_ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Активный, _АктивностьДоговоровПоВидамДеятельности.Активный) КАК Активный
		|ПОМЕСТИТЬ _ИзмененияВАктивностиДоговоровПоВидамДеятельности
		|ИЗ
		|	_АктивностьДоговоровПоВидамДеятельности КАК _АктивностьДоговоровПоВидамДеятельности
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ПредыдущаяАктивностьДоговоровПоВидамДеятельности КАК _ПредыдущаяАктивностьДоговоровПоВидамДеятельности
		|		ПО _АктивностьДоговоровПоВидамДеятельности.Организация = _ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Организация
		|			И _АктивностьДоговоровПоВидамДеятельности.Договор = _ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Договор
		|			И _АктивностьДоговоровПоВидамДеятельности.Период = _ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Период
		|			И _АктивностьДоговоровПоВидамДеятельности.ВидДеятельности = _ПредыдущаяАктивностьДоговоровПоВидамДеятельности.ВидДеятельности
		|			И _АктивностьДоговоровПоВидамДеятельности.Активный = _ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Активный
		|ГДЕ
		|	(_ПредыдущаяАктивностьДоговоровПоВидамДеятельности.Активный ЕСТЬ NULL
		|			ИЛИ _АктивностьДоговоровПоВидамДеятельности.Активный ЕСТЬ NULL)";
	
	Запрос.Выполнить();
	
КонецФункции

Процедура УстановитьОтборПоДоговорам(Запрос, Отбор)
	
	Запрос.УстановитьПараметр("ЭлементОтбора", Истина);
	
	//Значение периода по умолчанию
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	
	Для Каждого ЭлементОтбора Из Отбор Цикл
		Если ЭлементОтбора.Имя <> "Период"
			И ЭлементОтбора.Имя <> "Лицензия"
			И ЭлементОтбора.Использование Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЭлементОтбора", "&ЭлементОтбора" + "
				|	И " + ЭлементОтбора.Имя + " В (&" + ЭлементОтбора.Имя + ")");
			Запрос.УстановитьПараметр(ЭлементОтбора.Имя, ЭлементОтбора.Значение);
		ИначеЕсли ЭлементОтбора.Имя = "Период" 
			И ЭлементОтбора.Использование Тогда
			Запрос.УстановитьПараметр(ЭлементОтбора.Имя, ЭлементОтбора.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
	
#КонецОбласти

Процедура ДобавитьСвязьДоговораИСчетаДоверительногоУправления(Период, Договор, СчетДоверительногоУправления, Отказ) Экспорт
	
	ДоговорыСчетовДУ = РегистрыСведений.ДоговорыСчетовДоверительногоУправления.СоздатьМенеджерЗаписи();
	ДоговорыСчетовДУ.Период							= Период; 
	ДоговорыСчетовДУ.СчетДоверительногоУправления	= СчетДоверительногоУправления;
	ДоговорыСчетовДУ.Договор						= Договор.Ссылка;
	ДоговорыСчетовДУ.Активный						= Истина;
	
	Попытка
		ДоговорыСчетовДУ.Записать();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка добавления связи договора со счетом в/у. Система сообщает: " + ОписаниеОшибки(), Договор.Ссылка,,, Отказ);
	КонецПопытки;
	
КонецПроцедуры

Функция ЕстьСвязьДоговораСоСчетомДоверительногоУправления(Период, Договор, Организация, СчетДоверительногоУправления) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.Активный КАК Активный
		|ИЗ
		|	РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
		|			&Период,
		|			Договор = &Договор
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних"); 
	
	Запрос.УстановитьПараметр("Период",							Период);
	Запрос.УстановитьПараметр("Договор",						Договор);
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Активный;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции
