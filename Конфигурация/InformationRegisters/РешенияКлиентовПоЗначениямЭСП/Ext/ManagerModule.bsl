
Функция ПолучитьПоПартии(ЦеннаяБумага, Партия, СтрокаПартии, Период) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(РешенияКлиентовПоЗначениямЭСПСрезПоследних.ДатаНачалаДействия) КАК ДатаНачалаДействия
		|ПОМЕСТИТЬ ПоследняяДействующая
		|ИЗ
		|	РегистрСведений.РешенияКлиентовПоЗначениямЭСП.СрезПоследних(
		|			&Период,
		|			Партия = &Партия
		|				И СтрокаПартии = &СтрокаПартии
		|				И ЦеннаяБумага = &ЦеннаяБумага
		|				И ДатаНачалаДействия <= &Период) КАК РешенияКлиентовПоЗначениямЭСПСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.ЭСП КАК ЭСП,
		|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.Используется КАК Используется
		|ИЗ
		|	РегистрСведений.РешенияКлиентовПоЗначениямЭСП.СрезПоследних(
		|			&Период,
		|			ЦеннаяБумага = &ЦеннаяБумага
		|				И Партия = &Партия
		|				И СтрокаПартии = &СтрокаПартии
		|				И ДатаНачалаДействия В
		|					(ВЫБРАТЬ
		|						ПоследняяДействующая.ДатаНачалаДействия
		|					ИЗ
		|						ПоследняяДействующая)) КАК РешенияКлиентовПоЗначениямЭСПСрезПоследних");
	
	Запрос.УстановитьПараметр("Период",			Период);
	Запрос.УстановитьПараметр("Партия",			Партия);
	Запрос.УстановитьПараметр("СтрокаПартии",	СтрокаПартии);
	Запрос.УстановитьПараметр("ЦеннаяБумага",	ЦеннаяБумага);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Если Не ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Новый Структура("Используется, ЭСП", ВыборкаДетальныеЗаписи.Используется, ВыборкаДетальныеЗаписи.ЭСП);
	
КонецФункции

Функция ПолучитьПоСчету(Период, Организация, СчетДоверительногоУправления) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.Партия КАК Партия,
		|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.СтрокаПартии КАК СтрокаПартии,
		|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.ДатаНачалаДействия КАК ДатаНачалаДействия,
		|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.ЭСП КАК ЭСП,
		|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.Используется КАК Используется
		|ПОМЕСТИТЬ _ВсеРешения
		|ИЗ
		|	РегистрСведений.РешенияКлиентовПоЗначениямЭСП.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ДатаНачалаДействия <= &Период) КАК РешенияКлиентовПоЗначениямЭСПСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеРешения.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ВсеРешения.Партия КАК Партия,
		|	_ВсеРешения.СтрокаПартии КАК СтрокаПартии,
		|	МАКСИМУМ(_ВсеРешения.ДатаНачалаДействия) КАК ДатаНачалаДействия
		|ПОМЕСТИТЬ _РешенияМаксДата
		|ИЗ
		|	_ВсеРешения КАК _ВсеРешения
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВсеРешения.ЦеннаяБумага,
		|	_ВсеРешения.Партия,
		|	_ВсеРешения.СтрокаПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РешенияМаксДата.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_РешенияМаксДата.Партия КАК Партия,
		|	_РешенияМаксДата.СтрокаПартии КАК СтрокаПартии,
		|	_ВсеРешения.ЭСП КАК ЭСП,
		|	_ВсеРешения.Используется КАК Используется
		|ИЗ
		|	_РешенияМаксДата КАК _РешенияМаксДата
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеРешения КАК _ВсеРешения
		|		ПО _РешенияМаксДата.ЦеннаяБумага = _ВсеРешения.ЦеннаяБумага
		|			И _РешенияМаксДата.Партия = _ВсеРешения.Партия
		|			И _РешенияМаксДата.СтрокаПартии = _ВсеРешения.СтрокаПартии
		|			И _РешенияМаксДата.ДатаНачалаДействия = _ВсеРешения.ДатаНачалаДействия");
	
	Запрос.УстановитьПараметр("Период",							Период);
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
