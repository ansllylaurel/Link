
&НаКлиенте
Процедура НастройкаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Запись.Настройка) И (Не ЗначениеЗаполнено(ЭтаФорма.ТекущаяНастройка)
		Или Вопрос("Заполнить применимость настройки значениями по умолчанию?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да) Тогда
		ЗаполнитьПрименение();
	КонецЕсли; 
	ТекущаяНастройка = Запись.Настройка;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПрименение()

	ЗаполнитьЗначенияСвойств(Запись, Запись.Настройка, "НастройкаОтчета, НастройкаКлиента, НастройкаВидаДоговора, НастройкаСчетаДоверительногоУправления, НастройкаПакета");
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Настройка = Неопределено;
	Если Параметры.Ключ.Пустой() И Параметры.ЗначенияЗаполнения.Свойство("Настройка", Настройка) Тогда
		ЗаполнитьПрименение();
	КонецЕсли; 
	
	// Проверяем, чтобы настройки были только для группы верхнего уровня	
	
	Если ЗначениеЗаполнено(Запись.Отчет)
		И Запись.Отчет.ЭтоГруппа 
		И ЗначениеЗаполнено(Запись.Отчет.Родитель) 
	Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Настройки могут быть заданы только для группы отчетов верхнего уровня", , , , Отказ);		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ПараметрыОпопвещения = Новый Структура("Отчет, НастройкаОтчета, НастройкаКлиента, НастройкаВидаДоговора, НастройкаСчетаДоверительногоУправления, НастройкаПакета");
	ЗаполнитьЗначенияСвойств(ПараметрыОпопвещения, Запись);
	Оповестить("ЗаписанаДоступнаяНастройка", ПараметрыОпопвещения);
КонецПроцедуры
 
