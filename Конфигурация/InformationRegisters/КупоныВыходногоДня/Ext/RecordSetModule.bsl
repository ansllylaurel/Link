Процедура ПередЗаписью(Отказ, Замещение)
	// Блокирующие проверки
	УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Автоматическое дозаполнение полей
	НоваяДатаЗагрузки = ТекущаяДата();
	НовыйОтветственный = РаботаСПользователями.ТекущийПользователь();
	Для Каждого Запись Из ЭтотОбъект Цикл
		Запись.ДатаЗагрузки = НоваяДатаЗагрузки;
		Запись.Ответственный = НовыйОтветственный;
	КонецЦикла;
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	Если ЭтотОбъект.Количество() > 0 Тогда
		Если ЭтотОбъект.Отбор.Найти("Период") = Неопределено Тогда // Это защита от внутреннего Гитлера
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку("Кто-то записывает купоны выходного дня с неустановленным отбором по периоду!", "Купоны выходного дня");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
