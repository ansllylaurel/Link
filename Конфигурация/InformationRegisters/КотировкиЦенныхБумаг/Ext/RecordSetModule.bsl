
////////////////////////////////////////////////////////////////////////////////
// ПРЕДОПРЕДЕЛЕННЫЕ

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("ОбработкаПроверкиЗаполненияОтказ", Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, Замещение)
	
	// блокирующие проверки
	УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// автоматическое дозаполнение полей
	НовДатаЗагрузки  = ТекущаяДата();
	НовОтветственный = РаботаСПользователями.ТекущийПользователь();
	
	Для каждого Запись Из ЭтотОбъект Цикл
		Запись.ДатаЗагрузки  = НовДатаЗагрузки;
		Запись.Ответственный = НовОтветственный;
	КонецЦикла;

КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("НеВыполнятьРасчетСводныхКотировок")
		Или (ЭтотОбъект.ДополнительныеСвойства.Свойство("НеВыполнятьРасчетСводныхКотировок") И ЭтотОбъект.ДополнительныеСвойства.НеВыполнятьРасчетСводныхКотировок <> Истина)
	Тогда
		РаботаСЦеннымиБумагами.РассчитатьСводныеКотировки("КотировкиЦенныхБумаг", ЭтотОбъект.Отбор, Отказ);
	КонецЕсли;
	
	Если ЭтотОбъект.Количество() > 0 Тогда
		
		Если ЭтотОбъект.Отбор.Найти("Период") = Неопределено Тогда // это защита от внутреннего Гитлера
		
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку("Кто-то записывает котировки ценных бумаг с неустановленным отбором по периоду!", "Котировки ценных бумаг");
			
		ИначеЕсли НачалоДня(КонецМесяца(ЭтотОбъект.Отбор.Период.Значение)) = ЭтотОбъект.Отбор.Период.Значение // это конец месяца
				И Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ЭтотОбъект.Отбор.Период.Значение) <> ЭтотОбъект.Отбор.Период.Значение Тогда // и не рабочий день
			
			ОбработкаПроверкиНКД = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта("_ПроверкаРасчетногоНКД");
			
			ПараметрыЗадания = Новый Структура("ДатаНачала, ДатаОкончания, ПроверятьКотировкиЦенныхБумаг", ЭтотОбъект.Отбор.Период.Значение, ЭтотОбъект.Отбор.Период.Значение, Истина);
			
			Если ЭтотОбъект.Отбор.Найти("ЦеннаяБумага") <> Неопределено Тогда
				ПараметрыЗадания.Вставить("ЦеннаяБумага", ЭтотОбъект.Отбор.ЦеннаяБумага.Значение);
			КонецЕсли;
			
			Если ЭтотОбъект.Отбор.Найти("Биржа") = Неопределено ИЛИ ЭтотОбъект.Отбор.Биржа.Значение = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ") Тогда // или нет отбора по бирже, или ММВБ
				
				ПараметрыЗадания.Вставить("Биржа", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
				РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание(ОбработкаПроверкиНКД, "ПроверитьРасчетныйНКД", ПараметрыЗадания,,, ТекущаяДата() + 5 * 60);
				
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры
