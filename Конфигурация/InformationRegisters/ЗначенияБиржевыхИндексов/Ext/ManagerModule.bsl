
Функция ПолучитьСтруктуруТаблицыИндексов() Экспорт
	
	ЗначенияИндексов = Новый ТаблицаЗначений;
	ЗначенияИндексов.Колонки.Добавить("Период",		Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ЗначенияИндексов.Колонки.Добавить("SECID",		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(30)));
	ЗначенияИндексов.Колонки.Добавить("SHORTNAME",	Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ЗначенияИндексов.Колонки.Добавить("NAME", 		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	ЗначенияИндексов.Колонки.Добавить("CURRENCYID",	Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(5)));
	ЗначенияИндексов.Колонки.Добавить("Индекс", 	Новый ОписаниеТипов("СправочникСсылка.БиржевыеИндексы"));	
	
	Для каждого РесурсМетаданных Из Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы Цикл
		ЗначенияИндексов.Колонки.Добавить(РесурсМетаданных.Имя, РесурсМетаданных.Тип);
	КонецЦикла;
	
	Возврат ЗначенияИндексов;
	
КонецФункции // ПолучитьСтруктуруТаблицыИндексов