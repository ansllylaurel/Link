
Функция БазыРасчетаПлановойДоходности() Экспорт
	
	БазыРасчета = Новый Массив;
	БазыРасчета.Добавить(Справочники.БазыРасчета.СредняяРыночнаяСтоимостьИмуществаПринятогоВДоверительноеУправлениеЗаВычетомВыведенного);
	БазыРасчета.Добавить(Справочники.БазыРасчета.ПревышениеНадМинимальнымДоходом);
	БазыРасчета.Добавить(Справочники.БазыРасчета.ИнвестиционныйДоход);
	
	Возврат БазыРасчета;
	
КонецФункции

Функция ПолучитьКлючНастроекРасчетаВознагражденияПоОснованию(Основание) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	НастройкиРасчета.*
		|ИЗ
		|	РегистрСведений.НастройкиРасчетаВознагражденияУправляющего КАК НастройкиРасчета
		|ГДЕ
		|	НастройкиРасчета.Основание = &Основание");
	
	Запрос.УстановитьПараметр("Основание", Основание);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		КлючНастроек = Неопределено;
		
	Иначе
		
		ОтборНастроек = РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(РезультатЗапроса.Выгрузить()[0]);
		
		КлючНастроек = РегистрыСведений.НастройкиРасчетаВознагражденияУправляющего.СоздатьКлючЗаписи(ОтборНастроек);
		
	КонецЕсли;
	
	Возврат КлючНастроек;
	
КонецФункции