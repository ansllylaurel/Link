
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма, "Запись", "ИсходныйКлючЗаписи", Отказ) Тогда
		Возврат;
	КонецЕсли;

	Если Параметры.Ключ.Пустой()
		И Параметры.ЗначениеКопирования.Пустой()
		И Не (Параметры.ЗначенияЗаполнения.Свойство("Организация") И ЗначениеЗаполнено(Параметры.ЗначенияЗаполнения.Организация))
	Тогда
		Запись.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();	
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)

	Если ЭтаФорма.ВыводитьАкт И Не ЗначениеЗаполнено(Запись.ШаблонАкта) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан шаблон акта об оказанных услугах", , "Запись.ШаблонАкта", , Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидВознагражденияПриИзменении(Элемент)
	
	УстановитьПараметрыВыбораНастроекРасчета(ЭтаФорма);
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыводитьАктПриИзменении(Элемент)

	Если Не ЭтаФорма.ВыводитьАкт Тогда
		Запись.ШаблонАкта = Неопределено;
	КонецЕсли;
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ЭтаФорма.ВыводитьАкт = ЗначениеЗаполнено(Запись.ШаблонАкта);	
	
	УстановитьПараметрыВыбораНастроекРасчета(ЭтаФорма);
	
	НастроитьВидимостьДоступность(ЭтаФорма);	
	
КонецПроцедуры
	
&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступность(Форма)
	
	Запись	 = Форма.Запись;
	Элементы = Форма.Элементы;
	
	ЭтоВознаграждениеУправляющего = (Запись.ВидВознаграждения = ПредопределенноеЗначение("Перечисление.ВидыВознагражденийУправляющего.ВознаграждениеУправляющего"));
	
	Элементы.Основание.Видимость							= ЭтоВознаграждениеУправляющего;
	
	// Настроек расшифровки расчета
	
	Элементы.ГруппаНастройкиРасшифровкиРасчета.Видимость	= ЭтоВознаграждениеУправляющего;
	Элементы.ШаблонРасшифровки.Видимость					= ЭтоВознаграждениеУправляющего;
	Элементы.ШаблонРасшифровки.АвтоОтметкаНезаполненного	= ЭтоВознаграждениеУправляющего;
	
	Элементы.ГруппаАкт.Видимость							= ЭтоВознаграждениеУправляющего;
	Элементы.ВыводитьАкт.Видимость							= ЭтоВознаграждениеУправляющего;
	Элементы.ШаблонАкта.Видимость							= ЭтоВознаграждениеУправляющего;
	Элементы.ШаблонАкта.АвтоОтметкаНезаполненного			= Форма.ВыводитьАкт;
	Элементы.ШаблонАкта.Доступность							= Форма.ВыводитьАкт;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПараметрыВыбораНастроекРасчета(Форма)
	
	Запись	 = Форма.Запись;
	Элементы = Форма.Элементы;
	
	НовыеПараметрыВыбора = Новый Массив;
	
	Для Каждого ПараметрВыбора Из Элементы.НастройкаРасчета.ПараметрыВыбора Цикл
		Если ПараметрВыбора.Имя <> "Отбор.Ссылка" Тогда
			НовыеПараметрыВыбора.Добавить(ПараметрВыбора);
		КонецЕсли;
	КонецЦикла;
	
	Если Запись.ВидВознаграждения = ПредопределенноеЗначение("Перечисление.ВидыВознагражденийУправляющего.ПлановоеВознаграждениеУправляющего") Тогда
		МассивНастроек = НастройкаРасчетаПлановойДоходности();
		
		Если МассивНастроек.Количество() > 0 Тогда
			НовыеПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", Новый ФиксированныйМассив(МассивНастроек)));
		КонецЕсли;
	КонецЕсли;
	
	Элементы.НастройкаРасчета.ПараметрыВыбора = Новый ФиксированныйМассив(НовыеПараметрыВыбора);	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НастройкаРасчетаПлановойДоходности()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НастройкиРасчета.Ссылка КАК НастройкаРасчета
		|ИЗ
		|	Справочник.НастройкиРасчета КАК НастройкиРасчета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			НастройкиРасчетаСоставляющие.Ссылка КАК Ссылка,
		|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ НастройкиРасчетаСоставляющие.НомерСтроки) КАК НомерСтроки
		|		ИЗ
		|			Справочник.НастройкиРасчета.Составляющие КАК НастройкиРасчетаСоставляющие
		|		
		|		СГРУППИРОВАТЬ ПО
		|			НастройкиРасчетаСоставляющие.Ссылка) КАК КоличествоСтрок
		|		ПО НастройкиРасчета.Ссылка = КоличествоСтрок.Ссылка
		|			И (КоличествоСтрок.НомерСтроки = 1)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			НастройкиРасчетаСоставляющие.Ссылка КАК Ссылка
		|		ИЗ
		|			Справочник.НастройкиРасчета.Составляющие КАК НастройкиРасчетаСоставляющие
		|		ГДЕ
		|			НастройкиРасчетаСоставляющие.БазаРасчета В (&БазыРасчетаПлановойДоходности)) КАК ФильтрПоБазеРасчета
		|		ПО НастройкиРасчета.Ссылка = ФильтрПоБазеРасчета.Ссылка";
	
	Запрос.УстановитьПараметр("БазыРасчетаПлановойДоходности", РегистрыСведений.НастройкиРасчетаВознагражденияУправляющего.БазыРасчетаПлановойДоходности());
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("НастройкаРасчета");
	
КонецФункции
