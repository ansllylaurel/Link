
&НаКлиенте
Процедура ЦельРасчетаПриИзменении(Элемент)
	
	Если Запись.ЦельРасчета = ПредопределенноеЗначение("Справочник.ЦелиРасчета.БухгалтерскийУчет") Тогда
		Запись.ВидУчетаДляОстатковПартий = ПредопределенноеЗначение("Перечисление.ВидыУчета.БухгалтерскийУчет");
	ИначеЕсли Запись.ЦельРасчета = ПредопределенноеЗначение("Справочник.ЦелиРасчета.ЕдиныйПланСчетов") Тогда
		Запись.ВидУчетаДляОстатковПартий = ПредопределенноеЗначение("Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет");
	ИначеЕсли Запись.ЦельРасчета = ПредопределенноеЗначение("Справочник.ЦелиРасчета.НалоговыйУчет") Тогда
		Запись.ВидУчетаДляОстатковПартий = ПредопределенноеЗначение("Перечисление.ВидыУчета.НалоговыйУчет");
	КонецЕсли;
	
	НастроитьДоступностьВидаУчета();		
		
КонецПроцедуры

&НаКлиенте
Процедура НастроитьДоступностьВидаУчета()
	
	ВидУчетаНедоступен = (Запись.ЦельРасчета = ПредопределенноеЗначение("Справочник.ЦелиРасчета.БухгалтерскийУчет"))
					ИЛИ (Запись.ЦельРасчета = ПредопределенноеЗначение("Справочник.ЦелиРасчета.ЕдиныйПланСчетов")) 
					ИЛИ (Запись.ЦельРасчета = ПредопределенноеЗначение("Справочник.ЦелиРасчета.НалоговыйУчет"));
					
	Элементы.ВидУчетаДляОстатковПартий.ТолькоПросмотр = ВидУчетаНедоступен;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастроитьДоступностьВидаУчета();
	
КонецПроцедуры
