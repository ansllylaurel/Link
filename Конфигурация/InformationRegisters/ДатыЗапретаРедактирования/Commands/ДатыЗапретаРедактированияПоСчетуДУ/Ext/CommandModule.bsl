
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрКоманды, "Организация"));
	ПараметрыФормы.Вставить("СчетДоверительногоУправления", ПараметрКоманды);
	ПараметрыФормы.Вставить("ЭтоФормаСчетаДУ", Истина);

	ОткрытьФорму("РегистрСведений.ДатыЗапретаРедактирования.Форма.НастройкиДатЗапрета", 
		ПараметрыФормы, 
		ПараметрыВыполненияКоманды.Источник, 
		ПараметрыВыполненияКоманды.Уникальность, 
		ПараметрыВыполненияКоманды.Окно, 
		ПараметрыВыполненияКоманды.НавигационнаяСсылка);
	
КонецПроцедуры