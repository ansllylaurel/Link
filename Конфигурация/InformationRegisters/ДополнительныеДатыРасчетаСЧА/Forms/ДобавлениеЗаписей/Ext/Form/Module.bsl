#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Организация 	= ЭтаФорма.Параметры.Организация;
	ДатаРасчетаСЧА 	= ЭтаФорма.Параметры.ДатаСЧА;
	
	// Для Траста по умолчанию добавляем клиентов группы Будущее со снятыми флажками
	Если Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ") Тогда
		
		КлиентыГруппы = Кэширование.КлиентыГруппыБудущее();
		Для Каждого КлиентГруппы Из КлиентыГруппы Цикл			
			НоваяСтрока = Клиенты.Добавить();
			НоваяСтрока.Клиент = КлиентГруппы;        			
		КонецЦикла;	
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ДатаРасчетаСЧА) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбран рабочий день!",, "ДатаРасчетаСЧА",, Отказ);
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти 

#Область События_элементов_формы

&НаКлиенте
Процедура ДатаРасчетаСЧАПриИзменении(Элемент)
	
	ПриИзмененииКлючевыхПараметров();
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентыЗначениеПриИзменении(Элемент)
	
	ПриИзмененииКлючевыхПараметров();

КонецПроцедуры

&НаКлиенте
Процедура ВидыДоговоровЗначениеПриИзменении(Элемент)
	
	ПриИзмененииКлючевыхПараметров();
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентыКлиентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуВыбораКлиентов();	
			
КонецПроцедуры

&НаКлиенте
Процедура КлиентыФлажокПриИзменении(Элемент)
	
	ПриИзмененииКлючевыхПараметров();
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		СтрокаКлиенты = ?(Элемент.ТекущиеДанные <> Неопределено И Элемент.ТекущиеДанные.Клиент = Неопределено, Элемент.ТекущиеДанные, Клиенты.Добавить());
		СтрокаКлиенты.Клиент = ВыбранноеЗначение;
		СтрокаКлиенты.Флажок = Истина;
		ПриИзмененииКлючевыхПараметров();
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти 

#Область Команды_формы

&НаКлиенте
Процедура КомандаЗаписатьИЗакрыть(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
		
	Отказ = Ложь;
	ЕстьНовыеЗаписи = ЗаписатьНаСервере(Отказ);
	
	Если Не Отказ Тогда	
		ЭтаФорма.Закрыть(ЕстьНовыеЗаписи);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнить(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьнаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьВсеФлажки(Команда)
	
	ИзменитьВсеФлажкиСчетовДУ(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьВсеФлажки(Команда)
	
	ИзменитьВсеФлажкиСчетовДУ(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПодборКлиентов(Команда)
	
	ОткрытьФормуВыбораКлиентов(Истина);		
	
КонецПроцедуры

#КонецОбласти

#Область Прочие_процедуры_и_функции

&НаКлиенте
Процедура ИзменитьВсеФлажкиСчетовДУ(Флажок)

	ТаблицаСчетовДУ = ЭтаФорма.СчетаДоверительногоУправления;
	            
	Для Каждого Элемент Из ТаблицаСчетовДУ Цикл
		Элемент.Флажок = Флажок;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЗаписатьНаСервере(Отказ)
	
	СтрокиСчетовДУДляЗаписи = ЭтаФорма.СчетаДоверительногоУправления.НайтиСтроки(Новый Структура("Флажок", Истина));
	Если СтрокиСчетовДУДляЗаписи.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны счета доверительного управления для записи даты расчета СЧА",,,, Отказ);		
		Возврат Ложь;
	КонецЕсли;

	СписокСчетовДУ = Новый СписокЗначений;		
	Для каждого СтрокаСчетаДУ Из СтрокиСчетовДУДляЗаписи Цикл
		СписокСчетовДУ.Добавить(СтрокаСчетаДУ.СчетДоверительногоУправления,, Истина);
	КонецЦикла;

	ЗаписатьДанныеВРегистр(СписокСчетовДУ, Организация, ДатаРасчетаСЧА, Отказ);
	
	//Снимаем флажки с обработанных
	Для Каждого СтрокаОбработанногоСчетаДУ Из СписокСчетовДУ Цикл
		
		Если Не СтрокаОбработанногоСчетаДУ.Пометка Тогда		
			СтрокиСчетаДУ = ЭтаФорма.СчетаДоверительногоУправления.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", СтрокаОбработанногоСчетаДУ.Значение));  		
			СтрокиСчетаДУ[0].Флажок = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьДанныеВРегистр(СписокСчетовДУ, Организация, ДатаРасчетаСЧА, Отказ)

	СтруктураЗаполнения = Новый Структура("Организация, ДатаСЧА", Организация, ДатаРасчетаСЧА);
	
	Для Каждого СтрокаСчетаДУ Из СписокСчетовДУ Цикл
		
		МенеджерЗаписи = РегистрыСведений.ДополнительныеДатыРасчетаСЧА.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтруктураЗаполнения);
		
		МенеджерЗаписи.СчетДоверительногоУправления = СтрокаСчетаДУ.Значение;
						
		Попытка
			МенеджерЗаписи.Записать(Истина);
			СтрокаСчетаДУ.Пометка = Ложь;
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не зарегистрирована дата для '" + СокрЛП(СтрокаСчетаДУ.Значение) + "'", СтрокаСчетаДУ.Значение,,, Отказ);
		КонецПопытки;
				
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СтруктураОтбораНаСервере()
	
	ЭлементыОтбора = Новый Структура;			
	ЭлементыОтбора.Вставить("Клиенты", 			"Клиент");
	ЭлементыОтбора.Вставить("ВидыДоговоров", 	"ВидДоговораДоверительногоУправления");
		
	Результат = Новый Структура("Организация", Организация);
	
	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		
		Если ЗначениеЗаполнено(ЭтаФорма[ЭлементОтбора.Ключ]) Тогда
			
			Если ЭлементОтбора.Ключ = "Клиенты" Тогда
				
				КлиентыСОтметкой = ЭтаФорма.Клиенты.НайтиСтроки(Новый Структура("Флажок", Истина));
				МассивКлиентов = Новый Массив;
				Для Каждого СтрокаКлиента Из КлиентыСОтметкой Цикл
					МассивКлиентов.Добавить(СтрокаКлиента.Клиент);	
				КонецЦикла;
				
				Результат.Вставить(ЭлементОтбора.Значение, МассивКлиентов);
				
			Иначе			
				Результат.Вставить(ЭлементОтбора.Значение, ЭтаФорма[ЭлементОтбора.Ключ]);
			КонецЕсли;
			
		КонецЕсли; 		
		
	КонецЦикла;
		
	// Исключаем НЕОПРЕДЕЛЕН
	ИсключаемыеСчетаДУ = Новый Массив;
	ИсключаемыеСчетаДУ.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Неопределен_РЭМ"));
	ИсключаемыеСчетаДУ.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Неопределен_Траст"));
	
	Результат.Вставить("ИсключаяСчетаДУ", ИсключаемыеСчетаДУ);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьнаСервере()
	
	Отбор = СтруктураОтбораНаСервере();
	
	Если Не Отбор.Свойство("Клиент") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указаны клиенты");
		Возврат;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Справочники.СчетаДоверительногоУправления.СчетаДоверительногоУправленияНаДатуСАктивами(ДатаРасчетаСЧА, Отбор, Истина, "_ДействующиеСчетаДоверительногоУправления", Запрос.МенеджерВременныхТаблиц);
		
	Справочники.НастройкиРегламентныхДействий.ПоместитьДатыДействияЗаПериодВоВременнуюТаблицу(Запрос, Новый Структура("ВидДействия, ДатаС, ДатаПо, ДополнитьРабочимиДнями, ИмяТаблицыСчетовДУ", "СЧА", ДатаРасчетаСЧА, ДатаРасчетаСЧА, Истина, "_ДействующиеСчетаДоверительногоУправления"));
	
	Запрос.Текст = 	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДействующиеСчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ИСТИНА КАК Флажок
		|ИЗ
		|	_ДействующиеСчетаДоверительногоУправления КАК _ДействующиеСчетаДоверительногоУправления
		|ГДЕ
		|	НЕ _ДействующиеСчетаДоверительногоУправления.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_ДатыДействияЗаПериод.СчетДоверительногоУправления
		|				ИЗ
		|					_ДатыДействияЗаПериод КАК _ДатыДействияЗаПериод)";
	
	СчетаДоверительногоУправления.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииКлючевыхПараметров()
	
	Если СчетаДоверительногоУправления.Количество() > 0 Тогда
		СчетаДоверительногоУправления.Очистить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораКлиентов(ОткрытьДляПодбора = Ложь)
	
	СписокТипов = Новый СписокЗначений;
	СписокТипов.Добавить(Тип("СправочникСсылка.ЮрФизЛица"));
	СписокТипов.Добавить(Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды"));
	
	ВыбранныйТип = ?(ОткрытьДляПодбора, СписокТипов.ВыбратьЭлемент("Укажите тип клиента"), ВыбратьИзСписка(СписокТипов, Элементы.КлиентыКлиент));
	
	ПараметрыФормы = Новый Структура;
	Если ВыбранныйТип = Неопределено Тогда
		Возврат;
	ИначеЕсли ВыбранныйТип.Значение = Тип("СправочникСсылка.ЮрФизЛица") Тогда
		ПараметрыФормы.Вставить("ОтображатьТолькоКлиентов", Истина);
		ФормаВыбора = "Справочник.ЮрФизЛица.Форма.ФормаВыбора";
	Иначе
		ФормаВыбора = "Справочник.ПаевыеИнвестиционныеФонды.Форма.ФормаВыбора";
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Не ОткрытьДляПодбора);    
	
	ОткрытьФормуМодально(ФормаВыбора, ПараметрыФормы, Элементы.Клиенты);
	
КонецПроцедуры

#КонецОбласти