   
Функция ПараметрыРасчетаНадбавокИСкидок(ПаевойИнвестиционныйФонд, Дата) Экспорт 
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.ПрименяютсяНадбавкиИСкидкиПриЗачисленииИПогашенииПаев КАК ПрименяютсяНадбавкиИСкидки,
		|	УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.НастройкаРасчетаНадбавкиПриПриобретенииПаев КАК НастройкаРасчетаНадбавки,
		|	УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.НастройкаРасчетаСкидкиПриПогашенииПаев КАК НастройкаРасчетаСкидки
		|ИЗ
		|	РегистрСведений.УсловияПравилПаевогоИнвестиционногоФонда.СрезПоследних(&Дата, ПаевойИнвестиционныйФонд = &ПаевойИнвестиционныйФонд) КАК УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних");
		
	Запрос.УстановитьПараметр("Дата",						Дата);
	Запрос.УстановитьПараметр("ПаевойИнвестиционныйФонд",	ПаевойИнвестиционныйФонд);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Структура;
	Если Выборка.Следующий() Тогда		
		
		Результат.Вставить("ПрименяютсяНадбавкиИСкидки", Выборка.ПрименяютсяНадбавкиИСкидки);
		
		Если Выборка.ПрименяютсяНадбавкиИСкидки Тогда
			
			ПараметрыРасчетаНадбавки	= Выборка.НастройкаРасчетаНадбавки.Составляющие[0].ПараметрыРасчета.Получить();
			ПараметрыРасчетаСкидки		= Выборка.НастройкаРасчетаСкидки.Составляющие[0].ПараметрыРасчета.Получить();
			
			ПредельнаяСуммаНадбавки = 0;
			Если ТипЗнч(ПараметрыРасчетаНадбавки) = Тип("Структура")
				И ПараметрыРасчетаНадбавки.Свойство("ПараметрРасчетаСумма") Тогда
				ПредельнаяСуммаНадбавки = ПараметрыРасчетаНадбавки.ПараметрРасчетаСумма;
			КонецЕсли;
			
			Результат.Вставить("СтавкаНадбавки",			ПараметрыРасчетаНадбавки.ПараметрРасчетаСтавка);
			Результат.Вставить("ШкалаСкидок",				ПараметрыРасчетаСкидки.ПараметрРасчетаШкалаПроцентовВЗависимостиОтСрокаВладенияПаями);
			Результат.Вставить("ПредельнаяСумма",			ПараметрыРасчетаСкидки.ПараметрРасчетаСумма);
			Результат.Вставить("ПредельнаяСуммаНадбавки",	ПредельнаяСуммаНадбавки);
			
		КонецЕсли;
		
		Возврат Результат;
		
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Для ПИФ '%1' не заполнены условия его правил", ПаевойИнвестиционныйФонд), ПаевойИнвестиционныйФонд);
	
	Возврат Неопределено;
	
КонецФункции
