
Процедура ПередЗаписью(Отказ, Замещение)
	
	ДатаОбновления	= ТекущаяДата();
	Ответственный 	= РаботаСПользователями.ТекущийПользователь();
	
	Для каждого Запись Из ЭтотОбъект Цикл
		Если НЕ ЗначениеЗаполнено(Запись.ДатаОбновления) Тогда
			Запись.ДатаОбновления 	= ДатаОбновления;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Запись.Ответственный) Тогда
			Запись.Ответственный	= Ответственный;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
