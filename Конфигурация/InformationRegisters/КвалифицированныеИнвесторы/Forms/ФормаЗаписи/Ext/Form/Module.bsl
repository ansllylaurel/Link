
&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	Если ЗначениеЗаполнено(Запись.Организация) Тогда
		ЭтаФорма.ТипКвалИнвестора = 2;
	Иначе
		ЭтаФорма.ТипКвалИнвестора = 1;
	КонецЕсли;
	
	Элементы.Организация.Видимость = (ЭтаФорма.ТипКвалИнвестора = 2);
	
КонецПроцедуры // ПриЧтенииСозданииНаСервере

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустой() Тогда
		Запись.ВСилуЗакона = Истина;
	КонецЕсли; 
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ТипКвалИнвестораПриИзменении(Элемент)
	
	Если      ЭтаФорма.ТипКвалИнвестора = 1 Тогда
		Запись.ВСилуЗакона = Истина;
		Запись.Организация = Неопределено;
	ИначеЕсли ЭтаФорма.ТипКвалИнвестора = 2 Тогда
		Запись.ВСилуЗакона = Ложь;
		Запись.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	КонецЕсли;
	
	Элементы.Организация.Видимость = (ЭтаФорма.ТипКвалИнвестора = 2);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Запись.Является И НЕ Запись.ВСилуЗакона Тогда
		Если НЕ ЗначениеЗаполнено(Запись.Организация) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбрана организация!",,,"Организация", Отказ);
		КонецЕсли;
	ИначеЕсли Запись.ВСилуЗакона И ЗначениеЗаполнено(Запись.Организация) Тогда 
		Запись.Организация = Неопределено;
	КонецЕсли;
	
КонецПроцедуры
