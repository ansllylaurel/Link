

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастроитьВидимостьИДоступность(ЭтаФорма);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Запись		= Форма.Запись;
	Элементы	= Форма.Элементы;
	
	Элементы.ГруппаСрокОплаты.Видимость = (ТипЗнч(Запись.Договор) = Тип("СправочникСсылка.ДоговорыБрокерскогоОбслуживания") 
									  		ИЛИ (ТипЗнч(Запись.Договор) = Тип("СправочникСсылка.Договоры") И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.Договор, "ВидДоговора") <> ПредопределенноеЗначение("Перечисление.ВидыДоговоров.ДополнительноеСоглашение")));
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаРасторженияПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Запись.ДатаРасторжения)
		Или Не ЗначениеЗаполнено(Запись.Договор) Тогда
		Возврат;
	КонецЕсли;
	
	АдресДерева = ПолучитьАдресДереваДочернихЭлементов(Запись.Договор, ЭтаФорма.УникальныйИдентификатор);
	Если Не ЗначениеЗаполнено(АдресДерева) Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеРеквизиты = Новый Массив;
	ДополнительныеРеквизиты.Добавить(Новый Структура("Имя, ТипЗначения, Заголовок, Значение",
		"ДатаЗакрытия",
		Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.Дата)),
		"Дата расторжения",
		Запись.ДатаРасторжения));
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РежимВыбора",               Истина);
	ДополнительныеПараметры.Вставить("МножественныйВыбор",        Истина);
	ДополнительныеПараметры.Вставить("ЗапретитьСнятиеОтметок",   Истина);
	ДополнительныеПараметры.Вставить("ВидимыеКолонки",            "Представление");
	ДополнительныеПараметры.Вставить("ДополнительныеРеквизиты",   ДополнительныеРеквизиты);
	ДополнительныеПараметры.Вставить("ПутьКДаннымКартинкиСтроки", "ДеревоЗначений.ДанныеКартинки");
	ДополнительныеПараметры.Вставить("КартинкаСтрок",             БиблиотекаКартинок.РегистрСведенийЗапись);
	
	РезультатВопроса = РаботаСФормамиКлиент.ПоказатьДеревоЗначений(
		АдресДерева,
		"При расторжении договора будут закрыты дочерние элементы:",
		ЭтаФорма,
		РежимДиалогаВопрос.ОКОтмена,
		КодВозвратаДиалога.ОК,
		"Закрытие договора",
		ДополнительныеПараметры);
	
	Если РезультатВопроса <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	Если Не РаботаСФормамиКлиентСервер.ЗаписатьФорму(ЭтаФорма) Тогда
		Возврат;
	КонецЕсли;
	
	РаботаСИсполнителями.ЗакрытьДеревоЭлементов(
		ДополнительныеПараметры.АдресДереваЗначений,
		ДополнительныеПараметры.ДополнительныеРеквизиты.ДатаЗакрытия);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьАдресДереваДочернихЭлементов(Договор, УникальныйИдентификаторФормы)
	
	Если ТипЗнч(Договор) <> Тип("СправочникСсылка.Договоры") Тогда
		Возврат "";
	КонецЕсли;
	
	ВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ВидДоговора");
	
	ВидыДоговоров = Новый Массив;
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоров.ДепозитарногоОбслуживания);
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоров.ОтветственногоХранения);
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоров.ВеденияРеестра);
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоров.СпецДепозитарногоОбслуживания);
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоров.СпецРегистрационногоОбслуживания);
	
	Если ВидыДоговоров.Найти(ВидДоговора) = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	// ОтображатьКорневойУзел = Ложь: договор сохраняется через ЗаписатьФорму,
	// в дерево включаем только счета → разделы → исполнителей.
	АдресДерева = РаботаСИсполнителями.ПолучитьДочерниеЭлементы(
		Договор,
		,
		"ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)",
		Ложь,
		УникальныйИдентификаторФормы);
	
	Дерево = ПолучитьИзВременногоХранилища(АдресДерева);
	Дерево.Колонки.Вставить(0, "Отметка", Новый ОписаниеТипов("Булево"), " ");
	ОтметитьВсеСтрокиДерева(Дерево.Строки);
	Возврат ПоместитьВоВременноеХранилище(Дерево, УникальныйИдентификаторФормы);
	
КонецФункции

&НаСервереБезКонтекста
Процедура ОтметитьВсеСтрокиДерева(Строки)
	Для Каждого Строка Из Строки Цикл
		Строка.Отметка = Истина;
		ОтметитьВсеСтрокиДерева(Строка.Строки);
	КонецЦикла;
КонецПроцедуры

