
Функция ЗарегистрироватьНовыйНомер(Организация, ВидНумерации, Знач Объект, СчетДоверительногоУправления = Неопределено, Год = Неопределено, Отказ = Ложь) Экспорт
		
	МассивОбъектов = РаботаСКоллекциями.ЗначениеВМассив(Объект);
			
	Если ВидНумерации = Справочники.ВидыНумерацииОбъектов.ПайщикиДляРегистров
		Или ВидНумерации = Справочники.ВидыНумерацииОбъектов.ВыводыДенежныхСредств Тогда
		
		ФорматНомера = "ЧЦ=5; ЧН=00000; ЧВН=; ЧГ=0";
				
	ИначеЕсли ВидНумерации = Справочники.ВидыНумерацииОбъектов.СообщенияОбОткрытииЗакрытииИИС
		Или ВидНумерации = Справочники.ВидыНумерацииОбъектов.ПодтвержденияСбербанка
		Или ВидНумерации = Справочники.ВидыНумерацииОбъектов.ПодтвержденияВТБ Тогда
				
		ФорматНомера = "ЧЦ=15; ЧН=000000000000000; ЧВН=; ЧГ=0";
		
	ИначеЕсли ВидНумерации = Справочники.ВидыНумерацииОбъектов.РаспоряженияНаМНО Тогда
		
		ФорматНомера = "ЧЦ=6; ЧН=000000; ЧВН=; ЧГ=0";
			
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить формат номера для вида нумерации [" + ВидНумерации + "]!",,,, Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	ЗарегистрированныеНомера = ПолучитьЗарегистрированныеНомера(Организация, ВидНумерации, МассивОбъектов, СчетДоверительногоУправления, Год);
	
	Если ЗарегистрированныеНомера = Неопределено Тогда
		Отказ = Истина;
		Возврат Неопределено;	
	КонецЕсли;
	
	Если МассивОбъектов.Количество() = 0 Тогда
		
		Возврат ЗарегистрированныеНомера;
		
	КонецЕсли;
	
	СоответствиеОбъектовИСчетовДУ = Новый Соответствие;

	Если ВидНумерации = Справочники.ВидыНумерацииОбъектов.СообщенияОбОткрытииЗакрытииИИС Тогда
		
		ЗаполнитьСоответствиеОбъектовИСчетовДУ(МассивОбъектов, СоответствиеОбъектовИСчетовДУ);
		
	Иначе
		
		Для Каждого ЭлементМассиваОбъектов Из МассивОбъектов Цикл
			СоответствиеОбъектовИСчетовДУ.Вставить(ЭлементМассиваОбъектов, СчетДоверительногоУправления);
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТранзакцияАктивна() Тогда
		ЗафиксироватьТранзакциюПослеЗаписи = Ложь;
	Иначе
	    ЗафиксироватьТранзакциюПослеЗаписи = Истина;
		НачатьТранзакцию();
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.НомераОбъектов");
	ЭлементБлокировки.УстановитьЗначение("Организация", Организация);
	ЭлементБлокировки.УстановитьЗначение("ВидНумерации", ВидНумерации);
	
	Если СчетДоверительногоУправления <> Неопределено Тогда
		ЭлементБлокировки.УстановитьЗначение("СчетДоверительногоУправления", СчетДоверительногоУправления);
	КонецЕсли;
	
	Если Год <> Неопределено Тогда
		ЭлементБлокировки.УстановитьЗначение("Год", Год);
	КонецЕсли;

	Блокировка.Заблокировать();
	
	РасчетныйСчет = ?(ВидНумерации = Справочники.ВидыНумерацииОбъектов.РаспоряженияНаМНО, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект, "РасчетныйСчет"), Неопределено);

	ЧисловойНомер = ПолучитьНовыйНомер(Организация, ВидНумерации, СчетДоверительногоУправления, Год, РасчетныйСчет);
	
	СтроковыйНомер = Формат(ЧисловойНомер, ФорматНомера);
	
	Для Каждого Объект Из МассивОбъектов Цикл
	
		Если СтрДлина(Формат(ЧисловойНомер, "ЧГ=0")) > СтрДлина(СтроковыйНомер) Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формирования номера: [" + СтроковыйНомер + "]. Длина номера для вида нумерации [" + ВидНумерации + "] превысила " + СтрДлина(СтроковыйНомер) + " символов!",,,, Отказ);
			Возврат Неопределено;
			
		КонецЕсли;
		
		МенеджерЗаписи = СоздатьМенеджерЗаписи();
		
		МенеджерЗаписи.Организация	= Организация;
		МенеджерЗаписи.ВидНумерации = ВидНумерации;
		МенеджерЗаписи.Объект		= Объект;
		МенеджерЗаписи.Номер		= СтроковыйНомер;
		
		Если Не (ВидНумерации = Справочники.ВидыНумерацииОбъектов.ПайщикиДляРегистров
				И ВидНумерации = Справочники.ВидыНумерацииОбъектов.ПодтвержденияСбербанка) Тогда 
			
			МенеджерЗаписи.СчетДоверительногоУправления	= СоответствиеОбъектовИСчетовДУ.Получить(Объект);
			
		КонецЕсли;
		
		Если Не (ВидНумерации = Справочники.ВидыНумерацииОбъектов.ПайщикиДляРегистров
				И ВидНумерации = Справочники.ВидыНумерацииОбъектов.СообщенияОбОткрытииЗакрытииИИС) Тогда
			
			МенеджерЗаписи.Год = Год;
			
		КонецЕсли;
		
		МенеджерЗаписи.Записать();
		
		ЗарегистрированныеНомера.Вставить(Объект, СтроковыйНомер);
		
		Если ВидНумерации = Справочники.ВидыНумерацииОбъектов.СообщенияОбОткрытииЗакрытииИИС Тогда
						
			ЧисловойНомер = ЧисловойНомер + 1;
			СтроковыйНомер = Формат(ЧисловойНомер, ФорматНомера);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗафиксироватьТранзакциюПослеЗаписи Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
	Возврат ЗарегистрированныеНомера;

КонецФункции

Процедура ЗаполнитьСоответствиеОбъектовИСчетовДУ(МассивОбъектов, СоответствиеОбъектовИСчетовДУ)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Объект КАК Объект,
		|	КлиентыДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	(ВЫБРАТЬ
		|		АнкетаФизическогоЛица.Ссылка КАК Объект,
		|		АнкетаФизическогоЛица.Организация КАК Организация,
		|		АнкетаФизическогоЛица.ЮрФизЛицо КАК ЮрФизЛицо,
		|		МАКСИМУМ(КлиентыДоверительногоУправления.Период) КАК ПериодКлиентаДУ
		|	ИЗ
		|		Документ.АнкетаФизическогоЛица КАК АнкетаФизическогоЛица
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
		|			ПО (КлиентыДоверительногоУправления.Организация = АнкетаФизическогоЛица.Организация)
		|				И (КлиентыДоверительногоУправления.Клиент = АнкетаФизическогоЛица.ЮрФизЛицо)
		|				И (КлиентыДоверительногоУправления.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет))
		|				И (КлиентыДоверительногоУправления.Период <= АнкетаФизическогоЛица.Дата)
		|	ГДЕ
		|		АнкетаФизическогоЛица.Ссылка В(&МассивОбъектов)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		АнкетаФизическогоЛица.Ссылка,
		|		АнкетаФизическогоЛица.Организация,
		|		АнкетаФизическогоЛица.ЮрФизЛицо) КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
		|		ПО (КлиентыДоверительногоУправления.Период = ВложенныйЗапрос.ПериодКлиентаДУ)
		|			И (КлиентыДоверительногоУправления.Организация = ВложенныйЗапрос.Организация)
		|			И (КлиентыДоверительногоУправления.Клиент = ВложенныйЗапрос.ЮрФизЛицо)
		|			И (КлиентыДоверительногоУправления.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВводДенежныхСредств.Ссылка,
		|	ВводДенежныхСредств.СчетДоверительногоУправления
		|ИЗ
		|	Документ.ВводДенежныхСредств КАК ВводДенежныхСредств
		|ГДЕ
		|	ВводДенежныхСредств.Ссылка В(&МассивОбъектов)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВыводДенежныхСредств.Ссылка,
		|	ВыводДенежныхСредств.СчетДоверительногоУправления
		|ИЗ
		|	Документ.ВыводДенежныхСредств КАК ВыводДенежныхСредств
		|ГДЕ
		|	ВыводДенежныхСредств.Ссылка В(&МассивОбъектов)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВводЦенныхБумаг.Ссылка,
		|	ВводЦенныхБумаг.СчетДоверительногоУправления
		|ИЗ
		|	Документ.ВводЦенныхБумаг КАК ВводЦенныхБумаг
		|ГДЕ
		|	ВводЦенныхБумаг.Ссылка В(&МассивОбъектов)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВыводЦенныхБумаг.Ссылка,
		|	ВыводЦенныхБумаг.СчетДоверительногоУправления
		|ИЗ
		|	Документ.ВыводЦенныхБумаг КАК ВыводЦенныхБумаг
		|ГДЕ
		|	ВыводЦенныхБумаг.Ссылка В(&МассивОбъектов)";	
#КонецОбласти	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СоответствиеОбъектовИСчетовДУ.Вставить(Выборка.Объект, Выборка.СчетДоверительногоУправления);
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьНовыйНомер(Организация, ВидНумерации, СчетДоверительногоУправления = Неопределено, Год = Неопределено, РасчетныйСчет = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	НомераОбъектов.Номер КАК Номер
		|ИЗ
		|	РегистрСведений.НомераОбъектов КАК НомераОбъектов
		|ГДЕ
		|	НомераОбъектов.Организация = &Организация
		|	И НомераОбъектов.ВидНумерации = &ВидНумерации
		|	И (&СчетДоверительногоУправления = НЕОПРЕДЕЛЕНО
		|			ИЛИ НомераОбъектов.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|	И (&Год = НЕОПРЕДЕЛЕНО
		|			ИЛИ НомераОбъектов.Год = &Год)
		|	И (&ВидНумерации <> ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.РаспоряженияНаМНО)
		|			ИЛИ ВЫРАЗИТЬ(НомераОбъектов.Объект КАК Документ.Распоряжение).РасчетныйСчет = &РасчетныйСчет)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номер УБЫВ";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВидНумерации", ВидНумерации);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("РасчетныйСчет", РасчетныйСчет);
	Запрос.УстановитьПараметр("Год", Год);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЧисловойНомер = Число(Выборка.Номер) + 1;
	Иначе
		ЧисловойНомер = 1;
	КонецЕсли;

	Возврат ЧисловойНомер;
	
КонецФункции

Функция ПолучитьЗарегистрированныеНомера(Организация, ВидНумерации, МассивОбъектов, Знач СчетДоверительногоУправления = Неопределено, Год = Неопределено) Экспорт
	
	//Для нумерации СообщенияОбОткрытииЗакрытииИИС значение Счета ду заполняется позже 
	Если ВидНумерации = Справочники.ВидыНумерацииОбъектов.ПодтвержденияСбербанка
		Или ВидНумерации = Справочники.ВидыНумерацииОбъектов.ПайщикиДляРегистров
		Или ВидНумерации = Справочники.ВидыНумерацииОбъектов.СообщенияОбОткрытииЗакрытииИИС Тогда
		
		НумерацияВедетсяПоСчетамДУ = Ложь;
		
	ИначеЕсли ВидНумерации = Справочники.ВидыНумерацииОбъектов.ВыводыДенежныхСредств 
		Или ВидНумерации = Справочники.ВидыНумерацииОбъектов.ПодтвержденияВТБ Тогда
		
		НумерацияВедетсяПоСчетамДУ = Истина;
				
	ИначеЕсли ВидНумерации = Справочники.ВидыНумерацииОбъектов.РаспоряженияНаМНО Тогда
		
		НумерацияВедетсяПоСчетамДУ = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(Неопределено, "НумерацияПодтвержденийМНОВРазрезеСчетаДУ", Организация);
		
		Если НумерацияВедетсяПоСчетамДУ = Неопределено Тогда
			НумерацияВедетсяПоСчетамДУ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для организации [" + Организация + "] не удалось определить настройки нумерации. По умолчанию используется настройка [Нумерация в разрезе счетов ДУ]");
		КонецЕсли;
		
		
	КонецЕсли;
	
	Если Не НумерацияВедетсяПоСчетамДУ Тогда
		
		СчетДоверительногоУправления = Неопределено;
		
	ИначеЕсли НумерацияВедетсяПоСчетамДУ И Не ЗначениеЗаполнено(СчетДоверительногоУправления) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нумерация [" + ВидНумерации + "] ведется в разрезе счетов доверительного управления. Укажите счет доверительного управления.");
		Возврат Неопределено;
			
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Год)
		И (ВидНумерации = Справочники.ВидыНумерацииОбъектов.ВыводыДенежныхСредств 
			Или ВидНумерации = Справочники.ВидыНумерацииОбъектов.ПодтвержденияВТБ
			Или ВидНумерации = Справочники.ВидыНумерацииОбъектов.ПодтвержденияСбербанка
			Или ВидНумерации = Справочники.ВидыНумерацииОбъектов.РаспоряженияНаМНО) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Регистрация номера вида нумерации [" + ВидНумерации + "] без указания года операции невозможна.");
		Возврат Неопределено;
				
	КонецЕсли;
	
	СписокЗарегистрированныхНомеров = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НомераОбъектов.Номер КАК Номер,
		|	НомераОбъектов.Объект КАК Объект
		|ИЗ
		|	РегистрСведений.НомераОбъектов КАК НомераОбъектов
		|ГДЕ
		|	НомераОбъектов.Организация = &Организация
		|	И НомераОбъектов.ВидНумерации = &ВидНумерации
		|	И НомераОбъектов.Объект В(&МассивОбъектов)
		|	И (НЕ &НумерацияВедетсяПоСчетамДУ
		|			ИЛИ НомераОбъектов.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|	И (&Год = НЕОПРЕДЕЛЕНО
		|			ИЛИ НомераОбъектов.Год = &Год)";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВидНумерации", ВидНумерации);
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("НумерацияВедетсяПоСчетамДУ", НумерацияВедетсяПоСчетамДУ);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Год", Год);
		
	ЗарегистрированныеОбъекты = Запрос.Выполнить().Выбрать();
		
	Пока ЗарегистрированныеОбъекты.Следующий() Цикл
		
		Если МассивОбъектов.Найти(ЗарегистрированныеОбъекты.Объект) <> Неопределено Тогда
			
			МассивОбъектов.Удалить(МассивОбъектов.Найти(ЗарегистрированныеОбъекты.Объект));
	
		КонецЕсли;
		
		СписокЗарегистрированныхНомеров.Вставить(ЗарегистрированныеОбъекты.Объект, ЗарегистрированныеОбъекты.Номер);
	
	КонецЦикла;
	
	Возврат СписокЗарегистрированныхНомеров;
		
КонецФункции 

Процедура ПроверитьУникальностьИЗарегистрироватьНовыйНомер(Номер, Организация, ВидНумерации, Объект, СчетДоверительногоУправления = Неопределено, Год = Неопределено, Отказ) Экспорт

	СтроковыйНомер = РаботаСоСтрокамиКлиентСервер.ДополнитьСтроку(Номер, ?(ВидНумерации = Справочники.ВидыНумерацииОбъектов.РаспоряженияНаМНО, 6, 15));
	
	ЗарегистрированныеНомера = ПолучитьЗарегистрированныеНомера(Организация, ВидНумерации, РаботаСКоллекциями.ЗначениеВМассив(Объект), СчетДоверительногоУправления, Год);
	
	Если ЗарегистрированныеНомера = Неопределено Тогда
		Отказ = Истина;
		Возврат;	
	КонецЕсли;
			
	Если СтроковыйНомер = ЗарегистрированныеНомера[Объект] Тогда  									
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();

	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.НомераОбъектов");
	ЭлементБлокировки.УстановитьЗначение("Организация", Организация);
	ЭлементБлокировки.УстановитьЗначение("ВидНумерации", ВидНумерации);
	
	Если СчетДоверительногоУправления <> Неопределено Тогда
		ЭлементБлокировки.УстановитьЗначение("СчетДоверительногоУправления", СчетДоверительногоУправления);
	КонецЕсли;
	
	Если Год <> Неопределено Тогда
		ЭлементБлокировки.УстановитьЗначение("Год", Год);
	КонецЕсли;

	Блокировка.Заблокировать(); 

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НомераОбъектов.Объект КАК Объект
		|ИЗ
		|	РегистрСведений.НомераОбъектов КАК НомераОбъектов
		|ГДЕ
		|	НомераОбъектов.Организация = &Организация
		|	И НомераОбъектов.ВидНумерации = &ВидНумерации
		|	И НомераОбъектов.Объект <> &Объект
		|	И НомераОбъектов.Номер = &СтроковыйНомер
		|	И (&СчетДоверительногоУправления = НЕОПРЕДЕЛЕНО
		|			ИЛИ НомераОбъектов.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|	И (&Год = НЕОПРЕДЕЛЕНО
		|			ИЛИ НомераОбъектов.Год = &Год)
		|	И (&ВидНумерации <> ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.РаспоряженияНаМНО)
		|			ИЛИ ВЫРАЗИТЬ(НомераОбъектов.Объект КАК Документ.Распоряжение).РасчетныйСчет = &РасчетныйСчет)";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВидНумерации", ВидНумерации);
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("СтроковыйНомер", СтроковыйНомер);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("РасчетныйСчет", ?(ВидНумерации = Справочники.ВидыНумерацииОбъектов.РаспоряженияНаМНО, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект, "РасчетныйСчет"), Неопределено));
	Запрос.УстановитьПараметр("Год", Год);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В учетной системе уже зарегистрирован номер [" + Номер + "] с видом нумерации [" + ВидНумерации + "]. Номер присвоен объекту [" + Выборка.Объект + "].",,,, Отказ);
		ОтменитьТранзакцию();
		Возврат;
		
	КонецЦикла;
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
		
	МенеджерЗаписи.Организация	= Организация;
	МенеджерЗаписи.ВидНумерации = ВидНумерации;
	МенеджерЗаписи.Объект		= Объект;
	МенеджерЗаписи.Номер		= СтроковыйНомер;
	
	Если СчетДоверительногоУправления <> Неопределено Тогда 
		МенеджерЗаписи.СчетДоверительногоУправления	= СчетДоверительногоУправления;	
	КонецЕсли;
	
	Если Год <> Неопределено Тогда	
		МенеджерЗаписи.Год = Год;	
	КонецЕсли;
	
	Попытка
		МенеджерЗаписи.Записать();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось зарегистрировать номер [" + Номер + "]. " + ОписаниеОшибки(),,,, Отказ);	
	КонецПопытки;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры
