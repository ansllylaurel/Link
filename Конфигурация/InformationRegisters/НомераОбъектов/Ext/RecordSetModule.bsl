Процедура ПередЗаписью(Отказ, Замещение)
	
	// блокирующие проверки
	УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
	
	НоваяДатаРегистрации = ТекущаяДата();
	НовыйОтветственный = РаботаСПользователями.ТекущийПользователь();
	
	Для каждого Запись Из ЭтотОбъект Цикл
		Запись.ДатаРегистрации = НоваяДатаРегистрации;
		Запись.Ответственный = ?(ЗначениеЗаполнено(Запись.Ответственный), Запись.Ответственный, НовыйОтветственный);
	КонецЦикла;
	
	КонтрольУникальностиСообщенийИИС(Отказ);
	
КонецПроцедуры

Процедура КонтрольУникальностиСообщенийИИС(Отказ)
	
	ПараметрыПоиска		= Новый Структура("ВидНумерации", Справочники.ВидыНумерацииОбъектов.СообщенияОбОткрытииЗакрытииИИС);
	НовыеНомераОбъектов = ЭтотОбъект.Выгрузить().Скопировать(ПараметрыПоиска);
	
	Если НЕ НовыеНомераОбъектов.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НовыеНомераОбъектов", НовыеНомераОбъектов);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НовыеНомераОбъектов.Организация КАК Организация,
		|	НовыеНомераОбъектов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НовыеНомераОбъектов.Объект КАК Объект
		|ПОМЕСТИТЬ _НовыеНомераОбъектов
		|ИЗ
		|	&НовыеНомераОбъектов КАК НовыеНомераОбъектов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НовыеНомераОбъектов.Организация КАК Организация,
		|	_НовыеНомераОбъектов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_НовыеНомераОбъектов.Объект КАК НовыйОбъект,
		|	НомераОбъектов.Объект КАК Объект,
		|	НомераОбъектов.Номер КАК Номер
		|ИЗ
		|	_НовыеНомераОбъектов КАК _НовыеНомераОбъектов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НомераОбъектов КАК НомераОбъектов
		|		ПО _НовыеНомераОбъектов.Организация = НомераОбъектов.Организация
		|			И _НовыеНомераОбъектов.СчетДоверительногоУправления = НомераОбъектов.СчетДоверительногоУправления
		|			И _НовыеНомераОбъектов.Объект <> НомераОбъектов.Объект
		|			И (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(_НовыеНомераОбъектов.Объект) В (ТИП(Документ.ВводДенежныхСредств), ТИП(Документ.ВводЦенныхБумаг))
		|					ТОГДА ТИПЗНАЧЕНИЯ(НомераОбъектов.Объект) В (ТИП(Документ.ВводДенежныхСредств), ТИП(Документ.ВводЦенныхБумаг))
		|				КОГДА ТИПЗНАЧЕНИЯ(_НовыеНомераОбъектов.Объект) В (ТИП(Документ.ВыводДенежныхСредств), ТИП(Документ.ВыводЦенныхБумаг), ТИП(Документ.АнкетаФизическогоЛица))
		|					ТОГДА ТИПЗНАЧЕНИЯ(НомераОбъектов.Объект) В (ТИП(Документ.ВыводДенежныхСредств), ТИП(Документ.ВыводЦенныхБумаг), ТИП(Документ.АнкетаФизическогоЛица))
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя зарегистрировать номер для '" + Выборка.НовыйОбъект + "' по счету ДУ '" + Выборка.СчетДоверительногоУправления + "', номер уже зарегистрирован для '" + Выборка.Объект + "'",,,,Отказ);
	КонецЦикла;
	
КонецПроцедуры