
Функция ВедетсяУчетПоВиду(Период, Организация, СчетДоверительногоУправления, ВидУчета) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаОбщиеСрезПоследних.Вести" + РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ВидУчета) + " КАК ВестиВидУчета
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаОбщиеСрезПоследних";

	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
	
		Возврат ВыборкаДетальныеЗаписи.ВестиВидУчета;
	
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ПолучитьДатуНачалаНеобходимостиДанныхЕПСВоВводахЦБ(СчетДоверительногоУправления) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(НастройкиУчетаОбщие.Период) КАК Период
		|ПОМЕСТИТЬ ПоСчету
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие КАК НастройкиУчетаОбщие
		|ГДЕ
		|	НастройкиУчетаОбщие.НеобходимостьДанныхЕПСВоВводахЦБ
		|	И НастройкиУчетаОбщие.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ПоСчету.Период ЕСТЬ NULL 
		|			ТОГДА МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ.Значение
		|		КОГДА ПоСчету.Период < МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ.Значение
		|			ТОГДА ПоСчету.Период
		|		ИНАЧЕ МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ.Значение
		|	КОНЕЦ КАК НачалоДанныхЕПС
		|ИЗ
		|	Константа.МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ КАК МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ,
		|	ПоСчету КАК ПоСчету");
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	
	Возврат ?(ВыборкаЗапроса.Следующий(), ВыборкаЗапроса.НачалоДанныхЕПС, Неопределено);

КонецФункции

Функция ПолучитьГруппировкиОбщихНастроек() Экспорт
	
	РесурсыСГруппировкой = Новый ТаблицаЗначений;
	
	РесурсыСГруппировкой.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	РесурсыСГруппировкой.Колонки.Добавить("Синоним", Новый ОписаниеТипов("Строка"));
	РесурсыСГруппировкой.Колонки.Добавить("Группа", Новый ОписаниеТипов("Строка"));

	МакетГруппировки = РегистрыСведений.НастройкиУчетаОбщие.ПолучитьМакет("ГруппировкаНастроек");
	
	НомСтр = 2;
	
	Пока СокрЛП(МакетГруппировки.Область(НомСтр, 1).Текст) <> "" Цикл
		
		НоваяСтрокаРесурсыСГруппировкой = РесурсыСГруппировкой.Добавить(); 
		
		НоваяСтрокаРесурсыСГруппировкой.Имя = СокрЛП(МакетГруппировки.Область(НомСтр, 1).Текст);
		НоваяСтрокаРесурсыСГруппировкой.Группа = СокрЛП(МакетГруппировки.Область(НомСтр, 2).Текст);
		
		Если СокрЛП(НоваяСтрокаРесурсыСГруппировкой.Группа) = "" Тогда
		
			НоваяСтрокаРесурсыСГруппировкой.Группа = "Прочие";
		
		КонецЕсли;
		
		НомСтр = НомСтр + 1;
	
	КонецЦикла;
	
	Для каждого РесурсРегистра Из Метаданные.РегистрыСведений.НастройкиУчетаОбщие.Ресурсы Цикл
		
		СтрокаРесурсыСГруппировкой = РесурсыСГруппировкой.Найти(РесурсРегистра.Имя, "Имя");
		
		Если СтрокаРесурсыСГруппировкой = Неопределено Тогда
		
			НоваяСтрокаРесурсыСГруппировкой = РесурсыСГруппировкой.Добавить(); 
			
			НоваяСтрокаРесурсыСГруппировкой.Имя = РесурсРегистра.Имя;
			НоваяСтрокаРесурсыСГруппировкой.Синоним = РесурсРегистра.Синоним;
			НоваяСтрокаРесурсыСГруппировкой.Группа = "Прочие";
			
		Иначе
			
			СтрокаРесурсыСГруппировкой.Синоним = РесурсРегистра.Синоним;
			
		КонецЕсли;
	
	КонецЦикла;
	
	РесурсыСГруппировкой.Сортировать("Группа,Имя");
	
	Возврат РесурсыСГруппировкой;

КонецФункции 

