Функция ПолучитьПоследнююДатуТорговБлумберга(ДатаПереоценки, Блумберг = Неопределено) Экспорт
	
	Если Блумберг = Неопределено Тогда
		Блумберг = ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");	
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(КотировкиТорговыхПлощадок.Период) КАК Период
		|ИЗ
		|	РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|ГДЕ
		|	КотировкиТорговыхПлощадок.Биржа = &Блумберг
		|	И КотировкиТорговыхПлощадок.Период <= &ДатаПереоценки
		|	И (КотировкиТорговыхПлощадок.РежимТоргов = &Режим_BVAL
		|				И КотировкиТорговыхПлощадок.ADMITTEDQUOTE > 0
		|			ИЛИ КотировкиТорговыхПлощадок.РежимТоргов = &Режим_BGN
		|				И (КотировкиТорговыхПлощадок.BID > 0
		|					ИЛИ КотировкиТорговыхПлощадок.CLOSE > 0
		|					ИЛИ КотировкиТорговыхПлощадок.OFFER > 0))");
	
	Запрос.УстановитьПараметр("Блумберг", Блумберг);
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	Запрос.УстановитьПараметр("Режим_BGN"	, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("Режим_BVAL"	, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ПоследняяДатаТорговБлумберга = ВыборкаДетальныеЗаписи.Период;
	Иначе
		ПоследняяДатаТорговБлумберга = ДатаПереоценки;
	КонецЕсли;
	
	Возврат ПоследняяДатаТорговБлумберга;
	
КонецФункции