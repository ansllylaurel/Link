
Процедура ПередЗаписью(Отказ, Замещение)
	
	Для Каждого СтрокаНабора Из ЭтотОбъект Цикл
		
		СписокИзмерений = "(вид актива: " + СтрокаНабора.ВидАктива + ", субъект аналитики: " + СтрокаНабора.СубъектАналитики + ", основание: " + СтрокаНабора.Основание + ")";
		Если ЗначениеЗаполнено(СтрокаНабора.СубъектАналитики) 
			И НЕ (ТипЗнч(СтрокаНабора.СубъектАналитики) = Тип("СправочникСсылка.ОбъектыНедвижимости")
				ИЛИ ТипЗнч(СтрокаНабора.СубъектАналитики) = Тип("СправочникСсылка.Займы")) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Недопустимо указание стоимости для субъектов аналитики кроме недвижимости или займов! Обратитесь к программистам",ЭтотОбъект.Отбор.Регистратор,,,Отказ);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаНабора.Основание) 
			И НЕ (ТипЗнч(СтрокаНабора.Основание) = Тип("ДокументСсылка.СделкаСНедвижимостью")
				ИЛИ ТипЗнч(СтрокаНабора.Основание) = Тип("СправочникСсылка.Договоры"))Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Недопустимо указание стоимости для оснований кроме сделок с недвижимостью или договоров! Обратитесь к программистам",ЭтотОбъект.Отбор.Регистратор,,,Отказ);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаНабора.СубъектАналитики) И НЕ ЗначениеЗаполнено(СтрокаНабора.Основание) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указаны субъект аналитики или основание стоимости прочих активов " + СписокИзмерений, ЭтотОбъект.Отбор.Регистратор,,,Отказ);
		КонецЕсли;
		Если СтрокаНабора.ВидАктива = Перечисления.ВидыАктивов.Недвижимость Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаНабора.СубъектАналитики) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан субъект аналитики для недвижимости " + СписокИзмерений, ЭтотОбъект.Отбор.Регистратор,,,Отказ);
			ИначеЕсли ТипЗнч(СтрокаНабора.СубъектАналитики) <> Тип("СправочникСсылка.ОбъектыНедвижимости") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В качестве субъекта аналитики для недвижимости следует указать объект недвижимости " + СписокИзмерений, ЭтотОбъект.Отбор.Регистратор,,,Отказ);
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаНабора.Основание) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для недвижимости основание заполнять не требуется. Очистите значение. " + СписокИзмерений, ЭтотОбъект.Отбор.Регистратор,,,Отказ);
			КонецЕсли;
		ИначеЕсли СтрокаНабора.ВидАктива = Перечисления.ВидыАктивов.ИмущественныеПрава
			ИЛИ СтрокаНабора.ВидАктива = Перечисления.ВидыАктивов.ПраваАренды Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаНабора.СубъектАналитики) ИЛИ НЕ ЗначениеЗаполнено(СтрокаНабора.Основание) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан субъект аналитики или основание для имущественных прав " + СписокИзмерений, ЭтотОбъект.Отбор.Регистратор,,,Отказ);
			КонецЕсли;
		ИначеЕсли СтрокаНабора.ВидАктива = Перечисления.ВидыАктивов.Обеспечение Или СтрокаНабора.ВидАктива = Перечисления.ВидыАктивов.Займы Тогда
			ВидАктиваРодПадеж = ?(СтрокаНабора.ВидАктива = Перечисления.ВидыАктивов.Обеспечение, "обеспечения ", "займа ");
			Если НЕ ЗначениеЗаполнено(СтрокаНабора.СубъектАналитики) ИЛИ НЕ ЗначениеЗаполнено(СтрокаНабора.Основание) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан субъект аналитики или основание для " + ВидАктиваРодПадеж + СписокИзмерений, ЭтотОбъект.Отбор.Регистратор,,,Отказ);
			Иначе
				ВидДоговораОбеспечения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаНабора.Основание, "ВидДоговора");
				Если НЕ (ВидДоговораОбеспечения = Перечисления.ВидыДоговоров.Залога ИЛИ ВидДоговораОбеспечения = Перечисления.ВидыДоговоров.Поручительства) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для " + ВидАктиваРодПадеж + "обнаружен вид договора " + ВидДоговораОбеспечения + " вместо поручительства или залога " + СписокИзмерений, ЭтотОбъект.Отбор.Регистратор,,,Отказ);
				ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаНабора.Основание, "Основание") <> СтрокаНабора.СубъектАналитики Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбранный договор не привязан к указанному займу " + СписокИзмерений, ЭтотОбъект.Отбор.Регистратор,,,Отказ);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан субъект аналитики или основание для имущественных прав " + СписокИзмерений, ЭтотОбъект.Отбор.Регистратор,,,Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
