
Процедура ПередЗаписью(Отказ, Замещение)
	
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("ЗаписьВСоставеСчетаДоверительногоУправления")
		И НЕ УниверсальныеМеханизмы.УдалениеНабораЗаписейРегистраВСоставеВедущегоИзмерения(ЭтотОбъект) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Изменение лицензий производится через форму счёта внутреннего учёта",,,, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления КАК ЛицензииДоговоровДоверительногоУправления
		|		ПО СчетаДоверительногоУправления.Ссылка = ЛицензииДоговоровДоверительногоУправления.СчетДоверительногоУправления
		|			И (ЛицензииДоговоровДоверительногоУправления.Период = ДАТАВРЕМЯ(1980, 1, 1))
		|			И (ЛицензииДоговоровДоверительногоУправления.Действует)
		|ГДЕ
		|	НЕ СчетаДоверительногоУправления.ПометкаУдаления
		|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный))
		|	И ЛицензииДоговоровДоверительногоУправления.Лицензия ЕСТЬ NULL";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У счета '" + Выборка.СчетДоверительногоУправления + "' в условиях договоров ДУ не указана лицензия на 01.01.1980. Запись в регистр невозможна.",,,, Отказ);
	КонецЦикла;
	
	
КонецПроцедуры