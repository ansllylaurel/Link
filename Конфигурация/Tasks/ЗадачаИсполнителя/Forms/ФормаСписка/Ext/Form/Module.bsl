
#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
	Период.ДатаОкончания = КонецДня(ТекущаяДата());
		
	ЭтаФорма.Список.Параметры.УстановитьЗначениеПараметра("КИсполнению", 	Истина);
	ЭтаФорма.Список.Параметры.УстановитьЗначениеПараметра("Исполнитель", 	РаботаСПользователями.ТекущийПользователь());
	
	Если НЕ РаботаСПользователями.ЭтоПолноправныйПользователь(РаботаСПользователями.ТекущийПользователь(), Ложь) Тогда
		ЭтаФорма.Элементы.ГруппаВсеЗадачи.Видимость = Ложь;
		Элементы.ГруппаСтраницы.ОтображениеСтраниц  = ОтображениеСтраницФормы.Нет;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
	УстановитьОтборПоПериоду();	
	УстановитьЗаголовок();
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаПоказатьВыполненныеЗадачи(Команда)
	
	Элементы.КомандаПоказатьВыполненныеЗадачи.Пометка =
		Не Элементы.КомандаПоказатьВыполненныеЗадачи.Пометка;
		
	ЭтаФорма.Список.Параметры.УстановитьЗначениеПараметра("КИсполнению", Не Элементы.КомандаПоказатьВыполненныеЗадачи.Пометка);

КонецПроцедуры

&НаКлиенте
Процедура КомандаИзменитьДатуЗадач(Команда)
	
	Если Элементы.Список.ВыделенныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В списке задач не выделено ни одной задачи для изменения даты");
		
	Иначе
		
		НоваяДата = ТекущаяДата();
		Если ВвестиДату(НоваяДата, "Укажите новую дату задач", ЧастиДаты.Дата) Тогда
			ИзменитьДатуЗадач(Элементы.Список.ВыделенныеСтроки, НоваяДата);	
			Элементы.Список.Обновить();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыбратьПериод(Команда)
	
	ФормаВыбораПериода = ПолучитьФорму("ОбщаяФорма.ВыборПериода", Новый Структура("Период", ЭтаФорма.Период), ЭтаФорма);
	ВыбПериод          = ФормаВыбораПериода.ОткрытьМодально();
	
	Если ВыбПериод <> КодВозвратаДиалога.Отмена И ВыбПериод <> Неопределено Тогда
		
		ЭтаФорма.Период = ВыбПериод;		
		УстановитьОтборПоПериоду(); 			
		УстановитьЗаголовок();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Прочие_процедуры_и_функции

&НаСервереБезКонтекста
Процедура ИзменитьДатуЗадач(Знач МассивЗадачДляИзменения, НоваяДата)
	
	Для Каждого Задача Из МассивЗадачДляИзменения Цикл
		// Проверяем выделенные задачи:
		//  - новая дата не должна быть раньше даты порунения и позже крайнего срока исполнения поручения
		//  - выполненные задачи не меняем
		//  - если новая дата совпадает с датой задачи, пропускаем
		Если НачалоДня(Задача.Дата) <> НоваяДата И Не Задача.Выполнена Тогда		
			
			ЗадачаОбъект = Задача.ПолучитьОбъект();
			ЗадачаОбъект.Дата = НоваяДата;
			
			Попытка
				ЗадачаОбъект.Записать();
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПоПериоду()
	
	ЭлементыОтбораСписка = ЭтаФорма.Список.Отбор.Элементы;
	
	Для Инд = 1 - ЭлементыОтбораСписка.Количество() По 0 Цикл
		
		ПредставлениеЭлементаОтбораСписка = ЭлементыОтбораСписка[-Инд].Представление;
		
		Если ПредставлениеЭлементаОтбораСписка = "Период.ДатаНачала" 
			Или ПредставлениеЭлементаОтбораСписка = "Период.ДатаОкончания" 
			Или ПредставлениеЭлементаОтбораСписка = "ОтборПоСроку" Тогда 
			ЭлементыОтбораСписка.Удалить(-Инд);
		КонецЕсли;
		
	КонецЦикла;
	
	РаботаСНастройкамиСписковКлиентСервер.ДобавитьЭлементОтбора(ЭтаФорма.Список.Отбор, "Дата", "Период.ДатаНачала",
		ВидСравненияКомпоновкиДанных.БольшеИлиРавно, Этаформа.Период.ДатаНачала, ЗначениеЗаполнено(Этаформа.Период.ДатаНачала), РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
		
	РаботаСНастройкамиСписковКлиентСервер.ДобавитьЭлементОтбора(ЭтаФорма.Список.Отбор, "Дата", "Период.ДатаОкончания",
		ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, Этаформа.Период.ДатаОкончания, ЗначениеЗаполнено(Этаформа.Период.ДатаОкончания), РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
		
	Если ЗначениеЗаполнено(Этаформа.Период.ДатаОкончания) Тогда
	
		ГруппаИли = ЭтаФорма.Список.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаИли.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		ГруппаИли.Представление = "ОтборПоСроку"; 
		ГруппаИли.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
		РаботаСНастройкамиСписковКлиентСервер.ДобавитьЭлементОтбора(ГруппаИли, "БизнесПроцесс", Неопределено,
			ВидСравненияКомпоновкиДанных.Заполнено, Неопределено, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
			
		РаботаСНастройкамиСписковКлиентСервер.ДобавитьЭлементОтбора(ГруппаИли, "СрокИсполнения", Неопределено,
			ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, Этаформа.Период.ДатаОкончания, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);		
	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовок()

	Заголовок = "Задачи";
	Если ЭтаФорма.Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод Тогда
		Если ЭтаФорма.Период.ДатаНачала = Дата(1, 1, 1) И ЭтаФорма.Период.ДатаОкончания = Дата(1, 1, 1) Тогда
			Заголовок = Заголовок + " (Без ограничения)";
		ИначеЕсли ЭтаФорма.Период.ДатаНачала = Дата(1, 1, 1) Тогда
			Заголовок = Заголовок + " (до " + Формат(ЭтаФорма.Период.ДатаОкончания, "ДФ=dd.MM.yyyy") + ")";
		ИначеЕсли ЭтаФорма.Период.ДатаОкончания = Дата(1, 1, 1) Тогда
			Заголовок = Заголовок + " (с " + Формат(ЭтаФорма.Период.ДатаНачала, "ДФ=dd.MM.yyyy") + ")";
		Иначе
			Заголовок = Заголовок + " (с " + Формат(ЭтаФорма.Период.ДатаНачала, "ДФ=dd.MM.yyyy") + " по " + Формат(ЭтаФорма.Период.ДатаОкончания, "ДФ=dd.MM.yyyy") + ")";	
		КонецЕсли;
	Иначе
		Заголовок = Заголовок + " (" + ЭтаФорма.Период.Вариант + ")";
	КонецЕсли;
	
	ЭтаФорма.Заголовок = Заголовок;
	
КонецПроцедуры // УстановитьЗаголовок

#КонецОбласти