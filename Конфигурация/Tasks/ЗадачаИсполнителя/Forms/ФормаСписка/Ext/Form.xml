ПОМЕСТИТЬ _ГруппыИсполнителей
ИЗ
	РегистрСведений.СоставГруппПользователей КАК СоставГруппПользователей
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыПользователей КАК ГруппыПользователей
		ПО (ГруппыПользователей.Ссылка В (СоставГруппПользователей.ГруппаПользователей, СоставГруппПользователей.ГруппаПользователей.Родитель))
			И (НЕ ГруппыПользователей.ПометкаУдаления)
ГДЕ
	СоставГруппПользователей.Пользователь = &amp;Исполнитель
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗадачаИсполнителя.*
ИЗ
	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
ГДЕ
	НЕ ЗадачаИсполнителя.ПометкаУдаления
	И НЕ ЕСТЬNULL(ЗадачаИсполнителя.БизнесПроцесс.Отменен, ЛОЖЬ)
	И ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(ЗадачаИсполнителя.БизнесПроцесс) = ТИП(БизнесПроцесс.ОбучениеСотрудника) 
				ТОГДА ЗадачаИсполнителя.ТочкаМаршрута &lt;&gt; Значение(БизнесПроцесс.ОбучениеСотрудника.ТочкаМаршрута.ПройтиОбучение)
				ИНАЧЕ ИСТИНА
		КОНЕЦ
	И (ЗадачаИсполнителя.Исполнитель = &amp;Исполнитель
			ИЛИ ЗадачаИсполнителя.ГруппаИсполнителей В
				(ВЫБРАТЬ
					_ГруппыИсполнителей.Ссылка КАК Ссылка
				ИЗ
					_ГруппыИсполнителей КАК _ГруппыИсполнителей))
	И (НЕ &amp;КИсполнению
			ИЛИ НЕ ЗадачаИсполнителя.Выполнена)</QueryText>
