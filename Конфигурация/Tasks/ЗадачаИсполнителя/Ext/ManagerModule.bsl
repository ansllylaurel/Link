
Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Если ВидФормы = "ФормаОбъекта" И Параметры.Свойство("Ключ") Тогда
		Если ТипЗнч(Параметры.Ключ) = Тип("ЗадачаСсылка.ЗадачаИсполнителя") И ЗначениеЗаполнено(Параметры.Ключ.БизнесПроцесс) Тогда
			
			ЗадачаСсылка = Параметры.Ключ;
			
			ТипБизнесПроцесса	= ЗадачаСсылка.БизнесПроцесс.Метаданные();
			ВыбраннаяФорма		= БизнесПроцессы[ТипБизнесПроцесса.Имя].ФормаВыполненияЗадачи(ЗадачаСсылка, ЗадачаСсылка.ТочкаМаршрута);
			СтандартнаяОбработка = Ложь;

		КонецЕсли;
	КонецЕсли;	
		
КонецПроцедуры
	
Функция ПолучитьЭлектронныеАдресаИсполнителейЗадачи(Задача, Отказ) Экспорт
	
	Запрос = Новый Запрос;
	
	Если ЗначениеЗаполнено(Задача.Исполнитель) Тогда
		Запрос.УстановитьПараметр("Исполнитель", Задача.Исполнитель);
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Пользователи.Ссылка КАК Пользователь,
			|	Пользователи.АдресЭлектроннойПочты КАК АдресЭлектроннойПочты
			|ИЗ
			|	Справочник.Пользователи КАК Пользователи
			|ГДЕ
			|	Пользователи.Ссылка = &Исполнитель";
		
	Иначе
		Запрос.УстановитьПараметр("ГруппаИсполнителей", Задача.ГруппаИсполнителей);
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	СоставГруппПользователей.Пользователь.Ссылка КАК Пользователь,
			|	СоставГруппПользователей.Пользователь.АдресЭлектроннойПочты КАК АдресЭлектроннойПочты
			|ИЗ
			|	РегистрСведений.СоставГруппПользователей КАК СоставГруппПользователей
			|ГДЕ
			|	(СоставГруппПользователей.ГруппаПользователей = &ГруппаИсполнителей
			|			ИЛИ СоставГруппПользователей.ГруппаПользователей.Родитель = &ГруппаИсполнителей)";
		
	КонецЕсли;
	
	ЭлектронныеАдресаИсполнителейЗадачи = Новый Массив;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Для задачи %1 не определён ни один исполнитель", Задача.Ссылка),,,, Отказ);
		
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ПустаяСтрока(Выборка.АдресЭлектроннойПочты) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("У пользователя %1 не указан адрес электронной почты", Выборка.Пользователь),,,, Отказ);
				
			Иначе
				ЭлектронныеАдресаИсполнителейЗадачи.Добавить(Выборка.АдресЭлектроннойПочты);
				
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	
	Возврат СтрСоединить(ЭлектронныеАдресаИсполнителейЗадачи, "; ");
	
КонецФункции

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Данные.Выполнена Тогда
		Представление = СтрШаблон("%1 %2 от %3 (Выполнена %4)", Данные.Наименование, Данные.Номер, Данные.Дата, Данные.ДатаВыполнения);
	Иначе
		Представление = СтрШаблон("%1 %2 от %3", Данные.Наименование, Данные.Номер, Данные.Дата);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля.Добавить("Выполнена");
	Поля.Добавить("Наименование");
	Поля.Добавить("Номер");
	Поля.Добавить("Дата");
	Поля.Добавить("ДатаВыполнения");
	
КонецПроцедуры
