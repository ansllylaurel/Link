
#Область СОБЫТИЯ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Список    = ЭтаФорма.Параметры.Список;
	ЭтаФорма.Заголовок = ЭтаФорма.Параметры.Заголовок;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекущееЗначение = ЭтаФорма.Список.НайтиПоЗначению(ЭтаФорма.Параметры.ТекущийЭлемент);
	
	Если ТекущееЗначение <> Неопределено Тогда
		ЭтаФорма.Элементы.Список.ТекущаяСтрока = ТекущееЗначение.ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СОБЫТИЯ_ЭЛЕМЕНТОВ_ФОРМЫ

&НаКлиенте
Процедура ФильтрАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	Если Текст = "" Тогда
		ЭтаФорма.Список.ЗагрузитьЗначения(ЭтаФорма.Параметры.Список.ВыгрузитьЗначения());
	Иначе
		ЭтаФорма.Список.Очистить();
		Для каждого ЭлементСписка Из ЭтаФорма.Параметры.Список Цикл
			Если Найти(ВРег(ЭлементСписка.Представление), ВРег(Текст)) <> 0 Тогда
				ЭтаФорма.Список.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Этаформа.Закрыть(Элементы.Список.ТекущиеДанные.Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	
	Если Этаформа.Элементы.Список.ТекущиеДанные = Неопределено Тогда
		Предупреждение("Значение не выбрано!");
		Возврат;
	Иначе
		Этаформа.Закрыть(Этаформа.Элементы.Список.ТекущиеДанные.Значение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтмена(Команда)
	
	Этаформа.Закрыть(Неопределено);
	
КонецПроцедуры

#КонецОбласти
