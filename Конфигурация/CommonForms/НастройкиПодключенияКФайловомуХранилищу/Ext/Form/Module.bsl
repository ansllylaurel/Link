
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Настройки = РаботаСФайловымХранилищем.ПолучитьНастройкиПодключенияКФайловомуХранилищу();
	
	Если Настройки <> Неопределено Тогда
		
		ЭтаФорма.АдресВебСервисаФайловогоХранилища		= ?(Настройки.Свойство("АдресВебСервиса"),					Настройки.АдресВебСервиса,					Неопределено);
		ЭтаФорма.АутентификацияОСВФайловомХранилище		= ?(Настройки.Свойство("АутентификацияОС"),					Настройки.АутентификацияОС,					Неопределено);
		ЭтаФорма.ИмяПользователяФайловогоХранилища		= ?(Настройки.Свойство("ИмяПользователя"),					Настройки.ИмяПользователя,					Неопределено);
		ЭтаФорма.ПарольПользователяФайловогоХранилища	= ?(Настройки.Свойство("ПарольПользователя"),				Настройки.ПарольПользователя,				Неопределено);
		ЭтаФорма.ИдентификаторОбщейПапкиФайлов			= ?(Настройки.Свойство("ИдентификаторОбщейПапкиФайлов"),	Настройки.ИдентификаторОбщейПапкиФайлов,	Неопределено);
		
		ЭтаФорма.АдресВебСервисаТестовогоФайловогоХранилища = ?(Настройки.Свойство("АдресВебСервисаТестовогоФайловогоХранилища"), Настройки.АдресВебСервисаТестовогоФайловогоХранилища, Неопределено);
		ЭтаФорма.АутентификацияОСВТестовомФайловомХранилище = ?(Настройки.Свойство("АутентификацияОСВТестовомФайловомХранилище"), Настройки.АутентификацияОСВТестовомФайловомХранилище, Неопределено);
		ЭтаФорма.ИмяПользователяТестовогоФайловогоХранилища = ?(Настройки.Свойство("ИмяПользователяТестовогоФайловогоХранилища"), Настройки.ИмяПользователяТестовогоФайловогоХранилища, Неопределено);
		ЭтаФорма.ПарольПользователяТестовогоФайловогоХранилища = ?(Настройки.Свойство("ПарольПользователяТестовогоФайловогоХранилища"), Настройки.ПарольПользователяТестовогоФайловогоХранилища, Неопределено);
		
	КонецЕсли;
	
	УстановитьДоступностьУчетныхДанныхФайловогоХранилища(ЭтаФорма);
	УстановитьДоступностьУчетныхДанныхТестовогоФайловогоХранилища(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЭтаФорма.Модифицированность Тогда
		
		Если Вопрос("Настройки подключения изменились. Сохранить изменения?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			
			Если НЕ ЗаписатьНаСервере() Тогда
				Отказ = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура АутентификацияОСВФайловомХранилищеПриИзменении(Элемент)
	
	УстановитьДоступностьУчетныхДанныхФайловогоХранилища(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура АутентификацияОСВТестовомФайловомХранилищеПриИзменении(Элемент)
	
	УстановитьДоступностьУчетныхДанныхТестовогоФайловогоХранилища(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти 

#Область Команды_формы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	Если ЗаписатьНаСервере() Тогда
		ЭтаФорма.Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)
	
	ЗаписатьНаСервере();
	
КонецПроцедуры

#КонецОбласти 

#Область Служебные_процедуры_и_функции

&НаСервере
Функция ЗаписатьНаСервере()
	
	Настройки = Новый Структура;
	
	Настройки.Вставить("АдресВебСервиса",				ЭтаФорма.АдресВебСервисаФайловогоХранилища);
	Настройки.Вставить("АутентификацияОС",				ЭтаФорма.АутентификацияОСВФайловомХранилище);
	Настройки.Вставить("ИмяПользователя",				ЭтаФорма.ИмяПользователяФайловогоХранилища);
	Настройки.Вставить("ПарольПользователя",			ЭтаФорма.ПарольПользователяФайловогоХранилища);
	Настройки.Вставить("ИдентификаторОбщейПапкиФайлов",	ЭтаФорма.ИдентификаторОбщейПапкиФайлов);
	
	Настройки.Вставить("АдресВебСервисаТестовогоФайловогоХранилища",	ЭтаФорма.АдресВебСервисаТестовогоФайловогоХранилища);
	Настройки.Вставить("АутентификацияОСВТестовомФайловомХранилище",	ЭтаФорма.АутентификацияОСВТестовомФайловомХранилище);
	Настройки.Вставить("ИмяПользователяТестовогоФайловогоХранилища",	ЭтаФорма.ИмяПользователяТестовогоФайловогоХранилища);
	Настройки.Вставить("ПарольПользователяТестовогоФайловогоХранилища",	ЭтаФорма.ПарольПользователяТестовогоФайловогоХранилища);
	
	Попытка
		Константы.НастройкиПодключенияКФайловомуХранилищу.Установить(XMLСтрока(Новый ХранилищеЗначения(Настройки)));
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось записать настройки подключения из-за ошибки:%1", Символы.ПС + ОписаниеОшибки()));
		Возврат Ложь;
	КонецПопытки;
	
	ЭтаФорма.Модифицированность = Ложь;
	
	Возврат Истина;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста 
Процедура УстановитьДоступностьУчетныхДанныхФайловогоХранилища(ЭтаФорма)
	
	ЭтаФорма.Элементы.ИмяПользователяФайловогоХранилища.Доступность		= НЕ ЭтаФорма.АутентификацияОСВФайловомХранилище;
	ЭтаФорма.Элементы.ПарольПользователяФайловогоХранилища.Доступность	= НЕ ЭтаФорма.АутентификацияОСВФайловомХранилище;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста 
Процедура УстановитьДоступностьУчетныхДанныхТестовогоФайловогоХранилища(ЭтаФорма)
	
	ЭтаФорма.Элементы.ИмяПользователяТестовогоФайловогоХранилища.Доступность		= НЕ ЭтаФорма.АутентификацияОСВТестовомФайловомХранилище;
	ЭтаФорма.Элементы.ПарольПользователяТестовогоФайловогоХранилища.Доступность	= НЕ ЭтаФорма.АутентификацияОСВТестовомФайловомХранилище;
	
КонецПроцедуры

#КонецОбласти 



