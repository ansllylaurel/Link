&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДеревоОбъект		= Неопределено;
	АдресДереваЗначений	= Неопределено;
	
	Если (Параметры.Свойство("АдресДереваЗначений", АдресДереваЗначений) И ЭтоАдресВременногоХранилища(АдресДереваЗначений)) Тогда
		ДеревоОбъект = ПолучитьИзВременногоХранилища(АдресДереваЗначений);		
	КонецЕсли;	
	
	Если (ДеревоОбъект = Неопределено ИЛИ ТипЗнч(ДеревоОбъект) <> Тип("ДеревоЗначений"))  
		И (Не Параметры.Свойство("ДеревоЗначений", ДеревоОбъект) ИЛИ ТипЗнч(ДеревоОбъект) <> Тип("ДеревоЗначений"))
	Тогда
		Возврат;
	КонецЕсли;	
	
	// Определяем режим выбора
	Элементы.ДеревоЗначений.РежимВыбора = ?(Параметры.Свойство("РежимВыбора"), Параметры.РежимВыбора, Ложь);
	
	Если Параметры.Свойство("МножественныйВыбор") Тогда
		Элементы.ДеревоЗначений.МножественныйВыбор = Параметры.МножественныйВыбор;
	КонецЕсли;

	МножественныйВыбор = Элементы.ДеревоЗначений.РежимВыбора И Элементы.ДеревоЗначений.МножественныйВыбор;	
	
	// Создаем реквизиты формы
    МассивДобавляемыхРеквизитов = Новый Массив;
	
	Если МножественныйВыбор Тогда
		Если ДеревоОбъект.Колонки.Найти("Отметка") = Неопределено Тогда
			ДеревоОбъект.Колонки.Вставить(0, "Отметка", Новый ОписаниеТипов("Булево"), " ");
		КонецЕсли;
		
		Если Параметры.Свойство("ОтмеченныеЭлементы") Тогда
			НайденныеСтроки = ДеревоОбъект.Строки.НайтиСтроки(Параметры.ОтмеченныеЭлементы, Истина);
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				НайденнаяСтрока.Отметка = Истина;		
				ОтметитьДочерниеЭлементы(НайденнаяСтрока, НайденнаяСтрока.Отметка);
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;
	
    Для Каждого Колонка Из ДеревоОбъект.Колонки Цикл
        МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "ДеревоЗначений", Колонка.Заголовок));
	КонецЦикла;
	
	Если Параметры.Свойство("ДополнительныеРеквизиты") Тогда
		Для Каждого ДополнительныйРеквизит Из Параметры.ДополнительныеРеквизиты Цикл
			МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(ДополнительныйРеквизит.Имя, ДополнительныйРеквизит.ТипЗначения, , ДополнительныйРеквизит.Заголовок));		
			
			ЭтаФорма.ДобавленныеРеквизиты.Добавить(ДополнительныйРеквизит.Имя);	
		КонецЦикла;
	КонецЕсли;
	
    ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
    // Преобразуем в данные формы
    ЗначениеВРеквизитФормы(ДеревоОбъект, "ДеревоЗначений");

	Если Параметры.Свойство("ДополнительныеРеквизиты") Тогда
		Для Каждого ДополнительныйРеквизит Из Параметры.ДополнительныеРеквизиты Цикл
			ЭтаФорма[ДополнительныйРеквизит.Имя] = ДополнительныйРеквизит.Значение;		
		КонецЦикла;
	КонецЕсли;	
	
	// Получаем видимость колонок
	Если Параметры.Свойство("ВидимыеКолонки") Тогда
		ВидимыеКолонки = Новый Структура(Параметры.ВидимыеКолонки);
	КонецЕсли;
	
	// Создаем элементы формы
	Для Каждого Колонка Из ДеревоОбъект.Колонки Цикл
		
		// Элементы для невидимых колонок не добавляем
		Если ВидимыеКолонки <> Неопределено
			И Не ВидимыеКолонки.Свойство(Колонка.Имя)
			И Не (МножественныйВыбор И Колонка.Имя = "Отметка")
		Тогда
			Продолжить;		
		КонецЕсли;
		
		// Отметка и первый реквизит в одной ячейке
		Если МножественныйВыбор И (Элементы.ПерваяКолонка.ПодчиненныеЭлементы.Количество() < 2 ИЛИ Колонка.Имя = "Отметка") Тогда
			ЭлементРодитель = Элементы.ПерваяКолонка;				
		Иначе
			ЭлементРодитель = Элементы.ДеревоЗначений;				
		КонецЕсли;
		
		НовыйЭлемент = Элементы.Добавить(Колонка.Имя, Тип("ПолеФормы"), ЭлементРодитель);
        НовыйЭлемент.Вид			= ВидПоляФормы.ПолеНадписи;
        НовыйЭлемент.ПутьКДанным	= "ДеревоЗначений." + Колонка.Имя;
		НовыйЭлемент.ТолькоПросмотр	= Истина;
		
		Если МножественныйВыбор И Колонка.Имя = "Отметка" Тогда
	        НовыйЭлемент.Вид			= ВидПоляФормы.ПолеФлажка;
			НовыйЭлемент.ТолькоПросмотр	= ?(Параметры.Свойство("ЗапретитьСнятиеОтметок") И Параметры.ЗапретитьСнятиеОтметок, Истина, Ложь);
			НовыйЭлемент.Заголовок		= Колонка.Заголовок;
			Если ПустаяСтрока(НовыйЭлемент.Заголовок) Тогда
				НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;		
			КонецЕсли;
			
			НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииОтметки");
		КонецЕсли;

	КонецЦикла;
	
	Если Параметры.Свойство("ДополнительныеРеквизиты") Тогда
		Для Каждого ДополнительныйРеквизит Из Параметры.ДополнительныеРеквизиты Цикл
	        НовыйЭлемент = Элементы.Добавить(ДополнительныйРеквизит.Имя, Тип("ПолеФормы"), Элементы.ГруппаДополнительныеРеквизиты);
			НовыйЭлемент.Вид			= ВидПоляФормы.ПолеВвода;
			НовыйЭлемент.ПутьКДанным	= ДополнительныйРеквизит.Имя;
		КонецЦикла;
	КонецЕсли;
	
	Если Параметры.Свойство("ПутьКДаннымКартинкиСтроки") Тогда
		Элементы.ДеревоЗначений.ПутьКДаннымКартинкиСтроки = Параметры.ПутьКДаннымКартинкиСтроки;
	КонецЕсли;
	
	Если Параметры.Свойство("КартинкаСтрок") Тогда
		Элементы.ДеревоЗначений.КартинкаСтрок = Параметры.КартинкаСтрок;
	КонецЕсли;
	
	// Отображаем заданные кнопки
	Кнопки = Неопределено;
	Если Параметры.Свойство("Кнопки", Кнопки) Тогда
		Для Каждого ИмяКнопки Из Кнопки Цикл
			ЭлементКнопки = Элементы.Найти("Форма" + ИмяКнопки.Значение);
			Если ЭлементКнопки <> Неопределено Тогда
				ЭлементКнопки.Видимость = Истина;		
			КонецЕсли;
		КонецЦикла;
		
		Если Элементы.ДеревоЗначений.РежимВыбора Тогда
			Элементы.Найти("ФормаВыбрать").Видимость = (Кнопки.НайтиПоЗначению("ОК") = Неопределено) И (Кнопки.НайтиПоЗначению("Да") = Неопределено);		
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.Свойство("КнопкаПоУмолчанию") Тогда
		ЭлементКнопки = Элементы.Найти("Форма" + Параметры.КнопкаПоУмолчанию);
		Если ЭлементКнопки <> Неопределено Тогда
			ЭлементКнопки.КнопкаПоУмолчанию = Истина;		
		КонецЕсли;
	КонецЕсли;
	
	Параметры.Свойство("ПолеКлючевогоЗначенияСтроки", ЭтаФорма.ПолеКлючевогоЗначенияСтроки);
	Параметры.Свойство("Заголовок", ЭтаФорма.Заголовок);
	Параметры.Свойство("ТекстПодсказки", ЭтаФорма.ТекстПодсказки);	
	
	Если ПустаяСтрока(ЭтаФорма.ТекстПодсказки) Тогда
		Элементы.ТекстПодсказки.Видимость = Ложь;
	КонецЕсли;
	
	// Активируем первую отмеченную строку	
	Если Параметры.Свойство("ОтмеченныеЭлементы") Тогда
		УстановитьТекущуюСтрокуДерева(Элементы.ДеревоЗначений, ЭтаФорма.ДеревоЗначений, Параметры.ОтмеченныеЭлементы);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗначенийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Не Элементы.ДеревоЗначений.РежимВыбора Тогда
		СтандартнаяОбработка = Ложь;	
		
		Если ЗначениеЗаполнено(ПолеКлючевогоЗначенияСтроки) Тогда
			ВыбранноеПоле = ПолеКлючевогоЗначенияСтроки;	
		Иначе
			ВыбранноеПоле = Поле.Имя;
		КонецЕсли;
		
		Попытка
			ОткрытьЗначение(Элемент.ТекущиеДанные[ВыбранноеПоле]);
		Исключение
			Ошибка = ИнформацияОбОшибке();
			Предупреждение(КраткоеПредставлениеОшибки(Ошибка));	
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗакрытьФорму(Команда)
	
	КодВозврата = КодВозвратаДиалога[Сред(Команда.Имя, СтрДлина("Команда") + 1)];
	
	Если Команда.Имя = "КомандаДа" ИЛИ Команда.Имя = "КомандаОК" Тогда
		УникальныйИдентификаторФормы = Неопределено;
		
		Если ТипЗнч(ЭтаФорма.ВладелецФормы) = Тип("УправляемаяФорма") Тогда
			УникальныйИдентификаторФормы = ЭтаФорма.ВладелецФормы.УникальныйИдентификатор;
		КонецЕсли;

		АдресДереваЗначений = ПоместитьДеревоВоВременноеХранилище(УникальныйИдентификаторФормы);	
	КонецЕсли;
	
	Если ЭтаФорма.ДобавленныеРеквизиты.Количество() > 0 Тогда
		ДополнительныеРеквизиты = Новый Структура;
		
		Для Каждого ДобавленныйРеквизит Из ЭтаФорма.ДобавленныеРеквизиты Цикл
			ДополнительныеРеквизиты.Вставить(ДобавленныйРеквизит.Значение, ЭтаФорма[ДобавленныйРеквизит.Значение]);		
		КонецЦикла;
	КонецЕсли;	
	
	ПараметрыЗакрытия = Новый Структура;
	ПараметрыЗакрытия.Вставить("КодВозврата", КодВозврата);
	ПараметрыЗакрытия.Вставить("АдресДереваЗначений", АдресДереваЗначений);
	ПараметрыЗакрытия.Вставить("ДополнительныеРеквизиты", ДополнительныеРеквизиты);
		
	Закрыть(ПараметрыЗакрытия);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииОтметки(Элемент)
	
	ОтметитьДочерниеЭлементы(ЭтаФорма.ДеревоЗначений.НайтиПоИдентификатору(Элементы.ДеревоЗначений.ТекущаяСтрока), Элементы.ДеревоЗначений.ТекущиеДанные.Отметка);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьДеревоВоВременноеХранилище(УникальныйИдентификаторФормы)	
	
	ДеревоОбъект = РеквизитФормыВЗначение("ДеревоЗначений");	
	
	АдресДереваЗначений = ПоместитьВоВременноеХранилище(ДеревоОбъект, УникальныйИдентификаторФормы);
	
	Возврат АдресДереваЗначений;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОтметитьДочерниеЭлементы(УзелДерева, Отметка = Неопределено)
	
	Если ТипЗнч(УзелДерева) = Тип("ДанныеФормыДерево") ИЛИ ТипЗнч(УзелДерева) = Тип("ДанныеФормыЭлементДерева") Тогда
	
		ДочерниеЭлементы = УзелДерева.ПолучитьЭлементы();
		
		Для Каждого Элемент Из ДочерниеЭлементы Цикл
			Если Отметка <> Неопределено Тогда
				Элемент.Отметка = Отметка;		
			КонецЕсли;
			
			ОтметитьДочерниеЭлементы(Элемент, Элемент.Отметка);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(УзелДерева) = Тип("ДеревоЗначений") ИЛИ ТипЗнч(УзелДерева) = Тип("СтрокаДереваЗначений") Тогда
		
		ДочерниеЭлементы = УзелДерева.Строки;
		
		Для Каждого Элемент Из ДочерниеЭлементы Цикл
			Если Отметка <> Неопределено Тогда
				Элемент.Отметка = Отметка;		
			КонецЕсли;
			
			ОтметитьДочерниеЭлементы(Элемент, Элемент.Отметка);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста 
Процедура УстановитьТекущуюСтрокуДерева(ЭлементДерева, ДанныеДерева, ОтборСтроки, ПрекратитьПоиск = Ложь) 
	
	Если ПрекратитьПоиск Тогда 
		Возврат; 
	КонецЕсли; 
		
	ДочерниеЭлементы = ДанныеДерева.ПолучитьЭлементы();
	
	Для Каждого Элемент Из ДочерниеЭлементы Цикл
		Если ПрекратитьПоиск Тогда 
			Возврат; 
		КонецЕсли; 
		
		СтрокаНайдена = Истина;
		Для Каждого Отбор Из ОтборСтроки Цикл
			Если Элемент[Отбор.Ключ] <> Отбор.Значение Тогда
				СтрокаНайдена = Ложь;
				Прервать;	
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаНайдена Тогда
			ЭлементДерева.ТекущаяСтрока = Элемент.ПолучитьИдентификатор();
			ПрекратитьПоиск = Истина;
			Возврат;
		КонецЕсли;
		
		УстановитьТекущуюСтрокуДерева(ЭлементДерева, Элемент, ОтборСтроки, ПрекратитьПоиск);
	КонецЦикла;
	
КонецПроцедуры


