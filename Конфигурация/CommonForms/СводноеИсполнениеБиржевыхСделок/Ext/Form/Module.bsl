
&НаКлиенте
Функция ПолучитьДокументы() Экспорт
	
	Документы = Новый Массив();
	
	Для каждого СтрокаЦенныеБумаги Из ЭтаФорма.ЦенныеБумаги Цикл
		Документы.Добавить(СтрокаЦенныеБумаги.ИсполнениеОбязательствПоСделке);
	КонецЦикла;
	
	Возврат Документы;
	
КонецФункции // ПолучитьДокументы


&НаСервереБезКонтекста
Функция ПолучитьВариантыСделок(Исполнения)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсполнениеОбязательствПоСделке.Основание КАК Ссылка
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|ГДЕ
		|	ИсполнениеОбязательствПоСделке.Ссылка В(&Ссылка)";
		
	Запрос.УстановитьПараметр("Ссылка", Исполнения);
	
	Возврат РаботаСЖурналамиОпераций.ПолучитьВариантыСводнойФормы(Запрос.Выполнить().Выбрать());
	
КонецФункции // ПолучитьВариантыСделок

&НаСервереБезКонтекста
Функция СформироватьКлючСводнойФормы(ПараметрыФормы)
	
	Возврат РаботаСЖурналамиОпераций.СформироватьКлючСводнойФормы("ОбщаяФорма.СводноеИсполнениеБиржевыхСделок", ПараметрыФормы);
	
КонецФункции // СформироватьКлючСводнойФормы


&НаСервере
Процедура ОбработатьДокументыНаСервере(РежимЗаписи, ПомечатьНаУдаление = Ложь)
	
	НачатьТранзакцию();
	
	Для каждого СтрокаИсполненийОбязательствПоСделкам Из Этаформа.ЦенныеБумаги Цикл
		НовыйСтатус = ?(ПомечатьНаУдаление, 0, ?(РежимЗаписи = РежимЗаписиДокумента.Проведение, 1, ЭтаФорма.Состояние));
		
		ДокументОбъект = СтрокаИсполненийОбязательствПоСделкам.ИсполнениеОбязательствПоСделке.ПолучитьОбъект();
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("КорзинаЦенныхБумаг", Истина);
		ДокументОбъект.ДополнительныеСвойства.Вставить("УникальныйИдентификатор", ЭтаФорма.УникальныйИдентификатор);
		
		Если ПомечатьНаУдаление Тогда
			Если ДокументОбъект.Проведен Тогда
				ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			ДокументОбъект.ПометкаУдаления = НЕ ДокументОбъект.ПометкаУдаления;
		КонецЕсли;
		
		ДокументОбъект.Записать(РежимЗаписи);
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
КонецПроцедуры

&НаСервере
Процедура ИзменитьНомераПозицийНаСервере()
	
	Для НомСтр = 0 По ЭтаФорма.ЦенныеБумаги.Количество() - 1 Цикл
		ЭтаФорма.ЦенныеБумаги[НомСтр].НомерПозиции = (НомСтр + 1);
	КонецЦикла;
	
КонецПроцедуры // ИзменитьНомераПозицийНаСервере

&НаСервере
Процедура ОбновитьИтогНаСервере()
	
	ИзменитьНомераПозицийНаСервере();
	
	ИтогПокупкаСумма            = 0;
	ИтогПродажаСумма            = 0;
	ИтогПокупкаСуммаКупона      = 0;
	ИтогПродажаСуммаКупона      = 0;
	ИтогПокупкаТорговаяКомиссия = 0;
	ИтогПродажаТорговаяКомиссия = 0;
	ИтогПокупкаКомиссияБрокера  = 0;
	ИтогПродажаКомиссияБрокера  = 0;
	
	Для каждого СтрокаЦБ Из ЭтаФорма.ЦенныеБумаги Цикл
		Если СтрокаЦБ.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			ИтогПокупкаСумма            = ИтогПокупкаСумма + СтрокаЦБ.Сумма;
			ИтогПокупкаСуммаКупона      = ИтогПокупкаСуммаКупона + СтрокаЦБ.СуммаКупона;
			ИтогПокупкаТорговаяКомиссия = ИтогПокупкаТорговаяКомиссия + СтрокаЦБ.ТорговаяКомиссия;
			ИтогПокупкаКомиссияБрокера  = ИтогПокупкаКомиссияБрокера + СтрокаЦБ.КомиссияБрокера;
		ИначеЕсли СтрокаЦБ.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
			ИтогПродажаСумма            = ИтогПродажаСумма + СтрокаЦБ.Сумма;
			ИтогПродажаСуммаКупона      = ИтогПродажаСуммаКупона + СтрокаЦБ.СуммаКупона;
			ИтогПродажаТорговаяКомиссия = ИтогПродажаТорговаяКомиссия + СтрокаЦБ.ТорговаяКомиссия;
			ИтогПродажаКомиссияБрокера  = ИтогПродажаКомиссияБрокера + СтрокаЦБ.КомиссияБрокера;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.Итоги.Заголовок = 
		?(ИтогПокупкаСумма + ИтогПокупкаСуммаКупона + ИтогПокупкаТорговаяКомиссия + ИтогПокупкаКомиссияБрокера = 0, "",
			"Покупка: " + ИтогПокупкаСумма + ?(ЭтаФорма.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации, ", купон " + ИтогПокупкаСуммаКупона + ", итого " + (ИтогПокупкаСумма + ИтогПокупкаСуммаКупона), "")
				+  ", комиссия биржи " + ИтогПокупкаТорговаяКомиссия + ", комиссия брокера " + ИтогПокупкаКомиссияБрокера + Символы.ВК + Символы.ПС) + 
		?(ИтогПродажаСумма + ИтогПродажаСуммаКупона + ИтогПродажаТорговаяКомиссия + ИтогПродажаКомиссияБрокера = 0, "",
			"Продажа: " + ИтогПродажаСумма + ?(ЭтаФорма.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации, ", купон " + ИтогПродажаСуммаКупона + ", итого " + (ИтогПродажаСумма + ИтогПродажаСуммаКупона), "")
				+ ", комиссия биржи " + ИтогПродажаТорговаяКомиссия + ", комиссия брокера " + ИтогПродажаКомиссияБрокера);
				
КонецПроцедуры

&НаСервере
Процедура ОбновитьФормуНаСервере()

	РаботаСОтчетами.КонтрольМультивалютностиРасходовПоСделкам(ЭтаФорма.СчетДоверительногоУправления, НачалоДня(ЭтаФорма.Дата), КонецДня(ЭтаФорма.Дата)); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(РасходыПоТорговойКомиссии.Сделка, РасходыПоБрокерскойКомиссии.Сделка) КАК Сделка,
		|	ЕСТЬNULL(РасходыПоТорговойКомиссии.ЦеннаяБумага, РасходыПоБрокерскойКомиссии.ЦеннаяБумага) КАК ЦеннаяБумага,
		|	РасходыПоТорговойКомиссии.Валюта КАК ВалютаТорговойКомиссии,
		|	РасходыПоТорговойКомиссии.СуммаОборот КАК ТорговаяКомиссия,
		|	РасходыПоБрокерскойКомиссии.Валюта КАК ВалютаКомиссииБрокера,
		|	РасходыПоБрокерскойКомиссии.СуммаОборот КАК КомиссияБрокера
		|ПОМЕСТИТЬ ВТ_КомиссииПоСделке
		|ИЗ
		|	РегистрНакопления.РасходыПоСделке.Обороты(
		|			,
		|			,
		|			Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = &Рынок
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)) КАК РасходыПоТорговойКомиссии
		|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке.Обороты(
		|				,
		|				,
		|				Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И Рынок = &Рынок
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)) КАК РасходыПоБрокерскойКомиссии
		|		ПО РасходыПоТорговойКомиссии.Организация = РасходыПоБрокерскойКомиссии.Организация
		|			И РасходыПоТорговойКомиссии.СчетДоверительногоУправления = РасходыПоБрокерскойКомиссии.СчетДоверительногоУправления
		|			И РасходыПоТорговойКомиссии.Сделка = РасходыПоБрокерскойКомиссии.Сделка
		|			И РасходыПоТорговойКомиссии.Рынок = РасходыПоБрокерскойКомиссии.Рынок
		|			И РасходыПоТорговойКомиссии.ЦеннаяБумага = РасходыПоБрокерскойКомиссии.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	0 КАК НомерПозиции,
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.Количество КАК Количество,
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.Цена КАК Цена,
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.ЦенаПроцент КАК ЦенаПроцент,
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.Сумма КАК Сумма,
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.СуммаКупона КАК СуммаКупона,
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка КАК ИсполнениеОбязательствПоСделке,
		|	ВТ_КомиссииПоСделке.ТорговаяКомиссия КАК ТорговаяКомиссия,
		|	ВТ_КомиссииПоСделке.КомиссияБрокера КАК КомиссияБрокера,
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.ВидСделки КАК ВидСделки,
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.Основание.Дата КАК ДатаСделки,
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.Основание.НомерСделки КАК НомерСделки,
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.Основание.КодРасчетовНаБирже КАК КодРасчетовНаБирже
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК ИсполнениеОбязательствПоСделкеЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КомиссииПоСделке КАК ВТ_КомиссииПоСделке
		|		ПО ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.Основание = ВТ_КомиссииПоСделке.Сделка
		|			И ИсполнениеОбязательствПоСделкеЦенныеБумаги.ЦеннаяБумага = ВТ_КомиссииПоСделке.ЦеннаяБумага
		|ГДЕ
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.Организация = &Организация
		|	И НАЧАЛОПЕРИОДА(ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
		|	И ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.Брокер = &Брокер
		|	И ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.МестоХранения = &МестоХранения
		|	И ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.Рынок = &Рынок
		|	И ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.ПометкаУдаления = &ПометкаУдаления
		|	И ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.Проведен = &Проведен
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСделки";
		
	Запрос.УстановитьПараметр("Дата",                         ЭтаФорма.Дата);	
	Запрос.УстановитьПараметр("Организация",                  ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("МестоХранения",                ЭтаФорма.МестоХранения);
	Запрос.УстановитьПараметр("Брокер",                       ЭтаФорма.Брокер);
	Запрос.УстановитьПараметр("Рынок",                        ЭтаФорма.Рынок);
	Запрос.УстановитьПараметр("ПометкаУдаления",              (ЭтаФорма.Состояние = Перечисления.СостоянияДокументов.ПомеченНаУдаление));
	Запрос.УстановитьПараметр("Проведен",                     (ЭтаФорма.Состояние = Перечисления.СостоянияДокументов.Проведен));

	ЗначениеВРеквизитФормы(Запрос.Выполнить().Выгрузить(), "ЦенныеБумаги");

	ОбновитьИтогНаСервере();
	
КонецПроцедуры // ОбновитьФорму

&НаСервере
Функция ИсполнениеОбязательствПоСделкеПодходитНаСервере(ИзмененноеИсполнениеОбязательствПоСделке)

	Возврат ЭтаФорма.МестоХранения = ИзмененноеИсполнениеОбязательствПоСделке.МестоХранения
		И ЭтаФорма.Брокер = ИзмененноеИсполнениеОбязательствПоСделке.Брокер
		И ЭтаФорма.Организация = ИзмененноеИсполнениеОбязательствПоСделке.Организация
		И ЭтаФорма.Рынок = ИзмененноеИсполнениеОбязательствПоСделке.Рынок
		И ЭтаФорма.СчетДоверительногоУправления = ИзмененноеИсполнениеОбязательствПоСделке.СчетДоверительногоУправления
		И НачалоДня(ЭтаФорма.Дата) = НачалоДня(ИзмененноеИсполнениеОбязательствПоСделке.Дата);

КонецФункции

&НаСервере
Процедура ОбновитьПоИсполнениюОбязательствПоСделкеНаСервере(ИзмененноеИсполнениеОбязательствПоСделке)

	СтрокиИсполненийОбязательствПоСделкам = ЭтаФорма.ЦенныеБумаги.НайтиСтроки(Новый Структура("ИсполнениеОбязательствПоСделке", ИзмененноеИсполнениеОбязательствПоСделке));
	
	Если СтрокиИсполненийОбязательствПоСделкам.Количество() = 0 Тогда // не было такой сделки у нас
		Если ИсполнениеОбязательствПоСделкеПодходитНаСервере(ИзмененноеИсполнениеОбязательствПоСделке) Тогда // надо добавить
			Для каждого СтрокаЦБ Из ИзмененноеИсполнениеОбязательствПоСделке.ЦенныеБумаги Цикл
				НоваяСтрока = Этаформа.ЦенныеБумаги.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЦБ);
				
				НоваяСтрока.ВидСделки		               = ИзмененноеИсполнениеОбязательствПоСделке.ВидСделки;
				НоваяСтрока.ИсполнениеОбязательствПоСделке = ИзмененноеИсполнениеОбязательствПоСделке;
			КонецЦикла;
		КонецЕсли;
		
	Иначе // была такая сделка у нас
		Если ИсполнениеОбязательствПоСделкеПодходитНаСервере(ИзмененноеИсполнениеОбязательствПоСделке) Тогда // обновим её
			Для каждого СтрокаЦБ Из ИзмененноеИсполнениеОбязательствПоСделке.ЦенныеБумаги Цикл
				Для каждого СтрокаИсполненийОбязательствПоСделкам Из СтрокиИсполненийОбязательствПоСделкам Цикл
					Если СтрокаИсполненийОбязательствПоСделкам.ЦеннаяБумага <> СтрокаЦБ.ЦеннаяБумага Тогда
						Продолжить;
					КонецЕсли;
					
					ЗаполнитьЗначенияСвойств(СтрокаИсполненийОбязательствПоСделкам, СтрокаЦБ);
					
					СтрокаИсполненийОбязательствПоСделкам.ВидСделки               = ИзмененноеИсполнениеОбязательствПоСделке.ВидСделки;
					СтрокаИсполненийОбязательствПоСделкам.ИсполнениеОбязательствПоСделке                  = ИзмененноеИсполнениеОбязательствПоСделке;
				КонецЦикла;
			КонецЦикла;
		Иначе // была, да сплыла
			Для каждого СтрокаИсполненийОбязательствПоСделкам Из СтрокиИсполненийОбязательствПоСделкам Цикл
				ЭтаФорма.ЦенныеБумаги.Удалить(СтрокаИсполненийОбязательствПоСделкам);
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьИтогНаСервере();
	
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Дата                         = ЭтаФорма.Параметры.Дата;
	ЭтаФорма.Организация                  = ЭтаФорма.Параметры.Организация;
	ЭтаФорма.СчетДоверительногоУправления = ЭтаФорма.Параметры.СчетДоверительногоУправления;
	ЭтаФорма.МестоХранения                = ЭтаФорма.Параметры.МестоХранения;
	ЭтаФорма.Брокер                       = ЭтаФорма.Параметры.Брокер;
	ЭтаФорма.Рынок                        = ЭтаФорма.Параметры.Рынок;
	ЭтаФорма.Состояние                    = ЭтаФорма.Параметры.Состояние;
	
	ЭтаФорма.Заголовок = "Сводное исполнение биржевых сделок от " + Формат(ЭтаФорма.Дата) + " (" + НРег(ЭтаФорма.Состояние) + ")";
	
	Если Не ЗначениеЗаполнено(Этаформа.Организация) Тогда
		Этаформа.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	КонецЕсли;
	
	Если ЭтаФорма.Рынок <> Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		ЭтаФорма.Элементы.ЦенныеБумагиЦенаПроцент.Видимость = Ложь;
		ЭтаФорма.Элементы.ЦенныеБумагиСуммаКупона.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ОписаниеОтбора.Заголовок = "Исполнение обязательств по сделкам " + Формат(ЭтаФорма.Дата, "ДФ=dd.MM.yyyy") + ", "
		+ ЭтаФорма.СчетДоверительногоУправления + ", " + ЭтаФорма.Рынок + ", " + ЭтаФорма.МестоХранения + ", " + ЭтаФорма.Брокер + ".";
	
	ОбновитьФормуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "СводноеИсполнениеБиржевыхСделок.Обновить" Тогда
		ОбновитьПоИсполнениюОбязательствПоСделкеНаСервере(Параметр)
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ЦенныеБумагиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОткрытьФорму("Документ.ИсполнениеОбязательствПоСделке.ФормаОбъекта", Новый Структура("Ключ", Элемент.ТекущиеДанные.ИсполнениеОбязательствПоСделке));
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	
	Если НЕ Копирование Тогда
	    ОткрытьФормуМодально("Документ.ИсполнениеОбязательствПоСделке.ФормаОбъекта", 
			Новый Структура("ЗначенияЗаполнения", 
			Новый Структура("Дата, МестоХранения, Брокер, СчетДоверительногоУправления, Рынок, Организация",
				Этаформа.Дата,
				Этаформа.МестоХранения,
				Этаформа.Брокер,
				Этаформа.СчетДоверительногоУправления,
				Этаформа.Рынок,
				Этаформа.Организация)));
	Иначе
		ОткрытьФормуМодально("Документ.ИсполнениеОбязательствПоСделке.ФормаОбъекта", Новый Структура("ЗначениеКопирования", Элемент.ТекущиеДанные.ИсполнениеОбязательствПоСделке));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
КонецПроцедуры


&НаКлиенте
Процедура КомандаПровестиИЗакрыть(Команда)
	
	ОбработатьДокументыНаСервере(РежимЗаписиДокумента.Проведение);
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаписать(Команда)
	
	ОбработатьДокументыНаСервере(РежимЗаписиДокумента.Запись);
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПровести(Команда)
	
	ОбработатьДокументыНаСервере(РежимЗаписиДокумента.Проведение);
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПометитьНаУдаление(Команда)
	
	Если ЭтаФорма.Состояние = 0 Тогда //Удален
		Если Вопрос("Подтвердите отмену удаления объекта!", РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да) = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		ЭтаФорма.Состояние = 2;
	Иначе
		Если Вопрос("Объект будет помечен на удаление!", РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да) = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		ЭтаФорма.Состояние = 0;
	КонецЕсли;
	ОбработатьДокументыНаСервере(РежимЗаписиДокумента.Запись, Истина);
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтменаПроведения(Команда)
	
	ОбработатьДокументыНаСервере(РежимЗаписиДокумента.ОтменаПроведения);
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПеречитать(Команда)
	
	ОбновитьФормуНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПерейтиКСводнойСделке(Команда)
	
	Исполнения = Новый Массив();
	
	Для каждого СтрокаЦенныеБумаги Из ЭтаФорма.ЦенныеБумаги Цикл
		Исполнения.Добавить(СтрокаЦенныеБумаги.ИсполнениеОбязательствПоСделке);
	КонецЦикла;
	
	ВариантыСделок = ПолучитьВариантыСделок(Исполнения);
	
	РеквизитыСводнойФормыИсполнения = Неопределено;
	
	Если      ВариантыСделок.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По данным исполнениям сделки отсутствуют.");
		Возврат;
		
	ИначеЕсли ВариантыСделок.Количество() = 1 Тогда
		РеквизитыСводнойФормыИсполнения = ВариантыСделок[0];
		
	Иначе
		РеквизитыСводнойФормыИсполнения = ОткрытьФормуМодально("Обработка.ЖурналыОпераций.Форма.ВыборВариантаСводнойФормыИсполненияСделки",
			Новый Структура("ВариантыСводнойФормы, НеОтображатьПоля, Заголовок", ВариантыСделок, "ЦеннаяБумага, Документ, ВидДокумента", "Выбор варианта сводной биржевой сделки"),
			ЭтаФорма);
			
		Если РеквизитыСводнойФормыИсполнения = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ОткрытьФорму("ОбщаяФорма.СводнаяБиржеваяСделка", РеквизитыСводнойФормыИсполнения, ЭтаФорма, СформироватьКлючСводнойФормы(РеквизитыСводнойФормыИсполнения));
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПроводкиДокумента(Команда)
	
	ТекущиеДанные = ЭтаФорма.Элементы.ЦенныеБумаги.ТекущиеДанные;
		
	Если ТекущиеДанные <> Неопределено Тогда
		
		ОткрытьФорму("ОбщаяФорма.ПроводкиДокумента", 
			Новый Структура("Регистратор", ТекущиеДанные.ИсполнениеОбязательствПоСделке), 
			ЭтаФорма, 
			Истина);
		
	КонецЕсли;
	
КонецПроцедуры
