
#Область Обработчики_событий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.ДатаРасчета = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДата()), -2);
	
	ЭтаФорма.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;
	
	Если Не РаботаСПользователями.ЭтоПолноправныйПользователь() Тогда
		
		Элементы.ЗакрытиеПериодаГруппаАтомарныеОперации.Видимость					 = Ложь;
		Элементы.ЗакрытиеПериодаДатаЗапретаРедактированияПартий.Видимость			 = Ложь;
		Элементы.ОтображатьСообщенияОДинамическомРасчетеПартий.Видимость			 = Ложь;
		Элементы.ОтображатьСостоянияПоследовательности.Видимость					 = Ложь;
		Элементы.ЗакрытиеПериодаКомандаУстановитьДатыЗапретаРедактирования.Видимость = РольДоступна(Метаданные.Роли.ИзменениеДатЗапретаРедактирования);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Заполнение при открытии отключаем для ускорения работы.
	// Пользователи все равно после открытия изменяют параметры
	//РежимОтбораПриИзменении(Неопределено);      	
	
	НастроитьВидимостьДоступностьЭлементовФормы();
	ОбновитьЗаголовокУниверсальногоОтбора()
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ДатаРасчетаПриИзменении(Элемент)
	
	ОбновитьЗакрытиеПериодаНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура РежимОтбораПриИзменении(Элемент)
	
	НастроитьВидимостьДоступностьЭлементовФормы();
	
	Если (ЭтаФорма.РежимОтбора = 0 И ЗначениеЗаполнено(ЭтаФорма.ИнвестСтратегия))
			Или (ЭтаФорма.РежимОтбора = 1 И ЗначениеЗаполнено(ЭтаФорма.СчетДоверительногоУправления))
			Или (ЭтаФорма.РежимОтбора = 2 И ЗначениеЗаполнено(ЭтаФорма.ВидДоговораДоверительногоУправления))
			Или (ЭтаФорма.РежимОтбора = 4 И ЗначениеЗаполнено(ЭтаФорма.КлиентДоверительногоУправления))
			Или (ЭтаФорма.РежимОтбора = 3)
			Или (ЭтаФорма.РежимОтбора = 5)
			Или (ЭтаФорма.РежимОтбора = 6)
			Или (ЭтаФорма.РежимОтбора = 7)
			Или (ЭтаФорма.РежимОтбора = 8)
	Тогда
		ОбновитьЗакрытиеПериодаНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвестСтратегияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ЭтаФорма.ИнвестСтратегия) Тогда
		ОбновитьЗакрытиеПериодаНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	НастроитьВидимостьДоступностьЭлементовФормы();
	
	Если ЗначениеЗаполнено(ЭтаФорма.СчетДоверительногоУправления) Тогда
		ОбновитьЗакрытиеПериодаНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидДоговораДоверительногоУправленияПриИзменении(Элемент)
	
	НастроитьВидимостьДоступностьЭлементовФормы();
	
	Если ЗначениеЗаполнено(ЭтаФорма.ВидДоговораДоверительногоУправления) Тогда
		ОбновитьЗакрытиеПериодаНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентДоверительногоУправленияПриИзменении(Элемент)
	
	НастроитьВидимостьДоступностьЭлементовФормы();
	
	Если ЗначениеЗаполнено(ЭтаФорма.КлиентДоверительногоУправления) Тогда
		ОбновитьЗакрытиеПериодаНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УниверсальныйОтборСчетПриИзменении(Элемент)
	
	ОбновитьЗаголовокУниверсальногоОтбора();
	
	Если ЭтаФорма.УниверсальныйОтборСчет.Количество() > 0
			Или ЭтаФорма.УниверсальныйОтборКлиент.Количество() > 0
			Или ЭтаФорма.УниверсальныйОтборВидДоговора.Количество() > 0 Тогда
		ОбновитьЗакрытиеПериодаНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УниверсальныйОтборКлиентПриИзменении(Элемент)
	
	ОбновитьЗаголовокУниверсальногоОтбора();
	
	Если ЭтаФорма.УниверсальныйОтборСчет.Количество() > 0
			Или ЭтаФорма.УниверсальныйОтборКлиент.Количество() > 0
			Или ЭтаФорма.УниверсальныйОтборВидДоговора.Количество() > 0 Тогда
		ОбновитьЗакрытиеПериодаНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УниверсальныйОтборВидДоговораПриИзменении(Элемент)
	
	ОбновитьЗаголовокУниверсальногоОтбора();
	
	Если ЭтаФорма.УниверсальныйОтборСчет.Количество() > 0
			Или ЭтаФорма.УниверсальныйОтборКлиент.Количество() > 0
			Или ЭтаФорма.УниверсальныйОтборВидДоговора.Количество() > 0 Тогда
		ОбновитьЗакрытиеПериодаНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗаголовокУниверсальногоОтбора()
	
	Если ЭтаФорма.УниверсальныйОтборСчет.Количество() > 0
			Или ЭтаФорма.УниверсальныйОтборКлиент.Количество() > 0
			Или ЭтаФорма.УниверсальныйОтборВидДоговора.Количество() > 0 Тогда
		ЭтаФорма.ЗаголовокУниверсальногоОтбора = 
			"Задано счетов: " 	  + ЭтаФорма.УниверсальныйОтборСчет.Количество() +
			", клиентов: " 	  	  + ЭтаФорма.УниверсальныйОтборКлиент.Количество() +
			", видов договоров: " + ЭтаФорма.УниверсальныйОтборВидДоговора.Количество();
	Иначе
		ЭтаФорма.ЗаголовокУниверсальногоОтбора = "не задан";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОтборУниверсальный(Команда)
	
	УниверсальныйОтборСчет.Очистить();
	УниверсальныйОтборКлиент.Очистить();
	УниверсальныйОтборВидДоговора.Очистить();
	
	ОбновитьЗаголовокУниверсальногоОтбора();
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьОтборУниверсальный(Команда)
	
	ОписаниеНастроек = РаботаСФормамиКлиент.ПолучитьНастройкиИзХранилищаВариантовИНастроекОтчетов(
		ЭтаФорма.ИмяФормы, ЭтаФорма.КлючНастроекУниверсальногоОтбора);
	
	Если ОписаниеНастроек <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ОписаниеНастроек.Настройки);
		ОбновитьЗаголовокУниверсальногоОтбора();
		Если ЭтаФорма.УниверсальныйОтборСчет.Количество() > 0
				Или ЭтаФорма.УниверсальныйОтборКлиент.Количество() > 0
				Или ЭтаФорма.УниверсальныйОтборВидДоговора.Количество() > 0 Тогда
			ОбновитьЗакрытиеПериодаНаСервере();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьОтборУниверсальный(Команда)
	
	Настройки = Новый Структура("УниверсальныйОтборСчет, УниверсальныйОтборКлиент, УниверсальныйОтборВидДоговора");
	ЗаполнитьЗначенияСвойств(Настройки, ЭтаФорма);
	
	РаботаСФормамиКлиент.СохранитьНастройкиВХранилищеВариантовИНастроекОтчетов(
		ЭтаФорма.ИмяФормы, ЭтаФорма.КлючНастроекУниверсальногоОтбора, Настройки);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытиеПериодаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ЗакрытиеПериодаРегистрацияСтоимостиАктивов" Тогда
		ВыбЗначение = ЭтаФорма.ЗакрытиеПериода.НайтиПоИдентификатору(ВыбраннаяСтрока).РегистрацияСтоимостиАктивов
	ИначеЕсли Поле.Имя = "ЗакрытиеПериодаНачислениеИСписаниеРезервов" Тогда
		ВыбЗначение = ЭтаФорма.ЗакрытиеПериода.НайтиПоИдентификатору(ВыбраннаяСтрока).НачислениеИСписаниеРезервов;
	ИначеЕсли Поле.Имя = "ЗакрытиеПериодаСчетДоверительногоУправления" Тогда
		ВыбЗначение = ЭтаФорма.ЗакрытиеПериода.НайтиПоИдентификатору(ВыбраннаяСтрока).СчетДоверительногоУправления;
	ИначеЕсли Поле.Имя = "ЗакрытиеПериодаГраницаПоследовательности" Тогда
		ВыбЗначение = ЭтаФорма.ЗакрытиеПериода.НайтиПоИдентификатору(ВыбраннаяСтрока).ГраницаПоследовательности;
	ИначеЕсли Поле.Имя = "ЗакрытиеПериодаТочкаАктуальности" Тогда
		ВыбЗначение = ЭтаФорма.ЗакрытиеПериода.НайтиПоИдентификатору(ВыбраннаяСтрока).ТочкаАктуальности;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыбЗначение) Тогда
		ОткрытьЗначение(ВыбЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображатьКоличествоОперацийПриИзменении(Элемент)
	
	НастроитьВидимостьДоступностьЭлементовФормы();
	
	ОбновитьЗакрытиеПериодаНаСервере();
	
КонецПроцедуры

&НаКлиенте
