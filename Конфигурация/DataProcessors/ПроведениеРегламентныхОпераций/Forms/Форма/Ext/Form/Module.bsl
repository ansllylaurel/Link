КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьЗакрытиеПериода(Команда)
	
	ОбновитьЗакрытиеПериодаНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗарегистрироватьСтоимостьАктивов(Команда)
	// Для контроля акцептов есть отдельная атомарная операция, поэтому здесь ее не выполняем
	ТребуетсяКонтрольАкцептов = Ложь;
	ЗарегистрироватьОперации(,, Истина,, ТребуетсяКонтрольАкцептов);
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗарегистрироватьОперации(Команда)
	
	ОтчетОРезультатахВыполнения = Неопределено;
	
	КлиентыСРегистрациейСЧАПоНерабочимДням = Новый Структура;
	КлиентыСРегистрациейСЧАПоНерабочимДням.Вставить("ЕстьДокументы",	Ложь);
	КлиентыСРегистрациейСЧАПоНерабочимДням.Вставить("Даты",				Новый Массив);
	
	ТекстВопроса	= "";
	ЕстьДокументы	= Ложь;
	
	НачалоПериода = ПолучитьСледующийДеньПослеПоследнегоРабочегоДня(Объект.ДатаРасчета);
	
	Если Объект.ДатаРасчета > НачалоПериода Тогда
		
		КонецПериода = Объект.ДатаРасчета - 60*60*24;
		
		ЗаполнитьКлиентовСРегистрациейСЧАПоНерабочимДнямНаСервере(КлиентыСРегистрациейСЧАПоНерабочимДням, НачалоПериода, КонецПериода);
		
		ЕстьДокументы = КлиентыСРегистрациейСЧАПоНерабочимДням.ЕстьДокументы;
		
		Если КлиентыСРегистрациейСЧАПоНерабочимДням.Даты.Количество() > 0 Тогда
			
			НаборДатДляОтчета = Новый Массив;
			
			ТекстВопроса = "Обнаружены незакрытые нерабочие дни, предшествующие текущему, на которые должны быть зарегистрирована СЧА, но документы отсутствуют:";
			
			Для Каждого ТекДата Из КлиентыСРегистрациейСЧАПоНерабочимДням.Даты Цикл
				
				ТекстВопроса = ТекстВопроса + Символы.ПС + Формат(ТекДата.Дата, "ДФ=dd.MM.yyyy") + " по клиентам:";
				
				Для Каждого ТекКлиент Из ТекДата.СчетаДоверительногоУправления Цикл
					ТекстВопроса = ТекстВопроса + Символы.ПС + Символы.Таб + ТекКлиент;
				КонецЦикла;
				
				НаборДатДляОтчета.Добавить(ТекДата.Дата);
				
			КонецЦикла;
			
			НаборДатДляОтчета.Добавить(Объект.ДатаРасчета);
			
			ТекстВопроса = ТекстВопроса + Символы.ПС
							+ "Такие дни и клиенты также будут обработаны.";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЕстьДокументы Тогда
		
		Для Каждого СтрокаЗакрытиеПериода Из ЭтаФорма.ЗакрытиеПериода Цикл
			
			Если СтрокаЗакрытиеПериода.Флажок Тогда
				
				Если ЗначениеЗаполнено(СтрокаЗакрытиеПериода.РегистрацияСтоимостиАктивов) Тогда
					ЕстьДокументы = Истина;
					Прервать;
				КонецЕсли;
				
			КонецЕсли;
				
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЕстьДокументы Тогда
		
		ТекстВопроса = ?(ТекстВопроса <> "", ТекстВопроса + Символы.ПС, "") + "Ранее созданные операции будут перезаполнены" + Символы.ПС + "Продолжить?";
		
		Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если КлиентыСРегистрациейСЧАПоНерабочимДням.Даты.Количество() > 0 Тогда
		
		ДатаРасчета = Объект.ДатаРасчета;
		
		ВыбранныеСчета = ПолучитьВыбранныеСчетаДоверительногоУправленияНаСервере();
		
		ОтчетОРезультатахВыполнения = ИнициализироватьОтчетОРезультатахВыполненияНаСервере(НаборДатДляОтчета);
		
		Для Каждого ТекДата Из КлиентыСРегистрациейСЧАПоНерабочимДням.Даты Цикл
			
			Если ЗарегистрироватьОперацииЗаДень(ТекДата.Дата, ТекДата.СчетаДоверительногоУправления, ОтчетОРезультатахВыполнения) = Неопределено Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Объект.ДатаРасчета = ДатаРасчета;
		
		ОбновитьЗакрытиеПериодаНаСервере(Ложь);
		
		Для каждого Элемент Из ЭтотОбъект.ЗакрытиеПериода Цикл
			Элемент.Флажок = (ВыбранныеСчета.Найти(Элемент.СчетДоверительногоУправления) <> Неопределено);
		КонецЦикла;
		
	КонецЕсли;
	
	СтрокиСРучнымВВодом = ЭтаФорма.ЗакрытиеПериода.НайтиСтроки(Новый Структура("Флажок, РучнойВвод", Истина, Истина));
	
	СтрокиСРучнаяКорректировкаНачисленияИСписаниеРезервов = ЭтаФорма.ЗакрытиеПериода.НайтиСтроки(Новый Структура("Флажок, РучнаяКорректировкаНачисленияИСписаниеРезервов", Истина, Истина));
	
	Если СтрокиСРучнымВВодом.Количество() > 0 Или СтрокиСРучнаяКорректировкаНачисленияИСписаниеРезервов.Количество() > 0 Тогда
		
		ПараметрЗакрытиеПериода = Новый Массив;
		Для Каждого Строка Из СтрокиСРучнымВВодом Цикл
			
			СтруктураСтроки = Новый Структура("СчетДоверительногоУправления, КодСчетаДоверительногоУправления, РегистрацияСтоимостиАктивов, 
												|ОписаниеНастроекРасчета, РучнойВвод");
			ЗаполнитьЗначенияСвойств(СтруктураСтроки, Строка);
			СтруктураСтроки.Вставить("ИсходныйИдентификатор", Строка.ПолучитьИдентификатор());
			
			ПараметрЗакрытиеПериода.Добавить(СтруктураСтроки);
			
		КонецЦикла; 
		
		Для Каждого Строка Из СтрокиСРучнаяКорректировкаНачисленияИСписаниеРезервов Цикл
			
			СтруктураСтроки = Новый Структура("СчетДоверительногоУправления, КодСчетаДоверительногоУправления, РегистрацияСтоимостиАктивов, 
												|ОписаниеНастроекРасчета, РучнойВвод");
			
			СтруктураСтроки.СчетДоверительногоУправления = Строка.СчетДоверительногоУправления;
			СтруктураСтроки.КодСчетаДоверительногоУправления = Строка.КодСчетаДоверительногоУправления;
			СтруктураСтроки.РегистрацияСтоимостиАктивов = Строка.НачислениеИСписаниеРезервов;
			СтруктураСтроки.ОписаниеНастроекРасчета = Строка.ОписаниеНастроекРасчета;
			СтруктураСтроки.РучнойВвод = Строка.РучнаяКорректировкаНачисленияИСписаниеРезервов;
			
			СтруктураСтроки.Вставить("ИсходныйИдентификатор", Строка.ПолучитьИдентификатор());
			
			ПараметрЗакрытиеПериода.Добавить(СтруктураСтроки);
			
		КонецЦикла; 
		
		
		ДокументыКПерезаполнению = ОткрытьФормуМодально("Обработка.ПроведениеРегламентныхОпераций.Форма.ФормаВыбораДействия", Новый Структура("ЗакрытиеПериода", ПараметрЗакрытиеПериода));
		
		Если ТипЗнч(ДокументыКПерезаполнению) <> Тип("Массив") Тогда
			Возврат;
		КонецЕсли; 
	
	КонецЕсли; 
	
	ЗарегистрироватьОперации(Истина, ОтчетОРезультатахВыполнения, Истина, ДокументыКПерезаполнению);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗарегистрироватьОперацииЗаПериод(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Период", Новый СтандартныйПериод(Объект.ДатаРасчета, Объект.ДатаРасчета));
	
	ИмяОбъекта	= Лев(ЭтаФорма.ИмяФормы, СтрНайти(ЭтаФорма.ИмяФормы, ".", , , 2) - 1);
	НастройкиРегистрацииЗаПериод = ОткрытьФормуМодально(ИмяОбъекта + ".Форма.ВыборПериода", ПараметрыФормы, ЭтаФорма);
	
	Если ТипЗнч(НастройкиРегистрацииЗаПериод) = Тип("Структура") Тогда
	
		НаборДат = НастройкиРегистрацииЗаПериод.НаборДат;
		Если ТипЗнч(НаборДат) <> Тип("Массив") Или НаборДат.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ТекстВопроса = "";
		Если Не НастройкиРегистрацииЗаПериод.Свойство("ТекстВопроса", ТекстВопроса) Тогда
			ТекстВопроса = "Подтвердите, пожалуйста, запуск регистрации стоимостей за " + НаборДат.Количество() + " дн. Ранее заполненные операции при этом будут перезаполнены.";
		КонецЕсли; 
		
		Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ОКОтмена) <> КодВозвратаДиалога.ОК Тогда
			Возврат;
		КонецЕсли;
		
		ДокументыКПерезаполнению = Неопределено;
		
		#Область Документы_с_ручным_вводом
		ВыделенныеСтроки = ЭтаФорма.ЗакрытиеПериода.НайтиСтроки(Новый Структура("Флажок", Истина));
		Если ВыделенныеСтроки.Количество() > 0 Тогда
			
			СчетаДУ = Новый Массив;
			Для каждого Строка Из ВыделенныеСтроки Цикл
				СчетаДУ.Добавить(Строка.СчетДоверительногоУправления);
			КонецЦикла; 
			
			ПараметрЗакрытиеПериода = ПолучитьДокументыСручнымВводом(СчетаДУ, НаборДат);
			
			Если ПараметрЗакрытиеПериода.Количество() > 0 Тогда
			
				ДокументыКПерезаполнению = ОткрытьФормуМодально("Обработка.ПроведениеРегламентныхОпераций.Форма.ФормаВыбораДействия", Новый Структура("ЗакрытиеПериода", ПараметрЗакрытиеПериода));
				
				Если ТипЗнч(ДокументыКПерезаполнению) <> Тип("Массив") Тогда
					Возврат;		
				КонецЕсли; 				
			
			КонецЕсли; 
		
		КонецЕсли;			
		#КонецОбласти 
		
		ЗарегистрироватьОперацииЗаПериод(НаборДат, НастройкиРегистрацииЗаПериод.СоздаватьНедостающие, ДокументыКПерезаполнению, НастройкиРегистрацииЗаПериод.ПерезаполнитьБезУчетаНастроекРегламентныхДействий);
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗарегистрироватьНедостающиеОперации(Команда)
	ЗарегистрироватьОперации();
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьДатыЗапретаРедактирования(Команда)
	
	ВыбДоверительногоУправления = Новый СписокЗначений;
	ВыбДоверительногоУправления.ЗагрузитьЗначения(ПолучитьВыбранныеСчетаДоверительногоУправленияНаСервере());
	
	Если ВыбДоверительногоУправления.Количество() = 0 Тогда
		Сообщить("Не выбраны счета доверительного управления для обработки");
		Возврат;
	Иначе
		Для каждого Элемент Из ВыбДоверительногоУправления Цикл
			Элемент.Пометка = Истина;
		КонецЦикла;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("СчетаДоверительногоУправления", ВыбДоверительногоУправления);
	ПараметрыФормы.Вставить("ИмяКолонки", "БэкОфис");
	
	ОткрытьФормуМодально("РегистрСведений.ДатыЗапретаРедактирования.Форма.УстановкаДатыЗапрета", ПараметрыФормы, ЭтаФорма);
	
	ОбновитьЗакрытиеПериодаНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаНумерацияДокументов(Команда)
	
	ПараметрыФормы = Новый Структура("Период", Новый СтандартныйПериод(Объект.ДатаРасчета, Объект.ДатаРасчета));
	
	ОткрытьФорму("Обработка.НумерацияДокументов.Форма", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаКонтрольАкцептов(Команда)
		
	ВидыДоговоровДоверительногоУправления = Новый СписокЗначений;
	ВидыДоговоровДоверительногоУправления.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда"));
	Период = Новый СтандартныйПериод(Объект.ДатаРасчета, Объект.ДатаРасчета);
	
	НастройкиОтчета = Новый Структура;
	НастройкиОтчета.Вставить("Организация", 							Объект.Организация);		
	НастройкиОтчета.Вставить("ВидыДоговоровДоверительногоУправления",	ВидыДоговоровДоверительногоУправления);	
	НастройкиОтчета.Вставить("Период", 									Период);
	НастройкиОтчета.Вставить("ВыводитьАкцептованныеДокументы", 			Ложь);
	
	ДополнительныеПараметры = Новый Структура;
	
	ДополнительныеПараметры.Вставить("НастройкиОтчета", 		НастройкиОтчета);
	ДополнительныеПараметры.Вставить("СформироватьПриОткрытии", Истина);

	ФормаОтчета = ПолучитьФорму("Отчет.КонтрольАкцептованияОпераций.Форма", ДополнительныеПараметры);	
		
	ФормаОтчета.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыполнитьКонтрольАкцептов(Команда)
	
	ОтчетОРезультатах = ИнициализироватьОтчетОРезультатахВыполненияНаСервере();
	
	Отказ = Ложь;
	ВыполнитьКонтрольАкцептовНаСервере(ОтчетОРезультатах, Отказ);
	
	Если Не Отказ Тогда
		ОтчетОРезультатах.Показать("Результат проверки");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаДополнительныеДатыРасчетаСЧА(Команда)
			
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Организация",						Объект.Организация);
	ПараметрыФормы.Вставить("СчетаДоверительногоУправления", 	ПолучитьВыбранныеСчетаДоверительногоУправленияНаСервере());
	ПараметрыФормы.Вставить("ДатаСЧА", 							Объект.ДатаРасчета);
	
	ЕстьНовыеЗаписиДатСЧА = ОткрытьФормуМодально("РегистрСведений.ДополнительныеДатыРасчетаСЧА.Форма.ДобавлениеЗаписей", ПараметрыФормы, ЭтаФорма);
	
	Если ЕстьНовыеЗаписиДатСЧА = Истина Тогда
		ОбновитьЗакрытиеПериодаНаСервере();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область Закрытие_Периода

&НаСервере
Функция ЗарегистрироватьОперацииНаСервере(ОбновитьТаблицуОперацийПоЗавершению = Истина, ОтчетОРезультатахВыполнения = Неопределено, ПерезаполнитьРанееСозданныеОперации, СоздаватьНедостающие = Истина, ДокументыКПерезаполнению = Неопределено, ТребуетсяКонтрольАкцептов = Истина)
	
	Если ДокументыКПерезаполнению = Неопределено Тогда
		ДокументыКПерезаполнению = Новый Массив;
	КонецЕсли; 
	
	СлужебныеСчетаДоверительногоУправления = ПолучитьСлужебныеСчетаДоверительногоУправления(Объект.Организация, Объект.ДатаРасчета);
	
	ВыбСтрокиЗакрытиеПериода = ЭтаФорма.ЗакрытиеПериода.НайтиСтроки(Новый Структура("Флажок", Истина));
	
	Если ВыбСтрокиЗакрытиеПериода.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны счета доверительного управления для обработки");
		Возврат 0;
	КонецЕсли;
	
	ДокументыНачисленияРезервовКПолномуПерезаполнению = Новый Массив;
	Для Каждого ДокументКПерезаполнению Из ДокументыКПерезаполнению Цикл
		Если ТипЗнч(ДокументКПерезаполнению) = Тип("ДокументСсылка.НачислениеСписаниеРезервов") Тогда
			ДокументыНачисленияРезервовКПолномуПерезаполнению.Добавить(ДокументКПерезаполнению);	
		КонецЕсли;
	КонецЦикла;
	
#Область Регистрация_статистики
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	ВыбСчетаДоверительногоУправления = Новый Массив;
	КодыВыбСчетовДоверительногоУправления = Новый Массив;
	
	Для каждого ВыбСтрока Из ВыбСтрокиЗакрытиеПериода Цикл
		ВыбСчетаДоверительногоУправления.Добавить(ВыбСтрока.СчетДоверительногоУправления);
		КодыВыбСчетовДоверительногоУправления.Добавить(ВыбСтрока.КодСчетаДоверительногоУправления);
	КонецЦикла;
	
	ДополнительныеПараметрыДляСтатистики = Новый Структура;
	ДополнительныеПараметрыДляСтатистики.Вставить("РежимОтбора",							ЭтаФорма.РежимОтбора);
	ДополнительныеПараметрыДляСтатистики.Вставить("СчетаДоверительногоУправления",			ВыбСчетаДоверительногоУправления);
	ДополнительныеПараметрыДляСтатистики.Вставить("ПерезаполнитьРанееСозданныеОперации",	ПерезаполнитьРанееСозданныеОперации);
	ДополнительныеПараметрыДляСтатистики.Вставить("ДокументыКПерезаполнению",				ДокументыКПерезаполнению);
	ДополнительныеПараметрыДляСтатистики.Вставить("СоздаватьНедостающие",					СоздаватьНедостающие);
	ДополнительныеПараметрыДляСтатистики.Вставить("ТребуетсяКонтрольАкцептов",				ТребуетсяКонтрольАкцептов);				
				
	ПараметрыСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектНаСервере, , ДополнительныеПараметрыДляСтатистики);
	
	ПараметрыСтатистики.Описание = ПараметрыСтатистики.Описание +
		Символы.ПС + "#СчетаДоверительногоУправления: " + СтрСоединить(КодыВыбСчетовДоверительногоУправления, ", ") +
		Символы.ПС + "#ДокументыКПерезаполнению: " + СтрСоединить(ДокументыКПерезаполнению, ", ");
		
	Механизм = ОбъектНаСервере.Метаданные().ПолноеИмя() + ".ЗарегистрироватьОперации";
	Сессия	 = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание);
		
#КонецОбласти	
	
	// Запоминаем сообщения до операций
	МассивСообщенийДоОпераций = ПолучитьСообщенияПользователю(Истина);
	
	СообщенияПоОперациям		= ИнициализироватьСтруктуруСообщенийНаСервере();
	СообщенияПоОбщимОперациям	= ИнициализироватьСтруктуруСообщенийНаСервере();
	
	Обработано = 0;
	
	КонтрольАкцептов = ИнициализироватьКонтрольАкцептов(Объект.Организация, Объект.ДатаРасчета);
	
	РезультатАкцептования = Новый ТабличныйДокумент;
	ЭтоМДТраст = Объект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_МДТраст");
	
	ПИФыБезАкцептов = Новый Массив;
	Если Объект.ДатаРасчета < Дата(2022,1,1) И Объект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда
		ПИФыБезАкцептов.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Атлет"));
		ПИФыБезАкцептов.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_СпортПерспективы"));
		ПИФыБезАкцептов.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Юпитер"));
	КонецЕсли;
	
	Для каждого СтрокаЗакрытиеПериода Из ВыбСтрокиЗакрытиеПериода Цикл
		
		Если Не СоздаватьНедостающие И Не ЗначениеЗаполнено(СтрокаЗакрытиеПериода.РегистрацияСтоимостиАктивов) Тогда
			// проводим за период и выбран режим заполнения "Только перезаполнить созданные документы"
			// если в этот день нет РСА - ничего не делаем
			Продолжить;
		КонецЕсли; 
		
		ВыбСчетДоверительногоУправления = СтрокаЗакрытиеПериода.СчетДоверительногоУправления;

		ДатаЗапретаРедактированияБэкОфиса = ПолучитьДатуЗапретаРедактированияБэкОфиса(Объект.Организация, ВыбСчетДоверительногоУправления);
		
		// для регистрации фин.показателей даты запрета и границы последовательности пока не проверяем
		// при регистрации недостающих операций выполняем проверку дат запрета редактирования только если есть незарегистрированные операции
		ТребуетсяРегистрацияСтоимости = ПерезаполнитьРанееСозданныеОперации Или Не ЗначениеЗаполнено(СтрокаЗакрытиеПериода.РегистрацияСтоимостиАктивов);
		
		Если ТребуетсяРегистрацияСтоимости Тогда
			
			Если Объект.ДатаРасчета <= ДатаЗапретаРедактированияБэкОфиса Тогда
				ЗарегистрироватьСообщение(
					СообщенияПоОперациям, ВыбСчетДоверительногоУправления,
					"Проверка дат запрета редактирования",
					"Для регистрации стоимости дата запрета редактирования по бэк-офису должна быть ранее " + Объект.ДатаРасчета + "
					|Регистрация операций по '" + ВыбСчетДоверительногоУправления + "' прервана",
					ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий,
					"Ошибка"
				);
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;

#Область Проверка_поручений
		
		// Для счетов ДУ по лицензии ДУ (УРЦБ) нужно проверить заполнение реквизита ДатаИВремяПолучения в поручениях на движение ДС и ЦБ
		Если РаботаСДокументами.ДатаНачалаПроверкиДатыИВремениПолученияДляПорученийНаДвижениеАктивов() <= Объект.ДатаРасчета 
				И РаботаСДокументами.СчетДоверительногоУправленияПоЛицензииПоУправлениюЦеннымиБумагами(Объект.ДатаРасчета, ВыбСчетДоверительногоУправления) 
				И ЕстьПорученияСНезаполненнойДатойПолученияНаСервере(ВыбСчетДоверительногоУправления, СообщенияПоОперациям)
		Тогда
			Продолжить;
		КонецЕсли;
		
#КонецОбласти
		
#Область Проверка_Взаимозачетов
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НАЧАЛОПЕРИОДА(ПоставкаЦенныхБумаг.Дата, ДЕНЬ) КАК Дата,
			|	ЗадолженностиПоЦеннымБумагам.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СУММА(ЗадолженностиПоЦеннымБумагам.Количество * ВЫБОР
			|			КОГДА ЗадолженностиПоЦеннымБумагам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|				ТОГДА 1
			|			ИНАЧЕ -1
			|		КОНЕЦ) КАК Количество
			|ИЗ
			|	Документ.ПоставкаЦенныхБумаг КАК ПоставкаЦенныхБумаг
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоЦеннымБумагам КАК ЗадолженностиПоЦеннымБумагам
			|		ПО ПоставкаЦенныхБумаг.Ссылка = ЗадолженностиПоЦеннымБумагам.Регистратор
			|ГДЕ
			|	ПоставкаЦенныхБумаг.Взаимозачет
			|	И ПоставкаЦенныхБумаг.Проведен
			|	И ПоставкаЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И ПоставкаЦенныхБумаг.Дата <= &Дата
			|	И ПоставкаЦенныхБумаг.Организация = &Организация
			|
			|СГРУППИРОВАТЬ ПО
			|	НАЧАЛОПЕРИОДА(ПоставкаЦенныхБумаг.Дата, ДЕНЬ),
			|	ПоставкаЦенныхБумаг.СчетДоверительногоУправления,
			|	ЗадолженностиПоЦеннымБумагам.ЦеннаяБумага
			|
			|ИМЕЮЩИЕ
			|	СУММА(ЗадолженностиПоЦеннымБумагам.Количество * ВЫБОР
			|			КОГДА ЗадолженностиПоЦеннымБумагам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|				ТОГДА 1
			|			ИНАЧЕ -1
			|		КОНЕЦ) <> 0";
		
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ВыбСчетДоверительногоУправления);
		Запрос.УстановитьПараметр("Организация", 					Объект.Организация);
		Запрос.УстановитьПараметр("Дата", 							КонецДня(Объект.ДатаРасчета));
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					ЗарегистрироватьСообщение(
						СообщенияПоОперациям, ВыбСчетДоверительногоУправления,
						"Проверка взаимозачетов",
						"В " +Формат(ВыборкаДетальныеЗаписи.Дата, "ДФ=dd.MM.yyyy")+ " не хватает встречных поставок в рамках взаимозачета по ценной бумаге "
							+ ВыборкаДетальныеЗаписи.ЦеннаяБумага+ " (" + ВыборкаДетальныеЗаписи.Количество + " шт.).
						|Регистрация операций по '" + ВыбСчетДоверительногоУправления + "' прервана",
						ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий,
						"Ошибка"
					);
			КонецЦикла;
			
			Продолжить;
			
		КонецЕсли;
		
#КонецОбласти
		
		ДатаГраницыПоследовательности = Неопределено;
		ВосстанавливатьПоследовательность = ТребуетсяВосстановлениеПоследовательности(Объект.ДатаРасчета, Объект.Организация, ВыбСчетДоверительногоУправления, ДатаГраницыПоследовательности);
		
#Область Перенумерация_документов
		
		// #ТехДолг -- должна быть функция в ММ обработки НумерацияДокументов, а саму обработку переименовать в НумерацияДокументовПоПравиламВеденияУчета
		// 		по задаче #705896 решили, что нумерация нужна только договорам по НПФ СС и ДУ,
		// 		а по ПН и ПР, по которым прилетело дофига сделок не нужна
		ТребуетсяНумерацияПоПравиламВеденияУчета =
			Не (ВыбСчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями
				Или ВыбСчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);
		
		Если ТребуетсяНумерацияПоПравиламВеденияУчета Тогда
			
			// иногда может получиться так, что граница последовательности осталась в закрытом периоде
			// 
			// например:
			//	1) 01 мая завели сделку Т+1 с исполнением 02 мая (ГП на исполнении 02 мая)
			//	2) 02 мая завели оплату комиссии брокера за сделку Т+1 за 01 мая (ГП откатилась на оплату 01 мая)
			//	3) провели регламентные операции за 01 мая (дата запрета стала на 01 мая, ГП осталась в закрытом периоде)
			//	4) открываем дату запрета, 01 мая создаем еще одну оплату в конце дня (ГП устанавливается на эту оплату,
			//		последовательность остается восстановленной), перезаполняем СЧА и возвращаем дату запрета на 01 мая
			//	
			//	если п.4 сделать вручную, а не через проведение регламентых, можно забыть перенумерацию,
			//	хотя последовательность на 01 мая осталась восстановленой и контроль СЧА прошел успешно
			//	
			//	искать документы для перенумерации будем, начиная самой ранней из дат между датой расчета
			//	и границой последовательности
			
			ОбработкаНумерация = Обработки.НумерацияДокументов.Создать();
			ОбработкаНумерация.Организация					= Объект.Организация;
			ОбработкаНумерация.СчетДоверительногоУправления	= ВыбСчетДоверительногоУправления;
			ОбработкаНумерация.Период.ДатаНачала			= Мин(ДатаГраницыПоследовательности, Объект.ДатаРасчета);
			ОбработкаНумерация.Период.ДатаОкончания			= Объект.ДатаРасчета;

			Попытка
				РезультатПроверкиНумерации = Неопределено;
				ТребуетсяНумерация = Не ОбработкаНумерация.ПроверитьНомераДокументов(РезультатПроверкиНумерации, Истина, Ложь);
			Исключение
				ЗарегистрироватьСообщение(
					СообщенияПоОперациям, ВыбСчетДоверительногоУправления,
					"Проверка дат запрета редактирования",
					"Ошибка проверки номеров документов за период " + Формат(ОбработкаНумерация.Период.ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ОбработкаНумерация.Период.ДатаОкончания, "ДФ=dd.MM.yyyy") + "
					|Система сообщает: " + ОписаниеОшибки() + "
					|Необходимо устранить ошибку и выполнить проверку вручную",
					ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий,
					"Ошибка"
				);
			КонецПопытки;
			
			Если ТребуетсяНумерация Тогда
				
				НачальнаяДатаНумерации = РезультатПроверкиНумерации.ИныеОперации.Данные.Строки[0].Дата;
				
				Если НачальнаяДатаНумерации <= ДатаЗапретаРедактированияБэкОфиса Тогда
					ЗарегистрироватьСообщение(
						СообщенияПоОперациям, ВыбСчетДоверительногоУправления,
						"Проверка дат запрета редактирования",
						"Для проведения нумерации дата запрета редактирования по бэк-офису должна быть ранее " + Формат(НачальнаяДатаНумерации, "ДФ=dd.MM.yyyy") + "
						|Регистрация операций по '" + ВыбСчетДоверительногоУправления + "' прервана",
						ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий,
						"Ошибка"
					);
					Продолжить;
				КонецЕсли;
				
				Попытка
					ОшибкиЗаписи = Неопределено;
					ВсегоПеренумеровано = ОбработкаНумерация.ПеренумероватьДокументы(РезультатПроверкиНумерации,, Ложь, ОшибкиЗаписи);
				Исключение
					ЗарегистрироватьСообщение(
						СообщенияПоОперациям, ВыбСчетДоверительногоУправления,
						"Перенумерация документов",
						"Ошибка нумерации документов за период " + Формат(ОбработкаНумерация.Период.ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ОбработкаНумерация.Период.ДатаОкончания, "ДФ=dd.MM.yyyy") + "
						|Система сообщает: " + ОписаниеОшибки() + "
						|Необходимо устранить ошибку и выполнить нумерацию вручную",
						ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий,
						"Ошибка"
					);
					Продолжить;
				КонецПопытки;
				
				ЗарегистрироватьСообщение(
					СообщенияПоОперациям, ВыбСчетДоверительногоУправления,
					"Перенумерация документов",
					"Выполнена перенумерация документов за период " + Формат(ОбработкаНумерация.Период.ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ОбработкаНумерация.Период.ДатаОкончания, "ДФ=dd.MM.yyyy") + "
					|Перенумеровано документов: " + Формат(ВсегоПеренумеровано, "ЧН=; ЧГ="),
					ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий,
					?(ОшибкиЗаписи = Неопределено, "", "Ошибка")
				);
				
				Если ОшибкиЗаписи <> Неопределено Тогда
					Продолжить;
				КонецЕсли;

			КонецЕсли;
			
		КонецЕсли;
		
#КонецОбласти
		
#Область Восстановление_Последовательности

		Если ВосстанавливатьПоследовательность Тогда
			
			Ошибки = Новый Массив;
			Обработки.ВосстановлениеПоследовательностей.ВосстановитьПоследовательность(Объект.ДатаРасчета, Объект.Организация, ВыбСчетДоверительногоУправления, 2, Ошибки);
			
			Если Ошибки.Количество() > 0 Тогда
				ЗарегистрироватьСообщение(
					СообщенияПоОперациям, ВыбСчетДоверительногоУправления,
					"Восстановление последовательности через контроль отрицательных остатков на конец дня",
					СтрСоединить(Ошибки, Символы.ПС) + "
					|Регистрация операций по '" + ВыбСчетДоверительногоУправления + "' прервана",
					ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий,
					"Ошибка"
				);
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
#КонецОбласти
		
		Если ПерезаполнитьРанееСозданныеОперации Тогда
			Перезаполнить = Не СтрокаЗакрытиеПериода.РучнойВвод Или ДокументыКПерезаполнению.Найти(СтрокаЗакрытиеПериода.РегистрацияСтоимостиАктивов) <> Неопределено;
		Иначе
			// пришли сюда из "Зарегистрировать недостающие операции"
			// заполняем только в случае, если документов нет
			Перезаполнить = Не ЗначениеЗаполнено(СтрокаЗакрытиеПериода.РегистрацияСтоимостиАктивов);
		КонецЕсли; 
		
		Если Перезаполнить И СлужебныеСчетаДоверительногоУправления.Найти(ВыбСчетДоверительногоУправления) = Неопределено Тогда
			
			#Область Контроль_Акцептования_Операций
			
			// Контроль требуется только для ПИФов (кроме МД Траста); не выполняем контроль, если регламентные операции формируются через атомарные
			Если ТребуетсяКонтрольАкцептов И (Не ЭтоМДТраст) И (ПИФыБезАкцептов.Найти(ВыбСчетДоверительногоУправления) = Неопределено)
				И ВыбСчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
				Отказ = Ложь;
				ПроверитьАкцептыПоДоговору(ВыбСчетДоверительногоУправления, Объект.ДатаРасчета, КонтрольАкцептов, РезультатАкцептования, СообщенияПоОперациям,, ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий, Отказ);
				Если Отказ Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			#КонецОбласти
			
			#Область Проведение_Операций
			
			НайденныеФайлыКлиента = ФайлыОценочнойСтоимостиЦенныхБумагКлиента.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", ВыбСчетДоверительногоУправления)); 
			Если НайденныеФайлыКлиента.Количество() > 0 Тогда
				ПутьКФайлу				= НайденныеФайлыКлиента[0].ПутьКФайлу;
				АдресТаблицыСтоимостей	= НайденныеФайлыКлиента[0].АдресТаблицыСтоимостей;
			Иначе
				ПутьКФайлу				= Неопределено;
				АдресТаблицыСтоимостей	= Неопределено;
			КонецЕсли;
			
			ПараметрыЗаполнения = Новый Структура;
			ПараметрыЗаполнения.Вставить("ПутьКФайлу", ПутьКФайлу);
			ПараметрыЗаполнения.Вставить("АдресТаблицыСтоимостей", АдресТаблицыСтоимостей);
			ПараметрыЗаполнения.Вставить("ДокументыНачисленияРезервовКПолномуПерезаполнению", ДокументыНачисленияРезервовКПолномуПерезаполнению);
			
			Если ЗначениеЗаполнено(СтрокаЗакрытиеПериода.РегистрацияСтоимостиАктивов) Тогда
				РегистрацияСтоимостиАктивов = СтрокаЗакрытиеПериода.РегистрацияСтоимостиАктивов.ПолучитьОбъект();
			Иначе
				РегистрацияСтоимостиАктивов = Документы.РегистрацияСтоимостиАктивов.СоздатьДокумент();
				РегистрацияСтоимостиАктивов.Дата                         	= КонецДня(Объект.ДатаРасчета);
				РегистрацияСтоимостиАктивов.Организация                  	= Объект.Организация;
				РегистрацияСтоимостиАктивов.Ответственный                	= РаботаСПользователями.ТекущийПользователь();
				РегистрацияСтоимостиАктивов.СчетДоверительногоУправления 	= ВыбСчетДоверительногоУправления;
				РегистрацияСтоимостиАктивов.ЦельРасчетаСтоимостиОценки 		= ЭтаФорма.ЦельРасчета;
			КонецЕсли;
			
			Отказ = Ложь;
			
			РегистрацияСтоимостиАктивов.РучнойВвод = Ложь;
			РегистрацияСтоимостиАктивов.ДополнительныеСвойства.Вставить("ПроведениеРегламентныхОпераций");
			РегистрацияСтоимостиАктивов.ЗаполнитьДокументыРегистрацииСтоимости(ПараметрыЗаполнения, Истина, Отказ);
			
			Если Отказ Тогда
				ЗарегистрироватьСообщение(
					СообщенияПоОперациям, ВыбСчетДоверительногоУправления,
					"Регистрация стоимости активов",
					"Регистрация операций по '" + ВыбСчетДоверительногоУправления + "' прервана",
					ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий,
					"Ошибка"
				);
				Продолжить;
			КонецЕсли;
			
			СтатусОперации		= "";
			КомментарийОперации	= "";
			
			Если ЗарегистрированаОтрицательнаяСЧА(РегистрацияСтоимостиАктивов) Тогда
				СтатусОперации		= "Предупреждение";
				КомментарийОперации	= "Зарегистрирована отрицательная СЧА";
			КонецЕсли;
			
			ЗарегистрироватьСообщение(
				СообщенияПоОперациям, ВыбСчетДоверительногоУправления,
				РегистрацияСтоимостиАктивов.Ссылка,
				КомментарийОперации,
				ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий,
				СтатусОперации
			);

			Если ВыбСчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет Тогда
				ВыполнитьКонтрольОтклоненияСЧАНаСервере(СообщенияПоОперациям, ВыбСчетДоверительногоУправления);
			КонецЕсли;
			
			Обработано = Обработано + 1;
				
			#КонецОбласти
			
		КонецЕсли;
		
#Область Установка_дат_запрета_редактирования
		
		РезультатыПоСчетуДУ = СообщенияПоОперациям.Найти(ВыбСчетДоверительногоУправления, "ГруппаОпераций"); 
		Если РезультатыПоСчетуДУ = Неопределено ИЛИ РезультатыПоСчетуДУ.Статус <> "2_Ошибки" Тогда
			
			Попытка
				
				// разрешаем двигать вперед даты запрета редактирования, даже без наличия
				// соответствующей роли ИзменениеДатыЗапрета, см. задачу
				УстановитьПривилегированныйРежим(Истина);
				
				НаборЗаписей = РегистрыСведений.ДатыЗапретаРедактирования.СоздатьНаборЗаписей();
				
				НаборЗаписей.Отбор.Организация.Установить(Объект.Организация);
				НаборЗаписей.Отбор.СчетДоверительногоУправления.Установить(ВыбСчетДоверительногоУправления);
				НаборЗаписей.Отбор.ГруппаЗапрета.Установить(Перечисления.ГруппыЗапретаРедактирования.БэкОфис);
				
				НаборЗаписей.ДополнительныеСвойства.Вставить("АвтоматическаяУстановкаДатыЗапрета", Истина);
				
				Запись = НаборЗаписей.Добавить();
				Запись.Организация                  = Объект.Организация;
				Запись.СчетДоверительногоУправления = ВыбСчетДоверительногоУправления;
				Запись.ГруппаЗапрета                = Перечисления.ГруппыЗапретаРедактирования.БэкОфис;
				Запись.ДатаЗапретаРедактирования    = Объект.ДатаРасчета;
				
				НаборЗаписей.Записать();
				
				УстановитьПривилегированныйРежим(Ложь);
				
			Исключение
				ЗарегистрироватьСообщение(
					СообщенияПоОперациям, ВыбСчетДоверительногоУправления,
					"Установка дат запрета редактирования",
					"Ошибка установки даты запрета редактирования документов бэк-офиса на " + Формат(Объект.ДатаРасчета, "ДФ=dd.MM.yyyy"),
					ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий,
					"Предупреждение"
				);
				Прервать;
			КонецПопытки;
			
			ЗарегистрироватьСообщение(
				СообщенияПоОперациям, ВыбСчетДоверительногоУправления,
				"Установка дат запрета редактирования",
				"Дата запрета редактирования документов бэк-офиса установлена на " + Формат(Объект.ДатаРасчета, "ДФ=dd.MM.yyyy"),
				ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий
			);

		КонецЕсли;
		
#КонецОбласти
		
	КонецЦикла;
	
#Область Неблокирующие_проверки
	
	// Проверим наличие сделок с отклонениями от рыночных цен для ПН
	Операция		= Механизм + ".ПроверитьНаличиеСделокСОтклонениямиОтРыночныхЦенНаСервере";
	СессияОперации	= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Операция, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание);
	ПроверитьНаличиеСделокСОтклонениямиОтРыночныхЦенНаСервере(СообщенияПоОбщимОперациям);
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Операция, СессияОперации);
	
	// Рассылка зарегистрированных аналогов
	Операция		= Механизм + ".ОповеститьОПодобранныхАналогахНаСервере";
	СессияОперации	= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Операция, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание);
	ОповеститьОПодобранныхАналогахНаСервере(СообщенияПоОбщимОперациям);
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Операция, СессияОперации);
	
#КонецОбласти
	
	// Заполним отчет о результатах выполнения
	Операция		= Механизм + ".ВывестиОтчетОРезультатахВыполненияОперацийНаСервере";
	СессияОперации	= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Операция, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание);
	ВывестиОтчетОРезультатахВыполненияОперацийНаСервере(ОтчетОРезультатахВыполнения, СообщенияПоОперациям, СообщенияПоОбщимОперациям);
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Операция, СессияОперации);
	
	// Помещаем обратно сообщения, полученные до начала операций
	ОбщегоНазначения.ВывестиСообщенияПользователю(МассивСообщенийДоОпераций);
	
	// Обновляем таблицу операций
	Если ОбновитьТаблицуОперацийПоЗавершению Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выполнение завершено. Зарегистрировано операций: " + Обработано);
		
		Операция		= Механизм + ".ОбновитьЗакрытиеПериодаНаСервере";
		СессияОперации	= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Операция, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание);
		ОбновитьЗакрытиеПериодаНаСервере();
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Операция, СессияОперации);
		
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
	Возврат Обработано;

КонецФункции // ЗарегистрироватьОперацииНаСервере

&НаСервере
Процедура ОбновитьЗакрытиеПериодаНаСервере(ЗапомнитьРанееВыбранныеФлажки = Истина, ПерезаполнитьБезУчетаНастроекРегламентныхДействий = Ложь)
	
	// Запомним текущую строку	
	ТекущиеДанные		= ?(Элементы.ЗакрытиеПериода.ТекущаяСтрока = Неопределено, Неопределено, ЗакрытиеПериода.НайтиПоИдентификатору(Элементы.ЗакрытиеПериода.ТекущаяСтрока));
	КлиентДоОбновления	= ?(ТекущиеДанные = Неопределено, Неопределено, ТекущиеДанные.СчетДоверительногоУправления); 		
	
	Если ЭтаФорма.РежимОтбора = 0 И Не ЗначениеЗаполнено(ЭтаФорма.ИнвестСтратегия) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле 'Инвест. cтратегия' не заполнено", ЭтаФорма, "ИнвестСтратегия");
		Возврат;
		
	ИначеЕсли ЭтаФорма.РежимОтбора = 1 И Не ЗначениеЗаполнено(ЭтаФорма.СчетДоверительногоУправления) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле 'Счет доверительного управления' не заполнено", ЭтаФорма, "СчетДоверительногоУправления");
		Возврат;
		
	ИначеЕсли ЭтаФорма.РежимОтбора = 2 И Не ЗначениеЗаполнено(ЭтаФорма.ВидДоговораДоверительногоУправления) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле 'Вид договора доверительного управления' не заполнено", ЭтаФорма, "ВидДоговораДоверительногоУправления");
		Возврат;
		
	ИначеЕсли ЭтаФорма.РежимОтбора = 4 И Не ЗначениеЗаполнено(ЭтаФорма.КлиентДоверительногоУправления) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле 'Клиент доверительного управления' не заполнено", ЭтаФорма, "КлиентДоверительногоУправления");
		Возврат;
		
	ИначеЕсли ЭтаФорма.РежимОтбора = 8
			И ЭтаФорма.УниверсальныйОтборСчет.Количество() = 0
			И ЭтаФорма.УниверсальныйОтборКлиент.Количество() = 0
			И ЭтаФорма.УниверсальныйОтборВидДоговора.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заполните хотя бы один параметр универсального отбора", ЭтаФорма, "УниверсальныйОтборСчет");
		Возврат;
		
	КонецЕсли;
	
	// заполним ранее выбранные счета д/у
	Если ЗапомнитьРанееВыбранныеФлажки Тогда
		РанееВыбДоверительногоУправления = ПолучитьВыбранныеСчетаДоверительногоУправленияНаСервере();
	Иначе
		РанееВыбДоверительногоУправления = Новый Массив;
	КонецЕсли;
	
	// Основной функционал
	
	ЭтаФорма.ЗакрытиеПериода.Очистить();
	
	СчетаПеренесенныеИзВторойОчередиВПервую = РаботаСКоллекциями.ЗначениеВМассив(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_UL1615")); // НПФ Ханты-Мансийский СС АО (#400442)
	
	Если ЭтаФорма.РежимОтбора = 0 Тогда
		
		СчетаДоверительногоУправления = Справочники.СчетаДоверительногоУправления.СчетаДоверительногоУправленияНаДатуСАктивами(
											Объект.ДатаРасчета, 
											Справочники.СчетаДоверительногоУправления.СтруктураДляОтбораСчетовДоверительногоУправления(
															Объект.Организация, 
															ЭтаФорма.ИнвестСтратегия)
											);
		 		
	ИначеЕсли ЭтаФорма.РежимОтбора = 1 Тогда
		
		СчетаДоверительногоУправления = ЭтаФорма.СчетДоверительногоУправления;
		
	ИначеЕсли ЭтаФорма.РежимОтбора = 2 Тогда
		
		СчетаДоверительногоУправления = Справочники.СчетаДоверительногоУправления.СчетаДоверительногоУправленияНаДатуСАктивами(
											Объект.ДатаРасчета, 
											Справочники.СчетаДоверительногоУправления.СтруктураДляОтбораСчетовДоверительногоУправления(
															Объект.Организация, 
															ЭтаФорма.ВидДоговораДоверительногоУправления)
											);
				
	ИначеЕсли ЭтаФорма.РежимОтбора = 3 Тогда // все, кроме контроля ДК
		
		ИсключаемыеВидыДоговоровДУ = Новый Массив;
		ИсключаемыеВидыДоговоровДУ.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.КонтрольСаморегулируемыхОрганизаций);
		ИсключаемыеВидыДоговоровДУ.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.КонтрольСтраховыхКомпаний);
		
		ВидыДоговоровДоверительногоУправления = Новый Массив;
		Для Каждого МетаВидДоговораДУ Из Метаданные.Перечисления.ВидыДоговоровДоверительногоУправления.ЗначенияПеречисления Цикл
			ЗначениеПеречисления = Перечисления.ВидыДоговоровДоверительногоУправления[МетаВидДоговораДУ.Имя];
			Если ИсключаемыеВидыДоговоровДУ.Найти(ЗначениеПеречисления) = Неопределено Тогда
				ВидыДоговоровДоверительногоУправления.Добавить(ЗначениеПеречисления);		
			КонецЕсли;
		КонецЦикла;
				
		СчетаДоверительногоУправления = Справочники.СчетаДоверительногоУправления.СчетаДоверительногоУправленияНаДатуСАктивами(
											Объект.ДатаРасчета, 
											Справочники.СчетаДоверительногоУправления.СтруктураДляОтбораСчетовДоверительногоУправления(
															Объект.Организация, 
															ВидыДоговоровДоверительногоУправления)
											);
		
	ИначеЕсли ЭтаФорма.РежимОтбора = 4 Тогда
				
		СчетаДоверительногоУправления = Справочники.СчетаДоверительногоУправления.СчетаДоверительногоУправленияНаДатуСАктивами(
											Объект.ДатаРасчета, 
											Справочники.СчетаДоверительногоУправления.СтруктураДляОтбораСчетовДоверительногоУправления(
															Объект.Организация, 
															ЭтаФорма.КлиентДоверительногоУправления)
											);
		
	ИначеЕсли ЭтаФорма.РежимОтбора = 5 Тогда // 1-я очередь: ПФР, ПН, ПР, ПИФ, СРО, СТРАХ, ФОГФ
		
		ВидыДоговоровДоверительногоУправления = Новый Массив;
		ВидыДоговоровДоверительногоУправления.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР);
		ВидыДоговоровДоверительногоУправления.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями);
		ВидыДоговоровДоверительногоУправления.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);
		ВидыДоговоровДоверительногоУправления.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда);
		ВидыДоговоровДоверительногоУправления.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций);
		ВидыДоговоровДоверительногоУправления.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеИмуществомСтраховыхКомпаний);
		ВидыДоговоровДоверительногоУправления.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний);
		ВидыДоговоровДоверительногоУправления.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ);
				
		СчетаДоверительногоУправления = Справочники.СчетаДоверительногоУправления.СчетаДоверительногоУправленияНаДатуСАктивами(
											Объект.ДатаРасчета, 
											Справочники.СчетаДоверительногоУправления.СтруктураДляОтбораСчетовДоверительногоУправления(
															Объект.Организация, 
															ВидыДоговоровДоверительногоУправления,
															СчетаПеренесенныеИзВторойОчередиВПервую)
											);
											
	ИначеЕсли ЭтаФорма.РежимОтбора = 6 Тогда // 2-я очередь: ЮЛ, ФЛ, НПФ СС, СОБ, Активы целевых капиталов
		
		ВидыДоговоровДоверительногоУправления = Новый Массив;
		ВидыДоговоровДоверительногоУправления.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица);
		ВидыДоговоровДоверительногоУправления.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЮридическогоЛица);
		ВидыДоговоровДоверительногоУправления.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов);
		ВидыДоговоровДоверительногоУправления.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.Собственный);
		ВидыДоговоровДоверительногоУправления.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов);
			
		СчетаДоверительногоУправления = Справочники.СчетаДоверительногоУправления.СчетаДоверительногоУправленияНаДатуСАктивами(
											Объект.ДатаРасчета, 
											Справочники.СчетаДоверительногоУправления.СтруктураДляОтбораСчетовДоверительногоУправления(
															Объект.Организация, 
															ВидыДоговоровДоверительногоУправления,
															,
															СчетаПеренесенныеИзВторойОчередиВПервую)
											);
											
	ИначеЕсли ЭтаФорма.РежимОтбора = 7 Тогда // 3-я очередь: ИИС
		
		ВидыДоговоровДоверительногоУправления = Новый Массив;
		ВидыДоговоровДоверительногоУправления.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет);
				
		СчетаДоверительногоУправления = Справочники.СчетаДоверительногоУправления.СчетаДоверительногоУправленияНаДатуСАктивами(
										Объект.ДатаРасчета, 
										Справочники.СчетаДоверительногоУправления.СтруктураДляОтбораСчетовДоверительногоУправления(
														Объект.Организация, 
														ВидыДоговоровДоверительногоУправления)
										);
		
	ИначеЕсли ЭтаФорма.РежимОтбора = 8 Тогда // Универсальный отбор
		
		// 1. Базовый набор - объединение счетов ДУ и счетов клиентов
		// Неопределено означает что базовый набор не задан (ни счёт, ни клиент не выбраны)
		НаборБазовый = Неопределено;
		
		Если ЭтаФорма.УниверсальныйОтборСчет.Количество() > 0
				Или ЭтаФорма.УниверсальныйОтборКлиент.Количество() > 0 Тогда
			
			НаборБазовый = Новый Массив;
			
			// Добавляем конкретные счета ДУ
			Если ЭтаФорма.УниверсальныйОтборСчет.Количество() > 0 Тогда
				РаботаСКоллекциями.ДополнитьМассив(НаборБазовый, ЭтаФорма.УниверсальныйОтборСчет.ВыгрузитьЗначения(), Истина);
			КонецЕсли;
			
			// Добавляем все счета выбранных клиентов
			Если ЭтаФорма.УниверсальныйОтборКлиент.Количество() > 0 Тогда
				Для Каждого ЭлементСписка Из ЭтаФорма.УниверсальныйОтборКлиент Цикл
					ВыборкаПоКлиенту = Справочники.СчетаДоверительногоУправления.СчетаДоверительногоУправленияНаДатуСАктивами(
											Объект.ДатаРасчета, 
											Справочники.СчетаДоверительногоУправления.СтруктураДляОтбораСчетовДоверительногоУправления(
													Объект.Организация, 
													ЭлементСписка.Значение));
					РаботаСКоллекциями.ДополнитьМассив(НаборБазовый, ВыборкаПоКлиенту.ВыгрузитьКолонку("СчетДоверительногоУправления"), Истина);
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
		// 2. Вид договора сужает базовый набор
		Если ЭтаФорма.УниверсальныйОтборВидДоговора.Количество() > 0 Тогда
			
			МассивВидовДоговоров = ЭтаФорма.УниверсальныйОтборВидДоговора.ВыгрузитьЗначения();
			ВыборкаПоВидуДоговора = Справочники.СчетаДоверительногоУправления.СчетаДоверительногоУправленияНаДатуСАктивами(
									Объект.ДатаРасчета, 
									Справочники.СчетаДоверительногоУправления.СтруктураДляОтбораСчетовДоверительногоУправления(
											Объект.Организация, 
											МассивВидовДоговоров));
			НаборПоВидуДоговора = ВыборкаПоВидуДоговора.ВыгрузитьКолонку("СчетДоверительногоУправления");
			
			Если НаборБазовый = Неопределено Тогда
				// Базовый набор не задан - результат определяется только видом договора
				СчетаДоверительногоУправления = НаборПоВидуДоговора;
			Иначе
				// Оставляем из базового набора только счета с нужным видом договора
				СоответствиеПоВидуДоговора = Новый Соответствие;
				Для Каждого Счет Из НаборПоВидуДоговора Цикл
					СоответствиеПоВидуДоговора.Вставить(Счет, Истина);
				КонецЦикла;
				НовоеПересечение = Новый Массив;
				Для Каждого Счет Из НаборБазовый Цикл
					Если СоответствиеПоВидуДоговора[Счет] = Истина Тогда
						НовоеПересечение.Добавить(Счет);
					КонецЕсли;
				КонецЦикла;
				СчетаДоверительногоУправления = НовоеПересечение;
			КонецЕсли;
			
		Иначе
			// Вид договора не задан - используем базовый набор как есть
			СчетаДоверительногоУправления = НаборБазовый;
		КонецЕсли;
		
	КонецЕсли;
	
	// Инициализируем запрос и его параметры
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Период", Объект.ДатаРасчета);
	
	Если ТипЗнч(СчетаДоверительногоУправления) = Тип("ТаблицаЗначений") Тогда
		Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаДоверительногоУправления.ВыгрузитьКолонку("СчетДоверительногоУправления"));
	Иначе
		Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаДоверительногоУправления);
	КонецЕсли;
	
	// сначала счета доверительного управления
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.Наименование КАК Наименование,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	СчетаДоверительногоУправления.КодСчета КАК КодСчетаДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК КлиентДоверительногоУправления,
		|	НастройкиЦелейРасчетаСрезПоследних.ЦельРасчета КАК ЦельРасчета,
		|	НастройкиЦелейРасчетаСрезПоследних.ВидУчетаДляОстатковПартий КАК ВидУчетаПартий,
		|	НастройкиЦелейРасчетаСрезПоследних.ВариантРасчетаОценочнойСтоимости КАК ВариантРасчетаОценочнойСтоимости,
		|	НастройкиЦелейРасчетаСрезПоследних.Период КАК ДатаУстановкиЦелиРасчета
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЦелейРасчета.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)) КАК НастройкиЦелейРасчетаСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = НастройкиЦелейРасчетаСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка В(&СчетаДоверительногоУправления)";
	
	Запрос.Выполнить();
		
	// количество операций (определяется флажком на форме)
	Если ЭтаФорма.ОтображатьКоличествоОпераций Тогда
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОстаткиЦенныхБумаг.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОстаткиЦенныхБумаг.Регистратор) КАК КоличествоОпераций
			|ПОМЕСТИТЬ _КоличествоОперацийСЦеннымиБумагами
			|ИЗ
			|	РегистрНакопления.ОстаткиЦенныхБумаг КАК ОстаткиЦенныхБумаг
			|ГДЕ
			|	ОстаткиЦенныхБумаг.Активность
			|	И ОстаткиЦенныхБумаг.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ) И &Период
			|	И ОстаткиЦенныхБумаг.Организация = &Организация
			|	И ОстаткиЦенныхБумаг.СчетДоверительногоУправления В
			|			(ВЫБРАТЬ
			|				_СчетаДоверительногоУправления.СчетДоверительногоУправления
			|			ИЗ
			|				_СчетаДоверительногоУправления)
			|
			|СГРУППИРОВАТЬ ПО
			|	ОстаткиЦенныхБумаг.СчетДоверительногоУправления
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОстаткиДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОстаткиДенежныхСредств.Регистратор) КАК КоличествоОпераций
			|ПОМЕСТИТЬ _КоличествоОперацийСДенежнымиСредствами
			|ИЗ
			|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
			|ГДЕ
			|	ОстаткиДенежныхСредств.Активность
			|	И ОстаткиДенежныхСредств.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ) И &Период
			|	И ОстаткиДенежныхСредств.Организация = &Организация
			|	И ОстаткиДенежныхСредств.СчетДоверительногоУправления В
			|			(ВЫБРАТЬ
			|				_СчетаДоверительногоУправления.СчетДоверительногоУправления
			|			ИЗ
			|				_СчетаДоверительногоУправления)
			|
			|СГРУППИРОВАТЬ ПО
			|	ОстаткиДенежныхСредств.СчетДоверительногоУправления";
	Иначе
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка) КАК СчетДоверительногоУправления,
			|	-1 КАК КоличествоОпераций
			|ПОМЕСТИТЬ _КоличествоОперацийСЦеннымиБумагами
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка) КАК СчетДоверительногоУправления,
			|	-1 КАК КоличествоОпераций
			|ПОМЕСТИТЬ _КоличествоОперацийСДенежнымиСредствами";		
		
	КонецЕсли;
	
	Запрос.Выполнить();
	
	Если ПерезаполнитьБезУчетаНастроекРегламентныхДействий Тогда
		// #ТехДолг: это костыль на случай проведения операций за период в режиме "Перезаполнить существующие". Задача #319479
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка) КАК СчетДоверительногоУправления
			|ПОМЕСТИТЬ _ДатыДействияЗаПериод";
		Запрос.Выполнить();
		
	Иначе
		
		// Получение таблицы дат СЧА по счетам ДУ (_ДатыДействияЗаПериод)
		Справочники.НастройкиРегламентныхДействий.ПоместитьДатыДействияЗаПериодВоВременнуюТаблицу(Запрос, Новый Структура("ВидДействия, ДатаС, ДатаПо, ДополнитьРабочимиДнями", "СЧА", Объект.ДатаРасчета, Объект.ДатаРасчета, Истина));
	
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ПерезаполнитьБезУчетаНастроекРегламентныхДействий", ПерезаполнитьБезУчетаНастроекРегламентныхДействий);
		
	// Основная выборка данных
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РегистрацияСтоимостиАктивов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	МАКСИМУМ(РегистрацияСтоимостиАктивов.Ссылка) КАК Ссылка,
		|	РегистрацияСтоимостиАктивов.РучнойВвод КАК РучнойВвод
		|ПОМЕСТИТЬ _РегистрацииСтоимостиАктивов
		|ИЗ
		|	Документ.РегистрацияСтоимостиАктивов КАК РегистрацияСтоимостиАктивов
		|ГДЕ
		|	РегистрацияСтоимостиАктивов.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И РегистрацияСтоимостиАктивов.Проведен
		|	И РегистрацияСтоимостиАктивов.Организация = &Организация
		|	И РегистрацияСтоимостиАктивов.ЦельРасчетаСтоимостиОценки = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)
		|	И РегистрацияСтоимостиАктивов.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления)
		|
		|СГРУППИРОВАТЬ ПО
		|	РегистрацияСтоимостиАктивов.СчетДоверительногоУправления,
		|	РегистрацияСтоимостиАктивов.РучнойВвод
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РегистрацииСтоимостиАктивов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_РегистрацииСтоимостиАктивов.Ссылка.НачислениеСписаниеРезервов КАК Ссылка
		|ПОМЕСТИТЬ _НачислениеСписаниеРезервов
		|ИЗ
		|	_РегистрацииСтоимостиАктивов КАК _РегистрацииСтоимостиАктивов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НачислениеСписаниеРезервовПартии.Ссылка КАК Ссылка,
		|	МАКСИМУМ(НачислениеСписаниеРезервовПартии.РучнаяКорректировка) КАК РучнаяКорректировка
		|ПОМЕСТИТЬ _НачислениеСписаниеРезервовРучнаяКорректировка
		|ИЗ
		|	_НачислениеСписаниеРезервов КАК _НачислениеСписаниеРезервов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НачислениеСписаниеРезервов.Партии КАК НачислениеСписаниеРезервовПартии
		|		ПО _НачислениеСписаниеРезервов.Ссылка = НачислениеСписаниеРезервовПартии.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	НачислениеСписаниеРезервовПартии.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_СчетаДоверительногоУправления.КодСчетаДоверительногоУправления КАК КодСчетаДоверительногоУправления,
		|	_СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	_СчетаДоверительногоУправления.КлиентДоверительногоУправления КАК КлиентДоверительногоУправления,
		|	_СчетаДоверительногоУправления.ВидУчетаПартий КАК ВидУчетаПартий,
		|	_СчетаДоверительногоУправления.ВариантРасчетаОценочнойСтоимости КАК ВариантРасчетаОценочнойСтоимости,
		|	_СчетаДоверительногоУправления.ДатаУстановкиЦелиРасчета КАК ДатаУстановкиЦелиРасчета,
		|	ЕСТЬNULL(ДатыЗапретаРедактированияБэкОфис.ДатаЗапретаРедактирования, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаЗапретаРедактированияБэкОфис,
		|	ЕСТЬNULL(ДатыЗапретаРедактированияПартий.ДатаЗапретаРедактирования, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаЗапретаРедактированияПартий,
		|	_РегистрацииСтоимостиАктивов.Ссылка КАК РегистрацияСтоимостиАктивов,
		|	_КоличествоОперацийСЦеннымиБумагами.КоличествоОпераций КАК КоличествоОперацийСЦеннымиБумагами,
		|	_КоличествоОперацийСДенежнымиСредствами.КоличествоОпераций КАК КоличествоОперацийСДенежнымиСредствами,
		|	_РегистрацииСтоимостиАктивов.РучнойВвод КАК РучнойВвод,
		|	_НачислениеСписаниеРезервов.Ссылка КАК НачислениеИСписаниеРезервов,
		|	ЕСТЬNULL(_НачислениеСписаниеРезервовРучнаяКорректировка.РучнаяКорректировка, ЛОЖЬ) КАК РучнаяКорректировкаНачисленияИСписаниеРезервов
		|ИЗ
		|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДатыДействияЗаПериод КАК _ДатыДействияЗаПериод
		|		ПО (_СчетаДоверительногоУправления.СчетДоверительногоУправления = _ДатыДействияЗаПериод.СчетДоверительногоУправления
		|				ИЛИ &ПерезаполнитьБезУчетаНастроекРегламентныхДействий)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактированияБэкОфис
		|		ПО _СчетаДоверительногоУправления.СчетДоверительногоУправления = ДатыЗапретаРедактированияБэкОфис.СчетДоверительногоУправления
		|			И (ДатыЗапретаРедактированияБэкОфис.Организация = &Организация)
		|			И (ДатыЗапретаРедактированияБэкОфис.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.БэкОфис))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактированияПартий
		|		ПО _СчетаДоверительногоУправления.СчетДоверительногоУправления = ДатыЗапретаРедактированияПартий.СчетДоверительногоУправления
		|			И _СчетаДоверительногоУправления.ВидУчетаПартий = ДатыЗапретаРедактированияПартий.ВидУчета
		|			И (ДатыЗапретаРедактированияПартий.Организация = &Организация)
		|			И (ДатыЗапретаРедактированияПартий.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РегистрацииСтоимостиАктивов КАК _РегистрацииСтоимостиАктивов
		|		ПО _СчетаДоверительногоУправления.СчетДоверительногоУправления = _РегистрацииСтоимостиАктивов.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КоличествоОперацийСЦеннымиБумагами КАК _КоличествоОперацийСЦеннымиБумагами
		|		ПО _СчетаДоверительногоУправления.СчетДоверительногоУправления = _КоличествоОперацийСЦеннымиБумагами.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КоличествоОперацийСДенежнымиСредствами КАК _КоличествоОперацийСДенежнымиСредствами
		|		ПО _СчетаДоверительногоУправления.СчетДоверительногоУправления = _КоличествоОперацийСДенежнымиСредствами.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НачислениеСписаниеРезервов КАК _НачислениеСписаниеРезервов
		|			ЛЕВОЕ СОЕДИНЕНИЕ _НачислениеСписаниеРезервовРучнаяКорректировка КАК _НачислениеСписаниеРезервовРучнаяКорректировка
		|			ПО _НачислениеСписаниеРезервов.Ссылка = _НачислениеСписаниеРезервовРучнаяКорректировка.Ссылка
		|		ПО _СчетаДоверительногоУправления.СчетДоверительногоУправления = _НачислениеСписаниеРезервов.СчетДоверительногоУправления
		|
		|УПОРЯДОЧИТЬ ПО
		|	_СчетаДоверительногоУправления.Наименование";
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
						
		Если ЭтаФорма.ОтобразитьТолькоНедостающиеОперации Тогда
									
			// Проверяем наличие документов и установку даты запрета редактирования
			Если ЗначениеЗаполнено(Выборка.РегистрацияСтоимостиАктивов) И Выборка.ДатаЗапретаРедактированияБэкОфис >= Объект.ДатаРасчета Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрокаЗакрытиеПериода = ЭтаФорма.ЗакрытиеПериода.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаЗакрытиеПериода, Выборка);
		              
		НоваяСтрокаЗакрытиеПериода.ОписаниеНастроекРасчета = ""
				+ НоваяСтрокаЗакрытиеПериода.ВариантРасчетаОценочнойСтоимости + ", "
				+ НоваяСтрокаЗакрытиеПериода.ВидУчетаПартий + ", "
				+ Формат(НоваяСтрокаЗакрытиеПериода.ДатаУстановкиЦелиРасчета, "ДФ=dd.MM.yyyy");
		
		Если РанееВыбДоверительногоУправления.Найти(НоваяСтрокаЗакрытиеПериода.СчетДоверительногоУправления) <> Неопределено Тогда
			НоваяСтрокаЗакрытиеПериода.Флажок = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	// Дополним таблицу сведениями о последовательности по бэк-офису
	
	Если ЭтаФорма.ОтображатьСостоянияПоследовательности И РаботаСПользователями.ЭтоПолноправныйПользователь() Тогда
		
		СчетаДоверительногоУправления = ЭтаФорма.ЗакрытиеПериода.Выгрузить(, "СчетДоверительногоУправления").ВыгрузитьКолонку(0);
		
		Если СчетаДоверительногоУправления.Количество() > 0 Тогда
			
			#Область Обновление_сведений_о_состоянии_последовательности
			
			СостоянияПоследовательности = Обработки.ВосстановлениеПоследовательностей.ПолучитьСостояниеПоследовательности(
				Новый Структура("Период, Организация, СчетДоверительногоУправления", Объект.ДатаРасчета, Объект.Организация, СчетаДоверительногоУправления),
				2,
				"ОперацииПоСчетуДоверительногоУправления"
			);
			
			Для каждого СтрокаЗакрытиеПериода Из ЗакрытиеПериода Цикл
				СтрокаСостоянияПоследовательности = СостоянияПоследовательности.Найти(СтрокаЗакрытиеПериода.СчетДоверительногоУправления, "СчетДоверительногоУправления");
				Если СтрокаСостоянияПоследовательности <> Неопределено Тогда
					СтрокаЗакрытиеПериода.ГраницаПоследовательности              = СтрокаСостоянияПоследовательности.ГраницаПоследовательности_Регистратор;
					СтрокаЗакрытиеПериода.ТочкаАктуальности                      = СтрокаСостоянияПоследовательности.ТочкаАктуальности_Регистратор;
					СтрокаЗакрытиеПериода.ГраницаПоследовательностиВосстановлена = СтрокаСостоянияПоследовательности.Восстановлена;
				КонецЕсли;
			КонецЦикла;
			
			#КонецОбласти
			
		КонецЕсли;
		
	КонецЕсли;

	// Переходим к ранее выбранной строке
	
	Если КлиентДоОбновления <> Неопределено Тогда 
		СтрокиКлиента = ЗакрытиеПериода.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", КлиентДоОбновления));
		Если СтрокиКлиента.Количество() > 0 Тогда
			Элементы.ЗакрытиеПериода.ТекущаяСтрока = СтрокиКлиента[0].ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьОперации(ОбновитьТаблицуОперацийПоЗавершению = Истина, ОтчетОРезультатахВыполнения = Неопределено, ПерезаполнитьРанееСозданныеОперации = Ложь, ДокументыКПерезаполнению = Неопределено, ТребуетсяКонтрольАкцептов = Истина)
	// Проверяем наличие котировок
	ОтсутствующиеДанные = "";	

	Если Не РаботаСПереоценкой.ПроверитьЗагружаемыеДанные(Объект.ДатаРасчета, , ОтсутствующиеДанные) Тогда
		ТекстВопроса = ОтсутствующиеДанные + "." + Символы.ПС + "Продолжить процесс регистрации операций?";
		Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да) <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	
	// Получаем стоимости ценных бумаг, предоставленные клиентами
	ПолучитьСтоимостиЦенныхБумагПредоставленныеКлиентами();
	
	ЗарегистрироватьОперацииНаСервере(ОбновитьТаблицуОперацийПоЗавершению, ОтчетОРезультатахВыполнения, ПерезаполнитьРанееСозданныеОперации, , ДокументыКПерезаполнению, ТребуетсяКонтрольАкцептов);
	
	Если ОтчетОРезультатахВыполнения <> Неопределено Тогда
		ОтчетОРезультатахВыполнения.Показать("Результаты выполнения операций");
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область Вспомогательные_функции

&НаСервереБезКонтекста
Функция ПолучитьСлужебныеСчетаДоверительногоУправления(Организация, Период)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("Период",			Период);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.КодСчета = ""О""
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &Период
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &Период)
		|	И НЕ СчетаДоверительногоУправления.ПометкаУдаления";
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СчетДоверительногоУправления");
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция СчетДУПоНавигационнойСсылке(ИдентификаторНавигационнойСсылки)
	УИДСтрокой = Прав(ИдентификаторНавигационнойСсылки, 8) + "-" + Сред(ИдентификаторНавигационнойСсылки, 21, 4) + "-" + Сред(ИдентификаторНавигационнойСсылки, 17, 4) + "-" + Лев(ИдентификаторНавигационнойСсылки, 4) + "-" + Сред(ИдентификаторНавигационнойСсылки, 5, 12);
	
	Возврат Справочники.СчетаДоверительногоУправления.ПолучитьСсылку(Новый УникальныйИдентификатор(УИДСтрокой));		
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСледующийДеньПослеПоследнегоРабочегоДня(ТекущаяДата)
	
	Результат = ТекущаяДата;
	
	БлижайшийРабочийДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ТекущаяДата - 1);
	
	Если ТекущаяДата - БлижайшийРабочийДень > 0 Тогда
		Результат = БлижайшийРабочийДень + 60*60*24;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
	
&НаСервереБезКонтекста
Функция ПолучитьСписокФайловОценочнойСтоимостиЦенныхБумагКлиента(ВыбранныеКлиенты, Организация, ДатаРасчета)
	
	Запрос = Новый Запрос( 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НастройкиЦелейРасчетаСрезПоследних.СчетДоверительногоУправления 
		|ИЗ
		|	РегистрСведений.НастройкиЦелейРасчета.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В (&СчетаДоверительногоУправления)
		|				И ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)) КАК НастройкиЦелейРасчетаСрезПоследних
		|ГДЕ
		|	НастройкиЦелейРасчетаСрезПоследних.ВариантРасчетаОценочнойСтоимости = ЗНАЧЕНИЕ(Справочник.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом)");	
		
	Запрос.УстановитьПараметр("Период",							ДатаРасчета);
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления",	ВыбранныеКлиенты);
		
	СписокФайлов = Новый Массив;	
	
	ВыборкаКлиентов = Запрос.Выполнить().Выбрать();
	Пока ВыборкаКлиентов.Следующий() Цикл 	
		ОписаниеФайлаКлиента = Новый Структура("СчетДоверительногоУправления, ПутьКФайлу, АдресТаблицыСтоимостей");
		ОписаниеФайлаКлиента.СчетДоверительногоУправления	= ВыборкаКлиентов.СчетДоверительногоУправления;	
		ОписаниеФайлаКлиента.ПутьКФайлу						= РаботаСПереоценкой.ПолучитьПутьКФайлуОценочнойСтоимостиПредоставленнойКлиентом(ВыборкаКлиентов.СчетДоверительногоУправления, ДатаРасчета);		
		
		СписокФайлов.Добавить(ОписаниеФайлаКлиента);
	КонецЦикла;		
		
	Возврат СписокФайлов;	
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДокументыСРучнымВводом(СчетаДУ, НаборДат)

	ТаблицаОтбор = Новый ТаблицаЗначений;
	ТаблицаОтбор.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	ТаблицаОтбор.Колонки.Добавить("НачалоДня", Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТаблицаОтбор.Колонки.Добавить("КонецДня", Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	
	Для каждого СчетДоверительногоУправления Из СчетаДУ Цикл
		Для каждого Дата Из НаборДат Цикл
			Строка = ТаблицаОтбор.Добавить();
			Строка.СчетДоверительногоУправления = СчетДоверительногоУправления;
			Строка.НачалоДня 	= Дата;
			Строка.КонецДня 	= КонецДня(Дата);
		КонецЦикла; 
	КонецЦикла; 
	
	#Область ТекстЗапроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаОтбор.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ТаблицаОтбор.НачалоДня КАК НачалоДня,
		|	_ТаблицаОтбор.КонецДня КАК КонецДня
		|ПОМЕСТИТЬ _ТаблицаОтбор
		|ИЗ
		|	&ТаблицаОтбор КАК _ТаблицаОтбор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РегистрацияСтоимостиАктивов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	РегистрацияСтоимостиАктивов.Ссылка КАК РегистрацияСтоимостиАктивов,
		|	РегистрацияСтоимостиАктивов.РучнойВвод КАК РучнойВвод,
		|	СчетаДоверительногоУправления.КодСчета КАК КодСчетаДоверительногоУправления,
		|	_ТаблицаОтбор.НачалоДня КАК НачалоДня
		|ПОМЕСТИТЬ _Документы
		|ИЗ
		|	_ТаблицаОтбор КАК _ТаблицаОтбор
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РегистрацияСтоимостиАктивов КАК РегистрацияСтоимостиАктивов
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|			ПО РегистрацияСтоимостиАктивов.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|		ПО _ТаблицаОтбор.СчетДоверительногоУправления = РегистрацияСтоимостиАктивов.СчетДоверительногоУправления
		|			И (РегистрацияСтоимостиАктивов.Дата МЕЖДУ _ТаблицаОтбор.НачалоДня И _ТаблицаОтбор.КонецДня)
		|ГДЕ
		|	РегистрацияСтоимостиАктивов.Проведен
		|	И РегистрацияСтоимостиАктивов.РучнойВвод
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Документы.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Документы.РегистрацияСтоимостиАктивов КАК РегистрацияСтоимостиАктивов,
		|	_Документы.РучнойВвод КАК РучнойВвод,
		|	_Документы.КодСчетаДоверительногоУправления КАК КодСчетаДоверительногоУправления,
		|	НастройкиЦелейРасчета.ВидУчетаДляОстатковПартий КАК ВидУчетаПартий,
		|	НастройкиЦелейРасчета.ВариантРасчетаОценочнойСтоимости КАК ВариантРасчетаОценочнойСтоимости,
		|	НастройкиЦелейРасчета.Период КАК ДатаУстановкиЦелиРасчета,
		|	_Документы.НачалоДня КАК НачалоДня
		|ИЗ
		|	_Документы КАК _Документы
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_Документы.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|			_Документы.НачалоДня КАК НачалоДня,
		|			МАКСИМУМ(НастройкиЦелейРасчета.Период) КАК ПериодНастроек
		|		ИЗ
		|			_Документы КАК _Документы
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЦелейРасчета КАК НастройкиЦелейРасчета
		|				ПО _Документы.СчетДоверительногоУправления = НастройкиЦелейРасчета.СчетДоверительногоУправления
		|					И (НастройкиЦелейРасчета.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении))
		|					И _Документы.НачалоДня >= НастройкиЦелейРасчета.Период
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_Документы.СчетДоверительногоУправления,
		|			_Документы.НачалоДня) КАК ВложенныйЗапрос
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЦелейРасчета КАК НастройкиЦелейРасчета
		|			ПО ВложенныйЗапрос.СчетДоверительногоУправления = НастройкиЦелейРасчета.СчетДоверительногоУправления
		|				И (НастройкиЦелейРасчета.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении))
		|				И ВложенныйЗапрос.ПериодНастроек = НастройкиЦелейРасчета.Период
		|		ПО _Документы.СчетДоверительногоУправления = ВложенныйЗапрос.СчетДоверительногоУправления
		|			И _Документы.НачалоДня = ВложенныйЗапрос.НачалоДня
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетДоверительногоУправления,
		|	НачалоДня";		
	#КонецОбласти 
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТаблицаОтбор", ТаблицаОтбор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	ДокументыСручнымВводом = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
	
		СтруктураСтроки = Новый Структура("СчетДоверительногоУправления, КодСчетаДоверительногоУправления, РегистрацияСтоимостиАктивов, 
												|ОписаниеНастроекРасчета, РучнойВвод");	
		ЗаполнитьЗначенияСвойств(СтруктураСтроки, Выборка);
		СтруктураСтроки.ОписаниеНастроекРасчета = ""
			+ Выборка.ВариантРасчетаОценочнойСтоимости + ", "
			+ Выборка.ВидУчетаПартий + ", "
			+ Формат(Выборка.ДатаУстановкиЦелиРасчета, "ДФ=dd.MM.yyyy");
			
		ДокументыСручнымВводом.Добавить(СтруктураСтроки);
		
	КонецЦикла; 
	
	Возврат ДокументыСручнымВводом;

КонецФункции

&НаСервереБезКонтекста
Функция ИнициализироватьКонтрольАкцептов(Организация, Дата)
	
	КонтрольАкцептов = Отчеты.КонтрольАкцептованияОпераций.Создать();
	КонтрольАкцептов.Организация 					= Организация;
	КонтрольАкцептов.Период.ДатаНачала 				= Дата;
	КонтрольАкцептов.Период.ДатаОкончания 			= КонецДня(Дата);
	КонтрольАкцептов.ВыводитьАкцептованныеДокументы = Ложь;
	
	Возврат КонтрольАкцептов;
		
КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьАкцептыПоДоговору(ВыбСчетДоверительногоУправления, Дата, КонтрольАкцептов, РезультатАкцептования, СообщенияОПроверке, ПоказыватьПолноеСообщение = Истина, ОтображатьСообщенияОДинамическомРасчетеПартий, Отказ = Ложь)

	РезультатАкцептования.Очистить();
	КонтрольАкцептов.СчетаДоверительногоУправления.Очистить();
	КонтрольАкцептов.СчетаДоверительногоУправления.Добавить(ВыбСчетДоверительногоУправления);
	КонтрольАкцептов.СкомпоноватьРезультат(РезультатАкцептования);
	Если РезультатАкцептования.ВысотаТаблицы > 3 Тогда 
		ЗарегистрироватьСообщение(
			СообщенияОПроверке, ВыбСчетДоверительногоУправления,
			"Контроль акцептования операций",
			"Есть неакцептованные операции за " + Формат(Дата, "ДФ=dd.MM.yyyy")  
			+ ?(ПоказыватьПолноеСообщение, ". Для проверки используйте команду 'Контроль акцептов'." + Символы.ПС + "Регистрация операций по '" + ВыбСчетДоверительногоУправления + "' прервана", ""),
			ОтображатьСообщенияОДинамическомРасчетеПартий,
			"Ошибка"
		);
		Отказ = Истина;
	КонецЕсли;
			
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗарегистрироватьСообщение(Сообщения, ГруппаОпераций, Операция, Расшифровка, ОтображатьСообщенияОДинамическомРасчетеПартий, Статус = "")
	СтрокаГруппыОпераций = Сообщения.Найти(ГруппаОпераций, "ГруппаОпераций");
	Если СтрокаГруппыОпераций = Неопределено Тогда
		СтрокаГруппыОпераций = Сообщения.Добавить();
		СтрокаГруппыОпераций.ГруппаОпераций = ГруппаОпераций;
	КонецЕсли;
	СообщенияГруппыОпераций = СтрокаГруппыОпераций.Сообщения;
		
	// Дополним сообщениями пользователю
	МассивСообщений = ПолучитьСообщенияПользователю(Истина);
	Для Каждого Сообщение Из МассивСообщений Цикл
		Если Не ОтображатьСообщенияОДинамическомРасчетеПартий Тогда
			Если СтрНайти(Сообщение.Текст, "Проведен динамический расчет партий") > 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		// Если расшифровка не заполнена и операции совпадают, то первое сообщение берем отсюда
		Если Не ЗначениеЗаполнено(Расшифровка) И (Не ЗначениеЗаполнено(Сообщение.КлючДанных) ИЛИ Сообщение.КлючДанных = Операция) Тогда
			Расшифровка	= Сообщение.Текст;
			Статус		= ?(ПустаяСтрока(Статус), "Предупреждение", Статус); 
		Иначе
			СообщенияГруппыОпераций.Добавить(
				Новый Структура("ГруппаОпераций, ВремяОперации, Операция, Расшифровка, Статус",
					ГруппаОпераций,
					ТекущаяДата(),
					"",
					Новый Структура("Текст, КлючДанных", Сообщение.Текст, Сообщение.КлючДанных),
					"Предупреждение"
				)
			);
		КонецЕсли;
		
		// Фиксируем, что по клиенту были предупреждения 
		Если СтрокаГруппыОпераций.Статус <> "2_Ошибки" Тогда
			СтрокаГруппыОпераций.Статус = "1_Предупреждения";
		КонецЕсли;
	КонецЦикла;
	
	СообщенияГруппыОпераций.Добавить(
		Новый Структура("ГруппаОпераций, ВремяОперации, Операция, Расшифровка, Статус",
			ГруппаОпераций,
			ТекущаяДата(),
			Операция,
			Расшифровка,
			Статус
		)
	);
	
	// Фиксируем, что по клиенту были ошибки 
	Если СтрокаГруппыОпераций.Статус <> "2_Ошибки" Тогда
		Если Статус = "Ошибка" Тогда
			СтрокаГруппыОпераций.Статус = "2_Ошибки";
		ИначеЕсли Статус = "Предупреждение" Тогда
			СтрокаГруппыОпераций.Статус = "1_Предупреждения";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗарегистрированаОтрицательнаяСЧА(РегистрацияСтоимостиАктивов)
	
	РезультатФункции = Ложь;
	
	Для Каждого СтрокаФинансовогоПоказателя Из РегистрацияСтоимостиАктивов.Движения.ФинансовыеПоказатели Цикл
		Если СтрокаФинансовогоПоказателя.ВидПоказателя = Справочники.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок Тогда
			РезультатФункции = (СтрокаФинансовогоПоказателя.Значение < 0);
			Прервать;
		КонецЕсли;
	КонецЦикла;
		
	Возврат РезультатФункции;
	
КонецФункции

&НаСервереБезКонтекста
Функция ТребуетсяВосстановлениеПоследовательности(Период, Организация, СчетДоверительногоУправления, ДатаГраницыПоследовательности)
	
	СостоянияПоследовательности = Обработки.ВосстановлениеПоследовательностей.ПолучитьСостояниеПоследовательности(
		Новый Структура("Период, Организация, СчетДоверительногоУправления", Период, Организация, СчетДоверительногоУправления),
		2,
		"ОперацииПоСчетуДоверительногоУправления"
	);
	
	Если СостоянияПоследовательности.Количество() > 0 Тогда
		
		СтрокаСостоянияПоследовательности = СостоянияПоследовательности[0];
		
		ДатаГраницыПоследовательности = НачалоДня(СтрокаСостоянияПоследовательности.ГраницаПоследовательности_Период);
		Возврат Не СтрокаСостоянияПоследовательности.Восстановлена;
		
	КонецЕсли;
	
	ДатаГраницыПоследовательности = Период;
	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДатуЗапретаРедактированияБэкОфиса(Организация, СчетДоверительногоУправления)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДатыЗапретаРедактированияБэкОфис.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактированияБэкОфис
		|ИЗ
		|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактированияБэкОфис
		|ГДЕ
		|	ДатыЗапретаРедактированияБэкОфис.Организация = &Организация
		|	И ДатыЗапретаРедактированияБэкОфис.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ДатыЗапретаРедактированияБэкОфис.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.БэкОфис)");
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДатаЗапретаРедактированияБэкОфис;
	Иначе
		Возврат Дата(1, 1, 1);
	КонецЕсли;

КонецФункции

&НаСервере
Процедура ВыполнитьКонтрольАкцептовНаСервере(ОтчетОРезультатах, Отказ)
	
	ЭтоМДТраст = Объект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_МДТраст");
	
	СообщенияОПроверке = ИнициализироватьСтруктуруСообщенийНаСервере();
	ПустаяТаблицаСообщений = СообщенияОПроверке.Скопировать();
	
	Если ЭтоМДТраст Тогда
		ЗарегистрироватьСообщение(СообщенияОПроверке, "Контроль акцептования операций", , "Контроль акцептования операций не требуется", ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий);
	Иначе	
		
		КонтрольАкцептов = ИнициализироватьКонтрольАкцептов(Объект.Организация, Объект.ДатаРасчета);
		РезультатАкцептования = Новый ТабличныйДокумент;
		ВыбСчетаДоверительногоУправления = ПолучитьВыбранныеСчетаДоверительногоУправленияНаСервере();
		
		Если ВыбСчетаДоверительногоУправления.Количество() = 0 Тогда
			Сообщить("Не выбраны счета доверительного управления для обработки");
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		Для Каждого ВыбСчетДоверительногоУправления Из ВыбСчетаДоверительногоУправления Цикл
			
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыбСчетДоверительногоУправления, "ВидДоговораДоверительногоУправления") <> Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда	
				Продолжить;
			КонецЕсли;
			
			ПроверитьАкцептыПоДоговору(ВыбСчетДоверительногоУправления, Объект.ДатаРасчета, КонтрольАкцептов, РезультатАкцептования, СообщенияОПроверке,, ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий, Ложь);
			
		КонецЦикла;
		
		Если СообщенияОПроверке.Количество() = 0 Тогда
			// Неакцептованных операций нет
			ЗарегистрироватьСообщение(СообщенияОПроверке, "Контроль акцептования операций", , "Контроль акцептования операций по паевым инвестиционным фондам выполнен", ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий);
		Иначе
			ЗарегистрироватьСообщение(СообщенияОПроверке, "Контроль акцептования операций", , "Для проверки используйте команду 'Контроль акцептов'", ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий, "Ошибка");
		КонецЕсли;
		
	КонецЕсли;
	
	ВывестиОтчетОРезультатахВыполненияОперацийНаСервере(ОтчетОРезультатах, СообщенияОПроверке, ПустаяТаблицаСообщений);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКлиентовСРегистрациейСЧАПоНерабочимДнямНаСервере(Данные, НачалоПериода, КонецПериода)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("НачалоПериода",					НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",					КонецПериода);
	Запрос.УстановитьПараметр("Организация",					Объект.Организация);
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления",	ПолучитьВыбранныеСчетаДоверительногоУправленияНаСервере());
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка В (&СчетаДоверительногоУправления)";
	
	Запрос.Выполнить();
	
	Справочники.НастройкиРегламентныхДействий.ПоместитьДатыДействияЗаПериодВоВременнуюТаблицу(Запрос, Новый Структура("ВидДействия, ДатаС, ДатаПо, ДополнитьРабочимиДнями", "СЧА", НачалоПериода, КонецПериода, Ложь));
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _Даты
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаря.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И НЕ ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДатыДействияЗаПериод.Дата КАК Дата,
		|	_ДатыДействияЗаПериод.Организация КАК Организация,
		|	_ДатыДействияЗаПериод.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _АктуальныеНастройки
		|ИЗ
		|	_Даты КАК _Даты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДатыДействияЗаПериод КАК _ДатыДействияЗаПериод
		|			ПО _Даты.Дата = _ДатыДействияЗаПериод.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктуальныеНастройки.Дата КАК Дата,
		|	_АктуальныеНастройки.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _Данные
		|ИЗ
		|	_АктуальныеНастройки КАК _АктуальныеНастройки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
		|		ПО _АктуальныеНастройки.Организация = ДатыЗапретаРедактирования.Организация
		|			И _АктуальныеНастройки.СчетДоверительногоУправления = ДатыЗапретаРедактирования.СчетДоверительногоУправления
		|			И (ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.БэкОфис))
		|			И _АктуальныеНастройки.Дата > ДатыЗапретаРедактирования.ДатаЗапретаРедактирования
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО _АктуальныеНастройки.Организация = ФинансовыеПоказатели.Организация
		|			И _АктуальныеНастройки.СчетДоверительногоУправления = ФинансовыеПоказатели.СубъектАналитики
		|			И _АктуальныеНастройки.Дата = ФинансовыеПоказатели.Период
		|ГДЕ
		|	ФинансовыеПоказатели.Значение ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	РегистрацияСтоимостиАктивов.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _НаличиеДокументов
		|ИЗ
		|	Документ.РегистрацияСтоимостиАктивов КАК РегистрацияСтоимостиАктивов
		|ГДЕ
		|	РегистрацияСтоимостиАктивов.Проведен
		|	И РегистрацияСтоимостиАктивов.Организация = &Организация
		|	И (НАЧАЛОПЕРИОДА(РегистрацияСтоимостиАктивов.Дата, ДЕНЬ), РегистрацияСтоимостиАктивов.СчетДоверительногоУправления) В
		|			(ВЫБРАТЬ
		|				_Данные.Дата КАК Дата,
		|				_Данные.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|			ИЗ
		|				_Данные КАК _Данные)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НачислениеРезервовПИФ.СчетДоверительногоУправления
		|ИЗ
		|	Документ.НачислениеРезервовПИФ КАК НачислениеРезервовПИФ
		|ГДЕ
		|	НачислениеРезервовПИФ.Проведен
		|	И НачислениеРезервовПИФ.Организация = &Организация
		|	И (НАЧАЛОПЕРИОДА(НачислениеРезервовПИФ.Дата, ДЕНЬ), НачислениеРезервовПИФ.СчетДоверительногоУправления) В
		|			(ВЫБРАТЬ
		|				_Данные.Дата КАК Дата,
		|				_Данные.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|			ИЗ
		|				_Данные КАК _Данные)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Данные.Дата КАК Дата,
		|	_Данные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НЕ _НаличиеДокументов.СчетДоверительногоУправления ЕСТЬ NULL КАК ЕстьДокументы
		|ИЗ
		|	_Данные КАК _Данные
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НаличиеДокументов КАК _НаличиеДокументов
		|		ПО _Данные.СчетДоверительногоУправления = _НаличиеДокументов.СчетДоверительногоУправления
		|ИТОГИ ПО
		|	Дата";
	
	ВыборкаДаты = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДаты.Следующий() Цикл
		
		Дата = Новый Структура;
		Дата.Вставить("Дата",							ВыборкаДаты.Дата);
		Дата.Вставить("СчетаДоверительногоУправления",	Новый Массив);
		
		ВыборкаСчетаДоверительногоУправления = ВыборкаДаты.Выбрать();
		
		Пока ВыборкаСчетаДоверительногоУправления.Следующий() Цикл
			
			Дата.СчетаДоверительногоУправления.Добавить(ВыборкаСчетаДоверительногоУправления.СчетДоверительногоУправления);
			
			Если НЕ Данные.ЕстьДокументы И ВыборкаСчетаДоверительногоУправления.ЕстьДокументы Тогда
				Данные.ЕстьДокументы = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		Данные.Даты.Добавить(Дата);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьВыбранныеСчетаДоверительногоУправленияНаСервере()
	
	ВыбСчетаДоверительногоУправления = Новый Массив;
	
	Для каждого Элемент Из ЭтаФорма.ЗакрытиеПериода Цикл
		Если Элемент.Флажок Тогда
			ВыбСчетаДоверительногоУправления.Добавить(Элемент.СчетДоверительногоУправления);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВыбСчетаДоверительногоУправления;
	
КонецФункции // ПолучитьВыбранныеСчетаДоверительногоУправленияНаСервере

&НаСервере
Процедура ПроверитьНаличиеСделокСОтклонениямиОтРыночныхЦенНаСервере(СообщенияПоОбщимОперациям)
	
	// Определим действующие счета ДУ (только ПН) по организации.
	ДействующиеСчетаДУ = Справочники.СчетаДоверительногоУправления.СчетаДоверительногоУправленияНаДатуСАктивами(
								Объект.ДатаРасчета, 
								Справочники.СчетаДоверительногоУправления.СтруктураДляОтбораСчетовДоверительногоУправления(
										Объект.Организация, 
										Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
								).ВыгрузитьКолонку("СчетДоверительногоУправления");
	
	// Получим список счетов ДУ, по которым производятся операции.
	Отбор = Новый Структура("Флажок", Истина);
	ОбрабатываемыеСчетаДУ = ЗакрытиеПериода.Выгрузить(Отбор, "СчетДоверительногоУправления").ВыгрузитьКолонку("СчетДоверительногоУправления");
	
	// Если присутствует хотя бы один действующий ПН - выполняем проверку.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОбрабатываемыеСДУ",	ОбрабатываемыеСчетаДУ);
	Запрос.УстановитьПараметр("ДействующиеСДУ",		ДействующиеСчетаДУ);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка В(&ОбрабатываемыеСДУ)
		|	И СчетаДоверительногоУправления.Ссылка В(&ДействующиеСДУ)";
	
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	РезультатПроверкиОтклонений = "Не удалось проверить наличие сделок с отклонениями от рыночных цен! Причина: ";
	
	Если ЗавершенаОбработкаПННаСервере(ДействующиеСчетаДУ) Тогда
		
		СтрокаСообщенийОКотировках	= "";
		
		КотировкиЗагружены = РаботаСПереоценкой.ПроверитьЗагружаемыеДанные(Объект.ДатаРасчета, Новый Структура("КотировкиММВБ", Истина), СтрокаСообщенийОКотировках);	
		
		Если НЕ КотировкиЗагружены Тогда
			РезультатПроверкиОтклонений = РезультатПроверкиОтклонений + СтрокаСообщенийОКотировках;
		Иначе
			
			ОтчетностьЦБОбъект = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьОбъектВнешнейОбработки(ОбщегоНазначения.ПолучитьИменованныйОбъект("ВнешОтч_ОтчетностьЦБ"));
			
			ОтчетностьЦБОбъект.Период.ДатаНачала	= НачалоДня(Объект.ДатаРасчета);
			ОтчетностьЦБОбъект.Период.ДатаОкончания	= КонецДня(Объект.ДатаРасчета);
			ОтчетностьЦБОбъект.Организация			= Объект.Организация;
			
			Попытка
				ПакетДанных					= ОтчетностьЦБОбъект.ПолучитьДанные_ОКУД0420511();
				СтрокиОтчета				= ПакетДанных.Отчет.ОтчетОСделках.Таблица_ОтчетОСделках.Таб_СведенияОСделкахСтроки_1;
				РезультатПроверкиОтклонений	= ?(ЗначениеЗаполнено(СтрокиОтчета) И СтрокиОтчета[0] <> "ЗаполнитьПустымиЗначениями", "Обнаружены отклонения!", "Отклонения не обнаружены.");
			Исключение
				РезультатПроверкиОтклонений	= РезультатПроверкиОтклонений + ОписаниеОшибки();
			КонецПопытки;
			
		КонецЕсли;
		
	Иначе
		РезультатПроверкиОтклонений = РезультатПроверкиОтклонений + "Не по всем счетам ДУ с видом договора 'Управление пенсионными накоплениями' закрыт период.";
	КонецЕсли;	
	
	ЗарегистрироватьСообщение(
		СообщенияПоОбщимОперациям,
		"Общие операции",
		"Проверка наличия сделок с отклонениями от рыночных цен",
		РезультатПроверкиОтклонений,
		ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий,
		?(РезультатПроверкиОтклонений = "Отклонения не обнаружены.", "", "Ошибка") 
	);	

КонецПроцедуры

&НаСервере
Функция ИнициализироватьОтчетОРезультатахВыполненияНаСервере(НаборДат = Неопределено)
	Отчет = Новый ТабличныйДокумент;
	
	// Заполнить параметры шапки
	ПараметрыШапки = Новый Структура;
	ПараметрыШапки.Вставить("Организация", Объект.Организация);	
	
	// Даты
	Если НаборДат = Неопределено Тогда
		ПараметрыШапки.Вставить("Период", Формат(Объект.ДатаРасчета, "ДФ=dd.MM.yyyy"));
	Иначе
		ДатыСтрокой = "";
		Для Каждого ДатаОпераций Из НаборДат Цикл
			ДатыСтрокой = ДатыСтрокой + Формат(ДатаОпераций, "ДФ=dd.MM.yyyy") + ", ";		
		КонецЦикла;
		ДатыСтрокой = Лев(ДатыСтрокой, СтрДлина(ДатыСтрокой) - 2);
		
		ПараметрыШапки.Вставить("Период", ДатыСтрокой);
	КонецЕсли;
		
	// Счета ДУ
	ВыбранныеСчетаДУ = ПолучитьВыбранныеСчетаДоверительногоУправленияНаСервере();
	ПараметрыШапки.Вставить("ВыбранныеСчетаДУ", ВыбранныеСчетаДУ);
	
	ВсегоВыбраноСчетовДУ = ВыбранныеСчетаДУ.Количество();
	Если ВсегоВыбраноСчетовДУ < 4 Тогда 	
		ПараметрыШапки.Вставить("СчетаДоверительногоУправления", СтрСоединить(ВыбранныеСчетаДУ, ", "));
	Иначе
		ПараметрыШапки.Вставить("СчетаДоверительногоУправления", 
			"<Cписок из "
			+ Формат(ВсегоВыбраноСчетовДУ, "ЧГ=") + " "
			+ РаботаСоСтрокамиКлиентСервер.ФормаМножественногоЧисла(ВсегоВыбраноСчетовДУ, "клиента", "клиентов", "клиентов")
			+ ">"
		);
	КонецЕсли;
	
	// Выведем шапку	
	Макет	= РеквизитФормыВЗначение("Объект").ПолучитьМакет("ОтчетОРезультатах");
	
	Область	= Макет.ПолучитьОбласть("ШапкаОтчета");	
	ЗаполнитьЗначенияСвойств(Область.Параметры, ПараметрыШапки);
	Отчет.Вывести(Область);
		
	// Заполним свойства отчета
	Отчет.ТолькоПросмотр		= Истина;
	Отчет.ОтображатьСетку		= Ложь;
	Отчет.ОтображатьЗаголовки	= Ложь;	
	
	// Заполняем настройки печати	
	ИмяОбъекта = Лев(ЭтаФорма.ИмяФормы, СтрНайти(ЭтаФорма.ИмяФормы, ".", , , 2) - 1);
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(Отчет, ИмяОбъекта + ".ОтчетОРезультатах", Истина, ОриентацияСтраницы.Портрет); 
	
	Возврат Отчет;
КонецФункции

&НаСервере
Функция ИнициализироватьСтруктуруСообщенийНаСервере()
	Сообщения = Новый ТаблицаЗначений;
	
	ДоступныеГруппыОпераций = Новый Массив;
	ДоступныеГруппыОпераций.Добавить("СправочникСсылка.СчетаДоверительногоУправления");
	ДоступныеГруппыОпераций.Добавить("Строка");
	
	Сообщения.Колонки.Добавить("ГруппаОпераций", Новый ОписаниеТипов(ДоступныеГруппыОпераций, , Новый КвалификаторыСтроки(30)));
	Сообщения.Колонки.Добавить("Статус",		 Новый ОписаниеТипов("Строка"));
	Сообщения.Колонки.Добавить("Сообщения",		 Новый ОписаниеТипов("Массив"));
	
	Сообщения.Индексы.Добавить("ГруппаОпераций");
	
	Возврат Сообщения;
КонецФункции

&НаСервере
Процедура ОповеститьОПодобранныхАналогахНаСервере(СообщенияПоОбщимОперациям)
	
	// По каждому клиенту с автоформированием аналогов проверяем закрыты ли его счета.
	// Если закрыты все, то шлем письмо с аналогами.
	// Если есть не закрытые, то сообщаем об этом в отчете.
	
	ОбрабатываемыеСчетаДУ = ЗакрытиеПериода.Выгрузить(Новый Структура("Флажок", Истина), "СчетДоверительногоУправления").ВыгрузитьКолонку(0);
	Если ОбрабатываемыеСчетаДУ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДействующиеСчетаДУ.Клиент КАК Клиент,
		|	_ДействующиеСчетаДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЕСТЬNULL(ДатыЗапретаРедактирования.ДатаЗапретаРедактирования >= &ДатаРасчета, ИСТИНА) КАК Закрыт
		|ИЗ
		|	_ДействующиеСчетаДУ КАК _ДействующиеСчетаДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			_ДействующиеСчетаДУ.Клиент КАК Клиент
		|		ИЗ
		|			_ДействующиеСчетаДУ КАК _ДействующиеСчетаДУ
		|		ГДЕ
		|			_ДействующиеСчетаДУ.СчетДоверительногоУправления В(&ОбрабатываемыеСчетаДУ)) КАК ОбрабатывамыеКлиенты
		|		ПО (ОбрабатывамыеКлиенты.Клиент = _ДействующиеСчетаДУ.Клиент)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК АвтоматическийПодборАналогов
		|		ПО (АвтоматическийПодборАналогов.Объект = _ДействующиеСчетаДУ.Клиент)
		|			И (АвтоматическийПодборАналогов.Свойство.Ключ = ""АвтоматическийПодборАналогов"")
		|			И (АвтоматическийПодборАналогов.Значение = ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
		|		ПО (ДатыЗапретаРедактирования.Организация = &Организация)
		|			И (ДатыЗапретаРедактирования.СчетДоверительногоУправления = _ДействующиеСчетаДУ.СчетДоверительногоУправления)
		|			И (ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Бэкофис))
		|			И (ДатыЗапретаРедактирования.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ПустаяСсылка))
		|ИТОГИ
		|	МИНИМУМ(Закрыт)
		|ПО
		|	Клиент");
		
	Справочники.СчетаДоверительногоУправления.СчетаДоверительногоУправленияНаДатуСАктивами(
				Объект.ДатаРасчета,
				Справочники.СчетаДоверительногоУправления.СтруктураДляОтбораСчетовДоверительногоУправления(
							Объект.Организация),
				Истина,
				"_ДействующиеСчетаДУ", 
				Запрос.МенеджерВременныхТаблиц);	
	
	Запрос.УстановитьПараметр("ДатаРасчета",			Объект.ДатаРасчета);
	Запрос.УстановитьПараметр("Организация",			Объект.Организация);
	Запрос.УстановитьПараметр("ОбрабатываемыеСчетаДУ",	ОбрабатываемыеСчетаДУ);
	
	ВыборкаПоКлиенту = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПоКлиенту.Следующий() Цикл
		
		Если ВыборкаПоКлиенту.Закрыт Тогда
			
			Попытка
				
				// Формируем список аналогов для отправки в спецдеп
				
				СпециализированныйДепозитарий	= РегистрыСведений.КлиентыДоверительногоУправления.СпециализированныйДепозитарийКлиента(ВыборкаПоКлиенту.Клиент, Объект.Организация, Объект.ДатаРасчета);
	            Подписант						= РаботаСОтчетами.ПолучитьПодписантаПоУмолчанию(Справочники.Отчеты.БэкОфис, Объект.Организация);

				Если СпециализированныйДепозитарий = Неопределено Тогда
					ЮрЛицоДепозитария = Неопределено;	
				Иначе
					ЮрЛицоДепозитария = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СпециализированныйДепозитарий, "ЮрФизЛицо");
				КонецЕсли;

				ПечатнаяФорма = Обработки.ПечатьСпискаАналогичныхЦенныхБумаг.Создать().СформироватьПечатнуюФормуСпискаАналогов(
					ВыборкаПоКлиенту.Клиент, Объект.Организация, Объект.ДатаРасчета, , ЮрЛицоДепозитария, Подписант); 

				// Формируем уведомление
				
				ФорматФайла	= "docx";
				ДатаСтрокой	= Формат(Объект.ДатаРасчета, "ДФ=dd.MM.yyyy");
				ИмяФайла	= СтрШаблон("Аналоги %1.%2", ДатаСтрокой, ФорматФайла);
				
				ПотокВПамяти = Новый ПотокВПамяти();
				ПечатнаяФорма.Записать(ПотокВПамяти, ТипФайлаТабличногоДокумента[ФорматФайла]); 
				ДвоичныеДанныеФайла = ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();
				
				Вложения = Новый Соответствие;
				Вложения.Вставить(ИмяФайла, ДвоичныеДанныеФайла);
				
				РеквизитыОповещения = Новый Структура;
				РеквизитыОповещения.Вставить("Клиент",		ВыборкаПоКлиенту.Клиент);
				РеквизитыОповещения.Вставить("Организация",	Объект.Организация);
				РеквизитыОповещения.Вставить("Дата",		Объект.ДатаРасчета);
				РеквизитыОповещения.Вставить("ДатаСтрокой",	ДатаСтрокой);
				РеквизитыОповещения.Вставить("Получатель",	ЮрЛицоДепозитария);
				РеквизитыОповещения.Вставить("Вложения",	Вложения);
				
				Справочники.Оповещения.СформироватьОповещения(
					"Обработка.ПечатьСпискаАналогичныхЦенныхБумаг",
					Перечисления.ТипыСобытий.ВнешнийВызов,
					РеквизитыОповещения); 
					
				ЗарегистрироватьСообщение(
					СообщенияПоОбщимОперациям, "Общие операции",
					СтрШаблон("Формирование уведомления о подобранных аналогах для '%1'", ВыборкаПоКлиенту.Клиент),
					"Уведомление успешно сформировано.",					
					ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий
					);
					
			Исключение
					
				ЗарегистрироватьСообщение(
					СообщенияПоОбщимОперациям, "Общие операции",
					СтрШаблон("Формирование уведомления о подобранных аналогах для '%1'", ВыборкаПоКлиенту.Клиент),
					"Ошибка формирования уведомления:" + Символы.ПС + ОписаниеОшибки(),
					ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий,
					"Ошибка");
				
			КонецПопытки;
	
			
		Иначе
			
			НезакрытыеСчетаДУ = Новый Массив;
			
			ВыборкаПоСчетуДУ = ВыборкаПоКлиенту.Выбрать();
			Пока ВыборкаПоСчетуДУ.Следующий() Цикл
				Если Не ВыборкаПоСчетуДУ.Закрыт Тогда
					НезакрытыеСчетаДУ.Добавить(ВыборкаПоСчетуДУ.СчетДоверительногоУправления);
				КонецЕсли;
			КонецЦикла;
			
			ЗарегистрироватьСообщение(
				СообщенияПоОбщимОперациям, "Общие операции",
				СтрШаблон("Формирование уведомления о подобранных аналогах для '%1'", ВыборкаПоКлиенту.Клиент),
				СтрШаблон("Уведомление не было сформировано, т.к. не закрыты счета д/у клиента: %1", СтрСоединить(НезакрытыеСчетаДУ, ", ")),
				ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий,
				"Предупреждение");	
			
		КонецЕсли;
		
	КонецЦикла;			
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьКонтрольОтклоненияСЧАНаСервере(СообщенияПоОперациям, СДУ)
	
	Обработка = Обработки.КонтрольОтклоненияСЧА.Создать();
	
	Обработка.Организация						= Объект.Организация;
	Обработка.Период.ДатаНачала					= Объект.ДатаРасчета;
	Обработка.Период.ДатаОкончания				= Объект.ДатаРасчета;
	Обработка.ИсключитьУспешноПрошедшихКонтроль	= Истина;
	Обработка.ПроцентОтклоненияСЧА				= 5;
	
	НоваяСтрока									= Обработка.Список.Добавить();
	НоваяСтрока.СчетДоверительногоУправления	= СДУ;
	
	РезультатПроверки = Обработка.ПроверитьСписокДоговоров();
	
	Если РезультатПроверки.Количество() > 0 Тогда
		ЗарегистрироватьСообщение(
			СообщенияПоОперациям,
			СДУ,
			"Контроль отклонения СЧА",
			"Контроль не пройден! " + РезультатПроверки[0].Комментарий,
			ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий,
			"Предупреждение");
	Иначе
		ЗарегистрироватьСообщение(
			СообщенияПоОперациям,
			СДУ,
			"Контроль отклонения СЧА",
			"Контроль пройден успешно.",
			ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗавершенаОбработкаПННаСервере(СчетаДУ)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата",			Объект.ДатаРасчета);
	Запрос.УстановитьПараметр("Организация",	Объект.Организация);
	Запрос.УстановитьПараметр("СчетаДУ",		СчетаДУ);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования
		|ИЗ
		|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
		|ГДЕ
		|	ДатыЗапретаРедактирования.Организация = &Организация
		|	И ДатыЗапретаРедактирования.СчетДоверительногоУправления В (&СчетаДУ)
		|	И ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.БэкОфис)
		|	И ДатыЗапретаРедактирования.ДатаЗапретаРедактирования < &Дата";
	
	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции

&НаСервере
Функция ВывестиОтчетОРезультатахВыполненияОперацийНаСервере(ОтчетОРезультатахВыполнения, СообщенияПоОперациям, СообщенияПоОбщимОперациям)
	
	// Инициализация
	
	ЕстьОшибки = Ложь;
	
	Если ОтчетОРезультатахВыполнения = Неопределено Тогда
		ОтчетОРезультатахВыполнения = ИнициализироватьОтчетОРезультатахВыполненияНаСервере();
	КонецЕсли;
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ОтчетОРезультатах");
	
	// Период	
	
	ОбластьПериод = Макет.ПолучитьОбласть("ШапкаПериод");
	ОбластьПериод.Параметры.Период = Формат(Объект.ДатаРасчета, "ДФ=dd.MM.yyyy");	
	ОтчетОРезультатахВыполнения.Вывести(ОбластьПериод);
	
	// Сообщения, разбитые по группам
	
	ОтчетОРезультатахВыполнения.НачатьГруппуСтрок();
	
	ГруппыСообщений = Новый Массив;
	ГруппыСообщений.Добавить(Новый Структура("ГруппыОпераций, Приоритетная", СообщенияПоОбщимОперациям, Истина));
	ГруппыСообщений.Добавить(Новый Структура("ГруппыОпераций, Приоритетная", СообщенияПоОперациям, Ложь));
	
	Для Каждого ГруппаСообщений Из ГруппыСообщений Цикл 
		
		ГруппаСообщений.ГруппыОпераций.Сортировать("Статус УБЫВ"); // Сначала ошибочные, потом предупреждения	
		
		Для Каждого ГруппаОпераций Из ГруппаСообщений.ГруппыОпераций Цикл
			СтатусГруппы					= ?(ГруппаОпераций.Статус = "2_Ошибки", "Ошибка", ?(ГруппаОпераций.Статус = "1_Предупреждения", "Предупреждение", ""));
			ВыводитьГруппуОперацийВОтчете	= Истина;
			
			СообщенияГруппыОпераций = ГруппаОпераций.Сообщения; 
			ВсегоСообщений = СообщенияГруппыОпераций.Количество();
			
			Для н = 1 По ВсегоСообщений Цикл
				Сообщение = СообщенияГруппыОпераций[ВсегоСообщений - н];
				
				ВывестиРезультатОперацииВОтчетНаСервере(ОтчетОРезультатахВыполнения, Макет, ВыводитьГруппуОперацийВОтчете, ГруппаСообщений.Приоритетная, СтатусГруппы, 
					Сообщение.ГруппаОпераций,
					Сообщение.ВремяОперации,
					Сообщение.Операция,
					Сообщение.Расшифровка,
					Сообщение.Статус
				);
			КонецЦикла;
		КонецЦикла;	
	
		Если Не ЕстьОшибки Тогда
			ЕстьОшибки = (ГруппаСообщений.ГруппыОпераций.Найти("2_Ошибки", "Статус") <> Неопределено);	
		КонецЕсли;
		
	КонецЦикла;	
	
	ОтчетОРезультатахВыполнения.ЗакончитьГруппуСтрок();
	
	// Если есть ошибки, подменяем область с итоговым результатом
	
	Если ЕстьОшибки Тогда
		ПараметрыЯчейкиИсточника = Макет.Область("ВыполненоСОшибками");
		ПараметрыЯчейкиПриемника = Макет.Область("ВыполненоБезОшибок");
		
		ЗаполнитьЗначенияСвойств(
			ОтчетОРезультатахВыполнения.Область(ПараметрыЯчейкиПриемника.Верх, ПараметрыЯчейкиПриемника.Лево, ПараметрыЯчейкиПриемника.Низ, ПараметрыЯчейкиПриемника.Право), 
			ПараметрыЯчейкиИсточника,
			"Текст, ЦветТекста"
		);
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ВывестиРезультатОперацииВОтчетНаСервере(Отчет, Макет, ВыводитьГруппуОпераций, Приоритетная, СтатусГруппы, ГруппаОпераций, ВремяОперации, Операция, Расшифровка, Статус = "")
	Если ЭтаФорма.ВыводитьВОтчетеТолькоОшибки И Статус = "" Тогда
		Возврат;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Операция) Тогда
		ИмяОбласти = "Операция" + Статус + ?(ВыводитьГруппуОпераций, "", "БезГруппыОпераций");
	Иначе
		ИмяОбласти = "ТолькоРасшифровка" + Статус;
	КонецЕсли;
	
	Область = Макет.ПолучитьОбласть(ИмяОбласти);
	Область.Параметры.ГруппаОпераций	= ГруппаОпераций;
	Область.Параметры.ВремяОперации		= ВремяОперации;
	Область.Параметры.Операция			= Операция;
	
	Если ТипЗнч(Расшифровка) = Тип("Структура") Тогда
		Область.Параметры.Расшифровка			= Расшифровка.Текст;
		Область.Параметры.РасшифровкаКлючДанных = Расшифровка.КлючДанных;
	Иначе
		Область.Параметры.Расшифровка = Расшифровка;
	КонецЕсли;
	
	Если Приоритетная Тогда
		ОбластьГруппыОпераций = Область.Области.Найти("ГруппаОпераций" + Статус);
		Если ОбластьГруппыОпераций <> Неопределено Тогда 
			ОбластьГруппыОпераций.Шрифт			= Новый Шрифт(ОбластьГруппыОпераций.Шрифт, , , Истина);
			ОбластьГруппыОпераций.ЦветТекста	= Макет.Область("ГруппаОпераций" + СтатусГруппы).ЦветТекста;
		КонецЕсли;
	КонецЕсли;
	
	Отчет.Вывести(Область);
	
	Если ВыводитьГруппуОпераций Тогда
		ВыводитьГруппуОпераций = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ЗарегистрироватьОперацииЗаДень(День, Клиенты, Отчет, СоздаватьНедостающие = Истина, ДокументыКПерезаполнению = Неопределено, ПерезаполнитьБезУчетаНастроекРегламентныхДействий = Ложь)
	
	Состояние("Выполняется расчет за " + Формат(День, "ДФ=dd.MM.yyyy"));
	
	Объект.ДатаРасчета = День;
	
	ОбновитьЗакрытиеПериодаНаСервере(Ложь, ПерезаполнитьБезУчетаНастроекРегламентныхДействий);
	
	Для каждого Элемент Из ЭтотОбъект.ЗакрытиеПериода Цикл
		Элемент.Флажок = (Клиенты.Найти(Элемент.СчетДоверительногоУправления) <> Неопределено);
	КонецЦикла;
	
	// Проверяем наличие котировок
	ОтсутствующиеДанные = "";	
	
	Если Не РаботаСПереоценкой.ПроверитьЗагружаемыеДанные(Объект.ДатаРасчета, , ОтсутствующиеДанные) Тогда
		
		ТекстВопроса = ОтсутствующиеДанные + "." + Символы.ПС + "Продолжить процесс регистрации операций?";
		
		Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да) <> КодВозвратаДиалога.Да Тогда
			Возврат Неопределено;
		КонецЕсли;	
		
	КонецЕсли;		
	
	// Получаем стоимости ценных бумаг, предоставленные клиентами
	ПолучитьСтоимостиЦенныхБумагПредоставленныеКлиентами();
	
	Возврат ЗарегистрироватьОперацииНаСервере(Ложь, Отчет, Истина, СоздаватьНедостающие, ДокументыКПерезаполнению);
	
КонецФункции

&НаКлиенте
Процедура ЗарегистрироватьОперацииЗаПериод(НаборДат, СоздаватьНедостающие, ДокументыКПерезаполнению, ПерезаполнитьБезУчетаНастроекРегламентныхДействий)
	
	ВыбСчетаДоверительногоУправления = ПолучитьВыбранныеСчетаДоверительногоУправленияНаСервере();
	
	Если ВыбСчетаДоверительногоУправления.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны счета д/у");
		Возврат;
	КонецЕсли;
	
	ОтчетОРезультатахВыполнения = ИнициализироватьОтчетОРезультатахВыполненияНаСервере(НаборДат);
	
	Обработано = 0;
	
	Для Каждого _ДатаРасчета Из НаборДат Цикл
		
		Результат = ЗарегистрироватьОперацииЗаДень(_ДатаРасчета, ВыбСчетаДоверительногоУправления, ОтчетОРезультатахВыполнения, СоздаватьНедостающие, ДокументыКПерезаполнению, ПерезаполнитьБезУчетаНастроекРегламентныхДействий);
		
		Если Результат = Неопределено Тогда
			Прервать;
		Иначе
			Обработано = Обработано + Результат;
		КонецЕсли;
		
	КонецЦикла;
	
	ОбновитьЗакрытиеПериодаНаСервере();
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выполнение завершено. Зарегистрировано операций: " + Обработано);
	
	ОтчетОРезультатахВыполнения.Показать("Результаты выполнения операций");
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВсеФлажкиТекущейТаблицы(Флажок)

	ТекущаяТаблицаФормы = ЭтаФорма.ЗакрытиеПериода;
	
	Для каждого Элемент Из ТекущаяТаблицаФормы Цикл
		Элемент.Флажок = Флажок;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВидимостьДоступностьЭлементовФормы()
	
	Элементы.ЗакрытиеПериодаГруппаКоличествоОпераций.Видимость = ЭтаФорма.ОтображатьКоличествоОпераций;
	Элементы.ЗакрытиеПериодаГруппаПоследовательность.Видимость = Элементы.ОтображатьСостоянияПоследовательности.Видимость И ЭтаФорма.ОтображатьСостоянияПоследовательности;
	
	Элементы.ИнвестСтратегия.Видимость						= (ЭтаФорма.РежимОтбора = 0);
	Элементы.СчетДоверительногоУправления.Видимость			= (ЭтаФорма.РежимОтбора = 1);
	Элементы.ВидДоговораДоверительногоУправления.Видимость	= (ЭтаФорма.РежимОтбора = 2);
	Элементы.КлиентДоверительногоУправления.Видимость		= (ЭтаФорма.РежимОтбора = 4);
	Элементы.ГруппаУниверсальныйОтбор.Видимость				= (ЭтаФорма.РежимОтбора = 8);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСтоимостиЦенныхБумагПредоставленныеКлиентами()
	
	ФайлыОценочнойСтоимостиЦенныхБумагКлиента.Очистить();	
	
	ВыбранныеКлиенты = Новый Массив;
	Для Каждого СтрокаКлиента Из ЗакрытиеПериода Цикл
		Если СтрокаКлиента.Флажок Тогда
			ВыбранныеКлиенты.Добавить(СтрокаКлиента.СчетДоверительногоУправления);
		КонецЕсли;
	КонецЦикла;
	
	СписокФайлов = ПолучитьСписокФайловОценочнойСтоимостиЦенныхБумагКлиента(ВыбранныеКлиенты, Объект.Организация, Объект.ДатаРасчета);	
	
	Для Каждого ФайлКлиента Из СписокФайлов Цикл
		ОписаниеФайлаКлиента = ФайлыОценочнойСтоимостиЦенныхБумагКлиента.Добавить();
		
		ЗаполнитьЗначенияСвойств(ОписаниеФайлаКлиента, ФайлКлиента);
		
		Если ЗначениеЗаполнено(ОписаниеФайлаКлиента.ПутьКФайлу) Тогда
			СвойстваФайла = Новый Файл(ОписаниеФайлаКлиента.ПутьКФайлу);
			Если СвойстваФайла.Существует() И СвойстваФайла.ЭтоФайл() Тогда
				ОписаниеФайлаКлиента.АдресТаблицыСтоимостей = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ОписаниеФайлаКлиента.ПутьКФайлу), ЭтаФорма.УникальныйИдентификатор);		       
			КонецЕсли;			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЕстьПорученияСНезаполненнойДатойПолученияНаСервере(ВыбСчетДоверительногоУправления, СообщенияПоОперациям)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПоручениеНаДвижениеДенежныхСредств.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПоручениеНаДвижениеДенежныхСредств КАК ПоручениеНаДвижениеДенежныхСредств
		|ГДЕ
		|	ПоручениеНаДвижениеДенежныхСредств.Организация = &Организация
		|	И ПоручениеНаДвижениеДенежныхСредств.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПоручениеНаДвижениеДенежныхСредств.СпособПередачи <> ЗНАЧЕНИЕ(Перечисление.СпособыПередачиПоручений.ВнутренняяСистема)
		|	И ПоручениеНаДвижениеДенежныхСредств.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ПоручениеНаДвижениеДенежныхСредств.Проведен
		|	И ПоручениеНаДвижениеДенежныхСредств.ДатаИВремяПолучения = &ПустаяДата
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПоручениеНаДвижениеЦенныхБумаг.Ссылка
		|ИЗ
		|	Документ.ПоручениеНаДвижениеЦенныхБумаг КАК ПоручениеНаДвижениеЦенныхБумаг
		|ГДЕ
		|	ПоручениеНаДвижениеЦенныхБумаг.Организация = &Организация
		|	И ПоручениеНаДвижениеЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПоручениеНаДвижениеЦенныхБумаг.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ПоручениеНаДвижениеЦенныхБумаг.Проведен
		|	И ПоручениеНаДвижениеЦенныхБумаг.ДатаИВремяПолучения = &ПустаяДата";
	
	Запрос.УстановитьПараметр("Организация", 					Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ВыбСчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаНачала", 					НачалоДня(Объект.ДатаРасчета));
	Запрос.УстановитьПараметр("ДатаОкончания", 					КонецДня(Объект.ДатаРасчета));
	Запрос.УстановитьПараметр("ПустаяДата", 					'00010101');
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
						
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ЗарегистрироватьСообщение(
				СообщенияПоОперациям, ВыбСчетДоверительногоУправления,
				"Проверка даты и времени получения у поручений",
				"В документе " + Выборка.Ссылка + " не указана дата и время получения.
				|Регистрация операций по '" + ВыбСчетДоверительногоУправления + "' прервана",
				ЭтаФорма.ОтображатьСообщенияОДинамическомРасчетеПартий,
				"Ошибка"
				);
			
		КонецЦикла;
		
		Возврат Истина;
		
	КонецЕсли;

	Возврат Ложь;
	
КонецФункции

#КонецОбласти
