
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ЭтаФорма.Организация = ПараметрыСеанса.ТекущаяОрганизация;
	Объект.КаталогСохранения = ПолучитьКаталогСохранения();
	
	Если Не ЗначениеЗаполнено(Объект.КаталогСохранения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для организации [" + ЭтаФорма.Организация + "] не указан каталог для сохранения подтверждений МНО.");
	КонецЕсли;
	
	ШаблонПодтверждения = ОбработкаОбъект.ПолучитьМакет("Подтверждение");
	
	Если Параметры.Свойство("МассивДокументов") Тогда
		СписокДокументов.ЗагрузитьЗначения(Параметры.МассивДокументов);
		Элементы.Подписант.СписокВыбора.ЗагрузитьЗначения(ОбработкаОбъект.ПолучитьПодписантов(Параметры.МассивДокументов));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);

КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если СохранитьПечатнуюФорму Тогда
		ПроверяемыеРеквизиты.Добавить("КаталогСохранения");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогСохраненияОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЗапуститьПриложение(Объект.КаталогСохранения);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМассивПодтверждений(МассивДокументов, Подписант)
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Обработки.ПечатьМНО.СформироватьМенеджерВременныхТаблицСДанными(МассивДокументов);
	
#Область Текст_Запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеДокументов.НомерПодтверждения КАК Номер,
		|	_ДанныеДокументов.Дата КАК ДатаРаспоряжения,
		|	БанковскиеСчета.ДоговорМНО КАК ДоговорМНО,
		|	БанковскиеСчета.Банк.Наименование КАК НаименованиеБанка,
		|	БанковскиеСчета.Банк.Город КАК Город,
		|	БанковскиеСчета.Банк.КоррСчет КАК КоррСчет,
		|	БанковскиеСчета.Банк.Код КАК БИК,
		|	БанковскиеСчета.Договор.НаименованиеВладельцаДляДокументов КАК Клиент,
		|	БанковскиеСчета.НомерСчета КАК НомерСчета,
		|	БанковскиеСчета.Валюта.НаименованиеПолное КАК Валюта,
		|	БанковскиеСчета.Валюта.ПараметрыПрописиНаРусском КАК ПараметрыПрописиВалютыНаРусском,
		|	_ДанныеДокументов.Сумма КАК Сумма,
		|	_ДанныеДокументов.Процент КАК Процент,
		|	_ДанныеДокументов.ДатаВозврата КАК ДатаКонец,
		|	РеквизитыБанков.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеБанка,
		|	РеквизитыБанков.ИНН КАК ИНН,
		|	КонтактныеЛица.КонтактноеЛицо.Представление КАК КонтактноеЛицо,
		|	ЕСТЬNULL(КонтактныеЛица.Должность, """") КАК Должность,
		|	_ДанныеДокументов.Организация.Наименование КАК ОрганизацияФайла,
		|	_ДанныеДокументов.СчетДоверительногоУправления.Наименование КАК СчетДУ,
		|	НАЧАЛОПЕРИОДА(_ДанныеДокументов.Дата, ДЕНЬ) КАК ДатаДок
		|ИЗ
		|	_ДанныеДокументов КАК _ДанныеДокументов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		|		ПО _ДанныеДокументов.РасчетныйСчет = БанковскиеСчета.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РеквизитыЮрЛиц КАК РеквизитыБанков
		|		ПО _ДанныеДокументов.РасчетныйСчет = РеквизитыБанков.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|		ПО _ДанныеДокументов.Организация.ЮрФизЛицо = КонтактныеЛица.Объект
		|			И (КонтактныеЛица.КонтактноеЛицо = &Подписант)
		|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаРаспоряжения
		|ИТОГИ ПО
		|	ДатаДок";
#КонецОбласти
	
	Запрос.УстановитьПараметр("Подписант", Подписант);
	
	ГруппировкаПоДате = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ОбщийМассив = Новый Массив;
	Пока ГруппировкаПоДате.Следующий() Цикл
		
		МассивПоДате = Новый Массив;
		Выборка = ГруппировкаПоДате.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтруктураРеквизитов = Новый Структура;
			СтруктураРеквизитов.Вставить("Номер", Строка(Выборка.Номер));
			СтруктураРеквизитов.Вставить("ДатаРаспоряжения", Формат(Выборка.ДатаРаспоряжения, "ДФ=dd.MM.yyyy"));
			СтруктураРеквизитов.Вставить("ГенСоглашение", СокрЛ(СтрЗаменить(Выборка.ДоговорМНО.НомерДоговора, "Ген.соглашение ", "")) + " от " + Формат(Выборка.ДоговорМНО.ДатаЗаключения, "ДФ=dd.MM.yyyy"));
			СтруктураРеквизитов.Вставить("Банк", СокрЛП(Выборка.НаименованиеБанка));
			СтруктураРеквизитов.Вставить("Клиент", Выборка.Клиент);
			
			СтруктураРеквизитов.Вставить("НомерСчета1", Выборка.НомерСчета);
			СтруктураРеквизитов.Вставить("НомерСчета2", "р/с " + Выборка.НомерСчета);
			СтруктураРеквизитов.Вставить("Банк2", Строка(Выборка.КраткоеНаименованиеБанка) + " " + (Выборка.Город));
			СтруктураРеквизитов.Вставить("КоррСчет2", "кор/сч " + Выборка.КоррСчет + "  БИК " + Выборка.БИК);
			СтруктураРеквизитов.Вставить("ИНН2", "ИНН " + Выборка.ИНН);
			
			СтруктураРеквизитов.Вставить("Валюта", Выборка.Валюта);
			СтруктураРеквизитов.Вставить("Сумма", Формат(Выборка.Сумма, "ЧДЦ=2") + " (" + ЧислоПрописью(Выборка.Сумма,, Выборка.ПараметрыПрописиВалютыНаРусском) + ")");
			СтруктураРеквизитов.Вставить("Ставка", Формат(Выборка.Процент, "ЧЦ=5; ЧДЦ=2")  + " %");
			СтруктураРеквизитов.Вставить("ДатаНачало", Формат(Выборка.ДатаРаспоряжения	, "ДФ='dd MMMM yyyy'") + "г");
			СтруктураРеквизитов.Вставить("ДатаКонец", Формат(Выборка.ДатаКонец	, "ДФ='dd MMMM yyyy'") + "г");
			
			СтруктураРеквизитов.Вставить("Подписант", Сред(Подписант, Найти(Подписант, " ") + 1) + " " + Лев(Подписант, Найти(Подписант, " ") - 1));
			СтруктураРеквизитов.Вставить("Должность", Выборка.Должность);
			
			РеквизитыФайла = Новый Структура;
			РеквизитыФайла.Вставить("ИмяФайла", РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(Выборка.ОрганизацияФайла
			+ " МНО N" + Формат(Выборка.Номер, "ЧН=0; ЧГ=0")
			+ " " + Выборка.СчетДУ
			+ " " + Формат(Выборка.ДатаРаспоряжения, "ДФ=dd-MM-yyyy")
			+ ".docx"));
			
			МассивПоДате.Добавить(Новый Структура("РеквизитыДокумента, РеквизитыФайла", СтруктураРеквизитов, РеквизитыФайла));
			
		КонецЦикла;
		
		ОбщийМассив.Добавить(Новый Структура("Дата, Данные", ГруппировкаПоДате.ДатаДок, МассивПоДате));
		
	КонецЦикла;
	
	Возврат ОбщийМассив;

КонецФункции

&НаКлиенте
Процедура СоздатьКаталогСохраненияПоДате(ПутьККаталогу)
	
	Файл = Новый Файл(ПутьККаталогу);
	
	Если Файл.Существует() И Файл.ЭтоКаталог() Тогда
		Возврат;
	КонецЕсли;
	
	СоздатьКаталог(ПутьККаталогу);
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЧтоКаталогСуществует(ПутьККаталогу)
	
	Файл = Новый Файл(ПутьККаталогу);
	
	Если Файл.Существует() И Файл.ЭтоКаталог() Тогда
		Возврат Истина;
	КонецЕсли;

	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Каталог """ + ПутьККаталогу + """ не найден",,"Объект.КаталогСохранения");
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ПолучитьКаталогСохранения()
	
	Возврат ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("КаталогПодтвержденийМНО", ЭтаФорма.Организация, '00010101');
	
КонецФункции // ПолучитьИмяФайлаОстатков

&НаКлиенте
Процедура Печать(Команда)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	МассивПодтверждений = ПолучитьМассивПодтверждений(СписокДокументов.ВыгрузитьЗначения(), Объект.Подписант);
	
	Если СохранитьПечатнуюФорму Тогда
		
		КаталогСохранения = СтрЗаменить(СокрЛП(Объект.КаталогСохранения), "/", "\");
	
		Если Прав(КаталогСохранения, 1) <> "\" Тогда
			
			Если Не ПроверитьЧтоКаталогСуществует(КаталогСохранения) Тогда
				Возврат;
			КонецЕсли;
			
			КаталогСохранения = КаталогСохранения + "\";
		ИначеЕсли Не ПроверитьЧтоКаталогСуществует(Лев(КаталогСохранения, СтрДлина(КаталогСохранения) - 1)) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ИмяФайлаШаблонаРаспоряжения = ПолучитьИмяВременногоФайла("docx");
	ШаблонПодтверждения.Записать(ИмяФайлаШаблонаРаспоряжения);
	
	Отказ = Ложь;
	Попытка
		
		// создадим документ MS Word на основании сохраненного шаблона
		WordApp = Новый COMОбъект("Word.Application");
		WordApp.Application.Visible = НЕ СохранитьПечатнуюФорму;
		
		Для каждого СтруктураПоДате из МассивПодтверждений Цикл
			
			Если СохранитьПечатнуюФорму Тогда
				// Согласовали в задаче #316301, храним в каталогах со структурой \Год\Месяц\Дата. Этот же каталог использует внешняя обработка выгрузки распоряжений на МНО в ГПБ
				КаталогСохраненияПоДате = КаталогСохранения + Формат(СтруктураПоДате.Дата, "ДФ=yyyy") + "\" + Формат(СтруктураПоДате.Дата, "ДФ=MMMM") + "\" + Формат(СтруктураПоДате.Дата, "ДФ=yyyy-MM-dd");
				СоздатьКаталогСохраненияПоДате(КаталогСохраненияПоДате);
				КаталогСохраненияПоДате = КаталогСохраненияПоДате + "\";
			КонецЕсли;
			
			Для Каждого СтруктураРеквизитов Из СтруктураПоДате.Данные Цикл
				
				Подтверждение = СтруктураРеквизитов.РеквизитыДокумента;
				
				NewDoc = WordApp.Application.Documents.Add(ИмяФайлаШаблонаРаспоряжения, False, , НЕ СохранитьПечатнуюФорму);
				
				WordVars = NewDoc.Variables;
				Для Каждого РеквизитПодтверждения Из Подтверждение Цикл
					WordVars.Item(РеквизитПодтверждения.Ключ).Value = РеквизитПодтверждения.Значение;
				КонецЦикла;
				
				NewDoc.Fields.Update();
				
				Если СохранитьПечатнуюФорму Тогда
					NewDoc.SaveAs(КаталогСохраненияПоДате + СтруктураРеквизитов.РеквизитыФайла.ИмяФайла);	
					NewDoc.Close();
				КонецЕсли;
				
				ОбработкаПрерыванияПользователя();
				
			КонецЦикла;
			
		КонецЦикла;
		
		Если СохранитьПечатнуюФорму Тогда
			WordApp.Application.Quit();
		КонецЕсли;
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(),,,,Отказ);	
	КонецПопытки;
	
	// удалим файл шаблона
	Попытка
		УдалитьФайлы(КаталогВременныхФайлов(), ИмяФайлаШаблонаРаспоряжения);
	Исключение
	КонецПопытки;
	
	Если Отказ Тогда
		ПоказатьПредупреждение(,"Печать документа завершилась с ошибкой");
	Иначе
		Если СохранитьПечатнуюФорму Тогда
			ПоказатьПредупреждение(,"Печать документа завершена");
		КонецЕсли;
	КонецЕсли;
	
	Если Не Отказ и НЕ СохранитьПечатнуюФорму Тогда
		WordApp.Application.Activate();
	КонецЕсли;

КонецПроцедуры

