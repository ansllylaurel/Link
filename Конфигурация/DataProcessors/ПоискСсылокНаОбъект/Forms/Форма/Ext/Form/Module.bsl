
&НаСервере
Процедура НайтиСсылкиНаСервере()
	
	ЭтаФорма.СсылкиНаОбъект.Очистить();
	
	Объекты = Новый Массив();
	Объекты.Добавить(Объект.Объект);
	
	СсылкиНаСервере = НайтиПоСсылкам(Объекты);
	
	Для каждого СтрокаСсылкиНаСервере Из СсылкиНаСервере Цикл
		НоваяСтрокаСсылкиНаОбъект = ЭтаФорма.СсылкиНаОбъект.Добавить();
		НоваяСтрокаСсылкиНаОбъект.Ссылка              = СтрокаСсылкиНаСервере[1];
		НоваяСтрокаСсылкиНаОбъект.ПолноеИмяМетаданных = СтрокаСсылкиНаСервере[2].ПолноеИмя();
	КонецЦикла;
	
КонецПроцедуры // НайтиСсылкиНаСервере

&НаКлиенте
Процедура КомандаНайтиСсылки(Команда)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	НайтиСсылкиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЭтаФорма.Параметры.Свойство("Объект") И ЗначениеЗаполнено(ЭтаФорма.Параметры.Объект) Тогда
		Объект.Объект = ЭтаФорма.Параметры.Объект;
		НайтиСсылкиНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СсылкиНаОбъектПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
	ОткрытьЗначение(Элементы.СсылкиНаОбъект.ТекущиеДанные.Ссылка);
	
КонецПроцедуры

