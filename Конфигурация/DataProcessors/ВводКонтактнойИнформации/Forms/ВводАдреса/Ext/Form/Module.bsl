
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтранаРоссия = Справочники.СтраныМира.Россия;
	НаселенныйПунктДетально = Новый Структура("ВнутригРайон, Город, НаселенныйПункт, Округ, Район, Регион, КодРегиона");
	
	ВидКонтактнойИнформации		= Параметры.ВидКонтактнойИнформации;
	ПредставлениеАдреса			= Параметры.Представление;
	ОбязательныеРеквизитыАдреса	= Параметры.ОбязательныеРеквизитыАдреса;
	
	Для Каждого Реквизит Из СтрРазделить(ОбязательныеРеквизитыАдреса, ",", Ложь) Цикл
		Элементы[Реквизит].АвтоОтметкаНезаполненного = Истина;
	КонецЦикла;
	
	Заголовок = ?(ПустаяСтрока(Параметры.Заголовок), ВидКонтактнойИнформации.Наименование, Параметры.Заголовок);
	
	ТипыАдресныхЭлементов = РаботаСКонтактнойИнформациейКлиентСервер.ПолучитьТипыАдресныхЭлементов();
	Для Каждого ТипАдресногоЭлемента Из ТипыАдресныхЭлементов Цикл
		Элементы.ДополнительныеАдресныеЭлементыТип.СписокВыбора.Добавить(ТипАдресногоЭлемента.Значение);
	КонецЦикла;
	
	ЗаполнитьФормуИзXDTO(Параметры.ЗначенияПолей);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФормуИзXDTO(ЗначенияПолей)
	
	Если ТипЗнч(ЗначенияПолей) <> Тип("Строка") 
		ИЛИ Не СтрНачинаетсяС(СокрЛ(ЗначенияПолей), "<") Тогда
		Комментарий	= Параметры.Представление;
		Возврат; //это не XML
	КонецЕсли;
	
	СтруктураАдреса = РаботаСКонтактнойИнформациейКлиентСервер.АдресФИАСВСтруктуру(ЗначенияПолей, Параметры.Представление);
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, СтруктураАдреса,, "ДополнительныеАдресныеЭлементы");
	
	Если ЗначениеЗаполнено(СтруктураАдреса.Страна) Тогда
		Страна = Справочники.СтраныМира.НайтиПоНаименованию(СтруктураАдреса.Страна);
	Иначе
		Страна = СтранаРоссия;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(НаселенныйПунктДетально, СтруктураАдреса);
	НаселенныйПункт =	СформироватьНаселенныйПункт(НаселенныйПунктДетально);
	
	ТипыАдресныхЭлементов = РаботаСКонтактнойИнформациейКлиентСервер.ПолучитьТипыАдресныхЭлементов();
	
	Для Каждого ДопАдрЭл Из СтруктураАдреса.ДополнительныеАдресныеЭлементы Цикл
		ДополнительныйАдресныйЭлемент = ДополнительныеАдресныеЭлементы.Добавить();
		ДополнительныйАдресныйЭлемент.Тип		= ТипыАдресныхЭлементов.Получить(ДопАдрЭл.Тип);
		ДополнительныйАдресныйЭлемент.Значение	= ДопАдрЭл.Значение;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементНаселенногоПункта(АдресРФ, ИмяЭлементаАдресаРФ, ИмяЭлементаНаселенногоПункта)
	
	Если ЗначениеЗаполнено(НаселенныйПунктДетально[ИмяЭлементаНаселенногоПункта]) Тогда
		Если ИмяЭлементаНаселенногоПункта = "Район" Тогда
			АдресРФ.СвРайМО = ФабрикаXDTO.Создать(АдресРФ.Тип().Свойства.Получить("СвРайМО").Тип);
			АдресРФ.СвРайМО.Район = НаселенныйПунктДетально[ИмяЭлементаНаселенногоПункта];
		Иначе
			АдресРФ[ИмяЭлементаАдресаРФ] = НаселенныйПунктДетально[ИмяЭлементаНаселенногоПункта];
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СформироватьРезультатВводаАдреса()
	
	ПространствоИмен = "http://www.v8.1c.ru/ssl/contactinfo";
	
	Результат = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(ПространствоИмен, "КонтактнаяИнформация"));
	Результат.Состав = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(ПространствоИмен, "Адрес"));
	Результат.Представление = ПредставлениеАдреса;
	Результат.Комментарий	= Комментарий;
	
	Адрес = Результат.Состав;
	
	Если Страна <> СтранаРоссия Тогда
		Адрес.Страна = Страна.Наименование;
		Адрес.Состав = ПредставлениеАдреса;
		
	Иначе
		АдресРФ = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(ПространствоИмен, "АдресРФ"));
		
		Если ЗначениеЗаполнено(Индекс) Тогда
			ЭлементИндекс = РаботаСВнешнимиСистемами.СоздатьДопАдрЭлемента(АдресРФ);
			ЭлементИндекс.ТипАдрЭл = "10100000";
			ЭлементИндекс.Значение = Индекс;
		КонецЕсли;	
		
		ДобавитьЭлементНаселенногоПункта(АдресРФ, "ВнутригРайон", "ВнутригРайон");
		ДобавитьЭлементНаселенногоПункта(АдресРФ, "Город", "Город");
		ДобавитьЭлементНаселенногоПункта(АдресРФ, "НаселПункт", "НаселенныйПункт");
		ДобавитьЭлементНаселенногоПункта(АдресРФ, "Округ", "Округ");
		ДобавитьЭлементНаселенногоПункта(АдресРФ, "Район", "Район");
		ДобавитьЭлементНаселенногоПункта(АдресРФ, "СубъектРФ", "Регион");
		ДобавитьЭлементНаселенногоПункта(АдресРФ, "КодСубъектаРФ", "КодРегиона");
		
		Если ЗначениеЗаполнено(Улица) Тогда
			АдресРФ.Улица = Улица;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КодАдресаФИАС) Тогда
			АдресРФ.КодАдресаФИАС = КодАдресаФИАС;
		КонецЕсли;
		
		КодыАдресныхЭлементов = РаботаСКонтактнойИнформациейКлиентСервер.ПолучитьКодыАдресныхЭлементов();
		
		Для Каждого ДополнительныйАдресныйЭлемент Из ДополнительныеАдресныеЭлементы Цикл
			ДопАдрЭл = РаботаСВнешнимиСистемами.СоздатьНомерДопАдрЭлемента(АдресРФ);
			ДопАдрЭл.Тип		= КодыАдресныхЭлементов.Получить(ДополнительныйАдресныйЭлемент.Тип);
			ДопАдрЭл.Значение	= ДополнительныйАдресныйЭлемент.Значение;
		КонецЦикла;
		
		//Если ЗначениеЗаполнено(Дом) Тогда
		//	ЭлементДом = РаботаСВнешнимиСистемами.СоздатьНомерДопАдрЭлемента(АдресРФ);
		//	ЭлементДом.Тип = ТипДома;
		//	ЭлементДом.Значение = Дом;
		//КонецЕсли;
		//
		//Если ЗначениеЗаполнено(Строение) Тогда
		//	ЭлементКорпус = РаботаСВнешнимиСистемами.СоздатьНомерДопАдрЭлемента(АдресРФ);
		//	ЭлементКорпус.Тип = ТипСтроения;
		//	ЭлементКорпус.Значение = Строение;
		//КонецЕсли;
		//
		//Если ЗначениеЗаполнено(Помещение) Тогда
		//	ЭлементКвартира = РаботаСВнешнимиСистемами.СоздатьНомерДопАдрЭлемента(АдресРФ);
		//	ЭлементКвартира.Тип = ТипПомещения;
		//	ЭлементКвартира.Значение = Помещение;
		//КонецЕсли;
		
		Адрес.Состав = АдресРФ;
		
	КонецЕсли;
	
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиXML(, , Ложь, Ложь, ""));
	
	ФабрикаXDTO.ЗаписатьXML(Запись, Результат);
	
	Результат = СтрЗаменить(Запись.Закрыть(), Символы.ПС, "&#10;");
	
	
	Возврат Новый Структура("ЗначенияПолей, Представление", Результат, ПредставлениеАдреса);
	
КонецФункции

&НаСервереБезКонтекста
Функция СтранаНаименование(Страна)
	
	Возврат Страна.Наименование;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьПредставлениеАдреса(Элемент)
	
	ПредставлениеАдреса =	?(ЗначениеЗаполнено(Страна)									, СтранаНаименование(Страна) + ", ", "") + 
							?(ЗначениеЗаполнено(Индекс)									, Индекс + ", ", "") + 
							?(ЗначениеЗаполнено(НаселенныйПунктДетально.Регион)			, НаселенныйПунктДетально.Регион + ", ", "") + 
							?(ЗначениеЗаполнено(НаселенныйПунктДетально.Город)			, НаселенныйПунктДетально.Город + ", ", "") + 
							?(ЗначениеЗаполнено(Улица)									, Улица + ", ", "");
							
	Для Каждого ДополнительныйАдресныйЭлемент Из ДополнительныеАдресныеЭлементы Цикл
		ПредставлениеАдреса = ПредставлениеАдреса + ДополнительныйАдресныйЭлемент.Тип + " " + ДополнительныйАдресныйЭлемент.Значение + ", ";
	КонецЦикла;
							
	ПредставлениеАдреса = Сред(ПредставлениеАдреса, 1, СтрДлина(ПредставлениеАдреса) - 2);
							
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьНаселенныйПункт(НаселенныйПунктДетально)
	
	НаселенныйПункт =	?(ЗначениеЗаполнено(НаселенныйПунктДетально.НаселенныйПункт), НаселенныйПунктДетально.НаселенныйПункт + ", ", "") + 
						?(ЗначениеЗаполнено(НаселенныйПунктДетально.ВнутригРайон)	, НаселенныйПунктДетально.ВнутригРайон + ", ", "") + 
						?(ЗначениеЗаполнено(НаселенныйПунктДетально.Город)			, НаселенныйПунктДетально.Город + ", ", "") + 
						?(ЗначениеЗаполнено(НаселенныйПунктДетально.Район)			, НаселенныйПунктДетально.Район + ", ", "") + 
						?(ЗначениеЗаполнено(НаселенныйПунктДетально.Округ)			, НаселенныйПунктДетально.Округ + ", ", "") + 
						?(ЗначениеЗаполнено(НаселенныйПунктДетально.Регион)			, НаселенныйПунктДетально.Регион + ", ", "");

	НаселенныйПункт = Сред(НаселенныйПункт, 1, СтрДлина(НаселенныйПункт) - 2); 						
						
	Возврат НаселенныйПункт;
	
КонецФункции

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Для Каждого Реквизит Из СтрРазделить(ОбязательныеРеквизитыАдреса, ",", Ложь) Цикл
		ПроверяемыеРеквизиты.Добавить(Реквизит);
	КонецЦикла;
	
КонецПроцедуры

	
&НаКлиенте
Процедура КомандаОК(Команда)
	
	Если ПроверитьЗаполнение() Тогда
		Закрыть(СформироватьРезультатВводаАдреса());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтмена(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда
		Результат = Вопрос("Данные были изменены. Сохранить изменения?", РежимДиалогаВопрос.ДаНетОтмена);
		Если Результат = КодВозвратаДиалога.Да Тогда
			Закрыть(СформироватьРезультатВводаАдреса());
		ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
			ЭтаФорма.Закрыть(Неопределено);
		КонецЕсли;
	Иначе
		ЭтаФорма.Закрыть(Неопределено);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура НаселенныйПунктНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОткрытияФормы = Новый Структура;	
	ПараметрыОткрытияФормы.Вставить("НаселенныйПунктДетально"	, НаселенныйПунктДетально);
	
	Оповещение = Новый ОписаниеОповещения("НаселенныйПунктНачалоВыбора_Завершение", ЭтаФорма, НаселенныйПунктДетально);
	
	ОткрытьФорму("Обработка.ВводКонтактнойИнформации.Форма.НаселенныйПунктАдреса", ПараметрыОткрытияФормы,,,,, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура НаселенныйПунктНачалоВыбора_Завершение(Знач РезультатЗакрытия, Знач ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(РезультатЗакрытия) <> тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(НаселенныйПунктДетально, РезультатЗакрытия);
	
	НаселенныйПункт =	СформироватьНаселенныйПункт(НаселенныйПунктДетально);
	
	ОбновитьПредставлениеАдреса(Неопределено);
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УлицаПриИзменении(Элемент)
	
	ОбновитьПредставлениеАдреса(Элемент);
	
КонецПроцедуры










