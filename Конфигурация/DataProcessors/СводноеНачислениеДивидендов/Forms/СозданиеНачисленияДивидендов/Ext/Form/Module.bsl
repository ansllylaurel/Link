#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ЭтаФорма.Параметры, "Организация, Дата, ДатаРеестра, ДатаПубликации, ДатаОплатыПлановая, ЦеннаяБумага, ДивидендыНаЦеннуюБумагу, Д1, Д2, ИдСобытия");
	
	ВалютаНоминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЦеннаяБумага, "ВалютаНоминала");
	
	Для каждого СтрокаНачисленияДивидендов Из ЭтаФорма.Параметры.НачисленияДивидендов Цикл
		
		НоваяСтрокаНачисленияДивидендов = НачисленияДивидендов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаНачисленияДивидендов, СтрокаНачисленияДивидендов);
		
		НоваяСтрокаНачисленияДивидендов.ВалютаОплаты = ВалютаНоминала; 
		
	КонецЦикла;
	
	ТаблицаДанных = РегистрыСведений.НастройкиУчетаДоходовПоЦеннымБумагам.ПолучитьЗначенияНастроекУчетаДоходовПоЦеннымБумагам(РеквизитФормыВЗначение("НачисленияДивидендов"), ЭтаФорма.Дата, ЭтаФорма.Организация);
	
	ЗначениеВРеквизитФормы(ТаблицаДанных, "НачисленияДивидендов");
	
	ОбновитьНадписьНачисленияДивидендовИтого(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если НЕ ЗавершениеРаботы И Не ЭтаФорма.ПовторноеЗакрытие Тогда
		
		Отказ = Истина;
		
		ЭтаФорма.ПовторноеЗакрытие = Истина;
		
		ЭтаФорма.Закрыть(
			?(ЭтаФорма.СозданныеДокументы.Количество() = 0, Неопределено, ЭтаФорма.СозданныеДокументы.ВыгрузитьЗначения()));
		
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура НачисленияДивидендовОплатаЧерезБрокераПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.НачисленияДивидендов.ТекущиеДанные;
	
	Если Не ТекущиеДанные.ОплатаЧерезБрокера Тогда
		ТекущиеДанные.Брокер = Неопределено;
	КонецЕсли;
	
	НачисленияДивидендовБрокерПриИзменении(ТекущиеДанные.ОплатаЧерезБрокера);
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияДивидендовБрокерПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.НачисленияДивидендов.ТекущиеДанные;
	
	ТекущиеДанные.ДетализацияПоРасчетномуСчету = РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(
		Новый Структура("Дата, Организация, Брокер", ЭтаФорма.Дата, ЭтаФорма.Организация, ТекущиеДанные.Брокер));
	
	Если Не ТекущиеДанные.ДетализацияПоРасчетномуСчету Тогда
		ТекущиеДанные.РасчетныйСчет = Неопределено;
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияДивидендовРасчетныйСчетПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.НачисленияДивидендов.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.РасчетныйСчет) Тогда
		ТекущиеДанные.ВалютаОплаты = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущиеДанные.РасчетныйСчет, "Валюта");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияДивидендовКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.НачисленияДивидендов.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.СуммаОбъявленная = ТекущиеДанные.Количество * ЭтаФорма.ДивидендыНаЦеннуюБумагу;
	Если ТекущиеДанные.НачислятьОбязательства Тогда 
		ТекущиеДанные.Сумма = ТекущиеДанные.СуммаОбъявленная - РаботаСНалогамиКлиентСервер.РасчетНалогаСДивидендов(ТекущиеДанные.СуммаОбъявленная, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущиеДанные.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления"), ЭтаФорма.Д1, ЭтаФорма.Д2); 
	Иначе
		ТекущиеДанные.Сумма = ТекущиеДанные.СуммаОбъявленная;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияДивидендовСуммаОбъявленнаяПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.НачисленияДивидендов.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.НачислятьОбязательства Тогда 
		ТекущиеДанные.Сумма = ТекущиеДанные.СуммаОбъявленная - РаботаСНалогамиКлиентСервер.РасчетНалогаСДивидендов(ТекущиеДанные.СуммаОбъявленная, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущиеДанные.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления"), ЭтаФорма.Д1, ЭтаФорма.Д2); 
	Иначе
		ТекущиеДанные.Сумма = ТекущиеДанные.СуммаОбъявленная;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияДивидендовПриИзменении(Элемент)
	
	ОбновитьНадписьНачисленияДивидендовИтого(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаСоздатьДокументы(Команда)
	
	Если СоздатьНачисленияДивидендовНаСервере() Тогда
		ВсеДокументыСозданы = ЭтаФорма.СозданныеДокументы.Количество() = ЭтаФорма.НачисленияДивидендов.Количество();
		Элементы.ФормаКомандаСоздатьДокументы.Доступность = НЕ ВсеДокументыСозданы;
		ЭтаФорма.ПовторноеЗакрытие = ВсеДокументыСозданы;
		ЭтаФорма.Закрыть(Истина);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьНадписьНачисленияДивидендовИтого(Форма)
	
	ТекстНадписи = "";
	
	Если Форма.НачисленияДивидендов.Количество() > 0 Тогда
		
		ИтогоКоличество       = 0;
		ИтогоСуммаОбъявленная = 0;
		ИтогоСумма            = 0;
		
		Для каждого СтрокаНачисленияДивидендов Из Форма.НачисленияДивидендов Цикл
			ИтогоКоличество       = ИтогоКоличество       + СтрокаНачисленияДивидендов.Количество;
			ИтогоСуммаОбъявленная = ИтогоСуммаОбъявленная + СтрокаНачисленияДивидендов.СуммаОбъявленная;
			ИтогоСумма            = ИтогоСумма            + СтрокаНачисленияДивидендов.Сумма;
		КонецЦикла;
		
		ТекстНадписи = "Итого " + ИтогоКоличество + " " + РаботаСКорзинойЦенныхБумагКлиентСервер.ФормаМножественногоЧислаЦеннойБумаги(ИтогоКоличество, РаботаСЦеннымиБумагамиКлиентСервер.РынокПоЦеннойБумаге(Форма.ЦеннаяБумага))
			+ " на сумму " + ИтогоСумма + ", сумма объявленная " + ИтогоСуммаОбъявленная;
		
	КонецЕсли;
	
	Форма.Элементы.НадписьНачисленияДивидендовИтого.Заголовок = ТекстНадписи;
	
КонецПроцедуры // ОбновитьНадписьНачисленияДивидендовИтого

&НаСервере
Функция СоздатьНачисленияДивидендовНаСервере()
	
	ЕстьОшибки = Ложь;
	
	// проверим заполнение на основе имеющихся данных
	Для НомСтр = 0 По ЭтаФорма.НачисленияДивидендов.Количество() - 1 Цикл
		
		СтрокаНачисленияДивидендов = ЭтаФорма.НачисленияДивидендов[НомСтр];
		
		Если СтрокаНачисленияДивидендов.Количество = 0 Тогда
			Сообщить("Не заполнено поле ""Количество"" в строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если СтрокаНачисленияДивидендов.СуммаОбъявленная = 0 Тогда
			Сообщить("Не заполнено поле ""Сумма объявленная"" в строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если СтрокаНачисленияДивидендов.Сумма = 0 Тогда
			Сообщить("Не заполнено поле ""Сумма"" в строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если СтрокаНачисленияДивидендов.ОплатаЧерезБрокера И Не ЗначениеЗаполнено(СтрокаНачисленияДивидендов.Брокер) Тогда
			Сообщить("Не заполнено поле ""Брокер"" в строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если СтрокаНачисленияДивидендов.ДетализацияПоРасчетномуСчету И Не ЗначениеЗаполнено(СтрокаНачисленияДивидендов.РасчетныйСчет) Тогда
			Сообщить("Не заполнено поле ""Расчетный счет"" в строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьОшибки Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// создадим документ
	Для НомСтр = 0 По ЭтаФорма.НачисленияДивидендов.Количество() - 1 Цикл
		
		СтрокаНачисленияДивидендов = ЭтаФорма.НачисленияДивидендов[НомСтр];
		
		Если СтрокаНачисленияДивидендов.ДокументСоздан Тогда
		
			Продолжить;
		
		КонецЕсли;
		
		НачислениеДивидендов = Документы.НачислениеДивидендов.СоздатьДокумент();
		
		ЗаполнитьЗначенияСвойств(НачислениеДивидендов, ЭтаФорма);
		ЗаполнитьЗначенияСвойств(НачислениеДивидендов, СтрокаНачисленияДивидендов);
		
		НачислениеДивидендов.Рынок		   = РаботаСЦеннымиБумагамиКлиентСервер.РынокПоЦеннойБумаге(ЭтаФорма.ЦеннаяБумага);	
		НачислениеДивидендов.Ответственный = РаботаСПользователями.ТекущийПользователь();
	
		Если Не НачислениеДивидендов.ПроверитьЗаполнение() Тогда
			Сообщить("Не удалось создать начисление дивидендов по строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецЕсли;
	
		Попытка
			НачислениеДивидендов.Дата = НачалоДня(ДатаРеестра) + 20*60*60;
			НачислениеДивидендов.Записать(РежимЗаписиДокумента.Проведение);
			Сообщить("Создан документ " + НачислениеДивидендов);
			ЭтаФорма.СозданныеДокументы.Добавить(НачислениеДивидендов.Ссылка);
			СтрокаНачисленияДивидендов.ДокументСоздан = Истина;
			
			//Запишем ИдСобытия в регистр
			Если НачислениеДивидендов.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда 
				ЗаписьРегистр = РегистрыСведений.КодыВоВнешнихСистемах.СоздатьМенеджерЗаписи();
				ЗаписьРегистр.Период = НачислениеДивидендов.Дата;
				ЗаписьРегистр.ВнешняяСистема = Справочники.ВнешниеСистемы.НРД;
				ЗаписьРегистр.ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.КорпоративноеСобытиеПоВыплатеДивидендов;
				ЗаписьРегистр.Объект = НачислениеДивидендов.Ссылка; 
				ЗаписьРегистр.Код = ЭтаФорма.ИдСобытия; 
				ЗаписьРегистр.Записать();
			КонецЕсли;	
			
		Исключение
			Сообщить("Не удалось создать начисление дивидендов по строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецПопытки;
	
	КонецЦикла;
	
	Возврат Не ЕстьОшибки;
	
КонецФункции // СоздатьНачисленияДивидендовНаСервере

#КонецОбласти
