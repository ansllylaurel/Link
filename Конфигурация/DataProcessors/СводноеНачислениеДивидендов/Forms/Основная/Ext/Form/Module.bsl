		СтрокаНачисленияДивидендов = НачисленияДивидендов.Найти(ВыборкаНачисленияДивидендов.НачислениеДивидендов, "Документ");
		
		Если СтрокаНачисленияДивидендов = Неопределено Тогда // такого быть не должно, но на всякий случай отработаем
			Сообщить("Ошибка заполнения фактических погашений. Не удалось получить реквизиты документа " + ВыборкаНачисленияДивидендов.НачислениеДивидендов + ". Обратитесь к разработчикам.");
			Продолжить;
		КонецЕсли;	
			
		НачисленияСозданныеНаСервереСтрока1 = НачисленияСозданныеНаСервере.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НачисленияСозданныеНаСервереСтрока1, СтрокаНачисленияДивидендов);
		
		НачисленияСозданныеНаСервереСтрока1.ПлатежныеРеквизиты = ""
			+ ?(ЗначениеЗаполнено(НачисленияСозданныеНаСервереСтрока1.Брокер), "брокер " + НачисленияСозданныеНаСервереСтрока1.Брокер, "")
			+ ?(ЗначениеЗаполнено(НачисленияСозданныеНаСервереСтрока1.РасчетныйСчет), ?(ПустаяСтрока(НачисленияСозданныеНаСервереСтрока1.ПлатежныеРеквизиты), "", ", ") + "р/счет " + НачисленияСозданныеНаСервереСтрока1.РасчетныйСчет, "");
		
		ВыборкаОплаты = ВыборкаНачисленияДивидендов.Выбрать();
		
		Пока ВыборкаОплаты.Следующий() Цикл
			
			НачисленияСозданныеНаСервереСтрока2 = НачисленияСозданныеНаСервереСтрока1.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НачисленияСозданныеНаСервереСтрока2, ВыборкаОплаты);
			
			НачисленияСозданныеНаСервереСтрока2.ПлатежныеРеквизиты = ""
				+ ?(ЗначениеЗаполнено(НачисленияСозданныеНаСервереСтрока2.Брокер), "брокер " + НачисленияСозданныеНаСервереСтрока2.Брокер, "")
				+ ?(ЗначениеЗаполнено(НачисленияСозданныеНаСервереСтрока2.РасчетныйСчет), ?(ПустаяСтрока(НачисленияСозданныеНаСервереСтрока2.ПлатежныеРеквизиты), "", ", ") + "р/счет " + НачисленияСозданныеНаСервереСтрока2.РасчетныйСчет, "");
			
		КонецЦикла;
			
		ОбработанныеНачисления.Добавить(ВыборкаНачисленияДивидендов.НачислениеДивидендов);
		
	КонецЦикла;
	
	// перенесем на форму начисления дивидендов без оплат
	ОбновленыДивидендыНаЦеннуюБумагу = Ложь;
	
	Для каждого СтрокаНачисленияДивидендов Из НачисленияДивидендов Цикл
		
		Если ОбработанныеНачисления.Найти(СтрокаНачисленияДивидендов.Документ) = Неопределено Тогда
			
			НачисленияСозданныеНаСервереСтрока1 = НачисленияСозданныеНаСервере.Строки.Добавить();
			
			ЗаполнитьЗначенияСвойств(НачисленияСозданныеНаСервереСтрока1, СтрокаНачисленияДивидендов);
			
			НачисленияСозданныеНаСервереСтрока1.ПлатежныеРеквизиты = ""
				+ ?(ЗначениеЗаполнено(НачисленияСозданныеНаСервереСтрока1.Брокер), "брокер " + НачисленияСозданныеНаСервереСтрока1.Брокер, "")
				+ ?(ЗначениеЗаполнено(НачисленияСозданныеНаСервереСтрока1.РасчетныйСчет), ?(ПустаяСтрока(НачисленияСозданныеНаСервереСтрока1.ПлатежныеРеквизиты), "", ", ") + "р/счет " + НачисленияСозданныеНаСервереСтрока1.РасчетныйСчет, "");
			
		КонецЕсли;
		
		Если Не ОбновленыДивидендыНаЦеннуюБумагу И Не СтрокаНачисленияДивидендов.ИсключатьИзРасчетов Тогда
						
			Элементы.ДивидендыНаЦеннуюБумагу.ТолькоПросмотр	= Истина;
			Элементы.ДатаПубликации.ТолькоПросмотр   		= Истина;
			Элементы.ДатаОплатыПлановая.ТолькоПросмотр		= Истина;
			
			ОбновленыДивидендыНаЦеннуюБумагу = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// финальный аккорд
	Если Не ОбновленыДивидендыНаЦеннуюБумагу Тогда
		Элементы.ДивидендыНаЦеннуюБумагу.ТолькоПросмотр	= Ложь;
		Элементы.ДатаПубликации.ТолькоПросмотр   		= Ложь;
		Элементы.ДатаОплатыПлановая.ТолькоПросмотр		= Ложь;
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(НачисленияСозданныеНаСервере, "НачисленияСозданные");
	
КонецФункции // ЗаполнитьСозданныеНачисленияДивидендовНаСервере

&НаСервере
Функция ЗаполнитьПлановыеНачисленияНаСервере()
	
	НачисленияПлановые.Очистить();
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.ЦеннаяБумага) Тогда
		Возврат Ложь;
	КонецЕсли;	

	// плановые данные
	Запрос = Новый Запрос;
	Запрос.Текст = 	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИСТИНА КАК Флажок,
		|	ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СУММА(ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.КоличествоОстаток, 0)) КАК Количество,
		|	СУММА(ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.КоличествоОстаток, 0)) * &ДивидендыНаЦеннуюБумагу КАК СуммаОбъявленная,
		|	СУММА(ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.КоличествоОстаток, 0)) * &ДивидендыНаЦеннуюБумагу КАК Сумма,
		|	НастройкиУчетаОбщиеСрезПоследних.НачислятьОбязательстваПоОплатеНалогаСДивидендов КАК НачислятьОбязательства,
		|	&ДивидендыНаЦеннуюБумагу КАК ДивидендыНаЦеннуюБумагу,
		|	&ИдСобытия КАК ИдСобытия
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК ОстаткиЦенныхБумагОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&Период, Организация = &Организация) КАК НастройкиУчетаОбщиеСрезПоследних
		|		ПО ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления = НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления,
		|	НастройкиУчетаОбщиеСрезПоследних.НачислятьОбязательстваПоОплатеНалогаСДивидендов";
		
	Запрос.УстановитьПараметр("Период",           		КонецДня(ЭтаФорма.ДатаРеестра));
	Запрос.УстановитьПараметр("Организация",      		ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("Организация",      		ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("ЦеннаяБумага",     		ЭтаФорма.ЦеннаяБумага);
	Запрос.УстановитьПараметр("ДивидендыНаЦеннуюБумагу",ЭтаФорма.ДивидендыНаЦеннуюБумагу);
	Запрос.УстановитьПараметр("ИдСобытия",				ЭтаФорма.ИдСобытия);
	
	ПлановыеНачисления = Запрос.Выполнить().Выгрузить();
	ПлановыеНачисления.Индексы.Добавить("СчетДоверительногоУправления");
	
	//Расчитаем суммы оплаты
	Для Каждого СтрокаПлановыеНачисления из ПлановыеНачисления Цикл 
	
		Налог = РаботаСНалогамиКлиентСервер.РассчитатьНалогСДивидендов(СтрокаПлановыеНачисления.СуммаОбъявленная, СтрокаПлановыеНачисления.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления, ЭтаФорма.Д1, ЭтаФорма.Д2, Ложь);
		СтрокаПлановыеНачисления.Сумма = СтрокаПлановыеНачисления.СуммаОбъявленная - Налог;
		
	КонецЦикла;	
	
	
	// в плановые погашения запись попадает только тогда, когда нет созданного (проведенного или записанного)
	// соответствующего погашения; остальные распределяются по созданным погашениям
	Для каждого СтрокаНачисленияСозданные Из ЭтаФорма.НачисленияСозданные.ПолучитьЭлементы() Цикл
		
		// пропускаем погашения, помеченние на удаление
		Если СтрокаНачисленияСозданные.ИсключатьИзРасчетов Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиПлановыеНачисления = ПлановыеНачисления.НайтиСтроки(
			Новый Структура("СчетДоверительногоУправления, ИдСобытия",
				СтрокаНачисленияСозданные.СчетДоверительногоУправления, СтрокаНачисленияСозданные.ИдСобытия));
				
		Если СтрокиПлановыеНачисления.Количество() = 1 Тогда
			
			СтрокаПлановыеНачисления = СтрокиПлановыеНачисления[0];
			
			Если СтрокаНачисленияСозданные.Количество >= СтрокаПлановыеНачисления.Количество Тогда
				
				СтрокаНачисленияСозданные.ПлановоеКоличество       = СтрокаПлановыеНачисления.Количество;
				СтрокаНачисленияСозданные.ПлановаяСуммаОбъявленная = СтрокаПлановыеНачисления.СуммаОбъявленная;
				
				Налог = РаботаСНалогамиКлиентСервер.РассчитатьНалогСДивидендов(СтрокаНачисленияСозданные.ПлановаяСуммаОбъявленная, СтрокаНачисленияСозданные.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления, ЭтаФорма.Д1, ЭтаФорма.Д2, Ложь);
				СтрокаНачисленияСозданные.ПлановаяСумма            = СтрокаНачисленияСозданные.ПлановаяСуммаОбъявленная - Налог; 
				
				ПлановыеНачисления.Удалить(СтрокаПлановыеНачисления);
				
			Иначе
				
				СтрокаНачисленияСозданные.ПлановоеКоличество       = СтрокаНачисленияСозданные.Количество;
				СтрокаНачисленияСозданные.ПлановаяСуммаОбъявленная = СтрокаПлановыеНачисления.СуммаОбъявленная * СтрокаНачисленияСозданные.Количество / СтрокаПлановыеНачисления.Количество;
				
				Налог = РаботаСНалогамиКлиентСервер.РассчитатьНалогСДивидендов(СтрокаНачисленияСозданные.ПлановаяСуммаОбъявленная, СтрокаНачисленияСозданные.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления, ЭтаФорма.Д1, ЭтаФорма.Д2, Ложь);
				СтрокаНачисленияСозданные.ПлановаяСумма = СтрокаНачисленияСозданные.ПлановаяСуммаОбъявленная - Налог;
				
				СтрокаПлановыеНачисления.Количество       = СтрокаПлановыеНачисления.Количество       - СтрокаНачисленияСозданные.ПлановоеКоличество;
				СтрокаПлановыеНачисления.СуммаОбъявленная = СтрокаПлановыеНачисления.СуммаОбъявленная - СтрокаНачисленияСозданные.ПлановаяСуммаОбъявленная;
				
			КонецЕсли;
				
		ИначеЕсли СтрокиПлановыеНачисления.Количество() > 1 Тогда // такого быть не должно, но на всякий случай, перестрахуемся
			
			Сообщить("Ошибка распределения плановых показателей по фактическим операциям. Найдено более одной подходящей строки. Обратитесь к разработчикам.");
			Возврат Неопределено;
			
		КонецЕсли;
		
	КонецЦикла;	
	
	// распределим оставшиеся плановые значения
	НачисленияСозданныеНаСервере = РеквизитФормыВЗначение("НачисленияСозданные");
	
	Если ПлановыеНачисления.Количество() > 0 Тогда
		
		// сложность распределения в том, что плановые суммы могут закрываться разными документами
		// поэтому оставшуюся разницу закинем на первую попашуюся подходящую строку
		
		НачисленияПлановыеНаСервере = РеквизитФормыВЗначение("НачисленияПлановые");
				
		Для каждого СтрокаПлановыеНачисления Из ПлановыеНачисления Цикл
			
			СтрокиНачисленияСозданныеНаСервере = НачисленияСозданныеНаСервере.Строки.НайтиСтроки(
				Новый Структура("СчетДоверительногоУправления, ДивидендыНаЦеннуюБумагу",
					СтрокаПлановыеНачисления.СчетДоверительногоУправления, СтрокаПлановыеНачисления.ДивидендыНаЦеннуюБумагу));

			// исключим помеченные на удаление документы		
			Для Инд = 1 - СтрокиНачисленияСозданныеНаСервере.Количество() По 0 Цикл
				Если СтрокиНачисленияСозданныеНаСервере[-Инд].ИсключатьИзРасчетов Тогда
					СтрокиНачисленияСозданныеНаСервере.Удалить(-Инд);
				КонецЕсли;
			КонецЦикла;		
					
			Если СтрокиНачисленияСозданныеНаСервере.Количество() = 0 Тогда
			
				НоваяСтрокаНачисленияПлановыеНаСервере = НачисленияПлановыеНаСервере.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаНачисленияПлановыеНаСервере, СтрокаПлановыеНачисления);
				
			Иначе
				
				СтрокаНачисленияСозданныеНаСервере = СтрокиНачисленияСозданныеНаСервере[СтрокиНачисленияСозданныеНаСервере.Количество() - 1];
				СтрокаНачисленияСозданныеНаСервере.ПлановоеКоличество       = СтрокаНачисленияСозданныеНаСервере.ПлановоеКоличество       + СтрокаПлановыеНачисления.Количество;
				СтрокаНачисленияСозданныеНаСервере.ПлановаяСуммаОбъявленная = СтрокаНачисленияСозданныеНаСервере.ПлановаяСуммаОбъявленная + СтрокаПлановыеНачисления.СуммаОбъявленная;
				СтрокаНачисленияСозданныеНаСервере.ПлановаяСумма            = СтрокаНачисленияСозданныеНаСервере.ПлановаяСуммаОбъявленная;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ЗначениеВРеквизитФормы(НачисленияПлановыеНаСервере, "НачисленияПлановые");
						
	КонецЕсли;
	
	НачисленияСозданныеНаСервере.Строки.Сортировать("ИсключатьИзРасчетов, Объект");
	
	ЗначениеВРеквизитФормы(НачисленияСозданныеНаСервере, "НачисленияСозданные");
	
КонецФункции // ЗаполнитьПлановыеНачисленияНаСервере

&НаСервере
Функция НастроитьВидимостьДоступностьНаСервере()
	
	ЕстьРасхожденияПоДивидендыНаЦеннуюБумагу 	= Ложь;
	ЕстьРасхожденияПоДатаПубликации   	= Ложь;
	ЕстьРасхожденияПоДатаОплатыПлановая	= Ложь;
	ЕстьРасхожденияПоКоличество       	= Ложь;
	ЕстьРасхожденияПоСуммаОбъявленная 	= Ложь;
	ЕстьРасхожденияПоСумма            	= Ложь;  
	
	ОплатыДивидендовСозданы 			= Ложь;
	РасчетыНДФЛСозданы 					= Ложь;
	ЗадолженностиПоНДФЛСозданы 			= Ложь;
	
	Для каждого Строка1НачисленияСозданные Из ЭтаФорма.НачисленияСозданные.ПолучитьЭлементы() Цикл
		
		Если Строка1НачисленияСозданные.ИсключатьИзРасчетов Тогда
			Продолжить;
		КонецЕсли;
		
		Строка1НачисленияСозданные._ПлановоеКоличество       = " (" + Строка1НачисленияСозданные.ПлановоеКоличество + ")";
		Строка1НачисленияСозданные._ПлановаяСуммаОбъявленная = " (" + Строка1НачисленияСозданные.ПлановаяСуммаОбъявленная + ")";
		Строка1НачисленияСозданные._ПлановаяСумма            = " (" + Строка1НачисленияСозданные.ПлановаяСумма + ")";
		
		Строка1НачисленияСозданные.РасхождениеПоДивидендыНаЦеннуюБумагу = (Строка1НачисленияСозданные.ДивидендыНаЦеннуюБумагу <> ЭтаФорма.ДивидендыНаЦеннуюБумагу);
		Строка1НачисленияСозданные.РасхожденияПоДатаПубликации   		= (Строка1НачисленияСозданные.ДатаПубликации <> ЭтаФорма.ДатаПубликации);
		Строка1НачисленияСозданные.РасхожденияПоДатаОплатыПлановая		= (Строка1НачисленияСозданные.ДатаОплатыПлановая <> ЭтаФорма.ДатаОплатыПлановая);
		Строка1НачисленияСозданные.РасхождениеПоКоличество       		= (Строка1НачисленияСозданные.Количество <> Строка1НачисленияСозданные.ПлановоеКоличество);
		Строка1НачисленияСозданные.РасхождениеПоСуммаОбъявленная 		= (Строка1НачисленияСозданные.СуммаОбъявленная <> Строка1НачисленияСозданные.ПлановаяСуммаОбъявленная);
		Строка1НачисленияСозданные.РасхождениеПоСумма            		= (Строка1НачисленияСозданные.Сумма <> Строка1НачисленияСозданные.ПлановаяСумма);
				
		Если Не ЕстьРасхожденияПоДивидендыНаЦеннуюБумагу И Строка1НачисленияСозданные.РасхождениеПоДивидендыНаЦеннуюБумагу Тогда
			ЕстьРасхожденияПоДивидендыНаЦеннуюБумагу = Истина;
		КонецЕсли;
		
		Если Не ЕстьРасхожденияПоДатаПубликации И Строка1НачисленияСозданные.РасхожденияПоДатаПубликации Тогда
			ЕстьРасхожденияПоДатаПубликации = Истина;
		КонецЕсли;
		
		Если Не ЕстьРасхожденияПоДатаОплатыПлановая И Строка1НачисленияСозданные.РасхожденияПоДатаОплатыПлановая Тогда
			ЕстьРасхожденияПоДатаОплатыПлановая = Истина;
		КонецЕсли;
		
		Если Не ЕстьРасхожденияПоКоличество И Строка1НачисленияСозданные.РасхождениеПоКоличество Тогда
			ЕстьРасхожденияПоКоличество = Истина;
		КонецЕсли;

		Если Не ЕстьРасхожденияПоСуммаОбъявленная И Строка1НачисленияСозданные.РасхождениеПоСуммаОбъявленная Тогда
			ЕстьРасхожденияПоСуммаОбъявленная = Истина;
		КонецЕсли;
		
		Если Не ЕстьРасхожденияПоСумма И Строка1НачисленияСозданные.РасхождениеПоСумма Тогда
			ЕстьРасхожденияПоСумма = Истина;
		КонецЕсли;
		
		Для Каждого СтрокаУровень2 из Строка1НачисленияСозданные.ПолучитьЭлементы() Цикл
			Если ТипЗнч(СтрокаУровень2.Документ) = Тип("ДокументСсылка.Оплата")
				И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаУровень2.Документ, "ВидЗадолженности") = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоНачислениюДивидендовАкции") Тогда
				ОплатыДивидендовСозданы = Истина;
			КонецЕсли; 
			Если ТипЗнч(СтрокаУровень2.Документ) = Тип("ДокументСсылка.РасчетНДФЛ") Тогда 
				РасчетыНДФЛСозданы = Истина;
			КонецЕсли;
			Если ТипЗнч(СтрокаУровень2.Документ) = Тип("ДокументСсылка.НачислениеЗадолженности")
				И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаУровень2.Документ, "ВидЗадолженности") = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоНДФЛ13") Тогда
				ЗадолженностиПоНДФЛСозданы = Истина;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Элементы.НачисленияСозданныеДивидендыНаЦеннуюБумагу.Видимость 	= ЕстьРасхожденияПоДивидендыНаЦеннуюБумагу;
	Элементы.НачисленияСозданныеДатаПубликации.Видимость   			= ЕстьРасхожденияПоДатаПубликации;
	Элементы.НачисленияСозданныеДатаОплатыПлановая.Видимость		= ЕстьРасхожденияПоДатаОплатыПлановая;
	
	Элементы.НачисленияСозданные_ПлановоеКоличество.Видимость       = ЕстьРасхожденияПоКоличество;
	Элементы.НачисленияСозданные_ПлановаяСуммаОбъявленная.Видимость = ЕстьРасхожденияПоСуммаОбъявленная;
	Элементы.НачисленияСозданные_ПлановаяСумма.Видимость            = ЕстьРасхожденияПоСумма;
	
	Элементы.НачисленияСозданныеКомандаСоздатьРасчетыНДФЛ.Доступность = Ложь;
	Элементы.НачисленияСозданныеКомандаСоздатьНачислениеЗадолженностиПоНалогу.Доступность = Ложь;
	Элементы.НачисленияСозданныеКомандаСоздатьОплатыНалога.Доступность = Ложь;
	
	Если ЭтаФорма.Дата >= Дата(2025, 1, 1) Тогда             
		Элементы.НачисленияСозданныеКомандаСоздатьРасчетыНДФЛ.Видимость = Истина;  
	КонецЕсли;
	
	Если ОплатыДивидендовСозданы Тогда 
		Элементы.НачисленияСозданныеКомандаСоздатьРасчетыНДФЛ.Доступность = Истина;
	КонецЕсли;
	
	Если ЭтаФорма.Дата < Дата(2025, 1, 1) Тогда 
		Если ОплатыДивидендовСозданы Тогда 
			Элементы.НачисленияСозданныеКомандаСоздатьНачислениеЗадолженностиПоНалогу.Доступность = Истина;
		КонецЕсли;
	Иначе
		Если РасчетыНДФЛСозданы Тогда 
			Элементы.НачисленияСозданныеКомандаСоздатьНачислениеЗадолженностиПоНалогу.Доступность = Истина;
		КонецЕсли; 
	КонецЕсли;
	
	Если ЗадолженностиПоНДФЛСозданы Тогда 
		Элементы.НачисленияСозданныеКомандаСоздатьОплатыНалога.Доступность = Истина;
	КонецЕсли;
	
КонецФункции // НастроитьВидимостьДоступностьНаСервере

&НаСервере
Функция ЗаполнитьПлановыеИСозданныеНачисленияНаСервере()
	
	ЗаполнитьСозданныеНачисленияДивидендовНаСервере();
	
	ЗаполнитьПлановыеНачисленияНаСервере();		
	
	НастроитьВидимостьДоступностьНаСервере();
	
	ОбновитьНадписьНачисленияПлановыеИтого(ЭтаФорма);
	
КонецФункции // ЗаполнитьПлановыеИСозданныеНачисленияНаСервере

&НаКлиенте
Функция ПолучитьДанныеВыбранныхДокументов()
	
	ДанныеВыбранныхДокументов = Новый Массив;
	
	ВыделенныеСтрокиСписка = Элементы.НачисленияСозданные.ВыделенныеСтроки;
	
	Если ВыделенныеСтрокиСписка = Неопределено Тогда
		Возврат ДанныеВыбранныхДокументов;
	КонецЕсли;
	
	Если ВыделенныеСтрокиСписка.Количество() = 0 Тогда
		Возврат ДанныеВыбранныхДокументов;
	КонецЕсли;	
	
	Для каждого ВыделеннаяСтрокаСписка Из ВыделенныеСтрокиСписка Цикл
		
		ДанныеВыделеннойСтрокиСписка = Элементы.НачисленияСозданные.ДанныеСтроки(ВыделеннаяСтрокаСписка);
		
		Состояние = Неопределено;
		
		Если      ДанныеВыделеннойСтрокиСписка.СостояниеДокумента = 0 Тогда
			Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументов.ПомеченНаУдаление");
		ИначеЕсли ДанныеВыделеннойСтрокиСписка.СостояниеДокумента = 1 Тогда
			Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументов.Проведен");
		ИначеЕсли ДанныеВыделеннойСтрокиСписка.СостояниеДокумента = 2 Тогда
			Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументов.Записан");
		КонецЕсли;
		
		ДанныеВыбранныхДокументов.Добавить(
			Новый Структура("Документ, Состояние", ДанныеВыделеннойСтрокиСписка.Документ, Состояние));
		
	КонецЦикла;

	Возврат ДанныеВыбранныхДокументов;
	
КонецФункции // ПолучитьДанныеВыбранныхДокументов

&НаСервере
Процедура СписокДатДивидендов()
	
	Список = Элементы.Дата.СписокВыбора;
	Список.Очистить();
	
	Если ТипЗнч(ЭтаФорма.ЦеннаяБумага) <> Тип("СправочникСсылка.Акции") Тогда
		Возврат;
	КонецЕсли;	
		
	Если ЗначениеЗаполнено(ЭтаФорма.ЦеннаяБумага) Тогда 
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДивидендыПоАкциямСрезПоследних.ДатаФиксации КАК ДатаФиксации,
		|	ДивидендыПоАкциямСрезПоследних.СтатусСобытия КАК СтатусСобытия
		|ИЗ
		|	РегистрСведений.ДивидендыПоАкциям.СрезПоследних(, Акция = &Акция) КАК ДивидендыПоАкциямСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаФиксации УБЫВ";
		
		Запрос.УстановитьПараметр("Акция", ЭтаФорма.ЦеннаяБумага);
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить(); 
		Если РезультатЗапроса.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для акции " + ЭтаФорма.ЦеннаяБумага + " нет сведений о выплате дивидендов. Параметры начислений необходимо заполнить вручную");
		Иначе 
			Для Каждого СтрокаРезультата из РезультатЗапроса Цикл
				Список.Добавить(СтрокаРезультата.ДатаФиксации, Формат(СтрокаРезультата.ДатаФиксации, "ДФ=dd.MM.yyyy") + ?(СтрокаРезультата.СтатусСобытия = Перечисления.СтатусыСобытийПоВыплатеДивидендов.Отменено, " (отменено)", ""));
			КонецЦикла;
		КонецЕсли;
		
		Если Список.Количество() > 0 Тогда
			ЭтаФорма.Дата = Список[0].Значение;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоздатьНедостающиеОплатыНалога(ДатаНачисления, Организация, НачисленияДивидендов, НачисленияЗадолженности)
	
	//Запрос. Ранее сделанные документы
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОплатаОснования.Основание КАК НачислениеДивидендов,
	|	ОплатаОснования.Ссылка КАК Документ,
	|	ОплатаОснования.Ссылка КАК Объект,
	|	ВЫБОР
	|		КОГДА ОплатаОснования.Ссылка.Проведен
	|			ТОГДА 1
	|		КОГДА ОплатаОснования.Ссылка.ПометкаУдаления
	|			ТОГДА 0
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК СостояниеДокумента,
	|	ОплатаОснования.Ссылка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	ОплатаОснования.Ссылка.ВалютаОплаты КАК ВалютаОплаты,
	|	ОплатаОснования.Ссылка.Брокер КАК Брокер,
	|	ОплатаОснования.Ссылка.РасчетныйСчет КАК РасчетныйСчет,
	|	ОплатаОснования.Сумма КАК Сумма
	|ИЗ
	|	Документ.Оплата.Основания КАК ОплатаОснования
	|ГДЕ
	|	ОплатаОснования.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНДФЛ13)
	|	И ОплатаОснования.Основание В(&НачисленияДивидендов)";
		
	Запрос.УстановитьПараметр("НачисленияДивидендов", НачисленияДивидендов);
		
	ОплатыЗадолженности = Запрос.Выполнить().Выгрузить();
		
	Для Каждого Начисление из НачисленияДивидендов Цикл 
		
		НачислениеНалога = НачисленияЗадолженности.Получить(Начисление);
		
		Если НачислениеНалога = Неопределено Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствует документ начисления задолженности по налогу на прибыль по " + Начисление);
			Продолжить;
		КонецЕсли;	
		
		Если ОплатыЗадолженности.Найти(Начисление, "НачислениеДивидендов") = Неопределено Тогда 
							
			Документ = Документы.Оплата.СоздатьДокумент();
			
			Документ.Ответственный = РаботаСПользователями.ТекущийПользователь();
			
			ЗаполнитьЗначенияСвойств(Документ, НачислениеНалога,,"Номер, Дата, Проведен");
			Документ.ВалютаОплаты = Начисление.ВалютаОплаты;
			Документ.ВидДвижения = Перечисления.ВидыДвижений.Расход;
			Документ.Дата = ДатаНачисления;
			
			Для Каждого СтрокаОснование из НачислениеНалога.Основания Цикл 
				НоваяСтрока = Документ.Основания.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОснование);
				НоваяСтрока.Валюта = Начисление.ВалютаОплаты;
			КонецЦикла;	
		
			Если Не Документ.ПроверитьЗаполнение() Тогда
				Продолжить;
			КонецЕсли;
			
			Попытка
				Документ.Записать(РежимЗаписиДокумента.Проведение);
			Исключение	
				Документ.Записать(РежимЗаписиДокумента.Запись);
			КонецПопытки;	
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + Документ.Ссылка, Документ.Ссылка);
		КонецЕсли;
		
	КонецЦикла;		
				
	
КонецПроцедуры // СоздатьНедостающиеОплатыПоНачислениямДивидендов

&НаСервереБезКонтекста
Процедура СоздатьНедостающиеОплатыНалога2025(ДатаНачисления, Организация, НачисленияЗадолженностиНДФЛ)
	
	//Запрос. Ранее сделанные документы
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НачислениеЗадолженностиОснования.Ссылка КАК Основание,
	|	НачислениеЗадолженностиОснования.Ссылка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	НачислениеЗадолженностиОснования.Ссылка.Организация КАК Организация,
	|	НачислениеЗадолженностиОснования.Ссылка.Валюта КАК ВалютаОплаты,
	|	НачислениеЗадолженностиОснования.Ссылка.Брокер КАК Брокер,
	|	НачислениеЗадолженностиОснования.Ссылка.РасчетныйСчет КАК РасчетныйСчет,
	|	НачислениеЗадолженностиОснования.Сумма КАК Сумма,
	|	ОплатаОснования.Ссылка КАК ДокументОплатаНДФЛ,
	|	ВЫБОР
	|		КОГДА ОплатаОснования.Ссылка.Проведен
	|			ТОГДА 1
	|		КОГДА ОплатаОснования.Ссылка.ПометкаУдаления
	|			ТОГДА 0
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК СостояниеДокумента
	|ИЗ
	|	Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Оплата.Основания КАК ОплатаОснования
	|		ПО (ОплатаОснования.Основание = НачислениеЗадолженностиОснования.Ссылка)
	|ГДЕ
	|	НачислениеЗадолженностиОснования.Ссылка В(&НачисленияЗадолженностиНДФЛ)";
		
	Запрос.УстановитьПараметр("НачисленияЗадолженностиНДФЛ", НачисленияЗадолженностиНДФЛ);
		
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.Прямой);
	Пока Выборка.Следующий() Цикл 
		
		
		Если ЗначениеЗаполнено(Выборка.ДокументОплатаНДФЛ)  Тогда 
			Если Выборка.СостояниеДокумента = 1 Тогда 
				Продолжить; 
			ИначеЕсли Выборка.СостояниеДокумента = 0 Тогда
				Документ = Документы.Оплата.СоздатьДокумент();
			Иначе
				Документ = Выборка.ДокументОплатаНДФЛ.ПолучитьОбъект();
			КонецЕсли;	
		Иначе	
			//	Создаем документ	
			Документ = Документы.Оплата.СоздатьДокумент();
		КонецЕсли;	
		
		Начисление = Выборка.Основание;
		
		Документ.Ответственный = РаботаСПользователями.ТекущийПользователь();
		
		ЗаполнитьЗначенияСвойств(Документ, Начисление,,"Номер, Дата, Проведен");
		Документ.ВалютаОплаты = Выборка.ВалютаОплаты;
		Документ.ВидДвижения = Перечисления.ВидыДвижений.Расход;
		Документ.Дата = ДатаНачисления;
		
		Документ.Основания.Очистить();
		Для Каждого СтрокаОснование из Начисление.Основания Цикл 
			НоваяСтрока = Документ.Основания.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОснование); 
			НоваяСтрока.Основание = Начисление;
			НоваяСтрока.Валюта = Выборка.ВалютаОплаты;
		КонецЦикла;	
		
		Если Не Документ.ПроверитьЗаполнение() Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			Документ.Записать(РежимЗаписиДокумента.Проведение);
		Исключение	
			Документ.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;	
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + Документ.Ссылка, Документ.Ссылка);
		
	КонецЦикла;		
				
	
КонецПроцедуры // СоздатьНедостающиеОплатыПоНачислениямДивидендов

&НаСервереБезКонтекста
Процедура СоздатьНедостающиеНачисленияЗадолженностиНалога(ДатаНачисления, ВыбОрганизация, НачисленияДивидендов, СчетаДУ, коэффД1, коэффД2)
	
	//Запрос. Ранее сделанные документы
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиРасчетныеСчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	ОстаткиРасчетныеСчета.РасчетныйСчет КАК РасчетныйСчет,
	|	МАКСИМУМ(ОстаткиРасчетныеСчета.СуммаОстаток) КАК Сумма
	|ПОМЕСТИТЬ _ДеньгиРасчетныеСчета
	|ИЗ
	|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И Валюта = &Валюта
	|				И (Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
	|					И РасчетныйСчет <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка))
	|				И СчетДоверительногоУправления В (&СчетаДоверительногоУправления)) КАК ОстаткиРасчетныеСчета
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиРасчетныеСчета.СчетДоверительногоУправления,
	|	ОстаткиРасчетныеСчета.РасчетныйСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиБрокер.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	МАКСИМУМ(ОстаткиБрокер.СуммаОстаток) КАК Сумма,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОстаткиБрокер.МестоХранения) КАК МестоХранения
	|ПОМЕСТИТЬ _ДеньгиБрокер
	|ИЗ
	|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И Валюта = &Валюта
	|				И Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
	|				И СчетДоверительногоУправления В (&СчетаДоверительногоУправления)) КАК ОстаткиБрокер
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиБрокер.СчетДоверительногоУправления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(_ДеньгиБрокер.СчетДоверительногоУправления, _ДеньгиРасчетныеСчета.СчетДоверительногоУправления) КАК СчетДоверительногоУправления,
	|	ЕСТЬNULL(_ДеньгиБрокер.Сумма, 0) КАК СуммаБрокер,
	|	_ДеньгиРасчетныеСчета.РасчетныйСчет КАК РасчетныйСчет,
	|	ЕСТЬNULL(_ДеньгиРасчетныеСчета.Сумма, 0) КАК СуммаРасчетныйСчет
	|ПОМЕСТИТЬ _ДеньгиКлиентов
	|ИЗ
	|	_ДеньгиРасчетныеСчета КАК _ДеньгиРасчетныеСчета
	|		ПОЛНОЕ СОЕДИНЕНИЕ _ДеньгиБрокер КАК _ДеньгиБрокер
	|		ПО _ДеньгиРасчетныеСчета.СчетДоверительногоУправления = _ДеньгиБрокер.СчетДоверительногоУправления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НачислениеДивидендов.Ссылка КАК НачислениеДивидендов,
	|	НачислениеЗадолженностиОснования.Ссылка КАК ДокументНДФЛ,
	|	НачислениеЗадолженностиОснования.Ссылка.Проведен КАК ДокументЗадолженностиПроведен,
	|	НачислениеДивидендов.СчетДоверительногоУправления КАК СчетДоверительногоУправления
	|ПОМЕСТИТЬ _НачисленияЗадолженности
	|ИЗ
	|	Документ.НачислениеДивидендов КАК НачислениеДивидендов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
	|		ПО НачислениеДивидендов.Ссылка = НачислениеЗадолженностиОснования.Основание
	|ГДЕ
	|	НачислениеДивидендов.Ссылка В(&НачисленияДивидендов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ДеньгиКлиентов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	_ДеньгиКлиентов.СуммаБрокер КАК СуммаБрокер,
	|	_ДеньгиКлиентов.РасчетныйСчет КАК РасчетныйСчет,
	|	_ДеньгиКлиентов.СуммаРасчетныйСчет КАК СуммаРасчетныйСчет,
	|	_НачисленияЗадолженности.НачислениеДивидендов КАК НачислениеДивидендов,
	|	_НачисленияЗадолженности.ДокументНДФЛ КАК ДокументНДФЛ,
	|	_НачисленияЗадолженности.ДокументЗадолженностиПроведен КАК ДокументЗадолженностиПроведен
	|ИЗ
	|	_ДеньгиКлиентов КАК _ДеньгиКлиентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ _НачисленияЗадолженности КАК _НачисленияЗадолженности
	|		ПО _ДеньгиКлиентов.СчетДоверительногоУправления = _НачисленияЗадолженности.СчетДоверительногоУправления";
	
	
	Запрос.УстановитьПараметр("НачисленияДивидендов", НачисленияДивидендов);
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаДУ);
	Запрос.УстановитьПараметр("Период", ДатаНачисления);
	Запрос.УстановитьПараметр("Организация", ВыбОрганизация);
	Запрос.УстановитьПараметр("Валюта", ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	НачисленияЗадолженности = Запрос.Выполнить().Выгрузить();
	
	Для Каждого НачислениеНДФЛ из НачисленияЗадолженности Цикл 
		
		// начисление дививдендов уже должно быть. Нет - молча пропустим
		Если НЕ ЗначениеЗаполнено(НачислениеНДФЛ.НачислениеДивидендов) Тогда 
			Продолжить;
		КонецЕсли;	
		
		// если начисление задолженности НДФЛ уже есть - новое не создаем.
		Если ЗначениеЗаполнено(НачислениеНДФЛ.ДокументНДФЛ)  Тогда 
			Если НачислениеНДФЛ.ДокументЗадолженностиПроведен Тогда
				Продолжить;				
			Иначе
				Документ = НачислениеНДФЛ.ДокументНДФЛ.ПолучитьОбъект();
			КонецЕсли;	
		Иначе	
			//	Создаем документ	
			Документ = Документы.НачислениеЗадолженности.СоздатьДокумент();	
		КонецЕсли;	
		
		Начисление = НачислениеНДФЛ.НачислениеДивидендов; 
		
		СуммаНалога = РаботаСНалогамиКлиентСервер.РассчитатьНалогСДивидендов(Начисление.СуммаОбъявленная, Начисление.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления, коэффД1, коэффД2);
		
		Если НачислениеНДФЛ.РасчетныйСчет <> Справочники.БанковскиеСчета.ПустаяСсылка() И
			НачислениеНДФЛ.СуммаРасчетныйСчет < СуммаНалога Тогда
			//не хватает денег
			ТекстСообщения = "У клиента " + Начисление.СчетДоверительногоУправления + " недостаточно средств для оплаты налога."; 
			Если НачислениеНДФЛ.СуммаБрокер >= СуммаНалога Тогда 
				ТекстСообщения = ТекстСообщения + " Необходимая сумма есть на счете брокера.";
			КонецЕсли;	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
		//	Заполняем документ		
		
			
		Документ.Ответственный = РаботаСПользователями.ТекущийПользователь();
		
		ЗаполнитьЗначенияСвойств(Документ, Начисление, "Организация, СчетДоверительногоУправления");
		
		Если Начисление.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица 
			ИЛИ Начисление.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет Тогда
			Документ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНДФЛ13;
			Документ.Контрагент       = РегистрыСведений.ИФНСОрганизаций.ПолучитьИФНС(ДатаНачисления, ВыбОрганизация, Ложь);		
		Иначе	
			Документ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНалогуНаПрибыль;
			Документ.Контрагент       = РегистрыСведений.ИФНСОрганизаций.ПолучитьИФНС(ДатаНачисления, ВыбОрганизация, Истина);		
		КонецЕсли;	
		Документ.МестоХранения    		= Справочники.МестаХранения.ВнебиржевойРынок;
		Документ.ПрочиеДоходыИРасходы	= ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_НалогСДивидендов");
		
		Документ.Валюта 				= Документ.Организация.ВалютаУчета;
		Документ.Дата = ДатаНачисления;
		Документ.ДатаПолученияДокумента	= ДатаНачисления;
		Документ.РасчетныйСчет = НачислениеНДФЛ.РасчетныйСчет;
		
		Документ.Основания.Очистить();  
		НоваяСтрока = Документ.Основания.Добавить();
		НоваяСтрока.Сумма = СуммаНалога;
		НоваяСтрока.Основание = Начисление;
		НоваяСтрока.ЦеннаяБумага = Начисление.ЦеннаяБумага;
		
		Если Не Документ.ПроверитьЗаполнение() Тогда
			//если не хватило денег, расчетный счет не заполнится. Документ не проведется, просто сохраним его. 
			//при повторном сздании он перезаполнится. 
			Документ.Записать(РежимЗаписиДокумента.Запись);
		Иначе	
			Документ.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;		
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоздатьНедостающиеНачисленияЗадолженностиНалога2025(ДатаНачисления, ВыбОрганизация, РасчетыНДФЛ, СчетаДУ, ЦеннааБумага)
	
	//Запрос. Ранее сделанные документы
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиРасчетныеСчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	ОстаткиРасчетныеСчета.РасчетныйСчет КАК РасчетныйСчет,
	|	МАКСИМУМ(ОстаткиРасчетныеСчета.СуммаОстаток) КАК Сумма
	|ПОМЕСТИТЬ _ДеньгиРасчетныеСчета
	|ИЗ
	|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И Валюта = &Валюта
	|				И (Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
	|					И РасчетныйСчет <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка))
	|				И СчетДоверительногоУправления В (&СчетаДоверительногоУправления)) КАК ОстаткиРасчетныеСчета
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиРасчетныеСчета.СчетДоверительногоУправления,
	|	ОстаткиРасчетныеСчета.РасчетныйСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиБрокер.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	МАКСИМУМ(ОстаткиБрокер.СуммаОстаток) КАК Сумма,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОстаткиБрокер.МестоХранения) КАК МестоХранения
	|ПОМЕСТИТЬ _ДеньгиБрокер
	|ИЗ
	|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И Валюта = &Валюта
	|				И Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
	|				И СчетДоверительногоУправления В (&СчетаДоверительногоУправления)) КАК ОстаткиБрокер
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиБрокер.СчетДоверительногоУправления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(_ДеньгиБрокер.СчетДоверительногоУправления, _ДеньгиРасчетныеСчета.СчетДоверительногоУправления) КАК СчетДоверительногоУправления,
	|	ЕСТЬNULL(_ДеньгиБрокер.Сумма, 0) КАК СуммаБрокер,
	|	_ДеньгиРасчетныеСчета.РасчетныйСчет КАК РасчетныйСчет,
	|	ЕСТЬNULL(_ДеньгиРасчетныеСчета.Сумма, 0) КАК СуммаРасчетныйСчет
	|ПОМЕСТИТЬ _ДеньгиКлиентов
	|ИЗ
	|	_ДеньгиРасчетныеСчета КАК _ДеньгиРасчетныеСчета
	|		ПОЛНОЕ СОЕДИНЕНИЕ _ДеньгиБрокер КАК _ДеньгиБрокер
	|		ПО _ДеньгиРасчетныеСчета.СчетДоверительногоУправления = _ДеньгиБрокер.СчетДоверительногоУправления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИФНСОрганизацийСрезПоследних.ИФНС КАК ИФНС,
	|	ИФНСОрганизацийСрезПоследних.БанковскийСчет КАК БанковскийСчет
	|ПОМЕСТИТЬ _ИФНС
	|ИЗ
	|	РегистрСведений.ИФНСОрганизаций.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И НЕ ПоКрупнейшимНалогоплательщикам) КАК ИФНСОрганизацийСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РасчетНДФЛНалоговаяБаза2025.Ссылка КАК ДокуменРасчетНДФЛ,
	|	РасчетНДФЛНалоговаяБаза2025.Ссылка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	РасчетНДФЛНалоговаяБаза2025.Ссылка.Организация КАК Организация,
	|	СУММА(РасчетНДФЛНалоговаяБаза2025.СуммаНалога - РасчетНДФЛНалоговаяБаза2025.СуммаУменьшающаяНалог) КАК СуммаНалога,
	|	НачислениеЗадолженностиОснования.Ссылка КАК ДокументНДФЛ,
	|	ВЫБОР
	|		КОГДА НачислениеЗадолженностиОснования.Ссылка.Проведен
	|			ТОГДА 1
	|		КОГДА НачислениеЗадолженностиОснования.Ссылка.ПометкаУдаления
	|			ТОГДА 0
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК СостояниеДокумента,
	|	_ДеньгиКлиентов.СуммаБрокер КАК СуммаБрокер,
	|	_ДеньгиКлиентов.СуммаРасчетныйСчет КАК СуммаРасчетныйСчет,
	|	_ДеньгиКлиентов.РасчетныйСчет КАК РасчетныйСчет,
	|	_ИФНС.ИФНС КАК Контрагент,
	|	_ИФНС.БанковскийСчет КАК РасчетныйСчетКонтрагента
	|ИЗ
	|	Документ.РасчетНДФЛ.НалоговаяБаза2025 КАК РасчетНДФЛНалоговаяБаза2025
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
	|		ПО РасчетНДФЛНалоговаяБаза2025.Ссылка = НачислениеЗадолженностиОснования.Основание
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ДеньгиКлиентов КАК _ДеньгиКлиентов
	|		ПО РасчетНДФЛНалоговаяБаза2025.Ссылка.СчетДоверительногоУправления = _ДеньгиКлиентов.СчетДоверительногоУправления
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ИФНС КАК _ИФНС
	|		ПО (ИСТИНА)
	|ГДЕ
	|	РасчетНДФЛНалоговаяБаза2025.Ссылка В(&РасчетыНДФЛ)
	|
	|СГРУППИРОВАТЬ ПО
	|	РасчетНДФЛНалоговаяБаза2025.Ссылка,
	|	РасчетНДФЛНалоговаяБаза2025.Ссылка.СчетДоверительногоУправления,
	|	РасчетНДФЛНалоговаяБаза2025.Ссылка.Организация,
	|	ВЫБОР
	|		КОГДА РасчетНДФЛНалоговаяБаза2025.Ссылка.Проведен
	|			ТОГДА 1
	|		КОГДА РасчетНДФЛНалоговаяБаза2025.Ссылка.ПометкаУдаления
	|			ТОГДА 0
	|		ИНАЧЕ 2
	|	КОНЕЦ,
	|	НачислениеЗадолженностиОснования.Ссылка,
	|	_ДеньгиКлиентов.СуммаБрокер,
	|	_ДеньгиКлиентов.СуммаРасчетныйСчет,
	|	_ДеньгиКлиентов.РасчетныйСчет,
	|	ВЫБОР
	|		КОГДА НачислениеЗадолженностиОснования.Ссылка.Проведен
	|			ТОГДА 1
	|		КОГДА НачислениеЗадолженностиОснования.Ссылка.ПометкаУдаления
	|			ТОГДА 0
	|		ИНАЧЕ 2
	|	КОНЕЦ,
	|	_ИФНС.ИФНС,
	|	_ИФНС.БанковскийСчет";
	
	
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаДУ);
	Запрос.УстановитьПараметр("Период", ДатаНачисления);
	Запрос.УстановитьПараметр("Организация", ВыбОрганизация);
	Запрос.УстановитьПараметр("РасчетыНДФЛ", РасчетыНДФЛ);
	Запрос.УстановитьПараметр("Валюта", ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.Прямой);
	
	Пока Выборка.Следующий() Цикл 
		
		// если начисление задолженности НДФЛ уже есть - новое не создаем.
		Если ЗначениеЗаполнено(Выборка.ДокументНДФЛ)  Тогда 
			Если Выборка.СостояниеДокумента = 1 Тогда  
				Продолжить;
			ИначеЕсли Выборка.СостояниеДокумента = 0 Тогда 
				Документ = Документы.НачислениеЗадолженности.СоздатьДокумент();	
			Иначе
				Документ = Выборка.ДокументНДФЛ.ПолучитьОбъект();
			КонецЕсли;	
		Иначе	
			//	Создаем документ	
			Документ = Документы.НачислениеЗадолженности.СоздатьДокумент();	
		КонецЕсли;	
		
		РасчетНДФЛ = Выборка.ДокуменРасчетНДФЛ; 
		
		СуммаНалога = Выборка.СуммаНалога; 
		
		Если Выборка.РасчетныйСчет <> Справочники.БанковскиеСчета.ПустаяСсылка() И
			Выборка.СуммаРасчетныйСчет < СуммаНалога Тогда
			//не хватает денег
			ТекстСообщения = "У клиента " + Выборка.СчетДоверительногоУправления + " недостаточно средств для оплаты налога."; 
			Если Выборка.СуммаБрокер >= СуммаНалога Тогда 
				ТекстСообщения = ТекстСообщения + " Необходимая сумма есть на счете брокера.";
			КонецЕсли;	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
		//	Заполняем документ		
			
		Документ.Ответственный = РаботаСПользователями.ТекущийПользователь();
		
		ЗаполнитьЗначенияСвойств(Документ, РасчетНДФЛ, "Организация, СчетДоверительногоУправления");
		
		Документ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНДФЛ13;
		Документ.Контрагент       = Выборка.Контрагент;
		Документ.РасчетныйСчетКонтрагента = Выборка.РасчетныйСчетКонтрагента;
		
		Документ.МестоХранения    		= Справочники.МестаХранения.ВнебиржевойРынок;
		Документ.ПрочиеДоходыИРасходы	= ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_НалогСДивидендов");
		
		Документ.Валюта 				= Документ.Организация.ВалютаУчета;
		Документ.Дата = ДатаНачисления;
		Документ.ДатаПолученияДокумента	= ДатаНачисления;
		Документ.РасчетныйСчет = Выборка.РасчетныйСчет;
		
		Документ.Основания.Очистить();  
		НоваяСтрока = Документ.Основания.Добавить();
		НоваяСтрока.Сумма = СуммаНалога;
		НоваяСтрока.Основание = РасчетНДФЛ;
		НоваяСтрока.ЦеннаяБумага = ЦеннааБумага;
		
		Если Не Документ.ПроверитьЗаполнение() Тогда
			//если не хватило денег, расчетный счет не заполнится. Документ не проведется, просто сохраним его. 
			//при повторном сздании он перезаполнится. 
			Документ.Записать(РежимЗаписиДокумента.Запись);
		Иначе	
			Документ.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоздатьНедостающиеРасчетыНДФЛНаСервере(ДатаНачисления, ВыбОрганизация, ОплатыДивидендов)
	
	//Запрос. Ранее сделанные документы
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОплатаОснования.Основание КАК НачислениеДивидендов,
	|	ОплатаОснования.Ссылка КАК ОплатаДивидендов,
	|	РасчетНДФЛОснования.Ссылка КАК ДокументРасчетНДФЛ,
	|	ВЫБОР
	|		КОГДА РасчетНДФЛОснования.Ссылка.Проведен
	|			ТОГДА 1
	|		КОГДА РасчетНДФЛОснования.Ссылка.ПометкаУдаления
	|			ТОГДА 0
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК СостояниеДокумента,
	|	ОплатаОснования.Ссылка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	ОплатаОснования.Ссылка.Организация КАК Организация,
	|	ОплатаОснования.Ссылка.ВалютаОплаты КАК ВалютаОплаты,
	|	ОплатаОснования.Ссылка.Брокер КАК Брокер,
	|	ОплатаОснования.Ссылка.РасчетныйСчет КАК РасчетныйСчет,
	|	ОплатаОснования.Сумма КАК Сумма
	|ИЗ
	|	Документ.Оплата.Основания КАК ОплатаОснования
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасчетНДФЛ.Основания КАК РасчетНДФЛОснования
	|		ПО ОплатаОснования.Ссылка = РасчетНДФЛОснования.Основание
	|ГДЕ
	|	ОплатаОснования.Ссылка В(&ОплатыДивидендов)";
	
	
	Запрос.УстановитьПараметр("ОплатыДивидендов", ОплатыДивидендов);
	Запрос.УстановитьПараметр("Период", ДатаНачисления);
	Запрос.УстановитьПараметр("Организация", ВыбОрганизация);
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.Прямой); 
	
	Пока Выборка.Следующий() Цикл 
		//если Расчет НДФЛ есть, мы его пропустим
		Если ЗначениеЗаполнено(Выборка.ДокументРасчетНДФЛ) Тогда
			
			Если Выборка.СостояниеДокумента  = 1 Тогда  
				Продолжить;
			ИначеЕсли Выборка.СостояниеДокумента  = 0 Тогда 
				ДокументРасчетНДФЛ = Документы.РасчетНДФЛ.СоздатьДокумент();
			Иначе
				ДокументРасчетНДФЛ = Выборка.ДокументРасчетНДФЛ.ПолучитьОбъект();
			КонецЕсли;	
		Иначе
			ДокументРасчетНДФЛ = Документы.РасчетНДФЛ.СоздатьДокумент();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ДокументРасчетНДФЛ, Выборка, "Организация, СчетДоверительногоУправления");    
		
		ДокументРасчетНДФЛ.ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.ВыплатаДивидендов; 
		ДокументРасчетНДФЛ.Дата = ДатаНачисления;
		ДокументРасчетНДФЛ.ДатаРасчета = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ДатаНачисления);   
		ДокументРасчетНДФЛ.Ответственный =  РаботаСПользователями.ТекущийПользователь();
		
		// заполним основание 
		ДокументРасчетНДФЛ.Основания.Очистить();
		НоваяСтрокаОснование = ДокументРасчетНДФЛ.Основания.Добавить();
		НоваяСтрокаОснование.Основание = Выборка.ОплатаДивидендов;
		НоваяСтрокаОснование.Сумма     = Выборка.Сумма;
		
	    //заполнение ТЧ 
		ДокументРасчетНДФЛ.ЗаполнитьТабличнуюЧасть();
		
		
		Если Не ДокументРасчетНДФЛ.ПроверитьЗаполнение() Тогда
			ДокументРасчетНДФЛ.Записать(РежимЗаписиДокумента.Запись);
		Иначе	
			ДокументРасчетНДФЛ.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;		
		
	КонецЦикла;	
	
	
КонецПроцедуры

#КонецОбласти