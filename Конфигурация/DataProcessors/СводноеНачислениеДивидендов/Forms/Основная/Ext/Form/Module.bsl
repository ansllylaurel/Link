#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// начальное заполнение формы
	Если ЭтаФорма.Параметры.Свойство("НачислениеДивидендов") И ЗначениеЗаполнено(ЭтаФорма.Параметры.НачислениеДивидендов) Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ЭтаФорма.Параметры.НачислениеДивидендов);
	Иначе
		ЭтаФорма.Организация    	= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
		ЭтаФорма.Дата           	= ТекущаяДата();
		ЭтаФорма.ДатаРеестра    	= ТекущаяДата();
		ЭтаФорма.ДатаПубликации 	= ТекущаяДата();
		ЭтаФорма.ДатаОплатыПлановая = ТекущаяДата();
	КонецЕсли;

	ЗаполнитьПлановыеИСозданныеНачисленияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "СводноеНачислениеДивидендов.Обновить" Тогда
		ЗаполнитьПлановыеИСозданныеНачисленияНаСервере();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.ЦеннаяБумага) Тогда 
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.Д1 = 0;
	ЭтаФорма.Д2 = 0;
	ЭтаФорма.ДивидендыНаЦеннуюБумагу = 0;
	ЭтаФорма.ИдСобытия = "";
	ЭтаФорма.ДатаОплатыПлановая = "";
	
	ПараметрыФормы = Новый Структура("ЦеннаяБумага, Дата", ЦеннаяБумага, Дата);
	ПараметрыНачисления = ОткрытьФормуМодально("Обработка.СводноеНачислениеДивидендов.Форма.ФормаВыбораНачисления", ПараметрыФормы);
	Если ПараметрыНачисления = Неопределено Тогда 
		Возврат;
	КонецЕсли;  
	
	Если ПараметрыНачисления.СтатусСобытия = ПредопределенноеЗначение("Перечисление.СтатусыСобытийПоВыплатеДивидендов.Отменено") Тогда
		Предупреждение("Вы выбрали отмененное событие по выплате дивидендов. Параметры начисления не будут заполнены",, "Выбрано отмененное событие!");
		ЭтаФорма.Дата = Дата(1, 1, 1); 
		Возврат;
	КонецЕсли;
		
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ПараметрыНачисления); 
		
	Если ДатаРеестра <> ЭтаФорма.Дата Или ДатаПубликации <> ЭтаФорма.Дата Тогда
		Если Вопрос("Установить даты реестра и публикации равные выбранной дате?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			ЭтаФорма.ДатаРеестра    = ЭтаФорма.Дата;
			ЭтаФорма.ДатаПубликации = ЭтаФорма.Дата;
		КонецЕсли;
	КонецЕсли;
		
	ЗаполнитьПлановыеИСозданныеНачисленияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаФиксацииПриИзменении(Элемент)
	
	ЗаполнитьПлановыеИСозданныеНачисленияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЦеннаяБумагаПриИзменении(Элемент)
	
	СписокДатДивидендов();
	ДатаПриИзменении(Элемент);
		
	ДивидендыНаЦеннуюБумагуПриИзменении(Неопределено);
	
	ЗаполнитьПлановыеИСозданныеНачисленияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДивидендыНаЦеннуюБумагуПриИзменении(Элемент)
	
	Для каждого СтрокаНачисленияПлановые Из ЭтаФорма.НачисленияПлановые Цикл
		СтрокаНачисленияПлановые.СуммаОбъявленная = СтрокаНачисленияПлановые.Количество * ЭтаФорма.ДивидендыНаЦеннуюБумагу;
		СтрокаНачисленияПлановые.Сумма            = СтрокаНачисленияПлановые.СуммаОбъявленная - 
				РаботаСНалогамиКлиентСервер.РассчитатьНалогСДивидендов(СтрокаНачисленияПлановые.СуммаОбъявленная, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаНачисленияПлановые.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления"), ЭтаФорма.Д1, ЭтаФорма.Д2, Ложь);
	КонецЦикла;
	
	ОбновитьНадписьНачисленияПлановыеИтого(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияСозданныеПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекущиеДанные = Элементы.НачисленияСозданные.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьЗначение(ТекущиеДанные.Документ);
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаЗаполнитьДатыРеестраИПубликацииИзДаты(Команда)
	
	ЭтаФорма.ДатаРеестра    = ЭтаФорма.Дата;
	ЭтаФорма.ДатаПубликации = ЭтаФорма.Дата;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаНачисленияПлановыеУстановитьВсеФлажки(Команда)
	
	Для каждого СтрокаНачисленияПлановые Из ЭтаФорма.НачисленияПлановые Цикл
		СтрокаНачисленияПлановые.Флажок = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаНачисленияПлановыеСнятьВсеФлажки(Команда)
	
	Для каждого СтрокаНачисленияПлановые Из ЭтаФорма.НачисленияПлановые Цикл
		СтрокаНачисленияПлановые.Флажок = Ложь;
	КонецЦикла;

	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновить(Команда)
	
	КлючиРазвернутыхСтрокНачисленияСозданные = Неопределено;
	РаботаСФормамиКлиент.ПолучитьКлючиРазвернутыхСтрокДерева(ЭтаФорма.НачисленияСозданные, Элементы.НачисленияСозданные, "Документ", КлючиРазвернутыхСтрокНачисленияСозданные);
	
	КлючТекущейСтрокиНачисленияСозданные = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.НачисленияСозданные, "Документ");
	КлючТекущейСтрокиНачисленияПлановые  = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.НачисленияПлановые,  "СчетДоверительногоУправления");
	
	ЗаполнитьПлановыеИСозданныеНачисленияНаСервере();
	
	РаботаСФормамиКлиент.ВосстановитьРазвернутыеСтрокиДереваПоКлючу(ЭтаФорма.НачисленияСозданные, Элементы.НачисленияСозданные, "Документ", КлючиРазвернутыхСтрокНачисленияСозданные);
	
	РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.НачисленияСозданные, Элементы.НачисленияСозданные, "Документ", КлючТекущейСтрокиНачисленияСозданные);
	РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.НачисленияПлановые, Элементы.НачисленияПлановые, "СчетДоверительногоУправления", КлючТекущейСтрокиНачисленияСозданные);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьНачисленияДивидендов(Команда)
	
	ЕстьОшибки = Ложь;
	
	// проверим заполнение
	Если ЭтаФорма.Дата < ЭтаФорма.ДатаРеестра Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Дата не может быть меньше даты реестра!'"), ЭтаФорма, "ДатаРеестра");
		Возврат;
	КонецЕсли;
	
	ВыбНачисленияДивидендов = Новый Массив();
	
	Для НомСтр = 0 По ЭтаФорма.НачисленияПлановые.Количество() - 1 Цикл
			
		СтрокаПлановыеНачисления = ЭтаФорма.НачисленияПлановые[НомСтр];
		
		Если Не СтрокаПлановыеНачисления.Флажок Тогда
			Продолжить;
		КонецЕсли;
	
		Если СтрокаПлановыеНачисления.Количество = 0 Тогда
			Сообщить("Не заполнено поле ""Количество"" в строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если СтрокаПлановыеНачисления.СуммаОбъявленная = 0 Тогда
			Сообщить("Не заполнено поле ""Сумма объявленная"" в строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецЕсли;

		Если СтрокаПлановыеНачисления.Сумма = 0 Тогда
			Сообщить("Не заполнено поле ""Сумма"" в строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		ВыбНачисленияДивидендов.Добавить(
			Новый Структура("СчетДоверительногоУправления, Количество, СуммаОбъявленная, Сумма, НачислятьОбязательства",
				СтрокаПлановыеНачисления.СчетДоверительногоУправления,
				СтрокаПлановыеНачисления.Количество,
				СтрокаПлановыеНачисления.СуммаОбъявленная,
				?(СтрокаПлановыеНачисления.НачислятьОбязательства,СтрокаПлановыеНачисления.Сумма, СтрокаПлановыеНачисления.СуммаОбъявленная),
				СтрокаПлановыеНачисления.НачислятьОбязательства));
				
				//важно для ЕПС. Сумма учитывается в СЧА
				//Волга-Капитал единственный у кого стоит "Да". Поэтому только для них ставим сумму с учетом налога 
				// типа работало всегда, так как раньше всегда эти суммы не отличались;
		
	КонецЦикла;
	
	Если      ЕстьОшибки Тогда
		Возврат;
	ИначеЕсли ВыбНачисленияДивидендов.Количество() = 0 Тогда
		Сообщить("Не выбраны плановые начисления.");
		Возврат;
	КонецЕсли;
	
	// откроем форму
	ПараметрыФормы = Новый Структура("НачисленияДивидендов, Организация, Дата, ДатаРеестра, ДатаПубликации, ДатаОплатыПлановая, ЦеннаяБумага, ДивидендыНаЦеннуюБумагу, Д1, Д2, ИдСобытия", ВыбНачисленияДивидендов);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ЭтаФорма);
	
	Если ОткрытьФормуМодально("Обработка.СводноеНачислениеДивидендов.Форма.СозданиеНачисленияДивидендов", ПараметрыФормы, ЭтаФорма) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КомандаОбновить(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыПровести(Команда)
	
	ДанныеВыбранныхДокументов = ПолучитьДанныеВыбранныхДокументов();
		
	Если ДанныеВыбранныхДокументов.Количество() > 0 Тогда
		
		РаботаСоСпискомДокументовКлиент.Провести(ДанныеВыбранныхДокументов);
	
		КомандаОбновить(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыОтменитьПроведение(Команда)
	
	ДанныеВыбранныхДокументов = ПолучитьДанныеВыбранныхДокументов();
	
	Если ДанныеВыбранныхДокументов.Количество() > 0 Тогда
		
		РаботаСоСпискомДокументовКлиент.ОтменитьПроведение(ДанныеВыбранныхДокументов);
		
		КомандаОбновить(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыУстановитьСнятьПометкуУдаление(Команда)
	
	ДанныеВыбранныхДокументов = ПолучитьДанныеВыбранныхДокументов();
	
	Если ДанныеВыбранныхДокументов.Количество() > 0 Тогда		
		
		РаботаСоСпискомДокументовКлиент.УстановитьСнятьПометкуУдаления(ДанныеВыбранныхДокументов);
		
		КомандаОбновить(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыСоздатьНаОсновании(Команда)
	
	ТекущиеДанныеСписка = Элементы.НачисленияСозданные.ТекущиеДанные;
	
	Если ТекущиеДанныеСписка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанныеСписка.Документ) = Тип("ДокументСсылка.НачислениеДивидендов") Тогда
		
		РаботаСоСпискомДокументовКлиент.СоздатьНаОсновании(ТекущиеДанныеСписка.Документ, "НачислениеДивидендов");
		
		КомандаОбновить(Неопределено);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьНедостающиеОплатыНаПолнуюСумму(Команда)
	
	НачисленияДивидендов = Новый Массив();
	
	Для каждого Элемент Из ЭтаФорма.НачисленияСозданные.ПолучитьЭлементы() Цикл
		НачисленияДивидендов.Добавить(Элемент.Документ);
	КонецЦикла;
	
	Если НачисленияДивидендов.Количество() > 0 Тогда
		
		ДатаОплат = ТекущаяДата();
		
		Если Не ВвестиДату(ДатаОплат, "Введите дату оплат", ЧастиДаты.ДатаВремя) Тогда
			Возврат;
		КонецЕсли;
		
		СоздатьНедостающиеОплатыПоНачислениямДивидендов(
				ДатаОплат,
				ЭтаФорма.Организация,
				РаботаСЦеннымиБумагами.КонтрагентПоЦеннойБумаге(ЭтаФорма.ЦеннаяБумага, ДатаОплат),
				НачисленияДивидендов,
				РаботаСЦеннымиБумагамиКлиентСервер.ВидЗадолженностиДивидендыПоЦеннойБумаге(ЭтаФорма.ЦеннаяБумага));
		
		КомандаОбновить(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

