&НаКлиенте
Процедура КомандаНачисленияСозданныеСвернутьВсе(Команда)
	
	РаботаСФормамиКлиент.СвернутьВсеЭлементыДерева(ЭтаФорма.НачисленияСозданные, Элементы.НачисленияСозданные);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьОплатыНалога(Команда)
	
	Если ЭтотОбъект.Дата < '20250101' Тогда 	
		
		НачисленияДивидендов 		= Новый Массив();
		НачисленияЗадолженности 	= Новый Соответствие();
		
		Для каждого Элемент Из ЭтаФорма.НачисленияСозданные.ПолучитьЭлементы() Цикл		
			ВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Элемент.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");	
			Если ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет") 
				ИЛИ ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица") Тогда  		
				
				НачисленияДивидендов.Добавить(Элемент.Документ);
				Для Каждого ПодчиненныйЭлемент Из Элемент.ПолучитьЭлементы() Цикл 
					Если ТипЗнч(ПодчиненныйЭлемент.Документ) = Тип("ДокументСсылка.НачислениеЗадолженности") Тогда	
						НачисленияЗадолженности.Вставить(Элемент.Документ, ПодчиненныйЭлемент.Документ);
					КонецЕсли;	
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		Если НачисленияДивидендов.Количество() > 0 Тогда
			
			ДатаНачисления = ТекущаяДата();
			
			Если Не ВвестиДату(ДатаНачисления, "Введите дату начисления задолженности", ЧастиДаты.ДатаВремя) Тогда
				Возврат;
			КонецЕсли;
			
			СоздатьНедостающиеОплатыНалога(
			ДатаНачисления,
			ЭтаФорма.Организация,
			НачисленияДивидендов, НачисленияЗадолженности);
			
			КомандаОбновить(Неопределено);
			
		КонецЕсли;
		
	Иначе     
		
		НачисленияЗадолженностиНДФЛ 	= Новый Массив;   
		
		Для каждого Элемент Из ЭтаФорма.НачисленияСозданные.ПолучитьЭлементы() Цикл 
			Для Каждого ЭлементУровень2 из Элемент.ПолучитьЭлементы() Цикл
				Если ТипЗнч(ЭлементУровень2.Документ) = Тип("ДокументСсылка.НачислениеЗадолженности")
					И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭлементУровень2.Документ, "ВидЗадолженности") = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоНДФЛ13") Тогда
					НачисленияЗадолженностиНДФЛ.Добавить(ЭлементУровень2.Документ);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Если НачисленияЗадолженностиНДФЛ.Количество() > 0 Тогда
			
			ДатаНачисления = ТекущаяДата();
			
			Если Не ВвестиДату(ДатаНачисления, "Введите дату начисления задолженности", ЧастиДаты.ДатаВремя) Тогда
				Возврат;
			КонецЕсли;
			
			СоздатьНедостающиеОплатыНалога2025(
			ДатаНачисления,
			ЭтаФорма.Организация,
			НачисленияЗадолженностиНДФЛ);
			
			КомандаОбновить(Неопределено);
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьНачислениеЗадолженностиПоНалогу(Команда)
	
	Если ЭтотОбъект.Дата < '20250101' Тогда 
		
		НачисленияДивидендов = Новый Массив();
		СчетаДУ = Новый Массив();
		
		Для каждого Элемент Из ЭтаФорма.НачисленияСозданные.ПолучитьЭлементы() Цикл   
			
			ВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Элемент.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");	
			Если ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет") 
				ИЛИ ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица") Тогда  		
				НачисленияДивидендов.Добавить(Элемент.Документ);
				СчетаДУ.Добавить(Элемент.СчетДоверительногоУправления);
			КонецЕсли;	
		КонецЦикла;
		
		Если НачисленияДивидендов.Количество() > 0 Тогда
			
			ДатаНачисления = ТекущаяДата();
			
			Если Не ВвестиДату(ДатаНачисления, "Введите дату начисления задолженности", ЧастиДаты.ДатаВремя) Тогда
				Возврат;
			КонецЕсли;
			
			СоздатьНедостающиеНачисленияЗадолженностиНалога(
			ДатаНачисления,
			ЭтаФорма.Организация,
			НачисленияДивидендов,
			СчетаДУ, Д1, Д2);
			
			КомандаОбновить(Неопределено);
			
		КонецЕсли;      
		
	Иначе 
		// структура зависимости изменилась. Начисление задолженности по налогу зависит от Расчета НДФЛ
		
		РасчетыНДФЛ = Новый Массив(); 
		СчетаДУ = Новый Массив();
		
		Для каждого Элемент Из ЭтаФорма.НачисленияСозданные.ПолучитьЭлементы() Цикл 
			Для Каждого ЭлементУровень2 из Элемент.ПолучитьЭлементы() Цикл
				Если ТипЗнч(ЭлементУровень2.Документ) = Тип("ДокументСсылка.РасчетНДФЛ") Тогда
					РасчетыНДФЛ.Добавить(ЭлементУровень2.Документ);
					СчетаДУ.Добавить(ЭлементУровень2.СчетДоверительногоУправления); 
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Если РасчетыНДФЛ.Количество() > 0 Тогда
			
			ДатаНачисления = ТекущаяДата();
			
			Если Не ВвестиДату(ДатаНачисления, "Введите дату создания Расчета НДФЛ", ЧастиДаты.ДатаВремя) Тогда
				Возврат;
			КонецЕсли;                  
			
			СоздатьНедостающиеНачисленияЗадолженностиНалога2025(
			ДатаНачисления,
			ЭтаФорма.Организация,
			РасчетыНДФЛ,
			СчетаДУ,
			ЭтотОбъект.ЦеннаяБумага);
			
			КомандаОбновить(Неопределено);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьРасчетыНДФЛ(Команда)
	
	ОплатыДивидендов = Новый Массив();
	
	Для каждого Элемент Из ЭтаФорма.НачисленияСозданные.ПолучитьЭлементы() Цикл 
		Для Каждого ЭлементУровень2 из Элемент.ПолучитьЭлементы() Цикл 
			Если ТипЗнч(ЭлементУровень2.Документ) = Тип("ДокументСсылка.Оплата") 
				И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭлементУровень2.Документ, "ВидЗадолженности") = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоНачислениюДивидендовАкции") Тогда // по другим дивидендам не умеем делать Расчет НДФЛ

				ВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Элемент.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
				Если ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет") 
					ИЛИ ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица") Тогда
					ОплатыДивидендов.Добавить(ЭлементУровень2.Документ);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если ОплатыДивидендов.Количество() > 0 Тогда
		
		ДатаНачисления = ТекущаяДата();
		
		Если Не ВвестиДату(ДатаНачисления, "Введите дату создания Расчета НДФЛ", ЧастиДаты.ДатаВремя) Тогда
			Возврат;
		КонецЕсли;
		
		СоздатьНедостающиеРасчетыНДФЛНаСервере(
				ДатаНачисления,
				ЭтаФорма.Организация,
				ОплатыДивидендов);  //сумма налога считается в Расчете НДФЛ, при необходимости будет деление 13, 15%
		
		КомандаОбновить(Неопределено);
		
	КонецЕсли;

КонецПроцедуры


#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьНадписьНачисленияПлановыеИтого(Форма)
	
	ТекстНадписи = "";
	
	Если Форма.НачисленияПлановые.Количество() > 0 Тогда
		
		ИтогоКоличество       = 0;
		ИтогоСуммаОбъявленная = 0;
		
		Для каждого СтрокаНачисленияПлановые Из Форма.НачисленияПлановые Цикл
			ИтогоКоличество       = ИтогоКоличество       + СтрокаНачисленияПлановые.Количество;
			ИтогоСуммаОбъявленная = ИтогоСуммаОбъявленная + СтрокаНачисленияПлановые.СуммаОбъявленная;
		КонецЦикла;
		
		ТекстНадписи = "Итого " + ИтогоКоличество + " " + РаботаСКорзинойЦенныхБумагКлиентСервер.ФормаМножественногоЧислаЦеннойБумаги(ИтогоКоличество, ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Акции"))
			+ " на сумму " + ИтогоСуммаОбъявленная;
		
	КонецЕсли;
	
	Форма.Элементы.НадписьНачисленияПлановыеИтого.Заголовок = ТекстНадписи;
	
КонецПроцедуры // ОбновитьНадписьНачисленияПлановыеИтого

&НаСервере
Процедура СоздатьНедостающиеОплатыПоНачислениямДивидендов(Период, Организация, Контрагент, НачисленияДивидендов, ВидЗадолженности, СуммаЗаВычетомНДФЛ = Ложь)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Период КАК Дата,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход) КАК ВидДвижения,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК ВалютаОплаты,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Организация КАК Организация,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание.Брокер КАК Брокер,
		|	ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок) КАК МестоХранения,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание.РасчетныйСчет КАК РасчетныйСчет,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
		|	&Контрагент КАК Контрагент,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК Сумма,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК СуммаОплаты
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			,
		|			Организация = &Организация
		|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|				И ВидЗадолженности = &ВидЗадолженности
		|				И Основание В (&Основание)) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток > 0";
		
	Запрос.УстановитьПараметр("ВидЗадолженности", 	ВидЗадолженности);	
	Запрос.УстановитьПараметр("Период",      	  	Период);
	Запрос.УстановитьПараметр("Организация", 		Организация);
	Запрос.УстановитьПараметр("Контрагент",  		Контрагент);
	Запрос.УстановитьПараметр("Основание",   		НачисленияДивидендов);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создание оплат не требуется");
		Возврат;
		
	КонецЕсли; 
	
	Пока Выборка.Следующий() Цикл
		
		Документ = Документы.Оплата.СоздатьДокумент();
		
		Документ.Ответственный = РаботаСПользователями.ТекущийПользователь();
			
		ЗаполнитьЗначенияСвойств(Документ, Выборка);//.СчетДоверительногоУправления);
		Документ.Дата = Период;
		
		НоваяСтрока = Документ.Основания.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		Если СуммаЗаВычетомНДФЛ Тогда 
			НоваяСтрока.СуммаОплаты = НоваяСтрока.Сумма - РаботаСНалогамиКлиентСервер.РассчитатьНалогСДивидендов(НоваяСтрока.Сумма, Выборка.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления, Д1, Д2);
		КонецЕсли;	
		
		
		Если Не Документ.ПроверитьЗаполнение() Тогда
			Продолжить;
		КонецЕсли;
		
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + Документ.Ссылка, Документ.Ссылка);

	КонецЦикла;
	
КонецПроцедуры // СоздатьНедостающиеОплатыПоНачислениямДивидендов

&НаСервере
Функция ЗаполнитьСозданныеНачисленияДивидендовНаСервере()
	
	НачисленияСозданные.ПолучитьЭлементы().Очистить();
	
	НачисленияСозданныеНаСервере = РеквизитФормыВЗначение("НачисленияСозданные");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НачислениеДивидендов.Ссылка КАК Документ,
		|	ВЫБОР
		|		КОГДА НачислениеДивидендов.Проведен
		|			ТОГДА 1
		|		КОГДА НачислениеДивидендов.ПометкаУдаления
		|			ТОГДА 0
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК СостояниеДокумента,
		|	ВЫБОР
		|		КОГДА НачислениеДивидендов.ПометкаУдаления
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ИсключатьИзРасчетов,
		|	НачислениеДивидендов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НачислениеДивидендов.СчетДоверительногоУправления КАК Объект,
		|	НачислениеДивидендов.Брокер КАК Брокер,
		|	НачислениеДивидендов.РасчетныйСчет КАК РасчетныйСчет,
		|	НачислениеДивидендов.Количество КАК Количество,
		|	НачислениеДивидендов.СуммаОбъявленная КАК СуммаОбъявленная,
		|	НачислениеДивидендов.ПроцентНалога КАК ПроцентНалога,
		|	НачислениеДивидендов.Сумма КАК Сумма,
		|	НачислениеДивидендов.ВалютаОплаты КАК ВалютаОплаты,
		|	НачислениеДивидендов.ДивидендыНаЦеннуюБумагу КАК ДивидендыНаЦеннуюБумагу,
		|	НачислениеДивидендов.ДатаПубликации КАК ДатаПубликации,
		|	НачислениеДивидендов.ДатаОплатыПлановая КАК ДатаОплатыПлановая,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК ИдСобытия
		|ИЗ
		|	Документ.НачислениеДивидендов КАК НачислениеДивидендов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.НРД)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.КорпоративноеСобытиеПоВыплатеДивидендов)) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО НачислениеДивидендов.Ссылка = КодыВоВнешнихСистемахСрезПоследних.Объект
		|ГДЕ
		|	НачислениеДивидендов.Организация = &Организация
		|	И НачислениеДивидендов.ЦеннаяБумага = &ЦеннаяБумага
		|	И НАЧАЛОПЕРИОДА(НачислениеДивидендов.Дата, ДЕНЬ) = &Дата
		|	И НачислениеДивидендов.ДатаРеестра = &ДатаРеестра
		|	И КодыВоВнешнихСистемахСрезПоследних.Код = &ИдСобытия";
		
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("ЦеннаяБумага",ЭтаФорма.ЦеннаяБумага);
	Запрос.УстановитьПараметр("Дата",        ЭтаФорма.Дата);
	Запрос.УстановитьПараметр("ДатаРеестра", ЭтаФорма.ДатаРеестра);
	Запрос.УстановитьПараметр("ИдСобытия", 	 ЭтаФорма.ИдСобытия);
	
	НачисленияДивидендов = Запрос.Выполнить().Выгрузить();
	
	// получим и перенесем на форму начисления дивидендов с оплатами
	ОбработанныеНачисления = Новый Массив();
	
	
