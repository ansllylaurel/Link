
&НаСервере
Процедура ВосстановитьПоследовательностьНаСервере(_СчетДоверительногоУправления)
	
	Ошибки = Новый Массив;
	
	Обработки.ВосстановлениеПоследовательностей.ВосстановитьПоследовательность(
		ЭтаФорма.ОграничитьТочкуАктуальностиДатой,
		ЭтаФорма.Организация,
		_СчетДоверительногоУправления,
		ЭтаФорма.СпособВосстановленияПоследовательности,
		Ошибки
	);
	
	Если Ошибки.Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не удалось восстановить последовательность по {" + ЭтаФорма.Организация + ", " + _СчетДоверительногоУправления + "}"
				+ ?(ЭтаФорма.СпособВосстановленияПоследовательности = 2, ". Найдены отрицательные остатки:", "")
		);
	КонецЕсли;
	
	Для каждого Ошибка Из Ошибки Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Символы.Таб + Ошибка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьГраницыПоследовательностиНаСервере()
	
	ЭтаФорма.ГраницыПоследовательности.Очистить();
	
	Отбор = Новый Структура("Период, Организация, СчетДоверительногоУправления",
		ЭтаФорма.ОграничитьТочкуАктуальностиДатой,
		ЭтаФорма.Организация, 
		ЭтаФорма.СчетДоверительногоУправления
	);
	
	СостояниеПоследовательности = Обработки.ВосстановлениеПоследовательностей.ПолучитьСостояниеПоследовательности(Отбор, 2, ЭтаФорма.ИмяПоследовательности);
	
	Если ЭтаФорма.ФлажокНеВыводитьВосстановленныеПоследовательностиСТочкойАктуальностиРанееДаты Тогда
		Для каждого СтрокаСостояниеПоследовательности Из СостояниеПоследовательности Цикл
			Если СтрокаСостояниеПоследовательности.Восстановлена
					И СтрокаСостояниеПоследовательности.ТочкаАктуальности_Период < ЭтаФорма.НеВыводитьВосстановленныеПоследовательностиСТочкойАктуальностиРанееДаты
			Тогда
				Продолжить;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(ЭтаФорма.ГраницыПоследовательности.Добавить(), СтрокаСостояниеПоследовательности);
		КонецЦикла;
	Иначе
		ЭтаФорма.ГраницыПоследовательности.Загрузить(СостояниеПоследовательности);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеГраницыПоследовательностиНаСервере(_СчетДоверительногоУправления)
	
	ДанныеГраницыПоследовательностиПоСчетуДУ = Новый Структура;
	
	Отбор = Новый Структура("Период, Организация, СчетДоверительногоУправления",
		ЭтаФорма.ОграничитьТочкуАктуальностиДатой,
		ЭтаФорма.Организация,
		_СчетДоверительногоУправления);
	
	СостояниеПоследовательностиПоСчетуДУ = Обработки.ВосстановлениеПоследовательностей.ПолучитьСостояниеПоследовательности(Отбор, 2, ЭтаФорма.ИмяПоследовательности);
	
	Если СостояниеПоследовательностиПоСчетуДУ.Количество() > 0 Тогда
		
		Для каждого Колонка Из СостояниеПоследовательностиПоСчетуДУ.Колонки Цикл
			ДанныеГраницыПоследовательностиПоСчетуДУ.Вставить(Колонка.Имя, СостояниеПоследовательностиПоСчетуДУ[0][Колонка.Имя]);
		КонецЦикла;
		
	КонецЕсли;
		
	Возврат ДанныеГраницыПоследовательностиПоСчетуДУ;
	
КонецФункции

#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЭтаФорма.ИмяПоследовательности = "ОперацииПоСчетуДоверительногоУправления";
	
	ЭтаФорма.ОтборПоСчетуДоверительногоУправления = ЗначениеЗаполнено(ЭтаФорма.СчетДоверительногоУправления);
	Элементы.СчетДоверительногоУправления.Видимость = ЭтаФорма.ОтборПоСчетуДоверительногоУправления;
	
	ЭтаФорма.СпособВосстановленияПоследовательности = 2; // через контроль отриц. остатков
	Элементы.СпособВосстановленияПоследовательности.Доступность = Ложь; // оставим для истории, но пользоваться этим больше не стоит
	
	ЭтаФорма.ФлажокОграничитьТочкуАктуальностиДатой  = Истина;
	ЭтаФорма.ОграничитьТочкуАктуальностиДатой = (ТекущаяДата() - 86400);
	
	ЭтаФорма.ФлажокНеВыводитьВосстановленныеПоследовательностиСТочкойАктуальностиРанееДаты = Истина;
	ЭтаФорма.НеВыводитьВосстановленныеПоследовательностиСТочкойАктуальностиРанееДаты = (ТекущаяДата() - 30*86400);

	Если Вопрос("Заполнить таблицу с границами последовательности в соответствии с установленными отборами?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		ОбновитьГраницыПоследовательностиНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтаФорма.ОтборПоСчетуДоверительногоУправления И Не ЗначениеЗаполнено(ЭтаФорма.СчетДоверительногоУправления) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Счет доверительного управления"" не заполнено",, "СчетДоверительногоУправления");
	КонецЕсли;
	
	Если ЭтаФорма.ФлажокОграничитьТочкуАктуальностиДатой И Не ЗначениеЗаполнено(ЭтаФорма.ОграничитьТочкуАктуальностиДатой) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Точка актуальности"" не заполнено",, "ОграничитьТочкуАктуальностиДатой");
	КонецЕсли;
	
	Если ЭтаФорма.ФлажокНеВыводитьВосстановленныеПоследовательностиСТочкойАктуальностиРанееДаты И
			Не ЗначениеЗаполнено(ЭтаФорма.НеВыводитьВосстановленныеПоследовательностиСТочкойАктуальностиРанееДаты)
	Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Точка актуальности"" не заполнено",, "НеВыводитьВосстановленныеПоследовательностиСТочкойАктуальностиРанееДаты");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область События_элементов

&НаКлиенте
Процедура ОтборПоСчетуДоверительногоУправленияПриИзменении(Элемент)
	
	Элементы.СчетДоверительногоУправления.Видимость = ЭтаФорма.ОтборПоСчетуДоверительногоУправления;
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.СчетДоверительногоУправления) Тогда 
		Возврат; // фактически без отбора по счету д/у, значит, ничего не поменялось
	КонецЕсли;
	
	Если Не ЭтаФорма.ОтборПоСчетуДоверительногоУправления Тогда
		ЭтаФорма.СчетДоверительногоУправления = Неопределено;
	КонецЕсли;
	
	ОбновитьГраницыПоследовательностиНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	ОбновитьГраницыПоследовательностиНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ГраницыПоследовательностиПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекущиеДанные = Элементы.ГраницыПоследовательности.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяКолонка = Элементы.ГраницыПоследовательности.ТекущийЭлемент;
	
	Если      ТекущаяКолонка = Элементы.ГраницыПоследовательностиСчетДоверительногоУправления Тогда
		
		ОткрытьЗначение(ТекущиеДанные.СчетДоверительногоУправления);
		
	ИначеЕсли ТекущаяКолонка = Элементы.ГраницыПоследовательностиГраницаРегистратор Тогда
		
		ОткрытьЗначение(ТекущиеДанные.ГраницаПоследовательности_Регистратор);
		
	ИначеЕсли ТекущаяКолонка = Элементы.ГраницыПоследовательностиТочкаАктуальностиРегистратор Тогда
		
		ОткрытьЗначение(ТекущиеДанные.ТочкаАктуальности_Регистратор);
		
	ИначеЕсли ТекущаяКолонка = Элементы.ГраницыПоследовательностиВосстановить И Не ТекущиеДанные.Восстановлена Тогда
		
		Если Вопрос("Восстановить последовательность документов по клиенту " + ТекущиеДанные.СчетДоверительногоУправления + "?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		
		ВосстановитьПоследовательностьНаСервере(ТекущиеДанные.СчетДоверительногоУправления);
		
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, ПолучитьДанныеГраницыПоследовательностиНаСервере(ТекущиеДанные.СчетДоверительногоУправления));
		
	ИначеЕсли ТекущаяКолонка = Элементы.ГраницыПоследовательностиСостав Тогда
		
		ОткрытьФорму("Обработка.ВосстановлениеПоследовательностей.Форма.ДокументыПоследовательности",
			Новый Структура("Организация, СчетДоверительногоУправления, ОграничитьДатой",
				ЭтаФорма.Организация,
				ТекущиеДанные.СчетДоверительногоУправления,
				ЭтаФорма.ОграничитьТочкуАктуальностиДатой
			),
			ЭтаФорма);
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФлажокОграничитьТочкуАктуальностиДатойПриИзменении(Элемент)

	Элементы.ОграничитьТочкуАктуальностиДатой.Видимость = ЭтаФорма.ФлажокОграничитьТочкуАктуальностиДатой;
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.ОграничитьТочкуАктуальностиДатой) Тогда 
		Возврат; // фактически без ограничения границы, значит, ничего не поменялось
	КонецЕсли;
	
	Если Не ЭтаФорма.ОграничитьГраницуПоследовательности Тогда
		ЭтаФорма.ОграничитьТочкуАктуальностиДатой = Неопределено;
	КонецЕсли;
	
	ОбновитьГраницыПоследовательностиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОграничитьТочкуАктуальностиДатойПриИзменении(Элемент)
	
	ОбновитьГраницыПоследовательностиНаСервере();

КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаОбновить(Команда)
	
	ОбновитьГраницыПоследовательностиНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВосстановитьВсе(Команда)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если Вопрос("Восстановить невосстановленные последовательности по всем счетам д/у? Процесс может занять продолжительное время.", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаГраницыПоследовательности Из ГраницыПоследовательности Цикл
		Если Не СтрокаГраницыПоследовательности.Восстановлена Тогда
			ВосстановитьПоследовательностьНаСервере(СтрокаГраницыПоследовательности.СчетДоверительногоУправления);
		КонецЕсли;
	КонецЦикла;
	
	ОбновитьГраницыПоследовательностиНаСервере();
	
КонецПроцедуры

#КонецОбласти
