
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Организация = ПараметрыСеанса.ТекущаяОрганизация;
	ЭтаФорма.Сервер_1Ф = ?(ПараметрыСеанса.ЭтоРабочаяИнформационнаяБаза, "1f", "test1f") + ".g1.lan"; 
		
	ОбновитьНаСервере();
	
	Если ТипЗнч(ЭтаФорма.ДопСвойства) = Тип("Структура") И ЭтаФорма.ДопСвойства.Свойство("ОшибкаПолученияДанныхПервойФормы") Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	СообщитьОбОшибках();
		
КонецПроцедуры 

&НаСервере
Процедура ОбновитьНаСервере(ПараметрыПодключения = Неопределено) 
	
	НоваяСессия = (ПараметрыПодключения = Неопределено);
	
	Если НоваяСессия Тогда
		
		ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
		ПараметрыСессии = Новый Структура("Организация, Сервер", ЭтаФорма.Организация, ЭтаФорма.Сервер_1Ф);
		
		ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектНаСервере,, ПараметрыСессии);
		
		Механизм = ОбъектНаСервере.Метаданные().ПолноеИмя() + ".Форма.СозданиеЗадачДляПервойФормы.ОбновитьНаСервере().";
		Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			Механизм,
			ПараметрыВыполненияДляСбораСтатистики.Хранилище,
			ПараметрыВыполненияДляСбораСтатистики.Описание);
			
	КонецЕсли;
	
	ЭтаФорма.ПараметрыЗадач.Очистить(); 
	ЭтаФорма.ДопСвойства = Новый Структура("Ошибки", Новый Массив);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДатаСеанса())); 
	
#Область Текст_Запроса	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокРаспоряжение.Организация КАК Организация,
		|	ДокРаспоряжение.Ссылка КАК Ссылка,
		|	ДокРаспоряжение.ПометкаУдаления КАК ПометкаУдаления,
		|	ДокРаспоряжение.ДатаРазмещения КАК ДатаРазмещения,
		|	ДокРаспоряжение.Банк КАК Банк,
		|	ДокРаспоряжение.Банк.ЮрФизЛицо КАК ЮрЛицоБанка,
		|	ДокРаспоряжение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДокРаспоряжение.СчетДоверительногоУправления.КодСчета КАК КодСчета,
		|	ДокРаспоряжение.Сумма КАК Сумма,
		|	ДокРаспоряжение.Процент КАК Процент,
		|	ДокРаспоряжение.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
		|	ДокРаспоряжение.ДоВостребования КАК ДоВостребования,
		|	ДокРаспоряжение.ДатаВозврата КАК ДатаВозврата,
		|	НомераТранзакций.Номер КАК НомерЗадачи,
		|	НомераТранзакций.Ключ КАК Ключ
		|ПОМЕСТИТЬ _ДанныеРаспоряжений
		|ИЗ
		|	Документ.Распоряжение КАК ДокРаспоряжение
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераТранзакций КАК НомераТранзакций
		|		ПО ДокРаспоряжение.Ссылка = НомераТранзакций.Субъект
		|			И (НомераТранзакций.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФорма))
		|ГДЕ
		|	ДокРаспоряжение.Организация = &Организация
		|	И НЕ ДокРаспоряжение.ПометкаУдаления
		|	И ДокРаспоряжение.ДатаРазмещения >= &ТекущаяДата
		|	И ДокРаспоряжение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеРаспоряжений.Банк КАК Банк,
		|	_ДанныеРаспоряжений.ЮрЛицоБанка КАК ЮрЛицоБанка,
		|	_ДанныеРаспоряжений.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _КонтрагентыГенСоглашений
		|ИЗ
		|	_ДанныеРаспоряжений КАК _ДанныеРаспоряжений
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ДанныеРаспоряжений.Банк,
		|	СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо,
		|	_ДанныеРаспоряжений.СчетДоверительногоУправления
		|ИЗ
		|	_ДанныеРаспоряжений КАК _ДанныеРаспоряжений
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(
		|				&ТекущаяДата,
		|				ЮридическоеЛицо В
		|						(ВЫБРАТЬ
		|							_ДанныеРаспоряжений.ЮрЛицоБанка
		|						ИЗ
		|							_ДанныеРаспоряжений КАК _ДанныеРаспоряжений)
		|					И ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО _ДанныеРаспоряжений.ЮрЛицоБанка = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_КонтрагентыГенСоглашений.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_КонтрагентыГенСоглашений.Банк КАК Банк
		|ПОМЕСТИТЬ _ГенСоглашения
		|ИЗ
		|	_КонтрагентыГенСоглашений КАК _КонтрагентыГенСоглашений
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
		|				&ТекущаяДата,
		|				Организация = &Организация
		|					И (СчетДоверительногоУправления, ВЫРАЗИТЬ(Договор КАК Справочник.Договоры).Контрагент) В
		|						(ВЫБРАТЬ
		|							_КонтрагентыГенСоглашений.СчетДоверительногоУправления,
		|							_КонтрагентыГенСоглашений.ЮрЛицоБанка
		|						ИЗ
		|							_КонтрагентыГенСоглашений КАК _КонтрагентыГенСоглашений)
		|					И ВЫРАЗИТЬ(Договор КАК Справочник.Договоры).ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ГенСоглашениеПоДепозитнымВкладам)) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(
		|					&ТекущаяДата,
		|					Организация = &Организация
		|						И ВЫРАЗИТЬ(Договор КАК Справочник.Договоры).ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ГенСоглашениеПоДепозитнымВкладам)) КАК УсловияДоговоровОбщиеСрезПоследних
		|			ПО ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор = УсловияДоговоровОбщиеСрезПоследних.Договор
		|		ПО _КонтрагентыГенСоглашений.СчетДоверительногоУправления = ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|			И (ДоговорыСчетовДоверительногоУправленияСрезПоследних.Организация = &Организация)
		|			И (_КонтрагентыГенСоглашений.ЮрЛицоБанка = ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).Контрагент)
		|ГДЕ
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.Активный
		|	И (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &ТекущаяДата)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеРаспоряжений.Банк КАК Банк,
		|	КодыВоВнешнихСистемах.Объект КАК Объект,
		|	КодыВоВнешнихСистемах.Код КАК Код,
		|	КодыВоВнешнихСистемах.ВнешняяСистема КАК ВнешняяСистема
		|ПОМЕСТИТЬ _КодыВоВнешнихСистемах
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&ТекущаяДата,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФорма)
		|					И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Организации), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица))
		|				ИЛИ ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)
		|					И Объект В
		|						(ВЫБРАТЬ
		|							_ДанныеРаспоряжений.ЮрЛицоБанка
		|						ИЗ
		|							_ДанныеРаспоряжений КАК _ДанныеРаспоряжений)) КАК КодыВоВнешнихСистемах
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеРаспоряжений КАК _ДанныеРаспоряжений
		|		ПО КодыВоВнешнихСистемах.Объект = _ДанныеРаспоряжений.ЮрЛицоБанка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеРаспоряжений.Ссылка КАК Распоряжение,
		|	ПерваяФормаКодыУК.Код КАК ПерваяФормаКодУК,
		|	_ДанныеРаспоряжений.НомерЗадачи КАК НомерЗадачи,
		|	_ДанныеРаспоряжений.Ключ КАК Ключ,
		|	_ДанныеРаспоряжений.ДатаРазмещения КАК ДатаРазмещения,
		|	_ДанныеРаспоряжений.Банк КАК Банк,
		|	_ДанныеРаспоряжений.ЮрЛицоБанка КАК ЮрЛицоБанка,
		|	ПерваяФормаКодыЮрЛицБанков.Код КАК ПерваяФормаКодЮрЛицаБанка,
		|	КодыМатрихЮрЛицБанков.Код КАК КодМатриксЮрЛицаБанка,
		|	_ДанныеРаспоряжений.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДанныеРаспоряжений.КодСчета КАК КодСчета,
		|	_ДанныеРаспоряжений.Сумма КАК Сумма,
		|	_ДанныеРаспоряжений.Процент КАК Ставка,
		|	РАЗНОСТЬДАТ(_ДанныеРаспоряжений.ДатаРазмещения, _ДанныеРаспоряжений.ДатаВозврата, ДЕНЬ) КАК Срок,
		|	_ДанныеРаспоряжений.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
		|	_ДанныеРаспоряжений.ДоВостребования КАК ДоВостребования,
		|	_ДанныеРаспоряжений.ДатаВозврата КАК ДатаВозврата,
		|	ВЫБОР
		|		КОГДА _ГенСоглашения.Банк ЕСТЬ NULL
		|			ТОГДА ""Разовый договор""
		|		ИНАЧЕ ""Ген. соглашение""
		|	КОНЕЦ КАК ВидДоговора
		|ПОМЕСТИТЬ _ДанныеУчетнойСистемы
		|ИЗ
		|	_ДанныеРаспоряжений КАК _ДанныеРаспоряжений
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГенСоглашения КАК _ГенСоглашения
		|		ПО _ДанныеРаспоряжений.СчетДоверительногоУправления = _ГенСоглашения.СчетДоверительногоУправления
		|			И _ДанныеРаспоряжений.Банк = _ГенСоглашения.Банк
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВоВнешнихСистемах КАК ПерваяФормаКодыУК
		|		ПО _ДанныеРаспоряжений.Организация = ПерваяФормаКодыУК.Объект
		|			И (ПерваяФормаКодыУК.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФорма))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВоВнешнихСистемах КАК ПерваяФормаКодыЮрЛицБанков
		|		ПО _ДанныеРаспоряжений.ЮрЛицоБанка = ПерваяФормаКодыЮрЛицБанков.Объект
		|			И (ПерваяФормаКодыЮрЛицБанков.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФорма))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВоВнешнихСистемах КАК КодыМатрихЮрЛицБанков
		|		ПО _ДанныеРаспоряжений.ЮрЛицоБанка = КодыМатрихЮрЛицБанков.Объект
		|			И (КодыМатрихЮрЛицБанков.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ПараметрыСозданныхЗадач.НомерЗадачи КАК НомерЗадачи,
		|	_ПараметрыСозданныхЗадач.Ключ КАК Ключ,
		|	_ДанныеПорученийБезЗадач.ДатаРазмещения КАК ДатаРазмещения,
		|	_ДанныеПорученийБезЗадач.ВидДоговора КАК ВидДоговора,
		|	_ДанныеПорученийБезЗадач.ЮрЛицоБанка КАК ЮрЛицоБанка,
		|	_ДанныеПорученийБезЗадач.Банк КАК Банк
		|ПОМЕСТИТЬ _ОсновныеПараметры
		|ИЗ
		|	_ДанныеУчетнойСистемы КАК _ДанныеПорученийБезЗадач
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			_ДанныеУчетнойСистемы.НомерЗадачи КАК НомерЗадачи,
		|			_ДанныеУчетнойСистемы.Ключ КАК Ключ,
		|			_ДанныеУчетнойСистемы.ДатаРазмещения КАК ДатаРазмещения,
		|			_ДанныеУчетнойСистемы.ВидДоговора КАК ВидДоговора,
		|			_ДанныеУчетнойСистемы.ЮрЛицоБанка КАК ЮрЛицоБанка
		|		ИЗ
		|			_ДанныеУчетнойСистемы КАК _ДанныеУчетнойСистемы
		|		ГДЕ
		|			НЕ _ДанныеУчетнойСистемы.НомерЗадачи ЕСТЬ NULL) КАК _ПараметрыСозданныхЗадач
		|		ПО _ДанныеПорученийБезЗадач.ДатаРазмещения = _ПараметрыСозданныхЗадач.ДатаРазмещения
		|			И _ДанныеПорученийБезЗадач.ВидДоговора = _ПараметрыСозданныхЗадач.ВидДоговора
		|			И _ДанныеПорученийБезЗадач.ЮрЛицоБанка = _ПараметрыСозданныхЗадач.ЮрЛицоБанка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеУчетнойСистемы.КодМатриксЮрЛицаБанка КАК КодМатрикс,
		|	_ДанныеУчетнойСистемы.ЮрЛицоБанка КАК ЮрЛицоБанка
		|ПОМЕСТИТЬ _КодыЮрЛицБанков
		|ИЗ
		|	_ДанныеУчетнойСистемы КАК _ДанныеУчетнойСистемы
		|ГДЕ
		|	_ДанныеУчетнойСистемы.ПерваяФормаКодЮрЛицаБанка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ОсновныеПараметры.НомерЗадачи КАК НомерЗадачи
		|ИЗ
		|	_ОсновныеПараметры КАК _ОсновныеПараметры
		|ГДЕ
		|	НЕ _ОсновныеПараметры.НомерЗадачи ЕСТЬ NULL";
#КонецОбласти
	
