#КонецОбласти
	
	Запрос.УстановитьПараметр("ПараметрыЗадач", ПриемникДанных.ПараметрыЗадач);
	Запрос.УстановитьПараметр("ТабличныеДанные", ПриемникДанных.ТабличныеДанные); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОшибок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиСоответствияДанных"].ПолучитьДанные().Выбрать();
	
	Пока ВыборкаОшибок.Следующий() Цикл
		ЭтаФорма.ДопСвойства.Ошибки.Добавить(СтрШаблон(ВыборкаОшибок.ТекстСообщения, ВыборкаОшибок.НомерЗадачи, ВыборкаОшибок.Параметр));  	
	КонецЦикла;
	
	ВыборкаОшибок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиОпределенияРаспоряжений"].ПолучитьДанные().Выбрать();
	
	Пока ВыборкаОшибок.Следующий() Цикл
		ЭтаФорма.ДопСвойства.Ошибки.Добавить(СтрШаблон(ВыборкаОшибок.ТекстСообщения, ВыборкаОшибок.НомерЗадачи, ВыборкаОшибок.П2, ВыборкаОшибок.П3, ВыборкаОшибок.П4, Формат(ВыборкаОшибок.П5, "ДФ=dd.MM.yyyy")));  	
	КонецЦикла;
	
	ВыборкаГруппировкаПоБанку = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаГруппировкаПоБанку.Следующий() Цикл
		
		ВыборкаГруппировкаПоДатеРазмещения = ВыборкаГруппировкаПоБанку.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаГруппировкаПоДатеРазмещения.Следующий() Цикл
			
			ВыборкаГруппировкаПоВидуДоговора = ВыборкаГруппировкаПоДатеРазмещения.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаГруппировкаПоВидуДоговора.Следующий() Цикл
				
				ВыборкаДетальныхЗаписей = ВыборкаГруппировкаПоВидуДоговора.Выбрать(); 	
		
				НомерСтроки = 1;
				
				Пока ВыборкаДетальныхЗаписей.Следующий() Цикл 
								
					Если НомерСтроки = 1 Тогда
		
						СтрокаПараметрыЗадач = ЭтаФорма.ПараметрыЗадач.Добавить();
						СтрокаПараметрыЗадач.СтатусКартинка = ВыборкаДетальныхЗаписей.Статус;
						СтрокаПараметрыЗадач.ДатаРазмещения = ВыборкаДетальныхЗаписей.ДатаРазмещения;
						СтрокаПараметрыЗадач.Банк = ВыборкаДетальныхЗаписей.Банк; 
						СтрокаПараметрыЗадач.ВидДоговора = ВыборкаДетальныхЗаписей.ВидДоговора;
						СтрокаПараметрыЗадач.НомерЗадачи = ВыборкаДетальныхЗаписей.НомерЗадачи;
						СтрокаПараметрыЗадач.СтатусПервойФормы = ВыборкаДетальныхЗаписей.Статус_1Ф;
	
					КонецЕсли;
					
					Если ЗначениеЗаполнено(ВыборкаДетальныхЗаписей.Распоряжение) Тогда

						СформироватьДанныеДляЭкспорта(СтрокаПараметрыЗадач, ВыборкаДетальныхЗаписей);

						НоваяСтрокаДанныеРаспоряжений = СтрокаПараметрыЗадач.ДанныеРаспоряжений.Добавить();
						НоваяСтрокаДанныеРаспоряжений.Статус = ВыборкаДетальныхЗаписей.Статус;
						НоваяСтрокаДанныеРаспоряжений.СчетДоверительногоУправления = ВыборкаДетальныхЗаписей.СчетДоверительногоУправления;
						НоваяСтрокаДанныеРаспоряжений.КодСчета = ВыборкаДетальныхЗаписей.КодСчета;
			            НоваяСтрокаДанныеРаспоряжений.Сумма = ВыборкаДетальныхЗаписей.Сумма;
			            НоваяСтрокаДанныеРаспоряжений.Ставка = ВыборкаДетальныхЗаписей.Ставка;
			            НоваяСтрокаДанныеРаспоряжений.Срок = ВыборкаДетальныхЗаписей.Срок;
			            НоваяСтрокаДанныеРаспоряжений.ПериодичностьВыплатыПроцентов = ВыборкаДетальныхЗаписей.ПериодичностьВыплатыПроцентов;
						НоваяСтрокаДанныеРаспоряжений.ДоВостребования = ВыборкаДетальныхЗаписей.ДоВостребования;
			            НоваяСтрокаДанныеРаспоряжений.ДатаВозврата = ВыборкаДетальныхЗаписей.ДатаВозврата;
						НоваяСтрокаДанныеРаспоряжений.Распоряжение = ВыборкаДетальныхЗаписей.Распоряжение; 
												
					КонецЕсли;
					
					Если ЗначениеЗаполнено(ВыборкаДетальныхЗаписей.НомерЗадачи_1Ф) Тогда
						
						НоваяСтрокаДанныеПервойФормы = СтрокаПараметрыЗадач.ТабличныеДанныеПервойФормы.Добавить();
						НоваяСтрокаДанныеПервойФормы.Статус = ВыборкаДетальныхЗаписей.Статус;
						НоваяСтрокаДанныеПервойФормы.СчетДоверительногоУправления = ВыборкаДетальныхЗаписей.СчетДоверительногоУправления;
						НоваяСтрокаДанныеПервойФормы.КодСчета = ВыборкаДетальныхЗаписей.КодСчета;
			            НоваяСтрокаДанныеПервойФормы.Сумма = ВыборкаДетальныхЗаписей.Сумма_1Ф;
			            НоваяСтрокаДанныеПервойФормы.Ставка = ВыборкаДетальныхЗаписей.Ставка_1Ф;
			            НоваяСтрокаДанныеПервойФормы.Срок = ВыборкаДетальныхЗаписей.Срок_1Ф;
			            НоваяСтрокаДанныеПервойФормы.ПериодичностьВыплатыПроцентов = ВыборкаДетальныхЗаписей.ПериодичностьВыплатыПроцентов_1Ф;
						НоваяСтрокаДанныеПервойФормы.ДоВостребования = ВыборкаДетальныхЗаписей.ДоВостребования_1Ф;
						НоваяСтрокаДанныеПервойФормы.ДатаРазмещения = ВыборкаДетальныхЗаписей.ДатаРазмещения_1Ф;
			            НоваяСтрокаДанныеПервойФормы.ДатаВозврата = ВыборкаДетальныхЗаписей.ДатаВозврата_1Ф;
						
					КонецЕсли;
					
					НомерСтроки = НомерСтроки + 1;
					
				КонецЦикла;
				
			КонецЦикла;	
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если НоваяСессия Тогда	
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);	
	КонецЕсли;
	
КонецПроцедуры 

&НаСервереБезКонтекста
Функция СоздатьСтруктуруДляИмпортаДанных()
	
	ПараметрыЗадач = Новый ТаблицаЗначений;
	ПараметрыЗадач.Колонки.Добавить("НомерЗадачи", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ПараметрыЗадач.Колонки.Добавить("КодУК", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(55)));
	ПараметрыЗадач.Колонки.Добавить("КодБанка", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(55)));
	ПараметрыЗадач.Колонки.Добавить("ВидДоговора", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	ПараметрыЗадач.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ПараметрыЗадач.Колонки.Добавить("Закрыта", Новый ОписаниеТипов("Булево"));
	ПараметрыЗадач.Колонки.Добавить("ЕстьОшибки",Новый ОписаниеТипов("Булево"));
	
	ТабличныеДанные = Новый ТаблицаЗначений;
	ТабличныеДанные.Колонки.Добавить("НомерЗадачи", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ТабличныеДанные.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0)));
	ТабличныеДанные.Колонки.Добавить("КодСчета", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25)));	
	ТабличныеДанные.Колонки.Добавить("Сумма", Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип.Типы()));
	ТабличныеДанные.Колонки.Добавить("Ставка", Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип.Типы()));
	ТабличныеДанные.Колонки.Добавить("Срок", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0)));
	ТабличныеДанные.Колонки.Добавить("ПериодичностьВыплатыПроцентов", Новый ОписаниеТипов("ПеречислениеСсылка.ПериодичностиВыплатыПроцентов"));
	ТабличныеДанные.Колонки.Добавить("ДоВостребования", Новый ОписаниеТипов("Булево"));
	ТабличныеДанные.Колонки.Добавить("ДатаРазмещения", Новый ОписаниеТипов("Дата"));
	ТабличныеДанные.Колонки.Добавить("ДатаВозврата", Новый ОписаниеТипов("Дата"));
	
	Возврат Новый Структура("ПараметрыЗадач, ТабличныеДанные", ПараметрыЗадач, ТабличныеДанные); 
	
КонецФункции 

&НаСервереБезКонтекста
Процедура ПолучитьДанныеПервойФормы(ПриемникДанных, ПараметрыПодключения, МассивНомеровЗадач, ТаблицаЮрЛицБанков, Ошибки) 
		
#Область Задачи		
	Для Каждого НомерЗадачи Из  МассивНомеровЗадач Цикл
		
		ПараметрыЗадачНоваяСтрока = ПриемникДанных.ПараметрыЗадач.Добавить();
		ПараметрыЗадачНоваяСтрока.НомерЗадачи = НомерЗадачи;
		
		ТелоЗапроса = ПолучитьЗаписьJSON(Новый Структура("taskId, selectedInfoParts", НомерЗадачи, РаботаСКоллекциями.ЗначениеВМассив("ExtParams")));
		
		ТекстСообщения = "Не удалось получить данные по номеру задачи [" + НомерЗадачи + "]";
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks", ТелоЗапроса, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ПараметрыЗадачНоваяСтрока.ЕстьОшибки = Истина;
			Ошибки.Добавить(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		ОбъектЗадача_1Ф = ДесериализоватьJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));	
		
		Если Не (ОбъектЗадача_1Ф.Свойство("subcatID") И ОбъектЗадача_1Ф.subcatID = 524) Тогда
			ПараметрыЗадачНоваяСтрока.ЕстьОшибки = Истина;
			Ошибки.Добавить("Ошибка получения данных из 1-ой формы. По номеру [" + НомерЗадачи + "] найдена задача с категорией [" + ОбъектЗадача_1Ф.subcatDescription + "].");
			Продолжить;	
		КонецЕсли; 
		
		ПараметрыЗадачНоваяСтрока.Закрыта = ОбъектЗадача_1Ф.isClosed;
		ПараметрыЗадачНоваяСтрока.Статус = ОбъектЗадача_1Ф.stateDescription;

		Для Каждого ТекПараметр Из ОбъектЗадача_1Ф.extParams Цикл 
			
			Если ТекПараметр.id = 51 Тогда
				
				ПараметрыЗадачНоваяСтрока.КодУК = Формат(ТекПараметр.value.taskId, "ЧГ=0");
				
			ИначеЕсли ТекПараметр.id = 410 Тогда
				
				ПараметрыЗадачНоваяСтрока.КодБанка = Формат(ТекПараметр.value.taskId, "ЧГ=0"); 
				
			ИначеЕсли ТекПараметр.id = 1538 Тогда
				
				ПараметрыЗадачНоваяСтрока.ВидДоговора = ТекПараметр.value.value;  //Разовый договор, Ген. соглашение 
				
			ИначеЕсли ТекПараметр.id = 1539 И ТекПараметр.value.values.Количество() > 0 Тогда
				
				ТабличныеДанныеНоваяСтрока = ПриемникДанных.ТабличныеДанные.Добавить();
				ТабличныеДанныеНоваяСтрока.НомерЗадачи = НомерЗадачи;
				ТабличныеДанныеНоваяСтрока.НомерСтроки = 1;
				
				Для Каждого ПараметрТабЧасти Из ТекПараметр.value.values Цикл
					
					Если ПараметрТабЧасти.rowId <> ТабличныеДанныеНоваяСтрока.НомерСтроки Тогда 
						
						Если ЗначениеЗаполнено(ТабличныеДанныеНоваяСтрока.ДатаРазмещения) Тогда
							ТабличныеДанныеНоваяСтрока = ПриемникДанных.ТабличныеДанные.Добавить();
						КонецЕсли;
						
						ТабличныеДанныеНоваяСтрока.НомерЗадачи = НомерЗадачи;
						ТабличныеДанныеНоваяСтрока.НомерСтроки = ПараметрТабЧасти.rowId; 
								
					КонецЕсли;
											
					Если ПараметрТабЧасти.columnId = 183 Тогда
						
						ТабличныеДанныеНоваяСтрока.Сумма = Число(СтрЗаменить(ПараметрТабЧасти.value, " ", ""));
					
					ИначеЕсли ПараметрТабЧасти.columnId = 184 Тогда
						
						ТабличныеДанныеНоваяСтрока.Ставка = Число(СтрЗаменить(ПараметрТабЧасти.value, " ", ""));
						
					ИначеЕсли ПараметрТабЧасти.columnId = 185 Тогда
						
						ТабличныеДанныеНоваяСтрока.Срок = Число(СтрЗаменить(ПараметрТабЧасти.value, " ", ""));
		
					ИначеЕсли ПараметрТабЧасти.columnId = 186 Тогда
						
						ТабличныеДанныеНоваяСтрока.ПериодичностьВыплатыПроцентов = ПолучитьВариантПериодичностиВыплатыПроцентов(ПараметрТабЧасти.value.value); //В конце срока/ Ежемесечно/ Авансом/ Иное
						
						Если ТабличныеДанныеНоваяСтрока.ПериодичностьВыплатыПроцентов = Неопределено Тогда
							ПараметрыЗадачНоваяСтрока.ЕстьОшибки = Истина;
							Ошибки.Добавить("Не удалось определить периодичность выплаты процентов на основании данных первой формы [" + ПараметрТабЧасти.value.value + "]");
                        Конецесли;
						
					ИначеЕсли ПараметрТабЧасти.columnId = 187 Тогда 
						
						ТабличныеДанныеНоваяСтрока.ДоВостребования = ПараметрТабЧасти.value.value; //Да/Нет
						
					ИначеЕсли ПараметрТабЧасти.columnId = 188 Тогда
						
						ТабличныеДанныеНоваяСтрока.ДатаРазмещения = Дата(РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(ПараметрТабЧасти.value));
						
					ИначеЕсли ПараметрТабЧасти.columnId = 189 Тогда
						
						ТабличныеДанныеНоваяСтрока.ДатаВозврата = Дата(РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(ПараметрТабЧасти.value));
						
					ИначеЕсли ПараметрТабЧасти.columnId = 346 Тогда
						
	                	ТабличныеДанныеНоваяСтрока.КодСчета = ПараметрТабЧасти.value;
						
					КонецЕсли;	
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;	

	КонецЦикла;
#КонецОбласти

#Область Банки
	ТекстЗапроса = "/api-core/datasource/Subcat/41/data"; 
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("startRow", 0);
	СтруктураЗапроса.Вставить("endRow", 10);
	СтруктураЗапроса.Вставить("select", РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("field, type", "taskId", "numberValue")));
	СтруктураЗапроса.Вставить("tasksState", "isOpened");
	СтруктураЗапроса.Вставить("filterModel", Новый Структура("ExtParam588", Новый Структура("filterType, type, filter", "text", "equals")));
	
    //ищем банк по коду матрикс (категория задач в 1Ф = 41, ID параметра 588)
	Для Каждого Строка Из ТаблицаЮрЛицБанков Цикл
	
		ТекстСообщения = "Не удалось получить код первой формы юр. лица [" + Строка.ЮрЛицоБанка + "] по коду матрикс [" + Строка.КодМатрикс + "]."; 
	
		СтруктураЗапроса.filterModel.ExtParam588.filter = Строка.КодМатрикс; 
				
		ТелоЗапроса = ПолучитьЗаписьJSON(СтруктураЗапроса);
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, ТекстЗапроса, ТелоЗапроса, ТекстСообщения);

		Если HTTPОтвет = Неопределено Тогда
			Ошибки.Добавить(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		РезультатЗапроса = ДесериализоватьJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8")); 
		
		Если Не (РезультатЗапроса.Свойство("totalCount") И РезультатЗапроса.Свойство("tasksDataSourceResponse") И РезультатЗапроса.totalCount = 1) Тогда
			Ошибки.Добавить(ТекстСообщения);
			Продолжить;
		КонецЕсли; 
				
		НомерЗадачи = Формат(РезультатЗапроса.tasksDataSourceResponse[0].taskId, "ЧГ=0");

		УстановитьПривилегированныйРежим(Истина);
				
		Попытка
			
			ЗаписьРегистра = РегистрыСведений.КодыВоВнешнихСистемах.СоздатьМенеджерЗаписи();
			ЗаписьРегистра.Период         = Дата(1980, 1, 1);
			ЗаписьРегистра.ВнешняяСистема = Справочники.ВнешниеСистемы.ПерваяФорма;
			ЗаписьРегистра.ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица;
			ЗаписьРегистра.Объект         = Строка.ЮрЛицоБанка;
			ЗаписьРегистра.Код            = НомерЗадачи;

			ЗаписьРегистра.Записать(); 
							
		Исключение
			
			Ошибки.Добавить("Не удалось записать код [" + НомерЗадачи  + "] внешней системы [1Ф] юр лица [" + Строка.ЮрЛицоБанка + "].");
			Продолжить;
			
		КонецПопытки;
		
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЦикла;
	
#КонецОбласти
	
КонецПроцедуры 

&НаСервере
Процедура СформироватьДанныеДляЭкспорта(СтрокаТаблицы, Выборка)
	
	Если СтрокаТаблицы.ДанныеДляЭкспорта = Неопределено Тогда
		
		ДанныеДляЭкспорта = Новый Структура("ОсновнаяЧасть, ТабличнаяЧасть, Ключ, Распоряжения");
		
		ТекстЗадачи = "УК: " + Выборка.Организация 
					+ ", банк: " + Выборка.Банк 
					+ ", дата размещения: " + Формат(Выборка.ДатаРазмещения, "ДФ=dd.MM.yyyy") 
					+ ", вид договора: " + Выборка.ВидДоговора + ".";

		МассивПараметров = Новый Массив();
				
		МассивПараметров.Добавить(Новый Структура("id, value", 51, Выборка.КодУК_1Ф));
		МассивПараметров.Добавить(Новый Структура("id, value", 410, Выборка.КодЮрЛицаБанка_1Ф));
		МассивПараметров.Добавить(Новый Структура("id, value", 1538, Выборка.ВидДоговора));
						
		Если ЗначениеЗаполнено(Выборка.Ключ) Тогда
			КлючЗадачи = Выборка.Ключ;	
		Иначе
			
			КлючЗадачи = Новый Структура("bank_id, start_date, contract_type"
				,Выборка.КодЮрЛицаБанка_1Ф
				,Формат(Выборка.ДатаРазмещения, "ДФ=гггг-ММ-дд")
				,Выборка.ВидДоговора);
				
			КлючЗадачи = ПолучитьЗаписьJSON(КлючЗадачи);
			
		КонецЕсли;
		
		ПараметрыЗадачи = Новый Структура();
		ПараметрыЗадачи.Вставить("subcatId", 524);
		ПараметрыЗадачи.Вставить("userToMakeOwnerId", 3686); 
		ПараметрыЗадачи.Вставить("priorityId", 3); 
		ПараметрыЗадачи.Вставить("taskText", ТекстЗадачи); 
		ПараметрыЗадачи.Вставить("orderedTime", Формат(Выборка.ДатаРазмещения, "ДФ=гггг-ММ-дд") + "T18:00:00"); 
		ПараметрыЗадачи.Вставить("extParams", МассивПараметров); 
		
		ДанныеДляЭкспорта.ОсновнаяЧасть = ПараметрыЗадачи;
		ДанныеДляЭкспорта.Ключ = КлючЗадачи;
		ДанныеДляЭкспорта.ТабличнаяЧасть = Новый Массив;
		ДанныеДляЭкспорта.Распоряжения = Новый Массив;
		
	Иначе
		ДанныеДляЭкспорта = СтрокаТаблицы.ДанныеДляЭкспорта;
	КонецЕсли;
	
	МассивПараметровСтроки = Новый Массив;
	МассивПараметровСтроки.Добавить(Новый Структура("id, value", 182, Строка(Выборка.СчетДоверительногоУправления)));
	МассивПараметровСтроки.Добавить(Новый Структура("id, value", 183, Выборка.Сумма));
	МассивПараметровСтроки.Добавить(Новый Структура("id, value", 184, Выборка.Ставка));  
	МассивПараметровСтроки.Добавить(Новый Структура("id, value", 185, Выборка.Срок)); 
	МассивПараметровСтроки.Добавить(Новый Структура("id, value, dataSourceItemId", 186, Строка(Выборка.ПериодичностьВыплатыПроцентов), Строка(Выборка.ПериодичностьВыплатыПроцентов)));
	МассивПараметровСтроки.Добавить(Новый Структура("id, value, dataSourceItemId", 187, Строка(Выборка.ДоВостребования), Строка(Выборка.ДоВостребования)));
	МассивПараметровСтроки.Добавить(Новый Структура("id, value", 188, Формат(Выборка.ДатаРазмещения, "ДФ=гггг-ММ-дд")));
	МассивПараметровСтроки.Добавить(Новый Структура("id, value", 189, Формат(Выборка.ДатаВозврата, "ДФ=гггг-ММ-дд")));
	МассивПараметровСтроки.Добавить(Новый Структура("id, value", 346, Формат(Выборка.КодСчета, "ДФ=гггг-ММ-дд")));

	ДанныеДляЭкспорта.ТабличнаяЧасть.Добавить(Новый Структура("id, modifyType, cols", 0, "create", МассивПараметровСтроки));
 	ДанныеДляЭкспорта.Распоряжения.Добавить(Новый Структура("Ссылка, ЗафиксироватьНомерТранзакции", Выборка.Распоряжение, Выборка.ЗафиксироватьНомерТранзакции));
	
	СтрокаТаблицы.ДанныеДляЭкспорта = ДанныеДляЭкспорта; 
				
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДесериализоватьJSON(СтрокаJSON)
	
	ЧтениеJSON = Новый ЧтениеJSON();
    ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
    Возврат ПрочитатьJSON(ЧтениеJSON);
	
КонецФункции 

&НаСервереБезКонтекста
Функция ПолучитьЗаписьJSON(СтруктураДанных)
	
	ЗаписьJSON          = Новый ЗаписьJSON;
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВариантПериодичностиВыплатыПроцентов(Значение)
	
	Если Значение = "В конце срока" Тогда
		Возврат Перечисления.ПериодичностиВыплатыПроцентов.ВКонцеСрока;
	ИначеЕсли Значение = "Ежемесячно" Тогда
		Возврат Перечисления.ПериодичностиВыплатыПроцентов.Ежемесячно;
	ИначеЕсли Значение = "Авансом" Тогда
		Возврат Перечисления.ПериодичностиВыплатыПроцентов.Авансом
	Иначе
		Возврат Неопределено;
	КонецЕсли;
			
КонецФункции

&НаКлиенте
Процедура Обновить(Команда)
	
	ОбновитьНаСервере();
	СообщитьОбОшибках();
	
КонецПроцедуры 

&НаСервере
Процедура СоздатьИзменитьЗадачиНаСервере(МассивДанных)
	
	//Начало сессии
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	ПараметрыСессии = Новый Структура("Организация, Сервер", ЭтаФорма.Организация, ЭтаФорма.Сервер_1Ф);
		
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектНаСервере,, ПараметрыСессии);
	
	Механизм = ОбъектНаСервере.Метаданные().ПолноеИмя() + ".Форма.СозданиеЗадачДляПервойФормы.СоздатьИзменитьЗадачиНаСервере().";
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ПараметрыПодключения = РаботаСВнешнимиСистемами.ПерваяФорма_ПолучитьПараметрыПодключения(ЭтаФорма.Сервер_1Ф);
	
	Если ПараметрыПодключения = Неопределено Тогда
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,,, "Ошибка подключения к первой форме.");
		Возврат;
	КонецЕсли; 
	
	РезультатВыполнения = Новый Массив;

	Для Каждого ТекЗапись Из МассивДанных Цикл 
				
		//Создаем задачу.				
		Если ТекЗапись.Статус = 0 Тогда 
			
			Распоряжения = Новый Массив;
			
			Для Каждого ТекРаспоряжение Из ТекЗапись.ДанныеДляЭкспорта.Распоряжения Цикл
				Распоряжения.Добавить(ТекРаспоряжение.Ссылка);	
			КонецЦикла;
			
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	Распоряжение.Ссылка КАК Субъект,
				|	ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФорма) КАК ВнешняяСистема
				|ИЗ
				|	Документ.Распоряжение КАК Распоряжение
				|ГДЕ
				|	Распоряжение.Ссылка В (&Распоряжения)";
			
			Запрос.УстановитьПараметр("Распоряжения", Распоряжения);
			РезультатЗапроса = Запрос.Выполнить();
			
			НачатьТранзакцию();
			
			БлокировкаДанных = Новый БлокировкаДанных;
			
			БлокировкаНомеровТранзакций = БлокировкаДанных.Добавить("РегистрСведений.НомераТранзакций");
			БлокировкаНомеровТранзакций.ИсточникДанных = РезультатЗапроса;
			БлокировкаНомеровТранзакций.ИспользоватьИзИсточникаДанных("Субъект", "Субъект");
			БлокировкаНомеровТранзакций.ИспользоватьИзИсточникаДанных("ВнешняяСистема", "ВнешняяСистема");
			БлокировкаНомеровТранзакций.Режим = РежимБлокировкиДанных.Исключительный;
			
			БлокировкаДанных.Заблокировать(); 
			
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	НомераТранзакций.Субъект КАК Субъект
				|ИЗ
				|	РегистрСведений.НомераТранзакций КАК НомераТранзакций
				|ГДЕ
				|	НомераТранзакций.Субъект В (&Распоряжения)
				|	И НомераТранзакций.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФорма)";
			
			Запрос.УстановитьПараметр("Распоряжения", Распоряжения);
			
			Если Не Запрос.Выполнить().Пустой() Тогда
				Продолжить;	
			КонецЕсли;
			
			ТекстСообщения = "Ошибка постановки задачи в первой форме.";   
			 	
			ТабличнаяЧасть = СтрЗаменить(ПолучитьЗаписьJSON(Новый Структура("rows", ТекЗапись.ДанныеДляЭкспорта.ТабличнаяЧасть)), """", "\" + """");	

			ТекЗапись.ДанныеДляЭкспорта.ОсновнаяЧасть.extParams.Добавить(Новый Структура("id, value", 1539, ТабличнаяЧасть));
			
			ТелоЗапроса = ПолучитьЗаписьJSON(ТекЗапись.ДанныеДляЭкспорта.ОсновнаяЧасть);
			ТелоЗапроса = СтрЗаменить(ТелоЗапроса, "\\", "");
  
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks/create", ТелоЗапроса, ТекстСообщения);
			
			Если HTTPОтвет = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтаФорма.УникальныйИдентификатор);   
				Продолжить;
			КонецЕсли;
			
			ОтветОбъект = ДесериализоватьJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
 
			НомерЗадачи = Формат(ОтветОбъект.data.value, "ЧГ=0");
				
			Если ПустаяСтрока(НомерЗадачи) Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка постановки задачи. Отсутствует номер задачи в первой форме.", ЭтаФорма.УникальныйИдентификатор);
				Продолжить;
				
			ИначеЕсли Не РаботаСоСтрокамиКлиентСервер.ТолькоЦифрыВСтроке(НомерЗадачи) Тогда	
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка постановки задачи. Не удалось получить номер задачи. Ответ первой формы [" + НомерЗадачи + "]", ЭтаФорма.УникальныйИдентификатор);
				Продолжить;
				
			Иначе
				
				ОшибкаЗаписиНомераТранзакции = Ложь;
				
				Для Каждого ТекРаспоряжение Из ТекЗапись.ДанныеДляЭкспорта.Распоряжения Цикл
		
					Если Не ТекРаспоряжение.ЗафиксироватьНомерТранзакции Тогда
						Продолжить;
					КонецЕсли;
						
					Если Не РегистрыСведений.НомераТранзакций.ЗаписатьНомер(НомерЗадачи, Справочники.ВнешниеСистемы.ПерваяФорма, ТекРаспоряжение.Ссылка, ТекЗапись.ДанныеДляЭкспорта.Ключ) Тогда 
						ОшибкаЗаписиНомераТранзакции = Истина;
						Прервать;
					КонецЕсли;

				КонецЦикла;
				
				Если ОшибкаЗаписиНомераТранзакции Тогда
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать номер задачи [" + НомерЗадачи + "] в регистр [Номера транзакций]" + Символы.ПС + ОписаниеОшибки(), ЭтаФорма.УникальныйИдентификатор);
					ОтменитьТранзакцию();
		
					Продолжить;

				Иначе 	
					ЗафиксироватьТранзакцию();
					РезультатВыполнения.Добавить(НомерЗадачи + " (Создана)");
				КонецЕсли;
						
			КонецЕсли;
						
		ИначеЕсли ТекЗапись.Статус = 1 Тогда 
			
			//Удаление таб. части. Первый этап изменения данных.			
			НомерЗадачи = ТекЗапись.НомерЗадачи;
			
			//1539 - id реквизита таб. части (Депозитные сделки) в первой форме.
			ТекстЗапроса = "/app/v1.2/api/task/" + НомерЗадачи + "/ep/table/1539/erase?v=1.2&api_key=EpTable";
			ТекстСообщения = "Не удалось изменить данные в задаче [" + НомерЗадачи + "]. Ошибка предварительного удаления старых данных.";
			
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, ТекстЗапроса,, ТекстСообщения); 
		
			Если HTTPОтвет = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтаФорма.УникальныйИдентификатор);
				Продолжить;
			КонецЕсли;
			
			//Запись новых данных таб. части.	
			ТекстЗапроса = "/app/v1.2/api/task/" + НомерЗадачи + "/ep/table/1539/update?v=1.2&api_key=EpTable";
			ТекстСообщения = "Ошибка записи данных табличной части задачи [" + НомерЗадачи + "].";
						
			ТелоЗапроса = ПолучитьЗаписьJSON(Новый Структура("rows", ТекЗапись.ДанныеДляЭкспорта.ТабличнаяЧасть));
			
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, ТекстЗапроса, ТелоЗапроса, ТекстСообщения);

			Если HTTPОтвет = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтаФорма.УникальныйИдентификатор);
				Продолжить;
			Иначе
				
				РезультатВыполнения.Добавить(НомерЗадачи + " (Изменена)");
				
				НачатьТранзакцию(); 
					
				ОшибкаЗаписиНомераТранзакции = Ложь;
				
				Для Каждого ТекРаспоряжение Из ТекЗапись.ДанныеДляЭкспорта.Распоряжения Цикл
		
					Если Не ТекРаспоряжение.ЗафиксироватьНомерТранзакции Тогда
						Продолжить;
					КонецЕсли;
						
					Если Не РегистрыСведений.НомераТранзакций.ЗаписатьНомер(НомерЗадачи, Справочники.ВнешниеСистемы.ПерваяФорма, ТекРаспоряжение.Ссылка, ТекЗапись.ДанныеДляЭкспорта.Ключ) Тогда 
						ОшибкаЗаписиНомераТранзакции = Истина;
						Прервать;
					КонецЕсли;

				КонецЦикла;
				
				Если ОшибкаЗаписиНомераТранзакции Тогда
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать номер задачи [" + НомерЗадачи + "] в регистр [Номера транзакций]" + Символы.ПС + ОписаниеОшибки(), ЭтаФорма.УникальныйИдентификатор);
					ОтменитьТранзакцию();

				Иначе 	
					ЗафиксироватьТранзакцию();
				КонецЕсли;
					
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЦикла;
	
	ОбновитьНаСервере(ПараметрыПодключения);
	
	РезультатВыполнения = РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(РезультатВыполнения, ",");
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, Новый Структура("РезультатВыполнения", РезультатВыполнения));

КонецПроцедуры

&НаКлиенте
Процедура СообщитьОбОшибках()
		
	Если ТипЗнч(ЭтаФорма.ДопСвойства) = Тип("Структура") И ЭтаФорма.ДопСвойства.Свойство("Ошибки") Тогда
		
		Для Каждого ТекОшибка Из ЭтаФорма.ДопСвойства.Ошибки Цикл 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекОшибка, ЭтаФорма.УникальныйИдентификатор);	
		КонецЦикла;

	ИначеЕсли ЭтаФорма.ПараметрыЗадач.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют данные для создания задач в первой форме.", ЭтаФорма.УникальныйИдентификатор);		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СоздатьИзменитьЗадачи(Команда)
		
	МассивДанных = Новый Массив;                                       
	
	Для Каждого СтрокаПараметров Из ЭтаФорма.ПараметрыЗадач Цикл
		
		Если СтрокаПараметров.Флажок И Элементы.ПараметрыЗадач.ПроверитьСтроку(СтрокаПараметров.ПолучитьИдентификатор())
			И (СтрокаПараметров.СтатусКартинка = 0 Или СтрокаПараметров.СтатусКартинка = 1 И ЗначениеЗаполнено(СтрокаПараметров.НомерЗадачи)) Тогда
			
			МассивДанных.Добавить(Новый Структура("ДанныеДляЭкспорта, Статус, НомерЗадачи", СтрокаПараметров.ДанныеДляЭкспорта, СтрокаПараметров.СтатусКартинка, СтрокаПараметров.НомерЗадачи));
			
		КонецЕсли;
			
	КонецЦикла;
	
	Если МассивДанных.Количество() > 0 Тогда 
		
		СоздатьИзменитьЗадачиНаСервере(МассивДанных);
		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите строки из таблицы параметров для создания (изменения) задач в первой форме.");		
	КонецЕсли;
		
КонецПроцедуры 

&НаКлиенте
Процедура УстановитьВсеФлажки(Команда)
	
	УстановитьЗначенияФлажков(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеФлажки(Команда)
	
	УстановитьЗначенияФлажков(Ложь);
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначенияФлажков(Значение)
	
	Для Каждого СтрокаТаблицы Из ЭтаФорма.ПараметрыЗадач Цикл
		
		Если Значение = Ложь Тогда
			СтрокаТаблицы.Флажок = Значение;	
		Иначе
			
			Если Элементы.ПараметрыЗадач.ПроверитьСтроку(СтрокаТаблицы.ПолучитьИдентификатор())
				И (СтрокаТаблицы.СтатусКартинка = 0 Или СтрокаТаблицы.СтатусКартинка = 1) Тогда 
				
				СтрокаТаблицы.Флажок = Значение;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыЗадачПередНачаломИзменения(Элемент, Отказ)
	
	ТаблицаОбработкаНажатия(Элемент, Отказ);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПараметрыЗадачДанныеРаспоряженийПередНачаломИзменения(Элемент, Отказ)
	ТаблицаОбработкаНажатия(Элемент, Отказ);
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыЗадачТабличныеДанныеПервойФормыПередНачаломИзменения(Элемент, Отказ)
	ТаблицаОбработкаНажатия(Элемент, Отказ);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОбработкаНажатия(Элемент, Отказ)
	
	ТекущиеДанные = Элемент.ТекущиеДанные; 
		
	Если Не (ТекущиеДанные = Неопределено Или Элемент.ТекущийЭлемент = Неопределено) Тогда
		
		Если Элемент.ТекущийЭлемент.Имя = "ПараметрыЗадачФлажок" Тогда
			Возврат;
		Конецесли;
		
		СтандартнаяОбработка = Ложь;
		
		Если (Элемент.ТекущийЭлемент.Имя = "ПараметрыЗадачНомерЗадачи" Или Элемент.ТекущийЭлемент.Имя = "ПараметрыЗадачСтатус") И ЗначениеЗаполнено(ТекущиеДанные.НомерЗадачи) Тогда
			
			ЗапуститьПриложение("http://" + ЭтаФорма.Сервер_1Ф + "/maintaskform.aspx?TaskID=" + ТекущиеДанные.НомерЗадачи + "");
							
		ИначеЕсли Элемент.ТекущийЭлемент.Имя = "ПараметрыЗадачДанныеРаспоряженийСчетДоверительногоУправления" 
			Или Элемент.ТекущийЭлемент.Имя = "ТабличныеДанныеПервойФормыСчетДоверительногоУправления" Тогда 
			
			ОткрытьЗначение(ТекущиеДанные.СчетДоверительногоУправления);
			
		ИначеЕсли СтрНайти(Элемент.ТекущийЭлемент.Имя, "ПараметрыЗадачДанныеРаспоряжений") > 0 Тогда
			
			ОткрытьЗначение(ТекущиеДанные.Распоряжение);	
			
		КонецЕсли;
		
		Отказ = Истина;			
					
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыЗадачПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда 
		
		ЭтаФорма.Элементы.НомерЗадачи.Заголовок = ?(ЗначениеЗаполнено(ТекущиеДанные.НомерЗадачи), "#" + ТекущиеДанные.НомерЗадачи, "");
		
		ТекстЗаголовка = "" + ТекущиеДанные.Банк + ", дата размещения " + Формат(ТекущиеДанные.ДатаРазмещения, "ДФ=dd.MM.yyyy") + ", вид договора " + ТекущиеДанные.ВидДоговора;
		
		Если ЭтаФорма.Элементы.ОписаниеПараметров.Заголовок <> ТекстЗаголовка Тогда

			ЭтаФорма.Элементы.ОписаниеПараметров.Заголовок = ТекстЗаголовка;
			
		Иначе
				
			Если Элемент.ТекущийЭлемент <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.НомерЗадачи)
				И (Элемент.ТекущийЭлемент.Имя = "ПараметрыЗадачНомерЗадачи" Или Элемент.ТекущийЭлемент.Имя = "ПараметрыЗадачСтатус") Тогда
				
				ЗапуститьПриложение("http://" + ЭтаФорма.Сервер_1Ф + "/maintaskform.aspx?TaskID=" + ТекущиеДанные.НомерЗадачи + "");
				
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры