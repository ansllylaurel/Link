
Процедура СоздатьРаспоряжения(ВыбПлановыеРаспоряжения) Экспорт 
	
	ТекДата = ТекущаяДатаСеанса();
	ТаблицаДанных = Новый ТаблицаЗначений;
	
	ТаблицаДанных.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаДанных.Колонки.Добавить("ВидОперации", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОперацийБэкОфиса"));
	ТаблицаДанных.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	ТаблицаДанных.Колонки.Добавить("РасчетныйСчет", Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета"));
	ТаблицаДанных.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаДанных.Колонки.Добавить("Процент", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип);
	ТаблицаДанных.Колонки.Добавить("ДатаРазмещения", Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.Добавить("ДатаВозврата", Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.Добавить("Банк", Новый ОписаниеТипов("СправочникСсылка.Банки"));
	ТаблицаДанных.Колонки.Добавить("Индекс", Новый ОписаниеТипов("Число"));
	
	Для Каждого ТекРаспоряжение Из ВыбПлановыеРаспоряжения Цикл
		
		ТекСтрока = ТаблицаДанных.Добавить();
		ЗаполнитьЗначенияСвойств(ТекСтрока, ТекРаспоряжение); 
		ТекСтрока.Индекс = ВыбПлановыеРаспоряжения.Найти(ТекРаспоряжение);
				
	КонецЦикла; 

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область Текст_Запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаДанных.Организация КАК Организация,
		|	ТаблицаДанных.ВидОперации КАК ВидОперации,
		|	ТаблицаДанных.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ТаблицаДанных.РасчетныйСчет КАК РасчетныйСчет,
		|	ТаблицаДанных.Валюта КАК Валюта,
		|	ТаблицаДанных.Процент КАК Процент,
		|	ТаблицаДанных.ДатаРазмещения КАК ДатаРазмещения,
		|	ТаблицаДанных.ДатаВозврата КАК ДатаВозврата,
		|	ТаблицаДанных.Банк КАК Банк,
		|	ТаблицаДанных.Индекс КАК Индекс
		|ПОМЕСТИТЬ _ТаблицаДанных
		|ИЗ
		|	&ТаблицаДанных КАК ТаблицаДанных
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Распоряжение.Организация КАК Организация,
		|	Распоряжение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Распоряжение.ВидОперации КАК ВидОперации,
		|	Распоряжение.РасчетныйСчет КАК РасчетныйСчет,
		|	Распоряжение.Банк КАК Банк,
		|	Распоряжение.Процент КАК Процент,
		|	Распоряжение.Валюта КАК Валюта,
		|	Распоряжение.ДатаРазмещения КАК ДатаРазмещения,
		|	Распоряжение.ДатаВозврата КАК ДатаВозврата,
		|	ЛОЖЬ КАК ЭтоНовый
		|ПОМЕСТИТЬ _СводнаяТаблица
		|ИЗ
		|	Документ.Распоряжение КАК Распоряжение
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СторнированиеМНО КАК ДокСторнирование
		|		ПО (Распоряжение.Ссылка = ВЫРАЗИТЬ(ДокСторнирование.МНО КАК Документ.МНО).Основание)
		|			И (ДокСторнирование.Проведен)
		|ГДЕ
		|	НЕ Распоряжение.ПометкаУдаления
		|	И Распоряжение.Организация = &Организация
		|	И НАЧАЛОПЕРИОДА(Распоряжение.Дата, ДЕНЬ) = &НачалоДня
		|	И ДокСторнирование.Ссылка ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_ТаблицаДанных.Организация,
		|	_ТаблицаДанных.СчетДоверительногоУправления,
		|	_ТаблицаДанных.ВидОперации,
		|	_ТаблицаДанных.РасчетныйСчет,
		|	_ТаблицаДанных.Банк,
		|	_ТаблицаДанных.Процент,
		|	_ТаблицаДанных.Валюта,
		|	_ТаблицаДанных.ДатаРазмещения,
		|	_ТаблицаДанных.ДатаВозврата,
		|	ИСТИНА
		|ИЗ
		|	_ТаблицаДанных КАК _ТаблицаДанных
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СводнаяТаблица.Организация КАК Организация,
		|	_СводнаяТаблица.ВидОперации КАК ВидОперации,
		|	ВЫБОР
		|		КОГДА _СводнаяТаблица.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО)
		|			ТОГДА _СводнаяТаблица.РасчетныйСчет.Банк.Код
		|		КОГДА _СводнаяТаблица.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
		|			ТОГДА _СводнаяТаблица.Банк.Код
		|	КОНЕЦ КАК БИК,
		|	_СводнаяТаблица.Валюта КАК Валюта,
		|	_СводнаяТаблица.ДатаРазмещения КАК ДатаРазмещения,
		|	_СводнаяТаблица.ДатаВозврата КАК ДатаВозврата,
		|	МАКСИМУМ(_СводнаяТаблица.Процент) КАК Процент
		|ПОМЕСТИТЬ _МаксимальнаяСтавкаРаспоряженийПоСобственнымСчетам
		|ИЗ
		|	_СводнаяТаблица КАК _СводнаяТаблица
		|ГДЕ
		|	_СводнаяТаблица.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный)
		|
		|СГРУППИРОВАТЬ ПО
		|	_СводнаяТаблица.Организация,
		|	_СводнаяТаблица.ВидОперации,
		|	ВЫБОР
		|		КОГДА _СводнаяТаблица.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО)
		|			ТОГДА _СводнаяТаблица.РасчетныйСчет.Банк.Код
		|		КОГДА _СводнаяТаблица.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
		|			ТОГДА _СводнаяТаблица.Банк.Код
		|	КОНЕЦ,
		|	_СводнаяТаблица.Валюта,
		|	_СводнаяТаблица.ДатаРазмещения,
		|	_СводнаяТаблица.ДатаВозврата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СводнаяТаблица.Организация КАК Организация,
		|	_СводнаяТаблица.ВидОперации КАК ВидОперации,
		|	_СводнаяТаблица.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_СводнаяТаблица.РасчетныйСчет КАК РасчетныйСчет,
		|	_СводнаяТаблица.Валюта КАК Валюта,
		|	_СводнаяТаблица.Процент КАК Процент,
		|	_СводнаяТаблица.ДатаРазмещения КАК ДатаРазмещения,
		|	_СводнаяТаблица.ДатаВозврата КАК ДатаВозврата,
		|	_СводнаяТаблица.Банк КАК Банк,
		|	_СводнаяТаблица.ЭтоНовый КАК ЭтоНовый,
		|	ВЫБОР
		|		КОГДА _СводнаяТаблица.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО)
		|			ТОГДА ВЫРАЗИТЬ(_СводнаяТаблица.РасчетныйСчет КАК Справочник.БанковскиеСчета).Банк.Код
		|		КОГДА _СводнаяТаблица.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
		|			ТОГДА ВЫРАЗИТЬ(_СводнаяТаблица.Банк КАК Справочник.Банки).Код
		|	КОНЕЦ КАК БИК,
		|	_МаксимальнаяСтавкаРаспоряженийПоСобственнымСчетам.Процент КАК МаксПроцент
		|ПОМЕСТИТЬ _ОшибкиКонтроля
		|ИЗ
		|	_СводнаяТаблица КАК _СводнаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МаксимальнаяСтавкаРаспоряженийПоСобственнымСчетам КАК _МаксимальнаяСтавкаРаспоряженийПоСобственнымСчетам
		|		ПО _СводнаяТаблица.Организация = _МаксимальнаяСтавкаРаспоряженийПоСобственнымСчетам.Организация
		|			И _СводнаяТаблица.ВидОперации = _МаксимальнаяСтавкаРаспоряженийПоСобственнымСчетам.ВидОперации
		|			И _СводнаяТаблица.Валюта = _МаксимальнаяСтавкаРаспоряженийПоСобственнымСчетам.Валюта
		|			И _СводнаяТаблица.ДатаРазмещения = _МаксимальнаяСтавкаРаспоряженийПоСобственнымСчетам.ДатаРазмещения
		|			И _СводнаяТаблица.ДатаВозврата = _МаксимальнаяСтавкаРаспоряженийПоСобственнымСчетам.ДатаВозврата
		|			И (_СводнаяТаблица.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО)
		|					И ВЫРАЗИТЬ(_СводнаяТаблица.РасчетныйСчет КАК Справочник.БанковскиеСчета).Банк.Код = _МаксимальнаяСтавкаРаспоряженийПоСобственнымСчетам.БИК
		|				ИЛИ _СводнаяТаблица.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
		|					И ВЫРАЗИТЬ(_СводнаяТаблица.Банк КАК Справочник.Банки).Код = _МаксимальнаяСтавкаРаспоряженийПоСобственнымСчетам.БИК)
		|			И _СводнаяТаблица.Процент < _МаксимальнаяСтавкаРаспоряженийПоСобственнымСчетам.Процент
		|			И (ВЫРАЗИТЬ(_СводнаяТаблица.СчетДоверительногоУправления КАК Справочник.СчетаДоверительногоУправления).ВидДоговораДоверительногоУправления <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный))
		|ГДЕ
		|	НЕ _МаксимальнаяСтавкаРаспоряженийПоСобственнымСчетам.ВидОперации ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаДанных.Индекс КАК Индекс
		|ИЗ
		|	_ТаблицаДанных КАК _ТаблицаДанных
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиКонтроля КАК _ОшибкиКонтроля
		|		ПО _ТаблицаДанных.Организация = _ОшибкиКонтроля.Организация
		|			И _ТаблицаДанных.ВидОперации = _ОшибкиКонтроля.ВидОперации
		|			И _ТаблицаДанных.Валюта = _ОшибкиКонтроля.Валюта
		|			И _ТаблицаДанных.ДатаРазмещения = _ОшибкиКонтроля.ДатаРазмещения
		|			И _ТаблицаДанных.ДатаВозврата = _ОшибкиКонтроля.ДатаВозврата
		|			И (_ТаблицаДанных.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО)
		|					И ВЫРАЗИТЬ(_ТаблицаДанных.РасчетныйСчет КАК Справочник.БанковскиеСчета).Банк.Код = _ОшибкиКонтроля.БИК
		|				ИЛИ _ТаблицаДанных.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
		|					И ВЫРАЗИТЬ(_ТаблицаДанных.Банк КАК Справочник.Банки).Код = _ОшибкиКонтроля.БИК)
		|			И (_ТаблицаДанных.СчетДоверительногоУправления = _ОшибкиКонтроля.СчетДоверительногоУправления
		|				ИЛИ ВЫРАЗИТЬ(_ТаблицаДанных.СчетДоверительногоУправления КАК Справочник.СчетаДоверительногоУправления).ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(перечисление.ВидыДоговоровДоверительногоУправления.Собственный))
		|ГДЕ
		|	_ОшибкиКонтроля.ВидОперации ЕСТЬ NULL";
#КонецОбласти
	
	Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицаДанных);
	Запрос.УстановитьПараметр("Организация", ПараметрыСеанса.ТекущаяОрганизация); 
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ТекДата));
	
	Результат = Запрос.Выполнить();
	
	ОшибкиКонтроля = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиКонтроля"].ПолучитьДанные().Выгрузить();
	
	Для Каждого ТекСтрока Из ОшибкиКонтроля Цикл
		
		Если ТекСтрока.ЭтоНовый Тогда
		
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Распоряжение по счету д/у [" + ТекСтрока.СчетДоверительногоУправления+ "] не будет загружено. Не пройден контроль конфликта интересов,"
				+ " т.к. процентная ставка [" + ТекСтрока.Процент + "] ниже чем процентная ставка [" + ТекСтрока.МаксПроцент + "] распоряжения по собоственному портфелю.");
		Иначе
				
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В учетной системе обнаружено распоряжение по счету д/у [" + ТекСтрока.СчетДоверительногоУправления+ "]"
				+ " и процентной ставкой [" + ТекСтрока.Процент + "] ниже чем процентная ставка [" + ТекСтрока.МаксПроцент + "] распоряжения по собоственному портфелю.");	
				
		КонецЕсли;
	
	КонецЦикла;
	
	МассивИндексов = Результат.Выгрузить().ВыгрузитьКолонку("Индекс");
	
	Для Инд = 1 - ВыбПлановыеРаспоряжения.Количество() По 0 Цикл
		
		Если МассивИндексов.Найти(-Инд) = Неопределено Тогда
			ВыбПлановыеРаспоряжения.Удалить(-Инд);
			Продолжить;
		КонецЕсли;
		
		ЕстьОшибки = Ложь;
		
		СтрокаРаспоряжения = ВыбПлановыеРаспоряжения[-Инд];
		
		Распоряжение = Документы.Распоряжение.СоздатьДокумент();
		
		ЗаполнитьЗначенияСвойств(Распоряжение, СтрокаРаспоряжения);
		
		Распоряжение.Ответственный = РаботаСПользователями.ТекущийПользователь();
		Распоряжение.ДополнительныеСвойства.Вставить("ПройденКонтрольКонфликтаИнтересов");
		
		Если Не Распоряжение.ПроверитьЗаполнение() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось создать Распоряжение по клиенту " + СтрокаРаспоряжения.Коды);
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если Не ЕстьОшибки Тогда
		
			Попытка
				Распоряжение.Записать(РежимЗаписиДокумента.Запись);
				СтрокаРаспоряжения.Вставить("Ссылка", Распоряжение.Ссылка);
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось создать Распоряжение по клиенту " + СтрокаРаспоряжения.Коды);
			КонецПопытки;
		
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

Функция СоздатьДепозитыИРазмещения(Организация, ИсходныеДанные, СоздатьРазмещение = Истина) Экспорт
	
	МассивДепозитныхВкладов = Новый Массив;
		
	Если ТипЗнч(ИсходныеДанные) <> Тип("ТаблицаЗначений") Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данные для создания депозитного вклада не соответствует формату");
		Возврат Неопределено;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	#Область ТЕКСТ_ЗАПРОСА
	
	Запрос.Текст =
	 	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 	|	ИсходныеДанные.Документ КАК Документ,
	 	|	ИсходныеДанные.УчетныйАктив КАК УчетныйАктив,
	 	|	ИсходныеДанные.РасчетныйСчетДепозита КАК РасчетныйСчетДепозита,
	 	|	ИсходныеДанные.НомерПодтверждения КАК НомерПодтверждения,
	 	|	ИсходныеДанные.ДатаПодтверждения КАК ДатаПодтверждения,
	 	|	ИсходныеДанные.ДепозитЗаключенПоДоговору КАК ДепозитЗаключенПоДоговору,
	 	|	ИсходныеДанные.Биржевой КАК Биржевой
