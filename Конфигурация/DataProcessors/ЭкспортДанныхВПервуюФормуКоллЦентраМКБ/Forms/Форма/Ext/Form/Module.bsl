&НаКлиенте
Процедура КлиентыПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("ЗаполнитьОсновныеАнкетныеДанныеКлиента", 0.1, Истина); 
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьОсновныеАнкетныеДанныеКлиента()
	
	ТекущиеДанные = Элементы.Клиенты.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Клиент) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаРеквизитов = "Фамилия,Имя,Отчество,Пол,ДатаРождения,СерияДокумента,НомерДокумента,ОрганВыдавшийДокумент,"
						+ "КодПодразделения,ДатаВыдачиДокумента,ДатаОкончанияДействияДокумента,ИНН,СНИЛС";
	
	МассивРеквизитов = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаРеквизитов);
	
	Для Каждого ИмяРеквизита Из МассивРеквизитов Цикл	
		ЭтаФорма[ИмяРеквизита] = ТекущиеДанные[ИмяРеквизита];	
	КонецЦикла;
	
	ЭтаФорма.Элементы.ГруппаПользователь.Заголовок = 
			ТекущиеДанные.Фамилия + " " + 
			ТекущиеДанные.Имя + 
			?(ЗначениеЗаполнено(ТекущиеДанные.Отчество), " " + ТекущиеДанные.Отчество, "") +
			?(ЗначениеЗаполнено(ТекущиеДанные.Код1Ф), " (id " + ТекущиеДанные.Код1Ф + ")", "");
		
КонецПроцедуры 

