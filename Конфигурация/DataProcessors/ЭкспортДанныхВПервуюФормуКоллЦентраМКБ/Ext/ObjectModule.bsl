Процедура ЗарегистрироватьОкончаниеСессии(Механизм, Сессия, ТекстОшибки = Неопределено, Отказ = Неопределено);
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда	
		ЗарегистрироватьОшибку(ТекстОшибки);	
	КонецЕсли;
		
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда 
		
		Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
			
			Отказ = Истина;	
			
			ПараметрыЗадания = Новый Структура("Механизм, Ошибки", Механизм, ЭтотОбъект.ДополнительныеСвойства.Ошибки);
			РаботаСДлительнымиОперациями.ЗапуститьВыполнениеВФоне(Сессия, "РаботаСБизнесПроцессамиИЗадачами.ЗарегистрироватьОшибкуВФоне", ПараметрыЗадания);
						
		КонецЕсли;
		
	Иначе
			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС),,,, Отказ);
	КонецЕсли;
			
	ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,,, ТекстОшибки);	
					
КонецПроцедуры

ЭтотОбъект.ДополнительныеСвойства = Новый Структура();


   