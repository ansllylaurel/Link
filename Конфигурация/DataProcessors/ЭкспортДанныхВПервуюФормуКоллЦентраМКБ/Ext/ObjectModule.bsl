		|	ВЫРАЗИТЬ(_Портфель.Цена КАК ЧИСЛО(19, 4)) КАК Цена,
		|	ВЫРАЗИТЬ(_Портфель.Сумма КАК ЧИСЛО(19, 4)) КАК Сумма,
		|	ВЫРАЗИТЬ(_Портфель.Количество КАК ЧИСЛО(19, 4)) КАК Количество,
		|	ВЫРАЗИТЬ(_Портфель.ФинРезультат КАК ЧИСЛО(19, 4)) КАК ФинРезультат,
		|	0 КАК Доходность
		|ИЗ
		|	_Портфель КАК _Портфель
		|ГДЕ
		|	(_Портфель.Сумма > 0
		|			ИЛИ _Портфель.Количество > 0)";	
#КонецОбласти 
	
    Запрос.УстановитьПараметр("НачалоПериода", ПараметрыФормирования.НачалоПериода);
	Запрос.УстановитьПараметр("ДатаФинПоказателя", НачалоДня(ПараметрыФормирования.КонецПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ПараметрыФормирования.КонецПериода));
	Запрос.УстановитьПараметр("Организация", ПараметрыФормирования.Организация);
	Запрос.УстановитьПараметр("Пиф", ?(ПараметрыФормирования.Свойство("Пиф"), ПараметрыФормирования.Пиф, Неопределено));
	Запрос.УстановитьПараметр("ВклИИС", ?(ПараметрыФормирования.Свойство("ВключаяИИС"), Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет, Неопределено)); 
	
	ВыборкаПортфелей = Запрос.Выполнить().Выбрать();
	
	ВыборкаАнкетныхДанных = Запрос.МенеджерВременныхТаблиц.Таблицы["_АнкетныеДанныеКлиентов"].ПолучитьДанные().Выбрать();
	
	Если ВыборкаАнкетныхДанных.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	//ТаблицаБанков = Запрос.МенеджерВременныхТаблиц.Таблицы["_БанкиБезКодаПервойФормы"].ПолучитьДанные().Выгрузить();
	
	//Если ТаблицаБанков.Количество() > 0 Тогда
	//	ЗагрузитьКодыБанков(ТаблицаБанков);
	//КонецЕсли;
	
	ДанныеДляЭкспорта = СформироватьСтруктуруДанных();
		
	Пока ВыборкаАнкетныхДанных.Следующий() Цикл
				
		НоваяСтрока = ДанныеДляЭкспорта.ТаблицаКлиентов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаАнкетныхДанных);
		
		Если ЗначениеЗаполнено(ВыборкаАнкетныхДанных.EMail) Тогда 	
			НоваяСтрока.Контакты.Добавить(Новый Структура("ТипСвязи, АдресНомер", "Email", ВыборкаАнкетныхДанных.EMail)); 
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаАнкетныхДанных.Телефоны) Тогда
			НоваяСтрока.Контакты.Добавить(Новый Структура("ТипСвязи, АдресНомер", "Телефон", ВыборкаАнкетныхДанных.Телефоны)); 
		КонецЕсли;
			
	КонецЦикла; 
	
	ВыборкаБанковскихРеквизитов = Запрос.МенеджерВременныхТаблиц.Таблицы["_БанковскиеРеквизиты"].ПолучитьДанные().Выбрать();
	
	Пока ВыборкаБанковскихРеквизитов.Следующий() Цикл
				
		СтрокаРеквизитов = ДанныеДляЭкспорта.БанковскиеРеквизиты.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРеквизитов, ВыборкаБанковскихРеквизитов);
		
	КонецЦикла;
		
	ВыборкаПродуктов = Запрос.МенеджерВременныхТаблиц.Таблицы["_ПродуктыКлиентов"].ПолучитьДанные().Выбрать();
	
	Пока ВыборкаПродуктов.Следующий() Цикл
				
		СтрокаПродуктов = ДанныеДляЭкспорта.Продукты.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПродуктов, ВыборкаПродуктов);
					
	КонецЦикла;
		
	ВыборкаОпераций = Запрос.МенеджерВременныхТаблиц.Таблицы["_Операции"].ПолучитьДанные().Выбрать();
	
	Пока ВыборкаОпераций.Следующий() Цикл
				
		СтрокаОпераций = ДанныеДляЭкспорта.Операции.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаОпераций, ВыборкаОпераций);
					
	КонецЦикла;
	
	ВыборкаЗаявок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ЗаявкиПайщиков"].ПолучитьДанные().Выбрать();
	
	Пока ВыборкаЗаявок.Следующий() Цикл
				
		СтрокаЗаявок = ДанныеДляЭкспорта.Заявки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЗаявок, ВыборкаЗаявок);
					
	КонецЦикла; 
		
	Пока ВыборкаПортфелей.Следующий() Цикл 
						
		СтрокаПортфеля = ДанныеДляЭкспорта.Портфель.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПортфеля, ВыборкаПортфелей);
					
	КонецЦикла;
	
	Возврат ДанныеДляЭкспорта;
	
КонецФункции 

Процедура Экспортировать(ДанныеДляЭкспорта) Экспорт
	
	НовыеКодыБанков = Неопределено;
	
	Если ДанныеДляЭкспорта.Свойство("ТаблицаКлиентов") И ДанныеДляЭкспорта.ТаблицаКлиентов.Количество() <> 0 Тогда 
		
		ПараметрыПодключения = РаботаСВнешнимиСистемами.ПерваяФорма_ПолучитьПараметрыПодключения("uk1f.region.ru",, "robot", "NrfSwGNs6hcgX2uXA390");

		Если ПараметрыПодключения = Неопределено Тогда
			//РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,,, "Ошибка подключения к первой форме.");
			Возврат;
		КонецЕсли;
		
		Если ДанныеДляЭкспорта.Свойство("БанковскиеРеквизиты") И ДанныеДляЭкспорта.БанковскиеРеквизиты.Количество() > 0 Тогда
			НовыеКодыБанков = ПолучитьКодыБанковИзПервойФормы(ДанныеДляЭкспорта.БанковскиеРеквизиты, ПараметрыПодключения);		
		КонецЕсли; 
		
		Для Каждого ТекКлиент Из ДанныеДляЭкспорта.ТаблицаКлиентов Цикл 
						
			КодПайщика1Ф = ЭкспортироватьАнкетныеДанныеКлиента(ТекКлиент, ПараметрыПодключения);
			
			ПродуктыПользователя = Неопределено;
			
			Если КодПайщика1Ф = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если ДанныеДляЭкспорта.Свойство("БанковскиеРеквизиты") Тогда
				
				РеквизитыПользователя =	ДанныеДляЭкспорта.БанковскиеРеквизиты.НайтиСтроки(Новый Структура("УидФизЛица", ТекКлиент.УидФизЛица));
				ЭкспортироватьБанковскиеРеквизитыКлиента(РеквизитыПользователя, КодПайщика1Ф, ПараметрыПодключения, НовыеКодыБанков);
			
			КонецЕсли;
			
			Если ДанныеДляЭкспорта.Свойство("Продукты") Тогда
				
				ПродуктыПользователя = ДанныеДляЭкспорта.Продукты.Скопировать(Новый Структура("УидФизЛица", ТекКлиент.УидФизЛица));
				ЭкспортироватьПродуктыКлиента(ПродуктыПользователя, ПараметрыПодключения, КодПайщика1Ф);
					
			КонецЕсли;
            //В таблицу "Операции" экспортируются и активные заявки, по которым еще не было поступлений/погашений паев. 
			Если ДанныеДляЭкспорта.Свойство("Операции") Тогда
										
				ОперацииПользователя = ДанныеДляЭкспорта.Операции.НайтиСтроки(Новый Структура("УидФизЛица", ТекКлиент.УидФизЛица)); 
				ЭкспортироватьОперацииКлиента(ОперацииПользователя, ПараметрыПодключения, КодПайщика1Ф, ПродуктыПользователя);
									
			КонецЕсли;
			
			Если ДанныеДляЭкспорта.Свойство("Портфель") Тогда

				ПортфельПользователя = ДанныеДляЭкспорта.Портфель.НайтиСтроки(Новый Структура("УидФизЛица", ТекКлиент.УидФизЛица));
				ЭкспортироватьПортфельКлиента(ПортфельПользователя, ПараметрыПодключения, КодПайщика1Ф, ПродуктыПользователя);
									
			КонецЕсли;
			
			//Если ДанныеДляЭкспорта.Свойство("Заявки") Тогда
			//	
			//	ЗаявкиПользователя = ДанныеДляЭкспорта.Заявки.НайтиСтроки(Новый Структура("УидФизЛица", ТекКлиент.УидФизЛица));
			//	ЭкспортироватьОперацииКлиента(ЗаявкиПользователя, ПараметрыПодключения, КодПайщика1Ф);
			//		
			//КонецЕсли;
												
		КонецЦикла;
		
	КонецЕсли; 
			
КонецПроцедуры  

Функция ЭкспортироватьАнкетныеДанныеКлиента(ДанныеКлиента, ПараметрыПодключения)
	
	//если есть код первой формы проверим и обновим анкетные данные
	//доработать сверку контактных данных
	Если ЗначениеЗаполнено(ДанныеКлиента.Код1Ф) Тогда 
		
		ТекстСообщения = "Не удалось получить данные клиента из первой формы по коду [" + ДанныеКлиента.Код1Ф + "].";
		
		КодПайщика1Ф = ДанныеКлиента.Код1Ф;
		
		ОбновитьДанныеПервойФормы(КодПайщика1Ф, ДанныеКлиента, ПараметрыПодключения,, "201"); //параметр GUID исключил из сверки
		
		//Продолжить;
		
	Иначе
		
		Если Не ЗначениеЗаполнено(ДанныеКлиента.ИНН) Тогда 
			ЗарегистрироватьОшибку("Ошибка экспорта данных в первую форму колл-центра МКБ. У физ лица [" + ДанныеКлиента.Клиент + "] не заполнен код ИНН.");
			Возврат Неопределено;	
		КонецЕсли;
		
		ТекстСообщения = "Не удалось получить данные клиента из первой формы по ИНН [" + ДанныеКлиента.ИНН + "]."; 
		
		//сначала проверим клиента по ИНН
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("startRow", 0);
		СтруктураЗапроса.Вставить("endRow", 10);
		СтруктураЗапроса.Вставить("select", РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("field, type", "taskId", "numberValue")));
		СтруктураЗапроса.Вставить("filterModel", Новый Структура("ExtParam78", Новый Структура("filterType, type, filter", "text", "equals", ДанныеКлиента.ИНН)));
		
		ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
							
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api-core/datasource/subcat/23/data", ТелоЗапроса, ТекстСообщения);
					
		Если HTTPОтвет = Неопределено Тогда
			ЗарегистрироватьОшибку(ТекстСообщения);   
			Возврат Неопределено;
		КонецЕсли;
		
		ОтветОбъект = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
			
		Если ОтветОбъект.Свойство("totalCount") И ОтветОбъект.totalCount > 0 Тогда
					
			ЗарегистрироватьОшибку("В первой форме найден пользователь по ИНН [" + ДанныеКлиента.ИНН + "]. В регистре [Коды во внешних системах] отсутствет код пользователя.");   
			Возврат Неопределено;
			
		КонецЕсли;

		МассивПараметров = Новый Массив();
		
		МассивПараметров.Добавить(Новый Структура("id, value", 78, ДанныеКлиента.ИНН)); //ИНН (Text)  
		МассивПараметров.Добавить(Новый Структура("id, value", 165, "Открытый")); //Статус клиента (Select Открытый/Закрытый/Нет)
		МассивПараметров.Добавить(Новый Структура("id, value", 201, Строка(ДанныеКлиента.УидФизЛица))); //GUID (Text) 
		МассивПараметров.Добавить(Новый Структура("id, value", 76, ДанныеКлиента.Фамилия)); //Фамилия (Text)
		МассивПараметров.Добавить(Новый Структура("id, value", 75, ДанныеКлиента.Имя)); //Имя (Text)
		МассивПараметров.Добавить(Новый Структура("id, value", 74, ДанныеКлиента.Отчество)); //Отчество (Text)
		МассивПараметров.Добавить(Новый Структура("id, value", 168, ?(ДанныеКлиента.Пол = Перечисления.ПолФизическогоЛица.Мужской, "М", "Ж"))); //Пол (Select М/Ж)
		МассивПараметров.Добавить(Новый Структура("id, value", 77, Формат(ДанныеКлиента.ДатаРождения, "ДФ=гггг-ММ-дд"))); //Дата рождения (Date)
		МассивПараметров.Добавить(Новый Структура("id, value", 169, ДанныеКлиента.СНИЛС)); //СНИЛС (Text)
		МассивПараметров.Добавить(Новый Структура("id, value", 84, ДанныеКлиента.СерияДокумента)); //Серия паспорта (Text)
		МассивПараметров.Добавить(Новый Структура("id, value", 85, ДанныеКлиента.НомерДокумента)); //Номер паспорта (Text)
		МассивПараметров.Добавить(Новый Структура("id, value", 86, Формат(ДанныеКлиента.ДатаВыдачиДокумента, "ДФ=гггг-ММ-дд"))); //Дата выдачи (Date)
		МассивПараметров.Добавить(Новый Структура("id, value", 87, ДанныеКлиента.ОрганВыдавшийДокумент)); //Кем выдан (Text)
		МассивПараметров.Добавить(Новый Структура("id, value", 88, ДанныеКлиента.КодПодразделения)); //Код подразделения (Text)

		Если ЗначениеЗаполнено(ДанныеКлиента.ДатаОкончанияДействияДокумента) Тогда 
			МассивПараметров.Добавить(Новый Структура("id, value", 167, Формат(ДанныеКлиента.ДатаОкончанияДействияДокумента, "ДФ=гггг-ММ-дд"))); //Действует до (Date)
		КонецЕсли;
		
		Если ДанныеКлиента.Контакты.Количество() > 0 Тогда									
            МассивПараметров.Добавить(СформироватьПараметрКонтактов(ДанныеКлиента.Контакты));	
		КонецЕсли;
					
		ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("subcatId, extParams", 23, МассивПараметров));
		
		ТекстСообщения = "Ошибка экспорта данных физ лица [" + ДанныеКлиента.Клиент + "].";
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks/create", ТелоЗапроса, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ЗарегистрироватьОшибку(ТекстСообщения);   
			Возврат Неопределено;
		КонецЕсли;
		
		ОтветОбъект = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8")); 
		КодПайщика1Ф = Формат(ОтветОбъект.data.value, "ЧГ=0");
					
		РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(
			ДанныеКлиента.Клиент, 
			Справочники.ВнешниеСистемы.ПерваяФормаМКБ, 
			Справочники.ГруппыИмпортируемыхОбъектов.ФизическиеЛица,
			КодПайщика1Ф); 
			
	КонецЕсли;
		
	Возврат КодПайщика1Ф;
	
КонецФункции 

Процедура ЭкспортироватьБанковскиеРеквизитыКлиента(Реквизиты, КодПайщика1Ф, ПараметрыПодключения, НовыеКодыБанков = Неопределено)
	
	ТекстСообщения = "Ошибка экспорта банковских реквизитов клиента ID [%1].";
	
	//доработать обновление реквизитов
	Для Каждого ТекРеквизиты Из Реквизиты Цикл 
		
		//Ищем счет по GUID. Выгружаем если ничего не нашли. 
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("startRow", 0);
		СтруктураЗапроса.Вставить("endRow", 10);
		СтруктураЗапроса.Вставить("select", РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("field, type", "taskId", "numberValue")));
		СтруктураЗапроса.Вставить("filterModel", Новый Структура("ExtParam201", Новый Структура("filterType, type, filter", "text", "equals", Строка(ТекРеквизиты.Уид))));
		
		ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
							
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api-core/datasource/subcat/40/data", ТелоЗапроса, ТекстСообщения);
					
		Если HTTPОтвет = Неопределено Тогда
			ЗарегистрироватьОшибку(СтрШаблон(ТекстСообщения, КодПайщика1Ф));   
			Продолжить;
		КонецЕсли;
		
		ОтветОбъект = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
			
		Если ОтветОбъект.Свойство("totalCount") И ОтветОбъект.totalCount = 0 Тогда
			
			МассивПараметров = Новый Массив;
			
			МассивПараметров.Добавить(Новый Структура("id, value", 98, КодПайщика1Ф)); 
			МассивПараметров.Добавить(Новый Структура("id, value", 172, ТекРеквизиты.РасчетныйСчет));
			МассивПараметров.Добавить(Новый Структура("id, value", 201, Строка(ТекРеквизиты.Уид)));
			МассивПараметров.Добавить(Новый Структура("id, value", 202, "Российский рубль"));
					
			Если ЗначениеЗаполнено(ТекРеквизиты.КодБанка1Ф) Тогда 
				
				МассивПараметров.Добавить(Новый Структура("id, value", 171, ТекРеквизиты.КодБанка1Ф));

			ИначеЕсли НовыеКодыБанков <> Неопределено Тогда
				
				МассивСтрок = НовыеКодыБанков.НайтиСтроки(Новый Структура("Банк", ТекРеквизиты.Банк));
				
				Если МассивСтрок.Количество() > 0 Тогда
					МассивПараметров.Добавить(Новый Структура("id, value", 171, МассивСтрок[0].КодБанка1Ф));	
				КонецЕсли;
				
			Иначе
				ЗарегистрироватьОшибку("Не удалось экспортировать банковские реквизиты клиента ID [" + КодПайщика1Ф + "]. Не найден код банка [" + ТекРеквизиты.Банк + "] в первой форме.");
				Продолжить;		
			КонецЕсли;  
			
			ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("subcatId, extParams", 40, МассивПараметров));
		
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks/create", ТелоЗапроса, ТекстСообщения);
			
			Если HTTPОтвет = Неопределено Тогда
				ЗарегистрироватьОшибку(ТекстСообщения);   
				Продолжить;
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЦикла; 
		
КонецПроцедуры

Процедура ЭкспортироватьОперацииКлиента(ТаблицаОпераций, ПараметрыПодключения, КодПайщика1Ф = Неопределено, Продукты = Неопределено)
		
	//Завки и операции выгружаются в одну таблицу
	//Выгружаем только активные заявки, на онсновании которых еще не созданы зачисления/погашения паев.
	//После того как на основании заявки создали зачисление/погашение паев - в первой форме меняем GUID заявки на GUID операции.	
	
	ТекстСообщения = "Ошибка экспорта операции клиента ID [%1].";
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("startRow", 0);
	СтруктураЗапроса.Вставить("endRow", 10);
	СтруктураЗапроса.Вставить("select", Новый Массив);
	СтруктураЗапроса.select.Добавить(Новый Структура("field, type", "taskId", "numberValue"));
	//СтруктураЗапроса.select.Добавить(Новый Структура("field, type", "ExtParam207", "extparam"));
	//СтруктураЗапроса.select.Добавить(Новый Структура("field, type", "ExtParam200", "extparam"));
	СтруктураЗапроса.Вставить("filterModel", Новый Структура("ExtParam201", Новый Структура("filterType, type, filter", "text", "equals")));
	
	Для Каждого ТекОперация Из ТаблицаОпераций Цикл 
		
		КодПайщика1Ф = ?(КодПайщика1Ф = Неопределено, ТекОперация.КодПайщика1Ф, КодПайщика1Ф); 
		
		//1. Ищем запись (задачу) в 1Ф по GUID операции.
		Если ЗначениеЗаполнено(ТекОперация.Дата) Тогда // дату заполняем только для операции
			
			СтруктураЗапроса.filterModel.ExtParam201.filter = Строка(ТекОперация.Уид);
			ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
								
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api-core/datasource/subcat/42/data", ТелоЗапроса, ТекстСообщения);
					
			Если HTTPОтвет = Неопределено Тогда
				ЗарегистрироватьОшибку(СтрШаблон(ТекстСообщения, КодПайщика1Ф));   
				Возврат;
			КонецЕсли;
		
			ОтветОбъект = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
			
			//2. Если не нашли задачу по GUID операции, ищем по GUID заявки  
			Если ОтветОбъект.Свойство("totalCount") И ОтветОбъект.totalCount = 0 Тогда 
				
				Если ТекОперация.Тип = "Приобретение паев" Или ТекОперация.Тип = "Погашение паев" Тогда 
				
					СтруктураЗапроса.filterModel.ExtParam201.filter = Строка(ТекОперация.УидЗаявки);
					ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
										
					HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api-core/datasource/subcat/42/data", ТелоЗапроса, ТекстСообщения);
							
					Если HTTPОтвет = Неопределено Тогда
						ЗарегистрироватьОшибку(СтрШаблон(ТекстСообщения, КодПайщика1Ф));   
						Возврат;
					КонецЕсли;
				
					ОтветОбъект = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8")); 
					
					//3. Если нашли задачу по GUID заявки - обновляем GUID заявки на GUID операции
					Если ОтветОбъект.Свойство("totalCount") И ОтветОбъект.totalCount = 1 Тогда
						
						//обновление данных	
						КодОперации = Формат(ОтветОбъект.tasksDataSourceResponse[0].taskId, "ЧГ=0"); 
						
						ОбновитьДанныеПервойФормы(КодОперации, ТекОперация, ПараметрыПодключения, "187,183,184,200,201");
																		
						Продолжить;
						
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
							
				Продолжить;
				//Проверяем актив
				//КодПродукта = ПолучитьКодПродукта(Строка(ТекОперация.УидЗаявки), ПараметрыПодключения);
				//
				//Если Не ЗначениеЗаполнено(КодПродукта) Тогда
				//	ЗарегистрироватьОшибку(СтрШаблон(ТекстСообщения, КодПайщика1Ф) + " Не удалось определить код продукта.");   
				//	Продолжить;
				//КонецЕсли;
				//
				//Если КодПродукта <> Формат(ОтветОбъект.tasksDataSourceResponse[0].extParams.ExtParam207.intValue, "ЧГ=0") Тогда
				//	
				//	КодОперации = Формат(ОтветОбъект.tasksDataSourceResponse[0].taskId, "ЧГ=0");
				//		
				//	ЗапросОбъект = РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("taskId, extParamStr", КодОперации, "#n207#v" + КодПродукта));
				//									
				//	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/extparams/update", ПолучитьСтрокуJSON(ЗапросОбъект), ТекстСообщения);
				//	
				//	Если HTTPОтвет = Неопределено Тогда
				//		ЗарегистрироватьОшибку(СтрШаблон(ТекстСообщения, КодПайщика1Ф));   
				//	КонецЕсли;
				//	
				//КонецЕсли;
				
			КонецЕсли;
			
		Иначе //это заявка, ищем запись по GUID заявки
			
			СтруктураЗапроса.filterModel.ExtParam201.filter = Строка(ТекОперация.УидЗаявки);
			ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
								
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api-core/datasource/subcat/42/data", ТелоЗапроса, ТекстСообщения);
					
			Если HTTPОтвет = Неопределено Тогда
				ЗарегистрироватьОшибку(СтрШаблон(ТекстСообщения, КодПайщика1Ф));   
				Возврат;
			КонецЕсли;
		
			ОтветОбъект = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
			 
			Если ОтветОбъект.Свойство("totalCount") И ОтветОбъект.totalCount = 1 Тогда
				
				//обновляем статус.	
				КодОперации = Формат(ОтветОбъект.tasksDataSourceResponse[0].taskId, "ЧГ=0");
				
				ОбновитьДанныеПервойФормы(КодОперации, ТекОперация, ПараметрыПодключения, "200");
				
				Продолжить;
							
			КонецЕсли;
	
		КонецЕсли; 
		
		КодПродукта = ПолучитьКодПродукта(ТекОперация.УидЗаявки, ПараметрыПодключения, Продукты);
		
		Если Не ЗначениеЗаполнено(КодПродукта) Тогда 
			ЗарегистрироватьОшибку("Не удалось получить код продукта по GUID заявки [" + ТекОперация.УидЗаявки + "].");
			Возврат;
		КонецЕсли; 
		
		GUID = ?(ЗначениеЗаполнено(ТекОперация.Уид), ТекОперация.Уид, ТекОперация.УидЗаявки);

		МассивПараметров = Новый Массив;
		
		МассивПараметров.Добавить(Новый Структура("id, value", 98, КодПайщика1Ф)); 
		МассивПараметров.Добавить(Новый Структура("id, value", 179, ТекОперация.Тип));
		МассивПараметров.Добавить(Новый Структура("id, value", 180, ТекОперация.НомерЗаявки));	
		МассивПараметров.Добавить(Новый Структура("id, value", 201, Строка(GUID)));
		МассивПараметров.Добавить(Новый Структура("id, value", 207, КодПродукта));
		МассивПараметров.Добавить(Новый Структура("id, value", 209, Формат(ТекОперация.ДатаЗаявки, "ДФ=гггг-ММ-дд"))); //ДатаЗаявки
		МассивПараметров.Добавить(Новый Структура("id, value", 208, Формат(ТекОперация.Цена, "ЧН=0; ЧГ=0"))); //цена ед.
		МассивПараметров.Добавить(Новый Структура("id, value", 184, Формат(ТекОперация.Сумма, "ЧН=0; ЧГ=0")));
		МассивПараметров.Добавить(Новый Структура("id, value", 183, Формат(ТекОперация.Количество, "ЧН=0; ЧГ=0")));
		МассивПараметров.Добавить(Новый Структура("id, value", 185, Формат(ТекОперация.СкидкаНадбавка, "ЧН=0; ЧГ=0"))); 
		МассивПараметров.Добавить(Новый Структура("id, value", 186, Формат(ТекОперация.СуммаНДФЛ, "ЧН=0; ЧГ=0")));

		Если ЗначениеЗаполнено(ТекОперация.Дата) Тогда
			МассивПараметров.Добавить(Новый Структура("id, value", 187, Формат(ТекОперация.Дата, "ДФ=гггг-ММ-ддTЧЧ:mm:ss"))); //ДатаОперации	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекОперация.Статус) Тогда
			МассивПараметров.Добавить(Новый Структура("id, value", 200, Строка(ТекОперация.Статус)));
		КонецЕсли;
		
		ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("subcatId, extParams", 42, МассивПараметров));
	
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks/create", ТелоЗапроса, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ЗарегистрироватьОшибку(СтрШаблон(ТекстСообщения, КодПайщика1Ф));
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры 

Процедура ЭкспортироватьПортфельКлиента(Портфель, ПараметрыПодключения, КодПайщика1Ф = Неопределено, Продукты = Неопределено)
	
	ТекстСообщения = "Ошибка экспорта портфеля клиента ID [%1].";
	
	Для Каждого СтрокаАктива Из Портфель Цикл 
		
		КодПайщика1Ф = ?(КодПайщика1Ф = Неопределено, СтрокаАктива.КодПайщика1Ф, КодПайщика1Ф); 
		
		GUID = Строка(СтрокаАктива.Актив.УникальныйИдентификатор());
		
		КодПродукта = ПолучитьКодПродукта(СтрокаАктива.УидЗаявки, ПараметрыПодключения, Продукты);
		
		Если Не ЗначениеЗаполнено(КодПродукта) Тогда
			ЗарегистрироватьОшибку(СтрШаблон(ТекстСообщения, КодПайщика1Ф) + " Не удалось определить код продукта.");   
			Возврат;
		КонецЕсли;
		
		КодПортфеля = ПолучитьКодПортфеля(КодПайщика1Ф, КодПродукта, ПараметрыПодключения); 
		
		Если ЗначениеЗаполнено(КодПортфеля) Тогда
			
			ОбновитьДанныеПервойФормы(КодПортфеля, СтрокаАктива, ПараметрыПодключения, "183,184,189,204");
 	
		Иначе //добавляем запись
			
			МассивПараметров = Новый Массив;
			
			МассивПараметров.Добавить(Новый Структура("id, value", 98, КодПайщика1Ф)); 
			МассивПараметров.Добавить(Новый Структура("id, value", 189, Формат(СтрокаАктива.Цена, "ЧН=0; ЧГ=0")));
			МассивПараметров.Добавить(Новый Структура("id, value", 184, Формат(СтрокаАктива.Сумма, "ЧН=0; ЧГ=0")));
			МассивПараметров.Добавить(Новый Структура("id, value", 183, Формат(СтрокаАктива.Количество, "ЧН=0; ЧГ=0")));
	
			МассивПараметров.Добавить(Новый Структура("id, value", 207, КодПродукта));
							
			Если ЗначениеЗаполнено(СтрокаАктива.ФинРезультат) Тогда
		  		МассивПараметров.Добавить(Новый Структура("id, value", 204, Формат(СтрокаАктива.ФинРезультат, "ЧН=0; ЧГ=0"))); 
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаАктива.Доходность) Тогда
				МассивПараметров.Добавить(Новый Структура("id, value", 205, Формат(СтрокаАктива.Доходность, "ЧН=0; ЧГ=0")));
			КонецЕсли;
			
			МассивПараметров.Добавить(Новый Структура("id, value", 201, GUID)); 

			ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("subcatId, extParams", 43, МассивПараметров));
		
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks/create", ТелоЗапроса, ТекстСообщения, 1);
			
			Если HTTPОтвет = Неопределено Тогда
				ЗарегистрироватьОшибку(СтрШаблон(ТекстСообщения, КодПайщика1Ф));   
				Возврат;
			КонецЕсли; 
			
		КонецЕсли;
					
	КонецЦикла;
	
КонецПроцедуры

Процедура ЭкспортироватьПродуктыКлиента(Продукты, ПараметрыПодключения, КодПайщика1Ф = Неопределено)
				
	Продукты.Колонки.Добавить("КодПродукта", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(55)));
	
	ТекстСообщения = "Ошибка экспорта продуктов клиента [%1].";
		
	Для Каждого ТекПродукт Из Продукты Цикл 
		
		//Ищем продукт по GUID заявки
		КодПродукта = ПолучитьКодПродукта(ТекПродукт.УидЗаявки, ПараметрыПодключения);
		
		Если Не ЗначениеЗаполнено(КодПродукта) Тогда
						
			КодПайщика1Ф = ?(ЗначениеЗаполнено(КодПайщика1Ф), КодПайщика1Ф, ТекПродукт.КодПайщика1Ф); 
					
			КодАктива1Ф = ?(ЗначениеЗаполнено(ТекПродукт.КодАктива1Ф), ТекПродукт.КодАктива1Ф, ПолучитьКодАктива(ТекПродукт.Актив, ПараметрыПодключения)); 
		
			Если Не ЗначениеЗаполнено(КодАктива1Ф) Тогда
				ЗарегистрироватьОшибку(СтрШаблон(ТекстСообщения, КодПайщика1Ф) + " Не удалось получить код актива [" + ТекПродукт.Актив + "].");
				Возврат;
			КонецЕсли;
			
			МассивПараметров = Новый Массив;
		
			МассивПараметров.Добавить(Новый Структура("id, value", 98, КодПайщика1Ф));
			МассивПараметров.Добавить(Новый Структура("id, value", 197, "Заявка")); //для ИИС должно быть значение "Договор"
			МассивПараметров.Добавить(Новый Структура("id, value", 206, КодАктива1Ф));
			МассивПараметров.Добавить(Новый Структура("id, value", 218, ТекПродукт.ОсновнаяЗаявка)); //признак булево 1,0
			МассивПараметров.Добавить(Новый Структура("id, value", 193, ТекПродукт.НомерЗаявки));
			МассивПараметров.Добавить(Новый Структура("id, value", 196, Формат(ТекПродукт.ДатаЗаявки, "ДФ=гггг-ММ-дд"))); // или дата заключения договора (для ИИС)
			МассивПараметров.Добавить(Новый Структура("id, value", 201, Строка(ТекПродукт.УидЗаявки))); //GUID заявки

			Если ЗначениеЗаполнено(ТекПродукт.ДатаПогашения) Тогда
				МассивПараметров.Добавить(Новый Структура("id, value", 195, Формат(ТекПродукт.ДатаПогашения, "ДФ=гггг-ММ-дд"))); //дата закрытия, дата договора ИИС
			КонецЕсли;
			
			ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("subcatId, extParams", 41, МассивПараметров));
		
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks/create", ТелоЗапроса, ТекстСообщения);
			
			Если HTTPОтвет = Неопределено Тогда
				ЗарегистрироватьОшибку(ТекстСообщения); 
				Возврат;
			КонецЕсли; 
			
			ОтветОбъект = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8")); 
			КодПродукта = Формат(ОтветОбъект.data.value, "ЧГ=0");
			
		КонецЕсли;
		
		ТекПродукт.КодПродукта = КодПродукта;
							
	КонецЦикла;
							
КонецПроцедуры

Функция ПолучитьКодАктива(Актив, ПараметрыПодключения)
	
	//1. Если в регистре "Коды во внешних системах" не нашли код актива, пробуем найти (задачу) в первой форме по GUID.
	ТекстСообщения = "Не удалось получить код первой формы для актива [" + Актив + "].";
	
	GUID = Строка(Актив.УникальныйИдентификатор()); 
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("startRow", 0);
	СтруктураЗапроса.Вставить("endRow", 10);
	СтруктураЗапроса.Вставить("select", РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("field, type", "taskId", "numberValue")));
	СтруктураЗапроса.Вставить("filterModel", Новый Структура("ExtParam201", Новый Структура("filterType, type, filter", "text", "equals", GUID)));
	
	ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
		
	ТекстСообщения = "Не удалось получить данные актива из первой формы.";
		
	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api-core/datasource/subcat/47/data", ТелоЗапроса, ТекстСообщения); 
		
	КодПервойФормы = Неопределено;
	
	Если HTTPОтвет = Неопределено Тогда 
		ЗарегистрироватьОшибку(ТекстСообщения);
		Возврат Неопределено;		
	КонецЕсли;
	
	ОтветОбъект = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8")); 
	
	Если ОтветОбъект.Свойство("totalCount") И ОтветОбъект.Свойство("tasksDataSourceResponse") И ОтветОбъект.totalCount = 1 Тогда
		
		КодПервойФормы = Формат(ОтветОбъект.tasksDataSourceResponse[0].taskId, "ЧГ=0");
		
		//Если нашли данные в первой форме по GUID из 1С, но при этом нет записи в регистре "Коды во внешних системах" - это странно, сообщим об этом.
		//ЗарегистрироватьОшибку("Не удалось получить код первой формы [" + КодПервойФормы + "] для актива [" + Актив + "] из регистра коды во внешних системах.");
		
		Возврат КодПервойФормы;
		
	КонецЕсли; 
		
	//2. Если ничего не нашли по GUID, создаем объект в первой форме.				
	МассивПараметров = Новый Массив;
	
	Если ТипЗнч(Актив) = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды") Тогда 
		
		ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеквизитыПИФ.КраткоеНаименованиеФонда КАК Наименование
			|ИЗ
			|	РегистрСведений.РеквизитыПИФ.СрезПоследних(, ПаевойИнвестиционныйФонд = &Актив) КАК РеквизитыПИФ";
		Запрос.УстановитьПараметр("Актив", Актив);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			МассивПараметров.Добавить(Новый Структура("id, value", 122, Выборка.Наименование));
		Иначе
			ЗарегистрироватьОшибку("Не удалось получить код первой формы для актива [" + Актив + "]. Отсутствует наименование.");
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Актив) = Тип("СправочникСсылка.СтратегииИндивидуальногоИнвестирования") Тогда
		
		ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.СтратегииИндивидуальногоИнвестирования; 
		МассивПараметров.Добавить(Новый Структура("id, value", 122, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Актив, "Наименование")));
			
	Иначе
		ЗарегистрироватьОшибку("Для актива [" + Актив + "] не настроены правила импорта в первую форму.");
		Возврат Неопределено;			
	КонецЕсли;
	
	МассивПараметров.Добавить(Новый Структура("id, value", 201, GUID));
	
	ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("subcatId, extParams", 47, МассивПараметров));

	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks/create", ТелоЗапроса, ТекстСообщения);
	
	Если HTTPОтвет = Неопределено Тогда
		ЗарегистрироватьОшибку(ТекстСообщения);   
		Возврат Неопределено;
	КонецЕсли;
	
	//3. Фиксируем в регистре "Коды во внешних системах" код (задачи) из первой формы. 
	ОтветОбъект = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8")); 
	КодПервойФормы = Формат(ОтветОбъект.data.value, "ЧГ=0");
	
	РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(
		Актив, 
		Справочники.ВнешниеСистемы.ПерваяФормаМКБ,
		ГруппаОбъектов,
		КодПервойФормы);

	Возврат КодПервойФормы; 
			
КонецФункции 

Функция ПолучитьКодПродукта(УникальныйИдентификатор, ПараметрыПодключения, Продукты = Неопределено)
			
