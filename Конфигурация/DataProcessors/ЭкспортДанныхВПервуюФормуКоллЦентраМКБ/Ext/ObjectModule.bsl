      
Функция СформироватьДанныеДляЭкспорта(ПараметрыФормирования) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыПервойФормы.Объект КАК Объект,
		|	КодыПервойФормы.Код КАК Код
		|ПОМЕСТИТЬ _КодыПервойФормы
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&КонецПериода,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФормаМКБ)
		|				И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Валюты), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Банки), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды))) КАК КодыПервойФормы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Ссылка КАК Ссылка,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВложенныйЗапрос.Ссылка) КАК Уид,
		|	ВложенныйЗапрос.ДатаЗаявки КАК ДатаЗаявки,
		|	ВложенныйЗапрос.НомерЗаявки КАК НомерЗаявки,
		|	ВложенныйЗапрос.Пайщик КАК Пайщик,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВложенныйЗапрос.Пайщик) КАК УидФизЛица,
		|	ВложенныйЗапрос.Сумма КАК Сумма,
		|	ВложенныйЗапрос.Количество КАК Количество,
		|	ВложенныйЗапрос.Тип КАК Тип,
		|	ВложенныйЗапрос.Актив КАК Актив,
		|	ВложенныйЗапрос.Основная КАК Основная,
		|	ВложенныйЗапрос.ВидЗаявки КАК ВидЗаявки,
		|	ВложенныйЗапрос.Статус КАК Статус,
		|	_КодыПифовПервойФормы.Код КАК КодАктива1Ф,
		|	_КодыПайщиковПервойФормы.Код КАК КодПайщика1Ф
		|ПОМЕСТИТЬ _ЗаявкиПайщиков
		|ИЗ
		|	(ВЫБРАТЬ
		|		ДокЗаявкаПайщика.Ссылка КАК Ссылка,
		|		ДокЗаявкаПайщика.НомерЗаявки КАК НомерЗаявки,
		|		ДокЗаявкаПайщика.Дата КАК ДатаЗаявки,
		|		ДокЗаявкаПайщика.Пайщик КАК Пайщик,
		|		ДокЗаявкаПайщика.Сумма КАК Сумма,
		|		ДокЗаявкаПайщика.Количество КАК Количество,
		|		ДокЗаявкаПайщика.ВидЗаявки КАК ВидЗаявки,
		|		ВЫБОР
		|			КОГДА ДокЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Зачисление)
		|				ТОГДА ""Приобретение паев""
		|			КОГДА ДокЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Погашение)
		|				ТОГДА ""Погашение паев""
		|			КОГДА ДокЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Погашение)
		|				ТОГДА ""Обмен""
		|		КОНЕЦ КАК Тип,
		|		ВЫБОР
		|			КОГДА ДокЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен)
		|				ТОГДА ДокЗаявкаПайщика.ПаевойИнвестиционныйФондДляОбменаПаев
		|			ИНАЧЕ ДокЗаявкаПайщика.ПаевойИнвестиционныйФонд
		|		КОНЕЦ КАК Актив,
		|		ДокЗаявкаПайщика.ВыгружатьОперацииВЕСИАФинанс КАК Основная,
		|		СтатусыЗаявокПайщиковСрезПоследних.Статус КАК Статус
		|	ИЗ
		|		Документ.ЗаявкаПайщика КАК ДокЗаявкаПайщика
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ФизЛица
		|			ПО ДокЗаявкаПайщика.Пайщик = ФизЛица.Ссылка
		|				И (ДокЗаявкаПайщика.Организация = &Организация)
		|				И (ДокЗаявкаПайщика.Дата МЕЖДУ &НачалоПериода И &КонецПериода)
		|				И (ФизЛица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо))
		|				И (НЕ ДокЗаявкаПайщика.ПометкаУдаления)
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЗаявокПайщиков.СрезПоследних(, Организация = &Организация) КАК СтатусыЗаявокПайщиковСрезПоследних
		|			ПО ДокЗаявкаПайщика.Ссылка = СтатусыЗаявокПайщиковСрезПоследних.ЗаявкаПайщика) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыПервойФормы КАК _КодыПифовПервойФормы
		|		ПО ВложенныйЗапрос.Актив = _КодыПифовПервойФормы.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыПервойФормы КАК _КодыПайщиковПервойФормы
		|		ПО ВложенныйЗапрос.Пайщик = _КодыПайщиковПервойФормы.Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Актив КАК Актив,
		|	КлиентыПИФ.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ СчетаПиф
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ЗаявкиПайщиков.Актив КАК Актив
		|	ИЗ
		|		_ЗаявкиПайщиков КАК _ЗаявкиПайщиков) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&КонецПериода, Организация = &Организация) КАК КлиентыПИФ
		|		ПО ВложенныйЗапрос.Актив = КлиентыПИФ.Клиент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КодыПервойФормы.Код КАК Код1Ф,
		|	РеквизитыФизическихЛицАнкетные.Регистратор КАК Анкета,
		|	РеквизитыФизическихЛицАнкетные.ЮрФизЛицо КАК Клиент,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(РеквизитыФизическихЛицАнкетные.ЮрФизЛицо) КАК УидФизЛица,
		|	РеквизитыФизическихЛицАнкетные.Фамилия КАК Фамилия,
		|	РеквизитыФизическихЛицАнкетные.Имя КАК Имя,
		|	РеквизитыФизическихЛицАнкетные.Отчество КАК Отчество,
		|	РеквизитыФизическихЛицАнкетные.Пол КАК Пол,
		|	РеквизитыФизическихЛицАнкетные.ДатаРождения КАК ДатаРождения,
		|	РеквизитыФизическихЛицАнкетные.СерияУдостоверенияЛичности КАК СерияДокумента,
		|	РеквизитыФизическихЛицАнкетные.НомерУдостоверенияЛичности КАК НомерДокумента,
		|	РеквизитыФизическихЛицАнкетные.ДатаВыдачиУдостоверенияЛичности КАК ДатаВыдачиДокумента,
		|	РеквизитыФизическихЛицАнкетные.ДатаОкончанияДействияУдостоверенияЛичности КАК ДатаОкончанияДействияДокумента,
		|	РеквизитыФизическихЛицАнкетные.ОрганВыдавшийУдостоверениеЛичности КАК ОрганВыдавшийДокумент,
		|	РеквизитыФизическихЛицАнкетные.КодОрганаВыдавшегоУдостоверениеЛичности КАК КодПодразделения,
		|	РеквизитыФизическихЛицАнкетные.СНИЛС КАК СНИЛС,
		|	РеквизитыФизическихЛицАнкетные.ИНН КАК ИНН,
		|	РеквизитыФизическихЛицАнкетные.EMail КАК EMail,
		|	РеквизитыФизическихЛицАнкетные.Телефоны КАК Телефоны
		|ПОМЕСТИТЬ _АнкетныеДанныеКлиентов
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_ЗаявкиПайщиков.Пайщик
		|					ИЗ
		|						_ЗаявкиПайщиков КАК _ЗаявкиПайщиков)) КАК РеквизитыФизическихЛицАнкетные
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыПервойФормы КАК _КодыПервойФормы
		|		ПО РеквизитыФизическихЛицАнкетные.ЮрФизЛицо = _КодыПервойФормы.Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(АнкетаФизическогоЛицаБанковскиеРеквизиты.РасчетныйСчет) КАК Уид,
		|	_АнкетныеДанныеКлиентов.УидФизЛица КАК УидФизЛица,
		|	АнкетаФизическогоЛицаБанковскиеРеквизиты.БИК КАК БИК,
		|	Банки.Ссылка КАК Банк,
		|	АнкетаФизическогоЛицаБанковскиеРеквизиты.НомерСчета КАК РасчетныйСчет,
		|	АнкетаФизическогоЛицаБанковскиеРеквизиты.КоррСчет КАК КоррСчет,
		|	_КодыПервойФормы.Код КАК КодБанка1Ф
		|ПОМЕСТИТЬ _БанковскиеРеквизиты
		|ИЗ
		|	Документ.АнкетаФизическогоЛица.БанковскиеРеквизиты КАК АнкетаФизическогоЛицаБанковскиеРеквизиты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _АнкетныеДанныеКлиентов КАК _АнкетныеДанныеКлиентов
		|		ПО АнкетаФизическогоЛицаБанковскиеРеквизиты.Ссылка = _АнкетныеДанныеКлиентов.Анкета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Банки КАК Банки
		|			ЛЕВОЕ СОЕДИНЕНИЕ _КодыПервойФормы КАК _КодыПервойФормы
		|			ПО Банки.Ссылка = _КодыПервойФормы.Объект
		|		ПО АнкетаФизическогоЛицаБанковскиеРеквизиты.РасчетныйСчет.Банк = Банки.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗаявкиПайщиков.Ссылка КАК ЗавкаПайщика,
		|	_ЗаявкиПайщиков.Пайщик КАК Пайщик,
		|	_ЗаявкиПайщиков.УидФизЛица КАК УидФизЛица,
		|	_ЗаявкиПайщиков.НомерЗаявки КАК НомерЗаявки,
		|	_ЗаявкиПайщиков.ДатаЗаявки КАК ДатаЗаявки,
		|	_ЗаявкиПайщиков.Статус КАК Статус,
		|	_ЗаявкиПайщиков.Актив КАК Актив,
		|	""Ввод денежных средств"" КАК Тип,
		|	ДокВводДенежныхСредств.Ссылка КАК Ссылка,
		|	ДокВводДенежныхСредств.Дата КАК Дата,
		|	ДокВводДенежныхСредств.Сумма КАК Сумма,
		|	0 КАК СуммаНДФЛ
		|ПОМЕСТИТЬ _ВводыВыводыДенежныхСредств
		|ИЗ
		|	_ЗаявкиПайщиков КАК _ЗаявкиПайщиков
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВводДенежныхСредств КАК ДокВводДенежныхСредств
		|		ПО _ЗаявкиПайщиков.Ссылка = ДокВводДенежныхСредств.Основание
		|			И (ДокВводДенежныхСредств.Проведен)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_ЗаявкиПайщиков.Ссылка,
		|	_ЗаявкиПайщиков.Пайщик,
		|	_ЗаявкиПайщиков.УидФизЛица,
		|	_ЗаявкиПайщиков.НомерЗаявки,
		|	_ЗаявкиПайщиков.ДатаЗаявки,
		|	_ЗаявкиПайщиков.Статус,
		|	_ЗаявкиПайщиков.Актив,
		|	""Вывод денежных средств"",
		|	ДокВыводДенежныхСредств.Ссылка,
		|	ДокВыводДенежныхСредств.Дата,
		|	ДокВыводДенежныхСредств.Сумма,
		|	ДокВыводДенежныхСредств.СуммаНДФЛ
		|ИЗ
		|	_ЗаявкиПайщиков КАК _ЗаявкиПайщиков
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыводДенежныхСредств КАК ДокВыводДенежныхСредств
		|		ПО _ЗаявкиПайщиков.Ссылка = ДокВыводДенежныхСредств.Основание
		|			И (ДокВыводДенежныхСредств.Проведен)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗаявкиПайщиков.Ссылка КАК ЗаявкаПайщика,
		|	_ЗаявкиПайщиков.Пайщик КАК Пайщик,
		|	_ЗаявкиПайщиков.УидФизЛица КАК УидФизЛица,
		|	_ЗаявкиПайщиков.НомерЗаявки КАК НомерЗаявки,
		|	_ЗаявкиПайщиков.ДатаЗаявки КАК ДатаЗаявки,
		|	_ЗаявкиПайщиков.Статус КАК Статус,
		|	_ЗаявкиПайщиков.Актив КАК Актив,
		|	ДокЗачислениеПаев.Ссылка КАК Ссылка,
		|	ДокЗачислениеПаев.Дата КАК Дата,
		|	ДокЗачислениеПаев.Количество КАК Количество,
		|	ДокЗачислениеПаев.Сумма КАК Сумма,
		|	ДокЗачислениеПаев.СуммаНадбавки КАК СуммаНадбавки
		|ПОМЕСТИТЬ _ЗачисленияПаев
		|ИЗ
		|	_ЗаявкиПайщиков КАК _ЗаявкиПайщиков
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗачислениеПаев КАК ДокЗачислениеПаев
		|		ПО _ЗаявкиПайщиков.Ссылка = ДокЗачислениеПаев.Заявка
		|			И (ДокЗачислениеПаев.Проведен)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗачисленияПаев.ЗаявкаПайщика КАК ЗавкаПайщика,
		|	_ЗачисленияПаев.Пайщик КАК Пайщик,
		|	_ЗачисленияПаев.УидФизЛица КАК УидФизЛица,
		|	_ЗачисленияПаев.НомерЗаявки КАК НомерЗаявки,
		|	_ЗачисленияПаев.ДатаЗаявки КАК ДатаЗаявки,
		|	_ЗачисленияПаев.Статус КАК Статус,
		|	_ЗачисленияПаев.Актив КАК Актив,
		|	""Приобретение паев"" КАК Тип,
		|	_ЗачисленияПаев.Ссылка КАК Ссылка,
		|	_ЗачисленияПаев.Дата КАК Дата,
		|	_ЗачисленияПаев.Количество КАК Количество,
		|	_ЗачисленияПаев.Сумма КАК Сумма,
		|	_ЗачисленияПаев.СуммаНадбавки КАК СуммаНадбавки
		|ПОМЕСТИТЬ _ЗачисленияПогашенияПаев
		|ИЗ
		|	_ЗачисленияПаев КАК _ЗачисленияПаев
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_ЗаявкиПайщиков.Ссылка,
		|	_ЗаявкиПайщиков.Пайщик,
		|	_ЗаявкиПайщиков.УидФизЛица,
		|	_ЗаявкиПайщиков.НомерЗаявки,
		|	_ЗаявкиПайщиков.ДатаЗаявки,
		|	_ЗачисленияПаев.Статус,
		|	_ЗаявкиПайщиков.Актив,
		|	""Погашение паев"",
		|	ДокПогашениеПаев.Ссылка,
		|	ДокПогашениеПаев.Дата,
		|	ДокПогашениеПаев.Количество,
		|	ДокПогашениеПаев.Сумма,
		|	0
		|ИЗ
		|	_ЗаявкиПайщиков КАК _ЗаявкиПайщиков
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПогашениеПаев КАК ДокПогашениеПаев
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПогашениеПаев.Партии КАК ДокПогашениеПаевПартии
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ЗачисленияПаев КАК _ЗачисленияПаев
		|				ПО ДокПогашениеПаевПартии.ЗачислениеПаев = _ЗачисленияПаев.Ссылка
		|			ПО ДокПогашениеПаев.Ссылка = ДокПогашениеПаевПартии.Ссылка
		|		ПО _ЗаявкиПайщиков.Ссылка = ДокПогашениеПаев.Заявка
		|			И (ДокПогашениеПаев.Проведен)
		|;
		|
