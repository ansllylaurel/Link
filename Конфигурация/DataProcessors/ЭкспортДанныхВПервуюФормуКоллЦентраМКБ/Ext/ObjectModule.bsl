	СтруктураЗапроса.Вставить(РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("field, type, extParamType", "taskId", "numberValue")));
	СтруктураЗапроса.Вставить("filterModel", Новый Структура("ExtParam201")); //, ExtParam218, ExtParam98"));
	СтруктураЗапроса.filterModel.ExtParam201 = Новый Структура("filterType, type, filter", "text", "equals", Строка(УникальныйИдентификатор)); 
	
	//СтруктураЗапроса.filterModel.ExtParam98 = Новый Структура("filterType, type, customInfo", "text", "equals", Новый Структура("taskId, option", 0, КодПайщика1Ф));
	//СтруктураЗапроса.filterModel.ExtParam218 = Новый СТруктура("filterType, values", "set", РаботаСКоллекциями.ЗначениеВМассив(Формат(ФлагОсновнаяЗаявка, "БЛ=false; БИ=true")));

	ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
	
	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api-core/datasource/Subcat/41/data", ТелоЗапроса, ТекстСообщения);
	
	Если HTTPОтвет = Неопределено Тогда
		ЗарегистрироватьОшибку(ТекстСообщения);   
		Возврат Неопределено;
	КонецЕсли;
	
	ОтветОбъект = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
	
	Если ТипЗнч(ОтветОбъект) = Тип("Структура") И ОтветОбъект.Свойство("tasksDataSourceResponse") И ОтветОбъект.Свойство("totalCount") И ОтветОбъект.totalCount = 1 Тогда 
		
		Возврат Формат(ОтветОбъект.tasksDataSourceResponse[0].task.taskId, "ЧГ=0");
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;

