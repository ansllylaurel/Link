		|	ВЫРАЗИТЬ(_ОстаткиИтоги.Цена КАК ЧИСЛО(19, 4)) КАК Цена,
		|	ВЫРАЗИТЬ(_ОстаткиИтоги.Сумма КАК ЧИСЛО(19, 4)) КАК Сумма,
		|	ВЫРАЗИТЬ(_ОстаткиИтоги.Количество КАК ЧИСЛО(19, 4)) КАК Количество,
		|	ВЫРАЗИТЬ(_ОстаткиИтоги.ФинРезультат КАК ЧИСЛО(19, 4)) КАК ФинРезультат,
		|	0 КАК Доходность,
		|	_ОстаткиИтоги.КодПайщика1Ф КАК КодПайщика1Ф
		|ИЗ
		|	_ОстаткиИтоги КАК _ОстаткиИтоги";
#КонецОбласти

    Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Пайщик", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗадачаСсылка, "Пайщик"));
	Запрос.УстановитьПараметр("Пиф", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаявкаСсылка, "ПаевойИнвестиционныйФонд"));
	Запрос.УстановитьПараметр("Заявка", ЗаявкаСсылка);

	ПортфельКлиента = Запрос.Выполнить().Выгрузить(); 
	
	ПродуктыКлиента = Запрос.МенеджерВременныхТаблиц.Таблицы["_ПродуктыКлиента"].ПолучитьДанные().Выгрузить();

	ЭкспортироватьПродуктыКлиента(ПродуктыКлиента, ПараметрыПодключения);

	ТаблицаОпераций = Запрос.МенеджерВременныхТаблиц.Таблицы["_Операции"].ПолучитьДанные().Выгрузить();
		
	ЭкспортироватьОперацииКлиента(ТаблицаОпераций, ПараметрыПодключения,, ПродуктыКлиента);
		
	ЭкспортироватьПортфельКлиента(ПортфельКлиента, ПараметрыПодключения,, ПродуктыКлиента);
	
	ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, Отказ);
		
КонецПроцедуры 

