Функция СформироватьПараметрКонтактов(КонтактыКлиента)
	
	ПараметрКонтактов = Новый Структура("id, value", 164, Новый Структура("rows", Новый Массив));
		
	Для Инд = 0 По КонтактыКлиента.Количество() - 1 Цикл
		
		СтруктураСтрокиКонтактов = Новый Структура("cols",
									РаботаСКоллекциями.ЗначенияВМассив(
										Новый Структура("id, value", 1, КонтактыКлиента[Инд].АдресНомер),
										Новый Структура("id, value, dataSourceItemId", 2, КонтактыКлиента[Инд].ТипСвязи, КонтактыКлиента[Инд].ТипСвязи)));
													
		СтруктураСтрокиКонтактов.Вставить("id", Инд + 1);
		СтруктураСтрокиКонтактов.Вставить("modifyType", "create");
						
		ПараметрКонтактов.value.rows.Добавить(СтруктураСтрокиКонтактов);		
								
	КонецЦикла;
	
	Возврат ПараметрКонтактов;
		
КонецФункции

Функция ПолучитьКодыБанковИзПервойФормы(БанковскиеРеквизиты, ПараметрыПодключения)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БанковскиеРеквизиты.БИК КАК БИК,
		|	БанковскиеРеквизиты.Банк КАК Банк,
		|	БанковскиеРеквизиты.КодБанка1Ф КАК КодБанка1Ф
		|ПОМЕСТИТЬ _БанковскиеРеквизиты
		|ИЗ
		|	&БанковскиеРеквизиты КАК БанковскиеРеквизиты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_БанковскиеРеквизиты.БИК КАК БИК,
		|	_БанковскиеРеквизиты.Банк КАК Банк,
		|	_БанковскиеРеквизиты.КодБанка1Ф КАК КодБанка1Ф
		|ИЗ
		|	_БанковскиеРеквизиты КАК _БанковскиеРеквизиты
		|ГДЕ
		|	_БанковскиеРеквизиты.КодБанка1Ф = """"";
	Запрос.УстановитьПараметр("БанковскиеРеквизиты", БанковскиеРеквизиты); 
	
	ТаблицаБанков = Запрос.Выполнить().Выгрузить();
				
	Если ТаблицаБанков.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("startRow", 0);
	СтруктураЗапроса.Вставить("endRow", 10);
	СтруктураЗапроса.Вставить("select", РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("field, type", "taskId", "numberValue")));
	СтруктураЗапроса.Вставить("filterModel", Новый Структура("ExtParam174", Новый Структура("filterType, type, filter", "text", "equals")));
	
	Для Инд = 1 - ТаблицаБанков.Количество() По 0 Цикл 
		
		ТекСтрока = ТаблицаБанков[-Инд];

		ТекстСообщения = "Не удалось получить данные первой формы для юр. лица [" + ТекСтрока.Банк + "] по коду БИК [" + ТекСтрока.БИК + "]";
		
		СтруктураЗапроса.filterModel.ExtParam174.filter = ТекСтрока.БИК; 
		
		ТелоЗапроса =  ПолучитьСтрокуJSON(СтруктураЗапроса);
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api-core/datasource/subcat/44/data", ТелоЗапроса, ТекстСообщения);

		Если HTTPОтвет = Неопределено Тогда
			ЗарегистрироватьОшибку(ТекстСообщения);
			ТаблицаБанков.Удалить(-Инд);
			Продолжить;
		КонецЕсли;
		
		ОтветОбъект = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
		
		Если ТипЗнч(ОтветОбъект) = Тип("Структура") И ОтветОбъект.Свойство("tasksDataSourceResponse") И ОтветОбъект.Свойство("totalCount") И ОтветОбъект.totalCount <> 1 Тогда
			ЗарегистрироватьОшибку("Не удалось получить код первой формы для юр. лица [" + ТекСтрока.Банк + "].");
			ТаблицаБанков.Удалить(-Инд);
			Продолжить;
		КонецЕсли;
		
		КодПервойФормы = Формат(ОтветОбъект.tasksDataSourceResponse[0].task.taskId, "ЧГ=0");
		
		РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(
			ТекСтрока.Банк, 
			Справочники.ВнешниеСистемы.ПерваяФормаМКБ, 
			Справочники.ГруппыИмпортируемыхОбъектов.Банки,
			КодПервойФормы);
			
		ТекСтрока.КодБанка1Ф = КодПервойФормы;	
			
	КонецЦикла;
	
	Возврат ТаблицаБанков; 
		
КонецФункции

Функция ПолучитьСтрокуJSON(СтруктураДанных)
	
	ЗаписьJSON          = Новый ЗаписьJSON;
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

Функция ДесериализоватьСтрокуJSON(СтрокаJSON)
	
	ЧтениеJSON = Новый ЧтениеJSON();
    ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
    Возврат ПрочитатьJSON(ЧтениеJSON);
	
КонецФункции

//бизнес процесс
Функция АктивированМеханизмЭкспортаДанных(Организация) 
	
	Если Не ПараметрыСеанса.ЭтоРабочаяИнформационнаяБаза Тогда
		Возврат Ложь;
	КонецЕсли;
			
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияДополнительныхСведений.Значение КАК ФлагАктивирован
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Объект = &Организация
		|	И ЗначенияДополнительныхСведений.Свойство.Ключ = ""АктивированМеханизмЭкспортаДанныхВПервуюФормуКоллЦентраМКБ""";
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ФлагАктивирован;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Процедура ЭкспортироватьДанныеЗаявки(ЗадачаСсылка, Отказ) Экспорт
	
	ЗначениеРеквизитовЗадачи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗадачаСсылка, "Дата, Основание, Организация");
	
	Если Не АктивированМеханизмЭкспортаДанных(ЗначениеРеквизитовЗадачи.Организация) Тогда
		Возврат;	
	КонецЕсли;
	
	Механизм = Метаданные.Обработки.ЭкспортДанныхВПервуюФормуКоллЦентраМКБ.Имя + ".ЭкспортироватьДанныеЗаявки()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(Новый Структура("Организация, Задача, Заявка", ЗначениеРеквизитовЗадачи.Организация, ЗадачаСсылка, ЗначениеРеквизитовЗадачи.Основание));
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ПараметрыПодключения = РаботаСВнешнимиСистемами.ПерваяФорма_ПолучитьПараметрыПодключения("uk1f.region.ru",, "robot", "NrfSwGNs6hcgX2uXA390");
	
	Если ПараметрыПодключения = Неопределено Тогда		
		ЗарегистрироватьОкончаниеСессии(Механизм, Сессия, "Ошибка подключения к первой форме.", Отказ);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область Текст_Запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокЗаявкаПайщика.Ссылка КАК Ссылка,
		|	ДокЗаявкаПайщика.НомерЗаявки КАК НомерЗаявки,
		|	ДокЗаявкаПайщика.Дата КАК ДатаЗаявки,
		|	ДокЗаявкаПайщика.Пайщик КАК Пайщик,
		|	ВЫБОР
		|		КОГДА ДокЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Зачисление)
		|			ТОГДА ""Приобретение паев""
		|		КОГДА ДокЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Погашение)
		|			ТОГДА ""Погашение паев""
		|		КОГДА ДокЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен)
		|			ТОГДА ""Обмен паев""
		|	КОНЕЦ КАК Тип,
		|	ВЫБОР
		|		КОГДА ДокЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен)
		|			ТОГДА ДокЗаявкаПайщика.ПаевойИнвестиционныйФондДляОбменаПаев
		|		ИНАЧЕ ДокЗаявкаПайщика.ПаевойИнвестиционныйФонд
		|	КОНЕЦ КАК Актив,
		|	ДокЗаявкаПайщика.Сумма КАК Сумма,
		|	ДокЗаявкаПайщика.Количество КАК Количество,
		|	ДокЗаявкаПайщика.ВыгружатьОперацииВЕСИАФинанс КАК ОсновнаяЗаявка,
		|	СтатусыЗаявокПайщиковСрезПоследних.Статус КАК Статус
		|ПОМЕСТИТЬ _ДанныеЗаявки
		|ИЗ
		|	Документ.ЗаявкаПайщика КАК ДокЗаявкаПайщика
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЗаявокПайщиков.СрезПоследних(, Организация = &Организация) КАК СтатусыЗаявокПайщиковСрезПоследних
		|		ПО ДокЗаявкаПайщика.Ссылка = СтатусыЗаявокПайщиковСрезПоследних.ЗаявкаПайщика
		|ГДЕ
		|	ДокЗаявкаПайщика.Ссылка = &ЗаявкаСсылка
		|	И НЕ ДокЗаявкаПайщика.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыПервойФормы.Объект КАК Объект,
		|	КодыПервойФормы.Код КАК Код
		|ПОМЕСТИТЬ _КодыПервойФормыМКБ
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФормаМКБ)
		|				И Объект В
		|					(ВЫБРАТЬ
		|						_ДанныеЗаявки.Пайщик
		|					ИЗ
		|						_ДанныеЗаявки КАК _ДанныеЗаявки
		|			
		|					ОБЪЕДИНИТЬ
		|			
		|					ВЫБРАТЬ
		|						_ДанныеЗаявки.Актив
		|					ИЗ
		|						_ДанныеЗаявки КАК _ДанныеЗаявки)
		|				И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды))) КАК КодыПервойФормы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВложенныйЗапрос.УидЗаявки КАК УидЗаявки,
		|	ВложенныйЗапрос.Актив КАК Актив,
		|	ВложенныйЗапрос.Пайщик КАК Пайщик,
		|	ВложенныйЗапрос.ДатаЗаявки КАК ДатаЗаявки,
		|	ВложенныйЗапрос.НомерЗаявки КАК НомерЗаявки,
		|	ВложенныйЗапрос.ОсновнаяЗаявка КАК ОсновнаяЗаявка,
		|	КодыПайщиков.Код КАК КодПайщика1Ф,
		|	КодыАктивов.Код КАК КодАктива1Ф,
		|	NULL КАК ДатаПогашения
		|ПОМЕСТИТЬ _ДанныеПродукта
		|ИЗ
		|	(ВЫБРАТЬ
		|		УНИКАЛЬНЫЙИДЕНТИФИКАТОР(_ДанныеЗаявки.Ссылка) КАК УидЗаявки,
		|		_ДанныеЗаявки.Актив КАК Актив,
		|		_ДанныеЗаявки.Пайщик КАК Пайщик,
		|		_ДанныеЗаявки.ДатаЗаявки КАК ДатаЗаявки,
		|		_ДанныеЗаявки.НомерЗаявки КАК НомерЗаявки,
		|		_ДанныеЗаявки.ОсновнаяЗаявка КАК ОсновнаяЗаявка
		|	ИЗ
		|		_ДанныеЗаявки КАК _ДанныеЗаявки
		|	ГДЕ
		|		_ДанныеЗаявки.Тип = ""Приобретение паев""
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ ПЕРВЫЕ 1
		|		УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЗаявкаНаПриобретение.Ссылка),
		|		ЗаявкаНаПриобретение.ПаевойИнвестиционныйФонд,
		|		ЗаявкаНаПриобретение.Пайщик,
		|		ЗаявкаНаПриобретение.Дата,
		|		ЗаявкаНаПриобретение.НомерЗаявки,
		|		ЗаявкаНаПриобретение.ВыгружатьОперацииВЕСИАФинанс
		|	ИЗ
		|		_ДанныеЗаявки КАК _ДанныеЗаявки
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаПайщика КАК ЗаявкаНаПриобретение
		|			ПО _ДанныеЗаявки.Пайщик = ЗаявкаНаПриобретение.Пайщик
		|				И _ДанныеЗаявки.Актив = ЗаявкаНаПриобретение.ПаевойИнвестиционныйФонд
		|				И _ДанныеЗаявки.ОсновнаяЗаявка = ЗаявкаНаПриобретение.ВыгружатьОперацииВЕСИАФинанс
		|				И (ЗаявкаНаПриобретение.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Зачисление))
		|				И (НЕ ЗаявкаНаПриобретение.ПометкаУдаления)
		|				И (_ДанныеЗаявки.Тип = ""Погашение паев"")) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыПервойФормыМКБ КАК КодыПайщиков
		|		ПО ВложенныйЗапрос.Пайщик = КодыПайщиков.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыПервойФормыМКБ КАК КодыАктивов
		|		ПО ВложенныйЗапрос.Актив = КодыАктивов.Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеПродукта.УидЗаявки КАК УидЗаявки,
		|	_ДанныеЗаявки.Пайщик КАК Пайщик,
		|	_ДанныеЗаявки.НомерЗаявки КАК НомерЗаявки,
		|	_ДанныеЗаявки.ДатаЗаявки КАК ДатаЗаявки,
		|	_ДанныеЗаявки.Тип КАК Тип,
		|	_ДанныеЗаявки.ОсновнаяЗаявка КАК ОсновнаяЗаявка,
		|	_ДанныеЗаявки.Статус КАК Статус,
		|	ВЫБОР
		|		КОГДА _ДанныеЗаявки.Количество > 0
		|			ТОГДА ВЫРАЗИТЬ(_ДанныеЗаявки.Сумма / _ДанныеЗаявки.Количество КАК ЧИСЛО(19, 4))
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Цена,
		|	ВЫРАЗИТЬ(_ДанныеЗаявки.Сумма КАК ЧИСЛО(19, 4)) КАК Сумма,
		|	ВЫРАЗИТЬ(_ДанныеЗаявки.Количество КАК ЧИСЛО(19, 4)) КАК Количество,
		|	_ДанныеПродукта.КодПайщика1Ф КАК КодПайщика1Ф,
		|	NULL КАК Уид,
		|	NULL КАК Дата,
		|	0 КАК СуммаНДФЛ,
		|	0 КАК СкидкаНадбавка
		|ПОМЕСТИТЬ _ДанныеЗаявкиПайщика
		|ИЗ
		|	_ДанныеЗаявки КАК _ДанныеЗаявки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеПродукта КАК _ДанныеПродукта
		|		ПО _ДанныеЗаявки.Актив = _ДанныеПродукта.Актив
		|			И _ДанныеЗаявки.Пайщик = _ДанныеПродукта.Пайщик
		|			И _ДанныеЗаявки.ОсновнаяЗаявка = _ДанныеПродукта.ОсновнаяЗаявка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеЗаявкиПайщика.Пайщик КАК Пайщик,
		|	_ДанныеЗаявкиПайщика.НомерЗаявки КАК Номер,
		|	_ДанныеЗаявкиПайщика.Тип КАК Тип,
		|	_ДанныеЗаявкиПайщика.ОсновнаяЗаявка КАК Основная,
		|	""Ошибка экспорта заявки пайщика [%1], номер [%2], тип заявки [%3]. Не удалось определить завку на приобретение паев со значением реквизита ВыгружатьОперацииВЕСИАФинанс [%4]."" КАК Текст
		|ПОМЕСТИТЬ _ОшибкиЗаявок
		|ИЗ
		|	_ДанныеЗаявкиПайщика КАК _ДанныеЗаявкиПайщика
		|ГДЕ
		|	_ДанныеЗаявкиПайщика.Тип В (""Погашение паев"", ""Обмен паев"")
		|	И _ДанныеЗаявкиПайщика.КодПайщика1Ф ЕСТЬ NULL
		|	И _ДанныеЗаявкиПайщика.УидЗаявки ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Звездочка КАК Звездочка
		|ИЗ
		|	_ДанныеЗаявкиПайщика КАК _ДанныеЗаявкиПайщика
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиЗаявок КАК _ОшибкиЗаявок
		|		ПО _ДанныеЗаявкиПайщика.НомерЗаявки = _ОшибкиЗаявок.Номер
		|			И _ДанныеЗаявкиПайщика.Пайщик = _ОшибкиЗаявок.Пайщик
		|ГДЕ
		|	НЕ _ДанныеЗаявкиПайщика.КодПайщика1Ф ЕСТЬ NULL
		|	И _ОшибкиЗаявок.Номер ЕСТЬ NULL";
#КонецОбласти

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");

	Запрос.УстановитьПараметр("ЗаявкаСсылка", ЗначениеРеквизитовЗадачи.Основание);
	Запрос.УстановитьПараметр("Организация", ЗначениеРеквизитовЗадачи.Организация);

	ДанныеЗаявкиПайщика = Запрос.Выполнить().Выгрузить();
	
