
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, "Организация, ВидНовогоДокумента");
	
	Если Параметры.Свойство("Сумма") Тогда
		ЭтаФорма.Сумма = Параметры.Сумма;
	КонецЕсли;
	
	Если Параметры.Свойство("Валюта") Тогда
		ЭтаФорма.Валюта = Параметры.Валюта;
	Иначе
		ЭтаФорма.Валюта = ЭтаФорма.Организация.ВалютаУчета;
	КонецЕсли;
	
	Если Параметры.Свойство("СчетДоверительногоУправления") Тогда
		ЭтаФорма.СчетДоверительногоУправления = Параметры.СчетДоверительногоУправления;
	КонецЕсли;
	
	Если ЭтаФорма.ВидНовогоДокумента = "Поручение" Тогда 
		
		ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + " [Поручение на движение денежных средств]";
		
		Если Параметры.Свойство("РасчетныйСчет") Тогда
			ЭтаФорма.РасчетныйСчет = Параметры.РасчетныйСчет;
		КонецЕсли;

		ЭтаФорма.ДатаИсполненияС  = ТекущаяДатаСеанса();
		ЭтаФорма.ДатаИсполненияПо = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ЭтаФорма.ДатаИсполненияС, 5);
		
	ИначеЕсли ЭтаФорма.ВидНовогоДокумента = "Оплата" Или ЭтаФорма.ВидНовогоДокумента = "ОплатаАванс" Тогда
		
		ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + " [Оплата]";
		
		Если Параметры.Свойство("ВидЗадолженности") Тогда
			ЭтаФорма.ВидЗадолженности = Параметры.ВидЗадолженности;
		КонецЕсли; 
		
		Если Параметры.Свойство("Контрагент") Тогда
			ЭтаФорма.Контрагент = Параметры.Контрагент;
		КонецЕсли;
		
		Если Параметры.Свойство("Договор") Тогда
			ЭтаФорма.Договор = Параметры.Договор;
		КонецЕсли;

	ИначеЕсли ЭтаФорма.ВидНовогоДокумента = "ВыводДенежныхСредств" Тогда

    	ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + " [Вывод денежных средств]";
		ЭтаФорма.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению;
		
		Если Параметры.Свойство("Контрагент") Тогда
			ЭтаФорма.Контрагент = Параметры.Контрагент;
		КонецЕсли;
		
		Если Параметры.Свойство("РасчетныйСчет") Тогда
			ЭтаФорма.РасчетныйСчет = Параметры.РасчетныйСчет;
		КонецЕсли;
		
		Если Параметры.Свойство("РасчетныйСчетПолучатель") Тогда
			ЭтаФорма.РасчетныйСчетПолучатель = Параметры.РасчетныйСчетПолучатель;
		КонецЕсли;
		
	ИначеЕсли ЭтаФорма.ВидНовогоДокумента = "ВводДенежныхСредств" Тогда
		
		ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + " [Ввод денежных средств]";
		ЭтаФорма.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление;
				
		ЭтаФорма.Контрагент = РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицоСчетаДоверительногоУправления(ЭтаФорма.СчетДоверительногоУправления, ТекущаяДата());
		
		Если Параметры.Свойство("РасчетныйСчет") Тогда
			ЭтаФорма.РасчетныйСчет = Параметры.РасчетныйСчет;
		КонецЕсли;
		
		Если Параметры.Свойство("РасчетныйСчетПолучатель") Тогда
			ЭтаФорма.РасчетныйСчетПолучатель = Параметры.РасчетныйСчетПолучатель;
		КонецЕсли;
				
	КонецЕсли; 
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
				
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьДокумент(Команда)
		
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеДокумента = Новый Структура("СчетДоверительногоУправления, ВидЗадолженности, Сумма, Валюта, РасчетныйСчет, РасчетныйСчетПолучатель, Контрагент, Договор, ДатаИсполненияС, ДатаИсполненияПо, ВидОперации");
	
	ЗаполнитьЗначенияСвойств(ДанныеДокумента, ЭтаФорма);
	
	Закрыть(ДанныеДокумента);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСчетИзНастроекУчетаДоходовПоЦеннымБумагам(Организация, СчетДоверительногоУправления, Валюта)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.РасчетныйСчет КАК РасчетныйСчет
		|ИЗ
		|	РегистрСведений.НастройкиУчетаДоходовПоЦеннымБумагам.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Валюта = &Валюта) КАК НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Организация", Организация);
    Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда 
		
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл 
			
			Возврат Выборка.РасчетныйСчет;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма) 
	
	ЭтоПоручение = (Форма.ВидНовогоДокумента = "Поручение");
	ЭтоВывод = (Форма.ВидНовогоДокумента = "ВыводДенежныхСредств");
	ЭтоВвод = (Форма.ВидНовогоДокумента = "ВводДенежныхСредств");
	ЭтоАванс = (Форма.ВидНовогоДокумента = "ОплатаАванс");
	ЭтоОплата = (Форма.ВидНовогоДокумента = "Оплата");
	
	Форма.Элементы.Контрагент.Видимость = Не (ЭтоПоручение Или ЭтоВвод); 
	Форма.Элементы.Договор.Видимость = (ЭтоОплата Или ЭтоАванс); 
	Форма.Элементы.ВидЗадолженности.Видимость = (ЭтоОплата Или ЭтоАванс); 
	Форма.Элементы.ВидОперации.Видимость = (ЭтоВвод Или ЭтоВывод);
	
	Форма.Элементы.РасчетныйСчет.Видимость = ЭтоПоручение;
	Форма.Элементы.РасчетныйСчетПолучатель.Видимость = Не ЭтоПоручение;
	Форма.Элементы.СчетДоверительногоУправления.Видимость = ЭтоПоручение;
	Форма.Элементы.ГруппаПериодИсполнения.Видимость = ЭтоПоручение;
	
	Форма.Элементы.СчетДоверительногоУправления.Доступность = ЭтоПоручение И Не ЗначениеЗаполнено(Форма.СчетДоверительногоУправления); 
	Форма.Элементы.Сумма.Доступность = ЭтоПоручение И Не ЗначениеЗаполнено(Форма.Сумма);
	Форма.Элементы.Валюта.Доступность = ЭтоПоручение И Не ЗначениеЗаполнено(Форма.Валюта);
	
	Форма.Элементы.Контрагент.Доступность = ЭтоАванс Или ЭтоВвод Или ЭтоВывод;
	Форма.Элементы.Договор.Доступность = ЭтоАванс Или ЭтоВвод Или ЭтоВывод;
	Форма.Элементы.ВидЗадолженности.Доступность = ЭтоАванс;
	
	Форма.Элементы.Договор.ОтметкаНезаполненного = ЭтоАванс;
	Форма.Элементы.РасчетныйСчетПолучатель.АвтоОтметкаНезаполненного = Не ЭтоАванс;
	
	Если ЭтоВвод Тогда 
		Форма.Элементы.РасчетныйСчет.Заголовок = "Р/с отправитель";
	ИначеЕсли ЭтоПоручение Тогда	
		Форма.Элементы.ГруппаРеквизитыДокумента.Заголовок = "Параметры поручения"; 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.РасчетныйСчет) Тогда
		
		Если ЗначениеЗаполнено(ЭтаФорма.СчетДоверительногоУправления) И ЗначениеЗаполнено(ЭтаФорма.Валюта) Тогда
			ЭтаФорма.РасчетныйСчет = ПолучитьСчетИзНастроекУчетаДоходовПоЦеннымБумагам(ЭтаФорма.Организация, ЭтаФорма.СчетДоверительногоУправления, ЭтаФорма.Валюта);
		КонецЕсли;
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтаФорма.СчетДоверительногоУправления) Тогда
		ЭтаФорма.Контрагент = РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицоСчетаДоверительногоУправления(ЭтаФорма.СчетДоверительногоУправления, ТекущаяДата()); 	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтотОбъект.ВидНовогоДокумента = "Поручение" Тогда
		
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ВидЗадолженности"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ВидОперации"));
       	ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Контрагент"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("РасчетныйСчетПолучатель"));
		
	ИначеЕсли ЭтотОбъект.ВидНовогоДокумента = "Оплата" Тогда
		
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("СчетДоверительногоУправления")); 
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ВидЗадолженности"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ВидОперации"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Контрагент"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ДатаИсполненияС"));
	   	ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ДатаИсполненияПо"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("РасчетныйСчет"));
			
	ИначеЕсли ЭтотОбъект.ВидНовогоДокумента = "ОплатаАванс" Тогда
		
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("СчетДоверительногоУправления"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ДатаИсполненияС"));
	   	ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ДатаИсполненияПо"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ВидОперации"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("РасчетныйСчет"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("РасчетныйСчетПолучатель"));
		
	ИначеЕсли ЭтотОбъект.ВидНовогоДокумента = "ВыводДенежныхСредств" Или ЭтотОбъект.ВидНовогоДокумента = "ВводДенежныхСредств" Тогда

		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("СчетДоверительногоУправления"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ВидЗадолженности"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ДатаИсполненияС"));
	   	ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ДатаИсполненияПо"));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетныйСчетНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка) 
	
	Если ЭтаФорма.ВидНовогоДокумента = "ВводДенежныхСредств" Тогда
	
		СтандартнаяОбработка = Ложь;
		ЭтаФорма.РасчетныйСчет = ПолучитьСчетИзСписка();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РасчетныйСчетПолучательНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка) 
	
	Если ЭтаФорма.ВидНовогоДокумента = "ВыводДенежныхСредств" Или ЭтаФорма.ВидНовогоДокумента = "Оплата" Или ЭтаФорма.ВидНовогоДокумента = "ОплатаАванс" Тогда

		СтандартнаяОбработка = Ложь;
		ЭтаФорма.РасчетныйСчетПолучатель = ПолучитьСчетИзСписка();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСчетИзСписка()
	
	ПараметрыФормыВыбора = Новый Структура("Организация, ЮрФизЛицо, Валюта, ТолькоСчетаКлиента",
											ЭтаФорма.Организация, ЭтаФорма.Контрагент, ЭтаФорма.Валюта, Ложь);
	
	РезультатВыбора = ОткрытьФормуМодально("Справочник.БанковскиеСчета.Форма.ФормаВыбораСчетаКлиента", ПараметрыФормыВыбора, ЭтаФорма);
	
	Возврат РезультатВыбора; 
	
КонецФункции
