		|			ТОГДА ""ИСПОЛНЕНО""
		|		ИНАЧЕ ""В ОБРАБОТКЕ""
		|	КОНЕЦ,
		|	_ДанныеПоПоручениям.СчетСоответствуетСчетуИзНастроек,
		|	ЛОЖЬ
		|ИЗ
		|	_ДанныеПоПоручениям КАК _ДанныеПоПоручениям
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|		ПО _ДанныеПоПоручениям.РасчетныйСчетПолучатель = ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет
		|			И (ИсполнителиПоДенежнымСредствамСобственные.Организация = &Организация)
		|			И (ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия >= &НачалоДня)
		|			И (НЕ _ДанныеПоПоручениям.Отменено)
		|			И (_ДанныеПоПоручениям.ПоручениеНаПереводМеждуСчетамиДУ)
		|			И (_ДанныеПоПоручениям.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская))
		|			И (_ДанныеПоПоручениям.СпособПередачи <> ЗНАЧЕНИЕ(Перечисление.СпособыПередачиПоручений.ВнутренняяСистема))
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_ДанныеПоПоручениям.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
		|			_ДанныеПоПоручениям.ДатаИсполненияС КАК ДатаИсполненияС,
		|			_ДанныеПоПоручениям.ДатаИсполненияПо КАК ДатаИсполненияПо,
		|			_ДанныеПоПоручениям.Сумма КАК Сумма,
		|			_ДанныеПоПоручениям.Валюта КАК Валюта,
		|			_ДанныеПоПоручениям.РасчетныйСчет КАК РасчетныйСчет,
		|			_ДанныеПоПоручениям.РасчетныйСчетПолучатель КАК РасчетныйСчетПолучатель
		|		ИЗ
		|			_ДанныеПоПоручениям КАК _ДанныеПоПоручениям
		|		ГДЕ
		|			НЕ _ДанныеПоПоручениям.Отменено
		|			И _ДанныеПоПоручениям.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			И _ДанныеПоПоручениям.СпособПередачи <> ЗНАЧЕНИЕ(Перечисление.СпособыПередачиПоручений.ВнутренняяСистема)
		|			И _ДанныеПоПоручениям.ПоручениеНаПереводМеждуСчетамиДУ) КАК ВложенныйЗапрос
		|		ПО _ДанныеПоПоручениям.Сумма = ВложенныйЗапрос.Сумма
		|			И _ДанныеПоПоручениям.Валюта = ВложенныйЗапрос.Валюта
		|			И _ДанныеПоПоручениям.РасчетныйСчет = ВложенныйЗапрос.РасчетныйСчет
		|			И _ДанныеПоПоручениям.РасчетныйСчетПолучатель = ВложенныйЗапрос.РасчетныйСчетПолучатель
		|			И _ДанныеПоПоручениям.ДатаИсполненияС = ВложенныйЗапрос.ДатаИсполненияС
		|			И _ДанныеПоПоручениям.ДатаИсполненияПо = ВложенныйЗапрос.ДатаИсполненияПо
		|			И _ДанныеПоПоручениям.НомерВходящегоДокумента = ВложенныйЗапрос.НомерВходящегоДокумента
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПодчиненныеДокументы КАК _ПодчиненныеДокументы
		|		ПО _ДанныеПоПоручениям.Поручение = _ПодчиненныеДокументы.Поручение
		|ГДЕ
		|	ВложенныйЗапрос.НомерВходящегоДокумента ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоДня", Дата);
	Запрос.УстановитьПараметр("ВалютаУчета", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета"));
	Запрос.УстановитьПараметр("Исполнитель", РаботаСПользователями.ТекущийПользователь());
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаКлиенте
Процедура Обновить(Команда)
	
	КлючТекущейСтроки = Неопределено;
	
	Если ПорученияДляСогласования.Количество() > 0 Тогда 
		КлючТекущейСтроки = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.ПорученияДляСогласования, "Поручение");
	КонецЕсли;
	
	ОбновитьТаблицуНаСервере();
	
	Если ЗначениеЗаполнено(КлючТекущейСтроки) Тогда
		РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.ПорученияДляСогласования, Элементы.ПорученияДляСогласования, "Поручение", КлючТекущейСтроки);
	КонецЕсли;
	
	ВывестиСообщенияОПерекрестныхВыводах();
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	ИзменитьЗначенияФлажков(Истина);	
		
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	ИзменитьЗначенияФлажков(Ложь);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПоместитьДанныеВБуфер(Команда)
	
	ТекстВБуфер = "";
	
	Для Каждого СтрокаТаблицы Из ЭтаФорма.ПорученияДляСогласования Цикл 
		
		Если Не Элементы.ПорученияДляСогласования.ПроверитьСтроку(СтрокаТаблицы.ПолучитьИдентификатор()) Тогда
			Продолжить;
		КонецЕсли;
					
		Если СтрокаТаблицы.Статус = "ОТМЕНЕНО" Тогда		
			Продолжить;	
		КонецЕсли;
		
		МассивЗначенийСтроки = Новый Массив;
		
		МассивЗначенийСтроки.Добавить(СтрокаТаблицы.Идентификатор);
		МассивЗначенийСтроки.Добавить("");
        МассивЗначенийСтроки.Добавить(СтрокаТаблицы.Статус);
		МассивЗначенийСтроки.Добавить(СтрокаТаблицы.ВидПоручения);
        МассивЗначенийСтроки.Добавить(СтрокаТаблицы.СчетДоверительногоУправления);
		МассивЗначенийСтроки.Добавить(СтрокаТаблицы.КодСчета);
		МассивЗначенийСтроки.Добавить(?(ЗначениеЗаполнено(СтрокаТаблицы.Сумма), Формат(СтрокаТаблицы.Сумма, "ЧГ=0"), 0));
		МассивЗначенийСтроки.Добавить(СтрокаТаблицы.Валюта);
		МассивЗначенийСтроки.Добавить(?(СтрокаТаблицы.ВыводВсехАктивов, 1, 0));
		МассивЗначенийСтроки.Добавить(Формат(СтрокаТаблицы.ДатаИсполненияС, "ДФ=dd.MM.yyyy"));
		МассивЗначенийСтроки.Добавить(Формат(СтрокаТаблицы.ДатаИсполненияПо, "ДФ=dd.MM.yyyy"));
		МассивЗначенийСтроки.Добавить(СтрокаТаблицы.НомерВходящегоДокумента);
		МассивЗначенийСтроки.Добавить(?(ЗначениеЗаполнено(СтрокаТаблицы.ДатаВходящегоДокумента), Формат(СтрокаТаблицы.ДатаВходящегоДокумента, "ДФ=dd.MM.yyyy"), ""));
		МассивЗначенийСтроки.Добавить(СтрокаТаблицы.ТипЗадолженности);
		МассивЗначенийСтроки.Добавить(СтрокаТаблицы.ВидЗадолженности);
		
		ТекстВБуфер = ТекстВБуфер + СтрСоединить(МассивЗначенийСтроки, Символы.Таб) + Символы.ПС;
			
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекстВБуфер) Тогда
		ТекстВБуфер = Лев(ТекстВБуфер, СтрДлина(ТекстВБуфер) - 1);
	КонецЕсли;	
	
	Если СредстваБуфераОбмена.ИспользованиеДоступно() Тогда
		СредстваБуфераОбмена.ПоместитьДанныеАсинх(Новый ЭлементБуфераОбмена(СтандартныйФорматДанныхБуфераОбмена.Текст, ТекстВБуфер));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данные скопированы в буфер обмена.");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьЗначенияФлажков(Значение)
	
	Для Каждого СтрокаТаблицы Из ЭтаФорма.ПорученияДляСогласования Цикл
		
		Если Значение = Ложь Тогда
			СтрокаТаблицы.Флажок = Значение;	
		Иначе
			
			Если Элементы.ПорученияДляСогласования.ПроверитьСтроку(СтрокаТаблицы.ПолучитьИдентификатор())
				И (СтрокаТаблицы.Статус = "ОЖИДАЕТ СОГЛАСОВАНИЯ" Или СтрокаТаблицы.Статус = "ПРОЙДЕН КОНТРОЛЬ" Или СтрокаТаблицы.Статус = "ПОРУЧЕНИЕ СОГЛАСОВАНО") Тогда 
				
				СтрокаТаблицы.Флажок = Значение;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ПорученияДляСогласованияПередНачаломИзменения(Элемент, Отказ)
	
	ТаблицаПорученийДляСогласованияОбработкаНажатия(Элемент, Отказ);

КонецПроцедуры 

&НаКлиенте
Процедура ТаблицаПорученийДляСогласованияОбработкаНажатия(Элемент, Отказ)
	
	ТекущиеДанные = Элемент.ТекущиеДанные; 
		
	Если Не (ТекущиеДанные = Неопределено Или Элемент.ТекущийЭлемент = Неопределено) Тогда
		
		Если Элемент.ТекущийЭлемент.Имя = "ПорученияДляСогласованияФлажок"
			Или Элемент.ТекущийЭлемент.Имя = "ПорученияДляСогласованияВидПоручения" Тогда
			
			Возврат;
			
		Конецесли;
		
		СтандартнаяОбработка = Ложь;
		
		Если Элемент.ТекущийЭлемент.Имя = "ПорученияДляСогласованияСчетДоверительногоУправления"
			Или Элемент.ТекущийЭлемент.Имя = "ПорученияДляСогласованияКодСчета" Тогда
			
			ОткрытьЗначение(ТекущиеДанные.СчетДоверительногоУправления);
				
		ИначеЕсли Элемент.ТекущийЭлемент.Имя = "ПорученияДляСогласованияСтатус" Тогда 
			
			Если ЗначениеЗаполнено(ТекущиеДанные.Поручение) Тогда
				ОткрытьФорму("ОбщаяФорма.СтруктураПодчиненности", Новый Структура("ОбъектОтбора", ТекущиеДанные.Поручение),, ТекущиеДанные.Идентификатор);	
			КонецЕсли;
						
		ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Поручение) Тогда
			
			ОткрытьЗначение(ТекущиеДанные.Поручение);
			
		КонецЕсли;
		
		Отказ = Истина;			
					
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Фильтр = "Таблицы EXCEL (*.xls;*.xlsx;*.xlsm)|*.xls;*.xlsx;*.xlsm";
	
	Если ДиалогВыбора.Выбрать() Тогда
		ЭтаФорма.ПутьКФайлу = ДиалогВыбора.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "СогласованиеПоручений.Обновить" Тогда
		ОбновитьТаблицуНаСервере();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗадачиКонтроля(Команда)
		
	СформироватьДанныеИВыполнитьЗадачи(Команда.Имя);
		
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗадачиСогласования(Команда) 
	
	СформироватьДанныеИВыполнитьЗадачи(Команда.Имя, Истина);
			
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗадачиПодтверждения(Команда)
	
	СформироватьДанныеИВыполнитьЗадачи(Команда.Имя, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанныеДляВыполненияЗадачКонтроля(Команда)
	
	СформироватьДанныеИВыполнитьЗадачи(Команда.Имя, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанныеДляВыполненияЗадачСогласования(Команда)
	
	СформироватьДанныеИВыполнитьЗадачи(Команда.Имя, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВыполнениеЗадачКонтроля(Команда)
	
	СформироватьДанныеИВыполнитьЗадачи(Команда.Имя);

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВыполнениеЗадачСогласования(Команда)
	
	СформироватьДанныеИВыполнитьЗадачи(Команда.Имя, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьДанныеИВыполнитьЗадачи(ИмяКоманды, ОтправитьОповещение = Ложь)
	
	ДанныеПоручений = ПолучитьДанныеПоручений(ИмяКоманды);
		
	Если ДанныеПоручений <> Неопределено И ДанныеПоручений.Количество() > 0 Тогда 
			
		КлючТекущейСтроки = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.ПорученияДляСогласования, "Поручение");
	
		ВыполнитьЗадачиНаСервере(ИмяКоманды, ДанныеПоручений);
				
		РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.ПорученияДляСогласования, Элементы.ПорученияДляСогласования, "Поручение", КлючТекущейСтроки);
				
		Если ОтправитьОповещение Тогда
			Оповестить("ИсполнениеПоручений.Обновить");	
		КонецЕсли; 
		
		Если ИмяКоманды = "ЗагрузитьДанныеДляВыполненияЗадачКонтроля"
			Или ИмяКоманды = "ЗагрузитьДанныеДляВыполненияЗадачСогласования" Тогда  
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Загрузка завершена");

		КонецЕсли;
				
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДанныеПоручений(ИмяКоманды) 
	
	Если ИмяКоманды = "ЗагрузитьДанныеДляВыполненияЗадачКонтроля"
		Или ИмяКоманды = "ЗагрузитьДанныеДляВыполненияЗадачСогласования" Тогда 
		
		ДанныеФайла = ПолучитьДанныеФайла(ИмяКоманды);
		
		Если ТипЗнч(ДанныеФайла) = Тип("Массив") И ДанныеФайла.Количество() > 0 Тогда
			Возврат ДанныеФайла;
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Загрузка отменена. Отсутствуют данные для загрузки.");
			Возврат Неопределено;
		КонецЕсли;
				
	ИначеЕсли ИмяКоманды = "ВыполнитьЗадачиКонтроля" Тогда
		
	    ТекущийСтатус = "ОЖИДАЕТ СОГЛАСОВАНИЯ";
		НовыйСтатус   = "ПРОЙДЕН КОНТРОЛЬ";
		
	ИначеЕсли ИмяКоманды = "ВыполнитьЗадачиСогласования" Тогда 
		
		ТекущийСтатус = "ПРОЙДЕН КОНТРОЛЬ";
		НовыйСтатус   = "ПОРУЧЕНИЕ СОГЛАСОВАНО"; 
		
	ИначеЕсли ИмяКоманды = "ВыполнитьЗадачиПодтверждения" Тогда 
		
		ТекущийСтатус = "ОЖИДАЕТ СОГЛАСОВАНИЯ";
		НовыйСтатус   = "ПОРУЧЕНИЕ СОГЛАСОВАНО"; 
		
	ИначеЕсли ИмяКоманды = "ОтменитьВыполнениеЗадачКонтроля" Тогда 
		
		ТекущийСтатус = "ПРОЙДЕН КОНТРОЛЬ";
		НовыйСтатус   = "ОТМЕНЕНО"; 
		
	ИначеЕсли ИмяКоманды = "ОтменитьВыполнениеЗадачСогласования" Тогда 
		
		ТекущийСтатус = "ПОРУЧЕНИЕ СОГЛАСОВАНО";
		НовыйСтатус   = "ОТМЕНЕНО";
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для команды [" + ИмяКоманды + "] не описан алгоритм действий.");
		Возврат Неопределено;	
	КонецЕсли;
	
	МассивДанных = Новый Массив;
			
	Для Каждого СтрокаТаблицы Из ЭтаФорма.ПорученияДляСогласования Цикл 
	
		Если СтрокаТаблицы.Флажок Тогда
			
			Если Не Элементы.ПорученияДляСогласования.ПроверитьСтроку(СтрокаТаблицы.ПолучитьИдентификатор()) Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрокаТаблицы.ТипЗадолженности = ПредопределенноеЗначение("Перечисление.ТипыЗадолженности.Дебиторская") Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ [" + УдалитьДвойнойПробел(Строка(СтрокаТаблицы.Поручение)) + "] на ввод активов не требует согласования.");
				Продолжить;
				
			КонецЕсли;
			
			Если СтрокаТаблицы.Статус = ТекущийСтатус Тогда
				
				Если СтрокаТаблицы.ДатаИсполненияПо < НачалоДня(ТекущаяДата()) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя установить статус [" + НовыйСтатус + "] документу [" + УдалитьДвойнойПробел(Строка(СтрокаТаблицы.Поручение)) + "], у которого истекла дата исполнения [" + Формат(СтрокаТаблицы.ДатаИсполненияПо, "ДФ=dd.MM.yyyy") + "].");	
				Иначе
				
					Если (ИмяКоманды = "ВыполнитьЗадачиКонтроля" Или ИмяКоманды = "ВыполнитьЗадачиСогласования")
						И СтрокаТаблицы.ВидПоручения = "ВНУТРЕННЕЕ" И Не СтрокаТаблицы.СчетСоответствуетСчетуИзНастроек Тогда
						
						ВариантыОтветов = Новый СписокЗначений;
						ВариантыОтветов.Добавить(1, "Отменить");
						ВариантыОтветов.Добавить(2, "Установить");

						Если Вопрос("В поручении на сумму " + СтрокаТаблицы.Сумма + " " + СтрокаТаблицы.Валюта + " расчетный счет отличается от расчетного счета в настройках учета по ценным бумагам.
									|Установить статус " + НовыйСтатус + "?", ВариантыОтветов,,, "Счет ду " + СтрокаТаблицы.СчетДоверительногоУправления + ".") = 1 Тогда 
							
							Продолжить;
							
						КонецЕсли;
					
					КонецЕсли;

					ДанныеПоручения = Новый Структура("Поручение, Идентификатор, СчетДоверительногоУправления, КодСчета, Сумма, Валюта, ДатаИсполненияС, ДатаИсполненияПо, НомерВходящегоДокумента, ДатаВходящегоДокумента, ТипЗадолженности");
					ЗаполнитьЗначенияСвойств(ДанныеПоручения, СтрокаТаблицы);
					
					МассивДанных.Добавить(ДанныеПоручения);
					
				КонецЕсли;
				
			Иначе
				
				Если НовыйСтатус = "ОТМЕНЕНО" Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя отменить статус [" + ТекущийСтатус + "] у документа [" + УдалитьДвойнойПробел(Строка(СтрокаТаблицы.Поручение)) + "], который находится в статусе [" + СтрокаТаблицы.Статус + "].")	
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя установить статус [" + НовыйСтатус + "] документу [" + УдалитьДвойнойПробел(Строка(СтрокаТаблицы.Поручение)) + "], который находится в статусе [" + СтрокаТаблицы.Статус + "].");
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивДанных;
			
КонецФункции 

&НаКлиенте
Функция ПолучитьДанныеФайла(ИмяКоманды)
	
	Если ИмяКоманды = "ЗагрузитьДанныеДляВыполненияЗадачКонтроля" Тогда 
		НовыйСтатус = "ПРОЙДЕН КОНТРОЛЬ";
	ИначеЕсли ИмяКоманды = "ЗагрузитьДанныеДляВыполненияЗадачСогласования" Тогда
		НовыйСтатус = "ПОРУЧЕНИЕ СОГЛАСОВАНО";
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтаФорма.ПутьКФайлу) Тогда
	
		Файл = Новый Файл(ЭтаФорма.ПутьКФайлу);
		Если Не Файл.Существует() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось найти файл [" + ЭтаФорма.ПутьКФайлу + "] для импорта статусов.",, "ПутьКФайлу");
			Возврат Неопределено;	
		КонецЕсли;
		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите файл для импорта статусов распоряжений.",, "ПутьКФайлу");
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЭтаФорма.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ") Тогда
		КодУК = "РЭМ";	
	ИначеЕсли ЭтаФорма.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ") Тогда
		КодУК = "ТРАСТ";	
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для организации [" + ЭтаФорма.Организация + "] недоступна опция импорта статусов поручений.",, "Организация");
		Возврат Неопределено;
		
	КонецЕсли;
	
	Состояние("Чтение файла.."); 
	
	ВременныйАдресФайла = ПолучитьИмяВременногоФайла("xlsx");
	
	КопироватьФайл(ЭтаФорма.ПутьКФайлу, ВременныйАдресФайла);
	
	БинарныйФайл = Новый ДвоичныеДанные(ВременныйАдресФайла);
	АдресФайлаВХранилище = ПоместитьВоВременноеХранилище(БинарныйФайл); 
	
	ДанныеФайла = ПолучитьДанныеФайлаНаСервере(АдресФайлаВХранилище, КодУК, НовыйСтатус);
	
	Если ДанныеФайла = Неопределено Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	Если ДанныеФайла.Количество() > 0 Тогда 
		
		//Обновим данные формы - возможно произошли изменения
		ОбновитьТаблицуНаСервере();
	
		Для Инд = 1 - ДанныеФайла.Количество() По 0 Цикл
				
			ЭлементДанных = ДанныеФайла[-Инд];
					
			МассивСтрок = ЭтаФорма.ПорученияДляСогласования.НайтиСтроки(Новый Структура("Идентификатор", ЭлементДанных.Идентификатор));
			
			Если МассивСтрок.Количество() = 1 Тогда
				
				СтрокаТаблицыФормы = МассивСтрок[0]; 
								
				Если Не Элементы.ПорученияДляСогласования.ПроверитьСтроку(СтрокаТаблицыФормы.ПолучитьИдентификатор()) Тогда
					ДанныеФайла.Удалить(-Инд);
				КонецЕсли;
				
				ЭлементДанных.Поручение = СтрокаТаблицыФормы.Поручение;
				ЭлементДанных.Вставить("ВидПоручения", СтрокаТаблицыФормы.ВидПоручения);
				ЭлементДанных.Вставить("ТекущийСтатус", СтрокаТаблицыФормы.Статус);
				ЭлементДанных.Вставить("СчетДоверительногоУправления", СтрокаТаблицыФормы.СчетДоверительногоУправления);
				ЭлементДанных.Вставить("Валюта", СтрокаТаблицыФормы.Валюта);
				ЭлементДанных.Вставить("СчетСоответствуетСчетуИзНастроек", СтрокаТаблицыФормы.СчетСоответствуетСчетуИзНастроек);

				Если Не (НовыйСтатус = "ПРОЙДЕН КОНТРОЛЬ" И СтрокаТаблицыФормы.Статус = "ОЖИДАЕТ СОГЛАСОВАНИЯ"
					Или НовыйСтатус = "ПОРУЧЕНИЕ СОГЛАСОВАНО" И СтрокаТаблицыФормы.Статус = "ПРОЙДЕН КОНТРОЛЬ") Тогда
		
					ЭлементДанных.ТекстОшибки = "Нельзя установить статус [" + НовыйСтатус + "] документу [" + УдалитьДвойнойПробел(Строка(СтрокаТаблицыФормы.Поручение)) + "], который находится в статусе [" + СтрокаТаблицыФормы.Статус + "].";	
					ЭлементДанных.ЕстьОшибки = Истина;
					
				ИначеЕсли СтрокаТаблицыФормы.ВидПоручения = "ВНУТРЕННЕЕ" И Не СтрокаТаблицыФормы.СчетСоответствуетСчетуИзНастроек Тогда
					ЭлементДанных.ТекстОшибки = "Расчетный счет в поручении [" + СтрокаТаблицыФормы.РасчетныйСчетПолучатель + "] отличается от расчетного счета в настройках учета по ценным бумагам.";	
				КонецЕсли;
				
			ИначеЕсли МассивСтрок.Количество() = 0 Тогда
				ЭлементДанных.ТекстОшибки = "По идентификатору [" + ЭлементДанных.Идентификатор + "] код счета ДУ [" + ЭлементДанных.КодСчета + "] не удалось найти поручение для загрузки статуса.";	
				ЭлементДанных.ЕстьОшибки = Истина;	
			ИначеЕсли МассивСтрок.Количество() > 1 Тогда
				ЭлементДанных.ТекстОшибки = "По идентификатору [" + ЭлементДанных.Идентификатор + "] код счета ДУ [" + ЭлементДанных.КодСчета + "] не удалось определить поручение для загрузки статуса. Найдено несколько записей [" + МассивСтрок.Количество() + "]";	
				ЭлементДанных.ЕстьОшибки = Истина;	
			КонецЕсли;
				
		КонецЦикла;
		
		ПараметрыФормы = Новый Структура("Статус, Дата, Организация, ДанныеФайла", НовыйСтатус, ЭтаФорма.Дата, ЭтаФорма.Организация, ДанныеФайла);
	
		ДанныеДляЗагрузкиВыполненияЗадач = ОткрытьФормуМодально("Обработка.СогласованиеПредстоящихРасходов.Форма.ЗагрузкаИзExcel", ПараметрыФормы, ЭтаФорма);
			
		Если ДанныеДляЗагрузкиВыполненияЗадач = Неопределено Тогда	
			ДанныеФайла.Очистить();	
		Иначе
			
			Для Инд = 1 - ДанныеФайла.Количество() По 0 Цикл
				
				ЭлементДанных = ДанныеФайла[-Инд]; 
				
				Если ДанныеДляЗагрузкиВыполненияЗадач.МассивДанных.Найти(ЭлементДанных.Поручение) = Неопределено Тогда
					ДанныеФайла.Удалить(-Инд);	
				КонецЕсли;
					
			КонецЦикла;
			
		КонецЕсли;
	
	КонецЕсли;

	Возврат ДанныеФайла;	

КонецФункции

&НаКлиенте
Функция УдалитьДвойнойПробел(ПредставлениеДокумента)
		
	Если СтрНайти(ПредставлениеДокумента, "  ") > 0 Тогда 
		
		ПредставлениеДокумента = СтрЗаменить(ПредставлениеДокумента, "  ", " ");
		ПредставлениеДокумента = УдалитьДвойнойПробел(ПредставлениеДокумента);
	
	КонецЕсли;
	
	Возврат ПредставлениеДокумента;
	
КонецФункции 

&НаСервереБезКонтекста
Функция ПолучитьТипЗадолженности(Синоним)
		
	Если Синоним = "К передаче (заблокированные)" Тогда
		
		Возврат ПредопределенноеЗначение("Перечисление.ТипыЗадолженности.Кредиторская");
		
	ИначеЕсли Синоним = "К поступлению" Тогда
		
		Возврат ПредопределенноеЗначение("Перечисление.ТипыЗадолженности.Дебиторская");
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ВыполнитьЗадачиНаСервере(ИмяКоманды, ДанныеПоручений)
	
	Если ИмяКоманды = "ВыполнитьЗадачиКонтроля" Или ИмяКоманды = "ЗагрузитьДанныеДляВыполненияЗадачКонтроля" Тогда
		
	    ТочкаМаршрута = БизнесПроцессы.СогласованиеПорученийНаВыводАктивов.ТочкиМаршрута.КонтрольОтделомСопровожденияОпераций;
		
	ИначеЕсли ИмяКоманды = "ВыполнитьЗадачиСогласования" Или ИмяКоманды = "ЗагрузитьДанныеДляВыполненияЗадачСогласования" Тогда 
		
		ТочкаМаршрута = БизнесПроцессы.СогласованиеПорученийНаВыводАктивов.ТочкиМаршрута.СогласованиеОтделомСопровожденияОпераций;
		
	ИначеЕсли ИмяКоманды = "ВыполнитьЗадачиПодтверждения" Тогда 
		
		ТочкаМаршрута = БизнесПроцессы.СогласованиеПорученийНаВыводАктивов.ТочкиМаршрута.ПодтверждениеКлиентскогоОтдела;
		
	ИначеЕсли ИмяКоманды = "ОтменитьВыполнениеЗадачКонтроля" Или ИмяКоманды = "ОтменитьВыполнениеЗадачСогласования"  Тогда 
		
		ОтменитьВыполнениеЗадач(ИмяКоманды, ДанныеПоручений);
		Возврат;
		
	Иначе
		Возврат;	
	КонецЕсли;
	
	Механизм = Метаданные.Обработки.СогласованиеПредстоящихРасходов.Имя + ".Форма.СогласованиеПоручений.ВыполнитьЗадачиНаСервере()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Дата, Организация", Новый Структура("Команда, КоличествоЗадач", ИмяКоманды, ДанныеПоручений.Количество()));
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Поручение", Новый ОписаниеТипов("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств"));
	ТаблицаДанных.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	ТаблицаДанных.Колонки.Добавить("КодСчета", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25)));
	ТаблицаДанных.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	ТаблицаДанных.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаДанных.Колонки.Добавить("ВалютаСтр", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(3)));
	ТаблицаДанных.Колонки.добавить("ДатаИсполненияС", Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.добавить("ДатаИсполненияПо", Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.Добавить("НомерВходящегоДокумента", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ТаблицаДанных.Колонки.добавить("ДатаВходящегоДокумента", Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.добавить("ТипЗадолженности", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыЗадолженности"));	
	
	Для Каждого ЭлементДанных Из ДанныеПоручений Цикл
		
		Если ЭлементДанных.Поручение = Неопределено Тогда 
			
			Попытка
				ЭлементДанных.Поручение = Документы.ПоручениеНаДвижениеДенежныхСредств.ПолучитьСсылку(Новый УникальныйИдентификатор(ЭлементДанных.Идентификатор));
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В 1С не удалось найти поручение на движение ДС по уникальному идентификатору [" + ЭлементДанных.Идентификатор + "]");	
				Продолжить;
			КонецПопытки;
			
		КонецЕсли;
		
		НоваяСтрокаТаблицы = ТаблицаДанных.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, ЭлементДанных);
			
	КонецЦикла;
	
	Если ТаблицаДанных.Количество() > 0 Тогда 
				
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
#Область ТЕКСТ_ЗАПРОСА
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТаблицаДанных.Поручение КАК Поручение,
			|	ТаблицаДанных.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ТаблицаДанных.КодСчета КАК КодСчета,
			|	ТаблицаДанных.Сумма КАК Сумма,
			|	ТаблицаДанных.Валюта КАК Валюта,
			|	ТаблицаДанных.ВалютаСтр КАК ВалютаСтр,
			|	ТаблицаДанных.ДатаИсполненияС КАК ДатаИсполненияС,
			|	ТаблицаДанных.ДатаИсполненияПо КАК ДатаИсполненияПо,
			|	ТаблицаДанных.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
			|	ТаблицаДанных.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
			|	ТаблицаДанных.ТипЗадолженности КАК ТипЗадолженности
			|ПОМЕСТИТЬ _ВнешниеДанные
			|ИЗ
			|	&ТаблицаДанных КАК ТаблицаДанных
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ВнешниеДанные.Поручение КАК Поручение,
			|	ВЫБОР
			|		КОГДА _ВнешниеДанные.СчетДоверительногоУправления = ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка)
			|			ТОГДА ЕСТЬNULL(СчетаДоверительногоУправления.Ссылка, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))
			|		ИНАЧЕ _ВнешниеДанные.СчетДоверительногоУправления
			|	КОНЕЦ КАК СчетДоверительногоУправления,
			|	_ВнешниеДанные.КодСчета КАК КодСчета,
			|	_ВнешниеДанные.Сумма КАК Сумма,
			|	ВЫБОР
			|		КОГДА _ВнешниеДанные.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
			|			ТОГДА ЕСТЬNULL(Валюты.Ссылка, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))
			|		ИНАЧЕ _ВнешниеДанные.Валюта
			|	КОНЕЦ КАК Валюта,
			|	_ВнешниеДанные.ВалютаСтр КАК ВалютаСтр,
			|	_ВнешниеДанные.ДатаИсполненияС КАК ДатаИсполненияС,
			|	_ВнешниеДанные.ДатаИсполненияПо КАК ДатаИсполненияПо,
			|	_ВнешниеДанные.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
			|	_ВнешниеДанные.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
			|	_ВнешниеДанные.ТипЗадолженности КАК ТипЗадолженности
			|ПОМЕСТИТЬ _ДополненныеВнешниеДанные
			|ИЗ
			|	_ВнешниеДанные КАК _ВнешниеДанные
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ПО _ВнешниеДанные.КодСчета = СчетаДоверительногоУправления.КодСчета
			|			И (_ВнешниеДанные.СчетДоверительногоУправления = ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))
			|			И (СчетаДоверительногоУправления.Организация = &Организация)
			|			И (НЕ СчетаДоверительногоУправления.ПометкаУдаления)
			|			И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			|				ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &ТекущаяДата)
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
			|		ПО _ВнешниеДанные.ВалютаСтр = Валюты.Наименование
			|			И (_ВнешниеДанные.ВалютаСтр <> """")
			|			И (_ВнешниеДанные.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))
			|			И (НЕ Валюты.ПометкаУдаления)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДополненныеВнешниеДанные.Поручение КАК Поручение,
			|	_ДополненныеВнешниеДанные.КодСчета КАК КодЭлементаСправочника,
			|	""При импорте данных документа [%1] не удалось определить Счет доверительного управления по коду [%2]"" КАК ТекстОшибки
			|ПОМЕСТИТЬ _ОшибкиОпределенияСправочныхДанных
			|ИЗ
			|	_ДополненныеВнешниеДанные КАК _ДополненныеВнешниеДанные
			|ГДЕ
			|	_ДополненныеВнешниеДанные.СчетДоверительногоУправления = ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_ДополненныеВнешниеДанные.Поручение,
			|	_ДополненныеВнешниеДанные.ВалютаСтр,
			|	""При импорте данных документа [%1] не удалось определить Валюту по коду [%2]""
			|ИЗ
			|	_ДополненныеВнешниеДанные КАК _ДополненныеВнешниеДанные
			|ГДЕ
			|	_ДополненныеВнешниеДанные.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
			|	И _ДополненныеВнешниеДанные.ВалютаСтр <> """"
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДополненныеВнешниеДанные.Поручение КАК Поручение,
			|	_ДополненныеВнешниеДанные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ДополненныеВнешниеДанные.Сумма КАК Сумма,
			|	_ДополненныеВнешниеДанные.Валюта КАК Валюта,
			|	_ДополненныеВнешниеДанные.ДатаИсполненияС КАК ДатаИсполненияС,
			|	_ДополненныеВнешниеДанные.ДатаИсполненияПо КАК ДатаИсполненияПо,
			|	_ДополненныеВнешниеДанные.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
			|	_ДополненныеВнешниеДанные.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
			|	_ДополненныеВнешниеДанные.ТипЗадолженности КАК ТипЗадолженности,
			|	ДокПоручение.СчетДоверительногоУправления КАК ТекСчетДоверительногоУправления,
			|	ДокПоручение.Сумма КАК ТекСумма,
			|	ДокПоручение.Валюта КАК ТекВалюта,
			|	ДокПоручение.ДатаИсполненияС КАК ТекДатаИсполненияС,
			|	ДокПоручение.ДатаИсполненияПо КАК ТекДатаИсполненияПо,
			|	ДокПоручение.НомерВходящегоДокумента КАК ТекНомерВходящегоДокумента,
			|	ДокПоручение.ДатаВходящегоДокумента КАК ТекДатаВходящегоДокумента,
			|	ДокПоручение.ТипЗадолженности КАК ТекТипЗадолженности,
			|	ВЫБОР
			|		КОГДА _ДополненныеВнешниеДанные.СчетДоверительногоУправления <> ДокПоручение.СчетДоверительногоУправления
			|			ТОГДА "" СчетДоверительногоУправления,""
			|		ИНАЧЕ """"
			|	КОНЕЦ + ВЫБОР
			|		КОГДА _ДополненныеВнешниеДанные.Сумма <> ДокПоручение.Сумма
			|			ТОГДА "" Сумма,""
			|		ИНАЧЕ """"
			|	КОНЕЦ + ВЫБОР
			|		КОГДА _ДополненныеВнешниеДанные.Валюта <> ДокПоручение.Валюта
			|			ТОГДА "" Валюта,""
			|		ИНАЧЕ """"
			|	КОНЕЦ + ВЫБОР
			|		КОГДА _ДополненныеВнешниеДанные.ДатаИсполненияС <> ДокПоручение.ДатаИсполненияС
			|			ТОГДА "" ДатаИсполненияС,""
			|		ИНАЧЕ """"
			|	КОНЕЦ + ВЫБОР
			|		КОГДА _ДополненныеВнешниеДанные.ДатаИсполненияПо <> ДокПоручение.ДатаИсполненияПо
			|			ТОГДА "" ДатаИсполненияПо,""
			|		ИНАЧЕ """"
			|	КОНЕЦ + ВЫБОР
			|		КОГДА _ДополненныеВнешниеДанные.НомерВходящегоДокумента <> ДокПоручение.НомерВходящегоДокумента
			|			ТОГДА "" НомерВходящегоДокумента,""
			|		ИНАЧЕ """"
			|	КОНЕЦ + ВЫБОР
			|		КОГДА _ДополненныеВнешниеДанные.ДатаВходящегоДокумента <> ДокПоручение.ДатаВходящегоДокумента
			|			ТОГДА "" ДатаВходящегоДокумента,""
			|		ИНАЧЕ """"
			|	КОНЕЦ + ВЫБОР
			|		КОГДА _ДополненныеВнешниеДанные.ТипЗадолженности <> ДокПоручение.ТипЗадолженности
			|			ТОГДА "" ТипЗадолженности,""
			|		ИНАЧЕ """"
			|	КОНЕЦ КАК Расхождения
			|ПОМЕСТИТЬ _ОшибкиПоручений
			|ИЗ
			|	_ДополненныеВнешниеДанные КАК _ДополненныеВнешниеДанные
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоручениеНаДвижениеДенежныхСредств КАК ДокПоручение
			|		ПО _ДополненныеВнешниеДанные.Поручение = ДокПоручение.Ссылка
			|			И (ДокПоручение.Организация = &Организация)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиОпределенияСправочныхДанных КАК _ОшибкиОпределенияСправочныхДанных
			|		ПО _ДополненныеВнешниеДанные.Поручение = _ОшибкиОпределенияСправочныхДанных.Поручение
			|ГДЕ
			|	(_ДополненныеВнешниеДанные.СчетДоверительногоУправления <> ДокПоручение.СчетДоверительногоУправления
			|			ИЛИ НЕ ДокПоручение.ВыводВсехАктивов
			|				И (_ДополненныеВнешниеДанные.Сумма <> ДокПоручение.Сумма
			|					ИЛИ _ДополненныеВнешниеДанные.Валюта <> ДокПоручение.Валюта)
			|			ИЛИ _ДополненныеВнешниеДанные.ДатаИсполненияС <> ДокПоручение.ДатаИсполненияС
			|			ИЛИ _ДополненныеВнешниеДанные.ДатаИсполненияПо <> ДокПоручение.ДатаИсполненияПо
			|			ИЛИ _ДополненныеВнешниеДанные.НомерВходящегоДокумента <> ДокПоручение.НомерВходящегоДокумента
			|			ИЛИ _ДополненныеВнешниеДанные.ДатаВходящегоДокумента <> ДокПоручение.ДатаВходящегоДокумента
			|			ИЛИ _ДополненныеВнешниеДанные.ТипЗадолженности <> ДокПоручение.ТипЗадолженности)
			|	И _ОшибкиОпределенияСправочныхДанных.Поручение ЕСТЬ NULL
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СогласованиеПорученийНаВыводАктивов.Ссылка КАК Ссылка,
			|	СогласованиеПорученийНаВыводАктивов.Выполнена КАК Выполнена,
			|	ВЫБОР
			|		КОГДА СогласованиеПорученийНаВыводАктивов.ПометкаУдаления
			|				ИЛИ СогласованиеПорученийНаВыводАктивов.БизнесПроцесс.Отменен
			|				ИЛИ СогласованиеПорученийНаВыводАктивов.БизнесПроцесс.ПометкаУдаления
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК Отменена
			|ИЗ
			|	_ВнешниеДанные КАК _ВнешниеДанные
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Задача.ЗадачаИсполнителя КАК СогласованиеПорученийНаВыводАктивов
			|		ПО _ВнешниеДанные.Поручение = СогласованиеПорученийНаВыводАктивов.Основание
			|			И (СогласованиеПорученийНаВыводАктивов.Организация = &Организация)
			|			И (ТИПЗНАЧЕНИЯ(СогласованиеПорученийНаВыводАктивов.БизнесПроцесс) = ТИП(БизнесПроцесс.СогласованиеПорученийНаВыводАктивов))
			|			И (СогласованиеПорученийНаВыводАктивов.ТочкаМаршрута = &ТочкаМаршрута)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиОпределенияСправочныхДанных КАК _ОшибкиОпределенияСправочныхДанных
			|		ПО _ВнешниеДанные.Поручение = _ОшибкиОпределенияСправочныхДанных.Поручение
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиПоручений КАК _ОшибкиПоручений
			|		ПО _ВнешниеДанные.Поручение = _ОшибкиПоручений.Поручение
			|ГДЕ
			|	_ОшибкиОпределенияСправочныхДанных.Поручение ЕСТЬ NULL
			|	И _ОшибкиПоручений.Поручение ЕСТЬ NULL";
#КонецОбласти
					
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицаДанных);
		Запрос.УстановитьПараметр("ТочкаМаршрута", ТочкаМаршрута);
			
		ВыборкаЗадач = Запрос.Выполнить().Выбрать();
		
		Пока ВыборкаЗадач.Следующий() Цикл
			
			Если Не (ВыборкаЗадач.Выполнена Или ВыборкаЗадач.Отменена) Тогда
				
				Попытка
					ЗадачаОбъект = ВыборкаЗадач.Ссылка.ПолучитьОбъект(); 
					ЗадачаОбъект.ВыполнитьЗадачу();
				Исключение
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка выполнения задачи:" + Символы.ПС + ОписаниеОшибки());	
				КонецПопытки;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ВыборкаОшибок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиОпределенияСправочныхДанных"].ПолучитьДанные().Выбрать();
		
		Пока ВыборкаОшибок.Следующий() Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ВыборкаОшибок.ТекстОшибки, ВыборкаОшибок.Поручение, ВыборкаОшибок.КодЭлементаСправочника)); 	
		КонецЦикла;
		
		ВыборкаОшибок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиПоручений"].ПолучитьДанные().Выбрать();
		
		Пока ВыборкаОшибок.Следующий() Цикл
			
			МассивРеквизитов = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ВыборкаОшибок.Расхождения, ",", Истина, Истина);
			
			ТекстСообщения = "В документе [" + ВыборкаОшибок.Поручение + " изменились данные:" + Символы.ПС;	
			
			Для Каждого ЭлементМассива Из МассивРеквизитов Цикл
				
				ТекстСообщения = ТекстСообщения + ", " + ЭлементМассива + " [" + ВыборкаОшибок[ЭлементМассива] + "] -> [" + ВыборкаОшибок["Тек" + ЭлементМассива] + "]"; 
				
			КонецЦикла;
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
		КонецЦикла;
		
		ОбновитьТаблицуНаСервере();
	
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

&НаСервере
Процедура ОтменитьВыполнениеЗадач(ИмяКоманды, ДанныеПоручений)
	
	Если ИмяКоманды = "ОтменитьВыполнениеЗадачКонтроля" Тогда
		ТочкаМаршрута = БизнесПроцессы.СогласованиеПорученийНаВыводАктивов.ТочкиМаршрута.КонтрольОтделомСопровожденияОпераций; 	
	ИначеЕсли ИмяКоманды = "ОтменитьВыполнениеЗадачСогласования" Тогда
		ТочкаМаршрута = БизнесПроцессы.СогласованиеПорученийНаВыводАктивов.ТочкиМаршрута.СогласованиеОтделомСопровожденияОпераций; 	
	Иначе
		Возврат;
	КонецЕсли;
	
	Механизм = Метаданные.Обработки.СогласованиеПредстоящихРасходов.Имя + ".Форма.СогласованиеПоручений.ОтменитьЗадачиНаСервере()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Дата, Организация", Новый Структура("Команда, КоличествоЗадач", ИмяКоманды, ДанныеПоручений.Количество()));
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ТаблицаПоручений = Новый ТаблицаЗначений;
	ТаблицаПоручений.Колонки.Добавить("Поручение", Новый ОписаниеТипов("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств"));
	ТаблицаПоручений.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	
	Для Каждого ЭлементДанных Из ДанныеПоручений Цикл
				
		НоваяСтрокаТаблицы = ТаблицаПоручений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, ЭлементДанных);
			
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаПоручений.Поручение КАК Ссылка,
		|	ТаблицаПоручений.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _ТаблицаПоручений
		|ИЗ
		|	&ТаблицаПоручений КАК ТаблицаПоручений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ТаблицаПоручений.Ссылка КАК Поручение
		|ПОМЕСТИТЬ _ПодчиненныеДокументы
		|ИЗ
		|	Документ.Оплата КАК ДокОплата
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаПоручений КАК _ТаблицаПоручений
		|		ПО (ДокОплата.Организация = &Организация)
		|			И ДокОплата.Поручение = _ТаблицаПоручений.Ссылка
		|			И ДокОплата.СчетДоверительногоУправления = _ТаблицаПоручений.СчетДоверительногоУправления
		|			И (ДокОплата.Проведен)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ТаблицаПоручений.Ссылка
		|ИЗ
		|	_ТаблицаПоручений КАК _ТаблицаПоручений
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоручениеНаДвижениеДенежныхСредств КАК ДокПоручение
		|		ПО _ТаблицаПоручений.Ссылка = ДокПоручение.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Оплата.Основания КАК ОплатаОснования
		|		ПО (ДокПоручение.Основание = ОплатаОснования.Основание)
		|			И (ДокПоручение.Основание <> НЕОПРЕДЕЛЕНО)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Оплата КАК ДокОплата
		|		ПО (ОплатаОснования.Ссылка = ДокОплата.Ссылка)
		|			И (ДокОплата.Проведен)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВыводДенежныхСредств.Основание
		|ИЗ
		|	Документ.ВыводДенежныхСредств КАК ВыводДенежныхСредств
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаПоручений КАК _ТаблицаПоручений
		|		ПО (_ТаблицаПоручений.Ссылка = ВыводДенежныхСредств.Основание)
		|			И (_ТаблицаПоручений.СчетДоверительногоУправления = ВыводДенежныхСредств.СчетДоверительногоУправления)
		|			И (ВыводДенежныхСредств.Организация = &Организация)
		|			И (ВыводДенежныхСредств.Проведен)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВводДенежныхСредств.Основание
		|ИЗ
		|	Документ.ВводДенежныхСредств КАК ВводДенежныхСредств
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаПоручений КАК _ТаблицаПоручений
		|		ПО (_ТаблицаПоручений.Ссылка = ВводДенежныхСредств.Основание)
		|			И (_ТаблицаПоручений.СчетДоверительногоУправления = ВводДенежныхСредств.СчетДоверительногоУправления)
		|			И (ВводДенежныхСредств.Организация = &Организация)
		|			И (ВводДенежныхСредств.Проведен)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ТаблицаПоручений.Ссылка
		|ИЗ
		|	Документ.ПлатежноеПоручениеИсходящее.Основания КАК ПлатежноеПоручениеИсходящееОснования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаПоручений КАК _ТаблицаПоручений
		|		ПО (_ТаблицаПоручений.Ссылка = ПлатежноеПоручениеИсходящееОснования.Основание
		|				ИЛИ ВЫРАЗИТЬ(_ТаблицаПоручений.Ссылка КАК Документ.ПоручениеНаДвижениеДенежныхСредств).Основание = ПлатежноеПоручениеИсходящееОснования.Основание)
		|			И (ПлатежноеПоручениеИсходящееОснования.Ссылка.Организация = &Организация)
		|			И (ПлатежноеПоручениеИсходящееОснования.Ссылка.Проведен)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаПоручений.Ссылка КАК Поручение,
		|	НЕ _ПодчиненныеДокументы.Поручение ЕСТЬ NULL КАК ЕстьПодчиненныйДокумент,
		|	СогласованиеПорученийНаВыводАктивов.Ссылка КАК Задача,
		|	СогласованиеПорученийНаВыводАктивов.Выполнена КАК ЗадачаВыполнена,
		|	СогласованиеПорученийНаВыводАктивов.БизнесПроцесс КАК БизнесПроцесс,
		|	СогласованиеПорученийНаВыводАктивов.БизнесПроцесс.Завершен КАК БизнесПроцессЗавершен,
		|	ДокАкцепт.Ссылка КАК Акцепт
		|ИЗ
		|	_ТаблицаПоручений КАК _ТаблицаПоручений
		|		ЛЕВОЕ СОЕДИНЕНИЕ Задача.ЗадачаИсполнителя КАК СогласованиеПорученийНаВыводАктивов
		|		ПО _ТаблицаПоручений.Ссылка = СогласованиеПорученийНаВыводАктивов.Основание
		|			И (СогласованиеПорученийНаВыводАктивов.Организация = &Организация)
		|			И (ТИПЗНАЧЕНИЯ(СогласованиеПорученийНаВыводАктивов.БизнесПроцесс) = ТИП(БизнесПроцесс.СогласованиеПорученийНаВыводАктивов))
		|			И (СогласованиеПорученийНаВыводАктивов.ТочкаМаршрута = &ТочкаМаршрута)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПодчиненныеДокументы КАК _ПодчиненныеДокументы
		|		ПО _ТаблицаПоручений.Ссылка = _ПодчиненныеДокументы.Поручение
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Акцепт КАК ДокАкцепт
		|		ПО _ТаблицаПоручений.Ссылка = ДокАкцепт.Объект
		|			И _ТаблицаПоручений.СчетДоверительногоУправления = ДокАкцепт.СчетДоверительногоУправления
		|			И (ДокАкцепт.Организация = &Организация)
		|			И (ДокАкцепт.ВидАкцепта = ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.ПоручениеНаВыводАктивов))
		|			И (ДокАкцепт.Акцептант = &Акцептант)
		|			И (ДокАкцепт.Проведен)";
#КонецОбласти
	
	Запрос.УстановитьПараметр("ТаблицаПоручений", ТаблицаПоручений);
	Запрос.УстановитьПараметр("ТочкаМаршрута", ТочкаМаршрута);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Акцептант", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ЮрФизЛицо"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ЕстьПодчиненныйДокумент Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя отменить статус у документа [" + Выборка.Поручение + "]. На основании поручения создан подчиненный документ.");	
			Продолжить;	
		КонецЕсли;
		
		Если ТочкаМаршрута = БизнесПроцессы.СогласованиеПорученийНаВыводАктивов.ТочкиМаршрута.КонтрольОтделомСопровожденияОпераций Тогда
			
			Если Выборка.БизнесПроцессЗавершен Тогда	
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя снять статус [ПРОЙДЕН КОНТРОЛЬ] у документа [" + Выборка.Поручение + "]. Бизнес процесс согласования поручения завершен."); 				
				Продолжить;	
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Выборка.Акцепт) Тогда	
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя снять статус [ПРОЙДЕН КОНТРОЛЬ] у документа [" + Выборка.Поручение + "]. На основании поручения создан документ акцепт."); 				
				Продолжить;	
			КонецЕсли;
			
			Если Выборка.ЗадачаВыполнена Тогда
				
				Попытка
				
					ЗадачаКонтроля = Выборка.Задача.ПолучитьОбъект();
	 				ЗадачаКонтроля.Выполнена = Ложь;
	 				ЗадачаКонтроля.Записать();
					
				Исключение
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось снять статус [ПРОЙДЕН КОНТРОЛЬ] у документа [" + Выборка.Поручение + "]." + Символы.ПС + ОписаниеОшибки());	
				КонецПопытки;
					
			КонецЕсли;
	
		ИначеЕсли ТочкаМаршрута = БизнесПроцессы.СогласованиеПорученийНаВыводАктивов.ТочкиМаршрута.СогласованиеОтделомСопровожденияОпераций Тогда
			
			Попытка
				
				НачатьТранзакцию(); 
				
				УстановитьПривилегированныйРежим(Истина);
				
				Если ЗначениеЗаполнено(Выборка.Задача) И Выборка.ЗадачаВыполнена Тогда
					ЗадачаСогласования = Выборка.Задача.ПолучитьОбъект();
	 				ЗадачаСогласования.Выполнена = Ложь;
	 				ЗадачаСогласования.Записать();
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Выборка.БизнесПроцесс) И Выборка.БизнесПроцессЗавершен Тогда
					БизнесПроцессСогласования = Выборка.БизнесПроцесс.ПолучитьОбъект();
					БизнесПроцессСогласования.Завершен = Ложь;
					БизнесПроцессСогласования.Записать();	
				КонецЕсли; 
				
				Если ЗначениеЗаполнено(Выборка.Акцепт) Тогда
					
					АкцептСогласования = Выборка.Акцепт.ПолучитьОбъект();
					АкцептСогласования.Записать(РежимЗаписиДокумента.ОтменаПроведения);
						
				КонецЕсли;
				
				УстановитьПривилегированныйРежим(Ложь);
				
				ЗафиксироватьТранзакцию();
	
			Исключение
				
				ОтменитьТранзакцию();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось снять статус [ПОРУЧЕНИЕ СОГЛАСОВАНО] у документа [" + Выборка.Поручение + "]." + Символы.ПС + ОписаниеОшибки());							
				
			КонецПопытки;
			
		КонецЕсли;
			
	КонецЦикла;
	
	ОбновитьТаблицуНаСервере();
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВывестиСообщенияОПерекрестныхВыводах();
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиСообщенияОПерекрестныхВыводах()
	
	Если Не ЭтаФорма.РольОперацииФронтОфиса Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицыДанных Из ЭтотОбъект.ПорученияДляСогласования Цикл
		
		Если СтрокаТаблицыДанных.ПерекрестноеПоручение Тогда 
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перекрестный вывод. " + СтрокаТаблицыДанных.СчетДоверительногоУправления + ".",, "ПорученияДляСогласования[" + ЭтотОбъект.ПорученияДляСогласования.Индекс(СтрокаТаблицыДанных) + "].ВидПоручения");
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеФайлаНаСервере(АдресФайлаВХранилище, КодУК, НовыйСтатус)
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");

	БинарныйФайл = ПолучитьИзВременногоХранилища(АдресФайлаВХранилище);
	БинарныйФайл.Записать(ИмяВременногоФайла);    
	
	ДанныеТабличногоДокумента = Новый ТабличныйДокумент;
	ДанныеТабличногоДокумента.Прочитать(ИмяВременногоФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	
	Для Каждого ОбластьДокумента Из ДанныеТабличногоДокумента.Области Цикл
				
		Если Врег(ОбластьДокумента.Имя) <> "ВЫВОД_ДС" Тогда
			Продолжить;
		КонецЕсли;
			
		ТабличныйДокументПриемник = Новый ТабличныйДокумент; 
		
		ЛистДокумента = ДанныеТабличногоДокумента.ПолучитьОбласть(ОбластьДокумента.Имя);
		
		Если НовыйСтатус = "ПОРУЧЕНИЕ СОГЛАСОВАНО" Тогда
			
			СрокМониторинга = ЛистДокумента.Область(1, 22).Текст; //ячейка V1
			
			Если СрокМониторинга <> "0" Тогда	
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка согласования поручений. В файле указан срок мониторинга = " + СрокМониторинга + ". Ячейка V1.",, "ПутьКФайлу");
				Возврат Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		
		ТабличныйДокументПриемник.ВставитьОбласть(ЛистДокумента.Область(9, 1, 9, 29), ТабличныйДокументПриемник.Область(1, 1, 1, 29));
		                                                                 
		Если Не НаименованияПолейТаблицыСоответствуютФормату(ТабличныйДокументПриемник) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка чтения файла!",, "ПутьКФайлу");
			Возврат Неопределено;
		КонецЕсли;
		
		НомерПервойСтрокиЗаписей = 10; //С 10-ой строки начинаются табличные данные
		НомерПоследнейСтрокиЗаписей = ПолучитьНомерПоследнейСтрокиЗаписей(ЛистДокумента, НомерПервойСтрокиЗаписей, ЛистДокумента.ВысотаТаблицы);
			
		ОбластьДанных = ЛистДокумента.Область(НомерПервойСтрокиЗаписей, 1, НомерПоследнейСтрокиЗаписей, 29);
		
		НомерПоследнейСтрокиПриемника = (НомерПоследнейСтрокиЗаписей - НомерПервойСтрокиЗаписей) + 2;  
		
		ТабличныйДокументПриемник.ВставитьОбласть(ОбластьДанных, ТабличныйДокументПриемник.Область(2, 1, НомерПоследнейСтрокиПриемника, 29));
		
		ИсточникОбластьЯчеек = ТабличныйДокументПриемник.Область(1, 1, ТабличныйДокументПриемник.ВысотаТаблицы, 29);
		
		ПостроительЗапроса = Новый ПостроительЗапроса;
		ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(ИсточникОбластьЯчеек);
		ПостроительЗапроса.ДобавлениеПредставлений = ТипДобавленияПредставлений.НеДобавлять;
		ПостроительЗапроса.ЗаполнитьНастройки();
		ПостроительЗапроса.Выполнить();
		
		ТаблицаДанных = ПостроительЗапроса.Результат.Выгрузить();
		
		ДанныеФайла = Новый Массив;
					
		НомерСтроки = НомерПервойСтрокиЗаписей - 1;

		Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
				
			НомерСтроки = НомерСтроки + 1;
			
			Если Не (ЗначениеЗаполнено(СтрокаДанных.ID) И ЗначениеЗаполнено(СтрокаДанных.ДатаВыводаПо) И ЗначениеЗаполнено(СтрокаДанных.УК)) Тогда
				Продолжить;	
			КонецЕсли;
								
			Если ВРег(СтрокаДанных.УК) <> КодУК Тогда 	
				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(СтрокаДанных.ПровереноИД) <> Тип("Число") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Проверено ИД] некорректный формат значения. Статус поручения не загружен. Счет ДУ [" + СтрокаДанных.СчетДУ + "].");
				Продолжить;
				
			ИначеЕсли СтрокаДанных.ПровереноИД = 0 Тогда // Если контроль не пройден - ничего не загружаем.
				Продолжить;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаДанных.КодСчета) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Код счета] отсутствует значение. Статус поручения не загружен.");
				Продолжить;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаДанных.ВидПоручения) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Вид поручения] отсутствует значение. Статус поручения не загружен. Счет ДУ [" + СтрокаДанных.СчетДУ + "].");
				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(СтрокаДанных.Сумма) <> Тип("Число") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Сумма] некорректный формат значения. Статус поручения не загружен. Счет ДУ [" + СтрокаДанных.СчетДУ + "].");
				Продолжить;
			КонецЕсли;
			
			Если СтрокаДанных.Сумма = 0 И СтрокаДанных.ВыводВсехАктивов = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Сумма] отсутствует значения. Статус поручения не загружен. Счет ДУ [" + СтрокаДанных.СчетДУ + "].");
				Продолжить;
			КонецЕсли;

			Если Не (ЗначениеЗаполнено(СтрокаДанных.Валюта) Или СтрокаДанных.ВыводВсехАктивов = 1) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Валюта] отсутствует значение. Статус поручения не загружен. Счет ДУ [" + СтрокаДанных.СчетДУ + "].");
				Продолжить;
			КонецЕсли;
			
			Если Не (ЗначениеЗаполнено(СтрокаДанных.ДатаВыводаС) И ТипЗнч(СтрокаДанных.ДатаВыводаС) = Тип("Дата")) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Дата вывода с] некорректный формат значения. Статус поручения не загружен. Счет ДУ [" + СтрокаДанных.СчетДУ + "].");
				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(СтрокаДанных.ДатаВыводаПо) <> Тип("Дата") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Дата вывода по] некорректный формат значения. Статус поручения не загружен. Счет ДУ [" + СтрокаДанных.СчетДУ + "].");
				Продолжить;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаДанных.ТипЗадолженности) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + НомерСтроки + "] в поле [Тип задолженности] отсутствует значение. Статус поручения не загружен. Счет ДУ [" + СтрокаДанных.СчетДУ + "].");
				Продолжить;
			КонецЕсли;
			
			ДанныеПоручения = Новый Структура; 
			ДанныеПоручения.Вставить("НовыйСтатус", НовыйСтатус);
			ДанныеПоручения.Вставить("Поручение", Неопределено);
			ДанныеПоручения.Вставить("Идентификатор", СтрокаДанных.ID);	
			ДанныеПоручения.Вставить("КодСчета", СтрокаДанных.КодСчета);
			ДанныеПоручения.Вставить("Сумма", Окр(СтрокаДанных.Сумма, Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти));
			ДанныеПоручения.Вставить("ВалютаСтр", СтрокаДанных.Валюта);
			ДанныеПоручения.Вставить("ДатаИсполненияС", СтрокаДанных.ДатаВыводаС);
			ДанныеПоручения.Вставить("ДатаИсполненияПо", СтрокаДанных.ДатаВыводаПо);
			ДанныеПоручения.Вставить("НомерВходящегоДокумента", ?(ТипЗнч(СтрокаДанных.НомерДокумента) = Тип("Число"), Формат(СтрокаДанных.НомерДокумента, "ЧГ=0"), СтрокаДанных.НомерДокумента)); 
			ДанныеПоручения.Вставить("ДатаВходящегоДокумента" , СтрокаДанных.ДатаДокумента);
			ДанныеПоручения.Вставить("ТипЗадолженности", ПолучитьТипЗадолженности(СтрокаДанных.ТипЗадолженности));
			ДанныеПоручения.Вставить("ЕстьОшибки", Ложь);
			ДанныеПоручения.Вставить("ТекстОшибки", "");
			
			//Поручения согласовывается в два этапа:
			// 1. Контроль
			// 2. Согласование
			//Если поручение не прошло "контроль" - его нельзя согласовать.
			Если НовыйСтатус = "ПРОЙДЕН КОНТРОЛЬ" И СтрокаДанных.ПровереноИД <> 1 Тогда
				
				ДанныеПоручения.ЕстьОшибки = Истина;
				ДанныеПоручения.ТекстОшибки = "В файле у поручения [" + СтрокаДанных.ID + "] отсутствует признак [ПРОЙДЕН КОНТРОЛЬ] в поле [Проверено ИД]. Счет ДУ [" + СтрокаДанных.СчетДУ + "]. Строка [" + НомерСтроки + "].";
					
			ИначеЕсли НовыйСтатус = "ПОРУЧЕНИЕ СОГЛАСОВАНО" И Врег(СтрокаДанных.ОтложенныйПлатеж) = "ДА" Тогда 
				
				ДанныеПоручения.ЕстьОшибки = Истина;
				ДанныеПоручения.ТекстОшибки = "В файле у поручения [" + СтрокаДанных.ID + "] установлен признак [Отложенный платеж = ДА]. Счет ДУ [" + СтрокаДанных.СчетДУ  + "]. Строка [" + НомерСтроки + "].";
				
			КонецЕсли;	
				
			ДанныеФайла.Добавить(ДанныеПоручения);
			
		КонецЦикла;
		
	КонецЦикла;

	Возврат ДанныеФайла;
		
КонецФункции

&НаСервереБезКонтекста
Функция НаименованияПолейТаблицыСоответствуютФормату(ДанныеФайла) 
	
	НаименованияПолейСоответствуютФормату = Истина;
	
	НаименованиеПолей =
		"ID;
		|СТОЛБЕЦ1;
		|СТАТУС;
		|ВИД ПОРУЧЕНИЯ;
		|СЧЕТ Д/У;
		|КОД СЧЕТА;
		|СУММА;
		|ВАЛЮТА;
		|ВЫВОД ВСЕХ АКТИВОВ;
		|ДАТА ВЫВОДА С;
		|ДАТА ВЫВОДА ПО;
		|№ ДОКУМЕНТА;
		|ДАТА ДОКУМЕНТА;
		|ТИП ЗАДОЛЖЕННОСТИ;
		|ВИД ЗАДОЛЖЕННОСТИ;
		|ДАТА ПОСТАНОВКИ;
		|КЛИЕНТ;
		|КОД;
		|УК;
		|№ДОГОВОРА;
		|СЧА;
		|ДОЛЯ СЧА;
		|СУММА2;
		|КР.ДАТА ИСПОЛНЕНИЯ;
		|ДНЕЙ ОСТАЛОСЬ;
		|ОСНОВНОЙ БАНК;
		|ПРОВЕРЕНО ИД;
		|ИСТОЧНИК;
		|ОТЛОЖЕННЫЙ ПЛАТЕЖ";
	
	ПоляТаблицы = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаименованиеПолей, ";",, Истина);
	
	Для НомерПоля = 0 По ПоляТаблицы.Количество() - 1 Цикл
		
		ЗначениеЯчейки = СокрЛП(Врег(ДанныеФайла.Область(1, НомерПоля + 1).Текст));
		
		Если ПоляТаблицы[НомерПоля] <> ЗначениеЯчейки Тогда	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не найдено поле таблицы [" + ПоляТаблицы[НомерПоля] + "]'"));
			НаименованияПолейСоответствуютФормату = Ложь;
		КонецЕсли;
		
		Если НомерПоля = 4 Тогда
			ДанныеФайла.Область(1, НомерПоля + 1).Текст = "СчетДУ";	
		ИначеЕсли НомерПоля = 11 Тогда
			ДанныеФайла.Область(1, НомерПоля + 1).Текст = "НомерДокумента";
		ИначеЕсли НомерПоля = 19 Тогда
			ДанныеФайла.Область(1, НомерПоля + 1).Текст = "НомерДоговора";
		КонецЕсли;
			
	КонецЦикла; 
	
	Возврат НаименованияПолейСоответствуютФормату;
	
КонецФункции 

&НаСервереБезКонтекста
Функция ПолучитьНомерПоследнейСтрокиЗаписей(Лист, НомерПервойСтроки, НомерПоследнойСтроки)
	
	Если НомерПоследнойСтроки <= НомерПервойСтроки + 1 Тогда
		Возврат НомерПоследнойСтроки;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Лист.Область(НомерПоследнойСтроки, 1).Текст) Тогда
		НомерСтроки = ПолучитьНомерПоследнейСтрокиЗаписей(Лист, НомерПоследнойСтроки, Окр(НомерПоследнойСтроки + ((НомерПоследнойСтроки - НомерПервойСтроки) / 2), 0, 1));
	Иначе
		НомерСтроки = ПолучитьНомерПоследнейСтрокиЗаписей(Лист, НомерПервойСтроки, Окр(НомерПервойСтроки + ((НомерПоследнойСтроки - НомерПервойСтроки) / 2), 0, 1));	
	КонецЕсли;
	
	Возврат НомерСтроки;
	
