
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	ЭтаФорма.Дата = ТекущаяДата();
	
	ОбновитьТаблицуНаСервере();
	
	РолиПользователя = ПолучитьРолиПользователя();

	ЭтаФорма.РольОперацииФронтОфиса = РолиПользователя.ОперацииФронтОфиса; 
	НастроитьВидимостьИДоступность(ЭтаФорма, РолиПользователя); 
							
КонецПроцедуры

&НаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма, РолиПользователя)
	
	Элементы = Форма.Элементы;
	
	Элементы.ГруппаРаботаСФайлом.Видимость = РолиПользователя.ОперацииФронтОфиса;
	Элементы.ПоместитьДанныеВБуфер.Видимость = РолиПользователя.ОперацииФронтОфиса;
	Элементы.ГруппаКомандыФронтОфиса.Видимость = РолиПользователя.ОперацииФронтОфиса;
	
	Элементы.ВыполнитьЗадачиПодтверждения.Видимость = РолиПользователя.КлиентскийУчет; 
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРолиПользователя()
	
	Возврат Новый Структура("ОперацииФронтОфиса, КлиентскийУчет",
			РаботаСПользователями.РолиДоступны("ОперацииФронтОфисаУправляющейКомпании"),
			РаботаСПользователями.РолиДоступны("КлиентскийУчет"));
					
КонецФункции

&НаСервере
Процедура ОбновитьТаблицуНаСервере()
	
	ОбъектНаСервере                 = РеквизитФормыВЗначение("Объект");
	ТаблицаПорученийДляСогласования = РеквизитФормыВЗначение("ПорученияДляСогласования");
	
	ТаблицаПорученийДляСогласования.Очистить();
	
	МВТ = ОбъектНаСервере.ПолучитьДанныеПоПоручениям(ЭтаФорма.Организация, ЭтаФорма.Дата);
	
	ДанныеНаСервере = СформироватьДанныеТаблицы(МВТ, ЭтаФорма.Организация, ЭтаФорма.Дата);
	 
	Для Каждого СтрокаДанных Из ДанныеНаСервере Цикл
		
		НоваяСтрокаТаблицы = ТаблицаПорученийДляСогласования.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, СтрокаДанных);
		НоваяСтрокаТаблицы = СтрокаДанных.Поручение.УникальныйИдентификатор() 
		
	КонецЦикла;

	ЗначениеВРеквизитФормы(ТаблицаПорученийДляСогласования, "ПорученияДляСогласования");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьДанныеТаблицы(МВТ, Организация, Дата) 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Поручения.Ссылка КАК Поручение,
		|	ЗадачаИсполнителя.Ссылка КАК Задача,
		|	НЕ СоставГруппПользователей.Пользователь ЕСТЬ NULL КАК ФлЗадачаПользователя,
		|	ЗадачаИсполнителя.Выполнена КАК Выполнена,
		|	ВЫБОР
		|		КОГДА _Поручения.Отменено
		|				ИЛИ ЗадачаИсполнителя.ПометкаУдаления
		|				ИЛИ ЗадачаИсполнителя.БизнесПроцесс.Отменен
		|				ИЛИ ЗадачаИсполнителя.БизнесПроцесс.ПометкаУдаления
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Отменена
		|ПОМЕСТИТЬ _ЗадачиДляСогласования
		|ИЗ
		|	_Поручения КАК _Поручения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
		|		ПО _Поручения.Ссылка = ЗадачаИсполнителя.Основание
		|			И (ЗадачаИсполнителя.Организация = &Организация)
		|			И (ТИПЗНАЧЕНИЯ(ЗадачаИсполнителя.БизнесПроцесс) = ТИП(БизнесПроцесс.СогласованиеПорученийНаВыводАктивов))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставГруппПользователей КАК СоставГруппПользователей
		|		ПО (ЗадачаИсполнителя.ГруппаИсполнителей = СоставГруппПользователей.ГруппаПользователей)
		|			И (СоставГруппПользователей.ГруппаПользователей.Организация = &Организация)
		|			И (СоставГруппПользователей.Пользователь = &Исполнитель)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДенежныеСредстваДляВывода.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДенежныеСредстваДляВывода.Валюта КАК Валюта,
		|	СУММА(ДенежныеСредстваДляВывода.Сумма) КАК Сумма
		|ПОМЕСТИТЬ _ОстаткиДенежныхСредствПодПолныйВывод
		|ИЗ
		|	(ВЫБРАТЬ
		|		ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		ОстаткиДенежныхСредствОстатки.Валюта КАК Валюта,
		|		ОстаткиДенежныхСредствОстатки.СуммаОстаток КАК Сумма
		|	ИЗ
		|		РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|				&НачалоДня,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В
		|						(ВЫБРАТЬ
		|							_Поручения.СчетДоверительногоУправления
		|						ИЗ
		|							_Поручения КАК _Поручения
		|						ГДЕ
		|							_Поручения.ВыводВсехАктивов)) КАК ОстаткиДенежныхСредствОстатки
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления,
		|		ЗадолженностиПоДенежнымСредствамОстатки.Валюта,
		|		ВЫБОР
		|			КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|				ТОГДА -1
		|			ИНАЧЕ 1
		|		КОНЕЦ * (ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток)
		|	ИЗ
		|		РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|				&НачалоДня,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В
		|						(ВЫБРАТЬ
		|							_Поручения.СчетДоверительногоУправления
		|						ИЗ
		|							_Поручения КАК _Поручения
		|						ГДЕ
		|							_Поручения.ВыводВсехАктивов)
		|					И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРепо), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРепо))) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ЗадолженностиПоВторойЧастиРЕПООстатки.СчетДоверительногоУправления,
		|		ЗадолженностиПоВторойЧастиРЕПООстатки.Валюта,
		|		ВЫБОР
		|			КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|				ТОГДА -1
		|			ИНАЧЕ 1
		|		КОНЕЦ * (ЗадолженностиПоВторойЧастиРЕПООстатки.СуммаОстаток + ЗадолженностиПоВторойЧастиРЕПООстатки.СуммаКупонаОстаток)
		|	ИЗ
		|		РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.Остатки(
		|				&НачалоДня,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В
		|						(ВЫБРАТЬ
		|							_Поручения.СчетДоверительногоУправления
		|						ИЗ
		|							_Поручения КАК _Поручения
		|						ГДЕ
		|							_Поручения.ВыводВсехАктивов)
		|					И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)) КАК ЗадолженностиПоВторойЧастиРЕПООстатки) КАК ДенежныеСредстваДляВывода
		|
		|СГРУППИРОВАТЬ ПО
		|	ДенежныеСредстваДляВывода.СчетДоверительногоУправления,
		|	ДенежныеСредстваДляВывода.Валюта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОстаткиДенежныхСредствПодПолныйВывод.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СУММА(_ОстаткиДенежныхСредствПодПолныйВывод.Сумма * КурсыВалютСрезПоследних.Курс / КурсыВалютСрезПоследних.Кратность) КАК Сумма
		|ПОМЕСТИТЬ _РублевыеОстаткиДенежныхСредствПодПолныйВывод
		|ИЗ
		|	_ОстаткиДенежныхСредствПодПолныйВывод КАК _ОстаткиДенежныхСредствПодПолныйВывод
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&НачалоДня, Период = НАЧАЛОПЕРИОДА(&НачалоДня, ДЕНЬ)) КАК КурсыВалютСрезПоследних
		|		ПО _ОстаткиДенежныхСредствПодПолныйВывод.Валюта = КурсыВалютСрезПоследних.Валюта
		|
		|СГРУППИРОВАТЬ ПО
		|	_ОстаткиДенежныхСредствПодПолныйВывод.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Поручения.Ссылка КАК Поручение,
		|	ВЫБОР
		|		КОГДА _ПодчиненныеДокументы.Поручение ЕСТЬ NULL
		|			ТОГДА ВЫБОР
		|					КОГДА _Поручения.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|						ТОГДА ""В ОБРАБОТКЕ""
		|					ИНАЧЕ ВЫБОР
		|							КОГДА ОтмененныеЗадачи.Поручение ЕСТЬ NULL
		|								ТОГДА ВЫБОР
		|										КОГДА ВсеЗадачиПользователя.Поручение ЕСТЬ NULL
		|											ТОГДА ""ПОРУЧЕНИЕ НА СОГЛАСОВАНИИ""
		|										КОГДА ВсеЗадачиПользователя.Количество = 1
		|											ТОГДА ВЫБОР
		|													КОГДА НевыполненныеЗадачиПользователя.Поручение ЕСТЬ NULL
		|														ТОГДА ""ПОРУЧЕНИЕ СОГЛАСОВАНО""
		|													ИНАЧЕ ""ОЖИДАЕТ СОГЛАСОВАНИЯ""
		|												КОНЕЦ
		|										КОГДА ВсеЗадачиПользователя.Количество = 2
		|											ТОГДА ВЫБОР
		|													КОГДА НевыполненныеЗадачиПользователя.Поручение ЕСТЬ NULL
		|														ТОГДА ""ПОРУЧЕНИЕ СОГЛАСОВАНО""
		|													КОГДА НевыполненныеЗадачиПользователя.Количество = 1
		|														ТОГДА ""ПРОЙДЕН КОНТРОЛЬ""
		|													ИНАЧЕ ""ОЖИДАЕТ СОГЛАСОВАНИЯ""
		|												КОНЕЦ
		|									КОНЕЦ
		|							ИНАЧЕ ""ОТМЕНЕНО""
		|						КОНЕЦ
		|				КОНЕЦ
		|		ИНАЧЕ ВЫБОР
		|				КОГДА _ПодчиненныеДокументы.ЕстьСтрокаБанковскойВыписки
		|					ТОГДА ВЫБОР
		|							КОГДА _Поручения.ВыводВсехАктивов
		|								ТОГДА ВЫБОР
		|										КОГДА _Поручения.Исполнено
		|											ТОГДА ""ИСПОЛНЕНО""
		|										ИНАЧЕ ""ЧАСТИЧНО ИСПОЛНЕНО""
		|									КОНЕЦ
		|							ИНАЧЕ ВЫБОР
		|									КОГДА _Поручения.СуммаЗадолженностиОстаток <> 0
		|										ТОГДА ""ЧАСТИЧНО ИСПОЛНЕНО""
		|									ИНАЧЕ ""ИСПОЛНЕНО""
		|								КОНЕЦ
		|						КОНЕЦ
		|				ИНАЧЕ ""В ОБРАБОТКЕ""
		|			КОНЕЦ
		|	КОНЕЦ КАК Статус
		|ПОМЕСТИТЬ _СтатусыПоручений
		|ИЗ
		|	_Поручения КАК _Поручения
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПодчиненныеДокументы КАК _ПодчиненныеДокументы
		|		ПО _Поручения.Ссылка = _ПодчиненныеДокументы.Поручение
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_ЗадачиДляСогласования.Поручение КАК Поручение,
		|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ЗадачиДляСогласования.Задача) КАК Количество
		|		ИЗ
		|			_ЗадачиДляСогласования КАК _ЗадачиДляСогласования
		|		ГДЕ
		|			_ЗадачиДляСогласования.ФлЗадачаПользователя
		|			И НЕ _ЗадачиДляСогласования.Выполнена
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_ЗадачиДляСогласования.Поручение) КАК НевыполненныеЗадачиПользователя
		|		ПО _Поручения.Ссылка = НевыполненныеЗадачиПользователя.Поручение
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_ЗадачиДляСогласования.Поручение КАК Поручение,
		|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ЗадачиДляСогласования.Задача) КАК Количество
		|		ИЗ
		|			_ЗадачиДляСогласования КАК _ЗадачиДляСогласования
		|		ГДЕ
		|			_ЗадачиДляСогласования.ФлЗадачаПользователя
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_ЗадачиДляСогласования.Поручение) КАК ВсеЗадачиПользователя
		|		ПО _Поручения.Ссылка = ВсеЗадачиПользователя.Поручение
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			_ЗадачиДляСогласования.Поручение КАК Поручение
		|		ИЗ
		|			_ЗадачиДляСогласования КАК _ЗадачиДляСогласования
		|		ГДЕ
		|			_ЗадачиДляСогласования.Отменена) КАК ОтмененныеЗадачи
		|		ПО _Поручения.Ссылка = ОтмененныеЗадачи.Поручение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Поручения.Ссылка КАК Поручение,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВЫРАЗИТЬ(_Поручения.Ссылка КАК Документ.ПоручениеНаДвижениеДенежныхСредств).Ссылка) КАК Идентификатор,
		|	_Поручения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Поручения.СчетДоверительногоУправления.КодСчета КАК КодСчета,
		|	_Поручения.СпособПередачи КАК СпособПередачи,
		|	ВЫБОР
		|		КОГДА _Поручения.СпособПередачи = ЗНАЧЕНИЕ(Перечисление.СпособыПередачиПоручений.ВнутренняяСистема)
		|			ТОГДА ""ВНУТРЕННЕЕ""
		|		ИНАЧЕ ""КЛИЕНТСКОЕ""
		|	КОНЕЦ КАК ВидПоручения,
		|	_Поручения.ТипЗадолженности КАК ТипЗадолженности,
		|	_Поручения.РасчетныйСчет КАК РасчетныйСчет,
		|	_Поручения.РасчетныйСчетПолучатель КАК РасчетныйСчетПолучатель,
		|	ВЫБОР
		|		КОГДА _Поручения.Сумма > _Поручения.СуммаЗадолженностиОстаток
		|			ТОГДА _Поручения.Сумма - _Поручения.СуммаЗадолженностиОстаток
		|		ИНАЧЕ _Поручения.Сумма
		|	КОНЕЦ КАК Сумма,
		|	_Поручения.Валюта КАК Валюта,
		|	ЕСТЬNULL(_НачисленияЗадолженности.ВидЗадолженности, ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПустаяСсылка)) КАК ВидЗадолженности,
		|	_Поручения.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
		|	_Поручения.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
		|	_Поручения.ВыводВсехАктивов КАК ВыводВсехАктивов,
		|	_Поручения.ПоручениеНаПереводМеждуСчетамиДУ КАК ПоручениеНаПереводМеждуСчетамиДУ,
		|	_Поручения.ДатаИсполненияС КАК ДатаИсполненияС,
		|	_Поручения.ДатаИсполненияПо КАК ДатаИсполненияПо,
		|	ВЫБОР
		|		КОГДА _Поручения.ДатаИсполненияПо >= &НачалоДня
		|			ТОГДА РАЗНОСТЬДАТ(&НачалоДня, _Поручения.ДатаИсполненияПо, ДЕНЬ)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоДнейДоКрайнейДатыИсполнения,
		|	ВЫБОР
		|		КОГДА _Поручения.ДатаИсполненияС <= &НачалоДня
		|				И _Поручения.ДатаИсполненияПо >= &НачалоДня
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК НаступилПериодИсполнения,
		|	_СтатусыПоручений.Статус КАК Статус,
		|	ВЫБОР
		|		КОГДА _Поручения.СпособПередачи = ЗНАЧЕНИЕ(Перечисление.СпособыПередачиПоручений.ВнутренняяСистема)
		|				И НЕ _СчетаИзНастроекУчетаДоходовПоЦеннымБумагам.РасчетныйСчет ЕСТЬ NULL
		|			ТОГДА _Поручения.РасчетныйСчет = _СчетаИзНастроекУчетаДоходовПоЦеннымБумагам.РасчетныйСчет
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК СчетСоответствуетСчетуИзНастроек,
		|	_Поручения.Отменено КАК Отменено
		|ПОМЕСТИТЬ _ДанныеПоПоручениям
		|ИЗ
		|	_Поручения КАК _Поручения
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СтатусыПоручений КАК _СтатусыПоручений
		|		ПО _Поручения.Ссылка = _СтатусыПоручений.Поручение
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НачисленияЗадолженности КАК _НачисленияЗадолженности
		|		ПО _Поручения.Основание = _НачисленияЗадолженности.ОснованиеПоручения
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаИзНастроекУчетаДоходовПоЦеннымБумагам КАК _СчетаИзНастроекУчетаДоходовПоЦеннымБумагам
		|		ПО _Поручения.Организация = _СчетаИзНастроекУчетаДоходовПоЦеннымБумагам.Организация
		|			И _Поручения.СчетДоверительногоУправления = _СчетаИзНастроекУчетаДоходовПоЦеннымБумагам.СчетДоверительногоУправления
		|			И _Поручения.Валюта = _СчетаИзНастроекУчетаДоходовПоЦеннымБумагам.Валюта
		|ГДЕ
		|	(НЕ _Поручения.Отменено
		|			ИЛИ _Поручения.ОтмененоВТекущемДне)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеПоПоручениям.Поручение КАК Поручение
		|ПОМЕСТИТЬ _ПерекрестныеПоручения
		|ИЗ
		|	_ДанныеПоПоручениям КАК _ДанныеПоПоручениям
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_ДанныеПоПоручениям.РасчетныйСчет КАК РасчетныйСчет,
		|			_ДанныеПоПоручениям.РасчетныйСчетПолучатель КАК РасчетныйСчетПолучатель,
		|			_ДанныеПоПоручениям.ДатаИсполненияС КАК ДатаИсполненияС,
		|			_ДанныеПоПоручениям.ДатаИсполненияПо КАК ДатаИсполненияПо
		|		ИЗ
		|			_ДанныеПоПоручениям КАК _ДанныеПоПоручениям
		|		ГДЕ
		|			_ДанныеПоПоручениям.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			И _ДанныеПоПоручениям.ПоручениеНаПереводМеждуСчетамиДУ
		|			И _ДанныеПоПоручениям.СпособПередачи <> ЗНАЧЕНИЕ(Перечисление.СпособыПередачиПоручений.ВнутренняяСистема)) КАК _ПерекрестныеПоручения
		|		ПО _ДанныеПоПоручениям.РасчетныйСчет = _ПерекрестныеПоручения.РасчетныйСчетПолучатель
		|			И _ДанныеПоПоручениям.РасчетныйСчетПолучатель = _ПерекрестныеПоручения.РасчетныйСчет
		|			И (_ДанныеПоПоручениям.ПоручениеНаПереводМеждуСчетамиДУ)
		|			И (_ДанныеПоПоручениям.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская))
		|			И (_ДанныеПоПоручениям.СпособПередачи <> ЗНАЧЕНИЕ(Перечисление.СпособыПередачиПоручений.ВнутренняяСистема))
		|			И (_ДанныеПоПоручениям.ДатаИсполненияС МЕЖДУ _ПерекрестныеПоручения.ДатаИсполненияС И _ПерекрестныеПоручения.ДатаИсполненияПо
		|				ИЛИ _ДанныеПоПоручениям.ДатаИсполненияПо МЕЖДУ _ПерекрестныеПоручения.ДатаИсполненияС И _ПерекрестныеПоручения.ДатаИсполненияПо
		|				ИЛИ _ПерекрестныеПоручения.ДатаИсполненияС МЕЖДУ _ДанныеПоПоручениям.ДатаИсполненияС И _ДанныеПоПоручениям.ДатаИсполненияПо
		|				ИЛИ _ПерекрестныеПоручения.ДатаИсполненияПо МЕЖДУ _ДанныеПоПоручениям.ДатаИсполненияС И _ДанныеПоПоручениям.ДатаИсполненияПо)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеПоПоручениям.Поручение КАК Поручение,
		|	_ДанныеПоПоручениям.Идентификатор КАК Идентификатор,
		|	_ДанныеПоПоручениям.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДанныеПоПоручениям.КодСчета КАК КодСчета,
		|	_ДанныеПоПоручениям.ВидПоручения КАК ВидПоручения,
		|	_ДанныеПоПоручениям.ТипЗадолженности КАК ТипЗадолженности,
		|	_ДанныеПоПоручениям.РасчетныйСчет КАК РасчетныйСчет,
		|	_ДанныеПоПоручениям.РасчетныйСчетПолучатель КАК РасчетныйСчетПолучатель,
		|	ВЫБОР
		|		КОГДА _ДанныеПоПоручениям.ВыводВсехАктивов
		|			ТОГДА _РублевыеОстаткиДенежныхСредствПодПолныйВывод.Сумма
		|		ИНАЧЕ _ДанныеПоПоручениям.Сумма
		|	КОНЕЦ КАК Сумма,
		|	ВЫБОР
		|		КОГДА _ДанныеПоПоручениям.ВыводВсехАктивов
		|			ТОГДА &ВалютаУчета
		|		ИНАЧЕ _ДанныеПоПоручениям.Валюта
		|	КОНЕЦ КАК Валюта,
		|	_ДанныеПоПоручениям.ВидЗадолженности КАК ВидЗадолженности,
		|	_ДанныеПоПоручениям.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
		|	_ДанныеПоПоручениям.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
		|	_ДанныеПоПоручениям.ВыводВсехАктивов КАК ВыводВсехАктивов,
		|	_ДанныеПоПоручениям.ПоручениеНаПереводМеждуСчетамиДУ КАК ПоручениеНаПереводМеждуСчетамиДУ,
		|	_ДанныеПоПоручениям.ДатаИсполненияС КАК ДатаИсполненияС,
		|	_ДанныеПоПоручениям.ДатаИсполненияПо КАК ДатаИсполненияПо,
		|	_ДанныеПоПоручениям.КоличествоДнейДоКрайнейДатыИсполнения КАК КоличествоДнейДоКрайнейДатыИсполнения,
		|	_ДанныеПоПоручениям.НаступилПериодИсполнения КАК НаступилПериодИсполнения,
		|	_ДанныеПоПоручениям.Статус КАК Статус,
		|	_ДанныеПоПоручениям.СчетСоответствуетСчетуИзНастроек КАК СчетСоответствуетСчетуИзНастроек,
		|	НЕ _ПерекрестныеПоручения.Поручение ЕСТЬ NULL КАК ПерекрестноеПоручение
		|ИЗ
		|	_ДанныеПоПоручениям КАК _ДанныеПоПоручениям
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РублевыеОстаткиДенежныхСредствПодПолныйВывод КАК _РублевыеОстаткиДенежныхСредствПодПолныйВывод
		|		ПО _ДанныеПоПоручениям.СчетДоверительногоУправления = _РублевыеОстаткиДенежныхСредствПодПолныйВывод.СчетДоверительногоУправления
		|			И (_ДанныеПоПоручениям.ВыводВсехАктивов)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПерекрестныеПоручения КАК _ПерекрестныеПоручения
		|		ПО _ДанныеПоПоручениям.Поручение = _ПерекрестныеПоручения.Поручение
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ДанныеПоПоручениям.Поручение,
		|	"""",
		|	ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления,
		|	ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления.КодСчета,
		|	_ДанныеПоПоручениям.ВидПоручения,
		|	ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская),
		|	_ДанныеПоПоручениям.РасчетныйСчет,
		|	_ДанныеПоПоручениям.РасчетныйСчетПолучатель,
		|	_ДанныеПоПоручениям.Сумма,
		|	_ДанныеПоПоручениям.Валюта,
		|	_ДанныеПоПоручениям.ВидЗадолженности,
		|	_ДанныеПоПоручениям.НомерВходящегоДокумента,
		|	_ДанныеПоПоручениям.ДатаВходящегоДокумента,
		|	_ДанныеПоПоручениям.ВыводВсехАктивов,
		|	_ДанныеПоПоручениям.ПоручениеНаПереводМеждуСчетамиДУ,
		|	_ДанныеПоПоручениям.ДатаИсполненияС,
		|	_ДанныеПоПоручениям.ДатаИсполненияПо,
		|	_ДанныеПоПоручениям.КоличествоДнейДоКрайнейДатыИсполнения,
