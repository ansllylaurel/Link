Функция ПолучитьДанныеЕсиа(ИмяГруппыОбъектов, ИмяОбъекта = Неопределено, Идентификатор = Неопределено, УсловиеОтбора = Неопределено, ПараметрыПодключения = Неопределено)  
	
	// Функция возвращает:
	// 1. для ИмяГруппыОбъектов = "attachments" - двоичные данные файла
	// 2. если поиск по идентификатору - соответствие объекта
	// 3. если поиск по условию - массив соответствий объектов
	
	Если Идентификатор = Неопределено И УсловиеОтбора = Неопределено Тогда
		ЗафиксироватьСообщение("При получении данных Есиа необходимо указать значение параметра [Идентификатор] или [Условие отбора]");
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстСообщения = "Ошибка получения данных [" + ИмяГруппыОбъектов + "] системы ЕСИА.Финанс " 
						+ ?(ЗначениеЗаполнено(Идентификатор), "по id [" + Идентификатор + "]", "по условию [" + УсловиеОтбора + "]");
		
	ПараметрыПодключения = ?(ПараметрыПодключения = Неопределено, ПолучитьПараметрыПодключения(), ПараметрыПодключения);
	
	Если ПараметрыПодключения = Неопределено Тогда
		ЗафиксироватьСообщение(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаЗапроса = СтрШаблон("/api/v1/back_office/%1%2", ИмяГруппыОбъектов, ?(ЗначениеЗаполнено(Идентификатор), "/" + Идентификатор, "?" + УсловиеОтбора));
			
	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("GET", ПараметрыПодключения, СтрокаЗапроса,, ТекстСообщения);

	Если HTTPОтвет = Неопределено Тогда
		ЗафиксироватьСообщение(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ИмяГруппыОбъектов = "attachments" Тогда
		Возврат HTTPОтвет.ПолучитьТелоКакДвоичныеДанные(); //возвращаем файл в виде двоичных данных
	КонецЕсли;
	
	ОтветОбъект = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));  
	
	Если ОтветОбъект["success"] = Истина Тогда 
		
		Если ИмяОбъекта = Неопределено Тогда
		
			Возврат ОтветОбъект;
			
		ИначеЕсли ЗначениеЗаполнено(ОтветОбъект[ИмяОбъекта]) Тогда 
			
			Возврат ОтветОбъект[ИмяОбъекта]; // 1. соответствие (если поиск по идентификатору), 2. массив (если поиск по условию)
			
		Иначе
			ЗафиксироватьСообщение(ТекстСообщения);
			Возврат Неопределено;	
		КонецЕсли;
	
	Иначе	
		ЗафиксироватьСообщение(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
		
КонецФункции

Функция ПреобразоватьВидЗаявки(ВидЗаявки)
	
	Если ВидЗаявки = "du_origin" Тогда
		Возврат "ЗаключениеДоговора";
	КонецЕсли;
	
	ВидыЗаявок = Новый Соответствие;
	ВидыЗаявок.Вставить("pifs_purchase", Перечисления.ВидыЗаявокПайщиков.Зачисление); 
	ВидыЗаявок.Вставить("pifs_selling", Перечисления.ВидыЗаявокПайщиков.Погашение);
	ВидыЗаявок.Вставить("pifs_exchange", Перечисления.ВидыЗаявокПайщиков.Обмен);
	
	Для Каждого ТекВид Из ВидыЗаявок Цикл 
		
		Если ТекВид.Ключ = ВидЗаявки Тогда
			Возврат ТекВид.Значение;
		ИначеЕсли ТекВид.Значение = ВидЗаявки Тогда
			Возврат ТекВид.Ключ;
		КонецЕсли;                                                      
	
	КонецЦикла;
	
	ЗафиксироватьСообщение("Не удалось преобразовать вид заявки по значению [" + ВидЗаявки + "]");
	Возврат Неопределено;

КонецФункции

Функция ПолучитьСтатус(СтатусЕсиа)
	
	СтатусыЗаявок = Новый Соответствие;
	СтатусыЗаявок.Вставить("draft", "Черновик");
	СтатусыЗаявок.Вставить("order_draft", "Черновик Винвестор");
	СтатусыЗаявок.Вставить("in_queue", "Новая");
	СтатусыЗаявок.Вставить("in_process", "В работе");
	СтатусыЗаявок.Вставить("elaboration", "Необходимы уточнения");
	СтатусыЗаявок.Вставить("wait_for_sign", "Требуется подпись");
	СтатусыЗаявок.Вставить("done", "Исполнена");
	СтатусыЗаявок.Вставить("rejected", "Отклонена");
	СтатусыЗаявок.Вставить("wrong", "Ошибочная");
	СтатусыЗаявок.Вставить("cancel", "Отменена");
	
	Статус = СтатусыЗаявок.Получить(СтатусЕсиа);
	
	Если Статус = Неопределено Тогда 	
		ЗафиксироватьСообщение("Не удалось определить статус заявки по значению [" + СтатусЕсиа + "]");
		Возврат Неопределено;
	Иначе
		Возврат Статус + " (" + СтатусЕсиа + ")"; 
	КонецЕсли;
		
КонецФункции

Процедура ДесериализоватьДанныеЗаявокЕсиа(ПараметрыЗаявок, ТаблицаПриемникДанных, ПараметрыПодключения)
	
	Если Не ПараметрыЗаявок.Свойство("ВидЗаявки") Тогда
		Возврат;
	КонецЕсли;
		
	УсловиеОтбора = "claim_owner_type=User&filter%5Bkind%5D=" + ПараметрыЗаявок.ВидЗаявки; 
	
	Если ПараметрыЗаявок.Свойство("Дата") Тогда	
		УсловиеОтбора =  УсловиеОтбора + "&filter%5Bcreated_at%5D%5Bgt%5D=" + Формат(ПараметрыЗаявок.Дата, "ДФ=dd.MM.yyyy");
	КонецЕсли; 
	
	Если ПараметрыЗаявок.Свойство("Статус") Тогда	
		УсловиеОтбора =  УсловиеОтбора + "&filter%5Bstatus%5D=" + ПараметрыЗаявок.Статус;
	КонецЕсли;
	
	МассивДанныхЕсиа = ПолучитьДанныеЕсиа("claims", "claims",, УсловиеОтбора, ПараметрыПодключения);
 	
	Если МассивДанныхЕсиа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если МассивДанныхЕсиа.Количество() = 0 Тогда //отсутствуют заявки
		ЗафиксироватьСообщение("В системе ЕСИА.Финанс отсутствуют заявки [вид = " + ПараметрыЗаявок.ВидЗаявки 
								+ ?(ПараметрыЗаявок.Свойство("Дата"), ", дата создания >= " + Формат(ПараметрыЗаявок.Дата, "ДФ=dd.MM.yyyy"), "") + "]", Ложь);
		Возврат;
	Конецесли;
	
	Для Каждого ТекЗаявка Из МассивДанныхЕсиа Цикл
		
		Если ПараметрыЗаявок.Свойство("Статус") И ПараметрыЗаявок.Статус <> ТекЗаявка["status"] Тогда
			Продолжить;
		КонецЕсли;
		
		ТекДатаЗаявки = ТекЗаявка["created_at"];
		
		Если ПараметрыЗаявок.Свойство("Дата") И ПараметрыЗаявок.Дата <> НачалоДня(ТекДатаЗаявки) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПараметрыЗаявок.Свойство("ТипВладельца") И ТекЗаявка["owner_type"] <> Неопределено И ПараметрыЗаявок.ТипВладельца <> ТекЗаявка["owner_type"] Тогда
			Продолжить;
		Конецесли;
		
		Если ПараметрыЗаявок.Свойство("ТипВладельца") И ПараметрыЗаявок.ТипВладельца = "Fund"
			И Не ЗаписатьКодЕсиаКакИдентификаторФонда(ТекЗаявка["owner_id"], ПараметрыПодключения) Тогда
			
			Продолжить;
		КонецЕсли;
		
		НоваяЗапись = ТаблицаПриемникДанных.Добавить();
		
		НоваяЗапись.Идентификатор = ТекЗаявка["id"];
		НоваяЗапись.ВидЗаявки = ПреобразоватьВидЗаявки(ТекЗаявка["kind"]);
		НоваяЗапись.Статус = ТекЗаявка["status"];
		НоваяЗапись.ИдентификаторПользователя = ТекЗаявка["user_id"];
		НоваяЗапись.НомерЗаявки = ТекЗаявка["inner_code"];
		НоваяЗапись.ДатаЗаявки = ТекДатаЗаявки;
		НоваяЗапись.ИдентификаторАктива = ТекЗаявка["owner_id"];
		
		//файлы с подписями получаем только для активных заявок
		Если СтрНайти("in_queue, in_process, done", ТекЗаявка["status"]) > 0 Тогда
		
			ДанныеЗаявки = ПолучитьДанныеЕсиа("claims", "claim", ТекЗаявка["id"],, ПараметрыПодключения);
			
			Если ДанныеЗаявки = Неопределено Или Не ЗначениеЗаполнено(ДанныеЗаявки["attachments"]) Тогда	
				ЗафиксироватьСообщение("Ошибка получения вложенных Файлов из системы ЕСИА.Финанс. Заявка id [" + ТекЗаявка["id"] + "]");
				НоваяЗапись.ЕстьОшибкиДанных = Истина;
				Продолжить;
			КонецЕсли;
			
			НоваяЗапись.МассивФайлов = ПолучитьМассивФайлов(ТекЗаявка["kind"], ДанныеЗаявки["attachments"], ПараметрыПодключения);
			
			СтруктураПодписи = ПолучитьПодпись(НоваяЗапись.МассивФайлов);
			
			Если СтруктураПодписи = Неопределено Тогда
				ЗафиксироватьСообщение("Ошибка получения данных подписи заявки [id " + ТекЗаявка["id"] + ", kind " + ТекЗаявка["kind"] + "] при импорте из системы ЕСИА.Финанс");
				НоваяЗапись.ЕстьОшибкиДанных = Истина;
				Продолжить;
			Иначе
				ЗаполнитьЗначенияСвойств(НоваяЗапись, СтруктураПодписи);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекЗаявка["data"]) Тогда
			
			ДеталиЗаявки = ТекЗаявка["data"]; 
			
			Если ТекЗаявка["kind"] = "du_origin" Тогда
				
				Если ЗначениеЗаполнено(ДеталиЗаявки["strategy_id"]) Тогда
					НоваяЗапись.ИдентификаторСтратегии = ДеталиЗаявки["strategy_id"];
				КонецЕсли;
				
				НоваяЗапись.ФлагИИС = (ДеталиЗаявки["is_personal_invest_account"] = Истина);
				НоваяЗапись.ФлагИИС_3 = (ДеталиЗаявки["is_personal_invest_account_new"] = Истина);
				Продолжить;
				
			КонецЕсли;
			
			НоваяЗапись.Сумма = ?(ЗначениеЗаполнено(ДеталиЗаявки["amount"]), ДеталиЗаявки["amount"], 0);
			
			Если ЗначениеЗаполнено(ДеталиЗаявки["account_number"]) Тогда
				НоваяЗапись.НомерСчетаДепо = ДеталиЗаявки["account_number"];
			Иначе
				
				Если ТекЗаявка["kind"] = "pifs_purchase" И ЗначениеЗаполнено(ТекЗаявка["metadata"]) И ТекЗаявка["metadata"]["is_with_open"] = Истина Тогда  
					
					НоваяЗапись.ОткрытьЗакрытьДепозитарныйСчет = Истина;
					
				Иначе
					ЗафиксироватьСообщение("При импорте заявки не удалось определить депозитарный счет, код ЕСИА.Финанс [" + ТекЗаявка["id"] + "].");
					НоваяЗапись.ЕстьОшибкиДанных = Истина;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ТекЗаявка["kind"] = "pifs_purchase" Тогда	
				
				НоваяЗапись.Количество = ?(ЗначениеЗаполнено(ДеталиЗаявки["pieces_amount"]), ДеталиЗаявки["pieces_amount"], 0); 
				
				НоваяЗапись.Многократная = (НоваяЗапись.ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Зачисление И ДеталиЗаявки["amount"] = Неопределено);
				
			ИначеЕсли ТекЗаявка["kind"] = "pifs_selling" Или ТекЗаявка["kind"] = "pifs_exchange" Тогда
				
				Если ДеталиЗаявки["count"] = Неопределено Тогда 
					ЗафиксироватьСообщение("При импорте заявки не удалось определить количество паев, код ЕСИА.Финанс [" + ТекЗаявка.id + "].");
					НоваяЗапись.ЕстьОшибкиДанных = Истина;	
				Иначе
					НоваяЗапись.Количество = ДеталиЗаявки["count"];
				КонецЕсли;
				
			КонецЕсли; 
			
			Если ТекЗаявка["kind"] = "pifs_exchange" Тогда
				
				НоваяЗапись.ИдентификаторАктиваДляОбмена = ДеталиЗаявки["fund_to_id"];
				
				Если ДеталиЗаявки["account_number_to"] <> Неопределено Тогда
					НоваяЗапись.НомерСчетаДепоДляОбмена = ДеталиЗаявки["account_number_to"];
				Иначе
					
					Если ЗначениеЗаполнено(ТекЗаявка["metadata"]) И ТекЗаявка["metadata"]["is_with_open"] = Истина Тогда 
						НоваяЗапись.ОткрытьДепозитарныйСчетДляОбмена = Истина;
						//Для заявок на обмен с открытием счета нужно создать заявку на приобретение с номером из поля open_inner_code 
						НоваяЗапись.НомерЗаявкиНаПриобретение = ДеталиЗаявки["open_inner_code"]; 
					Иначе
						ЗафиксироватьСообщение("При импорте заявки [идентификатор ЕСИА.Финанс " + ТекЗаявка["id"] + "] не удалось определить депозитарный счет для обмена.");
						НоваяЗапись.ЕстьОшибкиДанных = Истина;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
									
			Если ЗначениеЗаполнено(ДеталиЗаявки["requisite_id"]) Тогда 
				НоваяЗапись.ИдентификаторРасчетногоСчета = ДеталиЗаявки["requisite_id"];
			Иначе
				ЗафиксироватьСообщение("Ошибка получения банковских реквизитов заявки [id " + ТекЗаявка["id"] + "] из системы ЕСИА.Финанс");
				НоваяЗапись.ЕстьОшибкиДанных = Истина;
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЗаписатьКодЕсиаКакИдентификаторФонда(КодЕсиа, ПараметрыПодключения) 
	
	// 1. Cистема ЕСИА присваивает каждому фонду свой ID.
	// 2. Далее в настройках фонда необходимо задать идентификатор, 
	//		который используется для формирования портфеля клиента, при импорте транзакций и стоимости фондов.
	// Данная ф-ия записывает фонду portfolio_code такой-же как и ID. 
	
	ДанныеФонда = ПолучитьДанныеЕсиа("funds", "fund", КодЕсиа,, ПараметрыПодключения);
	
	Если ДанныеФонда = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Строка(КодЕсиа) <> ДанныеФонда["portfolio_code"] Тогда
					
		ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("portfolio_code", КодЕсиа)); 
		
		ТекстСообщения = "Не удалось установить portfolio_code для фонда id " + КодЕсиа;
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("PUT", ПараметрыПодключения, "/api/v1/back_office/funds/" + КодЕсиа, ТелоЗапроса, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ЗафиксироватьСообщение(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		ОтветНаЗапрос = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));

		Если ОтветНаЗапрос["success"] <> Истина Тогда	
			ЗафиксироватьСообщение(ТекстСообщения);
			Возврат Ложь;	
		КонецЕсли; 
			
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ДесериализоватьДанныеДоговоровЕсиа(ПараметрыПодключения)
	
	ТаблицаДоговоров = СформироватьТаблицуПриемник("Договоры");
	
	ДанныеЕсиа = ПолучитьДанныеЕсиа("contracts", "contracts",, "scope=management&contract_owner_type=User", ПараметрыПодключения); 
	
	Если ЗначениеЗаполнено(ДанныеЕсиа) Тогда
		
		Для Каждого ДоговорЕсиа Из ДанныеЕсиа Цикл
			
			НоваяЗапись = ТаблицаДоговоров.Добавить(); 
			
			НоваяЗапись.Идентификатор = ДоговорЕсиа["id"];
			НоваяЗапись.ВидДоговора = ДоговорЕсиа["kind"];
			НоваяЗапись.Статус = ДоговорЕсиа["status"]; //active - Действует, paused - Приостановлен, closed - Завершен, wrong - Ошибочный
			НоваяЗапись.ИдентификаторПользователя = ДоговорЕсиа["user_id"];
			НоваяЗапись.НомерДоговора = ДоговорЕсиа["inner_code"];
			
			Если ЗначениеЗаполнено(ДоговорЕсиа["signed_at"]) Тогда	
				НоваяЗапись.ДатаДоговора = ДоговорЕсиа["signed_at"];
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДоговорЕсиа["closed_at"]) Тогда	
				НоваяЗапись.ДатаРасторжения = ДоговорЕсиа["closed_at"];
			КонецЕсли;
			
			НоваяЗапись.ИдентификаторСтратегии = ДоговорЕсиа["strategy_id"];
			НоваяЗапись.ФлагИИС = (ЗначениеЗаполнено(ДоговорЕсиа["is_personal_invest_account"]) И ДоговорЕсиа["is_personal_invest_account"]);
			НоваяЗапись.ФлагИИС_3 = (ЗначениеЗаполнено(ДоговорЕсиа["is_personal_invest_account_new"]) И ДоговорЕсиа["is_personal_invest_account_new"]);
		
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТаблицаДоговоров;
	
КонецФункции

Функция ПолучитьПодпись(МассивФайлов)
			
	Для Каждого ДанныеФайла Из МассивФайлов Цикл 
		
		Если Не ДанныеФайла.ДержательПодписи Тогда 
			Продолжить;		
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(ДанныеФайла.Подпись) И ПодписьВалидна(ДанныеФайла.Подпись) Тогда 
			
			СтруктураПодписи = Новый Структура();
			
			Если СтрНайти(ДанныеФайла.Подпись["identifier"], "/") > 0 Тогда 
				
				МассивТелефонКод = СтрРазделить(ДанныеФайла.Подпись["identifier"], "/");	
				Телефон = МассивТелефонКод[0];
				
				СтруктураПодписи.Вставить("ПЭП_НомерТелефона", ?(СтрНайти(Телефон, "+") > 0, "+", "") + РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(Телефон)); 		
				СтруктураПодписи.Вставить("ПЭП_Код", СокрЛП(МассивТелефонКод[1]));
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДанныеФайла.Подпись["signed_at"]) Тогда
				СтруктураПодписи.Вставить("ПЭП_ДатаВремяПодписи", ДанныеФайла.Подпись["signed_at"]);
			КонецЕсли;
			
			Если СтруктураПодписи.Количество() = 3 И ЗначениеЗаполнено(СтруктураПодписи.ПЭП_Код) Тогда
				Возврат СтруктураПодписи;		
			Иначе
				ЗафиксироватьСообщение("Ошибка получения подписи файла id [" + ДанныеФайла.Идентификатор + "] при импорте из системы ЕСИА.Финанс. Отсутствует код ПЭП.");
				Возврат Неопределено;	
			КонецЕсли;

		ИначеЕсли ДанныеФайла.ТребуетсяПодпись Тогда 	

			ЗафиксироватьСообщение("При импорте данных из системы ЕСИА.Финанс обнаружен файл без подписи [" + ДанныеФайла.ПолноеИмя + "], id [" + ДанныеФайла.Идентификатор + "].");
			Продолжить;
			
		КонецЕсли;
		
	КонецЦикла;				
				
	Возврат Неопределено;
	
КонецФункции

Процедура ПроверитьЗаписатьБанковскийСчет(ДанныеБанковскогоСчета, Отказ)
	
	Справочники.БанковскиеСчета.СоздатьПолучитьРасчетныйСчет(
					ДанныеБанковскогоСчета.Ссылка, 
					ЭтотОбъект.Организация, 
					ДанныеБанковскогоСчета.БИК, 
					ДанныеБанковскогоСчета.НомерСчета, 
					ДанныеБанковскогоСчета.ЮрФизЛицо,
					Ложь,
					, 
					Отказ);
					
	Если Не Отказ Тогда
					
		РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(ДанныеБанковскогоСчета.Ссылка,
						Справочники.ВнешниеСистемы.ЕсиаФинанс,
						Справочники.ГруппыИмпортируемыхОбъектов.БанковскиеСчета,
						ДанныеБанковскогоСчета.Идентификатор);
						
	КонецЕсли;

КонецПроцедуры

Функция ПодписьВалидна(СтруктураПодписи)
	//simple electronic signature
	Возврат (СтруктураПодписи["kind"] = "ses" И СтруктураПодписи["is_valid_signature"] = Истина);   
		
КонецФункции

Процедура ЗаполнитьПоляПДЛ(РеквизитыАнкеты, Выборка, ИмяФлажка, Отказ)

	Описание	= "";
	Префикс		= "";
	
	Если ИмяФлажка = "is_russian_pub_person" Тогда
		Описание = Выборка._ПДЛ_РФ_Описание;
		Префикс = "irpp_";
	ИначеЕсли ИмяФлажка = "is_foreign_pub_person" Тогда	
		Описание = Выборка._ПДЛ_Ин_Описание;
		Префикс = "ifpp_";
	Иначе
		Описание = Выборка._ПДЛ_МО_Описание;
		Префикс = "ipio_"
	КонецЕсли;	
	
	Если ПустаяСтрока(Описание) Тогда
		ЗафиксироватьСообщение(СтрШаблон("В анкете физ. лица %1 не заполнено описание ПДЛ", Выборка._ФизЛицо), Истина, Отказ);
		Возврат;
	КонецЕсли;
	
	// Должность; Наименование организации; Адрес организации
	МассивПолей = СтрРазделить(Описание, ";");
	
	Если МассивПолей.Количество() <> 3 Тогда
		ЗафиксироватьСообщение(
				СтрШаблон("В анкете физ. лица %1 неверно заполнено описание ПДЛ. Необходимы должность, организация и адрес, разделенные ';'",
					Выборка._ФизЛицо),
				Истина,
				Отказ);
		Возврат;
	КонецЕсли;
	
	РеквизитыАнкеты.Вставить(Префикс + "your_position", МассивПолей[0]);
	РеквизитыАнкеты.Вставить(Префикс + "name_organization", МассивПолей[1]);
	РеквизитыАнкеты.Вставить(Префикс + "employer_address", МассивПолей[2]);
			
КонецПроцедуры

Функция ПрочитатьАдрес(ДанныеЕсиа)
	
	ИменаПолейАдреса = Новый Соответствие;	
	ИменаПолейАдреса.Вставить("Страна", "country");	
	ИменаПолейАдреса.Вставить("Индекс", "index");	
	ИменаПолейАдреса.Вставить("Регион", "region");		
	ИменаПолейАдреса.Вставить("Район", "district");	
	ИменаПолейАдреса.Вставить("НаселенныйПункт", "city");	
	ИменаПолейАдреса.Вставить("Улица", "street");
	ИменаПолейАдреса.Вставить("Дом", "house");	
	ИменаПолейАдреса.Вставить("Корпус", "corps");		
	ИменаПолейАдреса.Вставить("Квартира", "flat");

	Страна = ДанныеЕсиа[ИменаПолейАдреса["Страна"]];
	Индекс = ДанныеЕсиа[ИменаПолейАдреса["Индекс"]];
	Регион = ДанныеЕсиа[ИменаПолейАдреса["Регион"]];
	Район  = ДанныеЕсиа[ИменаПолейАдреса["Район"]];
	Город  = ДанныеЕсиа[ИменаПолейАдреса["НаселенныйПункт"]];
	Улица  = ДанныеЕсиа[ИменаПолейАдреса["Улица"]];
	
	Дом      = ДанныеЕсиа[ИменаПолейАдреса["Дом"]];
	Корпус   = ДанныеЕсиа[ИменаПолейАдреса["Корпус"]];
	Квартира = ДанныеЕсиа[ИменаПолейАдреса["Квартира"]];
	
	Дом = СтрЗаменить(Дом, "дом", "");
	Дом = СтрЗаменить(Дом, "д.", "");
	Дом = СокрЛП(СтрЗаменить(Дом, "д", ""));
    	
	ПредставлениеАдреса = "";
	ДополнитьПредставлениеАдреса(Страна,   ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(Индекс,   ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(Регион,   ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(Район,    ", ", ПредставлениеАдреса, Истина);
	ДополнитьПредставлениеАдреса(Город,    ", ", ПредставлениеАдреса, Истина);
	
	ДополнитьПредставлениеАдреса(Улица,    ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(?(ПустаяСтрока(Дом), "", "дом " + Дом),            ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(?(ПустаяСтрока(Корпус), "", "корп. " + Корпус),    ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(?(ПустаяСтрока(Квартира), "", "кв. " + Квартира),  ", ", ПредставлениеАдреса);
	
	Возврат ПредставлениеАдреса;
	
КонецФункции

Функция ПолучитьЗначенияРеквизитовАнкетыПользователя(ДанныеЕсиа, ПараметрыПодключения, СтрокаТаблицыАнкет) 
	
	ДанныеДляОпределенияСсылок = Новый Структура();
	АнкетныеДанные = Новый Структура;
	
	ТекИд = ДанныеЕсиа["id"];
			
	Если Не (ДанныеЕсиа["fill_stage"] = "registration" Или ДанныеЕсиа["fill_stage"] = "active" Или ДанныеЕсиа["fill_stage"] = "filled" Или ДанныеЕсиа["fill_stage"] = "claim") Тогда
		ЗафиксироватьСообщение("Текущий статус пользователя ЕСИА.Финанс [" + ?(ЗначениеЗаполнено(ДанныеЕсиа["fill_stage"]), ДанныеЕсиа["fill_stage"], "нет статуса") + "], [id пользователя " + ТекИд + "]. Анкета не будет загружена.");
		Возврат Неопределено;	
	КонецЕсли;
	// по умолчанию идентификация происходит по СМЭВ
	Если ДанныеЕсиа["identification_type"] <> "smev" Тогда
		ЗафиксироватьСообщение("Данные пользователя ЕСИА.Финанс не прошли первичную идентификацию [identification_type = " 
			+ ?(ЗначениеЗаполнено(ДанныеЕсиа["identification_type"]), ДанныеЕсиа["identification_type"], "отсутствует значение") + "], [id пользователя " + ТекИд + "]. Анкета не будет загружена.");
		Возврат Неопределено;	
	КонецЕсли;
		
	ФизЛицо            = ДанныеЕсиа["person_info"];
	РезультатыПроверок = ДанныеЕсиа["checks"];
	ДокументФизЛица    = ФизЛицо["document"];

	Если Не ЗначениеЗаполнено(ФизЛицо) Тогда
		ЗафиксироватьСообщение("Не удалось получить данные физ. лица по идентификатору ЕСИА.Финанс [" + ТекИд + "]");
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(РезультатыПроверок) Тогда
		ЗафиксироватьСообщение("Анкета пользователя не прошла проверку на стороне ЕСИА.Финанс [id пользователя " + ТекИд + "]. Данные не будут загружены.");
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументФизЛица) Тогда
		ЗафиксироватьСообщение("Не удалось получить данные удостоверения личности физ. лица [id пользователя ЕСИА.Финанс " + ТекИд + "]");
		Возврат Неопределено;
	КонецЕсли;
	
	Если ФизЛицо["is_actual"] <> Истина Тогда
		ЗафиксироватьСообщение("Данные пользователя ЕСИА.Финанс не актуальны [id пользователя " + ТекИд + "]. Анкета не будет загружена.");
		Возврат Неопределено;	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ФизЛицо["actuality_updated_at"]) Тогда 
		ЗафиксироватьСообщение("В данных пользователя ЕСИА.Финанс [id пользователя " + ТекИд + "] отсутствует дата актуальности. Анкета не будет загружена.");
		Возврат Неопределено;
	КонецЕсли;
								
	// ##Здесь вопрос, будут ли эти поддтверждения в ЛКК
	Если РезультатыПроверок["is_valid_info"] <> Истина Тогда
		ЗафиксироватьСообщение("Данные пользователя не подтверждены менеджером [id пользователя ЕСИА.Финанс " + ТекИд + "]. Анкета не будет загружена.");
		Возврат Неопределено;	
	КонецЕсли;
	
	Если РезультатыПроверок["no_pi_change_claim"] <> Истина Тогда
		ЗафиксироватьСообщение("У пользователя есть неподтвержденные заявки на изменение личных данных [id пользователя ЕСИА.Финанс " + ТекИд + "]. Анкета не будет загружена.");
		Возврат Неопределено;	
	КонецЕсли;
			
	Если СтрокаТаблицыАнкет.ПоЗаявкеНаИзмениеПерсональныхДанных Тогда 	
		АнкетныеДанные.Вставить("МассивФайлов", ПолучитьМассивФайлов("change_anket_data", СтрокаТаблицыАнкет.attachments, ПараметрыПодключения));			
	ИначеЕсли ЗначениеЗаполнено(ФизЛицо["attachments"]) Тогда 	
		АнкетныеДанные.Вставить("МассивФайлов", ПолучитьМассивФайлов("anket_data", ФизЛицо["attachments"], ПараметрыПодключения));
	КонецЕсли;
	
	//проверяем подписи анкет 
	Если АнкетныеДанные.Свойство("МассивФайлов") Тогда
		
		СтруктураПодписи = ПолучитьПодпись(АнкетныеДанные.МассивФайлов);
		
		Если СтруктураПодписи = Неопределено Тогда
			ЗафиксироватьСообщение("Ошибка получения подписи анкетных данных физ.лица [id " + ТекИд + "] при импорте из системы ЕСИА.Финанс");
			Возврат Неопределено;
		Иначе
			АнкетныеДанные.Вставить("СогласиеНаПередачуИнформации", Истина);
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеДляОпределенияСсылок.Вставить("ДатаАктуальности",
				?(СтрокаТаблицыАнкет.ПоЗаявкеНаИзмениеПерсональныхДанных,
					ЭтотОбъект.Дата,
					ФизЛицо["actuality_updated_at"]));
					
	ДанныеДляОпределенияСсылок.Вставить("Фамилия", ФизЛицо["surname"]);
	ДанныеДляОпределенияСсылок.Вставить("Имя", ФизЛицо["name"]);
    ДанныеДляОпределенияСсылок.Вставить("Отчество", ФизЛицо["patronymic"]);
	ДанныеДляОпределенияСсылок.Вставить("ИНН", ФизЛицо["inn"]);
	СНИЛС = ФизЛицо["snils"];
	
	Если СтрДлина(СНИЛС) = 11 Тогда
		СНИЛС = Лев(СНИЛС, 3) + "-" + Сред(СНИЛС, 4, 3) + "-" + Сред(СНИЛС, 7, 3) + " " + Прав(СНИЛС, 2);
	КонецЕсли;
	
	ДанныеДляОпределенияСсылок.Вставить("СНИЛС", СНИЛС);
	ДанныеДляОпределенияСсылок.Вставить("ДатаРождения", ФизЛицо["birthday"]);
	ДанныеДляОпределенияСсылок.Вставить("ГражданствоСтр", ВРег(ФизЛицо["nationality"]));
	
	АнкетныеДанные.Вставить("МестоРождения", ФизЛицо["birth_place"]);
	АнкетныеДанные.Вставить("Пол", ?(ФизЛицо["male"] = Истина, Перечисления.ПолФизическогоЛица.Мужской, Перечисления.ПолФизическогоЛица.Женский));
	АнкетныеДанные.Вставить("РезидентРФ", ФизЛицо["is_rf_resident"] = Истина);

	//Заполним позже одним запросом для всех клиентов
	//АнкетныеДанные.Вставить("Гражданство", Неопределено);
	АнкетныеДанные.Вставить("ВтороеГражданство", Новый Массив);
	АнкетныеДанные.Вставить("НалоговыйРезидентИностранногоГосударстваГосударство", Новый Массив);
	АнкетныеДанные.Вставить("ИностранныйНалогоплательщикГосударство", Новый Массив); 
	//------------------------------------------------

	Если ФизЛицо["is_additional_nationatilies"] = Истина Тогда
		
		ДанныеДляОпределенияСсылок.Вставить("ДопГражданстваСтр", "");
		
		Для Каждого ДопГражданство Из ФизЛицо["additional_nationatilies_items"] Цикл
			ДанныеДляОпределенияСсылок.ДопГражданстваСтр = ДанныеДляОпределенияСсылок.ДопГражданстваСтр + ВРег(ДопГражданство["country"]);	
		КонецЦикла;
		
	КонецЕсли;
	
	Если ФизЛицо["tax_status_in_foreign"] = Истина Тогда
		
		ДанныеДляОпределенияСсылок.Вставить("РезиденстваСтр", "");
		
		Для Каждого Резиденство Из ФизЛицо["tax_status_foreign_items"] Цикл
			ДанныеДляОпределенияСсылок.РезиденстваСтр = ДанныеДляОпределенияСсылок.РезиденстваСтр + ВРег(Резиденство["country"]);	
		КонецЦикла;	
		
		АнкетныеДанные.Вставить("НалоговыйРезидентИностранногоГосударства", Истина); 
		
	КонецЕсли;
			
	ДанныеДляОпределенияСсылок.Вставить("ВидДокументаСтр", ДокументФизЛица["kind"]); 
	ДанныеДляОпределенияСсылок.Вставить("КодСтраныВыдачиДокумента", ВРег(ДокументФизЛица["country_code"])); 
	//Заполним позже одним запросом для всех клиентов
	//АнкетныеДанные.Вставить("ВидУдостоверенияЛичности", Неопределено);
	//АнкетныеДанные.Вставить("СтранаВыдачиДокумента", Неопределено);
	//-----------------------------------------------
	//Реквизиты.КодАнкеты = СокрЛП(ДокументФизЛица["series"]) + " " + ДокументФизЛица["number"];
	ДанныеДляОпределенияСсылок.Вставить("СерияУдостоверенияЛичности", ДокументФизЛица["series"]);
	ДанныеДляОпределенияСсылок.Вставить("НомерУдостоверенияЛичности", ДокументФизЛица["number"]);
	АнкетныеДанные.Вставить("ДатаВыдачиУдостоверенияЛичности", ДокументФизЛица["issue_date"]);
	АнкетныеДанные.Вставить("ДатаОкончанияДействияУдостоверенияЛичности", ДокументФизЛица["expiration_date"]);
	АнкетныеДанные.Вставить("ОрганВыдавшийУдостоверениеЛичности", ДокументФизЛица["issuer"]);
    АнкетныеДанные.Вставить("КодОрганаВыдавшегоУдостоверениеЛичности", ДокументФизЛица["issuer_code"]);
	
	ДанныеДляОпределенияСсылок.Вставить("ДатаВыдачиУдостоверенияЛичности",			АнкетныеДанные.ДатаВыдачиУдостоверенияЛичности);
	ДанныеДляОпределенияСсылок.Вставить("ОрганВыдавшийУдостоверениеЛичности",		ДокументФизЛица["issuer"]);
	ДанныеДляОпределенияСсылок.Вставить("КодОрганаВыдавшегоУдостоверениеЛичности",	ДокументФизЛица["issuer_code"]);
		
	Если ЗначениеЗаполнено(РезультатыПроверок["expired_passports"]) И РезультатыПроверок["expired_passports"]["status"] = "Пройдена успешно" Тогда 	
		АнкетныеДанные.Вставить("СтатусПроверки", Перечисления.СтатусыПроверкиУдостоверенияЛичности.Действителен);	
	Иначе
		АнкетныеДанные.Вставить("СтатусПроверки", Перечисления.СтатусыПроверкиУдостоверенияЛичности.НеПроверен);	
	КонецЕсли;
	
	АнкетныеДанные.Вставить("ПроверенПоПеречнюТеррористов",
					(ЗначениеЗаполнено(РезультатыПроверок["possible_terrorists"]) И РезультатыПроверок["possible_terrorists"]["status"] = "Пройдена успешно"));

	АнкетныеДанные.Вставить("ПроверенПоПеречнюСБООН", 
					(ЗначениеЗаполнено(РезультатыПроверок["uns"]) И РезультатыПроверок["uns"]["status"] = "Пройдена успешно"));

	АнкетныеДанные.Вставить("ПроверенПоСпискамРешенийМВК", 
					(ЗначениеЗаполнено(РезультатыПроверок["frozen_assets"]) И РезультатыПроверок["frozen_assets"]["status"] = "Пройдена успешно"));
						
	АнкетныеДанные.Вставить("ПроверенПоБазеОтказовПо764П", 
					(ЗначениеЗаполнено(РезультатыПроверок["operation_cancels"]) И РезультатыПроверок["operation_cancels"]["status"] = "Пройдена успешно"));					
				
	АнкетныеДанные.Вставить("ВысокийУровеньРиска", ДанныеЕсиа["risk_level"] = "high");
	
	// Для низкого уровня риска добавляем пояснение
	Если Не АнкетныеДанные.ВысокийУровеньРиска Тогда
		АнкетныеДанные.Вставить("ОбоснованиеУровняРиска", "факторы высокого уровня риска не установлены");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФизЛицо["addresses"]) Тогда 
		
		Адреса = ФизЛицо["addresses"];
		
		АдресРегистрации		= "";
		АдресРегистрацииФИАС	= "";
		
		Если ЗначениеЗаполнено(Адреса["main"]) И ЗначениеЗаполнено(Адреса["main"]["full"]) Тогда
			АдресРегистрации = ПрочитатьАдрес(Адреса["main"]);
			
			Если Адреса["main"]["as_kladr"] = Истина Тогда	
				АдресРегистрацииФИАС = ПрочитатьАдресФИАС(Адреса["main"]);
			КонецЕсли;			
		Конецесли;
		
		АнкетныеДанные.Вставить("АдресРегистрации", АдресРегистрации);
		АнкетныеДанные.Вставить("АдресРегистрацииФИАС", АдресРегистрацииФИАС);
		
		Если ЗначениеЗаполнено(Адреса["residential"]) И Адреса["residential"]["is_active"] = Истина Тогда
			АнкетныеДанные.Вставить("АдресМестаЖительства", ПрочитатьАдрес(Адреса["residential"]));
			
			Если Адреса["residential"]["as_kladr"] = Истина Тогда
				АнкетныеДанные.Вставить("АдресМестаЖительстваФИАС", ПрочитатьАдресФИАС(Адреса["residential"]));
			КонецЕсли;
		Иначе
			АнкетныеДанные.Вставить("АдресМестаЖительства", АдресРегистрации);			
			АнкетныеДанные.Вставить("АдресМестаЖительстваФИАС", АдресРегистрацииФИАС);
		Конецесли;
		
		Если ЗначениеЗаполнено(Адреса["for_corresp"]) И Адреса["for_corresp"]["is_active"] = Истина Тогда
			АнкетныеДанные.Вставить("ПочтовыйАдрес", ПрочитатьАдрес(Адреса["for_corresp"]));
			
			Если Адреса["for_corresp"]["as_kladr"] = Истина Тогда
				АнкетныеДанные.Вставить("ПочтовыйАдресФИАС", ПрочитатьАдресФИАС(Адреса["for_corresp"]));
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли; 
	
	АнкетныеДанные.Вставить("EMail", ФизЛицо["contact_email"]); 
		
	// В ближайшем релизе ЕСИА.Финанс появится новое поле main_phone_full_str
	Если ЗначениеЗаполнено(ФизЛицо["main_phone_full_str"]) Тогда
		АнкетныеДанные.Вставить("Телефоны",				ФизЛицо["main_phone_full_str"]);
		АнкетныеДанные.Вставить("ТелефонДляОповещения",	ФизЛицо["main_phone_full_str"]);
	Иначе	
		// Код страны телефона пока отсутствует - хардкод
		АнкетныеДанные.Вставить("Телефоны",				"7" + ФизЛицо["main_phone"]);
		АнкетныеДанные.Вставить("ТелефонДляОповещения",	"7" + ФизЛицо["main_phone"]);
	КонецЕсли;
	
	ДанныеДляОпределенияСсылок.Вставить("Телефоны", АнкетныеДанные.Телефоны);
	
	ОписаниеПубличногоЛица = "";
	
	Если ФизЛицо["is_russian_pub_person"] = Истина Тогда	
		ОписаниеПубличногоЛица = ПолучитьОписаниеПубличногоЛица(ФизЛицо["irpp_name_organization"], ФизЛицо["irpp_your_position"], ФизЛицо["irpp_employer_address"]);	
	ИначеЕсли ФизЛицо["is_person_of_intercity_organizations"] = Истина Тогда
        ОписаниеПубличногоЛица = ПолучитьОписаниеПубличногоЛица(ФизЛицо["ipio_name_organization"], ФизЛицо["ipio_your_position"], ФизЛицо["ipio_employer_address"]);
	ИначеЕсли ФизЛицо["is_foreign_pub_person"] = Истина Тогда
        ОписаниеПубличногоЛица = ПолучитьОписаниеПубличногоЛица(ФизЛицо["ifpp_name_organization"], ФизЛицо["ifpp_your_position"], ФизЛицо["ifpp_employer_address"]);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеПубличногоЛица) Тогда
		АнкетныеДанные.Вставить("ЯвляетсяПубличнымДолжностнымЛицом", Истина);
		АнкетныеДанные.Вставить("ЯвляетсяПубличнымДолжностнымЛицомОписание", ОписаниеПубличногоЛица); 
	КонецЕсли; 
	
	Если ФизЛицо["is_bound_with_pub_person"] = Истина Тогда
		АнкетныеДанные.Вставить("ЯвляетсяРодственникомПубличногоДолжностногоЛица", Истина);
		АнкетныеДанные.Вставить("ЯвляетсяРодственникомПубличногоДолжностногоЛицаОписание", ФизЛицо["kinship_status"]); 	
	КонецЕсли;
	
	МассивЦелей = ФизЛицо["purpose_of_business"];
	
	Если ЗначениеЗаполнено(МассивЦелей) Тогда
		
		ОписаниеДругое = "";
		
		Для Каждого ТекЦель Из МассивЦелей Цикл
			
			Если ТекЦель = "pif_services" Тогда
				АнкетныеДанные.Вставить("ЦельПриобретениеПаев", Истина);	
			ИначеЕсли ТекЦель = "du_services" Тогда
				АнкетныеДанные.Вставить("ЦельДоверительноеУправление", Истина);
			ИначеЕсли ТекЦель = "bo_services" Тогда 
				ОписаниеДругое = ОписаниеДругое + ?(ЗначениеЗаполнено(ОписаниеДругое), ", ", "") + "брокерские услуги";
			ИначеЕсли ТекЦель = "depos_services" Тогда
				ОписаниеДругое = ОписаниеДругое + ?(ЗначениеЗаполнено(ОписаниеДругое), ", ", "") + "депозитарные услуги";
			//ИначеЕсли ТекЦель = "du_services" Тогда
			//	
			//	ОписаниеДругое = ОписаниеДругое + ?(ЗначениеЗаполнено(ОписаниеДругое), ", ", "") + 
			//		"услуги доверительного управления ценными бумагами, 
			//		|денежными средствами, предназначенными для совершения сделок с ценными бумагами 
			//		|и (или) заключения договоров, являющихся производными финансовыми инструментами";

			КонецЕсли;	
				
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ОписаниеДругое) Тогда
			АнкетныеДанные.Вставить("ЦельДругое", Истина);
			АнкетныеДанные.Вставить("ЦельДругоеОписание", ОписаниеДругое);
		КонецЕсли;
	
	КонецЕсли;
	
	АнкетныеДанные.Вставить("ЦелиДеятельности", ФизЛицо["purpose_of_activity_str"]);
	АнкетныеДанные.Вставить("ПоложительноеФинансовоеПоложение", ФизЛицо["financial_position"] = "positive");
	АнкетныеДанные.Вставить("ДеловаяРепутацияПоложительная", ФизЛицо["customer_reputation"] = "positive"); 
	АнкетныеДанные.Вставить("ИсточникиПроисхожденияДенежныхСредств", ФизЛицо["source_of_money_income_str"]);
	
	АнкетныеДанные.Вставить("РаспространениеЗаконодательстваСША", ФизЛицо["tax_status"] = "resident"); 
	
	Если ФизЛицо["foreign_address"] = "usa" Тогда  
		АнкетныеДанные.Вставить("АдресФактическогоПроживанияВИностранномГосударстве", ФизЛицо["foreign_usa_address"]); 	
	ИначеЕсли ФизЛицо["foreign_address"] = "foreign" Тогда	
		АнкетныеДанные.Вставить("АдресФактическогоПроживанияВИностранномГосударстве", ФизЛицо["foreign_address_foreign_items_str"]);	
	КонецЕсли;	
 
	
	МассивИсточников = ФизЛицо["source_of_money_income"];
	
	Если ЗначениеЗаполнено(МассивИсточников) Тогда
		
		ИсточникСтр = ""; 
		
		Для Каждого ИсточникДС Из МассивИсточников Цикл
			
			Если ИсточникДС = "personal" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), "; ", "") + "личные сбережения";
				
			ИначеЕсли ИсточникДС = "nrd_papers" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), "; ", "") + 
					"доход от операций с ценными бумагами и (или) иностранными финансовыми инструментами, не квалифицированными в соответствии с законодательством РФ в качестве ценных бумаг";	
				
			ИначеЕсли ИсточникДС = "bussiness" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), "; ", "") + 
					"доход от осуществления предпринимательской деятельности и (или) от участия в уставном (складочном) капитале коммерческой организации";
	
			ИначеЕсли ИсточникДС = "financial_instruments" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), "; ", "") + 
					"доход от операций с производными финансовыми инструментами"; 
				
			ИначеЕсли ИсточникДС = "inheritance" Тогда

				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), "; ", "") + 
					"получение наследства или активов по договору дарения";
				
			ИначеЕсли ИсточникДС = "credit" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), "; ", "") + "заем, кредит";
				
			ИначеЕсли ИсточникДС = "job" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), "; ", "") + 
					"доход по основному месту работы (включая доход от работы по совместительству)";
			ИначеЕсли ИсточникДС = "else" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), "; ", "") + "иное";
				
			КонецЕсли;
			
		КонецЦикла;
		
		АнкетныеДанные.Вставить("ИсточникиПроисхожденияДенежныхСредств", ИсточникСтр);
	
	КонецЕсли;
	
	// В ЛКК всегда Электронно
	АнкетныеДанные.Вставить("СпособУведомленияОбОперацияхПоЛицевомуСчету", Перечисления.СпособыУведомленияОбОперациях.Электронно);
	
	Возврат Новый Структура("АнкетныеДанные, ДанныеДляОпределенияСсылок", АнкетныеДанные, ДанныеДляОпределенияСсылок);
	
КонецФункции

Функция ПолучитьЗначенияБанковскихРеквизитов(Приемник, ДанныеЕсиа)
	
	Приемник.Идентификатор             = ДанныеЕсиа["id"];
	Приемник.ИдентификаторПользователя = ДанныеЕсиа["owner_id"];
	Приемник.Бик                       = ДанныеЕсиа["bik"];
	Приемник.КоррСчет                  = ДанныеЕсиа["corr_account"];
	Приемник.НомерСчета                = ДанныеЕсиа["payment_account"];
	
	Приемник.ПолучательПлатежа = ДанныеЕсиа["recipient"];
	Приемник.ИННПолучателя     = ДанныеЕсиа["inn"];
	Приемник.НазначениеПлатежа = ДанныеЕсиа["notation"];
	Приемник.НаименованиеБанка = ДанныеЕсиа["bank_name"];
	Приемник.Валюта            = Врег(ДанныеЕсиа["valuta"]);
	
	Приемник.Основной          = ДанныеЕсиа["is_base"];
	
КонецФункции

Функция ПолучитьВидДокумента(ДокументЕсиа, Страна)
	
	Если ДокументЕсиа = "passport" Тогда
		
		Если Страна = Справочники.СтраныМира.Россия Тогда
			Возврат Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ;
		Иначе
			Возврат Справочники.ВидыДокументовФизическихЛиц.ПаспортИностранногоГражданина;
		Конецесли;
		
	ИначеЕсли ДокументЕсиа = "driver_license" Тогда
		Возврат Справочники.ВидыДокументовФизическихЛиц.ВодительскоеУдостоверение;	
	ИначеЕсли ДокументЕсиа = "residence_permit" Тогда
		Возврат Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство; 
	Иначе
		Возврат Неопределено;
	КонецЕсли;
		
КонецФункции

Функция ПолучитьОписаниеПубличногоЛица(Организация, Должность, Адрес)
	
	Описание = ?(ЗначениеЗаполнено(Организация), "Наимнование организации " + Организация, "");
	Описание = Описание + ?(ЗначениеЗаполнено(Должность), "должность " + Должность, "");
	Описание = Описание + ?(ЗначениеЗаполнено(Адрес), "адрес организации " + Адрес, "");
	
КонецФункции

Функция ПолучитьПараметрыПодключения(ContentType = "application/json") Экспорт
	
	Возврат РаботаСВнешнимиСистемами.ЕСИА_Финанс_ПараметрыПодключения(ЭтотОбъект.Организация, ContentType);
	
КонецФункции

Процедура ЗафиксироватьСообщение(ТекстСообщения, Ошибка = Истина, Отказ = Ложь)
	
	Если Ошибка Тогда
	
		Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
			ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстСообщения);	
		Иначе
			ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", РаботаСКоллекциями.ЗначениеВМассив(ТекстСообщения));	
		КонецЕсли;
		
		Отказ = Истина;
		
	Иначе
		ЭтотОбъект.Результат.ДобавитьСтроку(ТекстСообщения);	
	КонецЕсли;
		
КонецПроцедуры

Процедура ОповеститьОбОшибках(ТекстОшибки = Неопределено) Экспорт
	
	Если ТекстОшибки <> Неопределено Тогда
		ЗафиксироватьСообщение(ТекстОшибки);	
	КонецЕсли;
		
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС); 
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
		
	ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");
	
КонецПроцедуры

Функция ПолучитьСтрокуJSON(Данные, ПараметрыЗаписи = Неопределено)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	
    Если ПараметрыЗаписи = Неопределено Тогда
		ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	Иначе
		ПараметрыЗаписиJSON = ПараметрыЗаписи;	
	КонецЕсли;
	
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	ЗаписатьJSON(ЗаписьJSON, Данные,,);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Возврат СтрокаJSON;
	
КонецФункции

Функция ДесериализоватьСтрокуJSON(СтрокаJSON)
	
	ИменаСвойств = "id,owner_id,fund_to_id,user_id,attachmentable_id,actuality_updated_at,birthday,issue_date,expiration_date,created_at,signed_at,closed_at";
	
	ПараметрыЧтения = Новый Структура();
	ПараметрыЧтения.Вставить("ПрочитатьВСоответствие", Истина);
	ПараметрыЧтения.Вставить("ИмяФункцииВосстановления", "ЕСИА_Финанс_ВосстановлениеЗначенияИзJSON");
	ПараметрыЧтения.Вставить("МодульФункцииВосстановления", РаботаСВнешнимиСистемами);
	ПараметрыЧтения.Вставить("ИменаСвойствДляОбработкиВосстановления", РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИменаСвойств, ","));
	  	
	ДанныеJSON = РаботаСВнешнимиСистемамиКлиентСервер.ПолучитьДанныеJSON(СтрокаJSON, ПараметрыЧтения);
	
	Если ТипЗнч(ДанныеJSON) <> Тип("Соответствие") Тогда
		
		ЗафиксироватьСообщение("Десериализация данных типа [" + ТипЗнч(ДанныеJSON) + "] не поддерживается!");
		ДанныеJSON = Новый Соответствие;
		
	КонецЕсли;
	
	Возврат ДанныеJSON;
	
КонецФункции 

Процедура ВыгрузитьДанныеВПервуюФормуКоллЦентра(НовыеКлиенты)
	
	ОбработкаЭкспорта = Обработки.ЭкспортДанныхВПервуюФормуКоллЦентра.Создать();
	ОбработкаЭкспорта.ЭкспортироватьДанныеКлиентовПослеАктивацииЛКК(ЭтотОбъект.Организация, НовыеКлиенты);
		
КонецПроцедуры

#КонецОбласти

ЭтотОбъект.ДополнительныеСвойства = Новый Структура;
