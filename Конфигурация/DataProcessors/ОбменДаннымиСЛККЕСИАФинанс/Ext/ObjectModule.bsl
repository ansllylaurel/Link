		|	_АктивыНеОтносящихсяКЦеннымБумагам.ВидЗадолженности,
		|	_АктивыНеОтносящихсяКЦеннымБумагам.Контрагент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводыВыводыАктивовВВалютеУчета.Период КАК Период,
		|	ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА ""in""
		|		ИНАЧЕ ""out""
		|	КОНЕЦ КАК Направление,
		|	ВводыВыводыАктивовВВалютеУчета.РыночнаяСтоимость КАК Сумма,
		|	ПРЕДСТАВЛЕНИЕ(ВводыВыводыАктивовВВалютеУчета.ВидАктива) КАК ВидАктива,
		|	ПРЕДСТАВЛЕНИЕ(ВводыВыводыАктивовВВалютеУчета.ВидОперацииВводаВыводаДС) КАК ВидОперацииВводаВыводаДС
		|ПОМЕСТИТЬ _ВводыВыводы
		|ИЗ
		|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ПО ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления = _СчетаДоверительногоУправления.Ссылка
		|			И (ВводыВыводыАктивовВВалютеУчета.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивыНеОтносящихсяКЦеннымБумагам.Период КАК Период,
		|	_АктивыНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ПРЕДСТАВЛЕНИЕ(_АктивыНеОтносящихсяКЦеннымБумагам.ВидАктива) КАК Сектор,
		|	""ЦБ_"" + _АктивыНеОтносящихсяКЦеннымБумагам.Валюта.Наименование КАК КодЭмитента,
		|	СУММА(_АктивыНеОтносящихсяКЦеннымБумагам.Сумма) КАК Сумма
		|ПОМЕСТИТЬ _ПрочиеАктивы
		|ИЗ
		|	_АктивыНеОтносящихсяКЦеннымБумагам КАК _АктивыНеОтносящихсяКЦеннымБумагам
		|ГДЕ
		|	НЕ _АктивыНеОтносящихсяКЦеннымБумагам.ВидАктива В (ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность), ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность))
		|
		|СГРУППИРОВАТЬ ПО
		|	_АктивыНеОтносящихсяКЦеннымБумагам.Период,
		|	_АктивыНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления,
		|	""ЦБ_"" + _АктивыНеОтносящихсяКЦеннымБумагам.Валюта.Наименование,
		|	ПРЕДСТАВЛЕНИЕ(_АктивыНеОтносящихсяКЦеннымБумагам.ВидАктива)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦенныеБумаги.Период КАК Период,
		|	_ЦенныеБумаги.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ЦенныеБумаги.КодЭмитента КАК КодЭмитента,
		|	_ЦенныеБумаги.ЭмитентНаименование КАК ЭмитентНаименование,
		|	_ЦенныеБумаги.СтранаРегистрации КАК СтранаРегистрации,
		|	_ЦенныеБумаги.Сектор КАК Сектор,
		|	СУММА(_ЦенныеБумаги.Стоимость) КАК Стоимость,
		|	СУММА(_ЦенныеБумаги.Количество) КАК Количество
		|ПОМЕСТИТЬ _АктивыПоЭмитентам
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЦенныеБумаги.Период,
		|	_ЦенныеБумаги.СчетДоверительногоУправления,
		|	_ЦенныеБумаги.КодЭмитента,
		|	_ЦенныеБумаги.ЭмитентНаименование,
		|	_ЦенныеБумаги.СтранаРегистрации,
		|	_ЦенныеБумаги.Сектор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ЦенныеБумаги.КодЭмитента КАК КодЭмитента,
		|	_ЦенныеБумаги.Сектор КАК Сектор,
		|	_ЦенныеБумаги.ЭмитентНаименование КАК Наименование,
		|	_ЦенныеБумаги.СтранаРегистрации КАК СтранаРегистрации
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_ПрочиеАктивы.КодЭмитента,
		|	_ПрочиеАктивы.Сектор,
		|	""Денежные средства"",
		|	NULL
		|ИЗ
		|	_ПрочиеАктивы КАК _ПрочиеАктивы";
#КонецОбласти

	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаВыгрузки", ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивЭмитентов = Новый Массив;
		
	Пока Выборка.Следующий() Цикл
		
		ДанныеЭмитента = Новый Структура();
		ДанныеЭмитента.Вставить("code", Выборка.Сектор + "_" + Выборка.КодЭмитента);
		ДанныеЭмитента.Вставить("name", Выборка.Наименование);
		ДанныеЭмитента.Вставить("country", ?(ЗначениеЗаполнено(Выборка.СтранаРегистрации), Выборка.СтранаРегистрации, "Российская Федерация"));
		ДанныеЭмитента.Вставить("sector", Выборка.Сектор);
		
		МассивЭмитентов.Добавить(ДанныеЭмитента);
		
	КонецЦикла;
	
	СтоимостьЧистыхАктивов = Запрос.МенеджерВременныхТаблиц.Таблицы["_СтоимостьЧистыхАктивов"].ПолучитьДанные().Выбрать();
	
	Задолженность = Запрос.МенеджерВременныхТаблиц.Таблицы["_КредиторскаяДебиторскаяЗадолженность"].ПолучитьДанные().Выгрузить();
	ПрочиеАктивы = Запрос.МенеджерВременныхТаблиц.Таблицы["_ПрочиеАктивы"].ПолучитьДанные().Выгрузить();
	ВводыВыводы = Запрос.МенеджерВременныхТаблиц.Таблицы["_ВводыВыводы"].ПолучитьДанные().Выгрузить();
	
	АктивыПоЭмитентам = Запрос.МенеджерВременныхТаблиц.Таблицы["_АктивыПоЭмитентам"].ПолучитьДанные().Выгрузить();
	ЦенныеБумаги = Запрос.МенеджерВременныхТаблиц.Таблицы["_ЦенныеБумаги"].ПолучитьДанные().Выгрузить();
	
	МассивПортфелей = Новый Массив;
	
	Пока СтоимостьЧистыхАктивов.Следующий() Цикл
		
		ЭтотПортфель = Новый Структура();
		ЭтотПортфель.Вставить("contract_code", СтоимостьЧистыхАктивов.НомерДоговора);
		ЭтотПортфель.Вставить("date", Формат(СтоимостьЧистыхАктивов.Период, "ДФ=yyyy-MM-dd"));
		ЭтотПортфель.Вставить("invest_amount", Формат(СтоимостьЧистыхАктивов.Сча, "ЧГ=0"));
        ЭтотПортфель.Вставить("portfolio_amount", Формат(СтоимостьЧистыхАктивов.Сча, "ЧГ=0"));
		ЭтотПортфель.Вставить("operations", Новый Массив);
		ЭтотПортфель.Вставить("debts", Новый Массив);
		ЭтотПортфель.Вставить("proportions", Новый Массив); 
				
		ПортфельПоЭмитентам = АктивыПоЭмитентам.НайтиСтроки(Новый Структура("СчетДоверительногоУправления, Период", СтоимостьЧистыхАктивов.СчетДоверительногоУправления, СтоимостьЧистыхАктивов.Период)); 
		
		Для Каждого СтрокаПортфеляПоЭмитентам Из ПортфельПоЭмитентам Цикл
			
			СтруктураАктивовЭмитента = Новый Структура(); 
			
			СтруктураАктивовЭмитента.Вставить("issuer_code", СтрокаПортфеляПоЭмитентам.Сектор + "_" + СтрокаПортфеляПоЭмитентам.КодЭмитента);
	        СтруктураАктивовЭмитента.Вставить("quantity", Формат(СтрокаПортфеляПоЭмитентам.Количество, "ЧГ=0"));
	        СтруктураАктивовЭмитента.Вставить("amount", Формат(СтрокаПортфеляПоЭмитентам.Стоимость, "ЧГ=0"));
			СтруктураАктивовЭмитента.Вставить("details", Новый Массив);
			
			ПараметрыОтбора = Новый Структура("Период, СчетДоверительногоУправления, КодЭмитента, ЭмитентНаименование, Сектор");
			ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаПортфеляПоЭмитентам);
			
			ЦенныеБумагиЭмитента = ЦенныеБумаги.НайтиСтроки(ПараметрыОтбора);
							
			Для Каждого СтрокаЦенныхБумаг Из ЦенныеБумагиЭмитента Цикл 
			
				СтруктураЦеннойБумаги = Новый Структура();
				СтруктураЦеннойБумаги.Вставить("amount", Формат(СтрокаЦенныхБумаг.Стоимость, "ЧГ=0"));
				СтруктураЦеннойБумаги.Вставить("quantity", Формат(СтрокаЦенныхБумаг.Количество, "ЧГ=0"));
				СтруктураЦеннойБумаги.Вставить("name", Строка(СтрокаЦенныхБумаг.ЦеннаяБумага) + " (ISIN " + Строка(СтрокаЦенныхБумаг.КодЦБ) + ")");
				//СтруктураЦеннойБумаги.Вставить("tools", Строка(СтрокаЦенныхБумаг.КодЦБ));

				СтруктураАктивовЭмитента.details.Добавить(СтруктураЦеннойБумаги);
				
			КонецЦикла;
			
			Если СтруктураАктивовЭмитента.details.Количество() = 0 Тогда
				СтруктураАктивовЭмитента.Удалить("details");	
			КонецЕсли;
			
			ЭтотПортфель.proportions.Добавить(СтруктураАктивовЭмитента);

		КонецЦикла;
		
		ВводыВыводыПортфеля = ВводыВыводы.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", СтоимостьЧистыхАктивов.СчетДоверительногоУправления));
		
		Для Каждого СтрокаВводаВывода Из ВводыВыводыПортфеля Цикл
			
			СтруктураВводаВывода = Новый Структура(); 
			
			СтруктураВводаВывода.Вставить("direction", СтрокаВводаВывода.Направление);
	        СтруктураВводаВывода.Вставить("date", Формат(СтрокаВводаВывода.Период, "ДФ=yyyy-MM-dd"));
			СтруктураВводаВывода.Вставить("instrument", СтрокаВводаВывода.ВидАктива + " (RUB)"); 
	        СтруктураВводаВывода.Вставить("amount", Формат(СтрокаВводаВывода.Сумма, "ЧГ=0"));
			СтруктураВводаВывода.Вставить("amount_converted", Формат(СтрокаВводаВывода.Сумма, "ЧГ=0"));
			СтруктураВводаВывода.Вставить("operation_name", СтрокаВводаВывода.ВидОперацииВводаВыводаДС);
            СтруктураВводаВывода.Вставить("is_referential", Истина);

			ЭтотПортфель.operations.Добавить(СтруктураВводаВывода);

		КонецЦикла;

		ПрочиеАктивыПортфеля = ПрочиеАктивы.НайтиСтроки(Новый Структура("СчетДоверительногоУправления, Период", СтоимостьЧистыхАктивов.СчетДоверительногоУправления, СтоимостьЧистыхАктивов.Период));
		
		Для Каждого СтрокаАктиваПрочее Из ПрочиеАктивыПортфеля Цикл
			
			СтруктураАктиваПрочее = Новый Структура(); 
			
			СтруктураАктиваПрочее.Вставить("issuer_code", СтрокаАктиваПрочее.Сектор + "_" + СтрокаАктиваПрочее.КодЭмитента);
	        СтруктураАктиваПрочее.Вставить("quantity", "1");
	        СтруктураАктиваПрочее.Вставить("amount", Формат(СтрокаАктиваПрочее.Сумма, "ЧГ=0"));
			
			ЭтотПортфель.proportions.Добавить(СтруктураАктиваПрочее);

		КонецЦикла;
	
		ЗадолженностьПортфеля = Задолженность.НайтиСтроки(Новый Структура("СчетДоверительногоУправления, Период", СтоимостьЧистыхАктивов.СчетДоверительногоУправления, СтоимостьЧистыхАктивов.Период));	

		Для Каждого СтрокаЗадоложенности Из ЗадолженностьПортфеля Цикл 
			
			СтруктураЗадолженности = Новый Структура; 
			
			СтруктураЗадолженности.Вставить("kind", ?(СтрокаЗадоложенности.ВидАктива = Перечисления.ВидыАктивов.ДебиторскаяЗадолженность, "debit", "credit"));
			СтруктураЗадолженности.Вставить("amount", Формат(СтрокаЗадоложенности.Сумма, "ЧГ=0"));
			СтруктураЗадолженности.Вставить("amount_converted", Формат(СтрокаЗадоложенности.Сумма, "ЧГ=0")); 
				
			ОписаниеЗадолженности = Строка(СтрокаЗадоложенности.ВидЗадолженности);
			ОписаниеЗадолженности = ОписаниеЗадолженности + ?(ЗначениеЗаполнено(ОписаниеЗадолженности), ", " + Строка(СтрокаЗадоложенности.Контрагент), "");
			
			Если ЗначениеЗаполнено(ОписаниеЗадолженности) Тогда
				СтруктураЗадолженности.Вставить("type", ОписаниеЗадолженности);
			Иначе
				СтруктураЗадолженности.Вставить("type", Строка(СтрокаЗадоложенности.ВидАктива));	
			КонецЕсли;
			
			ЭтотПортфель.debts.Добавить(СтруктураЗадолженности);
			
		КонецЦикла;
		
		Если ЭтотПортфель.operations.Количество() = 0 Тогда
			ЭтотПортфель.Удалить("operations");
		КонецЕсли;
		
		Если ЭтотПортфель.debts.Количество() = 0 Тогда
			ЭтотПортфель.Удалить("debts");	
		КонецЕсли;
					
		Если ЭтотПортфель.proportions.Количество() = 0 Тогда
			ЭтотПортфель.Удалить("proportions");	
		КонецЕсли;
				
		МассивПортфелей.Добавить(ЭтотПортфель);
	
	КонецЦикла;
	
	Если МассивПортфелей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПодключения = ПолучитьПараметрыПодключения(); 
	
	//Новый Структура("override, data", Истина, Новый Структура("issuers, states", ОписаниеАктивов, МассивПортфелей))
	
	ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("override, data", Истина, Новый Структура("issuers, states", МассивЭмитентов, МассивПортфелей))); //override = признак перезаписи
	
	ТекстСообщения = "Ошибка выгрузки данных портфелей в Есиа.Финанс.";
	
	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office/portfolio/import?import_type=du_portfolio", ТелоЗапроса, ТекстСообщения);
	
	Если HTTPОтвет = Неопределено Тогда
		ЗафиксироватьСообщение(ТекстСообщения);
	КонецЕсли; 
	
	ОповеститьОбОшибках();
	
КонецПроцедуры

Процедура ЭкспортироватьСправочникСтратегий() Экспорт 
	
	ПараметрыПодключения = ПолучитьПараметрыПодключения();
	
	ИнвестПрофилиЕсиа = ПолучитьДанныеЕсиа("calculated_profiles", "calculated_profiles",, "kind=management", ПараметрыПодключения);
	
	Если ИнвестПрофилиЕсиа = Неопределено Тогда
		Возврат;		
	КонецЕсли;
	
	ТаблицаИнвестПрофилей = Новый ТаблицаЗначений;
	ТаблицаИнвестПрофилей.Колонки.Добавить("id", Новый ОписаниеТипов("Число")); 
	ТаблицаИнвестПрофилей.Колонки.Добавить("score_from", Новый ОписаниеТипов("Число"));
	ТаблицаИнвестПрофилей.Колонки.Добавить("score_to", Новый ОписаниеТипов("Число"));
	
	Для Каждого ТекПрофиль Из ИнвестПрофилиЕсиа Цикл
		
		НоваяСтрока = ТаблицаИнвестПрофилей.Добавить();
		НоваяСтрока.id = ТекПрофиль["id"];
		НоваяСтрока.score_from = ТекПрофиль["score_from"];
		НоваяСтрока.score_to = ТекПрофиль["score_to"]; 
		
	КонецЦикла;

	Запрос = Новый Запрос;
	
#Область Текст_Запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаИнвестПрофилей.id КАК id,
		|	ТаблицаИнвестПрофилей.score_from КАК score_from,
		|	ТаблицаИнвестПрофилей.score_to КАК score_to
		|ПОМЕСТИТЬ _ИнвестПрофилиЕсиа
		|ИЗ
		|	&ТаблицаИнвестПрофилей КАК ТаблицаИнвестПрофилей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтратегииИндивидуальногоИнвестирования.Ссылка КАК Ссылка,
		|	СтратегииИндивидуальногоИнвестирования.Наименование КАК name,
		|	ВЫБОР
		|		КОГДА СтратегииИндивидуальногоИнвестирования.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
		|			ТОГДА ""with_iis""
		|		ИНАЧЕ ""without_iis""
		|	КОНЕЦ КАК use_on,
		|	СтратегииИндивидуальногоИнвестирования.ОсновнаяСтавкаВознагражденияУправляющего КАК managers_fee,
		|	ИнвеcтиционныеЦели.Цели КАК description,
		|	ИнвеcтиционныеЦели.ОжидаемаяДоходностьВПроцентах КАК estimated_profit,
		|	ИнвеcтиционныеЦели.ДопустимыйРискВПроцентах КАК market_risk,
		|	ИнвеcтиционныеЦели.Валюта.Наименование КАК currency,
		|	ИнвестиционныеПрофилиСрезПоследних.ВариантГоризонта КАК investment_horizon,
		|	_ИнвестПрофилиЕсиа.id КАК calculated_profile_id,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ИЗ
		|	Справочник.СтратегииИндивидуальногоИнвестирования КАК СтратегииИндивидуальногоИнвестирования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИнвестиционныеПрофили.СрезПоследних(&ДатаВыгрузки, Организация = &Организация) КАК ИнвестиционныеПрофилиСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИнвеcтиционныеЦели КАК ИнвеcтиционныеЦели
		|				ЛЕВОЕ СОЕДИНЕНИЕ _ИнвестПрофилиЕсиа КАК _ИнвестПрофилиЕсиа
		|				ПО ИнвеcтиционныеЦели.ОжидаемаяДоходностьВПроцентах > _ИнвестПрофилиЕсиа.score_from
		|					И ИнвеcтиционныеЦели.ОжидаемаяДоходностьВПроцентах <= _ИнвестПрофилиЕсиа.score_to
		|			ПО ИнвестиционныеПрофилиСрезПоследних.Цель = ИнвеcтиционныеЦели.Ссылка
		|		ПО СтратегииИндивидуальногоИнвестирования.Ссылка = ИнвестиционныеПрофилиСрезПоследних.СубъектУчета
		|			И (СтратегииИндивидуальногоИнвестирования.Ссылка = &МосковскийДоход)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&ДатаВыгрузки,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.СтратегииИндивидуальногоИнвестирования)) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО СтратегииИндивидуальногоИнвестирования.Ссылка = КодыВоВнешнихСистемахСрезПоследних.Объект
		|ГДЕ
		|	НЕ СтратегииИндивидуальногоИнвестирования.ПометкаУдаления
		|	И КодыВоВнешнихСистемахСрезПоследних.Объект ЕСТЬ NULL";
#КонецОбласти
	
    Запрос.УстановитьПараметр("МосковскийДоход", ОбщегоНазначения.ПолучитьИменованныйОбъект("Стратегия_МосковскийДоход"));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаВыгрузки", ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("ТаблицаИнвестПрофилей", ТаблицаИнвестПрофилей);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураЗапроса = Новый Структура();
		СтруктураЗапроса.Вставить("name", Выборка.name);
		СтруктураЗапроса.Вставить("calculated_profile_id", Выборка.calculated_profile_id);
		СтруктураЗапроса.Вставить("is_active", Истина);
		СтруктураЗапроса.Вставить("use_on", Выборка.use_on); //always - Всегда, without_iis - Без ИИС, with_iis - Для ИИС
		СтруктураЗапроса.Вставить("type_investor", "any"); //any - Любой, qualified - Квалифицированный, selected - Выбранный
		СтруктураЗапроса.Вставить("description", Выборка.description);
		СтруктураЗапроса.Вставить("estimated_profit", "до " + Строка(Выборка.estimated_profit) + "% годовых");
		СтруктураЗапроса.Вставить("market_risk", Строка(Выборка.market_risk) + "%");
		СтруктураЗапроса.Вставить("currency", НРег(Выборка.currency));
		СтруктураЗапроса.Вставить("investment_horizon", Строка(Выборка.investment_horizon));
		СтруктураЗапроса.Вставить("managers_fee", Строка(Выборка.managers_fee) + "%");
		
		//СтруктураЗапроса.Вставить("management_examples", ""); //пример управления
		//СтруктураЗапроса.Вставить("min_investment", ""); //Минимальная сумма инвестирования
		//СтруктураЗапроса.Вставить("priority", ""); //Приоритет стратегии
		
		ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("strategy", СтруктураЗапроса)); 
		
		ТекстСообщения = "Ошибка выгрузки данных стратегии [%1] в Есиа.Финанс.";
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office/strategies", ТелоЗапроса, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ЗафиксироватьСообщение(СтрШаблон(ТекстСообщения, Выборка.Ссылка));
			Продолжить;
		КонецЕсли; 
		
		ДанныеЕсиа = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
		
		ИдСтратегии = ДанныеЕсиа["id"]; 
		
		Если ДанныеЕсиа["success"] = Истина И ЗначениеЗаполнено(ИдСтратегии) Тогда			
			
			РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(
						Выборка.Ссылка,
						Справочники.ВнешниеСистемы.ЕсиаФинанс,
						Справочники.ГруппыИмпортируемыхОбъектов.СтратегииИндивидуальногоИнвестирования,
						Формат(ИдСтратегии, "ЧГ=0"));
						
		КонецЕсли;
	
	КонецЦикла;
		
КонецПроцедуры

Процедура ИмпортироватьАнкетыФизическихЛицВключитьОбменСЛККИВыгрузитьОстатки(Отказ = Ложь)
	
	// Сначала импортируем анкеты
	НовыеКодыАнкет = Новый Массив;
	НовыеКлиенты = Новый Массив;
	ИмпортироватьАнкеты(НовыеКодыАнкет);
	
	// Для физ. лиц с новыми кодами анкет в заявках на приобретение устанавливаем флаг обмена с ЛКК
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаявкаПайщика.Ссылка КАК Заявка,
		|	ЗаявкаПайщика.Пайщик КАК Пайщик
		|ИЗ
		|	Документ.ЗаявкаПайщика КАК ЗаявкаПайщика
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах КАК КодыВоВнешнихСистемах
		|		ПО (КодыВоВнешнихСистемах.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс))
		|			И (КодыВоВнешнихСистемах.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица))
		|			И ЗаявкаПайщика.Пайщик = КодыВоВнешнихСистемах.Объект
		|			И (КодыВоВнешнихСистемах.Код В (&КодыАнкет))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах КАК КодыВоВнешнихСистемахПИФ
		|		ПО (КодыВоВнешнихСистемахПИФ.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс))
		|			И (КодыВоВнешнихСистемахПИФ.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды))
		|			И ЗаявкаПайщика.ПаевойИнвестиционныйФонд = КодыВоВнешнихСистемахПИФ.Объект
		|			И (КодыВоВнешнихСистемахПИФ.Код В (&КодыПИФ))
		|ГДЕ
		|	ЗаявкаПайщика.Организация = &Организация
		|	И НЕ ЗаявкаПайщика.ПометкаУдаления
		|	И НЕ ЗаявкаПайщика.ВыгружатьОперацииВЕСИАФинанс
		|	И ЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Зачисление)");
	
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("КодыАнкет",		НовыеКодыАнкет);
	КодыПИФ = Новый Массив;
	КодыПИФ.Добавить("7");                                      
	
	Запрос.УстановитьПараметр("КодыПИФ",		КодыПИФ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
				
		ЗаявкаОбъект = Выборка.Заявка.ПолучитьОбъект();
		ЗаявкаОбъект.ВыгружатьОперацииВЕСИАФинанс = Истина;
		
		Попытка
			ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ЗафиксироватьСообщение(ОписаниеОшибки(), Истина, Отказ);			
			Прервать;
		КонецПопытки;
		
		НачатьТранзакцию();
		
		// Устанавливаем заявке статус Исполнена
		РегистрыСведений.СтатусыЗаявокПайщиков.УстановитьСтатусЗаявки(ЭтотОбъект.Организация, Выборка.Заявка, Перечисления.СтатусыЗаявокПайщиков.Исполнена, ЭтотОбъект.Дата, Отказ);
		
		Если Отказ Тогда
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			Прервать;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
		// Выгружаем заявку вместе с лицевым счетом и остатками паев
		ЭкспортироватьЗаявкуПайщика(Выборка.Заявка, Отказ, Ложь, Истина);
		
		Если Отказ Тогда			
			Прервать;
		КонецЕсли;
		
		Если НовыеКлиенты.Найти(Выборка.Пайщик) = Неопределено Тогда
			НовыеКлиенты.Добавить(Выборка.Пайщик);
		КонецЕсли;
					
	КонецЦикла;
	
	Если НовыеКлиенты.Количество() > 0 Тогда
		ВыгрузитьДанныеВПервуюФормуКоллЦентра(НовыеКлиенты);	
	КонецЕсли;
		
КонецПроцедуры

Процедура УстановитьСтатусИсполненаУЗаявокНаИзменениеПерсональныхДанныхИЗапуститьПроверки(Отказ = Ложь)

	// Получаем заявки на изменение персональных данных со статусом Новая, устанавливаем статус Исполнена
	ПараметрыПодключения = ПолучитьПараметрыПодключения();

	Фильтр = "filter%5Bkind%5D=person_info_change&filter%5Bstatus%5D=in_queue"; //&filter%5Bcreated_at%5D%5Bgt%5D=" + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy")
	
	МассивЗаявок = ПолучитьДанныеЕсиа("claims", "claims",, Фильтр, ПараметрыПодключения);	
	
	Если ЗначениеЗаполнено(МассивЗаявок) Тогда
		
		ТекстСообщения = "Ошибка установки статуса 'Исполнена' для заявки на изменение персональных данных с id %1";
	
		ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("status", "done"));
		
		МассивПользователейДляПроверки = Новый Массив;
		
		Для Каждого ТекЗаявка Из МассивЗаявок Цикл
			
			Если Не ЗначениеЗаполнено(ТекЗаявка["id"]) Тогда
				ЗафиксироватьСообщение(ТекстСообщения,, Отказ);
				Возврат;
			КонецЕсли;
						
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("PATCH", ПараметрыПодключения, "/api/v1/back_office/claims/" + ТекЗаявка["id"], ТелоЗапроса, СтрШаблон(ТекстСообщения, ТекЗаявка.id));

			Если HTTPОтвет = Неопределено Тогда
				ЗафиксироватьСообщение(ТекстСообщения,, Отказ);
			Иначе
				МассивПользователейДляПроверки.Добавить(ТекЗаявка["user_id"]);
			КонецЕсли;
					
		КонецЦикла;
		
		Если МассивПользователейДляПроверки.Количество() > 0 Тогда
			
			ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("users_ids", МассивПользователейДляПроверки));
			
			ТекстСообщения = "Ошибка запуска проверок по пользователям с id " + СтрСоединить(МассивПользователейДляПроверки, ",");
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office/checks/run", ТелоЗапроса, ТекстСообщения);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Прочие_процедуры_и_функции

Процедура ЗагрузитьФайлыВХранилище(Родитель, МассивФайлов, СверитьФайлы = Ложь, Отказ = Ложь)
	
	Если СверитьФайлы Тогда
		
		РанееЗагруженныеДанные = РаботаСФайловымХранилищем.ПолучитьСписокФайлов(Родитель);
		
		Для Каждого ЭлементДанных Из РанееЗагруженныеДанные Цикл
			
			РанееЗагруженныйФайл = РаботаСФайловымХранилищем.ПолучитьФайл(ЭлементДанных.ИдентификаторФайла); 
			
			Для Инд = 0 По МассивФайлов.Количество() - 1 Цикл
				
				НовыйФайл = МассивФайлов[Инд];
				
				Если НовыйФайл.ПолноеИмя = РанееЗагруженныйФайл.Имя + "." + РанееЗагруженныйФайл.Расширение 
					И ПолучитьИзВременногоХранилища(НовыйФайл.Хранение) = ПолучитьИзВременногоХранилища(РанееЗагруженныйФайл.Адрес) Тогда
					
					МассивФайлов.Удалить(Инд);
					Прервать;
				КонецЕсли;
					
			КонецЦикла;
				
		КонецЦикла;
			
	КонецЕсли;
	
	//## Что делать если в 1С есть файлы которых нет в Есиа.Финанс ?????	
	Если МассивФайлов.Количество() > 0 Тогда 
		
		ДанныеВерсий = Обработки.РаботаСФайлами.ПрисоединитьФайл(Родитель, МассивФайлов);
		
		Если ДанныеВерсий.Количество() = 0 Тогда
			
			ЗафиксироватьСообщение("Не удалось загрузить файлы к объекту [" + СокрЛП(Родитель) + "]", Истина, Отказ);
			
		Иначе
			
			Для Каждого ЗаписьВерсии Из ДанныеВерсий Цикл
				
				Если ЗаписьВерсии.Свойство("ТекстОшибки") Тогда
					ЗафиксироватьСообщение(ЗаписьВерсии.ТекстОшибки);
				Иначе                                                                         
					
					ЗафиксироватьСообщение("К объекту [" + Родитель + " / " + ТипЗнч(Родитель) + "] загружен файл [" + ЗаписьВерсии.ПолноеИмя + "]", Ложь);
					
				КонецЕсли; 
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли; 
		
КонецПроцедуры

Функция ПрочитатьАдресФИАС(ДанныеЕсиа)
	
	ИменаПолейАдреса = Новый Соответствие;
	ИменаПолейАдреса.Вставить("Страна", "country");
	ИменаПолейАдреса.Вставить("Индекс", "index");
	ИменаПолейАдреса.Вставить("Регион", "region");
	ИменаПолейАдреса.Вставить("Район", "district");
	ИменаПолейАдреса.Вставить("НаселенныйПункт", "city");
	ИменаПолейАдреса.Вставить("Улица", "street");
	ИменаПолейАдреса.Вставить("Дом", "house");
	ИменаПолейАдреса.Вставить("Корпус", "corps");
	ИменаПолейАдреса.Вставить("Квартира", "flat");
	
	Страна = ДанныеЕсиа[ИменаПолейАдреса["Страна"]];
	Индекс = ДанныеЕсиа[ИменаПолейАдреса["Индекс"]];
	Регион = ДанныеЕсиа[ИменаПолейАдреса["Регион"]];
	Район  = ДанныеЕсиа[ИменаПолейАдреса["Район"]];
	Город  = ДанныеЕсиа[ИменаПолейАдреса["НаселенныйПункт"]];
	Улица  = ДанныеЕсиа[ИменаПолейАдреса["Улица"]];
	
	Дом    = ДанныеЕсиа[ИменаПолейАдреса["Дом"]];
	
	Дом = СтрЗаменить(Дом, "дом", "");
	Дом = СтрЗаменить(Дом, "д.", "");
	Дом = СокрЛП(СтрЗаменить(Дом, "д", ""));
	
	Корпус   = ДанныеЕсиа[ИменаПолейАдреса["Корпус"]];
	Квартира = ДанныеЕсиа[ИменаПолейАдреса["Квартира"]];
	
	КодРегиона = "";
	Если ЗначениеЗаполнено(ДанныеЕсиа["kladr_ids"]) Тогда
		КодРегиона = Лев(ДанныеЕсиа["kladr_ids"]["region"], 2);
	КонецЕсли;
	
	ПредставлениеАдреса = "";
	ДополнитьПредставлениеАдреса(Страна, ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(Индекс, ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(Регион, ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(Район,  ", ", ПредставлениеАдреса, Истина);
	ДополнитьПредставлениеАдреса(Город,  ", ", ПредставлениеАдреса, Истина);
	
	ДополнитьПредставлениеАдреса(Улица,    ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(?(ПустаяСтрока(Дом), "", "дом " + Дом),           ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(?(ПустаяСтрока(Корпус), "", "корп. " + Корпус),   ", ", ПредставлениеАдреса);
	ДополнитьПредставлениеАдреса(?(ПустаяСтрока(Квартира), "", "кв. " + Квартира), ", ", ПредставлениеАдреса);
	
	ПространствоИмен = "http://www.v8.1c.ru/ssl/contactinfo";
	
	РезультатXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(ПространствоИмен, "КонтактнаяИнформация"));
	РезультатXDTO.Состав = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(ПространствоИмен, "Адрес"));
	РезультатXDTO.Представление = ПредставлениеАдреса;
	
	Адрес = РезультатXDTO.Состав;
		
	Если ЗначениеЗаполнено(Страна) И Страна <> "Российская Федерация" Тогда
		
		Адрес.Страна = Страна;
		Адрес.Состав = ПредставлениеАдреса;
		
	Иначе
		
		Адрес.Страна = "РОССИЯ";
		АдресРФ = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(ПространствоИмен, "АдресРФ"));
		
		Если ЗначениеЗаполнено(Индекс) Тогда
			ЭлементИндекс = СоздатьДопАдрЭлемента(АдресРФ);
			ЭлементИндекс.ТипАдрЭл = "10100000";
			ЭлементИндекс.Значение = Индекс;
		КонецЕсли;
		
		Если Не ПустаяСтрока(КодРегиона) Тогда
			АдресРФ.КодСубъектаРФ = КодРегиона;
			АдресРФ.СубъектРФ = Обработки.ВводКонтактнойИнформации.СубъектРФПоКодуСубъекта(КодРегиона);
		ИначеЕсли Не ПустаяСтрока(Регион) Тогда
			Субъект = Обработки.ВводКонтактнойИнформации.СубъектРФПоНаименованию(Регион);
			АдресРФ.КодСубъектаРФ	= Субъект.КодСубъекта;
			АдресРФ.СубъектРФ		= Субъект.Субъект;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Район) Тогда
			АдресРФ.СвРайМО = ФабрикаXDTO.Создать(АдресРФ.Тип().Свойства.Получить("СвРайМО").Тип);
			АдресРФ.СвРайМО.Район = Район;
		КонецЕсли;
		
		Если ДанныеЕсиа["is_federal_city"] <> Истина И ЗначениеЗаполнено(Город) Тогда
			АдресРФ.Город = Город;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Улица) Тогда
			АдресРФ.Улица = Улица;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Дом) Тогда
			ЭлементДом = СоздатьНомерДопАдрЭлемента(АдресРФ);
			ЭлементДом.Тип = "1010";
			ЭлементДом.Значение = Дом;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Корпус) Тогда
			ЭлементКорпус = СоздатьНомерДопАдрЭлемента(АдресРФ);
			ЭлементКорпус.Тип = "1050";
			ЭлементКорпус.Значение = Корпус;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Квартира) Тогда
			ЭлементКвартира = СоздатьНомерДопАдрЭлемента(АдресРФ);
			ЭлементКвартира.Тип = "2010";
			ЭлементКвартира.Значение = Квартира;
		КонецЕсли;
		
		Адрес.Состав = АдресРФ;
	КонецЕсли;
	
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиXML(, , Ложь, Ложь, ""));
	
	ФабрикаXDTO.ЗаписатьXML(Запись, РезультатXDTO);
	
	РезультатXDTO = СтрЗаменить(Запись.Закрыть(), Символы.ПС, "&#10;");
	
	Возврат РезультатXDTO;
	
КонецФункции

Процедура ДополнитьПредставлениеАдреса(Дополнение, СтрокаКонкатенации, Представление, ПропускатьНайденныйТекст = Ложь)
	
	Если ПропускатьНайденныйТекст и СтрНайти(Представление, СтрокаКонкатенации + Дополнение) Тогда
		Возврат;
	КонецЕсли;
	
	Если Дополнение <> "" Тогда
		Представление = Представление + ?(ПустаяСтрока(Представление), "", СтрокаКонкатенации) + Дополнение;
	КонецЕсли;
	
КонецПроцедуры 

Функция СоздатьНомерДопАдрЭлемента(АдресРФ) Экспорт 
	ДопАдрЭл = СоздатьДопАдрЭлемента(АдресРФ);
	ДопАдрЭл.Номер = ФабрикаXDTO.Создать(ДопАдрЭл.Тип().Свойства.Получить("Номер").Тип);
	Возврат ДопАдрЭл.Номер;
КонецФункции

Функция СоздатьДопАдрЭлемента(АдресРФ) Экспорт
	СвойствоДопАдрЭлемента = АдресРФ.ДопАдрЭл.ВладеющееСвойство;
	ДопАдрЭлемента = ФабрикаXDTO.Создать(СвойствоДопАдрЭлемента.Тип);
	АдресРФ.ДопАдрЭл.Добавить(ДопАдрЭлемента);
	Возврат ДопАдрЭлемента;
КонецФункции

Процедура ДобавитьЗначениеПараметра(ТекЗапись, Разделитель, ОписаниеПараметра, ЗначениеПараметра)
	
	ТекЗапись.ЗаписатьСтроку("--" + Разделитель);
	ТекЗапись.ЗаписатьСтроку("Content-Disposition: form-data; name=" + ОписаниеПараметра);
	ТекЗапись.ЗаписатьСтроку("");
	
	Если ТипЗнч(ЗначениеПараметра) = Тип("Строка") Тогда
		ТекЗапись.ЗаписатьСтроку(ЗначениеПараметра);	
	ИначеЕсли ТипЗнч(ЗначениеПараметра) = Тип("ДвоичныеДанные") Тогда
		ТекЗапись.Записать(ЗначениеПараметра);			
	КонецЕсли;
	
КонецПроцедуры

Функция ДесериализоватьДанныеПользователейЕсиа(ТаблицаАнкет, ПараметрыПодключения)
	
	ПользователиЕсиа = СформироватьТаблицуПриемник("ПользователиЕсиа");
									
	Для Каждого ТекЗапись Из ТаблицаАнкет Цикл
		
		СтрокаТаблицыПользователей = ПользователиЕсиа.Найти(ТекЗапись.ИдентификаторПользователя, "Идентификатор"); 
		
		Если СтрокаТаблицыПользователей <> Неопределено Тогда  //если у пользователя несколько заявок
			Продолжить;	
		КонецЕсли;
				
		//получаем данные пользователя по идентификатору
		ДанныеПользователяЕсиа = ПолучитьДанныеЕсиа("users", "user", ТекЗапись.ИдентификаторПользователя,, ПараметрыПодключения);
			
		Если ДанныеПользователяЕсиа = Неопределено Тогда
			Продолжить;
		КонецЕсли;
									
		ЗначенияРеквизитовАнкеты = ПолучитьЗначенияРеквизитовАнкетыПользователя(ДанныеПользователяЕсиа, ПараметрыПодключения, ТекЗапись);
		
		Если ЗначенияРеквизитовАнкеты = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		//проверяем дату актульности анкетных данных
		Если ЗначениеЗаполнено(ТекЗапись.ДатаАнкетныхДанных) И ЗначенияРеквизитовАнкеты.ДанныеДляОпределенияСсылок.ДатаАктуальности <= ТекЗапись.ДатаАнкетныхДанных Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяЗапись = ПользователиЕсиа.Добавить();
		НоваяЗапись.Ссылка = ТекЗапись.Ссылка;
		НоваяЗапись.ЕстьКодЕсиа = ЗначениеЗаполнено(ТекЗапись.Ссылка);	
		НоваяЗапись.АнкетаСсылка = ТекЗапись.АнкетаСсылка;
		НоваяЗапись.Идентификатор = ДанныеПользователяЕсиа["id"]; 
		НоваяЗапись.ЗаписатьКодПайщика = (Строка(ДанныеПользователяЕсиа["id"]) <> ДанныеПользователяЕсиа["pifs_portfolio_code"]);
		НоваяЗапись.АнкетныеДанные = ЗначенияРеквизитовАнкеты.АнкетныеДанные; 
		
		ЗаполнитьЗначенияСвойств(НоваяЗапись, ЗначенияРеквизитовАнкеты.ДанныеДляОпределенияСсылок); 
																								
	КонецЦикла;
	
	Возврат ПользователиЕсиа;
     	
КонецФункции 

Функция ДесериализоватьДанныеБанковскихСчетовЕсиа(ДанныеПользователей, ПараметрыПодключения) 
	
	ТаблицаБанковскихСчетов = СформироватьТаблицуПриемник("БанковскиеСчета");
	
	Для Каждого ТекПользователь Из ДанныеПользователей Цикл 
		
		МассивДанныхЕсиа = ПолучитьДанныеЕсиа("requisites", "requisites",, "requisite_owner_type=User&requisite_owner_id=" + ТекПользователь.Идентификатор, ПараметрыПодключения);
		
		Если МассивДанныхЕсиа = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ТекСчет Из МассивДанныхЕсиа Цикл 
			
			НомерСчета = ТекСчет["payment_account"];
			
			Если ЗначениеЗаполнено(НомерСчета) Тогда
				
				СтрокиТаблицыСчетов = ТаблицаБанковскихСчетов.НайтиСтроки(Новый Структура("ИдентификаторПользователя, НомерСчета", ТекПользователь.Идентификатор, НомерСчета));
			
				Если СтрокиТаблицыСчетов.Количество() = 0 Тогда 
					
					НовыйСчет = ТаблицаБанковскихСчетов.Добавить();
					ПолучитьЗначенияБанковскихРеквизитов(НовыйСчет, ТекСчет);
					
				КонецЕсли;
	
			КонецЕсли;
						
		КонецЦикла;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область Текст_Запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДанныеПользователей.Идентификатор КАК Идентификатор,
		|	ДанныеПользователей.Ссылка КАК Ссылка,
		|	ДанныеПользователей.АнкетаСсылка КАК АнкетаСсылка
		|ПОМЕСТИТЬ _ДанныеПользователей
		|ИЗ
		|	&ДанныеПользователей КАК ДанныеПользователей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеПользователей.Идентификатор КАК Идентификатор,
		|	КодыАнкетВоВнешнихСистемахСрезПоследних.Объект КАК АнкетаСсылка,
		|	ВЫРАЗИТЬ(КодыАнкетВоВнешнихСистемахСрезПоследних.Объект КАК Документ.АнкетаФизическогоЛица).ЮрФизЛицо КАК ЮрФизЛицо
		|ПОМЕСТИТЬ _АнкетыИзКодовВоВнешнихСистемах
		|ИЗ
		|	_ДанныеПользователей КАК _ДанныеПользователей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.АнкетыФизическихЛиц)) КАК КодыАнкетВоВнешнихСистемахСрезПоследних
		|		ПО _ДанныеПользователей.Идентификатор = КодыАнкетВоВнешнихСистемахСрезПоследних.Код
		|			И (_ДанныеПользователей.АнкетаСсылка = ЗНАЧЕНИЕ(Документ.АнкетаФизическогоЛица.ПустаяСсылка))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаБанковскихСчетов.Идентификатор КАК Идентификатор,
		|	ТаблицаБанковскихСчетов.ИдентификаторПользователя КАК ИдентификаторПользователя,
		|	ТаблицаБанковскихСчетов.Бик КАК Бик,
		|	ТаблицаБанковскихСчетов.КоррСчет КАК КоррСчет,
		|	ТаблицаБанковскихСчетов.НомерСчета КАК НомерСчета,
		|	ТаблицаБанковскихСчетов.ПолучательПлатежа КАК ПолучательПлатежа,
		|	ТаблицаБанковскихСчетов.ИННПолучателя КАК ИННПолучателя,
		|	ТаблицаБанковскихСчетов.НазначениеПлатежа КАК НазначениеПлатежа,
		|	ТаблицаБанковскихСчетов.НаименованиеБанка КАК НаименованиеБанка
		|ПОМЕСТИТЬ _БанковскиеСчетаЕсиа
		|ИЗ
		|	&ТаблицаБанковскихСчетов КАК ТаблицаБанковскихСчетов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.) КАК Ссылка,
		|	ЕСТЬNULL(_ДанныеПользователей.АнкетаСсылка, _АнкетыИзКодовВоВнешнихСистемах.АнкетаСсылка) КАК Анкета,
		|	ЕСТЬNULL(_ДанныеПользователей.Ссылка, _АнкетыИзКодовВоВнешнихСистемах.ЮрФизЛицо) КАК ЮрФизЛицо,
		|	_БанковскиеСчетаЕсиа.Идентификатор КАК Идентификатор,
		|	_БанковскиеСчетаЕсиа.ИдентификаторПользователя КАК ИдентификаторПользователя,
		|	_БанковскиеСчетаЕсиа.Бик КАК Бик,
		|	_БанковскиеСчетаЕсиа.КоррСчет КАК КоррСчет,
		|	_БанковскиеСчетаЕсиа.НомерСчета КАК НомерСчета,
		|	_БанковскиеСчетаЕсиа.ПолучательПлатежа КАК ПолучательПлатежа,
		|	_БанковскиеСчетаЕсиа.ИННПолучателя КАК ИННПолучателя,
		|	_БанковскиеСчетаЕсиа.НазначениеПлатежа КАК НазначениеПлатежа,
		|	_БанковскиеСчетаЕсиа.НаименованиеБанка КАК НаименованиеБанка
		|ПОМЕСТИТЬ _ДанныеБанковскихСчетов
		|ИЗ
		|	_БанковскиеСчетаЕсиа КАК _БанковскиеСчетаЕсиа
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеПользователей КАК _ДанныеПользователей
		|		ПО _БанковскиеСчетаЕсиа.ИдентификаторПользователя = _ДанныеПользователей.Идентификатор
		|			И (_ДанныеПользователей.АнкетаСсылка <> ЗНАЧЕНИЕ(Документ.АнкетаФизическогоЛица.ПустаяСсылка))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _АнкетыИзКодовВоВнешнихСистемах КАК _АнкетыИзКодовВоВнешнихСистемах
		|		ПО _БанковскиеСчетаЕсиа.ИдентификаторПользователя = _АнкетыИзКодовВоВнешнихСистемах.Идентификатор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеБанковскихСчетов.Анкета КАК Анкета,
		|	_ДанныеБанковскихСчетов.Идентификатор КАК Идентификатор
		|ИЗ
		|	_ДанныеБанковскихСчетов КАК _ДанныеБанковскихСчетов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АнкетаФизическогоЛица.БанковскиеРеквизиты КАК БанковскиеРеквизитыАнкеты
		|		ПО _ДанныеБанковскихСчетов.Анкета = БанковскиеРеквизитыАнкеты.Ссылка
		|			И _ДанныеБанковскихСчетов.Бик = БанковскиеРеквизитыАнкеты.БИК
		|			И _ДанныеБанковскихСчетов.НомерСчета = БанковскиеРеквизитыАнкеты.НомерСчета
		|			И _ДанныеБанковскихСчетов.КоррСчет = БанковскиеРеквизитыАнкеты.КоррСчет
		|ГДЕ
		|	БанковскиеРеквизитыАнкеты.НомерСчета ЕСТЬ NULL
		|ИТОГИ ПО
		|	Анкета";
#КонецОбласти
	
	Запрос.УстановитьПараметр("ДанныеПользователей", ДанныеПользователей);
	Запрос.УстановитьПараметр("ТаблицаБанковскихСчетов", ТаблицаБанковскихСчетов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ДанныеБанковскихСчетов = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДанныеБанковскихСчетов"].ПолучитьДанные().Выгрузить();
	
	Отказ = Ложь;
	
	Для Каждого СтрокаДанных Из ДанныеБанковскихСчетов Цикл
		
		ПроверитьЗаписатьБанковскийСчет(СтрокаДанных, Отказ);
		
		Если Отказ Тогда
			ЗафиксироватьСообщение(СтрШаблон("Ошибка загрузки расчетного счета [%1] пользователя [%2]", СтрокаДанных.НомерСчета, СтрокаДанных.ЮрФизЛицо));
		КонецЕсли;
		
	КонецЦикла;
	
	ГруппировкаПоАнкетам = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	
	Пока ГруппировкаПоАнкетам.Следующий() Цикл
		
		Выборка = ГруппировкаПоАнкетам.Выбрать();
		
		АнкетаОбъект = ГруппировкаПоАнкетам.Анкета.ПолучитьОбъект();
		
		ЕстьИзменения = Ложь;
	
		Пока Выборка.Следующий() Цикл
			
			МассивСтрок = ДанныеБанковскихСчетов.НайтиСтроки(Новый Структура("Идентификатор", Выборка.Идентификатор));
			
			Для Каждого СтрокаТаблицыБанковскихСчетов Из МассивСтрок Цикл
				
				Если ЗначениеЗаполнено(СтрокаТаблицыБанковскихСчетов.Ссылка) Тогда
			
					СтрокаАнкетыБанковскихРеквизитов = АнкетаОбъект.БанковскиеРеквизиты.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаАнкетыБанковскихРеквизитов, СтрокаТаблицыБанковскихСчетов);
					СтрокаАнкетыБанковскихРеквизитов.РасчетныйСчет = СтрокаТаблицыБанковскихСчетов.Ссылка;
					
					ЕстьИзменения = Истина;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
		Если ЕстьИзменения Тогда
			
			Попытка
				АнкетаОбъект.Записать(РежимЗаписиДокумента.Проведение); 
			Исключение
				ЗафиксироватьСообщение(СтрШаблон("Ошибка записи анкеты [%1] после добавления новых расчетных счетов", ГруппировкаПоАнкетам.Анкета));
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДанныеБанковскихСчетов;
	
КонецФункции 

