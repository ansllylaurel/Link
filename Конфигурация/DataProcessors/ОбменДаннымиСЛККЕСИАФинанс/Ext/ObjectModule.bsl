
#Область Интерфейс_для_регламентных_заданий

Процедура ВыполнитьМетод(Метод, Экземпляры) Экспорт
     
	Если Метод = "ЭкспортироватьСписокДляСверки" Тогда
		ЭкспортироватьСписокДляСверки(Экземпляры);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	ЭтотОбъект.Дата = ТекущаяДатаСеанса();
	
	Если ПараметрыКоманды.Свойство("ЗаПредыдущийДень") И ПараметрыКоманды.ЗаПредыдущийДень Тогда
		ЭтотОбъект.Дата = ЭтотОбъект.Дата - 24 * 24 * 60;
	КонецЕсли;;
		
	ЭтотОбъект.Организация	= ПараметрыКоманды.Организация;
			
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.Организация) Тогда 
		
		ЗафиксироватьСообщение("Не указан параметр [Организация]. Команда импорта заявок пайщиков из системы ЕСИА.Финанс отклонена.");
		
	ИначеЕсли ИдентификаторКоманды = "ИмпортЗаявокПайщиковИзЛКК" Тогда
		
		ИмпортироватьЗаявкиПайщиков();
		
	ИначеЕсли ИдентификаторКоманды = "УстановкаСтатусаИсполненаУЗаявокНаИзменениеПерсональныхДанныхИЗапускПроверок" Тогда
		
		УстановитьСтатусИсполненаУЗаявокНаИзменениеПерсональныхДанныхИЗапуститьПроверки()
		
	ИначеЕсли ИдентификаторКоманды = "ИмпортАнкетФизическихЛицВключениеОбменаСЛККИВыгрузкаОстатков"	Тогда
		
		ИмпортироватьАнкетыФизическихЛицВключитьОбменСЛККИВыгрузитьОстатки();
		
	Иначе
		ЗафиксироватьСообщение("Для команды [" + ИдентификаторКоманды + "] не определены действия.");	
	КонецЕсли;
		
	ОповеститьОбОшибках();
	
КонецПроцедуры

#КонецОбласти

#Область Обмен_данными

Процедура ЭкспортироватьСписокДляСверки(Экземпляры)
	
	Идентификатор	= Экземпляры[0].Идентификатор;
	Параметры		= Экземпляры[0].Параметры;
	
	ЭтотОбъект.Организация	= Параметры.Организация;
	ВидСписка				= Параметры.ВидСписка;		
	ПутьКФайлу				= Параметры.ПутьКФайлу;
		
	Отказ = Ложь;
	ВидСпискаСтрокой = ""; 
	
	Если ВидСписка = Справочники.ВидыПеречнейОбъектов.СписокТеррористов Тогда
		ВидСпискаСтрокой = "possible_terrorists";
	ИначеЕсли ВидСписка = Справочники.ВидыПеречнейОбъектов.СписокОтказников Тогда
		ВидСпискаСтрокой = "operation_cancels";
	ИначеЕсли ВидСписка = Справочники.ВидыПеречнейОбъектов.СводныйПереченьСоветаБезопасностиООН Тогда
		ВидСпискаСтрокой = "uns";
	ИначеЕсли ВидСписка = Справочники.ВидыПеречнейОбъектов.СписокРешенийМВК Тогда
		ВидСпискаСтрокой = "frozen_assets";		
	Иначе
		ВызватьИсключение "Недопустимый вид перечня для выгрузки в ЛКК (" + СокрЛП(ВидСписка) +")";		
	КонецЕсли;
			
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПутьКФайлу));
	
	ЭкспортСпискаДляПроверки(ВидСпискаСтрокой, АдресВоВременномХранилище, ПутьКФайлу, Отказ);
		
	РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(Идентификатор, Отказ);
	
	ОповеститьОбОшибках();
	 
КонецПроцедуры

Процедура ВыгрузитьСтоимостьПаев(ЦенаПая, СЧА, Отказ = Ложь) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК КодПифа
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды)
		|				И Объект = &Пиф) КАК КодыВоВнешнихСистемахСрезПоследних";
	Запрос.УстановитьПараметр("Пиф", ЭтотОбъект.Пиф);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ПараметрыПодключения = ПолучитьПараметрыПодключения(); 
		
		СтруктураЗапроса = Новый Структура();
		СтруктураЗапроса.Вставить("fund_code", Формат(Выборка.КодПифа, "ЧГ=0"));	
		СтруктураЗапроса.Вставить("date", Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy"));
		СтруктураЗапроса.Вставить("value", ЦенаПая);
		СтруктураЗапроса.Вставить("scha_value", СЧА);
		
		СтруктураЗапроса = Новый Структура("data", РаботаСКоллекциями.ЗначениеВМассив(СтруктураЗапроса));
		
		ТекТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
				
		ТекстСообщения = "Не удалось выполнить запрос.";
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office/portfolio/import?import_type=fund_values", ТекТелоЗапроса, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ЗафиксироватьСообщение(ТекстСообщения);
			Отказ = Истина;
		Иначе
			ЗафиксироватьСообщение("На дату [" + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy") + "] выгружена сумма СЧА [" + СЧА + "] и стоимость пая [" + ЦенаПая + "] пифа [" + ЭтотОбъект.Пиф + "]", Ложь);	
		КонецЕсли;
	
	КонецЕсли;

КонецПроцедуры

Процедура ЭкспортироватьЗаявкуПайщика(ЗаявкаПайщика, Отказ = Ложь, ПерезаписатьВЛКК = Ложь, ВыгружатьОстатки = Ложь) Экспорт

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	#Область Текст_запроса
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокументЗаявкаПайщика.ВерсияДанных КАК ВерсияДанных,
		|	ДокументЗаявкаПайщика.ПометкаУдаления КАК ПометкаУдаления,
		|	ДокументЗаявкаПайщика.Дата КАК created_at,
		|	ДокументЗаявкаПайщика.Организация КАК Организация,
		|	ДокументЗаявкаПайщика.ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд,
		|	ВЫБОР
		|		КОГДА ДокументЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Зачисление)
		|			ТОГДА ""pifs_purchase""
		|		КОГДА ДокументЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Погашение)
		|			ТОГДА ""pifs_selling""
		|		ИНАЧЕ ""pifs_exchange""
		|	КОНЕЦ КАК kind,
		|	ВЫБОР
		|		КОГДА СтатусыЗаявокПайщиковСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаявокПайщиков.Новая)
		|			ТОГДА ""in_queue""
		|		КОГДА СтатусыЗаявокПайщиковСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаявокПайщиков.ВРаботе)
		|			ТОГДА ""in_process""
		|		КОГДА СтатусыЗаявокПайщиковСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаявокПайщиков.Исполнена)
		|			ТОГДА ""done""
		|	КОНЕЦ КАК status,
		|	СОКРЛП(ДокументЗаявкаПайщика.НомерЗаявки) КАК inner_code,
		|	ДокументЗаявкаПайщика.ИсточникЗаявки КАК ИсточникЗаявки,
		|	ДокументЗаявкаПайщика.Агент КАК Агент,
		|	ДокументЗаявкаПайщика.Пайщик КАК Пайщик,
		|	ДокументЗаявкаПайщика.ВидПайщика КАК ВидПайщика,
		|	ДокументЗаявкаПайщика.НоминальныеДержатели КАК НоминальныеДержатели,
		|	ДокументЗаявкаПайщика.Владелец КАК Владелец,
		|	ДокументЗаявкаПайщика.НомерСчетаДепоВладельца КАК НомерСчетаДепоВладельца,
		|	ДокументЗаявкаПайщика.КоличествоНаСчетеДепоВладельца КАК КоличествоНаСчетеДепоВладельца,
		|	ДокументЗаявкаПайщика.ОткрытьЗакрытьДепозитарныйСчет КАК is_with_open,
		|	ВЫБОР
		|		КОГДА ДокументЗаявкаПайщика.ОткрытьЗакрытьДепозитарныйСчет
		|			ТОГДА """"
		|		ИНАЧЕ ДокументЗаявкаПайщика.ДепозитарныйСчет.НомерСчета
		|	КОНЕЦ КАК account_number,
		|	ДокументЗаявкаПайщика.РасчетныйСчет КАК РасчетныйСчет,
		|	ДокументЗаявкаПайщика.БИК КАК БИК,
		|	ДокументЗаявкаПайщика.НаименованиеБанка КАК НаименованиеБанка,
		|	ДокументЗаявкаПайщика.КоррСчет КАК КоррСчет,
		|	ДокументЗаявкаПайщика.НомерСчета КАК НомерСчета,
		|	ДокументЗаявкаПайщика.ЛицевойСчет КАК ЛицевойСчет,
		|	ДокументЗаявкаПайщика.ПолучательПлатежа КАК ПолучательПлатежа,
		|	ДокументЗаявкаПайщика.ИННПолучателя КАК ИННПолучателя,
		|	ДокументЗаявкаПайщика.НазначениеПлатежа КАК НазначениеПлатежа,
		|	ДокументЗаявкаПайщика.СозданДокументом КАК СозданДокументом,
		|	ДокументЗаявкаПайщика.СобственностьНаПаи КАК СобственностьНаПаи,
		|	ДокументЗаявкаПайщика.Многократная КАК Многократная,
		|	ДокументЗаявкаПайщика.Сумма КАК Сумма,
		|	ДокументЗаявкаПайщика.Количество КАК count,
		|	ДокументЗаявкаПайщика.Ответственный КАК Ответственный,
		|	ДокументЗаявкаПайщика.Комментарий КАК Комментарий,
		|	ДокументЗаявкаПайщика.ПЭП_НомерТелефона КАК ПЭП_НомерТелефона,
		|	ДокументЗаявкаПайщика.ПЭП_Код КАК ПЭП_Код,
		|	ДокументЗаявкаПайщика.ПЭП_ДатаВремяПодписи КАК ПЭП_ДатаВремяПодписи,
		|	ДокументЗаявкаПайщика.ПаевойИнвестиционныйФондДляОбменаПаев КАК ПаевойИнвестиционныйФондДляОбменаПаев,
		|	ВЫБОР
		|		КОГДА ДокументЗаявкаПайщика.ОткрытьДепозитарныйСчетВПаевомИнвестиционномФондеДляОбмена
		|			ТОГДА """"
		|		ИНАЧЕ ДокументЗаявкаПайщика.ДепозитарныйСчетВПаевомИнвестиционномФондеДляОбмена.НомерСчета
		|	КОНЕЦ КАК account_number_to,
		|	ДокументЗаявкаПайщика.ОткрытьДепозитарныйСчетВПаевомИнвестиционномФондеДляОбмена КАК ОткрытьДепозитарныйСчетВПаевомИнвестиционномФондеДляОбмена,
		|	ДокументЗаявкаПайщика.ФИОАгента КАК ФИОАгента,
		|	ДокументЗаявкаПайщика.ДолжностьАгента КАК ДолжностьАгента,
		|	ДокументЗаявкаПайщика.ЗаявкаНаОбмен КАК ЗаявкаНаОбмен,
		|	ЕСТЬNULL(СтатусыЗаявокПайщиковСрезПоследних.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыЗаявокПайщиков.Отклонена)) = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаявокПайщиков.Отклонена) КАК ЗаявкаБезАктивногоСтатуса,
		|	ЕСТЬNULL(КодыПИФов.Код, """") = """" КАК ОтсутствуетКодПИФа,
		|	ЕСТЬNULL(КодыПИФовДляОбмена.Код, """") = """" КАК ОтсутствуетКодПИФаДляОбмена,
		|	ЕСТЬNULL(КодыПайщиков.Код, """") = """" КАК ОтсутствуетКодПайщика,
		|	КодыЗаявок.Код ЕСТЬ НЕ NULL  КАК ПрисвоенКодЗаявки,
		|	""Fund"" КАК owner_type,
		|	ЕСТЬNULL(КодыПИФов.Код, """") КАК owner_id,
		|	ЕСТЬNULL(КодыПИФовДляОбмена.Код, """") КАК fund_to_id,
		|	ЕСТЬNULL(КодыПайщиков.Код, """") КАК user_id,
		|	КодыЗаявок.Код КАК КодЗаявки,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Регистратор КАК Анкета,
		|	ЕСТЬNULL(КодыАнкет.Код, """") КАК КодАнкеты,
		|	ЕСТЬNULL(КодыСчетов.Код, """") КАК КодСчета,
		|	ДокументЗаявкаПайщика.ДепозитарныйСчетВПаевомИнвестиционномФондеДляОбмена КАК ДепозитарныйСчетВПаевомИнвестиционномФондеДляОбмена,
		|	ДокументЗаявкаПайщика.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|	ДокументЗаявкаПайщика.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаявкаПайщика КАК ДокументЗаявкаПайщика
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах КАК КодыПайщиков
		|		ПО (КодыПайщиков.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс))
		|			И (КодыПайщиков.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица))
		|			И (КодыПайщиков.Объект = ДокументЗаявкаПайщика.Пайщик)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах КАК КодыПИФов
		|		ПО (КодыПИФов.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс))
		|			И (КодыПИФов.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды))
		|			И (КодыПИФов.Объект = ДокументЗаявкаПайщика.ПаевойИнвестиционныйФонд)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах КАК КодыЗаявок
		|		ПО (КодыЗаявок.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс))
		|			И (КодыЗаявок.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЗаявкиПайщиков))
		|			И (КодыЗаявок.Объект = ДокументЗаявкаПайщика.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах КАК КодыСчетов
		|		ПО (КодыСчетов.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс))
		|			И (КодыСчетов.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.БанковскиеСчета))
		|			И (КодыСчетов.Объект = ДокументЗаявкаПайщика.РасчетныйСчет)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЗаявокПайщиков.СрезПоследних(
		|				&Дата,
		|				Организация = &Организация
		|					И ЗаявкаПайщика = &Ссылка) КАК СтатусыЗаявокПайщиковСрезПоследних
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах КАК КодыПИФовДляОбмена
		|		ПО (КодыПИФовДляОбмена.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс))
		|			И (КодыПИФовДляОбмена.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды))
		|			И (КодыПИФовДляОбмена.Объект = ДокументЗаявкаПайщика.ПаевойИнвестиционныйФондДляОбменаПаев)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&Дата,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ПО ДокументЗаявкаПайщика.Организация = РеквизитыФизическихЛицАнкетныеСрезПоследних.Организация
		|			И ДокументЗаявкаПайщика.Пайщик = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах КАК КодыАнкет
		|		ПО (КодыАнкет.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс))
		|			И (КодыАнкет.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.АнкетыФизическихЛиц))
		|			И (КодыАнкет.Объект = РеквизитыФизическихЛицАнкетныеСрезПоследних.Регистратор)
		|ГДЕ
		|	ДокументЗаявкаПайщика.Ссылка = &Ссылка
		|	И ДокументЗаявкаПайщика.ВыгружатьОперацииВЕСИАФинанс";
	
	#КонецОбласти
	
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("Ссылка",			ЗаявкаПайщика);
    Запрос.УстановитьПараметр("Дата",			КонецДня(ТекущаяДатаСеанса()));

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ТекстОшибок = "";
		Если Выборка.ЗаявкаБезАктивногоСтатуса Тогда
			ТекстОшибок = ТекстОшибок + "Заявка не имеет активного статуса ('Новая', 'В работе', 'Исполнена')" + Символы.ПС;
		КонецЕсли;
		
		Если Выборка.ОтсутствуетКодПИФа Тогда
			ТекстОшибок = ТекстОшибок + СтрШаблон("У %1 отсутствует код во внешней системе ЕСИА.Финанс%2", Выборка.ПаевойИнвестиционныйФонд, Символы.ПС);
		КонецЕсли;
		
		//Если Выборка.ОтсутствуетКодПайщика Тогда
		//	ТекстОшибок = ТекстОшибок + СтрШаблон("У пайщика %1 в заявке отсутствует код во внешней системе ЕСИА.Финанс%2", Выборка.Пайщик, Символы.ПС);
		//КонецЕсли;
		
		Если Выборка.ПрисвоенКодЗаявки И НЕ ПерезаписатьВЛКК Тогда
			ТекстОшибок = ТекстОшибок + СтрШаблон("Заявка уже есть в ЕСИА.Финанс, код %1%2", Выборка.КодЗаявки, Символы.ПС);
		КонецЕсли;
		
		Если Выборка.kind = "pifs_exchange" И Выборка.ОтсутствуетКодПИФаДляОбмена Тогда
			ТекстОшибок = ТекстОшибок + СтрШаблон("У %1 отсутствует код во внешней системе ЕСИА.Финанс%2", Выборка.ПаевойИнвестиционныйФондДляОбменаПаев, Символы.ПС);
		КонецЕсли;
		
		Если Не ПустаяСтрока(ТекстОшибок) Тогда
			ЗафиксироватьСообщение(СтрШаблон("%1 не выгружена в ЛКК ЕСИА.Финанс по причинам: %2%3", ЗаявкаПайщика, Символы.ПС, ТекстОшибок), Истина, Отказ);
			Возврат;
		КонецЕсли;
		
		// Выгружаем анкету, если ее нет в ЛКК
		ВыгрузилиАнкету = Ложь;
		Если ПустаяСтрока(Выборка.КодАнкеты) И ЗначениеЗаполнено(Выборка.Анкета) Тогда
			
			ПрисвоенныеКодыПайщиков = Новый Массив;
			ЭкспортироватьАнкетыФизЛиц(РаботаСКоллекциями.ЗначениеВМассив(Выборка.Анкета),,, Отказ, ПерезаписатьВЛКК, ПрисвоенныеКодыПайщиков);
								
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
			
			ПрисвоенныйКодПайщика = ПрисвоенныеКодыПайщиков[0].Код;
			
			ВыгрузилиАнкету = Истина;
			
		КонецЕсли;	
				
		РеквизитыЗаявки = Новый Структура("kind, inner_code, status, user_id, owner_type, owner_id, created_at");
		
		ЗаполнитьЗначенияСвойств(РеквизитыЗаявки, Выборка);
		
		Если ВыгрузилиАнкету Тогда
			РеквизитыЗаявки.Вставить("user_id", ПрисвоенныйКодПайщика);	
		КонецЕсли;
		
		//Выгружаем банковский счет
		ИдентификаторСчета = "";
		Если ЗначениеЗаполнено(Выборка.РасчетныйСчет) И ПустаяСтрока(Выборка.КодСчета) Тогда
			// Счет мог быть выгружен при выгрузке анкеты, тогда получим его идентификатор
			ЭкспортироватьПлатежныеРеквизитыФизЛица(Выборка.Пайщик, Выборка.РасчетныйСчет, ИдентификаторСчета, ?(ВыгрузилиАнкету, Ложь, Отказ), Выборка.Ссылка);
		Иначе
			ИдентификаторСчета = Выборка.КодСчета;
		КонецЕсли;
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
			
		Если Выборка.kind = "pifs_purchase" Тогда
			ДанныеЗаявки = Новый Структура("account_number");
		ИначеЕсли Выборка.kind = "pifs_selling" Тогда
			ДанныеЗаявки = Новый Структура("account_number, count");
		Иначе
			ДанныеЗаявки = Новый Структура("account_number, account_number_to, fund_to_id, count");
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ДанныеЗаявки, Выборка);
		
		Если ПерезаписатьВЛКК И Выборка.ПрисвоенКодЗаявки Тогда
			РеквизитыЗаявки.Вставить("metadata", Новый Структура("is_with_open", Выборка.is_with_open));
		Иначе
			ДанныеЗаявки.Вставить("is_with_open", Выборка.is_with_open);
		КонецЕсли;
		
		Если Не ПустаяСтрока(ИдентификаторСчета) Тогда
			ДанныеЗаявки.Вставить("requisite_id", Число(ИдентификаторСчета));	
		КонецЕсли;
				
		РеквизитыЗаявки.Вставить("data", ДанныеЗаявки);	
			
		ТелоЗапроса = ПолучитьСтрокуJSON(РеквизитыЗаявки);

		ТекстСообщения = "Не удалось выполнить запрос.";
		
		ПараметрыПодключения = ПолучитьПараметрыПодключения();
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос(
						?(ПерезаписатьВЛКК И Выборка.ПрисвоенКодЗаявки, "PATCH", "POST"),
						ПараметрыПодключения, 
						"/api/v1/back_office/claims/" + ?(ПерезаписатьВЛКК И Выборка.ПрисвоенКодЗаявки, Выборка.КодЗаявки, ""),
						ТелоЗапроса,
						ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ЗафиксироватьСообщение(ТекстСообщения,, Отказ);
		Иначе
			
			ДанныеЕсиа = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
			
			Если ДанныеЕсиа["success"] = Истина И ЗначениеЗаполнено(ДанныеЕсиа["id"]) Тогда
				
				ЗафиксироватьСообщение(СтрШаблон("Выгружены данные: %1", ЗаявкаПайщика), Ложь);
				
				// Фиксируем присвоенный код во внешней системе
				Если Не Выборка.ПрисвоенКодЗаявки Тогда
					РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(ЗаявкаПайщика,
							Справочники.ВнешниеСистемы.ЕсиаФинанс,
							Справочники.ГруппыИмпортируемыхОбъектов.ЗаявкиПайщиков, ДанныеЕсиа["id"]);
				КонецЕсли;			
				
			ИначеЕсли ЗначениеЗаполнено(ДанныеЕсиа["errors"]) Тогда // Обрабатываем ошибки
				
				ОшибкиЕСИА = ДанныеЕсиа["errors"];
					
				Если ОшибкиЕСИА.Количество() > 0 Тогда  
					
					ТекстОшибок = СтрШаблон("Сообщения об ошибках от портала ЕСИА.Финанс при выгрузке заявки %1:%2", ЗаявкаПайщика, Символы.ПС);
					
					Для Каждого СтрокаОшибок Из ОшибкиЕСИА Цикл
						ТекстОшибок = ТекстОшибок + СтрШаблон("Идентификатор %1: %2%3", СтрокаОшибок.Ключ, СтрокаОшибок.Значение, Символы.ПС);
					КонецЦикла;
					
					ЗафиксироватьСообщение(ТекстОшибок, Истина, Отказ);
				
				Иначе
					ЗафиксироватьСообщение(СтрШаблон("При выгрузке заявки %1 не получен ответ от ЕСИА.Финанс о корректности выгрузки. Возможно, заявка выгружена неверно", ЗаявкаПайщика), Истина, Отказ);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
				
		// Выгружаем лицевые счета, если есть. Выгружаем после заявки, иначе ЛКК неверно воспринимает данные
		Если Выборка.kind <> "pifs_selling" И ЗначениеЗаполнено(Выборка.ДепозитарныйСчет) Тогда
			ЭкспортироватьЛицевойСчетПайщика(Выборка.ДепозитарныйСчет, Выборка.Пайщик, Выборка.ПаевойИнвестиционныйФонд, ВыгружатьОстатки, Отказ);
		КонецЕсли;	
		
		Если Выборка.kind = "pifs_exchange" И ЗначениеЗаполнено(Выборка.ДепозитарныйСчетВПаевомИнвестиционномФондеДляОбмена) Тогда
			ЭкспортироватьЛицевойСчетПайщика(Выборка.ДепозитарныйСчетВПаевомИнвестиционномФондеДляОбмена, Выборка.Пайщик, Выборка.ПаевойИнвестиционныйФондДляОбменаПаев, ВыгружатьОстатки, Отказ);
		КонецЕсли;	
		
	Иначе
		ЗафиксироватьСообщение(СтрШаблон("Для заявки %1 не предусмотрена выгрузка в ЛКК ЕСИА.Финанс", ЗаявкаПайщика), Истина, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЭкспортироватьПлатежныеРеквизитыФизЛица(ФизЛицо, БанковскийСчет, ИдентификаторСчета = "", Отказ = Ложь, ЗаявкаПайщика = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	#Область Текст_запроса
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Организация КАК Организация,
		|	ЕСТЬNULL(КодыПайщиков.Код, """") = """" КАК ОтсутствуетКодПайщика,
		|	КодыБанковскихСчетов.Код ЕСТЬ НЕ NULL  КАК ПрисвоенКодСчета,
		|	""User"" КАК owner_type,
		|	ЕСТЬNULL(КодыПайщиков.Код, """") КАК owner_id,
		|	КодыБанковскихСчетов.Код КАК id,
		|	ЕСТЬNULL(ЗаявкаПайщика.БИК, АнкетаФизическогоЛицаБанковскиеРеквизиты.БИК) КАК bik,
		|	ЕСТЬNULL(ЗаявкаПайщика.НаименованиеБанка, АнкетаФизическогоЛицаБанковскиеРеквизиты.НаименованиеБанка) КАК bank_name,
		|	ЕСТЬNULL(ЗаявкаПайщика.КоррСчет, АнкетаФизическогоЛицаБанковскиеРеквизиты.КоррСчет) КАК corr_account,
		|	ЕСТЬNULL(ЗаявкаПайщика.НомерСчета, АнкетаФизическогоЛицаБанковскиеРеквизиты.НомерСчета) КАК payment_account,
		|	ЕСТЬNULL(ЗаявкаПайщика.ПолучательПлатежа, АнкетаФизическогоЛицаБанковскиеРеквизиты.ПолучательПлатежа) КАК recipient,
		|	ЕСТЬNULL(ЗаявкаПайщика.ИННПолучателя, АнкетаФизическогоЛицаБанковскиеРеквизиты.ИННПолучателя) КАК inn,
		|	ЕСТЬNULL(ЗаявкаПайщика.НазначениеПлатежа, АнкетаФизическогоЛицаБанковскиеРеквизиты.НазначениеПлатежа) КАК notation,
		|	ЕСТЬNULL(ЗаявкаПайщика.РасчетныйСчет.Наименование, АнкетаФизическогоЛицаБанковскиеРеквизиты.РасчетныйСчет.Наименование) КАК name,
		|	ЕСТЬNULL(ЗаявкаПайщика.РасчетныйСчет.Валюта.Наименование, АнкетаФизическогоЛицаБанковскиеРеквизиты.РасчетныйСчет.Валюта.Наименование) КАК valuta_str,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ЗаявкаПайщика.РасчетныйСчет.Валюта, АнкетаФизическогоЛицаБанковскиеРеквизиты.РасчетныйСчет.Валюта) = &Валюта_Российский_рубль
		|			ТОГДА ""rub""
		|		КОГДА ЕСТЬNULL(ЗаявкаПайщика.РасчетныйСчет.Валюта, АнкетаФизическогоЛицаБанковскиеРеквизиты.РасчетныйСчет.Валюта) = &Валюта_Доллар_США
		|			ТОГДА ""usd""
		|		КОГДА ЕСТЬNULL(ЗаявкаПайщика.РасчетныйСчет.Валюта, АнкетаФизическогоЛицаБанковскиеРеквизиты.РасчетныйСчет.Валюта) = &Валюта_ЕВРО
		|			ТОГДА ""eur""
		|		КОГДА ЕСТЬNULL(ЗаявкаПайщика.РасчетныйСчет.Валюта, АнкетаФизическогоЛицаБанковскиеРеквизиты.РасчетныйСчет.Валюта) = &Валюта_юань
		|			ТОГДА ""cny""
		|		КОГДА ЕСТЬNULL(ЗаявкаПайщика.РасчетныйСчет.Валюта, АнкетаФизическогоЛицаБанковскиеРеквизиты.РасчетныйСчет.Валюта) = &Валюта_Швейцарский_франк
		|			ТОГДА ""chf""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК valuta
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И ЮрФизЛицо = &ФизЛицо
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах КАК КодыПайщиков
		|		ПО (КодыПайщиков.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс))
		|			И (КодыПайщиков.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица))
		|			И (КодыПайщиков.Объект = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АнкетаФизическогоЛица.БанковскиеРеквизиты КАК АнкетаФизическогоЛицаБанковскиеРеквизиты
		|		ПО РеквизитыФизическихЛицАнкетныеСрезПоследних.Регистратор = АнкетаФизическогоЛицаБанковскиеРеквизиты.Ссылка
		|			И (АнкетаФизическогоЛицаБанковскиеРеквизиты.РасчетныйСчет = &БанковскийСчет)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах КАК КодыБанковскихСчетов
		|		ПО (КодыБанковскихСчетов.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс))
		|			И (КодыБанковскихСчетов.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.БанковскиеСчета))
		|			И (КодыБанковскихСчетов.Объект = АнкетаФизическогоЛицаБанковскиеРеквизиты.РасчетныйСчет)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаПайщика КАК ЗаявкаПайщика
		|		ПО РеквизитыФизическихЛицАнкетныеСрезПоследних.Организация = ЗаявкаПайщика.Организация
		|			И РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо = ЗаявкаПайщика.Пайщик
		|			И (ЗаявкаПайщика.Ссылка = &Заявка)";
	
	#КонецОбласти
	
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ФизЛицо",		ФизЛицо);
	Запрос.УстановитьПараметр("БанковскийСчет",	БанковскийСчет);
    Запрос.УстановитьПараметр("Дата",			ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Заявка",			ЗаявкаПайщика);
	
	Запрос.УстановитьПараметр("Валюта_Российский_рубль",	ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	Запрос.УстановитьПараметр("Валюта_Доллар_США",			ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Доллар_США"));
	Запрос.УстановитьПараметр("Валюта_ЕВРО",				ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_ЕВРО"));
	Запрос.УстановитьПараметр("Валюта_юань",				ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_юань"));
	Запрос.УстановитьПараметр("Валюта_Швейцарский_франк",	ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Швейцарский_франк"));

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ТекстОшибок = "";
				
		Если Выборка.ОтсутствуетКодПайщика Тогда
			ТекстОшибок = ТекстОшибок + СтрШаблон("У пайщика %1 в отсутствует код во внешней системе ЕСИА.Финанс%2", ФизЛицо, Символы.ПС);
		КонецЕсли;
						
		Если Не ПустаяСтрока(ТекстОшибок) Тогда
			ЗафиксироватьСообщение(СтрШаблон("Счет %1 пайщика %2 не выгружен в ЛКК ЕСИА.Финанс по причинам: %3%4", БанковскийСчет, ФизЛицо, Символы.ПС, ТекстОшибок), Истина, Отказ);
			Возврат;
		КонецЕсли;
		
		Если Выборка.ПрисвоенКодСчета Тогда			
			ИдентификаторСчета = Выборка.id;
			Возврат;
		КонецЕсли;
		
		РеквизитыСчета = Новый Структура("name, bank_name, bik, corr_account, recipient, payment_account, valuta, valuta_str, notation, inn, owner_id, owner_type");
		
		ЗаполнитьЗначенияСвойств(РеквизитыСчета, Выборка);
				
		ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("requisite", РеквизитыСчета));

		ТекстСообщения = "Не удалось выполнить запрос.";
		
		ПараметрыПодключения = ПолучитьПараметрыПодключения();
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office/users/" + Выборка.owner_id + "/requisites/", ТелоЗапроса, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ЗафиксироватьСообщение(ТекстСообщения,, Отказ);
		Иначе
			ЗафиксироватьСообщение(СтрШаблон("Выгружены данные: %1", БанковскийСчет), Ложь);
			
			// Фиксируем присвоенный код во внешней системе			
			ДанныеЕсиа = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
			
			ИдентификаторСчета = ДанныеЕсиа["id"];
			
			Если ДанныеЕсиа["success"] = Истина И ЗначениеЗаполнено(ИдентификаторСчета) Тогда
				
				РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(БанковскийСчет,
						Справочники.ВнешниеСистемы.ЕсиаФинанс,
						Справочники.ГруппыИмпортируемыхОбъектов.БанковскиеСчета, ИдентификаторСчета);
										
			Иначе
				ЗафиксироватьСообщение(СтрШаблон("При выгрузке банковского счета %1 пайщика %2 не получен ответ с идентификатором в ЕСИА.Финанс. Возможно, банковский счет выгружен неверно", БанковскийСчет, ФизЛицо), Истина, Отказ);
			КонецЕсли;
			
		КонецЕсли;
	
	Иначе
		ЗафиксироватьСообщение(СтрШаблон("Для счета %1 не найдены данные для выгрузки в ЛКК ЕСИА.Финанс", БанковскийСчет), Истина, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЭкспортироватьАнкетыФизЛиц(МассивАнкет, ТребуетсяУстановитьПарольВЛКК = Ложь, ОтправитьПриглашение = Ложь, Отказ = Ложь, ПерезаписатьВЛКК = Ложь, ПрисвоенныеКодыПайщиков = Неопределено, ЗаписыватьКодыЕСИАФинанс = Истина) Экспорт

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область Текст_запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокАнкета.Ссылка КАК Ссылка,
		|	ДокАнкета.ЮрФизЛицо КАК ЮрФизЛицо,
		|	АнкетаФизическогоЛицаБанковскиеРеквизиты.РасчетныйСчет КАК РасчетныйСчет
		|ПОМЕСТИТЬ _ДанныеАнкет
		|ИЗ
		|	Документ.АнкетаФизическогоЛица КАК ДокАнкета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АнкетаФизическогоЛица.БанковскиеРеквизиты КАК АнкетаФизическогоЛицаБанковскиеРеквизиты
		|		ПО ДокАнкета.Ссылка = АнкетаФизическогоЛицаБанковскиеРеквизиты.Ссылка
		|			И (ДокАнкета.Ссылка В (&МассивАнкет))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.ГруппаОбъектов КАК ГруппаОбъектов,
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ПОМЕСТИТЬ _КодыВоВнешнихСистемах
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И Объект В
		|					(ВЫБРАТЬ
		|						_ДанныеАнкет.Ссылка КАК Объект
		|					ИЗ
		|						_ДанныеАнкет
		|			
		|					ОБЪЕДИНИТЬ
		|			
		|					ВЫБРАТЬ
		|						_ДанныеАнкет.ЮрФизЛицо
		|					ИЗ
		|						_ДанныеАнкет
		|			
		|					ОБЪЕДИНИТЬ
		|			
		|					ВЫБРАТЬ
		|						_ДанныеАнкет.РасчетныйСчет
		|					ИЗ
		|						_ДанныеАнкет)
		|				И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.АнкетыФизическихЛиц), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.БанковскиеСчета))) КАК КодыВоВнешнихСистемахСрезПоследних
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеАнкет.РасчетныйСчет КАК РасчетныйСчет,
		|	_ДанныеАнкет.ЮрФизЛицо КАК ФизЛицо,
		|	_КодыВоВнешнихСистемах.Код КАК Идентификатор
		|ПОМЕСТИТЬ _БанковскиеСчета
		|ИЗ
		|	_ДанныеАнкет КАК _ДанныеАнкет
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВоВнешнихСистемах КАК _КодыВоВнешнихСистемах
		|		ПО _ДанныеАнкет.РасчетныйСчет = _КодыВоВнешнихСистемах.Объект
		|			И (_КодыВоВнешнихСистемах.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.БанковскиеСчета))
		|ГДЕ
		|	НЕ _ДанныеАнкет.РасчетныйСчет ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо КАК _ФизЛицо,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Организация КАК _Организация,
		|	АнкетаФизическогоЛица.Ссылка КАК _АнкетаСсылка,
		|	АнкетаФизическогоЛица.Фамилия КАК surname,
		|	АнкетаФизическогоЛица.Имя КАК name,
		|	АнкетаФизическогоЛица.ДатаРождения КАК birthday,
		|	АнкетаФизическогоЛица.ТелефонДляОповещения КАК main_phone,
		|	ЕСТЬNULL(КодыПайщиков.Код, """") КАК _КодПайщика,
		|	ЕСТЬNULL(КодыАнкет.Код, """") КАК _КодАнкеты,
		|	АнкетаФизическогоЛица.Отчество КАК patronymic,
		|	""RU"" КАК country_code,
		|	&ТребуетсяУстановитьПарольВЛКК КАК need_to_set_password,
		|	&ОтправитьПриглашение КАК need_send_invite_mail,
		|	ВЫБОР
		|		КОГДА АнкетаФизическогоЛица.Пол = ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Мужской)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК male,
		|	АнкетаФизическогоЛица.РезидентРФ КАК is_rf_resident,
		|	ВЫБОР
		|		КОГДА АнкетаФизическогоЛица.ВидУдостоверенияЛичности = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ)
		|			ТОГДА ""passport""
		|		КОГДА АнкетаФизическогоЛица.ВидУдостоверенияЛичности = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ВодительскоеУдостоверение)
		|			ТОГДА ""driver_license""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК document_type,
		|	АнкетаФизическогоЛица.ДатаВыдачиУдостоверенияЛичности КАК document_issue_date,
		|	АнкетаФизическогоЛица.ОрганВыдавшийУдостоверениеЛичности КАК document_issuer,
		|	АнкетаФизическогоЛица.КодОрганаВыдавшегоУдостоверениеЛичности КАК document_issuer_code,
		|	АнкетаФизическогоЛица.СерияУдостоверенияЛичности КАК document_series,
		|	АнкетаФизическогоЛица.НомерУдостоверенияЛичности КАК document_number,
		|	АнкетаФизическогоЛица.ИНН КАК inn,
		|	АнкетаФизическогоЛица.СНИЛС КАК snils,
		|	АнкетаФизическогоЛица.КодовоеСлово КАК codeword,
		|	АнкетаФизическогоЛица.МестоРождения КАК birth_place,
		|	АнкетаФизическогоЛица.EMail КАК contact_email,
		|	ЛОЖЬ КАК blocked,
		|	"""" КАК blocked_reason,
		|	ЛОЖЬ КАК is_rejected_fatca,
		|	""full"" КАК legal_capacity,
		|	АнкетаФизическогоЛица.РезидентРФ КАК is_rf_taxpayer,
		|	ИСТИНА КАК is_valid_info,
		|	ЛОЖЬ КАК qualified_investor,
		|	ВЫБОР
		|		КОГДА АнкетаФизическогоЛица.ВысокийУровеньРиска
		|			ТОГДА ""high""
		|		ИНАЧЕ ""low""
		|	КОНЕЦ КАК risk_level,
		|	ВЫБОР
		|		КОГДА АнкетаФизическогоЛица.ЯвляетсяПубличнымДолжностнымЛицом
		|				ИЛИ АнкетаФизическогоЛица.ЯвляетсяИностраннымПубличнымДолжностнымЛицом
		|				ИЛИ АнкетаФизическогоЛица.ЯвляетсяДолжностнымЛицомПубличнойМеждународнойОрганизации
		|				ИЛИ АнкетаФизическогоЛица.ЯвляетсяРодственникомПубличногоДолжностногоЛица
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК is_associated_with_pub,
		|	АнкетаФизическогоЛица.ЯвляетсяПубличнымДолжностнымЛицом КАК is_russian_pub_person,
		|	АнкетаФизическогоЛица.ЯвляетсяИностраннымПубличнымДолжностнымЛицом КАК is_foreign_pub_person,
		|	АнкетаФизическогоЛица.ЯвляетсяДолжностнымЛицомПубличнойМеждународнойОрганизации КАК is_person_of_intercity_organizations,
		|	АнкетаФизическогоЛица.ЯвляетсяПубличнымДолжностнымЛицомОписание КАК _ПДЛ_РФ_Описание,
		|	АнкетаФизическогоЛица.ЯвляетсяИностраннымПубличнымДолжностнымЛицомОписание КАК _ПДЛ_Ин_Описание,
		|	АнкетаФизическогоЛица.ЯвляетсяДолжностнымЛицомПубличнойМеждународнойОрганизацииОписание КАК _ПДЛ_МО_Описание,
		|	АнкетаФизическогоЛица.ЯвляетсяРодственникомПубличногоДолжностногоЛица КАК is_bound_with_pub_person,
		|	АнкетаФизическогоЛица.ЯвляетсяРодственникомПубличногоДолжностногоЛицаОписание КАК kinship_status,
		|	ВЫБОР
		|		КОГДА АнкетаФизическогоЛица.ДеловаяРепутацияПоложительная
		|			ТОГДА ""positive""
		|		ИНАЧЕ ""negative""
		|	КОНЕЦ КАК customer_reputation,
		|	ВЫБОР
		|		КОГДА АнкетаФизическогоЛица.ПоложительноеФинансовоеПоложение
		|			ТОГДА ""positive""
		|		ИНАЧЕ ""negative""
		|	КОНЕЦ КАК financial_position,
		|	ВЫБОР
		|		КОГДА АнкетаФизическогоЛица.ВыгодоприобретательКлиент
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК is_beneficiary,
		|	ВЫБОР
		|		КОГДА АнкетаФизическогоЛица.БенефициарныйВладелецКлиент
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК is_beneficial_owner,
		|	АнкетаФизическогоЛица.НаличиеСчетаВГосударствахНеВыполняющихРекомендацииФАТФ КАК fatf_country_bank_account,
		|	АнкетаФизическогоЛица.НаличиеСчетаВГосударствахНеВыполняющихРекомендацииФАТФОписание КАК fatf_country_code,
		|	АнкетаФизическогоЛица.ЦельПриобретениеПаев КАК _ЦельПриобретениеПаев,
		|	АнкетаФизическогоЛица.ЦельДоверительноеУправление КАК _ЦельДоверительноеУправление,
		|	АнкетаФизическогоЛица.ЦельДругое КАК _ЦельДругое,
		|	АнкетаФизическогоЛица.ЦельДругоеОписание КАК _ЦельДругоеОписание,
		|	ВЫБОР
		|		КОГДА АнкетаФизическогоЛица.ЦелиДеятельности = ""Получение прибыли""
		|			ТОГДА ""profit""
		|		КОГДА АнкетаФизическогоЛица.ЦелиДеятельности = ""Социальные, благотворительные, культурные, образовательные или иные общественные цели""
		|			ТОГДА ""social""
		|		ИНАЧЕ ""other""
		|	КОНЕЦ КАК purpose_of_activity,
		|	АнкетаФизическогоЛица.ИсточникиПроисхожденияДенежныхСредств КАК _source_of_money_income,
		|	""personal"" КАК source_of_money_income,
		|	АнкетаФизическогоЛица.АдресРегистрации КАК _АдресРегистрации,
		|	АнкетаФизическогоЛица.АдресРегистрацииФИАС КАК _АдресРегистрацииФИАС,
		|	АнкетаФизическогоЛица.АдресМестаЖительства КАК _АдресМестаЖительства,
		|	АнкетаФизическогоЛица.АдресМестаЖительстваФИАС КАК _АдресМестаЖительстваФИАС,
		|	АнкетаФизическогоЛица.ПочтовыйАдрес КАК _ПочтовыйАдрес,
		|	АнкетаФизическогоЛица.ПочтовыйАдресФИАС КАК _ПочтовыйАдресФИАС
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АнкетаФизическогоЛица КАК АнкетаФизическогоЛица
		|		ПО РеквизитыФизическихЛицАнкетныеСрезПоследних.Регистратор = АнкетаФизическогоЛица.Ссылка
		|			И (АнкетаФизическогоЛица.Ссылка В (&МассивАнкет))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВоВнешнихСистемах КАК КодыПайщиков
		|		ПО РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо = КодыПайщиков.Объект
		|			И (КодыПайщиков.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВоВнешнихСистемах КАК КодыАнкет
		|		ПО РеквизитыФизическихЛицАнкетныеСрезПоследних.Регистратор = КодыАнкет.Объект
		|			И (КодыАнкет.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.АнкетыФизическихЛиц))";
#КонецОбласти
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("МассивАнкет", МассивАнкет);
    Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
		
	Запрос.УстановитьПараметр("ТребуетсяУстановитьПарольВЛКК", ТребуетсяУстановитьПарольВЛКК);
	Запрос.УстановитьПараметр("ОтправитьПриглашение", ОтправитьПриглашение);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();

	МассивФлаговПДЛ = Новый Массив;
	МассивФлаговПДЛ.Добавить("is_russian_pub_person");
	МассивФлаговПДЛ.Добавить("is_foreign_pub_person");
	МассивФлаговПДЛ.Добавить("is_person_of_intercity_organizations");
	
	СоответствиеИсточниковДС = Новый Соответствие;
	СоответствиеИсточниковДС.Вставить("Личные сбережения", "personal");
	
	СоответствиеИсточниковДС.Вставить(
		"Доход от осуществления предпринимательской деятельности и (или) от участия в уставном (складочном) капитале коммерческой организации",
		"bussiness");
	
	СоответствиеИсточниковДС.Вставить(
		"Доход от операций с ценными бумагами и (или) иностранными финансовыми инструментами, не квалифицированными в соответствии с countзаконодательством РФ в качестве ценных бумаг",
		"nrd_papers");
	
	СоответствиеИсточниковДС.Вставить("Доход от операций с производными финансовыми инструментами", "financial_instruments");
	СоответствиеИсточниковДС.Вставить("Получение наследства или активов по договору дарения", "inheritance");
	СоответствиеИсточниковДС.Вставить("Заем, кредит", "credit");
	СоответствиеИсточниковДС.Вставить("Доход по основному месту работы (включая доход от работы по совместительству)", "job");
	СоответствиеИсточниковДС.Вставить("Доход от продажи имущества", "property_selling");
	СоответствиеИсточниковДС.Вставить("Иное", "else");
	
	Пока Выборка.Следующий() Цикл
		
		ТекстОшибок = "";
				
		Если Не ПерезаписатьВЛКК И Не ПустаяСтрока(Выборка._КодАнкеты) Тогда
			ТекстОшибок = ТекстОшибок + СтрШаблон("Анкета %1 уже есть в ЕСИА.Финанс, код %2%3", Выборка._АнкетаСсылка, Выборка._КодАнкеты, Символы.ПС);
		КонецЕсли;
						
		Если Не ПустаяСтрока(ТекстОшибок) Тогда
			ЗафиксироватьСообщение(СтрШаблон("Анкета %1 не выгружена в ЛКК ЕСИА.Финанс по причинам: %2%3", Выборка._АнкетаСсылка, Символы.ПС, ТекстОшибок), Истина, Отказ);
			Возврат;
		КонецЕсли;
			
		РеквизитыАнкеты = Новый Структура();
		
		Если Не ПустаяСтрока(Выборка._КодПайщика) Тогда
			РеквизитыАнкеты.Вставить("id", Выборка._КодПайщика);
		КонецЕсли;
		
		Для Каждого КолонкаРезультата Из РезультатЗапроса.Колонки Цикл
			
			Если СтрНачинаетсяС(КолонкаРезультата.Имя, "_") Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Выборка[КолонкаРезультата.Имя]) Тогда
				
				Если ТипЗнч(Выборка[КолонкаРезультата.Имя]) = Тип("Дата") Тогда
					РеквизитыАнкеты.Вставить(КолонкаРезультата.Имя, Формат(Выборка[КолонкаРезультата.Имя], "ДФ=dd.MM.yyyy"));
				Иначе
					РеквизитыАнкеты.Вставить(КолонкаРезультата.Имя, Выборка[КолонкаРезультата.Имя]);
				КонецЕсли;
					
			КонецЕсли;
			
		КонецЦикла;
		
		// Получаем поля ПДЛ из описания
		Если Выборка.is_associated_with_pub Тогда
					
			Для Каждого ФлагПДЛ Из МассивФлаговПДЛ Цикл
				Если Выборка[ФлагПДЛ] Тогда
					ЗаполнитьПоляПДЛ(РеквизитыАнкеты, Выборка, ФлагПДЛ, Отказ);
				КонецЕсли;
				
				Если Отказ Тогда
					Возврат;
				КонецЕсли;
			КонецЦикла;	
					
		КонецЕсли;
		
		Если СтрДлина(Выборка.snils) > 11 Тогда
			РеквизитыАнкеты.Вставить("snils", РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(Выборка.snils));
		КонецЕсли;
		
		Если Не ПустаяСтрока(Выборка._source_of_money_income)
			И ЭтотОбъект.Дата >= РаботаСДокументами.ДатаПереносаОстатковПоПИФИзМКБИ() Тогда
			
			МассивИсточниковДС = СтрРазделить(Выборка._source_of_money_income, ";");
			МассивИсточниковДСЛКК = Новый Массив;
			
			Для Каждого ИсточникДС Из МассивИсточниковДС Цикл
				ИсточникДСЛКК = СоответствиеИсточниковДС.Получить(ИсточникДС);
				Если ИсточникДСЛКК <> Неопределено Тогда
					МассивИсточниковДСЛКК.Добавить(ИсточникДСЛКК);
				КонецЕсли;
			КонецЦикла;
			
			Если МассивИсточниковДСЛКК.Количество() > 0 Тогда
				РеквизитыАнкеты.Вставить("source_of_money_income", МассивИсточниковДСЛКК);
			КонецЕсли;
			
		КонецЕсли;
		
		Если Выборка._ЦельПриобретениеПаев Или Выборка._ЦельДоверительноеУправление Тогда
			
			МассивЦелей = Новый Массив;
			
			Если Выборка._ЦельПриобретениеПаев Тогда
				МассивЦелей.Добавить("pif_services");
			КонецЕсли;
			
			Если Выборка._ЦельДоверительноеУправление Тогда
				МассивЦелей.Добавить("du_services");
			КонецЕсли;
			
			РеквизитыАнкеты.Вставить("purpose_of_business", МассивЦелей);
			
		КонецЕсли;

		//Адрес регистрации
		СтруктураАдресаРегистрации = РаботаСКонтактнойИнформациейКлиентСервер.АдресФИАСВСтруктуру(Выборка._АдресРегистрацииФИАС);
			
		Если Не ПустаяСтрока(СтруктураАдресаРегистрации.ПредставлениеАдреса) Тогда
			
			// Считаем, что адрес в формате ФИАС заполнен
			РеквизитыАнкеты.Вставить("country",		СтруктураАдресаРегистрации.Страна);
			РеквизитыАнкеты.Вставить("region",		СтруктураАдресаРегистрации.Регион);
			РеквизитыАнкеты.Вставить("index",		СтруктураАдресаРегистрации.Индекс);
			РеквизитыАнкеты.Вставить("city",		СтруктураАдресаРегистрации.Город);
			РеквизитыАнкеты.Вставить("street",		СтруктураАдресаРегистрации.Улица);
			РеквизитыАнкеты.Вставить("house",		СтруктураАдресаРегистрации.Дом);
			РеквизитыАнкеты.Вставить("corps",		СтруктураАдресаРегистрации.Строение);
			РеквизитыАнкеты.Вставить("flat",		СтруктураАдресаРегистрации.Помещение);
			РеквизитыАнкеты.Вставить("district",	СтруктураАдресаРегистрации.Район);
			РеквизитыАнкеты.Вставить("as_kladr",	Истина);
			
		Иначе
			// Используем адрес в произвольном формате
			//Выборка._АдресРегистрации
		КонецЕсли;
				
		//Адрес места жительства
		РеквизитыАдреса = Новый Структура;
		СтруктураАдресаРегистрации = РаботаСКонтактнойИнформациейКлиентСервер.АдресФИАСВСтруктуру(Выборка._АдресМестаЖительстваФИАС);
			
		Если Не ПустаяСтрока(СтруктураАдресаРегистрации.ПредставлениеАдреса) Тогда
			
			// Считаем, что адрес в формате ФИАС заполнен
			РеквизитыАдреса.Вставить("country",		СтруктураАдресаРегистрации.Страна);
			РеквизитыАдреса.Вставить("region",		СтруктураАдресаРегистрации.Регион);
			РеквизитыАдреса.Вставить("index",		СтруктураАдресаРегистрации.Индекс);
			РеквизитыАдреса.Вставить("city",		СтруктураАдресаРегистрации.Город);
			РеквизитыАдреса.Вставить("street",		СтруктураАдресаРегистрации.Улица);
			РеквизитыАдреса.Вставить("house",		СтруктураАдресаРегистрации.Дом);
			РеквизитыАдреса.Вставить("corps",		СтруктураАдресаРегистрации.Строение);
			РеквизитыАдреса.Вставить("flat",		СтруктураАдресаРегистрации.Помещение);
			РеквизитыАдреса.Вставить("district",	СтруктураАдресаРегистрации.Район);
			РеквизитыАдреса.Вставить("as_kladr",	Истина);
			
		Иначе
			// Используем адрес в произвольном формате
			//Выборка._АдресМестаЖительства
		КонецЕсли;
		
		Адреса = Новый Структура;
		Если РеквизитыАдреса.Количество() > 0 Тогда
			Адреса.Вставить("residential", РеквизитыАдреса);
		КонецЕсли;
		
		//Адрес регистрации
		РеквизитыАдреса = Новый Структура;
		СтруктураАдресаРегистрации = РаботаСКонтактнойИнформациейКлиентСервер.АдресФИАСВСтруктуру(Выборка._ПочтовыйАдресФИАС);
			
		Если Не ПустаяСтрока(СтруктураАдресаРегистрации.ПредставлениеАдреса) Тогда
			
			// Считаем, что адрес в формате ФИАС заполнен
			РеквизитыАдреса.Вставить("country",		СтруктураАдресаРегистрации.Страна);
			РеквизитыАдреса.Вставить("region",		СтруктураАдресаРегистрации.Регион);
			РеквизитыАдреса.Вставить("index",		СтруктураАдресаРегистрации.Индекс);
			РеквизитыАдреса.Вставить("city",		СтруктураАдресаРегистрации.Город);
			РеквизитыАдреса.Вставить("street",		СтруктураАдресаРегистрации.Улица);
			РеквизитыАдреса.Вставить("house",		СтруктураАдресаРегистрации.Дом);
			РеквизитыАдреса.Вставить("corps",		СтруктураАдресаРегистрации.Строение);
			РеквизитыАдреса.Вставить("flat",		СтруктураАдресаРегистрации.Помещение);
			РеквизитыАдреса.Вставить("district",	СтруктураАдресаРегистрации.Район);
			РеквизитыАдреса.Вставить("as_kladr",	Истина);
			
		Иначе
			// Используем адрес в произвольном формате
			//Выборка._ПочтовыйАдрес
		КонецЕсли;
		
		Если РеквизитыАдреса.Количество() > 0 Тогда
			Адреса.Вставить("for_corresp", РеквизитыАдреса);
		КонецЕсли;
		
		Если Адреса.Количество() > 0 Тогда
			РеквизитыАнкеты.Вставить("addresses", Адреса);
		КонецЕсли;
		
		МассивФизЛиц = Новый Массив;
		МассивФизЛиц.Добавить(РеквизитыАнкеты);
		
		ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("users", МассивФизЛиц));

		ТекстСообщения = "Не удалось выполнить запрос.";
		
		ПараметрыПодключения = ПолучитьПараметрыПодключения();
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office/users/import", ТелоЗапроса, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ЗафиксироватьСообщение(ТекстСообщения,, Отказ);
		Иначе
		
			// Фиксируем присвоенный код во внешней системе
			ДанныеЕсиа = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
		
			Если ДанныеЕсиа["success"] = Истина И ЗначениеЗаполнено(ДанныеЕсиа["users"]) Тогда
				
				Для Каждого ТекЗапись Из ДанныеЕсиа["users"] Цикл
					КодПайщика = ТекЗапись["id"];
					Прервать;
				КонецЦикла;
								
				Если ТипЗнч(ПрисвоенныеКодыПайщиков) = Тип("Массив") Тогда
					ПрисвоенныеКодыПайщиков.Добавить(Новый Структура("ФизЛицо, Код", Выборка._ФизЛицо, КодПайщика));
				КонецЕсли;
				
				ЗафиксироватьСообщение(СтрШаблон("Выгружены данные: %1", Выборка._АнкетаСсылка), Ложь);
				
				Если ПустаяСтрока(Выборка._КодПайщика) И ЗаписыватьКодыЕСИАФинанс Тогда
					
					РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(Выборка._ФизЛицо,
							Справочники.ВнешниеСистемы.ЕсиаФинанс,
							Справочники.ГруппыИмпортируемыхОбъектов.ФизическиеЛица, КодПайщика);
							
					// Обратно отправляем pifs_portfolio_code
					МассивКодовПайщиков = Новый Массив;
					МассивКодовПайщиков.Добавить(Новый Структура("id, pifs_portfolio_code", КодПайщика, КодПайщика));
					
					ЭкспортироватьКодыПайщиков(МассивКодовПайщиков, ПараметрыПодключения, КодПайщика, Отказ);
					
				КонецЕсли;
				
				Если ПустаяСтрока(Выборка._КодАнкеты) И ЗаписыватьКодыЕСИАФинанс Тогда
					РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(
							Выборка._АнкетаСсылка,
							Справочники.ВнешниеСистемы.ЕсиаФинанс,
							Справочники.ГруппыИмпортируемыхОбъектов.АнкетыФизическихЛиц,
							КодПайщика);
				КонецЕсли;
						
			ИначеЕсли ЗначениеЗаполнено(ДанныеЕсиа["errors"]) Тогда // Обрабатываем ошибки
				
				ОшибкиЕСИА = ДанныеЕсиа["errors"];
				
				Если ОшибкиЕСИА.Количество() > 0 Тогда 
				
					ТекстОшибок = СтрШаблон("Сообщения об ошибках от портала ЕСИА.Финанс при выгрузке анкеты %1:%2", Выборка._АнкетаСсылка, Символы.ПС);
					
					Для Каждого СтрокаОшибок Из ОшибкиЕСИА Цикл
						ТекстОшибок = ТекстОшибок + СтрШаблон("Идентификатор %1: %2%3", СтрокаОшибок.Ключ, СтрокаОшибок.Значение, Символы.ПС);
					КонецЦикла;
					
					ЗафиксироватьСообщение(ТекстОшибок, Истина, Отказ);
					
				Иначе
					ЗафиксироватьСообщение(СтрШаблон("При выгрузке банковского счета %1 пайщика %2 не получен ответ с идентификатором в ЕСИА.Финанс. Возможно, банковский счет выгружен неверно", Выборка._АнкетаСсылка, Выборка._ФизЛицо), Истина, Отказ);				
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		// Банковские счета выгружаем отдельно
		Если Не Отказ Тогда
			
			БанковскиеСчета = Запрос.МенеджерВременныхТаблиц.Таблицы["_БанковскиеСчета"].ПолучитьДанные().Выгрузить();
			
			Для Каждого БанковскийСчет Из БанковскиеСчета Цикл
				ЭкспортироватьПлатежныеРеквизитыФизЛица(БанковскийСчет.ФизЛицо, БанковскийСчет.РасчетныйСчет, БанковскийСчет.Идентификатор, Отказ);
			КонецЦикла;
			
		КонецЕсли;
		
		// nature_of_business - не заполняем (в наших анкетах отсутствует)
		
	КонецЦикла;
			
КонецПроцедуры

Процедура ЭкспортироватьЛицевойСчетПайщика(ЛицевойСчет, Пайщик, ПаевойИнвестиционныйФонд, ВыгружатьОстатки = Ложь, Отказ = Ложь) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитарныеСчета.НомерСчета КАК account,
		|	МАКСИМУМ(ЕСТЬNULL(ДолиПайщиковВИнвестиционномФондеОбороты.Период, &ДатаОкончания)) КАК settlement_date,
		|	КодыПИФов.Код КАК fund_code,
		|	КодыПайщиков.Код КАК user,
		|	0 КАК count
		|ИЗ
		|	Справочник.ДепозитарныеСчета КАК ДепозитарныеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах КАК КодыПИФов
		|		ПО (КодыПИФов.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс))
		|			И (КодыПИФов.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды))
		|			И (КодыПИФов.Объект = ДепозитарныеСчета.Эмитент)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах КАК КодыПайщиков
		|		ПО (КодыПайщиков.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс))
		|			И (КодыПайщиков.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица))
		|			И (КодыПайщиков.Объект = ДепозитарныеСчета.ВладелецСчета)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.Обороты(
		|				,
		|				&ДатаОкончания,
		|				День,
		|				Организация = &Организация
		|					И ПаевойИнвестиционныйФонд = &ПаевойИнвестиционныйФонд
		|					И Пайщик = &Пайщик) КАК ДолиПайщиковВИнвестиционномФондеОбороты
		|		ПО ДепозитарныеСчета.Эмитент = ДолиПайщиковВИнвестиционномФондеОбороты.ПаевойИнвестиционныйФонд
		|			И ДепозитарныеСчета.ВладелецСчета = ДолиПайщиковВИнвестиционномФондеОбороты.Пайщик
		|ГДЕ
		|	ДепозитарныеСчета.Ссылка = &ЛицевойСчет
		|
		|СГРУППИРОВАТЬ ПО
		|	ДепозитарныеСчета.НомерСчета,
		|	КодыПИФов.Код,
		|	КодыПайщиков.Код");
	
	Запрос.УстановитьПараметр("ЛицевойСчет",				ЛицевойСчет);
	Запрос.УстановитьПараметр("Пайщик",						Пайщик);
	Запрос.УстановитьПараметр("ПаевойИнвестиционныйФонд",	ПаевойИнвестиционныйФонд);
	Запрос.УстановитьПараметр("Организация",				ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаОкончания",				ТекущаяДатаСеанса());
			
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ДанныеСчета = Новый Структура("fund_code, user, count, account, settlement_date");
		ЗаполнитьЗначенияСвойств(ДанныеСчета, Выборка);
		
		ДанныеСчета.settlement_date = Формат(ДанныеСчета.settlement_date, "ДФ=dd.MM.yyyy");
				
		ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("data", РаботаСКоллекциями.ЗначениеВМассив(ДанныеСчета)));

		ТекстСообщения = "Не удалось выполнить запрос.";
		
		ПараметрыПодключения = ПолучитьПараметрыПодключения();
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office/portfolio/import/?import_type=account_with_shares", ТелоЗапроса, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ЗафиксироватьСообщение(ТекстСообщения,, Отказ);
		Иначе
						
			// Фиксируем присвоенный код во внешней системе			
			ДанныеЕсиа = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
		
			Если ДанныеЕсиа["success"] = Истина Тогда			
				
				ЗафиксироватьСообщение(СтрШаблон("Выгружен лицевой счет: %1", ЛицевойСчет), Ложь);
								
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыгрузитьОперацииПоПаям(ОперацияПоПаям, НомерДокумента, Отказ = Ложь) Экспорт
	
	РеквизитыОперации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОперацияПоПаям,
		Новый Структура("Пайщик, Дата, ПаевойИнвестиционныйФонд, Заявка, ДатаДокумента, СчетДоверительногоУправления",
			"Заявка.Пайщик",
			"Дата",
			"ПаевойИнвестиционныйФонд",
			"Заявка",
			"Дата",
			"СчетДоверительногоУправления"));
	
	ЭтотОбъект.Дата = РеквизитыОперации.Дата;
			
	ПараметрыПодключения = ПолучитьПараметрыПодключения(); 

	//1. Получаем остатки паев на портале Есиа.Финанс + лицевые счета
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область Текст_запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды) КАК ЭтоПиф,
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ПОМЕСТИТЬ _КодыЕсиаФинанс
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&КонецПериода,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды))
		|				И Объект В (&Объекты)) КАК КодыВоВнешнихСистемахСрезПоследних";
#КонецОбласти
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация); 
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(РеквизитыОперации.Пайщик);
	МассивОбъектов.Добавить(РеквизитыОперации.ПаевойИнвестиционныйФонд);
	
	Запрос.УстановитьПараметр("Объекты", МассивОбъектов);
	
	Запрос.УстановитьПараметр("ПредыдущийРабочийДень",
		Справочники.Календари.ДобавитьКДатеРабочиеДни(
			Справочники.Календари.Общероссийский,
			ЭтотОбъект.Дата,
			-2));
	
	Запрос.Выполнить();
	
	ВыборкаКодов = Запрос.МенеджерВременныхТаблиц.Таблицы["_КодыЕсиаФинанс"]. ПолучитьДанные().Выбрать();
	
	КодыСтр = "";
	
	Пока ВыборкаКодов.Следующий() Цикл
		
		Если Не ВыборкаКодов.ЭтоПиф Тогда 
			КодыСтр = КодыСтр + ?(КодыСтр = "", "?", "&") + "ids%5B%5D=" + ВыборкаКодов.Код;
		КонецЕсли; 
		
	КонецЦикла;
	
	ТаблицаДанныхЕсиа = Новый ТаблицаЗначений;
	ТаблицаДанныхЕсиа.Колонки.Добавить("КодПайщика", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки("55")));
	ТаблицаДанныхЕсиа.Колонки.Добавить("КодПифа", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки("55")));
	ТаблицаДанныхЕсиа.Колонки.Добавить("Количество", Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
	ТаблицаДанныхЕсиа.Колонки.Добавить("НомерСчета", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки("100"))); 
	
	Если ЗначениеЗаполнено(КодыСтр) Тогда
			
		МассивОстатковПаев = ПолучитьДанныеЕсиа("users/piece_balances", "balance",, КодыСтр, ПараметрыПодключения);    
				
		Если МассивОстатковПаев = Неопределено Тогда
			ЗафиксироватьСообщение("Не удалось получить остатки паев.",, Отказ);
			Возврат;
		КонецЕсли;
		
		Для Каждого ТекОстаток Из МассивОстатковПаев Цикл
			
			НоваяЗаписьОстатка = ТаблицаДанныхЕсиа.Добавить();
			НоваяЗаписьОстатка.КодПайщика = ТекОстаток["user_id"];
			НоваяЗаписьОстатка.КодПифа = ТекОстаток["fund"];
			НоваяЗаписьОстатка.Количество = ТекОстаток["count"];
			НоваяЗаписьОстатка.НомерСчета = ТекОстаток["account_number"];
			
		КонецЦикла;
		
	КонецЕсли;
	
#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаДанныхЕсиа.КодПайщика КАК КодПайщика,
		|	ТаблицаДанныхЕсиа.КодПифа КАК КодПифа,
		|	ТаблицаДанныхЕсиа.Количество КАК Количество,
		|	ТаблицаДанныхЕсиа.НомерСчета КАК НомерСчета
		|ПОМЕСТИТЬ _ТаблицаДанныхЕсиа
		|ИЗ
		|	&ТаблицаДанныхЕсиа КАК ТаблицаДанныхЕсиа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаДанныхЕсиа.КодПайщика КАК КодПайщика,
		|	_ТаблицаДанныхЕсиа.КодПифа КАК КодПифа,
		|	_ТаблицаДанныхЕсиа.Количество КАК Количество,
		|	_ТаблицаДанныхЕсиа.НомерСчета КАК НомерСчета,
		|	_КодыПайщиков.Объект КАК Пайщик,
		|	_КодыПифов.Объект КАК Пиф
		|ПОМЕСТИТЬ _ДанныеЕсиа
		|ИЗ
		|	_ТаблицаДанныхЕсиа КАК _ТаблицаДанныхЕсиа
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыЕсиаФинанс КАК _КодыПайщиков
		|		ПО _ТаблицаДанныхЕсиа.КодПайщика = _КодыПайщиков.Код
		|			И (НЕ _КодыПайщиков.ЭтоПиф)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыЕсиаФинанс КАК _КодыПифов
		|		ПО _ТаблицаДанныхЕсиа.КодПифа = _КодыПифов.Код
		|			И (_КодыПифов.ЭтоПиф)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КодыПайщиков.Код КАК КодПайщика,
		|	_КодыПифов.Код КАК КодПифа,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.ПаевойИнвестиционныйФонд КАК Пиф,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.Пайщик КАК Пайщик,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(&Операция) = ТИП(Документ.ЗачислениеПаев)
		|				И ЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен)
		|			ТОГДА ЗаявкаПайщика.ДепозитарныйСчетВПаевомИнвестиционномФондеДляОбмена.НомерСчета
		|		ИНАЧЕ ЗаявкаПайщика.ДепозитарныйСчет.НомерСчета
		|	КОНЕЦ КАК НомерСчета,
		|	ЗаявкаПайщика.НомерЗаявки КАК НомерЗаявки,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.КоличествоНачальныйОстаток КАК КолвоДоОперации,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.КоличествоКонечныйОстаток КАК КолвоПослеОперации,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.КоличествоОборот КАК КолвоОборот,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.СтоимостьНачальныйОстаток КАК СуммаНачОстаток,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.СтоимостьКонечныйОстаток КАК СуммаКонОстаток,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(&Операция) = ТИП(Документ.ЗачислениеПаев)
		|			ТОГДА ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.СтоимостьОборот
		|		ИНАЧЕ ЕСТЬNULL(ЗадолженностьПередПайщикамиОбороты.СуммаПриход, 0) + ЕСТЬNULL(ЗадолженностьПоНадбавкамИСкидкам.СуммаПриход, 0)
		|	КОНЕЦ КАК СуммаОперации,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиНаНачалоИКонец.КоличествоКонечныйОстаток КАК ОстатокПаевНаКонецДня,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиНаНачалоИКонец.СтоимостьКонечныйОстаток КАК СтоимостьНаКонецДня,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиНаНачалоИКонец.КоличествоНачальныйОстаток КАК ОстатокПаевНаНачалоДня,
		|	ЕСТЬNULL(ФинансовыеПоказатели.Значение, 0) КАК СтоимостьПая,
		|	ЕСТЬNULL(ЗадолженностьПоНадбавкамИСкидкам.СуммаПриход, 0) КАК СуммаНадбавкиСкидки,
		|	ЕСТЬNULL(ЗадолженностьПоНДФЛОбороты.СуммаПриход, 0) КАК НДФЛ
		|ПОМЕСТИТЬ _ДанныеУчетнойСистемы
		|ИЗ
		|	РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Регистратор,
		|			Движения,
		|			Организация = &Организация
		|				И ПаевойИнвестиционныйФонд = &ПаевойИнвестиционныйФонд
		|				И Пайщик = &Пайщик) КАК ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыЕсиаФинанс КАК _КодыПифов
		|		ПО ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.ПаевойИнвестиционныйФонд = _КодыПифов.Объект
		|			И (_КодыПифов.ЭтоПиф)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыЕсиаФинанс КАК _КодыПайщиков
		|		ПО ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.Пайщик = _КодыПайщиков.Объект
		|			И (НЕ _КодыПайщиков.ЭтоПиф)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаПайщика КАК ЗаявкаПайщика
		|		ПО (ЗаявкаПайщика.Ссылка = &Заявка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&КонецПериода, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.Организация = КлиентыДоверительногоУправленияСрезПоследних.Организация
		|			И ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.ПаевойИнвестиционныйФонд = КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = ФинансовыеПоказатели.СубъектАналитики)
		|			И (ФинансовыеПоказатели.Период = &ПредыдущийРабочийДень)
		|			И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьПая))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|				&НачалоПериода,
		|				&КонецПериода,
		|				Регистратор,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.УдержаниеНадбавокИСкидокПИФ)) КАК ЗадолженностьПоНадбавкамИСкидкам
		|		ПО ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.Регистратор = ЗадолженностьПоНадбавкамИСкидкам.Регистратор
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.ОстаткиИОбороты(
		|				&НачалоПериода,
		|				&КонецПериодаГраница,
		|				,
		|				,
		|				Организация = &Организация
		|					И ПаевойИнвестиционныйФонд = &ПаевойИнвестиционныйФонд
		|					И Пайщик = &Пайщик) КАК ДолиПайщиковВИнвестиционномФондеОстаткиНаНачалоИКонец
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|				&НачалоПериода,
		|				&ТекущаяДата,
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|					И ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НДФЛ))
		|					И Основание = &Операция) КАК ЗадолженностьПоНДФЛОбороты
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|				&НачалоПериода,
		|				&КонецПериода,
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПередПайщиками)
		|					И Основание = &Операция) КАК ЗадолженностьПередПайщикамиОбороты
		|		ПО (ИСТИНА)
		|ГДЕ
		|	ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.Регистратор = &Операция
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеЕсиа.КодПайщика КАК КодЕсиа,
		|	ИСТИНА КАК КодПайщика
		|ПОМЕСТИТЬ _ОшибкиОпределенияОбъектовУчетнойСистемы
		|ИЗ
		|	_ДанныеЕсиа КАК _ДанныеЕсиа
		|ГДЕ
		|	_ДанныеЕсиа.Пайщик ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_ДанныеЕсиа.КодПифа,
		|	ЛОЖЬ
		|ИЗ
		|	_ДанныеЕсиа КАК _ДанныеЕсиа
		|ГДЕ
		|	_ДанныеЕсиа.Пиф ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеЕсиа.Пайщик КАК Пайщик,
		|	_ДанныеЕсиа.Пиф КАК Пиф,
		|	_ДанныеЕсиа.Количество КАК Количество,
		|	_ДанныеЕсиа.НомерСчета КАК НомерСчета
		|ПОМЕСТИТЬ _ВнешниеДанные
		|ИЗ
		|	_ДанныеЕсиа КАК _ДанныеЕсиа
		|ГДЕ
		|	НЕ _ДанныеЕсиа.Пайщик ЕСТЬ NULL
		|	И НЕ _ДанныеЕсиа.Пиф ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_ДанныеУчетнойСистемы.Пайщик, _ВнешниеДанные.Пайщик) КАК Пайщик,
		|	ЕСТЬNULL(_ДанныеУчетнойСистемы.Пиф, _ВнешниеДанные.Пиф) КАК Пиф,
		|	ЕСТЬNULL(_ДанныеУчетнойСистемы.НомерСчета, _ВнешниеДанные.НомерСчета) КАК НомерСчета,
		|	_ДанныеУчетнойСистемы.ОстатокПаевНаНачалоДня КАК КоличествоУчетнаяСистема,
		|	_ВнешниеДанные.Количество КАК КоличествоЕсиа
		|ПОМЕСТИТЬ _РасхожденияНачальныхОстатков
		|ИЗ
		|	_ДанныеУчетнойСистемы КАК _ДанныеУчетнойСистемы
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ВнешниеДанные КАК _ВнешниеДанные
		|		ПО _ДанныеУчетнойСистемы.Пайщик = _ВнешниеДанные.Пайщик
		|			И _ДанныеУчетнойСистемы.Пиф = _ВнешниеДанные.Пиф
		|			И _ДанныеУчетнойСистемы.НомерСчета = _ВнешниеДанные.НомерСчета
		|ГДЕ
		|	ЕСТЬNULL(_ДанныеУчетнойСистемы.ОстатокПаевНаНачалоДня, 0) <> ЕСТЬNULL(_ВнешниеДанные.Количество, 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеУчетнойСистемы.КодПайщика КАК КодПайщика,
		|	_ДанныеУчетнойСистемы.КодПифа КАК КодПифа,
		|	_ДанныеУчетнойСистемы.Пиф КАК Пиф,
		|	_ДанныеУчетнойСистемы.Пайщик КАК Пайщик,
		|	_ДанныеУчетнойСистемы.НомерСчета КАК НомерСчета,
		|	_ДанныеУчетнойСистемы.НомерЗаявки КАК НомерЗаявки,
		|	_ДанныеУчетнойСистемы.КолвоДоОперации КАК КолвоДоОперации,
		|	_ДанныеУчетнойСистемы.КолвоПослеОперации КАК КолвоПослеОперации,
		|	_ДанныеУчетнойСистемы.ОстатокПаевНаКонецДня КАК ОстатокПаевНаКонецДня,
		|	_ДанныеУчетнойСистемы.КолвоОборот КАК КолвоОборот,
		|	_ДанныеУчетнойСистемы.СуммаНачОстаток КАК СуммаНачОстаток,
		|	_ДанныеУчетнойСистемы.СтоимостьНаКонецДня КАК СтоимостьНаКонецДня,
		|	_ДанныеУчетнойСистемы.СуммаОперации КАК СуммаОперации,
		|	_ДанныеУчетнойСистемы.СтоимостьПая КАК СтоимостьПая,
		|	_ДанныеУчетнойСистемы.СуммаНадбавкиСкидки КАК СуммаНадбавкиСкидки,
		|	_ДанныеУчетнойСистемы.НДФЛ КАК НДФЛ
		|ИЗ
		|	_ДанныеУчетнойСистемы КАК _ДанныеУчетнойСистемы
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнешниеДанные КАК _ВнешниеДанные
		|		ПО _ДанныеУчетнойСистемы.Пайщик = _ВнешниеДанные.Пайщик
		|			И _ДанныеУчетнойСистемы.Пиф = _ВнешниеДанные.Пиф
		|			И _ДанныеУчетнойСистемы.НомерСчета = _ВнешниеДанные.НомерСчета
		|			И _ДанныеУчетнойСистемы.ОстатокПаевНаНачалоДня = _ВнешниеДанные.Количество
		|			И (_ДанныеУчетнойСистемы.КолвоОборот > 0)";
#КонецОбласти	

	Запрос.УстановитьПараметр("Операция",						ОперацияПоПаям);
	Запрос.УстановитьПараметр("ТаблицаДанныхЕсиа",				ТаблицаДанныхЕсиа);
	Запрос.УстановитьПараметр("Пайщик",							РеквизитыОперации.Пайщик);
	Запрос.УстановитьПараметр("ПаевойИнвестиционныйФонд",		РеквизитыОперации.ПаевойИнвестиционныйФонд);
	Запрос.УстановитьПараметр("Заявка",							РеквизитыОперации.Заявка);	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	РеквизитыОперации.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("КонецПериодаГраница",			Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ТекущаяДата",					ТекущаяДатаСеанса());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	МассивОпераций = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		Операция = Новый Структура(); 
				
		Операция.Вставить("account",	Выборка.НомерСчета);													//Лицевой счет клиента в реестре фонда
		Операция.Вставить("all",		Выборка.СуммаОперации);													//Сумма операции
		Операция.Вставить("base",		СокрЛП(Выборка.НомерЗаявки));											//Основание операции
		Операция.Вставить("cost",		Выборка.СтоимостьНаКонецДня);											//Блок оценочной стоимости остатка паев
		Операция.Вставить("date",		Формат(РеквизитыОперации.ДатаДокумента, "ДФ=dd.MM.yyyy"));				//Дата операции
		Операция.Вставить("fund",		Выборка.КодПифа);														//Идентификатор фонда
		Операция.Вставить("id",			НомерДокумента);														//Номер операции
		Операция.Вставить("mark",		Выборка.СуммаНадбавкиСкидки);											//сумма скидки/надбавки
		Операция.Вставить("num",		Выборка.КолвоОборот);													//количество паев по операции
		Операция.Вставить("points",		0);																		//Бонусные баллы по операции
		Операция.Вставить("quantity",	Выборка.ОстатокПаевНаКонецДня);											//Количество паев на конец дня. для всех операций в течение дня должно быть одинаковое значение
		Операция.Вставить("restin",		Выборка.КолвоДоОперации);												//Остаток паев до проведения операции
		Операция.Вставить("restout",	Выборка.КолвоПослеОперации);											//Количество паев после операции
		Операция.Вставить("sumall",		Выборка.СуммаОперации - Выборка.СуммаНадбавкиСкидки - Выборка.НДФЛ);	//Сумма приобретения/погашения паев (включая комиссии) 
		Операция.Вставить("tax",		Выборка.НДФЛ);															//Налог (НДФЛ)
		Операция.Вставить("type",		
			?(ТипЗнч(ОперацияПоПаям) = Тип("ДокументСсылка.ЗачислениеПаев"), 1, 2));							//1 - Приобретение (зачисление) паев, 2 - Погашение (списание) паев		
		Операция.Вставить("user",		Выборка.КодПайщика);													//Код пайщика (pifs_portfolio_code)
		Операция.Вставить("value",		Выборка.СтоимостьПая);													//Стоимость пая на отчётную дату, предшествующую операции
		
		МассивОпераций.Добавить(Операция);
	
	КонецЦикла; 
	
	СтруктураЗапроса = Новый Структура("data", МассивОпераций);
	
	ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);

	ТекстСообщения = "Не удалось выполнить запрос.";

	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office/portfolio/import?import_type=pifs_operations_data", ТелоЗапроса, ТекстСообщения);
	
	Если HTTPОтвет = Неопределено Тогда
		ЗафиксироватьСообщение(ТекстСообщения,, Отказ);
	Иначе
		ЗафиксироватьСообщение("Выгружены данные о зачислении паев", Ложь);
	КонецЕсли; 
	
	//отработать ошибки: расхождение остатков, отсутствие кодов, объектов
	//схлопнуть остатки на начало дня и на конец дня в разрезе лицевого счета (без операций) для сверки и для заполнения реквизита "quantity"
		
КонецПроцедуры

Процедура ВыгрузитьВводыДенежныхСредств(ТекВводДС = Неопределено, Отказ = Ложь) Экспорт
	
	Если ЗначениеЗаполнено(ТекВводДС) Тогда
		ЭтотОбъект.Дата = НачалоДня(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекВводДС, "Дата"));
	КонецЕсли;	
		
	ПараметрыПодключения = ПолучитьПараметрыПодключения(); 
	
	// Суммы нужно выгружать в копейках, т. е. умножать на 100
	Запрос = Новый Запрос;
	
#Область Текст_запроса

	Запрос.Текст =  
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ПОМЕСТИТЬ _КодыЕсиаФинанс
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&КонецПериода,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЗаявкиПайщиков))) КАК КодыВоВнешнихСистемахСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КодыПайщиков.Код КАК user_id,
		|	ВводДенежныхСредств.СтрокаБанковскойВыписки.Номер КАК order_id,
		|	ВводДенежныхСредств.Сумма * 100 КАК amount,
		|	ВводДенежныхСредств.Сумма * 100 КАК amount_no_commission,
		|	""approved"" КАК status,
		|	ВводДенежныхСредств.СтрокаБанковскойВыписки.ДатаПлатежногоДокумента КАК date,
		|	ВводДенежныхСредств.СтрокаБанковскойВыписки.НазначениеПлатежа КАК description,
		|	""643"" КАК currency,
		|	""transfer"" КАК pay_type,
		|	_КодыЗаявок.Код КАК owner_id,
		|	""Claim"" КАК owner_type,
		|	ВводДенежныхСредств.Дата КАК uk_date,
		|	""purchase"" КАК operation_type
		|ИЗ
		|	Документ.ВводДенежныхСредств КАК ВводДенежныхСредств
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КодыЕсиаФинанс КАК _КодыЗаявок
		|		ПО ВводДенежныхСредств.Основание = _КодыЗаявок.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыЕсиаФинанс КАК _КодыПайщиков
		|		ПО ВводДенежныхСредств.Основание.Пайщик = _КодыПайщиков.Объект
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ВводДенежныхСредств <> НЕОПРЕДЕЛЕНО
		|				ТОГДА ВводДенежныхСредств.Ссылка = &ВводДенежныхСредств
		|			ИНАЧЕ ВводДенежныхСредств.Организация = &Организация
		|					И (ВводДенежныхСредств.Дата МЕЖДУ &НачалоПериода И &КонецПериода)
		|					И ВводДенежныхСредств.Проведен
		|		КОНЕЦ";
		
#КонецОбласти	

	Запрос.УстановитьПараметр("НачалоПериода",			НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("КонецПериода",			КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("Организация",			ЭтотОбъект.Организация); 
	Запрос.УстановитьПараметр("ВводДенежныхСредств",	ТекВводДС);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	КолонкиРезультата = РезультатЗапроса.Колонки;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	МассивОпераций = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		Операция = Новый Структура(); 
		
		Для Каждого Колонка Из КолонкиРезультата Цикл			
			Операция.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
		КонецЦикла;
		
		МассивОпераций.Добавить(Операция);
	
	КонецЦикла; 
		
	Если МассивОпераций.Количество() = 1 Тогда
		ТелоЗапроса = ПолучитьСтрокуJSON(МассивОпераций[0]);
	Иначе
		ТелоЗапроса = ПолучитьСтрокуJSON(МассивОпераций);		
	КонецЕсли;	
	
	ТекстСообщения = "Не удалось выполнить запрос.";

	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office/payments", ТелоЗапроса, ТекстСообщения);
	
	Если HTTPОтвет = Неопределено Тогда
		ЗафиксироватьСообщение(ТекстСообщения,, Отказ);
	Иначе
		ЗафиксироватьСообщение("Выгружены данные о вводе денежных средств", Ложь);
	КонецЕсли; 
			
КонецПроцедуры

Процедура СверитьОстаткиПаев()
	
	ПараметрыПодключения = ПолучитьПараметрыПодключения(); 

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды) КАК ЭтоПиф,
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _КодыЕсиаФинанс
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды))) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Дата, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО КодыВоВнешнихСистемахСрезПоследних.Объект = КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОстаткиЦенныхБумагОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	_КодыПифовЕсиаФинанс.Код КАК КодПифа,
		|	_КодыКлиентовЕсиаФинанс.Код КАК КодКлиента
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|			&Дата,
		|			Организация = &Организация
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_КодыЕсиаФинанс.СчетДоверительногоУправления
		|					ИЗ
		|						_КодыЕсиаФинанс КАК _КодыЕсиаФинанс
		|					ГДЕ
		|						НЕ _КодыЕсиаФинанс.СчетДоверительногоУправления ЕСТЬ NULL)
		|				И ВЫРАЗИТЬ(ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд В
		|					(ВЫБРАТЬ
		|						_КодыЕсиаФинанс.Объект
		|					ИЗ
		|						_КодыЕсиаФинанс КАК _КодыЕсиаФинанс
		|					ГДЕ
		|						_КодыЕсиаФинанс.ЭтоПиф)) КАК ОстаткиЦенныхБумагОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыЕсиаФинанс КАК _КодыПифовЕсиаФинанс
		|		ПО (ВЫРАЗИТЬ(ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = _КодыПифовЕсиаФинанс.Объект)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыЕсиаФинанс КАК _КодыКлиентовЕсиаФинанс
		|		ПО ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления = _КодыКлиентовЕсиаФинанс.СчетДоверительногоУправления";
	Запрос.УстановитьПараметр("Дата", ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация); 
	
	Результат = Запрос.Выполнить();
	
	ВыборкаКодов = Запрос.МенеджерВременныхТаблиц.Таблицы["_КодыЕсиаФинанс"]. ПолучитьДанные().Выбрать();
	
	КодыСтр = "";
	
	Пока ВыборкаКодов.Следующий() Цикл	
		КодыСтр = КодыСтр + ?(КодыСтр = "", "?", "&") + "ids%5B%5D=" + ВыборкаКодов.Код; 	
	КонецЦикла; 
	
	Если ЗначениеЗаполнено(КодыСтр) Тогда
		
		ТекстСообщения = "Не удалось получить остатки паев.";
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office/users/piece_balances" + КодыСтр,, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ЗафиксироватьСообщение(ТекстСообщения);
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

Процедура ВыгрузитьФайлы(ЗаявкаПайщика, АдресФайла, ИмяФайла, Описание = "", Отказ = Ложь) Экспорт 
	
	//Разрешенные: doc, docx, pdf, jpeg, jpg, png, tiff, tif, zip, 7z
	РеквизитыЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаявкаПайщика, "Дата, Пайщик");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыЗаявок.Код КАК КодЗаявки,
		|	КодыПайщиков.Код КАК КодПайщика
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&Дата,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЗаявкиПайщиков)
		|				И Объект = &ЗаявкаПайщика) КАК КодыЗаявок,
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&Дата,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица)
		|				И Объект = &Пайщик) КАК КодыПайщиков";
	
	Запрос.УстановитьПараметр("ЗаявкаПайщика",	ЗаявкаПайщика);
	Запрос.УстановитьПараметр("Дата",			РеквизитыЗаявки.Дата);	
	Запрос.УстановитьПараметр("Пайщик",			РеквизитыЗаявки.Пайщик);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда	
		
		Разделитель = СтрЗаменить(Новый УникальныйИдентификатор(), "_", "");
	
		ТекПоток = Новый ПотокВПамяти();
		
		ЗаписьДанных = Новый ЗаписьДанных(ТекПоток,,, Символы.ВК + Символы.ПС, ""); 
		
		Если ПустаяСтрока(Описание) Тогда
			Описание = "Подтверждение от спецдепозитария от " + Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy");
		КонецЕсли;
				
		ДобавитьЗначениеПараметра(ЗаписьДанных, Разделитель, """attachment[body]""; filename=""" + ИмяФайла + """", ПолучитьИзВременногоХранилища(АдресФайла));
	    ДобавитьЗначениеПараметра(ЗаписьДанных, Разделитель, """attachment[description]""", Описание); //описание 
		ДобавитьЗначениеПараметра(ЗаписьДанных, Разделитель, """attachment[by]""", "backoffice"); //Кем загружен файл
		ДобавитьЗначениеПараметра(ЗаписьДанных, Разделитель, """attachment[state]""", "visible"); //Статус файла "Доступно для клиента", значение по умолчанию
	   	ДобавитьЗначениеПараметра(ЗаписьДанных, Разделитель, """attachment[attachmentable_id]""", Выборка.КодЗаявки); //ид заявки 
		ДобавитьЗначениеПараметра(ЗаписьДанных, Разделитель, """attachment[attachmentable_type]""", "Claim"); //Признак владельца файла(owner_id) - заявка. Пока все подгружаем к заявкам
	    ДобавитьЗначениеПараметра(ЗаписьДанных, Разделитель, """attachment[kind]""", "pifs_sd_notifications_succeed"); //тип документа - Уведомление об операции по лицевому счету
		
		ДобавитьЗначениеПараметра(ЗаписьДанных, Разделитель, """attachment[wait_for_sign]""", "false"); //ожидает подписи клиента
		//Если устанавливаем параметр wait_for_sign = false, необходимо указывать ид пользователя
		ДобавитьЗначениеПараметра(ЗаписьДанных, Разделитель, """attachment[uploader_id]""", Выборка.КодПайщика); //ид пользователя
	 
		ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель + "--");
		ЗаписьДанных.ЗаписатьСтроку("");
		
		ЗаписьДанных.Закрыть();
		
		ТекТелоЗапроса = ТекПоток.ЗакрытьИПолучитьДвоичныеДанные();
		
		ПараметрыПодключения = ПолучитьПараметрыПодключения("multipart/form-data; boundary=" + Разделитель);
		
		ТекстОшибки = "Не удалось выполнить запрос."; 
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office/attachments", ТекТелоЗапроса, ТекстОшибки, 1); 
		
		Если HTTPОтвет = Неопределено Тогда
			ЗафиксироватьСообщение(ТекстОшибки,, Отказ);
		Иначе
			МассивСтрок = СтрРазделить(ИмяФайла, "\");			
			ЗафиксироватьСообщение("К операции [" + ЗаявкаПайщика + "] загружен файл [" + МассивСтрок[МассивСтрок.Количество()-1] + "]", Ложь);	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЭкспортСпискаДляПроверки(ТипСписка, АдресФайла, ИмяФайла, Отказ = Ложь) Экспорт 
	
	МассивСтрок = СтрРазделить(ИмяФайла, "\");
	ТекИмяФайла = МассивСтрок[МассивСтрок.Количество()-1];
		
	Разделитель = СтрЗаменить(Новый УникальныйИдентификатор(), "-", "");

	ПотокЗаписиТелаЗапроса = Новый ПотокВПамяти();
	ЗаписьТелаЗапроса = Новый ЗаписьДанных(ПотокЗаписиТелаЗапроса);
	ДобавитьЗначениеПараметра(ЗаписьТелаЗапроса, Разделитель, """body""; filename=""" + ТекИмяФайла + """", ПолучитьИзВременногоХранилища(АдресФайла));
 
	ЗаписьТелаЗапроса.ЗаписатьСтроку("" + Символы.ПС); //"особенная" строка, из-за отсутствия символа ПС не загружались файлы, при этом запрос возвращал код 200 ОК.
	
	ЗаписьТелаЗапроса.ЗаписатьСтроку("--" + Разделитель + "--");
	ЗаписьТелаЗапроса.Закрыть(); 
	
	ТекТелоЗапроса = ПотокЗаписиТелаЗапроса.ЗакрытьИПолучитьДвоичныеДанные();
	
	ПараметрыПодключения = ПолучитьПараметрыПодключения("multipart/form-data; boundary=" + Разделитель);  

	ТекстОшибки = "Не удалось выполнить запрос.";
	
	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office/upload_database?database%5Bkind%5D=" + ТипСписка, ТекТелоЗапроса, ТекстОшибки, 1);

    Если HTTPОтвет = Неопределено Тогда
		ЗафиксироватьСообщение(ТекстОшибки);
		Отказ = Истина;
	Иначе
		ОтветОбъект = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
		ЗафиксироватьСообщение("Загружен файл со списком [" + ТекИмяФайла + "]. Статус загрузки [success = " + ОтветОбъект["success"] + "], описание статуса [" + ОтветОбъект["status_str"] + "].", Ложь);	
	КонецЕсли;

КонецПроцедуры

Процедура ИмпортироватьЗаявкиПайщиков(ВидЗаявки = Неопределено) Экспорт
	
	ПараметрыПодключения = ПолучитьПараметрыПодключения(); 
	
	ТабЗаявкиПайщиков = СформироватьТаблицуПриемник("ЗаявкиПайщиков"); 
	
	ПараметрыЗаявок = Новый Структура("Статус, ТипВладельца, ВидЗаявки", "in_queue", "Fund");
	
	Если ВидЗаявки = Неопределено Тогда	// получаем данные по всем видам заявок
		
		МассивВидов = РаботаСКоллекциями.ЗначенияВМассив("pifs_purchase", "pifs_selling", "pifs_exchange");
		
		Для Каждого ТекВидЗаявки Из МассивВидов Цикл
			ПараметрыЗаявок.ВидЗаявки = ТекВидЗаявки;
			ДесериализоватьДанныеЗаявокЕсиа(ПараметрыЗаявок, ТабЗаявкиПайщиков, ПараметрыПодключения);
		КонецЦикла;

	Иначе
		ПараметрыЗаявок.ВидЗаявки = ПреобразоватьВидЗаявки(ВидЗаявки); 
		ДесериализоватьДанныеЗаявокЕсиа(ПараметрыЗаявок, ТабЗаявкиПайщиков, ПараметрыПодключения);
	КонецЕсли;
	
	Если ТабЗаявкиПайщиков.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область Текст_запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаявкиПайщиков.Идентификатор КАК Идентификатор,
		|	ЗаявкиПайщиков.ВидЗаявки КАК ВидЗаявки,
		|	ЗаявкиПайщиков.Статус КАК Статус,
		|	ЗаявкиПайщиков.ИдентификаторПользователя КАК ИдентификаторПользователя,
		|	ЗаявкиПайщиков.НомерЗаявки КАК НомерЗаявки,
		|	ЗаявкиПайщиков.ДатаЗаявки КАК ДатаЗаявки,
		|	ЗаявкиПайщиков.ИдентификаторАктива КАК ИдентификаторАктива,
		|	ЗаявкиПайщиков.ИдентификаторАктиваДляОбмена КАК ИдентификаторАктиваДляОбмена,
		|	ЗаявкиПайщиков.Сумма КАК Сумма,
		|	ЗаявкиПайщиков.ИдентификаторРасчетногоСчета КАК ИдентификаторРасчетногоСчета,
		|	ЗаявкиПайщиков.Количество КАК Количество,
		|	ЗаявкиПайщиков.Многократная КАК Многократная,
		|	ЗаявкиПайщиков.НомерСчетаДепо КАК НомерСчетаДепо,
		|	ЗаявкиПайщиков.НомерСчетаДепоДляОбмена КАК НомерСчетаДепоДляОбмена,
		|	ЗаявкиПайщиков.ОткрытьЗакрытьДепозитарныйСчет КАК ОткрытьЗакрытьДепозитарныйСчет,
		|	ЗаявкиПайщиков.ОткрытьДепозитарныйСчетДляОбмена КАК ОткрытьДепозитарныйСчетДляОбмена,
		|	ЗаявкиПайщиков.ПЭП_НомерТелефона КАК ПЭП_НомерТелефона,
		|	ЗаявкиПайщиков.ПЭП_Код КАК ПЭП_Код,
		|	ЗаявкиПайщиков.ПЭП_ДатаВремяПодписи КАК ПЭП_ДатаВремяПодписи,
		|	ЗаявкиПайщиков.НомерЗаявкиНаПриобретение КАК НомерЗаявкиНаПриобретение,
		|	ЗаявкиПайщиков.ЕстьОшибкиДанных КАК ЕстьОшибкиДанных
		|ПОМЕСТИТЬ _ДанныеЗаявок
		|ИЗ
		|	&ЗаявкиПайщиков КАК ЗаявкиПайщиков
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.ГруппаОбъектов КАК ГруппаОбъектов,
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ПОМЕСТИТЬ _КодыВоВнешнихСистемах
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЗаявкиПайщиков), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.АнкетыФизическихЛиц), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.БанковскиеСчета))) КАК КодыВоВнешнихСистемахСрезПоследних
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеЗаявок.НомерЗаявки КАК НомерЗаявки,
		|	_ДанныеЗаявок.Идентификатор КАК Идентификатор,
		|	_ДанныеЗаявок.ИдентификаторПользователя КАК ИдентификаторПользователя,
		|	_ДанныеЗаявок.ИдентификаторАктива КАК ИдентификаторАктива,
		|	_ДанныеЗаявок.ИдентификаторАктиваДляОбмена КАК ИдентификаторАктиваДляОбмена,
		|	_КодыЗаявок.Объект КАК ЗаявкаПайщика,
		|	ВЫРАЗИТЬ(_КодыЗаявок.Объект КАК Документ.ЗаявкаПайщика).ВидЗаявки КАК ВидЗаявки,
		|	_КодыПайщиков.Объект КАК Пайщик,
		|	_КодыПифов.Объект КАК Пиф,
		|	_КодыПифовДляОбмена.Объект КАК ПифДляОбмена,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Регистратор КАК Анкета,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Период КАК ДатаАнкетныхДанных
		|ПОМЕСТИТЬ _ОбъектыУчетнойСистемы
		|ИЗ
		|	_ДанныеЗаявок КАК _ДанныеЗаявок
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВоВнешнихСистемах КАК _КодыЗаявок
		|		ПО _ДанныеЗаявок.Идентификатор = _КодыЗаявок.Код
		|			И (_КодыЗаявок.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЗаявкиПайщиков))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВоВнешнихСистемах КАК _КодыПайщиков
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|					&ДатаКонецДня,
		|					Организация = &Организация
		|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|						И ЮрФизЛицо В
		|							(ВЫБРАТЬ
		|								_КодыПайщиков.Объект
		|							ИЗ
		|								_КодыВоВнешнихСистемах КАК _КодыПайщиков
		|							ГДЕ
		|								_КодыПайщиков.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица))) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|			ПО _КодыПайщиков.Объект = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|		ПО _ДанныеЗаявок.ИдентификаторПользователя = _КодыПайщиков.Код
		|			И (_КодыПайщиков.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВоВнешнихСистемах КАК _КодыПифов
		|		ПО _ДанныеЗаявок.ИдентификаторАктива = _КодыПифов.Код
		|			И (_КодыПифов.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВоВнешнихСистемах КАК _КодыПифовДляОбмена
