Функция ПолучитьЗначенияРеквизитовАнкетыПользователя(ДанныеЕсиа, ПараметрыПодключения, СтрокаТаблицыАнкет) 
	
	ДанныеДляОпределенияСсылок = Новый Структура();
	АнкетныеДанные = Новый Структура;
			
	Если Не ДанныеЕсиа.Свойство("person_info") Тогда
		ЗафиксироватьСообщение("Не удалось получить данные физ. лица по идентификатору ЕСИА.Финанс [" + ДанныеЕсиа.id + "]");
		Возврат Неопределено;
	КонецЕсли; 
	
	Если Не (ДанныеЕсиа.Свойство("fill_stage") И (ДанныеЕсиа.fill_stage = "registration" Или ДанныеЕсиа.fill_stage = "active" Или ДанныеЕсиа.fill_stage = "filled" Или ДанныеЕсиа.fill_stage = "claim")) Тогда
		ЗафиксироватьСообщение("Текущий статус пользователя ЕСИА.Финанс [" + ?(ДанныеЕсиа.Свойство("fill_stage"), ДанныеЕсиа.fill_stage, "нет статуса") + "], [id пользователя " + ДанныеЕсиа.id + "]. Анкета не будет загружена.");
		Возврат Неопределено;	
	КонецЕсли;
	// по умолчанию идентификация происходит по СМЭВ
	Если Не (ДанныеЕсиа.Свойство("identification_type") И ДанныеЕсиа.identification_type = "smev") Тогда
		ЗафиксироватьСообщение("Данные пользователя ЕСИА.Финанс не прошли первичную идентификацию [identification_type = " 
			+ ?(ДанныеЕсиа.Свойство("identification_type"), ДанныеЕсиа.identification_type, "отсутствует значение") + "], [id пользователя " + ДанныеЕсиа.id + "]. Анкета не будет загружена.");
		Возврат Неопределено;	
	КонецЕсли;
	
	ФизЛицо = ДанныеЕсиа.person_info; 
	
	Если Не (ФизЛицо.Свойство("is_actual") И ФизЛицо.is_actual) Тогда
		ЗафиксироватьСообщение("Данные пользователя ЕСИА.Финанс не актуальны [id пользователя " + ДанныеЕсиа.id + "]. Анкета не будет загружена.");
		Возврат Неопределено;	
	КонецЕсли;
	
	Если Не (ФизЛицо.Свойство("actuality_updated_at") И ЗначениеЗаполнено(ФизЛицо.actuality_updated_at)) Тогда 
		ЗафиксироватьСообщение("В данных пользователя ЕСИА.Финанс [id пользователя " + ДанныеЕсиа.id + "] отсутствует дата актуальности. Анкета не будет загружена.");
		Возврат Неопределено;
	КонецЕсли;
				
	Если Не ФизЛицо.Свойство("document") Тогда
		ЗафиксироватьСообщение("Не удалось получить данные удостоверения личности физ. лица [id пользователя ЕСИА.Финанс " + ДанныеЕсиа.id + "]");
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ДанныеЕсиа.Свойство("checks") Тогда
		ЗафиксироватьСообщение("Анкета пользователя не прошла проверку на стороне ЕСИА.Финанс [id пользователя " + ДанныеЕсиа.id + "]. Данные не будут загружены.");
		Возврат Неопределено;
	КонецЕсли; 
	
	РезультатыПроверок = ДанныеЕсиа.checks; 
	
	// ##Здесь вопрос, будут ли эти поддтверждения в ЛКК
	Если Не РезультатыПроверок.Свойство("is_valid_info") Или Не РезультатыПроверок.is_valid_info Тогда
		ЗафиксироватьСообщение("Данные пользователя не подтверждены менеджером [id пользователя ЕСИА.Финанс " + ДанныеЕсиа.id + "]. Анкета не будет загружена.");
		Возврат Неопределено;	
	КонецЕсли;
	
	Если Не (РезультатыПроверок.Свойство("no_pi_change_claim") И РезультатыПроверок.no_pi_change_claim) Тогда
		ЗафиксироватьСообщение("У пользователя есть неподтвержденные заявки на изменение личных данных [id пользователя ЕСИА.Финанс " + ДанныеЕсиа.id + "]. Анкета не будет загружена.");
		Возврат Неопределено;	
	КонецЕсли;
		
	//проверяем подписи анкет
	Если СтрокаТаблицыАнкет.ПоЗаявкеНаИзмениеПерсональныхДанных Тогда
		
		Для Каждого ТекВложение Из СтрокаТаблицыАнкет.attachments Цикл
			
			Если ТекВложение.kind = "change_anket_data" И ТекВложение.Свойство("client_sign") Тогда
				
				Если ПодписьВалидна(ТекВложение.client_sign) Тогда 
					
					Если СтрНачинаетсяС(ТекВложение.description, "Согласие ОПД") Тогда
				    	АнкетныеДанные.Вставить("СогласиеНаПередачуИнформации", Истина);
				    КонецЕсли;
				
				Иначе
					
					ЗафиксироватьСообщение("Не удалось получить данные физ. лица по идентификатору ЕСИА.Финанс [" + ДанныеЕсиа.id + "]."
						+ "Отсутствует подпись документа [" + ТекВложение.description + "]");
					Возврат Неопределено;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		АнкетныеДанные.Вставить("МассивФайлов", ПолучитьМассивФайлов(СтрокаТаблицыАнкет.attachments, ПараметрыПодключения));
		
	ИначеЕсли ФизЛицо.Свойство("attachments") Тогда 
		
		Для Каждого ТекВложение Из ФизЛицо.attachments Цикл
			
			Если ТекВложение.kind = "anket_data" И ТекВложение.Свойство("client_sign") Тогда
				
				Если ПодписьВалидна(ТекВложение.client_sign) Тогда 
					
					Если СтрНачинаетсяС(ТекВложение.description, "Согласие ОПД") Тогда
				    	АнкетныеДанные.Вставить("СогласиеНаПередачуИнформации", Истина);
				    КонецЕсли;
				
				Иначе
					
					ЗафиксироватьСообщение("Не удалось получить данные физ. лица по идентификатору ЕСИА.Финанс [" + ДанныеЕсиа.id + "]."
						+ "Отсутствует подпись документа [" + ТекВложение.description + "]");
					Возврат Неопределено;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла; 
				
		АнкетныеДанные.Вставить("МассивФайлов", ПолучитьМассивФайлов(ФизЛицо.attachments, ПараметрыПодключения));
				
	КонецЕсли;
	
	ДанныеДляОпределенияСсылок.Вставить("ДатаАктуальности",
				?(СтрокаТаблицыАнкет.ПоЗаявкеНаИзмениеПерсональныхДанных,
					ЭтотОбъект.Дата,
					ПолучитьДату(ФизЛицо.actuality_updated_at)));
					
	ДанныеДляОпределенияСсылок.Вставить("Фамилия", ФизЛицо.surname);
	ДанныеДляОпределенияСсылок.Вставить("Имя", ФизЛицо.name);
    ДанныеДляОпределенияСсылок.Вставить("Отчество", ФизЛицо.patronymic);
	ДанныеДляОпределенияСсылок.Вставить("ИНН", ФизЛицо.inn);
	СНИЛС = ФизЛицо.snils;
	
	Если СтрДлина(СНИЛС) = 11 Тогда
		СНИЛС = Лев(СНИЛС, 3) + "-" + Сред(СНИЛС, 4, 3) + "-" + Сред(СНИЛС, 7, 3) + " " + Прав(СНИЛС, 2);
	КонецЕсли;
	
	ДанныеДляОпределенияСсылок.Вставить("СНИЛС", СНИЛС);
	ДанныеДляОпределенияСсылок.Вставить("ДатаРождения", ПолучитьДату(ФизЛицо.birthday));
	ДанныеДляОпределенияСсылок.Вставить("ГражданствоСтр", ВРег(ФизЛицо.nationality));
	
	АнкетныеДанные.Вставить("МестоРождения", ФизЛицо.birth_place);
	АнкетныеДанные.Вставить("Пол", ?(ФизЛицо.male, Перечисления.ПолФизическогоЛица.Мужской, Перечисления.ПолФизическогоЛица.Женский));
	АнкетныеДанные.Вставить("РезидентРФ", ФизЛицо.Свойство("is_rf_resident") И ФизЛицо.is_rf_resident);

	//Заполним позже одним запросом для всех клиентов
	//АнкетныеДанные.Вставить("Гражданство", Неопределено);
	АнкетныеДанные.Вставить("ВтороеГражданство", Новый Массив);
	АнкетныеДанные.Вставить("НалоговыйРезидентИностранногоГосударстваГосударство", Новый Массив);
	АнкетныеДанные.Вставить("ИностранныйНалогоплательщикГосударство", Новый Массив); 
	//------------------------------------------------

	Если ФизЛицо.is_additional_nationatilies Тогда
		
		ДанныеДляОпределенияСсылок.Вставить("ДопГражданстваСтр", "");
		
		Для Каждого ДопГражданство Из ФизЛицо.additional_nationatilies_items Цикл
			ДанныеДляОпределенияСсылок.ДопГражданстваСтр = ДанныеДляОпределенияСсылок.ДопГражданстваСтр + ВРег(ДопГражданство.country);	
		КонецЦикла;
		
	КонецЕсли;
	
	Если ФизЛицо.Свойство("tax_status_in_foreign") И ФизЛицо.tax_status_in_foreign Тогда
		
		ДанныеДляОпределенияСсылок.Вставить("РезиденстваСтр", "");
		
		Для Каждого Резиденство Из ФизЛицо.tax_status_foreign_items Цикл
			ДанныеДляОпределенияСсылок.РезиденстваСтр = ДанныеДляОпределенияСсылок.РезиденстваСтр + ВРег(Резиденство.country);	
		КонецЦикла;	
		
		АнкетныеДанные.Вставить("НалоговыйРезидентИностранногоГосударства", Истина); 
		
	КонецЕсли;
		
	ДокументФизЛица = ФизЛицо.document;
	
	ДанныеДляОпределенияСсылок.Вставить("ВидДокументаСтр", ДокументФизЛица.kind); 
	ДанныеДляОпределенияСсылок.Вставить("КодСтраныВыдачиДокумента", ВРег(ДокументФизЛица.country_code)); 
	//Заполним позже одним запросом для всех клиентов
	//АнкетныеДанные.Вставить("ВидУдостоверенияЛичности", Неопределено);
	//АнкетныеДанные.Вставить("СтранаВыдачиДокумента", Неопределено);
	//-----------------------------------------------
	//Реквизиты.КодАнкеты = СокрЛП(ДокументФизЛица.series) + " " + ДокументФизЛица.number;
	ДанныеДляОпределенияСсылок.Вставить("СерияУдостоверенияЛичности", ДокументФизЛица.series);
	ДанныеДляОпределенияСсылок.Вставить("НомерУдостоверенияЛичности", ДокументФизЛица.number);
	АнкетныеДанные.Вставить("ДатаВыдачиУдостоверенияЛичности", ПолучитьДату(ДокументФизЛица.issue_date));
	АнкетныеДанные.Вставить("ДатаОкончанияДействияУдостоверенияЛичности", ПолучитьДату(ДокументФизЛица.expiration_date));
	АнкетныеДанные.Вставить("ОрганВыдавшийУдостоверениеЛичности", ДокументФизЛица.issuer);
    АнкетныеДанные.Вставить("КодОрганаВыдавшегоУдостоверениеЛичности", ДокументФизЛица.issuer_code);
	
	ДанныеДляОпределенияСсылок.Вставить("ДатаВыдачиУдостоверенияЛичности",			АнкетныеДанные.ДатаВыдачиУдостоверенияЛичности);
	ДанныеДляОпределенияСсылок.Вставить("ОрганВыдавшийУдостоверениеЛичности",		ДокументФизЛица.issuer);
	ДанныеДляОпределенияСсылок.Вставить("КодОрганаВыдавшегоУдостоверениеЛичности",	ДокументФизЛица.issuer_code);
	
	Если РезультатыПроверок.Свойство("expired_passports") 
		И РезультатыПроверок.expired_passports <> Неопределено И РезультатыПроверок.expired_passports.status = "Пройдена успешно" Тогда 
		
		АнкетныеДанные.Вставить("СтатусПроверки", Перечисления.СтатусыПроверкиУдостоверенияЛичности.Действителен);
		
	Иначе
		АнкетныеДанные.Вставить("СтатусПроверки", Перечисления.СтатусыПроверкиУдостоверенияЛичности.НеПроверен);	
	КонецЕсли;
	
	АнкетныеДанные.Вставить("ПроверенПоПеречнюТеррористов", 
						(РезультатыПроверок.Свойство("possible_terrorists") И РезультатыПроверок.possible_terrorists <> Неопределено
						И РезультатыПроверок.possible_terrorists.status = "Пройдена успешно"));

	АнкетныеДанные.Вставить("ПроверенПоПеречнюСБООН", 
						(РезультатыПроверок.Свойство("uns") И РезультатыПроверок.uns <> Неопределено
						И РезультатыПроверок.uns.status = "Пройдена успешно"));

	АнкетныеДанные.Вставить("ПроверенПоСпискамРешенийМВК", 
						(РезультатыПроверок.Свойство("frozen_assets") И РезультатыПроверок.frozen_assets <> Неопределено
						И РезультатыПроверок.frozen_assets.status = "Пройдена успешно"));
						
	АнкетныеДанные.Вставить("ПроверенПоБазеОтказовПо764П", 
						(РезультатыПроверок.Свойство("operation_cancels") И РезультатыПроверок.operation_cancels <> Неопределено
						И РезультатыПроверок.operation_cancels.status = "Пройдена успешно"));					
				
	АнкетныеДанные.Вставить("ВысокийУровеньРиска", ДанныеЕсиа.Свойство("risk_level") И ДанныеЕсиа.risk_level = "high");
	
	// Для низкого уровня риска добавляем пояснение
	Если Не АнкетныеДанные.ВысокийУровеньРиска Тогда
		АнкетныеДанные.Вставить("ОбоснованиеУровняРиска", "факторы высокого уровня риска не установлены");
	КонецЕсли;
	
	Если ФизЛицо.Свойство("addresses") Тогда 
		
		Адреса = ФизЛицо.addresses;
		
		АдресРегистрации		= "";
		АдресРегистрацииФИАС	= "";
		
		Если Адреса.Свойство("main") И Адреса.main.Свойство("full") Тогда
			АдресРегистрации = ПрочитатьАдрес(Адреса.main);
			
			Если Адреса.main.as_kladr Тогда	
				АдресРегистрацииФИАС = ПрочитатьАдресФИАС(Адреса.main);
			КонецЕсли;			
		Конецесли;
		
		АнкетныеДанные.Вставить("АдресРегистрации", АдресРегистрации);
		АнкетныеДанные.Вставить("АдресРегистрацииФИАС", АдресРегистрацииФИАС);
		
		Если Адреса.Свойство("residential") И Адреса.residential.Свойство("is_active") И Адреса.residential.is_active Тогда
			АнкетныеДанные.Вставить("АдресМестаЖительства", ПрочитатьАдрес(Адреса.residential));
			
			Если Адреса.residential.as_kladr Тогда
				АнкетныеДанные.Вставить("АдресМестаЖительстваФИАС", ПрочитатьАдресФИАС(Адреса.residential));
			КонецЕсли;
		Иначе
			АнкетныеДанные.Вставить("АдресМестаЖительства", АдресРегистрации);			
			АнкетныеДанные.Вставить("АдресМестаЖительстваФИАС", АдресРегистрацииФИАС);
		Конецесли;
		
		Если Адреса.Свойство("for_corresp") И Адреса.for_corresp.Свойство("is_active") И Адреса.for_corresp.is_active Тогда
			АнкетныеДанные.Вставить("ПочтовыйАдрес", ПрочитатьАдрес(Адреса.for_corresp));
			
			Если Адреса.for_corresp.as_kladr Тогда
				АнкетныеДанные.Вставить("ПочтовыйАдресФИАС", ПрочитатьАдресФИАС(Адреса.for_corresp));
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли; 
	
	АнкетныеДанные.Вставить("EMail", ФизЛицо.contact_email); 
		
	// В ближайшем релизе ЕСИА.Финанс появится новое поле main_phone_full_str
	Если ФизЛицо.Свойство("main_phone_full_str") Тогда
		АнкетныеДанные.Вставить("Телефоны",				ФизЛицо.main_phone_full_str);
		АнкетныеДанные.Вставить("ТелефонДляОповещения",	ФизЛицо.main_phone_full_str);
	Иначе	
		// Код страны телефона пока отсутствует - хардкод
		АнкетныеДанные.Вставить("Телефоны",				"7" + ФизЛицо.main_phone);
		АнкетныеДанные.Вставить("ТелефонДляОповещения",	"7" + ФизЛицо.main_phone);
	КонецЕсли;		
	
	ДанныеДляОпределенияСсылок.Вставить("Телефоны", АнкетныеДанные.Телефоны);
	
	ОписаниеПубличногоЛица = "";
	
	Если ФизЛицо.Свойство("is_russian_pub_person") И ФизЛицо.is_russian_pub_person Тогда	
		ОписаниеПубличногоЛица = ПолучиьОписаниеПубличногоЛица(ФизЛицо.irpp_name_organization, ФизЛицо.irpp_your_position, ФизЛицо.irpp_employer_address);	
	ИначеЕсли ФизЛицо.Свойство("is_person_of_intercity_organizations") И ФизЛицо.is_person_of_intercity_organizations Тогда
        ОписаниеПубличногоЛица = ПолучиьОписаниеПубличногоЛица(ФизЛицо.ipio_name_organization, ФизЛицо.ipio_your_position, ФизЛицо.ipio_employer_address);
	ИначеЕсли ФизЛицо.Свойство("is_foreign_pub_person") И ФизЛицо.is_foreign_pub_person Тогда
        ОписаниеПубличногоЛица = ПолучиьОписаниеПубличногоЛица(ФизЛицо.ifpp_name_organization, ФизЛицо.ifpp_your_position, ФизЛицо.ifpp_employer_address);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеПубличногоЛица) Тогда
		АнкетныеДанные.Вставить("ЯвляетсяПубличнымДолжностнымЛицом", Истина);
		АнкетныеДанные.Вставить("ЯвляетсяПубличнымДолжностнымЛицомОписание", ОписаниеПубличногоЛица); 
	КонецЕсли; 
	
	Если ФизЛицо.Свойство("is_bound_with_pub_person") И ФизЛицо.is_bound_with_pub_person Тогда
		АнкетныеДанные.Вставить("ЯвляетсяРодственникомПубличногоДолжностногоЛица", Истина);
		АнкетныеДанные.Вставить("ЯвляетсяРодственникомПубличногоДолжностногоЛицаОписание", ФизЛицо.kinship_status); 	
	КонецЕсли;
	
	Если ФизЛицо.Свойство("purpose_of_business") Тогда
		
		ОписаниеДругое = "";
		
		Для Каждого ТекЦель Из ФизЛицо.purpose_of_business Цикл
			
			Если ТекЦель = "pif_services" Тогда
				АнкетныеДанные.Вставить("ЦельПриобретениеПаев", Истина);	
			ИначеЕсли ТекЦель = "du_services" Тогда
				АнкетныеДанные.Вставить("ЦельДоверительноеУправление", Истина);
			ИначеЕсли ТекЦель = "bo_services" Тогда 
				ОписаниеДругое = ОписаниеДругое + ?(ЗначениеЗаполнено(ОписаниеДругое), ", ", "") + "брокерские услуги";
			ИначеЕсли ТекЦель = "depos_services" Тогда
				ОписаниеДругое = ОписаниеДругое + ?(ЗначениеЗаполнено(ОписаниеДругое), ", ", "") + "депозитарные услуги";
			//ИначеЕсли ТекЦель = "du_services" Тогда
			//	
			//	ОписаниеДругое = ОписаниеДругое + ?(ЗначениеЗаполнено(ОписаниеДругое), ", ", "") + 
			//		"услуги доверительного управления ценными бумагами, 
			//		|денежными средствами, предназначенными для совершения сделок с ценными бумагами 
			//		|и (или) заключения договоров, являющихся производными финансовыми инструментами";

			КонецЕсли;	
				
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ОписаниеДругое) Тогда
			АнкетныеДанные.Вставить("ЦельДругое", Истина);
			АнкетныеДанные.Вставить("ЦельДругоеОписание", ОписаниеДругое);
		КонецЕсли;
	
	КонецЕсли;
	
	АнкетныеДанные.Вставить("ЦелиДеятельности", ФизЛицо.purpose_of_activity_str);
	АнкетныеДанные.Вставить("ПоложительноеФинансовоеПоложение",  ФизЛицо.Свойство("financial_position") И ФизЛицо.financial_position = "positive");
	АнкетныеДанные.Вставить("ДеловаяРепутацияПоложительная",  ФизЛицо.Свойство("customer_reputation") И ФизЛицо.customer_reputation = "positive"); 
	АнкетныеДанные.Вставить("ИсточникиПроисхожденияДенежныхСредств", ФизЛицо.source_of_money_income_str);
	
	АнкетныеДанные.Вставить("РаспространениеЗаконодательстваСША", (ФизЛицо.Свойство("tax_status") И ФизЛицо.tax_status = "resident")); 
	
	Если ФизЛицо.Свойство("foreign_address") Тогда
		
		Если ФизЛицо.foreign_address = "usa" Тогда  
			АнкетныеДанные.Вставить("АдресФактическогоПроживанияВИностранномГосударстве", ФизЛицо.foreign_usa_address); 	
		ИначеЕсли  ФизЛицо.foreign_address = "foreign " Тогда	
			АнкетныеДанные.Вставить("АдресФактическогоПроживанияВИностранномГосударстве", ФизЛицо.foreign_address_foreign_items_str);	
		КонецЕсли;	
			
	КонецЕсли; 
	
	Если ФизЛицо.Свойство("source_of_money_income") Тогда
		
		ИсточникСтр = ""; 
		
		Для Каждого ИсточникДС Из ФизЛицо.source_of_money_income Цикл
			
			Если ИсточникДС = "personal" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), ", ", "") + "личные сбережения";
				
			ИначеЕсли ИсточникДС = "nrd_papers" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), ", ", "") + 
					"доход от операций с ценными бумагами и (или) иностранными финансовыми инструментами, не квалифицированными в соответствии с законодательством РФ в качестве ценных бумаг";	
				
			ИначеЕсли ИсточникДС = "bussiness" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), ", ", "") + 
					"доход от осуществления предпринимательской деятельности и (или) от участия в уставном (складочном) капитале коммерческой организации";
	
			ИначеЕсли ИсточникДС = "financial_instruments" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), ", ", "") + 
					"доход от операций с производными финансовыми инструментами"; 
				
			ИначеЕсли ИсточникДС = "inheritance" Тогда

				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), ", ", "") + 
					"получение наследства или активов по договору дарения";
				
			ИначеЕсли ИсточникДС = "credit" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), ", ", "") + "заем, кредит";
				
			ИначеЕсли ИсточникДС = "job" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), ", ", "") + 
					"доход по основному месту работы (включая доход от работы по совместительству)";
			ИначеЕсли ИсточникДС = "else" Тогда
				
				ИсточникСтр = ИсточникСтр + ?(ЗначениеЗаполнено(ИсточникСтр), ", ", "") + "иное";
				
			КонецЕсли;
			
		КонецЦикла;
		
		АнкетныеДанные.Вставить("ИсточникиПроисхожденияДенежныхСредств", ИсточникСтр);
	
	КонецЕсли;
			
	Возврат Новый Структура("АнкетныеДанные, ДанныеДляОпределенияСсылок", АнкетныеДанные, ДанныеДляОпределенияСсылок);
	
КонецФункции 

Функция ПолучитьЗначенияБанковскихРеквизитов(Приемник, ДанныеЕсиа)
	
	Приемник.Идентификатор = ДанныеЕсиа.id;
	Приемник.ИдентификаторПользователя = ДанныеЕсиа.owner_id;
	Приемник.Бик = ДанныеЕсиа.bik;
	Приемник.КоррСчет = ДанныеЕсиа.corr_account;
	Приемник.НомерСчета = ДанныеЕсиа.payment_account;
	
	Приемник.ПолучательПлатежа = ДанныеЕсиа.recipient;
	Приемник.ИННПолучателя = ДанныеЕсиа.inn;
	Приемник.НазначениеПлатежа = ДанныеЕсиа.notation;
	Приемник.НаименованиеБанка = ДанныеЕсиа.bank_name;
	Приемник.Валюта = Врег(ДанныеЕсиа.valuta);
		
КонецФункции

Функция ПолучитьДату(ДатаСтр)
	
	Если Не ЗначениеЗаполнено(ДатаСтр) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	//10.06.2021 -> 20210610
	ЧастиТекДаты = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ДатаСтр, ".", Истина, Истина);

	ТекДата = "";
	
	Для Инд = 1 - ЧастиТекДаты.Количество() По 0 Цикл	
		ТекДата = ТекДата + ЧастиТекДаты[-Инд];	
	КонецЦикла;
		
	Возврат Дата(ТекДата);
	
КонецФункции

Функция ПолучитьВидДокумента(ДокументЕсиа, Страна)
	
	Если ДокументЕсиа = "passport" Тогда
		
		Если Страна = Справочники.СтраныМира.Россия Тогда
			Возврат Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ;
		Иначе
			Возврат Справочники.ВидыДокументовФизическихЛиц.ПаспортИностранногоГражданина;	
		Конецесли;
		
	ИначеЕсли ДокументЕсиа = "driver_license" Тогда
		Возврат Справочники.ВидыДокументовФизическихЛиц.ВодительскоеУдостоверение;	
	ИначеЕсли ДокументЕсиа = "residence_permit" Тогда
		Возврат Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство; 
	Иначе
		Возврат Неопределено;
	КонецЕсли; 
		
КонецФункции
	
Функция ПолучиьОписаниеПубличногоЛица(Организация, Должность, Адрес)
	
	Описание = ?(ЗначениеЗаполнено(Организация), "Наимнование организации " + Организация, "");
	Описание = Описание + ?(ЗначениеЗаполнено(Должность), "должность " + Должность, "");
	Описание = Описание + ?(ЗначениеЗаполнено(Адрес), "адрес организации " + Адрес, "");
	
КонецФункции

Функция ПолучитьВидЗаявки(ВидЗаявкиЕсиа)
	
	Если ВидЗаявкиЕсиа = "pifs_purchase" Тогда
		Возврат Перечисления.ВидыЗаявокПайщиков.Зачисление;	
	ИначеЕсли ВидЗаявкиЕсиа = "pifs_selling" Тогда
		Возврат Перечисления.ВидыЗаявокПайщиков.Погашение;
	ИначеЕсли ВидЗаявкиЕсиа = "pifs_exchange" Тогда
		Возврат Перечисления.ВидыЗаявокПайщиков.Обмен;	
	Иначе
		ЗафиксироватьСообщение("Не удалось определить вид заявки пайщика по значению [" + ВидЗаявкиЕсиа + "]");
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция ПолучитьСтатусЗаявки(СтатусЕсиа) 
	
	СтатусыЗаявок = Новый Соответствие;
	СтатусыЗаявок.Вставить("draft", "Черновик");
	СтатусыЗаявок.Вставить("order_draft", "Черновик Винвестор");
	СтатусыЗаявок.Вставить("in_queue", "Новая");
	СтатусыЗаявок.Вставить("in_process", "В работе");
	СтатусыЗаявок.Вставить("elaboration", "Необходимы уточнения");
	СтатусыЗаявок.Вставить("wait_for_sign", "Требуется подпись");
	СтатусыЗаявок.Вставить("done", "Исполнена");
	СтатусыЗаявок.Вставить("rejected", "Отклонена");
	СтатусыЗаявок.Вставить("wrong", "Ошибочная");
	СтатусыЗаявок.Вставить("cancel", "Отменена");
	
	Статус = СтатусыЗаявок.Получить(СтатусЕсиа);
	
	Если Статус = Неопределено Тогда 	
		ЗафиксироватьСообщение("Не удалось определить статус заявки пайщика по значению [" + СтатусЕсиа + "]");
		Возврат Неопределено;
	Иначе
		Возврат Статус + " (" + СтатусЕсиа + ")"; 
	КонецЕсли;
		
КонецФункции

Функция ПолучитьПараметрыПодключения(ContentType = "application/json") Экспорт
	
	Возврат РаботаСВнешнимиСистемами.ЕСИА_Финанс_ПараметрыПодключения(ЭтотОбъект.Организация, ContentType);
	
КонецФункции

Процедура ЗафиксироватьСообщение(ТекстСообщения, Ошибка = Истина, Отказ = Ложь)
	
	Если Ошибка Тогда
	
		Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
			ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстСообщения);	
		Иначе
			ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", РаботаСКоллекциями.ЗначениеВМассив(ТекстСообщения));	
		КонецЕсли;
		
		Отказ = Истина;
		
	Иначе
		ЭтотОбъект.Результат.ДобавитьСтроку(ТекстСообщения);	
	КонецЕсли;
		
КонецПроцедуры

Процедура ОповеститьОбОшибках(ТекстОшибки = Неопределено) Экспорт
	
	Если ТекстОшибки <> Неопределено Тогда
		ЗафиксироватьСообщение(ТекстОшибки);	
	КонецЕсли;
		
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС); 
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
		
	ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки"); 
	
КонецПроцедуры

Функция ПолучитьСтрокуJSON(Данные, ПараметрыЗаписи = Неопределено)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	
    Если ПараметрыЗаписи = Неопределено Тогда
		ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	Иначе
		ПараметрыЗаписиJSON = ПараметрыЗаписи;	
	КонецЕсли;
	
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	ЗаписатьJSON(ЗаписьJSON, Данные,,);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Возврат СтрокаJSON;
	
КонецФункции

Функция ДесериализоватьСтрокуJSON(СтрокаJSON, ИзменитьЧисловыеКлючи = Ложь)
	
	Если ИзменитьЧисловыеКлючи Тогда
		СтрокаJSON = СтрЗаменить(СтрокаJSON, """0"":", """НольСтр"":");
		СтрокаJSON = СтрЗаменить(СтрокаJSON, """1"":", """ОдинСтр"":");
		СтрокаJSON = СтрЗаменить(СтрокаJSON, """2"":", """ДваСтр"":");
	    СтрокаJSON = СтрЗаменить(СтрокаJSON, """3"":", """ТриСтр"":");
	    СтрокаJSON = СтрЗаменить(СтрокаJSON, """4"":", """ЧетыреСтр"":");
		СтрокаJSON = СтрЗаменить(СтрокаJSON, """5"":", """ПатьСтр"":");
	    СтрокаJSON = СтрЗаменить(СтрокаJSON, """6"":", """ШестьСтр"":");
	    СтрокаJSON = СтрЗаменить(СтрокаJSON, """7"":", """СемьСтр"":");
	    СтрокаJSON = СтрЗаменить(СтрокаJSON, """8"":", """ВосемьСтр"":");
		СтрокаJSON = СтрЗаменить(СтрокаJSON, """9"":", """ДевятьСтр"":");
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON();
    ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	ИменаСвойствДляВосстановления = Новый Массив;
	ИменаСвойствДляВосстановления.Добавить("id");
	ИменаСвойствДляВосстановления.Добавить("owner_id");
	ИменаСвойствДляВосстановления.Добавить("fund_to_id");
	ИменаСвойствДляВосстановления.Добавить("user_id");
	ИменаСвойствДляВосстановления.Добавить("attachmentable_id");
	
	Возврат ПрочитатьJSON(ЧтениеJSON,,,, "ЕСИА_Финанс_ВосстановлениеЗначенияИзJSON", РаботаСВнешнимиСистемами,, ИменаСвойствДляВосстановления);
	
КонецФункции

Процедура ИмпортироватьАнкеты() Экспорт
	
	ПараметрыПодключения = ПолучитьПараметрыПодключения();
		
	ТекстСообщения = "Не удалось получить данные пользователей из системы ЕСИА.Финанс"; 
	
	//1 получаем коды вновь созданных пользователей
	//2 получаем коды пользователей с измененными данными
	ПараметрыЗапроса = РаботаСКоллекциями.ЗначенияВМассив("created_at", "updated_at");
	
	ТаблицаИдентификаторов = Новый ТаблицаЗначений;
		
	ТаблицаИдентификаторов.Колонки.Добавить("id",									Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(20)));
	ТаблицаИдентификаторов.Колонки.Добавить("ПоЗаявкеНаИзмениеПерсональныхДанных",	Новый ОписаниеТипов("Булево"));
	ТаблицаИдентификаторов.Колонки.Добавить("attachments");

	Для Каждого ТекПараметр Из ПараметрыЗапроса Цикл
	
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("GET", ПараметрыПодключения, "/api/v1/back_office/users?filter%5B" + ТекПараметр + "%5D%5Bgt%5D=" + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy"),, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
		
		ДанныеЕсиа = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
			
		Если Не (ТипЗнч(ДанныеЕсиа) = Тип("Структура") И ДанныеЕсиа.Свойство("success") И ДанныеЕсиа.success И ДанныеЕсиа.Свойство("users")) Тогда			
			ЗафиксироватьСообщение(ТекстСообщения);	
		    Возврат;	
		КонецЕсли;
		
		Для Каждого ТекПользователь Из ДанныеЕсиа.users Цикл		
			
			Если ТаблицаИдентификаторов.Найти(ТекПользователь.id, "id") = Неопределено Тогда 
				НоваяСтрока = ТаблицаИдентификаторов.Добавить();
				НоваяСтрока.id = ТекПользователь.id;
			КонецЕсли;
				
		КонецЦикла;
		
	КонецЦикла;
	
	// Также добавляем заявки на изменение перс. данных
	ОтборПоДате			= Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy");	
	ОтборПоВидуЗаявки	= "&filter%5Bkind%5D=person_info_change";
	ТекстЗапроса		= "/api/v1/back_office/claims?filter%5Bcreated_at%5D%5Bgt%5D=" + ОтборПоДате + ОтборПоВидуЗаявки;
	
	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("GET", ПараметрыПодключения, ТекстЗапроса,, ТекстСообщения);
	
	Если HTTPОтвет <> Неопределено Тогда
	
		ДанныеЕсиа = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
			
		Если ТипЗнч(ДанныеЕсиа) = Тип("Структура")
			И ДанныеЕсиа.Свойство("success")
			И ДанныеЕсиа.success
			И ДанныеЕсиа.Свойство("claims") 
			И ДанныеЕсиа.claims.Количество() > 0 Тогда
			
			Для Каждого ТекЗаявка Из ДанныеЕсиа.claims Цикл		
			
				Если ТаблицаИдентификаторов.Найти(ТекЗаявка.user_id, "id") = Неопределено Тогда
										
					// Сразу получаем вложения 
					ТекстЗапроса		= "/api/v1/back_office/claims/" + ТекЗаявка.id;
					HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("GET", ПараметрыПодключения, ТекстЗапроса,, ТекстСообщения);
					
					Если HTTPОтвет <> Неопределено Тогда
						ДанныеЗаявки = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
						
						НоваяСтрока = ТаблицаИдентификаторов.Добавить();
						
						НоваяСтрока.id									= ТекЗаявка.user_id;
						НоваяСтрока.ПоЗаявкеНаИзмениеПерсональныхДанных	= Истина;
							
						НоваяСтрока.attachments							= ДанныеЗаявки.claim.attachments;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Если ТаблицаИдентификаторов.Количество() = 0 Тогда
		ЗафиксироватьСообщение("Отсутствуют данные для загрузки.", Ложь);
		Возврат;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область Текст_запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаИдентификаторов.id КАК id,
		|	ТаблицаИдентификаторов.ПоЗаявкеНаИзмениеПерсональныхДанных КАК ПоЗаявкеНаИзмениеПерсональныхДанных
		|ПОМЕСТИТЬ _ТаблицаИдентификаторов
		|ИЗ
		|	&ТаблицаИдентификаторов КАК ТаблицаИдентификаторов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код,
		|	_ТаблицаИдентификаторов.ПоЗаявкеНаИзмениеПерсональныхДанных КАК ПоЗаявкеНаИзмениеПерсональныхДанных
		|ПОМЕСТИТЬ _КодыВоВнешнихСистемах
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица))) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаИдентификаторов КАК _ТаблицаИдентификаторов
		|		ПО КодыВоВнешнихСистемахСрезПоследних.Код = _ТаблицаИдентификаторов.id
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КодыПайщиков.Объект КАК Ссылка,
		|	_КодыПайщиков.Код КАК ИдентификаторПользователя,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Регистратор КАК АнкетаСсылка,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Период КАК ДатаАнкетныхДанных,
		|	_КодыПайщиков.ПоЗаявкеНаИзмениеПерсональныхДанных КАК ПоЗаявкеНаИзмениеПерсональныхДанных,
		|	НЕОПРЕДЕЛЕНО КАК attachments
		|ИЗ
		|	_КодыВоВнешнихСистемах КАК _КодыПайщиков
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&ДатаКонецДня,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И ЮрФизЛицо В
		|						(ВЫБРАТЬ
		|							_КодыПайщиков.Объект
		|						ИЗ
		|							_КодыВоВнешнихСистемах КАК _КодыПайщиков)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ПО _КодыПайщиков.Объект = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	РАЗНОСТЬДАТ(ЕСТЬNULL(РеквизитыФизическихЛицАнкетныеСрезПоследних.Период, ДАТАВРЕМЯ(2000, 1, 1)), &ДатаНачалоДня, ДЕНЬ) > 0"; 
		
#КонецОбласти
	
	Запрос.УстановитьПараметр("ТаблицаИдентификаторов",	ТаблицаИдентификаторов);
	Запрос.УстановитьПараметр("Организация",			ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаНачалоДня",			НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("ДатаКонецДня",			КонецДня(ЭтотОбъект.Дата));
	
	ТаблицаАнкет = Запрос.Выполнить().Выгрузить(); 
	
	СуществующиеКлиенты = Запрос.МенеджерВременныхТаблиц.Таблицы["_КодыВоВнешнихСистемах"].ПолучитьДанные().Выгрузить().ВыгрузитьКолонку("Код");
	
	Для Каждого СтрокаИдентификаторов Из ТаблицаИдентификаторов Цикл 
		
		СтрокаТаблицы = ТаблицаАнкет.Найти(СтрокаИдентификаторов.id, "ИдентификаторПользователя");
		
		Если СтрокаТаблицы = Неопределено И СуществующиеКлиенты.Найти(СтрокаИдентификаторов.id) = Неопределено Тогда
			
			НоваяСтрока = ТаблицаАнкет.Добавить();
			НоваяСтрока.ИдентификаторПользователя = СтрокаИдентификаторов.id;
			НоваяСтрока.ПоЗаявкеНаИзмениеПерсональныхДанных = СтрокаИдентификаторов.ПоЗаявкеНаИзмениеПерсональныхДанных;
			
		ИначеЕсли СтрокаТаблицы <> Неопределено И СтрокаТаблицы.ПоЗаявкеНаИзмениеПерсональныхДанных Тогда
			СтрокаТаблицы.attachments = СтрокаИдентификаторов.attachments;
		КонецЕсли;
			
	КонецЦикла;
				
	Если ТаблицаАнкет.Количество() = 0 Тогда
		ЗафиксироватьСообщение("Отсутствуют данные для загрузки.", Ложь);
		Возврат;
	КонецЕсли;
		
	ДанныеПользователей = ДесериализоватьДанныеПользователейЕсиа(ТаблицаАнкет, ПараметрыПодключения);
	
	Если ДанныеПользователей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	БанковскиеСчета = ДесериализоватьДанныеБанковскихСчетовЕсиа(ДанныеПользователей, ПараметрыПодключения);

	СформироватьИЗагрузитьАнкеты(ДанныеПользователей, БанковскиеСчета, Новый МенеджерВременныхТаблиц, ПараметрыПодключения); 
		
КонецПроцедуры

Функция ДесериализоватьДанныеЗаявокЕсиа(ОтветЕсиа, ПараметрыПодключения)
	
	ЗаявкиПайщиков = СформироватьТаблицуПриемник("ЗаявкиПайщиков");	
		
	Для Каждого ТекЗаявка Из ОтветЕсиа.claims Цикл
				
		Если ТекЗаявка.status <> "in_queue" Тогда
			Продолжить;
		КонецЕсли;
				
		Если Не (ТекЗаявка.Свойство("owner_type") И ТекЗаявка.owner_type = "Fund") Тогда
			Продолжить;	
		Конецесли;
		
		ТекДатаЗаявки = Дата(Лев(РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(ТекЗаявка.created_at), 14));
		
		Если ЭтотОбъект.Дата <> НачалоДня(ТекДатаЗаявки) Тогда
			Продолжить;
		КонецЕсли; 
		
		//устанавливаем фонду код (portfolio_code) такой-же как и идентификатор
		ТекстСообщения = "Не удалось получить данные фонда из системы ЕСИА.Финанс по id " + ТекЗаявка.owner_id;
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("GET", ПараметрыПодключения, "/api/v1/back_office/funds/" + ТекЗаявка.owner_id,, ТекстСообщения);
	
		Если HTTPОтвет = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		Иначе
			
			ДанныеФонда = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"), Истина);
			
			Если Не (ТипЗнч(ДанныеФонда) = Тип("Структура") И ДанныеФонда.Свойство("success") И ДанныеФонда.success) 
				Или Не ДанныеФонда.Свойство("fund") Тогда
				
				ЗафиксироватьСообщение("Не удалось получить данные фонда из системы ЕСИА.Финанс по id " + ТекЗаявка.owner_id);
				Продолжить;
				
			ИначеЕсли Строка(ТекЗаявка.owner_id) <> ДанныеФонда.fund.portfolio_code Тогда 
					
				ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("portfolio_code", ТекЗаявка.owner_id)); 
				
				ТекстСообщения = "Не удалось установить portfolio_code для фонда id " + ТекЗаявка.owner_id;
				
				HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("PUT", ПараметрыПодключения, "/api/v1/back_office/funds/" + ТекЗаявка.owner_id, ТелоЗапроса, ТекстСообщения);
				
				Если HTTPОтвет = Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					Продолжить;
				КонецЕсли;
				
				ОтветНаЗапрос = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
		
				Если Не (ТипЗнч(ОтветНаЗапрос) = Тип("Структура") И ОтветНаЗапрос.Свойство("success") И ОтветНаЗапрос.success) Тогда
					
					ЗафиксироватьСообщение("Не удалось установить portfolio_code для фонда id " + ТекЗаявка.owner_id);
					Продолжить;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЕстьОшибки = Ложь;
		ДобавитьСтрокуВТаблицуЗаявок(ПараметрыПодключения, ЗаявкиПайщиков, ТекЗаявка, ТекЗаявка.kind, ТекЗаявка.inner_code, ТекДатаЗаявки);
		
		// Для заявок на обмен с открытием счета сразу создаем заявку на приобретение с номером из поля open_inner_code
		КоличествоСтрок = ЗаявкиПайщиков.Количество();
		Если КоличествоСтрок > 0 
			И ТекЗаявка.kind = "pifs_exchange"
			И ТекЗаявка.metadata.Свойство("is_with_open")
			И ТекЗаявка.metadata.is_with_open
			И Не ЗаявкиПайщиков[КоличествоСтрок - 1].ЕстьОшибкиДанных Тогда
			ДобавитьСтрокуВТаблицуЗаявок(ПараметрыПодключения, ЗаявкиПайщиков, ТекЗаявка, "pifs_purchase", ТекЗаявка.data.open_inner_code, ТекДатаЗаявки, ТекЗаявка.inner_code);			
		КонецЕсли;	
		
	КонецЦикла;
	
	Возврат ЗаявкиПайщиков;
	
КонецФункции 

Процедура ДобавитьСтрокуВТаблицуЗаявок(ПараметрыПодключения, ЗаявкиПайщиков, ТекЗаявка, ВидЗаявки, НомерЗаявки, ДатаЗаявки, НомерИсходнойЗаявкиНаОбмен = "")
	
	ЗаявкаНаПриобретениеПоЗаявкеНаОбмен = ВидЗаявки = "pifs_purchase" И Не ПустаяСтрока(НомерИсходнойЗаявкиНаОбмен);
	
	НоваяЗапись = ЗаявкиПайщиков.Добавить();
		
	НоваяЗапись.Идентификатор = ТекЗаявка.id;
	НоваяЗапись.ВидЗаявки = ПолучитьВидЗаявки(ВидЗаявки);
	НоваяЗапись.Статус = ПолучитьСтатусЗаявки(ТекЗаявка.status);
	НоваяЗапись.ИдентификаторПользователя = ТекЗаявка.user_id;
	НоваяЗапись.НомерЗаявки = НомерЗаявки;
	НоваяЗапись.ДатаЗаявки = ДатаЗаявки;
	
	НоваяЗапись.ИдентификаторПифа = ?(ЗаявкаНаПриобретениеПоЗаявкеНаОбмен, ТекЗаявка.data.fund_to_id, ТекЗаявка.owner_id); 
	
	Если ТекЗаявка.Свойство("data") Тогда
		
		НоваяЗапись.Сумма = ?(ТекЗаявка.data.Свойство("amount"), ТекЗаявка.data.amount, 0);
		
		Если ТекЗаявка.data.Свойство("account_number") И Не ЗаявкаНаПриобретениеПоЗаявкеНаОбмен Тогда
			НоваяЗапись.НомерСчетаДепо = ТекЗаявка.data.account_number;
		Иначе
			
			Если ТекЗаявка.metadata.Свойство("is_with_open") И ТекЗаявка.metadata.is_with_open И ВидЗаявки = "pifs_purchase" Тогда  
				
				НоваяЗапись.ОткрытьЗакрытьДепозитарныйСчет = Истина;
				
			Иначе
				ЗафиксироватьСообщение("При импорте заявки не удалось определить депозитарный счет, код ЕСИА.Финанс [" + ТекЗаявка.id + "].");
				НоваяЗапись.ЕстьОшибкиДанных = Истина;
			КонецЕсли;
			
		КонецЕсли; 
					
		Если ВидЗаявки = "pifs_purchase" Тогда	
			
			НоваяЗапись.Количество = ?(ТекЗаявка.data.Свойство("pieces_amount"), ТекЗаявка.data.pieces_amount, 0); 
			
			НоваяЗапись.Многократная = (НоваяЗапись.ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Зачисление) И Не ТекЗаявка.data.Свойство("amount"); 
			
			Если Не ПустаяСтрока(НомерИсходнойЗаявкиНаОбмен) Тогда
				НоваяЗапись.НомерЗаявкиНаОбмен = НомерИсходнойЗаявкиНаОбмен;
			КонецЕсли;

		ИначеЕсли ВидЗаявки = "pifs_selling" Или ВидЗаявки = "pifs_exchange" Тогда
		   
			Если ТекЗаявка.data.Свойство("count") Тогда
				НоваяЗапись.Количество = ТекЗаявка.data.count;
			Иначе
				ЗафиксироватьСообщение("При импорте заявки не удалось определить количество паев, код ЕСИА.Финанс [" + ТекЗаявка.id + "].");
				НоваяЗапись.ЕстьОшибкиДанных = Истина;
			КонецЕсли;
			
		КонецЕсли; 
		
		Если ВидЗаявки = "pifs_exchange" Тогда
			
			НоваяЗапись.ИдентификаторПифаДляОбмена = ТекЗаявка.data.fund_to_id;
			
			Если ТекЗаявка.data.Свойство("account_number_to") Тогда
				НоваяЗапись.НомерСчетаДепоДляОбмена = ТекЗаявка.data.account_number_to;
			Иначе
				
				Если ТекЗаявка.metadata.Свойство("is_with_open") И ТекЗаявка.metadata.is_with_open Тогда 
					НоваяЗапись.ОткрытьДепозитарныйСчетДляОбмена = Истина;
				Иначе
					ЗафиксироватьСообщение("При импорте заявки [идентификатор ЕСИА.Финанс " + ТекЗаявка.id + "] не удалось определить депозитарный счет для обмена.");
					НоваяЗапись.ЕстьОшибкиДанных = Истина;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
								
		Если ТекЗаявка.data.Свойство("requisite_id") Тогда 
			НоваяЗапись.ИдентификаторРасчетногоСчета = ТекЗаявка.data.requisite_id;				
		Иначе
			ЗафиксироватьСообщение("Не удалось получить банковские реквизиты из заявки, код ЕСИА.Финанс [" + ТекЗаявка.id + "]");
			НоваяЗапись.ЕстьОшибкиДанных = Истина;			
            Возврат;
		КонецЕсли;
		
		//получаем подпись
		ТекстСообщения = "Не удалось получить данные подписи заявки пайщика из системы ЕСИА.Финанс по id " + ТекЗаявка.id;
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("GET", ПараметрыПодключения, "/api/v1/back_office/claims/" + ТекЗаявка.id,, ТекстСообщения);
	
		Если HTTPОтвет = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			НоваяЗапись.ЕстьОшибкиДанных = Истина;
			Возврат;
		Иначе
			
			ОтветНаЗапрос = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
			
			Если Не ОтветНаЗапрос.Свойство("Claim") Тогда
				ЗафиксироватьСообщение("Не удалось получить данные подписи заявки пайщика, код ЕСИА.Финанс [" + ТекЗаявка.id + "]");
				НоваяЗапись.ЕстьОшибкиДанных = Истина;
				Возврат;
			КонецЕсли;
			
			ПолныеДанныеЗаявки = ОтветНаЗапрос.Claim;
			
			Если Не ПолныеДанныеЗаявки.Свойство("attachments") Тогда
				ЗафиксироватьСообщение("Не удалось получить данные подписи заявки пайщика, код ЕСИА.Финанс [" + ТекЗаявка.id + "]");
				НоваяЗапись.ЕстьОшибкиДанных = Истина;
				Возврат;
			Конецесли; 
						
			// Проверяем подпись
			Для Каждого ТекВложение Из ПолныеДанныеЗаявки.attachments Цикл
								
				Если Не (СтрНачинаетсяС(ТекВложение.kind, ТекЗаявка.kind)
						И СтрНачинаетсяС(ТекВложение.description, "Заявка")) Тогда				
					Продолжить;		
				КонецЕсли;
				
				Если Не ТекВложение.Свойство("client_sign") Тогда 
					ЗафиксироватьСообщение("Не удалось получить данные подписи заявки пайщика, код ЕСИА.Финанс [" + ТекЗаявка.id + "]");
					НоваяЗапись.ЕстьОшибкиДанных = Истина;
					Возврат;
				КонецЕсли;
				
				СтруктураПодписи = ТекВложение.client_sign;
				
				Если ПодписьВалидна(СтруктураПодписи) Тогда 
				
					МассивТелефонКод = СтрРазделить(СтруктураПодписи.identifier, "/");
					
					Телефон = МассивТелефонКод[0];
					
					НоваяЗапись.ПЭП_НомерТелефона = ?(СтрНайти(Телефон, "+") > 0, "+", "") + РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(Телефон);
					НоваяЗапись.ПЭП_Код = СокрЛП(МассивТелефонКод[1]);
					НоваяЗапись.ПЭП_ДатаВремяПодписи = Дата(Лев(РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(СтруктураПодписи.signed_at), 14));
					
					Прервать;
				Иначе
					ЗафиксироватьСообщение("Не удалось получить данные подписи заявки пайщика, код ЕСИА.Финанс [" + ТекЗаявка.id + "]");
					НоваяЗапись.ЕстьОшибкиДанных = Истина;
					Возврат;
				КонецЕсли;
				
			КонецЦикла;
			
			Если Не ЗначениеЗаполнено(НоваяЗапись.ПЭП_Код) Тогда
				ЗафиксироватьСообщение("Не удалось получить данные подписи заявки пайщика, код ЕСИА.Финанс [" + ТекЗаявка.id + "]");
				НоваяЗапись.ЕстьОшибкиДанных = Истина;	
			КонецЕсли;
			
			// Получаем идентификаторы файлов для загрузки
			ВложенияКУдалению = Новый Массив;
			
			Для Каждого ТекВложение Из ПолныеДанныеЗаявки.attachments Цикл
								
				Если Не (СтрНачинаетсяС(ТекВложение.kind, ТекЗаявка.kind)
						И (СтрНачинаетсяС(ТекВложение.description, "Заявка")
							Или СтрНачинаетсяС(ТекВложение.description, "ДК РЕГИОН"))) Тогда
					ВложенияКУдалению.Добавить(ТекВложение);	
					Продолжить;		
				КонецЕсли;
				
				// Для заявки на обмен с открытием лицевого счета из файлов нужно исключить файл заявки на приобретение.
				// Его нужно прикрепить к соответствующей заявке на приобретение
				Если ВидЗаявки = "pifs_exchange"
					И НоваяЗапись.ОткрытьДепозитарныйСчетДляОбмена
					И СтрНачинаетсяС(ТекВложение.description, "Заявка на приобретение паев") Тогда
					ВложенияКУдалению.Добавить(ТекВложение);
					Продолжить;
				КонецЕсли;
				
				Если ВидЗаявки = "pifs_purchase"
					И ЗаявкаНаПриобретениеПоЗаявкеНаОбмен 
					И Не СтрНачинаетсяС(ТекВложение.description, "Заявка на приобретение паев") Тогда
					ВложенияКУдалению.Добавить(ТекВложение);
					Продолжить;
				КонецЕсли;			
										
			КонецЦикла;

			Для Каждого ВложениеКУдалению Из ВложенияКУдалению Цикл
				
				ПолныеДанныеЗаявки.attachments.Удалить(ПолныеДанныеЗаявки.attachments.Найти(ВложениеКУдалению));
				
			КонецЦикла;
			
			//Из заявки получаем файлы для дальнейшей привязки к заявке пайщика
			НоваяЗапись.МассивФайлов = ПолучитьМассивФайлов(ПолныеДанныеЗаявки.attachments, ПараметрыПодключения);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДесериализоватьДанныеПользователейЕсиа(ТаблицаАнкет, ПараметрыПодключения)
	
	ПользователиЕсиа = СформироватьТаблицуПриемник("ПользователиЕсиа");
									
	Для Каждого ТекЗапись Из ТаблицаАнкет Цикл
		
		СтрокаТаблицыПользователей = ПользователиЕсиа.Найти(ТекЗапись.ИдентификаторПользователя, "Идентификатор"); 
		
		Если СтрокаТаблицыПользователей <> Неопределено Тогда  //если у пользователя несколько заявок
			Продолжить;	
		КонецЕсли;
		
		ТекстСообщения = "Не удалось получить данные пользователя из системы ЕСИА.Финанс по id " + ТекЗапись.ИдентификаторПользователя;
		
		//1. получаем данные пользователя по идентификатору
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("GET", ПараметрыПодключения, "/api/v1/back_office/users/" + ТекЗапись.ИдентификаторПользователя,, ТекстСообщения);
	
		Если HTTPОтвет = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		Иначе
			
			ДанныеЕсиа = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
			
			Если Не (ТипЗнч(ДанныеЕсиа) = Тип("Структура") И ДанныеЕсиа.Свойство("success") И ДанныеЕсиа.success)
				Или Не ДанныеЕсиа.Свойство("user") Тогда
				
				ЗафиксироватьСообщение("Не удалось получить данные пользователя из системы ЕСИА.Финанс по id " + ТекЗапись.ИдентификаторПользователя);
				Продолжить;	
				
			КонецЕсли; 
			
			ДанныеПользователяЕсиа = ДанныеЕсиа.user;
						
			ЗначенияРеквизитовАнкеты = ПолучитьЗначенияРеквизитовАнкетыПользователя(ДанныеПользователяЕсиа, ПараметрыПодключения, ТекЗапись);
			
			Если ЗначенияРеквизитовАнкеты = Неопределено Тогда 
				Продолжить;
			КонецЕсли;
			
			//проверяем дату актульности анкетных данных
			Если ЗначениеЗаполнено(ТекЗапись.ДатаАнкетныхДанных) И ЗначенияРеквизитовАнкеты.ДанныеДляОпределенияСсылок.ДатаАктуальности <= ТекЗапись.ДатаАнкетныхДанных Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяЗапись = ПользователиЕсиа.Добавить();
			НоваяЗапись.Ссылка = ТекЗапись.Ссылка;
			НоваяЗапись.ЕстьКодЕсиа = ЗначениеЗаполнено(ТекЗапись.Ссылка);	
			НоваяЗапись.АнкетаСсылка = ТекЗапись.АнкетаСсылка;
			НоваяЗапись.Идентификатор = ДанныеПользователяЕсиа.id; 
			НоваяЗапись.ЗаписатьКодПайщика = (Строка(ДанныеПользователяЕсиа.id) <> ДанныеПользователяЕсиа.pifs_portfolio_code);
			НоваяЗапись.АнкетныеДанные = ЗначенияРеквизитовАнкеты.АнкетныеДанные; 
						
			ЗаполнитьЗначенияСвойств(НоваяЗапись, ЗначенияРеквизитовАнкеты.ДанныеДляОпределенияСсылок); 
																								
		КонецЕсли;

	КонецЦикла;
	
	Возврат ПользователиЕсиа;
     	
КонецФункции 

Функция ДесериализоватьДанныеБанковскихСчетовЕсиа(ДанныеПользователей, ПараметрыПодключения) 
	
	ТаблицаБанковскихСчетов = СформироватьТаблицуПриемник("БанковскиеСчета");
	
	Для Каждого ТекПользователь Из ДанныеПользователей Цикл 
		
		ТекстСообщения = "Не удалось получить данные расчетных счетов пользователя из системы ЕСИА.Финанс по id пользователя " + ТекПользователь.Идентификатор;
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос(
			"GET", 
			ПараметрыПодключения, 
			"/api/v1/back_office/requisites?requisite_owner_type=User&requisite_owner_id=" + ТекПользователь.Идентификатор,
			, 
			ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		Иначе
			
			ДанныеЕсиа = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
			
			Если Не (ТипЗнч(ДанныеЕсиа) = Тип("Структура") И ДанныеЕсиа.Свойство("success") И ДанныеЕсиа.success)
				Или Не ДанныеЕсиа.Свойство("requisites") Тогда
				
				ЗафиксироватьСообщение("Не удалось получить данные счетов пользователя из системы ЕСИА.Финанс по id " + ТекПользователь.Идентификатор);
				Продолжить;	
				
			КонецЕсли;
			
			Для Каждого ТекСчет Из ДанныеЕсиа.requisites Цикл
				
				СтрокиТаблицыСчетов = ТаблицаБанковскихСчетов.НайтиСтроки(Новый Структура("ИдентификаторПользователя, НомерСчета", ТекПользователь.Идентификатор, ТекСчет.payment_account));
				
				Если СтрокиТаблицыСчетов.Количество() = 0 Тогда 
					
					НовыйСчет = ТаблицаБанковскихСчетов.Добавить();
					ПолучитьЗначенияБанковскихРеквизитов(НовыйСчет, ТекСчет);
	
				КонецЕсли;
		
			КонецЦикла;
				
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ТаблицаБанковскихСчетов; 
		
КонецФункции

