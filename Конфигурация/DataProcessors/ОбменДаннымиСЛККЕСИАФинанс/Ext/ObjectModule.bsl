		|	И _ОшибкиОпределенияДепозитарныхСчетов.ИдентификаторЗаявки ЕСТЬ NULL
		|
		|УПОРЯДОЧИТЬ ПО
		|	ФактическаяЗаявка УБЫВ";
#КонецОбласти

	ВыборкаЗаявок = Запрос.Выполнить().Выбрать();
	
	ЗаявкиНаОбмен = ТабЗаявкиПайщиков.Скопировать(Новый Структура("ВидЗаявки, ОткрытьДепозитарныйСчетДляОбмена", Перечисления.ВидыЗаявокПайщиков.Обмен, Истина), "Идентификатор");
	ЗаявкиНаОбмен.Колонки.Добавить("ЗаявкаСсылка", Новый ОписаниеТипов("ДокументСсылка.ЗаявкаПайщика"));	

	Пока ВыборкаЗаявок.Следующий() Цикл 
				
		ДокЗаявка = Документы.ЗаявкаПайщика.СоздатьДокумент();
		
		ЗаполнитьЗначенияСвойств(ДокЗаявка, ВыборкаЗаявок);
		
		ДокЗаявка.Дата			= ВыборкаЗаявок.ДатаЗаявки;
		ДокЗаявка.Организация	= ЭтотОбъект.Организация;
		
		ДокЗаявка.ИсточникЗаявки		= Перечисления.ИсточникиАнкетИЗаявок.Сайт;
		ДокЗаявка.ВидПайщика			= Перечисления.ВидыПайщиков.Владелец;
		ДокЗаявка.СобственностьНаПаи	= Перечисления.ВидыСобственности.НеДолеваяНеСовместная;
		
		Если Не ЗначениеЗаполнено(ДокЗаявка.Пайщик) Тогда
			
			СтрокаТаблицыПользователей = ДанныеПользователей.АнкетныеДанные.Найти(ВыборкаЗаявок.ИдентификаторПользователя, "Идентификатор");
				
			Если СтрокаТаблицыПользователей = Неопределено Тогда
				ЗафиксироватьСообщение("Не удалось импортировать заявку [" + ВыборкаЗаявок.Идентификатор + "]. Не удалось импортировать пользователя [id " + ВыборкаЗаявок.ИдентификаторПользователя + "].");
				Продолжить;
			Иначе
				ДокЗаявка.Пайщик = СтрокаТаблицыПользователей.Ссылка;
			КонецЕсли;
	
		КонецЕсли;
		
		ДокЗаявка.Владелец = ДокЗаявка.Пайщик;
		
		Если ЗначениеЗаполнено(ДокЗаявка.РасчетныйСчет)
			И ВыборкаЗаявок.ВладелецСчета <> ДокЗаявка.Пайщик Тогда
			
			ДокЗаявка.РасчетныйСчет = Неопределено;
		КонецЕсли; 
		
		ДокЗаявка.ВыгружатьОперацииВЕСИАФинанс = Истина;
		
		МассивСтрокТаблицыЗаявкиНаОбмен = Неопределено;
		
		Если Не ВыборкаЗаявок.ФактическаяЗаявка 
			Или ВыборкаЗаявок.ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Обмен 
				И ВыборкаЗаявок.ОткрытьДепозитарныйСчетВПаевомИнвестиционномФондеДляОбмена Тогда 
			
			МассивСтрокТаблицыЗаявкиНаОбмен = ЗаявкиНаОбмен.НайтиСтроки(Новый Структура("Идентификатор", ВыборкаЗаявок.Идентификатор));
			
			Если МассивСтрокТаблицыЗаявкиНаОбмен.Количество() <> 1 Тогда
				МассивСтрокТаблицыЗаявкиНаОбмен = Неопределено;
			КонецЕсли;
							
		КонецЕсли;

		НачатьТранзакцию();
		
		Если Не ВыборкаЗаявок.ФактическаяЗаявка И МассивСтрокТаблицыЗаявкиНаОбмен <> Неопределено Тогда
			ДокЗаявка.ЗаявкаНаОбмен = МассивСтрокТаблицыЗаявкиНаОбмен[0].ЗаявкаСсылка;
		ИначеЕсли Не ВыборкаЗаявок.ФактическаяЗаявка И МассивСтрокТаблицыЗаявкиНаОбмен = Неопределено Тогда
			
			ЗафиксироватьСообщение(СтрШаблон("Не удалось импортировать заявку на приобретение [%1], т.к. не удолась найти заявку основание (на обмен) с номером [%2].",
										ВыборкаЗаявок.Идентификатор,				
										ВыборкаЗаявок.НомерЗаявки));
			Продолжить;
		КонецЕсли;
		
		ДокЗаявка.Записать(РежимЗаписиДокумента.Проведение);
		РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(ДокЗаявка.Ссылка,
			Справочники.ВнешниеСистемы.ЕсиаФинанс,
			Справочники.ГруппыИмпортируемыхОбъектов.ЗаявкиПайщиков, ВыборкаЗаявок.Идентификатор);
			
		ЗафиксироватьСообщение("Загружен документ [" + ДокЗаявка + "]. Физ лицо " + ДокЗаявка.Пайщик, Ложь);
				
		Если ВыборкаЗаявок.ФактическаяЗаявка Тогда
		                                     
			СтрокаТаблицыЗаявок = ТабЗаявкиПайщиков.Найти(ВыборкаЗаявок.Идентификатор, "Идентификатор");
			
			Если СтрокаТаблицыЗаявок = Неопределено Тогда
				ЗафиксироватьСообщение("Не удалось загрузить файлы к заявке [" + ВыборкаЗаявок.Идентификатор + "].");
			Иначе
				ЗагрузитьФайлыВХранилище(ДокЗаявка.Ссылка, СтрокаТаблицыЗаявок.МассивФайлов);
			КонецЕсли;
			
			Если ВыборкаЗаявок.ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Обмен 
				И ВыборкаЗаявок.ОткрытьДепозитарныйСчетВПаевомИнвестиционномФондеДляОбмена
				И МассивСтрокТаблицыЗаявкиНаОбмен <> Неопределено Тогда 
			
				МассивСтрокТаблицыЗаявкиНаОбмен[0].ЗаявкаСсылка = ДокЗаявка.Ссылка;
				
			КонецЕсли;
	
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьМассивФайлов(ТипДержателяПописи, ВнешнниеДанные, ПараметрыПодключения)
	
	МассивФайлов = Новый Массив;
		
	Для Каждого СтрокаДанных Из ВнешнниеДанные Цикл 
		
		ТипФайла = СтрокаДанных["kind"];
		СтрокаОписания = СтрокаДанных["description"]; 
		
		Если СтрНачинаетсяС(ТипФайла, "pifs") И Не (СтрНачинаетсяС(СтрокаОписания, "Заявка") Или СтрНачинаетсяС(СтрокаОписания, "ДК РЕГИОН")) Тогда
			Продолжить;		
		КонецЕсли;

		ДвоичныеДанныеФайла = ПолучитьДанныеЕсиа("attachments",, СтрокаДанных["id"],, ПараметрыПодключения); 
						
		Если ДвоичныеДанныеФайла = Неопределено Тогда
			Продолжить;
		КонецЕсли;
				
		ОписаниеФайла = Новый Структура; 
		ОписаниеФайла.Вставить("Идентификатор", СтрокаДанных["id"]);
		ОписаниеФайла.Вставить("ПолноеИмя", СтрокаДанных["filename"]);		
		ОписаниеФайла.Вставить("Хранение", ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла));
		ОписаниеФайла.Вставить("ТребуетсяПодпись", (ЗначениеЗаполнено(СтрокаДанных["wait_for_sign"]) И СтрокаДанных["wait_for_sign"]));
		ОписаниеФайла.Вставить("Подпись", СтрокаДанных["client_sign"]);	
				
		Если ТипДержателяПописи = "du_origin" Тогда
			
			ОписаниеФайла.Вставить("ДержательПодписи", СтрНачинаетсяС(ТипФайла, "management") И СтрНачинаетсяС(СтрокаОписания, "Договор"));
			
		ИначеЕсли ТипФайла = "change_anket_data" И СтрЗаканчиваетсяНа(ТипДержателяПописи, "anket_data") Тогда
			
			ОписаниеФайла.Вставить("ДержательПодписи", СтрНачинаетсяС(СтрокаОписания, "Анкета физического лица (УК)"));
			
		ИначеЕсли СтрЗаканчиваетсяНа(ТипДержателяПописи, "anket_data") Тогда
			
			ОписаниеФайла.Вставить("ДержательПодписи", ТипФайла = ТипДержателяПописи И (СтрНачинаетсяС(СтрокаОписания, "Согласие ОПД") 
																						Или СтрНачинаетсяС(СтрокаОписания, "Согласие на обработку персональных данных")));
		Иначе
			ОписаниеФайла.Вставить("ДержательПодписи", СтрНачинаетсяС(ТипФайла, ТипДержателяПописи) И СтрНачинаетсяС(СтрокаОписания, "Заявка"));
		КонецЕсли;
			
		МассивФайлов.Добавить(ОписаниеФайла);
		
	КонецЦикла;
	
	Возврат МассивФайлов;
	
КонецФункции 

Процедура УстановитьСтатус(ЗаявкаПайщика, НовыйСтатус, Отказ = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК КодЗаявки
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЗаявкиПайщиков)
		|				И Объект = &ЗаявкаПайщика) КАК КодыВоВнешнихСистемахСрезПоследних";
	Запрос.УстановитьПараметр("ЗаявкаПайщика", ЗаявкаПайщика);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		
		ПараметрыПодключения = ПолучитьПараметрыПодключения(); 
		
		ТекстСообщения = "Ошибка установки статуса [" + ПолучитьСтатус(НовыйСтатус) + "] для заявки [" + ЗаявкаПайщика + "]";
	
		ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("status", НовыйСтатус));
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("PATCH", ПараметрыПодключения, "/api/v1/back_office/claims/" + Выборка.КодЗаявки, ТелоЗапроса, ТекстСообщения);

		Если HTTPОтвет = Неопределено Тогда
			ЗафиксироватьСообщение(ТекстСообщения,, Отказ);	
		Иначе	
			ЗафиксироватьСообщение("Заявке [" + ЗаявкаПайщика + "] установлен статус [" + ПолучитьСтатус(НовыйСтатус) + "]", Ложь);	
		КонецЕсли;
			
	КонецЕсли;
		
КонецПроцедуры

Процедура ИмпортироватьАнкеты(НовыеКодыАнкет = Неопределено) Экспорт
	
	ПараметрыПодключения = ПолучитьПараметрыПодключения();
		
	ТекстСообщения = "Не удалось получить данные пользователей из системы ЕСИА.Финанс"; 
	
	//1 получаем коды вновь созданных пользователей
	//2 получаем коды пользователей с измененными данными
	ПараметрыЗапроса = РаботаСКоллекциями.ЗначенияВМассив("created_at", "updated_at");
	
	ТаблицаИдентификаторов = Новый ТаблицаЗначений;
		
	ТаблицаИдентификаторов.Колонки.Добавить("id",									Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(20)));
	ТаблицаИдентификаторов.Колонки.Добавить("ПоЗаявкеНаИзмениеПерсональныхДанных",	Новый ОписаниеТипов("Булево"));
	ТаблицаИдентификаторов.Колонки.Добавить("attachments");

	Для Каждого ТекПараметр Из ПараметрыЗапроса Цикл 
				
		МассивДанныхПользователей = ПолучитьДанныеЕсиа("users", "users",, "filter%5B" + ТекПараметр + "%5D%5Bgt%5D=" + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy"), ПараметрыПодключения);
			
		Если МассивДанныхПользователей = Неопределено Тогда
			ЗафиксироватьСообщение(ТекстСообщения);
			Возврат;
		КонецЕсли;
				
		Для Каждого ТекПользователь Из МассивДанныхПользователей Цикл
			
			ТекИдентификатор = ТекПользователь["id"]; 
			
			Если ЗначениеЗаполнено(ТекИдентификатор) И ТаблицаИдентификаторов.Найти(ТекИдентификатор, "id") = Неопределено Тогда  
				НоваяСтрока = ТаблицаИдентификаторов.Добавить();
				НоваяСтрока.id = ТекИдентификатор;
			КонецЕсли;
				
		КонецЦикла;
		
	КонецЦикла;
	
	// Также добавляем заявки на изменение перс. данных
	Фильтр = "filter%5Bkind%5D=person_info_change&filter%5Bcreated_at%5D%5Bgt%5D=" + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy");
	
	МассивЗаявок = ПолучитьДанныеЕсиа("claims", "claims",, Фильтр, ПараметрыПодключения);
		
	Если ЗначениеЗаполнено(МассивЗаявок) Тогда
	
		Для Каждого ТекЗаявка Из МассивЗаявок Цикл
			
			ТекИдентификатор = ТекЗаявка["user_id"]; 
		
			Если ЗначениеЗаполнено(ТекИдентификатор) И ТаблицаИдентификаторов.Найти(ТекИдентификатор, "id") = Неопределено Тогда
									
				//Сразу получаем вложения 
				ДанныеЗаявки = ПолучитьДанныеЕсиа("claims", "claim", ТекЗаявка["id"],, ПараметрыПодключения);
				
				Если ДанныеЗаявки = Неопределено Тогда
					Продолжить;
				КонецЕсли;
					
				НоваяСтрока = ТаблицаИдентификаторов.Добавить();	
				НоваяСтрока.id									= ТекИдентификатор;
				НоваяСтрока.ПоЗаявкеНаИзмениеПерсональныхДанных	= Истина;	
				НоваяСтрока.attachments							= ?(ЗначениеЗаполнено(ДанныеЗаявки["attachments"]), ДанныеЗаявки["attachments"], Новый Массив()); 
						
			КонецЕсли;
			
		КонецЦикла;
					
	КонецЕсли;	
	
	Если ТаблицаИдентификаторов.Количество() = 0 Тогда
		ЗафиксироватьСообщение("Отсутствуют данные для загрузки.", Ложь);
		Возврат;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область Текст_запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаИдентификаторов.id КАК id,
		|	ТаблицаИдентификаторов.ПоЗаявкеНаИзмениеПерсональныхДанных КАК ПоЗаявкеНаИзмениеПерсональныхДанных
		|ПОМЕСТИТЬ _ТаблицаИдентификаторов
		|ИЗ
		|	&ТаблицаИдентификаторов КАК ТаблицаИдентификаторов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код,
		|	_ТаблицаИдентификаторов.ПоЗаявкеНаИзмениеПерсональныхДанных КАК ПоЗаявкеНаИзмениеПерсональныхДанных
		|ПОМЕСТИТЬ _КодыВоВнешнихСистемах
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица))) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаИдентификаторов КАК _ТаблицаИдентификаторов
		|		ПО КодыВоВнешнихСистемахСрезПоследних.Код = _ТаблицаИдентификаторов.id
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КодыПайщиков.Объект КАК Ссылка,
		|	_КодыПайщиков.Код КАК ИдентификаторПользователя,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Регистратор КАК АнкетаСсылка,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Период КАК ДатаАнкетныхДанных,
		|	_КодыПайщиков.ПоЗаявкеНаИзмениеПерсональныхДанных КАК ПоЗаявкеНаИзмениеПерсональныхДанных,
		|	НЕОПРЕДЕЛЕНО КАК attachments
		|ИЗ
		|	_КодыВоВнешнихСистемах КАК _КодыПайщиков
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&ДатаКонецДня,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И ЮрФизЛицо В
		|						(ВЫБРАТЬ
		|							_КодыПайщиков.Объект
		|						ИЗ
		|							_КодыВоВнешнихСистемах КАК _КодыПайщиков)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ПО _КодыПайщиков.Объект = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	РАЗНОСТЬДАТ(ЕСТЬNULL(РеквизитыФизическихЛицАнкетныеСрезПоследних.Период, ДАТАВРЕМЯ(2000, 1, 1)), &ДатаНачалоДня, ДЕНЬ) > 0"; 
		
#КонецОбласти
	
	Запрос.УстановитьПараметр("ТаблицаИдентификаторов",	ТаблицаИдентификаторов);
	Запрос.УстановитьПараметр("Организация",			ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаНачалоДня",			НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("ДатаКонецДня",			КонецДня(ЭтотОбъект.Дата));
	
	ТаблицаАнкет = Запрос.Выполнить().Выгрузить(); 
	
	СуществующиеКлиенты = Запрос.МенеджерВременныхТаблиц.Таблицы["_КодыВоВнешнихСистемах"].ПолучитьДанные().Выгрузить().ВыгрузитьКолонку("Код");
	
	Для Каждого СтрокаИдентификаторов Из ТаблицаИдентификаторов Цикл 
		
		СтрокаТаблицы = ТаблицаАнкет.Найти(СтрокаИдентификаторов.id, "ИдентификаторПользователя");
		
		Если СтрокаТаблицы = Неопределено И СуществующиеКлиенты.Найти(СтрокаИдентификаторов.id) = Неопределено Тогда
			
			НоваяСтрока = ТаблицаАнкет.Добавить();
			НоваяСтрока.ИдентификаторПользователя = СтрокаИдентификаторов.id;
			НоваяСтрока.ПоЗаявкеНаИзмениеПерсональныхДанных = СтрокаИдентификаторов.ПоЗаявкеНаИзмениеПерсональныхДанных;
			
		ИначеЕсли СтрокаТаблицы <> Неопределено И СтрокаТаблицы.ПоЗаявкеНаИзмениеПерсональныхДанных Тогда
			СтрокаТаблицы.attachments = СтрокаИдентификаторов.attachments;
		КонецЕсли;
			
	КонецЦикла;
				
	Если ТаблицаАнкет.Количество() = 0 Тогда
		ЗафиксироватьСообщение("Отсутствуют данные для загрузки.", Ложь);
		Возврат;
	КонецЕсли;
		
	ДанныеПользователей = ДесериализоватьДанныеПользователейЕсиа(ТаблицаАнкет, ПараметрыПодключения);
	
	Если ДанныеПользователей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	СформироватьИЗагрузитьАнкеты(ДанныеПользователей, ПараметрыПодключения, НовыеКодыАнкет);
	
	ДесериализоватьДанныеБанковскихСчетовЕсиа(ДанныеПользователей, ПараметрыПодключения);
		
КонецПроцедуры

Процедура СформироватьИЗагрузитьАнкеты(ДанныеПользователей, ПараметрыПодключения, НовыеКодыАнкет = Неопределено) 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область Текст_запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеПользователей.Ссылка КАК Ссылка,
		|	ДанныеПользователей.Идентификатор КАК Идентификатор,
		|	ДанныеПользователей.Фамилия КАК Фамилия,
		|	ДанныеПользователей.Имя КАК Имя,
		|	ДанныеПользователей.Отчество КАК Отчество,
		|	ДанныеПользователей.ДатаРождения КАК ДатаРождения,
		|	ДанныеПользователей.ИНН КАК ИНН,
		|	ДанныеПользователей.СНИЛС КАК СНИЛС,
		|	ДанныеПользователей.СерияУдостоверенияЛичности КАК СерияУдостоверенияЛичности,
		|	ДанныеПользователей.НомерУдостоверенияЛичности КАК НомерУдостоверенияЛичности,
		|	ДанныеПользователей.ГражданствоСтр КАК ГражданствоСтр,
		|	ДанныеПользователей.ДопГражданстваСтр КАК ДопГражданстваСтр,
		|	ДанныеПользователей.РезиденстваСтр КАК РезиденстваСтр,
		|	ДанныеПользователей.КодСтраныВыдачиДокумента КАК КодСтраныВыдачиДокумента,
		|	ДанныеПользователей.ВидДокументаСтр КАК ВидДокументаСтр,
		|	ДанныеПользователей.Телефоны КАК Телефоны,
		|	ДанныеПользователей.АнкетаСсылка КАК АнкетаСсылка,
		|	ДанныеПользователей.ДатаАктуальности КАК ДатаАктуальности,
		|	ДанныеПользователей.ДатаВыдачиУдостоверенияЛичности КАК ДатаВыдачиУдостоверенияЛичности,
		|	ДанныеПользователей.ОрганВыдавшийУдостоверениеЛичности КАК ОрганВыдавшийУдостоверениеЛичности,
		|	ДанныеПользователей.КодОрганаВыдавшегоУдостоверениеЛичности КАК КодОрганаВыдавшегоУдостоверениеЛичности
		|ПОМЕСТИТЬ _ДанныеПользователей
		|ИЗ
		|	&ДанныеПользователей КАК ДанныеПользователей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия КАК Фамилия,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя КАК Имя,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество КАК Отчество,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаРождения КАК ДатаРождения,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.СНИЛС КАК СНИЛС,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.СерияУдостоверенияЛичности КАК СерияУдостоверенияЛичности,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.НомерУдостоверенияЛичности КАК НомерУдостоверенияЛичности,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Телефоны КАК Телефоны,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаВыдачиУдостоверенияЛичности КАК ДатаВыдачиУдостоверенияЛичности,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ОрганВыдавшийУдостоверениеЛичности КАК ОрганВыдавшийУдостоверениеЛичности,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.КодОрганаВыдавшегоУдостоверениеЛичности КАК КодОрганаВыдавшегоУдостоверениеЛичности
		|ПОМЕСТИТЬ _ДанныеФизЛицИзУчетнойСистемы
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&ДатаКонецДня,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеПользователей.Идентификатор КАК Идентификатор,
		|	ВЫБОР
		|		КОГДА _ДанныеПользователей.Ссылка = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА ЕСТЬNULL(_СверкаПоФИОПаспортуИТелефону.ЮрФизЛицо, ЕСТЬNULL(_СверкаПоФИОПаспортуБезТелефона.ЮрФизЛицо, ЕСТЬNULL(_СверкаПоФИОТелефонуБезПаспорта.ЮрФизЛицо, ЕСТЬNULL(_СверкаПоФИОПаспорту.ЮрФизЛицо, ЕСТЬNULL(_СверкаПоДРиПаспорту.ЮрФизЛицо, _СверкаПоПаспорту.ЮрФизЛицо)))))
		|		ИНАЧЕ _ДанныеПользователей.Ссылка
		|	КОНЕЦ КАК ФизЛицо,
		|	ВЫБОР
		|		КОГДА _ДанныеПользователей.Ссылка <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА 1
		|		КОГДА НЕ _СверкаПоФИОПаспортуИТелефону.ЮрФизЛицо ЕСТЬ NULL
		|			ТОГДА 2
		|		КОГДА НЕ _СверкаПоФИОПаспортуБезТелефона.ЮрФизЛицо ЕСТЬ NULL
		|			ТОГДА 3
		|		КОГДА НЕ _СверкаПоФИОТелефонуБезПаспорта.ЮрФизЛицо ЕСТЬ NULL
		|			ТОГДА 4
		|		КОГДА НЕ _СверкаПоФИОПаспорту.ЮрФизЛицо ЕСТЬ NULL
		|			ТОГДА 5
