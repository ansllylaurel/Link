
#Область Интерфейс

Процедура ВыполнитьМетод(Метод, Экземпляры) Экспорт
     
	Если Метод = "ЭкспортироватьСписокДляСверки" Тогда
		ЭкспортироватьСписокДляСверки(Экземпляры);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Процедура ЭкспортироватьСписокДляСверки(Экземпляры)
	
	Идентификатор	= Экземпляры[0].Идентификатор;
	Параметры		= Экземпляры[0].Параметры;
	
	ЭтотОбъект.Организация	= Параметры.Организация;
	ВидСписка				= Параметры.ВидСписка;		
	ПутьКФайлу				= Параметры.ПутьКФайлу;
		
	Отказ = Ложь;
	ВидСпискаСтрокой = ""; 
	
	Если ВидСписка = Справочники.ВидыПеречнейОбъектов.СписокТеррористов Тогда
		ВидСпискаСтрокой = "possible_terrorists";
	ИначеЕсли ВидСписка = Справочники.ВидыПеречнейОбъектов.СписокОтказников Тогда
		ВидСпискаСтрокой = "operation_cancels";
	ИначеЕсли ВидСписка = Справочники.ВидыПеречнейОбъектов.СводныйПереченьСоветаБезопасностиООН Тогда
		ВидСпискаСтрокой = "uns";
	ИначеЕсли ВидСписка = Справочники.ВидыПеречнейОбъектов.СписокРешенийМВК Тогда
		ВидСпискаСтрокой = "frozen_assets";		
	Иначе
		ВызватьИсключение "Недопустимый вид перечня для выгрузки в ЛКК (" + СокрЛП(ВидСписка) +")";		
	КонецЕсли;
			
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПутьКФайлу));
	
	ЭкспортСпискаДляПроверки(ВидСпискаСтрокой, АдресВоВременномХранилище, ПутьКФайлу, Отказ);
		
	РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(Идентификатор, Отказ);
	
	ОповеститьОбОшибках();
	 
КонецПроцедуры

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	ЭтотОбъект.Дата = ТекущаяДатаСеанса(); 
		
	ЭтотОбъект.Организация	= ПараметрыКоманды.Организация;
	ЭтотОбъект.Пиф			= ПараметрыКоманды.Пиф;
		
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.Организация) Тогда 
		
		ЗафиксироватьСообщение("Не указан параметр [Организация]. Команда импорта заявок пайщиков из системы ЕСИА.Финанс отклонена.");
		
	ИначеЕсли ИдентификаторКоманды = "ИмпортЗаявокПайщиковИзЛКК" Тогда
		
		ИмпортироватьЗаявкиПайщиков(Перечисления.ВидыЗаявокПайщиков.Зачисление);
		ИмпортироватьЗаявкиПайщиков(Перечисления.ВидыЗаявокПайщиков.Погашение);
		ИмпортироватьЗаявкиПайщиков(Перечисления.ВидыЗаявокПайщиков.Обмен);
		
	Иначе
		ЗафиксироватьСообщение("Для команды [" + ИдентификаторКоманды + "] не определены действия.");	
	КонецЕсли;
		
	ОповеститьОбОшибках();
	
КонецПроцедуры

Процедура ВыгрузитьСтоимостьПаев(ЦенаПая, СЧА, Отказ = Ложь) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК КодПифа
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды)
		|				И Объект = &Пиф) КАК КодыВоВнешнихСистемахСрезПоследних";
	Запрос.УстановитьПараметр("Пиф", ЭтотОбъект.Пиф);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ПараметрыПодключения = ПолучитьПараметрыПодключения(); 
		
		СтруктураЗапроса = Новый Структура();
		СтруктураЗапроса.Вставить("fund_code", Формат(Выборка.КодПифа, "ЧГ=0"));	
		СтруктураЗапроса.Вставить("date", Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy"));
		СтруктураЗапроса.Вставить("value", ЦенаПая);
		СтруктураЗапроса.Вставить("scha_value", СЧА);
		
		СтруктураЗапроса = Новый Структура("data", РаботаСКоллекциями.ЗначениеВМассив(СтруктураЗапроса));
		
		ТекТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
				
		ТекстСообщения = "Не удалось выполнить запрос.";
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office/portfolio/import?import_type=fund_values", ТекТелоЗапроса, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ЗафиксироватьСообщение(ТекстСообщения);
			Отказ = Истина;
		Иначе
			ЗафиксироватьСообщение("На дату [" + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy") + "] выгружена сумма СЧА [" + СЧА + "] и стоимость пая [" + ЦенаПая + "] пифа [" + ЭтотОбъект.Пиф + "]", Ложь);	
		КонецЕсли;
	
	КонецЕсли;

КонецПроцедуры 

Процедура ВыгрузитьОперацииПоПаям(ОперацияПоПаям, НомерДокумента, Отказ = Ложь) Экспорт
	
	РеквизитыОперации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОперацияПоПаям,
		Новый Структура("Пайщик, Дата, ПаевойИнвестиционныйФонд, Заявка, ДатаДокумента, СчетДоверительногоУправления",
			"Заявка.Пайщик",
			"Дата",
			"ПаевойИнвестиционныйФонд",
			"Заявка",
			"Дата",
			"СчетДоверительногоУправления"));
	
	ЭтотОбъект.Дата = РеквизитыОперации.Дата;
			
	ПараметрыПодключения = ПолучитьПараметрыПодключения(); 

	//1. Получаем остатки паев на портале Есиа.Финанс + лицевые счета
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область Текст_запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды) КАК ЭтоПиф,
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ПОМЕСТИТЬ _КодыЕсиаФинанс
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&КонецПериода,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды))
		|				И Объект В (&Объекты)) КАК КодыВоВнешнихСистемахСрезПоследних";
#КонецОбласти
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация); 
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(РеквизитыОперации.Пайщик);
	МассивОбъектов.Добавить(РеквизитыОперации.ПаевойИнвестиционныйФонд);
	
	Запрос.УстановитьПараметр("Объекты", МассивОбъектов);
	
	Запрос.УстановитьПараметр("ПредыдущийРабочийДень",
		Справочники.Календари.ДобавитьКДатеРабочиеДни(
			Справочники.Календари.Общероссийский,
			ЭтотОбъект.Дата,
			-2));
	
	Запрос.Выполнить();
	
	ВыборкаКодов = Запрос.МенеджерВременныхТаблиц.Таблицы["_КодыЕсиаФинанс"]. ПолучитьДанные().Выбрать();
	
	КодыСтр = "";
	
	Пока ВыборкаКодов.Следующий() Цикл
		
		Если Не ВыборкаКодов.ЭтоПиф Тогда 
			КодыСтр = КодыСтр + ?(КодыСтр = "", "?", "&") + "ids%5B%5D=" + ВыборкаКодов.Код;
		КонецЕсли; 
		
	КонецЦикла;
	
	ТаблицаДанныхЕсиа = Новый ТаблицаЗначений;
	ТаблицаДанныхЕсиа.Колонки.Добавить("КодПайщика", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки("55")));
	ТаблицаДанныхЕсиа.Колонки.Добавить("КодПифа", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки("55")));
	ТаблицаДанныхЕсиа.Колонки.Добавить("Количество", Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
	ТаблицаДанныхЕсиа.Колонки.Добавить("НомерСчета", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки("100"))); 
	
	Если ЗначениеЗаполнено(КодыСтр) Тогда
	
		ТекстСообщения = "Не удалось получить остатки паев.";
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("GET", ПараметрыПодключения, "/api/v1/back_office/users/piece_balances" + КодыСтр,, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ЗафиксироватьСообщение(ТекстСообщения,, Отказ);
			Возврат;
		КонецЕсли;
		
		ДанныеЕсиа = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
		
		Если Не (ТипЗнч(ДанныеЕсиа) = Тип("Структура") И ДанныеЕсиа.Свойство("success") И ДанныеЕсиа.success)
			Или Не ДанныеЕсиа.Свойство("balance") Тогда
		
			ЗафиксироватьСообщение("Не удалось получить данные паевого баланса пользователей ЕСИА.Финанс",, Отказ);
			Возврат;
			
		КонецЕсли;
		
		Для Каждого ТекОстаток Из ДанныеЕсиа.balance Цикл
			
			НоваяЗаписьОстатка = ТаблицаДанныхЕсиа.Добавить();
			НоваяЗаписьОстатка.КодПайщика = ТекОстаток.user_id;
			НоваяЗаписьОстатка.КодПифа = ТекОстаток.fund;
			НоваяЗаписьОстатка.Количество = ТекОстаток.count;
			НоваяЗаписьОстатка.НомерСчета = ТекОстаток.account_number;
			
		КонецЦикла;
		
	КонецЕсли;
	
#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаДанныхЕсиа.КодПайщика КАК КодПайщика,
		|	ТаблицаДанныхЕсиа.КодПифа КАК КодПифа,
		|	ТаблицаДанныхЕсиа.Количество КАК Количество,
		|	ТаблицаДанныхЕсиа.НомерСчета КАК НомерСчета
		|ПОМЕСТИТЬ _ТаблицаДанныхЕсиа
		|ИЗ
		|	&ТаблицаДанныхЕсиа КАК ТаблицаДанныхЕсиа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаДанныхЕсиа.КодПайщика КАК КодПайщика,
		|	_ТаблицаДанныхЕсиа.КодПифа КАК КодПифа,
		|	_ТаблицаДанныхЕсиа.Количество КАК Количество,
		|	_ТаблицаДанныхЕсиа.НомерСчета КАК НомерСчета,
		|	_КодыПайщиков.Объект КАК Пайщик,
		|	_КодыПифов.Объект КАК Пиф
		|ПОМЕСТИТЬ _ДанныеЕсиа
		|ИЗ
		|	_ТаблицаДанныхЕсиа КАК _ТаблицаДанныхЕсиа
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыЕсиаФинанс КАК _КодыПайщиков
		|		ПО _ТаблицаДанныхЕсиа.КодПайщика = _КодыПайщиков.Код
		|			И (НЕ _КодыПайщиков.ЭтоПиф)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыЕсиаФинанс КАК _КодыПифов
		|		ПО _ТаблицаДанныхЕсиа.КодПифа = _КодыПифов.Код
		|			И (_КодыПифов.ЭтоПиф)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КодыПайщиков.Код КАК КодПайщика,
		|	_КодыПифов.Код КАК КодПифа,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.ПаевойИнвестиционныйФонд КАК Пиф,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.Пайщик КАК Пайщик,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(&Операция) = ТИП(Документ.ЗачислениеПаев)
		|				И ЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен)
		|			ТОГДА ЗаявкаПайщика.ДепозитарныйСчетВПаевомИнвестиционномФондеДляОбмена.НомерСчета
		|		ИНАЧЕ ЗаявкаПайщика.ДепозитарныйСчет.НомерСчета
		|	КОНЕЦ КАК НомерСчета,
		|	ЗаявкаПайщика.НомерЗаявки КАК НомерЗаявки,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.КоличествоНачальныйОстаток КАК КолвоДоОперации,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.КоличествоКонечныйОстаток КАК КолвоПослеОперации,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.КоличествоОборот КАК КолвоОборот,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.СтоимостьНачальныйОстаток КАК СуммаНачОстаток,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.СтоимостьКонечныйОстаток КАК СуммаКонОстаток,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(&Операция) = ТИП(Документ.ЗачислениеПаев)
		|			ТОГДА ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.СтоимостьОборот
		|		ИНАЧЕ ЕСТЬNULL(ЗадолженностьПередПайщикамиОбороты.СуммаПриход, 0) + ЕСТЬNULL(ЗадолженностьПоНадбавкамИСкидкам.СуммаПриход, 0)
		|	КОНЕЦ КАК СуммаОперации,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиНаНачалоИКонец.КоличествоКонечныйОстаток КАК ОстатокПаевНаКонецДня,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиНаНачалоИКонец.СтоимостьКонечныйОстаток КАК СтоимостьНаКонецДня,
		|	ДолиПайщиковВИнвестиционномФондеОстаткиНаНачалоИКонец.КоличествоНачальныйОстаток КАК ОстатокПаевНаНачалоДня,
		|	ЕСТЬNULL(ФинансовыеПоказатели.Значение, 0) КАК СтоимостьПая,
		|	ЕСТЬNULL(ЗадолженностьПоНадбавкамИСкидкам.СуммаПриход, 0) КАК СуммаНадбавкиСкидки,
		|	ЕСТЬNULL(ЗадолженностьПоНДФЛОбороты.СуммаПриход, 0) КАК НДФЛ
		|ПОМЕСТИТЬ _ДанныеУчетнойСистемы
		|ИЗ
		|	РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Регистратор,
		|			Движения,
		|			Организация = &Организация
		|				И ПаевойИнвестиционныйФонд = &ПаевойИнвестиционныйФонд
		|				И Пайщик = &Пайщик) КАК ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыЕсиаФинанс КАК _КодыПифов
		|		ПО ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.ПаевойИнвестиционныйФонд = _КодыПифов.Объект
		|			И (_КодыПифов.ЭтоПиф)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыЕсиаФинанс КАК _КодыПайщиков
		|		ПО ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.Пайщик = _КодыПайщиков.Объект
		|			И (НЕ _КодыПайщиков.ЭтоПиф)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаПайщика КАК ЗаявкаПайщика
		|		ПО (ЗаявкаПайщика.Ссылка = &Заявка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&КонецПериода, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.Организация = КлиентыДоверительногоУправленияСрезПоследних.Организация
		|			И ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.ПаевойИнвестиционныйФонд = КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = ФинансовыеПоказатели.СубъектАналитики)
		|			И (ФинансовыеПоказатели.Период = &ПредыдущийРабочийДень)
		|			И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьПая))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|				&НачалоПериода,
		|				&КонецПериода,
		|				Регистратор,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|					И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.УдержаниеНадбавокПИФ), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.УдержаниеСкидокПИФ))) КАК ЗадолженностьПоНадбавкамИСкидкам
		|		ПО ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.Регистратор = ЗадолженностьПоНадбавкамИСкидкам.Регистратор
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.ОстаткиИОбороты(
		|				&НачалоПериода,
		|				&КонецПериодаГраница,
		|				,
		|				,
		|				Организация = &Организация
		|					И ПаевойИнвестиционныйФонд = &ПаевойИнвестиционныйФонд
		|					И Пайщик = &Пайщик) КАК ДолиПайщиковВИнвестиционномФондеОстаткиНаНачалоИКонец
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|				&НачалоПериода,
		|				&ТекущаяДата,
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|					И ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НДФЛ))
		|					И Основание = &Операция) КАК ЗадолженностьПоНДФЛОбороты
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|				&НачалоПериода,
		|				&КонецПериода,
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПередПайщиками)
		|					И Основание = &Операция) КАК ЗадолженностьПередПайщикамиОбороты
		|		ПО (ИСТИНА)
		|ГДЕ
		|	ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.Регистратор = &Операция
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеЕсиа.КодПайщика КАК КодЕсиа,
		|	ИСТИНА КАК КодПайщика
		|ПОМЕСТИТЬ _ОшибкиОпределенияОбъектовУчетнойСистемы
		|ИЗ
		|	_ДанныеЕсиа КАК _ДанныеЕсиа
		|ГДЕ
		|	_ДанныеЕсиа.Пайщик ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_ДанныеЕсиа.КодПифа,
		|	ЛОЖЬ
		|ИЗ
		|	_ДанныеЕсиа КАК _ДанныеЕсиа
		|ГДЕ
		|	_ДанныеЕсиа.Пиф ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеЕсиа.Пайщик КАК Пайщик,
		|	_ДанныеЕсиа.Пиф КАК Пиф,
		|	_ДанныеЕсиа.Количество КАК Количество,
		|	_ДанныеЕсиа.НомерСчета КАК НомерСчета
		|ПОМЕСТИТЬ _ВнешниеДанные
		|ИЗ
		|	_ДанныеЕсиа КАК _ДанныеЕсиа
		|ГДЕ
		|	НЕ _ДанныеЕсиа.Пайщик ЕСТЬ NULL
		|	И НЕ _ДанныеЕсиа.Пиф ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_ДанныеУчетнойСистемы.Пайщик, _ВнешниеДанные.Пайщик) КАК Пайщик,
		|	ЕСТЬNULL(_ДанныеУчетнойСистемы.Пиф, _ВнешниеДанные.Пиф) КАК Пиф,
		|	ЕСТЬNULL(_ДанныеУчетнойСистемы.НомерСчета, _ВнешниеДанные.НомерСчета) КАК НомерСчета,
		|	_ДанныеУчетнойСистемы.ОстатокПаевНаНачалоДня КАК КоличествоУчетнаяСистема,
		|	_ВнешниеДанные.Количество КАК КоличествоЕсиа
		|ПОМЕСТИТЬ _РасхожденияНачальныхОстатков
		|ИЗ
		|	_ДанныеУчетнойСистемы КАК _ДанныеУчетнойСистемы
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ВнешниеДанные КАК _ВнешниеДанные
		|		ПО _ДанныеУчетнойСистемы.Пайщик = _ВнешниеДанные.Пайщик
		|			И _ДанныеУчетнойСистемы.Пиф = _ВнешниеДанные.Пиф
		|			И _ДанныеУчетнойСистемы.НомерСчета = _ВнешниеДанные.НомерСчета
		|ГДЕ
		|	ЕСТЬNULL(_ДанныеУчетнойСистемы.ОстатокПаевНаНачалоДня, 0) <> ЕСТЬNULL(_ВнешниеДанные.Количество, 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеУчетнойСистемы.КодПайщика КАК КодПайщика,
		|	_ДанныеУчетнойСистемы.КодПифа КАК КодПифа,
		|	_ДанныеУчетнойСистемы.Пиф КАК Пиф,
		|	_ДанныеУчетнойСистемы.Пайщик КАК Пайщик,
		|	_ДанныеУчетнойСистемы.НомерСчета КАК НомерСчета,
		|	_ДанныеУчетнойСистемы.НомерЗаявки КАК НомерЗаявки,
		|	_ДанныеУчетнойСистемы.КолвоДоОперации КАК КолвоДоОперации,
		|	_ДанныеУчетнойСистемы.КолвоПослеОперации КАК КолвоПослеОперации,
		|	_ДанныеУчетнойСистемы.ОстатокПаевНаКонецДня КАК ОстатокПаевНаКонецДня,
		|	_ДанныеУчетнойСистемы.КолвоОборот КАК КолвоОборот,
		|	_ДанныеУчетнойСистемы.СуммаНачОстаток КАК СуммаНачОстаток,
		|	_ДанныеУчетнойСистемы.СтоимостьНаКонецДня КАК СтоимостьНаКонецДня,
		|	_ДанныеУчетнойСистемы.СуммаОперации КАК СуммаОперации,
		|	_ДанныеУчетнойСистемы.СтоимостьПая КАК СтоимостьПая,
		|	_ДанныеУчетнойСистемы.СуммаНадбавкиСкидки КАК СуммаНадбавкиСкидки,
		|	_ДанныеУчетнойСистемы.НДФЛ КАК НДФЛ
		|ИЗ
		|	_ДанныеУчетнойСистемы КАК _ДанныеУчетнойСистемы
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнешниеДанные КАК _ВнешниеДанные
		|		ПО _ДанныеУчетнойСистемы.Пайщик = _ВнешниеДанные.Пайщик
		|			И _ДанныеУчетнойСистемы.Пиф = _ВнешниеДанные.Пиф
		|			И _ДанныеУчетнойСистемы.НомерСчета = _ВнешниеДанные.НомерСчета
		|			И _ДанныеУчетнойСистемы.ОстатокПаевНаНачалоДня = _ВнешниеДанные.Количество
		|			И (_ДанныеУчетнойСистемы.КолвоОборот > 0)";
#КонецОбласти	

	Запрос.УстановитьПараметр("Операция",						ОперацияПоПаям);
	Запрос.УстановитьПараметр("ТаблицаДанныхЕсиа",				ТаблицаДанныхЕсиа);
	Запрос.УстановитьПараметр("Пайщик",							РеквизитыОперации.Пайщик);
	Запрос.УстановитьПараметр("ПаевойИнвестиционныйФонд",		РеквизитыОперации.ПаевойИнвестиционныйФонд);
	Запрос.УстановитьПараметр("Заявка",							РеквизитыОперации.Заявка);	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	РеквизитыОперации.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("КонецПериодаГраница",			Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ТекущаяДата",					ТекущаяДатаСеанса());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	МассивОпераций = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		Операция = Новый Структура(); 
				
		Операция.Вставить("account",	Выборка.НомерСчета);													//Лицевой счет клиента в реестре фонда
		Операция.Вставить("all",		Выборка.СуммаОперации);													//Сумма операции
		Операция.Вставить("base",		СокрЛП(Выборка.НомерЗаявки));											//Основание операции
		Операция.Вставить("cost",		Выборка.СтоимостьНаКонецДня);											//Блок оценочной стоимости остатка паев
		Операция.Вставить("date",		Формат(РеквизитыОперации.ДатаДокумента, "ДФ=dd.MM.yyyy"));				//Дата операции
		Операция.Вставить("fund",		Выборка.КодПифа);														//Идентификатор фонда
		Операция.Вставить("id",			НомерДокумента);														//Номер операции
		Операция.Вставить("mark",		Выборка.СуммаНадбавкиСкидки);											//сумма скидки/надбавки
		Операция.Вставить("num",		Выборка.КолвоОборот);													//количество паев по операции
		Операция.Вставить("points",		0);																		//Бонусные баллы по операции
		Операция.Вставить("quantity",	Выборка.ОстатокПаевНаКонецДня);											//Количество паев на конец дня. для всех операций в течение дня должно быть одинаковое значение
		Операция.Вставить("restin",		Выборка.КолвоДоОперации);												//Остаток паев до проведения операции
		Операция.Вставить("restout",	Выборка.КолвоПослеОперации);											//Количество паев после операции
		Операция.Вставить("sumall",		Выборка.СуммаОперации - Выборка.СуммаНадбавкиСкидки - Выборка.НДФЛ);	//Сумма приобретения/погашения паев (включая комиссии) 
		Операция.Вставить("tax",		Выборка.НДФЛ);															//Налог (НДФЛ)
		Операция.Вставить("type",		
			?(ТипЗнч(ОперацияПоПаям) = Тип("ДокументСсылка.ЗачислениеПаев"), 1, 2));							//1 - Приобретение (зачисление) паев, 2 - Погашение (списание) паев		
		Операция.Вставить("user",		Выборка.КодПайщика);													//Код пайщика (pifs_portfolio_code)
		Операция.Вставить("value",		Выборка.СтоимостьПая);													//Стоимость пая на отчётную дату, предшествующую операции
		
		МассивОпераций.Добавить(Операция);
	
	КонецЦикла; 
	
	СтруктураЗапроса = Новый Структура("data", МассивОпераций);
	
	ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);

	ТекстСообщения = "Не удалось выполнить запрос.";

	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office/portfolio/import?import_type=pifs_operations_data", ТелоЗапроса, ТекстСообщения);
	
	Если HTTPОтвет = Неопределено Тогда
		ЗафиксироватьСообщение(ТекстСообщения,, Отказ);
	Иначе
		ЗафиксироватьСообщение("Выгружены данные о зачислении паев", Ложь);
	КонецЕсли; 
	
	//отработать ошибки: расхождение остатков, отсутствие кодов, объектов
	//схлопнуть остатки на начало дня и на конец дня в разрезе лицевого счета (без операций) для сверки и для заполнения реквизита "quantity"
		
КонецПроцедуры

Процедура ВыгрузитьВводыДенежныхСредств(ТекВводДС = Неопределено, Отказ = Ложь) Экспорт
	
	Если ЗначениеЗаполнено(ТекВводДС) Тогда
		ЭтотОбъект.Дата = НачалоДня(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекВводДС, "Дата"));
	КонецЕсли;	
		
	ПараметрыПодключения = ПолучитьПараметрыПодключения(); 
	
	// Суммы нужно выгружать в копейках, т. е. умножать на 100
	Запрос = Новый Запрос;
	
#Область Текст_запроса

	Запрос.Текст =  
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ПОМЕСТИТЬ _КодыЕсиаФинанс
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&КонецПериода,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЗаявкиПайщиков))) КАК КодыВоВнешнихСистемахСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КодыПайщиков.Код КАК user_id,
		|	ВводДенежныхСредств.СтрокаБанковскойВыписки.Номер КАК order_id,
		|	ВводДенежныхСредств.Сумма * 100 КАК amount,
		|	ВводДенежныхСредств.Сумма * 100 КАК amount_no_commission,
		|	""approved"" КАК status,
		|	ВводДенежныхСредств.СтрокаБанковскойВыписки.ДатаПлатежногоДокумента КАК date,
		|	ВводДенежныхСредств.СтрокаБанковскойВыписки.НазначениеПлатежа КАК description,
		|	""643"" КАК currency,
		|	""transfer"" КАК pay_type,
		|	_КодыЗаявок.Код КАК owner_id,
		|	""Claim"" КАК owner_type,
		|	ВводДенежныхСредств.Дата КАК uk_date,
		|	""purchase"" КАК operation_type
		|ИЗ
		|	Документ.ВводДенежныхСредств КАК ВводДенежныхСредств
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КодыЕсиаФинанс КАК _КодыЗаявок
		|		ПО ВводДенежныхСредств.Основание = _КодыЗаявок.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыЕсиаФинанс КАК _КодыПайщиков
		|		ПО ВводДенежныхСредств.Основание.Пайщик = _КодыПайщиков.Объект
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ВводДенежныхСредств <> НЕОПРЕДЕЛЕНО
		|				ТОГДА ВводДенежныхСредств.Ссылка = &ВводДенежныхСредств
		|			ИНАЧЕ ВводДенежныхСредств.Организация = &Организация
		|					И (ВводДенежныхСредств.Дата МЕЖДУ &НачалоПериода И &КонецПериода)
		|					И ВводДенежныхСредств.Проведен
		|		КОНЕЦ";
		
#КонецОбласти	

	Запрос.УстановитьПараметр("НачалоПериода",			НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("КонецПериода",			КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("Организация",			ЭтотОбъект.Организация); 
	Запрос.УстановитьПараметр("ВводДенежныхСредств",	ТекВводДС);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	КолонкиРезультата = РезультатЗапроса.Колонки;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	МассивОпераций = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		Операция = Новый Структура(); 
		
		Для Каждого Колонка Из КолонкиРезультата Цикл			
			Операция.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
		КонецЦикла;
		
		МассивОпераций.Добавить(Операция);
	
	КонецЦикла; 
		
	Если МассивОпераций.Количество() = 1 Тогда
		ТелоЗапроса = ПолучитьСтрокуJSON(МассивОпераций[0]);
	Иначе
		ТелоЗапроса = ПолучитьСтрокуJSON(МассивОпераций);		
	КонецЕсли;	
	
	ТекстСообщения = "Не удалось выполнить запрос.";

	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office/payments", ТелоЗапроса, ТекстСообщения);
	
	Если HTTPОтвет = Неопределено Тогда
		ЗафиксироватьСообщение(ТекстСообщения,, Отказ);
	Иначе
		ЗафиксироватьСообщение("Выгружены данные о вводе денежных средств", Ложь);
	КонецЕсли; 
			
КонецПроцедуры

Процедура СверитьОстаткиПаев()
	
	ПараметрыПодключения = ПолучитьПараметрыПодключения(); 

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды) КАК ЭтоПиф,
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _КодыЕсиаФинанс
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды))) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Дата, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО КодыВоВнешнихСистемахСрезПоследних.Объект = КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОстаткиЦенныхБумагОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	_КодыПифовЕсиаФинанс.Код КАК КодПифа,
		|	_КодыКлиентовЕсиаФинанс.Код КАК КодКлиента
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|			&Дата,
		|			Организация = &Организация
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_КодыЕсиаФинанс.СчетДоверительногоУправления
		|					ИЗ
		|						_КодыЕсиаФинанс КАК _КодыЕсиаФинанс
		|					ГДЕ
		|						НЕ _КодыЕсиаФинанс.СчетДоверительногоУправления ЕСТЬ NULL)
		|				И ВЫРАЗИТЬ(ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд В
		|					(ВЫБРАТЬ
		|						_КодыЕсиаФинанс.Объект
		|					ИЗ
		|						_КодыЕсиаФинанс КАК _КодыЕсиаФинанс
		|					ГДЕ
		|						_КодыЕсиаФинанс.ЭтоПиф)) КАК ОстаткиЦенныхБумагОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыЕсиаФинанс КАК _КодыПифовЕсиаФинанс
		|		ПО (ВЫРАЗИТЬ(ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = _КодыПифовЕсиаФинанс.Объект)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыЕсиаФинанс КАК _КодыКлиентовЕсиаФинанс
		|		ПО ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления = _КодыКлиентовЕсиаФинанс.СчетДоверительногоУправления";
	Запрос.УстановитьПараметр("Дата", ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация); 
	
	Результат = Запрос.Выполнить();
	
	ВыборкаКодов = Запрос.МенеджерВременныхТаблиц.Таблицы["_КодыЕсиаФинанс"]. ПолучитьДанные().Выбрать();
	
	КодыСтр = "";
	
	Пока ВыборкаКодов.Следующий() Цикл	
		КодыСтр = КодыСтр + ?(КодыСтр = "", "?", "&") + "ids%5B%5D=" + ВыборкаКодов.Код; 	
	КонецЦикла; 
	
	Если ЗначениеЗаполнено(КодыСтр) Тогда
		
		ТекстСообщения = "Не удалось получить остатки паев.";
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office//api/v1/back_office/users/piece_balances" + КодыСтр,, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ЗафиксироватьСообщение(ТекстСообщения);
		КонецЕсли;

	КонецЕсли;

	
КонецПроцедуры

Процедура ВыгрузитьФайлы(ЗаявкаПайщика, АдресФайла, ИмяФайла, Описание = "", Отказ = Ложь) Экспорт 
	
	//Разрешенные: doc, docx, pdf, jpeg, jpg, png, tiff, tif, zip, 7z
	
	РеквизитыЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаявкаПайщика, "Дата, Пайщик");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыЗаявок.Код КАК КодЗаявки,
		|	КодыПайщиков.Код КАК КодПайщика
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&Дата,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЗаявкиПайщиков)
		|				И Объект = &ЗаявкаПайщика) КАК КодыЗаявок,
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&Дата,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица)
		|				И Объект = &Пайщик) КАК КодыПайщиков";
	
	Запрос.УстановитьПараметр("ЗаявкаПайщика",	ЗаявкаПайщика);
	Запрос.УстановитьПараметр("Дата",			РеквизитыЗаявки.Дата);	
	Запрос.УстановитьПараметр("Пайщик",			РеквизитыЗаявки.Пайщик);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда	
		
		Разделитель = СтрЗаменить(Новый УникальныйИдентификатор(), "_", "");
	
		ТекПоток = Новый ПотокВПамяти();
		
		ЗаписьДанных = Новый ЗаписьДанных(ТекПоток,,, Символы.ВК + Символы.ПС, ""); 
		
		Если ПустаяСтрока(Описание) Тогда
			Описание = "Подтверждение от спецдепозитария от " + Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy");
		КонецЕсли;
				
		ДобавитьЗначениеПараметра(ЗаписьДанных, Разделитель, """attachment[body]""; filename=""" + ИмяФайла + """", ПолучитьИзВременногоХранилища(АдресФайла));
	    ДобавитьЗначениеПараметра(ЗаписьДанных, Разделитель, """attachment[description]""", Описание); //описание 
		ДобавитьЗначениеПараметра(ЗаписьДанных, Разделитель, """attachment[by]""", "backoffice"); //Кем загружен файл
		ДобавитьЗначениеПараметра(ЗаписьДанных, Разделитель, """attachment[state]""", "visible"); //Статус файла "Доступно для клиента", значение по умолчанию
	   	ДобавитьЗначениеПараметра(ЗаписьДанных, Разделитель, """attachment[attachmentable_id]""", Выборка.КодЗаявки); //ид заявки 
		ДобавитьЗначениеПараметра(ЗаписьДанных, Разделитель, """attachment[attachmentable_type]""", "Claim"); //Признак владельца файла(owner_id) - заявка. Пока все подгружаем к заявкам
	    ДобавитьЗначениеПараметра(ЗаписьДанных, Разделитель, """attachment[kind]""", "pifs_sd_notifications_succeed"); //тип документа - Уведомление об операции по лицевому счету
		
		ДобавитьЗначениеПараметра(ЗаписьДанных, Разделитель, """attachment[wait_for_sign]""", "false"); //ожидает подписи клиента
		//Если устанавливаем параметр wait_for_sign = false, необходимо указывать ид пользователя
		ДобавитьЗначениеПараметра(ЗаписьДанных, Разделитель, """attachment[uploader_id]""", Выборка.КодПайщика); //ид пользователя
	 
		ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель + "--");
		ЗаписьДанных.ЗаписатьСтроку("");
		
		ЗаписьДанных.Закрыть();
		
		ТекТелоЗапроса = ТекПоток.ЗакрытьИПолучитьДвоичныеДанные();
		
		ПараметрыПодключения = ПолучитьПараметрыПодключения("multipart/form-data; boundary=" + Разделитель);
		
		ТекстОшибки = "Не удалось выполнить запрос."; 
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office/attachments", ТекТелоЗапроса, ТекстОшибки, 1); 
		
		Если HTTPОтвет = Неопределено Тогда
			ЗафиксироватьСообщение(ТекстОшибки,, Отказ);
		Иначе
			МассивСтрок = СтрРазделить(ИмяФайла, "\");			
			ЗафиксироватьСообщение("К операции [" + ЗаявкаПайщика + "] загружен файл [" + МассивСтрок[МассивСтрок.Количество()-1] + "]", Ложь);	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры 

Процедура ЭкспортСпискаДляПроверки(ТипСписка, АдресФайла, ИмяФайла, Отказ = Ложь) Экспорт 
	
	МассивСтрок = СтрРазделить(ИмяФайла, "\");
	ТекИмяФайла = МассивСтрок[МассивСтрок.Количество()-1];
		
	Разделитель = СтрЗаменить(Новый УникальныйИдентификатор(), "-", "");

	ПотокЗаписиТелаЗапроса = Новый ПотокВПамяти();
	ЗаписьТелаЗапроса = Новый ЗаписьДанных(ПотокЗаписиТелаЗапроса);
	ДобавитьЗначениеПараметра(ЗаписьТелаЗапроса, Разделитель, """body""; filename=""" + ТекИмяФайла + """", ПолучитьИзВременногоХранилища(АдресФайла));
 
	ЗаписьТелаЗапроса.ЗаписатьСтроку("" + Символы.ПС); //"особенная" строка, из-за отсутствия символа ПС не загружались файлы, при этом запрос возвращал код 200 ОК.
	
	ЗаписьТелаЗапроса.ЗаписатьСтроку("--" + Разделитель + "--");
	ЗаписьТелаЗапроса.Закрыть(); 
	
	ТекТелоЗапроса = ПотокЗаписиТелаЗапроса.ЗакрытьИПолучитьДвоичныеДанные();
	
	ПараметрыПодключения = ПолучитьПараметрыПодключения("multipart/form-data; boundary=" + Разделитель);  

	ТекстОшибки = "Не удалось выполнить запрос.";
	
	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office/upload_database?database%5Bkind%5D=" + ТипСписка, ТекТелоЗапроса, ТекстОшибки, 1);

    Если HTTPОтвет = Неопределено Тогда
		ЗафиксироватьСообщение(ТекстОшибки);
		Отказ = Истина;
	Иначе
		ОтветОбъект = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
		ЗафиксироватьСообщение("Загружен файл со списком [" + ТекИмяФайла + "]. Статус загрузки [success = " + ОтветОбъект.success + "], описание статуса [" + ОтветОбъект.status_str + "].", Ложь);	
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьЗначениеПараметра(ТекЗапись, Разделитель, ОписаниеПараметра, ЗначениеПараметра)
	
	ТекЗапись.ЗаписатьСтроку("--" + Разделитель);
	ТекЗапись.ЗаписатьСтроку("Content-Disposition: form-data; name=" + ОписаниеПараметра);
	ТекЗапись.ЗаписатьСтроку("");
	
	Если ТипЗнч(ЗначениеПараметра) = Тип("Строка") Тогда
		ТекЗапись.ЗаписатьСтроку(ЗначениеПараметра);	
	ИначеЕсли ТипЗнч(ЗначениеПараметра) = Тип("ДвоичныеДанные") Тогда
		ТекЗапись.Записать(ЗначениеПараметра);	
	Иначе
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ИмпортироватьЗаявкиПайщиков(ВидЗаявок) Экспорт
	
	ПараметрыПодключения = ПолучитьПараметрыПодключения(); 
	
	ТекстОшибки = "Не удалось получить данные заявок пайщиков из системы ЕСИА.Финанс"; 
	
	//ТекстЗапроса = "/api/v1/back_office/claims?filter%5Bcreated_at%5D%5Bgt%5D=" + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy") +
	//				"&filter%5Bkind%5D=pifs_purchase";//&filter%5Bkind%5D=pifs_selling";
	
	ОтборПоДате = Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy"); 
	
	ОтборПоВидуЗаявки = "";
			
	Если ВидЗаявок = Перечисления.ВидыЗаявокПайщиков.Зачисление Тогда
		ОтборПоВидуЗаявки = "&filter%5Bkind%5D=pifs_purchase";
	ИначеЕсли ВидЗаявок = Перечисления.ВидыЗаявокПайщиков.Погашение Тогда
		ОтборПоВидуЗаявки = "&filter%5Bkind%5D=pifs_selling";	
	ИначеЕсли ВидЗаявок = Перечисления.ВидыЗаявокПайщиков.Обмен Тогда
		ОтборПоВидуЗаявки = "&filter%5Bkind%5D=pifs_exchange";
	Иначе
		ЗафиксироватьСообщение("Не удалось определить вид заявок пайщиков для импорта из системы ЕСИА.Финанс");
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "/api/v1/back_office/claims?filter%5Bcreated_at%5D%5Bgt%5D=" + ОтборПоДате + ОтборПоВидуЗаявки;
	
	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("GET", ПараметрыПодключения, ТекстЗапроса,, ТекстОшибки);
	
	Если HTTPОтвет = Неопределено Тогда
		ЗафиксироватьСообщение(ТекстОшибки);
		Возврат;
	КонецЕсли;

	ДанныеЕсиа = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
		
	Если Не (ТипЗнч(ДанныеЕсиа) = Тип("Структура") И ДанныеЕсиа.Свойство("success") И ДанныеЕсиа.success)
		Или Не ДанныеЕсиа.Свойство("claims") Тогда
		
		ЗафиксироватьСообщение("Не удалось получить данные заявок пайщиков из системы ЕСИА.Финанс");
		Возврат;	
		
	КонецЕсли;
	
	Если ДанныеЕсиа.claims.Количество() = 0 Тогда  //отсутствуют заявки
		ЗафиксироватьСообщение("В системе ЕСИА.Финанс отсутствуют заявки пайщиков на дату " + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy") + ".", Ложь);
		Возврат;	
	Конецесли;
	
	ЗаявкиПайщиков = ДесериализоватьДанныеЗаявокЕсиа(ДанныеЕсиа, ПараметрыПодключения); //заявки, банковские счета
	
	Если ЗаявкиПайщиков.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область Текст_запроса

	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаявкиПайщиков.Идентификатор КАК Идентификатор,
		|	ЗаявкиПайщиков.ВидЗаявки КАК ВидЗаявки,
		|	ЗаявкиПайщиков.Статус КАК Статус,
		|	ЗаявкиПайщиков.ИдентификаторПользователя КАК ИдентификаторПользователя,
		|	ЗаявкиПайщиков.НомерЗаявки КАК НомерЗаявки,
		|	ЗаявкиПайщиков.ДатаЗаявки КАК ДатаЗаявки,
