	ВыборкаОшибок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиИмпортаДоговоров"].ПолучитьДанные().Выбрать();
	
	Пока ВыборкаОшибок.Следующий() Цикл
		ЗафиксироватьСообщение(СтрШаблон(ВыборкаОшибок.ТекстСообщения, ВыборкаОшибок.Параметр1, ВыборкаОшибок.Параметр2));
	КонецЦикла; 
		
#Область Текст_Запроса	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	РасчетныеСчетаСтратегии.Ссылка КАК Стратегия,
		|	РасчетныеСчетаСтратегии.РасчетныйСчет КАК Ссылка,
