Процедура СформироватьИЗагрузитьАнкеты(ДанныеПользователей, БанковскиеСчета, МВТ, ПараметрыПодключения, ЗагрузитьАнкеты = Истина) 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	#Область Текст_запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеПользователей.Ссылка КАК Ссылка,
		|	ДанныеПользователей.Идентификатор КАК Идентификатор,
		|	ДанныеПользователей.Фамилия КАК Фамилия,
		|	ДанныеПользователей.Имя КАК Имя,
		|	ДанныеПользователей.Отчество КАК Отчество,
		|	ДанныеПользователей.ДатаРождения КАК ДатаРождения,
		|	ДанныеПользователей.ИНН КАК ИНН,
		|	ДанныеПользователей.СНИЛС КАК СНИЛС,
		|	ДанныеПользователей.СерияУдостоверенияЛичности КАК СерияУдостоверенияЛичности,
		|	ДанныеПользователей.НомерУдостоверенияЛичности КАК НомерУдостоверенияЛичности,
		|	ДанныеПользователей.ГражданствоСтр КАК ГражданствоСтр,
		|	ДанныеПользователей.ДопГражданстваСтр КАК ДопГражданстваСтр,
		|	ДанныеПользователей.РезиденстваСтр КАК РезиденстваСтр,
		|	ДанныеПользователей.КодСтраныВыдачиДокумента КАК КодСтраныВыдачиДокумента,
		|	ДанныеПользователей.ВидДокументаСтр КАК ВидДокументаСтр,
		|	ДанныеПользователей.Телефоны КАК Телефоны,
		|	ДанныеПользователей.АнкетаСсылка КАК АнкетаСсылка,
		|	ДанныеПользователей.ДатаАктуальности КАК ДатаАктуальности,
		|	ДанныеПользователей.ДатаВыдачиУдостоверенияЛичности КАК ДатаВыдачиУдостоверенияЛичности,
		|	ДанныеПользователей.ОрганВыдавшийУдостоверениеЛичности КАК ОрганВыдавшийУдостоверениеЛичности,
		|	ДанныеПользователей.КодОрганаВыдавшегоУдостоверениеЛичности КАК КодОрганаВыдавшегоУдостоверениеЛичности
		|ПОМЕСТИТЬ _ДанныеПользователей
		|ИЗ
		|	&ДанныеПользователей КАК ДанныеПользователей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БанковскиеСчета.Идентификатор КАК Идентификатор,
		|	БанковскиеСчета.ИдентификаторПользователя КАК ИдентификаторПользователя,
		|	БанковскиеСчета.Бик КАК Бик,
