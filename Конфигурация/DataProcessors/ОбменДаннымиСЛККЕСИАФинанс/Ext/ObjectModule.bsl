		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиОпределенияКодовСтратегий КАК _ОшибкиОпределенияКодовСтратегий
		|		ПО _ДанныеУчетнойСистемы.СчетДоверительногоУправления = _ОшибкиОпределенияКодовСтратегий.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеЕсиа КАК _ДанныеЕсиа
		|		ПО _ДанныеУчетнойСистемы.НомерДоговора = _ДанныеЕсиа.НомерДоговора
		|ГДЕ
		|	_ОшибкиОпределенияКодовДоговоров.СчетДоверительногоУправления ЕСТЬ NULL
		|	И _ОшибкиОпределенияКодовСтратегий.СчетДоверительногоУправления ЕСТЬ NULL
		|	И _ДанныеЕсиа.НомерДоговора ЕСТЬ NULL
		|	И _ДанныеУчетнойСистемы.ИдентификаторДоговора ЕСТЬ NULL
		|	И НЕ ЕСТЬNULL(_ДанныеУчетнойСистемы.ИдентификаторПользователя, _НовыеКодыПользователей.Код) ЕСТЬ NULL
		|	И _ДанныеУчетнойСистемы.Статус = ""active""";
#КонецОбласти
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	//пока создаем в ЕСИА только отсутствующие договора.
	// доработать сверку и обновление уже имеющихся данных договоров
	Пока Выборка.Следующий() Цикл

		СтруктураЗапроса = Новый Структура();
		СтруктураЗапроса.Вставить("inner_code", Выборка.НомерДоговора);
		СтруктураЗапроса.Вставить("signed_at", Формат(Выборка.ДатаДоговора, "ДФ=dd.MM.yyyy"));
		СтруктураЗапроса.Вставить("contract_owner_id", Выборка.ИдентификаторПользователя);
		СтруктураЗапроса.Вставить("contract_owner_type", "User");
		СтруктураЗапроса.Вставить("kind", "management");
		СтруктураЗапроса.Вставить("status", "active");
		СтруктураЗапроса.Вставить("is_personal_invest_account", Выборка.ФлагИИС);
		
		Если ЗначениеЗаполнено(Выборка.ИдентификаторСтратегии) Тогда
			СтруктураЗапроса.Вставить("strategy_id", Выборка.ИдентификаторСтратегии);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ДатаРасторжения) Тогда
			СтруктураЗапроса.Вставить("closed_at", Формат(Выборка.ДатаРасторжения, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		
		//********* нужно определить логику определения значения ИИС_3 *********
		//СтруктураЗапроса.Вставить("is_personal_invest_account_new", Выборка.ФлагИИС_3);
		
		ТекстСообщения = "Ошибка записи данных договора [" + Выборка.НомерДоговора + "] в ЕСИА.Финанс. Счет доверительного управления [" + Выборка.СчетДоверительногоУправления + "].";
		
		ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office/contracts", ТелоЗапроса, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ЗафиксироватьСообщение(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		ОтветОбъект = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
		
		Если ОтветОбъект["success"] = Истина И ЗначениеЗаполнено(ОтветОбъект["id"]) Тогда
			КодДоговора = Формат(ОтветОбъект["id"], "ЧГ=0");
		Иначе
			ЗафиксироватьСообщение(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(
			Выборка.СчетДоверительногоУправления, 
			Справочники.ВнешниеСистемы.ЕсиаФинанс, 
			Справочники.ГруппыИмпортируемыхОбъектов.СчетаДоверительногоУправления,
			КодДоговора);
		
	КонецЦикла;
	
	ВыборкаОшибок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиСверкиДанных"].ПолучитьДанные().Выбрать();
	
	Пока ВыборкаОшибок.Следующий() Цикл
		
		ТекстСообщения = "Расхождения в условии договора № " + Выборка.НомерДоговора + ":";
		МассивПолей = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ВыборкаОшибок.Расхождения, ",", Истина);
		
		Для Каждого ТекПоле Из МассивПолей Цикл
			ТекстСообщения = ТекстСообщения + Символы.ПС + ТекПоле + " [" + ВыборкаОшибок[ТекПоле + "Есиа"] + " (Есиа) <> " + ВыборкаОшибок[ТекПоле] + " (1С)]";
		КонецЦикла;
		
		ЗафиксироватьСообщение(ТекстСообщения);
		
	КонецЦикла;
	
	ОповеститьОбОшибках();
	
КонецПроцедуры 

Процедура ЭкспортироватьПортфели(СчетДоверительногоУправления = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область Текст_Запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаВыгрузки, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|					&ДатаВыгрузки,
		|					ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|						И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица)) КАК КодыВоВнешнихСистемахСрезПоследних
		|			ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = КодыВоВнешнихСистемахСрезПоследних.Объект
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|			И СчетаДоверительногоУправления.Организация = КлиентыДоверительногоУправленияСрезПоследних.Организация
		|			И (СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица)))
		|			И (НЕ СчетаДоверительногоУправления.ПометкаУдаления)
		|			И (&СчетДоверительногоУправления В (НЕОПРЕДЕЛЕНО, СчетаДоверительногоУправления.Ссылка))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период КАК Период,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива КАК ВидАктива,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Валюта КАК Валюта,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности КАК ВидЗадолженности,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Контрагент КАК Контрагент,
		|	СУММА(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаРынок) КАК Сумма
		|ПОМЕСТИТЬ _АктивыНеОтносящихсяКЦеннымБумагам
		|ИЗ
		|	РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ПО СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления = _СчетаДоверительногоУправления.Ссылка
		|			И (СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Организация = &Организация)
