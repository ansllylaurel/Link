		КонецЕсли;
		
        //2. создаем счет ду в 1С со всеми вытекающими.
		НачатьТранзакцию(); 
		
		НовыйСчетДоверительногоУправленияСсылка = Справочники.СчетаДоверительногоУправления.ПолучитьСсылку(Новый УникальныйИдентификатор);
		
		ЗаписьКлиентаДУ = РегистрыСведений.КлиентыДоверительногоУправления.СоздатьМенеджерЗаписи();
		ЗаписьКлиентаДУ.Период = Выборка.ДатаДоговора;
		ЗаписьКлиентаДУ.Организация	= ЭтотОбъект.Организация;
		ЗаписьКлиентаДУ.СчетДоверительногоУправления = НовыйСчетДоверительногоУправленияСсылка;
		ЗаписьКлиентаДУ.Клиент = Выборка.КлиентСсылка;
		ЗаписьКлиентаДУ.Записать(); 
		
		ЗаписьЛицензии = РегистрыСведений.ЛицензииДоговоровДоверительногоУправления.СоздатьМенеджерЗаписи();
		ЗаписьЛицензии.Период = Выборка.ДатаДоговора;
		ЗаписьЛицензии.Организация = ЭтотОбъект.Организация;
		ЗаписьЛицензии.СчетДоверительногоУправления = НовыйСчетДоверительногоУправленияСсылка;
		ЗаписьЛицензии.Лицензия = ЛицензияДоговоров;
		ЗаписьЛицензии.Действует = Истина;
		
		ЗаписьЛицензии.Записать();
		
		ВидДоговораДУ = Перечисления.ВидыДоговоровДоверительногоУправления[?((Выборка.ФлагИИС Или Выборка.ФлагИИС_3), "ИндивидуальныйИнвестиционныйСчет", "УправлениеАктивамиФизическогоЛица")];
	
		НовыйСчетДоверительногоУправленияОбъект = Справочники.СчетаДоверительногоУправления.СоздатьЭлемент(); 
		НовыйСчетДоверительногоУправленияОбъект.УстановитьСсылкуНового(НовыйСчетДоверительногоУправленияСсылка);
		НовыйСчетДоверительногоУправленияОбъект.Наименование = Выборка.КлиентФИО;
		НовыйСчетДоверительногоУправленияОбъект.Организация = ЭтотОбъект.Организация;
		НовыйСчетДоверительногоУправленияОбъект.КодСчета = Справочники.СчетаДоверительногоУправления.ОпределитьНовыйКодСчета(ЭтотОбъект.Организация, ВидДоговораДУ, Неопределено);
		НовыйСчетДоверительногоУправленияОбъект.ВидСчетаДоверительногоУправления = Перечисления.ВидыСчетовДоверительногоУправления.Договор;
		НовыйСчетДоверительногоУправленияОбъект.ВидДоговораДоверительногоУправления = ВидДоговораДУ;
		НовыйСчетДоверительногоУправленияОбъект.НомерДоговора = Выборка.НомерДоговора;
		НовыйСчетДоверительногоУправленияОбъект.ДатаЗаключения = Выборка.ДатаДоговора;
		НовыйСчетДоверительногоУправленияОбъект.Записать(); 
		
		Если ЗначениеЗаполнено(Выборка.СтратегияСсылка) Тогда
		
			ЗаписьСтратегииИнвестирования = РегистрыСведений.СтратегииИндивидуальногоИнвестирования.СоздатьМенеджерЗаписи();
			ЗаписьСтратегииИнвестирования.Период = Выборка.ДатаДоговора;
			ЗаписьСтратегииИнвестирования.Организация = ЭтотОбъект.Организация;
			ЗаписьСтратегииИнвестирования.СчетДоверительногоУправления = НовыйСчетДоверительногоУправленияСсылка;
			ЗаписьСтратегииИнвестирования.Стратегия = Выборка.СтратегияСсылка;
			ЗаписьСтратегииИнвестирования.Записать();
			
			СчетаСтратегии = ТаблицаСчетов.НайтиСтроки(Новый Структура("Стратегия", Выборка.СтратегияСсылка));
			
			Для Каждого ТекущийСчет Из СчетаСтратегии Цикл
				
				Если ТекущийСчет.ТипСчета = "РасчетныйСчет" Тогда
					ЗаписьИсполнителя = РегистрыСведений.ИсполнителиПоДенежнымСредствамСобственные.СоздатьМенеджерЗаписи();
				Иначе //депозитарный
					ЗаписьИсполнителя = РегистрыСведений.ИсполнителиПоЦеннымБумагам.СоздатьМенеджерЗаписи();
				КонецЕсли;
				
					ЗаписьИсполнителя.Период = Выборка.ДатаДоговора;
					ЗаписьИсполнителя.Организация = ЭтотОбъект.Организация;
					ЗаписьИсполнителя.СчетДоверительногоУправления = НовыйСчетДоверительногоУправленияСсылка;
					ЗаписьИсполнителя[ТекущийСчет.ТипСчета] = ТекущийСчет.Ссылка;
					ЗаписьИсполнителя.Записать();
				
			КонецЦикла;
				
		КонецЕсли; 
			
		Справочники.СчетаДоверительногоУправления.ЗаполнитьСопутствующиеНастройкиНовогоСчета(НовыйСчетДоверительногоУправленияСсылка); 
		
		//3. устанавливаем статус заявки "исполнена". При установке статуса "исполнена" на стороне Есиа.Финанс создается договор ду.		
		ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("status", "done"));
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("PATCH", ПараметрыПодключения, "/api/v1/back_office/claims/" + Выборка.ИдентификаторЗаявки, ТелоЗапроса, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			
			ЗафиксироватьСообщение(СтрШаблон(ТекстСообщения, "Исполнена"));	
			
			ОтменитьТранзакцию();
			Продолжить;
			
		КонецЕсли;
		
		СтрокаТаблицыЗаявок = ТаблицаЗаявок.Найти(Выборка.ИдентификаторЗаявки, "Идентификатор"); 
			
		Если СтрокаТаблицыЗаявок <> Неопределено Тогда
			ЗагрузитьФайлыВХранилище(НовыйСчетДоверительногоУправленияСсылка, СтрокаТаблицыЗаявок.МассивФайлов, Истина);
		КонецЕсли; 
		
		//4. получаем идентификатор Есиа.Финанс созданного договора ДУ 
		ДанныеЗаявки = ПолучитьДанныеЕсиа("claims", "claim", Выборка.ИдентификаторЗаявки,, ПараметрыПодключения);
			
		Если Не (ЗначениеЗаполнено(ДанныеЗаявки) И ЗначениеЗаполнено(ДанныеЗаявки["owner_id"])) Тогда
			
			ОтменитьТранзакцию();
			Продолжить;
			
		КонецЕсли;   
		//5. записываем идентификатор Есиа.Финанс в регистр
		РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(
			НовыйСчетДоверительногоУправленияСсылка, 
			Справочники.ВнешниеСистемы.ЕсиаФинанс, 
			Справочники.ГруппыИмпортируемыхОбъектов.СчетаДоверительногоУправления,
			Формат(ДанныеЗаявки["owner_id"], "ЧГ=0"));

		ЗафиксироватьТранзакцию(); 
					
	КонецЦикла;
	
КонецПроцедуры 

Процедура ЭкспортироватьДанныеДоговоровДоверительногоУправления(СчетДоверительногоУправления = Неопределено) Экспорт
	
	// 1. Получаем данные договоров 
	// contracts?scope=management&contract_owner_type=User&filter%5Bcreated_at%5D%5Bgt%5D=01.01.2025
	
	// 3. Сверяем полученные данные с данными в 1С.
	// 4. На основании заявок создаем новые счета ДУ в 1С, и выгружаем в Есиа данные о новом договоре.
	// 5. Настроить выгрузку данных об операциях, портфелях.
	
	// 1. Новая заявка и нет ид договора
	//		Загружаем анкету с проверками
	
	ПараметрыПодключения = ПолучитьПараметрыПодключения();
	
	ТаблицаДоговоров = ДесериализоватьДанныеДоговоровЕсиа(ПараметрыПодключения);
	
	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВРеменныхТаблиц;
	
#Область Текст_Запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаДоговоров.Идентификатор КАК Идентификатор,
		|	ТаблицаДоговоров.Статус КАК Статус,
		|	ТаблицаДоговоров.ИдентификаторПользователя КАК ИдентификаторПользователя,
		|	ТаблицаДоговоров.НомерДоговора КАК НомерДоговора,
		|	ТаблицаДоговоров.ДатаДоговора КАК ДатаДоговора,
		|	ТаблицаДоговоров.ДатаРасторжения КАК ДатаРасторжения,
		|	ТаблицаДоговоров.ИдентификаторСтратегии КАК ИдентификаторСтратегии,
		|	ТаблицаДоговоров.ФлагИИС КАК ФлагИИС,
		|	ТаблицаДоговоров.ФлагИИС_3 КАК ФлагИИС_3
		|ПОМЕСТИТЬ _ТаблицаДоговоров
		|ИЗ
		|	&ТаблицаДоговоров КАК ТаблицаДоговоров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.ГруппаОбъектов КАК ГруппаОбъектов,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ПОМЕСТИТЬ _КодыВоВнешнихСистемах
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&ДатаВыгрузки,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|				И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.СчетаДоверительногоУправления), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.СтратегииИндивидуальногоИнвестирования), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.АнкетыФизическихЛиц))) КАК КодыВоВнешнихСистемахСрезПоследних
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаДоговоров.Идентификатор КАК ИдентификаторДоговора,
		|	_ТаблицаДоговоров.Статус КАК Статус,
		|	_ТаблицаДоговоров.ИдентификаторПользователя КАК ИдентификаторПользователя,
		|	_ТаблицаДоговоров.НомерДоговора КАК НомерДоговора,
		|	_ТаблицаДоговоров.ДатаДоговора КАК ДатаДоговора,
		|	_ТаблицаДоговоров.ДатаРасторжения КАК ДатаРасторжения,
		|	_ТаблицаДоговоров.ИдентификаторСтратегии КАК ИдентификаторСтратегии,
		|	_ТаблицаДоговоров.ФлагИИС КАК ФлагИИС,
		|	_ТаблицаДоговоров.ФлагИИС_3 КАК ФлагИИС_3,
		|	_КодыДоговоров.Объект КАК ДоговорСсылка,
		|	_КодыКлиентов.Объект КАК КлиентСсылка,
		|	_КодыАнкет.Объект КАК АнкетаСсылка,
		|	_КодыСтратегий.Объект КАК СтратегияСсылка
		|ПОМЕСТИТЬ _ДанныеЕсиа
		|ИЗ
		|	_ТаблицаДоговоров КАК _ТаблицаДоговоров
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВоВнешнихСистемах КАК _КодыДоговоров
		|		ПО _ТаблицаДоговоров.Идентификатор = _КодыДоговоров.Код
		|			И (_КодыДоговоров.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.СчетаДоверительногоУправления))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВоВнешнихСистемах КАК _КодыКлиентов
		|		ПО _ТаблицаДоговоров.ИдентификаторПользователя = _КодыКлиентов.Код
		|			И (_КодыКлиентов.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВоВнешнихСистемах КАК _КодыАнкет
		|		ПО _ТаблицаДоговоров.ИдентификаторПользователя = _КодыАнкет.Код
		|			И (_КодыАнкет.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.АнкетыФизическихЛиц))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВоВнешнихСистемах КАК _КодыСтратегий
		|		ПО _ТаблицаДоговоров.ИдентификаторСтратегии = _КодыСтратегий.Код
		|			И (_КодыСтратегий.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.СтратегииИндивидуальногоИнвестирования))
		|ГДЕ
		|	_ТаблицаДоговоров.Статус <> ""wrong""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеЕсиа.ИдентификаторДоговора КАК ИдентификаторДоговора,
		|	_ДанныеЕсиа.ИдентификаторПользователя КАК Код,
		|	""Не удалось определить физ лицо по коду Есиа [%1]"" КАК ТекстСообщения
		|ПОМЕСТИТЬ _ОшибкиОпределенияОбъектовУчетнойСистемы
		|ИЗ
		|	_ДанныеЕсиа КАК _ДанныеЕсиа
		|ГДЕ
		|	_ДанныеЕсиа.ДоговорСсылка ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_ДанныеЕсиа.ИдентификаторДоговора,
		|	_ДанныеЕсиа.ИдентификаторДоговора,
		|	""Не удалось определить счет доверительного управления по коду Есиа [%1]""
		|ИЗ
		|	_ДанныеЕсиа КАК _ДанныеЕсиа
		|ГДЕ
		|	_ДанныеЕсиа.КлиентСсылка ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_ДанныеЕсиа.ИдентификаторДоговора,
		|	_ДанныеЕсиа.ИдентификаторСтратегии,
		|	""Не удалось определить стратегию по коду Есиа [%1]""
		|ИЗ
		|	_ДанныеЕсиа КАК _ДанныеЕсиа
		|ГДЕ
		|	_ДанныеЕсиа.СтратегияСсылка ЕСТЬ NULL
		|	И _ДанныеЕсиа.ИдентификаторСтратегии <> """"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ СчетаДоверительногоУправления.ДатаРасторжения > &ДатаВыгрузки
		|			ТОГДА ""active""
		|		ИНАЧЕ ""closed""
		|	КОНЕЦ КАК Статус,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет) КАК ФлагИИС,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия КАК Стратегия
		|ПОМЕСТИТЬ _ДоговорыДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаВыгрузки, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|			И СчетаДоверительногоУправления.Организация = КлиентыДоверительногоУправленияСрезПоследних.Организация
		|			И (СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица)))
		|			И (НЕ СчетаДоверительногоУправления.ПометкаУдаления)
		|			И (&СчетДоверительногоУправления В (НЕОПРЕДЕЛЕНО, СчетаДоверительногоУправления.Ссылка))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(&ДатаВыгрузки, Организация = &Организация) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления
		|;
		|
