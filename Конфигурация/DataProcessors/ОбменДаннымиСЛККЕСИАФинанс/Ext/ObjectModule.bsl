		|	_КлассификацияОпределенияФизЛицПользователей.Класс КАК КлассОпределения
		|ПОМЕСТИТЬ _ОпределенныеФизЛица
		|ИЗ
		|	_КлассификацияОпределенияФизЛицПользователей КАК _КлассификацияОпределенияФизЛицПользователей
		|ГДЕ
		|	_КлассификацияОпределенияФизЛицПользователей.Класс <= &КлассОпределенияЮрЛица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОпределенныеФизЛица.Идентификатор КАК Идентификатор,
		|	_ОпределенныеФизЛица.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _ФизЛицаСНовымПаспортом
		|ИЗ
		|	_ОпределенныеФизЛица КАК _ОпределенныеФизЛица
		|ГДЕ
		|	_ОпределенныеФизЛица.КлассОпределения = 4
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеПользователей.Идентификатор КАК Идентификатор,
		|	_ДанныеПользователей.ГражданствоСтр = ВРЕГ(СтраныМира.НаименованиеПолное) КАК СтранаГражданства,
		|	СТРНАЙТИ(СтраныМира.Наименование, _ДанныеПользователей.ДопГражданстваСтр) > 0 КАК СтранаДопГражданства,
		|	СТРНАЙТИ(СтраныМира.Наименование, _ДанныеПользователей.РезиденстваСтр) > 0 КАК СтранаРезиденства,
		|	_ДанныеПользователей.КодСтраныВыдачиДокумента КАК КодСтраныВыдачиДокумента,
		|	_ДанныеПользователей.КодСтраныВыдачиДокумента = СтраныМира.КодАльфа2 КАК СтранаВыдачиДокумента,
		|	ВЫБОР
		|		КОГДА _ДанныеПользователей.КодСтраныВыдачиДокумента = СтраныМира.КодАльфа2
		|			ТОГДА ВЫБОР
		|					КОГДА _ДанныеПользователей.ВидДокументаСтр = ""passport""
		|						ТОГДА ВЫБОР
		|								КОГДА СтраныМира.Ссылка = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
		|									ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ)
		|								ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПаспортИностранногоГражданина)
		|							КОНЕЦ
		|					КОГДА _ДанныеПользователей.ВидДокументаСтр = ""driver_license""
		|						ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ВодительскоеУдостоверение)
		|					КОГДА _ДанныеПользователей.ВидДокументаСтр = ""residence_permit""
		|						ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ВидНаЖительство)
		|				КОНЕЦ
		|	КОНЕЦ КАК ВидДокумента,
		|	_ДанныеПользователей.ВидДокументаСтр КАК ВидДокументаСтр,
		|	СтраныМира.Ссылка КАК СтранаСсылка
		|ИЗ
		|	_ДанныеПользователей КАК _ДанныеПользователей
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
		|		ПО (_ДанныеПользователей.ГражданствоСтр = ВРЕГ(СтраныМира.НаименованиеПолное)
		|				ИЛИ _ДанныеПользователей.КодСтраныВыдачиДокумента = СтраныМира.КодАльфа2
		|				ИЛИ СТРНАЙТИ(СтраныМира.Наименование, _ДанныеПользователей.ДопГражданстваСтр + _ДанныеПользователей.РезиденстваСтр) > 0)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Идентификатор";
#КонецОбласти

	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаКонецДня", КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("ДанныеПользователей", ДанныеПользователей);
	Запрос.УстановитьПараметр("БанковскиеСчета", БанковскиеСчета);
	Запрос.УстановитьПараметр("КлассОпределенияЮрЛица", 4);

	РезультатЗапроса = Запрос.Выполнить();
	
	//Если анкеты не нужно загружать, далее используются ВТ этого запроса 
	Если Не ЗагрузитьАнкеты Тогда
		Возврат;
	КонецЕсли;	
	
	// По неопределеным лицам отправляем оповещение, т. к. их нужно вручную рассмотреть клиентскому отделу
	ФизЛицаДляРучнойОбработки = Запрос.МенеджерВременныхТаблиц.Таблицы["_ФизЛицаДляРучнойОбработки"].ПолучитьДанные().Выгрузить();
	Если ФизЛицаДляРучнойОбработки.Количество() > 0 Тогда
		
		ТекстОповещения = "Из ЛКК не загружены анкеты клиентов, требуется обработка вручную:";
		Для Каждого СтрокаФизЛицаДляРучнойОбработки Из ФизЛицаДляРучнойОбработки Цикл
			
			ТекстОповещения = СтрШаблон("%1 %2- %3, идентификатор в ЛКК %4, причина: %5",
								ТекстОповещения,
								Символы.ВК,
								СтрокаФизЛицаДляРучнойОбработки.ФИО,
								СтрокаФизЛицаДляРучнойОбработки.Идентификатор,
								СтрокаФизЛицаДляРучнойОбработки.Причина);
			
			
		КонецЦикла;	
				
		РеквизитыОповещения = Новый Структура("Тема, Текст", "Не загружены анкеты клиентов из ЛКК", ТекстОповещения);
		Справочники.Оповещения.СформироватьОповещения(ЭтотОбъект.Метаданные().ПолноеИмя() + ".ЗагрузкаАнкет", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
	КонецЕсли;	
	
	// По физлицам с новыми паспортными данными отправляем оповещение, т. к. их нужно заблокировать в ЛКК
	ФизЛицаСНовымПаспортом = Запрос.МенеджерВременныхТаблиц.Таблицы["_ФизЛицаСНовымПаспортом"].ПолучитьДанные().Выгрузить();
	Если ФизЛицаСНовымПаспортом.Количество() > 0 Тогда
		
		ТекстОповещения = "Из ЛКК загружены анкеты клиентов с отличающимися паспортными данными, в ЛКК для них необходимо проверить блокировку на операции с паями:";
		Для Каждого СтрокаФизЛицаСНовымПаспортом Из ФизЛицаСНовымПаспортом Цикл
			
			ТекстОповещения = СтрШаблон("%1 %2- %3, идентификатор в ЛКК %4.",
								ТекстОповещения,
								Символы.ВК,
								СтрокаФизЛицаСНовымПаспортом.Ссылка,
								СтрокаФизЛицаСНовымПаспортом.Идентификатор);
			                  		
		КонецЦикла;	
				
		РеквизитыОповещения = Новый Структура("Тема, Текст", "Из ЛКК загружены анкеты клиентов с отличающимися паспортами", ТекстОповещения);
		Справочники.Оповещения.СформироватьОповещения(ЭтотОбъект.Метаданные().ПолноеИмя() + ".ЗагрузкаАнкет", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	//Дополняем анкетные данные ссылками на справочник "СтраныМира"		
	СтрокаТаблицы = Неопределено;
	
	Пока Выборка.Следующий() Цикл
		
		Если СтрокаТаблицы = Неопределено 
			Или СтрокаТаблицы.Идентификатор <> Выборка.Идентификатор Тогда 
			
			СтрокаТаблицы = ДанныеПользователей.Найти(Выборка.Идентификатор, "Идентификатор");
			
			Если СтрокаТаблицы = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Выборка.СтранаГражданства Тогда
			СтрокаТаблицы.Гражданство = Выборка.СтранаСсылка;
		КонецЕсли;
		
		Если Выборка.СтранаДопГражданства Тогда
			СтрокаТаблицы.АнкетныеДанные.ВтороеГражданство.Добавить(Выборка.СтранаСсылка);
		КонецЕсли;
		
		Если Выборка.СтранаВыдачиДокумента Тогда
			
			СтрокаТаблицы.ВидУдостоверенияЛичности = Выборка.ВидДокумента;
			СтрокаТаблицы.СтранаВыдачиДокумента = Выборка.СтранаСсылка;
			
			Если Не ЗначениеЗаполнено(Выборка.ВидДокумента) Тогда
				ЗафиксироватьСообщение("Не удалось определить вид документа [" + Выборка.ВидДокументаСтр + "] физ. лица [идентификатор ЕСИА.Финанс " + Выборка.Идентификатор + "]");
				Продолжить;
			КонецЕсли;
			
		КонецЕсли; 
		
		Если Выборка.СтранаРезиденства Тогда
			СтрокаТаблицы.АнкетныеДанные.НалоговыйРезидентИностранногоГосударстваГосударство.Добавить(Выборка.СтранаСсылка);
		//	СтрокаТаблицы.АнкетныеДанные.ИностранныйНалогоплательщикГосударство.Добавить(ТекСтрока.СтранаСсылка);
		КонецЕсли;
					
	КонецЦикла;
			
	МассивКодовПайщиков = Новый Массив;
	КодыСтр = "";
	
	ДанныеБанковскихСчетов = МВТ.Таблицы["_ДанныеБанковскихСчетов"].ПолучитьДанные().Выгрузить();
	ОпределенныеФизЛица = МВТ.Таблицы["_ОпределенныеФизЛица"].ПолучитьДанные().Выгрузить();
	
	Для Каждого СтрокаДанных Из ДанныеПользователей Цикл
		
		//Пропускаем лиц с ручной обработкой
		Если ФизЛицаДляРучнойОбработки.Найти(СтрокаДанных.Идентификатор, "Идентификатор") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
			
		Если СтрокаДанных.ЗаписатьКодПайщика Тогда
			МассивКодовПайщиков.Добавить(Новый Структура("id, pifs_portfolio_code", СтрокаДанных.Идентификатор, СтрокаДанных.Идентификатор));
			КодыСтр = КодыСтр + ?(КодыСтр = "", "", ", ") + СтрокаДанных.Идентификатор;
		КонецЕсли;
					
		ДокументОбъект = Документы.АнкетаФизическогоЛица.СоздатьДокумент();
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, СтрокаДанных);
		ЗаполнитьЗначенияСвойств(ДокументОбъект, СтрокаДанных.АнкетныеДанные);
		
		ТекДата = ТекущаяДатаСеанса();
		
		Если НачалоДня(ЭтотОбъект.Дата) = НачалоДня(ТекДата) Тогда
			ДокументОбъект.Дата = ТекДата;
		ИначеЕсли НачалоДня(ЭтотОбъект.Дата) > СтрокаДанных.ДатаАктуальности Тогда 
			ДокументОбъект.Дата = ЭтотОбъект.Дата;
		Иначе
			ДокументОбъект.Дата = СтрокаДанных.ДатаАктуальности;	
		КонецЕсли;
		
		ДокументОбъект.Организация = ЭтотОбъект.Организация;
		
		Если ЗначениеЗаполнено(СтрокаДанных.Ссылка) Тогда
			
			ДокументОбъект.ЮрФизЛицо = СтрокаДанных.Ссылка;
			
		Иначе
			
			СтрокаОпределенныхФизЛиц = ОпределенныеФизЛица.Найти(СтрокаДанных.Идентификатор, "Идентификатор");
				
			Если СтрокаОпределенныхФизЛиц <> Неопределено Тогда
				ДокументОбъект.ЮрФизЛицо = СтрокаОпределенныхФизЛиц.Ссылка; 
				
				Если СтрокаОпределенныхФизЛиц.КлассОпределения = 3 Тогда
					// Сообщаем об изменении телефона физ. лица
					ЗафиксироватьСообщение(СтрШаблон("У физ. лица %1 изменился номер телефона [идентификатор ЕСИА.Финанс %2]", СтрокаОпределенныхФизЛиц.Ссылка, СтрокаОпределенныхФизЛиц.Идентификатор + ""), Ложь);					
				КонецЕсли;
				
			КонецЕсли;
	
		КонецЕсли;
		
		ДокументОбъект.РезидентПо173ФЗ = Истина;
		ДокументОбъект.ВидИсточника = Перечисления.ИсточникиАнкетИЗаявок.Сайт;
		ДокументОбъект.УпрощеннаяИдентификация = Ложь;
		ДокументОбъект.ВыгодоприобретательКлиент = Истина;
		ДокументОбъект.БенефициарныйВладелецКлиент = Истина; 
		
		Для Каждого ТекГражданство Из СтрокаДанных.АнкетныеДанные.ВтороеГражданство Цикл
			ДокументОбъект.ВтороеГражданство = ТекГражданство;
			Прервать;
		КонецЦикла;
		
		Для Каждого ТекРезиденство Из СтрокаДанных.АнкетныеДанные.НалоговыйРезидентИностранногоГосударстваГосударство Цикл
			ДокументОбъект.НалоговыйРезидентИностранногоГосударстваГосударство = ТекРезиденство;
			Прервать;
		КонецЦикла;
		
		БанковскиеСчетаПользователя = ДанныеБанковскихСчетов.НайтиСтроки(Новый Структура("ИдентификаторПользователя", СтрокаДанных.Идентификатор));
		
		Для Каждого ТекСчет Из БанковскиеСчетаПользователя Цикл
			
			НоваяЗапись = ДокументОбъект.БанковскиеРеквизиты.Добавить();
			НоваяЗапись.РасчетныйСчет = ТекСчет.Ссылка; 
			ЗаполнитьЗначенияСвойств(НоваяЗапись, ТекСчет); 
			
		КонецЦикла;
		
		Попытка
	
			ДокументОбъект.ДополнительныеСвойства.Вставить("ЗагрузкаДанныхВАнкету", Истина);
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
			РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(ДокументОбъект.Ссылка,
				Справочники.ВнешниеСистемы.ЕсиаФинанс,
				Справочники.ГруппыИмпортируемыхОбъектов.АнкетыФизическихЛиц, СтрокаДанных.Идентификатор,,, ?(ЗначениеЗаполнено(СтрокаДанных.АнкетаСсылка), ДокументОбъект.Дата, Дата('19800101')));
					
			Если Не СтрокаДанных.ЕстьКодЕсиа Тогда	
				РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(ДокументОбъект.ЮрФизЛицо,
					Справочники.ВнешниеСистемы.ЕсиаФинанс,
					Справочники.ГруппыИмпортируемыхОбъектов.ФизическиеЛица, СтрокаДанных.Идентификатор);
			КонецЕсли;
				
			СтрокаДанных.Ссылка = ДокументОбъект.ЮрФизЛицо;	
					
			ЗагрузитьФайлыВХранилище(ДокументОбъект.Ссылка, СтрокаДанных.АнкетныеДанные.МассивФайлов);
			
			ЗафиксироватьСообщение("Загружена анкета физ. лица [" + ДокументОбъект.Ссылка + "]", Ложь);
		
		Исключение
			ЗафиксироватьСообщение(СтрШаблон("Не загружена анкета физ лица %1 %2 %3, идентификатор %4",
									СтрокаДанных.Фамилия,
									СтрокаДанных.Имя,
									СтрокаДанных.Отчество,
									СтрокаДанных.Идентификатор),
								Ложь);
		КонецПопытки;	
					
	КонецЦикла;
	
	// Текст результата отправляем оповещением
	КоличествоСтрокРезультата = Результат.КоличествоСтрок();
	Если КоличествоСтрокРезультата > 0 Тогда
		
		Сообщения = ПолучитьСообщенияПользователю(Истина);
		ТекстСообщений = "";
		Для Каждого Сообщение Из Сообщения Цикл
			ТекстСообщений = ТекстСообщений + Сообщение.Текст + Символы.ВК;
		КонецЦикла;
		
		СтрРезультат = "";
		Для Сч = 1 По КоличествоСтрокРезультата Цикл
			СтрРезультат = СтрРезультат + Результат.ПолучитьСтроку(Сч) + Символы.ВК + Символы.Таб;
		КонецЦикла;		
		
		ТекстРезультата = СокрЛП(СтрРезультат) + ?(ПустаяСтрока(ТекстСообщений), "", Символы.ВК + "Сообщения при проведении анкет:" + Символы.ВК + ТекстСообщений);
		
		РеквизитыОповещения = Новый Структура("Тема, Текст", "Из ЛКК загружены новые анкеты клиентов", ТекстРезультата);
		Справочники.Оповещения.СформироватьОповещения(ЭтотОбъект.Метаданные().ПолноеИмя() + ".ЗагрузкаАнкет", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
	КонецЕсли;
	
	Если МассивКодовПайщиков.Количество() > 0 Тогда
		
		ТекстСообщения = "Не удалось загрузить коды пользователей [pifs_portfolio_code] в систему ЕСИА.Финанс. " + КодыСтр; 
		
		ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("users", МассивКодовПайщиков));
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/v1/back_office/users/import", ТелоЗапроса, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ЗафиксироватьСообщение(ТекстСообщения);
		КонецЕсли;
			
	КонецЕсли;	
		
КонецПроцедуры

Функция ПодписьВалидна(СтруктураПодписи)
	
	Возврат (СтруктураПодписи.Свойство("kind") 
				И СтруктураПодписи.kind = "ses" //simple electronic signature 
				И СтруктураПодписи.Свойство("is_valid_signature") 
				И СтруктураПодписи.is_valid_signature);  
		
КонецФункции

Функция ПоследняяСтоимостьПаяИСЧАЛКК(КодПИФВЕсиаФинанс, ДатаСтоимости = Неопределено, Отказ = Ложь) Экспорт
	
	ДанныеПоПИФ = Новый Структура("СтоимостьПая, СЧА", -1, -1);
	
	ПараметрыПодключения = ПолучитьПараметрыПодключения(); 
	
	ТекстОшибки = "Не удалось получить данные по ПИФ из системы ЕСИА.Финанс"; 
		
	ТекстЗапроса = "/api/v1/back_office/funds/" + КодПИФВЕсиаФинанс;
	
	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("GET", ПараметрыПодключения, ТекстЗапроса,, ТекстОшибки);
	
	Если HTTPОтвет = Неопределено Тогда
		ЗафиксироватьСообщение(ТекстОшибки);
		Отказ = Истина;
		Возврат ДанныеПоПИФ;
	КонецЕсли;

	ДанныеЕсиа = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"), Истина);
		
	Если Не (ТипЗнч(ДанныеЕсиа) = Тип("Структура") И ДанныеЕсиа.Свойство("success") И ДанныеЕсиа.success)
		Или Не ДанныеЕсиа.Свойство("fund") Тогда
		
		ЗафиксироватьСообщение("Не удалось получить данные по ПИФ из системы ЕСИА.Финанс");
		Отказ = Истина;
		Возврат ДанныеПоПИФ;
		
	КонецЕсли;
	
	// Проверяем дату, если нужно
	Если ДатаСтоимости <> Неопределено
		И ДатаСтоимости <> XMLЗначение(Тип("Дата"), ДанныеЕсиа.fund.last_price.date) Тогда
		Отказ = Истина;
		Возврат ДанныеПоПИФ;
	КонецЕсли;	
		
	ДанныеПоПИФ.Вставить("СтоимостьПая",	ДанныеЕсиа.fund.last_price.value);
	ДанныеПоПИФ.Вставить("СЧА",				ДанныеЕсиа.fund.last_price.scha_value);
	
	Возврат ДанныеПоПИФ;
	
КонецФункции
	        
ЭтотОбъект.ДополнительныеСвойства = Новый Структура;
