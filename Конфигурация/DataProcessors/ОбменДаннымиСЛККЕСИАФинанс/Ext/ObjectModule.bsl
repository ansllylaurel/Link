		|		ПО ФинансовыеПоказатели.СубъектАналитики = _СчетаДоверительногоУправления.Ссылка
		|			И (ФинансовыеПоказатели.Организация = &Организация)
		|			И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|			И (ФинансовыеПоказатели.Период >= ДОБАВИТЬКДАТЕ(&ДатаВыгрузки, НЕДЕЛЯ, -1))
		|			И (ФинансовыеПоказатели.Значение <> 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Период КАК Период,
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВложенныйЗапрос.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВложенныйЗапрос.Цена * ВложенныйЗапрос.Количество КАК Стоимость,
		|	ВложенныйЗапрос.Количество КАК Количество,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ВложенныйЗапрос.ЦеннаяБумага) В (ТИП(Справочник.ПроизводныеФинансовыеИнструменты), ТИП(Справочник.ВалютныеПары))
		|				ИЛИ РеквизитыЮридическихЛицСрезПоследних.ИНН = """"
		|			ТОГДА КодыВТорговыхСистемахСрезПоследних.Код
		|		ИНАЧЕ РеквизитыЮридическихЛицСрезПоследних.ИНН
		|	КОНЕЦ КАК КодЭмитента,
		|	ПРЕДСТАВЛЕНИЕ(РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование) КАК ЭмитентНаименование,
		|	РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации.НаименованиеПолное КАК СтранаРегистрации,
		|	ПРЕДСТАВЛЕНИЕ(РеквизитыЮридическихЛицСрезПоследних.Отрасль) КАК Сектор,
		|	КодыВТорговыхСистемахСрезПоследних.Код КАК КодЦБ
		|ПОМЕСТИТЬ _ЦенныеБумаги
		|ИЗ
		|	(ВЫБРАТЬ
		|		СтоимостьПереоценки.Период КАК Период,
