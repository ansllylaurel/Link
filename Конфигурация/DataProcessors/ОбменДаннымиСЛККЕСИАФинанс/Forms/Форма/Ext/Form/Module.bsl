	Если Не ЗначениеЗаполнено(ЭтаФорма.ПутьКФайлу) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите файл для загрузки");
		Возврат;	
	КонецЕсли;
	
	ТипСпискаСтр = ""; 
	
	Если ЭтаФорма.ТипСписка = 1 Тогда
		ТипСпискаСтр = "possible_terrorists";
	ИначеЕсли ЭтаФорма.ТипСписка = 2 Тогда
		ТипСпискаСтр = "operation_cancels";
	ИначеЕсли ЭтаФорма.ТипСписка = 3 Тогда
		ТипСпискаСтр = "uns";
	ИначеЕсли ЭтаФорма.ТипСписка = 4 Тогда
		ТипСпискаСтр = "frozen_assets";		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите тип загружаемого списка");
		Возврат;
	КонецЕсли;
	
	Объект.Результат.Очистить();
		
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ЭтаФорма.ПутьКФайлу), ЭтаФорма.УникальныйИдентификатор);
	
	ЭкспортСпискаДляПроверкиНаСервере(ТипСпискаСтр, АдресВоВременномХранилище, ЭтаФорма.ПутьКФайлу);
	
КонецПроцедуры

