&НаСервереБезКонтекста
Процедура ПроверитьНаличиеДанныхПайщиков(Заявки, ПараметрыПодключения)
	
	ТаблицаКодов = Новый ТаблицаЗначений;
	ТаблицаКодов.Колонки.Добавить("Id", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(55)));
	
	Для Каждого ТекЗаявка Из Заявки Цикл
		
		Если ТаблицаКодов.Найти(ТекЗаявка.user_id, "Id") = Неопределено Тогда
			НоваяЗапись = ТаблицаКодов.Добавить();
			НоваяЗапись.Id = ТекЗаявка.user_id;
		КонецЕсли;
				
	КонецЦикла;
	
	Если ТаблицаКодов.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Период КАК Период,
		|	КодыВоВнешнихСистемахСрезПоследних.ВнешняяСистема КАК ВнешняяСистема,
		|	КодыВоВнешнихСистемахСрезПоследних.ГруппаОбъектов КАК ГруппаОбъектов,
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код,
		|	КодыВоВнешнихСистемахСрезПоследних.ДопКод КАК ДопКод,
		|	КодыВоВнешнихСистемахСрезПоследних.ДопКод1 КАК ДопКод1,
		|	КодыВоВнешнихСистемахСрезПоследних.ДопКод0 КАК ДопКод0,
		|	КодыВоВнешнихСистемахСрезПоследних.ХранилищеЗначения КАК ХранилищеЗначения
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&ТекДата,
		|			ВнешняяСистема = &ВнешняяСистема
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.АнкетыФизическихЛиц)
		|	И Объект В (ВЫБРАТЬ КодыАнкет.Объект ИЗ РегистрСведений.КодыВоВнешнихСистемах КАК КодыАнкет 
		|				ГДЕ КодыАнкет.ВнешняяСистема = &ВнешняяСистема И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.АнкетыФизическихЛиц)
		|				И КодыАнкет.Код В (&))) КАК КодыВоВнешнихСистемахСрезПоследних";
	Запрос.УстановитьПараметр("ВнешняяСистема", ""); //Нужно определеить внешнюю систему
	
	
	Для Каждого ТекЗапись Из ТаблицаКодов Цикл 
		
		ТекстСообщения = "Не удалось выполнить данные пользователя. ID " + ТекЗапись.Id;
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("GET", ПараметрыПодключения, "/api/v1/back_office/users/" + ТекЗапись.Id,, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
		Иначе
			ДанныеПользователя = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
		КонецЕсли;
		
		
		//проверяем наличие пайщика (физ. лица) в 1С

		
	КонецЦикла;

	
КонецПроцедуры

