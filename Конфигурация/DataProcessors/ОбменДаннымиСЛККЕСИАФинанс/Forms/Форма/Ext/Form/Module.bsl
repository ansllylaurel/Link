&НаСервере
Процедура ВыгрузитьСтоимостьПаевНаСервере()
		
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ВыгрузитьСтоимостьПаев(ЭтаФорма.ЦенаПая, ЭтаФорма.СЧА);
	ОбработкаОбъект.ОповеститьОбОшибках();

КонецПроцедуры

&НаСервере
Процедура ВыгрузитьСтоимостьПаевЗаПериодНаСервере()
		
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказатели_ЦеныПаев.Период КАК Период,
		|	ФинансовыеПоказатели_ЦеныПаев.Значение КАК РасчетнаяЦена,
		|	ФинансовыеПоказатели_СЧА.Значение КАК СЧА
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели_ЦеныПаев
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели_СЧА
		|			ПО ФинансовыеПоказатели_ЦеныПаев.Организация = ФинансовыеПоказатели_СЧА.Организация
		|				И ФинансовыеПоказатели_ЦеныПаев.СубъектАналитики = ФинансовыеПоказатели_СЧА.СубъектАналитики
		|				И ФинансовыеПоказатели_ЦеныПаев.Период = ФинансовыеПоказатели_СЧА.Период
		|				И (ФинансовыеПоказатели_СЧА.ВидПоказателя = &ВидПоказателяСЧА)
		|		ПО (ФинансовыеПоказатели_ЦеныПаев.Организация = КлиентыДоверительногоУправленияСрезПоследних.Организация)
		|			И (ФинансовыеПоказатели_ЦеныПаев.СубъектАналитики = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления)
		|ГДЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент = &ПаевойИнвестиционныйФонд
		|	И ФинансовыеПоказатели_ЦеныПаев.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ФинансовыеПоказатели_ЦеныПаев.Организация = &Организация
		|	И ФинансовыеПоказатели_ЦеныПаев.ВидПоказателя = &ВидПоказателяЦенаПая
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период");
	
	Запрос.УстановитьПараметр("ДатаНачала",					ЭтаФорма.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",				ЭтаФорма.Период.ДатаОкончания);	
	Запрос.УстановитьПараметр("ПаевойИнвестиционныйФонд",	Объект.Пиф);
	Запрос.УстановитьПараметр("Организация",				Объект.Организация);
	Запрос.УстановитьПараметр("ВидПоказателяСЧА",			Справочники.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок);
	Запрос.УстановитьПараметр("ВидПоказателяЦенаПая",		Справочники.ВидыФинансовыхПоказателей.СтоимостьПая);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл		
		ОбработкаОбъект.Дата = Выборка.Период;
		ОбработкаОбъект.ВыгрузитьСтоимостьПаев(Выборка.РасчетнаяЦена, Выборка.СЧА);
		ОбработкаОбъект.ОповеститьОбОшибках();
	КонецЦикла;		

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьСтоимостьПаев(Команда) 
		
	Если Не ЗначениеЗаполнено(Объект.Пиф) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите ПИФ");
		Возврат;	
	КонецЕсли;
	
	Объект.Результат.Очистить();
	
	Если ЭтаФорма.ВыгрузкаЗаПериод Тогда
		
		Если Не ЗначениеЗаполнено(ЭтаФорма.Период) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите период");
			Возврат;	
		КонецЕсли;
			
		ВыгрузитьСтоимостьПаевЗаПериодНаСервере();
		
	Иначе
		Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите дату");
			Возврат;	
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ЭтаФорма.ЦенаПая) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите цену пая");
			Возврат;	
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ЭтаФорма.СЧА) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите сумму СЧА");
			Возврат;	
		КонецЕсли;
				
		ВыгрузитьСтоимостьПаевНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ВыгрузитьОперациюНаСервере()
	
	// Сначала нужно определить идентификатор документа в ЛКК
	// Для зачисления паев по заявке на приобретение это номер ООВП,
	// для других операций это номер заявки
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтаФорма.ЗачислениеПаев,
					Новый Структура("Заявка, НомерЗаявки, ВидЗаявки",
							"Заявка",
							"Заявка.НомерЗаявки",
							"Заявка.ВидЗаявки"));
						
	Если Реквизиты.ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Зачисление Тогда
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ			
			|	ПроцессЗачислениеПаев.НомерОтчетаОВозможностиЗачисленияПаев КАК НомерООВП
			|ИЗ
			|	БизнесПроцесс.ЗачислениеПаев КАК ПроцессЗачислениеПаев
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗачислениеПаев КАК ДокументЗачислениеПаев
			|		ПО (ДокументЗачислениеПаев.Ссылка = &ЗачислениеПаев)
			|			И (ДокументЗачислениеПаев.Заявка = ПроцессЗачислениеПаев.ЗаявкаПайщика)
			|			И (ДокументЗачислениеПаев.ПоступлениеДенежныхСредств.СтрокаБанковскойВыписки.НазначениеПлатежа ПОДОБНО ""%"" + ПроцессЗачислениеПаев.НомерОтчетаОВозможностиЗачисленияПаев + ""%"")
			|ГДЕ
			|	ПроцессЗачислениеПаев.НомерОтчетаОВозможностиЗачисленияПаев ЕСТЬ НЕ NULL ");
	
		Запрос.УстановитьПараметр("ЗачислениеПаев", ЭтаФорма.ЗачислениеПаев);
		
		Выборка = Запрос.Выполнить().Выбрать();
						
		Если Выборка.Следующий() Тогда
			ИдентификаторДокумента = Выборка.НомерООВП;
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для документа не найден бизнес-процесс с ООВП");
			Возврат;
		КонецЕсли;
		
	ИначеЕсли Реквизиты.ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Обмен Тогда
		ИдентификаторДокумента = Реквизиты.НомерЗаявки + ?(ТипЗнч(ЭтаФорма.ЗачислениеПаев) = Тип("ДокументСсылка.ЗачислениеПаев"), "_B", "_S");
	Иначе
		ИдентификаторДокумента = Реквизиты.НомерЗаявки;
	КонецЕсли;						
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ВыгрузитьОперацииПоПаям(ЭтаФорма.ЗачислениеПаев, ИдентификаторДокумента);
	ОбработкаОбъект.ОповеститьОбОшибках();
	
КонецПроцедуры

