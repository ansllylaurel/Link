&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ЭтаФорма.ИмяОбъектаЕсиа = ЭтаФорма.Элементы.ИмяОбъектаЕсиа.СписокВыбора[0].Значение;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастроитьВидимостьИДоступность();
	
КонецПроцедуры

#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура ВыполнитьЗапрос(Команда)
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.Метод) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите метод",, "Метод");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.СтрокаЗапроса) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Введите текст запроса",, "СтрокаЗапроса");
		Возврат;
	КонецЕсли; 
	
	ЭтаФорма.Ответ = "";
	ЭтаФорма.Элементы.ГруппаОтвет.Заголовок = "Ответ"; 
	
	ВыполнитьЗапросНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗапросНаСервере()
	
	ПараметрыПодключения = РеквизитФормыВЗначение("Объект").ПолучитьПараметрыПодключения();
			
	ТекТелоЗапроса = "";
	
	Если ЭтаФорма.ТелоЗапроса.КоличествоСтрок() > 0 Тогда
		ТекТелоЗапроса = ЭтаФорма.ТелоЗапроса.ПолучитьТекст();
	КонецЕсли;
	
	ТекстСообщения = "Не удалось выполнить запрос."; 
		
	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос(ЭтаФорма.Метод, ПараметрыПодключения, "/api/v1/back_office/" + ЭтаФорма.СтрокаЗапроса, ТекТелоЗапроса, ТекстСообщения);
	
	Если HTTPОтвет = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	Иначе 
		
		ЭтаФорма.Элементы.ГруппаОтвет.Заголовок = Строка(HTTPОтвет.КодСостояния) + ?(HTTPОтвет.КодСостояния = 200, " ОК", "");
		
		ОтветСтрокой = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");
	
		Попытка
			ОтветОбъект = ДесериализоватьСтрокуJSON(ОтветСтрокой);
			ОтветСтрокой = ПолучитьСтрокуJSON(ОтветОбъект, Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Windows));
		Исключение
			ОтветСтрокой = "Не удалось десериализовать ответ";	
		КонецПопытки;
								
		МассивСтрок = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ОтветСтрокой, Символы.ПС);
		
		Для Каждого ТекСтрока Из МассивСтрок Цикл
			ЭтаФорма.Ответ.ДобавитьСтроку(ТекСтрока);	
		КонецЦикла
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИмпортироватьНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ИмпортироватьЗаявкиПайщиков(ЭтаФорма.ВидЗаявок);
	ОбработкаОбъект.ОповеститьОбОшибках();

КонецПроцедуры

