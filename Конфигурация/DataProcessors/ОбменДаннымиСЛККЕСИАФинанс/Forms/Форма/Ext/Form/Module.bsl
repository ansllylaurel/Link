&НаКлиенте
Процедура СформироватьТелоЗапроса()
	
	ЭтаФорма.ТелоЗапроса.Очистить();
	
	ЭтаФорма.ТелоЗапроса.ДобавитьСтроку("{""data"": ["); 
	ЭтаФорма.ТелоЗапроса.ДобавитьСтроку("{""fund_code"": """ + ЭтаФорма.ИдентификаторПая + """,");	
	ЭтаФорма.ТелоЗапроса.ДобавитьСтроку("""date"": """ + Формат(Объект.Дата, "ДФ=dd.MM.yyyy") + """,");
	ЭтаФорма.ТелоЗапроса.ДобавитьСтроку("""value"": " + Формат(ЭтаФорма.ЦенаПая, "ЧРД=.; ЧГ=0") + ",");
	ЭтаФорма.ТелоЗапроса.ДобавитьСтроку("""scha_value"": " + Формат(ЭтаФорма.СЧА, "ЧРД=.; ЧГ=0") + "}]}");
	
КонецПроцедуры

