&НаСервере
Процедура ВыгрузитьФайлыНаСервере(АдресФайла, ИмяФайла)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ВыгрузитьФайлы(ЭтотОбъект.Заявка, АдресФайла, ИмяФайла);
	ОбработкаОбъект.ОповеститьОбОшибках();
		
КонецПроцедуры 

&НаКлиенте
Процедура ВыгрузитьФайлы(Команда) 
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.Заявка) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите заявку");
		Возврат;	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.ПутьКФайлу) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите файл для загрузки");
		Возврат;	
	КонецЕсли;

	Объект.Результат.Очистить();
		
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ЭтаФорма.ПутьКФайлу), ЭтаФорма.УникальныйИдентификатор);
	ВыгрузитьФайлыНаСервере(АдресВоВременномХранилище, ЭтаФорма.ПутьКФайлу);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСтатусНаСервере(НовыйСтатус)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.УстановитьСтатус(ЭтотОбъект.Заявка, НовыйСтатус);
		
	ОбработкаОбъект.ОповеститьОбОшибках();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтатус(Команда)
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.Заявка) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите заявку");
		Возврат;	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.СтатусЗаявки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите заявку");
		Возврат;	
	КонецЕсли;
	
	Объект.Результат.Очистить();
	
	НовыйСтатус = "";
	
	Если ЭтаФорма.СтатусЗаявки = 1 Тогда
		НовыйСтатус = "in_queue";
	ИначеЕсли ЭтаФорма.СтатусЗаявки = 2 Тогда
		НовыйСтатус = "in_process";
	ИначеЕсли ЭтаФорма.СтатусЗаявки = 3 Тогда
		НовыйСтатус = "done";
	ИначеЕсли ЭтаФорма.СтатусЗаявки = 4 Тогда
		НовыйСтатус = "rejected";		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите статус заявки");
		Возврат;
	КонецЕсли;
	
	УстановитьСтатусНаСервере(НовыйСтатус);
	
КонецПроцедуры

