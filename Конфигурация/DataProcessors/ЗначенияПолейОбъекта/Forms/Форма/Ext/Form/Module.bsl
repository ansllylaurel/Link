
&НаСервереБезКонтекста
Функция ПолучитьСписокВидовСсылок(ТипСсылки)
	
	ВидыСсылок = Новый СписокЗначений;
	
	Для каждого ОбъектМД Из Метаданные[ТипСсылки] Цикл
		ВидыСсылок.Добавить(ОбъектМД.Имя, ОбъектМД.Представление());
	КонецЦикла;
	
	Возврат ВидыСсылок;
	
КонецФункции // ПолучитьСписокВидовСсылок

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьЗначенияРеквизитовНаСервере(Форма)
	
	Форма.РеквизитыШапки.Очистить();
	
	Для Инд = 1 По Форма.КоличествоТабЧастей Цикл
		Форма["РеквизитыТабЧасти" + Инд].ПолучитьЭлементы().Очистить();
		Форма.Элементы["СтраницаРеквизитыТабЧасти" + Инд].Видимость = Ложь;
	КонецЦикла;
	
КонецПроцедуры // ОчиститьЗначенияРеквизитовНаСервере

&НаСервере
Процедура ЗаполнитьЗначенияРеквизитовНаСервере()
	
	ОчиститьЗначенияРеквизитовНаСервере(ЭтаФорма);
	
	ОбъектМД = Объект.Ссылка.Метаданные();
	
	ПолноеИмяОбъектаМД = ОбъектМД.ПолноеИмя();
	
	// отобразим реквизиты шапки
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ Т.* ИЗ " + ПолноеИмяОбъектаМД + " КАК Т ГДЕ Т.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
		
	РезультатЗапроса = Запрос.Выполнить();
	Выборка          = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Для каждого Колонка Из РезультатЗапроса.Колонки Цикл
			Если Колонка.ТипЗначения.СодержитТип(Тип("РезультатЗапроса")) Тогда
				Продолжить;
			КонецЕсли;
			
			Если Колонка.Имя = "Ссылка" Тогда // вместо ссылки отобразим уникальный идентификатор
				ОписаниеТиповУИД = Новый ОписаниеТипов("УникальныйИдентификатор");
				
				НоваяСтрокаРеквизитыШапки = ЭтаФорма.РеквизитыШапки.Добавить();
				НоваяСтрокаРеквизитыШапки.Имя          = "УникальныйИдентификатор()";
				НоваяСтрокаРеквизитыШапки.Значение     = Выборка.Ссылка.УникальныйИдентификатор();
				НоваяСтрокаРеквизитыШапки.ТипЗначения  = ОписаниеТиповУИД;
				НоваяСтрокаРеквизитыШапки.ОписаниеТипа = ОписаниеТиповУИД;
				
				Продолжить;				
			КонецЕсли;
			
			НоваяСтрокаРеквизитыШапки = ЭтаФорма.РеквизитыШапки.Добавить();
			НоваяСтрокаРеквизитыШапки.Имя      = Колонка.Имя;
			НоваяСтрокаРеквизитыШапки.Значение = Выборка[Колонка.Имя];
			
			ТипРеквизита = Новый Массив;
			ТипРеквизита.Добавить(ТипЗнч(Выборка[Колонка.Имя]));
			ТипРеквизита = Новый ОписаниеТипов(ТипРеквизита);
			
			НоваяСтрокаРеквизитыШапки.ТипЗначения = ТипРеквизита;
			
			РеквизитМД = ОбъектМД.Реквизиты.Найти(Колонка.Имя);
			
			Если РеквизитМД <> Неопределено Тогда
				НоваяСтрокаРеквизитыШапки.Синоним      = РеквизитМД.Представление();
				НоваяСтрокаРеквизитыШапки.ОписаниеТипа = РеквизитМД.Тип;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// отобразим реквизиты табличных частей
	ТребКоличествоТабЧастей = ОбъектМД.ТабличныеЧасти.Количество();
	
	Если ЭтаФорма.КоличествоТабЧастей < ТребКоличествоТабЧастей Тогда
		// добавим недостающие реквизиты формы
		НовыеРеквизитыФормы = Новый Массив;
		
		Для Инд = 1 По ТребКоличествоТабЧастей - ЭтаФорма.КоличествоТабЧастей Цикл
			ИмяТаблицы = "РеквизитыТабЧасти" + (ЭтаФорма.КоличествоТабЧастей + Инд);
			
			РеквизитыТабЧасти = Новый РеквизитФормы(ИмяТаблицы, Новый ОписаниеТипов("ДеревоЗначений"));
			НовыеРеквизитыФормы.Добавить(РеквизитыТабЧасти);
			
			КолонкаТаблицы = Новый РеквизитФормы("Имя", Новый ОписаниеТипов("Строка"), ИмяТаблицы);
			НовыеРеквизитыФормы.Добавить(КолонкаТаблицы);
			
			КолонкаТаблицы = Новый РеквизитФормы("Значение", Новый ОписаниеТипов, ИмяТаблицы);
			НовыеРеквизитыФормы.Добавить(КолонкаТаблицы);
			
			КолонкаТаблицы = Новый РеквизитФормы("ТипЗначения", Новый ОписаниеТипов("ОписаниеТипов"), ИмяТаблицы);
			НовыеРеквизитыФормы.Добавить(КолонкаТаблицы);
			
			КолонкаТаблицы = Новый РеквизитФормы("Синоним", Новый ОписаниеТипов("Строка"), ИмяТаблицы);
			НовыеРеквизитыФормы.Добавить(КолонкаТаблицы);
			
			КолонкаТаблицы = Новый РеквизитФормы("ОписаниеТипа", Новый ОписаниеТипов("ОписаниеТипов"), ИмяТаблицы);
			НовыеРеквизитыФормы.Добавить(КолонкаТаблицы);
		КонецЦикла;
		
		ЭтаФорма.ИзменитьРеквизиты(НовыеРеквизитыФормы);
		
		// добавим недостающие элементы форм
		Для Инд = 1 По ТребКоличествоТабЧастей - ЭтаФорма.КоличествоТабЧастей Цикл
			ИмяТаблицы = "РеквизитыТабЧасти" + (ЭтаФорма.КоличествоТабЧастей + Инд);
			
			СтраницаТаблицы = Элементы.Добавить("Страница" + ИмяТаблицы, Тип("ГруппаФормы"), Элементы.Страницы);
			СтраницаТаблицы.Вид = ВидГруппыФормы.Страница;
			
			ТаблицаФормы = Элементы.Добавить(ИмяТаблицы, Тип("ТаблицаФормы"), СтраницаТаблицы);
			ТаблицаФормы.ПутьКДанным              = ИмяТаблицы;
			ТаблицаФормы.ИзменятьСоставСтрок      = Ложь;
			ТаблицаФормы.ИзменятьПорядокСтрок     = Ложь;
			ТаблицаФормы.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
			
			КолонкаТаблицы = Элементы.Добавить(ИмяТаблицы + "Имя", Тип("ПолеФормы"), ТаблицаФормы); 
			КолонкаТаблицы.ПутьКДанным    = ИмяТаблицы + ".Имя";
			КолонкаТаблицы.ТолькоПросмотр = Истина;
			
			КолонкаТаблицы = Элементы.Добавить(ИмяТаблицы + "Значение", Тип("ПолеФормы"), ТаблицаФормы); 
			КолонкаТаблицы.ПутьКДанным    = ИмяТаблицы + ".Значение";
			КолонкаТаблицы.ТолькоПросмотр = Истина;
			
			КолонкаТаблицы = Элементы.Добавить(ИмяТаблицы + "ТипЗначения", Тип("ПолеФормы"), ТаблицаФормы); 
			КолонкаТаблицы.ПутьКДанным    = ИмяТаблицы + ".ТипЗначения";
			КолонкаТаблицы.ТолькоПросмотр = Истина;
			КолонкаТаблицы.Заголовок      = "Тип значения";
			
			КолонкаТаблицы = Элементы.Добавить(ИмяТаблицы + "Синоним", Тип("ПолеФормы"), ТаблицаФормы); 
			КолонкаТаблицы.ПутьКДанным    = ИмяТаблицы + ".Синоним";
			КолонкаТаблицы.ТолькоПросмотр = Истина;
			
			КолонкаТаблицы = Элементы.Добавить(ИмяТаблицы + "ОписаниеТипа", Тип("ПолеФормы"), ТаблицаФормы); 
			КолонкаТаблицы.ПутьКДанным    = ИмяТаблицы + ".ОписаниеТипа";
			КолонкаТаблицы.ТолькоПросмотр = Истина;
			КолонкаТаблицы.Заголовок      = "Описание типа";
		КонецЦикла;
		
		ЭтаФорма.КоличествоТабЧастей = ТребКоличествоТабЧастей;
	КонецЕсли;
		
	// заполним таблицы реквизитов таб. частей данными
	Для Инд = 1 По ТребКоличествоТабЧастей Цикл
		ТабЧастьМД = ОбъектМД.ТабличныеЧасти[Инд - 1];
		
		ИмяРеквизита = "РеквизитыТабЧасти" + Инд;
		
		РезультатЗапроса = Выборка[ТабЧастьМД.Имя];
		ВыборкаТабЧ      = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаТабЧ.Следующий() Цикл
			Строка1РеквизитыТабЧасти = ЭтаФорма[ИмяРеквизита].ПолучитьЭлементы().Добавить();
			Строка1РеквизитыТабЧасти.Имя = ВыборкаТабЧ.НомерСтроки;
			
			Для каждого Колонка Из РезультатЗапроса.Колонки Цикл
				Если Колонка.Имя = "Ссылка" Или Колонка.Имя = "НомерСтроки" Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока2РеквизитыТабЧасти = Строка1РеквизитыТабЧасти.ПолучитьЭлементы().Добавить();
				НоваяСтрока2РеквизитыТабЧасти.Имя      = Колонка.Имя;
				НоваяСтрока2РеквизитыТабЧасти.Значение = ВыборкаТабЧ[Колонка.Имя];
				
				ТипРеквизита = Новый Массив;
				ТипРеквизита.Добавить(ТипЗнч(ВыборкаТабЧ[Колонка.Имя]));
				ТипРеквизита = Новый ОписаниеТипов(ТипРеквизита);
				
				НоваяСтрока2РеквизитыТабЧасти.ТипЗначения = ТипРеквизита;
				
				РеквизитМД = ТабЧастьМД.Реквизиты.Найти(Колонка.Имя);
				
				Если РеквизитМД <> Неопределено Тогда
					НоваяСтрока2РеквизитыТабЧасти.Синоним      = РеквизитМД.Представление();
					НоваяСтрока2РеквизитыТабЧасти.ОписаниеТипа = РеквизитМД.Тип;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Элементы["Страница" + ИмяРеквизита].Заголовок = ТабЧастьМД.Представление() + " (" + ЭтаФорма[ИмяРеквизита].ПолучитьЭлементы().Количество() + ")";
		Элементы["Страница" + ИмяРеквизита].Видимость = Истина;
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьЗначенияРеквизитовНаСервере

////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЭтаФорма.Параметры.Свойство("Ссылка") И ЗначениеЗаполнено(ЭтаФорма.Параметры.Ссылка) Тогда
		Объект.Ссылка = ЭтаФорма.Параметры.Ссылка;
		
		Элементы.ТипСсылки.Видимость = Ложь;
		Элементы.ВидСсылки.Видимость = Ложь;
		
		Элементы.Ссылка.ТолькоПросмотр = Истина;
		
		ЗаполнитьЗначенияРеквизитовНаСервере();
	Иначе
		ЭтаФорма.ТипСсылки = Элементы.ТипСсылки.СписокВыбора[0].Значение;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ТипСсылкиПриИзменении(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипСсылкиПриИзменении(Элемент)
	
	Объект.Ссылка = Неопределено;
	ОчиститьЗначенияРеквизитовНаСервере(ЭтаФорма);
	
	Элементы.ВидСсылки.СписокВыбора.Очистить();
	
	Если Не ПустаяСтрока(ЭтаФорма.ТипСсылки) Тогда
		Для каждого ЭлементВидыСсылок Из ПолучитьСписокВидовСсылок(ЭтаФорма.ТипСсылки) Цикл
			Элементы.ВидСсылки.СписокВыбора.Добавить(ЭлементВидыСсылок.Значение, ЭлементВидыСсылок.Представление);
		КонецЦикла;
	КонецЕсли;
	
	Если Элементы.ВидСсылки.СписокВыбора.Количество() > 0 Тогда
		ЭтаФорма.ВидСсылки = Элементы.ВидСсылки.СписокВыбора[0].Значение;
		ВидСсылкиПриИзменении(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидСсылкиПриИзменении(Элемент)
	
	Объект.Ссылка = Неопределено;
	ОчиститьЗначенияРеквизитовНаСервере(ЭтаФорма);
	
	ИмяТипаСсылки = "";
	
	Если      ЭтаФорма.ТипСсылки = "Справочники" Тогда
		ИмяТипаСсылки = "СправочникСсылка";
	ИначеЕсли ЭтаФорма.ТипСсылки = "Документы" Тогда
		ИмяТипаСсылки = "ДокументСсылка";
	ИначеЕсли ЭтаФорма.ТипСсылки = "ПланыСчетов" Тогда
		ИмяТипаСсылки = "ПланСчетовСсылка";
	ИначеЕсли ЭтаФорма.ТипСсылки = "ПланыВидовХарактеристик" Тогда
		ИмяТипаСсылки = "ПланВидовХарактеристикСсылка";
	ИначеЕсли ЭтаФорма.ТипСсылки = "ПланыВидовРасчета" Тогда
		ИмяТипаСсылки = "ПланВидовРасчетаСсылка";
	ИначеЕсли ЭтаФорма.ТипСсылки = "Задачи" Тогда
		ИмяТипаСсылки = "ЗадачаСсылка";
	ИначеЕсли ЭтаФорма.ТипСсылки = "БизнесПроцессы" Тогда
		ИмяТипаСсылки = "БизнесПроцессСсылка";
	КонецЕсли;
	
	ИмяТипаСсылки = ИмяТипаСсылки + "." + ЭтаФорма.ВидСсылки;	
	
	Элементы.Ссылка.ОграничениеТипа = Новый ОписаниеТипов(ИмяТипаСсылки);
	
КонецПроцедуры

&НаКлиенте
Процедура СсылкаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗаполнитьЗначенияРеквизитовНаСервере();
	Иначе
		ОчиститьЗначенияРеквизитовНаСервере(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновить(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗаполнитьЗначенияРеквизитовНаСервере();
	Иначе
		ОчиститьЗначенияРеквизитовНаСервере(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры
