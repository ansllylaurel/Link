&НаКлиенте
Процедура ПечатьРСА_ОСД(Команда, ОткрыватьФайлы = Истина)
	
	Если ОшибкаПроверкиКаталога() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.СписокСсылок.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны документы для печати!");
		Возврат;
	КонецЕсли;
		
	Состояние("Формируется выгрузка...");
	
	КаталогФайлов = Объект.КаталогДанных;
			
	ТабличныеДокументы = ПолучитьТабличныеДокументыРСАОСДНаСервере();
	Для Каждого ТекТД Из ТабличныеДокументы Цикл
		ПолноеИмяФайла = КаталогФайлов + "\" + ТекТД.ИмяФайла;
		
		Если НЕ ЗаписатьТабличныйДокумент(ТекТД.ТабличныйДокумент, ПолноеИмяФайла, ТипФайлаТабличногоДокумента.XLS) Тогда
			Возврат;
		КонецЕсли;
		
		Если ОткрыватьФайлы Тогда
			ЗапуститьПриложение(ПолноеИмяФайла);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьРСА_ОСД_До032018(Команда)
	
	Если ОшибкаПроверкиКаталога() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.СписокСсылок.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны документы для печати!");
		Возврат;
	КонецЕсли;
			
	Макет = ОпределитьМакетНаСервере("РСА");
	Если Макет = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Документ = НайтиДокументВСписке();
	Если Документ = Неопределено Тогда
		Возврат;
	КонецЕсли;	

	Состояние("Формируется выгрузка...");
	
	ДатаДокумента		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Дата"); 
	ЭтоФормаС2018Года	= ДатаДокумента >= '20180101';
	КаталогФайлов		= КаталогВременныхФайлов();
	Точность			= 2;
	Отказ				= Ложь;
	
