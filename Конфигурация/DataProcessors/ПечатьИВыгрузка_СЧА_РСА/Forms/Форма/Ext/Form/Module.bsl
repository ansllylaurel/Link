#КонецОбласти 

#Область ПОЛУЧЕНИЕ_ПЕЧАТНЫХ_ФОРМ

&НаКлиенте
Процедура СформироватьСЧА(СохранятьФайлы = Ложь, ОткрыватьФайлы = Истина)
	
	Если ЭтаФорма.СписокСсылок.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны документы для печати!");
		Возврат;
	КонецЕсли;
	
	Документ = НайтиДокументВСписке();
	
	Если Документ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Состояние("Формируется выгрузка...");
	
	ДатаДокумента 		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Дата"); 
	ЭтоФормаС2018Года   = ДатаДокумента >= '20180101';
	Макет = ОпределитьМакетНаСервере("СЧА", ДатаДокумента); 
	Если Макет = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	КаталогФайлов = КаталогВременныхФайлов();
			
	// Текст запроса получаем один раз из первого документа
	ТекстЗапроса = ПолучитьТекстЗапросаНаСервере(Документ, "СЧАОСД");
	
	Коэффициент = 1000;
	Разрядность = 5;
	
	Отказ = Ложь;
	
	Попытка
		
		WordApp = Новый COMОбъект("Word.Application");
			
		Для Каждого СтрокаСписка Из ЭтаФорма.СписокСсылок Цикл
			
			ТекДокумент = СтрокаСписка.Значение;
			Если ТекДокумент = ПредопределенноеЗначение("Документ.РегистрацияСтоимостиАктивов.ПустаяСсылка") Тогда
				Продолжить;
			КонецЕсли;
			
			Результат = ПодготовитьРезультатДляВыводаСЧАНаСервере(ТекДокумент, ТекстЗапроса, , ЭтоФормаС2018Года);
			
			Если Результат = Неопределено Тогда
				Продолжить;
			КонецЕсли;
									
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
			Макет.Записать(ИмяВременногоФайла);
			
			NewDoc = WordApp.Application.Documents.Add(ИмяВременногоФайла, False, , True);
								
			WordVars = NewDoc.Variables;
			WordVars.Item("ДатаОтчета").Value = Результат.ДатаОтчета;
			
			Если Результат.Свойство("ДанныеОрганизации") Тогда
				WordVars.Item("СтрокаУК").Value = Результат.ДанныеОрганизации;
			Иначе
				WordVars.Item("СтрокаУК").Value = "";
			КонецЕсли;	
			
			Если Результат.Свойство("ДанныеКлиента") Тогда				
				WordVars.Item("СтрокаНПФ").Value = Результат.ДанныеКлиента;  
				WordVars.Item("Договор").Value   = Результат.НомерИДатаДоговора;
			Иначе
				WordVars.Item("СтрокаНПФ").Value = "";
				WordVars.Item("Договор").Value   = "";
			КонецЕсли;	
			
			Если Результат.Свойство("ФИОПодписанта") Тогда
				WordVars.Item("Исполнитель").Value          = Результат.ФИОПодписанта;
				WordVars.Item("ИсполнительДолжность").Value = СокрЛП(ПодписантДолжность);
			КонецЕсли;
									
			WordVars.Item("СтрокаРасчета").Value = Формат(Результат.ДатаФормирования, "ДЛФ=");
			
			NewDoc.Fields.Update();
			
			//перебираем список и заносим данные в документ 
		    Таблица = WordApp.Application.ActiveDocument.Tables(2);
		    
		    // Активы, денежные средства, оценка на текущую отчетную дату (010)
		    ТекСтр = 4;
		    Если Результат.Свойство("Стр010") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр010, "ЧДЦ=" + Строка(Разрядность));
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";
			КонецЕсли;	
		    
		    //Активы, Депозиты,  оценка на текущую отчетную дату (020)	
		    ТекСтр = ТекСтр + 1;
		    Если Результат.Свойство("Стр020") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр020, "ЧДЦ=" + Строка(Разрядность));
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли;	
		    
		    //Ценные бумаги, оценка на текущую отчетную дату (030)
		    ТекСтр = ТекСтр + 1;
		    Если Результат.Свойство("Стр030") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр030, "ЧДЦ=" + Строка(Разрядность)); 
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли;	
		    
		    //Государственные ценные бумаги РФ, оценка на текущую отчетную дату (031)                
		    ТекСтр = ТекСтр + 1;
		    Если Результат.Свойство("Стр031") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр031, "ЧДЦ=" + Строка(Разрядность)); 
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли;
		    
		    //Государственные ценные субъектов РФ,  оценка на текущую отчетную дату (032)                          
		    ТекСтр = ТекСтр + 1;
		    Если Результат.Свойство("Стр032") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр032, "ЧДЦ=" + Строка(Разрядность));
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли; 
		    
		    //Облигации муниципальных образований,  оценка на текущую отчетную дату (033)
		    ТекСтр = ТекСтр + 1;
		    Если Результат.Свойство("Стр033") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр033, "ЧДЦ=" + Строка(Разрядность));
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли;  
		    
		    //Облигации российских хозяйственных обществ,  оценка на текущую отчетную дату (034)
		    ТекСтр = ТекСтр + 1;
		  	Если Результат.Свойство("Стр034") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр034, "ЧДЦ=" + Строка(Разрядность)); 
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли;  
		    
		    //Акции российских эмитентов в форме ОАО,  оценка на текущую отчетную дату (035)
		    ТекСтр = ТекСтр + 1;
		    Если Результат.Свойство("Стр035") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр035, "ЧДЦ=" + Строка(Разрядность));
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли;  
		    
		    //Паи индексных инвестиционных фондов,  оценка на текущую отчетную дату (036)
		    ТекСтр = ТекСтр + 1;
		    Если Результат.Свойство("Стр036") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр036, "ЧДЦ=" + Строка(Разрядность)); 
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";
			КонецЕсли;  
		    
		    //Ипотечные ценные бумаги,  оценка на текущую отчетную дату (037)
		    ТекСтр = ТекСтр + 1;
		    Если Результат.Свойство("Стр037") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр037, "ЧДЦ=" + Строка(Разрядность));
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли; 

		    //ипотечные сертификаты участия, выпущенные в соответствии с  законодательством Российской Федерации об ипотечных ценных бумагах (038)
		    ТекСтр = ТекСтр + 1;
		    таблица.Cell(ТекСтр,3).Range.Text = "0,00000"; // СокрЛП(Формат(0,"Ч19."+Строка(Разрядность)));

		    // ценные бумаги международных финансовых организаций (039)
		    ТекСтр = ТекСтр + 1;
		    Если Результат.Свойство("Стр039") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр039, "ЧДЦ=" + Строка(Разрядность)); //Формат(Результат.Стр039, "ЧДЦ=" + Строка(Разрядность));
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000"; 
			КонецЕсли; 
		    	
		    //Дебиторская задолженность, оценка на текущую отчетную дату (040)               
		    ТекСтр = ТекСтр + 1;
		    Если Результат.Свойство("Стр040") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр040, "ЧДЦ=" + Строка(Разрядность));
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли;  
		    
		    //Средства,  предоствленные проф. участникам, оценка на текущую отчетную дату (041)
		    ТекСтр = ТекСтр + 1;
		    Если Результат.Свойство("Стр041") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр041, "ЧДЦ=" + Строка(Разрядность));
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли; 
		    
		    //Дебиторская задолженнность по процентному доходу, оценка на текущую отчетную дату (042) - для формы до 01.01.2018
			Если Не ЭтоФормаС2018Года Тогда
		    	ТекСтр = ТекСтр + 1;          				
								
			    Если Результат.Свойство("Стр042") Тогда
			    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр042, "ЧДЦ=" + Строка(Разрядность));
				Иначе
					Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
				КонецЕсли;  
			КонецЕсли;	
				
		    //Прочая дебиторская задолженность, оценка на текущую отчетную дату 
			// для формы до 01.01.2018 (043) 
			// для формы с 01.01.2018 (042) 
			
		    ТекСтр = ТекСтр + 1;
			
			// Из-за расхождений полей печатной формы и выгрузки в СДК Гарант складываем 042 и 043
			Если ЭтоФормаС2018Года Тогда			
				ТекЗначение = 0;
				Если Результат.Свойство("Стр042") Тогда
					ТекЗначение = ТекЗначение + Результат.Стр042;
				КонецЕсли;
				
				Если Результат.Свойство("Стр043") Тогда
					ТекЗначение = ТекЗначение + Результат.Стр043;
				КонецЕсли;
				
				Если ТекЗначение <> 0 Тогда
					Таблица.Cell(ТекСтр,3).Range.Text = Формат(ТекЗначение, "ЧДЦ=" + Строка(Разрядность));
				Иначе	
				    Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
				КонецЕсли;
			ИначеЕсли Результат.Свойство("Стр043") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр043, "ЧДЦ=" + Строка(Разрядность));	
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли; 
		    
		    //Прочие активы, оценка на текущую отчетную дату (050)
		    ТекСтр = ТекСтр + 1;
		    Если Результат.Свойство("Стр050") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр050, "ЧДЦ=" + Строка(Разрядность));
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли; 
		    
		    //ИТОГО ИМУЩЕСТВА, оценка на текущую отчетную дату (060)
		    ТекСтр = ТекСтр + 1;
		    Если Результат.Свойство("Стр060") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр060, "ЧДЦ=" + Строка(Разрядность));
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли;  
		    
		    //Кредиторская задолженность, оценка на текущую отчетную дату (070)
		    ТекСтр = ТекСтр + 2;
		    Если Результат.Свойство("Стр070") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр070, "ЧДЦ=" + Строка(Разрядность));
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли;  
		    
		    //Обязательства перед проф участниками, оценка на текущую отчетную дату (071)
		    ТекСтр = ТекСтр + 1;
		    Если Результат.Свойство("Стр071") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр071, "ЧДЦ=" + Строка(Разрядность));
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли;  
		    
		    //Кредиторская задолженность по возмещению расходов, оценка на текущую отчетную дату (072)                    
		    ТекСтр = ТекСтр + 1;
		    Если Результат.Свойство("Стр072") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр072, "ЧДЦ=" + Строка(Разрядность));
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли;  
		    
		    //Прочая кредиторская задолженность, оценка на текущую отчетную дату (073)
		    ТекСтр = ТекСтр + 1;
		    Если Результат.Свойство("Стр073") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр073, "ЧДЦ=" + Строка(Разрядность));
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли;  

		    // кредиторская задолженность по перечислению средств в негосударственный пенсионный фонд для исполнения им своих текущих обязательств	(074)
		    ТекСтр = ТекСтр + 1;
		    таблица.Cell(ТекСтр,3).Range.Text = "0,00000"; //СокрЛП(Формат(0,"Ч19."+Строка(Разрядность)));

		    //Прочая кредиторская задолженность, оценка на текущую отчетную дату (075)
		    ТекСтр = ТекСтр + 1;
		    Если Результат.Свойство("Стр075") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр075, "ЧДЦ=" + Строка(Разрядность));
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли;
		  
		    //Итого сумма обязательств, оценка на текущую отчетную дату (080)
		    ТекСтр = ТекСтр + 1;
		    Если Результат.Свойство("Стр070") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.Стр070, "ЧДЦ=" + Строка(Разрядность));
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли; 
		    
		    //Итого стоимость чистых активов, оценка на текущую отчетную дату (090)
		    ТекСтр = ТекСтр + 1;
		    Если Результат.Свойство("СЧА") Тогда
		    	Таблица.Cell(ТекСтр,3).Range.Text = Формат(Результат.СЧА, "ЧДЦ=" + Строка(Разрядность));
			Иначе
				Таблица.Cell(ТекСтр,3).Range.Text = "0,00000";	
			КонецЕсли; 
			
			Если СохранятьФайлы Тогда
				ТекИмяФайла = "СЧА_" + Результат.СДУ + "_" + Результат.ДатаОтчета + ".docx";
				NewDoc.SaveAs(Объект.КаталогДанных + "\" + ТекИмяФайла);	                      
			КонецЕсли;
		
			ОбработкаПрерыванияПользователя();
			
		КонецЦикла;
		
		WordApp.Application.Visible = ОткрыватьФайлы;
		
	Исключение
		WordApp.Application.Quit();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(),,,,Отказ);	
	КонецПопытки; 
		
КонецПроцедуры	

&НаСервере
Функция СформироватьФорму029НаСервере(Документ)
		
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Макет = ОбъектОбработки.ПолучитьМакет("Форма029");
	
	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.Вывести(ОбластьШапка);
	
	Коэффициент = Объект.Коэффициент;
	Разрядность = Объект.Разрядность;
	ПараметрыЗапроса = ОбъектОбработки.ПолучитьПараметрыЗапроса(Документ);
	Результат = ОбъектОбработки.ПолучитьТаблицуФормы029(ПараметрыЗапроса);
	Для Каждого СтрокаРезультата Из Результат Цикл		
		ОбластьСтрока.Параметры.Заполнить(СтрокаРезультата);
		ТабДокумент.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	ПараметрыЗапроса.Вставить("Подписант", ЭтотОбъект.Подписант);
	ЗаголовокИПодвал = ОбъектОбработки.ПолучитьПараметрыЗаголовкаИПодвала(ПараметрыЗапроса);	
	СтруктураРезультата = Новый Структура;
	ОбъектОбработки.ДобавитьОбщиеДанныеВСтруктуруРезультата(СтруктураРезультата, ЗаголовокИПодвал, ЭтотОбъект.Подписант);
	СтруктураРезультата.Вставить("ДатаОтчета", Формат(ПараметрыЗапроса.Период, "ДФ=dd.MM.yyyy"));
	
	Возврат Новый Структура("ДокументРезультат, СДУ, ДатаОтчета", ТабДокумент, СтруктураРезультата.СДУ, СтруктураРезультата.ДатаОтчета);
	 	
КонецФункции // СформироватьФорму029НаСервере

