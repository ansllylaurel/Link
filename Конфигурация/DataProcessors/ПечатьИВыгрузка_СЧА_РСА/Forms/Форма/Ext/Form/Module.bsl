&НаКлиенте
Функция ПривестиДатуКТипуXML(ТекДата)
	
	Если Не ЗначениеЗаполнено(ТекДата) ИЛИ ТекДата = Дата(1, 1, 1) Тогда
		Возврат "";
	КонецЕсли;
	
	ТекГод   = Формат(Год(ТекДата), "ЧГ=0");
	ТекМесяц = Формат(Месяц(ТекДата), "ЧЦ=2; ЧВН=; ЧГ=0");
	ТекДень  =  Формат(День(ТекДата), "ЧЦ=2; ЧВН=; ЧГ=0");
	
	Возврат ТекГод + "-" + ТекМесяц + "-" + ТекДень;
	
