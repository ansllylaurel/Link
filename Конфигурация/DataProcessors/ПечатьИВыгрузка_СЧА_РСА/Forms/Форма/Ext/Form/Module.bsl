&НаКлиенте
Процедура КомандаЭкспортировать(Команда)
	
	Если Не (Объект.СЧА ИЛИ Объект.РСА) Тогда
		Сообщить("Не указаны формы для выгрузки!");
		Возврат;
	КонецЕсли;
	
	ТекОтбор = Новый Структура("Спецдепозитарий", ЭтотОбъект.Спецдепозитарий);
	НайдСтрокиКоманд = ТаблицаКоманд.НайтиСтроки(ТекОтбор);
	Если НайдСтрокиКоманд.Количество() = 0 Тогда
		Сообщить("Для спец. депозитария " + СокрЛП(ЭтотОбъект.Спецдепозитарий) + " не найдены формы для выгрузки!");
		Возврат;
	КонецЕсли;
	
	СтрокаКоманд = НайдСтрокиКоманд[0];
	
	Для каждого СтрокаАктивныеСчетаДоверительногоУправления Из ЭтаФорма.СписокСсылок Цикл
		
		Если Не СтрокаАктивныеСчетаДоверительногоУправления.Флажок Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаАктивныеСчетаДоверительногоУправления.Значение) Тогда
			Сообщить("Для счета ДУ " + СокрЛП(СтрокаАктивныеСчетаДоверительногоУправления.СчетДУ) + " не зарегистрирован документ 'Регистрация стоимости активов' на дату " + Формат(ЭтаФорма.ДатаОтчета, "ДФ=dd.MM.yyyy"));
			Продолжить;
		КонецЕсли;	
		
		Если Объект.СЧА И СокрЛП(СтрокаКоманд.СЧА) <> "" Тогда
			Выполнить(СокрЛП(СтрокаКоманд.СЧА) + "(Неопределено, Ложь)");	
		КонецЕсли;	
		
		Если Объект.РСА И СокрЛП(СтрокаКоманд.РСА) <> "" Тогда
			Выполнить(СокрЛП(СтрокаКоманд.РСА) + "(Неопределено, Ложь)");	
		КонецЕсли;	
		
	КонецЦикла;
	
	Сообщить("Экспорт данных завершен");

КонецПроцедуры

