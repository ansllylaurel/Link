&НаКлиенте
Процедура ВыгрузкаСЧА_МСД(Команда, ОткрыватьФайлы = Ложь)
	
	Если ОшибкаПроверкиКаталога() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.СписокСсылок.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны документы для печати!");
		Возврат;
	КонецЕсли;
	
	Состояние("Формируется выгрузка...");
	
	КаталогФайлов = Объект.КаталогДанных + "\";
	
	ТабличныеДокументы = ПолучитьТабличныеДокументыСЧАМСДНаСервере();
	
	Для Каждого ТекТД Из ТабличныеДокументы Цикл
		
		ПолноеИмяФайла = КаталогФайлов + ТекТД.ИмяФайла;
		
		Если НЕ ЗаписатьТабличныйДокумент(ТекТД.ТабличныйДокумент, ПолноеИмяФайла, ТипФайлаТабличногоДокумента.XLS) Тогда
			Возврат;
		КонецЕсли;
		
		Если ОткрыватьФайлы Тогда
			ЗапуститьПриложение(ПолноеИмяФайла);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не Команда = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выгрузка завершена!");
	КонецЕсли;
	
КонецПроцедуры

