	Элементы.ФормаГруппаВыгрузкаВТБ.Видимость 				= ВызовИзДокумента;
	Элементы.ФормаГруппаВыгрузкаМСД.Видимость 				= ВызовИзДокумента;
	Элементы.ФормаГруппаВыгрузкаОСД.Видимость 				= ВызовИзДокумента;
	Элементы.ФормаГруппаВыгрузкаНСД.Видимость 				= ВызовИзДокумента;
	Элементы.СписокСсылокЗначение.Видимость					= ВызовИзДокумента;
	ЭтаФорма.Заголовок 										= ?(ВызовИзДокумента, "Печать и выгрузка СЧА/РСА", "Выгрузка СЧА и РСА");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуКоманд(Отказ)
	
	Если СписокСсылок.Количество() > 0 Тогда // в этом случае таблица команд не нужна
		Возврат;
	КонецЕсли;
	
	Если ТаблицаКоманд.Количество() > 0 Тогда // уже заполнена
		Возврат;
	КонецЕсли;
		
	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	МакетКоманд = ОтчетОбъект.ПолучитьМакет("КомандыПоСпецдепам");
			
	Для НомерСтроки = 2 По МакетКоманд.ВысотаТаблицы Цикл
		
		СтрСпецдеп	= СокрЛП(МакетКоманд.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);
		КомандаСЧА	= СокрЛП(МакетКоманд.Область(НомерСтроки, 2, НомерСтроки, 2).Текст);
		КомандаРСА	= СокрЛП(МакетКоманд.Область(НомерСтроки, 3, НомерСтроки, 3).Текст);
				
		Если СтрСпецдеп = "" Тогда
			Продолжить;
		КонецЕсли;
		
		СпецДеп = ОбщегоНазначения.ПолучитьИменованныйОбъект(СтрСпецдеп);
		
		Если СпецДеп = Неопределено Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		НоваяСтрока 						= ТаблицаКоманд.Добавить();
		НоваяСтрока.Спецдепозитарий 		= СпецДеп;
		НоваяСтрока.СЧА 					= КомандаСЧА;
		НоваяСтрока.РСА 					= КомандаРСА;
		НоваяСтрока.ИмяИменованногоОбъекта	= СтрСпецдеп;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьДанныеВТаблицуWord(Массив, Word, Номер_Таблицы, Знач Номер_Строки = 2, Знач Кол_Колонок = 0, ИтогПоТаблице, Коэффициент = 1000, Разрядность = 5)
		
	Если Word = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ИтогПоТаблице = 0;
	
	Сколько_Строк = Массив.Количество();
	
	WordTable = Word.Application.ActiveDocument.Tables(Номер_Таблицы);
	WordRows = WordTable.Rows;
	
	Если Сколько_Строк = 0 Тогда
		WordRows.Item(Номер_Строки).Delete();
	Иначе                           		
		BeforeRow = WordRows.Item(Номер_Строки);
		Для Н = 1 По Сколько_Строк-1 Цикл
			WordRows.Add(BeforeRow);
		КонецЦикла;                               
		
		Номер_Строки = Номер_Строки - 1;
		
		Если Кол_Колонок = 0 Тогда
			Сколько_Колонок = Массив[0].Количество();
		Иначе
			Сколько_Колонок = Кол_Колонок;
		КонецЕсли;
		
		Н = 1; 
		Для Каждого ЭлементМассива Из Массив Цикл 
			
			InRow = WordRows.Item(Номер_Строки + Н);	
			Кол = 1;
			Для Каждого СтрокаСтруктуры Из ЭлементМассива Цикл
				
				Если Лев(СтрокаСтруктуры.Ключ, 6) = "Раздел" Тогда
					Продолжить;
				КонецЕсли;
				
				Если Кол_Колонок < Кол Тогда
					Продолжить;
				КонецЕсли;
				
				Знч = СтрокаСтруктуры.Значение;
				
				Если ТипЗнч(Знч) = Тип("Дата") Тогда
					Знч = Формат(Знч, "ДФ=dd.MM.yyyy");
				ИначеЕсли Лев(СтрокаСтруктуры.Ключ, 10) = "Количество" Тогда
	                Знч = Формат(Знч, "ЧДЦ=0");  
				ИначеЕсли Лев(СтрокаСтруктуры.Ключ, 4) = "Цена" Тогда
					Знч = Формат(Знч, "ЧДЦ=4");
				ИначеЕсли ТипЗнч(Знч) = Тип("Число") Тогда					
					Знч  = Окр(Знч / Коэффициент, Разрядность, 1);
					ИтогПоТаблице = ИтогПоТаблице + Знч;
					Знч = Формат(Знч, "ЧДЦ="+Строка(Разрядность)); 
				ИначеЕсли Не ТипЗнч(Знч) = Тип("Строка") Тогда
					Знч = СокрЛП(Знч);
				КонецЕсли;	
				
				InRow.Cells(Кол).Select();
				Word.Application.Selection.InsertAfter(Знч);
				Кол = Кол + 1;
			КонецЦикла;	
			
			Н = Н + 1;
			
		КонецЦикла;                       
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьЗапись(Результат, КодСтроки, Коэффициент = 1)
	
	Если Результат.Свойство(КодСтроки) Тогда
