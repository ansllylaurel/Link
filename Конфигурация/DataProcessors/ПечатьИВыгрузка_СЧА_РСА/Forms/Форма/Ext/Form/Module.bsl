&НаСервере
Процедура ОбновитьСчетаДоверительногоУправления()
	
	ЭтаФорма.СписокСсылок.Очистить();
		                                                                     
	СписокСчетовДУ = ПолучитьСписокАктивныхСчетовДоверительногоУправления(Объект.Организация, Этаформа.Спецдепозитарий, ЭтаФорма.ДатаОтчета);
			
	Для каждого СтрокаСчетаДУ Из СписокСчетовДУ Цикл
		СчетДоверительногоУправленияНайден = Ложь;
		
		Для каждого СтрокаАктивныеСчетаДоверительногоУправления Из ЭтаФорма.СписокСсылок Цикл
			Если СтрокаАктивныеСчетаДоверительногоУправления.СчетДУ 	= СтрокаСчетаДУ.СчетДоверительногоУправления Тогда
				СтрокаАктивныеСчетаДоверительногоУправления.СчетДУ  	= СтрокаСчетаДУ.СчетДоверительногоУправления;
				СтрокаАктивныеСчетаДоверительногоУправления.Значение    = СтрокаСчетаДУ.Регистратор;
				СтрокаАктивныеСчетаДоверительногоУправления.Флажок      = Истина;
				
				СчетДоверительногоУправленияНайден = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если Не СчетДоверительногоУправленияНайден Тогда
			НоваяСтрокаАктивныеСчетаДоверительногоУправления = ЭтаФорма.СписокСсылок.Добавить();
			НоваяСтрокаАктивныеСчетаДоверительногоУправления.СчетДУ		= СтрокаСчетаДУ.СчетДоверительногоУправления;
			НоваяСтрокаАктивныеСчетаДоверительногоУправления.Значение   = СтрокаСчетаДУ.Регистратор;
			НоваяСтрокаАктивныеСчетаДоверительногоУправления.Флажок     = Истина;
		КонецЕсли;
	КонецЦикла;
	
	УпорядочитьАктивныеСчетаДоверительногоУправленияНаСервере();
	
КонецПроцедуры // ОбновитьАктивныеСчетаДоверительногоУправления

&НаСервере
Процедура УпорядочитьАктивныеСчетаДоверительногоУправленияНаСервере()
	
	ЭтаФорма.СписокСсылок.Сортировать("СчетДУ");
	
КонецПроцедуры // УпорядочитьАктивныеСчетаДоверительногоУправленияНаСервере

&НаСервереБезКонтекста
Функция ПолучитьСписокАктивныхСчетовДоверительногоУправления(Организация, Спецдепозитарий, Период) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	ЕСТЬNULL(ФинансовыеПоказатели.Регистратор, ЗНАЧЕНИЕ(Документ.РегистрацияСтоимостиАктивов.ПустаяСсылка)) КАК Регистратор
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&Период, ) КАК НастройкиУчетаОбщиеСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиПоЦеннымБумагам КАК ИсполнителиПоЦеннымБумагам
		|			ПО СчетаДоверительногоУправления.Ссылка = ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления
		|		ПО НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО (НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления = (ВЫРАЗИТЬ(ФинансовыеПоказатели.СубъектАналитики КАК Справочник.СчетаДоверительногоУправления)))
		|			И (ФинансовыеПоказатели.Организация = &Организация)
		|			И (ФинансовыеПоказатели.Период = &Период)
		|			И (ВЫРАЗИТЬ(ФинансовыеПоказатели.Регистратор КАК Документ.РегистрацияСтоимостиАктивов).ЦельРасчетаСтоимостиОценки = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении))
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В(&СписокВидовДоговоров)
		|	И СчетаДоверительногоУправления.СпециализированныйДепозитарий = &Спецдепозитарий";
	
	СписокВидовДоговоров = Новый Массив;
	СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями);
	СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);
	
	Запрос.УстановитьПараметр("Организация",			Организация);
	Запрос.УстановитьПараметр("СписокВидовДоговоров",	СписокВидовДоговоров);
	Запрос.УстановитьПараметр("Период",      			Период);
	Запрос.УстановитьПараметр("Спецдепозитарий",		Спецдепозитарий);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ПолучитьСписокАктивныхСчетовДоверительногоУправления

&НаКлиенте
Процедура УстановитьФлажкиСЧАиРСА()
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.Спецдепозитарий) Тогда
		Возврат;
	КонецЕсли;
	
	ТекОтбор = Новый Структура("Спецдепозитарий", ЭтотОбъект.Спецдепозитарий);
	НайдСтрокиКоманд = ТаблицаКоманд.НайтиСтроки(ТекОтбор);
	Если НайдСтрокиКоманд.Количество() = 0 Тогда
		Сообщить("Для спец. депозитария " + СокрЛП(ЭтотОбъект.Спецдепозитарий) + " не найдены формы для выгрузки!");
		Возврат;
	КонецЕсли;
	
	СтрокаКоманд = НайдСтрокиКоманд[0];

	ЕстьСЧА = СокрЛП(СтрокаКоманд.СЧА) <> "";
	Объект.СЧА = ЕстьСЧА;
	Элементы.СЧА.Видимость = ЕстьСЧА;

	ЕстьРСА = СокрЛП(СтрокаКоманд.РСА) <> "";
	Объект.РСА = ЕстьРСА;
	Элементы.РСА.Видимость = ЕстьРСА;
	
КонецПроцедуры

#КонецОбласти