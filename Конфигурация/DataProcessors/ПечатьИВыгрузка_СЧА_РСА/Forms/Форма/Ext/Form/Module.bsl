		Если ТекДокумент = ПредопределенноеЗначение("Документ.РегистрацияСтоимостиАктивов.ПустаяСсылка") Тогда
			Продолжить;
		КонецЕсли;                             				
		
		МассивДокументов.Добавить(ТекДокумент);
			
	КонецЦикла;
	
	Результат = ОбъектОбработки.ПолучитьВыгрузкиРСА_СДКГарант(МассивДокументов, Разрядность, ЭтотОбъект.Подписант, ПодписантДолжность);
	
