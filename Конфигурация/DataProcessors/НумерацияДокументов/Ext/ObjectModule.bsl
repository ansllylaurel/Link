
Функция ПроверитьНомераДокументов(РезультатПроверки = Неопределено, ВозвращатьТолькоТребующиеПеренумерации = Ложь, ПолучатьПредставленияОбъектов = Истина) Экспорт
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект);
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ПроверитьНомераДокументов";
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ПроверкаПрошлаУспешно = Истина;	
	
	// Проверяем корректность периода
	Если ЭтотОбъект.Период.ДатаНачала > ЭтотОбъект.Период.ДатаОкончания Тогда
		ВызватьИсключение "Задан некорректный период " + ЭтотОбъект.Период + "!";
	КонецЕсли;	
	
	// Определяем методику нумерации по периоду
	Если ЭтотОбъект.Период.ДатаНачала < '20171001' И ЭтотОбъект.Период.ДатаОкончания >= '20171001' Тогда
		ВызватьИсключение "Период " + Строка(ЭтотОбъект.Период) + " включает разные методики нумерации документов!";
	КонецЕсли;
	
	Если ЭтотОбъект.Период.ДатаНачала < '20171001' Тогда
		
		// Методика до 01.10.2017
		
		Если ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления) Тогда
			ВызватьИсключение "Методика нумерации с отбором по счету внутреннего учета до 01.10.2017 не определена!";
		КонецЕсли;
		ПроверкаПрошлаУспешно = ПроверитьНомераДокументовПоМетодикеДо01102017(РезультатПроверки);			
		
	Иначе
		
		// Методика с 01.10.2017
		// Проверяем документы на соответствие шаблону нумерации:
		// [ПрефиксНумерации]-[ДатаДокДДММГГ]/[ЧисловаяЧастьКодаСчетаДУ]-[ИндексДокументаВДне]
		
		ПроверкаПрошлаУспешно = ПроверитьНомераДокументовПоМетодике01102017(РезультатПроверки, ВозвращатьТолькоТребующиеПеренумерации, ПолучатьПредставленияОбъектов);
		
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
	Возврат ПроверкаПрошлаУспешно;		
	
КонецФункции

Функция ПеренумероватьДокументы(РезультатПроверки, ТипыИзмененныхОбъектов = Неопределено, ПрерыватьПриОшибкеЗаписи = Истина, ОшибкиЗаписи = Неопределено) Экспорт
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект);
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ПеренумероватьДокументы";
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);	
	
	ВсегоПеренумеровано = 0;
	
	Если ТипыИзмененныхОбъектов = Неопределено Тогда
		ТипыИзмененныхОбъектов = Новый Массив;
	КонецЕсли;
	
	// Помеченные на удаление документы должны быть перенумерованы в начале,
	// чтобы освободить занятые ими номера
	Если РезультатПроверки.Свойство("ПомеченныеНаУдалениеДокументы") Тогда
		ВсегоПеренумеровано = ВсегоПеренумеровано + ИзменитьНомераДокументовВДереве(РезультатПроверки.ПомеченныеНаУдалениеДокументы.Данные, ТипыИзмененныхОбъектов, , ПрерыватьПриОшибкеЗаписи, ОшибкиЗаписи);
		
		РезультатПроверки.Удалить("ПомеченныеНаУдалениеДокументы");
	КонецЕсли;	
	
	Для Каждого Результат Из РезультатПроверки Цикл
		ОписаниеРезультата = Результат.Значение;
		Если ТипЗнч(ОписаниеРезультата) = Тип("Структура") И ОписаниеРезультата.Свойство("Данные") Тогда 
			ВсегоПеренумеровано = ВсегоПеренумеровано + ИзменитьНомераДокументовВДереве(ОписаниеРезультата.Данные, ТипыИзмененныхОбъектов, , ПрерыватьПриОшибкеЗаписи, ОшибкиЗаписи);
		КонецЕсли;
	КонецЦикла;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
	Возврат ВсегоПеренумеровано; 
	
КонецФункции

Функция ПроверитьНомераДокументовПоМетодике01102017(РезультатПроверки = Неопределено, ВозвращатьТолькоТребующиеПеренумерации = Ложь, ПолучатьПредставленияОбъектов = Истина)
	
	// Получаем представление даты в номере
	
	ТаблицаДат = Новый ТаблицаЗначений;
	ТаблицаДат.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТаблицаДат.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(6)));
	
	ДатаНачала	  	= НачалоДня(ЭтотОбъект.Период.ДатаНачала);
	ДатаОкончания	= НачалоДня(ЭтотОбъект.Период.ДатаОкончания);
	
	Пока ДатаНачала <= ДатаОкончания Цикл 
		НоваяДата = ТаблицаДат.Добавить();
		НоваяДата.Дата			= ДатаНачала;
		НоваяДата.Представление	= Формат(ДатаНачала, "ДФ=ддММгг");
		
		ДатаНачала = ДатаНачала + 86400;
	КонецЦикла;
	
	// Получаем числовую часть кода клиентов
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.НомерСчета КАК НомерСчета,
		|	""          "" КАК Представление
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних КАК КлиентыДоверительногоУправления
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправления.СчетДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И &ОтборПоСчетуДоверительногоУправления
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания
		|	И (СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаНачала
		|		ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))");
	
	Запрос.УстановитьПараметр("ДатаНачала",		ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",	ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	
	Если ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления) Тогда	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &ОтборПоСчетуДоверительногоУправления", "И СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления");		
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &ОтборПоСчетуДоверительногоУправления", "");		
	КонецЕсли;
	
	ТаблицаКодовКлиентов = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаКлиента Из ТаблицаКодовКлиентов Цикл
		СтрокаКлиента.Представление = Формат(СтрокаКлиента.НомерСчета, "ЧРД=.; ЧГ=");		
	КонецЦикла;
	
	// Проверяем документы
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаДат.Дата КАК Дата,
		|	_ТаблицаДат.Представление КАК Представление
		|ПОМЕСТИТЬ _ТаблицаДат
		|ИЗ
		|	&ТаблицаДат КАК _ТаблицаДат
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаКодовКлиентов.СчетДоверительногоУправления КАК СчетДУ,
		|	_ТаблицаКодовКлиентов.НомерСчета КАК НомерСчета,
		|	_ТаблицаКодовКлиентов.Представление КАК Представление
		|ПОМЕСТИТЬ _ТаблицаКодовКлиентов
		|ИЗ
		|	&ТаблицаКодовКлиентов КАК _ТаблицаКодовКлиентов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаКодовКлиентов.СчетДУ КАК СчетДУ,
		|	_ТаблицаДат.Дата КАК Дата,
		|	Организации.ПрефиксНумерации + ""-"" + _ТаблицаДат.Представление + ""/"" + _ТаблицаКодовКлиентов.Представление + ""-"" КАК ПрефиксНумерацииПолный,
		|	Организации.ПрефиксНумерации + ""-"" + _ТаблицаДат.Представление + ""/"" + _ТаблицаКодовКлиентов.Представление + ""-%"" КАК ШаблонНумерации,
		|	Организации.ПрефиксНумерации + ""-"" + _ТаблицаДат.Представление + ""/"" + _ТаблицаКодовКлиентов.Представление + ""-%[^0-9]%"" КАК ПлохойШаблонНумерации
		|ПОМЕСТИТЬ _ПрефиксыКлиентов
		|ИЗ
		|	_ТаблицаКодовКлиентов КАК _ТаблицаКодовКлиентов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО (Организации.Ссылка = &Организация)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаДат КАК _ТаблицаДат
		|		ПО (ИСТИНА)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СчетДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(Сделка.Дата, ДЕНЬ) КАК Дата,
		|	Сделка.СчетДоверительногоУправления КАК СчетДУ,
		|	Сделка.Ссылка КАК Документ,
		|	Сделка.Номер КАК ТекущийНомер,
		|	Сделка.МоментВремени КАК МоментВремени
		|ПОМЕСТИТЬ _ВсеОперацииБэкОфиса
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|ГДЕ
		|	Сделка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И Сделка.Организация = &Организация
		|	И НЕ Сделка.ПометкаУдаления
		|	И Сделка.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И &ОтборПоСчетуДоверительногоУправления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ИсполнениеОбязательствПоСделке.Дата, ДЕНЬ),
		|	ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления,
		|	ИсполнениеОбязательствПоСделке.Ссылка,
		|	ИсполнениеОбязательствПоСделке.Номер,
		|	ИсполнениеОбязательствПоСделке.МоментВремени
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|ГДЕ
		|	ИсполнениеОбязательствПоСделке.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И ИсполнениеОбязательствПоСделке.Организация = &Организация
		|	И НЕ ИсполнениеОбязательствПоСделке.ПометкаУдаления
		|	И ИсполнениеОбязательствПоСделке.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И &ОтборПоСчетуДоверительногоУправления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ЖурналОперацийБэкОфиса.Дата, ДЕНЬ),
		|	ЖурналОперацийБэкОфиса.СчетДоверительногоУправления,
		|	ЖурналОперацийБэкОфиса.Документ,
		|	ЖурналОперацийБэкОфиса.Документ.Номер,
		|	ЖурналОперацийБэкОфиса.Документ.МоментВремени
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|ГДЕ
		|	ЖурналОперацийБэкОфиса.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И ЖурналОперацийБэкОфиса.Организация = &Организация
		|	И ЖурналОперацийБэкОфиса.Состояние <> ЗНАЧЕНИЕ(Перечисление.СостоянияДокументов.ПомеченНаУдаление)
		|	И НЕ ЖурналОперацийБэкОфиса.ВидОперации В (&ВидОперации)
		|	И &ОтборПоСчетуДоверительногоУправления
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СчетДУ,
		|	ТекущийНомер");
	
	// Запрос итоговой таблицы
	
	Если ВозвращатьТолькоТребующиеПеренумерации Тогда
		
		// оставляем только даты, в которых требуется перенумерация
		
		Запрос.Текст = Запрос.Текст + ";" +
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ВсеОперацииБэкОфиса.Дата КАК Дата,
			|	_ВсеОперацииБэкОфиса.СчетДУ КАК СчетДоверительногоУправления,
			|	_ВсеОперацииБэкОфиса.Документ КАК Документ,
			|	_ВсеОперацииБэкОфиса.МоментВремени КАК МоментВремени,
			|	_ВсеОперацииБэкОфиса.ТекущийНомер КАК ТекущийНомер,
			|	_ПрефиксыКлиентов.ПрефиксНумерацииПолный КАК ПрефиксНумерацииПолный,
			|	_ВсеОперацииБэкОфиса.ТекущийНомер ПОДОБНО _ПрефиксыКлиентов.ШаблонНумерации
			|		И НЕ _ВсеОперацииБэкОфиса.ТекущийНомер ПОДОБНО _ПрефиксыКлиентов.ПлохойШаблонНумерации КАК ФорматПоШаблону
			|ПОМЕСТИТЬ _ИтоговаяТаблица
			|ИЗ
			|	_ВсеОперацииБэкОфиса КАК _ВсеОперацииБэкОфиса
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ПрефиксыКлиентов КАК _ПрефиксыКлиентов
			|		ПО (_ПрефиксыКлиентов.СчетДУ = _ВсеОперацииБэкОфиса.СчетДУ)
			|			И (_ПрефиксыКлиентов.Дата = _ВсеОперацииБэкОфиса.Дата)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&ПредставлениеДокумента КАК Представление,
			|	СчетаДоверительногоУправления.Наименование КАК ПредставлениеСчетаДоверительногоУправления,
			|	_ИтоговаяТаблица.Дата КАК Дата,
			|	_ИтоговаяТаблица.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ИтоговаяТаблица.Документ КАК Документ,
			|	_ИтоговаяТаблица.Документ КАК Объект,
			|	_ИтоговаяТаблица.ТекущийНомер КАК ТекущийНомер,
			|	_ИтоговаяТаблица.ПрефиксНумерацииПолный КАК ПрефиксНумерацииПолный,
			|	_ИтоговаяТаблица.ФорматПоШаблону КАК ФорматПоШаблону
			|ИЗ
			|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
			|			_ИтоговаяТаблица.Дата КАК Дата
			|		ИЗ
			|			_ИтоговаяТаблица КАК _ИтоговаяТаблица
			|		ГДЕ
			|			_ИтоговаяТаблица.ФорматПоШаблону = ЛОЖЬ) КАК ДатыСНеправильнымиНомерами
			|		ПО (ДатыСНеправильнымиНомерами.Дата = _ИтоговаяТаблица.Дата)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ПО (СчетаДоверительногоУправления.Ссылка = _ИтоговаяТаблица.СчетДоверительногоУправления)
			|
			|УПОРЯДОЧИТЬ ПО
			|	_ИтоговаяТаблица.Дата,
			|	_ИтоговаяТаблица.СчетДоверительногоУправления,
			|	_ИтоговаяТаблица.ФорматПоШаблону УБЫВ,
			|	_ИтоговаяТаблица.МоментВремени";
		
		Если ПолучатьПредставленияОбъектов Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПредставлениеДокумента", 
				"ВЫБОР
				|	КОГДА _ИтоговаяТаблица.ФорматПоШаблону = ЛОЖЬ
				|		ТОГДА ПРЕДСТАВЛЕНИЕССЫЛКИ(_ИтоговаяТаблица.Документ)
				|КОНЕЦ");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПредставлениеДокумента КАК Представление,", "");
		КонецЕсли;		
		
	Иначе
		
		Запрос.Текст = Запрос.Текст + ";" +
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&ПредставлениеДокумента КАК Представление,
			|	СчетаДоверительногоУправления.Наименование КАК ПредставлениеСчетаДоверительногоУправления,
			|	_ВсеОперацииБэкОфиса.Дата КАК Дата,
			|	_ВсеОперацииБэкОфиса.СчетДУ КАК СчетДоверительногоУправления,
			|	_ВсеОперацииБэкОфиса.Документ КАК Документ,
			|	_ВсеОперацииБэкОфиса.Документ КАК Объект,
			|	_ВсеОперацииБэкОфиса.ТекущийНомер КАК ТекущийНомер,
			|	_ПрефиксыКлиентов.ПрефиксНумерацииПолный КАК ПрефиксНумерацииПолный,
			|	_ВсеОперацииБэкОфиса.ТекущийНомер ПОДОБНО _ПрефиксыКлиентов.ШаблонНумерации
			|		И НЕ _ВсеОперацииБэкОфиса.ТекущийНомер ПОДОБНО _ПрефиксыКлиентов.ПлохойШаблонНумерации КАК ФорматПоШаблону
			|ИЗ
			|	_ВсеОперацииБэкОфиса КАК _ВсеОперацииБэкОфиса
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ПО (СчетаДоверительногоУправления.Ссылка = _ВсеОперацииБэкОфиса.СчетДУ)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ПрефиксыКлиентов КАК _ПрефиксыКлиентов
			|		ПО (_ПрефиксыКлиентов.СчетДУ = _ВсеОперацииБэкОфиса.СчетДУ)
			|			И (_ПрефиксыКлиентов.Дата = _ВсеОперацииБэкОфиса.Дата)
			|
			|УПОРЯДОЧИТЬ ПО
			|	_ВсеОперацииБэкОфиса.Дата,
			|	_ВсеОперацииБэкОфиса.СчетДУ,
			|	ФорматПоШаблону УБЫВ,
			|	_ВсеОперацииБэкОфиса.МоментВремени";
		
		Если ПолучатьПредставленияОбъектов Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПредставлениеДокумента", "ПРЕДСТАВЛЕНИЕССЫЛКИ(_ВсеОперацииБэкОфиса.Документ)");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПредставлениеДокумента КАК Представление,", "");
		КонецЕсли;

	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления) Тогда	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &ОтборПоСчетуДоверительногоУправления", "И СчетДоверительногоУправления = &СчетДоверительногоУправления");		
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &ОтборПоСчетуДоверительногоУправления", "");		
	КонецЕсли;
		
	Запрос.УстановитьПараметр("ДатаНачала",					  ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",				  ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация",				  ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВидОперации",   				  ИсключаемыеВидыОпераций());
	Запрос.УстановитьПараметр("ТаблицаДат",					  ТаблицаДат);
	Запрос.УстановитьПараметр("ТаблицаКодовКлиентов",		  ТаблицаКодовКлиентов);
	
	// Инициализация вспомогательных переменных
	
	ИныеОперацииДанные = Новый ДеревоЗначений;
	ИныеОперацииДанные.Колонки.Добавить("Документ");
	ИныеОперацииДанные.Колонки.Добавить("Объект");
	ИныеОперацииДанные.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ИныеОперацииДанные.Колонки.Добавить("ТекущийНомер", Новый ОписаниеТипов("Строка"));
	ИныеОперацииДанные.Колонки.Добавить("НовыйНомер", Новый ОписаниеТипов("Строка"));
	ИныеОперацииДанные.Колонки.Добавить("ТребуетсяПеренумерация", Новый ОписаниеТипов("Булево"));
	ИныеОперацииДанные.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ИныеОперацииДанные.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("УникальныйИдентификатор"));	
	
	ВсегоДокументов      = 0;
	ТребуютПеренумерации = 0;
	
	ТекущаяДата		= Неопределено;
	ТекущийКлиент	= Неопределено;
	
	Выгрузка = Запрос.Выполнить().Выгрузить();		
	
	Для Каждого Выборка Из Выгрузка Цикл 
		
		// Определяем изменились ли дата или клиент для сброса счетчика номеров		
		
		Если ТекущаяДата <> Выборка.Дата Тогда
			ТекущаяДата		= Выборка.Дата;
			ТекущийКлиент	= Неопределено;
			
			ИндексДокумента		= 0;
			НомераДокументаВДне	= Новый Соответствие;
			
			СтрокаДатыВыведена = Ложь;
		КонецЕсли;
		
		Если ТекущийКлиент <> Выборка.СчетДоверительногоУправления Тогда
			ТекущийКлиент = Выборка.СчетДоверительногоУправления;
			
			ИндексДокумента		= 0;
			НомераДокументаВДне	= Новый Соответствие;
			
			СтрокаКлиентаВыведена = Ложь;
		КонецЕсли;
		
		// Определяем требуется ли перенумерация по соответствию шаблону		
		
		Если Выборка.ФорматПоШаблону = Истина Тогда
			
			НомераДокументаВДне.Вставить(Выборка.ТекущийНомер, Выборка.Документ);
			
			Если ВозвращатьТолькоТребующиеПеренумерации Тогда
				ВсегоДокументов = ВсегоДокументов + 1;
				Продолжить;
			КонецЕсли;
			
			НовыйНомерДокумента = Выборка.ТекущийНомер;
			
		ИначеЕсли Выборка.ПрефиксНумерацииПолный = NULL Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось проверить корректность номера документа """ + Строка(Выборка.Документ) + """!", Выборка.Документ); 
			ВызватьИсключение "Не удалось проверить корректность номера документа """ + Строка(Выборка.Документ) + """!";		
			
		Иначе	
			
			// Нумеруем оставшиеся
			НовыйНомерДокумента	= "";			
			ДлинаНомера			= Выборка.Документ.Метаданные().Нумератор.ДлинаНомера - СтрДлина(Выборка.ПрефиксНумерацииПолный);
			МаксимальныйНомер	= Выборка.ПрефиксНумерацииПолный + СтрЗаменить(Формат(ИндексДокумента, "ЧЦ=" + Формат(ДлинаНомера, "ЧГ=") + "; ЧН=; ЧВН=; ЧГ="), "0", "9");
			
			// Ищем свободный номер
			Пока НомераДокументаВДне.Получить(НовыйНомерДокумента) <> Неопределено ИЛИ ПустаяСтрока(НовыйНомерДокумента) Цикл 
				Если НовыйНомерДокумента = МаксимальныйНомер Тогда
					ВызватьИсключение "На " + Формат(Выборка.Дата, "ДФ=dd.MM.yyyy") + " достигнуто максимальное значение номеров документов """ + МаксимальныйНомер + """!";		
				КонецЕсли;
				
				ИндексДокумента		= ИндексДокумента + 1;
				НовыйНомерДокумента	= Выборка.ПрефиксНумерацииПолный + Формат(ИндексДокумента, "ЧВН=; ЧГ=");
			КонецЦикла;
			
			НомераДокументаВДне.Вставить(НовыйНомерДокумента, Выборка.Документ);

		КонецЕсли;
		
		// Добавляем строки в дерево
		
		Если СтрокаДатыВыведена = Ложь Тогда
			СтрокаДаты = ИныеОперацииДанные.Строки.Добавить();
			СтрокаДаты.Дата					= Выборка.Дата;
			СтрокаДаты.Объект				= Выборка.Дата;
			СтрокаДаты.Представление		= Формат(Выборка.Дата, "ДФ=dd.MM.yyyy");
			СтрокаДаты.ИдентификаторСтроки	= Новый УникальныйИдентификатор;
			
			СтрокаДатыВыведена = Истина;
		КонецЕсли;
		
		Если СтрокаКлиентаВыведена = Ложь Тогда
			СтрокаСчетаДУ = СтрокаДаты.Строки.Добавить();
			СтрокаСчетаДУ.Объект				= Выборка.СчетДоверительногоУправления;
			СтрокаСчетаДУ.Представление			= Выборка.ПредставлениеСчетаДоверительногоУправления;
			СтрокаСчетаДУ.ИдентификаторСтроки	= Новый УникальныйИдентификатор;
			
			СтрокаКлиентаВыведена = Истина;
		КонецЕсли;		
			
		ДобавитьДокументВДерево(СтрокаСчетаДУ.Строки, НовыйНомерДокумента, Выборка, ТребуютПеренумерации, ВсегоДокументов);

	КонецЦикла;
	
	ПомеченныеНаУдалениеДокументы = ПолучитьПомеченныеНаУдалениеДокументы();
	
	// Заполняем результаты проверки
	РезультатПроверки = Новый Структура("ИныеОперации, ПомеченныеНаУдалениеДокументы, Ошибки",
		Новый Структура("Данные, ТребуютПеренумерации, ВсегоДокументов", ИныеОперацииДанные, ТребуютПеренумерации, ВсегоДокументов),
		ПомеченныеНаУдалениеДокументы,
		Новый Массив
	);
	
	Возврат ((ТребуютПеренумерации + ПомеченныеНаУдалениеДокументы.ТребуютПеренумерации) = 0);

КонецФункции

Функция ПроверитьНомераДокументовПоМетодикеДо01102017(РезультатПроверки = Неопределено)
	Ошибки = Новый Массив;
	
	КодыРынковЦенныхБумаг = Новый Соответствие;
	КодыРынковЦенныхБумаг.Вставить(Перечисления.РынкиЦенныхБумаг.Акции,     "А");
	КодыРынковЦенныхБумаг.Вставить(Перечисления.РынкиЦенныхБумаг.Облигации, "О");
	КодыРынковЦенныхБумаг.Вставить(Перечисления.РынкиЦенныхБумаг.Паи,       "П");
	КодыРынковЦенныхБумаг.Вставить(Перечисления.РынкиЦенныхБумаг.Векселя,   "В");
	
	// Получаем результаты проверки
	БиржевыеСделки					= ПолучитьБиржевыеСделки(КодыРынковЦенныхБумаг, Ошибки);
	БиржевыеСделкиРЕПО				= ПолучитьБиржевыеСделкиРЕПО(КодыРынковЦенныхБумаг, Ошибки);
	ВнебиржевыеСделки				= ПолучитьВнебиржевыеСделки(КодыРынковЦенныхБумаг, Ошибки);
	Поручения						= ПолучитьПоручения(КодыРынковЦенныхБумаг, Ошибки);
	ИныеОперации					= ПолучитьИныеОперации(КодыРынковЦенныхБумаг, Ошибки);
	ПомеченныеНаУдалениеДокументы	= ПолучитьПомеченныеНаУдалениеДокументы();
	
	// Агрегирируем
	РезультатПроверки = Новый Структура("БиржевыеСделки,БиржевыеСделкиРЕПО,ВнебиржевыеСделки,Поручения,ИныеОперации,ПомеченныеНаУдалениеДокументы,Ошибки",
		БиржевыеСделки,
		БиржевыеСделкиРЕПО,
		ВнебиржевыеСделки,
		Поручения,
		ИныеОперации,
		ПомеченныеНаУдалениеДокументы,
		Ошибки
	);
	
	Возврат (БиржевыеСделки.ТребуютПеренумерации
		+ БиржевыеСделкиРЕПО.ТребуютПеренумерации
		+ ВнебиржевыеСделки.ТребуютПеренумерации
		+ Поручения.ТребуютПеренумерации
		+ ИныеОперации.ТребуютПеренумерации
		+ ПомеченныеНаУдалениеДокументы.ТребуютПеренумерации) = 0;		
КонецФункции	

Функция ПолучитьБиржевыеСделки(КодыРынковЦенныхБумаг, Ошибки)
	Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(Сделка.Дата, ДЕНЬ) КАК Дата,
		|	Сделка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Сделка.Брокер КАК Брокер,
		|	Сделка.Рынок КАК Рынок,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК Код,
		|	Сделка.Ссылка КАК Документ,
		|	Сделка.Ссылка КАК Объект,
		|	Сделка.Номер КАК ТекущийНомер,
		|	Сделка.МоментВремени,
		|	ЛОЖЬ КАК Исполнение,
		|	NULL КАК Основание,
		|	NULL КАК ОснованиеНомер
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(, ) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ПО Сделка.СчетДоверительногоУправления = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления
		|			И Сделка.Брокер = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер
		|ГДЕ
		|	Сделка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И Сделка.Организация = &Организация
		|	И НЕ Сделка.ПометкаУдаления
		|	И Сделка.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ИсполнениеОбязательствПоСделке.Дата, ДЕНЬ),
		|	ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления,
		|	ИсполнениеОбязательствПоСделке.Брокер,
		|	ИсполнениеОбязательствПоСделке.Рынок,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код,
		|	ИсполнениеОбязательствПоСделке.Ссылка,
		|	ИсполнениеОбязательствПоСделке.Ссылка,
		|	ИсполнениеОбязательствПоСделке.Номер,
		|	ИсполнениеОбязательствПоСделке.МоментВремени,
		|	ИСТИНА,
		|	ИсполнениеОбязательствПоСделке.Основание,
		|	ИсполнениеОбязательствПоСделке.Основание.Номер
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(, ) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ПО ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления
		|			И ИсполнениеОбязательствПоСделке.Брокер = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер
		|ГДЕ
		|	ИсполнениеОбязательствПоСделке.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И ИсполнениеОбязательствПоСделке.Организация = &Организация
		|	И НЕ ИсполнениеОбязательствПоСделке.ПометкаУдаления
		|	И ИсполнениеОбязательствПоСделке.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И ИсполнениеОбязательствПоСделке.Основание.Дата >= ДАТАВРЕМЯ(2014, 1, 1)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Сделка.МоментВремени
		|ИТОГИ ПО
		|	Дата,
		|	СчетДоверительногоУправления,
		|	Брокер,
		|	Рынок
		|");
		
	Запрос.УстановитьПараметр("ДатаНачала",    ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация",   ЭтотОбъект.Организация);
	
	// Инициализация вспомогательных переменных
	ПрефиксНумерации = ЭтотОбъект.Организация.ПрефиксНумерации; 
	
	БиржевыеСделкиДанные = Новый ДеревоЗначений;
	БиржевыеСделкиДанные.Колонки.Добавить("Документ");
	БиржевыеСделкиДанные.Колонки.Добавить("Объект");
	БиржевыеСделкиДанные.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	БиржевыеСделкиДанные.Колонки.Добавить("ТекущийНомер", Новый ОписаниеТипов("Строка"));
	БиржевыеСделкиДанные.Колонки.Добавить("НовыйНомер", Новый ОписаниеТипов("Строка"));
	БиржевыеСделкиДанные.Колонки.Добавить("ТребуетсяПеренумерация", Новый ОписаниеТипов("Булево"));
	БиржевыеСделкиДанные.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("УникальныйИдентификатор"));		
	
	ВсегоДокументов      	= 0;
	ТребуютПеренумерации	= 0;
	НовыеНомераСделок		= Новый Соответствие;
	
	ВыборкаДаты = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДаты.Следующий() Цикл
		СтрокаДаты = БиржевыеСделкиДанные.Строки.Добавить();
		СтрокаДаты.Дата					= ВыборкаДаты.Дата;
		СтрокаДаты.Объект				= ВыборкаДаты.Дата;
		СтрокаДаты.ИдентификаторСтроки	= Новый УникальныйИдентификатор;
		
		ВыборкаСчетаДУ = ВыборкаДаты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСчетаДУ.Следующий() Цикл
			
			СтрокаСчетаДУ = СтрокаДаты.Строки.Добавить();
			СтрокаСчетаДУ.Дата					= ВыборкаСчетаДУ.Дата;
			СтрокаСчетаДУ.Объект				= ВыборкаСчетаДУ.СчетДоверительногоУправления;
			СтрокаСчетаДУ.ИдентификаторСтроки	= Новый УникальныйИдентификатор;
			
			ВыборкаБрокеры = ВыборкаСчетаДУ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаБрокеры.Следующий() Цикл
				
				ВыборкаРынки = ВыборкаБрокеры.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаРынки.Следующий() Цикл
					
					ИндексДокумента = 0;
									
					Выборка = ВыборкаРынки.Выбрать();
					
					Пока Выборка.Следующий() Цикл
						
						// определим новый номер документа
						Если Не Выборка.Исполнение Тогда
							ИндексДокумента = ИндексДокумента + 1;
							
							Если Не ЗначениеЗаполнено(Выборка.Код) Тогда
								ЗарегистрироватьОшибку(Ошибки, "Не задан код клиента " + Выборка.СчетДоверительногоУправления + " у брокера " + Выборка.Брокер + ". Устраните проблему и нажмите 'Обновите'.");
							КонецЕсли;
							
							НовыйНомерДокумента = ПрефиксНумерации + "-" + Формат(Выборка.Дата, "ДФ=ddMMyy") + "/" + Выборка.Код + "/"
								+ КодыРынковЦенныхБумаг[Выборка.Рынок] + "/Б-" + Формат(ИндексДокумента, "ЧГ=");
								
							НовыеНомераСделок.Вставить(Выборка.Документ, НовыйНомерДокумента);
							
						Иначе
							НовыйНомерСделки = НовыеНомераСделок.Получить(Выборка.Основание);
							
							Если НовыйНомерСделки = Неопределено Тогда
								НовыйНомерДокумента = Выборка.ОснованиеНомер;
							Иначе
								НовыйНомерДокумента = НовыйНомерСделки;
							КонецЕсли;
							
							НовыйНомерДокумента = СтрЗаменить(НовыйНомерДокумента, "/Б-", "/ИБ-");
							
							Если СтрДлина(НовыйНомерДокумента) > 25 Тогда
								НовыйНомерДокумента = СтрЗаменить(НовыйНомерДокумента, "/ИБ-", "/И-"); // вернем назад после увеличения длины номера
							КонецЕсли;
							
						КонецЕсли;						
						
						// добавим строку в дерево
						ДобавитьДокументВДерево(СтрокаСчетаДУ.Строки, НовыйНомерДокумента, Выборка, ТребуютПеренумерации, ВсегоДокументов);
						
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	// Заполняем результаты проверки
	РезультатПроверки = Новый Структура("Данные,ТребуютПеренумерации,ВсегоДокументов", БиржевыеСделкиДанные, ТребуютПеренумерации, ВсегоДокументов);
	
	Возврат РезультатПроверки;
КонецФункции

Функция ПолучитьБиржевыеСделкиРЕПО(КодыРынковЦенныхБумаг, Ошибки)	
	Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(СделкаРЕПО.Дата, ДЕНЬ) КАК Дата,
		|	СделкаРЕПО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СделкаРЕПО.Брокер КАК Брокер,
		|	СделкаРЕПО.Рынок,
		|	СделкаРЕПО.ЧастьСделкиРЕПО,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код,
		|	СделкаРЕПО.Ссылка КАК Документ,
		|	СделкаРЕПО.Ссылка КАК Объект,
		|	СделкаРЕПО.Номер КАК ТекущийНомер,
		|	СделкаРЕПО.ПерваяЧастьРЕПО,
		|	СделкаРЕПО.ПерваяЧастьРЕПО.Номер КАК ПерваяЧастьРЕПОНомер
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(, ) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ПО СделкаРЕПО.СчетДоверительногоУправления = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления
		|			И СделкаРЕПО.Брокер = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер
		|ГДЕ
		|	СделкаРЕПО.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И СделкаРЕПО.Организация = &Организация
		|	И НЕ СделкаРЕПО.ПометкаУдаления
		|	И СделкаРЕПО.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И (СделкаРЕПО.ЧастьСделкиРЕПО = 1
		|			ИЛИ СделкаРЕПО.ЧастьСделкиРЕПО = 2)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СделкаРЕПО.МоментВремени
		|ИТОГИ ПО
		|	Дата,
		|	СчетДоверительногоУправления,
		|	Брокер
		|");
		
	Запрос.УстановитьПараметр("ДатаНачала",    ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация",   ЭтотОбъект.Организация);
	
	// Инициализация вспомогательных переменных
	ПрефиксНумерации = ЭтотОбъект.Организация.ПрефиксНумерации; 
	
	БиржевыеСделкиРЕПОДанные = Новый ДеревоЗначений;
	БиржевыеСделкиРЕПОДанные.Колонки.Добавить("Документ");
	БиржевыеСделкиРЕПОДанные.Колонки.Добавить("Объект");
	БиржевыеСделкиРЕПОДанные.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	БиржевыеСделкиРЕПОДанные.Колонки.Добавить("ТекущийНомер", Новый ОписаниеТипов("Строка"));
	БиржевыеСделкиРЕПОДанные.Колонки.Добавить("НовыйНомер", Новый ОписаниеТипов("Строка"));
	БиржевыеСделкиРЕПОДанные.Колонки.Добавить("ТребуетсяПеренумерация", Новый ОписаниеТипов("Булево"));
	БиржевыеСделкиРЕПОДанные.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("УникальныйИдентификатор"));		
	
	ВсегоДокументов				= 0;
	ТребуютПеренумерации		= 0;
	НовыеНомераПервойЧастиРЕПО	= Новый Соответствие;
	
	ВыборкаДаты = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДаты.Следующий() Цикл
		
		СтрокаДаты = БиржевыеСделкиРЕПОДанные.Строки.Добавить();
		СтрокаДаты.Дата					= ВыборкаДаты.Дата;
		СтрокаДаты.Объект				= ВыборкаДаты.Дата;
		СтрокаДаты.ИдентификаторСтроки	= Новый УникальныйИдентификатор;
		
		ВыборкаСчетаДУ = ВыборкаДаты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСчетаДУ.Следующий() Цикл
		
			СтрокаСчетаДУ = СтрокаДаты.Строки.Добавить();
			СтрокаСчетаДУ.Дата					= ВыборкаСчетаДУ.Дата;
			СтрокаСчетаДУ.Объект				= ВыборкаСчетаДУ.СчетДоверительногоУправления;
			СтрокаСчетаДУ.ИдентификаторСтроки	= Новый УникальныйИдентификатор;
			
			ВыборкаБрокеры = ВыборкаСчетаДУ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаБрокеры.Следующий() Цикл
				
				Выборка = ВыборкаБрокеры.Выбрать();
				
				ИндексДокумента = 0;
				
				Пока Выборка.Следующий() Цикл
					
					// определим новый номер документа
					Если      Выборка.ЧастьСделкиРЕПО = 1 Тогда
						ИндексДокумента = ИндексДокумента + 1;
						
						НовыйНомерДокумента = ПрефиксНумерации + "-" + Формат(Выборка.Дата, "ДФ=ddMMyy") + "/" + Выборка.Код + "-" + Формат(ИндексДокумента, "ЧГ=")
							 + "/" + КодыРынковЦенныхБумаг[Выборка.Рынок] + "/Р1";
							
						НовыеНомераПервойЧастиРЕПО.Вставить(Выборка.Документ, НовыйНомерДокумента);
							
					ИначеЕсли Выборка.ЧастьСделкиРЕПО = 2 Тогда
						НовыйНомерПервойЧастиРЕПО = НовыеНомераПервойЧастиРЕПО.Получить(Выборка.ПерваяЧастьРЕПО);
						
						Если НовыйНомерПервойЧастиРЕПО = Неопределено Тогда
							НовыйНомерДокумента = Выборка.ПерваяЧастьРЕПОНомер;
						Иначе
							НовыйНомерДокумента = НовыйНомерПервойЧастиРЕПО;
						КонецЕсли;
						
						НовыйНомерДокумента = СтрЗаменить(НовыйНомерДокумента, "/Р1", "/Р2");
							
					КонецЕсли;
					
					// добавим строку в дерево
					ДобавитьДокументВДерево(СтрокаСчетаДУ.Строки, НовыйНомерДокумента, Выборка, ТребуютПеренумерации, ВсегоДокументов);
					
				КонецЦикла;				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	// Заполняем результаты проверки
	РезультатПроверки = Новый Структура("Данные,ТребуютПеренумерации,ВсегоДокументов", БиржевыеСделкиРЕПОДанные, ТребуютПеренумерации, ВсегоДокументов);
	
	Возврат РезультатПроверки;	
КонецФункции

Функция ПолучитьВнебиржевыеСделки(КодыРынковЦенныхБумаг, Ошибки)
	Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(Сделка.Дата, ДЕНЬ) КАК Дата,
		|	Сделка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Сделка.Брокер КАК Брокер,
		|	ВЫБОР
		|		КОГДА Сделка.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА КодыСчетовДоверительногоУправленияУОсновногоБрокераСрезПоследних.Код
		|		ИНАЧЕ КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код
		|	КОНЕЦ КАК Код,
		|	Сделка.Рынок,
		|	Сделка.Ссылка КАК Документ,
		|	Сделка.Ссылка КАК Объект,
		|	Сделка.Номер КАК ТекущийНомер,
		|	Сделка.МоментВремени
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(, ) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ПО Сделка.СчетДоверительногоУправления = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления
		|			И Сделка.Брокер = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(, ОсновнойБрокер) КАК КодыСчетовДоверительногоУправленияУОсновногоБрокераСрезПоследних
		|		ПО (Сделка.СчетДоверительногоУправления = КодыСчетовДоверительногоУправленияУОсновногоБрокераСрезПоследних.СчетДоверительногоУправления)
		|ГДЕ
		|	Сделка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И Сделка.Организация = &Организация
		|	И НЕ Сделка.ПометкаУдаления
		|	И Сделка.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(СделкаРЕПО.Дата, ДЕНЬ),
		|	СделкаРЕПО.СчетДоверительногоУправления,
		|	СделкаРЕПО.Брокер,
		|	ВЫБОР
		|		КОГДА СделкаРЕПО.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА КодыСчетовДоверительногоУправленияУОсновногоБрокераСрезПоследних.Код
		|		ИНАЧЕ КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код
		|	КОНЕЦ,
		|	СделкаРЕПО.Рынок,
		|	СделкаРЕПО.Ссылка,
		|	СделкаРЕПО.Ссылка,
		|	СделкаРЕПО.Номер,
		|	СделкаРЕПО.МоментВремени
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(, ) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ПО СделкаРЕПО.СчетДоверительногоУправления = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления
		|			И СделкаРЕПО.Брокер = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(, ОсновнойБрокер) КАК КодыСчетовДоверительногоУправленияУОсновногоБрокераСрезПоследних
		|		ПО (СделкаРЕПО.СчетДоверительногоУправления = КодыСчетовДоверительногоУправленияУОсновногоБрокераСрезПоследних.СчетДоверительногоУправления)
		|ГДЕ
		|	СделкаРЕПО.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И СделкаРЕПО.Организация = &Организация
		|	И НЕ СделкаРЕПО.ПометкаУдаления
		|	И СделкаРЕПО.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Сделка.МоментВремени
		|ИТОГИ ПО
		|	Дата,
		|	СчетДоверительногоУправления,
		|	Брокер
		|");
		
	Запрос.УстановитьПараметр("ДатаНачала",    ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация",   ЭтотОбъект.Организация);
	
	// Инициализация вспомогательных переменных
	ПрефиксНумерации = ЭтотОбъект.Организация.ПрефиксНумерации; 
	
	ВнебиржевыеСделкиДанные = Новый ДеревоЗначений;
	ВнебиржевыеСделкиДанные.Колонки.Добавить("Документ");
	ВнебиржевыеСделкиДанные.Колонки.Добавить("Объект");
	ВнебиржевыеСделкиДанные.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ВнебиржевыеСделкиДанные.Колонки.Добавить("ТекущийНомер", Новый ОписаниеТипов("Строка"));
	ВнебиржевыеСделкиДанные.Колонки.Добавить("НовыйНомер", Новый ОписаниеТипов("Строка"));
	ВнебиржевыеСделкиДанные.Колонки.Добавить("ТребуетсяПеренумерация", Новый ОписаниеТипов("Булево"));
	ВнебиржевыеСделкиДанные.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("УникальныйИдентификатор"));		
	
	ВсегоДокументов      = 0;
	ТребуютПеренумерации = 0;
	
	ВыборкаДаты = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДаты.Следующий() Цикл
		
		СтрокаДаты = ВнебиржевыеСделкиДанные.Строки.Добавить();
		СтрокаДаты.Дата					= ВыборкаДаты.Дата;
		СтрокаДаты.Объект				= ВыборкаДаты.Дата;
		СтрокаДаты.ИдентификаторСтроки	= Новый УникальныйИдентификатор;
		
		Выборка = ВыборкаДаты.Выбрать();
		
		ВыборкаСчетаДУ = ВыборкаДаты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСчетаДУ.Следующий() Цикл
		
			СтрокаСчетаДУ = СтрокаДаты.Строки.Добавить();
			СтрокаСчетаДУ.Дата					= ВыборкаСчетаДУ.Дата;
			СтрокаСчетаДУ.Объект				= ВыборкаСчетаДУ.СчетДоверительногоУправления;
			СтрокаСчетаДУ.ИдентификаторСтроки	= Новый УникальныйИдентификатор;
			
			ВыборкаБрокеры = ВыборкаСчетаДУ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаБрокеры.Следующий() Цикл
				
				Выборка = ВыборкаБрокеры.Выбрать();
				
				ИндексДокумента = 0;
				
				Пока Выборка.Следующий() Цикл
					
					// определим новый номер документа
					ИндексДокумента = ИндексДокумента + 1;
					
					НовыйНомерДокумента = ПрефиксНумерации + "-" + Формат(Выборка.Дата, "ДФ=ddMMyy") + "/" + Выборка.Код + "-" + Формат(ИндексДокумента, "ЧГ=")
						 + "/" + КодыРынковЦенныхБумаг[Выборка.Рынок] + "/В";
					
					// добавим строку в дерево
					ДобавитьДокументВДерево(СтрокаСчетаДУ.Строки, НовыйНомерДокумента, Выборка, ТребуютПеренумерации, ВсегоДокументов);
					
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	// Заполняем результаты проверки
	РезультатПроверки = Новый Структура("Данные,ТребуютПеренумерации,ВсегоДокументов", ВнебиржевыеСделкиДанные, ТребуютПеренумерации, ВсегоДокументов);
	
	Возврат РезультатПроверки;	
КонецФункции

Функция ПолучитьПоручения(КодыРынковЦенныхБумаг, Ошибки)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПоручениеНаДвижениеДенежныхСредств.Ссылка КАК Документ,
		|	ПоручениеНаДвижениеДенежныхСредств.Ссылка КАК Объект,
		|	ПоручениеНаДвижениеДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ПоручениеНаДвижениеДенежныхСредств.СчетДоверительногоУправления.КодСчета КАК КодСчетаДоверительногоУправления,
		|	НАЧАЛОПЕРИОДА(ПоручениеНаДвижениеДенежныхСредств.Дата, ДЕНЬ) КАК Дата,
		|	ПоручениеНаДвижениеДенежныхСредств.Номер КАК ТекущийНомер,
		|	ПоручениеНаДвижениеДенежныхСредств.МоментВремени КАК МоментВремени
		|ИЗ
		|	Документ.ПоручениеНаДвижениеДенежныхСредств КАК ПоручениеНаДвижениеДенежныхСредств
		|ГДЕ
		|	ПоручениеНаДвижениеДенежныхСредств.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И ПоручениеНаДвижениеДенежныхСредств.Организация = &Организация
		|	И НЕ ПоручениеНаДвижениеДенежныхСредств.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПоручениеНаДвижениеЦенныхБумаг.Ссылка,
		|	ПоручениеНаДвижениеЦенныхБумаг.Ссылка,
		|	ПоручениеНаДвижениеЦенныхБумаг.СчетДоверительногоУправления,
		|	ПоручениеНаДвижениеЦенныхБумаг.СчетДоверительногоУправления.КодСчета,
		|	НАЧАЛОПЕРИОДА(ПоручениеНаДвижениеЦенныхБумаг.Дата, ДЕНЬ),
		|	ПоручениеНаДвижениеЦенныхБумаг.Номер,
		|	ПоручениеНаДвижениеЦенныхБумаг.МоментВремени
		|ИЗ
		|	Документ.ПоручениеНаДвижениеЦенныхБумаг КАК ПоручениеНаДвижениеЦенныхБумаг
		|ГДЕ
 		|	ПоручениеНаДвижениеЦенныхБумаг.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И ПоручениеНаДвижениеЦенныхБумаг.Организация = &Организация
		|	И НЕ ПоручениеНаДвижениеЦенныхБумаг.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПоручениеНаДвижениеДенежныхСредств.МоментВремени
		|ИТОГИ ПО
 		|	Дата,
		|	СчетДоверительногоУправления";
		
	Запрос.УстановитьПараметр("ДатаНачала",    ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация",   ЭтотОбъект.Организация);
	
	// Инициализация вспомогательных переменных
	ПрефиксНумерации = ЭтотОбъект.Организация.ПрефиксНумерации; 
	
	ПорученияДанные = Новый ДеревоЗначений;
	ПорученияДанные.Колонки.Добавить("Документ");
	ПорученияДанные.Колонки.Добавить("Объект");
	ПорученияДанные.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ПорученияДанные.Колонки.Добавить("ТекущийНомер", Новый ОписаниеТипов("Строка"));
	ПорученияДанные.Колонки.Добавить("НовыйНомер", Новый ОписаниеТипов("Строка"));
	ПорученияДанные.Колонки.Добавить("ТребуетсяПеренумерация", Новый ОписаниеТипов("Булево"));
	ПорученияДанные.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("УникальныйИдентификатор"));		
	
	ВсегоДокументов      = 0;
	ТребуютПеренумерации = 0;
	
	ВыборкаДаты = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДаты.Следующий() Цикл
		
		СтрокаДаты = ПорученияДанные.Строки.Добавить();
		СтрокаДаты.Дата					= ВыборкаДаты.Дата;
		СтрокаДаты.Объект				= ВыборкаДаты.Дата;
		СтрокаДаты.ИдентификаторСтроки	= Новый УникальныйИдентификатор;
		
		ВыборкаСчетаДоверительногоУправления = ВыборкаДаты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСчетаДоверительногоУправления.Следующий() Цикл
			
			СтрокаСчетаДУ = СтрокаДаты.Строки.Добавить();
			СтрокаСчетаДУ.Объект				= ВыборкаСчетаДоверительногоУправления.СчетДоверительногоУправления;
			СтрокаСчетаДУ.ИдентификаторСтроки	= Новый УникальныйИдентификатор;			
			
			Выборка = ВыборкаСчетаДоверительногоУправления.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				// определим новый номер документа
				НовыйНомерДокумента = ПрефиксНумерации + "-" + Формат(Выборка.Дата, "ДФ=ddMMyy") + "/" + Выборка.КодСчетаДоверительногоУправления + "-"
					+ СтрокаСчетаДУ.Строки.Количество() + 1;
				
				// добавим строку в дерево
				ДобавитьДокументВДерево(СтрокаСчетаДУ.Строки, НовыйНомерДокумента, Выборка, ТребуютПеренумерации, ВсегоДокументов);
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;	
	
	// Заполняем результаты проверки
	РезультатПроверки = Новый Структура("Данные,ТребуютПеренумерации,ВсегоДокументов", ПорученияДанные, ТребуютПеренумерации, ВсегоДокументов);
	
	Возврат РезультатПроверки;	
КонецФункции

Функция ПолучитьИныеОперации(КодыРынковЦенныхБумаг, Ошибки)
	
	Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖурналОперацийБэкОфиса.Документ КАК Документ,
		|	ЖурналОперацийБэкОфиса.Документ КАК Объект,
		|	НАЧАЛОПЕРИОДА(ЖурналОперацийБэкОфиса.Дата, ДЕНЬ) КАК Дата,
		|	ЖурналОперацийБэкОфиса.Документ.Номер КАК ТекущийНомер,
		|	ПРЕДСТАВЛЕНИЕССЫЛКИ(Документ) КАК Представление
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|ГДЕ
		|	ЖурналОперацийБэкОфиса.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И ЖурналОперацийБэкОфиса.Организация = &Организация
		|	И ЖурналОперацийБэкОфиса.Состояние <> ЗНАЧЕНИЕ(Перечисление.СостоянияДокументов.ПомеченНаУдаление)
		|	И НЕ ЖурналОперацийБэкОфиса.ВидОперации В(&ВидОперации)
		|УПОРЯДОЧИТЬ ПО
		|	ЖурналОперацийБэкОфиса.Документ.МоментВремени
		|ИТОГИ ПО
		|	Дата
		|");
		
	ОбработанныеВидыДокументов = Новый Массив();
	ОбработанныеВидыДокументов.Добавить(Перечисления.ВидыОперацийБэкОфиса.СводнаяБиржеваяСделка);
	ОбработанныеВидыДокументов.Добавить(Перечисления.ВидыОперацийБэкОфиса.СводноеИсполнениеОбязательствПоБиржевымСделкам);
	ОбработанныеВидыДокументов.Добавить(Перечисления.ВидыОперацийБэкОфиса.Сделка);
	ОбработанныеВидыДокументов.Добавить(Перечисления.ВидыОперацийБэкОфиса.СделкаРЕПО);
	ОбработанныеВидыДокументов.Добавить(Перечисления.ВидыОперацийБэкОфиса.ПоручениеНаДвижениеДенежныхСредств);
	ОбработанныеВидыДокументов.Добавить(Перечисления.ВидыОперацийБэкОфиса.ПоручениеНаДвижениеЦенныхБумаг);
		
	Запрос.УстановитьПараметр("ДатаНачала",    ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация",   ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВидОперации",   ОбработанныеВидыДокументов);
	
	// Инициализация вспомогательных переменных
	ПрефиксНумерации = ЭтотОбъект.Организация.ПрефиксНумерации; 
	
	ИныеОперацииДанные = Новый ДеревоЗначений;
	ИныеОперацииДанные.Колонки.Добавить("Документ");
	ИныеОперацииДанные.Колонки.Добавить("Объект");
	ИныеОперацииДанные.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ИныеОперацииДанные.Колонки.Добавить("ТекущийНомер", Новый ОписаниеТипов("Строка"));
	ИныеОперацииДанные.Колонки.Добавить("НовыйНомер", Новый ОписаниеТипов("Строка"));
	ИныеОперацииДанные.Колонки.Добавить("ТребуетсяПеренумерация", Новый ОписаниеТипов("Булево"));
	ИныеОперацииДанные.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ИныеОперацииДанные.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("УникальныйИдентификатор"));		
	
	ВсегоДокументов      = 0;
	ТребуютПеренумерации = 0;
	
	ВыборкаДаты = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДаты.Следующий() Цикл
		
		СтрокаДаты = ИныеОперацииДанные.Строки.Добавить();
		СтрокаДаты.Дата						= ВыборкаДаты.Дата;
		СтрокаДаты.Объект					= ВыборкаДаты.Дата;
		СтрокаДаты.Представление			= Формат(ВыборкаДаты.Дата, "ДФ=dd.MM.yyyy");
		СтрокаДаты.ИдентификаторСтроки		= Новый УникальныйИдентификатор;			
		
		Выборка = ВыборкаДаты.Выбрать();
		
		ИндексДокумента = 0;
		
		Пока Выборка.Следующий() Цикл
			
			// определим новый номер документа
			ИндексДокумента = ИндексДокумента + 1;
			
			НовыйНомерДокумента = ПрефиксНумерации + "-" + Формат(Выборка.Дата, "ДФ=ddMMyy")
				+ "-" + Формат(ИндексДокумента, "ЧГ=") + "/ИО";
			
			// добавим строку в дерево
			ДобавитьДокументВДерево(СтрокаДаты.Строки, НовыйНомерДокумента, Выборка, ТребуютПеренумерации, ВсегоДокументов);
			
		КонецЦикла;
	КонецЦикла;
	
	// Заполняем результаты проверки
	РезультатПроверки = Новый Структура("Данные,ТребуютПеренумерации,ВсегоДокументов", ИныеОперацииДанные, ТребуютПеренумерации, ВсегоДокументов);
	
	Возврат РезультатПроверки;	
КонецФункции

Функция ПолучитьПомеченныеНаУдалениеДокументы()
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(Сделка.Дата, ДЕНЬ) КАК Дата,
		|	Сделка.Ссылка КАК Документ,
		|	Сделка.Ссылка КАК Объект,
		|	Сделка.Номер КАК ТекущийНомер,
		|	Сделка.МоментВремени КАК МоментВремени
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|ГДЕ
		|	Сделка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И Сделка.Организация = &Организация
		|	И Сделка.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И Сделка.ПометкаУдаления
		|	И Сделка.Номер ПОДОБНО ""%/%""
		|	И &ОтборПоСчетуДоверительногоУправления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ИсполнениеОбязательствПоСделке.Дата, ДЕНЬ),
		|	ИсполнениеОбязательствПоСделке.Ссылка,
		|	ИсполнениеОбязательствПоСделке.Ссылка,
		|	ИсполнениеОбязательствПоСделке.Номер,
		|	ИсполнениеОбязательствПоСделке.МоментВремени
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|ГДЕ
		|	ИсполнениеОбязательствПоСделке.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И ИсполнениеОбязательствПоСделке.Организация = &Организация
		|	И ИсполнениеОбязательствПоСделке.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И ИсполнениеОбязательствПоСделке.ПометкаУдаления
		|	И ИсполнениеОбязательствПоСделке.Номер ПОДОБНО ""%/%""
		|	И &ОтборПоСчетуДоверительногоУправления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ЖурналОперацийБэкОфиса.Дата, ДЕНЬ),
		|	ЖурналОперацийБэкОфиса.Документ,
		|	ЖурналОперацийБэкОфиса.Документ,
		|	ЖурналОперацийБэкОфиса.Документ.Номер,
		|	ЖурналОперацийБэкОфиса.Документ.МоментВремени
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|ГДЕ
		|	ЖурналОперацийБэкОфиса.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И ЖурналОперацийБэкОфиса.Организация = &Организация
		|	И ЖурналОперацийБэкОфиса.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументов.ПомеченНаУдаление)
		|	И НЕ ЖурналОперацийБэкОфиса.ВидОперации В (&ВидОперации)
		|	И ЖурналОперацийБэкОфиса.Документ.Номер ПОДОБНО ""%/%""
		|	И &ОтборПоСчетуДоверительногоУправления
		|
		|УПОРЯДОЧИТЬ ПО
		|	МоментВремени
		|ИТОГИ ПО
		|	Дата");
	
	Если ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления) Тогда	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &ОтборПоСчетуДоверительногоУправления", "И СчетДоверительногоУправления = &СчетДоверительногоУправления");		
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &ОтборПоСчетуДоверительногоУправления", "");		
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("ДатаНачала",		ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",	ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);	    	
	Запрос.УстановитьПараметр("ВидОперации",	ИсключаемыеВидыОпераций());
	
	// Инициализация вспомогательных переменных
	
	ПомеченныеНаУдалениеДокументыДанные = Новый ДеревоЗначений;
	ПомеченныеНаУдалениеДокументыДанные.Колонки.Добавить("Документ");
	ПомеченныеНаУдалениеДокументыДанные.Колонки.Добавить("Объект");
	ПомеченныеНаУдалениеДокументыДанные.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ПомеченныеНаУдалениеДокументыДанные.Колонки.Добавить("ТекущийНомер", Новый ОписаниеТипов("Строка"));
	ПомеченныеНаУдалениеДокументыДанные.Колонки.Добавить("НовыйНомер", Новый ОписаниеТипов("Строка"));
	ПомеченныеНаУдалениеДокументыДанные.Колонки.Добавить("ТребуетсяПеренумерация", Новый ОписаниеТипов("Булево"));
	ПомеченныеНаУдалениеДокументыДанные.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("УникальныйИдентификатор"));		
	
	ВсегоДокументов      = 0;
	ТребуютПеренумерации = 0;
	
	ВыборкаДаты = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДаты.Следующий() Цикл
		
		СтрокаДаты = ПомеченныеНаУдалениеДокументыДанные.Строки.Добавить();
		СтрокаДаты.Дата					= ВыборкаДаты.Дата;
		СтрокаДаты.Объект				= ВыборкаДаты.Дата;
		СтрокаДаты.ИдентификаторСтроки	= Новый УникальныйИдентификатор;			
		
		ИндексДокумента = 0;
		
		Выборка = ВыборкаДаты.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			// определим новый номер документа
			ИндексДокумента = ИндексДокумента + 1;
			
			НовыйНомерДокумента = "<Нумерация по умолчанию>";
			
			// добавим строку в дерево
			ДобавитьДокументВДерево(СтрокаДаты.Строки, НовыйНомерДокумента, Выборка, ТребуютПеренумерации, ВсегоДокументов);
			
		КонецЦикла;

	КонецЦикла;
	
	// Заполняем результаты проверки
	РезультатПроверки = Новый Структура("Данные, ТребуютПеренумерации, ВсегоДокументов", ПомеченныеНаУдалениеДокументыДанные, ТребуютПеренумерации, ВсегоДокументов);
	
	Возврат РезультатПроверки;

КонецФункции

Процедура ЗарегистрироватьОшибку(Ошибки, ТекстОшибки)
	Если Ошибки.НайтиПоЗначению(ТекстОшибки) = Неопределено Тогда
		Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьДокументВДерево(СтрокиДерева, НовыйНомерДокумента, РеквизитыДокумента, ТребуютПеренумерации, ВсегоДокументов)
	
	ВсегоДокументов = ВсегоДокументов + 1;
	
	НоваяСтрокаДерева = СтрокиДерева.Добавить();
	НоваяСтрокаДерева.НовыйНомер			= НовыйНомерДокумента;
	НоваяСтрокаДерева.ИдентификаторСтроки	= Новый УникальныйИдентификатор;
	
	ЗаполнитьЗначенияСвойств(НоваяСтрокаДерева, РеквизитыДокумента);
		
	Если НовыйНомерДокумента <> РеквизитыДокумента.ТекущийНомер	Тогда
		НоваяСтрокаДерева.ТребуетсяПеренумерация = Истина;
		
		Родитель = НоваяСтрокаДерева.Родитель;
		Пока Родитель <> Неопределено И Не Родитель.ТребуетсяПеренумерация Цикл
			Родитель.ТребуетсяПеренумерация = Истина;
			Родитель = Родитель.Родитель;
		КонецЦикла;
		
		ТребуютПеренумерации = ТребуютПеренумерации + 1;
	КонецЕсли;

КонецПроцедуры

Функция ИзменитьНомерДокумента(Документ, НовыйНомер, ТипыИзмененныхОбъектов, ПрерыватьПриОшибкеЗаписи = Истина, ОшибкиЗаписи = Неопределено)
	
	Если Документ.Номер = НовыйНомер Тогда
		Возврат 0;
	КонецЕсли;
	
	Если НовыйНомер = "<Нумерация по умолчанию>" Тогда
		Возврат ПрисвоитьСтандартныйНомер(Документ, ПрерыватьПриОшибкеЗаписи, ОшибкиЗаписи);	
	КонецЕсли;
	
	// проверим уникальность нового номера
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номер", НовыйНомер);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводДенежныхСредств.Ссылка,
		|	ВводДенежныхСредств.Дата,
		|	ВводДенежныхСредств.Организация.ПрефиксНумерации КАК ПрефиксНумерации 
		|ИЗ
		|	Документ.ВводДенежныхСредств КАК ВводДенежныхСредств
		|ГДЕ
		|	ВводДенежныхСредств.Номер = &Номер";
		
	ИмяДокумента = Документ.Метаданные().Имя;
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВводДенежныхСредств", ИмяДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если Выборка.Дата < НачалоДня(ЭтотОбъект.Период.ДатаНачала) Или Выборка.Дата > КонецДня(ЭтотОбъект.Период.ДатаОкончания) Тогда
			ВызватьИсключение "Обнаружен документ " + Выборка.Ссылка + ", не попавший в период нумерации, номер которого совпадает с плановым номером документа " + Документ;
		КонецЕсли;
		
		// изменим номер документа
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокументОбъект.УстановитьНовыйНомер(Выборка.ПрефиксНумерации + "-00");
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;	
	
	// установим новый номер
	ДокументОбъект = Документ.ПолучитьОбъект();
	ДокументОбъект.Номер = НовыйНомер;
	
	// Снимаем запрет редактирования
	ИзмененаДатаЗапретаРедактирования = Ложь;
	Если РаботаСДокументами.ЗапретРедактированияДокумента(Документ, ДокументОбъект, ИзмененаДатаЗапретаРедактирования, Ложь) Тогда
		НачатьТранзакцию();
		СнятьДатуЗапретаРедактирования(ДокументОбъект);
	КонецЕсли;
	
	Попытка
		ДокументОбъект.ДополнительныеСвойства.Вставить("НумерацияДокументов");
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись); // пока не анализируем потенциальные дубли
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось изменить номер документа " + Строка(ДокументОбъект) + ". Система сообщает: " + ОписаниеОшибки(), Документ);
		
		Если ПрерыватьПриОшибкеЗаписи Тогда 
			ВызватьИсключение;
		ИначеЕсли ИзмененаДатаЗапретаРедактирования Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		Если ОшибкиЗаписи = Неопределено Тогда
			ОшибкиЗаписи = Новый Массив;		
		КонецЕсли;
		ОшибкиЗаписи.Добавить(Документ);
		
		Возврат 0;
	КонецПопытки;
	
	// Возвращаем запрет редактирования
	Если ИзмененаДатаЗапретаРедактирования Тогда
		ВернутьДатуЗапретаРедактирования(ДокументОбъект);
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
	ТипДокумента = Тип("ДокументСсылка." +  ИмяДокумента);
	Если ТипыИзмененныхОбъектов.Найти(ТипДокумента) = Неопределено Тогда
		ТипыИзмененныхОбъектов.Добавить(ТипДокумента);
	КонецЕсли;

	Возврат 1;

КонецФункции

Функция ПрисвоитьСтандартныйНомер(Документ, ПрерыватьПриОшибкеЗаписи, ОшибкиЗаписи)
			
	// установим новый номер
	ДокументОбъект = Документ.ПолучитьОбъект();
	ДокументОбъект.УстановитьНовыйНомер();
	
	// Снимаем запрет редактирования
	ИзмененаДатаЗапретаРедактирования = Ложь;
	Если РаботаСДокументами.ЗапретРедактированияДокумента(Документ, ДокументОбъект, ИзмененаДатаЗапретаРедактирования, Ложь) Тогда
		НачатьТранзакцию();
		СнятьДатуЗапретаРедактирования(ДокументОбъект);
	КонецЕсли;
	
	Попытка
		ДокументОбъект.ДополнительныеСвойства.Вставить("НумерацияДокументов");
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись); // пока не анализируем потенциальные дубли
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось изменить номер документа " + Документ + ". Система сообщает: " + ОписаниеОшибки(), Документ);
		
		Если ПрерыватьПриОшибкеЗаписи Тогда 
			ВызватьИсключение;
		ИначеЕсли ИзмененаДатаЗапретаРедактирования Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		Если ОшибкиЗаписи = Неопределено Тогда
			ОшибкиЗаписи = Новый Массив;		
		КонецЕсли;
		ОшибкиЗаписи.Добавить(Документ);
		
		Возврат 0;
	КонецПопытки;
	
	// Возвращаем запрет редактирования
	Если ИзмененаДатаЗапретаРедактирования Тогда
		ВернутьДатуЗапретаРедактирования(ДокументОбъект);
		ЗафиксироватьТранзакцию();
	КонецЕсли;

	Возврат 1;

КонецФункции

Функция ИзменитьНомераДокументовВДереве(ДанныеДерево, ТипыИзмененныхОбъектов, Строки = Неопределено, ПрерыватьПриОшибкеЗаписи = Истина, ОшибкиЗаписи = Неопределено)
	ВсегоПеренумеровано = 0;
	
	Если Строки = Неопределено Тогда
		Строки = ДанныеДерево.Строки;
	КонецЕсли;	
	
	Для каждого Строка Из Строки Цикл
		Если Не ЗначениеЗаполнено(Строка.Документ) Тогда
			ВсегоПеренумеровано = ВсегоПеренумеровано + ИзменитьНомераДокументовВДереве(ДанныеДерево, ТипыИзмененныхОбъектов, Строка.Строки, ПрерыватьПриОшибкеЗаписи, ОшибкиЗаписи);
		Иначе
			ВсегоПеренумеровано = ВсегоПеренумеровано + ИзменитьНомерДокумента(Строка.Документ, Строка.НовыйНомер, ТипыИзмененныхОбъектов, ПрерыватьПриОшибкеЗаписи, ОшибкиЗаписи);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВсегоПеренумеровано; 
КонецФункции

Процедура СнятьДатуЗапретаРедактирования(Документ)
	
	ДатыЗапретаРедактирования = РегистрыСведений.ДатыЗапретаРедактирования.СоздатьНаборЗаписей();
	
	ДатыЗапретаРедактирования.Отбор.Организация					.Установить(Документ.Организация);
	ДатыЗапретаРедактирования.Отбор.СчетДоверительногоУправления.Установить(Документ.СчетДоверительногоУправления);
	
	ДатыЗапретаРедактирования.Прочитать();
	
	Для Каждого Запись Из ДатыЗапретаРедактирования Цикл
		Запись.ДатаЗапретаРедактирования = ДобавитьМесяц(Запись.ДатаЗапретаРедактирования, - 240);
	КонецЦикла;
	ДатыЗапретаРедактирования.Записать();
	
КонецПроцедуры

Процедура ВернутьДатуЗапретаРедактирования(Документ)
	
	ДатыЗапретаРедактирования = РегистрыСведений.ДатыЗапретаРедактирования.СоздатьНаборЗаписей();
	
	ДатыЗапретаРедактирования.Отбор.Организация					.Установить(Документ.Организация);
	ДатыЗапретаРедактирования.Отбор.СчетДоверительногоУправления.Установить(Документ.СчетДоверительногоУправления);
	
	ДатыЗапретаРедактирования.Прочитать();
	
	Для Каждого Запись Из ДатыЗапретаРедактирования Цикл
		Запись.ДатаЗапретаРедактирования = ДобавитьМесяц(Запись.ДатаЗапретаРедактирования, 240);
	КонецЦикла;
	
	ДатыЗапретаРедактирования.Записать();
	
КонецПроцедуры

Функция ИсключаемыеВидыОпераций()

	Результат = Новый Массив;
	Результат.Добавить(Перечисления.ВидыОперацийБэкОфиса.ВводОстатковАктивовСтраховыхКомпаний);
	Результат.Добавить(Перечисления.ВидыОперацийБэкОфиса.СводнаяБиржеваяСделка);
	Результат.Добавить(Перечисления.ВидыОперацийБэкОфиса.СводноеИсполнениеОбязательствПоБиржевымСделкам);
	Результат.Добавить(Перечисления.ВидыОперацийБэкОфиса.КорректировкаРегистров);
	Результат.Добавить(Перечисления.ВидыОперацийБэкОфиса.Распоряжение);
	Результат.Добавить(Перечисления.ВидыОперацийБэкОфиса.НачислениеСписаниеРезервов);
	Результат.Добавить(Перечисления.ВидыОперацийБэкОфиса.НачислениеРезервовПИФ);
	
	Возврат Результат;
	
КонецФункции
