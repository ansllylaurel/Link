Перем ОшибкиОбработки;

Процедура ЗарегистрироватьОшибку(ТекстОшибки)
	
	Если ОшибкиОбработки.Найти(ТекстОшибки) = Неопределено Тогда
		ОшибкиОбработки.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры // ЗарегистрироватьОшибку

Процедура ОповеститьОбОшибках()
	
	Если ОшибкиОбработки.Количество() > 0 Тогда
		
		ТекстОшибки = РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ОшибкиОбработки, Символы.ПС);
	
		Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
			
			ТекстОшибки = ?(ЗначениеЗаполнено(ЭтотОбъект.Субъект), "Ошибка импорта рейтингов. Объект [" + ЭтотОбъект.Субъект + "].", "") + Символы.ПС + ТекстОшибки;
			
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ТекстОшибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;
			
		ОшибкиОбработки.Очистить();
			
	КонецЕсли;
	
КонецПроцедуры  // ОповеститьОбОшибках

