
&НаСервере
Функция ПолучитьДатуНачалаВеденияУчетаНаСервере()
	
	Возврат РеквизитФормыВЗначение("Объект").ПолучитьДатуНачалаВеденияУчета();
	
КонецФункции // ПолучитьДатуНачалаВеденияУчетаНаСервере

&НаСервере
Процедура ВывестиПротоколНаСервере(Знач КомандаИмя, СтрокиПротокола, МакетОтчета)
	
	ЭтаФорма.Протокол.Очистить();
	
	Если КомандаИмя = "КомандаИмпортировать" Тогда
		Операция = "импорт";
		ОперацияРодП = "импорте";
	ИначеЕсли КомандаИмя = "КомандаНайтиРасхождения" Тогда
		Операция = "сверка";
		ОперацияРодП = "сверке";
	Иначе
		Возврат;
	КонецЕсли;
		
	// шапка
	ОбластьШапка = МакетОтчета.ПолучитьОбласть("ШапкаОтчета");
	ОбластьШапка.Параметры.ОперацияРодП  = ОперацияРодП + " рейтингов";
	ОбластьШапка.Параметры.Отбор         = ?(ЭтаФорма.ОтборПоСубъектуРейтинга, Объект.Субъект, "не установлен");
	
	ЭтаФорма.Протокол.Вывести(ОбластьШапка);
	
	ЭтаФорма.Протокол.Вывести(МакетОтчета.ПолучитьОбласть("ШапкаТаблицы|Рейтинг"));
	ЭтаФорма.Протокол.Присоединить(МакетОтчета.ПолучитьОбласть("ШапкаТаблицы|" + Операция));
	
	// табличная часть
	ОбластьСтрокаКол1 = МакетОтчета.ПолучитьОбласть("Строка|Рейтинг");
	ОбластьСтрокаКол2 = МакетОтчета.ПолучитьОбласть("Строка|" + Операция);
	
	Для Каждого СтрокаПротокола Из СтрокиПротокола Цикл
		ОбластьСтрокаКол1.Параметры.Заполнить(СтрокаПротокола);
		ОбластьСтрокаКол2.Параметры.Заполнить(СтрокаПротокола);
		
		ЭтаФорма.Протокол.Вывести(ОбластьСтрокаКол1);
		ЭтаФорма.Протокол.Присоединить(ОбластьСтрокаКол2);
	КонецЦикла;
	
КонецПроцедуры // ВывестиПротоколНаСервере

&НаСервере
Процедура ВыполнитьКомандуНаСервере(КомандаИмя)
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	Если Не (КомандаИмя = "КомандаНайтиРасхождения" Или КомандаИмя = "КомандаИмпортировать") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В обработке импорта рейтингов не прописаны действия для команды [" + КомандаИмя + "].");
		Возврат;
	КонецЕсли;
	
	СтрокиПротокола = ОбъектНаСервере.ВыполнитьКоманду(КомандаИмя);
	ВывестиПротоколНаСервере(КомандаИмя, СтрокиПротокола, ОбъектНаСервере.ПолучитьМакет("Протоколы"));
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.ДатаНачалаУчета = ПолучитьДатуНачалаВеденияУчетаНаСервере();
	
	ЭтаФорма.ОтборПоСубъектуРейтинга                = ЗначениеЗаполнено(Объект.Субъект);
	ЭтаФорма.РассылатьПротоколОбИзмененныхРейтингах = Не ПустаяСтрока(Объект.ПолучателиПротоколаОбИзмененияхРейтингов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОтборПоСубъектуРейтингаПриИзменении(Неопределено);
	РассылатьПротоколОбИзмененныхРейтингахПриИзменении(Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОтборПоСубъектуРейтингаПриИзменении(Элемент)
	
	Элементы.СубъектРейтинга.Видимость = ЭтаФорма.ОтборПоСубъектуРейтинга;
	
	Если Не ЭтаФорма.ОтборПоСубъектуРейтинга Тогда
		Объект.Субъект = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассылатьПротоколОбИзмененныхРейтингахПриИзменении(Элемент)
	
	Элементы.ПолучателиПротоколаОбИзмененияхРейтингов.Видимость = ЭтаФорма.РассылатьПротоколОбИзмененныхРейтингах;
	
	Если Не ЭтаФорма.РассылатьПротоколОбИзмененныхРейтингах Тогда
		Объект.ПолучателиПротоколаОбИзмененияхРейтингов = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаНайтиРасхождения(Команда)
	
	 ВыполнитьКомандуНаСервере(Команда.Имя)
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаИмпортировать(Команда)
	
	 ВыполнитьКомандуНаСервере(Команда.Имя)
	
КонецПроцедуры
