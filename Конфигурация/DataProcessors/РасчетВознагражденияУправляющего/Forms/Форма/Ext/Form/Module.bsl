	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "I").FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "I", КонечнаяСтрокаДвиженияАктивов, "I") + ")";

	СтраницаРасчета.КлючевыеЯчейки.Вставить("СуммаВводов" + СуффиксПоказателей, СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "C"));
	СтраницаРасчета.КлючевыеЯчейки.Вставить("ГарантированныйДоходВводов" + СуффиксПоказателей, СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "E"));	
	СтраницаРасчета.КлючевыеЯчейки.Вставить("СуммаВыводов" + СуффиксПоказателей, СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "H"));
	СтраницаРасчета.КлючевыеЯчейки.Вставить("ГарантированныйДоходВыводов" + СуффиксПоказателей, СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "I"));	

	// Заполняем формулы

	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "D");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);"""";%2-%1)", 
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(СтраницаРасчета.ВсегоСтрок, "B", Истина, Истина));  
		
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "E");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1); """"; %2 * %3 / %4 * %5%%)",
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B"),  
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "C"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "D"),
		Формат(ДанныеРасшифровки.ДнейВГоду, "ЧРД=,; ЧН=; ЧГ="),
		Формат(РасшифровкаРасчетаПоБазе.СтавкаГД, "ЧРД=,; ЧН=; ЧГ="));
		
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "D", КонечнаяСтрокаДвиженияАктивов, "E")),
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "D", НачальнаяСтрокаДвиженияАктивов, "E")));	
	КонецЕсли;	
	
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "H");
