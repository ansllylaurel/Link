			= ПредопределенноеЗначение("Справочник.БазыРасчета.ОтИнвестиционногоДоходаИСреднедневнойБалансовойСтоимостиИмуществаНаходящегосяВРазмещении")
		Тогда
			#Область От_инвестиционного_дохода_и_среднедневной_стоимости_имущества
			
			РасчетПоБалансовойСтоимости = Истина;
			СуффиксПоказателей			= ?(РасчетПоБалансовойСтоимости, "Баланс", "Рынок");
			
			// Ввод-вывод активов
			
			ОбластьДвиженияАктивов = ВывестиДвиженияАктивовExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка, СуффиксПоказателей, СуффиксПоказателей);
			
			// Стоимость активов, находящихся в управлении, на каждый день
			
			СтраницаСтоимостиАктивовПоДням = Расшифровка.Результат.ПараметрыЛистов["Стоимость активов по дням"];
			
			Если СтраницаСтоимостиАктивовПоДням = Неопределено Тогда
				
				#Область Страница_стоимости_активов_по_дням
				
				СтраницаСтоимостиАктивовПоДням = ДобавитьОписаниеСтраницыExcel("Стоимость активов по дням", Расшифровка.Результат);
				
				ШаблонСтраницыСтоимостиАктивовПоДням = Расшифровка.Шаблон.ПараметрыЛистов["Стоимость активов по дням"];
				Если ШаблонСтраницыСтоимостиАктивовПоДням = Неопределено Тогда
					ШаблонСтраницыСтоимостиАктивовПоДням = ДобавитьОписаниеСтраницыExcel("Стоимость активов по дням", Расшифровка.Шаблон, Ложь);
				КонецЕсли;
				
				ШаблонШапкиСтоимостьАктивовПоДням	= ШаблонСтраницыСтоимостиАктивовПоДням.Страница.Range("ШапкаСтоимостьАктивовПоДням");
				ШаблонСтрокиСтоимостьАктивовПоДням	= ШаблонСтраницыСтоимостиАктивовПоДням.Страница.Range("СтрокаСтоимостьАктивовПоДням");
				
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаСтоимостиАктивовПоДням, ШаблонШапкиСтоимостьАктивовПоДням, Истина, Истина);
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelОчиститьБуферОбмена(ExcelApp);
				
				БудетСтрок			= Цел((ДанныеРасшифровки.КонецРасчетногоПериода - ДанныеРасшифровки.НачалоРасчетногоПериода) / 86400) + 1;
				БудетКолонок		= 1;
				МассивДанных		= Новый Массив(БудетКолонок, Макс(БудетСтрок, 1));
				
				Для НомерСтроки = 0 По БудетСтрок - 1 Цикл 
					МассивДанных[0][НомерСтроки] = ДанныеРасшифровки.НачалоРасчетногоПериода + 86400 * НомерСтроки;
				КонецЦикла;
				
				// Подготоваливаем строки и выводим данные
				
				ПараметрыЛистаСтоимостиАктивовПоДням	= Расшифровка.Результат.ПараметрыЛистов["Стоимость активов по дням"];
				НачальнаяСтрокаЗначений					= ПараметрыЛистаСтоимостиАктивовПоДням.ВсегоСтрок + 1;
				ВысотаСтрокиЗначений					= ШаблонСтрокиСтоимостьАктивовПоДням.Rows.Count;
				
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(
