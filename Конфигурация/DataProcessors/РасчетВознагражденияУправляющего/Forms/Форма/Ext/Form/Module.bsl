	#Область Удаление_всех_страниц_кроме_Акт_для_баз_с_фиксированной_суммой
	
	// Два листа удаляются только, если после этого останется хотя бы ещё один лист
	Если НоваяКнигаExcel.Worksheets.Count >= 3 Тогда
		ТолькоФиксированнаяСумма = Неопределено;
		ФиксированнаяСуммаВГод = ПредопределенноеЗначение("Справочник.БазыРасчета.ФиксированнаяСуммаВГод");
