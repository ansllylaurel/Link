				ОбластьРасчетВознаграждения, "Дополнительная часть вознаграждения");
			
			СтраницаРасчета.КлючевыеЯчейки.Вставить(
				"ВознаграждениеОтИДиСреднедневнойСтоимостиАктивовЗаУправление" + СуффиксПоказателей,
				СтраницаРасчета.Страница.Cells(ЗаголовокВознагражденияЗаУправление.Row, "D"));
			СтраницаРасчета.КлючевыеЯчейки.Вставить(
