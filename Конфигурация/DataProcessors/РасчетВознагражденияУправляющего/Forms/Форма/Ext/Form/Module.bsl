&НаКлиенте
Функция ВывестиДвиженияАктивовСГарантированнымДоходомExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка, СуффиксПоказателей)
	
	СтраницаРасчета			= Расшифровка.Результат.ПараметрыЛистов["Расчет"];
	ШаблонСтраницыРасчета	= Расшифровка.Шаблон.ПараметрыЛистов["Расчет"];
	
	// Ищем среди ранее выведенных областей
	
	ОбластьДвиженияАктивов = СтраницаРасчета.Области.Получить("ДвиженияАктивовСГарантированнымДоходом" + СуффиксПоказателей);
	Если ОбластьДвиженияАктивов <> Неопределено Тогда
		Возврат ОбластьДвиженияАктивов; 
	КонецЕсли;
	
	ШаблонШапкиВводВыводАктивов		= ШаблонСтраницыРасчета.Страница.Range("ШапкаВводВыводАктивовСГарантированнымДоходом");	
	ШаблонСтрокиВводВыводАктивов	= ШаблонСтраницыРасчета.Страница.Range("СтрокаВводВыводАктивовСГарантированнымДоходом");	
	ШаблонИтогВводВыводАктивов		= ШаблонСтраницыРасчета.Страница.Range("ИтогВводВыводАктивовСГарантированнымДоходом");	

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонШапкиВводВыводАктивов, Ложь, Ложь);  	

	// Объединяем данные

	ВводыАктивов	= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_ВводыАктивовСНачалаГодаРазвернуто" + ?(СуффиксПоказателей = "Рынок", "", СуффиксПоказателей)];
	ВыводыАктивов	= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_ВыводыАктивовСНачалаГодаРазвернуто"];

	ВводыАктивовВсего	= ВводыАктивов.Количество();
	ВыводыАктивовВсего	= ВыводыАктивов.Количество();
	БудетСтрок			= Макс(ВводыАктивовВсего, ВыводыАктивовВсего);
	БудетКолонок		= 8;
	МассивДанных		= Новый Массив(БудетКолонок, Макс(БудетСтрок, 1));

	Для НомерСтроки = 0 По БудетСтрок - 1 Цикл 
		Если НомерСтроки < ВводыАктивовВсего Тогда
			МассивДанных[0][НомерСтроки] = ВводыАктивов[НомерСтроки]["Период"];
			МассивДанных[1][НомерСтроки] = ВводыАктивов[НомерСтроки]["СуммаВВалютеРасчета"];
		КонецЕсли;
		
		Если НомерСтроки < ВыводыАктивовВсего Тогда
			МассивДанных[4][НомерСтроки] = ВыводыАктивов[НомерСтроки]["Период"];
			МассивДанных[5][НомерСтроки] = ВыводыАктивов[НомерСтроки]["СуммаВВалютеРасчета" + СуффиксПоказателей];
		КонецЕсли;
	КонецЦикла;

	// Подготоваливаем строки и выводим данные

	НачальнаяСтрокаДвиженияАктивов	= СтраницаРасчета.ВсегоСтрок + 1;
	ВысотаСтрокиДвиженияАктивов		= ШаблонСтрокиВводВыводАктивов.Rows.Count; 

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонСтрокиВводВыводАктивов, Ложь, Ложь, ВысотаСтрокиДвиженияАктивов);  	

	Если БудетСтрок > 1 Тогда
		ОбластьЭталон = СтраницаРасчета.Страница.Range(Формат(НачальнаяСтрокаДвиженияАктивов, "ЧРД=,; ЧН=; ЧГ=") + ":" + Формат(НачальнаяСтрокаДвиженияАктивов, "ЧРД=,; ЧН=; ЧГ="));
		Для н = 2 По БудетСтрок Цикл
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelВставитьОбласть(СтраницаРасчета, ОбластьЭталон, , , , ВысотаСтрокиДвиженияАктивов, Ложь);		
		КонецЦикла;
	КонецЕсли;

	КонечнаяСтрокаДвиженияАктивов = СтраницаРасчета.ВсегоСтрок;			
	
	ОбластьДвиженияАктивов = СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B", КонечнаяСтрокаДвиженияАктивов, "I"));
	ОбластьДвиженияАктивов.Value2 = Новый COMSafeArray(МассивДанных, "VT_VARIANT");
	ОбластьДвиженияАктивов.Rows.Group();

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонИтогВводВыводАктивов, Ложь, Ложь); 

	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "B").Value2			= Формат(КонецДня(ДанныеРасшифровки.КонецРасчетногоПериода) + 1, "ДФ=dd.MM.yyyy"); // НачалоСледующегоПериода
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "C").FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "C", КонечнаяСтрокаДвиженияАктивов, "C") + ")";
