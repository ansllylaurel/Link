		|ОтборСчетДоверительногоУправленияВСписке, ОтборКлиентВСписке, ОтборВидДоговораДоверительногоУправленияВСписке");
	
	ЗаполнитьЗначенияСвойств(Настройки, ЭтаФорма);
	
	РаботаСФормамиКлиент.СохранитьНастройкиВХранилищеВариантовИНастроекОтчетов(ЭтаФорма.ИмяФормы, ЭтаФорма.КлючТекущихПараметровОтбора, Настройки, Объект.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВосстановитьПараметрыОтбора(Команда)
	
	ОписаниеНастроек = РаботаСФормамиКлиент.ПолучитьНастройкиИзХранилищаВариантовИНастроекОтчетов(ЭтаФорма.ИмяФормы, ЭтаФорма.КлючТекущихПараметровОтбора, Объект.Организация);
	
	Если ОписаниеНастроек <> Неопределено Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ОписаниеНастроек.Настройки);
		
		ПривестиОтборыВСоответствиеОрганизации(ЭтаФорма);
		
		ПриИзмененииОтбора();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПодготовитьФайлыДляЭДО(Команда)
	ПутьКФайлам = ?(Прав(ЭтаФорма.КаталогФайловExcel, 1) = "\", ЭтаФорма.КаталогФайловExcel, ЭтаФорма.КаталогФайловExcel + "\");
	ФайлыКаталога = НайтиФайлы(ПутьКФайлам, "*.xls*", Ложь);
	
	Если ФайлыКаталога.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В указанном каталоге не обнаружены файлы Excel");
		Возврат;
	КонецЕсли;
	
	ExcelApp = РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗапуститьПриложение();
	
	Если ExcelApp = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка запуска приложения Excel");
		Возврат;
	КонецЕсли;
	
	ExcelApp.DisplayAlerts = Ложь;
	
	Для Каждого Файл Из ФайлыКаталога Цикл
		ИсходныйФайл = Файл.ПолноеИмя;
		
		ПутьКНовомуФайлу = СокрЛП(СтрЗаменить(ИсходныйФайл, "с расчетом", ""));
		ПутьКНовомуФайлу = СокрЛП(СтрЗаменить(ПутьКНовомуФайлу, "расчет", ""));
		
		Попытка
			НоваяКнигаExcel = РаботаСВнешнимиСистемамиКлиентСервер.ExcelСоздатьКнигу(ExcelApp, ИсходныйФайл);
			
			// Оставляем только значения ячеек
			Для Счетчик = 1 По 2 Цикл
				ЛистExcel = НоваяКнигаExcel.Worksheets(Счетчик);
				ЛистExcel.Activate();
				xlCellTypeFormulas = -4123;
				
				Попытка
					Диапазон = ЛистExcel.Cells.SpecialCells(xlCellTypeFormulas);
				Исключение
					Продолжить;
				КонецПопытки;
				
				Если Диапазон.Count > 0 Тогда
					Для Каждого Ячейка Из Диапазон.Areas Цикл
						Ячейка.Value = Ячейка.Value;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			
			// Удаляем последний лист
			Попытка
				НоваяКнигаExcel.Worksheets(3).Delete();
			Исключение
				Продолжить;
			КонецПопытки;
			
			xlOpenXMLWorkbook = 51;
			НоваяКнигаExcel.SaveAs(ПутьКНовомуФайлу, xlOpenXMLWorkbook);
			НоваяКнигаExcel.Close();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
	ExcelApp.DisplayAlerts = Истина;
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗакрытьПриложение(ExcelApp);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Подготовлены файлы для отправки по ЭДО");
КонецПроцедуры

#КонецОбласти

#Область Заполнение_данных

&НаСервере
Процедура ОбновитьНаСервере(ДанныеДляСтатистики, ВызватьИсключениеПриОшибке = Ложь)
	ВремяНачала = ТекущаяДатаСеанса();
	ДанныеДляСтатистики.Вставить("ОбновитьНаСервере", "Старт в: " + Формат(ВремяНачала, "ДЛФ=T") + ".");
	
	ОчиститьДанные(ЭтаФорма);
	
	Если Объект.ВариантРасчета > 3 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчет вознаграждения для выбранного варианта не реализован");
		ДанныеДляСтатистики.Ошибки.Добавить("Расчет вознаграждения для выбранного варианта не реализован");
		ДанныеДляСтатистики.ОбновитьНаСервере = ДанныеДляСтатистики.ОбновитьНаСервере + " Время выполнения метода: " + РассчитатьВремя(ВремяНачала);
		Возврат;
	КонецЕсли;
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	Если Объект.ВариантРасчета = 0 Тогда // ИИС
		#Область ИИС
		
		Отбор = ПолучитьОтбор(ЭтаФорма);
		
		ПакетДанныхПоРасчетуВознаграждения = ОбъектНаСервере.ВыбратьДанныеПоРасчетуВознагражденияУправляющегоПоИИС(Отбор, , ВызватьИсключениеПриОшибке);
		
		Если ПакетДанныхПоРасчетуВознаграждения = Неопределено Тогда
			ДанныеДляСтатистики.ОбновитьНаСервере = ДанныеДляСтатистики.ОбновитьНаСервере + " Время выполнения метода: " + РассчитатьВремя(ВремяНачала);
			ДанныеДляСтатистики.Ошибки.Добавить("ПакетДанныхПоРасчетуВознаграждения = Неопределено");
			Возврат;
		КонецЕсли;
		
		// Сохраним часть данных для последующего использования
		_ДанныеПоРасчетуВознаграждения = Новый Структура;
		_ДанныеПоРасчетуВознаграждения.Вставить("СчетаДоверительногоУправления", 							ПакетДанныхПоРасчетуВознаграждения.СчетаДоверительногоУправления.Выгрузить());
		_ДанныеПоРасчетуВознаграждения.Вставить("Вознаграждения", 											ПакетДанныхПоРасчетуВознаграждения.Вознаграждения.Выгрузить());
		_ДанныеПоРасчетуВознаграждения.Вставить("ВознагражденияПлатаЗаРазмещение", 							ПакетДанныхПоРасчетуВознаграждения.ВознагражденияПлатаЗаРазмещение.Выгрузить());
		_ДанныеПоРасчетуВознаграждения.Вставить("ВводыАктивовЗаРасчетныйПериод", 							ПакетДанныхПоРасчетуВознаграждения.ВводыАктивовЗаРасчетныйПериод.Выгрузить());
		_ДанныеПоРасчетуВознаграждения.Вставить("ВводыАктивовЗаПредрасчетныйПериод", 						ПакетДанныхПоРасчетуВознаграждения.ВводыАктивовЗаПредрасчетныйПериод.Выгрузить());
		_ДанныеПоРасчетуВознаграждения.Вставить("ОплатыВознагражденийЗаПредрасчетныйПериод", 				ПакетДанныхПоРасчетуВознаграждения.ОплатыВознагражденийЗаПредрасчетныйПериод.Выгрузить());
		_ДанныеПоРасчетуВознаграждения.Вставить("ОстаткиАктивовНаНачалоРасчетногоПериода", 					ПакетДанныхПоРасчетуВознаграждения.ОстаткиАктивовНаНачалоРасчетногоПериода.Выгрузить());
		_ДанныеПоРасчетуВознаграждения.Вставить("НачисленияВознагражденийПлатаЗаРазмещениеДоДатыРасчета",	ПакетДанныхПоРасчетуВознаграждения.НачисленияВознагражденийПлатаЗаРазмещениеДоДатыРасчета.Выгрузить());
		
		ХранилищеДанныхПоРасчетуВознаграждения = Новый ХранилищеЗначения(_ДанныеПоРасчетуВознаграждения);
		
		ЭтаФорма.ДанныеПоРасчетуВознаграждения = ХранилищеДанныхПоРасчетуВознаграждения;
		
		// Отобразим вознаграждения управляющего
		НачисленияВознагражденийЗаРасчетныйПериод = ПакетДанныхПоРасчетуВознаграждения.НачисленияВознагражденийЗаРасчетныйПериод.Выгрузить();
		
		Для Каждого СтрокаВознаграждения Из _ДанныеПоРасчетуВознаграждения.Вознаграждения Цикл
			
			НоваяСтрокаВознагражденияУправляющего = ЭтаФорма.ВознагражденияУправляющего.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаВознагражденияУправляющего, СтрокаВознаграждения);
			
			// Период начисления
			
			НоваяСтрокаВознагражденияУправляющего.ПериодНачисления = Новый СтандартныйПериод(СтрокаВознаграждения.НачалоПериодаНачисления, СтрокаВознаграждения.КонецПериодаНачисления);
			
			// Начисление задолженности 
			
			Отбор = Новый Структура("СчетДоверительногоУправления", СтрокаВознаграждения.СчетДоверительногоУправления);
			СтрокиНачисленияВознагражденияУправляющего = НачисленияВознагражденийЗаРасчетныйПериод.НайтиСтроки(Отбор);
			
			Если СтрокиНачисленияВознагражденияУправляющего.Количество() = 1 Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрокаВознагражденияУправляющего, СтрокиНачисленияВознагражденияУправляющего[0], "Начисление, СуммаНачисления");
			ИначеЕсли СтрокиНачисленияВознагражденияУправляющего.Количество() > 1 Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрокаВознагражденияУправляющего, СтрокиНачисленияВознагражденияУправляющего[0], "Начисление, СуммаНачисления");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Найдено более одного начисления вознаграждения управляющего по счету д/у '" + СтрокаВознаграждения.СчетДоверительногоУправления + "'");
			КонецЕсли;
			
		КонецЦикла;
		
		// Вознаграждение управляющего - плата за размещение
		НачисленияВознагражденийПлатазаРазмещениеЗаРасчетныйПериод = ПакетДанныхПоРасчетуВознаграждения.НачисленияВознагражденийПлатаЗаРазмещениеЗаРасчетныйПериод.Выгрузить();
		
		Для Каждого СтрокаВознаграждения Из _ДанныеПоРасчетуВознаграждения.ВознагражденияПлатаЗаРазмещение Цикл
			Отбор = Новый Структура("СчетДоверительногоУправления, ВводДенежныхСредств", СтрокаВознаграждения.СчетДоверительногоУправления, СтрокаВознаграждения.ВводДенежныхСредств);
			СтрокиНачисленияВознагражденияУправляющего = НачисленияВознагражденийПлатазаРазмещениеЗаРасчетныйПериод.НайтиСтроки(Отбор);
			
			Если СтрокиНачисленияВознагражденияУправляющего.Количество() = 0 Тогда
				// Добавим строку для контроля
				НоваяСтрокаВознагражденияУправляющего = ЭтаФорма.ВознагражденияУправляющегоПлатаЗаРазмещение.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаВознагражденияУправляющего, СтрокаВознаграждения);
			КонецЕсли;
			
			Для Каждого НайдСтрокаНачисления Из СтрокиНачисленияВознагражденияУправляющего Цикл
				НоваяСтрокаВознагражденияУправляющего = ЭтаФорма.ВознагражденияУправляющегоПлатаЗаРазмещение.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаВознагражденияУправляющего, СтрокаВознаграждения);
				
				ЗаполнитьЗначенияСвойств(НоваяСтрокаВознагражденияУправляющего, НайдСтрокаНачисления, "Начисление, СуммаНачисления");
				
				// Эти данные используются только для печати, поэтому по умолчанию устанавливаем флажки для всех строк
				НоваяСтрокаВознагражденияУправляющего.Флажок = Истина;
			КонецЦикла;
			
		КонецЦикла;
		
		#КонецОбласти
		
	ИначеЕсли Объект.ВариантРасчета = 1 Тогда // вознаграждение агента
		
		#Область Вознаграждение_агента
		
		Если Не ЗначениеЗаполнено(Объект.АгентскийДоговор) Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо заполнить агентский договор");
			ДанныеДляСтатистики.ОбновитьНаСервере = ДанныеДляСтатистики.ОбновитьНаСервере + " Время выполнения метода: " + РассчитатьВремя(ВремяНачала);
			ДанныеДляСтатистики.Ошибки.Добавить("Необходимо заполнить агентский договор");
			Возврат;
		
		КонецЕсли; 
		
		ПакетДанныхПоРасчетуВознаграждения = ОбъектНаСервере.ВыбратьДанныеПоРасчетуВознагражденияУправляющегоПоИИС( , , ВызватьИсключениеПриОшибке);
		
		Если ПакетДанныхПоРасчетуВознаграждения = Неопределено Тогда
			ДанныеДляСтатистики.ОбновитьНаСервере = ДанныеДляСтатистики.ОбновитьНаСервере + " Время выполнения метода: " + РассчитатьВремя(ВремяНачала);
			ДанныеДляСтатистики.Ошибки.Добавить("ПакетДанныхПоРасчетуВознаграждения = Неопределено");
			Возврат;
		КонецЕсли;
		
		// сохраним часть данных для последующего использования
		_ДанныеПоРасчетуВознаграждения = Новый Структура;
		_ДанныеПоРасчетуВознаграждения.Вставить("Вознаграждения",									ПакетДанныхПоРасчетуВознаграждения.Вознаграждения.Выгрузить());
		_ДанныеПоРасчетуВознаграждения.Вставить("ВознагражденияПлатаЗаРазмещение", 					ПакетДанныхПоРасчетуВознаграждения.ВознагражденияПлатаЗаРазмещение.Выгрузить());
		_ДанныеПоРасчетуВознаграждения.Вставить("НачалоПериода", 									ПакетДанныхПоРасчетуВознаграждения.НачалоПериода);
		_ДанныеПоРасчетуВознаграждения.Вставить("НачалоПериодаРасчетаВознагражденияЗаПривлечение", 	ПакетДанныхПоРасчетуВознаграждения.НачалоПериодаРасчетаВознагражденияЗаПривлечение);
		_ДанныеПоРасчетуВознаграждения.Вставить("КонецБазовогоПериода", 							ПакетДанныхПоРасчетуВознаграждения.КонецБазовогоПериода);
		
		ХранилищеДанныхПоРасчетуВознаграждения = Новый ХранилищеЗначения(_ДанныеПоРасчетуВознаграждения);
		
		ЭтаФорма.ДанныеПоРасчетуВознаграждения = ХранилищеДанныхПоРасчетуВознаграждения;
		
		Для Каждого СтрокаВознаграждения Из _ДанныеПоРасчетуВознаграждения.Вознаграждения Цикл
			
			НоваяСтрока = ЭтаФорма.ВознаграждениеАгента.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВознаграждения);
			
			// Дополним строку значениями по плате за размещение
			ПараметрыОтбора = Новый Структура("СчетДоверительногоУправления", СтрокаВознаграждения.СчетДоверительногоУправления);
			НайдСтроки = _ДанныеПоРасчетуВознаграждения.ВознагражденияПлатаЗаРазмещение.НайтиСтроки(ПараметрыОтбора);
			Если НайдСтроки.Количество() = 0 Тогда
				Продолжить;	
			КонецЕсли;
			НоваяСтрока.СтавкаПлатаЗаРазмещение = НайдСтроки[0].Ставка;
			НоваяСтрока.СуммаВознагражденияПлатаЗаРазмещение = НайдСтроки[0].СуммаВознаграждения;
			
		КонецЦикла;
		
		#КонецОбласти
		
	ИначеЕсли Объект.ВариантРасчета = 2 Тогда // Вознаграждение управляющего для ПИФ
		
		#Область ПИФ
		
		ПакетДанныхПоРасчетуВознаграждения = ОбъектНаСервере.ВыбратьДанныеПоРасчетуВознагражденияУправляющегоПоПИФ();
		
		Если ПакетДанныхПоРасчетуВознаграждения = Неопределено Тогда
			ДанныеДляСтатистики.ОбновитьНаСервере = ДанныеДляСтатистики.ОбновитьНаСервере + " Время выполнения метода: " + РассчитатьВремя(ВремяНачала);
			ДанныеДляСтатистики.Ошибки.Добавить("ПакетДанныхПоРасчетуВознаграждения = Неопределено");
			Возврат;
		КонецЕсли;
		
		// сохраним часть данных для последующего использования
		_ДанныеПоРасчетуВознаграждения = Новый Структура;
		_ДанныеПоРасчетуВознаграждения.Вставить("Вознаграждения",					ПакетДанныхПоРасчетуВознаграждения.Вознаграждения.Выгрузить());
		_ДанныеПоРасчетуВознаграждения.Вставить("НачисленияВознаграждений",			ПакетДанныхПоРасчетуВознаграждения.НачисленияВознагражденийЗаРасчетныйПериод.Выгрузить());
		
		ХранилищеДанныхПоРасчетуВознаграждения = Новый ХранилищеЗначения(_ДанныеПоРасчетуВознаграждения);
		
		ЭтаФорма.ДанныеПоРасчетуВознаграждения = ХранилищеДанныхПоРасчетуВознаграждения;
		
		Для Каждого СтрокаВознаграждения Из _ДанныеПоРасчетуВознаграждения.Вознаграждения Цикл
			
			НоваяСтрока = ЭтаФорма.ВознагражденияУправляющего.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВознаграждения);
			
			// Период начисления
			
			НоваяСтрока.ПериодНачисления = Новый СтандартныйПериод(СтрокаВознаграждения.НачалоПериодаНачисления, СтрокаВознаграждения.КонецПериодаНачисления);
			
			// Дополним строку значениями по плате за размещение
			
			ПараметрыОтбора = Новый Структура("СчетДоверительногоУправления", СтрокаВознаграждения.СчетДоверительногоУправления);
			НайдСтроки = _ДанныеПоРасчетуВознаграждения.НачисленияВознаграждений.НайтиСтроки(ПараметрыОтбора);
			Если НайдСтроки.Количество() = 0 Тогда 
				НоваяСтрока.Флажок = Истина;
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НайдСтроки[0], "Начисление, СуммаНачисления");
			
			НоваяСтрока.Флажок = НоваяСтрока.СуммаВознаграждения > 0 И НоваяСтрока.СуммаВознаграждения <> НоваяСтрока.СуммаНачисления;
		КонецЦикла;
		
		#КонецОбласти
		
	ИначеЕсли Объект.ВариантРасчета = 3 Тогда // Вознаграждение управляющего по настройкам расчета
		
		#Область НПФ_ПФР_ЮЛ_ФЛ_и_прочие		
		
		Отбор = ПолучитьОтбор(ЭтаФорма);
		
		ПакетДанныхПоРасчетуВознаграждения = ОбъектНаСервере.ВыбратьДанныеПоРасчетуВознагражденияУправляющего(Отбор, Истина);
		
		Если ПакетДанныхПоРасчетуВознаграждения = Неопределено Тогда
			ДанныеДляСтатистики.ОбновитьНаСервере = ДанныеДляСтатистики.ОбновитьНаСервере + " Время выполнения метода: " + РассчитатьВремя(ВремяНачала);
			ДанныеДляСтатистики.Ошибки.Добавить("ПакетДанныхПоРасчетуВознаграждения = Неопределено");
			Возврат;
		КонецЕсли; 
		
		// Выведем сведения о рассчитанных вознаграждениях на форму
		
		Для Каждого СтрокаВознаграждения Из ПакетДанныхПоРасчетуВознаграждения.Вознаграждения Цикл
			
			НоваяСтрокаВознаграждения = ЭтаФорма.ВознагражденияУправляющего.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрокаВознаграждения, СтрокаВознаграждения);
			
			НоваяСтрокаВознаграждения.ПериодНачисления = Новый СтандартныйПериод(СтрокаВознаграждения.НачалоПериодаНачисления, СтрокаВознаграждения.КонецПериодаНачисления);
			
			НоваяСтрокаВознаграждения.Флажок = Не (
				НоваяСтрокаВознаграждения.ОшибкаРасчета
				Или НоваяСтрокаВознаграждения.ОшибкаРасчетаНачисления
				Или НоваяСтрокаВознаграждения.СуммаВознаграждения <= 0
				Или НоваяСтрокаВознаграждения.СуммаВознаграждения = НоваяСтрокаВознаграждения.СуммаНачисления
			);
			
			Если СтрокаВознаграждения.ШаблонАкта = "Будущее2023" Тогда
				НоваяСтрокаВознаграждения.НуженПодписант = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		// Сохраним данные расшифровки
		
		АдресДанныхРасшифровки = ПоместитьВоВременноеХранилище(Новый ХранилищеЗначения(ПакетДанныхПоРасчетуВознаграждения, Новый СжатиеДанных(9)), ЭтаФорма.УникальныйИдентификатор);
		
		#КонецОбласти
		
	Иначе
		
		ДанныеДляСтатистики.ОбновитьНаСервере = ДанныеДляСтатистики.ОбновитьНаСервере + " Время выполнения метода: " + РассчитатьВремя(ВремяНачала);
		ДанныеДляСтатистики.Ошибки.Добавить("Данная методика расчета вознаграждения пока не реализована");
		
		Если ВызватьИсключениеПриОшибке Тогда
			ВызватьИсключение "Данная методика расчета вознаграждения пока не реализована";
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данная методика расчета вознаграждения пока не реализована");
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ЭтаФорма.Модифицированность = Ложь;
	
	// Расшифровку пока выводим только для ИИС
	Если Объект.ВариантРасчета > 1 Тогда
		ДанныеДляСтатистики.ОбновитьНаСервере = ДанныеДляСтатистики.ОбновитьНаСервере + " Время выполнения метода: " + РассчитатьВремя(ВремяНачала);
		Возврат;
	КонецЕсли;
	
	#Область Расшифровка_расчета_вознаграждения_ИИС
	
	// Отобразим расшифровку расчета вознаграждения
	Макет = ОбъектНаСервере.ПолучитьМакет("РасшифровкаРасчета");
	
	// Шапка отчета
	Область = Макет.ПолучитьОбласть("ШапкаОтчета");
	Область.Параметры.ВариантРасчета     = Элементы.ВариантРасчета.СписокВыбора[Объект.ВариантРасчета];
	Область.Параметры.ДатаРасчета        = Формат(Объект.ДатаРасчета, "ДФ=dd.MM.yyyy");
	Область.Параметры.ПериодФормирования = ТекущаяДата();
	Область.Параметры.Организация        = Объект.Организация;
	
	ЭтаФорма.РасшифровкаРасчетаВознаграждения.Вывести(Область);
	
	// Вывод данных
	ОбластьЗаголовок1 = Макет.ПолучитьОбласть("ЗаголовокСтратегия");
	ОбластьЗаголовок2 = Макет.ПолучитьОбласть("ЗаголовокСчетаДоверительногоУправления");
	ОбластьШапка      = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьСтрока     = Макет.ПолучитьОбласть("СтрокаТаблицы");
	
	Выборка_Стратегии = ПакетДанныхПоРасчетуВознаграждения.РасшифровкаРасчетаВознаграждений.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка_Стратегии.Следующий() Цикл
		
		ОбластьЗаголовок1.Параметры.Текст = Выборка_Стратегии.Стратегия;
		ЭтаФорма.РасшифровкаРасчетаВознаграждения.Вывести(ОбластьЗаголовок1);
		ЭтаФорма.РасшифровкаРасчетаВознаграждения.НачатьГруппуСтрок();
		
		Выборка_СчетДоверительногоУправления = Выборка_Стратегии.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока Выборка_СчетДоверительногоУправления.Следующий() Цикл
			
			ОбластьЗаголовок2.Параметры.Текст = Выборка_СчетДоверительногоУправления.СчетДоверительногоУправления;
			ЭтаФорма.РасшифровкаРасчетаВознаграждения.Вывести(ОбластьЗаголовок2);
			ЭтаФорма.РасшифровкаРасчетаВознаграждения.НачатьГруппуСтрок();
			
			ЭтаФорма.РасшифровкаРасчетаВознаграждения.Вывести(ОбластьШапка);
			
			Выборка = Выборка_СчетДоверительногоУправления.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				ОбластьСтрока.Параметры.Заполнить(Выборка);
				ЭтаФорма.РасшифровкаРасчетаВознаграждения.Вывести(ОбластьСтрока);
				
			КонецЦикла;
			
			ЭтаФорма.РасшифровкаРасчетаВознаграждения.ЗакончитьГруппуСтрок();
			
		КонецЦикла;
		
		ЭтаФорма.РасшифровкаРасчетаВознаграждения.ЗакончитьГруппуСтрок();
	КонецЦикла;
	
	// Наводим красоту
	ЭтаФорма.РасшифровкаРасчетаВознаграждения.ОтображатьЗаголовки = Ложь;
	ЭтаФорма.РасшифровкаРасчетаВознаграждения.ОтображатьСетку = Ложь;
	ЭтаФорма.РасшифровкаРасчетаВознаграждения.Защита = Ложь;
	ЭтаФорма.РасшифровкаРасчетаВознаграждения.ТолькоПросмотр = Истина;
	
	#КонецОбласти
	
	ДанныеДляСтатистики.ОбновитьНаСервере = ДанныеДляСтатистики.ОбновитьНаСервере + " Время выполнения метода: " + РассчитатьВремя(ВремяНачала);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьДанные(ЭтаФорма)
	
	ЭтаФорма.ВознагражденияУправляющего.Очистить();
	ЭтаФорма.ВознаграждениеАгента.Очистить();
	ЭтаФорма.ВознагражденияУправляющегоПлатаЗаРазмещение.Очистить();
	
	ЭтаФорма.РасшифровкаРасчетаВознаграждения = Неопределено;
	
	Если ЭтоАдресВременногоХранилища(ЭтаФорма.АдресДанныхРасшифровки) Тогда
		УдалитьИзВременногоХранилища(ЭтаФорма.АдресДанныхРасшифровки);
		
		ЭтаФорма.АдресДанныхРасшифровки = Неопределено;
	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(ЭтаФорма.АдресДанныхБухгалтерииОбУдержанномВознаграждении) Тогда
		УдалитьИзВременногоХранилища(ЭтаФорма.АдресДанныхБухгалтерииОбУдержанномВознаграждении);
		
		ЭтаФорма.АдресДанныхБухгалтерииОбУдержанномВознаграждении = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Печатные_формы_расчета_вознаграждения

&НаСервере
Процедура ОбновитьСоставПечатныхФормНаСервере()
		
	// Проверяем только ИИС и ПИФ
	Если Не (Объект.ВариантРасчета = 0 Или Объект.ВариантРасчета = 2) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоРежимИИС = Объект.ВариантРасчета = 0;
		
	Элементы.ВознагражденияУправляющегоКомандаПечатьРасчетаВознагражденияПоПИФ.Видимость 					= Не ЭтоРежимИИС;
	Элементы.ВознагражденияУправляющегоКомандаПечатьРасчетаВознагражденияДляБухгалтерии.Видимость 			= ЭтоРежимИИС;
	Элементы.ВознагражденияУправляющегоКомандаПечатьРасчетаВознагражденияДляФормы482.Видимость 				= ЭтоРежимИИС;
	Элементы.ВознагражденияУправляющегоКомандаПечатьРасчетаВознагражденияЗаПериодДляБухгалтерии.Видимость 	= ЭтоРежимИИС;
		
