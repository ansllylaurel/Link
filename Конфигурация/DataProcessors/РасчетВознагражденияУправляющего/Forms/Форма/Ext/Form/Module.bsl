&НаСервереБезКонтекста
Функция ПолноеФИО(ФизЛицо, Период, Организация)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыСотрудниковОрганизации.Фамилия + "" "" + РеквизитыСотрудниковОрганизации.Имя + ВЫБОР
		|		КОГДА РеквизитыСотрудниковОрганизации.Отчество = """"
		|			ТОГДА """"
		|		ИНАЧЕ "" "" + РеквизитыСотрудниковОрганизации.Отчество
		|	КОНЕЦ КАК ПолноеФИО
		|ИЗ
		|	РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо = &ФизЛицо) КАК РеквизитыСотрудниковОрганизации");
	
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);
	Запрос.УстановитьПараметр("Период",	 Период);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.ПолноеФИО, Неопределено);
	
КонецФункции

&НаКлиенте
Функция ПараметрыОбластиExcel(Область)
	
	// Идея такая:
	// 1. Получаем все параметры и вызываем функцию ExcelУстановитьЗначениеПараметраОбласти только для имеющих параметров.
	//    Профит небольшой, а при малом количестве параметров даже наоборот проигрыш по времени, т.к. функция сама по себе весьма быстра.
	//    Но вот, например, проверку и уведомление о корректности значений можно будет делать только при наличии конкретного параметра.
	// 2. Можно получить параметр и его формат. Это позволит прямо в шаблоне указывать стандартный формат (например, для дат),
	//    а при обработке в 1С применять этот формат к значению параметра.
	
	xlLastCell		= 11;
	ВсеЯчейки		= Область.Range(Область.Cells(1, 1), Область.SpecialCells(xlLastCell)).Value2.Выгрузить(); // На самом деле это диапазон с начала области до конца листа
	ВсеПараметры	= Новый Соответствие;
	
	Для Каждого МассивКолонок Из ВсеЯчейки Цикл
		
		Для Каждого Ячейка Из МассивКолонок Цикл
			
			ПозицияСкобки = СтрНайти(Ячейка, "[");
			
			Пока ПозицияСкобки > 0 Цикл
				
				ПозицияСледующейСкобки		= СтрНайти(Ячейка, "[", , ПозицияСкобки + 1);
				ПозицияЗакрывающейСкобки	= СтрНайти(Ячейка, "]", , ПозицияСкобки + 1);
				
				Если ПозицияЗакрывающейСкобки > 0 Тогда
					
					Если ПозицияЗакрывающейСкобки < ПозицияСледующейСкобки Или ПозицияСледующейСкобки = 0 Тогда
						
						Параметр = СокрЛП(Сред(Ячейка, ПозицияСкобки + 1, ПозицияЗакрывающейСкобки - ПозицияСкобки - 1));
						
						Если Не ПустаяСтрока(Параметр) Тогда						
							ВсеПараметры.Вставить(Параметр, "");
						КонецЕсли;
						
					Иначе
						
						Сообщить("Некорректно заданы параметры: " + Ячейка);
						Прервать;
						
					КонецЕсли;
					
				КонецЕсли;
				
				ПозицияСкобки = ПозицияСледующейСкобки;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ВсеПараметры;
	
КонецФункции

