	ЭтаФорма.ОтборКлиентВСписке									= Неопределено;
	ЭтаФорма.ОтборВидДоговораДоверительногоУправленияВСписке	= Неопределено;
	ЭтаФорма.ОтборСтратегияИндивидуальногоИнвестирования		= Неопределено;
	
	ЭтаФорма.ОтборСчетДоверительногоУправления.Очистить();
	ЭтаФорма.ОтборВидДоговораДоверительногоУправления.Очистить();
	ЭтаФорма.ОтборКлиент.Очистить();
	
	ПриИзмененииОтбора();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСохранитьПараметрыОтбора(Команда)
	
