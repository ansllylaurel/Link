					Для н = 2 По БудетСтрок Цикл
						РаботаСВнешнимиСистемамиКлиентСервер.ExcelВставитьОбласть(
							ПараметрыЛистаСтоимостиАктивовПоДням, ОбластьЭталон, , , , ВысотаСтрокиЗначений, Ложь);
					КонецЦикла;
				КонецЕсли;
				
				КонечнаяСтрокаЗначений = ПараметрыЛистаСтоимостиАктивовПоДням.ВсегоСтрок;
				
				СтраницаСтоимостиАктивовПоДням.Страница.Range(
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(
						НачальнаяСтрокаЗначений, "B", КонечнаяСтрокаЗначений, "B")).Value2 = Новый COMSafeArray(МассивДанных, "VT_VARIANT");
				
				ОбластьЭталон = СтраницаСтоимостиАктивовПоДням.Страница.Cells(НачальнаяСтрокаЗначений, "C");
				ОбластьЭталон.FormulaLocal =
					СтрШаблон("=СУММЕСЛИ(Расчет!%2:%3; ""<="" & %1; Расчет!%4:%5) - СУММЕСЛИ(Расчет!%6:%7; ""<="" & %1; Расчет!%8:%9)",
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаЗначений, "B"),
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(
						ОбластьДвиженияАктивов.НачальнаяСтрока, ОбластьДвиженияАктивов.КолонкаДатаВвода, Истина, Истина),
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(
						ОбластьДвиженияАктивов.КонечнаяСтрока, ОбластьДвиженияАктивов.КолонкаДатаВвода, Истина, Истина),
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(
						ОбластьДвиженияАктивов.НачальнаяСтрока, ОбластьДвиженияАктивов.КолонкаСуммаВвода, Истина, Истина),
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(
						ОбластьДвиженияАктивов.КонечнаяСтрока, ОбластьДвиженияАктивов.КолонкаСуммаВвода, Истина, Истина),
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(
						ОбластьДвиженияАктивов.НачальнаяСтрока, ОбластьДвиженияАктивов.КолонкаДатаВывода, Истина, Истина),
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(
						ОбластьДвиженияАктивов.КонечнаяСтрока, ОбластьДвиженияАктивов.КолонкаДатаВывода, Истина, Истина),
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(
						ОбластьДвиженияАктивов.НачальнаяСтрока, ОбластьДвиженияАктивов.КолонкаСуммаВывода, Истина, Истина),
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(
						ОбластьДвиженияАктивов.КонечнаяСтрока, ОбластьДвиженияАктивов.КолонкаСуммаВывода, Истина, Истина));
					
				Если НачальнаяСтрокаЗначений <> КонечнаяСтрокаЗначений Тогда
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
						СтраницаСтоимостиАктивовПоДням.Страница.Range(
							РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаЗначений, "C", КонечнаяСтрокаЗначений, "C")),
						ОбластьЭталон,
						"ТолькоЗначения");
				КонецЕсли;
				
				ПараметрыЛистаСтоимостиАктивовПоДням.КлючевыеЯчейки.Вставить(
					"СтоимостьАктивовПоДням" + СуффиксПоказателей,
					СтраницаСтоимостиАктивовПоДням.Страница.Range(
						РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаЗначений, "C", КонечнаяСтрокаЗначений, "C")));
				
				#КонецОбласти
				
			КонецЕсли;
			
			// Расчет инвестиционного дохода
			
			ОписаниеОбластиИнвестиционногоДохода = ВывестиИнвестиционныйДоходExcel(
				ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка, РасчетПоБалансовойСтоимости, РасчетПоБалансовойСтоимости, РасчетПоБалансовойСтоимости);
			
			// Расчет вознаграждения
			
			ШаблонРасчетОтИДиСреднедневнойСтоимости = ШаблонСтраницыРасчета.Страница.Range("РасчетВознагражденияПоИДиСреднедневнойСтоимости");
			ОбластьРасчетВознаграждения = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонРасчетОтИДиСреднедневнойСтоимости);
			
			ЗаголовокВознагражденияЗаУправление	= РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоТексту(
