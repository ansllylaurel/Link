		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "F"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(СтраницаРасчета.ВсегоСтрок, "B", Истина, Истина));  

	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "I");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1); """"; %2 * %3 / %4 * %5%%)",
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "F"),  
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "G"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "H"),
		Формат(ДанныеРасшифровки.ДнейВГоду, "ЧРД=,; ЧН=; ЧГ="),
		Формат(РасшифровкаРасчетаПоБазе.СтавкаГД, "ЧРД=,; ЧН=; ЧГ="));
		
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "H", КонечнаяСтрокаДвиженияАктивов, "I")),
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "H", НачальнаяСтрокаДвиженияАктивов, "I")));	
	КонецЕсли;	
	
	СтраницаРасчета.ВсегоСтрок = СтраницаРасчета.ВсегоСтрок + 2;			

	ОбластьДвиженияАктивов = Новый Структура;
	ОбластьДвиженияАктивов.Вставить("СуффиксПоказателей",	СуффиксПоказателей);
	ОбластьДвиженияАктивов.Вставить("НачальнаяСтрока",		НачальнаяСтрокаДвиженияАктивов);
	ОбластьДвиженияАктивов.Вставить("КонечнаяСтрока",		КонечнаяСтрокаДвиженияАктивов);
	ОбластьДвиженияАктивов.Вставить("КолонкаДатаВвода",		"B");
	ОбластьДвиженияАктивов.Вставить("КолонкаСуммаВвода",	"C");
	ОбластьДвиженияАктивов.Вставить("КолонкаДнейДоВвода",	"D");
	ОбластьДвиженияАктивов.Вставить("КолонкаДатаВывода",	"F");
	ОбластьДвиженияАктивов.Вставить("КолонкаСуммаВывода",	"G");
	ОбластьДвиженияАктивов.Вставить("КолонкаДнейДоВывода",	"H");	
	
	СтраницаРасчета.Области.Вставить("ДвиженияАктивовСГарантированнымДоходом" + СуффиксПоказателей, ОбластьДвиженияАктивов); 	
	
	Возврат ОбластьДвиженияАктивов; 	
		
КонецФункции

&НаКлиенте
Функция ВывестиДвиженияАктивовСГарантированнымДоходомСВалютойРасчетаExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка, СуффиксПоказателей)
	
	СтраницаРасчета			= Расшифровка.Результат.ПараметрыЛистов["Расчет"];
	ШаблонСтраницыРасчета	= Расшифровка.Шаблон.ПараметрыЛистов["Расчет"];
	
	// Ищем среди ранее выведенных областей
	
	ОбластьДвиженияАктивов = СтраницаРасчета.Области.Получить("ДвиженияАктивовСГарантированнымДоходом" + СуффиксПоказателей);
	Если ОбластьДвиженияАктивов <> Неопределено Тогда
		Возврат ОбластьДвиженияАктивов;
	КонецЕсли;
	
	// Курсы валют
	
	СтраницаКурсовВалют = ВывестиКурсыВалютExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка);	
	
	// Область шапки
	
	ШаблонШапкиВводВыводАктивов		= ШаблонСтраницыРасчета.Страница.Range("ШапкаВводВыводАктивовСГарантированнымДоходомВалютный");	
	ШаблонСтрокиВводВыводАктивов	= ШаблонСтраницыРасчета.Страница.Range("СтрокаВводВыводАктивовСГарантированнымДоходомВалютный");	
	ШаблонИтогВводВыводАктивов		= ШаблонСтраницыРасчета.Страница.Range("ИтогВводВыводАктивовСГарантированнымДоходомВалютный");	

	ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонШапкиВводВыводАктивов, Ложь, Ложь);  	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "БалансРынок", ?(СуффиксПоказателей = "Рынок", "(по рын. стоимости)", "(по бал. стоимости)"), Истина);  
	
	// Подготавливаем данные

	ВводыАктивов	= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_ВводыАктивовСНачалаГодаРазвернуто" + ?(СуффиксПоказателей = "Рынок", "", СуффиксПоказателей)];
	ВыводыАктивов	= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_ВыводыАктивовСНачалаГодаРазвернуто"];

	ВводыАктивовВсего		= ВводыАктивов.Количество();
	ВыводыАктивовВсего		= ВыводыАктивов.Количество();
	БудетСтрок				= Макс(ВводыАктивовВсего, ВыводыАктивовВсего);
	БудетКолонок			= 12;
	МассивДанных			= Новый Массив(БудетКолонок, Макс(БудетСтрок, 1));
	ЕстьСЧАНаНачалоГода		= Ложь;
	
	Для НомерСтроки = 0 По БудетСтрок - 1 Цикл 
		Если НомерСтроки < ВводыАктивовВсего Тогда
			МассивДанных[0][НомерСтроки] = ВводыАктивов[НомерСтроки]["Период"];
			МассивДанных[1][НомерСтроки] = ВводыАктивов[НомерСтроки]["Сумма"];
			МассивДанных[2][НомерСтроки] = Строка(ВводыАктивов[НомерСтроки]["Валюта"]);
			Если ВводыАктивов[НомерСтроки]["СЧАНаНачалоГода"] Тогда 
				ЕстьСЧАНаНачалоГода = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если НомерСтроки < ВыводыАктивовВсего Тогда
			МассивДанных[6][НомерСтроки] = ВыводыАктивов[НомерСтроки]["Период"];
			МассивДанных[7][НомерСтроки] = ВыводыАктивов[НомерСтроки]["Сумма" + СуффиксПоказателей];
			МассивДанных[8][НомерСтроки] = Строка(ВыводыАктивов[НомерСтроки]["Валюта"]);
		КонецЕсли;
	КонецЦикла;

	// Подготоваливаем строки и выводим данные

	НачальнаяСтрокаДвиженияАктивов	= СтраницаРасчета.ВсегоСтрок + 1;
	ВысотаСтрокиДвиженияАктивов		= ШаблонСтрокиВводВыводАктивов.Rows.Count; 

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонСтрокиВводВыводАктивов, Ложь, Ложь, ВысотаСтрокиДвиженияАктивов);  	

	Если БудетСтрок > 1 Тогда
		ОбластьЭталон = СтраницаРасчета.Страница.Range(Формат(НачальнаяСтрокаДвиженияАктивов, "ЧРД=,; ЧН=; ЧГ=") + ":" + Формат(НачальнаяСтрокаДвиженияАктивов, "ЧРД=,; ЧН=; ЧГ="));
		Для н = 2 По БудетСтрок Цикл
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelВставитьОбласть(СтраницаРасчета, ОбластьЭталон, , , , ВысотаСтрокиДвиженияАктивов, Ложь);
		КонецЦикла;
	КонецЕсли;

	КонечнаяСтрокаДвиженияАктивов = СтраницаРасчета.ВсегоСтрок;			

	ОбластьДвиженияАктивов = СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B", КонечнаяСтрокаДвиженияАктивов, "M"));
	ОбластьДвиженияАктивов.Value2 = Новый COMSafeArray(МассивДанных, "VT_VARIANT");
	ОбластьДвиженияАктивов.Rows.Group();
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонИтогВводВыводАктивов, Ложь, Ложь); 

	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "B").Value2			= Формат(КонецДня(ДанныеРасшифровки.КонецРасчетногоПериода) + 1, "ДФ=dd.MM.yyyy"); // НачалоСледующегоПериода
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "E").FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "E", КонечнаяСтрокаДвиженияАктивов, "E") + ")";
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "G").FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "G", КонечнаяСтрокаДвиженияАктивов, "G") + ")";
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "K").FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "K", КонечнаяСтрокаДвиженияАктивов, "K") + ")";
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "M").FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "M", КонечнаяСтрокаДвиженияАктивов, "M") + ")";

	СтраницаРасчета.КлючевыеЯчейки.Вставить("СуммаВводов" + СуффиксПоказателей,					СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "E"));
	СтраницаРасчета.КлючевыеЯчейки.Вставить("ГарантированныйДоходВводов" + СуффиксПоказателей,	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "G"));	
	СтраницаРасчета.КлючевыеЯчейки.Вставить("СуммаВыводов" + СуффиксПоказателей,				СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "K"));
	СтраницаРасчета.КлючевыеЯчейки.Вставить("ГарантированныйДоходВыводов" + СуффиксПоказателей, СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "M"));	

	// Сумма ввода в валюте расчета	
	
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "E");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);""""; %2 * ЕСЛИ(%3=ВалютаРасчета;1; ЕСЛИ(%3=""RUB"";1;ВПР(%3 & %1;%4;2;ЛОЖЬ)) / ЕСЛИ(ВалютаРасчета=""RUB"";1;ВПР(ВалютаРасчета & %1;%4;2;ЛОЖЬ))))", 
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "C"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "D"),
		СтраницаКурсовВалют.КлючевыеЯчейки["КурсыВалют"].Address(Истина, Истина, , Истина));  
		
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "E", КонечнаяСтрокаДвиженияАктивов, "E")),
			ОбластьЭталон);	
	КонецЕсли;	
		
	Если ЕстьСЧАНаНачалоГода Тогда
		
		Если СуффиксПоказателей = "Рынок" Тогда // Дата расчета СЧА по рыночной стоимости отличается от даты ввода
			ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);НД(); %2 * ЕСЛИ(%3=ВалютаРасчета;1; ЕСЛИ(%3=""RUB"";1;ВПР(%3 & %1;%4;2;ЛОЖЬ)) / ЕСЛИ(ВалютаРасчета=""RUB"";1;ВПР(ВалютаРасчета & %1;%4;2;ЛОЖЬ))))", 
				"ДатаРасчетаСЧАНаНачалоГода",
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "C"),
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "D"),
				СтраницаКурсовВалют.КлючевыеЯчейки["КурсыВалют"].Address(Истина, Истина, , Истина));
		КонецЕсли;
		
		СтраницаРасчета.КлючевыеЯчейки.Вставить("СЧАНаНачалоГода" + СуффиксПоказателей, ОбластьЭталон);	
		
	КонецЕсли;
	
	// Дней от ввода до расчета
	
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "F");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);"""";%2-%1)", 
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(СтраницаРасчета.ВсегоСтрок, "B", Истина, Истина));  
		
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "F", КонечнаяСтрокаДвиженияАктивов, "F")),
			ОбластьЭталон);	
	КонецЕсли;
	
	// Гарантированный доход вводов
	
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "G");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1); """"; %2 * %3 / %4 * %5%%)",
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B"),  
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "E"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "F"),
		Формат(ДанныеРасшифровки.ДнейВГоду, "ЧРД=,; ЧН=; ЧГ="),
		Формат(РасшифровкаРасчетаПоБазе.СтавкаГД, "ЧРД=,; ЧН=; ЧГ="));
	
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "G", КонечнаяСтрокаДвиженияАктивов, "G")),
			ОбластьЭталон);	
	КонецЕсли;
	
	// Сумма вывода в валюте расчета
	
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "K");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);""""; %2 * ЕСЛИ(%3=ВалютаРасчета;1; ЕСЛИ(%3=""RUB"";1;ВПР(%3 & %1;%4;2;ЛОЖЬ)) / ЕСЛИ(ВалютаРасчета=""RUB"";1;ВПР(ВалютаРасчета & %1;%4;2;ЛОЖЬ))))", 
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "H"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "I"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "J"),
		СтраницаКурсовВалют.КлючевыеЯчейки["КурсыВалют"].Address(Истина, Истина, , Истина));  
		
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "K", КонечнаяСтрокаДвиженияАктивов, "K")),
			ОбластьЭталон);	
	КонецЕсли;	
	
	// Дней от вывода до расчета
	
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "L");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);"""";%2-%1)",
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "H"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(СтраницаРасчета.ВсегоСтрок, "B", Истина, Истина));  
		
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "L", КонечнаяСтрокаДвиженияАктивов, "L")),
			ОбластьЭталон);
	КонецЕсли;	
	
	// Гарантированный доход выводов
	
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "M");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1); """"; %2 * %3 / %4 * %5%%)",
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "H"),  
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "K"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "L"),
		Формат(ДанныеРасшифровки.ДнейВГоду, "ЧРД=,; ЧН=; ЧГ="),
		Формат(РасшифровкаРасчетаПоБазе.СтавкаГД, "ЧРД=,; ЧН=; ЧГ="));
		
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "M", КонечнаяСтрокаДвиженияАктивов, "M")),
			ОбластьЭталон);	
	КонецЕсли;	
	
	СтраницаРасчета.ВсегоСтрок = СтраницаРасчета.ВсегоСтрок + 2;			

	ОбластьДвиженияАктивов = Новый Структура;
	ОбластьДвиженияАктивов.Вставить("СуффиксПоказателей",	СуффиксПоказателей);
	ОбластьДвиженияАктивов.Вставить("НачальнаяСтрока",		НачальнаяСтрокаДвиженияАктивов);
	ОбластьДвиженияАктивов.Вставить("КонечнаяСтрока",		КонечнаяСтрокаДвиженияАктивов);
	ОбластьДвиженияАктивов.Вставить("КолонкаДатаВвода",		"B");
	ОбластьДвиженияАктивов.Вставить("КолонкаСуммаВвода",	"E");
	ОбластьДвиженияАктивов.Вставить("КолонкаДнейДоВвода",	"F");
	ОбластьДвиженияАктивов.Вставить("КолонкаДатаВывода",	"H");
	ОбластьДвиженияАктивов.Вставить("КолонкаСуммаВывода",	"K");
	ОбластьДвиженияАктивов.Вставить("КолонкаДнейДоВывода",	"L");
	
	СтраницаРасчета.Области.Вставить("ДвиженияАктивовСГарантированнымДоходом" + СуффиксПоказателей, ОбластьДвиженияАктивов);
	
	Возврат ОбластьДвиженияАктивов; 	
	
КонецФункции

&НаКлиенте
Функция ВывестиКурсыВалютExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка)
	
	// Ищем среди ранее выведенных областей
	
	СтраницаКурсовВалют = Расшифровка.Результат.ПараметрыЛистов["Курсы валют"];
	
	Если СтраницаКурсовВалют <> Неопределено Тогда
		Возврат СтраницаКурсовВалют;
	КонецЕсли;
		
	// Формируем страницу
	
	СтраницаКурсовВалют = ДобавитьОписаниеСтраницыExcel("Курсы валют", Расшифровка.Результат);
		
	ШаблонСтраницы = Расшифровка.Шаблон.ПараметрыЛистов["Курсы валют"]; 
	Если ШаблонСтраницы = Неопределено Тогда
		ШаблонСтраницы = ДобавитьОписаниеСтраницыExcel("Курсы валют", Расшифровка.Шаблон, Ложь);
	КонецЕсли;
	
	ШаблонШапки		= ШаблонСтраницы.Страница.Range("ШапкаКурсыВалют");	
	ШаблонСтроки	= ШаблонСтраницы.Страница.Range("СтрокаКурсыВалют");	

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаКурсовВалют, ШаблонШапки, Истина, Истина);
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelОчиститьБуферОбмена(Расшифровка.ExcelApp);	
	
	ЗначенияКурсов = РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_КурсыВалют"];

	БудетСтрок			= ЗначенияКурсов.Количество();
	БудетКолонок		= 4;
	МассивДанных		= Новый Массив(БудетКолонок, Макс(БудетСтрок, 1));

	Для НомерСтроки = 0 По БудетСтрок - 1 Цикл 
		МассивДанных[0][НомерСтроки] = Строка(ЗначенияКурсов[НомерСтроки]["Валюта"]);
		МассивДанных[1][НомерСтроки] = ЗначенияКурсов[НомерСтроки]["Дата"];
		МассивДанных[2][НомерСтроки] = СтрШаблон("= %1 & %2",
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(СтраницаКурсовВалют.ВсегоСтрок + НомерСтроки + 1, "B"),
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(СтраницаКурсовВалют.ВсегоСтрок + НомерСтроки + 1, "C"));
		МассивДанных[3][НомерСтроки] = ЗначенияКурсов[НомерСтроки]["Курс"];
	КонецЦикла;

	// Подготоваливаем строки и выводим данные

	НачальнаяСтрокаЗначений	= СтраницаКурсовВалют.ВсегоСтрок + 1;
	ВысотаСтрокиЗначений	= ШаблонСтроки.Rows.Count; 

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаКурсовВалют, ШаблонСтроки, Ложь, Ложь, ВысотаСтрокиЗначений);  	
	
	// Так как нужно вывести множество однотипных строк, то будем их выводить в геометрической прогрессии
	
	Если БудетСтрок > 1 Тогда
		
		н = 2;
		КоличествоСтрокВЭталоне = 0;
		
		Пока н <= БудетСтрок Цикл
			
			КоличествоСтрокВЭталоне = Макс(1, КоличествоСтрокВЭталоне * 2);
			Если н + КоличествоСтрокВЭталоне - 1 > БудетСтрок Тогда
				КоличествоСтрокВЭталоне = БудетСтрок - н + 1;
			КонецЕсли;
			
			ОбластьЭталон = СтраницаКурсовВалют.Страница.Range(Формат(НачальнаяСтрокаЗначений, "ЧРД=,; ЧН=; ЧГ=") + ":" + Формат(НачальнаяСтрокаЗначений + КоличествоСтрокВЭталоне - 1, "ЧРД=,; ЧН=; ЧГ="));
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelВставитьОбласть(СтраницаКурсовВалют, ОбластьЭталон, , , , ВысотаСтрокиЗначений * КоличествоСтрокВЭталоне, Ложь);		
			
			н = н + КоличествоСтрокВЭталоне;			
			
		КонецЦикла;
		
	КонецЕсли;

	КонечнаяСтрокаЗначений = СтраницаКурсовВалют.ВсегоСтрок;
	
	СтраницаКурсовВалют.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаЗначений, "B", КонечнаяСтрокаЗначений, "E")).FormulaLocal = Новый COMSafeArray(МассивДанных, "VT_VARIANT");
		
	СтраницаКурсовВалют.КлючевыеЯчейки.Вставить("КурсыВалют", СтраницаКурсовВалют.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаЗначений, "D", КонечнаяСтрокаЗначений, "E")));
	
	Возврат СтраницаКурсовВалют;	
	
КонецФункции

&НаКлиенте
Функция ВывестиУплаченноеВознаграждениеСВалютойРасчетаExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка)
	
	СтраницаРасчета			= Расшифровка.Результат.ПараметрыЛистов["Расчет"];
	ШаблонСтраницыРасчета	= Расшифровка.Шаблон.ПараметрыЛистов["Расчет"].Страница;
	
	// Ищем среди ранее выведенных областей
	
	ОбластьУдержанноеВознаграждение = СтраницаРасчета.Области.Получить("ВознаграждениеУплаченное");
	Если ОбластьУдержанноеВознаграждение <> Неопределено Тогда
		Возврат ОбластьУдержанноеВознаграждение;
	КонецЕсли;
	
	// Курсы валют
	
	СтраницаКурсовВалют = ВывестиКурсыВалютExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка);	
	
	// Область шапки
	
	ШаблонШапки		= ШаблонСтраницыРасчета.Range("ШапкаВознаграждениеУдержанное");	
	ШаблонСтроки	= ШаблонСтраницыРасчета.Range("СтрокаВознаграждениеУдержанное");	
	ШаблонИтогов	= ШаблонСтраницыРасчета.Range("ИтогВознаграждениеУдержанное");	

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонШапки);  	
	
	// Подготоваливаем данные

	ТаблицаДанных		= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_ВознаграждениеУплаченноеСНачалаГодаРазвернуто"];
	БудетСтрок			= ТаблицаДанных.Количество();
	БудетКолонок		= 3;
	МассивДанных		= Новый Массив(БудетКолонок, Макс(БудетСтрок, 1));

	АдресОбластиКурсовВалют = СтраницаКурсовВалют.КлючевыеЯчейки["КурсыВалют"].Address(Истина, Истина, , Истина);
	
	Для НомерСтроки = 0 По БудетСтрок - 1 Цикл 
		МассивДанных[0][НомерСтроки] = ТаблицаДанных[НомерСтроки]["ДатаНачисления"];
		МассивДанных[1][НомерСтроки] = ТаблицаДанных[НомерСтроки]["СуммаВВалютеУчета"];
		МассивДанных[2][НомерСтроки] = СтрШаблон("= %1 / ЕСЛИ(ВалютаРасчета=""RUB""; 1; ВПР(ВалютаРасчета & %2; %3; 2; ЛОЖЬ))",
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(СтраницаРасчета.ВсегоСтрок + НомерСтроки + 1, "C"),
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(СтраницаРасчета.ВсегоСтрок + НомерСтроки + 1, "B"),
			АдресОбластиКурсовВалют);
	КонецЦикла;	
	
	// Подготоваливаем строки и выводим данные

	НачальнаяСтрока	= СтраницаРасчета.ВсегоСтрок + 1;
	ВысотаСтроки	= ШаблонСтроки.Rows.Count; 

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонСтроки, Ложь, Ложь, ВысотаСтроки);  	

	Если БудетСтрок > 1 Тогда
		ОбластьЭталон = СтраницаРасчета.Страница.Range(Формат(НачальнаяСтрока, "ЧРД=,; ЧН=; ЧГ=") + ":" + Формат(НачальнаяСтрока, "ЧРД=,; ЧН=; ЧГ="));
		Для н = 2 По БудетСтрок Цикл
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelВставитьОбласть(СтраницаРасчета, ОбластьЭталон, , , , ВысотаСтроки, Ложь);		
		КонецЦикла;
	КонецЕсли;

	КонечнаяСтрока = СтраницаРасчета.ВсегоСтрок;			

	ОбластьДанных = СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрока, "B", КонечнаяСтрока, "D"));
	ОбластьДанных.FormulaLocal = Новый COMSafeArray(МассивДанных, "VT_VARIANT");
	ОбластьДанных.Rows.Group();

	// Область итогов
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонИтогов, Ложь, Ложь); 

	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "C").FormulaLocal = "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрока, "C", КонечнаяСтрока, "C") + ")";
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "D").FormulaLocal = "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрока, "D", КонечнаяСтрока, "D") + ")";	

	СтраницаРасчета.КлючевыеЯчейки.Вставить("ВознаграждениеУплаченноеВВалютеУчета", СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "C"));	
	СтраницаРасчета.КлючевыеЯчейки.Вставить("ВознаграждениеУплаченное",				СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "D"));	
	
	СтраницаРасчета.ВсегоСтрок = СтраницаРасчета.ВсегоСтрок + 2;
	
	// Формируем описание области
	
	ОбластьУдержанноеВознаграждение = Новый Структура;
	ОбластьУдержанноеВознаграждение.Вставить("КолонкаСуммаВВалютеУчета",	"C");
	ОбластьУдержанноеВознаграждение.Вставить("КолонкаСумма",				"D");
	
	СтраницаРасчета.Области.Вставить("ВознаграждениеУплаченное", ОбластьУдержанноеВознаграждение); 	
	
	Возврат ОбластьУдержанноеВознаграждение; 	
	
КонецФункции

&НаКлиенте
Функция ВывестиУплаченныйНДФЛСВалютойРасчетаExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка)
	
	СтраницаРасчета			= Расшифровка.Результат.ПараметрыЛистов["Расчет"];
	ШаблонСтраницыРасчета	= Расшифровка.Шаблон.ПараметрыЛистов["Расчет"].Страница;
	
	// Ищем среди ранее выведенных областей
	
	ОбластьУплаченныйНДФЛ = СтраницаРасчета.Области.Получить("УплаченныйНДФЛ");
	Если ОбластьУплаченныйНДФЛ <> Неопределено Тогда
		Возврат ОбластьУплаченныйНДФЛ;
	КонецЕсли;
	
	// Курсы валют
	
	СтраницаКурсовВалют = ВывестиКурсыВалютExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка);	
	
	// Область шапки
	
	ШаблонШапки		= ШаблонСтраницыРасчета.Range("ШапкаНДФЛУплаченный");	
	ШаблонСтроки	= ШаблонСтраницыРасчета.Range("СтрокаНДФЛУплаченный");	
	ШаблонИтогов	= ШаблонСтраницыРасчета.Range("ИтогНДФЛУплаченный");	

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонШапки);  	
	
	// Подготоваливаем данные

	ТаблицаДанных		= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_НДФЛУплаченныйСНачалаГодаРазвернуто"];
	БудетСтрок			= ТаблицаДанных.Количество();
	БудетКолонок		= 3;
	МассивДанных		= Новый Массив(БудетКолонок, Макс(БудетСтрок, 1));

	АдресОбластиКурсовВалют = СтраницаКурсовВалют.КлючевыеЯчейки["КурсыВалют"].Address(Истина, Истина, , Истина);
	
	Для НомерСтроки = 0 По БудетСтрок - 1 Цикл 
		МассивДанных[0][НомерСтроки] = ТаблицаДанных[НомерСтроки]["ДатаОплаты"];
		МассивДанных[1][НомерСтроки] = ТаблицаДанных[НомерСтроки]["СуммаВВалютеУчета"];
		МассивДанных[2][НомерСтроки] = СтрШаблон("= %1 / ЕСЛИ(ВалютаРасчета=""RUB""; 1; ВПР(ВалютаРасчета & %2; %3; 2; ЛОЖЬ))",
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(СтраницаРасчета.ВсегоСтрок + НомерСтроки + 1, "C"),
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(СтраницаРасчета.ВсегоСтрок + НомерСтроки + 1, "B"),
			АдресОбластиКурсовВалют);
	КонецЦикла;	
	
	// Подготоваливаем строки и выводим данные

	НачальнаяСтрока	= СтраницаРасчета.ВсегоСтрок + 1;
	ВысотаСтроки	= ШаблонСтроки.Rows.Count; 

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонСтроки, Ложь, Ложь, ВысотаСтроки);  	

	Если БудетСтрок > 1 Тогда
		ОбластьЭталон = СтраницаРасчета.Страница.Range(Формат(НачальнаяСтрока, "ЧРД=,; ЧН=; ЧГ=") + ":" + Формат(НачальнаяСтрока, "ЧРД=,; ЧН=; ЧГ="));
		Для н = 2 По БудетСтрок Цикл
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelВставитьОбласть(СтраницаРасчета, ОбластьЭталон, , , , ВысотаСтроки, Ложь);		
		КонецЦикла;
	КонецЕсли;

	КонечнаяСтрока = СтраницаРасчета.ВсегоСтрок;			

	ОбластьДанных = СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрока, "B", КонечнаяСтрока, "D"));
	ОбластьДанных.FormulaLocal = Новый COMSafeArray(МассивДанных, "VT_VARIANT");
	ОбластьДанных.Rows.Group();

	// Область итогов
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонИтогов, Ложь, Ложь); 

	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "C").FormulaLocal = "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрока, "C", КонечнаяСтрока, "C") + ")";
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "D").FormulaLocal = "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрока, "D", КонечнаяСтрока, "D") + ")";	

	СтраницаРасчета.КлючевыеЯчейки.Вставить("УплаченныйНДФЛВВалютеУчета", СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "C"));	
	СтраницаРасчета.КлючевыеЯчейки.Вставить("УплаченныйНДФЛ",			  СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "D"));	
	
	СтраницаРасчета.ВсегоСтрок = СтраницаРасчета.ВсегоСтрок + 2;
	
	// Формируем описание области
	
	ОбластьУплаченныйНДФЛ = Новый Структура;
	ОбластьУплаченныйНДФЛ.Вставить("КолонкаСуммаВВалютеУчета",	"C");
	ОбластьУплаченныйНДФЛ.Вставить("КолонкаСумма",				"D");
	
	СтраницаРасчета.Области.Вставить("УплаченныйНДФЛ", ОбластьУплаченныйНДФЛ); 	
	
	Возврат ОбластьУплаченныйНДФЛ; 	
	
КонецФункции

&НаКлиенте
Функция ВывестиРасходыПоУправлению(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка)
	
	СтраницаРасчета			= Расшифровка.Результат.ПараметрыЛистов["Расчет"];
	ШаблонСтраницыРасчета	= Расшифровка.Шаблон.ПараметрыЛистов["Расчет"].Страница;
	
	// Ищем среди ранее выведенных областей
	
	ОбластьРасходыПоУправлению = СтраницаРасчета.Области.Получить("РасходыПоУправлению");
	Если ОбластьРасходыПоУправлению <> Неопределено Тогда
		Возврат ОбластьРасходыПоУправлению;
	КонецЕсли;
	
	// Область шапки
	
	ШаблонШапки		= ШаблонСтраницыРасчета.Range("ШапкаРасходыПоУправлению");	
	ШаблонСтроки	= ШаблонСтраницыРасчета.Range("СтрокаРасходыПоУправлению");	
	ШаблонИтогов	= ШаблонСтраницыРасчета.Range("ИтогРасходыПоУправлению");	

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонШапки);  	
	
	// Подготоваливаем данные

	ТаблицаДанных		= ПолучитьРасходыПоУправлению(ДанныеРасшифровки.СчетДоверительногоУправления, ДанныеРасшифровки.Организация, ДанныеРасшифровки.НачалоРасчетногоПериода, ДанныеРасшифровки.КонецРасчетногоПериода);
	БудетСтрок			= ТаблицаДанных.Количество();
	БудетКолонок		= 4;
	МассивДанных		= Новый Массив(БудетКолонок, Макс(БудетСтрок, 1));
	
	Для НомерСтроки = 0 По БудетСтрок - 1 Цикл 
		МассивДанных[0][НомерСтроки] = ТаблицаДанных[НомерСтроки]["ВидРасходов"];
		МассивДанных[3][НомерСтроки] = ТаблицаДанных[НомерСтроки]["НачисленоВВалютеУчета"];
	КонецЦикла;	
	
	// Подготоваливаем строки и выводим данные

	НачальнаяСтрока	= СтраницаРасчета.ВсегоСтрок + 1;
	ВысотаСтроки	= ШаблонСтроки.Rows.Count; 

	Для н = 1 По БудетСтрок Цикл
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонСтроки, Ложь, Ложь, ВысотаСтроки); // вывожу через ExcelВывестиОбласть, т.к. через ExcelВставитьОбласть теряется объединение ячеек	
	КонецЦикла;

	КонечнаяСтрока = СтраницаРасчета.ВсегоСтрок;			

	ОбластьДанных = СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрока, "B", КонечнаяСтрока, "E"));
	ОбластьДанных.FormulaLocal = Новый COMSafeArray(МассивДанных, "VT_VARIANT");
	ОбластьДанных.Rows.Group();

	// Область итогов
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонИтогов, Ложь, Ложь); 

	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "E").FormulaLocal = "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрока, "E", КонечнаяСтрока, "E") + ")";

	СтраницаРасчета.КлючевыеЯчейки.Вставить("РасходыПоУправлениюНачисленоВВалютеУчета", СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "E"));	
	
	СтраницаРасчета.ВсегоСтрок = СтраницаРасчета.ВсегоСтрок + 2;
	
	// Формируем описание области
	
	ОбластьРасходыПоУправлению = Новый Структура;
	ОбластьРасходыПоУправлению.Вставить("КолонкаНачисленоВВалютеУчета",	"E");
	
	СтраницаРасчета.Области.Вставить("РасходыПоУправлению", ОбластьРасходыПоУправлению); 	
	
	Возврат ОбластьРасходыПоУправлению; 	
	
КонецФункции

&НаКлиенте
Функция ВывестиРасходыПоДоговоруСоСпецдепозитарием(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка)
	
	СтраницаРасчета			= Расшифровка.Результат.ПараметрыЛистов["Расчет"];
	ШаблонСтраницыРасчета	= Расшифровка.Шаблон.ПараметрыЛистов["Расчет"].Страница;
	ИмяОбласти				= "РасходыПоДоговоруСоСпецдепозитарием";
	
	// Ищем среди ранее выведенных областей
	
	ВыведеннаяОбласть = СтраницаРасчета.Области.Получить(ИмяОбласти);
	Если ВыведеннаяОбласть <> Неопределено Тогда
		Возврат ВыведеннаяОбласть;
	КонецЕсли;
	
	// Область шапки
	
	ШаблонШапки		= ШаблонСтраницыРасчета.Range("ШапкаРасходыПоУправлениюЗаголовок");	
	ШаблонСтроки	= ШаблонСтраницыРасчета.Range("СтрокаРасходыПоУправлению");	
	ШаблонИтогов	= ШаблонСтраницыРасчета.Range("ИтогРасходыПоУправлению");	

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонШапки);  	
	
	// Подготоваливаем данные

	ТаблицаДанных		= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_НеобходимыеРасходыИСтоимостьУслугСпецдепозитарияСНачалаГодаРазвернуто"];
	БудетСтрок			= ТаблицаДанных.Количество();
	БудетКолонок		= 4;
	МассивДанных		= Новый Массив(БудетКолонок, Макс(БудетСтрок, 1));
	
	Для НомерСтроки = 0 По БудетСтрок - 1 Цикл 
		МассивДанных[0][НомерСтроки] = Строка(ТаблицаДанных[НомерСтроки]["ВидЗадолженности"]);
		МассивДанных[3][НомерСтроки] = ?(ТаблицаДанных[НомерСтроки]["СуммаВВалютеРасчета"] = NULL, "=НД()", ТаблицаДанных[НомерСтроки]["СуммаВВалютеРасчета"]);
	КонецЦикла;	
	
	// Подготоваливаем строки и выводим данные

	РасходыПоДоговоруСоСпецдепозитарием = Новый Соответствие;
	
	НачальнаяСтрока	= СтраницаРасчета.ВсегоСтрок + 1;
	ВысотаСтроки	= ШаблонСтроки.Rows.Count; 

	Для н = 1 По БудетСтрок Цикл
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонСтроки, Ложь, Ложь, ВысотаСтроки); // вывожу через ExcelВывестиОбласть, т.к. через ExcelВставитьОбласть теряется объединение ячеек	
		РасходыПоДоговоруСоСпецдепозитарием.Вставить(ТаблицаДанных[н-1]["ВидЗадолженности"], СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "E"));	
	КонецЦикла;

	СтраницаРасчета.КлючевыеЯчейки.Вставить("РасходыПоДоговоруСоСпецдепозитарием", РасходыПоДоговоруСоСпецдепозитарием);
	
	КонечнаяСтрока = СтраницаРасчета.ВсегоСтрок;			

	ОбластьДанных = СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрока, "B", КонечнаяСтрока, "E"));
	ОбластьДанных.FormulaLocal = Новый COMSafeArray(МассивДанных, "VT_VARIANT");
	ОбластьДанных.Rows.Group();

	// Область итогов
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонИтогов, Ложь, Ложь); 

	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "E").FormulaLocal = "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрока, "E", КонечнаяСтрока, "E") + ")";

	СтраницаРасчета.КлючевыеЯчейки.Вставить("РасходыПоДоговоруСоСпецдепозитариемВВалютеРасчета", СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "E"));	
	
	СтраницаРасчета.ВсегоСтрок = СтраницаРасчета.ВсегоСтрок + 2;
	
	// Формируем описание области
	
	ВыведеннаяОбласть = Новый Структура;
	ВыведеннаяОбласть.Вставить("КолонкаСуммаВВалютеРасчета", "E");
	
	СтраницаРасчета.Области.Вставить(ИмяОбласти, ВыведеннаяОбласть); 	
	
	Возврат ВыведеннаяОбласть; 	
	
КонецФункции

&НаКлиенте
Функция ВывестиМесяцыУправления(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка)
	
	СтраницаРасчета			= Расшифровка.Результат.ПараметрыЛистов["Расчет"];
	ШаблонСтраницыРасчета	= Расшифровка.Шаблон.ПараметрыЛистов["Расчет"].Страница;
	
	// Ищем среди ранее выведенных областей
	
	ОбластьМесяцыУправления = СтраницаРасчета.Области.Получить("МесяцыУправления");
	Если ОбластьМесяцыУправления <> Неопределено Тогда
		Возврат ОбластьМесяцыУправления;
	КонецЕсли;
	
	// Область шапки
	
	ШаблонШапки		= ШаблонСтраницыРасчета.Range("ШапкаМесяцыУправления");	
	ШаблонСтроки	= ШаблонСтраницыРасчета.Range("СтрокаМесяцыУправления");	
	ШаблонИтогов	= ШаблонСтраницыРасчета.Range("ИтогМесяцыУправления");	

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонШапки);  	
	
	// Подготоваливаем данные

	ТаблицаДанных		= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_МесяцыУправления"];
	БудетСтрок			= ТаблицаДанных.Количество();
	БудетКолонок		= 3;
	МассивДанных		= Новый Массив(БудетКолонок, Макс(БудетСтрок, 1));
	
	Для НомерСтроки = 0 По БудетСтрок - 1 Цикл 
		МассивДанных[0][НомерСтроки] = ТаблицаДанных[НомерСтроки]["Месяц"];
		МассивДанных[1][НомерСтроки] = ТаблицаДанных[НомерСтроки]["НачалоУправления"];
		МассивДанных[2][НомерСтроки] = ТаблицаДанных[НомерСтроки]["ОкончаниеУправления"];
	КонецЦикла;	
	
	// Подготоваливаем строки и выводим данные

	НачальнаяСтрока	= СтраницаРасчета.ВсегоСтрок + 1;
	ВысотаСтроки	= ШаблонСтроки.Rows.Count; 

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонСтроки, Ложь, Ложь, ВысотаСтроки);  	

	Если БудетСтрок > 1 Тогда
		ОбластьЭталон = СтраницаРасчета.Страница.Range(Формат(НачальнаяСтрока, "ЧРД=,; ЧН=; ЧГ=") + ":" + Формат(НачальнаяСтрока, "ЧРД=,; ЧН=; ЧГ="));
		Для н = 2 По БудетСтрок Цикл
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelВставитьОбласть(СтраницаРасчета, ОбластьЭталон, , , , ВысотаСтроки, Ложь);		
		КонецЦикла;
	КонецЕсли;

	КонечнаяСтрока = СтраницаРасчета.ВсегоСтрок;			

	ОбластьДанных = СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрока, "B", КонечнаяСтрока, "D"));
	ОбластьДанных.FormulaLocal = Новый COMSafeArray(МассивДанных, "VT_VARIANT");
	ОбластьДанных.Rows.Group();
	
	// Заполняем формулы

	Если НачальнаяСтрока <> КонечнаяСтрока Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрока, "E", КонечнаяСтрока, "F")),
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(КонечнаяСтрока, "E", КонечнаяСтрока, "F")));	
	КонецЕсли;	
	
	// Область итогов
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонИтогов, Ложь, Ложь); 
	
	СтраницаРасчета.ВсегоСтрок = СтраницаРасчета.ВсегоСтрок + 1;
	
	// Формируем описание области
	
	ОбластьМесяцыУправления = Новый Структура;
	ОбластьМесяцыУправления.Вставить("НачальнаяСтрока",			НачальнаяСтрока);
	ОбластьМесяцыУправления.Вставить("КонечнаяСтрока",			КонечнаяСтрока);
	ОбластьМесяцыУправления.Вставить("КолонкаДнейВУправлении",	"E");
	ОбластьМесяцыУправления.Вставить("КолонкаДнейВМесяце",		"F");
	
	СтраницаРасчета.Области.Вставить("МесяцыУправления", ОбластьМесяцыУправления); 	
	
	Возврат ОбластьМесяцыУправления; 	
	
КонецФункции

&НаКлиенте
Процедура ВывестиКонтрольСуммыВознагражденияExcel(ДанныеРасшифровки, Расшифровка)
	
	СтраницаРасчета			= Расшифровка.Результат.ПараметрыЛистов["Расчет"];
	ШаблонСтраницыРасчета	= Расшифровка.Шаблон.ПараметрыЛистов["Расчет"].Страница;

	Если ДанныеРасшифровки.ВидДоговораДоверительногоУправления = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов") Тогда
		
		ШаблонТаблицы	= ШаблонСтраницыРасчета.Range("КонтрольСуммыВознаграждения");	
		ОбластьВставки	= РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонТаблицы, Ложь, Ложь);  	
		
		ЯчейкаНорматив			= РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(ОбластьВставки, "Норматив");
		ЯчейкаСЧАНаКонецРынок	= СтраницаРасчета.КлючевыеЯчейки["СЧАНаКонецРынок"];	
		ЯчейкаСЧАНаКонецБаланс	= СтраницаРасчета.КлючевыеЯчейки["СЧАНаКонецБаланс"];	
		ЯчейкаСЧАНаКонец		= ?(ЯчейкаСЧАНаКонецРынок = Неопределено, ЯчейкаСЧАНаКонецБаланс, ЯчейкаСЧАНаКонецРынок);
		
		// Сообщаем, если не удалось определить СЧА (не выведена или не ясно по балансу она или по рынку)
		
		Если ЯчейкаСЧАНаКонец = Неопределено Тогда
		    ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В расшифровке расчета отсутствуют данные о СЧА на конец периода. Контроль суммы вознаграждения '%1' не выполнен.", ДанныеРасшифровки.СчетДоверительногоУправления));
		ИначеЕсли ЯчейкаСЧАНаКонецРынок <> Неопределено И ЯчейкаСЧАНаКонецБаланс <> Неопределено Тогда	
		    ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Контроль суммы вознаграждения '%1' выполнен по рыночной СЧА.", ДанныеРасшифровки.СчетДоверительногоУправления));
		КонецЕсли;
		
		ЗначениеНорматива	= ?(ЯчейкаСЧАНаКонец = Неопределено, "=НД()", "=" + ЯчейкаСЧАНаКонец.Address(Ложь, Ложь) + " * 1%");
		ЗначениеПревышения	= СтрШаблон("=ЕСЛИ(%1>%2;%1-%2;0)", СтраницаРасчета.КлючевыеЯчейки["СуммарноеВознаграждение"].Address(Ложь, Ложь), ЯчейкаНорматив.Address(Ложь, Ложь));		
		
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ОписаниеНорматива",			"1% от СЧА на конец периода");
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "Норматив",					ЗначениеНорматива);
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ОписаниеПревышенияНорматива", "Превышение вознаграждения над 1% от СЧА");
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ПревышениеНорматива",			ЗначениеПревышения);
		
		СтраницаРасчета.ВсегоСтрок = СтраницаРасчета.ВсегоСтрок + 2;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиВознаграждениеУдержанноеРанееНаТитульнуюСтраницу(ТитульнаяСтраница, СтраницаРасчета, ШаблонПоказатель, ЯчейкаВознаграждениеУплаченноеСНачалаДоговора, ЯчейкаОграничениеОбщегоРазмераВознаграждения)
	
	ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонПоказатель);	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "Показатель",			"Вознаграждение управляющего, удержанное ранее");
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ЗначениеПоказателя",	"=" + СтраницаРасчета.КлючевыеЯчейки["ВознаграждениеУплаченноеВВалютеУчета"].Address(Ложь, Ложь, , Истина));
	
	Если ЯчейкаВознаграждениеУплаченноеСНачалаДоговора <> Неопределено Тогда 
		ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонПоказатель);	
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "Показатель",			"Вознаграждение управляющего, удержанное с начала действия договора");
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ЗначениеПоказателя",	"=" + ЯчейкаВознаграждениеУплаченноеСНачалаДоговора.Address(Ложь, Ложь, , Истина));
	КонецЕсли;
	
	Если ЯчейкаОграничениеОбщегоРазмераВознаграждения <> Неопределено Тогда 
		ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонПоказатель);	
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "Показатель",			"Ограничение общего размера вознаграждения с начала действия договора");
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ЗначениеПоказателя",	"=" + ЯчейкаОграничениеОбщегоРазмераВознаграждения.Address(Ложь, Ложь, , Истина));
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Функция ВывестиТелоТитульнойСтраницыExcel(ДанныеРасшифровки, Расшифровка)
	
	ТитульнаяСтраница		= Расшифровка.Результат.ПараметрыЛистов["Титульная страница"];
	ШаблонТитульнойСтраницы	= Расшифровка.Шаблон.ПараметрыЛистов["Титульная страница"];
	
	ОбластьТело = ТитульнаяСтраница.Области.Получить("Тело");
	
	Если ОбластьТело = Неопределено Тогда
		
		ШаблонОбласти	= ПолучитьИменованныйДиапазонExcel(ШаблонТитульнойСтраницы, "Тело" + ДанныеРасшифровки.ШаблонРасшифровки);
		ОбластьТело		= РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонОбласти);
		
		ТитульнаяСтраница.Области.Вставить("Тело", ОбластьТело);
		
	КонецЕсли;	
	
	Возврат ОбластьТело;
	
КонецФункции

&НаКлиенте
Функция ВывестиДвиженияАктивовНаТитульнуюСтраницу(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка, ОбластьДвиженияАктивов)
	
	ТитульнаяСтраница			= Расшифровка.Результат.ПараметрыЛистов["Титульная страница"];
	СтраницаРасчета				= Расшифровка.Результат.ПараметрыЛистов["Расчет"];
	ШаблонТитульнойСтраницы		= Расшифровка.Шаблон.ПараметрыЛистов["Титульная страница"];
	ОбщиеПараметрыЗаполнения	= ДанныеРасшифровки.ОбщиеПараметрыЗаполнения;
	
	ОбластьРезультат = ТитульнаяСтраница.Области.Получить("ДвиженияАктивов" + ДанныеРасшифровки.ШаблонРасшифровки);
	
	Если ОбластьРезультат = Неопределено Тогда
		
		НачальнаяСтрокаОбласти = ТитульнаяСтраница.ВсегоСтрок;
		
		Если ДанныеРасшифровки.ШаблонРасшифровки = "2023"
			Или ДанныеРасшифровки.ШаблонРасшифровки = "2024"
		Тогда
			#Область Стандартный_2023_2024
			
			ШаблонШапки = ПолучитьИменованныйДиапазонExcelПоГодовомуШаблону(
				ШаблонТитульнойСтраницы, "ШапкаВводВыводАктивов<Год>", ДанныеРасшифровки.ШаблонРасшифровки);
			
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонШапки, Ложь, Ложь);
			
			ШаблонСтрокаРасшифровки = ПолучитьИменованныйДиапазонExcelПоГодовомуШаблону(
				ШаблонТитульнойСтраницы, "СтрокаВводВыводАктивов<Год>", ДанныеРасшифровки.ШаблонРасшифровки);
			
			ВсегоВводов = РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета[
				"_ВводыАктивовСНачалаГодаРазвернуто" + ?(ОбластьДвиженияАктивов.СуффиксПоказателей = "Рынок", "", ОбластьДвиженияАктивов.СуффиксПоказателей)].Количество();
			ВсегоВыводов	= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_ВыводыАктивовСНачалаГодаРазвернуто"].Количество();
			ВсегоДвижений	= Макс(ВсегоВводов, ВсегоВыводов);
			НомерДвижения	= 1;
			
			Пока НомерДвижения <= ВсегоДвижений Цикл
				
				ТекущаяСтрокаДвиженияАктивов = ОбластьДвиженияАктивов.НачальнаяСтрока + ОбластьДвиженияАктивов.ВысотаСтроки * (НомерДвижения - 1);
				
				Если НомерДвижения <= ВсегоВводов Тогда
					ДатаВвода	= "=" + СтраницаРасчета.Страница.Cells(ТекущаяСтрокаДвиженияАктивов, ОбластьДвиженияАктивов.КолонкаДатаВвода).Address(Ложь, Ложь, , Истина);
					СуммаВвода	= "=" + СтраницаРасчета.Страница.Cells(ТекущаяСтрокаДвиженияАктивов, ОбластьДвиженияАктивов.КолонкаСуммаВвода).Address(Ложь, Ложь, , Истина);
					ДнейДоВвода	= "=" + СтраницаРасчета.Страница.Cells(ТекущаяСтрокаДвиженияАктивов, ОбластьДвиженияАктивов.КолонкаДнейДоВвода).Address(Ложь, Ложь, , Истина);
				Иначе
					ДатаВвода	= "";
					СуммаВвода	= "";
					ДнейДоВвода	= "";
				КонецЕсли;
				
				ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонСтрокаРасшифровки, Ложь, Ложь);	
				
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ДатаВвода", ДатаВвода);
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "СуммаВвода", СуммаВвода);
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ДнейДоВвода", ДнейДоВвода);
				
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ДатаВывода",
					"=" + СтраницаРасчета.Страница.Cells(ТекущаяСтрокаДвиженияАктивов, ОбластьДвиженияАктивов.КолонкаДатаВывода).Address(Ложь, Ложь, , Истина));
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "СуммаВывода",
					"=" + СтраницаРасчета.Страница.Cells(ТекущаяСтрокаДвиженияАктивов, ОбластьДвиженияАктивов.КолонкаСуммаВывода).Address(Ложь, Ложь, , Истина));
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ДнейДоВывода",
					"=" + СтраницаРасчета.Страница.Cells(ТекущаяСтрокаДвиженияАктивов, ОбластьДвиженияАктивов.КолонкаДнейДоВывода).Address(Ложь, Ложь, , Истина));
				
				НомерДвижения = НомерДвижения + 1;
				
			КонецЦикла;
			
			ШаблонОбласти = ПолучитьИменованныйДиапазонExcelПоГодовомуШаблону(ШаблонТитульнойСтраницы, "ПодвалВводВыводАктивов<Год>", ДанныеРасшифровки.ШаблонРасшифровки);
			
			ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонОбласти, Ложь, Ложь);
			
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "СуммаВвода",
				"=" + СтраницаРасчета.КлючевыеЯчейки["СуммаВводов" + ОбластьДвиженияАктивов.СуффиксПоказателей].Address(Ложь, Ложь, , Истина));
			
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "СуммаВывода",
				"=" + СтраницаРасчета.КлючевыеЯчейки["СуммаВыводов" + ОбластьДвиженияАктивов.СуффиксПоказателей].Address(Ложь, Ложь, , Истина));
			
			#КонецОбласти
		ИначеЕсли ДанныеРасшифровки.ШаблонРасшифровки = "ППА" Тогда
			#Область ППА
			
			// Вводы
			ШаблонШапки = ПолучитьИменованныйДиапазонExcel(ШаблонТитульнойСтраницы, "ШапкаВводАктивов" + ДанныеРасшифровки.ШаблонРасшифровки);
			ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонШапки, Ложь, Ложь);
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ВидСредствДУ #ПД=Родительный", ОбщиеПараметрыЗаполнения.ВидСредствДУ_РП, Истина);
			
			ШаблонСтрокаРасшифровки = ПолучитьИменованныйДиапазонExcel(ШаблонТитульнойСтраницы, "СтрокаВводАктивов" + ДанныеРасшифровки.ШаблонРасшифровки);
			ВводыАктивов			= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_ВводыАктивовСНачалаГодаРазвернуто" + ?(ОбластьДвиженияАктивов.СуффиксПоказателей = "Рынок", "", ОбластьДвиженияАктивов.СуффиксПоказателей)];
			ВсегоВводов				= ВводыАктивов.Количество();
			
			Для НомерДвижения = 1 По ВсегоВводов Цикл
				
				ОбластьВставки				 = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонСтрокаРасшифровки, Ложь, Ложь);	
				ТекущаяСтрокаДвиженияАктивов = ОбластьДвиженияАктивов.НачальнаяСтрока + ОбластьДвиженияАктивов.ВысотаСтроки * (НомерДвижения - 1);
				
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "НомерСтроки", НомерДвижения);
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ДатаВвода",	Формат(ВводыАктивов[НомерДвижения-1]["ДатаПлатежногоДокумента"], "ДФ=dd.MM.yyyy"));
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "НомерВвода",	ВводыАктивов[НомерДвижения-1]["НомерПлатежногоДокумента"]);
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "СуммаВвода",
					"=" + СтраницаРасчета.Страница.Cells(ТекущаяСтрокаДвиженияАктивов, ОбластьДвиженияАктивов.КолонкаСуммаВвода).Address(Ложь, Ложь, , Истина));
				
			КонецЦикла;
			
			ШаблонОбласти	= ПолучитьИменованныйДиапазонExcel(ШаблонТитульнойСтраницы, "ПодвалВводАктивов" + ДанныеРасшифровки.ШаблонРасшифровки);
			ОбластьВставки	= РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонОбласти, Ложь, Ложь);
			
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "СуммаВвода",
				"=" + СтраницаРасчета.КлючевыеЯчейки["СуммаВводов" + ОбластьДвиженияАктивов.СуффиксПоказателей].Address(Ложь, Ложь, , Истина));
			
			// Выводы
			
			ШаблонШапки = ПолучитьИменованныйДиапазонExcel(ШаблонТитульнойСтраницы, "ШапкаВыводАктивов" + ДанныеРасшифровки.ШаблонРасшифровки);
			ОбластьВставки	= РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонШапки, Ложь, Ложь);	
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ВидСредствДУ #ПД=Родительный", ОбщиеПараметрыЗаполнения.ВидСредствДУ_РП, Истина);	
			
			ШаблонСтрокаРасшифровки = ПолучитьИменованныйДиапазонExcel(ШаблонТитульнойСтраницы, "СтрокаВыводАктивов" + ДанныеРасшифровки.ШаблонРасшифровки);
			ВыводыАктивов			= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_ВыводыАктивовСНачалаГодаРазвернуто"];
			ВсегоВыводов			= ВыводыАктивов.Количество();
			НачальнаяСтрокаВыводов	= ТитульнаяСтраница.ВсегоСтрок + 1;
			
			Для НомерДвижения = 1 По ВсегоВыводов Цикл
				
				ОбластьВставки				 = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонСтрокаРасшифровки, Ложь, Ложь);
				ТекущаяСтрокаДвиженияАктивов = ОбластьДвиженияАктивов.НачальнаяСтрока + ОбластьДвиженияАктивов.ВысотаСтроки * (НомерДвижения - 1);
				
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "НомерСтроки",	НомерДвижения);
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ДатаВывода",	Формат(ВыводыАктивов[НомерДвижения-1]["ДатаПлатежногоДокумента"], "ДФ=dd.MM.yyyy"));
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "НомерВывода",	ВыводыАктивов[НомерДвижения-1]["НомерПлатежногоДокумента"]);
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ЦелиВывода",	ВыводыАктивов[НомерДвижения-1]["НазначениеПлатежа"]);
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "СуммаВывода",
					"=" + СтраницаРасчета.Страница.Cells(ТекущаяСтрокаДвиженияАктивов, ОбластьДвиженияАктивов.КолонкаСуммаВывода).Address(Ложь, Ложь, , Истина));

			КонецЦикла;
			
			// Подберем высоту строк области, чтобы все цели вывода поместились
			
			Если ВсегоВыводов > 0 Тогда
				
				ОбластьВыводов = ТитульнаяСтраница.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаВыводов, "", ТитульнаяСтраница.ВсегоСтрок, ""));
				
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelАвтоподборВысотыСтрокОбласти(ОбластьВыводов);
					
			КонецЕсли;
			
			ШаблонОбласти	= ПолучитьИменованныйДиапазонExcel(ШаблонТитульнойСтраницы, "ПодвалВыводАктивов" + ДанныеРасшифровки.ШаблонРасшифровки);
			ОбластьВставки	= РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонОбласти, Ложь, Ложь);
			
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "СуммаВывода",
				"=" + СтраницаРасчета.КлючевыеЯчейки["СуммаВыводов" + ОбластьДвиженияАктивов.СуффиксПоказателей].Address(Ложь, Ложь, , Истина));

			#КонецОбласти
			
		Иначе
			
			Возврат Неопределено;
			
		КонецЕсли;
		
		ОбластьРезультат = СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(
			НачальнаяСтрокаОбласти, "", ТитульнаяСтраница.ВсегоСтрок, ""));
		
		ТитульнаяСтраница.Области.Вставить("ДвиженияАктивов" + ДанныеРасшифровки.ШаблонРасшифровки, ОбластьРезультат);
		
	КонецЕсли;	
	
	Возврат ОбластьРезультат;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьЯчейкуРасчетаВознаграждения(Страница, Показатель, Область, НачисляетсяНарастающимИтогом, ВознаграждениеЗаУправление, ВключатьВИтоговуюСумму = Истина, ВыводитьНаТитульнойСтранице = Истина)
	
	Страница.КлючевыеЯчейки["РасчетВознаграждения"].Добавить(
		Новый Структура("Показатель, Область, НачисляетсяНарастающимИтогом, ВознаграждениеЗаУправление, ВключатьВИтоговуюСумму, ВыводитьНаТитульнойСтранице",
			Показатель, Область, НачисляетсяНарастающимИтогом, ВознаграждениеЗаУправление, ВключатьВИтоговуюСумму, ВыводитьНаТитульнойСтранице));
	
КонецПроцедуры

&НаКлиенте
Функция ПредставленияСуммыДляПечати(Сумма, ОтображатьНулевуюСуммуКакОшибку = Ложь)
	
	ПредставленияСуммы = Новый Структура("Сумма, СуммаРублей, СуммаПрописьюРублей, СуммаПрописьюБезКопеек", "###", "###", "###", "###");	
	
	Если Сумма = NULL Или Сумма = 0 И ОтображатьНулевуюСуммуКакОшибку Тогда
		Возврат ПредставленияСуммы;
	КонецЕсли;
	
	ПредставленияСуммы.Сумма					= Формат(Сумма, "ЧДЦ=2");
	ПредставленияСуммы.СуммаПрописьюРублей		= ЧислоПрописью(Сумма, "Л=ru_RU; ДП=Ложь", "рубль, рубля, рублей, м, копейка, копейки, копеек, ж");
	ПредставленияСуммы.СуммаПрописьюБезКопеек	= ЧислоПрописью(Цел(Сумма), "Л=ru_RU; НП=Ложь", ",,,,,,,,0");
	ПредставленияСуммы.СуммаРублей				= СтрЗаменить(ПредставленияСуммы.СуммаПрописьюРублей, ПредставленияСуммы.СуммаПрописьюБезКопеек, Формат(Цел(Сумма), "ЧН="));
	
	Возврат ПредставленияСуммы;

КонецФункции

&НаКлиенте
Процедура УстановитьЗначенияПараметровАкта(ОбластьАкта, ДанныеРасшифровки, ДанныеОбОрганизации, ОбщиеПараметрыЗаполнения, ПредставлениеСуммыВознаграждения)  
	
	ПараметрыАкта = ПараметрыОбластиExcel(ОбластьАкта);
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "КраткоеНаименованиеУК",			ДанныеОбОрганизации.КраткоеНаименованиеОрганизации, Истина);
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "УчредительУправления",			ДанныеРасшифровки.УчредительУправления, Истина);
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "КраткоеНаименованиеУчредителя",	ДанныеРасшифровки.КраткоеНаименованиеУчредителяУправления, Истина);
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ДоговорДУ",						ОбщиеПараметрыЗаполнения.ДоговорДУ, Истина);
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "НомерДоговораДУ",				ОбщиеПараметрыЗаполнения.НомерДоговораДУ, Истина);
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ДатаДоговораДУ",					ОбщиеПараметрыЗаполнения.ДатаДоговораДУ, Истина);
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ДатаРасчета",								Формат(Объект.ДатаРасчета, "ДФ='«dd» MMMM yyyy ''г.'''"));  
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПериодРасчета",								"с " + ОбщиеПараметрыЗаполнения.НачалоБазовогоПериодаСтрокой + " по " + ОбщиеПараметрыЗаполнения.КонецБазовогоПериодаСтрокой, Истина);
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ГодПериодаРасчета",							Формат(ДанныеРасшифровки.КонецРасчетногоПериода, "ДФ=yyyy"), Истина);
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ФинансовыйПериодРасчета",					ОбщиеПараметрыЗаполнения.ПредставлениеФинансовогоПериода, Истина);
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "НачалоБазовогоПериода #ДФ='dd MMMM yyyy'",	ОбщиеПараметрыЗаполнения.НачалоБазовогоПериода_ddMMMMyyyy, Истина);
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "КонецБазовогоПериода #ДФ='dd MMMM yyyy'",	ОбщиеПараметрыЗаполнения.КонецБазовогоПериода_ddMMMMyyyy, Истина);
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантОтУК",					Строка(ЭтаФорма.Подписант), Истина);
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантОтУКДолжность",			ЭтаФорма.ПодписантДолжность, Истина);
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантОтУчредителя",			ОбщиеПараметрыЗаполнения.ПодписантОтУчредителя, Истина);
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантОтУчредителяДолжность",	ОбщиеПараметрыЗаполнения.ПодписантОтУчредителяДолжность, Истина);
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "Сумма",							ПредставлениеСуммыВознаграждения.Сумма, Истина);
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "СуммаРублей",					ПредставлениеСуммыВознаграждения.СуммаРублей, Истина);
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "СуммаПрописьюРублей",			ПредставлениеСуммыВознаграждения.СуммаПрописьюРублей, Истина);
	
	Если СтрНачинаетсяС(ДанныеРасшифровки.ШаблонАкта, "ХантыМансийский")
		Или СтрНачинаетсяС(ДанныеРасшифровки.ШаблонАкта, "ЦКМГПУ")
		Или СтрНачинаетсяС(ДанныеРасшифровки.ШаблонАкта, "Сургутнефтегаз") Тогда

		ПодписантОтУКПолноеФИО						= ПодменитьПустуюСтроку(ОбщиеПараметрыЗаполнения.ПодписантОтУКПолноеФИО, Строка(ЭтаФорма.Подписант));
		ПодписантОтУКПолноеФИО_РП					= ОбщиеПараметрыЗаполнения.ПодписантОтУКПолноеФИО_РП;
		ПодписантОтУКДолжность_РП					= ОбщиеПараметрыЗаполнения.ПодписантОтУКДолжность_РП;
		ПодписантОтУКОснованиеПолномочий_РП			= ОбщиеПараметрыЗаполнения.ПодписантОснованиеПолномочий_РП;
		ПодписантОтУчредителяПолноеФИО				= ПодменитьПустуюСтроку(ОбщиеПараметрыЗаполнения.ПодписантОтУчредителяПолноеФИО, ОбщиеПараметрыЗаполнения.ПодписантОтУчредителя);
		ПодписантОтУчредителяПолноеФИО_РП			= ОбщиеПараметрыЗаполнения.ПодписантОтУчредителяПолноеФИО_РП;
		ПодписантОтУчредителяДолжность_РП			= ОбщиеПараметрыЗаполнения.ПодписантОтУчредителяДолжность_РП;
		ПодписантОтУчредителяОснованиеПолномочий_РП	= ОбщиеПараметрыЗаполнения.ПодписантОтУчредителяОснованиеПолномочий_РП;
		
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантБухгалтерОтУК",									  ПодменитьПустуюСтроку(Строка(ЭтаФорма.ПодписантБухгалтер),		"________________"), Истина);
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантБухгалтерОтУКДолжность",						  ПодменитьПустуюСтроку(ЭтаФорма.ПодписантБухгалтерДолжность,		"Главный бухгалтер"), Истина);
		
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантОтУКПолноеФИО",									  ПодменитьПустуюСтроку(ПодписантОтУКПолноеФИО,						"______________________________________"), Истина);
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантОтУКПолноеФИО #ПД=Родительный",					  ПодменитьПустуюСтроку(ПодписантОтУКПолноеФИО_РП,					"______________________________________"), Истина);
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантОтУКДолжность #ПД=Родительный",					  ПодменитьПустуюСтроку(ПодписантОтУКДолжность_РП,					"______________________________________"), Истина);
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантОтУКОснованиеПолномочий #ПД=Родительный",		  ПодменитьПустуюСтроку(ПодписантОтУКОснованиеПолномочий_РП,		"______________________________________"), Истина);
		
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантОтУчредителяПолноеФИО",					  		  ПодменитьПустуюСтроку(ПодписантОтУчредителяПолноеФИО,				"______________________________________"), Истина);
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантОтУчредителяПолноеФИО #ПД=Родительный",			  ПодменитьПустуюСтроку(ПодписантОтУчредителяПолноеФИО_РП,			"______________________________________"), Истина);
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантОтУчредителяДолжность #ПД=Родительный",			  ПодменитьПустуюСтроку(ПодписантОтУчредителяДолжность_РП,			"______________________________________"), Истина);
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантОтУчредителяОснованиеПолномочий #ПД=Родительный", ПодменитьПустуюСтроку(ПодписантОтУчредителяОснованиеПолномочий_РП,"______________________________________"), Истина);
		
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПолноеНаименованиеУчредителяУправления",					  ДанныеРасшифровки.ПолноеНаименованиеУчредителяУправления, Истина);
		
		Если ОбщиеПараметрыЗаполнения.АвтоформированиеОснованияПолномочийПодписанта_РП И ПараметрыАкта["ПодписантОтУКОснованиеПолномочий #ПД=Родительный"] <> Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Проверьте корректность основания полномочий подписанта УК в родительном падеже: %1", ОбщиеПараметрыЗаполнения.ПодписантОснованиеПолномочий_РП));
		КонецЕсли;
		
		Если ОбщиеПараметрыЗаполнения.АвтоформированиеПолногоФИОПодписантаУК_РП И ПараметрыАкта["ПодписантОтУКПолноеФИО #ПД=Родительный"] <> Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Проверьте корректность полного ФИО подписанта УК в родительном падеже: %1", ОбщиеПараметрыЗаполнения.ПодписантОтУКПолноеФИО_РП));
		КонецЕсли;
		
		Если ОбщиеПараметрыЗаполнения.АвтоформированиеДолжностиПодписантаУК_РП И ПараметрыАкта["ПодписантОтУКДолжность #ПД=Родительный"] <> Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Проверьте корректность должности подписанта УК в родительном падеже: %1", ОбщиеПараметрыЗаполнения.ПодписантОтУКДолжность_РП));
		КонецЕсли;
		
	ИначеЕсли СтрНачинаетсяС(ДанныеРасшифровки.ШаблонАкта, "Будущее2023") Тогда	  
		
		ПодписантОтУКДолжность_РП					= ОбщиеПараметрыЗаполнения.ПодписантОтУКДолжность_РП;
		ПодписантОтУКПолноеФИО_РП					= ОбщиеПараметрыЗаполнения.ПодписантОтУКПолноеФИО_РП;   
		ПодписантОснованиеПолномочий_РП				= ОбщиеПараметрыЗаполнения.ПодписантОснованиеПолномочий_РП;
		ПодписантОтУчредителяПолноеФИО_РП			= ОбщиеПараметрыЗаполнения.ПодписантОтУчредителяПолноеФИО_РП;  
		ПодписантОтУчредителяОснованиеПолномочий_РП	= ОбщиеПараметрыЗаполнения.ПодписантОтУчредителяОснованиеПолномочий_РП;
		ПодписантОтУчредителяДолжность_РП			= ОбщиеПараметрыЗаполнения.ПодписантОтУчредителяДолжность_РП;

		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантОтУКДолжность_РП", 								ПодменитьПустуюСтроку(ПодписантОтУКДолжность_РП, 					"______________________________________"), Истина); 
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантОтУКПолноеФИО_РП", 								ПодменитьПустуюСтроку(ПодписантОтУКПолноеФИО_РП, 					"______________________________________"), Истина); 
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантОснованиеПолномочий_РП", 						ПодменитьПустуюСтроку(ПодписантОснованиеПолномочий_РП, 				"______________________________________"), Истина); 
		
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантОтУчредителяПолноеФИО_РП", 						ПодменитьПустуюСтроку(ПодписантОтУчредителяПолноеФИО_РП, 			"______________________________________"), Истина); 
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантОтУчредителяОснованиеПолномочий_РП",			ПодменитьПустуюСтроку(ПодписантОтУчредителяОснованиеПолномочий_РП, 	"______________________________________"), Истина); 
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьАкта, "ПодписантОтУчредителяДолжность_РП", 						ПодменитьПустуюСтроку(ПодписантОтУчредителяДолжность_РП, 			"______________________________________"), Истина); 
		
	КонецЕсли;
	
КонецПроцедуры

