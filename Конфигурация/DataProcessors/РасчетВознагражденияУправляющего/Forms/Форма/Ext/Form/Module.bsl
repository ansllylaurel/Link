			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "I", КонечнаяСтрокаДвиженияАктивов, "K")),
