#КонецОбласти

#Область Начисление_задолженности_по_вознаграждению

&НаСервере
Процедура СоздатьНачисленияНаСервере(ДанныеДляСтатистики)
	
	ВремяНачала = ТекущаяДатаСеанса();
	ДанныеДляСтатистики.Вставить("СоздатьНачисленияНаСервере", "Старт в: " + Формат(ВремяНачала, "ДЛФ=T") + "."); 
	
	// Сначала проверим даты запрета редактирования
	МассивСчетовДУ = Новый Массив;
	СтрокиДляОбработки = ВознагражденияУправляющего.НайтиСтроки(Новый Структура("Флажок", Истина));
	Для Каждого СтрокаДляОбработки из СтрокиДляОбработки Цикл
		МассивСчетовДУ.Добавить(СтрокаДляОбработки.СчетДоверительногоУправления);
	КонецЦикла;
	
	Если МассивСчетовДУ.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не отмечены строки для формирования начислений задолженности");
		Возврат;
	КонецЕсли;
	
	ДанныеДляСтатистики.СоздатьНачисленияНаСервере = ДанныеДляСтатистики.СоздатьНачисленияНаСервере + " Отбор по счету ДУ: " + РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(МассивСчетовДУ, ",");
	
	Если ЕстьЗапретРедактированияДанных(МассивСчетовДУ, Объект.Организация, Объект.ДатаРасчета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Начисления задолженности не сформированы");
		ДанныеДляСтатистики.СоздатьНачисленияНаСервере = ДанныеДляСтатистики.СоздатьНачисленияНаСервере + Символы.ПС + "Время выполнения метода: " + РассчитатьВремя(ВремяНачала);
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаВознагражденияУправляющего Из ВознагражденияУправляющего Цикл
		
		Если Не СтрокаВознагражденияУправляющего.Флажок Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаВознагражденияУправляющего.ОшибкаРасчета Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При расчете вознаграждения '" + Строка(СтрокаВознагражденияУправляющего.СчетДоверительногоУправления) + "' произошла ошибка. Начисление задолженности выполнено не будет");	
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаВознагражденияУправляющего.Начисление) Тогда
			
			Начисление = СтрокаВознагражденияУправляющего.Начисление.ПолучитьОбъект();
			Начисление.Основания.Очистить();
			
		Иначе
			
			Начисление = Документы.НачислениеЗадолженности.СоздатьДокумент();
			Начисление.Дата                         = РаботаСДокументами.ПолучитьВремяДокумента(Объект.ДатаРасчета, Начисление.Ссылка);
			Начисление.Организация                  = Объект.Организация;
			Начисление.СчетДоверительногоУправления = СтрокаВознагражденияУправляющего.СчетДоверительногоУправления;
			Начисление.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего;
			Начисление.Контрагент                   = Объект.Организация.ЮрФизЛицо;
			Начисление.РасчетныйСчет				= РасчетныйСчетИзИсполнителейПоДенежнымСредствам(Объект.Организация, СтрокаВознагражденияУправляющего.СчетДоверительногоУправления, Объект.ДатаРасчета);
			Начисление.РасчетныйСчетКонтрагента     = Объект.РасчетныйСчет;
			Начисление.МестоХранения                = Справочники.МестаХранения.ВнебиржевойРынок;
			Начисление.Валюта                       = Объект.Организация.ВалютаУчета;
			Начисление.ВидВходящегоДокумента        = Перечисления.ВидыВходящихДокументов.Акт;
			Начисление.НомерВходящегоДокумента      = "б\н";
			Начисление.ДатаВходящегоДокумента       = Объект.ДатаРасчета;
			Начисление.Ответственный                = РаботаСПользователями.ТекущийПользователь();
			Начисление.ДатаПолученияДокумента		= Начисление.Дата;
			
			Если Объект.ВариантРасчета = 2 Тогда
				Начисление.Вознаграждение = Истина;
			КонецЕсли;
			
			Начисление.НачалоПериодаНачисления		= СтрокаВознагражденияУправляющего.ПериодНачисления.ДатаНачала;
			Начисление.ОкончаниеПериодаНачисления	= СтрокаВознагражденияУправляющего.ПериодНачисления.ДатаОкончания;
			
			Начисление.ПрочиеДоходыИРасходы                  = Объект.ПрочиеДоходыИРасходы;
			Начисление.ГруппаФинансовогоУчетаДоходовРасходов = БухгалтерскийУчет.ОпределитьГруппуФинансовогоУчетаПоПрочимДоходамРасходам(
				Объект.ДатаРасчета, Объект.Организация, СтрокаВознагражденияУправляющего.СчетДоверительногоУправления, Начисление.ВидЗадолженности, Начисление.ПрочиеДоходыИРасходы);
			
		КонецЕсли;
		
		ПерваяСтрокаОснования = Начисление.Основания.Добавить();
		ПерваяСтрокаОснования.Сумма = СтрокаВознагражденияУправляющего.СуммаВознаграждения;
		ПерваяСтрокаОснования.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
		
		Если Не Начисление.ПроверитьЗаполнение() Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка 
			Начисление.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	
	ДанныеДляСтатистики.СоздатьНачисленияНаСервере = ДанныеДляСтатистики.СоздатьНачисленияНаСервере + Символы.ПС + "Время выполнения метода: " + РассчитатьВремя(ВремяНачала);
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция РасчетныйСчетИзИсполнителейПоДенежнымСредствам(Организация, СчетДоверительногоУправления, Дата) 
	
	Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет КАК РасчетныйСчет			
			|ИЗ
			|	РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
			|ГДЕ
			|	ИсполнителиПоДенежнымСредствамСобственные.Организация = &Организация
			|	И ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И (ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия >= &Дата
			|			ИЛИ ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))");
		
	Запрос.УстановитьПараметр("Дата",							Дата);
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.РасчетныйСчет, Справочники.БанковскиеСчета.ПустаяСсылка());
	
КонецФункции		

&НаСервереБезКонтекста
Функция ЕстьЗапретРедактированияДанных(МассивСчетовДУ, Организация, ДатаПроверки)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДатыЗапретаРедактирования.СчетДоверительногоУправления КАК СчетДУ,
	|	ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования
	|ИЗ
	|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
	|ГДЕ
	|	ДатыЗапретаРедактирования.Организация = &Организация
	|	И ДатыЗапретаРедактирования.СчетДоверительногоУправления В(&МассивСчетовДУ)
	|	И ДатыЗапретаРедактирования.ГруппаЗапрета = &ГруппаЗапрета
	|	И ДатыЗапретаРедактирования.ДатаЗапретаРедактирования >= &Период";
	
	Запрос.УстановитьПараметр("Период",			ДатаПроверки);
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("МассивСчетовДУ",	МассивСчетовДУ);
	Запрос.УстановитьПараметр("ГруппаЗапрета",	Перечисления.ГруппыЗапретаРедактирования.БэкОфис);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Отказ = Ложь;
	
	Пока Выборка.Следующий() Цикл
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для счета ДУ " + СокрЛП(Выборка.СчетДУ) + " запрещено редактирование данных. Дата запрета редактирования " + Формат(Выборка.ДатаЗапретаРедактирования, "ДФ=dd.MM.yyyy"), Выборка.СчетДУ,,, Отказ);
			
	КонецЦикла;	
	
	Возврат Отказ;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЗаполняемыеРеквизитыНачисленияПоУмолчанию(Организация)
	
	РеквизитыНачисления = Новый Структура("РасчетныйСчет, ПрочиеДоходыИРасходы");
	
	// ПрочиеДоходыИРасходы
	РеквизитыНачисления.ПрочиеДоходыИРасходы =
			Справочники.ПрочиеДоходыИРасходы.НайтиПоНаименованию("Общие расходы по вознаграждению управляющего");
			
	// РасчетныйСчет
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БанковскиеСчета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|ГДЕ
		|	БанковскиеСчета.Организация = &Организация
		|	И БанковскиеСчета.ЮрФизЛицо = ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).ЮрФизЛицо
		|	И БанковскиеСчета.НомерСчета = &НомерСчета";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НомерСчета",  "40701810600001454785");
			
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		РеквизитыНачисления.РасчетныйСчет = Выборка.Ссылка;
	Иначе
		РеквизитыНачисления.РасчетныйСчет = Справочники.БанковскиеСчета.ПустаяСсылка();
	КонецЕсли;
	
	Возврат РеквизитыНачисления;
	
КонецФункции

&НаСервере
Процедура СоздатьНачисленияИОбновитьДанныеНаСервере()
		
	ПараметрыСессииСбораСтатистики = ЗарегистрироватьНовуюСессиюНаСервере("СоздатьНачисленияИОбновитьДанныеНаСервере");
		
	СоздатьНачисленияНаСервере(ПараметрыСессииСбораСтатистики.ДанныеДляСтатистики);
	
	ОбновитьНаСервере(ПараметрыСессииСбораСтатистики.ДанныеДляСтатистики);
		
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессииСбораСтатистики);
		
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаКлиенте
Процедура ИзменитьСостояниеФлажковВознагражденияУправляющего(НовоеСостояние, ИмяРеквизитаФормы, Период = Неопределено)
	
	Для каждого СтрокаВознагражденияУправляющего Из ЭтаФорма[ИмяРеквизитаФормы] Цикл
		Если Период = Неопределено Тогда
			СтрокаВознагражденияУправляющего.Флажок = НовоеСостояние;
		ИначеЕсли СтрокаВознагражденияУправляющего.Период >= Период.ДатаНачала И СтрокаВознагражденияУправляющего.Период <= Период.ДатаОкончания Тогда
			СтрокаВознагражденияУправляющего.Флажок = НовоеСостояние;
		Иначе
			СтрокаВознагражденияУправляющего.Флажок = Не НовоеСостояние;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(ЭтаФорма)
	// ВариантРасчета:
	//	0 - ИИС
	//	1 - Вознаграждения агента
	//	2 - ПИФ
	//	3 - НПФ, НПФ СС, ДУ юр./физ. лиц и прочие
	Объект		= ЭтаФорма.Объект;
	Элементы	= ЭтаФорма.Элементы;
	
	Элементы.СтраницаВознаграждениеУправляющего.Видимость							= (Объект.ВариантРасчета = 0 Или Объект.ВариантРасчета = 2 Или Объект.ВариантРасчета = 3);
	Элементы.СтраницаВознаграждениеАгента.Видимость 								= (Объект.ВариантРасчета = 1);
	Элементы.СтраницаВознаграждениеУправляющегоПлатаЗаРазмещение.Видимость			= (Объект.ВариантРасчета = 0);
	Элементы.СтраницаРасшифровкаРасчета.Видимость									= Не (Объект.ВариантРасчета = 2 Или Объект.ВариантРасчета = 3);
	
	Элементы.АгентскийДоговор.Видимость 											= (Объект.ВариантРасчета = 1);
	Элементы.ВидВознаграждения.Видимость 											= (Объект.ВариантРасчета = 3);
	Элементы.ПериодичностьРасчета.Видимость											= (Объект.ВариантРасчета = 3);
	Элементы.БазовыйПериод.Видимость												= (Объект.ВариантРасчета = 0 Или Объект.ВариантРасчета = 3);
	
	Элементы.ВознагражденияУправляющегоСтратегия.Видимость							= Не (Объект.ВариантРасчета = 2 Или Объект.ВариантРасчета = 3);
	Элементы.ВознагражденияУправляющегоОписание.Видимость							= (Объект.ВариантРасчета = 2 Или Объект.ВариантРасчета = 3);
	Элементы.ВознагражденияУправляющегоСтавка.Видимость								= Не (Объект.ВариантРасчета = 2 Или Объект.ВариантРасчета = 3);
	
	Элементы.ВознагражденияУправляющегоГруппаПечать.Видимость						= Не (Объект.ВариантРасчета = 3);
	Элементы.ВознагражденияУправляющегоКомандаПечатьРасчетаВознаграждения.Видимость	= (Объект.ВариантРасчета = 3);
	Элементы.КонтекстноеМенюКомандаПечатьРасчетаВознаграждения.Видимость			= (Объект.ВариантРасчета = 3);
	Элементы.ВознагражденияУправляющегоГруппаПодписант.Видимость					= (Объект.ВариантРасчета = 3);
	
	Элементы.ГруппаОтбор.Видимость													= (Объект.ВариантРасчета = 0 Или Объект.ВариантРасчета = 3);
	
	Элементы.ОтборСчетДоверительногоУправления.Видимость							= Не ЭтаФорма.ОтборСчетДоверительногоУправленияВСписке;
	Элементы.ОтборСчетДоверительногоУправленияСписок.Видимость						= ЭтаФорма.ОтборСчетДоверительногоУправленияВСписке;
	
	Элементы.ГруппаОтборКлиенты.Видимость											= (Объект.ВариантРасчета = 3);
	Элементы.ОтборКлиент.Видимость													= Элементы.ГруппаОтборКлиенты.Видимость И Не ЭтаФорма.ОтборКлиентВСписке;
	Элементы.ОтборКлиентСписок.Видимость											= Элементы.ГруппаОтборКлиенты.Видимость И ЭтаФорма.ОтборКлиентВСписке;
	
	Элементы.ГруппаОтборВидыДоговоровДУ.Видимость									= (Объект.ВариантРасчета = 3);
	Элементы.ОтборВидДоговораДоверительногоУправления.Видимость						= Элементы.ГруппаОтборВидыДоговоровДУ.Видимость И Не ЭтаФорма.ОтборВидДоговораДоверительногоУправленияВСписке;
	Элементы.ОтборВидДоговораДоверительногоУправленияСписок.Видимость				= Элементы.ГруппаОтборВидыДоговоровДУ.Видимость И ЭтаФорма.ОтборВидДоговораДоверительногоУправленияВСписке;
	
	Элементы.ОтборСтратегияИндивидуальногоИнвестирования.Видимость					= (Объект.ВариантРасчета = 0);
	
	Элементы.ГруппаКаталогФайловExcel.Видимость										= (Объект.ВариантРасчета = 3);
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииРежимаРасчетаНаСервере()
	
	Объект.ДатаРасчета = ПолучитьДатуРасчета(Объект.ВариантРасчета, Объект.ПериодичностьРасчета);
	
	ОбновитьСоставПечатныхФормНаСервере();
	
	ОбновитьПериодДляПечати(ЭтаФорма, Объект);
		
	ОбновитьПредставлениеОтбора(ЭтаФорма);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДатуРасчета(ВариантРасчета, ПериодичностьРасчета)

	НоваяДатаРасчета = Неопределено;
	
	Если ВариантРасчета = 0 Тогда
		НоваяДатаРасчета = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДата()), -2);
	ИначеЕсли ВариантРасчета = 2 Тогда
		НоваяДатаРасчета = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоМесяца(ТекущаяДата()), -1);
	ИначеЕсли ВариантРасчета = 3 Тогда
		
		// 1. для всех периодичностей, кроме годовой: устанавливать последний день предыдущего периода;
		// 2. для годовой периодичности:
		//	 - при расчетах до конца января устанавливать последний день предыдущего периода;
		//   - при расчетах после января устанавливать текущую дату.
		
		Если ПериодичностьРасчета = Перечисления.ПериодичностьРасчетаВознагражденияУправляющего.Ежемесячно Тогда
			НоваяДатаРасчета = НачалоМесяца(ТекущаяДата()) - 1;
		ИначеЕсли ПериодичностьРасчета = Перечисления.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально Тогда
			НоваяДатаРасчета = НачалоКвартала(ТекущаяДата()) - 1;
		ИначеЕсли ПериодичностьРасчета = Перечисления.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно Тогда
			НоваяДатаРасчета = ?(Месяц(ТекущаяДата()) = 1, НачалоГода(ТекущаяДата()) - 1, ТекущаяДата());
		Иначе
			НоваяДатаРасчета = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДата()) - 1, -1);
		КонецЕсли;
		
	Иначе
		НоваяДатаРасчета = КонецМесяца(Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоМесяца(НачалоДня(ТекущаяДата())), -2));
	КонецЕсли;
	
	Возврат НоваяДатаРасчета;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПериодДляПечати(ЭтаФорма, Объект)

	// Это требуется только для ИИС
	Если Объект.ВариантРасчета = 0 Тогда
		ЭтаФорма.ПериодДляПечати.ДатаНачала 	= Объект.ДатаРасчета;
		ЭтаФорма.ПериодДляПечати.ДатаОкончания 	= Объект.ДатаРасчета;
	КонецЕсли;
	
	Если Объект.ВариантРасчета = 0 Или Объект.ВариантРасчета = 3 Тогда
		Если Объект.ПериодичностьРасчета = ПредопределенноеЗначение("Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежемесячно") Тогда
			ЭтаФорма.БазовыйПериод = Новый СтандартныйПериод(НачалоМесяца(Объект.ДатаРасчета), КонецМесяца(Объект.ДатаРасчета)); 	
		ИначеЕсли Объект.ПериодичностьРасчета = ПредопределенноеЗначение("Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально") Тогда
			ЭтаФорма.БазовыйПериод = Новый СтандартныйПериод(НачалоКвартала(Объект.ДатаРасчета), КонецКвартала(Объект.ДатаРасчета)); 	
		ИначеЕсли Объект.ПериодичностьРасчета = ПредопределенноеЗначение("Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно") Тогда
			ЭтаФорма.БазовыйПериод = Новый СтандартныйПериод(НачалоГода(Объект.ДатаРасчета), КонецГода(Объект.ДатаРасчета)); 	
		Иначе
			ЭтаФорма.БазовыйПериод = Неопределено;	
		КонецЕсли;			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииОтбора()
	
	ПроверитьОтборВСписке(ЭтаФорма.ОтборСчетДоверительногоУправления, ЭтаФорма.ОтборСчетДоверительногоУправленияВСписке);
	ПроверитьОтборВСписке(ЭтаФорма.ОтборКлиент, ЭтаФорма.ОтборКлиентВСписке);
	ПроверитьОтборВСписке(ЭтаФорма.ОтборВидДоговораДоверительногоУправления, ЭтаФорма.ОтборВидДоговораДоверительногоУправленияВСписке);	
	
	ОбновитьПредставлениеОтбора(ЭтаФорма);	
	
	ОчиститьДанные(ЭтаФорма);	
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	ЭтаФорма.Модифицированность = Истина;	
	
КонецПроцедуры

// Для списочных отборов в режиме единичного выбора всегда должна быть одна строка	
&НаКлиенте
Процедура ПроверитьОтборВСписке(ОтборВСписке, РежимЗаполненияВСписке)
	
	Если Не РежимЗаполненияВСписке Тогда
		
		КоличествоЭлементов = ОтборВСписке.Количество();
		
		Если КоличествоЭлементов = 0 Тогда
			ОтборВСписке.Добавить(); // добавим первую строку
		ИначеЕсли КоличествоЭлементов > 1 Тогда
			Для Индекс = 1-КоличествоЭлементов По -1 Цикл
				ОтборВСписке.Удалить(-Индекс); // удалим все элементы, кроме первого
			КонецЦикла; 
		КонецЕсли; 
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьОтбор(ЭтаФорма)
	
	Отбор = Новый Структура;
	
	Если Не СписокПустой(ЭтаФорма.ОтборСчетДоверительногоУправления) Тогда
		Отбор.Вставить("СчетДоверительногоУправления", ЭтаФорма.ОтборСчетДоверительногоУправления);	
	КонецЕсли;
	
	Если Не СписокПустой(ЭтаФорма.ОтборКлиент) И ЭтаФорма.Объект.ВариантРасчета = 3 Тогда
		Отбор.Вставить("Клиент", ЭтаФорма.ОтборКлиент);	
	КонецЕсли;
	
	Если Не СписокПустой(ЭтаФорма.ОтборВидДоговораДоверительногоУправления) И ЭтаФорма.Объект.ВариантРасчета = 3 Тогда
		Отбор.Вставить("ВидДоговораДоверительногоУправления", ЭтаФорма.ОтборВидДоговораДоверительногоУправления);	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтаФорма.ОтборСтратегияИндивидуальногоИнвестирования) И ЭтаФорма.Объект.ВариантРасчета = 0 Тогда
		Отбор.Вставить("СтратегияИндивидуальногоИнвестирования", ЭтаФорма.ОтборСтратегияИндивидуальногоИнвестирования);	
	КонецЕсли;
	
	Возврат Отбор;	
	
КонецФункции

// Список пустой, если в нем нет ни одного заполненного элемента
&НаКлиентеНаСервереБезКонтекста
Функция СписокПустой(Список)
	
	Пустой = Истина;
	
	Для каждого Элемент Из Список Цикл
		Если ЗначениеЗаполнено(Элемент.Значение) Тогда
			Пустой = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла; 
	
	Возврат Пустой;	
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПредставлениеОтбора(ЭтаФорма)
	
	Отбор = ПолучитьОтбор(ЭтаФорма);
	
	Если Отбор.Количество() = 0 Тогда
		
		ЭтаФорма.ПредставлениеОтбора = "Без отбора";
		
	Иначе
		
		ПредставлениеОтбора = Новый Массив;
		
		Для Каждого ЭлементОтбора Из Отбор Цикл
			
			Если ЭлементОтбора.Ключ = "СчетДоверительногоУправления" Тогда
				ПредставлениеЭлемента = "Счет в/у";
			ИначеЕсли ЭлементОтбора.Ключ = "Клиент" Тогда
				ПредставлениеЭлемента = "Клиент";	
			ИначеЕсли ЭлементОтбора.Ключ = "ВидДоговораДоверительногоУправления" Тогда
				ПредставлениеЭлемента = "Вид договора д/у";	
			ИначеЕсли ЭлементОтбора.Ключ = "СтратегияИндивидуальногоИнвестирования" Тогда
				ПредставлениеЭлемента = "Стратегия";
			Иначе
				ПредставлениеЭлемента = ЭлементОтбора.Ключ;	
			КонецЕсли;		
			
			Если ТипЗнч(ЭлементОтбора.Значение) = Тип("СписокЗначений") Тогда
				ПредставлениеЗначения = СтрСоединить(ЭлементОтбора.Значение.ВыгрузитьЗначения(), ", ");
			Иначе
				ПредставлениеЗначения = ЭлементОтбора.Значение;
			КонецЕсли;
			
			ПредставлениеОтбора.Добавить(ПредставлениеЭлемента + ": " + ПредставлениеЗначения);	
			
		КонецЦикла;
		
		ЭтаФорма.ПредставлениеОтбора = СтрСоединить(ПредставлениеОтбора, "; ");
		
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокНастроекПечатнойФормы(ЭтаФорма)

	// Подписант	
	
	Если ЗначениеЗаполнено(ЭтаФорма.Подписант) Тогда
		ЗаголовокНастроекПечатнойФормы = "Подписант: " + Строка(ЭтаФорма.Подписант);
		
		Если ЗначениеЗаполнено(ЭтаФорма.ПодписантДолжность) Тогда
			ЗаголовокНастроекПечатнойФормы = ЗаголовокНастроекПечатнойФормы + ", " + ЭтаФорма.ПодписантДолжность;
		КонецЕсли;
	Иначе
		ЗаголовокНастроекПечатнойФормы = "Настройки подписанта";
	КонецЕсли;

	ЭтаФорма.Элементы.ГруппаПодписант.Заголовок = ЗаголовокНастроекПечатнойФормы;
	
	// Бухгалтер	
	
	Если ЗначениеЗаполнено(ЭтаФорма.ПодписантБухгалтер) Тогда
		ЗаголовокНастроекПечатнойФормы = "Бухгалтер: " + Строка(ЭтаФорма.ПодписантБухгалтер);
		
		Если ЗначениеЗаполнено(ЭтаФорма.ПодписантБухгалтерДолжность) Тогда
			ЗаголовокНастроекПечатнойФормы = ЗаголовокНастроекПечатнойФормы + ", " + ЭтаФорма.ПодписантБухгалтерДолжность;
		КонецЕсли;
	Иначе
		ЗаголовокНастроекПечатнойФормы = "Настройки подписанта бухгалтера";
	КонецЕсли;	

	ЭтаФорма.Элементы.ГруппаПодписантБухгалтер.Заголовок = ЗаголовокНастроекПечатнойФормы;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПривестиОтборыВСоответствиеОрганизации(ЭтаФорма, СчетаСоответствующиеОрганизации = Неопределено)
	
	Если СчетаСоответствующиеОрганизации = Неопределено Тогда
		ПроверитьСчетаНаСоответствиеОрганизации(ЭтаФорма.Объект.Организация, ЭтаФорма.ОтборСчетДоверительногоУправления, СчетаСоответствующиеОрганизации);	
	КонецЕсли;	
		
	ЭтаФорма.ОтборСчетДоверительногоУправления.ЗагрузитьЗначения(СчетаСоответствующиеОрганизации);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьСчетаНаСоответствиеОрганизации(Организация, СчетаДоверительногоУправления, СчетаСоответствующиеОрганизации = Неопределено, СчетаНеСоответствующиеОрганизации = Неопределено)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	СчетаДоверительногоУправления.Организация = &Организация КАК Соответствует
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка В(&Ссылка)");
	
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("Ссылка",			СчетаДоверительногоУправления);
	
	ПроверенныеСчета					= Запрос.Выполнить().Выгрузить();
	СчетаСоответствующиеОрганизации		= ПроверенныеСчета.Скопировать(Новый Структура("Соответствует", Истина), "Ссылка").ВыгрузитьКолонку(0);
	СчетаНеСоответствующиеОрганизации	= ПроверенныеСчета.Скопировать(Новый Структура("Соответствует", Ложь), "Ссылка").ВыгрузитьКолонку(0);
	
	Возврат (СчетаНеСоответствующиеОрганизации.Количество() = 0);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКлючНастроекРасчетаВознаграждения(Организация, СчетДоверительногоУправления, ВидВознаграждения, ДатаРасчета)

	ОтборЗаписей = Новый Структура("Организация, СчетДоверительногоУправления, ВидВознаграждения", Организация, СчетДоверительногоУправления, ВидВознаграждения);
	
	СрезПоследних = РегистрыСведений.НастройкиРасчетаВознагражденияУправляющего.СрезПоследних(ДатаРасчета, ОтборЗаписей);
	Если СрезПоследних.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОтборЗаписей.Вставить("Период", СрезПоследних[0].Период);
	
	Возврат РегистрыСведений.НастройкиРасчетаВознагражденияУправляющего.СоздатьКлючЗаписи(ОтборЗаписей);

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНастройкуРасчетаВознагражденияПИФ(СчетДоверительногоУправления, ДатаРасчета)
	ОтборЗаписей = Новый Структура("ПаевойИнвестиционныйФонд", Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, ДатаРасчета));
	
	СрезПоследних = РегистрыСведений.УсловияПравилПаевогоИнвестиционногоФонда.СрезПоследних(ДатаРасчета, ОтборЗаписей);
	Если СрезПоследних.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Возврат СрезПоследних[0].НастройкаРасчетаРезервовЗаВознаграждениеУправляющего;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьНастройкиПодписантов(ЭтаФорма)

	РаботаСОтчетамиКлиентСервер.ПроверитьНастройкиПодписанта(ЭтаФорма.Подписант, ЭтаФорма.СтруктураДанныхКонтактногоЛица, ЭтаФорма.Объект.Организация);
	РаботаСОтчетамиКлиентСервер.ПроверитьНастройкиПодписанта(ЭтаФорма.ПодписантБухгалтер, ЭтаФорма.СтруктураДанныхКонтактногоЛицаБухгалтера, ЭтаФорма.Объект.Организация);

	ЗаполнитьРеквизитыПодписантаИзСтруктурыДанныхКонтактногоЛица(ЭтаФорма.СтруктураДанныхКонтактногоЛица, , ЭтаФорма.ПодписантДолжность, ЭтаФорма.ПодписантОснованиеПолномочий);
	ЗаполнитьРеквизитыПодписантаИзСтруктурыДанныхКонтактногоЛица(ЭтаФорма.СтруктураДанныхКонтактногоЛицаБухгалтера, , ЭтаФорма.ПодписантБухгалтерДолжность);

	УстановитьЗаголовокНастроекПечатнойФормы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьРеквизитыПодписантаИзСтруктурыДанныхКонтактногоЛица(СтруктураДанныхКонтактногоЛица, Подписант = Неопределено, Должность = Неопределено, ОснованиеПолномочий = Неопределено)
	
	Если Подписант <> Неопределено Тогда
		Подписант = ?(СтруктураДанныхКонтактногоЛица = Неопределено, Неопределено, СтруктураДанныхКонтактногоЛица.КонтактноеЛицо);
	КонецЕсли;
	
	Если Должность <> Неопределено Тогда
		Должность = ?(СтруктураДанныхКонтактногоЛица = Неопределено, Неопределено, СтруктураДанныхКонтактногоЛица.Должность);
	КонецЕсли;
	
	Если ОснованиеПолномочий <> Неопределено Тогда
		ОснованиеПолномочий = ?(СтруктураДанныхКонтактногоЛица = Неопределено, Неопределено, СокрЛП(СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервереИЗафиксироватьСтатистику()
	
	ПараметрыСессииСбораСтатистики = ЗарегистрироватьНовуюСессиюНаСервере("ОбновитьНаСервере");
	
	ОбновитьНаСервере(ПараметрыСессииСбораСтатистики.ДанныеДляСтатистики);
	
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессииСбораСтатистики);
	
КонецПроцедуры

&НаСервере
Функция ЗарегистрироватьНовуюСессиюНаСервере(ИмяКоманды, Знач РеквизитФормыОбъект = Неопределено)
	
	Если РеквизитФормыОбъект = Неопределено Тогда
		РеквизитФормыОбъект = РеквизитФормыВЗначение("Объект");	
	КонецЕсли;
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(РеквизитФормыОбъект);
	
	Механизм = РеквизитФормыОбъект.Метаданные().ПолноеИмя() + "." + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессииСбораСтатистики = Новый Структура("Механизм, Сессия, ДанныеДляСтатистики", Механизм, Сессия, Новый Структура("Ошибки", Новый Массив));
		
	Возврат ПараметрыСессииСбораСтатистики;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессииСбораСтатистики)

	ТекстОшибки = Неопределено;
	
	Если ПараметрыСессииСбораСтатистики.ДанныеДляСтатистики.Ошибки.Количество() > 0 Тогда
		ТекстОшибки = РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ПараметрыСессииСбораСтатистики.ДанныеДляСтатистики.Ошибки, ",");
	КонецЕсли;
	ПараметрыСессииСбораСтатистики.ДанныеДляСтатистики.Удалить("Ошибки");
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(ПараметрыСессииСбораСтатистики.Механизм, ПараметрыСессииСбораСтатистики.Сессия,, ПараметрыСессииСбораСтатистики.ДанныеДляСтатистики, ТекстОшибки);	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РассчитатьВремя(ВремяНачала)
	 
	ВремяСек = ТекущаяДатаСеанса() - ВремяНачала; 
	ВремяМин = Цел((ВремяСек) / 60);
	
	Возврат Строка(ВремяСек) + " сек."  + ?(ВремяМин > 0, " (" + Строка(ВремяМин) + " м. " + Строка(ВремяСек - ВремяМин * 60) + " с.)","");
	
КонецФункции

