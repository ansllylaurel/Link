	Возврат ФормулаСуммыРассчитанныхВознаграждений(Расшифровка, ДанныеРасшифровки, Истина, ВнешниеСсылки, ЗаВычетомРанееУплаченногоПриНачисленииНарастающимИтогом);
	
КонецФункции

&НаКлиенте
Функция ФормулаСуммыРассчитанныхВознаграждений(Расшифровка, ДанныеРасшифровки, ЗаУправление, ВнешниеСсылки = Ложь, ЗаВычетомРанееУплаченногоПриНачисленииНарастающимИтогом = Ложь)
	
	ФормулаСуммы						= "";
	СтраницаРасчета						= Расшифровка.Результат.ПараметрыЛистов["Расчет"];
	ЕстьНачисляемоеНарастающимИтогом	= Ложь;
	
	// Добавляем суммы
	
	АдресаЯчеек = Новый Массив;

	Для Каждого ЭлементРасчетаВознаграждения Из СтраницаРасчета.КлючевыеЯчейки["РасчетВознаграждения"] Цикл
		
		Если (ЭлементРасчетаВознаграждения.ВознаграждениеЗаУправление = Истина) = ЗаУправление Тогда
			
			АдресаЯчеек.Добавить(ЭлементРасчетаВознаграждения.Область.Address(Ложь, Ложь, , ВнешниеСсылки));
			
			Если ЭлементРасчетаВознаграждения.НачисляетсяНарастающимИтогом Тогда
				ЕстьНачисляемоеНарастающимИтогом = Истина
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ФормулаСуммы = СтрСоединить(АдресаЯчеек, "+");
	
	// Вычитаем ранее уплаченное вознаграждение
	
	Если ЗаВычетомРанееУплаченногоПриНачисленииНарастающимИтогом И ЕстьНачисляемоеНарастающимИтогом Тогда
		
		Если СтраницаРасчета.КлючевыеЯчейки["ВознаграждениеУплаченное"] = Неопределено Тогда
			ВознаграждениеУплаченное = Формат(ДанныеРасшифровки.ВознаграждениеУплаченноеСНачалаГода, "ЧДЦ=2; ЧРД=,; ЧГ=");	
		Иначе
			ВознаграждениеУплаченное = СтраницаРасчета.КлючевыеЯчейки["ВознаграждениеУплаченное"].Address(Ложь, Ложь, , ВнешниеСсылки);	
		КонецЕсли;		
		
		ФормулаСуммы = ФормулаСуммы + "-" + ВознаграждениеУплаченное;
		
	КонецЕсли;
	
	Возврат ФормулаСуммы;
	
КонецФункции

&НаКлиенте
Функция ФормулаСуммРасходовПоДоговоруСоСпецдепозитарием(Расшифровка, ВидыЗадолженности, ВнешниеСсылки = Ложь)
	
	СтраницаРасчета						= Расшифровка.Результат.ПараметрыЛистов["Расчет"];	
	РасходыПоДоговоруСоСпецдепозитарием	= СтраницаРасчета.КлючевыеЯчейки["РасходыПоДоговоруСоСпецдепозитарием"];
	АдресаЯчеек							= Новый Массив;

	Для Каждого ВидЗадолженности Из ВидыЗадолженности Цикл
		
		ЯчейкаСуммы = РасходыПоДоговоруСоСпецдепозитарием[ВидЗадолженности];
		
		Если ЯчейкаСуммы <> Неопределено Тогда
			АдресаЯчеек.Добавить(ЯчейкаСуммы.Address(Ложь, Ложь, , ВнешниеСсылки));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтрСоединить(АдресаЯчеек, "+");
	
КонецФункции

