#КонецОбласти

#Область Сериализация

&НаСервереБезКонтекста
Функция СериализоватьЗначение(ЗначениеИсточник) Экспорт
	
	ИсходныйТип = ТипЗнч(ЗначениеИсточник);	
	
	Если ИсходныйТип = Тип("Массив") Тогда
		Результат = СериализоватьМассив(ЗначениеИсточник);
	ИначеЕсли ИсходныйТип = Тип("ТаблицаЗначений") Тогда
		Результат = СериализоватьТаблицуЗначений(ЗначениеИсточник);
	ИначеЕсли ИсходныйТип = Тип("Структура") Тогда
		Результат = СериализоватьСтруктуру(ЗначениеИсточник);
	Иначе
		Результат = ЗначениеИсточник;
	КонецЕсли;
	
    Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция СериализоватьТаблицуЗначений(ТаблицаИсточник) Экспорт

	// Формируем описание структуры

	МассивКолонок				= Новый Массив;
	МассивИсключаемыхКолонок	= Новый Массив;
			
	Для Каждого Колонка Из ТаблицаИсточник.Колонки Цикл
		Если Колонка.ТипЗначения.СодержитТип(Тип("Массив"))
			Или Колонка.ТипЗначения.СодержитТип(Тип("ТаблицаЗначений"))
			Или Колонка.ТипЗначения.СодержитТип(Тип("Структура"))
		Тогда
			МассивИсключаемыхКолонок.Добавить(Колонка.Имя);			
		Иначе
			МассивКолонок.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	СтруктураСтрокой = СтрСоединить(МассивКолонок, ", ");
	
	// Заполняем данными	
	
    Результат = Новый Массив;
	
	Для Каждого ИсходнаяСтрока Из ТаблицаИсточник Цикл
        НоваяСтрока = Новый Структура(СтруктураСтрокой);
        ЗаполнитьЗначенияСвойств(НоваяСтрока, ИсходнаяСтрока);
		
		Для Каждого ИсключаемаяКолонка Из МассивИсключаемыхКолонок Цикл
			ИсходноеЗначение	= ИсходнаяСтрока[ИсключаемаяКолонка];
			ИсходныйТип			= ТипЗнч(ИсходноеЗначение);
			
			Если ИсходныйТип = Тип("Массив") Тогда
				НоваяСтрока.Вставить(ИсключаемаяКолонка, СериализоватьМассив(ИсходноеЗначение)); 		
			ИначеЕсли ИсходныйТип = Тип("ТаблицаЗначений") Тогда
				НоваяСтрока.Вставить(ИсключаемаяКолонка, СериализоватьТаблицуЗначений(ИсходноеЗначение)); 		
			ИначеЕсли ИсходныйТип = Тип("Структура") Тогда
				НоваяСтрока.Вставить(ИсключаемаяКолонка, СериализоватьСтруктуру(ИсходноеЗначение));
			КонецЕсли;
		КонецЦикла;
		
		Результат.Добавить(НоваяСтрока);
	КонецЦикла;
	
    Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция СериализоватьМассив(МассивИсточник) Экспорт
		
	Результат = Новый Массив;
	
	Для Каждого ИсходноеЗначение Из МассивИсточник Цикл
		ИсходныйТип = ТипЗнч(ИсходноеЗначение);
			
		Если ИсходныйТип = Тип("Массив") Тогда
			Результат.Добавить(СериализоватьМассив(ИсходноеЗначение));
		ИначеЕсли ИсходныйТип = Тип("ТаблицаЗначений") Тогда
			Результат.Добавить(СериализоватьТаблицуЗначений(ИсходноеЗначение));
		ИначеЕсли ИсходныйТип = Тип("Структура") Тогда
			Результат.Добавить(СериализоватьСтруктуру(ИсходноеЗначение));
		Иначе
			Результат.Добавить(ИсходноеЗначение);
		КонецЕсли;
	КонецЦикла;
	
    Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция СериализоватьСтруктуру(СтруктураИсточник) Экспорт
		
	Результат = Новый Структура;
	
	Для Каждого ИсходноеПоле Из СтруктураИсточник Цикл
		ИсходныйТип = ТипЗнч(ИсходноеПоле.Значение);
			
		Если ИсходныйТип = Тип("Массив") Тогда
			Результат.Вставить(ИсходноеПоле.Ключ, СериализоватьМассив(ИсходноеПоле.Значение));
		ИначеЕсли ИсходныйТип = Тип("ТаблицаЗначений") Тогда
			Результат.Вставить(ИсходноеПоле.Ключ, СериализоватьТаблицуЗначений(ИсходноеПоле.Значение));
		ИначеЕсли ИсходныйТип = Тип("Структура") Тогда
			Результат.Вставить(ИсходноеПоле.Ключ, СериализоватьСтруктуру(ИсходноеПоле.Значение));
		Иначе
			Результат.Вставить(ИсходноеПоле.Ключ, ИсходноеПоле.Значение);
		КонецЕсли;
	КонецЦикла;
	
    Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ВознагражденияУправляющегоПодписантНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	Если Элементы.ВознагражденияУправляющего.ТекущиеДанные.НуженПодписант Тогда 
		
		Клиент = Элементы.ВознагражденияУправляющего.ТекущиеДанные.Клиент; 
		Параметрыформы = РаботаСОтчетами.ПолучитьПараметрыФормыВыбораКонтактногоЛица(Новый Структура("Организация, Объект, КонтактноеЛицо", Объект.Организация, Клиент, ЭтаФорма.Элементы.ВознагражденияУправляющего.ТекущиеДанные.Подписант));					
		ОткрытьФормуМодально("РегистрСведений.КонтактныеЛица.ФормаСписка", ПараметрыФормы, Элемент, ЭтаФорма);   
	Иначе   
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В расшифровке расчета по " + Элементы.ВознагражденияУправляющего.ТекущиеДанные.Клиент +  " Акт не предусмотрен или шаблон акта не равен Будущее2023. Подписант не нужен.")
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВознагражденияУправляющегоПодписантОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДанныеКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(ВыбранноеЗначение);  
	
	Клиент = Элементы.ВознагражденияУправляющего.ТекущиеДанные.Клиент;        
	
	Для Каждого СтрокаВознаграждение из ЭтотОбъект.ВознагражденияУправляющего Цикл 
		Если СтрокаВознаграждение.Клиент = Клиент 
			И СтрокаВознаграждение.НуженПодписант Тогда        
			
			СтрокаВознаграждение.Подписант = ДанныеКонтактногоЛица.КонтактноеЛицо;
			СтрокаВознаграждение.СтруктураПодписантОтКлиента = ДанныеКонтактногоЛица;
			
		КонецЕсли;
	КонецЦикла;		
	
КонецПроцедуры

#КонецОбласти
