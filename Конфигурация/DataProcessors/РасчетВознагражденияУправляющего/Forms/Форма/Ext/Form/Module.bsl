						ОбластьВставки, "ПериодРасчета",
						"с " + ОбщиеПараметрыЗаполнения.НачалоБазовогоПериодаСтрокой + " по " + ОбщиеПараметрыЗаполнения.КонецБазовогоПериодаСтрокой, Истина);
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
						ОбластьВставки, "СредняяСЧА",
						"=" + ЯчейкаСредняяСЧА.Address(Ложь, Ложь, , Истина));
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
						ОбластьВставки, "Ставка",
						"=" + ЯчейкаСтавка.Address(Ложь, Ложь, , Истина) + " * 100");
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
						ОбластьВставки, "Сумма",
						"=" + СтраницаРасчета.КлючевыеЯчейки["ВознаграждениеОтСреднейСЧА" + СуффиксПоказателей].Address(Ложь, Ложь, , Истина));
					
					#КонецОбласти
					
				КонецЕсли;
				
			Иначе
				
				Если ДанныеРасшифровки.ШаблонРасшифровки = "ФизЛицо" Тогда
					
					#Область Физическое_лицо
					
					ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонГруппаПоказателей);
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
						ОбластьВставки, "ГруппаПоказателей",
						СтрШаблон("%1. Средняя СЧА за отчетный период", ДанныеРасшифровки.БазыРасчета.Найти(РасшифровкаРасчетаПоБазе) + 1));
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
						ОбластьВставки, "ЗначениеПоказателя",
						?(РасчетВВалютеУчета, "в рублях РФ", "=ПредставлениеВалютыРасчета"));
					
					ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонПоказатель, Ложь, Ложь);
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
						ОбластьВставки, "Показатель",
						"Средняя СЧА за отчетный период");
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
						ОбластьВставки, "ЗначениеПоказателя",
						"=" + ЯчейкаСредняяСЧА.Address(Ложь, Ложь, , Истина));
					
					#КонецОбласти
					
				КонецЕсли;
				
			КонецЕсли;
			
			#КонецОбласти
			
			Если ДанныеРасшифровки.ВыводитьАкт Тогда
				
				#Область Формируем_акт_об_оказанных_услугах
			
				Если РасшифровкаРасчетаПоБазе.БазаРасчета = ПредопределенноеЗначение("Справочник.БазыРасчета.УдельнаяСуммаСЧА") Тогда
					ПрефиксШаблонаАкта = "АктУдельнаяСуммаСЧА";
				Иначе
					ПрефиксШаблонаАкта = "Акт";
				КонецЕсли;
				
				ОбластьАкта = ПолучитьОбластьАктаExcel(ExcelApp, Расшифровка, ДанныеРасшифровки, ШаблонСтраницыАкта, ОбщийАкт, ПрефиксШаблонаАкта);
				
				Если РасшифровкаРасчетаПоБазе.БазаРасчета = ПредопределенноеЗначение("Справочник.БазыРасчета.УдельнаяСуммаСЧА") Тогда
					ПредставлениеСреднейСЧА = ПредставленияСуммыДляПечати(РасшифровкаРасчетаПоБазе.УдельнаяСуммаСЧА);
					
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
						ОбластьАкта, "СредняяСЧАРублей",
						ПредставлениеСреднейСЧА.СуммаРублей, Истина);
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
						ОбластьАкта, "СредняяСЧАПрописьюРублей",
						ПредставлениеСреднейСЧА.СуммаПрописьюРублей, Истина);
				КонецЕсли;
				
				#КонецОбласти
				
			КонецЕсли;
			
			#КонецОбласти
		Иначе
			#Область Нереализованная_расшифровка_расчёта_по_базе
			
			// Известен только результат
			
			ШаблонШапки = ШаблонСтраницыРасчета.Страница.Range("ШапкаРасчетБезРасшифровки");
			
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонШапки, Ложь, Ложь);
			
			ШаблонСтроки   = ШаблонСтраницыРасчета.Страница.Range("СтрокаРасчетБезРасшифровки");
			ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонСтроки);
			
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "Показатель",		   "Представление");
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ЗначениеПоказателя", РасшифровкаРасчетаПоБазе.Представление);
			
			ШаблонИтога    = ШаблонСтраницыРасчета.Страница.Range("ИтогРасчетБезРасшифровки");
			ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонИтога);
			
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ЗначениеПоказателя", РасшифровкаРасчетаПоБазе.СуммаВознаграждения);
			
			// Добавляем показатели на титульную страницу
			
			ДобавитьЯчейкуРасчетаВознаграждения(
				СтраницаРасчета,
				"Вознаграждение управляющего: " + РасшифровкаРасчетаПоБазе.Представление,
				СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "D"),
				РасшифровкаРасчетаПоБазе.НачисляетсяНарастающимИтогом,
				Неопределено
			);
			
			// Добавляем отступ для следующих расчетов
			
			СтраницаРасчета.ВсегоСтрок = СтраницаРасчета.ВсегоСтрок + 2;
			
			#КонецОбласти
		КонецЕсли;
		
		#Область Заполнение_даты_расчёта_СЧА_на_начало_года
		
		Если РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета.Свойство("_СЧАНаНачалоГода") Тогда
			
			СЧАНаНачалоГода = РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_СЧАНаНачалоГода"];
			
			Если СЧАНаНачалоГода.Количество() > 0 Тогда
			
				ЯчейкаДатаРасчетаСЧАНаНачалоГода = СтраницаРасчета.КлючевыеЯчейки.Получить("ДатаРасчетаСЧАНаНачалоГода");
				
				Если ЯчейкаДатаРасчетаСЧАНаНачалоГода <> Неопределено Тогда
					
					ЯчейкаДатаРасчетаСЧАНаНачалоГода.Value = СЧАНаНачалоГода[0].Дата;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		#КонецОбласти
		
		// Заполнение акта данными, не зависящими от базы расчёта
		Если ОбластьАкта <> Неопределено И Не ОбщийАкт Тогда
			УстановитьЗначенияПараметровАкта(ОбластьАкта, ДанныеРасшифровки, ДанныеОбОрганизации, ОбщиеПараметрыЗаполнения, ПредставлениеСуммыВознаграждения);
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьПараметрыПечати(ОбластьАкта.Worksheet, Истина, ОриентацияСтраницы.Портрет);
		КонецЕсли;
	КонецЦикла;
	
	#КонецОбласти
	
	// Итоговый расчёт вознаграждения к оплате
	#Область Расчёт_вознаграждения_к_оплате
	
	ФормулыВознагражденияНачисляемогоЗаПериод			= Новый Массив;
	ФормулыВознагражденияНачисляемогоНарастающимИтогом	= Новый Массив;
	
	Для Каждого ЭлементРасчетаВознаграждения Из СтраницаРасчета.КлючевыеЯчейки["РасчетВознаграждения"] Цикл
		
		Если ЭлементРасчетаВознаграждения.ВключатьВИтоговуюСумму Тогда
			
			ФормулаВознаграждения = СтрШаблон("ЕСЛИ(%1<0;0;%1)", ЭлементРасчетаВознаграждения.Область.Address(Ложь, Ложь));
			
			Если ЭлементРасчетаВознаграждения.НачисляетсяНарастающимИтогом Тогда 
				ФормулыВознагражденияНачисляемогоНарастающимИтогом.Добавить(ФормулаВознаграждения);
			Иначе
				ФормулыВознагражденияНачисляемогоЗаПериод.Добавить(ФормулаВознаграждения);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ИтоговаяФормулаВознагражденияНачисляемогоЗаПериод =
		?(ФормулыВознагражденияНачисляемогоЗаПериод.Количество() > 0, "=" + СтрСоединить(ФормулыВознагражденияНачисляемогоЗаПериод, " + "), "");
	
	ИтоговаяФормулаВознагражденияНачисляемогоНарастающимИтогом =
		?(ФормулыВознагражденияНачисляемогоНарастающимИтогом.Количество() > 0, "=" + СтрСоединить(ФормулыВознагражденияНачисляемогоНарастающимИтогом, " + "), "");
	
	СуффиксОбласти = ?(ЗначениеЗаполнено(ДанныеРасшифровки.ОграничениеОбщегоРазмераВознаграждения), "СОграничениемОбщегоРазмера", "");
	ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонГруппаРасчета);
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ГруппаРасчета", "Расчет вознаграждения к оплате");
	СтраницаРасчета.ВсегоСтрок = СтраницаРасчета.ВсегоСтрок + 2;
	
	ШаблонИтоговыйРасчет = ШаблонСтраницыРасчета.Страница.Range(?(РасчетВВалютеУчета, "ИтоговыйРасчет", "ИтоговыйРасчетВалютный") + СуффиксОбласти);
	ОбластьВставки		 = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонИтоговыйРасчет);

	Если РасчетВВалютеУчета Тогда
		
		ЯчейкаВознагражденияНачисляемогоЗаПериод = РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(ОбластьВставки, "ВознаграждениеНачисляемоеЗаПериод");
		ЯчейкаВознагражденияНачисляемогоЗаПериод.FormulaLocal = ИтоговаяФормулаВознагражденияНачисляемогоЗаПериод;
		
		ЯчейкаВознагражденияНачисляемогоНарастающимИтогом = РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(
			ОбластьВставки, "ВознаграждениеНачисляемоеНарастающимИтогом");
		ЯчейкаВознагражденияНачисляемогоНарастающимИтогом.FormulaLocal = ИтоговаяФормулаВознагражденияНачисляемогоНарастающимИтогом;
		
		ЯчейкаСуммарноеВознаграждение = РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(ОбластьВставки, "СуммарноеВознаграждение");
		ЯчейкаСуммарноеВознаграждение.FormulaLocal =
			"=" + ЯчейкаВознагражденияНачисляемогоЗаПериод.Address(Ложь, Ложь) + " + " + ЯчейкаВознагражденияНачисляемогоНарастающимИтогом.Address(Ложь, Ложь);
		
		СтраницаРасчета.КлючевыеЯчейки.Вставить("СуммарноеВознаграждение", ЯчейкаСуммарноеВознаграждение);
	
	Иначе
		
		// Пересчитываем рассчитанное вознаграждение в валюту учета
		
		ЯчейкаВознагражденияНачисляемогоЗаПериодВВалютеРасчета = РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(
			ОбластьВставки, "ВознаграждениеНачисляемоеЗаПериодВВалютеРасчета");
		ЯчейкаВознагражденияНачисляемогоЗаПериодВВалютеРасчета.FormulaLocal = ИтоговаяФормулаВознагражденияНачисляемогоЗаПериод;
		
		ЯчейкаВознагражденияНачисляемогоНарастающимИтогомВВалютеРасчета = РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(
			ОбластьВставки, "ВознаграждениеНачисляемоеНарастающимИтогомВВалютеРасчета");
		ЯчейкаВознагражденияНачисляемогоНарастающимИтогомВВалютеРасчета.FormulaLocal = ИтоговаяФормулаВознагражденияНачисляемогоНарастающимИтогом;
		
		ЯчейкаСуммарноеВознаграждениеВВалютеРасчета = РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(
			ОбластьВставки, "СуммарноеВознаграждениеВВалютеРасчета");
		ЯчейкаСуммарноеВознаграждениеВВалютеРасчета.FormulaLocal =
			"=" + ЯчейкаВознагражденияНачисляемогоЗаПериодВВалютеРасчета.Address(Ложь, Ложь)
				+ " + " + ЯчейкаВознагражденияНачисляемогоНарастающимИтогомВВалютеРасчета.Address(Ложь, Ложь);
		
		СтраницаКурсовВалют = Расшифровка.Результат.ПараметрыЛистов["Курсы валют"];
		Если СтраницаКурсовВалют = Неопределено Тогда
			КурсВалютыРасчета = ДанныеРасшифровки.КурсВалютыРасчета;	
		Иначе
			КурсВалютыРасчета = СтрШаблон(
				"=ЕСЛИ(ВалютаРасчета=""RUB""; 1; ВПР(ВалютаРасчета & КонецПериодаРасчета; %1; 2; ЛОЖЬ))",
				СтраницаКурсовВалют.КлючевыеЯчейки["КурсыВалют"].Address(Истина, Истина, , Истина));
		КонецЕсли;
		
		ЯчейкаКурсВалютыРасчета = РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(ОбластьВставки, "КурсВалютыРасчета");
		ЯчейкаКурсВалютыРасчета.FormulaLocal = КурсВалютыРасчета;
		
		ЯчейкаВознагражденияНачисляемогоЗаПериод = РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(ОбластьВставки, "ВознаграждениеНачисляемоеЗаПериод");
		ЯчейкаВознагражденияНачисляемогоЗаПериод.FormulaLocal = СтрШаблон(
			"=ОКРУГЛ(%1 * %2; 2)",
			ЯчейкаВознагражденияНачисляемогоЗаПериодВВалютеРасчета.Address(Ложь, Ложь),
			ЯчейкаКурсВалютыРасчета.Address(Ложь, Ложь));
		
		ЯчейкаВознагражденияНачисляемогоНарастающимИтогом = РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(
			ОбластьВставки, "ВознаграждениеНачисляемоеНарастающимИтогом");
		ЯчейкаВознагражденияНачисляемогоНарастающимИтогом.FormulaLocal = СтрШаблон(
			"=ОКРУГЛ(%1 * %2; 2)",
			ЯчейкаВознагражденияНачисляемогоНарастающимИтогомВВалютеРасчета.Address(Ложь, Ложь),
			ЯчейкаКурсВалютыРасчета.Address(Ложь, Ложь));
		
		ЯчейкаСуммарноеВознаграждение = РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(ОбластьВставки, "СуммарноеВознаграждение");
		ЯчейкаСуммарноеВознаграждение.FormulaLocal =
			"=" + ЯчейкаВознагражденияНачисляемогоЗаПериод.Address(Ложь, Ложь) + " + " + ЯчейкаВознагражденияНачисляемогоНарастающимИтогом.Address(Ложь, Ложь);
		
		СтраницаРасчета.КлючевыеЯчейки.Вставить("КурсВалютыРасчета",		ЯчейкаКурсВалютыРасчета);
		СтраницаРасчета.КлючевыеЯчейки.Вставить("СуммарноеВознаграждение",	ЯчейкаСуммарноеВознаграждение);
	КонецЕсли;
	
	// Удержанное вознаграждение
	
	ЯчейкаВознаграждениеУплаченное = СтраницаРасчета.КлючевыеЯчейки["ВознаграждениеУплаченноеВВалютеУчета"];
	
	Если ЯчейкаВознаграждениеУплаченное = Неопределено И РасчетВВалютеУчета Тогда
		ЯчейкаВознаграждениеУплаченное = СтраницаРасчета.КлючевыеЯчейки["ВознаграждениеУплаченное"];
		Если ЯчейкаВознаграждениеУплаченное <> Неопределено Тогда
			СтраницаРасчета.КлючевыеЯчейки.Вставить("ВознаграждениеУплаченноеВВалютеУчета", ЯчейкаВознаграждениеУплаченное);
		КонецЕсли;		
	КонецЕсли;
	
	// Удержанное вознаграждение по данным БУ берем из бухгалтерской базы 	
	ЯчейкаВознаграждениеУплаченноеБУ = РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(ОбластьВставки, "ВознаграждениеУплаченноеБУ");
	
	Если ЯчейкаВознаграждениеУплаченное = Неопределено Тогда
		ЯчейкаВознаграждениеУплаченное = РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(ОбластьВставки, "ВознаграждениеУплаченное");
		ЯчейкаВознаграждениеУплаченное.Value2 = ?(ДанныеРасшифровки.РанееУдержанноеВознаграждениеБУ = Неопределено, ДанныеРасшифровки.ВознаграждениеУплаченноеСНачалаГода, 0);
		СтраницаРасчета.КлючевыеЯчейки.Вставить("ВознаграждениеУплаченноеВВалютеУчета", ЯчейкаВознаграждениеУплаченное);
		
		Если ДанныеРасшифровки.РанееУдержанноеВознаграждениеБУ <> Неопределено Тогда
			ДанныеРасшифровки.Вставить("РанееУдержанноеВознаграждениеБУИспользованоВРасчете", Истина);
		КонецЕсли;
	ИначеЕсли ИспользоватьВознаграждениеИзБухгалтерскойБазы И ЯчейкаВознаграждениеУплаченноеБУ <> Неопределено Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
			ОбластьВставки, "ВознаграждениеУплаченное", "=" + ЯчейкаВознаграждениеУплаченноеБУ.Address(Ложь, Ложь));			
	Иначе	
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
			ОбластьВставки, "ВознаграждениеУплаченное", "=" + ЯчейкаВознаграждениеУплаченное.Address(Ложь, Ложь));
	КонецЕсли;
	
	Если ЯчейкаВознаграждениеУплаченноеБУ <> Неопределено Тогда
		// Если уже получено в параметрах расчета, используем его
		// Если оно должно было быть получено, сообщим об ошибке расчета
		Если ИспользоватьВознаграждениеИзБухгалтерскойБазы
			И Не ДанныеРасшифровки.РанееУдержанноеВознаграждениеБУИспользованоВРасчете
		Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка расчета: в расчете не использовано ранее удержанное вознаграждение по данным собственной бухгалтерии");
			ЯчейкаВознаграждениеУплаченноеБУ.Value2 = 0;
		Иначе
			ЯчейкаВознаграждениеУплаченноеБУ.Value2 = ?(ДанныеРасшифровки.РанееУдержанноеВознаграждениеБУ <> Неопределено,
				ДанныеРасшифровки.РанееУдержанноеВознаграждениеБУ,
				ПолучитьУдержанноеВознаграждениеПоДаннымБухгалтерии(ЭтаФорма.АдресДанныхБухгалтерииОбУдержанномВознаграждении,
					ДанныеРасшифровки.СчетДоверительногоУправления));
			СтраницаРасчета.КлючевыеЯчейки.Вставить("ВознаграждениеУплаченноеБУ", ЯчейкаВознаграждениеУплаченноеБУ);
		КонецЕсли;
	КонецЕсли;
		
	Для Каждого ЯчейкаТитульнойСтраницы Из ТитульнаяСтраница.КлючевыеЯчейки["ВознаграждениеУплаченное"] Цикл
		ЯчейкаТитульнойСтраницы.FormulaLocal = "=" + ?(ИспользоватьВознаграждениеИзБухгалтерскойБазы,
			ЯчейкаВознаграждениеУплаченноеБУ.Address(Ложь, Ложь, , Истина),
			ЯчейкаВознаграждениеУплаченное.Address(Ложь, Ложь, , Истина));
	КонецЦикла;
	
	// Ограничение общего размера вознаграждения с начала действия договора
	
	Если ЗначениеЗаполнено(ДанныеРасшифровки.ОграничениеОбщегоРазмераВознаграждения) Тогда
		
		ЯчейкаВознаграждениеУплаченноеСНачалаДоговора = РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(
			ОбластьВставки, "ВознаграждениеУплаченноеСНачалаДоговора");
		Если ЯчейкаВознаграждениеУплаченноеСНачалаДоговора <> Неопределено Тогда
			ЯчейкаВознаграждениеУплаченноеСНачалаДоговора.Value2 = ДанныеРасшифровки.ВознаграждениеУплаченноеСНачалаДоговора;
		КонецЕсли;
		
		ЯчейкаОграничениеОбщегоРазмераВознаграждения = РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(
			ОбластьВставки, "ОграничениеОбщегоРазмераВознаграждения");
		Если ЯчейкаОграничениеОбщегоРазмераВознаграждения <> Неопределено Тогда
			ЯчейкаОграничениеОбщегоРазмераВознаграждения.Value2 = ДанныеРасшифровки.ОграничениеОбщегоРазмераВознаграждения;
		КонецЕсли;
		
	КонецЕсли;
	
	// При использовании ранее удержанного вознаграждения из бухгалтерской базы его нужно вычесть из итоговой суммы
	Если ИспользоватьВознаграждениеИзБухгалтерскойБазы Тогда 
		АдресЯчейкиВознагражденияБУ = ЯчейкаВознаграждениеУплаченноеБУ.Address(Ложь, Ложь);
		СтрокаЯчейкиВознаграждения	= Число(СтрЗаменить(АдресЯчейкиВознагражденияБУ, "D", "")) - 1;
		АдресЯчейкиВознаграждения 	= "D" + Формат(СтрокаЯчейкиВознаграждения, "ЧГ=0");
		
		ТекущаяФормула = СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "D").FormulaLocal;
		СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "D").FormulaLocal = СтрЗаменить(ТекущаяФормула, АдресЯчейкиВознаграждения, АдресЯчейкиВознагражденияБУ); 
	КонецЕсли;
	
	СтраницаРасчета.КлючевыеЯчейки.Вставить("ВознаграждениеКОплате", СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "D"));
	
	СтраницаРасчета.ВсегоСтрок = СтраницаРасчета.ВсегоСтрок + 2;
	
	// Контроль суммы вознаграждения
	
	ВывестиКонтрольСуммыВознагражденияExcel(ДанныеРасшифровки, Расшифровка);
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьПараметрыПечати(СтраницаРасчета.Страница, Истина, ОриентацияСтраницы.Ландшафт);
	
	#КонецОбласти
	
	#Область Тело_и_подвал_титульной_страницы
	
	// Выводим составляющие расчета вознаграждения
	Если ШаблонГруппаПоказателей <> Неопределено Тогда
		
		Если ДанныеРасшифровки.ШаблонРасшифровки = "ФизЛицо" Тогда
			ГруппаПоказателей	= СтрШаблон("%1. Расчет вознаграждения управляющего", ДанныеРасшифровки.БазыРасчета.Количество() + 1);
			ЗначениеПоказателя	= ?(РасчетВВалютеУчета, "в рублях РФ", "=ПредставлениеВалютыРасчета");
		Иначе
			ГруппаПоказателей	= ?(РасчетВВалютеУчета, "Расчет вознаграждения управляющего", "= ""Расчет вознаграждения управляющего "" & ПредставлениеВалютыРасчета");
			ЗначениеПоказателя	= "";
		КонецЕсли;
		
		ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонГруппаПоказателей);
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ГруппаПоказателей", ГруппаПоказателей);
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ЗначениеПоказателя", ЗначениеПоказателя);
		
	КонецЕсли;
	
	Если ШаблонПоказатель <> Неопределено
		// Начиная с 2023 для стандартного шаблона составляющие выводятся в коде расчета по базам
		И ДанныеРасшифровки.ШаблонРасшифровки <> "2023" И ДанныеРасшифровки.ШаблонРасшифровки <> "2024"
	Тогда
		Для Каждого ЭлементРасчетаВознаграждения Из СтраницаРасчета.КлючевыеЯчейки["РасчетВознаграждения"] Цикл
			Если ЭлементРасчетаВознаграждения.ВыводитьНаТитульнойСтранице Тогда
				ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонПоказатель);
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
					ОбластьВставки, "Показатель",			ЭлементРасчетаВознаграждения.Показатель);
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
					ОбластьВставки, "ЗначениеПоказателя",	"=" + ЭлементРасчетаВознаграждения.Область.Address(Ложь, Ложь, , Истина));
			КонецЕсли;
		КонецЦикла;
		
		Если РасчетВВалютеУчета И ДанныеРасшифровки.ШаблонРасшифровки <> "ФизЛицо" Тогда // Выводится позже в валюте учета при расчете вознаграждения к оплате
			ВывестиВознаграждениеУдержанноеРанееНаТитульнуюСтраницу(
				ТитульнаяСтраница, СтраницаРасчета, ШаблонПоказатель, ЯчейкаВознаграждениеУплаченноеСНачалаДоговора, ЯчейкаОграничениеОбщегоРазмераВознаграждения);
		КонецЕсли;
		
	КонецЕсли;            
	
	Если СтрНачинаетсяС(ДанныеРасшифровки.ШаблонРасшифровки, "Сургутнефтегаз") Тогда
		
		#Область Сургутнефтегаз
		
		// Очищаем (заполняем значениями по умолчанию) неиспользованные параметры
		
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "ИнвестиционныйДоход",			"");
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "СтавкаВознагражденияПоИД",		"");
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "ВознаграждениеПоИД",				"");
		
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "КоличествоДнейПериодаРасчета",	ДанныеРасшифровки.КоличествоДнейПериодаРасчета);
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "СуммаЗаГод",						"0");
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "ВознаграждениеЗаУправление",		"0");
		
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
			ОбластьТело, "СуммарноеВознаграждение",
			"=" + СтраницаРасчета.КлючевыеЯчейки["СуммарноеВознаграждение"].Address(Ложь, Ложь, , Истина));
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
			ОбластьТело, "ВознаграждениеУплаченное", 
			"=" + ?(ИспользоватьВознаграждениеИзБухгалтерскойБазы,
				СтраницаРасчета.КлючевыеЯчейки["ВознаграждениеУплаченноеБУ"].Address(Ложь, Ложь, , Истина),
				СтраницаРасчета.КлючевыеЯчейки["ВознаграждениеУплаченноеВВалютеУчета"].Address(Ложь, Ложь, , Истина)));
                			
		#КонецОбласти
		
	КонецЕсли;
	
	// Итого к оплате вознаграждения
	Если СтрНачинаетсяС(ДанныеРасшифровки.ШаблонРасшифровки, "Будущее") Тогда
		
		#Область Будущее
		
		ОбластьТело = ВывестиТелоТитульнойСтраницыExcel(ДанныеРасшифровки, Расшифровка);
		
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
			ОбластьТело, "СуммарноеВознаграждение",
			"=" + СтраницаРасчета.КлючевыеЯчейки["СуммарноеВознаграждение"].Address(Ложь, Ложь, , Истина));
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
			ОбластьТело, "ВознаграждениеУплаченное", 
			"=" + ?(ИспользоватьВознаграждениеИзБухгалтерскойБазы,
				СтраницаРасчета.КлючевыеЯчейки["ВознаграждениеУплаченноеБУ"].Address(Ложь, Ложь, , Истина),
				СтраницаРасчета.КлючевыеЯчейки["ВознаграждениеУплаченноеВВалютеУчета"].Address(Ложь, Ложь, , Истина)));
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
			ОбластьТело, "ВознаграждениеКОплате",
			"=" + СтраницаРасчета.КлючевыеЯчейки["ВознаграждениеКОплате"].Address(Ложь, Ложь, , Истина));
		
		// Очищаем (заполняем значениями по умолчанию) неиспользованные параметры
		
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "ИнвестиционныйДоход",			"");
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "СтавкаВознагражденияПоИД",		"");
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "ВознаграждениеПоИД",				"");
		
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "КоличествоДнейПериодаРасчета",	ДанныеРасшифровки.КоличествоДнейПериодаРасчета);
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "СуммаЗаГод",						"0");
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "ВознаграждениеЗаУправление",		"0");
		
		#КонецОбласти
		
	ИначеЕсли ДанныеРасшифровки.ШаблонРасшифровки = "СбербанкПР" Тогда
		
		#Область Сбербанк_ПР
		
		ШаблонПараметр = ДобавитьШаблонОбластиСтраницыExcel("ПараметрСбербанкПР_П7", ШаблонТитульнойСтраницы);
		ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонПараметр);
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
			ОбластьВставки, "ЗначениеПараметра",
			"=" + СтраницаРасчета.КлючевыеЯчейки["ВознаграждениеКОплате"].Address(Ложь, Ложь, , Истина));
		
		#КонецОбласти
		
	ИначеЕсли СтрНачинаетсяС(ДанныеРасшифровки.ШаблонРасшифровки, "Сургутнефтегаз") Тогда
		
		#Область Сургутнефтегаз
		
		ОбластьТело = ВывестиТелоТитульнойСтраницыExcel(ДанныеРасшифровки, Расшифровка);
		
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
			ОбластьТело, "ВознаграждениеКОплате",
			"=" + СтраницаРасчета.КлючевыеЯчейки["ВознаграждениеКОплате"].Address(Ложь, Ложь, , Истина));
		
		#КонецОбласти
		
	ИначеЕсли ДанныеРасшифровки.ШаблонРасшифровки = "2023"
		Или ДанныеРасшифровки.ШаблонРасшифровки = "2024"
	Тогда
		#Область Стандартный_2023_2024
		
		// Шапка
		ФормулаСуммыВознагражденийЗаУправление	= ФормулаСуммыРассчитанныхВознагражденийЗаУправление(Расшифровка, ДанныеРасшифровки, Истина);
		ФормулаСуммыВознагражденийЗаУспех		= ФормулаСуммыРассчитанныхВознагражденийЗаУспех(Расшифровка, ДанныеРасшифровки, Истина);
		
		ВключаяРасшифровку = ЗначениеЗаполнено(ФормулаСуммыВознагражденийЗаУспех) И ЗначениеЗаполнено(ФормулаСуммыВознагражденийЗаУправление);
		ИмяШаблонаШапкиИтоговогоРасчета = ?(ВключаяРасшифровку, "ИтоговыйРасчетСРасшифровкойШапка<Год>", "ИтоговыйРасчетШапка<Год>");
		ШаблонШапкиИтоговогоРасчета = ПолучитьИменованныйДиапазонExcelПоГодовомуШаблону(
			ШаблонТитульнойСтраницы, ИмяШаблонаШапкиИтоговогоРасчета, ДанныеРасшифровки.ШаблонРасшифровки);
		
		ОбластьШапка = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонШапкиИтоговогоРасчета);
		
		Если ДанныеРасшифровки.ШаблонРасшифровки = "2023" Тогда
