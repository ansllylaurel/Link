	СтраницаРасчета.ВсегоСтрок = СтраницаРасчета.ВсегоСтрок + 2;			

	ОбластьДвиженияАктивов = Новый Структура;
	ОбластьДвиженияАктивов.Вставить("СуффиксПоказателей",	СуффиксПоказателей);
