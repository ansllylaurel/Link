				"СтавкаРазницаИДиСВП",
				Формат(РасшифровкаРасчетаПоБазе.СтавкаРазницаИДиСВП, "ЧН=0; ЧГ=; ЧФ=Ч%"));
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
