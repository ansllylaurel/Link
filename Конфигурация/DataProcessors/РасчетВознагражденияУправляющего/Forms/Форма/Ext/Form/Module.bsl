				ЛистExcel = НоваяКнигаExcel.Worksheets(Счетчик);
				ЛистExcel.Activate();
				xlCellTypeFormulas = -4123;
				
				Попытка
					Диапазон = ЛистExcel.Cells.SpecialCells(xlCellTypeFormulas);
				Исключение
					Продолжить;
				КонецПопытки;
				
				Если Диапазон.Count > 0 Тогда
					Для Каждого Ячейка Из Диапазон.Areas Цикл
						Ячейка.Value = Ячейка.Value;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			
			// Удаление листов "Титульная страница" и "Расчет"
			Попытка
				НоваяКнигаExcel.Worksheets("Титульная страница").Delete();
				НоваяКнигаExcel.Worksheets("Расчет").Delete();
			Исключение
				Сообщить(ОписаниеОшибки());
				Сообщить("Не удалось удалить страницу расчётов по счёту: "
					+ ДанныеРасшифровки.СчетДоверительногоУправления + " на " + ОбщиеПараметрыЗаполнения.ПредставлениеПериода);
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	#КонецОбласти
	
	// Закрытие шаблона и подготовка отчёта к просмотру
	КнигаШаблонаExcel.Close(Ложь);
	
	ИмяФайла = СтрШаблон("Расчет вознаграждения '%1' за %2.xlsx", ДанныеРасшифровки.СчетДоверительногоУправления, ОбщиеПараметрыЗаполнения.ПредставлениеПериода);
	
	Если ОткрытьБезСохранения Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьПараметрыПриложения(ExcelApp, , , ИмяФайла);
	Иначе
		ПутьКФайлу = КаталогВременныхФайлов() + ИмяФайла;
		xlOpenXMLWorkbook = 51; // Книга Open XML (*.xlsx), она же xlWorkbookDefault
		
		НоваяКнигаExcel.SaveAs(ПутьКФайлу, xlOpenXMLWorkbook);
		НоваяКнигаExcel.Close();
		
		ExcelApp.Workbooks.Add(ПутьКФайлу);
		
		УдалитьФайлы(ПутьКФайлу);
	КонецЕсли;
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьПараметрыИнтерактивностиПриложения(ExcelApp, Истина, Истина, Истина, Истина);
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьПараметрыПриложения(ExcelApp, Истина, "Развернуто");
КонецПроцедуры

&НаКлиенте
Функция ДобавитьОписаниеСтраницыExcel(ИмяСтраницы, СтруктураРасшифровки, НоваяСтраница = Истина, ВставитьВНачало = Ложь)  
	
	// Создаем или запоминаем страницу	
	
	Если НоваяСтраница Тогда

		// Ищем свободное имя страницы
		
		НомерСтраницы = 0;
		Пока СтруктураРасшифровки.ПараметрыЛистов[ИмяСтраницы + Формат(НомерСтраницы, "ЧФ=' Ч'")] <> Неопределено Цикл
			НомерСтраницы = ?(НомерСтраницы = 0, 2, НомерСтраницы + 1);	 
		КонецЦикла;
		ИмяСтраницы = ИмяСтраницы + Формат(НомерСтраницы, "ЧФ=' Ч'");
		
		// Добавляем страницу
		
		ПерваяСтраница = (СтруктураРасшифровки.ПараметрыЛистов.Количество() = 0);
		
		Если ПерваяСтраница Тогда
			
			СтраницаExcel = СтруктураРасшифровки.Книга.Sheets(1);
			СтраницаExcel.Name = ИмяСтраницы;
			
		Иначе
			
			Если ВставитьВНачало Тогда
				СтраницаExcel = СтруктураРасшифровки.Книга.Sheets.Add(СтруктураРасшифровки.Книга.Sheets(1));
			Иначе
				СтраницаExcel = СтруктураРасшифровки.Книга.Sheets.Add(, СтруктураРасшифровки.Книга.Sheets(СтруктураРасшифровки.Книга.Sheets.Count));
			КонецЕсли;
			
			СтраницаExcel.Name = ИмяСтраницы;
			
		КонецЕсли;
		
	Иначе
		
		СтраницаExcel = СтруктураРасшифровки.Книга.Sheets(ИмяСтраницы);
		
	КонецЕсли;
	
	// Добавляем описание страницы
	
	ОписаниеСтраницы = Новый Структура("Страница, Области, КлючевыеЯчейки, ВсегоСтрок, ВсегоСтолбцов", СтраницаExcel, Новый Соответствие, Новый Соответствие, 0, 0); 	
	
	СтруктураРасшифровки.ПараметрыЛистов.Вставить(ИмяСтраницы, ОписаниеСтраницы);
	
	Возврат ОписаниеСтраницы;	
	
КонецФункции

&НаКлиенте
Функция ДобавитьШаблонОбластиСтраницыExcel(ИмяШаблонаОбласти, ОписаниеСтраницы, РассчитатьВысотуОбластиШаблона = Истина)
	ОбластьШаблона = ПолучитьИменованныйДиапазонExcel(ОписаниеСтраницы, ИмяШаблонаОбласти);
	Если ОбластьШаблона = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОписаниеШаблона = Новый Структура("Область, Высота", ОбластьШаблона);
	Если РассчитатьВысотуОбластиШаблона Тогда
		ОписаниеШаблона.Высота = ОбластьШаблона.Rows.Count;
	КонецЕсли;
	
	ОписаниеСтраницы.Области.Вставить(ИмяШаблонаОбласти, ОписаниеШаблона);
	
	Возврат ОписаниеШаблона;
КонецФункции

// Получение области шаблона по годовому шаблону.
//	Если в качестве года был передан шаблон расшифровки с текстом, он будет обработан стандаартным методом.
//
// Параметры:
//	ИмяШаблонаОбласти - Строка - шаблон имени области, обязательно включающий в себя "<Год>"
//	Год - Число, Строка - год для подстановки в шаблон
//	ОписаниеСтраницы - Структура
//	РассчитатьВысотуОбластиШаблона - Булево
//
// Возвращаемое значение:
//	Структура - описание шаблона
&НаКлиенте
Функция ДобавитьШаблонОбластиСтраницыExcelПоГодовомуШаблону(ИмяШаблонаОбласти, Знач Год, ОписаниеСтраницы, РассчитатьВысотуОбластиШаблона = Истина)
	Если СтрНайти(ИмяШаблонаОбласти, "<Год>") = 0 Тогда
		ВызватьИсключение "В имени шаблона области """ + ИмяШаблонаОбласти + """ отсутствует шаблонный параметр <Год>.";
	КонецЕсли;
	
	Год = Строка(Год);
	ЭтоГод = Ложь;
	ОписаниеШаблона = Неопределено;
	// 2024 год
	Если Год = "2024" Тогда
		ЭтоГод = Истина;
		ОписаниеШаблона = ДобавитьШаблонОбластиСтраницыExcel(СтрЗаменить(ИмяШаблонаОбласти, "<Год>", "2024"), ОписаниеСтраницы, РассчитатьВысотуОбластиШаблона);
	КонецЕсли;
	// 2023 год
	Если Год = "2023" Или ЭтоГод И ОписаниеШаблона = Неопределено Тогда
		ЭтоГод = Истина;
		ОписаниеШаблона = ДобавитьШаблонОбластиСтраницыExcel(СтрЗаменить(ИмяШаблонаОбласти, "<Год>", "2023"), ОписаниеСтраницы, РассчитатьВысотуОбластиШаблона);
	КонецЕсли;
	// Для остальных шаблонов (в том числе и не по годам)
	Если ОписаниеШаблона = Неопределено И Не ЭтоГод Тогда
		ОписаниеШаблона = ДобавитьШаблонОбластиСтраницыExcel(СтрЗаменить(ИмяШаблонаОбласти, "<Год>", Год), ОписаниеСтраницы, РассчитатьВысотуОбластиШаблона);
	КонецЕсли;
	
	Возврат ОписаниеШаблона;
КонецФункции

&НаКлиенте
Функция ПолучитьИменованныйДиапазонExcel(ОписаниеЛистаExcel, ИмяДиапазона)
	Если ТипЗнч(ОписаниеЛистаExcel) = Тип("Структура") Тогда
		СтраницаExcel = ОписаниеЛистаExcel.Страница;
	Иначе
		СтраницаExcel = ОписаниеЛистаExcel;
	КонецЕсли;
	
	// Проверить наличие ключа в коллекции VB нельзя...
	Попытка
		ИменованныйДиапазон = СтраницаExcel.Range(ИмяДиапазона);
		Возврат ИменованныйДиапазон;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Получение именованного диапазона по годовому шаблону.
//	Если в качестве года был передан шаблон расшифровки с текстом, он будет обработан стандаартным методом.
//
// Параметры:
//	ОписаниеЛистаExcel - Структура, COMОбъект
//	ИмяДиапазона - Строка - шаблон имени области, обязательно включающий в себя "<Год>"
//	Год - Число, Строка - год для подстановки в шаблон
//
// Возвращаемое значение:
//	COMОбъект - именованный диапазон
&НаКлиенте
Функция ПолучитьИменованныйДиапазонExcelПоГодовомуШаблону(ОписаниеЛистаExcel, ИмяДиапазона, Знач Год)
	Если СтрНайти(ИмяДиапазона, "<Год>") = 0 Тогда
		ВызватьИсключение "В имени именованного диапазона """ + ИмяДиапазона + """ отсутствует шаблонный параметр <Год>.";
	КонецЕсли;
	
	Год = Строка(Год);
	ЭтоГод = Ложь;
	ИменованныйДиапазон = Неопределено;
	// 2024 год
	Если Год = "2024" Тогда
		ЭтоГод = Истина;
		ИменованныйДиапазон = ПолучитьИменованныйДиапазонExcel(ОписаниеЛистаExcel, СтрЗаменить(ИмяДиапазона, "<Год>", "2024"));
	КонецЕсли;
	// 2023 год
	Если Год = "2023" Или ЭтоГод И ИменованныйДиапазон = Неопределено Тогда
		ЭтоГод = Истина;
		ИменованныйДиапазон = ПолучитьИменованныйДиапазонExcel(ОписаниеЛистаExcel, СтрЗаменить(ИмяДиапазона, "<Год>", "2023"));
	КонецЕсли;
	// Для остальных шаблонов (в том числе и не по годам)
	Если ИменованныйДиапазон = Неопределено И Не ЭтоГод Тогда
		ИменованныйДиапазон = ПолучитьИменованныйДиапазонExcel(ОписаниеЛистаExcel, СтрЗаменить(ИмяДиапазона, "<Год>", Год));
	КонецЕсли;
	
	Возврат ИменованныйДиапазон;
КонецФункции

&НаКлиенте
Функция ПолучитьОбластьАктаExcel(ExcelApp, Расшифровка, ДанныеРасшифровки, ШаблонСтраницыАкта, ОбщийАкт, ПрефиксШаблонаАкта)
	
	СтраницаАкта = ?(ОбщийАкт, Расшифровка.Результат.ПараметрыЛистов["Акт"], Неопределено); 
	Если СтраницаАкта = Неопределено Тогда
		СтраницаАкта = ДобавитьОписаниеСтраницыExcel("Акт", Расшифровка.Результат, Истина, Истина);
	КонецЕсли;
				
	ОбластьВставки = ?(ОбщийАкт, СтраницаАкта.Области.Получить("Акт"), Неопределено);
	Если ОбластьВставки = Неопределено Тогда
		
		ШаблонАкта = ПолучитьИменованныйДиапазонExcel(ШаблонСтраницыАкта, ПрефиксШаблонаАкта + ДанныеРасшифровки.ШаблонАкта);
		Если ШаблонАкта = Неопределено Тогда
			ШаблонАкта = ПолучитьИменованныйДиапазонExcel(ШаблонСтраницыАкта, "Акт" + ДанныеРасшифровки.ШаблонАкта);
			Если ШаблонАкта = Неопределено Тогда
				ШаблонАкта = ПолучитьИменованныйДиапазонExcel(ШаблонСтраницыАкта, "Акт");
			КонецЕсли;
		КонецЕсли;
		
		ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаАкта, ШаблонАкта, Истина, Истина);
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelОчиститьБуферОбмена(ExcelApp);
		
		Если ОбщийАкт Тогда
			СтраницаАкта.Области.Вставить("Акт", ОбластьВставки);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат	ОбластьВставки;
	
КонецФункции

&НаКлиенте
Функция ВывестиИнвестиционныйДоходExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка, СЧАНаНачалоГодаПоБалансу = Ложь, СЧАНаКонецПоБалансу = Ложь, ДвиженияАктивовПоБалансу = Ложь, ОбластьДвиженияАктивов = Неопределено)
	
	СтраницаРасчета			= Расшифровка.Результат.ПараметрыЛистов["Расчет"];
	ШаблонСтраницыРасчета	= Расшифровка.Шаблон.ПараметрыЛистов["Расчет"];
	
	РасчетВВалютеУчета = (ДанныеРасшифровки.ВалютаРасчета = ДанныеРасшифровки.ВалютаУчета);
	
	КорректироватьНаРазницуБалансаИРынка								= (РасшифровкаРасчетаПоБазе.Свойство("КорректироватьНаРазницуБалансаИРынка") И РасшифровкаРасчетаПоБазе.КорректироватьНаРазницуБалансаИРынка);
	УменьшатьНаСуммуУбыткаЗаПредыдущийОтчетныйПериод					= (РасшифровкаРасчетаПоБазе.Свойство("УменьшатьНаСуммуУбыткаЗаПредыдущийОтчетныйПериод") И РасшифровкаРасчетаПоБазе.УменьшатьНаСуммуУбыткаЗаПредыдущийОтчетныйПериод);
	УменьшатьНаСуммуВознагражденияЗаУправление							= (РасшифровкаРасчетаПоБазе.Свойство("УменьшатьНаСуммуВознагражденияЗаУправление") И РасшифровкаРасчетаПоБазе.УменьшатьНаСуммуВознагражденияЗаУправление);
	УменьшатьНаСуммуНеобходимыхРасходовИСтоимостьУслугСпецдепозитария	= (РасшифровкаРасчетаПоБазе.Свойство("УменьшатьНаСуммуНеобходимыхРасходовИСтоимостьУслугСпецдепозитария") И РасшифровкаРасчетаПоБазе.УменьшатьНаСуммуНеобходимыхРасходовИСтоимостьУслугСпецдепозитария);
	СкорректированныйИнвестиционныйДоход								= КорректироватьНаРазницуБалансаИРынка Или УменьшатьНаСуммуУбыткаЗаПредыдущийОтчетныйПериод Или УменьшатьНаСуммуВознагражденияЗаУправление Или УменьшатьНаСуммуНеобходимыхРасходовИСтоимостьУслугСпецдепозитария;
	
	КлиентФизЛицо = ДанныеРасшифровки.ВидДоговораДоверительногоУправления = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица")
		Или ДанныеРасшифровки.ВидДоговораДоверительногоУправления = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет");
		
	Если КлиентФизЛицо Тогда
		#Область Исключение_при_параметрах_не_реализованных_для_расшифровки_расчета_ИД_физлица
		
		ПараметрыИД = Новый Массив;
		
		Если КорректироватьНаРазницуБалансаИРынка Тогда
			ПараметрыИД.Добавить("КорректироватьНаРазницуБалансаИРынка");
		КонецЕсли;
		
		Если УменьшатьНаСуммуУбыткаЗаПредыдущийОтчетныйПериод Тогда
			ПараметрыИД.Добавить("УменьшатьНаСуммуУбыткаЗаПредыдущийОтчетныйПериод");
		КонецЕсли;
		
		Если УменьшатьНаСуммуНеобходимыхРасходовИСтоимостьУслугСпецдепозитария Тогда
			ПараметрыИД.Добавить("УменьшатьНаСуммуНеобходимыхРасходовИСтоимостьУслугСпецдепозитария");
		КонецЕсли;
		
		Если ПараметрыИД.Количество() > 0 Тогда
			ВызватьИсключение СтрШаблон("Обработка параметров ""%1"" при расчете ИД физ.лиц не реализована. Необходимо обратиться к разработчикам.", СтрСоединить(ПараметрыИД, """, """));
		КонецЕсли;
		
		#КонецОбласти
	КонецЕсли;
	
	// Получаем суффикс инвестиционного дохода
	#Область ОписаниеСуффиксаИнвестиционногоДохода
	// Суффикс состоит из частей. Каждая часть не обязательна, но их порядок сохраняется. Плюс означает возможность дополнения части суффикса.
	//	Суффикс является дополнением к полному названию области - "ИнвестиционныйДоход".
	//	Части суффикса:
	//		1. [ФизЛица] (только для клиентов физ. лиц)
	//		2. [Скорректированный] + [НаВознаграждениеЗаУправление]
	//		3. Только один из следующих суффиксов:
	//			- [Баланс] + [ХантыМансийский]
	//			- [Рынок]
	//			- [_СЧАНаКонецБаланс] + [ХантыМансийский]
	#КонецОбласти
	СуффиксИнвестиционногоДохода = "";
	
	Если КлиентФизЛицо Тогда
		СуффиксИнвестиционногоДохода = СуффиксИнвестиционногоДохода + "ФизЛица";
	КонецЕсли;
	
	Если СкорректированныйИнвестиционныйДоход Тогда
		СуффиксИнвестиционногоДохода = СуффиксИнвестиционногоДохода + "Скорректированный";
		
		Если УменьшатьНаСуммуВознагражденияЗаУправление Тогда
			СуффиксИнвестиционногоДохода = СуффиксИнвестиционногоДохода + "НаВознаграждениеЗаУправление";
		КонецЕсли;
	КонецЕсли;
	
	Если СЧАНаНачалоГодаПоБалансу И СЧАНаКонецПоБалансу И ДвиженияАктивовПоБалансу Тогда // Все по балансу
		СуффиксИнвестиционногоДохода = СуффиксИнвестиционногоДохода + "Баланс";
		Если СтрНачинаетсяС(ДанныеРасшифровки.ШаблонРасшифровки, "ХантыМансийский") Тогда
			СуффиксИнвестиционногоДохода = СуффиксИнвестиционногоДохода + "ХантыМансийский";
		КонецЕсли;
	ИначеЕсли Не СЧАНаНачалоГодаПоБалансу И Не СЧАНаКонецПоБалансу И Не ДвиженияАктивовПоБалансу Тогда // Все по рынку
		СуффиксИнвестиционногоДохода = СуффиксИнвестиционногоДохода + "Рынок";
	ИначеЕсли СЧАНаКонецПоБалансу Тогда // Вразнобой (СЧАНаКонецПоБалансу)
		СуффиксИнвестиционногоДохода = СуффиксИнвестиционногоДохода + "_СЧАНаКонецБаланс";
		Если СтрНачинаетсяС(ДанныеРасшифровки.ШаблонРасшифровки, "ХантыМансийский") Тогда
			СуффиксИнвестиционногоДохода = СуффиксИнвестиционногоДохода + "ХантыМансийский";
		КонецЕсли;
	КонецЕсли;
	
	СуффиксСЧАНаНачалоГода	= ?(СЧАНаНачалоГодаПоБалансу, "Баланс", "Рынок");
	СуффиксСЧАНаКонец		= ?(СЧАНаКонецПоБалансу, "Баланс", "Рынок");
	СуффиксДвиженияАктивов	= ?(ДвиженияАктивовПоБалансу, "Баланс", "Рынок");
	
	// Ищем среди ранее выведенных областей
	ОбластьРасчетИнвестДохода = СтраницаРасчета.Области.Получить("ИнвестиционныйДоход" + СуффиксИнвестиционногоДохода);
	Если ОбластьРасчетИнвестДохода <> Неопределено Тогда
		Возврат Новый Структура("Суффикс, Область", СуффиксИнвестиционногоДохода, ОбластьРасчетИнвестДохода);
	КонецЕсли;
	
	Если РасчетВВалютеУчета Тогда
		// Ввод-вывод активов
		Если ОбластьДвиженияАктивов = Неопределено Тогда
			ОбластьДвиженияАктивов = ВывестиДвиженияАктивовExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка, СуффиксДвиженияАктивов, СуффиксСЧАНаНачалоГода);
		КонецЕсли;
		
		Если КорректироватьНаРазницуБалансаИРынка Тогда
			ВывестиДвиженияАктивовExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка,
				?(Не ДвиженияАктивовПоБалансу, "Баланс", "Рынок"), ?(Не СЧАНаНачалоГодаПоБалансу, "Баланс", "Рынок"));
		КонецЕсли;
			
		Если ДанныеРасшифровки.ШаблонРасшифровки = "СбербанкПР" Тогда
			ВывестиРасходыПоУправлению(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка);
		КонецЕсли;
	Иначе
		// Ввод-вывод активов
		Если ОбластьДвиженияАктивов = Неопределено Тогда
			ОбластьДвиженияАктивов = ВывестиДвиженияАктивовСВалютойРасчетаExcel(
				ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка, СуффиксДвиженияАктивов, СуффиксСЧАНаНачалоГода);
		КонецЕсли;
		
		Если КорректироватьНаРазницуБалансаИРынка Тогда
			ВывестиДвиженияАктивовСВалютойРасчетаExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка,
				?(Не ДвиженияАктивовПоБалансу, "Баланс", "Рынок"), ?(Не СЧАНаНачалоГодаПоБалансу, "Баланс", "Рынок"));
		КонецЕсли;
		
		// Вознаграждение, удержанное ранее
		ВывестиУплаченноеВознаграждениеСВалютойРасчетаExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка);
		
		// Уплаченный НДФЛ
		Если КлиентФизЛицо Тогда
			ВывестиУплаченныйНДФЛСВалютойРасчетаExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка);
		КонецЕсли;
	КонецЕсли;
	
	// Расходы по договору со спецдепозитарием
	Если УменьшатьНаСуммуНеобходимыхРасходовИСтоимостьУслугСпецдепозитария Тогда
		ВывестиРасходыПоДоговоруСоСпецдепозитарием(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка);
	КонецЕсли;
	
	// Расчет инвестиционного дохода
	ШаблонРасчетИнвестДохода = ПолучитьИменованныйДиапазонExcel(ШаблонСтраницыРасчета, "ИнвестиционныйДоход" + СуффиксИнвестиционногоДохода);
	Если ШаблонРасчетИнвестДохода = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Область '%1' не найдена. Необходимо обратиться к разработчикам.", "ИнвестиционныйДоход" + СуффиксИнвестиционногоДохода);
	КонецЕсли;
	ОбластьРасчетИнвестДохода = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонРасчетИнвестДохода, Ложь, Ложь);
	
	Если СкорректированныйИнвестиционныйДоход Тогда
		#Область Заполняем_разницу_баланса_и_рынка_вводов_выводов_активов
		
		Если КорректироватьНаРазницуБалансаИРынка Тогда
			// При расчёте корректировки для старых договоров из вводов нужно убрать первую строку, т.к. там СЧА на начало года
			ДвиженияАктивовРынок	= ?(ДвиженияАктивовПоБалансу, СтраницаРасчета.Области["ДвиженияАктивовРынок"], ОбластьДвиженияАктивов);
			ДвиженияАктивовБаланс	= ?(ДвиженияАктивовПоБалансу, ОбластьДвиженияАктивов, СтраницаРасчета.Области["ДвиженияАктивовБаланс"]);
			
			ФормулаРазницыСтоимостиВводовВыводовАктивовПоБалансуИРынку =
				"=" + СтраницаРасчета.КлючевыеЯчейки["СуммаВводовБаланс"].Address(Ложь, Ложь)
					+ ?(ДанныеРасшифровки.ДоговорЗаключенДоТекущегоГода, "-" + СтраницаРасчета.Страница.Cells(
						ДвиженияАктивовБаланс.НачальнаяСтрока, ДвиженияАктивовБаланс.КолонкаСуммаВвода).Address(Ложь, Ложь), "")
					+ "-" + СтраницаРасчета.КлючевыеЯчейки["СуммаВводовРынок"].Address(Ложь, Ложь)
					+ ?(ДанныеРасшифровки.ДоговорЗаключенДоТекущегоГода, "+" + СтраницаРасчета.Страница.Cells(
						ДвиженияАктивовРынок.НачальнаяСтрока, ДвиженияАктивовРынок.КолонкаСуммаВвода).Address(Ложь, Ложь), "")
					+ "-" + СтраницаРасчета.КлючевыеЯчейки["СуммаВыводовБаланс"].Address(Ложь, Ложь)
					+ "+" + СтраницаРасчета.КлючевыеЯчейки["СуммаВыводовРынок"].Address(Ложь, Ложь);
			
			СтраницаРасчета.КлючевыеЯчейки.Вставить(
				"РазницаСтоимостиВводовВыводовАктивовПоБалансуИРынку",
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(ОбластьРасчетИнвестДохода, "РазницаСтоимостиВводовВыводовАктивовПоБалансуИРынку"));
			СтраницаРасчета.КлючевыеЯчейки["РазницаСтоимостиВводовВыводовАктивовПоБалансуИРынку"].FormulaLocal = ФормулаРазницыСтоимостиВводовВыводовАктивовПоБалансуИРынку;
		Иначе
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
				ОбластьРасчетИнвестДохода,
				"РазницаСтоимостиВводовВыводовАктивовПоБалансуИРынку",
				"<Не учитывается>");
		КонецЕсли;
		
		#КонецОбласти
		
		#Область Заполняем_сумму_убытка_за_предыдущий_отчетный_период
		
		Если УменьшатьНаСуммуУбыткаЗаПредыдущийОтчетныйПериод Тогда
			ФормулаСуммыУбыткаЗаПредыдущийОтчетныйПериод =
				?(РасшифровкаРасчетаПоБазе.СуммаУбыткаЗаПредыдущийГод = NULL, "=НД()", РасшифровкаРасчетаПоБазе.СуммаУбыткаЗаПредыдущийГод);
			
			СтраницаРасчета.КлючевыеЯчейки.Вставить(
				"СуммаУбыткаЗаПредыдущийОтчетныйПериод",
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(ОбластьРасчетИнвестДохода, "СуммаУбыткаЗаПредыдущийОтчетныйПериод"));
			СтраницаРасчета.КлючевыеЯчейки["СуммаУбыткаЗаПредыдущийОтчетныйПериод"].FormulaLocal = ФормулаСуммыУбыткаЗаПредыдущийОтчетныйПериод;
		Иначе
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
				ОбластьРасчетИнвестДохода,
				"СуммаУбыткаЗаПредыдущийОтчетныйПериод",
				"<Не учитывается>");
		КонецЕсли;
		
		#КонецОбласти
		
		#Область Заполняем_сумму_вознаграждения_за_управление
		
		Если УменьшатьНаСуммуВознагражденияЗаУправление Тогда
			Если СтраницаРасчета.КлючевыеЯчейки["СуммаВознагражденияЗаУправление"] = Неопределено Тогда
				ФормулаСуммыВознагражденийЗаУправление = ФормулаСуммыРассчитанныхВознагражденийЗаУправление(Расшифровка, ДанныеРасшифровки);
				
				Если ПустаяСтрока(ФормулаСуммыВознагражденийЗаУправление) Тогда
					ФормулаСуммыВознаграждений = "НД()";
				КонецЕсли;
				
				СтраницаРасчета.КлючевыеЯчейки.Вставить(
					"СуммаВознагражденияЗаУправление",
					РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(ОбластьРасчетИнвестДохода, "ВознаграждениеЗаУправление"));
				СтраницаРасчета.КлючевыеЯчейки["СуммаВознагражденияЗаУправление"].FormulaLocal = "=" + ФормулаСуммыВознагражденийЗаУправление;
			Иначе
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
					ОбластьРасчетИнвестДохода,
					"ВознаграждениеЗаУправление",
					"=" + СтраницаРасчета.КлючевыеЯчейки["СуммаВознагражденияЗаУправление"].Address(Ложь, Ложь));
			КонецЕсли;
		Иначе
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьРасчетИнвестДохода, "ВознаграждениеЗаУправление", "<Не учитывается>");
		КонецЕсли;
		
		#КонецОбласти
		
		#Область Заполняем_сумму_расходов_по_договору_со_спецдепозитарием
		
		Если УменьшатьНаСуммуНеобходимыхРасходовИСтоимостьУслугСпецдепозитария Тогда
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
				ОбластьРасчетИнвестДохода,
				"РасходыПоДоговоруСоСпецдепозитарием",
				"=" + СтраницаРасчета.КлючевыеЯчейки["РасходыПоДоговоруСоСпецдепозитариемВВалютеРасчета"].Address(Ложь, Ложь));
		Иначе
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
				ОбластьРасчетИнвестДохода,
				"РасходыПоДоговоруСоСпецдепозитарием",
				"<Не учитывается>");
		КонецЕсли;
		
		#КонецОбласти
		
		ЯчейкаИДДоКорректировки	= СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, ?(КлиентФизЛицо, "H", "G"));
		ЯчейкаИД				= СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, ?(КлиентФизЛицо, "J", "L"));
		
		СтраницаРасчета.КлючевыеЯчейки.Вставить("ИнвестиционныйДоход" + СуффиксИнвестиционногоДохода + "_ДоКорректировки", ЯчейкаИДДоКорректировки);
		СтраницаРасчета.КлючевыеЯчейки.Вставить("ИнвестиционныйДоход" + СуффиксИнвестиционногоДохода, ЯчейкаИД);
		
	Иначе
		// Поиск ячейки с формулой инвестиционного дохода
		КодНачальногоСимвола = КодСимвола("G");
		КодКонечногоСимвола = КодСимвола("Z");
		КодТекущегоСимвола = КодНачальногоСимвола;
		Пока КодТекущегоСимвола <= КодКонечногоСимвола Цикл
			ТекстЗаголовкаТаблицы = СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок - 1, Символ(КодТекущегоСимвола)).Text;
			Если СтрНачинаетсяС(ТекстЗаголовкаТаблицы, "Расходы ФОНДА") Тогда
				СтраницаРасчета.КлючевыеЯчейки.Вставить("РасходыФонда",
					СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, Символ(КодТекущегоСимвола)));
			ИначеЕсли СтрНачинаетсяС(ТекстЗаголовкаТаблицы, "Инвестиционный доход") Тогда
				Прервать;
			КонецЕсли;
			КодТекущегоСимвола = КодТекущегоСимвола + 1;
		КонецЦикла;
		Если КодТекущегоСимвола > КодКонечногоСимвола Тогда
			ВызватьИсключение "Не найдена ячейка с формулой инвестиционного дохода в шаблоне Excel.";
		КонецЕсли;
		СтраницаРасчета.КлючевыеЯчейки.Вставить("ИнвестиционныйДоход" + СуффиксИнвестиционногоДохода,
			СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, Символ(КодТекущегоСимвола)));
	КонецЕсли;
	
	СтраницаРасчета.КлючевыеЯчейки.Вставить("СЧАНаКонец" + СуффиксСЧАНаКонец, РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(ОбластьРасчетИнвестДохода, "СЧА"));
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
		ОбластьРасчетИнвестДохода, "СЧА",
		Формат(РасшифровкаРасчетаПоБазе.СЧАНаКонец, "ЧДЦ=2; ЧРД=,; ЧГ="));
	
	Если СтраницаРасчета.КлючевыеЯчейки["СЧАНаНачалоГода" + СуффиксСЧАНаНачалоГода] = Неопределено Тогда
		СтраницаРасчета.КлючевыеЯчейки.Вставить(
			"СЧАНаНачалоГода" + СуффиксСЧАНаНачалоГода,
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelНайтиОбластьПоПараметру(ОбластьРасчетИнвестДохода, "СЧАНаНачалоГода"));
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
			ОбластьРасчетИнвестДохода,
			"СЧАНаНачалоГода",
			?(ДанныеРасшифровки.ДоговорЗаключенДоТекущегоГода, Формат(РасшифровкаРасчетаПоБазе.СЧАНаНачалоГода, "ЧДЦ=2; ЧРД=,; ЧГ="), ""));
	Иначе
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
			ОбластьРасчетИнвестДохода,
			"СЧАНаНачалоГода",
			"=" + СтраницаРасчета.КлючевыеЯчейки["СЧАНаНачалоГода" + СуффиксСЧАНаНачалоГода].Address(Ложь, Ложь));
	КонецЕсли;
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
		ОбластьРасчетИнвестДохода,
		"СуммаВводов",
		"=" + СтраницаРасчета.КлючевыеЯчейки["СуммаВводов" + СуффиксДвиженияАктивов].Address(Ложь, Ложь)
			+ "-" + СтраницаРасчета.КлючевыеЯчейки["СЧАНаНачалоГода" + СуффиксСЧАНаНачалоГода].Address(Ложь, Ложь));
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
		ОбластьРасчетИнвестДохода,
		"СуммаВыводов",
		"=" + СтраницаРасчета.КлючевыеЯчейки["СуммаВыводов" + СуффиксДвиженияАктивов].Address(Ложь, Ложь));
	
	Если СтраницаРасчета.КлючевыеЯчейки["ВознаграждениеУплаченное"] = Неопределено Тогда
		СтраницаРасчета.КлючевыеЯчейки.Вставить(
			"ВознаграждениеУплаченное",
