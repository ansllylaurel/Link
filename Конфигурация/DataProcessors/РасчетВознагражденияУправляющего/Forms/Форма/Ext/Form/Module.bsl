			"=" + СтраницаРасчета.КлючевыеЯчейки["СЧАНаКонец" + СуффиксСЧАНаКонец].Address(Ложь, Ложь, , Истина));
		// Сумма выводов
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "СуммаВыводов",
			"=" + СтраницаРасчета.КлючевыеЯчейки["СуммаВыводов" + СуффиксДвиженияАктивов].Address(Ложь, Ложь, , Истина));
		// Сумма вводов
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "СуммаВводов", ФормулаСуммыВводовБезСЧА);
		// Расходы фонда
		Если СтраницаРасчета.КлючевыеЯчейки["РасходыФонда"] <> Неопределено Тогда
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "РасходыФонда",
				"=" + СтраницаРасчета.КлючевыеЯчейки["РасходыФонда"].Address(Ложь, Ложь, , Истина));
		КонецЕсли;
		#КонецОбласти
		
	ИначеЕсли СтрНачинаетсяС(ДанныеРасшифровки.ШаблонРасшифровки, "ЦКМГПУ") Тогда
				
		#Область ЦКМГПУ
		
		ОбластьТело = ВывестиТелоТитульнойСтраницыExcel(ДанныеРасшифровки, Расшифровка);
		
		ФормулаСуммыВводовБезСЧА =
			"=" + СтраницаРасчета.КлючевыеЯчейки["СуммаВводов" + СуффиксДвиженияАктивов].Address(Ложь, Ложь, , Истина)
			+ "-" + СтраницаРасчета.КлючевыеЯчейки["СЧАНаНачалоГода" + СуффиксСЧАНаНачалоГода].Address(Ложь, Ложь, , Истина);
			
		// Инвестиционный доход
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "ИнвестиционныйДоход",
			"=" + СтраницаРасчета.КлючевыеЯчейки["ИнвестиционныйДоход" + СуффиксИнвестиционногоДохода].Address(Ложь, Ложь, , Истина));
		// СЧА на начало года
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "СЧАНаНачалоГода",
			"=" + СтраницаРасчета.КлючевыеЯчейки["СЧАНаНачалоГода" + СуффиксСЧАНаНачалоГода].Address(Ложь, Ложь, , Истина));
		// СЧА
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "СЧА",
			"=" + СтраницаРасчета.КлючевыеЯчейки["СЧАНаКонец" + СуффиксСЧАНаКонец].Address(Ложь, Ложь, , Истина));
		// Сумма выводов
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "СуммаВыводов",
			"=" + СтраницаРасчета.КлючевыеЯчейки["СуммаВыводов" + СуффиксДвиженияАктивов].Address(Ложь, Ложь, , Истина));
		// Сумма вводов
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "СуммаВводов", ФормулаСуммыВводовБезСЧА);
		
		КоличествоДнейПериодаРасчета = 
			(НачалоДня(ДанныеРасшифровки.КонецРасчетногоПериода) - НачалоДня(ДанныеРасшифровки.НачалоРасчетногоПериода)) / (60 * 60 * 24) 
			+ ?(ДанныеРасшифровки.ДоговорЗаключенДоТекущегоГода, 1, 0);
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьТело, "КоличествоДнейПериодаРасчета", КоличествоДнейПериодаРасчета);
		
		#КонецОбласти
		
	Иначе
		
		#Область По_умолчанию
		
		ПрефиксСЧАНаНачалоГода	= ?(СЧАНаНачалоГодаПоБалансу, "Балансовая стоимость имущества", "Рыночная стоимость имущества");
		ПрефиксСЧАНаКонец		= ?(СЧАНаКонецПоБалансу, "Балансовая стоимость имущества", "Рыночная стоимость имущества");
		ПрефиксДвиженияАктивов	= ?(ДвиженияАктивовПоБалансу, "Балансовая стоимость имущества", "Рыночная стоимость имущества");
		
		ШаблонГруппаПоказателей	= ШаблонТитульнойСтраницы.Области["ГруппаПоказателей"];
		ШаблонПоказатель		= ШаблонТитульнойСтраницы.Области["Показатель"];
		
		Если ШаблонГруппаПоказателей <> Неопределено Тогда
			ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонГруппаПоказателей, Ложь, Ложь);
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ГруппаПоказателей",
				?(РасчетВВалютеУчета, "Расчет дохода учредителя управления", "= ""Расчет дохода учредителя управления "" & ПредставлениеВалютыРасчета"));
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ЗначениеПоказателя", "");
		КонецЕсли;
		
		Если ШаблонПоказатель <> Неопределено Тогда
			ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонПоказатель, Ложь, Ложь);	
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "Показатель",			ПрефиксСЧАНаНачалоГода + " на " + Формат(НачалоГода(ДанныеРасшифровки.НачалоРасчетногоПериода), "ДФ='dd.MM.yyyy ''г.'''"));
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ЗначениеПоказателя",	"=" + СтраницаРасчета.КлючевыеЯчейки["СЧАНаНачалоГода" + СуффиксСЧАНаНачалоГода].Address(Ложь, Ложь, , Истина));			
			
			ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонПоказатель, Ложь, Ложь);	
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "Показатель",			ПрефиксДвиженияАктивов + ", принятого в управление");
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ЗначениеПоказателя",	"=" + СтраницаРасчета.КлючевыеЯчейки["СуммаВводов" + СуффиксДвиженияАктивов].Address(Ложь, Ложь, , Истина) + "-" + СтраницаРасчета.КлючевыеЯчейки["СЧАНаНачалоГода" + СуффиксСЧАНаНачалоГода].Address(Ложь, Ложь, , Истина));			
			
			ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонПоказатель, Ложь, Ложь);	
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "Показатель",			ПрефиксДвиженияАктивов + ", выведенного из управления");
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ЗначениеПоказателя",	"=" + СтраницаРасчета.КлючевыеЯчейки["СуммаВыводов" + СуффиксДвиженияАктивов].Address(Ложь, Ложь, , Истина));			
					
			ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонПоказатель, Ложь, Ложь);	
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "Показатель",			ПрефиксСЧАНаКонец + " на расчетную дату");
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ЗначениеПоказателя",	"=" + СтраницаРасчета.КлючевыеЯчейки["СЧАНаКонец" + СуффиксСЧАНаКонец].Address(Ложь, Ложь, , Истина));			
			
			ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонПоказатель, Ложь, Ложь);	
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "Показатель",			"Вознаграждение управляющего, удержанное ранее");
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ЗначениеПоказателя",	"=" + СтраницаРасчета.КлючевыеЯчейки["ВознаграждениеУплаченное"].Address(Ложь, Ложь, , Истина));			
			
			Если КорректироватьНаРазницуБалансаИРынка Тогда
				ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонПоказатель, Ложь, Ложь);	
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "Показатель",			"Разница м/у балансовой и рыночной стоимостью принятых / выведенных активов");
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ЗначениеПоказателя",	"=" + СтраницаРасчета.КлючевыеЯчейки["РазницаСтоимостиВводовВыводовАктивовПоБалансуИРынку"].Address(Ложь, Ложь, , Истина));			
			КонецЕсли;
			
			Если УменьшатьНаСуммуУбыткаЗаПредыдущийОтчетныйПериод Тогда
				ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонПоказатель, Ложь, Ложь);	
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "Показатель",			"Сумма убытка за предыдущий отчетный период");
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ЗначениеПоказателя",	"=" + СтраницаРасчета.КлючевыеЯчейки["СуммаУбыткаЗаПредыдущийОтчетныйПериод"].Address(Ложь, Ложь, , Истина));			
			КонецЕсли;
			
			ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(ТитульнаяСтраница, ШаблонПоказатель, Ложь, Ложь);	
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "Показатель",			"Инвестиционный доход");
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ЗначениеПоказателя",	"=" + СтраницаРасчета.КлючевыеЯчейки["ИнвестиционныйДоход" + СуффиксИнвестиционногоДохода].Address(Ложь, Ложь, , Истина));
		КонецЕсли;
		
		#КонецОбласти
		
	КонецЕсли;
	
	СтраницаРасчета.Области.Вставить("ИнвестиционныйДоход" + СуффиксИнвестиционногоДохода, ОбластьРасчетИнвестДохода);
	
	Возврат Новый Структура("Суффикс, Область", СуффиксИнвестиционногоДохода, ОбластьРасчетИнвестДохода);
КонецФункции

&НаКлиенте
Функция ВывестиДвиженияАктивовExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка, СуффиксПоказателей, СуффиксСЧАНаНачалоГода, РасчетДнейДоДвиженияОтНачалаПериода = Ложь)
	
	СтраницаРасчета			= Расшифровка.Результат.ПараметрыЛистов["Расчет"];
	ШаблонСтраницыРасчета	= Расшифровка.Шаблон.ПараметрыЛистов["Расчет"].Страница;
	
	// Ищем среди ранее выведенных областей
	
	НаименованиеОбласти = "ДвиженияАктивов" + СуффиксПоказателей + ?(РасчетДнейДоДвиженияОтНачалаПериода, "_РасчетДнейДоДвиженияОтНачалаПериода", "");
	
	ОбластьДвиженияАктивов = СтраницаРасчета.Области.Получить(НаименованиеОбласти);
	Если ОбластьДвиженияАктивов <> Неопределено Тогда
		Возврат ОбластьДвиженияАктивов;
	КонецЕсли;
		
	ШаблонШапкиВводВыводАктивов		= ШаблонСтраницыРасчета.Range("ШапкаВводВыводАктивов");	
	ШаблонСтрокиВводВыводАктивов	= ШаблонСтраницыРасчета.Range("СтрокаВводВыводАктивов");	
	ШаблонИтогВводВыводАктивов		= ШаблонСтраницыРасчета.Range("ИтогВводВыводАктивов");	

	ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонШапкиВводВыводАктивов, Ложь, Ложь);  	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "БалансРынок", ?(СуффиксПоказателей = "Рынок", "(по рын. стоимости)", "(по бал. стоимости)"), Истина);  
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ОтНачалаПериодаИлиДоОкончания", ?(РасчетДнейДоДвиженияОтНачалаПериода, "от начала периода", "до окончания"), Истина);  
	
	// Объединяем данные

	ВводыАктивов	= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_ВводыАктивовСНачалаГодаРазвернуто" + ?(СуффиксПоказателей = "Рынок", "", СуффиксПоказателей)];
	ВыводыАктивов	= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_ВыводыАктивовСНачалаГодаРазвернуто"];

	ВводыАктивовВсего	= ВводыАктивов.Количество();
	ВыводыАктивовВсего	= ВыводыАктивов.Количество();
	БудетСтрок			= Макс(ВводыАктивовВсего, ВыводыАктивовВсего);
	БудетКолонок		= 6;
	МассивДанных		= Новый Массив(БудетКолонок, Макс(БудетСтрок, 1));
	ЕстьСЧАНаНачалоГода	= Ложь;

	Для НомерСтроки = 0 По БудетСтрок - 1 Цикл 
		Если НомерСтроки < ВводыАктивовВсего Тогда
			МассивДанных[0][НомерСтроки] = ВводыАктивов[НомерСтроки]["Период"];
			МассивДанных[1][НомерСтроки] = ?(ВводыАктивов[НомерСтроки]["СуммаВВалютеРасчета"] = NULL, "=НД()", ВводыАктивов[НомерСтроки]["СуммаВВалютеРасчета"]);
			Если ВводыАктивов[НомерСтроки]["СЧАНаНачалоГода"] Тогда 
				ЕстьСЧАНаНачалоГода = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если НомерСтроки < ВыводыАктивовВсего Тогда
			МассивДанных[3][НомерСтроки] = ВыводыАктивов[НомерСтроки]["Период"];
			МассивДанных[4][НомерСтроки] = ВыводыАктивов[НомерСтроки]["СуммаВВалютеРасчета" + СуффиксПоказателей];
		КонецЕсли;
	КонецЦикла;

	// Подготоваливаем строки и выводим данные

	НачальнаяСтрокаДвиженияАктивов				 = СтраницаРасчета.ВсегоСтрок + 1;
	ВысотаСтрокиДвиженияАктивов					 = ШаблонСтрокиВводВыводАктивов.Rows.Count; 

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонСтрокиВводВыводАктивов, Ложь, Ложь, ВысотаСтрокиДвиженияАктивов);  	

	Если БудетСтрок > 1 Тогда
		ОбластьЭталон = СтраницаРасчета.Страница.Range(Формат(НачальнаяСтрокаДвиженияАктивов, "ЧРД=,; ЧН=; ЧГ=") + ":" + Формат(НачальнаяСтрокаДвиженияАктивов, "ЧРД=,; ЧН=; ЧГ="));
		Для н = 2 По БудетСтрок Цикл
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelВставитьОбласть(СтраницаРасчета, ОбластьЭталон, , , , ВысотаСтрокиДвиженияАктивов, Ложь);		
		КонецЦикла;
	КонецЕсли;

	КонечнаяСтрокаДвиженияАктивов = СтраницаРасчета.ВсегоСтрок;			

	ОбластьДвиженияАктивов = СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B", КонечнаяСтрокаДвиженияАктивов, "G"));
	ОбластьДвиженияАктивов.FormulaLocal = Новый COMSafeArray(МассивДанных, "VT_VARIANT");
	ОбластьДвиженияАктивов.Rows.Group();

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонИтогВводВыводАктивов, Ложь, Ложь); 

	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, 2).Value2		= Формат(КонецДня(ДанныеРасшифровки.КонецРасчетногоПериода) + 1, "ДФ=dd.MM.yyyy"); // НачалоСледующегоПериода
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, 3).FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, 3, КонечнаяСтрокаДвиженияАктивов, 3) + ")";
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, 6).FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, 6, КонечнаяСтрокаДвиженияАктивов, 6) + ")";	

	СтраницаРасчета.КлючевыеЯчейки.Вставить("СуммаВводов" + СуффиксПоказателей, СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, 3));	
	СтраницаРасчета.КлючевыеЯчейки.Вставить("СуммаВыводов" + СуффиксПоказателей, СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, 6));	

	Если ЕстьСЧАНаНачалоГода Тогда
		СтраницаРасчета.КлючевыеЯчейки.Вставить("СЧАНаНачалоГода" + СуффиксСЧАНаНачалоГода, СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, 3));
	КонецЕсли;

	// Заполняем формулы

	Если РасчетДнейДоДвиженияОтНачалаПериода Тогда
		ФормулаДнейДоВвода	= СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);"""";%1-НачалоПериодаРасчета)", РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, 2));
		ФормулаДнейДоВывода	= СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);"""";%1-НачалоПериодаРасчета)", РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, 5));
	Иначе
		ФормулаДнейДоВвода	= СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);"""";%2-%1)", РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, 2), РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(СтраницаРасчета.ВсегоСтрок, 2, Истина, Истина));
		ФормулаДнейДоВывода	= СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);"""";%2-%1)", РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, 5), РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(СтраницаРасчета.ВсегоСтрок, 2, Истина, Истина));
	КонецЕсли;
	
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, 4);
	ОбластьЭталон.FormulaLocal = ФормулаДнейДоВвода;
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, 4, КонечнаяСтрокаДвиженияАктивов, 4)), ОбластьЭталон);	
	КонецЕсли;	
		
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, 7);
	ОбластьЭталон.FormulaLocal = ФормулаДнейДоВывода;
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, 7, КонечнаяСтрокаДвиженияАктивов, 7)), ОбластьЭталон);
	КонецЕсли;	

	СтраницаРасчета.ВсегоСтрок = СтраницаРасчета.ВсегоСтрок + 2;			

	ОбластьДвиженияАктивов = Новый Структура;
	ОбластьДвиженияАктивов.Вставить("СуффиксПоказателей",				СуффиксПоказателей);
	ОбластьДвиженияАктивов.Вставить("СуффиксСЧАНаНачалоГода",			СуффиксСЧАНаНачалоГода);
	ОбластьДвиженияАктивов.Вставить("НачальнаяСтрока",					НачальнаяСтрокаДвиженияАктивов);
	ОбластьДвиженияАктивов.Вставить("КонечнаяСтрока",					КонечнаяСтрокаДвиженияАктивов);
	ОбластьДвиженияАктивов.Вставить("ВысотаСтроки",						ВысотаСтрокиДвиженияАктивов);
	ОбластьДвиженияАктивов.Вставить("КолонкаДатаВвода",					"B");
	ОбластьДвиженияАктивов.Вставить("КолонкаСуммаВвода",				"C");
	ОбластьДвиженияАктивов.Вставить("КолонкаДнейДоВвода",				"D");
	ОбластьДвиженияАктивов.Вставить("КолонкаДатаВывода",				"E");
	ОбластьДвиженияАктивов.Вставить("КолонкаСуммаВывода",				"F");
	ОбластьДвиженияАктивов.Вставить("КолонкаДнейДоВывода",				"G");	

	СтраницаРасчета.Области.Вставить(НаименованиеОбласти, ОбластьДвиженияАктивов);

	Возврат ОбластьДвиженияАктивов; 	
		
КонецФункции

&НаКлиенте
Функция ВывестиДвиженияАктивовСВалютойРасчетаExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка, СуффиксПоказателей, СуффиксСЧАНаНачалоГода)
	
	СтраницаРасчета			= Расшифровка.Результат.ПараметрыЛистов["Расчет"];
	ШаблонСтраницыРасчета	= Расшифровка.Шаблон.ПараметрыЛистов["Расчет"];
	
	// Ищем среди ранее выведенных областей
	
	ОбластьДвиженияАктивов = СтраницаРасчета.Области.Получить("ДвиженияАктивов" + СуффиксПоказателей);
	Если ОбластьДвиженияАктивов <> Неопределено Тогда
		Возврат ОбластьДвиженияАктивов;
	КонецЕсли;
	
	// Курсы валют
	
	СтраницаКурсовВалют = ВывестиКурсыВалютExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка);	
	
	// Область шапки
	
	ШаблонШапкиВводВыводАктивов		= ШаблонСтраницыРасчета.Страница.Range("ШапкаВводВыводАктивовВалютный");	
	ШаблонСтрокиВводВыводАктивов	= ШаблонСтраницыРасчета.Страница.Range("СтрокаВводВыводАктивовВалютный");	
	ШаблонИтогВводВыводАктивов		= ШаблонСтраницыРасчета.Страница.Range("ИтогВводВыводАктивовВалютный");	

	ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонШапкиВводВыводАктивов, Ложь, Ложь);  	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "БалансРынок", ?(СуффиксПоказателей = "Рынок", "(по рын. стоимости)", "(по бал. стоимости)"), Истина);  
	
	// Подготавливаем данные

	ВводыАктивов	= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_ВводыАктивовСНачалаГодаРазвернуто" + ?(СуффиксПоказателей = "Рынок", "", СуффиксПоказателей)];
	ВыводыАктивов	= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_ВыводыАктивовСНачалаГодаРазвернуто"];

	ВводыАктивовВсего		= ВводыАктивов.Количество();
	ВыводыАктивовВсего		= ВыводыАктивов.Количество();
	БудетСтрок				= Макс(ВводыАктивовВсего, ВыводыАктивовВсего);
	БудетКолонок			= 10;
	МассивДанных			= Новый Массив(БудетКолонок, Макс(БудетСтрок, 1));
	ЕстьСЧАНаНачалоГода		= Ложь;
	
	Для НомерСтроки = 0 По БудетСтрок - 1 Цикл 
		Если НомерСтроки < ВводыАктивовВсего Тогда
			МассивДанных[0][НомерСтроки] = ВводыАктивов[НомерСтроки]["Период"];
			МассивДанных[1][НомерСтроки] = ВводыАктивов[НомерСтроки]["Сумма"];
			МассивДанных[2][НомерСтроки] = Строка(ВводыАктивов[НомерСтроки]["Валюта"]);
			Если ВводыАктивов[НомерСтроки]["СЧАНаНачалоГода"] Тогда 
				ЕстьСЧАНаНачалоГода = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если НомерСтроки < ВыводыАктивовВсего Тогда
			МассивДанных[5][НомерСтроки] = ВыводыАктивов[НомерСтроки]["Период"];
			МассивДанных[6][НомерСтроки] = ВыводыАктивов[НомерСтроки]["Сумма" + СуффиксПоказателей];
			МассивДанных[7][НомерСтроки] = Строка(ВыводыАктивов[НомерСтроки]["Валюта"]);
		КонецЕсли;
	КонецЦикла;

	// Подготоваливаем строки и выводим данные

	НачальнаяСтрокаДвиженияАктивов	= СтраницаРасчета.ВсегоСтрок + 1;
	ВысотаСтрокиДвиженияАктивов		= ШаблонСтрокиВводВыводАктивов.Rows.Count; 

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонСтрокиВводВыводАктивов, Ложь, Ложь, ВысотаСтрокиДвиженияАктивов);  	

	Если БудетСтрок > 1 Тогда
		ОбластьЭталон = СтраницаРасчета.Страница.Range(Формат(НачальнаяСтрокаДвиженияАктивов, "ЧРД=,; ЧН=; ЧГ=") + ":" + Формат(НачальнаяСтрокаДвиженияАктивов, "ЧРД=,; ЧН=; ЧГ="));
		Для н = 2 По БудетСтрок Цикл
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelВставитьОбласть(СтраницаРасчета, ОбластьЭталон, , , , ВысотаСтрокиДвиженияАктивов, Ложь);		
		КонецЦикла;
	КонецЕсли;

	КонечнаяСтрокаДвиженияАктивов = СтраницаРасчета.ВсегоСтрок;			

	ОбластьДвиженияАктивов = СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B", КонечнаяСтрокаДвиженияАктивов, "K"));
	ОбластьДвиженияАктивов.Value2 = Новый COMSafeArray(МассивДанных, "VT_VARIANT");
	ОбластьДвиженияАктивов.Rows.Group();
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонИтогВводВыводАктивов, Ложь, Ложь); 

	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "B").Value2			= Формат(КонецДня(ДанныеРасшифровки.КонецРасчетногоПериода) + 1, "ДФ=dd.MM.yyyy"); // НачалоСледующегоПериода
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "E").FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "E", КонечнаяСтрокаДвиженияАктивов, "E") + ")";
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "J").FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "J", КонечнаяСтрокаДвиженияАктивов, "J") + ")";

	СтраницаРасчета.КлючевыеЯчейки.Вставить("СуммаВводов" + СуффиксПоказателей, СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "E"));
	СтраницаРасчета.КлючевыеЯчейки.Вставить("СуммаВыводов" + СуффиксПоказателей, СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "J"));

	// Сумма ввода в валюте расчета	
	
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "E");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);""""; %2 * ЕСЛИ(%3=ВалютаРасчета;1; ЕСЛИ(%3=""RUB"";1;ВПР(%3 & %1;%4;2;ЛОЖЬ)) / ЕСЛИ(ВалютаРасчета=""RUB"";1;ВПР(ВалютаРасчета & %1;%4;2;ЛОЖЬ))))", 
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "C"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "D"),
		СтраницаКурсовВалют.КлючевыеЯчейки["КурсыВалют"].Address(Истина, Истина, , Истина));  
		
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "E", КонечнаяСтрокаДвиженияАктивов, "E")),
			ОбластьЭталон);	
	КонецЕсли;		
	
	Если ЕстьСЧАНаНачалоГода Тогда
		
		Если СуффиксСЧАНаНачалоГода = "Рынок" Тогда // Дата расчета СЧА по рыночной стоимости отличается от даты ввода
			ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);НД(); %2 * ЕСЛИ(%3=ВалютаРасчета;1; ЕСЛИ(%3=""RUB"";1;ВПР(%3 & %1;%4;2;ЛОЖЬ)) / ЕСЛИ(ВалютаРасчета=""RUB"";1;ВПР(ВалютаРасчета & %1;%4;2;ЛОЖЬ))))", 
				"ДатаРасчетаСЧАНаНачалоГода",
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "C"),
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "D"),
				СтраницаКурсовВалют.КлючевыеЯчейки["КурсыВалют"].Address(Истина, Истина, , Истина));
		КонецЕсли;
		
		СтраницаРасчета.КлючевыеЯчейки.Вставить("СЧАНаНачалоГода" + СуффиксСЧАНаНачалоГода, ОбластьЭталон);	
		
	КонецЕсли;
	
	// Дней от ввода до расчета
	
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "F");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);"""";%2-%1)", 
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(СтраницаРасчета.ВсегоСтрок, "B", Истина, Истина));  
		
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "F", КонечнаяСтрокаДвиженияАктивов, "F")),
			ОбластьЭталон);	
	КонецЕсли;
	
	// Сумма вывода в валюте расчета
	
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "J");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);""""; %2 * ЕСЛИ(%3=ВалютаРасчета;1; ЕСЛИ(%3=""RUB"";1;ВПР(%3 & %1;%4;2;ЛОЖЬ)) / ЕСЛИ(ВалютаРасчета=""RUB"";1;ВПР(ВалютаРасчета & %1;%4;2;ЛОЖЬ))))", 
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "G"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "H"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "I"),
		СтраницаКурсовВалют.КлючевыеЯчейки["КурсыВалют"].Address(Истина, Истина, , Истина));  
		
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "J", КонечнаяСтрокаДвиженияАктивов, "J")),
			ОбластьЭталон);	
	КонецЕсли;	
	
	// Дней от вывода до расчета
	
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "K");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);"""";%2-%1)",
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "G"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(СтраницаРасчета.ВсегоСтрок, "B", Истина, Истина));  
		
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "K", КонечнаяСтрокаДвиженияАктивов, "K")),
			ОбластьЭталон);
	КонецЕсли;	
	
	СтраницаРасчета.ВсегоСтрок = СтраницаРасчета.ВсегоСтрок + 2;			

	ОбластьДвиженияАктивов = Новый Структура;
	ОбластьДвиженияАктивов.Вставить("СуффиксПоказателей",		СуффиксПоказателей);
	ОбластьДвиженияАктивов.Вставить("СуффиксСЧАНаНачалоГода",	СуффиксСЧАНаНачалоГода);
	ОбластьДвиженияАктивов.Вставить("НачальнаяСтрока",			НачальнаяСтрокаДвиженияАктивов);
	ОбластьДвиженияАктивов.Вставить("КонечнаяСтрока",			КонечнаяСтрокаДвиженияАктивов);
	ОбластьДвиженияАктивов.Вставить("ВысотаСтроки",				ВысотаСтрокиДвиженияАктивов);
	ОбластьДвиженияАктивов.Вставить("КолонкаДатаВвода",			"B");
	ОбластьДвиженияАктивов.Вставить("КолонкаСуммаВвода",		"E");
	ОбластьДвиженияАктивов.Вставить("КолонкаДнейДоВвода",		"F");
	ОбластьДвиженияАктивов.Вставить("КолонкаДатаВывода",		"G");
	ОбластьДвиженияАктивов.Вставить("КолонкаСуммаВывода",		"J");
	ОбластьДвиженияАктивов.Вставить("КолонкаДнейДоВывода",		"K");
	
	СтраницаРасчета.Области.Вставить("ДвиженияАктивов" + СуффиксПоказателей, ОбластьДвиженияАктивов);
	
	Возврат ОбластьДвиженияАктивов; 	
		
КонецФункции

&НаКлиенте
Функция ВывестиДвиженияАктивовСБазовойДоходностьюExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка, СуффиксБазовойДоходности, СуффиксСтоимостей)
	
	СтраницаРасчета			= Расшифровка.Результат.ПараметрыЛистов["Расчет"];
	ШаблонСтраницыРасчета	= Расшифровка.Шаблон.ПараметрыЛистов["Расчет"];
	
	// Ищем среди ранее выведенных областей
	
	ОбластьДвиженияАктивов = СтраницаРасчета.Области.Получить("ДвиженияАктивовСБазовойДоходностью" + СуффиксБазовойДоходности + СуффиксСтоимостей);
	Если ОбластьДвиженияАктивов <> Неопределено Тогда
		Возврат ОбластьДвиженияАктивов;
	КонецЕсли;
	
	// Кривая КБД
	
	СтраницаКривой = Расшифровка.Результат.ПараметрыЛистов["G-кривая"];
	
	Если СтраницаКривой = Неопределено Тогда
		
		#Область Страница_кривой_бескупонной_доходности
		
		СтраницаКривой = ДобавитьОписаниеСтраницыExcel("G-кривая", Расшифровка.Результат);
		
		ШаблонСтраницыКривой = Расшифровка.Шаблон.ПараметрыЛистов["G-кривая"]; 
		Если ШаблонСтраницыКривой = Неопределено Тогда
			ШаблонСтраницыКривой = ДобавитьОписаниеСтраницыExcel("G-кривая", Расшифровка.Шаблон, Ложь);
		КонецЕсли;
		
		ШаблонШапкиКривой	= ШаблонСтраницыКривой.Страница.Range("ШапкаКривая");	
		ШаблонСтрокиКривой	= ШаблонСтраницыКривой.Страница.Range("СтрокаКривая");	

		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаКривой, ШаблонШапкиКривой, Истина, Истина);
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelОчиститьБуферОбмена(Расшифровка.ExcelApp);	
		
		ЗначенияКривой = РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_ЗначенияКБД"];

		БудетСтрок			= ЗначенияКривой.Количество();
		БудетКолонок		= 2;
		МассивДанных		= Новый Массив(БудетКолонок, Макс(БудетСтрок, 1));

		Для НомерСтроки = 0 По БудетСтрок - 1 Цикл 
			МассивДанных[0][НомерСтроки] = ЗначенияКривой[НомерСтроки]["Период"];
			МассивДанных[1][НомерСтроки] = ЗначенияКривой[НомерСтроки]["Значение"];
		КонецЦикла;

		// Подготоваливаем строки и выводим данные

		НачальнаяСтрокаЗначений	= СтраницаКривой.ВсегоСтрок + 1;
		ВысотаСтрокиЗначений	= ШаблонСтрокиКривой.Rows.Count; 

		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаКривой, ШаблонСтрокиКривой, Ложь, Ложь, ВысотаСтрокиЗначений);  	

		Если БудетСтрок > 1 Тогда
			ОбластьЭталон = СтраницаКривой.Страница.Range(Формат(НачальнаяСтрокаЗначений, "ЧРД=,; ЧН=; ЧГ=") + ":" + Формат(НачальнаяСтрокаЗначений, "ЧРД=,; ЧН=; ЧГ="));
			Для н = 2 По БудетСтрок Цикл
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelВставитьОбласть(СтраницаКривой, ОбластьЭталон, , , , ВысотаСтрокиЗначений, Ложь);		
			КонецЦикла;
		КонецЕсли;

		КонечнаяСтрокаЗначений = СтраницаКривой.ВсегоСтрок;			

		СтраницаКривой.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаЗначений, "B", КонечнаяСтрокаЗначений, "C")).Value2 = Новый COMSafeArray(МассивДанных, "VT_VARIANT");
		
		#КонецОбласти
		
	КонецЕсли;	
	
	ШаблонШапкиВводВыводАктивов		= ШаблонСтраницыРасчета.Страница.Range("ШапкаВводВыводАктивовСДоходностью");	
	ШаблонСтрокиВводВыводАктивов	= ШаблонСтраницыРасчета.Страница.Range("СтрокаВводВыводАктивовСДоходностью");	
	ШаблонИтогВводВыводАктивов		= ШаблонСтраницыРасчета.Страница.Range("ИтогВводВыводАктивовСДоходностью");	

	ОбластьВставки = РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонШапкиВводВыводАктивов, Ложь, Ложь);  	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "БалансРынок", ?(СуффиксСтоимостей = "Рынок", "(по рын. стоимости)", "(по бал. стоимости)"), Истина);  

	// Объединяем данные

	ВводыАктивов	= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_ВводыАктивовСНачалаГодаРазвернуто" + ?(СуффиксСтоимостей = "Рынок", "", СуффиксСтоимостей)];
	ВыводыАктивов	= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_ВыводыАктивовСНачалаГодаРазвернуто"];

	ВводыАктивовВсего	= ВводыАктивов.Количество();
	ВыводыАктивовВсего	= ВыводыАктивов.Количество();
	БудетСтрок			= Макс(ВводыАктивовВсего, ВыводыАктивовВсего);
	БудетКолонок		= 10;
	МассивДанных		= Новый Массив(БудетКолонок, Макс(БудетСтрок, 1));

	Для НомерСтроки = 0 По БудетСтрок - 1 Цикл 
		Если НомерСтроки < ВводыАктивовВсего Тогда
			МассивДанных[0][НомерСтроки] = ВводыАктивов[НомерСтроки]["Период"];
			МассивДанных[1][НомерСтроки] = ВводыАктивов[НомерСтроки]["СуммаВВалютеРасчета"];
		КонецЕсли;
		
		Если НомерСтроки < ВыводыАктивовВсего Тогда
			МассивДанных[5][НомерСтроки] = ВыводыАктивов[НомерСтроки]["Период"];
			МассивДанных[6][НомерСтроки] = ВыводыАктивов[НомерСтроки]["СуммаВВалютеРасчета" + СуффиксСтоимостей];
		КонецЕсли;
	КонецЦикла;

	// Подготоваливаем строки и выводим данные

	НачальнаяСтрокаДвиженияАктивов	= СтраницаРасчета.ВсегоСтрок + 1;
	ВысотаСтрокиДвиженияАктивов		= ШаблонСтрокиВводВыводАктивов.Rows.Count; 

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонСтрокиВводВыводАктивов, Ложь, Ложь, ВысотаСтрокиДвиженияАктивов);  	

	Если БудетСтрок > 1 Тогда
		ОбластьЭталон = СтраницаРасчета.Страница.Range(Формат(НачальнаяСтрокаДвиженияАктивов, "ЧРД=,; ЧН=; ЧГ=") + ":" + Формат(НачальнаяСтрокаДвиженияАктивов, "ЧРД=,; ЧН=; ЧГ="));
		Для н = 2 По БудетСтрок Цикл
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelВставитьОбласть(СтраницаРасчета, ОбластьЭталон, , , , ВысотаСтрокиДвиженияАктивов, Ложь);		
		КонецЦикла;
	КонецЕсли;

	КонечнаяСтрокаДвиженияАктивов = СтраницаРасчета.ВсегоСтрок;			

	ОбластьДвиженияАктивов = СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B", КонечнаяСтрокаДвиженияАктивов, "K"));
	ОбластьДвиженияАктивов.Value2 = Новый COMSafeArray(МассивДанных, "VT_VARIANT");
	ОбластьДвиженияАктивов.Rows.Group();
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонИтогВводВыводАктивов, Ложь, Ложь); 

	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "B").Value2			= Формат(КонецДня(ДанныеРасшифровки.КонецРасчетногоПериода) + 1, "ДФ=dd.MM.yyyy"); // НачалоСледующегоПериода
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "C").FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "C", КонечнаяСтрокаДвиженияАктивов, "C") + ")";
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "F").FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "F", КонечнаяСтрокаДвиженияАктивов, "F") + ")";
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "H").FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "H", КонечнаяСтрокаДвиженияАктивов, "H") + ")";
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "K").FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "K", КонечнаяСтрокаДвиженияАктивов, "K") + ")";

	СтраницаРасчета.КлючевыеЯчейки.Вставить("СуммаВводов" + СуффиксСтоимостей, СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "C"));
	СтраницаРасчета.КлючевыеЯчейки.Вставить("БазовыйДоходВводов" + СуффиксБазовойДоходности + СуффиксСтоимостей, СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "F"));	
	СтраницаРасчета.КлючевыеЯчейки.Вставить("СуммаВыводов" + СуффиксСтоимостей, СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "H"));
	СтраницаРасчета.КлючевыеЯчейки.Вставить("БазовыйДоходВыводов" + СуффиксБазовойДоходности + СуффиксСтоимостей, СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "K"));	

	// Заполняем формулы

	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "D");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);"""";%2-%1)", 
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(СтраницаРасчета.ВсегоСтрок, "B", Истина, Истина));  
		
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "D", КонечнаяСтрокаДвиженияАктивов, "D")),
			ОбластьЭталон);	
	КонецЕсли;
	
	Если СуффиксБазовойДоходности = "ПоСреднемуЗначениюКБД" Тогда
		ФормулаБазовойДоходности = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1); """"; СРЗНАЧЕСЛИМН(%2; %3; "">="" & ИНДЕКС(%3;ПОИСКПОЗ(%1;%3;1);1); %3; ""<="" & ДАТА(ГОД(%1);12;31)) + %4)",
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B"),
			"'G-кривая'!$C:$C",
			"'G-кривая'!$B:$B",
			Формат(РасшифровкаРасчетаПоБазе.СтавкаОтличиеОтКБД, "ЧН="));
	Иначе
		ФормулаБазовойДоходности = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1); """"; ИНДЕКС(%2;ПОИСКПОЗ(%1;%3;1);1)+%4)",
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B"),
			"'G-кривая'!$C:$C",
			"'G-кривая'!$B:$B",
			Формат(РасшифровкаРасчетаПоБазе.СтавкаОтличиеОтКБД, "ЧН="));
	КонецЕсли;
	
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "E");
	ОбластьЭталон.FormulaLocal = ФормулаБазовойДоходности;
		
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "E", КонечнаяСтрокаДвиженияАктивов, "E")),
			ОбластьЭталон);	
	КонецЕсли;		
	
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "F");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);"""";%2*%3*%4%%/%5)", 
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "C"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "D"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "E"),
		Формат(ДанныеРасшифровки.ДнейВГоду, "ЧРД=,; ЧН=; ЧГ="));  
		
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "F", КонечнаяСтрокаДвиженияАктивов, "F")),
			ОбластьЭталон);	
	КонецЕсли;	
	
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "I");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);"""";%2-%1)",
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "G"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(СтраницаРасчета.ВсегоСтрок, "B", Истина, Истина));  
		
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "I", КонечнаяСтрокаДвиженияАктивов, "I")),
			ОбластьЭталон);
	КонецЕсли;	

	Если СуффиксБазовойДоходности = "ПоСреднемуЗначениюКБД" Тогда
		ФормулаБазовойДоходности = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1); """"; СРЗНАЧЕСЛИМН(%2; %3; "">="" & ИНДЕКС(%3;ПОИСКПОЗ(%1;%3;1);1); %3; ""<="" & ДАТА(ГОД(%1);12;31)) + %4)",
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "G"),
			"'G-кривая'!$C:$C",
			"'G-кривая'!$B:$B",
			Формат(РасшифровкаРасчетаПоБазе.СтавкаОтличиеОтКБД, "ЧН="));
	Иначе
		ФормулаБазовойДоходности = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1); """"; ИНДЕКС(%2;ПОИСКПОЗ(%1;%3;1);1)+%4)",
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "G"),
			"'G-кривая'!$C:$C",
			"'G-кривая'!$B:$B",
			Формат(РасшифровкаРасчетаПоБазе.СтавкаОтличиеОтКБД, "ЧН="));
	КонецЕсли;
		
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "J");
	ОбластьЭталон.FormulaLocal = ФормулаБазовойДоходности;  
		
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "J", КонечнаяСтрокаДвиженияАктивов, "J")),
			ОбластьЭталон);	
	КонецЕсли;	
	
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "K");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);"""";%2*%3*%4%%/%5)", 
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "G"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "H"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "I"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "J"),
		Формат(ДанныеРасшифровки.ДнейВГоду, "ЧРД=,; ЧН=; ЧГ="));  
		
	Если НачальнаяСтрокаДвиженияАктивов <> КонечнаяСтрокаДвиженияАктивов Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelВыполнитьАвтозаполнениеОбласти(
			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "K", КонечнаяСтрокаДвиженияАктивов, "K")),
			ОбластьЭталон);	
	КонецЕсли;	
	
	СтраницаРасчета.ВсегоСтрок = СтраницаРасчета.ВсегоСтрок + 2;			

	ОбластьДвиженияАктивов = Новый Структура;
	ОбластьДвиженияАктивов.Вставить("СуффиксПоказателей",			СуффиксСтоимостей);
	ОбластьДвиженияАктивов.Вставить("НачальнаяСтрока",				НачальнаяСтрокаДвиженияАктивов);
	ОбластьДвиженияАктивов.Вставить("КонечнаяСтрока",				КонечнаяСтрокаДвиженияАктивов);
	ОбластьДвиженияАктивов.Вставить("ВысотаСтроки",					ВысотаСтрокиДвиженияАктивов);
	ОбластьДвиженияАктивов.Вставить("КолонкаДатаВвода",				"B");
	ОбластьДвиженияАктивов.Вставить("КолонкаСуммаВвода",			"C");
	ОбластьДвиженияАктивов.Вставить("КолонкаДнейДоВвода",			"D");
	ОбластьДвиженияАктивов.Вставить("КолонкаБазоваяСтавкаВвода",	"E");
	ОбластьДвиженияАктивов.Вставить("КолонкаБазовыйДоходВвода",		"F");
	ОбластьДвиженияАктивов.Вставить("КолонкаДатаВывода",			"G");
	ОбластьДвиженияАктивов.Вставить("КолонкаСуммаВывода",			"H");
	ОбластьДвиженияАктивов.Вставить("КолонкаДнейДоВывода",			"I");
	ОбластьДвиженияАктивов.Вставить("КолонкаБазоваяСтавкаВывода",	"J");
	ОбластьДвиженияАктивов.Вставить("КолонкаБазовыйДоходВывода",	"K");
	
	СтраницаРасчета.Области.Вставить("ДвиженияАктивовСБазовойДоходностью" + СуффиксБазовойДоходности + СуффиксСтоимостей, ОбластьДвиженияАктивов);
	
	Возврат ОбластьДвиженияАктивов; 	
		
КонецФункции

&НаКлиенте
Функция ВывестиДвиженияАктивовСМинимальнымИГарантированнымДоходомExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка, СуффиксПоказателей)
	
	СтраницаРасчета			= Расшифровка.Результат.ПараметрыЛистов["Расчет"];
	ШаблонСтраницыРасчета	= Расшифровка.Шаблон.ПараметрыЛистов["Расчет"];
	
	// Ищем среди ранее выведенных областей
	
	ОбластьДвиженияАктивов = СтраницаРасчета.Области.Получить("ДвиженияАктивовСМинимальнымДоходом" + СуффиксПоказателей);
	Если ОбластьДвиженияАктивов <> Неопределено Тогда
		Возврат ОбластьДвиженияАктивов; 
	КонецЕсли;
	
	ШаблонШапкиВводВыводАктивов		= ШаблонСтраницыРасчета.Страница.Range("ШапкаВводВыводАктивовСМинимальнымДоходом");	
	ШаблонСтрокиВводВыводАктивов	= ШаблонСтраницыРасчета.Страница.Range("СтрокаВводВыводАктивовСМинимальнымДоходом");	
	ШаблонИтогВводВыводАктивов		= ШаблонСтраницыРасчета.Страница.Range("ИтогВводВыводАктивовСМинимальнымДоходом");	

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонШапкиВводВыводАктивов, Ложь, Ложь);  	

	// Объединяем данные

	ВводыАктивов	= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_ВводыАктивовСНачалаГодаРазвернуто" + ?(СуффиксПоказателей = "Рынок", "", СуффиксПоказателей)];
	ВыводыАктивов	= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_ВыводыАктивовСНачалаГодаРазвернуто"];

	ВводыАктивовВсего	= ВводыАктивов.Количество();
	ВыводыАктивовВсего	= ВыводыАктивов.Количество();
	БудетСтрок			= Макс(ВводыАктивовВсего, ВыводыАктивовВсего);
	БудетКолонок		= 10;
	МассивДанных		= Новый Массив(БудетКолонок, Макс(БудетСтрок, 1));

	Для НомерСтроки = 0 По БудетСтрок - 1 Цикл 
		Если НомерСтроки < ВводыАктивовВсего Тогда
			МассивДанных[0][НомерСтроки] = ВводыАктивов[НомерСтроки]["Период"];
			МассивДанных[1][НомерСтроки] = ВводыАктивов[НомерСтроки]["СуммаВВалютеРасчета"];
		КонецЕсли;
		
		Если НомерСтроки < ВыводыАктивовВсего Тогда
			МассивДанных[5][НомерСтроки] = ВыводыАктивов[НомерСтроки]["Период"];
			МассивДанных[6][НомерСтроки] = ВыводыАктивов[НомерСтроки]["СуммаВВалютеРасчета" + СуффиксПоказателей];
		КонецЕсли;
	КонецЦикла;

	// Подготоваливаем строки и выводим данные

	НачальнаяСтрокаДвиженияАктивов	= СтраницаРасчета.ВсегоСтрок + 1;
	ВысотаСтрокиДвиженияАктивов		= ШаблонСтрокиВводВыводАктивов.Rows.Count; 

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонСтрокиВводВыводАктивов, Ложь, Ложь, ВысотаСтрокиДвиженияАктивов);  	

	Если БудетСтрок > 1 Тогда
		ОбластьЭталон = СтраницаРасчета.Страница.Range(Формат(НачальнаяСтрокаДвиженияАктивов, "ЧРД=,; ЧН=; ЧГ=") + ":" + Формат(НачальнаяСтрокаДвиженияАктивов, "ЧРД=,; ЧН=; ЧГ="));
		Для н = 2 По БудетСтрок Цикл
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelВставитьОбласть(СтраницаРасчета, ОбластьЭталон, , , , ВысотаСтрокиДвиженияАктивов, Ложь);		
		КонецЦикла;
	КонецЕсли;

	КонечнаяСтрокаДвиженияАктивов = СтраницаРасчета.ВсегоСтрок;			
	
	ОбластьДвиженияАктивов = СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B", КонечнаяСтрокаДвиженияАктивов, "K"));
	ОбластьДвиженияАктивов.Value2 = Новый COMSafeArray(МассивДанных, "VT_VARIANT");
	ОбластьДвиженияАктивов.Rows.Group();

	РаботаСВнешнимиСистемамиКлиентСервер.ExcelВывестиОбласть(СтраницаРасчета, ШаблонИтогВводВыводАктивов, Ложь, Ложь); 

	ИсключатьДеньПриемаПередачиАктивовИзУправления = РасшифровкаРасчетаПоБазе.Свойство("ИсключатьДеньПриемаПередачиАктивовИзУправления") И РасшифровкаРасчетаПоБазе.ИсключатьДеньПриемаПередачиАктивовИзУправления;
	
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "B").Value2			= Формат(КонецДня(ДанныеРасшифровки.КонецРасчетногоПериода) + ?(ИсключатьДеньПриемаПередачиАктивовИзУправления, 0, 1), "ДФ=dd.MM.yyyy"); // НачалоСледующегоПериода
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "C").FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "C", КонечнаяСтрокаДвиженияАктивов, "C") + ")";
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "E").FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "E", КонечнаяСтрокаДвиженияАктивов, "E") + ")";
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "F").FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "F", КонечнаяСтрокаДвиженияАктивов, "F") + ")";
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "H").FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "H", КонечнаяСтрокаДвиженияАктивов, "H") + ")";
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "J").FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "J", КонечнаяСтрокаДвиженияАктивов, "J") + ")";
	СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "K").FormulaLocal	= "=СУММ(" + РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "K", КонечнаяСтрокаДвиженияАктивов, "K") + ")";

	СтраницаРасчета.КлючевыеЯчейки.Вставить("СуммаВводов" + СуффиксПоказателей, СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "C"));
	СтраницаРасчета.КлючевыеЯчейки.Вставить("ГарантированныйДоходВводов" + СуффиксПоказателей, СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "E"));	
	СтраницаРасчета.КлючевыеЯчейки.Вставить("МинимальныйДоходВводов" + СуффиксПоказателей, СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "F"));	
	СтраницаРасчета.КлючевыеЯчейки.Вставить("СуммаВыводов" + СуффиксПоказателей, СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "H"));
	СтраницаРасчета.КлючевыеЯчейки.Вставить("ГарантированныйДоходВыводов" + СуффиксПоказателей, СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "J"));	
	СтраницаРасчета.КлючевыеЯчейки.Вставить("МинимальныйДоходВыводов" + СуффиксПоказателей, СтраницаРасчета.Страница.Cells(СтраницаРасчета.ВсегоСтрок, "K"));	

	// Заполняем формулы

	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "D");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1);"""";%2-%1)", 
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(СтраницаРасчета.ВсегоСтрок, "B", Истина, Истина));  
		
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "E");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1); """"; %2 * %3 / %4 * %5)",
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B"),  
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "C"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "D"),
		Формат(ДанныеРасшифровки.ДнейВГоду, "ЧРД=,; ЧН=; ЧГ="),
		"СтавкаГД");
		
	ОбластьЭталон = СтраницаРасчета.Страница.Cells(НачальнаяСтрокаДвиженияАктивов, "F");
	ОбластьЭталон.FormulaLocal = СтрШаблон("=ЕСЛИ(ЕПУСТО(%1); """"; %2 * %3 / %4 * %5)",
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "B"),  
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "C"),
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресЯчейкиСтрокой(НачальнаяСтрокаДвиженияАктивов, "D"),
