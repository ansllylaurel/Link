				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(ОбластьВставки, "ЗначениеПоказателя",	"=" + СтраницаРасчета.КлючевыеЯчейки["СредняяСтоимостьИмущества" + СуффиксПоказателей].Address(Ложь, Ложь, , Истина));			
				
