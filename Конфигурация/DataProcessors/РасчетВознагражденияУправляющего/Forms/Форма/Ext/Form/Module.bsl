		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Печать расчета для формы 482 поддерживается только по одному клиенту. Будет использован первый из выбранных");
		
	КонецЕсли;
	
	РеквизитФормыОбъект = РеквизитФормыВЗначение("Объект");

