
#Область События_формы_и_элементов

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.Организация    = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.ВариантРасчета = 0; // ИИС
	
	Объект.ПериодичностьРасчета	= Перечисления.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально;
	Объект.ВидВознаграждения	= Перечисления.ВидыВознагражденийУправляющего.ВознаграждениеУправляющего;
	
	Объект.ДатаРасчета = ПолучитьДатуРасчета(Объект.ВариантРасчета, Объект.ПериодичностьРасчета);
	
	ОбновитьСоставПечатныхФормНаСервере();
	
	ОбновитьПериодДляПечати(ЭтаФорма, Объект);
	
	Элементы.ВознагражденияУправляющегоСтратегия.Видимость = (Объект.ВариантРасчета = 0);
	
	Элементы.СтраницаВознаграждениеУправляющегоПлатаЗаРазмещение.Видимость = (Объект.ВариантРасчета = 0);
	
	РеквизитыНачисления = ПолучитьЗаполняемыеРеквизитыНачисленияПоУмолчанию(Объект.Организация);
	
	Если Не ЗначениеЗаполнено(Объект.РасчетныйСчет) Тогда
		Объект.РасчетныйСчет = РеквизитыНачисления.РасчетныйСчет;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ПрочиеДоходыИРасходы) Тогда
		Объект.ПрочиеДоходыИРасходы = РеквизитыНачисления.ПрочиеДоходыИРасходы;
	КонецЕсли;
	
	ЭтаФорма.ЗаполнятьДанныеБухгалтерииОбУдержанномВознаграждении = Истина;
	ЭтаФорма.ВыводитьКартинкиВРасшифровке						  = Истина;
	
	Элементы.ГруппаОтбор.Заголовок = ""; // Очищаю здесь, чтобы в конфигураторе был виден заголовок
	
	ЭтаФорма.Модифицированность = Истина;		
	
	// Настройки в зависимости от полных прав
	
	ЭтаФорма.ЭтоПолноправныйПользователь = РаботаСПользователями.ЭтоПолноправныйПользователь();
	
	Элементы.Организация.Видимость        = ЭтаФорма.ЭтоПолноправныйПользователь;
	Элементы.ОрганизацияНадпись.Видимость = Не ЭтаФорма.ЭтоПолноправныйПользователь;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);

	ЭтаФорма.СтруктураДанныхКонтактногоЛица				= Настройки.Получить("СтруктураДанныхКонтактногоЛица");
	ЭтаФорма.СтруктураДанныхКонтактногоЛицаБухгалтера	= Настройки.Получить("СтруктураДанныхКонтактногоЛицаБухгалтера");	
	
	ПроверитьНастройкиПодписантов(ЭтаФорма);
	
	ПривестиОтборыВСоответствиеОрганизации(ЭтаФорма);
	
	Если Не ЭтаФорма.ЭтоПолноправныйПользователь Тогда
		ЭтаФорма.ЗаполнятьДанныеБухгалтерииОбУдержанномВознаграждении = Истина; // по умолчанию для обычных прав
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПериодДляПечатиПриИзменении(Неопределено);
	
	ПриИзмененииОтбора();
	
КонецПроцедуры

&НаКлиенте
Процедура РежимРасчетаПриИзменении(Элемент)
	
	ОчиститьДанные(ЭтаФорма);
	
	ПриИзмененииРежимаРасчетаНаСервере();	
	
	ПериодДляПечатиПриИзменении(Неопределено);
	
	ЭтаФорма.Модифицированность = Истина;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ПроверитьНастройкиПодписантов(ЭтаФорма);
	
	ПривестиОтборыВСоответствиеОрганизации(ЭтаФорма);
	
	ПриИзмененииОтбора();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаРасчетаПриИзменении(Элемент)
	
	ОчиститьДанные(ЭтаФорма);	
	
	ОбновитьПериодДляПечати(ЭтаФорма, Объект);
	
	ПериодДляПечатиПриИзменении(Неопределено);
	
	ЭтаФорма.Модифицированность = Истина;	
	
КонецПроцедуры

&НаКлиенте
Процедура АгентскийДоговорПриИзменении(Элемент)
	
	ОчиститьДанные(ЭтаФорма);
	
	ЭтаФорма.Модифицированность = Истина;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодичностьРасчетаПриИзменении(Элемент)
	
	НоваяДатаРасчета = ПолучитьДатуРасчета(Объект.ВариантРасчета, Объект.ПериодичностьРасчета);
	
	Если Объект.ДатаРасчета <> НоваяДатаРасчета Тогда
		
		ОтветНаВопрос = Вопрос(СтрШаблон("Установить расчет на дату %1 ?", Формат(НоваяДатаРасчета, "ДФ=dd.MM.yyyy")), РежимДиалогаВопрос.ДаНет);
			
		Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
			Объект.ДатаРасчета = НоваяДатаРасчета;
		КонецЕсли;
		
	КонецЕсли;
	
	ОчиститьДанные(ЭтаФорма);	
	
	ОбновитьПериодДляПечати(ЭтаФорма, Объект);
	
	ПериодДляПечатиПриИзменении(Неопределено);
	
	ЭтаФорма.Модифицированность = Истина;		
	
КонецПроцедуры

&НаКлиенте
Процедура ВидВознагражденияПриИзменении(Элемент)

	ОчиститьДанные(ЭтаФорма);	
	
	ЭтаФорма.Модифицированность = Истина;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	РаботаСОтчетамиКлиент.ПодписантНачалоВыбора(ЭтаФорма, Элемент, ЭтаФорма.Подписант, Объект.Организация, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура ПодписантОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСОтчетамиКлиент.ПодписантОбработкаВыбора(ЭтаФорма, ВыбранноеЗначение, ЭтаФорма.СтруктураДанныхКонтактногоЛица, Объект.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантПриИзменении(Элемент)
	
	РаботаСОтчетамиКлиент.ПодписантПриИзменении(ЭтаФорма.Подписант, ЭтаФорма.СтруктураДанныхКонтактногоЛица);
	
	ЗаполнитьРеквизитыПодписантаИзСтруктурыДанныхКонтактногоЛица(ЭтаФорма.СтруктураДанныхКонтактногоЛица, , ЭтаФорма.ПодписантДолжность, ЭтаФорма.ПодписантОснованиеПолномочий);
	
	УстановитьЗаголовокНастроекПечатнойФормы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантБухгалтерНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	РаботаСОтчетамиКлиент.ПодписантНачалоВыбора(ЭтаФорма, Элемент, ЭтаФорма.ПодписантБухгалтер, Объект.Организация, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура ПодписантБухгалтерОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСОтчетамиКлиент.ПодписантОбработкаВыбора(ЭтаФорма, ВыбранноеЗначение, ЭтаФорма.СтруктураДанныхКонтактногоЛицаБухгалтера, Объект.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантБухгалтерПриИзменении(Элемент)
	
	РаботаСОтчетамиКлиент.ПодписантПриИзменении(ЭтаФорма.ПодписантБухгалтер, ЭтаФорма.СтруктураДанныхКонтактногоЛицаБухгалтера);
	
	ЗаполнитьРеквизитыПодписантаИзСтруктурыДанныхКонтактногоЛица(ЭтаФорма.СтруктураДанныхКонтактногоЛицаБухгалтера, , ЭтаФорма.ПодписантБухгалтерДолжность);
	
	УстановитьЗаголовокНастроекПечатнойФормы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодДляПечатиПриИзменении(Элемент)
	
	ПустойПериод = Новый СтандартныйПериод('00010101', '00010101');
	
	Если ЭтотОбъект.ПериодДляПечати <> ПустойПериод Тогда
		
		ТекстСообщения = "";
	
		Если Не ОбщегоНазначенияКлиентСервер.ПериодЗаполненКорректно(ЭтотОбъект.ПериодДляПечати,,, ТекстСообщения) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,, "ПериодДляПечати");
			Возврат;
		КонецЕсли;

		ИзменитьСостояниеФлажковВознагражденияУправляющего(Истина, "ВознагражденияУправляющегоПлатаЗаРазмещение", ЭтотОбъект.ПериодДляПечати);
	Иначе
		ИзменитьСостояниеФлажковВознагражденияУправляющего(Истина, "ВознагражденияУправляющегоПлатаЗаРазмещение");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВознагражденияУправляющегоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ВознагражденияУправляющегоСчетДоверительногоУправления"
		Или Поле.Имя = "ВознагражденияУправляющегоНачисление" 
		Или Поле.Имя = "ВознагражденияУправляющегоСуммаВознаграждения"
		Или Поле.Имя = "ВознагражденияУправляющегоСуммаНачисления"
		Или Поле.Имя = "ВознагражденияУправляющегоОписание"
	Тогда
	
		СтандартнаяОбработка = Ложь;	
		
		ТекущиеДанные = Элемент.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если Поле.Имя = "ВознагражденияУправляющегоСуммаВознаграждения" Тогда
			Если ЗначениеЗаполнено(ТекущиеДанные.РасшифровкаОшибки) Тогда
				ВвестиСтроку(ТекущиеДанные.РасшифровкаОшибки, "Расшифровка ошибки расчета", , Истина);
			ИначеЕсли Объект.ВариантРасчета = 3 Тогда // Прочие
				Если Вопрос(СтрШаблон("Расшифровать расчет вознаграждения %1?", ТекущиеДанные.СчетДоверительногоУправления), РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
					СформироватьРасчетВознаграждения(РаботаСКоллекциями.ЗначениеВМассив(ТекущиеДанные.СчетДоверительногоУправления));		
				КонецЕсли;
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
		Если Поле.Имя = "ВознагражденияУправляющегоСуммаНачисления" Тогда
			Если ЗначениеЗаполнено(ТекущиеДанные.РасшифровкаОшибкиНачисления) Тогда
				ВвестиСтроку(ТекущиеДанные.РасшифровкаОшибкиНачисления, "Расшифровка ошибки расчета", , Истина);
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
		Если Поле.Имя = "ВознагражденияУправляющегоНачисление" И ТипЗнч(ТекущиеДанные.Начисление) = Тип("СписокЗначений") Тогда
			ВыбранныйЭлемент = ВыбратьИзСписка(ТекущиеДанные.Начисление, Поле); 
			Если ВыбранныйЭлемент <> Неопределено Тогда
				ОткрытьЗначение(ВыбранныйЭлемент.Значение);	
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
		Если Поле.Имя = "ВознагражденияУправляющегоОписание" Тогда
							
			ДанныеНастроек = ?(Объект.ВариантРасчета = 2,
									ПолучитьНастройкуРасчетаВознагражденияПИФ(ТекущиеДанные.СчетДоверительногоУправления, Объект.ДатаРасчета),
									ПолучитьКлючНастроекРасчетаВознаграждения(Объект.Организация, ТекущиеДанные.СчетДоверительногоУправления, Объект.ВидВознаграждения, Объект.ДатаРасчета));
									
			Если ЗначениеЗаполнено(ДанныеНастроек) Тогда
				ОткрытьФормуМодально(?(Объект.ВариантРасчета = 2,
										"Справочник.НастройкиРасчета.Форма.ФормаЭлемента",
										"РегистрСведений.НастройкиРасчетаВознагражденияУправляющего.ФормаЗаписи"),
										Новый Структура("Ключ", ДанныеНастроек), ЭтаФорма); 
			Иначе
				Предупреждение("Настройки расчета вознаграждения не найдены!");
			КонецЕсли;
			Возврат;
            		
		КонецЕсли;
		
		ЗначениеПоля = Элемент.ТекущиеДанные[Сред(Поле.Имя, СтрДлина(Элемент.Имя) + 1)];
		Если ЗначениеПоля = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ОткрытьЗначение(ЗначениеПоля);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭлементОтбораПриИзменении(Элемент)
	
	Перем СчетаСоответствующиеОрганизации, СчетаНеСоответствующиеОрганизации;
	
	Если ЭтаФорма.ЭтоПолноправныйПользователь
		И Элемент = Элементы.ОтборСчетДоверительногоУправленияСписок
		И Не ПроверитьСчетаНаСоответствиеОрганизации(Объект.Организация, ЭтаФорма.ОтборСчетДоверительногоУправления, СчетаСоответствующиеОрганизации, СчетаНеСоответствующиеОрганизации)
	Тогда
		
		ПривестиОтборыВСоответствиеОрганизации(ЭтаФорма, СчетаСоответствующиеОрганизации);
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Счета д/у, не соответствующие организации %1, были удалены из отбора: %2", Объект.Организация, СтрСоединить(СчетаНеСоответствующиеОрганизации, ", ")));
	
	КонецЕсли;
	
	ПриИзмененииОтбора();
	
КонецПроцедуры

// Подключенные обработчики

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");	
	
	ОрганизацияПриИзменении(Элементы.Организация);	
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогФайловExcelНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ДиалогВыбораКаталога                    = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбораКаталога.Каталог            = ЭтаФорма.КаталогФайловExcel;
	ДиалогВыбораКаталога.МножественныйВыбор = Ложь;
	ДиалогВыбораКаталога.Заголовок	        = "Выберите каталог с Файлами";
	
	Если ДиалогВыбораКаталога.Выбрать() Тогда
		ЭтаФорма.КаталогФайловExcel = ДиалогВыбораКаталога.Каталог;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КаталогФайловExcelОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ПустаяСтрока(ЭтаФорма.КаталогФайловExcel) Тогда				
		ЗапуститьПриложение(ЭтаФорма.КаталогФайловExcel);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаУстановитьФлажки(Команда)
	
	ИзменитьСостояниеФлажковВознагражденияУправляющего(Истина, "ВознагражденияУправляющего");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьФлажки(Команда)
	
	ИзменитьСостояниеФлажковВознагражденияУправляющего(Ложь, "ВознагражденияУправляющего");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьФлажкиПлатаЗаРазмещение(Команда)
	
	ИзменитьСостояниеФлажковВознагражденияУправляющего(Истина, "ВознагражденияУправляющегоПлатаЗаРазмещение");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьФлажкиПлатаЗаРазмещение(Команда)
	
	ИзменитьСостояниеФлажковВознагражденияУправляющего(Ложь, "ВознагражденияУправляющегоПлатаЗаРазмещение");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновить(Команда)
	
	ОбновитьНаСервереИЗафиксироватьСтатистику();
	
	ПериодДляПечатиПриИзменении(Неопределено);
		
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьНачисления(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда
		РезультатВопроса = Вопрос("Перед созданием начислений следует заполнить данные. Заполнить?", РежимДиалогаВопрос.ОКОтмена);
		
		Если РезультатВопроса = КодВозвратаДиалога.ОК Тогда
			ОбновитьНаСервереИЗафиксироватьСтатистику();	
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	ИмяОбъекта			= Лев(ЭтаФорма.ИмяФормы, СтрНайти(ЭтаФорма.ИмяФормы, ".", , , 2) - 1);
	ИмяФормыПараметров	= ИмяОбъекта + ".Форма.ФормаПараметрыНачисленияЗадолженности";
	
	ПараметрыФормы = Новый Структура("ПараметрыНачисленияЗадолженности", Новый Структура("РасчетныйСчет, ПрочиеДоходыИРасходы, Организация"));
	ЗаполнитьЗначенияСвойств(ПараметрыФормы.ПараметрыНачисленияЗадолженности, Объект);
	
	ПараметрыНачисленияЗадолженности = ОткрытьФормуМодально(ИмяФормыПараметров, ПараметрыФормы, ЭтаФорма);
	
	Если ТипЗнч(ПараметрыНачисленияЗадолженности) = Тип("Структура") Тогда	
		
		ЗаполнитьЗначенияСвойств(Объект, ПараметрыНачисленияЗадолженности); 
		
		СоздатьНачисленияИОбновитьДанныеНаСервере();
		
	КонецЕсли;
		
КонецПроцедуры

