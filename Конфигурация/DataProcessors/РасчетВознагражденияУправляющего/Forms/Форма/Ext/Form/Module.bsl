			Или РасшифровкаРасчетаПоБазе.БазаРасчета = ПредопределенноеЗначение("Справочник.БазыРасчета.ПревышениеНадМинимальнымДоходом_СЧАНаКонецПоБалансу")
		Тогда
			#Область Превышение_над_минимальным_доходом
			
			РасчетПоБалансовойСтоимости = (РасшифровкаРасчетаПоБазе.БазаРасчета = ПредопределенноеЗначение("Справочник.БазыРасчета.ПревышениеНадМинимальнымДоходомПоБалансу"));
			
