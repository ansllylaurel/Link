			СтраницаРасчета.Страница.Range(РаботаСВнешнимиСистемамиКлиентСервер.ExcelАдресОбластиСтрокой(НачальнаяСтрокаДвиженияАктивов, "D", НачальнаяСтрокаДвиженияАктивов, "F")));	
