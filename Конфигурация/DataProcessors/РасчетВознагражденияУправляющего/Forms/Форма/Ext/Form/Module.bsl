#Область Расчет_вознаграждения_в_Excel

&НаКлиенте
Функция ПолучитьДанныеПодписантов(Отказ)
	ДанныеПодписантов = Новый Соответствие;
		
	ПодписантЗаполнен = Истина;
	Для Каждого СтрокаВознаграждение из ЭтаФорма.ВознагражденияУправляющего Цикл
		Если СтрокаВознаграждение.Флажок И ЗначениеЗаполнено(СтрокаВознаграждение.Подписант) Тогда
			Если ДанныеПодписантов.Получить(СтрокаВознаграждение.Клиент) = Неопределено Тогда
				ДанныеПодписантов.Вставить(СтрокаВознаграждение.Клиент, СтрокаВознаграждение.СтруктураПодписантОтКлиента);
			КонецЕсли;
		ИначеЕсли СтрокаВознаграждение.Флажок И СтрокаВознаграждение.НуженПодписант И ПодписантЗаполнен И Не ЗначениеЗаполнено(СтрокаВознаграждение.Подписант) Тогда
			ПодписантЗаполнен = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ПодписантЗаполнен И Вопрос("Указать подписанта со стороны клиента?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Возврат ДанныеПодписантов;
КонецФункции

&НаКлиенте
Процедура СформироватьРасчетВознаграждения(СчетаДоверительногоУправления = Неопределено)
		
	// Проверка наличия данных для расшифровки
	Если ЭтаФорма.Модифицированность Тогда
		
		РезультатВопроса = Вопрос("Настройки расчеты были изменены. Обновить данные?", РежимДиалогаВопрос.ОКОтмена);
		Если РезультатВопроса = КодВозвратаДиалога.ОК Тогда
			ОбновитьНаСервереИЗафиксироватьСтатистику();
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	ПараметрыСессииСбораСтатистики = ЗарегистрироватьНовуюСессиюНаСервере("СформироватьРасчетВознаграждения");
	
	// Получаем счета, по которым запрашивается расшифровка
	Если СчетаДоверительногоУправления = Неопределено Тогда
		
		СчетаДоверительногоУправления = Новый Массив;
		Для Каждого СтрокаВознагражденияУправляющего Из ВознагражденияУправляющего Цикл
			Если СтрокаВознагражденияУправляющего.Флажок Тогда
				СчетаДоверительногоУправления.Добавить(СтрокаВознагражденияУправляющего.СчетДоверительногоУправления);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если СчетаДоверительногоУправления.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран ни один клиент!");
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	ДанныеПодписантов = ПолучитьДанныеПодписантов(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Получаем данные об удержанном вознаграждении из ИБ бухгалтерии при первой расшифровке
	Если ЭтаФорма.ЗаполнятьДанныеБухгалтерииОбУдержанномВознаграждении
		И Не ЭтоАдресВременногоХранилища(ЭтаФорма.АдресДанныхБухгалтерииОбУдержанномВознаграждении)
	Тогда
		Состояние("Формирование расчета вознаграждения:", , ">> Получение данных об удержанном вознаграждении из ИБ бухгалтерии");
		
		НачалоУплатыВознаграждения		= КонецКвартала(НачалоГода(БазовыйПериод.ДатаНачала)) + 1; // начало первого квартала года расчета
		ОкончаниеУплатыВознаграждения	= КонецКвартала(БазовыйПериод.ДатаОкончания); // Конец текущего квартала (в будущие не смотрим)
		
		ЗаполнитьДанныеБухгалтерииОбУдержанномВознаграждении(
			Объект.Организация, НачалоУплатыВознаграждения, ОкончаниеУплатыВознаграждения, ПараметрыСессииСбораСтатистики.ДанныеДляСтатистики);
	КонецЕсли;
		
	// Получаем данные расшифровки
	Состояние("Формирование расчета вознаграждения:", , ">> Получение данных расшифровки расчета");
	
	РасшифровкаРасчета = ПолучитьДанныеРасшифровки(СчетаДоверительногоУправления, АдресДанныхРасшифровки, ПараметрыСессииСбораСтатистики.ДанныеДляСтатистики);
	Если РасшифровкаРасчета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКШаблону = ПолучитьИмяВременногоФайла("xltx");
	РасшифровкаРасчета.ШаблонОтчета.Записать(ПутьКШаблону);
	
	// Формируем отчет
	Состояние("Формирование расчета вознаграждения:", , ">> Формирование формы в Microsoft Excel");
	
	Для Каждого ДанныеРасшифровки Из РасшифровкаРасчета.Вознаграждения Цикл
		
		Состояние("Формирование расчета вознаграждения:", , ">> " + ДанныеРасшифровки.УчредительУправления);
		
		ExcelApp = РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗапуститьПриложение();
		Если ExcelApp = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось запустить приложение Microsoft Excel");
			Прервать;
		КонецЕсли;
		
		Попытка
			СформироватьРасчетВознагражденияExcel(ExcelApp, ПутьКШаблону, ДанныеРасшифровки, РасшифровкаРасчета.ДанныеОбОрганизации, , ДанныеПодписантов);
		Исключение
			ТекстОшибки = СтрШаблон("Ошибка формирования печатной формы расчета вознаграждения '%1'. Система сообщает:" + Символы.ПС + "%2",
				ДанныеРасшифровки.СчетДоверительногоУправления, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗакрытьПриложение(ExcelApp);
			ЗарегистрироватьОшибку(ТекстОшибки);
		КонецПопытки;
		
		ОбработкаПрерыванияПользователя();
		
	КонецЦикла;
	
	// Завершающие процедуры
	УдалитьФайлы(ПутьКШаблону);
	Состояние("Формирование расчета вознаграждения:", , ">> Завершено");
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессииСбораСтатистики);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеРасшифровки(СчетаДоверительногоУправления, АдресДанныхРасшифровки, ДанныеДляСтатистики)
	
	ДанныеРасшифровки = Неопределено;
	
	ВремяНачала = ТекущаяДатаСеанса();
	ДанныеДляСтатистики.Вставить("ПолучитьДанныеРасшифровки", "Старт в: " + Формат(ВремяНачала, "ДЛФ=T") + ".");
	
	Если ЭтоАдресВременногоХранилища(АдресДанныхРасшифровки) Тогда
		ХранилищеЗначения = ПолучитьИзВременногоХранилища(АдресДанныхРасшифровки);
		Если ТипЗнч(ХранилищеЗначения) = Тип("ХранилищеЗначения") Тогда
			ДанныеРасшифровки = ХранилищеЗначения.Получить();
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеРасшифровки = Неопределено Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расшифровка расчета вознаграждения по данной методике не реализована");
		ДанныеДляСтатистики.ПолучитьДанныеРасшифровки = ДанныеДляСтатистики.ПолучитьДанныеРасшифровки + " Время выполнения метода: " + РассчитатьВремя(ВремяНачала);
		Возврат Неопределено;
		
	КонецЕсли;
	
	// Фильтр ненужных счетов д/у
	ИндексСтроки = ДанныеРасшифровки.Вознаграждения.Количество() - 1;
	Пока ИндексСтроки >= 0 Цикл
		Если СчетаДоверительногоУправления.Найти(ДанныеРасшифровки.Вознаграждения[ИндексСтроки].СчетДоверительногоУправления) = Неопределено Тогда
			ДанныеРасшифровки.Вознаграждения.Удалить(ИндексСтроки);
		КонецЕсли;
		ИндексСтроки = ИндексСтроки - 1;
	КонецЦикла;

	// #ТехДолг
	// 	отсортируем таблицы расшифровки для вывода (на самом деле, это лучше сделать
	// 	на этапе выполнения запроса, помещающего данные во временные таблицы,
	// 	но встроится туда непросто, поэтому делаем здесь)
	Для каждого ДанныеВознаграждения Из ДанныеРасшифровки.Вознаграждения Цикл
		Для каждого ДанныеРасщифровкиПоБазе Из ДанныеВознаграждения.БазыРасчета Цикл
			Для каждого ЭлементРасшифровкиРасчета Из ДанныеРасщифровкиПоБазе.ТаблицыРасшифровкиРасчета Цикл
				ТаблицаРасшифровкиРасчета = ЭлементРасшифровкиРасчета.Значение;
				Если ТаблицаРасшифровкиРасчета.Колонки.Найти("Период") <> Неопределено Тогда
					ТаблицаРасшифровкиРасчета.Сортировать("Период ВОЗР");
				КонецЕсли;
				ДанныеРасщифровкиПоБазе.ТаблицыРасшифровкиРасчета[ЭлементРасшифровкиРасчета.Ключ] = ТаблицаРасшифровкиРасчета;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	// Преобразуем для передачи на клиента
	СериализованныеДанные = СериализоватьЗначение(ДанныеРасшифровки);
	
	ДанныеДляСтатистики.ПолучитьДанныеРасшифровки = ДанныеДляСтатистики.ПолучитьДанныеРасшифровки + " Время выполнения метода: " + РассчитатьВремя(ВремяНачала);
	
	Возврат СериализованныеДанные;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРасходыПоУправлению(СчетДоверительногоУправления, Организация, НачалоПериода, КонецПериода)
	
	// Т.к. используются только при расшифровке, то получаю их здесь
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В (&ВидыЗадолженностиПоДоговоруСБанком)
		|			ТОГДА ""Расходы по договору банковского обслуживания""
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В (&ВидыЗадолженностиПоДоговоруСоСпецдепозитарием)
		|			ТОГДА ""Расходы по договору спецдепозитарного обслуживания""
		|	КОНЕЦ КАК ВидРасходов,
		|	СУММА(ЗадолженностиПоДенежнымСредствам.СуммаПриход + ЗадолженностиПоДенежнымСредствам.СуммаКупонаПриход) КАК НачисленоВВалютеУчета
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидЗадолженности В (&ВидыЗадолженностиПоДоговоруСБанком, &ВидыЗадолженностиПоДоговоруСоСпецдепозитарием)) КАК ЗадолженностиПоДенежнымСредствам
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В (&ВидыЗадолженностиПоДоговоруСБанком)
		|			ТОГДА ""Расходы по договору банковского обслуживания""
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В (&ВидыЗадолженностиПоДоговоруСоСпецдепозитарием)
		|			ТОГДА ""Расходы по договору спецдепозитарного обслуживания""
		|	КОНЕЦ");

	ВидыЗадолженностиПоДоговоруСБанком = Новый Массив;
	ВидыЗадолженностиПоДоговоруСБанком.Добавить(Справочники.ВидыЗадолженности.КомиссияБанкаБанкКлиентИРКО);
	ВидыЗадолженностиПоДоговоруСБанком.Добавить(Справочники.ВидыЗадолженности.КомиссияБанкаОткрытиеИВедениеСчета);
	ВидыЗадолженностиПоДоговоруСБанком.Добавить(Справочники.ВидыЗадолженности.КомиссияБанкаЗаПереводДС);
	
	ВидыЗадолженностиПоДоговоруСоСпецдепозитарием = Новый Массив;
	ВидыЗадолженностиПоДоговоруСоСпецдепозитарием.Добавить(Справочники.ВидыЗадолженности.НеобходимыеРасходыСпецдепозитария);
	ВидыЗадолженностиПоДоговоруСоСпецдепозитарием.Добавить(Справочники.ВидыЗадолженности.РасходыПоУслугамСпецДепозитария);
	ВидыЗадолженностиПоДоговоруСоСпецдепозитарием.Добавить(Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария);
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",					СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация",									Организация);
	Запрос.УстановитьПараметр("НачалоПериода",									НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",									КонецПериода);
	Запрос.УстановитьПараметр("ВидыЗадолженностиПоДоговоруСБанком",				ВидыЗадолженностиПоДоговоруСБанком);
	Запрос.УстановитьПараметр("ВидыЗадолженностиПоДоговоруСоСпецдепозитарием",	ВидыЗадолженностиПоДоговоруСоСпецдепозитарием);
	
	РасходыПоУправлению = Запрос.Выполнить().Выгрузить();
	
	Возврат СериализоватьЗначение(РасходыПоУправлению);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеБухгалтерииОбУдержанномВознаграждении(Организация, НачалоПериода, КонецПериода, ДанныеДляСтатистики)
	
	ВремяНачала = ТекущаяДатаСеанса();
	ДанныеДляСтатистики.Вставить("ЗаполнитьДанныеБухгалтерииОбУдержанномВознаграждении", "Старт в: " + Формат(ВремяНачала, "ДЛФ=T") + ".");
			
	ТаблицаВознаграждений = РаботаСВнешнимиСистемами.ПолучитьДанныеБухгалтерииОВознагражденииУК("Удержанное", НачалоПериода, КонецПериода, Организация);
	
	Если ТаблицаВознаграждений <> Неопределено Тогда		
	
		ТаблицаВознаграждений.Свернуть("СчетДоверительногоУправления", "Сумма");
			
		ЭтаФорма.АдресДанныхБухгалтерииОбУдержанномВознаграждении = ПоместитьВоВременноеХранилище(ТаблицаВознаграждений, ЭтаФорма.УникальныйИдентификатор);
		
	КонецЕсли;
	
	ДанныеДляСтатистики.ЗаполнитьДанныеБухгалтерииОбУдержанномВознаграждении = ДанныеДляСтатистики.ЗаполнитьДанныеБухгалтерииОбУдержанномВознаграждении + " Время выполнения метода: " + РассчитатьВремя(ВремяНачала);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьУдержанноеВознаграждениеПоДаннымБухгалтерии(АдресДанныхБухгалтерии, СчетДоверительногоУправления, ПриОтсутствииВозвращатьНоль = Ложь)
	
	ТаблицаВознаграждений = Неопределено;	
	
	Если ЭтоАдресВременногоХранилища(АдресДанныхБухгалтерии) Тогда	
		ТаблицаВознаграждений = ПолучитьИзВременногоХранилища(АдресДанныхБухгалтерии);
	КонецЕсли;
	
	Если ТаблицаВознаграждений = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
			
	УдержанноеВознаграждение = ТаблицаВознаграждений.Найти(СчетДоверительногоУправления, "СчетДоверительногоУправления");
	
	Возврат ?(УдержанноеВознаграждение = Неопределено, ?(ПриОтсутствииВозвращатьНоль, 0, Неопределено), УдержанноеВознаграждение.Сумма);
	
КонецФункции

&НаСервере
Функция ВернутьФИОПодписанта(Подписант)
	
	ФИО = Новый Структура;
	
	Если ТипЗнч(Подписант) = Тип("СправочникСсылка.ЮрФизЛица") Тогда 
		Запрос = Новый Запрос;
		Запрос.Текст =  
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыФизическихЛицСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицСрезПоследних.Отчество КАК ФИОПолностью,
		|	РеквизитыФизическихЛицСрезПоследних.Фамилия + "" "" + ПОДСТРОКА(РеквизитыФизическихЛицСрезПоследних.Имя, 1, 1) + "". "" + ПОДСТРОКА(РеквизитыФизическихЛицСрезПоследних.Отчество, 1, 1) + ""."" КАК ФИОСокращенно
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо = &ЮрФизЛицо
		|				И Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицСрезПоследних";
		
		Запрос.УстановитьПараметр("Период", Объект.ДатаРасчета);
		Запрос.УстановитьПараметр("ЮрФизЛицо", Подписант);
		Запрос.УстановитьПараметр("Организация", Объект.Организация);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда 
			ФИО.Вставить("ФИОПолностью", Выборка.ФИОПолностью);
			ФИО.Вставить("ФИОСокращенно", Выборка.ФИОСокращенно);
			
		КонецЕсли;	
	Иначе //строка	
		СтрокаФИО = Подписант;
		
		Если Найти(СтрокаФИО, ".") > 0 Тогда         //только Фамилия И. О. 
			ФИО.Вставить("ФИОПолностью", СтрокаФИО);
			ФИО.Вставить("ФИОСокращенно", СтрокаФИО);
		Иначе	
			МассивФИО = СтрРазделить(СтрокаФИО, " ");
			Если МассивФИО.Количество() = 3 Тогда
				ФИОСокращенно = МассивФИО[0] + " " + Лев(МассивФИО[1],1) + ". " + Лев(МассивФИО[2],1) + ". ";
				
				ФИО.Вставить("ФИОПолностью", СтрокаФИО);
				ФИО.Вставить("ФИОСокращенно", ФИОСокращенно);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаФИО + " не является строкой типа ФИО");
			КонецЕсли;	
		КонецЕсли;
	
	КонецЕсли;	
	
	Возврат ФИО;	
	
КонецФункции	

&НаКлиенте
Процедура СформироватьРасчетВознагражденияExcel(ExcelApp, ПутьКШаблону, ДанныеРасшифровки, ДанныеОбОрганизации, ОткрытьБезСохранения = Истина, ДанныеПодписантов)
	// Инициализация вспомогательных переменных
	#Область Общие_параметры_заполнения
	
	// Подписант учредителя
	ОбщиеПараметрыЗаполнения = Новый Структура;
	ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителя",							"");
	ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяПолноеФИО",					"");
	ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяПолноеФИО_РП",				"");
	ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяДолжность",					"");
	ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяДолжность_РП",				"");
	ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяОснованиеПолномочий",		"");
	ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяОснованиеПолномочий_РП",	"");
	
	Если ДанныеРасшифровки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Благосостояние") Тогда
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителя",							"А.Е.Леднев");
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяДолжность",					"Заместитель Генерального директора");
	ИначеЕсли ДанныеРасшифровки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Газфонд") Тогда
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителя",							"В.К. Плотникова");
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяДолжность",					"Руководитель инвестиционной поддержки");
	ИначеЕсли ДанныеРасшифровки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сургутнефтегаз") Тогда
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителя",							"Назаров А.Е.");
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяДолжность",					"Генеральный директор");
	ИначеЕсли ДанныеРасшифровки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ХантыМансийский") Тогда
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителя",							"Стулова М.А.");
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяПолноеФИО",					"Стулова Мария Александровна");
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяПолноеФИО_РП",				"Стуловой Марии Александровны");
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяДолжность",					"Президент");
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяДолжность_РП",				"Президента");
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяОснованиеПолномочий",		"Устав");
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяОснованиеПолномочий_РП",	"Устава");
	ИначеЕсли ДанныеРасшифровки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МГПУФонд") Тогда
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителя",							"Таращук Д.В.");
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяПолноеФИО",					"Таращук Дмитрий Владимирович");
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяПолноеФИО_РП",				"Таращука Дмитрия Владимировича");
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяДолжность",					"Директор");
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяДолжность_РП",				"Директора");
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяОснованиеПолномочий",		"Устав");
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяОснованиеПолномочий_РП",	"Устава");	
	ИначеЕсли ДанныеРасшифровки.ВидДоговораДоверительногоУправления
		= ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица")
	Тогда
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителя",							ДанныеРасшифровки.КраткоеНаименованиеУчредителяУправления);
	КонецЕсли;
	
	СтруктураПодписант = ДанныеПодписантов.Получить(ДанныеРасшифровки.Клиент);
	Если ЗначениеЗаполнено(СтруктураПодписант) Тогда
		
		ФИО = ВернутьФИОПодписанта(СтруктураПодписант.КонтактноеЛицо);
		
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителя",							ФИО.ФИОСокращенно);
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяПолноеФИО",					ФИО.ФИОПолностью);
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяПолноеФИО_РП",				СклоненияСтроки(ФИО.ФИОПолностью, "", "ПД=Родительный")[0]);
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяДолжность",					СтруктураПодписант.Должность);
		ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяДолжность_РП",				СклоненияСтроки(СтруктураПодписант.Должность, "", "ПД=Родительный")[0]); 
		Если Не ПустаяСтрока(СтруктураПодписант.ОснованиеПолномочий) Тогда 
			ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяОснованиеПолномочий",		СтруктураПодписант.ОснованиеПолномочий);
			ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУчредителяОснованиеПолномочий_РП",	СклоненияСтроки(СтруктураПодписант.ОснованиеПолномочий, "", "ПД=Родительный")[0]);
		КонецЕсли;
	КонецЕсли;
	
	// Подписант УК
	ОбщиеПараметрыЗаполнения.Вставить("ПодписантОснованиеПолномочий_РП",					"");
	ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУКПолноеФИО",								"");
	ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУКПолноеФИО_РП",							"");
	ОбщиеПараметрыЗаполнения.Вставить("ПодписантОтУКДолжность_РП",							"");
	ОбщиеПараметрыЗаполнения.Вставить("АвтоформированиеОснованияПолномочийПодписанта_РП",	Ложь);
	ОбщиеПараметрыЗаполнения.Вставить("АвтоформированиеПолногоФИОПодписантаУК_РП",			Ложь);
	ОбщиеПараметрыЗаполнения.Вставить("АвтоформированиеДолжностиПодписантаУК_РП",			Ложь);
	
	Если СтрНачинаетсяС(НРег(ЭтаФорма.ПодписантОснованиеПолномочий), "доверенность") Тогда
		ОбщиеПараметрыЗаполнения.ПодписантОснованиеПолномочий_РП = "Доверенности" + Сред(ЭтаФорма.ПодписантОснованиеПолномочий, СтрДлина("доверенность") + 1);
	ИначеЕсли СтрНачинаетсяС(НРег(ЭтаФорма.ПодписантОснованиеПолномочий), "доверенности") Тогда
		ОбщиеПараметрыЗаполнения.ПодписантОснованиеПолномочий_РП = ЭтаФорма.ПодписантОснованиеПолномочий;
	ИначеЕсли Не ПустаяСтрока(ЭтаФорма.ПодписантОснованиеПолномочий) Тогда
		ОбщиеПараметрыЗаполнения.ПодписантОснованиеПолномочий_РП					= СклоненияСтроки(ЭтаФорма.ПодписантОснованиеПолномочий, "", "ПД=Родительный")[0];
		ОбщиеПараметрыЗаполнения.АвтоформированиеОснованияПолномочийПодписанта_РП	= (НРег(ЭтаФорма.ПодписантОснованиеПолномочий) <> "устава");
	КонецЕсли;
	
	Если ТипЗнч(ЭтаФорма.Подписант) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
		ОбщиеПараметрыЗаполнения.ПодписантОтУКПолноеФИО = ПолноеФИО(ЭтаФорма.Подписант, Объект.ДатаРасчета, Объект.Организация);
	КонецЕсли;
	
	Если Не ПустаяСтрока(ОбщиеПараметрыЗаполнения.ПодписантОтУКПолноеФИО) Тогда
		ОбщиеПараметрыЗаполнения.ПодписантОтУКПолноеФИО_РП					= СклоненияСтроки(ОбщиеПараметрыЗаполнения.ПодписантОтУКПолноеФИО, "", "ПД=Родительный")[0];
		ОбщиеПараметрыЗаполнения.АвтоформированиеПолногоФИОПодписантаУК_РП	= Не СтрНачинаетсяС(НРег(ОбщиеПараметрыЗаполнения.ПодписантОтУКПолноеФИО_РП), "новиковой");	
	КонецЕсли;
	
	Если Не ПустаяСтрока(ЭтаФорма.ПодписантДолжность) Тогда
		ОбщиеПараметрыЗаполнения.ПодписантОтУКДолжность_РП					= СклоненияСтроки(ЭтаФорма.ПодписантДолжность, "", "ПД=Родительный")[0];
		ОбщиеПараметрыЗаполнения.АвтоформированиеДолжностиПодписантаУК_РП	= Не СтрНачинаетсяС(НРег(ОбщиеПараметрыЗаполнения.ПодписантОтУКДолжность_РП), "начальника") И НРег(ОбщиеПараметрыЗаполнения.ПодписантОтУКДолжность_РП) <> "генерального директора";
	КонецЕсли;
	
	// Договор д/у, вид договора, период расчета и пр.
	ОбщиеПараметрыЗаполнения.Вставить("ДатаРасчетаСтрокой",					Формат(Объект.ДатаРасчета, "ДФ=dd.MM.yyyy"));
	ОбщиеПараметрыЗаполнения.Вставить("ДоговорДУ",							ДанныеРасшифровки.НомерДоговора + " от " + Формат(ДанныеРасшифровки.ДатаЗаключения, "ДФ=dd.MM.yyyy"));
	ОбщиеПараметрыЗаполнения.Вставить("НомерДоговораДУ",					ДанныеРасшифровки.НомерДоговора);
	ОбщиеПараметрыЗаполнения.Вставить("ДатаДоговораДУ",						Формат(ДанныеРасшифровки.ДатаЗаключения, "ДФ=dd.MM.yyyy"));
	ОбщиеПараметрыЗаполнения.Вставить("ДатаДоговораДУ_ddMMMMyyyy",			Формат(ДанныеРасшифровки.ДатаЗаключения, "ДФ='«dd» MMMM yyyy'"));
	ОбщиеПараметрыЗаполнения.Вставить("ПредставлениеПериода",				ПредставлениеПериода(ДанныеРасшифровки.НачалоБазовогоПериодаДляОтображения, ДанныеРасшифровки.КонецБазовогоПериодаДляОтображения));
	ОбщиеПараметрыЗаполнения.Вставить("ПредставлениеФинансовогоПериода",	ПредставлениеПериода(ДанныеРасшифровки.НачалоБазовогоПериодаДляОтображения, ДанныеРасшифровки.КонецБазовогоПериодаДляОтображения, "ФП = ИСТИНА"));
	ОбщиеПараметрыЗаполнения.Вставить("НачалоБазовогоПериодаСтрокой",		Формат(ДанныеРасшифровки.НачалоБазовогоПериодаДляОтображения, "ДФ=dd.MM.yyyy"));
	ОбщиеПараметрыЗаполнения.Вставить("КонецБазовогоПериодаСтрокой",		Формат(ДанныеРасшифровки.КонецБазовогоПериодаДляОтображения, "ДФ=dd.MM.yyyy"));
	ОбщиеПараметрыЗаполнения.Вставить("НачалоБазовогоПериода_ddMMMMyyyy",	Формат(ДанныеРасшифровки.НачалоБазовогоПериодаДляОтображения, "ДФ='dd MMMM yyyy'"));
	ОбщиеПараметрыЗаполнения.Вставить("КонецБазовогоПериода_ddMMMMyyyy",	Формат(ДанныеРасшифровки.КонецБазовогоПериодаДляОтображения, "ДФ='dd MMMM yyyy'"));
	
	Если ДанныеРасшифровки.ВидДоговораДоверительногоУправления = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями") Тогда
		АббревиатураВидаДоговораДУ = "ПН";
	ИначеЕсли ДанныеРасшифровки.ВидДоговораДоверительногоУправления = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами") Тогда
		АббревиатураВидаДоговораДУ = "ПР";
	ИначеЕсли ДанныеРасшифровки.ВидДоговораДоверительногоУправления = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов") Тогда
		АббревиатураВидаДоговораДУ = "СС";
	Иначе
		АббревиатураВидаДоговораДУ = "";
	КонецЕсли;
	
	Если ДанныеРасшифровки.ВидДоговораДоверительногоУправления = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями") Тогда
		ВидСредствДУ_РП = "пенсионных накоплений";
		ВидСредствДУ_ТП = "пенсионными накоплениями";
	ИначеЕсли ДанныеРасшифровки.ВидДоговораДоверительногоУправления = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами") Тогда
		ВидСредствДУ_РП = "пенсионных резервов";
		ВидСредствДУ_ТП = "пенсионными резервами";
	Иначе
		ВидСредствДУ_РП = "";
		ВидСредствДУ_ТП = "________________________";
	КонецЕсли;
	
	ОбщиеПараметрыЗаполнения.Вставить("ВидСредствДУ_РП", ВидСредствДУ_РП);
	ОбщиеПараметрыЗаполнения.Вставить("ВидСредствДУ_ТП", ВидСредствДУ_ТП);
	
	Если СтрНачинаетсяС(ДанныеРасшифровки.ПолноеНаименованиеУчредителяУправления, "Акционерное общество") Тогда
		ПолноеНаименованиеУчредителяУправления_ТП = "Акционерным обществом" + Сред(ДанныеРасшифровки.ПолноеНаименованиеУчредителяУправления, СтрДлина("Акционерное общество") + 1);
		АвтоформированиеПолногоНаименованияУчредителяУправления_ТП = Ложь;
	Иначе
		ПолноеНаименованиеУчредителяУправления_ТП = СклоненияСтроки(ДанныеРасшифровки.ПолноеНаименованиеУчредителяУправления, "", "ПД=Творительный")[0];
		АвтоформированиеПолногоНаименованияУчредителяУправления_ТП = Истина;
	КонецЕсли;
	
	ОбщиеПараметрыЗаполнения.Вставить("ПолноеНаименованиеУчредителяУправления_ТП",					ПолноеНаименованиеУчредителяУправления_ТП); // Полное наименование клиента в творительным падеже
	ОбщиеПараметрыЗаполнения.Вставить("АвтоформированиеПолногоНаименованияУчредителяУправления_ТП",	АвтоформированиеПолногоНаименованияУчредителяУправления_ТП);
	
	ДанныеРасшифровки.Вставить("ОбщиеПараметрыЗаполнения", ОбщиеПараметрыЗаполнения);
	
	// Шаблоны
	ОбщийАкт = СтрНачинаетсяС(ДанныеРасшифровки.ШаблонАкта, "Будущее") // Шаблон акта содержит данные по всем базам расчета, либо для каждой базы свой акт
		Или СтрНачинаетсяС(ДанныеРасшифровки.ШаблонАкта, "ХантыМансийский")
		Или СтрНачинаетсяС(ДанныеРасшифровки.ШаблонАкта, "Сургутнефтегаз");
		
	ДанныеРасшифровки.Вставить("ВыводитьАкт", ЗначениеЗаполнено(ДанныеРасшифровки.ШаблонАкта));
	
	Если ДанныеРасшифровки.ШаблонАкта = "Стандартный" Тогда
		ДанныеРасшифровки.ШаблонАкта = "";
	ИначеЕсли СтрНачинаетсяС(ДанныеРасшифровки.ШаблонАкта, "Будущее")
		Или СтрНачинаетсяС(ДанныеРасшифровки.ШаблонАкта, "ХантыМансийский")
		Или СтрНачинаетсяС(ДанныеРасшифровки.ШаблонАкта, "ЦКМГПУ")
		Или СтрНачинаетсяС(ДанныеРасшифровки.ШаблонАкта, "Сургутнефтегаз")
	Тогда
		ДанныеРасшифровки.ШаблонАкта = ДанныеРасшифровки.ШаблонАкта + АббревиатураВидаДоговораДУ;
	КонецЕсли;
	
	Если ДанныеРасшифровки.ШаблонРасшифровки = "Стандартный" Тогда
		// Стандартный 2024, с октября (только для РэМ и Траст)
		Если Объект.ДатаРасчета >= Дата(2024, 10, 1)
			И (ДанныеРасшифровки.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ")
				Или ДанныеРасшифровки.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"))
		Тогда
			ДанныеРасшифровки.ШаблонРасшифровки = "2024";
		// Стандартный 2023
		ИначеЕсли Объект.ДатаРасчета >= Дата(2023, 1, 1) Тогда
			ДанныеРасшифровки.ШаблонРасшифровки = "2023";
		// Стандартный
		Иначе
			ДанныеРасшифровки.ШаблонРасшифровки = "";
		КонецЕсли;
	ИначеЕсли СтрНачинаетсяС(ДанныеРасшифровки.ШаблонРасшифровки, "Будущее")
		Или СтрНачинаетсяС(ДанныеРасшифровки.ШаблонРасшифровки, "ХантыМансийский")
		Или СтрНачинаетсяС(ДанныеРасшифровки.ШаблонРасшифровки, "Сургутнефтегаз")
		Или СтрНачинаетсяС(ДанныеРасшифровки.ШаблонРасшифровки, "Национальный")
	Тогда
		ДанныеРасшифровки.ШаблонРасшифровки = ДанныеРасшифровки.ШаблонРасшифровки + АббревиатураВидаДоговораДУ;
	КонецЕсли;
	
	#КонецОбласти
	
	// Если вознаграждение рассчитывается чаще раза в год и удерживается из собственных средств клиента, нужно получать его из базы БУ
	Отказ = Ложь;
	ИспользоватьВознаграждениеИзБухгалтерскойБазы =
		Объект.ПериодичностьРасчета <> ПредопределенноеЗначение("Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно")
		И ОплатаВознагражденияУправляющегоИзСобственныхСредствКлиента(
			Объект.Организация, ДанныеРасшифровки.СчетДоверительногоУправления, ДанныеРасшифровки.КонецБазовогоПериода, Отказ);
		
	Если Отказ Тогда
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗакрытьПриложение(ExcelApp);
		Возврат;
	КонецЕсли;
	
	РанееУдержанноеВознаграждениеБУ = ?(ИспользоватьВознаграждениеИзБухгалтерскойБазы,
		ПолучитьУдержанноеВознаграждениеПоДаннымБухгалтерии(
			ЭтаФорма.АдресДанныхБухгалтерииОбУдержанномВознаграждении, ДанныеРасшифровки.СчетДоверительногоУправления, Истина),
		Неопределено);
	
	ДанныеРасшифровки.Вставить("ИспользоватьВознаграждениеИзБухгалтерскойБазы",	ИспользоватьВознаграждениеИзБухгалтерскойБазы);
	ДанныеРасшифровки.Вставить("РанееУдержанноеВознаграждениеБУ",				РанееУдержанноеВознаграждениеБУ);
	
	ДанныеРасшифровки.Вставить("РанееУдержанноеВознаграждениеБУИспользованоВРасчете", Ложь);
	
	Расшифровка = Новый Структура("ExcelApp, Шаблон, Результат",
		ExcelApp, Новый Структура, Новый Структура);
	
	// Создание документа MS Excel на основании шаблона
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьПараметрыПриложения(ExcelApp, Ложь);
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьПараметрыИнтерактивностиПриложения(ExcelApp, Ложь, Ложь, Ложь, Ложь);
	
	КнигаШаблонаExcel	= ExcelApp.Workbooks.Open(ПутьКШаблону);
	НоваяКнигаExcel		= ExcelApp.Workbooks.Add();
	
	Расшифровка.Шаблон.Вставить("Книга", КнигаШаблонаExcel);
	Расшифровка.Шаблон.Вставить("ПараметрыЛистов", Новый Соответствие);
	
	Расшифровка.Результат.Вставить("Книга", НоваяКнигаExcel);
	Расшифровка.Результат.Вставить("ПараметрыЛистов", Новый Соответствие);
	
	Если ДанныеРасшифровки.ВыводитьАкт Тогда
		ШаблонСтраницыАкта = ДобавитьОписаниеСтраницыExcel("Акт", Расшифровка.Шаблон, Ложь);
	КонецЕсли;
	
	// Удаление листов, созданных по умолчанию, а первый лист - титульный,
	//	т.к. все страницы Excel удалить не даёт
	ВсегоЛистов = НоваяКнигаExcel.Sheets.Count;
	Для н = 2 По ВсегоЛистов Цикл
		НоваяКнигаExcel.Sheets(2).Delete();
	КонецЦикла;
	
	#Область Шапка_титульной_страницы
	
	ТитульнаяСтраница = ДобавитьОписаниеСтраницыExcel("Титульная страница", Расшифровка.Результат, Истина, Истина);
	ТитульнаяСтраница.КлючевыеЯчейки.Вставить("ВознаграждениеУплаченное", Новый Массив); // Для заполнения в конце расчета
	
	// Шапка
	ШаблонТитульнойСтраницы = ДобавитьОписаниеСтраницыExcel("Титульная страница", Расшифровка.Шаблон, Ложь);
	
	ШаблонШапки = Неопределено;
	
	// Шапка для организации
	Если Не ПустаяСтрока(ДанныеОбОрганизации.КраткийКод) Тогда
		ШаблонШапки = ДобавитьШаблонОбластиСтраницыExcelПоГодовомуШаблону(
			"Шапка<Год>_" + ДанныеОбОрганизации.КраткийКод, ДанныеРасшифровки.ШаблонРасшифровки, ШаблонТитульнойСтраницы);;
	КонецЕсли;
	
	// Шапка общего вида
	Если ШаблонШапки = Неопределено Тогда
		ШаблонШапки = ДобавитьШаблонОбластиСтраницыExcelПоГодовомуШаблону(
			"Шапка<Год>", ДанныеРасшифровки.ШаблонРасшифровки, ШаблонТитульнойСтраницы);
	КонецЕсли;
	
	Если ШаблонШапки <> Неопределено Тогда

		ШаблонГруппаПоказателей	= ДобавитьШаблонОбластиСтраницыExcel("ГруппаПоказателей" + ДанныеРасшифровки.ШаблонРасшифровки, ШаблонТитульнойСтраницы);
