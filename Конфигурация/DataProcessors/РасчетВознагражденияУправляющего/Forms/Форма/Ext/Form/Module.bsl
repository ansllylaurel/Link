	ОбластьДвиженияАктивов.Вставить("КолонкаДнейДоВывода",	"I");	
	
	СтраницаРасчета.Области.Вставить("ДвиженияАктивовСМинимальнымДоходом" + СуффиксПоказателей, ОбластьДвиженияАктивов); 	
	
