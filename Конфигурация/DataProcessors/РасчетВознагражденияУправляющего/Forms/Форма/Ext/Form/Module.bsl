				ВсегоВводов				= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_ВводыАктивовСНачалаГодаРазвернуто" + ?(СуффиксПоказателей = "Рынок", "", СуффиксПоказателей)].Количество() - ?(ДанныеРасшифровки.ДоговорЗаключенДоТекущегоГода, 1, 0);
				ВсегоВыводов			= РасшифровкаРасчетаПоБазе.ТаблицыРасшифровкиРасчета["_ВыводыАктивовСНачалаГодаРазвернуто"].Количество();
				ВсегоДвижений			= Макс(ВсегоВводов, ВсегоВыводов);
