				"ДнейВГоду",
				ДеньГода(КонецГода(ДанныеРасшифровки.НачалоРасчетногоПериода)));
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
				ОбластьРасчетВознаграждения,
				"СреднедневнаяСтоимостьАктивов",
				"=СРЗНАЧ(" + ПараметрыЛистаСтоимостиАктивовПоДням.КлючевыеЯчейки["СтоимостьАктивовПоДням" + СуффиксПоказателей].Address(Ложь, Ложь, , Истина) + ")");
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
				ОбластьРасчетВознаграждения,
				"СтавкаИД",
				Формат(РасшифровкаРасчетаПоБазе.СтавкаИД, "ЧН=0; ЧГ=; ЧФ=Ч%"));
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
				ОбластьРасчетВознаграждения,
				"НижнийПроцентОтСредней",
				Формат(РасшифровкаРасчетаПоБазе.НижнийПроцентОтСредней, "ЧН=0; ЧГ=; ЧФ=Ч%"));
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьЗначениеПараметраОбласти(
