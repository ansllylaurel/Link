			// Добавляем отступ для следующих расчетов
			СтраницаРасчета.ВсегоСтрок = СтраницаРасчета.ВсегоСтрок + 2;
			
			#КонецОбласти
		ИначеЕсли РасшифровкаРасчетаПоБазе.БазаРасчета = ПредопределенноеЗначение("Справочник.БазыРасчета.ПревышениеНадМинимальнымДоходом")
