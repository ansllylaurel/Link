			СуффиксПоказателей = ?(РасчетПоБалансовойСтоимости, "Баланс", "Рынок");
			
			// Ввод-вывод активов
			ОбластьДвиженияАктивов = ВывестиДвиженияАктивовСМинимальнымИГарантированнымДоходомExcel(ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка, СуффиксПоказателей);
				
			// Расчёт инвестиционного дохода
			ОписаниеОбластиИнвестиционногоДохода = ВывестиИнвестиционныйДоходExcel(
				ДанныеРасшифровки, РасшифровкаРасчетаПоБазе, Расшифровка, РасчетПоБалансовойСтоимости,
