
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ВариантРасчета = 3 Тогда // НПФ
		ПроверяемыеРеквизиты.Добавить("ПериодичностьРасчета");	
		ПроверяемыеРеквизиты.Добавить("ВидВознаграждения");	
	КонецЕсли;
	
КонецПроцедуры

#Область Вознаграждение_по_настройкам_расчета

Функция ВыбратьДанныеПоРасчетуВознагражденияУправляющего(Знач Отбор = Неопределено, РасшифровкаРасчета = Неопределено) Экспорт
	
	Если Отбор = Неопределено Тогда
		Отбор = Новый Структура;
	КонецЕсли;
	
	#Область Текст_запроса_настроек_расчета	
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Наименование КАК Наименование,
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	СчетаДоверительногоУправления.КодСчета КАК КодСчета,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
		|	СчетаДоверительногоУправления.Организация.ВалютаУчета КАК ВалютаУчета,
		|	КлиентыДУ.Клиент КАК Клиент,
		|	ВЫБОР
		|		КОГДА &ПериодичностьРасчета = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежемесячно)
		|			ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
		|		КОГДА &ПериодичностьРасчета = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально)
		|			ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, КВАРТАЛ)
		|		КОГДА &ПериодичностьРасчета = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно)
		|			ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, ГОД)
		|	КОНЕЦ КАК НачалоБазовогоПериода,
		|	ВЫБОР
		|		КОГДА СчетаДоверительногоУправления.ДатаЗаключения <> ДАТАВРЕМЯ(1, 1, 1)
		|				И СчетаДоверительногоУправления.ДатаЗаключения > ВЫБОР
		|					КОГДА &ПериодичностьРасчета = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежемесячно)
		|						ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
		|					КОГДА &ПериодичностьРасчета = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально)
		|						ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, КВАРТАЛ)
		|					КОГДА &ПериодичностьРасчета = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно)
		|						ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, ГОД)
		|				КОНЕЦ
		|			ТОГДА СчетаДоверительногоУправления.ДатаЗаключения
		|		ИНАЧЕ ВЫБОР
		|				КОГДА &ПериодичностьРасчета = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежемесячно)
		|					ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
		|				КОГДА &ПериодичностьРасчета = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально)
		|					ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, КВАРТАЛ)
		|				КОГДА &ПериодичностьРасчета = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно)
		|					ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, ГОД)
		|			КОНЕЦ
		|	КОНЕЦ КАК НачалоБазовогоПериодаДляОтображения,
		|	ВЫБОР
		|		КОГДА &ПериодичностьРасчета = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежемесячно)
		|			ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
		|		КОГДА &ПериодичностьРасчета = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально)
		|			ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, КВАРТАЛ)
		|		КОГДА &ПериодичностьРасчета = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно)
		|			ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, ГОД)
		|	КОНЕЦ КАК КонецБазовогоПериода,
		|	ВЫБОР
		|		КОГДА СчетаДоверительногоУправления.ДатаРасторжения <> ДАТАВРЕМЯ(1, 1, 1)
		|				И СчетаДоверительногоУправления.ДатаРасторжения < ВЫБОР
		|					КОГДА &ПериодичностьРасчета = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежемесячно)
		|						ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
		|					КОГДА &ПериодичностьРасчета = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально)
		|						ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, КВАРТАЛ)
		|					КОГДА &ПериодичностьРасчета = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно)
		|						ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, ГОД)
		|				КОНЕЦ
		|			ТОГДА СчетаДоверительногоУправления.ДатаРасторжения
		|		ИНАЧЕ ВЫБОР
		|				КОГДА &ПериодичностьРасчета = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежемесячно)
		|					ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
		|				КОГДА &ПериодичностьРасчета = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально)
		|					ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, КВАРТАЛ)
		|				КОГДА &ПериодичностьРасчета = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно)
		|					ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, ГОД)
		|			КОНЕЦ
		|	КОНЕЦ КАК КонецБазовогоПериодаДляОтображения
		|ПОМЕСТИТЬ _КлиентыДействующиеНаДатуРасчета
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаРасчета, ) КАК КлиентыДУ
		|		ПО (КлиентыДУ.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= НАЧАЛОПЕРИОДА(&ДатаРасчета, ДЕНЬ))
		|	И НЕ СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда))
		|	И &ФильтрСчетовДоверительногоУправления
		|	И &ФильтрКлиентов
		|	И &ФильтрВидовДоговораДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлиентыДействующиеНаДатуРасчета.Организация КАК Организация,
		|	_КлиентыДействующиеНаДатуРасчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _КлиентыДействующиеВБазовомПериоде
		|ИЗ
		|	_КлиентыДействующиеНаДатуРасчета КАК _КлиентыДействующиеНаДатуРасчета
		|ГДЕ
		|	_КлиентыДействующиеНаДатуРасчета.ДатаЗаключения <= _КлиентыДействующиеНаДатуРасчета.КонецБазовогоПериода
		|	И (_КлиентыДействующиеНаДатуРасчета.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ _КлиентыДействующиеНаДатуРасчета.ДатаРасторжения >= _КлиентыДействующиеНаДатуРасчета.НачалоБазовогоПериода)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлиентыДействующиеВБазовомПериоде.Организация КАК Организация,
		|	_КлиентыДействующиеВБазовомПериоде.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ТекущиеНастройкиКлиентов.НастройкаРасчета КАК НастройкаРасчета,
		|	ТекущиеНастройкиКлиентов.Основание КАК ОснованиеНастроекРасчета,
		|	ТекущиеНастройкиКлиентов.Период КАК ДатаНастроекРасчета,
		|	ТекущиеНастройкиКлиентов.ШаблонРасшифровки КАК ШаблонРасшифровки,
		|	ТекущиеНастройкиКлиентов.ШаблонАкта КАК ШаблонАкта,
		|	НастройкиРасчетаВознаграждения.ВалютаРасчета КАК ВалютаРасчета,
		|	СоставляющиеНастройкиРасчета.Периодичность КАК ПериодичностьРасчета,
		|	СоставляющиеНастройкиРасчета.БазаРасчета КАК БазаРасчета,
		|	СоставляющиеНастройкиРасчета.ПараметрыРасчета КАК ПараметрыБазыРасчета,
		|	СоставляющиеНастройкиРасчета.Представление КАК Представление
		|ПОМЕСТИТЬ _НастройкиРасчетаВознаграждения
		|ИЗ
		|	_КлиентыДействующиеВБазовомПериоде КАК _КлиентыДействующиеВБазовомПериоде
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиРасчетаВознагражденияУправляющего.СрезПоследних(
		|				&ДатаРасчета,
		|				(Организация, СчетДоверительногоУправления, ВидВознаграждения) В
		|					(ВЫБРАТЬ
		|						_КлиентыДействующиеВБазовомПериоде.Организация,
		|						_КлиентыДействующиеВБазовомПериоде.СчетДоверительногоУправления,
		|						&ВидВознаграждения
		|					ИЗ
		|						_КлиентыДействующиеВБазовомПериоде)) КАК ТекущиеНастройкиКлиентов
		|		ПО (ТекущиеНастройкиКлиентов.СчетДоверительногоУправления = _КлиентыДействующиеВБазовомПериоде.СчетДоверительногоУправления)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НастройкиРасчета КАК НастройкиРасчетаВознаграждения
		|		ПО (НастройкиРасчетаВознаграждения.Ссылка = ТекущиеНастройкиКлиентов.НастройкаРасчета)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НастройкиРасчета.Составляющие КАК СоставляющиеНастройкиРасчета
		|		ПО (СоставляющиеНастройкиРасчета.Ссылка = ТекущиеНастройкиКлиентов.НастройкаРасчета)
		|			И (СоставляющиеНастройкиРасчета.Периодичность = &ПериодичностьРасчета)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_НастройкиРасчетаВознаграждения.Организация КАК Организация,
		|	_НастройкиРасчетаВознаграждения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_НастройкиРасчетаВознаграждения.НастройкаРасчета КАК НастройкаРасчета,
		|	_НастройкиРасчетаВознаграждения.ДатаНастроекРасчета КАК ДатаНастроекРасчета,
		|	_НастройкиРасчетаВознаграждения.ОснованиеНастроекРасчета КАК ОснованиеНастроекРасчета,
		|	_НастройкиРасчетаВознаграждения.ВалютаРасчета КАК ВалютаРасчета,
		|	_НастройкиРасчетаВознаграждения.ШаблонРасшифровки КАК ШаблонРасшифровки,
		|	_НастройкиРасчетаВознаграждения.ШаблонАкта КАК ШаблонАкта
		|ПОМЕСТИТЬ _КлиентыСНастройкамиРасчета
		|ИЗ
		|	_НастройкиРасчетаВознаграждения КАК _НастройкиРасчетаВознаграждения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлиентыДействующиеНаДатуРасчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НАЧАЛОПЕРИОДА(МИНИМУМ(ВводыАктивов.Период), ДЕНЬ) КАК ДатаПервогоВвода
		|ПОМЕСТИТЬ _ПервыеВводыАктивов
		|ИЗ
		|	_КлиентыДействующиеНаДатуРасчета КАК _КлиентыДействующиеНаДатуРасчета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КлиентыСНастройкамиРасчета КАК _КлиентыСНастройкамиРасчета
		|		ПО (_КлиентыСНастройкамиРасчета.СчетДоверительногоУправления = _КлиентыДействующиеНаДатуРасчета.СчетДоверительногоУправления)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыАктивов
		|		ПО (ВводыАктивов.Организация = _КлиентыДействующиеНаДатуРасчета.Организация)
		|			И (ВводыАктивов.СчетДоверительногоУправления = _КлиентыДействующиеНаДатуРасчета.СчетДоверительногоУправления)
		|			И (ВводыАктивов.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход))
		|			И (ВводыАктивов.Период <= _КлиентыДействующиеНаДатуРасчета.КонецБазовогоПериода)
		|
		|СГРУППИРОВАТЬ ПО
		|	_КлиентыДействующиеНаДатуРасчета.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлиентыДействующиеНаДатуРасчета.Наименование КАК Наименование,
		|	_КлиентыДействующиеНаДатуРасчета.Организация КАК Организация,
		|	_КлиентыДействующиеНаДатуРасчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_КлиентыДействующиеНаДатуРасчета.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	_КлиентыДействующиеНаДатуРасчета.КодСчета КАК КодСчета,
		|	_КлиентыДействующиеНаДатуРасчета.НомерДоговора КАК НомерДоговора,
		|	_КлиентыДействующиеНаДатуРасчета.ДатаЗаключения КАК ДатаЗаключения,
		|	_КлиентыДействующиеНаДатуРасчета.ДатаРасторжения КАК ДатаРасторжения,
		|	_КлиентыДействующиеНаДатуРасчета.ВалютаУчета КАК ВалютаУчета,
		|	_КлиентыДействующиеНаДатуРасчета.НачалоБазовогоПериода КАК НачалоБазовогоПериода,
