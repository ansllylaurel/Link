	Для каждого СтрокаДанных Из _ДанныеПоРасчетуВознагражденияУправляющего.Вознаграждения Цикл
		
		Если СтрокаДанных.СуммаВознаграждения = 0 Тогда 
			Продолжить;
		КонецЕсли;
		
		ОбластьОтчета = МакетОтчета.ПолучитьОбласть("СтрокаОтчета");
		ОбластьОтчета.Параметры.Заполнить(СтрокаДанных);
		ОбластьОтчета.Параметры.НомерДоговораДУ = СтрокаДанных.НомерДоговора;
		ОбластьОтчета.Параметры.ДатаДоговораДУ  = Формат(СтрокаДанных.ДатаЗаключения, "ДФ=dd.MM.yyyy");
		ОбластьОтчета.Параметры.НомерСтроки     = НомерСтроки;
		ОбластьОтчета.Параметры.БазаДляРасчета  = СтрокаДанных.СредняяОценочнаяСтоимость;
	
		ФормаРасчета.Вывести(ОбластьОтчета);
		
		НомерСтроки = НомерСтроки + 1;
	
	КонецЦикла; 
	
	// Итог
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Итого");
	ОбластьОтчета.Параметры.БазаДляРасчета 		= _ДанныеПоРасчетуВознагражденияУправляющего.Вознаграждения.Итог("СредняяОценочнаяСтоимость");
	ОбластьОтчета.Параметры.СуммаВознаграждения = _ДанныеПоРасчетуВознагражденияУправляющего.Вознаграждения.Итог("СуммаВознаграждения");
	ОбластьОтчета.Параметры.СуммаНДС = Окр(ОбластьОтчета.Параметры.СуммаВознаграждения * СтавкаНДС, 2, 1);
	ИтогоНДС = ИтогоНДС + ОбластьОтчета.Параметры.СуммаНДС;
	
	ФормаРасчета.Вывести(ОбластьОтчета);

	// подвал
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("ПодвалОтчета");
	ОбластьОтчета.Параметры.Подписант = СокрЛП(Подписант);
	ОбластьОтчета.Параметры.ПодписантДолжность = СокрЛП(ПодписантДолжность);
				
	// подвал
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("ПодвалОтчета");
	ОбластьОтчета.Параметры.Подписант = СокрЛП(Подписант);
	ОбластьОтчета.Параметры.ПодписантДолжность = СокрЛП(ПодписантДолжность);
	 	
	Итого		= _ДанныеПоРасчетуВознагражденияУправляющего.ВознагражденияПлатаЗаРазмещение.Итог("СуммаВознаграждения") + _ДанныеПоРасчетуВознагражденияУправляющего.Вознаграждения.Итог("СуммаВознаграждения");
			
	ОбластьОтчета.Параметры.Итого		= Формат(Итого, 	"ЧДЦ=2");
	ОбластьОтчета.Параметры.ИтогоНДС	= Формат(ИтогоНДС, 	"ЧДЦ=2");
	
	ОбластьОтчета.Параметры.ИтогоПрописью 		= ЧислоПрописью(Итого, 		"Л = ru_RU; НП = Истина; НД = Истина", "рубль,рубля,рублей,м,копейка,копейки,копеек, ж,2");
	ОбластьОтчета.Параметры.ИтогоНДСПрописью	= ЧислоПрописью(ИтогоНДС,	"Л = ru_RU; НП = Истина; НД = Истина", "рубль,рубля,рублей,м,копейка,копейки,копеек, ж,2");
	
	ФормаРасчета.Вывести(ОбластьОтчета);
		
	ФормаРасчета.ОтображатьЗаголовки = Ложь;
	ФормаРасчета.ОтображатьСетку = Ложь;
	ФормаРасчета.Защита = Ложь;
	ФормаРасчета.ТолькоПросмотр = Истина;
	ФормаРасчета.АвтоМасштаб = Истина;

	Возврат ФормаРасчета;
	
КонецФункции // СформироватьФормуРасчетаВознагражденияАгентаДВБ

Функция СформироватьФормуРасчетаВознагражденияПлатаЗаРазмещение(ТаблицаДатИСчетовДУ, ДанныеПоРасчетуВознагражденияУправляющего, ВыводитьШапкуИПодвал = Истина, Подписант = "") Экспорт

	Если ТипЗнч(ДанныеПоРасчетуВознагражденияУправляющего) <> Тип("ХранилищеЗначения") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сначала необходимо выполнить расчет вознаграждения");
		Возврат Неопределено;
	КонецЕсли;
	
	ФормаРасчета = Новый ТабличныйДокумент;
	Если ТаблицаДатИСчетовДУ.Количество() = 0 Тогда
		Возврат ФормаРасчета;
	КонецЕсли;
	
	РеквизитыОрганизации = ПолучитьРеквизитыОрганизацииАнкетные(ЭтотОбъект.Организация, ЭтотОбъект.ДатаРасчета);
	МакетОтчета = ЭтотОбъект.ПолучитьМакет("РасчетВознагражденияПлатаЗаРазмещениеПоИИСДляФормы482");
	
	_ДанныеПоРасчетуВознагражденияУправляющего = ДанныеПоРасчетуВознагражденияУправляющего.Получить();
	ВознаграждениеПлатаЗаРазмещение = _ДанныеПоРасчетуВознагражденияУправляющего.ВознагражденияПлатаЗаРазмещение;
	Если ВознаграждениеПлатаЗаРазмещение.Количество() = 0 Тогда
		ВызватьИсключение "Ошибка печати расчета вознаграждения: вознаграждение (плата за размещение) отсутствует";
	КонецЕсли;	
	
	ВознаграждениеПлатаЗаРазмещение.Свернуть("СчетДоверительногоУправления, Период, Стратегия, Ставка, ДатаЗаключения, НомерДоговора", "БалансоваяСтоимость, СуммаВознаграждения");
	
	МассивСчетовДУ = ТаблицаДатИСчетовДУ.ВыгрузитьКолонку("СчетДоверительногоУправления");
	РаботаСКоллекциями.УдалитьПовторяющиесяЗначенияМассива(МассивСчетовДУ);
	
	РеквизитыСчетовДУ = ПолучитьРеквизитыСчетовДоверительногоУправления(МассивСчетовДУ, Истина);
	
	ОбластьШапка  = МакетОтчета.ПолучитьОбласть("ШапкаОтчета");
	ОбластьПодвал = МакетОтчета.ПолучитьОбласть("ПодвалОтчета");
	
	// Выводим данные
	// Если ВыводитьШапку = Истина, то нужно выводить отдельно каждую строчку с заголовком и подвалом;
	// если Ложь, нужно группировать по счету ДУ
	
	Для Каждого СчетДУ Из МассивСчетовДУ Цикл
		
		НайдСтрокиВознаграждения = ВознаграждениеПлатаЗаРазмещение.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", СчетДУ));
		Если НайдСтрокиВознаграждения.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;	
		
		ПараметрыОтбора = Новый Структура("СчетДоверительногоУправления", СчетДУ);
		СтрокаРеквизитовСчетаДУ = РеквизитыСчетовДУ.НайтиСтроки(ПараметрыОтбора);
		
		Если СтрокаРеквизитовСчетаДУ.Количество() = 0 Тогда
			ВызватьИсключение "Ошибка печати расчета вознаграждения: не получены реквизиты счета ДУ";
		КонецЕсли;
		
		Если Не ВыводитьШапкуИПодвал Тогда
			ОбластьОтчета = МакетОтчета.ПолучитьОбласть("РазделСчетаДУ_Начало");
			ФормаРасчета.Вывести(ОбластьОтчета);
		КонецЕсли;
		
		МассивДат = Новый Массив;
		СуммаВознаграждения = 0;
		БалансоваяСтоимость = 0;
		
		Для Каждого СтрокаВознаграждения Из НайдСтрокиВознаграждения Цикл
			
			// Проверяем, чтобы у одного счета ДУ было только по одной строке с каждой датой
			Если МассивДат.Найти(СтрокаВознаграждения.Период) = Неопределено Тогда
				МассивДат.Добавить(СтрокаВознаграждения.Период);
			Иначе	
				ВызватьИсключение "Ошибка печати расчета вознаграждения: неоднозначное вознаграждение";
			КонецЕсли;
			
			Если ВыводитьШапкуИПодвал Тогда
				ОбластьШапка.Параметры.Заполнить(РеквизитыОрганизации);
				ОбластьШапка.Параметры.РасчетныйПериод = Формат(СтрокаВознаграждения.Период, "ДФ=dd.MM.yyyy");
				ФормаРасчета.Вывести(ОбластьШапка);
					
				ОбластьОтчета = МакетОтчета.ПолучитьОбласть("ШапкаРазделаСчетаДУ");
				ОбластьОтчета.Параметры.Заполнить(СтрокаРеквизитовСчетаДУ[0]);
				ОбластьОтчета.Параметры.ДатаДоговораДУ = Формат(СтрокаРеквизитовСчетаДУ[0].ДатаДоговораДУ, "ДФ=dd.MM.yyyy");
				ФормаРасчета.Вывести(ОбластьОтчета);
				
				ОбластьОтчета = МакетОтчета.ПолучитьОбласть("РазделСчетаДУ_Начало");
				ФормаРасчета.Вывести(ОбластьОтчета);
			КонецЕсли;	
			      			
			ОбластьОтчета = МакетОтчета.ПолучитьОбласть("РазделСчетаДУ_Строка");
			ОбластьОтчета.Параметры.Заполнить(СтрокаВознаграждения);
			ОбластьОтчета.Параметры.БалансоваяСтоимость = ФорматСуммы(СтрокаВознаграждения.БалансоваяСтоимость);
			
			СуммаВознаграждения = СуммаВознаграждения + СтрокаВознаграждения.СуммаВознаграждения;
			БалансоваяСтоимость = БалансоваяСтоимость + СтрокаВознаграждения.БалансоваяСтоимость;
					
			ФормаРасчета.Вывести(ОбластьОтчета);
												
			Если ВыводитьШапкуИПодвал Тогда
				ОбластьОтчета = МакетОтчета.ПолучитьОбласть("РазделСчетаДУ_Конец");
				ОбластьОтчета.Параметры.Заполнить(СтрокаВознаграждения);
				ОбластьОтчета.Параметры.БалансоваяСтоимость = ФорматСуммы(СтрокаВознаграждения.БалансоваяСтоимость);
				ОбластьОтчета.Параметры.СуммаВознаграждения = ФорматСуммы(СтрокаВознаграждения.СуммаВознаграждения);
				
				ФормаРасчета.Вывести(ОбластьОтчета);
				ОбластьПодвал.Параметры.Подписант = СокрЛП(Подписант);				
				ФормаРасчета.Вывести(ОбластьПодвал);
				ФормаРасчета.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
		
		КонецЦикла;
		
		Если Не ВыводитьШапкуИПодвал Тогда
			ОбластьОтчета = МакетОтчета.ПолучитьОбласть("РазделСчетаДУ_Конец");
			ОбластьОтчета.Параметры.Заполнить(СтрокаВознаграждения);
			ОбластьОтчета.Параметры.БалансоваяСтоимость = ФорматСуммы(БалансоваяСтоимость);
			ОбластьОтчета.Параметры.СуммаВознаграждения = ФорматСуммы(СуммаВознаграждения);
			ФормаРасчета.Вывести(ОбластьОтчета);
		КонецЕсли;
	
	КонецЦикла;
		
	// Наводим красоту
	ФормаРасчета.ОтображатьЗаголовки = Ложь;
	ФормаРасчета.ОтображатьСетку = Ложь;
	ФормаРасчета.Защита = Ложь;
	ФормаРасчета.ТолькоПросмотр = Истина;

	Возврат ФормаРасчета;
	
КонецФункции // СформироватьФормуРасчетаВознагражденияПлатаЗаРазмещение

Функция ПолучитьРеквизитыАгентаДляПечатиФормыРасчета()

	РеквизитыАгента = Новый Структура("НаименованиеАгента, ДатаДоговора, НомерДоговора");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ЮрФизЛица.Наименование) КАК НаименованиеАгента,
		|	Договоры.НомерДоговора КАК НомерДоговора,
		|	Договоры.ДатаЗаключения КАК ДатаДоговора
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний) И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|			ПО ЮрФизЛица.Ссылка = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ПО Договоры.Контрагент = ЮрФизЛица.Ссылка
		|ГДЕ
		|	Договоры.Ссылка = &АгентскийДоговор";
	
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.ДатаРасчета);
	Запрос.УстановитьПараметр("АгентскийДоговор", ЭтотОбъект.АгентскийДоговор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(РеквизитыАгента, Выборка);
	КонецЕсли;

	Возврат РеквизитыАгента;

КонецФункции

#КонецОбласти

#Область Вознаграждение_ПИФ

Функция ВыбратьДанныеПоРасчетуВознагражденияУправляющегоПоПИФ(СчетДоверительногоУправления = Неопределено) Экспорт
	
	// Вознаграждение управляющего для ПИФ
	// Проверим, правильный ли вариант выбран
	
	Если ЭтотОбъект.ВариантРасчета <> 2 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчет вознаграждения для выбранного варианта расчета не реализован");
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДатаРасчетаНачалоМесяца",		НачалоМесяца(ЭтотОбъект.ДатаРасчета));
	Запрос.УстановитьПараметр("ДатаРасчета",  					КонецДня(ЭтотОбъект.ДатаРасчета));
	Запрос.УстановитьПараметр("ДатаРасчетаНачалоДня",			НачалоДня(ЭтотОбъект.ДатаРасчета));
	Запрос.УстановитьПараметр("ДатаРасчетаГраница",				Новый Граница(КонецДня(ЭтотОбъект.ДатаРасчета), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ДатаНачалаРасчета",  			НачалоГода(ЭтотОбъект.ДатаРасчета));
	Запрос.УстановитьПараметр("Организация",   					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаРасчетаБез1Дня", 			Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ЭтотОбъект.ДатаРасчета), -2));
		
	// Помещаем счета доверительного управления во временную таблицу 
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Организация,
		|	КлиентыДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыДоверительногоУправления.Клиент КАК Клиент,
		|	КлиентыДоверительногоУправления.Период КАК Период,
		|	ПаевыеИнвестиционныеФонды.Тип КАК ТипПИФ,
		|	ДатаОкончанияФормированияПИФ.Значение КАК ДатаОкончанияФормированияПИФ,
		|	ЕСТЬNULL(ДатаОснованияДляПрекращенияПИФ.Значение, ДАТАВРЕМЯ(3999, 12, 31)) КАК ДатаОснованияДляПрекращенияПИФ,
		|	0 КАК СуммаВознаграждения,
		|	0 КАК СЧА,
		|	ЛОЖЬ КАК РасчетСЧА
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаРасчета, ) КАК РеквизитыПИФСрезПоследних
		|		ПО Организации.ЮрФизЛицо = РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
		|		ПО (КлиентыДоверительногоУправления.Клиент = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПаевыеИнвестиционныеФонды КАК ПаевыеИнвестиционныеФонды
		|		ПО (ПаевыеИнвестиционныеФонды.Ссылка = КлиентыДоверительногоУправления.Клиент)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО (СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправления.СчетДоверительногоУправления)
		|			И (СчетаДоверительногоУправления.Организация = &Организация)
		|			И (СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаРасчетаНачалоДня)
		|			И (СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаРасчетаНачалоМесяца
		|				ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ДатаОкончанияФормированияПИФ
		|		ПО (ДатаОкончанияФормированияПИФ.Объект = КлиентыДоверительногоУправления.Клиент)
		|			И (ДатаОкончанияФормированияПИФ.Свойство.Ключ = ""ДатаОкончанияФормированияПИФ"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ДатаОснованияДляПрекращенияПИФ
		|		ПО (ДатаОснованияДляПрекращенияПИФ.Объект = КлиентыДоверительногоУправления.Клиент)
		|			И (ДатаОснованияДляПрекращенияПИФ.Свойство.Ключ = ""ДатаВозникновенияОснованияПрекращенияФонда"")
		|ГДЕ
		|	Организации.Ссылка = &Организация
		|	И ДатаОкончанияФормированияПИФ.Значение ЕСТЬ НЕ NULL 
		|	И ЕСТЬNULL(ДатаОснованияДляПрекращенияПИФ.Значение, ДАТАВРЕМЯ(3999, 12, 31)) >= &ДатаРасчетаНачалоДня
		|	И &ФильтрСчетовДоверительногоУправления";
	
	Если ЗначениеЗаполнено(СчетДоверительногоУправления) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрСчетовДоверительногоУправления", "СчетаДоверительногоУправления.Ссылка В (&СчетДоверительногоУправления)");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрСчетовДоверительногоУправления", "ИСТИНА");
	КонецЕсли;
	
	Запрос.Выполнить();

	// Получаем графики СЧА от последнего рабочего дня прошлого года (т. к. он нужен для ЗПИФ)
	ПоследнийРабочийДеньПрошлогоГода = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоГода(ЭтотОбъект.ДатаРасчета), -1);
	
	Справочники.НастройкиРегламентныхДействий.ПоместитьДатыДействияЗаПериодВоВременнуюТаблицу(Запрос,
		Новый Структура("ВидДействия, ДатаС, ДатаПо, ДополнитьРабочимиДнями, ИмяТаблицыДатДействияЗаПериод",
			"СЧА", ПоследнийРабочийДеньПрошлогоГода, КонецДня(ЭтотОбъект.ДатаРасчета), Ложь, "_КалендарьСЧАОбщий"));
		
	// Выгрузим список счетов ДУ, чтобы затем получить данные календаря для первого из них
	СчетаДУ = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_СчетаДоверительногоУправления").ПолучитьДанные().Выгрузить(); 
	Если СчетаДУ.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Справочники.Календари.ПоместитьВЗапросДанныеКалендаря(СчетаДУ[0].СчетДоверительногоУправления, ЭтотОбъект.ДатаРасчета, Справочники.Календари.Общероссийский, "Рабочий, Предпраздничный", НачалоГода(ЭтотОбъект.ДатаРасчета), КонецГода(ЭтотОбъект.ДатаРасчета), Запрос.МенеджерВременныхТаблиц, "_РабочиеДни", Истина);	
	
	// Получаем таблицу СЧА, зарегистрированных на дату расчета
	Запрос.Текст =		
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказатели.СубъектАналитики КАК СчетДоверительногоУправления,
		|	ФинансовыеПоказатели.Значение КАК СЧА,
		|	ЕСТЬNULL(РезервыПИФОстаткиИОбороты.СуммаНачальныйОстаток, 0) + ЕСТЬNULL(РезервыПИФОстаткиИОбороты.СуммаПриход, 0) КАК ОстатокРезерваУК,
		|	ЕСТЬNULL(РезервыПИФОстаткиИОбороты.СуммаРасход, 0) > 0 КАК ВознаграждениеНачислено
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РезервыПИФ.ОстаткиИОбороты(
		|				&ДатаРасчетаНачалоДня,
		|				&ДатаРасчетаГраница,
		|				,
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В
		|						(ВЫБРАТЬ
		|							_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|						ИЗ
		|							_СчетаДоверительногоУправления)
		|					И Резерв = ЗНАЧЕНИЕ(Справочник.Резервы.ВознаграждениеУправляющего)) КАК РезервыПИФОстаткиИОбороты
		|		ПО ФинансовыеПоказатели.СубъектАналитики = РезервыПИФОстаткиИОбороты.СчетДоверительногоУправления
		|ГДЕ
		|	ФинансовыеПоказатели.Период = &ДатаРасчетаНачалоДня
		|	И ФинансовыеПоказатели.Организация = &Организация
		|	И ФинансовыеПоказатели.СубъектАналитики В
		|			(ВЫБРАТЬ
		|				_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления)
		|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|	И ТИПЗНАЧЕНИЯ(ФинансовыеПоказатели.Регистратор) = ТИП(Документ.РегистрацияСтоимостиАктивов)
		|	И ФинансовыеПоказатели.Активность";
	
	ЗарегистрированныеСЧА = Запрос.Выполнить().Выгрузить();	
	
	// Пока не реализовано начисление вознаграждения вместе с расчетом СЧА за один проход, 
	// для печатной формы нужно получать значение расчетной СЧА в день расчета вознаграждения
	Для Каждого СтрокаСчетаДУ Из СчетаДУ Цикл
		
		// Проверяем наличие зарегистрированных стоимостей
		НайдСЧА = ЗарегистрированныеСЧА.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", СтрокаСчетаДУ.СчетДоверительногоУправления));
	    	
		Если НайдСЧА.Количество() = 0 Тогда
					
			// Без готовой СЧА вознаграждение не рассчитываем
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
											СтрШаблон("Для счета доверительного управления '%1' не зарегистрирована СЧА на %2", 
														СтрокаСчетаДУ.СчетДоверительногоУправления, 
														Формат(ЭтотОбъект.ДатаРасчета, "ДФ=dd.MM.yyyy")), 
											СтрокаСчетаДУ.СчетДоверительногоУправления);
			Продолжить;
						
		КонецЕсли;	
		
		Если НайдСЧА[0].ВознаграждениеНачислено Тогда
			
			СтрокаСчетаДУ.СЧА 					= НайдСЧА[0].СЧА;
			СтрокаСчетаДУ.РасчетСЧА 			= Истина;
			СтрокаСчетаДУ.СуммаВознаграждения	= НайдСЧА[0].ОстатокРезерваУК;
			
		Иначе
			
			// Рассчитываем СЧА "с нуля"
			УстановитьПривилегированныйРежим(Истина);	
			
			ПараметрыРасчета = Новый Структура("Организация, ВидДоговораДоверительногоУправления", Организация, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда);

			ПараметрыРасчета.Вставить("Период",							НачалоДня(ДатаРасчета));
			ПараметрыРасчета.Вставить("Дата",							КонецДня(ДатаРасчета));
			ПараметрыРасчета.Вставить("СчетДоверительногоУправления",	СтрокаСчетаДУ.СчетДоверительногоУправления);
			ПараметрыРасчета.Вставить("ЦельРасчета",					Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
			ПараметрыРасчета.Вставить("ВалютаУчета",					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета"));
			ПараметрыРасчета.Вставить("ВалютаРубли",					ПараметрыРасчета.ВалютаУчета);	
			
			НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(ПараметрыРасчета.Дата, ПараметрыРасчета.Организация, ПараметрыРасчета.СчетДоверительногоУправления, ПараметрыРасчета.ЦельРасчета);
			
			ПараметрыРасчета.Вставить("ВариантРасчетаОценочнойСтоимости",	НастройкиОценки.ВариантРасчетаОценочнойСтоимости); 
			ПараметрыРасчета.Вставить("ВидУчета",							НастройкиОценки.ВидУчетаДляОстатковПартий);
			ПараметрыРасчета.Вставить("АдресТаблицыСтоимостей",				Неопределено); 
				
			РегистрацияСтоимостиАктивов = Документы.РегистрацияСтоимостиАктивов.СоздатьДокумент();				
			РегистрацияСтоимостиАктивов.Дата                         	= КонецДня(ЭтотОбъект.ДатаРасчета);
			РегистрацияСтоимостиАктивов.Организация                  	= Организация;
			РегистрацияСтоимостиАктивов.Ответственный                	= РаботаСПользователями.ТекущийПользователь();
			РегистрацияСтоимостиАктивов.СчетДоверительногоУправления 	= СтрокаСчетаДУ.СчетДоверительногоУправления;
			РегистрацияСтоимостиАктивов.ЦельРасчетаСтоимостиОценки 		= Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;				
			
			Отказ = Ложь;
			РегистрацияСтоимостиАктивов.ЗаполнитьДокументыРегистрацииСтоимости(ПараметрыРасчета, Ложь, Отказ);
			
			ПредварительнаяСЧА = ?(РегистрацияСтоимостиАктивов.ДополнительныеСвойства.Свойство("НачислениеРезервовПИФ")
									И РегистрацияСтоимостиАктивов.ДополнительныеСвойства.НачислениеРезервовПИФ.ДополнительныеСвойства.Свойство("СЧАРасчетная"), 
								РегистрацияСтоимостиАктивов.ДополнительныеСвойства.НачислениеРезервовПИФ.ДополнительныеСвойства.СЧАРасчетная, 
								0);
			УстановитьПривилегированныйРежим(Ложь);	
			
			Если Отказ Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Ошибка расчета вознаграждения по %1", СтрокаСчетаДУ.СчетДоверительногоУправления),СтрокаСчетаДУ.СчетДоверительногоУправления);
				Продолжить;
			КонецЕсли;
			
			СтрокаСчетаДУ.СЧА 					= ПредварительнаяСЧА;
			СтрокаСчетаДУ.РасчетСЧА				= Истина;
			СтрокаСчетаДУ.СуммаВознаграждения	= НайдСЧА[0].ОстатокРезерваУК;
			
		КонецЕсли;
		
	КонецЦикла;	
		
	СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(Запрос, "_СчетаДоверительногоУправления");
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДУ.Организация КАК Организация,
		|	СчетаДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СчетаДУ.Клиент КАК Клиент,
		|	СчетаДУ.Период КАК Период,
		|	СчетаДУ.ТипПИФ КАК ТипПИФ,
		|	СчетаДУ.ДатаОкончанияФормированияПИФ КАК ДатаОкончанияФормированияПИФ,
		|	СчетаДУ.ДатаОснованияДляПрекращенияПИФ КАК ДатаОснованияДляПрекращенияПИФ,
		|	СчетаДУ.СуммаВознаграждения КАК СуммаВознаграждения,
		|	СчетаДУ.СЧА КАК СЧА,
		|	СчетаДУ.РасчетСЧА КАК РасчетСЧА
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	&СчетаДУ КАК СчетаДУ";
	
	Запрос.УстановитьПараметр("СчетаДУ", СчетаДУ);
	
	Запрос.Выполнить();
		
	#Область Текст_запроса
	
	 //Условие расчета:
	 // СЧА должна быть рассчитана за весь период расчета				
	Запрос.Текст =					
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	    |	_КалендарьСЧАОбщий.Организация КАК Организация,
	    |	_КалендарьСЧАОбщий.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	    |	ВЫБОР
	    |		КОГДА _СчетаДоверительногоУправления.ДатаОкончанияФормированияПИФ > _КалендарьСЧАОбщий.Дата
	    |			ТОГДА _СчетаДоверительногоУправления.ДатаОкончанияФормированияПИФ
	    |		КОГДА _СчетаДоверительногоУправления.ДатаОснованияДляПрекращенияПИФ < _КалендарьСЧАОбщий.Дата
	    |			ТОГДА _СчетаДоверительногоУправления.ДатаОснованияДляПрекращенияПИФ
	    |		ИНАЧЕ _КалендарьСЧАОбщий.Дата
	    |	КОНЕЦ КАК Дата
	    |ПОМЕСТИТЬ _КалендарьСЧА
	    |ИЗ
	    |	_КалендарьСЧАОбщий КАК _КалендарьСЧАОбщий
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
	    |		ПО _КалендарьСЧАОбщий.СчетДоверительногоУправления = _СчетаДоверительногоУправления.СчетДоверительногоУправления
	    |			И _КалендарьСЧАОбщий.Организация = _СчетаДоверительногоУправления.Организация
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_СчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	    |	_СчетаДоверительногоУправления.Клиент КАК Клиент,
	    |	_РабочиеДни.Дата КАК Дата
	    |ПОМЕСТИТЬ _ДниСуммированияСЧА
	    |ИЗ
	    |	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
	    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _РабочиеДни КАК _РабочиеДни
	    |		ПО (_РабочиеДни.Дата >= _СчетаДоверительногоУправления.Период)
	    |			И (_РабочиеДни.Дата МЕЖДУ &ДатаНачалаРасчета И &ДатаРасчета)
	    |			И (_СчетаДоверительногоУправления.ДатаОкончанияФормированияПИФ ЕСТЬ NULL
	    |				ИЛИ _РабочиеДни.Дата >= _СчетаДоверительногоУправления.ДатаОкончанияФормированияПИФ)
	    |			И (_СчетаДоверительногоУправления.ДатаОснованияДляПрекращенияПИФ ЕСТЬ NULL
	    |				ИЛИ _РабочиеДни.Дата <= _СчетаДоверительногоУправления.ДатаОснованияДляПрекращенияПИФ)
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_СчетаДоверительногоУправления.Организация КАК Организация,
	    |	_СчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	    |	_ДниСуммированияСЧА.Дата КАК Дата,
	    |	_ДниСуммированияСЧА.Дата КАК ДатаСЧА
	    |ПОМЕСТИТЬ _ДатыРасчетаСЧА
	    |ИЗ
	    |	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _ДниСуммированияСЧА КАК _ДниСуммированияСЧА
	    |		ПО (_ДниСуммированияСЧА.СчетДоверительногоУправления = _СчетаДоверительногоУправления.СчетДоверительногоУправления)
	    |ГДЕ
	    |	_СчетаДоверительногоУправления.ТипПИФ = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Открытый)
	    |
	    |ОБЪЕДИНИТЬ ВСЕ
	    |
	    |ВЫБРАТЬ
	    |	_СчетаДоверительногоУправления.Организация,
	    |	_СчетаДоверительногоУправления.СчетДоверительногоУправления,
	    |	_ДниСуммированияСЧА.Дата,
	    |	МАКСИМУМ(_КалендарьСЧА.Дата)
	    |ИЗ
	    |	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _ДниСуммированияСЧА КАК _ДниСуммированияСЧА
	    |		ПО (_ДниСуммированияСЧА.СчетДоверительногоУправления = _СчетаДоверительногоУправления.СчетДоверительногоУправления)
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _КалендарьСЧА КАК _КалендарьСЧА
