			|					ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
			|				КОГДА УсловияАгентскихДоговоровСрезПоследних.ПериодичностьРасчетаВознаграждения = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально)
			|					ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, КВАРТАЛ)
			|				КОГДА УсловияАгентскихДоговоровСрезПоследних.ПериодичностьРасчетаВознаграждения = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно)
			|					ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, ГОД)
			|			КОНЕЦ
			|	КОНЕЦ КАК НачалоБазовогоПериодаДляОтображения,
			|	ВЫБОР
			|		КОГДА УсловияАгентскихДоговоровСрезПоследних.ПериодичностьРасчетаВознаграждения = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежемесячно)
			|			ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
			|		КОГДА УсловияАгентскихДоговоровСрезПоследних.ПериодичностьРасчетаВознаграждения = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально)
			|			ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, КВАРТАЛ)
			|		КОГДА УсловияАгентскихДоговоровСрезПоследних.ПериодичностьРасчетаВознаграждения = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно)
			|			ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, ГОД)
			|	КОНЕЦ КАК КонецБазовогоПериода,
			|	ВЫБОР
			|		КОГДА СчетаДоверительногоУправления.ДатаРасторжения <> ДАТАВРЕМЯ(1, 1, 1)
			|				И СчетаДоверительногоУправления.ДатаРасторжения < ВЫБОР
			|					КОГДА УсловияАгентскихДоговоровСрезПоследних.ПериодичностьРасчетаВознаграждения = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежемесячно)
			|						ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
			|					КОГДА УсловияАгентскихДоговоровСрезПоследних.ПериодичностьРасчетаВознаграждения = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально)
			|						ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, КВАРТАЛ)
			|					КОГДА УсловияАгентскихДоговоровСрезПоследних.ПериодичностьРасчетаВознаграждения = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно)
			|						ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, ГОД)
			|				КОНЕЦ
			|			ТОГДА СчетаДоверительногоУправления.ДатаЗаключения
			|		ИНАЧЕ ВЫБОР
			|				КОГДА УсловияАгентскихДоговоровСрезПоследних.ПериодичностьРасчетаВознаграждения = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежемесячно)
			|					ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
			|				КОГДА УсловияАгентскихДоговоровСрезПоследних.ПериодичностьРасчетаВознаграждения = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально)
			|					ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, КВАРТАЛ)
			|				КОГДА УсловияАгентскихДоговоровСрезПоследних.ПериодичностьРасчетаВознаграждения = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно)
			|					ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, ГОД)
			|			КОНЕЦ
			|	КОНЕЦ КАК КонецБазовогоПериодаДляОтображения,
			|	ЕСТЬNULL(УсловияАгентскихДоговоровСрезПоследних.СтавкаВознагражденияЗаПривлечение, 0) КАК СтавкаВознагражденияЗаПривлечение,
			|	ЕСТЬNULL(УсловияАгентскихДоговоровСрезПоследних.БазаДляРасчетаВознагражденияЗаПривлечение, ЗНАЧЕНИЕ(Справочник.БазыРасчета.ПустаяСсылка)) КАК БазаРасчетаВознагражденияЗаПривлечение,
			|	ЕСТЬNULL(УсловияАгентскихДоговоровСрезПоследних.ПериодичностьРасчетаВознагражденияЗаПривлечение, ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.ПустаяСсылка)) КАК ПериодичностьРасчетаВознагражденияЗаПривлечение,
			|	ВЫБОР
			|		КОГДА УсловияАгентскихДоговоровСрезПоследних.ПериодичностьРасчетаВознагражденияЗаПривлечение = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежемесячно)
			|			ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
			|		КОГДА УсловияАгентскихДоговоровСрезПоследних.ПериодичностьРасчетаВознагражденияЗаПривлечение = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально)
			|			ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, КВАРТАЛ)
			|		КОГДА УсловияАгентскихДоговоровСрезПоследних.ПериодичностьРасчетаВознагражденияЗаПривлечение = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно)
			|			ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, ГОД)
			|	КОНЕЦ КАК НачалоБазовогоПериодаВознагражденияЗаПривлечение,
			|	ВЫБОР
			|		КОГДА УсловияАгентскихДоговоровСрезПоследних.ПериодичностьРасчетаВознагражденияЗаПривлечение = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежемесячно)
			|			ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
			|		КОГДА УсловияАгентскихДоговоровСрезПоследних.ПериодичностьРасчетаВознагражденияЗаПривлечение = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально)
			|			ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, КВАРТАЛ)
			|		КОГДА УсловияАгентскихДоговоровСрезПоследних.ПериодичностьРасчетаВознагражденияЗаПривлечение = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно)
			|			ТОГДА КОНЕЦПЕРИОДА(&ДатаРасчета, ГОД)
			|	КОНЕЦ КАК КонецБазовогоПериодаВознагражденияЗаПривлечение,
			|	СчетаДоверительногоУправления.ДатаРасторжения <> ДАТАВРЕМЯ(1, 1, 1)
			|		И СчетаДоверительногоУправления.ДатаРасторжения < &ДатаРасчета КАК ДоговорЗакрыт,
			|	ЕСТЬNULL(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения, &ПустаяДата) КАК ДатаЗакрытияАгентскогоДоговора
			|ПОМЕСТИТЬ _НастройкиРасчетаВознаграждения
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(&ДатаРасчета, Организация = &Организация) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
			|		ПО СчетаДоверительногоУправления.Ссылка = СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияАгентскихДоговоров.СрезПоследних(&ДатаРасчета, ) КАК УсловияАгентскихДоговоровСрезПоследних
			|		ПО СчетаДоверительногоУправления.АгентскийДоговор = УсловияАгентскихДоговоровСрезПоследних.Договор
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ДатаРасчета, ) КАК УсловияДоговоровОбщиеСрезПоследних
			|		ПО СчетаДоверительногоУправления.АгентскийДоговор = УсловияДоговоровОбщиеСрезПоследних.Договор
			|ГДЕ
			|	СчетаДоверительногоУправления.Организация = &Организация
			|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
			|	И &ФильтрСчетовДоверительногоУправления
			|	И &ФильтрСтратегийИндивидуальногоИнвестирования
			|	И СчетаДоверительногоУправления.АгентскийДоговор = &АгентскийДоговор
			|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаРасчета";
		#КонецОбласти
	Иначе
		Если ВызватьИсключениеПриОшибке Тогда
			ВызватьИсключение "Расчет вознаграждения для выбранного варианта расчета не реализован";
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчет вознаграждения для выбранного варианта расчета не реализован");
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	// получим базы для расчета вознаграждения
	ТекстЗапроса = ТекстЗапроса + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|";
	
	ТекстЗапроса = ТекстЗапроса + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НастройкиРасчетаВознаграждения.БазаРасчета КАК БазаРасчета,
		|	_НастройкиРасчетаВознаграждения.ПериодичностьРасчетаВознаграждения КАК ПериодичностьРасчетаВознаграждения,
		|	_НастройкиРасчетаВознаграждения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_НастройкиРасчетаВознаграждения.НачалоБазовогоПериода КАК НачалоБазовогоПериода,
		|	_НастройкиРасчетаВознаграждения.НачалоБазовогоПериодаДляОтображения КАК НачалоБазовогоПериодаДляОтображения,
		|	_НастройкиРасчетаВознаграждения.КонецБазовогоПериода КАК КонецБазовогоПериода,
		|	_НастройкиРасчетаВознаграждения.КонецБазовогоПериодаДляОтображения КАК КонецБазовогоПериодаДляОтображения,
		|	_НастройкиРасчетаВознаграждения.ДатаЗакрытияАгентскогоДоговора КАК ДатаЗакрытияАгентскогоДоговора,
		|	&ПоляВознагражденияЗаПривлечение
		|ИЗ
		|	&НастройкиРасчетаВознаграждения КАК _НастройкиРасчетаВознаграждения
		|ИТОГИ ПО
		|	БазаРасчета,
		|	ПериодичностьРасчетаВознаграждения";
	
	Если ЭтотОбъект.ВариантРасчета = 1 Тогда // вознаграждение агента ИИС
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НастройкиРасчетаВознаграждения", "_НастройкиРасчетаВознаграждения");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПоляВознагражденияЗаПривлечение", 
		"_НастройкиРасчетаВознаграждения.БазаРасчетаВознагражденияЗаПривлечение КАК БазаРасчетаВознагражденияЗаПривлечение,
		|	_НастройкиРасчетаВознаграждения.ПериодичностьРасчетаВознагражденияЗаПривлечение КАК ПериодичностьРасчетаВознагражденияЗаПривлечение,
		|	_НастройкиРасчетаВознаграждения.НачалоБазовогоПериодаВознагражденияЗаПривлечение КАК НачалоБазовогоПериодаВознагражденияЗаПривлечение,
		|	_НастройкиРасчетаВознаграждения.КонецБазовогоПериодаВознагражденияЗаПривлечение КАК КонецБазовогоПериодаВознагражденияЗаПривлечение");
	Иначе	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НастройкиРасчетаВознаграждения", "_НастройкиРасчетаВознагражденияДоОбработки");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПоляВознагражденияЗаПривлечение", "ИСТИНА");
	КонецЕсли;
	
	// Фильтр по счетам д/у	
	
	Если Отбор.Свойство("СчетДоверительногоУправления") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&ФильтрСчетовДоверительногоУправления",
			"СчетаДоверительногоУправления.Ссылка В (&СчетаДоверительногоУправления)");
		Запрос.УстановитьПараметр("СчетаДоверительногоУправления", Отбор.СчетДоверительногоУправления);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ФильтрСчетовДоверительногоУправления", "ИСТИНА");	
	КонецЕсли;	
	
	// Фильтр по стратегии ИИ	
	
	Если Отбор.Свойство("СтратегияИндивидуальногоИнвестирования") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&ФильтрСтратегийИндивидуальногоИнвестирования",
			"СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия В (&СтратегииИндивидуальногоИнвестирования)");
		Запрос.УстановитьПараметр("СтратегииИндивидуальногоИнвестирования", Отбор.СтратегияИндивидуальногоИнвестирования);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ФильтрСтратегийИндивидуальногоИнвестирования", "ИСТИНА");	
	КонецЕсли;	
	
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();
		
	ВыборкаБазаРасчета = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаБазаРасчета.Следующий() Цикл
	
		ВыборкаПериодичностьРасчета = ВыборкаБазаРасчета.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПериодичностьРасчета.Следующий() Цикл
			
			ОпределенаБаза         = ЗначениеЗаполнено(ВыборкаПериодичностьРасчета.БазаРасчета);
			ОпределенаПериодичность = ЗначениеЗаполнено(ВыборкаПериодичностьРасчета.ПериодичностьРасчетаВознаграждения);
			
			ТекстОшибки = "";
			
			Если Не (ОпределенаБаза И ОпределенаПериодичность) Тогда
				ТекстОшибки = "Для счета доверительного управления '%1' не удалось определить ";
				ТекстОшибки = ТекстОшибки + ?(ОпределенаБаза, "", "базу");
				ТекстОшибки = ТекстОшибки + ?(ОпределенаПериодичность, "", ?(ОпределенаБаза, "", " и ") + "периодичность") + " расчета вознаграждения. Расчет вознаграждения не выполнен";
			КонецЕсли;				
			
			Если ЗначениеЗаполнено(ТекстОшибки) Тогда
				
				Выборка = ВыборкаПериодичностьРасчета.Выбрать();
				Пока Выборка.Следующий() Цикл
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Выборка.СчетДоверительногоУправления), Выборка.СчетДоверительногоУправления);
				КонецЦикла;
				
				Продолжить;
				
			КонецЕсли; 
			
			ПараметрыПолученияБазы = Новый Структура;             			
			ПараметрыПолученияБазы.Вставить("Организация", 						ЭтотОбъект.Организация);
			ПараметрыПолученияБазы.Вставить("ДатаРасчета",						ЭтотОбъект.ДатаРасчета);
			ПараметрыПолученияБазы.Вставить("БазаРасчета", 						ВыборкаПериодичностьРасчета.БазаРасчета);
			ПараметрыПолученияБазы.Вставить("СчетаДоверительногоУправления", 	Новый Массив);  
			
			// Параметр РассчитыватьЗаБазовыйПериод: 
			// Истина - вознаграждение рассчитывается, только если ДатаРасчета на границе базового периода (конец месяца, квартала)
			// Ложь - вознаграждение рассчитывается за период до ДатаРасчета
			ПараметрыПолученияБазы.Вставить("РассчитыватьЗаБазовыйПериод",  	Ложь);
			
			ПараметрыПолученияБазыЗаПривлечение = Новый Структура;
			Если РезультатЗапроса.Колонки.Найти("БазаРасчетаВознагражденияЗаПривлечение") <> Неопределено Тогда
				ПараметрыПолученияБазыЗаПривлечение.Вставить("Организация", ЭтотОбъект.Организация);
				ПараметрыПолученияБазыЗаПривлечение.Вставить("ДатаРасчета", ЭтотОбъект.ДатаРасчета);
				ПараметрыПолученияБазыЗаПривлечение.Вставить("СчетаДоверительногоУправления", Новый Массив);  		
			КонецЕсли;
			
			ТекстОшибки = "";
			ОпределенаБаза = Истина;
			ОпределенаПериодичность = Истина;
			
			Выборка = ВыборкаПериодичностьРасчета.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				ПараметрыПолученияБазы.Вставить("НачалоБазовогоПериода",				Выборка.НачалоБазовогоПериода);
				ПараметрыПолученияБазы.Вставить("НачалоБазовогоПериодаДляОтображения",	Выборка.НачалоБазовогоПериодаДляОтображения);
				ПараметрыПолученияБазы.Вставить("КонецБазовогоПериода",					Выборка.КонецБазовогоПериода);
				ПараметрыПолученияБазы.Вставить("КонецБазовогоПериодаДляОтображения",	Выборка.КонецБазовогоПериодаДляОтображения);
				
				ПараметрыПолученияБазы.СчетаДоверительногоУправления.Добавить(Выборка.СчетДоверительногоУправления);
				
				Если РезультатЗапроса.Колонки.Найти("БазаРасчетаВознагражденияЗаПривлечение") <> Неопределено Тогда
					ПараметрыПолученияБазыЗаПривлечение.Вставить("БазаРасчета", 		  			Выборка.БазаРасчетаВознагражденияЗаПривлечение);
					ПараметрыПолученияБазыЗаПривлечение.Вставить("НачалоБазовогоПериода", 			Выборка.НачалоБазовогоПериодаВознагражденияЗаПривлечение);
					ПараметрыПолученияБазыЗаПривлечение.Вставить("КонецБазовогоПериода",  			Выборка.КонецБазовогоПериодаВознагражденияЗаПривлечение);
					
					ОпределенаБаза         = ЗначениеЗаполнено(Выборка.БазаРасчетаВознагражденияЗаПривлечение);
					ОпределенаПериодичность = ЗначениеЗаполнено(Выборка.НачалоБазовогоПериодаВознагражденияЗаПривлечение) И ЗначениеЗаполнено(Выборка.КонецБазовогоПериодаВознагражденияЗаПривлечение);
			
					// Вознаграждение агенту нужно рассчитывать с заданной периодичностью, если агентский договор не закрыт
					ПараметрыПолученияБазыЗаПривлечение.Вставить("РассчитыватьЗаБазовыйПериод",  	?(Выборка.ДатаЗакрытияАгентскогоДоговора = '00010101', Истина, Ложь));
					ПараметрыПолученияБазы.Вставить("РассчитыватьЗаБазовыйПериод",  				?(Выборка.ДатаЗакрытияАгентскогоДоговора = '00010101', Истина, Ложь));
				
					ПараметрыПолученияБазыЗаПривлечение.СчетаДоверительногоУправления.Добавить(Выборка.СчетДоверительногоУправления);
				КонецЕсли;
			
			КонецЦикла; 
						
			Если Не (ОпределенаБаза И ОпределенаПериодичность) Тогда
				ТекстОшибки = "Для счета доверительного управления '%1' не удалось определить ";
				ТекстОшибки = ТекстОшибки + ?(ОпределенаБаза, "", "базу");
				ТекстОшибки = ТекстОшибки + ?(ОпределенаПериодичность, "", ?(ОпределенаБаза, "", " и ") + "периодичность") + " расчета вознаграждения за привлечение. Расчет вознаграждения не выполнен";
			КонецЕсли;				
			
			Если ЗначениеЗаполнено(ТекстОшибки) Тогда
				
				Выборка.Сбросить();
				Пока Выборка.Следующий() Цикл
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Выборка.СчетДоверительногоУправления), Выборка.СчетДоверительногоУправления);
				КонецЦикла;
				
				Продолжить;
				
			КонецЕсли;
									
			МассивДанныхДляРасчета.Добавить(ЗаполнитьДанныеДляРасчетаВознагражденияПоИИС(ПараметрыПолученияБазы, ПараметрыПолученияБазыЗаПривлечение, Запрос));
			
		КонецЦикла;
	КонецЦикла; 
	
	Если      МассивДанныхДляРасчета.Количество() = 1 Тогда
		Возврат МассивДанныхДляРасчета[0];
	ИначеЕсли МассивДанныхДляРасчета.Количество() = 0 Тогда
		Если ВызватьИсключениеПриОшибке Тогда
			ВызватьИсключение "Данные для расчета вознаграждения не найдены";
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данные для расчета вознаграждения не найдены");
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		Если ВызватьИсключениеПриОшибке Тогда
			ВызватьИсключение "Расчет вознаграждения с различной периодичностью или по разным базам не поддерживается";
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчет вознаграждения с различной периодичностью или по разным базам не поддерживается");
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли; 
	
КонецФункции

Функция ЗаполнитьДанныеДляРасчетаВознагражденияПоИИС(ПараметрыПолученияБазы, ПараметрыПолученияБазыЗаПривлечение, Запрос)

	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_НастройкиРасчетаВознагражденияДоОбработки") = Неопределено Тогда
		
		ИсходныеТаблицы = "_НастройкиРасчетаВознаграждения";
		
	Иначе
		
		#Область Получение_ставки_из_хранилища_значений
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	*
			|ИЗ
			|	_НастройкиРасчетаВознагражденияДоОбработки КАК _НастройкиРасчетаВознагражденияДоОбработки
			|ГДЕ
			|	_НастройкиРасчетаВознагражденияДоОбработки.СчетДоверительногоУправления В(&СчетаДоверительногоУправления)
			|	И _НастройкиРасчетаВознагражденияДоОбработки.СтавкаИзПараметровРасчета = ИСТИНА";
		
		Запрос.УстановитьПараметр("БазаРасчета",					ПараметрыПолученияБазы.БазаРасчета);
		Запрос.УстановитьПараметр("СчетаДоверительногоУправления",	ПараметрыПолученияБазы.СчетаДоверительногоУправления);
		
		НастройкиРасчета = Запрос.Выполнить().Выгрузить();
		
		// Получаем параметры расчета по базе
		
		РеквизитыБазыРасчета = Справочники.БазыРасчета.ПолучитьРеквизитыБазРасчета(ПараметрыПолученияБазы.БазаРасчета);

		Для Каждого Реквизит Из РеквизитыБазыРасчета Цикл
			НастройкиРасчета.Колонки.Добавить(Реквизит.Имя, Реквизит.ТипЗначения);			
		КонецЦикла;
		
		Для Каждого СтрокаНастройки Из НастройкиРасчета Цикл
			ЗаполнитьЗначенияСвойств(СтрокаНастройки, СтрокаНастройки.ПараметрыРасчета.Получить());
		КонецЦикла;
		
		Если НастройкиРасчета.Колонки.Найти("ПараметрРасчетаСтавка") <> Неопределено Тогда
			НастройкиРасчета.Колонки.Удалить(НастройкиРасчета.Колонки.Найти("СтавкаВознагражденияЗаУправление"));
			НастройкиРасчета.Колонки["ПараметрРасчетаСтавка"].Имя = "СтавкаВознагражденияЗаУправление";
		КонецЕсли;
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	*
			|ПОМЕСТИТЬ _НастройкиРасчетаВознагражденияПослеОбработки
			|ИЗ
			|	&НастройкиРасчета КАК НастройкиРасчета
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&ИсходныеКолонки
			|ПОМЕСТИТЬ _НастройкиРасчетаВознаграждения
			|ИЗ
			|	_НастройкиРасчетаВознагражденияДоОбработки КАК _НастройкиРасчетаВознагражденияДоОбработки
			|ГДЕ
			|	_НастройкиРасчетаВознагражденияДоОбработки.СчетДоверительногоУправления В(&СчетаДоверительногоУправления)
			|	И _НастройкиРасчетаВознагражденияДоОбработки.СтавкаИзПараметровРасчета = ЛОЖЬ
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	&ИсходныеКолонки
			|ИЗ
			|	_НастройкиРасчетаВознагражденияПослеОбработки КАК _НастройкиРасчетаВознагражденияПослеОбработки";
		
		ОписаниеКолонокВЗапросе = Новый Массив;
		
		ИсходныеКолонки = Запрос.МенеджерВременныхТаблиц.Таблицы["_НастройкиРасчетаВознагражденияДоОбработки"].Колонки;
		Для Каждого Колонка Из ИсходныеКолонки Цикл
			ОписаниеКолонокВЗапросе.Добавить(Колонка.Имя + " КАК " + Колонка.Имя);
		КонецЦикла;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИсходныеКолонки", СтрСоединить(ОписаниеКолонокВЗапросе, "," + Символы.ПС));
		
		Запрос.УстановитьПараметр("НастройкиРасчета", НастройкиРасчета);
		
		Запрос.Выполнить();
			
		#КонецОбласти
		
		ИсходныеТаблицы = "_НастройкиРасчетаВознагражденияДоОбработки";	
		
	КонецЕсли;
	
	ДанныеДляРасчетаВознаграждения = Новый Структура;
	
	Запрос.УстановитьПараметр("НачалоБазовогоПериода",					ПараметрыПолученияБазы.НачалоБазовогоПериода);
	Запрос.УстановитьПараметр("НачалоБазовогоПериодаДляОтображения",	ПараметрыПолученияБазы.НачалоБазовогоПериодаДляОтображения);
	Запрос.УстановитьПараметр("КонецБазовогоПериода",					ПараметрыПолученияБазы.КонецБазовогоПериода);
	Запрос.УстановитьПараметр("КонецБазовогоПериодаДляОтображения",		ПараметрыПолученияБазы.КонецБазовогоПериодаДляОтображения);
				
	Справочники.БазыРасчета.ПолучитьЗначенияБазРасчета(ПараметрыПолученияБазы, Запрос.МенеджерВременныхТаблиц);
	
	ДанныеДляРасчетаВознаграждения.Вставить("НачалоПериода",					ПараметрыПолученияБазы.НачалоБазовогоПериода);
	ДанныеДляРасчетаВознаграждения.Вставить("СчетаДоверительногоУправления",	ПолучитьДанныеДляРасчетаВознаграждения(Запрос, "СчетаДоверительногоУправления"));
	ДанныеДляРасчетаВознаграждения.Вставить("Вознаграждения",					ПолучитьДанныеДляРасчетаВознаграждения(Запрос, "Вознаграждения"));
	ДанныеДляРасчетаВознаграждения.Вставить("РасшифровкаРасчетаВознаграждений",	ПолучитьДанныеДляРасчетаВознаграждения(Запрос, "РасшифровкаРасчетаВознаграждений"));
	
	Если ЭтотОбъект.ВариантРасчета = 0 Тогда // Вознаграждение управляющего ИИС
		
		ДанныеДляРасчетаВознаграждения.Вставить("ВознагражденияПлатаЗаРазмещение",								ПолучитьДанныеДляРасчетаВознаграждения(Запрос, "ВознагражденияПлатаЗаРазмещение"));
		ДанныеДляРасчетаВознаграждения.Вставить("НачисленияВознагражденийЗаРасчетныйПериод",					ПолучитьДанныеДляРасчетаВознаграждения(Запрос, "НачисленияВознагражденийЗаРасчетныйПериод"));
		ДанныеДляРасчетаВознаграждения.Вставить("НачисленияВознагражденийПлатаЗаРазмещениеЗаРасчетныйПериод",	ПолучитьДанныеДляРасчетаВознаграждения(Запрос, "НачисленияВознагражденийПлатаЗаРазмещениеЗаРасчетныйПериод"));
		ДанныеДляРасчетаВознаграждения.Вставить("НачисленияВознагражденийПлатаЗаРазмещениеДоДатыРасчета",		ПолучитьДанныеДляРасчетаВознаграждения(Запрос, "НачисленияВознагражденийПлатаЗаРазмещениеДоДатыРасчета"));
		ДанныеДляРасчетаВознаграждения.Вставить("ВводыАктивовЗаРасчетныйПериод",								ПолучитьДанныеДляРасчетаВознаграждения(Запрос, "ВводыАктивовЗаРасчетныйПериод"));
		ДанныеДляРасчетаВознаграждения.Вставить("ВводыАктивовЗаПредрасчетныйПериод",							ПолучитьДанныеДляРасчетаВознаграждения(Запрос, "ВводыАктивовЗаПредрасчетныйПериод"));
		ДанныеДляРасчетаВознаграждения.Вставить("ОплатыВознагражденийЗаПредрасчетныйПериод",					ПолучитьДанныеДляРасчетаВознаграждения(Запрос, "ОплатыВознагражденийЗаПредрасчетныйПериод"));
		ДанныеДляРасчетаВознаграждения.Вставить("ОстаткиАктивовНаНачалоРасчетногоПериода",						ПолучитьДанныеДляРасчетаВознаграждения(Запрос, "ОстаткиАктивовНаНачалоРасчетногоПериода"));
		
	ИначеЕсли ЭтотОбъект.ВариантРасчета = 1 Тогда // Вознаграждение агентам ИИС
		
		Справочники.БазыРасчета.ПолучитьЗначенияБазРасчета(ПараметрыПолученияБазыЗаПривлечение, Запрос.МенеджерВременныхТаблиц);
		
		ДанныеДляРасчетаВознаграждения.Вставить("ВознагражденияПлатаЗаРазмещение",					ПолучитьДанныеДляРасчетаВознаграждения(Запрос, "ВознагражденияПлатаЗаРазмещениеАгенту"));
		ДанныеДляРасчетаВознаграждения.Вставить("НачалоПериодаРасчетаВознагражденияЗаПривлечение",	ПараметрыПолученияБазыЗаПривлечение.НачалоБазовогоПериода);
		ДанныеДляРасчетаВознаграждения.Вставить("КонецБазовогоПериода",								ПараметрыПолученияБазы.КонецБазовогоПериода);
		ДанныеДляРасчетаВознаграждения.Вставить("КонецБазовогоПериодаДляОтображения",				ПараметрыПолученияБазы.КонецБазовогоПериодаДляОтображения);
		
	КонецЕсли;
	
	// Удалим временные таблицы
	СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(Запрос, , ИсходныеТаблицы);
	
	Возврат ДанныеДляРасчетаВознаграждения;
КонецФункции

Функция СформироватьФормуРасчетаВознагражденияПоИИСДляБухгалтерии(СчетаДоверительногоУправления, ДанныеПоРасчетуВознагражденияУправляющего, Подписант = "") Экспорт

	Если ТипЗнч(ДанныеПоРасчетуВознагражденияУправляющего) <> Тип("ХранилищеЗначения") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сначала необходимо выполнить расчет вознаграждения");
		Возврат Неопределено;
	КонецЕсли;
	
	ФормаРасчета = Новый ТабличныйДокумент;
	
	МакетОтчета = ЭтотОбъект.ПолучитьМакет("РасчетВознагражденияПоИИСДляБухгалтерии");
	
	_ДанныеПоРасчетуВознагражденияУправляющего = ДанныеПоРасчетуВознагражденияУправляющего.Получить();
	
	РеквизитыОрганизации = ПолучитьРеквизитыОрганизацииАнкетные(ЭтотОбъект.Организация, ЭтотОбъект.ДатаРасчета);
		
	// Отобразим данные
	Выборка = ПолучитьРеквизитыСчетовДоверительногоУправления(СчетаДоверительногоУправления);
	
	Количество = 0;
	
	Пока Выборка.Следующий() Цикл
		ПараметрыОтбора = Новый Структура("СчетДоверительногоУправления", Выборка.СчетДоверительногоУправления);
		
		ВознаграждениеПоСчету = _ДанныеПоРасчетуВознагражденияУправляющего.Вознаграждения.Скопировать(ПараметрыОтбора);
		Если      ВознаграждениеПоСчету.Количество() = 0 Тогда
			ВызватьИсключение "Ошибка печати расчета вознаграждения: вознаграждение отсутствует";
		ИначеЕсли ВознаграждениеПоСчету.Количество() > 1 Тогда
			ВызватьИсключение "Ошибка печати расчета вознаграждения: неоднозначное вознаграждение";
		КонецЕсли;
		
		ВводыАктивовПоСчету = _ДанныеПоРасчетуВознагражденияУправляющего.ВводыАктивовЗаРасчетныйПериод.Скопировать(ПараметрыОтбора);
			
		Если Количество > 0 Тогда
			ФормаРасчета.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;		
		
		ПараметрыРасчетаВознагражденияПоСчету = _ДанныеПоРасчетуВознагражденияУправляющего.СчетаДоверительногоУправления.Скопировать(ПараметрыОтбора);
		
		// шапка
		ОбластьОтчета = МакетОтчета.ПолучитьОбласть("ШапкаОтчета");
		ОбластьОтчета.Параметры.Заполнить(РеквизитыОрганизации);
		ОбластьОтчета.Параметры.Заполнить(Выборка);
		ОбластьОтчета.Параметры.ДатаДоговораДУ = Формат(Выборка.ДатаДоговораДУ, "ДФ=dd.MM.yyyy");
		
		НачалоБазовогоПериодаДляОтображения = ПараметрыРасчетаВознагражденияПоСчету[0].НачалоБазовогоПериодаДляОтображения;
		Если НачалоБазовогоПериодаДляОтображения = НачалоКвартала(НачалоБазовогоПериодаДляОтображения)
			И КонецДня(ЭтотОбъект.ДатаРасчета) = КонецКвартала(ЭтотОбъект.ДатаРасчета)
		Тогда
			ОбластьОтчета.Параметры.РасчетныйПериод = Формат(ЭтотОбъект.ДатаРасчета, "ДФ=к") + " квартал " + Формат(ЭтотОбъект.ДатаРасчета, "ДФ=гггг") + " г.";
		Иначе
			ОбластьОтчета.Параметры.РасчетныйПериод = "период с " + Формат(НачалоБазовогоПериодаДляОтображения, "ДФ=dd.MM.yyyy")
				+ " по " + Формат(ЭтотОбъект.ДатаРасчета, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		
		ФормаРасчета.Вывести(ОбластьОтчета);
		
		// пункты 1—3
		ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Пункты_1__3");
		ОбластьОтчета.Параметры.ОтчетнаяДата = Формат(ЭтотОбъект.ДатаРасчета, "ДФ=dd.MM.yyyy");
		ОбластьОтчета.Параметры.СтоимостьПринятогоИмущества   = ФорматСуммы(ВознаграждениеПоСчету[0].БалансоваяСтоимость);
		ОбластьОтчета.Параметры.СтоимостьВыведенногоИмущества = "-";
		ОбластьОтчета.Параметры.СрокУправленияПоДоговору      = Выборка.ДнейВУправлении;
		
		ФормаРасчета.Вывести(ОбластьОтчета);
		
		// 4-й пункт ответа - вводы активов в управление
		ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Пункт_4_Шапка");
		ФормаРасчета.Вывести(ОбластьОтчета);
		
		ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Пункт_4_Строка");
		
		Если ВводыАктивовПоСчету.Количество() = 0 Тогда
			ОбластьОтчета.Параметры.Дата                             = "-";
			ОбластьОтчета.Параметры.ДнейДоОкончанияРасчетногоПериода = "-";
			ОбластьОтчета.Параметры.СтоимостьИмущества               = "-";
			
			ФормаРасчета.Вывести(ОбластьОтчета);
			
		Иначе
			Для каждого СтрокаВводыАктивовПоСчету Из ВводыАктивовПоСчету Цикл
				ОбластьОтчета.Параметры.Дата                             = Формат(СтрокаВводыАктивовПоСчету.Период, "ДФ=dd.MM.yyyy");
				ОбластьОтчета.Параметры.ДнейДоОкончанияРасчетногоПериода = СтрокаВводыАктивовПоСчету.ДнейВУправлении;
				ОбластьОтчета.Параметры.СтоимостьИмущества               = ФорматСуммы(СтрокаВводыАктивовПоСчету.БалансоваяСтоимость);
				
				ФормаРасчета.Вывести(ОбластьОтчета);
			КонецЦикла;
			
		КонецЕсли;
		
		// 5-й пункт отчета - выводы активов
		ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Пункт_5_Шапка");
		ФормаРасчета.Вывести(ОбластьОтчета);
		
		ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Пункт_5_Строка");
		ОбластьОтчета.Параметры.Дата                             = "-";
		ОбластьОтчета.Параметры.ДнейДоОкончанияРасчетногоПериода = "-";
		ОбластьОтчета.Параметры.СтоимостьИмущества               = "-";
		
		ФормаРасчета.Вывести(ОбластьОтчета);
		
		// пункты 6—8
		ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Пункт_6__8");
		
		СтрокаОплатыВознагражденийЗаПредрасчетныйПериод = _ДанныеПоРасчетуВознагражденияУправляющего.ОплатыВознагражденийЗаПредрасчетныйПериод.Найти(Выборка.СчетДоверительногоУправления, "СчетДоверительногоУправления");
		Если СтрокаОплатыВознагражденийЗаПредрасчетныйПериод <> Неопределено Тогда
			ОбластьОтчета.Параметры.СуммаВознагражденияУдержанногоРанее = ФорматСуммы(СтрокаОплатыВознагражденийЗаПредрасчетныйПериод.Сумма);
		Иначе
			ОбластьОтчета.Параметры.СуммаВознагражденияУдержанногоРанее = "-";
		КонецЕсли;
		
		ОбластьОтчета.Параметры.СуммаВознаграждения = ФорматСуммы(ВознаграждениеПоСчету[0].СуммаВознаграждения);
		
		ФормаРасчета.Вывести(ОбластьОтчета);
		
		// подвал
		ОбластьОтчета = МакетОтчета.ПолучитьОбласть("ПодвалОтчета");
		ОбластьОтчета.Параметры.Подписант = СокрЛП(Подписант);
		
		ФормаРасчета.Вывести(ОбластьОтчета);
		
		Количество = Количество + 1;
		
		//Если Количество = 1 Тогда
		//	Прервать;
		//КонецЕсли;
		
	КонецЦикла;
	
	ФормаРасчета.ОтображатьЗаголовки = Ложь;
	ФормаРасчета.ОтображатьСетку = Ложь;
	ФормаРасчета.Защита = Ложь;
	ФормаРасчета.ТолькоПросмотр = Истина;

	Возврат ФормаРасчета;
	
КонецФункции // СформироватьФормуРасчетаВознагражденияДляБухгалтерии

Функция СформироватьФормуРасчетаВознагражденияПоИИСЗаПериодДляБухгалтерии(СчетаДоверительногоУправления, ДанныеПоРасчетуВознагражденияУправляющего, Подписант = "") Экспорт

	Если ТипЗнч(ДанныеПоРасчетуВознагражденияУправляющего) <> Тип("ХранилищеЗначения") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сначала необходимо выполнить расчет вознаграждения");
		Возврат Неопределено;
	КонецЕсли;
	
	ФормаРасчета = Новый ТабличныйДокумент;
	
	МакетОтчета = ЭтотОбъект.ПолучитьМакет("РасчетВознагражденияПоИИСЗаПериодДляБухгалтерии");
	
	_ДанныеПоРасчетуВознагражденияУправляющего = ДанныеПоРасчетуВознагражденияУправляющего.Получить();
	ПараметрыРасчетаВознаграждения = _ДанныеПоРасчетуВознагражденияУправляющего.СчетаДоверительногоУправления;
	
	// Отобразим данные
	РеквизитыОрганизации = ПолучитьРеквизитыОрганизацииАнкетные(ЭтотОбъект.Организация, ЭтотОбъект.ДатаРасчета);
	
	// шапка
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("ШапкаОтчета");
	ОбластьОтчета.Параметры.Заполнить(РеквизитыОрганизации);
	НачалоБазовогоПериодаДляОтображения = ПараметрыРасчетаВознаграждения[0].НачалоБазовогоПериодаДляОтображения;
	Если НачалоБазовогоПериодаДляОтображения = НачалоКвартала(НачалоБазовогоПериодаДляОтображения)
		И КонецДня(ЭтотОбъект.ДатаРасчета) = КонецКвартала(ЭтотОбъект.ДатаРасчета)
	Тогда
		ОбластьОтчета.Параметры.РасчетныйПериод = Формат(ЭтотОбъект.ДатаРасчета, "ДФ=к") + " квартал " + Формат(ЭтотОбъект.ДатаРасчета, "ДФ=гггг") + " г.";
	Иначе
		ОбластьОтчета.Параметры.РасчетныйПериод = "период с " + Формат(НачалоБазовогоПериодаДляОтображения, "ДФ=dd.MM.yyyy") + " по " + Формат(ЭтотОбъект.ДатаРасчета, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	ФормаРасчета.Вывести(ОбластьОтчета);
	
	Выборка = ПолучитьРеквизитыСчетовДоверительногоУправления(СчетаДоверительногоУправления);
	
	Количество = 0;
	
	МассивПроверкиВывода = Новый Массив;
	МассивВыводаТекущегоДУ = Новый Массив;
	МассивПроверкиВывода.Добавить(ОбластьОтчета);
	
	Пока Выборка.Следующий() Цикл
		
		СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
		ПараметрыОтбора = Новый Структура("СчетДоверительногоУправления", СчетДоверительногоУправления);
		
		ВознаграждениеПоСчету = _ДанныеПоРасчетуВознагражденияУправляющего.Вознаграждения.Скопировать(ПараметрыОтбора);
		Если      ВознаграждениеПоСчету.Количество() = 0 Тогда
			ВызватьИсключение "Ошибка печати расчета вознаграждения: вознаграждение отсутствует";
		ИначеЕсли ВознаграждениеПоСчету.Количество() > 1 Тогда
			ВызватьИсключение "Ошибка печати расчета вознаграждения: неоднозначное вознаграждение";
		КонецЕсли;
		
		ОстаткиАктивовПоСчету			= _ДанныеПоРасчетуВознагражденияУправляющего.ОстаткиАктивовНаНачалоРасчетногоПериода.Скопировать(ПараметрыОтбора);
		ВводыАктивовПоСчету				= _ДанныеПоРасчетуВознагражденияУправляющего.ВводыАктивовЗаРасчетныйПериод.Скопировать(ПараметрыОтбора);
		ВознаграждениеПлатаЗаРазмещение	= _ДанныеПоРасчетуВознагражденияУправляющего.НачисленияВознагражденийПлатаЗаРазмещениеДоДатыРасчета.Скопировать(ПараметрыОтбора);
		
		// Шапка
		ОбластьОтчета = МакетОтчета.ПолучитьОбласть("ШапкаТаблицы");
		
		ОбластьОтчета.Параметры.Заполнить(Выборка);
		ОбластьОтчета.Параметры.ДатаДоговораДУ 				= Формат(Выборка.ДатаДоговораДУ, "ДФ=dd.MM.yyyy");
		ОбластьОтчета.Параметры.Ставка						= ВознаграждениеПоСчету[0].Ставка;
		ОбластьОтчета.Параметры.СредняяОценочнаяСтоимость	= ФорматСуммы(ВознаграждениеПоСчету[0].СредняяОценочнаяСтоимость);
			
		//ФормаРасчета.Вывести(ОбластьОтчета);
		
		МассивПроверкиВывода.Добавить(ОбластьОтчета);
		МассивВыводаТекущегоДУ.Добавить(ОбластьОтчета);
		
		// Вознаграждение - плата за размещение 
		Если ВознаграждениеПлатаЗаРазмещение.Количество() > 0 Тогда
			ВознаграждениеПлатаЗаРазмещение.Сортировать("Дата");
					
			Для Каждого СтрокаВознаграждения Из ВознаграждениеПлатаЗаРазмещение Цикл
				ОбластьОтчета = МакетОтчета.ПолучитьОбласть("ВознаграждениеЗаПривлечение");	
				ОбластьОтчета.Параметры.Заполнить(СтрокаВознаграждения);
				ОбластьОтчета.Параметры.Дата = Формат(СтрокаВознаграждения.Дата, "ДФ=dd.MM.yyyy");
				ОбластьОтчета.Параметры.СуммаВознаграждения = ФорматСуммы(СтрокаВознаграждения.СуммаВознаграждения);
				//ФормаРасчета.Вывести(ОбластьОтчета);
				МассивПроверкиВывода.Добавить(ОбластьОтчета);
				МассивВыводаТекущегоДУ.Добавить(ОбластьОтчета);
			КонецЦикла;
		КонецЕсли;	
		
		// Заголовок 
		ОбластьОтчета = МакетОтчета.ПолучитьОбласть("ЗаголовокПередачаИмушества");
		МассивПроверкиВывода.Добавить(ОбластьОтчета);
		МассивВыводаТекущегоДУ.Добавить(ОбластьОтчета);
		//ФормаРасчета.Вывести(ОбластьОтчета);
	
		// Начальный остаток активов
		Если ОстаткиАктивовПоСчету.Количество() > 0 Тогда
			ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Остаток");
			
			Остатки = ОстаткиАктивовПоСчету[0];
			
			ОбластьОтчета.Параметры.Дата								= Формат(Остатки.Период, "ДФ=dd.MM.yyyy");
			ОбластьОтчета.Параметры.ДнейДоОкончанияРасчетногоПериода	= Остатки.ДнейВУправлении;
			ОбластьОтчета.Параметры.СтоимостьИмущества					= ФорматСуммы(Остатки.БалансоваяСтоимость);
			
			//ФормаРасчета.Вывести(ОбластьОтчета);
			
			МассивПроверкиВывода.Добавить(ОбластьОтчета);
			МассивВыводаТекущегоДУ.Добавить(ОбластьОтчета);
		КонецЕсли;
		
		ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Ввод");
		
		Если ВводыАктивовПоСчету.Количество() = 0 Тогда
			ОбластьОтчета.Параметры.Дата                             = "-";
			ОбластьОтчета.Параметры.ДнейДоОкончанияРасчетногоПериода = "-";
			ОбластьОтчета.Параметры.СтоимостьИмущества               = "-";
			
			//ФормаРасчета.Вывести(ОбластьОтчета);
			
			МассивПроверкиВывода.Добавить(ОбластьОтчета);
			МассивВыводаТекущегоДУ.Добавить(ОбластьОтчета);
			
		Иначе
			Для каждого СтрокаВводыАктивовПоСчету Из ВводыАктивовПоСчету Цикл
				ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Ввод");
				ОбластьОтчета.Параметры.Дата                             = Формат(СтрокаВводыАктивовПоСчету.Период, "ДФ=dd.MM.yyyy");
				ОбластьОтчета.Параметры.ДнейДоОкончанияРасчетногоПериода = СтрокаВводыАктивовПоСчету.ДнейВУправлении;
				ОбластьОтчета.Параметры.СтоимостьИмущества               = ФорматСуммы(СтрокаВводыАктивовПоСчету.БалансоваяСтоимость);
				
				//ФормаРасчета.Вывести(ОбластьОтчета);
				
				МассивПроверкиВывода.Добавить(ОбластьОтчета);
				МассивВыводаТекущегоДУ.Добавить(ОбластьОтчета);
			КонецЦикла;
			
		КонецЕсли;
			
		// Вознаграждение
		ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Вознаграждение");
		ОбластьОтчета.Параметры.СуммаВознаграждения = ФорматСуммы(ВознаграждениеПоСчету[0].СуммаВознаграждения);
			
		//ФормаРасчета.Вывести(ОбластьОтчета);
		МассивПроверкиВывода.Добавить(ОбластьОтчета);
		МассивВыводаТекущегоДУ.Добавить(ОбластьОтчета);
		
		Если Не ФормаРасчета.ПроверитьВывод(МассивПроверкиВывода) Тогда
			ФормаРасчета.ВывестиГоризонтальныйРазделительСтраниц();
			МассивПроверкиВывода.Очистить();			
		КонецЕсли;
		
		Для Каждого ТекОбласть Из МассивВыводаТекущегоДУ Цикл
			ФормаРасчета.Вывести(ТекОбласть);
		КонецЦикла;
		
		МассивВыводаТекущегоДУ.Очистить();
		
	КонецЦикла;	
	
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("ПодвалОтчета");
	ОбластьОтчета.Параметры.Подписант = СокрЛП(Подписант);				
	ФормаРасчета.Вывести(ОбластьОтчета);   
	
	// Наводим красоту
	ФормаРасчета.ОтображатьЗаголовки = Ложь;
	ФормаРасчета.ОтображатьСетку = Ложь;
	ФормаРасчета.Защита = Ложь;
	ФормаРасчета.ТолькоПросмотр = Истина;

	Возврат ФормаРасчета;
	
КонецФункции // СформироватьФормуРасчетаВознагражденияПоИИСЗаПериодДляБухгалтерии

Функция СформироватьФормуРасчетаВознагражденияПоИИСДляФормы482(СчетДоверительногоУправления, ДанныеПоРасчетуВознагражденияУправляющего) Экспорт

	Если ТипЗнч(ДанныеПоРасчетуВознагражденияУправляющего) <> Тип("ХранилищеЗначения") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сначала необходимо выполнить расчет вознаграждения");
		Возврат Неопределено;
	КонецЕсли;
	
	ФормаРасчета = Новый ТабличныйДокумент;
	
	МакетОтчета = ЭтотОбъект.ПолучитьМакет("РасчетВознагражденияПоИИСДляФормы482");
	
	_ДанныеПоРасчетуВознагражденияУправляющего = ДанныеПоРасчетуВознагражденияУправляющего.Получить();
	
	// Отобразим данные
	ПараметрыОтбора = Новый Структура("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	ВознаграждениеПоСчету = _ДанныеПоРасчетуВознагражденияУправляющего.Вознаграждения.Скопировать(ПараметрыОтбора);
	Если      ВознаграждениеПоСчету.Количество() = 0 Тогда
		ВызватьИсключение "Ошибка печати расчета вознаграждения: вознаграждение отсутствует";
	ИначеЕсли ВознаграждениеПоСчету.Количество() > 1 Тогда
		ВызватьИсключение "Ошибка печати расчета вознаграждения: неоднозначное вознаграждение";
	КонецЕсли;
	
	ОстаткиАктивовПоСчету			= _ДанныеПоРасчетуВознагражденияУправляющего.ОстаткиАктивовНаНачалоРасчетногоПериода.Скопировать(ПараметрыОтбора);
	ВводыАктивовПоСчету				= _ДанныеПоРасчетуВознагражденияУправляющего.ВводыАктивовЗаРасчетныйПериод.Скопировать(ПараметрыОтбора);
	ПредВводыАктивовПоСчету			= _ДанныеПоРасчетуВознагражденияУправляющего.ВводыАктивовЗаПредрасчетныйПериод.Скопировать(ПараметрыОтбора);
	ВознаграждениеПлатаЗаРазмещение = _ДанныеПоРасчетуВознагражденияУправляющего.НачисленияВознагражденийПлатаЗаРазмещениеДоДатыРасчета.Скопировать(ПараметрыОтбора);
		
	// Формулы
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Формулы");
	ФормаРасчета.Вывести(ОбластьОтчета);
	
	// Описания
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Описания");
	
	Описание_m 	= "       - общее количество вводов имущества ранее даты начала Расчетного периода;";
	Описание_To = "       - количество дней в Расчетном периоде;";
	Описание_n 	= "       - общее количество вводов имущества в Расчетном периоде;";
	Описание_Ti = "       - количество дней в периоде с даты передачи имущества в доверительное 
					  |		управление, совершенной в Расчетном периоде, до текущей Расчетной даты;";
	Описание_T 	= "       - количество дней в текущем календарном квартале.";
		
	Если ВознаграждениеПлатаЗаРазмещение.Количество() > 0 Тогда
		
		Описание_Cj = "       - Оценочная стоимость имущества, принятого в доверительное управление ранее
					  |		даты начала Расчетного периода, рассчитанная на дату принятия, уменьшенная
					  |		на величину платы за размещение, причитающейся Управляющему;";
	
		Описание_Ci = "       - Оценочная стоимость имущества, принятого в доверительное управление
					  |		в течение Расчетного периода, рассчитанная на дату принятия, уменьшенная
					  |		на величину платы за размещение, причитающейся Управляющему;";
			
	Иначе	
		
		Описание_Cj = "       - Оценочная стоимость имущества, принятого в доверительное управление ранее
					  |		даты начала Расчетного периода, рассчитанная на дату принятия";
	
		Описание_Ci = "       - Оценочная стоимость имущества, принятого в доверительное управление
					  |		в течение Расчетного периода, рассчитанная на дату принятия;";
			
	КонецЕсли;
	
	ОбластьОтчета.Параметры.Описание_m 	= Описание_m;
	ОбластьОтчета.Параметры.Описание_Cj = Описание_Cj;
	ОбластьОтчета.Параметры.Описание_To = Описание_To;
	ОбластьОтчета.Параметры.Описание_n 	= Описание_n;
	ОбластьОтчета.Параметры.Описание_Ci = Описание_Ci;
	ОбластьОтчета.Параметры.Описание_Ti = Описание_Ti;
	ОбластьОтчета.Параметры.Описание_T 	= Описание_T;
	
	ФормаРасчета.Вывести(ОбластьОтчета);
	
	ЕстьПлатаЗаРазмещение = ВознаграждениеПлатаЗаРазмещение.Количество() > 0;
	СтрСекция = ?(ЕстьПлатаЗаРазмещение, "СРазмещением", "БезРазмещения");
	
	#Область Передача_Имущества_До_Начала_Расчетного_Периода
	
	// Передача имущества до начала расчетного периода
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Шапка" + СтрСекция + "_ПередачаДо");
	ФормаРасчета.Вывести(ОбластьОтчета);
	
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Строка" + СтрСекция + "_ПередачаДо");
	
	ОценочнаяСтоимостьДоНачалаПериода = 0;
	Для Каждого ТекСтрокаВвода Из ПредВводыАктивовПоСчету Цикл
		
		ВознаграждениеЗаРазмещение = 0;
		Если ЕстьПлатаЗаРазмещение Тогда		
			
			НайдСтрокиВознаграждения = ВознаграждениеПлатаЗаРазмещение.НайтиСтроки(
				Новый Структура("СчетДоверительногоУправления, Дата",
					ТекСтрокаВвода.СчетДоверительногоУправления,
					?(НачалоДня(ТекСтрокаВвода.Период) = '20251219', '20251223', НачалоДня(ТекСтрокаВвода.Период))));
					
			Если НайдСтрокиВознаграждения.Количество() > 1 Тогда
				ВызватьИсключение "Ошибка печати расчета вознаграждения: неоднозначное вознаграждение за привлечение";
			ИначеЕсли НайдСтрокиВознаграждения.Количество() = 0 Тогда
				ВызватьИсключение "Ошибка печати расчета вознаграждения: отсутствует вознаграждение за привлечение";
			КонецЕсли;			
			
			ОбластьОтчета.Параметры.СтоимостьИмущества = ТекСтрокаВвода.БалансоваяСтоимость;
			ВознаграждениеЗаРазмещение = НайдСтрокиВознаграждения[0].СуммаВознаграждения;
			ОбластьОтчета.Параметры.СуммаВознаграждения = ВознаграждениеЗаРазмещение;
			
		КонецЕсли;
		
		ОбластьОтчета.Параметры.Дата = Формат(ТекСтрокаВвода.Период, "ДФ=dd.MM.yyyy");
		ОбластьОтчета.Параметры.ОценочнаяСтоимостьДоНачалаПериода = ТекСтрокаВвода.БалансоваяСтоимость - ВознаграждениеЗаРазмещение;
		ОценочнаяСтоимостьДоНачалаПериода = ОценочнаяСтоимостьДоНачалаПериода + ТекСтрокаВвода.БалансоваяСтоимость - ВознаграждениеЗаРазмещение;		
		
		ФормаРасчета.Вывести(ОбластьОтчета);
		
	КонецЦикла;
	
	// Если в расчетном периоде не было вводов активов, выводим строку с прочерками
	Если ПредВводыАктивовПоСчету.Количество() = 0 Тогда
		ДобавитьСтрокуСПрочерками(ФормаРасчета, ОбластьОтчета);	
	КонецЕсли;

	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Итого" + СтрСекция + "_ПередачаДо");
	ОбластьОтчета.Параметры.ОценочнаяСтоимостьДоНачалаПериода = ?(ОценочнаяСтоимостьДоНачалаПериода = 0, "-", ОценочнаяСтоимостьДоНачалаПериода);
	
	ФормаРасчета.Вывести(ОбластьОтчета);
	
	#КонецОбласти
	
	#Область Передача_Имущества_В_Течение_Расчетного_Периода
	
	// Передача имущества в течение расчетного периода
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Шапка" + СтрСекция + "_ПередачаТекущая");
	ФормаРасчета.Вывести(ОбластьОтчета);
	
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Строка" + СтрСекция + "_ПередачаТекущая");
	
	СтрокаДляФормулы = "";
	Для Каждого ТекСтрокаВвода Из ВводыАктивовПоСчету Цикл
		
		ВознаграждениеЗаРазмещение = 0;
		Если ЕстьПлатаЗаРазмещение Тогда		
			
			НайдСтрокиВознаграждения = ВознаграждениеПлатаЗаРазмещение.НайтиСтроки(
				Новый Структура("СчетДоверительногоУправления, Дата",
					ТекСтрокаВвода.СчетДоверительногоУправления,
					?(ТекСтрокаВвода.Период = '20251219', '20251223', ТекСтрокаВвода.Период)));
					
			Если НайдСтрокиВознаграждения.Количество() > 1 Тогда
				ВызватьИсключение "Ошибка печати расчета вознаграждения: неоднозначное вознаграждение за привлечение";
			ИначеЕсли НайдСтрокиВознаграждения.Количество() = 0 Тогда
				ВызватьИсключение "Ошибка печати расчета вознаграждения: отсутствует вознаграждение за привлечение";
			КонецЕсли;			
			
			ОбластьОтчета.Параметры.СтоимостьИмущества = ТекСтрокаВвода.БалансоваяСтоимость;
			ВознаграждениеЗаРазмещение = НайдСтрокиВознаграждения[0].СуммаВознаграждения;
			ОбластьОтчета.Параметры.СуммаВознаграждения = ВознаграждениеЗаРазмещение;
			
		КонецЕсли;
		
		ОбластьОтчета.Параметры.Дата 								= Формат(ТекСтрокаВвода.Период, "ДФ=dd.MM.yyyy");
		ОбластьОтчета.Параметры.ОценочнаяСтоимостьИмущества 		= ТекСтрокаВвода.БалансоваяСтоимость - ВознаграждениеЗаРазмещение;
		ОбластьОтчета.Параметры.ДнейДоОкончанияРасчетногоПериода 	= ТекСтрокаВвода.ДнейВУправлении;
		
		СтрокаДляФормулы = СтрокаДляФормулы + ?(СтрокаДляФормулы = "", "", "+") + "(" + Формат(ОбластьОтчета.Параметры.ОценочнаяСтоимостьИмущества, "ЧДЦ=2") + "*" + Формат(ТекСтрокаВвода.ДнейВУправлении, "ЧДЦ=0") + ")";
		
		ФормаРасчета.Вывести(ОбластьОтчета);
		
	КонецЦикла;

	// Если в расчетном периоде не было вводов активов, выводим строку с прочерками
	Если ВводыАктивовПоСчету.Количество() = 0 Тогда
		ДобавитьСтрокуСПрочерками(ФормаРасчета, ОбластьОтчета);	
	КонецЕсли;
		
	#КонецОбласти
	
	// Подвал
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Подвал");
	
	ДнейВРасчетномПериоде    						  	= (НачалоДня(ВознаграждениеПоСчету[0].КонецПериодаНачисления) - ВознаграждениеПоСчету[0].НачалоПериодаНачисления) / 86400 + 1;
	ОбластьОтчета.Параметры.ДнейВРасчетномПериоде 		= ДнейВРасчетномПериоде;
	ДнейВКвартале			    						= (КонецКвартала(ЭтотОбъект.ДатаРасчета) - НачалоКвартала(ЭтотОбъект.ДатаРасчета) + 1) / 86400;
	ОбластьОтчета.Параметры.ДнейВКвартале			    = ДнейВКвартале;
	ОбластьОтчета.Параметры.Ставка						= ВознаграждениеПоСчету[0].Ставка;
	ОбластьОтчета.Параметры.СредняяОценочнаяСтоимость	= ФорматСуммы(ВознаграждениеПоСчету[0].СредняяОценочнаяСтоимость);
	
	ОбластьОтчета.Параметры.СуммаВознаграждения = ФорматСуммы(ВознаграждениеПоСчету[0].СуммаВознаграждения);
	
	Числитель = ?(ДнейВРасчетномПериоде = 0 Или ОценочнаяСтоимостьДоНачалаПериода = 0, "0", Формат(ДнейВРасчетномПериоде, "ЧДЦ=0") + "*" + Формат(ОценочнаяСтоимостьДоНачалаПериода,"ЧДЦ=2"))
				+ "+" + ?(СтрокаДляФормулы = "", "0", СтрокаДляФормулы);
	ОбластьОтчета.Параметры.Числитель = Числитель;
	
	// Число в знаменателе должно быть примерно в середине под чертой дроби
	Отступ = Цел(СтрДлина(Числитель) / 2);
	Отступ = Цел(Отступ * 1.5);
	
	СтрОтступ = "";
	Для Сч = 1 По Отступ Цикл
		СтрОтступ = СтрОтступ + " ";	
	КонецЦикла;
	
	ОбластьОтчета.Параметры.Знаменатель = СтрОтступ + Формат(ДнейВКвартале, "ЧДЦ=0");
	
	ФормаРасчета.Вывести(ОбластьОтчета);
				
	// Наводим красоту
	ФормаРасчета.ОтображатьЗаголовки = Ложь;
	ФормаРасчета.ОтображатьСетку = Ложь;
	ФормаРасчета.Защита = Ложь;
	ФормаРасчета.ТолькоПросмотр = Истина;

	Возврат ФормаРасчета;
	
КонецФункции // СформироватьФормуРасчетаВознагражденияДляБухгалтерии

#КонецОбласти

#Область Вознаграждение_агента

Функция СформироватьФормуРасчетаВознагражденияАгента(ДанныеПоРасчетуВознагражденияУправляющего, Подписант = "", ПодписантДолжность = "") Экспорт

	Если ТипЗнч(ДанныеПоРасчетуВознагражденияУправляющего) <> Тип("ХранилищеЗначения") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сначала необходимо выполнить расчет вознаграждения");
		Возврат Неопределено;
	КонецЕсли;
	
	ФормаРасчета = Новый ТабличныйДокумент;
	
	МакетОтчета = ЭтотОбъект.ПолучитьМакет("РасчетВознагражденияАгентаПоИИС");
	
	_ДанныеПоРасчетуВознагражденияУправляющего = ДанныеПоРасчетуВознагражденияУправляющего.Получить();
	
	РеквизитыАгента = ПолучитьРеквизитыАгентаДляПечатиФормыРасчета();
		
	// шапка
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("ШапкаОтчета");
	ОбластьОтчета.Параметры.Заполнить(РеквизитыАгента);
	ОбластьОтчета.Параметры.ДатаДоговора  = Формат(РеквизитыАгента.ДатаДоговора, "ДФ=dd.MM.yyyy");
	//ОбластьОтчета.Параметры.ДатаНачала    = Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy");
	ОбластьОтчета.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ДатаРасчета, "ДФ=dd.MM.yyyy");
	
	ФормаРасчета.Вывести(ОбластьОтчета);
	
	// таблица
	НомерСтроки = 1;
	Для каждого СтрокаДанных Из _ДанныеПоРасчетуВознагражденияУправляющего.Вознаграждения Цикл
		
		Если СтрокаДанных.СуммаВознаграждения = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОбластьОтчета = МакетОтчета.ПолучитьОбласть("СтрокаОтчета");
		ОбластьОтчета.Параметры.Заполнить(СтрокаДанных);
		ОбластьОтчета.Параметры.НомерДоговораДУ = СтрокаДанных.НомерДоговора;
		ОбластьОтчета.Параметры.ДатаДоговораДУ = Формат(СтрокаДанных.ДатаЗаключения, "ДФ=dd.MM.yyyy");
		ОбластьОтчета.Параметры.НомерСтроки = НомерСтроки;
	
		ФормаРасчета.Вывести(ОбластьОтчета);
		
		НомерСтроки = НомерСтроки + 1;
	
	КонецЦикла; 
	
	// подвал
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("ПодвалОтчета");
	ОбластьОтчета.Параметры.Подписант = СокрЛП(Подписант);
	ОбластьОтчета.Параметры.ПодписантДолжность = СокрЛП(ПодписантДолжность);
	
	ОбластьОтчета.Параметры.СредняяОценочнаяСтоимость = _ДанныеПоРасчетуВознагражденияУправляющего.Вознаграждения.Итог("СредняяОценочнаяСтоимость");
	ОбластьОтчета.Параметры.СуммаВознаграждения = _ДанныеПоРасчетуВознагражденияУправляющего.Вознаграждения.Итог("СуммаВознаграждения");
	
	ФормаРасчета.Вывести(ОбластьОтчета);
		
	ФормаРасчета.ОтображатьЗаголовки = Ложь;
	ФормаРасчета.ОтображатьСетку = Ложь;
	ФормаРасчета.Защита = Ложь;
	ФормаРасчета.ТолькоПросмотр = Истина;

	Возврат ФормаРасчета;
	
КонецФункции // СформироватьФормуРасчетаВознагражденияДляБухгалтерии

Функция СформироватьФормуРасчетаВознагражденияАгентаМКБ(ДанныеПоРасчетуВознагражденияУправляющего, Подписант = "", ПодписантДолжность = "") Экспорт

	Если ТипЗнч(ДанныеПоРасчетуВознагражденияУправляющего) <> Тип("ХранилищеЗначения") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сначала необходимо выполнить расчет вознаграждения");
		Возврат Неопределено;
	КонецЕсли;
	
	ФормаРасчета = Новый ТабличныйДокумент;
	
	МакетОтчета = ЭтотОбъект.ПолучитьМакет("РасчетВознагражденияАгентаПоИИС_МКБ");
	
	_ДанныеПоРасчетуВознагражденияУправляющего = ДанныеПоРасчетуВознагражденияУправляющего.Получить();
	
	РеквизитыАгента = ПолучитьРеквизитыАгентаДляПечатиФормыРасчета();
	НачалоПериода = _ДанныеПоРасчетуВознагражденияУправляющего.НачалоПериода;
	
	// шапка
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("ШапкаОтчета");
	ОбластьОтчета.Параметры.Заполнить(РеквизитыАгента);
	ОбластьОтчета.Параметры.ДатаДоговора  = Формат(РеквизитыАгента.ДатаДоговора, 	"ДФ=dd.MM.yyyy");
	ОбластьОтчета.Параметры.ДатаНачала    = Формат(НачалоПериода, 					"ДФ=dd.MM.yyyy");
	ОбластьОтчета.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ДатаРасчета, 			"ДФ=dd.MM.yyyy");
	
	ФормаРасчета.Вывести(ОбластьОтчета);
	
	// таблица вознаграждения № 1 (плата за размещение)
	НомерСтроки = 1;
	Для каждого СтрокаДанных Из _ДанныеПоРасчетуВознагражденияУправляющего.ВознагражденияПлатаЗаРазмещение Цикл
		
		Если СтрокаДанных.СуммаВознаграждения = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОбластьОтчета = МакетОтчета.ПолучитьОбласть("СтрокаОтчета");
		ОбластьОтчета.Параметры.Заполнить(СтрокаДанных);
		ОбластьОтчета.Параметры.НомерДоговораДУ = СтрокаДанных.НомерДоговора;
		ОбластьОтчета.Параметры.ДатаДоговораДУ  = Формат(СтрокаДанных.ДатаЗаключения, "ДФ=dd.MM.yyyy");
		ОбластьОтчета.Параметры.НомерСтроки     = НомерСтроки;
	    ОбластьОтчета.Параметры.БазаДляРасчета  = СтрокаДанных.БалансоваяСтоимость;
		ФормаРасчета.Вывести(ОбластьОтчета);
		
		НомерСтроки = НомерСтроки + 1;
	
	КонецЦикла; 
	
	// Итог
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Итого");
	ОбластьОтчета.Параметры.БазаДляРасчета 		= _ДанныеПоРасчетуВознагражденияУправляющего.ВознагражденияПлатаЗаРазмещение.Итог("БалансоваяСтоимость");
	ОбластьОтчета.Параметры.СуммаВознаграждения = _ДанныеПоРасчетуВознагражденияУправляющего.ВознагражденияПлатаЗаРазмещение.Итог("СуммаВознаграждения");
	
	ФормаРасчета.Вывести(ОбластьОтчета);
	
	// таблица вознаграждения № 2 (вознаграждение за управление)
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("ШапкаВознаграждения2");
	ФормаРасчета.Вывести(ОбластьОтчета);
	
	НомерСтроки = 1;
	Для каждого СтрокаДанных Из _ДанныеПоРасчетуВознагражденияУправляющего.Вознаграждения Цикл
		
		Если СтрокаДанных.СуммаВознаграждения = 0 Тогда 
			Продолжить;
		КонецЕсли;
		
		ОбластьОтчета = МакетОтчета.ПолучитьОбласть("СтрокаОтчета");
		ОбластьОтчета.Параметры.Заполнить(СтрокаДанных);
		ОбластьОтчета.Параметры.НомерДоговораДУ = СтрокаДанных.НомерДоговора;
		ОбластьОтчета.Параметры.ДатаДоговораДУ  = Формат(СтрокаДанных.ДатаЗаключения, "ДФ=dd.MM.yyyy");
		ОбластьОтчета.Параметры.НомерСтроки     = НомерСтроки;
		ОбластьОтчета.Параметры.БазаДляРасчета  = СтрокаДанных.СредняяОценочнаяСтоимость;
	
		ФормаРасчета.Вывести(ОбластьОтчета);
		
		НомерСтроки = НомерСтроки + 1;
	
	КонецЦикла; 
	
	// Итог
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Итого");
	ОбластьОтчета.Параметры.БазаДляРасчета 		= _ДанныеПоРасчетуВознагражденияУправляющего.Вознаграждения.Итог("СредняяОценочнаяСтоимость");
	ОбластьОтчета.Параметры.СуммаВознаграждения = _ДанныеПоРасчетуВознагражденияУправляющего.Вознаграждения.Итог("СуммаВознаграждения");
	
	ФормаРасчета.Вывести(ОбластьОтчета);

	// подвал
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("ПодвалОтчета");
	ОбластьОтчета.Параметры.Подписант = СокрЛП(Подписант);
	ОбластьОтчета.Параметры.ПодписантДолжность = СокрЛП(ПодписантДолжность);
	
	ОбластьОтчета.Параметры.ДатаНачала    = Формат(НачалоПериода, 					"ДФ=dd.MM.yyyy");
	ОбластьОтчета.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ДатаРасчета, 			"ДФ=dd.MM.yyyy");
	
	СтавкаНДС = ?(ЭтотОбъект.ДатаРасчета < '20190101', 18/118, 20/120);
	
	Итого		= _ДанныеПоРасчетуВознагражденияУправляющего.ВознагражденияПлатаЗаРазмещение.Итог("СуммаВознаграждения") + _ДанныеПоРасчетуВознагражденияУправляющего.Вознаграждения.Итог("СуммаВознаграждения");
	ИтогоНДС	= Окр(Итого * СтавкаНДС, 2, 1);
		
	ОбластьОтчета.Параметры.Итого		= Формат(Итого, 	"ЧДЦ=2");
	ОбластьОтчета.Параметры.ИтогоНДС	= Формат(ИтогоНДС, 	"ЧДЦ=2");
	
	ОбластьОтчета.Параметры.ИтогоПрописью 		= ЧислоПрописью(Итого, 		"Л = ru_RU; НП = Истина; НД = Истина", "рубль,рубля,рублей,м,копейка,копейки,копеек, ж,2");
	ОбластьОтчета.Параметры.ИтогоНДСПрописью	= ЧислоПрописью(ИтогоНДС,	"Л = ru_RU; НП = Истина; НД = Истина", "рубль,рубля,рублей,м,копейка,копейки,копеек, ж,2");
	
	ФормаРасчета.Вывести(ОбластьОтчета);
		
	ФормаРасчета.ОтображатьЗаголовки = Ложь;
	ФормаРасчета.ОтображатьСетку = Ложь;
	ФормаРасчета.Защита = Ложь;
	ФормаРасчета.ТолькоПросмотр = Истина;
	ФормаРасчета.АвтоМасштаб = Истина;

	Возврат ФормаРасчета;
	
КонецФункции // СформироватьФормуРасчетаВознагражденияАгентаМКБ

Функция СформироватьФормуРасчетаВознагражденияАгентаВБРР(ДанныеПоРасчетуВознагражденияУправляющего, Подписант = "", ПодписантДолжность = "") Экспорт

	Если ТипЗнч(ДанныеПоРасчетуВознагражденияУправляющего) <> Тип("ХранилищеЗначения") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сначала необходимо выполнить расчет вознаграждения");
		Возврат Неопределено;
	КонецЕсли;
	
	ФормаРасчета = Новый ТабличныйДокумент;
	
	МакетОтчета = ЭтотОбъект.ПолучитьМакет("РасчетВознагражденияАгентаДляВБРР");
	
	_ДанныеПоРасчетуВознагражденияУправляющего = ДанныеПоРасчетуВознагражденияУправляющего.Получить();
	
	РеквизитыАгента = ПолучитьРеквизитыАгентаДляПечатиФормыРасчета();
	НачалоПериода = _ДанныеПоРасчетуВознагражденияУправляющего.НачалоПериода;
	
	// шапка
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("ШапкаОтчета");
	ОбластьОтчета.Параметры.Заполнить(РеквизитыАгента);
	ОбластьОтчета.Параметры.ДатаНачала    = Формат(НачалоПериода, 					"ДФ=dd.MM.yyyy");
	ОбластьОтчета.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ДатаРасчета, 			"ДФ=dd.MM.yyyy");
	ОбластьОтчета.Параметры.ДатаРасчета = Формат(ЭтотОбъект.ДатаРасчета, 			"ДФ=dd.MM.yyyy");
	
	ФормаРасчета.Вывести(ОбластьОтчета);
	
	НомерСтроки = 1;
	Для Каждого СтрокаДанных Из _ДанныеПоРасчетуВознагражденияУправляющего.ВознагражденияПлатаЗаРазмещение Цикл
		
		Если СтрокаДанных.СуммаВознаграждения = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОбластьОтчета = МакетОтчета.ПолучитьОбласть("СтрокаОтчета");
		ОбластьОтчета.Параметры.Заполнить(СтрокаДанных);
		ОбластьОтчета.Параметры.НомерДоговораДУ = СтрокаДанных.НомерДоговора;
		ОбластьОтчета.Параметры.ДатаДоговораДУ  = Формат(СтрокаДанных.ДатаЗаключения, "ДФ=dd.MM.yyyy");
		ОбластьОтчета.Параметры.НомерСтроки     = НомерСтроки;
	    ОбластьОтчета.Параметры.БазаДляРасчета  = СтрокаДанных.БалансоваяСтоимость;
		ФормаРасчета.Вывести(ОбластьОтчета);
		
		НомерСтроки = НомерСтроки + 1;
	
	КонецЦикла; 
	
	// Итог
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("Итого");
	ОбластьОтчета.Параметры.СуммаВознаграждения = _ДанныеПоРасчетуВознагражденияУправляющего.ВознагражденияПлатаЗаРазмещение.Итог("СуммаВознаграждения");
	
	ФормаРасчета.Вывести(ОбластьОтчета);
	
	// Подвал
	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("ПодвалОтчета");
	ОбластьОтчета.Параметры.Подписант = СокрЛП(Подписант);
	
	ОбластьОтчета.Параметры.ДатаНачала    = Формат(НачалоПериода, 					"ДФ=dd.MM.yyyy");
	ОбластьОтчета.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ДатаРасчета, 			"ДФ=dd.MM.yyyy");
	
	СтавкаНДС = ?(ЭтотОбъект.ДатаРасчета < '20190101', 18/118, ?(ЭтотОбъект.ДатаРасчета < '20260101', 20/120, 22/122));
	
	Итого		= _ДанныеПоРасчетуВознагражденияУправляющего.ВознагражденияПлатаЗаРазмещение.Итог("СуммаВознаграждения") + _ДанныеПоРасчетуВознагражденияУправляющего.Вознаграждения.Итог("СуммаВознаграждения");
	ИтогоНДС	= Окр(Итого * СтавкаНДС, 2, 1);
		
	ОбластьОтчета.Параметры.Итого				= Формат(Цел(Итого), 	"ЧДЦ=0");
	ОбластьОтчета.Параметры.ИтогоНДС			= Формат(Цел(ИтогоНДС), 	"ЧДЦ=0");
	ОбластьОтчета.Параметры.ИтогоКопеек			= Формат((Итого - Цел(Итого))*100, 	"ЧЦ=2; ЧДЦ=0; ЧН=00; ЧВН=");
	ОбластьОтчета.Параметры.ИтогоНДСКопеек		= Формат((ИтогоНДС - Цел(ИтогоНДС))*100, 	"ЧЦ=2; ЧДЦ=0; ЧН=00; ЧВН=");
	ОбластьОтчета.Параметры.ИтогоПрописью 		= СтрЗаменить(ЧислоПрописью(Цел(Итого), 		"Л = ru_RU; НП = Ложь; НД = Ложь", "рубль,рубля,рублей,м,копейка,копейки,копеек, ж,2"), " 00", "");
	ОбластьОтчета.Параметры.ИтогоНДСПрописью	= СтрЗаменить(ЧислоПрописью(Цел(ИтогоНДС),	"Л = ru_RU; НП = Ложь; НД = Ложь", "рубль,рубля,рублей,м,копейка,копейки,копеек, ж,2"), " 00", "");
	
	ФормаРасчета.Вывести(ОбластьОтчета);
		
	ФормаРасчета.ОтображатьЗаголовки = Ложь;
	ФормаРасчета.ОтображатьСетку	 = Ложь;
	ФормаРасчета.Защита				 = Ложь;
	ФормаРасчета.ТолькоПросмотр		 = Истина;
	ФормаРасчета.АвтоМасштаб		 = Истина;

	Возврат ФормаРасчета;
	
КонецФункции // СформироватьФормуРасчетаВознагражденияАгентаВБРР


Функция СформироватьФормуРасчетаВознагражденияАгентаДВБ(ДанныеПоРасчетуВознагражденияУправляющего, Подписант = "", ПодписантДолжность = "") Экспорт

	Если ТипЗнч(ДанныеПоРасчетуВознагражденияУправляющего) <> Тип("ХранилищеЗначения") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сначала необходимо выполнить расчет вознаграждения");
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЭтотОбъект.ДатаРасчета < '20190101' Тогда
		СтавкаНДС = 18/118;
	ИначеЕсли ЭтотОбъект.ДатаРасчета < '20260101' Тогда
		СтавкаНДС = 20/120;
	Иначе
		СтавкаНДС = 22/122;
	КонецЕсли;
	
	ИтогоНДС = 0;
		
