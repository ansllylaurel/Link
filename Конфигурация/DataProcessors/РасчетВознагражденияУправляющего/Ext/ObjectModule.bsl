			|	_ВводыАктивовЗаПредрасчетныйПериод_Расшифровка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ВводыАктивовЗаПредрасчетныйПериод_Расшифровка.Период КАК Период,
			|	_ВводыАктивовЗаПредрасчетныйПериод_Расшифровка.БалансоваяСтоимость КАК БалансоваяСтоимость
			|ИЗ
			|	_ВводыАктивовЗаПредрасчетныйПериод_Расшифровка КАК _ВводыАктивовЗаПредрасчетныйПериод_Расшифровка";	
		
	ИначеЕсли ИмяВыборки = "РасшифровкаРасчетаВознаграждений" Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ВводыАктивовЗаРасчетныйПериод.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ВводыАктивовЗаРасчетныйПериод.Период КАК Период,
			|	_ВводыАктивовЗаРасчетныйПериод.ДнейВУправлении КАК ДнейВУправлении,
			|	_ВводыАктивовЗаРасчетныйПериод.БалансоваяСтоимость КАК БалансоваяСтоимость,
			|	ВЫРАЗИТЬ(_ВводыАктивовЗаРасчетныйПериод.СредняяОценочнаяСтоимость * _НастройкиРасчетаВознаграждения.СтавкаВознагражденияЗаУправление / 100 КАК ЧИСЛО(15, 2)) КАК СуммаВознаграждения,
			|	_ВводыАктивовЗаРасчетныйПериод.Регистратор КАК Регистратор,
			|	_НастройкиРасчетаВознаграждения.Стратегия КАК Стратегия,
			|	_НастройкиРасчетаВознаграждения.СтавкаВознагражденияЗаУправление КАК СтавкаВознагражденияЗаУправление,
			|	_ВводыАктивовЗаРасчетныйПериод.ДнейВПериоде КАК ДнейВПериоде
			|ИЗ
			|	_ВводыАктивовЗаРасчетныйПериод КАК _ВводыАктивовЗаРасчетныйПериод
			|		ЛЕВОЕ СОЕДИНЕНИЕ _НастройкиРасчетаВознаграждения КАК _НастройкиРасчетаВознаграждения
			|		ПО _ВводыАктивовЗаРасчетныйПериод.СчетДоверительногоУправления = _НастройкиРасчетаВознаграждения.СчетДоверительногоУправления
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_ВводыАктивовЗаПредрасчетныйПериод.СчетДоверительногоУправления,
			|	КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&НачалоБазовогоПериода, ДЕНЬ, -1), ДЕНЬ),
			|	_ВводыАктивовЗаПредрасчетныйПериод.ДнейВУправлении,
			|	_ВводыАктивовЗаПредрасчетныйПериод.БалансоваяСтоимость,
			|	ВЫРАЗИТЬ(_ВводыАктивовЗаПредрасчетныйПериод.СредняяОценочнаяСтоимость * _НастройкиРасчетаВознаграждения.СтавкаВознагражденияЗаУправление / 100 КАК ЧИСЛО(15, 2)),
			|	НЕОПРЕДЕЛЕНО,
			|	_НастройкиРасчетаВознаграждения.Стратегия,
			|	_НастройкиРасчетаВознаграждения.СтавкаВознагражденияЗаУправление,
			|	_ВводыАктивовЗаПредрасчетныйПериод.ДнейВПериоде
			|ИЗ
			|	_ВводыАктивовЗаПредрасчетныйПериод КАК _ВводыАктивовЗаПредрасчетныйПериод
			|		ЛЕВОЕ СОЕДИНЕНИЕ _НастройкиРасчетаВознаграждения КАК _НастройкиРасчетаВознаграждения
			|		ПО _ВводыАктивовЗаПредрасчетныйПериод.СчетДоверительногоУправления = _НастройкиРасчетаВознаграждения.СчетДоверительногоУправления
			|
			|УПОРЯДОЧИТЬ ПО
			|	Период
			|ИТОГИ ПО
			|	Стратегия,
			|	СчетДоверительногоУправления";
		
	ИначеЕсли ИмяВыборки = "ОплатыВознагражденийЗаПредрасчетныйПериод" Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОстаткиДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	СУММА(ОстаткиДенежныхСредств.Сумма) КАК Сумма
			|ИЗ
			|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
			|ГДЕ
			|	ОстаткиДенежныхСредств.Период <= &НачалоБазовогоПериода
			|	И ОстаткиДенежныхСредств.Организация = &Организация
			|	И ОстаткиДенежныхСредств.СчетДоверительногоУправления В
			|			(ВЫБРАТЬ
			|				_НастройкиРасчетаВознаграждения.СчетДоверительногоУправления
			|			ИЗ
			|				_НастройкиРасчетаВознаграждения)
			|	И ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющего)
			|
			|СГРУППИРОВАТЬ ПО
			|	ОстаткиДенежныхСредств.СчетДоверительногоУправления";
		
	ИначеЕсли ИмяВыборки = "ОстаткиАктивовНаНачалоРасчетногоПериода" Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ВводыАктивовЗаПредрасчетныйПериод.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	НАЧАЛОПЕРИОДА(&НачалоБазовогоПериода, ДЕНЬ) КАК Период,
			|	_ВводыАктивовЗаПредрасчетныйПериод.ДнейВУправлении КАК ДнейВУправлении,
			|	СУММА(_ВводыАктивовЗаПредрасчетныйПериод.БалансоваяСтоимость) КАК БалансоваяСтоимость,
			|	СУММА(_ВводыАктивовЗаПредрасчетныйПериод.СредняяОценочнаяСтоимость * _НастройкиРасчетаВознаграждения.СтавкаВознагражденияЗаУправление / 100) КАК СуммаВознаграждения,
			|	_НастройкиРасчетаВознаграждения.Стратегия КАК Стратегия,
			|	_ВводыАктивовЗаПредрасчетныйПериод.ДнейВПериоде КАК ДнейВПериоде
			|ИЗ
			|	_ВводыАктивовЗаПредрасчетныйПериод КАК _ВводыАктивовЗаПредрасчетныйПериод
			|		ЛЕВОЕ СОЕДИНЕНИЕ _НастройкиРасчетаВознаграждения КАК _НастройкиРасчетаВознаграждения
			|		ПО _ВводыАктивовЗаПредрасчетныйПериод.СчетДоверительногоУправления = _НастройкиРасчетаВознаграждения.СчетДоверительногоУправления
			|
			|СГРУППИРОВАТЬ ПО
			|	_ВводыАктивовЗаПредрасчетныйПериод.СчетДоверительногоУправления,
			|	_ВводыАктивовЗаПредрасчетныйПериод.ДнейВУправлении,
			|	_НастройкиРасчетаВознаграждения.Стратегия,
			|	_ВводыАктивовЗаПредрасчетныйПериод.ДнейВПериоде";
		
	ИначеЕсли ИмяВыборки = "СчетаДоверительногоУправления" Тогда
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	*
			|ИЗ
			|	_НастройкиРасчетаВознаграждения";

	Иначе
		Возврат Неопределено;	
		
	КонецЕсли; 
	
	Возврат Запрос.Выполнить();

КонецФункции

Функция ПолучитьРеквизитыОрганизацииАнкетные(Организация, Период)
	
	РеквизитыОрганизации = Новый Структура("НаименованиеОрганизации, КраткоеНаименованиеОрганизации, ИННОрганизации, КППОрганизации, АдресОрганизации, КраткийКод");
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеквизитыОрганизацииАнкетные.ПолноеНаименованиеПоУставу КАК НаименованиеОрганизации,
		|	РеквизитыОрганизацииАнкетные.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеОрганизации,
		|	РеквизитыОрганизацииАнкетные.ИНН КАК ИННОрганизации,
		|	РеквизитыОрганизацииАнкетные.КПП КАК КППОрганизации,
		|	РеквизитыОрганизацииАнкетные.ЮридическийАдрес КАК АдресОрганизации,
		|	ВЫБОР
		|		КОГДА &Организация = &Организация_РЭМ
		|			ТОГДА ""РЭМ""
		|		КОГДА &Организация = &Организация_ТрастМ
		|			ТОГДА ""Траст""
		|	КОНЕЦ КАК КраткийКод
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И ЮрФизЛицо = &ЮрЛицо
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыОрганизацииАнкетные
		|ГДЕ
		|	РеквизитыОрганизацииАнкетные.ЮрФизЛицо = &ЮрЛицо");
	
	Запрос.УстановитьПараметр("Период",				Период);
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("ЮрЛицо",				Организация.ЮрФизЛицо);
	Запрос.УстановитьПараметр("Организация_РЭМ",	ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"));
	Запрос.УстановитьПараметр("Организация_ТрастМ",	ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(РеквизитыОрганизации, Выборка);
	КонецЕсли;

	Возврат РеквизитыОрганизации;
	
КонецФункции

Функция ПолучитьРеквизитыСчетовДоверительногоУправления(СчетаДоверительногоУправления, РезультатКакТаблицаЗначений = Ложь)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговораДУ,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговораДУ,
		|	СчетаДоверительногоУправления.КодСчета КАК КодСчетаДУ,
		|	РАЗНОСТЬДАТ(СчетаДоверительногоУправления.ДатаЗаключения, &Период, ДЕНЬ) КАК ДнейВУправлении,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество КАК УчредительУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления В (&СчетаДоверительногоУправления)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ПО (РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо = КлиентыДоверительногоУправленияСрезПоследних.Клиент)
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка В(&СчетаДоверительногоУправления)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетаДоверительногоУправления.Наименование";
	
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.ДатаРасчета);
	
	Если РезультатКакТаблицаЗначений Тогда
		Возврат Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции // ВыбратьРеквизитыСчетовДоверительногоУправленияДляПечатиФормыРасчета

Функция ВыбратьРеквизитыПИФДляПечати(СчетаДоверительногоУправления, РезультатКакТаблицаЗначений = Ложь)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	РеквизитыПИФСрезПоследних.ПолноеНаименованиеФонда КАК НаименованиеПИФ
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления В (&СчетаДоверительногоУправления)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&Период, ) КАК РеквизитыПИФСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка В(&СчетаДоверительногоУправления)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетаДоверительногоУправления.Наименование";
	
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаДоверительногоУправления);
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.ДатаРасчета);
	
	Если РезультатКакТаблицаЗначений Тогда
		Возврат Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции // ВыбратьРеквизитыПИФДляПечати

Функция ФорматСуммы(Сумма)
	
	Возврат Формат(Сумма, "ЧДЦ=2");
	
КонецФункции // ФорматСуммы

Процедура ДобавитьСтрокуСПрочерками(Табдокумент, ОбластьОтчета)
	
	ИндексПоследнего = ОбластьОтчета.Параметры.Количество() - 1;
	Для Индекс = 0 По ИндексПоследнего Цикл
		ОбластьОтчета.Параметры.Установить(Индекс, "-");	
	КонецЦикла;
	
	Табдокумент.Вывести(ОбластьОтчета);
	
КонецПроцедуры

#КонецОбласти