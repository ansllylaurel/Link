	ОбластьОтчета = МакетОтчета.ПолучитьОбласть("ШапкаВознагражденияЗаПривлечение");
	ОбластьОтчета.Параметры.Заполнить(РеквизитыАгента);
	ОбластьОтчета.Параметры.ДатаДоговора  = Формат(РеквизитыАгента.ДатаДоговора, 	"ДФ=dd.MM.yyyy");
	ОбластьОтчета.Параметры.ДатаНачала    = Формат(НачалоПериодаЗаПривлечение, 		"ДФ=dd.MM.yyyy");
	ОбластьОтчета.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ДатаРасчета, 			"ДФ=dd.MM.yyyy");
	ОбластьОтчета.Параметры.ДатаРасчета	  = Формат(ЭтотОбъект.ДатаРасчета, 			"ДФ=dd.MM.yyyy");
	
	ФормаРасчета.Вывести(ОбластьОтчета);
	
