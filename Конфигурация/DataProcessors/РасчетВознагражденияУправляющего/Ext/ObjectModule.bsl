		|	_Клиенты.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	_Клиенты.КодСчета КАК КодСчета,
		|	_Клиенты.НомерДоговора КАК НомерДоговора,
		|	_Клиенты.ДатаЗаключения КАК ДатаЗаключения,
		|	_Клиенты.ДатаРасторжения КАК ДатаРасторжения,
		|	_Клиенты.Клиент КАК Клиент,
		|	_Клиенты.НачалоБазовогоПериода КАК НачалоБазовогоПериода,
		|	_Клиенты.НачалоБазовогоПериодаДляОтображения КАК НачалоБазовогоПериодаДляОтображения,
		|	_Клиенты.КонецБазовогоПериода КАК КонецБазовогоПериода,
		|	_Клиенты.КонецБазовогоПериодаДляОтображения КАК КонецБазовогоПериодаДляОтображения,
		|	_Клиенты.НачалоПериодаНачисления КАК НачалоПериодаНачисления,
		|	_Клиенты.КонецПериодаНачисления КАК КонецПериодаНачисления,
		|	_Клиенты.ДоговорЗаключенДоТекущегоГода КАК ДоговорЗаключенДоТекущегоГода,
		|	_Клиенты.КонецПредыдущегоГода КАК КонецПредыдущегоГода,
		|	_Клиенты.НачалоГода КАК НачалоГода,
		|	_Клиенты.ДнейВГоду КАК ДнейВГоду,
		|	_Клиенты.НачалоРасчетногоПериода КАК НачалоРасчетногоПериода,
		|	_Клиенты.КонецРасчетногоПериода КАК КонецРасчетногоПериода,
		|	_Клиенты.КоличествоДнейПериодаРасчета КАК КоличествоДнейПериодаРасчета,
		|	_Клиенты.ШаблонРасшифровки КАК ШаблонРасшифровки,
		|	_Клиенты.ШаблонАкта КАК ШаблонАкта,
		|	_Клиенты.ВалютаУчета КАК ВалютаУчета,
		|	_Клиенты.ВалютаРасчета КАК ВалютаРасчета,
		|	_Клиенты.ОграничениеОбщегоРазмераВознаграждения КАК ОграничениеОбщегоРазмераВознаграждения,
		|	КурсВалютыРасчета.Курс / КурсВалютыРасчета.Кратность КАК КурсВалютыРасчета,
		|	ЛОЖЬ КАК ОшибкаРасчета,
		|	ВЫРАЗИТЬ(0 КАК ЧИСЛО(15, 2)) КАК СуммаВознаграждения,
		|	ВЫРАЗИТЬ(0 КАК ЧИСЛО(15, 2)) КАК СуммаВознагражденияНарастающимИтогом,
		|	ВЫРАЗИТЬ(0 КАК ЧИСЛО(15, 2)) КАК СуммаВознагражденияЗаУправление,
		|	ВЫРАЗИТЬ("""" КАК СТРОКА(256)) КАК Описание,
		|	ВЫРАЗИТЬ("""" КАК СТРОКА) КАК РасшифровкаОшибки,
		|	ЕСТЬNULL(РеквизитыЮрЛицаКлиентаАнкетные.КраткоеНаименованиеПоУставу, РеквизитыФизЛицаКлиентаАнкетные.Фамилия + "" "" + РеквизитыФизЛицаКлиентаАнкетные.Имя + "" "" + РеквизитыФизЛицаКлиентаАнкетные.Отчество) КАК УчредительУправления,
		|	ЕСТЬNULL(РеквизитыЮрЛицаКлиентаАнкетные.ПолноеНаименованиеПоУставу, РеквизитыФизЛицаКлиентаАнкетные.Фамилия + "" "" + РеквизитыФизЛицаКлиентаАнкетные.Имя + "" "" + РеквизитыФизЛицаКлиентаАнкетные.Отчество) КАК ПолноеНаименованиеУчредителяУправления,
		|	ЕСТЬNULL(РеквизитыЮрЛицаКлиентаАнкетные.КраткоеНаименованиеПоУставу, РеквизитыФизЛицаКлиентаАнкетные.Фамилия + "" "" + ВЫБОР
		|			КОГДА РеквизитыФизЛицаКлиентаАнкетные.Имя = """"
		|				ТОГДА """"
		|			ИНАЧЕ ПОДСТРОКА(РеквизитыФизЛицаКлиентаАнкетные.Имя, 1, 1) + "". ""
		|		КОНЕЦ + ВЫБОР
		|			КОГДА РеквизитыФизЛицаКлиентаАнкетные.Отчество = """"
		|				ТОГДА """"
		|			ИНАЧЕ ПОДСТРОКА(РеквизитыФизЛицаКлиентаАнкетные.Отчество, 1, 1) + "".""
		|		КОНЕЦ) КАК КраткоеНаименованиеУчредителяУправления,
		|	НЕОПРЕДЕЛЕНО КАК Начисление,
		|	ВЫРАЗИТЬ(0 КАК ЧИСЛО(15, 2)) КАК СуммаНачисления,
		|	ЛОЖЬ КАК ОшибкаРасчетаНачисления,
		|	ВЫРАЗИТЬ("""" КАК СТРОКА) КАК РасшифровкаОшибкиНачисления
		|ИЗ
		|	_Клиенты КАК _Клиенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ДатаРасчета,
		|				(Организация, ЮрФизЛицо, Язык) В
		|					(ВЫБРАТЬ
		|						_Клиенты.Организация,
		|						_Клиенты.Клиент,
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					ИЗ
		|						_Клиенты)) КАК РеквизитыЮрЛицаКлиентаАнкетные
		|		ПО (РеквизитыЮрЛицаКлиентаАнкетные.ЮрФизЛицо = _Клиенты.Клиент)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&ДатаРасчета,
		|				(Организация, ЮрФизЛицо, Язык) В
		|					(ВЫБРАТЬ
		|						_Клиенты.Организация,
		|						_Клиенты.Клиент,
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					ИЗ
		|						_Клиенты)) КАК РеквизитыФизЛицаКлиентаАнкетные
		|		ПО (РеквизитыФизЛицаКлиентаАнкетные.ЮрФизЛицо = _Клиенты.Клиент)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыРасчета
		|		ПО (КурсВалютыРасчета.Валюта = _Клиенты.ВалютаРасчета)
		|			И (КурсВалютыРасчета.Период = НАЧАЛОПЕРИОДА(_Клиенты.КонецРасчетногоПериода, ДЕНЬ))
		|
		|УПОРЯДОЧИТЬ ПО
		|	_Клиенты.Наименование");
	
	// Фильтр по счетам д/у
	Если Отбор.Свойство("СчетДоверительногоУправления") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"&ФильтрСчетовДоверительногоУправления",
			"СчетаДоверительногоУправления.Ссылка В (&СчетаДоверительногоУправления)");
		Запрос.УстановитьПараметр("СчетаДоверительногоУправления", Отбор.СчетДоверительногоУправления);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрСчетовДоверительногоУправления", "ИСТИНА");
	КонецЕсли;
	
	// Фильтр по клиентам
	Если Отбор.Свойство("Клиент") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"&ФильтрКлиентов",
			"КлиентыДУ.Клиент В (&Клиенты)");
		Запрос.УстановитьПараметр("Клиенты", Отбор.Клиент);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрКлиентов", "ИСТИНА");
	КонецЕсли;
	
	// Фильтр по виду договора д/у
	Если Отбор.Свойство("ВидДоговораДоверительногоУправления") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"&ФильтрВидовДоговораДоверительногоУправления",
			"СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговораДоверительногоУправления)");
		Запрос.УстановитьПараметр("ВидыДоговораДоверительногоУправления", Отбор.ВидДоговораДоверительногоУправления);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрВидовДоговораДоверительногоУправления", "ИСТИНА");
	КонецЕсли;
	
	#КонецОбласти
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДатаРасчета",  			КонецДня(ЭтотОбъект.ДатаРасчета));
	Запрос.УстановитьПараметр("Организация",   			ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ПериодичностьРасчета",   ЭтотОбъект.ПериодичностьРасчета);
	Запрос.УстановитьПараметр("ВидВознаграждения",   	ЭтотОбъект.ВидВознаграждения);
	
	Вознаграждения = Запрос.Выполнить().Выгрузить();
	
	ИсходныйСписокВременныхТаблиц = СистемныеФункции.ПолучитьИменаВременныхТаблицЗапроса(Запрос);
	
	Справочники.БазыРасчета.ДобавитьИсточникДанных(Запрос, "_ВознаграждениеУплаченноеСНачалаГода");
	Справочники.БазыРасчета.ДобавитьИсточникДанных(Запрос, "_ВознаграждениеУплаченноеСНачалаДоговора");
	
	БазыРасчета								= Запрос.МенеджерВременныхТаблиц.Таблицы["_БазыРасчета"].ПолучитьДанные().Выгрузить();
	ДанныеДляРасчета						= Запрос.МенеджерВременныхТаблиц.Таблицы["_ДанныеДляРасчета"].ПолучитьДанные().Выгрузить();
	НачисленияВознаграждений				= Запрос.МенеджерВременныхТаблиц.Таблицы["_НачисленияВознаграждений"].ПолучитьДанные().Выгрузить();
	КонтрольНастроекРасчета					= Запрос.МенеджерВременныхТаблиц.Таблицы["_КонтрольНастроекРасчета"].ПолучитьДанные().Выгрузить();
	ВознагражденияУплаченные				= Запрос.МенеджерВременныхТаблиц.Таблицы["_ВознаграждениеУплаченноеСНачалаГода"].ПолучитьДанные().Выгрузить();
	ВознагражденияУплаченныеСНачалаДоговора = Запрос.МенеджерВременныхТаблиц.Таблицы["_ВознаграждениеУплаченноеСНачалаДоговора"].ПолучитьДанные().Выгрузить();
	
	СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(Запрос, ИсходныйСписокВременныхТаблиц);
	
	Вознаграждения.Индексы.Добавить("СчетДоверительногоУправления");
	ДанныеДляРасчета.Индексы.Добавить("БазаРасчета");
	НачисленияВознаграждений.Индексы.Добавить("СчетДоверительногоУправления");
	ВознагражденияУплаченные.Индексы.Добавить("СчетДоверительногоУправления");
	ВознагражденияУплаченныеСНачалаДоговора.Индексы.Добавить("СчетДоверительногоУправления");
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		Вознаграждения.Колонки.Добавить("БазыРасчета",								Новый ОписаниеТипов("Массив"));
		Вознаграждения.Колонки.Добавить("ВознаграждениеУплаченноеСНачалаГода",		Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
		Вознаграждения.Колонки.Добавить("ВознаграждениеУплаченноеСНачалаДоговора",	Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
	КонецЕсли;
	
	#Область Контроль_корректности_настроек_расчета
	
	Для Каждого СтрокаКонтроля Из КонтрольНастроекРасчета Цикл
		
		ТекстОшибки = "";
		
		Если ЗначениеЗаполнено(СтрокаКонтроля.ПоследнееСоглашениеОбИзмененииВознаграждения) Тогда
			
			Если СтрокаКонтроля.ПоследнееСоглашениеОбИзмененииВознаграждения <> СтрокаКонтроля.ОснованиеНастроекРасчета Тогда
		
				Если ЗначениеЗаполнено(СтрокаКонтроля.ОснованиеНастроекРасчета) Тогда
					ТекстОшибки = СтрШаблон("В системе зарегистрировано более позднее доп. соглашение об изменении вознаграждения (%1), чем указанное в основании настроек расчета", СтрокаКонтроля.ПоследнееСоглашениеОбИзмененииВознаграждения);
				Иначе
					ТекстОшибки = СтрШаблон("Не заполнено основание изменений настроек расчета, при этом в системе зарегистрировано доп. соглашение об изменении вознаграждения (%1)", СтрокаКонтроля.ПоследнееСоглашениеОбИзмененииВознаграждения);
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли СтрокаКонтроля.ДатаНастроекРасчета <> СтрокаКонтроля.ДатаЗаключенияДоговора Тогда
			
			ТекстОшибки = "Настройки расчета заведены не в дату заключения договора, при этом в системе отсутствуют доп. соглашения об изменении вознаграждения";
			
		КонецЕсли;
		
		// Неактуальные настройки
		
		Если Не ПустаяСтрока(ТекстОшибки) Тогда
		
			СтрокаВознаграждения = Вознаграждения.Найти(СтрокаКонтроля.СчетДоверительногоУправления, "СчетДоверительногоУправления");
			СтрокаВознаграждения.ОшибкаРасчета		= Истина;
			СтрокаВознаграждения.РасшифровкаОшибки	= ТекстОшибки;
			
		КонецЕсли;
			
	КонецЦикла;
	
	#КонецОбласти
	
	БазыРасчета.Сортировать("ЭтоВознаграждениеЗаУправление УБЫВ"); // Сначала считаем вознаграждение за управление, т.к. вознаграждение за успех иногда считается за его вычетом
	
	Для Каждого ТекущаяБазаРасчета Из БазыРасчета Цикл
		
		ДанныеДляРасчетаПоБазе = ДанныеДляРасчета.Скопировать(
			Новый Структура("БазаРасчета", ТекущаяБазаРасчета.БазаРасчета));
		
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("Организация",				ЭтотОбъект.Организация);
		ПараметрыРасчета.Вставить("ДатаРасчета",				ЭтотОбъект.ДатаРасчета);
		ПараметрыРасчета.Вставить("БазаРасчета",				ТекущаяБазаРасчета.БазаРасчета);
		ПараметрыРасчета.Вставить("ДанныеДляРасчета",			ДанныеДляРасчетаПоБазе);
		ПараметрыРасчета.Вставить("РассчитанноеВознаграждение",	Вознаграждения);
		
		ВознаграждениеПоБазеРасчета = Справочники.БазыРасчета.РассчитатьВознаграждениеПоБазеРасчета(ПараметрыРасчета, Запрос.МенеджерВременныхТаблиц, РасшифровкаРасчета);
		
		Для Каждого Расчет Из ВознаграждениеПоБазеРасчета.Результат Цикл
			
			СтрокаВознаграждения = Вознаграждения.Найти(Расчет.СчетДоверительногоУправления, "СчетДоверительногоУправления");
			СтрокаВознаграждения.Описание = СтрокаВознаграждения.Описание + ?(ПустаяСтрока(СтрокаВознаграждения.Описание), "", " + ") + Расчет.Представление;
			
			Если Расчет.СуммаВознаграждения = NULL ИЛИ Расчет.СуммаВознаграждения < 0 Тогда
				
				ОшибкиРасчета = Новый Массив;
				
				Если ВознаграждениеПоБазеРасчета.Свойство("ОшибкиРасчета") Тогда
					ОшибкиРасчета.Добавить(ВознаграждениеПоБазеРасчета.ОшибкиРасчета);
				КонецЕсли;
				
				Для Каждого КлючевоеПоле Из ВознаграждениеПоБазеРасчета.КлючевыеПоляРасчета Цикл
					Если Расчет[КлючевоеПоле.Ключ] = NULL Тогда
						ОшибкиРасчета.Добавить(КлючевоеПоле.Значение);	
					КонецЕсли;
				КонецЦикла;
				
				Если ТипЗнч(Расчет.СуммаВознаграждения) = Тип("Число") И Расчет.СуммаВознаграждения < 0 Тогда
					ОшибкиРасчета.Добавить("Сумма вознаграждения меньше нуля");
				КонецЕсли;

				СтрокаВознаграждения.ОшибкаРасчета		= Истина;
				СтрокаВознаграждения.РасшифровкаОшибки	= ?(ПустаяСтрока(СтрокаВознаграждения.РасшифровкаОшибки), "", СтрокаВознаграждения.РасшифровкаОшибки + Символы.ПС)
					+ "Ошибка расчета '" + ТекущаяБазаРасчета.БазаРасчета + "': " + СтрСоединить(ОшибкиРасчета, ", ");
			Иначе
				СтрокаВознаграждения.СуммаВознаграждения = СтрокаВознаграждения.СуммаВознаграждения + Расчет.СуммаВознаграждения;
				
				Если Расчет.НачисляетсяНарастающимИтогом Тогда
					СтрокаВознаграждения.СуммаВознагражденияНарастающимИтогом = СтрокаВознаграждения.СуммаВознагражденияНарастающимИтогом + Расчет.СуммаВознаграждения;
				КонецЕсли;
				
				Если ТекущаяБазаРасчета.ЭтоВознаграждениеЗаУправление Тогда
					СтрокаВознаграждения.СуммаВознагражденияЗаУправление = СтрокаВознаграждения.СуммаВознагражденияЗаУправление + Расчет.СуммаВознаграждения;
				КонецЕсли;
			КонецЕсли;
			
			// Раскидываем данные таблиц расшифровки по клиентам
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				
				ТаблицыРасшифровкиРасчетаПоКлиенту = Новый Структура;
				
				Для Каждого Таблица Из ВознаграждениеПоБазеРасчета.ТаблицыРасшифровкиРасчета Цикл
					ТаблицыРасшифровкиРасчетаПоКлиенту.Вставить(Таблица.Ключ, Таблица.Значение.Скопировать(Новый Структура("СчетДоверительногоУправления", СтрокаВознаграждения.СчетДоверительногоУправления)));			
				КонецЦикла;
				
				РасшифровкаРасчетаПоБазе = РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(Расчет);
				РасшифровкаРасчетаПоБазе.Вставить("БазаРасчета",					
							?(ТекущаяБазаРасчета.БазаРасчета = Справочники.БазыРасчета.МинимальноеЗначение
								Или ТекущаяБазаРасчета.БазаРасчета = Справочники.БазыРасчета.МаксимальноеЗначение,
							Расчет.БазаРасчета,
							ТекущаяБазаРасчета.БазаРасчета));
				РасшифровкаРасчетаПоБазе.Вставить("ЭтоВознаграждениеЗаУправление",	ТекущаяБазаРасчета.ЭтоВознаграждениеЗаУправление);
				РасшифровкаРасчетаПоБазе.Вставить("ТаблицыРасшифровкиРасчета",		ТаблицыРасшифровкиРасчетаПоКлиенту);
				
				СтрокаВознаграждения.БазыРасчета.Добавить(РасшифровкаРасчетаПоБазе);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Добавляем сведения об начисленных за период, уплаченных с начала года и с начала действия договора вознаграждениях
	Для Каждого СтрокаВознаграждения Из Вознаграждения Цикл
		
		// Сведения о начисленном за период вознаграждении
		
		НайденныеНачисленияВознаграждений = НачисленияВознаграждений.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", СтрокаВознаграждения.СчетДоверительногоУправления));
		
		Если НайденныеНачисленияВознаграждений.Количество() = 1 Тогда
			
			СтрокаВознаграждения.Начисление		 = НайденныеНачисленияВознаграждений[0].Начисление;
			СтрокаВознаграждения.СуммаНачисления = НайденныеНачисленияВознаграждений[0].СуммаНачисления;
			
		ИначеЕсли НайденныеНачисленияВознаграждений.Количество() > 1 Тогда
			
			СуммаНачислений  = 0;
			СписокНачислений = Новый СписокЗначений;
			
			Для Каждого СтрокаНачисления Из НайденныеНачисленияВознаграждений Цикл
				СуммаНачислений = СуммаНачислений + СтрокаНачисления.СуммаНачисления;
				СписокНачислений.Добавить(СтрокаНачисления.Начисление);
			КонецЦикла;
			
			СтрокаВознаграждения.Начисление					 = СписокНачислений;
			СтрокаВознаграждения.СуммаНачисления			 = СуммаНачислений;
			СтрокаВознаграждения.ОшибкаРасчетаНачисления	 = Истина;
			СтрокаВознаграждения.РасшифровкаОшибкиНачисления = "Найдено более одного начисления вознаграждения управляющего.";
			
		КонецЕсли;
		
		// Уплаченные с начала года вознаграждения
		
		СтрокаВознагражденияУплаченные = ВознагражденияУплаченные.Найти(СтрокаВознаграждения.СчетДоверительногоУправления, "СчетДоверительногоУправления");
		Если СтрокаВознагражденияУплаченные <> Неопределено Тогда
			СтрокаВознаграждения.ВознаграждениеУплаченноеСНачалаГода = СтрокаВознагражденияУплаченные.СуммаВВалютеУчета;	
		КонецЕсли;
		
		// Уплаченные с начала действия договора вознаграждения 
		
		СтрокаВознагражденияУплаченныеСНачалаДоговора = ВознагражденияУплаченныеСНачалаДоговора.Найти(СтрокаВознаграждения.СчетДоверительногоУправления, "СчетДоверительногоУправления");
		Если СтрокаВознагражденияУплаченныеСНачалаДоговора <> Неопределено Тогда
			СтрокаВознаграждения.ВознаграждениеУплаченноеСНачалаДоговора = СтрокаВознагражденияУплаченныеСНачалаДоговора.СуммаВВалютеУчета;	
		КонецЕсли;
	
		// Проверяем итоговую сумму вознаграждения
		
		Если ЗначениеЗаполнено(СтрокаВознаграждения.СуммаВознаграждения) Тогда
	
			// Вознаграждение, начиcляемое с начала года, не должно превышать вознаграждение, удержанное с начала года
			
			Если СтрокаВознаграждения.СуммаВознагражденияНарастающимИтогом > 0 И ЗначениеЗаполнено(СтрокаВознаграждения.ВознаграждениеУплаченноеСНачалаГода) Тогда
				
				Если СтрокаВознаграждения.СуммаВознагражденияНарастающимИтогом > СтрокаВознаграждения.ВознаграждениеУплаченноеСНачалаГода Тогда
					СтрокаВознаграждения.СуммаВознаграждения = СтрокаВознаграждения.СуммаВознаграждения - СтрокаВознаграждения.ВознаграждениеУплаченноеСНачалаГода; // Вычитаем уплаченное ранее
				Иначе
					СтрокаВознаграждения.СуммаВознаграждения = СтрокаВознаграждения.СуммаВознаграждения - СтрокаВознаграждения.СуммаВознагражденияНарастающимИтогом; // Оставляем только обязательную часть
				КонецЕсли;
				
			КонецЕсли;

			// Рассчитанное вознаграждение суммарно с уплаченным с начала действия договора
			// не должно превышать общий размер вознаграждения при наличии такого ограничения
			
			Если ЗначениеЗаполнено(СтрокаВознаграждения.ОграничениеОбщегоРазмераВознаграждения) Тогда
				
				ОбщееВознаграждениеСНачалаДоговора = СтрокаВознаграждения.СуммаВознаграждения + СтрокаВознаграждения.ВознаграждениеУплаченноеСНачалаДоговора;
				
				Если ОбщееВознаграждениеСНачалаДоговора > СтрокаВознаграждения.ОграничениеОбщегоРазмераВознаграждения Тогда
					
					СтрокаВознаграждения.СуммаВознаграждения = СтрокаВознаграждения.ОграничениеОбщегоРазмераВознаграждения
						- Мин(СтрокаВознаграждения.ОграничениеОбщегоРазмераВознаграждения, СтрокаВознаграждения.ВознаграждениеУплаченноеСНачалаДоговора);
						
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Формируем результирующий пакет данных	
	
	ПакетДанныхПоРасчетуВознаграждения = Новый Структура;	
	ПакетДанныхПоРасчетуВознаграждения.Вставить("Вознаграждения", Вознаграждения);
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		ПакетДанныхПоРасчетуВознаграждения.Вставить("ДанныеОбОрганизации",	ПолучитьРеквизитыОрганизацииАнкетные(ЭтотОбъект.Организация, ЭтотОбъект.ДатаРасчета));
		ПакетДанныхПоРасчетуВознаграждения.Вставить("ШаблонОтчета",			ПолучитьМакет("РасчетВознагражденияПоНПФ"));
	КонецЕсли;
	
	Возврат ПакетДанныхПоРасчетуВознаграждения;
КонецФункции

#КонецОбласти

#Область Вознаграждение_ИИС

Функция ВыбратьДанныеПоРасчетуВознагражденияУправляющегоПоИИС(Знач Отбор = Неопределено, ИсключатьЗакрытыеСчета = Истина, ВызватьИсключениеПриОшибке = Истина) Экспорт
	
	Если Отбор = Неопределено Тогда
		Отбор = Новый Структура;
	КонецЕсли;
	
	МассивДанныхДляРасчета = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДатаРасчета",		КонецДня(ЭтотОбъект.ДатаРасчета));
	Запрос.УстановитьПараметр("Организация",		ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("АгентскийДоговор",	ЭтотОбъект.АгентскийДоговор);
	Запрос.УстановитьПараметр("ПустаяДата",			'00010101');
	
	Если ЭтотОбъект.ВариантРасчета = 0 Тогда // вознаграждение управляющего ИИС
		#Область Вознаграждение_Управляющего_ИИС
		ТекстЗапроса =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
			|	СчетаДоверительногоУправления.Организация КАК Организация,
			|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
			|	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
			|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
			|	ЕСТЬNULL(СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия, ЗНАЧЕНИЕ(Справочник.СтратегииИндивидуальногоИнвестирования.ПустаяСсылка)) КАК Стратегия,
			|	ЕСТЬNULL(СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.Стандартная = ЛОЖЬ, ИСТИНА) КАК СтавкаИзПараметровРасчета,
			|	ВЫБОР
			|		КОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.Стандартная
			|			ТОГДА НЕОПРЕДЕЛЕНО
			|		ИНАЧЕ СоставляющиеНастройкиРасчета.ПараметрыРасчета
			|	КОНЕЦ КАК ПараметрыРасчета,
			|	ВЫБОР
			|		КОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.Стандартная
			|			ТОГДА ЕСТЬNULL(СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнаяСтавкаВознагражденияУправляющего, 0)
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК СтавкаВознагражденияЗаУправление,
			|	ВЫБОР
			|		КОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.Стандартная
			|			ТОГДА ЕСТЬNULL(СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.СтавкаВознагражденияУправляющегоПлатаЗаРазмещение, 0)
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК СтавкаВознагражденияПлатаЗаРазмещение,
			|	ВЫБОР
			|		КОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.Стандартная
			|			ТОГДА ЕСТЬNULL(СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнаяБазаДляРасчетаВознагражденияЗаУправление, ЗНАЧЕНИЕ(Справочник.БазыРасчета.ПустаяСсылка))
			|		ИНАЧЕ ЕСТЬNULL(СоставляющиеНастройкиРасчета.БазаРасчета, ЗНАЧЕНИЕ(Справочник.БазыРасчета.ПустаяСсылка))
			|	КОНЕЦ КАК БазаРасчета,
			|	ВЫБОР
			|		КОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.Стандартная
			|			ТОГДА ЕСТЬNULL(СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнаяПериодичностьРасчетаВознагражденияЗаУправление, ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.ПустаяСсылка))
			|		ИНАЧЕ ЕСТЬNULL(СоставляющиеНастройкиРасчета.Периодичность, ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.ПустаяСсылка))
			|	КОНЕЦ КАК ПериодичностьРасчетаВознаграждения,
			|	ВЫБОР
			|		КОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.Стандартная
			|			ТОГДА ВЫБОР
			|					КОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнаяПериодичностьРасчетаВознагражденияЗаУправление = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежемесячно)
			|						ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
			|					КОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнаяПериодичностьРасчетаВознагражденияЗаУправление = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально)
			|						ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, КВАРТАЛ)
			|					КОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнаяПериодичностьРасчетаВознагражденияЗаУправление = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно)
			|						ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, ГОД)
			|				КОНЕЦ
			|		ИНАЧЕ ВЫБОР
			|				КОГДА СоставляющиеНастройкиРасчета.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежемесячно)
			|					ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
			|				КОГДА СоставляющиеНастройкиРасчета.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально)
			|					ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, КВАРТАЛ)
			|				КОГДА СоставляющиеНастройкиРасчета.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно)
			|					ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, ГОД)
			|			КОНЕЦ
			|	КОНЕЦ КАК НачалоБазовогоПериода,
			|	ВЫБОР
			|		КОГДА СчетаДоверительногоУправления.ДатаЗаключения <> ДАТАВРЕМЯ(1, 1, 1)
			|				И СчетаДоверительногоУправления.ДатаЗаключения > ВЫБОР
			|					КОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.Стандартная
			|						ТОГДА ВЫБОР
			|								КОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнаяПериодичностьРасчетаВознагражденияЗаУправление = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежемесячно)
			|									ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
			|								КОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнаяПериодичностьРасчетаВознагражденияЗаУправление = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально)
			|									ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, КВАРТАЛ)
			|								КОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнаяПериодичностьРасчетаВознагражденияЗаУправление = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно)
			|									ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, ГОД)
			|							КОНЕЦ
			|					ИНАЧЕ ВЫБОР
			|							КОГДА СоставляющиеНастройкиРасчета.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежемесячно)
			|								ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
			|							КОГДА СоставляющиеНастройкиРасчета.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально)
			|								ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, КВАРТАЛ)
			|							КОГДА СоставляющиеНастройкиРасчета.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно)
			|								ТОГДА НАЧАЛОПЕРИОДА(&ДатаРасчета, ГОД)
			|						КОНЕЦ
			|				КОНЕЦ
