	    |							_ДанныеДляРасчета.СчетДоверительногоУправления
	    |						ИЗ
	    |							_ДанныеДляРасчета КАК _ДанныеДляРасчета
	    |						ГДЕ
	    |							_ДанныеДляРасчета.ТипПИФ = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Открытый))) КАК РезервыПИФОстатки
	    |		ПО (РезервыПИФОстатки.СчетДоверительногоУправления = _ДанныеДляРасчета.СчетДоверительногоУправления),
	    |	_ДнейВГоду КАК _ДнейВГоду
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_РасчетВознаграждения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	    |	_РасчетВознаграждения.СуммаВознаграждения КАК СуммаВознаграждения,
	    |	_РасчетВознаграждения.Задолженность КАК Задолженность,
	    |	_РасчетВознаграждения.СреднегодоваяСЧА КАК СреднегодоваяСЧА,
	    |	ЕСТЬNULL(_РасчетВознаграждения.СуммаВознаграждения > 0
	    |			И _РасчетВознаграждения.СреднегодоваяСЧА > 0, ЛОЖЬ) КАК ПроверкиПройдены
	    |ИЗ
	    |	_РасчетВознаграждения КАК _РасчетВознаграждения
	    |ИТОГИ ПО
	    |	ПроверкиПройдены";     
		
	#КонецОбласти
				
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данные для расчета вознаграждения не найдены");	
		Возврат Неопределено;
	КонецЕсли;
	
	// Получаем результаты расчета	
	ДанныеДляРасчетаВознаграждения = Новый Структура;
	ДанныеДляРасчетаВознаграждения.Вставить("Вознаграждения",							 ПолучитьДанныеДляРасчетаВознаграждения(Запрос, "Вознаграждения_ПИФ"));	
	ДанныеДляРасчетаВознаграждения.Вставить("НачисленияВознагражденийЗаРасчетныйПериод", ПолучитьДанныеДляРасчетаВознаграждения(Запрос, "НачисленияВознагражденийЗаРасчетныйПериод_ПИФ"));
  
	// Выводим ошибки 
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если Выборка.НайтиСледующий(Новый Структура("ПроверкиПройдены", Ложь)) Тогда
		
		ВыборкаПоСчетамДУ = Выборка.Выбрать();
		
		Пока ВыборкаПоСчетамДУ.Следующий() Цикл	
			
			Ошибки = Новый Массив;			
			Если Не ЗначениеЗаполнено(ВыборкаПоСчетамДУ.СреднегодоваяСЧА) Тогда
				Ошибки.Добавить("среднегодовую СЧА");		
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ВыборкаПоСчетамДУ.СуммаВознаграждения) Или ВыборкаПоСчетамДУ.СуммаВознаграждения < 0 Тогда
				Ошибки.Добавить("сумму вознаграждения");		
			КонецЕсли;

			ТекстОшибки = СтрШаблон("Для счета доверительного управления '%1' не удалось определить %2",
				ВыборкаПоСчетамДУ.СчетДоверительногоУправления,
				СтрСоединить(Ошибки, " и "));
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ВыборкаПоСчетамДУ.СчетДоверительногоУправления);				
			
		КонецЦикла;
		
	КонецЕсли;
		
	Возврат ДанныеДляРасчетаВознаграждения;
	
КонецФункции

Функция СформироватьФормуРасчетаВознагражденияПоПИФ(СчетаДоверительногоУправления, ХранилищеДанныхПоРасчетуВознагражденияУправляющего, Подписант = "", ПодписантДолжность = "") Экспорт

	Если ТипЗнч(ХранилищеДанныхПоРасчетуВознагражденияУправляющего) <> Тип("ХранилищеЗначения") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сначала необходимо выполнить расчет вознаграждения");
		Возврат Неопределено;
	КонецЕсли;
	
	ФормаРасчета = Новый ТабличныйДокумент;
	
	МакетОтчета = ЭтотОбъект.ПолучитьМакет("РасчетВознагражденияПоПИФ");
	
	ОбластьШапка		= МакетОтчета.ПолучитьОбласть("Шапка");	
	ОбластьНачало		= МакетОтчета.ПолучитьОбласть("РасчетНачало");
	ОбластьРезерв		= МакетОтчета.ПолучитьОбласть("РасчетРезерва");
	ОбластьОкончание	= МакетОтчета.ПолучитьОбласть("РасчетОкончание");
	ОбластьПодвал		= МакетОтчета.ПолучитьОбласть("Подвал");   
	
	// У ПИФ "Современный взгляд" своя область
	ОбластьСовременныйВзгляд = МакетОтчета.ПолучитьОбласть("РасчетСовременныйВзгляд");
	
	ОбластьШапка.Параметры.РасчетныйПериод	= Формат(ЭтотОбъект.ДатаРасчета, "ДФ='ММММ гггг'");
	ОбластьШапка.Параметры.ДатаРасчета		= Формат(ЭтотОбъект.ДатаРасчета, "ДФ=dd.MM.yyyy");
	
	ОбластьОкончание.Параметры.РасчетныйПериод		= Формат(ЭтотОбъект.ДатаРасчета, "ДФ='ММММ гггг'");
	
	ОбластьПодвал.Параметры.Подписант			= СокрЛП(Подписант);
	ОбластьПодвал.Параметры.ПодписантДолжность	= СокрЛП(ПодписантДолжность);
	        
	// Получим данные	
	
	ДанныеПоРасчетуВознагражденияУправляющего = ХранилищеДанныхПоРасчетуВознагражденияУправляющего.Получить();
	
	РеквизитыОрганизации = ПолучитьРеквизитыОрганизацииАнкетные(ЭтотОбъект.Организация, ЭтотОбъект.ДатаРасчета);
		
	Выборка = ВыбратьРеквизитыПИФДляПечати(СчетаДоверительногоУправления);
		
	// Отобразим данные
		
	Количество = 0;
	
	Пока Выборка.Следующий() Цикл
			
		ВознаграждениеПоСчету = ДанныеПоРасчетуВознагражденияУправляющего.Вознаграждения.Скопировать(Новый Структура("СчетДоверительногоУправления", Выборка.СчетДоверительногоУправления));
		Если ВознаграждениеПоСчету.Количество() = 0 Тогда
			ВызватьИсключение "Ошибка печати расчета вознаграждения: вознаграждение отсутствует";
		ИначеЕсли ВознаграждениеПоСчету.Количество() > 1 Тогда
			ВызватьИсключение "Ошибка печати расчета вознаграждения: неоднозначное вознаграждение";
		КонецЕсли;
					
		Если Количество > 0 Тогда
			ФормаРасчета.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;		
		
		ЭтоСовременныйВзгляд = Выборка.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_СовременныйВзгляд");
				
		ОбластьШапка.Параметры.Заполнить(РеквизитыОрганизации);  
		ОбластьШапка.Параметры.Заполнить(Выборка);
		
		ФормаРасчета.Вывести(ОбластьШапка);
		
		Составляющие = ВознаграждениеПоСчету[0].НастройкаРасчета.Составляющие;
		
		Если ЭтоСовременныйВзгляд Тогда
			
			ОбластьСовременныйВзгляд.Параметры.Заполнить(ВознаграждениеПоСчету[0]);
			
			ФиксированнаяСумма					= 0;
			СуммаВознагражденияОтСреднегодовой	= 0;
			Ставка								= 0;    
			
			Если Составляющие.Количество() = 1 И Составляющие[0].БазаРасчета = Справочники.БазыРасчета.МинимальноеЗначение Тогда
				
				СоставляющиеМинимума = Составляющие[0].ПараметрыРасчета.Получить(); 
				Для Каждого СоставляющаяМинимума Из СоставляющиеМинимума Цикл
					
					Составляющая = СоставляющаяМинимума.Значение.Составляющие[0];
					Если Составляющая.БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтФиксированнойСуммыВГод Тогда
						ФиксированнаяСумма = Составляющая.ПараметрыРасчета.Получить().ПараметрРасчетаСумма;					
					КонецЕсли;
					
					Если Составляющая.БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтСреднегодовойСЧА Тогда
						Ставка = Составляющая.ПараметрыРасчета.Получить().ПараметрРасчетаСтавка;	
					КонецЕсли; 	
				
				КонецЦикла;
				
				ОбластьСовременныйВзгляд.Параметры.СуммаВознагражденияВсего				= ВознаграждениеПоСчету[0].СуммаВознагражденияВсего - ВознаграждениеПоСчету[0].СуммаВознаграждения;			
				ОбластьСовременныйВзгляд.Параметры.Ставка								= Ставка;
				ОбластьСовременныйВзгляд.Параметры.СуммаВознагражденияОтСреднегодовой	= Окр(ВознаграждениеПоСчету[0].СреднегодоваяСЧА * Ставка / 100, 2, 1);
				ОбластьСовременныйВзгляд.Параметры.Лимит								= ФиксированнаяСумма;
				ОбластьСовременныйВзгляд.Параметры.ОстатокЛимита						= ФиксированнаяСумма - ВознаграждениеПоСчету[0].СуммаВознагражденияВсего;
				
			КонецЕсли;
			
			ФормаРасчета.Вывести(ОбластьСовременныйВзгляд);
			
		Иначе
			
			ОбластьНачало.Параметры.Заполнить(Выборка);
			ОбластьНачало.Параметры.Заполнить(ВознаграждениеПоСчету[0]);
			
			ОбластьНачало.Параметры.ДатаРасчета	= Формат(ЭтотОбъект.ДатаРасчета, "ДФ=dd.MM.yyyy");
			
			// Для стандартных формул от среднегодовой СЧА выводим процент			
			Если Составляющие.Количество() = 1 И Составляющие[0].БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтСреднегодовойСЧА Тогда
				ОбластьНачало.Параметры.Ставка = Составляющие[0].ПараметрыРасчета.Получить().ПараметрРасчетаСтавка;	
			КонецЕсли; 	
		
			ФормаРасчета.Вывести(ОбластьНачало);  
					
			Если ВознаграждениеПоСчету[0].РезервНаВознаграждение <> 0 Тогда
				ОбластьРезерв.Параметры.Заполнить(ВознаграждениеПоСчету[0]);			
				ФормаРасчета.Вывести(ОбластьРезерв);
			КонецЕсли;	
			
			ОбластьОкончание.Параметры.Заполнить(ВознаграждениеПоСчету[0]);
			ФормаРасчета.Вывести(ОбластьОкончание);
			
		КонецЕсли;
		
		ОбластьПодвал.Параметры.Заполнить(ВознаграждениеПоСчету[0]);
		ФормаРасчета.Вывести(ОбластьПодвал);
						
		Количество = Количество + 1;
						
	КонецЦикла;
	
	ФормаРасчета.ОтображатьЗаголовки = Ложь;
	ФормаРасчета.ОтображатьСетку = Ложь;
	ФормаРасчета.Защита = Ложь;
	ФормаРасчета.ТолькоПросмотр = Истина;

	Возврат ФормаРасчета;
	
КонецФункции

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////

#Область Интерфейс_работы_с_отложенными_заданиями

Процедура ВыполнитьМетод(Метод, Экземпляры) Экспорт
	
	Механизм = Метаданные.Обработки.РасчетВознагражденияУправляющего.ПолноеИмя() + ".ВыполнитьМетод()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект);
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	Если Метод = "ВыполнитьКонтрольСоответствияСоглашенияИНастроекРасчетаВУК" Тогда
		ВыполнитьКонтрольСоответствияСоглашенияИНастроекРасчетаВУК(Экземпляры);
	Иначе
		ВызватьИсключение СтрШаблон("Неизвестный метод '%1'", Метод);
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

Процедура ВыполнитьКонтрольСоответствияСоглашенияИНастроекРасчетаВУК(Экземпляры)
	
	КлючиЗапуска = Новый ТаблицаЗначений;
	КлючиЗапуска.Колонки.Добавить("Соглашение",		Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	КлючиЗапуска.Колонки.Добавить("Идентификатор",	Новый ОписаниеТипов("УникальныйИдентификатор"));
	
	Для Каждого ТекЭкземпляр Из Экземпляры Цикл
		НовыйКлюч = КлючиЗапуска.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйКлюч, ТекЭкземпляр.Параметры);
		НовыйКлюч.Идентификатор = ТекЭкземпляр.Идентификатор;
	КонецЦикла;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлючиЗапуска.Соглашение КАК Соглашение,
		|	КлючиЗапуска.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ _Экземпляры
		|ИЗ
		|	&КлючиЗапуска КАК КлючиЗапуска
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Экземпляры.Соглашение КАК Соглашение,
		|	_Экземпляры.Идентификатор КАК Идентификатор,
		|	ЕСТЬNULL(Договоры.Организация, НастройкиРасчета.Организация) КАК Организация,
		|	Договоры.Организация КАК ДоговорОрганизация,
		|	Договоры.Основание КАК ДоговорОснование,
		|	Договоры.ПометкаУдаления КАК ДоговорПометкаУдаления,
		|	Договоры.ДатаИзмененияВознаграждения КАК ДоговорДатаИзмененияВознаграждения,
		|	Договоры.ВидДоговора КАК ДоговорВидДоговора,
		|	НастройкиРасчета.Основание КАК НастройкиРасчетаОснование,
		|	НастройкиРасчета.Период КАК НастройкаРасчетаПериод,
		|	НастройкиРасчета.Организация КАК НастройкаРасчетаОрганизация,
		|	НастройкиРасчета.СчетДоверительногоУправления КАК НастройкаРасчетаСчетДоверительногоУправления
		|ИЗ
		|	_Экземпляры КАК _Экземпляры
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
		|		ПО (Договоры.Ссылка = _Экземпляры.Соглашение)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиРасчетаВознагражденияУправляющего КАК НастройкиРасчета
		|		ПО (НастройкиРасчета.Основание = _Экземпляры.Соглашение)
		|			И (НастройкиРасчета.ВидВознаграждения = ЗНАЧЕНИЕ(Перечисление.ВидыВознагражденийУправляющего.ВознаграждениеУправляющего))
		|ИТОГИ
		|	МИНИМУМ(ДоговорОрганизация) КАК ДоговорОрганизация,
		|	МИНИМУМ(ДоговорОснование) КАК ДоговорОснование,
		|	МИНИМУМ(ДоговорПометкаУдаления) КАК ДоговорПометкаУдаления,
		|	МИНИМУМ(ДоговорДатаИзмененияВознаграждения) КАК ДоговорДатаИзмененияВознаграждения,
		|	МИНИМУМ(ДоговорВидДоговора) КАК ДоговорВидДоговора,
		|	МИНИМУМ(НастройкиРасчетаОснование) КАК НастройкиРасчетаОснование,
		|	МИНИМУМ(НастройкаРасчетаПериод) КАК НастройкаРасчетаПериод,
		|	МИНИМУМ(НастройкаРасчетаОрганизация) КАК НастройкаРасчетаОрганизация,
		|	МИНИМУМ(НастройкаРасчетаСчетДоверительногоУправления) КАК НастройкаРасчетаСчетДоверительногоУправления
		|ПО
		|	Организация,
		|	Соглашение");
	
	Запрос.УстановитьПараметр("КлючиЗапуска", КлючиЗапуска);
	
	ВыборкаОрганизации = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОрганизации.Следующий() Цикл
		
		Идентификаторы	= Новый Массив;
		Расхождения		= Новый Массив;
	
		ВыборкаСоглашения = ВыборкаОрганизации.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСоглашения.Следующий() Цикл
			
			// Если договор удален, а настройки почищены, то проверять нечего
			
			Если ЗначениеЗаполнено(ВыборкаОрганизации.Организация) Тогда
				
				#Область Поиск_расхождений
				
				РасхожденияПоСоглашению = Новый Массив;
				
				Если ВыборкаСоглашения.ДоговорПометкаУдаления = Ложь И ВыборкаСоглашения.НастройкиРасчетаОснование <> NULL Тогда
					
					// Есть договор и настройки
					
					Если Не ЗначениеЗаполнено(ВыборкаСоглашения.ДоговорДатаИзмененияВознаграждения)
						ИЛИ ВыборкаСоглашения.ДоговорВидДоговора <> Перечисления.ВидыДоговоров.ДополнительноеСоглашение
						ИЛИ ТипЗнч(ВыборкаСоглашения.ДоговорОснование) <> Тип("СправочникСсылка.СчетаДоверительногоУправления")
					Тогда
						
						РасхожденияПоСоглашению.Добавить(СтрШаблон("не содержит сведений об изменении вознаграждения, но указано как основание в настройках расчета вознаграждения '%1' за %2",
							ВыборкаСоглашения.НастройкаРасчетаСчетДоверительногоУправления, Формат(ВыборкаСоглашения.НастройкаРасчетаПериод, "ДФ=dd.MM.yyyy")));	
							
					Иначе
							
						Если ВыборкаСоглашения.ДоговорДатаИзмененияВознаграждения <> ВыборкаСоглашения.НастройкаРасчетаПериод Тогда
							
							РасхожденияПоСоглашению.Добавить(СтрШаблон("дата изменения вознаграждения '%1' отличается от даты '%2' настроек расчета вознаграждения, в которых данное соглашение указано как основание",
								Формат(ВыборкаСоглашения.ДоговорДатаИзмененияВознаграждения, "ДФ=dd.MM.yyyy"), Формат(ВыборкаСоглашения.НастройкаРасчетаПериод, "ДФ=dd.MM.yyyy")));	
								
						КонецЕсли;
						
						Если ВыборкаСоглашения.ДоговорОрганизация <> ВыборкаСоглашения.НастройкаРасчетаОрганизация Тогда
							
							РасхожденияПоСоглашению.Добавить(СтрШаблон("организация '%1' отличается от организации '%2' в настройках расчета вознаграждения",
								ВыборкаСоглашения.ДоговорОрганизация, ВыборкаСоглашения.НастройкаРасчетаОрганизация));	
								
						КонецЕсли;
							
						Если ВыборкаСоглашения.ДоговорОснование <> ВыборкаСоглашения.НастройкаРасчетаСчетДоверительногоУправления Тогда
							
							РасхожденияПоСоглашению.Добавить(СтрШаблон("счет д/у '%1' не соответствует счету д/у '%2' в настройках расчета вознаграждения, в которых данное соглашение указано как основание",
								ВыборкаСоглашения.ДоговорОснование, ВыборкаСоглашения.НастройкаРасчетаСчетДоверительногоУправления));	
								
						КонецЕсли;
						
					КонецЕсли;
					
				ИначеЕсли ВыборкаСоглашения.ДоговорПометкаУдаления = Ложь Тогда
					
					// Есть договор, но настроек нет
					
					Если ЗначениеЗаполнено(ВыборкаСоглашения.ДоговорДатаИзмененияВознаграждения) Тогда
						
						РасхожденияПоСоглашению.Добавить(СтрШаблон("не найдены настройки расчета вознаграждения '%1', заведенные на основании данного соглашения",
							ВыборкаСоглашения.ДоговорОснование));
							
					КонецЕсли;					
					
				ИначеЕсли ВыборкаСоглашения.НастройкиРасчетаОснование <> NULL Тогда
					
					// Нет договора, но есть настройки
					
					РасхожденияПоСоглашению.Добавить(СтрШаблон("помечено на удаление / удалено, но указано как основание в настройках расчета вознаграждения '%1' за %2",
						ВыборкаСоглашения.НастройкаРасчетаСчетДоверительногоУправления, Формат(ВыборкаСоглашения.НастройкаРасчетаПериод, "ДФ=dd.MM.yyyy")));	
					
				КонецЕсли;
				
				Если РасхожденияПоСоглашению.Количество() > 0 Тогда
					
					ТекстРасхождений = СтрШаблон("Соглашение '%1':" + Символы.ПС + "    - ", ВыборкаСоглашения.Соглашение);
					
					Расхождения.Добавить(ТекстРасхождений + СтрСоединить(РасхожденияПоСоглашению, Символы.ПС + "    - "));
					
				КонецЕсли;
					
				#КонецОбласти
				
			КонецЕсли;
			
			// Запоминаем идентификаторы обработанных заданий
			
			ВыборкаИдентификаторы = ВыборкаСоглашения.Выбрать(ОбходРезультатаЗапроса.Прямой);
			
			Пока ВыборкаИдентификаторы.Следующий() Цикл
				Идентификаторы.Добавить(ВыборкаИдентификаторы.Идентификатор);
			КонецЦикла;			
			
		КонецЦикла;
		
		// Выполняем оповещения в рамках организации
		
		Если Расхождения.Количество() > 0 И ЗначениеЗаполнено(ВыборкаОрганизации.Организация) Тогда
			
			РеквизитыОповещения = Новый Структура;
			РеквизитыОповещения.Вставить("Организация", ВыборкаОрганизации.Организация);
			РеквизитыОповещения.Вставить("Текст",		СтрСоединить(Расхождения, Символы.ПС + Символы.ПС));
			
			Справочники.Оповещения.СформироватьОповещения(
				"Обработка.РасчетВознагражденияУправляющего.ВыполнитьКонтрольСоответствияСоглашенияИНастроекРасчетаВУК",
				Перечисления.ТипыСобытий.ВнешнийВызов,
				РеквизитыОповещения);					
			
		КонецЕсли;
		
		// Фиксируем успешное выполнение задания
		
		Для Каждого Идентификатор Из Идентификаторы Цикл
			РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(Идентификатор);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////

#Область Служебные_и_вспомогательные_функции

Функция ПолучитьДанныеДляРасчетаВознаграждения(Запрос, ИмяВыборки)

	Если ИмяВыборки = "Вознаграждения" Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_БазыРасчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_НастройкиРасчетаВознаграждения.Стратегия КАК Стратегия,
			|	_НастройкиРасчетаВознаграждения.СтавкаВознагражденияЗаУправление КАК Ставка,
			|	ВЫРАЗИТЬ(_БазыРасчета.БалансоваяСтоимость КАК ЧИСЛО(25, 2)) КАК БалансоваяСтоимость,
			|	ВЫБОР
			|		КОГДА _НастройкиРасчетаВознаграждения.ДоговорЗакрыт
			|			ТОГДА 0
			|		ИНАЧЕ ВЫРАЗИТЬ(_БазыРасчета.СредняяОценочнаяСтоимость * _НастройкиРасчетаВознаграждения.СтавкаВознагражденияЗаУправление / 100 КАК ЧИСЛО(15, 2))
			|	КОНЕЦ КАК СуммаВознаграждения,
			|	_НастройкиРасчетаВознаграждения.ДатаЗаключения КАК ДатаЗаключения,
			|	_НастройкиРасчетаВознаграждения.НомерДоговора КАК НомерДоговора,
			|	ВЫБОР
			|		КОГДА _НастройкиРасчетаВознаграждения.ДоговорЗакрыт
			|			ТОГДА 0
			|		ИНАЧЕ ВЫРАЗИТЬ(_БазыРасчета.СредняяОценочнаяСтоимость КАК ЧИСЛО(25, 2))
			|	КОНЕЦ КАК СредняяОценочнаяСтоимость,
			|	_НастройкиРасчетаВознаграждения.ДоговорЗакрыт КАК ДоговорЗакрыт,
			|	ВЫБОР
			|		КОГДА ПервыеВводыАктивов.ДатаПервогоВвода >= _НастройкиРасчетаВознаграждения.НачалоБазовогоПериода
			|			ТОГДА ПервыеВводыАктивов.ДатаПервогоВвода
			|		КОГДА _НастройкиРасчетаВознаграждения.НачалоБазовогоПериода >= _НастройкиРасчетаВознаграждения.ДатаЗаключения
			|			ТОГДА _НастройкиРасчетаВознаграждения.НачалоБазовогоПериода
			|		ИНАЧЕ _НастройкиРасчетаВознаграждения.ДатаЗаключения
			|	КОНЕЦ КАК НачалоПериодаНачисления,
			|	ВЫБОР
			|		КОГДА _НастройкиРасчетаВознаграждения.КонецБазовогоПериода < _НастройкиРасчетаВознаграждения.ДатаРасторжения
			|				ИЛИ _НастройкиРасчетаВознаграждения.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			|			ТОГДА ВЫБОР
			|					КОГДА &ДатаРасчета < _НастройкиРасчетаВознаграждения.КонецБазовогоПериода
			|						ТОГДА &ДатаРасчета
			|					ИНАЧЕ _НастройкиРасчетаВознаграждения.КонецБазовогоПериода
			|				КОНЕЦ
			|		ИНАЧЕ ВЫБОР
			|				КОГДА &ДатаРасчета < КОНЕЦПЕРИОДА(_НастройкиРасчетаВознаграждения.ДатаРасторжения, ДЕНЬ)
			|					ТОГДА &ДатаРасчета
			|				ИНАЧЕ КОНЕЦПЕРИОДА(_НастройкиРасчетаВознаграждения.ДатаРасторжения, ДЕНЬ)
			|			КОНЕЦ
			|	КОНЕЦ КАК КонецПериодаНачисления
			|ИЗ
			|	_БазыРасчета КАК _БазыРасчета
			|		ЛЕВОЕ СОЕДИНЕНИЕ _НастройкиРасчетаВознаграждения КАК _НастройкиРасчетаВознаграждения
			|		ПО _БазыРасчета.СчетДоверительногоУправления = _НастройкиРасчетаВознаграждения.СчетДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			_НастройкиРасчетаВознаграждения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|			НАЧАЛОПЕРИОДА(МИНИМУМ(ВводыАктивов.Период), ДЕНЬ) КАК ДатаПервогоВвода
			|		ИЗ
			|			_НастройкиРасчетаВознаграждения КАК _НастройкиРасчетаВознаграждения
			|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыАктивов
			|				ПО (ВводыАктивов.Организация = _НастройкиРасчетаВознаграждения.Организация)
			|					И (ВводыАктивов.СчетДоверительногоУправления = _НастройкиРасчетаВознаграждения.СчетДоверительногоУправления)
			|					И (ВводыАктивов.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход))
			|					И (ВводыАктивов.Период <= _НастройкиРасчетаВознаграждения.КонецБазовогоПериода)
			|		
			|		СГРУППИРОВАТЬ ПО
			|			_НастройкиРасчетаВознаграждения.СчетДоверительногоУправления) КАК ПервыеВводыАктивов
			|		ПО (ПервыеВводыАктивов.СчетДоверительногоУправления = _БазыРасчета.СчетДоверительногоУправления)
			|
			|УПОРЯДОЧИТЬ ПО
			|	_БазыРасчета.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления,
			|	_БазыРасчета.СчетДоверительногоУправления.Наименование";
		
	ИначеЕсли ИмяВыборки = "Вознаграждения_ПИФ" Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_РасчетВознаграждения.СуммаВознаграждения КАК СуммаВознаграждения,
			|	_РасчетВознаграждения.СуммаВознаграждения + _РасчетВознаграждения.Задолженность КАК СуммаВознагражденияВсего,
			|	_РасчетВознаграждения.Задолженность КАК Задолженность,
			|	_РасчетВознаграждения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_РасчетВознаграждения.СреднегодоваяСЧА КАК СреднегодоваяСЧА,
			|	_РасчетВознаграждения.РезервНаВознаграждение КАК РезервНаВознаграждение,
			|	_РасчетВознаграждения.Описание КАК Описание,
			|	_РасчетВознаграждения.НастройкаРасчета КАК НастройкаРасчета,
			|	ВЫБОР
			|		КОГДА _СчетаДоверительногоУправления.ДатаОкончанияФормированияПИФ > НАЧАЛОПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
			|			ТОГДА _СчетаДоверительногоУправления.ДатаОкончанияФормированияПИФ
			|		ИНАЧЕ НАЧАЛОПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
			|	КОНЕЦ КАК НачалоПериодаНачисления,
			|	ВЫБОР
			|		КОГДА _СчетаДоверительногоУправления.ДатаОснованияДляПрекращенияПИФ < КОНЕЦПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
			|			ТОГДА _СчетаДоверительногоУправления.ДатаОснованияДляПрекращенияПИФ
			|		ИНАЧЕ КОНЕЦПЕРИОДА(&ДатаРасчета, МЕСЯЦ)
			|	КОНЕЦ КАК КонецПериодаНачисления
			|ИЗ
			|	_РасчетВознаграждения КАК _РасчетВознаграждения
			|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
			|		ПО (_СчетаДоверительногоУправления.СчетДоверительногоУправления = _РасчетВознаграждения.СчетДоверительногоУправления)
			|ГДЕ
			|	_РасчетВознаграждения.СуммаВознаграждения > 0
			|
			|УПОРЯДОЧИТЬ ПО
			|	_РасчетВознаграждения.СчетДоверительногоУправления.Наименование";  	
		
	ИначеЕсли ИмяВыборки = "ВознагражденияПлатаЗаРазмещениеАгенту" Тогда
		Запрос.Текст = 		
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_БазыРасчетаВводыЗаПериод.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_НастройкиРасчетаВознаграждения.Стратегия КАК Стратегия,
			|	_НастройкиРасчетаВознаграждения.СтавкаВознагражденияЗаПривлечение КАК Ставка,
			|	ВЫРАЗИТЬ(_БазыРасчетаВводыЗаПериод.СуммаВводов КАК ЧИСЛО(25, 2)) КАК БалансоваяСтоимость,
			|	ВЫРАЗИТЬ(_БазыРасчетаВводыЗаПериод.СуммаВводов * ВЫБОР
			|			КОГДА ТИПЗНАЧЕНИЯ(_НастройкиРасчетаВознаграждения.СтавкаВознагражденияЗаПривлечение) <> ТИП(Справочник.ШкалыПроцентныхСтавок)
			|				ТОГДА ВЫРАЗИТЬ(_НастройкиРасчетаВознаграждения.СтавкаВознагражденияЗаПривлечение КАК ЧИСЛО(10, 3))
			|			ИНАЧЕ 0
			|		КОНЕЦ / 100 КАК ЧИСЛО(15, 2)) КАК СуммаВознаграждения,
			|	_НастройкиРасчетаВознаграждения.ДатаЗаключения КАК ДатаЗаключения,
			|	_НастройкиРасчетаВознаграждения.НомерДоговора КАК НомерДоговора
			|ИЗ
			|	_БазыРасчетаВводыЗаПериод КАК _БазыРасчетаВводыЗаПериод
			|		ЛЕВОЕ СОЕДИНЕНИЕ _НастройкиРасчетаВознаграждения КАК _НастройкиРасчетаВознаграждения
			|		ПО _БазыРасчетаВводыЗаПериод.СчетДоверительногоУправления = _НастройкиРасчетаВознаграждения.СчетДоверительногоУправления
			|ГДЕ
			|	_НастройкиРасчетаВознаграждения.БазаРасчетаВознагражденияЗаПривлечение = ЗНАЧЕНИЕ(Справочник.БазыРасчета.СтоимостьПереданныхВДоверительноеУправлениеДенежныхСредств)
			|	И ТИПЗНАЧЕНИЯ(_НастройкиРасчетаВознаграждения.СтавкаВознагражденияЗаПривлечение) <> ТИП(Справочник.ШкалыПроцентныхСтавок)
			|	И _НастройкиРасчетаВознаграждения.СтавкаВознагражденияЗаПривлечение <> 0
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_БазыРасчетаВводыЗаПериод.СчетДоверительногоУправления,
			|	_НастройкиРасчетаВознаграждения.Стратегия,
			|	ШкалыПроцентныхСтавокШкала.ПроцентнаяСтавка,
			|	ВЫРАЗИТЬ(_БазыРасчетаВводыЗаПериод.СуммаВводов КАК ЧИСЛО(25, 2)),
			|	ВЫРАЗИТЬ(_БазыРасчетаВводыЗаПериод.СуммаВводов * ВЫБОР
			|			КОГДА ТИПЗНАЧЕНИЯ(_НастройкиРасчетаВознаграждения.СтавкаВознагражденияЗаПривлечение) <> ТИП(Справочник.ШкалыПроцентныхСтавок)
			|				ТОГДА 0
			|			ИНАЧЕ ШкалыПроцентныхСтавокШкала.ПроцентнаяСтавка
			|		КОНЕЦ / 100 КАК ЧИСЛО(15, 2)),
			|	_НастройкиРасчетаВознаграждения.ДатаЗаключения,
			|	_НастройкиРасчетаВознаграждения.НомерДоговора
			|ИЗ
