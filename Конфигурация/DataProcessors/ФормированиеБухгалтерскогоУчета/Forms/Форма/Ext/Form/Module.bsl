&НаКлиенте
Процедура ИсключатьЗакрытыеДоговорыПриИзменении(Элемент)
	Элементы.ТолькоЗакрытыеДоговоры.Видимость = НЕ ЭтаФорма.ИсключатьЗакрытыеДоговоры;
	Если ЭтаФорма.ИсключатьЗакрытыеДоговоры Тогда
		ЭтаФорма.ТолькоЗакрытыеДоговоры = Ложь;
		Элементы.СчетаДоверительногоУправленияДатаРасторжения.Видимость = ЭтаФорма.ТолькоЗакрытыеДоговоры;
	КонецЕсли;
	УточнитьУПользователяИЗаполнитьСчетаДоверительногоУправления();
КонецПроцедуры

&НаКлиенте
Процедура СчетаДоверительногоУправленияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ЭтаФорма.СчетаДоверительногоУправления.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "СчетаДоверительногоУправленияСчетДоверительногоУправления" Тогда
		ТекущиеДанные = ЭтаФорма.Элементы.СчетаДоверительногоУправления.ТекущиеДанные;
		ОткрытьЗначение(ТекущиеДанные.СчетДоверительногоУправления);
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция КтоФормируетНаСервере()
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОтложенныеЗадания.Организация КАК Организация,
		|	ОтложенныеЗадания.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОтложенныеЗадания.ВидУчета КАК ВидУчета,
		|	ОтложенныеЗадания.Состояние КАК Состояние,
		|	ОтложенныеЗадания.ДатаДобавления КАК ДатаДобавления,
		|	ОтложенныеЗадания.ДатаЗапуска КАК ДатаЗапуска,
		|	ОтложенныеЗадания.Пользователь КАК Пользователь,
		|	ОтложенныеЗадания.ИдентификаторФоновогоЗадания КАК ИдентификаторФоновогоЗадания
		|ИЗ
		|	РегистрСведений.ОтложенныеЗадания КАК ОтложенныеЗадания
		|ГДЕ
		|	ОтложенныеЗадания.Состояние В (ЗНАЧЕНИЕ(Перечисление.СостоянияОтложенныхЗаданий.Выполняется), ЗНАЧЕНИЕ(Перечисление.СостоянияОтложенныхЗаданий.Ожидание))
		|	И ОтложенныеЗадания.Организация = &Организация
		|	И ОтложенныеЗадания.Объект = &ОбъектФормированияБухгалтерскогоУчета
		|	И ОтложенныеЗадания.Команда = &КомандаФормированияБухгалтерскогоУчета
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаДобавления";
	
	ПараметрыФормированияБухгалтерскогоУчета = Обработки.МенеджерОтложенныхЗаданий.ПолучитьПараметрыФормированияБухгалтерскогоУчета();	
	
	Запрос.УстановитьПараметр("ОбъектФормированияБухгалтерскогоУчета",			ПараметрыФормированияБухгалтерскогоУчета.ОбъектФормированияБухгалтерскогоУчета);
	Запрос.УстановитьПараметр("КомандаФормированияБухгалтерскогоУчета",			ПараметрыФормированияБухгалтерскогоУчета.КомандаФормированияБухгалтерскогоУчета);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	ТаблицаЗаданий = Запрос.Выполнить().Выгрузить();
	
	ТаблицаЗаданий.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50)));
	
	Для каждого Задание Из ТаблицаЗаданий Цикл
	
		Если Задание.Состояние = Перечисления.СостоянияОтложенныхЗаданий.Ожидание Тогда
			Задание.Статус = "Ожидает запуска";
		ИначеЕсли Задание.Пользователь = ЭтаФорма.Пользователь Тогда // свое фоновое можно посмотреть
			ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Задание.ИдентификаторФоновогоЗадания);
			Если ФоновоеЗадание = Неопределено Тогда
				Задание.Статус = "Ошибка: не смогло запуститься";
			ИначеЕсли ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
				Задание.Статус = "Выполняется";
			ИначеЕсли ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
				Задание.Статус = "Ошибка: завершено";
			ИначеЕсли ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
				Задание.Статус = "Ошибка: аварийное завершение";
			ИначеЕсли ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
				Задание.Статус = "Ошибка: отменено";
			КонецЕсли;
		Иначе // а вот чужое фоновое нельзя - пишем просто выполняется
			Задание.Статус = "Выполняется";
		КонецЕсли;
	
	КонецЦикла;
	
	ТаблицаЗаданий.Колонки.Удалить("ИдентификаторФоновогоЗадания");
	ТаблицаЗаданий.Колонки.Удалить("Состояние");
	
	ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент(, , , Новый ТабличныйДокумент); 

	РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(ПараметрыВывода, ТаблицаЗаданий, , , , Истина); 
	РаботаСОтчетами.УстановитьШиринуКолонок(ПараметрыВывода);
	
	Возврат ПараметрыВывода.ДокументРезультат;
	
КонецФункции

&НаКлиенте
Процедура КтоФормирует(Команда)
	
	Документ = КтоФормируетНаСервере();
	
	Документ.ТолькоПросмотр = Истина;
	Документ.ОтображатьСетку = Ложь;
	Документ.Показать("Текущие формирования");
	
КонецПроцедуры

&НаКлиенте
Процедура ТолькоЗакрытыеДоговорыПриИзменении(Элемент)
	Элементы.СчетаДоверительногоУправленияДатаРасторжения.Видимость = ЭтаФорма.ТолькоЗакрытыеДоговоры;
	УточнитьУПользователяИЗаполнитьСчетаДоверительногоУправления();
КонецПроцедуры

&НаСервере
Функция НайтиСессию(ИдентификаторФоновогоЗадания)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтатистикаРаботыВнутреннихМеханизмов.Сессия КАК Сессия,
		|	СтатистикаРаботыВнутреннихМеханизмов.ПараметрыВыполнения КАК ПараметрыВыполнения
		|ИЗ
		|	РегистрСведений.СтатистикаРаботыВнутреннихМеханизмов КАК СтатистикаРаботыВнутреннихМеханизмов
		|ГДЕ
		|	СтатистикаРаботыВнутреннихМеханизмов.Механизм = &ИскомыйМеханизм
		|	И СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияОкончание = ДАТАВРЕМЯ(1, 1, 1)
		|	И СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияНачало >= &НачалоС
		|	И СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияНачало <= &НачалоПо
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПериодВыполненияНачало";
	
	Запрос.УстановитьПараметр("НачалоС", НачалоДня(ТекущаяДата()) - 24 * 60 * 60);
	Запрос.УстановитьПараметр("НачалоПо", ТекущаяДата());
	Запрос.УстановитьПараметр("ИскомыйМеханизм", "Обработки.ФормированиеБухгалтерскогоУчета.ОбработатьСчетаДУФоново");
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
    Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
	
		ПараметрыФормирования = ВыборкаДетальныеЗаписи.ПараметрыВыполнения.Получить();
		Если ПараметрыФормирования.ИдентификаторЗадания = ИдентификаторФоновогоЗадания Тогда
			Возврат ВыборкаДетальныеЗаписи.Сессия;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура ОтменитьФормированиеНаСервере(Идентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОтложенныеЗадания.Состояние КАК Состояние,
		|	ОтложенныеЗадания.ИдентификаторФоновогоЗадания КАК ИдентификаторФоновогоЗадания
		|ИЗ
		|	РегистрСведений.ОтложенныеЗадания КАК ОтложенныеЗадания
		|ГДЕ
		|	ОтложенныеЗадания.Идентификатор = &Идентификатор";
	
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Если ВыборкаДетальныеЗаписи.Состояние = Перечисления.СостоянияОтложенныхЗаданий.Выполняется Тогда
			
			Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ВыборкаДетальныеЗаписи.ИдентификаторФоновогоЗадания);
			
			Если Задание <> Неопределено										// ФЗ существует (уже запускался)
				И Задание.Ключ <> Пользователь.Код								// это не ФЗ мастера-формирователя
				И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда	// ФЗ жив и работает
				
				Попытка
					Задание.Отменить();
				Исключение
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось отменить формирование!");
					Возврат;
				КонецПопытки;
				
				ЗаписьЖурналаРегистрации("Фоновое задание. Ошибка выполнения", 
											УровеньЖурналаРегистрации.Ошибка, 
											Метаданные.Обработки.ФормированиеБухгалтерскогоУчета, 
											Задание.Наименование, 
											"Интерактивная отмена формирования учета");
				Сессия = НайтиСессию(ВыборкаДетальныеЗаписи.ИдентификаторФоновогоЗадания);
				Если Сессия <> Неопределено Тогда
					
					РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
						"Обработки.ФормированиеБухгалтерскогоУчета.ОбработатьСчетаДУФоново", 
						Сессия,
						,
						,
						"Интерактивная отмена формирования учета");
				
				КонецЕсли;
				
			Иначе // ФЗ уже нет - нужно просто отменить ОЗ
				РаботаСРегламентнымиЗаданиями.ОтменитьОтложенноеЗадание(Идентификатор, "Формирование отменено:" + ЭтаФорма.Пользователь, ЛОЖЬ);
			КонецЕсли;
										
		ИначеЕсли ВыборкаДетальныеЗаписи.Состояние = Перечисления.СостоянияОтложенныхЗаданий.Ожидание Тогда
			РаботаСРегламентнымиЗаданиями.ОтменитьОтложенноеЗадание(Идентификатор, "Формирование отменено:" + ЭтаФорма.Пользователь, ЛОЖЬ);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Формирование уже отменено!");
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ДоступнаРольПолныеПраваНаСервере()

	Возврат РольДоступна("ПолныеПрава");

КонецФункции

&НаКлиенте
Процедура ОтменитьФормирование(Команда)
	
	ТекущиеДанные = ЭтаФорма.Элементы.Задания.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите задание");
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияОтложенныхЗаданий.Выполняется")
		ИЛИ ТекущиеДанные.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияОтложенныхЗаданий.Ожидание") Тогда
		
		Если ТекущиеДанные.Пользователь <> ЭтаФорма.Пользователь И НЕ РаботаСПользователями.ЭтоПолноправныйПользователь(ЭтаФорма.Пользователь) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отменить формирование можно только у своего задания");
			Возврат
		КонецЕсли;
		
		Если Вопрос("Вы уверены?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		
		ОтменитьФормированиеНаСервере(ТекущиеДанные.Идентификатор);
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОтчетОВыполненииНаСервере(ТекущиеДанные)

	СообщенияФоновогоЗадания = РаботаСДлительнымиОперациями.ПолучитьСообщения(ТекущиеДанные.ИдентификаторФоновогоЗадания);
	Сообщения = Новый Массив();
	
	Макет = Обработки.ФормированиеБухгалтерскогоУчета.ПолучитьМакет("МакетИнформацияОФормировании");
	
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьПараметрыФормирования = Макет.ПолучитьОбласть("ПараметрыФормирования");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьСообщения = Макет.ПолучитьОбласть("Сообщения");
	ОбластьСообщение = Макет.ПолучитьОбласть("Сообщение");
	
    Результат = Новый ТекстовыйДокумент();
	
	Результат.Вывести(ОбластьЗаголовок);
	
	ЗаполнитьЗначенияСвойств(ОбластьПараметрыФормирования.Параметры, ТекущиеДанные);
	
	ПараметрыФормирования = ТекущиеДанные.Параметры.Получить();
	ОбластьПараметрыФормирования.Параметры.НачалоПериода = ПараметрыФормирования.НачалоПериода;
	ОбластьПараметрыФормирования.Параметры.КонецПериода = ПараметрыФормирования.КонецПериода;
	
	Результат.Вывести(ОбластьПараметрыФормирования);
	Результат.Вывести(ОбластьШапка);
	
	ТекущееВремя = "";
	Для каждого СообщениеФоновогоЗадания Из СообщенияФоновогоЗадания Цикл
		Если Лев(СообщениеФоновогоЗадания, 2) = "# " Тогда
			Если Прав(СообщениеФоновогоЗадания, 25) <> "Начали формирование учета" Тогда
				
			    ОбластьСтрока.Параметры.День = Сред(СообщениеФоновогоЗадания, 30, 10);
				ОбластьСтрока.Параметры.Этап = Сред(СообщениеФоновогоЗадания, 43);
				ОбластьСтрока.Параметры.Начало = ТекущееВремя;
				ОбластьСтрока.Параметры.Конец = Сред(СообщениеФоновогоЗадания, 3, 8);
				
				Результат.Вывести(ОбластьСтрока);
				
			КонецЕсли;
			ТекущееВремя = Сред(СообщениеФоновогоЗадания, 3, 8);
		Иначе
			Сообщения.Добавить(СообщениеФоновогоЗадания);
		КонецЕсли;
	КонецЦикла;
	Результат.Вывести(ОбластьПодвал);
	
	Если Сообщения.Количество() > 0 Тогда
		Результат.Вывести(ОбластьСообщения);
		Для каждого Сообщение Из Сообщения Цикл
			ОбластьСообщение.Параметры.Сообщение = Сообщение;
			Результат.Вывести(ОбластьСообщение);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗаданияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = ЭтаФорма.Элементы.Задания.ТекущиеДанные;

	Если Поле.Имя = "ЗаданияСостояние" Тогда
		
		ДанныеФБУ = Новый Структура("ИдентификаторФоновогоЗадания, СчетДоверительногоУправления, ВидУчета, Пользователь, Организация, Состояние, Параметры");
		ЗаполнитьЗначенияСвойств(ДанныеФБУ, ТекущиеДанные);
		
		ПечатнаяФорма = ПолучитьОтчетОВыполненииНаСервере(ДанныеФБУ);
		ПечатнаяФорма.Показать("Отчет о формировании бухгалтерского учета");
		
	КонецЕсли; 
	
КонецПроцедуры

