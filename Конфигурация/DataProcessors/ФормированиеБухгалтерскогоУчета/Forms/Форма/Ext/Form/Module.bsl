&НаСервере
Процедура ЗаполнитьСчетаДоверительногоУправленияПоВидамУчетаНаСервере(ПерезаполнятьСчетаУчета = Истина);
	
	Если ЭтаФорма.СчетаДоверительногоУправления.Количество() > 0 И ПерезаполнятьСчетаУчета Тогда
		ЭтаФорма.СчетаДоверительногоУправления.Очистить();
	КонецЕсли;
	
	Если НЕ (ЭтаФорма.ФормироватьБухгалтерскийУчет ИЛИ ЭтаФорма.ФормироватьЕдиныйБухгалтерскийУчет ИЛИ ЭтаФорма.ФормироватьНалоговыйУчет) Тогда
	    Возврат;
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	ЗапросСчетаДУ = Новый Запрос;
	ЗапросСчетаДУ.МенеджерВременныхТаблиц = МенеджерВТ;
	
	ЗапросСчетаДУ.УстановитьПараметр("ИсключатьЗакрытыеДоговоры",		ЭтотОбъект.ИсключатьЗакрытыеДоговоры);
	ЗапросСчетаДУ.УстановитьПараметр("ТолькоЗакрытыеДоговоры",			ЭтотОбъект.ТолькоЗакрытыеДоговоры);
	ЗапросСчетаДУ.УстановитьПараметр("Период",							Объект.НачалоПериода);
	ЗапросСчетаДУ.УстановитьПараметр("Организация",						Объект.Организация);
	
	Если НЕ ПерезаполнятьСчетаУчета Тогда
		
		ЗапросСчетаДУ.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ 
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _СчетаДУ
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка В(&СчетаДоверительногоУправления)
		|	И СчетаДоверительногоУправления.Организация = &Организация";
	
		ЗапросСчетаДУ.УстановитьПараметр("СчетаДоверительногоУправления",	ЭтаФорма.СчетаДоверительногоУправления.Выгрузить(, "СчетДоверительногоУправления").ВыгрузитьКолонку("СчетДоверительногоУправления"));
	
	ИначеЕсли ЭтаФорма.РежимОтбора = 0 Тогда // все счета ДУ
		
		ЗапросСчетаДУ.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _СчетаДУ
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И (&ИсключатьЗакрытыеДоговоры
		|				И (СчетаДоверительногоУправления.ДатаРасторжения >= &Период
		|					ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		|			ИЛИ НЕ &ИсключатьЗакрытыеДоговоры
		|				И НЕ &ТолькоЗакрытыеДоговоры
		|			ИЛИ &ТолькоЗакрытыеДоговоры
		|				И СчетаДоверительногоУправления.ДатаРасторжения < &Период
		|				И СчетаДоверительногоУправления.ДатаРасторжения <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))";
		
	ИначеЕсли ЭтаФорма.РежимОтбора = 1 Тогда // по виду договора ДУ
		
		ЗапросСчетаДУ.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _СчетаДУ
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И (&ИсключатьЗакрытыеДоговоры
		|				И (СчетаДоверительногоУправления.ДатаРасторжения >= &Период
		|					ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		|			ИЛИ НЕ &ИсключатьЗакрытыеДоговоры
		|				И НЕ &ТолькоЗакрытыеДоговоры
		|			ИЛИ &ТолькоЗакрытыеДоговоры
		|				И СчетаДоверительногоУправления.ДатаРасторжения < &Период
		|				И СчетаДоверительногоУправления.ДатаРасторжения <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В(&ОтборВидыДоговоровДУ)";
		
		ЗапросСчетаДУ.УстановитьПараметр("ОтборВидыДоговоровДУ",	ЭтаФорма.ОтборВидыДоговоровДУ.ВыгрузитьЗначения());
		
	ИначеЕсли ЭтаФорма.РежимОтбора = 2 Тогда // по счету ДУ
		
		ЗапросСчетаДУ.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _СчетаДУ
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И  (&ИсключатьЗакрытыеДоговоры
		|				И (СчетаДоверительногоУправления.ДатаРасторжения >= &Период
		|					ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		|			ИЛИ НЕ &ИсключатьЗакрытыеДоговоры
		|				И НЕ &ТолькоЗакрытыеДоговоры
		|			ИЛИ &ТолькоЗакрытыеДоговоры
		|				И СчетаДоверительногоУправления.ДатаРасторжения < &Период
		|				И СчетаДоверительногоУправления.ДатаРасторжения <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		|	И СчетаДоверительногоУправления.Ссылка В(&ОтборСчетаДУ)";
		
		ЗапросСчетаДУ.УстановитьПараметр("ОтборСчетаДУ",	ЭтаФорма.ОтборСчетаДУ.ВыгрузитьЗначения());
		
	ИначеЕсли ЭтаФорма.РежимОтбора = 3 Тогда // по клиенту ДУ
		
		ЗапросСчетаДУ.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _СчетаДУ
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, Клиент В (&ОтборКлиенты)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И  (&ИсключатьЗакрытыеДоговоры
		|				И (СчетаДоверительногоУправления.ДатаРасторжения >= &Период
		|					ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		|			ИЛИ НЕ &ИсключатьЗакрытыеДоговоры
		|				И НЕ &ТолькоЗакрытыеДоговоры
		|			ИЛИ &ТолькоЗакрытыеДоговоры
		|				И СчетаДоверительногоУправления.ДатаРасторжения < &Период
		|				И СчетаДоверительногоУправления.ДатаРасторжения <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))";
		
		ЗапросСчетаДУ.УстановитьПараметр("ОтборКлиенты",	ЭтаФорма.ОтборКлиенты.ВыгрузитьЗначения());
		
	ИначеЕсли ЭтаФорма.РежимОтбора = 4 Тогда // по СпецДепу
		
		ЗапросСчетаДУ.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _СчетаДУ
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И  (&ИсключатьЗакрытыеДоговоры
		|				И (СчетаДоверительногоУправления.ДатаРасторжения >= &Период
		|					ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		|			ИЛИ НЕ &ИсключатьЗакрытыеДоговоры
		|				И НЕ &ТолькоЗакрытыеДоговоры
		|			ИЛИ &ТолькоЗакрытыеДоговоры
		|				И СчетаДоверительногоУправления.ДатаРасторжения < &Период
		|				И СчетаДоверительногоУправления.ДатаРасторжения <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		|	И СчетаДоверительногоУправления.СпециализированныйДепозитарий В(&ОтборСпецДеп)";
		
		ЗапросСчетаДУ.УстановитьПараметр("ОтборСпецДеп",	ЭтаФорма.ОтборСпецДеп.ВыгрузитьЗначения());
		
	КонецЕсли;
	
	ЗапросСчетаДУ.Выполнить();
	
	
	Запрос = Новый Запрос;
	
	ОтборПоВидамУчета = "";
	
	Если ЭтаФорма.ФормироватьБухгалтерскийУчет Тогда
		Запрос.УстановитьПараметр("БухгалтерскийУчет", Истина);
		ОтборПоВидамУчета = ?(ОтборПоВидамУчета = "", " (&", ОтборПоВидамУчета + " ИЛИ &") + "БухгалтерскийУчет И ВестиБухгалтерскийУчет";
	КонецЕсли;
	
	Если ЭтаФорма.ФормироватьЕдиныйБухгалтерскийУчет Тогда
		Запрос.УстановитьПараметр("ЕдиныйБухгалтерскийУчет", Истина);
		ОтборПоВидамУчета = ?(ОтборПоВидамУчета = "", " (&", ОтборПоВидамУчета + " ИЛИ &") + "ЕдиныйБухгалтерскийУчет И ВестиЕдиныйБухгалтерскийУчет";
	КонецЕсли;
	
	Если ЭтаФорма.ФормироватьНалоговыйУчет Тогда
		Запрос.УстановитьПараметр("НалоговыйУчет", Истина);
		ОтборПоВидамУчета = ?(ОтборПоВидамУчета = "", " (&", ОтборПоВидамУчета + " ИЛИ &") + "НалоговыйУчет И ВестиНалоговыйУчет";
	КонецЕсли;
	
	ОтборПоВидамУчета = ОтборПоВидамУчета + ")";
	
	Запрос.УстановитьПараметр("Организация",					Объект.Организация);
	Запрос.УстановитьПараметр("Период",							Объект.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",					КонецДня(Объект.КонецПериода));
	Запрос.УстановитьПараметр("НачалоПереоценок",				ДобавитьМесяц(Объект.НачалоПериода, -1));
	
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПереоценкаЦенныхБумаг.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	МАКСИМУМ(ПереоценкаЦенныхБумаг.Дата) КАК Дата
	|ПОМЕСТИТЬ _ПереоценкаПД
	|ИЗ
	|	Документ.ПереоценкаЦенныхБумаг КАК ПереоценкаЦенныхБумаг
	|ГДЕ
	|	ПереоценкаЦенныхБумаг.Дата МЕЖДУ &НачалоПереоценок И &Период
	|	И ПереоценкаЦенныхБумаг.Проведен
	|	И ПереоценкаЦенныхБумаг.Организация = &Организация
	|
	|СГРУППИРОВАТЬ ПО
	|	ПереоценкаЦенныхБумаг.СчетДоверительногоУправления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ПереоценкаПД.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	_ПереоценкаПД.Дата КАК Дата,
	|	ПереоценкаЦенныхБумаг.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ _Переоценки
	|ИЗ
	|	_ПереоценкаПД КАК _ПереоценкаПД
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПереоценкаЦенныхБумаг КАК ПереоценкаЦенныхБумаг
	|		ПО _ПереоценкаПД.СчетДоверительногоУправления = ПереоценкаЦенныхБумаг.СчетДоверительногоУправления
	|			И _ПереоценкаПД.Дата = ПереоценкаЦенныхБумаг.Дата
	|			И (ПереоценкаЦенныхБумаг.Проведен)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_Переоценки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	КОЛИЧЕСТВО(СтоимостьПереоценки.НомерСтроки) КАК НомерСтроки
	|ПОМЕСТИТЬ _Объем
	|ИЗ
	|	_Переоценки КАК _Переоценки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
	|		ПО _Переоценки.Ссылка = СтоимостьПереоценки.Регистратор
	|
	|СГРУППИРОВАТЬ ПО
	|	_Переоценки.СчетДоверительногоУправления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИСТИНА КАК Обрабатывать,
	|	НастройкиУчетаОбщиеСрезПоследних.ВестиБухгалтерскийУчет КАК БухгалтерскийУчет,
	|	НастройкиУчетаОбщиеСрезПоследних.ВестиЕдиныйБухгалтерскийУчет КАК ЕдиныйБухгалтерскийУчет,
	|	НастройкиУчетаОбщиеСрезПоследних.ВестиНалоговыйУчет КАК НалоговыйУчет,
	|	НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления.КодСчета КАК КодСчетаДУ,
	|	НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
	|	НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления.Код КАК Код,
	|	НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговора,
	|	ДЗ_БУ.ДатаЗапретаРедактирования КАК БухгалтерскийУчетДата,
	|	ДЗ_НУ.ДатаЗапретаРедактирования КАК НалоговыйУчетДата,
	|	ДЗ_ЕПС.ДатаЗапретаРедактирования КАК ЕдиныйБухгалтерскийУчетДата,
	|	ЕСТЬNULL(_Объем.НомерСтроки, 0) КАК ОбъемПортфеля
	|ИЗ
	|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
	|			&КонецПериода,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления В
	|					(ВЫБРАТЬ
	|						_СчетаДУ.Ссылка
	|					ИЗ
	|						_СчетаДУ)) КАК НастройкиУчетаОбщиеСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаРедактирования КАК ДЗ_БУ
	|		ПО НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления = ДЗ_БУ.СчетДоверительногоУправления
	|			И (ДЗ_БУ.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии))
	|			И (ДЗ_БУ.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.БухгалтерскийУчет))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаРедактирования КАК ДЗ_НУ
	|		ПО НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления = ДЗ_НУ.СчетДоверительногоУправления
	|			И (ДЗ_НУ.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии))
	|			И (ДЗ_НУ.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаРедактирования КАК ДЗ_ЕПС
	|		ПО НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления = ДЗ_ЕПС.СчетДоверительногоУправления
	|			И (ДЗ_ЕПС.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии))
	|			И (ДЗ_ЕПС.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет))
	|		ЛЕВОЕ СОЕДИНЕНИЕ _Объем КАК _Объем
	|		ПО НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления = _Объем.СчетДоверительногоУправления
	|ГДЕ
	|	&ОтборПоВидамУчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления.Наименование";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоВидамУчета", ОтборПоВидамУчета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(Выборка.СчетДоверительногоУправления) <> Выборка.СчетДоверительногоУправления Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ПерезаполнятьСчетаУчета Тогда
			НоваяСтрока = ЭтаФорма.СчетаДоверительногоУправления.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		Иначе
			// Устанавливаем флажки только по списку
			НайдСтроки = ЭтаФорма.СчетаДоверительногоУправления.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", Выборка.СчетДоверительногоУправления));
			Если НайдСтроки.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НайдСтрока = НайдСтроки[0];
			ЗаполнитьЗначенияСвойств(НайдСтрока, Выборка,, "СчетДоверительногоУправления, КодСчетаДУ, ДатаРасторжения, ВидДоговора");
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаданияНаСервере()

	ПараметрыФормированияБухгалтерскогоУчета = Обработки.МенеджерОтложенныхЗаданий.ПолучитьПараметрыФормированияБухгалтерскогоУчета();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОтложенныеЗадания.Идентификатор КАК Идентификатор,
		|	ОтложенныеЗадания.ИдентификаторФоновогоЗадания КАК ИдентификаторФоновогоЗадания,
		|	ОтложенныеЗадания.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОтложенныеЗадания.ВидУчета КАК ВидУчета,
		|	ОтложенныеЗадания.Сложность КАК Сложность,
		|	ОтложенныеЗадания.Пользователь КАК Пользователь,
		|	ОтложенныеЗадания.ДатаДобавления КАК ДатаДобавления,
		|	ОтложенныеЗадания.ДатаЗапуска КАК ДатаЗапуска,
		|	ОтложенныеЗадания.Организация КАК Организация,
		|	ОтложенныеЗадания.Состояние КАК Состояние,
		|	ОтложенныеЗадания.Параметры КАК Параметры,
		|	ВЫБОР
		|		КОГДА ОтложенныеЗадания.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОтложенныхЗаданий.Ожидание)
		|			ТОГДА 1
		|		КОГДА ОтложенныеЗадания.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОтложенныхЗаданий.Выполняется)
		|			ТОГДА 2
		|		ИНАЧЕ 3
		|	КОНЕЦ КАК ПорядокЗаданий,
		|	ВЫБОР
		|		КОГДА ОтложенныеЗадания.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОтложенныхЗаданий.Ожидание)
		|			ТОГДА ОтложенныеЗадания.ДатаДобавления
		|		КОГДА ОтложенныеЗадания.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОтложенныхЗаданий.Выполняется)
		|			ТОГДА ОтложенныеЗадания.ДатаЗапуска
		|		КОГДА ОтложенныеЗадания.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОтложенныхЗаданий.Отменено)
		|			ТОГДА ОтложенныеЗадания.ДатаОшибкиОтмены
		|		ИНАЧЕ ОтложенныеЗадания.ДатаВыполнения
		|	КОНЕЦ КАК ПорядокДат,
		|	ВЫБОР
		|		КОГДА ОтложенныеЗадания.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОтложенныхЗаданий.Отменено)
		|			ТОГДА ОтложенныеЗадания.ДатаОшибкиОтмены
		|		ИНАЧЕ ОтложенныеЗадания.ДатаВыполнения
		|	КОНЕЦ КАК ДатаЗавершения,
		|	ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования
		|ИЗ
		|	РегистрСведений.ОтложенныеЗадания КАК ОтложенныеЗадания
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
		|		ПО ОтложенныеЗадания.Организация = ДатыЗапретаРедактирования.Организация
		|			И ОтложенныеЗадания.СчетДоверительногоУправления = ДатыЗапретаРедактирования.СчетДоверительногоУправления
		|			И ОтложенныеЗадания.ВидУчета = ДатыЗапретаРедактирования.ВидУчета
		|			И (ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии))
		|ГДЕ
		|	ОтложенныеЗадания.Объект = &Объект
		|	И (НАЧАЛОПЕРИОДА(ОтложенныеЗадания.ДатаДобавления, ДЕНЬ) = &ТекущаяДата
		|			ИЛИ ОтложенныеЗадания.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОтложенныхЗаданий.Ожидание)
		|			ИЛИ ОтложенныеЗадания.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОтложенныхЗаданий.Выполняется))
		|	И ОтложенныеЗадания.Организация = &Организация
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядокЗаданий,
		|	ПорядокДат УБЫВ";
	
	Запрос.УстановитьПараметр("Объект",			ПараметрыФормированияБухгалтерскогоУчета.ОбъектФормированияБухгалтерскогоУчета);
	Запрос.УстановитьПараметр("ТекущаяДата",	НачалоДня(ТекущаяДата()));
	
	Если РольДоступна("ПолныеПрава") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ОтложенныеЗадания.Организация = &Организация", "");
	Иначе		
		Запрос.УстановитьПараметр("Организация",	Объект.Организация);
	КонецЕсли;
	
	ЭтаФорма.Задания.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ЕстьВыполняющиеся = Ложь;
	ЕстьОжидающие = Ложь;
	Для каждого СтрокаЗадания Из ЭтаФорма.Задания Цикл
		Если СтрокаЗадания.Состояние = Перечисления.СостоянияОтложенныхЗаданий.Ожидание ИЛИ СтрокаЗадания.Состояние = Перечисления.СостоянияОтложенныхЗаданий.Выполняется Тогда
			ПараметрыФормирования = СтрокаЗадания.Параметры.Получить();
			СтрокаЗадания.Период = ПредставлениеПериода(ПараметрыФормирования.НачалоПериода, ПараметрыФормирования.КонецПериода);
		Иначе
			СтрокаЗадания.Период = "";
		КонецЕсли;
		Если СтрокаЗадания.Пользователь = ЭтаФорма.Пользователь Тогда
			Если СтрокаЗадания.Состояние = Перечисления.СостоянияОтложенныхЗаданий.Ожидание Тогда
				ЕстьОжидающие = Истина;
			ИначеЕсли СтрокаЗадания.Состояние = Перечисления.СостоянияОтложенныхЗаданий.Выполняется Тогда
				ЕстьВыполняющиеся = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьОжидающие И НЕ ЕстьВыполняющиеся Тогда // оработка ситуации когда по той или иной причине умер мастер
		Обработки.МенеджерОтложенныхЗаданий.ЗапуститьМастерЗаданийФормированияБухгалтерскогоУчета(Объект.Организация, ЭтаФорма.Пользователь);
	КонецЕсли;
	
КонецПроцедуры

#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если РольДоступна("ПолныеПрава") Тогда
		ЭтаФорма.Элементы.ЗаданияОрганизация.Видимость = Истина;
	КонецЕсли;
	
	ЭтаФорма.ИсключатьЗакрытыеДоговоры = Истина;
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	ЭтаФорма.Пользователь = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущийПользователь");

	РаботаСБухгалтерскимиОтчетамиКлиентСервер.ЗаполнитьСписокВыбораВидПериода(
												Перечисления.ДоступныеПериодыОтчета.День,
												ЭтаФорма.Элементы.ВидПериода.СписокВыбора,
												ЭтаФорма.ВидПериода);
												
	ОбновитьЗаданияНаСервере();
												
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	РежимОтбораПриИзменении(ЭтаФорма.Элементы.РежимОтбора);
	ВидПериодаПриИзменении(Неопределено);
	
	// Обновляем виды учета и заголовок, если они еще не обновлены
	ОбновитьВидимостьКолонокСчетовДУ();
	
	ПоказатьФормированиеУчета(Ложь);
	
	Для Каждого ТекСтрока Из ЭтаФорма.Задания Цикл
		Если ТекСтрока.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияОтложенныхЗаданий.Выполняется")
			И ТекСтрока.Пользователь = ЭтаФорма.Пользователь Тогда
			
			ПоказатьФормированиеУчета(Истина);
			ПодключитьОбработчикОжидания("ОжиданиеЗавершенияФоновыхЗаданий", 5);
			Прервать;
			
		КонецЕсли;
	КонецЦикла;
	
	Если ЭтаФорма.СчетаДоверительногоУправления.Количество() = 0 Тогда
	
		ЗаполнитьСчетаДоверительногоУправленияПоВидамУчетаНаСервере(Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	
	Для Каждого ТекСтрока Из ЭтаФорма.СчетаДоверительногоУправления Цикл
		
		ТекСтрока.Обрабатывать = Истина;
		Если ЭтаФорма.ФормироватьБухгалтерскийУчет И ТекСтрока.БухгалтерскийУчетДата >= Объект.НачалоПериода
			ИЛИ ЭтаФорма.ФормироватьЕдиныйБухгалтерскийУчет И ТекСтрока.ЕдиныйБухгалтерскийУчетДата >=  Объект.НачалоПериода
			ИЛИ ЭтаФорма.ФормироватьНалоговыйУчет И ТекСтрока.НалоговыйУчетДата >= Объект.НачалоПериода Тогда
		
			ТекСтрока.Обрабатывать = Ложь;
		
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	
	Для Каждого ТекСтрока Из ЭтаФорма.СчетаДоверительногоУправления Цикл
		ТекСтрока.Обрабатывать = Ложь;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПЕРИОД

&НаКлиенте
Процедура ВидПериодаПриИзменении(Элемент)
	
	РаботаСБухгалтерскимиОтчетамиКлиентСервер.ВидПериодаПриИзменении(Элемент, ВидПериода, Объект.НачалоПериода, Объект.КонецПериода, Период);
	РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПереключитьТекущуюСтраницуВыбораПериода(ВидПериода, Элементы.ГруппаПоляВводаПериода);
	
	ОбновитьТекстЗаголовкаНаСервере(ЭтаФорма);
	ОбновитьВидимостьКолонокСчетовДУ();
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоПериодаПриИзменении(Элемент)
	
	ОбновитьТекстЗаголовкаНаСервере(ЭтаФорма);
	УточнитьУПользователяИЗаполнитьСчетаДоверительногоУправления();
	ЗаполнитьСчетаДоверительногоУправленияПоВидамУчетаНаСервере(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура КонецПериодаПриИзменении(Элемент)
	
	ОбновитьТекстЗаголовкаНаСервере(ЭтаФорма);
	УточнитьУПользователяИЗаполнитьСчетаДоверительногоУправления();
	ЗаполнитьСчетаДоверительногоУправленияПоВидамУчетаНаСервере(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоПериодаДеньПриИзменении(Элемент)
	
	Объект.КонецПериода = КонецДня(Объект.НачалоПериода);
	ОбновитьТекстЗаголовкаНаСервере(ЭтаФорма);
	УточнитьУПользователяИЗаполнитьСчетаДоверительногоУправления();
	ЗаполнитьСчетаДоверительногоУправленияПоВидамУчетаНаСервере(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПериодПриИзменении(Элемент, Период, Объект.НачалоПериода, Объект.КонецПериода);
	
	ОбновитьТекстЗаголовкаНаСервере(ЭтаФорма);
	УточнитьУПользователяИЗаполнитьСчетаДоверительногоУправления();
	ЗаполнитьСчетаДоверительногоУправленияПоВидамУчетаНаСервере(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПериодНачалоВыбора(ЭтаФорма, Элемент, СтандартнаяОбработка, 
		ВидПериода, Период, Объект.НачалоПериода, Объект.КонецПериода);
	
	ОбновитьТекстЗаголовкаНаСервере(ЭтаФорма);
	УточнитьУПользователяИЗаполнитьСчетаДоверительногоУправления();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПериодОбработкаВыбора(
		Элемент, ВыбранноеЗначение, СтандартнаяОбработка,
		ВидПериода, Период, Объект.НачалоПериода, Объект.КонецПериода);
		
	ОбновитьТекстЗаголовкаНаСервере(ЭтаФорма);
	УточнитьУПользователяИЗаполнитьСчетаДоверительногоУправления();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	
	РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПериодАвтоПодбор(
		Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка,
		ВидПериода, Период, Объект.НачалоПериода, Объект.КонецПериода);
	УточнитьУПользователяИЗаполнитьСчетаДоверительногоУправления();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПериодОкончаниеВводаТекста(
		Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка,
		ВидПериода, Период, Объект.НачалоПериода, Объект.КонецПериода);
	УточнитьУПользователяИЗаполнитьСчетаДоверительногоУправления();
	
КонецПроцедуры

#КонецОбласти

#Область Вспомогательные

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовкаНаСервере(Форма)

	Объект = Форма.Объект;
	
	ЗаголовокОтчета = "Формирование бух. учета " + РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПолучитьПредставлениеПериода(Объект.НачалоПериода, Объект.КонецПериода);

	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		ЗаголовокОтчета = ЗаголовокОтчета + " " + Строка(Объект.Организация);
	КонецЕсли;

	Форма.Заголовок = ЗаголовокОтчета;

КонецПроцедуры

&НаКлиенте
Функция ОбновитьВидимостьКолонокСчетовДУ()

	Элементы.СчетаДоверительногоУправленияБухгалтерскийУчет.Видимость 			= Ложь;
	Элементы.СчетаДоверительногоУправленияБухгалтерскийУчетДата.Видимость 		= Ложь;
	
	Элементы.СчетаДоверительногоУправленияЕдиныйБухгалтерскийУчет.Видимость 	= Ложь;
	Элементы.СчетаДоверительногоУправленияЕдиныйБухгалтерскийУчетДата.Видимость = Ложь;
	
	Элементы.СчетаДоверительногоУправленияНалоговыйУчет.Видимость				= Ложь;
	Элементы.СчетаДоверительногоУправленияНалоговыйУчетДата.Видимость			= Ложь;
	
	Элементы.СчетаДоверительногоУправленияБухгалтерскийУчет.Видимость			= ЭтаФорма.ФормироватьБухгалтерскийУчет;
	Элементы.СчетаДоверительногоУправленияБухгалтерскийУчетДата.Видимость 		= ЭтаФорма.ФормироватьБухгалтерскийУчет;
	
	Элементы.СчетаДоверительногоУправленияЕдиныйБухгалтерскийУчет.Видимость		= ЭтаФорма.ФормироватьЕдиныйБухгалтерскийУчет;
	Элементы.СчетаДоверительногоУправленияЕдиныйБухгалтерскийУчетДата.Видимость = ЭтаФорма.ФормироватьЕдиныйБухгалтерскийУчет;
	
	Элементы.СчетаДоверительногоУправленияНалоговыйУчет.Видимость				= ЭтаФорма.ФормироватьНалоговыйУчет;
	Элементы.СчетаДоверительногоУправленияНалоговыйУчетДата.Видимость			= ЭтаФорма.ФормироватьНалоговыйУчет;
	
КонецФункции

