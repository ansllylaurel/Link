#КонецОбласти

&НаКлиенте
Процедура ОжиданиеЗавершенияФоновыхЗаданий()
	
	КлючТекущейСтрокиРегламентныхЗаданий = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.Задания, "ИдентификаторФоновогоЗадания");
	
	ОбновитьЗаданияНаСервере();
	
	РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.Задания, Элементы.Задания, "ИдентификаторФоновогоЗадания", КлючТекущейСтрокиРегламентныхЗаданий);
		
	ОсталисьЗадания = Ложь;
	
	Для Каждого ТекСтрока Из ЭтаФорма.Задания Цикл
		
		Если ТекСтрока.Пользователь <> ЭтаФорма.Пользователь Тогда // чужие задания нам не интересны
			Продолжить;
		КонецЕсли;
		
		Если ТекСтрока.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияОтложенныхЗаданий.Выполняется")
			ИЛИ ТекСтрока.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияОтложенныхЗаданий.Ожидание") Тогда
		
			ОсталисьЗадания = Истина;
		
		КонецЕсли;
		
		СтрокиСчетаДУ = ЭтаФорма.СчетаДоверительногоУправления.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", ТекСтрока.СчетДоверительногоУправления));
		Для каждого СтрокаСчетаДУ Из СтрокиСчетаДУ Цикл
		
			Если ТекСтрока.ВидУчета = ПредопределенноеЗначение("Перечисление.ВидыУчета.БухгалтерскийУчет") Тогда
				СтрокаСчетаДУ.БухгалтерскийУчетДата = ТекСтрока.ДатаЗапретаРедактирования;
			ИначеЕсли ТекСтрока.ВидУчета = ПредопределенноеЗначение("Перечисление.ВидыУчета.НалоговыйУчет") Тогда
				СтрокаСчетаДУ.НалоговыйУчетДата = ТекСтрока.ДатаЗапретаРедактирования;
			ИначеЕсли ТекСтрока.ВидУчета = ПредопределенноеЗначение("Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет") Тогда
				СтрокаСчетаДУ.ЕдиныйБухгалтерскийУчетДата = ТекСтрока.ДатаЗапретаРедактирования;
			КонецЕсли;
			
			СтрокаСчетаДУ.Состояние = ТекСтрока.Состояние;
			
		КонецЦикла;
		
		Если ТекущаяДата() - ТекСтрока.ДатаЗавершения > 7 И ТекСтрока.ДатаЗавершения <> '00010101' Тогда // давно уже завершилось - можно про него не сообщать
			Продолжить;		
		КонецЕсли;
		
		Если ТекСтрока.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияОтложенныхЗаданий.Ошибка") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон( "Формирование по '%1' завершено с ошибками!", ТекСтрока.СчетДоверительногоУправления));
		ИначеЕсли ТекСтрока.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияОтложенныхЗаданий.Отменено") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон( "Формирование по '%1' отменено!", ТекСтрока.СчетДоверительногоУправления));
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОсталисьЗадания Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьФормированиеУчета(Ложь);
	ОтключитьОбработчикОжидания("ОжиданиеЗавершенияФоновыхЗаданий");
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обработка завершена");
			
КонецПроцедуры

&НаСервере
Функция ПроверитьДатыЗапрета(КоличествоСчетовКФормированию)
	
	МассивВидовУчета = Новый Массив();
	
	Если ЭтаФорма.ФормироватьБухгалтерскийУчет Тогда
		МассивВидовУчета.Добавить(Перечисления.ВидыУчета.БухгалтерскийУчет);
	ИначеЕсли ЭтаФорма.ФормироватьЕдиныйБухгалтерскийУчет Тогда
		МассивВидовУчета.Добавить(Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	ИначеЕсли ЭтаФорма.ФормироватьНалоговыйУчет Тогда
		МассивВидовУчета.Добавить(Перечисления.ВидыУчета.НалоговыйУчет);
	КонецЕсли;
	
	РезультатПроверки = Новый Структура("ЕстьСчетаСДатойЗапретаБольшеНачалаПериода, ЕстьСчетаСПромежуткомМеждуДатойЗапретаИНачаломПериода", Ложь, Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДатыЗапретаРедактирования.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДатыЗапретаРедактирования.ДатаЗапретаРедактирования >= &НачалоПериода КАК ДатаЗапретаБольше,
		|	ДатыЗапретаРедактирования.ДатаЗапретаРедактирования <> ДАТАВРЕМЯ(1, 1, 1)
		|		И РАЗНОСТЬДАТ(ДатыЗапретаРедактирования.ДатаЗапретаРедактирования, &НачалоПериода, ДЕНЬ) > 1 КАК ДатаЗапретаЕстьПромежуток
		|ИЗ
		|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
		|ГДЕ
		|	ДатыЗапретаРедактирования.СчетДоверительногоУправления В(&СчетаДоверительногоУправления)
		|	И ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии)
		|	И ДатыЗапретаРедактирования.ВидУчета В(&МассивВидовУчета)
		|	И (ДатыЗапретаРедактирования.ДатаЗапретаРедактирования >= &НачалоПериода
		|			ИЛИ ДатыЗапретаРедактирования.ДатаЗапретаРедактирования <> ДАТАВРЕМЯ(1, 1, 1)
		|				И РАЗНОСТЬДАТ(ДатыЗапретаРедактирования.ДатаЗапретаРедактирования, &НачалоПериода, ДЕНЬ) > 1)";
	
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", ЭтаФорма.СчетаДоверительногоУправления.Выгрузить().ВыгрузитьКолонку("СчетДоверительногоУправления"));
	Запрос.УстановитьПараметр("МассивВидовУчета", МассивВидовУчета);
	Запрос.УстановитьПараметр("НачалоПериода", Объект.НачалоПериода);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СтрокиНеОбрабатывать = ЭтаФорма.СчетаДоверительногоУправления.НайтиСтроки(Новый Структура("СчетДоверительногоУправления, Обрабатывать", Выборка.СчетДоверительногоУправления, Истина));
		Для каждого СтрокаНеОбрабатывать Из СтрокиНеОбрабатывать Цикл
			
			РезультатПроверки.ЕстьСчетаСДатойЗапретаБольшеНачалаПериода				= РезультатПроверки.ЕстьСчетаСДатойЗапретаБольшеНачалаПериода				ИЛИ Выборка.ДатаЗапретаБольше;
			РезультатПроверки.ЕстьСчетаСПромежуткомМеждуДатойЗапретаИНачаломПериода	= РезультатПроверки.ЕстьСчетаСПромежуткомМеждуДатойЗапретаИНачаломПериода	ИЛИ Выборка.ДатаЗапретаЕстьПромежуток;
			
			СтрокаНеОбрабатывать.Обрабатывать = Ложь;
			КоличествоСчетовКФормированию = КоличествоСчетовКФормированию - 1;
		КонецЦикла;
		
	КонецЦикла;	
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаКлиенте
Функция ПроверитьНастройкиУчета()

	КонтрольБУ = Ложь;
	КонтрольНУ = Ложь;
	КонтрольЕПС = Ложь;
	
	МассивСчетовДУ = Новый Массив;
	Для Каждого ТекСтрока Из ЭтаФорма.СчетаДоверительногоУправления Цикл
		Если ТекСтрока.Обрабатывать Тогда
		    МассивСчетовДУ.Добавить(ТекСтрока.СчетДоверительногоУправления);
		КонецЕсли;
	КонецЦикла;
	
	ОтчетПроверкаНастроек = ОбщегоНазначения.ПолучитьИменованныйОбъект("ОтчетПроверкаНастроек");
	ИмяПодключенногоОбъекта = РаботаСДополнительнымиОтчетамиИОбработками.ПодключитьВнешнююОбработку(ОтчетПроверкаНастроек);
	
	ФормаОтчета = ПолучитьФорму("ВнешнийОтчет." + ИмяПодключенногоОбъекта + ".Форма", );
	
	ФормаОтчета.Период.ДатаНачала = Объект.НачалоПериода;
	ФормаОтчета.Период.ДатаОкончания = Объект.КонецПериода;

	ФормаОтчета.КонтрольБУ = ЭтаФорма.ФормироватьБухгалтерскийУчет;
	ФормаОтчета.КонтрольНУ = ЭтаФорма.ФормироватьНалоговыйУчет;
	ФормаОтчета.КонтрольЕПС = ЭтаФорма.ФормироватьЕдиныйБухгалтерскийУчет;
	
	ФормаОтчета.СчетаДУ.ЗагрузитьЗначения(МассивСчетовДУ);

	Возврат ФормаОтчета.КонтрольИзФормированияУчета();
	
КонецФункции
 
&НаКлиенте
Процедура КомандаСформировать(Команда)
	
	ТекстОшибки = "";
	Если Объект.НачалоПериода = '00010101' ИЛИ Объект.КонецПериода = '00010101' ИЛИ Объект.НачалоПериода > Объект.КонецПериода Тогда
		ТекстОшибки = "Неверно заполнен период! Формирование учета прервано";
	ИначеЕсли КонецДня(Объект.КонецПериода) > КонецДня(ТекущаяДата()) Тогда
		ТекстОшибки = "Период формирования включает будущие даты! Формирование учета прервано";
	ИначеЕсли НЕ (ЭтаФорма.ФормироватьБухгалтерскийУчет ИЛИ ЭтаФорма.ФормироватьЕдиныйБухгалтерскийУчет ИЛИ ЭтаФорма.ФормироватьНалоговыйУчет) Тогда
		ТекстОшибки = "Не выбран ни один вид учета!";
	ИначеЕсли Не ПроверитьНастройкиУчета() Тогда
		ТекстОшибки = "Не заполнены настройки по некоторым счетам ДУ! Формирование учета прервано";
	КонецЕсли;
	
	Если ТекстОшибки <> "" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	КоличествоСчетовКФормированию = 0;
	Для каждого СтрокаСчетаДоверительногоУправления Из ЭтаФорма.СчетаДоверительногоУправления Цикл
		Если СтрокаСчетаДоверительногоУправления.Обрабатывать Тогда 
			КоличествоСчетовКФормированию = КоличествоСчетовКФормированию + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоСчетовКФормированию = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбрано счетов для формирования!");
		Возврат;
	КонецЕсли;
	
	РезультатПроверки = ПроверитьДатыЗапрета(КоличествоСчетовКФормированию);
	Если РезультатПроверки.ЕстьСчетаСДатойЗапретаБольшеНачалаПериода ИЛИ РезультатПроверки.ЕстьСчетаСПромежуткомМеждуДатойЗапретаИНачаломПериода Тогда

		ТекстСообщения = "У счетов ДУ есть проблемы:";
		
		Если РезультатПроверки.ЕстьСчетаСДатойЗапретаБольшеНачалаПериода Тогда
			ТекстСообщения = ТекстСообщения + "
				| Даты запрета больше начала периода!"
		КонецЕсли;
		
		Если РезультатПроверки.ЕстьСчетаСПромежуткомМеждуДатойЗапретаИНачаломПериода Тогда
			ТекстСообщения = ТекстСообщения + "
				| Между датой запрета и началом периода промежуток больше одного дня!
				| Нужно или сдвинуть даты запрета или поставить начало периода со следующего дня после даты запрета";
		КонецЕсли;
		
		Если КоличествоСчетовКФормированию = 0 Тогда

			ТекстСообщения = ТекстСообщения + "
				| Формирование учета прервано";
				
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
				
		Иначе
			
			ТекстСообщения = ТекстСообщения + "
				| Сформировать учет по остальным?";
			
			Если Вопрос(ТекстСообщения, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет) = КодВозвратаДиалога.Нет Тогда
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЕсли;
	
	ПоказатьФормированиеУчета(Истина);
	
	ПодготовитьПараметрыОбработкиИНачатьВыполнениеНаСервере();
		
	ПодключитьОбработчикОжидания("ОжиданиеЗавершенияФоновыхЗаданий", 5);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьПараметрыОбработкиИНачатьВыполнениеНаСервере()
	
	МассивВидовУчета = Новый Массив;
	Если ЭтаФорма.ФормироватьБухгалтерскийУчет Тогда
		МассивВидовУчета.Добавить(Перечисления.ВидыУчета.БухгалтерскийУчет);
	КонецЕсли;
	Если ЭтаФорма.ФормироватьЕдиныйБухгалтерскийУчет Тогда
		МассивВидовУчета.Добавить(Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	КонецЕсли;
	Если ЭтаФорма.ФормироватьНалоговыйУчет Тогда
		МассивВидовУчета.Добавить(Перечисления.ВидыУчета.НалоговыйУчет);
	КонецЕсли;
	
	ПараметрыФормированияБухгалтерскогоУчета = Обработки.МенеджерОтложенныхЗаданий.ПолучитьПараметрыФормированияБухгалтерскогоУчета();
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ОбъектФормированияБухгалтерскогоУчета",	ПараметрыФормированияБухгалтерскогоУчета.ОбъектФормированияБухгалтерскогоУчета);
	Запрос.УстановитьПараметр("КомандаФормированияБухгалтерскогоУчета",	ПараметрыФормированияБухгалтерскогоУчета.КомандаФормированияБухгалтерскогоУчета);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОтложенныеЗадания.Организация КАК Организация,
		|	ОтложенныеЗадания.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОтложенныеЗадания.ВидУчета КАК ВидУчета,
		|	ОтложенныеЗадания.Сложность КАК Сложность
		|ИЗ
		|	РегистрСведений.ОтложенныеЗадания КАК ОтложенныеЗадания
		|ГДЕ
		|	ОтложенныеЗадания.Объект = &ОбъектФормированияБухгалтерскогоУчета
		|	И ОтложенныеЗадания.Команда = &КомандаФормированияБухгалтерскогоУчета
		|	И ОтложенныеЗадания.Состояние В (ЗНАЧЕНИЕ(Перечисление.СостоянияОтложенныхЗаданий.Ожидание), ЗНАЧЕНИЕ(Перечисление.СостоянияОтложенныхЗаданий.Выполняется))
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидУчета УБЫВ";
	
	ЗапущенныеФормирования = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаСчетаДоверительногоУправления Из ЭтаФорма.СчетаДоверительногоУправления Цикл
		
		Если НЕ СтрокаСчетаДоверительногоУправления.Обрабатывать Тогда 
			Продолжить;
		КонецЕсли;
		
		СчетДоверительногоУправления = СтрокаСчетаДоверительногоУправления.СчетДоверительногоУправления;
		
		Для каждого ВидУчета Из МассивВидовУчета Цикл
		
			ИмяВидаУчета = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ВидУчета);
			
			ТекстОшибки = "";
			Если НЕ СтрокаСчетаДоверительногоУправления[ИмяВидаУчета] Тогда
				ТекстОшибки = "По счету ДУ " + СчетДоверительногоУправления + " на " + Формат(Объект.НачалоПериода, "ДФ=dd.MM.yyyy") + " " + ВидУчета + "  не ведется - пропускаем";
			ИначеЕсли ЗапущенныеФормирования.НайтиСтроки(Новый Структура("СчетДоверительногоУправления, ВидУчета", СчетДоверительногоУправления, ВидУчета)).Количество() > 0 Тогда
				ТекстОшибки = "По счету ДУ " + СчетДоверительногоУправления + " уже запущено формирование " + ВидУчета + ", дождитесь его окончания";
			КонецЕсли;
			
			Если ТекстОшибки <> "" Тогда
			    ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				Продолжить;
			КонецЕсли;
			
			СтрокаСчетаДоверительногоУправления.Обрабатывать = Ложь;
			
			ПараметрыОбработки = Новый Структура;
			
			ПараметрыОбработки.Вставить("СчетДоверительногоУправления",	СчетДоверительногоУправления);
			ПараметрыОбработки.Вставить("ВидУчета",						ВидУчета);
			ПараметрыОбработки.Вставить("НачалоПериода",				Объект.НачалоПериода);
			ПараметрыОбработки.Вставить("КонецПериода",					КонецДня(Объект.КонецПериода));
			ПараметрыОбработки.Вставить("Организация",					Объект.Организация);
			ПараметрыОбработки.Вставить("Сложность",					СтрокаСчетаДоверительногоУправления.ОбъемПортфеля);
			ПараметрыОбработки.Вставить("Пользователь",					ЭтаФорма.Пользователь);
			
			РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание(
											ПараметрыФормированияБухгалтерскогоУчета.ОбъектФормированияБухгалтерскогоУчета,
											ПараметрыФормированияБухгалтерскогоУчета.КомандаФормированияБухгалтерскогоУчета,
											ПараметрыОбработки);
			
		КонецЦикла;
	
	КонецЦикла;
	
	Обработки.МенеджерОтложенныхЗаданий.ЗапуститьМастерЗаданийФормированияБухгалтерскогоУчета(Объект.Организация, ЭтаФорма.Пользователь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииВидаОтбора(ИмяВидаОтбора)

	ИмяРеквизитаВидОтбора = "Отбор" + ИмяВидаОтбора + "ВСписке";
	ИмяЭлемента = "Отбор" + ИмяВидаОтбора;
	ИмяЭлементаСписок = "Отбор" + ИмяВидаОтбора + "Список";
	
	ВидОтбораВСписке = ЭтаФорма[ИмяРеквизитаВидОтбора];
	
	Элементы[ИмяЭлемента].Видимость = Не ВидОтбораВСписке;
	Элементы[ИмяЭлементаСписок].Видимость = ВидОтбораВСписке;
	
	Если Не ВидОтбораВСписке Тогда
		
		КоличествоЭлементов = ЭтаФорма[ИмяЭлемента].Количество();
		
		Если КоличествоЭлементов = 0 Тогда
			// добавим первую строку
			ЭтаФорма[ИмяЭлемента].Добавить();
		ИначеЕсли КоличествоЭлементов > 1 Тогда
			Для Индекс = -(КоличествоЭлементов - 1) По -1 Цикл
				// удалим все элементы, кроме первого
				ЭтаФорма[ИмяЭлемента].Удалить(-Индекс);
			КонецЦикла; 
		КонецЕсли; 
	
	КонецЕсли; 

КонецПроцедуры

&НаКлиенте
Процедура РежимОтбораПриИзменении(Элемент)
	
	Элементы.ГруппаОтборВидыДоговоровДУ.Видимость 	= ЭтаФорма.РежимОтбора = 1;
	Элементы.ГруппаОтборСчетаДУ.Видимость 			= ЭтаФорма.РежимОтбора = 2;
	Элементы.ГруппаОтборКлиенты.Видимость 			= ЭтаФорма.РежимОтбора = 3;
	Элементы.ГруппаОтборСпецДеп.Видимость 				= ЭтаФорма.РежимОтбора = 4;
	
	ПриИзмененииВидаОтбора("ВидыДоговоровДУ");
	ПриИзмененииВидаОтбора("СчетаДУ");
	ПриИзмененииВидаОтбора("Клиенты");
	ПриИзмененииВидаОтбора("СпецДеп");
	
	УточнитьУПользователяИЗаполнитьСчетаДоверительногоУправления();	
	
КонецПроцедуры

