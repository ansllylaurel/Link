	</xs:simpleType>
	<xs:simpleType name="premium_discount_type_et">
		<xs:annotation>
			<xs:documentation>тип уведомления о переводе активов</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="PREM">
				<xs:annotation>
					<xs:documentation>надбавка</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DISC">
				<xs:annotation>
					<xs:documentation>скидка</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="processing_status_code_et">
		<xs:annotation>
			<xs:documentation>код статуса обработки документа</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="PACK">
				<xs:annotation>
					<xs:documentation>документ получен и принят к обработке</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REJT">
				<xs:annotation>
					<xs:documentation>документ не принят к последующей обработке</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PEND">
				<xs:annotation>
					<xs:documentation>документ ожидает обработки</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
		<!-- =========================================================================================== -->
	</xs:simpleType>
	<xs:simpleType name="qualified_investor_et">
		<xs:annotation>
			<xs:documentation>квалифицированный инвестор</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="QUAL">
				<xs:annotation>
					<xs:documentation>квалифицированный инвестор</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNQUAL">
				<xs:annotation>
					<xs:documentation>неквалифицированный инвестор</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
		<!-- =========================================================================================== -->
	</xs:simpleType>
	<xs:simpleType name="reason_code_et">
		<xs:annotation>
			<xs:documentation>код причины присвоения статуса обработки документа</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="CMIS">
				<xs:annotation>
					<xs:documentation>нет информации от контрагента</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DISA">
				<xs:annotation>
					<xs:documentation>стихийное бедствие</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BLOC">
				<xs:annotation>
					<xs:documentation>счет заблокирован</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COLL">
				<xs:annotation>
					<xs:documentation>ценные бумаги находятся в залоге</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LACK">
				<xs:annotation>
					<xs:documentation>недостаточно ценных бумаг на счете</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REFU">
				<xs:annotation>
					<xs:documentation>документ не опознан</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ICAG">
				<xs:annotation>
					<xs:documentation>неверно указаны реквизиты контрагент</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
		<!-- =========================================================================================== -->
	</xs:simpleType>
	<xs:simpleType name="registration_country_et">
		<xs:annotation>
			<xs:documentation>Страна регистрации</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="RUS">
				<xs:annotation>
					<xs:documentation>Россия</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GBR">
				<xs:annotation>
					<xs:documentation>Соединенное Королевство Великобритании и Северной Ирландии</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CYP">
				<xs:annotation>
					<xs:documentation>Кипр</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BLR">
				<xs:annotation>
					<xs:documentation>Беларусь</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SGP">
				<xs:annotation>
					<xs:documentation>Сингапур</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
		<!-- =========================================================================================== -->
	</xs:simpleType>
	<xs:simpleType name="scheme_name_et">
		<xs:annotation>
			<xs:documentation>наименование схемы кодировки</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="EOCC">
				<xs:annotation>
					<xs:documentation>для указания на использование кодировки Euroclear Bank, Brussels (при идентификации номера счета или стороны)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CEDE">
				<xs:annotation>
					<xs:documentation>для указания на использование кодировки Clearstream Banking, Luxembourg (при идентификации номера счета или стороны)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RUIC">
				<xs:annotation>
					<xs:documentation>для указания на код БиК, присваиваемый Центральным Банком Российской Федерации кредитным организациям (при идентификации стороны)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SMPG">
				<xs:annotation>
					<xs:documentation source="международная кодировка ISO20022 (SMPG)">для указания на использование международной кодировки стандарта ISO20022 (SMPG –Security Market Practice Group)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
		<!-- =========================================================================================== -->
	</xs:simpleType>
	<xs:simpleType name="security_category_et">
		<xs:annotation>
			<xs:documentation>категория ценной бумаги - по предоставляемым правам</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="ORDN">
				<xs:annotation>
					<xs:documentation>обыкновенные</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PREF">
				<xs:annotation>
					<xs:documentation>привилегированные</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
		<!-- =========================================================================================== -->
	</xs:simpleType>
	<xs:simpleType name="security_classification_et">
		<xs:annotation>
			<xs:documentation>вид ценной бумаги</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="BOND">
				<xs:annotation>
					<xs:documentation>облигация</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SHAR">
				<xs:annotation>
					<xs:documentation>акция</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MFUN">
				<xs:annotation>
					<xs:documentation>пай</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RDRP">
				<xs:annotation>
					<xs:documentation>российская депозитарная расписка</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MPPC">
				<xs:annotation>
					<xs:documentation>ипотечный сертификат участия</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
		<!-- =========================================================================================== -->
	</xs:simpleType>
	<xs:simpleType name="shareholder_list_special_et">
		<xs:annotation>
			<xs:documentation>тип выборки пайщиков</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="ALL">
				<xs:annotation>
					<xs:documentation>Все</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NONZERO">
				<xs:annotation>
					<xs:documentation>Все с количеством паев больше нуля</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
		<!-- =========================================================================================== -->
	</xs:simpleType>
	<xs:simpleType name="document_type_et">
		<xs:annotation>
			<xs:documentation>тип документа</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="ALLCT">
				<xs:annotation>
					<xs:documentation>Выделение</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
		<!-- =========================================================================================== -->
	</xs:simpleType>
	<xs:simpleType name="tax_status_et">
		<xs:annotation>
			<xs:documentation>код статуса налогоплательщика</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="1">
				<xs:annotation>
					<xs:documentation>Налоговый резидент РФ / российская организация</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="2">
				<xs:annotation>
