							</xs:annotation>
						</xs:element>
						<xs:element name="shareholder_info" type="individual_person_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Информация о пайщике</xs:documentation>
							</xs:annotation>
						</xs:element>																		
						<xs:element name="consent_to_the_processing_of_personal_data" type="text_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Текст согласия</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="sign_info" type="text_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Информация о подписи</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="add_info" type="info_list_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Дополнительная информация</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
