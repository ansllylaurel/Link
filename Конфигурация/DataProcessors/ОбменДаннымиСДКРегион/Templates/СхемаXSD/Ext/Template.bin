	</xs:simpleType>
	<xs:simpleType name="payment_statement_type_et">
		<xs:annotation>
			<xs:documentation>тип уведомления о переводе активов</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="SETLMNT">
