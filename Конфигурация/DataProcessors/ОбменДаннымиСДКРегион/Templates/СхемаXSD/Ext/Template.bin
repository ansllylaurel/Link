				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
		<!-- =========================================================================================== -->
	</xs:simpleType>
	<xs:simpleType name="point_type_et">
		<xs:annotation>
			<xs:documentation>Тип агентского пункта</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="MAIN">
				<xs:annotation>
					<xs:documentation>Основной</xs:documentation>
