				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
		<!-- =========================================================================================== -->
	</xs:simpleType>
	<xs:simpleType name="transaction_type_et">
		<xs:annotation>
			<xs:documentation>вид операции</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="DELI">
				<xs:annotation>
					<xs:documentation>списание</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RECE">
				<xs:annotation>
