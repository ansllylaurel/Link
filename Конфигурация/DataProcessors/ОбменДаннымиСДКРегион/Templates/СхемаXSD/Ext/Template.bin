							</xs:annotation>
						</xs:element>
						<xs:element name="investment_fund" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Описание фонда, номер правил доверительного управления паевого инвестиционного фонда; (id_type = TMRL);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="agent" type="party_id_name_t" minOccurs="0">
