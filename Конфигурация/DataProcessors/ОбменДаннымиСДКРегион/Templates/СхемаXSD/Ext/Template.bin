				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="4">
				<xs:annotation>
					<xs:documentation>Документ (*.xls)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="5">
				<xs:annotation>
					<xs:documentation>Текстовый комментарий</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
		<!-- =========================================================================================== -->
	</xs:simpleType>
	<xs:simpleType name="letter_go_type_et">
		<xs:annotation>
			<xs:documentation>способ получения корреспонденции, выписок, отчетов</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="LETR">
				<xs:annotation>
					<xs:documentation>Почтой</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REGR">
