			</xs:enumeration>
			<xs:enumeration value="EDOC">
				<xs:annotation>
					<xs:documentation>По системе ЭДО</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ELKK">
				<xs:annotation>
					<xs:documentation>Через личный кабинет клиента</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
-->
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="nonresident_type_et">
		<xs:annotation>
			<xs:documentation>тип нерезидента юридического лица</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="00">
				<xs:annotation>
					<xs:documentation>нерезидент с постоянным представительством</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="01">
				<xs:annotation>
