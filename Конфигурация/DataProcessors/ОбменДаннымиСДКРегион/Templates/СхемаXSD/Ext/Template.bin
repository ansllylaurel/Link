			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="phone_type_et">
		<xs:annotation>
			<xs:documentation>код типа номера телефона</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="HOME">
