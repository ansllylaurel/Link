	<xs:element name="STATEMENT_OF_CONFIRMED_TRANSACTION">
		<xs:annotation>
			<xs:documentation>Отчет о проведении операции по лицевому счету</xs:documentation>
			<!-- =========================================================================================== -->
			<!-- =========================================================================================== -->
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="answer_doc_t">
					<xs:sequence>
						<xs:element name="document_code" type="text_t" fixed="DKRA_04">
							<xs:annotation>
								<xs:documentation>Идентификатор типа документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="registrar" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Данные о депозитарии, специализированном депозитарии</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="managment_company" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Идентификатор УК, например, ОГРН (id_type = OGRN);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="investment_fund" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Описание фонда, номер правил доверительного управления паевого инвестиционного фонда; (id_type = TMRL);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="agent" type="party_id_name_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Идентификатор агента, если заявление поступает от него</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="application_doc" type="doc_link_t">
							<xs:annotation>
								<xs:documentation>Заявка на приобретение паев, по которой производится операция</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="shareholder_id" type="party_identification_t">
							<xs:annotation>
								<xs:documentation>Идентификационная информация зарегистрированного лица</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="account_id" type="account_dtls_v03_t">
							<xs:annotation>
								<xs:documentation>Лицевой счет зарегистрированного лица</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="processing_info">
							<xs:annotation>
								<xs:documentation>информация о проведенной операции</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="operation_name" type="text_t">
										<xs:annotation>
											<xs:documentation>наименование операции</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="operation_type" type="transaction_type_et">
										<xs:annotation>
											<xs:documentation>тип операции</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="processing_datetime" type="xs:dateTime">
										<xs:annotation>
											<xs:documentation>Дата обработки документа/ дата операции/ дата внесения записи в реестр</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="processing_reference">
										<xs:annotation>
											<xs:documentation>номер документа /номер операции/ номер внесения записи в реестр</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="processing_reference_external" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Уникальный идентификационный номер (референс), если он был указан в Распоряжении</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="unit_quantity" type="quantity_in_unit_t">
										<xs:annotation>
											<xs:documentation>количество паев</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="unit_cost" type="currency_and_amount_t">
										<xs:annotation>
											<xs:documentation>расчетная стоимость пая</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="premium_discount" minOccurs="0">
										<xs:annotation>
											<xs:documentation>скидки, надбавки</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="premium_discount" type="premium_discount_type_et"/>
												<xs:element name="amount" type="currency_and_amount_t"/>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="reason_operation">
										<xs:annotation>
											<xs:documentation>основание операции</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="doc" type="doc_link_t" maxOccurs="unbounded"/>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="managers" type="manager_dtls_t" nillable="true">
							<xs:annotation>
								<xs:documentation>Уполномоченные лица регистратора</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="report_datetime" type="datetime_t">
							<xs:annotation>
								<xs:documentation>дата и время уведомления</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="add_info" type="info_list_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Дополнительная информация</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
		<!-- =========================================================================================== -->
		<!-- =========================================================================================== -->
	</xs:element>
	<xs:element name="STATEMENT_OF_BLOCK_TRANSACTION">
		<xs:annotation>
			<xs:documentation>Уведомление о приостановлении/вознобновлении операций по (лицевому) счету</xs:documentation>
			<!-- =========================================================================================== -->
