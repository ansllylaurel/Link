				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ELCT">
				<xs:annotation>
					<xs:documentation>Электронно</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<!--			
			<xs:enumeration value="KURR">
