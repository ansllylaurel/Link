			</xs:enumeration>
			<xs:enumeration value="03">
				<xs:annotation>
					<xs:documentation>счет доверительного управляющего</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="04">
				<xs:annotation>
					<xs:documentation>счет залогодержателя</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
