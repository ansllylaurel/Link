												<xs:element name="amount" type="currency_and_amount_t">
													<xs:annotation>
														<xs:documentation>сумма</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="premium_discount" type="currency_and_amount_t">
													<xs:annotation>
														<xs:documentation>общая сумма надбавки/скидки</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="reason_operation">
													<xs:annotation>
														<xs:documentation>основание операции</xs:documentation>
													</xs:annotation>
													<xs:complexType>
														<xs:sequence>
															<xs:element name="doc" type="doc_link_t" maxOccurs="unbounded"/>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
												<xs:element name="investment_fund_related" type="party_id_name_t" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Описание связанного фонда при обмене, номер правил доверительного управления паевого инвестиционного фонда; (id_type = TMRL);</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="total_quantity_out" type="quantity_in_unit_t">
							<xs:annotation>
								<xs:documentation>исходящий остаток</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="managers" type="manager_dtls_t" nillable="true">
							<xs:annotation>
								<xs:documentation>Уполномоченное лицо регистратора</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="add_info" type="info_list_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Дополнительная информация</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
		<!-- =========================================================================================== -->
		<!-- =========================================================================================== -->
	</xs:element>
	<xs:element name="_____STATEMENT_OF_SHARE_BALANCE">
		<xs:annotation>
			<xs:documentation>Cведения о стоимости чистых активов и расчетной стоимости пая</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="out_doc_t">
					<xs:sequence>
						<xs:element name="document_code" type="text_t" fixed="DKRA_06">
							<xs:annotation>
								<xs:documentation>Идентификатор типа документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="issuer" type="party_id_name_t" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Сведения о ПИФ и УК</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="agent" type="party_identification_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Идентификатор агента, если отчет представлен агенту</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="registrar" type="party_dtls_contacts_t">
							<xs:annotation>
								<xs:documentation>Данные о депозитарии, специализированном депозитарии</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="statement_date" type="datetime_t" nillable="false">
							<xs:annotation>
								<xs:documentation>дата и вермя расчета</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="asset_cost" type="decimal_t" nillable="false" minOccurs="0">
							<xs:annotation>
								<xs:documentation>стоимость чистых активов</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="unit_cost" type="quantity_in_unit_t" nillable="false" minOccurs="0">
							<xs:annotation>
								<xs:documentation>расчетная стоимость пая</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="unit_quantity" type="quantity_in_unit_t" nillable="true">
							<xs:annotation>
								<xs:documentation>количество паев в обращении</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="managers" type="manager_dtls_t" nillable="true" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Сведения о должности и ФИО лица, подписавшего документ</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="add_info" type="info_list_t" nillable="true" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Дополнительная информация</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="_____FREE_FORMAT_MESSAGE">
		<xs:annotation>
			<xs:documentation>Сообщение, письмо в свободном формате</xs:documentation>
			<!-- =========================================================================================== -->
			<!-- =========================================================================================== -->
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="out_doc_t">
					<xs:sequence>
						<xs:element name="document_code" type="text_t" fixed="DKRA_07">
							<xs:annotation>
								<xs:documentation>Идентификатор типа документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="message_type">
							<xs:annotation>
								<xs:documentation>трех символьный код, указывающий на тип информации, передаваемой в тексте сообщения (поле text); коды согласовываются сторонами обмена; для указания произвольного типа информации проставляется код = 000 (три нуля)</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="text_t">
									<xs:minLength value="3"/>
									<xs:maxLength value="3"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="doc_link" type="doc_link_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Указание на связанный документ</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="issuer" type="party_id_name_t" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>информация об эмитенте; Для паев ПиФ и иСУ формируется два блока issuer. Для УК указывается ОГРН, в id/issuer = OGRN. Для ПиФ указывается номер правил ДУ,  в id/issuer = TMRL. Для остальных финансовых инструментов указывается ОГРН Эмитента, в id/issuer = OGRN.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="account_dtls" type="account_dtls_v02_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Номер счета зарегистрированного лица (по которому направляется письмо)</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="account_holder" type="party_identification_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>информация о зарегистрированном лице, по счету которого направляется письмо</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="text" type="text_t">
							<xs:annotation>
								<xs:documentation>Текст сообщения - письма (содержание письма)</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="add_info" type="info_list_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Дополнительная информация</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
		<!-- =========================================================================================== -->
		<!-- =========================================================================================== -->
	</xs:element>
	<xs:annotation>
		<xs:documentation>Технические документы</xs:documentation>
	</xs:annotation>
	<xs:element name="STATUS_PROCESSING_ADVICE">
		<xs:annotation>
			<xs:documentation>Служебное сообщение об обработке документа</xs:documentation>
			<!-- =========================================================================================== -->
			<!-- =========================================================================================== -->
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="answer_doc_t">
					<xs:sequence>
						<xs:element name="document_code" type="text_t" fixed="DKRA_01">
							<xs:annotation>
								<xs:documentation>Идентификатор типа документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="status">
							<xs:annotation>
								<xs:documentation>статус документа</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:choice>
										<xs:element name="status_code" type="processing_status_code_et">
											<xs:annotation>
												<xs:documentation>код статуса обработки документа</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="xtnded_status_code" type="text_t">
											<xs:annotation>
												<xs:documentation>расширенное текстовое описание статуса обработки документа</xs:documentation>
											</xs:annotation>
										</xs:element>
									</xs:choice>
									<xs:element name="status_datetime" type="datetime_t" minOccurs="0">
										<xs:annotation>
											<xs:documentation>дата время присвоения статуса</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="reason" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>причина присвоения статуса</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:choice>
									<xs:element name="reason_code" type="reason_code_et">
										<xs:annotation>
											<xs:documentation>код причины присвоения статуса обработки документа</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="xtnded_reason_code" type="text_t">
										<xs:annotation>
											<xs:documentation>расширенное текстовое описание причины присвоения статуса обработки документа</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:choice>
							</xs:complexType>
						</xs:element>
						<xs:element name="add_info" type="info_list_t" minOccurs="0"/>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
		<!-- =========================================================================================== -->
		<!-- =========================================================================================== -->
	</xs:element>
	<xs:annotation>
		<xs:documentation>Базовые комплексные типы</xs:documentation>
	</xs:annotation>
	<xs:complexType name="account_dtls_v02_t">
		<xs:annotation>
			<xs:documentation>подробная информация о счете/ лицевом счете</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="account_id" type="text_t">
				<xs:annotation>
					<xs:documentation>Номер счета зарег.лица</xs:documentation>
					<!-- ===================================================
Указание номера счета является обязательным при наличии открытого счета
=================================================== -->
				</xs:annotation>
			</xs:element>
			<xs:element name="account_type" type="account_type_et">
				<xs:annotation>
					<xs:documentation>тип счета</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="account_own" type="account_own_et">
				<xs:annotation>
					<xs:documentation>владение паями</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="account_quantity_share_owner" type="xs:unsignedLong" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Количество участников общей долевой собственности (указывается при открытии счета общей долевой собственности)</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="account_dtls_v03_t">
		<xs:annotation>
			<xs:documentation>подробная информация о счете/ лицевом счете</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="account_id" type="text_t">
				<xs:annotation>
					<xs:documentation>Номер счета зарег.лица</xs:documentation>
					<!-- ===================================================
Указание номера счета является обязательным при наличии открытого счета
=================================================== -->
				</xs:annotation>
			</xs:element>
			<xs:element name="account_type" type="account_type_et">
				<xs:annotation>
					<xs:documentation>тип счета</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="account_own" type="account_own_et">
				<xs:annotation>
					<xs:documentation>владение паями</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="account_status" type="account_status_et">
				<xs:annotation>
					<xs:documentation>статус счета</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="account_division" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Раздел счета</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="account_dtls_v04_t">
		<xs:annotation>
			<xs:documentation>подробная информация о счете/ лицевом счете</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="account_id" type="text_t">
				<xs:annotation>
					<xs:documentation>Номер счета зарег.лица</xs:documentation>
					<!-- ===================================================
Указание номера счета является обязательным при наличии открытого счета
=================================================== -->
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="account_type_t">
		<xs:annotation>
			<xs:documentation>тип счета</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="account_type_code" type="account_type_et">
				<xs:annotation>
					<xs:documentation>код типа счета</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="narrative" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>текстовое описание типа счета, подлежит обязательному заполнению при account_type = 13</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="address_partad_t">
		<xs:annotation>
			<xs:documentation>структура адреса в формате</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="country" type="text_t">
				<xs:annotation>
					<xs:documentation>код страны</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="index" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>почтовый индекс</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="address" type="text_t">
				<xs:annotation>
					<xs:documentation>адрес</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="address_t">
		<xs:annotation>
			<xs:documentation>обобщенный адрес</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:choice>
				<xs:element name="partad" type="address_partad_t">
					<xs:annotation>
						<xs:documentation>структурированный адрес</xs:documentation>
						<!-- ===================================================
По согласованию сторон используется один из вариантов
=================================================== -->
					</xs:annotation>
				</xs:element>
				<xs:element name="plain" type="text_t">
					<xs:annotation>
						<xs:documentation>Не структурированный почтовый адрес</xs:documentation>
						<!-- ===================================================
По согласованию сторон используется один из вариантов
=================================================== -->
					</xs:annotation>
				</xs:element>
			</xs:choice>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="answer_doc_t">
		<xs:annotation>
			<xs:documentation>общие элементы для всех ответных документов/ сообщений, т.е. документов, которые являются ответом на чей-либо запрос. </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="version" type="text_t" default="DKRF_1706" nillable="false">
				<xs:annotation>
					<xs:documentation>версия XML документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="header">
				<xs:annotation>
					<xs:documentation>Заголовок документа</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="doc_num" type="text_t">
							<xs:annotation>
								<xs:documentation>исходящий номер ответного документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="doc_date" type="date_t">
							<xs:annotation>
								<xs:documentation>дата создания ответного документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="doc_name" type="text_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>название документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="link" type="doc_link_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>информация об инициирующем документе. В отсутствие инициирующего документа, блок link заполняется следующим образом:
- out_doc_num = NONREF
- out_doc_date\date = 1900-01-01 (т.н. условная дата)
</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<!-- ======================================================================================= -->
	</xs:complexType>
	<xs:complexType name="attachment_t">
		<xs:annotation>
			<xs:documentation source="MDR" xml:lang="RusEng">Дополнительные материалы (вложения) / Additional Additional data</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:annotation>
				<xs:documentation source="MDR" xml:lang="RusEng"/>
				<xs:documentation source="MDR" xml:lang="Rus"/>
				<xs:documentation source="MDR" xml:lang="Eng"/>
				<xs:documentation source="PRNT" xml:lang="Rus"/>
				<xs:documentation source="PRNT" xml:lang="Eng"/>
				<xs:documentation source="NSDR" xml:lang="Rus"/>
				<xs:documentation source="NSDR" xml:lang="Eng"/>
			</xs:annotation>
			<xs:element name="file_name" type="text_t" form="unqualified">
				<xs:annotation>
					<xs:documentation source="MDR" xml:lang="RusEng">Имя файла / File name, указывается полностью, с расширением</xs:documentation>
					<xs:documentation source="MDR" xml:lang="Rus">Имя файла</xs:documentation>
					<xs:documentation source="MDR" xml:lang="Eng">File name</xs:documentation>
					<xs:documentation source="PRNT" xml:lang="Rus">Имя файла</xs:documentation>
					<xs:documentation source="PRNT" xml:lang="Eng">File name</xs:documentation>
					<xs:documentation source="NSDR" xml:lang="Rus"/>
					<xs:documentation source="NSDR" xml:lang="Eng"/>
				</xs:annotation>
			</xs:element>
			<xs:element name="description" type="text_t" form="unqualified">
				<xs:annotation>
					<xs:documentation source="MDR" xml:lang="RusEng">Краткое описание содержания файла / File Contents </xs:documentation>
					<xs:documentation source="MDR" xml:lang="Rus">Содержимое файлов, вкладывается в секцию CDATA тега и должно кодироваться по методу Base64 (рекомендации по кодированию см. RFC 4648 – Base 64 Encoding, например, по адресу http://datatracker.ietf.org/doc/rfc4648/)</xs:documentation>
					<xs:documentation source="MDR" xml:lang="Eng"/>
					<xs:documentation source="PRNT" xml:lang="Rus">Содержание файла</xs:documentation>
					<xs:documentation source="PRNT" xml:lang="Eng">File Contents</xs:documentation>
					<xs:documentation source="NSDR" xml:lang="Rus"/>
					<xs:documentation source="NSDR" xml:lang="Eng"/>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="bank_prop_rub_t">
		<xs:annotation>
			<xs:documentation>Банковские реквизиты сторон для расчетов в рублях</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="pay_name" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Наименование  юридического лица или ФиО  физического лица. стороны (плательщика/ получателя) платежа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="inn" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>код иНН стороны (плательщика/ получателя)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="cash_rub_dtls" type="cash_rub_dtls_t">
				<xs:annotation>
					<xs:documentation>информация о банковских реквизитах в рублях</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="pay_add_info" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Дополнительные реквизиты платежа (данные которые необходимы в поле «Назначение платежа»)</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="contract_type_t">
		<xs:annotation>
			<xs:documentation>реквизиты договора</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="doc_num" type="text_t">
				<xs:annotation>
					<xs:documentation>Номер договора</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="doc_date" type="date_t">
				<xs:annotation>
					<xs:documentation>Дата договора</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="cash_rub_dtls_t">
		<xs:annotation>
			<xs:documentation>информация о банковских реквизитах в рублях</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="account" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>счет №/ номер лицевого счета стороны</xs:documentation>
					<!-- ===================================================
Cч № (номер лицевого счета стороны (плательщика/ получателя) в банке
=================================================== -->
				</xs:annotation>
			</xs:element>
			<xs:element name="bank_name" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>наименование банка</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="bank_city" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>город банка</xs:documentation>
					<!-- ===================================================
Город банка стороны (плательщика/ получателя)
=================================================== -->
				</xs:annotation>
			</xs:element>
			<xs:element name="ruic" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>БиК банка</xs:documentation>
					<!-- ===================================================
БиК банка стороны (плательщика/ получателя) - банковский идентификационный код, присваиваемый Банком России кредитным организациям
=================================================== -->
				</xs:annotation>
			</xs:element>
			<xs:element name="bank_corr" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>счет №/ номер корреспондентского счета</xs:documentation>
					<!-- ===================================================
					Cч №  (номер корреспондентского счета банка стороны (плательщика/ получателя) в одном из расчетных учреждений (подразделений) Банка России
				=================================================== -->
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="currency_and_amount_t">
		<xs:annotation>
			<xs:documentation>валюта и сумма</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ccy_code" default="RUB" nillable="false">
				<xs:annotation>
					<xs:documentation>код валюты - 3-х значные буквенные коды в соответствии с Общероссийским классификатором валют ОК (МК(ИСО 4217) 003-97) 014-2000 (ОКВ) </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="text_t">
						<xs:minLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="amount" nillable="false">
				<xs:annotation>
					<xs:documentation>сумма</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="decimal_t"/>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="doc_link_t">
		<xs:annotation>
			<xs:documentation>связанные ссылки (информация об инициирующем документе). В отсутствие инициирующего документа, блок link заполняется следующим образом:
	out_doc_num = NONREF
	out_doc_date\date = 1900-01-01 (т.н. условная дата)</xs:documentation>
			<!--=======================================================
в отсутствие инициирующего документа, блок link заполняется следующим образом:
	out_doc_num = NONREF
	out_doc_date\date = 1900-01-01 (т.н. условная дата)
===================================================================-->
		</xs:annotation>
		<xs:sequence>
			<xs:element name="out_doc">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="out_doc_num" type="text_t">
							<xs:annotation>
								<xs:documentation>исходящий номер документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="out_doc_date" type="date_t">
							<xs:annotation>
								<xs:documentation>дата создания исходящего документа</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="in_doc">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="in_doc_num" type="text_t">
							<xs:annotation>
								<xs:documentation>ссылка на входящий регистрационный номер полученного документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="in_doc_date" type="date_t">
							<xs:annotation>
								<xs:documentation>дата регистрации входящего документа</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="description_doc" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>описание документа</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="entity_reg_doc_type_t">
		<xs:annotation>
			<xs:documentation>тип документа о регистрации юридического лица</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="entity_reg_doc_type_code" type="entity_reg_doc_type_et">
				<xs:annotation>
					<xs:documentation>код типа документа о регистрации юридического лица</xs:documentation>
					<!-- ===================================================
Тип документа, должен принимать значения из фиксированного перечня
=================================================== -->
				</xs:annotation>
			</xs:element>
			<xs:element name="narrative" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Текстовое описание наименования типа документа/ вид лицензии. Заполняется обязательно, только в случае, если значением кода типа документа указано OTHR.</xs:documentation>
					<!-- ===================================================
Заполняется обязательно, только в случае, если значением кода типа документа указано OTHR
=================================================== -->
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="entity_reg_dtls_t">
		<xs:annotation>
			<xs:documentation>информация о регистрации юридического лица</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="reg_doc_type" type="entity_reg_doc_type_et">
				<xs:annotation>
					<xs:documentation>тип документа о регистрации юридического лица</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="reg_num" type="text_t">
				<xs:annotation>
					<xs:documentation>номер регистрации</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="reg_doc_part" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>серия документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="date_of_incorporation" type="date_t">
				<xs:annotation>
					<xs:documentation>дата регистрации</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="reg_org" type="text_t">
				<xs:annotation>
					<xs:documentation>орган, осуществивший регистрацию</xs:documentation>
					<!-- ===================================================
Полное официальное наименование  юридического лица - органа, осуществившего регистрацию
=================================================== -->
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="id_t">
		<xs:annotation>
			<xs:documentation>идентификационная информация</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="id" type="text_t">
				<xs:annotation>
					<xs:documentation>идентификатор. При указании номера счета поля issuer и scheme_name могут иметь любое значение или не указываеться.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:choice>
				<xs:element name="issuer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Указывается код Организации, ведущей справочник идентификационных кодов, не зарегистрированная SWIFTом (NSDR – НКО НРД), если иное правило заполнения поля не задано выше лежащими блоками XSD-схемы.</xs:documentation>
						<!-- ===================================================
Должен быть указан один из элементов (issuer или scheme_name)
Могут указываться первые 4 буквы BIC-кода SWIFT организации
FCSM – ФСФР (Федеральная служба по финансовым рынкам)
NSDR – НКО НРД
DCLC – ДКК
OTHR – прочие
Если код не известен может быть указано UKWN
=================================================== -->
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="text_t"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="scheme_name" type="scheme_name_et" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Наименование схемы кодировки – для организаций, зарегистрированных SWIFT</xs:documentation>
						<!-- ===================================================
Должен быть указан один из элементов (issuer или scheme_name)
Могут указываться коды, организаций, включенных в справочник Data Source Scheme, используемый SWIFT
=================================================== -->
					</xs:annotation>
				</xs:element>
			</xs:choice>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="id_type_t">
		<xs:annotation>
			<xs:documentation>идентификатор с указанием типа идентификатора</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="type" type="id_type_et">
				<xs:annotation>
					<xs:documentation>тип</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="series" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>серия</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="number" type="text_t">
				<xs:annotation>
					<xs:documentation>номер</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="date" type="date_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>дата</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="organ" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>орган</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="place" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>место</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="code" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>код</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="individual_document_min_t">
		<xs:annotation>
			<xs:documentation>документ, удостоверяющий личность физического лица</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="doc_type" type="individual_document_type_et">
				<xs:annotation>
					<xs:documentation>тип документа, удостоверяющего личность физического лица</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="doc_ser" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>серия документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="doc_num" type="text_t">
				<xs:annotation>
					<xs:documentation>номер документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="doc_date" type="date_t">
				<xs:annotation>
					<xs:documentation>когда выдан</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="org" type="text_t">
				<xs:annotation>
					<xs:documentation>орган, выдавший документ</xs:documentation>
					<!-- ===================================================
Полное официальное наименование  юридического лица - органа, выдавшего документ, удостоверяющего личность
=================================================== -->
				</xs:annotation>
			</xs:element>
			<xs:element name="place" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>место выдачи документа</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<!-- ============================================================================================== -->
	</xs:complexType>
	<xs:complexType name="individual_document_t">
		<xs:annotation>
			<xs:documentation>документ, удостоверяющий личность физического лица</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="doc_type" type="individual_document_type_t">
				<xs:annotation>
					<xs:documentation>тип документа, удостоверяющего личность физического лица</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="doc_ser" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>серия документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="doc_num" type="text_t">
				<xs:annotation>
					<xs:documentation>номер документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="doc_date" type="date_t">
				<xs:annotation>
					<xs:documentation>когда выдан</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="org" type="text_t">
				<xs:annotation>
					<xs:documentation>орган, выдавший документ</xs:documentation>
					<!-- ===================================================
Полное официальное наименование  юридического лица - органа, выдавшего документ, удостоверяющего личность
=================================================== -->
				</xs:annotation>
			</xs:element>
			<xs:element name="place" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>место выдачи документа</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<!-- ============================================================================================== -->
	</xs:complexType>
	<xs:complexType name="individual_document_type_t">
		<xs:annotation>
			<xs:documentation>тип документа, удостоверяющего личность физического лица</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="individual_document_type_code" type="individual_document_type_et">
				<xs:annotation>
					<xs:documentation>код типа документа, удостоверяющего личность физического лица</xs:documentation>
					<!-- ===================================================
Принимает значения из фиксированного перечня значений (справочника).
Перечень значений определяется в соответствии со «Справочником «Виды документов, удостоверяющих личность налогоплательщика», приведенного в Приложении к формам N 1-НДФЛ и 2-НДФЛ «Справочники», утвержденном Приказом МНС России от 14.07.2004 N САЭ-3-13/423@ «Об утверждении форм отчетности по налогу на доходы физических лиц».
=================================================== -->
				</xs:annotation>
			</xs:element>
			<xs:element name="narrative" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>текстовое описание типа документа, заполняется обязательно только в случае, если значением типа документа указано 00</xs:documentation>
					<!-- ===================================================
Заполняется обязательно, только в случае, если значением типа документа указано 00
=================================================== -->
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="individual_person_t">
		<xs:annotation>
			<xs:documentation>характеристики физического лица</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="individual_name_separate">
				<xs:annotation>
					<xs:documentation>фамилия, имя, отчетство в разных полях</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="name_first" type="text_t">
							<xs:annotation>
								<xs:documentation>имя</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="name_second" type="text_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>отчество</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="name_last" type="text_t">
							<xs:annotation>
								<xs:documentation>фамилия</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="effievncy_status" type="effiency_status_et">
				<xs:annotation>
					<xs:documentation>Статус дееспособности физического лица</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="individual_document" type="id_type_t">
				<xs:annotation>
					<xs:documentation>документ, удостоверяющий личность физического лица</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="birthtday" type="date_t">
				<xs:annotation>
					<xs:documentation>Дата рождения</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="place_of_birth" type="text_t">
				<xs:annotation>
					<xs:documentation>место рождения</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="nationality" type="registration_country_et">
				<xs:annotation>
					<xs:documentation>гражданство</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="gender" type="gender_et">
				<xs:annotation>
					<xs:documentation>пол</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="legal_address" type="text_t" nillable="true" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Адрес регистрации по месту жительства</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="legal_actual_address" type="text_t" nillable="true" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Адрес регистрации по месту пребывания</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="post_address" type="text_t" nillable="true" minOccurs="0">
				<xs:annotation>
					<xs:documentation>почтовый адрес</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="inn" minOccurs="0">
				<xs:annotation>
					<xs:documentation>код ИНН</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="text_t"/>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ssn" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Номер страхового свидетельства</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="trustee" minOccurs="0">
				<xs:annotation>
					<xs:documentation>родитель, попечитель, опекун</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="name">
							<xs:annotation>
								<xs:documentation>ФИО родителя, попечителя, опекуна</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="name_first" type="text_t">
										<xs:annotation>
											<xs:documentation>имя</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="name_second" type="text_t" nillable="true" minOccurs="0">
										<xs:annotation>
											<xs:documentation>отчество</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="name_last" type="text_t">
										<xs:annotation>
											<xs:documentation>фамилия</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="individual_document" type="id_type_t">
							<xs:annotation>
								<xs:documentation>документ, удостоверяющий личность физического лица</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="base_document" type="text_t">
							<xs:annotation>
								<xs:documentation>Реквизиты акта о назначении попечителя/опекуна (в случае признания физического лица недееспособным или в случае ограничения его дееспособности)</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="placecountry" type="registration_country_et" minOccurs="0">
				<xs:annotation>
					<xs:documentation>страна месторасположения</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="info_list_t" mixed="true">
		<xs:annotation>
			<xs:documentation>неконтролируемый блок для расширений. Элемент может содержать произвольную информацию: текст, другие элементы, двоичную информацию (графику, цифровые подписи, звук, …) и т.д.</xs:documentation>
			<!-- ===================================================
Элемент может содержать произвольную информацию: текст, другие элементы, двоичную информацию (графику, цифровые подписи, звук, …) и т.д.
=================================================== -->
		</xs:annotation>
		<xs:sequence>
			<xs:element name="info_list" type="info_t" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="info_t">
		<xs:sequence>
			<xs:element name="info_type" type="info_type_et"/>
			<xs:element name="info_data" type="xs:anySimpleType"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="manager_dtls_t">
		<xs:annotation>
			<xs:documentation>сведения о должностном лице</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="manager" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Уполномоченные лица регистратора</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="manager_position" type="text_t" nillable="true">
							<xs:annotation>
								<xs:documentation>Должность</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="manager_FIO" type="text_t" nillable="false">
							<xs:annotation>
								<xs:documentation>Фамилия, Имя, Отчество</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="manager_contacts" minOccurs="0">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="manager_contact" type="party_contacts_t" maxOccurs="unbounded">
										<xs:annotation>
											<xs:documentation>контакты должностного лица</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="order_many_t">
		<xs:annotation>
			<xs:documentation>платежное поручение с реквизитами плательщика</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="order_number" nillable="false">
				<xs:annotation>
					<xs:documentation>Номер платежного поручения</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="text_t">
						<xs:minLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="order_date" type="date_t" nillable="false">
				<xs:annotation>
					<xs:documentation>Дата платежного поручения</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="bank_number" nillable="false">
				<xs:annotation>
					<xs:documentation>Номер банковской выписки</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="text_t">
						<xs:minLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="bank_date" type="date_t" nillable="false">
				<xs:annotation>
					<xs:documentation>Дата банковской выписки</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="currency_and_amount" type="currency_and_amount_t" nillable="false">
				<xs:annotation>
					<xs:documentation>валюта и сумма платежа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="premium_discount" minOccurs="0">
				<xs:annotation>
					<xs:documentation>скидки, надбавки</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="premium_discount" type="premium_discount_type_et"/>
						<xs:element name="amount" type="currency_and_amount_t"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="payer" type="bank_prop_rub_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>банковские реквизиты плательщика</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="shareholder_id" type="party_identification_t">
				<xs:annotation>
					<xs:documentation>Идентификатор лица для пайщиков, которым уже открыт счет</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="application_info" type="doc_link_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Заявка на приобретение паев, по которой производится перевод активов</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="order_t">
		<xs:annotation>
			<xs:documentation>платежное поручение</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="order_number" nillable="false">
				<xs:annotation>
					<xs:documentation>Номер платежного поручения</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="text_t">
						<xs:minLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="order_date" type="date_t" nillable="false">
				<xs:annotation>
					<xs:documentation>Дата платежного поручения</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="bank_number" nillable="false">
				<xs:annotation>
					<xs:documentation>Номер банковской выписки</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="text_t">
						<xs:minLength value="0"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="bank_date" type="date_t" nillable="false">
				<xs:annotation>
					<xs:documentation>Дата банковской выписки</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="currency_and_amount" type="currency_and_amount_t" nillable="false">
				<xs:annotation>
					<xs:documentation>валюта и сумма платежа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="premium_discount" minOccurs="0">
				<xs:annotation>
					<xs:documentation>скидки, надбавки</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="premium_discount" type="premium_discount_type_et"/>
						<xs:element name="amount" type="currency_and_amount_t"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="payer" type="bank_prop_rub_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>банковские реквизиты плательщика</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="receiver" type="bank_prop_rub_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>банковские реквизиты получателя</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="basis" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Основание платежа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="receipt_date" minOccurs="0">
				<xs:annotation>
					<xs:documentation>дата зачисления</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="organisation_t">
		<xs:annotation>
			<xs:documentation>характеристики организации</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="organisation_name" nillable="false">
				<xs:annotation>
					<xs:documentation>полное наименование организации</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="text_t">
						<xs:minLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="organisation_short_name" type="text_t" nillable="true">
				<xs:annotation>
					<xs:documentation>краткое наименование организации</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="organisation_other_name" type="text_t" nillable="true">
				<xs:annotation>
					<xs:documentation>иное наименование организации</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="entity_reg_dtls" type="id_type_t" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>сведения о документах организации</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="legal_address" type="text_t" nillable="true">
				<xs:annotation>
					<xs:documentation>адрес места нахождения</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="post_address" type="text_t" nillable="true">
				<xs:annotation>
					<xs:documentation>почтовый адрес</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="registration_country" type="registration_country_et" nillable="false">
				<xs:annotation>
					<xs:documentation>страна регистрации (инкорпорации) юридического лица</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="inn">
				<xs:annotation>
					<xs:documentation>код иНН</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="text_t"/>
				</xs:simpleType>
			</xs:element>
			<xs:element name="iin" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>код ииН</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="kpp" type="text_t">
				<xs:annotation>
					<xs:documentation>код КПП</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="okpo" type="text_t">
				<xs:annotation>
					<xs:documentation>код ОКПО</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="okved" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>код ОКВЭД</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="manager" nillable="true" minOccurs="0">
				<xs:annotation>
					<xs:documentation>единоличный исполнительный орган, обязательно для юридического лица</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="manager_type" type="text_t" nillable="true" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Должность единоличного исполнительного органа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="FIO" type="text_t" nillable="false">
							<xs:annotation>
								<xs:documentation>Фамилия, имя, Отчество</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="individual_document" type="id_type_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Документ, удостоверяющий личность физического лица</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="placecountry" type="registration_country_et" minOccurs="0">
				<xs:annotation>
					<xs:documentation>страна месторасположения</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="out_doc_min_t">
		<xs:annotation>
			<xs:documentation>общие элементы документов, инициируемых участником обмена</xs:documentation>
			<!-- ===================================================
Блок содержит поля, общие для всех документов, инициируемых участником обмена.
=================================================== -->
		</xs:annotation>
		<xs:sequence>
			<xs:element name="version" type="text_t" default="DKRF_1706" nillable="false">
				<xs:annotation>
					<xs:documentation>версия XML документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="header">
				<xs:annotation>
					<xs:documentation>заголовок документа</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="doc_num">
							<xs:annotation>
								<xs:documentation>номер документа по системе учета отправителя</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="date" type="date_t">
							<xs:annotation>
								<xs:documentation>Дата</xs:documentation>
								<!-- ===================================================
Обязательно заполняется один из двух элементов
=================================================== -->
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="out_doc_t">
		<xs:annotation>
			<xs:documentation>общие элементы документов, инициируемых участником обмена</xs:documentation>
			<!-- ===================================================
Блок содержит поля, общие для всех документов, инициируемых участником обмена.
=================================================== -->
		</xs:annotation>
		<xs:sequence>
			<xs:element name="version" type="text_t" default="DKRF_1706" nillable="false">
				<xs:annotation>
					<xs:documentation>версия XML документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="header" type= "header_t">
				<xs:annotation>
					<xs:documentation>заголовок документа</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="doc_num" type="text_t">
							<xs:annotation>
								<xs:documentation>номер документа по системе учета отправителя</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="doc_date" type="date_t">
							<xs:annotation>
								<xs:documentation>дата документа по системе учета отправителя</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="party_contacts_t">
		<xs:annotation>
			<xs:documentation>контактная информация о стороне</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="phone_or_faxes">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="phone_or_fax" type="phone_t" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>номер телефона</xs:documentation>
								<!-- ===================================================
(повторяющийся элемент)
=================================================== -->
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="e_mails" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="e_mail" type="text_t" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>адрес электронной почты</xs:documentation>
								<!-- ===================================================
(повторяющийся элемент)
=================================================== -->
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="party_details_min_t">
		<xs:annotation>
			<xs:documentation>блок информации о лице, которому открыт (открывается) счет</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="shareholder_dtls" nillable="false" minOccurs="0">
				<xs:annotation>
					<xs:documentation>характеристики  лица</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:choice>
							<xs:element name="individual" type="individual_person_t">
								<xs:annotation>
									<xs:documentation>Физическое лицо</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="org" type="organisation_t">
								<xs:annotation>
									<xs:documentation>Юридическое лицо</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:choice>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="shareholder_contacts" type="party_contacts_t" nillable="false" minOccurs="0">
				<xs:annotation>
					<xs:documentation>контактная информация (номера телефонов, факс)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="tax_status_code" type="tax_status_et">
				<xs:annotation>
					<xs:documentation>Код статуса налогоплательщика</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="letter_go_type" type="letter_go_type_et" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Способ получения информации</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="cash_settlement_dtls" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>денежные расчеты (банковские реквизиты)</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="bank_prop_rub" type="bank_prop_rub_t" nillable="true">
							<xs:annotation>
								<xs:documentation>реквизиты для денежных расчетов</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="qualified_investor" type="qualified_investor_et" minOccurs="0">
				<xs:annotation>
					<xs:documentation>квалицифированный инвестор</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="party_details_t">
		<xs:annotation>
			<xs:documentation>блок информации о лице, которому открыт (открывается) счет</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="shareholder_dtls" nillable="false" minOccurs="0">
				<xs:annotation>
					<xs:documentation>характеристики  лица</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:choice>
							<xs:element name="individual" type="individual_person_t">
								<xs:annotation>
									<xs:documentation>Физическое лицо</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="org" type="organisation_t">
								<xs:annotation>
									<xs:documentation>Юридическое лицо</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:choice>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="shareholder_contacts" type="party_contacts_t" nillable="false" minOccurs="0">
				<xs:annotation>
					<xs:documentation>контактная информация (номера телефонов, факс)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="tax_info" type="tax_category_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>сведения о налогообложении</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:choice minOccurs="0">
				<xs:element name="letter_go_type_N" minOccurs="0">
					<xs:complexType>
						<xs:sequence minOccurs="0">
							<xs:element name="letter_go_type" type="letter_go_type_et" minOccurs="0" maxOccurs="unbounded"/>
						</xs:sequence>
					</xs:complexType>
					<xs:unique name="letter_go_type_N_unique">
						<xs:selector xpath="letter_go_type"/>
						<xs:field xpath="."/>
					</xs:unique>
				</xs:element>
				<xs:element name="letter_go_type" type="letter_go_type_et" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Способ получения информации</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:choice>
			<xs:element name="cash_settlement_dtls" minOccurs="0">
				<xs:annotation>
					<xs:documentation>денежные расчеты (банковские реквизиты)</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="cash_settlement_dtl" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>денежные расчеты (банковские реквизиты)</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="cash_settlement_type" type="cash_settlement_type_et" nillable="true">
										<xs:annotation>
											<xs:documentation>тип денежных расчетов (банковских реквизитов)</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="bank_prop_rub" type="bank_prop_rub_t" nillable="true">
										<xs:annotation>
											<xs:documentation>реквизиты для денежных расчетов</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="qualified_investor" type="qualified_investor_et" minOccurs="0">
				<xs:annotation>
					<xs:documentation>квалицифированный инвестор</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="letter_basis_doc" type="yes_no_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Документы, являющиеся основанием для совершения операций в реестре, могут быть предоставлены Регистратору почтовым отправлением</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="party_dtls_contacts_t">
		<xs:annotation>
			<xs:documentation>характеристики стороны с контактами</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="party_dtls" type="party_details_t">
				<xs:annotation>
					<xs:documentation>характеристики стороны</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="contacts" type="party_contacts_t">
				<xs:annotation>
					<xs:documentation>контактная информация</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="party_id_name_t">
		<xs:annotation>
			<xs:documentation>краткая идентификация и наименование стороны</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ids">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="id" type="id_type_t" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>идентификация стороны</xs:documentation>
								<!-- ===================================================
(повторяющийся элемент)
=================================================== -->
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="name" type="text_t">
				<xs:annotation>
					<xs:documentation>наименование стороны</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="party_identification_t">
		<xs:annotation>
			<xs:documentation>идентификационная информация лица</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ids" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="id" type="id_type_t" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Регистрационные данные </xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="name" type="text_t">
				<xs:annotation>
					<xs:documentation>наименование</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="postal_address" type="address_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>почтовый адрес</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="party_contacts" type="party_contacts_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>контактная информация</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="e_mail" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>электронная почта</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="phone_t">
		<xs:annotation>
			<xs:documentation>номер телефона</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="phone_num" type="text_t">
				<xs:annotation>
					<xs:documentation>не структурированный номер телефона</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="phone_type" type="phone_type_et" minOccurs="0">
				<xs:annotation>
					<xs:documentation>код типа номера телефона</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<!-- ============================================================================================= -->
	</xs:complexType>
	<xs:complexType name="processing_dtls_v03_t">
		<xs:annotation>
			<xs:documentation>информация об обработке документа версия 3</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="doc_link" type="doc_link_t">
				<xs:annotation>
					<xs:documentation>Ссылка на документ</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="processing_info">
				<xs:annotation>
					<xs:documentation>Данные об обработке документа</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:annotation>
							<xs:documentation>может отсутствовать при отказе</xs:documentation>
						</xs:annotation>
						<xs:element name="operation_name" type="text_t">
							<xs:annotation>
								<xs:documentation>Наименование операции</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="processing_datetime" type="date_or_datetime_t">
							<xs:annotation>
								<xs:documentation>Дата обработки документа/ дата операции/ дата внесения записи в реестр</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="processing_reference" type="text_t">
							<xs:annotation>
								<xs:documentation>номер документа /номер операции/ номер внесения записи в реестр</xs:documentation>
								<!-- ===================================================
Референс обработки документа /номер операции/ номер внесения записи в реестр
=================================================== -->
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="processing_dtls_V2_t">
		<xs:annotation>
			<xs:documentation>информация об обработке документа</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="doc_link" type="doc_link_t" nillable="false" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Ссылка на инициирующий документ</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="transaction" type="transaction_V2_t" nillable="false">
				<xs:annotation>
					<xs:documentation>описание/ информация о сделке</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="processing_info" nillable="true" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Данные об обработке документа - может отсутствовать при отказе</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:annotation>
							<xs:documentation>может отсутствовать при отказе</xs:documentation>
						</xs:annotation>
						<xs:element name="operation_name" nillable="true">
							<xs:annotation>
								<xs:documentation>Наименование операции</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="text_t">
									<xs:minLength value="1"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="processing_datetime" type="date_or_datetime_t" nillable="false">
							<xs:annotation>
								<xs:documentation>Дата обработки документа/ дата операции/ дата внесения записи в реестр</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="processing_reference" nillable="false">
							<xs:annotation>
								<xs:documentation>документа /номер операции/ номер внесения записи в реестр</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="text_t">
									<xs:minLength value="1"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="quantity_in_unit_t" mixed="true">
		<xs:annotation>
			<xs:documentation>количество ценных бумаг в штуках</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="units" type="decimal_t">
				<xs:annotation>
					<xs:documentation>Целая часть и десятичная дробь. При наличии fraction - только целое</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="fraction" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Дробная часть (подблок). Заполняется только в случае простой дроби. В случае десятичной дроби не заполняется</xs:documentation>
					<!-- ===================================================
Заполняется только в случае простой дроби
В случае десятичной дроби не заполняется
=================================================== -->
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="numerator" type="number_t">
							<xs:annotation>
								<xs:documentation>Числитель</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="denominator" type="number_t">
							<xs:annotation>
								<xs:documentation>Знаменатель</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="security_info_t">
		<xs:annotation>
			<xs:documentation>информация о ценной бумаге</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="security_classification" type="security_classification_et">
				<xs:annotation>
					<xs:documentation>Вид ценной бумаги</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="security_classification_CFI" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Код вида ценной бумаги (CFI)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="financial_instrument_type" type="financial_instrument_type_et" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Код вида финансового инструмента</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="security_category" type="security_category_et" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Категория ценной бумаги по предоставляемым правам</xs:documentation>
					<!-- ===================================================
Заполняется только в случае, если вид ценной бумаги – SHAR –Акция
=================================================== -->
				</xs:annotation>
			</xs:element>
			<xs:element name="security_type" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Тип ценной бумаги</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="nominal_value" type="currency_and_amount_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Номинал</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="state_reg_num">
				<xs:annotation>
					<xs:documentation>Государственный регистрационный номер, номер правил ДУ ПиФ</xs:documentation>
					<!-- ===================================================
Если регистратор ведет учет нескольких выпусков с  одним государственным регистрационным номером в разрезе отдельных выпусков (по дате регистрации), рекомендуется в обязательном порядке указывать дату государственной регистрации
=================================================== -->
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="text_t">
						<xs:maxLength value="20"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="state_reg_date" type="date_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Дата государственной регистрации</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ISIN_identifier" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Код ISIN ценной бумаги</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="proprietary_security_code" type="id_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Частный идентификационный код ценной бумаги</xs:documentation>
					<!-- ===================================================
Зарезервировано для последующего использования
=================================================== -->
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="statement_date_dtls_t">
		<xs:annotation>
			<xs:documentation>ВременнЫе характеристики отчета (расчета)</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:choice>
				<xs:element name="statement_date" type="date_or_datetime_t">
					<xs:annotation>
						<xs:documentation>Дата, на которую составляется отчет (расчет)</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="period">
					<xs:annotation>
						<xs:documentation>Период, за который предоставляется отчет (расчет)</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="start_date" type="date_or_datetime_t">
								<xs:annotation>
									<xs:documentation>Начало отчетного периода</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="end_date" type="date_or_datetime_t">
								<xs:annotation>
									<xs:documentation>Конец отчетного периода</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="tax_category_t">
		<xs:annotation>
			<xs:documentation>статус налогоплательщика</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="nonresident_type" type="nonresident_type_et" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Тип нерезидента (юридического лица)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="tax_exempt_indicator" type="yes_no_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Признак наличия налоговой льготы</xs:documentation>
					<!-- ===================================================
Yes – в случае наличия льготы
No – при отсутствии льготы.
=================================================== -->
				</xs:annotation>
			</xs:element>
			<xs:element name="narrative" type="text_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Основание для налоговой льготы. </xs:documentation>
					<!-- ===================================================
Возможно указание наименования  ПиФа, № лицензии управляющей компании, даты выдачи, органа, выдавшего лицензию. 
Для иностранных банков могут быть указаны идентифицирующие сведения из общедоступных источников
================================================== -->
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:complexType name="transaction_V2_t">
		<xs:annotation>
			<xs:documentation>описание/ информация о сделке/ операции - для использования в передаточном в реестр ИП ПИФ и в уведомлениях и справках из реестра ИП ПИФ</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="security" type="security_info_t" nillable="false" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Ценная бумага</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="quantity" type="quantity_in_unit_t" nillable="false">
				<xs:annotation>
					<xs:documentation>Количество ценных бумаг</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="block_info" type="yes_no_t" nillable="false" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Указание на наличие обременения</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="settlement_amount" type="currency_and_amount_t" nillable="true" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Сумма сделки</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="increase_or_discount_amount" type="currency_and_amount_t" nillable="true" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Сумма надбавки или скидки</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="tax_amount" type="currency_and_amount_t" nillable="true" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Сумма налога на доходы клиента</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="contragent" type="party_details_t" minOccurs="0">
				<xs:annotation>
					<xs:documentation>информация о контрагенте</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="transaction_type" type="transaction_type_et" minOccurs="0">
				<xs:annotation>
					<xs:documentation>тип операции</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:annotation>
		<xs:documentation>Типы данных</xs:documentation>
	</xs:annotation>
	<xs:simpleType name="date_t">
		<xs:annotation>
			<xs:documentation>дата; при отсутствии реальных данных необходимо указывать следующее значение:1900-01-01</xs:documentation>
			<!-- ========================================================================
YYYY-MM-DD - При отсутствии реальных данных необходимо указывать следующее значение:
1900-01-01
=========================================================================== -->
		</xs:annotation>
		<xs:restriction base="xs:date"/>
		<!-- =========================================================================================== -->
	</xs:simpleType>
	<xs:complexType name="date_or_datetime_t">
		<xs:annotation>
			<xs:documentation>дата или дата и время. </xs:documentation>
		</xs:annotation>
		<!-- =========================================================================================== -->
	</xs:complexType>
	<xs:simpleType name="decimal_t">
		<xs:annotation>
			<xs:documentation>десятичное число (18,16); при отсутствии реальных данных необходимо указывать следующее значение: 00.00</xs:documentation>
			<!-- ========================================================================
При отсутствии реальных данных необходимо указывать следующее значение:
00.00
=========================================================================== -->
		</xs:annotation>
		<xs:restriction base="xs:decimal"/>
		<!-- =========================================================================================== -->
	</xs:simpleType>
	<xs:simpleType name="number_t">
		<xs:annotation>
			<xs:documentation>целое число; при отсутствии реальных данных необходимо указывать следующее значение: 00</xs:documentation>
			<!-- ========================================================================
При отсутствии реальных данных необходимо указывать следующее значение:
00
=========================================================================== -->
		</xs:annotation>
		<xs:restriction base="xs:decimal"/>
		<!-- =========================================================================================== -->
	</xs:simpleType>
	<xs:simpleType name="datetime_t">
		<xs:annotation>
			<xs:documentation>дата и время; при отсутствии реальных данных необходимо указывать следующее значение: 1900-01-01T00:00:00</xs:documentation>
			<!-- ========================================================================
YYYY-MM-DDThh:mm:ss - При отсутствии реальных данных необходимо указывать следующее значение:
1900-01-01T00:00:00
=========================================================================== -->
		</xs:annotation>
		<xs:restriction base="xs:dateTime"/>
		<!-- =========================================================================================== -->
	</xs:simpleType>
	<xs:simpleType name="text_t">
		<xs:annotation>
			<xs:documentation>произвольная строка текста; при отсутствии реальных данных необходимо указывать следующее значение: UKWN</xs:documentation>
			<!-- ========================================================================
При отсутствии реальных данных необходимо указывать следующее значение:
UKWN
=========================================================================== -->
		</xs:annotation>
		<xs:restriction base="xs:string"/>
		<!-- =========================================================================================== -->
	</xs:simpleType>
	<xs:simpleType name="yes_no_t">
		<xs:annotation>
			<xs:documentation>признак "Да" (Yes)/ "Нет" (No)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="Yes">
				<xs:annotation>
					<xs:documentation>Yes - Да</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="No">
				<xs:annotation>
					<xs:documentation>No - Нет</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
		<!-- =========================================================================================== -->
	</xs:simpleType>
	<xs:annotation>
		<xs:documentation>Перечисления и справочники</xs:documentation>
	</xs:annotation>
	<xs:simpleType name="account_innstruction_type_et">
		<xs:annotation>
			<xs:documentation>назначение распоряжения по счету</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="ACCO">
				<xs:annotation>
					<xs:documentation>открытие счета</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ACCM">
				<xs:annotation>
					<xs:documentation>внесение изменений в информацию (содержание) счета</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GACC">
				<xs:annotation>
					<xs:documentation>получение деталей счета (НЕ выписка)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ACMC">
				<xs:annotation>
					<xs:documentation>изменение вида счета с НД на НДЦД</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ACMN">
				<xs:annotation>
					<xs:documentation>изменение вида счета с НДЦД на НД</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CLSD">
				<xs:annotation>
					<xs:documentation>закрытие счета</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="account_own_et">
		<xs:annotation>
			<xs:documentation>владение паями</xs:documentation>
		</xs:annotation>
		<xs:restriction base="text_t">
			<xs:enumeration value="1">
				<xs:annotation>
					<xs:documentation>не является долевой или совместной</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="2">
				<xs:annotation>
					<xs:documentation>на праве общей долевой собственности</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="3">
				<xs:annotation>
					<xs:documentation>на праве совместной собственности</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
		<!-- =========================================================================================== -->
	</xs:simpleType>
