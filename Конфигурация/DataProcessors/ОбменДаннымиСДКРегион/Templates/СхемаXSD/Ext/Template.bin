<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2013 rel. 2 sp2 (http://www.altova.com) by Dmitry Strelkov (Depository company REGION) -->
<xs:schema targetNamespace="http://www.it.ru/Schemas/Avior/DK" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.it.ru/Schemas/Avior/DK" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:annotation>
		<xs:documentation>Документы взаимодействия спецдепозитария ДК "Регион" и УК (агента)</xs:documentation>
	</xs:annotation>
	<xs:element name="ACCOUNT_MODIFICATION_INSTRUCTION">
		<xs:annotation>
			<xs:documentation>Заявление на  открытие/изменение лицевого счета зарегистрированного лица</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="out_doc_t">
					<xs:sequence>
						<xs:element name="document_code" type="text_t" fixed="DKRI_01">
							<xs:annotation>
								<xs:documentation>Идентификатор типа документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="message_type" type="account_innstruction_type_et" nillable="false">
							<xs:annotation>
								<xs:documentation>Цель подачи распоряжения.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="managment_company" type="party_id_name_t" nillable="true">
							<xs:annotation>
								<xs:documentation>Идентификатор УК, например, ОГРН (id_type = OGRN);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="investment_fund" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Описание фонда, номер правил доверительного управления паевого инвестиционного фонда; (id_type = TMRL);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="agent" type="party_id_name_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Идентификатор агента, если заявление поступает от него</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="account_id" type="account_dtls_v02_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>информация о счете. Номер счета обязательно заполняется. При отсутствии значения номера счета (при открытии счета в реестре) указывается UKWN</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="shareholder_id" type="party_identification_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Идентификатор лица для пайщиков, которым уже открыт счет</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="shareholder_info" type="party_details_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>анкета (сведения о лице)</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="operation_notify" type="yes_no_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Уведомлять об операции</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="consent_to_the_processing_of_personal_data" type="text_t" fixed="Настоящим своей волей и в своих интересах даю согласие на обработку Регистратором АО «Депозитарная компания «РЕГИОН» (119049, г. Москва, вн. тер. г. муниципальный округ Якиманка, ул. Крымский вал, д. 3, стр. 2, Антресоль 3, помещ. I, ком. 32-57) всех моих персональных данных (персональных данных зарегистрированного лица, в случае если согласие дается законным представителем), указанных в настоящей анкете. Согласие дается для целей открытия и дальнейшего обслуживания лицевого счета, надлежащего исполнения Регистратором обязанностей по ведению реестра владельцев инвестиционных паев, установленных законодательством Российской Федерации. В целях сбора документов, необходимых для совершения операций в реестре, передачи мне информации из реестра даю свое согласие Регистратору поручить обработку персональных данных, содержащихся в настоящей анкете Управляющей компании паевого инвестиционного фонда, инвестиционные паи которого мной приобретаются. Обработка персональных данных осуществляется Регистратором в объеме, необходимом для достижения вышеперечисленных целей, включая сбор, запись, систематизацию, использование, накопление, хранение, уточнение (обновление, изменение), уничтожение, удаление, блокирование, обезличивание, передачу (предоставление) персональных данных. Регистратор вправе осуществлять передачу моих персональных данных иным лицам, имеющим право получать такие сведения в соответствии с законодательством Российской Федерации, в составе запрашиваемых сведений. Обработка персональных данных осуществляется с соблюдением требований законодательства Российской Федерации следующими способами: с применением средств автоматизации и без применения средств автоматизации. Данное согласие действует на период до достижения целей обработки персональных данных или до истечения сроков хранения соответствующей информации и/или документов, содержащих указанную информацию, определяемых в соответствии с законодательством Российской Федерации. Настоящим подтверждается, что настоящее согласие может быть отозвано путем предоставления Регистратору соответствующего заявления в письменной форме. В случае отзыва согласия на обработку своих персональных данных, Регистратор вправе не прекращать обработку персональных данных и не уничтожать их в случаях, предусмотренных законодательством Российской Федерации, в том числе если установленные законодательство Российской Федерации сроки хранения персональных данных не истекли." minOccurs="0">
							<xs:annotation>
								<xs:documentation>Согласие на обработку персональных данных зарегистрированного физического лица</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="sign_info" type="text_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Информация о подписи</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="add_info" type="info_list_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Дополнительная информация</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="ACCOUNT_DETAILS_CONFIRMATION">
		<xs:annotation>
			<xs:documentation>Уведомление об открытии/ об изменении информации лицевого счета/ Уведомление об изменении статуса (вида) лицевого счета </xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="answer_doc_t">
					<xs:sequence>
						<xs:element name="document_code" type="text_t" fixed="DKRA_02">
							<xs:annotation>
								<xs:documentation>Идентификатор типа документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="message_type" type="account_innstruction_type_et" nillable="false">
							<xs:annotation>
								<xs:documentation>Тип уведомления. ACCO (открытие ЛС); ACCM (внесение изменений в информацию лицевого счета).</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="registrar" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Данные о регистраторе; • основной государственный регистрационный номер и дата его присвоения;
• идентификационный номер налогоплательщика;
</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="managment_company" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Идентификатор УК, например, ОГРН (id_type = OGRN);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="investment_fund" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Описание фонда, номер правил доверительного управления паевого инвестиционного фонда; (id_type = TMRL);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="agent" type="party_id_name_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Идентификатор агента, если заявление поступает от него</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="account_id" type="account_dtls_v03_t">
							<xs:annotation>
								<xs:documentation>информация о счете. Номер счета обязательно заполняется.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="shareholder_id" type="party_identification_t">
							<xs:annotation>
								<xs:documentation>информация о зарегистрированном лице (по которому предоставляется распоряжение)</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="processing_info">
							<xs:annotation>
								<xs:documentation>тип, дата, время проведенной операции;</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="operation_name" type="text_t">
										<xs:annotation>
											<xs:documentation>Наименование операции</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="processing_datetime" type="datetime_t">
										<xs:annotation>
											<xs:documentation>Дата обработки документа/ дата операции/ дата внесения записи в реестр</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="processing_reference" type="text_t">
										<xs:annotation>
											<xs:documentation>номер документа /номер операции/ номер внесения записи в реестр</xs:documentation>
											<!-- ===================================================
Референс обработки документа /номер операции/ номер внесения записи в реестр
=================================================== -->
										</xs:annotation>
									</xs:element>
									<xs:element name="changes" minOccurs="0">
										<xs:annotation>
											<xs:documentation>список изменений</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="change" maxOccurs="unbounded">
													<xs:complexType>
														<xs:sequence>
															<xs:element name="change_position" type="text_t">
																<xs:annotation>
																	<xs:documentation>измененная позиция</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="change_info_old" type="text_t">
																<xs:annotation>
																	<xs:documentation>старое значение</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="change_info_new" type="text_t">
																<xs:annotation>
																	<xs:documentation>новое значение</xs:documentation>
																</xs:annotation>
															</xs:element>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="reason_operation">
							<xs:annotation>
								<xs:documentation>основание операции</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="doc" type="doc_link_t" maxOccurs="unbounded"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="managers" type="manager_dtls_t">
							<xs:annotation>
								<xs:documentation>Уполномоченные лица регистратора</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="report_date" type="date_t">
							<xs:annotation>
								<xs:documentation>дата отчета</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="add_info" type="info_list_t" nillable="true" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Дополнительная информация</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="ACCOUNT_DETAILS_REFUSE">
		<xs:annotation>
			<xs:documentation>Уведомление об отказе в  открытии/ об изменении информации лицевого счета/ Уведомление об изменении статуса (вида) лицевого счета </xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="answer_doc_t">
					<xs:sequence>
						<xs:element name="document_code" type="text_t" fixed="DKRA_08">
							<xs:annotation>
								<xs:documentation>Идентификатор типа документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="message_type" type="account_innstruction_type_et" nillable="false">
							<xs:annotation>
								<xs:documentation>Тип уведомления. ACCO (открытие ЛС); ACCM (внесение изменений в информацию лицевого счета).</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="registrar" type="party_identification_t">
							<xs:annotation>
								<xs:documentation>Данные о регистраторе; • основной государственный регистрационный номер и дата его присвоения;
• идентификационный номер налогоплательщика;
</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="managment_company" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Идентификатор УК, например, ОГРН (id_type = OGRN);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="investment_fund" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Описание фонда, номер правил доверительного управления паевого инвестиционного фонда; (id_type = TMRL);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="agent" type="party_id_name_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Идентификатор агента, если заявление поступает от него</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="account_id" type="account_dtls_v03_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>информация о счете. Номер счета обязательно заполняется.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="shareholder_id" type="party_identification_t">
							<xs:annotation>
								<xs:documentation>информация о зарегистрированном лице (по которому предоставляется распоряжение)</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="processing_info">
							<xs:annotation>
								<xs:documentation>тип, дата, время проведенной операции;</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="operation_name" type="text_t">
										<xs:annotation>
											<xs:documentation>Наименование операции</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="processing_datetime" type="date_or_datetime_t">
										<xs:annotation>
											<xs:documentation>Дата обработки документа/ дата операции/ дата внесения записи в реестр</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="processing_reference" type="text_t">
										<xs:annotation>
											<xs:documentation>номер документа /номер операции/ номер внесения записи в реестр</xs:documentation>
											<!-- ===================================================
Референс обработки документа /номер операции/ номер внесения записи в реестр
=================================================== -->
										</xs:annotation>
									</xs:element>
									<xs:element name="description_refuse" type="text_t">
										<xs:annotation>
											<xs:documentation>описание причины отказа</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="action" minOccurs="0">
										<xs:annotation>
											<xs:documentation>рекомендуемые действия</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="managers" type="manager_dtls_t">
							<xs:annotation>
								<xs:documentation>Уполномоченные лица регистратора</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="report_date" type="date_t">
							<xs:annotation>
								<xs:documentation>дата отчета</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="add_info" type="info_list_t" nillable="true" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Дополнительная информация</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="ORDER_TO_SHARE_ACQUISITION">
		<xs:annotation>
			<xs:documentation>Заявка на приобретение паев</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="out_doc_t">
					<xs:sequence>
						<xs:element name="document_code" type="text_t" fixed="DKRI_02">
							<xs:annotation>
								<xs:documentation>Идентификатор типа документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="managment_company" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Идентификатор УК, например, ОГРН (id_type = OGRN);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="investment_fund" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Описание фонда, номер правил доверительного управления паевого инвестиционного фонда; (id_type = TMRL);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="agent" type="party_id_name_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Идентификатор агента, если заявление поступает от него</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="shareholder_id" type="party_identification_t">
							<xs:annotation>
								<xs:documentation>идентификатор пайщика</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="owner_info" type="party_details_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>сведения о владельце инвестиционных паев, обязательно указываются в случае указания типа счета "номинальный держатель" в блоке сведений о лице-заявителе</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="bank_prop_rub" type="bank_prop_rub_t" nillable="true">
							<xs:annotation>
								<xs:documentation>реквизиты для денежных расчетов</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="instruction_type" type="aquisition_instruction_et" nillable="false">
							<xs:annotation>
								<xs:documentation>Тип заявки: многоразовая или однократная</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="receive_date_time" type="datetime_t">
							<xs:annotation>
								<xs:documentation>дата и время приема заявки</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="amount" type="currency_and_amount_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Сумма денежных средств, на которую необходимо выдать инвестиционные паи, обязательно при однократной заявке</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="sign_info" type="text_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Информация о подписи</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="depository_info" type="text_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>информация о депозитарии и счете депо</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="add_info" type="info_list_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Дополнительная информация</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="ORDER_TO_SHARE_REDEMPTION">
		<xs:annotation>
			<xs:documentation>Заявка на погашение паев</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="out_doc_t">
					<xs:sequence>
						<xs:element name="document_code" type="text_t" fixed="DKRI_04">
							<xs:annotation>
								<xs:documentation>Идентификатор типа документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="managment_company" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Идентификатор УК, например, ОГРН (id_type = OGRN);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="investment_fund" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Описание фонда, номер правил доверительного управления паевого инвестиционного фонда; (id_type = TMRL);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="agent" type="party_id_name_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Идентификатор агента, если заявление поступает от него</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="shareholder_id" type="party_identification_t">
							<xs:annotation>
								<xs:documentation>идентификатор пайщика</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="owner_info" type="party_details_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>сведения о владельце инвестиционных паев, обязательно указываются в случае указания типа счета "номинальный держатель" в блоке сведений о лице-заявителе</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="unit_quantity" type="quantity_in_unit_t">
							<xs:annotation>
								<xs:documentation>количество паев</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="bank_prop_rub" type="bank_prop_rub_t" nillable="true">
							<xs:annotation>
								<xs:documentation>реквизиты для денежных расчетов</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="receive_date_time" type="datetime_t">
							<xs:annotation>
								<xs:documentation>дата приема заявки</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="sign_info" type="text_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Информация о подписи</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="depository_info" type="text_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>информация о депозитарии и счете депо</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="add_info" type="info_list_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Дополнительная информация</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
