							</xs:annotation>
						</xs:element>
						<xs:element name="bank_prop_rub" type="bank_prop_rub_t" nillable="true" minOccurs="0">
							<xs:annotation>
								<xs:documentation>реквизиты для денежных расчетов</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="receive_date_time" type="datetime_t">
							<xs:annotation>
								<xs:documentation>дата приема заявки</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="sign_info" type="text_t" minOccurs="0">
