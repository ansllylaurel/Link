	<xs:element name="ORDER_TO_SHARE_COPY_ACCOUNT">
		<xs:annotation>
			<xs:documentation>Копирование информации о пайщиках из другого ПИФа с открытием счетов</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="out_doc_t">
					<xs:sequence>
						<xs:element name="document_code" type="text_t" fixed="DKRI_06">
							<xs:annotation>
								<xs:documentation>Идентификатор типа документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="document_type" type="document_type_et">
							<xs:annotation>
								<xs:documentation>типа документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="fix_date" type="date_t">
							<xs:annotation>
								<xs:documentation>дата, на которую составлен список</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="basis_doc" minOccurs="0">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="basis_doc_num" type="text_t"/>
									<xs:element name="basis_doc_date" type="date_t"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="managment_company" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Идентификатор УК, например, ОГРН (id_type = OGRN);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="investment_fund" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Описание фонда (погашение), номер правил доверительного управления паевого инвестиционного фонда; (id_type = TMRL);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="investment_fund_dest" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Описание фонда (преобретение), номер правил доверительного управления паевого инвестиционного фонда; (id_type = TMRL);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:choice>
							<xs:element name="shareholder_list">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="shareholder" maxOccurs="unbounded">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="shareholder_id" type="party_identification_t">
														<xs:annotation>
															<xs:documentation>идентификатор пайщика</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="QuantityPieIn" type="decimal_t" minOccurs="0"/>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="shareholder_list_special" type="shareholder_list_special_et"/>
						</xs:choice>
						<xs:element name="add_info" type="info_list_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Дополнительная информация</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="SERVICE_ACQUISITION">
		<xs:annotation>
			<xs:documentation>Зачисление паев (служебный документ)</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="out_doc_t">
					<xs:sequence>
						<xs:element name="fix_date" type="date_t">
							<xs:annotation>
								<xs:documentation>дата, на которую составлен список</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="basis_doc_main_id"/>
						<xs:element name="investment_fund_reg_number" type="text_t"/>
						<xs:element name="investment_fund_reg_number_dest" type="text_t"/>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="SERVICE_PARTREDEMPTION">
		<xs:annotation>
			<xs:documentation>Частичное погашение (служебный документ)</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="out_doc_t">
					<xs:sequence>
						<xs:element name="fix_date" type="date_t"/>
						<xs:element name="basis_doc_main_id" type="text_t"/>
						<xs:element name="investment_fund_reg_number" type="text_t"/>
						<xs:element name="percent_redemption_pie" type="decimal_t"/>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="SERVICE_BLOCK">
		<xs:annotation>
			<xs:documentation>Блокировка паев (служебный документ)</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="out_doc_t">
					<xs:sequence>
						<xs:element name="basis_doc_main_id"/>
						<xs:element name="investment_fund_reg_number" type="text_t"/>
						<xs:element name="percent_block_pie" type="decimal_t"/>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="SERVICE_UNBLOCK">
		<xs:annotation>
			<xs:documentation>Разблокировка паев (служебный документ)</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="out_doc_t">
					<xs:sequence>
						<xs:element name="basis_doc_main_id"/>
						<xs:element name="investment_fund_reg_number" type="text_t"/>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="SERVICE_COMMON_OPERATION">
		<xs:annotation>
			<xs:documentation>Общие операции (служебный документ)</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="out_doc_t">
					<xs:sequence>
						<xs:element name="basis_doc_main_id" type="text_t"/>
						<xs:element name="fix_date" type="xs:date" minOccurs="0"/>
						<xs:element name="investment_fund_reg_number" type="text_t"/>
						<xs:element name="OperationOutInfo" minOccurs="0">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="OperationDirID" type="xs:int"/>
									<xs:element name="OperationDescriptionID" type="xs:int"/>
									<xs:element name="DivisionTypeCode" type="xs:string"/>
									<xs:element name="DivisionCode" type="xs:string" minOccurs="0"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="OperationInInfo" minOccurs="0">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="OperationDirID" type="xs:int"/>
									<xs:element name="OperationDescriptionID" type="xs:int"/>
									<xs:element name="DivisionTypeCode" type="xs:string"/>
									<xs:element name="DivisionCode" type="xs:string" minOccurs="0"/>
									<xs:element name="DivisionComment" type="xs:string" minOccurs="0"/>
									<xs:element name="DivisionBasis" type="xs:string" minOccurs="0"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="OperationList">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Operation" maxOccurs="unbounded">
										<xs:complexType>
											<xs:sequence>
												<xs:element name="OperationOut" minOccurs="0">
													<xs:complexType>
														<xs:sequence>
															<xs:element name="SubLedgerNumber" type="xs:string"/>
															<xs:element name="Quantity" type="xs:decimal"/>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
												<xs:element name="OperationIn" minOccurs="0">
													<xs:complexType>
														<xs:sequence>
															<xs:element name="SubLedgerNumber" type="xs:string"/>
															<xs:element name="Quantity" type="xs:decimal"/>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="STATEMENT_OF_PAYMENT_ACCOUNT">
		<xs:annotation>
			<xs:documentation>Уведомление о переводе активов на расчетный счет или транзитный счет УК</xs:documentation>
			<!-- =========================================================================================== -->
			<!-- =========================================================================================== -->
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="out_doc_t">
					<xs:sequence>
						<xs:element name="document_code" type="text_t" fixed="DKRI_03">
							<xs:annotation>
								<xs:documentation>Идентификатор типа документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="managment_company" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Идентификатор УК, например, ОГРН (id_type = OGRN);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="investment_fund" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Описание фонда, номер правил доверительного управления паевого инвестиционного фонда; (id_type = TMRL);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="agent" type="party_id_name_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Идентификатор агента, если заявление поступает от него</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="shareholder_id" type="party_identification_t">
							<xs:annotation>
								<xs:documentation>Идентификатор лица для пайщиков, которым уже открыт счет</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="statement_type" type="payment_statement_type_et">
							<xs:annotation>
								<xs:documentation>Тип уведомления : уведомление о переводе на транзитный или расчетный счет
</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="orders">
							<xs:annotation>
								<xs:documentation>сведения о платежных поручениях</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="order" type="order_t" nillable="false" maxOccurs="unbounded">
										<xs:annotation>
											<xs:documentation>сведения о платежных поручениях</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="application_info" type="doc_link_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Заявка на приобретение паев, по которой производится перевод активов</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="depository_info" type="text_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>информация о депозитарии и счете депо</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="add_info" type="info_list_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Дополнительная информация</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
		<!-- =========================================================================================== -->
		<!-- =========================================================================================== -->
	</xs:element>
	<xs:element name="STATEMENT_OF_PAYMENTMANY_ACCOUNT">
		<xs:annotation>
			<xs:documentation>Уведомление о переводе активов на расчетный счет или транзитный счет УК</xs:documentation>
			<!-- =========================================================================================== -->
			<!-- =========================================================================================== -->
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="out_doc_t">
					<xs:sequence>
						<xs:element name="document_code" type="text_t" fixed="DKRI_03">
							<xs:annotation>
								<xs:documentation>Идентификатор типа документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="managment_company" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Идентификатор УК, например, ОГРН (id_type = OGRN);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="investment_fund" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Описание фонда, номер правил доверительного управления паевого инвестиционного фонда; (id_type = TMRL);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="agent" type="party_id_name_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Идентификатор агента, если заявление поступает от него</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="statement_type" type="payment_statement_type_et">
							<xs:annotation>
								<xs:documentation>Тип уведомления : уведомление о переводе на транзитный или расчетный счет
</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="orders">
							<xs:annotation>
								<xs:documentation>сведения о платежных поручениях</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="order" type="order_many_t" nillable="false" maxOccurs="unbounded">
										<xs:annotation>
											<xs:documentation>сведения о платежных поручениях</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="depository_info" type="text_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>информация о депозитарии и счете депо</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="add_info" type="info_list_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Дополнительная информация</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
		<!-- =========================================================================================== -->
		<!-- =========================================================================================== -->
	</xs:element>
	<xs:element name="STATEMENT_OF_DELIVERY_ABILITY_SHARE">
		<xs:annotation>
			<xs:documentation>Отчет о возможности выдачи инвестиционных паев</xs:documentation>
			<!-- =========================================================================================== -->
			<!-- =========================================================================================== -->
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="answer_doc_t">
					<xs:sequence>
						<xs:element name="document_code" type="text_t" fixed="DKRA_03">
							<xs:annotation>
								<xs:documentation>Идентификатор типа документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="registrar" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Данные о депозитарии, специализированном депозитарии</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="managment_company" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Идентификатор УК, например, ОГРН (id_type = OGRN);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="investment_fund" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Описание фонда, номер правил доверительного управления паевого инвестиционного фонда; (id_type = TMRL);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="agent" type="party_id_name_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Идентификатор агента, если отчет представлен агенту</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="applications">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="application" maxOccurs="unbounded">
										<xs:complexType>
											<xs:sequence>
												<xs:element name="delivary_ability_share_doc" minOccurs="0">
													<xs:complexType>
														<xs:sequence>
															<xs:element name="doc_num" type="text_t">
																<xs:annotation>
																	<xs:documentation>исходящий номер ответного документа</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="doc_date" type="date_t">
																<xs:annotation>
																	<xs:documentation>дата создания ответного документа</xs:documentation>
																</xs:annotation>
															</xs:element>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
												<xs:element name="application_doc" type="doc_link_t">
													<xs:annotation>
														<xs:documentation>Заявка на приобретение паев, по которой производится перевод активов</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="shareholder_id" type="party_identification_t">
													<xs:annotation>
														<xs:documentation>Идентификационная информация зарегистрированного лица</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="account_id" type="account_dtls_v03_t">
													<xs:annotation>
														<xs:documentation>Лицевой счет зарегистрированного лица</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="orders">
													<xs:annotation>
														<xs:documentation>сведения о платежных поручениях</xs:documentation>
													</xs:annotation>
													<xs:complexType>
														<xs:sequence>
															<xs:element name="order" type="order_t" nillable="false" maxOccurs="unbounded">
																<xs:annotation>
																	<xs:documentation>сведения о платежных поручениях</xs:documentation>
																</xs:annotation>
															</xs:element>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
												<xs:element name="ability" type="yes_no_t">
													<xs:annotation>
														<xs:documentation>возможность выдачи инвестиционных паев по указанной заявке (да/нет)</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ability_refuse_description" type="text_t" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Описание отказа</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="managers" type="manager_dtls_t" nillable="true">
							<xs:annotation>
								<xs:documentation>Уполномоченные лица регистратора</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="report_datetime" type="datetime_t">
							<xs:annotation>
								<xs:documentation>дата и время уведомления</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="add_info" type="info_list_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Дополнительная информация</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="total_currency_and_amount" type="currency_and_amount_t" nillable="false" minOccurs="0">
							<xs:annotation>
								<xs:documentation>общая валюта и сумма платежа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="IsAggregated" type="yes_no_t" minOccurs="0"/>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
		<!-- =========================================================================================== -->
		<!-- =========================================================================================== -->
	</xs:element>
