							<xs:annotation>
								<xs:documentation>Уполномоченные лица регистратора</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="action_date" type="date_t">
							<xs:annotation>
								<xs:documentation>действие - дата приостановления / вознобновления</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="action_type" type="action_block_type_et">
							<xs:annotation>
								<xs:documentation>действие - Приостановление / Вознобновление</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="action_description" type="text_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>действие основание</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="report_datetime" type="datetime_t">
							<xs:annotation>
								<xs:documentation>дата и время уведомления</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="add_info" type="info_list_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Дополнительная информация</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
		<!-- =========================================================================================== -->
		<!-- =========================================================================================== -->
	</xs:element>
	<xs:element name="STATEMENT_OF_REFUSED_TRANSACTION">
		<xs:annotation>
			<xs:documentation>Уведомление об отказе в исполнении операции</xs:documentation>
			<!-- =========================================================================================== -->
			<!-- =========================================================================================== -->
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="answer_doc_t">
					<xs:sequence>
						<xs:element name="document_code" type="text_t" fixed="DKRA_10">
							<xs:annotation>
								<xs:documentation>Идентификатор типа документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="registrar" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Данные о депозитарии, специализированном депозитарии</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="managment_company" type="party_id_name_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Идентификатор УК, например, ОГРН (id_type = OGRN);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="investment_fund" type="party_id_name_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Описание фонда, номер правил доверительного управления паевого инвестиционного фонда; (id_type = TMRL);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="agent" type="party_id_name_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Идентификатор агента, если заявление поступает от него</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="shareholder_id" type="party_identification_t">
							<xs:annotation>
								<xs:documentation>Идентификационная информация зарегистрированного лица</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="account_id" type="account_dtls_v03_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Лицевой счет зарегистрированного лица</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="refuse_info">
							<xs:annotation>
								<xs:documentation>информация об отказе</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="reason_operation">
										<xs:annotation>
											<xs:documentation>основание операции</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="doc" type="doc_link_t" maxOccurs="unbounded"/>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="reason_refused" type="text_t">
										<xs:annotation>
											<xs:documentation>причина отказа</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="unit_quantity" type="quantity_in_unit_t" minOccurs="0">
										<xs:annotation>
											<xs:documentation>количество паев</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="recommendation" type="text_t">
										<xs:annotation>
											<xs:documentation>рекомендации</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="managers" type="manager_dtls_t" nillable="true">
							<xs:annotation>
								<xs:documentation>Уполномоченные лица регистратора</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="report_datetime" type="datetime_t">
							<xs:annotation>
								<xs:documentation>дата и время уведомления</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="add_info" type="info_list_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Дополнительная информация</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
		<!-- =========================================================================================== -->
		<!-- =========================================================================================== -->
	</xs:element>
	<xs:element name="AGENT_POINT_LIST">
		<xs:annotation>
			<xs:documentation>Список агентских пунктов</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="out_doc_t">
					<xs:sequence>
						<xs:element name="message_type" type="agent_point_instruction_type_et" nillable="false">
							<xs:annotation>
								<xs:documentation>Цель подачи распоряжения.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="managment_company" type="party_id_name_t" nillable="true">
							<xs:annotation>
								<xs:documentation>Идентификатор УК, например, ОГРН (id_type = OGRN);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="investment_fund" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Описание фонда, номер правил доверительного управления паевого инвестиционного фонда; (id_type = TMRL);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="agents">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="agent" maxOccurs="unbounded">
										<xs:complexType>
											<xs:sequence>
												<xs:element name="agent_company" type="party_id_name_t">
													<xs:annotation>
														<xs:documentation>агент</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="point_type" type="point_type_et">
													<xs:annotation>
														<xs:documentation>тип пункта</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="number" type="text_t">
													<xs:annotation>
														<xs:documentation>номер пункта</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="name" type="text_t">
													<xs:annotation>
														<xs:documentation>название пункта</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="address" type="text_t">
													<xs:annotation>
														<xs:documentation>адрес пункта</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="limit_sum_request_forming_value" type="decimal_t">
													<xs:annotation>
														<xs:documentation>Минимальная сумма заявки на период формирования</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="limit_sum_request_after_forming_first_value" type="decimal_t">
													<xs:annotation>
														<xs:documentation>Ограничение суммы первого платежа по заявке</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="limit_sum_request_after_forming_next_value" type="decimal_t">
													<xs:annotation>
														<xs:documentation>Ограничение суммы последующих платежей по заявке</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="REGISTRATION_JOURNAL_ENTRY">
		<xs:annotation>
			<xs:documentation>Запись в журнале регистрации</xs:documentation>
			<!-- =========================================================================================== -->
			<!-- =========================================================================================== -->
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="out_doc_t">
					<xs:sequence>
						<xs:element name="document_code" type="text_t" fixed="DKFI_00">
							<xs:annotation>
								<xs:documentation>Идентификатор типа документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="document_type" type="text_t">
							<xs:annotation>
								<xs:documentation>Наименование типа документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="managment_company" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Идентификатор УК для которой производится запись в журнале регистрации, например, ОГРН (id_type = OGRN);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="investment_fund" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Описание фонда, номер правил доверительного управления паевого инвестиционного фонда для которого производится запись в журнале регистрации; (id_type = TMRL);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="sender" type="party_id_name_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Идентификатор отправителя документа, например, ОГРН (id_type = OGRN); Если не заполнено, отправителем считается управляющая компания</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="text" type="text_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Текст сообщения (содержание документа)</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="add_info" type="info_list_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Дополнительная информация. Может использоваться для указания имен файлов вложений</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
		<!-- =========================================================================================== -->
		<!-- =========================================================================================== -->
	</xs:element>
	<xs:element name="REPORT_OF_EXECUTED_DAY_TRANSACTIONS">
		<xs:annotation>
			<xs:documentation>Отчет об исполненных операциях за день (преобретение/погашение/обмен паев)</xs:documentation>
			<!-- =========================================================================================== -->
			<!-- =========================================================================================== -->
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="answer_doc_t">
					<xs:sequence>
						<xs:element name="document_code" type="text_t" fixed="DKRA_05">
							<xs:annotation>
								<xs:documentation>Идентификатор типа документа</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="registrar" type="party_identification_t">
							<xs:annotation>
								<xs:documentation>Данные о депозитарии, специализированном депозитарии</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="managment_company" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Идентификатор УК, например, ОГРН (id_type = OGRN);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="investment_fund" type="party_id_name_t">
							<xs:annotation>
								<xs:documentation>Описание фонда, номер правил доверительного управления паевого инвестиционного фонда; (id_type = TMRL);</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="statement_date_begin" type="date_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Если эта дата указана, то она является датой начала периода, а statement_date становится датой окнчания периода.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="statement_date" type="date_t">
							<xs:annotation>
								<xs:documentation>Дата, на которую строится отчет</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="total_quantity_in" type="quantity_in_unit_t">
							<xs:annotation>
								<xs:documentation>входящий остаток</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="executed_transactions">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="executed_transaction" minOccurs="0" maxOccurs="unbounded">
										<xs:annotation>
											<xs:documentation>Исполненные транзакции</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="application_info" type="doc_link_t">
													<xs:annotation>
														<xs:documentation>Заявка на приобретение /погашение паев</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="account_dtls_v02" type="account_dtls_v02_t">
													<xs:annotation>
														<xs:documentation>информация о лицевом счете зарегистрированного лица (по которому предоставляется отчет)</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="shareholder_id" type="party_identification_t">
													<xs:annotation>
														<xs:documentation>информация о зарегистрированном лице (по которому предоставляется распоряжение)</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="operation_type" type="transaction_type_et">
													<xs:annotation>
														<xs:documentation>тип операции</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="unit_quantity" type="quantity_in_unit_t">
													<xs:annotation>
														<xs:documentation>количество паев</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="unit_cost" type="currency_and_amount_t">
													<xs:annotation>
														<xs:documentation>стоимость пая</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="unit_costNAV" type="currency_and_amount_t">
													<xs:annotation>
														<xs:documentation>расчетная стоимость пая</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="amount" type="currency_and_amount_t">
													<xs:annotation>
														<xs:documentation>сумма</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="premium_discount" type="currency_and_amount_t">
													<xs:annotation>
														<xs:documentation>общая сумма надбавки/скидки</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="reason_operation">
													<xs:annotation>
														<xs:documentation>основание операции</xs:documentation>
													</xs:annotation>
													<xs:complexType>
														<xs:sequence>
															<xs:element name="doc" type="doc_link_t" maxOccurs="unbounded"/>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
												<xs:element name="investment_fund_related" type="party_id_name_t" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Описание связанного фонда при обмене, номер правил доверительного управления паевого инвестиционного фонда; (id_type = TMRL);</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="total_quantity_out" type="quantity_in_unit_t">
							<xs:annotation>
								<xs:documentation>исходящий остаток</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="managers" type="manager_dtls_t" nillable="true">
							<xs:annotation>
								<xs:documentation>Уполномоченное лицо регистратора</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="add_info" type="info_list_t" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Дополнительная информация</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
		<!-- =========================================================================================== -->
		<!-- =========================================================================================== -->
	</xs:element>
