				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AGNT">
				<xs:annotation>
					<xs:documentation>У агента</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MNCP">
				<xs:annotation>
					<xs:documentation>У УК</xs:documentation>
