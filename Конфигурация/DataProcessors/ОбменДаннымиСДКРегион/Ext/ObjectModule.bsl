		|		КОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.Регистратор.СпособУведомленияОбОперацияхПоЛицевомуСчету = ЗНАЧЕНИЕ(Перечисление.СпособыУведомленияОбОперациях.Почтой)
		|			ТОГДА ""LETR""
		|		КОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.Регистратор.СпособУведомленияОбОперацияхПоЛицевомуСчету = ЗНАЧЕНИЕ(Перечисление.СпособыУведомленияОбОперациях.ЛичноУРегистратора)
		|			ТОГДА ""REGR""
		|		ИНАЧЕ ""ELCT""
		|	КОНЕЦ КАК letter_go_type,
		|	ВЫБОР
		|		КОГДА ВнутренниеПеречниСрезПоследних.Объект ЕСТЬ NULL
		|			ТОГДА ""UNQUAL""
		|		ИНАЧЕ ""QUAL""
		|	КОНЕЦ КАК qualified_investor,
		|	""No"" КАК letter_basis_doc,
		|	_Документы.Служебный_Заявка.НомерСчета КАК account,
		|	_Документы.Служебный_Заявка.НаименованиеБанка КАК bank_name,
		|	_Документы.Служебный_Заявка.РасчетныйСчет.Банк.Город КАК bank_city,
		|	_Документы.Служебный_Заявка.БИК КАК ruic,
		|	_Документы.Служебный_Заявка.КоррСчет КАК bank_corr,
		|	_Документы.Служебный_Заявка.ПолучательПлатежа КАК pay_name,
		|	_Документы.Служебный_Заявка.ИННПолучателя КАК inn,
		|	""1"" КАК effievncy_status,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаРождения КАК birthtday,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.МестоРождения КАК place_of_birth,
		|	ВЫБОР
		|		КОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.Гражданство = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
		|			ТОГДА ""RUS""
		|		КОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.Гражданство.КодАльфа3 = ""GBR""
		|			ТОГДА ""GBR""
		|		КОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.Гражданство.КодАльфа3 = ""CYP""
		|			ТОГДА ""CYP""
		|		КОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.Гражданство.КодАльфа3 = ""BLR""
		|			ТОГДА ""BLR""
		|		КОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.Гражданство.КодАльфа3 = ""SGP""
		|			ТОГДА ""SGP""
		|	КОНЕЦ КАК nationality,
		|	ВЫБОР
		|		КОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.Пол = ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Мужской)
		|			ТОГДА ""M""
		|		ИНАЧЕ ""F""
		|	КОНЕЦ КАК gender,
		|	""DVCA"" КАК cash_settlement_type,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо КАК Ссылка
		|ПОМЕСТИТЬ _compl_shareholder_info_party_details_t
		|ИЗ
		|	_Документы КАК _Документы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&КонецПериода,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ПО _Документы.Служебный_Пайщик = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВнутренниеПеречни.СрезПоследних(
		|				&КонецПериода,
		|				Организация = &Организация
		|					И ВидПеречня = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.КвалифицированныеИнвесторы)) КАК ВнутренниеПеречниСрезПоследних
		|		ПО _Документы.Служебный_Пайщик = ВнутренниеПеречниСрезПоследних.Объект
		|			И (ВнутренниеПеречниСрезПоследних.Действует)
		|ГДЕ
		|	_Документы.document_code = ""DKRI_01""
		|	И _Документы.Служебный_Заявка.ОткрытьЗакрытьДепозитарныйСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА _Документы.document_code = ""DKRI_02""
		|				И _Документы.Служебный_Заявка.ОткрытьЗакрытьДепозитарныйСчет
		|			ТОГДА ""UKWN""
		|		ИНАЧЕ _Документы.Служебный_Заявка.ДепозитарныйСчет.НомерСчета
		|	КОНЕЦ КАК account_id,
		|	ВЫБОР
		|		КОГДА _Документы.Служебный_Заявка.ВидПайщика = ЗНАЧЕНИЕ(Перечисление.ВидыПайщиков.Владелец)
		|			ТОГДА ""01""
		|		КОГДА _Документы.Служебный_Заявка.ВидПайщика = ЗНАЧЕНИЕ(Перечисление.ВидыПайщиков.ДоверительныйУправляющий)
		|			ТОГДА ""03""
		|		ИНАЧЕ ""02""
		|	КОНЕЦ КАК account_type,
		|	ВЫБОР
		|		КОГДА _Документы.Служебный_Заявка.СобственностьНаПаи = ЗНАЧЕНИЕ(Перечисление.ВидыСобственности.НеДолеваяНеСовместная)
		|			ТОГДА ""1""
		|		КОГДА _Документы.Служебный_Заявка.СобственностьНаПаи = ЗНАЧЕНИЕ(Перечисление.ВидыСобственности.Долевая)
		|			ТОГДА ""2""
		|		ИНАЧЕ ""3""
		|	КОНЕЦ КАК account_own,
		|	_Документы.Служебный_Заявка КАК Ссылка
		|ПОМЕСТИТЬ _compl_account_id
		|ИЗ
		|	_Документы КАК _Документы
		|ГДЕ
		|	_Документы.document_code В (""DKRI_02"", ""DKRI_04"", ""DKRI_05"")
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Документы.document_code КАК Ссылка
		|ПОМЕСТИТЬ _compl_owner_info
		|ИЗ
		|	_Документы КАК _Документы
		|ГДЕ
		|	_Документы.document_code = """"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""RUB"" КАК ccy_code,
		|	_Документы.Служебный_Заявка.Сумма КАК amount,
		|	_Документы.Служебный_Заявка КАК Ссылка
		|ПОМЕСТИТЬ _compl_amount
		|ИЗ
		|	_Документы КАК _Документы
		|ГДЕ
		|	_Документы.document_code = ""DKRI_02""
		|	И НЕ _Документы.Служебный_Заявка.Многократная";
	
	Запрос.Выполнить();
	
	Результат = Новый Структура;	
	_Документы = Запрос.МенеджерВременныхТаблиц.Таблицы["_Документы"].ПолучитьДанные().Выгрузить();
		
	Если _Документы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	МассивТаблиц = Новый Массив;
	Для Каждого ТекТаблица Из Запрос.МенеджерВременныхТаблиц.Таблицы Цикл
		
		Если Не СтрНачинаетсяС(ТекТаблица.ПолноеИмя, "_Документы_") Тогда
			Продолжить;
		КонецЕсли;
		
    	РаботаСКоллекциями.ДополнитьМассив(МассивТаблиц,
 							РаботаСКоллекциями.ТаблицаЗначений_В_МассивСтруктур(ТекТаблица.ПолучитьДанные().Выгрузить()),
							Ложь); 
		
	КонецЦикла;	
		
	Результат.Вставить("Документы", МассивТаблиц);
	
	МассивОбщихДанных = Новый Массив;
	Для Каждого ТекТаблица Из Запрос.МенеджерВременныхТаблиц.Таблицы Цикл
		
		Если Не СтрНачинаетсяС(ТекТаблица.ПолноеИмя, "_compl_") Тогда
			Продолжить;
		КонецЕсли;
	        
		ДанныеВременнойТаблицы = Запрос.МенеджерВременныхТаблиц.Таблицы[ТекТаблица.ПолноеИмя].ПолучитьДанные().Выгрузить(); 
		// Данные анкеты собираем отдельно
		Если ТекТаблица.ПолноеИмя = "_compl_shareholder_info_party_details_t" Тогда
			ДобавитьДанныеАнкетВСтруктуру(Результат, ДанныеВременнойТаблицы);
		ИначеЕсли ТекТаблица.ПолноеИмя = "_compl_add_shareholder_id" Тогда
			
			// Добавляем в shareholder_id у документов DKRI_02, DKRI_04, DKRI_05
			Для Каждого ТекДокумент Из Результат.Документы Цикл
				
				Если ТекДокумент.document_code = "DKRI_02"
					Или ТекДокумент.document_code = "DKRI_04"
					Или ТекДокумент.document_code = "DKRI_05" Тогда
					
					Для Каждого СтрокаТаблицы Из ДанныеВременнойТаблицы Цикл
						Если СтрокаТаблицы.Ссылка = ТекДокумент.Служебный_Пайщик Тогда
							ТекДокумент.shareholder_id.ids.id.Вставить(0, (Новый Структура("type, number", СтрокаТаблицы.type, СтрокаТаблицы.number)));
						КонецЕсли;	
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЦикла;

		Иначе			
			ДобавитьСоставныеДанныеВСтруктуру(Результат, ДанныеВременнойТаблицы, СтрЗаменить(ТекТаблица.ПолноеИмя, "_compl_", ""), МассивОбщихДанных);
		КонецЕсли;
				
	КонецЦикла;
			
	Результат.Вставить("МассивОбщихДанных", МассивОбщихДанных);
	
	Возврат Результат;	                                                                                                  
		
КонецФункции

Процедура ДобавитьДанныеАнкетВСтруктуру(Результат, Данные)
	
	Для Каждого СтрокаДанных Из Данные Цикл
		
		СтруктураДанных = Новый Структура;
		
		shareholder_dtls = Новый Структура;
		shareholder_dtls.Вставить("individual",
			Новый Структура("individual_name_separate, effievncy_status, individual_document, birthtday, place_of_birth, nationality, gender, legal_address",
				Новый Структура("name_first, name_second, name_last",
					СтрокаДанных.name_first, СтрокаДанных.name_second, СтрокаДанных.name_last),
				СтрокаДанных.effievncy_status,	
				Новый Структура("type, series, number, date, organ, code", 
					СтрокаДанных.type, СтрокаДанных.series, СтрокаДанных.number, СтрокаДанных.date, СтрокаДанных.organ, СтрокаДанных.code),
				СтрокаДанных.birthtday,
				СтрокаДанных.place_of_birth,
				СтрокаДанных.nationality,
				СтрокаДанных.gender,
				СтрокаДанных.legal_address));
				
		СтруктураДанных.Вставить("shareholder_dtls", shareholder_dtls);
		
		МассивТелефонов = Новый Массив;
		МассивТелефонов.Добавить(Новый Структура("phone_num", СтрокаДанных.phone_or_fax));
		
		МассивАдресов = Новый Массив;
		МассивАдресов.Добавить(СтрокаДанных.e_mail);
		
		СтруктураДанных.Вставить("shareholder_contacts",
			Новый Структура("phone_or_faxes, e_mails", 
				Новый Структура("phone_or_fax",	МассивТелефонов),
				Новый Структура("e_mail",		МассивАдресов)));
					
		СтруктураДанных.Вставить("tax_info", Новый Структура("tax_exempt_indicator", СтрокаДанных.tax_exempt_indicator));
		
		МассивСпособовОповещения = Новый Массив;
		МассивСпособовОповещения.Добавить(СтрокаДанных.letter_go_type);
		СтруктураДанных.Вставить("letter_go_type_N", Новый Структура("letter_go_type", МассивСпособовОповещения));
				
		МассивРасчетныхСчетов = Новый Массив;
		МассивРасчетныхСчетов.Добавить(
			Новый Структура("cash_settlement_type, bank_prop_rub",
				СтрокаДанных.cash_settlement_type,
			    Новый Структура("pay_name, inn, cash_rub_dtls",
					СтрокаДанных.pay_name,
					СтрокаДанных.inn,
					Новый Структура("account, bank_name, bank_city, ruic, bank_corr", 
						СтрокаДанных.account, СтрокаДанных.bank_name, СтрокаДанных.bank_city, СтрокаДанных.ruic, СтрокаДанных.bank_corr))));
		
		СтруктураДанных.Вставить("cash_settlement_dtls", 
			Новый Структура("cash_settlement_dtl", МассивРасчетныхСчетов));
			
					
		СтруктураДанных.Вставить("qualified_investor",	СтрокаДанных.qualified_investor);
		СтруктураДанных.Вставить("letter_basis_doc",	СтрокаДанных.letter_basis_doc);
						
		Для Каждого ТекДокумент Из Результат.Документы Цикл				
			Если ТекДокумент.document_code = "DKRI_01" 
				И ТекДокумент.Свойство("shareholder_info")
				И ТекДокумент["shareholder_info"] = СтрокаДанных.Ссылка Тогда
				
				ТекДокумент.Вставить("shareholder_info", СтруктураДанных);
				
			КонецЕсли;				
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры	

Процедура ДобавитьСоставныеДанныеВСтруктуру(Результат, Данные, ИмяСвойстваВРезультате, МассивОбщихДанных) 
	
	Колонки = Данные.Колонки;
	ВставитьВДокументы = Колонки.Найти("Ссылка") <> Неопределено;
	
	Если Данные.Количество() = 0 Тогда
		
		// Удаляем свойство
		Если ВставитьВДокументы Тогда
						
			Для Каждого ТекДокумент Из Результат.Документы Цикл
				
				Если ТекДокумент.document_code = "DKRI_01" 
					И ИмяСвойстваВРезультате = "shareholder_info" Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТекДокумент.Свойство(ИмяСвойстваВРезультате) Тогда
					ТекДокумент.Удалить(ИмяСвойстваВРезультате);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Возврат;	
			
	КонецЕсли; 
	
	Для Каждого СтрокаДанных Из Данные Цикл
		
		СтруктураДанных = Новый Структура;
		МассивПодчиненныхДанных = Новый Массив;
		СтруктураПодчиненныхДанных = Новый Структура;
		ИмяТекущейСтруктуры = "";  
		
		Для Каждого Колонка Из Колонки Цикл
			
			ТекЗначение = СтрокаДанных[Колонка.Имя];
			
			Если СтрНачинаетсяС(Колонка.Имя, "_compl_") Тогда
							
				Если ТипЗнч(ТекЗначение) = Тип("Строка") И СтрНачинаетсяС(ТекЗначение, "_compl_") Тогда					
					СтруктураПодчиненныхДанных = Новый Структура;
					ИмяТекущейСтруктуры = Лев(ТекЗначение, СтрДлина(ТекЗначение) - 1);
				Иначе
					СтруктураПодчиненныхДанных.Вставить(СтрЗаменить(Колонка.Имя, ИмяТекущейСтруктуры + "_", ""), ТекЗначение);
				КонецЕсли;
				
			Иначе
				
				Если ТипЗнч(ТекЗначение) = Тип("Строка") 
					И (СтрНачинаетсяС(ТекЗначение, "_compl_") 
						Или СтрНачинаетсяС(ТекЗначение, "_struct_")) 
					И СтруктураПодчиненныхДанных.Количество() > 0 Тогда
					
					МассивПодчиненныхДанных = Новый Массив;
					МассивПодчиненныхДанных.Добавить(СтруктураПодчиненныхДанных);
					СтруктураДанных.Вставить(
							Колонка.Имя, 
							?(СтрНачинаетсяС(ТекЗначение, "_struct_"),
								СтруктураПодчиненныхДанных,
								Новый Структура(СтрЗаменить(ИмяТекущейСтруктуры, "_compl_", ""), МассивПодчиненныхДанных)));
					
				Иначе				
					РаботаСКоллекциями.ДобавитьНовыйЭлементВСтруктуру(СтруктураДанных, Колонка.Имя, СтрокаДанных[Колонка.Имя]);					
				КонецЕсли;
				
			КонецЕсли;	
		
		КонецЦикла;
		
		Если ВставитьВДокументы Тогда
			
			ТекСсылка = СтруктураДанных.Ссылка;
		
			Если СтруктураДанных.Свойство("Ссылка") Тогда	
				СтруктураДанных.Удалить("Ссылка");
			КонецЕсли;
			
			Для Каждого ТекДокумент Из Результат.Документы Цикл
				
				Если ТекДокумент.document_code = "DKRI_01" 
					И ИмяСвойстваВРезультате = "shareholder_info" Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТекДокумент.Свойство(ИмяСвойстваВРезультате) И ТекДокумент[ИмяСвойстваВРезультате] = ТекСсылка Тогда
					ТекДокумент.Вставить(ИмяСвойстваВРезультате, СтруктураДанных);
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			Результат.Вставить(ИмяСвойстваВРезультате, СтруктураДанных);
			МассивОбщихДанных.Добавить(ИмяСвойстваВРезультате);
		КонецЕсли;
	
	КонецЦикла;	
    
КонецПроцедуры

Функция ПреобразоватьЗначениеВXML(ПакетДанных, ИмяЭлемента, НоваяФабрикаXDTO, ТипОбъектаXDTO = "")
	
	ТипЗначения = ТипЗнч(ПакетДанных);
	
	Если ТипЗначения = Тип("Структура")  Тогда
		ОбъектXDTO		= НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO);

		Для Каждого ЭлементПакета Из ПакетДанных Цикл
			
			Если ТипЗнч(ЭлементПакета.Значение) = Тип("ОбъектXDTO") Тогда
				
				Для Каждого ЭлементМассива Из ЭлементПакета.Значение Цикл					
					ОбъектXDTO[ЭлементПакета.Ключ].Добавить(ПреобразоватьЗначениеВXML(ЭлементМассива, ЭлементПакета.Ключ, НоваяФабрикаXDTO, ТипОбъектаXDTO.Свойства.Получить(ЭлементПакета.Ключ).Тип));
				КонецЦикла;
									
			Иначе
 				ОбъектXDTO[ЭлементПакета.Ключ] = ПреобразоватьЗначениеВXML(ЭлементПакета.Значение, ЭлементПакета.Ключ, НоваяФабрикаXDTO, ТипОбъектаXDTO.Свойства.Получить(ЭлементПакета.Ключ).Тип);
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ТипОбъектаXDTO) = Тип("ТипОбъектаXDTO") Тогда
		ОбъектXDTO = ПолучитьЗначениеПеречисления(ТипОбъектаXDTO, НоваяФабрикаXDTO, ИмяЭлемента, ПакетДанных);	
	ИначеЕсли ТипОбъектаXDTO.Имя = "decimal" ИЛИ ТипОбъектаXDTO.Имя = "Double" Тогда
		ОбъектXDTO = НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO, ПакетДанных);
		
	Иначе
		ОбъектXDTO = НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO, ПакетДанных);
	КонецЕсли;
	
	Возврат ОбъектXDTO;
	
КонецФункции

Функция ПолучитьЗначениеПеречисления(ТипОбъектаXDTO, НоваяФабрикаXDTO, ИмяЭлемента, Знач ЗначениеПеречисления)
	
	Если НЕ ЗначениеЗаполнено(ЗначениеПеречисления) Тогда 
		Возврат НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO);
	КонецЕсли;
		
КонецФункции

Процедура ВыгрузитьСверкуЗаявокЗаДень(Отказ) Экспорт
	
	ПроверитьКаталогОбмена("Выгрузка");
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаявкаПайщика.Дата КАК Дата,
		|	ВЫБОР
		|		КОГДА ЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Зачисление)
		|			ТОГДА ""Выдача""
		|		КОГДА ЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Погашение)
		|			ТОГДА ""Погашение""
		|		ИНАЧЕ ""Обмен""
		|	КОНЕЦ КАК ТипОперации,
		|	ЗаявкаПайщика.ПаевойИнвестиционныйФонд КАК НазваниеПродукта,
		|	ЗаявкаПайщика.Пайщик КАК ФИОклиента,
		|	ЗаявкаПайщика.НомерЗаявки КАК НомерЗаявки,
		|	ВЫБОР
		|		КОГДА ЗаявкаПайщика.ИсточникЗаявки = ЗНАЧЕНИЕ(Перечисление.ИсточникиАнкетИЗаявок.Офис)
		|			ТОГДА ""бумажный""
		|		ИНАЧЕ ""электронный""
		|	КОНЕЦ КАК ПризнакБумажности
		|ИЗ
		|	Документ.ЗаявкаПайщика КАК ЗаявкаПайщика
		|ГДЕ
		|	ЗаявкаПайщика.Организация = &Организация
		|	И ЗаявкаПайщика.Дата МЕЖДУ &НачалоДня И &КонецДня
		|	И НЕ ЗаявкаПайщика.ПометкаУдаления");
	
	Запрос.УстановитьПараметр("Организация", 	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("НачалоДня",		ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("КонецДня",		КонецДня(ЭтотОбъект.Дата));
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент(, , , Новый ТабличныйДокумент);
	РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(ПараметрыВывода, Результат);
	
	ПараметрыВывода.ДокументРезультат.Записать(ЭтотОбъект.КаталогОбмена + "Сверка заявок за " + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy") + ".xlsx", ТипФайлаТабличногоДокумента.XLSX);
		
КонецПроцедуры

Функция ОбщиеДанныеПИФ()
	
	// Выгружаем действующие ПИФы УК
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд.НомерПравил КАК НомерПравил,
		|	РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд.Ссылка КАК ПИФ,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ОГРН КАК ОГРН
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
		|				И СчетДоверительногоУправления.ДатаЗаключения <= &Дата
		|				И (СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения > &Дата)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&Дата, ) КАК РеквизитыПИФСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|					&Дата,
		|					Организация = &Организация
		|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|			ПО РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо = РеквизитыЮридическихЛицАнкетныеСрезПоследних.Организация.ЮрФизЛицо
		|				И РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд");
	
	Запрос.УстановитьПараметр("Дата",			ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	
	Возврат Запрос.Выполнить().Выгрузить();
	        
КонецФункции

Процедура ДополнитьКаталогОбменаПоТочкеМаршрута(ТочкаМаршрута)
	
	ДополнениеПоТочкеМаршрута = "";
	Если ТочкаМаршрута = Неопределено Тогда
		
		ДополнениеПоТочкеМаршрута = "DKRA_05_ Детальный отчет реестра об исполненных операциях по заявкам\";
		
	ИначеЕсли ТочкаМаршрута = БизнесПроцессы.ПоступлениеИПроверкаЗаявкиНаПриобретениеПаев.ТочкиМаршрута.ЗагрузкаНовогоЛицевогоСчета Тогда
		
		ДополнениеПоТочкеМаршрута = "DKRA_02_Уведомления об открытии лицевого счета\";
		 
	ИначеЕсли ТочкаМаршрута = БизнесПроцессы.ЗачислениеПаев.ТочкиМаршрута.ЗагрузкаООВПиОНВП Тогда
		
		ДополнениеПоТочкеМаршрута = "DKRA_03_Отчет о возможности выдачи паев\";
		
	ИначеЕсли ТочкаМаршрута = БизнесПроцессы.ЗачислениеПаев.ТочкиМаршрута.ЗагрузкаДанныхОтДКПоЗачислениюПаев
		Или ТочкаМаршрута = БизнесПроцессы.ПогашениеПаев.ТочкиМаршрута.ЗагрузкаДанныхОтДКПоПогашениюПаев
		Или ТочкаМаршрута = БизнесПроцессы.ОбменПаев.ТочкиМаршрута.ЗагрузкаДанныхОтДКПоОбменуПаев Тогда
		
		ДополнениеПоТочкеМаршрута = "DKRA_04_Отчеты о проведении  операции по лицевому счету\";
		
	КонецЕсли;
	
	ДополнениеПоПериоду = Формат(ЭтотОбъект.Дата, "ДФ=гггг") + "\" + Формат(ЭтотОбъект.Дата, "ДФ=ММММ") + "\";
	
	ЭтотОбъект.КаталогОбмена = ЭтотОбъект.КаталогОбмена + ДополнениеПоТочкеМаршрута + ДополнениеПоПериоду;
	
КонецПроцедуры

