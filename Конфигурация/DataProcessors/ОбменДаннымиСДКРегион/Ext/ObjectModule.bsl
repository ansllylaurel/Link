   
Функция ФабрикаXDTOИзСхемы()

	МакетXSD = ПолучитьМакет("СхемаXSD");
		
	ИмяФайлаXSD = ПолучитьИмяВременногоФайла("xsd");
	МакетXSD.Записать(ИмяФайлаXSD);
	
	ФайлыXSD = Новый Массив;
	ФайлыXSD.Добавить(ИмяФайлаXSD);
	
	НоваяФабрикаXDTO = СоздатьФабрикуXDTO(ИмяФайлаXSD);
	
	Попытка
		УдалитьФайлы(КаталогВременныхФайлов(), ИмяФайлаXSD);
	Исключение
		
	КонецПопытки;
	
	Возврат НоваяФабрикаXDTO;
	
КонецФункции

Процедура ПроверитьКаталогОбмена(Режим, ТочкаМаршрута = Неопределено)
	
	Если ПустаяСтрока(ЭтотОбъект.КаталогОбмена) Тогда
		
		Если ОбщегоНазначения.ЗначениеПараметраСеанса("ЭтоРабочаяИнформационнаяБаза") Тогда
						
			Запрос = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЗначенияДополнительныхСведений.Значение КАК Значение
				|ИЗ
				|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
				|ГДЕ
				|	ЗначенияДополнительныхСведений.Объект = &Объект
				|	И ЗначенияДополнительныхСведений.Свойство.Ключ = &КодСведения");
			
			// У каждого ПИФ будет свой путь загрузки. Ждем реализацию от Ильи, пока закомментировано
			Запрос.УстановитьПараметр("Объект",			ЭтотОбъект.Организация); //?(Режим = "Выгрузка", ЭтотОбъект.Организация, ЭтотОбъект.ПаевойИнвестиционныйФонд));
			Запрос.УстановитьПараметр("КодСведения",	"Обработки.ОбменДаннымиСДКРегион.ШаблонКаталогаФайлов_" + Режим);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				ЭтотОбъект.КаталогОбмена = Выборка.Значение;
				
				//Ждем реализацию от Ильи, пока закомментировано
				// Для точки маршрута дополняем путь
				//Если Режим = "Загрузка" Тогда					
				//	ДополнитьКаталогОбменаПоТочкеМаршрута(ТочкаМаршрута);
				//КонецЕсли;
				
			Иначе
				ВызватьИсключение СтрШаблон("В доп. сведениях %1 %2 не задан каталог %3 СЭД ДК Регион",
									?(Режим = "Выгрузка", "организации", "ПИФ"),
									?(Режим = "Выгрузка", ЭтотОбъект.Организация, ЭтотОбъект.ПаевойИнвестиционныйФонд),
									?(Режим = "Выгрузка", "выгрузки в", "загрузки из"));
			КонецЕсли;
			
		Иначе	
			
			// Хардкод только на копии базы				
			ЭтотОбъект.КаталогОбмена = ?(Режим = "Выгрузка",
				"\\ap69\Developers\Саня\_Разработка\Розница\ДК\",
				"\\ap69\Developers\Саня\_Разработка\Розница\ДК\Загрузка\");

		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыгрузитьДанные(Отказ) Экспорт
	
	ПроверитьКаталогОбмена("Выгрузка");
	
	ВременныйКаталог = КаталогВременныхФайлов() + Строка(Новый УникальныйИдентификатор()) + "\";
	
	РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(ВременныйКаталог, Отказ); 
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	НоваяФабрикаXDTO = ФабрикаXDTOИзСхемы();
		
	ПакетДанных = ДанныеДляВыгрузки();
	
	Если Не ПакетДанных.Свойство("Документы") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют данные для выгрузки");
		Возврат;
	КонецЕсли;
	
	URIПространстваИмен = "";
		
	Для Каждого ПакетXDTO Из НоваяФабрикаXDTO.Пакеты Цикл
		Если ПакетXDTO.URIПространстваИмен = "http://www.w3.org/2001/XMLSchema" Тогда
			Продолжить;
		КонецЕсли;
		URIПространстваИмен = ПакетXDTO.URIПространстваИмен;
	КонецЦикла;	
		
	КорневыеСвойстваXDTO = НоваяФабрикаXDTO.Пакеты.Получить(URIПространстваИмен).КорневыеСвойства;
	
	Для Каждого ДокументыПакета Из ПакетДанных.Документы Цикл
		
		ЗаписьXML = Новый ЗаписьXML;
		
		ИмяФайлаВПапке	= ДокументыПакета.document_code + "_" + ДокументыПакета.Служебный_НомерЗаявки + ".xml";
		ИмяФайла		= ВременныйКаталог + ИмяФайлаВПапке;
		
		Попытка
			ЗаписьXML.ОткрытьФайл(ИмяФайла, "UTF-8");
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
			Возврат;
		КонецПопытки;
		
		ЗаписьXML.ЗаписатьОбъявлениеXML();
	
		ИмяДокумента = ДокументыПакета.ИмяДокумента;
		ЗаписьXML.ЗаписатьНачалоЭлемента(ИмяДокумента, URIПространстваИмен);
		ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance");
		ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xs", "http://www.w3.org/2001/XMLSchema"); 
		ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("", "http://www.it.ru/Schemas/Avior/DK");
				
		Для Каждого ДанныеДокумента Из ДокументыПакета Цикл
						
			//Составные типы получаем отдельно
			Если ПакетДанных.МассивОбщихДанных.Найти(ДанныеДокумента.Ключ) <> Неопределено Тогда 
				
				ДанныеДляЗаписи = ПакетДанных[ДанныеДокумента.Ключ];
				
				ИмяКлючаВФабрике = СтрЗаменить(ДанныеДокумента.Ключ, "_compl_", ""); 
									
				ТипОбъектаXDTO = КорневыеСвойстваXDTO.Получить(ИмяДокумента).Тип.Свойства.Получить(ИмяКлючаВФабрике).Тип;
				
				НоваяФабрикаXDTO.ЗаписатьXML(ЗаписьXML, 
											ПреобразоватьЗначениеВXML(ДанныеДляЗаписи, ИмяКлючаВФабрике, НоваяФабрикаXDTO, ТипОбъектаXDTO), 
											ИмяКлючаВФабрике, URIПространстваИмен, 
											ФормаXML.Элемент, НазначениеТипаXML.Неявное);					
											
			ИначеЕсли СтрНайти(ДанныеДокумента.Ключ, "ИмяДокумента") > 0 Тогда
				Продолжить;								
			ИначеЕсли  СтрНайти(ДанныеДокумента.Ключ, "_compl_") > 0 Тогда	
				Продолжить;
			ИначеЕсли СтрНачинаетсяС(ДанныеДокумента.Ключ, "Служебный") > 0 Тогда
				Продолжить;                                        			
			Иначе	
													
				ТипОбъектаXDTO = КорневыеСвойстваXDTO.Получить(ИмяДокумента).Тип.Свойства.Получить(ДанныеДокумента.Ключ).Тип;
								
				// В текст подписи нужно вставить дату и время подписи
				Если ДанныеДокумента.Ключ = "sign_info" Тогда
					
					ТекстПодписи = СтрЗаменить(ДанныеДокумента.Значение, "_ДатаВремяПЭП_", Формат(ДокументыПакета.Служебный_ДатаВремяПЭП, "ДФ='dd.MM.yyyy HH:mm:ss'"));
					
					НоваяФабрикаXDTO.ЗаписатьXML(ЗаписьXML, 
												ПреобразоватьЗначениеВXML(ТекстПодписи, ДанныеДокумента.Ключ, НоваяФабрикаXDTO, ТипОбъектаXDTO), 
												ДанныеДокумента.Ключ, URIПространстваИмен, 
												ФормаXML.Элемент, НазначениеТипаXML.Неявное);
												
				Иначе	
					НоваяФабрикаXDTO.ЗаписатьXML(ЗаписьXML, 
												ПреобразоватьЗначениеВXML(ДанныеДокумента.Значение, ДанныеДокумента.Ключ, НоваяФабрикаXDTO, ТипОбъектаXDTO), 
												ДанныеДокумента.Ключ, URIПространстваИмен, 
												ФормаXML.Элемент, НазначениеТипаXML.Неявное);
				КонецЕсли;
											
			КонецЕсли;
									
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.Закрыть();  
		
		// Переоткрываем как текст у удаляем текст с соответствиями пространств имен
		ТекФайл = Новый ТекстовыйДокумент;
		ТекФайл.Прочитать(ИмяФайла, "UTF-8");
		ТекФайл.ЗаменитьСтроку(2, "<" + ИмяДокумента + ">");
		
		ТекФайл.Записать(ИмяФайла, "UTF-8");		
	
		
		// Готовим info-файл  Info-……..
		ИмяИнфоФайла = ВременныйКаталог + "Info-" + ИмяФайлаВПапке;
		
		ИнфоФайл = Новый ЗаписьXML;
		ИнфоФайл.ОткрытьФайл(ИмяИнфоФайла, "UTF-8");
		ИнфоФайл.ЗаписатьОбъявлениеXML();
		ИнфоФайл.ЗаписатьНачалоЭлемента("DownloadingDocumentInfo");
		
		// Идентификатор УК РЭМ
		ИнфоФайл.ЗаписатьАтрибут("DocumentId", "895100");
		
		// Неизвестно что, но всегда "5"
		ИнфоФайл.ЗаписатьАтрибут("DocumentTypeId", "5");
		ИнфоФайл.ЗаписатьАтрибут("DocumentDate", Формат(ДокументыПакета.header.doc_date, "ДФ=yyyy-MM-dd"));
		ИнфоФайл.ЗаписатьАтрибут("DocumentNumber", ДокументыПакета.header.doc_num);
		ИнфоФайл.ЗаписатьАтрибут("DocumentFileName", ИмяФайлаВПапке);
		
		ИнфоФайл.ЗаписатьКонецЭлемента();
		
		ИнфоФайл.Закрыть();
				
		// Архивируем все		
		ИмяФайлаАрхиваВПапке = СтрЗаменить(ИмяФайлаВПапке, ".xml", ".zip");
		ИмяФайлаАрхива = ВременныйКаталог + ИмяФайлаАрхиваВПапке;		
		ЗаписьZipФайла = Новый ЗаписьZipФайла(ИмяФайлаАрхива,,,,,, КодировкаИменФайловВZipФайле.OSEncodingWithUTF8);
					
		Попытка
			ЗаписьZipФайла.Добавить(ИмяФайла);
		Исключение
		КонецПопытки;
		
		Попытка
			ЗаписьZipФайла.Добавить(ИмяИнфоФайла);
		Исключение
		КонецПопытки;
		
		Попытка
			ЗаписьZipФайла.Записать();
		Исключение			
			ВызватьИсключение СтрШаблон("Не удалось записать архив из-за ошибки:%1", Символы.ПС + ОписаниеОшибки());
		КонецПопытки;
		
		Попытка
			КопироватьФайл(ИмяФайлаАрхива, ЭтотОбъект.КаталогОбмена + ИмяФайлаАрхиваВПапке);
		Исключение	
			ВызватьИсключение СтрШаблон("Не удалось скопировать в каталог выгрузки ДК Регион архив из-за ошибки:%1", Символы.ПС + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
		
	УдалитьФайлы(ВременныйКаталог);	
	
КонецПроцедуры

Процедура ЗагрузитьДанные(Отказ) Экспорт
		
	ТочкаМаршрута = ?(ЗначениеЗаполнено(ЭтотОбъект.Задача),
	                    ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Задача, "ТочкаМаршрута"),
						Неопределено);

	ПроверитьКаталогОбмена("Загрузка", ТочкаМаршрута);
	
	ЭтоЗагрузкаУведомленияПоСчету = ТочкаМаршрута = БизнесПроцессы.ПоступлениеИПроверкаЗаявкиНаПриобретениеПаев.ТочкиМаршрута.ЗагрузкаНовогоЛицевогоСчета
								Или ТочкаМаршрута = БизнесПроцессы.ОбменПаев.ТочкиМаршрута.ЗагрузкаНовогоЛицевогоСчета;
								
	ЭтоЗагрузкаООВП					= ТочкаМаршрута = БизнесПроцессы.ЗачислениеПаев.ТочкиМаршрута.ЗагрузкаООВПиОНВП;
	ЭтоЗагрузкаЗачисленияПаев		= ТочкаМаршрута = БизнесПроцессы.ЗачислениеПаев.ТочкиМаршрута.ЗагрузкаДанныхОтДКПоЗачислениюПаев;
										
	ЭтоЗагрузкаПогашенияПаев		= ТочкаМаршрута = БизнесПроцессы.ПогашениеПаев.ТочкиМаршрута.ЗагрузкаДанныхОтДКПоПогашениюПаев;
	ЭтоЗагрузкаОбменаПаев			= ТочкаМаршрута = БизнесПроцессы.ОбменПаев.ТочкиМаршрута.ЗагрузкаДанныхОтДКПоОбменуПаев;
		
	КоличествоФайловДляОбработки	= ?(ЭтоЗагрузкаОбменаПаев, 2, 1);
	
	НоваяФабрикаXDTO = ФабрикаXDTOИзСхемы();
		
	ФайлыДляЗагрузкиZIP = НайтиФайлы(ЭтотОбъект.КаталогОбмена, "*.zip");
	
	// Распаковываем архивы
	ЕстьXMLФайлы = Ложь;
	Для Каждого ФайлЗагрузкиZIP Из ФайлыДляЗагрузкиZIP Цикл
		
		ЧтениеАрхива = Новый ЧтениеZipФайла(ФайлЗагрузкиZIP.ПолноеИмя);
		
		// Извлекаем только xml, pdf и sig
		Для Каждого ЭлементАрхива Из ЧтениеАрхива.Элементы Цикл
			Если ЭлементАрхива.Расширение = "xml"
				Или ЭлементАрхива.Расширение = "pdf"
				Или ЭлементАрхива.Расширение = "sig" Тогда
				ЧтениеАрхива.Извлечь(ЭлементАрхива, ЭтотОбъект.КаталогОбмена, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
				ЕстьXMLФайлы = Истина;
			КонецЕсли;	
		КонецЦикла;
		
	КонецЦикла;
	
	Если Не ЕстьXMLФайлы Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ДанныеПИФ = ОбщиеДанныеПИФ();
	
	ОбработкаДвиженийПоПаям = Неопределено;
	Если ЭтоЗагрузкаЗачисленияПаев Или ЭтоЗагрузкаПогашенияПаев Или ЭтоЗагрузкаОбменаПаев Тогда
		ОбработкаДвиженийПоПаям				= Обработки.ГрупповоеЗачислениеПогашениеИОбменПаевЗаДень.Создать();		
		ОбработкаДвиженийПоПаям.Организация	= ЭтотОбъект.Организация;
	КонецЕсли;
	
	// Загружаем xml-файлы 	
	ФайлыДляЗагрузки = НайтиФайлы(ЭтотОбъект.КаталогОбмена, "*.xml");
	
	ДанныеДляПереименованияФайлов = Новый Массив;
	
	Для Каждого ФайлЗагрузки Из ФайлыДляЗагрузки Цикл
	
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.ОткрытьФайл(ФайлЗагрузки.ПолноеИмя);
		
		ОбъектXDTO = НоваяФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
		
		// Обрабатываем только наши файлы
		Если ОбъектXDTO.Свойства().Получить("document_code") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтоЗагрузкаУведомленияПоСчету
			И Не (ОбъектXDTO.document_code = "DKRA_02" Или ОбъектXDTO.document_code = "DKRA_08") Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтоЗагрузкаООВП
			И Не (ОбъектXDTO.document_code = "DKRA_03" Или ОбъектXDTO.document_code = "DKRA_09") Тогда
			Продолжить;
		КонецЕсли;
		
		Если (ЭтоЗагрузкаЗачисленияПаев Или ЭтоЗагрузкаПогашенияПаев Или ЭтоЗагрузкаОбменаПаев)
			И ОбъектXDTO.document_code <> "DKRA_04" Тогда
			Продолжить;
		КонецЕсли;
				
		СтруктураДляПереименованияФайла = Новый Структура(
				"ВидДокумента,ДатаДокумента,ИмяФайла",
				ОбъектXDTO.header.doc_name,
				ДатаИзСтроки(ОбъектXDTO.header.doc_date),
				ФайлЗагрузки.ИмяБезРасширения);
				
		// Определяем УК и ПИФ
		ОГРНУК			= ОбъектXDTO.managment_company.ids.id.number;
		
		Если ДанныеПИФ.НайтиСтроки(Новый Структура("ОГРН", ОГРНУК)).Количество() = 0 Тогда
			// ##Зарегистрировать оповещение или ошибку?
			Продолжить;	
		КонецЕсли;
		
		НомерПравилПИФ	= ОбъектXDTO.investment_fund.ids.id.number;
		
		НайдСтрокиПИФ = ДанныеПИФ.НайтиСтроки(Новый Структура("НомерПравил", НомерПравилПИФ));
		Если НайдСтрокиПИФ.Количество() = 0 Тогда
			// ##Зарегистрировать оповещение или ошибку?
			Продолжить;	
		КонецЕсли;
		
		ТекущийПИФ = НайдСтрокиПИФ[0].ПИФ;
				
		ФайлОбработан = Ложь;
		Если ЭтоЗагрузкаУведомленияПоСчету Тогда
			ЗагрузитьУведомлениеПоЛицевомуСчету(ОбъектXDTO, ТекущийПИФ, ФайлОбработан, СтруктураДляПереименованияФайла, Отказ, ТочкаМаршрута = БизнесПроцессы.ОбменПаев.ТочкиМаршрута.ЗагрузкаНовогоЛицевогоСчета);
		ИначеЕсли ЭтоЗагрузкаООВП Тогда
			ЗагрузитьОтчетОВозможностиВыдачиПаев(ОбъектXDTO, ТекущийПИФ, ФайлОбработан, СтруктураДляПереименованияФайла, Отказ);
		ИначеЕсли ЭтоЗагрузкаЗачисленияПаев Или ЭтоЗагрузкаПогашенияПаев Или ЭтоЗагрузкаОбменаПаев Тогда
			
			ЗагрузитьОтчетОПроведенииОперацииПоЛицевомуСчету(
					ОбъектXDTO,
					ТекущийПИФ,
					ОбъектXDTO.processing_info.operation_type = "RECE",
					ФайлОбработан,
					СтруктураДляПереименованияФайла,
					Отказ,
					ОбработкаДвиженийПоПаям);		
		
		КонецЕсли;                                                             
		
		ЧтениеXML.Закрыть();
		
		Если Отказ Тогда
			// ##Зарегистрировать оповещение или ошибку?
		ИначеЕсли ФайлОбработан Тогда
			КоличествоФайловДляОбработки = КоличествоФайловДляОбработки - 1;
			ДанныеДляПереименованияФайлов.Добавить(СтруктураДляПереименованияФайла);
		КонецЕсли;
					
		Если КоличествоФайловДляОбработки = 0 Тогда
			Прервать;		
		КонецЕсли;
			
	КонецЦикла;
	
	Если (ЭтоЗагрузкаУведомленияПоСчету Или ЭтоЗагрузкаЗачисленияПаев Или ЭтоЗагрузкаООВП Или ЭтоЗагрузкаПогашенияПаев Или ЭтоЗагрузкаОбменаПаев)
		И КоличествоФайловДляОбработки > 0 Тогда
		Отказ = Истина;
		Возврат;
		// ##Зарегистрировать оповещение или ошибку?
		
	КонецЕсли;
	
	// Переименовываем и загружаем файлы
	Для Каждого СтруктураПереименования Из ДанныеДляПереименованияФайлов Цикл
			
		ФайлыДляПереименования = НайтиФайлы(ЭтотОбъект.КаталогОбмена, СтруктураПереименования.ИмяФайла + ".*", Ложь);
		
		Если ФайлыДляПереименования.Количество() = 0 Тогда
			Отказ = Истина;
			Возврат;
			// ##Зарегистрировать оповещение или ошибку?
		КонецЕсли;
				
		// Файлы подгружаем к документам:
		//  - уведомление об открытии/закрытии счета - к заявке
		//  - ООВП - ко вводу денежных средств
		//  - уведомление об операции по л/с - к зачислению/погашению паев		
		ДанныеФайловДляПрикрепления	= Новый Массив;
		
		Для Каждого ФайлДляПереименования Из ФайлыДляПереименования Цикл
			
			НовоеИмя = СтрШаблон("%1%2 от %3 по заявке %4%5",
				ЭтотОбъект.КаталогОбмена,
				СтруктураПереименования.ВидДокумента,
				Формат(СтруктураПереименования.ДатаДокумента, "ДФ=dd.MM.yyyy"),
				СтруктураПереименования.НомерЗаявки,
				ФайлДляПереименования.Расширение);
				
			ПереместитьФайл(ФайлДляПереименования.ПолноеИмя, НовоеИмя); 
							
			ДанныеФайловДляПрикрепления.Добавить(Новый Структура("ПолноеИмя,Хранение",
				НовоеИмя,
				ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(НовоеИмя))));	
			
		КонецЦикла;
						
		Если СтруктураПереименования.Свойство("ВводДенежныхСредств") Тогда
			ВладелецФайлов = СтруктураПереименования.ВводДенежныхСредств;
		ИначеЕсли СтруктураПереименования.Свойство("ЗачислениеПаев") Тогда
			ВладелецФайлов = СтруктураПереименования.ЗачислениеПаев;
		ИначеЕсли СтруктураПереименования.Свойство("ПогашениеПаев") Тогда
			ВладелецФайлов = СтруктураПереименования.ПогашениеПаев;	
		Иначе
			ВладелецФайлов = СтруктураПереименования.Заявка;
		КонецЕсли;
		
		ДанныеВерсий = Обработки.РаботаСФайлами.ПрисоединитьФайл(ВладелецФайлов, ДанныеФайловДляПрикрепления);
		
		Если ДанныеВерсий.Количество() = 0 Тогда
        	Отказ = Истина;
			Возврат;
			// ##Зарегистрировать оповещение или ошибку?
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьУведомлениеПоЛицевомуСчету(ОбъектXDTO, ПИФ, ФайлОбработан, СтруктураДляПереименованияФайла, Отказ, ПоЗаявкеНаОбмен = Ложь)

	Пайщик = ПайщикПоПаспортнымДанным(ОбъектXDTO.shareholder_id);
	
	Если Пайщик = Неопределено Тогда
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли; 
		
	// Основание операции может быть элементом или массивом
	Если ТипЗнч(ОбъектXDTO.reason_operation.doc) = Тип("ОбъектXDTO") Тогда
		ДатаЗаявки	= ДатаИзСтроки(ОбъектXDTO.reason_operation.doc.out_doc.out_doc_date);
		НомерЗаявки	= ОбъектXDTO.reason_operation.doc.out_doc.out_doc_num
	Иначе	
		ДатаЗаявки	= ДатаИзСтроки(ОбъектXDTO.reason_operation.doc[1].out_doc.out_doc_date);		
		НомерЗаявки	= ОбъектXDTO.reason_operation.doc[1].out_doc.out_doc_num;
	КонецЕсли;
		
	// Ищем заявку, в нее нужно записать новый лицевой счет	
	Заявка = ЗаявкаПоДаннымПайщика(
				Пайщик,
				ПИФ,
				НомерЗаявки,
				ДатаЗаявки,
				?(ПоЗаявкеНаОбмен,
					Перечисления.ВидыЗаявокПайщиков.Обмен,
					?(ОбъектXDTO.document_code = "DKRA_02", Перечисления.ВидыЗаявокПайщиков.Зачисление, Перечисления.ВидыЗаявокПайщиков.Погашение)),
				Отказ,
				ПоЗаявкеНаОбмен); 
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Задача, "Основание") <> Заявка Тогда		
		Возврат;
	КонецЕсли;
	
	СтруктураДляПереименованияФайла.Вставить("Заявка",		Заявка);
	СтруктураДляПереименованияФайла.Вставить("Пайщик",		Пайщик);
	СтруктураДляПереименованияФайла.Вставить("НомерЗаявки",	НомерЗаявки);
	
	ФайлОбработан = Истина;
	
	//Уведомление об открытии/изменении информации лицевого счета/изменении статуса (вида) лицевого счета
	Если ОбъектXDTO.document_code = "DKRA_02"
		И (ОбъектXDTO.account_id.account_status = "2" Или ОбъектXDTO.account_id.account_status = "3") 
	Тогда              
	
		ЛицевойСчет = ВыполнитьДействиеСЛицевымСчетом(
				?(ОбъектXDTO.account_id.account_status = "2", "Открытие", "Закрытие"),
				ДатаИзСтроки(Лев(ОбъектXDTO.processing_info.processing_datetime, 10)),
				ОбъектXDTO.account_id.account_id,
				Пайщик,
				ПИФ,
				Заявка,					
				Отказ);

		Если Отказ Тогда
			Возврат;
		КонецЕсли;
			      		
	КонецЕсли;
	
	// Уведомление об отказе в открытии/изменении информации лицевого счета/изменении статуса (вида) лицевого счета
	Если ОбъектXDTO.document_code = "DKRA_08" Тогда
		
		//Описание причины отказа
		ПричинаОтказа = ОбъектXDTO.description_refuse;
		// Рекомендуемые действия
		ТекстРекомендаций = ОбъектXDTO.action;
		
	КонецЕсли;
		
КонецПроцедуры

Функция ДатаИзСтроки(СтрокаДаты)

	Составляющие = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаДаты, "-");
	Возврат Дата(Число(Составляющие[0]), Число(Составляющие[1]), Число(Составляющие[2]));
	
КонецФункции

Функция ЗаявкаПоДаннымПайщика(Пайщик, ПИФ, НомерЗаявки, ДатаЗаявки, ВидЗаявки, Отказ, ЭтоПИФДляОбменаПаев = Ложь) 

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокументЗаявкаПайщика.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаявкаПайщика КАК ДокументЗаявкаПайщика
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЗаявокПайщиков.СрезПоследних(&ТекущаяДата, Организация = &Организация) КАК СтатусыЗаявокПайщиковСрезПоследних
		|		ПО (СтатусыЗаявокПайщиковСрезПоследних.Организация = ДокументЗаявкаПайщика.Организация)
		|			И (СтатусыЗаявокПайщиковСрезПоследних.ЗаявкаПайщика = ДокументЗаявкаПайщика.Ссылка)
		|			И (СтатусыЗаявокПайщиковСрезПоследних.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыЗаявокПайщиков.Отклонена))
		|ГДЕ
		|	ДокументЗаявкаПайщика.Организация = &Организация
		|	И ВЫБОР
		|			КОГДА &ЭтоПИФДляОбменаПаев
		|				ТОГДА ДокументЗаявкаПайщика.ПаевойИнвестиционныйФондДляОбменаПаев = &ПИФ
		|			ИНАЧЕ ДокументЗаявкаПайщика.ПаевойИнвестиционныйФонд = &ПИФ
		|		КОНЕЦ
		|	И ДокументЗаявкаПайщика.ВидЗаявки = &ВидЗаявки
		|	И ДокументЗаявкаПайщика.НомерЗаявки = &НомерЗаявки
		|	И НАЧАЛОПЕРИОДА(ДокументЗаявкаПайщика.Дата, ДЕНЬ) = &ДатаЗаявки
		|	И ДокументЗаявкаПайщика.Пайщик = &Пайщик
		|	И НЕ ДокументЗаявкаПайщика.ПометкаУдаления
		|	И СтатусыЗаявокПайщиковСрезПоследних.ЗаявкаПайщика ЕСТЬ НЕ NULL");
	
	Запрос.УстановитьПараметр("Организация",			ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ПИФ",					ПИФ);
	Запрос.УстановитьПараметр("ВидЗаявки",				ВидЗаявки);
	Запрос.УстановитьПараметр("Пайщик",					Пайщик);
	Запрос.УстановитьПараметр("НомерЗаявки",			НомерЗаявки);
	Запрос.УстановитьПараметр("ДатаЗаявки",				ДатаЗаявки);
	Запрос.УстановитьПараметр("ТекущаяДата",			ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ЭтоПИФДляОбменаПаев",	ЭтоПИФДляОбменаПаев);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		// ##Зарегистрировать оповещение или ошибку?
		Возврат Неопределено; 
	КонецЕсли;
	
КонецФункции

Функция ВыполнитьДействиеСЛицевымСчетом(ВидДействия, ДатаДействия, НомерСчета, Пайщик, ПИФ, ЗаявкаПайщика, Отказ)
	
	ДК_Регион = ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_ДК_Регион");
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитарныеСчета.Ссылка КАК ЛицевойСчет
		|ИЗ
		|	Справочник.ДепозитарныеСчета КАК ДепозитарныеСчета
		|ГДЕ
		|	ДепозитарныеСчета.НомерСчета = &НомерСчета
		|	И НЕ ДепозитарныеСчета.ПометкаУдаления
		|	И ДепозитарныеСчета.Организация = &Организация
		|	И ДепозитарныеСчета.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.Лицевой)
		|	И ДепозитарныеСчета.ВладелецСчета = &Пайщик
		|	И ДепозитарныеСчета.Эмитент = &ПИФ
		|	И ДепозитарныеСчета.Депозитарий = &ДК_Регион");
	
    Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("НомерСчета",		НомерСчета);
	Запрос.УстановитьПараметр("Пайщик",			Пайщик);
	Запрос.УстановитьПараметр("ПИФ",			ПИФ);
	Запрос.УстановитьПараметр("ДК_Регион",		ДК_Регион);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЛицевойСчет = Выборка.ЛицевойСчет;
		
		Если ВидДействия = "Закрытие" Тогда
			
			ЛицевойСчетОбъект				= ЛицевойСчет.ПолучитьОбъект();
			ЛицевойСчетОбъект.ДатаЗакрытия	= ДатаДействия;
			
			Попытка
				ЛицевойСчетОбъект.Записать();
			Исключение	     
				// ##Зарегистрировать оповещение или ошибку?	
				Отказ = Истина;
				Возврат Неопределено;
			КонецПопытки;
	
		КонецЕсли;
		
	ИначеЕсли ВидДействия = "Открытие" Тогда
		
		ЛицевойСчетОбъект = Справочники.ДепозитарныеСчета.СоздатьЭлемент();
		
		ЛицевойСчетОбъект.Организация   = ЭтотОбъект.Организация;
		ЛицевойСчетОбъект.ВладелецСчета = Пайщик;
		ЛицевойСчетОбъект.Депозитарий   = ДК_Регион;
		ЛицевойСчетОбъект.Эмитент		= ПИФ;
		ЛицевойСчетОбъект.ВладелецСчета	= Пайщик;
		ЛицевойСчетОбъект.ТипСчета		= Перечисления.ТипыДепозитарныхСчетов.Лицевой;
        ЛицевойСчетОбъект.НомерСчета	= НомерСчета;
		ЛицевойСчетОбъект.ДатаОткрытия	= ДатаДействия;
		
		ЛицевойСчетОбъект.Наименование = Справочники.ДепозитарныеСчета.СформироватьНаименование(ЛицевойСчетОбъект);
		
		Попытка
			ЛицевойСчетОбъект.Записать();
		Исключение	     
			// ##Зарегистрировать оповещение или ошибку?	
			Отказ = Истина;
			Возврат Неопределено;
		КонецПопытки;
		
		ЗаявкаОбъект = ЗаявкаПайщика.ПолучитьОбъект();
		
		Если ЗаявкаОбъект.ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Обмен Тогда
			ЗаявкаОбъект.ДепозитарныйСчетВПаевомИнвестиционномФондеДляОбмена		= ЛицевойСчетОбъект.Ссылка;
			ЗаявкаОбъект.ОткрытьДепозитарныйСчетВПаевомИнвестиционномФондеДляОбмена	= Ложь;			
		Иначе	
			ЗаявкаОбъект.ДепозитарныйСчет				= ЛицевойСчетОбъект.Ссылка;
			ЗаявкаОбъект.ОткрытьЗакрытьДепозитарныйСчет	= Ложь;
		КонецЕсли;
		
		Попытка
			ЗаявкаОбъект.Записать();
		Исключение
			// ##Зарегистрировать оповещение или ошибку?	
			Отказ = Истина;
			Возврат Неопределено;
		КонецПопытки;
		
		// У заявки на обмен может быть заявка на приобретение, лицевой счет нужно прикрепить и к ней
		Если ЗаявкаОбъект.ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Обмен Тогда
			
			ЗаявкаНаПриобретение = БизнесПроцессы.ОбменПаев.ЗаявкаНаПриобретениеПоЗаявкеНаОбменПаев(ЭтотОбъект.Организация, ЗаявкаПайщика);
			
			Если ЗаявкаНаПриобретение = Неопределено Тогда
				// ##Зарегистрировать оповещение или ошибку?	
				Отказ = Истина;
				Возврат Неопределено;
			КонецЕсли;
			
			ЗаявкаНаПриобретениеОбъект = ЗаявкаНаПриобретение.ПолучитьОбъект();
			ЗаявкаНаПриобретениеОбъект.ДепозитарныйСчет = ЛицевойСчетОбъект.Ссылка;
			ЗаявкаНаПриобретениеОбъект.ОткрытьЗакрытьДепозитарныйСчет = Ложь;
			
			Попытка
				ЗаявкаНаПриобретениеОбъект.Записать();
			Исключение
				// ##Зарегистрировать оповещение или ошибку?	
				Отказ = Истина;
				Возврат Неопределено;
			КонецПопытки;
			
		КонецЕсли;
		
		ЛицевойСчет = ЛицевойСчетОбъект.Ссылка;
		
	КонецЕсли;		
	
	Возврат ЛицевойСчет;
	
КонецФункции

Функция ПайщикПоПаспортнымДанным(ОбъектXDTO)
	
	// Предполагается только паспорт РФ
	Если ОбъектXDTO.ids.id.type <> "CCPT" Тогда
		// ##Зарегистрировать оповещение или ошибку?
		Возврат Неопределено;
	КонецЕсли;	
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо КАК Пайщик
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|ГДЕ
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ВидУдостоверенияЛичности = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ)
		|	И РеквизитыФизическихЛицАнкетныеСрезПоследних.СерияУдостоверенияЛичности = &СерияУдостоверенияЛичности
		|	И РеквизитыФизическихЛицАнкетныеСрезПоследних.НомерУдостоверенияЛичности = &НомерУдостоверенияЛичности");
	
    Запрос.УстановитьПараметр("Дата",			ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	
	Запрос.УстановитьПараметр("СерияУдостоверенияЛичности", ОбъектXDTO.ids.id.series);
	Запрос.УстановитьПараметр("НомерУдостоверенияЛичности", ОбъектXDTO.ids.id.number);                 
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Пайщик;
	Иначе	
		// ##Зарегистрировать оповещение или ошибку?
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции	
	
Процедура ЗагрузитьОтчетОВозможностиВыдачиПаев(ОбъектXDTO, ПИФ, ФайлОбработан, СтруктураДляПереименованияФайла, Отказ)
	
	Пайщик = ПайщикПоПаспортнымДанным(ОбъектXDTO.applications.application.shareholder_id);
	
	Если Пайщик = Неопределено Тогда
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли; 
	
	// Ищем заявку
	ДатаЗаявки = ДатаИзСтроки(ОбъектXDTO.applications.application.application_doc.out_doc.out_doc_date);
	Заявка = ЗаявкаПоДаннымПайщика(
				Пайщик,
				ПИФ,
				ОбъектXDTO.applications.application.application_doc.out_doc.out_doc_num,
				ДатаЗаявки,
				Перечисления.ВидыЗаявокПайщиков.Зачисление,
				Отказ); 
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Если задача по другой заявке, не загружаем
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Задача, "БизнесПроцесс.ЗаявкаПайщика") <> Заявка Тогда
		Возврат;
	КонецЕсли;	
	
	РеквизитыЗадачи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
				ЭтотОбъект.Задача,
				Новый Структура("НомерПлатежногоДокумента,ДатаПлатежногоДокумента,ВводДенежныхСредств",
					"БизнесПроцесс.ВводДенежныхСредств.СтрокаБанковскойВыписки.НомерПлатежногоДокумента",
					"БизнесПроцесс.ВводДенежныхСредств.СтрокаБанковскойВыписки.ДатаПлатежногоДокумента",
					"БизнесПроцесс.ВводДенежныхСредств"));
				
	Если ТипЗнч(ОбъектXDTO.applications.application.orders.order) = Тип("ОбъектXDTO") Тогда
		
		// Сравниваем дату и номер платежки
		ДатаПлатежногоПоручения		= ДатаИзСтроки(ОбъектXDTO.applications.application.orders.order.order_date);
		НомерПлатежногоПоручения	= ОбъектXDTO.applications.application.orders.order.order_number;
		
		Если Не (РеквизитыЗадачи.НомерПлатежногоДокумента = НомерПлатежногоПоручения
				И РеквизитыЗадачи.ДатаПлатежногоДокумента = ДатаПлатежногоПоручения) Тогда
			Возврат;
		КонецЕсли;
	
	Иначе
		
		// Проверяем весь дату и номер у каждого элемента массива
		НашлиПлатежку = Ложь;
		Для Каждого ТекДокумент Из ОбъектXDTO.applications.application.orders.order Цикл
				
			ДатаПлатежногоПоручения		= ДатаИзСтроки(ТекДокумент.order_date);
			НомерПлатежногоПоручения	= ТекДокумент.order_number;
					
			Если РеквизитыЗадачи.НомерПлатежногоДокумента = НомерПлатежногоПоручения
				И РеквизитыЗадачи.ДатаПлатежногоДокумента = ДатаПлатежногоПоручения Тогда
				НашлиПлатежку = Истина;
				Прервать;
			КонецЕсли;	
			
		КонецЦикла;
		
		Если Не НашлиПлатежку Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураДляПереименованияФайла.Вставить("Заявка",		Заявка);
	СтруктураДляПереименованияФайла.Вставить("Пайщик",		Пайщик);
	СтруктураДляПереименованияФайла.Вставить("НомерЗаявки",	ОбъектXDTO.applications.application.application_doc.out_doc.out_doc_num);
	
	СтруктураДляПереименованияФайла.Вставить("ВводДенежныхСредств", РеквизитыЗадачи.ВводДенежныхСредств);
	
	ФайлОбработан = Истина;	
	
	ООВП		= ОбъектXDTO.applications.application.ability = "Yes";
	НомерООВП	= ОбъектXDTO.header.doc_num;
	
	ЗадачаОбъект = ЭтотОбъект.Задача.ПолучитьОбъект();
	ЗадачаОбъект.ОтветОВозможностиЗачисленияПаев = ?(ООВП,
		Перечисления.ВариантыОтветаНаЗаявкуПайщикаОЗачисленииПаев.ПолученОтчетОВозможностиВыдачиПаев,
		Перечисления.ВариантыОтветаНаЗаявкуПайщикаОЗачисленииПаев.ПолученОтчетОНевозможностиВыдачиПаев);
		
	Если ООВП Тогда	
		ЗадачаОбъект.НомерОтчетаОВозможностиЗачисленияПаев = НомерООВП;
	КонецЕсли;
	
	Попытка
		ЗадачаОбъект.Записать();
	Исключение                                    
		Отказ = Истина;
		//##Зарегистрировать оповещение или ошибку?
	КонецПопытки;			
			
КонецПроцедуры

Процедура ЗагрузитьОтчетОПроведенииОперацииПоЛицевомуСчету(ОбъектXDTO, ПИФ, ЭтоЗагрузкаЗачисленияПаев, ФайлОбработан, СтруктураДляПереименованияФайла, Отказ, ОбработкаДвиженийПоПаям)

	Пайщик = ПайщикПоПаспортнымДанным(ОбъектXDTO.shareholder_id);
	
	Если Пайщик = Неопределено Тогда
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли; 
	
	ЭтоОбменПаев = ОбъектXDTO.processing_info.operation_name = "Обмен паев";
	
	// Ищем заявку
	ДатаЗаявки = ДатаИзСтроки(ОбъектXDTO.application_doc.out_doc.out_doc_date);
	Заявка = ЗаявкаПоДаннымПайщика(
				Пайщик,
				ПИФ,
				ОбъектXDTO.application_doc.out_doc.out_doc_num,
				ДатаЗаявки,
				?(ЭтоОбменПаев, 
					Перечисления.ВидыЗаявокПайщиков.Обмен,
					?(ЭтоЗагрузкаЗачисленияПаев, Перечисления.ВидыЗаявокПайщиков.Зачисление, Перечисления.ВидыЗаявокПайщиков.Погашение)),
				Отказ, 
				ЭтоЗагрузкаЗачисленияПаев И ЭтоОбменПаев); 
		
	// Если задача по другой заявке, не загружаем
	Если ЭтоЗагрузкаЗачисленияПаев
		И Не ЭтоОбменПаев
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Задача, "БизнесПроцесс.ЗаявкаПайщика") <> Заявка Тогда
		Возврат;				
	ИначеЕсли (Не ЭтоЗагрузкаЗачисленияПаев Или ЭтоОбменПаев)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Задача, "БизнесПроцесс.Основание") <> Заявка Тогда
		Возврат;
	КонецЕсли;
	
	ФайлОбработан = Истина;
	
	СтруктураДляПереименованияФайла.Вставить("Заявка",		Заявка);
	СтруктураДляПереименованияФайла.Вставить("Пайщик",		Пайщик);
	СтруктураДляПереименованияФайла.Вставить("НомерЗаявки",	ОбъектXDTO.application_doc.out_doc.out_doc_num);
	
	КоличествоПаев		= Число(ОбъектXDTO.processing_info.unit_quantity.units);
	Сумма				= Число(ОбъектXDTO.processing_info.unit_cost.amount);
	СуммаНадбавкиСкидки	= Число(ОбъектXDTO.processing_info.premium_discount.amount.amount);
	
	Если ЭтоОбменПаев Тогда
		
		// При обмене паев требуются данные двух файлов, данные из первого файла сохраняем в хранилище
		Если ПустаяСтрока(ОбработкаДвиженийПоПаям.АдресВоВременномХранилище) Тогда
			
			УведомлениеРегистратора = ?(ЭтоЗагрузкаЗачисленияПаев,
							"",
							ОбъектXDTO.header.doc_name + " №" + ОбъектXDTO.header.doc_num + " от " + Формат(ДатаИзСтроки(ОбъектXDTO.header.doc_date), "ДФ=dd.MM.yyyy"));
							
			ОбработкаДвиженийПоПаям.АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(
					Новый Структура("ПИФ, КоличествоПаев, Сумма, УведомлениеРегистратора", ПИФ, КоличествоПаев, Сумма, УведомлениеРегистратора));
			
			Возврат;
			
		Иначе
			
			ДанныеПервогоФайла = ПолучитьИзВременногоХранилища(ОбработкаДвиженийПоПаям.АдресВоВременномХранилище);
			
			ОбработкаДвиженийПоПаям.Дата						= ДатаИзСтроки(Лев(ОбъектXDTO.processing_info.processing_datetime, 10));
			ОбработкаДвиженийПоПаям.ПаевойИнвестиционныйФонд	= ?(ЭтоЗагрузкаЗачисленияПаев, ДанныеПервогоФайла.ПИФ, ПИФ);
			ОбработкаДвиженийПоПаям.ЗаявкаПайщика				= Заявка;
			
			ОбработкаДвиженийПоПаям.ЗаполнитьОбменыПаев(Ложь);
			
			НайдСтроки = ОбработкаДвиженийПоПаям.ОбменыПаев.НайтиСтроки(Новый Структура("Заявка", Заявка));
		
			Если НайдСтроки.Количество() <> 1 Тогда
				// ##Ошибка
				Отказ = Истина;
				Возврат;
			КонецЕсли;
			
			Если НайдСтроки[0].СуммаПогашения			= ?(ЭтоЗагрузкаЗачисленияПаев, ДанныеПервогоФайла.Сумма, Сумма)
				И НайдСтроки[0].КоличествоПогашения		= ?(ЭтоЗагрузкаЗачисленияПаев, ДанныеПервогоФайла.КоличествоПаев, КоличествоПаев)
				И НайдСтроки[0].СуммаЗачисления			= ?(ЭтоЗагрузкаЗачисленияПаев, Сумма, ДанныеПервогоФайла.Сумма)
				И НайдСтроки[0].КоличествоЗачисления	= ?(ЭтоЗагрузкаЗачисленияПаев, КоличествоПаев, ДанныеПервогоФайла.КоличествоПаев) Тогда
				
				// Наши параметры совпали, создаем документы по обмену паев
				
				НайдСтроки[0].Обрабатывать = Истина;
				
				СтрУведомлениеРегистратора = ?(ЭтоЗагрузкаЗачисленияПаев,
				        ДанныеПервогоФайла.УведомлениеРегистратора,
						ОбъектXDTO.header.doc_name + " №" + ОбъектXDTO.header.doc_num + " от " + Формат(ДатаИзСтроки(ОбъектXDTO.header.doc_date), "ДФ=dd.MM.yyyy"));
				
				ОбработкаДвиженийПоПаям.СформироватьОбменыПаев(СтрУведомлениеРегистратора, Отказ, СтруктураДляПереименованияФайла);
				
				Если Отказ Тогда
					Возврат;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;	
		
	ИначеЕсли ЭтоЗагрузкаЗачисленияПаев Тогда
			
		ОбработкаДвиженийПоПаям.Дата						= ДатаИзСтроки(Лев(ОбъектXDTO.processing_info.processing_datetime, 10));
		ОбработкаДвиженийПоПаям.ПаевойИнвестиционныйФонд	= ПИФ;
		ОбработкаДвиженийПоПаям.ЗаявкаПайщика				= Заявка;
		
		ОбработкаДвиженийПоПаям.ЗаполнитьЗачисленияПаев(Ложь);
			
		НайдСтроки = ОбработкаДвиженийПоПаям.ЗачисленияПаев.НайтиСтроки(Новый Структура("Сумма", Сумма));
		
		Если НайдСтроки.Количество() <> 1 Тогда
			// ##Ошибка
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если //НайдСтроки[0].Сумма = Сумма
			НайдСтроки[0].Количество = КоличествоПаев
			И НайдСтроки[0].СуммаНадбавки = СуммаНадбавкиСкидки Тогда
			
			// Наши параметры совпали, создаем документ зачисления паев
			
			НайдСтроки[0].Обрабатывать = Истина;		             
			ОбработкаДвиженийПоПаям.СформироватьЗачисленияПаев(Отказ, СтруктураДляПереименованияФайла);
			
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
					
		Иначе
			// ##Ошибка
			Отказ = Истина;
		КонецЕсли;
		
	Иначе
		
		ОбработкаДвиженийПоПаям.Дата						= ДатаИзСтроки(Лев(ОбъектXDTO.processing_info.processing_datetime, 10));
		ОбработкаДвиженийПоПаям.ПаевойИнвестиционныйФонд	= ПИФ;
		ОбработкаДвиженийПоПаям.ЗаявкаПайщика				= Заявка;
		
		ОбработкаДвиженийПоПаям.ЗаполнитьПогашенияПаев(Ложь);
			
		НайдСтроки = ОбработкаДвиженийПоПаям.ПогашенияПаев.НайтиСтроки(Новый Структура("Заявка", Заявка));
		
		Если НайдСтроки.Количество() <> 1 Тогда
			// ##Ошибка
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если НайдСтроки[0].Сумма = Сумма
			И НайдСтроки[0].Количество = КоличествоПаев
			И НайдСтроки[0].СуммаСкидки = СуммаНадбавкиСкидки Тогда
			
			// Наши параметры совпали, создаем документ погашения паев
			
			НайдСтроки[0].Обрабатывать = Истина;
			
			СтрУведомлениеРегистратора = ОбъектXDTO.header.doc_name + " №" + ОбъектXDTO.header.doc_num + " от " + Формат(ДатаИзСтроки(ОбъектXDTO.header.doc_date), "ДФ=dd.MM.yyyy");
			
			ОбработкаДвиженийПоПаям.СформироватьПогашенияПаев(СтрУведомлениеРегистратора, Отказ, СтруктураДляПереименованияФайла);
			
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
					
		Иначе
			// ##Ошибка
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура ЗагрузитьОтчетОбИсполненныхОперацияхЗаДень(ОбъектXDTO, ПИФ, ФайлОбработан, ТочкаМаршрута, Отказ) 
	
	ДатаСверки = ДатаИзСтроки(ОбъектXDTO.statement_date);
	
	Если ТипЗнч(ОбъектXDTO.executed_transactions) = Тип("ОбъектXDTO") Тогда
		// Одна операция за день
		ЗагрузитьОперациюИзОтчетаЗаДень(ОбъектXDTO.executed_transactions.executed_transaction, ПИФ, ДатаСверки, ФайлОбработан, ТочкаМаршрута, Отказ);
	Иначе
		
		// Массив операций
		Для Каждого ТекОперация Из ОбъектXDTO.executed_transactions Цикл
			ЗагрузитьОперациюИзОтчетаЗаДень(ТекОперация, ПИФ, ДатаСверки, ФайлОбработан, ТочкаМаршрута, Отказ);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьОперациюИзОтчетаЗаДень(ОбъектXDTO, ПИФ, ДатаСверки, ФайлОбработан, ТочкаМаршрута, Отказ)
	
	ЭтоПогашение = ОбъектXDTO.operation_type = "DELI";
	
	Пайщик = ПайщикПоПаспортнымДанным(ОбъектXDTO.shareholder_id);
	
	Если Пайщик = Неопределено Тогда
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли; 
	
	// Ищем заявку
	ДатаЗаявки = ДатаИзСтроки(ОбъектXDTO.application_info.out_doc.out_doc_date);
	Заявка = ЗаявкаПоДаннымПайщика(
				Пайщик,
				ПИФ,
				ОбъектXDTO.application_info.out_doc.out_doc_num,
				ДатаЗаявки,
				?(ЭтоПогашение, Перечисления.ВидыЗаявокПайщиков.Погашение, Перечисления.ВидыЗаявокПайщиков.Зачисление),
				Отказ); 
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Если задача по другой заявке, не загружаем
	
	Если (ТочкаМаршрута = БизнесПроцессы.ЗачислениеПаев.ТочкиМаршрута.ЗагрузкаДетальногоОтчетаПоИсполненнымОперациямОтДК 
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Задача, "БизнесПроцесс.ЗаявкаПайщика") = Заявка)
		Или ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Задача, "БизнесПроцесс.Основание") = Заявка Тогда
		
		ФайлОбработан = Истина;
		
		КоличествоПаев				= Число(ОбъектXDTO.unit_quantity.units);
		СуммаЗачисленияПогашения	= Число(ОбъектXDTO.amount.amount);
		СуммаНадбавкиСкидки			= Число(ОбъектXDTO.premium_discount.amount);
			
		Если ЭтоПогашение Тогда
			
			// Документ погашения паев уже создан, просто ищем его и сравниваем
			Запрос = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ПогашениеПаевПартии.Ссылка КАК Ссылка,
				|	СУММА(ПогашениеПаевПартии.СуммаСкидки) КАК СуммаСкидки
				|ИЗ
				|	Документ.ПогашениеПаев.Партии КАК ПогашениеПаевПартии
				|ГДЕ
				|	ПогашениеПаевПартии.Ссылка.Организация = &Организация
				|	И ПогашениеПаевПартии.Ссылка.Проведен
				|	И ПогашениеПаевПартии.Ссылка.Дата МЕЖДУ &НачалоДня И &КонецДня
				|	И ПогашениеПаевПартии.Ссылка.ПаевойИнвестиционныйФонд = &ПИФ
				|	И ПогашениеПаевПартии.Ссылка.Заявка = &Заявка
				|	И ПогашениеПаевПартии.Ссылка.Сумма = &СуммаПогашения
				|	И ПогашениеПаевПартии.Ссылка.Количество = &КоличествоПаев
				|
				|СГРУППИРОВАТЬ ПО
				|	ПогашениеПаевПартии.Ссылка
				|
				|ИМЕЮЩИЕ
				|	СУММА(ПогашениеПаевПартии.СуммаСкидки) = &СуммаСкидки");
			
			Запрос.УстановитьПараметр("Организация",		ЭтотОбъект.Организация);
			Запрос.УстановитьПараметр("НачалоДня",			ДатаСверки);
			Запрос.УстановитьПараметр("КонецДня",			КонецДня(ДатаСверки));
			Запрос.УстановитьПараметр("ПИФ",				ПИФ);
			Запрос.УстановитьПараметр("Заявка",				Заявка);
			Запрос.УстановитьПараметр("СуммаПогашения",		СуммаЗачисленияПогашения);
			Запрос.УстановитьПараметр("КоличествоПаев",		КоличествоПаев);
			Запрос.УстановитьПараметр("СуммаСкидки",		СуммаНадбавкиСкидки);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Количество() <> 1 Тогда
				
				Отказ = Истина;
				// ##Разбор ошибок
					
			КонецЕсли;
			
		Иначе
				
			// Документ зачисления паев уже создан, просто ищем его и сравниваем
			Запрос = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЗачислениеПаев.Ссылка КАК Ссылка
				|ИЗ
				|	Документ.ЗачислениеПаев КАК ЗачислениеПаев
				|ГДЕ
				|	ЗачислениеПаев.Организация = &Организация
				|	И ЗачислениеПаев.Проведен
				|	И ЗачислениеПаев.Дата МЕЖДУ &НачалоДня И &КонецДня
				|	И ЗачислениеПаев.ПаевойИнвестиционныйФонд = &ПИФ
				|	И ЗачислениеПаев.Заявка = &Заявка
				|	И ЗачислениеПаев.Сумма = &СуммаЗачисления
				|	И ЗачислениеПаев.Количество = &КоличествоПаев
				|	И ЗачислениеПаев.СуммаНадбавки = &СуммаНадбавки");
			
			Запрос.УстановитьПараметр("Организация",		ЭтотОбъект.Организация);
			Запрос.УстановитьПараметр("НачалоДня",			ДатаСверки);
