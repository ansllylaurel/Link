		ЧтениеАрхива = Новый ЧтениеZipФайла(ФайлЗагрузкиZIP.ПолноеИмя);
		
		// Извлекаем только xml, pdf и sig
		Для Каждого ЭлементАрхива Из ЧтениеАрхива.Элементы Цикл
			Если ЭлементАрхива.Расширение = "xml"
				Или ЭлементАрхива.Расширение = "pdf"
				Или ЭлементАрхива.Расширение = "sig" Тогда
