			Запрос.УстановитьПараметр("СуммаНадбавки",		СуммаНадбавкиСкидки);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Количество() <> 1 Тогда
				
				Отказ = Истина;
				// ##Разбор ошибок
					
			КонецЕсли;

		КонецЕсли;
		
