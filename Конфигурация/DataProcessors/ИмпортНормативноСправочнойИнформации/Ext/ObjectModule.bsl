// ПОЛЬЗОВАТЕЛЬСКИЕ ФУНКЦИИ, ОБРАБАТЫВАЕМЫЕ В ЗАПРОСАХ

Функция ВычислитьЗначениеПоля(Знач Выражение, Параметры)
	
	Если ПустаяСтрока(Выражение) Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	ЗнчПоля = Неопределено;
		
	// сначала попытаемся найти значение в параметрах
	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		Попытка
			Если Параметры.Свойство(Выражение, ЗнчПоля) Тогда
				Возврат ЗнчПоля;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	// работают математические, логические выражения, операции конкатенации
	Попытка
		ЗнчПоля = Вычислить(?(Лев(Выражение, 1) = ".", "Параметры.ЗначенияПолей", "") + Выражение);
	Исключение
		ВызватьИсключение("Не удалось вычислить выражение «" + Выражение + "». Система сообщает: " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат ЗнчПоля;
	
КонецФункции // ВычислитьЗначениеПоля

Функция ПолучитьОбъектПоКодуВнешнейСистемы(Параметры, КодВоВнешСистеме, Знач ГруппаОбъектов, ИмпортироватьПриОтсутствии = Ложь) Экспорт
	
	Если КодВоВнешСистеме = "NULL" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ГруппаОбъектов) = Тип("Строка") Тогда
		ИмяГруппыОбъектов = ГруппаОбъектов;
		ГруппаОбъектов    = Справочники.ГруппыИмпортируемыхОбъектов.ПолучитьГруппуОбъекта(ИмяГруппыОбъектов, Ложь);
		Если Не ЗначениеЗаполнено(ГруппаОбъектов) Тогда
			ВызватьИсключение("Не удалось получить группу объектов по имени «" + ИмяГруппыОбъектов + "»");
		КонецЕсли;
	КонецЕсли;
	
	// первым делом, проверим наличие объекта в списке обработанных объектов
	ГруппаОбработанныхОбъектов = Неопределено;
	ОбработанныеОбъекты        = Неопределено;
	
	Если Параметры.Свойство("ГруппаОбъектов", ГруппаОбработанныхОбъектов) и Параметры.Свойство("ОбработанныеОбъекты", ОбработанныеОбъекты) Тогда
		Если ГруппаОбъектов = ГруппаОбработанныхОбъектов и ТипЗнч(ОбработанныеОбъекты) = Тип("ТаблицаЗначений") Тогда
			СтрокаОбработанныеОбъекты = ОбработанныеОбъекты.Найти(КодВоВнешСистеме, "Идентификатор");
			Если СтрокаОбработанныеОбъекты <> Неопределено Тогда
				Возврат СтрокаОбработанныеОбъекты.Объект;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// следующим делом, проверим в кэше
	ИмяКэша     = "КэшКодыВоВнешнихСистемах";
	КэшОбъектов = Неопределено;
	КлючПоиска  = Новый Структура("ГруппаОбъектов, Код", ГруппаОбъектов, КодВоВнешСистеме);
	
	Если Не Параметры.Свойство(ИмяКэша, КэшОбъектов) Тогда
		КэшОбъектов = РаботаСКоллекциями.Кэширование_СоздатьКэш(КлючПоиска);
		Параметры.Вставить(ИмяКэша, КэшОбъектов);
		
	Иначе
		ЗнчНайдено = Неопределено;
		
		ЗнчИзКэша = РаботаСКоллекциями.Кэширование_НайтиЗначение(КэшОбъектов, КлючПоиска, ЗнчНайдено);
		Если ЗнчНайдено Тогда
			Возврат ЗнчИзКэша;
		КонецЕсли;
	КонецЕсли;
	
	// поиск в базе данных
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Объект
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&Период,
		|			ВнешняяСистема = &ВнешняяСистема
		|				И ГруппаОбъектов = &ГруппаОбъектов
		|				И Код = &Код) КАК КодыВоВнешнихСистемахСрезПоследних";
		
	Запрос.УстановитьПараметр("Период",         ТекущаяДата());
	Запрос.УстановитьПараметр("ВнешняяСистема", Параметры.ВнешняяСистема);
	Запрос.УстановитьПараметр("ГруппаОбъектов", ГруппаОбъектов);
	Запрос.УстановитьПараметр("Код",            КодВоВнешСистеме);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		Если ИмпортироватьПриОтсутствии Тогда
			
			Отбор = Новый Структура;
			Отбор.Вставить("ГруппаОбъектов",		ГруппаОбъектов);
			Отбор.Вставить("КодВоВнешнейСистеме",	КодВоВнешСистеме);
			
			ОбъектПоЦиклическойСсылке = НовыеОбъекты.НайтиСтроки(Отбор);
			
			Если ОбъектПоЦиклическойСсылке.Количество() > 0 Тогда
				ВызватьИсключение("Не удалось найти и импортировать объект из группы объектов «" + ГруппаОбъектов + "» по коду «" + КодВоВнешСистеме + "»!
								|Обнаружена циклическая ссылка.");
			Иначе
				НоваяСтрока						= НовыеОбъекты.Добавить();
				НоваяСтрока.ГруппаОбъектов		= ГруппаОбъектов;
				НоваяСтрока.КодВоВнешнейСистеме	= КодВоВнешСистеме;
			КонецЕсли;
				
			ОбработкаИмпортНСИ = Обработки.ИмпортНормативноСправочнойИнформации.Создать();
			ОбработкаИмпортНСИ.ГруппаПравил   = ЭтотОбъект.ГруппаПравил;
			ОбработкаИмпортНСИ.ГруппаОбъектов = ГруппаОбъектов;
			ОбработкаИмпортНСИ.Подразделение  = ЭтотОбъект.Подразделение;
			ОбработкаИмпортНСИ.Язык           = ЭтотОбъект.Язык;
			
			ОбработкаИмпортНСИ.НеСообщатьОСозданииНовыхОбъектов = Истина;
			ОбработкаИмпортНСИ.НеСообщатьОбИзмененииОбъектов    = Истина;
			
			ОбработкаИмпортНСИ.НовыеОбъекты.Загрузить(НовыеОбъекты.Выгрузить());
			
			СтрокаИмпортируемыеОбъекты = ОбработкаИмпортНСИ.ИмпортируемыеОбъекты.Добавить();
			СтрокаИмпортируемыеОбъекты.КодВоВнешнейСистеме = КодВоВнешСистеме;
			
			Если ОбработкаИмпортНСИ.ИмпортироватьДанные(, , Параметры.ГлубинаРекурсии) = Неопределено Тогда
				ВызватьИсключение("Не удалось найти и импортировать объект из группы объектов «" + ГруппаОбъектов + "» по коду «" + КодВоВнешСистеме + "»");
			КонецЕсли;
			
			НовыеОбъекты.Загрузить(ОбработкаИмпортНСИ.НовыеОбъекты.Выгрузить());
			
			РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ОбработкаИмпортНСИ.ИнформацияОбОбновлении, ИнформацияОбОбновлении);
			
			// повторно выполним запрос по поиску элемента
			Выборка = Запрос.Выполнить().Выбрать();
			Если Не Выборка.Следующий() Тогда
				ВызватьИсключение("Не удалось найти и импортировать объект из группы объектов «" + ГруппаОбъектов + "» по коду «" + КодВоВнешСистеме + "»");
			КонецЕсли;
		Иначе
			ВызватьИсключение("Не удалось найти объект из группы объектов «" + ГруппаОбъектов + "» по коду «" + КодВоВнешСистеме + "»");
		КонецЕсли;
	КонецЕсли;	
	
	// закэшируем
	РаботаСКоллекциями.Кэширование_ДобавитьЗначение(КэшОбъектов, КлючПоиска, Выборка.Объект);
	Параметры[ИмяКэша] = КэшОбъектов;
		
	Возврат Выборка.Объект;
	
КонецФункции // ПолучитьОбъектПоКодуВнешнейСистемы

Функция ПолучитьСправочникПоРеквизиту(Параметры, ЗнчРеквизита, ИмяОбъектаМД, ИмяРеквизита)
	
	// первым делом проверим в кэше
	ИмяКэша     = "КэшСправочникиПоРеквизиту";
	КэшОбъектов = Неопределено;
	КлючПоиска  = Новый Структура("ИмяОбъектаМД, ИмяРеквизита, ЗнчРеквизита", ИмяОбъектаМД, ИмяРеквизита, ЗнчРеквизита);
	
	Если Не Параметры.Свойство(ИмяКэша, КэшОбъектов) Тогда
		КэшОбъектов = РаботаСКоллекциями.Кэширование_СоздатьКэш(КлючПоиска);
		Параметры.Вставить(ИмяКэша, КэшОбъектов);
		
	Иначе
		ЗнчНайдено = Неопределено;
		
		ЗнчИзКэша = РаботаСКоллекциями.Кэширование_НайтиЗначение(КэшОбъектов, КлючПоиска, ЗнчНайдено);
		Если ЗнчНайдено Тогда
			Возврат ЗнчИзКэша;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Ссылка
		|ИЗ
		|	Справочник." + ИмяОбъектаМД + "
		|ГДЕ
		|	" + ИмяРеквизита + " = &ЗнчРеквизита";
		
	Запрос.УстановитьПараметр("ЗнчРеквизита", ЗнчРеквизита);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение("Не удалось найти элемент справочника «" + ИмяОбъектаМД + "» по значению «" + ЗнчРеквизита + "» реквизита «" + ИмяРеквизита + "»");
	КонецЕсли;	
	
	РаботаСКоллекциями.Кэширование_ДобавитьЗначение(КэшОбъектов, КлючПоиска, Выборка.Ссылка);
	Параметры[ИмяКэша] = КэшОбъектов;
	
	Возврат Выборка.Ссылка;
	
КонецФункции // ПолучитьСправочникПоРеквизиту

Функция ПолучитьФункциональнуюРольЮрФизЛица(Параметры, ЮрФизЛицо, ВидФункциональнойРоли) Экспорт
	
	// вместо прямого значения юр. или физ. лицом может быть ссылка на другое поле
	Если ЮрФизЛицо = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Если (ТипЗнч(ЮрФизЛицо) = Тип("Строка")) и (ТипЗнч(Параметры) = Тип("Структура")) Тогда
		ЗначенияПолей = Неопределено; 
		Если (Лев(ЮрФизЛицо, 1) = "*") и (Параметры.Свойство("ЗначенияПолей", ЗначенияПолей) <> Неопределено) Тогда
			ИмяПоля = Сред(ЮрФизЛицо, 2);
			Если ЗначенияПолей.Свойство(ИмяПоля, ЮрФизЛицо) = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// первым делом проверим в кэше
	ИмяКэша     = "КэшФункциональныхРолейЮрФизЛица";
	КэшОбъектов = Неопределено;
	КлючПоиска  = Новый Структура("ВидФункциональнойРоли, ЮрФизЛицо", ВидФункциональнойРоли, ЮрФизЛицо);
	
	Если Не Параметры.Свойство(ИмяКэша, КэшОбъектов) Тогда
		КэшОбъектов = РаботаСКоллекциями.Кэширование_СоздатьКэш(КлючПоиска);
		Параметры.Вставить(ИмяКэша, КэшОбъектов);
		
	Иначе
		ЗнчНайдено = Неопределено;
		
		ЗнчИзКэша = РаботаСКоллекциями.Кэширование_НайтиЗначение(КэшОбъектов, КлючПоиска, ЗнчНайдено);
		Если ЗнчНайдено Тогда
			Возврат ЗнчИзКэша;
		КонецЕсли;
	КонецЕсли;
	
	// поиск в базе данных
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Ссылка
		|ИЗ
		|	Справочник." + ВидФункциональнойРоли + "
		|ГДЕ
		|	ЮрФизЛицо = &ЮрФизЛицо";
		
	Запрос.УстановитьПараметр("ЮрФизЛицо", ЮрФизЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ФункциональнаяРоль = Справочники[ВидФункциональнойРоли].СоздатьЭлемент();
		ФункциональнаяРоль.ЮрФизЛицо    = ЮрФизЛицо;
		ФункциональнаяРоль.Наименование = ЮрФизЛицо.Наименование;
		ФункциональнаяРоль.Записать();
		
		ФункциональнаяРоль = ФункциональнаяРоль.Ссылка;
	Иначе
		ФункциональнаяРоль = Выборка.Ссылка;
	КонецЕсли;	
	
	// кэширование
	РаботаСКоллекциями.Кэширование_ДобавитьЗначение(КэшОбъектов, КлючПоиска, ФункциональнаяРоль);
	Параметры[ИмяКэша] = КэшОбъектов;
	
	Возврат ФункциональнаяРоль;

КонецФункции // ПолучитьФункциональнуюРольЮрФизЛица

Функция ПолучитьФункциональнуюРольБанка(Параметры, БИК, ЮрФизЛицо)
	
	ФункциональнаяРоль = Неопределено;
	
	// в матрихе для банков-нерезов могут завести БИК, состоящий из нулей
	Если ПустаяСтрока(СтрЗаменить(БИК, "0", "")) Тогда
		Возврат ФункциональнаяРоль;
	КонецЕсли;
	
	// вместо прямого значения юр. лицом может быть ссылка на другое поле
	Если (ТипЗнч(ЮрФизЛицо) = Тип("Строка")) и (ТипЗнч(Параметры) = Тип("Структура")) Тогда
		ЗначенияПолей = Неопределено; 
		Если (Лев(ЮрФизЛицо, 1) = "*") и (Параметры.Свойство("ЗначенияПолей", ЗначенияПолей) <> Неопределено) Тогда
			ИмяПоля = Сред(ЮрФизЛицо, 2);
			Если ЗначенияПолей.Свойство(ИмяПоля, ЮрФизЛицо) = Неопределено Тогда
				ВызватьИсключение("Не удалось получить значение поля «" + ИмяПоля + "»");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// первым делом, проверим значение в кэше
	ИмяКэша     = "КэшФункциональныхРолейБанков";
	КэшОбъектов = Неопределено;
	КлючПоиска  = Новый Структура("БИК, ЮрФизЛицо", БИК, ЮрФизЛицо);
	
	Если НЕ Параметры.Свойство(ИмяКэша, КэшОбъектов) Тогда
		КэшОбъектов = РаботаСКоллекциями.Кэширование_СоздатьКэш(КлючПоиска);
		Параметры.Вставить(ИмяКэша, КэшОбъектов);
		
	Иначе
		ЗнчНайдено = Неопределено;
		
		ЗнчИзКэша = РаботаСКоллекциями.Кэширование_НайтиЗначение(КэшОбъектов, КлючПоиска, ЗнчНайдено);
		Если ЗнчНайдено Тогда
			Возврат ЗнчИзКэша;
		КонецЕсли;
	КонецЕсли;
		
	// поиск в базе данных
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Банки.Ссылка КАК ФункциональнаяРоль,
		|	Банки.ЮрФизЛицо
		|ИЗ
		|	Справочник.Банки КАК Банки
		|ГДЕ
		|	Банки.Код = &БИК";

	Запрос.УстановитьПараметр("БИК", БИК);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		// ТехДолг: временно для ВТБ отключаем смену юр. лица по БИК 044525187
		//Если Не ЗначениеЗаполнено(Выборка.ЮрФизЛицо) Или Выборка.ЮрФизЛицо <> ЮрФизЛицо Тогда
		Если БИК <> "044525187" И (Не ЗначениеЗаполнено(Выборка.ЮрФизЛицо) Или Выборка.ЮрФизЛицо <> ЮрФизЛицо) Тогда
		
			УстановитьПривилегированныйРежим(Истина);
			
			ФункциональнаяРоль = Выборка.ФункциональнаяРоль.ПолучитьОбъект();
			ФункциональнаяРоль.ЮрФизЛицо = ЮрФизЛицо;
			ФункциональнаяРоль.Записать();
			
			УстановитьПривилегированныйРежим(Ложь);
			
		КонецЕсли;
		
		ФункциональнаяРоль = Выборка.ФункциональнаяРоль;
		
	Иначе
		// т.к. в Матрихе много ссылок на устаревшую хрень
		//ВызватьИсключение("Не удалось найти банк по БИК «" + БИК + "». Загрузите банки из классификатора и повторите попытку");
	КонецЕсли;

	// кэширование
	РаботаСКоллекциями.Кэширование_ДобавитьЗначение(КэшОбъектов, КлючПоиска, ФункциональнаяРоль);
	Параметры[ИмяКэша] = КэшОбъектов;
	
	Возврат ФункциональнаяРоль;
	
КонецФункции // ПолучитьФункциональнуюРольБанка

Функция ПолучитьНастройкуРасчетаПроцентаВекселя(Параметры, КодИндекса, ПроцентнаяСтавка, БазаРасчета, Периодичность)
	
	Если БазаРасчета <> "193" Тогда //193 - ACT/ACT.ICMA - расчёт по фактическому количеству дней в году 
		ВызватьИсключение "Неизвестная база расчёта векселя " + Параметры.ЗначенияПолей.Вексель;
	КонецЕсли;
	
	Если Периодичность <> "6201" Тогда  //День (ставка на дату) - считаем по датам изменения значений индекса(ключевой ставки), другие варианты это скорее ошибочно заведённые данные.
		ВызватьИсключение "Неизвестная периодичность расчёта процентов векселя " + Параметры.ЗначенияПолей.Вексель;
	КонецЕсли;
	
#Область БлокировкаНастройкиРасчета
	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементБлокировки = БлокировкаДанных.Добавить("Справочник.НастройкиРасчета");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	БлокировкаДанных.Заблокировать();
#КонецОбласти	
	
	Составляющие = Новый Массив;
	
	Если ЗначениеЗаполнено(КодИндекса) Тогда
		БазаРасчета	= ПолучитьОбъектПоКодуВнешнейСистемы(Параметры, КодИндекса, Справочники.ГруппыИмпортируемыхОбъектов.Индексы);
		
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("ПараметрРасчетаДоля", 	100);
		
		Если ТипЗнч(БазаРасчета) = Тип("СправочникСсылка.БазыРасчета") Тогда
			ПараметрыРасчета.Вставить("БазаРасчета", БазаРасчета);
			
		ИначеЕсли ТипЗнч(БазаРасчета) = Тип("СправочникСсылка.БиржевыеИндексы") Тогда
			ПараметрыРасчета.Вставить("БазаРасчета", Справочники.БазыРасчета.БиржевойИндекс);
			ПараметрыРасчета.Вставить("ПараметрРасчетаБиржевойИндекс", 	БазаРасчета);
			ПараметрыРасчета.Вставить("ПараметрСреднеарифметическое", 	Ложь);
			
		Иначе
			ВызватьИсключение "Для импорта условий расчета процентов векселей нет описания базы расчёта " + БазаРасчета;
		КонецЕсли;
		
		Составляющие.Добавить(ПараметрыРасчета);
	КонецЕсли;	
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("БазаРасчета", 			Справочники.БазыРасчета.ФиксированнаяСтавка);
	ПараметрыРасчета.Вставить("ПараметрРасчетаСтавка", 	ПроцентнаяСтавка);
	
	Составляющие.Добавить(ПараметрыРасчета);
	
	Запрос = Новый Запрос;
	
#Область ТекстЗапроса
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиРасчета.Ссылка КАК НастройкаРасчета,
	|	НастройкиРасчетаСоставляющие1.ПараметрыРасчета КАК ПараметрыРасчета1,
	|	НастройкиРасчетаСоставляющие2.ПараметрыРасчета КАК ПараметрыРасчета2,
	|	НастройкиРасчетаСоставляющие3.ПараметрыРасчета КАК ПараметрыРасчета3
	|ИЗ
	|	Справочник.НастройкиРасчета КАК НастройкиРасчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НастройкиРасчета.Составляющие КАК НастройкиРасчетаСоставляющие1
	|		ПО НастройкиРасчета.Ссылка = НастройкиРасчетаСоставляющие1.Ссылка
	|			И (НастройкиРасчетаСоставляющие1.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НастройкиРасчета.Составляющие КАК НастройкиРасчетаСоставляющие2
	|		ПО НастройкиРасчета.Ссылка = НастройкиРасчетаСоставляющие2.Ссылка
	|			И (НастройкиРасчетаСоставляющие2.НомерСтроки = 2)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НастройкиРасчета.Составляющие КАК НастройкиРасчетаСоставляющие3
	|		ПО НастройкиРасчета.Ссылка = НастройкиРасчетаСоставляющие3.Ссылка
	|			И (НастройкиРасчетаСоставляющие3.НомерСтроки = 3)
	|ГДЕ
	|	НастройкиРасчета.ВидРасчета = ЗНАЧЕНИЕ(Перечисление.ВидыРасчета.РасчетПроцентнойСтавки)
	|	И ЕСТЬNULL(НастройкиРасчетаСоставляющие1.БазаРасчета, ЗНАЧЕНИЕ(Справочник.БазыРасчета.)) = &БазаРасчета1
	|	И ЕСТЬNULL(НастройкиРасчетаСоставляющие2.БазаРасчета, ЗНАЧЕНИЕ(Справочник.БазыРасчета.)) = &БазаРасчета2
	|	И ЕСТЬNULL(НастройкиРасчетаСоставляющие3.БазаРасчета, ЗНАЧЕНИЕ(Справочник.БазыРасчета.)) = &БазаРасчета3";
#КонецОбласти	

	Для Индекс = 1 По 3 Цикл
		Если Индекс <= Составляющие.Количество() Тогда
			Запрос.УстановитьПараметр("БазаРасчета" + Индекс, Составляющие[Индекс - 1].БазаРасчета);
		Иначе
			Запрос.УстановитьПараметр("БазаРасчета" + Индекс, Справочники.БазыРасчета.ПустаяСсылка());
		КонецЕсли;
	КонецЦикла;

	НастройкаРасчета = Неопределено;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НастройкаНайдена = Истина;
		
		Для Индекс = 1 По Составляющие.Количество() Цикл
			НастройкаНайдена = МИН(НастройкаНайдена,  РаботаСКоллекциями.СтруктурыИдентичны(Выборка["ПараметрыРасчета" + Индекс].Получить(), Составляющие[Индекс - 1], Истина));
		КонецЦикла;
		
		Если НастройкаНайдена Тогда
			НастройкаРасчета = Выборка.НастройкаРасчета;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НастройкаРасчета = Неопределено Тогда
		
		НоваяНастройкаРасчета = Справочники.НастройкиРасчета.СоздатьЭлемент();
		НоваяНастройкаРасчета.ВидРасчета = Перечисления.ВидыРасчета.РасчетПроцентнойСтавки;
		
		Для Каждого ПараметрыРасчета Из Составляющие Цикл
			Составляющая = НоваяНастройкаРасчета.Составляющие.Добавить();
			Составляющая.БазаРасчета 		= ПараметрыРасчета.БазаРасчета;
			Составляющая.ПараметрыРасчета 	= Новый ХранилищеЗначения(Справочники.БазыРасчета.ПолучитьПараметрыРасчета(ПараметрыРасчета.БазаРасчета, ПараметрыРасчета,  Составляющая.Представление), Новый СжатиеДанных(9));
		КонецЦикла;
		
		НоваяНастройкаРасчета.Наименование = Справочники.НастройкиРасчета.СформироватьНаименование(НоваяНастройкаРасчета);
		НоваяНастройкаРасчета.Записать();

		НастройкаРасчета = НоваяНастройкаРасчета.Ссылка;
		
	КонецЕсли;
	
	Возврат НастройкаРасчета;
	
КонецФункции

Процедура СкопироватьРеквизитыГоловнойОрганизацииВФилиалТраста(КодТрастФилиалМосква)
	
	// получим нужных нам юр. лиц
	ДатаЗакрытияФилиала = Дата(2018, 8, 10);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(&Период, ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих) И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)) КАК КодыВоВнешнихСистемахСрезПоследних
		|ГДЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Код = &Код";
	
	Запрос.УстановитьПараметр("Период", ДатаЗакрытияФилиала);
	Запрос.УстановитьПараметр("Код",    КодТрастФилиалМосква);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ТрастФилиалМосква = Выборка.Объект;
	КонецЕсли;
	
	ТрастГолова = РаботаСНормативноСправочнойИнформацией.ПолучитьГоловнуюОрганизацию(ТрастФилиалМосква, ДатаЗакрытияФилиала);
	
	// скопируем реквизиты головы
	РеквизитыЮридическихЛиц = РегистрыСведений.РеквизитыЮридическихЛиц.СоздатьНаборЗаписей();
	
	РеквизитыЮридическихЛиц.Отбор.ЮрФизЛицо.Установить(ТрастФилиалМосква);
	
	РеквизитыЮридическихЛиц.Прочитать();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.*
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, ЮрФизЛицо = &ЮрФизЛицо) КАК РеквизитыЮридическихЛицСрезПоследних
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РеквизитыЮридическихЛиц.*
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц КАК РеквизитыЮридическихЛиц
		|ГДЕ
		|	Период > &Период
		|	И ЮрФизЛицо = &ЮрФизЛицо";
	
	Запрос.УстановитьПараметр("Период", ДатаЗакрытияФилиала);
	Запрос.УстановитьПараметр("ЮрФизЛицо", ТрастГолова);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Запись = РеквизитыЮридическихЛиц.Добавить();
		
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		
		Запись.Период    = ?(Запись.Период < ДатаЗакрытияФилиала, ДатаЗакрытияФилиала, Запись.Период);
		Запись.ЮрФизЛицо = ТрастФилиалМосква;
				
	КонецЦикла;
	
	РеквизитыЮридическихЛиц.ДополнительныеСвойства.Вставить("ИмпортИзВнешнейСистемы", Истина);
	
	РеквизитыЮридическихЛиц.Записать();
	
	// Скопируем контактную информацию головы
	
	КонтактнаяИнформация = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	
	КонтактнаяИнформация.Отбор.Объект.Установить(ТрастФилиалМосква);
	
	КонтактнаяИнформация.Прочитать();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтактнаяИнформацияСрезПоследних.*
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация.СрезПоследних(&Период, Объект = &ЮрФизЛицо) КАК КонтактнаяИнформацияСрезПоследних
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КонтактнаяИнформация.*
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	Период > &Период
		|	И Объект = &ЮрФизЛицо";
	
	Запрос.УстановитьПараметр("Период", ДатаЗакрытияФилиала);
	Запрос.УстановитьПараметр("ЮрФизЛицо", ТрастГолова);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Запись = КонтактнаяИнформация.Добавить();
		
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		
		Запись.Период    = ?(Запись.Период < ДатаЗакрытияФилиала, ДатаЗакрытияФилиала, Запись.Период);
		Запись.Объект = ТрастФилиалМосква;
				
	КонецЦикла;
	
	КонтактнаяИнформация.ДополнительныеСвойства.Вставить("ИмпортИзВнешнейСистемы", Истина);
	
	КонтактнаяИнформация.Записать();	
	
	// изменим наименование филиала
	
	Объект = ТрастФилиалМосква.ПолучитьОбъект();
	
	Объект.Наименование = ТрастГолова.Наименование + " (быв. ""Филиал Московский"")";
	
	Объект.ДополнительныеСвойства.Вставить("ИмпортИзВнешнейСистемы", Истина);
	
	Объект.Записать();
	
КонецПроцедуры // СкопироватьРеквизитыГоловнойОрганизацииВФилиалТраста

