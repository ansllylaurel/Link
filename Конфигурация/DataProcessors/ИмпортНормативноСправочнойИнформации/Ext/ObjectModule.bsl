		Возврат;
	КонецЕсли;
	
	НайдСтроки = КупонныйДоходПоОблигациям.НайтиСтроки(Новый Структура("Облигация", Пересвет));
	Если НайдСтроки.Количество() = 0 Тогда
		// В наборе этой облигации нет, поэтому ничего не делаем
		Возврат;
	КонецЕсли;
	
	НайдСтроки = КупонныйДоходПоОблигациям.НайтиСтроки(Новый Структура("Облигация, Период", Пересвет, '20170214'));
	Если НайдСтроки.Количество() <> 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Во внешней системе изменились данные по купонному периоду облигации АКБ ПЕРЕСВЕТ ПАО, 40402110B, 329.00 RUB! Необходимо проверить результат импорта!");
	Иначе
		ИзменяемаяСтрока = НайдСтроки[0];
		ИзменяемаяСтрока.Период 	= '20170321';	
	КонецЕсли;
			
КонецПроцедуры

Процедура ПодготовитьДефолтыПоОблигациям(ВнешниеДанные)
	
	// Выделяем отдельные строки с техническим дефолтом и с выходом из дефолта
	ТаблицаИзменена = Ложь;
	
	Для Индекс = 1 - ВнешниеДанные.Количество() По 0 Цикл
		
		ТекСтрокаДефолта = ВнешниеДанные[-Индекс];
			
		Если Не ЗначениеЗаполнено(ТекСтрокаДефолта.Период) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для ценной бумаги [" + ТекСтрокаДефолта.Облигация + "] не удалось загрузить данные о дефолте, статус [" + ТекСтрокаДефолта.СтатусДефолта + "]. В матрих не заполнена дата дефолта план.");
			ВнешниеДанные.Удалить(ТекСтрокаДефолта);
			Продолжить;	
		КонецЕсли;
		
		Если ТекСтрокаДефолта.СтатусДефолта = Перечисления.СтатусыДефолтаПоОблигациям.Дефолт И ЗначениеЗаполнено(ТекСтрокаДефолта.ДатаОкончания) И ТекСтрокаДефолта.Период < ТекСтрокаДефолта.ДатаОкончания Тогда
			 		
			// Добавляем новую строку с периодом дефолта от даты окончания текущей строки
			НайдСтроки = ВнешниеДанные.НайтиСтроки(Новый Структура("Период, Облигация, ТипДефолта", ТекСтрокаДефолта.ДатаОкончания, ТекСтрокаДефолта.Облигация, ТекСтрокаДефолта.ТипДефолта));
			Если НайдСтроки.Количество() = 0 Тогда
				СтрокаДефолта = ВнешниеДанные.Добавить();
			Иначе
				СтрокаДефолта = НайдСтроки[0];
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтрокаДефолта, ТекСтрокаДефолта);
			СтрокаДефолта.Период = ТекСтрокаДефолта.ДатаОкончания;
			
			// В текущей строке устанавливаем технический дефолт  		
			ТекСтрокаДефолта.СтатусДефолта = Перечисления.СтатусыДефолтаПоОблигациям.ТехническийДефолт;		
			
			ТаблицаИзменена = Истина;
			
		ИначеЕсли ТекСтрокаДефолта.СтатусДефолта = Перечисления.СтатусыДефолтаПоОблигациям.ТехническийДефолт И ЗначениеЗаполнено(ТекСтрокаДефолта.ДатаВыходаИзДефолта) И ТекСтрокаДефолта.Период <= ТекСтрокаДефолта.ДатаВыходаИзДефолта Тогда
			
			// Добавляем новую строку с периодом от даты выхода из дефолта текущей строки
			НайдСтроки = ВнешниеДанные.НайтиСтроки(Новый Структура("Период, Облигация, ТипДефолта", ТекСтрокаДефолта.ДатаВыходаИзДефолта, ТекСтрокаДефолта.Облигация, ТекСтрокаДефолта.ТипДефолта));
			Если НайдСтроки.Количество() = 0 Тогда
				СтрокаДефолта = ВнешниеДанные.Добавить();
			Иначе
				СтрокаДефолта = НайдСтроки[0];
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтрокаДефолта, ТекСтрокаДефолта);
			СтрокаДефолта.Период = ТекСтрокаДефолта.ДатаВыходаИзДефолта;
			
			СтрокаДефолта.СтатусДефолта = Перечисления.СтатусыДефолтаПоОблигациям.ВыходИзДефолта;
			
			ТаблицаИзменена = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Если нужно, сворачиваем и сортируем таблицу
	Если ТаблицаИзменена Тогда
		ВнешниеДанные.Сортировать("Период");
	КонецЕсли;
	
КонецПроцедуры 

Функция ВыполнитьЗапросXPathКПравиламИмпорта(ЗапросXPath)
	
	ПравилаЗагрузкиXML = ЭтотОбъект.ПолучитьМакет("ПравилаИмпорта").ПолучитьТекст();
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ПравилаЗагрузкиXML);
	
	ПостроительDOM = Новый ПостроительDOM;
	
	ДокументDOM  = ПостроительDOM.Прочитать(ЧтениеXML);
	ВыборкаXPath = ДокументDOM.ВычислитьВыражениеXPath(ЗапросXPath, ДокументDOM.ЭлементДокумента, Новый РазыменовательПространствИменDOM(ДокументDOM.ЭлементДокумента));

	Возврат ВыборкаXPath;
	
КонецФункции // ВыполнитьЗапросXPathКПравиламИмпорта

Функция ПолучитьТекстЭлементаDOM(ЭлементDOM)
	
	Если ЭлементDOM.ЕстьДочерниеУзлы() Тогда
		Если ЭлементDOM.ПервыйДочерний.ТипУзла = ТипУзлаDOM.Текст Тогда
			Возврат СокрЛП(ЭлементDOM.ПервыйДочерний.ЗначениеУзла);
		КонецЕсли;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции // ПолучитьТекстЭлементаDOM

Функция ПолучитьИмяГруппыОбъектов(ГруппаОбъектов)
	
	ИмяГруппыОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.ПолучитьИмяПредопределенного(ГруппаОбъектов);
	Если ПустаяСтрока(ИмяГруппыОбъектов) Тогда
		ИмяГруппыОбъектов = ГруппаОбъектов.Наименование;
	КонецЕсли;
	
	Возврат ИмяГруппыОбъектов;
	
КонецФункции // ПолучитьИмяГруппыОбъектов

Функция РассчитатьНоминалыЦенныхБумаг(Номиналы)
		
	ТекЦеннаяБумага = Справочники.Облигации.ПустаяСсылка();
	
	Для Каждого СтрокаНоминалы Из Номиналы Цикл
		Если СтрокаНоминалы.Номинал <> 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекЦеннаяБумага <> СтрокаНоминалы.ЦеннаяБумага Тогда
			ТекЦеннаяБумага = СтрокаНоминалы.ЦеннаяБумага;
			Номинал = СтрокаНоминалы.ЦеннаяБумага.Номинал - СтрокаНоминалы.СуммаИзменения;
		Иначе
			Номинал = Номинал - СтрокаНоминалы.СуммаИзменения;
		КонецЕсли; 
		
		СтрокаНоминалы.Номинал = Номинал;
	КонецЦикла; 

КонецФункции // РассчитатьНоминалыЦенныхБумаг

Функция ПолучитьПараметрыВыполненияДляСбораСтатистики()
	
	ПараметрыОтчета = Новый Соответствие();
	ПараметрыОтчета.Вставить("ГруппаПравил", ЭтотОбъект.ГруппаПравил);
	ПараметрыОтчета.Вставить("ГруппаОбъектов", ЭтотОбъект.ГруппаОбъектов);
	ПараметрыОтчета.Вставить("Организация", ЭтотОбъект.Организация);
	ПараметрыОтчета.Вставить("ИмпортируемыеОбъекты.КодВоВнешнейСистеме", ЭтотОбъект.ИмпортируемыеОбъекты.ВыгрузитьКолонку("КодВоВнешнейСистеме"));
	
	Описание =
		"ГруппаПравил: " + ПараметрыОтчета["ГруппаПравил"] + "
		|ГруппаОбъектов: " + ПараметрыОтчета["ГруппаОбъектов"] + "
		|Организация: " + ПараметрыОтчета["Организация"] + "
		|ИмпортируемыеОбъекты.КодВоВнешнейСистеме[" + Формат(ЭтотОбъект.ИмпортируемыеОбъекты.Количество(), "ЧРГ=") + "]: " + РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ПараметрыОтчета["ИмпортируемыеОбъекты.КодВоВнешнейСистеме"], ", ");
	
	Хранилище = Новый ХранилищеЗначения(ПараметрыОтчета);
	
	ПараметрыВыполненияДляСбораСтатистики = Новый Структура("Хранилище, Описание", Хранилище, Описание);
	
	Возврат ПараметрыВыполненияДляСбораСтатистики;
	
КонецФункции // ПолучитьПараметрыВыполненияДляСбораСтатистики

Процедура СкорректироватьДатуПогашенияПропертизФинанс(ВнешниеДанные, ДанныеДляЗагрузки)
	
	// #339467: у "О1 Пропертиз Финанс АО, 4B02-01-71827-H, 1000.00 RUB" отодвинули дату погашения	
	
	Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1_ПропертизФин");
	Если Облигация = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	СтрокаДанныеДляЗагрузки = ДанныеДляЗагрузки.Найти(Облигация, "Объект");
	Если СтрокаДанныеДляЗагрузки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеСтроки = ВнешниеДанные.НайтиСтроки(Новый Структура("Идентификатор", СтрокаДанныеДляЗагрузки.Идентификатор));
	
	Для Каждого СтрокаОблигации Из НайденныеСтроки Цикл
		Если СтрокаОблигации.ДатаПогашения = '20201002' Тогда
			СтрокаОблигации.ДатаПогашения = '20240927';	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьФормулыРасчетаПлавающихСтавок(КупонныйДоходПоОблигациям, Ошибки)
	
	// Подгружаем из специального регистра, контролируя, чтобы количество купонных периодов совпадало.
	// Ошибки выдаем только для непогашенных облигаций с плавающей ставкой
	
	ОшибкиОбновления = Новый Соответствие; // ключ - бумага, значение - сообщение об ошибке
	
	КупонныйДоходПоОблигациям.Индексы.Добавить("Облигация, НомерКупона");
	
	НомераКупонов = КупонныйДоходПоОблигациям.Скопировать(Неопределено, "Облигация, НомерКупона");
	РаботаСКоллекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(НомераКупонов, "Облигация",	Метаданные.РегистрыСведений.ФормулыРасчетаСтавокКупонов.Измерения.Облигация.Тип);
	РаботаСКоллекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(НомераКупонов, "НомерКупона",	Метаданные.РегистрыСведений.ФормулыРасчетаСтавокКупонов.Измерения.НомерКупона.Тип);
		
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КупонныйДоходПоОблигациям.Облигация КАК Облигация,
		|	КупонныйДоходПоОблигациям.НомерКупона КАК НомерКупона
		|ПОМЕСТИТЬ _КупонныйДоходПоОблигациям
		|ИЗ
		|	&КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Облигация,
		|	НомерКупона
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_КупонныйДоходПоОблигациям.Облигация КАК Облигация,
		|	КодыОблигацийВМатрикс.Код В (&КодыПогашенныхБумаг) КАК ФлагОблигацияПогашена
		|ПОМЕСТИТЬ _ОбновляемыеОблигации
		|ИЗ
		|	_КупонныйДоходПоОблигациям КАК _КупонныйДоходПоОблигациям
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&Период,
		|				ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Облигации)
		|					И ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И Объект В
		|						(ВЫБРАТЬ
		|							НКД.Облигация
		|						ИЗ
		|							_КупонныйДоходПоОблигациям КАК НКД)) КАК КодыОблигацийВМатрикс
		|		ПО _КупонныйДоходПоОблигациям.Облигация = КодыОблигацийВМатрикс.Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОбновляемыеОблигации.Облигация КАК Облигация,
		|	_ОбновляемыеОблигации.ФлагОблигацияПогашена КАК ФлагОблигацияПогашена
		|ПОМЕСТИТЬ _КонтролируемыеОблигации
		|ИЗ
		|	_ОбновляемыеОблигации КАК _ОбновляемыеОблигации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО (Облигации.Ссылка = _ОбновляемыеОблигации.Облигация)
		|			И (Облигации.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыОблигаций.КупоннаяПК))
		|			И (Облигации.БазоваяСтавка <> ЗНАЧЕНИЕ(Справочник.БазовыеСтавкиОблигаций.ПустаяСсылка))
		|			И (Облигации.ДатаПогашения >= &Период
		|				ИЛИ Облигации.ДатаПогашения = ДАТАВРЕМЯ(1, 1, 1))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Облигация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АктуальныеФормулыРасчетаСтавокКупонов.Облигация КАК Облигация,
		|	АктуальныеФормулыРасчетаСтавокКупонов.НомерКупона КАК НомерКупона,
		|	АктуальныеФормулыРасчетаСтавокКупонов.ФормулаРасчетаСтавки КАК ФормулаРасчетаСтавки,
		|	_ОбновляемыеОблигации.ФлагОблигацияПогашена КАК ФлагОблигацияПогашена
		|ПОМЕСТИТЬ _АктуальныеФормулыРасчетаСтавокКупонов
		|ИЗ
		|	РегистрСведений.ФормулыРасчетаСтавокКупонов.СрезПоследних(
		|			&Период,
		|			Облигация В
		|				(ВЫБРАТЬ
		|					_ОбновляемыеОблигации.Облигация
		|				ИЗ
		|					_ОбновляемыеОблигации)) КАК АктуальныеФормулыРасчетаСтавокКупонов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ОбновляемыеОблигации КАК _ОбновляемыеОблигации
		|		ПО АктуальныеФормулыРасчетаСтавокКупонов.Облигация = _ОбновляемыеОблигации.Облигация
		|ГДЕ
		|	АктуальныеФормулыРасчетаСтавокКупонов.Действует
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Облигация,
		|	НомерКупона
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_КупонныйДоходПоОблигациям.Облигация, _АктуальныеФормулыРасчетаСтавокКупонов.Облигация) КАК Облигация,
		|	ЕСТЬNULL(_КонтролируемыеОблигации.ФлагОблигацияПогашена, _АктуальныеФормулыРасчетаСтавокКупонов.ФлагОблигацияПогашена) КАК ФлагОблигацияПогашена,
		|	_АктуальныеФормулыРасчетаСтавокКупонов.НомерКупона КАК НомерКупона,
		|	_АктуальныеФормулыРасчетаСтавокКупонов.ФормулаРасчетаСтавки КАК ФормулаРасчетаСтавки
		|ИЗ
		|	_КупонныйДоходПоОблигациям КАК _КупонныйДоходПоОблигациям
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КонтролируемыеОблигации КАК _КонтролируемыеОблигации
		|		ПО (_КонтролируемыеОблигации.Облигация = _КупонныйДоходПоОблигациям.Облигация)
		|		ПОЛНОЕ СОЕДИНЕНИЕ _АктуальныеФормулыРасчетаСтавокКупонов КАК _АктуальныеФормулыРасчетаСтавокКупонов
		|		ПО (_АктуальныеФормулыРасчетаСтавокКупонов.Облигация = _КупонныйДоходПоОблигациям.Облигация)
		|			И (_АктуальныеФормулыРасчетаСтавокКупонов.НомерКупона = _КупонныйДоходПоОблигациям.НомерКупона)");
	
	Запрос.УстановитьПараметр("КупонныйДоходПоОблигациям", НомераКупонов);
	Запрос.УстановитьПараметр("Период",					   ТекущаяДата());
	Запрос.УстановитьПараметр("КодыПогашенныхБумаг",       ПолучитьКодыПогашенныхБумаг());
	
	ВыборкаЗаписей = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаЗаписей.Следующий() Цикл
				
		СтрокиКупона = КупонныйДоходПоОблигациям.НайтиСтроки(Новый Структура("Облигация, НомерКупона", ВыборкаЗаписей.Облигация, ВыборкаЗаписей.НомерКупона));
		
		Если СтрокиКупона.Количество() = 0 Тогда
			
			Если Не ВыборкаЗаписей.ФлагОблигацияПогашена Тогда 
				ОшибкиОбновления.Вставить(ВыборкаЗаписей.Облигация, СтрШаблон("Не удалось заполнить формулы расчета ставок купонов бумаги '%1'", ВыборкаЗаписей.Облигация));
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		СтрокиКупона[0].ФормулаРасчетаСтавки = ВыборкаЗаписей.ФормулаРасчетаСтавки;
		
	КонецЦикла;
	
	// Фиксируем ошибки
	Для Каждого Ошибка Из ОшибкиОбновления Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Ошибка.Значение);
		Если Ошибки <> Неопределено Тогда
			ДобавитьОшибкуВМассив(Ошибки, Ошибка.Значение);
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры 

