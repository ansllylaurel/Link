Процедура ПодготовитьОбъектыДляАвтоматическойЗагрузки()
	
	Если ЭтотОбъект.ИмпортируемыеОбъекты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	// проверим, что группы правил и объектов заданы
	Если Не ЗначениеЗаполнено(ЭтотОбъект.ГруппаПравил) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задана группа правил. Автоматическа загрузка не произведена.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЭтотОбъект.ГруппаОбъектов) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задана группа объектов. Автоматическа загрузка не произведена");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ВнешняяСистема = ПолучитьВнешнююСистему(ЭтотОбъект.ГруппаПравил);
	Если Не ЗначениеЗаполнено(ВнешняяСистема) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В правилах импорта для группы правил «" + ЭтотОбъект.ГруппаПравил + "» не задана внешняя система, из которой осуществляется импорт данных.");
		Возврат;
	КонецЕсли;
	
	
	// исключим пустые строки и составим список переданных объектов
	Параметры = Новый Структура("ВнешняяСистема", ВнешняяСистема);
	
	ПереданныеОбъекты = Новый Массив();
	
	Для НомСтр = 1 - ЭтотОбъект.ИмпортируемыеОбъекты.Количество() По 0 Цикл
		СтрокаИмпортируемыеОбъекты = ЭтотОбъект.ИмпортируемыеОбъекты[-НомСтр];
		
		Если Не ЗначениеЗаполнено(СтрокаИмпортируемыеОбъекты.КодВоВнешнейСистеме)
				И Не ЗначениеЗаполнено(СтрокаИмпортируемыеОбъекты.Объект)
		Тогда
			// пустые строки удаляем
			ЭтотОбъект.ИмпортируемыеОбъекты.Удалить(-НомСтр);
			Продолжить;
				
		ИначеЕсли ЗначениеЗаполнено(СтрокаИмпортируемыеОбъекты.КодВоВнешнейСистеме)
				И Не ЗначениеЗаполнено(СтрокаИмпортируемыеОбъекты.Объект)
		Тогда
			// попытаемся найти новый объект, если он не будет найден, то ничего страшного - создастся после загрузки
			Попытка
				СтрокаИмпортируемыеОбъекты.Объект = ПолучитьОбъектПоКодуВнешнейСистемы(Параметры,
					СтрокаИмпортируемыеОбъекты.КодВоВнешнейСистеме, ЭтотОбъект.ГруппаОбъектов);
			Исключение
			КонецПопытки;
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаИмпортируемыеОбъекты.Объект)	Тогда
		    // пока просто заполним коллекцию переданных объектов, а проверим их соответствие кодам единым запросом после цикла
			ПереданныеОбъекты.Добавить(СтрокаИмпортируемыеОбъекты.Объект);
		
		КонецЕсли;
	КонецЦикла;
	
	// получим коды переданных переданных объектов
	Если ПереданныеОбъекты.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КодыВоВнешнихСистемахСрезПоследних.Объект,
			|	КодыВоВнешнихСистемахСрезПоследних.Код,
			|	ПРЕДСТАВЛЕНИЕ(КодыВоВнешнихСистемахСрезПоследних.Объект) КАК ПредставлениеОбъекта
			|ИЗ
			|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
			|			&Период,
			|			ВнешняяСистема = &ВнешняяСистема
			|				И ГруппаОбъектов = &ГруппаОбъектов
			|				И Объект В (&Объект)) КАК КодыВоВнешнихСистемахСрезПоследних";

		Запрос.УстановитьПараметр("Период",         ТекущаяДата());	
		Запрос.УстановитьПараметр("ВнешняяСистема", ВнешняяСистема);
		Запрос.УстановитьПараметр("ГруппаОбъектов", ЭтотОбъект.ГруппаОбъектов);
		Запрос.УстановитьПараметр("Объект",         ПереданныеОбъекты);
	
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокиИмпортируемыеОбъекты = ЭтотОбъект.ИмпортируемыеОбъекты.НайтиСтроки(Новый Структура("Объект", Выборка.Объект));
			Для каждого СтрокаИмпортируемыеОбъекты Из СтрокиИмпортируемыеОбъекты Цикл
				Если Не ЗначениеЗаполнено(СтрокаИмпортируемыеОбъекты.КодВоВнешнейСистеме) Тогда
					// либо заполним код, либо исключим объект из импортируемых, если код не задан
					Если ЗначениеЗаполнено(Выборка.Код) Тогда
						СтрокаИмпортируемыеОбъекты.КодВоВнешнейСистеме = Выборка.Код;
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задан код объекта «" + Выборка.ПредставлениеОбъекта + "» во внешней системе «" + Строка(ВнешняяСистема) + "». Объект не будет обработан.");
						ЭтотОбъект.ИмпортируемыеОбъекты.Удалить(СтрокаИмпортируемыеОбъекты);
					КонецЕсли;
				Иначе
					// проверим, что переданный код совпадает с текущим сохраненным
					Если СтрокаИмпортируемыеОбъекты.КодВоВнешнейСистеме <> Выборка.Код Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Код «" + Выборка.Код + "» объекта «" + Выборка.ПредставлениеОбъекта + "» во внешней системе «" + Строка(ВнешняяСистема) + "» не совпадает с переданным «" + Строка(СтрокаИмпортируемыеОбъекты.КодВоВнешнейСистеме) + "». Объект не будет обработан.");
						ЭтотОбъект.ИмпортируемыеОбъекты.Удалить(СтрокаИмпортируемыеОбъекты);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
				
	КонецЕсли;
	
	// исключим из обработки объекты, для которых коды не заданы
	ЕстьИсклОбъекты = Ложь;
	Для НомСтр = 1 - ЭтотОбъект.ИмпортируемыеОбъекты.Количество() По 0 Цикл
		СтрокаИмпортируемыеОбъекты = ЭтотОбъект.ИмпортируемыеОбъекты[-НомСтр];
		Если Не ЗначениеЗаполнено(СтрокаИмпортируемыеОбъекты.КодВоВнешнейСистеме) Тогда
			ЕстьИсклОбъекты = Истина;
			ЭтотОбъект.ИмпортируемыеОбъекты.Удалить(-НомСтр);
		КонецЕсли;
	КонецЦикла;
	Если ЕстьИсклОбъекты Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Из обработки искл. объекты с пустыми кодами внеш. системы.");
	КонецЕсли;

КонецПроцедуры // ПодготовитьОбъектыДляАвтоматическойЗагрузки

Функция НайтиУстранитьРасхожденияВСправочнике(Объект, НовыеРеквизиты, Реквизиты, ВнешняяСистема, ОписаниеРасхождений = "", РезультатОбновления)
	
	ЕстьРасхождения     = Ложь;
	ОписаниеРасхождений = "";
	
	Для каждого Реквизит Из Реквизиты Цикл
		ТекущееЗначение = ?(ЗначениеЗаполнено(Объект[Реквизит]), Объект[Реквизит], Неопределено); // чтобы избежать расхождения при сравнении пустых значений разных типов
		НовоеЗначение   = ?(ЗначениеЗаполнено(НовыеРеквизиты[Реквизит]), НовыеРеквизиты[Реквизит], Неопределено);
		
		Если ТипЗнч(ТекущееЗначение) = Тип("Булево") Тогда
			НовоеЗначение = ?(ТипЗнч(НовоеЗначение) = Тип("Число"), Булево(НовоеЗначение), Ложь);
		КонецЕсли;
		
		Если ТекущееЗначение <> НовоеЗначение Тогда
			ОписаниеРасхождений = ОписаниеРасхождений + ?(ПустаяСтрока(ОписаниеРасхождений), "", Символы.ПС)
				+ Реквизит + ": [" + СокрЛП(ТекущееЗначение) + "] -> [" + СокрЛП(НовоеЗначение) + "]";
				
			Объект[Реквизит] = НовоеЗначение;
			
			ЕстьРасхождения = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьРасхождения Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Объект.ДополнительныеСвойства.Вставить("ИмпортИзВнешнейСистемы", Истина);
	Объект.ДополнительныеСвойства.Вставить("ВнешняяСистема", ВнешняяСистема);
	
	Попытка
		Объект.Записать();
	Исключение
		ТекстСообщения = "Не удалось импортировать элемент справочника '" + Объект.Метаданные().Представление() + "' с кодом '" + НовыеРеквизиты.Идентификатор + "'. Система сообщает: " + ОписаниеОшибки();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		Если РезультатОбновления <> Неопределено Тогда
			РезультатОбновления.СообщенияОбОшибках.Добавить(ТекстСообщения);
		КонецЕсли;
		
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции // НайтиУстранитьРасхожденияВСправочнике

Функция ПолучитьСтрокуСравнения(ИмяКолонки, ТекущееЗначение, НовоеЗначение, ИмяРегистра, ПериодическийРегистр, СтрокаДанные)

	Если ИмяРегистра = "КодыВТорговыхСистемах" И СтрокаДанные.ВидКода <> Перечисления.ВидыКодовВТорговыхСистемах.CFI Тогда
		Возврат СтрЗаменить(СтрокаДанные.ВидКода, " ", "") + ": [" + СокрЛП(ТекущееЗначение) + "] -> [" + СокрЛП(НовоеЗначение) + "]";
	Иначе
		Возврат ИмяКолонки + ": [" + СокрЛП(ТекущееЗначение) + "] -> [" + СокрЛП(НовоеЗначение) + "]" + ?(ПериодическийРегистр, СтрокаДанные.Период, "");
	КонецЕсли;

КонецФункции

Функция НайтиУстранитьРасхожденияВРегистреСведений(ИмяРегистра, НовыеДанные, КлючевыеПоля, ЗначенияКлючевыхПоля, ОписаниеРасхождений, РезультатОбновления, ВспомогательныеДанные)
	
	РегистрМД = Метаданные.РегистрыСведений[ИмяРегистра];
	
	// определим динамические компоненты запроса для поиска расхождений
	УсловиеОтбора = "";
	Для каждого КлючевоеПоле Из КлючевыеПоля Цикл
		УсловиеОтбора = УсловиеОтбора + ?(ПустаяСтрока(УсловиеОтбора), "", " И ") + КлючевоеПоле + " = &" + КлючевоеПоле;
	КонецЦикла;
		
	// подготовим запрос
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	*
		|ИЗ
		|	РегистрСведений.&ИмяРегистра
		|ГДЕ
		|	&УсловиеОтбора";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяРегистра",   ИмяРегистра);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", УсловиеОтбора);
	
	Для каждого КлючевоеПоле Из КлючевыеПоля Цикл
		Запрос.УстановитьПараметр(КлючевоеПоле, ЗначенияКлючевыхПоля[КлючевоеПоле]);
	КонецЦикла;
	
	// найдем расхождения
	ТекущиеДанные = Запрос.Выполнить().Выгрузить();
	
	ЗначенияИзмерений = Новый Структура();
	Для каждого ИзмерениеМД Из РегистрМД.Измерения Цикл
		ЗначенияИзмерений.Вставить(ИзмерениеМД.Имя);
	КонецЦикла;
	ПериодическийРегистр = РегистрМД.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;
	Если ПериодическийРегистр Тогда
		ЗначенияИзмерений.Вставить("Период");
	КонецЕсли;
	
	ЕстьРасхождения = Ложь;
	
	
	// данные могут либо измениться, либо добавиться. 
	// 1-й заход. Сличаем Текущие и Новые данные по совпадающим измерениям 
	// а также данные могут удалиться! есть отмены оферт, возможно еще что-то
	УдаленоЗаписей = 0;
	
	Для каждого СтрокаТекущиеДанные Из ТекущиеДанные Цикл
		ЗаполнитьЗначенияСвойств(ЗначенияИзмерений, СтрокаТекущиеДанные);
		
		СтрокиНовыеДанные = НовыеДанные.НайтиСтроки(ЗначенияИзмерений);
		
		Если СтрокиНовыеДанные.Количество() = 1 Тогда
			СтрокаНовыеДанные = СтрокиНовыеДанные[0];
		ИначеЕсли СтрокиНовыеДанные.Количество() = 0 Тогда
			СтрокаНовыеДанные = Неопределено; // вот случай удаления данных
			УдаленоЗаписей = УдаленоЗаписей + 1;
		Иначе
			// эта ситуация возможна только в одном случае: 
			// 		мы уменьшили количество измерений, но не переделали правила импорта
			СтрокаНовыеДанные = Неопределено; // пока так, по-хорошему нужно исключение вызвать, но вероятность почти нулевая
		КонецЕсли;
		
		Для каждого Колонка Из ТекущиеДанные.Колонки Цикл
			
			Если СтрокаНовыеДанные = Неопределено Тогда // для удаленных выводим измерения, кроме ЦБ
				Если Колонка.Имя = "Облигация" ИЛИ Колонка.Имя = "ЦеннаяБумага" ИЛИ Колонка.Имя = "Объект" Тогда 
					Продолжить; 
				КонецЕсли;
				НовоеЗначение = Неопределено;
			Иначе // для сравнения измерения не выводим	
				Если ЗначенияИзмерений.Свойство(Колонка.Имя) ИЛИ НовыеДанные.Колонки.Найти(Колонка.Имя) = Неопределено  Тогда
					Продолжить;
				КонецЕсли;
				НовоеЗначение   = ?(ЗначениеЗаполнено(СтрокаНовыеДанные[Колонка.Имя]), СтрокаНовыеДанные[Колонка.Имя], Неопределено);
			КонецЕсли;
			
			ТекущееЗначение = ?(ЗначениеЗаполнено(СтрокаТекущиеДанные[Колонка.Имя]), СтрокаТекущиеДанные[Колонка.Имя], Неопределено); // чтобы избежать расхождения при сравнении пустых значений разных типов
			
			Если ТипЗнч(ТекущееЗначение) = Тип("Булево") И ТипЗнч(НовоеЗначение) <> Тип("Булево") Тогда
				НовоеЗначение = ?(ТипЗнч(НовоеЗначение) = Тип("Число"), Булево(НовоеЗначение), Ложь);
			КонецЕсли;
			
			Если ТекущееЗначение <> НовоеЗначение Тогда
				
				СтрокаСравнения = ПолучитьСтрокуСравнения(Колонка.Имя, ТекущееЗначение, НовоеЗначение, ИмяРегистра, ПериодическийРегистр, СтрокаТекущиеДанные);
				
				ОписаниеРасхождений = ОписаниеРасхождений + ?(ПустаяСтрока(ОписаниеРасхождений), "", Символы.ПС) + СтрокаСравнения;
				
				ЕстьРасхождения = Истина;
				
			КонецЕсли;
				
		КонецЦикла;
		
	КонецЦикла;
	
	// 2-й проход.  возьмем новые записи, которых нет  в текущих
	Если НовыеДанные.Количество() > ТекущиеДанные.Количество() - УдаленоЗаписей Тогда  
		Для Каждого СтрокаНовыеДанные из НовыеДанные Цикл 	
			
			ЗаполнитьЗначенияСвойств(ЗначенияИзмерений, СтрокаНовыеДанные);
			
			СтрокиТекущиеДанные = ТекущиеДанные.НайтиСтроки(ЗначенияИзмерений);
			Если СтрокиТекущиеДанные.Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого Колонка Из НовыеДанные.Колонки Цикл
				//для новых записей в РС измерений не пропускаем. Пропускаем только измерение со ссылкой на ценную бумагу
				Если Колонка.Имя = "Облигация" ИЛИ Колонка.Имя = "ЦеннаяБумага" ИЛИ Колонка.Имя = "Объект" Тогда 
					Продолжить; 
				КонецЕсли;
				ТекущееЗначение = Неопределено;
				НовоеЗначение   = ?(ЗначениеЗаполнено(СтрокаНовыеДанные[Колонка.Имя]), СтрокаНовыеДанные[Колонка.Имя], Неопределено);
				
				СтрокаСравнения = ПолучитьСтрокуСравнения(Колонка.Имя, ТекущееЗначение, НовоеЗначение, ИмяРегистра, ПериодическийРегистр, СтрокаНовыеДанные);
				
				ОписаниеРасхождений = ОписаниеРасхождений + ?(ПустаяСтрока(ОписаниеРасхождений), "", Символы.ПС) + СтрокаСравнения;
				
			КонецЦикла;	
			
			ЕстьРасхождения = Истина;

		КонецЦикла;		
	КонецЕсли;		
		
	Если Не ЕстьРасхождения Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// устраним расхождения
	НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	
	Для каждого КлючевоеПоле Из КлючевыеПоля Цикл
		НаборЗаписей.Отбор[КлючевоеПоле].Установить(ЗначенияКлючевыхПоля[КлючевоеПоле]);
	КонецЦикла;
	
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	
	// заполним набор новыми записями
	Для каждого СтрокаНовыеДанные Из НовыеДанные Цикл
		ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), СтрокаНовыеДанные);
	КонецЦикла;
	
	НаборЗаписей.ДополнительныеСвойства.Вставить("ИмпортИзВнешнейСистемы");
	
	Если ИмяРегистра = "РеквизитыЮридическихЛиц" И ВспомогательныеДанные.Свойство("ЮридическиеЛицаПоДействующимСчетамДУ") Тогда
		НаборЗаписей.ДополнительныеСвойства.Вставить("ЮридическиеЛицаПоДействующимСчетамДУ", ВспомогательныеДанные.ЮридическиеЛицаПоДействующимСчетамДУ);		
	КонецЕсли;
	
	// описание ключ. полей подготовим сразу, т.к. в исключении не удается получить представление:
	// генерируется исключ. ситуация, которая в транзакции приводит к падению платформы
	ОписаниеКлючевыхПолей = "";
	Для каждого КлючевоеПоле Из КлючевыеПоля Цикл
		ОписаниеКлючевыхПолей = ОписаниеКлючевыхПолей + ?(ПустаяСтрока(ОписаниеКлючевыхПолей), "", ", ") + КлючевоеПоле + " [" + ЗначенияКлючевыхПоля[КлючевоеПоле] + "]";
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		НаборЗаписей.Записать();
	Исключение
		ТекстСообщения = "Не удалось импортировать записи регистра сведений '" + РегистрМД.Представление() + "', относящиеся к " + ОписаниеКлючевыхПолей + ". Система сообщает: " + ОписаниеОшибки();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		Если РезультатОбновления <> Неопределено Тогда
			РезультатОбновления.СообщенияОбОшибках.Добавить(ТекстСообщения);
		КонецЕсли;
		
		Возврат Неопределено;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Истина;
	
КонецФункции

Функция ИмпортироватьДанные(ТипыДанныхДляОповещения = Неопределено, РезультатОбновления = Неопределено, ГлубинаРекурсии = 0) Экспорт
	
	Ошибки = Новый Массив; // для накопления ошибок по которым будут создаваться задачи
	
	ГлубинаРекурсии = ГлубинаРекурсии + 1;
	
	ПодготовитьОбъектыДляАвтоматическойЗагрузки();
	
	КодТрастФилиалМосква = "222581";
	
	// Для дробной и неиспользуемой акции Интер РАО будем менять наименование
	Если ЭтотОбъект.ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.Акции Тогда
		НеиспользуемаяАкцияИнтерРАО				= ОбщегоНазначения.ПолучитьИменованныйОбъект("Акция_ИнтерРАОНеактуальна");
		ВСоставеЕстьНеиспользуемаяАкцияИнтерРАО	= ЭтотОбъект.ИмпортируемыеОбъекты.НайтиСтроки(Новый Структура("Объект", НеиспользуемаяАкцияИнтерРАО)).Количество() > 0;
	КонецЕсли;
	
	// организуем сбор статистики
	ПараметрыВыполненияДляСбораСтатистики = ПолучитьПараметрыВыполненияДляСбораСтатистики();
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ИмпортироватьДанные()";
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	// получим идентификаторы и ссылки, если объекты были импортированы ранее
	МаксДопДлинаИдентификатора = Метаданные.РегистрыСведений.КодыВоВнешнихСистемах.Ресурсы.Код.Тип.КвалификаторыСтроки.Длина;
	
	ДанныеДляЗагрузки = Новый ТаблицаЗначений;
	ДанныеДляЗагрузки.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(МаксДопДлинаИдентификатора)));
	ДанныеДляЗагрузки.Колонки.Добавить("Объект");
	
	ИдентификаторыВыбранныхОбъектов = Новый Массив();
	
	Для каждого СтрокаИмпортируемыеОбъекты Из ЭтотОбъект.ИмпортируемыеОбъекты Цикл
		СтрокаДанныеДляЗагрузки = ДанныеДляЗагрузки.Добавить();
		СтрокаДанныеДляЗагрузки.Идентификатор = СтрокаИмпортируемыеОбъекты.КодВоВнешнейСистеме;
		СтрокаДанныеДляЗагрузки.Объект        = СтрокаИмпортируемыеОбъекты.Объект;
		
		ИдентификаторыВыбранныхОбъектов.Добавить(СтрокаДанныеДляЗагрузки.Идентификатор);
	КонецЦикла;		
	
	Если ДанныеДляЗагрузки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны данные для загрузки");
		Возврат Неопределено;
	КонецЕсли;		
		
	ДанныеДляЗагрузки.Индексы.Добавить("Идентификатор");
	
	// получим и проверим правила загрузки данных
	СтрокаСоединения = ПолучитьСтрокуСоединенияССерверомДанных(ЭтотОбъект.ГруппаПравил);
	Если ПустаяСтрока(СтрокаСоединения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В правилах импорта для группы правил '" + ЭтотОбъект.ГруппаПравил + "' не задана строка соединения с сервером данных");
		Возврат Неопределено;
	КонецЕсли;
	
	ВнешняяСистема = ПолучитьВнешнююСистему(ЭтотОбъект.ГруппаПравил);
	Если Не ЗначениеЗаполнено(ВнешняяСистема) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В правилах импорта для группы правил '" + ЭтотОбъект.ГруппаПравил + "' не задана внешняя система, из которой осуществляется импорт данных");
		Возврат Неопределено;
	КонецЕсли;
	
	ПравилаИмпорта = ПолучитьПравилаИмпорта(ЭтотОбъект.ГруппаПравил, ЭтотОбъект.ГруппаОбъектов, ИдентификаторыВыбранныхОбъектов);
	Если ПравилаИмпорта.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заданы правила импорта данных для группы объектов '" + ЭтотОбъект.ГруппаОбъектов + "'");
		Возврат Неопределено;
	КонецЕсли;
	
	Для НомПравила = 0 По ПравилаИмпорта.Количество() - 1 Цикл
		ПравилоИмпорта = ПравилаИмпорта[НомПравила]; // это должна быть структура со свойствами "ГруппаОбъектовМД" и "ТекстЗапроса"
		
		Если ПустаяСтрока(ПравилоИмпорта.ПриемникДанных) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задан приемник данных в правиле № " + НомПравила);
			Возврат Неопределено;
		КонецЕсли;
		
		Если ПравилоИмпорта.ПриемникДанных <> "*" Тогда // просто запрос, из которого могут быть вызваны поддерживаемые функции, например, ПолучитьФункциональнуюРольБанка
		
			ПозРаздТипаИВидаОбъекта = Найти(ПравилоИмпорта.ПриемникДанных, ".");
			Если ПозРаздТипаИВидаОбъекта = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В правиле № " + НомПравила + " приемник данных задан некорректно. Примеры корректных значений: 'Справочники.ЮрФизЛица', 'РегистрыСведений.КонтактнаяИнформация'");
				Возврат Неопределено;
			КонецЕсли;
			
			ИмяТипаОбъектов = НРег(Лев(ПравилоИмпорта.ПриемникДанных, ПозРаздТипаИВидаОбъекта - 1));
			Если (ИмяТипаОбъектов <> "справочники") и (ИмяТипаОбъектов <> "регистрысведений") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В правиле № " + НомПравила + " тип приемника данных '" + ИмяТипаОбъектов + "' отличен от поддерживаемых 'Справочники' и 'РегистрыСведений'");
				Возврат Неопределено;
			КонецЕсли;
			
			ИмяВидаОбъекта = НРег(Сред(ПравилоИмпорта.ПриемникДанных, ПозРаздТипаИВидаОбъекта + 1));
			Если Метаданные[ИмяТипаОбъектов].Найти(ИмяВидаОбъекта) = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В правиле № " + НомПравила + " указанный вид приемника данных '" + ИмяВидаОбъекта + "' отсутствует в типе объектов '" + ИмяТипаОбъектов + "'");
				Возврат Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбработанныеОбъекты = Новый ТаблицаЗначений;
	ОбработанныеОбъекты.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(МаксДопДлинаИдентификатора)));
	ОбработанныеОбъекты.Колонки.Добавить("Объект");
	ОбработанныеОбъекты.Колонки.Добавить("НовыйОбъект");
	ОбработанныеОбъекты.Колонки.Добавить("ОписаниеДействия");	
	
	ПараметрыВыборкиДанных = Новый Структура();
	ПараметрыВыборкиДанных.Вставить("ОбработанныеОбъекты", ОбработанныеОбъекты);
	ПараметрыВыборкиДанных.Вставить("ГруппаОбъектов",      ЭтотОбъект.ГруппаОбъектов);
	ПараметрыВыборкиДанных.Вставить("Подразделение",       ЭтотОбъект.Подразделение);
	ПараметрыВыборкиДанных.Вставить("Язык",                ЭтотОбъект.Язык);
	ПараметрыВыборкиДанных.Вставить("ВнешняяСистема",      ВнешняяСистема);
	ПараметрыВыборкиДанных.Вставить("ГлубинаРекурсии",     ГлубинаРекурсии);
	
	// последовательно выполним запросы и загрузим полученные данные в базу
	НачатьТранзакцию();
	
	ТипыДанныхДляОповещения = Новый Массив();
	
	Для каждого ПравилоИмпорта Из ПравилаИмпорта Цикл
		Если ПравилоИмпорта.ПриемникДанных = "*" И ПравилоИмпорта.Режим = "ВызовФункции" Тогда // Для данного режима импортировать ничего не требуется
			
			Если       ПравилоИмпорта.ИмяФункции = "СкопироватьРеквизитыГоловнойОрганизацииВФилиалТраста" Тогда
				
				Если ЭтотОбъект.ИмпортируемыеОбъекты.Найти(КодТрастФилиалМосква, "КодВоВнешнейСистеме") <> Неопределено Тогда
					СкопироватьРеквизитыГоловнойОрганизацииВФилиалТраста(КодТрастФилиалМосква);
				КонецЕсли;
				
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		ВнешниеДанные = ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ПравилоИмпорта.ТекстЗапроса, ПараметрыВыборкиДанных, Ошибки);
		
		Если ВнешниеДанные = Неопределено Тогда
			ОтменитьТранзакции(ГлубинаРекурсии);
			ЗарегистрироватьОшибки(Ошибки, РезультатОбновления);
			ТипыДанныхДляОповещения = Неопределено;
			Возврат Неопределено; 
		КонецЕсли;

		ЗарегистрироватьОшибки(Ошибки, РезультатОбновления);
			
		СтрокиСОшибками = ВнешниеДанные.Скопировать(Новый Структура("СодержитОшибки", Истина));
		ВнешниеДанные = ВнешниеДанные.Скопировать(Новый Структура("СодержитОшибки", Ложь));
		
		Если ПравилоИмпорта.ПриемникДанных = "*" Тогда
			Продолжить;
		КонецЕсли;
		
		ГруппаОбъектовМД = НРег(Лев(ПравилоИмпорта.ПриемникДанных, Найти(ПравилоИмпорта.ПриемникДанных, ".") - 1));
		ИмяОбъектаМД     = Сред(ПравилоИмпорта.ПриемникДанных, Найти(ПравилоИмпорта.ПриемникДанных, ".") + 1);
		
		ОбъектМД = Метаданные[ГруппаОбъектовМД][ИмяОбъектаМД];
		
		ОбновляемыеРеквизиты = Новый Массив;
		
		Если      ГруппаОбъектовМД = "справочники" Тогда
			Если ТипыДанныхДляОповещения.Найти(Тип("СправочникСсылка." + ИмяОбъектаМД)) = Неопределено Тогда
				ТипыДанныхДляОповещения.Добавить(Тип("СправочникСсылка." + ИмяОбъектаМД));
			КонецЕсли;
			
			Если ИмяОбъектаМД = "Облигации" Тогда
				ПодготовитьОблигации(ВнешниеДанные, ДанныеДляЗагрузки);
			КонецЕсли;
			
			МенеджерОбъекта = Справочники[ИмяОбъектаМД];
			
			ПустаяСсылка = МенеджерОбъекта.ПустаяСсылка();
			
			Для каждого Колонка Из ВнешниеДанные.Колонки Цикл
				Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(ПустаяСсылка, Колонка.Имя) Тогда
					ОбновляемыеРеквизиты.Добавить(Колонка.Имя);
				КонецЕсли;
			КонецЦикла;
			
			Для каждого СтрокаВнешниеДанные Из ВнешниеДанные Цикл
				СсылкаНаОбъект = Неопределено;

				Если Не ПравилоИмпорта.ПодчиненныйСправочник Тогда
					// если это повторная загрузка объекта, то объект должен быть передан в коллекции данных для загрузки
					СтрокаДанныеДляЗагрузки = ДанныеДляЗагрузки.Найти(Строка(СтрокаВнешниеДанные.Идентификатор), "Идентификатор");
					Если СтрокаДанныеДляЗагрузки <> Неопределено Тогда
						СсылкаНаОбъект = СтрокаДанныеДляЗагрузки.Объект;
					КонецЕсли;
						
					Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
						// создадим новый элемент справочника
						СсылкаНаОбъект = МенеджерОбъекта.ПолучитьСсылку();
						
						СправочникОбъект = МенеджерОбъекта.СоздатьЭлемент();
						СправочникОбъект.УстановитьСсылкуНового(СсылкаНаОбъект);
						
						// зафиксируем код объекта во внешней системе
						РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(СсылкаНаОбъект, ВнешняяСистема, ЭтотОбъект.ГруппаОбъектов, СтрокаВнешниеДанные.Идентификатор);
						
					Иначе
						СправочникОбъект = СсылкаНаОбъект.ПолучитьОбъект();
						СправочникОбъект.Заблокировать();
						
					КонецЕсли;
					
				Иначе
					СсылкаНаОбъект = МенеджерОбъекта.НайтиПоРеквизиту(ПравилоИмпорта.ПолеВладельца, СтрокаВнешниеДанные[ПравилоИмпорта.ПолеВладельца]);
					
					Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда // подчиненные справочники не создаем
						Продолжить;
					КонецЕсли;
					
					СправочникОбъект = СсылкаНаОбъект.ПолучитьОбъект();
					СправочникОбъект.Заблокировать();
						
				КонецЕсли;
				
				// заполним реквизиты объекта и запишем его в базу
				ОписаниеРасхождений = "";
				ЭтоНовыйОбъект      = СправочникОбъект.ЭтоНовый();
				
				// Для дробной и неиспользуемой акции Интер РАО меняем наименование
				Если ПравилоИмпорта.ПриемникДанных = "Справочники.Акции"
					И ВСоставеЕстьНеиспользуемаяАкцияИнтерРАО
					И СсылкаНаОбъект = НеиспользуемаяАкцияИнтерРАО Тогда
					СтрокаВнешниеДанные.Наименование = СтрокаВнешниеДанные.Наименование + " (дробная, не используется)";
				КонецЕсли;
				
				Если НайтиУстранитьРасхожденияВСправочнике(СправочникОбъект, СтрокаВнешниеДанные, ОбновляемыеРеквизиты, ВнешняяСистема, ОписаниеРасхождений, РезультатОбновления) = Неопределено Тогда
					// если не удалось записать подчиненный объект - отменим транзакции на всех уровнях вложенности	
					ОтменитьТранзакции(ГлубинаРекурсии); 
					ТипыДанныхДляОповещения = Неопределено;
					Возврат Неопределено;
				КонецЕсли;
				
				Если Не ПравилоИмпорта.ПодчиненныйСправочник Тогда
					НоваяСтрокаОбработанныеОбъекты = ОбработанныеОбъекты.Добавить();
					НоваяСтрокаОбработанныеОбъекты.Идентификатор    = СтрокаВнешниеДанные.Идентификатор;
					НоваяСтрокаОбработанныеОбъекты.Объект           = СсылкаНаОбъект;
					НоваяСтрокаОбработанныеОбъекты.НовыйОбъект      = ЭтоНовыйОбъект;
					НоваяСтрокаОбработанныеОбъекты.ОписаниеДействия = ОписаниеРасхождений;
						
					ПараметрыВыборкиДанных.ОбработанныеОбъекты = ОбработанныеОбъекты;
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли ГруппаОбъектовМД = "регистрысведений" Тогда
			Если ТипыДанныхДляОповещения.Найти(Тип("РегистрСведенийКлючЗаписи." + ИмяОбъектаМД)) = Неопределено Тогда
				ТипыДанныхДляОповещения.Добавить(Тип("РегистрСведенийКлючЗаписи." + ИмяОбъектаМД));
			КонецЕсли;
			
			Если ИмяОбъектаМД = "НоминалыЦенныхБумаг" Тогда 
			    РассчитатьНоминалыЦенныхБумаг(ВнешниеДанные);
			ИначеЕсли ИмяОбъектаМД = "СвязанныеЮридическиеЛица" Тогда
				ВнешниеДанные = ПодготовитьСвязанныеЮридическиеЛицаКЗаписи(ВнешниеДанные);
			ИначеЕсли ИмяОбъектаМД = "КупонныйДоходПоОблигациям" Тогда
				ПодготовитьКупонныйДоходПоОблигациям(ВнешниеДанные, Ошибки);
				ЗарегистрироватьОшибки(Ошибки, РезультатОбновления);
			ИначеЕсли ИмяОбъектаМД = "ДефолтыПоОблигациям" Тогда
				// Выделяем строки с техническим дефолтом и с обычным
				ПодготовитьДефолтыПоОблигациям(ВнешниеДанные);
			ИначеЕсли ИмяОбъектаМД = "РасчетныеЦеныПаев" Тогда
				// Исключим из внешних данных цены за периоды нашего ДУ,
				// и дополним внешние данные данными регистра "Расчетные цены паев"
				// за периоды нашего ДУ.
				ПодготовитьРасчетныеЦеныПаев(ВнешниеДанные);
			КонецЕсли; 
					
			// выделим ключевые поля, по которым читать набор записей
			КлючевыеПоля = Новый Массив(); 
			
			Для Каждого Измерение Из ОбъектМД.Измерения Цикл
				
				Если Измерение.Ведущее Тогда
					КлючевыеПоля.Добавить(Измерение.Имя);
				КонецЕсли;
				
			КонецЦикла;
			
			// Данные регистра "КодыВоВнешнихСистемах" импортируются с указанием значения измерения "Внешняя система" = "Матрих"
			// Данные регистра "Перечни объектов" импортируются с указанием значения измерения "Внешняя система" = "Центральный банк РФ".
			// Чтобы не затирать данные этих регистров по другим внешним системам добавим поля Не Ведущих измерений.
			Если ИмяОбъектаМД = "КодыВоВнешнихСистемах" Тогда	
				КлючевыеПоля.Добавить("ВнешняяСистема");
				КлючевыеПоля.Добавить("ГруппаОбъектов");
			ИначеЕсли ИмяОбъектаМД = "ПеречниОбъектов" Тогда
				КлючевыеПоля.Добавить("ВнешняяСистема");		
			КонецЕсли;
			
			КлючевыеПоляСтр = РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(КлючевыеПоля, ", ");
			
			ВспомогательныеДанные = Новый Структура;
			//	Для реквизитов юридических лиц заранее формируем список юр. лиц депозитариев, банков, брокеров.
			//  Требуется для формирования оповещений
			Если ИмяОбъектаМД = "РеквизитыЮридическихЛиц" Тогда
				ВспомогательныеДанные.Вставить("ЮридическиеЛицаПоДействующимСчетамДУ", РаботаСНормативноСправочнойИнформацией.ЮридическиеЛицаИспользуемыеДействующимиСчетамДоверительногоУправления(ТекущаяДатаСеанса()));
			КонецЕсли;
			
			// обновим данные регистра сведений
			ВариантыЗначенийКлючевыхПолей = ВнешниеДанные.Скопировать(, КлючевыеПоляСтр);
			ВариантыЗначенийКлючевыхПолей.Свернуть(КлючевыеПоляСтр);
			
			Для Каждого ВариантЗначенийКлючевыхПолей Из ВариантыЗначенийКлючевыхПолей Цикл
				ЗначенияКлючевыхПолей = Новый Структура(КлючевыеПоляСтр);
				ЗаполнитьЗначенияСвойств(ЗначенияКлючевыхПолей, ВариантЗначенийКлючевыхПолей);
				
				ОписаниеРасхождений = "";
				
				Результат = НайтиУстранитьРасхожденияВРегистреСведений(ИмяОбъектаМД, ВнешниеДанные.Скопировать(ЗначенияКлючевыхПолей), КлючевыеПоля, ЗначенияКлючевыхПолей, ОписаниеРасхождений, РезультатОбновления, ВспомогательныеДанные);
				
				Если Результат = Неопределено Тогда
					// если не удалось записать подчиненный объект - отменим транзакции на всех уровнях вложенности	
					ОтменитьТранзакции(ГлубинаРекурсии); 
					ТипыДанныхДляОповещения = Неопределено;
					Возврат Неопределено;
					
				ИначеЕсли Результат = Истина Тогда
					
					СтрокаОбработанныеОбъекты = Неопределено; 
					
					// Изменения регистра "КодыВоВнешнихСистемах" не попадают в отчет с описанием, т.к. количество ключевых полей > 1 (неявный признак).   
					Если КлючевыеПоля.Количество() = 1 Или ИмяОбъектаМД = "ПеречниОбъектов" Тогда
						
						ЗначениеКлюч = ?(КлючевыеПоля.Количество() = 1, ЗначенияКлючевыхПолей[КлючевыеПоля[0]], ЗначенияКлючевыхПолей.Объект); 
						СтрокаОбработанныеОбъекты = ОбработанныеОбъекты.Найти(ЗначениеКлюч, "Объект");
						
						Если СтрокаОбработанныеОбъекты <> Неопределено Тогда
							
							СтрокаОбработанныеОбъекты.ОписаниеДействия = СтрокаОбработанныеОбъекты.ОписаниеДействия
								+ ?(ПустаяСтрока(СтрокаОбработанныеОбъекты.ОписаниеДействия), "", Символы.ПС) + "Изменены записи регистра сведений " + Метаданные.РегистрыСведений[ИмяОбъектаМД].Представление()
								+ Символы.ПС + ОписаниеРасхождений;
								
						КонецЕсли;
							
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
			СтрокиСОшибками.Свернуть(КлючевыеПоляСтр);
				
		КонецЕсли;
		
		ПрерватьОбработкуПравил = Ложь;
		
		Для каждого СтрокаСОшибками Из СтрокиСОшибками Цикл
		
			Если ГруппаОбъектовМД = "справочники" Тогда
				
				ТекстСообщения = "Не удалось импортировать элемент справочника '" + Метаданные.Справочники[ИмяОбъектаМД].Представление() + "' с кодом '" + СтрокаСОшибками.Идентификатор + ". Ошибка при импорте связанных данных";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, ПрерватьОбработкуПравил);
				
				Если РезультатОбновления <> Неопределено Тогда
					РезультатОбновления.СообщенияОбОшибках.Добавить(ТекстСообщения);
				КонецЕсли;
				
			ИначеЕсли ГруппаОбъектовМД = "регистрысведений" Тогда 
				
				ОписаниеКлючевыхПолей = "";
				Для каждого КлючевоеПоле Из КлючевыеПоля Цикл
					ОписаниеКлючевыхПолей = ОписаниеКлючевыхПолей + ?(ПустаяСтрока(ОписаниеКлючевыхПолей), "", ", ") + КлючевоеПоле + " [" + СтрокаСОшибками[КлючевоеПоле] + "]";
				КонецЦикла;
				
				ТекстСообщения = "Не удалось импортировать записи регистра сведений '" + Метаданные.РегистрыСведений[ИмяОбъектаМД].Представление() + "', относящиеся к " + ОписаниеКлючевыхПолей + ". Ошибка при импорте связанных данных";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				
				Если РезультатОбновления <> Неопределено Тогда
					РезультатОбновления.СообщенияОбОшибках.Добавить(ТекстСообщения);
				КонецЕсли;
				
			КонецЕсли;
		
		КонецЦикла; 
		
		Если ПрерватьОбработкуПравил Тогда
			Прервать;
		КонецЕсли; 
		
	КонецЦикла;
	
	Если ТранзакцияАктивна() Тогда
	
		ЗафиксироватьТранзакцию();
	
	КонецЕсли; 
	
	Для каждого СтрокаОбработанныеОбъекты Из ОбработанныеОбъекты Цикл
		
		Если СтрокаОбработанныеОбъекты.НовыйОбъект Тогда
			// по новым объекам загрузим котировки
			Если Метаданные.Обработки.ИмпортКотировокММВБ.Реквизиты.ЦеннаяБумага.Тип.СодержитТип(ТипЗнч(СтрокаОбработанныеОбъекты.Объект)) Тогда
		
				Обработки.ИмпортКотировокММВБ.ИмпортироватьКотировкиПоНовымЦеннымБумагам(СтрокаОбработанныеОбъекты.Объект, ЭтотОбъект.Метаданные().ПолноеИмя());
				
				ДополнительнаяОбработкаСсылка = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта("_ИмпортРыночныхРисковНКЦ");
				Если ДополнительнаяОбработкаСсылка = Неопределено Тогда
					РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку("Не удалось запустить импорт рыночных рисков НКЦ. Обработка '_ИмпортРыночныхРисковНКЦ' не найдена", "Импорт рыночных рисков НКЦ");
					
				Иначе
					
					Параметры = Новый Структура("ЦеннаяБумага", СтрокаОбработанныеОбъекты.Объект);
					
					Параметры.Вставить("ИсточникОшибки",	"Импорт рыночных рисков НКЦ");
					
					Параметры.Вставить("ТекстОшибки",		"Не удалось добавить отложенное задание '_ИмпортРыночныхРисковНКЦ.ИмпортироватьРыночныеРискиНКЦ'.");
					РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание(ДополнительнаяОбработкаСсылка, "ИмпортироватьРыночныеРискиНКЦ", Параметры, 15, Истина);
					
				КонецЕсли	
				
			КонецЕсли;
			// загрузим расчетные цены НРД
			Если Метаданные.Обработки.ИмпортРасчетныхЦен.Реквизиты.ЦеннаяБумага.Тип.СодержитТип(ТипЗнч(СтрокаОбработанныеОбъекты.Объект)) Тогда
				
				Обработки.ИмпортРасчетныхЦен.ИмпортироватьРасчетныеЦеныПоНовымЦеннымБумагам(СтрокаОбработанныеОбъекты.Объект, ЭтотОбъект.Метаданные().ПолноеИмя());
				
			КонецЕсли;			
			// загрузим рейтинги
			Если Метаданные.Обработки.ИмпортРейтингов.Реквизиты.Субъект.Тип.СодержитТип(ТипЗнч(СтрокаОбработанныеОбъекты.Объект)) 
				И Не (ТипЗнч(СтрокаОбработанныеОбъекты.Объект) = Тип("СправочникСсылка.ЮрФизЛица") И СтрокаОбработанныеОбъекты.Объект.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо) Тогда
				
				УстановитьПривилегированныйРежим(Истина);

				ОбработкаИмпортРейтингов = Обработки.ИмпортРейтингов.Создать();
				ОбработкаИмпортРейтингов.Субъект = СтрокаОбработанныеОбъекты.Объект;
				ОбработкаИмпортРейтингов.ДополнительныеСвойства.Вставить("Источник", ЭтотОбъект.Метаданные().ПолноеИмя());
				ОбработкаИмпортРейтингов.ВыполнитьКоманду("КомандаИмпортировать");
				
				УстановитьПривилегированныйРежим(Ложь);
				
			КонецЕсли;
			
			Если Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип.СодержитТип(ТипЗнч(СтрокаОбработанныеОбъекты.Объект)) Тогда
			
				// загрузим обязательства маркет-мейкеров				
				ДополнительнаяОбработкаСсылка = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта("_ИмпортОбязательствМаркетМейкеров");
				Если ДополнительнаяОбработкаСсылка = Неопределено Тогда
					РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку("Не удалось запустить импорт обязательств маркет-мейкеров. Обработка '_ИмпортОбязательствМаркетМейкеров' не найдена", "Импорт обязательств маркет-мейкеров");
					
				Иначе
					
					Параметры = Новый Структура("ЦеннаяБумага", СтрокаОбработанныеОбъекты.Объект);
					
					Параметры.Вставить("ТекстОшибки",		"Не удалось добавить отложенное задание '_ИмпортОбязательствМаркетМейкеров.ИмпортироватьМаркетМейкеровПоЦеннойБумаге'.");
					Параметры.Вставить("ИсточникОшибки",	"Импорт обязательств маркет-мейкеров");
					
					РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание(ДополнительнаяОбработкаСсылка, "ИмпортироватьМаркетМейкеровПоЦеннойБумаге", Параметры, 15, Истина);					
					
				КонецЕсли;
			
			КонецЕсли;
			
			Если ТипЗнч(СтрокаОбработанныеОбъекты.Объект) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
				
				// загрузим информацию по связанным лицам				
				ДополнительнаяОбработкаСсылка = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта("_УправлениеСвязаннымиЛицами");
				Если ДополнительнаяОбработкаСсылка = Неопределено Тогда
					РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку("Не удалось запустить импорт связанных лиц. Обработка '_УправлениеСвязаннымиЛицами' не найдена", "Импорт связанных лиц");
					
				Иначе
					
					Параметры = Новый Структура("СвязанноеЛицо", СтрокаОбработанныеОбъекты.Объект);
					
					Параметры.Вставить("ИсточникОшибки",	"Импорт связанных лиц");
					
					Параметры.Вставить("ТекстОшибки",		"Не удалось добавить отложенное задание '_УправлениеСвязаннымиЛицами.ИмпортироватьСведенияОСвязанныхЛицах'.");
					РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание(ДополнительнаяОбработкаСсылка, "ИмпортироватьСведенияОСвязанныхЛицах", Параметры, 15, Истина);
					
					Параметры.Вставить("ТекстОшибки",		"Не удалось добавить отложенное задание '_УправлениеСвязаннымиЛицами.ИмпортСвязанныхЛицИнфинитум'.");
					РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание(ДополнительнаяОбработкаСсылка, "ИмпортСвязанныхЛицИнфинитум", Параметры, 15, Истина);
					
				КонецЕсли;
				
				Если СтрокаОбработанныеОбъекты.Объект.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
				
					// загрузим обязательства маркет-мейкеров				
					ДополнительнаяОбработкаСсылка = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта("_ИмпортОбязательствМаркетМейкеров");
					Если ДополнительнаяОбработкаСсылка = Неопределено Тогда
						РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку("Не удалось запустить импорт обязательств маркет-мейкеров. Обработка '_ИмпортОбязательствМаркетМейкеров' не найдена", "Импорт обязательств маркет-мейкеров");
						
					Иначе
						
						Параметры = Новый Структура("ЮрФизЛицо", СтрокаОбработанныеОбъекты.Объект);
						
						Параметры.Вставить("ТекстОшибки",		"Не удалось добавить отложенное задание '_ИмпортОбязательствМаркетМейкеров.ИмпортироватьОбязательстваМаркетМейкера'.");
						Параметры.Вставить("ИсточникОшибки",	"Импорт обязательств маркет-мейкеров");
						
						РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание(ДополнительнаяОбработкаСсылка, "ИмпортироватьОбязательстваМаркетМейкера", Параметры, 15, Истина);					
						
					КонецЕсли;
				
				КонецЕсли;
				
			КонецЕсли; 
				
		КонецЕсли;
		
	КонецЦикла;
	
	// отобразим импортированные объекты
	Для каждого СтрокаОбработанныеОбъекты Из ОбработанныеОбъекты Цикл
		
		СтрокиИмпортируемыеОбъекты = ЭтотОбъект.ИмпортируемыеОбъекты.НайтиСтроки(Новый Структура("КодВоВнешнейСистеме", СтрокаОбработанныеОбъекты.Идентификатор));
		
		Для каждого СтрокаИмпортируемыеОбъекты Из СтрокиИмпортируемыеОбъекты Цикл
			СтрокаИмпортируемыеОбъекты.Объект = СтрокаОбработанныеОбъекты.Объект;
		КонецЦикла;
		
		НоваяСтрока						= ИнформацияОбОбновлении.Добавить();
		НоваяСтрока.Объект				= СтрокаОбработанныеОбъекты.Объект;
		НоваяСтрока.ГруппаОбъектов		= ЭтотОбъект.ГруппаОбъектов;
		НоваяСтрока.КодВоВнешнейСистеме	= СтрокаОбработанныеОбъекты.Идентификатор;
		
		Если СтрокаОбработанныеОбъекты.НовыйОбъект Тогда
			
			ТекстСообщения = "'" + СтрокаОбработанныеОбъекты.Объект + "' (" + ЭтотОбъект.ГруппаОбъектов + ", " + СтрокаОбработанныеОбъекты.Идентификатор + ") импортирован из " + ВнешняяСистема;
			
			НоваяСтрока.Создан = Истина;
			
		Иначе		
			
			Если ЗначениеЗаполнено(СтрокаОбработанныеОбъекты.ОписаниеДействия) Тогда
				
				ТекстСообщения = "'" + СтрокаОбработанныеОбъекты.Объект + "' (" + ЭтотОбъект.ГруппаОбъектов + ", " + СтрокаОбработанныеОбъекты.Идентификатор + ") обновлен из " + ВнешняяСистема + ":" + Символы.ПС + СтрокаОбработанныеОбъекты.ОписаниеДействия;
				
				НоваяСтрока.Обновлен			= Истина;
				НоваяСтрока.ОписаниеИзменений	= СтрокаОбработанныеОбъекты.ОписаниеДействия;
				
			Иначе
				ТекстСообщения = "Обновление '" + СтрокаОбработанныеОбъекты.Объект + "' (" + ЭтотОбъект.ГруппаОбъектов + ", " + СтрокаОбработанныеОбъекты.Идентификатор + ") из " + ВнешняяСистема + " не требуется";
			КонецЕсли;
			
		КонецЕсли;
		
		Если НоваяСтрока.Создан И Не ЭтотОбъект.НеСообщатьОСозданииНовыхОбъектов
			ИЛИ НоваяСтрока.Обновлен И Не ЭтотОбъект.НеСообщатьОбИзмененииОбъектов
			ИЛИ Не НоваяСтрока.Создан И Не НоваяСтрока.Обновлен И Не ЭтотОбъект.НеСообщатьОбОтсутствииИзменений 
		Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, СтрокаОбработанныеОбъекты.Объект);
		КонецЕсли;
		
		РегистрыСведений.ОбновленияОбъектовИзВнешнихСистем.ЗарегистрироватьДатуОбновления(СтрокаОбработанныеОбъекты.Объект, ВнешняяСистема, ТекстСообщения);
		
	КонецЦикла;
	
	Если РезультатОбновления = Неопределено Тогда
		Обработки.ИмпортНормативноСправочнойИнформации.ОтправитьОтчетОЗамещающихОблигациях(ИнформацияОбОбновлении);	
		
		Обработки.ИмпортНормативноСправочнойИнформации.СформироватьОтчетОбОбновленииДляБухгалтерии(ИнформацияОбОбновлении);
		
	КонецЕсли;
 
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
	Возврат ОбработанныеОбъекты.ВыгрузитьКолонку("Объект");
	
КонецФункции // ИмпортироватьДанные

Функция ПолучитьДанныеДляВыбора(СтрокаПоиска = "") Экспорт

	// получим данные из внешней системы
	СтрокаСоединения = ПолучитьСтрокуСоединенияССерверомДанных(ЭтотОбъект.ГруппаПравил);
	Если ПустаяСтрока(СтрокаСоединения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В правилах импорта для группы правил «" + ЭтотОбъект.ГруппаПравил + "» не задана строка соединения с сервером данных.");
		Возврат Неопределено;
	КонецЕсли;
	
	ВнешняяСистема = ПолучитьВнешнююСистему(ЭтотОбъект.ГруппаПравил);
	Если НЕ ЗначениеЗаполнено(ВнешняяСистема) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В правилах импорта для группы правил «" + ЭтотОбъект.ГруппаПравил + "» не задана внешняя система, из которой осуществляется импорт данных.");
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстЗапроса = ПолучитьЗапросДляВыбораДанных(ЭтотОбъект.ГруппаПравил, ЭтотОбъект.ГруппаОбъектов,, СтрокаПоиска);
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В правилах импорта для группы объектов «" + ЭтотОбъект.ГруппаОбъектов + "» из группы правил «" + ЭтотОбъект.ГруппаПравил + "» не задан текст запроса к серверу данных на получение данных для интерактивного выбора.");
		Возврат Неопределено;
	КонецЕсли;
	
	ВнешниеДанные = ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса, Новый Структура);
	Если ВнешниеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// проверим, что в полученной таблице есть поля Идентификатор и Представление
	Если ВнешниеДанные.Колонки.Найти("Идентификатор") = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В данных, полученных для интерактивного выбора, отсутствует поле «Идентификатор»");
		Возврат Неопределено;
	КонецЕсли;
	
	Если ВнешниеДанные.Колонки.Найти("Представление") = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В данных, полученных для интерактивного выбора, отсутствует поле «Представление»");
		Возврат Неопределено;
	КонецЕсли;	
	
	// определим ранее импортированные объекты
	ПоляВнешнихДанных = "";
	Для каждого Колонка Из ВнешниеДанные.Колонки Цикл
		ПоляВнешнихДанных = ПоляВнешнихДанных + ?(ПустаяСтрока(ПоляВнешнихДанных), "", ", ") + Колонка.Имя;
	КонецЦикла;
	
	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	" + ПоляВнешнихДанных + "
		|ПОМЕСТИТЬ ВнешниеДанные
		|ИЗ
		|	&ВнешниеДанные КАК ВнешниеДанные
		|ИНДЕКСИРОВАТЬ ПО
		|	Идентификатор
		|;
	    |
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ПОМЕСТИТЬ КодыВоВнешнихСистемах
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&Период,
		|			ВнешняяСистема = &ВнешняяСистема
		|				И ГруппаОбъектов = &ГруппаОбъектов) КАК КодыВоВнешнихСистемахСрезПоследних
		|ИНДЕКСИРОВАТЬ ПО
		|	Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|   ВнешниеДанные.*,
		|	КодыВоВнешнихСистемах.Объект
		|ИЗ
		|	ВнешниеДанные
		|	ЛЕВОЕ СОЕДИНЕНИЕ КодыВоВнешнихСистемах ПО ВнешниеДанные.Идентификатор = КодыВоВнешнихСистемах.Код
		|" + ?(ЭтотОбъект.СкрыватьРанееЗагруженныеДанные, "ГДЕ КодыВоВнешнихСистемах.Объект ЕСТЬ NULL", "") + "
		|УПОРЯДОЧИТЬ ПО
		|	ВнешниеДанные.Представление";
	
	Запрос.УстановитьПараметр("Период",         ТекущаяДата());
	Запрос.УстановитьПараметр("ВнешняяСистема", ВнешняяСистема);
	Запрос.УстановитьПараметр("ГруппаОбъектов", ЭтотОбъект.ГруппаОбъектов);
	Запрос.УстановитьПараметр("ВнешниеДанные",  ВнешниеДанные);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

