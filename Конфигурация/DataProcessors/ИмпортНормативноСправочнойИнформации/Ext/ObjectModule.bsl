Функция ADODBC_ВыгрузитьЗаписиИзНабораВТаблицуЗначений(НаборЗаписей, Параметры = Неопределено, Ошибки)
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	
	Поля         = Новый Массив();
	ПоляФункции  = Новый Массив();
	ПоляВыражения = Новый Массив();
	
	Попытка
		ПоляЗаписи = НаборЗаписей.Fields;
		
		// создадим колонки таблицы значений
		Для НомПоля = 0 По ПоляЗаписи.Count - 1 Цикл
			ПолеЗаписи = ПоляЗаписи.Item(НомПоля);
			
			ИмяПоля = ПолеЗаписи.Name;
			Если      Лев(ИмяПоля, 2) = "$$" Тогда // это поле содержит вызов функции
				ИмяПоля = Сред(ИмяПоля, 3);
				ПоляФункции.Добавить(ИмяПоля);
			ИначеЕсли Лев(ИмяПоля, 1) = "$"  Тогда // это поле содержит обращение к параметру или предопределенному значению
				ИмяПоля = Сред(ИмяПоля, 2);
				ПоляВыражения.Добавить(ИмяПоля);
			КонецЕсли;
			
			ОписаниеТипа = Неопределено;
			
			// выделим тип из имени поля
			ПозРазделителяТипа = Найти(ИмяПоля, ":");
			Если ПозРазделителяТипа > 0 Тогда
				ПредставлениеТипа = НРег(Сред(ИмяПоля, ПозРазделителяТипа + 1));
				
				Если Лев(ПредставлениеТипа, 6) = "строка" Тогда
					ДлинаСтроки = 0; // неограниченная
					
					ПозРазделителяДлины = Найти(ПредставлениеТипа, ":");
					Если ПозРазделителяДлины > 0 Тогда
						ДлинаСтроки = Число(Сред(ПредставлениеТипа, ПозРазделителяДлины + 1));
					КонецЕсли;
					
					ОписаниеТипа = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(ДлинаСтроки));
					
				ИначеЕсли Лев(ПредставлениеТипа, 5) = "число" Тогда
					ДлинаЧисла    = 0;
					ТочностьЧисла = 0;
					
					ПозРазделителяДлины = Найти(ПредставлениеТипа, ":");
					Если ПозРазделителяДлины > 0 Тогда
						ОписаниеКвалификатора = Сред(ПредставлениеТипа, ПозРазделителяДлины + 1);
						
						ПозРазделителяТочности = Найти(ОписаниеКвалификатора, ":");
						Если ПозРазделителяТочности > 0 Тогда
							ДлинаЧисла    = Число(Лев(ОписаниеКвалификатора, ПозРазделителяТочности - 1));
							ТочностьЧисла = Число(Сред(ОписаниеКвалификатора, ПозРазделителяТочности + 1));
						Иначе
							ДлинаЧисла = Число(ОписаниеКвалификатора);
						КонецЕсли;
					КонецЕсли;
					
					ОписаниеТипа = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(ДлинаЧисла, ТочностьЧисла));
					
				Иначе
					ОписаниеТипа = Новый ОписаниеТипов(ПредставлениеТипа);
					
				КонецЕсли;
				
				
				ИмяПоля = Лев(ИмяПоля, ПозРазделителяТипа - 1);
			КонецЕсли;				
			
			Поля.Добавить(ИмяПоля);
			
			Если ОписаниеТипа = Неопределено Тогда
				ТаблицаЗначений.Колонки.Добавить(ИмяПоля);
			Иначе
				ТаблицаЗначений.Колонки.Добавить(ИмяПоля, ОписаниеТипа);
			КонецЕсли;
	    КонецЦикла;

		ТаблицаЗначений.Колонки.Добавить("СодержитОшибки", Новый ОписаниеТипов("Булево"));
		
		// заполним таблицу данными
		Пока НЕ НаборЗаписей.EOF() Цикл
			// новая строка и её заполнение
			СтрокаТаблицыЗначений = ТаблицаЗначений.Добавить();
			
			Для НомПоля = 0 По ПоляЗаписи.Count - 1 Цикл
				ЗначениеПоля = ПоляЗаписи.Item(НомПоля).Value;
				
				Если      ПоляВыражения.Найти(Поля[НомПоля]) <> Неопределено Тогда
					ЗначениеПоля = ВычислитьЗначениеПоля(ЗначениеПоля, Параметры);
					Если ЗначениеПоля = Неопределено Тогда
						Комментарий = "Не удалось вычислить значение выражения «" + ПоляЗаписи.Item(НомПоля).Value + "» поля «" + ПоляЗаписи.Item(НомПоля).Name + "» в запросе"
										+ Символы.ПС + НаборЗаписей.Source;
										
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Комментарий);
						
						Если Ошибки <> Неопределено Тогда
							ДобавитьОшибкуВМассив(Ошибки, Комментарий);
						КонецЕсли;	
						
						Возврат Неопределено;
					КонецЕсли;
					
				ИначеЕсли ПоляФункции.Найти(Поля[НомПоля]) <> Неопределено Тогда
					Если      Найти(ЗначениеПоля, "ПолучитьОбъектПоКодуВнешнейСистемы") = 1 Тогда
						ЗначениеПоля = СтрЗаменить(ЗначениеПоля, "ПолучитьОбъектПоКодуВнешнейСистемы(", "ПолучитьОбъектПоКодуВнешнейСистемы(Параметры, ");
					ИначеЕсли Найти(ЗначениеПоля, "ПолучитьСправочникПоРеквизиту") = 1 Тогда
						ЗначениеПоля = СтрЗаменить(ЗначениеПоля, "ПолучитьСправочникПоРеквизиту(", "ПолучитьСправочникПоРеквизиту(Параметры, ");
					ИначеЕсли Найти(ЗначениеПоля, "ПолучитьФункциональнуюРольЮрФизЛица") = 1 Тогда
						ЗначениеПоля = СтрЗаменить(ЗначениеПоля, "ПолучитьФункциональнуюРольЮрФизЛица(", "ПолучитьФункциональнуюРольЮрФизЛица(Параметры, ");
					ИначеЕсли Найти(ЗначениеПоля, "ПолучитьФункциональнуюРольБанка") = 1 Тогда
						ЗначениеПоля = СтрЗаменить(ЗначениеПоля, "ПолучитьФункциональнуюРольБанка(", "ПолучитьФункциональнуюРольБанка(Параметры, ");
					ИначеЕсли Найти(ЗначениеПоля, "ПолучитьНастройкуРасчетаПроцентаВекселя") = 1 Тогда
						ЗначениеПоля = СтрЗаменить(ЗначениеПоля, "ПолучитьНастройкуРасчетаПроцентаВекселя(", "ПолучитьНастройкуРасчетаПроцентаВекселя(Параметры, ");
					ИначеЕсли Найти(ЗначениеПоля, "ПредопределенноеЗначение") = 1 Тогда
						// функция глобального контекста, ничего делать не надо
					Иначе
						ЗначениеПоля = Неопределено;
					КонецЕсли;
					
					Если ЗначениеПоля <> Неопределено Тогда
						Попытка
							ЗначениеПоля = Вычислить(ЗначениеПоля);
						Исключение
							Комментарий = "Ошибка при выполнении пользовательской функции «" + ЗначениеПоля + "» в запросе"
											+ Символы.ПС + НаборЗаписей.Source
											+ Символы.ПС + " Система сообщает: " + ОписаниеОшибки()	+ """";
							
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Комментарий);
							
							Если Ошибки <> Неопределено Тогда
								ДобавитьОшибкуВМассив(Ошибки, Комментарий);
							КонецЕсли;	
							
							ЗначениеПоля = Неопределено;
							СтрокаТаблицыЗначений.СодержитОшибки = Истина;
							
						КонецПопытки;
					КонецЕсли;
					
				КонецЕсли;
				
				СтрокаТаблицыЗначений[НомПоля] = ЗначениеПоля;
				
				// выгрузим поля записи в структуру и передадим её в параметры, т.к. их значения могут пригодится для вычисления пользовательских функций
				ЗначенияПолей = Новый Структура;
				Для каждого Колонка Из ТаблицаЗначений.Колонки Цикл
					ЗначенияПолей.Вставить(Колонка.Имя, СтрокаТаблицыЗначений[Колонка.Имя]);
				КонецЦикла;
				
				Если ТипЗнч(Параметры) = Тип("Структура") Тогда
					Если Параметры.Свойство("ЗначенияПолей") <> Неопределено Тогда
						Параметры.Вставить("ЗначенияПолей", ЗначенияПолей);
					Иначе
						Параметры.ЗначенияПолей = ЗначенияПолей;
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
				
		    НаборЗаписей.MoveNext();
		КонецЦикла;
		
	Исключение
		ОписаниеОшибки = СтрЗаменить(ОписаниеОшибки(), """", "'");
		Пока Найти(ОписаниеОшибки, """") > 0 Цикл // двойные кавычки используем для разделения языков в НСтр
			ОписаниеОшибки = СтрЗаменить(ОписаниеОшибки, """", "'");
		КонецЦикла;
		
		Попытка
			ТекстЗапроса = НаборЗаписей.Source;
			Пока Найти(ТекстЗапроса, """") > 0 Цикл // двойные кавычки используем для разделения языков в НСтр
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, """", "'");
			КонецЦикла;
		Исключение
			ТекстЗапроса = "<>";
		КонецПопытки;
		
		Комментарий = "Не удалось выгрузить результат запроса "
						+ Символы.ПС + ТекстЗапроса
						+ Символы.ПС + "в таблицу значений. Система сообщает: " + ОписаниеОшибки + """";
						
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Комментарий);
		
		Если Ошибки <> Неопределено Тогда
			ДобавитьОшибкуВМассив(Ошибки, Комментарий);
		КонецЕсли;	
		
		Возврат Неопределено;
		
	КонецПопытки;
	
	Возврат ТаблицаЗначений;
	
КонецФункции // ADODBC_ВыгрузитьЗаписиИзНабораВТаблицуЗначений

Функция ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса, Параметры = Неопределено, Ошибки = Неопределено)
	
	Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(СтрокаСоединения);
	Если Соединение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НаборЗаписей = РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(Соединение, ТекстЗапроса);
	Если НаборЗаписей = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВнешниеДанные = ADODBC_ВыгрузитьЗаписиИзНабораВТаблицуЗначений(НаборЗаписей, Параметры, Ошибки);
	
	РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);
	
	Возврат ВнешниеДанные;
	
КонецФункции // ADODBC_ПолучитьТаблицуДанныхССервера

