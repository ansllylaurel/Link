Функция ПолучитьГруппыПравил() Экспорт
	
	ГруппыПравил = Новый Массив;
	
	ВыборкаXPath = ВыполнитьЗапросXPathКПравиламИмпорта("//ПравилаИмпорта/ГруппаПравил");
	Пока 1 = 1 Цикл
		ЭлементDOM = ВыборкаXPath.ПолучитьСледующий();
		Если ЭлементDOM = Неопределено Тогда
			Прервать
		КонецЕсли;
		
		ИмяГруппыПравил = ЭлементDOM.ПолучитьАтрибут("Имя");
		Если ПустаяСтрока(ИмяГруппыПравил) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указано имя группы правил в секции '//ПравилаИмпорта/ГруппаПравил'");
			Продолжить;
		КонецЕсли;
		
		ГруппыПравил.Добавить(ИмяГруппыПравил);
	КонецЦикла;
	
	Возврат ГруппыПравил;

КонецФункции // ПолучитьГруппыПравил

Функция ПолучитьГруппыИмпортируемыхОбъектов(ИмяГруппыПравил, ТолькоПриНаличииВыбора = Истина) Экспорт
	
	ГруппыОбъектов = Новый СписокЗначений;
		
	ВыборкаXPath = ВыполнитьЗапросXPathКПравиламИмпорта("//ПравилаИмпорта/ГруппаПравил[@Имя=""" + ИмяГруппыПравил + """]/ПравилоИмпорта");
	Пока 1 = 1 Цикл
		ЭлементDOM = ВыборкаXPath.ПолучитьСледующий();
		Если ЭлементDOM = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		ИмяГруппыОбъектов = ЭлементDOM.ПолучитьАтрибут("ГруппаОбъектов");
		Если ПустаяСтрока(ИмяГруппыОбъектов) Тогда
			Сообщить("Не указана группа объектов в секции 'ПравилоИмпорта'.");
			Продолжить;
		КонецЕсли;
		
		ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.ПолучитьГруппуОбъекта(ИмяГруппыОбъектов);
		Если Не ЗначениеЗаполнено(ГруппаОбъектов) Тогда
			Сообщить("Не удалось получить группу импортируемых объектов по имени «" + ИмяГруппыОбъектов + "»");
			Продолжить;
		КонецЕсли;
		
		Если ТолькоПриНаличииВыбора Тогда
			ВыборкаXPath1 = ВыполнитьЗапросXPathКПравиламИмпорта("//ПравилаИмпорта/ГруппаПравил[@Имя=""" + ИмяГруппыПравил + """]/ПравилоИмпорта[@ГруппаОбъектов=""" + ИмяГруппыОбъектов + """]/Выбор");
			Если ВыборкаXPath1.ПолучитьСледующий() = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ГруппыОбъектов.Добавить(ГруппаОбъектов);
	КонецЦикла;
	
	Возврат ГруппыОбъектов;
	
КонецФункции // ПолучитьГруппыИмпортируемыхОбъектов

Функция ПолучитьСтрокуСоединенияССерверомДанных(ИмяГруппыПравил)
	
	СтрокаСоединений = "";
	
	ВыборкаXPath = ВыполнитьЗапросXPathКПравиламИмпорта("//ПравилаИмпорта/ГруппаПравил[@Имя=""" + ИмяГруппыПравил + """]");
	Пока 1 = 1 Цикл
		ЭлементDOM = ВыборкаXPath.ПолучитьСледующий();
		Если ЭлементDOM <> Неопределено Тогда
			СтрокаСоединений = ЭлементDOM.ПолучитьАтрибут("ИсточникДанных");
		КонецЕсли;

		Прервать;
	КонецЦикла;
	
	Возврат СтрокаСоединений;
	
КонецФункции // ПолучитьСтрокуСоединенияССерверомДанных

Функция ПолучитьВнешнююСистему(ИмяГруппыПравил)
	
	ВнешняяСистема = Неопределено;
	
	ВыборкаXPath = ВыполнитьЗапросXPathКПравиламИмпорта("//ПравилаИмпорта/ГруппаПравил[@Имя=""" + ИмяГруппыПравил + """]");
	Пока 1 = 1 Цикл
		ЭлементDOM = ВыборкаXPath.ПолучитьСледующий();
		Если ЭлементDOM <> Неопределено Тогда
			Попытка
				ВнешняяСистема = Справочники.ВнешниеСистемы[ЭлементDOM.ПолучитьАтрибут("ВнешняяСистема")];
			Исключение
			КонецПопытки;
		КонецЕсли;

		Прервать;
	КонецЦикла;
	
	Возврат ВнешняяСистема;
		
КонецФункции // ПолучитьВнешнююСистему

Функция ПолучитьПоляДляПоискаПоСтроке(ЭлементDOM = Неопределено, ИмяГруппыПравил = "", ИмяГруппыОбъектов = "") Экспорт
	
	// получим поля для поиска по строке
	Если ЭлементDOM = Неопределено Тогда
		ВыборкаXPath = ВыполнитьЗапросXPathКПравиламИмпорта("//ПравилаИмпорта/ГруппаПравил[@Имя=""" + ИмяГруппыПравил + """]/ПравилоИмпорта[@ГруппаОбъектов=""" + ИмяГруппыОбъектов + """]/Выбор/ПоляДляПоискаПоСтроке");
		ЭлементDOM   = ВыборкаXPath.ПолучитьСледующий();
		Если ЭлементDOM = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;	
		
	ПоляДляПоискаПоСтроке = Новый СписокЗначений;
		
	Для каждого ПодчЭлементDOM Из ЭлементDOM.ДочерниеУзлы Цикл
		Если ПодчЭлементDOM.ТипУзла = ТипУзлаDOM.Элемент И ВРег(ПодчЭлементDOM.ИмяУзла) = ВРег("ПолеДляПоискаПоСтроке") Тогда
			Попытка
				ПоляДляПоискаПоСтроке.Добавить(
					ПодчЭлементDOM.Атрибуты.ПолучитьИменованныйЭлемент("ШаблонПоиска").Значение,
					ПодчЭлементDOM.Атрибуты.ПолучитьИменованныйЭлемент("ИмяПоля").Значение);
			Исключение
			КонецПопытки;	
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПоляДляПоискаПоСтроке
	
КонецФункции // ПолучитьПоляДляПоискаПоСтроке

Функция ПолучитьЗапросДляВыбораДанных(ИмяГруппыПравил, ГруппыОбъектов, ОграничениеКоличестваЗаписей = 0, СтрокаПоиска = "")
	ТекстЗапроса          = Неопределено;
	ПоляДляПоискаПоСтроке = Неопределено;
	
	ВыборкаXPath = ВыполнитьЗапросXPathКПравиламИмпорта("//ПравилаИмпорта/ГруппаПравил[@Имя=""" + ИмяГруппыПравил
		+ """]/ПравилоИмпорта[@ГруппаОбъектов=""" + ПолучитьИмяГруппыОбъектов(ГруппаОбъектов) + """]/Выбор");
	Пока Истина Цикл
		ЭлементDOM = ВыборкаXPath.ПолучитьСледующий();
		Если ЭлементDOM = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		// Среди подчиненных узлов должны быть <ТекстЗапроса> и <ПоляДляПоискаПоСтроке> или просто лежит текст запроса
		Для Каждого ПодчЭлементDOM Из ЭлементDOM.ДочерниеУзлы Цикл
			Если      ПодчЭлементDOM.ТипУзла = ТипУзлаDOM.Текст Тогда
				ТекстЗапроса = СокрЛП(ПодчЭлементDOM.ЗначениеУзла);
				Прервать
			ИначеЕсли ПодчЭлементDOM.ТипУзла = ТипУзлаDOM.Элемент Тогда
				Если      ВРег(ПодчЭлементDOM.ИмяУзла) = ВРег("ТекстЗапроса") Тогда
					ТекстЗапроса = ПолучитьТекстЭлементаDOM(ПодчЭлементDOM);
				ИначеЕсли ВРег(ПодчЭлементDOM.ИмяУзла) = ВРег("ПоляДляПоискаПоСтроке") Тогда
					ПоляДляПоискаПоСтроке = ПолучитьПоляДляПоискаПоСтроке(ПодчЭлементDOM);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Учтём ограничение на кол-во отображаемых записей
	Если (ОграничениеКоличестваЗаписей > 0) И (ВРег(Лев(ТекстЗапроса, 6)) = "SELECT") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "SELECT", "SELECT TOP " + Формат(ОграничениеКоличестваЗаписей, "ЧГ=0"));
	КонецЕсли;
	
	// Дополним запрос данными для поиска
	Если Не ПустаяСтрока(СтрокаПоиска) И ЗначениеЗаполнено(ПоляДляПоискаПоСтроке) Тогда
		УсловиеДляПоиска = "";
		ЭкранированнаяСтрокаПоиска = СтрЗаменить(СтрокаПоиска, "'", "''");
		Для Каждого ЭлементСписка Из ПоляДляПоискаПоСтроке Цикл
			УсловиеДляПоиска = УсловиеДляПоиска + ?(ПустаяСтрока(УсловиеДляПоиска), "", " OR ") + СтрЗаменить(ЭлементСписка.Значение, "&СтрокаПоиска", ЭкранированнаяСтрокаПоиска);
		КонецЦикла;
		
		ВТекстЗапроса       = ВРег(ТекстЗапроса);
		ВЗапросеЕстьУсловие = (Найти(ВТекстЗапроса, Символы.ПС + "WHERE") > 0 Или Найти(ВТекстЗапроса, Символы.Таб + "WHERE") > 0 Или Найти(ВТекстЗапроса, " WHERE") > 0);
		
		Если ВЗапросеЕстьУсловие Тогда
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + Символы.Таб + "AND (" + УсловиеДляПоиска + ")";
		Иначе
			ТекстЗапроса = ТекстЗапроса + УсловиеДляПоиска;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТекстЗапроса;
КонецФункции // ПолучитьЗапросДляВыбораДанных

Функция ПолучитьПравилаИмпорта(ИмяГруппыПравил, ГруппаОбъектов, ИдентификаторыВыбранныхОбъектов = "")

	ПравилаИмпорта = Новый Массив();
	
	ВыборкаXPath = ВыполнитьЗапросXPathКПравиламИмпорта("//ПравилаИмпорта/ГруппаПравил[@Имя=""" + ИмяГруппыПравил + """]/ПравилоИмпорта[@ГруппаОбъектов=""" + ПолучитьИмяГруппыОбъектов(ГруппаОбъектов) + """]/Импорт");
	Пока 1 = 1 Цикл
		ЭлементDOM = ВыборкаXPath.ПолучитьСледующий();
		Если ЭлементDOM = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Для каждого ДочернийУзелDOM Из ЭлементDOM.ДочерниеУзлы Цикл
			ТекстЗапроса      	= "";
			ТипИдентификатора	= "";
			
			Если ДочернийУзелDOM.ЕстьДочерниеУзлы() Тогда
				ТипИдентификатора = ВРег(СокрЛП(?(ДочернийУзелDOM.ПолучитьАтрибут("ТипИдентификатора") = Неопределено, "Число", "Строка")));
				
				Если ДочернийУзелDOM.ПервыйДочерний.ТипУзла = ТипУзлаDOM.Текст Тогда
					ИдентификаторыВыбранныхОбъектовСтрокой = "";
					Для каждого ИдентификаторВыбранногоОбъекта Из ИдентификаторыВыбранныхОбъектов Цикл
						ИдентификаторыВыбранныхОбъектовСтрокой = ИдентификаторыВыбранныхОбъектовСтрокой + ?(ПустаяСтрока(ИдентификаторыВыбранныхОбъектовСтрокой), "", ", ")
							+ ?(ТипИдентификатора = "СТРОКА", "'", "") + ИдентификаторВыбранногоОбъекта + ?(ТипИдентификатора = "СТРОКА", "'", "");
					КонецЦикла;
					
					ТекстЗапроса = СокрЛП(ДочернийУзелDOM.ПервыйДочерний.ЗначениеУзла);
					ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИдентификаторыВыбранныхОбъектов", ИдентификаторыВыбранныхОбъектовСтрокой);
				КонецЕсли;
			КонецЕсли;
			
			ПравилоИмпорта = Новый Структура("ПриемникДанных, Режим, ПодчиненныйСправочник, ПолеВладельца, ТекстЗапроса, ТипИдентификатора",
				ДочернийУзелDOM.ПолучитьАтрибут("Приемник"),
				?(ПустаяСтрока(ДочернийУзелDOM.ПолучитьАтрибут("Режим")), "", ДочернийУзелDOM.ПолучитьАтрибут("Режим")),
				?(ВРег(ДочернийУзелDOM.ПолучитьАтрибут("ПодчиненныйСправочник")) = "ДА", Истина, Ложь),
				?(ПустаяСтрока(ДочернийУзелDOM.ПолучитьАтрибут("ПолеВладельца")), "Владелец", ДочернийУзелDOM.ПолучитьАтрибут("ПолеВладельца")),
				ТекстЗапроса,
				ТипИдентификатора);
				
			Если ПравилоИмпорта.Режим = "ВызовФункции" Тогда
				ПравилоИмпорта.Вставить("ИмяФункции", ДочернийУзелDOM.ПолучитьАтрибут("ИмяФункции"));	
			КонецЕсли;
				
			ПравилаИмпорта.Добавить(ПравилоИмпорта);
		КонецЦикла;
	КонецЦикла;

	Возврат ПравилаИмпорта;

КонецФункции // ПолучитьПравилаИмпорта

