Процедура ПодготовитьОблигации(ВнешниеДанные, ДанныеДляЗагрузки)
	
	СкорректироватьДатуПогашенияПропертизФинанс(ВнешниеДанные, ДанныеДляЗагрузки);	
	
	// #359993: из Матрикса должна приходить базовая ставка, но пока не приходит
	
	Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Сбербанк_002P"); // Сбербанк ПАО, 4-02-01481-B-002P, 10000000.00 RUB
	Если Облигация = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	СтрокаДанныеДляЗагрузки = ДанныеДляЗагрузки.Найти(Облигация, "Объект");
	Если СтрокаДанныеДляЗагрузки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеСтроки = ВнешниеДанные.НайтиСтроки(Новый Структура("Идентификатор", СтрокаДанныеДляЗагрузки.Идентификатор));
	
	Для Каждого СтрокаОблигации Из НайденныеСтроки Цикл
		Если СтрокаОблигации.БазоваяСтавка = Справочники.БазовыеСтавкиОблигаций.ПустаяСсылка() Тогда
			СтрокаОблигации.БазоваяСтавка = Справочники.БазовыеСтавкиОблигаций.НайтиПоНаименованию("GCurve (OFZ)", Истина);	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПодготовитьРасчетныеЦеныПаев(ВнешниеДанные)
	
	// Включаем привелегированный режим, т.к. будем выбирать данные по организациям,
	// которые пользователю могут быть недоступны.
	УстановитьПривилегированныйРежим(Истина);
	
	// Колонки передаваемой в запрос ТЗ должны быть строго типизированы,
	// поэтому придется создать такую ТЗ и заполнить ее из внешних данных.
	ТЗ = Новый ТаблицаЗначений;
	
	ТЗ.Колонки.Добавить("Период",			Новый ОписаниеТипов("Дата"));
	ТЗ.Колонки.Добавить("ЦеннаяБумага",		Новый ОписаниеТипов("СправочникСсылка.Паи"));
	ТЗ.Колонки.Добавить("РасчетнаяЦена",	Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("КоличествоПаев",	Новый ОписаниеТипов("Число"));
	
	РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ВнешниеДанные, ТЗ);
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Паи",			ИмпортируемыеОбъекты.ВыгрузитьКолонку("Объект"));
	Запрос.УстановитьПараметр("ВнешниеДанные",	ТЗ);
	
	// Запрос получает данные регистра "РасчетныеЦеныПаев" по импортируемым паям за периоды нахождения под нашим ДУ,
	// из внешних данных исключает сведения за периоды нахождения ПИФа под нашим ДУ,
	// в качестве результата вернет объединение этих двух множеств.
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Организации.ЮрФизЛицо КАК ЮрЛицоОрганизации
		|ПОМЕСТИТЬ _ЮрЛицаОрганизаций
		|ИЗ
		|	Справочник.Организации КАК Организации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Паи.ПаевойИнвестиционныйФонд КАК ПИФ,
		|	Паи.Ссылка КАК Пай
		|ПОМЕСТИТЬ _Паи
		|ИЗ
		|	Справочник.Паи КАК Паи
		|ГДЕ
		|	Паи.Ссылка В(&Паи)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК ПИФ,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.Организация.ЮрФизЛицо КАК ЮрЛицоОрганизации
		|ПОМЕСТИТЬ _ИсключаемыеИзПериодовНашегоДУСДУ
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО (ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Объект КАК Справочник.СчетаДоверительногоУправления).Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления)
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Свойство.Ключ = ""УчетНеВедется""
		|	И ЗначенияДополнительныхСведений.Значение = ИСТИНА
		|	И ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Объект КАК Справочник.СчетаДоверительногоУправления).ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
		|	И КлиентыДоверительногоУправленияСрезПоследних.Клиент В
		|			(ВЫБРАТЬ
		|				_Паи.ПИФ КАК ПИФ
		|			ИЗ
		|				_Паи КАК _Паи)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Паи.ПИФ КАК ПИФ,
		|	_Паи.Пай КАК Пай,
		|	РеквизитыПИФ.Период КАК Период,
		|	РеквизитыПИФ.УправляющаяКомпания.ЮрФизЛицо КАК ЮрЛицоУК
		|ПОМЕСТИТЬ _УКПоПаям
		|ИЗ
		|	РегистрСведений.РеквизитыПИФ КАК РеквизитыПИФ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Паи КАК _Паи
		|		ПО РеквизитыПИФ.ПаевойИнвестиционныйФонд = _Паи.ПИФ
		|ГДЕ
		|	РеквизитыПИФ.ПаевойИнвестиционныйФонд В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				_Паи.ПИФ КАК ПИФ
		|			ИЗ
		|				_Паи КАК _Паи)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_УКПоПаям.Пай КАК Пай,
		|	_УКПоПаям.Период КАК Период,
		|	_УКПоПаям.ЮрЛицоУК КАК ЮрЛицоУК
		|ПОМЕСТИТЬ _НачалоНашегоДУ
		|ИЗ
		|	_УКПоПаям КАК _УКПоПаям
		|ГДЕ
		|	_УКПоПаям.ЮрЛицоУК В
		|			(ВЫБРАТЬ
		|				_ЮрЛицаОрганизаций.ЮрЛицоОрганизации КАК ЮрЛицоОрганизации
		|			ИЗ
		|				_ЮрЛицаОрганизаций КАК _ЮрЛицаОрганизаций)
		|	И НЕ (_УКПоПаям.ПИФ, _УКПоПаям.ЮрЛицоУК) В
		|				(ВЫБРАТЬ
		|					_ИсключаемыеИзПериодовНашегоДУСДУ.ПИФ КАК ПИФ,
		|					_ИсключаемыеИзПериодовНашегоДУСДУ.ЮрЛицоОрганизации КАК ЮрЛицоОрганизации
		|				ИЗ
		|					_ИсключаемыеИзПериодовНашегоДУСДУ КАК _ИсключаемыеИзПериодовНашегоДУСДУ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_УКПоПаям.Пай КАК Пай,
		|	_УКПоПаям.Период КАК Период,
		|	_УКПоПаям.ЮрЛицоУК КАК ЮрЛицоУК
		|ПОМЕСТИТЬ _НачалоНеНашегоДУ
		|ИЗ
		|	_УКПоПаям КАК _УКПоПаям
		|ГДЕ
		|	(НЕ _УКПоПаям.ЮрЛицоУК В
		|					(ВЫБРАТЬ
		|						_ЮрЛицаОрганизаций.ЮрЛицоОрганизации КАК ЮрЛицоОрганизации
		|					ИЗ
		|						_ЮрЛицаОрганизаций КАК _ЮрЛицаОрганизаций)
		|			ИЛИ (_УКПоПаям.ПИФ, _УКПоПаям.ЮрЛицоУК) В
		|				(ВЫБРАТЬ
		|					_ИсключаемыеИзПериодовНашегоДУСДУ.ПИФ КАК ПИФ,
		|					_ИсключаемыеИзПериодовНашегоДУСДУ.ЮрЛицоОрганизации КАК ЮрЛицоОрганизации
		|				ИЗ
		|					_ИсключаемыеИзПериодовНашегоДУСДУ КАК _ИсключаемыеИзПериодовНашегоДУСДУ))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НачалоНашегоДУ.Пай КАК Пай,
		|	_НачалоНашегоДУ.Период КАК Начало,
		|	МИНИМУМ(ЕСТЬNULL(_НачалоНеНашегоДУ.Период, НЕОПРЕДЕЛЕНО)) КАК Окончание
		|ПОМЕСТИТЬ _ПериодыНашегоДУ
		|ИЗ
		|	_НачалоНашегоДУ КАК _НачалоНашегоДУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НачалоНеНашегоДУ КАК _НачалоНеНашегоДУ
		|		ПО _НачалоНашегоДУ.Пай = _НачалоНеНашегоДУ.Пай
		|			И _НачалоНашегоДУ.Период < _НачалоНеНашегоДУ.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	_НачалоНашегоДУ.Пай,
		|	_НачалоНашегоДУ.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	РасчетныеЦеныПаев.Период КАК Период,
		|	РасчетныеЦеныПаев.ЦеннаяБумага КАК ЦеннаяБумага,
		|	РасчетныеЦеныПаев.РасчетнаяЦена КАК РасчетнаяЦена,
		|	РасчетныеЦеныПаев.КоличествоПаев КАК КоличествоПаев
		|ПОМЕСТИТЬ _ДанныеРегистра
		|ИЗ
		|	РегистрСведений.РасчетныеЦеныПаев КАК РасчетныеЦеныПаев
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПериодыНашегоДУ КАК _ПериодыНашегоДУ
		|		ПО (ВЫРАЗИТЬ(РасчетныеЦеныПаев.ЦеннаяБумага КАК Справочник.Паи).Ссылка = _ПериодыНашегоДУ.Пай)
		|			И РасчетныеЦеныПаев.Период >= _ПериодыНашегоДУ.Начало
		|			И (ВЫБОР
		|				КОГДА _ПериодыНашегоДУ.Окончание = НЕОПРЕДЕЛЕНО
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ РасчетныеЦеныПаев.Период < _ПериодыНашегоДУ.Окончание
		|			КОНЕЦ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ВнешниеДанные.Период КАК ДАТА) КАК Период,
		|	ВЫРАЗИТЬ(ВнешниеДанные.ЦеннаяБумага КАК Справочник.Паи) КАК ЦеннаяБумага,
		|	ВЫРАЗИТЬ(ВнешниеДанные.РасчетнаяЦена КАК ЧИСЛО) КАК РасчетнаяЦена,
		|	ВЫРАЗИТЬ(ВнешниеДанные.КоличествоПаев КАК ЧИСЛО) КАК КоличествоПаев
		|ПОМЕСТИТЬ _ВнешниеДанные
		|ИЗ
		|	&ВнешниеДанные КАК ВнешниеДанные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВнешниеДанные.Период КАК Период,
		|	_ВнешниеДанные.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ВнешниеДанные.РасчетнаяЦена КАК РасчетнаяЦена,
		|	_ВнешниеДанные.КоличествоПаев КАК КоличествоПаев,
		|	СУММА(ВЫБОР
		|			КОГДА _ПериодыНашегоДУ.Пай ЕСТЬ NULL
		|				ТОГДА 0
		|			ИНАЧЕ 1
		|		КОНЕЦ) КАК ПопаданиеВПериодДУ
		|ПОМЕСТИТЬ _ВнешниеДанныеСКоличествомПопаданийВПериодыДУ
		|ИЗ
		|	_ВнешниеДанные КАК _ВнешниеДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПериодыНашегоДУ КАК _ПериодыНашегоДУ
		|		ПО _ВнешниеДанные.ЦеннаяБумага = _ПериодыНашегоДУ.Пай
		|			И _ВнешниеДанные.Период >= _ПериодыНашегоДУ.Начало
		|			И (ВЫБОР
		|				КОГДА _ПериодыНашегоДУ.Окончание = НЕОПРЕДЕЛЕНО
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ _ВнешниеДанные.Период < _ПериодыНашегоДУ.Окончание
		|			КОНЕЦ)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВнешниеДанные.Период,
		|	_ВнешниеДанные.ЦеннаяБумага,
		|	_ВнешниеДанные.РасчетнаяЦена,
		|	_ВнешниеДанные.КоличествоПаев
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВнешниеДанныеСКоличествомПопаданийВПериодыДУ.Период КАК Период,
		|	_ВнешниеДанныеСКоличествомПопаданийВПериодыДУ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ВнешниеДанныеСКоличествомПопаданийВПериодыДУ.РасчетнаяЦена КАК РасчетнаяЦена,
		|	_ВнешниеДанныеСКоличествомПопаданийВПериодыДУ.КоличествоПаев КАК КоличествоПаев
		|ПОМЕСТИТЬ _ВнешниеДанныеКЗагрузке
		|ИЗ
		|	_ВнешниеДанныеСКоличествомПопаданийВПериодыДУ КАК _ВнешниеДанныеСКоличествомПопаданийВПериодыДУ
		|ГДЕ
		|	_ВнешниеДанныеСКоличествомПопаданийВПериодыДУ.ПопаданиеВПериодДУ = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВнешниеДанныеКЗагрузке.Период КАК Период,
		|	_ВнешниеДанныеКЗагрузке.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ВнешниеДанныеКЗагрузке.РасчетнаяЦена КАК РасчетнаяЦена,
		|	_ВнешниеДанныеКЗагрузке.КоличествоПаев КАК КоличествоПаев
		|ИЗ
		|	_ВнешниеДанныеКЗагрузке КАК _ВнешниеДанныеКЗагрузке
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ДанныеРегистра.Период,
		|	_ДанныеРегистра.ЦеннаяБумага,
		|	_ДанныеРегистра.РасчетнаяЦена,
		|	_ДанныеРегистра.КоличествоПаев
		|ИЗ
		|	_ДанныеРегистра КАК _ДанныеРегистра
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЦеннаяБумага,
		|	Период";
	#КонецОбласти
	
	ВнешниеДанные = Запрос.Выполнить().Выгрузить();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ПодготовитьСвязанныеЮридическиеЛицаКЗаписи(СвязанныеЮридическиеЛица)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Период",						Новый ОписаниеТипов("Дата",,,Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	Результат.Колонки.Добавить("ЮридическоеЛицо",				Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	Результат.Колонки.Добавить("РодительскоеЮридическоеЛицо",	Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	Результат.Колонки.Добавить("ТипСвязи",						Новый ОписаниеТипов("СправочникСсылка.ТипыСвязейЮрФизЛиц"));
	Результат.Колонки.Добавить("Действует",						Новый ОписаниеТипов("Булево"));
	
	Для Каждого ТекСтрока Из СвязанныеЮридическиеЛица Цикл
		
		НоваяСтрока = Результат.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		
		НоваяСтрока.Период		= ТекСтрока.НачалоПериода;
		НоваяСтрока.Действует	= Истина;
		
		Если ЗначениеЗаполнено(ТекСтрока.КонецПериода) Тогда
			
			НоваяСтрока = Результат.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			
			НоваяСтрока.Период		= ТекСтрока.КонецПериода;
			НоваяСтрока.Действует	= Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ПодготовитьКупонныйДоходПоОблигациям(КупонныйДоходПоОблигациям, Ошибки)
	
	СкорректироватьКупонныйДоход_АрчерФинанс(КупонныйДоходПоОблигациям);
	
	СкорректироватьКупонныйДоход_Пересвет(КупонныйДоходПоОблигациям);
	
	ЗаполнитьФормулыРасчетаПлавающихСтавок(КупонныйДоходПоОблигациям, Ошибки);	
	
КонецПроцедуры

Процедура СкорректироватьКупонныйДоход_АрчерФинанс(КупонныйДоходПоОблигациям)
	
	// По облигации Арчер Финанс ММВБ предоставляет неверные данные по 8му купонному периоду.
	// Установим их вручную.
	
	АрчерФинанс = Общегоназначения.ПолучитьИменованныйОбъект("Облигация_АрчерФинанс");
	Если АрчерФинанс = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	НайдСтроки = КупонныйДоходПоОблигациям.НайтиСтроки(Новый Структура("Облигация", АрчерФинанс));
	Если НайдСтроки.Количество() = 0 Тогда
		// В наборе этой облигации нет, поэтому ничего не делаем
		Возврат;
	КонецЕсли;
	
	НайдСтроки = КупонныйДоходПоОблигациям.НайтиСтроки(Новый Структура("Облигация, Период", АрчерФинанс, '20171003'));
	Если НайдСтроки.Количество() <> 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Во внешней системе изменились данные по купонному периоду облигации Арчер-Финанс! Необходимо проверить результат импорта!");
	Иначе
		ИзменяемаяСтрока = НайдСтроки[0];
		ИзменяемаяСтрока.ДатаОкончанияКупона 	= '20180403';
		ИзменяемаяСтрока.ДатаФиксации 			= '20180402';
		ИзменяемаяСтрока.ДатаВыплатыПлан 		= '20180518';
		ИзменяемаяСтрока.Срок 					= 182;
		ИзменяемаяСтрока.СуммаКупона 			= 0.01;
		ИзменяемаяСтрока.СтавкаКупона			= 0;		
	КонецЕсли;
	
	НайдСтроки = КупонныйДоходПоОблигациям.НайтиСтроки(Новый Структура("Облигация, Период", АрчерФинанс, '20180531'));
	Если НайдСтроки.Количество() <> 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Во внешней системе изменились данные по купонному периоду облигации Арчер-Финанс! Необходимо проверить результат импорта!");
	Иначе
		ИзменяемаяСтрока = НайдСтроки[0];
		ИзменяемаяСтрока.Период					= '20180403';
		ИзменяемаяСтрока.Срок 					= 3276;
		ИзменяемаяСтрока.СуммаКупона 			= 996.85;
	КонецЕсли;
	
КонецПроцедуры

Процедура СкорректироватьКупонныйДоход_Пересвет(КупонныйДоходПоОблигациям)
	
	// По облигации Пересвет НРД предоставляет неверные по началу купонного периода
	// Установим дату начала вручную.
	
	Пересвет = Общегоназначения.ПолучитьИменованныйОбъект("Облигация_Пересвет");
