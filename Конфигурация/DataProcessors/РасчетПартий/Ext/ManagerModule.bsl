Функция ОпределитьСуммуСписанияТелаПриАмортизации(Облигация, Период, ДатаПокупки, ЦенаПокупки, ДисконтПремияНачисленный, НастройкиУчета) Экспорт
	
	ТаблицаАмортизаций = Новый ТаблицаЗначений;
	
	ТаблицаАмортизаций.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ТаблицаАмортизаций.Колонки.Добавить("Поток", Новый ОписаниеТипов("Число"));
	
	ЗапросАмортизации = Новый Запрос;
	ЗапросАмортизации.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НоминалыЦенныхБумаг.Период КАК Дата,
	|	НоминалыЦенныхБумаг.СуммаИзменения КАК Поток,
	|	НоминалыЦенныхБумаг.Номинал КАК Номинал
	|ИЗ
	|	РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
	|ГДЕ
	|	НоминалыЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	
	ЗапросАмортизации.УстановитьПараметр("ЦеннаяБумага", Облигация);
	
	ТекущийНоминал = 0;
	
	ВыборкаДетальныеЗаписи = ЗапросАмортизации.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.Дата <= НачалоДня(ДатаПокупки) Тогда
			
			ТекущийНоминал = ВыборкаДетальныеЗаписи.Номинал;
			
		Иначе
			
			НоваяСтрока = ТаблицаАмортизаций.Добавить();
			НоваяСтрока.Дата = ВыборкаДетальныеЗаписи.Дата;
			НоваяСтрока.Поток = ВыборкаДетальныеЗаписи.Поток;
			
			ТекущийНоминал = ТекущийНоминал - ВыборкаДетальныеЗаписи.Поток;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТекущийНоминал <> 0 Тогда // нет последнего (окончательного) погашения
		
		НоваяСтрока = ТаблицаАмортизаций.Добавить();
		НоваяСтрока.Дата = Облигация.ДатаПогашения;
		НоваяСтрока.Поток = ТекущийНоминал;
		
	КонецЕсли;
	
	Если НастройкиУчета.ВариантУчетаДисконтаПремии = Перечисления.ВариантыУчетаПроцентныхДоходов.ЛинейныйМетодСАмортизациейПремии						// по-сберовски
		ИЛИ НастройкиУчета.ВариантУчетаДисконтаПремии = Перечисления.ВариантыУчетаПроцентныхДоходов.ЛинейныйМетодСАмортизациейДисконта 					// по-траснефтёвски
		ИЛИ НастройкиУчета.ВариантУчетаДисконтаПремии = Перечисления.ВариантыУчетаПроцентныхДоходов.ЛинейныйМетодСАмортизациейДисконтаОтНационального	// по-татарски
	Тогда
	
		ИтогПотоков = ТаблицаАмортизаций.Итог("Поток");
		
		Для каждого СтрокаТаблицаАмортизаций Из ТаблицаАмортизаций Цикл
			
			Если СтрокаТаблицаАмортизаций.Дата = НачалоДня(Период) Тогда
				
				Возврат ЦенаПокупки / ИтогПотоков * СтрокаТаблицаАмортизаций.Поток;
				
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли НастройкиУчета.ВариантУчетаДисконтаПремии = Перечисления.ВариантыУчетаПроцентныхДоходов.ЛинейныйМетодСЕжедневнойПроцентнойСтавкой Тогда // по-ппашному
		
		ТаблицаАмортизаций.Колонки.Добавить("ТекущийНоминал", Новый ОписаниеТипов("Число"));
		ТаблицаАмортизаций.Колонки.Добавить("Номиналодней", Новый ОписаниеТипов("Число"));
		ТаблицаАмортизаций.Колонки.Добавить("РазностьДат", Новый ОписаниеТипов("Число"));
		
		СуммаНоминалодней = 0;
		НоминалПриПокупке = ТаблицаАмортизаций.Итог("Поток");
		ТекущаяДата = ДатаПокупки;
		ТекущийНоминал = НоминалПриПокупке;
		
		Для каждого СтрокаТаблицаАмортизаций Из ТаблицаАмортизаций Цикл
			
			СтрокаТаблицаАмортизаций.ТекущийНоминал = ТекущийНоминал;
			
			СтрокаТаблицаАмортизаций.РазностьДат = (СтрокаТаблицаАмортизаций.Дата - НачалоДня(ТекущаяДата)) / 86400;
			
			СтрокаТаблицаАмортизаций.Номиналодней = СтрокаТаблицаАмортизаций.ТекущийНоминал * СтрокаТаблицаАмортизаций.РазностьДат;
			СуммаНоминалодней = СуммаНоминалодней + СтрокаТаблицаАмортизаций.Номиналодней;
			
			ТекущийНоминал = ТекущийНоминал - СтрокаТаблицаАмортизаций.Поток;
			ТекущаяДата = СтрокаТаблицаАмортизаций.Дата;
		
		КонецЦикла;
		
		НачальныйДисконт = НоминалПриПокупке - ЦенаПокупки;
		ТекущийДисконт = 0;
		ТекущееТело = ЦенаПокупки;
		Для каждого СтрокаТаблицаАмортизаций Из ТаблицаАмортизаций Цикл
			
			ДисконтЗаПериод = СтрокаТаблицаАмортизаций.ТекущийНоминал * СтрокаТаблицаАмортизаций.РазностьДат * НачальныйДисконт / СуммаНоминалодней;
			ТекущийДисконт = ТекущийДисконт + ДисконтЗаПериод;
			
			Если СтрокаТаблицаАмортизаций.Дата < НачалоДня(Период) Тогда // считаем списание дисконта
			
				СписаниеДисконта = ТекущийДисконт * СтрокаТаблицаАмортизаций.Поток / (ТекущийДисконт + ТекущееТело);
				СписаниеТела = СтрокаТаблицаАмортизаций.Поток - СписаниеДисконта;
				
				ТекущийДисконт = ТекущийДисконт - СписаниеДисконта;
				ТекущееТело = ТекущееТело - СписаниеТела;
				
			ИначеЕсли СтрокаТаблицаАмортизаций.Дата = НачалоДня(Период) Тогда
				
				СписаниеДисконта = ТекущийДисконт * СтрокаТаблицаАмортизаций.Поток / (ТекущийДисконт + ТекущееТело);
				СписаниеТела = СтрокаТаблицаАмортизаций.Поток - СписаниеДисконта;
				
				Возврат СписаниеТела;
				
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли НастройкиУчета.ВариантУчетаДисконтаПремии = Перечисления.ВариантыУчетаПроцентныхДоходов.ЛинейныйМетодСПолнымСписаниемПриАмортизаци
		ИЛИ НастройкиУчета.ВариантУчетаДисконтаПремии = Перечисления.ВариантыУчетаПроцентныхДоходов.ЛинейныйМетодСПолнымСписаниемПриАмортизациИПересчетомПриОфертах Тогда // по-атомному
		
		СуммаСписания = 0;
		
		Для каждого СтрокаТаблицаАмортизаций Из ТаблицаАмортизаций Цикл
			
			Если СтрокаТаблицаАмортизаций.Дата = НачалоДня(Период) Тогда
			
				СуммаСписания = СтрокаТаблицаАмортизаций.Поток;
			
			КонецЕсли;
		
		КонецЦикла;
		
		Возврат СуммаСписания - ДисконтПремияНачисленный;
		
	ИначеЕсли НастройкиУчета.ВариантУчетаДисконтаПремии = Перечисления.ВариантыУчетаПроцентныхДоходов.ЛинейныйМетодПлюсМетодикаСафмараДляАмортизационныхОблигаций Тогда // по-сафмарному
		
		// в функции БухгалтерскийУчетЕПС.РассчитатьЕжедневноеПриращениеПоПотокуСафмар детально расписан алгоритм по Сафмару
		
		НоминалПриПокупке = ТаблицаАмортизаций.Итог("Поток");
		
		НачальныйДисконтДляРасчета = НоминалПриПокупке - ЦенаПокупки; 
		
		ТаблицаАмортизаций.Колонки.Добавить("Период", Новый ОписаниеТипов("Число"));
		
		Если ТаблицаАмортизаций.Количество() > 1 Тогда
		
			МинимальнаяТочкаРазрыва = 1;
			Для каждого СтрокаАмортизаций Из ТаблицаАмортизаций Цикл
				СтрокаАмортизаций.Период = ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаАмортизаций.Дата, ДатаПокупки);
				МинимальнаяТочкаРазрыва = Мин(МинимальнаяТочкаРазрыва, 1 / СтрокаАмортизаций.Период);
			КонецЦикла;
			
			МинимумДиапазонаРасчета = 0;
			МаксимумДиапазонаРасчета = МинимальнаяТочкаРазрыва * 0.999;
			
			ЕжедневноеПриращение = БухгалтерскийУчетЕПС.РассчитатьЕжедневноеПриращениеПоПотокуСафмар(ТаблицаАмортизаций, МинимумДиапазонаРасчета, МаксимумДиапазонаРасчета, НачальныйДисконтДляРасчета);
			
		Иначе
		
			СтрокаАмортизаций = ТаблицаАмортизаций[0];
			СтрокаАмортизаций.Период = ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаАмортизаций.Дата, ДатаПокупки);
			ЕжедневноеПриращение = Окр(НачальныйДисконтДляРасчета / СтрокаАмортизаций.Период / (СтрокаАмортизаций.Поток - НачальныйДисконтДляРасчета), 20);
		
		КонецЕсли;
		
		Для каждого СтрокаАмортизаций Из ТаблицаАмортизаций Цикл
		
			Если СтрокаАмортизаций.Дата = НачалоДня(Период) Тогда
			
				Возврат СтрокаАмортизаций.Поток / (1 + СтрокаАмортизаций.Период * ЕжедневноеПриращение);
			
			КонецЕсли;
		
		КонецЦикла;
		
	Иначе // по-нормальному(по-пацански)
		
		Результат = БухгалтерскийУчет.РассчитатьДоходностьИДюрациюПоПотоку(ТаблицаАмортизаций, ДатаПокупки, - ЦенаПокупки);
		ЭСП = Результат.Доходность;
		
		Для каждого СтрокаТаблицаАмортизаций Из ТаблицаАмортизаций Цикл
			
			Если СтрокаТаблицаАмортизаций.Дата = НачалоДня(Период) Тогда
				
				РазностьДат = (НачалоДня(СтрокаТаблицаАмортизаций.Дата) - НачалоДня(ДатаПокупки)) / 86400;
				Возврат СтрокаТаблицаАмортизаций.Поток / Pow(1 + ЭСП / 100, РазностьДат / 365);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции
