#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	КалендарьКотировок 		= Константы.ОсновнойКалендарьКотировок.Получить();
	ПредыдущийДеньКотировок = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьКотировок, ТекущаяДата() - 60 * 60 * 24);
	
	Организация 			= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	ЭтаФорма.ИмяФайла 		= ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(Неопределено, "ВнешниеОбработки._ИмпортПрочихКотировок.КаталогФайловКотировок", Организация);
	ЭтаФорма.Период 		= Новый СтандартныйПериод(НачалоДня(ПредыдущийДеньКотировок), КонецДня(ПредыдущийДеньКотировок));
	
	ОбновитьВидимостьЭлементов(ЭтаФорма);
	ОбновитьИмяФайла(ЭтаФорма);
	
	ЭтоПолноправныйПользователь = РаботаСПользователями.ЭтоПолноправныйПользователь();
	
	Элементы.РежимИмпорта.Видимость = ЭтоПолноправныйПользователь;
	Элементы.ГруппаДополнительныеНастройки.Видимость = ЭтоПолноправныйПользователь; 
	
	Элементы.Дата.ТолькоПросмотр = Не ЭтоПолноправныйПользователь;
	Элементы.ИмяФайла.ТолькоПросмотр = Не ЭтоПолноправныйПользователь;
		
КонецПроцедуры

#КонецОбласти 

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура РежимИмпортаПриИзменении(Элемент)
	
	ОбновитьВидимостьЭлементов(ЭтаФорма);
	ОбновитьИмяФайла(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	ЭтаФорма.Период.ДатаОкончания = КонецДня(ЭтаФорма.Период.ДатаНачала);
	ОбновитьИмяФайла(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ЭтаФорма.РежимИмпорта = 0 Тогда
		ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		ДиалогВыбора.Фильтр = "Таблицы EXCEL (*.xls;*.xlsx)|*.xls;*.xlsx";
	Иначе
		ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ЭтаФорма.ИмяФайла) Тогда
			
		ДиалогВыбора.ПолноеИмяФайла = ЭтаФорма.ИмяФайла;
		
		Файл = Новый Файл(ЭтаФорма.ИмяФайла);
		Если Файл.Существует() Тогда
			Если Файл.ЭтоКаталог() Тогда
				ДиалогВыбора.Каталог = Файл.ПолноеИмя;
			Иначе
			    ДиалогВыбора.Каталог = Файл.Путь;
			КонецЕсли; 
		КонецЕсли; 	
	
	КонецЕсли;
	
	ДиалогВыбора.Показать(Новый ОписаниеОповещения("ИмяФайлаНачалоВыбораЗавершение", ЭтаФорма, Новый Структура("ДиалогВыбора", ДиалогВыбора)));
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоЦеннойБумагеПриИзменении(Элемент)
	
	Если Не ЭтаФорма.ОтборПоЦеннойБумаге Тогда
		ЭтаФорма.ЦеннаяБумага = Неопределено;
	КонецЕсли;
	
	Элементы.ЦеннаяБумага.Видимость = ЭтаФорма.ОтборПоЦеннойБумаге;
	
КонецПроцедуры

#КонецОбласти 

#Область Команды_формы

&НаКлиенте
Процедура КомандаИмпортировать(Команда)
		
	ФайлыДляОбработки = Новый Массив;
	
	Если ЭтаФорма.РежимИмпорта = 0 Тогда
		
		ЗагружаемыйФайл = Новый Файл(ЭтаФорма.ИмяФайла);			
		Если ЗагружаемыйФайл.Существует() Тогда
			ФайлыДляОбработки.Добавить(Новый ДвоичныеДанные(ЭтаФорма.ИмяФайла));
		КонецЕсли;
		
	Иначе
		
		ТекстСообщения = "";
	
		Если Не ОбщегоНазначенияКлиентСервер.ПериодЗаполненКорректно(ЭтаФорма.Период,,, ТекстСообщения) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,, "Период");
			Возврат;
		КонецЕсли;
			
		ЗагружаемаяДата = ЭтаФорма.Период.ДатаНачала;
		КаталогЗагрузки = ЭтаФорма.ИмяФайла + ?(СтрЗаканчиваетсяНа(ЭтаФорма.ИмяФайла, "\"), "", "\");
		
		Пока ЗагружаемаяДата < ЭтаФорма.Период.ДатаОкончания Цикл
			
			ТекущийФайл = КаталогЗагрузки + Формат(ЗагружаемаяДата, "ДФ=ddMMyy") + " NEW.xlsx";
			
			ЗагружаемыйФайл = Новый Файл(ТекущийФайл);			
			Если ЗагружаемыйФайл.Существует() Тогда
				ФайлыДляОбработки.Добавить(Новый ДвоичныеДанные(ТекущийФайл));
			КонецЕсли;
			
			ЗагружаемаяДата = ЗагружаемаяДата + 86400;
			
		КонецЦикла;
		
	КонецЕсли; 
	
	Если ФайлыДляОбработки.Количество() > 0 Тогда
	
		АдресДанных = ПоместитьВоВременноеХранилище(ФайлыДляОбработки, ЭтаФорма.УникальныйИдентификатор);
		КомандаИмпортироватьНаСервере(АдресДанных);
		
	Иначе 
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В заданом каталоге нет файлов с котировками Блумберг (формат 01.2018) за загружаемые даты " + Строка(ЭтаФорма.Период) + "!",,,"ИмяФайла"); 
	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область Служебные_процедуры_и_функции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИмяФайла(ЭтаФорма)

	Файл = Новый Файл(ЭтаФорма.ИмяФайла);
	Если Файл.Существует() И Файл.ЭтоКаталог() Тогда
		Каталог = Файл.ПолноеИмя;
	Иначе
		Каталог = Файл.Путь;
	КонецЕсли; 
	
	Если ЭтаФорма.РежимИмпорта = 0 Тогда
		Если Не СтрЗаканчиваетсяНа(Каталог, "\") Тогда
			Каталог = Каталог + "\";
		КонецЕсли; 
		ЭтаФорма.ИмяФайла = Каталог + Формат(ЭтаФорма.Период.ДатаОкончания, "ДФ=ddMMyy") + " NEW.xlsx";
	Иначе
		ЭтаФорма.ИмяФайла = Каталог;
	КонецЕсли; 
	
КонецПроцедуры
 
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьВидимостьЭлементов(ЭтаФорма)

	ЭтаФорма.Элементы.Дата.Видимость	= ЭтаФорма.РежимИмпорта = 0;
	ЭтаФорма.Элементы.Период.Видимость 	= ЭтаФорма.РежимИмпорта = 1;	

КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаНачалоВыбораЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено Тогда
		
		ПолноеИмяФайла = ДополнительныеПараметры.ДиалогВыбора.ПолноеИмяФайла;
		
		Файл = Новый Файл(ПолноеИмяФайла);
		
		Если Файл.Существует() Тогда
			ЭтаФорма.ИмяФайла = ПолноеИмяФайла;
		Иначе
			ПоказатьПредупреждение(, ?(ЭтаФорма.РежимИмпорта = 0, "Файл", "Каталог") + " не обнаружен");
		КонецЕсли; 
			
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура КомандаИмпортироватьНаСервере(АдресДанных)
	
	НачалоВыполнения = ТекущаяДатаСеанса();
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	ОбъектНаСервере.ИмпортироватьКотировки(, АдресДанных, ЭтаФорма.Период, ЭтаФорма.ИмпортироватьТолькоОтсутствующиеКотировки, ЭтаФорма.ЦеннаяБумага);

	Если Не ЭтаФорма.НеОтправлятьОповещения Тогда
	
		ТекстСообщения = "Импорт котировок Блумберг (формат 01.2018) за " + Строка(Период) + " завершен." + Символы.ПС + 
			"Начало операции: " + НачалоВыполнения + Символы.ПС + 
			"Окончание операции: " + ТекущаяДатаСеанса() + Символы.ПС + 
			"Ответственный: " + ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущийПользователь");
		
		РеквизитыОповещения = Новый Структура("Текст", ТекстСообщения);
		Справочники.Оповещения.СформироватьОповещения("Обработка.ИмпортКотировокБлумберг.КомандаИмпортироватьНаСервере()", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти 




