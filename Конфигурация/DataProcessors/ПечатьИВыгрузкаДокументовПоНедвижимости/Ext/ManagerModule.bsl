Функция ПолучитьДанныеПечатиСчетаФактуры(Запрос, ПараметрыПечати) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СчетФактура.Ссылка КАК Ссылка,
	|	СчетФактура.Контрагент КАК Контрагент,
	|	СчетФактура.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	СчетФактура.Дата КАК Дата,
	|	СчетФактура.Договор КАК Договор,
	|	СчетФактура.НомерСчетаФактуры КАК НомерСчетаФактуры,
	|	"""" КАК НомерИсправления,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаИсправления,
	|	СчетФактура.Организация КАК Организация,
	|	Оплата.ВалютаОплаты КАК Валюта,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаАкта,
	|	"""" КАК НомерАкта,
	|	СчетФактура.Проведен КАК Проведен,
	|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПустаяСсылка) КАК ВидЗадолженностиНачисления,
	|	"""" КАК НомерСчета,
	|	НЕОПРЕДЕЛЕНО КАК СделкаСНедвижимостью
	|ПОМЕСТИТЬ _ДокументыКПечати
	|ИЗ
	|	Документ.СчетФактура КАК СчетФактура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактура.Основания КАК СчетФактураОснования
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Оплата КАК Оплата
	|			ПО СчетФактураОснования.Основание = Оплата.Ссылка
	|		ПО (СчетФактураОснования.Ссылка = СчетФактура.Ссылка)
	|			И (СчетФактураОснования.НомерСтроки = 1)
	|ГДЕ
	|	СчетФактура.Ссылка = &Ссылка
	|	И СчетФактура.ТипСчетаФактуры = ЗНАЧЕНИЕ(Перечисление.ТипыСчетовФактур.Выданный)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НачислениеЗадолженности.Ссылка,
	|	НачислениеЗадолженности.Контрагент,
	|	НачислениеЗадолженности.СчетДоверительногоУправления,
	|	НачислениеЗадолженности.Дата,
	|	НачислениеЗадолженности.Договор,
	|	НачислениеЗадолженности.НомерСчетаФактуры,
	|	"""" КАК НомерИсправления,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаИсправления,
	|	НачислениеЗадолженности.Организация,
	|	НачислениеЗадолженности.Валюта,
	|	ВЫБОР
	|		КОГДА ЗначенияДополнительныхСведенийАкт.Значение ЕСТЬ NULL
	|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
	|		ИНАЧЕ НачислениеЗадолженности.Дата
	|	КОНЕЦ,
	|	ЕСТЬNULL(ЗначенияДополнительныхСведенийАкт.Значение, """"),
	|	НачислениеЗадолженности.Проведен,
	|	НачислениеЗадолженности.ВидЗадолженности,
	|	ЗначенияДополнительныхСведенийСчет.Значение,
	|	НЕОПРЕДЕЛЕНО
	|ИЗ
	|	Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийАкт
	|		ПО НачислениеЗадолженности.Ссылка = ЗначенияДополнительныхСведенийАкт.Объект
	|			И (ЗначенияДополнительныхСведенийАкт.Свойство.Ключ = ""НомерАктаВыданного"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийСчет
	|		ПО НачислениеЗадолженности.Ссылка = ЗначенияДополнительныхСведенийСчет.Объект
	|			И (ЗначенияДополнительныхСведенийСчет.Свойство.Ключ = ""НомерСчетаВыданного"")
	|ГДЕ
	|	НачислениеЗадолженности.Ссылка = &Ссылка
	|	И НачислениеЗадолженности.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоАренде), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоАрендеПеременнаяЧасть))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КорректировкаЗадолженности.Ссылка,
	|	КорректировкаЗадолженности.Контрагент,
	|	КорректировкаЗадолженности.СчетДоверительногоУправления,
	|	НачислениеЗадолженности.Дата,
	|	КорректировкаЗадолженности.Договор,
	|	НачислениеЗадолженности.НомерСчетаФактуры,
	|	КорректировкаЗадолженности.НомерСчетаФактуры КАК НомерИсправления,
	|	КорректировкаЗадолженности.ДатаСчетаФактуры КАК ДатаИсправления,
	|	КорректировкаЗадолженности.Организация,
	|	НачислениеЗадолженности.Валюта,
	|	ВЫБОР
	|		КОГДА ЗначенияДополнительныхСведенийАкт.Значение ЕСТЬ NULL
	|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
	|		ИНАЧЕ НачислениеЗадолженности.Дата
	|	КОНЕЦ,
	|	ЕСТЬNULL(ЗначенияДополнительныхСведенийАкт.Значение, """"),
	|	НачислениеЗадолженности.Проведен,
	|	НачислениеЗадолженности.ВидЗадолженности,
	|	ЗначенияДополнительныхСведенийСчет.Значение,
	|	НЕОПРЕДЕЛЕНО
	|ИЗ
	|	Документ.КорректировкаЗадолженности КАК КорректировкаЗадолженности
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
	|		ПО КорректировкаЗадолженности.ОснованиеДляКорректировки = НачислениеЗадолженности.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийАкт
	|		ПО НачислениеЗадолженности.Ссылка = ЗначенияДополнительныхСведенийАкт.Объект
	|			И (ЗначенияДополнительныхСведенийАкт.Свойство.Ключ = ""НомерАктаВыданного"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийСчет
	|		ПО НачислениеЗадолженности.Ссылка = ЗначенияДополнительныхСведенийСчет.Объект
	|			И (ЗначенияДополнительныхСведенийСчет.Свойство.Ключ = ""НомерСчетаВыданного"")
	|ГДЕ
	|	КорректировкаЗадолженности.Ссылка = &Ссылка
	|	И НачислениеЗадолженности.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоАренде), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоАрендеПеременнаяЧасть))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	АктПриемаПередачиОбъектовНедвижимости.Ссылка,
	|	СделкаСНедвижимостью.Контрагент,
	|	АктПриемаПередачиОбъектовНедвижимости.СчетДоверительногоУправления,
	|	АктПриемаПередачиОбъектовНедвижимости.ДатаСчетаФактуры,
	|	СделкаСНедвижимостью.Договор,
	|	АктПриемаПередачиОбъектовНедвижимости.НомерСчетаФактуры,
	|	"""" КАК НомерИсправления,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаИсправления,
	|	АктПриемаПередачиОбъектовНедвижимости.Организация,
	|	&ВалютаРубль,
	|	АктПриемаПередачиОбъектовНедвижимости.Дата,
	|	""б/н"",
	|	АктПриемаПередачиОбъектовНедвижимости.Проведен,
	|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделкеСНедвижимостью),
	|	"""",
	|	СделкаСНедвижимостью.Ссылка
	|ИЗ
	|	Документ.АктПриемаПередачиОбъектовНедвижимости КАК АктПриемаПередачиОбъектовНедвижимости
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаСНедвижимостью КАК СделкаСНедвижимостью
	|		ПО АктПриемаПередачиОбъектовНедвижимости.Основание = СделкаСНедвижимостью.Ссылка
	|ГДЕ
	|	АктПриемаПередачиОбъектовНедвижимости.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ДокументыКПечати.Дата КАК Дата,
	|	_ДокументыКПечати.Договор КАК Договор,
	|	_ДокументыКПечати.Контрагент КАК Контрагент,
	|	_ДокументыКПечати.НомерСчетаФактуры КАК НомерСчетаФактуры,
	|	_ДокументыКПечати.НомерИсправления КАК НомерИсправления,
	|	_ДокументыКПечати.ДатаИсправления КАК ДатаИсправления,
	|	_ДокументыКПечати.Организация КАК Организация,
	|	_ДокументыКПечати.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	РеквизитыОрганизацииАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеОрганизацииПоУставу,
	|	РеквизитыПИФСрезПоследних.КраткоеНаименованиеФонда КАК КраткоеНаименованиеФонда,
	|	РеквизитыОрганизацииАнкетныеСрезПоследних.ЮридическийАдрес КАК АдресПродавца,
	|	РеквизитыОрганизацииАнкетныеСрезПоследних.ЮридическийАдресФИАС КАК ЮридическийАдресФИАСОрганизации,
	|	РеквизитыОрганизацииАнкетныеСрезПоследних.ИНН КАК ИННОрганизации,
	|	РеквизитыОрганизацииАнкетныеСрезПоследних.КППКрупнейшегоНалогоплательщика КАК КППКрупнейшегоНалогоплательщика,
	|	РеквизитыОрганизацииАнкетныеСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицоОрганизации,
	|	РеквизитыОрганизацииАнкетныеСрезПоследних.СтранаРегистрации.Код КАК КодСтраныОрганизации,
	|	РеквизитыОрганизацииАнкетныеСрезПоследних.СтранаРегистрации.Наименование КАК СтранаОрганизации,
	|	_ДокументыКПечати.Ссылка КАК Ссылка,
	|	РеквизитыПокупателяАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеКонтрагентаПоУставу,
	|	РеквизитыПокупателяАнкетныеСрезПоследних.ЮридическийАдрес КАК ЮридическийАдресКонтрагента,
	|	РеквизитыПокупателяАнкетныеСрезПоследних.ЮридическийАдресФИАС КАК ЮридическийАдресФИАСКонтрагента,
	|	РеквизитыПокупателяАнкетныеСрезПоследних.ИНН + ВЫБОР
	|		КОГДА РеквизитыПокупателяАнкетныеСрезПоследних.КПП = """"
	|			ТОГДА """"
	|		ИНАЧЕ ""/"" + РеквизитыПокупателяАнкетныеСрезПоследних.КПП
	|	КОНЕЦ КАК ИННКПППокупателя,
	|	РеквизитыПокупателяАнкетныеСрезПоследних.ИНН КАК ИННПокупателя,
	|	РеквизитыПокупателяАнкетныеСрезПоследних.КПП КАК КПППокупателя,
	|	РеквизитыПокупателяАнкетныеСрезПоследних.ОГРН КАК ОГРНПокупателя,
	|	РеквизитыПокупателяАнкетныеСрезПоследних.ДатаВыдачиОГРН КАК ДатаОГРНПокупателя,
	|	РеквизитыПокупателяАнкетныеСрезПоследних.СтранаРегистрации.Код КАК КодСтраныПокупателя,
	|	РеквизитыПокупателяАнкетныеСрезПоследних.СтранаРегистрации.Наименование КАК СтранаПокупателя,
	|	_ДокументыКПечати.Валюта.НаименованиеПолное КАК Валюта,
	|	_ДокументыКПечати.Валюта.Код КАК ВалютаКод,
	|	РеквизитыФизическихЛицГлавБух.Фамилия + "" "" + ПОДСТРОКА(РеквизитыФизическихЛицГлавБух.Имя, 1, 1) + "". "" + ПОДСТРОКА(РеквизитыФизическихЛицГлавБух.Отчество, 1, 1) + ""."" КАК ГлавБух,
	|	РеквизитыФизическихЛицГенДир.Фамилия + "" "" + ПОДСТРОКА(РеквизитыФизическихЛицГенДир.Имя, 1, 1) + "". "" + ПОДСТРОКА(РеквизитыФизическихЛицГенДир.Отчество, 1, 1) + ""."" КАК ГенДир,
	|	_ДокументыКПечати.ДатаАкта КАК ДатаАкта,
	|	_ДокументыКПечати.НомерАкта КАК НомерАкта,
	|	_ДокументыКПечати.Проведен КАК Проведен,
	|	_ДокументыКПечати.ВидЗадолженностиНачисления КАК ВидЗадолженностиНачисления,
	|	_ДокументыКПечати.Договор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.Аренды) КАК ЭтоДоговорАренды,
	|	_ДокументыКПечати.Договор.НомерДоговора КАК НомерДоговора,
	|	_ДокументыКПечати.Договор.ДатаЗаключения КАК ДатаДоговора,
	|	СотрудникиОрганизацииГенДир.Должность.Наименование КАК ДолжностьГенДира,
	|	_ДокументыКПечати.НомерСчета КАК НомерСчета,
	|	УсловияДоговоровАрендыСрезПоследних.РасчетныйСчет.НомерСчета КАК РасчетныйСчетНомерСчета,
	|	УсловияДоговоровАрендыСрезПоследних.РасчетныйСчет.Банк.Город КАК БанкГород,
	|	РеквизитыБанкаСрезПоследних.КраткоеНаименованиеПоУставу КАК БанкКраткоеНаименованиеПоУставу,
	|	УсловияДоговоровАрендыСрезПоследних.РасчетныйСчет.Банк.Код КАК БанкБИК,
	|	УсловияДоговоровАрендыСрезПоследних.РасчетныйСчет.Банк.КоррСчет КАК РасчетныйСчетБанкКоррСчет
	|ПОМЕСТИТЬ _ШапкаСчетаФактуры
	|ИЗ
	|	_ДокументыКПечати КАК _ДокументыКПечати
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
	|				&Дата,
	|				Организация = &ОрганизацияДокумента
	|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
	|					И ЮрФизЛицо = ВЫРАЗИТЬ(&ОрганизацияДокумента КАК Справочник.Организации).ЮрФизЛицо) КАК РеквизитыОрганизацииАнкетныеСрезПоследних
	|		ПО _ДокументыКПечати.Организация.ЮрФизЛицо = РеквизитыОрганизацииАнкетныеСрезПоследних.ЮрФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
	|				&Дата,
	|				Организация = &ОрганизацияДокумента
	|					И СчетДоверительногоУправления В
	|						(ВЫБРАТЬ
	|							_ДокументыКПечати.СчетДоверительногоУправления КАК СчетДоверительногоУправления
	|						ИЗ
	|							_ДокументыКПечати КАК _ДокументыКПечати)) КАК КлиентыДоверительногоУправленияСрезПоследних
	|		ПО _ДокументыКПечати.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&Дата, ) КАК РеквизитыПИФСрезПоследних
	|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
	|				&Дата,
	|				Организация = &ОрганизацияДокумента
	|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
	|					И ЮрФизЛицо В
	|						(ВЫБРАТЬ
	|							_ДокументыКПечати.Контрагент КАК Контрагент
	|						ИЗ
	|							_ДокументыКПечати КАК _ДокументыКПечати)) КАК РеквизитыПокупателяАнкетныеСрезПоследних
	|		ПО _ДокументыКПечати.Контрагент = РеквизитыПокупателяАнкетныеСрезПоследних.ЮрФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
	|				&Дата,
	|				Организация = &Организация
	|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
	|					И ЮрФизЛицо В
	|						(ВЫБРАТЬ
