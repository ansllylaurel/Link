Функция ПолучитьТаблицуДанныхССервераSQL(СтрокаСоединения, ТекстЗапроса, ТипыКолонок)
	
	ПараметрыПолученияДанныхАДОБД = Новый Структура(
		"ВозвращатьПустуюТаблицу, Источник",
		Истина,
		ЭтотОбъект.Метаданные().Представление());

	ТаблицаДанных = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса, ТипыКолонок,, ПараметрыПолученияДанныхАДОБД);
	
	Если ПараметрыПолученияДанныхАДОБД.Свойство("Ошибки") Тогда
		Для каждого Ошибка Из ПараметрыПолученияДанныхАДОБД.Ошибки Цикл
			ЗарегистрироватьОшибку(Ошибка);
			Возврат Неопределено;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТаблицаДанных;
	
КонецФункции // ПолучитьТаблицуДанныхССервераSQL

Процедура ДобавитьКодРежимаТорговВТаблицу(Таблица, КодРежимаТоргов)
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Код = КодРежимаТоргов;
	
КонецПроцедуры // ДобавитьКодРежимаТорговВТаблицу

// Установка блокировок регистров котировок для запрета изменений записей, пока не будут сформированы записи в соответствующем сводном регистре
Процедура УстановитьБлокировки()
	БлокировкаДанных = Новый БлокировкаДанных;
	
	// Котировки торговых площадок
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.КотировкиТорговыхПлощадок");
	ЭлементБлокировкиДанных.УстановитьЗначение("Период", Новый Диапазон(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания));
	ЭлементБлокировкиДанных.УстановитьЗначение("Биржа", мБиржаММВБ);
		
	Если ЗначениеЗаполнено(ЭтотОбъект.ЦеннаяБумага) Тогда
		ЭлементБлокировкиДанных.УстановитьЗначение("ЦеннаяБумага", ЭтотОбъект.ЦеннаяБумага);
	КонецЕсли;
	
	// Котировки ценных бумаг
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.КотировкиЦенныхБумаг");
	ЭлементБлокировкиДанных.УстановитьЗначение("Период", Новый Диапазон(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания));
	ЭлементБлокировкиДанных.УстановитьЗначение("Биржа", мБиржаММВБ);
		
	Если ЗначениеЗаполнено(ЭтотОбъект.ЦеннаяБумага) Тогда
		ЭлементБлокировкиДанных.УстановитьЗначение("ЦеннаяБумага", ЭтотОбъект.ЦеннаяБумага);
	КонецЕсли;
	
	БлокировкаДанных.Заблокировать();
КонецПроцедуры

Процедура ПередатьРежимыТорговВЗапрос(Запрос)
	
	// в запросе уже должна быть временная таблица _Котировки
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РежимыБиржевыхТоргов.Ссылка КАК Ссылка,
		|	РежимыБиржевыхТоргов.Код КАК Код,
		|	РежимыБиржевыхТоргов.КотировкиНеНужны КАК КотировкиНеНужны
		|ПОМЕСТИТЬ _РежимыБиржевыхТоргов
		|ИЗ
		|	Справочник.РежимыБиржевыхТоргов КАК РежимыБиржевыхТоргов
		|ГДЕ
		|	РежимыБиржевыхТоргов.Биржа = &Биржа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_Котировки.BOARDID КАК BOARDID,
		|	_Котировки.BOARDNAME КАК BOARDNAME
		|ИЗ
		|	_Котировки КАК _Котировки
		|ГДЕ
		|	НЕ _Котировки.BOARDID В
		|				(ВЫБРАТЬ
		|					_РежимыБиржевыхТоргов.Код
		|				ИЗ
		|					_РежимыБиржевыхТоргов)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		// получим наименования режимов торгов
		НаименованияРежимовТоргов = Новый Соответствие;
		
		Макет = ПолучитьМакет("НаименованияРежимовТоргов");
		Для НомСтр = 2 По Макет.ВысотаТаблицы Цикл	
			НаименованияРежимовТоргов.Вставить(СокрЛП(Макет.Область(НомСтр, 1).Текст), СокрЛП(Макет.Область(НомСтр, 2).Текст));
		КонецЦикла;	
		
		// создадим недостающие режимы торгов
		ТекстСообщения = "";
		
		Выборка = РезультатЗапроса.Выбрать();
		
		УстановитьПривилегированныйРежим(Истина); // т.к. импортировать котировки можно при импорте ц/б, при этом прав на изменение режимов торгов может и не быть
		
		Пока Выборка.Следующий() Цикл
			НовыйРежимТоргов = Справочники.РежимыБиржевыхТоргов.СоздатьЭлемент();
			НовыйРежимТоргов.Биржа 			          = мБиржаММВБ;
			НовыйРежимТоргов.Код 			          = Выборка.BOARDID;
			НовыйРежимТоргов.Наименование 	          = Выборка.BOARDNAME;
			НовыйРежимТоргов.НаименованиеРежимаТоргов = НаименованияРежимовТоргов.Получить(Выборка.BOARDID);
			НовыйРежимТоргов.Записать();
			
			//сообщим о новом режиме
			ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения), "", Символы.ПС) + "При импорте котировок создан новый режим биржевых торгов с кодом '" + Выборка.BOARDID + "'. Настройте реквизиты справочника";
		КонецЦикла;
		
		УстановитьПривилегированныйРежим(Ложь);
		
		ЗарегистрироватьОшибку(ТекстСообщения);
		
		// повторно передадим таблицу в запрос
		Запрос.Текст = 
			"УНИЧТОЖИТЬ _РежимыБиржевыхТоргов
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РежимыБиржевыхТоргов.Ссылка КАК Ссылка,
			|	РежимыБиржевыхТоргов.Код КАК Код,
			|	РежимыБиржевыхТоргов.КотировкиНеНужны КАК КотировкиНеНужны
			|ПОМЕСТИТЬ _РежимыБиржевыхТоргов
			|ИЗ
			|	Справочник.РежимыБиржевыхТоргов КАК РежимыБиржевыхТоргов
			|ГДЕ
			|	РежимыБиржевыхТоргов.Биржа = &Биржа";
		
		Запрос.Выполнить();
		
	КонецЕсли;
	
КонецПроцедуры

