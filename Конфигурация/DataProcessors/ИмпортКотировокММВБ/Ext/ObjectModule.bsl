	ДобавитьКодРежимаТорговВТаблицу(ЭтотОбъект.ИсключаемыеРежимыТоргов, "GYOY"); // РЕПО с ЦК с КСУ 1 год. (CNY)
	ДобавитьКодРежимаТорговВТаблицу(ЭтотОбъект.ИсключаемыеРежимыТоргов, "PYGC"); // РЕПО с ЦК с КСУ адресное (CNY)
	ДобавитьКодРежимаТорговВТаблицу(ЭтотОбъект.ИсключаемыеРежимыТоргов, "GBRP"); // РЕПО с ЦК с КСУ 1 день (BYN)
	ДобавитьКодРежимаТорговВТаблицу(ЭтотОбъект.ИсключаемыеРежимыТоргов, "GKRP"); // РЕПО с ЦК с КСУ 1 день (KZT)

	// ДополнительныеРежимыТоргов
	ДобавитьКодРежимаТорговВТаблицу(ЭтотОбъект.ДополнительныеРежимыТоргов, "FRRP"); // Аукцион РЕПО с ЦК 1 день
	ДобавитьКодРежимаТорговВТаблицу(ЭтотОбъект.ДополнительныеРежимыТоргов, "FRFW"); // Аукцион РЕПО с ЦК 5 недель
	ДобавитьКодРежимаТорговВТаблицу(ЭтотОбъект.ДополнительныеРежимыТоргов, "TQBD"); // Т+ Ин.Акции и ДР (USD)
	ДобавитьКодРежимаТорговВТаблицу(ЭтотОбъект.ДополнительныеРежимыТоргов, "TQIR"); // Т+ Облигации ПИР
	ДобавитьКодРежимаТорговВТаблицу(ЭтотОбъект.ДополнительныеРежимыТоргов, "SMAL"); // Т+ Неполные лоты (акции)
	ДобавитьКодРежимаТорговВТаблицу(ЭтотОбъект.ДополнительныеРежимыТоргов, "TQOD"); // Т+ Облигации (расч.в USD)
	ДобавитьКодРежимаТорговВТаблицу(ЭтотОбъект.ДополнительныеРежимыТоргов, "TQOE"); // Т+ Облигации (расч.в EUR)
	ДобавитьКодРежимаТорговВТаблицу(ЭтотОбъект.ДополнительныеРежимыТоргов, "TQOY"); // Т+ Облигации (расч.в CNY)
	ДобавитьКодРежимаТорговВТаблицу(ЭтотОбъект.ДополнительныеРежимыТоргов, "TQUD"); // Т+ Облигации Д (расч. в USD)
	ДобавитьКодРежимаТорговВТаблицу(ЭтотОбъект.ДополнительныеРежимыТоргов, "TQTE"); // Т+ ETF (расч. в EUR)
	ДобавитьКодРежимаТорговВТаблицу(ЭтотОбъект.ДополнительныеРежимыТоргов, "EQEU"); // Еврооблигации
	ДобавитьКодРежимаТорговВТаблицу(ЭтотОбъект.ДополнительныеРежимыТоргов, "PSPI"); // РПС Акции ПИР
	ДобавитьКодРежимаТорговВТаблицу(ЭтотОбъект.ДополнительныеРежимыТоргов, "PTPI"); // РПС с ЦК Акции ПИР

КонецПроцедуры

Процедура ИмпортироватьКотировки(Отчет = Неопределено) Экспорт
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период, РежимИмпорта, ЦеннаяБумага, СкрыватьВОтчетеНовыеКотировки");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ИмпортироватьКотировки";
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		 ЭтотОбъект.ДополнительныеСвойства.Ошибки.Очистить();
	КонецЕсли;
	 
	Если ЭтотОбъект.ИсключаемыеРежимыТоргов.Количество() = 0 Тогда // а при интерактивной работе они уже будут заполнены
		ЗаполнитьРежимыТорговПоУмолчанию();
	КонецЕсли;
	
	КодыФинансовыхИнструментов = ПолучитьКодыФинансовыхИнструментовНаММБВ();
	
	// Загрузка котировок из Матриха
	КотировкиТорговыхПлощадок = ПолучитьКотировкиММВБИзMatrix(КодыФинансовыхИнструментов);
	Если КотировкиТорговыхПлощадок = Неопределено Тогда
		ОповеститьОбОшибках();
		Возврат;
	КонецЕсли;
	
	// Рассчитаем котировки ценных бумаг
	КотировкиЦенныхБумаг = РассчитатьКотировкиЦенныхБумаг(КотировкиТорговыхПлощадок, КодыФинансовыхИнструментов);
	Если КотировкиЦенныхБумаг = Неопределено Тогда
		ОповеститьОбОшибках();
		Возврат;
	КонецЕсли;
	
	// Загрузка купонов выходного дня из Externals
	КупоныВыходногоДня = РассчитатьКупоныВыходногоДня(КодыФинансовыхИнструментов);
	Если КупоныВыходногоДня = Неопределено Тогда
		ОповеститьОбОшибках();
		Возврат;
	КонецЕсли;
	
	// Найдем расхождения
	НачатьТранзакцию();
	
	УстановитьБлокировки();
	
	ОтчетОСверкеКотировокТорговыхПлощадок = "";
	РасхожденияКотировкиТорговыхПлощадок = НайтиРасхожденияСРегистромКотировок("КотировкиТорговыхПлощадок", КотировкиТорговыхПлощадок, ОтчетОСверкеКотировокТорговыхПлощадок);
	
	ОтчетОСверкеКотировокЦенныхБумаг = "";
	РасхожденияКотировкиЦенныхБумаг = НайтиРасхожденияСРегистромКотировок("КотировкиЦенныхБумаг", КотировкиЦенныхБумаг, ОтчетОСверкеКотировокЦенныхБумаг);
	
	ОтчетОСверкеКупоновВыходногоДня = "";
	РасхожденияКупоновВыходногоДня = НайтиРасхожденияСРегистромКотировок("КупоныВыходногоДня", КупоныВыходногоДня, ОтчетОСверкеКупоновВыходногоДня);
	
	// Загрузим новые данные
	ТребуетсяИмпорт = Ложь;
	
	Если РасхожденияКотировкиТорговыхПлощадок.ЕстьРасхождения
		Или РасхожденияКотировкиЦенныхБумаг.ЕстьРасхождения
		Или РасхожденияКупоновВыходногоДня.ЕстьРасхождения
	Тогда
		
		Если ЭтотОбъект.РежимИмпорта = 1 Тогда // только импорт новых котировок
			
			Если РасхожденияКотировкиТорговыхПлощадок.ЗаписьУдалена > 0 Или РасхожденияКотировкиТорговыхПлощадок.ЗаписьИзменена > 0 Тогда
				ЗарегистрироватьОшибку("Импорт новых котировок невозможен, т.к. присутствуют расхождения в котировках торговых площадок.");
				ТребуетсяИмпорт = Ложь;
			ИначеЕсли РасхожденияКотировкиЦенныхБумаг.ЗаписьУдалена > 0 Или РасхожденияКотировкиЦенныхБумаг.ЗаписьИзменена > 0 Тогда
				ЗарегистрироватьОшибку("Импорт новых котировок невозможен, т.к. присутствуют расхождения в котировках ценных бумаг");
				ТребуетсяИмпорт = Ложь;
			ИначеЕсли РасхожденияКупоновВыходногоДня.ЗаписьУдалена > 0 Или РасхожденияКупоновВыходногоДня.ЗаписьИзменена > 0 Тогда
				ЗарегистрироватьОшибку("Импорт новых котировок невозможен, т.к. присутствуют расхождения в купонах выходного дня.");
				ТребуетсяИмпорт = Ложь;
			Иначе
				ТребуетсяИмпорт = РасхожденияКотировкиТорговыхПлощадок.НоваяЗапись > 0
					Или РасхожденияКотировкиЦенныхБумаг.НоваяЗапись > 0
					Или РасхожденияКупоновВыходногоДня.НоваяЗапись > 0;
			КонецЕсли;
			
		ИначеЕсли ЭтотОбъект.РежимИмпорта = 2 Тогда
			
			ТребуетсяИмпорт = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТребуетсяИмпорт Тогда
		// Расхождения котировок торговых площадок
		Если РасхожденияКотировкиТорговыхПлощадок.ЕстьРасхождения Тогда
			ЗаписатьКотировкиВРегистр("КотировкиТорговыхПлощадок", КотировкиТорговыхПлощадок);
		КонецЕсли;
		// Расхождения котировок ценных бумаг
		Если РасхожденияКотировкиЦенныхБумаг.ЕстьРасхождения Тогда
			ЗаписатьКотировкиВРегистр("КотировкиЦенныхБумаг", КотировкиЦенныхБумаг);
		КонецЕсли;
		// Расхождения купонов выходного дня
		Если РасхожденияКупоновВыходногоДня.ЕстьРасхождения Тогда
			ЗаписатьКотировкиВРегистр("КупоныВыходногоДня", КупоныВыходногоДня);
		КонецЕсли;
	КонецЕсли;
	
	ЗафиксироватьТранзакцию();
	
	// Итоговый отчет
	Отчет =
		"<html>
		|<head>
		|	<style>
		|		.compare_records {font-size: 9pt; font-family: Verdana, Arial, Helvetica, sans-serif;}
		|		.new_record {color: green;}
		|		.del_record {color: blue;}
		|		.eq_values {color: gray;}
		|		.nq_values {color: red;}
		|	</style>
		|</head>
		|<body>
		|<h1>Отчет об импорте котировок ММВБ</h1>
		|<div>Период с &НачалоПериода по &ОкончаниеПериода</div>
		|<div>Отбор по ценной бумаге: &ОтборПоЦеннойБумаге</div>
		|<h2>Котировки торговых площадок</h2>
		|&ОтчетОСверкеКотировокТорговыхПлощадок
		|<h2>Котировки ценных бумаг</h2>
		|&ОтчетОСверкеКотировокЦенныхБумаг
		|<h2>Купоны выходного дня</h2>
		|&ОтчетОСверкеКупоновВыходногоДня
		|</body></html>";
	Отчет = СтрЗаменить(Отчет, "&НачалоПериода", Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy"));
	Отчет = СтрЗаменить(Отчет, "&ОкончаниеПериода", Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	Отчет = СтрЗаменить(Отчет, "&ОтчетОСверкеКотировокТорговыхПлощадок", ОтчетОСверкеКотировокТорговыхПлощадок);
	Отчет = СтрЗаменить(Отчет, "&ОтчетОСверкеКотировокЦенныхБумаг", ОтчетОСверкеКотировокЦенныхБумаг);
	Отчет = СтрЗаменить(Отчет, "&ОтчетОСверкеКупоновВыходногоДня", ОтчетОСверкеКупоновВыходногоДня);
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ЦеннаяБумага) Тогда
		Отчет = СтрЗаменить(Отчет, "&ОтборПоЦеннойБумаге", ЭтотОбъект.ЦеннаяБумага);
	Иначе
		Отчет = СтрЗаменить(Отчет, "&ОтборПоЦеннойБумаге", "не установен");
	КонецЕсли;
	
	ОповеститьОбОшибках();
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

