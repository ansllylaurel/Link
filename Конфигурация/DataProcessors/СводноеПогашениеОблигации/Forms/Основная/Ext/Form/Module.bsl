#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// начальное заполнение формы
	Если ЗначениеЗаполнено(ЭтаФорма.Параметры.ПогашениеОблигации) Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ЭтаФорма.Параметры.ПогашениеОблигации);
	Иначе
		ЭтаФорма.Организация  = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
		ЭтаФорма.Дата         = ТекущаяДата();
		ЭтаФорма.ДатаФиксации = ТекущаяДата();
	КонецЕсли;

	ВалютаНоминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Облигация, "ВалютаНоминала");
	
	ЗаполнитьПлановыеИСозданныеПогашенияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "СводноеПогашениеЦеннойБумаги.Обновить" Тогда
		ЗаполнитьПлановыеИСозданныеПогашенияНаСервере();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура ВидПогашенияОблигацииПриИзменении(Элемент)
	
	ВедущиеРеквизитыШапкиПриИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура ОблигацияПриИзменении(Элемент)
	
	ВалютаНоминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Облигация, "ВалютаНоминала");
	ВедущиеРеквизитыШапкиПриИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Если ЭтаФорма.ДатаФиксации <> ЭтаФорма.Дата Тогда
		Если Вопрос("Установить дату фиксации равную выбранной дате?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			ЭтаФорма.ДатаФиксации = ЭтаФорма.Дата;
		КонецЕсли;
	КонецЕсли;
	
	ЭтаФорма.СуммаНаОднуОблигацию = ПолучитьСуммуНаОднуОблигацию(ЭтаФорма.Облигация, ЭтаФорма.Дата, ЭтаФорма.ВидПогашения);
	
	ЗаполнитьПлановыеИСозданныеПогашенияНаСервере();	
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаФиксацииПриИзменении(Элемент)
	
	ЗаполнитьПлановыеИСозданныеПогашенияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаНаОднуОблигациюПриИзменении(Элемент)
	
	Для каждого СтрокаПогашенияПлановые Из ЭтаФорма.ПогашенияПлановые Цикл
		СтрокаПогашенияПлановые.Сумма = СтрокаПогашенияПлановые.Количество * ЭтаФорма.СуммаНаОднуОблигацию;
	КонецЦикла;
	
	ОбновитьНадписьПогашенияПлановыеИтого(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаКупонаНаОднуОблигациюПриИзменении(Элемент)

	Для каждого СтрокаПогашенияПлановые Из ЭтаФорма.ПогашенияПлановые Цикл
		СтрокаПогашенияПлановые.СуммаКупона = СтрокаПогашенияПлановые.Количество * ЭтаФорма.СуммаКупонаНаОднуОблигацию;
	КонецЦикла;
	
	ОбновитьНадписьПогашенияПлановыеИтого(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПогашенияСозданныеПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекущиеДанные = Элементы.ПогашенияСозданные.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьЗначение(ТекущиеДанные.Документ);
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаЗаполнитьДатуФиксацииИзДаты(Команда)
	
	ЭтаФорма.ДатаФиксации = ЭтаФорма.Дата;
	
	ДатаФиксацииПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПогашенияПлановыеУстановитьВсеФлажки(Команда)
	
	Для каждого СтрокаПогашенияПлановые Из ЭтаФорма.ПогашенияПлановые Цикл
		СтрокаПогашенияПлановые.Флажок = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПогашенияПлановыеСнятьВсеФлажки(Команда)
	
	Для каждого СтрокаПогашенияПлановые Из ЭтаФорма.ПогашенияПлановые Цикл
		СтрокаПогашенияПлановые.Флажок = Ложь;
	КонецЦикла;

	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновить(Команда)
	
	КлючиРазвернутыхСтрокПогашенияСозданные = Неопределено;
	РаботаСФормамиКлиент.ПолучитьКлючиРазвернутыхСтрокДерева(ЭтаФорма.ПогашенияСозданные, Элементы.ПогашенияСозданные, "Документ", КлючиРазвернутыхСтрокПогашенияСозданные);
	
	КлючТекущейСтрокиПогашенияСозданные = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.ПогашенияСозданные, "Документ");
	КлючТекущейСтрокиПогашенияПлановые  = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.ПогашенияПлановые,  "СчетДоверительногоУправления");
	
	ЗаполнитьПлановыеИСозданныеПогашенияНаСервере();
	
	РаботаСФормамиКлиент.ВосстановитьРазвернутыеСтрокиДереваПоКлючу(ЭтаФорма.ПогашенияСозданные, Элементы.ПогашенияСозданные, "Документ", КлючиРазвернутыхСтрокПогашенияСозданные);
	
	РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.ПогашенияСозданные, Элементы.ПогашенияСозданные, "Документ", КлючТекущейСтрокиПогашенияСозданные);
	РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.ПогашенияПлановые, Элементы.ПогашенияПлановые, "СчетДоверительногоУправления", КлючТекущейСтрокиПогашенияСозданные);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьПогашенияОблигации(Команда)
	
	ЕстьОшибки = Ложь;
	
	// проверим заполнение
	ВыбПлановыеПогашения = Новый Массив();
	
	Для НомСтр = 0 По ЭтаФорма.ПогашенияПлановые.Количество() - 1 Цикл
			
		СтрокаПлановыеПогашения = ЭтаФорма.ПогашенияПлановые[НомСтр];
		
		Если Не СтрокаПлановыеПогашения.Флажок Тогда
			Продолжить;
		КонецЕсли;
	
		Если СтрокаПлановыеПогашения.Количество = 0 Тогда
			Сообщить("Не заполнено поле ""Количество"" в строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если СтрокаПлановыеПогашения.Сумма = 0 Тогда
			Сообщить("Не заполнено поле ""Сумма"" в строке № " + (НомСтр + 1));
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		ВыбПлановыеПогашения.Добавить(
			Новый Структура("СчетДоверительногоУправления, Количество, Сумма, СуммаКупона",
				СтрокаПлановыеПогашения.СчетДоверительногоУправления,
				СтрокаПлановыеПогашения.Количество,
				СтрокаПлановыеПогашения.Сумма,
				СтрокаПлановыеПогашения.СуммаКупона));
		
	КонецЦикла;
	
	Если      ЕстьОшибки Тогда
		Возврат;
	ИначеЕсли ВыбПлановыеПогашения.Количество() = 0 Тогда
		Сообщить("Не выбраны плановые погашения.");
		Возврат;
	КонецЕсли;
	
	// откроем форму
	ПараметрыФормы = Новый Структура("ПлановыеПогашения, Организация, ВидПогашения, Облигация, Дата, ДатаФиксации", ВыбПлановыеПогашения);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ЭтаФорма);
	
	Если ОткрытьФормуМодально("Обработка.СводноеПогашениеОблигации.Форма.СозданиеПогашенийОблигации", ПараметрыФормы, ЭтаФорма) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КомандаОбновить(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыПровести(Команда)
	
	ДанныеВыбранныхДокументов = ПолучитьДанныеВыбранныхДокументов();
		
	Если ДанныеВыбранныхДокументов.Количество() > 0 Тогда
		
		РаботаСоСпискомДокументовКлиент.Провести(ДанныеВыбранныхДокументов);
	
		КомандаОбновить(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыОтменитьПроведение(Команда)
	
	ДанныеВыбранныхДокументов = ПолучитьДанныеВыбранныхДокументов();
	
	Если ДанныеВыбранныхДокументов.Количество() > 0 Тогда
		
		РаботаСоСпискомДокументовКлиент.ОтменитьПроведение(ДанныеВыбранныхДокументов);
		
		КомандаОбновить(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыУстановитьСнятьПометкуУдаление(Команда)
	
	ДанныеВыбранныхДокументов = ПолучитьДанныеВыбранныхДокументов();
	
	Если ДанныеВыбранныхДокументов.Количество() > 0 Тогда		
		
		Попытка 
			РаботаСоСпискомДокументовКлиент.УстановитьСнятьПометкуУдаления(ДанныеВыбранныхДокументов);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось установить/снять пометку удаления у выбранных документов: " + ОписаниеОшибки());
		КонецПопытки;
		
		КомандаОбновить(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыСоздатьНаОсновании(Команда)
	
	ТекущиеДанныеСписка = Элементы.ПогашенияСозданные.ТекущиеДанные;
	
	Если ТекущиеДанныеСписка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанныеСписка.Документ) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") Тогда
		
		РаботаСоСпискомДокументовКлиент.СоздатьНаОсновании(ТекущиеДанныеСписка.Документ, "ПогашениеЦеннойБумаги");
		
		КомандаОбновить(Неопределено);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьНедостающиеОплаты(Команда)
	
	ПогашенияОблигации = Новый Массив();
	
	Для каждого Элемент Из ЭтаФорма.ПогашенияСозданные.ПолучитьЭлементы() Цикл
		ПогашенияОблигации.Добавить(Элемент.Документ);
	КонецЦикла;
	
	Если ПогашенияОблигации.Количество() > 0 Тогда
		
		ДатаОплат = ?(ДатаФиксации < ТекущаяДата(), ТекущаяДата(), ДатаФиксации + 34*3600);
		
		Если Не ВвестиДату(ДатаОплат, "Введите дату оплат", ЧастиДаты.ДатаВремя) Тогда
			Возврат;
		КонецЕсли;
		
		СоздатьНедостающиеОплатыПоПогашениямОблигации(ДатаОплат, ЭтаФорма.Организация, РаботаСЦеннымиБумагами.КонтрагентПоЦеннойБумаге(ЭтаФорма.Облигация), ПогашенияОблигации);
		
		КомандаОбновить(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьНедостающиеСписанияОблигаций(Команда)
	
	ПогашенияОблигации = Новый Массив();
	
	Для каждого Элемент Из ЭтаФорма.ПогашенияСозданные.ПолучитьЭлементы() Цикл
		ПогашенияОблигации.Добавить(Элемент.Документ);
	КонецЦикла;
	
	Если ПогашенияОблигации.Количество() > 0 Тогда
		
		ДатаСписания = ?(ДатаФиксации < ТекущаяДата(), ТекущаяДата(), ДатаФиксации + 34*3600);
		
		Если Не ВвестиДату(ДатаСписания, "Введите дату списания", ЧастиДаты.ДатаВремя) Тогда
			Возврат;
		КонецЕсли;
		
		СоздатьНедостающиеСписанияПоПогашениямОблигации(ДатаСписания, ЭтаФорма.Организация, ЭтаФорма.Облигация, ПогашенияОблигации);
		
		КомандаОбновить(Неопределено);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПогашенияСозданныеРазвернутьВсе(Команда)
	
	РаботаСФормамиКлиент.РазвернутьВсеЭлементыДерева(ЭтаФорма.ПогашенияСозданные, Элементы.ПогашенияСозданные);
	
