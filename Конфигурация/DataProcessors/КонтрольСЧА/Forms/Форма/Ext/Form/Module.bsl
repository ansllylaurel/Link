
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.ЭтоПолноправныйПользователь = РаботаСПользователями.ЭтоПолноправныйПользователь();
	
	Элементы.КоличествоПараллельныхСеансов.Видимость = ЭтаФорма.ЭтоПолноправныйПользователь;
	Элементы.Организация.Видимость = ЭтаФорма.ЭтоПолноправныйПользователь;
	Элементы.СчетаДоверительногоУправленияКонтекстноеМенюЗаполнитьИзЗапроса.Видимость = ЭтаФорма.ЭтоПолноправныйПользователь;
	Элементы.ОрганизацияНадпись.Видимость = Не ЭтаФорма.ЭтоПолноправныйПользователь;
		
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	ЭтаФорма.КоличествоПараллельныхСеансов = 3;
	
	Если Не ЭтаФорма.ЭтоПолноправныйПользователь Тогда
		Элементы.РежимОтбора.СписокВыбора.Удалить(Элементы.РежимОтбора.СписокВыбора.НайтиПоЗначению(0));
		Элементы.РежимОтбора.СписокВыбора.Удалить(Элементы.РежимОтбора.СписокВыбора.НайтиПоЗначению(4));
		ЭтаФорма.РежимОтбора = 1;
	КонецЕсли; 
	
	ПоказатьДлительнуюОперацию(ЭтаФорма, Ложь);
		
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ЭтаФорма.ИдентификаторЗадания) Тогда
		
		СтандартнаяОбработка = Ложь;
		Отказ = Истина;
		Если Не ЗавершениеРаботы Тогда
		
			Оповещение = Новый ОписаниеОповещения("ВопросОтменитьВыполнениеЗавершение", ЭтотОбъект);
			ПоказатьВопрос(Оповещение, "Отменить выполнение контроля?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);	
			
		Иначе
			
			ТекстПредупреждения = "Сначала рекомендуется отменить выполнение контроля";
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ПустаяСтрока(ЭтаФорма.АдресЭлектроннойПочты) Тогда
		ЭтаФорма.АдресЭлектроннойПочты = ПолучитьАдресЭлектроннойПочтыТекущегоПользователя();	
	КонецЕсли;
	
	ПриИзмененииПараметровОтправкиРезультатовНаПочту();
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);

КонецПроцедуры

#КонецОбласти 

#Область Команды_формы

&НаКлиенте
Процедура КомандаВыполнитьКонтроль(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;	
	КонецЕсли;
	
	Если Объект.РезультатыПроверки.Количество() > 0 Тогда
		
		ПоляДляОчистки = Новый Массив;
		ПоляДляОчистки.Добавить("Статус");
		ПоляДляОчистки.Добавить("ЕстьОшибки");
		ПоляДляОчистки.Добавить("ЕстьОшибкиВЦБ");
		ПоляДляОчистки.Добавить("ЕстьОшибкиВАктивах");
		ПоляДляОчистки.Добавить("ЕстьОшибкиЗарегистрированныхЗначений");
		ПоляДляОчистки.Добавить("СЧА_Расчетная");
		ПоляДляОчистки.Добавить("РСА_Расчетная");
		ПоляДляОчистки.Добавить("РСА_Текущая");
		ПоляДляОчистки.Добавить("СЧА_Текущая");
		
		Для каждого ТекСтрока Из Объект.РезультатыПроверки Цикл
			Для каждого Поле Из ПоляДляОчистки Цикл
				ТекСтрока[Поле] = Неопределено;
			КонецЦикла; 
			ТекСтрока.ИднетификаторРезультата = Новый УникальныйИдентификатор;
		КонецЦикла; 
		
		ПодключитьОбработчикОжидания("ПроверитьСостояниеЗаданий", 5);
		ПоказатьДлительнуюОперацию(ЭтаФорма, Истина);
		ЗапуститьКонтрольНаСервере();
		
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОрганизациюПриНесоответствииОтбора()

	Если Не (ЭтаФорма.ЭтоПолноправныйПользователь И ЗначениеЗаполнено(Объект.Организация)) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.РежимОтбора = 2 Тогда
		ПроверкаПройдена = ВыбранныеСчетаСоответствуютОрганизации(ЭтаФорма.ОтборСчетаДУ, Объект.Организация);
	ИначеЕсли ЭтаФорма.РежимОтбора = 4 Тогда
		ПроверкаПройдена = ВыбранныеСчетаСоответствуютОрганизации(ЭтаФорма.АдресРезультатаОтбора, Объект.Организация);
	Иначе
		ПроверкаПройдена = Истина;
	КонецЕсли;
	
	Если Не ПроверкаПройдена Тогда
		
		ТекстВопроса = ?(ЭтаФорма.ОтборСчетаДУВСписке, "В списке присутствуют счета ДУ, не принадлежащие ", "Выбран счет ДУ, не принадлежащий ")
			+ "организации '" + Объект.Организация + "', контроль по таким счетам не выполняется.
			|Отключить отбор по организации?";
			
		Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			Объект.Организация = Неопределено;
		КонецЕсли;
		
	КонецЕсли; 
	 
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыбранныеСчетаСоответствуютОрганизации(Отбор, Организация)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Если ЭтоАдресВременногоХранилища(Отбор) Тогда
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ДанныеОтбора.СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|ПОМЕСТИТЬ _ДанныеОтбора
			|ИЗ
			|	&ДанныеОтбора КАК ДанныеОтбора
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеОтбора КАК _ДанныеОтбора
			|		ПО (_ДанныеОтбора.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
			|ГДЕ
			|	СчетаДоверительногоУправления.Организация <> &Организация";
		
		Запрос.УстановитьПараметр("ДанныеОтбора", ПолучитьИзВременногоХранилища(Отбор));
		
	Иначе
	
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|ГДЕ
			|	СчетаДоверительногоУправления.Ссылка В(&Ссылка)
			|	И СчетаДоверительногоУправления.Организация <> &Организация";
		
		Запрос.УстановитьПараметр("Ссылка", Отбор);
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Возврат Запрос.Выполнить().Пустой()

КонецФункции

&НаКлиенте
Процедура КомандаЗаполнить(Команда)
	
	ЗаполнитьТаблицуДокументов();	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуДокументов(ИзмененОтбор = Ложь)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;	
	КонецЕсли;
	
	// Если заполнение из запроса, то при изменении отборов запрос повторно не выполняем
	
	Если ЭтаФорма.РежимОтбора = 4
		И Не (ИзмененОтбор И ДанныеЗапросаПолучены(ЭтаФорма.АдресРезультатаОтбора))
	Тогда
	
		Если Не ЗаполнитьОтборИзЗапроса() Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
		
	ОчиститьОрганизациюПриНесоответствииОтбора();
	
	Если ЗаполнитьТаблицуДокументовНаСервере() Тогда
		ЗаполнитьРезультатыПроверкиНаличияДокументов();
		ОтключитьОтборы();
	Иначе
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьТаблицуДокументовЗавершение", ЭтаФорма);
		ТекстВопроса = "По установленным отборам будет добавлено более 1000 элементов для выполнения контроля. Продолжить?";
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуДокументовЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаполнитьТаблицуДокументовНаСервере(Истина);
		ЗаполнитьРезультатыПроверкиНаличияДокументов();
		ОтключитьОтборы();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтключитьОтборы()

	Элементы.РезультатыПроверки.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура);
	
	Для Каждого ЭлементМеню Из Элементы.РезультатыПроверкиГруппаСкрытьСтроки.ПодчиненныеЭлементы Цикл
		ЭлементМеню.Пометка = Ложь;
	КонецЦикла;
	
	Элементы.РезультатыПроверкиГруппаСкрытьСтроки.Картинка = БиблиотекаКартинок.ОтборПоТекущемуЗначению;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРезультатыПроверкиНаличияДокументов()

	Для каждого ТекСтрока Из Объект.РезультатыПроверки Цикл
		
		ТекСтрока.ЕстьОшибки = Не ТекСтрока.ДатаРасчетаСЧА Или ТекСтрока.НеЗаданыНастройки Или ТекСтрока.НеРассчитанаСЧА;
		ТекСтрока.Результат = ?(ТекСтрока.НеЗаданыНастройки, "Не заданы настройки", "") +
			?(Не ТекСтрока.ДатаРасчетаСЧА И Не ТекСтрока.НеЗаданыНастройки, "В этот день СЧА не рассчитывается", "") +
			?(ТекСтрока.НеРассчитанаСЧА, "СЧА не рассчитана", "");
	
	КонецЦикла; 

КонецПроцедуры

&НаКлиенте
Процедура КомандаСкрытьСтрокиБезРасхождений(Команда)
	
	УстановитьПометкуМенюСокрытияСтрокБезРасхождений(Элементы.РезультатыПроверкиСкрытьСтрокиБезРасхождений);

	УстановитьОтборСтрокБезРасхождений();	
	
КонецПроцедуры

