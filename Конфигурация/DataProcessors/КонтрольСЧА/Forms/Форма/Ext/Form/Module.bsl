КонецПроцедуры

&НаКлиенте
Процедура Печать(НаборРасхождений = Неопределено)
	
	ИдентификаторыСтрок = Новый Массив;
	
	Для Каждого ТекСтрока Из Объект.РезультатыПроверки Цикл
		ИдентификаторСтроки = ТекСтрока.ПолучитьИдентификатор();
		Если ТекСтрока.ЕстьОшибки И Элементы.РезультатыПроверки.ПроверитьСтроку(ИдентификаторСтроки) Тогда
			ИдентификаторыСтрок.Добавить(ИдентификаторСтроки);		
		КонецЕсли;
	КонецЦикла;
		
	ДокументРезультат = СформироватьТабличныйДокументСРезультатамиПроверки(ИдентификаторыСтрок, НаборРасхождений);
	
	Если ДокументРезультат <> Неопределено Тогда
		
		ДокументРезультат.Показать("Результаты проверки СЧА");	
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти 

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура РезультатыПроверкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекСтрока = Объект.РезультатыПроверки.НайтиПоИдентификатору(ВыбраннаяСтрока);
	СтандартнаяОбработка = Ложь;
	
	Если Поле.Имя = "РезультатыПроверкиСчетДоверительногоУправления" Тогда
		ОткрытьЗначение(ТекСтрока.СчетДоверительногоУправления);
	ИначеЕсли Поле.Имя = "РезультатыПроверкиРегистрацияСтоимостиАктивов" Тогда
		ОткрытьЗначение(ТекСтрока.РегистрацияСтоимостиАктивов);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатыПроверкиПриАктивизацииСтроки(Элемент)
	
	Если Не Элементы.РезультатыПроверки.ТекущаяСтрока = Неопределено Тогда
		ТекСтрока = Объект.РезультатыПроверки.НайтиПоИдентификатору(Элементы.РезультатыПроверки.ТекущаяСтрока);
		ЭтаФорма.ТабличныйДокумент = СформироватьТабличныйДокумент(ТекСтрока.АдресВХранилище);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьРезультатыНаПочтуПриИзменении(Элемент)

	ПриИзмененииПараметровОтправкиРезультатовНаПочту();
	
КонецПроцедуры

&НаКлиенте
Процедура АдресЭлектроннойПочтыПриИзменении(Элемент)

	ПриИзмененииПараметровОтправкиРезультатовНаПочту();
	
КонецПроцедуры

&НаСервере
Процедура ОтправитьРезультатыПроверкиНаПочту()
	
	Вложения		= Новый Соответствие;
	ВременныеФайлы	= Новый Массив;	
	
	// Формируем отчет	
	
	Попытка
		
		ДанныеОтчета = СформироватьТабличныйДокументСРезультатамиПроверки();
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
		
		ДанныеОтчета.Записать(ИмяВременногоФайла,  ТипФайлаТабличногоДокумента.XLSX);
		
		Вложения.Вставить("Отчет.xlsx", Новый Файл(ИмяВременногоФайла));
		
		ВременныеФайлы.Добавить(ИмяВременногоФайла);
		
	Исключение
		
		ЗаписьЖурналаРегистрации("Ошибка формирования отчета", УровеньЖурналаРегистрации.Ошибка, , Метаданные.Обработки.КонтрольСЧА.ПолноеИмя(), ОписаниеОшибки());
		
	КонецПопытки;
	
	// Формируем данные во внутреннем формате
	
	Попытка
		
		ДанныеФайла	= ПолучитьРезультатыПроверкиВоВнутреннемФормате();
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
		
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.УстановитьТекст(ДанныеФайла);
		ТекстовыйДокумент.Записать(ИмяВременногоФайла, КодировкаТекста.UTF8);
		
		Вложения.Вставить("Служебный.xml", Новый Файл(ИмяВременногоФайла));
		
		ВременныеФайлы.Добавить(ИмяВременногоФайла);
		
	Исключение
		
		ЗаписьЖурналаРегистрации("Ошибка формирования файла во внутреннем формате", УровеньЖурналаРегистрации.Ошибка, , Метаданные.Обработки.КонтрольСЧА.ПолноеИмя(), ОписаниеОшибки());
		
	КонецПопытки;
	
	// Высылаем на почту	
	
	Если ЭтаФорма.РежимОтбора = 0 Тогда
		ПредставлениеОтбора = "всем клиентам";
	ИначеЕсли ЭтаФорма.РежимОтбора = 1 Тогда
		ПредставлениеОтбора = Строка(ЭтаФорма.ОтборВидыДоговоровДУ);
	ИначеЕсли ЭтаФорма.РежимОтбора = 2 Тогда
		ПредставлениеОтбора = Строка(ЭтаФорма.ОтборСчетаДУ);
	ИначеЕсли ЭтаФорма.РежимОтбора = 3 Тогда
		ПредставлениеОтбора = Строка(ЭтаФорма.ОтборКлиенты);
	Иначе
		ПредставлениеОтбора = Неопределено;
	КонецЕсли; 
		
	Попытка
		
		РаботаСЭлектроннойПочтой.ОтправитьПростоеЭлектронноеПисьмо(
			ЭтаФорма.АдресЭлектроннойПочты,
			"Контроль СЧА за период " + Строка(Объект.ПериодКонтроля) + " по " + ПредставлениеОтбора,
			"Результаты проверки СЧА за период " + Строка(Объект.ПериодКонтроля) + " по " + ПредставлениеОтбора,
			Вложения,
			РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(),
			Ложь
		);
		
	Исключение
		
		ЗаписьЖурналаРегистрации("Ошибка отправки отчета на электронную почту", УровеньЖурналаРегистрации.Ошибка, , Метаданные.Обработки.КонтрольСЧА.ПолноеИмя(), ОписаниеОшибки());
		
	КонецПопытки;	
	
	// Удаляем не нужные файлы	
	
	Для Каждого ВременныйФайл Из ВременныеФайлы Цикл
		УдалитьФайлы(ВременныйФайл);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Если ЭтаФорма.РежимОтбора = 4 Тогда
		ОчиститьРезультатыПроверки();
	КонецЕсли;
	
	ЗаполнитьТаблицуДокументов(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура РежимОтбораПриИзменении(Элемент)
	
	Элементы.РежимОтбора.ОтображениеПодсказки = ?(ЭтаФорма.РежимОтбора = 4, ОтображениеПодсказки.Кнопка, ОтображениеПодсказки.Нет);
	
	Элементы.ГруппаОтборВидыДоговоровДУ.Видимость 	= ЭтаФорма.РежимОтбора = 1;
	Элементы.ГруппаОтборСчетаДУ.Видимость 			= ЭтаФорма.РежимОтбора = 2;
	Элементы.ГруппаОтборКлиенты.Видимость 			= ЭтаФорма.РежимОтбора = 3;
	
	ПриИзмененииВидаОтбора("ВидыДоговоровДУ");
	ПриИзмененииВидаОтбора("СчетаДУ");
	ПриИзмененииВидаОтбора("Клиенты");

	Если ЭтаФорма.РежимОтбора <> 4 Тогда
		ЗаполнитьТаблицуДокументов(Истина);
	КонецЕсли;
	
КонецПроцедуры

