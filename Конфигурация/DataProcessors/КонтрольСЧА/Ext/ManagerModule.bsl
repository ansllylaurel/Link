		|	ЕСТЬNULL(СтоимостьПереоценкиСтарая.СтрокаПартии, СтоимостьПереоценкиНовая.СтрокаПартии) КАК СтрокаПартии,
		|	ЕСТЬNULL(СтоимостьПереоценкиСтарая.Цена, 0) КАК ЦенаСтарая,
		|	ЕСТЬNULL(СтоимостьПереоценкиНовая.Цена, 0) КАК ЦенаНовая,
		|	ЕСТЬNULL(СтоимостьПереоценкиСтарая.ЦенаКупона, 0) КАК ЦенаКупонаСтарая,
		|	ЕСТЬNULL(СтоимостьПереоценкиНовая.ЦенаКупона, 0) КАК ЦенаКупонаНовая,
		|	ЕСТЬNULL(СтоимостьПереоценкиСтарая.СуммаВВалютеУчета, 0) КАК СуммаВВалютеУчетаСтарая,
		|	ЕСТЬNULL(СтоимостьПереоценкиНовая.СуммаВВалютеУчета, 0) КАК СуммаВВалютеУчетаНовая,
		|	ЕСТЬNULL(СтоимостьПереоценкиСтарая.СуммаКупонаВВалютеУчета, 0) КАК СуммаКупонаВВалютеУчетаСтарая,
		|	ЕСТЬNULL(СтоимостьПереоценкиНовая.СуммаКупонаВВалютеУчета, 0) КАК СуммаКупонаВВалютеУчетаНовая,
		|	ЕСТЬNULL(СтоимостьПереоценкиСтарая.ВидЦены, НЕОПРЕДЕЛЕНО) КАК ВидЦеныСтарый,
		|	ЕСТЬNULL(СтоимостьПереоценкиНовая.ВидЦены, НЕОПРЕДЕЛЕНО) КАК ВидЦеныНовый,
		|	ЕСТЬNULL(СтоимостьПереоценкиСтарая.УровеньОценки, НЕОПРЕДЕЛЕНО) КАК УровеньОценкиСтарый,
		|	ЕСТЬNULL(СтоимостьПереоценкиНовая.УровеньОценки, НЕОПРЕДЕЛЕНО) КАК УровеньОценкиНовый,
		|	ЕСТЬNULL(СтоимостьПереоценкиСтарая.ДатаЦены, НЕОПРЕДЕЛЕНО) КАК ДатаЦеныСтарая,
		|	ЕСТЬNULL(СтоимостьПереоценкиНовая.ДатаЦены, НЕОПРЕДЕЛЕНО) КАК ДатаЦеныНовая,
		|	ЕСТЬNULL(СтоимостьПереоценкиСтарая.Источник, НЕОПРЕДЕЛЕНО) КАК ИсточникСтарый,
		|	ЕСТЬNULL(СтоимостьПереоценкиНовая.Источник, НЕОПРЕДЕЛЕНО) КАК ИсточникНовый
		|ИЗ
		|	_СтоимостьПереоценкиПоДаннымУчета КАК СтоимостьПереоценкиСтарая
		|		ПОЛНОЕ СОЕДИНЕНИЕ _СтоимостьПереоценки КАК СтоимостьПереоценкиНовая
		|		ПО СтоимостьПереоценкиСтарая.Рынок = СтоимостьПереоценкиНовая.Рынок
		|			И СтоимостьПереоценкиСтарая.ЦеннаяБумага = СтоимостьПереоценкиНовая.ЦеннаяБумага
		|			И СтоимостьПереоценкиСтарая.Партия = СтоимостьПереоценкиНовая.Партия
		|			И СтоимостьПереоценкиСтарая.СтрокаПартии = СтоимостьПереоценкиНовая.СтрокаПартии
		|ГДЕ
		|	(ЕСТЬNULL(СтоимостьПереоценкиСтарая.СуммаВВалютеУчета, 0) <> ЕСТЬNULL(СтоимостьПереоценкиНовая.СуммаВВалютеУчета, 0)
		|			ИЛИ ЕСТЬNULL(СтоимостьПереоценкиСтарая.СуммаКупонаВВалютеУчета, 0) <> ЕСТЬNULL(СтоимостьПереоценкиНовая.СуммаКупонаВВалютеУчета, 0)
		|			ИЛИ ЕСТЬNULL(СтоимостьПереоценкиСтарая.ВидЦены, 0) <> ЕСТЬNULL(СтоимостьПереоценкиНовая.ВидЦены, 0)
		|			ИЛИ ЕСТЬNULL(СтоимостьПереоценкиСтарая.УровеньОценки, 0) <> ЕСТЬNULL(СтоимостьПереоценкиНовая.УровеньОценки, 0)
		|			ИЛИ ЕСТЬNULL(СтоимостьПереоценкиСтарая.ДатаЦены, 0) <> ЕСТЬNULL(СтоимостьПереоценкиНовая.ДатаЦены, 0)
		|			ИЛИ ЕСТЬNULL(СтоимостьПереоценкиСтарая.Источник, 0) <> ЕСТЬNULL(СтоимостьПереоценкиНовая.Источник, 0))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(СтоимостьПереоценкиСтарая.Рынок, СтоимостьПереоценкиНовая.Рынок) КАК Рынок,
		|	ЕСТЬNULL(СтоимостьПереоценкиСтарая.ЦеннаяБумага, СтоимостьПереоценкиНовая.ЦеннаяБумага) КАК ЦеннаяБумага,
		|	ЕСТЬNULL(СтоимостьПереоценкиСтарая.Партия, СтоимостьПереоценкиНовая.Партия) КАК Партия,
		|	ЕСТЬNULL(СтоимостьПереоценкиСтарая.СтрокаПартии, СтоимостьПереоценкиНовая.СтрокаПартии) КАК СтрокаПартии,
		|	ЕСТЬNULL(СтоимостьПереоценкиСтарая.Цена, 0) КАК ЦенаСтарая,
		|	ЕСТЬNULL(СтоимостьПереоценкиНовая.Цена, 0) КАК ЦенаНовая,
		|	ЕСТЬNULL(СтоимостьПереоценкиСтарая.ЦенаКупона, 0) КАК ЦенаКупонаСтарая,
		|	ЕСТЬNULL(СтоимостьПереоценкиНовая.ЦенаКупона, 0) КАК ЦенаКупонаНовая,
		|	ЕСТЬNULL(СтоимостьПереоценкиСтарая.ВидЦены, НЕОПРЕДЕЛЕНО) КАК ВидЦеныСтарый,
		|	ЕСТЬNULL(СтоимостьПереоценкиНовая.ВидЦены, НЕОПРЕДЕЛЕНО) КАК ВидЦеныНовый,
		|	ЕСТЬNULL(СтоимостьПереоценкиСтарая.УровеньОценки, НЕОПРЕДЕЛЕНО) КАК УровеньОценкиСтарый,
		|	ЕСТЬNULL(СтоимостьПереоценкиНовая.УровеньОценки, НЕОПРЕДЕЛЕНО) КАК УровеньОценкиНовый,
		|	ЕСТЬNULL(СтоимостьПереоценкиСтарая.ДатаЦены, НЕОПРЕДЕЛЕНО) КАК ДатаЦеныСтарая,
		|	ЕСТЬNULL(СтоимостьПереоценкиНовая.ДатаЦены, НЕОПРЕДЕЛЕНО) КАК ДатаЦеныНовая,
		|	ЕСТЬNULL(СтоимостьПереоценкиСтарая.Источник, НЕОПРЕДЕЛЕНО) КАК ИсточникСтарый,
		|	ЕСТЬNULL(СтоимостьПереоценкиНовая.Источник, НЕОПРЕДЕЛЕНО) КАК ИсточникНовый
		|ИЗ
		|	_СтоимостьПрочихЦенныхБумагПоДаннымУчета КАК СтоимостьПереоценкиСтарая
		|		ПОЛНОЕ СОЕДИНЕНИЕ _СтоимостьПрочихЦенныхБумаг КАК СтоимостьПереоценкиНовая
		|		ПО СтоимостьПереоценкиСтарая.Рынок = СтоимостьПереоценкиНовая.Рынок
		|			И СтоимостьПереоценкиСтарая.ЦеннаяБумага = СтоимостьПереоценкиНовая.ЦеннаяБумага
		|			И СтоимостьПереоценкиСтарая.Партия = СтоимостьПереоценкиНовая.Партия
		|			И СтоимостьПереоценкиСтарая.СтрокаПартии = СтоимостьПереоценкиНовая.СтрокаПартии
		|ГДЕ
		|	(ЕСТЬNULL(СтоимостьПереоценкиСтарая.Цена, 0) <> ЕСТЬNULL(СтоимостьПереоценкиНовая.Цена, 0)
		|			ИЛИ ЕСТЬNULL(СтоимостьПереоценкиСтарая.ЦенаКупона, 0) <> ЕСТЬNULL(СтоимостьПереоценкиНовая.ЦенаКупона, 0)
		|			ИЛИ ЕСТЬNULL(СтоимостьПереоценкиСтарая.ВидЦены, 0) <> ЕСТЬNULL(СтоимостьПереоценкиНовая.ВидЦены, 0)
		|			ИЛИ ЕСТЬNULL(СтоимостьПереоценкиСтарая.УровеньОценки, 0) <> ЕСТЬNULL(СтоимостьПереоценкиНовая.УровеньОценки, 0)
		|			ИЛИ ЕСТЬNULL(СтоимостьПереоценкиСтарая.ДатаЦены, 0) <> ЕСТЬNULL(СтоимостьПереоценкиНовая.ДатаЦены, 0)
		|			ИЛИ ЕСТЬNULL(СтоимостьПереоценкиСтарая.Источник, 0) <> ЕСТЬNULL(СтоимостьПереоценкиНовая.Источник, 0))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(ФинансовыеПоказателиДоходностиСтарые.ВидПоказателя, ФинансовыеПоказателиДоходностиНовые.ВидПоказателя) КАК ВидПоказателя,
		|	ЕСТЬNULL(ФинансовыеПоказателиДоходностиСтарые.Значение, 0) КАК ЗначениеСтарое,
		|	ЕСТЬNULL(ФинансовыеПоказателиДоходностиНовые.Значение, 0) КАК ЗначениеНовое
		|ИЗ
		|	_ФинансовыеПоказателиДоходностиПоДаннымУчета КАК ФинансовыеПоказателиДоходностиСтарые
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ФинансовыеПоказателиДоходности КАК ФинансовыеПоказателиДоходностиНовые
		|		ПО ФинансовыеПоказателиДоходностиСтарые.ВидПоказателя = ФинансовыеПоказателиДоходностиНовые.ВидПоказателя
		|ГДЕ
		|	ЕСТЬNULL(ФинансовыеПоказателиДоходностиСтарые.Значение, 0) <> ЕСТЬNULL(ФинансовыеПоказателиДоходностиНовые.Значение, 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(_Итоги.РСА_Расчетная) КАК РСА_Расчетная,
		|	СУММА(_Итоги.СЧА_Расчетная) КАК СЧА_Расчетная,
		|	СУММА(_Итоги.РСА_Текущая) КАК РСА_Текущая,
		|	СУММА(_Итоги.СЧА_Текущая) КАК СЧА_Текущая,
		|	СУММА(_Итоги.СтоимостьПая_Расчетная) КАК СтоимостьПая_Расчетная,
		|	СУММА(_Итоги.СтоимостьПая_Текущая) КАК СтоимостьПая_Текущая,
		|	МАКСИМУМ(_Итоги.РучнойВвод) КАК РучнойВвод
		|ИЗ
		|	_Итоги КАК _Итоги";
	
	// Костыль (начало)
	Если ДанныеДокумента.Период < '20180709' Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕСТЬNULL(СтоимостьПереоценкиСтарая.Источник, 0) <> ЕСТЬNULL(СтоимостьПереоценкиНовая.Источник, 0)", 
			"ВЫБОР
			|	КОГДА СтоимостьПереоценкиСтарая.Источник = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
			|			И СтоимостьПереоценкиСтарая.ВидЦены = ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СправедливаяЦенаНРД)
			|		ТОГДА СтоимостьПереоценкиНовая.Источник ЕСТЬ NULL
			|	ИНАЧЕ ЕСТЬNULL(СтоимостьПереоценкиСтарая.Источник, 0) <> ЕСТЬNULL(СтоимостьПереоценкиНовая.Источник, 0)
			|КОНЕЦ");
	КонецЕсли;
	// Костыль (конец)
	
	#КонецОбласти 
	
	РезультатЗапроса 		= Запрос.ВыполнитьПакет();
	ОтличияАктивов 			= РезультатЗапроса[РезультатЗапроса.ВГраница()-4].Выгрузить();
	ОтличияЦБ 				= РезультатЗапроса[РезультатЗапроса.ВГраница()-3].Выгрузить();
	ОтличияПрочихЦБ 		= РезультатЗапроса[РезультатЗапроса.ВГраница()-2].Выгрузить();
	ОтличияДоходности		= РезультатЗапроса[РезультатЗапроса.ВГраница()-1].Выгрузить();
	Итоги 					= РезультатЗапроса[РезультатЗапроса.ВГраница()].Выгрузить();
	
	ЕстьОшибкиЗарегистрированныхЗначений = Ложь;
	РучнойВвод = Ложь;
	ЗначенияИтогов = Неопределено;
	
	Если Итоги.Количество() > 0 Тогда
		СтрокаИтоги = Итоги[0];
		ЕстьОшибкиЗарегистрированныхЗначений = (СтрокаИтоги.РСА_Текущая <> СтрокаИтоги.РСА_Расчетная) 
												Или (СтрокаИтоги.СЧА_Текущая <> СтрокаИтоги.СЧА_Расчетная) 
												Или (СтрокаИтоги.СтоимостьПая_Текущая <> СтрокаИтоги.СтоимостьПая_Расчетная)
												ИЛИ ОтличияДоходности.Количество() > 0;
		РучнойВвод = СтрокаИтоги.РучнойВвод;
	КонецЕсли; 
	
	Результат.Вставить("ЕстьОшибкиЗарегистрированныхЗначений", 	ЕстьОшибкиЗарегистрированныхЗначений);
	Результат.Вставить("ОтличияАктивов", 		ОтличияАктивов);
	Результат.Вставить("ОтличияЦБ",				ОтличияЦБ);
	Результат.Вставить("ОтличияПрочихЦБ",		ОтличияПрочихЦБ);
	Результат.Вставить("ОтличияДоходности",		ОтличияДоходности);
	Результат.Вставить("РучнойВвод", 			РучнойВвод);
	Результат.Вставить("Итоги", 				Итоги);
	
КонецПроцедуры

Функция СформироватьТабличныйДокумент(НаборыДанных) Экспорт

	ТабличныйДокумент = Новый ТабличныйДокумент;
	СКД = ПолучитьМакет("Макет");
	
	Если НаборыДанных.Свойство("Клиенты") Тогда
		ВыводитьКлиентов			= Истина;
		ВыводитьОтличияЦБ			= Ложь;
		ВыводитьОтличияПрочихЦБ 	= Ложь;
		ВыводитьОтличияАктивов		= Ложь;
		ВыводитьОтличияДоходности	= Ложь;
		ВыводитьИтоги				= Ложь;
		ВыводитьИтогиПИФ			= Ложь;
	Иначе	
		Если Не (НаборыДанных.Свойство("ОтличияЦБ") И НаборыДанных.Свойство("ОтличияПрочихЦБ") 
			И НаборыДанных.Свойство("ОтличияАктивов") И НаборыДанных.Свойство("ЕстьОшибкиЗарегистрированныхЗначений")) Тогда
			Возврат Неопределено;
		КонецЕсли; 
		ВыводитьКлиентов			= Ложь;
		ВыводитьОтличияЦБ			= (НаборыДанных.ОтличияЦБ.Количество() > 0);
		ВыводитьОтличияПрочихЦБ		= (НаборыДанных.ОтличияПрочихЦБ.Количество() > 0);
		ВыводитьОтличияАктивов		= (НаборыДанных.ОтличияАктивов.Количество() > 0);
		ВыводитьОтличияДоходности	= (НаборыДанных.Свойство("ОтличияДоходности") И НаборыДанных.ОтличияДоходности.Количество() > 0);
		Если НаборыДанных.ЕстьОшибкиЗарегистрированныхЗначений Тогда
			ВыводитьИтоги		= НаборыДанных.ВидДоговора <> Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда;
			ВыводитьИтогиПИФ	= Не ВыводитьИтоги;
		Иначе
			ВыводитьИтоги		= Ложь;
			ВыводитьИтогиПИФ	= Ложь;
		КонецЕсли; 
		
	КонецЕсли;
	
	Настройки = СКД.НастройкиПоУмолчанию;
	
	Для Каждого ЭлементСтруктуры Из Настройки.Структура Цикл
		Если ЭлементСтруктуры.Имя = "Рынок" Тогда
			ЭлементСтруктуры.Использование = ВыводитьОтличияЦБ;
		ИначеЕсли ЭлементСтруктуры.Имя = "РынокПрочие" Тогда
			ЭлементСтруктуры.Использование = ВыводитьОтличияПрочихЦБ;	
		ИначеЕсли ЭлементСтруктуры.Имя = "Активы" Тогда
			ЭлементСтруктуры.Использование = ВыводитьОтличияАктивов;
		ИначеЕсли ЭлементСтруктуры.Имя = "Итоги" Тогда
			ЭлементСтруктуры.Использование = ВыводитьИтоги;
		ИначеЕсли ЭлементСтруктуры.Имя = "ИтогиПИФ" Тогда
			ЭлементСтруктуры.Использование = ВыводитьИтогиПИФ;
		ИначеЕсли ЭлементСтруктуры.Имя = "ОтличияДоходности" Тогда
			ЭлементСтруктуры.Использование = ВыводитьОтличияДоходности;
		ИначеЕсли ЭлементСтруктуры.Имя = "Клиенты" Тогда
			ЭлементСтруктуры.Использование = ВыводитьКлиентов;
			
			// Дата \ НаборДанных  
			Для Каждого ЭлементПодструктуры Из ЭлементСтруктуры.Структура[0].Структура Цикл
				Если ЭлементПодструктуры.Имя = "КлиентыРынокЗаголовок" Тогда
					ЭлементПодструктуры.Использование = НаборыДанных.Свойство("ОтличияЦБ");
				ИначеЕсли ЭлементПодструктуры.Имя = "КлиентыРынок" Тогда
					ЭлементПодструктуры.Использование = НаборыДанных.Свойство("ОтличияЦБ");
				ИначеЕсли ЭлементПодструктуры.Имя = "КлиентыРынокПрочиеЗаголовок" Тогда
					ЭлементПодструктуры.Использование = НаборыДанных.Свойство("ОтличияПрочихЦБ");
				ИначеЕсли ЭлементПодструктуры.Имя = "КлиентыРынокПрочие" Тогда
					ЭлементПодструктуры.Использование = НаборыДанных.Свойство("ОтличияПрочихЦБ");
				ИначеЕсли ЭлементПодструктуры.Имя = "КлиентыАктивыЗаголовок" Тогда
					ЭлементПодструктуры.Использование = НаборыДанных.Свойство("ОтличияАктивов");
				ИначеЕсли ЭлементПодструктуры.Имя = "КлиентыАктивы" Тогда
					ЭлементПодструктуры.Использование = НаборыДанных.Свойство("ОтличияАктивов");
				ИначеЕсли ЭлементПодструктуры.Имя = "КлиентыДоходностьЗаголовок" Тогда
					ЭлементПодструктуры.Использование = НаборыДанных.Свойство("ОтличияДоходности");
				ИначеЕсли ЭлементПодструктуры.Имя = "КлиентыДоходность" Тогда
					ЭлементПодструктуры.Использование = НаборыДанных.Свойство("ОтличияДоходности");
				КонецЕсли;		
			КонецЦикла;
		КонецЕсли; 
	КонецЦикла; 

	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД, СКД.НастройкиПоУмолчанию);
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, НаборыДанных, ДанныеРасшифровки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабличныйДокумент);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);

	ТабличныйДокумент.ФиксацияСверху = 0;	
	
	ТабличныйДокумент.ПоказатьУровеньГруппировокСтрок(1);
	
	Возврат ТабличныйДокумент;

КонецФункции 

Функция СформироватьСтруктуруПараметровРасчета(СчетДоверительногоУправления, Период)

	ПараметрыРасчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетДоверительногоУправления, "Организация, ВидДоговораДоверительногоУправления");
	
	ПараметрыРасчета.Вставить("Период",							НачалоДня(Период));
	ПараметрыРасчета.Вставить("Дата",							КонецДня(Период));
	ПараметрыРасчета.Вставить("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	ПараметрыРасчета.Вставить("ЦельРасчета",					Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
	ПараметрыРасчета.Вставить("ВалютаУчета",					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыРасчета.Организация, "ВалютаУчета"));
	ПараметрыРасчета.Вставить("ВалютаРубли",					ПараметрыРасчета.ВалютаУчета);
	
	// Проверяем, что заведены настройки оценки, и подгружаем файл с оценочной стоимостью, предоставленной клиентом
	
	НастройкиОценки				= РаботаСПереоценкой.ОпределитьНастройкиОценки(ПараметрыРасчета.Дата, ПараметрыРасчета.Организация, СчетДоверительногоУправления, ПараметрыРасчета.ЦельРасчета, Истина);
	ВыполнятьРасчетПоУказаниюЦБ	= НастройкиОценки.ВыполнятьРасчетПоУказаниюЦБ5419 ИЛИ НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316;
	АдресТаблицыСтоимостей		= Неопределено;
	
	Если Не ЗначениеЗаполнено(НастройкиОценки.ВариантРасчетаОценочнойСтоимости) Тогда
		
		Возврат "Не определен вариант оценки для цели '" + ПараметрыРасчета.ЦельРасчета + "'";
		
	ИначеЕсли НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом Тогда
		
		Отказ		= Ложь;
		ТекстОшибки	= Неопределено;
		
		АдресТаблицыСтоимостей = РаботаСВнешнимиСистемамиКлиентСервер.ПоместитьФайлОценочнойСтоимостиПредоставленнойКлиентомВоВременноеХранилище(
			СчетДоверительногоУправления, Период, Ложь, Новый УникальныйИдентификатор, Отказ, Ложь, ТекстОшибки);

		Если Отказ И Не ВыполнятьРасчетПоУказаниюЦБ Тогда // Если оценка "заморожена", то актуальные цены от клиента не нужны
			Возврат ТекстОшибки;
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыРасчета.Вставить("ВариантРасчетаОценочнойСтоимости",	НастройкиОценки.ВариантРасчетаОценочнойСтоимости); 
	ПараметрыРасчета.Вставить("ВидУчета",							НастройкиОценки.ВидУчетаДляОстатковПартий);
	ПараметрыРасчета.Вставить("АдресТаблицыСтоимостей",				АдресТаблицыСтоимостей); 
	ПараметрыРасчета.Вставить("КонтрольСЧА");
	
	Возврат ПараметрыРасчета;

КонецФункции

Процедура ПроверитьКоличествоАктивныхЗаданий(Наименование, Ограничение, Таймаут)
	
	МассивРаботающихЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Наименование, Состояние", Наименование, СостояниеФоновогоЗадания.Активно));
	
	Пока МассивРаботающихЗаданий.Количество() >= Ограничение Цикл
				
		Для Индекс = -МассивРаботающихЗаданий.Количество()+1 По 0 Цикл
		
			ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(МассивРаботающихЗаданий[-Индекс].УникальныйИдентификатор);
			
			Попытка
				ФоновоеЗадание.ОжидатьЗавершения(Таймаут);
				Прервать;
			Исключение 
			КонецПопытки;
		
		КонецЦикла; 
		
		МассивРаботающихЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Наименование, Состояние", Наименование, СостояниеФоновогоЗадания.Активно));
		
	КонецЦикла;
	
КонецПроцедуры
 
Функция ПолучитьПараметрыВыполненияДляСбораСтатистики(ПараметрыОтчета)
	
	Описание = "";
	
	Для каждого Элемент Из ПараметрыОтчета Цикл
		Описание = Описание + Символы.ПС + Элемент.Ключ + ": " + Элемент.Значение;
	КонецЦикла; 
	
	Описание = Сред(Описание, 2);
	
	Хранилище = Новый ХранилищеЗначения(ПараметрыОтчета, Новый СжатиеДанных(9));
	
	ПараметрыВыполненияДляСбораСтатистики = Новый Структура("Хранилище, Описание", Хранилище, Описание);
	
	Возврат ПараметрыВыполненияДляСбораСтатистики;
	
КонецФункции

Функция ПолучитьТаблицуКонтроляСЧА(Организация, ПериодКонтроля, РежимОтбора, Отбор) Экспорт

	Перем ОтборВидыДоговоровДУ, ОтборСчетаДУ, ОтборКлиенты, АдресРезультатаОтбора, ИсключитьСчетНЕОПРЕДЕЛЕН;
	
	Отбор.Свойство("ОтборВидыДоговоровДУ",		ОтборВидыДоговоровДУ);
	Отбор.Свойство("ОтборСчетаДУ",				ОтборСчетаДУ);
	Отбор.Свойство("ОтборКлиенты",				ОтборКлиенты);
	Отбор.Свойство("АдресРезультатаОтбора",		АдресРезультатаОтбора);
	Отбор.Свойство("ИсключитьСчетНЕОПРЕДЕЛЕН",	ИсключитьСчетНЕОПРЕДЕЛЕН);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация", 				Организация);
	Запрос.УстановитьПараметр("ДатаНачала", 				ПериодКонтроля.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 				ПериодКонтроля.ДатаОкончания);
	Запрос.УстановитьПараметр("ИсключитьСчетНЕОПРЕДЕЛЕН", 	?(ИсключитьСчетНЕОПРЕДЕЛЕН = Неопределено, Ложь, ИсключитьСчетНЕОПРЕДЕЛЕН));
	
	ПоместитьДатыДействияЗаПериодВоВременнуюТаблицу = Истина;
	ДополнитьДокументамиРассчитаннымиЗаПериод		= Истина;
	
	Если РежимОтбора < 3 Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
			|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
			|	СчетаДоверительногоУправления.Организация КАК Организация,
			|	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
			|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
			|ПОМЕСТИТЬ _СчетаДоверительногоУправления
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
			|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправления.СчетДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИменованныеОбъекты КАК ИменованныеОбъекты
			|		ПО (&ИсключитьСчетНЕОПРЕДЕЛЕН)
			|			И СчетаДоверительногоУправления.Ссылка = ИменованныеОбъекты.Объект
			|			И (ИменованныеОбъекты.Имя ПОДОБНО ""СчетДУ_Неопределен_%"")
			|ГДЕ
			|	(&Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			|			ИЛИ СчетаДоверительногоУправления.Организация = &Организация)
			|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания
			|	И (СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаНачала
			|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
			|	И ИменованныеОбъекты.Объект ЕСТЬ NULL
			|	И &ОтборПоВидамДоговоров
			|	И &ОтборПоСчетамДУ";
			
		Если РежимОтбора = 0 Тогда
			Запрос.УстановитьПараметр("ОтборПоВидамДоговоров", 	Истина);
			Запрос.УстановитьПараметр("ОтборПоСчетамДУ", 		Истина);
		ИначеЕсли РежимОтбора = 1 Тогда 	
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоВидамДоговоров", "СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ОтборПоВидамДоговоров)");
			Запрос.УстановитьПараметр("ОтборПоВидамДоговоров", 	ОтборВидыДоговоровДУ);
			Запрос.УстановитьПараметр("ОтборПоСчетамДУ", 		Истина);
		ИначеЕсли РежимОтбора = 2 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоСчетамДУ", "СчетаДоверительногоУправления.Ссылка В (&ОтборПоСчетамДУ)");
			Запрос.УстановитьПараметр("ОтборПоСчетамДУ", 		ОтборСчетаДУ);
			Запрос.УстановитьПараметр("ОтборПоВидамДоговоров", 	Истина);
		КонецЕсли; 
		
	ИначеЕсли РежимОтбора = 3 Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
			|	СчетаДоверительногоУправления.Наименование КАК Наименование,
			|	СчетаДоверительногоУправления.Организация КАК Организация,
			|	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
			|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
			|ПОМЕСТИТЬ _СчетаДоверительногоУправленияВрем
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
			|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправления.СчетДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИменованныеОбъекты КАК ИменованныеОбъекты
			|		ПО (&ИсключитьСчетНЕОПРЕДЕЛЕН)
			|			И СчетаДоверительногоУправления.Ссылка = ИменованныеОбъекты.Объект
			|			И (ИменованныеОбъекты.Имя ПОДОБНО ""СчетДУ_Неопределен_%"")
			|ГДЕ
			|	(&Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			|			ИЛИ СчетаДоверительногоУправления.Организация = &Организация)
			|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания
			|	И (СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаНачала
			|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
			|	И ИменованныеОбъекты.Объект ЕСТЬ NULL
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|ПОМЕСТИТЬ _КлиентыДоверительногоУправления
			|ИЗ
			|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаНачала, ) КАК КлиентыДоверительногоУправленияСрезПоследних
			|ГДЕ
			|	КлиентыДоверительногоУправленияСрезПоследних.Клиент В(&ОтборПоКлиентам)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	КлиентыДоверительногоУправления.СчетДоверительногоУправления
			|ИЗ
			|	РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
			|ГДЕ
			|	КлиентыДоверительногоУправления.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
			|	И КлиентыДоверительногоУправления.Клиент В(&ОтборПоКлиентам)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_СчетаДоверительногоУправленияВрем.Ссылка КАК Ссылка,
			|	_СчетаДоверительногоУправленияВрем.Ссылка КАК СчетДоверительногоУправления,
			|	_СчетаДоверительногоУправленияВрем.Организация КАК Организация,
			|	_СчетаДоверительногоУправленияВрем.ДатаРасторжения КАК ДатаРасторжения,
			|	_СчетаДоверительногоУправленияВрем.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
			|ПОМЕСТИТЬ _СчетаДоверительногоУправления
			|ИЗ
			|	_КлиентыДоверительногоУправления КАК _КлиентыДоверительногоУправления
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправленияВрем КАК _СчетаДоверительногоУправленияВрем
			|		ПО _КлиентыДоверительногоУправления.СчетДоверительногоУправления = _СчетаДоверительногоУправленияВрем.Ссылка";
			
		Запрос.УстановитьПараметр("ОтборПоКлиентам", ОтборКлиенты);
		
	ИначеЕсли РежимОтбора = 4 Тогда	

		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ДанныеОтбора.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ДанныеОтбора.Период КАК Период
			|ПОМЕСТИТЬ _ДанныеОтбора
			|ИЗ
			|	&ДанныеОтбора КАК ДанныеОтбора
			|ГДЕ
			|	ДанныеОтбора.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
			|	СчетаДоверительногоУправления.Организация КАК Организация,
			|	_ДанныеОтбора.Период КАК Дата
			|ПОМЕСТИТЬ _ДатыДействияЗаПериод
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеОтбора КАК _ДанныеОтбора
			|		ПО (_ДанныеОтбора.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
			|ГДЕ
			|	(&Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			|			ИЛИ СчетаДоверительногоУправления.Организация = &Организация)
			|	И СчетаДоверительногоУправления.ДатаЗаключения <= _ДанныеОтбора.Период
			|	И (СчетаДоверительногоУправления.ДатаРасторжения >= _ДанныеОтбора.Период
			|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДатыДействияЗаПериод.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ДатыДействияЗаПериод.Организация КАК Организация,
			|	МИНИМУМ(_ДатыДействияЗаПериод.Дата) КАК ДатаНачала,
			|	МАКСИМУМ(_ДатыДействияЗаПериод.Дата) КАК ДатаОкончания
			|ПОМЕСТИТЬ _ГраницыПериодовДоговоров
			|ИЗ
			|	_ДатыДействияЗаПериод КАК _ДатыДействияЗаПериод
			|
			|СГРУППИРОВАТЬ ПО
			|	_ДатыДействияЗаПериод.СчетДоверительногоУправления,
			|	_ДатыДействияЗаПериод.Организация
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НастройкиФормирования.Период КАК Период,
			|	НастройкиФормирования.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ГраницыПериодовДоговоров.ДатаНачала КАК ДатаНачала,
			|	_ГраницыПериодовДоговоров.ДатаОкончания КАК ДатаОкончания
			|ПОМЕСТИТЬ _ВсеНастройки
			|ИЗ
			|	_ГраницыПериодовДоговоров КАК _ГраницыПериодовДоговоров
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиФормированияСЧА КАК НастройкиФормирования
			|		ПО _ГраницыПериодовДоговоров.СчетДоверительногоУправления = НастройкиФормирования.СчетДоверительногоУправления
			|			И (НастройкиФормирования.Период <= _ГраницыПериодовДоговоров.ДатаОкончания)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ВсеНастройки.Период КАК Период,
			|	_ВсеНастройки.СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|ПОМЕСТИТЬ _ПериодичностьНастроекПоСчетамДУ
			|ИЗ
			|	_ВсеНастройки КАК _ВсеНастройки
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеНастройки КАК _ВсеНастройки1
			|		ПО _ВсеНастройки.СчетДоверительногоУправления = _ВсеНастройки1.СчетДоверительногоУправления
			|			И _ВсеНастройки.Период < _ВсеНастройки1.Период
			|
			|СГРУППИРОВАТЬ ПО
			|	_ВсеНастройки.Период,
			|	_ВсеНастройки.СчетДоверительногоУправления,
			|	_ВсеНастройки.ДатаНачала,
			|	_ВсеНастройки.ДатаОкончания
			|
			|ИМЕЮЩИЕ
			|	ЕСТЬNULL(МИНИМУМ(_ВсеНастройки1.Период), _ВсеНастройки.ДатаОкончания) >= _ВсеНастройки.ДатаНачала"
			+ ";
			|";		
			
		Запрос.УстановитьПараметр("ДанныеОтбора", ПолучитьИзВременногоХранилища(АдресРезультатаОтбора));	
		
		ПоместитьДатыДействияЗаПериодВоВременнуюТаблицу = Ложь;
		ДополнитьДокументамиРассчитаннымиЗаПериод		= Ложь;
		
	КонецЕсли; 
	
	Запрос.Выполнить();
		
	Если ПоместитьДатыДействияЗаПериодВоВременнуюТаблицу Тогда
	
		Справочники.НастройкиРегламентныхДействий.ПоместитьДатыДействияЗаПериодВоВременнуюТаблицу(Запрос, Новый Структура("ВидДействия, ДатаС, ДатаПо, ДополнитьРабочимиДнями", "СЧА", Запрос.Параметры.ДатаНачала, Запрос.Параметры.ДатаОкончания, Истина)); 
		
	КонецЕсли;		
	
	#Область Текст_запроса
	
	Запрос.Текст = 
		"
		|////////////////////////////////////////////////////////////////////////////////
		|" + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЕСТЬNULL(_ДатыРасчетаСЧА.Организация, ВложенныйЗапрос.Организация) КАК Организация,
		|	ЕСТЬNULL(_ДатыРасчетаСЧА.СчетДоверительногоУправления, ВложенныйЗапрос.СчетДоверительногоУправления) КАК СчетДоверительногоУправления,
		|	ЕСТЬNULL(_ДатыРасчетаСЧА.Дата, ВложенныйЗапрос.Дата) КАК Дата,
		|	_ДатыРасчетаСЧА.Дата ЕСТЬ НЕ NULL  КАК ДатаРасчетаСЧА,
		|	_ДатыРасчетаСЧА.Дата ЕСТЬ НЕ NULL 
		|		И ВложенныйЗапрос.Дата ЕСТЬ NULL КАК НеРассчитанаСЧА,
		|	ВложенныйЗапрос.РегистрацияСтоимостиАктивов КАК РегистрацияСтоимостиАктивов
		|ПОМЕСТИТЬ _Документы
		|ИЗ
		|	_ДатыДействияЗаПериод КАК _ДатыРасчетаСЧА
		|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			РегистрацияСтоимостиАктивов.Организация КАК Организация,
		|			РегистрацияСтоимостиАктивов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|			НАЧАЛОПЕРИОДА(РегистрацияСтоимостиАктивов.Дата, ДЕНЬ) КАК Дата,
		|			РегистрацияСтоимостиАктивов.Ссылка КАК РегистрацияСтоимостиАктивов
		|		ИЗ
		|			_ГраницыПериодовДоговоров КАК _ГраницыПериодов
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РегистрацияСтоимостиАктивов КАК РегистрацияСтоимостиАктивов
		|				ПО _ГраницыПериодов.Организация = РегистрацияСтоимостиАктивов.Организация
		|					И _ГраницыПериодов.СчетДоверительногоУправления = РегистрацияСтоимостиАктивов.СчетДоверительногоУправления
		|					И (РегистрацияСтоимостиАктивов.Проведен)
		|					И (НАЧАЛОПЕРИОДА(РегистрацияСтоимостиАктивов.Дата, ДЕНЬ) МЕЖДУ _ГраницыПериодов.ДатаНачала И _ГраницыПериодов.ДатаОкончания)) КАК ВложенныйЗапрос
		|		ПО _ДатыРасчетаСЧА.Организация = ВложенныйЗапрос.Организация
		|			И _ДатыРасчетаСЧА.СчетДоверительногоУправления = ВложенныйЗапрос.СчетДоверительногоУправления
		|			И _ДатыРасчетаСЧА.Дата = ВложенныйЗапрос.Дата
		|ГДЕ
		|	(&ДополнитьДокументамиРассчитаннымиЗаПериод
		|			ИЛИ _ДатыРасчетаСЧА.Дата ЕСТЬ НЕ NULL )
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕСТЬNULL(_ДатыРасчетаСЧА.Организация, ВложенныйЗапрос.Организация),
		|	ЕСТЬNULL(_ДатыРасчетаСЧА.СчетДоверительногоУправления, ВложенныйЗапрос.СчетДоверительногоУправления),
		|	ЕСТЬNULL(_ДатыРасчетаСЧА.Дата, ВложенныйЗапрос.Дата),
		|	_ДатыРасчетаСЧА.Дата ЕСТЬ НЕ NULL ,
		|	_ДатыРасчетаСЧА.Дата ЕСТЬ НЕ NULL 
		|		И ВложенныйЗапрос.Дата ЕСТЬ NULL,
		|	ВложенныйЗапрос.РегистрацияСтоимостиАктивов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Документы.Организация КАК Организация,
		|	_Документы.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Документы.Дата КАК Дата,
		|	_Документы.ДатаРасчетаСЧА КАК ДатаРасчетаСЧА,
		|	_Документы.НеРассчитанаСЧА КАК НеРассчитанаСЧА,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _НастройкиФормированияСЧА.Период) = 0 КАК НеЗаданыНастройки,
		|	_Документы.РегистрацияСтоимостиАктивов КАК РегистрацияСтоимостиАктивов,
		|	"""" КАК Статус
		|ИЗ
		|	_Документы КАК _Документы
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПериодичностьНастроекПоСчетамДУ КАК _НастройкиФормированияСЧА
		|		ПО _Документы.СчетДоверительногоУправления = _НастройкиФормированияСЧА.СчетДоверительногоУправления
		|			И _Документы.Дата >= _НастройкиФормированияСЧА.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	_Документы.Дата,
		|	_Документы.РегистрацияСтоимостиАктивов,
		|	_Документы.НеРассчитанаСЧА,
		|	_Документы.Организация,
		|	_Документы.СчетДоверительногоУправления,
		|	_Документы.ДатаРасчетаСЧА";	
	
	#КонецОбласти 
	
	Запрос.УстановитьПараметр("ДополнитьДокументамиРассчитаннымиЗаПериод", ДополнитьДокументамиРассчитаннымиЗаПериод);	
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
 
