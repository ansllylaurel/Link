#Область Обработчики_фоновых_заданий

Функция ПроверитьТаблицу(Параметры, АдресХранилища) Экспорт

	ТаблицаДляПроверки = Параметры.ТаблицаДляПроверки;
	ТаблицаДляПроверки.Колонки.Добавить("ИдентификаторЗадания", Новый ОписаниеТипов("УникальныйИдентификатор"));	
	
	СоответствиеАдресов = Новый Соответствие;
	МассивУИДовЗаданий = Новый Массив;
	
	Для каждого ТекСтрока Из ТаблицаДляПроверки Цикл
	
		ПроверитьКоличествоАктивныхЗаданий(Параметры.ИмяПодчиненныхЗаданий, Параметры.КоличествоПараллельныхСеансов, 1);
		
		НовыйАдрес = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
		
		ПараметрыМетода = Новый Массив;
		ПараметрыМетода.Добавить(Новый Структура("Организация, СчетДоверительногоУправления, Период, ИднетификаторРезультата", ТекСтрока.Организация, ТекСтрока.СчетДоверительногоУправления, ТекСтрока.Дата, ТекСтрока.ИднетификаторРезультата));
		ПараметрыМетода.Добавить(НовыйАдрес);
		
		ПараметрыЗадания = Новый Массив;
		ПараметрыЗадания.Добавить("Обработки.КонтрольСЧА.ВыполнитьПроверкуВФоне");
		ПараметрыЗадания.Добавить(ПараметрыМетода);
		
		ФоновоеЗадание = ФоновыеЗадания.Выполнить("СистемныеФункции.ВыполнитьМетодКонфигурации", ПараметрыЗадания,, Параметры.ИмяПодчиненныхЗаданий);
		ТекСтрока.ИдентификаторЗадания = ФоновоеЗадание.УникальныйИдентификатор;
			
	КонецЦикла;
	
	ПроверитьКоличествоАктивныхЗаданий(Параметры.ИмяПодчиненныхЗаданий, 1, 1);
	
	ТекстОшибки = Строка(СостояниеФоновогоЗадания.ЗавершеноАварийно);
	
	Для каждого ТекСтрока Из ТаблицаДляПроверки Цикл
		
		ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ТекСтрока.ИдентификаторЗадания);
		
		Если ФоновоеЗадание = Неопределено Тогда
			
			// так бывает при переполнении истории фоновых заданий
			Запись = РегистрыСведений.ХранилищеЗначений.СоздатьМенеджерЗаписи();
			Запись.Идентификатор = ТекСтрока.ИднетификаторРезультата;
			Запись.Прочитать();
			Если Запись.Выбран() Тогда
				// все ОК, задание отработало и сохранило результат
			Иначе
				// записи нет. Вероятно, задание завершено с ошибкой
				Запись.ХранилищеЗначения 			= Новый ХранилищеЗначения(ТекстОшибки, Новый СжатиеДанных(9));
				Запись.Источник 					= "КонтрольСЧА";
				Запись.Организация	 				= ТекСтрока.Организация;
				Запись.СчетДоверительногоУправления	= ТекСтрока.СчетДоверительногоУправления;
				Запись.Ответственный				= РаботаСПользователями.ТекущийПользователь();
				Запись.Записать();
			КонецЕсли; 
		
		ИначеЕсли ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
		
			Запись = РегистрыСведений.ХранилищеЗначений.СоздатьМенеджерЗаписи();
			Запись.Идентификатор	 			= ТекСтрока.ИднетификаторРезультата;
			Запись.ХранилищеЗначения 			= Новый ХранилищеЗначения(ТекстОшибки, Новый СжатиеДанных(9));
			Запись.Источник 					= "КонтрольСЧА";
			Запись.Организация	 				= ТекСтрока.Организация;
			Запись.СчетДоверительногоУправления	= ТекСтрока.СчетДоверительногоУправления;
			Запись.Ответственный				= РаботаСПользователями.ТекущийПользователь();
			Запись.Записать();
		
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции
 
Функция ВыполнитьПроверку(Параметры) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ВидДоговора", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления"));
	
	Отказ = Ложь;
	
	Организация 					= Параметры.Организация;
	СчетДоверительногоУправления 	= Параметры.СчетДоверительногоУправления;
	Период 							= Параметры.Период;
	
	РеквизитыКонтроля = Неопределено;
	Параметры.Свойство("РеквизитыКонтроля", РеквизитыКонтроля); // если свойство есть - пришли сюда из формы документа РСА
	
	ПараметрыРасчета = СформироватьСтруктуруПараметровРасчета(СчетДоверительногоУправления, Период);
	
	Если ТипЗнч(ПараметрыРасчета) = Тип("Структура") Тогда
		
		Если РеквизитыКонтроля = Неопределено Тогда
			МассивСообщений = ПолучитьСообщенияПользователю(Истина);
		КонецЕсли;
		
		РегистрацияСтоимостиАктивов = Неопределено;
		
		УстановитьПривилегированныйРежим(Истина);	
		
		РегистрацияСтоимостиАктивов = Документы.РегистрацияСтоимостиАктивов.СоздатьДокумент();				
		РегистрацияСтоимостиАктивов.Дата                         	= КонецДня(Период);
		РегистрацияСтоимостиАктивов.Организация                  	= Организация;
		РегистрацияСтоимостиАктивов.Ответственный                	= РаботаСПользователями.ТекущийПользователь();
		РегистрацияСтоимостиАктивов.СчетДоверительногоУправления 	= СчетДоверительногоУправления;
		РегистрацияСтоимостиАктивов.ЦельРасчетаСтоимостиОценки 		= ПараметрыРасчета.ЦельРасчета;				

		РегистрацияСтоимостиАктивов.ЗаполнитьДокументыРегистрацииСтоимости(ПараметрыРасчета, Ложь, Отказ);
		
		ФинансовыеПоказателиДоходности = РегистрыСведений.ФинансовыеПоказатели.СоздатьНаборЗаписей().Выгрузить();
		
		Если СчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> Перечисления.ВидыДоговоровДоверительногоУправления.Собственный
		   И Документы.РегистрацияСтоимостиАктивов.ТребуетсяРегистрацияФинансовыхПоказателейДоходности(РегистрацияСтоимостиАктивов.Организация, РегистрацияСтоимостиАктивов.Дата) Тогда
			РегистрацияСтоимостиАктивов.РассчитатьФинансовыеПоказателиДоходности(ФинансовыеПоказателиДоходности, Отказ);
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Ложь);			
		
		Если Отказ Тогда
			
			Если РеквизитыКонтроля = Неопределено Тогда
				МассивСообщений = ПолучитьСообщенияПользователю(Истина);
				ТекстСообщения = "";
				Для каждого Сообщение Из МассивСообщений Цикл
					ТекстСообщения = ТекстСообщения + Символы.ПС + Сообщение.Текст;
				КонецЦикла; 
			КонецЕсли;
			Результат.Вставить("ТекстОшибки", "Не удалось получить расчетные данные для выполнения контроля. Система сообщает:" + ТекстСообщения);
			
		Иначе
			
			Если РеквизитыКонтроля = Неопределено Тогда
				ПолучитьСообщенияПользователю(Истина);
				Для каждого Сообщение Из МассивСообщений Цикл
					Сообщение.Сообщить();
				КонецЦикла; 
			КонецЕсли; 
			
			СтоимостиАктивов = РегистрацияСтоимостиАктивов.АктивыНеОтносящиесяКЦеннымБумагам.Выгрузить();
			СтоимостиАктивов.Свернуть("ВидАктива, СубъектАналитики, Контрагент, Основание, ВидЗадолженности, ВалютаСтроки", "СуммаРынокВВалютеУчета, СуммаРезерваВВалютеУчета");
			
			ДанныеДокумента = Новый Структура("Организация, СчетДоверительногоУправления, СЧАРынок, РСА, СтоимостьПая");
			ЗаполнитьЗначенияСвойств(ДанныеДокумента, РегистрацияСтоимостиАктивов);			
			ДанныеДокумента.Вставить("Период", 						Параметры.Период);
			ДанныеДокумента.Вставить("СтоимостиПереоценки", 		РегистрацияСтоимостиАктивов.ДополнительныеСвойства.РегистрацияСтоимости.СтоимостиПереоценки.Выгрузить());
			ДанныеДокумента.Вставить("СтоимостиПрочихЦенныхБумаг", 	РегистрацияСтоимостиАктивов.ДополнительныеСвойства.РегистрацияСтоимости.СтоимостиПрочихЦенныхБумаг.Выгрузить());
			ДанныеДокумента.Вставить("СтоимостиАктивов", 			СтоимостиАктивов);
			ДанныеДокумента.Вставить("ФинансовыеПоказателиДоходности", ФинансовыеПоказателиДоходности);
			
			СравнитьДанныеДокументаСРегистром(Результат, ДанныеДокумента, РеквизитыКонтроля);		
			
		КонецЕсли; 
					
	Иначе
		Результат.Вставить("ТекстОшибки", ПараметрыРасчета);
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Процедура ВыполнитьПроверкуВФоне(Параметры, АдресХранилища) Экспорт

	Попытка
		Результат = ВыполнитьПроверку(Параметры);
	Исключение
		Результат = Новый Структура("ТекстОшибки", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Запись = РегистрыСведений.ХранилищеЗначений.СоздатьМенеджерЗаписи();
	Запись.Идентификатор	 			= Параметры.ИднетификаторРезультата;
	Запись.ХранилищеЗначения 			= Новый ХранилищеЗначения(Результат, Новый СжатиеДанных(9));
	Запись.Источник 					= "КонтрольСЧА";
	Запись.Организация	 				= Параметры.Организация;
	Запись.СчетДоверительногоУправления	= Параметры.СчетДоверительногоУправления;
	Запись.Ответственный				= РаботаСПользователями.ТекущийПользователь();
	Запись.Записать();

КонецПроцедуры

#КонецОбласти 

Процедура СравнитьДанныеДокументаСРегистром(Результат, ДанныеДокумента, РеквизитыКонтроля)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СтоимостиПереоценки", 			ДанныеДокумента.СтоимостиПереоценки);
	Запрос.УстановитьПараметр("СтоимостиПрочихЦенныхБумаг", 	ДанныеДокумента.СтоимостиПрочихЦенныхБумаг);
	Запрос.УстановитьПараметр("СтоимостиАктивов", 				ДанныеДокумента.СтоимостиАктивов);
	
	Запрос.УстановитьПараметр("СЧА_Расчетная", 					ДанныеДокумента.СЧАРынок);
	Запрос.УстановитьПараметр("РСА_Расчетная", 					ДанныеДокумента.РСА);
	Запрос.УстановитьПараметр("СтоимостьПая_Расчетная", 		ДанныеДокумента.СтоимостьПая);
	
	Запрос.УстановитьПараметр("Период", 						ДанныеДокумента.Период);
	Запрос.УстановитьПараметр("Организация", 					ДанныеДокумента.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ДанныеДокумента.СчетДоверительногоУправления);
	
	Запрос.УстановитьПараметр("ФинансовыеПоказателиДоходности", ДанныеДокумента.ФинансовыеПоказателиДоходности);
	
	#Область ТекстЗапроса
	
	Если РеквизитыКонтроля = Неопределено Тогда
		
		#Область Получение_данных_из_регистра
		// обычный контроль СЧА
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостиАктивов.ВидАктива КАК ВидАктива,
			|	СтоимостиАктивов.СубъектАналитики КАК СубъектАналитики,
			|	СтоимостиАктивов.Контрагент КАК Контрагент,
			|	СтоимостиАктивов.Основание КАК Основание,
			|	СтоимостиАктивов.ВидЗадолженности КАК ВидЗадолженности,
			|	СтоимостиАктивов.Валюта КАК Валюта,
			|	СтоимостиАктивов.СуммаРынокВВалютеУчета КАК СуммаРынокВВалютеУчета,
			|	СтоимостиАктивов.СуммаРезерваВВалютеУчета КАК СуммаРезерваВВалютеУчета 
			|ПОМЕСТИТЬ _СтоимостьАктивовНеЦБПоДаннымУчета
			|ИЗ
			|	РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостиАктивов
			|ГДЕ
			|	СтоимостиАктивов.Период = &Период
			|	И СтоимостиАктивов.Организация = &Организация
			|	И СтоимостиАктивов.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьПереоценки.Рынок КАК Рынок,
			|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СтоимостьПереоценки.Партия КАК Партия,
			|	СтоимостьПереоценки.СтрокаПартии КАК СтрокаПартии,
			|	СтоимостьПереоценки.Цена КАК Цена,
			|	СтоимостьПереоценки.ЦенаКупона КАК ЦенаКупона,
			|	СтоимостьПереоценки.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
			|	СтоимостьПереоценки.СуммаКупонаВВалютеУчета КАК СуммаКупонаВВалютеУчета,
			|	СтоимостьПереоценки.ВидЦены КАК ВидЦены,
			|	СтоимостьПереоценки.УровеньОценки КАК УровеньОценки,
			|	СтоимостьПереоценки.ДатаЦены КАК ДатаЦены,
			|	СтоимостьПереоценки.Источник КАК Источник
			|ПОМЕСТИТЬ _СтоимостьПереоценкиПоДаннымУчета
			|ИЗ
			|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
			|ГДЕ
			|	СтоимостьПереоценки.Период = &Период
			|	И СтоимостьПереоценки.Организация = &Организация
			|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьПереоценки.Рынок КАК Рынок,
			|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СтоимостьПереоценки.Партия КАК Партия,
			|	СтоимостьПереоценки.СтрокаПартии КАК СтрокаПартии,
			|	СтоимостьПереоценки.Цена КАК Цена,
			|	СтоимостьПереоценки.ЦенаКупона КАК ЦенаКупона,
			|	СтоимостьПереоценки.ВидЦены КАК ВидЦены,
			|	СтоимостьПереоценки.УровеньОценки КАК УровеньОценки,
			|	СтоимостьПереоценки.ДатаЦены КАК ДатаЦены,
			|	СтоимостьПереоценки.Источник КАК Источник
			|ПОМЕСТИТЬ _СтоимостьПрочихЦенныхБумагПоДаннымУчета
			|ИЗ
			|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
			|ГДЕ
			|	СтоимостьПереоценки.Период = &Период
			|	И СтоимостьПереоценки.Организация = &Организация
			|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.КонтрольИнвестиционнойДекларации)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ФинансовыеПоказатели.ВидПоказателя КАК ВидПоказателя,
			|	ФинансовыеПоказатели.Значение КАК Значение,
			|	ЕСТЬNULL(ВЫРАЗИТЬ(ФинансовыеПоказатели.Регистратор КАК Документ.РегистрацияСтоимостиАктивов).РучнойВвод, ИСТИНА) КАК РучнойВвод
			|ПОМЕСТИТЬ _ФинансовыеПоказателиПоДаннымУчета
			|ИЗ
			|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
			|ГДЕ
			|	ФинансовыеПоказатели.Период = &Период
			|	И ФинансовыеПоказатели.Организация = &Организация
			|	И ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
			|	И ФинансовыеПоказатели.ВидПоказателя В (ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок), ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.РыночнаяСтоимостьАктивов), ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьПая))
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
