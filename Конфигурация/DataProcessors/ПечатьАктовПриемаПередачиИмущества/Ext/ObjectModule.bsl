
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
		
	Если ЗначениеЗаполнено(ЭтотОбъект.Документ) Тогда
		
		// Проверка корректности документа
		
		Если Не ПроверитьВозможностьПечатиДокумента(Отказ) Тогда
			Возврат;
		КонецЕсли;
		
	Иначе	
		
		ТекстСообщения = "";
		
		Если Не ОбщегоНазначенияКлиентСервер.ПериодЗаполненКорректно(ЭтотОбъект.Период, , , ТекстСообщения) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, "Период", , Отказ); 	
		КонецЕсли;
		
		ПроверяемыеРеквизиты.Добавить("СчетДоверительногоУправления");
		
	КонецЕсли;
	
	// Проверка корректности варианта макета
	
	Если ЗначениеЗаполнено(ЭтотОбъект.Вариант) И Не ПроверитьДоступностьВарианта(Отказ) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьВозможностьПечатиДокумента(Отказ) Экспорт	
	
	РезультатПроверки = Истина;
	
	Если ТипЗнч(ЭтотОбъект.Документ) = Тип("ДокументСсылка.ВыводДенежныхСредств") И ТипЗнч(ЭтотОбъект.Документ.Основание) <> Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств") Тогда
		
		РезультатПроверки = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Печать акта не возможна, т.к. основание вывода д/с не является поручением на вывод д/с.", , , , Отказ);
		
	ИначеЕсли ТипЗнч(ЭтотОбъект.Документ) = Тип("ДокументСсылка.ВыводДенежныхСредств") И Не ЗначениеЗаполнено(ЭтотОбъект.Документ.Основание) Тогда
		
		РезультатПроверки = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Печать акта не возможна, т.к. не указано поручение на вывод д/с.", , , , Отказ);
		
	КонецЕсли;
		
	Возврат РезультатПроверки;
	
КонецФункции

Функция ПроверитьДоступностьВарианта(Отказ) Экспорт	
	
	РезультатПроверки = Истина;
	
	Макет = ЭтотОбъект.Метаданные().Макеты.Найти(ЭтотОбъект.Вариант);
	
	Если Макет = Неопределено Тогда
		
		РезультатПроверки = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Неизвестный вариант макета '%1'.", ЭтотОбъект.Вариант), , , , Отказ);
		
	Иначе
		
		ДоступныеМакеты = Обработки.ПечатьАктовПриемаПередачиИмущества.ДоступныеМакеты(ЭтотОбъект.Документ, ЭтотОбъект.СчетДоверительногоУправления);
		
		Если ДоступныеМакеты.НайтиПоЗначению(Макет.Имя) = Неопределено Тогда
		
			РезультатПроверки = Ложь;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Вариант макета '%1' не доступен для выбранных реквизитов.", Макет.Синоним), , , , Отказ);
		
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатПроверки;
	
КонецФункции
