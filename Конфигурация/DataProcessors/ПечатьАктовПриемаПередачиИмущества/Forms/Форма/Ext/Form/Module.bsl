&НаКлиенте
Процедура БанковскийСчетПолучателяНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
			
	Если ПереводВнутриУК Тогда
		Период = ?(ФормированиеПоДокументу, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Документ, "Дата"), Объект.Период.ДатаОкончания);
		ПараметрыФормыВыбора = Новый Структура("Период, Организация, Клиент",
			Период, 
			Объект.Организация, 
			ПолучитьФондПоСчетуДоверительногоУправления(Объект.СчетДоверительногоУправления, Период));
			 		
		РезультатВыбора = ОткрытьФормуМодально("Справочник.БанковскиеСчета.Форма.ФормаВыбораДляПереводовМеждуПортфелями", ПараметрыФормыВыбора, ЭтаФорма);
		
		Если РезультатВыбора <> Неопределено Тогда
			БанковскийСчетПолучателя 				= РезультатВыбора.РасчетныйСчет;
			ДоговорПолучателяПриПереводеВнутриУК 	= РезультатВыбора.НомерДоговора + " от " + Формат(РезультатВыбора.ДатаЗаключения, "ДФ='dd.MM.yyyy ''г.'''")
		КонецЕсли;
		
	Иначе
		ПараметрыФормыВыбора = Новый Структура("Организация, ЮрФизЛицо, ТолькоСчетаКлиента",
			Объект.Организация, Получатель, Ложь);
			 		
		ВыбранноеЗначение = ОткрытьФормуМодально("Справочник.БанковскиеСчета.Форма.ФормаВыбораСчетаКлиента", ПараметрыФормыВыбора, ЭтаФорма);
		
		Если ВыбранноеЗначение <> Неопределено Тогда
			БанковскийСчетПолучателя = ВыбранноеЗначение;
		КонецЕсли;
	
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура БанковскийСчетОтправителяНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Период = ?(ФормированиеПоДокументу, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Документ, "Дата"), Объект.Период.ДатаОкончания);
	ПараметрыФормыВыбора = Новый Структура("Период, Организация, ИсполнителиБрокерские, СчетДоверительногоУправления",
		Период, Объект.Организация, Ложь, Объект.СчетДоверительногоУправления);
			
	ВыбранноеЗначение = ОткрытьФормуМодально("Справочник.БанковскиеСчета.Форма.ФормаВыбораИзИсполнителей", ПараметрыФормыВыбора, ЭтаФорма);
	
	Если ВыбранноеЗначение <> Неопределено Тогда
		БанковскийСчетОтправителя = ВыбранноеЗначение;		
	КонецЕсли;                                        
		
КонецПроцедуры

&НаКлиенте
Процедура БанковскийСчетФондаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Период = ?(ФормированиеПоДокументу, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Документ, "Дата"), Объект.Период.ДатаОкончания);
	ПараметрыФормыВыбора = Новый Структура("Организация, ЮрФизЛицо, ТолькоСчетаКлиента",
			Объект.Организация, ПолучитьФондПоСчетуДоверительногоУправления(Объект.СчетДоверительногоУправления, Период), Истина);
			
	ВыбранноеЗначение = ОткрытьФормуМодально("Справочник.БанковскиеСчета.Форма.ФормаВыбораСчетаКлиента", ПараметрыФормыВыбора, ЭтаФорма);
	
	Если ВыбранноеЗначение <> Неопределено Тогда
		БанковскийСчетФонда = ВыбранноеЗначение;		
	КонецЕсли;                                        
		
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументовПриИзменении(Элемент)
		
	Объект.Документ = ?(СписокДокументов.Количество() > 0, СписокДокументов[0].Значение, Неопределено);
	
	УстановитьПараметрыВыбораДокументов(ЭтаФорма);
	
КонецПроцедуры

