#КонецОбласти

#Область Формирование_акта

&НаСервере
Процедура СформироватьАкт()

	ЭтаФорма.ТабличныйДокумент.Очистить();
	ЭтаФорма.ТабличныйДокумент.КлючПараметровПечати	= "";
	
	// Формируем структуры выбранных пользователем данных получателя / отправителя / собственника
	
	ДанныеПолучателя = Новый Структура;
	ДанныеПолучателя.Вставить("ЮрФизЛицо",		Получатель);
	ДанныеПолучателя.Вставить("БанковскийСчет",	БанковскийСчетПолучателя);
	
	ДанныеОтправителя = Новый Структура;
	ДанныеОтправителя.Вставить("ЮрФизЛицо",				Отправитель);
	ДанныеОтправителя.Вставить("БанковскийСчет",		БанковскийСчетОтправителя);
	ДанныеОтправителя.Вставить("ДанныеКонтактногоЛица",	СтруктураДанныхКонтактногоЛицаУК1);
	
	ДанныеСобственника = Новый Структура;
	ДанныеСобственника.Вставить("ЮрФизЛицо",				Фонд);
	ДанныеСобственника.Вставить("БанковскийСчет",			БанковскийСчетФонда);
	ДанныеСобственника.Вставить("ДанныеКонтактногоЛица",	СтруктураДанныхКонтактногоЛицаФонда);
	
	// Определяем макет и заполняем акт
	
	Если Объект.Вариант = "Макет_Период" Тогда
		
		СформироватьАктПриемаПередачиЗаПериод(Объект.СчетДоверительногоУправления, Объект.Период, ЭтаФорма.ТабличныйДокумент, Объект.Вариант, ДанныеОтправителя, ДанныеСобственника);	
		
	ИначеЕсли Объект.Вариант = "Макет_ЦБ" Тогда
		
		СформироватьАктПриемаПередачиЦенныхБумаг(Объект.Документ, ЭтаФорма.ТабличныйДокумент, Объект.Вариант);
		
	ИначеЕсли Объект.Вариант = "Макет_ДС" ИЛИ Объект.Вариант = "Макет_ДС_ПР" Тогда
		
		СформироватьАктПриемаПередачиДенежныхСредств(Объект.Документ, ЭтаФорма.ТабличныйДокумент, Объект.Вариант);
		
	ИначеЕсли Объект.Вариант = "Макет_ДС_2021" Тогда
		
		СформироватьАктПриемаПередачиДенежныхСредств2021(Объект.Документ, ЭтаФорма.ТабличныйДокумент, Объект.Вариант, ДанныеОтправителя, ДанныеПолучателя, ДанныеСобственника, ПереводВнутриУК);
		
	ИначеЕсли Объект.Вариант = "Макет_Общий_Будущее" Тогда	
		
		СформироватьАктПриемаПередачиИмущества_Будущее(СписокДокументов.ВыгрузитьЗначения(), ЭтаФорма.ТабличныйДокумент, Объект.Вариант, ДанныеОтправителя, ДанныеПолучателя, ДанныеСобственника, ПереводВнутриУК, ДоговорПолучателяПриПереводеВнутриУК);
		
	ИначеЕсли Объект.Вариант = "Макет_Общий_Эволюция" Тогда	
		
		СформироватьАктПриемаПередачиИмущества_Эволюция(Объект.Документ, ЭтаФорма.ТабличныйДокумент, Объект.Вариант, ДанныеОтправителя, ДанныеПолучателя, ДанныеСобственника, ПереводВнутриУК);
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Вариант акта '%1' не реализован", Объект.Вариант));
		Возврат;
		
	КонецЕсли;
	
	// Заполняем настройки печати по умолчанию
	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ЭтаФорма.ТабличныйДокумент, "АктПриемаПередачиИмущества." + Объект.Вариант, Ложь, ОриентацияСтраницы.Портрет);
	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(ЭтаФорма.Элементы.ТабличныйДокумент, "НЕИСПОЛЬЗОВАТЬ"); 		
	
КонецПроцедуры

&НаСервере
Процедура СформироватьАктПриемаПередачиЦенныхБумаг(Документ, ТабличныйДокумент, ИмяМакета)

	РеквизитыАкта = Новый Структура;
	
	// Инициализация вспомогательных переменных
	СчетДоверительногоУправления	= Документ.СчетДоверительногоУправления;
	СпециализированныйДепозитарий	= СчетДоверительногоУправления.СпециализированныйДепозитарий;	
	НомерАкта						= "";	
	ДатаСоставления					= ТекущаяДата();

	Макет = Обработки.ПечатьАктовПриемаПередачиИмущества.ПолучитьМакет(ИмяМакета);	
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	// Управляющая компания, получившая имущество
	РеквизитыПолучателя = ПолучитьРеквизитыПолучателя(Документ.Организация, Получатель, Документ.Дата, БанковскийСчетПолучателя, ПереводВнутриУК);	
	ОбластьШапка.Параметры.НаименованиеПолучателя	= РеквизитыПолучателя.Наименование;
	ОбластьШапка.Параметры.РеквизитыПолучателя		= РеквизитыПолучателя.Реквизиты;
	ОбластьШапка.Параметры.ОКУДПолучателя			= РеквизитыПолучателя.ОКУД;
	ОбластьШапка.Параметры.ОКПОПолучателя			= РеквизитыПолучателя.ОКПО;
	
	// Управляющая компания, передавшая имущество
	РеквизитыОтправителя = ПолучитьРеквизитыОтправителя(Документ.Организация, Документ.СчетДоверительногоУправления, Документ.Дата, БанковскийСчетОтправителя);	
	ОбластьШапка.Параметры.НаименованиеОтправителя	= РеквизитыОтправителя.Наименование;
	ОбластьШапка.Параметры.РеквизитыОтправителя		= РеквизитыОтправителя.Реквизиты;
	ОбластьШапка.Параметры.ОКУДОтправителя			= РеквизитыОтправителя.ОКУД;
	ОбластьШапка.Параметры.ОКПООтправителя			= РеквизитыОтправителя.ОКПО;
	
	// Собственник имущества
	РеквизитыФонда = ПолучитьРеквизитыСобственникаИмущества(Документ.Организация, Документ.СчетДоверительногоУправления, Документ.Дата, БанковскийСчетФонда);
	ОбластьШапка.Параметры.НаименованиеСобственникаИмущества	= РеквизитыФонда.Наименование;
	ОбластьШапка.Параметры.РеквизитыСобственникаИмущества		= РеквизитыФонда.Реквизиты;	
	ОбластьШапка.Параметры.ОКУДСобственникаИмущества			= РеквизитыФонда.ОКУД;
	ОбластьШапка.Параметры.ОКПОСобственникаИмущества			= РеквизитыФонда.ОКПО;
	
	// Договор + требование
	ОбластьШапка.Параметры.ДоговорОснование		= "Договор № " + СчетДоверительногоУправления.НомерДоговора + " от " + Формат(СчетДоверительногоУправления.ДатаЗаключения, "ДФ=dd.MM.yyyy") + "г.";
	ОбластьШапка.Параметры.ТребованиеОснование	= "";
	
	// Акт приема-передачи
	ОбластьШапка.Параметры.НомерАкта		= НомерАкта;
	ОбластьШапка.Параметры.ДатаСоставления	= ДатаСоставления;
	ОбластьШапка.Параметры.МестоСоставления	= "г. Москва";
			
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	// Ценные бумаги
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	ВыводЦенныхБумаг.Дата КАК Дата
	                      |ПОМЕСТИТЬ _ДанныеДокумента
	                      |ИЗ
	                      |	Документ.ВыводЦенныхБумаг КАК ВыводЦенныхБумаг
	                      |ГДЕ
	                      |	ВыводЦенныхБумаг.Ссылка = &Регистратор
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
	                      |	СУММА(ЦенныеБумаги.Количество) КАК Количество,
	                      |	СУММА(ЦенныеБумаги.СуммаРынокВВалютеУчета) КАК РыночнаяСтоимостьБезНКД,
	                      |	СУММА(ЦенныеБумаги.СуммаКупонаРынокВВалютеУчета) КАК РыночнаяСтоимостьНКД
	                      |ПОМЕСТИТЬ _РыночнаяСтоимостьАктивов
	                      |ИЗ
	                      |	Документ.ВыводЦенныхБумаг.ЦенныеБумаги КАК ЦенныеБумаги
	                      |ГДЕ
	                      |	ЦенныеБумаги.Ссылка = &Регистратор
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ЦенныеБумаги.ЦеннаяБумага
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
	                      |	СУММА(БухПартииЦенныхБумаг.Количество) КАК Количество,
	                      |	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета + БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета + БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета + БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета + БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета - БухПартииЦенныхБумаг.СуммаРезервовПодОбесценение) КАК БалансоваяСтоимостьБезНКД,
	                      |	СУММА(БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета) КАК БалансоваяСтоимостьНКДУплаченный,
	                      |	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета) КАК БалансоваяСтоимостьНКДНачисленный
	                      |ПОМЕСТИТЬ _БалансоваяСтоимостьАктивов
	                      |ИЗ
	                      |	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
	                      |ГДЕ
	                      |	БухПартииЦенныхБумаг.Регистратор = &Регистратор
	                      |	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
	                      |	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	БухПартииЦенныхБумаг.ЦеннаяБумага
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	_ДанныеДокумента.Дата КАК ДатаПоступления,
	                      |	ЕСТЬNULL(_РыночнаяСтоимостьАктивов.ЦеннаяБумага, _БалансоваяСтоимостьАктивов.ЦеннаяБумага) КАК ЦеннаяБумага,
	                      |	ЕСТЬNULL(_РыночнаяСтоимостьАктивов.Количество, _БалансоваяСтоимостьАктивов.Количество) КАК Количество,
	                      |	ЕСТЬNULL(_РыночнаяСтоимостьАктивов.РыночнаяСтоимостьБезНКД, 0) КАК РыночнаяСтоимостьБезНКД,
	                      |	ЕСТЬNULL(_РыночнаяСтоимостьАктивов.РыночнаяСтоимостьНКД, 0) КАК НКДРынок,
	                      |	ЕСТЬNULL(_БалансоваяСтоимостьАктивов.БалансоваяСтоимостьБезНКД, 0) КАК БалансоваяСтоимостьБезНКД,
	                      |	ЕСТЬNULL(_БалансоваяСтоимостьАктивов.БалансоваяСтоимостьНКДУплаченный, 0) КАК НКДУплаченный,
	                      |	ЕСТЬNULL(_БалансоваяСтоимостьАктивов.БалансоваяСтоимостьНКДНачисленный, 0) КАК НКДНачисленный
	                      |ПОМЕСТИТЬ _ИтоговаяТаблица
	                      |ИЗ
	                      |	_РыночнаяСтоимостьАктивов КАК _РыночнаяСтоимостьАктивов
	                      |		ПОЛНОЕ СОЕДИНЕНИЕ _БалансоваяСтоимостьАктивов КАК _БалансоваяСтоимостьАктивов
	                      |		ПО (_БалансоваяСтоимостьАктивов.ЦеннаяБумага = _РыночнаяСтоимостьАктивов.ЦеннаяБумага),
	                      |	_ДанныеДокумента КАК _ДанныеДокумента
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	_ИтоговаяТаблица.ДатаПоступления КАК ДатаПоступления,
	                      |	_ИтоговаяТаблица.ЦеннаяБумага КАК ЦеннаяБумага,
	                      |	ВЫБОР
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Паи
	                      |			ТОГДА ""Пай""
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Акции
	                      |			ТОГДА ""Акция""
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Векселя
	                      |			ТОГДА ""Вексель""
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
	                      |			ТОГДА ""Депозитарная расписка""
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Доли
	                      |			ТОГДА ""Доля""
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
	                      |			ТОГДА ""Ипотечный сертификат участия""
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	                      |			ТОГДА ""Облигация""
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Закладные
	                      |			ТОГДА ""Закладная""
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.ПроизводныеФинансовыеИнструменты
						  |				ТОГДА ВЫБОР КОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Фьючерс) 
	                      |								ТОГДА ""Фьючерс""
						  |							КОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Опцион)
						  |								ТОГДА ""Опцион""
                          |							КОНЕЦ
						  |		ИНАЧЕ """"
	                      |	КОНЕЦ + ВЫБОР
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Паи
	                      |			ТОГДА "", "" + РеквизитыПИФСрезПоследних.КраткоеНаименованиеФонда
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Акции
	                      |			ТОГДА "", "" + ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Акции).Эмитент.Наименование)
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Векселя
	                      |			ТОГДА "", "" + ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.Наименование)
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
	                      |			ТОГДА "", "" + ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.Наименование)
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Доли
	                      |			ТОГДА "", "" + ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Доли).ЮрЛицо.Наименование)
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
	                      |			ТОГДА "", "" + ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.Наименование)
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	                      |			ТОГДА "", "" + ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.Наименование)
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Закладные
	                      |			ТОГДА "", "" + ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Закладные).Банк.Наименование)
	                      |		ИНАЧЕ """"
	                      |	КОНЕЦ + ВЫБОР
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Акции
	                      |				И ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер <> """"
	                      |			ТОГДА "", "" + ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
	                      |				И ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ГосударственныйРегистрационныйНомер <> """"
	                      |			ТОГДА "", "" + ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ГосударственныйРегистрационныйНомер
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	                      |				И ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер <> """"
	                      |			ТОГДА "", "" + ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Паи
	                      |				И ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер <> """"
	                      |			ТОГДА "", "" + ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Векселя
	                      |				И ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Векселя).Номер <> """"
	                      |			ТОГДА "", "" + ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Векселя).Номер
	                      |		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
	                      |				И ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).РегистрационныйНомер <> """"
	                      |			ТОГДА "", "" + ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).РегистрационныйНомер
	                      |		ИНАЧЕ "", "" + ЕСТЬNULL(КодыВТорговыхСистемахISIN.Код, КодыВТорговыхСистемахКодНаММВБ.Код)
	                      |	КОНЕЦ КАК НаименованиеЦБ,
	                      |	_ИтоговаяТаблица.Количество КАК Количество,
	                      |	_ИтоговаяТаблица.РыночнаяСтоимостьБезНКД КАК РыночнаяСтоимостьБезНКД,
	                      |	_ИтоговаяТаблица.НКДРынок КАК НКДРынок,
	                      |	_ИтоговаяТаблица.БалансоваяСтоимостьБезНКД КАК БалансоваяСтоимостьБезНКД,
	                      |	_ИтоговаяТаблица.НКДУплаченный КАК НКДУплаченный,
	                      |	_ИтоговаяТаблица.НКДНачисленный КАК НКДНачисленный
	                      |ИЗ
	                      |	_ИтоговаяТаблица КАК _ИтоговаяТаблица
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
	                      |				&КонецПериода,
	                      |				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
	                      |					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
	                      |		ПО (ВЫБОР
	                      |				КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Акции
	                      |					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
	                      |				КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Векселя
	                      |					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
	                      |				КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
	                      |					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.ЮрФизЛицо
	                      |				КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Доли
	                      |					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Доли).ЮрЛицо
	                      |				КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
	                      |					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
	                      |				КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	                      |					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
	                      |				КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Закладные
	                      |					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Закладные).Банк.ЮрФизЛицо
	                      |			КОНЕЦ = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&КонецПериода, ) КАК РеквизитыПИФСрезПоследних
	                      |		ПО (ВЫБОР
	                      |				КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Паи
	                      |					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд
	                      |				ИНАЧЕ ЛОЖЬ
	                      |			КОНЕЦ)
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&КонецПериода, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ)) КАК КодыВТорговыхСистемахКодНаММВБ
	                      |		ПО _ИтоговаяТаблица.ЦеннаяБумага = КодыВТорговыхСистемахКодНаММВБ.Объект
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&КонецПериода, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахISIN
	                      |		ПО _ИтоговаяТаблица.ЦеннаяБумага = КодыВТорговыхСистемахISIN.Объект
	                      |ИТОГИ
	                      |	СУММА(РыночнаяСтоимостьБезНКД),
	                      |	СУММА(НКДРынок),
	                      |	СУММА(БалансоваяСтоимостьБезНКД),
	                      |	СУММА(НКДУплаченный),
	                      |	СУММА(НКДНачисленный)
	                      |ПО
	                      |	ОБЩИЕ");
	Запрос.УстановитьПараметр("Регистратор", Документ);
	Запрос.УстановитьПараметр("КонецПериода", ДатаСоставления);
	
	ИтогиПоДокументу = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Если ИтогиПоДокументу.Следующий() Тогда	
		
		ДанныеПоЦБ = ИтогиПоДокументу.Выбрать(ОбходРезультатаЗапроса.Прямой);
		Пока ДанныеПоЦБ.Следующий() Цикл
			ОбластьСтрока.Параметры.Заполнить(ДанныеПоЦБ);			
			ОбластьСтрока.Параметры.Имущество = ДанныеПоЦБ.НаименованиеЦБ;				
						
			ТабличныйДокумент.Вывести(ОбластьСтрока);
		КонецЦикла;
		
		// Итого по бумагам
		ИтогоБалансоваяСтоимость = ИтогиПоДокументу.БалансоваяСтоимостьБезНКД + ИтогиПоДокументу.НКДУплаченный + ИтогиПоДокументу.НКДНачисленный;
		Если ЗначениеЗаполнено(ИтогоБалансоваяСтоимость) Тогда 
			ОбластьПодвал.Параметры.ИтогоБалансоваяСтоимостьПрописью = СуммаВРубляхПрописью(ИтогоБалансоваяСтоимость);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Балансовая стоимость имущества не рассчитана", Объект.Документ);
			ОбластьПодвал.Параметры.ИтогоБалансоваяСтоимостьПрописью = "____________________________________________________________________________"; 		
		КонецЕсли;
		
		ИтогоРыночнаяСтоимость = ИтогиПоДокументу.РыночнаяСтоимостьБезНКД + ИтогиПоДокументу.НКДРынок; 
		ОбластьПодвал.Параметры.ИтогоРыночнаяСтоимостьПрописью = СуммаВРубляхПрописью(ИтогоРыночнаяСтоимость);
	КонецЕсли;
			
	// Управляющая компания, передавшая имущество
	ОбластьПодвал.Параметры.НаименованиеОтправителя = РеквизитыОтправителя.Наименование;
	Если СтруктураДанныхКонтактногоЛицаУК1 <> Неопределено Тогда
		ОбластьПодвал.Параметры.ДолжностьРуководителяОтправителя	= СтруктураДанныхКонтактногоЛицаУК1.Должность;
		ОбластьПодвал.Параметры.РуководительОтправителя				= Строка(СтруктураДанныхКонтактногоЛицаУК1.КонтактноеЛицо) + " /____________";
	Иначе
		ОбластьПодвал.Параметры.ДолжностьРуководителяОтправителя	= "";
		ОбластьПодвал.Параметры.РуководительОтправителя				= " ____________________ /_________ ";
	КонецЕсли;	
	
	// Управляющая компания, получившая имущество
	ОбластьПодвал.Параметры.НаименованиеПолучателя			= РеквизитыПолучателя.Наименование;
	ОбластьПодвал.Параметры.ДолжностьРуководителяПолучателя	= ?(ПереводВнутриУК, ОбластьПодвал.Параметры.ДолжностьРуководителяОтправителя, 	"");
	ОбластьПодвал.Параметры.РуководительПолучателя			= ?(ПереводВнутриУК, ОбластьПодвал.Параметры.РуководительОтправителя, 			" ____________________ /_________ ");
	
	// Собственник имущества
	ОбластьПодвал.Параметры.НаименованиеСобственникаИмущества = РеквизитыФонда.Наименование;
	Если СтруктураДанныхКонтактногоЛицаФонда <> Неопределено Тогда
		ОбластьПодвал.Параметры.ДолжностьРуководителяСобственникаИмущества	= СтруктураДанныхКонтактногоЛицаФонда.Должность;
		ОбластьПодвал.Параметры.РуководительСобственникаИмущества			= Строка(СтруктураДанныхКонтактногоЛицаФонда.КонтактноеЛицо) + " /____________";
	Иначе
		ОбластьПодвал.Параметры.ДолжностьРуководителяСобственникаИмущества	= "";
		ОбластьПодвал.Параметры.РуководительСобственникаИмущества			= " ____________________ /_________ ";
	КонецЕсли;	
	
	// Спец. депозитарий
	РеквизитыСпецДепозитария = ПолучитьРеквизитыСпецДепозитария(СпециализированныйДепозитарий.ЮрФизЛицо, Документ.Дата);
	ОбластьПодвал.Параметры.СпецДеп	= РеквизитыСпецДепозитария.КраткоеНаименование;
	
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	// Две строчки в колонтитулах
	ТабличныйДокумент.ПолеСнизу = 12;
	ТабличныйДокумент.РазмерКолонтитулаСнизу = 12;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьАктПриемаПередачиДенежныхСредств(Документ, ТабличныйДокумент, ИмяМакета)

	РеквизитыАкта = Новый Структура;

	#Область Заполнение_реквизитов_акта	
	
	// Инициализация вспомогательных переменных
	СчетДоверительногоУправления	= Документ.СчетДоверительногоУправления;
	СпециализированныйДепозитарий	= СчетДоверительногоУправления.СпециализированныйДепозитарий;	
	БанковскийСчетУК1				= Документ.РасчетныйСчет;
	НомераАктов						= РегистрыСведений.НомераОбъектов.ЗарегистрироватьНовыйНомер(Документ.Организация, Справочники.ВидыНумерацииОбъектов.ВыводыДенежныхСредств, Документ, СчетДоверительногоУправления, Год(Документ.Дата));
	
	НомерАкта = НомераАктов[Документ];
	
	// Договор ДУ
	РеквизитыАкта.Вставить("НомерДоговораДУ", СчетДоверительногоУправления.НомерДоговора);
	РеквизитыАкта.Вставить("ДатаДоговораДУ", Формат(СчетДоверительногоУправления.ДатаЗаключения, "ДФ=dd.MM.yyyy") + "г.");
	
	Если СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
		РеквизитыАкта.Вставить("ПриложениеКДоговору",
			"Приложение № 1 
			|к договору доверительного управления средствами
			|пенсионных накоплений между негосударственным пенсионным
			|фондом, осуществляющим деятельность в качестве
			|страховщика по обязательному пенсионному страхованию,
			|и управляющей компанией от " + Формат(СчетДоверительногоУправления.ДатаЗаключения, "ДФ='dd MMMM yyyy'") + " года № " + СчетДоверительногоУправления.НомерДоговора);
	ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
		РеквизитыАкта.Вставить("ПриложениеКДоговору",
			"Приложение № 3
			|к Договору доверительного управления
			|пенсионными резервами №" + СчетДоверительногоУправления.НомерДоговора + "
			|от " + Формат(СчетДоверительногоУправления.ДатаЗаключения, "ДФ='dd MMMM yyyy'") + "г.");
	Иначе
		РеквизитыАкта.Вставить("ПриложениеКДоговору", 
			"Приложение № ____
			|к договору доверительного управления №" + СчетДоверительногоУправления.НомерДоговора + "
			|от " + Формат(СчетДоверительногоУправления.ДатаЗаключения, "ДФ='dd MMMM yyyy'") + "г.");
	КонецЕсли;
		
	// Фонд
	РеквизитыФонда = ПолучитьРеквизитыСобственникаИмущества(Документ.Организация, Документ.СчетДоверительногоУправления, Документ.Дата);
	РеквизитыАкта.Вставить("Фонд", РеквизитыФонда.Наименование);
	Если СтруктураДанныхКонтактногоЛицаФонда <> Неопределено Тогда
		РеквизитыАкта.Вставить("ДолжностьРуководителяФонда", СтруктураДанныхКонтактногоЛицаФонда.Должность);
		РеквизитыАкта.Вставить("РуководительФонда", Строка(СтруктураДанныхКонтактногоЛицаФонда.КонтактноеЛицо) + " /____________");
	Иначе
		РеквизитыАкта.Вставить("РуководительФонда", "   ____________________ /_________ ");
	КонецЕсли;	
	
	// Управляющая компания, передавшая имущество
	РеквизитыАкта.Вставить("УК1", БанковскийСчетУК1.Договор.НаименованиеВладельцаДляДокументов);
	Если СтруктураДанныхКонтактногоЛицаУК1 <> Неопределено Тогда
		РеквизитыАкта.Вставить("ДолжностьРуководителяУК1", СтруктураДанныхКонтактногоЛицаУК1.Должность);
		РеквизитыАкта.Вставить("РуководительУК1", Строка(СтруктураДанныхКонтактногоЛицаУК1.КонтактноеЛицо) + " /____________");
	Иначе
		РеквизитыАкта.Вставить("РуководительУК1",			"   ____________________ /_________ ");
	КонецЕсли;	
	
	// Управляющая компания, получившая имущество
	РеквизитыАкта.Вставить("УК2", );
	РеквизитыАкта.Вставить("ДолжностьРуководителяУК2", );
	РеквизитыАкта.Вставить("РуководительУК2",			"            ____________________ /_________ ");
	
	// Входящий документ
	ОснованиеТребование = Документ.Основание;
	Если Не ЗначениеЗаполнено(ОснованиеТребование.НомерВходящегоДокумента) 
		ИЛИ Не ЗначениеЗаполнено(ОснованиеТребование.ДатаВходящегоДокумента)
		ИЛИ Не ЗначениеЗаполнено(ОснованиеТребование.ОписаниеДенежныхСредств)
	Тогда
		// Уведомляем при отсуствии информации о входящем документе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена информация о входящем документе в """ + Строка(ОснованиеТребование) + """", ОснованиеТребование);
	КонецЕсли;
	РеквизитыАкта.Вставить("НомерТребования",		ОснованиеТребование.НомерВходящегоДокумента);
	РеквизитыАкта.Вставить("ДатаТребования",		?(ЗначениеЗаполнено(ОснованиеТребование.ДатаВходящегоДокумента),Формат(ОснованиеТребование.ДатаВходящегоДокумента, "ДФ=dd.MM.yyyy") + "г.", ""));
	РеквизитыАкта.Вставить("ОписаниеИмущества",		ОснованиеТребование.ОписаниеДенежныхСредств);
	
	// Акт приема-передачи
	РеквизитыАкта.Вставить("НомерАкта", 			Число(НомерАкта));
	РеквизитыАкта.Вставить("ДатаСоставления",		ТекущаяДата());
	РеквизитыАкта.Вставить("МестоСоставления",		"г. Москва");
	
	РеквизитыАкта.Вставить("Количество",			Формат(Документ.Сумма, "ЧДЦ=2"));
	РеквизитыАкта.Вставить("ДатаПоступления",		Формат(Документ.Дата, "ДФ=dd.MM.yyyy") + "г.");
	РеквизитыАкта.Вставить("БалансоваяСтоимость",	Формат(Документ.Сумма, "ЧДЦ=2"));
	РеквизитыАкта.Вставить("РыночнаяСтоимость",		Формат(Документ.Сумма, "ЧДЦ=2"));
	РеквизитыАкта.Вставить("СуммаПрописью",	
	    ?(БанковскийСчетУК1.Валюта.Код = "643",
			СуммаВРубляхПрописью(Документ.Сумма),
			Строка(Документ.Сумма) + " (" + ЧислоПрописью(Документ.Сумма, , БанковскийСчетУК1.Валюта.ПараметрыПрописиНаРусском)+ ")"
		)
	);
	
	// Спец. депозитарий
	РеквизитыСпецДепозитария = ПолучитьРеквизитыСпецДепозитария(СпециализированныйДепозитарий.ЮрФизЛицо, Документ.Дата);
	РеквизитыАкта.Вставить("Получатель", РеквизитыСпецДепозитария.КраткоеНаименование);
	
	#КонецОбласти
	
	Макет = Обработки.ПечатьАктовПриемаПередачиИмущества.ПолучитьМакет(ИмяМакета);
	
	ЗаполнитьЗначенияСвойств(Макет.Параметры, РеквизитыАкта);
	
	ТабличныйДокумент.Вывести(Макет);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СформироватьАктПриемаПередачиЗаПериод(СчетДоверительногоУправления, Период, ТабличныйДокумент, ИмяМакета, ДанныеОтправителя, ДанныеСобственника)
	
	РеквизитыАкта = Новый Структура;
	ЮрФизЛицоКлиента = РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицоСчетаДоверительногоУправления(СчетДоверительногоУправления, Период.ДатаОкончания);
		
	#Область Заполнение_реквизитов_акта
	
	// Реквизиты счета д/у
	
	РеквизитыСчетаДУ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетДоверительногоУправления,
		Новый Структура("Организация, ДатаЗаключенияДоговора, НомерДоговора, ВидДоговораДоверительногоУправления, СпециализированныйДепозитарий, ЮрЛицоСпецДепозитария",
			"Организация", "ДатаЗаключения", "НомерДоговора", "ВидДоговораДоверительногоУправления", "СпециализированныйДепозитарий", "СпециализированныйДепозитарий.ЮрФизЛицо"));
	
	РеквизитыАкта.Вставить("НомерДоговора",						РеквизитыСчетаДУ.НомерДоговора);	
	РеквизитыАкта.Вставить("ДатаЗаключенияДоговора_ddMMMMyyyy",	Формат(РеквизитыСчетаДУ.ДатаЗаключенияДоговора, "ДФ='dd MMMM yyyy'"));
	РеквизитыАкта.Вставить("ДатаЗаключенияДоговора_ddMMyyyy",	Формат(РеквизитыСчетаДУ.ДатаЗаключенияДоговора, "ДФ='dd.MM.yyyy'"));
	РеквизитыАкта.Вставить("ПредставлениеПериода",				РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПолучитьПредставлениеПериода(Период.ДатаНачала, Период.ДатаОкончания));
	
	// Реквизиты клиента
	
	РеквизитыКлиента = ПолучитьРеквизитыСобственникаИмущества(РеквизитыСчетаДУ.Организация, СчетДоверительногоУправления, Период.ДатаОкончания);
			
	РеквизитыАкта.Вставить("КраткоеНаименованиеКлиента",	РеквизитыКлиента.Наименование);
	РеквизитыАкта.Вставить("ПолноеНаименованиеКлиента",		РеквизитыКлиента.ПолноеНаименование);
	
	Если ДанныеСобственника.ДанныеКонтактногоЛица = Неопределено Тогда
		РеквизитыАкта.Вставить("ДолжностьРуководителяКлиента",	"");
		РеквизитыАкта.Вставить("РуководительКлиента",			"                                                      ");
	Иначе
		РеквизитыАкта.Вставить("ДолжностьРуководителяКлиента",	ДанныеСобственника.ДанныеКонтактногоЛица.Должность);
		РеквизитыАкта.Вставить("РуководительКлиента",			ДанныеСобственника.ДанныеКонтактногоЛица.КонтактноеЛицо);
	КонецЕсли;

	// Реквизиты УК
	
	РеквизитыУК = ПолучитьРеквизитыОтправителя(РеквизитыСчетаДУ.Организация, СчетДоверительногоУправления, Период.ДатаОкончания, ДанныеОтправителя.БанковскийСчет);	
	
	РеквизитыАкта.Вставить("КраткоеНаименованиеУК",		РеквизитыУК.КраткоеНаименование);
	РеквизитыАкта.Вставить("ПолноеНаименованиеУК",		РеквизитыУК.ПолноеНаименование);
	РеквизитыАкта.Вставить("НаименованиеУКВДоговоре",	РеквизитыУК.Наименование);
	
	Если ДанныеОтправителя.ДанныеКонтактногоЛица = Неопределено Тогда
		РеквизитыАкта.Вставить("ДолжностьРуководителяУК",	"");
		РеквизитыАкта.Вставить("РуководительУК",			"                                           ");
	Иначе
		РеквизитыАкта.Вставить("ДолжностьРуководителяУК",	ДанныеОтправителя.ДанныеКонтактногоЛица.Должность);
		РеквизитыАкта.Вставить("РуководительУК",			ДанныеОтправителя.ДанныеКонтактногоЛица.КонтактноеЛицо);
	КонецЕсли;	
	
	// Реквизиты специализированного депозитария
	
	Если ЗначениеЗаполнено(РеквизитыСчетаДУ.СпециализированныйДепозитарий) Тогда
	
		РеквизитыСпецДепозитария = ПолучитьРеквизитыСпецДепозитария(РеквизитыСчетаДУ.ЮрЛицоСпецДепозитария, Период.ДатаОкончания);
		
		РеквизитыАкта.Вставить("КраткоеНаименованиеСпецдепа", РеквизитыСпецДепозитария.КраткоеНаименование);
		
	КонецЕсли;
		
	#КонецОбласти
	
	Макет = Обработки.ПечатьАктовПриемаПередачиИмущества.ПолучитьМакет(ИмяМакета);	
	
	// Шапка
	
	Если РеквизитыСчетаДУ.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
		ИмяОбластиПриложения	= "Приложение_ПН";	
		ИмяОбластиЗаголовка		= "Заголовок_ПН";
	Иначе	
		ИмяОбластиПриложения	= Неопределено;	
		ИмяОбластиЗаголовка		= "Заголовок_Прочие";
	КонецЕсли;
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	УдалитьОбластиЯчеекТабличногоДокумента(ОбластьШапка, "Приложение_", ИмяОбластиПриложения);
	УдалитьОбластиЯчеекТабличногоДокумента(ОбластьШапка, "Заголовок_", ИмяОбластиЗаголовка);
		
	ОбластьШапка.Параметры.Заполнить(РеквизитыАкта);
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	// Раздел "Ввод"
	
	Если РеквизитыСчетаДУ.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
		ИмяОбластиРазделаВвода = "Ввод_ПН";	
	ИначеЕсли РеквизитыСчетаДУ.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
		ИмяОбластиРазделаВвода = "Ввод_ПР";		
	Иначе	
		ИмяОбластиРазделаВвода = "Ввод_Прочие";
	КонецЕсли;
	
	ОбластьРазделВвод = Макет.ПолучитьОбласть("РазделВвод");
	
	УдалитьОбластиЯчеекТабличногоДокумента(ОбластьРазделВвод, "Ввод_", ИмяОбластиРазделаВвода);
	
	ТабличныйДокумент.Вывести(ОбластьРазделВвод);
	
	// Строки раздела "Ввод"
	
	#Область Запрос_данных_о_вводах
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводыВыводыАктивовВВалютеУчетаОбороты.Период КАК Период,
		|	ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Регистратор,
		|	ВводыВыводыАктивовВВалютеУчетаОбороты.ВидАктива КАК ВидАктива,
		|	ВводыВыводыАктивовВВалютеУчетаОбороты.БалансоваяСтоимостьОборот КАК БалансоваяСтоимость,
		|	ВводыВыводыАктивовВВалютеУчетаОбороты.РыночнаяСтоимостьОборот КАК РыночнаяСтоимость,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор) = ТИП(Документ.ВводДенежныхСредств)
		|			ТОГДА ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВводДенежныхСредств).СтрокаБанковскойВыписки
		|		ИНАЧЕ ЗНАЧЕНИЕ(Документ.СтрокаБанковскойВыписки.ПустаяСсылка)
		|	КОНЕЦ КАК СтрокаБанковскойВыписки
		|ПОМЕСТИТЬ _Вводы
		|ИЗ
		|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета.Обороты(
		|			&ДатаНачала,
		|			&ДатаОкончания,
		|			Регистратор,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидОперацииВводаВыводаДС В (ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтПФР), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПустаяСсылка))
		|				И НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)) КАК ВводыВыводыАктивовВВалютеУчетаОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Вводы.Период КАК Период,
		|	_Вводы.Регистратор КАК Регистратор,
		|	_Вводы.ВидАктива КАК ВидПереданногоИмущества,
		|	_Вводы.СтрокаБанковскойВыписки КАК СтрокаБанковскойВыписки,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_Вводы.Регистратор) = ТИП(Документ.ВводЦенныхБумаг)
		|				И ТИПЗНАЧЕНИЯ(ВводЦенныхБумаг.Поручение) = ТИП(Документ.ПоручениеНаДвижениеЦенныхБумаг)
		|			ТОГДА ВЫРАЗИТЬ(ВводЦенныхБумаг.Поручение КАК Документ.ПоручениеНаДвижениеЦенныхБумаг).ДатаВходящегоДокумента
		|		КОГДА ТИПЗНАЧЕНИЯ(_Вводы.Регистратор) = ТИП(Документ.ВводДенежныхСредств)
		|			ТОГДА ВводДенежныхСредств.ДатаВходящегоДокумента
		|		КОГДА ТИПЗНАЧЕНИЯ(_Вводы.Регистратор) = ТИП(Документ.ВводКредитногоИнструмента)
		|			ТОГДА ВводКредитногоИнструмента.ДатаВходящегоДокумента
		|		ИНАЧЕ ""-""
		|	КОНЕЦ КАК ДатаВходящегоДокумента,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_Вводы.Регистратор) = ТИП(Документ.ВводЦенныхБумаг)
		|				И ТИПЗНАЧЕНИЯ(ВводЦенныхБумаг.Поручение) = ТИП(Документ.ПоручениеНаДвижениеЦенныхБумаг)
		|			ТОГДА ВЫРАЗИТЬ(ВводЦенныхБумаг.Поручение КАК Документ.ПоручениеНаДвижениеЦенныхБумаг).НомерВходящегоДокумента
		|		КОГДА ТИПЗНАЧЕНИЯ(_Вводы.Регистратор) = ТИП(Документ.ВводДенежныхСредств)
		|			ТОГДА ВводДенежныхСредств.НомерВходящегоДокумента
		|		КОГДА ТИПЗНАЧЕНИЯ(_Вводы.Регистратор) = ТИП(Документ.ВводКредитногоИнструмента)
		|			ТОГДА ВводКредитногоИнструмента.НомерВходящегоДокумента
		|		ИНАЧЕ ""-""
		|	КОНЕЦ КАК НомерВходящегоДокумента,
		|	ЕСТЬNULL(_Вводы.СтрокаБанковскойВыписки.НомерПлатежногоДокумента, ""-"") КАК НомерПлатежногоДокумента,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_Вводы.Регистратор) = ТИП(Документ.ВводЦенныхБумаг)
		|			ТОГДА ВводЦенныхБумаг.Дата
		|		ИНАЧЕ ЕСТЬNULL(_Вводы.СтрокаБанковскойВыписки.ДатаПлатежногоДокумента, _Вводы.Период)
		|	КОНЕЦ КАК ДатаПлатежногоДокумента,
		|	_Вводы.СтрокаБанковскойВыписки.ИсходныеДанные КАК ИсходныеДанныеБанковскойВыписки,
		|	_Вводы.СтрокаБанковскойВыписки.РасчетныйСчетКонтрагента КАК РасчетныйСчетКонтрагентаБанковскойВыписки,
		|	_Вводы.СтрокаБанковскойВыписки.РасчетныйСчетКонтрагента.НомерСчета КАК НомерРасчетногоСчетаКонтрагента,
		|	_Вводы.СтрокаБанковскойВыписки.РасчетныйСчетКонтрагента.Банк КАК БанкРасчетногоСчетаКонтрагента,
		|	_Вводы.СтрокаБанковскойВыписки.РасчетныйСчетКонтрагента.Банк.Представление КАК ПредставлениеБанкаКонтрагента,
		|	_Вводы.СтрокаБанковскойВыписки.РасчетныйСчетКонтрагента.Банк.КоррСчет КАК КоррСчетБанкаКонтрагента,
		|	_Вводы.СтрокаБанковскойВыписки.РасчетныйСчетКонтрагента.Банк.Код КАК БИКБанкаКонтрагента,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_Вводы.Регистратор) = ТИП(Документ.ВводЦенныхБумаг)
		|				И ВЫРАЗИТЬ(_Вводы.Регистратор КАК Документ.ВводЦенныхБумаг).Контрагент <> &ЮрФизЛицоКлиента
		|			ТОГДА ВЫРАЗИТЬ(_Вводы.Регистратор КАК Документ.ВводЦенныхБумаг).Контрагент
		|		ИНАЧЕ _Вводы.СтрокаБанковскойВыписки.Контрагент
		|	КОНЕЦ КАК Контрагент,
		|	_Вводы.БалансоваяСтоимость КАК БалансоваяСтоимость,
		|	_Вводы.РыночнаяСтоимость КАК РыночнаяСтоимость,
		|	ВЫБОР
		|		КОГДА _Вводы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|			ТОГДА _Вводы.БалансоваяСтоимость
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК БалансоваяСтоимостьДС,
		|	ВЫБОР
		|		КОГДА _Вводы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|			ТОГДА _Вводы.РыночнаяСтоимость
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК РыночнаяСтоимостьДС,
		|	ВЫБОР
		|		КОГДА _Вводы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|			ТОГДА _Вводы.БалансоваяСтоимость
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК БалансоваяСтоимостьДЕПО,
		|	ВЫБОР
		|		КОГДА _Вводы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|			ТОГДА _Вводы.РыночнаяСтоимость
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК РыночнаяСтоимостьДЕПО,
		|	ВЫБОР
		|		КОГДА _Вводы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ЦенныеБумаги)
		|			ТОГДА _Вводы.БалансоваяСтоимость
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК БалансоваяСтоимостьЦБ,
		|	ВЫБОР
		|		КОГДА _Вводы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ЦенныеБумаги)
		|			ТОГДА _Вводы.РыночнаяСтоимость
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК РыночнаяСтоимостьЦБ
		|ПОМЕСТИТЬ _ДанныеВводов
		|ИЗ
		|	_Вводы КАК _Вводы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг КАК ВводЦенныхБумаг
		|		ПО (ВводЦенныхБумаг.Ссылка = _Вводы.Регистратор)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводДенежныхСредств КАК ВводДенежныхСредств
		|		ПО (ВводДенежныхСредств.Ссылка = _Вводы.Регистратор)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводКредитногоИнструмента КАК ВводКредитногоИнструмента
		|		ПО (ВводКредитногоИнструмента.Ссылка = _Вводы.Регистратор)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеВводов.Период КАК Период,
		|	_ДанныеВводов.Регистратор КАК Регистратор,
		|	_ДанныеВводов.ВидПереданногоИмущества КАК ВидПереданногоИмущества,
		|	_ДанныеВводов.СтрокаБанковскойВыписки КАК СтрокаБанковскойВыписки,
		|	_ДанныеВводов.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
		|	_ДанныеВводов.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
		|	_ДанныеВводов.НомерПлатежногоДокумента КАК НомерПлатежногоДокумента,
		|	_ДанныеВводов.ДатаПлатежногоДокумента КАК ДатаПлатежногоДокумента,
		|	_ДанныеВводов.ИсходныеДанныеБанковскойВыписки КАК ИсходныеДанныеБанковскойВыписки,
		|	_ДанныеВводов.РасчетныйСчетКонтрагентаБанковскойВыписки КАК РасчетныйСчетКонтрагентаБанковскойВыписки,
		|	_ДанныеВводов.НомерРасчетногоСчетаКонтрагента КАК НомерРасчетногоСчетаКонтрагента,
		|	_ДанныеВводов.БанкРасчетногоСчетаКонтрагента КАК БанкРасчетногоСчетаКонтрагента,
		|	_ДанныеВводов.ПредставлениеБанкаКонтрагента КАК ПредставлениеБанкаКонтрагента,
		|	_ДанныеВводов.КоррСчетБанкаКонтрагента КАК КоррСчетБанкаКонтрагента,
		|	_ДанныеВводов.БИКБанкаКонтрагента КАК БИКБанкаКонтрагента,
		|	_ДанныеВводов.Контрагент КАК Контрагент,
		|	ЕСТЬNULL(РеквизитыКонтрагента.КраткоеНаименованиеПоУставу, _ДанныеВводов.Контрагент.Представление) КАК КраткоеНаименованиеКонтрагента,
		|	_ДанныеВводов.БалансоваяСтоимость КАК БалансоваяСтоимость,
		|	_ДанныеВводов.РыночнаяСтоимость КАК РыночнаяСтоимость,
		|	_ДанныеВводов.БалансоваяСтоимостьДС КАК БалансоваяСтоимостьДС,
		|	_ДанныеВводов.РыночнаяСтоимостьДС КАК РыночнаяСтоимостьДС,
		|	_ДанныеВводов.БалансоваяСтоимостьДЕПО КАК БалансоваяСтоимостьДЕПО,
		|	_ДанныеВводов.РыночнаяСтоимостьДЕПО КАК РыночнаяСтоимостьДЕПО,
		|	_ДанныеВводов.БалансоваяСтоимостьЦБ КАК БалансоваяСтоимостьЦБ,
		|	_ДанныеВводов.РыночнаяСтоимостьЦБ КАК РыночнаяСтоимостьЦБ,
		|	РеквизитыКонтрагента.ИНН КАК ИННКонтрагента,
		|	РеквизитыКонтрагента.КПП КАК КППКонтрагента
		|ИЗ
		|	_ДанныеВводов КАК _ДанныеВводов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						_ДанныеВводов.Контрагент
		|					ИЗ
		|						_ДанныеВводов)) КАК РеквизитыКонтрагента
		|		ПО (РеквизитыКонтрагента.ЮрФизЛицо = _ДанныеВводов.Контрагент)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаПлатежногоДокумента
		|ИТОГИ
		|	СУММА(БалансоваяСтоимость),
		|	СУММА(РыночнаяСтоимость),
		|	СУММА(БалансоваяСтоимостьДС),
		|	СУММА(РыночнаяСтоимостьДС),
		|	СУММА(БалансоваяСтоимостьДЕПО),
		|	СУММА(РыночнаяСтоимостьДЕПО),
		|	СУММА(БалансоваяСтоимостьЦБ),
		|	СУММА(РыночнаяСтоимостьЦБ)
		|ПО
		|	ОБЩИЕ");
	
	Запрос.УстановитьПараметр("Организация",					РеквизитыСчетаДУ.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЮрФизЛицоКлиента",				ЮрФизЛицоКлиента);
	Запрос.УстановитьПараметр("ДатаНачала",						Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",					Период.ДатаОкончания);
	
	#КонецОбласти
	
	НомерСтроки = 0;
	
	ИтогиРаздела = Новый Структура;
	ИтогиРаздела.Вставить("БалансоваяСтоимость",		0);
	ИтогиРаздела.Вставить("РыночнаяСтоимость",			0);
	ИтогиРаздела.Вставить("БалансоваяСтоимостьДС",		0);
	ИтогиРаздела.Вставить("РыночнаяСтоимостьДС",		0);
	ИтогиРаздела.Вставить("БалансоваяСтоимостьДЕПО",	0);
	ИтогиРаздела.Вставить("РыночнаяСтоимостьДЕПО",		0);
	ИтогиРаздела.Вставить("БалансоваяСтоимостьЦБ",		0);
	ИтогиРаздела.Вставить("РыночнаяСтоимостьЦБ",		0);	

	ВыборкаРаздела = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаРаздела.Следующий() Цикл
		
		ВыборкаСтрокРаздела = ВыборкаРаздела.Выбрать(ОбходРезультатаЗапроса.Прямой);
		
		Пока ВыборкаСтрокРаздела.Следующий() Цикл
			
			НомерСтроки = НомерСтроки + 1;
			
			ДополнительныеДанныеСтроки = Новый Структура("НомерСтроки", НомерСтроки);
			
			// Плательщик и получатель из исходных данных
			
			Для НомерСтрокиИсходныхДанныхВыписки = 1 По СтрЧислоСтрок(ВыборкаСтрокРаздела.ИсходныеДанныеБанковскойВыписки) Цикл
				
				ТекСтрока = СтрПолучитьСтроку(ВыборкаСтрокРаздела.ИсходныеДанныеБанковскойВыписки, НомерСтрокиИсходныхДанныхВыписки);
				
				Если Найти(ТекСтрока, "Получатель1") > 0 Тогда
					ДополнительныеДанныеСтроки.Вставить("Получатель", СтрЗаменить(ТекСтрока, "Получатель1=", ""));
				ИначеЕсли Найти(ТекСтрока, "Плательщик1") > 0 Тогда
					ДополнительныеДанныеСтроки.Вставить("Плательщик", СтрЗаменить(ТекСтрока, "Плательщик1=", ""));
				КонецЕсли;
				
			КонецЦикла;
			
			// Наименование и реквизиты плательщика 
			
			ПредставлениеПлательщика = "";
			
			Если ДополнительныеДанныеСтроки.Свойство("Плательщик") И ЗначениеЗаполнено(ДополнительныеДанныеСтроки.Плательщик) Тогда
				ПредставлениеПлательщика = ДополнительныеДанныеСтроки.Плательщик;
			ИначеЕсли ЗначениеЗаполнено(ВыборкаСтрокРаздела.КраткоеНаименованиеКонтрагента) Тогда
				ПредставлениеПлательщика = ВыборкаСтрокРаздела.КраткоеНаименованиеКонтрагента;	
			КонецЕсли;
				
			Если ЗначениеЗаполнено(ПредставлениеПлательщика) Тогда
				
				ДополнительныеДанныеСтроки.Вставить("НаименованиеИРеквизитыУК",
					ПредставлениеПлательщика
					+ ?(ЗначениеЗаполнено(ВыборкаСтрокРаздела.НомерРасчетногоСчетаКонтрагента),	", р/счет " + ВыборкаСтрокРаздела.НомерРасчетногоСчетаКонтрагента + " в " + ВыборкаСтрокРаздела.ПредставлениеБанкаКонтрагента, "")
					+ ?(ЗначениеЗаполнено(ВыборкаСтрокРаздела.КоррСчетБанкаКонтрагента),		", к/счет " + ВыборкаСтрокРаздела.КоррСчетБанкаКонтрагента, "")
					+ ?(ЗначениеЗаполнено(ВыборкаСтрокРаздела.БИКБанкаКонтрагента),				", БИК " + ВыборкаСтрокРаздела.БИКБанкаКонтрагента, "")
					+ ?(ЗначениеЗаполнено(ВыборкаСтрокРаздела.ИННКонтрагента),					", ИНН " + ВыборкаСтрокРаздела.ИННКонтрагента, "")
					+ ?(ЗначениеЗаполнено(ВыборкаСтрокРаздела.КППКонтрагента),					", КПП " + ВыборкаСтрокРаздела.КППКонтрагента, ""));
					
			Иначе
					
				ДополнительныеДанныеСтроки.Вставить("НаименованиеИРеквизитыУК", "-");
					
			КонецЕсли;
			
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
			
			ОбластьСтрока.Параметры.Заполнить(ВыборкаСтрокРаздела);
			ОбластьСтрока.Параметры.Заполнить(ДополнительныеДанныеСтроки);
		
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			
		КонецЦикла;
			
		ЗаполнитьЗначенияСвойств(ИтогиРаздела, ВыборкаРаздела);	
		
	КонецЦикла;		
	
	// Итоги раздела "Ввод"

	ОбластьИтогоПоРазделу = Макет.ПолучитьОбласть("ИтогоПоРазделу");

	ОбластьИтогоПоРазделу.Параметры.Заполнить(ИтогиРаздела);
	
	ТабличныйДокумент.Вывести(ОбластьИтогоПоРазделу);
	
	// Раздел "Вывод"
	
	Если РеквизитыСчетаДУ.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
		ИмяОбластиРазделаВывода = "Вывод_ПН";	
	ИначеЕсли РеквизитыСчетаДУ.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
		ИмяОбластиРазделаВывода = "Вывод_ПР";		
	Иначе	
		ИмяОбластиРазделаВывода = "Вывод_Прочие";
	КонецЕсли;
	
	ОбластьРазделВывод = Макет.ПолучитьОбласть("РазделВывод");
	
	УдалитьОбластиЯчеекТабличногоДокумента(ОбластьРазделВывод, "Вывод_", ИмяОбластиРазделаВывода);
	
	ТабличныйДокумент.Вывести(ОбластьРазделВывод);	
	
	// Строки раздела "Вывод"
	
	#Область Запрос_данных_о_выводах
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводыВыводыАктивовВВалютеУчетаОбороты.Период КАК Период,
		|	ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Регистратор,
		|	ВводыВыводыАктивовВВалютеУчетаОбороты.ВидАктива КАК ВидАктива,
		|	ВводыВыводыАктивовВВалютеУчетаОбороты.БалансоваяСтоимостьОборот КАК БалансоваяСтоимость,
		|	ВводыВыводыАктивовВВалютеУчетаОбороты.РыночнаяСтоимостьОборот КАК РыночнаяСтоимость,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор) = ТИП(Документ.ВыводДенежныхСредств)
		|			ТОГДА ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВыводДенежныхСредств).СтрокаБанковскойВыписки
		|		ИНАЧЕ ЗНАЧЕНИЕ(Документ.СтрокаБанковскойВыписки.ПустаяСсылка)
		|	КОНЕЦ КАК СтрокаБанковскойВыписки
		|ПОМЕСТИТЬ _Выводы
		|ИЗ
		|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета.Обороты(
		|			&ДатаНачала,
		|			&ДатаОкончания,
		|			Регистратор,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидОперацииВводаВыводаДС В (ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводДляОбеспеченияИОУД), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыплаченыСредстваПФР), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводУчредителюДоходаПолученногоОтРазмещения), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводДенежныхСредствСПереводомВсехАктивовНаДругойИИС), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПустаяСсылка))
		|				И НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)) КАК ВводыВыводыАктивовВВалютеУчетаОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Выводы.Период КАК Период,
		|	_Выводы.Регистратор КАК Регистратор,
		|	_Выводы.ВидАктива КАК ВидПереданногоИмущества,
		|	ВЫБОР
		|		КОГДА _Выводы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|			ТОГДА ВЫРАЗИТЬ(ВыводДенежныхСредств.Основание КАК Документ.ПоручениеНаДвижениеДенежныхСредств).ОписаниеДенежныхСредств
		|		ИНАЧЕ _Выводы.ВидАктива
		|	КОНЕЦ КАК ЦельВывода,
		|	ЕСТЬNULL(_Выводы.СтрокаБанковскойВыписки.ДатаПлатежногоДокумента, _Выводы.Период) КАК ДатаПлатежногоДокумента,
		|	ЕСТЬNULL(_Выводы.СтрокаБанковскойВыписки.НомерПлатежногоДокумента, ""-"") КАК НомерПлатежногоДокумента,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_Выводы.Регистратор) = ТИП(Документ.ВыводЦенныхБумаг)
		|				И ТИПЗНАЧЕНИЯ(ВыводЦенныхБумаг.Поручение) = ТИП(Документ.ПоручениеНаДвижениеЦенныхБумаг)
		|			ТОГДА ВЫРАЗИТЬ(ВыводЦенныхБумаг.Поручение КАК Документ.ПоручениеНаДвижениеЦенныхБумаг).ДатаВходящегоДокумента
		|		КОГДА ТИПЗНАЧЕНИЯ(_Выводы.Регистратор) = ТИП(Документ.ВыводДенежныхСредств)
		|				И ТИПЗНАЧЕНИЯ(ВыводДенежныхСредств.Основание) = ТИП(Документ.ПоручениеНаДвижениеДенежныхСредств)
		|			ТОГДА ВЫРАЗИТЬ(ВыводДенежныхСредств.Основание КАК Документ.ПоручениеНаДвижениеДенежныхСредств).ДатаВходящегоДокумента
		|		КОГДА ТИПЗНАЧЕНИЯ(_Выводы.Регистратор) = ТИП(Документ.ВыводКредитногоИнструмента)
		|			ТОГДА ВыводКредитногоИнструмента.ДатаВходящегоДокумента
		|		ИНАЧЕ ""-""
		|	КОНЕЦ КАК ДатаВходящегоДокумента,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_Выводы.Регистратор) = ТИП(Документ.ВыводЦенныхБумаг)
		|				И ТИПЗНАЧЕНИЯ(ВыводЦенныхБумаг.Поручение) = ТИП(Документ.ПоручениеНаДвижениеЦенныхБумаг)
		|			ТОГДА ВЫРАЗИТЬ(ВыводЦенныхБумаг.Поручение КАК Документ.ПоручениеНаДвижениеЦенныхБумаг).НомерВходящегоДокумента
		|		КОГДА ТИПЗНАЧЕНИЯ(_Выводы.Регистратор) = ТИП(Документ.ВыводДенежныхСредств)
		|				И ТИПЗНАЧЕНИЯ(ВыводДенежныхСредств.Основание) = ТИП(Документ.ПоручениеНаДвижениеДенежныхСредств)
		|			ТОГДА ВЫРАЗИТЬ(ВыводДенежныхСредств.Основание КАК Документ.ПоручениеНаДвижениеДенежныхСредств).НомерВходящегоДокумента
		|		КОГДА ТИПЗНАЧЕНИЯ(_Выводы.Регистратор) = ТИП(Документ.ВыводКредитногоИнструмента)
		|			ТОГДА ВыводКредитногоИнструмента.НомерВходящегоДокумента
		|		ИНАЧЕ ""-""
		|	КОНЕЦ КАК НомерВходящегоДокумента,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_Выводы.Регистратор) = ТИП(Документ.ВыводЦенныхБумаг)
		|				И ВЫРАЗИТЬ(_Выводы.Регистратор КАК Документ.ВыводЦенныхБумаг).Контрагент <> &ЮрФизЛицоКлиента
		|			ТОГДА ВЫРАЗИТЬ(_Выводы.Регистратор КАК Документ.ВыводЦенныхБумаг).Контрагент
		|		КОГДА ТИПЗНАЧЕНИЯ(_Выводы.Регистратор) = ТИП(Документ.ВыводДенежныхСредств)
		|				И ВЫРАЗИТЬ(_Выводы.Регистратор КАК Документ.ВыводДенежныхСредств).Контрагент <> &ЮрФизЛицоКлиента
		|			ТОГДА ВЫРАЗИТЬ(_Выводы.Регистратор КАК Документ.ВыводДенежныхСредств).Контрагент
		|	КОНЕЦ КАК Контрагент,
		|	_Выводы.БалансоваяСтоимость КАК БалансоваяСтоимость,
		|	_Выводы.РыночнаяСтоимость КАК РыночнаяСтоимость,
		|	ВЫБОР
		|		КОГДА _Выводы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|			ТОГДА _Выводы.БалансоваяСтоимость
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК БалансоваяСтоимостьДС,
		|	ВЫБОР
		|		КОГДА _Выводы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|			ТОГДА _Выводы.РыночнаяСтоимость
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК РыночнаяСтоимостьДС,
		|	ВЫБОР
		|		КОГДА _Выводы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|			ТОГДА _Выводы.БалансоваяСтоимость
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК БалансоваяСтоимостьДЕПО,
		|	ВЫБОР
		|		КОГДА _Выводы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|			ТОГДА _Выводы.РыночнаяСтоимость
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК РыночнаяСтоимостьДЕПО,
		|	ВЫБОР
		|		КОГДА _Выводы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ЦенныеБумаги)
		|			ТОГДА _Выводы.БалансоваяСтоимость
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК БалансоваяСтоимостьЦБ,
		|	ВЫБОР
		|		КОГДА _Выводы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ЦенныеБумаги)
		|			ТОГДА _Выводы.РыночнаяСтоимость
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК РыночнаяСтоимостьЦБ
		|ПОМЕСТИТЬ _ДанныеВыводов
		|ИЗ
		|	_Выводы КАК _Выводы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыводЦенныхБумаг КАК ВыводЦенныхБумаг
		|		ПО (ВыводЦенныхБумаг.Ссылка = _Выводы.Регистратор)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыводДенежныхСредств КАК ВыводДенежныхСредств
		|		ПО (ВыводДенежныхСредств.Ссылка = _Выводы.Регистратор)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыводКредитногоИнструмента КАК ВыводКредитногоИнструмента
		|		ПО (ВыводКредитногоИнструмента.Ссылка = _Выводы.Регистратор)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеВыводов.Период КАК Период,
		|	_ДанныеВыводов.Регистратор КАК Регистратор,
		|	_ДанныеВыводов.ВидПереданногоИмущества КАК ВидПереданногоИмущества,
		|	_ДанныеВыводов.ЦельВывода КАК ЦельВывода,
		|	ПРЕДСТАВЛЕНИЕССЫЛКИ(_ДанныеВыводов.ЦельВывода) КАК ПредставлениеЦелиВывода,
		|	_ДанныеВыводов.ДатаПлатежногоДокумента КАК ДатаПлатежногоДокумента,
		|	_ДанныеВыводов.НомерПлатежногоДокумента КАК НомерПлатежногоДокумента,
		|	_ДанныеВыводов.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
		|	_ДанныеВыводов.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
		|	_ДанныеВыводов.Контрагент КАК Контрагент,
		|	ЕСТЬNULL(РеквизитыКонтрагента.КраткоеНаименованиеПоУставу, _ДанныеВыводов.Контрагент.Представление) КАК КраткоеНаименованиеКонтрагента,
		|	_ДанныеВыводов.БалансоваяСтоимость КАК БалансоваяСтоимость,
		|	_ДанныеВыводов.РыночнаяСтоимость КАК РыночнаяСтоимость,
		|	_ДанныеВыводов.БалансоваяСтоимостьДС КАК БалансоваяСтоимостьДС,
		|	_ДанныеВыводов.РыночнаяСтоимостьДС КАК РыночнаяСтоимостьДС,
		|	_ДанныеВыводов.БалансоваяСтоимостьДЕПО КАК БалансоваяСтоимостьДЕПО,
		|	_ДанныеВыводов.РыночнаяСтоимостьДЕПО КАК РыночнаяСтоимостьДЕПО,
		|	_ДанныеВыводов.БалансоваяСтоимостьЦБ КАК БалансоваяСтоимостьЦБ,
		|	_ДанныеВыводов.РыночнаяСтоимостьЦБ КАК РыночнаяСтоимостьЦБ,
		|	РеквизитыКонтрагента.ИНН КАК ИННКонтрагента,
		|	РеквизитыКонтрагента.КПП КАК КППКонтрагента
		|ИЗ
		|	_ДанныеВыводов КАК _ДанныеВыводов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						_ДанныеВыводов.Контрагент
		|					ИЗ
		|						_ДанныеВыводов)) КАК РеквизитыКонтрагента
		|		ПО (РеквизитыКонтрагента.ЮрФизЛицо = _ДанныеВыводов.Контрагент)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВЫБОР
		|		КОГДА _ДанныеВыводов.ЦельВывода ЕСТЬ NULL
		|				ИЛИ _ДанныеВыводов.ЦельВывода = ЗНАЧЕНИЕ(Справочник.ЦелиВозвратаДенежныхСредств.ПустаяСсылка)
		|			ТОГДА 1
		|		КОГДА ТИПЗНАЧЕНИЯ(_ДанныеВыводов.ЦельВывода) = ТИП(Справочник.ЦелиВозвратаДенежныхСредств)
		|			ТОГДА 2
		|		ИНАЧЕ 3
		|	КОНЕЦ,
		|	ЦельВывода,
		|	ДатаПлатежногоДокумента
		|ИТОГИ
		|	СУММА(БалансоваяСтоимость),
		|	СУММА(РыночнаяСтоимость),
		|	СУММА(БалансоваяСтоимостьДС),
		|	СУММА(РыночнаяСтоимостьДС),
		|	СУММА(БалансоваяСтоимостьДЕПО),
		|	СУММА(РыночнаяСтоимостьДЕПО),
		|	СУММА(БалансоваяСтоимостьЦБ),
		|	СУММА(РыночнаяСтоимостьЦБ)
		|ПО
		|	ОБЩИЕ,
		|	ЦельВывода
		|АВТОУПОРЯДОЧИВАНИЕ");
	
	Запрос.УстановитьПараметр("Организация",					РеквизитыСчетаДУ.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЮрФизЛицоКлиента",				ЮрФизЛицоКлиента);
	Запрос.УстановитьПараметр("ДатаНачала",						Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",					Период.ДатаОкончания);
	
	#КонецОбласти
	
	ЦельВыводаПоУмолчанию = "Прочие выводы";
	
	ИтогиРаздела = Новый Структура;
	ИтогиРаздела.Вставить("БалансоваяСтоимость",		0);
	ИтогиРаздела.Вставить("РыночнаяСтоимость",			0);
	ИтогиРаздела.Вставить("БалансоваяСтоимостьДС",		0);
	ИтогиРаздела.Вставить("РыночнаяСтоимостьДС",		0);
	ИтогиРаздела.Вставить("БалансоваяСтоимостьДЕПО",	0);
	ИтогиРаздела.Вставить("РыночнаяСтоимостьДЕПО",		0);
	ИтогиРаздела.Вставить("БалансоваяСтоимостьЦБ",		0);
	ИтогиРаздела.Вставить("РыночнаяСтоимостьЦБ",		0);	

	ВыборкаРаздела = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаРаздела.Следующий() Цикл
		
		НомерПодраздела = 0;
		
		ВыборкаПодраздела = ВыборкаРаздела.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаПодраздела.Следующий() Цикл		
			
			// Шапка цели вывода
			
			ОшибкаОпределенияЦели = Ложь;
			
			НомерПодраздела = НомерПодраздела + 1;
			
			ДополнительныеДанныеПодраздела = Новый Структура("НомерПодраздела", НомерПодраздела);
			
			Если ЗначениеЗаполнено(ВыборкаПодраздела.ЦельВывода) Тогда	
				
				ПрефиксЦели = "";
				
				Если ТипЗнч(ВыборкаПодраздела.ЦельВывода) = Тип("СправочникСсылка.ЦелиВозвратаДенежныхСредств")
					И Не СтрНачинаетсяС(ВРег(ВыборкаПодраздела.ПредставлениеЦелиВывода), "ВЫВОД")
				Тогда
					ПрефиксЦели = "Вывод ";	
				КонецЕсли;
				
				ДополнительныеДанныеПодраздела.Вставить("ЦельВывода", ПрефиксЦели + ВыборкаПодраздела.ПредставлениеЦелиВывода);
				
			Иначе
				
				ОшибкаОпределенияЦели = Истина;
				
				ДополнительныеДанныеПодраздела.Вставить("ЦельВывода", ЦельВыводаПоУмолчанию);
				
			КонецЕсли;
			
			ОбластьЦельВывода = Макет.ПолучитьОбласть("ЦельВывода");
			
			ОбластьЦельВывода.Параметры.Заполнить(ДополнительныеДанныеПодраздела);
		
			ТабличныйДокумент.Вывести(ОбластьЦельВывода);
			
			// Строки 
			
			НомерСтроки = 0;
			
			ВыборкаСтрок = ВыборкаПодраздела.Выбрать(ОбходРезультатаЗапроса.Прямой);
			
			Пока ВыборкаСтрок.Следующий() Цикл
				
				НомерСтроки = НомерСтроки + 1;
				
				ДополнительныеДанныеСтроки = Новый Структура("НомерСтроки, НаименованиеИРеквизитыУК", СтрШаблон("%1.%2", НомерПодраздела, НомерСтроки), "-");
				
				ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
				
				ОбластьСтрока.Параметры.Заполнить(ВыборкаСтрок);
				ОбластьСтрока.Параметры.Заполнить(ДополнительныеДанныеСтроки);
			
				ТабличныйДокумент.Вывести(ОбластьСтрока);
				
				Если ОшибкаОпределенияЦели Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						СтрШаблон("Ошибка определения цели вывода имущества для документа '%1'. Документ выведен с целью '%2'.", ВыборкаСтрок.Регистратор, ЦельВыводаПоУмолчанию), ВыборкаСтрок.Регистратор);
				КонецЕсли;
				
			КонецЦикла;
			
			// Итоги по цели вывода
			
			ОбластьИтогоПоЦелиВывода = Макет.ПолучитьОбласть("ИтогоПоЦелиВывода");
			
			ОбластьИтогоПоЦелиВывода.Параметры.Заполнить(ВыборкаПодраздела);
			ОбластьИтогоПоЦелиВывода.Параметры.Заполнить(ДополнительныеДанныеПодраздела);
		
			ТабличныйДокумент.Вывести(ОбластьИтогоПоЦелиВывода);
			
		КонецЦикла;
		
		ЗаполнитьЗначенияСвойств(ИтогиРаздела, ВыборкаРаздела);	
		
	КонецЦикла;
	
	// Итоги раздела "Вывод"

	ОбластьИтогоПоРазделу = Макет.ПолучитьОбласть("ИтогоПоРазделу");

	ОбластьИтогоПоРазделу.Параметры.Заполнить(ИтогиРаздела);
	
	ТабличныйДокумент.Вывести(ОбластьИтогоПоРазделу);
	
	// Подвал
	
	Если ЗначениеЗаполнено(РеквизитыСчетаДУ.СпециализированныйДепозитарий) Тогда
		ИмяОбластиСпецДепа = "Спецдеп";	
	Иначе	
		ИмяОбластиСпецДепа = Неопределено;	
	КонецЕсли;
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	УдалитьОбластиЯчеекТабличногоДокумента(ОбластьПодвал, "Спецдеп", ИмяОбластиСпецДепа);
		
	ОбластьПодвал.Параметры.Заполнить(РеквизитыАкта);
	
	ТабличныйДокумент.Вывести(ОбластьПодвал);	
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СформироватьАктПриемаПередачиИмущества_Будущее(МассивДокументов, ТабличныйДокумент, ИмяМакета, ДанныеОтправителя, ДанныеПолучателя, ДанныеСобственника, ПереводВнутриУК, ДоговорПолучателяПриПереводеВнутриУК)

	Если МассивДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Проверяем, что в выбранных документах одинаковый номер поручения
	Если МассивДокументов.Количество() > 1 Тогда
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ВложенныйЗапрос.НомерПоручения КАК НомерПоручения
			|ИЗ
			|	(ВЫБРАТЬ
			|		ВЫРАЗИТЬ(ВыводДенежныхСредств.Основание КАК Документ.ПоручениеНаДвижениеДенежныхСредств).НомерВходящегоДокумента КАК НомерПоручения
			|	ИЗ
			|		Документ.ВыводДенежныхСредств КАК ВыводДенежныхСредств
			|	ГДЕ
			|		ВыводДенежныхСредств.Ссылка В (&Документы)
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ВыводЦенныхБумаг.Поручение.НомерВходящегоДокумента
			|	ИЗ
			|		Документ.ВыводЦенныхБумаг КАК ВыводЦенныхБумаг
			|	ГДЕ
			|		ВыводЦенныхБумаг.Ссылка В (&Документы)) КАК ВложенныйЗапрос");
		
		Запрос.УстановитьПараметр("Документы", МассивДокументов);
		
		НомераПоручений = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("НомерПоручения");
		
		Если НомераПоручений.Количество() > 1 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В выбранных документах различные номера поручений:%1%2", Символы.ПС, СтрСоединить(НомераПоручений, Символы.ПС))); 
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
		
	Документ = МассивДокументов[0];
	
	РеквизитыАкта = Новый Структура;
	
	#Область Заполнение_реквизитов_акта	
	
	// Реквизиты документа
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ,
		Новый Структура("Организация, СчетДоверительногоУправления, Дата, ВалютаУчета",
			"Организация", "СчетДоверительногоУправления", "Дата", "Организация.ВалютаУчета"));
	
	РеквизитыАкта.Вставить("Регистратор",		Документ);
	РеквизитыАкта.Вставить("ДатаПоступления",	РеквизитыДокумента.Дата);
	
	// Дополнительные реквизиты документа, получаем в зависимости от вида документа
	
	ДопРеквизитыДокумента = Новый Структура;
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.ВыводЦенныхБумаг") Тогда
		
		ДопРеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, Новый Структура("ДатаВходящегоДокумента, НомерВходящегоДокумента",
			"ВЫРАЗИТЬ(Поручение КАК Документ.ПоручениеНаДвижениеЦенныхБумаг).ДатаВходящегоДокумента",
			"ВЫРАЗИТЬ(Поручение КАК Документ.ПоручениеНаДвижениеЦенныхБумаг).НомерВходящегоДокумента"));
		
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ВыводДенежныхСредств") Тогда
		
		ДопРеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ,
			Новый Структура("ДатаВходящегоДокумента, НомерВходящегоДокумента, ОписаниеДенежныхСредств, ДатаПлатежногоДокумента, НомерПлатежногоДокумента",
				"ВЫРАЗИТЬ(Основание КАК Документ.ПоручениеНаДвижениеДенежныхСредств).ДатаВходящегоДокумента",
				"ВЫРАЗИТЬ(Основание КАК Документ.ПоручениеНаДвижениеДенежныхСредств).НомерВходящегоДокумента",
				"ВЫРАЗИТЬ(Основание КАК Документ.ПоручениеНаДвижениеДенежныхСредств).ОписаниеДенежныхСредств",
				"СтрокаБанковскойВыписки.ДатаПлатежногоДокумента",
				"СтрокаБанковскойВыписки.НомерПлатежногоДокумента"));
		
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ВыводКредитногоИнструмента") Тогда
		
		ДопРеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, Новый Структура("ДатаВходящегоДокумента, НомерВходящегоДокумента", "Дата", "Номер"));
		
	КонецЕсли;	
	
	РаботаСКоллекциями.ДополнитьСтруктуру(РеквизитыАкта, ДопРеквизитыДокумента);
	
	Если ДопРеквизитыДокумента.Свойство("ДатаВходящегоДокумента") Тогда
		РеквизитыАкта.Вставить("ДатаВходящегоДокумента_ddMMyyyy", Формат(ДопРеквизитыДокумента.ДатаВходящегоДокумента, "ДФ='dd.MM.yyyy'"));
	КонецЕсли;
	
	Если ДопРеквизитыДокумента.Свойство("ДатаВходящегоДокумента") И ДопРеквизитыДокумента.Свойство("НомерВходящегоДокумента")
		И (ЗначениеЗаполнено(ДопРеквизитыДокумента.ДатаВходящегоДокумента) ИЛИ ЗначениеЗаполнено(ДопРеквизитыДокумента.НомерВходящегоДокумента))
	Тогда
		РеквизитыАкта.Вставить("ВходящийДокумент",
			"Требование № "
			+ ?(ЗначениеЗаполнено(ДопРеквизитыДокумента.НомерВходящегоДокумента), ДопРеквизитыДокумента.НомерВходящегоДокумента, "б/н")
			+ ?(ЗначениеЗаполнено(ДопРеквизитыДокумента.ДатаВходящегоДокумента), " от " + Формат(ДопРеквизитыДокумента.ДатаВходящегоДокумента, "ДФ=dd.MM.yyyy"), ""));
	КонецЕсли;
	
	Если ДопРеквизитыДокумента.Свойство("ОписаниеДенежныхСредств") Тогда
		РеквизитыАкта.Вставить("ПредставлениеЦелиВывода", СтрШаблон("(%1)", ДопРеквизитыДокумента.ОписаниеДенежныхСредств));
	КонецЕсли;	
	
	Если ДопРеквизитыДокумента.Свойство("ДатаПлатежногоДокумента") И ДопРеквизитыДокумента.Свойство("НомерПлатежногоДокумента")
		И (ЗначениеЗаполнено(ДопРеквизитыДокумента.ДатаПлатежногоДокумента) ИЛИ ЗначениеЗаполнено(ДопРеквизитыДокумента.НомерПлатежногоДокумента))
	Тогда
		РеквизитыАкта.Вставить("ПлатежныйДокумент",
			"№ "
			+ ?(ЗначениеЗаполнено(ДопРеквизитыДокумента.НомерПлатежногоДокумента), ДопРеквизитыДокумента.НомерПлатежногоДокумента, "б/н")
			+ ?(ЗначениеЗаполнено(ДопРеквизитыДокумента.ДатаПлатежногоДокумента), " от " + Формат(ДопРеквизитыДокумента.ДатаПлатежногоДокумента, "ДФ=dd.MM.yyyy"), ""));
	КонецЕсли;
	
	РеквизитыАкта.Вставить("ТекстПолучателяИмущества", ?(ПереводВнутриУК, " в договор № " + СокрЛП(ДоговорПолучателяПриПереводеВнутриУК), ", а Фонд получил"));
	
	// Реквизиты счета д/у
	
	РеквизитыСчетаДУ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыДокумента.СчетДоверительногоУправления,
		Новый Структура("ДатаЗаключенияДоговора, НомерДоговора, ВидДоговораДоверительногоУправления, СпециализированныйДепозитарий, ЮрЛицоСпецДепозитария",
			"ДатаЗаключения", "НомерДоговора", "ВидДоговораДоверительногоУправления", "СпециализированныйДепозитарий", "СпециализированныйДепозитарий.ЮрФизЛицо"));
	
	РеквизитыАкта.Вставить("НомерДоговора",						РеквизитыСчетаДУ.НомерДоговора);	
	РеквизитыАкта.Вставить("ДатаЗаключенияДоговора_ddMMMMyyyy",	Формат(РеквизитыСчетаДУ.ДатаЗаключенияДоговора, "ДФ='dd MMMM yyyy'"));
	РеквизитыАкта.Вставить("ДатаЗаключенияДоговора_ddMMyyyy",	Формат(РеквизитыСчетаДУ.ДатаЗаключенияДоговора, "ДФ='dd.MM.yyyy'"));
	
	// Реквизиты клиента
	
	РеквизитыКлиента = ПолучитьРеквизитыСобственникаИмущества(РеквизитыДокумента.Организация, РеквизитыДокумента.СчетДоверительногоУправления, РеквизитыДокумента.Дата, ДанныеСобственника.БанковскийСчет);
			
	РеквизитыАкта.Вставить("КраткоеНаименованиеКлиента",	РеквизитыКлиента.Наименование);
	РеквизитыАкта.Вставить("ПолноеНаименованиеКлиента",		РеквизитыКлиента.ПолноеНаименование);
	РеквизитыАкта.Вставить("РеквизитыКлиента",				РеквизитыКлиента.Реквизиты);	
	РеквизитыАкта.Вставить("ОКУДКлиента",					РеквизитыКлиента.ОКУД);
	РеквизитыАкта.Вставить("ОКПОКлиента",					РеквизитыКлиента.ОКПО);
	
	РеквизитыАкта.Вставить("ДолжностьРуководителяКлиента",				"                                     ");
	РеквизитыАкта.Вставить("ДолжностьРуководителяКлиента_РП",			"                                     ");
	РеквизитыАкта.Вставить("ОснованиеПолномочийРуководителяКлиента",	"                                     ");
	РеквизитыАкта.Вставить("РуководительКлиента",						"                                     ");
	РеквизитыАкта.Вставить("РуководительКлиента_РП",					"                                     ");
	
	Если ДанныеСобственника.ДанныеКонтактногоЛица <> Неопределено Тогда
		Если ЗначениеЗаполнено(ДанныеСобственника.ДанныеКонтактногоЛица.Должность) Тогда
			РеквизитыАкта.Вставить("ДолжностьРуководителяКлиента",	  ДанныеСобственника.ДанныеКонтактногоЛица.Должность);
			РеквизитыАкта.Вставить("ДолжностьРуководителяКлиента_РП", ПолучитьСклоненияСтроки(ДанныеСобственника.ДанныеКонтактногоЛица.Должность, , "ПД=Родительный")[0]);
		КонецЕсли;	
		Если ЗначениеЗаполнено(ДанныеСобственника.ДанныеКонтактногоЛица.ОснованиеПолномочий) Тогда
			РеквизитыАкта.Вставить("ОснованиеПолномочийРуководителяКлиента",	ДанныеСобственника.ДанныеКонтактногоЛица.ОснованиеПолномочий);
			РеквизитыАкта.Вставить("ОснованиеПолномочийРуководителяКлиента_РП", ПолучитьСклоненияСтроки(ДанныеСобственника.ДанныеКонтактногоЛица.ОснованиеПолномочий, , "ПД=Родительный")[0]);
		КонецЕсли;	
		Если ЗначениеЗаполнено(ДанныеСобственника.ДанныеКонтактногоЛица.КонтактноеЛицо) Тогда
			РеквизитыАкта.Вставить("РуководительКлиента",	 ДанныеСобственника.ДанныеКонтактногоЛица.КонтактноеЛицо);
			РеквизитыАкта.Вставить("РуководительКлиента_РП", ПолучитьСклоненияСтроки(ДанныеСобственника.ДанныеКонтактногоЛица.КонтактноеЛицо, , "ПД=Родительный")[0]);
		КонецЕсли;	
	КонецЕсли;	
	
	// Реквизиты отправителя (УК, передавшая имущество)
	
	РеквизитыОтправителя = ПолучитьРеквизитыОтправителя(РеквизитыДокумента.Организация, РеквизитыДокумента.СчетДоверительногоУправления, РеквизитыДокумента.Дата, ДанныеОтправителя.БанковскийСчет);	
	
	РеквизитыАкта.Вставить("КраткоеНаименованиеОтправителя",	РеквизитыОтправителя.КраткоеНаименование);
	РеквизитыАкта.Вставить("ПолноеНаименованиеОтправителя",		РеквизитыОтправителя.ПолноеНаименование);
	РеквизитыАкта.Вставить("НаименованиеОтправителяВДоговоре",	РеквизитыОтправителя.Наименование);
	РеквизитыАкта.Вставить("РеквизитыОтправителя",				РеквизитыОтправителя.Реквизиты);
	РеквизитыАкта.Вставить("ОКУДОтправителя",					РеквизитыОтправителя.ОКУД);
	РеквизитыАкта.Вставить("ОКПООтправителя",					РеквизитыОтправителя.ОКПО);	
	
	РеквизитыАкта.Вставить("ДолжностьРуководителяОтправителя",				"                                     ");
	РеквизитыАкта.Вставить("ДолжностьРуководителяОтправителя_РП",			"                                     ");
	РеквизитыАкта.Вставить("ОснованиеПолномочийРуководителяОтправителя",	"                                     ");
	РеквизитыАкта.Вставить("РуководительОтправителя",						"                                     ");
	РеквизитыАкта.Вставить("РуководительОтправителя_РП",					"                                     ");
	
	Если ДанныеОтправителя.ДанныеКонтактногоЛица <> Неопределено Тогда
		Если ЗначениеЗаполнено(ДанныеОтправителя.ДанныеКонтактногоЛица.Должность) Тогда 
			РеквизитыАкта.Вставить("ДолжностьРуководителяОтправителя",	  ДанныеОтправителя.ДанныеКонтактногоЛица.Должность);
			РеквизитыАкта.Вставить("ДолжностьРуководителяОтправителя_РП", ПолучитьСклоненияСтроки(ДанныеОтправителя.ДанныеКонтактногоЛица.Должность, , "ПД=Родительный")[0]);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеОтправителя.ДанныеКонтактногоЛица.ОснованиеПолномочий) Тогда
			РеквизитыАкта.Вставить("ОснованиеПолномочийРуководителяОтправителя",	ДанныеОтправителя.ДанныеКонтактногоЛица.ОснованиеПолномочий);
			РеквизитыАкта.Вставить("ОснованиеПолномочийРуководителяОтправителя_РП", ПолучитьСклоненияСтроки(ДанныеОтправителя.ДанныеКонтактногоЛица.ОснованиеПолномочий, , "ПД=Родительный")[0]);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеОтправителя.ДанныеКонтактногоЛица.КонтактноеЛицо) Тогда
			РеквизитыАкта.Вставить("РуководительОтправителя",	 ДанныеОтправителя.ДанныеКонтактногоЛица.КонтактноеЛицо);
			РеквизитыАкта.Вставить("РуководительОтправителя_РП", ПолучитьСклоненияСтроки(ДанныеОтправителя.ДанныеКонтактногоЛица.КонтактноеЛицо, , "ПД=Родительный")[0]);
		КонецЕсли;
	КонецЕсли;
	
	// Реквизиты получателя (УК, получившая имущество)
	
	РеквизитыПолучателя = ПолучитьРеквизитыПолучателя(РеквизитыДокумента.Организация, ДанныеПолучателя.ЮрФизЛицо, РеквизитыДокумента.Дата, ДанныеПолучателя.БанковскийСчет, ПереводВнутриУК);	
	
	РеквизитыАкта.Вставить("НаименованиеПолучателя",	РеквизитыПолучателя.Наименование);
	РеквизитыАкта.Вставить("РеквизитыПолучателя",		РеквизитыПолучателя.Реквизиты);
	РеквизитыАкта.Вставить("ОКУДПолучателя",			РеквизитыПолучателя.ОКУД);
	РеквизитыАкта.Вставить("ОКПОПолучателя",			РеквизитыПолучателя.ОКПО);
	
	РеквизитыАкта.Вставить("ДолжностьРуководителяПолучателя",	?(ПереводВнутриУК, РеквизитыАкта.ДолжностьРуководителяОтправителя, 	""));
	РеквизитыАкта.Вставить("РуководительПолучателя",			?(ПереводВнутриУК, РеквизитыАкта.РуководительОтправителя, 			"                                     "));
	
	// Реквизиты специализированного депозитария
	
	Если ЗначениеЗаполнено(РеквизитыСчетаДУ.СпециализированныйДепозитарий) Тогда
	
		РеквизитыСпецДепозитария = ПолучитьРеквизитыСпецДепозитария(РеквизитыСчетаДУ.ЮрЛицоСпецДепозитария, РеквизитыДокумента.Дата);
		
		РеквизитыАкта.Вставить("КраткоеНаименованиеСпецдепа", РеквизитыСпецДепозитария.КраткоеНаименование);
		
	КонецЕсли;	
	
	// Общие сведения
	
	РеквизитыАкта.Вставить("ДатаСоставления",			ТекущаяДата());
	РеквизитыАкта.Вставить("МестоСоставления",			"г. Москва");
	
	#КонецОбласти
	
	Макет = Обработки.ПечатьАктовПриемаПередачиИмущества.ПолучитьМакет(ИмяМакета);	
	
	// Шапка
	
	ОбластьШапкаДоОснования = Макет.ПолучитьОбласть("Шапка_ДоОснования");
	
	ОбластьШапкаДоОснования.Параметры.Заполнить(РеквизитыАкта);
	
	ТабличныйДокумент.Вывести(ОбластьШапкаДоОснования);	
	
	Если ПереводВнутриУК Тогда 
		
		ОбластьШапкаОснование = Макет.ПолучитьОбласть("Шапка_Основание");		
		ОбластьШапкаОснование.Параметры.Заполнить(РеквизитыАкта);
		
		ПозицияОт = СтрНайти(ДоговорПолучателяПриПереводеВнутриУК, " от ");
		
		Если ПозицияОт > 0 Тогда
			НомерДоговораПолучателя = СокрЛП(Лев(ДоговорПолучателяПриПереводеВнутриУК, ПозицияОт-1));
			ДатаДоговораПолучателя  = СокрЛП(Сред(ДоговорПолучателяПриПереводеВнутриУК, ПозицияОт + 3));	
			ОбластьШапкаОснование.Параметры.НомерДоговораПолучателя 					= НомерДоговораПолучателя;
			ОбластьШапкаОснование.Параметры.ДатаЗаключенияДоговораПолучателя_ddMMyyyy 	= ДатаДоговораПолучателя;
		КонецЕсли;	
			
		ТабличныйДокумент.Вывести(ОбластьШапкаОснование);	
		
	КонецЕсли;
	
	ОбластьШапкаКонец = Макет.ПолучитьОбласть("Шапка_Конец");
	
	ОбластьШапкаКонец.Параметры.Заполнить(РеквизитыАкта);
	
	ТабличныйДокумент.Вывести(ОбластьШапкаКонец);	
	
	// Данные документа	
	
	#Область Запрос_данных_документа
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ЦенныеБумаги) КАК ВидАктива,
		|	ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(ЦенныеБумаги.Количество) КАК Количество,
		|	СУММА(ЦенныеБумаги.СуммаРынокВВалютеУчета) КАК РыночнаяСтоимостьБезНКД,
		|	СУММА(ЦенныеБумаги.СуммаКупонаРынокВВалютеУчета) КАК РыночнаяСтоимостьНКД,
		|	NULL КАК БалансоваяСтоимостьБезНКД,
		|	NULL КАК БалансоваяСтоимостьНКДУплаченный,
		|	NULL КАК БалансоваяСтоимостьНКДНачисленный
		|ПОМЕСТИТЬ _ОбъединенныеДанные
		|ИЗ
		|	Документ.ВыводЦенныхБумаг.ЦенныеБумаги КАК ЦенныеБумаги
		|ГДЕ
		|	ЦенныеБумаги.Ссылка В(&Документы)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЦенныеБумаги.ЦеннаяБумага
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ЦенныеБумаги),
		|	БухПартииЦенныхБумаг.ЦеннаяБумага,
		|	NULL,
		|	NULL,
		|	NULL,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета + БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета + БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета + БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета + БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета - БухПартииЦенныхБумаг.СуммаРезервовПодОбесценение),
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета),
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета)
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор В(&Документы)
		|	И ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумаг.Регистратор) = ТИП(Документ.ВыводЦенныхБумаг)
		|	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.ЦеннаяБумага
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВводыВыводыАктивовВВалютеУчета.ВидАктива,
		|	NULL,
		|	NULL,
