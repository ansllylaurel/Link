		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&КонецПериода, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ)) КАК КодыВТорговыхСистемахКодНаММВБ
		|		ПО _ИтоговаяТаблица.ЦеннаяБумага = КодыВТорговыхСистемахКодНаММВБ.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&КонецПериода, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахISIN
		|		ПО _ИтоговаяТаблица.ЦеннаяБумага = КодыВТорговыхСистемахISIN.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыводДенежныхСредств КАК ВыводДенежныхСредств
		|		ПО (ВыводДенежныхСредств.Ссылка = &Регистратор)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоручениеНаДвижениеДенежныхСредств КАК ПоручениеНаДвижениеДенежныхСредств
		|		ПО (ПоручениеНаДвижениеДенежныхСредств.Ссылка = ВыводДенежныхСредств.Основание)
		|ИТОГИ
		|	СУММА(РыночнаяСтоимость),
		|	СУММА(РыночнаяСтоимостьБезНКД),
		|	СУММА(РыночнаяСтоимостьНКД),
		|	СУММА(БалансоваяСтоимость),
		|	СУММА(БалансоваяСтоимостьБезНКД),
		|	СУММА(БалансоваяСтоимостьНКДУплаченный),
		|	СУММА(БалансоваяСтоимостьНКДНачисленный)
		|ПО
		|	ОБЩИЕ");
	
	Запрос.УстановитьПараметр("Регистратор", Документ);
	Запрос.УстановитьПараметр("КонецПериода", РеквизитыДокумента.Дата);
	
	#КонецОбласти
	
	ИтогиПоДокументу = Новый Структура;
	ИтогиПоДокументу.Вставить("БалансоваяСтоимость",				0);
	ИтогиПоДокументу.Вставить("БалансоваяСтоимостьБезНКД",			0);
	ИтогиПоДокументу.Вставить("БалансоваяСтоимостьНКДУплаченный",	0);
	ИтогиПоДокументу.Вставить("БалансоваяСтоимостьНКДНачисленный",	0);
	ИтогиПоДокументу.Вставить("БалансоваяСтоимостьПрописью",		"____________________________________________________________________________");
	
	ИтогиПоДокументу.Вставить("РыночнаяСтоимость",					0);
	ИтогиПоДокументу.Вставить("РыночнаяСтоимостьБезНКД",			0);
	ИтогиПоДокументу.Вставить("РыночнаяСтоимостьНКД",				0);
	ИтогиПоДокументу.Вставить("РыночнаяСтоимостьПрописью",			"____________________________________________________________________________");
	
	ВыборкаПоДокументу = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ВыборкаПоДокументу.Следующий() Тогда	
		
		// Строки
		
		ВыборкаПоЦеннойБумаги = ВыборкаПоДокументу.Выбрать(ОбходРезультатаЗапроса.Прямой);
		
		Пока ВыборкаПоЦеннойБумаги.Следующий() Цикл
			
			Если ЗначениеЗаполнено(ВыборкаПоЦеннойБумаги.ПоручениеНаДвижениеДенежныхСредств) И Не ЗначениеЗаполнено(ВыборкаПоЦеннойБумаги.ЦельВывода) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Не заполнено описание денежных средств в '%1'", ВыборкаПоЦеннойБумаги.ПоручениеНаДвижениеДенежныхСредств),
					ВыборкаПоЦеннойБумаги.ПоручениеНаДвижениеДенежныхСредств, "ОписаниеДенежныхСредств");
			КонецЕсли;
			
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
			
			ОбластьСтрока.Параметры.Заполнить(РеквизитыАкта);
			ОбластьСтрока.Параметры.Заполнить(ВыборкаПоЦеннойБумаги);
			
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			
		КонецЦикла;
		
		// Итоги по документу
		
		ЗаполнитьЗначенияСвойств(ИтогиПоДокументу, ВыборкаПоДокументу); 
		
		Если ЗначениеЗаполнено(ИтогиПоДокументу.БалансоваяСтоимость) Тогда 
			ИтогиПоДокументу.БалансоваяСтоимостьПрописью = СуммаВРубляхПрописью(ИтогиПоДокументу.БалансоваяСтоимость);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Балансовая стоимость имущества не рассчитана", Документ);
		КонецЕсли;
		
		ИтогиПоДокументу.РыночнаяСтоимостьПрописью = СуммаВРубляхПрописью(ИтогиПоДокументу.РыночнаяСтоимость);
		
	КонецЕсли;	
	
	// Подвал
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьПодвал.Параметры.Заполнить(РеквизитыАкта);
	ОбластьПодвал.Параметры.Заполнить(ИтогиПоДокументу);
	
	ТабличныйДокумент.Вывести(ОбластьПодвал);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СформироватьАктПриемаПередачиДенежныхСредств2021(Документ, ТабличныйДокумент, ИмяМакета, ДанныеОтправителя, ДанныеПолучателя, ДанныеСобственника, ПереводВнутриУК)

	РеквизитыАкта = Новый Структура;
	
	#Область Заполнение_реквизитов_акта	
	
	// Реквизиты документа
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, "Организация, СчетДоверительногоУправления, Дата");
	
	РеквизитыАкта.Вставить("Регистратор",		Документ);
	РеквизитыАкта.Вставить("ДатаПоступления",	РеквизитыДокумента.Дата);
	
	// Дополнительные реквизиты документа, получаем в зависимости от вида документа
	
	ДопРеквизитыДокумента = Новый Структура;
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.ВыводЦенныхБумаг") Тогда
		
		ДопРеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, Новый Структура("ДатаВходящегоДокумента, НомерВходящегоДокумента",
			"ВЫРАЗИТЬ(Поручение КАК Документ.ПоручениеНаДвижениеЦенныхБумаг).ДатаВходящегоДокумента",
			"ВЫРАЗИТЬ(Поручение КАК Документ.ПоручениеНаДвижениеЦенныхБумаг).НомерВходящегоДокумента"));
		
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ВыводДенежныхСредств") Тогда
		
		ДопРеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ,
			Новый Структура("ДатаВходящегоДокумента, НомерВходящегоДокумента, ДатаПлатежногоДокумента, НомерПлатежногоДокумента",
				"ВЫРАЗИТЬ(Основание КАК Документ.ПоручениеНаДвижениеДенежныхСредств).ДатаВходящегоДокумента",
				"ВЫРАЗИТЬ(Основание КАК Документ.ПоручениеНаДвижениеДенежныхСредств).НомерВходящегоДокумента",
				"СтрокаБанковскойВыписки.ДатаПлатежногоДокумента",
				"СтрокаБанковскойВыписки.НомерПлатежногоДокумента"));
		
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ВыводКредитногоИнструмента") Тогда
		
		ДопРеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, Новый Структура("ДатаВходящегоДокумента, НомерВходящегоДокумента", "Дата", "Номер"));
		
	КонецЕсли;	
	
	РаботаСКоллекциями.ДополнитьСтруктуру(РеквизитыАкта, ДопРеквизитыДокумента);
				
	Если ДопРеквизитыДокумента.Свойство("ДатаВходящегоДокумента") И ДопРеквизитыДокумента.Свойство("НомерВходящегоДокумента")
		И (ЗначениеЗаполнено(ДопРеквизитыДокумента.ДатаВходящегоДокумента) ИЛИ ЗначениеЗаполнено(ДопРеквизитыДокумента.НомерВходящегоДокумента))
	Тогда
		РеквизитыАкта.Вставить("ВходящийДокумент",
			?(ЗначениеЗаполнено(ДопРеквизитыДокумента.НомерВходящегоДокумента), "№ " + ДопРеквизитыДокумента.НомерВходящегоДокумента, "б/н")
			+ ?(ЗначениеЗаполнено(ДопРеквизитыДокумента.ДатаВходящегоДокумента), " от " + Формат(ДопРеквизитыДокумента.ДатаВходящегоДокумента, "ДФ=dd.MM.yyyy"), ""));
	КонецЕсли;
		
	Если ДопРеквизитыДокумента.Свойство("ДатаПлатежногоДокумента") И ДопРеквизитыДокумента.Свойство("НомерПлатежногоДокумента")
		И (ЗначениеЗаполнено(ДопРеквизитыДокумента.ДатаПлатежногоДокумента) ИЛИ ЗначениеЗаполнено(ДопРеквизитыДокумента.НомерПлатежногоДокумента))
	Тогда
		РеквизитыАкта.Вставить("ПлатежныйДокумент",
			?(ЗначениеЗаполнено(ДопРеквизитыДокумента.НомерПлатежногоДокумента), "№ " + ДопРеквизитыДокумента.НомерПлатежногоДокумента, "б/н")
			+ ?(ЗначениеЗаполнено(ДопРеквизитыДокумента.ДатаПлатежногоДокумента), " от " + Формат(ДопРеквизитыДокумента.ДатаПлатежногоДокумента, "ДФ=dd.MM.yyyy"), ""));
	КонецЕсли;
		
	// Реквизиты счета д/у
	
	РеквизитыСчетаДУ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыДокумента.СчетДоверительногоУправления,
		Новый Структура("ДатаЗаключенияДоговора, НомерДоговора, ВидДоговораДоверительногоУправления, СпециализированныйДепозитарий, ЮрЛицоСпецДепозитария",
			"ДатаЗаключения", "НомерДоговора", "ВидДоговораДоверительногоУправления", "СпециализированныйДепозитарий", "СпециализированныйДепозитарий.ЮрФизЛицо"));
	
	РеквизитыАкта.Вставить("НомерДоговора",						РеквизитыСчетаДУ.НомерДоговора);	
	РеквизитыАкта.Вставить("ДатаЗаключенияДоговора_ddMMMMyyyy",	Формат(РеквизитыСчетаДУ.ДатаЗаключенияДоговора, "ДФ='dd MMMM yyyy'"));
	РеквизитыАкта.Вставить("ДатаЗаключенияДоговора_ddMMyyyy",	Формат(РеквизитыСчетаДУ.ДатаЗаключенияДоговора, "ДФ='dd.MM.yyyy'"));
	
	// Реквизиты клиента
	
	РеквизитыКлиента = ПолучитьРеквизитыСобственникаИмущества(РеквизитыДокумента.Организация, РеквизитыДокумента.СчетДоверительногоУправления, РеквизитыДокумента.Дата, ДанныеСобственника.БанковскийСчет);
			
	РеквизитыАкта.Вставить("КраткоеНаименованиеКлиента",	РеквизитыКлиента.Наименование);
	РеквизитыАкта.Вставить("ПолноеНаименованиеКлиента",		РеквизитыКлиента.ПолноеНаименование);
	РеквизитыАкта.Вставить("РеквизитыКлиента",				РеквизитыКлиента.Реквизиты);	
	РеквизитыАкта.Вставить("ОКУДКлиента",					РеквизитыКлиента.ОКУД);
	РеквизитыАкта.Вставить("ОКПОКлиента",					РеквизитыКлиента.ОКПО);
	
	Если ДанныеСобственника.ДанныеКонтактногоЛица = Неопределено Тогда
		РеквизитыАкта.Вставить("ДолжностьРуководителяКлиента",	"");
		РеквизитыАкта.Вставить("РуководительКлиента",			"____________________");
	Иначе
		РеквизитыАкта.Вставить("ДолжностьРуководителяКлиента",	ДанныеСобственника.ДанныеКонтактногоЛица.Должность);
		РеквизитыАкта.Вставить("РуководительКлиента",			ДанныеСобственника.ДанныеКонтактногоЛица.КонтактноеЛицо);
	КонецЕсли;	
	
	// Реквизиты отправителя (УК, передавшая имущество)
	
	РеквизитыОтправителя = ПолучитьРеквизитыОтправителя(РеквизитыДокумента.Организация, РеквизитыДокумента.СчетДоверительногоУправления, РеквизитыДокумента.Дата, ДанныеОтправителя.БанковскийСчет);	
	
	РеквизитыАкта.Вставить("КраткоеНаименованиеОтправителя",	РеквизитыОтправителя.КраткоеНаименование);
	РеквизитыАкта.Вставить("ПолноеНаименованиеОтправителя",		РеквизитыОтправителя.ПолноеНаименование);
	РеквизитыАкта.Вставить("НаименованиеОтправителяВДоговоре",	РеквизитыОтправителя.Наименование);
	РеквизитыАкта.Вставить("РеквизитыОтправителя",				РеквизитыОтправителя.Реквизиты);
	РеквизитыАкта.Вставить("ОКУДОтправителя",					РеквизитыОтправителя.ОКУД);
	РеквизитыАкта.Вставить("ОКПООтправителя",					РеквизитыОтправителя.ОКПО);	
	
	Если ДанныеОтправителя.ДанныеКонтактногоЛица = Неопределено Тогда
		РеквизитыАкта.Вставить("ДолжностьРуководителяОтправителя",	"");
		РеквизитыАкта.Вставить("РуководительОтправителя",			"____________________");
	Иначе
		РеквизитыАкта.Вставить("ДолжностьРуководителяОтправителя",	ДанныеОтправителя.ДанныеКонтактногоЛица.Должность);
		РеквизитыАкта.Вставить("РуководительОтправителя",			ДанныеОтправителя.ДанныеКонтактногоЛица.КонтактноеЛицо);
	КонецЕсли;
	
	// Реквизиты получателя (УК, получившая имущество)
	
	РеквизитыПолучателя = ПолучитьРеквизитыПолучателя(РеквизитыДокумента.Организация, ДанныеПолучателя.ЮрФизЛицо, РеквизитыДокумента.Дата, ДанныеПолучателя.БанковскийСчет, ПереводВнутриУК);	
	
	РеквизитыАкта.Вставить("НаименованиеПолучателя",	РеквизитыПолучателя.Наименование);
	РеквизитыАкта.Вставить("РеквизитыПолучателя",		РеквизитыПолучателя.Реквизиты);
	РеквизитыАкта.Вставить("ОКУДПолучателя",			РеквизитыПолучателя.ОКУД);
	РеквизитыАкта.Вставить("ОКПОПолучателя",			РеквизитыПолучателя.ОКПО);
	
	РеквизитыАкта.Вставить("ДолжностьРуководителяПолучателя",	?(ПереводВнутриУК, РеквизитыАкта.ДолжностьРуководителяОтправителя, ""));
	РеквизитыАкта.Вставить("РуководительПолучателя",			?(ПереводВнутриУК, РеквизитыАкта.РуководительОтправителя, "____________________"));
		
	// Реквизиты специализированного депозитария
		
	Если ЗначениеЗаполнено(РеквизитыСчетаДУ.СпециализированныйДепозитарий) Тогда
	
		РеквизитыСпецДепозитария = ПолучитьРеквизитыСпецДепозитария(РеквизитыСчетаДУ.ЮрЛицоСпецДепозитария, РеквизитыДокумента.Дата);
		
		РеквизитыАкта.Вставить("КраткоеНаименованиеСпецдепа", РеквизитыСпецДепозитария.КраткоеНаименование);
		
	КонецЕсли;	
	
	// Общие сведения
	
	РеквизитыАкта.Вставить("ДатаСоставления",	ТекущаяДата());
	РеквизитыАкта.Вставить("МестоСоставления",	"г. Москва");
	
	#КонецОбласти
	
	Макет = Обработки.ПечатьАктовПриемаПередачиИмущества.ПолучитьМакет(ИмяМакета);	
	
	// Шапка
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		
	ОбластьШапка.Параметры.Заполнить(РеквизитыАкта);
	
	ТабличныйДокумент.Вывести(ОбластьШапка);	
	
	// Данные документа	
	
	#Область Запрос_данных_документа
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ЦенныеБумаги) КАК ВидАктива,
		|	ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(ЦенныеБумаги.Количество) КАК Количество,
		|	СУММА(ЦенныеБумаги.СуммаРынокВВалютеУчета + ЦенныеБумаги.СуммаКупонаРынокВВалютеУчета) КАК РыночнаяСтоимость,
		|	NULL КАК БалансоваяСтоимость
		|ПОМЕСТИТЬ _ОбъединенныеДанные
		|ИЗ
		|	Документ.ВыводЦенныхБумаг.ЦенныеБумаги КАК ЦенныеБумаги
		|ГДЕ
		|	ЦенныеБумаги.Ссылка = &Регистратор
		|
		|СГРУППИРОВАТЬ ПО
		|	ЦенныеБумаги.ЦеннаяБумага
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ЦенныеБумаги),
		|	БухПартииЦенныхБумаг.ЦеннаяБумага,
		|	NULL,
		|	NULL,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета + БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета + БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета + БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета + БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета + БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета + БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета - БухПартииЦенныхБумаг.СуммаРезервовПодОбесценение)
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумаг.Регистратор) = ТИП(Документ.ВыводЦенныхБумаг)
		|	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.ЦеннаяБумага
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВводыВыводыАктивовВВалютеУчета.ВидАктива,
		|	NULL,
		|	NULL,
		|	ВводыВыводыАктивовВВалютеУчета.РыночнаяСтоимость,
		|	ВводыВыводыАктивовВВалютеУчета.БалансоваяСтоимость
		|ИЗ
		|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
		|ГДЕ
		|	ВводыВыводыАктивовВВалютеУчета.Регистратор = &Регистратор
		|	И ТИПЗНАЧЕНИЯ(ВводыВыводыАктивовВВалютеУчета.Регистратор) <> ТИП(Документ.ВыводЦенныхБумаг)
		|	И ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОбъединенныеДанные.ВидАктива КАК ВидАктива,
		|	_ОбъединенныеДанные.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЕСТЬNULL(СУММА(_ОбъединенныеДанные.Количество), 0) КАК Количество,
		|	ЕСТЬNULL(СУММА(_ОбъединенныеДанные.РыночнаяСтоимость), 0) КАК РыночнаяСтоимость,
		|	ЕСТЬNULL(СУММА(_ОбъединенныеДанные.БалансоваяСтоимость), 0) КАК БалансоваяСтоимость
		|ПОМЕСТИТЬ _ИтоговаяТаблица
		|ИЗ
		|	_ОбъединенныеДанные КАК _ОбъединенныеДанные
		|
		|СГРУППИРОВАТЬ ПО
		|	_ОбъединенныеДанные.ВидАктива,
		|	_ОбъединенныеДанные.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИтоговаяТаблица.ВидАктива КАК ВидАктива,
		|	_ИтоговаяТаблица.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ПоручениеНаДвижениеДенежныхСредств.Ссылка КАК ПоручениеНаДвижениеДенежныхСредств,
		|	ПоручениеНаДвижениеДенежныхСредств.ОписаниеДенежныхСредств КАК ЦельВывода,
		|	ВЫБОР
		|		КОГДА ПоручениеНаДвижениеДенежныхСредств.ОписаниеДенежныхСредств ЕСТЬ НЕ NULL 
		|			ТОГДА ""Денежные средства, "" + ПоручениеНаДвижениеДенежныхСредств.ОписаниеДенежныхСредств.Наименование
		|		КОГДА _ИтоговаяТаблица.ЦеннаяБумага ЕСТЬ НЕ NULL 
		|			ТОГДА ВЫБОР
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|						ТОГДА ""Пай""
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|						ТОГДА ""Акция""
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|						ТОГДА ""Вексель""
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|						ТОГДА ""Депозитарная расписка""
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Доли
		|						ТОГДА ""Доля""
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|						ТОГДА ""Ипотечный сертификат участия""
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|						ТОГДА ""Облигация""
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Закладные
		|						ТОГДА ""Закладная""
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.ПроизводныеФинансовыеИнструменты
		|						ТОГДА ВЫБОР
		|								КОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Фьючерс)
		|									ТОГДА ""Фьючерс""
		|								КОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Опцион)
		|									ТОГДА ""Опцион""
		|							КОНЕЦ
		|				КОНЕЦ + ВЫБОР
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|						ТОГДА "", "" + РеквизитыПИФСрезПоследних.КраткоеНаименованиеФонда
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|						ТОГДА "", "" + ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Акции).Эмитент.Наименование)
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|						ТОГДА "", "" + ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.Наименование)
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|						ТОГДА "", "" + ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.Наименование)
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Доли
		|						ТОГДА "", "" + ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Доли).ЮрЛицо.Наименование)
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|						ТОГДА "", "" + ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.Наименование)
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|						ТОГДА "", "" + ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.Наименование)
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Закладные
		|						ТОГДА "", "" + ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Закладные).Банк.Наименование)
		|					ИНАЧЕ """"
		|				КОНЕЦ + ВЫБОР
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|							И ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер <> """"
		|						ТОГДА "", "" + ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|							И ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ГосударственныйРегистрационныйНомер <> """"
		|						ТОГДА "", "" + ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ГосударственныйРегистрационныйНомер
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|							И ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер <> """"
		|						ТОГДА "", "" + ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|							И ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер <> """"
		|						ТОГДА "", "" + ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|							И ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Векселя).Номер <> """"
		|						ТОГДА "", "" + ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Векселя).Номер
		|					КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|							И ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).РегистрационныйНомер <> """"
		|						ТОГДА "", "" + ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).РегистрационныйНомер
		|					ИНАЧЕ "", "" + ЕСТЬNULL(КодыВТорговыхСистемахISIN.Код, КодыВТорговыхСистемахКодНаММВБ.Код)
		|				КОНЕЦ
		|		ИНАЧЕ _ИтоговаяТаблица.ВидАктива
		|	КОНЕЦ КАК Имущество,
		|	_ИтоговаяТаблица.Количество КАК Количество,
		|	_ИтоговаяТаблица.РыночнаяСтоимость КАК РыночнаяСтоимость,
		|	_ИтоговаяТаблица.БалансоваяСтоимость КАК БалансоваяСтоимость
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&КонецПериода,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (ВЫБОР
		|				КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|				КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
		|				КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.ЮрФизЛицо
		|				КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Доли
		|					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Доли).ЮрЛицо
		|				КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
		|				КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|				КОГДА _ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Закладные
		|					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Закладные).Банк.ЮрФизЛицо
		|			КОНЕЦ = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&КонецПериода, ) КАК РеквизитыПИФСрезПоследних
		|		ПО (_ИтоговаяТаблица.ЦеннаяБумага ССЫЛКА Справочник.Паи)
		|			И (ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&КонецПериода, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ)) КАК КодыВТорговыхСистемахКодНаММВБ
		|		ПО _ИтоговаяТаблица.ЦеннаяБумага = КодыВТорговыхСистемахКодНаММВБ.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&КонецПериода, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахISIN
		|		ПО _ИтоговаяТаблица.ЦеннаяБумага = КодыВТорговыхСистемахISIN.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыводДенежныхСредств КАК ВыводДенежныхСредств
		|		ПО (ВыводДенежныхСредств.Ссылка = &Регистратор)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоручениеНаДвижениеДенежныхСредств КАК ПоручениеНаДвижениеДенежныхСредств
		|		ПО (ПоручениеНаДвижениеДенежныхСредств.Ссылка = ВыводДенежныхСредств.Основание)
		|ИТОГИ
		|	СУММА(РыночнаяСтоимость),
		|	СУММА(БалансоваяСтоимость)
		|ПО
		|	ОБЩИЕ");
	
	Запрос.УстановитьПараметр("Регистратор", Документ);
	Запрос.УстановитьПараметр("КонецПериода", РеквизитыДокумента.Дата);
	
	#КонецОбласти
	
	ВыборкаПоДокументу = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ВыборкаПоДокументу.Следующий() Тогда	
		
		// Строки
		
		ВыборкаПоСтроке = ВыборкаПоДокументу.Выбрать(ОбходРезультатаЗапроса.Прямой);
		
		Пока ВыборкаПоСтроке.Следующий() Цикл
			
			ДополнительныеДанныеСтроки = Новый Структура;
			
			Если ВыборкаПоСтроке.ВидАктива = Перечисления.ВидыАктивов.ДенежныеСредства Тогда
				ДополнительныеДанныеСтроки.Вставить("Количество", Формат(ВыборкаПоСтроке.РыночнаяСтоимость, "ЧДЦ=2; ЧН=-; ЧФ='Ч руб.'"));	
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаПоСтроке.ПоручениеНаДвижениеДенежныхСредств) И Не ЗначениеЗаполнено(ВыборкаПоСтроке.ЦельВывода) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Не заполнено описание денежных средств в '%1'", ВыборкаПоСтроке.ПоручениеНаДвижениеДенежныхСредств),
					ВыборкаПоСтроке.ПоручениеНаДвижениеДенежныхСредств, "ОписаниеДенежныхСредств");
			КонецЕсли;
			
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
			
			ОбластьСтрока.Параметры.Заполнить(РеквизитыАкта);
			ОбластьСтрока.Параметры.Заполнить(ВыборкаПоСтроке);
			ОбластьСтрока.Параметры.Заполнить(ДополнительныеДанныеСтроки);
			
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			
		КонецЦикла;
		
		// Итоги по документу
		
		Если Не ЗначениеЗаполнено(ВыборкаПоДокументу.БалансоваяСтоимость) Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Балансовая стоимость имущества не рассчитана", Документ);
		КонецЕсли;
		
	КонецЕсли;	
	
	// Подвал
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьПодвал.Параметры.Заполнить(РеквизитыАкта);
	
	ТабличныйДокумент.Вывести(ОбластьПодвал);

КонецПроцедуры

#Область Вспомогательные_функции

&НаСервереБезКонтекста
Процедура УдалитьОбластиЯчеекТабличногоДокумента(ТабличныйДокумент, ПрефиксУдаляемыхОбластей, ИмяИсключаемойИзУдаленияОбласти)
	
	ОбластиКУдалению = Новый Массив;
	
	Для Каждого Область Из ТабличныйДокумент.Области Цикл
		Если СтрНачинаетсяС(Область.Имя, ПрефиксУдаляемыхОбластей) И Область.Имя <> ИмяИсключаемойИзУдаленияОбласти Тогда
			ОбластиКУдалению.Добавить(Область.Имя);	
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Область Из ОбластиКУдалению Цикл
		ТабличныйДокумент.УдалитьОбласть(ТабличныйДокумент.Области[Область], ТипСмещенияТабличногоДокумента.ПоГоризонтали);	
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыСобственникаИмущества(Организация, СчетДУ, Период, БанковскийСчет = Неопределено)
	
	СтруктураРеквизитов = Новый Структура("Наименование, ПолноеНаименование, ОКПО, ОКУД, Реквизиты");
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДУ,
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	СчетаДоверительногоУправления.Наименование КАК Наименование,
		|	Клиенты.Клиент КАК Клиент
		|ПОМЕСТИТЬ _Клиент
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДУ) КАК Клиенты
		|		ПО (Клиенты.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеквизитыФизЛица.Фамилия + "" "" + ПОДСТРОКА(РеквизитыФизЛица.Имя, 1, 1) + "". "" + ПОДСТРОКА(РеквизитыФизЛица.Отчество, 1, 1) + "". "" КАК Наименование,
		|	РеквизитыФизЛица.Фамилия + "" "" + РеквизитыФизЛица.Имя + "" "" + РеквизитыФизЛица.Отчество КАК ПолноеНаименование,
		|	"""" КАК ОКПО,
		|	РеквизитыФизЛица.Телефоны КАК Телефон
		|ПОМЕСТИТЬ _РеквизитыЛица
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо В
		|					(ВЫБРАТЬ
		|						_Клиент.Клиент
		|					ИЗ
		|						_Клиент)) КАК РеквизитыФизЛица
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	РеквизитыЮрЛица.КраткоеНаименованиеПоУставу,
		|	РеквизитыЮрЛица.ПолноеНаименованиеПоУставу,
		|	РеквизитыЮрЛица.КодПоОКПО,
		|	РеквизитыЮрЛица.Телефоны
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо В
		|					(ВЫБРАТЬ
		|						_Клиент.Клиент
		|					ИЗ
		|						_Клиент)) КАК РеквизитыЮрЛица
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РеквизитыПИФСрезПоследних.КраткоеНаименованиеФонда,
		|	РеквизитыПИФСрезПоследних.ПолноеНаименованиеФонда,
		|	"""",
		|	""""
		|ИЗ
		|	Справочник.ПаевыеИнвестиционныеФонды КАК ПИФ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Клиент КАК _Клиент
		|		ПО (_Клиент.Клиент = ПИФ.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&Период, ) КАК РеквизитыПИФСрезПоследних
		|		ПО ПИФ.Ссылка = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	БанковскиеСчета.НомерСчета КАК НомерСчета,
		|	БанковскиеСчета.Банк.Наименование КАК Банк,
		|	БанковскиеСчета.Банк.Город КАК Город,
		|	БанковскиеСчета.Банк.КоррСчет КАК КоррСчет,
		|	БанковскиеСчета.Банк.Код КАК БИК
		|ПОМЕСТИТЬ _БанковскиеСчета
		|ИЗ
		|	_Клиент КАК _Клиент
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		|		ПО (БанковскиеСчета.Ссылка = &БанковскийСчет)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_РеквизитыЛица.Наименование, _Клиент.Наименование) КАК Наименование,
		|	ЕСТЬNULL(_РеквизитыЛица.ПолноеНаименование, _Клиент.Наименование) КАК ПолноеНаименование,
		|	_РеквизитыЛица.ОКПО КАК ОКПО,
		|	_РеквизитыЛица.Телефон КАК Телефон,
		|	_БанковскиеСчета.НомерСчета КАК НомерСчета,
		|	_БанковскиеСчета.Банк КАК Банк,
		|	_БанковскиеСчета.Город КАК Город,
		|	_БанковскиеСчета.КоррСчет КАК КоррСчет,
		|	_БанковскиеСчета.БИК КАК БИК
		|ИЗ
		|	_Клиент КАК _Клиент
		|		ПОЛНОЕ СОЕДИНЕНИЕ _РеквизитыЛица КАК _РеквизитыЛица
		|		ПО (ИСТИНА)
		|		ПОЛНОЕ СОЕДИНЕНИЕ _БанковскиеСчета КАК _БанковскиеСчета
		|		ПО (ИСТИНА)");
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДУ", СчетДУ);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчет);
	
	РеквизитыОбъекта = Запрос.Выполнить();
	
	Если Не РеквизитыОбъекта.Пустой() Тогда
		РезультатЗапроса = РеквизитыОбъекта.Выгрузить()[0];
		
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, РезультатЗапроса);
		
		Если ЗначениеЗаполнено(РезультатЗапроса.Телефон) Тогда
			СтруктураРеквизитов.Реквизиты = "тел. " + РезультатЗапроса.Телефон;
		КонецЕсли;
			
		Если ЗначениеЗаполнено(РезультатЗапроса.Банк) Тогда
			СтруктураРеквизитов.Реквизиты = ?(ЗначениеЗаполнено(СтруктураРеквизитов.Реквизиты), СтруктураРеквизитов.Реквизиты + Символы.ПС, "") +  
				РезультатЗапроса.Банк + " " + РезультатЗапроса.Город + ", БИК " + РезультатЗапроса.БИК
				+ Символы.ПС + "р/с " + РезультатЗапроса.НомерСчета
				+ ?(ЗначениеЗаполнено(РезультатЗапроса.КоррСчет), Символы.ПС + "к/с " + РезультатЗапроса.КоррСчет, "");
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыПолучателя(Организация, Получатель, Период, БанковскийСчет = Неопределено, ПереводВнутриУК = Ложь)
	
	СтруктураРеквизитов = Новый Структура("Наименование, ОКПО, ОКУД, Реквизиты");
	
	Если Не ЗначениеЗаполнено(Получатель) Тогда
		Возврат СтруктураРеквизитов;
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеквизитыФизЛицаАнкетные.Фамилия + "" "" + ПОДСТРОКА(РеквизитыФизЛицаАнкетные.Имя, 1, 1) + "". "" + ПОДСТРОКА(РеквизитыФизЛицаАнкетные.Отчество, 1, 1) + "". "" КАК Наименование,
		|	"""" КАК ОКПО
		|ПОМЕСТИТЬ _РеквизитыЛица
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо = &Получатель) КАК РеквизитыФизЛицаАнкетные
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЕСТЬNULL(РеквизитыЮрЛицаАнкетные.КраткоеНаименованиеПоУставу, РеквизитыЮрЛица.КраткоеНаименованиеПоУставу),
		|	ЕСТЬNULL(РеквизитыЮрЛицаАнкетные.КодПоОКПО, РеквизитыЮрЛица.КодПоОКПО)
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо = &Получатель) КАК РеквизитыЮрЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И ЮрФизЛицо = &Получатель) КАК РеквизитыЮрЛицаАнкетные
		|		ПО РеквизитыЮрЛица.ЮрФизЛицо = РеквизитыЮрЛицаАнкетные.ЮрФизЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ЕСТЬNULL(РеквизитыЮридическихЛицАнкетныеСрезПоследних.Телефоны, КонтактыЛица.Представление) КАК Телефон
		|ПОМЕСТИТЬ _КонтактыЛица
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация.СрезПоследних(
		|			&Период,
		|			Объект = &Получатель
		|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.Телефон)) КАК КонтактыЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И ЮрФизЛицо = &Получатель) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО КонтактыЛица.Объект = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	БанковскиеСчета.НомерСчета КАК НомерСчета,
		|	БанковскиеСчета.Банк.Наименование КАК Банк,
		|	БанковскиеСчета.Банк.Город КАК Город,
		|	БанковскиеСчета.Банк.КоррСчет КАК КоррСчет,
		|	БанковскиеСчета.Банк.Код КАК БИК,
		|	БанковскиеСчета.Договор.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДляДокументов
		|ПОМЕСТИТЬ _БанковскиеСчета
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|ГДЕ
		|	БанковскиеСчета.Ссылка = &БанковскийСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА &ПереводВнутриУК
		|			ТОГДА _БанковскиеСчета.НаименованиеВладельцаДляДокументов
		|		ИНАЧЕ _РеквизитыЛица.Наименование
		|	КОНЕЦ КАК Наименование,
		|	_РеквизитыЛица.ОКПО КАК ОКПО,
		|	_КонтактыЛица.Телефон КАК Телефон,
		|	_БанковскиеСчета.НомерСчета КАК НомерСчета,
		|	_БанковскиеСчета.Банк КАК Банк,
		|	_БанковскиеСчета.Город КАК Город,
		|	_БанковскиеСчета.КоррСчет КАК КоррСчет,
		|	_БанковскиеСчета.БИК КАК БИК
		|ИЗ
		|	_РеквизитыЛица КАК _РеквизитыЛица
		|		ПОЛНОЕ СОЕДИНЕНИЕ _КонтактыЛица КАК _КонтактыЛица
		|		ПО (ИСТИНА)
		|		ПОЛНОЕ СОЕДИНЕНИЕ _БанковскиеСчета КАК _БанковскиеСчета
		|		ПО (ИСТИНА)");
	
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("Получатель",			Получатель);
	Запрос.УстановитьПараметр("Период",				НачалоДня(Период));
	Запрос.УстановитьПараметр("БанковскийСчет",		БанковскийСчет);
	Запрос.УстановитьПараметр("ПереводВнутриУК",	ПереводВнутриУК);	
	
	РеквизитыОбъекта = Запрос.Выполнить();
	
	Если Не РеквизитыОбъекта.Пустой() Тогда
		
		РезультатЗапроса = РеквизитыОбъекта.Выгрузить()[0];
		
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, РезультатЗапроса);
		
		Если ЗначениеЗаполнено(РезультатЗапроса.Телефон) Тогда
			СтруктураРеквизитов.Реквизиты = "тел. " + РезультатЗапроса.Телефон;
		КонецЕсли;
			
		Если ЗначениеЗаполнено(РезультатЗапроса.Банк) Тогда
			СтруктураРеквизитов.Реквизиты = ?(ЗначениеЗаполнено(СтруктураРеквизитов.Реквизиты), СтруктураРеквизитов.Реквизиты + Символы.ПС, "") +  
				РезультатЗапроса.Банк + " " + РезультатЗапроса.Город + ", БИК " + РезультатЗапроса.БИК
				+ Символы.ПС + "р/с " + РезультатЗапроса.НомерСчета
				+ ?(ЗначениеЗаполнено(РезультатЗапроса.КоррСчет), Символы.ПС + "к/с " + РезультатЗапроса.КоррСчет, "");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции	

