
#Область Обработчики_событий_формы_и_элементов

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЭтаФорма.Параметры.Свойство("Документ") Тогда
		
		ФормированиеПоДокументу	= Истина;
		
		Объект.Документ		= ЭтаФорма.Параметры.Документ;		
		РеквизитыДокумента 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Документ, "Организация, СчетДоверительногоУправления, Контрагент");
		
		Объект.СчетДоверительногоУправления = РеквизитыДокумента.СчетДоверительногоУправления;
		Объект.Организация					= РеквизитыДокумента.Организация;
		Получатель 							= РеквизитыДокумента.Контрагент;
		
		ОпределитьПереводВнутриУК(ЭтаФорма);		
		
		// Проверим возможность формирования по выбранному документу

		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		Если Не ОбработкаОбъект.ПроверитьВозможностьПечатиДокумента(Отказ) Тогда
			Возврат;	
		КонецЕсли;
		
	Иначе
		
		ФормированиеПоДокументу	= Ложь;
		
		Объект.Организация	= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
		Объект.Период		= Новый СтандартныйПериод(ВариантСтандартногоПериода.ПрошлыйМесяц);
		
	КонецЕсли;
	
	ПриИзмененииРежимаФормирования(ЭтаФорма);		
	
	// Даем полноправному пользователю возможность изменять организацию 
	
	Элементы.Организация.Видимость			= РаботаСПользователями.ЭтоПолноправныйПользователь();
	Элементы.ОрганизацияНадпись.Видимость	= Не Элементы.Организация.Видимость;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	
	// При создании формы часть реквизитов может быть заполнена по переданным параметрам,
	// в этом случаем подменяем сохраненные настройки на них.
	// При изменении владельца очищаем подчиненные настройки.
	
	// Получатель
	
	Если ЗначениеЗаполнено(БанковскийСчетПолучателя) Тогда
		Настройки.Вставить("БанковскийСчетПолучателя", БанковскийСчетПолучателя);
	ИначеЕсли Получатель <> Настройки.Получить("Получатель") Тогда
		Настройки.Вставить("БанковскийСчетПолучателя", Неопределено);
	КонецЕсли;
	
	Настройки.Вставить("Получатель", Получатель);
	
	// Отправитель
	
	Если ЗначениеЗаполнено(БанковскийСчетОтправителя) Тогда
		Настройки.Вставить("БанковскийСчетОтправителя", БанковскийСчетОтправителя);
	ИначеЕсли Отправитель <> Настройки.Получить("Отправитель") Тогда
		Настройки.Вставить("БанковскийСчетОтправителя", Неопределено);
	КонецЕсли;
	
	Настройки.Вставить("Отправитель", Отправитель);
	
	// Фонд
	
	Если ЗначениеЗаполнено(БанковскийСчетФонда) Тогда
		Настройки.Вставить("БанковскийСчетФонда", БанковскийСчетФонда);
	ИначеЕсли Фонд <> Настройки.Получить("Фонд") Тогда
		Настройки.Вставить("БанковскийСчетФонда", Неопределено);
	КонецЕсли;
	
	Настройки.Вставить("Фонд", Фонд); 	
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма, "Объект.Организация");
	
	ЭтаФорма.СтруктураДанныхКонтактногоЛицаУК1		= Настройки.Получить("СтруктураДанныхКонтактногоЛицаУК1");
	ЭтаФорма.СтруктураДанныхКонтактногоЛицаФонда	= Настройки.Получить("СтруктураДанныхКонтактногоЛицаФонда");	
	
	РаботаСОтчетамиКлиентСервер.ПроверитьНастройкиПодписанта(ЭтаФорма.ПодписантУКПередавшейИмущество, ЭтаФорма.СтруктураДанныхКонтактногоЛицаУК1,	Объект.Организация);
	РаботаСОтчетамиКлиентСервер.ПроверитьНастройкиПодписанта(ЭтаФорма.ПодписантФонда,				  ЭтаФорма.СтруктураДанныхКонтактногоЛицаФонда,	ЭтаФорма.Фонд);

	УстановитьВариантФормированияАкта(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(Объект.Документ) И ЗначениеЗаполнено(Объект.Вариант) Тогда		
		КомандаСформироватьАкт(Неопределено);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)

	Если ЭтаФорма.ФормированиеПоДокументу И Не ЗначениеЗаполнено(Объект.Документ) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан список документов", , "СписокДокументов", , Отказ);
		ПроверяемыеРеквизиты.Очистить();
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

