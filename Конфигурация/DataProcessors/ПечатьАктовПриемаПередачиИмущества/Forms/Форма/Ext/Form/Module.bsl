Функция ПолучитьРеквизитыОтправителя(Организация, СчетДУ, Период, БанковскийСчет = Неопределено)
	
	СтруктураРеквизитов = Новый Структура("Наименование, КраткоеНаименование, ПолноеНаименование, ОКПО, ОКУД, Реквизиты");
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДУ,
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	СчетаДоверительногоУправления.Организация.ЮрФизЛицо КАК ЮрЛицоОрганизации,
		|	СчетаДоверительногоУправления.Организация.Наименование КАК НаименованиеОрганизации,
		|	СчетаДоверительногоУправления.Наименование КАК Наименование,
		|	Клиенты.Клиент КАК Клиент
		|ПОМЕСТИТЬ _Клиент
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДУ) КАК Клиенты
		|		ПО (Клиенты.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеквизитыОрганизации.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	РеквизитыОрганизации.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	РеквизитыОрганизации.КодПоОКПО КАК ОКПО,
		|	РеквизитыОрганизации.Телефоны КАК Телефон
		|ПОМЕСТИТЬ _РеквизитыОрганизации
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо В
		|					(ВЫБРАТЬ
		|						_Клиент.ЮрЛицоОрганизации
		|					ИЗ
		|						_Клиент)) КАК РеквизитыОрганизации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	БанковскиеСчета.НомерСчета КАК НомерСчета,
		|	БанковскиеСчета.Банк.Наименование КАК Банк,
		|	БанковскиеСчета.Банк.Город КАК Город,
		|	БанковскиеСчета.Банк.КоррСчет КАК КоррСчет,
		|	БанковскиеСчета.Банк.Код КАК БИК,
		|	БанковскиеСчета.Договор.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДляДокументов
		|ПОМЕСТИТЬ _БанковскиеСчета
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|ГДЕ
		|	БанковскиеСчета.Ссылка = &БанковскийСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА _БанковскиеСчета.НаименованиеВладельцаДляДокументов ЕСТЬ НЕ NULL 
		|				И _БанковскиеСчета.НаименованиеВладельцаДляДокументов <> """"
		|			ТОГДА _БанковскиеСчета.НаименованиеВладельцаДляДокументов
		|		ИНАЧЕ ЕСТЬNULL(_РеквизитыОрганизации.КраткоеНаименованиеПоУставу, _Клиент.НаименованиеОрганизации)
		|	КОНЕЦ КАК Наименование,
		|	ЕСТЬNULL(_РеквизитыОрганизации.КраткоеНаименованиеПоУставу, _Клиент.НаименованиеОрганизации) КАК КраткоеНаименование,
		|	ЕСТЬNULL(_РеквизитыОрганизации.ПолноеНаименованиеПоУставу, _Клиент.НаименованиеОрганизации) КАК ПолноеНаименование,
		|	_РеквизитыОрганизации.ОКПО КАК ОКПО,
		|	_РеквизитыОрганизации.Телефон КАК Телефон,
		|	_БанковскиеСчета.НомерСчета КАК НомерСчета,
		|	_БанковскиеСчета.Банк КАК Банк,
		|	_БанковскиеСчета.Город КАК Город,
		|	_БанковскиеСчета.КоррСчет КАК КоррСчет,
		|	_БанковскиеСчета.БИК КАК БИК
		|ИЗ
		|	_Клиент КАК _Клиент
		|		ПОЛНОЕ СОЕДИНЕНИЕ _РеквизитыОрганизации КАК _РеквизитыОрганизации
		|		ПО (ИСТИНА)
		|		ПОЛНОЕ СОЕДИНЕНИЕ _БанковскиеСчета КАК _БанковскиеСчета
		|		ПО (ИСТИНА)");
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДУ", СчетДУ);
	Запрос.УстановитьПараметр("Период", НачалоДня(Период));
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчет);
	
	РеквизитыОбъекта = Запрос.Выполнить();
	
	Если Не РеквизитыОбъекта.Пустой() Тогда
		
		РезультатЗапроса = РеквизитыОбъекта.Выгрузить()[0];
		
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, РезультатЗапроса);
		
		Если ЗначениеЗаполнено(РезультатЗапроса.Телефон) Тогда
			СтруктураРеквизитов.Реквизиты = "тел. " + РезультатЗапроса.Телефон;
		КонецЕсли;
			
		Если ЗначениеЗаполнено(РезультатЗапроса.Банк) Тогда
			СтруктураРеквизитов.Реквизиты = ?(ЗначениеЗаполнено(СтруктураРеквизитов.Реквизиты), СтруктураРеквизитов.Реквизиты + Символы.ПС, "") +  
				РезультатЗапроса.Банк + " " + РезультатЗапроса.Город + ", БИК " + РезультатЗапроса.БИК
				+ Символы.ПС + "р/с " + РезультатЗапроса.НомерСчета
				+ ?(ЗначениеЗаполнено(РезультатЗапроса.КоррСчет), Символы.ПС + "к/с " + РезультатЗапроса.КоррСчет, "");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыСпецДепозитария(Объект, Период)
	
	СтруктураРеквизитов = Новый Структура("КраткоеНаименование");
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеквизитыЮрКлиента.КраткоеНаименованиеПоУставу КАК КраткоеНаименование
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо = &Объект) КАК РеквизитыЮрКлиента");
	
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("Период", Период);	
	
	РеквизитыОбъекта = Запрос.Выполнить();
	
	Если Не РеквизитыОбъекта.Пустой() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, РеквизитыОбъекта.Выгрузить()[0]);	
	Иначе // Уведомляем при отсуствии анкеты
		СтруктураРеквизитов.КраткоеНаименование = Строка(Объект);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют реквизиты специализированного депозитария """ + Строка(Объект) + """", Объект);		
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаСервереБезКонтекста
Функция СуммаВРубляхПрописью(Сумма)
	
	Возврат Строка(Цел(Сумма))
		+ " (" + ЧислоПрописью(Цел(Сумма), "НП=ЛОЖЬ;НД=ЛОЖЬ", ",,,,,,,,0") + ") " 
		+ РаботаСоСтрокамиКлиентСервер.ФормаМножественногоЧисла(Цел(Сумма), "рубль ", "рубля ", "рублей ")
		+ СтрЗаменить(ЧислоПрописью(Сумма - Цел(Сумма), "НП=ЛОЖЬ", ",,,,копейка,копейки,копеек,ж,2"), "Ноль ", "");
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область Прочие_процедуры_и_функции

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииРежимаФормирования(ЭтаФорма)
	
	Если ЭтаФорма.ФормированиеПоДокументу Тогда
				
		ПриИзмененииДокумента(ЭтаФорма);		
		
	Иначе
		
		ЭтаФорма.Объект.Документ = Неопределено;
		ЭтаФорма.СписокДокументов.Очистить();
		
		ПриИзмененииСчетаДоверительногоУправленияИПериода(ЭтаФорма);
		
	КонецЕсли;
	
	УстановитьПараметрыВыбораДокументов(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииДокумента(ЭтаФорма)

	Если ЗначениеЗаполнено(ЭтаФорма.Объект.Документ) Тогда
		ЭтаФорма.СписокДокументов.Добавить(ЭтаФорма.Объект.Документ);
	КонецЕсли;
	
	РеквизитыДокумента = ПолучитьРеквизитыДокумента(ЭтаФорма.Объект.Документ);
	
	ПриИзмененииКлиентаПолучателяОтправителя(ЭтаФорма,
		РеквизитыДокумента.Клиент, РеквизитыДокумента.Получатель, РеквизитыДокумента.Отправитель,
		РеквизитыДокумента.БанковскийСчетКлиента, РеквизитыДокумента.БанковскийСчетПолучателя, РеквизитыДокумента.БанковскийСчетОтправителя);
	
	УстановитьВариантФормированияАкта(ЭтаФорма);
	УстановитьПараметрыВыбораДокументов(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииСчетаДоверительногоУправленияИПериода(ЭтаФорма)

	Объект = ЭтаФорма.Объект;	
	
	НовыйКлиент = ПолучитьФондПоСчетуДоверительногоУправления(Объект.СчетДоверительногоУправления, Объект.Период.ДатаОкончания);
	
	ПриИзмененииКлиентаПолучателяОтправителя(ЭтаФорма, НовыйКлиент, Неопределено, НовыйКлиент);
	
	УстановитьВариантФормированияАкта(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОпределитьПереводВнутриУК(Форма)
	
	Форма.ПереводВнутриУК = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Форма.Объект.Организация, "ЮрФизЛицо") = Форма.Получатель;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииКлиентаПолучателяОтправителя(ЭтаФорма, НовыйКлиент, НовыйПолучатель, НовыйОтправитель, БанковскийСчетКлиента = Неопределено, БанковскийСчетПолучателя = Неопределено, БанковскийСчетОтправителя = Неопределено)
	
	// Фонд
	
	Если ЗначениеЗаполнено(БанковскийСчетКлиента) Тогда
		
		ЭтаФорма.БанковскийСчетФонда = БанковскийСчетКлиента;
		
	ИначеЕсли ЭтаФорма.Фонд <> НовыйКлиент Тогда
		
		ЭтаФорма.ПодписантФонда							= Неопределено;
		ЭтаФорма.СтруктураДанныхКонтактногоЛицаФонда	= Неопределено;
		ЭтаФорма.БанковскийСчетФонда					= Неопределено;
		
	КонецЕсли;
	
	ЭтаФорма.Фонд = НовыйКлиент;
	
	// Получатель	
	
	Если ЗначениеЗаполнено(БанковскийСчетПолучателя) Тогда
		
		ЭтаФорма.БанковскийСчетПолучателя = БанковскийСчетПолучателя;
		
	ИначеЕсли ЭтаФорма.Получатель <> НовыйПолучатель Тогда
		
		ЭтаФорма.БанковскийСчетПолучателя = Неопределено;
		
	КонецЕсли;	
	
	ЭтаФорма.Получатель = НовыйПолучатель;
	
	// Отправитель
	
	Если ЗначениеЗаполнено(БанковскийСчетОтправителя) Тогда
		
		ЭтаФорма.БанковскийСчетОтправителя = БанковскийСчетОтправителя;
		
	ИначеЕсли ЭтаФорма.Отправитель <> НовыйОтправитель Тогда
		
		ЭтаФорма.БанковскийСчетОтправителя = Неопределено;
		
	КонецЕсли;	
	
	ЭтаФорма.Отправитель = НовыйОтправитель;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВариантФормированияАкта(ЭтаФорма)
	
	// Если последний использованный вариант подходит для формирования акта,
	// то используем его, иначе - формируем первый доступный	
	
	Объект					= ЭтаФорма.Объект;
	СписокВыбораВариантов	= ЭтаФорма.Элементы.Вариант.СписокВыбора;
	
	ДоступныеМакеты = ПолучитьДоступныеМакеты(Объект.Документ, Объект.СчетДоверительногоУправления);
	
	СписокВыбораВариантов.Очистить();
	Для Каждого ЭлементСписка Из ДоступныеМакеты Цикл
		СписокВыбораВариантов.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
	
	Если СписокВыбораВариантов.НайтиПоЗначению(Объект.Вариант) = Неопределено Тогда
		Объект.Вариант = ?(СписокВыбораВариантов.Количество() = 0, Неопределено, СписокВыбораВариантов[0].Значение);	
	КонецЕсли;
	
	// Параметры элементов формы
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	ПриИзмененииПараметровШапки(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииПараметровШапки(ЭтаФорма)
	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(ЭтаФорма.Элементы.ТабличныйДокумент, "НЕАКТУАЛЬНОСТЬ"); 	
	ОпределитьПереводВнутриУК(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(ЭтаФорма)
	
	Объект	 = ЭтаФорма.Объект;
	Элементы = ЭтаФорма.Элементы;
	
	Элементы.СписокДокументов.Видимость				= ЭтаФорма.ФормированиеПоДокументу И Объект.Вариант = "Макет_Общий_Будущее";
	Элементы.Документ.Видимость						= ЭтаФорма.ФормированиеПоДокументу И Не Объект.Вариант = "Макет_Общий_Будущее";
	Элементы.СчетДоверительногоУправления.Видимость	= Не ЭтаФорма.ФормированиеПоДокументу;
	Элементы.Период.Видимость						= Не ЭтаФорма.ФормированиеПоДокументу;
	
	УстановитьВидимостьЭлементаПоВариантуАкта(ЭтаФорма, Объект.Вариант, Элементы.Получатель.Имя);
	УстановитьВидимостьЭлементаПоВариантуАкта(ЭтаФорма, Объект.Вариант, Элементы.БанковскийСчетПолучателя.Имя);
	УстановитьВидимостьЭлементаПоВариантуАкта(ЭтаФорма, Объект.Вариант, Элементы.БанковскийСчетОтправителя.Имя);
	УстановитьВидимостьЭлементаПоВариантуАкта(ЭтаФорма, Объект.Вариант, Элементы.БанковскийСчетФонда.Имя);	
	
	Элементы.ДоговорПолучателяПриПереводеВнутриУК.Видимость = Объект.Вариант = "Макет_Общий_Будущее" И ЭтаФорма.ПереводВнутриУК;
	
	Элементы.ГруппаОтправитель.Заголовок = ?(Объект.Вариант = "Макет_Период", "Управляющая компания", "Организация, передавшая имущество");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементаПоВариантуАкта(ЭтаФорма, Вариант, ИмяЭлемента)
	
	Если ЭтаФорма.ЭлементыВариантовАкта = Неопределено Тогда
		
		ЭлементыВариантовАкта = Новый Соответствие;
		ЭлементыВариантовАкта.Вставить("Макет_ЦБ",				СтрРазделить("Получатель, БанковскийСчетПолучателя, БанковскийСчетОтправителя, БанковскийСчетФонда", ", ", Ложь));		
		ЭлементыВариантовАкта.Вставить("Макет_Общий_Будущее",	СтрРазделить("Получатель, БанковскийСчетПолучателя, БанковскийСчетОтправителя, БанковскийСчетФонда", ", ", Ложь));		
		ЭлементыВариантовАкта.Вставить("Макет_Общий_Эволюция",	СтрРазделить("Получатель, БанковскийСчетПолучателя, БанковскийСчетОтправителя, БанковскийСчетФонда", ", ", Ложь));		
		ЭлементыВариантовАкта.Вставить("Макет_ДС_2021",			СтрРазделить("Получатель, БанковскийСчетПолучателя, БанковскийСчетОтправителя, БанковскийСчетФонда", ", ", Ложь));		
		ЭлементыВариантовАкта.Вставить("Макет_Период",			СтрРазделить("БанковскийСчетОтправителя", ", ", Ложь));
		
		ЭтаФорма.ЭлементыВариантовАкта = Новый ФиксированноеСоответствие(ЭлементыВариантовАкта);
		
	КонецЕсли;
	
	ВидимыеЭлементы = ЭтаФорма.ЭлементыВариантовАкта.Получить(Вариант);
	
	ЭтаФорма.Элементы[ИмяЭлемента].Видимость = Не (ВидимыеЭлементы = Неопределено ИЛИ ВидимыеЭлементы.Найти(ИмяЭлемента) = Неопределено);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьФондПоСчетуДоверительногоУправления(СчетДоверительногоУправления, Дата)

	Фонд = Неопределено;
	
	Если ЗначениеЗаполнено(СчетДоверительногоУправления) Тогда
		
		Фонд = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Дата);
		
	КонецЕсли;
	
	Возврат Фонд;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыДокумента(Документ)
	
	РеквизитыДокумента = Новый Структура("СчетДоверительногоУправления, Получатель, Отправитель, Клиент, БанковскийСчетПолучателя, БанковскийСчетОтправителя, БанковскийСчетКлиента");
	
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат РеквизитыДокумента;
	КонецЕсли;
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.ВыводЦенныхБумаг")
		ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.ВыводКредитногоИнструмента")
	Тогда
	
		ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ,
			Новый Структура("СчетДоверительногоУправления, Дата, Получатель", "СчетДоверительногоУправления", "Дата", "Контрагент"));
	
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ВыводДенежныхСредств") Тогда
		
		ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ,
			Новый Структура("СчетДоверительногоУправления, Дата, Получатель, БанковскийСчетПолучателя, БанковскийСчетОтправителя",
				"СчетДоверительногоУправления", "Дата", "Контрагент", "РасчетныйСчетКонтрагента", "РасчетныйСчет"));
		
	Иначе
		
		ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, "СчетДоверительногоУправления, Дата");
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(РеквизитыДокумента, ДанныеДокумента);
	
	РеквизитыДокумента.Клиент				 = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ДанныеДокумента.СчетДоверительногоУправления, ДанныеДокумента.Дата);
	РеквизитыДокумента.БанковскийСчетКлиента = ?(РеквизитыДокумента.Клиент = РеквизитыДокумента.Получатель, РеквизитыДокумента.БанковскийСчетПолучателя, Неопределено);
	РеквизитыДокумента.Отправитель			 = РеквизитыДокумента.Клиент;	
	
	Возврат РеквизитыДокумента;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДоступныеМакеты(Документ, СчетДоверительногоУправления)
	
	Возврат Обработки.ПечатьАктовПриемаПередачиИмущества.ДоступныеМакеты(Документ, СчетДоверительногоУправления);
	
КонецФункции

&НаКлиенте
Процедура ОткрытьВоВнешнемПриложении(ТипФайла)
	
	Если Элементы.ТабличныйДокумент.ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо сформировать акт");
		Возврат;	
	КонецЕсли;
	
	Если ТипФайла = ТипФайлаТабличногоДокумента.XLSX Тогда
		Расширение = ".xlsx"	
	ИначеЕсли ТипФайла = ТипФайлаТабличногоДокумента.DOCX Тогда
		Расширение = ".docx"	
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Неизвестный тип файла '%1'", ТипФайла));
		Возврат;
	КонецЕсли;
	
	Состояние("Открытие акта:", , ">> Сохранение акта в файл и открытие во внешнем приложении");
	
	Если ЭтаФорма.ФормированиеПоДокументу Тогда
		ИмяАкта = Строка(Объект.Документ);
	Иначе
		ИмяАкта = "Акт " + Объект.СчетДоверительногоУправления + " за " + ПредставлениеПериода(Объект.Период.ДатаНачала, Объект.Период.ДатаОкончания);
	КонецЕсли;
	
	// Запишем и откроем файл
		
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
	
	ТабличныйДокумент.Записать(ИмяВременногоФайла, ТипФайла);
	
	Если ТипФайла = ТипФайлаТабличногоДокумента.XLSX Тогда	
	
		ExcelApp = РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗапуститьПриложение();
		
		Если ExcelApp = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось запустить приложение Microsoft Excel");
		Иначе
			
			Попытка
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelСоздатьКнигу(ExcelApp, ИмяВременногоФайла);
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьПараметрыПриложения(ExcelApp, Истина, "Развернуто", ИмяАкта, Истина);
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Ошибка открытия акта в приложении Microsoft Excel: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
				РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗакрытьПриложение(ExcelApp);
			КонецПопытки;
			
		КонецЕсли;	
		
	ИначеЕсли ТипФайла = ТипФайлаТабличногоДокумента.DOCX Тогда

		WordApp = РаботаСВнешнимиСистемамиКлиентСервер.WordЗапуститьПриложение();
		
		Если WordApp = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось запустить приложение Microsoft Word");
		Иначе
			
			Попытка
				РаботаСВнешнимиСистемамиКлиентСервер.WordСоздатьДокумент(WordApp, ИмяВременногоФайла);
				РаботаСВнешнимиСистемамиКлиентСервер.WordУстановитьПараметрыПриложения(WordApp, Истина, "Развернуто", ИмяАкта, Истина);
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Ошибка открытия акта в приложении Microsoft Word: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
				РаботаСВнешнимиСистемамиКлиентСервер.WordЗакрытьПриложение(WordApp);
			КонецПопытки;
			
		КонецЕсли;
		
	Иначе	
		
		ЗапуститьПриложение(ИмяВременногоФайла);
		
	КонецЕсли;
	
	// Подчищаем за собой
	
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПараметрыВыбораДокументов(ЭтаФорма)
	
	Объект		= ЭтаФорма.Объект;
	Элементы	= ЭтаФорма.Элементы;
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Организация", Объект.Организация));
	
	Если ЗначениеЗаполнено(Объект.Документ) Тогда		
		ТекСчетДУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Документ, "СчетДоверительногоУправления");
    	МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.СчетДоверительногоУправления", ТекСчетДУ));		
	ИначеЕсли ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) Тогда
		МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.СчетДоверительногоУправления", Объект.СчетДоверительногоУправления));		
	КонецЕсли;

	ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
	Элементы.СписокДокументов.ПараметрыВыбора = ПараметрыВыбора;
	
КонецПроцедуры

#КонецОбласти

