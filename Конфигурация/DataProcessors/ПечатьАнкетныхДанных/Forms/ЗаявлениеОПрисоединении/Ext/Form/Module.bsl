

#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Организация", ЭтаФорма.Организация);
	Параметры.Свойство("Период"		, ЭтаФорма.Период);
	Параметры.Свойство("ЮрФизЛицо"	, ЭтаФорма.ЮрФизЛицо);
	
	ЭтаФорма.ЗаявлениеОПрисоединении = Истина;
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	СписокОбязательныхРеквизитов = ПолучитьСписокОбязательныхРеквизитов(ЭтаФорма);
	
	Если НЕ СписокОбязательныхРеквизитов.Количество() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны печатные формы",,,,Отказ);
	КонецЕсли;
	
	Для Каждого ОбязательныйРеквизит Из СписокОбязательныхРеквизитов Цикл
		Если ОбязательныйРеквизит.Пометка Тогда
			Если НЕ ЗначениеЗаполнено(ЭтаФорма[ОбязательныйРеквизит.Значение]) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле """ + ОбязательныйРеквизит.Представление + """ не заполнено", ЭтаФорма, ОбязательныйРеквизит.Значение, "Объект", Отказ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста	
Функция НастроитьВидимостьДоступность(Форма)

	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
	//потом пригодится
	
КонецФункции

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура Печать(Команда)
	
	Отказ = Ложь;
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;	
	КонецЕсли;
	
	ДанныеДляПечати = ПолучитьДанныеДляПечати(Отказ);

	Если НЕ Отказ Тогда
		WordApp = СоздатьОбъектWord(Ложь);
		
		Если ЗаявлениеОПрисоединении Тогда
			НапечататьДокумент(WordApp, "ЗаявлениеОПрисоединении", ДанныеДляПечати);
		КонецЕсли;
		
		WordApp.Application.Visible = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ДополнтельныеФункции

&НаКлиентеНаСервереБезКонтекста	
Функция ПолучитьСписокОбязательныхРеквизитов(Форма)
	
	СписокОбязательныхРеквизитов = Новый СписокЗначений;
	
	Если Форма.ЗаявлениеОПрисоединении Тогда
		СписокОбязательныхРеквизитов.Добавить("Период"		, "Период", Истина);
		СписокОбязательныхРеквизитов.Добавить("ЮрФизЛицо"	, "Физ. лицо", Истина);
		СписокОбязательныхРеквизитов.Добавить("Подписант"	, "Подписант", Истина);
		СписокОбязательныхРеквизитов.Добавить("Стратегия"	, "Стратегия", Истина);
		СписокОбязательныхРеквизитов.Добавить("РегистрацияИнвестиционногоПрофиля", "Регистрация инвестиционного профиля");
	КонецЕсли;
	
	Возврат СписокОбязательныхРеквизитов;
	
КонецФункции


#КонецОбласти

#Область РаботаСWord

//Да тут прям на общий модуль тянет!

&НаКлиенте
Функция СоздатьОбъектWord(Visible = False)
	
	WordApp = Новый COMОбъект("Word.Application");
	WordApp.Application.Visible = Visible;

	Возврат WordApp;
	
КонецФункции

&НаКлиенте
Процедура НапечататьДокумент(WordApp, ИмяШаблона, ДанныеДляПечати)
	
	Попытка
		
		ДвоичныеДанныеШаблона = ПолучитьШаблонФайлаНаСервере(ИмяШаблона);
		ПутьКФайлуШаблона = СохранитьШаблонНаДиск(ДвоичныеДанныеШаблона);
		
		NewDoc = ДобавитьДокументWord(WordApp, ПутьКФайлуШаблона);
		ЗаполнитьПараметрыWord(NewDoc, ДанныеДляПечати, , ИмяШаблона);
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
	
	УдалитьФайлШаблона(ПутьКФайлуШаблона);

КонецПроцедуры

&НаКлиенте
Функция ДобавитьДокументWord(WordApp, ПутьКФайлу)
	
	Возврат WordApp.Application.Documents.Add(ПутьКФайлу, Ложь, , WordApp.Application.Visible);	
	
КонецФункции

&НаКлиенте
Функция СохранитьШаблонНаДиск(ДвоичныеДанные)
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("docx");
	ДвоичныеДанные.Записать(ВременныйФайл);
	
	Возврат ВременныйФайл;

КонецФункции

&НаКлиенте
Процедура УдалитьФайлШаблона(ПутьКФайлу)
	
	// удалим файл шаблона
	Попытка
		УдалитьФайлы(ПутьКФайлу);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыWord(ДокументWord, СтруктураРеквизитов, ОбновлятьПоля = Истина, ИмяШаблона = "")
	
	WordVars = ДокументWord.Variables;
	Для каждого КлючИЗнач из СтруктураРеквизитов Цикл
		Если КлючИЗнач.Ключ = "Таблицы" Тогда
			Для каждого КлючИзначТаб из КлючИЗнач.Значение Цикл
				ЗаполнитьТаблицуWord(ДокументWord.Tables(КлючИзначТаб.Ключ), КлючИзначТаб.Значение)	
			КонецЦикла;
		ИначеЕсли КлючИЗнач.Ключ = "Опросники" Тогда
			ЗаполнитьПризнакиДокумента(ДокументWord, КлючИЗнач.Значение);
		ИначеЕсли КлючИЗнач.Ключ = "НовыеЭлементы" Тогда
			СоздатьНовыеЭлементыДокумента(ДокументWord, КлючИЗнач.Значение);
			
		ИначеЕсли ТипЗнч(КлючИЗнач.Значение) = Тип("Структура") Тогда
			ЗаполнитьПараметрыWord(ДокументWord, КлючИЗнач.Значение, Ложь);
		Иначе
			Переменная = WordVars.Item(КлючИЗнач.Ключ);
			Попытка
				Переменная.Value = Формат(КлючИЗнач.Значение, "ДФ=dd.MM.yyyy");
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	Если ОбновлятьПоля Тогда
		ДокументWord.Fields.Update();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПризнакиДокумента(ДокументWord, СтруктураПризнаков)
	
	Для каждого КлючИЗнач из СтруктураПризнаков Цикл
		Попытка
			Field = ДокументWord.FormFields.Item(КлючИЗнач.Ключ);
			Field.CheckBox.Value = КлючИЗнач.Значение;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Для НомерЭлементаУправления = 1 По ДокументWord.ContentControls.Count Цикл
		ЭлементУправления = ДокументWord.ContentControls.Item(НомерЭлементаУправления);
		Если ЗначениеЗаполнено(ЭлементУправления.Tag) Тогда
			Если СтруктураПризнаков.Свойство(ЭлементУправления.Tag) Тогда
				ЭлементУправления.Checked = СтруктураПризнаков[ЭлементУправления.Tag];
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
Конецпроцедуры

&НаКлиенте
Процедура СоздатьНовыеЭлементыДокумента(ДокументWord, СтруктураЭлементов)
	
	Для Каждого Элемент Из СтруктураЭлементов Цикл
		Если ДокументWord.Bookmarks.Exists(Элемент.Ключ) Тогда //В документе должна быть закладка для вставки нового элемента
			ДокументWord.Bookmarks.Item (Элемент.Ключ).Select(); //устанавливаем курсор
			
			Для Индекс = 0 По Элемент.Значение.ВГраница() Цикл
				ОписаниеЭлемента = Элемент.Значение[Индекс];
				
				Если ОписаниеЭлемента.ТипЭлемента = "CheckBox" Тогда
					Если Индекс > 0 Тогда
						ДокументWord.Application.Selection.TypeParagraph(); //перенос строки
					КонецЕсли;
					
					Флажок = ДокументWord.Application.Selection.ContentControls.Add(8); //добавляем флажок
					Флажок.Checked = ОписаниеЭлемента.Значение;
					Флажок.SetCheckedSymbol(254, "Wingdings"); 	//символ и шрифт отметки
					Флажок.SetUncheckedSymbol(168, "Wingdings");//символ и шрифт не отметки
					
					ДокументWord.Application.Selection.MoveRight(1, 2); //двигаемся на пару символов вправо
					ДокументWord.Application.Selection.TypeText(ОписаниеЭлемента.Представление); //добавляем текст
					
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
	
Конецпроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуWord(ТаблицаWord, МассивСтруктур)
	
	КоличествоСтрок = ТаблицаWord.Rows.Count;
	Для каждого Структура из МассивСтруктур Цикл
		
		Если КоличествоСтрок < Структура.Строка Тогда
			Для Сч = 1 По Структура.Строка - КоличествоСтрок Цикл
				ТаблицаWord.Rows.Add();	
			КонецЦикла;
			КоличествоСтрок = Структура.Строка;
		КонецЕсли;
		
		Ячейка = ТаблицаWord.Cell(Структура.Строка, Структура.Колонка);
		Попытка
			Ячейка.Range.InsertAfter(Структура.Значение);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

