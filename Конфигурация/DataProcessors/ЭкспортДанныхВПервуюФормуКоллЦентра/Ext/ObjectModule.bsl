Процедура ЗарегистрироватьОшибку(ТекстОшибки, СчетчикОшибок = Неопределено)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	// дополним текст ошибки сообщениями пользователю
	МассивСообщений = ПолучитьСообщенияПользователю(Истина);
	
	Если МассивСообщений.Количество() > 0 Тогда

		ТекстОшибки = ТекстОшибки + Символы.ПС + "Сообщения пользователю:";
		Для Каждого ТекСообщение Из МассивСообщений Цикл
			
			Если ТекСообщение.Текст = "" Тогда
				Продолжить;
			Иначе
				Текст = ТекСообщение.Текст + ". " + Строка(ТекСообщение.КлючДанных);
				ТекстОшибки = ТекстОшибки + Символы.ПС + Текст; 
			КонецЕсли;
			
		КонецЦикла;
	Иначе
		ТекстОшибки = ТекстОшибки;                                  
	КонецЕсли;
	
    Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки) = Неопределено Тогда    	
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли; 
	
	Если СчетчикОшибок <> Неопределено Тогда
		СчетчикОшибок = СчетчикОшибок - 1;	
	КонецЕсли;
			
КонецПроцедуры

Процедура ОповеститьОбОшибках() Экспорт
		
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		Возврат;
	КонецЕсли;
		
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда	
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
	КонецЕсли;
		
	ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");
	
КонецПроцедуры 

Процедура ОбновитьДанныеПервойФормы(КодЗадачи, НовыеДанные, ПараметрыПодключения, ПараметрыДляСверки = Неопределено, ПараметрыИсключеныИзСверки = Неопределено, КодОбновленного = Неопределено)
	
	ТекстСообщения = "Не удалось обновить данные в первой форме. Задача [" + КодЗадачи + "]";
	
	ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("taskId, selectedInfoParts", КодЗадачи, РаботаСКоллекциями.ЗначениеВМассив("ExtParams")));

	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks", ТелоЗапроса, ТекстСообщения);
	
	Если HTTPОтвет = Неопределено Тогда
		ЗарегистрироватьОшибку(ТекстСообщения);
	Иначе
		
		ЗадачаОбъект = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
	
		Если ТипЗнч(ЗадачаОбъект) = Тип("Структура") И ЗадачаОбъект.Свойство("ExtParams") Тогда
			
			ЗапросОбновления = СформироватьЗапросОбновления(КодЗадачи, НовыеДанные, ЗадачаОбъект.extParams, ПараметрыДляСверки, ПараметрыИсключеныИзСверки); 
			
			Если ЗначениеЗаполнено(ЗапросОбновления) Тогда
					
				HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/extparams/update", ЗапросОбновления, ТекстСообщения);
		
				Если HTTPОтвет = Неопределено Тогда
					ЗарегистрироватьОшибку(ТекстСообщения);   
				КонецЕсли;
				
				КодОбновленного = КодЗадачи;
				
			КонецЕсли;
						
		Иначе
			ЗарегистрироватьОшибку(ТекстСообщения);	
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

Функция СформироватьЗапросОбновления(КодЗадачи, НовыеДанные, ДанныеПервойФормы, ПараметрыДляСверки = Неопределено, ПараметрыИсключеныИзСверки = Неопределено)
	
	СтрокаОбновления = ""; 
	
	Если ЗначениеЗаполнено(ПараметрыДляСверки) Тогда
		МассивПараметров = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПараметрыДляСверки, ",");	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыИсключеныИзСверки) Тогда
		МассивИсключенныхПараметров = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПараметрыИсключеныИзСверки, ",");	
	КонецЕсли;

	Для Каждого Параметр Из ДанныеПервойФормы Цикл 
		
		Если ЗначениеЗаполнено(ПараметрыДляСверки) И МассивПараметров.Найти(Строка(Параметр.id)) = Неопределено
			Или ЗначениеЗаполнено(ПараметрыИсключеныИзСверки) И МассивИсключенныхПараметров.Найти(Строка(Параметр.id)) <> Неопределено Тогда
			Продолжить;		
		КонецЕсли;
		
		Если Параметр.id = 74 И Параметр.value <> СокрЛП(НовыеДанные.Отчество) Тогда
			
			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), СокрЛП(НовыеДанные.Отчество)); 
			
		ИначеЕсли Параметр.id = 75 И Параметр.value <> СокрЛП(НовыеДанные.Имя) Тогда
			
			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), СокрЛП(НовыеДанные.Имя)); 
			
		ИначеЕсли Параметр.id = 76 И Параметр.value <> СокрЛП(НовыеДанные.Фамилия) Тогда
			
			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), СокрЛП(НовыеДанные.Фамилия));
			
		ИначеЕсли Параметр.id = 77 И Параметр.value <> Формат(НовыеДанные.ДатаРождения, "ДФ=гггг-ММ-дд") Тогда
			
			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), Формат(НовыеДанные.ДатаРождения, "ДФ=гггг-ММ-дд"));
			
		ИначеЕсли Параметр.id = 78 И Параметр.value <> СокрЛП(НовыеДанные.ИНН) Тогда

			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), СокрЛП(НовыеДанные.ИНН)); 
			
		ИначеЕсли Параметр.id = 84 И Параметр.value <> СокрЛП(НовыеДанные.СерияДокумента) Тогда

			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), СокрЛП(НовыеДанные.СерияДокумента)); 	
			
		ИначеЕсли Параметр.id = 85 И Параметр.value <> СокрЛП(НовыеДанные.НомерДокумента) Тогда

			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), СокрЛП(НовыеДанные.НомерДокумента));	
			
		ИначеЕсли Параметр.id = 86 И Параметр.value <> Формат(НовыеДанные.ДатаВыдачиДокумента, "ДФ=гггг-ММ-дд") Тогда

			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), Формат(НовыеДанные.ДатаВыдачиДокумента, "ДФ=гггг-ММ-дд"));
			
		ИначеЕсли Параметр.id = 87 И Параметр.value <> СокрЛП(НовыеДанные.ОрганВыдавшийДокумент) Тогда

			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), СокрЛП(НовыеДанные.ОрганВыдавшийДокумент)); 
			
		ИначеЕсли Параметр.id = 88 И Параметр.value <> СокрЛП(НовыеДанные.КодПодразделения) Тогда

			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), СокрЛП(НовыеДанные.КодПодразделения)); 
			
		ИначеЕсли Параметр.id = 165 И Параметр.value.value <> "Открытый" Тогда
			
			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), "Открытый");	
				
		ИначеЕсли Параметр.id = 167 И ЗначениеЗаполнено(НовыеДанные.ДатаОкончанияДействияДокумента) И Параметр.value <> Формат(НовыеДанные.ДатаОкончанияДействияДокумента, "ДФ=гггг-ММ-дд") Тогда

			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), Формат(НовыеДанные.ДатаОкончанияДействияДокумента, "ДФ=гггг-ММ-дд"));

		ИначеЕсли Параметр.id = 169 И ЗначениеЗаполнено(Параметр.value) И Параметр.value <> СокрЛП(НовыеДанные.СНИЛС) Тогда

			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), СокрЛП(НовыеДанные.СНИЛС));
        
		ИначеЕсли Параметр.id = 122 И Параметр.value <> СокрЛП(НовыеДанные.Наименование) Тогда 
			
			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), СокрЛП(НовыеДанные.Наименование));
			
		ИначеЕсли Параметр.id = 179 И Параметр.value.value <> НовыеДанные.Тип Тогда
			
        	СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), НовыеДанные.Тип); 
			
		ИначеЕсли Параметр.id = 180 И Параметр.value <> СокрЛП(НовыеДанные.Номер) Тогда
			
			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), СокрЛП(НовыеДанные.Номер)); 
			
		ИначеЕсли Параметр.id = 183 И Параметр.nativeValue <> Формат(НовыеДанные.Количество, "ЧН=0; ЧГ=0") Тогда 
			
			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), Формат(НовыеДанные.Количество, "ЧН=0; ЧГ=0"));
			
		ИначеЕсли Параметр.id = 184 И Параметр.nativeValue <> Формат(НовыеДанные.Сумма, "ЧН=0; ЧГ=0") Тогда
			
			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), Формат(НовыеДанные.Сумма, "ЧН=0; ЧГ=0"));
			
		ИначеЕсли Параметр.id = 187 И Лев(Параметр.Value, 10) <> Формат(НовыеДанные.Дата, "ДФ=гггг-ММ-дд") Тогда
			
			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), Формат(НовыеДанные.Дата, "ДФ=гггг-ММ-дд'T'ЧЧ:мм:сс"));

		ИначеЕсли Параметр.id = 189 И Параметр.nativeValue <> Формат(НовыеДанные.Цена, "ЧН=0; ЧГ=0") Тогда
			
			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), Формат(НовыеДанные.Цена, "ЧН=0; ЧГ=0"));
							
		ИначеЕсли Параметр.id = 200 И ЗначениеЗаполнено(НовыеДанные.Статус) И Параметр.value.value <> СокрЛП(НовыеДанные.Статус) Тогда
			
			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), СокрЛП(НовыеДанные.Статус));
			
		ИначеЕсли Параметр.id = 201 И Параметр.value <> СокрЛП(НовыеДанные.Ссылка.УникальныйИдентификатор()) Тогда
			
			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), СокрЛП(НовыеДанные.Ссылка.УникальныйИдентификатор()));
						
		ИначеЕсли Параметр.id = 221 И Параметр.value <> НовыеДанные.АктивированЛичныйКабинетЕсиа Тогда
			
			СтрокаОбновления = СтрокаОбновления + СтрШаблон("::#n%1#v%2", Строка(Параметр.id), Формат(НовыеДанные.АктивированЛичныйКабинетЕсиа, "БЛ=false; БИ=true"));
 				
		КонецЕсли;					
		
	КонецЦикла;
	
	СтрокаОбновления = ?(СтрНачинаетсяС(СтрокаОбновления, "::"), Сред(СтрокаОбновления, 3), СтрокаОбновления); 
		
	Если ЗначениеЗаполнено(СтрокаОбновления) Тогда
		Возврат ПолучитьСтрокуJSON(РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("taskId, extParamStr", КодЗадачи, СтрокаОбновления)));
	Иначе
		Возврат Неопределено;
	КонецЕсли;  	
					
КонецФункции

Функция СформироватьСтруктуруДанных(СтрокаСвойствСтруктуры = Неопределено) Экспорт
	
	Если СтрокаСвойствСтруктуры = Неопределено Тогда	
		СтрокаСвойствСтруктуры = "ТаблицаКлиентов,БанковскиеРеквизиты,Продукты,Операции,Заявки,Портфель";
	КонецЕсли;

	ДанныеДляВыгрузки = Новый Структура(СтрокаСвойствСтруктуры);
	
	Если ДанныеДляВыгрузки.Свойство("ТаблицаКлиентов") Тогда  //+ контакты

		ТаблицаКлиентов = Новый ТаблицаЗначений; 
		ТаблицаКлиентов.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.ЮрфизЛица"));
