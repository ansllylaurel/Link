Функция СформироватьПараметрКонтактов(КонтактыКлиента)
	
	ПараметрКонтактов = Новый Структура("id, value", 164, Новый Структура("rows", Новый Массив));
		
	Для Инд = 0 По КонтактыКлиента.Количество() - 1 Цикл
		
		СтруктураСтрокиКонтактов = Новый Структура("cols",
									РаботаСКоллекциями.ЗначенияВМассив(
										Новый Структура("id, value", 1, КонтактыКлиента[Инд].АдресНомер),
										Новый Структура("id, value, dataSourceItemId", 2, КонтактыКлиента[Инд].ТипСвязи, КонтактыКлиента[Инд].ТипСвязи)));
													
		СтруктураСтрокиКонтактов.Вставить("id", Инд + 1);
		СтруктураСтрокиКонтактов.Вставить("modifyType", "create");
						
		ПараметрКонтактов.value.rows.Добавить(СтруктураСтрокиКонтактов);		
								
	КонецЦикла;
	
	Возврат ПараметрКонтактов;
		
КонецФункции

Функция ПолучитьКодыБанковИзПервойФормы(БанковскиеРеквизиты, ПараметрыПодключения)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БанковскиеРеквизиты.БИК КАК БИК,
		|	БанковскиеРеквизиты.Банк КАК Банк,
		|	БанковскиеРеквизиты.КодБанка1Ф КАК КодБанка1Ф
		|ПОМЕСТИТЬ _БанковскиеРеквизиты
		|ИЗ
		|	&БанковскиеРеквизиты КАК БанковскиеРеквизиты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_БанковскиеРеквизиты.БИК КАК БИК,
		|	_БанковскиеРеквизиты.Банк КАК Банк,
		|	_БанковскиеРеквизиты.КодБанка1Ф КАК КодБанка1Ф
		|ИЗ
		|	_БанковскиеРеквизиты КАК _БанковскиеРеквизиты
		|ГДЕ
		|	_БанковскиеРеквизиты.КодБанка1Ф = """"";
	Запрос.УстановитьПараметр("БанковскиеРеквизиты", БанковскиеРеквизиты); 
	
	ТаблицаБанков = Запрос.Выполнить().Выгрузить();
				
	Если ТаблицаБанков.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("startRow", 0);
	СтруктураЗапроса.Вставить("endRow", 10);
	СтруктураЗапроса.Вставить("select", РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("field, type", "taskId", "numberValue")));
	СтруктураЗапроса.Вставить("filterModel", Новый Структура("ExtParam174", Новый Структура("filterType, type, filter", "text", "equals")));
	
	Для Инд = 1 - ТаблицаБанков.Количество() По 0 Цикл 
		
		ТекСтрока = ТаблицаБанков[-Инд];

		ТекстСообщения = "Не удалось получить данные первой формы для юр. лица [" + ТекСтрока.Банк + "] по коду БИК [" + ТекСтрока.БИК + "]";
		
		СтруктураЗапроса.filterModel.ExtParam174.filter = ТекСтрока.БИК; 
		
		ТелоЗапроса =  ПолучитьСтрокуJSON(СтруктураЗапроса);
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api-core/datasource/subcat/44/data", ТелоЗапроса, ТекстСообщения);

		Если HTTPОтвет = Неопределено Тогда
			ЗарегистрироватьОшибку(ТекстСообщения);
			ТаблицаБанков.Удалить(-Инд);
			Продолжить;
		КонецЕсли;
		
		КодПервойФормы = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"), "totalCount"); 
		
		Если Не ЗначениеЗаполнено(КодПервойФормы) Тогда 
			ЗарегистрироватьОшибку("Не удалось получить код первой формы для юр. лица [" + ТекСтрока.Банк + "].");
			ТаблицаБанков.Удалить(-Инд);
			Продолжить;
		Конецесли;
				
		РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(
			ТекСтрока.Банк, 
			Справочники.ВнешниеСистемы.ПерваяФормаКоллЦентра, 
			Справочники.ГруппыИмпортируемыхОбъектов.Банки,
			КодПервойФормы);
			
		ТекСтрока.КодБанка1Ф = КодПервойФормы;	
			
	КонецЦикла;
	
	Возврат ТаблицаБанков; 
		
КонецФункции

Функция ПолучитьСтрокуJSON(СтруктураДанных)
	
	ЗаписьJSON          = Новый ЗаписьJSON;
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

Функция ДесериализоватьСтрокуJSON(СтрокаJSON, ИмяСвойства = Неопределено)
	
	ЧтениеJSON = Новый ЧтениеJSON();
    ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
    ТекОбъект = ПрочитатьJSON(ЧтениеJSON);
	
	Если ИмяСвойства = Неопределено Тогда
		Возврат ТекОбъект;
	ИначеЕсли ТипЗнч(ТекОбъект) = Тип("Структура") И ТекОбъект.Свойство(ИмяСвойства) Тогда 
		
		Если ИмяСвойства = "totalCount" Тогда 
			
			Если ТекОбъект.totalCount = 1 И ТекОбъект.Свойство("tasksDataSourceResponse") Тогда
				Возврат Формат(ТекОбъект.tasksDataSourceResponse[0].taskId, "ЧГ=0");
			ИначеЕсли ТекОбъект.totalCount > 1 Тогда 
				
				ЗадачиСтр = "";
				Для Каждого ТекЗадача Из ТекОбъект.tasksDataSourceResponse Цикл
					ЗадачиСтр = ЗадачиСтр + ?(ЗначениеЗаполнено(ЗадачиСтр), ",", "") + Формат(ТекЗадача.taskId, "ЧГ=0");	
				КонецЦикла;
				
				ЗарегистрироватьОшибку("Обнаружено несколько задач [" + ЗадачиСтр + "] с одинаковым идентификатором GUID");
				
			ИначеЕсли ТекОбъект.totalCount = 0 Тогда
				Возврат 0;
			КонецЕсли
			
		ИначеЕсли ИмяСвойства = "data" Тогда 
			
			Если ТекОбъект.data.Свойство("value") Тогда
				Возврат Формат(ТекОбъект.data.value, "ЧГ=0");
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ТекОбъект) = Тип("Структура") И ТекОбъект.Свойство("errors") Тогда
		
		Для Каждого ТекОшибка Из ТекОбъект.errors Цикл
			//ЗарегистрироватьОшибку(СтрШаблон(    ТекОшибка.errorType, ТекОшибка.message));		
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции 

Процедура ЗаполнитьКодКлиента(КодКлиента, ТекДанные, ФлагЗаполнитьКодКлиента = Истина)
	
	Если Не ФлагЗаполнитьКодКлиента Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементДанных Из ТекДанные Цикл 
		
		Если ЗначениеЗаполнено(ЭлементДанных.КодКлиента1Ф) Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементДанных.КодКлиента1Ф = КодКлиента;
		
	КонецЦикла;
		
КонецПроцедуры

//бизнес процесс
Функция АктивированМеханизмЭкспортаДанных(Организация) Экспорт 
		
	Если Не ПараметрыСеанса.ЭтоРабочаяИнформационнаяБаза Тогда
		Возврат Ложь;
	КонецЕсли;
			
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияДополнительныхСведений.Значение КАК ФлагАктивирован
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Объект = &Организация
		|	И ЗначенияДополнительныхСведений.Свойство.Ключ = ""АктивированМеханизмЭкспортаДанныхВПервуюФормуКоллЦентра""";
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ФлагАктивирован;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Процедура ЭкспортироватьДанныеЗаявки(ЗаявкаСсылка, Отказ) Экспорт
	
	ЗначениеРеквизитовЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаявкаСсылка, "Дата, Организация");
	
	Если Не АктивированМеханизмЭкспортаДанных(ЗначениеРеквизитовЗаявки.Организация) Тогда
		Возврат;	
	КонецЕсли;
	
	Механизм = Метаданные.Обработки.ЭкспортДанныхВПервуюФормуКоллЦентра.Имя + ".ЭкспортироватьДанныеЗаявки()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(Новый Структура("Организация, Заявка", ЗначениеРеквизитовЗаявки.Организация, ЗаявкаСсылка));
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание); 
		
	ПараметрыПодключения = РаботаСВнешнимиСистемами.ПерваяФорма_ПолучитьПараметрыПодключения("uk1f");
	
	Если ПараметрыПодключения = Неопределено Тогда		
		ЗарегистрироватьОкончаниеСессии(Механизм, Сессия, "Ошибка подключения к первой форме колл центра.", Отказ);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область Текст_Запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокЗаявкаПайщика.Ссылка КАК Ссылка,
		|	ДокЗаявкаПайщика.НомерЗаявки КАК НомерЗаявки,
		|	ДокЗаявкаПайщика.Дата КАК ДатаЗаявки,
		|	ДокЗаявкаПайщика.Пайщик КАК Клиент,
		|	ДокЗаявкаПайщика.ВидЗаявки КАК ВидЗаявки,
		|	ВЫБОР
		|		КОГДА ДокЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Зачисление)
		|			ТОГДА ""Приобретение паев""
		|		КОГДА ДокЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Погашение)
		|			ТОГДА ""Погашение паев""
		|		КОГДА ДокЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен)
		|			ТОГДА ""Обмен паев""
		|	КОНЕЦ КАК Тип,
		|	ДокЗаявкаПайщика.ПаевойИнвестиционныйФонд КАК Актив,
		|	ДокЗаявкаПайщика.ПаевойИнвестиционныйФондДляОбменаПаев КАК АктивДляОбмена,
		|	ДокЗаявкаПайщика.Сумма КАК Сумма,
		|	ДокЗаявкаПайщика.Количество КАК Количество,
		|	ДокЗаявкаПайщика.ВыгружатьОперацииВЕСИАФинанс КАК ОсновнаяЗаявка,
		|	ДокЗаявкаПайщика.ОткрытьДепозитарныйСчетВПаевомИнвестиционномФондеДляОбмена КАК ОткрытьСчетДляОбмена,
		|	СтатусыЗаявокПайщиковСрезПоследних.Статус КАК Статус
		|ПОМЕСТИТЬ _ДанныеЗаявки
		|ИЗ
		|	Документ.ЗаявкаПайщика КАК ДокЗаявкаПайщика
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЗаявокПайщиков.СрезПоследних(, Организация = &Организация) КАК СтатусыЗаявокПайщиковСрезПоследних
		|		ПО ДокЗаявкаПайщика.Ссылка = СтатусыЗаявокПайщиковСрезПоследних.ЗаявкаПайщика
		|ГДЕ
		|	ДокЗаявкаПайщика.Ссылка = &ЗаявкаСсылка
		|	И ДокЗаявкаПайщика.ВыгружатьОперацииВЕСИАФинанс
		|	И НЕ ДокЗаявкаПайщика.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыПервойФормы.Объект КАК Объект,
		|	КодыПервойФормы.Код КАК Код
		|ПОМЕСТИТЬ _КодыПервойФормыКоллЦентра
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФормаКоллЦентра)
		|				И Объект В
		|					(ВЫБРАТЬ
		|						_ДанныеЗаявки.Клиент
		|					ИЗ
		|						_ДанныеЗаявки КАК _ДанныеЗаявки
		|			
		|					ОБЪЕДИНИТЬ
		|			
		|					ВЫБРАТЬ
		|						_ДанныеЗаявки.Актив
		|					ИЗ
		|						_ДанныеЗаявки КАК _ДанныеЗаявки
		|			
		|					ОБЪЕДИНИТЬ
		|			
		|					ВЫБРАТЬ
		|						_ДанныеЗаявки.АктивДляОбмена
		|					ИЗ
		|						_ДанныеЗаявки КАК _ДанныеЗаявки
		|					ГДЕ
		|						_ДанныеЗаявки.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен))
		|				И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды))) КАК КодыПервойФормы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокЗаявкаПайщика.Ссылка КАК Ссылка,
		|	ДокЗаявкаПайщика.ВидЗаявки КАК ВидЗаявки,
		|	ДокЗаявкаПайщика.ПаевойИнвестиционныйФонд КАК Актив,
		|	ДокЗаявкаПайщика.ПаевойИнвестиционныйФондДляОбменаПаев КАК АктивДляОбмена,
		|	ДокЗаявкаПайщика.Пайщик КАК Клиент,
		|	ДокЗаявкаПайщика.Дата КАК ДатаЗаявки,
		|	ДокЗаявкаПайщика.НомерЗаявки КАК НомерЗаявки,
		|	ДокЗаявкаПайщика.ВыгружатьОперацииВЕСИАФинанс КАК ОсновнаяЗаявка,
		|	КодыКлиентов.Код КАК КодКлиента1Ф,
		|	КодыАктивов.Код КАК КодАктива1Ф,
		|	КодыАктивовДляОбмена.Код КАК КодАктиваДляОбмена1Ф,
		|	КодыПродуктов.Код КАК КодПродукта1Ф
		|ПОМЕСТИТЬ _ВсеЗаявкиКлиента
		|ИЗ
		|	Документ.ЗаявкаПайщика КАК ДокЗаявкаПайщика
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеЗаявки КАК _ДанныеЗаявки
		|		ПО ДокЗаявкаПайщика.Пайщик = _ДанныеЗаявки.Клиент
		|			И (ДокЗаявкаПайщика.ВидЗаявки В (ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Зачисление), ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен)))
		|			И (ДокЗаявкаПайщика.Проведен)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыПервойФормыКоллЦентра КАК КодыКлиентов
		|		ПО ДокЗаявкаПайщика.Пайщик = КодыКлиентов.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыПервойФормыКоллЦентра КАК КодыАктивов
		|		ПО ДокЗаявкаПайщика.ПаевойИнвестиционныйФонд = КодыАктивов.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыПервойФормыКоллЦентра КАК КодыАктивовДляОбмена
		|		ПО (ДокЗаявкаПайщика.ПаевойИнвестиционныйФондДляОбменаПаев = КодыАктивов.Объект)
		|			И (ДокЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФормаКоллЦентра)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЗаявкиПайщиков)) КАК КодыПродуктов
		|		ПО ДокЗаявкаПайщика.Ссылка = КодыПродуктов.Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Актив КАК Актив,
		|	ВложенныйЗапрос.Клиент КАК Клиент,
		|	ВложенныйЗапрос.ДатаЗаявки КАК ДатаЗаявки,
		|	ВложенныйЗапрос.КодКлиента1Ф КАК КодКлиента1Ф,
		|	ЕСТЬNULL(_ЗаявкиНаПриобретение.Ссылка, _ЗаявкиНаОбмен.Ссылка) КАК ЗаявкаСсылка,
		|	ЕСТЬNULL(_ЗаявкиНаПриобретение.НомерЗаявки, _ЗаявкиНаОбмен.НомерЗаявки) КАК НомерЗаявки,
		|	ЕСТЬNULL(_ЗаявкиНаПриобретение.ОсновнаяЗаявка, _ЗаявкиНаОбмен.ОсновнаяЗаявка) КАК ОсновнаяЗаявка,
		|	ЕСТЬNULL(_ЗаявкиНаПриобретение.КодАктива1Ф, _ЗаявкиНаОбмен.КодАктиваДляОбмена1Ф) КАК КодАктива1Ф,
		|	ЕСТЬNULL(_ЗаявкиНаПриобретение.КодПродукта1Ф, _ЗаявкиНаОбмен.КодПродукта1Ф) КАК КодПродукта1Ф
		|ПОМЕСТИТЬ _ПродуктыКлиента
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВЫБОР
		|			КОГДА _ВсеЗаявкиКлиента.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен)
		|				ТОГДА _ВсеЗаявкиКлиента.АктивДляОбмена
		|			ИНАЧЕ _ВсеЗаявкиКлиента.Актив
		|		КОНЕЦ КАК Актив,
		|		_ВсеЗаявкиКлиента.Клиент КАК Клиент,
		|		_ВсеЗаявкиКлиента.КодКлиента1Ф КАК КодКлиента1Ф,
		|		МИНИМУМ(_ВсеЗаявкиКлиента.ДатаЗаявки) КАК ДатаЗаявки
		|	ИЗ
		|		_ВсеЗаявкиКлиента КАК _ВсеЗаявкиКлиента
		|	ГДЕ
		|		_ВсеЗаявкиКлиента.ВидЗаявки В (ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Зачисление), ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен))
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ВЫБОР
		|			КОГДА _ВсеЗаявкиКлиента.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен)
		|				ТОГДА _ВсеЗаявкиКлиента.АктивДляОбмена
		|			ИНАЧЕ _ВсеЗаявкиКлиента.Актив
		|		КОНЕЦ,
		|		_ВсеЗаявкиКлиента.Клиент,
		|		_ВсеЗаявкиКлиента.КодКлиента1Ф) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеЗаявкиКлиента КАК _ЗаявкиНаПриобретение
		|		ПО ВложенныйЗапрос.Актив = _ЗаявкиНаПриобретение.Актив
		|			И ВложенныйЗапрос.Клиент = _ЗаявкиНаПриобретение.Клиент
		|			И ВложенныйЗапрос.ДатаЗаявки = _ЗаявкиНаПриобретение.ДатаЗаявки
		|			И (_ЗаявкиНаПриобретение.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Зачисление))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеЗаявкиКлиента КАК _ЗаявкиНаОбмен
		|		ПО ВложенныйЗапрос.Актив = _ЗаявкиНаОбмен.АктивДляОбмена
		|			И ВложенныйЗапрос.Клиент = _ЗаявкиНаОбмен.Клиент
		|			И ВложенныйЗапрос.ДатаЗаявки = _ЗаявкиНаОбмен.ДатаЗаявки
		|			И (_ЗаявкиНаОбмен.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеЗаявки.Ссылка КАК Ссылка,
		|	_ДанныеЗаявки.Ссылка КАК ЗаявкаСсылка,
		|	_ДанныеЗаявки.Клиент КАК Клиент,
		|	NULL КАК Дата,
		|	_ДанныеЗаявки.Тип КАК Тип,
		|	_ДанныеЗаявки.ДатаЗаявки КАК ДатаЗаявки,
		|	_ДанныеЗаявки.НомерЗаявки КАК НомерЗаявки,
		|	_ДанныеЗаявки.ОсновнаяЗаявка КАК ОсновнаяЗаявка,
		|	_ДанныеЗаявки.Статус КАК Статус,
		|	_ДанныеЗаявки.Актив КАК Актив,
		|	_ДанныеЗаявки.АктивДляОбмена КАК АктивДляОбмена,
		|	ВЫБОР
		|		КОГДА _ДанныеЗаявки.Количество > 0
		|			ТОГДА ВЫРАЗИТЬ(_ДанныеЗаявки.Сумма / _ДанныеЗаявки.Количество КАК ЧИСЛО(19, 4))
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Цена,
		|	ВЫРАЗИТЬ(_ДанныеЗаявки.Сумма КАК ЧИСЛО(19, 4)) КАК Сумма,
		|	ВЫРАЗИТЬ(_ДанныеЗаявки.Количество КАК ЧИСЛО(19, 7)) КАК Количество,
		|	0 КАК СуммаНДФЛ,
		|	0 КАК СкидкаНадбавка,
		|	_ДанныеПродукта.КодКлиента1Ф КАК КодКлиента1Ф,
		|	_ДанныеПродукта.ЗаявкаСсылка КАК СсылкаЗаявкиАктива,
		|	_ДанныеПродуктаДляОбмена.ЗаявкаСсылка КАК СсылкаЗаявкиАктиваДляОбмена,
		|	_ДанныеПродукта.КодПродукта1Ф КАК КодПродукта1Ф,
		|	_ДанныеПродуктаДляОбмена.КодПродукта1Ф КАК КодПродуктаДляОбмена1Ф
		|ПОМЕСТИТЬ _ДанныеЗаявкиКлиента
		|ИЗ
		|	_ДанныеЗаявки КАК _ДанныеЗаявки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПродуктыКлиента КАК _ДанныеПродукта
		|		ПО _ДанныеЗаявки.Актив = _ДанныеПродукта.Актив
		|			И _ДанныеЗаявки.Клиент = _ДанныеПродукта.Клиент
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПродуктыКлиента КАК _ДанныеПродуктаДляОбмена
		|		ПО _ДанныеЗаявки.АктивДляОбмена = _ДанныеПродуктаДляОбмена.Актив
		|			И _ДанныеЗаявки.Клиент = _ДанныеПродуктаДляОбмена.Клиент
		|			И (_ДанныеЗаявки.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеЗаявкиКлиента.Клиент КАК Клиент,
		|	_ДанныеЗаявкиКлиента.НомерЗаявки КАК Номер,
		|	_ДанныеЗаявкиКлиента.Тип КАК Тип,
		|	_ДанныеЗаявкиКлиента.ОсновнаяЗаявка КАК Основная,
		|	""Ошибка экспорта заявки клиента [%1], номер [%2], тип заявки [%3]. Не удалось определить завку на приобретение паев со значением реквизита ВыгружатьОперацииВЕСИАФинанс [%4]."" КАК Текст
		|ПОМЕСТИТЬ _ОшибкиЗаявок
		|ИЗ
		|	_ДанныеЗаявкиКлиента КАК _ДанныеЗаявкиКлиента
		|ГДЕ
		|	(_ДанныеЗаявкиКлиента.СсылкаЗаявкиАктива ЕСТЬ NULL
		|			ИЛИ _ДанныеЗаявкиКлиента.Тип = ""Обмен паев""
		|				И _ДанныеЗаявкиКлиента.СсылкаЗаявкиАктиваДляОбмена ЕСТЬ NULL)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Звездочка КАК Звездочка
		|ИЗ
		|	_ДанныеЗаявкиКлиента КАК _ДанныеЗаявкиКлиента
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиЗаявок КАК _ОшибкиЗаявок
		|		ПО _ДанныеЗаявкиКлиента.НомерЗаявки = _ОшибкиЗаявок.Номер
		|			И _ДанныеЗаявкиКлиента.Клиент = _ОшибкиЗаявок.Клиент
		|ГДЕ
		|	_ОшибкиЗаявок.Номер ЕСТЬ NULL
		|	И НЕ _ДанныеЗаявкиКлиента.КодКлиента1Ф ЕСТЬ NULL";
#КонецОбласти

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");

	Запрос.УстановитьПараметр("ЗаявкаСсылка", ЗаявкаСсылка);
	Запрос.УстановитьПараметр("Организация", ЗначениеРеквизитовЗаявки.Организация);

	ДанныеЗаявки = Запрос.Выполнить().Выгрузить();
	
	ВыборкаОшибок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиЗаявок"].ПолучитьДанные().Выбрать();
	
	Если ВыборкаОшибок.Количество() > 0 Тогда
		
		Если ВыборкаОшибок.Следующий() Тогда 	
			ЗарегистрироватьОкончаниеСессии(Механизм, Сессия, СтрШаблон(ВыборкаОшибок.Текст, ВыборкаОшибок.Клиент, ВыборкаОшибок.Номер, ВыборкаОшибок.Тип, ВыборкаОшибок.Основная), Отказ);
			Возврат;	
		КонецЕсли;
				
	КонецЕсли;
		
	Если ДанныеЗаявки.Количество() > 0 Тогда
		
		ПродуктыКлиента = Запрос.МенеджерВременныхТаблиц.Таблицы["_ПродуктыКлиента"].ПолучитьДанные().Выгрузить();	
		
		ЭкспортироватьПродуктыКлиентов(ПродуктыКлиента, ПараметрыПодключения);	
		ЭкспортироватьОперацииКлиентов(ДанныеЗаявки, ПараметрыПодключения, ПродуктыКлиента);
		
		ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, Отказ);
		Возврат;
		
	КонецЕсли;
	
    //Если заявка (на приобретение паев) нового клиента - сначала выгрузим анкетные данные
#Область Текст_Запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеЗаявкиКлиента.КодКлиента1Ф КАК Код1Ф,
		|	РеквизитыФизическихЛицАнкетные.Регистратор КАК Анкета,
		|	РеквизитыФизическихЛицАнкетные.ЮрФизЛицо КАК Ссылка,
		|	РеквизитыФизическихЛицАнкетные.Фамилия КАК Фамилия,
		|	РеквизитыФизическихЛицАнкетные.Имя КАК Имя,
		|	РеквизитыФизическихЛицАнкетные.Отчество КАК Отчество,
		|	РеквизитыФизическихЛицАнкетные.Пол КАК Пол,
		|	РеквизитыФизическихЛицАнкетные.ДатаРождения КАК ДатаРождения,
		|	РеквизитыФизическихЛицАнкетные.СерияУдостоверенияЛичности КАК СерияДокумента,
		|	РеквизитыФизическихЛицАнкетные.НомерУдостоверенияЛичности КАК НомерДокумента,
		|	РеквизитыФизическихЛицАнкетные.ДатаВыдачиУдостоверенияЛичности КАК ДатаВыдачиДокумента,
		|	РеквизитыФизическихЛицАнкетные.ДатаОкончанияДействияУдостоверенияЛичности КАК ДатаОкончанияДействияДокумента,
		|	РеквизитыФизическихЛицАнкетные.ОрганВыдавшийУдостоверениеЛичности КАК ОрганВыдавшийДокумент,
		|	РеквизитыФизическихЛицАнкетные.КодОрганаВыдавшегоУдостоверениеЛичности КАК КодПодразделения,
		|	РеквизитыФизическихЛицАнкетные.СНИЛС КАК СНИЛС,
		|	РеквизитыФизическихЛицАнкетные.ИНН КАК ИНН,
		|	РеквизитыФизическихЛицАнкетные.EMail КАК EMail,
		|	РеквизитыФизическихЛицАнкетные.Телефоны КАК Телефоны,
		|	НЕ КодыПользователейЕсиаФинанс.Код ЕСТЬ NULL КАК АктивированЛичныйКабинетЕсиа
		|ПОМЕСТИТЬ _АнкетныеДанные
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&ДатаЗаявки,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_ДанныеЗаявкиКлиента.Клиент КАК Клиент
		|					ИЗ
		|						_ДанныеЗаявкиКлиента КАК _ДанныеЗаявкиКлиента
		|					ГДЕ
		|						_ДанныеЗаявкиКлиента.Тип = ""Приобретение паев"")) КАК РеквизитыФизическихЛицАнкетные
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеЗаявкиКлиента КАК _ДанныеЗаявкиКлиента
		|		ПО РеквизитыФизическихЛицАнкетные.ЮрФизЛицо = _ДанныеЗаявкиКлиента.Клиент
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица)) КАК КодыПользователейЕсиаФинанс
		|		ПО РеквизитыФизическихЛицАнкетные.ЮрФизЛицо = КодыПользователейЕсиаФинанс.Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АнкетаФизическогоЛицаБанковскиеРеквизиты.РасчетныйСчет КАК Ссылка,
		|	_АнкетныеДанные.Ссылка КАК Клиент,
		|	_АнкетныеДанные.Код1Ф КАК КодКлиента1Ф,
		|	АнкетаФизическогоЛицаБанковскиеРеквизиты.БИК КАК Бик,
		|	АнкетаФизическогоЛицаБанковскиеРеквизиты.РасчетныйСчет.Банк КАК Банк,
		|	АнкетаФизическогоЛицаБанковскиеРеквизиты.НомерСчета КАК НомерСчета,
		|	АнкетаФизическогоЛицаБанковскиеРеквизиты.КоррСчет КАК КоррСчет,
		|	ЕСТЬNULL(КодыПервойФормы.Код, """") КАК КодБанка1Ф
		|ИЗ
		|	Документ.АнкетаФизическогоЛица.БанковскиеРеквизиты КАК АнкетаФизическогоЛицаБанковскиеРеквизиты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _АнкетныеДанные КАК _АнкетныеДанные
		|		ПО АнкетаФизическогоЛицаБанковскиеРеквизиты.Ссылка = _АнкетныеДанные.Анкета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФормаКоллЦентра)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Банки)) КАК КодыПервойФормы
		|		ПО АнкетаФизическогоЛицаБанковскиеРеквизиты.РасчетныйСчет.Банк = КодыПервойФормы.Объект"; 
#КонецОбласти

	Запрос.УстановитьПараметр("ДатаЗаявки", ЗначениеРеквизитовЗаявки.Дата);
	
	БанковскиеРеквизиты = Запрос.Выполнить().Выгрузить();
			
	НовыеКодыБанков = ?(БанковскиеРеквизиты.Количество() = 0, Неопределено, ПолучитьКодыБанковИзПервойФормы(БанковскиеРеквизиты, ПараметрыПодключения));

	ТаблицаАнкетныхДанных = Запрос.МенеджерВременныхТаблиц.Таблицы["_АнкетныеДанные"].ПолучитьДанные().Выгрузить();
	ТаблицаАнкетныхДанных.Колонки.Добавить("Контакты", Новый ОписаниеТипов("Массив"));
	
	Для Каждого ДанныеКлиента Из ТаблицаАнкетныхДанных Цикл
						
		Если ЗначениеЗаполнено(ДанныеКлиента.EMail) Тогда 	
			ДанныеКлиента.Контакты.Добавить(Новый Структура("ТипСвязи, АдресНомер", "Email", ДанныеКлиента.EMail)); 
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеКлиента.Телефоны) Тогда
			ДанныеКлиента.Контакты.Добавить(Новый Структура("ТипСвязи, АдресНомер", "Телефон", ДанныеКлиента.Телефоны)); 
		КонецЕсли;
		
		Если Не ЭкспортироватьАнкетныеДанныеКлиента(ДанныеКлиента, ПараметрыПодключения) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДанныеКлиента.Код1Ф) Тогда
			ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, Отказ);
			Возврат;	
		КонецЕсли;
		
		БанковскиеРеквизитыКлиента = БанковскиеРеквизиты.Скопировать(Новый Структура("Клиент", ДанныеКлиента.Ссылка));
		
		Если БанковскиеРеквизитыКлиента.Количество() > 0 Тогда
			ЭкспортироватьБанковскиеРеквизитыКлиентов(БанковскиеРеквизитыКлиента, ПараметрыПодключения, НовыеКодыБанков);
		КонецЕсли;

		ЗаявкиКлиента = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДанныеЗаявкиКлиента"].ПолучитьДанные().Выгрузить();
		
		Если ЗаявкиКлиента.Количество() > 0 Тогда 
			
			ПродуктыКлиента = Запрос.МенеджерВременныхТаблиц.Таблицы["_ПродуктыКлиента"].ПолучитьДанные().Выгрузить();
			
			ЗаполнитьКодКлиента(ДанныеКлиента.Код1Ф, ПродуктыКлиента);
			ЭкспортироватьПродуктыКлиентов(ПродуктыКлиента, ПараметрыПодключения);
			
			ЗаполнитьКодКлиента(ДанныеКлиента.Код1Ф, ЗаявкиКлиента);
			ЭкспортироватьОперацииКлиентов(ЗаявкиКлиента, ПараметрыПодключения, ПродуктыКлиента);
			
		КонецЕсли;
			
	КонецЦикла;
	
	ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, Отказ);
		
КонецПроцедуры

Процедура ЭкспортироватьДвижениеАктивов(Организация, ЗаявкаСсылка, Отказ) Экспорт 
			
	Если Не АктивированМеханизмЭкспортаДанных(Организация) Тогда
		Возврат;	
	КонецЕсли;

	Механизм = Метаданные.Обработки.ЭкспортДанныхВПервуюФормуКоллЦентра.Имя + ".ЭкспортироватьДвижениеАктивов()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(Новый Структура("Организация, Заявка", Организация, ЗаявкаСсылка));
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание); 
			
	РеквизитыЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаявкаСсылка, "Пайщик, ПаевойИнвестиционныйФонд"); 	
			
	ПараметрыФормирования = Новый Структура();
	ПараметрыФормирования.Вставить("Организация", Организация); 
	ПараметрыФормирования.Вставить("НачалоПериода", Дата(1, 1, 1));
	ПараметрыФормирования.Вставить("КонецПериода", КонецДня(ТекущаяДатаСеанса()));
	ПараметрыФормирования.Вставить("Клиенты", РаботаСКоллекциями.ЗначениеВМассив(РеквизитыЗаявки.Пайщик));
	ПараметрыФормирования.Вставить("Пиф", РеквизитыЗаявки.ПаевойИнвестиционныйФонд);

	ДанныеДляЭкспорта = СформироватьДанныеДляЭкспорта(ПараметрыФормирования);
	
	Экспортировать(ДанныеДляЭкспорта);
	
	ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, Отказ);
		
КонецПроцедуры 

Процедура ЭкспортироватьДанныеКлиентовПослеАктивацииЛКК(Организация, МассивКлиентов) Экспорт 
	
	Если Не АктивированМеханизмЭкспортаДанных(Организация) Тогда
		Возврат;	
	КонецЕсли; 
	
	КлиентыСтр = "";
	Для Каждого ЭтотКлиент Из МассивКлиентов Цикл
		КлиентыСтр = КлиентыСтр + ?(ЗначениеЗаполнено(КлиентыСтр), ", ", "") + Строка(ЭтотКлиент);  	
	КонецЦикла;
	
	Механизм = Метаданные.Обработки.ЭкспортДанныхВПервуюФормуКоллЦентра.Имя + ".ЭкспортироватьДанныеКлиентовПослеАктивацииЛКК()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(Новый Структура("Организация, НовыеКлиенты", Организация, КлиентыСтр));
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание); 	
			
	ПараметрыФормирования = Новый Структура();
	ПараметрыФормирования.Вставить("Организация", Организация); 
	ПараметрыФормирования.Вставить("НачалоПериода", Дата(1, 1, 1));
	ПараметрыФормирования.Вставить("КонецПериода", КонецДня(ТекущаяДатаСеанса()));
	ПараметрыФормирования.Вставить("Клиенты", МассивКлиентов);

	ДанныеДляЭкспорта = СформироватьДанныеДляЭкспорта(ПараметрыФормирования);
	
	Экспортировать(ДанныеДляЭкспорта);
	
	ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);

КонецПроцедуры
	
Процедура ЗарегистрироватьОкончаниеСессии(Механизм, Сессия, ТекстОшибки = Неопределено, Отказ = Неопределено, ДопПараметры = Неопределено);
		
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда	
		ЗарегистрироватьОшибку(ТекстОшибки);	
	КонецЕсли;
	
	ОшибкиСессии = "";
		
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда 
		
		ОшибкиСессии = РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС);
		
		Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		
			Отказ = Истина;	
			
			ПараметрыЗадания = Новый Структура("Механизм, Ошибки", Механизм, ЭтотОбъект.ДополнительныеСвойства.Ошибки);
			РаботаСДлительнымиОперациями.ЗапуститьВыполнениеВФоне(Сессия, "РаботаСБизнесПроцессамиИЗадачами.ЗарегистрироватьОшибкуВФоне", ПараметрыЗадания);
			
		Иначе 
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОшибкиСессии,,,, Отказ);
	
		КонецЕсли;
			
	КонецЕсли;
				
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, ДопПараметры, ОшибкиСессии);
	
	ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");
					
КонецПроцедуры 

//экспорт всех данных
Процедура СформироватьИЭкспортироватьДанные(ТекПараметры) Экспорт
	
	Механизм = Метаданные.Обработки.ЭкспортДанныхВПервуюФормуКоллЦентра.Имя + ".СформироватьИЭкспортироватьДанные()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ТекПараметры);
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ДанныеДляЭкспорта = СформироватьДанныеДляЭкспорта(ТекПараметры);
	
	Экспортировать(ДанныеДляЭкспорта);
	
	ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
КонецПроцедуры 

Процедура ДополнитьДанныеПотока(ДанныеДляЭкспорта, ДанныеПотока, ИмяТаблицы, УидФизЛица);
	
	Если ДанныеПотока.Свойство(ИмяТаблицы) Тогда
				
		ТекПродуктыПользователя = ДанныеДляЭкспорта[ИмяТаблицы].Скопировать(Новый Структура("УидФизЛица", УидФизЛица));
		
		Если ДанныеПотока[ИмяТаблицы] = Неопределено Тогда
			ДанныеПотока[ИмяТаблицы] = ТекПродуктыПользователя;
		Иначе
			РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ТекПродуктыПользователя, ДанныеПотока[ИмяТаблицы]); 	
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

Процедура ЭкспортироватьВсеПортфели(ТекПараметры) Экспорт 
	
	Механизм = Метаданные.Обработки.ЭкспортДанныхВПервуюФормуКоллЦентра.Имя + ".ЭкспортироватьВсеПортфели()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ТекПараметры);
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание); 	
						
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
#Область Текст_Запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыОПИФ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыОПИФ.Клиент КАК Опиф
		|ПОМЕСТИТЬ _СчетаДуОпиф
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И (СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения > &КонецПериода)
		|				И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)) КАК КлиентыОПИФ
		|ГДЕ
		|	ВЫРАЗИТЬ(КлиентыОПИФ.Клиент КАК Справочник.ПаевыеИнвестиционныеФонды).Тип = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Открытый)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВнешнихСистем.Объект КАК Объект,
		|	КодыВнешнихСистем.Код КАК Код
		|ПОМЕСТИТЬ _КодыВнешнихСистем
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&КонецПериода,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФормаКоллЦентра)
		|				И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЗаявкиПайщиков), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды))) КАК КодыВнешнихСистем
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокЗаявка.Ссылка КАК Ссылка,
		|	ДокЗаявка.Дата КАК ДатаЗаявки,
		|	ДокЗаявка.НомерЗаявки КАК НомерЗаявки,
		|	ДокЗаявка.Пайщик КАК Клиент,
		|	ДокЗаявка.ПаевойИнвестиционныйФонд КАК АктивСсылка,
		|	ДокЗаявка.ПаевойИнвестиционныйФондДляОбменаПаев КАК АктивДляОбмена,
		|	ДокЗаявка.ВидЗаявки КАК ВидЗаявки,
		|	ДокЗаявка.ВыгружатьОперацииВЕСИАФинанс КАК ОсновнаяЗаявка,
		|	_КодыПервойФормыПифов.Код КАК КодАктива,
		|	_КодыПервойФормыПифовДляОбмена.Код КАК КодАктиваДляОбмена,
		|	_КодыКлиентовПервойФормы.Код КАК КодКлиента
		|ПОМЕСТИТЬ _ЗаявкиКлиентов
		|ИЗ
		|	Документ.ЗаявкаПайщика КАК ДокЗаявка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДуОпиф КАК _СчетаДуОпиф
		|		ПО ДокЗаявка.ПаевойИнвестиционныйФонд = _СчетаДуОпиф.Опиф
		|			И (ВЫРАЗИТЬ(ДокЗаявка.Пайщик КАК Справочник.ЮрФизЛица).ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо))
		|			И (ДокЗаявка.Организация = &Организация)
		|			И (НЕОПРЕДЕЛЕНО В (&Клиенты)
		|				ИЛИ ДокЗаявка.Пайщик В (&Клиенты))
		|			И (ДокЗаявка.Дата < &КонецПериода)
		|			И (НЕ ДокЗаявка.ПометкаУдаления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВнешнихСистем КАК _КодыПервойФормыПифов
		|		ПО ДокЗаявка.ПаевойИнвестиционныйФонд = _КодыПервойФормыПифов.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВнешнихСистем КАК _КодыПервойФормыПифовДляОбмена
		|		ПО ДокЗаявка.ПаевойИнвестиционныйФондДляОбменаПаев = _КодыПервойФормыПифовДляОбмена.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВнешнихСистем КАК _КодыКлиентовПервойФормы
		|		ПО ДокЗаявка.Пайщик = _КодыКлиентовПервойФормы.Объект
		|ГДЕ
		|	НЕ _КодыКлиентовПервойФормы.Код ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДолиПайщиковВИнвестиционномФондеОстатки.Пайщик КАК Клиент,
		|	ДолиПайщиковВИнвестиционномФондеОстатки.ПаевойИнвестиционныйФонд КАК АктивСсылка,
		|	ДолиПайщиковВИнвестиционномФондеОстатки.Партия.Заявка КАК ЗаявкаСсылка,
		|	СУММА(ДолиПайщиковВИнвестиционномФондеОстатки.КоличествоОстаток) КАК Количество
		|ПОМЕСТИТЬ _ОстаткиПаев
		|ИЗ
		|	РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.Остатки(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И Пайщик В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_ЗаявкиКлиентов.Клиент
		|					ИЗ
		|						_ЗаявкиКлиентов)) КАК ДолиПайщиковВИнвестиционномФондеОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ДолиПайщиковВИнвестиционномФондеОстатки.Пайщик,
		|	ДолиПайщиковВИнвестиционномФондеОстатки.ПаевойИнвестиционныйФонд,
		|	ДолиПайщиковВИнвестиционномФондеОстатки.Партия.Заявка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.АктивСсылка КАК АктивСсылка,
		|	ВложенныйЗапрос.Клиент КАК Клиент,
		|	ВложенныйЗапрос.КодКлиента1Ф КАК КодКлиента1Ф,
		|	ВложенныйЗапрос.ДатаЗаявки КАК ДатаЗаявки,
		|	ЕСТЬNULL(_ЗаявкиНаПриобретение.Ссылка, _ЗаявкиНаОбмен.Ссылка) КАК ЗаявкаСсылка,
		|	ЕСТЬNULL(_ЗаявкиНаПриобретение.НомерЗаявки, _ЗаявкиНаОбмен.НомерЗаявки) КАК НомерЗаявки,
		|	ЕСТЬNULL(_ЗаявкиНаПриобретение.ОсновнаяЗаявка, _ЗаявкиНаОбмен.ОсновнаяЗаявка) КАК ОсновнаяЗаявка,
		|	ЕСТЬNULL(_ЗаявкиНаПриобретение.КодАктива, _ЗаявкиНаОбмен.КодАктиваДляОбмена) КАК КодАктива1Ф
		|ПОМЕСТИТЬ _ПродуктыКлиентов
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВЫБОР
		|			КОГДА _ЗаявкиКлиентов.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен)
		|				ТОГДА _ЗаявкиКлиентов.АктивДляОбмена
		|			ИНАЧЕ _ЗаявкиКлиентов.АктивСсылка
		|		КОНЕЦ КАК АктивСсылка,
		|		_ЗаявкиКлиентов.Клиент КАК Клиент,
		|		_ЗаявкиКлиентов.КодКлиента КАК КодКлиента1Ф,
		|		МИНИМУМ(_ЗаявкиКлиентов.ДатаЗаявки) КАК ДатаЗаявки
		|	ИЗ
		|		_ЗаявкиКлиентов КАК _ЗаявкиКлиентов
		|	ГДЕ
		|		_ЗаявкиКлиентов.ВидЗаявки В (ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Зачисление), ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен))
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ВЫБОР
		|			КОГДА _ЗаявкиКлиентов.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен)
		|				ТОГДА _ЗаявкиКлиентов.АктивДляОбмена
		|			ИНАЧЕ _ЗаявкиКлиентов.АктивСсылка
		|		КОНЕЦ,
		|		_ЗаявкиКлиентов.Клиент,
		|		_ЗаявкиКлиентов.КодКлиента) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗаявкиКлиентов КАК _ЗаявкиНаПриобретение
		|		ПО ВложенныйЗапрос.АктивСсылка = _ЗаявкиНаПриобретение.АктивСсылка
		|			И ВложенныйЗапрос.Клиент = _ЗаявкиНаПриобретение.Клиент
		|			И ВложенныйЗапрос.ДатаЗаявки = _ЗаявкиНаПриобретение.ДатаЗаявки
		|			И (_ЗаявкиНаПриобретение.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Зачисление))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗаявкиКлиентов КАК _ЗаявкиНаОбмен
		|		ПО ВложенныйЗапрос.АктивСсылка = _ЗаявкиНаОбмен.АктивДляОбмена
		|			И ВложенныйЗапрос.Клиент = _ЗаявкиНаОбмен.Клиент
		|			И ВложенныйЗапрос.ДатаЗаявки = _ЗаявкиНаОбмен.ДатаЗаявки
		|			И (_ЗаявкиНаОбмен.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПродуктыКлиентов.ЗаявкаСсылка КАК ЗаявкаСсылка,
		|	_ПродуктыКлиентов.ЗаявкаСсылка КАК ПараметрОшибки,
		|	""По заявке %1 обнаружено несколько клиентов/пайщиков"" КАК ТекстОшибки
		|ПОМЕСТИТЬ _Ошибки
		|ИЗ
		|	_ПродуктыКлиентов КАК _ПродуктыКлиентов
		|
		|СГРУППИРОВАТЬ ПО
		|	_ПродуктыКлиентов.ЗаявкаСсылка,
		|	_ПродуктыКлиентов.ЗаявкаСсылка
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ПродуктыКлиентов.Клиент) > 1
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_ПродуктыКлиентов.АктивСсылка,
		|	_ПродуктыКлиентов.Клиент,
		|	""Не удалось найти код первой формы колл центра для клиента/пайщика %1. Проверьте наличие данных в первой форме, при необходимоти выгрузите данные клиента/пайщика в 1Ф""
		|ИЗ
		|	_ПродуктыКлиентов КАК _ПродуктыКлиентов
		|ГДЕ
		|	_ПродуктыКлиентов.КодКлиента1Ф ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПродуктыКлиентов.АктивСсылка КАК АктивСсылка,
		|	_ПродуктыКлиентов.Клиент КАК Клиент,
		|	_ПродуктыКлиентов.КодКлиента1Ф КАК КодКлиента1Ф,
		|	_ПродуктыКлиентов.ДатаЗаявки КАК ДатаЗаявки,
		|	_ПродуктыКлиентов.ЗаявкаСсылка КАК ЗаявкаСсылка,
		|	_ПродуктыКлиентов.НомерЗаявки КАК НомерЗаявки,
		|	_ПродуктыКлиентов.ОсновнаяЗаявка КАК ОсновнаяЗаявка,
		|	_ПродуктыКлиентов.КодАктива1Ф КАК КодАктива1Ф,
		|	_КодыПродуктов.Код КАК КодПродукта1Ф,
		|	_ОстаткиПаев.Количество КАК Количество
		|ИЗ
		|	_ПродуктыКлиентов КАК _ПродуктыКлиентов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ОстаткиПаев КАК _ОстаткиПаев
		|		ПО _ПродуктыКлиентов.ЗаявкаСсылка = _ОстаткиПаев.ЗаявкаСсылка
		|			И _ПродуктыКлиентов.Клиент = _ОстаткиПаев.Клиент
		|			И _ПродуктыКлиентов.АктивСсылка = _ОстаткиПаев.АктивСсылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КодыВнешнихСистем КАК _КодыПродуктов
		|		ПО _ПродуктыКлиентов.ЗаявкаСсылка = _КодыПродуктов.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Ошибки КАК _Ошибки
		|		ПО _ПродуктыКлиентов.ЗаявкаСсылка = _Ошибки.ЗаявкаСсылка
		|ГДЕ
		|	_Ошибки.ЗаявкаСсылка ЕСТЬ NULL
		|	И ЕСТЬNULL(_ОстаткиПаев.Количество, 0) > 0";
#КонецОбласти

    Запрос.УстановитьПараметр("Организация", ТекПараметры.Организация);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ТекПараметры.Дата));
	Запрос.УстановитьПараметр("ДатаФинПоказателя", НачалоДня(ТекПараметры.Дата));
	Запрос.УстановитьПараметр("Клиенты", ?(ТекПараметры.Свойство("Клиенты"), ТекПараметры.Клиенты, Неопределено));
	
	ПортфелиКлиентов = Запрос.Выполнить().Выгрузить(); 
	
	Если ПортфелиКлиентов.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	ПараметрыПодключения = РаботаСВнешнимиСистемами.ПерваяФорма_ПолучитьПараметрыПодключения("uk1f");
	
	Если ПараметрыПодключения = Неопределено Тогда
		ЗарегистрироватьОшибку("Ошибка подключения к первой форме колл центра.");
		Возврат;
