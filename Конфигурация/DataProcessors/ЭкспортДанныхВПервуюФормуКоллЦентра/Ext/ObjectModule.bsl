      
Функция СформироватьДанныеДляЭкспорта(ПараметрыФормирования) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц; 
		
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВнешнихСистем.Объект КАК Объект,
		|	КодыВнешнихСистем.ВнешняяСистема КАК ВнешняяСистема,
		|	КодыВнешнихСистем.Код КАК Код
		|ПОМЕСТИТЬ _КодыВнешнихСистем
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&КонецПериода,
		|			ВнешняяСистема В (ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФормаКоллЦентра), ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс))
		|				И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЗаявкиПайщиков), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Банки), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды))) КАК КодыВнешнихСистем
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыПИФ.Клиент КАК Актив,
		|	КлиентыПИФ.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаПиф
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
		|				И (СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения > &КонецПериода)) КАК КлиентыПИФ
		|ГДЕ
		|	ВЫРАЗИТЬ(КлиентыПИФ.Клиент КАК Справочник.ПаевыеИнвестиционныеФонды).Тип = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Открытый)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Ссылка КАК Ссылка,
		|	ВложенныйЗапрос.ДатаЗаявки КАК ДатаЗаявки,
		|	ВложенныйЗапрос.НомерЗаявки КАК НомерЗаявки,
		|	ВложенныйЗапрос.Клиент КАК Клиент,
		|	ВложенныйЗапрос.Сумма КАК Сумма,
		|	ВложенныйЗапрос.Количество КАК Количество,
		|	ВложенныйЗапрос.Тип КАК Тип,
		|	ВложенныйЗапрос.Актив КАК Актив,
		|	ВложенныйЗапрос.АктивДляОбмена КАК АктивДляОбмена,
		|	ВложенныйЗапрос.Основная КАК Основная,
		|	ВложенныйЗапрос.ВидЗаявки КАК ВидЗаявки,
		|	ВложенныйЗапрос.Статус КАК Статус,
		|	КодыЗаявокПервойФормы.Код КАК КодЗаявки1Ф,
		|	_КодыПервойФормыПифов.Код КАК КодАктива1Ф,
		|	_КодыПервойФормыПифовДляОбмена.Код КАК КодАктиваДляОбмена1Ф,
		|	_КодыКлиентовПервойФормы.Код КАК КодКлиента1Ф
		|ПОМЕСТИТЬ _ЗаявкиКлиентов
		|ИЗ
		|	(ВЫБРАТЬ
		|		ДокЗаявкаПайщика.Ссылка КАК Ссылка,
		|		ДокЗаявкаПайщика.НомерЗаявки КАК НомерЗаявки,
		|		ДокЗаявкаПайщика.Дата КАК ДатаЗаявки,
		|		ДокЗаявкаПайщика.Пайщик КАК Клиент,
		|		ДокЗаявкаПайщика.Сумма КАК Сумма,
		|		ДокЗаявкаПайщика.Количество КАК Количество,
		|		ДокЗаявкаПайщика.ВидЗаявки КАК ВидЗаявки,
		|		ВЫБОР
		|			КОГДА ДокЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Зачисление)
		|				ТОГДА ""Приобретение паев""
		|			КОГДА ДокЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Погашение)
		|				ТОГДА ""Погашение паев""
		|			КОГДА ДокЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен)
		|				ТОГДА ""Обмен паев""
		|		КОНЕЦ КАК Тип,
		|		ДокЗаявкаПайщика.ПаевойИнвестиционныйФонд КАК Актив,
		|		ДокЗаявкаПайщика.ПаевойИнвестиционныйФондДляОбменаПаев КАК АктивДляОбмена,
		|		ДокЗаявкаПайщика.ВыгружатьОперацииВЕСИАФинанс КАК Основная,
		|		СтатусыЗаявокПайщиковСрезПоследних.Статус КАК Статус
		|	ИЗ
		|		Документ.ЗаявкаПайщика КАК ДокЗаявкаПайщика
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаПиф КАК _СчетаПиф
		|			ПО ДокЗаявкаПайщика.ПаевойИнвестиционныйФонд = _СчетаПиф.Актив
		|				И (ДокЗаявкаПайщика.Организация = &Организация)
		|				И (ДокЗаявкаПайщика.Дата МЕЖДУ &НачалоПериода И &КонецПериода)
		|				И (ВЫРАЗИТЬ(ДокЗаявкаПайщика.Пайщик КАК Справочник.ЮрФизЛица).ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо))
		|				И (НЕОПРЕДЕЛЕНО В (&Клиенты)
		|					ИЛИ ДокЗаявкаПайщика.Пайщик В (&Клиенты))
		|				И (ДокЗаявкаПайщика.ВыгружатьОперацииВЕСИАФинанс)
		|				И (НЕ ДокЗаявкаПайщика.ПометкаУдаления)
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЗаявокПайщиков.СрезПоследних(, Организация = &Организация) КАК СтатусыЗаявокПайщиковСрезПоследних
		|			ПО ДокЗаявкаПайщика.Ссылка = СтатусыЗаявокПайщиковСрезПоследних.ЗаявкаПайщика) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВнешнихСистем КАК КодыЗаявокПервойФормы
		|		ПО ВложенныйЗапрос.Ссылка = КодыЗаявокПервойФормы.Объект
		|			И (КодыЗаявокПервойФормы.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФормаКоллЦентра))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВнешнихСистем КАК _КодыПервойФормыПифов
		|		ПО ВложенныйЗапрос.Актив = _КодыПервойФормыПифов.Объект
		|			И (_КодыПервойФормыПифов.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФормаКоллЦентра))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВнешнихСистем КАК _КодыПервойФормыПифовДляОбмена
		|		ПО ВложенныйЗапрос.АктивДляОбмена = _КодыПервойФормыПифовДляОбмена.Объект
		|			И (_КодыПервойФормыПифовДляОбмена.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФормаКоллЦентра))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВнешнихСистем КАК _КодыКлиентовПервойФормы
		|		ПО ВложенныйЗапрос.Клиент = _КодыКлиентовПервойФормы.Объект
		|			И (_КодыКлиентовПервойФормы.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФормаКоллЦентра))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КодыПервойФормы.Код КАК Код1Ф,
		|	РеквизитыФизическихЛицАнкетные.Регистратор КАК Анкета,
		|	РеквизитыФизическихЛицАнкетные.ЮрФизЛицо КАК Ссылка,
		|	РеквизитыФизическихЛицАнкетные.Фамилия КАК Фамилия,
		|	РеквизитыФизическихЛицАнкетные.Имя КАК Имя,
		|	РеквизитыФизическихЛицАнкетные.Отчество КАК Отчество,
		|	РеквизитыФизическихЛицАнкетные.Пол КАК Пол,
		|	РеквизитыФизическихЛицАнкетные.ДатаРождения КАК ДатаРождения,
		|	РеквизитыФизическихЛицАнкетные.СерияУдостоверенияЛичности КАК СерияДокумента,
		|	РеквизитыФизическихЛицАнкетные.НомерУдостоверенияЛичности КАК НомерДокумента,
		|	РеквизитыФизическихЛицАнкетные.ДатаВыдачиУдостоверенияЛичности КАК ДатаВыдачиДокумента,
		|	РеквизитыФизическихЛицАнкетные.ДатаОкончанияДействияУдостоверенияЛичности КАК ДатаОкончанияДействияДокумента,
		|	РеквизитыФизическихЛицАнкетные.ОрганВыдавшийУдостоверениеЛичности КАК ОрганВыдавшийДокумент,
		|	РеквизитыФизическихЛицАнкетные.КодОрганаВыдавшегоУдостоверениеЛичности КАК КодПодразделения,
		|	РеквизитыФизическихЛицАнкетные.СНИЛС КАК СНИЛС,
		|	РеквизитыФизическихЛицАнкетные.ИНН КАК ИНН,
		|	РеквизитыФизическихЛицАнкетные.EMail КАК EMail,
		|	РеквизитыФизическихЛицАнкетные.Телефоны КАК Телефоны,
		|	НЕ _КодыПользователейЕсиаФинанс.Код ЕСТЬ NULL КАК АктивированЛичныйКабинетЕсиа
		|ПОМЕСТИТЬ _АнкетныеДанныеКлиентов
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_ЗаявкиКлиентов.Клиент
		|					ИЗ
		|						_ЗаявкиКлиентов КАК _ЗаявкиКлиентов)) КАК РеквизитыФизическихЛицАнкетные
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВнешнихСистем КАК _КодыПервойФормы
		|		ПО РеквизитыФизическихЛицАнкетные.ЮрФизЛицо = _КодыПервойФормы.Объект
		|			И (_КодыПервойФормы.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФормаКоллЦентра))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВнешнихСистем КАК _КодыПользователейЕсиаФинанс
		|		ПО РеквизитыФизическихЛицАнкетные.ЮрФизЛицо = _КодыПользователейЕсиаФинанс.Объект
		|			И (_КодыПользователейЕсиаФинанс.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЕсиаФинанс))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АнкетаФизическогоЛицаБанковскиеРеквизиты.РасчетныйСчет КАК Ссылка,
		|	_АнкетныеДанныеКлиентов.Ссылка КАК Клиент,
		|	_АнкетныеДанныеКлиентов.Код1Ф КАК КодКлиента1Ф,
		|	АнкетаФизическогоЛицаБанковскиеРеквизиты.БИК КАК Бик,
		|	Банки.Ссылка КАК Банк,
		|	АнкетаФизическогоЛицаБанковскиеРеквизиты.НомерСчета КАК НомерСчета,
		|	АнкетаФизическогоЛицаБанковскиеРеквизиты.КоррСчет КАК КоррСчет,
		|	_КодыПервойФормы.Код КАК КодБанка1Ф
		|ПОМЕСТИТЬ _БанковскиеРеквизиты
		|ИЗ
		|	Документ.АнкетаФизическогоЛица.БанковскиеРеквизиты КАК АнкетаФизическогоЛицаБанковскиеРеквизиты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _АнкетныеДанныеКлиентов КАК _АнкетныеДанныеКлиентов
		|		ПО АнкетаФизическогоЛицаБанковскиеРеквизиты.Ссылка = _АнкетныеДанныеКлиентов.Анкета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Банки КАК Банки
		|			ЛЕВОЕ СОЕДИНЕНИЕ _КодыВнешнихСистем КАК _КодыПервойФормы
		|			ПО Банки.Ссылка = _КодыПервойФормы.Объект
		|				И (_КодыПервойФормы.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФормаКоллЦентра))
		|		ПО АнкетаФизическогоЛицаБанковскиеРеквизиты.РасчетныйСчет.Банк = Банки.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗаявкиКлиентов.Ссылка КАК ЗаявкаСсылка,
		|	_ЗаявкиКлиентов.Клиент КАК Клиент,
		|	_ЗаявкиКлиентов.НомерЗаявки КАК НомерЗаявки,
		|	_ЗаявкиКлиентов.ДатаЗаявки КАК ДатаЗаявки,
		|	_ЗаявкиКлиентов.Статус КАК Статус,
		|	_ЗаявкиКлиентов.Актив КАК Актив,
		|	""Ввод денежных средств"" КАК Тип,
		|	ДокВводДенежныхСредств.Ссылка КАК Ссылка,
		|	ДокВводДенежныхСредств.Дата КАК Дата,
		|	ДокВводДенежныхСредств.Сумма КАК Сумма,
		|	0 КАК СуммаНДФЛ
		|ПОМЕСТИТЬ _ВводыВыводыДенежныхСредств
		|ИЗ
		|	_ЗаявкиКлиентов КАК _ЗаявкиКлиентов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВводДенежныхСредств КАК ДокВводДенежныхСредств
		|		ПО _ЗаявкиКлиентов.Ссылка = ДокВводДенежныхСредств.Основание
		|			И (НЕ ДокВводДенежныхСредств.ПометкаУдаления)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_ЗаявкиКлиентов.Ссылка,
		|	_ЗаявкиКлиентов.Клиент,
		|	_ЗаявкиКлиентов.НомерЗаявки,
		|	_ЗаявкиКлиентов.ДатаЗаявки,
		|	_ЗаявкиКлиентов.Статус,
		|	_ЗаявкиКлиентов.Актив,
		|	""Вывод денежных средств"",
		|	ДокВыводДенежныхСредств.Ссылка,
		|	ДокВыводДенежныхСредств.Дата,
		|	ДокВыводДенежныхСредств.Сумма,
		|	ДокВыводДенежныхСредств.СуммаНДФЛ
		|ИЗ
		|	_ЗаявкиКлиентов КАК _ЗаявкиКлиентов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыводДенежныхСредств КАК ДокВыводДенежныхСредств
		|		ПО _ЗаявкиКлиентов.Ссылка = ДокВыводДенежныхСредств.Основание
		|			И (НЕ ДокВыводДенежныхСредств.ПометкаУдаления)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗаявкиКлиентов.Ссылка КАК ЗаявкаСсылка,
		|	_ЗаявкиКлиентов.Клиент КАК Клиент,
		|	_ЗаявкиКлиентов.НомерЗаявки КАК НомерЗаявки,
		|	_ЗаявкиКлиентов.ДатаЗаявки КАК ДатаЗаявки,
		|	_ЗаявкиКлиентов.Статус КАК Статус,
		|	ДокЗачислениеПаев.ПаевойИнвестиционныйФонд КАК Актив,
		|	ДокЗачислениеПаев.Ссылка КАК Ссылка,
		|	ДокЗачислениеПаев.Дата КАК Дата,
		|	ДокЗачислениеПаев.Количество КАК Количество,
		|	ДокЗачислениеПаев.Сумма КАК Сумма,
		|	ДокЗачислениеПаев.СуммаНадбавки КАК СуммаНадбавки
		|ПОМЕСТИТЬ _ЗачисленияПаев
		|ИЗ
		|	_ЗаявкиКлиентов КАК _ЗаявкиКлиентов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗачислениеПаев КАК ДокЗачислениеПаев
		|		ПО _ЗаявкиКлиентов.Ссылка = ДокЗачислениеПаев.Заявка
		|			И (НЕ ДокЗачислениеПаев.ПометкаУдаления)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
