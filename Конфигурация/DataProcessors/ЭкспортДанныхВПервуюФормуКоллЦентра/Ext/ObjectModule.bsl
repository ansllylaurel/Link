		|	_ПродуктыКлиентов.КодПродукта1Ф КАК КодПродукта1Ф,
		|	_ПродуктыКлиентов.КодАктива1Ф КАК КодАктива1Ф,
		|	_ПродуктыКлиентов.КодКлиента1Ф КАК КодКлиента1Ф,
		|	ЕСТЬNULL(_ОстаткиПаев.Количество, 0) КАК Количество
		|ИЗ
		|	_ПродуктыКлиентов КАК _ПродуктыКлиентов
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиПаев КАК _ОстаткиПаев
		|		ПО _ПродуктыКлиентов.ЗаявкаСсылка = _ОстаткиПаев.ЗаявкаСсылка
		|			И _ПродуктыКлиентов.Клиент = _ОстаткиПаев.Клиент
		|			И _ПродуктыКлиентов.Актив = _ОстаткиПаев.Актив";	
#КонецОбласти 
	
    Запрос.УстановитьПараметр("НачалоПериода", ПараметрыФормирования.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ПараметрыФормирования.КонецПериода));
	Запрос.УстановитьПараметр("Организация", ПараметрыФормирования.Организация);
	Запрос.УстановитьПараметр("Клиенты", ?(ПараметрыФормирования.Свойство("Клиенты"), ПараметрыФормирования.Клиенты, Неопределено));
	Запрос.УстановитьПараметр("Пиф", ?(ПараметрыФормирования.Свойство("Пиф"), ПараметрыФормирования.Пиф, Неопределено));
	
	ВыборкаПортфелей = Запрос.Выполнить().Выбрать();
	
	ВыборкаАнкетныхДанных = Запрос.МенеджерВременныхТаблиц.Таблицы["_АнкетныеДанныеКлиентов"].ПолучитьДанные().Выбрать();
	
	Если ВыборкаАнкетныхДанных.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	ДанныеДляЭкспорта = СформироватьСтруктуруДанных();
		
	Пока ВыборкаАнкетныхДанных.Следующий() Цикл
				
		НоваяСтрока = ДанныеДляЭкспорта.ТаблицаКлиентов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаАнкетныхДанных);
		
		Если ЗначениеЗаполнено(ВыборкаАнкетныхДанных.EMail) Тогда 	
			НоваяСтрока.Контакты.Добавить(Новый Структура("ТипСвязи, АдресНомер", "Email", ВыборкаАнкетныхДанных.EMail)); 
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаАнкетныхДанных.Телефоны) Тогда
			НоваяСтрока.Контакты.Добавить(Новый Структура("ТипСвязи, АдресНомер", "Телефон", ВыборкаАнкетныхДанных.Телефоны)); 
		КонецЕсли;
			
	КонецЦикла; 
	
	ВыборкаБанковскихРеквизитов = Запрос.МенеджерВременныхТаблиц.Таблицы["_БанковскиеРеквизиты"].ПолучитьДанные().Выбрать();
	
	Пока ВыборкаБанковскихРеквизитов.Следующий() Цикл
				
		СтрокаРеквизитов = ДанныеДляЭкспорта.БанковскиеРеквизиты.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРеквизитов, ВыборкаБанковскихРеквизитов);
		
	КонецЦикла;
				
	ВыборкаОпераций = Запрос.МенеджерВременныхТаблиц.Таблицы["_Операции"].ПолучитьДанные().Выбрать();
	
	Пока ВыборкаОпераций.Следующий() Цикл
				
		СтрокаОпераций = ДанныеДляЭкспорта.Операции.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаОпераций, ВыборкаОпераций);
					
	КонецЦикла;
	
	ВыборкаЗаявок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ЗаявкиКлиентов"].ПолучитьДанные().Выбрать();
	
	Пока ВыборкаЗаявок.Следующий() Цикл
				
		СтрокаЗаявок = ДанныеДляЭкспорта.Заявки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЗаявок, ВыборкаЗаявок);
					
	КонецЦикла; 
		
	Пока ВыборкаПортфелей.Следующий() Цикл 
		
		СтрокаПродуктов = ДанныеДляЭкспорта.Продукты.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПродуктов, ВыборкаПортфелей);
		
		Если ВыборкаПортфелей.Количество() > 0 Тогда
			СтрокаПортфеля = ДанныеДляЭкспорта.Портфель.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПортфеля, ВыборкаПортфелей);
		КонецЕсли;
					
	КонецЦикла;
	
	Возврат ДанныеДляЭкспорта;
	
КонецФункции 

Процедура Экспортировать(ДанныеДляЭкспорта) Экспорт 
					
	НовыеКодыБанков = Неопределено;
		
	Если ДанныеДляЭкспорта.Свойство("ТаблицаКлиентов") И ДанныеДляЭкспорта.ТаблицаКлиентов.Количество() <> 0 Тогда
			
		ПараметрыПодключения = РаботаСВнешнимиСистемами.ПерваяФорма_ПолучитьПараметрыПодключения("uk1f");
		
		Если ПараметрыПодключения = Неопределено Тогда
			ЗарегистрироватьОшибку("Ошибка подключения к первой форме колл центра.");
			Возврат;
		КонецЕсли;
					
		Если ДанныеДляЭкспорта.Свойство("БанковскиеРеквизиты") И ДанныеДляЭкспорта.БанковскиеРеквизиты.Количество() > 0 Тогда
			НовыеКодыБанков = ПолучитьКодыБанковИзПервойФормы(ДанныеДляЭкспорта.БанковскиеРеквизиты, ПараметрыПодключения);		
		КонецЕсли;
		
		Для Каждого ТекКлиент Из ДанныеДляЭкспорта.ТаблицаКлиентов Цикл 
			
			ФлагЗаполнитьКодКлиента = Не ЗначениеЗаполнено(ТекКлиент.Код1Ф);
						
			Если Не ЭкспортироватьАнкетныеДанныеКлиента(ТекКлиент, ПараметрыПодключения) Тогда
				Продолжить;
			КонецЕсли;
						
			ТаблицаПродуктов = Неопределено;
			
			Если Не ЗначениеЗаполнено(ТекКлиент.Код1Ф) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ДанныеДляЭкспорта.Свойство("БанковскиеРеквизиты") Тогда
				
				РеквизитыКлиента = ДанныеДляЭкспорта.БанковскиеРеквизиты.НайтиСтроки(Новый Структура("Клиент", ТекКлиент.Ссылка));
				ЗаполнитьКодКлиента(ТекКлиент.Код1Ф, РеквизитыКлиента, ФлагЗаполнитьКодКлиента);
				ЭкспортироватьБанковскиеРеквизитыКлиентов(РеквизитыКлиента, ПараметрыПодключения, НовыеКодыБанков);
			
			КонецЕсли;
						
			Если ДанныеДляЭкспорта.Свойство("Продукты") Тогда
				
				ТаблицаПродуктов = ДанныеДляЭкспорта.Продукты.Скопировать(Новый Структура("Клиент", ТекКлиент.Ссылка));
				ЗаполнитьКодКлиента(ТекКлиент.Код1Ф, ТаблицаПродуктов, ФлагЗаполнитьКодКлиента);
				ЭкспортироватьПродуктыКлиентов(ТаблицаПродуктов, ПараметрыПодключения);
					
			КонецЕсли;
            //В таблицу "Операции" экспортируются и активные заявки, по которым еще не было поступлений/погашений паев. 
			Если ДанныеДляЭкспорта.Свойство("Операции") Тогда
										
				ОперацииПользователя = ДанныеДляЭкспорта.Операции.НайтиСтроки(Новый Структура("Клиент", ТекКлиент.Ссылка));
				ЗаполнитьКодКлиента(ТекКлиент.Код1Ф, ОперацииПользователя, ФлагЗаполнитьКодКлиента);
				ЭкспортироватьОперацииКлиентов(ОперацииПользователя, ПараметрыПодключения, ТаблицаПродуктов);
									
			КонецЕсли; 
						
			Если ДанныеДляЭкспорта.Свойство("Портфель") Тогда

				ПортфельПользователя = ДанныеДляЭкспорта.Портфель.НайтиСтроки(Новый Структура("Клиент", ТекКлиент.Ссылка));
				ЗаполнитьКодКлиента(ТекКлиент.Код1Ф, ПортфельПользователя, ФлагЗаполнитьКодКлиента);
				ЭкспортироватьПортфелиКлиентов(ПортфельПользователя, ПараметрыПодключения, ТаблицаПродуктов);
									
			КонецЕсли; 
																		
		КонецЦикла;
		
	КонецЕсли;
	
	ОповеститьОбОшибках();
				
КонецПроцедуры  

Функция ЭкспортироватьАнкетныеДанныеКлиента(ДанныеКлиента, ПараметрыПодключения)
	
	//если есть код первой формы проверим и обновим анкетные данные
	//доработать сверку контактных данных
	Если ЗначениеЗаполнено(ДанныеКлиента.Код1Ф) Тогда 
				
		ОбновитьДанныеПервойФормы(ДанныеКлиента.Код1Ф, ДанныеКлиента, ПараметрыПодключения,, "201"); //параметр GUID исключил из сверки
				
	Иначе
				
		GUID = Строка(ДанныеКлиента.Ссылка.УникальныйИдентификатор()); 
		
		//проверяем наличие клиента по GUID
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("startRow", 0);
		СтруктураЗапроса.Вставить("endRow", 10);
		СтруктураЗапроса.Вставить("select", РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("field, type", "taskId", "numberValue")));
		СтруктураЗапроса.Вставить("filterModel", Новый Структура("ExtParam201", Новый Структура("filterType, type, filter", "text", "equals", GUID)));
				
		ТекстСообщения = "Не удалось получить данные клиента [" + ДанныеКлиента.Ссылка + "] из первой формы по GUID 1С [" + GUID + "]."; 
		
		ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
							
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api-core/datasource/subcat/23/data", ТелоЗапроса, ТекстСообщения);
					
		Если HTTPОтвет = Неопределено Тогда
			ЗарегистрироватьОшибку(ТекстСообщения);   
			Возврат Ложь;
		КонецЕсли;
		
		КодКлиента1Ф = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"), "totalCount");
			
		Если КодКлиента1Ф = 0 Тогда
			
			МассивПараметров = Новый Массив();
			
			МассивПараметров.Добавить(Новый Структура("id, value", 78, ДанныеКлиента.ИНН)); //ИНН (Text)  
			МассивПараметров.Добавить(Новый Структура("id, value", 165, "Открытый")); //Статус клиента (Select Открытый/Закрытый/Нет)
			МассивПараметров.Добавить(Новый Структура("id, value", 201, GUID)); //GUID (Text) 
			МассивПараметров.Добавить(Новый Структура("id, value", 76, ДанныеКлиента.Фамилия)); //Фамилия (Text)
			МассивПараметров.Добавить(Новый Структура("id, value", 75, ДанныеКлиента.Имя)); //Имя (Text)
			МассивПараметров.Добавить(Новый Структура("id, value", 74, ДанныеКлиента.Отчество)); //Отчество (Text)
			МассивПараметров.Добавить(Новый Структура("id, value", 168, ?(ДанныеКлиента.Пол = Перечисления.ПолФизическогоЛица.Мужской, "М", "Ж"))); //Пол (Select М/Ж)
			МассивПараметров.Добавить(Новый Структура("id, value", 77, Формат(ДанныеКлиента.ДатаРождения, "ДФ=гггг-ММ-дд"))); //Дата рождения (Date)
			МассивПараметров.Добавить(Новый Структура("id, value", 169, ДанныеКлиента.СНИЛС)); //СНИЛС (Text)
			МассивПараметров.Добавить(Новый Структура("id, value", 84, ДанныеКлиента.СерияДокумента)); //Серия паспорта (Text)
			МассивПараметров.Добавить(Новый Структура("id, value", 85, ДанныеКлиента.НомерДокумента)); //Номер паспорта (Text)
			МассивПараметров.Добавить(Новый Структура("id, value", 86, Формат(ДанныеКлиента.ДатаВыдачиДокумента, "ДФ=гггг-ММ-дд"))); //Дата выдачи (Date)
			МассивПараметров.Добавить(Новый Структура("id, value", 87, ДанныеКлиента.ОрганВыдавшийДокумент)); //Кем выдан (Text)
			МассивПараметров.Добавить(Новый Структура("id, value", 88, ДанныеКлиента.КодПодразделения)); //Код подразделения (Text)
			МассивПараметров.Добавить(Новый Структура("id, value", 221, Формат(ДанныеКлиента.АктивированЛичныйКабинетЕсиа, "БЛ=false; БИ=true")));

			Если ЗначениеЗаполнено(ДанныеКлиента.ДатаОкончанияДействияДокумента) Тогда 
				МассивПараметров.Добавить(Новый Структура("id, value", 167, Формат(ДанныеКлиента.ДатаОкончанияДействияДокумента, "ДФ=гггг-ММ-дд"))); //Действует до (Date)
			КонецЕсли;
			
			Если ДанныеКлиента.Контакты.Количество() > 0 Тогда									
	            МассивПараметров.Добавить(СформироватьПараметрКонтактов(ДанныеКлиента.Контакты));	
			КонецЕсли;
						
			ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("subcatId, extParams", 23, МассивПараметров));
			
			ТекстСообщения = "Ошибка экспорта данных физ лица [" + ДанныеКлиента.Ссылка + "].";
			
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks/create", ТелоЗапроса, ТекстСообщения);
			
			Если HTTPОтвет = Неопределено Тогда
				ЗарегистрироватьОшибку(ТекстСообщения);   
				Возврат Ложь;
			КонецЕсли;
			
			КодКлиента1Ф = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"), "data");
			
			Если ЗначениеЗаполнено(КодКлиента1Ф) Тогда  
				
				ДанныеКлиента.Код1Ф = КодКлиента1Ф; 
						
				РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(
					ДанныеКлиента.Ссылка, 
					Справочники.ВнешниеСистемы.ПерваяФормаКоллЦентра, 
					Справочники.ГруппыИмпортируемыхОбъектов.ФизическиеЛица,
					КодКлиента1Ф);
				
			КонецЕсли;
				
		ИначеЕсли ЗначениеЗаполнено(КодКлиента1Ф) Тогда
			ДанныеКлиента.Код1Ф = КодКлиента1Ф;
			
			РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(
				ДанныеКлиента.Ссылка, 
				Справочники.ВнешниеСистемы.ПерваяФормаКоллЦентра, 
				Справочники.ГруппыИмпортируемыхОбъектов.ФизическиеЛица,
				КодКлиента1Ф);

			ЗарегистрироватьОшибку("В первой форме присутствуеют данные клиента [" + ДанныеКлиента.Ссылка + "] задача [" + КодКлиента1Ф + "]. В регистре [Коды во внешних системах] отсутствует код задачи.");	
		КонецЕсли;
			
	КонецЕсли;
	
	Возврат Истина;
		
КонецФункции 

Процедура ЭкспортироватьБанковскиеРеквизитыКлиентов(Реквизиты, ПараметрыПодключения, НовыеКодыБанков = Неопределено)
	
	ТекстСообщения = "Ошибка экспорта банковских реквизитов клиента ID [%1].";
	СчетчикОшибок = 3;
	
	//доработать обновление реквизитов
	Для Каждого ТекРеквизиты Из Реквизиты Цикл 
		
		Если Не ЗначениеЗаполнено(ТекРеквизиты.Клиент) Тогда
			ЗарегистрироватьОшибку("Ошибка экспорта данных расчетного счета [" + ТекРеквизиты.Ссылка + "]. Отсутствует ID клиента в первой форме.");
			
			Если СчетчикОшибок = 0 Тогда
				Возврат;
			Иначе
				СчетчикОшибок = СчетчикОшибок - 1;
			КонецЕсли;

			Продолжить;
		КонецЕсли;
	
		GUID = Строка(ТекРеквизиты.Ссылка.УникальныйИдентификатор()); 
		
		//Ищем счет по GUID. Выгружаем если ничего не нашли. 
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("startRow", 0);
		СтруктураЗапроса.Вставить("endRow", 10);
		СтруктураЗапроса.Вставить("select", РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("field, type", "taskId", "numberValue")));
		СтруктураЗапроса.Вставить("filterModel", Новый Структура("ExtParam201", Новый Структура("filterType, type, filter", "text", "equals", GUID)));
		
		ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
							
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api-core/datasource/subcat/40/data", ТелоЗапроса, ТекстСообщения);
					
		Если HTTPОтвет = Неопределено Тогда
			ЗарегистрироватьОшибку(СтрШаблон(ТекстСообщения, ТекРеквизиты.Клиент)); 
			
			Если СчетчикОшибок = 0 Тогда
				Возврат;
			Иначе
				СчетчикОшибок = СчетчикОшибок - 1;
			КонецЕсли;

			Продолжить;
		КонецЕсли;
		
		НомерЗадачи = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"), "totalCount");
			
		Если НомерЗадачи = 0 Тогда
			
			МассивПараметров = Новый Массив;
			
			МассивПараметров.Добавить(Новый Структура("id, value", 98, ТекРеквизиты.КодКлиента1Ф)); 
			МассивПараметров.Добавить(Новый Структура("id, value", 172, ТекРеквизиты.НомерСчета));
			МассивПараметров.Добавить(Новый Структура("id, value", 201, GUID));
			МассивПараметров.Добавить(Новый Структура("id, value", 202, "Российский рубль"));
					
			Если ЗначениеЗаполнено(ТекРеквизиты.КодБанка1Ф) Тогда 
				
				МассивПараметров.Добавить(Новый Структура("id, value", 171, ТекРеквизиты.КодБанка1Ф));

			ИначеЕсли НовыеКодыБанков <> Неопределено Тогда
				
				МассивСтрок = НовыеКодыБанков.НайтиСтроки(Новый Структура("Банк", ТекРеквизиты.Банк));
				
				Если МассивСтрок.Количество() > 0 Тогда
					МассивПараметров.Добавить(Новый Структура("id, value", 171, МассивСтрок[0].КодБанка1Ф));	
				КонецЕсли;
				
			Иначе
				
				ЗарегистрироватьОшибку("Не удалось экспортировать банковские реквизиты клиента [" + ТекРеквизиты.Клиент + "]. Не найден код банка [" + ТекРеквизиты.Банк + "] в первой форме.");
				
				Если СчетчикОшибок = 0 Тогда
					Возврат;
				Иначе
					СчетчикОшибок = СчетчикОшибок - 1;
				КонецЕсли;

				Продолжить;
				
			КонецЕсли;  
			
			ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("subcatId, extParams", 40, МассивПараметров));
		
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks/create", ТелоЗапроса, ТекстСообщения);
						
			Если HTTPОтвет = Неопределено Или Не ЗначениеЗаполнено(ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"), "data")) Тогда
				
				ЗарегистрироватьОшибку(ТекстСообщения);
				
				Если СчетчикОшибок = 0 Тогда
					Возврат;
				Иначе
					СчетчикОшибок = СчетчикОшибок - 1;
				КонецЕсли;

				Продолжить;
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЦикла; 
		
КонецПроцедуры

Процедура ЭкспортироватьОперацииКлиентов(ТаблицаОпераций, ПараметрыПодключения, Продукты = Неопределено)
		
	//Заявки и операции выгружаются в одну таблицу
	//Выгружаем только активные заявки, на онсновании которых еще не созданы зачисления/погашения паев.
	//После того как на основании заявки создали зачисление/погашение паев - в первой форме меняем GUID заявки на GUID операции.	
	
	ТекстСообщения = "Ошибка экспорта операции [%1] клиента ID [%2].";
	
	СчетчикОшибок = 3;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("startRow", 0);
	СтруктураЗапроса.Вставить("endRow", 10);
	СтруктураЗапроса.Вставить("select", РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("field, type", "taskId", "numberValue")));
	СтруктураЗапроса.Вставить("filterModel", Новый Структура("ExtParam201", Новый Структура("filterType, type, filter", "text", "equals")));
	
	Для Каждого ТекОперация Из ТаблицаОпераций Цикл 
		
		Если Не ЗначениеЗаполнено(ТекОперация.КодКлиента1Ф) Тогда
			ЗарегистрироватьОшибку("Ошибка экспорта операции [" + ТекОперация.Ссылка + "]. Отсутствует ID клиента в первой форме.", СчетчикОшибок);
			
			Если СчетчикОшибок = 0 Тогда
				Возврат;
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		//1. Ищем запись (задачу) в 1Ф по GUID операции.
		Если ЗначениеЗаполнено(ТекОперация.Дата) Тогда // дату заполняем только для операции
			
			СтруктураЗапроса.filterModel.ExtParam201.filter = Строка(ТекОперация.Ссылка.УникальныйИдентификатор());
			ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
								
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api-core/datasource/subcat/42/data", ТелоЗапроса, ТекстСообщения);
					
			Если HTTPОтвет = Неопределено Тогда
				ЗарегистрироватьОшибку(СтрШаблон(ТекстСообщения, ТекОперация.Ссылка, ТекОперация.КодКлиента1Ф), СчетчикОшибок); 
				
				Если СчетчикОшибок = 0 Тогда
					Возврат;
				КонецЕсли;
				
				Продолжить;
			КонецЕсли;
		
			НомерЗадачиОперации = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"), "totalCount");
			
			//2. Если не нашли задачу по GUID операции, ищем по GUID заявки  
			Если НомерЗадачиОперации = 0 Тогда 
				
				Если ТекОперация.Тип = "Приобретение паев" Или ТекОперация.Тип = "Погашение паев" Тогда 
				
					СтруктураЗапроса.filterModel.ExtParam201.filter = Строка(ТекОперация.ЗаявкаСсылка.УникальныйИдентификатор());
					ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
										
					HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api-core/datasource/subcat/42/data", ТелоЗапроса, ТекстСообщения);
							
					Если HTTPОтвет = Неопределено Тогда
						ЗарегистрироватьОшибку(СтрШаблон(ТекстСообщения, ТекОперация.Ссылка, ТекОперация.КодКлиента1Ф), СчетчикОшибок);
						
						Если СчетчикОшибок = 0 Тогда
							Возврат;
						КонецЕсли;
						
						Продолжить;
					КонецЕсли;
				
					НомерЗадачиОперации = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"), "totalCount"); 
					
					//3. Если нашли задачу по GUID заявки - обновляем GUID заявки на GUID операции
					Если ЗначениеЗаполнено(НомерЗадачиОперации) Тогда
						
						//обновление данных							
						ОбновитьДанныеПервойФормы(НомерЗадачиОперации, ТекОперация, ПараметрыПодключения, "187,183,184,200,201");
						Продолжить;
						
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе				
				Продолжить;				
			КонецЕсли;
			
		Иначе //это заявка, ищем запись по GUID заявки
			
			СтруктураЗапроса.filterModel.ExtParam201.filter = Строка(ТекОперация.ЗаявкаСсылка.УникальныйИдентификатор());
			ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
								
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api-core/datasource/subcat/42/data", ТелоЗапроса, ТекстСообщения);
					
			Если HTTPОтвет = Неопределено Тогда
				ЗарегистрироватьОшибку(СтрШаблон(ТекстСообщения, ТекОперация.Ссылка, ТекОперация.КодКлиента1Ф), СчетчикОшибок); 
				
				Если СчетчикОшибок = 0 Тогда
					Возврат;
				КонецЕсли;
				
				Продолжить;
			КонецЕсли;
		
			НомерЗадачиОперации = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"), "totalCount");
			 
			Если ЗначениеЗаполнено(НомерЗадачиОперации) Тогда
				//обновляем статус.					
				ОбновитьДанныеПервойФормы(НомерЗадачиОперации, ТекОперация, ПараметрыПодключения, "200");
				Продолжить;				
			КонецЕсли;
	
		КонецЕсли; 
		
		КодПродукта = ?(ЗначениеЗаполнено(ТекОперация.КодПродукта1Ф), ТекОперация.КодПродукта1Ф, ПолучитьКодПродукта(ТекОперация.СсылкаЗаявкиАктива, ПараметрыПодключения, Продукты));
		
		Если Не ЗначениеЗаполнено(КодПродукта) Тогда 
			ЗарегистрироватьОшибку("Не удалось получить код продукта по GUID заявки [" + ТекОперация.СсылкаЗаявкиАктива + "].", СчетчикОшибок); 
			
			Если СчетчикОшибок = 0 Тогда
				Возврат;
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		КодПродуктаДляОбмена = Неопределено;
		
		Если ЗначениеЗаполнено(ТекОперация.СсылкаЗаявкиАктиваДляОбмена) Тогда
			
			КодПродуктаДляОбмена = ?(ЗначениеЗаполнено(ТекОперация.КодПродуктаДляОбмена1Ф), ТекОперация.КодПродуктаДляОбмена1Ф, ПолучитьКодПродукта(ТекОперация.СсылкаЗаявкиАктиваДляОбмена, ПараметрыПодключения, Продукты));
		
			Если Не ЗначениеЗаполнено(КодПродуктаДляОбмена) Тогда 
				ЗарегистрироватьОшибку("Не удалось получить код продукта по GUID заявки [" + ТекОперация.СсылкаЗаявкиАктиваДляОбмена + "].", СчетчикОшибок); 
				
				Если СчетчикОшибок = 0 Тогда
					Возврат;
				КонецЕсли;
			
				Продолжить;
			КонецЕсли; 
				
		КонецЕсли;

		МассивПараметров = Новый Массив;
		
		МассивПараметров.Добавить(Новый Структура("id, value", 98, ТекОперация.КодКлиента1Ф)); 
		МассивПараметров.Добавить(Новый Структура("id, value", 179, ТекОперация.Тип));
		МассивПараметров.Добавить(Новый Структура("id, value", 180, ТекОперация.НомерЗаявки));	
		МассивПараметров.Добавить(Новый Структура("id, value", 201, Строка(ТекОперация.Ссылка.УникальныйИдентификатор())));
		МассивПараметров.Добавить(Новый Структура("id, value", 207, КодПродукта));		
		МассивПараметров.Добавить(Новый Структура("id, value", 209, Формат(ТекОперация.ДатаЗаявки, "ДФ=гггг-ММ-дд"))); //ДатаЗаявки
		МассивПараметров.Добавить(Новый Структура("id, value", 208, Формат(ТекОперация.Цена, "ЧН=0; ЧГ=0"))); //цена ед.
		МассивПараметров.Добавить(Новый Структура("id, value", 184, Формат(ТекОперация.Сумма, "ЧН=0; ЧГ=0")));
		МассивПараметров.Добавить(Новый Структура("id, value", 183, Формат(ТекОперация.Количество, "ЧН=0; ЧГ=0")));
		МассивПараметров.Добавить(Новый Структура("id, value", 185, Формат(ТекОперация.СкидкаНадбавка, "ЧН=0; ЧГ=0"))); 
		МассивПараметров.Добавить(Новый Структура("id, value", 186, Формат(ТекОперация.СуммаНДФЛ, "ЧН=0; ЧГ=0")));

		Если ЗначениеЗаполнено(КодПродуктаДляОбмена) Тогда
			МассивПараметров.Добавить(Новый Структура("id, value", 219, КодПродуктаДляОбмена));	
		КонецЕсли;

		Если ЗначениеЗаполнено(ТекОперация.Дата) Тогда
			МассивПараметров.Добавить(Новый Структура("id, value", 187, Формат(ТекОперация.Дата, "ДФ=гггг-ММ-ддTЧЧ:mm:ss"))); //ДатаОперации	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекОперация.Статус) Тогда
			МассивПараметров.Добавить(Новый Структура("id, value", 200, Строка(ТекОперация.Статус)));
		КонецЕсли;
		
		ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("subcatId, extParams", 42, МассивПараметров));
	
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks/create", ТелоЗапроса, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Или Не ЗначениеЗаполнено(ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"), "data")) Тогда
			
			ЗарегистрироватьОшибку(СтрШаблон(ТекстСообщения, ТекОперация.Ссылка, ТекОперация.КодКлиента1Ф), СчетчикОшибок); 
			
			Если СчетчикОшибок = 0 Тогда
				Возврат;
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры 

Процедура ЭкспортироватьПортфелиКлиентов(Портфели, ПараметрыПодключения, Продукты = Неопределено)
	
	ТекстСообщения = "Ошибка экспорта портфелей. Заявка [%1]."; 
	МассивДанных = Новый Массив;
	Обновленные = 0;
	
	Для Каждого СтрокаАктивПортфеля Из Портфели Цикл 
									
		КодПортфеля = ПолучитьКодПортфеля(СтрокаАктивПортфеля.ЗаявкаСсылка, ПараметрыПодключения);
		
		Если ЗначениеЗаполнено(КодПортфеля) Тогда //обновляем данные по 100 записей 
			
			МассивДанных.Добавить(Новый Структура("taskId, extParamStr", КодПортфеля, "#n183#v" + Формат(СтрокаАктивПортфеля.Количество, "ЧН=0; ЧГ=0")));
			
			Если МассивДанных.Количество() = 100 Тогда 
			
				HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/extparams/update", ПолучитьСтрокуJSON(МассивДанных), ТекстСообщения);
								
				Если HTTPОтвет = Неопределено Тогда
					ЗарегистрироватьОшибку(ТекстСообщения);
				Иначе
					Обновленные = Обновленные + 100;
				КонецЕсли;
				
				МассивДанных.Очистить();
				
			КонецЕсли;
			
		ИначеЕсли КодПортфеля = 0 Тогда // добавляем запись
						
			КодПродукта = ?(ЗначениеЗаполнено(СтрокаАктивПортфеля.КодПродукта1Ф), СтрокаАктивПортфеля.КодПродукта1Ф, ПолучитьКодПродукта(СтрокаАктивПортфеля.ЗаявкаСсылка, ПараметрыПодключения, Продукты));
		
			Если Не ЗначениеЗаполнено(КодПродукта) Тогда
				ЗарегистрироватьОшибку(СтрШаблон(ТекстСообщения, СтрокаАктивПортфеля.ЗаявкаСсылка) + " Не удалось определить код продукта.");   
				Продолжить;
			КонецЕсли;

			МассивПараметров = Новый Массив;
			
			МассивПараметров.Добавить(Новый Структура("id, value", 183, Формат(СтрокаАктивПортфеля.Количество, "ЧН=0; ЧГ=0")));
			МассивПараметров.Добавить(Новый Структура("id, value", 207, КодПродукта));
			МассивПараметров.Добавить(Новый Структура("id, value", 201, Строка(СтрокаАктивПортфеля.ЗаявкаСсылка.УникальныйИдентификатор()))); 

			ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("subcatId, extParams", 43, МассивПараметров));
		
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks/create", ТелоЗапроса, ТекстСообщения);
			
			Если HTTPОтвет = Неопределено Или Не ЗначениеЗаполнено(ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"), "data")) Тогда
				ЗарегистрироватьОшибку(СтрШаблон(ТекстСообщения, СтрокаАктивПортфеля.ЗаявкаСсылка));   
				Возврат;
			КонецЕсли;
						
		КонецЕсли;
							
	КонецЦикла; 
	
	Если МассивДанных.Количество() > 0 Тогда 

		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/extparams/update", ПолучитьСтрокуJSON(МассивДанных), ТекстСообщения);
						
		Если HTTPОтвет = Неопределено Тогда
			ЗарегистрироватьОшибку(ТекстСообщения); 
		Иначе
			Обновленные = Обновленные + МассивДанных.Количество();
		КонецЕсли;
		
		МассивДанных.Очистить();
	
	КонецЕсли;
	
	ОповеститьОбОшибках();
 	
КонецПроцедуры

Процедура ЭкспортироватьПродуктыКлиентов(ТаблицаДанных, ПараметрыПодключения)
								
	ТекстСообщения = "Ошибка экспорта продукта клиента [%1].";
	
	Для Каждого ЭтаСтрока Из ТаблицаДанных Цикл 
		
		Если ЗначениеЗаполнено(ЭтаСтрока.КодПродукта1Ф) Тогда
			Продолжить; 
		КонецЕсли;
			
		//1. Пробуем найти продукт по GUID заявки
		КодПродукта = ПолучитьКодПродукта(ЭтаСтрока.ЗаявкаСсылка, ПараметрыПодключения);
		
		Если КодПродукта <> 0 Тогда 
			//нужно записать код в регистр коды во внешних системах.
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ЭтаСтрока.КодКлиента1Ф) Тогда
			ЗарегистрироватьОшибку("Ошибка экспорта продукта по заявке [" + ЭтаСтрока.ЗаявкаСсылка + "]. Отсутствует код клиента.");
			Продолжить;	
		КонецЕсли;
		
		КодАктива1Ф = ?(ЗначениеЗаполнено(ЭтаСтрока.КодАктива1Ф), ЭтаСтрока.КодАктива1Ф, ПолучитьКодАктива(ЭтаСтрока.Актив, ПараметрыПодключения));
		
		Если Не ЗначениеЗаполнено(КодАктива1Ф) Тогда
			ЗарегистрироватьОшибку(СтрШаблон(ТекстСообщения, ЭтаСтрока.КодКлиента1Ф) + " Не удалось получить код актива [" + ЭтаСтрока.Актив + "].");
			Продолжить;
		КонецЕсли;
		
		МассивПараметров = Новый Массив;

		МассивПараметров.Добавить(Новый Структура("id, value", 98, ЭтаСтрока.КодКлиента1Ф));
		МассивПараметров.Добавить(Новый Структура("id, value", 197, "Заявка")); //для ИИС должно быть значение "Договор"
		МассивПараметров.Добавить(Новый Структура("id, value", 206, КодАктива1Ф));
		МассивПараметров.Добавить(Новый Структура("id, value", 218, Формат(ЭтаСтрока.ОсновнаяЗаявка, "БЛ=false; БИ=true"))); //признак булево 1,0
		МассивПараметров.Добавить(Новый Структура("id, value", 193, ЭтаСтрока.НомерЗаявки));
		МассивПараметров.Добавить(Новый Структура("id, value", 196, Формат(ЭтаСтрока.ДатаЗаявки, "ДФ=гггг-ММ-дд"))); // или дата заключения договора (для ИИС)
		МассивПараметров.Добавить(Новый Структура("id, value", 201, Строка(ЭтаСтрока.ЗаявкаСсылка.УникальныйИдентификатор()))); //GUID заявки

		//Если ЗначениеЗаполнено(ТекПродукт.ДатаПогашения) Тогда
		//	МассивПараметров.Добавить(Новый Структура("id, value", 195, Формат(ТекПродукт.ДатаПогашения, "ДФ=гггг-ММ-дд"))); //дата закрытия, дата договора ИИС
		//КонецЕсли;
		
		ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("subcatId, extParams", 41, МассивПараметров));

		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks/create", ТелоЗапроса, ТекстСообщения);
		
		Если HTTPОтвет = Неопределено Тогда
			ЗарегистрироватьОшибку(ТекстСообщения); 
			Продолжить;
		КонецЕсли; 
		
		КодПродукта = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"), "data"); 
		
		Если ЗначениеЗаполнено(КодПродукта) Тогда
		
			ЭтаСтрока.КодПродукта1Ф = КодПродукта; 
			
			РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(
			ЭтаСтрока.ЗаявкаСсылка, 
			Справочники.ВнешниеСистемы.ПерваяФормаКоллЦентра,
			Справочники.ГруппыИмпортируемыхОбъектов.ЗаявкиПайщиков,
			КодПродукта);
			
		КонецЕсли;
					
	КонецЦикла;
										
КонецПроцедуры

Функция ПолучитьКодАктива(АктивСсылка, ПараметрыПодключения)
	
	//1. Если в регистре "Коды во внешних системах" не нашли код актива, пробуем найти (задачу) в первой форме по GUID.
	ТекстСообщения = "Не удалось получить код первой формы для актива [" + АктивСсылка + "] по уникальному идентификатору.";
	
	GUID = Строка(АктивСсылка.УникальныйИдентификатор()); 
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("startRow", 0);
	СтруктураЗапроса.Вставить("endRow", 10);
	СтруктураЗапроса.Вставить("select", РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("field, type", "taskId", "numberValue")));
	СтруктураЗапроса.Вставить("filterModel", Новый Структура("ExtParam201", Новый Структура("filterType, type, filter", "text", "equals", GUID)));
	
	ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
		
	ТекстСообщения = "Не удалось получить данные актива из первой формы.";
		
	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api-core/datasource/subcat/47/data", ТелоЗапроса, ТекстСообщения); 
			
	Если HTTPОтвет = Неопределено Тогда 
		ЗарегистрироватьОшибку(ТекстСообщения);
		Возврат Неопределено;		
	КонецЕсли;
	
	КодПервойФормы = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"), "totalCount"); 
	
	Если КодПервойФормы <> 0 Тогда
		Возврат КодПервойФормы;	
	КонецЕсли;
				
	//2. Если ничего не нашли по GUID, создаем объект в первой форме.				
	МассивПараметров = Новый Массив;
	
	Если ТипЗнч(АктивСсылка) = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды") Тогда 
					
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеквизитыПИФ.КраткоеНаименованиеФонда КАК Наименование
			|ИЗ
			|	РегистрСведений.РеквизитыПИФ.СрезПоследних(, ПаевойИнвестиционныйФонд = &АктивСсылка) КАК РеквизитыПИФ";
		Запрос.УстановитьПараметр("АктивСсылка", АктивСсылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			МассивПараметров.Добавить(Новый Структура("id, value", 122, Выборка.Наименование));
		Иначе
			ЗарегистрироватьОшибку("Не удалось создать актив в первой форме колл центра. У актива [" + АктивСсылка + "] отсутствует наименование.");
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(АктивСсылка) = Тип("СправочникСсылка.СтратегииИндивидуальногоИнвестирования") Тогда
		
		МассивПараметров.Добавить(Новый Структура("id, value", 122, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(АктивСсылка, "Наименование")));
			
	Иначе
		ЗарегистрироватьОшибку("Не удалось создать актив в первой форме колл центра. Для актива [" + АктивСсылка + "] не настроены правила импорта в первую форму.");
		Возврат Неопределено;			
	КонецЕсли;
	
	МассивПараметров.Добавить(Новый Структура("id, value", 201, GUID));
	МассивПараметров.Добавить(Новый Структура("id, value", 189, 0)); // при первом создании не заполняем стоимость
	
	ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("subcatId, extParams", 47, МассивПараметров));

	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks/create", ТелоЗапроса, ТекстСообщения);
	
	Если HTTPОтвет = Неопределено Тогда
		ЗарегистрироватьОшибку(ТекстСообщения);   
		Возврат Неопределено;
	КонецЕсли;
	 
	КодПервойФормы = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"), "data"); 
	
	Если Не ЗначениеЗаполнено(КодПервойФормы) Тогда
		Возврат Неопределено;
	КонецЕсли;
			
	Если ТипЗнч(АктивСсылка) = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды") Тогда
		ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды;
	ИначеЕсли ТипЗнч(АктивСсылка) = Тип("СправочникСсылка.СтратегииИндивидуальногоИнвестирования") Тогда
		ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.СтратегииИндивидуальногоИнвестирования;
	Иначе
		ЗарегистрироватьОшибку("Не удалось определить группу объектогв для актива [" + АктивСсылка + "] при записи данных в регистр [Коды во внешних системах");
		Возврат Неопределено;			
	КонецЕсли;

	//3. Фиксируем в регистре "Коды во внешних системах" код (задачи) из первой формы.
	РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(
		АктивСсылка, 
		Справочники.ВнешниеСистемы.ПерваяФормаКоллЦентра,
		ГруппаОбъектов,
		КодПервойФормы);

	Возврат КодПервойФормы; 
			
КонецФункции

Процедура ОбновитьСтоимостиАктивов(ТекПараметры) Экспорт 
			
	Если ТекПараметры.Свойство("ТаблицаПоказателей") Тогда 
				
		ТаблицаПоказателей = ТекПараметры.ТаблицаПоказателей;
		
	Иначе

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(ФинансовыеПоказатели.Период, &ПараметрДата) КАК Дата,
			|	КлиентыОПИФ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	КлиентыОПИФ.Клиент КАК ПИФ,
			|	КодыПервойФормыКоллЦентра.Код КАК КодПервойФормыКоллЦентра,
			|	ЕСТЬNULL(ФинансовыеПоказатели.Значение, 0) КАК СтоимостьПая,
			|	ЛОЖЬ КАК ПройденаПроверкаПриостановкиРасчетСЧА
			|ИЗ
			|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
			|			&ПараметрДата,
			|			Организация = &Организация
			|				И (СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения > &ПараметрДата)
			|				И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)) КАК КлиентыОПИФ
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
			|				&ПараметрДата,
			|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФормаКоллЦентра)
			|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды)) КАК КодыПервойФормыКоллЦентра
			|		ПО КлиентыОПИФ.Клиент = КодыПервойФормыКоллЦентра.Объект
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
			|		ПО КлиентыОПИФ.СчетДоверительногоУправления = ФинансовыеПоказатели.СубъектАналитики
			|			И (ФинансовыеПоказатели.Организация = &Организация)
			|			И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьПая))
			|			И (ФинансовыеПоказатели.Период = &ПараметрДата)
			|ГДЕ
			|	ВЫРАЗИТЬ(КлиентыОПИФ.Клиент КАК Справочник.ПаевыеИнвестиционныеФонды).Тип = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Открытый)
			|	И НЕ КодыПервойФормыКоллЦентра.Код ЕСТЬ NULL";

		Запрос.УстановитьПараметр("ПараметрДата", ТекПараметры.Дата);
		Запрос.УстановитьПараметр("Организация", ТекПараметры.Организация);
		
		ТаблицаПоказателей = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	Если ТаблицаПоказателей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивДанных = Новый Массив;
	
	Для Каждого ЭтаСтрока Из ТаблицаПоказателей Цикл 
		
		Если ЭтаСтрока.Дата < Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса(), -2) Тогда
			ЗарегистрироватьОшибку("Ошибка выгрузки стоимости паев в первую форму колл центра. Дата значения стоимости [" + Формат(ЭтаСтрока.Дата, "ДФ=dd.MM.yyyy") + "] не должна быть позже даты проведения регламентных операций");
			Прервать;
		Конецесли;
				
		ПриостановленРасчетСЧА = ?(ЭтаСтрока.ПройденаПроверкаПриостановкиРасчетСЧА, 
									Ложь, 
									БухгалтерскийУчет.ОпределитьНастройкуУчета(ЭтаСтрока.Дата, ТекПараметры.Организация, ЭтаСтрока.СчетДоверительногоУправления, "ПриостановленРасчетСЧА"));						
		
		Если Не (ЗначениеЗаполнено(ЭтаСтрока.СтоимостьПая) И ПриостановленРасчетСЧА) Тогда //значит ещё нет цены на дату 
			Продолжить;
		КонецЕсли;
						
		СтрокаОбновления = "#n220#v" + Формат(ПриостановленРасчетСЧА, "БЛ=false; БИ=true");
		СтрокаОбновления = СтрокаОбновления + "::#n189#v" + Формат(ЭтаСтрока.СтоимостьПая, "ЧН=0; ЧГ=0");
		
		МассивДанных.Добавить(Новый Структура("taskId, extParamStr", ЭтаСтрока.КодПервойФормыКоллЦентра, СтрокаОбновления));
						
	КонецЦикла;
		
	Если МассивДанных.Количество() > 0 Тогда
	
		ТекстСообщения = "Не удалось обновить стоимости паев.";

		ЗапросОбновления = ПолучитьСтрокуJSON(МассивДанных);
				
		Если ЗначениеЗаполнено(ЗапросОбновления) Тогда
			
			ПараметрыПодключения = РаботаСВнешнимиСистемами.ПерваяФорма_ПолучитьПараметрыПодключения("uk1f"); 
		
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/extparams/update", ЗапросОбновления, ТекстСообщения);

			Если HTTPОтвет = Неопределено Тогда
				ЗарегистрироватьОшибку(ТекстСообщения);
			КонецЕсли; 
						
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ТекПараметры.Свойство("ТаблицаПоказателей") Тогда 
		ОповеститьОбОшибках();	
	КонецЕсли;
			
КонецПроцедуры

Процедура ПроверитьПриостановкуРасчетаСЧА(Организация) Экспорт
	
	Если Не АктивированМеханизмЭкспортаДанных(Организация) Тогда
		Возврат;	
	КонецЕсли;
	
	ДатаПроверки = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса(), -2);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыОПИФ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыОПИФ.Клиент КАК ПИФ,
		|	КодыПервойФормыКоллЦентра.Код КАК КодПервойФормыКоллЦентра
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&ДатаПроверки,
		|			Организация = &Организация
		|				И (СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения > &ДатаПроверки)
		|				И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)) КАК КлиентыОПИФ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&ДатаПроверки,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФормаКоллЦентра)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды)) КАК КодыПервойФормыКоллЦентра
		|		ПО КлиентыОПИФ.Клиент = КодыПервойФормыКоллЦентра.Объект
		|			И ВЫРАЗИТЬ(КлиентыОПИФ.Клиент КАК Справочник.ПаевыеИнвестиционныеФонды).Тип = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Открытый)";

	Запрос.УстановитьПараметр("ДатаПроверки", ДатаПроверки);
	Запрос.УстановитьПараметр("Организация", Организация);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	МассивДанных = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
						
		ПриостановленРасчетСЧА = БухгалтерскийУчет.ОпределитьНастройкуУчета(ДатаПроверки, Организация, Выборка.СчетДоверительногоУправления, "ПриостановленРасчетСЧА");						
						
		СтрокаОбновления = "#n220#v" + Формат(ПриостановленРасчетСЧА, "БЛ=false; БИ=true");
				
		МассивДанных.Добавить(Новый Структура("taskId, extParamStr", Выборка.КодПервойФормыКоллЦентра, СтрокаОбновления));
						
	КонецЦикла;
		
	Если МассивДанных.Количество() > 0 Тогда
	
		ТекстСообщения = "Не удалось обновить параметр [Приостановлен расчет СЧА].";

		ЗапросОбновления = ПолучитьСтрокуJSON(МассивДанных);
				
		Если ЗначениеЗаполнено(ЗапросОбновления) Тогда
			
			ПараметрыПодключения = РаботаСВнешнимиСистемами.ПерваяФорма_ПолучитьПараметрыПодключения("uk1f"); 
		
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/extparams/update", ЗапросОбновления, ТекстСообщения);

			Если HTTPОтвет = Неопределено Тогда
				ЗарегистрироватьОшибку(ТекстСообщения);
			КонецЕсли; 
						
		КонецЕсли;
		
	КонецЕсли;
	
	ОповеститьОбОшибках();
	
КонецПроцедуры

Функция ПолучитьКодПродукта(ЗаявкаСсылка, ПараметрыПодключения, Продукты = Неопределено)
			
	Если Продукты <> Неопределено Тогда
			
		МассивСтрок = Продукты.НайтиСтроки(Новый Структура("ЗаявкаСсылка", ЗаявкаСсылка));
			
		Если МассивСтрок.Количество() = 1 Тогда
			
			Если ЗначениеЗаполнено(МассивСтрок[0].КодПродукта1Ф) Тогда
				Возврат МассивСтрок[0].КодПродукта1Ф;	
			КонецЕсли;
			
		Иначе
			Возврат Неопределено;		
		КонецЕсли; 
		
	КонецЕсли;
	
	ТекстСообщения = "Не удалось получить продукт по идентификатору заявки [" + ЗаявкаСсылка + "].";
	
	//Ищем продукт по GUID(заявки, договора)		
	СтруктураЗапроса = Новый Структура();
	СтруктураЗапроса.Вставить("startRow", 0);
	СтруктураЗапроса.Вставить("endRow", 100); 
	СтруктураЗапроса.Вставить("select", РаботаСКоллекциями.ЗначенияВМассив(Новый Структура("field, type", "taskId", "numberValue")));
	СтруктураЗапроса.Вставить(РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("field, type, extParamType", "taskId", "numberValue")));
	СтруктураЗапроса.Вставить("filterModel", Новый Структура("ExtParam201"));
	СтруктураЗапроса.filterModel.ExtParam201 = Новый Структура("filterType, type, filter", "text", "equals", Строка(ЗаявкаСсылка.УникальныйИдентификатор())); 

	ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
	
	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api-core/datasource/Subcat/41/data", ТелоЗапроса, ТекстСообщения);
	
	Если HTTPОтвет = Неопределено Тогда
		ЗарегистрироватьОшибку(ТекстСообщения);   
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"), "totalCount");
	
КонецФункции

