Функция ПолучитьСтоимостьПая(КодПервойФормы, ПараметрыПодключения = Неопределено) Экспорт
	
	ПараметрыПодключения = ?(ЗначениеЗаполнено(ПараметрыПодключения), ПараметрыПодключения, РаботаСВнешнимиСистемами.ПерваяФорма_ПолучитьПараметрыПодключения("uk1f")); 
	
	Если ПараметрыПодключения = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось установить соединение с первой формой.");
		Возврат -1;
	КонецЕсли;
	
	ТекстСообщения = "Не удалось получить данные стоимости пая из первой формы колл центра. Задача [" + КодПервойФормы + "]";
		
	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	ЗаписатьJSON(ЗаписьJSON, Новый Структура("taskId, selectedInfoParts", КодПервойФормы, РаботаСКоллекциями.ЗначениеВМассив("ExtParams")));
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	
	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks", ТелоЗапроса, ТекстСообщения);
	
	Если HTTPОтвет = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат -1;
	КонецЕсли;
		
	ЧтениеJSON = Новый ЧтениеJSON();
    ЧтениеJSON.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
    ЗадачаОбъект = ПрочитатьJSON(ЧтениеJSON);

	Если ТипЗнч(ЗадачаОбъект) = Тип("Структура") И ЗадачаОбъект.Свойство("ExtParams") Тогда 
		
		Для Каждого ЭтотПараметр Из ЗадачаОбъект.ExtParams Цикл
			
			Если ЭтотПараметр.id = 189 Тогда
				Возврат ЭтотПараметр.value;  
			КонецЕсли;
			
		КонецЦикла;
								
	КонецЕсли;
	
	Возврат -1;
		
КонецФункции