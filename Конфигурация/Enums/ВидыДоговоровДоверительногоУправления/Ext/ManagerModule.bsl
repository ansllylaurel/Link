
Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Если ПараметрыСеанса.КонтрольДоступаКСчетамДоверительногоУправления
		И НЕ РаботаСПользователями.ЭтоПолноправныйПользователь() Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТекущийПользователь",	ПараметрыСеанса.ТекущийПользователь);
		Запрос.УстановитьПараметр("ТекущаяОрганизация",		ПараметрыСеанса.ТекущаяОрганизация);
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ГруппыПользователейДоступныеВидыДоговоровИСчетаДоверительногоУправления.Объект КАК Значение,
			|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ГруппыПользователейДоступныеВидыДоговоровИСчетаДоверительногоУправления.Объект) КАК Представление
			|ИЗ
			|	Справочник.ГруппыПользователей.ДоступныеВидыДоговоровИСчетаДоверительногоУправления КАК ГруппыПользователейДоступныеВидыДоговоровИСчетаДоверительногоУправления
			|ГДЕ
			|	ТИПЗНАЧЕНИЯ(ГруппыПользователейДоступныеВидыДоговоровИСчетаДоверительногоУправления.Объект) = ТИП(Перечисление.ВидыДоговоровДоверительногоУправления)
			|	И ГруппыПользователейДоступныеВидыДоговоровИСчетаДоверительногоУправления.Ссылка В
			|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|				ГруппыПользователейСостав.Ссылка КАК Ссылка
			|			ИЗ
			|				Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
			|			ГДЕ
			|				ГруппыПользователейСостав.Пользователь = &ТекущийПользователь
			|				И ГруппыПользователейСостав.Ссылка.Организация = &ТекущаяОрганизация)";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		ДанныеВыбора = Новый СписокЗначений;
		
		Пока Выборка.Следующий() Цикл
			ДанныеВыбора.Добавить(Выборка.Значение, Выборка.Представление);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры
