&НаКлиенте
Процедура скИзменитьСтруктуруОтчетаКлиент(ИзменитьСтруктуруОтчетаНаСервере = Истина)
	
	Если Отчет.УчетныйРегистр <> "ЕдиныйБухгалтерскийУчет" Тогда 
		Отчет.скПоЛицевомуСчету = Ложь;
	КонецЕсли;
	
	Элементы.скПоЛицевомуСчету.Видимость = Отчет.УчетныйРегистр = "ЕдиныйБухгалтерскийУчет";
	
	Если ИзменитьСтруктуруОтчетаНаСервере Тогда 
		скИзменитьСтруктуруОтчета();
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура скИзменитьСтруктуруОтчета(ВызовПриСозданииНаСервере = Ложь)
	
	Если ВызовПриСозданииНаСервере И Параметры.Свойство("УчетныйРегистр") Тогда 
		Отчет.УчетныйРегистр = Параметры.УчетныйРегистр;	
	КонецЕсли;
	
	СхемаКомпоновкиДанныхОбъект = РеквизитФормыВЗначение("Отчет").СхемаКомпоновкиДанных;
	
	Если СхемаКомпоновкиДанныхОбъект.НаборыДанных.Найти("Проводки") <> Неопределено Тогда 
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос = СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, "БухгалтерскийУчет", Отчет.УчетныйРегистр);
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос = 
		СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, "Проводки.ЛицевойСчет КАК ЛицевойСчет, Проводки.ЛицевойСчетДт КАК ЛицевойСчетДт, Проводки.ЛицевойСчетКт КАК ЛицевойСчетКт,", "");
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос = 
		СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, "ЕдиныйБухгалтерскийУчетОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет, ДвиженияССубконто.ЛицевойСчетДт КАК ЛицевойСчетДт, ДвиженияССубконто.ЛицевойСчетКт КАК ЛицевойСчетКт,", "");

		СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос = 
		СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, "ЛицевойСчет.*, ЛицевойСчетДт.*, ЛицевойСчетКт.*,", 	"");	
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос = 
		СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, " (ЛицевойСчет).* КАК ЛицевойСчет,", 	"");
		
		Если Отчет.УчетныйРегистр = "ЕдиныйБухгалтерскийУчет" Тогда		 		
			
			СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос = 
			СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, "	Проводки.СчетДт КАК СчетДт,", "Проводки.ЛицевойСчет КАК ЛицевойСчет, Проводки.СчетДт КАК СчетДт, Проводки.ЛицевойСчетДт КАК ЛицевойСчетДт, Проводки.ЛицевойСчетКт КАК ЛицевойСчетКт,");
			
			СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос = 
			СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, "	ДвиженияССубконто.СчетДт КАК СчетДт,", 	"ЕдиныйБухгалтерскийУчетОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет, ДвиженияССубконто.СчетДт КАК СчетДт, ДвиженияССубконто.ЛицевойСчетДт КАК ЛицевойСчетДт, ДвиженияССубконто.ЛицевойСчетКт КАК ЛицевойСчетКт,");
			
			СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос = 
			СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, "СчетДт.*," ,	"СчетДт.*, ЛицевойСчет.*, ЛицевойСчетДт.*, ЛицевойСчетКт.*, ");
			
			СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос = 
			СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, "(СчетДоверительногоУправления).* КАК СчетДоверительногоУправления,", "(СчетДоверительногоУправления).* КАК СчетДоверительногоУправления, (ЛицевойСчет).* КАК ЛицевойСчет,");
			
			//ПолеНабораДанных = СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			//      
			//ПолеНабораДанных.Поле = "ЛицевойСчетДт";
			//ПолеНабораДанных.ПутьКДанным = "ЛицевойСчетДт";
			//ПолеНабораДанных.Заголовок = "Лицевой счет дебет";
			//
			//
			//ПолеНабораДанных = СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			//      
			//ПолеНабораДанных.Поле = "ЛицевойСчетКт";
			//ПолеНабораДанных.ПутьКДанным = "ЛицевойСчетКт";
			//ПолеНабораДанных.Заголовок = "Лицевой счет кредит";
			
			//СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос = 
			//СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, "	ОстаткиИОбороты.Счет КАК Счет,", 	"ОстаткиИОбороты.Счет КАК Счет, ВЫРАЗИТЬ (ОстаткиИОбороты.ЛицевойСчет КАК Справочник.ЛицевыеСчета) КАК ЛицевойСчет,");		
			//
			//СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос = 
			//СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, "(СчетДоверительногоУправления).* КАК СчетДоверительногоУправления,", 	"(СчетДоверительногоУправления).* КАК СчетДоверительногоУправления, (ЛицевойСчет).* КАК ЛицевойСчет,");		
			
		КонецЕсли;
		
		СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанныхОбъект, УникальныйИдентификатор);
		
		Отчет.КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
		
	КонецЕсли;
	
	// Удаление нового измерения из отборов и группировок
	Если Отчет.УчетныйРегистр <> "ЕдиныйБухгалтерскийУчет" Тогда
		
		Если ТипЗнч(Отчет.Счет) <> Тип("ПланСчетовСсылка.Основной") Тогда 
			Отчет.Счет = ПредопределенноеЗначение("ПланСчетов.Основной.ПустаяСсылка");
		КонецЕсли;
		
		// Отборы
		УдалитьЗначенияОтборов_Рекурс(Отчет.КомпоновщикНастроек.Настройки.Отбор);
		
	Иначе
		Если ТипЗнч(Отчет.Счет) <> Тип("ПланСчетовСсылка.Единый") Тогда
			Отчет.Счет = ПредопределенноеЗначение("ПланСчетов.Единый.ПустаяСсылка");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

Процедура УдалитьЗначенияОтборов_Рекурс(ГруппаЭлементовОтбора)
	
	МассивЭлементовКУдалению = Новый Массив;
		
	Для Каждого ЭлементОтбора Из ГруппаЭлементовОтбора.Элементы Цикл 
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда 
			УдалитьЗначенияОтборов_Рекурс(ЭлементОтбора);
		Иначе 
			Если СтрЧислоВхождений(Строка(ЭлементОтбора.ЛевоеЗначение) ,"ЛицевойСчет") > 0 Тогда 	
				МассивЭлементовКУдалению.Добавить(ЭлементОтбора);	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого УдаляемыйЭлемент Из МассивЭлементовКУдалению Цикл 
		ГруппаЭлементовОтбора.Элементы.Удалить(УдаляемыйЭлемент);
	КонецЦикла;
	
	Если ГруппаЭлементовОтбора.Элементы.Количество() = 0  
		И ТипЗнч(ГруппаЭлементовОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных")  
		И ГруппаЭлементовОтбора.Родитель <> Неопределено Тогда 
		ГруппаЭлементовОтбора.Родитель.Элементы.Удалить(ГруппаЭлементовОтбора);
	КонецЕсли;	
	
КонецПроцедуры	
	
&НаКлиенте 
Процедура АвтоматическоеФормирование() Экспорт

	ЗаполнитьЗначенияСвойств(Отчет, ЭтаФорма.НастройкиОтчета);
	
	Отчет.НачалоПериода = ЭтаФорма.НастройкиОтчета.Период.ДатаНачала; 
	Отчет.КонецПериода = ЭтаФорма.НастройкиОтчета.Период.ДатаОкончания; 
	
	АвтоматическоеФормированиеНаСервере();
	
	РаботаСОтчетамиКлиент.АвтоматическоеФормированиеОтчета(ЭтаФорма, ЭтаФорма.Результат);
	
	Если РаботаСОтчетамиКлиент.ТребуетсяОткрытьФорму(ЭтаФорма.НастройкиОтчета) Тогда	
		УправлениеФормой(ЭтаФорма);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура АвтоматическоеФормированиеНаСервере()

	АдресХранилища = ПоместитьВоВременноеХранилище("", УникальныйИдентификатор);
	ДополнительныеСвойства = Отчет.КомпоновщикНастроек.Настройки.ДополнительныеСвойства;
	Отчет.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ВыводитьЗаголовок", ВыводитьЗаголовок);
	Отчет.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ВыводитьПодвал"   , ВыводитьПодвал);

	ПараметрыОтчета = ПодготовитьПараметрыОтчета();
	РаботаСБухгалтерскимиОтчетами.СформироватьОтчет(ПараметрыОтчета, АдресХранилища);
	ЗагрузитьПодготовленныеДанные();

КонецПроцедуры
