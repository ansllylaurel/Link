		Результат.Добавить("ВыверкаИзмененийУбыткаОтОбесцененияДепозитовИПрочихСредств2025",		"Примечание 10.2"); 
		Результат.Добавить("ВыверкаИзмененийРезерваПодОбесценениеПрочихРазмещенныхСредствИДЗ_СК", 	"Примечание 11.2");   
		#КонецОбласти
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


Функция ПолучитьСтруктуруПараметров(ИмяФормы) Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("мВыбраннаяФорма");
	Результат.Вставить("мРедакцияФормы");
	Результат.Вставить("мСкопированаФорма");
	Результат.Вставить("мСохраненныйДок");
	Результат.Вставить("мДатаНачалаПериодаОтчета");
	Результат.Вставить("мДатаКонцаПериодаОтчета");
	Результат.Вставить("мЗаписываетсяНовыйДокумент");
	Результат.Вставить("мБезОткрытияФормы");
	Результат.Вставить("мРежимПечати");
	Результат.Вставить("мПредставлениеТекущегоПериода");
	Результат.Вставить("мПредставлениеПредыдущегоПериода");
	Результат.Вставить("мДатаНачалаПрошлогоПериодаОтчета");
	Результат.Вставить("мДатаКонцаПрошлогоПериодаОтчета");
	Результат.Вставить("мДелитель");
	Результат.Вставить("Организация");
	Результат.Вставить("СчетДоверительногоУправления");
	Результат.Вставить("НКО");
	Результат.Вставить("ВалютаДокумента");
	Результат.Вставить("ЕдиницаИзмерения");
	Результат.Вставить("ТочностьЕдиницыИзмерения");
	Результат.Вставить("ОтчетНаКонецПрошлогоГода");
	Результат.Вставить("ЗаголовкиОтчетов");
	Результат.Вставить("СтрПериодОтчета");
	Результат.Вставить("НаимСчетаДоверительногоУправления");
	Результат.Вставить("НаимТекущегоРаздела");
	Результат.Вставить("ТекущаяСтрокаРазделовОтчета");
	Результат.Вставить("НестандартныйПериод");
	
	ВыбраннаяФорма = СтрЗаменить(ИмяФормы, "Отчет.РегламентированныйОтчетБаланс.Форма.", "");
	
	Если ВыбраннаяФорма = "ФормаОтчета_МСФО39_СК_2024"
		ИЛИ ВыбраннаяФорма = "ФормаОтчета_МСФО39_СК_2020"
		ИЛИ ВыбраннаяФорма = "ФормаОтчета_МСФО39_СК" 
		ИЛИ ВыбраннаяФорма = "ФормаОтчета_МСФО39" Тогда
		Результат.Вставить("ВидДеятельностиОрганизации");
	ИначеЕсли ВыбраннаяФорма = "ФормаОтчета_МСФО9_2025" Тогда 
		Результат.Вставить("ПереходНаМСФО9");
		Результат.Вставить("ОтчетЗаАналогичныйПериодПрошлогоГода");
	ИначеЕсли ВыбраннаяФорма = "ФормаОтчета_МСФО9_СК_2025" Тогда
		Результат.Вставить("ВидДеятельностиОрганизации"); 
		Результат.Вставить("ПереходНаМСФО9"); 
		Результат.Вставить("ОтчетЗаАналогичныйПериодПрошлогоГода");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции