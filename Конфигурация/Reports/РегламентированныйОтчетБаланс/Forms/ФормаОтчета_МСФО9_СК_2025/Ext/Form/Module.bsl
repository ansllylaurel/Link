		|				ПО АктуальныеДатыНачалаДействия.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|					И АктуальныеДатыНачалаДействия.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК УсловияКредитныхИнструментовСрезПоследних
		|		ПО ЕдиныйБухгалтерскийУчетОстатки.Субконто2 = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|ГДЕ
		|	УсловияКредитныхИнструментовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДепозитныеВкладыПоАС)";
		
	// Только кредитные организации и банки-нерезиденты  
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТолькоКредитныеОрганизации", "СделкаРЕПО.СделкаСЦентральнымКонтрагентом = ИСТИНА");
	
	Результат = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаРезультат из Результат Цикл 	
		Если СтрокаРезультат.Период = "ТекущийПериод" Тогда 
			КолонкаСтавка = "02";
			КолонкаИнтервал = "03";
		ИначеЕсли СтрокаРезультат.Период = "ПрошлыйПериод" Тогда	
			КолонкаСтавка = "04";
			КолонкаИнтервал = "05";
		КонецЕсли;	
		Если ЗначениеЗаполнено(СтрокаРезультат.СтавкаМин) Тогда
			УстановитьЗначениеПоказателя(ТекРаздел, "П" + СтрокаРезультат.НомерСтроки + КолонкаСтавка, Строка(СтрокаРезультат.СтавкаМин) + "% - " + Строка(СтрокаРезультат.СтавкаМакс) + "%");
			УстановитьЗначениеПоказателя(ТекРаздел, "П" + СтрокаРезультат.НомерСтроки + КолонкаИнтервал, Строка(СтрокаРезультат.ИнтервалМин) + " д. - " + Строка(СтрокаРезультат.ИнтервалМакс) + " д.");
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(СтруктураРеквизитовФормы.ОтчетНаКонецПрошлогоГода) Тогда 
		Если СтруктураРеквизитовФормы.ОтчетНаКонецПрошлогоГода.ПереходНаМСФО9 Тогда  
			ПеренестиДанныеПрошлогоГода(ТекРаздел, ИмяРаздела);
		КонецЕсли; 
	КонецЕсли;
	
КонецПроцедуры

