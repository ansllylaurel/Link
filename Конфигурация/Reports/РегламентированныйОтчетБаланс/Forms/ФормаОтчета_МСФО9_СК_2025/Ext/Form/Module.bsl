	ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П0702", "ДолевыеПоССЧерезПрочийСовокупныйДоход", "П0502");
	ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П0703", "ДолевыеПоССЧерезПрочийСовокупныйДоход", "П0503");
	
