&НаСервере
Функция ЗаполнитьРезервПоДепозитамСервер(ТекРаздел, ВидСальдо, ИмяРаздела, ИмяЯчейки, НомерКолонкиОтчетногоПериода, НомерКолонкиПредыдущегоПериода, СписокДепозитов = Неопределено, ВидРезерва, ИмяПоказателя, Знак = 1, ЭтоПримечание5_2 = Ложь) 
	
	// 5.1 Депозиты краткосрочные - 
	// Если НеУчитыватьПроцентыПоДепозитамВДС = Да  - резерв тело только кр/срч.
	// иначе - резерв тело кр/срч + резерв проценты кр/срч
	// 6.2 депозиты долгосрочные по СС. Резерва нет
	// 10.1 Депозиты долгосрочные по АС
	// Если НеУчитыватьПроцентыПоДепозитамВДС = Да  - резерв по процентам (и по долгосрочным и по краткосрочным) 
	// Иначе  резерв по процентам длг/срч. 
	// + Резерв тело длг/срч 
	
	// ВидРезерва = РезервДепозит, РезервПроцент
	
	Запрос = КонсолидированнаяОтчетность.ПолучитьЗапросРезервПоДепозитамСервер(СтруктураРеквизитовФормы, ЭтаФорма.НастройкиОтчета, СписокДепозитов, ВидСальдо, ЭтоПримечание5_2); 
	
	НачалоЦикла = ?(НомерКолонкиОтчетногоПериода = "", 2, 1);
	КоличествоЦиклов = ?(НомерКолонкиПредыдущегоПериода = "", 1, 2);
	
	Для НомерЦикла = 1 по КоличествоЦиклов Цикл
		Если НомерЦикла = 1 Тогда   
			Запрос.УстановитьПараметр("НачалоПериода", СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета); 
			Если ЗначениеЗаполнено(СтруктураРеквизитовФормы.ОтчетНаКонецПрошлогоГода) Тогда 
				Если СтруктураРеквизитовФормы.ОтчетНаКонецПрошлогоГода.ПереходНаМСФО9 Тогда  
					Запрос.УстановитьПараметр("НачалоПериода", СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета + 2);
				КонецЕсли; 
			КонецЕсли;
			Если СтруктураРеквизитовФормы.ПереходНаМСФО9 Тогда
				Запрос.УстановитьПараметр("грКонецПериода" , Новый Граница(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета + 2, ВидГраницы.Включая));
			Иначе	
				Запрос.УстановитьПараметр("грКонецПериода" , Новый Граница(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета, ВидГраницы.Включая));
			КонецЕсли;
			НомерКолонки = НомерКолонкиОтчетногоПериода; 
			текПредставлениеПериода = СтруктураРеквизитовФормы.мПредставлениеТекущегоПериода;
			лДата1 = СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета;   
			лДата2 = СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета;
		Иначе 			
			Запрос.УстановитьПараметр("НачалоПериода", СтруктураРеквизитовФормы.мДатаНачалаПрошлогоПериодаОтчета);
			Запрос.УстановитьПараметр("грКонецПериода", Новый Граница(СтруктураРеквизитовФормы.мДатаКонцаПрошлогоПериодаОтчета, ВидГраницы.Включая));
			НомерКолонки = НомерКолонкиПредыдущегоПериода;
			ТекПредставлениеПериода = СтруктураРеквизитовФормы.мПредставлениеПредыдущегоПериода;
			лДата1 = СтруктураРеквизитовФормы.мДатаНачалаПрошлогоПериодаОтчета;   
			лДата2 = СтруктураРеквизитовФормы.мДатаКонцаПрошлогоПериодаОтчета;

		КонецЕсли;
		
		Результат = Запрос.Выполнить().Выгрузить(); 
		
		Для каждого СтрокаРезультат Из Результат Цикл
			СуммаРезерва = ?(ЗначениеЗаполнено(СтрокаРезультат[ВидРезерва]), СтрокаРезультат[ВидРезерва] * Знак, 0);
			УстановитьЗначениеПоказателя(ТекРаздел, ИмяЯчейки + НомерКолонки, СуммаРезерва);
			СлагаемоеНаименование = ИмяПоказателя + " за " + ПредставлениеПериода(лДата1, лДата2, "ФП = Истина"); 
			
			ДобавитьСтрокуВРасшифровку(Адрес_ТаблицаРасшифровки, 
				СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета, 
				СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета, 
				СтруктураРеквизитовФормы.СчетДоверительногоУправления, 
				ИмяЯчейки + НомерКолонки,
				"Строка """ + ИмяПоказателя + """, графа """ + текПредставлениеПериода + """", 
				1, 
				СлагаемоеНаименование, 
				СуммаРезерва, 
				"20615", , , , 
				ИмяРаздела);
			
		КонецЦикла;
	КонецЦикла;

КонецФункции

