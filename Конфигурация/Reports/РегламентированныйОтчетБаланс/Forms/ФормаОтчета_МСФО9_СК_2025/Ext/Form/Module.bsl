	Запрос.УстановитьПараметр("ДепозитыКраткосрочные"		, КонсолидированнаяОтчетность.ПолучитьДепозитныеВклады(ЭтаФорма.НастройкиОтчета, ЭтаФорма.СтруктураРеквизитовФормы, ,"Краткосрочные")); 
	Запрос.УстановитьПараметр("СтадияОбесценения"			, СтадияОбесценения); 
	Запрос.УстановитьПараметр("ПереходНаМСФО9"				, СтруктураРеквизитовФормы.ПереходНаМСФО9);
	Запрос.УстановитьПараметр("ВалютаУчета"					, СтруктураРеквизитовФормы.Организация.ВалютаУчета);
	// на конец 2024 года ПереходНаМСФО9 = Истина, возьмем первый документ 2025
	// во всех остальных случаях ПереходНаМСФО9 = Ложь
	
	СтрокаДенежныеСредства = 					"03";
	СтрокаДСПрочие = 							"04";
	СтрокаДолговыеПоСС = 						"06";
	СтрокаДепозитыПоСС = 						"07";
