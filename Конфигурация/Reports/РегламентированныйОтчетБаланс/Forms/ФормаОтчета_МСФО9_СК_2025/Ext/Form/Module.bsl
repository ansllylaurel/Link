// 58.16
&НаСервере
Процедура ЗаполнитьРаздел_ГеографическийАнализФинансовыхАктивовИОбязательствСКСервер(ТекРаздел, ИмяРаздела)

	ЗаголовокРаздела = "Географический анализ финансовых активов и обязательств страховщика на " + ПредставлениеПериода(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета ,СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета); 
	ТекРаздел.Области.Заголовок.Значение = ЗаголовокРаздела;
	
	ТекРаздел.Области.ТекущийПериод.Значение    = СтруктураРеквизитовФормы.мПредставлениеТекущегоПериода;
	
	Запрос = ПодготовитьВременныеТаблицыДокумента();
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	УстановитьТекстЗапросаДляПолученияВременныхТаблиц(Запрос);
	
	Запрос.Выполнить();
	
	Запрос.УстановитьПараметр("Организация", СтруктураРеквизитовФормы.Организация);
	Запрос.УстановитьПараметр("ВалютаУчета", СтруктураРеквизитовФормы.Организация.ВалютаУчета);
		
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто2 В (&ДепозитныеВкладыКраткосрочные)
		|			ТОГДА ""01""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА УсловияКредитныхИнструментовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДепозитныеВкладыПоАС)
		|					ТОГДА ""09""
		|				ИНАЧЕ ""03""
		|			КОНЕЦ
		|	КОНЕЦ КАК НомерСтроки,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Депозит,
		|	ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Справочник.ДепозитныеВклады).БанковскийСчет.Банк.ЮрФизЛицо КАК ЮрФизЛицо,
		|	СУММА(ВЫБОР
		|			КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты01)
		|				ТОГДА ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаДепозит,
		|	СУММА(ВЫБОР
		|			КОГДА НЕ(ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты01)
		|						ИЛИ ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты15))
		|				ТОГДА ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаПроцент,
		|	СУММА(ВЫБОР
		|			КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты15)
		|				ТОГДА ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаРезерв
		|ПОМЕСТИТЬ _ДанныеДепозиты
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&грКонецПериода,
		|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты)),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|			УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
		|			УсловияКредитныхИнструментовСрезПоследних.УчетныйАктив КАК УчетныйАктив
		|		ИЗ
		|			(ВЫБРАТЬ
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|				МАКСИМУМ(УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
		|			ИЗ
		|				РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&грКонецПериода, ) КАК УсловияКредитныхИнструментовСрезПоследних
		|			ГДЕ
		|				УсловияКредитныхИнструментовСрезПоследних.Действует
		|			
		|			СГРУППИРОВАТЬ ПО
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент) КАК АктуальныеДатыНачалаДействия
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&грКонецПериода, ) КАК УсловияКредитныхИнструментовСрезПоследних
		|				ПО АктуальныеДатыНачалаДействия.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|					И АктуальныеДатыНачалаДействия.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК УсловияКредитныхИнструментовСрезПоследних
		|		ПО ЕдиныйБухгалтерскийУчетОстатки.Субконто2 = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто2 В (&ДепозитныеВкладыКраткосрочные)
		|			ТОГДА ""01""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА УсловияКредитныхИнструментовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДепозитныеВкладыПоАС)
		|					ТОГДА ""09""
		|				ИНАЧЕ ""03""
		|			КОНЕЦ
		|	КОНЕЦ,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2,
		|	ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Справочник.ДепозитныеВклады).БанковскийСчет.Банк.ЮрФизЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеДепозиты.НомерСтроки КАК НомерСтроки,
		|	_ДанныеДепозиты.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_ДанныеДепозиты.СуммаРезерв - ВЫБОР
