Процедура СкопироватьОбласть(ТекРаздел, ПоказателиПрошлогоГода, НачальныйНомерКолонки, КонечныйНомерКолонки, НачальныйНомерСтроки, КонечныйНомерСтроки, СдвигВертикаль, СдвигГоризонталь)

	// область прамоугольная. Координаты задают область в данных прошлого года, которую надо скопировать. 
	// Она совпадает с областью данных текущего года.  
	// сдвиг - смещение коррдинат, куда надо поместить данные прошлого года. 
	
	Для НомКол = НачальныйНомерКолонки по КонечныйНомерКолонки Цикл 
		НомКолСтрокаОткуда = Формат(НомКол, "ЧЦ=2; ЧДЦ=0; ЧВН="); 
		НомКолСтрокаКуда = Формат(НомКол + СдвигВертикаль, "ЧЦ=2; ЧДЦ=0; ЧВН="); 
		
		Для НомСтр = НачальныйНомерСтроки По КонечныйНомерСтроки Цикл
			НомСтрСтрокаОткуда = Формат(НомСтр, "ЧЦ=2; ЧДЦ=0; ЧВН=");
			НомСтрСтрокаКуда = Формат(НомСтр + СдвигГоризонталь, "ЧЦ=2; ЧДЦ=0; ЧВН=");
			
			ИмяЯчейкиОткуда = "П" + НомСтрСтрокаОткуда + НомКолСтрокаОткуда;
			ИмяЯчейкиКуда = "П" + НомСтрСтрокаКуда + НомКолСтрокаКуда;  
			
			// не придумал как избежать цикла. Цикл будет выполняться быстро
			ЕстьЗначениеПрошлогоГода = Ложь;
			Для Каждого СтрокаДанныеПрошлогоГода ИЗ ПоказателиПрошлогоГода Цикл
				Если СтрокаДанныеПрошлогоГода.ИмяПоказателя = ИмяЯчейкиОткуда Тогда 
					ТекРаздел.Области[ИмяЯчейкиКуда].Значение = СтрокаДанныеПрошлогоГода.Значение;
					ЕстьЗначениеПрошлогоГода = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла; 
			
			Если Не ЕстьЗначениеПрошлогоГода Тогда
				// в отчете за прошлый год этот показатель не заполнен, тогда в отчете этого года его нужно очистить
				Если ТипЗнч(ТекРаздел.Области[ИмяЯчейкиКуда].Значение) = Тип("Строка") Тогда 
					ТекРаздел.Области[ИмяЯчейкиКуда].Значение = "";
				Иначе
					ТекРаздел.Области[ИмяЯчейкиКуда].Значение = 0; 
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла; 
	
КонецПроцедуры

