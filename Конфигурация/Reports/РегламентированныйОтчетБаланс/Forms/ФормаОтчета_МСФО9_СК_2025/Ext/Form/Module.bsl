		|ИЗ
		|	_Раздел20 КАК _Раздел20
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИтоговаяТаблица.НомерСтроки КАК НомерСтроки,
		|	ВЫБОР
		|		КОГДА Валюты.Код = ""810""
		|				ИЛИ Валюты.Код = ""643""
		|			ТОГДА ""02""
		|		КОГДА Валюты.Код = ""840""
		|			ТОГДА ""03""
		|		КОГДА Валюты.Код = ""978""
		|			ТОГДА ""04""
		|		ИНАЧЕ ""05""
		|	КОНЕЦ КАК НомерКолонки,
		|	ВЫБОР
		|		КОГДА &ВалютаУчета = &ВалютаДокумента
		|			ТОГДА СУММА(_ИтоговаяТаблица.Сумма)
		|		ИНАЧЕ СУММА(_ИтоговаяТаблица.Сумма) * ЕСТЬNULL(КурсВалютыПроводки.Курс, 1)
		|	КОНЕЦ КАК Сумма
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
		|		ПО _ИтоговаяТаблица.Валюта = Валюты.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ КоэффициентыВалютТП КАК КурсВалютыПроводки
		|		ПО (&ВалютаУчета = КурсВалютыПроводки.Валюта)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА Валюты.Код = ""810""
		|				ИЛИ Валюты.Код = ""643""
		|			ТОГДА ""02""
		|		КОГДА Валюты.Код = ""840""
		|			ТОГДА ""03""
		|		КОГДА Валюты.Код = ""978""
		|			ТОГДА ""04""
		|		ИНАЧЕ ""05""
		|	КОНЕЦ,
		|	_ИтоговаяТаблица.НомерСтроки,
		|	КурсВалютыПроводки.Курс";
	
	// Отбор по кредитным организациям и банкам-нерезидент
	стрОтборКредитныеОрганизации	= "ВЫРАЗИТЬ(Субконто2 КАК Документ.СделкаРЕПО).СделкаСЦентральнымКонтрагентом = ИСТИНА";		
	стрОтборКредитныеОрганизации_НЕ	= "ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Документ.СделкаРЕПО).СделкаСЦентральнымКонтрагентом = ЛОЖЬ";		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТолькоКредитныеОрганизации", стрОтборКредитныеОрганизации);		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИсключаяКредитныеОрганизации", стрОтборКредитныеОрганизации_НЕ);		
	
	// Отбор по банкротам
	Запрос.УстановитьПараметр("Банкроты", РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицаБанкроты(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета));		
	
	Если ЭтаФорма.НастройкиОтчета.НеУчитыватьПроцентыМНОВДС = Неопределено ИЛИ НЕ ЭтаФорма.НастройкиОтчета.НеУчитыватьПроцентыМНОВДС Тогда
		Запрос.УстановитьПараметр("МНОэтоДепозит", Ложь);
	Иначе	
		Запрос.УстановитьПараметр("МНОэтоДепозит", Истина);
	КонецЕсли;
	
	// нет в запросе ДС

	Если ?(ЭтаФорма.НастройкиОтчета.УчитыватьБрокерскиеСчетаВДебиторке = Неопределено, ЛОЖЬ, ЭтаФорма.НастройкиОтчета.УчитыватьБрокерскиеСчетаВДебиторке) Тогда 
		Запрос.УстановитьПараметр("СтрокаДСБрокер", "10");  
	Иначе
		Если ?(ЭтаФорма.НастройкиОтчета.УчитыватьБрокерскиеСчетаВДС = Неопределено, ЛОЖЬ, ЭтаФорма.НастройкиОтчета.УчитыватьБрокерскиеСчетаВДС) Тогда
			Запрос.УстановитьПараметр("СтрокаДСБрокер", "01");
		Иначе
			Запрос.УстановитьПараметр("СтрокаДСБрокер", "09");
		КонецЕсли;
	КонецЕсли; 

	Если ?(ЭтаФорма.НастройкиОтчета.УчитыватьКлиринговыеСчетаВДС = Неопределено, ЛОЖЬ, ЭтаФорма.НастройкиОтчета.УчитыватьКлиринговыеСчетаВДС) Тогда
		Запрос.УстановитьПараметр("СтрокаДСКлиринг", "01");
	Иначе
		Запрос.УстановитьПараметр("СтрокаДСКлиринг", "09");
	КонецЕсли;
	
	Если ЭтаФорма.НастройкиОтчета.НеУчитыватьПроцентыПоДепозитамВДС = Неопределено ИЛИ НЕ ЭтаФорма.НастройкиОтчета.НеУчитыватьПроцентыПоДепозитамВДС Тогда
		Запрос.УстановитьПараметр("ПроцентыПоДепозитамВДС", Истина); 
	Иначе	
		Запрос.УстановитьПараметр("ПроцентыПоДепозитамВДС", Ложь); 
	КонецЕсли;
	
	ДепозитныеВкладыКраткосрочные = КонсолидированнаяОтчетность.ПолучитьДепозитныеВклады(ЭтаФорма.НастройкиОтчета, ЭтаФорма.СтруктураРеквизитовФормы, ,"Краткосрочные"); 
	Запрос.УстановитьПараметр("ДепозитныеВкладыКраткосрочные", ДепозитныеВкладыКраткосрочные);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаРезультат Из Результат Цикл
		УстановитьЗначениеПоказателя(ТекРаздел, "П" + СтрокаРезультат.НомерСтроки + СтрокаРезультат.НомерКолонки, СтрокаРезультат.Сумма);
	КонецЦикла;
	
	
КонецПроцедуры

// 62.2
&НаСервере
Процедура ЗаполнитьРаздел_УровниВИерархииСправедливойСтоимостиСКСервер(ТекРаздел, ИмяРаздела)   

	ЗаголовокРаздела = "Уровни в иерархии справедливой стоимости за " + ПредставлениеПериода(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета ,СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета); 
	ТекРаздел.Области.Заголовок.Значение = ЗаголовокРаздела;	
	
	ТекРаздел.Области.ТекущийПериод.Значение    = СтруктураРеквизитовФормы.мПредставлениеТекущегоПериода;
	
	Запрос = ПодготовитьВременныеТаблицыДокумента();
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	УстановитьТекстЗапросаДляПолученияВременныхТаблиц(Запрос);
	
	Запрос.Выполнить();
	
	Запрос.УстановитьПараметр("Организация", СтруктураРеквизитовФормы.Организация);
	Запрос.УстановитьПараметр("ВалютаУчета", СтруктураРеквизитовФормы.Организация.ВалютаУчета);
	
	СчетаЦБ = Новый Массив;
	СчетаЦБ.Добавить(ПланыСчетов.Единый.ДолговыеПрибыльУбыток);
	СчетаЦБ.Добавить(ПланыСчетов.Единый.ДолговыеДляПродажи);
	СчетаЦБ.Добавить(ПланыСчетов.Единый.ДолевыеПоСправедливой);
	СчетаЦБ.Добавить(ПланыСчетов.Единый.ДолевыеДляПродажи);
	Запрос.УстановитьПараметр("СчетаЦБ", СчетаЦБ);
	
	АктивыСС = Новый Массив;
	АктивыСС.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток);
	АктивыСС.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи);
	АктивыСС.Добавить(Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажи);
	АктивыСС.Добавить(Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой);
	Запрос.УстановитьПараметр("АктивыСС", АктивыСС);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтоимостьПереоценки.УровеньОценки КАК УровеньОценки,
		|	СтоимостьПереоценки.Партия КАК Партия,
		|	СтоимостьПереоценки.СтрокаПартии КАК СтрокаПартии
		|ПОМЕСТИТЬ _ПереоценкаЦенныхБумаг
		|ИЗ
		|	(ВЫБРАТЬ
		|		МАКСИМУМ(СтоимостьПереоценкиСрезПоследних.Период) КАК Период,
		|		СтоимостьПереоценкиСрезПоследних.Организация КАК Организация,
		|		СтоимостьПереоценкиСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		СтоимостьПереоценкиСрезПоследних.ЦельРасчета КАК ЦельРасчета,
		|		СтоимостьПереоценкиСрезПоследних.ВидЦеныОценки КАК ВидЦеныОценки
		|	ИЗ
		|		РегистрСведений.СтоимостьПереоценки.СрезПоследних(
		|				&КонецПериода,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ЕдиныйПланСчетов)
		|					И ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаПереоценки)) КАК СтоимостьПереоценкиСрезПоследних
		|	
		|	СГРУППИРОВАТЬ ПО
		|		СтоимостьПереоценкиСрезПоследних.Организация,
		|		СтоимостьПереоценкиСрезПоследних.СчетДоверительногоУправления,
		|		СтоимостьПереоценкиСрезПоследних.ЦельРасчета,
		|		СтоимостьПереоценкиСрезПоследних.ВидЦеныОценки) КАК _ДатаПереоценки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|		ПО _ДатаПереоценки.Период = СтоимостьПереоценки.Период
		|			И _ДатаПереоценки.Организация = СтоимостьПереоценки.Организация
		|			И _ДатаПереоценки.СчетДоверительногоУправления = СтоимостьПереоценки.СчетДоверительногоУправления
		|			И _ДатаПереоценки.ЦельРасчета = СтоимостьПереоценки.ЦельРасчета
		|			И _ДатаПереоценки.ВидЦеныОценки = СтоимостьПереоценки.ВидЦеныОценки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК ЦеннаяБумага,
		|	СУММА(ВЫБОР
		|			КОГДА ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика = ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюТела)
		|				ТОГДА ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ЗадолженностьПоПогашениюТела,
		|	СУММА(ВЫБОР
		|			КОГДА ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика = ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона)
		|					ИЛИ ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика = ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ПогашениеКупонаНеИсполненноеВСрок)
		|				ТОГДА ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ЗадолженностьПоПогашениюКупона,
		|	СУММА(ЕдиныйБухгалтерскийУчетОстатки.КоличествоОстаток) КАК Количество
		|ПОМЕСТИТЬ ЗадолжженностиПоПогашениям
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&грКонецПериода,
		|			Счет В ИЕРАРХИИ (&СчетаЦБ),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ЛицевойСчет.ДополнительнаяАналитика В (ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги), ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюТела), ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ПогашениеКупонаНеИсполненноеВСрок))) КАК ЕдиныйБухгалтерскийУчетОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Акции) ССЫЛКА Справочник.Акции
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Акции).УчетныйАктивЦБРФ
		|		КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации) ССЫЛКА Справочник.Облигации
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).УчетныйАктивЦБРФ
		|		КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Паи) ССЫЛКА Справочник.Паи
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Паи).УчетныйАктивЦБРФ
		|	КОНЕЦ КАК УчетныйАктивЦБРФ,
		|	СУММА(БухПартииЦенныхБумагОстатки.СтоимостьВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.КорректировкаЭСПВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.СтоимостьКупонаВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаКупонаВВалютеУчетаОстаток + ЗадолжженностиПоПогашениям.ЗадолженностьПоПогашениюТела * БухПартииЦенныхБумагОстатки.КоличествоОстаток / ЗадолжженностиПоПогашениям.Количество + ЗадолжженностиПоПогашениям.ЗадолженностьПоПогашениюКупона * БухПартииЦенныхБумагОстатки.КоличествоОстаток / ЗадолжженностиПоПогашениям.Количество) КАК Сумма,
		|	ВЫБОР
		|		КОГДА _ПереоценкаЦенныхБумаг.УровеньОценки = 1
		|			ТОГДА ""02""
		|		КОГДА _ПереоценкаЦенныхБумаг.УровеньОценки = 2
		|			ТОГДА ""03""
		|		КОГДА _ПереоценкаЦенныхБумаг.УровеньОценки = 3
		|			ТОГДА ""04""
		|	КОНЕЦ КАК НомерКолонки,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации) ССЫЛКА Справочник.Облигации, ЛОЖЬ) КАК ЭтоОблигации,
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Акции) ССЫЛКА Справочник.Акции
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|		КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации) ССЫЛКА Справочник.Облигации
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|		КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Паи) ССЫЛКА Справочник.Паи
		|			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
