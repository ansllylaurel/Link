	ИмяРаздела = "ОтчетТитульнаяСтраница";
	ТекСтрока  = ЭтаФорма.РазделыОтчета.НайтиСтроки(Новый Структура("ИмяРаздела", ИмяРаздела))[0];
	ТекРаздел  = ТекСтрока.ТабличныйДокумент;
	
	ТекРаздел.Области.ТекущийПериод.Значение    = СтруктураРеквизитовФормы.мПредставлениеТекущегоПериода;
