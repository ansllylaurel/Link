	АктивыСС.Добавить(Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой);
	
	АктивыАС = Новый Массив;
	АктивыАС.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСД);
	АктивыАС.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения);
	
	ЗапросРеклассификацияЦБ.УстановитьПараметр("Организация", СтруктураРеквизитовФормы.Организация);
	ЗапросРеклассификацияЦБ.УстановитьПараметр("СчетДоверительногоУправления", СтруктураРеквизитовФормы.СчетДоверительногоУправления);
	ЗапросРеклассификацияЦБ.УстановитьПараметр("НачалоПериода", НачалоДня(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета));
	ЗапросРеклассификацияЦБ.УстановитьПараметр("КонецПериода", КонецДня(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета));
	ЗапросРеклассификацияЦБ.УстановитьПараметр("АктивыСС", АктивыСС);
	ЗапросРеклассификацияЦБ.УстановитьПараметр("АктивыАС", АктивыАС);
		
	Результат = ЗапросРеклассификацияЦБ.Выполнить().Выгрузить();
	Для Каждого СтрокаРезультат Из Результат Цикл
		УстановитьЗначениеПоказателя(ТекРаздел, "П" + СтрокаРезультат.НомерСтроки + СтрокаРезультат.НомерКолонки, СтрокаРезультат.Сумма);
	КонецЦикла;	
	
	//была ли реклассификация депозитов? 
	ЗапросРеклассификацияДепозитов = Новый Запрос;
	ЗапросРеклассификацияДепозитов.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЕдиныйБухгалтерскийУчетОбороты.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Регистратор,
	|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты)),
	|			,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления,
	|			,
	|			) КАК ЕдиныйБухгалтерскийУчетОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&КонецПериода, ДатаНачалаДействияУсловий <= &КонецПериода) КАК УсловияКредитныхИнструментов
	|		ПО ЕдиныйБухгалтерскийУчетОбороты.Субконто2 = УсловияКредитныхИнструментов.КредитныйИнструмент
	|			И (УсловияКредитныхИнструментов.Действует)
	|			И (НАЧАЛОПЕРИОДА(ЕдиныйБухгалтерскийУчетОбороты.Регистратор.Дата, ДЕНЬ) = УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий)
	|ГДЕ
	|	ЕдиныйБухгалтерскийУчетОбороты.Регистратор ССЫЛКА Документ.КорректировкаРегистров
	|	И УсловияКредитныхИнструментов.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДепозитныеВкладыПоАС)";
	
	//по данным регистра УсловияКредитныхИнструментов депозит становится амортизированым с начала дня
	//фактически, все операции в течение дня относятся к справедливой стоимости, кроме последней корректировки. 
	// ищем такие корректировки
	
	
	ЗапросРеклассификацияДепозитов.УстановитьПараметр("Организация", СтруктураРеквизитовФормы.Организация);
	ЗапросРеклассификацияДепозитов.УстановитьПараметр("СчетДоверительногоУправления", СтруктураРеквизитовФормы.СчетДоверительногоУправления);
	ЗапросРеклассификацияДепозитов.УстановитьПараметр("НачалоПериода", НачалоДня(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета));
	ЗапросРеклассификацияДепозитов.УстановитьПараметр("КонецПериода", КонецДня(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета));
	
	Выборка = ЗапросРеклассификацияДепозитов.Выполнить().Выбрать();
	
	ЗапросРекласс = Новый Запрос;
	ШаблонЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	""02"" КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты15)
	|			ТОГДА ""04""
	|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет В (ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты17), ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты19))
	|			ТОГДА ""03""
	|		ИНАЧЕ ""02""
	|	КОНЕЦ КАК НомерКолонки,
	|	СУММА(ВЫБОР
	|			КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты15)
	|				ТОГДА -ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
	|			ИНАЧЕ ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
	|		КОНЕЦ) КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
	|			&грДатаРеклассификацииИсключаяN,
	|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты)),
	|			,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И Субконто2 В
	|					(ВЫБРАТЬ
	|						ЕдиныйБухгалтерскийУчетОбороты.Субконто2 КАК Депозит
	|					ИЗ
	|						РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(, , Регистратор, Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты)), , Организация = &Организация
	|							И СчетДоверительногоУправления = &СчетДоверительногоУправления, , ) КАК ЕдиныйБухгалтерскийУчетОбороты
	|					ГДЕ
	|						ЕдиныйБухгалтерскийУчетОбороты.Регистратор = &ДокРеклассификацииN)) КАК ЕдиныйБухгалтерскийУчетОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты15)
	|			ТОГДА ""04""
	|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет В (ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты17), ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты19))
	|			ТОГДА ""03""
	|		ИНАЧЕ ""02""
	|	КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""02"",
	|	ВЫБОР
	|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты15)
	|			ТОГДА ""05""
	|		ИНАЧЕ ""07""
	|	КОНЕЦ,
	|	СУММА(ВЫБОР
	|			КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты15)
	|				ТОГДА -ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
	|			ИНАЧЕ ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
	|		КОНЕЦ)
	|ИЗ
	|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
	|			&грДатаРеклассификацииВключаяN,
	|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты)),
	|			,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И Субконто2 В
	|					(ВЫБРАТЬ
	|						ЕдиныйБухгалтерскийУчетОбороты.Субконто2 КАК Депозит
	|					ИЗ
	|						РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(, , Регистратор, Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты)), , Организация = &Организация
	|							И СчетДоверительногоУправления = &СчетДоверительногоУправления, , ) КАК ЕдиныйБухгалтерскийУчетОбороты
	|					ГДЕ
	|						ЕдиныйБухгалтерскийУчетОбороты.Регистратор = &ДокРеклассификацииN)) КАК ЕдиныйБухгалтерскийУчетОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты15)
	|			ТОГДА ""05""
	|		ИНАЧЕ ""07""
	|	КОНЕЦ";

	
	ЗапросРекласс.Текст = "";
	
	СчетчикЦикла = 0;
	Пока Выборка.Следующий() Цикл   //формируем запрос на случай, если  в году было несколько реклассификаций депозитов
		
		ДокРеклассификацииДепозитов = Выборка.Регистратор;
		
		ТекстДобавка = СтрЗаменить(ШаблонЗапроса, "N", Формат(СчетчикЦикла, "ЧГ=0"));  
		Если СчетчикЦикла>0 Тогда 
			ТекстДобавка = СтрЗаменить(ТекстДобавка, "РАЗРЕШЕННЫЕ", "");
			ЗапросРекласс.Текст = ЗапросРекласс.Текст + "
			| ОБЪЕДИНИТЬ ВСЕ";
		КонецЕсли;
		ЗапросРекласс.Текст = ЗапросРекласс.Текст + "
		|"+ТекстДобавка;
		
		ЗапросРекласс.УстановитьПараметр("грДатаРеклассификацииВключая" + Формат(СчетчикЦикла, "ЧГ=0"), Новый Граница(КонецДня(ДокРеклассификацииДепозитов.Дата), ВидГраницы.Включая));
		ЗапросРекласс.УстановитьПараметр("грДатаРеклассификацииИсключая" + Формат(СчетчикЦикла, "ЧГ=0"), Новый Граница(ДокРеклассификацииДепозитов.Дата, ВидГраницы.Исключая));
		ЗапросРекласс.УстановитьПараметр("ДокРеклассификации" + Формат(СчетчикЦикла, "ЧГ=0"), ДокРеклассификацииДепозитов);
		
		СчетчикЦикла = СчетчикЦикла + 1;
	КонецЦикла;
	
	ЗапросРекласс.УстановитьПараметр("Организация", СтруктураРеквизитовФормы.Организация);
	ЗапросРекласс.УстановитьПараметр("СчетДоверительногоУправления", СтруктураРеквизитовФормы.СчетДоверительногоУправления);
	
	Если СчетчикЦикла > 0 Тогда 
		Результат = ЗапросРекласс.Выполнить().Выгрузить();
		
		Для Каждого СтрокаРезультат Из Результат Цикл
			УстановитьЗначениеПоказателя(ТекРаздел, "П" + СтрокаРезультат.НомерСтроки + СтрокаРезультат.НомерКолонки, СтрокаРезультат.Сумма);
		КонецЦикла;	
	КонецЕсли;
		
КонецПроцедуры	

#КонецОбласти 

