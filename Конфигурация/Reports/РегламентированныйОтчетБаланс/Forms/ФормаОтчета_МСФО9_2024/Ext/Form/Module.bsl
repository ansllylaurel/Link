&НаСервере
Процедура ДобавитьСтрокуВРасшифровку(Адрес_ТаблицаРасшифровки, мДатаНачалаПериодаОтчета, мДатаКонцаПериодаОтчета, СчетДоверительногоУправления, ИмяЯчейки, ИмяПоказателя, ЗнакОперации, ИмяСлагаемого, Сумма, Счет = Неопределено, КорСчет = Неопределено, Сдвиг = Неопределено, ПраваяГраница = Неопределено, Раздел = Неопределено)
	
	ТаблицаРасшифровки = ПолучитьИзВременногоХранилища(Адрес_ТаблицаРасшифровки);
	
	СтруктураПолей = Новый Структура("СчетДоверительногоУправления, ИмяЯчейки, ИмяПоказателя, ЗнакОперации, ИмяСлагаемого, Сумма, Счет, КорСчет, Сдвиг, ПраваяГраница, Раздел",
	СчетДоверительногоУправления, ИмяЯчейки, ИмяПоказателя, ЗнакОперации, ИмяСлагаемого, Сумма, Счет, КорСчет, Сдвиг, ПраваяГраница, Раздел);
	
	КонсолидированнаяОтчетность.ДобавитьСтрокуВРасшифровку(ТаблицаРасшифровки, мДатаНачалаПериодаОтчета, мДатаКонцаПериодаОтчета, СтруктураПолей);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначениеПоказателя(ТабДокумент, ИмяЯчейки, Знач ЗначениеЯчейки)
	
	Попытка
		Если ТипЗнч(ЗначениеЯчейки) <> Тип("Число") И ЗначениеЗаполнено(ЗначениеЯчейки) Тогда
			ЗначениеЯчейки = Строка(ЗначениеЯчейки);
			Если СтрНайти(ТабДокумент.Области[ИмяЯчейки].Значение, ЗначениеЯчейки) = 0 И ЗначениеЗаполнено(ТабДокумент.Области[ИмяЯчейки].Значение) Тогда
				ЗначениеЯчейки = ", " + ЗначениеЯчейки;
			ИначеЕсли ЗначениеЗаполнено(ТабДокумент.Области[ИмяЯчейки].Значение) Тогда
				ЗначениеЯчейки = "";
			КонецЕсли;
		КонецЕсли; 
		ТабДокумент.Области[ИмяЯчейки].Значение = ТабДокумент.Области[ИмяЯчейки].Значение + ?(ЗначениеЯчейки = Null, 0,ЗначениеЯчейки);
	Исключение
		ТекстСообщения = "Ошибка заполнения раздела: " + мИмяЗаполняемогоРаздела + " не найдена ячейка " + ИмяЯчейки;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьВременныеТаблицыДокумента()
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ВалютаДокумента"          	, СтруктураРеквизитовФормы.ВалютаДокумента);
	Запрос.УстановитьПараметр("НачалоПериода"            	, СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета);
	Запрос.УстановитьПараметр("КонецПериода"             	, СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета);
	Запрос.УстановитьПараметр("НачалоПредыдущегоПериода" 	, СтруктураРеквизитовФормы.мДатаНачалаПрошлогоПериодаОтчета);
	Запрос.УстановитьПараметр("КонецПредыдущегоПериода"  	, СтруктураРеквизитовФормы.мДатаКонцаПрошлогоПериодаОтчета);
	Запрос.УстановитьПараметр("грКонецПериода"           	, Новый Граница(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("грКонецПредыдущегоПериода"	, Новый Граница(СтруктураРеквизитовФормы.мДатаКонцаПрошлогоПериодаОтчета, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СтруктураРеквизитовФормы.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация"					, СтруктураРеквизитовФормы.Организация);
	
	ЗапрашиваемыеТаблицы = Новый СписокЗначений;
	ЗапрашиваемыеТаблицы.Добавить("ТаблицаСчетовСОбСубконто");
	ЗапрашиваемыеТаблицы.Добавить("КоэффициентыВалют");
	ЗапрашиваемыеТаблицы.Добавить("ФинансовыеОрганизации");
	ЗапрашиваемыеТаблицы.Добавить("ДепозитныеВкладыПоАС");
	
	ВременныеТаблицы = КонсолидированнаяОтчетность.ПодготовитьВременныеТаблицыДокумента(Запрос, ЗапрашиваемыеТаблицы);
	
	Для Каждого ЭлементСтруктуры из ВременныеТаблицы Цикл 
		Запрос.УстановитьПараметр(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
	КонецЦикла;	
	
	Если ВременныеТаблицы.Свойство("ДатаПеречняТП") Тогда 
		ЭтаФорма.Комментарий = "При построении отчета использован перечень организаций финансового сектора по состоянию на " + Формат(ВременныеТаблицы.ДатаПеречняТП, "ДФ=dd.MM.yyyy");
	КонецЕсли;		
	
	Возврат Запрос;
	
КонецФункции

