// 57.11
&НаСервере
Процедура ЗаполнитьРаздел_ИнформацияОКредитныхРейтингахДолговыхИнструментовСервер(ТекРаздел, ИмяРаздела)
	
	ТекРаздел.Области.ТекущийПериод.Значение    = СтруктураРеквизитовФормы.мПредставлениеТекущегоПериода;
	
	Запрос = ПодготовитьВременныеТаблицыДокумента();
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	УстановитьТекстЗапросаДляПолученияВременныхТаблиц(Запрос);
	
	Запрос.Выполнить();
	
	Запрос.УстановитьПараметр("Организация", СтруктураРеквизитовФормы.Организация);
	Запрос.УстановитьПараметр("ВалютаУчета", СтруктураРеквизитовФормы.Организация.ВалютаУчета);
	
	ТаблицаРейтинги = КонсолидированнаяОтчетность.ПолучитьТаблицуРейтинговНаДату(КонецДня(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета));
	Запрос.УстановитьПараметр("Рейтинги", ТаблицаРейтинги); 

	Запрос.Текст =       
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Рейтинги.Субъект КАК Субъект,
		|	Рейтинги.ТипШкалы КАК ТипШкалы,
		|	Рейтинги.СтрокаСопоставления КАК СтрокаСопоставления,
		|	Рейтинги.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	Рейтинги.Шкала КАК Шкала,
		|	Рейтинги.ШкалаВладелец КАК ШкалаВладелец,
		|	Рейтинги.ШкалаТипШкалы КАК ШкалаТипШкалы,
		|	Рейтинги.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	Рейтинги.ЗначениеРейтингаНаименование КАК ЗначениеРейтингаНаименование,
		|	Рейтинги.Период КАК Период
		|ПОМЕСТИТЬ _Рейтинги
		|ИЗ
		|	&Рейтинги КАК Рейтинги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Депозиты.Сумма КАК Сумма,
		|	ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, Депозиты.Банк) КАК Банк,
		|	Депозиты.ЭтоМНО КАК ЭтоМНО,
		|	Депозиты.Валюта КАК Валюта,
		|	УсловияКредитныхИнструментовСрезПоследних.УчетныйАктив КАК УчетныйАктив
		|ПОМЕСТИТЬ _Депозиты
		|ИЗ
		|	(ВЫБРАТЬ
		|		ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт КАК Сумма,
		|		ВЫБОР
		|			КОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.ЮрФизЛица) ССЫЛКА Справочник.ЮрФизЛица
		|				ТОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто1
		|			ИНАЧЕ ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.БанковскиеСчета).Банк.ЮрФизЛицо
		|		КОНЕЦ КАК Банк,
		|		ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.ЮрФизЛица) ССЫЛКА Справочник.ЮрФизЛица КАК ЭтоМНО,
		|		ЕдиныйБухгалтерскийУчетОстатки.Валюта КАК Валюта,
		|		ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Субконто1,
		|		ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Субконто2
		|	ИЗ
		|		РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&грКонецПериода,
		|				Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты)),
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки) КАК Депозиты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&КонецПериода, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО Депозиты.Банк = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|			И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|			УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
		|			УсловияКредитныхИнструментовСрезПоследних.УчетныйАктив КАК УчетныйАктив
		|		ИЗ
		|			(ВЫБРАТЬ
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|				МАКСИМУМ(УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
		|			ИЗ
		|				РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&КонецПериода, ДатаНачалаДействияУсловий <= &КонецПериода) КАК УсловияКредитныхИнструментовСрезПоследних
		|			ГДЕ
		|				УсловияКредитныхИнструментовСрезПоследних.Действует
		|			
		|			СГРУППИРОВАТЬ ПО
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент) КАК АктуальныеДатыНачалаДействия
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&КонецПериода, ДатаНачалаДействияУсловий <= &КонецПериода) КАК УсловияКредитныхИнструментовСрезПоследних
		|				ПО АктуальныеДатыНачалаДействия.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|					И АктуальныеДатыНачалаДействия.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК УсловияКредитныхИнструментовСрезПоследних
		|		ПО Депозиты.Субконто2 = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|ГДЕ
		|	ЕСТЬNULL(УсловияКредитныхИнструментовСрезПоследних.УчетныйАктив, НЕОПРЕДЕЛЕНО) <> ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДепозитныеВкладыПоАС)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт * &ПроцентыМНОвДС,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1.Банк.ЮрФизЛицо,
		|	ИСТИНА,
		|	ЕдиныйБухгалтерскийУчетОстатки.Валюта,
		|	NULL
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&грКонецПериода,
		|			Счет В (ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетныеСчета07), ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетныеСчета08)),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.БанковскиеСчета),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПереопределениеКлассификацииУчетныхАктивовЦБСрезПоследних.Эмитент.ЮрФизЛицо КАК Эмитент,
		|	ПереопределениеКлассификацииУчетныхАктивовЦБСрезПоследних.ИсходныйУчетныйАктивЦБ КАК ИсходныйУчетныйАктивЦБ,
		|	ПереопределениеКлассификацииУчетныхАктивовЦБСрезПоследних.НовыйУчетныйАктивЦБ КАК НовыйУчетныйАктивЦБ
		|ПОМЕСТИТЬ ПереопределенияАктивов
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&грКонецПериода, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
