// 10.4 
&НаСервере
Процедура ЗаполнитьРаздел_ИнформацияПоНоминальнымПроцентнымСтавкамИОжидаемымСрокамПогашенияСервер(ТекРаздел, ИмяРаздела)
	
	ТекРаздел.Области.ТекущийПериод.Значение    = СтруктураРеквизитовФормы.мПредставлениеТекущегоПериода;
	ТекРаздел.Области.ПредыдущийПериод.Значение = СтруктураРеквизитовФормы.мПредставлениеПредыдущегоПериода;
	
	мИмяЗаполняемогоРаздела = ИмяРаздела;
	
	мТаблицаСчетов = ПолучитьИзВременногоХранилища(Адрес_мТаблицаСчетов);
	
	Запрос = ПодготовитьВременныеТаблицыДокумента();
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	УстановитьТекстЗапросаДляПолученияВременныхТаблиц(Запрос);
	
	Запрос.Выполнить();
	
	Запрос.УстановитьПараметр("Организация", СтруктураРеквизитовФормы.Организация);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(УсловияСделокРЕПОСрезПоследних.СтавкаРЕПО) КАК СтавкаМакс,
		|	МИНИМУМ(УсловияСделокРЕПОСрезПоследних.СтавкаРЕПО) КАК СтавкаМин,
		|	МАКСИМУМ(РАЗНОСТЬДАТ(УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата, УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО, ДЕНЬ)) КАК ИнтервалМакс,
		|	МИНИМУМ(РАЗНОСТЬДАТ(УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата, УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО, ДЕНЬ)) КАК ИнтервалМин,
		|	МАКСИМУМ(УсловияСделокРЕПОСрезПоследнихП.СтавкаРЕПО) КАК СтавкаМаксП,
		|	МИНИМУМ(УсловияСделокРЕПОСрезПоследнихП.СтавкаРЕПО) КАК СтавкаМинП,
		|	МАКСИМУМ(РАЗНОСТЬДАТ(УсловияСделокРЕПОСрезПоследнихП.СделкаРЕПО.Дата, УсловияСделокРЕПОСрезПоследнихП.ДатаВторойЧастиРЕПО, ДЕНЬ)) КАК ИнтервалМаксП,
		|	МИНИМУМ(РАЗНОСТЬДАТ(УсловияСделокРЕПОСрезПоследнихП.СделкаРЕПО.Дата, УсловияСделокРЕПОСрезПоследнихП.ДатаВторойЧастиРЕПО, ДЕНЬ)) КАК ИнтервалМинП
		|ИЗ
		|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ЧастьСделкиРЕПО = 1
		|				И СделкаРЕПО.Дата <= &КонецПериода
		|				И ДатаВторойЧастиРЕПО > &КонецПериода
		|				И &ТолькоКредитныеОрганизации) КАК УсловияСделокРЕПОСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|				&КонецПредыдущегоПериода,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ЧастьСделкиРЕПО = 1
		|					И СделкаРЕПО.Дата <= &КонецПредыдущегоПериода
		|					И ДатаВторойЧастиРЕПО > &КонецПредыдущегоПериода
		|					И &ТолькоКредитныеОрганизации) КАК УсловияСделокРЕПОСрезПоследнихП
		|		ПО (ИСТИНА)";
	
	// Только кредитные организации и банки-нерезиденты  
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТолькоКредитныеОрганизации", "СделкаРЕПО.СделкаСЦентральнымКонтрагентом = ИСТИНА");  	
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат[0].СтавкаМин <> NULL Тогда  
		УстановитьЗначениеПоказателя(ТекРаздел, "П0402", Строка(Результат[0].СтавкаМин) + "% - " + Строка(Результат[0].СтавкаМакс) + "%");
		УстановитьЗначениеПоказателя(ТекРаздел, "П0403", Строка(Результат[0].ИнтервалМин) + " д. - " + Строка(Результат[0].ИнтервалМакс) + " д.");
	КонецЕсли;		
	
	Если Результат[0].СтавкаМинП <> NULL Тогда  
		УстановитьЗначениеПоказателя(ТекРаздел, "П0404", Строка(Результат[0].СтавкаМинП) + "% - " + Строка(Результат[0].СтавкаМаксП) + "%");
		УстановитьЗначениеПоказателя(ТекРаздел, "П0405", Строка(Результат[0].ИнтервалМинП) + " д. - " + Строка(Результат[0].ИнтервалМаксП) + " д.");
	КонецЕсли;

КонецПроцедуры

// 11.1
&НаСервере
Процедура ЗаполнитьРаздел_ПрочиеРазмещенныеСредстваДЗСервер(ТекРаздел, ИмяРаздела)
	
	мИмяЗаполняемогоРаздела = ИмяРаздела;
	
	мТаблицаСчетов = ПолучитьИзВременногоХранилища(Адрес_мТаблицаСчетов);
	
	Запрос = ПодготовитьВременныеТаблицыДокумента();
	
	ТекРаздел.Области.ТекущийПериод.Значение    = СтруктураРеквизитовФормы.мПредставлениеТекущегоПериода;
	ТекРаздел.Области.ПредыдущийПериод.Значение = СтруктураРеквизитовФормы.мПредставлениеПредыдущегоПериода;
	
	// Исключая кредитные организации и банки-нерезиденты
	стрОтборКредитныеОрганизации_НЕ = " И ВЫРАЗИТЬ(Субконто2 КАК Документ.СделкаРЕПО).СделкаСЦентральнымКонтрагентом = ЛОЖЬ";		
	
	// Отбор по банкротам
	Запрос.УстановитьПараметр("Банкроты", РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицаБанкроты(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета));		
