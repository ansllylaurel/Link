// 6.2
&НаСервере
Процедура ЗаполнитьРаздел_ЦенныеБумагиПоСправедливойСтоимостиЧерезПрибыльУбытокСервер(ТекРаздел, ИмяРаздела)
	
	мИмяЗаполняемогоРаздела = ИмяРаздела;
	
	мТаблицаСчетов = ПолучитьИзВременногоХранилища(Адрес_мТаблицаСчетов);
	
	Запрос = ПодготовитьВременныеТаблицыДокумента();
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	УстановитьТекстЗапросаДляПолученияВременныхТаблиц(Запрос);
	Запрос.Выполнить();
	
	ТекРаздел.Области.ТекущийПериод.Значение    = СтруктураРеквизитовФормы.мПредставлениеТекущегоПериода;
	ТекРаздел.Области.ПредыдущийПериод.Значение = СтруктураРеквизитовФормы.мПредставлениеПредыдущегоПериода;
	
	СчетаУчетаЦенныхБумаг = КонсолидированнаяОтчетность.ПолучитьСчетаУчетаЦенныхБумаг();
	
	Запрос.УстановитьПараметр("СчетаДолговых", СчетаУчетаЦенныхБумаг.СчетаДолговых);
	Запрос.УстановитьПараметр("СчетаДолевых", СчетаУчетаЦенныхБумаг.СчетаДолевых);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Актив,
	               |	ЕСТЬNULL(Эмитенты.ЮрФизЛицо, РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо) КАК ЮрФизЛицо,
	               |	ЕдиныйБухгалтерскийУчетОстатки.Счет,
	               |	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток КАК Сумма
	               |ПОМЕСТИТЬ _ЕдиныйБухгалтерскийУчетОстатки
	               |ИЗ
	               |	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
	               |			&грКонецПериода,
	               |			Счет В (&СчетаДолевых, &СчетаДолговых),
	               |			,
	               |			Организация = &Организация
	               |				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
	               |		ПО (ВЫБОР
	               |				КОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Акции) ССЫЛКА Справочник.Акции
	               |					ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Акции).Эмитент
	               |				КОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Облигации) ССЫЛКА Справочник.Облигации
	               |					ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Облигации).Эмитент
	               |			КОНЕЦ = Эмитенты.Ссылка)				   
				   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&КонецПериода, ) КАК РеквизитыПИФСрезПоследних
				   |		ПО (ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПеречниОбъектов.Объект,
	               |	ПеречниОбъектов.ВидПеречня
	               |ПОМЕСТИТЬ _ПеречниОбъектов
	               |ИЗ
	               |	РегистрСведений.ПеречниОбъектов КАК ПеречниОбъектов
	               |ГДЕ
	               |	ПеречниОбъектов.Включен
	               |	И НЕ ПеречниОбъектов.ВидПеречня = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ЦБРФ_ИнвестиционныеФонды)
	               |	И ПеречниОбъектов.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЦБРФ)
	               |			И ПеречниОбъектов.ВидПеречня.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ЦБРФ_ПереченьОрганизацийФинансовогоСектора)
	               |			И ПеречниОбъектов.Объект В
	               |				(ВЫБРАТЬ
	               |					_ЕдиныйБухгалтерскийУчетОстатки.ЮрФизЛицо
	               |				ИЗ
	               |					_ЕдиныйБухгалтерскийУчетОстатки КАК _ЕдиныйБухгалтерскийУчетОстатки)
	               |	И ПеречниОбъектов.Период = &ДатаПеречняТП
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	_ПеречниОбъектов.Объект,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ПеречниОбъектов.ВидПеречня) КАК ВидПеречня
	               |ПОМЕСТИТЬ _ОрганизацииВходящиеВНесколькоСекторов
	               |ИЗ
	               |	_ПеречниОбъектов КАК _ПеречниОбъектов
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	_ПеречниОбъектов.Объект
	               |
	               |ИМЕЮЩИЕ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ПеречниОбъектов.ВидПеречня) > 1
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	_ЕдиныйБухгалтерскийУчетОстатки.Актив,
	               |	_ЕдиныйБухгалтерскийУчетОстатки.ЮрФизЛицо,
	               |	ВЫБОР
	               |		КОГДА _ЕдиныйБухгалтерскийУчетОстатки.ЮрФизЛицо В
	               |				(ВЫБРАТЬ
	               |					_ОрганизацииВходящиеВНесколькоСекторов.Объект
	               |				ИЗ
	               |					_ОрганизацииВходящиеВНесколькоСекторов КАК _ОрганизацииВходящиеВНесколькоСекторов)
	               |			ТОГДА """"
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА _ЕдиныйБухгалтерскийУчетОстатки.Счет В (&СчетаДолевых)
	               |					ТОГДА ВЫБОР
	               |							КОГДА _ПеречниОбъектов.ВидПеречня = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ЦБРФ_КредитныеОрганизации)
	               |								ТОГДА ""П02""
	               |							КОГДА _ПеречниОбъектов.ВидПеречня ЕСТЬ NULL 
	               |								ТОГДА ""П04""
	               |							ИНАЧЕ ""П03""
	               |						КОНЕЦ
	               |				ИНАЧЕ ВЫБОР
	               |						КОГДА ВЫРАЗИТЬ(_ЕдиныйБухгалтерскийУчетОстатки.Актив КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная)
	               |							ТОГДА ""П06""
	               |						КОГДА ВЫРАЗИТЬ(_ЕдиныйБухгалтерскийУчетОстатки.Актив КАК Справочник.Облигации).Категория В (ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная), _ПеречниОбъектов.ВидПеречня = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Муниципальная))
	               |							ТОГДА ""П07""
	               |						КОГДА ВЫРАЗИТЬ(_ЕдиныйБухгалтерскийУчетОстатки.Актив КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
	               |							ТОГДА ""П08""
	               |						КОГДА _ПеречниОбъектов.ВидПеречня = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ЦБРФ_КредитныеОрганизации)
	               |							ТОГДА ""П09""
	               |						КОГДА _ПеречниОбъектов.ВидПеречня ЕСТЬ NULL 
	               |							ТОГДА ""П11""
	               |						ИНАЧЕ ""П10""
	               |					КОНЕЦ
	               |			КОНЕЦ
	               |	КОНЕЦ КАК НомерСтроки,
	               |	_ЕдиныйБухгалтерскийУчетОстатки.Сумма
	               |ПОМЕСТИТЬ _ИтоговаяТаблица
	               |ИЗ
	               |	_ЕдиныйБухгалтерскийУчетОстатки КАК _ЕдиныйБухгалтерскийУчетОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ _ПеречниОбъектов КАК _ПеречниОбъектов
	               |		ПО _ЕдиныйБухгалтерскийУчетОстатки.ЮрФизЛицо = _ПеречниОбъектов.Объект
	               |			И (НЕ _ПеречниОбъектов.Объект В
	               |					(ВЫБРАТЬ
	               |						_ОрганизацииВходящиеВНесколькоСекторов.Объект
	               |					ИЗ
	               |						_ОрганизацииВходящиеВНесколькоСекторов КАК _ОрганизацииВходящиеВНесколькоСекторов))
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	_ИтоговаяТаблица.Актив,
	               |	_ИтоговаяТаблица.ЮрФизЛицо,
	               |	_ИтоговаяТаблица.НомерСтроки,
	               |	СУММА(_ИтоговаяТаблица.Сумма) КАК Сумма
	               |ИЗ
	               |	_ИтоговаяТаблица КАК _ИтоговаяТаблица
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	_ИтоговаяТаблица.НомерСтроки,
	               |	_ИтоговаяТаблица.ЮрФизЛицо,
	               |	_ИтоговаяТаблица.Актив
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ _ЕдиныйБухгалтерскийУчетОстатки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ _ПеречниОбъектов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ _ОрганизацииВходящиеВНесколькоСекторов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ _ИтоговаяТаблица";
				   
	мТаблицаСчетов.Очистить();
	
	
	Для НомерЦикла = 1 По 2 Цикл
		
		Если НомерЦикла = 1 Тогда
			НомерКолонки = "02";
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НачалоПериода", "&НачалоПредыдущегоПериода");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КонецПериода", "&КонецПредыдущегоПериода");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&грКонецПериода", "&грКонецПредыдущегоПериода");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "КоэффициентыВалютТП", "КоэффициентыВалютПП");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаПеречняТП", "&ДатаПеречняПП");
			
			НомерКолонки = "03";
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
			
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.НомерСтроки = "" Тогда
			
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для ценной бумаги " + Выборка.Актив + " не удалось определеить сектор экономики. Бумага пропущена");
				
			Иначе
				
				НоваяСтрока = мТаблицаСчетов.Добавить();
				НоваяСтрока.ИмяЯчейки = Выборка.НомерСтроки + НомерКолонки;
				НоваяСтрока.Сумма = Выборка.Сумма;
				
			КонецЕсли; 
			
		КонецЦикла;	
				
	КонецЦикла;
	
	ВремТз = мТаблицаСчетов.Скопировать(, "ИмяЯчейки, Сумма");
	ВремТз.Свернуть("ИмяЯчейки", "Сумма");
	Для Каждого СтрокаСчета Из ВремТз Цикл
		УстановитьЗначениеПоказателя(ТекРаздел, СтрокаСчета.ИмяЯчейки, СтрокаСчета.Сумма);
	КонецЦикла;

КонецПроцедуры

