// 61.6
&НаСервере
Процедура ЗаполнитьРаздел_АнализСправедливойСтоимостиИБалансоваяСтоимостьСервер(ТекРаздел, ИмяРаздела)
	мИмяЗаполняемогоРаздела = ИмяРаздела;
	
	ТекРаздел.Области.ТекущийПериод.Значение = СтруктураРеквизитовФормы.мПредставлениеТекущегоПериода;
	
	// Подготовка запроса
	Запрос = ПодготовитьВременныеТаблицыДокумента();

	// Отбор по кредитным организациям и банкам-нерезидент
	стрОтборКредитныеОрганизации	= "ВЫРАЗИТЬ(Субконто2 КАК Документ.СделкаРЕПО).СделкаСЦентральнымКонтрагентом = ИСТИНА";		
	стрОтборКредитныеОрганизации_НЕ	= "ВЫРАЗИТЬ(Субконто2 КАК Документ.СделкаРЕПО).СделкаСЦентральнымКонтрагентом = ЛОЖЬ";		
	
	// Отбор по банкротам
	Банкроты = РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицаБанкроты(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета);	
	Запрос.УстановитьПараметр("Банкроты", Банкроты);		
	стрОтборБанкроты = "Субконто1 В (&Банкроты)";	
	
	// Получение данных раздела с простой логикой
	мТаблицаСчетов = ПолучитьИзВременногоХранилища(Адрес_мТаблицаСчетов);
	
	// 03-07 (по примечанию 5.1) 
	мТаблицаСчетов.Очистить();
	ДобавитьСчетВТаблицуСчетов("П0302", "Денежные средства в кассе", "+", "!СКД", "20202", "Сальдо на конец периода #Период# по дебету счета 20202");
	ДобавитьСчетВТаблицуСчетов("П0302", "Денежные средства в кассе", "+", "!СКД", "20203", "Сальдо на конец периода #Период# по дебету счета 20203");
	ЗаполнитьРазделПоСпискуСчетовЗаПериод(Запрос, "НаКонец", "ЗаТекущийПериод", ТекРаздел);
	КонсолидированнаяОтчетность.СкопироватьЗначениеЯчейки(СтруктураРеквизитовФормы, ЭтаФорма, Адрес_ТаблицаРасшифровки, ИмяРаздела, ТекРаздел, "П0306", ТекРаздел, "П0302");	
	
	мТаблицаСчетов.Очистить();
	ДобавитьСчетВТаблицуСчетов("П0402", "Денежные средства в пути", "+", "!СКД", "20209", "Сальдо на конец периода #Период# по дебету счета 20209");
	ЗаполнитьРазделПоСпискуСчетовЗаПериод(Запрос, "НаКонец", "ЗаТекущийПериод", ТекРаздел);
	КонсолидированнаяОтчетность.СкопироватьЗначениеЯчейки(СтруктураРеквизитовФормы, ЭтаФорма, Адрес_ТаблицаРасшифровки, ИмяРаздела, ТекРаздел, "П0406", ТекРаздел, "П0402");	
	
	мТаблицаСчетов.Очистить();
	ДобавитьСчетВТаблицуСчетов("П0602", "Денежные средства, переданные в доверительное управление", "+", "!СКД", "20501", "Сальдо на конец периода #Период# по дебету счета 20501");
	ДобавитьСчетВТаблицуСчетов("П0602", "Денежные средства, переданные в доверительное управление", "+", "!СКД", "20502", "Сальдо на конец периода #Период# по дебету счета 20502");
	ДобавитьСчетВТаблицуСчетов("П0602", "Денежные средства, переданные в доверительное управление", "+", "!СКД", "47901", "Сальдо на конец периода #Период# по дебету счета 47901");
	ЗаполнитьРазделПоСпискуСчетовЗаПериод(Запрос, "НаКонец", "ЗаТекущийПериод", ТекРаздел);
	КонсолидированнаяОтчетность.СкопироватьЗначениеЯчейки(СтруктураРеквизитовФормы, ЭтаФорма, Адрес_ТаблицаРасшифровки, ИмяРаздела, ТекРаздел, "П0606", ТекРаздел, "П0602");	
	
