// 61.3
&НаСервере
Процедура ЗаполнитьРаздел_МетодыОценкиИИсходныеДанныеУровня3Сервер(ТекРаздел, ИмяРаздела)
	
	ТекРаздел.Области.ТекущийПериод.Значение    = СтруктураРеквизитовФормы.мПредставлениеТекущегоПериода;
	
	Запрос = ПодготовитьВременныеТаблицыДокумента();
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	УстановитьТекстЗапросаДляПолученияВременныхТаблиц(Запрос);
	
	Запрос.Выполнить();
	
	Запрос.УстановитьПараметр("Организация", СтруктураРеквизитовФормы.Организация);
	Запрос.УстановитьПараметр("ВалютаУчета", СтруктураРеквизитовФормы.Организация.ВалютаУчета);
	
	СчетаЦБ = Новый Массив;
	СчетаЦБ.Добавить(ПланыСчетов.Единый.ДолговыеПрибыльУбыток);
	СчетаЦБ.Добавить(ПланыСчетов.Единый.ДолговыеДляПродажи);
	СчетаЦБ.Добавить(ПланыСчетов.Единый.ДолевыеПоСправедливой);
	СчетаЦБ.Добавить(ПланыСчетов.Единый.ДолевыеДляПродажи);
	
	Запрос.УстановитьПараметр("СчетаЦБ", СчетаЦБ);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПереоценкаЦенныхБумаг.Ссылка КАК Ссылка,
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СтоимостьПереоценки.УровеньОценки) > 1
		|			ТОГДА 0
		|		ИНАЧЕ МАКСИМУМ(СтоимостьПереоценки.УровеньОценки)
		|	КОНЕЦ КАК УровеньОценки,
		|	СтоимостьПереоценки.ВидЦены КАК ВидЦены,
		|	СтоимостьПереоценки.Источник КАК Источник
		|ПОМЕСТИТЬ _ПереоценкаЦенныхБумаг
		|ИЗ
		|	(ВЫБРАТЬ
		|		МАКСИМУМ(ПереоценкаЦенныхБумаг.Дата) КАК Дата
		|	ИЗ
		|		Документ.ПереоценкаЦенныхБумаг КАК ПереоценкаЦенныхБумаг
		|	ГДЕ
		|		ПереоценкаЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|		И ПереоценкаЦенныхБумаг.Организация = &Организация
		|		И ПереоценкаЦенныхБумаг.Проведен
		|		И ПереоценкаЦенныхБумаг.Дата <= &КонецПериода
		|		И ПереоценкаЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)) КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПереоценкаЦенныхБумаг КАК ПереоценкаЦенныхБумаг
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|			ПО ПереоценкаЦенныхБумаг.Ссылка = СтоимостьПереоценки.Регистратор
		|		ПО ВложенныйЗапрос.Дата = ПереоценкаЦенныхБумаг.Дата
		|ГДЕ
		|	ПереоценкаЦенныхБумаг.Организация = &Организация
		|	И ПереоценкаЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПереоценкаЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|	И ПереоценкаЦенныхБумаг.Проведен
		|
		|СГРУППИРОВАТЬ ПО
		|	ПереоценкаЦенныхБумаг.Ссылка,
		|	СтоимостьПереоценки.ЦеннаяБумага,
		|	СтоимостьПереоценки.ВидЦены,
		|	СтоимостьПереоценки.Источник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Акции) ССЫЛКА Справочник.Акции
		|			ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Акции).УчетныйАктивЦБРФ
		|		КОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Облигации) ССЫЛКА Справочник.Облигации
		|			ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Облигации).УчетныйАктивЦБРФ
		|		КОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Паи) ССЫЛКА Справочник.Паи
		|			ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Паи).УчетныйАктивЦБРФ
		|	КОНЕЦ КАК УчетныйАктивЦБРФ,
		|	СУММА(ВЫБОР
		|			КОГДА _ПереоценкаЦенныхБумаг.УровеньОценки = 3
		|				ТОГДА ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Сумма,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Облигации) ССЫЛКА Справочник.Облигации, ЛОЖЬ) КАК ЭтоОблигации,
		|	_ПереоценкаЦенныхБумаг.ВидЦены КАК ВидЦены,
		|	_ПереоценкаЦенныхБумаг.Источник КАК Источник,
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Акции) ССЫЛКА Справочник.Акции
		|			ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Акции).Эмитент.ЮрФизЛицо
