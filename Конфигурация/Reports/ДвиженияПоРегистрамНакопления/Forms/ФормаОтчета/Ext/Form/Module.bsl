&НаСервере
Процедура ДобавитьПолеНабораДанных(НаборДанныхНастройкиПолей, ИмяПоля, Заголовок, ТипПоля)

	Поле = НаборДанныхНастройкиПолей.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
	Поле.Поле = ИмяПоля;
	Поле.ПутьКДанным = ИмяПоля;
	Поле.Заголовок = Заголовок;
	Поле.ТипЗначения = ТипПоля;

КонецПроцедуры

&НаСервере
Процедура ИзменитьСхемуКомпоновкиДанных(ПерезаполнитьГруппировки, ПерезаполнятьНастройкуПолей = Истина)
	
	ЕстьИзмерениеСчетДУ = Метаданные.РегистрыНакопления[ЭтаФорма.Регистр].Измерения.Найти("СчетДоверительногоУправления") <> Неопределено;
	
	Если НЕ ЕстьИзмерениеСчетДУ Тогда
		СчетДоверительногоУправления = Неопределено;
	КонецЕсли;
	
	Элементы.СчетДоверительногоУправления.Доступность = ЕстьИзмерениеСчетДУ;
	
	ДетализацияПоСчетуДУ = ЕстьИзмерениеСчетДУ
							И ЭтаФорма.Параметры <> Неопределено
							И ЭтаФорма.Параметры.Свойство("Отбор")
							И ЭтаФорма.Параметры.Отбор <> Неопределено
							И ЭтаФорма.Параметры.Отбор.Свойство("СчетДоверительногоУправления");
	
	ДетализацияПоКлиенту = ЕстьИзмерениеСчетДУ
							И ЭтаФорма.Параметры <> Неопределено
							И ЭтаФорма.Параметры.Свойство("Отбор")
							И ЭтаФорма.Параметры.Отбор <> Неопределено
							И ЭтаФорма.Параметры.Отбор.Свойство("Клиент");
	
	ДетализацияПоСтратегии = ЕстьИзмерениеСчетДУ
							И ЭтаФорма.Параметры <> Неопределено
							И ЭтаФорма.Параметры.Свойство("Отбор")
							И ЭтаФорма.Параметры.Отбор <> Неопределено
							И ЭтаФорма.Параметры.Отбор.Свойство("Стратегия");
	
	ОборотныйРегистр = (Метаданные.РегистрыНакопления[ЭтаФорма.Регистр].ВидРегистра =  Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Обороты);
	
	Схема = Новый СхемаКомпоновкиДанных;
    
    //1.1 определяем источник данных для схемы 
    Источник = Схема.ИсточникиДанных.Добавить();
    Источник.Имя = "ЛокальнаяБаза";
    Источник.СтрокаСоединения = "";
    Источник.ТипИсточникаДанных = "Local";
    
    //1.2 определяем набор данных 
	НаборДанных = Схема.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
    НаборДанных.Имя = "Продажи";
    НаборДанных.ИсточникДанных = "ЛокальнаяБаза";
//    НаборДанных.АвтоЗаполнениеДоступныхПолей = Ложь;
    НаборДанных.АвтоЗаполнениеДоступныхПолей = Истина;
    НаборДанных.Запрос = (ВернутьТекстЗапроса(ЭтаФорма.Регистр, ОборотныйРегистр, ДетализацияПоСтратегии, ДетализацияПоКлиенту, ДетализацияПоСчетуДУ));
                       
	////1.3 определяем ресурсы 
	//Для каждого РесурсРегистраНакопления Из Метаданные.РегистрыНакопления[Этаформа.Регистр].Ресурсы Цикл
	//	ДобавитьПолеРесурса(Схема, РесурсРегистраНакопления, "НачальныйОстаток");
	//	ДобавитьПолеРесурса(Схема, РесурсРегистраНакопления, "Приход");
	//	ДобавитьПолеРесурса(Схема, РесурсРегистраНакопления, "Расход");
	//	ДобавитьПолеРесурса(Схема, РесурсРегистраНакопления, "КонечныйОстаток");
	//КонецЦикла;
	
    //2. создаем настройки для схемы 
    НастройкиКомпоновкиДанных = Схема.НастройкиПоУмолчанию;
	НастройкиКомпоновкиДанных.Структура.Очистить();
	
    //2.1 определяем структуру
	ПоляКомпоновкиДанных = НастройкиКомпоновкиДанных.Выбор.Элементы;
	
	ДобавитьВыбранноеПоле(ПоляКомпоновкиДанных, "Период");
	ДобавитьВыбранноеПоле(ПоляКомпоновкиДанных, "Документ");
	ДобавитьВыбранноеПоле(ПоляКомпоновкиДанных, "НомерСтроки");
	
	Если ОборотныйРегистр Тогда
		ДобавитьГруппуПолей(ПоляКомпоновкиДанных, "Оборот", ЭтаФорма.Регистр);
	Иначе
		ДобавитьГруппуПолей(ПоляКомпоновкиДанных, "Приход", ЭтаФорма.Регистр);
		ДобавитьГруппуПолей(ПоляКомпоновкиДанных, "Расход", ЭтаФорма.Регистр);
		ДобавитьГруппуПолей(ПоляКомпоновкиДанных, "Остаток", ЭтаФорма.Регистр);
	КонецЕсли;
	
	Элементы.НастройкаПолей.Видимость = Не ОборотныйРегистр;
	Если Не ОборотныйРегистр и ПерезаполнятьНастройкуПолей Тогда
		
		СхемаНастройкиПолей = Новый СхемаКомпоновкиДанных;
    
	    ЗаполнитьЗначенияСвойств(СхемаНастройкиПолей.ИсточникиДанных.Добавить(), Источник);
		НаборДанныхНастройкиПолей = СхемаНастройкиПолей.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
		НаборДанныхНастройкиПолей.Имя = "Продажи";
		НаборДанныхНастройкиПолей.ИмяОбъекта = "Продажи";
	    НаборДанныхНастройкиПолей.ИсточникДанных = "ЛокальнаяБаза";
		
		МассивТиповДокументов = Новый Массив;
		
		Для каждого МетаданныеДокумент Из Метаданные.Документы Цикл
			Для каждого МетаданныеДокументДвижение Из МетаданныеДокумент.Движения Цикл
				Если МетаданныеДокументДвижение = Метаданные.РегистрыНакопления[Этаформа.Регистр] Тогда
					МассивТиповДокументов.Добавить(Тип("ДокументСсылка." + МетаданныеДокумент.Имя));
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		ДобавитьПолеНабораДанных(НаборДанныхНастройкиПолей, "Период", "Период", Новый ОписаниеТипов("Строка"));
		ДобавитьПолеНабораДанных(НаборДанныхНастройкиПолей, "Документ", "Документ", Новый ОписаниеТипов(МассивТиповДокументов));
		ДобавитьПолеНабораДанных(НаборДанныхНастройкиПолей, "НомерСтроки", "Номер строки", Новый ОписаниеТипов("Число"));
		
		Для каждого РесурсРегистраНакопления Из Метаданные.РегистрыНакопления[Этаформа.Регистр].Ресурсы Цикл
			ДобавитьПолеНабораДанных(НаборДанныхНастройкиПолей, РесурсРегистраНакопления.Имя, РесурсРегистраНакопления.Имя, РесурсРегистраНакопления.Тип);
			ДобавитьПолеРесурса(СхемаНастройкиПолей, РесурсРегистраНакопления, "Остаток");
		КонецЦикла;
		
		НастройкиПолей = СхемаНастройкиПолей.НастройкиПоУмолчанию;
		ДобавитьПоляВГруппировку(НастройкиПолей, "Остаток", "");
		
		АдресСхемыНастройкиПолей = ПоместитьВоВременноеХранилище(СхемаНастройкиПолей, ?(АдресСхемыНастройкиПолей <> "", АдресСхемыНастройкиПолей, УникальныйИдентификатор));
		КомпоновщикНастройкиПолей.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыНастройкиПолей));
		КомпоновщикНастройкиПолей.ЗагрузитьНастройки(НастройкиПолей);
	
	КонецЕсли; 
	
	НоваяГруппировка = НастройкиКомпоновкиДанных.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	НоваяГруппировка.Использование = Истина;
	
	НоваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	НоваяГруппировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));

	//Оформление
	ЭлементОформления = НастройкиКомпоновкиДанных.УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Использование = Истина;
	ЭлементОформления.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	ОтборОформления = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборОформления.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборОформления.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Порядок");
	ОтборОформления.ПравоеЗначение = 2;
	
	ЗначениеОформления = ЭлементОформления.Оформление.Элементы[0]; //цвет фона
	ЗначениеОформления.Значение = ЦветаСтиля.ЦветФонаГруппировкиОтчета1;
	ЗначениеОформления.Использование = Истина;
	ЗначениеОформления = ЭлементОформления.Оформление.Элементы[5]; //шрифт
	ЗначениеОформления.Значение = Новый Шрифт("",8,Истина,Неопределено,Неопределено,Неопределено);
	ЗначениеОформления.Использование = Истина;
	
	ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "Поле");
	ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "Период");
	ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "Порядок");
	ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "Документ");
	ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "НомерСтроки");
	
	ДобавитьГруппуОформляемыхПолей(ЭлементОформления.Поля.Элементы, ЭтаФорма.Регистр, ОборотныйРегистр);
	
	//
	
	АдресСхемыИсполненногоОтчета = ПоместитьВоВременноеХранилище(Схема, ?(АдресСхемыИсполненногоОтчета <> "", АдресСхемыИсполненногоОтчета, УникальныйИдентификатор));
	
	ИсполняемыйКомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыИсполненногоОтчета));
	ИсполняемыйКомпоновщикНастроек.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	
	// #501219 - убираем из доступных полей параметры СКД, т.к. использование в глобальном отборе параметра может вызвать ошибку.
	РаботаСОтчетами.ОбработатьПараметрыСхемыКомпоновкиИДобавитьПараметрыИзКомпоновщика(Схема, ИсполняемыйКомпоновщикНастроек);
	
КонецПроцедуры

//Форма
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	Для каждого МетаданныеРегистрНакопления Из Метаданные.РегистрыНакопления Цикл
		ЭтаФорма.Элементы.Регистр.СписокВыбора.Добавить(МетаданныеРегистрНакопления.Имя, МетаданныеРегистрНакопления.Представление());
		Если ЭтаФорма.Регистр = "" Тогда
			ЭтаФорма.Регистр = МетаданныеРегистрНакопления.Имя;
		КонецЕсли;
	КонецЦикла;
	
	ЭтаФорма.Элементы.МакетОформления.СписокВыбора.Добавить("Основной", "Основной");
	ЭтаФорма.Элементы.МакетОформления.СписокВыбора.Добавить("Яркий", "Яркий");
	ЭтаФорма.Элементы.МакетОформления.СписокВыбора.Добавить("Море", "Море");
	ЭтаФорма.Элементы.МакетОформления.СписокВыбора.Добавить("Арктика", "Арктика");
	ЭтаФорма.Элементы.МакетОформления.СписокВыбора.Добавить("Зеленый", "Зеленый");
	ЭтаФорма.Элементы.МакетОформления.СписокВыбора.Добавить("Античный", "Античный");
	
	Если ЭтаФорма.Параметры["Расшифровка"] = Истина Тогда
		ЭтаФорма.Регистр = ЭтаФорма.Параметры["Регистр"];
		ЭтаФорма.НачалоПериода = ЭтаФорма.Параметры["НачалоПериода"];
		ЭтаФорма.КонецПериода = ЭтаФорма.Параметры["КонецПериода"];
		ЭтаФорма.СчетДоверительногоУправления = ЭтаФорма.Параметры["СчетДоверительногоУправления"];
		
		ИзменитьСхемуКомпоновкиДанных(Истина);
		Для каждого СтрокаОтбора Из ЭтаФорма.Параметры["Отбор"] Цикл
			// Ключ - это имя поля. В имени поля точки удаляются. Следовательно, если хотим сделать отбор на значение через точку, тогда необходимо в доступных искать левое значение, а не ключ.
			Если ЭтаФорма.ИсполняемыйКомпоновщикНастроек.Настройки.ДоступныеПоляОтбора.НайтиПоле(Новый ПолеКомпоновкиДанных(СтрокаОтбора.Значение.ЛевоеЗначение)) <> Неопределено Тогда
				СвойстваОтбора = СтрокаОтбора.Значение;
				ЭлементОтбора = ЭтаФорма.ИсполняемыйКомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение = ЭтаФорма.ИсполняемыйКомпоновщикНастроек.Настройки.ДоступныеПоляОтбора.НайтиПоле(Новый ПолеКомпоновкиДанных(СвойстваОтбора.ЛевоеЗначение)).Поле;
				ЗаполнитьЗначенияСвойств(ЭлементОтбора, СвойстваОтбора, "ВидСравнения, ПравоеЗначение, Использование");
			КонецЕсли;
		КонецЦикла;
		ЭтаФорма.Расшифровка = Истина;
		СтандартнаяОбработка = Ложь;
	Иначе
		ИзменитьСхемуКомпоновкиДанных(Истина);
		ЭтаФорма.Расшифровка = Ложь;
	КонецЕсли;
	
	ПолноправныйПользователь = РаботаСПользователями.ЭтоПолноправныйПользователь();
	ЭтаФорма.Элементы.НастройкиИКомпоновщик.ОтображениеСтраниц = ?(ПолноправныйПользователь, ОтображениеСтраницФормы.ЗакладкиСверху, ОтображениеСтраницФормы.Нет);
	ЭтаФорма.Элементы.КомпоновщикНастройкиПолейНастройкиВыборПеренестиВВыбранныеПоля.Видимость = ПолноправныйПользователь;
	
	РаботаСБухгалтерскимиОтчетамиКлиентСервер.ЗаполнитьСписокВыбораВидПериода(Перечисления.ДоступныеПериодыОтчета.День,
		ЭтаФорма.Элементы.ВидПериода.СписокВыбора, ЭтаФорма.ВидПериода);
	
	УправлениеФормой(ЭтаФорма);
	
	РаботаСОтчетами.ЗаполнитьВариантОтчета(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЭтаФорма.Элементы.НастройкиИКомпоновщик.ТекущаяСтраница = ЭтаФорма.Элементы.Настройки;
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Этаформа.Элементы.Результат, "НеАктуальность");
	Если ЭтаФорма.Расшифровка Тогда
		Сформировать();
	КонецЕсли;
	
КонецПроцедуры

//Расшифровки
&НаСервере
Функция ВернутьЗначениеРасшифровки(Расшифровка)
	
	ДанныеРасшифровкиОбъект = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресДанныхРасшифровки);
	
	ЗначанияПолейРасшифровки = ДанныеРасшифровкиОбъект .Элементы[Расшифровка].ПолучитьПоля();
	Если ЗначанияПолейРасшифровки.Количество() > 1 Тогда
	     Индекс = 1;
	Иначе
	     Индекс = 0;
	 КонецЕсли; 
	 
	ЗначениеРасшифровки = ЗначанияПолейРасшифровки[Индекс].Значение;
	
	Возврат ЗначениеРасшифровки;
	
КонецФункции

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	ЗначениеРасшифровки = ВернутьЗначениеРасшифровки(Расшифровка);
	
	ОткрытьЗначение(ЗначениеРасшифровки);
	
КонецПроцедуры

//Изменяшки
&НаКлиенте
Процедура РегистрПриИзменении(Элемент)
	
	Если ПустаяСтрока(ЭтаФорма.Регистр) Тогда
		ЭтаФорма.Регистр = Элементы.Регистр.СписокВыбора.Получить(0).Значение;
	КонецЕсли;
	
	ИзменитьСхемуКомпоновкиДанных(Истина);
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Этаформа.Элементы.Результат, "НеАктуальность");
	
КонецПроцедуры

&НаКлиенте
Процедура ИсполняемыйКомпоновщикНастроекНастройкиОтборПриИзменении(Элемент)
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Этаформа.Элементы.Результат, "НеАктуальность");
КонецПроцедуры

&НаКлиенте
Процедура ИсполняемыйКомпоновщикНастроекНастройкиЭлементУсловноеОформлениеПриИзменении(Элемент)
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Этаформа.Элементы.Результат, "НеАктуальность");
КонецПроцедуры

&НаКлиенте
Процедура МакетОформленияПриИзменении(Элемент)
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Этаформа.Элементы.Результат, "НеАктуальность");
КонецПроцедуры

//Расчет суммы
&НаКлиенте
Процедура РезультатПриАктивизацииОбласти(Элемент)
	
	Если ТипЗнч(Результат.ВыделенныеОбласти) = Тип("ВыделенныеОбластиТабличногоДокумента") Тогда
		ИнтервалОжидания = ?(ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Низкая, 1, 0.2);
		ПодключитьОбработчикОжидания("Подключаемый_РезультатПриАктивизацииОбластиПодключаемый", ИнтервалОжидания, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_РезультатПриАктивизацииОбластиПодключаемый()
	
	НеобходимоВычислятьНаСервере = Ложь;
	ВычислитьСуммуВыделенныхЯчеекТабличногоДокумента(ПолеСумма, Результат, КэшВыделеннойОбласти, НеобходимоВычислятьНаСервере);
	
	Если НеобходимоВычислятьНаСервере Тогда
		ВычислитьСуммуВыделенныхЯчеекТабличногоДокументаВКонтекстеНаСервере();
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("Подключаемый_РезультатПриАктивизацииОбластиПодключаемый");
	
КонецПроцедуры

&НаСервере
Процедура ВычислитьСуммуВыделенныхЯчеекТабличногоДокументаВКонтекстеНаСервере()
	
	Сумма = 0;
	Для Каждого КлючИЗначение Из КэшВыделеннойОбласти Цикл
		СтруктураАдресВыделеннойОбласти = КлючИЗначение.Значение;
		Для ИндексСтрока = СтруктураАдресВыделеннойОбласти.Верх По СтруктураАдресВыделеннойОбласти.Низ Цикл
			Для ИндексКолонка = СтруктураАдресВыделеннойОбласти.Лево По СтруктураАдресВыделеннойОбласти.Право Цикл
				Попытка
					Ячейка = Результат.Область(ИндексСтрока, ИндексКолонка, ИндексСтрока, ИндексКолонка);
					Если Ячейка.Видимость = Истина Тогда
						Если Ячейка.СодержитЗначение И ТипЗнч(Ячейка.Значение) = Тип("Число") Тогда
							Сумма = Сумма + Ячейка.Значение;
						ИначеЕсли ЗначениеЗаполнено(Ячейка.Текст) Тогда
							Сумма = Сумма + Число(СтрЗаменить(Ячейка.Текст, " ", ""));
						КонецЕсли;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	КэшВыделеннойОбласти.Вставить("Сумма", Сумма);
	
	ПолеСумма = Сумма;
	
КонецПроцедуры

&НаКлиенте
Функция НеобходимоОбновитьСумму(Результат, КэшВыделеннойОбласти)
	Перем СтруктураАдресВыделеннойОбласти;
	
	ВыделенныеОбласти    = Результат.ВыделенныеОбласти;
	КоличествоВыделенных = ВыделенныеОбласти.Количество();
	
	Если КоличествоВыделенных = 0 Тогда
		КэшВыделеннойОбласти = Новый Структура();
		Возврат Истина;
	КонецЕсли;
	
	ВозвращаемоеЗначение = Ложь;
	Если ТипЗнч(КэшВыделеннойОбласти) <> Тип("Структура") Тогда
		КэшВыделеннойОбласти = Новый Структура();
		ВозвращаемоеЗначение = Истина;
	ИначеЕсли ВыделенныеОбласти.Количество() <> КэшВыделеннойОбласти.Количество() Тогда
		КэшВыделеннойОбласти = Новый Структура();
		ВозвращаемоеЗначение = Истина;
	Иначе
		Для ИндексОбласти = 0 По КоличествоВыделенных - 1 Цикл
			ВыделеннаяОбласть = ВыделенныеОбласти[ИндексОбласти];
			ИмяОбласти = СтрЗаменить(ВыделеннаяОбласть.Имя, ":", "_");
			КэшВыделеннойОбласти.Свойство(ИмяОбласти, СтруктураАдресВыделеннойОбласти);
			
			// не нашли нужную область в кэше, поэтому переинициализируем кэш
			Если ТипЗнч(СтруктураАдресВыделеннойОбласти) <> Тип("Структура") Тогда
				КэшВыделеннойОбласти = Новый Структура();
				ВозвращаемоеЗначение = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для ИндексОбласти = 0 По КоличествоВыделенных - 1 Цикл
		ВыделеннаяОбласть = ВыделенныеОбласти[ИндексОбласти];
		ИмяОбласти = СтрЗаменить(ВыделеннаяОбласть.Имя, ":", "_");
		
		Если ТипЗнч(ВыделеннаяОбласть) <> Тип("ОбластьЯчеекТабличногоДокумента") Тогда
			СтруктураАдресВыделеннойОбласти = Новый Структура("Верх, Низ, Лево, Право", 0, 0, 0, 0);
			КэшВыделеннойОбласти.Вставить(ИмяОбласти, СтруктураАдресВыделеннойОбласти);
			ВозвращаемоеЗначение = Истина;
			Продолжить;
		КонецЕсли;
		
		КэшВыделеннойОбласти.Свойство(ИмяОбласти, СтруктураАдресВыделеннойОбласти);
		Если ТипЗнч(СтруктураАдресВыделеннойОбласти) <> Тип("Структура") Тогда
			СтруктураАдресВыделеннойОбласти = Новый Структура("Верх, Низ, Лево, Право", 0, 0, 0, 0);
			КэшВыделеннойОбласти.Вставить(ИмяОбласти, СтруктураАдресВыделеннойОбласти);
			ВозвращаемоеЗначение = Истина;
		КонецЕсли;
		
		Если СтруктураАдресВыделеннойОбласти.Верх <> ВыделеннаяОбласть.Верх
			ИЛИ СтруктураАдресВыделеннойОбласти.Низ <> ВыделеннаяОбласть.Низ
			ИЛИ СтруктураАдресВыделеннойОбласти.Лево <> ВыделеннаяОбласть.Лево
			ИЛИ СтруктураАдресВыделеннойОбласти.Право <> ВыделеннаяОбласть.Право Тогда
				СтруктураАдресВыделеннойОбласти = Новый Структура("Верх, Низ, Лево, Право",
					ВыделеннаяОбласть.Верх, ВыделеннаяОбласть.Низ, ВыделеннаяОбласть.Лево, ВыделеннаяОбласть.Право);
				КэшВыделеннойОбласти.Вставить(ИмяОбласти, СтруктураАдресВыделеннойОбласти);
				ВозвращаемоеЗначение = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

&НаКлиенте
Процедура ВычислитьСуммуВыделенныхЯчеекТабличногоДокумента(ПолеСумма, Результат, КэшВыделеннойОбласти, НеобходимоВычислятьНаСервере) Экспорт
	
	Если НеобходимоОбновитьСумму(Результат, КэшВыделеннойОбласти) Тогда
		ПолеСумма = 0;
		КоличествоВыделенныхОбластей = КэшВыделеннойОбласти.Количество();
		Если КоличествоВыделенныхОбластей = 0      // Ничего не выделено
			ИЛИ КэшВыделеннойОбласти.Свойство("T") // Выделен весь табличный документ (Ctrl+A)
			Тогда
			КэшВыделеннойОбласти.Вставить("Сумма", 0);
		ИначеЕсли КоличествоВыделенныхОбластей = 1 Тогда
			// Если выделено небольшое количество ячейек, то получим сумму на клиенте
			Для каждого КлючИЗначение Из КэшВыделеннойОбласти Цикл
				СтруктураАдресВыделеннойОбласти = КлючИЗначение.Значение;
			КонецЦикла;
			
			РазмерОбластиПоВертикали   = СтруктураАдресВыделеннойОбласти.Низ   - СтруктураАдресВыделеннойОбласти.Верх;
			РазмерОбластиПоГоризонтали = СтруктураАдресВыделеннойОбласти.Право - СтруктураАдресВыделеннойОбласти.Лево;
			
			// В некоторых отчетах показатели (да и аналитика на котрую может встать пользователь
			// выводятся в "объединенных" ячейках - не желательно в этом случае делать сервереный вызов. 
			// Выделенная область из 10 ячеек закрывает все такие случае и скорее всего всегда будет доступна на клиенте.
			// Максимум, может быть сделан один неявный серверный вызов
			ВычислитьНаКлиенте = (РазмерОбластиПоВертикали + РазмерОбластиПоГоризонтали) < 12;
			Если ВычислитьНаКлиенте Тогда
				СуммаВЯчейках = 0;
				Для ИндексСтрока = СтруктураАдресВыделеннойОбласти.Верх По СтруктураАдресВыделеннойОбласти.Низ Цикл
					Для ИндексКолонка = СтруктураАдресВыделеннойОбласти.Лево По СтруктураАдресВыделеннойОбласти.Право Цикл
						Попытка
							Ячейка = Результат.Область(ИндексСтрока, ИндексКолонка, ИндексСтрока, ИндексКолонка);
							Если Ячейка.Видимость = Истина Тогда
								Если Ячейка.СодержитЗначение И ТипЗнч(Ячейка.Значение) = Тип("Число") Тогда
									СуммаВЯчейках = СуммаВЯчейках + Ячейка.Значение;
								ИначеЕсли ЗначениеЗаполнено(Ячейка.Текст) Тогда
									ЧислоВЯчейке  = Вычислить("Число(СтрЗаменить(Ячейка.Текст, Символ(32), Символ(0)))");
									СуммаВЯчейках = СуммаВЯчейках + ЧислоВЯчейке;
								КонецЕсли;
							КонецЕсли;
						Исключение
						КонецПопытки;
					КонецЦикла;
				КонецЦикла;
				
				ПолеСумма = СуммаВЯчейках;
				КэшВыделеннойОбласти.Вставить("Сумма", ПолеСумма);
			Иначе
				// Если ячеек много, то лучше вычислим сумму ячеек на сервере за один вызов,
				// т.к. неявных серверных вызовов может быть гораздо больше
				НеобходимоВычислятьНаСервере = Истина;
			КонецЕсли;
		Иначе
			// Вычислим сумму ячеек на сервере
			НеобходимоВычислятьНаСервере = Истина;
		КонецЕсли;
	Иначе	
		ПолеСумма = КэшВыделеннойОбласти.Сумма;
	КонецЕсли;
	
КонецПроцедуры

//Настройки
&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)
	
	ДополнительныеСвойства = Новый Структура;
	
	ДополнительныеСвойства.Вставить("МакетОформления",					ЭтаФорма.МакетОформления);
	ДополнительныеСвойства.Вставить("Регистр",							ЭтаФорма.Регистр);
	
	ДополнительныеСвойства.Вставить("НастройкиКомпоновки",				ИсполняемыйКомпоновщикНастроек.ПолучитьНастройки());
	
	Настройки.ДополнительныеСвойства.Вставить("ДанныеОтчета", Новый ХранилищеЗначения(ДополнительныеСвойства));
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки)
	
	Если Настройки.ДополнительныеСвойства.Свойство("ДанныеОтчета") Тогда
		ДополнительныеСвойства = Настройки.ДополнительныеСвойства.ДанныеОтчета.Получить();
		Для Каждого ЭлементСтруктуры Из ДополнительныеСвойства Цикл
			Если ЭлементСтруктуры.Ключ = "МакетОформления" Тогда
				ЭтаФорма.МакетОформления = ЭлементСтруктуры.Значение;
			ИначеЕсли ЭлементСтруктуры.Ключ = "Регистр" Тогда
				ЭтаФорма.Регистр = ЭлементСтруктуры.Значение;
			КонецЕсли;
		КонецЦикла;
		
		ИзменитьСхемуКомпоновкиДанных(Ложь);
		
		Для Каждого ЭлементСтруктуры Из ДополнительныеСвойства Цикл
			Если ЭлементСтруктуры.Ключ = "НастройкиКомпоновки" Тогда
				ЭтаФорма.ИсполняемыйКомпоновщикНастроек.ЗагрузитьНастройки(ЭлементСтруктуры.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НеАктуальность");
	
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

//Вспомогашки
&НаКлиенте
Функция ПолучитьЗапрещенныеПоля(Режим = "") Экспорт
	
	СписокПолей = Новый Массив;
	
	Для Каждого ДоступноеПоле Из ИсполняемыйКомпоновщикНастроек.Настройки.ДоступныеПоляВыбора.Элементы Цикл
		ЭтоРесурс = Найти(ДоступноеПоле.Заголовок, " Конечный остаток") + 
					Найти(ДоступноеПоле.Заголовок, " Начальный остаток") + 
					Найти(ДоступноеПоле.Заголовок, " Оборот") + 
					Найти(ДоступноеПоле.Заголовок, " Приход") + 
					Найти(ДоступноеПоле.Заголовок, " Расход"); 
		Если ЭтоРесурс > 0 Тогда
			СписокПолей.Добавить(Строка(ДоступноеПоле.Поле));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый ФиксированныйМассив(СписокПолей);
	
КонецФункции

&НаСервере
Процедура ПрименитьРучнуюНастройкуПолей()
	
	ИсполняемыйКомпоновщикНастроек.Настройки.Выбор.Элементы.Очистить();
	ЭлементыВыбораИсполняемогоКомпоновщика = ИсполняемыйКомпоновщикНастроек.Настройки.Выбор.Элементы;
	
	ДобавитьГлавныеПоля(ЭлементыВыбораИсполняемогоКомпоновщика, "Документ,Период,НомерСтроки,");
	
	ДобавитьЭлементыВыбора(ЭлементыВыбораИсполняемогоКомпоновщика, "Приход", "Приход");
	ДобавитьЭлементыВыбора(ЭлементыВыбораИсполняемогоКомпоновщика, "Расход", "Расход");
	ДобавитьЭлементыВыбора(ЭлементыВыбораИсполняемогоКомпоновщика, "Остаток", "Остаток");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьГлавныеПоля(ЭлементыВыбораИсполняемогоКомпоновщика, СтрокаПолей);

	ИсточникПолей = КомпоновщикНастройкиПолей.Настройки.Выбор;
	
	Для каждого ЭлементВыбора Из ИсточникПолей.Элементы Цикл
	
		ИмяПоля = Строка(ЭлементВыбора.Поле) + ",";	
		
		Если СтрНайти(СтрокаПолей, ИмяПоля) > 0 Тогда
		
			ВыбранноеПоле = ЭлементыВыбораИсполняемогоКомпоновщика.Добавить(ТипЗнч(ЭлементВыбора));
			ЗаполнитьЗначенияСвойств(ВыбранноеПоле, ЭлементВыбора);
		
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементыВыбора(ЭлементыВыбораИсполняемогоКомпоновщика, Заголовок, Вид)

	НоваяГруппа = ЭлементыВыбораИсполняемогоКомпоновщика.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
	НоваяГруппа.Расположение = РасположениеПоляКомпоновкиДанных.Горизонтально;
	НоваяГруппа.Заголовок = Заголовок;
	
	ЗаполнитьСвойстваПолей(НоваяГруппа, КомпоновщикНастройкиПолей.Настройки.Выбор, Вид);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСвойстваПолей(ПриемникПолей, ИсточникПолей, Вид)

	Для каждого ЭлементВыбора Из ИсточникПолей.Элементы Цикл
		
		Если ТипЗнч(ЭлементВыбора) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") И ЭлементВыбора.Заголовок = "Остаток" Тогда
			ВыбранноеПоле = ПриемникПолей;
		Иначе
			ВыбранноеПоле = ПриемникПолей.Элементы.Добавить(ТипЗнч(ЭлементВыбора));
			ЗаполнитьЗначенияСвойств(ВыбранноеПоле, ЭлементВыбора);
		КонецЕсли; 
		
		Если ТипЗнч(ЭлементВыбора) = Тип("ВыбранноеПолеКомпоновкиДанных") Тогда
			ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(Строка(ЭлементВыбора.Поле) + Вид);
		ИначеЕсли ТипЗнч(ЭлементВыбора) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
			ЗаполнитьСвойстваПолей(ВыбранноеПоле, ЭлементВыбора, Вид);
		КонецЕсли; 
		
	КонецЦикла;	

КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	ИзменитьСхемуКомпоновкиДанных(Истина, Ложь);
	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НеАктуальность");
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВВыбранныеПоля(Команда)
		
	ПрименитьРучнуюНастройкуПолей();

КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если НачалоПериода > КонецПериода Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата начала периода не может быть больше даты конца периода!", , "НачалоПериода",,Отказ);
	КонецЕсли;
	
КонецПроцедуры
