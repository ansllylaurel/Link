&НаСервере
Процедура ДобавитьВыбранноеПоле(КоллекцияПолей, ИмяПоля)

	ВыбранноеПолеКомпоновкиДанных = КоллекцияПолей.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПолеКомпоновкиДанных.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);

КонецПроцедуры

&НаСервере
Процедура ДобавитьГруппуПолей(ПоляКомпоновкиДанных, Заголовок, ИмяРегистра)

	ЕстьКоличество = Ложь;
	Для каждого РесурсРегистраНакопления Из Метаданные.РегистрыНакопления[Этаформа.Регистр].Ресурсы Цикл
		Если РесурсРегистраНакопления.Имя = "Количество" Тогда
			ЕстьКоличество = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ВерхняяГруппа = ПоляКомпоновкиДанных.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
	ВерхняяГруппа.Заголовок = Заголовок;
	Если ЕстьКоличество Тогда
		ВерхняяГруппа.Расположение = РасположениеПоляКомпоновкиДанных.Горизонтально;
	Иначе
		ВерхняяГруппа.Расположение = РасположениеПоляКомпоновкиДанных.Вертикально;
	КонецЕсли;
	
	Если ЕстьКоличество Тогда
		ВыбранноеПоле = ВерхняяГруппа.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("Количество" + Заголовок);
		ВыбранноеПоле.Заголовок = "Количество";
		
		ГруппаСуммы = ВерхняяГруппа.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
		ГруппаСуммы.Заголовок = "Суммы";
		ГруппаСуммы.Расположение = РасположениеПоляКомпоновкиДанных.Вертикально;
	Иначе
		ГруппаСуммы = ВерхняяГруппа;
	КонецЕсли;
	
	Для каждого РесурсРегистраНакопления Из Метаданные.РегистрыНакопления[Этаформа.Регистр].Ресурсы Цикл
		Если РесурсРегистраНакопления.Имя = "Количество" Тогда
			Продолжить;
		КонецЕсли;
		ВыбранноеПоле = ГруппаСуммы.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(РесурсРегистраНакопления.Имя + Заголовок);
		ВыбранноеПоле.Заголовок = РесурсРегистраНакопления.Синоним;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОформляемоеПоле(КоллекцияПолей, ИмяПоля)

	ПолеОформления = КоллекцияПолей.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);

КонецПроцедуры

&НаСервере
Процедура ДобавитьГруппуОформляемыхПолей(КоллекцияПолей, ИмяРегистра, ОборотныйРегистр)

	Для каждого РесурсРегистраНакопления Из Метаданные.РегистрыНакопления[Этаформа.Регистр].Ресурсы Цикл
		Если ОборотныйРегистр Тогда
			ДобавитьОформляемоеПоле(КоллекцияПолей, РесурсРегистраНакопления.Имя + "Оборот");
		Иначе
			ДобавитьОформляемоеПоле(КоллекцияПолей, РесурсРегистраНакопления.Имя + "Приход");
			ДобавитьОформляемоеПоле(КоллекцияПолей, РесурсРегистраНакопления.Имя + "Расход");
			ДобавитьОформляемоеПоле(КоллекцияПолей, РесурсРегистраНакопления.Имя + "Остаток");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьПолеРесурса(Схема, РесурсРегистраНакопления, ВидРесурса)
	Поле = Схема.ПоляИтога.Добавить();
	Поле.Выражение = "Сумма("+РесурсРегистраНакопления.Имя + ВидРесурса + ")";
	Поле.ПутьКДанным = РесурсРегистраНакопления.Имя+ВидРесурса;
КонецПроцедуры

&НаСервере
Процедура ДобавитьПоляВГруппировку(НоваяГруппировка, Заголовок, Вид)

	ВыбранноеПоле = НоваяГруппировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Заголовок = "Период";
	ВыбранноеПоле.Использование = Истина;
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("Период" + Вид);
	
	ВыбранноеПоле = НоваяГруппировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Заголовок = "Документ";
	ВыбранноеПоле.Использование = Истина;
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("Документ" + Вид);
	
	ВыбранноеПоле = НоваяГруппировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Заголовок = "Номер строки";
	ВыбранноеПоле.Использование = Истина;
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("НомерСтроки" + Вид);
	
	Если Этаформа.Регистр = "БухПартииЦенныхБумаг" Тогда
		
		НоваяГруппа = НоваяГруппировка.Выбор.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
		НоваяГруппа.Расположение = РасположениеПоляКомпоновкиДанных.Горизонтально;
		НоваяГруппа.Заголовок = Заголовок;
		
		//Заголовок охеренно ВАЖЕН!!!!!!!!
		//СКДшка (сука-тварь-гадина) сливает группы колонок с одинаковым заголовком!!! 
		//Охренеть! 0_0
		
		НоваяГруппаКолво = НоваяГруппа.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
		НоваяГруппаКолво.Расположение = РасположениеПоляКомпоновкиДанных.Вертикально;
		НоваяГруппаКолво.Заголовок = " ";  //Тут 1 пробел!!!
		
		НоваяГруппаСуммы = НоваяГруппа.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
		НоваяГруппаСуммы.Расположение = РасположениеПоляКомпоновкиДанных.Вертикально;
		НоваяГруппаСуммы.Заголовок = "  "; //Тут 2 пробела!!!
		
		НоваяГруппаСуммыКупона = НоваяГруппа.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
		НоваяГруппаСуммыКупона.Расположение = РасположениеПоляКомпоновкиДанных.Вертикально;
		НоваяГруппаСуммыКупона.Заголовок = "   "; //Тут 3 пробела!!!
		//*********************
		ВыбранноеПоле = НоваяГруппаКолво.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПоле.Заголовок = "Количество";
		ВыбранноеПоле.Использование = Истина;
		ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("Количество" + Вид);
		
		ВыбранноеПоле = НоваяГруппаКолво.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПоле.Заголовок = "Расходы при покупке в стоимости";
		ВыбранноеПоле.Использование = Истина;
		ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("РасходыПриПокупкеВСтоимости" + Вид);
		
		ВыбранноеПоле = НоваяГруппаКолво.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
