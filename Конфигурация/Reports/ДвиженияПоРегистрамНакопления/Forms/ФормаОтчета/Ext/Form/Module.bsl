&НаСервере
Процедура УстановитьПараметрВывода(ИсполняемыйКомпоновщикНастроек, Параметр, Значение)

	ЗначениеПараметра = ИсполняемыйКомпоновщикНастроек.Настройки.ПараметрыВывода.Элементы.Найти(Параметр); 
	ЗначениеПараметра.Использование = Истина; 
	ЗначениеПараметра.Значение = Значение;

КонецПроцедуры

&НаСервере
Процедура УстановитьПараметр(ИсполняемыйКомпоновщикНастроек, Параметр, Значение)

	ЗначениеПараметра = ИсполняемыйКомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти(Параметр); 
	ЗначениеПараметра.Использование = Истина; 
	ЗначениеПараметра.Значение = Значение;

КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	
	Перем ДанныеРасшифровкиОбъект;
	
	Механизм = "Отчет.ДвиженияПоРегистрамНакопления.Форма.СформироватьНаСервере()";
	ДопПараметрыВыполнения = Новый Структура("Период,Организация,СчетДоверительногоУправления,Регистр");
	ЗаполнитьЗначенияСвойств(ДопПараметрыВыполнения, ЭтаФорма);
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(РеквизитФормыВЗначение("Отчет"),, ДопПараметрыВыполнения);
	
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ОборотныйРегистр = (Метаданные.РегистрыНакопления[ЭтаФорма.Регистр].ВидРегистра =  Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Обороты);
	
	СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСхемыИсполненногоОтчета);
	
    //2.1 определяем структуру 
	//ИсполняемыйКомпоновщикНастроек.Настройки.Структура.Очистить();
	//
	//ПоляКомпоновкиДанных = ИсполняемыйКомпоновщикНастроек.Настройки.Выбор.Элементы;
	//ДобавитьВыбранноеПоле(ПоляКомпоновкиДанных, "Поле");
	//ДобавитьВыбранноеПоле(ПоляКомпоновкиДанных, "Регистратор");
	//ДобавитьВыбранноеПоле(ПоляКомпоновкиДанных, "НомерСтроки");
	//
	//ДобавитьГруппуПолей(ПоляКомпоновкиДанных, "Приход", ЭтаФорма.Регистр);
	//ДобавитьГруппуПолей(ПоляКомпоновкиДанных, "Расход", ЭтаФорма.Регистр);
	//ДобавитьГруппуПолей(ПоляКомпоновкиДанных, "Остаток", ЭтаФорма.Регистр);
	//
	//НоваяГруппировка = ИсполняемыйКомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	//НоваяГруппировка.Использование = Истина;
	//
	//НоваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	//НоваяГруппировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	
	//4. Параметры
	УстановитьПараметр(ИсполняемыйКомпоновщикНастроек, "НП", НачалоДня(ЭтаФорма.НачалоПериода));
	//УстановитьПараметр(ИсполняемыйКомпоновщикНастроек, "НачалоПериода", НачалоДня(ЭтаФорма.ВыборПериода.ДатаНачала));
	УстановитьПараметр(ИсполняемыйКомпоновщикНастроек, "КП", КонецДня(ЭтаФорма.КонецПериода));
	УстановитьПараметр(ИсполняемыйКомпоновщикНастроек, "Организация", ЭтаФорма.Организация);
	Если НЕ ЭтаФорма.СчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПустаяСсылка() Тогда
		УстановитьПараметр(ИсполняемыйКомпоновщикНастроек, "СчетДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления);
	КонецЕсли;
	
	Если НЕ ЭтаФорма.МакетОформления = "" Тогда
		УстановитьПараметрВывода(ИсполняемыйКомпоновщикНастроек, "МакетОформления", ЭтаФорма.МакетОформления);
	КонецЕсли;
	
	Если НЕ ОборотныйРегистр Тогда
	
		ПрименитьРучнуюНастройкуПолей();
	
	КонецЕсли; 
	//"РасположениеРеквизитов"
	
	
    //3. готовим макет 
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ДанныеРасшифровкиОбъект = Новый ДанныеРасшифровкиКомпоновкиДанных;
	ДанныеРасшифровкиОбъект.Настройки = ИсполняемыйКомпоновщикНастроек.ПолучитьНастройки();
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, ИсполняемыйКомпоновщикНастроек.ПолучитьНастройки(), ДанныеРасшифровкиОбъект);
	АдресСхемыИсполненногоОтчета = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, ?(АдресСхемыИсполненногоОтчета <> "", АдресСхемыИсполненногоОтчета, УникальныйИдентификатор));
	
	//4. исполняем макет 
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных, , ДанныеРасшифровкиОбъект, Ложь);
	
    //5. выводим результат 
	Результат.Очистить();
	ПроцессорВыводаРезультатаОтчета = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВыводаРезультатаОтчета.УстановитьДокумент(Результат);
	ПроцессорВыводаРезультатаОтчета.НачатьВывод();
	ПроцессорВыводаРезультатаОтчета.Вывести(ПроцессорКомпоновкиДанных);
	ПроцессорВыводаРезультатаОтчета.ЗакончитьВывод();
	
	// Заполняем настройки печати	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(Результат, РеквизитФормыВЗначение("Отчет").Метаданные().ПолноеИмя());	
	
	Если ДанныеРасшифровкиОбъект <> Неопределено Тогда
		АдресДанныхРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровкиОбъект, УникальныйИдентификатор);
	КонецЕсли;
	
	//Элементы.ИсполняемыйКомпоновщикНастроекНастройки.ТекущаяСтрока = ИсполняемыйКомпоновщикНастроек.Настройки.ПолучитьИдентификаторПоОбъекту(ИсполняемыйКомпоновщикНастроек.Настройки.Структура[0]);
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать()
	
	ОчиститьСообщения();
	
	Если ПроверитьЗаполнение() Тогда
		СформироватьНаСервере();
		РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НеИспользовать");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВернутьПоля(Регистр, ИмяТаблицы, Вариант, ПорядокПП, ОборотныйРегистр, ДетализацияПоСтратегии, ДетализацияПоКлиенту, ДетализацияПоСчетуДУ) //Вариант: 1-остатки на начало, 2 - остатки на конец и обороты, 3 - для итоговой таблицы

	Поля = Символы.ПС;	

	Если Вариант <> 3 Тогда
		
		Для каждого ИзмерениеРегистраНакопления Из Метаданные.РегистрыНакопления[Регистр].Измерения Цикл
			Если ИзмерениеРегистраНакопления.Имя = "Организация" ИЛИ ИзмерениеРегистраНакопления.Имя = "Клиент" Тогда
				Продолжить;
			ИначеЕсли ИзмерениеРегистраНакопления.Имя = "СчетДоверительногоУправления" Тогда
				Продолжить;
			КонецЕсли;
			Поля = Поля + Символы.Таб + ИмяТаблицы + "." + ИзмерениеРегистраНакопления.Имя + "," + Символы.ПС;
		КонецЦикла;
		
		Если ДетализацияПоСчетуДУ Тогда
			Поля = Поля + Символы.Таб + ИмяТаблицы + ".СчетДоверительногоУправления КАК СчетДоверительногоУправления," + Символы.ПС;
		ИначеЕсли ДетализацияПоКлиенту Тогда
			Поля = Поля + Символы.Таб + "КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент," + Символы.ПС;
		ИначеЕсли ДетализацияПоСтратегии Тогда
			Поля = Поля + Символы.Таб + "СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия КАК Стратегия," + Символы.ПС;
		КонецЕсли;
		
	КонецЕсли;
	
	Для каждого РесурсРегистраНакопления Из Метаданные.РегистрыНакопления[Этаформа.Регистр].Ресурсы Цикл
		Если Вариант = 1 Тогда
			Если ОборотныйРегистр Тогда
				Поля = Поля + Символы.Таб + ИмяТаблицы + "." + РесурсРегистраНакопления.Имя + "Оборот," + Символы.ПС;
			Иначе
				Поля = Поля + Символы.Таб + ИмяТаблицы + "." + РесурсРегистраНакопления.Имя + "Остаток," + Символы.ПС + 
							  Символы.Таб + "0 КАК " + РесурсРегистраНакопления.Имя + "Приход," + Символы.ПС +
							  Символы.Таб + "0 КАК " + РесурсРегистраНакопления.Имя + "Расход," + Символы.ПС;
			КонецЕсли;
		ИначеЕсли Вариант = 2 Тогда
			Если ОборотныйРегистр Тогда
				Поля = Поля + Символы.Таб + ИмяТаблицы + "." + РесурсРегистраНакопления.Имя + "Оборот," + Символы.ПС;
			Иначе
				Поля = Поля + Символы.Таб + ИмяТаблицы + "." + РесурсРегистраНакопления.Имя + "КонечныйОстаток КАК " + РесурсРегистраНакопления.Имя + "Остаток," + Символы.ПС + 
							  Символы.Таб + ИмяТаблицы + "." + РесурсРегистраНакопления.Имя + "Приход," + Символы.ПС + 
							  Символы.Таб + ИмяТаблицы + "." + РесурсРегистраНакопления.Имя + "Расход," + Символы.ПС;
			КонецЕсли;
		ИначеЕсли Вариант = 3 Тогда
			Если ОборотныйРегистр Тогда
				Поля = Поля + Символы.Таб + ИмяТаблицы + "." + РесурсРегистраНакопления.Имя + "Оборот," + Символы.ПС;
			Иначе
				Поля = Поля + Символы.Таб + ИмяТаблицы + "." + РесурсРегистраНакопления.Имя + "Остаток," + Символы.ПС + 
							  Символы.Таб + ИмяТаблицы + "." + РесурсРегистраНакопления.Имя + "Приход," + Символы.ПС + 
							  Символы.Таб + ИмяТаблицы + "." + РесурсРегистраНакопления.Имя + "Расход," + Символы.ПС;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если Вариант = 3 Тогда
		Если ДетализацияПоСчетуДУ Тогда
			Поля = Поля + Символы.Таб + ИмяТаблицы + ".СчетДоверительногоУправления КАК СчетДоверительногоУправления," + Символы.ПС;
		ИначеЕсли ДетализацияПоКлиенту Тогда
			Поля = Поля + Символы.Таб + ИмяТаблицы + ".Клиент КАК Клиент," + Символы.ПС;
		ИначеЕсли ДетализацияПоСтратегии Тогда
			Поля = Поля + Символы.Таб + ИмяТаблицы + ".Стратегия КАК Стратегия," + Символы.ПС;
		КонецЕсли;
	КонецЕсли;
	
	Если Вариант <> 3 Тогда
		Поля = Поля + Символы.Таб + Строка(ПорядокПП) + " КАК Порядок," + Символы.ПС;
		Если ПорядокПП = 1 Тогда
			Поля = Поля + Символы.Таб + """Сальдо на начало"" КАК Поле," + Символы.ПС +
						  Символы.Таб + "ДОБАВИТЬКДАТЕ(&НП,Секунда,-1) КАК Период," + Символы.ПС + 
						  Символы.Таб + "ЗНАЧЕНИЕ(Документ.МНО.ПустаяСсылка) КАК Регистратор," + Символы.ПС + 
						  Символы.Таб + "0 КАК НомерСтроки" + Символы.ПС;
		ИначеЕсли ПорядокПП = 2 Тогда
			Поля = Поля + Символы.Таб + ИмяТаблицы + ".Период КАК Поле," + Символы.ПС +
						  Символы.Таб + ИмяТаблицы + ".Период КАК Период," + Символы.ПС +
						  Символы.Таб + ИмяТаблицы + ".Регистратор КАК Регистратор," + Символы.ПС + 
						  Символы.Таб + ИмяТаблицы + ".НомерСтроки" + Символы.ПС;
		ИначеЕсли ПорядокПП = 3 Тогда
			Поля = Поля + Символы.Таб + """Сальдо на конец"" КАК Поле," + Символы.ПС +
						  Символы.Таб + "ДОБАВИТЬКДАТЕ(&КП,Секунда,1) КАК Период," + Символы.ПС + 
						  Символы.Таб + "ЗНАЧЕНИЕ(Документ.МНО.ПустаяСсылка) КАК Регистратор," + Символы.ПС + 
						  Символы.Таб + "0 КАК НомерСтроки" + Символы.ПС;
		КонецЕсли;
	Иначе
		Поля = Поля + Символы.Таб + ИмяТаблицы + ".Порядок," + Символы.ПС + 
					  Символы.Таб + ИмяТаблицы + ".Поле КАК Период," + Символы.ПС + 
					  Символы.Таб + ИмяТаблицы + ".Период КАК Период1," + Символы.ПС + 
					  Символы.Таб + ИмяТаблицы + ".Регистратор КАК Документ," + Символы.ПС + 
					  Символы.Таб + ИмяТаблицы + ".НомерСтроки" + Символы.ПС;
	КонецЕсли;
	
	Возврат Поля;
	
КонецФункции

