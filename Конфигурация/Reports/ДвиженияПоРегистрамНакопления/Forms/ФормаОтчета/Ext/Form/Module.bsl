				Символы.ПС + "ПО " + ИмяРегистра + ?(ОборотныйРегистр, "", "ОстаткиИ") + "Обороты.СчетДоверительногоУправления = СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления" + Символы.ПС, "") +
