&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	ФормаИсточник = ПараметрыВыполненияКоманды.Источник; 
	
	// Вызвано из формы объекта
	Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(ФормаИсточник, "Объект") Тогда
		Анкета			= ФормаИсточник.Объект;	
		ЗаголовокФормы	= Анкета.ЮрФизЛицо;
		АнкетаСсылка	= Неопределено;
		
	// Вызвано из списка по ссылке
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ПолеСуществует(ФормаИсточник, "Список") Тогда
		Анкета			= ПараметрыВыполненияКоманды.Источник.Элементы.Список.ТекущаяСтрока;
		ЗаголовокФормы	= Анкета;
		АнкетаСсылка	= Анкета;
	КонецЕсли;
	
	// Форма с нестандартными именами реквизитов
	Если Анкета = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обработка команды для текущей формы не реализована.");
		Возврат;
	КонецЕсли;
	
	// Получаем различия
	АдресТаблицыРазличий = ПолучитьРазличияНаСервере(Анкета, ФормаИсточник.УникальныйИдентификатор);
	Если АдресТаблицыРазличий = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресТаблицыРазличий", АдресТаблицыРазличий);
	ПараметрыФормы.Вставить("Заголовок", ЗаголовокФормы);
	ПараметрыФормы.Вставить("Анкета", Анкета);
	
	ПараметрыЗакрытия = Новый Структура;
	ПараметрыЗакрытия.Вставить("ФормаИсточник", ФормаИсточник);
	ПараметрыЗакрытия.Вставить("Анкета", АнкетаСсылка);
	
	// Открываем форму различий
	ОткрытьФорму(
		"Отчет.СверкаАнкетныхДанныхКлиентовСДаннымиГруппыКомпаний.Форма.ФормаРазличий",
		ПараметрыФормы,
		ПараметрыВыполненияКоманды.Источник,
		,
		,
		,
		Новый ОписаниеОповещения("ПриЗакрытииОкнаРазличий", ЭтотОбъект, ПараметрыЗакрытия),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
	);
КонецПроцедуры

&НаСервере
Функция ПолучитьРазличияНаСервере(Анкета, Знач УникальныйИдентификатор)
	СверкаАнкетныхДанных = Отчеты.СверкаАнкетныхДанныхКлиентовСДаннымиГруппыКомпаний.Создать();
	СверкаАнкетныхДанных.Организация = ПараметрыСеанса.ТекущаяОрганизация;
	
	Различия = СверкаАнкетныхДанных.ПолучитьРазличия(Анкета);
	
	Возврат ?(Различия = Неопределено, Неопределено, ПоместитьВоВременноеХранилище(Различия, УникальныйИдентификатор));
КонецФункции

&НаКлиенте
Процедура ПриЗакрытииОкнаРазличий(Результат, ДополнительныеПараметры) Экспорт
	Перем Анкета;	
	
	Если Результат <> Неопределено Тогда
		ДополнительныеПараметры.Свойство("Анкета", Анкета);
		
		// Вызвано по ссылке
		Если Анкета<>Неопределено И ЭтоСсылкаНаДокумент(ТипЗнч(Анкета)) Тогда
			СкорректироватьАнкетуНаСервере(Анкета, Результат);
			
		// Вызвано из формы объекта
		Иначе
			ФормаИсточник	= ДополнительныеПараметры.ФормаИсточник;
			Анкета			= ФормаИсточник.Объект;
			
			Для Каждого СтрокаРазличия Из Результат Цикл
				Анкета[СтрокаРазличия.Реквизит] = СтрокаРазличия.ЗначениеГК;		
			КонецЦикла;
			
			ФормаИсточник.Модифицированность = Истина;
			
			Оповестить("ПриЗакрытииОкнаРазличий",, ФормаИсточник);
			
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СкорректироватьАнкетуНаСервере(Анкета, ТаблицаРазличий) Экспорт
	АнкетаОбъект = Анкета.ПолучитьОбъект();

	Для Каждого СтрокаРазличия Из ТаблицаРазличий Цикл
		АнкетаОбъект[СтрокаРазличия.Реквизит] = СтрокаРазличия.ЗначениеГК;		
	КонецЦикла;

	АнкетаОбъект.Записать();
КонецПроцедуры

&НаСервере
Функция ЭтоСсылкаНаДокумент(ТипЗначения)
	Возврат Документы.ТипВсеСсылки().СодержитТип(ТипЗначения);
КонецФункции