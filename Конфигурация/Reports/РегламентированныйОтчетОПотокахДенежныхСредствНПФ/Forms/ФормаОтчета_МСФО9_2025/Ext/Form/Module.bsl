&НаСервере 
Функция ВернутьКурсовыеРазницы(Запрос, ИмяРаздела)
	
	Если ИмяРаздела = "ФинансоваяДеятельность2025" Тогда  
		НомСтр = """49""";
		СтрокаГФУ = """37201"", ""37202"", ""37203"", ""37204"", ""37205"", ""37206"", ""47201"", ""47202"", ""47203"", ""47204"", ""47205"", ""47206""";
	ИначеЕсли ИмяРаздела = "ОперационнаяДеятельность2025" Тогда	
		НомСтр = """08""";
		СтрокаГФУ = """37101"", ""37102"", ""37103"", ""37104"", ""37105"", ""37106"", ""47101"", ""47102"", ""47103"", ""47104"", ""47105"", ""47106""";
	КонецЕсли;	
	
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&НомСтр КАК НомерСтроки,
		|	""02"" КАК НомерКолонки,
		|	ЕдиныйБухгалтерскийУчетОбороты.Счет КАК Счет,
		|	-ЕдиныйБухгалтерскийУчетОбороты.СуммаОборот КАК Сумма,
		|	ЕдиныйБухгалтерскийУчетОбороты.КорСчет КАК КорСчет
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Период,
		|			Счет В (ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыОтОпераций11), ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыОтОпераций12)),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1.Код В (&СтрокаГФУ)
		|				И НЕ КорСубконто2 В (&ВидДвиженийКомиссии),
		|			КорСчет В (&СчетаДС),
		|			) КАК ЕдиныйБухгалтерскийУчетОбороты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	&НомСтр,
		|	""03"",
		|	ЕдиныйБухгалтерскийУчетОбороты.Счет,
		|	-ЕдиныйБухгалтерскийУчетОбороты.СуммаОборот,
		|	ЕдиныйБухгалтерскийУчетОбороты.КорСчет
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(
		|			&НачалоПредыдущегоПериода,
		|			&КонецПредыдущегоПериода,
		|			Период,
		|			Счет В (ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыОтОпераций11), ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыОтОпераций12)),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1.Код В (&СтрокаГФУ)
		|				И НЕ КорСубконто2 В (&ВидДвиженийКомиссии),
		|			КорСчет В (&СчетаДС),
		|			) КАК ЕдиныйБухгалтерскийУчетОбороты";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СтрокаГФУ", СтрокаГФУ);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НомСтр", НомСтр);

	СчетаДС = Новый Массив;
	СчетаДС.Добавить(ПланыСчетов.Единый.РасчетныеСчета01);
	Если ЭтаФорма.НастройкиОтчета.УчитыватьБрокерскиеСчетаВДС <> Неопределено И ЭтаФорма.НастройкиОтчета.УчитыватьБрокерскиеСчетаВДС Тогда
		СчетаДС.Добавить(ПланыСчетов.Единый.РасчетыСБрокерами02);	
	КонецЕсли;	

	ВидДвиженийКомиссии = Новый Массив;  
	ВидДвиженийКомиссии.Добавить(Справочники.ВидыДвиженияДенежныхСредств.БрокерскаяКомиссияПокупка);
	ВидДвиженийКомиссии.Добавить(Справочники.ВидыДвиженияДенежныхСредств.БрокерскаяКомиссияПродажа);
	ВидДвиженийКомиссии.Добавить(Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияПокупка);
	ВидДвиженийКомиссии.Добавить(Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияПродажа);
	
	Запрос.УстановитьПараметр("Организация", СтруктураРеквизитовФормы.Организация);
	Запрос.УстановитьПараметр("СчетаДС", СчетаДС);
	Запрос.УстановитьПараметр("ВидДвиженийКомиссии", ВидДвиженийКомиссии);

