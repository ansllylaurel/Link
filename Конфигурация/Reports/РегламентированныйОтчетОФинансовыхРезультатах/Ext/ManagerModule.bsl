Функция СформироватьСписокРазделовОтчета(ИмяФормы, НКО = Ложь, ДатаФормирования = '20000101') Экспорт
		// #491182 унификация вызовов функции формирования списка разделов отчета

	СписокРазделов = Новый СписокЗначений;
	
	ВыбраннаяФорма = СтрЗаменить(ИмяФормы, "Отчет.РегламентированныйОтчетОФинансовыхРезультатах.Форма.", "");
	
	Если ВыбраннаяФорма = "ФормаОтчета_МСФО39" Тогда
		#Область МСФО39
		СписокРазделов.Добавить("ОтчетТитульнаяСтраница", 						"Отчет о финансовых результатах");
		СписокРазделов.Добавить("ДоходыЗаВычетомРасходов", 						"Примечание 39.1");
		СписокРазделов.Добавить("ПроцентныеДоходы", 							"Примечание 42.1");
		СписокРазделов.Добавить("ПрочиеИнвестиционныеДоходыЗаВычетомРасходов",	"Примечание 43.1");
		СписокРазделов.Добавить("ОбщиеИАдминистративныеРасходы", 				"Примечание 44.1");
		СписокРазделов.Добавить("ПрочиеДоходы", 								"Примечание 46.1");
		СписокРазделов.Добавить("ПрочиеРасходы",								"Примечание 46.2");
		#КонецОбласти
	ИначеЕсли ВыбраннаяФорма = "ФормаОтчета_МСФО39_2017" Тогда
		#Область МСФО39_2017
