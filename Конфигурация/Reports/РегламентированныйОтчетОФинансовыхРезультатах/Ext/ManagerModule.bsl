Функция ПолучитьСтруктуруПараметров(ИмяФормы) Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("мВыбраннаяФорма");
	Результат.Вставить("мРедакцияФормы");
	Результат.Вставить("мСкопированаФорма");
	Результат.Вставить("мСохраненныйДок");
	Результат.Вставить("мДатаНачалаПериодаОтчета");
	Результат.Вставить("мДатаКонцаПериодаОтчета");
	Результат.Вставить("мЗаписываетсяНовыйДокумент");
	Результат.Вставить("мБезОткрытияФормы");
	Результат.Вставить("мРежимПечати");
	Результат.Вставить("мПредставлениеТекущегоПериода");
	Результат.Вставить("мПредставлениеПредыдущегоПериода");
	Результат.Вставить("мДатаНачалаПрошлогоПериодаОтчета");
	Результат.Вставить("мДатаКонцаПрошлогоПериодаОтчета");
	Результат.Вставить("мДатаНачалаПоследнегоКвартала");
