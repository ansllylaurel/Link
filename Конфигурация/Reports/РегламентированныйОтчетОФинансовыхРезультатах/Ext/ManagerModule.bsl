		Результат.Вставить("ДатаНачалаПрошлогоПериодаОтчетаСУчетомРеформации"); 
		Результат.Вставить("ДатаНачалаПоследнегоКварталаПрошлогоПериодаОтчетаСУчетомРеформации");
		Если ВыбраннаяФорма = "ФормаОтчета_МСФО9_СК_2025" Тогда
			Результат.Вставить("ВидДеятельностиОрганизации");
		КонецЕсли;
