Функция ПолучитьСписокРазделовПредыдущегоГода(ИмяФормы, НКО = Ложь)	Экспорт
	
	Результат = Новый СписокЗначений;
	
	ВыбраннаяФорма = СтрЗаменить(ИмяФормы, "Отчет.РегламентированныйОтчетОФинансовыхРезультатах.Форма.", "");
	
	Если ВыбраннаяФорма = "ФормаОтчета_МСФО39" Тогда    
		Результат.Добавить("ДоходыЗаВычетомРасходов", 					"Примечание 39.1");
	ИначеЕсли ВыбраннаяФорма = "ФормаОтчета_МСФО9" Тогда     
		Результат.Добавить("ДоходыЗаВычетомРасходов", 					"Примечание 42.1");
	ИначеЕсли ВыбраннаяФорма = "ФормаОтчета_МСФО9_2020" Тогда
		Результат.Добавить("ДоходыЗаВычетомРасходов", 					"Примечание 41.1");
	ИначеЕсли ВыбраннаяФорма = "ФормаОтчета_МСФО39_2017" Тогда  
		Результат.Добавить("ДоходыЗаВычетомРасходов2017", 				"Примечание 42.1");
	ИначеЕсли ВыбраннаяФорма = "ФормаОтчета_МСФО39_СК" Тогда
		Результат.Добавить("ДоходыЗаВычетомРасходов2017", 				"Примечание 50.1");
	ИначеЕсли ВыбраннаяФорма = "ФормаОтчета_МСФО9_2017" Тогда
		Результат.Добавить("ДоходыЗаВычетомРасходов2017", 				"Примечание 42.1");
	ИначеЕсли ВыбраннаяФорма = "ФормаОтчета_МСФО39_СК_2020" Тогда
		Результат.Добавить("ДоходыЗаВычетомРасходов2017", 				"Примечание 50.1");
	ИначеЕсли ВыбраннаяФорма = "ФормаОтчета_МСФО39_2020" Тогда
		Результат.Добавить("ДоходыЗаВычетомРасходов2017", 				"Примечание 39.1");
	ИначеЕсли ВыбраннаяФорма = "ФормаОтчета_МСФО39_2024" Тогда 
		Результат.Добавить("ДоходыЗаВычетомРасходов2024", 				"Примечание 39.1");
	ИначеЕсли ВыбраннаяФорма = "ФормаОтчета_МСФО9_2024" Тогда	
		Результат.Добавить("ДоходыЗаВычетомРасходов2024", 				"Примечание 42.1"); 
	ИначеЕсли ВыбраннаяФорма = "ФормаОтчета_МСФО39_СК_2020" Тогда
		Результат.Добавить("ДоходыЗаВычетомРасходов2024", 				"Примечание 50.1");		
	ИначеЕсли ВыбраннаяФорма = "ФормаОтчета_МСФО9_2025" Тогда	
		//непонятно что брать. Форма ДоходыЗаВычетомРасходов2024 сильно поменялась. 
		//и теперь нет отчета за последний квартал 
	ИначеЕсли ВыбраннаяФорма = "ФормаОтчета_МСФО9_СК_2025" Тогда
		// аналогично. 
	КонецЕсли;
	
	Возврат Результат;
	
