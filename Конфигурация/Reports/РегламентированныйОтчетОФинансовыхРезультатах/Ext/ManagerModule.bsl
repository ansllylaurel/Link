	Результат.Вставить("НестандартныйПериод");
	
	ВыбраннаяФорма = СтрЗаменить(ИмяФормы, "Отчет.РегламентированныйОтчетОФинансовыхРезультатах.Форма.", "");
	
	Если ВыбраннаяФорма = "ФормаОтчета_МСФО39_СК" 
		ИЛИ ВыбраннаяФорма = "ФормаОтчета_МСФО39_СК_2020"  
		ИЛИ ВыбраннаяФорма = "ФормаОтчета_МСФО39_СК_2024" Тогда
		Результат.Вставить("ВидДеятельностиОрганизации");
	ИначеЕсли ВыбраннаяФорма = "ФормаОтчета_МСФО9_2025" 
		ИЛИ ВыбраннаяФорма = "ФормаОтчета_МСФО9_СК_2025" Тогда
		Результат.Вставить("мПредставлениеПоследнегоКварталаТекущегоПериода");
