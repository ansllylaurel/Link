	ТекСтрока.ТабличныйДокумент = ТекРаздел;
	
	РасчетРаздела_ПроцентныеРасходы(ТекСтрока.ТабличныйДокумент, ИмяРаздела);

КонецПроцедуры


#КонецОбласти 

