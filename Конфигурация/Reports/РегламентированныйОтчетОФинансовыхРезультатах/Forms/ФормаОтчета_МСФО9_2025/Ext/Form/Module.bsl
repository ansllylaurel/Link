			ЗаполнитьРазделПоСпискуСчетовЗаПоследнийКварталОтчетныйИПредыдущийПериоды(Запрос, "Оборот", ТекРаздел, "01", КолонкаТП, КолонкаПП, , , , СтруктураПеременныхДляОтбора.ВидыДоходовРасходовНФО);
			
			мТаблицаСчетов.Очистить();
			мВидыДоходовРасходовНФО = Новый Массив;
			мВидыДоходовРасходовНФО.Добавить("47101");
