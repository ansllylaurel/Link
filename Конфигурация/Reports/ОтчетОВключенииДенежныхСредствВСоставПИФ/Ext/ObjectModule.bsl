
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	// Фиксируем запуск процедуры
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,ПаевойИнвестиционныйФонд"); 
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя();
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ДокументРезультат.Очистить();
	Запрос = Новый Запрос;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
	|ПОМЕСТИТЬ _КлиентыДоверительногоУправления
	|ИЗ
	|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&КонецПериода, Клиент = &ПаевойИнвестиционныйФонд) КАК КлиентыДоверительногоУправленияСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА &ОтборПоЗачислению
	|			ТОГДА ДолиПайщиковВИнвестиционномФонде.Регистратор.Заявка.Дата
	|		ИНАЧЕ ДенежныеСредстваПереданныеВОплатуПаевОбороты.Регистратор.Основание.Дата
	|	КОНЕЦ КАК ДатаЗаявки,
	|	ВЫБОР
	|		КОГДА &ОтборПоЗачислению
	|			ТОГДА ДолиПайщиковВИнвестиционномФонде.Регистратор.Заявка
	|		ИНАЧЕ ДенежныеСредстваПереданныеВОплатуПаевОбороты.Регистратор.Основание
	|	КОНЕЦ КАК Заявка,
	|	ЕСТЬNULL(РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество, РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу) КАК Пайщик,
	|	ДолиПайщиковВИнвестиционномФонде.Регистратор КАК ДокументЗачисления,
	|	ДенежныеСредстваПереданныеВОплатуПаевОбороты.СуммаРасход КАК Сумма,
	|	ДенежныеСредстваПереданныеВОплатуПаевОбороты.Период КАК ДатаЗачисления
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваПереданныеВОплатуПаев.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Регистратор,
	|			СчетДоверительногоУправления В
	|				(ВЫБРАТЬ
	|					_КлиентыДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления
	|				ИЗ
	|					_КлиентыДоверительногоУправления КАК _КлиентыДоверительногоУправления)) КАК ДенежныеСредстваПереданныеВОплатуПаевОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ДолиПайщиковВИнвестиционномФонде КАК ДолиПайщиковВИнвестиционномФонде
	|		ПО (ДолиПайщиковВИнвестиционномФонде.Пайщик = ДенежныеСредстваПереданныеВОплатуПаевОбороты.Пайщик)
	|			И (ДолиПайщиковВИнвестиционномФонде.Организация = ДенежныеСредстваПереданныеВОплатуПаевОбороты.Организация)
	|			И (ВЫРАЗИТЬ(ДолиПайщиковВИнвестиционномФонде.Регистратор КАК Документ.ЗачислениеПаев).ПоступлениеДенежныхСредств = ДенежныеСредстваПереданныеВОплатуПаевОбороты.Регистратор)
	|			И (ДолиПайщиковВИнвестиционномФонде.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))
	|			И (ДолиПайщиковВИнвестиционномФонде.Организация = &Организация)
	|			И (ДолиПайщиковВИнвестиционномФонде.ПаевойИнвестиционныйФонд = &ПаевойИнвестиционныйФонд)
	|			И (ДолиПайщиковВИнвестиционномФонде.Регистратор ССЫЛКА Документ.ЗачислениеПаев)
	|			И &УсловиеПоРегистратору
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
	|				&КонецПериода,
	|				Организация = &Организация
	|					И Язык = &Язык) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
	|		ПО ДенежныеСредстваПереданныеВОплатуПаевОбороты.Пайщик = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
	|				&КонецПериода,
	|				Организация = &Организация
	|					И Язык = &Язык) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
	|		ПО ДенежныеСредстваПереданныеВОплатуПаевОбороты.Пайщик = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЗаявки,
	|	Пайщик
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Если ЗначениеЗаполнено(ЗачислениеПаев) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И &УсловиеПоРегистратору", "И ДолиПайщиковВИнвестиционномФонде.Регистратор = &ЗачислениеПаев");
		Запрос.УстановитьПараметр("ОтборПоЗачислению", Истина);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И &УсловиеПоРегистратору", "");	
		Запрос.УстановитьПараметр("ОтборПоЗачислению", Ложь);
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Период));
	Запрос.УстановитьПараметр("КонецПериода",  КонецДня(Период));
	
	Запрос.УстановитьПараметр("Подразделение", Справочники.Подразделения.ГруппаКомпаний);
	Запрос.УстановитьПараметр("Язык", Справочники.Языки.Русский);
	
	Запрос.УстановитьПараметр("ПаевойИнвестиционныйФонд", ПаевойИнвестиционныйФонд);
	Запрос.УстановитьПараметр("Организация",              Организация);
	Запрос.УстановитьПараметр("ЗачислениеПаев",           ЗачислениеПаев);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Макет = ПолучитьМакет("Макет");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Период = Период;
	ОбластьШапка.Параметры.ПаевойИнвестиционныйФонд = ПаевойИнвестиционныйФонд;
	
	ДокументРезультат.Вывести(ОбластьШапка);
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	Сч = 1;
	Пока Выборка.Следующий() Цикл
		
		ОбластьСтрока.Параметры.Заполнить(Выборка);
		ОбластьСтрока.Параметры.НомерСтроки = Сч;
		
		ДокументРезультат.Вывести(ОбластьСтрока);
		
		Сч = Сч + 1;
		
	КонецЦикла;
	
	// Подписи	
	СтруктураДанныхКонтактногоЛица = Неопределено;
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхКонтактногоЛица", СтруктураДанныхКонтактногоЛица);
	
	ПараметрыВыводаПодписей = Новый Структура;
	ПараметрыВыводаПодписей.Вставить("ИмяОбласти", "ПодписиБухгалтерскихОтчетовЕПС");
	ПараметрыВыводаПодписей.Вставить("ДатаФормирования", Формат(ТекущаяДата(), "ДФ='dd ММММ yyyy ""г.""'"));
	
	Если ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица) Тогда
		ПараметрыВыводаПодписей.Вставить("ФИОРуководителя", СтруктураДанныхКонтактногоЛица.КонтактноеЛицо);
		ОснованиеПолномочий = ?(ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий), " (на основании " + СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий + ")", "");
		ПараметрыВыводаПодписей.Вставить("ДолжностьРуководителя", СтруктураДанныхКонтактногоЛица.Должность + ОснованиеПолномочий);	
	КонецЕсли; 
	
	РаботаСОтчетами.ВывестиПодписи(ДокументРезультат, ПараметрыВыводаПодписей);		
	
	//ДокументРезультат.Вывести(Макет.ПолучитьОбласть("Подвал"));
	
	// Заполняем настройки печати	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументРезультат, ЭтотОбъект.Метаданные().ПолноеИмя());
	
	// Фиксируем завершение процедуры
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);

КонецПроцедуры