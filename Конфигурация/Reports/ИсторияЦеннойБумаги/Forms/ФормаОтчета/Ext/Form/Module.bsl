
&НаСервере
Процедура ПриОткрытииНаСервере()
	
	СкомпоноватьРезультат();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НовыйЭлемент = Элементы.Добавить("Организация", Тип("ПолеФормы"), Элементы.Параметры);
	НовыйЭлемент.ПутьКДанным		= "Отчет.Организация";
	
	Если РаботаСПользователями.ЭтоПолноправныйПользователь() Тогда
		НовыйЭлемент.Вид				= ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Лево;
	Иначе
		НовыйЭлемент.Вид				= ВидПоляФормы.ПолеНадписи;
		НовыйЭлемент.Гиперссылка		= Истина;
		НовыйЭлемент.ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Нет;
	КонецЕсли;
	
	Если ЭтаФорма.Параметры.Свойство("ЦеннаяБумага") Тогда
		Отчет.ЦеннаяБумага = ЭтаФорма.Параметры.ЦеннаяБумага;
	КонецЕсли;
	
	Если ЭтаФорма.Параметры.Свойство("СчетДоверительногоУправления") Тогда
		Отчет.СчетДоверительногоУправления = ЭтаФорма.Параметры.СчетДоверительногоУправления;
	КонецЕсли;
	
	Отчет.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(Отчет.Период) Тогда
		ПриОткрытииНаСервере();
	КонецЕсли;
	
КонецПроцедуры