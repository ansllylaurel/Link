		|		ИНАЧЕ ЕСТЬNULL(_ПеречниОбъектов.ВидПеречня, ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ПустаяСсылка))
		|	КОНЕЦ КАК Сектор,
		|	_ТаблицаДокумента.КодСтроки КАК КодСтроки,
		|	_ТаблицаДокумента.НачальныйОстатокРуб КАК НачальныйОстатокРуб,
		|	_ТаблицаДокумента.НачальныйОстатокВал КАК НачальныйОстатокВал,
		|	_ТаблицаДокумента.Приход КАК Приход,
		|	_ТаблицаДокумента.Расход КАК Расход,
		|	_ТаблицаДокумента.Переоценка КАК Переоценка,
		|	_ТаблицаДокумента.Иное КАК Иное,
		|	_ТаблицаДокумента.КонечныйОстатокРуб КАК КонечныйОстатокРуб,
		|	_ТаблицаДокумента.КонечныйОстатокВал КАК КонечныйОстатокВал,
		|	_ТаблицаДокумента.Раздел КАК Раздел,
		|	_ТаблицаДокумента.ЮрФизЛицо В
		|		(ВЫБРАТЬ
		|			_ОрганыГосударственногоУправления.ЮрФизЛицо
		|		ИЗ
		|			_ОрганыГосударственногоУправления КАК _ОрганыГосударственногоУправления) КАК ГосОрган
		|ИЗ
		|	_ТаблицаДокумента КАК _ТаблицаДокумента
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПеречниОбъектов КАК _ПеречниОбъектов
		|		ПО _ТаблицаДокумента.ЮрФизЛицо = _ПеречниОбъектов.Объект
		|			И (НЕ _ПеречниОбъектов.Объект В
		|					(ВЫБРАТЬ
		|						_ОрганизацииВходящиеВНесколькоСекторов.Объект
		|					ИЗ
		|						_ОрганизацииВходящиеВНесколькоСекторов КАК _ОрганизацииВходящиеВНесколькоСекторов))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ИнвестиционныеФонды КАК _ИнвестиционныеФонды
		|		ПО _ТаблицаДокумента.ЮрФизЛицо = _ИнвестиционныеФонды.Объект
		|			И (НЕ _ИнвестиционныеФонды.Объект В
		|					(ВЫБРАТЬ
		|						_ОрганизацииВходящиеВНесколькоФондов.Объект
		|					ИЗ
		|						_ОрганизацииВходящиеВНесколькоФондов КАК _ОрганизацииВходящиеВНесколькоФондов))";
		
	Запрос.УстановитьПараметр("ТаблицаДокумента", ТаблицаДокумента);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода); 
	
	// #384614 - хардкод по задаче: согласно приказу росстата считаем в регламентированной отчетности росавтодор и роснано госорганизациями и их бумаги госбумагами
	Запрос.УстановитьПараметр("ЮрФизЛицо_Автодор", ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Автодор")); 
	Запрос.УстановитьПараметр("ЮрФизЛицо_РОСНАНО", ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_РОСНАНО")); 
	
	
	ТаблицаДокумента = Запрос.Выполнить().Выгрузить();
				
КонецПроцедуры
 
&НаСервере
Процедура ЗаполнитьРаздел_ДенежныеСредстваНаСчетахУправляющегоСервер(Запрос, ТаблицаМногострочныйРаздел, ОтчетСНачалаГода)
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РезервПереходНаМСФО9.СчетУчета КАК СчетУчета,
		|	_РезервПереходНаМСФО9.Актив КАК Актив,
		|	СУММА(_РезервПереходНаМСФО9.Приход) КАК Приход,
		|	СУММА(_РезервПереходНаМСФО9.Расход) КАК Расход,
		|	СУММА(_РезервПереходНаМСФО9.Иное) КАК Иное
		|ПОМЕСТИТЬ _РезервПереход
		|ИЗ
		|	_РезервПереходНаМСФО9 КАК _РезервПереходНаМСФО9
		|ГДЕ
		|	_РезервПереходНаМСФО9.СчетУчета = ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетныеСчета05)
		|
		|СГРУППИРОВАТЬ ПО
		|	_РезервПереходНаМСФО9.СчетУчета,
		|	_РезервПереходНаМСФО9.Актив
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА &УчитыватьМНОкакПроценты
		|				И ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет В (ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетныеСчета07), ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетныеСчета08))
		|			ТОГДА 34
		|		ИНАЧЕ 5
		|	КОНЕЦ КАК КодСтроки,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто1 КАК Актив,
		|	Банки.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет КАК СчетУчета,
		|	ВЫБОР
		|		КОГДА &ОтчетСНачалаГода
		|				И (ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный
		|						И ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Валюта = ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Организация.ВалютаУчета
		|					ИЛИ НЕ ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный)
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК НачальныйОстатокРуб,
		|	ВЫБОР
		|		КОГДА &ОтчетСНачалаГода
		|				И (ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный
		|					И ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Валюта <> ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Организация.ВалютаУчета)
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК НачальныйОстатокВал,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетныеСчета05)
		|			ТОГДА 0
		|		ИНАЧЕ ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаОборотДт
		|	КОНЕЦ КАК Приход,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетныеСчета05)
		|			ТОГДА 0
		|		ИНАЧЕ ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаОборотКт
		|	КОНЕЦ КАК Расход,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетныеСчета05)
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ + ЕСТЬNULL(_РезервПереход.Иное, 0) КАК Переоценка,
		|	ВЫБОР
		|		КОГДА НЕ &ОтчетСНачалаГода
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ - ЕСТЬNULL(_РезервПереход.Иное, 0) КАК Иное,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный
		|					И ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Валюта = ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Организация.ВалютаУчета
		|				ИЛИ НЕ ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КонечныйОстатокРуб,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный
		|				И ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Валюта <> ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Организация.ВалютаУчета
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КонечныйОстатокВал,
		|	РеквизитыЮридическихЛицСрезПоследних.РезидентРФ КАК Резидент,
		|	ВЫБОР
		|		КОГДА &УчитыватьМНОкакПроценты
		|				И ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет В (ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетныеСчета07), ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетныеСчета08))
		|			ТОГДА ""НачисленныеПроцентыПоДепозитам""
		|		ИНАЧЕ ""ДенежныеСредства""
		|	КОНЕЦ КАК Раздел
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&грКонецПериода,
		|			,
		|			,
		|			Счет В ИЕРАРХИИ (&Счет),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Банки КАК Банки
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|					&КонецПериода,
		|					Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|			ПО Банки.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ПО (ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто1 КАК Справочник.БанковскиеСчета).Банк = Банки.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РезервПереход КАК _РезервПереход
		|		ПО ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто1 = _РезервПереход.Актив
		|			И ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет = _РезервПереход.СчетУчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _РезервПереход";
		
	Если СтруктураРеквизитовФормы.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		Запрос.УстановитьПараметр("Счет", ПланыСчетов.Единый.РасчетныеСчета);	
	Иначе
		Запрос.УстановитьПараметр("Счет", ПланыСчетов.Основной.РасчетныеСчета);	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕдиныйБухгалтерскийУчет", "БухгалтерскийУчет");
	КонецЕсли; 	
	
	Запрос.УстановитьПараметр("УчитыватьМНОкакПроценты", ?(ЭтаФорма.НастройкиОтчета.УчитыватьМНОкакПроцентыПоДепозитам = ИСТИНА, ИСТИНА, ЛОЖЬ));  
    Запрос.УстановитьПараметр("ОтчетСНачалаГода", ОтчетСНачалаГода);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(ТаблицаМногострочныйРаздел.Добавить(), Выборка);
	
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаздел_ДепозитыСервер(Запрос, ТаблицаМногострочныйРаздел, ОтчетСНачалаГода)
	
