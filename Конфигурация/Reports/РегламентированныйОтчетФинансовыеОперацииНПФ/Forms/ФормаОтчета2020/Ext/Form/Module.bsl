&НаСервере
Процедура ЗаполнитьРаздел_МногострочныйРазделСервер()
	
	ИмяРаздела = "МногострочныйРазделТаблица";
	
	ЭтаФорма.МногострочныйРаздел.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", 	СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета);	
	Запрос.УстановитьПараметр("грКонецПериода", Новый Граница(КонецДня(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонецПериода", 	СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета);
	Запрос.УстановитьПараметр("Организация", 	СтруктураРеквизитовФормы.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СтруктураРеквизитовФормы.СчетДоверительногоУправления);
	
	СчетаУчетаЦенныхБумаг = КонсолидированнаяОтчетность.ПолучитьСчетаУчетаЦенныхБумаг();
	
	Запрос.УстановитьПараметр("СчетаДолговых", СчетаУчетаЦенныхБумаг.СчетаДолговых);
	Запрос.УстановитьПараметр("СчетаДолевых", СчетаУчетаЦенныхБумаг.СчетаДолевых);
	Запрос.УстановитьПараметр("СчетаПереоценкиДолговых", СчетаУчетаЦенныхБумаг.СчетаПереоценкиДолговых);
	Запрос.УстановитьПараметр("СчетаПереоценкиДолевых", СчетаУчетаЦенныхБумаг.СчетаПереоценкиДолевых);
	Запрос.УстановитьПараметр("СчетаКорректировкиДолговых", СчетаУчетаЦенныхБумаг.СчетаКорректировкиДолговых);
	Запрос.УстановитьПараметр("СчетаКорректировкиДолевых", СчетаУчетаЦенныхБумаг.СчетаКорректировкиДолевых);
	
	Запрос.УстановитьПараметр("СчетаРезервовДолевых", СчетаУчетаЦенныхБумаг.СчетаРезервовДолевых);
	Запрос.УстановитьПараметр("СчетаРезервовДолговых", СчетаУчетаЦенныхБумаг.СчетаРезервовДолговых);
	
	ТаблицаМногострочныйРаздел = ЭтаФорма.МногострочныйРаздел.Выгрузить().СкопироватьКолонки();    
	
	Если СтруктураРеквизитовФормы.НестандартныйПериод И СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета <> НачалоГода(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета) Тогда 
		ОтчетСНачалаГода = Ложь;
	Иначе
		ОтчетСНачалаГода = Истина;
	КонецЕсли; 
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц; 
	
	ПодготовитьВременныеТаблицыПереходаНаМСФО9(Запрос);
	
	ЗаполнитьРаздел_ДенежныеСредстваНаСчетахУправляющегоСервер(Запрос, ТаблицаМногострочныйРаздел, ОтчетСНачалаГода);
	
	ЗаполнитьРаздел_ДепозитыСервер(Запрос, ТаблицаМногострочныйРаздел, ОтчетСНачалаГода);
	
	ЗаполнитьРаздел_ДолговыеЦенныеБумагиСервер(Запрос, ТаблицаМногострочныйРаздел, ОтчетСНачалаГода);
	
	ЗаполнитьРаздел_ДолевыеЦенныеБумагиСервер(Запрос, ТаблицаМногострочныйРаздел, ОтчетСНачалаГода);
	
	ЗаполнитьРаздел_ДенежныеСредстваУБрокеровСервер(Запрос, ТаблицаМногострочныйРаздел, ОтчетСНачалаГода);

	ЗаполнитьРаздел_НачисленныеПроцентыПоДепозитамСервер(Запрос, ТаблицаМногострочныйРаздел, ОтчетСНачалаГода);
	
	ЗаполнитьРаздел_КупонныйДоходСервер(Запрос, ТаблицаМногострочныйРаздел, ОтчетСНачалаГода);
	
	ЗаполнитьРаздел_ДебиторскаяЗадолженностьСервер(Запрос, ТаблицаМногострочныйРаздел, ОтчетСНачалаГода);
	
	ЗаполнитьРаздел_ПенсионныеРезервыНакопленияСервер(Запрос, ТаблицаМногострочныйРаздел, ОтчетСНачалаГода);
	
	ЗаполнитьРаздел_ДругиеОбязательстваСервер(Запрос, ТаблицаМногострочныйРаздел, ОтчетСНачалаГода);
	
	ЗаполнитьРаздел_НераспределеннаяПрибыльУбытокСервер(Запрос, ТаблицаМногострочныйРаздел);
	
	ЗаполнитьСектора(ТаблицаМногострочныйРаздел);
	
	КодыСтрок = ПолучитьТаблицуКодыСтрок();
		
	Для каждого ТекСтрока Из ТаблицаМногострочныйРаздел Цикл
	
		ТекСтрока.КодСтроки = ПолучитьКодСтроки(ТекСтрока, КодыСтрок, СтруктураРеквизитовФормы.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления);
	
	КонецЦикла; 
	
	ТаблицаМногострочныйРаздел.Сортировать("КодСтроки, ЮрФизЛицо, Актив");
		
	ЭтаФорма.МногострочныйРаздел.Загрузить(ТаблицаМногострочныйРаздел);
	
КонецПроцедуры

&НаСервере 
Процедура ПодготовитьВременныеТаблицыПереходаНаМСФО9(Запрос)
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДвиженияРезерв.СчетУчета КАК СчетУчета,
		|	ДвиженияРезерв.КорСчет КАК КорСчет,
		|	ДвиженияРезерв.Актив КАК Актив,
		|	ДвиженияРезерв.КорАктив КАК КорАктив,
		|	ДвиженияРезерв.Приход КАК Приход,
		|	ДвиженияРезерв.Расход КАК Расход,
		|	ДвиженияРезерв.Иное КАК Иное
		|ПОМЕСТИТЬ _РезервПереходНаМСФО9
		|ИЗ
		|	(ВЫБРАТЬ
		|		ЕдиныйБухгалтерскийУчет.СчетКт КАК СчетУчета,
		|		ЕдиныйБухгалтерскийУчет.СчетДт КАК КорСчет,
		|		ВЫБОР
		|			КОГДА ЕдиныйБухгалтерскийУчет.СчетКт = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты15)
		|				ТОГДА ЕдиныйБухгалтерскийУчет.ЛицевойСчетКт.Субконто2
		|			КОГДА ЕдиныйБухгалтерскийУчет.СчетКт = ЗНАЧЕНИЕ(ПланСчетов.Единый.ПрочиеСредства17)
		|				ТОГДА ЕдиныйБухгалтерскийУчет.ЛицевойСчетКт.Субконто2
		|			КОГДА ЕдиныйБухгалтерскийУчет.СчетКт = ЗНАЧЕНИЕ(ПланСчетов.Единый.СчетаДляКлиринга10)
		|				ТОГДА НЕОПРЕДЕЛЕНО
		|			ИНАЧЕ ЕдиныйБухгалтерскийУчет.ЛицевойСчетКт.Субконто1
		|		КОНЕЦ КАК Актив,
		|		ЕдиныйБухгалтерскийУчет.ЛицевойСчетДт.Субконто1 КАК КорАктив,
		|		ЕдиныйБухгалтерскийУчет.Сумма КАК Приход,
		|		0 КАК Расход,
		|		ЕдиныйБухгалтерскийУчет.Сумма КАК Иное
		|	ИЗ
		|		РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет КАК ЕдиныйБухгалтерскийУчет
		|	ГДЕ
		|		ЕдиныйБухгалтерскийУчет.Организация = &Организация
		|		И ЕдиныйБухгалтерскийУчет.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|		И ЕдиныйБухгалтерскийУчет.СчетДт = ЗНАЧЕНИЕ(ПланСчетов.Единый.АктивыВДУ03)
		|		И ЕдиныйБухгалтерскийУчет.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|		И ЕдиныйБухгалтерскийУчет.Активность
		|		И ЕдиныйБухгалтерскийУчет.Регистратор В
		|				(ВЫБРАТЬ
		|					НачислениеСписаниеРезервов.Ссылка КАК Ссылка
		|				ИЗ
		|					Документ.НачислениеСписаниеРезервов КАК НачислениеСписаниеРезервов
		|				ГДЕ
		|					НачислениеСписаниеРезервов.ПереходНаМСФО9
		|					И НачислениеСписаниеРезервов.Организация = &Организация
		|					И НачислениеСписаниеРезервов.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И НАЧАЛОПЕРИОДА(НачислениеСписаниеРезервов.Дата, ДЕНЬ) = &НачалоПериода
		|					И НачислениеСписаниеРезервов.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ЕдиныйПланСчетов))
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
