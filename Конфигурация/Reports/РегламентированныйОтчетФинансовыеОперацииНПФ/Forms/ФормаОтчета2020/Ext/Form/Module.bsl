		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО _ИтоговаяТаблица.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|
		|СГРУППИРОВАТЬ ПО
		|	_ИтоговаяТаблица.ЮрФизЛицо,
		|	_ИтоговаяТаблица.Актив,
		|	РеквизитыЮридическихЛицСрезПоследних.РезидентРФ,
		|	_ИтоговаяТаблица.КодСтроки,
		|	_ИтоговаяТаблица.Раздел,
		|	_ИтоговаяТаблица.СчетУчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _РезервПереход
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ИтоговаяТаблица";
		
	Запрос.УстановитьПараметр("НКДначисленныйКакДолговые", ?(ЭтаФорма.НастройкиОтчета.НКДначисленныйКакДолговые = ИСТИНА, ИСТИНА, ЛОЖЬ));
	Запрос.УстановитьПараметр("НКДпогашенныйНеКупонныйДоход", ?(ЭтаФорма.НастройкиОтчета.НКДпогашенныйНеКупонныйДоход = ИСТИНА, ИСТИНА, ЛОЖЬ));
	Запрос.УстановитьПараметр("НКДУплаченныйКакКупонныйДоход", ?(ЭтаФорма.НастройкиОтчета.НКДУплаченныйКакКупонныйДоход = ИСТИНА, ИСТИНА, ЛОЖЬ));
	Запрос.УстановитьПараметр("ОтчетСНачалаГода", ОтчетСНачалаГода);
	
	Выборка = Запрос.Выполнить().Выбрать();    
		
	Пока Выборка.Следующий() Цикл
	
		ЗаполнитьЗначенияСвойств(ТаблицаМногострочныйРаздел.Добавить(), Выборка);
	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаздел_ДолевыеЦенныеБумагиСервер(Запрос, ТаблицаМногострочныйРаздел, ОтчетСНачалаГода)
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	0 КАК КодСтроки,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто1 КАК Актив,
		|	ЕСТЬNULL(Эмитенты.ЮрФизЛицо, РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо) КАК ЮрФизЛицо,
		|	ВЫБОР
		|		КОГДА &ОтчетСНачалаГода
		|				И (ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный
		|						И ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Валюта = ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Организация.ВалютаУчета
		|					ИЛИ НЕ ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный)
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК НачальныйОстатокРуб,
		|	ВЫБОР
		|		КОГДА &ОтчетСНачалаГода
		|				И (ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный
		|					И ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Валюта <> ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Организация.ВалютаУчета)
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК НачальныйОстатокВал,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет В (&СчетаРезервовДолевых)
		|			ТОГДА 0
		|		ИНАЧЕ ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаОборотДт
		|	КОНЕЦ КАК Приход,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет В (&СчетаРезервовДолевых)
		|			ТОГДА 0
		|		ИНАЧЕ ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаОборотКт
		|	КОНЕЦ КАК Расход,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет В (&СчетаРезервовДолевых)
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Переоценка,
		|	ВЫБОР
		|		КОГДА НЕ &ОтчетСНачалаГода
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Иное,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный
		|					И ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Валюта = ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Организация.ВалютаУчета
		|				ИЛИ НЕ ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КонечныйОстатокРуб,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный
		|				И ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Валюта <> ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Организация.ВалютаУчета
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КонечныйОстатокВал,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет КАК СчетУчета
		|ПОМЕСТИТЬ _ИтоговаяТаблица
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&грКонецПериода,
		|			,
		|			,
		|			Счет В (&СчетаДолевых, &СчетаРезервовДолевых),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|		ПО (ВЫБОР
		|				КОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто1 КАК Справочник.Акции) ССЫЛКА Справочник.Акции
		|					ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто1 КАК Справочник.Акции).Эмитент = Эмитенты.Ссылка
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&КонецПериода, ) КАК РеквизитыПИФСрезПоследних
		|		ПО (ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто1 КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	0,
		|	ЕдиныйБухгалтерскийУчетОбороты.Субконто1,
		|	ЕСТЬNULL(Эмитенты.ЮрФизЛицо, РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо),
		|	0,
		|	0,
		|	-ЕдиныйБухгалтерскийУчетОбороты.СуммаОборотДт,
		|	-ЕдиныйБухгалтерскийУчетОбороты.СуммаОборотКт,
		|	ЕдиныйБухгалтерскийУчетОбороты.СуммаОборот,
		|	0,
		|	0,
		|	0,
		|	ЕдиныйБухгалтерскийУчетОбороты.Счет
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(
		|			&НачалоПериода,
		|			&грКонецПериода,
		|			,
		|			Счет В (&СчетаПереоценкиДолевых),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления,
		|			КорСчет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыОтОпераций)),
		|			) КАК ЕдиныйБухгалтерскийУчетОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|		ПО (ВЫБОР
		|				КОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОбороты.Субконто1 КАК Справочник.Акции) ССЫЛКА Справочник.Акции
		|					ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОбороты.Субконто1 КАК Справочник.Акции).Эмитент = Эмитенты.Ссылка
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&КонецПериода, ) КАК РеквизитыПИФСрезПоследних
		|		ПО (ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОбороты.Субконто1 КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИтоговаяТаблица.КодСтроки КАК КодСтроки,
		|	_ИтоговаяТаблица.Актив КАК Актив,
		|	_ИтоговаяТаблица.СчетУчета КАК СчетУчета,
		|	_ИтоговаяТаблица.ЮрФизЛицо КАК ЮрФизЛицо,
		|	СУММА(_ИтоговаяТаблица.НачальныйОстатокРуб) КАК НачальныйОстатокРуб,
		|	СУММА(_ИтоговаяТаблица.НачальныйОстатокВал) КАК НачальныйОстатокВал,
		|	СУММА(_ИтоговаяТаблица.Приход) КАК Приход,
		|	СУММА(_ИтоговаяТаблица.Расход) КАК Расход,
		|	СУММА(_ИтоговаяТаблица.Переоценка) КАК Переоценка,
		|	СУММА(_ИтоговаяТаблица.Иное) КАК Иное,
		|	СУММА(_ИтоговаяТаблица.КонечныйОстатокРуб) КАК КонечныйОстатокРуб,
		|	СУММА(_ИтоговаяТаблица.КонечныйОстатокВал) КАК КонечныйОстатокВал,
		|	РеквизитыЮридическихЛицСрезПоследних.РезидентРФ КАК Резидент,
		|	""Долевые"" КАК Раздел
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&КонецПериода,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО _ИтоговаяТаблица.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|
		|СГРУППИРОВАТЬ ПО
		|	РеквизитыЮридическихЛицСрезПоследних.РезидентРФ,
		|	_ИтоговаяТаблица.ЮрФизЛицо,
		|	_ИтоговаяТаблица.Актив,
		|	_ИтоговаяТаблица.КодСтроки,
		|	_ИтоговаяТаблица.СчетУчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ИтоговаяТаблица";
	
	Запрос.УстановитьПараметр("ОтчетСНачалаГода", ОтчетСНачалаГода);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		ЗаполнитьЗначенияСвойств(ТаблицаМногострочныйРаздел.Добавить(), Выборка);
	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаздел_ДенежныеСредстваУБрокеровСервер(Запрос, ТаблицаМногострочныйРаздел, ОтчетСНачалаГода)
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РезервПереходНаМСФО9.СчетУчета КАК СчетУчета,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_РезервПереходНаМСФО9.Актив) = ТИП(Справочник.ДоговорыБрокерскогоОбслуживания)
		|			ТОГДА ВЫРАЗИТЬ(_РезервПереходНаМСФО9.Актив КАК Справочник.ДоговорыБрокерскогоОбслуживания).Контрагент
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК ЮрФизЛицо,
		|	СУММА(_РезервПереходНаМСФО9.Приход) КАК Приход,
		|	СУММА(_РезервПереходНаМСФО9.Расход) КАК Расход,
		|	СУММА(_РезервПереходНаМСФО9.Иное) КАК Иное
		|ПОМЕСТИТЬ _РезервПереход
		|ИЗ
		|	_РезервПереходНаМСФО9 КАК _РезервПереходНаМСФО9
		|ГДЕ
		|	_РезервПереходНаМСФО9.СчетУчета В (ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСБрокерами07), ЗНАЧЕНИЕ(ПланСчетов.Единый.СчетаДляКлиринга10))
		|
		|СГРУППИРОВАТЬ ПО
		|	_РезервПереходНаМСФО9.СчетУчета,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_РезервПереходНаМСФО9.Актив) = ТИП(Справочник.ДоговорыБрокерскогоОбслуживания)
		|			ТОГДА ВЫРАЗИТЬ(_РезервПереходНаМСФО9.Актив КАК Справочник.ДоговорыБрокерскогоОбслуживания).Контрагент
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	0 КАК КодСтроки,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто1 КАК Актив,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет КАК СчетУчета,
		|	РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ВЫБОР
		|		КОГДА &ОтчетСНачалаГода
		|				И (ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный
		|						И ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Валюта = ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Организация.ВалютаУчета
		|					ИЛИ НЕ ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный)
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК НачальныйОстатокРуб,
		|	ВЫБОР
		|		КОГДА &ОтчетСНачалаГода
		|				И (ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный
		|					И ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Валюта <> ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Организация.ВалютаУчета)
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК НачальныйОстатокВал,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСБрокерами07)
		|			ТОГДА 0
		|		ИНАЧЕ ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаОборотДт
		|	КОНЕЦ КАК Приход,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСБрокерами07)
		|			ТОГДА 0
		|		ИНАЧЕ ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаОборотКт
		|	КОНЕЦ КАК Расход,
		|	ВЫБОР
