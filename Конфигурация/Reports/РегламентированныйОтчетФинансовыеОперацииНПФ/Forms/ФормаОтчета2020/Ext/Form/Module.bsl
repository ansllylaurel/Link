			ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П270" + СтрНомКол, ТекРаздел, "П276" + СтрНомКол, 1);

			ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П277" + СтрНомКол, ТекРаздел, "П269" + СтрНомКол, 1);
		КонецЕсли;

		ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П277" + СтрНомКол, ТекРаздел, "П270" + СтрНомКол, 1);
		
	КонецЦикла;
	
	УстановитьГруппировкиТитульнойСтраницы(ТекРаздел);
	
КонецПроцедуры

&НаСервере
Процедура РасчетРаздела_ОтчетТитульнаяСтраница2020Сервер(ТекРаздел)
	
	//заполним шапку документа
	ТекРаздел.Области["ТекущийПериод1"].Значение = "за " + КонсолидированнаяОтчетность.ПредставлениеФинансовогоПериода(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета ,СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета, Ложь);
	
	СведенияОбОрганизации = КонсолидированнаяОтчетность.СведенияОЮрФизЛице(СтруктураРеквизитовФормы.СчетДоверительногоУправления, СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета);
	
	Если НЕ ТекРаздел.Области.Найти("Организация") = Неопределено Тогда
		ТекРаздел.Области.Организация.Значение    = СведенияОбОрганизации.НаименованиеОрганизации + " Д.У. " + 
			СведенияОбОрганизации.ПолноеНаименование + " (" + СведенияОбОрганизации.КраткоеНаименование + ") по договору №" + 
			СведенияОбОрганизации.НомерДоговора + " от " + Формат(СведенияОбОрганизации.ДатаДоговора, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	Если НЕ ТекРаздел.Области.Найти("ПочтовыйАдресОрганизации") = Неопределено Тогда
		ТекРаздел.Области.ПочтовыйАдресОрганизации.Значение    = СведенияОбОрганизации.ЮридическийАдрес;
	КонецЕсли;
	
	Для каждого СтрокаРаздела Из ЭтаФорма.МногострочныйРаздел Цикл
	
		Если СтрокаРаздела.КодСтроки = 0 Тогда
		
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Для актива: " + СтрокаРаздела.Актив + 
				" не заполнена колонка ""Код строки"". Строка пропущена.", , "МногострочныйРаздел[" + (СтрокаРаздела.ПолучитьИдентификатор()) + "].КодСтроки", );
		
		КонецЕсли; 
			
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МногострочныйРаздел", ЭтаФорма.МногострочныйРаздел.Выгрузить());
	Если ЗначениеЗаполнено(СтруктураРеквизитовФормы.ОтчетНаКонецПрошлогоГода) И НЕ СтруктураРеквизитовФормы.НестандартныйПериод Тогда
	
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	МногострочныйРаздел.КодСтроки,
			|	МногострочныйРаздел.НачальныйОстатокРуб,
			|	МногострочныйРаздел.НачальныйОстатокВал,
			|	МногострочныйРаздел.Приход,
			|	МногострочныйРаздел.Расход,
			|	МногострочныйРаздел.Переоценка,
			|	МногострочныйРаздел.Иное,
			|	МногострочныйРаздел.КонечныйОстатокРуб,
			|	МногострочныйРаздел.КонечныйОстатокВал
			|ПОМЕСТИТЬ МногострочныйРаздел
			|ИЗ
			|	&МногострочныйРаздел КАК МногострочныйРаздел
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	МногострочныйРаздел.КодСтроки,
			|	СУММА(МногострочныйРаздел.НачальныйОстатокРуб) КАК НачальныйОстатокРуб,
			|	СУММА(МногострочныйРаздел.НачальныйОстатокВал) КАК НачальныйОстатокВал,
			|	СУММА(МногострочныйРаздел.Приход) КАК Приход,
			|	СУММА(МногострочныйРаздел.Расход) КАК Расход,
			|	СУММА(МногострочныйРаздел.Переоценка) КАК Переоценка,
			|	СУММА(МногострочныйРаздел.Иное) КАК Иное,
			|	СУММА(МногострочныйРаздел.КонечныйОстатокРуб) КАК КонечныйОстатокРуб,
			|	СУММА(МногострочныйРаздел.КонечныйОстатокВал) КАК КонечныйОстатокВал
			|ПОМЕСТИТЬ МногострочныйРазделГруппировка
			|ИЗ
			|	МногострочныйРаздел КАК МногострочныйРаздел
			|
			|СГРУППИРОВАТЬ ПО
			|	МногострочныйРаздел.КодСтроки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	МногострочныйРазделПрошлогоГода.КодСтроки,
			|	МногострочныйРазделПрошлогоГода.КонечныйОстатокРуб КАК КонечныйОстатокРуб,
			|	МногострочныйРазделПрошлогоГода.КонечныйОстатокВал КАК КонечныйОстатокВал
			|ПОМЕСТИТЬ _ДанныеПрошлогоГода
			|ИЗ
			|	&МногострочныйРазделПрошлогоГода КАК МногострочныйРазделПрошлогоГода
			|
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДанныеПрошлогоГода.КодСтроки,
			|	СУММА(_ДанныеПрошлогоГода.КонечныйОстатокРуб) КАК КонечныйОстатокРуб,
			|	СУММА(_ДанныеПрошлогоГода.КонечныйОстатокВал) КАК КонечныйОстатокВал
			|ПОМЕСТИТЬ МногострочныйРазделПрошлыйГод
			|ИЗ
			|	_ДанныеПрошлогоГода КАК _ДанныеПрошлогоГода
			|
			|СГРУППИРОВАТЬ ПО
			|	_ДанныеПрошлогоГода.КодСтроки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(МногострочныйРазделГруппировка.КодСтроки, МногострочныйРазделПрошлыйГод.КодСтроки) КАК КодСтроки,
			|	СУММА(ЕСТЬNULL(МногострочныйРазделПрошлыйГод.КонечныйОстатокРуб, 0)) КАК _01,
			|	СУММА(ЕСТЬNULL(МногострочныйРазделПрошлыйГод.КонечныйОстатокВал, 0)) КАК _02,
			|	СУММА(ЕСТЬNULL(МногострочныйРазделГруппировка.Приход, 0)) КАК _03,
			|	СУММА(ЕСТЬNULL(МногострочныйРазделГруппировка.Расход, 0)) КАК _04,
			|	СУММА(ЕСТЬNULL(МногострочныйРазделГруппировка.Переоценка, 0)) КАК _05,
			|	СУММА(ЕСТЬNULL(МногострочныйРазделГруппировка.НачальныйОстатокРуб, 0) - ЕСТЬNULL(МногострочныйРазделПрошлыйГод.КонечныйОстатокРуб, 0) + ЕСТЬNULL(МногострочныйРазделГруппировка.Иное, 0)) КАК _06,
			|	СУММА(ЕСТЬNULL(МногострочныйРазделГруппировка.КонечныйОстатокРуб, 0)) КАК _07,
			|	СУММА(ЕСТЬNULL(МногострочныйРазделГруппировка.КонечныйОстатокВал, 0)) КАК _08
			|ИЗ
			|	МногострочныйРазделГруппировка КАК МногострочныйРазделГруппировка
			|		ПОЛНОЕ СОЕДИНЕНИЕ МногострочныйРазделПрошлыйГод КАК МногострочныйРазделПрошлыйГод
			|		ПО МногострочныйРазделГруппировка.КодСтроки = МногострочныйРазделПрошлыйГод.КодСтроки
			|
			|СГРУППИРОВАТЬ ПО
			|	ЕСТЬNULL(МногострочныйРазделГруппировка.КодСтроки, МногострочныйРазделПрошлыйГод.КодСтроки)";
			
		ДанныеОтчета = СтруктураРеквизитовФормы.ОтчетНаКонецПрошлогоГода.ДанныеОтчета.Получить();
		МногострочныйРазделПрошлогоГода = Неопределено;
		Если ДанныеОтчета.Свойство("МногострочныйРаздел", МногострочныйРазделПрошлогоГода) Тогда
			Запрос.УстановитьПараметр("МногострочныйРазделПрошлогоГода", МногострочныйРазделПрошлогоГода);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В отчете на конец предыдущего года отсутствуют данные для заполнения");
		КонецЕсли;
			
	Иначе
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	МногострочныйРаздел.КодСтроки,
			|	МногострочныйРаздел.НачальныйОстатокРуб,
			|	МногострочныйРаздел.НачальныйОстатокВал,
			|	МногострочныйРаздел.Приход,
			|	МногострочныйРаздел.Расход,
			|	МногострочныйРаздел.Переоценка,
			|	МногострочныйРаздел.Иное,
			|	МногострочныйРаздел.КонечныйОстатокРуб,
			|	МногострочныйРаздел.КонечныйОстатокВал
			|ПОМЕСТИТЬ МногострочныйРаздел
			|ИЗ
			|	&МногострочныйРаздел КАК МногострочныйРаздел
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	МногострочныйРаздел.КодСтроки КАК КодСтроки,
			|	СУММА(МногострочныйРаздел.НачальныйОстатокРуб) КАК _01,
			|	СУММА(МногострочныйРаздел.НачальныйОстатокВал) КАК _02,
			|	СУММА(МногострочныйРаздел.Приход) КАК _03,
			|	СУММА(МногострочныйРаздел.Расход) КАК _04,
			|	СУММА(МногострочныйРаздел.Переоценка) КАК _05,
			|	СУММА(МногострочныйРаздел.Иное) КАК _06,
			|	СУММА(МногострочныйРаздел.КонечныйОстатокРуб) КАК _07,
			|	СУММА(МногострочныйРаздел.КонечныйОстатокВал) КАК _08
			|ИЗ
			|	МногострочныйРаздел КАК МногострочныйРаздел
			|
			|СГРУППИРОВАТЬ ПО
			|	МногострочныйРаздел.КодСтроки";
			
	КонецЕсли; 

	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		КодСтроки = ?(Выборка.КодСтроки < 10, "0" + Выборка.КодСтроки, "" + Выборка.КодСтроки);
		Для каждого Колонка Из Результат.Колонки Цикл
			Если Не Колонка.Имя = "КодСтроки" Тогда
				ИмяОбласти = "П" + КодСтроки + Прав(Колонка.Имя, 2);
				Попытка
					Если ТекРаздел.Области[ИмяОбласти].СодержитЗначение Тогда
					
						ТекРаздел.Области[ИмяОбласти].Значение = Выборка[Колонка.Имя];
					
					КонецЕсли; 
				Исключение
				КонецПопытки;
			КонецЕсли; 
		КонецЦикла; 
	КонецЦикла; 
		
КонецПроцедуры

#КонецОбласти 

#КонецОбласти 

#Область НастройкиОтчета

&НаКлиенте
Процедура ОткрытьФормуНастроекЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	ЕдиницаИзмерения 			= ДополнительныеПараметры.ЕдиницаИзмерения;
	ТочностьЕдиницыИзмерения 	= ДополнительныеПараметры.ТочностьЕдиницыИзмерения;
	ВалютаДокумента 			= ДополнительныеПараметры.ВалютаДокумента;
	ИсходныйПодписант 			= ДополнительныеПараметры.Подписант;
	ВидУчета 					= ДополнительныеПараметры.ВидУчета;
	
	Модифицированность = Истина;
	
	Если ЕдиницаИзмерения <> СтруктураРеквизитовФормы.ЕдиницаИзмерения Тогда
		
		ЕдиницаИзмеренияПриИзменении();
		
	КонецЕсли;
	
	Если ТочностьЕдиницыИзмерения <> СтруктураРеквизитовФормы.ТочностьЕдиницыИзмерения Тогда
		
		ТочностьЕдиницыИзмеренияПриИзменении();
		
	КонецЕсли;
	
	Если ВалютаДокумента <> СтруктураРеквизитовФормы.ВалютаДокумента Тогда
		
		ВалютаДокументаПриИзменении();
		
	КонецЕсли;
	
	Если ИсходныйПодписант <> ЭтаФорма.Подписант Тогда
		
		КонсолидированнаяОтчетностьКлиент.ЗаполнитьПодписантаРегламентированногоОтчета(ЭтаФорма);
		
	КонецЕсли;
	
	Если ВидУчета <> СтруктураРеквизитовФормы.ВидУчета Тогда
		
		Модифицированность = Истина;
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ЕдиницаИзмеренияПриИзменении()
	
	ПроверитьТочность();
	
	УстановитьФорматВывода();
	
	ЗаполнитьДенежныйПоказательСРазмерностью();
	
	Модифицированность = Истина;
	
	ЭтаФорма.ТабличныйДокумент = ЭтаФорма.РазделыОтчета[0].ТабличныйДокумент;
	
КонецПроцедуры

&НаКлиенте
Процедура ТочностьЕдиницыИзмеренияПриИзменении()
	
	ПроверитьТочность();
	
	УстановитьФорматВывода();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьФорматВывода()

	КонсолидированнаяОтчетность.УстановитьФорматВывода(СтруктураРеквизитовФормы, мТаблицаСоставПоказателей, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ВалютаДокументаПриИзменении()
	
	ТекстСообщения = НСтр("ru = 'Изменена валюта представления отчетности.
	|Перезаполнить документ?'");
	
	ПоказатьВопрос(
	Новый ОписаниеОповещения(
	"ВалютаДокументаПриИзмененииЗавершение",
	ЭтотОбъект),
	ТекстСообщения,
	РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаДокументаПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаполнитьАвто();
	КонецЕсли;
	
	ЗаполнитьДенежныйПоказательСРазмерностью();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьТочность()
	
	Если СтруктураРеквизитовФормы.ЕдиницаИзмерения = ПредопределенноеЗначение("Перечисление.ПорядкиОкругленияОтчетности.Окр1") Тогда
		
		Если СтруктураРеквизитовФормы.ТочностьЕдиницыИзмерения > 2 Тогда
			ТекстСообщения = НСтр("ru = 'При выводе сумм в рублях точность не может превышать 2 знака'");
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			СтруктураРеквизитовФормы.ТочностьЕдиницыИзмерения = 2;
		КонецЕсли;
		
	ИначеЕсли СтруктураРеквизитовФормы.ЕдиницаИзмерения = ПредопределенноеЗначение("Перечисление.ПорядкиОкругленияОтчетности.Окр1000") Тогда
		
		Если СтруктураРеквизитовФормы.ТочностьЕдиницыИзмерения > 3 Тогда
			ТекстСообщения = НСтр("ru = 'При выводе сумм в тысячах рублей точность не может превышать 3 знака'");
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			СтруктураРеквизитовФормы.ТочностьЕдиницыИзмерения = 3;
		КонецЕсли;
		
	ИначеЕсли СтруктураРеквизитовФормы.ЕдиницаИзмерения = ПредопределенноеЗначение("Перечисление.ПорядкиОкругленияОтчетности.Окр1000000") Тогда
		
		Если СтруктураРеквизитовФормы.ТочностьЕдиницыИзмерения > 6 Тогда
			ТекстСообщения = НСтр("ru = 'При выводе сумм в миллионах рублей точность не может превышать 6 знаков'");
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			СтруктураРеквизитовФормы.ТочностьЕдиницыИзмерения = 6;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ПроверитьТочность()
	
#КонецОбласти 

#Область ЗаписьОтчета

&НаКлиенте
Процедура СохранитьНаКлиенте(ВыполняемоеОповещение=Неопределено) Экспорт

	Если МодифицированностьМногострочногоРаздела Тогда
	
		Если Вопрос("Многострочный раздел изменен. Перезаполнить титульный лист?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да  Тогда
		
			ЗаполнитьАвто("ОтчетТитульнаяСтраница2020");
		
		КонецЕсли; 
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураРеквизитовФормы.мСохраненныйДок) Тогда
		ИмяСобытия = "ЗаписьРегламентированногоОтчета";
	Иначе
		ИмяСобытия = "ЗаписьНовогоРегламентированногоОтчета";
	КонецЕсли; 

	КонсолидированнаяОтчетностьКлиент.ЗаполнитьПодписантаРегламентированногоОтчета(ЭтаФорма);
    //при ручной правке подписант может пропасть. При сохранении вернем его
	
	ЗаполнитьПоказатели();
	ЗаписатьНаСервере();
	
	Если ЗначениеЗаполнено(ЭтаФорма.СтруктураРеквизитовФормы.мСохраненныйДок) Тогда
	
		Модифицированность = Ложь;
	
		ИсторияРаботыПользователя.Добавить(ЭтаФорма.СтруктураРеквизитовФормы.мСохраненныйДок);
		
		Оповестить(ИмяСобытия, Новый Структура("Ключ", СтруктураРеквизитовФормы.мСохраненныйДок));
		
		Если ВыполняемоеОповещение <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		КонецЕсли;
	
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаСервере()

	КонсолидированнаяОтчетность.ЗаписатьОтчет(ЭтаФорма);

КонецПроцедуры

&НаКлиенте 
Процедура ЗаполнитьПоказатели()

	ЭтаФорма.Показатели.Очистить();
		
	Для Каждого ТекСтрока Из РазделыОтчета Цикл
		
		Если ТекСтрока.Многострочныйраздел Тогда
		
			Продолжить;
		
		КонецЕсли; 
		
		Попытка
			ОбластиРаздела = ТекСтрока.ТабличныйДокумент.Области;
		Исключение
			Продолжить;
		КонецПопытки;
		
		Для Каждого ТекОбласть Из ОбластиРаздела Цикл
			
			Если Не ТекОбласть.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
				Продолжить;
			КонецЕсли;
			
			Попытка
				Если Не ТекОбласть.СодержитЗначение Тогда
					Продолжить;
				КонецЕсли;
			Исключение
				ТекстСообщения = "Ошибка макета: раздел " + ТекСтрока.ИмяРаздела + " область " + ТекОбласть.Имя + " не содержит значение!";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Продолжить;
			КонецПопытки;
			
			Если Не ЗначениеЗаполнено(ТекОбласть.Значение) Тогда
			
				Продолжить;
			
			КонецЕсли; 
			
			НоваяСтрока = ЭтаФорма.Показатели.Добавить();
			НоваяСтрока.ИмяРаздела 		= ТекСтрока.ИмяРаздела;
			НоваяСтрока.ИмяПоказателя 	= ТекОбласть.Имя;
			НоваяСтрока.Значение 		= ТекОбласть.Значение;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЭтаФорма.Показатели.Сортировать("ИмяРаздела, ИмяПоказателя");
	
КонецПроцедуры

