		ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П258" + СтрНомКол, ТекРаздел, "П260" + СтрНомКол, 1);

		Если НомКол <> 5 Тогда
			ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П261" + СтрНомКол, ТекРаздел, "П262" + СтрНомКол, 1);
			ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П261" + СтрНомКол, ТекРаздел, "П263" + СтрНомКол, 1);
			ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П261" + СтрНомКол, ТекРаздел, "П264" + СтрНомКол, 1);
			ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П261" + СтрНомКол, ТекРаздел, "П265" + СтрНомКол, 1);
			ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П261" + СтрНомКол, ТекРаздел, "П266" + СтрНомКол, 1);
			ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П261" + СтрНомКол, ТекРаздел, "П267" + СтрНомКол, 1);
		КонецЕсли;

		ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П268" + СтрНомКол, ТекРаздел, "П258" + СтрНомКол, 1);
		ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П268" + СтрНомКол, ТекРаздел, "П261" + СтрНомКол, 1);

		Если НомКол <> 5 Тогда
			ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П270" + СтрНомКол, ТекРаздел, "П271" + СтрНомКол, 1);
			ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П270" + СтрНомКол, ТекРаздел, "П272" + СтрНомКол, 1);
			ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П270" + СтрНомКол, ТекРаздел, "П273" + СтрНомКол, 1);
			ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П270" + СтрНомКол, ТекРаздел, "П274" + СтрНомКол, 1);
			ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П270" + СтрНомКол, ТекРаздел, "П275" + СтрНомКол, 1);
			ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П270" + СтрНомКол, ТекРаздел, "П276" + СтрНомКол, 1);

			ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П277" + СтрНомКол, ТекРаздел, "П269" + СтрНомКол, 1);
