	               |						ИЗ
	               |							Справочник.УправляющиеКомпании КАК Т
	               |			
	               |						ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |						ВЫБРАТЬ
	               |							Т.ЮрФизЛицо
	               |						ИЗ
	               |							Справочник.ДепозитарныеКомпании КАК Т)) КАК БухгалтерскийУчетОстатки
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НЕОПРЕДЕЛЕНО,
	               |	БухгалтерскийУчетОстатки.Субконто1,
	               |	""ДругиеОбязательства"",
	               |	ВЫБОР
	               |		КОГДА БухгалтерскийУчетОстатки.Счет.Валютный
	               |					И БухгалтерскийУчетОстатки.Валюта = БухгалтерскийУчетОстатки.Организация.ВалютаУчета
	               |				ИЛИ НЕ БухгалтерскийУчетОстатки.Счет.Валютный
	               |			ТОГДА БухгалтерскийУчетОстатки.СуммаОстатокКт
	               |		ИНАЧЕ 0
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА БухгалтерскийУчетОстатки.Счет.Валютный
	               |				И БухгалтерскийУчетОстатки.Валюта <> БухгалтерскийУчетОстатки.Организация.ВалютаУчета
	               |			ТОГДА БухгалтерскийУчетОстатки.СуммаОстатокКт
	               |		ИНАЧЕ 0
	               |	КОНЕЦ
	               |ИЗ
	               |	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
	               |			&грКонецПериода,
	               |			Счет В (ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыСДебиторамиИКредиторамиВРублях), ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыСКонтрагентами)),
	               |			,
	               |			Организация = &Организация
	               |				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК БухгалтерскийУчетОстатки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	_ИтоговаяТаблица.Актив,
	               |	_ИтоговаяТаблица.ЮрФизЛицо,
	               |	СУММА(_ИтоговаяТаблица.КонечныйОстатокРуб) КАК КонечныйОстатокРуб,
	               |	СУММА(_ИтоговаяТаблица.КонечныйОстатокВал) КАК КонечныйОстатокВал,
	               |	РеквизитыЮридическихЛицСрезПоследних.РезидентРФ КАК Резидент,
	               |	_ИтоговаяТаблица.Раздел
	               |ИЗ
	               |	_ИтоговаяТаблица КАК _ИтоговаяТаблица
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&КонецПериода, Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний) И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
	               |		ПО _ИтоговаяТаблица.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	_ИтоговаяТаблица.Актив,
	               |	_ИтоговаяТаблица.ЮрФизЛицо,
	               |	РеквизитыЮридическихЛицСрезПоследних.РезидентРФ,
	               |	_ИтоговаяТаблица.Раздел";
	
				   
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(ТаблицаМногострочныйРаздел.Добавить(), Выборка);
			
	КонецЦикла;
				   
	ЗаполнитьСектора(ТаблицаМногострочныйРаздел);
	
	КодыСтрок = ПолучитьТаблицуКодыСтрок();
		
	Для каждого ТекСтрока Из ТаблицаМногострочныйРаздел Цикл
	
		ТекСтрока.КодСтроки = ПолучитьКодСтроки(ТекСтрока, КодыСтрок, СтруктураРеквизитовФормы.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления);
	
	КонецЦикла; 
	
	ТаблицаМногострочныйРаздел.Сортировать("КодСтроки, ЮрФизЛицо, Актив");
		
	ЭтаФорма.МногострочныйРаздел.Загрузить(ТаблицаМногострочныйРаздел);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьРаздел_МногострочныйРазделСервер()
	
	ИмяРаздела = "МногострочныйРазделТаблица";
	
	ЭтаФорма.МногострочныйРаздел.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", 	СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета);	
	Запрос.УстановитьПараметр("грКонецПериода", Новый Граница(КонецДня(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонецПериода", 	СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета);
	Запрос.УстановитьПараметр("Организация", 	СтруктураРеквизитовФормы.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СтруктураРеквизитовФормы.СчетДоверительногоУправления);
	
	СчетаУчетаЦенныхБумаг = КонсолидированнаяОтчетность.ПолучитьСчетаУчетаЦенныхБумаг();
	
	Запрос.УстановитьПараметр("СчетаДолговых", СчетаУчетаЦенныхБумаг.СчетаДолговых);
	Запрос.УстановитьПараметр("СчетаДолевых", СчетаУчетаЦенныхБумаг.СчетаДолевых);
	Запрос.УстановитьПараметр("СчетаПереоценкиДолговых", СчетаУчетаЦенныхБумаг.СчетаПереоценкиДолговых);
	Запрос.УстановитьПараметр("СчетаПереоценкиДолевых", СчетаУчетаЦенныхБумаг.СчетаПереоценкиДолевых);
	Запрос.УстановитьПараметр("СчетаКорректировкиДолговых", СчетаУчетаЦенныхБумаг.СчетаКорректировкиДолговых);
	Запрос.УстановитьПараметр("СчетаКорректировкиДолевых", СчетаУчетаЦенныхБумаг.СчетаКорректировкиДолевых);
	
	Запрос.УстановитьПараметр("СчетаРезервовДолевых", СчетаУчетаЦенныхБумаг.СчетаРезервовДолевых);
	Запрос.УстановитьПараметр("СчетаРезервовДолговых", СчетаУчетаЦенныхБумаг.СчетаРезервовДолговых);
	
	ТаблицаМногострочныйРаздел = ЭтаФорма.МногострочныйРаздел.Выгрузить().СкопироватьКолонки();
	
	ЗаполнитьРаздел_ДенежныеСредстваНаСчетахУправляющегоСервер(Запрос, ТаблицаМногострочныйРаздел);
	
	ЗаполнитьРаздел_ДепозитыСервер(Запрос, ТаблицаМногострочныйРаздел);
	
	ЗаполнитьРаздел_ДолговыеЦенныеБумагиСервер(Запрос, ТаблицаМногострочныйРаздел);
	                                                 
	ЗаполнитьРаздел_ДолевыеЦенныеБумагиСервер(Запрос, ТаблицаМногострочныйРаздел);
	
	ЗаполнитьРаздел_ДенежныеСредстваУБрокеровСервер(Запрос, ТаблицаМногострочныйРаздел);

	ЗаполнитьРаздел_НачисленныеПроцентыПоДепозитамСервер(Запрос, ТаблицаМногострочныйРаздел);
	
	ЗаполнитьРаздел_КупонныйДоходСервер(Запрос, ТаблицаМногострочныйРаздел);
	
	ЗаполнитьРаздел_ДебиторскаяЗадолженностьСервер(Запрос, ТаблицаМногострочныйРаздел);
	
	ЗаполнитьРаздел_ПенсионныеРезервыНакопленияСервер(Запрос, ТаблицаМногострочныйРаздел);
	
	ЗаполнитьРаздел_ДругиеОбязательстваСервер(Запрос, ТаблицаМногострочныйРаздел);
	
	ЗаполнитьРаздел_НераспределеннаяПрибыльУбытокСервер(Запрос, ТаблицаМногострочныйРаздел);
	
	ЗаполнитьСектора(ТаблицаМногострочныйРаздел);
	
	КодыСтрок = ПолучитьТаблицуКодыСтрок();
		
	Для каждого ТекСтрока Из ТаблицаМногострочныйРаздел Цикл
	
		ТекСтрока.КодСтроки = ПолучитьКодСтроки(ТекСтрока, КодыСтрок, СтруктураРеквизитовФормы.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления);
	
	КонецЦикла; 
	
	ТаблицаМногострочныйРаздел.Сортировать("КодСтроки, ЮрФизЛицо, Актив");
		
	ЭтаФорма.МногострочныйРаздел.Загрузить(ТаблицаМногострочныйРаздел);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСектора(ТаблицаДокумента)
	
	КонецПериода = КонсолидированнаяОтчетность.ПолучитьДатуПеречняФинансовыхОрганизаций(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета);
	ЭтаФорма.Комментарий = "При построении отчета использован перечень организаций финансового сектора по состоянию на " + Формат(КонецПериода, "ДФ=dd.MM.yyyy");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаДокумента.Актив,
		|	ТаблицаДокумента.ЮрФизЛицо,
		|	ТаблицаДокумента.Сектор,
		|	ТаблицаДокумента.Резидент,
		|	ТаблицаДокумента.КодСтроки,
		|	ТаблицаДокумента.НачальныйОстатокРуб,
		|	ТаблицаДокумента.НачальныйОстатокВал,
		|	ТаблицаДокумента.Приход,
		|	ТаблицаДокумента.Расход,
		|	ТаблицаДокумента.Переоценка,
		|	ТаблицаДокумента.Иное,
		|	ТаблицаДокумента.КонечныйОстатокРуб,
		|	ТаблицаДокумента.КонечныйОстатокВал,
		|	ТаблицаДокумента.Раздел
		|ПОМЕСТИТЬ _ТаблицаДокумента
		|ИЗ
		|	&ТаблицаДокумента КАК ТаблицаДокумента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПеречниОбъектов.Объект,
		|	ПеречниОбъектов.ВидПеречня
		|ПОМЕСТИТЬ _ПеречниОбъектов
		|ИЗ
		|	РегистрСведений.ПеречниОбъектов КАК ПеречниОбъектов
		|ГДЕ
		|	ПеречниОбъектов.Включен
		|	И НЕ ПеречниОбъектов.ВидПеречня = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ЦБРФ_ИнвестиционныеФонды)
		|	И ПеречниОбъектов.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЦБРФ)
		|			И ПеречниОбъектов.ВидПеречня.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ЦБРФ_ПереченьОрганизацийФинансовогоСектора)
		|			И ПеречниОбъектов.Объект В
		|				(ВЫБРАТЬ
		|					_ТаблицаДокумента.ЮрФизЛицо
		|				ИЗ
		|					_ТаблицаДокумента КАК _ТаблицаДокумента)
		|	И ПеречниОбъектов.Период = &КонецПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПеречниОбъектов.Объект,
		|	ПеречниОбъектов.ВидПеречня
		|ПОМЕСТИТЬ _ИнвестиционныеФонды
		|ИЗ
		|	РегистрСведений.ПеречниОбъектов КАК ПеречниОбъектов
		|ГДЕ
		|	ПеречниОбъектов.Включен
		|	И ПеречниОбъектов.ВидПеречня = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ЦБРФ_ИнвестиционныеФонды)
		|	И ПеречниОбъектов.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЦБРФ)
		|			И ПеречниОбъектов.ВидПеречня.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ЦБРФ_ПереченьОрганизацийФинансовогоСектора)
		|			И ПеречниОбъектов.Объект В
		|				(ВЫБРАТЬ
		|					_ТаблицаДокумента.ЮрФизЛицо
		|				ИЗ
		|					_ТаблицаДокумента КАК _ТаблицаДокумента)
		|	И ПеречниОбъектов.Период = &КонецПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПеречниОбъектов.Объект,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ПеречниОбъектов.ВидПеречня) КАК ВидПеречня
		|ПОМЕСТИТЬ _ОрганизацииВходящиеВНесколькоСекторов
		|ИЗ
		|	_ПеречниОбъектов КАК _ПеречниОбъектов
		|
		|СГРУППИРОВАТЬ ПО
		|	_ПеречниОбъектов.Объект
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ПеречниОбъектов.ВидПеречня) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИнвестиционныеФонды.Объект,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ИнвестиционныеФонды.ВидПеречня) КАК ВидПеречня
		|ПОМЕСТИТЬ _ОрганизацииВходящиеВНесколькоФондов
		|ИЗ
		|	_ИнвестиционныеФонды КАК _ИнвестиционныеФонды
		|
		|СГРУППИРОВАТЬ ПО
		|	_ИнвестиционныеФонды.Объект
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ИнвестиционныеФонды.ВидПеречня) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Эмитенты.ЮрФизЛицо КАК ЮрФизЛицо
		|ПОМЕСТИТЬ _ОрганыГосударственногоУправления
		|ИЗ
		|	Справочник.Облигации КАК Облигации
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|		ПО Облигации.Эмитент = Эмитенты.Ссылка
		|ГДЕ
		|	Облигации.Категория В (ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная), ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная), ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Муниципальная))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаДокумента.Актив,
		|	_ТаблицаДокумента.ЮрФизЛицо,
		|	_ТаблицаДокумента.Резидент,
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(_ТаблицаДокумента.Актив КАК Справочник.Паи) ССЫЛКА Справочник.Паи
		|			ТОГДА ВЫБОР
		|					КОГДА _ТаблицаДокумента.ЮрФизЛицо В
		|							(ВЫБРАТЬ
		|								_ОрганизацииВходящиеВНесколькоФондов.Объект
		|							ИЗ
		|								_ОрганизацииВходящиеВНесколькоФондов КАК _ОрганизацииВходящиеВНесколькоФондов)
		|						ТОГДА НЕОПРЕДЕЛЕНО
		|					ИНАЧЕ ЕСТЬNULL(_ИнвестиционныеФонды.ВидПеречня, ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ПустаяСсылка))
		|				КОНЕЦ
		|		КОГДА _ТаблицаДокумента.ЮрФизЛицо В
		|				(ВЫБРАТЬ
		|					_ОрганизацииВходящиеВНесколькоСекторов.Объект
		|				ИЗ
		|					_ОрганизацииВходящиеВНесколькоСекторов КАК _ОрганизацииВходящиеВНесколькоСекторов)
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ЕСТЬNULL(_ПеречниОбъектов.ВидПеречня, ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ПустаяСсылка))
		|	КОНЕЦ КАК Сектор,
		|	_ТаблицаДокумента.КодСтроки,
		|	_ТаблицаДокумента.НачальныйОстатокРуб,
		|	_ТаблицаДокумента.НачальныйОстатокВал,
		|	_ТаблицаДокумента.Приход,
		|	_ТаблицаДокумента.Расход,
		|	_ТаблицаДокумента.Переоценка,
		|	_ТаблицаДокумента.Иное,
		|	_ТаблицаДокумента.КонечныйОстатокРуб,
		|	_ТаблицаДокумента.КонечныйОстатокВал,
		|	_ТаблицаДокумента.Раздел,
		|	_ТаблицаДокумента.ЮрФизЛицо В
		|		(ВЫБРАТЬ
		|			_ОрганыГосударственногоУправления.ЮрФизЛицо
		|		ИЗ
		|			_ОрганыГосударственногоУправления КАК _ОрганыГосударственногоУправления) КАК ГосОрган
		|ИЗ
		|	_ТаблицаДокумента КАК _ТаблицаДокумента
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПеречниОбъектов КАК _ПеречниОбъектов
		|		ПО _ТаблицаДокумента.ЮрФизЛицо = _ПеречниОбъектов.Объект
		|			И (НЕ _ПеречниОбъектов.Объект В
		|					(ВЫБРАТЬ
		|						_ОрганизацииВходящиеВНесколькоСекторов.Объект
		|					ИЗ
		|						_ОрганизацииВходящиеВНесколькоСекторов КАК _ОрганизацииВходящиеВНесколькоСекторов))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ИнвестиционныеФонды КАК _ИнвестиционныеФонды
		|		ПО _ТаблицаДокумента.ЮрФизЛицо = _ИнвестиционныеФонды.Объект
		|			И (НЕ _ИнвестиционныеФонды.Объект В
		|					(ВЫБРАТЬ
		|						_ОрганизацииВходящиеВНесколькоФондов.Объект
		|					ИЗ
		|						_ОрганизацииВходящиеВНесколькоФондов КАК _ОрганизацииВходящиеВНесколькоФондов))";
		
	Запрос.УстановитьПараметр("ТаблицаДокумента", ТаблицаДокумента);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода); 
	
	ТаблицаДокумента = Запрос.Выполнить().Выгрузить();
				
КонецПроцедуры
 
&НаСервере
Процедура ЗаполнитьРаздел_ДенежныеСредстваНаСчетахУправляющегоСервер(Запрос, ТаблицаМногострочныйРаздел)
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	5 КАК КодСтроки,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто1 КАК Актив,
		|	Банки.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный
		|					И ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Валюта = ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Организация.ВалютаУчета
		|				ИЛИ НЕ ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК НачальныйОстатокРуб,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный
		|				И ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Валюта <> ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Организация.ВалютаУчета
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК НачальныйОстатокВал,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаОборотДт КАК Приход,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаОборотКт КАК Расход,
		|	0 КАК Переоценка,
		|	0 КАК Иное,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный
		|					И ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Валюта = ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Организация.ВалютаУчета
		|				ИЛИ НЕ ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КонечныйОстатокРуб,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Валютный
		|				И ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Валюта <> ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Организация.ВалютаУчета
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КонечныйОстатокВал,
		|	РеквизитыЮридическихЛицСрезПоследних.РезидентРФ КАК Резидент,
		|	""ДенежныеСредства"" КАК Раздел
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&грКонецПериода,
		|			,
		|			,
		|			Счет В ИЕРАРХИИ (&Счет),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Банки КАК Банки
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&КонецПериода, Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний) И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|			ПО Банки.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ПО (ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто1 КАК Справочник.БанковскиеСчета).Банк = Банки.Ссылка)";
		
	Если СтруктураРеквизитовФормы.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		Запрос.УстановитьПараметр("Счет", ПланыСчетов.Единый.РасчетныеСчета);	
	Иначе
		Запрос.УстановитьПараметр("Счет", ПланыСчетов.Основной.РасчетныеСчета);	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕдиныйБухгалтерскийУчет", "БухгалтерскийУчет");
	КонецЕсли; 	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(ТаблицаМногострочныйРаздел.Добавить(), Выборка);
	
	КонецЦикла;
	
КонецПроцедуры

