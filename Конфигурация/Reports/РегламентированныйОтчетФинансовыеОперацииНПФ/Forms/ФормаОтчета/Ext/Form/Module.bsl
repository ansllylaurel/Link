			ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П215" + СтрНомКол, ТекРаздел, "П231" + СтрНомКол, 1);
		КонецЕсли;

		ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П215" + СтрНомКол, ТекРаздел, "П232" + СтрНомКол, 1);

		Если НомКол <> 5 Тогда
			ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П215" + СтрНомКол, ТекРаздел, "П256" + СтрНомКол, 1);
			ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П257" + СтрНомКол, ТекРаздел, "П197" + СтрНомКол, 1);
		КонецЕсли;

		ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П257" + СтрНомКол, ТекРаздел, "П215" + СтрНомКол, 1);

		Если НомКол <> 5 Тогда
			ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П258" + СтрНомКол, ТекРаздел, "П259" + СтрНомКол, 1);
