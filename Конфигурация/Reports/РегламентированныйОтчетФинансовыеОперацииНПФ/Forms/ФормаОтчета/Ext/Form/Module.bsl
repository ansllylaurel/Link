		|				И ЕдиныйБухгалтерскийУчетОбороты.Валюта <> ЕдиныйБухгалтерскийУчетОбороты.Организация.ВалютаУчета
		|			ТОГДА ЕдиныйБухгалтерскийУчетОбороты.СуммаОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КонечныйОстатокВал
		|ПОМЕСТИТЬ _ИтоговаяТаблица
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(
		|			&НачалоПериода,
		|			&грКонецПериода,
		|			,
		|			Счет В ИЕРАРХИИ (&Счет),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления,
		|			НЕ КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Единый.АктивыВДУ03),
		|			) КАК ЕдиныйБухгалтерскийУчетОбороты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	261,
		|	НЕОПРЕДЕЛЕНО,
		|	0,
		|	0,
		|	-ЕдиныйБухгалтерскийУчетОбороты.СуммаОборот,
		|	0,
		|	0,
		|	0,
		|	-ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОбороты.Счет.Валютный
		|					И ЕдиныйБухгалтерскийУчетОбороты.Валюта = ЕдиныйБухгалтерскийУчетОбороты.Организация.ВалютаУчета
		|				ИЛИ НЕ ЕдиныйБухгалтерскийУчетОбороты.Счет.Валютный
		|			ТОГДА ЕдиныйБухгалтерскийУчетОбороты.СуммаОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	-ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОбороты.Счет.Валютный
		|				И ЕдиныйБухгалтерскийУчетОбороты.Валюта <> ЕдиныйБухгалтерскийУчетОбороты.Организация.ВалютаУчета
		|			ТОГДА ЕдиныйБухгалтерскийУчетОбороты.СуммаОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(
		|			&НачалоПериода,
		|			&грКонецПериода,
		|			,
		|			Счет В ИЕРАРХИИ (&Счет),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ЛицевойСчетКор.ДополнительнаяАналитика В (ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеУправляющего),ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.НеобходимыеРасходыУправляющего)),
		|			КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Единый.АктивыВДУ03),
		|			) КАК ЕдиныйБухгалтерскийУчетОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИтоговаяТаблица.КодСтроки,
		|	_ИтоговаяТаблица.Актив,
		|	СУММА(_ИтоговаяТаблица.НачальныйОстатокРуб) КАК НачальныйОстатокРуб,
		|	СУММА(_ИтоговаяТаблица.НачальныйОстатокВал) КАК НачальныйОстатокВал,
		|	СУММА(_ИтоговаяТаблица.Приход) КАК Приход,
		|	СУММА(_ИтоговаяТаблица.Расход) КАК Расход,
		|	СУММА(_ИтоговаяТаблица.Переоценка) КАК Переоценка,
		|	СУММА(_ИтоговаяТаблица.Иное) КАК Иное,
		|	СУММА(_ИтоговаяТаблица.КонечныйОстатокРуб) КАК КонечныйОстатокРуб,
		|	СУММА(_ИтоговаяТаблица.КонечныйОстатокВал) КАК КонечныйОстатокВал,
		|	""НераспределеннаяПрибыль"" КАК Раздел
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|
		|СГРУППИРОВАТЬ ПО
		|	_ИтоговаяТаблица.Актив,
		|	_ИтоговаяТаблица.КодСтроки";
		
	МассивСчетов = Новый Массив;
	МассивСчетов.Добавить(ПланыСчетов.Единый.ПроцентныеДоходы);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ДоходыРасходыОтОпераций);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ПрочиеДоходыРасходы);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ДоходыРасходыПоОбеспечениюДеятельности);
	
	Запрос.УстановитьПараметр("Счет", МассивСчетов);		
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		ЗаполнитьЗначенияСвойств(ТаблицаМногострочныйРаздел.Добавить(), Выборка);
	
	КонецЦикла;
	
КонецПроцедуры


#КонецОбласти 

