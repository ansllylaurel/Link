	УправлениеФормой(ЭтаФорма);
	
	Если Не ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НеАктуальность");
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура УчетныйРегистрПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НеАктуальность");
	КонецЕсли;
	
	// Иванов 2016-08-25 добавление отборов по лицевому счету Начало...
	скИзменитьСтруктуруОтчетаКлиент();
	//... Иванов 2016-08-25 Конец
	
КонецПроцедуры

// Иванов 2016-08-25 добавление отборов по лицевому счету Начало...
&НаКлиенте
Процедура скИзменитьСтруктуруОтчетаКлиент(ИзменитьСтруктуруОтчетаНаСервере = Истина)
	
	Если Отчет.УчетныйРегистр <> "ЕдиныйБухгалтерскийУчет" Тогда 
		Отчет.скПоЛицевомуСчету = Ложь;
	КонецЕсли;
	
	Элементы.скПоЛицевомуСчету.Видимость = Отчет.УчетныйРегистр = "ЕдиныйБухгалтерскийУчет";
	
	Если ИзменитьСтруктуруОтчетаНаСервере Тогда 
		скИзменитьСтруктуруОтчета();
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура скИзменитьСтруктуруОтчета(ВызовПриСозданииНаСервере = Ложь)
	
	Если ВызовПриСозданииНаСервере И Параметры.Свойство("УчетныйРегистр") Тогда 
		Отчет.УчетныйРегистр = Параметры.УчетныйРегистр;	
	КонецЕсли;
	
	СхемаКомпоновкиДанныхОбъект = РеквизитФормыВЗначение("Отчет").СхемаКомпоновкиДанных;
	
	Если СхемаКомпоновкиДанныхОбъект.НаборыДанных.Найти("Проводки") <> Неопределено Тогда 
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос = СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, "БухгалтерскийУчет", Отчет.УчетныйРегистр);
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос = 
		СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, "ЕдиныйБухгалтерскийУчетОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет,", 	"");

		СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос = 
		СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, "ЛицевойСчет.*,", 	"");	
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос = 
		СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, "Проводки.ЛицевойСчет КАК ЛицевойСчет," , "");	
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос =
		СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, ", Проводки.ЛицевойСчет", 	"");
				
		Если Отчет.УчетныйРегистр = "ЕдиныйБухгалтерскийУчет" Тогда		 		
			
			СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос = 
			СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, "Проводки.СчетДт КАК СчетДт,", 	"Проводки.СчетДт КАК СчетДт, Проводки.ЛицевойСчет КАК ЛицевойСчет,");				
			
			СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос = 
			СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, "ДвиженияССубконто.СчетДт КАК СчетДт,", 	"ДвиженияССубконто.СчетДт КАК СчетДт, ЕдиныйБухгалтерскийУчетОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет,");
			
			СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос = 
			СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, "СчетДоверительногоУправления.*,", 	"СчетДоверительногоУправления.*, ЛицевойСчет.*,");		
			
			СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос =
			СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.Проводки.Запрос, "Проводки.ПериодГруппировки}" , "Проводки.ПериодГруппировки, Проводки.ЛицевойСчет}");
			
		КонецЕсли;
		
		СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанныхОбъект, УникальныйИдентификатор);
		
		Отчет.КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
		
	КонецЕсли;
	
	// Удаление нового измерения из отборов и группировок
	Если Отчет.УчетныйРегистр <> "ЕдиныйБухгалтерскийУчет" Тогда
		
		// Отборы
		УдалитьЗначенияОтборов_Рекурс(Отчет.КомпоновщикНастроек.Настройки.Отбор);
				
	КонецЕсли;
	
КонецПроцедуры	

Процедура УдалитьЗначенияОтборов_Рекурс(ГруппаЭлементовОтбора)
	
	МассивЭлементовКУдалению = Новый Массив;
		
	Для Каждого ЭлементОтбора Из ГруппаЭлементовОтбора.Элементы Цикл 
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда 
			УдалитьЗначенияОтборов_Рекурс(ЭлементОтбора);
		Иначе 
			Если СтрЧислоВхождений(Строка(ЭлементОтбора.ЛевоеЗначение) ,"ЛицевойСчет") > 0 Тогда 	
				МассивЭлементовКУдалению.Добавить(ЭлементОтбора);	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого УдаляемыйЭлемент Из МассивЭлементовКУдалению Цикл 
		ГруппаЭлементовОтбора.Элементы.Удалить(УдаляемыйЭлемент);
	КонецЦикла;
	
	Если ГруппаЭлементовОтбора.Элементы.Количество() = 0  
		И ТипЗнч(ГруппаЭлементовОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных")
		И ГруппаЭлементовОтбора.Родитель <> Неопределено Тогда 
		ГруппаЭлементовОтбора.Родитель.Элементы.Удалить(ГруппаЭлементовОтбора);
	КонецЕсли;	
	
КонецПроцедуры	
	

