
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
		
	ДатаНачала = ЭтотОбъект.ПериодОтчета.ДатаНачала;
	ДатаОкончания = ?(ЗначениеЗаполнено(ЭтотОбъект.ПериодОтчета.ДатаОкончания), ЭтотОбъект.ПериодОтчета.ДатаОкончания, '39991231');
	
	Настройки = КомпоновщикНастроек.Настройки;
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Организация", 	ЭтотОбъект.Организация);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаНачала", 	ДатаНачала);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаОкончания", 	ДатаОкончания);
	
	КлючТекущегоВарианта = КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.КлючТекущегоВарианта;
	
	ЮрЛицоОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ЮрФизЛицо");
	НаименованиеОрганизации = ПолучитьНаименованиеОрганизации(ЮрЛицоОрганизации, ДатаОкончания);
	
	ПредставлениеПериода = "с " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " по " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
	
	Если КлючТекущегоВарианта = "ЖурналЖалобИОбращений" Тогда
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Заголовок", "Журнал регистрации обращений, жалоб, заявлений " + НаименованиеОрганизации);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Лицензия", ПолучитьПредставлениеОтбора(ЮрЛицоОрганизации, ДатаОкончания));
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПредставлениеПериода", "Период: " + ПредставлениеПериода);
	Иначе 
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ЗаголовокОрганизация", НаименованиеОрганизации);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПредставлениеПериода", "период " + ПредставлениеПериода);
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьНаименованиеОрганизации(Организация, ДатаОкончания)

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&ДатаОкончания,
		|			ЮрФизЛицо = &Организация
		|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КраткоеНаименованиеПоУставу;
	КонецЕсли; 

КонецФункции
 
Функция ПолучитьПредставлениеОтбора(Организация, ДатаОкончания)

	ВидыЛицензий = Новый Массив;
	НайтиОтборПоЛицензии(КомпоновщикНастроек.ПолучитьНастройки().Отбор, ВидыЛицензий);
	
	Если ВидыЛицензий.Количество() = 0 Тогда
	
		ВидыЛицензий.Добавить(Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами);
		ВидыЛицензий.Добавить(Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ);
		ВидыЛицензий.Добавить(Неопределено);
	
	КонецЕсли; 
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Лицензии.Ссылка КАК Ссылка,
		|	Лицензии.Номер КАК Номер,
		|	Лицензии.ДатаВыдачи КАК ДатаВыдачи,
		|	Лицензии.ВидДеятельности КАК ВидДеятельности
		|ИЗ
		|	Справочник.Лицензии КАК Лицензии
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий.СрезПоследних(&ДатаОкончания, ) КАК СтатусыЛицензийСрезПоследних
		|		ПО (СтатусыЛицензийСрезПоследних.Лицензия = Лицензии.Ссылка)
		|ГДЕ
		|	Лицензии.ЮрФизЛицо = &Организация
		|	И Лицензии.ВидДеятельности В(&ВидДеятельности)
		|	И СтатусыЛицензийСрезПоследних.Статус = Значение(Перечисление.СтатусыДокументов.Действует)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаВыдачи,
		|	Номер";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаОкончания", 		ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", 		Организация);
	Запрос.УстановитьПараметр("ВидДеятельности", 	ВидыЛицензий);
	
	Выборка = Запрос.Выполнить().Выбрать();
	МассивЛицензий = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		МассивЛицензий.Добавить(Строка(Выборка.ВидДеятельности) + " №" + Выборка.Номер + " от " + Формат(Выборка.ДатаВыдачи, "ДФ=dd.MM.yyyy"));
	КонецЦикла; 
	Если ВидыЛицензий.Найти(Неопределено) <> Неопределено Тогда
		МассивЛицензий.Добавить("По собственной деятельности УК");
	КонецЕсли; 
	
	ПредставлениеОтбора = ?(ВидыЛицензий.Количество() = 1, "Лицензия: ", "Лицензии: ") + СтрСоединить(МассивЛицензий, ";" + Символы.ПС);
	
	Возврат ПредставлениеОтбора;

КонецФункции
 
Процедура НайтиОтборПоЛицензии(Отбор, ВидыЛицензий)

	Для каждого ЭлементОтбора Из Отбор.Элементы Цикл
	
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			НайтиОтборПоЛицензии(ЭлементОтбора, ВидыЛицензий);
		Иначе
			Если ЭлементОтбора.Использование И ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("Булево") 
				И ((ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно И ЭлементОтбора.ПравоеЗначение)
					Или (ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно И Не ЭлементОтбора.ПравоеЗначение)) Тогда
				
				Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВходящиеДокументы.ПоЛицензииДУ") Тогда
					ВидыЛицензий.Добавить(Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами);
				ИначеЕсли ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВходящиеДокументы.ПоЛицензииУКПИФ") Тогда
					ВидыЛицензий.Добавить(Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ);
				ИначеЕсли ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВходящиеДокументы.ПоСобственнойДеятельностиУК") Тогда
					ВидыЛицензий.Добавить(Неопределено);
				КонецЕсли; 
			
			КонецЕсли; 
		КонецЕсли; 
	
	КонецЦикла; 

КонецПроцедуры