&НаСервере
Процедура скИзменитьСтруктуруОтчета()
	
	СхемаКомпоновкиДанныхОбъект = РеквизитФормыВЗначение("Отчет").СхемаКомпоновкиДанных;
	
	Если СхемаКомпоновкиДанныхОбъект.НаборыДанных.Найти("ОсновнойНаборДанных") <> Неопределено Тогда 
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Элементы.ОсновнойНаборДанных.Запрос = СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Элементы.ОсновнойНаборДанных.Запрос, "БухгалтерскийУчет", Отчет.УчетныйРегистр);
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Элементы.Обороты.Запрос = СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Элементы.Обороты.Запрос, "БухгалтерскийУчет", Отчет.УчетныйРегистр);
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Элементы.ОсновнойНаборДанных.Запрос = 
		СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Элементы.ОсновнойНаборДанных.Запрос, "ЕдиныйБухгалтерскийУчетОбороты.ЛицевойСчет КАК ЛицевойСчет,", 	"");
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Элементы.ОсновнойНаборДанных.Запрос = 
			СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Элементы.ОсновнойНаборДанных.Запрос, "ЕдиныйБухгалтерскийУчетОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет,", "");			
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Элементы.Обороты.Запрос = 
		СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Элементы.Обороты.Запрос, "ЕдиныйБухгалтерскийУчетОбороты.ЛицевойСчет КАК ЛицевойСчет,", 	"");
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Элементы.Обороты.Запрос = 
			СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Элементы.Обороты.Запрос, "ЕдиныйБухгалтерскийУчетОбороты.ЛицевойСчет КАК ЛицевойСчет,", "");
			
		Если Отчет.УчетныйРегистр = "ЕдиныйБухгалтерскийУчет" Тогда		 		
			
			СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Элементы.ОсновнойНаборДанных.Запрос = 
			СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Элементы.ОсновнойНаборДанных.Запрос, "	ЕдиныйБухгалтерскийУчетОбороты.Счет КАК Счет,", 	"ЕдиныйБухгалтерскийУчетОбороты.Счет КАК Счет, ЕдиныйБухгалтерскийУчетОбороты.ЛицевойСчет КАК ЛицевойСчет,");		
			
			СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Элементы.ОсновнойНаборДанных.Запрос = 
			СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Элементы.ОсновнойНаборДанных.Запрос, "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ", 	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ЕдиныйБухгалтерскийУчетОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет,");		
			
			СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Элементы.Обороты.Запрос = 
			СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Элементы.Обороты.Запрос, "	ЕдиныйБухгалтерскийУчетОбороты.Счет КАК Счет,", 	"ЕдиныйБухгалтерскийУчетОбороты.Счет КАК Счет, ЕдиныйБухгалтерскийУчетОбороты.ЛицевойСчет КАК ЛицевойСчет,");		
			
		КонецЕсли;
		
		СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанныхОбъект, УникальныйИдентификатор);
		
		Отчет.КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
		
	КонецЕсли;
	
	// Удаление нового измерения из отборов и группировок
	Если Отчет.УчетныйРегистр <> "ЕдиныйБухгалтерскийУчет" Тогда
		
		Если ТипЗнч(Отчет.Счет) <> Тип("ПланСчетовСсылка.Основной") Тогда 
			Отчет.Счет = ПредопределенноеЗначение("ПланСчетов.Основной.ПустаяСсылка");
		КонецЕсли;
		
		// Отборы
		УдалитьЗначенияОтборов_Рекурс(Отчет.КомпоновщикНастроек.Настройки.Отбор);
		
		МассивЭлементовКУдалению = Новый Массив;
		
		// Группировка
		Для Каждого ЭлементГруппировки Из Отчет.Группировка Цикл 			
			Если СтрЧислоВхождений(ЭлементГруппировки.Поле ,"ЛицевойСчет") > 0 Тогда 
				МассивЭлементовКУдалению.Добавить(ЭлементГруппировки);	
			КонецЕсли;			
		КонецЦикла;
		
		Для Каждого ЭлементГруппировкиУдаление Из МассивЭлементовКУдалению Цикл
			Отчет.Группировка.Удалить(ЭлементГруппировкиУдаление);
		КонецЦикла;
		
	Иначе
		Если ТипЗнч(Отчет.Счет) <> Тип("ПланСчетовСсылка.Единый") Тогда
			Отчет.Счет = ПредопределенноеЗначение("ПланСчетов.Единый.ПустаяСсылка");
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры	

Процедура УдалитьЗначенияОтборов_Рекурс(ГруппаЭлементовОтбора)
	
	МассивЭлементовКУдалению = Новый Массив;
		
	Для Каждого ЭлементОтбора Из ГруппаЭлементовОтбора.Элементы Цикл 
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда 
			УдалитьЗначенияОтборов_Рекурс(ЭлементОтбора);
		Иначе 
			Если СтрЧислоВхождений(Строка(ЭлементОтбора.ЛевоеЗначение) ,"ЛицевойСчет") > 0 Тогда 	
				МассивЭлементовКУдалению.Добавить(ЭлементОтбора);	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого УдаляемыйЭлемент Из МассивЭлементовКУдалению Цикл 
		ГруппаЭлементовОтбора.Элементы.Удалить(УдаляемыйЭлемент);
	КонецЦикла;
	
	Если ГруппаЭлементовОтбора.Элементы.Количество() = 0  
		И ТипЗнч(ГруппаЭлементовОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных")  
		И ГруппаЭлементовОтбора.Родитель <> Неопределено Тогда 
		ГруппаЭлементовОтбора.Родитель.Элементы.Удалить(ГруппаЭлементовОтбора);
	КонецЕсли;	
	
КонецПроцедуры	
	

