Функция ПолучитьЗависимостиНастроек() Экспорт
	
	СвязиНастроек = "";
		// Например:
		//"Настройка1	Настройка2
		//|Настройка1	Настройка3";
	
	КодыСвязанныхНастроек = Новый ТаблицаЗначений;
	КодыСвязанныхНастроек.Колонки.Добавить("КодНастройки",			Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(50)));
	КодыСвязанныхНастроек.Колонки.Добавить("КодСвязаннойНастройки",	Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(50)));
	
	Если СвязиНастроек <> "" Тогда
		
		Для Каждого СтрокаСвязиНастроек Из СтрРазделить(СвязиНастроек, Символы.ПС, Ложь) Цикл
			СвязьНастроек = СтрРазделить(СтрокаСвязиНастроек, Символы.Таб, Ложь);
			
			НоваяСтрока = КодыСвязанныхНастроек.Добавить();
			НоваяСтрока.КодНастройки			= СвязьНастроек[0];  
			НоваяСтрока.КодСвязаннойНастройки	= СвязьНастроек[1]; 
		КонецЦикла;
		
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыСвязанныхНастроек.КодНастройки КАК КодНастройки,
		|	КодыСвязанныхНастроек.КодСвязаннойНастройки КАК КодСвязаннойНастройки
		|ПОМЕСТИТЬ _КодыСвязанныхНастроек
		|ИЗ
		|	&КодыСвязанныхНастроек КАК КодыСвязанныхНастроек
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Настройки.Ссылка КАК Настройка,
		|	СвязанныеНастройки.Ссылка КАК СвязаннаяНастройка
		|ИЗ
		|	_КодыСвязанныхНастроек КАК _КодыСвязанныхНастроек
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.НастройкиОтчетов КАК Настройки
		|		ПО Настройки.Код = _КодыСвязанныхНастроек.КодНастройки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.НастройкиОтчетов КАК СвязанныеНастройки
		|		ПО СвязанныеНастройки.Код = _КодыСвязанныхНастроек.КодСвязаннойНастройки");
	
	Запрос.УстановитьПараметр("КодыСвязанныхНастроек", КодыСвязанныхНастроек);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Возвращает элемент ПВХ НастройкиОтчетов по переданному коду
//
//	Параметры:
//		- КодНастройки - код настройки
//
Функция ЗначениеНастройкиПоКоду(КодНастройки) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиОтчетов.Ссылка КАК Ссылка
		|ИЗ
		|	ПланВидовХарактеристик.НастройкиОтчетов КАК НастройкиОтчетов
		|ГДЕ
		|	НастройкиОтчетов.Код = &КодНастройки
		|	И НЕ НастройкиОтчетов.ПометкаУдаления");
	
	Запрос.УстановитьПараметр("КодНастройки", КодНастройки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		ВызватьИсключение "Не найдена настройка с кодом '" + КодНастройки + "'";
	КонецЕсли;	
	
КонецФункции