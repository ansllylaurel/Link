
Функция ДополнительныеНастройкиОбъекта(КлючОбъекта, КлючиНастроекОбъекта, Объект = Неопределено) Экспорт
	
	КлючиНастроекОбъекта = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(КлючиНастроекОбъекта, ",", Истина, Истина);
	
	Для Инд = 0 По КлючиНастроекОбъекта.ВГраница() Цикл
		КлючиНастроекОбъекта[Инд] = КлючОбъекта + "." + КлючиНастроекОбъекта[Инд];
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияДополнительныхСведений.Объект,
		|	ЗначенияДополнительныхСведений.Свойство.Ключ КАК Ключ,
		|	ЗначенияДополнительныхСведений.Значение
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Свойство.Ключ В(&Ключ)
		|	И &Объект";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Объект", ?(ЗначениеЗаполнено(Объект), "Объект = &Объект", "ИСТИНА"));
	
	Запрос.УстановитьПараметр("Ключ",   КлючиНастроекОбъекта);
	Запрос.УстановитьПараметр("Объект", Объект);
		
	ДополнительныеНастройки = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаДополнительныеНастройки Из ДополнительныеНастройки Цикл
		СтрокаДополнительныеНастройки.Ключ = Сред(СтрокаДополнительныеНастройки.Ключ, СтрДлина(КлючОбъекта) + 2);
	КонецЦикла;
	
	Возврат ДополнительныеНастройки;
	
КонецФункции // ДополнительныеНастройкиОбъекта

// Возвращает значение настройки, заданное для объекта, по переданому ключу
//
// Параметры:
//  ДополнительныеНастройки	 - ТаблицаЗначений, Неопределено - если передана таблица значений, то значение настройки берется из нее,
//															 - в прочих случаях - из регистра ЗначенияДополнительныхСведений
//  КлючНастройки			 - Строка - ключ настройки
//  Объект					 - Ссылка - ссылка на объект
// 
// Возвращаемое значение:
//  Характеристика.ДополнительныеСведения - значение настройки
//
Функция ЗначениеДополнительнойНастройки(ДополнительныеНастройки = Неопределено, КлючНастройки, Объект) Экспорт
	
	Если ТипЗнч(ДополнительныеНастройки) = Тип("ТаблицаЗначений") Тогда
		
		СтрокиДополнительныеНастройки = ДополнительныеНастройки.НайтиСтроки(
			Новый Структура("Объект, Ключ", Объект, КлючНастройки));
		
	Иначе
			
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗначенияДополнительныхСведений.Значение
			|ИЗ
			|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
			|ГДЕ
			|	ЗначенияДополнительныхСведений.Свойство.Ключ = &Ключ
			|	И ЗначенияДополнительныхСведений.Объект = &Объект";
			
		Запрос.УстановитьПараметр("Ключ",   КлючНастройки);
		Запрос.УстановитьПараметр("Объект", Объект);
		
		СтрокиДополнительныеНастройки = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;			
			
	Если СтрокиДополнительныеНастройки.Количество() > 0 Тогда
		Возврат СтрокиДополнительныеНастройки[0].Значение;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции // ЗначениеДополнительнойНастройки

// Записывает значение дополнительного сведения для объекта
//
//	Параметры:
// 		- Ссылка - Ссылка на объект
//		- ИмяКлюча - имя ключа доп. сведений
//		- Значение - значение для записи
//
Процедура ЗаписатьЗначениеДополнительногоСведенияОбъекта(Ссылка, ИмяКлюча, Значение) Экспорт 
				
	Свойство = ПланыВидовХарактеристик.ДополнительныеСведения.НайтиПоРеквизиту("Ключ", ИмяКлюча);
	
	Если Не ЗначениеЗаполнено(Свойство) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдено дополнительное сведение по ключу [" + ИмяКлюча + "]");
		Возврат;
	КонецЕсли;

	Запись = РегистрыСведений.ЗначенияДополнительныхСведений.СоздатьМенеджерЗаписи();
	Запись.Объект   = Ссылка;
	Запись.Свойство = Свойство;
	Запись.Прочитать();
	
	Если ЗначениеЗаполнено(Значение) Тогда  
	
		Если Не Запись.Выбран() Или Запись.Значение <> Значение Тогда
			
			Запись.Объект   = Ссылка;
			Запись.Свойство = Свойство;
			Запись.Значение = Значение;
			
			Попытка
				Запись.Записать();
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Не удалось записать значение '%1' в дополнительные сведения объекта '%2' %3 " " + Система сообщает: %4",
						Значение,
						Ссылка,
						Символы.ПС,
						ОписаниеОшибки()),
					Ссылка);
			КонецПопытки;
			
		КонецЕсли;
		
	Иначе
		
		Если Запись.Выбран() Тогда
			
			Попытка
				Запись.Удалить();
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Не удалось удалить значение '%1' из дополнительных сведений объекта '%2' %3 " " + Система сообщает: %4",
						Значение,
						Ссылка,
						Символы.ПС,
						ОписаниеОшибки()),
					Ссылка);
			КонецПопытки;
	
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

// даты в шаблоне должны представлять собой форматную строку, выделенную квадратными скобками.
Функция КаталогОтчетаДляОрганизации(Ключ, ИсточникСведений, Период = Неопределено, КаталогОтчета = "", Периодичность = Неопределено) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияДополнительныхСведений.Значение
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Объект = &Объект
		|	И ЗначенияДополнительныхСведений.Свойство.Ключ = &Ключ
		|	И ЗначенияДополнительныхСведений.Значение <> """"");
		
	Запрос.УстановитьПараметр("Объект", ИсточникСведений);
	Запрос.УстановитьПараметр("Ключ",   Ключ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		КаталогОтчета = Выборка.Значение;		
		
		Если ЗначениеЗаполнено(Период) ИЛИ ЗначениеЗаполнено(Периодичность) Тогда		
			
			Если Ключ = "СчетаДоверительногоУправления.ШаблонФайловОценочнойСтоимостиЦенныхБумагПредоставленнойКлиентом" И Период < '20210522' Тогда
				
				#Область Хардкод_пути_к_файлам_оценочной_стоимости_САФМАР_до_22_05_2021
				
				// #Техдолг #Хардкод #379217
				
				МассивСчетовСАФМАР = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
					ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар"),
					ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
					Период);
					
				Если МассивСчетовСАФМАР.Найти(ИсточникСведений) <> Неопределено Тогда
					
					ПозицияРазделителя = СтрНайти(КаталогОтчета, "\", НаправлениеПоиска.СКонца); // Через Файл.Путь не работает
					
					Если ПозицияРазделителя > 0 Тогда
						КаталогОтчета = Лев(КаталогОтчета, ПозицияРазделителя) + "СС_САФМАР_""гггг-ММ-дд"".xml";
					КонецЕсли;
					
				КонецЕсли;
			
				#КонецОбласти
					
			КонецЕсли;
		
			ПараметрыШаблона = Новый Структура;
			ПараметрыШаблона.Вставить("Период", Период);
			ПараметрыШаблона.Вставить("Периодичность", Периодичность);
		
			КаталогОтчета = ОбработатьПутьКФайлу(КаталогОтчета, ПараметрыШаблона);
			
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат КаталогОтчета;
	
КонецФункции

Функция ОбработатьПутьКФайлу(Шаблон, Параметры, Отказ = Ложь) Экспорт
	
	// Период - форматная строка периода, заключенная в двойные кавычки 	
	
	Период = Неопределено;	
	
	Если Параметры.Свойство("Период", Период) И ТипЗнч(Период) = Тип("Дата") Тогда
	
		ПутьКФайлу		= "";
		Форматировать	= (Лев(Шаблон, 1) = """");
		МассивПодстрок	= РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(Шаблон, """");
		
		Для Каждого Подстрока Из МассивПодстрок Цикл
			
			Если Форматировать Тогда
				ПутьКФайлу = ПутьКФайлу + Формат(Период, "ДФ='" + Подстрока + "'");
			Иначе
				ПутьКФайлу = ПутьКФайлу + Подстрока;
			КонецЕсли;
			
			Форматировать = Не Форматировать;
			
		КонецЦикла;
		
	Иначе
		
		ПутьКФайлу = Шаблон;
		
		Если СтрНайти(ПутьКФайлу, """") <> 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен или заполнен некорректно параметр ""Период""", , , , Отказ);	
		КонецЕсли;
		
	КонецЕсли;
	
	// %Периодичность% - Периодичность в формате "Ежедневные" и т.д.
	
	Периодичность = Неопределено;
	
	Параметры.Свойство("Периодичность", Периодичность);
	
	Если Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.ДваРазаВМесяц Тогда
		ИмяПериодичности = "Ежемесячные";
	ИначеЕсли Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.Ежегодно Тогда
		ИмяПериодичности = "Годовые";
	ИначеЕсли Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.Ежедневно Тогда
		ИмяПериодичности = "Ежедневные";
	ИначеЕсли Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.Ежеквартально Тогда
		ИмяПериодичности = "Квартальные";
	ИначеЕсли Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.Ежемесячно Тогда
		ИмяПериодичности = "Ежемесячные";
	ИначеЕсли Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.Еженедельно Тогда
		ИмяПериодичности = "Еженедельные";
	ИначеЕсли Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.ПоДекадам Тогда
		ИмяПериодичности = "Декады";
	Иначе
		ИмяПериодичности = "";
	КонецЕсли; 
	
	ПутьКФайлу = СтрЗаменить(ПутьКФайлу, "%Периодичность%", ИмяПериодичности);
	    		
	Если Лев(ПутьКФайлу, 2) = "\\" Тогда
		ПутьКФайлу = "\\" + СтрЗаменить(Сред(ПутьКФайлу, 3), "\\", "\");
	Иначе 
		ПутьКФайлу = СтрЗаменить(ПутьКФайлу, "\\", "\");
	КонецЕсли;
		
	Возврат ПутьКФайлу;

КонецФункции
