Функция ПолучитьСписокНастроекДляПереоценки() Экспорт

	МассивНастроек = Новый Массив();
	МассивНастроек.Добавить(ПланыВидовХарактеристик.НастройкиУчетаЦенныхБумаг.НачислятьКорректировкуЭСПВДеньОперации);
	МассивНастроек.Добавить(ПланыВидовХарактеристик.НастройкиУчетаЦенныхБумаг.НачислятьПроцентныеДоходыВДеньОперации);
	МассивНастроек.Добавить(ПланыВидовХарактеристик.НастройкиУчетаЦенныхБумаг.НачислятьПроцентныеДоходыВНерабочиеДни);
	МассивНастроек.Добавить(ПланыВидовХарактеристик.НастройкиУчетаЦенныхБумаг.ПереоцениватьВДеньОперации);
	МассивНастроек.Добавить(ПланыВидовХарактеристик.НастройкиУчетаЦенныхБумаг.ПереоцениватьВНерабочиеДни);
	МассивНастроек.Добавить(ПланыВидовХарактеристик.НастройкиУчетаЦенныхБумаг.ПериодичностьНачисленияКорректировкиЭСП);
	МассивНастроек.Добавить(ПланыВидовХарактеристик.НастройкиУчетаЦенныхБумаг.ПериодичностьНачисленияПроцентныхДоходов);
	МассивНастроек.Добавить(ПланыВидовХарактеристик.НастройкиУчетаЦенныхБумаг.ПериодичностьПереоценки);
	
	Возврат МассивНастроек;
	
КонецФункции
