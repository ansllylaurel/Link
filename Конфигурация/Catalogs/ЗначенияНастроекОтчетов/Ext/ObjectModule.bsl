
Процедура ПередЗаписью(Отказ)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ЗначенияНастроекОтчетов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЗначенияНастроекОтчетов КАК ЗначенияНастроекОтчетов
		|ГДЕ
		|	ЗначенияНастроекОтчетов.НастройкаОтчета = &НастройкаОтчета
		|	И ЗначенияНастроекОтчетов.Ключ = &Ключ
		|	И ЗначенияНастроекОтчетов.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("Ключ", ЭтотОбъект.Ключ);
	Запрос.УстановитьПараметр("НастройкаОтчета", ЭтотОбъект.НастройкаОтчета);
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ТекстОшибки = СтрШаблон("Для настройки ""%1"" уже существует значение с ключом ""%2""", ЭтотОбъект.НастройкаОтчета.Наименование, ЭтотОбъект.Ключ);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , , , Отказ);
	КонецЕсли;

КонецПроцедуры
