
Процедура ПередЗаписью(Отказ)
	
	Если ЭтотОбъект.ПредопределенныйВариант И Не ДополнительныеСвойства.Свойство("ОбновлениеВариантов") Тогда
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Изменение предопределенных вариантов отчетов запрещено!", , , , Отказ);
		
	ИначеЕсли НЕ ДополнительныеСвойства.Свойство("ОбновлениеВариантов") И Не ЭтотОбъект.ПометкаУдаления Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ВариантыОтчетов.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ВариантыОтчетов КАК ВариантыОтчетов
			|ГДЕ
			|	ВариантыОтчетов.Ссылка <> &Ссылка
			|	И НЕ ВариантыОтчетов.ПометкаУдаления
			|	И ВариантыОтчетов.Ключ = &Ключ
			|	И ВариантыОтчетов.Наименование = &Наименование
			|	И ВариантыОтчетов.Организация = &Организация
			|	И ВариантыОтчетов.Автор = &Автор
			|	И ВариантыОтчетов.Общий = &Общий
			|	И ВариантыОтчетов.Родитель = &Родитель";
		
		Запрос.УстановитьПараметр("Ключ", 			ЭтотОбъект.Ключ);
		Запрос.УстановитьПараметр("Ссылка", 		ЭтотОбъект.Ссылка);
		Запрос.УстановитьПараметр("Наименование", 	ЭтотОбъект.Наименование);
		Запрос.УстановитьПараметр("Организация", 	ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Автор", 			ЭтотОбъект.Автор);
		Запрос.УстановитьПараметр("Общий", 			ЭтотОбъект.Общий);
		Запрос.УстановитьПараметр("Родитель", 		ЭтотОбъект.Родитель);
		
		Если Не Запрос.Выполнить().Пустой() Тогда
		
			ТекстОшибки = "Имя """ + ЭтотОбъект.Наименование + """ занято, необходимо указать другое наименование.";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , , , Отказ);
		
		КонецЕсли; 
						
	КонецЕсли; 
	
КонецПроцедуры
