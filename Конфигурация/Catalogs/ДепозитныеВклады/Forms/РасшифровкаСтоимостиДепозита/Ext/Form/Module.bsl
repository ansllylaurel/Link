
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ДепозитныйВклад") Тогда
		ИсторияДепозитов = РаботаСКредитнымиИнструментами.ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправленияДляРасшифровки(Параметры.СчетДоверительногоУправления, Параметры.Период,Перечисления.ТипыКредитныхИнструментов.ДепозитныйВклад,,,, Параметры.ДепозитныйВклад).НайтиСтроки(Новый Структура("КредитныйИнструмент", Параметры.ДепозитныйВклад)); 
	ИначеЕсли Параметры.Свойство("КредитныйИнструмент") Тогда
		ИсторияДепозитов = РаботаСКредитнымиИнструментами.ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправленияДляРасшифровки(Параметры.СчетДоверительногоУправления, Параметры.Период,,,,, Параметры.КредитныйИнструмент).НайтиСтроки(Новый Структура("КредитныйИнструмент", Параметры.КредитныйИнструмент)); 
	Иначе
		ИсторияДепозитов = РаботаСКредитнымиИнструментами.ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправленияДляРасшифровки(Параметры.СчетДоверительногоУправления, Параметры.Период,Перечисления.ТипыКредитныхИнструментов.ДепозитныйВклад,,,, ); 
	КонецЕсли;
																			
	Макет = Справочники.ДепозитныеВклады.ПолучитьМакет("РашифровкаСтоимостиДепозита");
	
	ОбластьШапка	= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока	= Макет.ПолучитьОбласть("Строка");
	
	КредитныйИнструмент = "";
	
	Для Каждого СтрокаИстории Из ИсторияДепозитов Цикл
		Если КредитныйИнструмент <> СтрокаИстории.КредитныйИнструмент Тогда 
			ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, СтрокаИстории);
			Результат.Вывести(ОбластьШапка);
			
			КредитныйИнструмент = СтрокаИстории.КредитныйИнструмент;
		КонецЕсли;
		
		Если СтрокаИстории.Период <= КонецДня(Параметры.Период) + 1 Тогда
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаИстории);
			ОбластьСтрока.Параметры.Период = Мин(СтрокаИстории.Период, Параметры.Период);
			Результат.Вывести(ОбластьСтрока);
		КонецЕсли;
																			
	КонецЦикла;
	
КонецПроцедуры
