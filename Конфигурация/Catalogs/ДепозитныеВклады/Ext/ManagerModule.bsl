
Функция СформироватьНаименование(РеквизитыДепозита, ЗадействованныеРеквизиты = "") Экспорт

	ЗадействованныеРеквизиты = "БанковскийСчет, НомерПодтверждения, ДатаПодтверждения, МестоХранения";
	
	Если РеквизитыДепозита = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НаименованиеДепозита = "";
	
	Если ЗначениеЗаполнено(РеквизитыДепозита.БанковскийСчет) Тогда
		
		РеквизитыСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыДепозита.БанковскийСчет,
			Новый Структура("Банк, НомерДоговора, ДатаДоговора", "Банк", "Договор.НомерДоговора", "Договор.ДатаЗаключения"));
		
		НаименованиеДепозита =
			Строка(РеквизитыСчета.Банк)
			+ ?(РеквизитыДепозита.МестоХранения = Справочники.МестаХранения.ММВБ_ДепозитыСЦК, ", Депозит с ЦК, Сделка № ", ", № ")
			+ СокрЛП(РеквизитыСчета.НомерДоговора) + " от " + Формат(РеквизитыСчета.ДатаДоговора, "ДФ=dd.MM.yyyy")
			+ ?(ЗначениеЗаполнено(РеквизитыДепозита.НомерПодтверждения) И ЗначениеЗаполнено(РеквизитыДепозита.ДатаПодтверждения),
				" / " + РеквизитыДепозита.НомерПодтверждения + " от " + Формат(РеквизитыДепозита.ДатаПодтверждения, "ДФ=dd.MM.yyyy"), "");
		
	КонецЕсли;
	
	Возврат НаименованиеДепозита;

КонецФункции // СформироватьНаименование

// Функция - Получить доходность
//
// Параметры:
//  ДепозитныйВклад	- СправочникСсылка.ДепозитныеВклады - Ссылка на депозитный вклад
// 
// Возвращаемое значение:
//   Число			- значение доходности
//
Функция ПолучитьДоходностьИДюрацию(ДепозитныйВклад) Экспорт

	ТаблицаПлатежей = ДепозитныйВклад.ПлановыеВыплаты.Выгрузить(,"Период, Сумма");
	ТаблицаПлатежей.Свернуть("Период", "Сумма");
	
	Возврат БухгалтерскийУчет.РассчитатьДоходностьИДюрациюПоПотоку(ТаблицаПлатежей, ДепозитныйВклад.ДатаРегистрации, ДепозитныйВклад._НачальныйНоминал);

КонецФункции

// Функция - Расчитать стоимость
//
// Параметры:
//  ДепозитныйВклад	- СправочникСсылка.ДепозитныеВклады - Ссылка на депозитный вклад
//  ЭСП - эффективная ставка процента
//  ДатаРасчета - дата расчета
// 
// Возвращаемое значение:
//   Число			- Стоимость депозита
//
Функция РасчитатьСтоимость(ДепозитныйВклад, ЭСП, ДатаРасчета) Экспорт

	Стоимость = 0;
	
	Для каждого СтрокаТаблицыПлатежей Из ДепозитныйВклад.ПлановыеВыплаты Цикл
		
		Если СтрокаТаблицыПлатежей.Период < ДатаРасчета Тогда
			Продолжить;
		КонецЕсли; 
		
		КолДней = (НачалоДня(СтрокаТаблицыПлатежей.Период) - НачалоДня(ДатаРасчета)) / 86400;
		
		Стоимость = Стоимость + СтрокаТаблицыПлатежей.Сумма / Pow(1 + ЭСП / 100, КолДней / 365);
		
	КонецЦикла;
	
	Возврат Стоимость;

КонецФункции

// Функция - Расчитать стоимость по ЭСП
//
// Параметры:
//  ДепозитныйВклад	- СправочникСсылка.ДепозитныеВклады - Ссылка на депозитный вклад
//  ДатаРасчета - дата расчета
// 
// Возвращаемое значение:
//   Число			- Стоимость депозита
//
Функция РасчитатьСтоимостьПоЭСП(ДепозитныйВклад, ДатаРасчета, ЦельРасчета, РазрядностьОкругленияПромежуточныхРасчетовДепозитныхВкладов = 0) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(РасчетныеПоказателиДепозитногоВклада.Период) КАК Период
		|ПОМЕСТИТЬ ДатаПоказателя
		|ИЗ
		|	РегистрСведений.РасчетныеПоказателиДепозитногоВклада КАК РасчетныеПоказателиДепозитногоВклада
		|ГДЕ
		|	РасчетныеПоказателиДепозитногоВклада.ДепозитныйВклад = &ДепозитныйВклад
		|	И РасчетныеПоказателиДепозитногоВклада.Период < &Период
		|	И РасчетныеПоказателиДепозитногоВклада.ЦельРасчета = &ЦельРасчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДатаПоказателя.Период КАК ПериодСтавки,
		|	РасчетныеПоказателиДепозитногоВклада.ЭффективнаяСтавкаПроцента КАК ЭффективнаяСтавкаПроцента,
		|	РасчетныеПоказателиДепозитногоВклада.СтоимостьПоЭффективнойПроцентнойСтавке КАК СтоимостьПоЭффективнойПроцентнойСтавке
		|ИЗ
		|	ДатаПоказателя КАК ДатаПоказателя
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеПоказателиДепозитногоВклада КАК РасчетныеПоказателиДепозитногоВклада
		|		ПО ДатаПоказателя.Период = РасчетныеПоказателиДепозитногоВклада.Период
		|			И (РасчетныеПоказателиДепозитногоВклада.ДепозитныйВклад = &ДепозитныйВклад)
		|			И (РасчетныеПоказателиДепозитногоВклада.ЦельРасчета = &ЦельРасчета)";
	
	Запрос.УстановитьПараметр("ДепозитныйВклад",	ДепозитныйВклад);
	Запрос.УстановитьПараметр("Период", 			ДатаРасчета);
	Запрос.УстановитьПараметр("ЦельРасчета",		ЦельРасчета);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Стоимость = 0;
		
		Для каждого СтрокаТаблицыПлатежей Из ДепозитныйВклад.ПлановыеВыплаты Цикл
			
			Если СтрокаТаблицыПлатежей.Период < ВыборкаДетальныеЗаписи.ПериодСтавки Тогда
				Продолжить;
			КонецЕсли;
			
			КолДней = (НачалоДня(СтрокаТаблицыПлатежей.Период) - НачалоДня(ДатаРасчета)) / 86400;
			
			ДисконтированныйПоток = СтрокаТаблицыПлатежей.Сумма / Pow(1 + ВыборкаДетальныеЗаписи.ЭффективнаяСтавкаПроцента / 100, КолДней / 365);
			
			Если РазрядностьОкругленияПромежуточныхРасчетовДепозитныхВкладов > 0 Тогда
				ДисконтированныйПоток = Окр(ДисконтированныйПоток, РазрядностьОкругленияПромежуточныхРасчетовДепозитныхВкладов);
			КонецЕсли;
			
			Стоимость = Стоимость + ДисконтированныйПоток;
			
		КонецЦикла;
		
		Возврат Стоимость;
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для депозита " + СокрЛП(ДепозитныйВклад.Наименование) + " не заполнены расчетные данные!", ДепозитныйВклад);
		Возврат Неопределено;
	
	КонецЕсли;

КонецФункции

Функция ПолучитьПериодичностьВыплатыПроцентов(ДепозитныйВклад, Дата) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	УсловияКредитныхИнструментовСрезПоследних.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов
		|ИЗ
		|	РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
		|			&Дата,
		|			ДатаНачалаДействияУсловий <= &ДатаПериода
		|				И КредитныйИнструмент = &ДепозитныйВклад) КАК УсловияКредитныхИнструментовСрезПоследних
		|ГДЕ
		|	УсловияКредитныхИнструментовСрезПоследних.Действует
		|
		|УПОРЯДОЧИТЬ ПО
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий УБЫВ";
		
	Запрос.УстановитьПараметр("Дата",                       Дата);
	Запрос.УстановитьПараметр("ДатаПериода",                СистемныеФункции.ПолучитьДатуИзГраницы(Дата));
	Запрос.УстановитьПараметр("ДепозитныйВклад", ДепозитныйВклад);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Возврат Выборка.ПериодичностьВыплатыПроцентов;
	КонецЦикла;

	Возврат Перечисления.ПериодичностиВыплатыПроцентов.ПустаяСсылка();
	
КонецФункции	

Функция ОпределитьУчетныйАктивДепозита(ДепозитныйВклад, Дата) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	УсловияКредитныхИнструментовСрезПоследних.УчетныйАктив КАК УчетныйАктив
		|ИЗ
		|	РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
		|			&Период,
		|			ДатаНачалаДействияУсловий <= &ДатаПериода
		|				И КредитныйИнструмент = &ДепозитныйВклад) КАК УсловияКредитныхИнструментовСрезПоследних
		|ГДЕ
		|	УсловияКредитныхИнструментовСрезПоследних.Действует
		|
		|УПОРЯДОЧИТЬ ПО
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий УБЫВ";
	
	Запрос.УстановитьПараметр("ДепозитныйВклад", ДепозитныйВклад);
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("ДатаПериода", СистемныеФункции.ПолучитьДатуИзГраницы(Дата));
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.УчетныйАктив;
	Иначе
		Возврат Справочники.УчетныеАктивыЕПС.ДепозитныеВкладыПоАС;
	КонецЕсли;

КонецФункции

//Функция Получить депозитные вклады по банковскому счёту
//
// Параметры:
//  БанковскийСчет	- СправочникСсылка.БанковскиеСчета - Ссылка на банковский счет
//	ИсключаяДепозитныйВклад - СправочникСсылка.ДепозитныеВклады - Ссылка на депозитный вклад, над которым выполняется операция, он будет исключён из выборки
// 
// Возвращаемое значение:
//   Массив	- массив депозитных вкладов с отбором по банковскому счёты и не помеченные на удаление
//
Функция ПолучитьДепозитныеВкладыПоБанковскомуСчету(БанковскийСчет, ИсключаяДепозитныйВклад) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("БанковскийСчет", 			БанковскийСчет);
	Запрос.УстановитьПараметр("ИсключаяДепозитныйВклад",	ИсключаяДепозитныйВклад);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитныеВклады.Ссылка КАК ДепозитныйВклад
		|ИЗ
		|	Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|ГДЕ
		|	ДепозитныеВклады.БанковскийСчет = &БанковскийСчет
		|	И НЕ ДепозитныеВклады.ПометкаУдаления
		|	И ДепозитныеВклады.Ссылка <> &ИсключаяДепозитныйВклад";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДепозитныйВклад");
	
КонецФункции

Функция ПолучитьРасчетВыплат(ДепозитныйВкладСсылка) Экспорт
	
	ПлановыеВыплаты = Новый ТаблицаЗначений;
	ПлановыеВыплаты.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	ПлановыеВыплаты.Колонки.Добавить("Сумма", Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип.Типы()));
	ПлановыеВыплаты.Колонки.Добавить("Тип", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыВыплатПоДепозитнымВкладам"));

	Запрос = Новый Запрос;

#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияКредитныхИнструментов.КредитныйИнструмент КАК ДепозитныйВклад,
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(УсловияКредитныхИнструментов.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).ДатаНачалаНачисленияПроцентов > УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий
		|			ТОГДА ВЫРАЗИТЬ(УсловияКредитныхИнструментов.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).ДатаНачалаНачисленияПроцентов
		|		ИНАЧЕ УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий
		|	КОНЕЦ КАК Период,
		|	УсловияКредитныхИнструментов.ПериодичностьВыплатыПроцентов КАК Периодичность,
		|	УсловияКредитныхИнструментов.Процент КАК Процент,
		|	УсловияКредитныхИнструментов.ДатаПогашения КАК ДатаПогашения
		|ПОМЕСТИТЬ _УсловияДепозитаПредварительная
		|ИЗ
		|	РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(, КредитныйИнструмент = &ДепозитныйВкладСсылка) КАК УсловияКредитныхИнструментов
		|ГДЕ
		|	УсловияКредитныхИнструментов.Действует
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_УсловияДепозита.ДепозитныйВклад КАК ДепозитныйВклад,
		|	_УсловияДепозита.Период КАК Период,
		|	_УсловияДепозита.Периодичность КАК Периодичность,
		|	_УсловияДепозита.Процент КАК Процент,
		|	_УсловияДепозита.ДатаПогашения КАК ДатаПогашения,
		|	МИНИМУМ(УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий) КАК СледующийПериод
		|ПОМЕСТИТЬ _УсловияДепозитовСледующийПериод
		|ИЗ
		|	_УсловияДепозитаПредварительная КАК _УсловияДепозита
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(, КредитныйИнструмент = &ДепозитныйВкладСсылка) КАК УсловияКредитныхИнструментов
		|		ПО _УсловияДепозита.ДепозитныйВклад = УсловияКредитныхИнструментов.КредитныйИнструмент
		|			И _УсловияДепозита.Период < УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий  И УсловияКредитныхИнструментов.Действует
		|
		|СГРУППИРОВАТЬ ПО
		|	_УсловияДепозита.ДепозитныйВклад,
		|	_УсловияДепозита.Период,
		|	_УсловияДепозита.Периодичность,
		|	_УсловияДепозита.Процент,
		|	_УсловияДепозита.ДатаПогашения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_УсловияДепозитовСледующийПериод.ДепозитныйВклад КАК ДепозитныйВклад,
		|	_УсловияДепозитовСледующийПериод.Период КАК НачалоУсловий,
		|	_УсловияДепозитовСледующийПериод.Периодичность КАК Периодичность,
		|	_УсловияДепозитовСледующийПериод.Процент КАК Процент,
		|	ВЫБОР
		|		КОГДА _УсловияДепозитовСледующийПериод.СледующийПериод ЕСТЬ NULL
		|			ТОГДА _УсловияДепозитовСледующийПериод.ДатаПогашения
		|		ИНАЧЕ ДОБАВИТЬКДАТЕ(_УсловияДепозитовСледующийПериод.СледующийПериод, ДЕНЬ, -1)
		|	КОНЕЦ КАК ОкончаниеУсловий,
		|	_УсловияДепозитовСледующийПериод.СледующийПериод ЕСТЬ NULL КАК ПоследнийПериод
		|ПОМЕСТИТЬ _УсловияДепозитов
		|ИЗ
		|	_УсловияДепозитовСледующийПериод КАК _УсловияДепозитовСледующийПериод
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_УсловияДепозитов.ДепозитныйВклад КАК ДепозитныйВклад,
		|	_УсловияДепозитов.НачалоУсловий КАК НачалоПериода,
		|	_УсловияДепозитов.Периодичность КАК Периодичность,
		|	_УсловияДепозитов.Процент КАК Процент,
		|	_УсловияДепозитов.ОкончаниеУсловий КАК ОкончаниеПериода,
		|	_УсловияДепозитов.ДепозитныйВклад._НачальныйНоминал КАК Сумма,
		|	_УсловияДепозитов.ПоследнийПериод КАК ПоследнийПериод
		|ИЗ
		|	_УсловияДепозитов КАК _УсловияДепозитов";
#КонецОбласти
	
	Запрос.УстановитьПараметр("ДепозитныйВкладСсылка", ДепозитныйВкладСсылка);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДатаНачалаПериодаРасчетаПроцентов = ВыборкаДетальныеЗаписи.НачалоПериода;
		
		Пока ДатаНачалаПериодаРасчетаПроцентов <= ВыборкаДетальныеЗаписи.ОкончаниеПериода Цикл
			
			Если ВыборкаДетальныеЗаписи.Периодичность = Перечисления.ПериодичностиВыплатыПроцентов.Ежемесячно Тогда
				ДатаОкончанияПериодаРасчетаПроцентов = НачалоДня(КонецМесяца(ДатаНачалаПериодаРасчетаПроцентов));
			ИначеЕсли ВыборкаДетальныеЗаписи.Периодичность = Перечисления.ПериодичностиВыплатыПроцентов.Ежеквартально Тогда
				ДатаОкончанияПериодаРасчетаПроцентов = НачалоДня(КонецКвартала(ДатаНачалаПериодаРасчетаПроцентов));
			Иначе // Добавить другие варианты периодичности
				ДатаОкончанияПериодаРасчетаПроцентов = ВыборкаДетальныеЗаписи.ОкончаниеПериода;
			КонецЕсли;
			
			Если ДатаОкончанияПериодаРасчетаПроцентов > ВыборкаДетальныеЗаписи.ОкончаниеПериода Тогда
				ДатаОкончанияПериодаРасчетаПроцентов = ВыборкаДетальныеЗаписи.ОкончаниеПериода;
			КонецЕсли;
			
			Дни = РасчетВисокосныхИОбычныхДней(ДатаНачалаПериодаРасчетаПроцентов, ДатаОкончанияПериодаРасчетаПроцентов);
			
			НоваяСтрока			= ПлановыеВыплаты.Добавить();
			НоваяСтрока.Период	= ДатаОкончанияПериодаРасчетаПроцентов;
			НоваяСтрока.Сумма	= ВыборкаДетальныеЗаписи.Сумма * ВыборкаДетальныеЗаписи.Процент / 100 * (Дни["Дней365"] / 365 + Дни["Дней366"] / 366);
			НоваяСтрока.Тип		= Перечисления.ТипыВыплатПоДепозитнымВкладам.Проценты;
			
			Если ДатаОкончанияПериодаРасчетаПроцентов = ВыборкаДетальныеЗаписи.ОкончаниеПериода И ВыборкаДетальныеЗаписи.ПоследнийПериод Тогда
			
				НоваяСтрока			= ПлановыеВыплаты.Добавить();
				НоваяСтрока.Период	= ДатаОкончанияПериодаРасчетаПроцентов;
				НоваяСтрока.Сумма	= ВыборкаДетальныеЗаписи.Сумма;
				НоваяСтрока.Тип		= Перечисления.ТипыВыплатПоДепозитнымВкладам.ОсновнойДолг;
			
			КонецЕсли;
			
			ДатаНачалаПериодаРасчетаПроцентов = ДатаОкончанияПериодаРасчетаПроцентов + 86400;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ПлановыеВыплаты; 
	
КонецФункции

Функция РасчетВисокосныхИОбычныхДней(НачальнаяДата, КонечнаяДата)

	_ТекущаяДата = НачальнаяДата;
	
	Дней366	= 0;
	Дней365	= 0;
	
	Пока _ТекущаяДата <= КонечнаяДата Цикл
		Если ДеньГода(КонецГода(_ТекущаяДата)) = 366 Тогда
			Дней366 = Дней366 + 1;
		Иначе
			Дней365 = Дней365 + 1;
		КонецЕсли; 
		_ТекущаяДата = _ТекущаяДата + 86400;
	КонецЦикла;
	
	Возврат Новый Структура("Дней365,Дней366", Дней365, Дней366);

КонецФункции

Функция СоздатьЗакрытияКредитныхИнструментов(Организация, ДатаЗакрытия, КредитныеИнструменты) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Если ТипЗнч(КредитныеИнструменты) = Тип("ТаблицаЗначений") Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КредитныеИнструменты.КредитныйИнструмент КАК Ссылка
			|ПОМЕСТИТЬ _КредитныеИнструменты
			|ИЗ
			|	&КредитныеИнструменты КАК КредитныеИнструменты";
		
	ИначеЕсли ТипЗнч(КредитныеИнструменты) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда 
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&КредитныеИнструменты КАК Ссылка
			|ПОМЕСТИТЬ _КредитныеИнструменты";
		
	Иначе
		
		ВызватьИсключение "Не удалось создать закрытие кредитного инструмента. Данные для закрытия депозитного вклада не соответствует формату";
		       			
	КонецЕсли;
	
	Запрос.УстановитьПараметр("КредитныеИнструменты",	КредитныеИнструменты);
	
	Запрос.Выполнить();
	
	#Область Текст_основного_запроса

	Запрос.Текст =		
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий КАК ДатаНачалаДействияУсловий,
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
		|	УсловияКредитныхИнструментовСрезПоследних.Действует КАК Действует,
		|	УсловияКредитныхИнструментовСрезПоследних.Период КАК Период,
		|	УсловияКредитныхИнструментовСрезПоследних.РасчетныйСчетВозвратаДенежныхСредств КАК РасчетныйСчетВозвратаДенежныхСредств
		|ПОМЕСТИТЬ _УсловияКредитныхИнструментов
		|ИЗ
		|	РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
		|			&ДатаЗакрытия,
		|			Организация = &Организация
		|				И КредитныйИнструмент В
		|					(ВЫБРАТЬ
		|						_КредитныеИнструменты.Ссылка
		|					ИЗ
		|						_КредитныеИнструменты КАК _КредитныеИнструменты)) КАК УсловияКредитныхИнструментовСрезПоследних
		|ГДЕ
		|	УсловияКредитныхИнструментовСрезПоследних.Действует
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_УсловияКредитныхИнструментов.КредитныйИнструмент КАК КредитныйИнструмент,
		|	_УсловияКредитныхИнструментов.ДатаПогашения КАК ДатаПогашения,
		|	_УсловияКредитныхИнструментов.РасчетныйСчетВозвратаДенежныхСредств КАК РасчетныйСчетВозвратаДенежныхСредств
		|ПОМЕСТИТЬ _АкутальныеУсловияКредитныхИнструментов
		|ИЗ
		|	_УсловияКредитныхИнструментов КАК _УсловияКредитныхИнструментов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_УсловияКредитныхИнструментов.КредитныйИнструмент КАК КредитныйИнструмент,
		|			МАКСИМУМ(_УсловияКредитныхИнструментов.Период) КАК Период,
		|			МАКСИМУМ(_УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
		|		ИЗ
		|			_УсловияКредитныхИнструментов КАК _УсловияКредитныхИнструментов
		|		ГДЕ
		|			_УсловияКредитныхИнструментов.Действует
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_УсловияКредитныхИнструментов.КредитныйИнструмент) КАК ВложенныйЗапрос
		|		ПО _УсловияКредитныхИнструментов.КредитныйИнструмент = ВложенныйЗапрос.КредитныйИнструмент
		|			И _УсловияКредитныхИнструментов.Период = ВложенныйЗапрос.Период
		|			И _УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий = ВложенныйЗапрос.ДатаНачалаДействияУсловий
		|ГДЕ
		|	_УсловияКредитныхИнструментов.ДатаПогашения = &ДатаЗакрытия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДенежныеСредстваВКредитныхИнструментахОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДенежныеСредстваВКредитныхИнструментахОстатки.СуммаОстаток КАК СуммаОстаток,
		|	_АкутальныеУсловияКредитныхИнструментов.КредитныйИнструмент КАК КредитныйИнструмент,
		|	_АкутальныеУсловияКредитныхИнструментов.ДатаПогашения КАК ДатаПогашения,
		|	_АкутальныеУсловияКредитныхИнструментов.РасчетныйСчетВозвратаДенежныхСредств КАК РасчетныйСчетВозвратаДенежныхСредств
		|ПОМЕСТИТЬ _ДенежныеСредстваВКредитныхИнструментахОстатки
		|ИЗ
		|	_АкутальныеУсловияКредитныхИнструментов КАК _АкутальныеУсловияКредитныхИнструментов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.Остатки(
		|				&ДатаЗакрытияКонецДня,
		|				Организация = &Организация
		|					И КредитныйИнструмент В
		|						(ВЫБРАТЬ
		|							_АкутальныеУсловияКредитныхИнструментов.КредитныйИнструмент
		|						ИЗ
		|							_АкутальныеУсловияКредитныхИнструментов КАК _АкутальныеУсловияКредитныхИнструментов)) КАК ДенежныеСредстваВКредитныхИнструментахОстатки
		|		ПО (ДенежныеСредстваВКредитныхИнструментахОстатки.Организация = &Организация)
		|			И (ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент = _АкутальныеУсловияКредитныхИнструментов.КредитныйИнструмент)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДенежныеСредстваВКредитныхИнструментахОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент КАК КредитныйИнструмент,
		|	_ДенежныеСредстваВКредитныхИнструментахОстатки.ДатаПогашения КАК ДатаПогашения,
		|	_ДенежныеСредстваВКредитныхИнструментахОстатки.РасчетныйСчетВозвратаДенежныхСредств КАК РасчетныйСчетВозвратаДенежныхСредств,
		|	_ДенежныеСредстваВКредитныхИнструментахОстатки.СуммаОстаток КАК СуммаОстаток,
		|	ВЫРАЗИТЬ(_ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).ДатаНачалаНачисленияПроцентов КАК НачалоПериодаНачисленияПроцентов,
		|	ДепозитныеВкладыПлановыеВыплаты.Сумма КАК СуммаПроцентов,
		|	НоминалыКредитныхИнструментовСрезПоследних.Сумма КАК Сумма
		|ПОМЕСТИТЬ _ДанныеДляФормированияДокументовЗакрытия
		|ИЗ
		|	_ДенежныеСредстваВКредитныхИнструментахОстатки КАК _ДенежныеСредстваВКредитныхИнструментахОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады.ПлановыеВыплаты КАК ДепозитныеВкладыПлановыеВыплаты
		|		ПО _ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент = ДепозитныеВкладыПлановыеВыплаты.Ссылка
		|			И _ДенежныеСредстваВКредитныхИнструментахОстатки.ДатаПогашения = ДепозитныеВкладыПлановыеВыплаты.Период
		|			И (ДепозитныеВкладыПлановыеВыплаты.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыВыплатПоДепозитнымВкладам.Проценты))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыКредитныхИнструментов.СрезПоследних(
		|				&ДатаЗакрытия,
		|				Организация = &Организация
		|					И КредитныйИнструмент В
		|						(ВЫБРАТЬ
		|							_АкутальныеУсловияКредитныхИнструментов.КредитныйИнструмент
		|						ИЗ
		|							_АкутальныеУсловияКредитныхИнструментов КАК _АкутальныеУсловияКредитныхИнструментов)) КАК НоминалыКредитныхИнструментовСрезПоследних
		|		ПО _ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент = НоминалыКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АкутальныеУсловияКредитныхИнструментов.КредитныйИнструмент КАК КредитныйИнструмент,
		|	""В условиях кредитного инструмента [%1] не указан счет возврата денежных средств."" КАК ТекстОшибки
		|ПОМЕСТИТЬ _ОшибкиРазмещений
		|ИЗ
		|	_АкутальныеУсловияКредитныхИнструментов КАК _АкутальныеУсловияКредитныхИнструментов
		|ГДЕ
		|	_АкутальныеУсловияКредитныхИнструментов.РасчетныйСчетВозвратаДенежныхСредств = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
		|	И ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(_АкутальныеУсловияКредитныхИнструментов.КредитныйИнструмент) = ТИП(Справочник.ДепозитныеВклады)
		|				ТОГДА _АкутальныеУсловияКредитныхИнструментов.КредитныйИнструмент.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_АкутальныеУсловияКредитныхИнструментов.КредитныйИнструмент,
		|	""По кредитному инструменту [%1] отсутствует остаток в регистре [Денежные средства в кредитных инструментах] на дату закрытия.""
		|ИЗ
		|	_АкутальныеУсловияКредитныхИнструментов КАК _АкутальныеУсловияКредитныхИнструментов
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДенежныеСредстваВКредитныхИнструментахОстатки КАК _ДенежныеСредстваВКредитныхИнструментахОстатки
		|		ПО _АкутальныеУсловияКредитныхИнструментов.КредитныйИнструмент = _ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент
		|ГДЕ
		|	_ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент,
		|	""Для кредитного инструмента [%1] уже создан документ закрытия. Документ находится в состоянии [ЗАПИСАН].""
		|ИЗ
		|	_ДенежныеСредстваВКредитныхИнструментахОстатки КАК _ДенежныеСредстваВКредитныхИнструментахОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗакрытиеКредитногоИнструмента КАК ЗакрытиеКредитногоИнструмента
		|		ПО _ДенежныеСредстваВКредитныхИнструментахОстатки.СчетДоверительногоУправления = ЗакрытиеКредитногоИнструмента.СчетДоверительногоУправления
		|			И _ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент = ЗакрытиеКредитногоИнструмента.КредитныйИнструмент
		|			И (ЗакрытиеКредитногоИнструмента.Организация = &Организация)
		|ГДЕ
		|	НЕ ЗакрытиеКредитногоИнструмента.ПометкаУдаления
		|	И НЕ ЗакрытиеКредитногоИнструмента.Проведен
		|	И НАЧАЛОПЕРИОДА(ЗакрытиеКредитногоИнструмента.Дата, ДЕНЬ) = &ДатаЗакрытия
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ДанныеДляФормированияДокументовЗакрытия.КредитныйИнструмент,
		|	""У кредитного инструмента [%1] сумма остатка в регистре [Денежные средства в кредитных инструментах] не соответствует размеру номинала в регистре [Номиналы кредитных инструментов] на дату закрытия.""
		|ИЗ
		|	_ДанныеДляФормированияДокументовЗакрытия КАК _ДанныеДляФормированияДокументовЗакрытия
		|ГДЕ
		|	_ДанныеДляФормированияДокументовЗакрытия.СуммаОстаток <> _ДанныеДляФормированияДокументовЗакрытия.Сумма
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_ДанныеДляФормированияДокументовЗакрытия.КредитныйИнструмент,
		|	""Для кредитного инструмента [%1] не удалось получить сумму процентов на дату закрытия. Возможно не заполнены плановые выплаты.""
		|ИЗ
		|	_ДанныеДляФормированияДокументовЗакрытия КАК _ДанныеДляФормированияДокументовЗакрытия
		|ГДЕ
		|	_ДанныеДляФормированияДокументовЗакрытия.СуммаПроцентов ЕСТЬ NULL
		|	И ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(_ДанныеДляФормированияДокументовЗакрытия.КредитныйИнструмент) = ТИП(Справочник.ДепозитныеВклады)
		|				ТОГДА _ДанныеДляФормированияДокументовЗакрытия.КредитныйИнструмент.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_КредитныеИнструменты.Ссылка,
		|	""В условиях кредитного инструмента [%1] дата погашения не соответствует текущей дате. Документ [Закрытие кредитного инструмента] не будет создан.""
		|ИЗ
		|	_КредитныеИнструменты КАК _КредитныеИнструменты
		|		ЛЕВОЕ СОЕДИНЕНИЕ _АкутальныеУсловияКредитныхИнструментов КАК _АкутальныеУсловияКредитныхИнструментов
		|		ПО _КредитныеИнструменты.Ссылка = _АкутальныеУсловияКредитныхИнструментов.КредитныйИнструмент
		|ГДЕ
		|	_АкутальныеУсловияКредитныхИнструментов.КредитныйИнструмент ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_АкутальныеУсловияКредитныхИнструментов.КредитныйИнструмент,
		|	""Кредитный инструмент [%1] помечен на удаление. Документ [Закрытие кредитного инструмента] не будет создан.""
		|ИЗ
		|	_АкутальныеУсловияКредитныхИнструментов КАК _АкутальныеУсловияКредитныхИнструментов
		|ГДЕ
		|	ВЫРАЗИТЬ(_АкутальныеУсловияКредитныхИнструментов.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ДатаЗакрытия КАК Дата,
		|	&Организация КАК Организация,
		|	_ДанныеДляФормированияДокументовЗакрытия.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДанныеДляФормированияДокументовЗакрытия.КредитныйИнструмент КАК КредитныйИнструмент,
		|	_ДанныеДляФормированияДокументовЗакрытия.РасчетныйСчетВозвратаДенежныхСредств КАК РасчетныйСчет,
		|	_ДанныеДляФормированияДокументовЗакрытия.СуммаОстаток КАК Сумма,
		|	_ДанныеДляФормированияДокументовЗакрытия.СуммаПроцентов КАК СуммаПроцентов,
		|	_ДанныеДляФормированияДокументовЗакрытия.НачалоПериодаНачисленияПроцентов КАК НачалоПериода,
		|	_ДанныеДляФормированияДокументовЗакрытия.ДатаПогашения КАК ОкончаниеПериода,
		|	ЗНАЧЕНИЕ(Перечисление.РежимыЗакрытияКредитногоИнструмента.Полное) КАК РежимЗакрытия,
		|	ЛОЖЬ КАК ОтложеннаяОплата,
		|	ЛОЖЬ КАК ЧастичныйПриходПроцентов
		|ИЗ
		|	_ДанныеДляФормированияДокументовЗакрытия КАК _ДанныеДляФормированияДокументовЗакрытия
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиРазмещений КАК _ОшибкиРазмещений
		|		ПО _ДанныеДляФормированияДокументовЗакрытия.КредитныйИнструмент = _ОшибкиРазмещений.КредитныйИнструмент
		|ГДЕ
		|	_ОшибкиРазмещений.КредитныйИнструмент ЕСТЬ NULL";
	
	#КонецОбласти
	
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("ДатаЗакрытия",					ДатаЗакрытия);
    Запрос.УстановитьПараметр("ДатаЗакрытияКонецДня", 			КонецДня(ДатаЗакрытия));
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВыборкаОшибок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиРазмещений"].ПолучитьДанные().Выбрать();
	
	Пока ВыборкаОшибок.Следующий() Цикл
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при создании закрытия кредитного инструмента. " + СтрШаблон(ВыборкаОшибок.ТекстОшибки, ВыборкаОшибок.КредитныйИнструмент));
		
	КонецЦикла;
	
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
	
		ЗакрытиеКредитногоИнструмента = Документы.ЗакрытиеКредитногоИнструмента.СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(ЗакрытиеКредитногоИнструмента, Выборка);
		ЗакрытиеКредитногоИнструмента.Ответственный = РаботаСПользователями.ТекущийПользователь();
		
		Если РаботаСДокументами.ЗаписатьПровестиДокумент(ЗакрытиеКредитногоИнструмента) Тогда
			Результат.Добавить(ЗакрытиеКредитногоИнструмента.Ссылка);
		КонецЕсли;
					
	КонецЦикла;
	
	Возврат ?(Результат.Количество() = 0, Неопределено, Результат);
		
КонецФункции

Функция БылиДвиженияПоДепозиту(Депозит, Организация) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ДенежныеСредстваВКредитныхИнструментах.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах КАК ДенежныеСредстваВКредитныхИнструментах
		|ГДЕ
		|	ДенежныеСредстваВКредитныхИнструментах.Организация = &Организация
		|	И ДенежныеСредстваВКредитныхИнструментах.КредитныйИнструмент = &КредитныйИнструмент
		|	И ДенежныеСредстваВКредитныхИнструментах.Активность";
	
	Запрос.УстановитьПараметр("КредитныйИнструмент", Депозит);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции
