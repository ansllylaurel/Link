
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, "Элемент, Группа, СписокГрупп, ПараметрыПолей");
	
	Если Параметры.ТолькоПросмотр Тогда
	
		Элементы.РежимОтбора.ТолькоПросмотр = Истина;
		Элементы.Группа1.ТолькоПросмотр = Истина;
	
	КонецЕсли; 
	
	Если Параметры.Свойство("ВключаяФилиалы") Тогда
		ЭтаФорма.ВключаяФилиалы = Параметры.ВключаяФилиалы;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ЭтаФорма.Группа) Тогда
		
		ЭтаФорма.РежимОтбора = "ПоГруппе";
		ЭтаФорма.ГруппаИмя = СписокГрупп.НайтиПоЗначению(ЭтаФорма.Группа).Представление;
		
	Иначе
		
		// даже если элемент не задан - открываем форму в этом режиме
		ЭтаФорма.РежимОтбора = "ПоЭлементу";
		
	КонецЕсли; 
	
	ЭлементРежимПоЭлементу = Элементы.РежимОтбора.СписокВыбора.НайтиПоЗначению("ПоЭлементу");
	Если ПараметрыПолей.ПолеЭлемент = "Эмитент" Тогда
		
		Элементы.Элемент.Заголовок = "Эмитент";
		Элементы.Элемент.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица");
		Элементы.ГруппаИмя.Заголовок = "Группа эмитентов";
		ЭлементРежимПоЭлементу.Представление = "По эмитенту";
		
	ИначеЕсли ПараметрыПолей.ПолеЭлемент = "ЦеннаяБумага" Тогда
		
		МассивТипов = Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип.Типы();
		МассивТипов.Добавить(Тип("СправочникСсылка.БазовыеСтавкиОблигаций"));
		Элементы.Элемент.Заголовок = "Ценная бумага";
		Элементы.Элемент.ОграничениеТипа = Новый ОписаниеТипов(МассивТипов);
		Элементы.ГруппаИмя.Заголовок = "Группа ценных бумаг";
		ЭлементРежимПоЭлементу.Представление = "По ценной бумаге";
		
	КонецЕсли; 
	
	УстановитьВидимостьПоРежимуОтбора(ЭтаФорма);
		
КонецПроцедуры

&НаКлиенте
Процедура ГруппаИмяНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЭтаФорма.СписокГрупп.Количество() = 0 Тогда
		Предупреждение("Отсутствуют группы эмитентов. Сначала создайте группы, а затем назначьте их наборам.");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Список", СписокГрупп);
	
	Если ПараметрыПолей.ПолеЭлемент = "Эмитент" Тогда
		ПараметрыФормы.Вставить("Заголовок", "Группы эмитентов");
	ИначеЕсли ПараметрыПолей.ПолеЭлемент = "ЦеннаяБумага" Тогда
		ПараметрыФормы.Вставить("Заголовок", "Группы ценных бумаг");
	КонецЕсли;
	
	ВыбГруппа = ОткрытьФормуМодально("ОбщаяФорма.ВыборИзСпискаСФильтрацией", ПараметрыФормы);
	
	Если ЗначениеЗаполнено(ВыбГруппа) Тогда
		
		ЭтаФорма.Группа    = ВыбГруппа;
		ЭтаФорма.ГруппаИмя = СписокГрупп.НайтиПоЗначению(ВыбГруппа).Представление;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаИмяОчистка(Элемент, СтандартнаяОбработка)
	
	ЭтаФорма.Группа = Неопределено;
	ЭтаФорма.ГруппаИмя = "";
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	
	Результат = Новый Структура;
	
	Результат.Вставить(ПараметрыПолей.ПолеЭлемент, Неопределено);
	Результат.Вставить(ПараметрыПолей.ПолеГруппа, Неопределено);
	Результат.Вставить(ПараметрыПолей.ПолеГруппаИмя, Неопределено);
	
	Если ПараметрыПолей.Свойство("ПолеВключаяФилиалы") Тогда
		Результат.Вставить("ВключаяФилиалы", ЭтаФорма.ВключаяФилиалы);
	КонецЕсли; 
	
	Если ЭтаФорма.РежимОтбора = "ПоЭлементу" И ЗначениеЗаполнено(ЭтаФорма.Элемент) Тогда
		Результат.Вставить(ПараметрыПолей.ПолеЭлемент, ЭтаФорма.Элемент);
	ИначеЕсли ЭтаФорма.РежимОтбора = "ПоГруппе" И ЗначениеЗаполнено(ЭтаФорма.Группа) Тогда 
		Результат.Вставить(ПараметрыПолей.ПолеГруппа, ЭтаФорма.Группа);
		Результат.Вставить(ПараметрыПолей.ПолеГруппаИмя, ЭтаФорма.ГруппаИмя);
	КонецЕсли;
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура РежимОтбораПриИзменении(Элемент)
	УстановитьВидимостьПоРежимуОтбора(ЭтаФорма);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПоРежимуОтбора(ЭтаФорма)

	ЭтаФорма.Элементы.Элемент.Видимость = (ЭтаФорма.РежимОтбора = "ПоЭлементу");
	ЭтаФорма.Элементы.ГруппаИмя.Видимость = (ЭтаФорма.РежимОтбора = "ПоГруппе");
	ЭтаФорма.Элементы.ВключаяФилиалы.Видимость = (ЭтаФорма.ПараметрыПолей.Свойство("ПолеВключаяФилиалы") И ЭтаФорма.РежимОтбора <> "БезОтбора");
	
КонецПроцедуры
 
