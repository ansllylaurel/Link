
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.УникальныйИдентификаторВладельца = Параметры.УникальныйИдентификаторВладельца;
	ЭтаФорма.Организация = Параметры.Организация;
	
	Элементы.СтрокиИсточникИнвестиционнаяДекларация.Видимость = Параметры.Консолидирующая;
	Элементы.СтрокиПриемникИнвестиционнаяДекларация.Видимость = Параметры.Консолидирующая;
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СтрокиИсточникВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтрокаИсточник = ЭтаФорма.СтрокиИсточник.НайтиПоИдентификатору(ВыбраннаяСтрока);
	ЗаполнитьЗначенияСвойств(ЭтаФорма.СтрокиПриемник.Добавить(), СтрокаИсточник);
	БазисПриИзмененииНаСервере(СтрокаИсточник.Базис);
КонецПроцедуры

&НаКлиенте
Процедура НастройкаИсточникПриИзменении(Элемент)
	ЗаполнитьСтрокиИсточник();
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеУсловийОтбораПриИзменении(Элемент)
	ЗаполнитьСтрокиИсточник();
КонецПроцедуры

&НаКлиенте
Процедура СтрокиПриемникПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СтрокиПриемникПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	МассивНовыхСтрок = Новый Массив;
	Для каждого СтрокаИсточник Из ПараметрыПеретаскивания.Значение Цикл
		НоваяСтрока = ЭтаФорма.СтрокиПриемник.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточник);
		МассивНовыхСтрок.Добавить(НоваяСтрока.ПолучитьИдентификатор());
	КонецЦикла;
	ЗаполнитьПараметрыБазисов(МассивНовыхСтрок);
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокиПриемникБазисПриИзменении(Элемент)
	БазисПриИзмененииНаСервере(Элементы.Показатели.ТекущиеДанные.Базис);
КонецПроцедуры

&НаКлиенте
Процедура СтрокиПриемникКонтролируемыйПоказательНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	             
	ТекущийБазис = Элементы.СтрокиПриемник.ТекущиеДанные.Базис;
	НайденныеСтроки = ПараметрыБазисов.НайтиСтроки(Новый Структура("Базис", Элементы.СтрокиПриемник.ТекущиеДанные.Базис));
	Если НайденныеСтроки.Количество() > 0 Тогда
	
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = НайденныеСтроки[0].Показатели;
	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область КомандыФормы

&НаКлиенте
Процедура ПеренестиВНастройку(Команда)
	Закрыть(ПеренестиВНастройкуНаСервере());
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСтрокиИсточник()

	СтрокиИсточник.Очистить();
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИнвестиционныеДекларацииПоказатели.Ссылка КАК Настройка,
		|	ИнвестиционныеДекларацииПоказатели.НомерСтроки КАК НомерСтроки,
		|	ИнвестиционныеДекларацииПоказатели.Базис КАК Базис,
		|	ИнвестиционныеДекларацииПоказатели.НаборИнвестиционнойДекларации КАК НаборИнвестиционнойДекларации,
		|	ИнвестиционныеДекларацииПоказатели.КонтролируемыйПоказатель КАК КонтролируемыйПоказатель,
		|	ИнвестиционныеДекларацииПоказатели.МинимальноеЗначение КАК МинимальноеЗначение,
		|	ИнвестиционныеДекларацииПоказатели.МаксимальноеЗначение КАК МаксимальноеЗначение,
		|	ИнвестиционныеДекларацииПоказатели.АбсолютнаяВеличинаМин КАК АбсолютнаяВеличинаМин,
		|	ИнвестиционныеДекларацииПоказатели.АбсолютнаяВеличинаМакс КАК АбсолютнаяВеличинаМакс,
		|	ИнвестиционныеДекларацииПоказатели.ОбъединятьОтборы КАК ОбъединятьОтборы,
		|	ИнвестиционныеДекларацииПоказатели.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларация
		|ИЗ
		|	Справочник.ИнвестиционныеДекларации.Показатели КАК ИнвестиционныеДекларацииПоказатели
		|ГДЕ
		|	&НастройкаИсточник
		|	И &ПредставлениеУсловийОтбора";
	
	Если ЗначениеЗаполнено(ЭтаФорма.НастройкаИсточник) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НастройкаИсточник", "ИнвестиционныеДекларацииПоказатели.Ссылка = &НастройкаИсточник");
		Запрос.УстановитьПараметр("НастройкаИсточник", ЭтаФорма.НастройкаИсточник);
	Иначе
		Запрос.УстановитьПараметр("НастройкаИсточник", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтаФорма.ОписаниеУсловийОтбора) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПредставлениеУсловийОтбора", 
			"ИнвестиционныеДекларацииПоказатели.НаборИнвестиционнойДекларации.Наименование ПОДОБНО &ПредставлениеУсловийОтбора
			|	ИЛИ ИнвестиционныеДекларацииПоказатели.НаборИнвестиционнойДекларации.Описание ПОДОБНО &ПредставлениеУсловийОтбора");
		Запрос.УстановитьПараметр("ПредставлениеУсловийОтбора", "%" + СокрЛП(ЭтаФорма.ОписаниеУсловийОтбора) + "%");
	Иначе
		Запрос.УстановитьПараметр("ПредставлениеУсловийОтбора", Истина);
	КонецЕсли; 
	
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СтрокиИсточник.Добавить(), ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПеренестиВНастройкуНаСервере()
	
	ТаблицаПриемник = СтрокиПриемник.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаПриемник, УникальныйИдентификаторВладельца);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПараметрыБазиса(СтрокаБазиса, Базис)

	Если ЗначениеЗаполнено(Базис) Тогда
		
		ТаблицаПоказателей = Справочники.БазисыКонтроляИнвестиционныхДеклараций.ПолучитьОписаниеКонтролируемыхПоказателей(Базис.НаборДанных);
		СтрокаБазиса.Показатели.Очистить();
		
		Для каждого Показатель Из ТаблицаПоказателей Цикл
		
			СтрокаБазиса.Показатели.Добавить(Показатель.Представление);
		
		КонецЦикла; 
		
		СтрокаБазиса.Базис = Базис;
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура БазисПриИзмененииНаСервере(Базис)

	НайденныеСтроки = ПараметрыБазисов.НайтиСтроки(Новый Структура("Базис", Базис));
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		СтрокаБазиса = ПараметрыБазисов.Добавить();
	Иначе
		СтрокаБазиса = НайденныеСтроки[0];
	КонецЕсли; 
	
	ЗаполнитьПараметрыБазиса(СтрокаБазиса, Базис);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыБазисов(МассивСтрок)
	
	Для каждого ИдентификаторСтроки Из МассивСтрок Цикл
		
		СтрокаПриемник = ЭтаФорма.СтрокиПриемник.НайтиПоИдентификатору(ИдентификаторСтроки);
		БазисПриИзмененииНаСервере(СтрокаПриемник.Базис);
		
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти 






