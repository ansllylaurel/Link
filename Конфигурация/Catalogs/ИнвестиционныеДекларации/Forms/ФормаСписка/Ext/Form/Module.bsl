
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.ДатаСведений = ТекущаяДатаСеанса();
	ОбновитьСписокПоДатеСведений();
	
	Набор = Неопределено;
	Если Параметры.Свойство("ОтборПоНабору", Набор) Тогда
	
		Отбор = ЭтаФорма.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Показатели.НаборИнвестиционнойДекларации");
		Отбор.ПравоеЗначение = Набор;
		
		Отбор = ЭтаФорма.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЭтоГруппа");
		Отбор.ПравоеЗначение = Ложь;
		
		Элементы.Список.Отображение = ОтображениеТаблицы.Список;
	
	КонецЕсли; 
	
	Базис = Неопределено;
	Если Параметры.Свойство("ОтборПоБазису", Базис) Тогда
	
		Отбор = ЭтаФорма.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Показатели.Базис");
		Отбор.ПравоеЗначение = Базис;
		
		Отбор = ЭтаФорма.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЭтоГруппа");
		Отбор.ПравоеЗначение = Ложь;
		
		Элементы.Список.Отображение = ОтображениеТаблицы.Список;
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокПоДатеСведений()
	ЭтаФорма.Список.Параметры.УстановитьЗначениеПараметра("Период", ЭтаФорма.ДатаСведений);
КонецПроцедуры

&НаКлиенте
Процедура ДатаСведенийПриИзменении(Элемент)
	ОбновитьСписокПоДатеСведений();
КонецПроцедуры
