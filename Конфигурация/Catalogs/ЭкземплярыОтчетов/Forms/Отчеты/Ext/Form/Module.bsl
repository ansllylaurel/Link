
#Область Внешний_интерфейс

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт
	
	// Обновляем организацию, очищаем отбор по счетам ДУ
	ЭтаФорма.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	Договоры.Очистить();
	СоставОтчетов.ПолучитьЭлементы().Очистить();
	КлючевыеПоляПриИзменении(Неопределено);
	
КонецПроцедуры

#КонецОбласти

#Область Обработчики_событий_формы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьЭлементов();
	УстановитьЗаголовокОтборов();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Организация	= ПараметрыСеанса.ТекущаяОрганизация;
	Период		= Новый СтандартныйПериод(НачалоМесяца(ТекущаяДата()), КонецМесяца(ТекущаяДата()));
	
	Если Параметры.Свойство("Субъект") Тогда
		
		Если ТипЗнч(Параметры.Субъект) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
			
			ЭтаФорма.Договоры.Добавить(Параметры.Субъект);
			
			Элементы.ВидыДоговоров.Доступность	= Ложь;
			Элементы.Договоры.Доступность		= Ложь;
			
		Иначе
			
			ЭтаФорма.Клиенты.Добавить(Параметры.Субъект);
			
			Элементы.Клиенты.Доступность = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	
	Если ЭтаФорма.Клиенты.Количество() <> 0
		ИЛИ ЭтаФорма.ВидыДоговоров.Количество() <> 0
		ИЛИ ЭтаФорма.Договоры.Количество() <> 0 Тогда
		Настройки.Удалить("Клиенты");
		Настройки.Удалить("ВидыДоговоров");
		Настройки.Удалить("Договоры");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура СоставОтчетовПриАктивизацииСтроки(Элемент)
	
	Если Элементы.СоставОтчетов.ВыделенныеСтроки.Количество() > 0
		И ЗначениеЗаполнено(СоставОтчетов.НайтиПоИдентификатору(Элементы.СоставОтчетов.ТекущаяСтрока).Экземпляр) Тогда
		ВывестиСведенияОбОтчетеНаСервере(Элементы.СоставОтчетов.ТекущаяСтрока);
	Иначе
		События.Очистить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СобытияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтрокаСобытия = События.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если СтрокаСобытия.КодСобытия >= 3 И СтрокаСобытия.КодСобытия <= 6 Тогда
		
		ДанныеОФайле = Новый Структура;
		
		ДанныеОФайле.Вставить("ИмяФайла",				СтрокаСобытия.ИмяПриСохранении);
		ДанныеОФайле.Вставить("ИдентификаторВерсии",	СтрокаСобытия.ИдентификаторВерсии);
		
		ОткрытьВерсиюОтчета(ДанныеОФайле);
		
	ИначеЕсли СтрокаСобытия.КодСобытия >= 7 И СтрокаСобытия.КодСобытия <= 17 Тогда
		ОткрытьЗначение(СтрокаСобытия.ПакетДанных);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставОтчетовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СтрокаДерева = СоставОтчетов.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	ВыбранноеЗначение = Неопределено;
	
	Если Поле.Имя = "СоставОтчетовПредставление" Тогда
		
		Если ЗначениеЗаполнено(СтрокаДерева.ИдентификаторВерсии) Тогда
			
			ДанныеОФайле = Новый Структура;
			
			ДанныеОФайле.Вставить("ИмяФайла",				СтрокаДерева.ИмяПриСохранении);
			ДанныеОФайле.Вставить("ИдентификаторВерсии",	СтрокаДерева.ИдентификаторВерсии);
			
			ОткрытьВерсиюОтчета(ДанныеОФайле);
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаДерева.Договор) Тогда
			ВыбранноеЗначение = СтрокаДерева.Договор;
		ИначеЕсли ЗначениеЗаполнено(СтрокаДерева.Клиент) Тогда
			ВыбранноеЗначение = СтрокаДерева.Клиент;
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "СоставОтчетовСтатусВыгрузки" И ЗначениеЗаполнено(СтрокаДерева.Выгрузка) Тогда
		ВыбранноеЗначение = СтрокаДерева.Выгрузка;
	ИначеЕсли Поле.Имя = "СоставОтчетовСтатусОтправки" И ЗначениеЗаполнено(СтрокаДерева.Письмо) Тогда
		ВыбранноеЗначение = СтрокаДерева.Письмо;
	ИначеЕсли (Поле.Имя = "СоставОтчетовДоговор" ИЛИ Поле.Имя = "СоставОтчетовНомерДоговора") И ЗначениеЗаполнено(СтрокаДерева.Договор) Тогда
		ВыбранноеЗначение = СтрокаДерева.Договор;
	ИначеЕсли Поле.Имя = "СоставОтчетовКлиент" И ЗначениеЗаполнено(СтрокаДерева.Клиент) Тогда
		ВыбранноеЗначение = СтрокаДерева.Клиент;
	ИначеЕсли (Поле.Имя = "СоставОтчетовОтчет" ИЛИ Поле.Имя = "СоставОтчетовСтатусВерсии") И ЗначениеЗаполнено(СтрокаДерева.ИдентификаторВерсии) Тогда
		
		ДанныеОФайле = Новый Структура;
		
		ДанныеОФайле.Вставить("ИмяФайла",				СтрокаДерева.ИмяПриСохранении);
		ДанныеОФайле.Вставить("ИдентификаторВерсии",	СтрокаДерева.ИдентификаторВерсии);
		
		ОткрытьВерсиюОтчета(ДанныеОФайле);
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ОткрытьЗначение(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КлючевыеПоляПриИзменении(Элемент)
	
	ИзмененияКлючевыхПолейПрименены			= Ложь;
	Элементы.ДекорацияОбновление.Видимость	= Истина;
	УстановитьЗаголовокОтборов();
	
КонецПроцедуры

&НаКлиенте
Процедура СортировкаПорядокОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СортировкаПолеОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура ОчиститьОтбор(Команда)
	
	ЭтаФорма.Клиенты.Очистить();
	ЭтаФорма.ВидыДоговоров.Очистить();
	ЭтаФорма.Договоры.Очистить();
	ЭтаФорма.Отчеты.Очистить();
	
	ЭтаФорма.Периодичность		= Неопределено;
	ЭтаФорма.НаличиеВерсии		= 0;
	ЭтаФорма.ПоДоставке			= 0;
	
КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)
	
	Если Элементы.СоставОтчетов.ВыделенныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать хотя бы один отчет, который требуется вывести на печать!");
		Возврат;
	Иначе
		
		ДанныеОФайлах = Новый Массив;
		
		Для Каждого ИдентификаторСтроки Из Элементы.СоставОтчетов.ВыделенныеСтроки Цикл
			
			СтрокаТаблицы = СоставОтчетов.НайтиПоИдентификатору(ИдентификаторСтроки);
			
			Если ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторВерсии) Тогда
				
				ДанныеОФайле = Новый Структура;
				
				ДанныеОФайле.Вставить("Отчет",					СтрокаТаблицы.Отчет);
				ДанныеОФайле.Вставить("Периодичность",			СтрокаТаблицы.Периодичность);
				ДанныеОФайле.Вставить("Договор",				СтрокаТаблицы.Договор);
				ДанныеОФайле.Вставить("Дата",					СтрокаТаблицы.Дата);
				ДанныеОФайле.Вставить("ИмяФайла",				СтрокаТаблицы.ИмяПриСохранении);
				ДанныеОФайле.Вставить("ИдентификаторВерсии",	СтрокаТаблицы.ИдентификаторВерсии);
				
				ДанныеОФайлах.Добавить(ДанныеОФайле);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ДанныеОФайлах.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать хотя бы один отчет с сохраненной версией, которую требуется вывести на печать!");
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ФайлыДляВыводаНаПечать = Новый Массив;
	
	ПолучитьДанныеВерсийНаСервере(ДанныеОФайлах);
	
	Каталог = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов() + Строка(Новый УникальныйИдентификатор) + "\";
	
	Для Каждого ДанныеОФайле Из ДанныеОФайлах Цикл
		
		Если НЕ ДанныеОФайле.Свойство("Адрес") Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеОФайле.Адрес);
		Исключение
			
			ТекстОшибки = СтрШаблон("Отчет %1 (%2) по %3 за %4 не будет открыт из-за ошибки при получении версии отчета из временного хранилища:%5",
									ДанныеОФайле.Отчет,
									ДанныеОФайле.Периодичность,
									ДанныеОФайле.Договор,
									Формат(ДанныеОФайле.Дата, "ДФ=dd.MM.yyyy"),
									Символы.ПС + ОписаниеОшибки());
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			Продолжить;
			
		КонецПопытки;
		
		Попытка
			ДвоичныеДанные.Записать(Каталог + ДанныеОФайле.ИмяФайла);
		Исключение
			
			ТекстОшибки = СтрШаблон("Отчет %1 (%2) по %3 за %4 не будет выведен на печать из-за ошибки при записи временного файла:%5",
									ДанныеОФайле.Отчет,
									ДанныеОФайле.Периодичность,
									ДанныеОФайле.Договор,
									Формат(ДанныеОФайле.Дата, "ДФ=dd.MM.yyyy"),
									Символы.ПС + ОписаниеОшибки());
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			Продолжить;
			
		КонецПопытки;
		
		Попытка
			РаботаСОтчетамиКлиент.НапечататьФайл(Каталог + ДанныеОФайле.ИмяФайла);
		Исключение
			
			ТекстОшибки = СтрШаблон("Отчет %1 (%2) по %3 за %4 не выведен на печать из-за ошибки при вызове функции печати:%6",
									ДанныеОФайле.Отчет,
									ДанныеОФайле.Периодичность,
									ДанныеОФайле.Договор,
									Формат(ДанныеОФайле.Дата, "ДФ=dd.MM.yyyy"),
									Символы.ПС + ОписаниеОшибки());
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			Продолжить;
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура ОбновитьОтчеты(Команда)
	
	ОбновитьОтчетыНаСервере();
	УстановитьЗаголовокОтборов();	
	
	ИзмененияКлючевыхПолейПрименены			= Истина;
	Элементы.ДекорацияОбновление.Видимость	= Ложь;
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВКаталог(Команда)
	
	Если Элементы.СоставОтчетов.ВыделенныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать хотя бы один отчет, версию которого требуется выгрузить!");
		Возврат;
	Иначе
		
		ДанныеОФайлах = Новый Массив;
		
		Для Каждого ИдентификаторСтроки Из Элементы.СоставОтчетов.ВыделенныеСтроки Цикл
			
			СтрокаТаблицы = СоставОтчетов.НайтиПоИдентификатору(ИдентификаторСтроки);
			
			Если ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторВерсии) Тогда
				
				ДанныеОФайле = Новый Структура;
				
				ДанныеОФайле.Вставить("Отчет",					СтрокаТаблицы.Отчет);
				ДанныеОФайле.Вставить("Периодичность",			СтрокаТаблицы.Периодичность);
				ДанныеОФайле.Вставить("Договор",				СтрокаТаблицы.Договор);
				ДанныеОФайле.Вставить("Дата",					СтрокаТаблицы.Дата);
				ДанныеОФайле.Вставить("ИмяФайла",				СтрокаТаблицы.ИмяПриСохранении);
				ДанныеОФайле.Вставить("ИдентификаторВерсии",	СтрокаТаблицы.ИдентификаторВерсии);
				
				ДанныеОФайлах.Добавить(ДанныеОФайле);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ДанныеОФайлах.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать хотя бы один отчет с сохраненной версией, которую требуется выгрузить!");
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ДВФ = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	
	Если ДВФ.Выбрать() Тогда
		
		ПолучитьДанныеВерсийНаСервере(ДанныеОФайлах);
		
		Для Каждого ДанныеОФайле Из ДанныеОФайлах Цикл
			
			Если НЕ ДанныеОФайле.Свойство("Адрес") Тогда
				Продолжить;
			КонецЕсли;
			
			Попытка
				ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеОФайле.Адрес);
			Исключение
				
				ТекстОшибки = СтрШаблон("Отчет %1 (%2) по %3 за %4 не выгружен из-за ошибки при получении версии отчета из временного хранилища:%5",
										ДанныеОФайле.Отчет,
										ДанныеОФайле.Периодичность,
										ДанныеОФайле.Договор,
										Формат(ДанныеОФайле.Дата, "ДФ=dd.MM.yyyy"),
										Символы.ПС + ОписаниеОшибки());
										
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				
				Продолжить;
				
			КонецПопытки;
			
			Попытка
				ДвоичныеДанные.Записать(ДВФ.Каталог + ?(Прав(ДВФ.Каталог, 1) = "\", "", "\") + ДанныеОФайле.ИмяФайла);
			Исключение
				
				ТекстОшибки = СтрШаблон("Отчет %1 (%2) по %3 за %4 не выгружен из-за ошибки при записи файла:%5",
										ДанныеОФайле.Отчет,
										ДанныеОФайле.Периодичность,
										ДанныеОФайле.Договор,
										Формат(ДанныеОФайле.Дата, "ДФ=dd.MM.yyyy"),
										Символы.ПС + ОписаниеОшибки());
										
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				
				Продолжить;
				
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

