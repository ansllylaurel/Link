				ДанныеОФайле.Вставить("Дата",					СтрокаТаблицы.Дата);
				ДанныеОФайле.Вставить("ИмяФайла",				СтрокаТаблицы.ИмяПриСохранении);
				ДанныеОФайле.Вставить("ИдентификаторВерсии",	СтрокаТаблицы.ИдентификаторВерсии);
				
				ДанныеОФайлах.Добавить(ДанныеОФайле);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ДанныеОФайлах.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать хотя бы один отчет с сохраненной версией, которую требуется открыть!");
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ПолучитьДанныеВерсийНаСервере(ДанныеОФайлах);
	
	Для Каждого ДанныеОФайле Из ДанныеОФайлах Цикл
		
		Если НЕ ДанныеОФайле.Свойство("Адрес") Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеОФайле.Адрес);
		Исключение
			
			ТекстОшибки = СтрШаблон("Отчет %1 (%2) по %3 за %4 не будет открыт из-за ошибки при получении версии отчета из временного хранилища:%5",
									ДанныеОФайле.Отчет,
									ДанныеОФайле.Периодичность,
									ДанныеОФайле.Договор,
									Формат(ДанныеОФайле.Дата, "ДФ=dd.MM.yyyy"),
									Символы.ПС + ОписаниеОшибки());
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			Продолжить;
			
		КонецПопытки;
		
		Каталог = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов();
		
		Попытка
			ДвоичныеДанные.Записать(Каталог + ДанныеОФайле.ИмяФайла);
		Исключение
			
			ТекстОшибки = СтрШаблон("Отчет %1 (%2) по %3 за %4 не будет открыт из-за ошибки при записи временного файла:%5",
									ДанныеОФайле.Отчет,
									ДанныеОФайле.Периодичность,
									ДанныеОФайле.Договор,
									Формат(ДанныеОФайле.Дата, "ДФ=dd.MM.yyyy"),
									Символы.ПС + ОписаниеОшибки());
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			Продолжить;
			
		КонецПопытки;
		
		ЗапуститьПриложение(Каталог + ДанныеОФайле.ИмяФайла);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсе(Команда)
	
	Для Каждого Строка Из СоставОтчетов.ПолучитьЭлементы() Цикл
		Элементы.СоставОтчетов.Развернуть(Строка.ПолучитьИдентификатор(), Истина);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьВсе(Команда)
	
	Для Каждого Строка Из СоставОтчетов.ПолучитьЭлементы() Цикл
		СвернутьВетку(Строка);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьНаПочту(Команда)
	
	Вложения = Новый Массив;
	
	Для Каждого Строка Из Элементы.СоставОтчетов.ВыделенныеСтроки Цикл
		
		СтрокаТаблицы = СоставОтчетов.НайтиПоИдентификатору(Строка);
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторВерсии)
			 ИЛИ НЕ ЗначениеЗаполнено(СтрокаТаблицы.ИмяПриСохранении) Тогда
			 Продолжить;
		КонецЕсли;
		
		НовоеВложение = Новый Структура;
		
		НовоеВложение.Вставить("Идентификатор",	СтрокаТаблицы.ИдентификаторВерсии);
		НовоеВложение.Вставить("Имя",			СтрокаТаблицы.ИмяПриСохранении);
		НовоеВложение.Вставить("Экземпляр",		СтрокаТаблицы.Экземпляр);
		
		Вложения.Добавить(НовоеВложение);
		
	КонецЦикла;
	
	Если Вложения.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет данных для отправки! Выберите строки с отчетами, по которым есть сохраненные версии.");
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуМодально("ОбщаяФорма.ОтправкаФайловПочтой", Новый Структура("Организация, Вложения", ЭтотОбъект.Организация, Вложения));
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

#Область Клиентские

&НаКлиенте
Процедура УстановитьЗаголовокОтборов()
	
	Если ЭтаФорма.Клиенты.Количество() > 0
		ИЛИ ЭтаФорма.ВидыДоговоров.Количество() > 0
		ИЛИ ЭтаФорма.Договоры.Количество() > 0
		ИЛИ ЭтаФорма.Отчеты.Количество() > 0
		ИЛИ ЗначениеЗаполнено(ЭтаФорма.Периодичность) Тогда
		ЭтаФорма.ЗаголовокОтборов = "установлен";
	Иначе
		ЭтаФорма.ЗаголовокОтборов = "не задан";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВерсиюОтчета(ДанныеОФайле)
	
	// Получаем версию из хранилища
	Попытка
		Адрес = ПолучитьДанныеВерсииНаСервере(ДанныеОФайле.ИдентификаторВерсии);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось открыть версию отчета из-за ошибки: %1", ОписаниеОшибки()));
		Возврат;
	КонецПопытки;
	
	Попытка
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось открыть версию из-за ошибки при получении данных из временного хранилища: %1", ОписаниеОшибки()));
		Возврат;
	КонецПопытки;
	
	Попытка
		УдалитьИзВременногоХранилища(Адрес);
	Исключение
		// Ну, не удалили и не удалили
	КонецПопытки;
	
	// Сохраняем версию во временный файл
	Каталог = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов();
	
	ИмяФайла = СтрШаблон("%1%2\%3",
						Каталог + ?(Прав(Каталог, 1) = "\", "", "\"),
						Строка(Новый УникальныйИдентификатор),
						ДанныеОФайле.ИмяФайла);
	
	Попытка
		ДвоичныеДанные.Записать(ИмяФайла);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось открыть версию из-за ошибки при сохранении временного файла: %1", ОписаниеОшибки()));
		Возврат;
	КонецПопытки;
	
	// Открываем файл
	ЗапуститьПриложение(ИмяФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	Элементы.СоставОтчетовПредставление.Видимость	= ЭтаФорма.Группировать;
	Элементы.СоставОтчетовКлиент.Видимость			= НЕ ЭтаФорма.Группировать И ЭтаФорма.Клиенты.Количество() <> 1;
	Элементы.СоставОтчетовВидДоговора.Видимость		= НЕ ЭтаФорма.Группировать И ЭтаФорма.Клиенты.Количество() <> 1;
	Элементы.СоставОтчетовДоговор.Видимость			= НЕ ЭтаФорма.Группировать;
	Элементы.СоставОтчетовНомерДоговора.Видимость	= НЕ ЭтаФорма.Группировать;
	Элементы.СоставОтчетовОтчет.Видимость			= НЕ ЭтаФорма.Группировать;
	Элементы.СоставОтчетовПериодичность.Видимость	= НЕ ЭтаФорма.Группировать;
	Элементы.ГруппаСортировка.Видимость				= НЕ ЭтаФорма.Группировать;
	Элементы.РазвернутьВсе.Видимость				= ЭтаФорма.Группировать;
	Элементы.СвернутьВсе.Видимость					= ЭтаФорма.Группировать;
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьВетку(Ветка)
	
	Для Каждого ДочерняяВетка Из Ветка.ПолучитьЭлементы() Цикл
		СвернутьВетку(ДочерняяВетка);
	КонецЦикла;
	
	Элементы.СоставОтчетов.Свернуть(Ветка.ПолучитьИдентификатор());
	
КонецПроцедуры

#КонецОбласти

#Область Серверные

&НаСервере
Функция ЗарегистрироватьНачалоСессииСбораСтатистики(ИмяПроцедуры)
	
	ПоляДляСтатистики = "Организация, Период, Группировать, ГруппаОтчетов";
	ПараметрыСтатистики	= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, ПоляДляСтатистики);
	Механизм			= СтрШаблон("%1.%2", ЭтотОбъект.ИмяФормы, ИмяПроцедуры);
	СессияСтатистики	= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание);
	
	Возврат Новый Структура("Механизм, Сессия, СтатистикаВыполнения", Механизм, СессияСтатистики, Новый Массив);
	
КонецФункции

&НаСервере
Процедура ЗарегистрироватьОкончаниеСессииСбораСтатистики(СессияСбораСтатистики)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(СессияСбораСтатистики.Механизм, СессияСбораСтатистики.Сессия);
	
КонецПроцедуры

&НаСервере
Функция СформироватьОтборНаСервере()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Организация", Организация);
	
	// Виды договоров
	Если Клиенты.Количество() > 0 Тогда
		Результат.Вставить("Клиенты", Клиенты.ВыгрузитьЗначения());
	КонецЕсли;
	
	// Виды договоров
	Если ВидыДоговоров.Количество() > 0 Тогда
		Результат.Вставить("ВидыДоговоров", ВидыДоговоров.ВыгрузитьЗначения());
	КонецЕсли;
	
	// Договоры
	Если Договоры.Количество() > 0 Тогда
		Результат.Вставить("Договоры", Договоры.ВыгрузитьЗначения());
	КонецЕсли;
	
	// Группа отчетов
	Если ЗначениеЗаполнено(ГруппаОтчетов) Тогда
		Результат.Вставить("ГруппаОтчетов", ГруппаОтчетов);
	КонецЕсли;
	
	// Отчеты
	Если Отчеты.Количество() > 0 Тогда
		Результат.Вставить("Отчеты", Отчеты.ВыгрузитьЗначения());
	КонецЕсли;
	
	// Периодичность
	Если ЗначениеЗаполнено(Периодичность) Тогда
		Результат.Вставить("Периодичность", Периодичность);
	КонецЕсли;
	
	// Начало периода
	Если ЗначениеЗаполнено(Период.ДатаНачала) Тогда
		Результат.Вставить("НачалоПериода", Период.ДатаНачала);
	КонецЕсли;
	
	// Конец периода
	Если ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		Результат.Вставить("КонецПериода", Период.ДатаОкончания);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура УдалитьСтрокуНаСервере(Идентификатор)
	
	Строка = СоставОтчетов.НайтиПоИдентификатору(Идентификатор);
	
	Родитель = Строка.ПолучитьРодителя();
	
	Если Родитель = Неопределено Тогда
		СоставОтчетов.ПолучитьЭлементы().Удалить(Строка);
	Иначе
		
		Родитель.ПолучитьЭлементы().Удалить(Строка);
		
		Если Родитель.ПолучитьЭлементы().Количество() = 0 Тогда
			УдалитьСтрокуНаСервере(Родитель.ПолучитьИдентификатор());
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтчетыНаСервере()
	
	СессияСбораСтатистики = ЗарегистрироватьНачалоСессииСбораСтатистики("ОбновитьОтчетыНаСервере()");
	
	СоставОтчетов.ПолучитьЭлементы().Очистить();
	
	СтрокиКПолучениюСтатусовИНастроек = Новый ТаблицаЗначений;
	
	СтрокиКПолучениюСтатусовИНастроек.Колонки.Добавить("Субъект",					Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	СтрокиКПолучениюСтатусовИНастроек.Колонки.Добавить("Отчет",						Новый ОписаниеТипов("СправочникСсылка.Отчеты"));
	СтрокиКПолучениюСтатусовИНастроек.Колонки.Добавить("КлючОтчета",				Новый ОписаниеТипов("Строка"));
	СтрокиКПолучениюСтатусовИНастроек.Колонки.Добавить("Периодичность",				Новый ОписаниеТипов("ПеречислениеСсылка.ПериодичностьПредоставленияОтчетности"));
	СтрокиКПолучениюСтатусовИНастроек.Колонки.Добавить("Дата",						Новый ОписаниеТипов("Дата"));
	СтрокиКПолучениюСтатусовИНастроек.Колонки.Добавить("ДатаНачала",				Новый ОписаниеТипов("Дата"));
	СтрокиКПолучениюСтатусовИНастроек.Колонки.Добавить("ДатаОкончания",				Новый ОписаниеТипов("Дата"));
	СтрокиКПолучениюСтатусовИНастроек.Колонки.Добавить("ОтправляетсяПочтой",		Новый ОписаниеТипов("Булево"));
	СтрокиКПолучениюСтатусовИНастроек.Колонки.Добавить("ВыгружаетсяВЭДО",			Новый ОписаниеТипов("Булево"));
	СтрокиКПолучениюСтатусовИНастроек.Колонки.Добавить("РучнаяЗагрузкаФайловВЭДО",	Новый ОписаниеТипов("Булево"));
	СтрокиКПолучениюСтатусовИНастроек.Колонки.Добавить("Регламентированный",		Новый ОписаниеТипов("Булево"));
	СтрокиКПолучениюСтатусовИНастроек.Колонки.Добавить("ВалютаДокумента",			Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	СтрокиКПолучениюСтатусовИНастроек.Колонки.Добавить("ОтчетЗаПоследнийКвартал",	Новый ОписаниеТипов("Булево"));
	СтрокиКПолучениюСтатусовИНастроек.Колонки.Добавить("ВыбраннаяФорма",			Новый ОписаниеТипов("Строка"));
	СтрокиКПолучениюСтатусовИНастроек.Колонки.Добавить("ИдентификаторСтроки",		Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36, ДопустимаяДлина.Фиксированная)));
	
	ИдентификаторыСтрок = Новый Соответствие;
	
	ВыборкаКлиенты = Справочники.ЭкземплярыОтчетов.ПолучитьОтчетыЗаПериод(СформироватьОтборНаСервере());
	
	Индекс = 0;
	
	Пока ВыборкаКлиенты.Следующий() Цикл
		
		Если ЭтаФорма.Клиенты.Количество() = 1 ИЛИ НЕ Группировать Тогда
			КоллекцияВидовДоговоров = СоставОтчетов.ПолучитьЭлементы();
		Иначе
			
			СтрокаКлиент = СоставОтчетов.ПолучитьЭлементы().Добавить();
			
			СтрокаКлиент.Представление	= Строка(ВыборкаКлиенты.Клиент);
			СтрокаКлиент.Клиент			= ВыборкаКлиенты.Клиент;
			
			КоллекцияВидовДоговоров = СтрокаКлиент.ПолучитьЭлементы();
			
		КонецЕсли;
		
		ВыборкаВидыДоговоров = ВыборкаКлиенты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаВидыДоговоров.Следующий() Цикл
			
			Если ЭтаФорма.Договоры.Количество() <> 1 И ЭтаФорма.ВидыДоговоров.Количество() <> 1 И Группировать Тогда
				
				СтрокаВидДоговора = КоллекцияВидовДоговоров.Добавить();
				
				СтрокаВидДоговора.Представление	= ВыборкаВидыДоговоров.ВидДоговора;
				
				КоллекцияДоговоров = СтрокаВидДоговора.ПолучитьЭлементы();
				
			Иначе
				КоллекцияДоговоров = КоллекцияВидовДоговоров;
			КонецЕсли;
			
			ВыборкаДоговоры = ВыборкаВидыДоговоров.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаДоговоры.Следующий() Цикл
				
				Если ЭтаФорма.Договоры.Количество() <> 1 И Группировать Тогда
					
					СтрокаДоговор = КоллекцияДоговоров.Добавить();
					
					СтрокаДоговор.Представление	= Строка(ВыборкаДоговоры.Договор);
					СтрокаДоговор.Договор		= ВыборкаДоговоры.Договор;
					
					КоллекцияГруппОтчетов = СтрокаДоговор.ПолучитьЭлементы();
					
				Иначе
					КоллекцияГруппОтчетов = КоллекцияВидовДоговоров;
				КонецЕсли;
				
				ВыборкаГруппыОтчетов = ВыборкаДоговоры.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаГруппыОтчетов.Следующий() Цикл
					
					Если ЗначениеЗаполнено(ГруппаОтчетов) ИЛИ НЕ Группировать Тогда
						КоллекцияГодов = КоллекцияГруппОтчетов;
					Иначе
						
						СтрокаГруппаОтчетов = КоллекцияГруппОтчетов.Добавить();
						
						СтрокаГруппаОтчетов.Представление = Строка(ВыборкаГруппыОтчетов.ГруппаОтчетов);
						
						КоллекцияГодов = СтрокаГруппаОтчетов.ПолучитьЭлементы();
						
					КонецЕсли;
					
					ВыборкаГоды = ВыборкаГруппыОтчетов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
					Пока ВыборкаГоды.Следующий() Цикл
						
						Если Группировать Тогда
							
							СтрокаГод = КоллекцияГодов.Добавить();
							
							СтрокаГод.Представление = Формат(ВыборкаГоды.Год, "ЧГ=0");
							
							КоллекцияМесяцев = СтрокаГод.ПолучитьЭлементы();
							
						Иначе
							КоллекцияМесяцев = КоллекцияГодов;
						КонецЕсли;
						
						ВыборкаМесяцы = ВыборкаГоды.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
						
						Пока ВыборкаМесяцы.Следующий() Цикл
							
							Если Группировать Тогда
								
								СтрокаМесяц = КоллекцияМесяцев.Добавить();
								
								СтрокаМесяц.Представление = Формат(Дата(ВыборкаМесяцы.Год, ВыборкаМесяцы.Месяц, 1), "ДФ=MMMM");
								
								КоллекцияПериодичностей = СтрокаМесяц.ПолучитьЭлементы();
								
							Иначе
								КоллекцияПериодичностей = КоллекцияМесяцев;
							КонецЕсли;
							
							ВыборкаПериодичности = ВыборкаМесяцы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
							
							Пока ВыборкаПериодичности.Следующий() Цикл
								
								Если ЗначениеЗаполнено(Периодичность) ИЛИ НЕ Группировать Тогда
									КоллекцияЭкземпляров = КоллекцияПериодичностей;
								Иначе
									
									СтрокаПериодичность = КоллекцияПериодичностей.Добавить();
									
									СтрокаПериодичность.Представление = Строка(ВыборкаПериодичности.Периодичность);
									
									КоллекцияЭкземпляров = СтрокаПериодичность.ПолучитьЭлементы();
									
								КонецЕсли;
								
								ВыборкаЭкземпляры = ВыборкаПериодичности.Выбрать();
								
								Пока ВыборкаЭкземпляры.Следующий() Цикл
									
									СтрокаЭкземпляр = КоллекцияЭкземпляров.Добавить();
									
									ЗаполнитьЗначенияСвойств(СтрокаЭкземпляр, ВыборкаЭкземпляры);
									
									СтрокаЭкземпляр.ИсходныйПорядковыйНомер	= Индекс;
									СтрокаЭкземпляр.Представление			= Строка(ВыборкаЭкземпляры.Отчет);
									СтрокаЭкземпляр.ОбработкаЗавершена		= 1;
									СтрокаЭкземпляр.ИдентификаторСтроки		= Строка(Новый УникальныйИдентификатор);
									
									СтрокаКПолучениюДанных = СтрокиКПолучениюСтатусовИНастроек.Добавить();
									
									СтрокаКПолучениюДанных.Субъект				= СтрокаЭкземпляр.Договор;
									СтрокаКПолучениюДанных.Отчет				= СтрокаЭкземпляр.Отчет;
									СтрокаКПолучениюДанных.Периодичность		= СтрокаЭкземпляр.Периодичность;
									СтрокаКПолучениюДанных.Дата					= СтрокаЭкземпляр.Дата;
									СтрокаКПолучениюДанных.ИдентификаторСтроки	= СтрокаЭкземпляр.ИдентификаторСтроки;
									
									ИдентификаторыСтрок.Вставить(СтрокаЭкземпляр.ИдентификаторСтроки, СтрокаЭкземпляр.ПолучитьИдентификатор());
									
									Индекс = Индекс + 1;
									
								КонецЦикла;
								
							КонецЦикла;
							
						КонецЦикла;
						
					КонецЦикла;
					
				КонецЦикла;
				
			КонецЦикла;	
			
		КонецЦикла;
		
	КонецЦикла;
	
	УдаляемыеСтроки = Новый Массив;
	
	Настройки = Новый Массив;
	
	Настройки.Добавить("АвтоматическаяВыгрузкаВЭДО");
	Настройки.Добавить("РучнаяЗагрузкаФайловВЭДО");
	Настройки.Добавить("АвтоматическаяОтправка");
	
	// Для быстрого поиска строки таблицы по сборному ключу
	СоответствиеСтрок = Новый Соответствие;
	Для Каждого ДанныеОтчета Из СтрокиКПолучениюСтатусовИНастроек Цикл
		СоответствиеСтрок.Вставить(СтрШаблон("%1-%2-%3-%4", ДанныеОтчета.Дата, ДанныеОтчета.Субъект, ДанныеОтчета.Отчет, ДанныеОтчета.Периодичность), ДанныеОтчета);	
	КонецЦикла;
	
	ЗначенияНастроек = РегистрыСведений.СоставИНастройкиОтчетов.ПолучитьНастройкиОтчетов(СтрокиКПолучениюСтатусовИНастроек, Настройки);
	
	Для Каждого СтрокаНастроек Из ЗначенияНастроек Цикл
		
		ИсходнаяСтрока = СоответствиеСтрок.Получить(СтрШаблон("%1-%2-%3-%4", СтрокаНастроек.Дата, СтрокаНастроек.Субъект, СтрокаНастроек.Отчет, СтрокаНастроек.Периодичность));	
		Если ИсходнаяСтрока = Неопределено Тогда
			ВызватьИсключение "Не удалось найти строку исходной таблицы по сборному ключу";
		КонецЕсли;	
		
		ИсходнаяСтрока.ВыгружаетсяВЭДО			= СтрокаНастроек.Настройки.АвтоматическаяВыгрузкаВЭДО;
		ИсходнаяСтрока.ОтправляетсяПочтой		= СтрокаНастроек.Настройки.АвтоматическаяОтправка;
		ИсходнаяСтрока.РучнаяЗагрузкаФайловВЭДО	= СтрокаНастроек.Настройки.РучнаяЗагрузкаФайловВЭДО;
		
	КонецЦикла;	
	
	СостоянияОтчетов = РаботаСОтчетами.ПолучитьСостоянияОтчетов(Организация, СтрокиКПолучениюСтатусовИНастроек);
	
	Для Каждого Состояние Из СостоянияОтчетов Цикл
		
		СтрокаЭкземпляр = СоставОтчетов.НайтиПоИдентификатору(ИдентификаторыСтрок.Получить(Состояние.ИдентификаторСтроки));
		
		ЗаполнитьЗначенияСвойств(СтрокаЭкземпляр, Состояние);
		
		Если Состояние.ОбработкаЗавершена Тогда
			СтрокаЭкземпляр.ОбработкаЗавершена = 2;
		Иначе
			СтрокаЭкземпляр.ОбработкаЗавершена = 1;
		КонецЕсли;
		
		СтрокаЭкземпляр.СтатусВерсии = СтрокаЭкземпляр.СтатусВерсии + 1;
		
		Если НаличиеВерсии = 1 И СтрокаЭкземпляр.СтатусВерсии < 2
			ИЛИ НаличиеВерсии = 2 И СтрокаЭкземпляр.СтатусВерсии > 1
			ИЛИ ПоДоставке = 1 И СтрокаЭкземпляр.СтатусВыгрузки < 4
			ИЛИ ПоДоставке = 2 И СтрокаЭкземпляр.СтатусОтправки < 4
			ИЛИ ПоДоставке = 3 И (СтрокаЭкземпляр.СтатусВыгрузки < 4 ИЛИ СтрокаЭкземпляр.СтатусОтправки < 4) Тогда
			УдаляемыеСтроки.Добавить(ИдентификаторыСтрок.Получить(Состояние.ИдентификаторСтроки));
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Идентификатор ИЗ УдаляемыеСтроки Цикл
		УдалитьСтрокуНаСервере(Идентификатор);
	КонецЦикла;
	
	Если НЕ ЭтаФорма.Группировать
		И Сортировка.Количество() > 0 Тогда
		ПрименитьСортировкуНаСервере();
	КонецЕсли;
	
	ЗарегистрироватьОкончаниеСессииСбораСтатистики(СессияСбораСтатистики);
	
КонецПроцедуры
&НаСервере
Процедура ВывестиСведенияОбОтчетеНаСервере(ИдентификаторСтроки)
	
	Экземпляр = СоставОтчетов.НайтиПоИдентификатору(ИдентификаторСтроки).Экземпляр;
	
	События.Загрузить(РаботаСОтчетами.ПолучитьСобытияСОтчетом(Экземпляр));
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеВерсииНаСервере(ИдентификаторВерсии)
	
	Попытка
		ДанныеВерсии = РаботаСФайловымХранилищем.ПолучитьВерсиюФайла(ИдентификаторВерсии);
	Исключение
		ВызватьИсключение "Не удалось получить данные версии отчета из файлового хранилища!";
	КонецПопытки;
	
	Возврат ДанныеВерсии.Адрес;
	
КонецФункции

&НаСервере
Процедура ПолучитьДанныеВерсийНаСервере(ДанныеОФайлах)
	
	Для Каждого ДанныеОФайле Из ДанныеОФайлах Цикл
		
		Попытка
			ДанныеВерсии = ПолучитьДанныеВерсииНаСервере(ДанныеОФайле.ИдентификаторВерсии);
		Исключение
			
			ТекстОшибки = СтрШаблон("Не удалось получить данные версии отчета %1 (%2) по %3 за %4 из-за ошибки:%5",
									ДанныеОФайле.Отчет,
									ДанныеОФайле.Периодичность,
									ДанныеОФайле.Договор,
									Формат(ДанныеОФайле.Дата, "ДФ=dd.MM.yyyy"),
									Символы.ПС + ОписаниеОшибки());
									
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			Продолжить;
			
		КонецПопытки;
		
		ДанныеОФайле.Вставить("Адрес", ДанныеВерсии);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьСортировкуНаСервере()
	
	ТаблицаДляСортировки = Новый ТаблицаЗначений;
	
	ТипыКлиента = Новый Массив;
	
	ТипыКлиента.Добавить(Тип("СправочникСсылка.ЮрФизЛица"));
	ТипыКлиента.Добавить(Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды"));
	
	ТаблицаДляСортировки.Колонки.Добавить("Представление",				Новый ОписаниеТипов("Строка"));
	ТаблицаДляСортировки.Колонки.Добавить("Клиент",						Новый ОписаниеТипов(ТипыКлиента));
	ТаблицаДляСортировки.Колонки.Добавить("ВидДоговора",				Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровДоверительногоУправления"));
	ТаблицаДляСортировки.Колонки.Добавить("Договор",					Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	ТаблицаДляСортировки.Колонки.Добавить("ГруппаОтчетов",				Новый ОписаниеТипов("СправочникСсылка.Отчеты"));
	ТаблицаДляСортировки.Колонки.Добавить("Периодичность",				Новый ОписаниеТипов("ПеречислениеСсылка.ПериодичностьПредоставленияОтчетности"));
	ТаблицаДляСортировки.Колонки.Добавить("Дата",						Новый ОписаниеТипов("Дата",,,,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТаблицаДляСортировки.Колонки.Добавить("Отчет",						Новый ОписаниеТипов("СправочникСсылка.Отчеты"));
	ТаблицаДляСортировки.Колонки.Добавить("Экземпляр",					Новый ОписаниеТипов("СправочникСсылка.ЭкземплярыОтчетов"));
	ТаблицаДляСортировки.Колонки.Добавить("ОбработкаЗавершена",			Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(1, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаДляСортировки.Колонки.Добавить("ЗапретОбработки",			Новый ОписаниеТипов("Булево"));
	ТаблицаДляСортировки.Колонки.Добавить("СтатусВерсии",				Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(1, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаДляСортировки.Колонки.Добавить("СтатусВыгрузки",				Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(1, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаДляСортировки.Колонки.Добавить("СтатусОтправки",				Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(1, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаДляСортировки.Колонки.Добавить("ИдентификаторСтроки",		Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36, ДопустимаяДлина.Переменная)));
	ТаблицаДляСортировки.Колонки.Добавить("Выгрузка",					Новый ОписаниеТипов("СправочникСсылка.ПакетыДанныхКОбработке"));
	ТаблицаДляСортировки.Колонки.Добавить("Письмо",						Новый ОписаниеТипов("СправочникСсылка.ПакетыДанныхКОбработке"));
	ТаблицаДляСортировки.Колонки.Добавить("ИдентификаторВерсии",		Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36, ДопустимаяДлина.Переменная)));
	ТаблицаДляСортировки.Колонки.Добавить("ИмяПриСохранении",			Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(260, ДопустимаяДлина.Переменная)));
	ТаблицаДляСортировки.Колонки.Добавить("НомерДоговора",				Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(70, ДопустимаяДлина.Переменная)));
	ТаблицаДляСортировки.Колонки.Добавить("ИсходныйПорядковыйНомер",	Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)));
	
	Для Каждого Строка Из СоставОтчетов.ПолучитьЭлементы() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаДляСортировки.Добавить(), Строка);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ТаблицаОтчетов", ТаблицаДляСортировки);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ <ПоляТаблицы>
		|ПОМЕСТИТЬ _ТаблицаОтчетов
		|ИЗ
		|	&ТаблицаОтчетов КАК ТаблицаОтчетов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ <ПоляТаблицы>
		|ИЗ
		|	_ТаблицаОтчетов КАК _ТаблицаОтчетов
		|
		|УПОРЯДОЧИТЬ ПО <ПоляСортировки>";
	
	ПоляТаблицы = "";
	
	Для Каждого Колонка Из ТаблицаДляСортировки.Колонки Цикл
		ПоляТаблицы = ПоляТаблицы + ?(ПоляТаблицы <> "", ",", "") + Символы.ПС + Символы.Таб + Колонка.Имя;
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "<ПоляТаблицы>", ПоляТаблицы);
	
	ПоляСортировки = "";
	
	Для Каждого Строка Из Сортировка Цикл
		
		Если ЗначениеЗаполнено(Строка.Поле) Тогда
			ПоляСортировки = ПоляСортировки + ?(ПоляСортировки <> "", ",", "") + Символы.ПС + Символы.Таб + "_ТаблицаОтчетов." + Строка.Поле + ?(Строка.Порядок, " УБЫВ", "");
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПоляСортировки = "" Тогда
		ПоляСортировки = ПоляСортировки + Символы.ПС + Символы.Таб + "_ТаблицаОтчетов.ИсходныйПорядковыйНомер";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "<ПоляСортировки>", ПоляСортировки);
	
	ОтсортированнаяТаблица = Запрос.Выполнить().Выгрузить();
	
	СоставОтчетов.ПолучитьЭлементы().Очистить();
	
	Для Каждого Строка Из ОтсортированнаяТаблица Цикл
		ЗаполнитьЗначенияСвойств(СоставОтчетов.ПолучитьЭлементы().Добавить(), Строка);
	КонецЦикла;
	
КонецПроцедуры


#КонецОбласти

#КонецОбласти

