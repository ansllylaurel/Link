#Область СОБЫТИЯ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьБыстрыеОтборы(ЭтаФорма, "ИсполнителиСобственные", "Организация,Период,Клиент", "Период");
	
	Если ЗначениеЗаполнено(ЭтаФорма.Клиент) Тогда
		ЭтаФорма.РежимВыбораКлиента = 1;
	КонецЕсли;
		
	// установим параметры дин. списков по исполнителям
	ЭтаФорма.ИсполнителиСобственные.Параметры.УстановитьЗначениеПараметра("ДатаЗакрытия", ?(ЗначениеЗаполнено(ЭтаФорма.Период), ЭтаФорма.Период, ТекущаяДата()));
		
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(ЭтаФорма.ИсполнителиСобственные.Отбор, Новый Структура("ИмяПоля, Представление", "Закрыт", "ПредопределенныйОтборЗакрыт"),
		"ПредопределенныйОтборЗакрыт", ВидСравненияКомпоновкиДанных.Равно, Ложь, Не Элементы.ИсполнителиСобственныеКомандаИсполнителиСобственныеПоказатьСкрытьЗакрытых.Пометка, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто);
			
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	РежимВыбораКлиентаПриИзменении(Неопределено);
	
КонецПроцедуры

#КонецОбласти

#Область БЫСТРЫЙ_ОТБОР

&НаКлиенте
Процедура БыстрыйОтборПериодПриИзменении(Элемент)
	
	ЭтаФорма.ИсполнителиСобственные.Параметры.УстановитьЗначениеПараметра("ДатаЗакрытия", ?(ЗначениеЗаполнено(ЭтаФорма.Период), ЭтаФорма.Период, ТекущаяДата()));
	
КонецПроцедуры

&НаКлиенте
Процедура БыстрыйОтборКлиентПриИзменении(Элемент)
			
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбораСписка(ЭтаФорма, "ИсполнителиСобственные", "Клиент");
	
КонецПроцедуры

&НаКлиенте
Процедура РежимВыбораКлиентаПриИзменении(Элемент)
	
	Если ЭтаФорма.РежимВыбораКлиента = 0 Тогда
	    ЭтаФорма.ПоВсем = Истина;		
		ЭтаФорма.Клиент = "";	 		
	Иначе
		ЭтаФорма.ПоВсем = Ложь;		
	КонецЕсли;
	
	Этаформа.Элементы.ИсполнителиСобственныеКлиент.Видимость = ЭтаФорма.ПоВсем;
	ЭтаФорма.Элементы.БыстрыйОтборИсполнителиСобственныеКлиент.Видимость = Не ЭтаФорма.ПоВсем;
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбораСписка(ЭтаФорма, "ИсполнителиСобственные", "Клиент");
	
КонецПроцедуры

#КонецОбласти

#Область КОМАНДЫ_ВЫБОРА

&НаКлиенте
Процедура КомандаВыбрать(Команда)
		
	ИсполнителиСобственныеВыбор(Неопределено, Неопределено, Неопределено, Неопределено);
		
КонецПроцедуры

&НаКлиенте
Процедура ИсполнителиСобственныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ИсполнителиСобственные.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		ВыбранныеДанные = Новый Структура("СчетДоверительногоУправления, РасчетныйСчет, НаименованиеСчетаДоверительногоУправления, НомерДоговора, ДатаЗаключения, НаименованиеВладельцаДляДокументов");
		ЗаполнитьЗначенияСвойств(ВыбранныеДанные, ТекущиеДанные);
		ЭтаФорма.Закрыть(ВыбранныеДанные);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура КомандаИсполнителиСобственныеПоказатьСкрытьЗакрытых(Команда)
	
	Элементы.ИсполнителиСобственныеКомандаИсполнителиСобственныеПоказатьСкрытьЗакрытых.Пометка = Не Элементы.ИсполнителиСобственныеКомандаИсполнителиСобственныеПоказатьСкрытьЗакрытых.Пометка;
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(ЭтаФорма.ИсполнителиСобственные.Отбор, Новый Структура("ИмяПоля, Представление", "Закрыт", "ПредопределенныйОтборЗакрыт"),
		"ПредопределенныйОтборЗакрыт", ВидСравненияКомпоновкиДанных.Равно, Ложь, Не Элементы.ИсполнителиСобственныеКомандаИсполнителиСобственныеПоказатьСкрытьЗакрытых.Пометка, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто);
	
КонецПроцедуры

