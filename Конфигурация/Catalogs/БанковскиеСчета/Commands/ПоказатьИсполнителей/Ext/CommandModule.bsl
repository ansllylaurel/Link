
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	РасчетныйСчет	= ПараметрКоманды;
	ДоговорСчета	= РаботаСИсполнителями.ПолучитьДоговор(РасчетныйСчет);	
	КорневойЭлемент	= ?(ЗначениеЗаполнено(ДоговорСчета), ДоговорСчета, РасчетныйСчет); 
	ЭтаФорма		= ПараметрыВыполненияКоманды.Источник;
	
	АдресДереваДочернихЭлементов = РаботаСИсполнителями.ПолучитьДочерниеЭлементы(КорневойЭлемент, , "ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)", , ЭтаФорма.УникальныйИдентификатор);
	Если ЗначениеЗаполнено(АдресДереваДочернихЭлементов) Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВидимыеКолонки",				"Представление");
		ДополнительныеПараметры.Вставить("ОтмеченныеЭлементы",			Новый Структура("Элемент", РасчетныйСчет));
		ДополнительныеПараметры.Вставить("ПолеКлючевогоЗначенияСтроки", "Элемент");
		ДополнительныеПараметры.Вставить("ПутьКДаннымКартинкиСтроки",	"ДеревоЗначений.ДанныеКартинки");
		ДополнительныеПараметры.Вставить("КартинкаСтрок",				БиблиотекаКартинок.РегистрСведенийЗапись);
		
		РезультатВопроса = РаботаСФормамиКлиент.ПоказатьДеревоЗначений(АдресДереваДочернихЭлементов, , ЭтаФорма, "Закрыть", "Закрыть", "Договор банковского обслуживания", ДополнительныеПараметры);
	КонецЕсли;	
	
КонецПроцедуры
