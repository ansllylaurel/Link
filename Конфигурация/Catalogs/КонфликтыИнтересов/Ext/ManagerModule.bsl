	ДанныеКонфликтов.Колонки.Добавить("КонфликтИнтересов", Новый ОписаниеТипов(ТипыКонфликтИнтересов));
	ДанныеКонфликтов.Колонки.Добавить("Обстоятельство", Новый ОписаниеТипов("СправочникСсылка.ОбстоятельстваВозникновенияКонфликтаИнтересов"));
