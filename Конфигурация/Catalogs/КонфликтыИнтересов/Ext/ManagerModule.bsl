	ДанныеКонфликтов.Колонки.Добавить("СвязанноеЛицо", Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	ДанныеКонфликтов.Колонки.Добавить("РешениеОбОтказеОтПредотвращения", Новый ОписаниеТипов("ДокументСсылка.ВнутреннийДокумент"));
	ДанныеКонфликтов.Колонки.Добавить("СпособРаскрытияИнформации", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыРаскрытияИнформацииОКонфликтеИнтересов"));
	ДанныеКонфликтов.Колонки.Добавить("ДатаРаскрытияИнформации", Новый ОписаниеТипов("Дата"));
	ДанныеКонфликтов.Колонки.Добавить("РегистрацияИнформацииОКонфликтеИнтересов", Новый ОписаниеТипов("ДокументСсылка.РегистрацияИнформацииОКонфликтеИнтересов"));
	ДанныеКонфликтов.Колонки.Добавить("ДатаСобытия", Новый ОписаниеТипов("Дата"));
	ДанныеКонфликтов.Колонки.Добавить("ВидСобытия", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыИнформацииОКонфликтеИнтересов"));
	
	ДанныеКонфликтов.Колонки.Добавить("СведенияОКлиенте", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	ДанныеКонфликтов.Колонки.Добавить("СодержаниеКонфликтаИнтересов", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	
	Возврат ДанныеКонфликтов;

КонецФункции