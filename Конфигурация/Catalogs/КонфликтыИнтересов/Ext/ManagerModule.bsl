Функция ПолучитьТаблицуДанныеКонфликтов() Экспорт

	ТипыКонфликтИнтересов = Новый Массив;
	ТипыКонфликтИнтересов.Добавить(Тип("СправочникСсылка.КонфликтыИнтересов"));
	ТипыКонфликтИнтересов.Добавить(Тип("Число"));
	
	ДанныеКонфликтов = Новый ТаблицаЗначений;
