		|		ПО _КонфликтыИнтересов.Организация = КлиентыДоверительногоУправления.Организация
		|			И _КонфликтыИнтересов.СчетДоверительногоУправления = КлиентыДоверительногоУправления.СчетДоверительногоУправления
		|			И (ВложенныйЗапрос.ПериодКлиенты = КлиентыДоверительногоУправления.Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц КАК СвязанноеЛицо_ДокументыЮридическихЛиц
		|		ПО _КонфликтыИнтересов.СвязанноеЛицо = СвязанноеЛицо_ДокументыЮридическихЛиц.ЮрФизЛицо
		|			И (ВложенныйЗапрос.ПериодДокументыСвязанногоЛица = СвязанноеЛицо_ДокументыЮридическихЛиц.Период)
		|			И (СвязанноеЛицо_ДокументыЮридическихЛиц.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И (СвязанноеЛицо_ДокументыЮридическихЛиц.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|			И (СвязанноеЛицо_ДокументыЮридическихЛиц.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации))
		|			И (СвязанноеЛицо_ДокументыЮридическихЛиц.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц КАК СвязанноеЛицо_РеквизитыЮридическихЛиц
		|		ПО _КонфликтыИнтересов.СвязанноеЛицо = СвязанноеЛицо_РеквизитыЮридическихЛиц.ЮрФизЛицо
		|			И (ВложенныйЗапрос.ПериодРеквизитыСвязанногоЛица = СвязанноеЛицо_РеквизитыЮридическихЛиц.Период)
		|			И (СвязанноеЛицо_РеквизитыЮридическихЛиц.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И (СвязанноеЛицо_РеквизитыЮридическихЛиц.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПараметрыКонфликта.КонфликтИнтересов КАК КонфликтИнтересов,
		|	_ПараметрыКонфликта.СведенияОСвязанномЛице КАК СодержаниеКонфликтаИнтересов,
		|	ВЫБОР
		|		КОГДА _ПараметрыКонфликта.КлиентПИФ
		|			ТОГДА (ВЫРАЗИТЬ(РеквизитыПИФ.ПолноеНаименованиеФонда КАК СТРОКА(1024))) + "", Правила №"" + РеквизитыПИФ.ПаевойИнвестиционныйФонд.НомерПравил + "" от "" + ПОДСТРОКА(СТРОКА(РеквизитыПИФ.ПаевойИнвестиционныйФонд.ДатаПравил), 1, 10)
		|		КОГДА _ПараметрыКонфликта.Клиент.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
		|			ТОГДА РеквизитыЮридическихЛицАнкетные.ПолноеНаименованиеПоУставу + "", рег. номер "" + РеквизитыЮридическихЛицАнкетные.ОГРН + "", договор №"" + _ПараметрыКонфликта.ДатаНомерДоговора + ВЫБОР
		|					КОГДА _ПараметрыКонфликта.ВидСредствПодУправлением = """"
		|						ТОГДА """"
		|					ИНАЧЕ "", "" + _ПараметрыКонфликта.ВидСредствПодУправлением
		|				КОНЕЦ
		|		ИНАЧЕ РеквизитыФизическихЛицАнкетные.Фамилия + "" "" + РеквизитыФизическихЛицАнкетные.Имя + ВЫБОР
		|				КОГДА РеквизитыФизическихЛицАнкетные.Отчество = """"
		|					ТОГДА """"
		|				ИНАЧЕ "" "" + РеквизитыФизическихЛицАнкетные.Отчество
		|			КОНЕЦ + ВЫБОР
		|				КОГДА РеквизитыФизическихЛицАнкетные.СНИЛС = """"
		|					ТОГДА """"
		|				ИНАЧЕ "", СНИЛС: "" + РеквизитыФизическихЛицАнкетные.СНИЛС
		|			КОНЕЦ + "", договор №"" + _ПараметрыКонфликта.ДатаНомерДоговора
		|	КОНЕЦ КАК СведенияОКлиенте
		|ИЗ
		|	_ПараметрыКонфликта КАК _ПараметрыКонфликта
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_ПараметрыКонфликта.КонфликтИнтересов КАК КонфликтИнтересов,
		|			МАКСИМУМ(ВЫБОР
		|					КОГДА _ПараметрыКонфликта.КлиентПИФ
		|						ТОГДА РеквизитыПИФ.Период
		|					КОГДА _ПараметрыКонфликта.Клиент.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
		|						ТОГДА РеквизитыЮридическихЛицАнкетные.Период
		|					ИНАЧЕ РеквизитыФизическихЛицАнкетные.Период
		|				КОНЕЦ) КАК ПериодРеквизитовКлиента
		|		ИЗ
		|			_ПараметрыКонфликта КАК _ПараметрыКонфликта
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные КАК РеквизитыЮридическихЛицАнкетные
		|				ПО _ПараметрыКонфликта.Клиент = РеквизитыЮридическихЛицАнкетные.ЮрФизЛицо
		|					И _ПараметрыКонфликта.Организация = РеквизитыЮридическихЛицАнкетные.Организация
		|					И _ПараметрыКонфликта.ДатаВозникновения >= РеквизитыЮридическихЛицАнкетные.Период
		|					И (РеквизитыЮридическихЛицАнкетные.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|					И (НЕ _ПараметрыКонфликта.КлиентПИФ)
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ КАК РеквизитыПИФ
		|				ПО _ПараметрыКонфликта.Клиент = РеквизитыПИФ.ПаевойИнвестиционныйФонд
		|					И (_ПараметрыКонфликта.КлиентПИФ)
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные КАК РеквизитыФизическихЛицАнкетные
		|				ПО _ПараметрыКонфликта.Клиент = РеквизитыФизическихЛицАнкетные.ЮрФизЛицо
		|					И _ПараметрыКонфликта.Организация = РеквизитыФизическихЛицАнкетные.Организация
		|					И _ПараметрыКонфликта.ДатаВозникновения >= РеквизитыФизическихЛицАнкетные.Период
		|					И (РеквизитыФизическихЛицАнкетные.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|					И (НЕ _ПараметрыКонфликта.КлиентПИФ)
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_ПараметрыКонфликта.КонфликтИнтересов) КАК ВложенныйЗапрос
		|		ПО _ПараметрыКонфликта.КонфликтИнтересов = ВложенныйЗапрос.КонфликтИнтересов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные КАК РеквизитыЮридическихЛицАнкетные
		|		ПО _ПараметрыКонфликта.Клиент = РеквизитыЮридическихЛицАнкетные.ЮрФизЛицо
		|			И (ВложенныйЗапрос.ПериодРеквизитовКлиента = РеквизитыЮридическихЛицАнкетные.Период)
		|			И (РеквизитыЮридическихЛицАнкетные.Организация = _ПараметрыКонфликта.Организация)
		|			И (РеквизитыЮридическихЛицАнкетные.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные КАК РеквизитыФизическихЛицАнкетные
		|		ПО _ПараметрыКонфликта.Клиент = РеквизитыФизическихЛицАнкетные.ЮрФизЛицо
		|			И (ВложенныйЗапрос.ПериодРеквизитовКлиента = РеквизитыФизическихЛицАнкетные.Период)
		|			И (РеквизитыФизическихЛицАнкетные.Организация = _ПараметрыКонфликта.Организация)
