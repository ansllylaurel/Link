
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.Язык = Справочники.Языки.Русский;
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
КонецПроцедуры
 
#КонецОбласти 

#Область Служебные_процедуры_и_функции

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	УниверсальныеМеханизмы.УстановитьЗаголовокСсылкиОбновить(ЭтаФорма, Объект.Ссылка);
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	ОбновитьДанныеЮрФизЛицаНаСервере();
	
КонецПроцедуры // ПриЧтенииСозданииНаСервере

&НаСервере
Процедура ОбновитьДанныеЮрФизЛицаНаСервере()

	Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	*
		|ИЗ
		|	РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
		|			,
		|			Организация = &Организация
		|				И Язык = &Язык
		|				И ЮрФизЛицо = &ЮрФизЛицо) КАК РеквизитыФизическихЛицСрезПоследних
		|");
	Запрос.УстановитьПараметр("Организация", 	Объект.Организация);        
	Запрос.УстановитьПараметр("Язык", 			ЭтаФорма.Язык);        
	Запрос.УстановитьПараметр("ЮрФизЛицо", 		Объект.ЮрФизЛицо);        

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма.РеквизитыСотрудника, Выборка);	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

