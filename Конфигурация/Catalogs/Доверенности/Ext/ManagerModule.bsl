Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    
    // Перечисляем реквизиты, которые будут нужны для формирования представления
    Поля.Добавить("Номер");
    Поля.Добавить("Дата");
    Поля.Добавить("Наименование");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
    СтандартнаяОбработка = Ложь;
    
    Представление = "№" + Данные.Номер + " от " + Формат(Данные.Дата, "ДФ=dd.MM.yyyy") + " (" + Данные.Наименование + ")";
	
КонецПроцедуры