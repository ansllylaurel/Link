
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ФайлыМЧД = ВыбратьФайл();
	Если ФайлыМЧД <> Неопределено Тогда
		
		// проверяем соответствие формату. Если не соответствует - выводим предупреждение
		ДанныеДоверенности = РаботаСМашиночитаемымиДоверенностями.ПолучитьДанныеДоверенности(ФайлыМЧД.Доверенность.Хранение);
		Если ЗначениеЗаполнено(ДанныеДоверенности.ТекстОшибки) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ДанныеДоверенности.ТекстОшибки);
			Возврат;
		КонецЕсли;
		
		// проверяем подписи. Если не соответствует - выводим предупреждение
		ПроверитьПодписьДоверенности(ФайлыМЧД, ДанныеДоверенности);
				
		// проверяем статус в ФНС. Если не нашли - не страшно, скажем потом
		Попытка
			Статус = РаботаСМашиночитаемымиДоверенностями.ПолучитьСтатусФНС("", ДанныеДоверенности.ДанныеМЧД.ИдентификаторДоверенности);
		Исключение
			ТекстОшибки = "Не удалось получить статус доверенности в ФНС. Система сообщает:" + Символы.ПС;
			ОписаниеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки + ОписаниеОшибки);
		КонецПопытки;
		
		Если ЗначениеЗаполнено(Статус) Тогда
			ДанныеДоверенности.ДанныеМЧД.СтатусВФНС = ПредопределенноеЗначение("Перечисление.СтатусыМашиночитаемойДоверенностиВРеестреФНС." + Статус);
		КонецЕсли;
		
		ДанныеДоверенности.ДанныеМЧД.ДатаПроверкиСтатуса = ТекущаяДата();
		
		// Открываем форму с основными данными МЧД
		ПараметрыФормы = Новый Структура("ФайлыМЧД, ДанныеДоверенности", ФайлыМЧД, ДанныеДоверенности);
		ОткрытьФорму("Справочник.Доверенности.Форма.ИмпортМЧД", 
			ПараметрыФормы, 
			ПараметрыВыполненияКоманды.Источник, 
			ПараметрыВыполненияКоманды.Уникальность, 
			ПараметрыВыполненияКоманды.Окно, 
			ПараметрыВыполненияКоманды.НавигационнаяСсылка,
			Неопределено,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

#Область Получение_файлов_доверенности

&НаКлиенте
Функция ВыбратьФайл()

	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Заголовок = "Загрузка доверенности из файла";
	ДиалогВыбора.Фильтр = СтрШаблон("Файлы доверенностей (%1)|%2", 
		"*.xml;*.p7s;*.sig;*.zip;*.7z", 
		"ON_EMCHD*.xml;ON_EMCHD*.p7s;ON_EMCHD*.sig;ON_DOVBB*.xml;ON_DOVBB*.p7s;ON_DOVBB*.sig;*.zip;*.7z");
	ДиалогВыбора.МножественныйВыбор = Истина;
	
	Если ДиалогВыбора.Выбрать() Тогда
		Возврат ФайлыМЧД(ДиалогВыбора.ВыбранныеФайлы);
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ФайлыМЧД(ВыбранныеФайлы) 

	ФайлыДоверенностей = Новый Массив;
	ФайлыПодписей = Новый Массив;
	ФайлыZip = Новый Массив;
	ФайлыДоверенности = Неопределено;
	
	Для Каждого ИмяФайла Из ВыбранныеФайлы Цикл
			
		Файл = Новый Файл(ИмяФайла);
		
		Если НРег(Файл.Расширение) = ".zip" Или НРег(Файл.Расширение) = ".7z" Тогда
			
			ФайлыZip.Добавить(Файл);
			
		ИначеЕсли СтрНачинаетсяС(Файл.Имя, "ON_EMCHD") Или СтрНачинаетсяС(Файл.Имя, "ON_DOVBB") Тогда
			
			Если НРег(Файл.Расширение) = ".xml" Тогда
				ФайлыДоверенностей.Добавить(Файл);
			ИначеЕсли ЭтоФайлПодписи(ИмяФайла) Тогда
				ФайлыПодписей.Добавить(Файл);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	

	Если ФайлыДоверенностей.Количество() = 1 И ФайлыПодписей.Количество() = 1 Тогда
	
		Если СтрНачинаетсяС(ФайлыПодписей[0].Имя, ФайлыДоверенностей[0].ИмяБезРасширения) Тогда
		
			ФайлыДоверенности = Новый Структура;
			
			ОписаниеФайла = Новый Структура;
			ОписаниеФайла.Вставить("Имя", ФайлыДоверенностей[0].Имя);
			ОписаниеФайла.Вставить("Хранение", ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ФайлыДоверенностей[0].ПолноеИмя), Новый УникальныйИдентификатор));
			ФайлыДоверенности.Вставить("Доверенность", ОписаниеФайла);
			
			ОписаниеФайла = Новый Структура;
			ОписаниеФайла.Вставить("Имя", ФайлыПодписей[0].Имя);
			ОписаниеФайла.Вставить("Хранение", ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ФайлыПодписей[0].ПолноеИмя), Новый УникальныйИдентификатор));
			ФайлыДоверенности.Вставить("Подпись", ОписаниеФайла);
		
		КонецЕсли;
		
	ИначеЕсли ФайлыZip.Количество() > 0 Тогда
		
		Для каждого Файл Из ФайлыZip Цикл
		
			// Распаковать во временный каталог
			ВременныйКаталог = КаталогВременныхФайлов();
			ВременныйКаталог = ВременныйКаталог + Новый УникальныйИдентификатор + Прав(ВременныйКаталог, 1);
			
			Если НРег(Файл.Расширение) = ".zip" Тогда
			
				ЧтениеZipФайла = Новый ЧтениеZipФайла(Файл.ПолноеИмя);
				ЧтениеZipФайла.ИзвлечьВсе(ВременныйКаталог, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
				ЧтениеZipФайла.Закрыть();
				
			Иначе
				
				// арихватор должен быть установлен и прописан в path
				// https://www.7-zip.org/
				//ИмяИсполняемогоФайла = "7z.exe";
				ИмяИсполняемогоФайла = "C:\Program Files\7-Zip\7z.exe";
				//сформируем команду
				ПараметрыЗапуска = " e"; //e - extract (Распаковка)
				//путь к архиву
				ПараметрыЗапуска = ПараметрыЗапуска + " """ + Файл.ПолноеИмя + """";
				//путь к папке распаковки
				ПараметрыЗапуска = ПараметрыЗапуска + " -o""" + ВременныйКаталог + """";
				//рекурсивный обход архива
				ПараметрыЗапуска = ПараметрыЗапуска + " -r";
				//отвечать на все вопросы yes
				ПараметрыЗапуска = ПараметрыЗапуска + " -y";
				
				// ждем завершения, иначе файлы потом не удалятся
				Ошибки = 0;
				ЗапуститьПриложение(ИмяИсполняемогоФайла + ПараметрыЗапуска, , Истина, Ошибки);
				
				Если Ошибки <> 0 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось распаковать файл: " + Файл.ПолноеИмя);
					Продолжить;
				КонецЕсли;
			
			КонецЕсли;
			
			НайденныеФайлы = НайтиФайлы(ВременныйКаталог, ПолучитьМаскуВсеФайлы(), Истина);
			ФайлыАрхива = Новый Массив;
			
			Для Каждого НайденныйФайл Из НайденныеФайлы Цикл
				
				Если НайденныйФайл.ЭтоФайл() Тогда
					ФайлыАрхива.Добавить(НайденныйФайл.ПолноеИмя);
				КонецЕсли;
				
				Если НайденныйФайл.ПолучитьТолькоЧтение() Тогда
					НайденныйФайл.УстановитьТолькоЧтение(Ложь);	
				КонецЕсли;
	
			КонецЦикла;
			
			ФайлыДоверенности = ФайлыМЧД(ФайлыАрхива);
			
			УдалитьФайлы(ВременныйКаталог);			
			
			Если ФайлыДоверенности <> Неопределено Тогда
				Прервать;
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ФайлыДоверенности;
	
КонецФункции

&НаКлиенте
Функция ЭтоФайлПодписи(ИмяФайла)
	
	Файл = Новый Файл(ИмяФайла);
	Возврат Файл.Расширение = ".p7s" Или Файл.Расширение = ".sig";
	
КонецФункции

#КонецОбласти

#Область Проверка_подписи

&НаКлиенте
Процедура ПроверитьПодписьДоверенности(ФайлыМЧД, ДанныеДоверенности)
 
	Доверенность = ПолучитьИзВременногоХранилища(ФайлыМЧД.Доверенность.Хранение);
	Подпись = ПолучитьИзВременногоХранилища(ФайлыМЧД.Подпись.Хранение);
	
	Ошибки = Новый Массив;
	
	НастройкиПрограммыКриптографии = РаботаСКриптографией.НастройкиПрограммы("КриптоПро CSP (ГОСТ 2001)");
	МенеджерКриптографии = Неопределено;
	
	Попытка
		МенеджерКриптографии = Новый МенеджерКриптографии(
			НастройкиПрограммыКриптографии.ИмяПрограммы, 
			"", 
			НастройкиПрограммыКриптографии.ТипПрограммы);
	Исключение
		Ошибки.Добавить("Не удалось подключить программу для работы с электронной подписью. Система сообщает:" 
			+ Символы.ПС + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если МенеджерКриптографии <> Неопределено Тогда
	
		Попытка
			МенеджерКриптографии.ПроверитьПодпись(Доверенность, Подпись, Неопределено);
			ПодписьВерна = Истина;
		Исключение
			ПодписьВерна = Ложь;
			Ошибки.Добавить(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
		СертификатыКриптографии = МенеджерКриптографии.ПолучитьСертификатыИзПодписи(Подпись);
		Сертификат = РаботаСКриптографиейКлиент.НайтиСертификатПодписавшейСтороныРекурсивно(СертификатыКриптографии);
		
		ДанныеСертификата = ПолучитьДанныеСертификата(Сертификат);
		ДанныеПодписи = ПолучитьДанныеПодписи(Подпись);
		
		РезультатПроверкиПодписи = ПроверитьПодпись(Сертификат, ДанныеСертификата, ДанныеПодписи, ПодписьВерна);
		РезультатПроверкиДоверенности = РезультатПроверкиДоверенности(ДанныеДоверенности.ДанныеМЧД, РезультатПроверкиПодписи);
		
		Если ЗначениеЗаполнено(РезультатПроверкиПодписи.ОписаниеОшибки) Тогда
			Ошибки.Добавить(РезультатПроверкиПодписи.ОписаниеОшибки);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(РезультатПроверкиДоверенности.ТекстОшибки) Тогда
			Ошибки.Добавить(РезультатПроверкиДоверенности.ТекстОшибки);
		КонецЕсли;
		
		ДоверенностьВерна = ПодписьВерна И РезультатПроверкиПодписи.РезультатПроверкиУдостоверяющегоЦентраСертификата.Действует
			И РезультатПроверкиДоверенности.Результат;
			
	Иначе
		
		ДоверенностьВерна = Ложь;
		
	КонецЕсли;

	ТекстОшибкиПроверкиМЧД = СтрСоединить(Ошибки, Символы.ПС);	
	
	ДанныеДоверенности.Вставить("ДоверенностьВерна", ДоверенностьВерна);
	ДанныеДоверенности.Вставить("ТекстОшибкиПроверкиМЧД", ТекстОшибкиПроверкиМЧД);

КонецПроцедуры

&НаКлиенте
Функция ПроверитьПодпись(СертификатКриптографии, ДанныеСертификата, ДанныеПодписи, Знач ПодписьВерна)

	ДатаПодписания = ДатаДляПроверкиСертификатаПодписи(ДанныеПодписи);
	
	РезультатПроверкиУдостоверяющегоЦентраСертификата = РезультатПроверкиУдостоверяющегоЦентраСертификата(
		СертификатКриптографии, ?(ДатаПодписания = Неопределено, ТекущаяДата(), ДатаПодписания), ДанныеСертификата);
		
	СвойстваПодписи = Новый Структура("ДанныеСертификата, ПодписьВерна, СертификатДействует");
	СвойстваПодписи.ДанныеСертификата = ДанныеСертификата;
	СвойстваПодписи.ПодписьВерна = ПодписьВерна;
	СвойстваПодписи.СертификатДействует = РезультатПроверкиУдостоверяющегоЦентраСертификата.Действует;
	
	РезультатПроверкиПодписи = Новый Структура("СвойстваПодписи, ОписаниеОшибки, РезультатПроверкиУдостоверяющегоЦентраСертификата");
	РезультатПроверкиПодписи.СвойстваПодписи = СвойстваПодписи;
	РезультатПроверкиПодписи.ОписаниеОшибки = РезультатПроверкиУдостоверяющегоЦентраСертификата.Предупреждение.ТекстОшибки;
	РезультатПроверкиПодписи.РезультатПроверкиУдостоверяющегоЦентраСертификата = РезультатПроверкиУдостоверяющегоЦентраСертификата;
	
	Возврат РезультатПроверкиПодписи;
	
КонецФункции 

&НаКлиенте
Функция РезультатПроверкиУдостоверяющегоЦентраСертификата(СертификатКриптографии, НаДату, СвойстваСертификата)
	
	Результат = РезультатПоУмолчанию();
	
	ДанныеДляПроверкиУдостоверяющегоЦентра = ДанныеДляПроверкиУдостоверяющегоЦентра(СвойстваСертификата.СвойстваИздателя);
	
	Если ДанныеДляПроверкиУдостоверяющегоЦентра.ЗначенияПоиска = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	АккредитованныеУдостоверяющиеЦентры = АккредитованныеУдостоверяющиеЦентры();
	
	ДанныеУдостоверяющегоЦентра = ДанныеУдостоверяющегоЦентра(ДанныеДляПроверкиУдостоверяющегоЦентра.ЗначенияПоиска, АккредитованныеУдостоверяющиеЦентры);

	Если ДанныеУдостоверяющегоЦентра = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	НаименованиеУдостоверяющегоЦентра = ДанныеДляПроверкиУдостоверяющегоЦентра.НаименованиеУдостоверяющегоЦентра;
	
	Результат.НайденВСпискеУдостоверяющихЦентров = Истина;
	Результат.Государственный = ДанныеУдостоверяющегоЦентра.Государственный;
	
	ДатаВыдачиСертификатаДляСравнения = СвойстваСертификата.ДатаНачала;
	
	Количество = ДанныеУдостоверяющегоЦентра.ПериодыДействия.Количество();
	
	ЭтоКвалифицированныйСертификат = Ложь;
	
	Для НомерСКонца = 1 По Количество Цикл
		
		ПериодДействия = ДанныеУдостоверяющегоЦентра.ПериодыДействия[Количество - НомерСКонца];
		
		Если ДатаВыдачиСертификатаДляСравнения < ПериодДействия.ДатаС Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПериодДействия.ДатаПо) Или ДатаВыдачиСертификатаДляСравнения <= ПериодДействия.ДатаПо Тогда
			ЭтоКвалифицированныйСертификат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЭтоКвалифицированныйСертификат Тогда
		Результат.Действует = ДанныеУдостоверяющегоЦентра.РазрешенныйНеаккредитованный;
		ТекстОшибки = СтрШаблон(
			"Сертификат неквалифицированный, так как выпущен удостоверяющим центром %1, не аккредитованным на момент выпуска сертификата.",
			НаименованиеУдостоверяющегоЦентра);
		Если ДанныеУдостоверяющегоЦентра.РазрешенныйНеаккредитованный Тогда
			Результат.Предупреждение.ДополнительныеСведения = ТекстОшибки;
		Иначе
			Результат.Предупреждение.ТекстОшибки = ТекстОшибки;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	Результат.Действует = Ложь;
	Результат.ЭтоКвалифицированныйСертификат = Истина;
	
	ДатаПрекращенияАккредитацииУЦ = Неопределено;
	
	Для НомерСКонца = 1 По Количество Цикл
		
		ПериодДействия = ДанныеУдостоверяющегоЦентра.ПериодыДействия[Количество - НомерСКонца];
		
		Если НаДату < ПериодДействия.ДатаС Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПериодДействия.ДатаПо) Или НаДату <= ПериодДействия.ДатаПо Тогда
			Результат.Действует = Истина;
			Прервать;
		КонецЕсли;
		
		Если НаДату > ПериодДействия.ДатаПо Тогда
			Результат.Действует = Ложь;
			ДатаПрекращенияАккредитацииУЦ = ПериодДействия.ДатаПо;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	СвойстваСубъекта = СвойстваСертификата.СвойстваСубъекта;
	ЭтоИННФизЛица = ЗначениеЗаполнено(СвойстваСубъекта.ИНН) И ЭтоИННФизЛица(СвойстваСубъекта.ИНН);
	
	ЭтоЮридическоеЛицо = ЗначениеЗаполнено(СвойстваСубъекта.ИННЮЛ) Или Не ЭтоИННФизЛица;
	ЭтоИндивидуальныйПредприниматель = ЗначениеЗаполнено(СвойстваСубъекта.ОГРНИП);
	ЭтоОбезличенныйСертификат = Не ЗначениеЗаполнено(СвойстваСубъекта.Фамилия);
	ЭтоФизическоеЛицо = Не ЭтоЮридическоеЛицо И Не ЭтоИндивидуальныйПредприниматель;
	
	ДатаПрекращенияДействия = ДанныеУдостоверяющегоЦентра.ДругиеНастройки.Получить("ДатаПрекращенияДействияСертификатовВыданныхКоммерческимиУЦ") + 10800;
	
	Если ЭтоОбезличенныйСертификат И Не ДанныеУдостоверяющегоЦентра.Государственный Тогда
		Возврат РезультатПоУмолчанию();
	КонецЕсли;
	
	ВозможенПеревыпуск = ЭтоФизическоеЛицо Или Не ДанныеУдостоверяющегоЦентра.Государственный;
	
	// Аккредитация удостоверяющего центра прекращена.
	Если Не Результат.Действует Тогда
		
		Если ДанныеУдостоверяющегоЦентра.РазрешенныйНеаккредитованный Тогда
			Результат.Действует = Истина;
			Результат.Предупреждение.ДополнительныеСведения = СтрШаблон(
				"Сертификат выдан удостоверяющим центром %1, аккредитация которого прекращена %2, но использование разрешено администратором.",
				НаименованиеУдостоверяющегоЦентра,
				Формат(ДатаПрекращенияАккредитацииУЦ, "ДЛФ=DT"));
			Возврат Результат;
		КонецЕсли;
		
		Результат.Предупреждение.ТекстОшибки = СтрШаблон(
				"Сертификат не действует с %1, так как аккредитация удостоверяющего центра %2, выдавшего сертификат, прекращена.",
				Формат(ДатаПрекращенияАккредитацииУЦ, "ДЛФ=DT"), НаименованиеУдостоверяющегоЦентра);
			
		Возврат Результат;
		
	КонецЕсли;
	
	ДатаПредупреждения = Неопределено;
	
	// Сертификаты ЮЛ и ИП, выданные коммерческими АУЦ не действуют или не будут действовать.
	Если Не ДанныеУдостоверяющегоЦентра.Государственный И Не ЭтоФизическоеЛицо Тогда
		
		ДатаОкончанияВыдачиСертификатовСотрудниковКоммерческимиУЦ = Дата(2023, 08, 31, 21, 0, 0); // Универсальная дата от московского времени
		
		Если СвойстваСертификата.ДатаНачала > ДатаОкончанияВыдачиСертификатовСотрудниковКоммерческимиУЦ Тогда
			
			Результат.Действует = Ложь;
			Результат.Предупреждение.ВозможенПеревыпуск = Ложь;
	
			ТекстОшибки = "Сертификат не действует, так как выдан коммерческим аккредитованным удостоверяющим центром после %1.";
	
			Результат.Предупреждение.ТекстОшибки = СтрШаблон(
				ТекстОшибки, Формат(ДатаОкончанияВыдачиСертификатовСотрудниковКоммерческимиУЦ, "ДЛФ=D"));
	
		ИначеЕсли ДатаПрекращенияДействия <> Неопределено И НаДату >= ДатаПрекращенияДействия Тогда
		
			Результат.Действует = (НаДату < ДатаПрекращенияДействия);
			Результат.Предупреждение.ВозможенПеревыпуск = Истина;
	
			Если НаДату < ДатаПрекращенияДействия Тогда
				Если ЭтоИндивидуальныйПредприниматель Тогда
					ТекстОшибки = 
						"С %1 нельзя будет подписывать документы этим сертификатом, так как не будут действовать сертификаты, выданные коммерческими аккредитованными удостоверяющими центрами индивидуальным предпринимателям.";
				Иначе
					ТекстОшибки = 
						"С %1 нельзя будет подписывать документы этим сертификатом, так как не будут действовать сертификаты, выданные коммерческими аккредитованными удостоверяющими центрами юридическим лицам и их сотрудникам.";
				КонецЕсли;
				ДатаПредупреждения = ДатаПрекращенияДействия;
			Иначе
				Если ЭтоИндивидуальныйПредприниматель Тогда
					ТекстОшибки = 
						"Сертификат не действует c %1, так как с этой даты не действуют сертификаты, выданные коммерческими аккредитованными удостоверяющими центрами индивидуальным предпринимателям.";
				Иначе
					ТекстОшибки = 
						"Сертификат не действует c %1, так как с этой даты не действуют сертификаты, выданные коммерческими аккредитованными удостоверяющими центрами юридическим лицам и их сотрудникам.";
				КонецЕсли;
			КонецЕсли;
	
			Результат.Предупреждение.ТекстОшибки = СтрШаблон(
				ТекстОшибки, Формат(ДатаПрекращенияДействия, "ДЛФ=D"));
	
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция РезультатПоУмолчанию()

	Результат = Новый Структура;
	Результат.Вставить("Действует", Истина);
	Результат.Вставить("НайденВСпискеУдостоверяющихЦентров", Ложь);
	Результат.Вставить("Государственный", Ложь);
	Результат.Вставить("ЭтоКвалифицированныйСертификат", Ложь);
	
	Предупреждение = Новый Структура;
	Предупреждение.Вставить("ТекстОшибки", "");
	Предупреждение.Вставить("ВозможенПеревыпуск", Ложь);
	Предупреждение.Вставить("Причина", "");
	Предупреждение.Вставить("Решение", "");
	Предупреждение.Вставить("ДополнительныеСведения", "");
	
	Результат.Вставить("Предупреждение", Предупреждение);
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ДатаДляПроверкиСертификатаПодписи(ПараметрыПодписи) Экспорт
	
	Если ЗначениеЗаполнено(РаботаСКоллекциями.СвойствоСтруктуры(
		ПараметрыПодписи, "ДатаПодписиИзМетки", Неопределено)) Тогда
		Возврат ПараметрыПодписи.ДатаПодписиИзМетки;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РаботаСКоллекциями.СвойствоСтруктуры(
		ПараметрыПодписи, "НеподтвержденнаяДатаПодписи", Неопределено)) Тогда
		Возврат ПараметрыПодписи.НеподтвержденнаяДатаПодписи;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция РезультатПроверкиДоверенности(ДанныеДоверенности, РезультатПроверкиПодписи) Экспорт
	
	РезультатПроверки = Новый Структура("Результат, ТекстОшибки", Ложь, "");
	
	ИННПодписантаФЛ = "";
	ИННПодписантаЮЛ = "";
	Сертификат = Неопределено;
	СвойстваСубъектаСертификата = Неопределено;
	Ошибки = Новый Массив;
	
	ИННДоверителяФЛ = ДанныеДоверенности.ДоверительИННФЛ;
	ИННДоверителяЮЛ = ДанныеДоверенности.ДоверительИННЮЛ;
	
	СНИЛСПодписанта = "";
	СНИЛСДоверителяФЛ = ДанныеДоверенности.СНИЛСДоверителяФЛ;
	ЭтоПередоверие = ДанныеДоверенности.ЭтоПередоверие;
	ВерсияФормата = ДанныеДоверенности.ВерсияФормата;
	
	СвойстваПодписи = РезультатПроверкиПодписи.СвойстваПодписи;
	Если СвойстваПодписи.ДанныеСертификата <> Неопределено Тогда
		
		СвойстваСубъектаСертификата = СвойстваПодписи.ДанныеСертификата.СвойстваСубъекта;
		
		Если ЗначениеЗаполнено(СвойстваСубъектаСертификата.ИННЮЛ) Тогда
			ИННПодписантаЮЛ = СвойстваСубъектаСертификата.ИННЮЛ;
			ИННПодписантаФЛ = СвойстваСубъектаСертификата.ИНН;
		Иначе
			ИННПодписантаЮЛ = Прав(СвойстваСубъектаСертификата.ИНН, 10);
		КонецЕсли;
		
		СНИЛСПодписанта = 
			РаботаСоСтрокамиКлиентСервер.ЗаменитьОдниСимволыДругими("- ", СвойстваСубъектаСертификата.СНИЛС, "");
		
	КонецЕсли;
	
	ПодписьВерна = РезультатПроверкиПодписи.СвойстваПодписи.ПодписьВерна;
	Если РезультатПроверкиПодписи.ОписаниеОшибки = "" Тогда
		СертификатДействителен = Истина;
	Иначе
		СертификатДействителен = Ложь;
		Ошибки.Добавить(РезультатПроверкиПодписи.ОписаниеОшибки);
	КонецЕсли;
	
	Если ЭтоПередоверие Тогда
		ДоверенностьПодписанаДоверителем = Истина;
	ИначеЕсли ЗначениеЗаполнено(ИННДоверителяФЛ) Тогда
		ДоверенностьПодписанаДоверителем = (ИННПодписантаФЛ = ИННДоверителяФЛ);
	ИначеЕсли ЗначениеЗаполнено(СНИЛСДоверителяФЛ) Тогда
		ДоверенностьПодписанаДоверителем = (СНИЛСПодписанта = СНИЛСДоверителяФЛ);
	Иначе
		ДоверенностьПодписанаДоверителем = Ложь;
	КонецЕсли;
	
	СертификатПодписантаНеСодержитИННФизЛица = НЕ ЗначениеЗаполнено(ИННПодписантаФЛ); // выпускались по 21.09.2021
	Если (Не ДоверенностьПодписанаДоверителем
			И ЗначениеЗаполнено(ИННПодписантаФЛ)
			И ЗначениеЗаполнено(ИННДоверителяФЛ))
		Или Не (СертификатПодписантаНеСодержитИННФизЛица 
					ИЛИ ДоверенностьПодписанаДоверителем) Тогда
		ТекстОшибки = "Доверенность подписана лицом, которое не является доверителем по данной доверенности.";
		Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
	ДоверенностьВыданаГосОрганомУЦ = РаботаСКриптографиейКлиент.ЭтоИННГосОрганаЯвляющегосяУдостоверяющимЦентром(ИННДоверителяЮЛ);
	ЭтоДоверенностьОтИП = ИННДоверителяФЛ = ИННДоверителяЮЛ ИЛИ НЕ ЗначениеЗаполнено(ИННДоверителяЮЛ);
	ДоверительЯвляетсяУполномоченнымПредставителемОрганизации =
		ЭтоДоверенностьОтИП
		ИЛИ (ИННПодписантаЮЛ = ИННДоверителяЮЛ)
		Или (ДоверенностьВыданаГосОрганомУЦ
				И РаботаСКриптографиейКлиент.ЭтоСертификатДолжностногоЛицаГосОрганаУЦ(Сертификат));
		
	Если Не ДоверительЯвляетсяУполномоченнымПредставителемОрганизации Тогда
		ТекстОшибки = "Доверенность подписана лицом, которое не является уполномоченным представителем организации.";
		Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
	РезультатПроверки.ТекстОшибки = СтрСоединить(Ошибки, Символы.ПС);
	
	РезультатПроверки.Результат = ПодписьВерна
		И СертификатДействителен
		И (СертификатПодписантаНеСодержитИННФизЛица
			ИЛИ ДоверенностьПодписанаДоверителем)
		И ДоверительЯвляетсяУполномоченнымПредставителемОрганизации
		И ЗначениеЗаполнено(ВерсияФормата);
	
	Возврат РезультатПроверки;
	
КонецФункции

#Область Классификатор_удостоверяющих_центров

&НаКлиенте
Функция ДанныеУдостоверяющегоЦентра(ЗначенияПоиска, АккредитованныеУдостоверяющиеЦентры) Экспорт
	
	Результат = Неопределено;
	
	Если АккредитованныеУдостоверяющиеЦентры = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НайденПериодДействия = Неопределено;
	НайденаДатаОкончанияДействия = Неопределено;
	МассивПолейПоиска = СтрРазделить(ЗначенияПоиска, ",");
	Государственный = Ложь;
	РазрешенныйНеаккредитованный = Ложь;
	
	Для Каждого ЗначениеПоиска Из МассивПолейПоиска Цикл
		
		ПодготовленноеЗначениеПоиска = ПодготовитьЗначениеПоиска(ЗначениеПоиска);
		
		Если НайденПериодДействия = Неопределено Тогда
			НайденПериодДействия = АккредитованныеУдостоверяющиеЦентры.ПериодыДействия.Получить(ПодготовленноеЗначениеПоиска);
		КонецЕсли;
		
		Если НайденаДатаОкончанияДействия = Неопределено Тогда
			НайденаДатаОкончанияДействия = АккредитованныеУдостоверяющиеЦентры.ДатыОкончанияДействия.Получить(ПодготовленноеЗначениеПоиска);
		КонецЕсли;
		
		Если Не Государственный И АккредитованныеУдостоверяющиеЦентры.ГосударственныеУЦ.Получить(ПодготовленноеЗначениеПоиска) <> Неопределено Тогда
			Государственный = Истина;
		КонецЕсли;
		
		Если Не РазрешенныйНеаккредитованный И АккредитованныеУдостоверяющиеЦентры.РазрешенныеНеаккредитованныеУЦ.Получить(ПодготовленноеЗначениеПоиска) <> Неопределено Тогда
			РазрешенныйНеаккредитованный = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НайденПериодДействия = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Государственный",              Государственный);
	Результат.Вставить("РазрешенныйНеаккредитованный", РазрешенныйНеаккредитованный);
	Результат.Вставить("ПериодыДействия",       НайденПериодДействия);
	Результат.Вставить("ДатаОкончанияДействия", НайденаДатаОкончанияДействия);
	Результат.Вставить("ДатаОбновления",  АккредитованныеУдостоверяющиеЦентры.ДатаОбновления);
	Результат.Вставить("ДругиеНастройки", АккредитованныеУдостоверяющиеЦентры.ДругиеНастройки);
	
	Возврат Результат;
	
КонецФункции 

&НаКлиентеНаСервере
Функция ПодготовитьЗначениеПоиска(Знач ЗначениеПоиска) Экспорт
	
	ЗначениеПоиска = ВРег(ЗначениеПоиска);
	ЗначениеПоиска = СтрЗаменить(ЗначениеПоиска, """", "");
	ЗначениеПоиска = СтрЗаменить(ЗначениеПоиска, "«", "");
	ЗначениеПоиска = СтрЗаменить(ЗначениеПоиска, "»", "");
	ЗначениеПоиска = СтрЗаменить(ЗначениеПоиска, "“", "");
	ЗначениеПоиска = СтрЗаменить(ЗначениеПоиска, "”", "");
	
	Возврат ЗначениеПоиска;
	
КонецФункции

&НаКлиенте
Функция ДанныеДляПроверкиУдостоверяющегоЦентра(СвойстваИздателя) Экспорт
	
	Результат = Новый Структура("ЗначенияПоиска, НаименованиеУдостоверяющегоЦентра");
	Результат.НаименованиеУдостоверяющегоЦентра = СвойстваИздателя.ОбщееИмя;
	
	ЗначенияПоиска = Новый Массив;
	
	Если СвойстваИздателя.Свойство("ОГРН") И ЗначениеЗаполнено(СвойстваИздателя.ОГРН) Тогда
		ЗначенияПоиска.Добавить(СвойстваИздателя.ОГРН);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвойстваИздателя.ОбщееИмя) Тогда
		ЗначенияПоиска.Добавить(СвойстваИздателя.ОбщееИмя);
	КонецЕсли;
	
	Если ЗначенияПоиска.Количество() > 0 Тогда
		Результат.ЗначенияПоиска = СтрСоединить(ЗначенияПоиска, ",");
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция АккредитованныеУдостоверяющиеЦентры()
	
	ДанныеУдостоверяющихЦентров = ДанныеУдостоверяющихЦентровИзМакета();
	
	Результат = Новый Структура;
	Результат.Вставить("ПериодыДействия", ДанныеУдостоверяющихЦентров.ПериодыДействия.Данные);
	Результат.Вставить("ДатаОбновления", ДанныеУдостоверяющихЦентров.ПериодыДействия.ДатаОбновления);
	Результат.Вставить("ДатыОкончанияДействия", ДанныеУдостоверяющихЦентров.ДатыОкончанияДействия.Данные);
	Результат.Вставить("ГосударственныеУЦ", ДанныеУдостоверяющихЦентров.ГосударственныеУЦ);
	Результат.Вставить("РазрешенныеНеаккредитованныеУЦ", Новый Соответствие);
	Результат.Вставить("ДругиеНастройки", ДанныеУдостоверяющихЦентров.ДругиеНастройки);
	
	Возврат Результат;

КонецФункции

&НаСервере
Функция ДанныеУдостоверяющихЦентровИзМакета()
	
	ДвоичныеДанныеКлассификатора = Справочники.Доверенности.ПолучитьМакет("КлассификаторАУЦ_1_0_0_1");
    ДанныеУЦ = ПрочитатьАрхивКлассификатора(ДвоичныеДанныеКлассификатора);

	Возврат ДанныеУЦ;
		
КонецФункции

&НаСервере
Функция ПрочитатьАрхивКлассификатора(Знач Архив, Версия = 0)
	
	КаталогОбновлений = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов() + Новый УникальныйИдентификатор + "\";
	
	ЧтениеZipФайла = Новый ЧтениеZipФайла(Архив.ОткрытьПотокДляЧтения());
	ИмяФайлаПериодыДействия = Неопределено;
	ИмяФайлаДатыОкончания   = Неопределено;
	ИмяФайлаДругиеНастройки = Неопределено;
	
	Для Каждого ЭлементАрхива Из ЧтениеZipФайла.Элементы Цикл
		Если СтрНачинаетсяС(ЭлементАрхива.Имя, "AccreditedCA") Тогда
			ИмяФайлаПериодыДействия = ЭлементАрхива.Имя;
			ЧтениеZipФайла.Извлечь(ЭлементАрхива, КаталогОбновлений);
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(ЭлементАрхива.Имя, "CAExpirationDateList") Тогда
			ИмяФайлаДатыОкончания = ЭлементАрхива.Имя;
			ЧтениеZipФайла.Извлечь(ЭлементАрхива, КаталогОбновлений);
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(ЭлементАрхива.Имя, "Settings") Тогда
			ИмяФайлаДругиеНастройки = ЭлементАрхива.Имя;
			ЧтениеZipФайла.Извлечь(ЭлементАрхива, КаталогОбновлений);
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	
	ЧтениеZipФайла.Закрыть();
	
	ДанныеУЦ = Новый Структура;
	ДанныеУЦ.Вставить("ПериодыДействия", Новый Структура("Данные, Версия, ДатаОбновления", Новый Соответствие, 0, Дата(1,1,1)));
	ДанныеУЦ.Вставить("ДатыОкончанияДействия", Новый Структура("Данные, Версия, ДатаОбновления", Новый Соответствие, 0, Дата(1,1,1)));
	ДанныеУЦ.Вставить("ГосударственныеУЦ", Новый Соответствие);
	ДанныеУЦ.Вставить("ДругиеНастройки", Новый Соответствие);
	
	Если ИмяФайлаДатыОкончания <> Неопределено Тогда
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.ОткрытьФайл(КаталогОбновлений + ИмяФайлаДатыОкончания);
		ДатыОкончания = ПрочитатьJSON(ЧтениеJSON); // Структура
		ЧтениеJSON.Закрыть();
		
		// Подготовка соответствия для быстрого поиска.
		Соответствие = Новый Соответствие;
		Для Каждого УЦ Из ДатыОкончания Цикл
			Соответствие.Вставить(УЦ.ОГРН, ПрочитатьДатуJSON(УЦ.ДатаОкончанияДействия, ФорматДатыJSON.ISO));
		КонецЦикла;
	
		ДанныеУЦ.ДатыОкончанияДействия.Данные = Соответствие;
		
	Иначе
		ДанныеУЦ.ДатыОкончанияДействия.Данные = Новый Соответствие;
	КонецЕсли;
	
	ДанныеУЦ.ДатыОкончанияДействия.Версия = Версия;
	ДанныеУЦ.ДатыОкончанияДействия.ДатаОбновления = ТекущаяДатаСеанса();
	
	Если ИмяФайлаПериодыДействия <> Неопределено Тогда
		
		СписокУЦ = ПрочитатьФайлПериодовДействияУЦ(КаталогОбновлений + ИмяФайлаПериодыДействия);
		
		// Подготовка соответствия для быстрого поиска.
		Соответствие = Новый Соответствие;
		ГосударственныеУЦ = Новый Соответствие;
		Для Каждого УЦ Из СписокУЦ Цикл
			
			Наименование = ПодготовитьЗначениеПоиска(УЦ.Наименование);
			КраткоеНаименование = ПодготовитьЗначениеПоиска(УЦ.КраткоеНаименование);
			
			ПериодыДействияМассив = Новый Массив;
			Для Каждого ТекущийПериод Из УЦ.ПериодыДействия Цикл
				ПериодДействияСтруктура = Новый Структура("ДатаС, ДатаПо");
				ПериодДействияСтруктура.ДатаС = ПрочитатьДатуJSON(ТекущийПериод.ДатаС, ФорматДатыJSON.ISO);
				Если ЗначениеЗаполнено(ТекущийПериод.ДатаПо) Тогда
					ПериодДействияСтруктура.ДатаПо = ПрочитатьДатуJSON(ТекущийПериод.ДатаПо, ФорматДатыJSON.ISO);
				КонецЕсли;
				ПериодыДействияМассив.Добавить(ПериодДействияСтруктура);
			КонецЦикла;
			
			Соответствие.Вставить(УЦ.ОГРН, ПериодыДействияМассив);
			Соответствие.Вставить(Наименование, ПериодыДействияМассив);
			Соответствие.Вставить(КраткоеНаименование, ПериодыДействияМассив);
			Если УЦ.Государственный Тогда
				ГосударственныеУЦ.Вставить(УЦ.ОГРН, Истина);
				ГосударственныеУЦ.Вставить(Наименование, Истина);
				ГосударственныеУЦ.Вставить(КраткоеНаименование, Истина);
			КонецЕсли;
		КонецЦикла;
		
		ДанныеУЦ.ПериодыДействия.Данные = Соответствие;
		ДанныеУЦ.ГосударственныеУЦ = ГосударственныеУЦ;
		ДанныеУЦ.ПериодыДействия.Версия = Версия;
		ДанныеУЦ.ПериодыДействия.ДатаОбновления = ТекущаяДатаСеанса();
		
	КонецЕсли;
	
	Если ИмяФайлаДругиеНастройки <> Неопределено Тогда
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.ОткрытьФайл(КаталогОбновлений + ИмяФайлаДругиеНастройки);
		ДанныеУЦ.ДругиеНастройки = ПрочитатьJSON(
			ЧтениеJSON, Истина, "ДатаПрекращенияДействияСертификатовВыданныхКоммерческимиУЦ", ФорматДатыJSON.ISO); // Соответствие
		ЧтениеJSON.Закрыть();
		
	КонецЕсли;
	
	УдалитьФайлы(КаталогОбновлений);
	
	Возврат ДанныеУЦ;
	
КонецФункции

&НаСервере
Функция ПрочитатьФайлПериодовДействияУЦ(ИмяФайла)
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.ОткрытьФайл(ИмяФайла);
	СписокУЦ = ПрочитатьJSON(ЧтениеJSON); // Структура
	ЧтениеJSON.Закрыть();
	
	Возврат СписокУЦ;
	
КонецФункции

#КонецОбласти

#Область Получение_данных_из_файла_подписи 

&НаКлиенте
Функция ПолучитьДанныеСертификата(Сертификат)

	СвойстваСубъекта = Новый Структура("ИННЮЛ, ИНН, СНИЛС, ОГРНИП, Организация, Фамилия, ОбщееИмя");
	СвойстваСубъекта.ИННЮЛ = ПолучитьИНН(Ложь, Сертификат.Субъект);
	СвойстваСубъекта.ИНН = ПолучитьИНН(Истина, Сертификат.Субъект);
	
	Если Сертификат.Субъект.Свойство("SNILS") Тогда
		СвойстваСубъекта.СНИЛС = ПодготовитьСтроку(Сертификат.Субъект.SNILS);
	ИначеЕсли Сертификат.Субъект.Свойство("OID1_2_643_100_3") Тогда
		СвойстваСубъекта.СНИЛС = ПодготовитьСтроку(Сертификат.Субъект.OID1_2_643_100_3);
	КонецЕсли;
	
	Если Сертификат.Субъект.Свойство("OGRNIP") Тогда
		СвойстваСубъекта.ОГРНИП = ПодготовитьСтроку(Сертификат.Субъект.OGRNIP);
	ИначеЕсли Сертификат.Субъект.Свойство("OID1_2_643_100_5") Тогда
		СвойстваСубъекта.ОГРНИП = ПодготовитьСтроку(Сертификат.Субъект.OID1_2_643_100_5);
	КонецЕсли;
	
	Если Сертификат.Субъект.Свойство("CN") Тогда
		СвойстваСубъекта.ОбщееИмя = ПодготовитьСтроку(Сертификат.Субъект.CN);
	КонецЕсли;
	
	Если Сертификат.Субъект.Свойство("O") Тогда
		СвойстваСубъекта.Организация = ПодготовитьСтроку(Сертификат.Субъект.O);
	КонецЕсли;
	
	Если Сертификат.Субъект.Свойство("SN") Тогда // Наличие фамилии (обычно для должностного лица).
		
		СвойстваСубъекта.Фамилия = ПодготовитьСтроку(Сертификат.Субъект.SN);
		
	ИначеЕсли ЗначениеЗаполнено(СвойстваСубъекта.ОГРНИП)    // Признак индивидуального предпринимателя.
	      Или Сертификат.Субъект.Свойство("T")                 // Признак должностного лица.
	      Или Сертификат.Субъект.Свойство("OID2_5_4_12")       // Признак должностного лица.
	      Или ЗначениеЗаполнено(СвойстваСубъекта.СНИЛС)     // Признак физического лица.
	      Или ЭтоИННФизЛица(СвойстваСубъекта.ИНН) И НЕ ЗначениеЗаполнено(СвойстваСубъекта.ИННЮЛ) Тогда // Признак физического лица.
		
		Если СвойстваСубъекта.ОбщееИмя <> СвойстваСубъекта.Организация
		   И Не (Сертификат.Субъект.Свойство("T")           И СвойстваСубъекта.ОбщееИмя = ПодготовитьСтроку(Сертификат.Субъект.T))
		   И Не (Сертификат.Субъект.Свойство("OID2_5_4_12") И СвойстваСубъекта.ОбщееИмя = ПодготовитьСтроку(Сертификат.Субъект.OID2_5_4_12)) Тогда
			
			// Извлечение ФИО из поля CN.
			Массив = СтрРазделить(СвойстваСубъекта.ОбщееИмя, " ", Ложь);
			
			Если Массив.Количество() < 4 Тогда
				Если Массив.Количество() > 0 Тогда
					СвойстваСубъекта.Фамилия = СокрЛП(Массив[0]);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
			
	КонецЕсли;
		
	Если Сертификат.Субъект.Свойство("O") Тогда
		СвойстваСубъекта.Организация = ПодготовитьСтроку(Сертификат.Субъект.O);
	КонецЕсли;
	
	СвойстваИздателя = Новый Структура("ИНН, ОГРН, ОбщееИмя");
	СвойстваИздателя.ИНН = ПолучитьИНН(Ложь, Сертификат.Издатель);
	
	Если Сертификат.Издатель.Свойство("OGRN")Тогда
		СвойстваИздателя.ОГРН = ПодготовитьСтроку(Сертификат.Издатель.OGRN);
	ИначеЕсли Сертификат.Издатель.Свойство("OID1_2_643_100_1") Тогда
		СвойстваИздателя.ОГРН = ПодготовитьСтроку(Сертификат.Издатель.OID1_2_643_100_1);
	КонецЕсли; 
	
	Если Сертификат.Издатель.Свойство("CN") Тогда
		СвойстваИздателя.ОбщееИмя = ПодготовитьСтроку(Сертификат.Издатель.CN);
	КонецЕсли;
	
	ДанныеСертификата = Новый Структура;
	ДанныеСертификата.Вставить("СвойстваСубъекта", СвойстваСубъекта);
	ДанныеСертификата.Вставить("СвойстваИздателя", СвойстваИздателя);
	ДанныеСертификата.Вставить("ДатаНачала", Сертификат.ДатаНачала);
	ДанныеСертификата.Вставить("ДействителенДо", Сертификат.ДатаОкончания);
	
	Возврат ДанныеСертификата;
	
КонецФункции 

&НаКлиенте
Функция ПолучитьИНН(ИННФЛ, Свойства)

	Если ИННФЛ Тогда
	
		Если Свойства.Свойство("INN") Тогда
			ИНН = Свойства.INN;
		ИначеЕсли Свойства.Свойство("OID1_2_643_3_131_1_1") Тогда
			ИНН = ПодготовитьСтроку(Свойства.OID1_2_643_3_131_1_1);
		КонецЕсли;
		
	Иначе
		
		Если Свойства.Свойство("INNLE") Тогда
			ИНН = Свойства.INNLE;
		ИначеЕсли Свойства.Свойство("OID1_2_643_100_4")
				И СтрДлина(Свойства.OID1_2_643_100_4) = 10 Тогда
			ИНН = ПодготовитьСтроку(Свойства.OID1_2_643_100_4);
		ИначеЕсли Свойства.Свойство("_1_2_643_100_4") Тогда
			ИНН = ПодготовитьСтроку(Свойства._1_2_643_100_4);
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат ИНН;

КонецФункции

&НаКлиенте
Функция ЭтоИННФизЛица(ИНН)
	
	Если СтрДлина(ИНН) <> 12 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для НомерСимвола = 1 По 12 Цикл
		Если СтрНайти("0123456789", Сред(ИНН,НомерСимвола,1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрНачинаетсяС(ИНН, "00") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ПолучитьДанныеПодписи(Подпись)

	СвойстваПодписиИзДвоичныхДанных = РаботаСКриптографиейКлиент.СвойстваПодписиИзДвоичныхДанных(Подпись);
	СвойстваПодписи = Новый Структура("ДатаПодписиИзМетки, НеподтвержденнаяДатаПодписи");
	СвойстваПодписи.ДатаПодписиИзМетки = СвойстваПодписиИзДвоичныхДанных.ДатаШтампаВремени;
	СвойстваПодписи.НеподтвержденнаяДатаПодписи = СвойстваПодписиИзДвоичныхДанных.ДатаПодписания;
	
	Возврат СвойстваПодписи;

КонецФункции

&НаКлиенте
Функция ПодготовитьСтроку(СтрокаИзСертификата)
	
	Возврат СокрЛП(РаботаСоСтрокамиКлиентСервер.ЗаменитьНедопустимыеСимволыXML(СтрокаИзСертификата));
	
КонецФункции
	
