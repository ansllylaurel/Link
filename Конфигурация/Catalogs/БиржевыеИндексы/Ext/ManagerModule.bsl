	ЗаполнитьЗначенияСвойств(ТаблицаИндексов.Добавить(), Новый Структура("Срок, Код",	 0.5, "Индекс_UST_Yield_6M"));
	ЗаполнитьЗначенияСвойств(ТаблицаИндексов.Добавить(), Новый Структура("Срок, Код",	   1, "Индекс_UST_Yield_1Y"));
	ЗаполнитьЗначенияСвойств(ТаблицаИндексов.Добавить(), Новый Структура("Срок, Код",	   2, "Индекс_UST_Yield_2Y"));
	ЗаполнитьЗначенияСвойств(ТаблицаИндексов.Добавить(), Новый Структура("Срок, Код",	   3, "Индекс_UST_Yield_3Y"));
	ЗаполнитьЗначенияСвойств(ТаблицаИндексов.Добавить(), Новый Структура("Срок, Код",	   5, "Индекс_UST_Yield_5Y"));
	ЗаполнитьЗначенияСвойств(ТаблицаИндексов.Добавить(), Новый Структура("Срок, Код",	   7, "Индекс_UST_Yield_7Y"));
	ЗаполнитьЗначенияСвойств(ТаблицаИндексов.Добавить(), Новый Структура("Срок, Код",	  10, "Индекс_UST_Yield_10Y"));
	ЗаполнитьЗначенияСвойств(ТаблицаИндексов.Добавить(), Новый Структура("Срок, Код",	  20, "Индекс_UST_Yield_20Y"));
