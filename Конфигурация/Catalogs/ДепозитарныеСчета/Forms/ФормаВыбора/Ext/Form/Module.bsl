
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Список.Параметры.УстановитьЗначениеПараметра("ТекущаяДата",        КонецДня(ТекущаяДата()));
	Список.Параметры.УстановитьЗначениеПараметра("ОтображатьЗакрытые", Ложь);
	
	Если ЭтаФорма.Параметры.Отбор.Свойство("Родитель") Тогда
		Элементы.Список.Отображение = ОтображениеТаблицы.Список;
	Иначе
		Элементы.Список.Отображение = ОтображениеТаблицы.Дерево;
	КонецЕсли;
	
	Если ЭтаФорма.Параметры.Отбор.Свойство("ИсточникВызова") Тогда
		ЭтаФорма.Параметры.ИсточникВызова = ЭтаФорма.Параметры.Отбор.ИсточникВызова; 	
	КонецЕсли;
	
КонецПроцедуры // ПриСозданииНаСервере

&НаКлиенте
Процедура КомандаПоказатьСкрытьЗакрытые(Команда)
	
	Элементы.ФормаКомандаПоказатьСкрытьЗакрытые.Пометка = Не Элементы.ФормаКомандаПоказатьСкрытьЗакрытые.Пометка;
	
	Список.Параметры.УстановитьЗначениеПараметра("ОтображатьЗакрытые",
		Элементы.ФормаКомандаПоказатьСкрытьЗакрытые.Пометка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "СозданНовыйДепозитарныйСчет" Тогда
		Элементы.Список.Обновить();
		Элементы.Список.ТекущаяСтрока = Параметр;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если ЭтаФорма.Параметры.ИсточникВызова <> Неопределено Тогда 
		Отказ = Истина;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ПараметрыВыбора", Новый Структура("ИсточникВызова", ЭтаФорма.Параметры.ИсточникВызова));	
		
		НовыйЭлемент = ОткрытьФормуМодально("Справочник.ДепозитарныеСчета.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
		Если НовыйЭлемент <> Неопределено Тогда
			ОповеститьОВыборе(НовыйЭлемент);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры