
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЭлементОтбораСписка(Форма, ИмяСписка, ИмяПоля)

	КлючЭлементаОтбора = Новый Структура("ИмяПоля, Представление", ИмяПоля, "БыстрыйОтбор" + ИмяПоля);
	
	ПолеНеРедактируется = Форма.Элементы["БыстрыйОтбор" + ИмяСписка + ИмяПоля].ТолькоПросмотр;
	ЗначениеПоля        = Форма[ИмяПоля];
	
	ВидСравненияПоля = ?(ТипЗнч(ЗначениеПоля) = Тип("СписокЗначений"), ВидСравненияКомпоновкиДанных.ВСписке, ВидСравненияКомпоновкиДанных.Равно);
	
	Если ПолеНеРедактируется Тогда
		// отбираем даже по пустому значению
		РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма[ИмяСписка].Отбор, КлючЭлементаОтбора, "БыстрыйОтбор" + ИмяПоля,
			ВидСравненияПоля, ЗначениеПоля, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто);
	Иначе
		Если ЗначениеЗаполнено(ЗначениеПоля) Тогда
			// установим отбор
			РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма[ИмяСписка].Отбор, КлючЭлементаОтбора, "БыстрыйОтбор" + ИмяПоля,
				ВидСравненияПоля, ЗначениеПоля, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто);
		Иначе
			// отключим отбор
			РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма[ИмяСписка].Отбор, КлючЭлементаОтбора, "БыстрыйОтбор" + ИмяПоля,
				ВидСравненияПоля, ЗначениеПоля, Ложь, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // УстановитьЭлементОтбораСписка

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПараметрыФормы = ЭтаФорма.Параметры;
	
	// закладка "Полный список" доступна только с ролью ПолныеПрава и только если требуется получить ссылку на р/счет
	ДоступнаРольПолныеПрава = РольДоступна("ПолныеПрава");
	
	Если ПараметрыФормы.ВозвращатьВсеСведенияОбИсполнителе Или Не ДоступнаРольПолныеПрава Тогда
		Элементы.СтраницаПолныйСписок.Видимость    = Ложь;
		Элементы.ГруппаСтраницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	КонецЕсли;
	
	// также только под ролью "Отладка" доступно отображение закрытых исполнителей
	Если Не ДоступнаРольПолныеПрава Тогда
		Элементы.ИсполнителиКомандаИсполнителиПоказатьСкрытьЗакрытых.Видимость = Ложь;
		Элементы.ИсполнителиДатаЗакрытия.Видимость                             = Ложь;
	КонецЕсли;
	
	// перенесем настройки из параметров в реквизиты формы
	ПоляБыстрогоОтбора = "Организация, Период, Депозитарий, СчетДоверительногоУправления";
	ПоляБыстрогоОтбора = СтрЗаменить(ПоляБыстрогоОтбора, ", ", Символы.ПС);
	
	Для НомСтр = 1 По СтрЧислоСтрок(ПоляБыстрогоОтбора) Цикл
		ПолеБыстрогоОтбора = СтрПолучитьСтроку(ПоляБыстрогоОтбора, НомСтр);
		
		Если ПараметрыФормы.Свойство(ПолеБыстрогоОтбора) Тогда
			ЭтаФорма[ПолеБыстрогоОтбора] = ПараметрыФормы[ПолеБыстрогоОтбора];
			
			Элементы["БыстрыйОтборИсполнители" + ПолеБыстрогоОтбора].ТолькоПросмотр = Истина;
			
			Если ПолеБыстрогоОтбора <> "Период" Тогда
				// если не пользоваться отборами, то при создании записи регистра поля будут не заполнены
				УстановитьЭлементОтбораСписка(ЭтаФорма, "Исполнители", ПолеБыстрогоОтбора);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// установим параметры дин. списков по исполнителям
	ЭтаФорма.Исполнители.Параметры.УстановитьЗначениеПараметра("ДатаЗакрытия", ?(ЗначениеЗаполнено(ЭтаФорма.Период), ЭтаФорма.Период, ТекущаяДата()));
	
	// по умолчанию закрытые счет д/у не отображаются
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(ЭтаФорма.Исполнители.Отбор, Новый Структура("ИмяПоля, Представление", "Закрыт", "ПредопределенныйОтборЗакрыт"),
		"ПредопределенныйОтборЗакрыт", ВидСравненияКомпоновкиДанных.Равно, Ложь, Не Элементы.ИсполнителиКомандаИсполнителиПоказатьСкрытьЗакрытых.Пометка, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто);
	
	// счета с установленным признаком "ПодчиненныеРазделы" выбирать нельзя
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(ЭтаФорма.Список.Отбор, Новый Структура("ИмяПоля, Представление", "ПодчиненныеРазделы", "ПредопределенныйОтборПодчиненныеРазделы"),
		"ПредопределенныйОтборПодчиненныеРазделы", ВидСравненияКомпоновкиДанных.Равно, Ложь, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто);
	
КонецПроцедуры

#Область БЫСТРЫЙ_ОТБОР_ИСПОЛНИТЕЛИ

&НаКлиенте
Процедура БыстрыйОтборИсполнителиПериодПриИзменении(Элемент)
	
	ЭтаФорма.Исполнители.Параметры.УстановитьЗначениеПараметра("ДатаЗакрытия", ?(ЗначениеЗаполнено(ЭтаФорма.Период), ЭтаФорма.Период, ТекущаяДата()));
	
КонецПроцедуры

&НаКлиенте
Процедура БыстрыйОтборИсполнителиДепозитарийПриИзменении(Элемент)
	
	УстановитьЭлементОтбораСписка(ЭтаФорма, "Исполнители", "Депозитарий");
	
КонецПроцедуры

&НаКлиенте
Процедура БыстрыйОтборИсполнителиСчетДоверительногоУправленияПриИзменении(Элемент)
	
	УстановитьЭлементОтбораСписка(ЭтаФорма, "Исполнители", "СчетДоверительногоУправления");

КонецПроцедуры

#КонецОбласти

#Область КОМАНДЫ_ВЫБОРА

&НаКлиенте
Процедура КомандаВыбрать(Команда)
	
	ТекущаяСтраница = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	
	Если      ТекущаяСтраница = Элементы.СтраницаИсполнители Тогда
		ИсполнителиВыбор(Неопределено, Неопределено, Неопределено, Неопределено);
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаПолныйСписок Тогда
		СписокВыбор(Неопределено, Неопределено, Неопределено, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсполнителиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.Исполнители.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		Если Не ЭтаФорма.Параметры.ВозвращатьВсеСведенияОбИсполнителе Тогда
			ОповеститьОВыборе(ТекущиеДанные.ДепозитарныйСчет);
		Иначе
			ВыбранныеДанные = Новый Структура("СчетДоверительногоУправления, ДепозитарныйСчет, Депозитарий");
			ЗаполнитьЗначенияСвойств(ВыбранныеДанные, ТекущиеДанные);
			ЭтаФорма.Закрыть(ВыбранныеДанные);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элементы.Список.ТекущиеДанные <> Неопределено Тогда
		ОповеститьОВыборе(Элементы.Список.ТекущиеДанные.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура КомандаИсполнителиПоказатьСкрытьЗакрытых(Команда)
	
	Элементы.ИсполнителиКомандаИсполнителиПоказатьСкрытьЗакрытых.Пометка = Не Элементы.ИсполнителиКомандаИсполнителиПоказатьСкрытьЗакрытых.Пометка;
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(ЭтаФорма.Исполнители.Отбор, Новый Структура("ИмяПоля, Представление", "Закрыт", "ПредопределенныйОтборЗакрыт"),
		"ПредопределенныйОтборЗакрыт", ВидСравненияКомпоновкиДанных.Равно, Ложь, Не Элементы.ИсполнителиКомандаИсполнителиПоказатьСкрытьЗакрытых.Пометка, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто);
	
КонецПроцедуры

