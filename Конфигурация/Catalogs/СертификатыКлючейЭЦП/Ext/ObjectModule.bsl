
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыСправочника(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыСправочника(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	// блокирующие проверки
	Если Не ЭтотОбъект.ПометкаУдаления Тогда
		
		УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
		
		// период должен быть корректен
		Если ЭтотОбъект.НачалоДействия > ЭтотОбъект.ОкончаниеДействия Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата начала действия сертификата больше даты окончания", ЭтотОбъект, "ОкончаниеДействия",, Отказ);
		КонецЕсли;
		
		// субъектом м.б. только физик, а УЦ - юрик
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Субъект, "ВидЮрФизЛица") <> Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Субъект может быть только физическое лицо", ЭтотОбъект, "ОкончаниеДействия",, Отказ);
		КонецЕсли;
		
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.УдостоверяющийЦентр, "ВидЮрФизЛица") <> Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Удостоверяющим центром может быть только юридическое лицо", ЭтотОбъект, "УдостоверяющийЦентр",, Отказ);
		КонецЕсли;
		
		// проверим уникальность серийного номера
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СертификатыКлючейЭЦП.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.СертификатыКлючейЭЦП КАК СертификатыКлючейЭЦП
			|ГДЕ
			|	СертификатыКлючейЭЦП.Организация = &Организация
			|	И СертификатыКлючейЭЦП.СерийныйНомер = &СерийныйНомер
			|	И СертификатыКлючейЭЦП.Ссылка <> &Ссылка";
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СерийныйНомер", ЭтотОбъект.СерийныйНомер);
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Серийный номер сертификата не уникален", ЭтотОбъект, "СерийныйНомер",, Отказ);
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры // ПередЗаписью
