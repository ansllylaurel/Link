
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыСправочника(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "Наименование, КадастровыйНомер");

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыСправочника(ЭтотОбъект, ДанныеЗаполнения);

КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	// блокирующие проверки
	Если Не ЭтотОбъект.ПометкаУдаления Тогда
		
		УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
		
		Если ЗначениеЗаполнено(ЭтотОбъект.Здание) Тогда 
			Если ЭтотОбъект.ВидОбъектаНедвижимости <> Перечисления.ВидыОбъектовНедвижимости.Помещение Тогда
			
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Здание может быть заполнено только у квартир и помещений", ЭтотОбъект, "Здание",, Отказ);
			КонецЕсли;
			
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Здание, "ВидОбъектаНедвижимости") <> Перечисления.ВидыОбъектовНедвижимости.Здание Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В качестве здания выбран объект, не являющийся зданием!", ЭтотОбъект, "Здание",, Отказ);
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЕсли;

КонецПроцедуры
