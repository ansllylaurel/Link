
#Если Сервер Тогда

// Выполняет расчет доходности
//
// Параметры:
//  Облигация  		- СправочникСсылка.Облигации - ссылка на облигацию
//  ДоДатыПогашения - Булево - Если Истина - поток до даты погашения, 
//					если Ложь - поток до даты выкупа
//
// Возвращаемое значение:
//   Число			- значение доходности
Функция ПолучитьДоходностьИДюрацию(Облигация, ДоДатыПогашения, Дата, Цена, СчетДоверительногоУправления, Биржа, ДатаПереоценки = Неопределено, УчитыватьКупонКОферте = Истина, Купон = Неопределено, Точность = Неопределено, ПараметрыОценки = Неопределено, ДенежныйПоток = Неопределено) Экспорт

	Отказ = Ложь;
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнена дата'");
	КонецЕсли; 
	
	Если Цена = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнена цена'");
	КонецЕсли; 
	
	Если ДенежныйПоток = Неопределено Тогда
	
		// Получаем денежный поток
		ПараметрыДенежногоПотока = Новый Структура;
		
		ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",		ДоДатыПогашения);
		ПараметрыДенежногоПотока.Вставить("Дата",					Дата);
		ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",			ДатаПереоценки);
		ПараметрыДенежногоПотока.Вставить("УчитыватьКупонКОферте",	УчитыватьКупонКОферте);
		
		Если ПараметрыОценки = Неопределено Тогда
			ПараметрыОценки = Новый Структура;
		ИначеЕсли ПараметрыОценки.Свойство("ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона") Тогда
			ПараметрыДенежногоПотока.Вставить("ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона",	ПараметрыОценки.ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона);
		КонецЕсли;
		ПараметрыОценки.Вставить("СчетДоверительногоУправления",	СчетДоверительногоУправления);
		
		ДенежныйПотокДляРасчетов = ПолучитьДенежныйПоток(Облигация, ПараметрыДенежногоПотока, ПараметрыОценки);
		
		Если ДенежныйПотокДляРасчетов.Количество() = 0 Тогда
			Возврат Новый Структура("Доходность, Дюрация", 0, 0);
		КонецЕсли; 	
		
	Иначе
		ДенежныйПотокДляРасчетов = ДенежныйПоток;
	КонецЕсли;
	
	Если НЕ Отказ Тогда
	
		// Рассчитываем доходность
		Если Купон = Неопределено Тогда
			Купон = ПолучитьКупон(Облигация, Дата, СчетДоверительногоУправления, Биржа);
		КонецЕсли; 
		
		Результат = БухгалтерскийУчет.РассчитатьДоходностьИДюрациюПоПотоку(ДенежныйПотокДляРасчетов, Дата, -(Цена + Купон), Точность);
		Результат.Вставить("ДенежныйПоток", ДенежныйПотокДляРасчетов);
		
		Возврат Результат;
		
	КонецЕсли;
	
	Возврат Новый Структура("Доходность, Дюрация", 0, 0);
	
КонецФункции

Функция ПолучитьПогашенияКупонов(Облигация, ДоДатыПогашения, Дата, ДатаПереоценки = Неопределено, СчетДоверительногоУправления = Неопределено) Экспорт
	
	ПараметрыДенежногоПотока = Новый Структура;
	ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",			ДоДатыПогашения);
	ПараметрыДенежногоПотока.Вставить("Дата",						Дата);
	ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",				ДатаПереоценки);
	ПараметрыДенежногоПотока.Вставить("ОбъединятьПотокиПоПериоду",	Ложь);	
	
	ДенежныйПоток = ПолучитьДенежныйПоток(Облигация, ПараметрыДенежногоПотока, СчетДоверительногоУправления);
	
	ПогашенияКупонов = ДенежныйПоток.Скопировать(Новый Структура("Купон", Истина), "Дата, Поток, Ставка");
	ПогашенияКупонов.Свернуть("Дата, Ставка", "Поток");
	ПогашенияКупонов.Сортировать("Дата");	
	
	Возврат ПогашенияКупонов;

КонецФункции

// Получает будущие денежные потоки (выплаты или поступления) по облигации
//
// Параметры:
//  Облигация													- СправочникСсылка.Облигации - 
//	ПараметрыДенежногоПотока									- Структура - с ключами:
//  	ДоДатыПогашения												- Булево - Если Истина - поток до даты погашения, если Ложь - поток до даты выкупа (ближайшей оферты)
//  	Дата														- Дата	 - Начиная с какой даты берем поток
//  	ДатаПереоценки												- Дата	 - Дата, на которую проверяются даты публикации информации о потоках. Необязательный.
//  	УчитыватьКупонКОферте										- Булево, Строка - Если до оферты и оферта не в дату окончания купона, то считать ли купон на нее. Либо строка "УчитыватьКупонТолькоПриОбъявленнойСтавке" - будем считать купон на дату оферты, если ставка перед офертой объявлена. Необязательный (по умолчанию Истина).
//  	ТочностьОкругления											- Число  - С какой точностью учитывать купон к оферте. Необязательный (по умолчанию 2 знака после запятой).
//  	УчитыватьИзмененениеКупонаСНаступленияПериода				- Булево - Для некоторых клиентов несмотря на то, что информация о новой ставке купона уже есть, продожаем считать по-старому, пока этот период не начнется. Необязательный (по умолчанию Ложь).
//  	ОграничиватьСрокОбращенияДатойОкончанияПоследнегоКупона		- Булево - Некоторые клиенты считают не до даты погашения, а до даты последнего купона. Необязательный (по умолчанию Ложь).
//  	ОбъединятьПотокиПоПериоду									- Булево - Потоки тела и купона буду свернуты по дате. Необязательный (по умолчанию Ложь).
//	ПараметрыОценки												- Структура, СправочникСсылка.СчетаДоверительногоУправления - для тех клиентов и бумаг, по которым свой денежный поток. Состав структуры см. в РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС. Необязательный. 
//  Отказ														- Булево - выходной параметр, при ошибке устанавливается в Истина. Необязательный.
//  РасшифровкаРасчета											- Структура - структура расшифровки расчета. Необязательный.
//
// Возвращаемое значение:
//   ТаблицаЗначений - будущие денежные потоки
//
Функция ПолучитьДенежныйПоток(Облигация, ПараметрыДенежногоПотока, ПараметрыОценки = Неопределено, Отказ = Неопределено, РасшифровкаРасчета = Неопределено) Экспорт
	
	#Область Проверка_параметров_функции_и_заполнение_параметров_по_умолчанию
	
	Если ТипЗнч(ПараметрыДенежногоПотока) <> Тип("Структура") Тогда
		ВызватьИсключение "Некорретное значение параметра 'ПараметрыДенежногоПотока': " + Строка(ПараметрыДенежногоПотока);
	КонецЕсли;
	
	Если Не ПараметрыДенежногоПотока.Свойство("ДоДатыПогашения") Тогда
		ВызватьИсключение "Отсутствует обязательный параметр денежного потока 'ДоДатыПогашения'";
	КонецЕсли;
	
	Если Не ПараметрыДенежногоПотока.Свойство("Дата") Тогда
		ВызватьИсключение "Отсутствует обязательный параметр денежного потока 'Дата'";
	КонецЕсли;
	
	Если Не ПараметрыДенежногоПотока.Свойство("ДатаПереоценки") Тогда
		ПараметрыДенежногоПотока.Вставить("ДатаПереоценки", Неопределено);
	КонецЕсли;
	
	Если Не ПараметрыДенежногоПотока.Свойство("УчитыватьКупонКОферте") Тогда
		ПараметрыДенежногоПотока.Вставить("УчитыватьКупонКОферте", Истина);
	ИначеЕсли ПараметрыДенежногоПотока.УчитыватьКупонКОферте = "УчитыватьКупонТолькоПриОбъявленнойСтавке" И ПараметрыДенежногоПотока.ДатаПереоценки = Неопределено Тогда
		ВызватьИсключение "Для учета купона к оферте при объявленной ставке параметр 'ДатаПереоценки' должен быть заполнен";
	ИначеЕсли ТипЗнч(ПараметрыДенежногоПотока.УчитыватьКупонКОферте) <> Тип("Булево") И ПараметрыДенежногоПотока.УчитыватьКупонКОферте <> "УчитыватьКупонТолькоПриОбъявленнойСтавке" Тогда
		ВызватьИсключение "Некорректное значение параметра 'УчитыватьКупонКОферте': " + Строка(ПараметрыДенежногоПотока.УчитыватьКупонКОферте);
	КонецЕсли;
	
	Если Не ПараметрыДенежногоПотока.Свойство("ВариантРасчетаКупонаКОферте") Тогда
		ПараметрыДенежногоПотока.Вставить("ВариантРасчетаКупонаКОферте", "ОтПоследнейИзвестнойСтавки");
	ИначеЕсли ПараметрыДенежногоПотока.ВариантРасчетаКупонаКОферте <> "ОтПоследнейИзвестнойСтавки"
		И ПараметрыДенежногоПотока.ВариантРасчетаКупонаКОферте <> "ОтПрогнозногоЗначенияСтавки"
	Тогда
		ВызватьИсключение "Некорректное значение параметра 'ВариантРасчетаКупонаКОферте': " + Строка(ПараметрыДенежногоПотока.ВариантРасчетаКупонаКОферте);
	КонецЕсли;
	
	Если Не ПараметрыДенежногоПотока.Свойство("УчитыватьИзмененениеКупонаСНаступленияПериода") Тогда
		ПараметрыДенежногоПотока.Вставить("УчитыватьИзмененениеКупонаСНаступленияПериода", Ложь);
	ИначеЕсли ПараметрыДенежногоПотока.УчитыватьИзмененениеКупонаСНаступленияПериода И ПараметрыДенежногоПотока.ДатаПереоценки = Неопределено Тогда
		ВызватьИсключение "Для учета изменения купона с наступлением периода параметр 'ДатаПереоценки' должен быть заполнен";
	КонецЕсли;
	
	Если Не ПараметрыДенежногоПотока.Свойство("ОграничиватьСрокОбращенияДатойОкончанияПоследнегоКупона") Тогда
		ПараметрыДенежногоПотока.Вставить("ОграничиватьСрокОбращенияДатойОкончанияПоследнегоКупона", Ложь);
	ИначеЕсли ПараметрыДенежногоПотока.ОграничиватьСрокОбращенияДатойОкончанияПоследнегоКупона И ПараметрыДенежногоПотока.УчитыватьКупонКОферте <> Ложь Тогда
		ВызватьИсключение "Ограничить срок обращения датой окончания последнего купона и при этом учесть купон к оферте невозможно";
	КонецЕсли;
	
	Если Не ПараметрыДенежногоПотока.Свойство("ОбъединятьПотокиПоПериоду") Тогда
		ПараметрыДенежногоПотока.Вставить("ОбъединятьПотокиПоПериоду", Ложь);
	КонецЕсли;
	
	Если Не ПараметрыДенежногоПотока.Свойство("РассчитыватьПрогнозныеЗначения") Тогда
		ПараметрыДенежногоПотока.Вставить("РассчитыватьПрогнозныеЗначения", Истина);
	КонецЕсли;
	
	Если Не ПараметрыДенежногоПотока.Свойство("НеУчитыватьРешенияКлиентовПоПотокам") Тогда
		ПараметрыДенежногоПотока.Вставить("НеУчитыватьРешенияКлиентовПоПотокам", Ложь);
	КонецЕсли;
	
	#КонецОбласти
	
	// Подготовка параметров	
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РасшифровкаОперации		= РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Получение денежного потока", , , Истина);
		РасшифровкаПараметров	= РаботаСКоллекциями.СкопироватьСтруктуру(ПараметрыДенежногоПотока);
	КонецЕсли;
	
	#Область Заполнение_параметров_оценки
	
	// #Техдолг можно убрать, когда в ПараметрыОценки всегда будет передаваться правильная структура   
	
	Клиент						 		= Неопределено;
	Организация					 		= Неопределено;
	СчетДоверительногоУправления		= Неопределено;
	ВариантРасчетаОценочнойСтоимости	= Неопределено;
	ПараметрыПрогноза					= Неопределено;
	
	Если ТипЗнч(ПараметрыОценки) = Тип("Структура") Тогда
		ПараметрыОценки.Свойство("Клиент",							 Клиент);
		ПараметрыОценки.Свойство("Организация",						 Организация);
		ПараметрыОценки.Свойство("СчетДоверительногоУправления",	 СчетДоверительногоУправления);
		ПараметрыОценки.Свойство("ВариантРасчетаОценочнойСтоимости", ВариантРасчетаОценочнойСтоимости);
	ИначеЕсли ТипЗнч(ПараметрыОценки) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		СчетДоверительногоУправления = ПараметрыОценки;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СчетДоверительногоУправления) Тогда
		Если Организация = Неопределено Тогда
			Организация = СчетДоверительногоУправления.Организация;
		КонецЕсли;
		Если Клиент = Неопределено И ЗначениеЗаполнено(ПараметрыДенежногоПотока.ДатаПереоценки) Тогда
			Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, ПараметрыДенежногоПотока.ДатаПереоценки);
		КонецЕсли;
	КонецЕсли;	
	
	#КонецОбласти	
	
	ДенежныйПоток = Новый ТаблицаЗначений;
	ДенежныйПоток.Колонки.Добавить("Дата",				Новый ОписаниеТипов("Дата"));
	ДенежныйПоток.Колонки.Добавить("Поток",				Новый ОписаниеТипов("Число"));
	ДенежныйПоток.Колонки.Добавить("Купон",				Новый ОписаниеТипов("Булево"));
	ДенежныйПоток.Колонки.Добавить("Ставка",			Новый ОписаниеТипов("Число, NULL"));
	ДенежныйПоток.Колонки.Добавить("ДатаНачалаКупона",	Новый ОписаниеТипов("Дата, NULL"));
	ДенежныйПоток.Колонки.Добавить("ИзвестныйПоток",	Новый ОписаниеТипов("Булево"));	
		
	// Сначала проверим потоки по мнению клиента
	
	Если ЗначениеЗаполнено(Клиент) И НЕ ПараметрыДенежногоПотока.НеУчитыватьРешенияКлиентовПоПотокам Тогда
		
		#Область Решения_клиентов_по_прогнозируемым_денежным_потокам
		
		Если ЗначениеЗаполнено(ПараметрыДенежногоПотока.ДатаПереоценки) Тогда
			ДатаОпределенияПотока = НачалоДня(ПараметрыДенежногоПотока.ДатаПереоценки);
		Иначе
			ДатаОпределенияПотока = НачалоДня(ПараметрыДенежногоПотока.Дата);
		КонецЕсли;
		
		НастройкиУчета = Неопределено;
		Если НЕ ПараметрыДенежногоПотока.Свойство("НастройкиУчета", НастройкиУчета) Тогда
			НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ДатаОпределенияПотока, Организация, СчетДоверительногоУправления);
		КонецЕсли;

		УчетныйАктивЕПС	= Неопределено;
		Партия			= Неопределено;
		СтрокаПартии	= Неопределено;
		
		ПараметрыОценки.Свойство("УчетныйАктивЕПС", УчетныйАктивЕПС);
		ПараметрыОценки.Свойство("Партия", Партия);
		ПараметрыОценки.Свойство("СтрокаПартии", СтрокаПартии);
		
		// при вызове функции не указали учетный актив, подразумевая, что речь идет об АСном активе
		// поскольку настройка потоков указывается именно для таких, мы можем взять любой (первый), где заполнена настройка поток
		Если УчетныйАктивЕПС = Неопределено Тогда
			СтрокиНастроекПоПартиям = НастройкиУчета.НастройкиУчетаЦенныхБумаг.НайтиСтроки(
				Новый Структура("ЦеннаяБумага, Настройка",
					Облигация, 
					ПланыВидовХарактеристик.НастройкиУчетаЦенныхБумаг.ДенежныйПотокПоОблигации));
			Если СтрокиНастроекПоПартиям.Количество() > 0 Тогда
				УчетныйАктивЕПС = СтрокиНастроекПоПартиям[0].УчетныйАктивЕПС;
			КонецЕсли;					
		КонецЕсли;
		
		НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
			НастройкиУчета,
			Облигация,
			УчетныйАктивЕПС,
			Партия,
			СтрокаПартии);
		
		Если НастройкиУчетаЦеннойБумаги.ДенежныйПотокПоОблигации <> Справочники.ДенежныеПотокиПоОблигациям.ПустаяСсылка() Тогда
		
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ДенежныеПотокиПоОблигациямПоток.Дата КАК Дата,
				|	ДенежныеПотокиПоОблигациямПоток.Сумма КАК Поток,
				|	ДенежныеПотокиПоОблигациямПоток.Купон КАК Купон,
				|	НЕОПРЕДЕЛЕНО КАК Ставка
				|ИЗ
				|	Справочник.ДенежныеПотокиПоОблигациям.Поток КАК ДенежныеПотокиПоОблигациямПоток
				|ГДЕ
				|	ДенежныеПотокиПоОблигациямПоток.Ссылка = &Ссылка
				|	И ДенежныеПотокиПоОблигациямПоток.Дата >= &Дата";
			
			Запрос.УстановитьПараметр("Ссылка", НастройкиУчетаЦеннойБумаги.ДенежныйПотокПоОблигации);
			Запрос.УстановитьПараметр("Дата", ДатаОпределенияПотока);
			
			ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				ЗаполнитьЗначенияСвойств(ДенежныйПоток.Добавить(), ВыборкаДетальныеЗаписи);
			КонецЦикла;
		
		КонецЕсли; 
			
		// Если потоки зарегистрирован не до даты погашения, а до даты оферты,
		// то определить, где поток по номиналу, нельзя #Техдолг #389069 #361674
		
		Если Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ХКМетИнв_004") Тогда // ХК МЕТАЛЛОИНВЕСТ, 4B02-04-25642-H, 1000.00 RUB
			СтрокаПотока = ДенежныйПоток.Найти('20260209', "Дата");
			Если СтрокаПотока <> Неопределено Тогда
				СтрокаПотока.Поток = СтрокаПотока.Поток - 1000;
				
				СтрокаПотокаНоминала = ДенежныйПоток.Добавить();
				СтрокаПотокаНоминала.Дата	= СтрокаПотока.Дата;
				СтрокаПотокаНоминала.Поток	= 1000;
				СтрокаПотокаНоминала.Купон	= Ложь;
			КонецЕсли;
		КонецЕсли;

		#КонецОбласти
		
	КонецЕсли;
	
	// Если данных от клиента нет, то собираем их сами	
	
	Если ДенежныйПоток.Количество() = 0 Тогда
		
		#Область Расчет_будущих_денежных_потоков
		
		РеквизитыОблигации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Облигация,
			Новый Структура("Облигация, Тип, БазоваяСтавка, ДатаПогашения, БазаРасчета, Амортизационная, ВалютаНоминала",
				"Ссылка", "Тип", "БазоваяСтавка", "ДатаПогашения", "БазаРасчета", "Амортизационная", "ВалютаНоминала"));
		
		ЭтоОблигацияСПлавающимКупоном =
			(РеквизитыОблигации.Тип = Перечисления.ТипыОблигаций.КупоннаяПК)
				И ЗначениеЗаполнено(РеквизитыОблигации.БазоваяСтавка);
		
		#Область Получение_даты_выкупа
		
		Если ПараметрыДенежногоПотока.ДоДатыПогашения Тогда
			
			ПараметрыОферты = ОбъявленаОбязательнаяДосрочнаяОферта(Облигация, ПараметрыДенежногоПотока.ДатаПереоценки);
			
			ДатаВыкупа = ?(ПараметрыОферты.Объявлена, ПараметрыОферты.ДатаВыкупа, РеквизитыОблигации.ДатаПогашения);
			
		Иначе
		
			ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона = Неопределено;
			ПараметрыДенежногоПотока.Свойство("ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона", ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона);

			ОтборПоТипамОфертПоОблигациям = Неопределено;
			ПараметрыДенежногоПотока.Свойство("ОтборПоТипамОфертПоОблигациям", ОтборПоТипамОфертПоОблигациям);
			
			ДатаАктуальности = ?(ПараметрыДенежногоПотока.ДатаПереоценки = Неопределено, ПараметрыДенежногоПотока.Дата, ПараметрыДенежногоПотока.ДатаПереоценки);
			
			ДатаВыкупа = ПолучитьДатуИЦенуВыкупа(Облигация, ДатаАктуальности, , СчетДоверительногоУправления, ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона, Ложь, ОтборПоТипамОфертПоОблигациям).ДатаВыкупа;
			
			Если РасшифровкаРасчета <> Неопределено И ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона <> Неопределено Тогда
				РасшифровкаПараметров.Вставить("ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона", ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона);
			КонецЕсли;
			
		КонецЕсли; 
		
		// начался гребаный стыд
		Если Не ПараметрыДенежногоПотока.ДоДатыПогашения И ПараметрыДенежногоПотока.УчитыватьКупонКОферте = Ложь Тогда //это точно сберы
			Если СокрЛП(Облигация) = "МегаФон Финанс ООО, 4-06-36027-R, 1000.00 RUB"
				ИЛИ СокрЛП(Облигация) = "МегаФон Финанс ООО, 4-07-36027-R, 1000.00 RUB"
			Тогда
				ДатаВыкупа = Дата(2018, 3, 14);
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрыОценки <> Неопределено
			И ПараметрыОценки.Свойство("ВариантРасчетаОценочнойСтоимости")
			И ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020
			И Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_РЖД_001Б-02") Тогда
			ДатаВыкупа = Дата(2030, 7, 19);
		КонецЕсли;
		
		// закончился гребаный стыд
		
		// #Хардкод - другого варианта не вижу
		Если Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ДП_Роснфт2P7")
			И СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN084") Тогда
			ДатаВыкупа = Дата(2024, 3, 29);
		КонецЕсли;	
		
		// #Хардкод #339467: у "О1 Пропертиз Финанс АО, 4B02-01-71827-H, 1000.00 RUB" отодвинули дату погашения
		Если Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1_ПропертизФин")
			И ПараметрыДенежногоПотока.ДатаПереоценки <> Неопределено И ПараметрыДенежногоПотока.ДатаПереоценки < '20201002'
		Тогда
			ДатаВыкупа = '20201002';
		КонецЕсли;

		// #Хардкод #409385: решено не учитывать оферту
		Если ПараметрыДенежногоПотока.ДатаПереоценки <> Неопределено И ПараметрыДенежногоПотока.ДатаПереоценки >= '20211221'
			И ДатаВыкупа = '20211019'
			И Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_СПетербург_003")			// Санкт-Петербург, RU35003GSP0, 1000.00 RUB
			И СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_СафмарПН")	// НПФ Достойное БУДУЩЕЕ  АО ПН
		Тогда
			ДатаВыкупа = '20270413';
		КонецЕсли;
		
		Если ДатаВыкупа = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось определить дату выкупа для облигации '%1'", Облигация), , , , Отказ);
			Возврат Неопределено;
		КонецЕсли;
	
		РеквизитыОблигации.Вставить("ДатаВыкупа", ДатаВыкупа);

		Если РасшифровкаРасчета <> Неопределено Тогда
			РасшифровкаПараметров.Вставить("ДатаВыкупа", ДатаВыкупа);
		КонецЕсли;
		
		#КонецОбласти
		
		// Добавляем купоны
		
		// Формула расчета ставки может быть не заполнена в следующих случаях:
		// 1. Облигация с плавающей ставкой, но для данного купона ставка определяется эмитентом (в регистре ФормулыРасчетаСтавокКупонов пустая ссылка)
		//    - в этом случае возвращается пустая ссылка.
		// 2. Облигация с фиксированной ставкой или облигация с плавающей ставкой, но не заполнен регистр ФормулыРасчетаСтавокКупонов
		//    - в этом случае возвращается Неопределено.
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВЫБОР
			|		КОГДА КупонныйДоходПоОблигациям.ДатаОкончанияКупона > &ДатаВыкупа
			|			ТОГДА &ДатаВыкупа
			|		ИНАЧЕ КупонныйДоходПоОблигациям.ДатаОкончанияКупона
			|	КОНЕЦ КАК Дата,
			|	КупонныйДоходПоОблигациям.СуммаКупона КАК Поток,
			|	КупонныйДоходПоОблигациям.ДатаПубликации КАК ДатаПубликации,
			|	КупонныйДоходПоОблигациям.СтавкаКупона КАК Ставка,
			|	ИСТИНА КАК Купон,
			|	КупонныйДоходПоОблигациям.Период КАК ДатаНачалаКупона,
			|	ВЫБОР
			|		КОГДА КупонныйДоходПоОблигациям.ФормулаРасчетаСтавки <> ЗНАЧЕНИЕ(Справочник.НастройкиРасчета.ПустаяСсылка)
			|			ТОГДА КупонныйДоходПоОблигациям.ФормулаРасчетаСтавки
			|		КОГДА ФормулыРасчетаСтавокКупонов.ФормулаРасчетаСтавки = ЗНАЧЕНИЕ(Справочник.НастройкиРасчета.ПустаяСсылка)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.НастройкиРасчета.ПустаяСсылка)
			|		ИНАЧЕ НЕОПРЕДЕЛЕНО
			|	КОНЕЦ КАК ФормулаРасчетаСтавки,
			|	ЛОЖЬ КАК ИзвестныйПоток,
			|	НоминалыЦенныхБумаг.Номинал КАК Номинал,
			|	КупонныйДоходПоОблигациям.ДатаОкончанияКупона > &ДатаВыкупа КАК ЧастичныйКупон
			|ИЗ
			|	РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФормулыРасчетаСтавокКупонов.СрезПоследних(&Дата, Облигация = &ЦеннаяБумага) КАК ФормулыРасчетаСтавокКупонов
			|		ПО (ФормулыРасчетаСтавокКупонов.Облигация = КупонныйДоходПоОблигациям.Облигация)
			|			И (ФормулыРасчетаСтавокКупонов.НомерКупона = КупонныйДоходПоОблигациям.НомерКупона)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|				КупонныйДоходПоОблигациям.Период КАК ДатаНачалаКупона,
			|				МАКСИМУМ(НоминалыЦенныхБумаг.Период) КАК ДатаНоминала
			|			ИЗ
			|				РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
			|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
			|					ПО КупонныйДоходПоОблигациям.Облигация = НоминалыЦенныхБумаг.ЦеннаяБумага
			|						И КупонныйДоходПоОблигациям.Период >= НоминалыЦенныхБумаг.Период
			|			ГДЕ
			|				КупонныйДоходПоОблигациям.Облигация = &ЦеннаяБумага
			|			
			|			СГРУППИРОВАТЬ ПО
			|				КупонныйДоходПоОблигациям.Период) КАК ДатыНоминалов
			|			ПО (ДатыНоминалов.ДатаНоминала = НоминалыЦенныхБумаг.Период)
			|		ПО КупонныйДоходПоОблигациям.Облигация = НоминалыЦенныхБумаг.ЦеннаяБумага
			|			И (КупонныйДоходПоОблигациям.Период = ДатыНоминалов.ДатаНачалаКупона)
			|ГДЕ
			|	КупонныйДоходПоОблигациям.Облигация = &ЦеннаяБумага
			|	И ВЫБОР
			|			КОГДА &УчитыватьКупонКОферте = ИСТИНА
			|				ТОГДА КупонныйДоходПоОблигациям.Период < &ДатаВыкупа
			|			КОГДА &УчитыватьКупонКОферте = ""УчитыватьКупонТолькоПриОбъявленнойСтавке""
			|				ТОГДА КупонныйДоходПоОблигациям.Период < &ДатаВыкупа
			|						И (КупонныйДоходПоОблигациям.ДатаОкончанияКупона <= &ДатаВыкупа
			|							ИЛИ КупонныйДоходПоОблигациям.ДатаПубликации <= &Дата
			|								И КупонныйДоходПоОблигациям.ДатаПубликации <> ДАТАВРЕМЯ(1, 1, 1))
			|			ИНАЧЕ КупонныйДоходПоОблигациям.ДатаОкончанияКупона <= &ДатаВыкупа
			|		КОНЕЦ
			|
			|УПОРЯДОЧИТЬ ПО
			|	Дата";
		
		Запрос.УстановитьПараметр("ЦеннаяБумага",			Облигация);
		Запрос.УстановитьПараметр("Дата",					ПараметрыДенежногоПотока.Дата);
		Запрос.УстановитьПараметр("УчитыватьКупонКОферте",	ПараметрыДенежногоПотока.УчитыватьКупонКОферте);
		Запрос.УстановитьПараметр("ДатаВыкупа",				ДатаВыкупа);
		
		СтавкаПрошедшегоКупона	 = Неопределено;
		ПоследняяИзвестнаяСтавка = Неопределено;
		ДатаПоследнейПубликации  = '00010101';
		
		ВыборкаКупоны = Запрос.Выполнить().Выбрать();
		
		Пока ВыборкаКупоны.Следующий() Цикл
			
			Если ПараметрыДенежногоПотока.ДатаПереоценки <> Неопределено Тогда
				
				// Смотрим купоны на определенную дату и есть ли информация о дате публикации о данном купоне
				
				Если ЗначениеЗаполнено(ВыборкаКупоны.ДатаПубликации) И ВыборкаКупоны.ДатаПубликации > ДатаПоследнейПубликации Тогда
					ДатаПоследнейПубликации = ВыборкаКупоны.ДатаПубликации;
				КонецЕсли;
				
				СтавкаИзвестна = Ложь;
				
				// некоторые клиенты только с момента наступления купона принимают изменение потока по нему
				// начался купон - все, берем по нему и дату публикации и ставку
				
				ПринимаемВоВниманиеЭтотКупон =
					НЕ ПараметрыДенежногоПотока.УчитыватьИзмененениеКупонаСНаступленияПериода
						ИЛИ ВыборкаКупоны.ДатаНачалаКупона <= ПараметрыДенежногоПотока.ДатаПереоценки;
				
				Если ПринимаемВоВниманиеЭтотКупон Тогда
					Если ДатаПоследнейПубликации <= ПараметрыДенежногоПотока.ДатаПереоценки Тогда // Опубликовано ранее даты расчета
						СтавкаИзвестна			 = Истина;
						ПоследняяИзвестнаяСтавка = ВыборкаКупоны.Ставка;
					КонецЕсли;
				КонецЕсли;
			
			КонецЕсли;
			
			Если ВыборкаКупоны.Дата <= ПараметрыДенежногоПотока.Дата Тогда
				СтавкаПрошедшегоКупона = ВыборкаКупоны.Ставка;
				Продолжить;
			КонецЕсли;
			
			НоваяСтрокаДенежныйПоток = ДенежныйПоток.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрокаДенежныйПоток, ВыборкаКупоны);
			
			// Это будущий купон и мы не могли о нем знать в эту дату
			
			Если ПараметрыДенежногоПотока.ДатаПереоценки <> Неопределено
				И ВыборкаКупоны.Дата > ПараметрыДенежногоПотока.ДатаПереоценки
				И Не СтавкаИзвестна
			Тогда
			
			    #Область Определение_ставки_купона
			
				Если Не ПараметрыДенежногоПотока.РассчитыватьПрогнозныеЗначения
					ИЛИ	Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Промсвязьбанк")
					ИЛИ Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ПСБ_013")
				Тогда
					
					// Иногда берем купоны такими, как они занесены в регистре.
					// Например, есть очень странные облигации с нестандартными периодами и расчетами
					
				Иначе
					
					НоваяСтрокаДенежныйПоток.Ставка = ПоследняяИзвестнаяСтавка;
					
					Если ЭтоОблигацияСПлавающимКупоном
						И (Не ВыборкаКупоны.ЧастичныйКупон ИЛИ ПараметрыДенежногоПотока.ВариантРасчетаКупонаКОферте = "ОтПрогнозногоЗначенияСтавки")
					Тогда
					
						// Для плавающей ставки выполняем расчет ее прогнозного значения
						
						Если ПараметрыПрогноза = Неопределено Тогда					
						
							#Область Параметры_расчета_прогнозных_значений_плавающих_ставок
							
							//#Техдолг

							Если ВариантРасчетаОценочнойСтоимости = Неопределено И ПараметрыДенежногоПотока.ДатаПереоценки <> Неопределено И ПараметрыДенежногоПотока.ДатаПереоценки >= '20200101' Тогда
							
								ЗапросНастроекОценки = Новый Запрос(
									"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
									|	НастройкиЦелейРасчетаСрезПоследних.ВариантРасчетаОценочнойСтоимости КАК ВариантРасчетаОценочнойСтоимости
									|ИЗ
									|	РегистрСведений.НастройкиЦелейРасчета.СрезПоследних(
									|			&Период,
									|			СчетДоверительногоУправления = &СчетДоверительногоУправления
									|				И ЦельРасчета В (ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении), ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ЕдиныйПланСчетов))) КАК НастройкиЦелейРасчетаСрезПоследних");
								
								ЗапросНастроекОценки.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
								ЗапросНастроекОценки.УстановитьПараметр("Период",						ПараметрыДенежногоПотока.ДатаПереоценки);
									
								НастройкиОценки = ЗапросНастроекОценки.Выполнить().Выгрузить();
								
								Если НастройкиОценки.Количество() > 1 Тогда
									Для Каждого НастройкаОценки Из НастройкиОценки Цикл
										Если Не ВыполнятьРасчетПрогнозныхЗначенийСтавокКупоновОблигаций(НастройкаОценки.ВариантРасчетаОценочнойСтоимости, ПараметрыДенежногоПотока.ДатаПереоценки) Тогда
											ТекстОшибки = СтрШаблон("На %1 у клиента %2 различаются варианты расчета оценочной стоимости активов для оценки объектов в управлении и ЕПС. Расчет прогнозных значений будущих потоков '%3' не может быть выполнен.", 
												Формат(ПараметрыДенежногоПотока.ДатаПереоценки, "ДФ=dd.MM.yyyy"), СчетДоверительногоУправления, Облигация);
											ВызватьИсключение ТекстОшибки;
										КонецЕсли;
									КонецЦикла;
								ИначеЕсли НастройкиОценки.Количество() > 0 Тогда
									ВариантРасчетаОценочнойСтоимости = НастройкиОценки[0].ВариантРасчетаОценочнойСтоимости;
								КонецЕсли;
								
							КонецЕсли;
										
							РеквизитыОценки = Новый Структура;
							РеквизитыОценки.Вставить("СчетДоверительногоУправления",	 СчетДоверительногоУправления);
							РеквизитыОценки.Вставить("Организация",						 Организация);
							РеквизитыОценки.Вставить("Клиент",							 Клиент);
							РеквизитыОценки.Вставить("ВариантРасчетаОценочнойСтоимости", ВариантРасчетаОценочнойСтоимости);
							
							//#Техдолг Конец	
							
							ПараметрыПрогноза = Новый Структура;
							
							#КонецОбласти
						
						КонецЕсли;
					
						Если ВыполнятьРасчетПрогнозныхЗначенийСтавокКупоновОблигаций(РеквизитыОценки.ВариантРасчетаОценочнойСтоимости, ПараметрыДенежногоПотока.ДатаПереоценки) Тогда
						
							Если РасшифровкаРасчета <> Неопределено Тогда
								РасшифровкаРасчетаСтавки = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, "Расчет прогнозного значения ставки купона на " + Формат(ВыборкаКупоны.Дата, "ДФ=dd.MM.yyyy"), , , Истина);
							КонецЕсли;
							
							ПараметрыПрогноза.Вставить("СтавкаПредыдущегоКупона", ?(ДенежныйПоток.Количество() > 1, ДенежныйПоток[ДенежныйПоток.Количество() - 2].Ставка, СтавкаПрошедшегоКупона));
							
							НоваяСтрокаДенежныйПоток.Ставка = РассчитатьПрогнозноеЗначениеСтавкиКупона(РеквизитыОблигации, ВыборкаКупоны.ФормулаРасчетаСтавки, ВыборкаКупоны, ПараметрыДенежногоПотока, РеквизитыОценки, ПараметрыПрогноза, Отказ, РасшифровкаРасчетаСтавки);
							
							Если Отказ = Истина Тогда
								Возврат Неопределено;
							КонецЕсли;
							
						КонецЕсли;
							
					КонецЕсли;
					
				КонецЕсли;
				
				#КонецОбласти
				
			Иначе
				
				НоваяСтрокаДенежныйПоток.ИзвестныйПоток = (ПараметрыДенежногоПотока.ДатаПереоценки <> Неопределено);
				
			КонецЕсли;
			
			// Правильнее считать от ставки, т.к. купонный период может быть неравномерен, например: 90-91-90-91
			
			Если Не ЗначениеЗаполнено(НоваяСтрокаДенежныйПоток.Ставка) Тогда
				
				Если ВыборкаКупоны.ЧастичныйКупон Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось определить ставку для расчета купона к оферте '%1'", Облигация), , , , Отказ);
					Возврат Неопределено;
				КонецЕсли;
					
			ИначеЕсли НоваяСтрокаДенежныйПоток.Ставка <> ВыборкаКупоны.Ставка ИЛИ ВыборкаКупоны.ЧастичныйКупон Тогда
				
				// Если ставка как регистре, то считаем поток только для купона к оферте
				
				НоваяСтрокаДенежныйПоток.Поток = РаботаСЦеннымиБумагами.РассчитатьКупон(
					РеквизитыОблигации.БазаРасчета, ВыборкаКупоны.ДатаНачалаКупона, ВыборкаКупоны.Дата, ВыборкаКупоны.Номинал, НоваяСтрокаДенежныйПоток.Ставка);
					
				// Округляем рассчитанный купон
				
				ТочностьКупона = 2;
				
				Если ВыборкаКупоны.ЧастичныйКупон
					И ЗначениеЗаполнено(ПараметрыДенежногоПотока.ДатаПереоценки)
					И ПараметрыДенежногоПотока.ДатаПереоценки < '20200121' // с 21.01.2020 купон к оферте округляется всегда до 2 знаков
					И ПараметрыДенежногоПотока.Свойство("ТочностьОкругления")
				Тогда
					ТочностьКупона = ПараметрыДенежногоПотока.ТочностьОкругления;
				КонецЕсли;
					
				Если ТочностьКупона <> Неопределено Тогда
					НоваяСтрокаДенежныйПоток.Поток = Окр(НоваяСтрокаДенежныйПоток.Поток, ТочностьКупона);
				КонецЕсли;
					
			КонецЕсли;
			
		КонецЦикла;		
		
		// Определяем дату окончания срока обращения 
		
		ДатаОкончанияСрокаОбращения = ДатаВыкупа;
		
		Если ПараметрыДенежногоПотока.ОграничиватьСрокОбращенияДатойОкончанияПоследнегоКупона И ВыборкаКупоны.Количество() > 0 Тогда
			
			ДатаОкончанияСрокаОбращения = ВыборкаКупоны.Дата;	
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				РасшифровкаПараметров.Вставить("ДатаОкончанияПоследнегоКупона", ВыборкаКупоны.Дата);
			КонецЕсли;		
			
		КонецЕсли;		
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			РасшифровкаПараметров.Вставить("ДатаОкончанияСрокаОбращения", ДатаОкончанияСрокаОбращения);
		КонецЕсли;		
		
		// Добавляем номиналы
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&ДатаОкончанияСрокаОбращения КАК Дата,
			|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Поток,
			|	ИСТИНА КАК ИзвестныйПоток
			|ИЗ
			|	РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
			|			&ДатаОкончанияСрокаОбращения,
			|			ЦеннаяБумага = &ЦеннаяБумага
			|				И &Дата < &ДатаОкончанияСрокаОбращения) КАК НоминалыЦенныхБумагСрезПоследних
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	НоминалыЦенныхБумаг.Период,
			|	НоминалыЦенныхБумаг.СуммаИзменения,
			|	ИСТИНА
			|ИЗ
			|	РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
			|ГДЕ
			|	НоминалыЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага
			|	И НоминалыЦенныхБумаг.СуммаИзменения > 0
			|	И НоминалыЦенныхБумаг.Период > &Дата
			|	И НоминалыЦенныхБумаг.Период <= &ДатаОкончанияСрокаОбращения
			|	И &ВключаяАмортизацииНоминала";
				
		Запрос.УстановитьПараметр("ДатаОкончанияСрокаОбращения", ДатаОкончанияСрокаОбращения);
		Запрос.УстановитьПараметр("ВключаяАмортизацииНоминала",	 РеквизитыОблигации.Амортизационная);

		ВыборкаНоминалы = Запрос.Выполнить().Выбрать();
		
		Пока ВыборкаНоминалы.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(ДенежныйПоток.Добавить(), ВыборкаНоминалы);
		КонецЦикла;
				
		#КонецОбласти
		
	Иначе
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			РасшифровкаПараметров.Вставить("ОписаниеРезультата", "Денежный поток предоставлен клиентом");
		КонецЕсли;
		
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаОперации, "ПараметрыДенежногоПотока", РасшифровкаПараметров, "Параметры получения денежного потока", , Истина);
	КонецЕсли;
	
	// Сворачиваем при необходимости потоки
	
	Если ПараметрыДенежногоПотока.ОбъединятьПотокиПоПериоду Тогда
		
		#Область Свертка_потоков_по_дате
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаОперации, "ДенежныйПотокИсходный", ДенежныйПоток.Скопировать(), "Денежный поток до объединения по периоду", Истина);
		КонецЕсли;
		
		ДенежныйПоток.Колонки.Добавить("ПотокПоТелу",	Новый ОписаниеТипов("Число"));
		ДенежныйПоток.Колонки.Добавить("ПотокПоКупону",	Новый ОписаниеТипов("Число"));
		
		Для Каждого СтрокаПотока Из ДенежныйПоток Цикл
			СтрокаПотока[?(СтрокаПотока.Купон, "ПотокПоКупону", "ПотокПоТелу")] = СтрокаПотока.Поток;
		КонецЦикла;
		
		ДенежныйПоток.Свернуть("Дата", "Поток, ПотокПоТелу, ПотокПоКупону");
		
		#КонецОбласти
		
		ДенежныйПоток.Сортировать("Дата");
		
	Иначе
		
		ДенежныйПоток.Сортировать("Дата, Поток");
		
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаОперации, "ДенежныйПоток", ДенежныйПоток.Скопировать(), "Денежный поток");
	КонецЕсли;
	
	Возврат ДенежныйПоток;
	
КонецФункции

Функция ВыполнятьРасчетПрогнозныхЗначенийСтавокКупоновОблигаций(ВариантРасчетаСправедливойСтоимости, Период) Экспорт
	
	Возврат ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Федерация
		ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_Нефтегарант2018
		ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ХантыМансийский2020 И Период >= '20200527'
		ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Перспектива2020
		ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020
		ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Газфонд И Период >= '20200101'
		ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Доверие
		ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020 И Период >= '20210101'
		ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Эволюция2021
		ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Эволюция2021_2
		ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Федерация2021
		ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФк_ФДЦБ2021
		ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Большой
		ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020_2 И Период >= '20210101'
		ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2020 И Период >= '20210101'
		ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Аквилон2021
		ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Стройкомплекс2021
		ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Традиция2019 И Период >= '20230401'
		ИЛИ ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Гефест;

КонецФункции

Функция РассчитатьПрогнозноеЗначениеСтавкиКупона(РеквизитыОблигации, ФормулаРасчетаСтавки, ПараметрыКупона, ПараметрыДенежногоПотока, ПараметрыОценки, ПараметрыПрогноза, Отказ, РасшифровкаРасчета = Неопределено)
	
	ПрогнознаяСтавка = Неопределено;
	
	Облигация			= РеквизитыОблигации.Облигация;
	ДатаВыкупа			= РеквизитыОблигации.ДатаВыкупа;
	ИсточникПрогноза	= ПараметрыОценки.Клиент; // Если не установлено иного, то источником прогнозных значений является сам клиент
	
	ПараметрыСпособаРасчета = Новый Структура;
	ПараметрыСпособаРасчета.Вставить("ИсточникПрогноза", ИсточникПрогноза);
	ПараметрыСпособаРасчета.Вставить("ФормулаРасчетаСтавки", ФормулаРасчетаСтавки);
	
	СпособРасчетаПрогнозныхСтавок = "";
    
	Если ЗначениеЗаполнено(ФормулаРасчетаСтавки) Тогда
		
		Составляющие = ФормулаРасчетаСтавки.Составляющие;
		
		Если Составляющие.Количество() = 1 
			И Составляющие[0].БазаРасчета = Справочники.БазыРасчета.ФиксированнаяСтавка
		Тогда 
		
		    ПрогнознаяСтавка = Составляющие[0].ПараметрыРасчета.Получить().ПараметрРасчетаСтавка; 
			
			ПараметрыСпособаРасчета.Вставить("ПрогнознаяСтавка", ПрогнознаяСтавка);
			
		ИначеЕсли Составляющие.Количество() = 1 
			И (Составляющие[0].БазаРасчета = Справочники.БазыРасчета.МинимальноеЗначение
				ИЛИ Составляющие[0].БазаРасчета = Справочники.БазыРасчета.МаксимальноеЗначение)
		Тогда 
		
		    #Область Min_Max
			
			ОшибкаРасчета = Ложь;
			
		    ПараметрыФункцииСравнения = Составляющие[0].ПараметрыРасчета.Получить();
			
			Значение1 = РассчитатьПрогнозноеЗначениеСтавкиКупона(РеквизитыОблигации, ПараметрыФункцииСравнения.ПараметрРасчетаЗначение1, ПараметрыКупона, ПараметрыДенежногоПотока, ПараметрыОценки, ПараметрыПрогноза, ОшибкаРасчета, РасшифровкаРасчета);
			Значение2 = РассчитатьПрогнозноеЗначениеСтавкиКупона(РеквизитыОблигации, ПараметрыФункцииСравнения.ПараметрРасчетаЗначение2, ПараметрыКупона, ПараметрыДенежногоПотока, ПараметрыОценки, ПараметрыПрогноза, ОшибкаРасчета, РасшифровкаРасчета);
			
			Если Не ОшибкаРасчета Тогда
				ПрогнознаяСтавка = ?(Составляющие[0].БазаРасчета = Справочники.БазыРасчета.МинимальноеЗначение, Мин(Значение1, Значение2), Макс(Значение1, Значение2)); 
				ПараметрыСпособаРасчета.Вставить("ПрогнознаяСтавка", ПрогнознаяСтавка);
			КонецЕсли;
				
			Если РасшифровкаРасчета <> Неопределено Тогда
