				ПараметрыСпособаРасчета.Вставить("ПрогнозируемоеЗначение", ОбщегоНазначения.ПолучитьИменованныйОбъект("Индекс_РУОНИА"));
				
				Если Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОФЗ_29006RMFS") // Минфин России, 29006RMFS, 1000.00 RUB
					ИЛИ Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОФЗ_29008RMFS") // Минфин России, 29008RMFS, 1000.00 RUB
				Тогда 
				
					// За 2 рабочих дня до даты расчета, исключая ее
					ОкончаниеПериода = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ПараметрыДенежногоПотока.ДатаПереоценки) - 1, -2) - 1;
					ПараметрыСпособаРасчета.Вставить("ОкончаниеПериода", ОкончаниеПериода); 
					
					// 182 дня (среднее количество дней в 6 месяцах) назад, включая дату окончания
					ПараметрыСпособаРасчета.Вставить("НачалоПериода", (ОкончаниеПериода + 1) - 182 * 86400); 
					
				ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин29013") // Минфин России, 29013RMFS, 1000.00 RUB
					ИЛИ Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин29014")	  // Минфин России, 29014RMFS, 1000.00 RUB
					ИЛИ Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин29015")	  // Минфин России, 29015RMFS, 1000.00 RUB
					ИЛИ Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин29016")	  // Минфин России, 29016RMFS, 1000.00 RUB
					ИЛИ Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин29017")	  // Минфин России, 29017RMFS, 1000.00 RUB
					ИЛИ Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин29018")	  // Минфин России, 29018RMFS, 1000.00 RUB
					ИЛИ Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин29019")	  // Минфин России, 29019RMFS, 1000.00 RUB
					ИЛИ Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин29020")	  // Минфин России, 29020RMFS, 1000.00 RUB
				Тогда
				
					// За 7 дней до даты расчета
					ПараметрыСпособаРасчета.Вставить("ОкончаниеПериода", КонецДня(НачалоДня(ПараметрыДенежногоПотока.ДатаПереоценки) - 7 * 86400)); 
					
					// 91 день (купонный период)
					ПараметрыСпособаРасчета.Вставить("НачалоПериода", (ОкончаниеПериода + 1) - 91 * 86400); 
					
				Иначе
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						СтрШаблон("Необходимо заполнить параметры расчета купона из решения о выпуске '%1' для расчета прогнозного значения ставки RUONIA на %2",
							Облигация, Формат(ПараметрыКупона.ДатаНачалаКупона, "ДФ=dd.MM.yyyy")), , , , Отказ);
					Возврат Неопределено;
					
				КонецЕсли;
			
			ИначеЕсли ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Федерация2021
				ИЛИ ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Эволюция2021
				ИЛИ ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Эволюция2021_2
				ИЛИ ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ХантыМансийский2020
				ИЛИ ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Перспектива2020
				ИЛИ ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020
				ИЛИ ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Газфонд
				ИЛИ ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Доверие
				ИЛИ ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020
				ИЛИ ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФк_ФДЦБ2021					
				ИЛИ ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Гефест					
			Тогда
		
				СпособРасчетаПрогнозныхСтавок = "КакРазницаКБДДоПогашенияИСреднейПроцентнойМаржиНадСтоимостьюФондирования";
				ТочностьСрокаДоПогашения	  = 4;
				ТочностьКБД					  = 2;

				Если ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Гефест Тогда
					ТочностьСрокаДоПогашения = 2;
					ТочностьКБД				 = Неопределено;
				ИначеЕсли ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020 Тогда
					ТочностьСрокаДоПогашения = 4;
					ТочностьКБД				 = Неопределено;
				КонецЕсли;
				
				ПараметрыСпособаРасчета.Вставить("ТочностьСрокаДоПогашения",	ТочностьСрокаДоПогашения);
				ПараметрыСпособаРасчета.Вставить("ТочностьКБД",					ТочностьКБД);
				
			ИначеЕсли ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2020 Тогда
			
				СпособРасчетаПрогнозныхСтавок	= "ПоПорядкуСпособовРасчета";
					
				ПорядокСпособовРасчетаПрогнозныхСтавок = Новый Массив;
				ПорядокСпособовРасчетаПрогнозныхСтавок.Добавить("ПоЦенеИДоходностиАналогичныхОблигаций");
				ПорядокСпособовРасчетаПрогнозныхСтавок.Добавить("ПоПодходуСохраненияКредитногоСпреда"); 
			
			ИначеЕсли ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Стройкомплекс2021
				ИЛИ ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Традиция2019
			Тогда
				
				СпособРасчетаПрогнозныхСтавок = "ПоЦенеИДоходностиАналогичныхОблигаций";
				
			КонецЕсли;
			
			#КонецОбласти
				
		Иначе
			
			// Сложные расчеты еще не реализованы
			
		КонецЕсли;
		
	ИначеЕсли ФормулаРасчетаСтавки = Справочники.НастройкиРасчета.ПустаяСсылка() Тогда
		
		#Область Ставка_определяется_эмитентом
		
		Если ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2020 Тогда
			
			СпособРасчетаПрогнозныхСтавок	= "ПоПорядкуСпособовРасчета";
				
			ПорядокСпособовРасчетаПрогнозныхСтавок = Новый Массив;
			ПорядокСпособовРасчетаПрогнозныхСтавок.Добавить("ПоЦенеИДоходностиАналогичныхОблигаций");
			ПорядокСпособовРасчетаПрогнозныхСтавок.Добавить("ПоПодходуСохраненияКредитногоСпреда"); 
			
		Иначе
			СпособРасчетаПрогнозныхСтавок = "ОтСтавкиПредыдущегоКупона";
		КонецЕсли;
		
		#КонецОбласти
		
	КонецЕсли;

	// Расчет 
	Если СпособРасчетаПрогнозныхСтавок = "ПоПорядкуСпособовРасчета" Тогда
		
		Для Каждого СпособРасчета Из ПорядокСпособовРасчетаПрогнозныхСтавок Цикл
			
			ОшибкаРасчета = Ложь;
			Результат = РассчитатьПрогнозноеЗначениеСтавкиКупонаСпособомРасчета(
							СпособРасчета, 
							ПараметрыСпособаРасчета, 
							РеквизитыОблигации, 
							ПараметрыКупона, 
							ПараметрыДенежногоПотока, 
							ПараметрыОценки, 
							ПараметрыПрогноза, 
							ОшибкаРасчета, 
							РасшифровкаРасчета, Ложь);
							
			Если Не ОшибкаРасчета Тогда
				Прервать;
			КонецЕсли;
										
		КонецЦикла;
		
	Иначе
		
		ОшибкаРасчета = Ложь;
		Результат = РассчитатьПрогнозноеЗначениеСтавкиКупонаСпособомРасчета(
							СпособРасчетаПрогнозныхСтавок, 
							ПараметрыСпособаРасчета, 
							РеквизитыОблигации, 
							ПараметрыКупона, 
							ПараметрыДенежногоПотока, 
							ПараметрыОценки, 
							ПараметрыПрогноза, 
							ОшибкаРасчета, 
							РасшифровкаРасчета);
							
	КонецЕсли;
	
	Если ОшибкаРасчета Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Возврат ?(ОшибкаРасчета, Неопределено, Результат);
	
КонецФункции

Функция ПолучитьОблигацииСПлавающейСтавкойИлиНоминалом(ЦенныеБумаги, Период, ДоДатыПогашения = Ложь, УчитыватьКупонКОферте = Истина, РасшифровкаРасчета = Неопределено) Экспорт
	
	// Облигациями с плавающей ставкой или номиналом будем считать следующие:
	// 1. С признаками ИндексируемыйНоминал или ИндексацияОтCPI
	// 2. С переменным купоном и заполненным значением БазоваяСтавка:
	//		- максимальная дата публикации ставок до даты выкупа больше даты оценки
	//		- или максимальная дата публикации не последняя (например, в таком наборе: 20.05.2019, 18.11.2019, 18.05.2020(max), 20.05.2019, 20.05.2019)
	// 3. Облигации со сложной структурой выпуска (сроки погашений номинала или процентного дохода не определены при размещении и зависят от факторов, которые будут определены в будущем)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСпискаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ИсходнаяТаблицаЦБ
		|ИЗ
		|	&ТаблицаСпискаЦБ КАК ТаблицаСпискаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БумагиСоСложнойСтруктуройВыпуска.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БумагиСоСложнойСтруктуройВыпуска.Описание КАК Описание
		|ПОМЕСТИТЬ _БумагиСоСложнойСтруктуройВыпуска
		|ИЗ
		|	&БумагиСоСложнойСтруктуройВыпуска КАК БумагиСоСложнойСтруктуройВыпуска
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Облигации.Ссылка КАК ЦеннаяБумага,
		|	Облигации.ДатаПогашения КАК ДатаПогашения,
		|	Облигации.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыОблигаций.КупоннаяПК)
		|		И НЕ Облигации.БазоваяСтавка = ЗНАЧЕНИЕ(Справочник.БазовыеСтавкиОблигаций.ПустаяСсылка) КАК ПлавающаяСтавка,
		|	Облигации.ИндексируемыйНоминал
		|		ИЛИ Облигации.ИндексацияОтCPI КАК ПлавающийНоминал,
		|	_БумагиСоСложнойСтруктуройВыпуска.ЦеннаяБумага ЕСТЬ НЕ NULL  КАК СложнаяСтруктураВыпуска
		|ПОМЕСТИТЬ _ТаблицаОблигаций
		|ИЗ
		|	_ИсходнаяТаблицаЦБ КАК _ИсходнаяТаблицаЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ИсходнаяТаблицаЦБ.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _БумагиСоСложнойСтруктуройВыпуска КАК _БумагиСоСложнойСтруктуройВыпуска
		|		ПО (_БумагиСоСложнойСтруктуройВыпуска.ЦеннаяБумага = Облигации.Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаОблигаций.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЕСТЬNULL(МИНИМУМ(УсловияОферт.ДатаВыкупа), _ТаблицаОблигаций.ДатаПогашения) КАК ДатаВыкупа
		|ПОМЕСТИТЬ _ДатыВыкупаБумагСПлавающейСтавкой
		|ИЗ
		|	_ТаблицаОблигаций КАК _ТаблицаОблигаций
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияОферт КАК УсловияОферт
		|		ПО (УсловияОферт.Облигация = _ТаблицаОблигаций.ЦеннаяБумага)
		|			И (УсловияОферт.ДатаВыкупа >= &Период)
		|			И (НЕ УсловияОферт.ТолькоДляФизическихЛиц)
		|			И (УсловияОферт.ДатаОбъявления = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ УсловияОферт.ДатаОбъявления <= &Период)
		|ГДЕ
		|	_ТаблицаОблигаций.ПлавающаяСтавка
		|	И НЕ _ТаблицаОблигаций.ПлавающийНоминал
		|	И НЕ _ТаблицаОблигаций.СложнаяСтруктураВыпуска
		|
		|СГРУППИРОВАТЬ ПО
		|	_ТаблицаОблигаций.ЦеннаяБумага,
		|	_ТаблицаОблигаций.ДатаПогашения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаОблигаций.ЦеннаяБумага КАК ЦеннаяБумага
		|ИЗ
		|	_ТаблицаОблигаций КАК _ТаблицаОблигаций
		|ГДЕ
		|	(_ТаблицаОблигаций.ПлавающийНоминал
		|			ИЛИ _ТаблицаОблигаций.СложнаяСтруктураВыпуска)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ДатыВыкупа.ЦеннаяБумага
		|ИЗ
		|	_ДатыВыкупаБумагСПлавающейСтавкой КАК _ДатыВыкупа
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ПоследниеИзвестныеКупоны.Облигация КАК Облигация,
		|			ПоследниеИзвестныеКупоны.ДатаПубликации КАК ДатаПубликации,
		|			МИНИМУМ(ПоследниеИзвестныеКупоны.Период) КАК Период
		|		ИЗ
		|			РегистрСведений.КупонныйДоходПоОблигациям КАК ПоследниеИзвестныеКупоны
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|					Купоны.Облигация КАК Облигация,
		|					МАКСИМУМ(Купоны.ДатаПубликации) КАК ДатаПоследнейПубликации
		|				ИЗ
		|					_ДатыВыкупаБумагСПлавающейСтавкой КАК _ДатыВыкупа
		|						ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям КАК Купоны
		|						ПО (Купоны.Облигация = _ДатыВыкупа.ЦеннаяБумага)
		|							И (Купоны.Период <= _ДатыВыкупа.ДатаВыкупа)
		|							И (&УчитыватьКупонКОферте
		|								ИЛИ Купоны.ДатаОкончанияКупона <= _ДатыВыкупа.ДатаВыкупа)
		|				
		|				СГРУППИРОВАТЬ ПО
		|					Купоны.Облигация) КАК ПоследниеПубликации
		|				ПО (ПоследниеПубликации.Облигация = ПоследниеИзвестныеКупоны.Облигация)
		|					И (ПоследниеПубликации.ДатаПоследнейПубликации = ПоследниеИзвестныеКупоны.ДатаПубликации)
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ПоследниеИзвестныеКупоны.Облигация,
		|			ПоследниеИзвестныеКупоны.ДатаПубликации) КАК ПоследниеИзвестныеКупоны
		|		ПО (ПоследниеИзвестныеКупоны.Облигация = _ДатыВыкупа.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям КАК КупоныПослеПоследнейПубликации
		|		ПО (КупоныПослеПоследнейПубликации.Облигация = _ДатыВыкупа.ЦеннаяБумага
		|					И КупоныПослеПоследнейПубликации.Период <= _ДатыВыкупа.ДатаВыкупа
		|					И КупоныПослеПоследнейПубликации.Период > ПоследниеИзвестныеКупоны.Период
		|					И КупоныПослеПоследнейПубликации.ДатаПубликации < ПоследниеИзвестныеКупоны.ДатаПубликации
		|					И (&УчитыватьКупонКОферте
		|						ИЛИ КупоныПослеПоследнейПубликации.ДатаОкончанияКупона <= _ДатыВыкупа.ДатаВыкупа)
		|				ИЛИ КупоныПослеПоследнейПубликации.Период = _ДатыВыкупа.ЦеннаяБумага.ДатаПогашения)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДатыВыкупа.ЦеннаяБумага,
		|	ПоследниеИзвестныеКупоны.ДатаПубликации
		|
		|ИМЕЮЩИЕ
		|	(ПоследниеИзвестныеКупоны.ДатаПубликации > &Период
		|		ИЛИ КОЛИЧЕСТВО(КупоныПослеПоследнейПубликации.Период) > 0)");
	
	Если ТипЗнч(ЦенныеБумаги) = Тип("ТаблицаЗначений") Тогда
		ТаблицаСпискаЦБ = ЦенныеБумаги;
	Иначе
		ТаблицаСпискаЦБ = Новый ТаблицаЗначений;
		ТаблицаСпискаЦБ.Колонки.Добавить("ЦеннаяБумага", Новый ОписаниеТипов("СправочникСсылка.Облигации"));
		ТаблицаСпискаЦБ.Добавить().ЦеннаяБумага = ЦенныеБумаги;
	КонецЕсли;
	
	БумагиСоСложнойСтруктуройВыпуска = Новый ТаблицаЗначений;
	БумагиСоСложнойСтруктуройВыпуска.Колонки.Добавить("ЦеннаяБумага",	Новый ОписаниеТипов("СправочникСсылка.Облигации"));
	БумагиСоСложнойСтруктуройВыпуска.Колонки.Добавить("Описание",		Новый ОписаниеТипов("Строка"));
	
	СтрокаБумаги = БумагиСоСложнойСтруктуройВыпуска.Добавить();
	СтрокаБумаги.ЦеннаяБумага	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Пересвет");
	СтрокаБумаги.Описание		= "Облигации погашаются кредитной организацией-эмитентом путем конвертации выпуска облигаций в обыкновенные именные бездокументарные акции";
	
	Запрос.УстановитьПараметр("ТаблицаСпискаЦБ",		  			ТаблицаСпискаЦБ);
	Запрос.УстановитьПараметр("Период",					  			Период);
	Запрос.УстановитьПараметр("ДоДатыПогашения",					ДоДатыПогашения);
	Запрос.УстановитьПараметр("УчитыватьКупонКОферте",	  			УчитыватьКупонКОферте);
	Запрос.УстановитьПараметр("БумагиСоСложнойСтруктуройВыпуска",	БумагиСоСложнойСтруктуройВыпуска);
	
	Если РасшифровкаРасчета = Неопределено Тогда
		ВыгрузкаЗапроса = Запрос.Выполнить().Выгрузить();
	Иначе
		ВыгрузкаЗапроса = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получить облигации с плавающей ставкой или номиналом", "Облигации с плавающей ставкой или номиналом", , , , Истина);
	КонецЕсли;	
	
	РезультатФункции = ВыгрузкаЗапроса.ВыгрузитьКолонку("ЦеннаяБумага");
	
	Возврат РезультатФункции;	
	
КонецФункции

Функция ПолучитьДатуИСуммуАмортизации(Облигация, Дата) Экспорт
	
	Если ЗначениеЗаполнено(Облигация) Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	НоминалыЦенныхБумаг.Период КАК Период,
			|	НоминалыЦенныхБумаг.СуммаИзменения КАК СуммаИзменения
			|ИЗ
			|	РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
			|ГДЕ
			|	НоминалыЦенныхБумаг.ЦеннаяБумага = &Облигация
			|	И НоминалыЦенныхБумаг.Период >= &Дата
			|
			|УПОРЯДОЧИТЬ ПО
			|	Период";
		
		Запрос.УстановитьПараметр("Дата", Дата);
		Запрос.УстановитьПараметр("Облигация", Облигация);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			
			Возврат Новый Структура("ДатаАмортизации, СуммаАмортизации", ВыборкаДетальныеЗаписи.Период, ВыборкаДетальныеЗаписи.СуммаИзменения);
			
		Иначе
			
			Возврат Новый Структура("ДатаАмортизации, СуммаАмортизации",  Облигация.ДатаПогашения,  Облигация.Номинал);
			
		КонецЕсли;
	
	КонецЕсли; 
	
КонецФункции

