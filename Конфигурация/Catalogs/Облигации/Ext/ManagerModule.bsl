				ПараметрыОценкиБумаг.Вставить("ВидУчета",								Неопределено);
				ПараметрыОценкиБумаг.Вставить("ВариантРасчетаСправедливойСтоимости",	ПараметрыОценки.ВариантРасчетаОценочнойСтоимости);
				ПараметрыОценкиБумаг.Вставить("ПараметрыПолученияПартий",				Неопределено);
				ПараметрыОценкиБумаг.Вставить("Клиент",									ПараметрыОценки.Клиент);
				ПараметрыОценкиБумаг.Вставить("ТолькоНаблюдаемыеЦены",					Истина);
				
				Если РасшифровкаРасчета <> Неопределено Тогда
					РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Получение цен аналогов", , , Истина);
				КонецЕсли;
				
				ТаблицаСтоимостиАналогов = РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС(ПараметрыОценкиБумаг, НачалоДня(ПараметрыДенежногоПотока.ДатаПереоценки), ТаблицаАналогов, , ОшибкаРасчета, РасшифровкаОперации);

				Если ОшибкаРасчета Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						СтрШаблон("Ошибка получения наблюдаемых цен аналогов на %1 для расчета ставки купона '%2'",
							Формат(ПараметрыДенежногоПотока.ДатаПереоценки, "ДФ=dd.MM.yyyy"), Облигация), , , , Отказ);
					Возврат Неопределено;
				КонецЕсли;
				
				Запрос = Новый Запрос(
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	Аналоги.ЦеннаяБумага КАК ЦеннаяБумага,
					|	Аналоги.Рынок КАК Рынок
					|ПОМЕСТИТЬ _Аналоги
					|ИЗ
					|	&Аналоги КАК Аналоги
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ТаблицаСтоимостей.ЦеннаяБумага КАК ЦеннаяБумага,
					|	ТаблицаСтоимостей.Стоимость КАК Цена,
					|	ТаблицаСтоимостей.УровеньОценки КАК УровеньОценки
					|ПОМЕСТИТЬ _ТаблицаСтоимостей
					|ИЗ
					|	&ТаблицаСтоимостей КАК ТаблицаСтоимостей
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_Аналоги.ЦеннаяБумага КАК ЦеннаяБумага,
					|	_ТаблицаСтоимостей.Цена КАК Цена,
					|	КотировкиММВБ.ACCINT КАК Купон,
					|	КотировкиММВБ.YIELDATWAP КАК Доходность
					|ИЗ
					|	_Аналоги КАК _Аналоги
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаСтоимостей КАК _ТаблицаСтоимостей
					|		ПО (_ТаблицаСтоимостей.ЦеннаяБумага = _Аналоги.ЦеннаяБумага)
					|			И (_ТаблицаСтоимостей.УровеньОценки = 1)
					|			И (_ТаблицаСтоимостей.Цена > 0)
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиММВБ
					|		ПО (КотировкиММВБ.ЦеннаяБумага = _Аналоги.ЦеннаяБумага)
					|			И (КотировкиММВБ.ЦеннаяБумага = _Аналоги.ЦеннаяБумага)
					|			И (КотировкиММВБ.Рынок = _Аналоги.Рынок)
					|			И (КотировкиММВБ.Биржа = &ММВБ)
					|			И (КотировкиММВБ.РежимТоргов.ОсновнойРежим)
					|			И (КотировкиММВБ.Период = &ПоследняяДатаТоргов)");
				
				ММВБ						= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
				ОсновнойКалендарьКотировок	= Константы.ОсновнойКалендарьКотировок.Получить();	
				ПоследняяДатаТоргов			= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(ОсновнойКалендарьКотировок, НачалоДня(ПараметрыДенежногоПотока.ДатаПереоценки));
				
				Запрос.УстановитьПараметр("ММВБ",					ММВБ);
				Запрос.УстановитьПараметр("ПоследняяДатаТоргов",	ПоследняяДатаТоргов);
				
				Запрос.УстановитьПараметр("Аналоги",			ТаблицаАналогов);
				Запрос.УстановитьПараметр("ТаблицаСтоимостей",	ТаблицаСтоимостиАналогов);
				
				АналогиСЦенойАктивногоРынка = Запрос.Выполнить().Выгрузить();
				
				Для Каждого СтрокаАналога Из АналогиСЦенойАктивногоРынка Цикл
					СтрокаАналога.Купон = ПолучитьКупон(СтрокаАналога.ЦеннаяБумага, ПараметрыДенежногоПотока.ДатаПереоценки, ПараметрыОценки.СчетДоверительногоУправления);		
				КонецЦикла;
				
				Если РасшифровкаРасчета <> Неопределено Тогда
					РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "АналогиСЦенойАктивногоРынка", АналогиСЦенойАктивногоРынка, "Аналоги с ценой активного рынка");
				КонецЕсли;
				
				ПараметрыПрогноза.Вставить("АналогиСЦенойАктивногоРынка", АналогиСЦенойАктивногоРынка);
				
			КонецЕсли;
				
			#КонецОбласти

		КонецЕсли;
		
		КоличествоАналогов = ПараметрыПрогноза.АналогиСЦенойАктивногоРынка.Количество();
		
		Если КоличествоАналогов = 0 Тогда
			
			Если ПрерыватьРасчетПриОшибке Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Для '%1' нет аналогичных бумаг того же эмитента с ценой активного рынка. Расчет прогнозных значений ставок будущих купонов по аналогам прерван.", 
							Облигация),
					Облигация,
					,
					,
					Отказ);
			Иначе
				Отказ = Истина;
			КонецЕсли;
						
		Иначе
			
			Если Не ПараметрыПрогноза.Свойство("ПараметрыРасчетаСтавкиПоЦенеИДоходностиАналогичныхОблигаций") Тогда
				
				#Область Расчет_стоимости_и_доходности_аналогов_и_дисконтирование_потоков_по_ним
				
				СтоимостьАналогов	= (ПараметрыПрогноза.АналогиСЦенойАктивногоРынка.Итог("Цена") + ПараметрыПрогноза.АналогиСЦенойАктивногоРынка.Итог("Купон")) / КоличествоАналогов;		
				ДоходностьАналогов	= ПараметрыПрогноза.АналогиСЦенойАктивногоРынка.Итог("Доходность") / КоличествоАналогов;		
				
				ПараметрыГрафикаПотоков = РаботаСКоллекциями.СкопироватьСтруктуру(ПараметрыДенежногоПотока);
				ПараметрыГрафикаПотоков.Вставить("РассчитыватьПрогнозныеЗначения",	Ложь);
				ПараметрыГрафикаПотоков.Вставить("ДоДатыПогашения",					Истина);
				ПараметрыГрафикаПотоков.Вставить("ОбъединятьПотокиПоПериоду",		Ложь);
				
				ГрафикПотоков = ПолучитьДенежныйПоток(Облигация, ПараметрыГрафикаПотоков);
				
				// Получаем и дисконтируем известные потоки
				
				Если РасшифровкаРасчета <> Неопределено Тогда
					РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Дисконтирование известных потоков", , , Истина);
				КонецЕсли;
				
				ИзвестныеПотоки = ГрафикПотоков.Скопировать(Новый Структура("ИзвестныйПоток", Истина));
				
				// Известные потоки могут понадобиться далее
				ПараметрыДенежногоПотока.Вставить("ИзвестныеПотоки", ИзвестныеПотоки);
				
				ДисконтированнаяСтоимостьИзвестныхПотоков = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(
					ИзвестныеПотоки, ДоходностьАналогов, ПараметрыДенежногоПотока.ДатаПереоценки, , , РасшифровкаОперации);  
					
				// Суммы неизвестных потоков считаем по ставке купона 1%, а затем дисконтируем
				
				Если РасшифровкаРасчета <> Неопределено Тогда
					РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Дисконтирование неизвестных потоков", , , Истина);
				КонецЕсли;
				
				НеизвестныеПотоки = ГрафикПотоков.Скопировать(Новый Структура("ИзвестныйПоток", Ложь));
				
				Если НеизвестныеПотоки.Найти(Ложь, "Купон") <> Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						СтрШаблон("Оценка неизвестного потока в погашение основного долга не реализована. Расчет прогнозных значений ставок будущих купонов '%1' прерван.", Облигация), , , , Отказ);
					Возврат Неопределено;
				КонецЕсли;
				
				Для Каждого СтрокаПотока Из НеизвестныеПотоки Цикл
					СтрокаПотока.Поток = ПолучитьНоминал(Облигация, СтрокаПотока.ДатаНачалаКупона) * 1 / 100 * (СтрокаПотока.Дата - СтрокаПотока.ДатаНачалаКупона) / (60 * 60 * 24) / 365;
				КонецЦикла;
					
				ДисконтированнаяСтоимостьНеизвестныхПотоков = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(
					НеизвестныеПотоки, ДоходностьАналогов, ПараметрыДенежногоПотока.ДатаПереоценки, , , РасшифровкаОперации);  
					
				// Запоминаем параметры расчета ставки
				
				ПараметрыРасчетаСтавки = Новый Структура;
				ПараметрыРасчетаСтавки.Вставить("ДоходностьАналогов",							ДоходностьАналогов);
				ПараметрыРасчетаСтавки.Вставить("СтоимостьАналогов",							СтоимостьАналогов);
				ПараметрыРасчетаСтавки.Вставить("ДисконтированнаяСтоимостьИзвестныхПотоков",	ДисконтированнаяСтоимостьИзвестныхПотоков);
				ПараметрыРасчетаСтавки.Вставить("ДисконтированнаяСтоимостьНеизвестныхПотоков",	ДисконтированнаяСтоимостьНеизвестныхПотоков);
					
				ПараметрыПрогноза.Вставить("ПараметрыРасчетаСтавкиПоЦенеИДоходностиАналогичныхОблигаций", ПараметрыРасчетаСтавки);	
					
				#КонецОбласти
					
			КонецЕсли;		
			
			ПараметрыРасчетаСтавки = ПараметрыПрогноза.ПараметрыРасчетаСтавкиПоЦенеИДоходностиАналогичныхОблигаций;
					
			// Рассчитываем прогнозную ставку	
			
			ПрогнознаяСтавкаДоОкругления = (ПараметрыРасчетаСтавки.СтоимостьАналогов - ПараметрыРасчетаСтавки.ДисконтированнаяСтоимостьИзвестныхПотоков) / ПараметрыРасчетаСтавки.ДисконтированнаяСтоимостьНеизвестныхПотоков;	
			ПрогнознаяСтавка			 = Окр(ПрогнознаяСтавкаДоОкругления, 2);
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				
				РезультатРасчета = Новый Структура;
				РезультатРасчета.Вставить("СпособРасчета",									"По цене равной цене, дающей доходность по аналогичным облигациям");
				РезультатРасчета.Вставить("ДоходностьАналогов",								ПараметрыРасчетаСтавки.ДоходностьАналогов);
				РезультатРасчета.Вставить("СтоимостьАналогов",								ПараметрыРасчетаСтавки.СтоимостьАналогов);
				РезультатРасчета.Вставить("ДисконтированнаяСтоимостьИзвестныхПотоков",		ПараметрыРасчетаСтавки.ДисконтированнаяСтоимостьИзвестныхПотоков);
				РезультатРасчета.Вставить("ДисконтированнаяСтоимостьНеизвестныхПотоков",	ПараметрыРасчетаСтавки.ДисконтированнаяСтоимостьНеизвестныхПотоков);
				РезультатРасчета.Вставить("ПрогнознаяСтавкаДоОкругления",					ПрогнознаяСтавкаДоОкругления);
				РезультатРасчета.Вставить("ПрогнознаяСтавка",								ПрогнознаяСтавка);
				
				РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "РезультатРасчета", РезультатРасчета, "Результат расчета");
				
			КонецЕсли;
			
		КонецЕсли;
		
		#КонецОбласти
		
	ИначеЕсли СпособРасчетаПрогнозныхСтавок = "ПоПодходуСохраненияКредитногоСпреда"	Тогда
		
		ОшибкаРасчета = Ложь;
		
		#Область По_подходу_сохранения_кредитного_спреда
		
		//1.4.1.	Если цена активного рынка по данной облигации могла быть определена не более чем 1 (один) месяц назад, 
		//			то на каждый день с определяемой ценой рассчитывается разница ставок между доходностью 
		//			к погашению по данной облигации и ставкой в G-кривой по ОФЗ на срок, равный дюрации облигации. 
		//			Спред определяется как среднее значение между этими разницами. Для расчета величины неизвестных купонов 
		//			цена принимается равной цене, дающей доходность, равную (r+Spread) на дату оценки, где:
		//				r	 – ставка кривой бескупонной доходности рынка ОФЗ (G-кривая), 
		//				Spread – средний спред.
		//1.4.2.	Если цена активного рынка облигации не могла быть определена не более чем 1 месяц назад, 
		//			то в качестве кредитного спреда принимается усредненный кредитный спред за один месяц 
		//			не более чем по трем другим облигациям того же эмитента (имеющим цены активного рынка в течение последнего месяца) с наиболее близкими к оцениваемому дюрациями. 
		//			Кредитный спред рассчитывается аналогично п. 1.4.1.
		//1.4.3.	Если эмитент не имеет других облигаций, имеющих цену активного рынка в течение предыдущего месяца, 
		//			то для оценки неизвестных купонов применяется подход «эшелонов» кредитного риска по рейтингу эмитента. 
		//			Доходность принимается равной доходности по соответствующему индексу облигаций, 
		//			соответствующему рейтинговой группе, к которой относится оцениваемая облигация.
		
		// Пока используется только у Транснефти
		// Если такие облигации появятся у других клиентов СДК Гарант, потребуется доработать		
		Если ПараметрыОценки.ВариантРасчетаОценочнойСтоимости <> Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2020 Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Для методики %1 расчет прогнозной ставки купона по подходу сохранения кредитного спреда не реализован", 
																	ПараметрыОценки.ВариантРасчетаОценочнойСтоимости),
											                  ,
															  ,
															  ,
															  ОшибкаРасчета);
															  
			Возврат Неопределено;
			
		КонецЕсли;
			
		// Проверяем цены активного рынка за месяц
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		ПоместитьЦеныАктивногоРынкаОблигацийЗаПериодВМенеджерВременныхТаблиц(
				МенеджерВременныхТаблиц,
				Облигация,
				ПараметрыОценки,
				НачалоДня(ДобавитьМесяц(ПараметрыДенежногоПотока.ДатаПереоценки, -1)),
				НачалоДня(ПараметрыДенежногоПотока.ДатаПереоценки) - 1);
				
		ЦеныАктивногоРынка = МенеджерВременныхТаблиц.Таблицы["_ЦеныАктивногоРынка"].ПолучитьДанные().Выгрузить();
		
		КоличествоЦенАктивногоРынка = ЦеныАктивногоРынка.Количество(); 
		Если КоличествоЦенАктивногоРынка > 0 Тогда
			
			#Область Расчет_спреда_по_ценам_активного_рынка_облигации_за_месяц
			
			Если РасшифровкаРасчета <> Неопределено Тогда 
				РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расчет ставки неизвестных купонов по известным ценам активного рынка этой облигации за последний месяц", , , Истина);
			КонецЕсли;
			
			СреднийСпред = 0;
			Для Каждого СтрокаЦены Из ЦеныАктивногоРынка Цикл
				
				СреднийСпред = СреднийСпред + РассчитатьСпредДоходностиКПогашениюОблигации(
												Облигация,
												Новый Структура("Доходность, Дюрация", СтрокаЦены.Доходность, СтрокаЦены.Дюрация),
												СтрокаЦены.Период,
												ПараметрыОценки,
												ОшибкаРасчета); 
				
				Если ОшибкаРасчета Тогда
					Возврат Неопределено;
				КонецЕсли;
				
			КонецЦикла;			
			
			СреднийСпред = СреднийСпред / КоличествоЦенАктивногоРынка;
			
			#КонецОбласти
						
			ДатаИЦенаВыкупа = ПолучитьДатуИЦенуВыкупа(Облигация, ПараметрыДенежногоПотока.ДатаПереоценки,, ПараметрыОценки.СчетДоверительногоУправления);
			
			СрокДоПогашения = (ДатаИЦенаВыкупа.ДатаВыкупа - НачалоДня(ПараметрыДенежногоПотока.ДатаПереоценки)) / (24 * 60 * 60) / 365;
			
			ЗначениеКБД = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьЗначениеКривойБескупоннойДоходности(ПараметрыДенежногоПотока.ДатаПереоценки, СрокДоПогашения, , ОшибкаРасчета); 
			
			Если ОшибкаРасчета Тогда
				Возврат Неопределено;
			КонецЕсли;			
			
			СтавкаКупона = РассчитатьСтавкуКупонаПоПоследнейИзвестнойЦенеИСтавкеДоходности(
							РеквизитыОблигации,
							ЗначениеКБД + СреднийСпред,
							ПараметрыОценки,
							ПараметрыДенежногоПотока,
							ПараметрыКупона,
							ОшибкаРасчета,
							РасшифровкаОперации);
							
			Если РасшифровкаРасчета <> Неопределено Тогда
				РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, ,, Новый Структура("СтавкаКупона", СтавкаКупона), Истина);
			КонецЕсли; 
				
			Возврат СтавкаКупона;
				
		Иначе
			
			#Область Цены_активного_рынка_облигаций_того_же_эмитента_за_месяц
			
			// Проверяем, есть ли облигации (не более трех) того же эмитента с близкой дюрацией
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			
			ПоместитьЦеныАктивногоРынкаОблигацийЗаПериодВМенеджерВременныхТаблиц(
					Запрос.МенеджерВременныхТаблиц,
					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Облигация, "Эмитент"),
					ПараметрыОценки,
					НачалоДня(ДобавитьМесяц(ПараметрыДенежногоПотока.ДатаПереоценки, -1)),
					НачалоДня(ПараметрыДенежногоПотока.ДатаПереоценки));
					
			// У кандидатов для расчета дюрация должна быть почти одинаковой (допускаем разницу в 10 дней)
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	КотировкиТорговыхПлощадок.ЦеннаяБумага КАК ЦеннаяБумага,
				|	КотировкиТорговыхПлощадок.DURATION КАК Дюрация,
				|	КотировкиТорговыхПлощадок.YIELDATWAP КАК Доходность
				|ПОМЕСТИТЬ _ОцениваемаяОблигация
				|ИЗ
				|	РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
				|ГДЕ
				|	КотировкиТорговыхПлощадок.Период = &Период
				|	И КотировкиТорговыхПлощадок.ЦеннаяБумага = &Облигация
				|	И КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 3
				|	_ДругиеЦенныеБумагиЭмитента.ЦеннаяБумага КАК ЦеннаяБумага,
				|	ВЫБОР
				|		КОГДА _ДругиеЦенныеБумагиЭмитента.Дюрация >= _ОцениваемаяОблигация.Дюрация
				|			ТОГДА _ДругиеЦенныеБумагиЭмитента.Дюрация - _ОцениваемаяОблигация.Дюрация
				|		ИНАЧЕ _ОцениваемаяОблигация.Дюрация - _ДругиеЦенныеБумагиЭмитента.Дюрация
				|	КОНЕЦ КАК ОтклонениеДюраций
				|ПОМЕСТИТЬ _КандидатыДляРасчета
				|ИЗ
				|	_ЦеныАктивногоРынка КАК _ДругиеЦенныеБумагиЭмитента
				|		ЛЕВОЕ СОЕДИНЕНИЕ _ОцениваемаяОблигация КАК _ОцениваемаяОблигация
				|		ПО (ИСТИНА)
				|ГДЕ
				|	_ДругиеЦенныеБумагиЭмитента.ЦеннаяБумага <> &Облигация
				|
				|УПОРЯДОЧИТЬ ПО
				|	ВЫБОР
				|		КОГДА _ДругиеЦенныеБумагиЭмитента.Дюрация >= _ОцениваемаяОблигация.Дюрация
				|			ТОГДА _ДругиеЦенныеБумагиЭмитента.Дюрация - _ОцениваемаяОблигация.Дюрация
				|		ИНАЧЕ _ОцениваемаяОблигация.Дюрация - _ДругиеЦенныеБумагиЭмитента.Дюрация
				|	КОНЕЦ
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	_КандидатыДляРасчета.ЦеннаяБумага КАК ЦеннаяБумага,
				|	МИНИМУМ(_КандидатыДляРасчета.ОтклонениеДюраций) КАК ОтклонениеДюраций
				|ПОМЕСТИТЬ _КандидатДляРасчетаСНаиболееБлизкойДюрацией
				|ИЗ
				|	_КандидатыДляРасчета КАК _КандидатыДляРасчета
				|
				|СГРУППИРОВАТЬ ПО
				|	_КандидатыДляРасчета.ЦеннаяБумага
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ЦеныАктивногоРынка.ЦеннаяБумага КАК ЦеннаяБумага,
				|	_ЦеныАктивногоРынка.Период КАК Период,
				|	_ЦеныАктивногоРынка.Цена КАК Цена,
				|	_ЦеныАктивногоРынка.ЦенаКупона КАК ЦенаКупона,
				|	_ЦеныАктивногоРынка.Доходность КАК Доходность,
				|	_ЦеныАктивногоРынка.Дюрация КАК Дюрация,
				|	_КандидатыДляРасчетаСПодходящейДюрацией.ОтклонениеДюраций КАК ОтклонениеДюраций
				|ИЗ
				|	_ЦеныАктивногоРынка КАК _ЦеныАктивногоРынка
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				|			_КандидатыДляРасчета.ЦеннаяБумага КАК ЦеннаяБумага,
				|			_КандидатыДляРасчета.ОтклонениеДюраций КАК ОтклонениеДюраций
				|		ИЗ
				|			_КандидатыДляРасчета КАК _КандидатыДляРасчета
				|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КандидатДляРасчетаСНаиболееБлизкойДюрацией КАК _КандидатДляРасчетаСНаиболееБлизкойДюрацией
				|				ПО (_КандидатыДляРасчета.ОтклонениеДюраций - _КандидатДляРасчетаСНаиболееБлизкойДюрацией.ОтклонениеДюраций <= 10)) КАК _КандидатыДляРасчетаСПодходящейДюрацией
				|		ПО _ЦеныАктивногоРынка.ЦеннаяБумага = _КандидатыДляРасчетаСПодходящейДюрацией.ЦеннаяБумага
				|ИТОГИ ПО
				|	ЦеннаяБумага";
			
			Запрос.УстановитьПараметр("Период",		НачалоДня(ПараметрыДенежногоПотока.ДатаПереоценки));
			Запрос.УстановитьПараметр("Облигация",	Облигация); 
			
			РезультатЗапроса = Запрос.Выполнить();
			КоличествоОблигацийДляРасчета = Запрос.МенеджерВременныхТаблиц.Таблицы["_КандидатыДляРасчета"].ПолучитьДанные().Выбрать().Количество();
			
			#КонецОбласти
			
			Если КоличествоОблигацийДляРасчета >= 1 Тогда
				
				#Область Расчет_спреда_по_ценам_активного_рынка_облигаций_того_же_эмитента_за_месяц
				
				Если РасшифровкаРасчета <> Неопределено Тогда 
					РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расчет ставки неизвестных купонов по ценам активного рынка облигаций того же эмитента за последний месяц", , , Истина);
				КонецЕсли;
			
				// усредненный кредитный спред за один месяц по этим облигациям
				ВыборкаЦенныеБумаги 	= РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				УсредненныйСпред = 0;
				Пока ВыборкаЦенныеБумаги.Следующий() Цикл
					
					ВыборкаДетальныеЗаписи 	= ВыборкаЦенныеБумаги.Выбрать(); 
					СуммаСпредов = 0;
					Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
						СуммаСпредов = СуммаСпредов + РассчитатьСпредДоходностиКПогашениюОблигации(
															ВыборкаДетальныеЗаписи.ЦеннаяБумага,
															Новый Структура("Доходность, Дюрация", ВыборкаДетальныеЗаписи.Доходность, ВыборкаДетальныеЗаписи.Дюрация),
															ВыборкаДетальныеЗаписи.Период,
															ПараметрыОценки,
															ОшибкаРасчета); 
						
						Если ОшибкаРасчета Тогда
							Возврат Неопределено;
						КонецЕсли;

					КонецЦикла;
					
					УсредненныйСпред = УсредненныйСпред + СуммаСпредов / ВыборкаДетальныеЗаписи.Количество();
					
				КонецЦикла;
				
				УсредненныйСпред = УсредненныйСпред / КоличествоОблигацийДляРасчета;
				
				ДатаИЦенаВыкупа = ПолучитьДатуИЦенуВыкупа(Облигация, ПараметрыДенежногоПотока.ДатаПереоценки,, ПараметрыОценки.СчетДоверительногоУправления);
			
				СрокДоПогашения = (ДатаИЦенаВыкупа.ДатаВыкупа - НачалоДня(ПараметрыДенежногоПотока.ДатаПереоценки)) / (24 * 60 * 60) / 365;
				
				ЗначениеКБД = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьЗначениеКривойБескупоннойДоходности(ПараметрыДенежногоПотока.ДатаПереоценки, СрокДоПогашения, , ОшибкаРасчета); 
				
				Если ОшибкаРасчета Тогда
					Возврат Неопределено;
				КонецЕсли;			
				
				СтавкаКупона = РассчитатьСтавкуКупонаПоПоследнейИзвестнойЦенеИСтавкеДоходности(
								РеквизитыОблигации,
								ЗначениеКБД + УсредненныйСпред,
								ПараметрыОценки,
								ПараметрыДенежногоПотока,
								ПараметрыКупона,
								ОшибкаРасчета,
								РасшифровкаОперации);
								
				Если РасшифровкаРасчета <> Неопределено Тогда
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, ,, Новый Структура("СтавкаКупона", СтавкаКупона), Истина);
				КонецЕсли; 
				
				Возврат СтавкаКупона;
				
				#КонецОбласти
			
			Иначе 
				
				#Область Расчет_по_доходности_индекса
				
				Если РасшифровкаРасчета <> Неопределено Тогда
					РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расчет ставки неизвестных купонов по доходности индекса", , , Истина);					
				КонецЕсли;
				
				// Доходность принимается равной доходности по соответствующему индексу облигаций, 
				// соответствующему рейтинговой группе, к которой относится оцениваемая облигация
				ПараметрыОценки.Вставить("ВариантРасчетаСправедливойСтоимости", ПараметрыОценки.ВариантРасчетаОценочнойСтоимости);
				ПараметрыРасчетаРейтинга = РаботаСПереоценкой.ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ПараметрыДенежногоПотока.ДатаПереоценки, ОшибкаРасчета);
				РейтинговаяГруппа = РаботаСПоказателямиФинансовыхИнструментов.ОпределитьРейтинговуюГруппу(Облигация, ПараметрыДенежногоПотока.ДатаПереоценки, ПараметрыРасчетаРейтинга,, РасшифровкаРасчета);		
				Биржа_ММВБ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"); 
				
				БиржевойИндекс = "";
				Если РейтинговаяГруппа = 1 Тогда
					БиржевойИндекс = "RUCBCP3A3YNS";
				ИначеЕсли РейтинговаяГруппа = 2 Тогда
					БиржевойИндекс = "RUCBCPAA3YNS";
				ИначеЕсли РейтинговаяГруппа = 3 Тогда
					БиржевойИндекс = "RUCBCPA3YNS";
				ИначеЕсли РейтинговаяГруппа = 4 Тогда
					БиржевойИндекс = "RUCBCPBBBNS"
				ИначеЕсли РейтинговаяГруппа = 5 Тогда
					
					// Определяем котировальный уровень
					Запрос = Новый Запрос(
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
						|	КотировкиТорговыхПлощадок.LISTNAME КАК КотировальныйУровень
						|ИЗ
						|	РегистрСведений.КотировкиТорговыхПлощадок.СрезПоследних(
						|			&Период,
						|			ЦеннаяБумага = &ЦеннаяБумага
						|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
						|				И Биржа = &Биржа_ММВБ
						|				И РежимТоргов.ОсновнойРежим) КАК КотировкиТорговыхПлощадок");
					
					Запрос.УстановитьПараметр("ЦеннаяБумага",	Облигация);
					Запрос.УстановитьПараметр("Период",			НачалоДня(ПараметрыДенежногоПотока.ДатаПереоценки));
					Запрос.УстановитьПараметр("Биржа_ММВБ",		Биржа_ММВБ);
					
					Выборка = Запрос.Выполнить().Выбрать();
					
					Если Выборка.Следующий() Тогда
						
						Если Выборка.КотировальныйУровень = 2 Тогда
							БиржевойИндекс = "RUCBICPL2"; 
						ИначеЕсли Выборка.КотировальныйУровень = 3 Тогда
							БиржевойИндекс = "RUCBICPL3"; 
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если ПустаяСтрока(БиржевойИндекс) Тогда
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
							СтрШаблон("Для облигации %1 с рейтинговой группой %2 не удалось определить соответствующий биржевой индекс",
									Облигация, РаботаСоСтрокамиКлиентСервер.ПреобразоватьЧислоВРимскуюНотацию(РейтинговаяГруппа, Ложь)),
							,
							,
							,ОшибкаРасчета);
							
					Возврат Неопределено;
					
				КонецЕсли;
				
				// Получаем значение индекса
				Запрос = Новый Запрос(
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЗначенияБиржевыхИндексов.YIELD КАК Доходность
					|ИЗ
					|	РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
					|ГДЕ
					|	ЗначенияБиржевыхИндексов.Период = &ПоследнийТорговыйДень
					|	И ЗначенияБиржевыхИндексов.Биржа = &Биржа_ММВБ
					|	И ЗначенияБиржевыхИндексов.БиржевойИндекс.Код = &БиржевойИндекс");
							
				Запрос.УстановитьПараметр("ПоследнийТорговыйДень", 
						Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(), ПараметрыДенежногоПотока.ДатаПереоценки));
						
				Запрос.УстановитьПараметр("Биржа_ММВБ",		Биржа_ММВБ);
				Запрос.УстановитьПараметр("БиржевойИндекс",	БиржевойИндекс);
				
				Выборка = Запрос.Выполнить().Выбрать();
							
				Если Выборка.Следующий() Тогда
					ДоходностьИндекса = Выборка.Доходность;
				Иначе 
					Возврат Неопределено;
				КонецЕсли;
				
				// По полученной доходности индекса и последней цене нужно рассчитать ставку купона
				СтавкаКупона = РассчитатьСтавкуКупонаПоПоследнейИзвестнойЦенеИСтавкеДоходности(
								РеквизитыОблигации,
								ДоходностьИндекса,
								ПараметрыОценки,
								ПараметрыДенежногоПотока,
								ПараметрыКупона,
								ОшибкаРасчета,
								РасшифровкаОперации); 
								
				Если РасшифровкаРасчета <> Неопределено Тогда
					РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, ,, Новый Структура("СтавкаКупона", СтавкаКупона), Истина);
				КонецЕсли; 
				
				Возврат СтавкаКупона;
				
				#КонецОбласти
				
			КонецЕсли;
						
		КонецЕсли;
		
		#КонецОбласти                                                                                                                     
				
	ИначеЕсли СпособРасчетаПрогнозныхСтавок = "ОтСтавкиПредыдущегоКупона" Тогда
		
		#Область От_ставки_предыдущего_купона
		
		ПрогнознаяСтавка = ПараметрыПрогноза.СтавкаПредыдущегоКупона;	
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			
			РезультатРасчета = Новый Структура;
			РезультатРасчета.Вставить("СпособРасчета",				"От ставки предыдущего купона");
			РезультатРасчета.Вставить("СтавкаПредыдущегоКупона",	ПараметрыПрогноза.СтавкаПредыдущегоКупона);
			РезультатРасчета.Вставить("ПрогнознаяСтавка",			ПрогнознаяСтавка);
			
			РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "РезультатРасчета", РезультатРасчета, "Результат расчета");
			
		КонецЕсли;			
		
		#КонецОбласти
		
	ИначеЕсли ПрогнознаяСтавка = Неопределено Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Расчет прогнозных значений ставок будущих купонов для '%1' не реализован", Облигация), Облигация, , , Отказ);
		
	КонецЕсли;	
	
	Возврат ПрогнознаяСтавка;	
	
КонецФункции

Функция РассчитатьСтавкуКупонаПоПоследнейИзвестнойЦенеИСтавкеДоходности(РеквизитыОблигации, СтавкаДоходности, ПараметрыОценки, ПараметрыДенежногоПотока, ПараметрыКупона, ОшибкаРасчета, РасшифровкаРасчета = Неопределено)
	
	Облигация = РеквизитыОблигации.Облигация;
	
	// Получаем последнюю цену
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СтоимостьПереоценки.Период КАК Период,
		|	СтоимостьПереоценки.Цена + СтоимостьПереоценки.ЦенаКупона КАК Цена
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|ГДЕ
		|	СтоимостьПереоценки.Период <= &ПредыдущийРабочийДень
		|	И СтоимостьПереоценки.Организация = &Организация
		|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьПереоценки.ЦельРасчета В (ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении), ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.КонтрольИнвестиционнойДекларации))
		|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
		|	И СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|	И СтоимостьПереоценки.ЦеннаяБумага = &ЦеннаяБумага
		|
		|УПОРЯДОЧИТЬ ПО
		|	СтоимостьПереоценки.Период УБЫВ");
	
	ПредыдущийРабочийДень = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ПараметрыДенежногоПотока.ДатаПереоценки, -2); 
	
	Запрос.УстановитьПараметр("ПредыдущийРабочийДень",			ПредыдущийРабочийДень);					
	Запрос.УстановитьПараметр("Организация",					ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ПараметрыОценки.СчетДоверительногоУправления); 
	Запрос.УстановитьПараметр("ЦеннаяБумага",					Облигация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ПоследняяЦена = Выборка.Цена;
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(
										РасшифровкаРасчета,
										"Последняя известная цена",
										,
										Новый Структура("Облигация, Дата, Цена", Облигация, Формат(Выборка.Период, "ДФ=dd.MM.yyyy"), ПоследняяЦена),
										Истина);		
		КонецЕсли;
	
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Для облигации %1 не зарегистрирована цена на дату %2 по счету ДУ %3",
				Облигация,
				Формат(ПредыдущийРабочийДень, "ДФ=dd.MM.yyyy"),
				ПараметрыОценки.СчетДоверительногоУправления),
			,
			,
			,
			ОшибкаРасчета);
				
		Возврат Неопределено;
		
	КонецЕсли;                                                                                                                                        
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, "Дисконтирование денежных потоков по рассчитанной ставке", , , Истина);
	КонецЕсли;	
	
	ПараметрыГрафикаПотоков = РаботаСКоллекциями.СкопироватьСтруктуру(ПараметрыДенежногоПотока);
	ПараметрыГрафикаПотоков.Вставить("РассчитыватьПрогнозныеЗначения",	Ложь);
	ПараметрыГрафикаПотоков.Вставить("ДоДатыПогашения",					Истина);
	ПараметрыГрафикаПотоков.Вставить("ОбъединятьПотокиПоПериоду",		Ложь);
	
	ГрафикПотоков = ПолучитьДенежныйПоток(Облигация, ПараметрыГрафикаПотоков);
	
	ИзвестныеПотоки = ГрафикПотоков.Скопировать(Новый Структура("ИзвестныйПоток", Истина));
		
	// Дисконтируем известные потоки по ставке доходности 
	ДисконтированнаяСтоимостьИзвестныхПотоков = 0;
	
	Если РасшифровкаОперации <> Неопределено Тогда		
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, , "Ставка дисконтирования", Новый Структура("Ставка", СтавкаДоходности));
	КонецЕсли;
		
	Если ИзвестныеПотоки.Количество() > 0 Тогда
		
		Если РасшифровкаОперации <> Неопределено Тогда
			РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, "Дисконтирование известных потоков", , , Истина);			
		КонецЕсли;
	    
		ДисконтированнаяСтоимостьИзвестныхПотоков = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(
							ИзвестныеПотоки,
							СтавкаДоходности,
							ПараметрыДенежногоПотока.ДатаПереоценки,
							ПараметрыОценки,
							ОшибкаРасчета,
							РасшифровкаОперации);
							
	КонецЕсли;						
						     							
	ДисконтированнаяСтоимостьНеизвестныхКупонов = ПоследняяЦена - ДисконтированнаяСтоимостьИзвестныхПотоков;
		
	НеизвестныеКупоны = ГрафикПотоков.Скопировать(Новый Структура("ИзвестныйПоток, Купон", Ложь, Истина));
	Для Каждого СтрокаКупона Из НеизвестныеКупоны Цикл
		
		СтрокаКупона.Поток = РаботаСЦеннымиБумагами.РассчитатьКупон(РеквизитыОблигации.БазаРасчета, СтрокаКупона.ДатаНачалаКупона, СтрокаКупона.Дата, ПараметрыКупона.Номинал, 1);
		
	КонецЦикла;
	
	Если РасшифровкаОперации <> Неопределено Тогда
		РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаОперации, "Дисконтирование неизвестных потоков", , , Истина);			
	КонецЕсли;
		
	ДисконтированнаяСтоимостьПотоковКупона = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(
							НеизвестныеКупоны,
							СтавкаДоходности,
							ПараметрыДенежногоПотока.ДатаПереоценки,
							ПараметрыОценки,
							ОшибкаРасчета,
							РасшифровкаОперации);
							
	Возврат Окр(ДисконтированнаяСтоимостьНеизвестныхКупонов / ДисконтированнаяСтоимостьПотоковКупона, 2, 1);
	
КонецФункции

Процедура ПоместитьЦеныАктивногоРынкаОблигацийЗаПериодВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц, ОблигацияИлиЭмитент, ПараметрыОценки, НачалоПериода, КонецПериода)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.Период КАК Период,
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтоимостьПереоценки.Цена КАК Цена,
		|	СтоимостьПереоценки.ЦенаКупона КАК ЦенаКупона,
		|	СтоимостьПереоценки.ЦеннаяБумага.Тип КАК ТипОблигации
		|ПОМЕСТИТЬ _ОблигацииСАктивнымРынком
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|ГДЕ
		|	СтоимостьПереоценки.Организация = &Организация
		|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьПереоценки.ЦельРасчета В (ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении), ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.КонтрольИнвестиционнойДекларации))
		|	И СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|	И &УсловиеСубъекта
		|	И СтоимостьПереоценки.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
		|	И СтоимостьПереоценки.УровеньОценки = 1
		|	И СтоимостьПереоценки.Цена > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ОблигацииСАктивнымРынком.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ОблигацииСАктивнымРынком.Период КАК Период,
		|	_ОблигацииСАктивнымРынком.Цена КАК Цена,
		|	_ОблигацииСАктивнымРынком.ЦенаКупона КАК ЦенаКупона,
		|	КотировкиТорговыхПлощадок.DURATION КАК Дюрация,
		|	КотировкиТорговыхПлощадок.YIELDATWAP КАК Доходность
		|ПОМЕСТИТЬ _ЦеныАктивногоРынка
		|ИЗ
		|	РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ОблигацииСАктивнымРынком КАК _ОблигацииСАктивнымРынком
		|		ПО КотировкиТорговыхПлощадок.ЦеннаяБумага = _ОблигацииСАктивнымРынком.ЦеннаяБумага
		|			И КотировкиТорговыхПлощадок.Период = _ОблигацииСАктивнымРынком.Период
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|ГДЕ
		|	КотировкиТорговыхПлощадок.DURATION <> 0");
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Если ТипЗнч(ОблигацияИлиЭмитент) = Тип("СправочникСсылка.Облигации") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСубъекта", "СтоимостьПереоценки.ЦеннаяБумага = &Субъект");
	ИначеЕсли ТипЗнч(ОблигацияИлиЭмитент) = Тип("СправочникСсылка.Эмитенты") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСубъекта", "ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Облигации).Эмитент = &Субъект");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НачалоПериода",					НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",					КонецПериода);
	Запрос.УстановитьПараметр("Организация",					ПараметрыОценки.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ПараметрыОценки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Субъект",						ОблигацияИлиЭмитент);
	
	Запрос.Выполнить();
	
КонецПроцедуры	

Функция РассчитатьСпредДоходностиКПогашениюОблигации(Облигация, ДоходностьИДюрацияИзКотировок, ДатаПереоценки, ПараметрыОценки, ОшибкаРасчета)
		
	Если ПараметрыОценки.Свойство("ТочностьДюрации") Тогда
		ДоходностьИДюрацияИзКотировок.Дюрация = Окр(ДоходностьИДюрацияИзКотировок.Дюрация, ПараметрыОценки.ТочностьДюрации); 		
	КонецЕсли;
	
	ЗначениеКБД = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьЗначениеКривойБескупоннойДоходности(ДатаПереоценки, ДоходностьИДюрацияИзКотировок.Дюрация / 365, , ОшибкаРасчета); 
	
	СпредДоходности = Неопределено;
	
	Если Не ОшибкаРасчета Тогда
		
		Если ПараметрыОценки.Свойство("ТочностьДоходностиКПогашению") Тогда
			ДоходностьИДюрацияИзКотировок.Доходность = Окр(ДоходностьИДюрацияИзКотировок.Доходность, ПараметрыОценки.ТочностьДоходностиКПогашению); 		
		КонецЕсли;
		
		Если ПараметрыОценки.Свойство("ТочностьКБД") Тогда
			ЗначениеКБД = Окр(ЗначениеКБД, ПараметрыОценки.ТочностьКБД); 		
		КонецЕсли;
		
		СпредДоходности = ДоходностьИДюрацияИзКотировок.Доходность - ЗначениеКБД;
		Если СпредДоходности < 0 Тогда
			СпредДоходности = -СпредДоходности;
		КонецЕсли;
				 
	КонецЕсли;
	
	Возврат СпредДоходности;
	
КонецФункции

#КонецОбласти

#КонецЕсли
