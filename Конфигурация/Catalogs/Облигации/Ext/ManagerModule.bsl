Функция ПолучитьОфертыЗаПериод(Облигация, НачалоПериода, ОкончаниеПериода) Экспорт

	// Если мы купили в день оферты или в день окончания акцепта по оферте то мы на оферту гарантированно не попадаем
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	УсловияОферт.ДатаВыкупа КАК Дата,
		|	УсловияОферт.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.УсловияОферт КАК УсловияОферт
		|ГДЕ
		|	УсловияОферт.Облигация = &Облигация
		|	И УсловияОферт.ДатаВыкупа МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И НЕ УсловияОферт.ТолькоДляФизическихЛиц
		|	И (УсловияОферт.АкцептПо = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ИЛИ УсловияОферт.АкцептПо > &НачалоПериода)
		|
		|УПОРЯДОЧИТЬ ПО
		|	УсловияОферт.ДатаВыкупа";
	
	Запрос.УстановитьПараметр("НачалоПериода", КонецДня(НачалоПериода));
	Запрос.УстановитьПараметр("Облигация", Облигация);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ОкончаниеПериода);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ОпределитьТипОферты(Облигация, ДатаОферты) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияОферт.ТипОферты КАК ТипОферты
		|ИЗ
		|	РегистрСведений.УсловияОферт КАК УсловияОферт
		|ГДЕ
		|	УсловияОферт.Облигация = &Облигация
		|	И УсловияОферт.ДатаВыкупа = &ДатаВыкупа";
	
	Запрос.УстановитьПараметр("ДатаВыкупа", НачалоДня(ДатаОферты));
	Запрос.УстановитьПараметр("Облигация", Облигация);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
	
		Возврат ВыборкаДетальныеЗаписи.ТипОферты;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;

