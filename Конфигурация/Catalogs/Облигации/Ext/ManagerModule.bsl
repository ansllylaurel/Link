				//	|ИЗ
				//	|	&ВсеАналоги КАК ВсеАналоги
				//	|;
				//	|
				//	|////////////////////////////////////////////////////////////////////////////////
				//	|ВЫБРАТЬ
				//	|	_ВсеАналоги.ЦеннаяБумага КАК ЦеннаяБумага,
				//	|	_ВсеАналоги.ЭмитентЦеннойБумаги КАК ЭмитентЦеннойБумаги,
				//	|	_ВсеАналоги.ОбъемВыпускаЦеннойБумаги КАК ОбъемВыпускаЦеннойБумаги,
				//	|	_ВсеАналоги.СрокЦеннойБумаги КАК СрокЦеннойБумаги,
				//	|	_ВсеАналоги.Аналог КАК Аналог,
				//	|	_ВсеАналоги.ЭмитентАналога КАК ЭмитентАналога,
				//	|	_ВсеАналоги.ОбъемВыпускаАналога КАК ОбъемВыпускаАналога,
				//	|	_ВсеАналоги.СрокАналога КАК СрокАналога
				//	|ИЗ
				//	|	_ВсеАналоги КАК _ВсеАналоги");
				//
				//Запрос.УстановитьПараметр("ВсеАналоги", АналогиПоЭмитенту);
				//
				//Если РасшифровкаРасчета = Неопределено Тогда
				//	Аналоги = Запрос.Выполнить().Выгрузить();				
				//Иначе
				//	Аналоги = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, "Получение аналогов", "Аналоги");
				//КонецЕсли;
				
				Аналоги = АналогиПоЭмитенту;				
				
				Если РасшифровкаРасчета <> Неопределено Тогда
					РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "Аналоги", Аналоги);
				КонецЕсли;
				
				ПараметрыПрогноза.Вставить("Аналоги", Аналоги);
				
				#КонецОбласти
				
			КонецЕсли;
			
			#Область Получение_аналогов_с_ценой_активного_рынка
			
			Если ПараметрыПрогноза.Аналоги.Количество() = 0 Тогда
				
