			Ложь,
			РасшифровкаРасчета);  
			
		Если ПрогнозИПЦ = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон("Не удалось определить значение ставки '%1' на %2 для расчета ставки купона '%3'", ПараметрыСпособаРасчета.ВидПрогнознойПроцентнойСтавки, Формат(ПараметрыКупона.ДатаНачалаКупона, "ДФ=dd.MM.yyyy"), Облигация), , , , Отказ);
			Возврат Неопределено;
		КонецЕсли;
		
		ПрогнознаяСтавка = ПрогнозИПЦ + ПараметрыСпособаРасчета.ОтклонениеПрогнознойПроцентнойСтавки;							
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "РезультатРасчета",
				Новый Структура("СпособРасчета, ПрогнозноеЗначениеИПЦ, ОтклонениеПрогнознойПроцентнойСтавки, ПрогнознаяСтавка",
					"По экспертному прогнозу ИПЦ", ПрогнозИПЦ, ПараметрыСпособаРасчета.ОтклонениеПрогнознойПроцентнойСтавки, ПрогнознаяСтавка),
				"Результат расчета");
		КонецЕсли;			
		
		#КонецОбласти			
		
	ИначеЕсли СпособРасчетаПрогнозныхСтавок = "КакРазницаКБДДоПогашенияИСреднейПроцентнойМаржиНадСтоимостьюФондирования" Тогда
		
		#Область Разница_КБД_до_погашения_и_средней_процентной_маржи_над_стоимостью_фондирования 
		
		ДатаРасчетаПотока = НачалоДня(ПараметрыДенежногоПотока.ДатаПереоценки);
		КорректироватьКБДНаЗначения1гоДняИКонцаКП = Ложь;
		
		// фонд прислал письмо с 29.07.25 для Руоний использовать пунт 6.2 методики приложения 8
		// 3.4.26 после ряда консультаций между нами, фондом и СД (см.письмо в задаче #649694) решено было отключить п.6.2 для ставки Руониа и оставить для индекса Руониа
		// 3.4.26 после ряда консультаций между нами, фондом и СД (см.письмо в задаче #649694) решено было отключить п.6.2 для ставки Руониа и оставить для индекса Руониа
		// дату 3.4.26 не хардкодим т.к. это был 1ый и пока единственный случай 
		Если ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020
			И ПараметрыДенежногоПотока.Дата >= '20250729'
			И РеквизитыОблигации.БазоваяСтавка = ОбщегоНазначения.ПолучитьИменованныйОбъект("БазоваяСтавкаОблигаций_RUONIA_Index")
		Тогда
		
			ДатаРасчетаПотока = НачалоДня(ПараметрыДенежногоПотока.Дата);
			КорректироватьКБДНаЗначения1гоДняИКонцаКП = Истина;
		
		КонецЕсли;
		
		// Если в качестве переменного параметра предусмотрена плавающая процентная ставка сроком до 1 месяца,
		// то прогнозное значение такого параметра рассчитывается по формуле (4.5) как разница между Ставкой КБД в точке,
		// соответствующей средневзвешенному сроку до погашения оцениваемого инструмента, и величиной «средней процентной маржи над стоимостью фондирования»
		// 
		// RATE(f) = КБД(до погашения) - срМ(CoF)			(4.5)
		//
		// срМ(CoF) = ОКРУГЛ(СРЗНАЧ(М(CoF)), 4)				(4.6)
		//
		// 		                  P - 1000
		// М(CoF) = FIX(купон) - ——————————					(4.7)
		//		                  1000 * t
		//
		// где:
		// - КБД(до погашения)	- Значение Ставки КБД в точке, соответствующей средневзвешенному сроку до погашения оцениваемого инструмента
		// - срМ(CoF)			- Значение «средней процентной маржи над стоимостью фондирования», рассчитанно по формуле (4.6) на дату оценки инструмента
		//						  как среднее арифметическое значений показателя «процентной маржи над стоимостью фондирования», рассчитанных по формуле (4.7),
		//						  по корзине выпусков ОФЗ-ПК		
		// - М(CoF)				- Значение «процентной маржи над стоимостью фондирования», рассчитанное по формуле (4.7) для выпуска ОФЗ-ПК, входящего в корзину выпусков ОФЗ-ПК
		// - FIX(купон)			- Значение фиксированной части купона для выпуска ОФЗ-ПК.
		//						  Например, для выпуска 29010RMFS купон устанавливается в величине RUONIA + 1.60% и величина принимается равной 1.60%
		// - P					- цена (без учета купонного дохода) конкретного выпуска ОФЗ-ПК на дату расчета в рублях.
		//						  Цена определяется по данным Московской биржи, если она является активным рынком в отношении конкретной ОФЗ-ПК, в порядке,
		//						  аналогичном установленному методикой для расчета цены уровня 1.
		//						  Если на дату расчета цена не определена (в т. ч. по причине того, что Московская биржа не является в дату расчета активным рынком для выпуска),
		//						  то такой выпуск ОФЗ-ПК не включается в расчет
		// - t					- Средневзвешенный срок до погашения конкретного выпуска ОФЗ-ПК
		
		Если Не ПараметрыПрогноза.Свойство("КБДДоПогашения") Тогда
			
			#Область Расчет_ставки_КБД_в_точке_соответствующей_средневзвешенному_сроку_до_погашения
			
			Запрос = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	&ДатаОкончанияСрокаОбращения КАК Дата,
				|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Поток
				|ИЗ
				|	РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(
				|			&ДатаОкончанияСрокаОбращения,
				|			ЦеннаяБумага = &Облигация
				|				И &Дата < &ДатаОкончанияСрокаОбращения) КАК НоминалыЦенныхБумагСрезПоследних
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	НоминалыЦенныхБумаг.Период,
				|	НоминалыЦенныхБумаг.СуммаИзменения
				|ИЗ
				|	РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
				|ГДЕ
				|	НоминалыЦенныхБумаг.ЦеннаяБумага = &Облигация
				|	И НоминалыЦенныхБумаг.Период > &Дата
				|	И НоминалыЦенныхБумаг.Период <= &ДатаОкончанияСрокаОбращения
				|	И НоминалыЦенныхБумаг.СуммаИзменения > 0
				|
				|УПОРЯДОЧИТЬ ПО
				|	Дата");
			
			Запрос.УстановитьПараметр("Облигация",						Облигация);
			Запрос.УстановитьПараметр("Дата",							ПараметрыДенежногоПотока.Дата);
			Запрос.УстановитьПараметр("ДатаОкончанияСрокаОбращения",	ДатаВыкупа);
			
			ПогашенияТела = Запрос.Выполнить().Выгрузить();
			
			СтавкаКБД = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьНоминальнуюБезрисковуюСтавкуДоходности(Облигация, ДатаРасчетаПотока, ПогашенияТела, Отказ, ПараметрыСпособаРасчета.ТочностьСрокаДоПогашения, ПараметрыСпособаРасчета.ТочностьКБД, РасшифровкаРасчета);
			
			// #714585 Если формируют за текущую дату, т.е. КБД ещё нет, тогда берем её за предыдущий рабочий день. Без этого не будут работать _КонтрольИнвестиционныхДеклараций и прочие проверки.
			Если ДатаРасчетаПотока = НачалоДня(ТекущаяДата()) И Отказ И СтавкаКБД = 0 И ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020 Тогда
				Отказ = Ложь;	
				
				ПредыдущийРабочийДень = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ДатаРасчетаПотока, -2); 
				
				СтавкаКБД = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьНоминальнуюБезрисковуюСтавкуДоходности(Облигация, ПредыдущийРабочийДень, ПогашенияТела, Отказ, ПараметрыСпособаРасчета.ТочностьСрокаДоПогашения, ПараметрыСпособаРасчета.ТочностьКБД, РасшифровкаРасчета);
				
				Если Отказ = Истина Тогда
					Возврат Неопределено;
				КонецЕсли;
				
			КонецЕсли;	
			
			Если КорректироватьКБДНаЗначения1гоДняИКонцаКП Тогда
					
				ПогашенияТелаДляРасчета1гоДня = ПогашенияТела.Скопировать();
				Для каждого СтрокаПогашенияТелаДляРасчета1гоДня Из ПогашенияТелаДляРасчета1гоДня Цикл
					СтрокаПогашенияТелаДляРасчета1гоДня.Дата = ДатаРасчетаПотока + 86400;
				КонецЦикла;
				СтавкаКБД1День = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьНоминальнуюБезрисковуюСтавкуДоходности(Облигация, ДатаРасчетаПотока, ПогашенияТелаДляРасчета1гоДня, Отказ, ПараметрыСпособаРасчета.ТочностьСрокаДоПогашения, ПараметрыСпособаРасчета.ТочностьКБД, РасшифровкаРасчета);
				
				// #714585 Если формируют за текущую дату, т.е. КБД ещё нет, тогда берем её за предыдущий рабочий день. Без этого не будут работать _КонтрольИнвестиционныхДеклараций и прочие проверки.
				Если ДатаРасчетаПотока = НачалоДня(ТекущаяДата()) И Отказ И СтавкаКБД1День = 0 И ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020 Тогда
					Отказ = Ложь;	
					
					ПредыдущийРабочийДень = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ДатаРасчетаПотока, -2); 
					
					СтавкаКБД1День = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьНоминальнуюБезрисковуюСтавкуДоходности(Облигация, ПредыдущийРабочийДень, ПогашенияТелаДляРасчета1гоДня, Отказ, ПараметрыСпособаРасчета.ТочностьСрокаДоПогашения, ПараметрыСпособаРасчета.ТочностьКБД, РасшифровкаРасчета);
					
					Если Отказ = Истина Тогда
						Возврат Неопределено;
					КонецЕсли;
					
				КонецЕсли;	

				ПогашенияТелаДляРасчетаДоКонцаКупонногоПериода = ПогашенияТелаДляРасчета1гоДня;
				Для каждого СтрокаПогашенияТелаДляРасчетаДоКонцаКупонногоПериода Из ПогашенияТелаДляРасчетаДоКонцаКупонногоПериода Цикл
					СтрокаПогашенияТелаДляРасчетаДоКонцаКупонногоПериода.Дата = ДатаРасчетаПотока + (ПараметрыКупона.Дата - ПараметрыКупона.ДатаНачалаКупона);
				КонецЦикла;
				СтавкаКБДКупонныйПериод = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьНоминальнуюБезрисковуюСтавкуДоходности(Облигация, ДатаРасчетаПотока, ПогашенияТелаДляРасчетаДоКонцаКупонногоПериода, Отказ, ПараметрыСпособаРасчета.ТочностьСрокаДоПогашения, ПараметрыСпособаРасчета.ТочностьКБД, РасшифровкаРасчета);
				
				// #714585 Если формируют за текущую дату, т.е. КБД ещё нет, тогда берем её за предыдущий рабочий день. Без этого не будут работать _КонтрольИнвестиционныхДеклараций и прочие проверки.
				Если ДатаРасчетаПотока = НачалоДня(ТекущаяДата()) И Отказ И СтавкаКБДКупонныйПериод = 0 И ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020 Тогда
					Отказ = Ложь;	
					
					ПредыдущийРабочийДень = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ДатаРасчетаПотока, -2); 
					
					СтавкаКБДКупонныйПериод = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьНоминальнуюБезрисковуюСтавкуДоходности(Облигация, ПредыдущийРабочийДень, ПогашенияТелаДляРасчетаДоКонцаКупонногоПериода, Отказ, ПараметрыСпособаРасчета.ТочностьСрокаДоПогашения, ПараметрыСпособаРасчета.ТочностьКБД, РасшифровкаРасчета);
					
					Если Отказ = Истина Тогда
						Возврат Неопределено;
					КонецЕсли;
					
				КонецЕсли;	
				
				СтавкаКБД = СтавкаКБД + СтавкаКБДКупонныйПериод - СтавкаКБД1День;
				
			КонецЕсли;
			
			Если Отказ = Истина Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			ПараметрыПрогноза.Вставить("КБДДоПогашения", СтавкаКБД);
			
			#КонецОбласти
			
		КонецЕсли;
		
		Если Не ПараметрыПрогноза.Свойство("СредняяПроцентнаяМаржаНадСтоимостьюФондирования") Тогда
			
			#Область Расчет_средней_процентной_маржи_над_стоимостью_фондирования
			
			ПроцентнаяМаржа	= 0;
			КоличествоОФЗПК	= 0;
			
		    #Область Получение_корзины_ОФЗ_ПК
			
			НастройкиФормированияСЧА = РегистрыСведений.НастройкиФормированияСЧА.ОпределитьНастройки(
				ДатаРасчетаПотока,
				ПараметрыОценки.Организация,
				ПараметрыОценки.СчетДоверительногоУправления);
				
			КорзинаОФЗПК = НастройкиФормированияСЧА.КорзинаОФЗПК;
			Если КорзинаОФЗПК = Справочники.КорзиныОФЗПК.ПустаяСсылка()
				ИЛИ КорзинаОФЗПК.Корзина.Количество() = 0 Тогда
			
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Ошибка расчета ставки купона '%1': для клиента ""%2"" на %3 не зарегистрирована корзина выпусков ОФЗ-ПК",
						Облигация, ПараметрыОценки.Клиент, Формат(ДатаРасчетаПотока, "ДФ=dd.MM.yyyy")), , , , Отказ);
				Возврат Неопределено;
			
			КонецЕсли;
				
			Запрос = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации) КАК Рынок,
				|	Облигации.Ссылка КАК ЦеннаяБумага,
				|	0 КАК Номинал,
				|	0 КАК Цена,
				|	ЕСТЬNULL(0, ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ПустаяСсылка)) КАК ВидЦены,
				|	Облигации.ДатаПогашения КАК ДатаПогашения,
				|	0 КАК СрокДоПогашения,
				|	0 КАК ФиксированнаяЧастьКупона,
				|	0 КАК ПроцентнаяМаржа,
				|	ЛОЖЬ КАК ВключеноВРасчет
				|ИЗ
				|	Справочник.Облигации КАК Облигации
				|ГДЕ
				|	Облигации.Ссылка В(&КорзинаОФЗПК)");
			
			Запрос.УстановитьПараметр("КорзинаОФЗПК", КорзинаОФЗПК.Корзина.ВыгрузитьКолонку("ОФЗПК"));
			
			КорзинаОФЗПК = Запрос.Выполнить().Выгрузить();
			
			Если КорзинаОФЗПК.Количество() = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Ошибка расчета ставки купона '%1': для клиента ""%2"" на %3 не зарегистрирована корзина выпусков ОФЗ-ПК",
						Облигация, ПараметрыОценки.Клиент, Формат(ДатаРасчетаПотока, "ДФ=dd.MM.yyyy")), , , , Отказ);
				Возврат Неопределено;
			КонецЕсли;

			ИспользоватьТолькоВыпускиОФЗПКСНеизвестнымиНаДатуРасчетаКупонами = 
				ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020 И ДатаРасчетаПотока >= '20230401'
				ИЛИ ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФк_ФДЦБ2021 И ДатаРасчетаПотока >= '20230403'
				ИЛИ ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Газфонд И ДатаРасчетаПотока >= '20230401';
				
			Если ИспользоватьТолькоВыпускиОФЗПКСНеизвестнымиНаДатуРасчетаКупонами Тогда	
				
				ОблигацииСНеизвестнымиПотоками = ПолучитьОблигацииСПлавающейСтавкойИлиНоминалом(
					КорзинаОФЗПК, ДатаРасчетаПотока, ПараметрыДенежногоПотока.ДоДатыПогашения, ПараметрыДенежногоПотока.УчитыватьКупонКОферте);
					
				Для НомерСтрокиКорзины = -КорзинаОФЗПК.Количество() По -1 Цикл
					СтрокаКорзины = КорзинаОФЗПК[-НомерСтрокиКорзины-1];
					Если ОблигацииСНеизвестнымиПотоками.Найти(СтрокаКорзины.ЦеннаяБумага) = Неопределено Тогда
						КорзинаОФЗПК.Удалить(СтрокаКорзины);
					КонецЕсли;
				КонецЦикла;

			КонецЕсли;
			
			#КонецОбласти
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				РасшифровкаОперации = РаботаСДокументами.ДобавитьРасшифровкуОперации(
					РасшифровкаРасчета, "Получение цен выпусков ОФЗ-ПК" + ?(ИспользоватьТолькоВыпускиОФЗПКСНеизвестнымиНаДатуРасчетаКупонами, " с неизвестными купонами", ""), , , Истина);
			КонецЕсли;			
			
			ПараметрыОценкиКорзины = Новый Структура;
			ПараметрыОценкиКорзины.Вставить("Организация",							ПараметрыОценки.Организация);
			ПараметрыОценкиКорзины.Вставить("СчетДоверительногоУправления",			ПараметрыОценки.СчетДоверительногоУправления);
			ПараметрыОценкиКорзины.Вставить("ВидУчета",								Неопределено);
			ПараметрыОценкиКорзины.Вставить("ВариантРасчетаСправедливойСтоимости",	ПараметрыОценки.ВариантРасчетаОценочнойСтоимости);
			ПараметрыОценкиКорзины.Вставить("ПараметрыПолученияПартий",				Неопределено);
			ПараметрыОценкиКорзины.Вставить("Клиент",								ПараметрыОценки.Клиент);
			ПараметрыОценкиКорзины.Вставить("ТолькоНаблюдаемыеЦены",				Истина);
			
			ТаблицаСтоимостиОФЗПК = РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС(ПараметрыОценкиКорзины, ДатаРасчетаПотока, КорзинаОФЗПК, , Отказ, РасшифровкаОперации);

			Если Отказ = Истина Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Ошибка получения наблюдаемых цен корзины ОФЗ-ПК на %1 для расчета ставки купона '%2'",
						Формат(ДатаРасчетаПотока, "ДФ=dd.MM.yyyy"), Облигация), , , , Отказ);
				Возврат Неопределено;
			КонецЕсли;
			
			Для Каждого СтрокаКорзиныОФЗПК Из КорзинаОФЗПК Цикл
				
				СтрокаТаблицыСтоимостей = ТаблицаСтоимостиОФЗПК.Найти(СтрокаКорзиныОФЗПК.ЦеннаяБумага, "ЦеннаяБумага");
				Если СтрокаТаблицыСтоимостей = Неопределено ИЛИ Не (СтрокаТаблицыСтоимостей.Стоимость > 0 И СтрокаТаблицыСтоимостей.УровеньОценки = 1) Тогда
