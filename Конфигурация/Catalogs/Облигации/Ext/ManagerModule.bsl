// Получает стоимость купона на дату
//
// Параметры
//	Облигация		- СправочникСсылка.Облигации - ссылка на облигацию
//	Дата			- Дата - период, на который необходимо рассчитать купон
//	Биржа			- СправочникСсылка.Биржи - НЕ ИСПОЛЬЗУЕТСЯ
//	ВалютаКупона	- СправочникСсылка.Валюты - выходной параметр, заполняется валютой котировки или валютой номинала ЦБ при расчете купона
//	ВВалютеНоминала	- Булево - признак, название которого говорит само за себя
//
// Возвращаемое значение:
//	Число			- стоимость купона
Функция ПолучитьКупон(Облигация, Дата, СчетДоверительногоУправления, Биржа = Неопределено, ВалютаКупона = Неопределено, ВВалютеНоминала = Истина, ТочностьКупонаВВалютеНоминала = Неопределено) Экспорт
	Если Не ЗначениеЗаполнено(Облигация) Тогда
		ВалютаКупона = Неопределено;
		Возврат 0;
	КонецЕсли;
	
	#Область Минфин24020_Минфин24021_для_Сбербанка_и_УГМК_с_06_04_2020
	
	Если Дата >= '20200406'
		И (Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин24020")
			Или Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин24021"))
	Тогда
		// Хардкод для реструктуризированных бумаг
		МассивСчетовСбербанка = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
			ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_Сбербанк"), ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"), Дата);
		МассивСчетовУГМК = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
			ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_УГМК"), ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"), Дата);
	
		Если МассивСчетовУГМК.Найти(СчетДоверительногоУправления) <> Неопределено
			Или МассивСчетовСбербанка.Найти(СчетДоверительногоУправления) <> Неопределено
		Тогда
			Купон = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(Облигация, Дата, СчетДоверительногоУправления);
			ВалютаКупона = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Облигация, "ВалютаНоминала");
			Возврат Купон;
		КонецЕсли;
	КонецЕсли;
	
	#КонецОбласти
	
	#Область ПропертизФинанс01_для_Будущего_и_ТелекомСоюза_с_03_10_2020
	
	Если Дата >= '20201003' И Дата < '20201118'
		И Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1_ПропертизФин")
	Тогда
		МассивСчетовБудущее = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
			ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_БУДУЩЕЕ"), ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"), Дата);
		МассивСчетовТелекомСоюз = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
			ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_ТелекомСоюз"), ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"), Дата);
		
		Если МассивСчетовБудущее.Найти(СчетДоверительногоУправления) <> Неопределено
			Или МассивСчетовТелекомСоюз.Найти(СчетДоверительногоУправления) <> Неопределено
		Тогда
			Купон = 0;
			ВалютаКупона = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Облигация, "ВалютаНоминала");
			Возврат Купон;
		КонецЕсли;
	КонецЕсли;
	
	#КонецОбласти
	
	#Область Минфин12840111V_для_Национального_ХантыМансийского_и_методики_РЭМ
	
	Если Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин12840111V") Тогда
		
		МассивСчетовНационального = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
			ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Национальный"), ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"), Дата);
			
		МассивСчетовХантыМансийского = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
			ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ХантыМансийский"), ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"), Дата);	
			
		НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(
						Дата,
						ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "Организация"),
						СчетДоверительногоУправления,
						Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
						
		ЭтоМетодикаРЭМ = НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ; 				
						
		Если Дата >= '20251031' И МассивСчетовНационального.Найти(СчетДоверительногоУправления) <> Неопределено
			Или Дата >= '20251107' И МассивСчетовХантыМансийского.Найти(СчетДоверительногоУправления) <> Неопределено
			Или Дата >= '20251128' И ЭтоМетодикаРЭМ
		Тогда
			Купон = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(Облигация, Дата, СчетДоверительногоУправления);
			ВалютаКупона = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Облигация, "ВалютаНоминала");
			Возврат Купон;
		КонецЕсли;
		
	КонецЕсли;
	
	#КонецОбласти
	
	Запрос = Новый Запрос;
	Запрос.Текст = // Берём купон (ACCINT) из первой попавшейся биржи, в первую очередь чья валюта котировки совпадает с валютой номинала
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиТорговыхПлощадок.Биржа КАК Биржа,
		|	КотировкиТорговыхПлощадок.Период КАК Период,
		|	КотировкиТорговыхПлощадок.Рынок КАК Рынок,
		|	КотировкиТорговыхПлощадок.РежимТоргов КАК РежимТоргов,
		|	КотировкиТорговыхПлощадок.Валюта КАК Валюта,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА КотировкиТорговыхПлощадок.ЦеннаяБумага.ВалютаНоминала
		|	КОНЕЦ КАК ВалютаНоминала,
		|	КотировкиТорговыхПлощадок.ACCINT КАК ACCINT
		|ПОМЕСТИТЬ _ПоследниеКотировки
		|ИЗ
		|	РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|ГДЕ
		|	КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим
		|	И КотировкиТорговыхПлощадок.Период = &Период
		|	И КотировкиТорговыхПлощадок.ЦеннаяБумага = &ЦеннаяБумага
		|	И КотировкиТорговыхПлощадок.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	_ПоследниеКотировки.Биржа КАК Биржа,
		|	ВЫБОР
		|		КОГДА МАКСИМУМ(_ПоследниеКотировки.Валюта = _ПоследниеКотировки.ВалютаНоминала)
		|			ТОГДА МАКСИМУМ(ВЫБОР
		|						КОГДА _ПоследниеКотировки.Валюта = _ПоследниеКотировки.ВалютаНоминала
		|							ТОГДА _ПоследниеКотировки.РежимТоргов
		|					КОНЕЦ)
		|		ИНАЧЕ МАКСИМУМ(_ПоследниеКотировки.РежимТоргов)
		|	КОНЕЦ КАК РежимТорговДляACCINT
		|ПОМЕСТИТЬ _РежимыТорговПоследнихКотировок
		|ИЗ
		|	_ПоследниеКотировки КАК _ПоследниеКотировки
		|
		|СГРУППИРОВАТЬ ПО
		|	_ПоследниеКотировки.Биржа
		|
		|ИМЕЮЩИЕ
		|	НЕ ВЫБОР
		|			КОГДА МАКСИМУМ(_ПоследниеКотировки.Валюта = _ПоследниеКотировки.ВалютаНоминала)
		|				ТОГДА МАКСИМУМ(ВЫБОР
		|							КОГДА _ПоследниеКотировки.Валюта = _ПоследниеКотировки.ВалютаНоминала
		|								ТОГДА _ПоследниеКотировки.РежимТоргов
		|						КОНЕЦ)
		|			ИНАЧЕ МАКСИМУМ(_ПоследниеКотировки.РежимТоргов)
		|		КОНЕЦ ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(ПоследниеКотировкиДляACCINT.Биржа, КупоныВыходногоДня.Биржа) КАК Биржа,
		|	ЕСТЬNULL(ПоследниеКотировкиДляACCINT.Валюта, КупоныВыходногоДня.Облигация.ВалютаНоминала) КАК Валюта,
		|	ВЫБОР
		|		КОГДА НЕ КупоныВыходногоДня.Период ЕСТЬ NULL
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ПоследниеКотировкиДляACCINT.РежимТоргов
		|	КОНЕЦ КАК РежимТорговДляACCINT,
		|	ЕСТЬNULL(КупоныВыходногоДня.ACCINT, ПоследниеКотировкиДляACCINT.ACCINT) КАК ACCINT
		|ПОМЕСТИТЬ _КотировкиЦенныхБумаг
		|ИЗ
		|	Справочник.Облигации КАК Облигации
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РежимыТорговПоследнихКотировок КАК _РежимыТорговПоследнихКотировок
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПоследниеКотировки КАК ПоследниеКотировкиДляACCINT
		|		ПО (НЕ _РежимыТорговПоследнихКотировок.РежимТорговДляACCINT ЕСТЬ NULL)
		|			И (_РежимыТорговПоследнихКотировок.РежимТорговДляACCINT = ПоследниеКотировкиДляACCINT.РежимТоргов)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупоныВыходногоДня КАК КупоныВыходногоДня
		|		ПО (КупоныВыходногоДня.Период = &Период)
		|			И (&ЦеннаяБумага ССЫЛКА Справочник.Облигации)
		|			И (КупоныВыходногоДня.Облигация = &ЦеннаяБумага)
		|ГДЕ
		|	Облигации.Ссылка = &ЦеннаяБумага
		|	И НЕ ЕСТЬNULL(КупоныВыходногоДня.ACCINT, ПоследниеКотировкиДляACCINT.ACCINT) ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КотировкиЦенныхБумаг.Биржа КАК Биржа,
		|	_КотировкиЦенныхБумаг.ACCINT КАК Купон,
		|	ВЫБОР
		|		КОГДА _КотировкиЦенныхБумаг.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			ТОГДА Облигации.ВалютаНоминала
		|		ИНАЧЕ _КотировкиЦенныхБумаг.Валюта
		|	КОНЕЦ КАК ВалютаКупона,
		|	ВЫБОР
		|		КОГДА _КотировкиЦенныхБумаг.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			ТОГДА КурсВалютыНоминала.Курс
		|		ИНАЧЕ КурсВалютыКотировки.Курс
		|	КОНЕЦ КАК КурсКупона,
		|	ВЫБОР
		|		КОГДА _КотировкиЦенныхБумаг.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			ТОГДА КурсВалютыНоминала.Кратность
		|		ИНАЧЕ КурсВалютыКотировки.Кратность
		|	КОНЕЦ КАК КратностьКупона,
		|	Облигации.ВалютаНоминала КАК ВалютаНоминала,
		|	КурсВалютыНоминала.Курс КАК КурсНоминала,
		|	КурсВалютыНоминала.Кратность КАК КратностьНоминала,
		|	ВЫБОР
		|		КОГДА _КотировкиЦенныхБумаг.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ _КотировкиЦенныхБумаг.Валюта = Облигации.ВалютаНоминала
		|	КОНЕЦ КАК ВВалютеНоминала
		|ИЗ
		|	_КотировкиЦенныхБумаг КАК _КотировкиЦенныхБумаг
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО (Облигации.Ссылка = &ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыКотировки
		|		ПО (КурсВалютыКотировки.Валюта = _КотировкиЦенныхБумаг.Валюта)
		|			И (КурсВалютыКотировки.Период = &Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыНоминала
		|		ПО (КурсВалютыНоминала.Валюта = Облигации.ВалютаНоминала)
		|			И (КурсВалютыНоминала.Период = &Период)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВВалютеНоминала УБЫВ,
		|	ВалютаКупона";
	#КонецОбласти
	Запрос.УстановитьПараметр("ЦеннаяБумага", Облигация);
	Запрос.УстановитьПараметр("Период", НачалоДня(Дата));
	
	РассчитатьКупон = Ложь;
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Купон			= ВыборкаДетальныеЗаписи.Купон;
		ВалютаКупона	= ВыборкаДетальныеЗаписи.ВалютаКупона;
		ВалютаНоминала	= ВыборкаДетальныеЗаписи.ВалютаНоминала;
		
		Если Купон = 0 Тогда // Иногда мы вынуждены сами считать купон
			РассчитатьКупон = РаботаСЦеннымиБумагами.ТребуетсяРасчетКупона(Облигация, Дата);
		КонецЕсли;
	Иначе
		РассчитатьКупон = Истина;
	КонецЕсли;
	
	Если РассчитатьКупон Тогда
		ТочностьКупона = ?(Дата >= '20230801', РаботаСЦеннымиБумагами.ТочностьРасчетногоКупона(Облигация, Дата, ВалютаНоминала, СчетДоверительногоУправления), 2);
		Купон = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(Облигация, Дата, СчетДоверительногоУправления, , ТочностьКупона);
		ВалютаКупона = ?(ВалютаНоминала = Неопределено, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Облигация, "ВалютаНоминала"), ВалютаНоминала);
		
	ИначеЕсли ВВалютеНоминала И ВалютаКупона <> ВалютаНоминала Тогда // Пересчет купона в валюту номинала
		Купон = Купон * ВыборкаДетальныеЗаписи.КурсКупона / ВыборкаДетальныеЗаписи.КратностьКупона
			/ ВыборкаДетальныеЗаписи.КурсНоминала * ВыборкаДетальныеЗаписи.КратностьНоминала;
			
		Если ТочностьКупонаВВалютеНоминала <> Неопределено Тогда
			Купон = Окр(Купон, ТочностьКупонаВВалютеНоминала, 1);
		КонецЕсли;
		
		ВалютаКупона = ВалютаНоминала;
	КонецЕсли;
	
	Возврат Купон;
КонецФункции

Функция ПолучитьНоминал(Облигация, Дата) Экспорт
	
	Возврат Кэширование.ПолучитьНоминал(Облигация, Дата);
	
КонецФункции

// Нужна для методики ЦБ РФ
Функция ПолучитьДатыПубликацийОбИзмененияхДенежныхПотоков(Облигация, ДатаНачала, ДатаОкончания) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КупонныйДоходПоОблигациям.ДатаПубликации КАК ДатаПубликации,
		|	КупонныйДоходПоОблигациям.СтавкаКупона КАК СтавкаКупона,
		|	МИНИМУМ(КупонныйДоходПоОблигациям.Период) КАК Период
		|ПОМЕСТИТЬ ДатыПубликации
		|ИЗ
		|	РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|ГДЕ
		|	КупонныйДоходПоОблигациям.Облигация = &Облигация
		|	И КупонныйДоходПоОблигациям.ДатаПубликации МЕЖДУ &ДатаНачала И &ДатаОкончания
		|
		|СГРУППИРОВАТЬ ПО
		|	КупонныйДоходПоОблигациям.ДатаПубликации,
		|	КупонныйДоходПоОблигациям.СтавкаКупона
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДатыПубликации.ДатаПубликации КАК ДатаПубликации,
		|	ДатыПубликации.СтавкаКупона КАК СтавкаКупона,
		|	ДатыПубликации.Период КАК Период,
		|	МАКСИМУМ(КупонныйДоходПоОблигациям.Период) КАК ПредыдущийПериод
		|ПОМЕСТИТЬ ДатыПубликацииИПредыдущегоПериода
		|ИЗ
		|	ДатыПубликации КАК ДатыПубликации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|		ПО ДатыПубликации.Период > КупонныйДоходПоОблигациям.Период
		|			И (КупонныйДоходПоОблигациям.Облигация = &Облигация)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДатыПубликации.ДатаПубликации,
		|	ДатыПубликации.СтавкаКупона,
		|	ДатыПубликации.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДатыПубликацииИПредыдущегоПериода.ДатаПубликации КАК ДатаПубликации,
		|	ДатыПубликацииИПредыдущегоПериода.СтавкаКупона КАК СтавкаКупона,
		|	ДатыПубликацииИПредыдущегоПериода.Период КАК Период,
		|	ДатыПубликацииИПредыдущегоПериода.ПредыдущийПериод КАК ПредыдущийПериод,
		|	КупонныйДоходПоОблигациям.ДатаПубликации КАК ПредыдущаяДатаПубликации,
		|	КупонныйДоходПоОблигациям.СтавкаКупона КАК ПредыдущаяСтавкаКупона
		|ПОМЕСТИТЬ ДанныеПубликации
		|ИЗ
		|	ДатыПубликацииИПредыдущегоПериода КАК ДатыПубликацииИПредыдущегоПериода
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|		ПО ДатыПубликацииИПредыдущегоПериода.ПредыдущийПериод = КупонныйДоходПоОблигациям.Период
		|			И (КупонныйДоходПоОблигациям.Облигация = &Облигация)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеПубликации.ДатаПубликации КАК ДатаПубликации
		|ПОМЕСТИТЬ ДатыИзмененийПотоков
		|ИЗ
		|	ДанныеПубликации КАК ДанныеПубликации
		|ГДЕ
		|	ДанныеПубликации.ДатаПубликации <> ДанныеПубликации.ПредыдущаяДатаПубликации
		|	И ДанныеПубликации.СтавкаКупона <> ДанныеПубликации.ПредыдущаяСтавкаКупона
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДатыИзмененийПотоков.ДатаПубликации КАК ДатаПубликации,
		|	МАКСИМУМ(НоминалыЦенныхБумаг.Период) КАК Период
		|ПОМЕСТИТЬ ДатыИзмененийИНоминалов
		|ИЗ
		|	ДатыИзмененийПотоков КАК ДатыИзмененийПотоков
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|		ПО ДатыИзмененийПотоков.ДатаПубликации > НоминалыЦенныхБумаг.Период
		|			И (НоминалыЦенныхБумаг.ЦеннаяБумага = &Облигация)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДатыИзмененийПотоков.ДатаПубликации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДатыИзмененийИНоминалов.ДатаПубликации КАК ДатаВыкупа,
		|	НоминалыЦенныхБумаг.Номинал КАК Цена
		|ИЗ
		|	ДатыИзмененийИНоминалов КАК ДатыИзмененийИНоминалов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|		ПО ДатыИзмененийИНоминалов.Период = НоминалыЦенныхБумаг.Период
		|			И (НоминалыЦенныхБумаг.ЦеннаяБумага = &Облигация)";
	
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("Облигация", Облигация);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьРешенияКлиентовПоПрогнозируемымДенежнымПотокам(Организация, Клиент, Облигация, ДатаНачала, ДатаОкончания, ДатаПереоценки) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЗначенияНастроекУчетаЦенныхБумаг.Регистратор КАК Документ,
		|	ЗначенияНастроекУчетаЦенныхБумаг.Период КАК Дата,
		|	ЗначенияНастроекУчетаЦенныхБумаг.Период КАК ДатаНачалаДействия
		|ИЗ
		|	РегистрСведений.ЗначенияНастроекУчетаЦенныхБумаг КАК ЗначенияНастроекУчетаЦенныхБумаг
		|ГДЕ
		|	ЗначенияНастроекУчетаЦенныхБумаг.Активность
		|	И ЗначенияНастроекУчетаЦенныхБумаг.Организация = &Организация
		|	И ЗначенияНастроекУчетаЦенныхБумаг.Клиент = &Клиент
		|	И ЗначенияНастроекУчетаЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага
		|	И ЗначенияНастроекУчетаЦенныхБумаг.Период >= &ДатаНачала
		|	И ЗначенияНастроекУчетаЦенныхБумаг.Период <= &ДатаОкончания
		|	И ЗначенияНастроекУчетаЦенныхБумаг.Период <= &ДатаПереоценки
		|	И ЗначенияНастроекУчетаЦенныхБумаг.Настройка = &Настройка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата");
	
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("Клиент",			Клиент);
	Запрос.УстановитьПараметр("ЦеннаяБумага",	Облигация);
	Запрос.УстановитьПараметр("ДатаНачала",		ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",	ДатаОкончания);
	Запрос.УстановитьПараметр("ДатаПереоценки",	ДатаПереоценки);
	Запрос.УстановитьПараметр("Настройка",		ПланыВидовХарактеристик.НастройкиУчетаЦенныхБумаг.ДенежныйПотокПоОблигации);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#Область Служебные_и_вспомогательные_функции

// Возвращает дату, на которую необходимо определить прогнозное значение переменного параметра, от которого рассчитывается ставка купона
//
Функция ДатаОпределенияПрогнозногоЗначения(ПараметрыКупона, ПараметрыОценки)
	
	Если БухгалтерскийУчетЕПС.ЭтоКлиентГруппыБудущее(ПараметрыОценки.Клиент) Тогда
		
		// Если купон переходит через год, то дата окончания года, в котором аллоцируется большая часть купона (#469393, #482244)
		
		Если Год(ПараметрыКупона.ДатаНачалаКупона) = Год(ПараметрыКупона.Дата)
			ИЛИ (КонецГода(ПараметрыКупона.ДатаНачалаКупона) - ПараметрыКупона.ДатаНачалаКупона) > (ПараметрыКупона.Дата - НачалоГода(ПараметрыКупона.Дата))
		Тогда
			ГраницаКупонногоПериода = ПараметрыКупона.ДатаНачалаКупона;
		Иначе
			ГраницаКупонногоПериода = ПараметрыКупона.Дата;
		КонецЕсли;
		
		ДатаОпределения = НачалоДня(КонецГода(ГраницаКупонногоПериода));
		
	Иначе
		
		// Берется ближайшее к дате начала купона прогнозное значение
		
		ДатаОпределения = ПараметрыКупона.ДатаНачалаКупона;
		
	КонецЕсли;
	
	Возврат ДатаОпределения;
	
КонецФункции

Функция ПолучитьФиксированнуюЧастьСтавкиКупона(Облигация, Период, Отказ)
	
	// Определяем фиксированную часть ставки купона из формулы расчета ставки:
 	// ищем в составляющих настройки базу "Фиксированная ставка" и получаем ее параметры;
	// если в ней нет этой базы, то считаем что фиксированная ставка равна 0.
	
	РезультатФункции = Неопределено;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Облигации.Ссылка КАК Облигация,
		|	КупонныйДоходПоОблигациям.НомерКупона КАК НомерКупона,
		|	КупонныйДоходПоОблигациям.Период КАК НачалоКупонногоПериода,
		|	КупонныйДоходПоОблигациям.ДатаОкончанияКупона КАК ОкончаниеКупонногоПериода,
		|	КупонныйДоходПоОблигациям.ФормулаРасчетаСтавки КАК ФормулаСтавки,
		|	КомпонентыФормулы.ПараметрыРасчета КАК ПараметрыРасчета
		|ИЗ
		|	Справочник.Облигации КАК Облигации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|		ПО (КупонныйДоходПоОблигациям.Облигация = Облигации.Ссылка)
		|			И (КупонныйДоходПоОблигациям.Период <= &Период)
		|			И (КупонныйДоходПоОблигациям.ДатаОкончанияКупона > &Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НастройкиРасчета.Составляющие КАК КомпонентыФормулы
		|		ПО (КомпонентыФормулы.Ссылка = КупонныйДоходПоОблигациям.ФормулаРасчетаСтавки)
		|			И (КомпонентыФормулы.БазаРасчета = ЗНАЧЕНИЕ(Справочник.БазыРасчета.ФиксированнаяСтавка))
		|ГДЕ
		|	Облигации.Ссылка = &Облигация");
	
	Запрос.УстановитьПараметр("Облигация",	Облигация);
	Запрос.УстановитьПараметр("Период",		Период);
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаЗапроса.Следующий() Тогда
		
		Если ЗначениеЗаполнено(ВыборкаЗапроса.НомерКупона) И ВыборкаЗапроса.ПараметрыРасчета <> NULL Тогда
		
			ПараметрыРасчета = ВыборкаЗапроса.ПараметрыРасчета.Получить();
			Если ТипЗнч(ПараметрыРасчета) = Тип("Структура") И ПараметрыРасчета.Свойство("ПараметрРасчетаСтавка") Тогда
				РезультатФункции = ПараметрыРасчета.ПараметрРасчетаСтавка;	
			КонецЕсли;			
			
		ИначеЕсли ЗначениеЗаполнено(ВыборкаЗапроса.ФормулаСтавки) Тогда
			
			РезультатФункции = 0;	
			
		КонецЕсли;
		
	КонецЕсли;	
	
	// Если по какой-то причине не удалось получить ставку, сообщаем об этом
	
	Если РезультатФункции = Неопределено Тогда
		ПредставлениеКупона = ?(ЗначениеЗаполнено(ВыборкаЗапроса.НомерКупона), Строка(ВыборкаЗапроса.НомерКупона) + "-го купона", "купона");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Не удалось определить фиксированную часть %1 облигации '%2' на %3", ПредставлениеКупона, Облигация, Формат(Период, "ДФ=dd.MM.yyyy")), Облигация, , , Отказ);
	КонецЕсли;	
	
	Возврат РезультатФункции;

КонецФункции

Функция РассчитатьПрогнозноеЗначениеСтавкиКупонаСпособомРасчета(СпособРасчетаПрогнозныхСтавок, ПараметрыСпособаРасчета, РеквизитыОблигации, ПараметрыКупона, ПараметрыДенежногоПотока, ПараметрыОценки, ПараметрыПрогноза, Отказ, РасшифровкаРасчета = Неопределено, ПрерыватьРасчетПриОшибке = Истина)	
	
	Облигация	= РеквизитыОблигации.Облигация;
	ДатаВыкупа	= РеквизитыОблигации.ДатаВыкупа;
	
	Если СпособРасчетаПрогнозныхСтавок = "ПоФормуле" И ПараметрыСпособаРасчета.ФормулаРасчета = "2 * (SQR(YTM / 100% + 1) − 1) * 100%" Тогда
		
		#Область Заданная_формула_расчета
		
		// Ci  = 2 * (SQR(YTM / 100% + 1) − 1) * 100%
		// YTM = R + m
		// R   = GCurve(5Y)
		// m   = 1.47
	
		R	= РаботаСПоказателямиФинансовыхИнструментов.РассчитатьЗначениеКривойБескупоннойДоходности(ПараметрыДенежногоПотока.ДатаПереоценки, 5, , Отказ);
		m	= 1.47;
		YTM	= R + m;
		
		ПрогнознаяСтавка = 2 * (Sqrt(YTM / 100 + 1) - 1) * 100;
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "РезультатРасчета",
				Новый Структура("СпособРасчета, R, m, YTM, Формула, ПрогнознаяСтавка", "По прогнозному значению КБД", R, m, YTM, ПараметрыСпособаРасчета.ФормулаРасчета, ПрогнознаяСтавка),
				"Результат расчета");
		КонецЕсли;
		
		#КонецОбласти

	ИначеЕсли СпособРасчетаПрогнозныхСтавок = "КакСреднееЗначенийЗаПредыдущиеПериоды" Тогда	
		
		#Область Среднее_арифметическое_известных_значений
		
		КлючЗначения = РаботаСоСтрокамиКлиентСервер.ПредставлениеСтруктуры(
			Новый Структура("ПрогнозируемоеЗначение, НачалоПериода, ОкончаниеПериода", 
					ПараметрыСпособаРасчета.ПрогнозируемоеЗначение, 
					ПараметрыСпособаРасчета.НачалоПериода, 
					ПараметрыСпособаРасчета.ОкончаниеПериода));
		
		Если Не ПараметрыПрогноза.Свойство("СредниеЗначенияЗаПредыдущиеПериоды")
			ИЛИ ПараметрыПрогноза.СредниеЗначенияЗаПредыдущиеПериоды.Получить(КлючЗначения) = Неопределено
		Тогда
		
		    #Область Расчет_среднего_значения
		
			Если ТипЗнч(ПараметрыСпособаРасчета.ПрогнозируемоеЗначение) = Тип("СправочникСсылка.БиржевыеИндексы") Тогда
			
				#Область Расчет_среднего_значения_биржевого_индекса
				
				Запрос = Новый Запрос(
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЗначенияБиржевыхИндексов.Период КАК Период,
					|	ЗначенияБиржевыхИндексов.CLOSE КАК Значение
					|ПОМЕСТИТЬ _ЗначенияИндексов
					|ИЗ
					|	РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
					|ГДЕ
					|	ЗначенияБиржевыхИндексов.БиржевойИндекс = &БиржевойИндекс
					|	И ЗначенияБиржевыхИндексов.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	СРЕДНЕЕ(_ЗначенияИндексов.Значение) КАК Среднее
					|ИЗ
					|	_ЗначенияИндексов КАК _ЗначенияИндексов");
				
				#КонецОбласти
				
			Иначе
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Расчет средних значений '%1' для расчета ставок будущих купонов '%2' не реализован", ПараметрыСпособаРасчета.ПрогнозируемоеЗначение, Облигация), Облигация, , , Отказ);
				Возврат Неопределено;
				
			КонецЕсли;					
				
			Запрос.УстановитьПараметр("БиржевойИндекс",		ПараметрыСпособаРасчета.ПрогнозируемоеЗначение);
			Запрос.УстановитьПараметр("НачалоПериода",		ПараметрыСпособаРасчета.НачалоПериода);
			Запрос.УстановитьПараметр("ОкончаниеПериода",	ПараметрыСпособаРасчета.ОкончаниеПериода);
			
			Если РасшифровкаРасчета = Неопределено Тогда
				ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
			Иначе
				ВыборкаЗапроса = РаботаСДокументами.ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, СтрШаблон("Расчет среднего значения '%1' за предыдущие периоды", ПараметрыСпособаРасчета.ПрогнозируемоеЗначение), "Результат расчета среднего значения", "Выборка", , , Истина);
			КонецЕсли;
			
			Если Не ВыборкаЗапроса.Следующий() ИЛИ ВыборкаЗапроса.Среднее = NULL Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Нет данных для расчета среднего значения '%1' за период %2 для расчета ставок будущих купонов '%3'",
						ПараметрыСпособаРасчета.ПрогнозируемоеЗначение, 
						Новый СтандартныйПериод(ПараметрыСпособаРасчета.НачалоПериода, ПараметрыСпособаРасчета.ОкончаниеПериода), 
						Облигация), 
					Облигация, , , Отказ);
				Возврат Неопределено;
			КонецЕсли;
			
			Если Не ПараметрыПрогноза.Свойство("СредниеЗначенияЗаПредыдущиеПериоды") Тогда
				ПараметрыПрогноза.Вставить("СредниеЗначенияЗаПредыдущиеПериоды", Новый Соответствие);	
			КонецЕсли;
			
			ПараметрыПрогноза.СредниеЗначенияЗаПредыдущиеПериоды.Вставить(КлючЗначения, ВыборкаЗапроса.Среднее); 
			
			#КонецОбласти
			
		КонецЕсли;
		
		СреднееЗначение = ПараметрыПрогноза.СредниеЗначенияЗаПредыдущиеПериоды.Получить(КлючЗначения);
		
		ПрогнознаяСтавка = СреднееЗначение + ПараметрыСпособаРасчета.ОтклонениеПрогнознойПроцентнойСтавки;	
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "РезультатРасчета",
				Новый Структура("СпособРасчета, Период, СреднееЗначение, ОтклонениеПрогнознойПроцентнойСтавки, ПрогнознаяСтавка",
					"Среднее арифметическое значений за период", 
					Новый СтандартныйПериод(ПараметрыСпособаРасчета.НачалоПериода, ПараметрыСпособаРасчета.ОкончаниеПериода), 
					СреднееЗначение, ПараметрыСпособаРасчета.ОтклонениеПрогнознойПроцентнойСтавки, ПрогнознаяСтавка),
				"Результат расчета");
		КонецЕсли;
			
		#КонецОбласти
		
	ИначеЕсли СпособРасчетаПрогнозныхСтавок = "ПоПрогнознымЗначениям" И ПараметрыСпособаРасчета.ВидПрогнознойПроцентнойСтавки = "ЗначениеКБД" Тогда
			
		#Область Прогноз_значения_КБД
		
		Если ПараметрыСпособаРасчета.ВариантРасчетаПрогнозныхЗначенийКБД = "ЗначениеНаДатуОценки" Тогда
			
			#Область Значение_на_дату_оценки
			
			СтавкаКБД = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьЗначениеКривойБескупоннойДоходности(ПараметрыДенежногоПотока.ДатаПереоценки, ПараметрыСпособаРасчета.ТочкаКБД, , Отказ);
			
			Если ПараметрыСпособаРасчета.ТочностьКБД <> Неопределено Тогда
				СтавкаКБД = Окр(СтавкаКБД, ПараметрыСпособаРасчета.ТочностьКБД)
			КонецЕсли;
			
			ПрогнознаяСтавка = СтавкаКБД + ПараметрыСпособаРасчета.ОтклонениеПрогнознойПроцентнойСтавки;
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "РезультатРасчета",
					Новый Структура("СпособРасчета, ВариантРасчета, ТочкаКБД, СтавкаКБД, ОтклонениеПрогнознойПроцентнойСтавки, ПрогнознаяСтавка",
						"По прогнозному значению КБД", 
						"Значение на дату оценки", 
						ПараметрыСпособаРасчета.ТочкаКБД, 
						СтавкаКБД, 
						ПараметрыСпособаРасчета.ОтклонениеПрогнознойПроцентнойСтавки, 
						ПрогнознаяСтавка),
					"Результат расчета");
			КонецЕсли;
			
			#КонецОбласти
			
		ИначеЕсли ПараметрыСпособаРасчета.ВариантРасчетаПрогнозныхЗначенийКБД = "ПрогнознаяКлючеваяПлюсСредняяРазницаМеждуКлючевойИКБДЗа4Года" Тогда
			
			#Область Прогнозная_ключевая_плюс_средняя_разница_между_ключевой_и_КБД_за_4_года
			
			ПрогнозКлючевойСтавки = РегистрыСведений.ПроцентныеПоказатели.ПрогнозноеЗначениеПоказателя(
				Перечисления.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ,
				ДатаОпределенияПрогнозногоЗначения(ПараметрыКупона, ПараметрыОценки),
				ПараметрыСпособаРасчета.ИсточникПрогноза,
				ПараметрыДенежногоПотока.ДатаПереоценки,
				Истина,
				РасшифровкаРасчета);  
				
			Если ПрогнозКлючевойСтавки = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Не удалось определить прогнозное значение ключевой ставки ЦБ РФ на %1 для прогноза показателя '%2' для расчета ставки купона '%3'",
						Формат(ПараметрыКупона.ДатаНачалаКупона, "ДФ=dd.MM.yyyy"), ПараметрыСпособаРасчета.ВидПрогнознойПроцентнойСтавки, Облигация), , , , Отказ);
				Возврат Неопределено;
			КонецЕсли;
			
			// Расчет средней разницы между ключевой ставкой и КБД за 4 года
			
			Если Не ПараметрыПрогноза.Свойство("СредняяРазницаМеждуКлючевойИКБДЗа4Года") Тогда

				#Область Расчет_средней_разницы_между_ключевой_ставкой_и_КБД_за_4_года
				
				ЗапросДанныхЗа4Года = Новый Запрос(
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ДанныеКалендаря.Дата КАК Период
					|ПОМЕСТИТЬ _ДанныеКалендаря
					|ИЗ
					|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
					|ГДЕ
					|	ДанныеКалендаря.Календарь = &КалендарьКотировок
					|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
					|	И ДанныеКалендаря.Дата МЕЖДУ &КалендарныхДней4ГодаНазад И &ДатаПереоценки
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_ДанныеКалендаря.Период КАК Период,
					|	КлючевыеСтавки.ЗначениеПоказателя КАК КлючеваяСтавка,
					|	КлючевыеСтавки.ЗначениеПоказателя ЕСТЬ NULL КАК ОшибкаПолученияКлючевойСтавки,
					|	ПараметрыКривойБескупоннойДоходности.*,
					|	ПараметрыКривойБескупоннойДоходности.ВидПараметра ЕСТЬ NULL КАК ОшибкаПолученияПараметровКБД
					|ИЗ
					|	_ДанныеКалендаря КАК _ДанныеКалендаря
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПроцентныеПоказатели.СрезПоследних(
					|				&ДатаПереоценки,
					|				Показатель = ЗНАЧЕНИЕ(Перечисление.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ)
					|					И Прогноз = ЛОЖЬ) КАК КлючевыеСтавки
