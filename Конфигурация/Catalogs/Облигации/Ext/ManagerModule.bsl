				КонецЕсли;
				
				СтрокаКорзиныОФЗПК.Номинал					= СтрокаТаблицыСтоимостей.Номинал;
				СтрокаКорзиныОФЗПК.Цена						= СтрокаТаблицыСтоимостей.Стоимость;
				СтрокаКорзиныОФЗПК.ВидЦены					= СтрокаТаблицыСтоимостей.ВидЦены;
				СтрокаКорзиныОФЗПК.СрокДоПогашения			= (СтрокаКорзиныОФЗПК.ДатаПогашения - ДатаРасчетаПотока) / 86400 / 365;
				СтрокаКорзиныОФЗПК.ФиксированнаяЧастьКупона	= ПолучитьФиксированнуюЧастьСтавкиКупона(СтрокаКорзиныОФЗПК.ЦеннаяБумага, ДатаРасчетаПотока, Отказ);
				
				Если Отказ = Истина Тогда
					Возврат Неопределено;	
				КонецЕсли;	
					
				СтрокаКорзиныОФЗПК.ПроцентнаяМаржа = СтрокаКорзиныОФЗПК.ФиксированнаяЧастьКупона - (СтрокаКорзиныОФЗПК.Цена - СтрокаКорзиныОФЗПК.Номинал)  / (СтрокаКорзиныОФЗПК.Номинал * СтрокаКорзиныОФЗПК.СрокДоПогашения) * 100;
				СтрокаКорзиныОФЗПК.ВключеноВРасчет = Истина;
				
				ПроцентнаяМаржа = ПроцентнаяМаржа + СтрокаКорзиныОФЗПК.ПроцентнаяМаржа;
				КоличествоОФЗПК = КоличествоОФЗПК + 1;
				
			КонецЦикла;
			
			Если ПараметрыОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020 Тогда
				СредняяПроцентнаяМаржаНадСтоимостьюФондирования = Окр(?(КоличествоОФЗПК > 0, ПроцентнаяМаржа / КоличествоОФЗПК, 0), 2);
			Иначе
				СредняяПроцентнаяМаржаНадСтоимостьюФондирования = Окр(?(КоличествоОФЗПК > 0, ПроцентнаяМаржа / КоличествоОФЗПК, 0), 4);
			КонецЕсли;
			
			ПараметрыПрогноза.Вставить("СредняяПроцентнаяМаржаНадСтоимостьюФондирования", СредняяПроцентнаяМаржаНадСтоимостьюФондирования);
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "КорзинаОФЗПК", КорзинаОФЗПК.Скопировать(), "Корзина ОФЗ-ПК");
				РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "РезультатРасчета", Новый Структура("Значение", СредняяПроцентнаяМаржаНадСтоимостьюФондирования), "Средняя процентная маржа над стоимостью фондирования");
			КонецЕсли;
			
			#КонецОбласти
			
		КонецЕсли;
		
		ПрогнознаяСтавка = ПараметрыПрогноза.КБДДоПогашения - ПараметрыПрогноза.СредняяПроцентнаяМаржаНадСтоимостьюФондирования + ПараметрыСпособаРасчета.ОтклонениеПрогнознойПроцентнойСтавки;
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "РезультатРасчета",
				Новый Структура("СпособРасчета, КБДДоПогашения, СредняяПроцентнаяМаржаНадСтоимостьюФондирования, ОтклонениеПрогнознойПроцентнойСтавки, ПрогнознаяСтавка",
					"Разница КБД до погашения и средней процентной маржи над стоимостью фондирования", ПараметрыПрогноза.КБДДоПогашения, ПараметрыПрогноза.СредняяПроцентнаяМаржаНадСтоимостьюФондирования, ПараметрыСпособаРасчета.ОтклонениеПрогнознойПроцентнойСтавки, ПрогнознаяСтавка),
				"Результат расчета");
		КонецЕсли;			
		
		#КонецОбласти	
		
	ИначеЕсли СпособРасчетаПрогнозныхСтавок	= "ПоЦенеИДоходностиАналогичныхОблигаций" Тогда
		
		#Область По_цене_и_доходности_аналогичных_облигаций
		
		// При наличии хотя бы одного выпуска аналогичных облигаций (срок, объем выпуска) того же эмитента, по которым на дату оценки есть цена активного рынка, 
		// для расчета величины купонов цена принимается равной цене, дающей доходность по аналогичным облигациям.
		// В целях расчета величины каждого отдельного будущего купона они принимаются равными на весь неопределённый оставшийся до погашения период.
		// В случае наличия более одного выпуска аналогичных облигаций того же эмитента (одинаковый срок и объем), по которым на дату оценки есть цена активного рынка,
		// для расчета величины купонов цена принимается равной средней цене таких выпусков.		
		
		Если Не ПараметрыПрогноза.Свойство("АналогиСЦенойАктивногоРынка") Тогда
			
			Если Не ПараметрыПрогноза.Свойство("Аналоги") Тогда	
			
				#Область Получение_аналогов
				
				Запрос = Новый Запрос;
				
				РаботаСПереоценкой.ПоместитьАналогиЦенныхБумагВМенеджерВременныхТаблиц(
					Запрос, Облигация, ПараметрыДенежногоПотока.ДатаПереоценки, ПараметрыОценки.Организация, ПараметрыОценки.Клиент,
					Новый Структура("Назначение", Перечисления.ЦелиИспользованияАналогов.РасчетНеопределенныхКупонов), "_Аналоги");
					
				Запрос.Текст =
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_Аналоги.ЦеннаяБумага КАК ЦеннаяБумага,
					|	Облигация.Эмитент КАК ЭмитентЦеннойБумаги,
					|	Облигация.РазмерЭмиссииШт КАК ОбъемВыпускаЦеннойБумаги,
					|	0 КАК СрокЦеннойБумаги,
					|	_Аналоги.Аналог КАК Аналог,
					|	Аналоги.Эмитент КАК ЭмитентАналога,
					|	Аналоги.РазмерЭмиссииШт КАК ОбъемВыпускаАналога,
					|	0 КАК СрокАналога
					|ИЗ
					|	_Аналоги КАК _Аналоги
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигация
					|		ПО (Облигация.Ссылка = _Аналоги.ЦеннаяБумага)
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Аналоги
					|		ПО (Аналоги.Ссылка = _Аналоги.Аналог)
					|			И (Аналоги.Эмитент = Облигация.Эмитент)
					|			И (Аналоги.ВалютаНоминала = Облигация.ВалютаНоминала)";
				
				АналогиПоЭмитенту = Запрос.Выполнить().Выгрузить();
				
				// #Техдолг переписать функцию ПолучитьДатуИЦенуВыкупа для передачи массива облигаций
				
				ПараметрыВыкупа = ПолучитьДатуИЦенуВыкупа(Облигация, ПараметрыДенежногоПотока.ДатаПереоценки, , ПараметрыОценки.СчетДоверительногоУправления, , Ложь);
				СрокДоВыкупа	= ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(ПараметрыВыкупа.ДатаВыкупа, ПараметрыДенежногоПотока.ДатаПереоценки) / 356;
				
				АналогиПоЭмитенту.ЗаполнитьЗначения(СрокДоВыкупа, "СрокЦеннойБумаги");
				
				Для Каждого СтрокаАналога Из АналогиПоЭмитенту Цикл
					ПараметрыВыкупа				= ПолучитьДатуИЦенуВыкупа(СтрокаАналога.Аналог, ПараметрыДенежногоПотока.ДатаПереоценки, , ПараметрыОценки.СчетДоверительногоУправления, , Ложь);
					СтрокаАналога.СрокАналога	= ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(ПараметрыВыкупа.ДатаВыкупа, ПараметрыДенежногоПотока.ДатаПереоценки) / 356;
				КонецЦикла;	
				
				// Отбор подходящих аналогов (пока не согласован, потому не реализован)
				
				//Запрос = Новый Запрос(
				//	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				//	|	ВсеАналоги.ЦеннаяБумага КАК ЦеннаяБумага,
				//	|	ВсеАналоги.ЭмитентЦеннойБумаги КАК ЭмитентЦеннойБумаги,
				//	|	ВсеАналоги.ОбъемВыпускаЦеннойБумаги КАК ОбъемВыпускаЦеннойБумаги,
				//	|	ВсеАналоги.СрокЦеннойБумаги КАК СрокЦеннойБумаги,
				//	|	ВсеАналоги.Аналог КАК Аналог,
				//	|	ВсеАналоги.ЭмитентАналога КАК ЭмитентАналога,
				//	|	ВсеАналоги.ОбъемВыпускаАналога КАК ОбъемВыпускаАналога,
				//	|	ВсеАналоги.СрокАналога КАК СрокАналога
