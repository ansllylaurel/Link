
&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ОбновитьРазмерЭмиссииСумма(ЭтаФорма);
	
	Элементы.Подкатегория.Видимость = (Объект.Категория = ПредопределенноеЗначение("Перечисление.КатегорииОблигаций.Государственная"));
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		// заполним текущий номинал
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НоминалыЦенныхБумагСрезПоследних.Номинал
			|ИЗ
			|	РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&Период, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследних";
			
		Запрос.УстановитьПараметр("Период",       ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("ЦеннаяБумага", Объект.Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ЭтаФорма.ТекущийНоминал = Выборка.Номинал;
		Иначе
			ЭтаФорма.ТекущийНоминал = 0;
		КонецЕсли;
		
		// определим, является ли эмитент гос. корпорацией
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма
			|ИЗ
			|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, ЮрФизЛицо = &ЮрФизЛицо И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних";
			
		Запрос.УстановитьПараметр("Период",    ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("ЮрФизЛицо", Объект.Эмитент.ЮрФизЛицо);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Элементы.ГосударственнаяКорпорация.Видимость =
			(Выборка.Следующий()
				И (Выборка.ОрганизационноПравоваяФорма = Справочники.ОрганизационноПравовыеФормы.ГосударственнаяКорпорация
						Или Выборка.ОрганизационноПравоваяФорма = Справочники.ОрганизационноПравовыеФормы.ФедеральноеГосударственноеУнитарноеПредприятие));
						
		Элементы.Категория.АвтоМаксимальнаяШирина = Не Элементы.ГосударственнаяКорпорация.Видимость;
		
	КонецЕсли;
	
	УниверсальныеМеханизмы.УстановитьЗаголовокСсылкиОбновить(ЭтаФорма, Объект.Ссылка);
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
КонецПроцедуры // ПриЧтенииСозданииНаСервере

////////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
	РаботаСЦеннымиБумагамиКлиентСервер.ОтборДинамическогоСписка(Коды, Объект);
		
КонецПроцедуры   

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;	
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ РЕКВИЗИТОВ ФОРМЫ

&НаКлиенте
Процедура НоминалПриИзменении(Элемент)
	
	ОбновитьРазмерЭмиссииСумма(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РазмерЭмиссииШтПриИзменении(Элемент)
	
	ОбновитьРазмерЭмиссииСумма(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура СсылкаОбновитьНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Вопрос("Обновить текущий элемент?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		РаботаСВнешнимиСистемами.ОбновитьРеквизитыОбъектаИзМатрикс(Объект.Ссылка);
		
		ЭтаФорма.Прочитать();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьРазмерЭмиссииСумма(Форма)
	
	Форма.РазмерЭмиссииСумма = РаботаСЦеннымиБумагамиКлиентСервер.РассчитатьРазмерЭмиссииСумма(Форма.Объект.РазмерЭмиссииШт, Форма.Объект.Номинал);	
	
	Форма.Элементы.РазмерЭмиссииСумма.Подсказка = Форма.Объект.ВалютаНоминала;
	
КонецПроцедуры
