
Процедура ПередЗаписью(Отказ)
	
	Если ЭтоНовый() Тогда
		
		Для Инд = 0 По ЭтотОбъект.СчетУчета.ВидыСубконто.Количество() - 1 Цикл
			
			ВидСубконто = ЭтотОбъект.СчетУчета.ВидыСубконто[Инд].ВидСубконто;
			
			Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги Тогда
				ЭтотОбъект.ЦеннаяБумага = ЭтотОбъект.ЭтотОбъект["Субконто" + Строка(Инд + 1)];
			ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета Тогда
				ЭтотОбъект.БанковскийСчет = ЭтотОбъект.ЭтотОбъект["Субконто" + Строка(Инд + 1)];
			ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ДепозитныеВклады Тогда
				ЭтотОбъект.ДепозитныйВклад = ЭтотОбъект.ЭтотОбъект["Субконто" + Строка(Инд + 1)];
			ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания Тогда
				ЭтотОбъект.ДоговорБрокерскогоОбслуживания = ЭтотОбъект.ЭтотОбъект["Субконто" + Строка(Инд + 1)];
			ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Договоры Тогда
				ЭтотОбъект.Договор = ЭтотОбъект.ЭтотОбъект["Субконто" + Строка(Инд + 1)];
			ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты Тогда
				ЭтотОбъект.Контрагент = ЭтотОбъект.ЭтотОбъект["Субконто" + Строка(Инд + 1)];
			ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов Тогда
				ЭтотОбъект.ОснованиеРасчетов = ЭтотОбъект.ЭтотОбъект["Субконто" + Строка(Инд + 1)];
			ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ГруппыФинансовогоУчетаДоходовРасходов Тогда
				ЭтотОбъект.ГруппаФинансовогоУчетаДоходовРасходов = ЭтотОбъект.ЭтотОбъект["Субконто" + Строка(Инд + 1)];
			КонецЕсли;	
		
		КонецЦикла;
		
		КодСчетаУчета = ЭтотОбъект.СчетУчета.Код;
		
		КодВалюты = ?(ЭтотОбъект.Валюта.Код = "643", "810", ЭтотОбъект.Валюта.Код);
		
		КодПризнакаДУ = "2";
		
		Если Владелец.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов Тогда
			КодВидаДоговораДУ = "3";
		ИначеЕсли Владелец.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
			КодВидаДоговораДУ = "2";
		ИначеЕсли Владелец.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
			КодВидаДоговораДУ = "1";
		ИначеЕсли Владелец.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЮридическогоЛица Тогда
			КодВидаДоговораДУ = "0";
		ИначеЕсли Владелец.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.Собственный Тогда
			КодВидаДоговораДУ = "0";
		ИначеЕсли Владелец.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеИмуществомСтраховыхКомпаний Тогда
			КодВидаДоговораДУ = "0";
		ИначеЕсли Владелец.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний Тогда
			КодВидаДоговораДУ = "0";
		ИначеЕсли Владелец.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.КонтрольСтраховыхКомпаний Тогда
			КодВидаДоговораДУ = "0";
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЗначенияДополнительныхСведений.Значение
				|ИЗ
				|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
				|ГДЕ
				|	ЗначенияДополнительныхСведений.Свойство.Ключ = &Ключ
				|	И ЗначенияДополнительныхСведений.Объект = &Объект
				|	И ЗначенияДополнительныхСведений.Значение = &Значение";
			
			Запрос.УстановитьПараметр("Значение", Перечисления.ВидыПортфелейСтраховыхКомпаний.ПортфельВДоверительномУправлении);
			Запрос.УстановитьПараметр("Ключ", "СчетаДоверительногоУправления.КонтрольСтраховыхКомпаний.ВидПортфеляСтраховойКомпании");
			Запрос.УстановитьПараметр("Объект", Владелец);
			
			КодПризнакаДУ = "0";
			Если НЕ Запрос.Выполнить().Пустой() Тогда
			    КодПризнакаДУ = "2";
			КонецЕсли;
		Иначе 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определен 10-й символ номера лицевого счета для вида договора ДУ "+Владелец.ВидДоговораДоверительногоУправления,,,,Отказ);
			КодВидаДоговораДУ = "0";
		КонецЕсли;	
		
		КодГФУ = "";
		Если ЗначениеЗаполнено(ЭтотОбъект.ГруппаФинансовогоУчетаДоходовРасходов) Тогда
			КодГФУ = ЭтотОбъект.ГруппаФинансовогоУчетаДоходовРасходов.Код;
		КонецЕсли;
		
		ПрефиксЛС = КодСчетаУчета + КодВалюты + КодПризнакаДУ + КодВидаДоговораДУ + КодГФУ;
		УстановитьНовыйКод(ПрефиксЛС);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	//уберем наименование, т.к. оно заполнится в ПриЗаписи
	ГдеНаименование = ПроверяемыеРеквизиты.Найти("Наименование");
	Если ЭтоНовый() И ГдеНаименование<>Неопределено Тогда
		ПроверяемыеРеквизиты.Удалить(ГдеНаименование);
	КонецЕсли;
	
КонецПроцедуры
