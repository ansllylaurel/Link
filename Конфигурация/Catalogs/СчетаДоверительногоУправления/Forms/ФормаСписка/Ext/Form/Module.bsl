
&НаСервереБезКонтекста
Функция ПолучитьНомерКартинкиЭлементаСправочника(ЭтоГруппа, ПометкаУдаления, Предопределенный)
	
	НомерКартинки = Неопределено;
	
	Если ЭтоГруппа Тогда
		Если Предопределенный Тогда
			НомерКартинки = 4;
		Иначе
			НомерКартинки = ?(ПометкаУдаления, 1, 0);
		КонецЕсли;
	Иначе
		Если Предопределенный Тогда
			НомерКартинки = 5;
		Иначе
			НомерКартинки = ?(ПометкаУдаления, 3, 2);
		КонецЕсли;
	КонецЕсли;
	
	Возврат НомерКартинки;
	
КонецФункции // ПолучитьНомерКартинкиЭлементаСправочника

&НаСервереБезКонтекста
Процедура ПодготовитьДеревоСчетовДУ(ДеревоСчетовДУ, СтратегииДУ, Уровень = 1)
	
	// Дерево счетов д/у имеет фиксированную структуру:
	// 	[Вид_Договора_Доверительного_Управления]
	// 		[Стратегия_Индивидуального_Инвестирования_Если_Есть]
	// 			[Счет_Доверительного_Управления]
	// 				[Стратегия_Доверительного_Управления_Если_Есть]
	//	[Расторгнутые]
	//		[Счет_Доверительного_Управления]
	
	Для Инд = 1 - ДеревоСчетовДУ.Строки.Количество() По 0 Цикл
		СтрокаДеревоСчетовДУ = ДеревоСчетовДУ.Строки[-Инд];
		
		Если Уровень = 1 Тогда // вид договора д/у
			СтрокаДеревоСчетовДУ.Ссылка   = СтрокаДеревоСчетовДУ.ВидДоговораДоверительногоУправления;
			СтрокаДеревоСчетовДУ.Картинка = ПолучитьНомерКартинкиЭлементаСправочника(Истина, (СтрокаДеревоСчетовДУ.ВидДоговораДоверительногоУправления = "Расторгнутые"), Ложь);
			
			ПодготовитьДеревоСчетовДУ(СтрокаДеревоСчетовДУ, СтратегииДУ, Уровень + 1);
			
		ИначеЕсли Уровень = 2 Тогда // стратегия индивид. инвест.
			СтрокаДеревоСчетовДУУровень1 = СтрокаДеревоСчетовДУ.Родитель;
			
			Если СтрокаДеревоСчетовДУУровень1.ИспользуютсяСтратегии Тогда
				СтрокаДеревоСчетовДУ.Ссылка   = СтрокаДеревоСчетовДУ.СтратегияИндивидуальногоИнвестирования;
				СтрокаДеревоСчетовДУ.Картинка = ПолучитьНомерКартинкиЭлементаСправочника(Истина, Ложь, Ложь);
				
				ПодготовитьДеревоСчетовДУ(СтрокаДеревоСчетовДУ, СтратегииДУ, Уровень + 1);
				
			Иначе // группировка по стратегиям индивид. инвест. не требуется
				Для каждого СтрокаДеревоСчетовДУУровень3 Из СтрокаДеревоСчетовДУ.Строки Цикл
					ЗаполнитьЗначенияСвойств(СтрокаДеревоСчетовДУУровень1.Строки.Добавить(), СтрокаДеревоСчетовДУУровень3);
				КонецЦикла;
				
				// удалим пустую стратегию индивид. инвест.
				СтрокаДеревоСчетовДУУровень1.Строки.Удалить(СтрокаДеревоСчетовДУ);
				
				// принудительно вызовем обработку счетов д/у
				ПодготовитьДеревоСчетовДУ(СтрокаДеревоСчетовДУУровень1, СтратегииДУ, 3);
				
			КонецЕсли;
			
		ИначеЕсли Уровень = 3 Тогда // счета д/у
			СтрокаДеревоСчетовДУ.Ссылка   = СтрокаДеревоСчетовДУ.СчетДоверительногоУправления;
			СтрокаДеревоСчетовДУ.Картинка = ПолучитьНомерКартинкиЭлементаСправочника(Ложь, СтрокаДеревоСчетовДУ.ПометкаУдаления, СтрокаДеревоСчетовДУ.Предопределенный);
			
			// отобразим стратегии счетов д/у
			СтрокиСтратегииДУ = СтратегииДУ.НайтиСтроки(Новый Структура("Договор", СтрокаДеревоСчетовДУ.Ссылка));
			
			Для каждого СтрокаСтратегииДУ Из СтрокиСтратегииДУ Цикл
				ПодчСтрокаДеревоСчетовДУ = СтрокаДеревоСчетовДУ.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(ПодчСтрокаДеревоСчетовДУ, СтрокаСтратегииДУ);
				
				ПодчСтрокаДеревоСчетовДУ.Ссылка   = ПодчСтрокаДеревоСчетовДУ.СчетДоверительногоУправления;
				ПодчСтрокаДеревоСчетовДУ.Картинка = ПолучитьНомерКартинкиЭлементаСправочника(Ложь, ПодчСтрокаДеревоСчетовДУ.ПометкаУдаления, ПодчСтрокаДеревоСчетовДУ.Предопределенный);
			КонецЦикла;
			
		КонецЕсли;	
	КонецЦикла
	
КонецПроцедуры // ПодготовитьДеревоСчетовДУ

&НаСервереБезКонтекста
Процедура УпорядочитьМассивСтруктур(МассивСтруктур, ПолеСтруктурыДляУпорядочивания, НаправлениеСортировки = "ВОЗР")
	
	// перенесем структуры в таблицу значений, отдельно выделив поле для сортировки
	ТаблицаСтруктур = Новый ТаблицаЗначений;
	ТаблицаСтруктур.Колонки.Добавить("ПолеУпорядочивания");
	ТаблицаСтруктур.Колонки.Добавить("СтруктураИзМассива");
	
	Для каждого СтруктураИзМассива Из МассивСтруктур Цикл
		СтрокаТаблицыСтруктур = ТаблицаСтруктур.Добавить();
		СтрокаТаблицыСтруктур.ПолеУпорядочивания = СтруктураИзМассива[ПолеСтруктурыДляУпорядочивания];
		СтрокаТаблицыСтруктур.СтруктураИзМассива = СтруктураИзМассива;
	КонецЦикла;
	
	// отсортируем таблицу
	ТаблицаСтруктур.Сортировать("ПолеУпорядочивания " + НаправлениеСортировки);
	
	// перенесем записи в массив в нужном порядке
	МассивСтруктур.Очистить();
	
	Для каждого СтрокаТаблицыСтруктур Из ТаблицаСтруктур Цикл
		МассивСтруктур.Добавить(СтрокаТаблицыСтруктур.СтруктураИзМассива);
	КонецЦикла;
	
КонецПроцедуры // УпорядочитьМассивСтруктур

&НаСервереБезКонтекста
Функция ПроверитьНаличиеПравДоступаНаИнтерактивнуюПометкуУдаление(ПометкаУдаления)
	
	Если ПометкаУдаления
			И Не РаботаСПользователями.ПраваДоступны(Справочники.СчетаДоверительногоУправления.ПустаяСсылка(), "ИнтерактивноеСнятиеПометкиУдаления")
	Тогда
		Возврат Ложь;
		
	ИначеЕсли Не ПометкаУдаления
			И Не РаботаСПользователями.ПраваДоступны(Справочники.СчетаДоверительногоУправления.ПустаяСсылка(), "ИнтерактивнаяПометкаУдаления")
	Тогда
		Возврат Ложь;
		
	КонецЕсли;

	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция УстановитьСнятьПометкуНаУдаление(Ссылка) 

	СчетДУОбъект = Ссылка.ПолучитьОбъект();
	
	Попытка
		СчетДУОбъект.УстановитьПометкуУдаления(Не СчетДУОбъект.ПометкаУдаления, Истина);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось снять/установить пометку удаления. Система сообщает: " + ОписаниеОшибки());
	КонецПопытки;	
	
	Возврат СчетДУОбъект.ПометкаУдаления;
	
КонецФункции // УстановитьСнятьПометкуНаУдаление

&НаСервереБезКонтекста
Функция ЕстьПодчиненныеСтратегии(Договор)
	
	// разрешу пока по собственному РЭМу выбирать родителя
	Если Договор.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.Собственный Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Родитель = &Родитель";
		
	Запрос.УстановитьПараметр("Родитель", Договор);
	
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции // ЕстьПодчиненныеСтратегии


&НаСервере
Процедура ЗаполнитьДеревоСчетовДУКодамиБрокеровНаСервере(ДеревоСчетовДУ, СведенияОДействующихБрокерах, КодыУБрокеров)
	
	Для каждого СтрокаДеревоСчетовДУ Из ДеревоСчетовДУ.Строки Цикл
		Если КодыУБрокеров.Найти(СтрокаДеревоСчетовДУ.Ссылка, "СчетДоверительногоУправления") <> Неопределено Тогда
			Для каждого СведениеОБрокере Из СведенияОДействующихБрокерах Цикл
				СтрокиКодыУБрокеров = КодыУБрокеров.НайтиСтроки(Новый Структура("СчетДоверительногоУправления, ИдентификаторБрокера",
					СтрокаДеревоСчетовДУ.Ссылка, СведениеОБрокере.Идентификатор));
				Если СтрокиКодыУБрокеров.Количество() > 0 Тогда
					СтрокаДеревоСчетовДУ[СведениеОБрокере.Идентификатор] = СтрокиКодыУБрокеров[0].Код;
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;
		
		ЗаполнитьДеревоСчетовДУКодамиБрокеровНаСервере(СтрокаДеревоСчетовДУ, СведенияОДействующихБрокерах, КодыУБрокеров);
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьДеревоСчетовДУКодамиБрокеровНаСервере

&НаСервере
Процедура ДополнитьСчетаДоверительногоУправленаяКодамиУБрокеровНаСервере(ДеревоСчетовДУ)
	
	СведенияОДействующихБрокерах = Новый Массив();
	
	НовыеРеквизитыФормы     = Новый Массив();
	УдаляемыеРеквизитыФормы = Новый Массив();
	УдаляемыеЭлементыФормы  = Новый Массив();
	
	КодыУБрокеров = Новый ТаблицаЗначений();
	КодыУБрокеров.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	КодыУБрокеров.Колонки.Добавить("ИдентификаторБрокера",         Новый ОписаниеТипов("Строка"));
	КодыУБрокеров.Колонки.Добавить("Код",                          Новый ОписаниеТипов("Строка"));
	
	КодыУБрокеров.Индексы.Добавить("СчетДоверительногоУправления, ИдентификаторБрокера");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер КАК Брокер,
		|	ПРЕДСТАВЛЕНИЕ(КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер) КАК ПредставлениеБрокера,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК Код
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(&ТекущаяДата, ) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ТекущаяДата, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания = УсловияДоговоровОбщиеСрезПоследних.Договор
		|ГДЕ
		|	(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения >= &ТекущаяДата)
		|ИТОГИ
		|	КОЛИЧЕСТВО(СчетДоверительногоУправления)
		|ПО
		|	Брокер";	
		
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДата()));
		
	ВыборкаПоБрокерам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// на 1-м уровне у нас лежат брокеры, которые должны попасть в колонки дерева
	Пока ВыборкаПоБрокерам.Следующий() Цикл
		СведенияОБрокере = Новый Структура("Ссылка, Представление, Идентификатор, Приоритет",
			ВыборкаПоБрокерам.Брокер,
			ВыборкаПоБрокерам.ПредставлениеБрокера,
			"Брокер_" + СтрЗаменить(Строка(ВыборкаПоБрокерам.Брокер.УникальныйИдентификатор()), "-", ""),
			ВыборкаПоБрокерам.СчетДоверительногоУправления);
		
		СведенияОДействующихБрокерах.Добавить(СведенияОБрокере);
		
		ВыборкаПоСчетамДУ = ВыборкаПоБрокерам.Выбрать();
		Пока ВыборкаПоСчетамДУ.Следующий() Цикл
			СтрокаКодыУБрокеров = КодыУБрокеров.Добавить();
			СтрокаКодыУБрокеров.СчетДоверительногоУправления = ВыборкаПоСчетамДУ.СчетДоверительногоУправления;
			СтрокаКодыУБрокеров.ИдентификаторБрокера         = СведенияОБрокере.Идентификатор;
			СтрокаКодыУБрокеров.Код                          = ВыборкаПоСчетамДУ.Код;
		КонецЦикла;
		
		// дополним дерево счетов д/у колонками с брокерами
		ДеревоСчетовДУ.Колонки.Добавить(СведенияОБрокере.Идентификатор, Новый ОписаниеТипов("Строка"), СведенияОБрокере.Представление);
		
		Если ЭтаФорма.Элементы.СчетаДоверительногоУправления.ПодчиненныеЭлементы.Найти(СведенияОБрокере.Идентификатор) = Неопределено Тогда // если это не первое обновление, то колонка уже могла быть создана
			// заполним массив новых реквизитов формы
			НовыеРеквизитыФормы.Добавить(Новый РеквизитФормы(СведенияОБрокере.Идентификатор, Новый ОписаниеТипов("Строка"), "СчетаДоверительногоУправления", СведенияОБрокере.Представление));
		КонецЕсли;
	КонецЦикла;	
	
	// удалим поля ввода и реквизиты, связанные с брокерами, отсутствующими в текущей выборке
	Для каждого ПодчПолеВвода Из ЭтаФорма.Элементы.СчетаДоверительногоУправления.ПодчиненныеЭлементы Цикл
		Если Лев(ПодчПолеВвода.Имя, 7) = "Брокер_" Тогда
			ТребуетсяУдаление = Истина;
			
			Для каждого СведенияОБрокере Из СведенияОДействующихБрокерах Цикл
				Если СведенияОБрокере.Идентификатор = ПодчПолеВвода.Имя Тогда
					ТребуетсяУдаление = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ТребуетсяУдаление Тогда
				УдаляемыеРеквизитыФормы.Добавить("СчетаДоверительногоУправления." + ПодчПолеВвода.Имя);
				УдаляемыеЭлементыФормы.Добавить(ПодчПолеВвода.Имя);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого УдаляемыйЭлементФормы Из УдаляемыеЭлементыФормы Цикл
		ЭтаФорма.Элементы.Удалить(ЭтаФорма.Элементы[УдаляемыйЭлементФормы]);
	КонецЦикла;
	
	ЭтаФорма.ИзменитьРеквизиты(НовыеРеквизитыФормы, УдаляемыеРеквизитыФормы);
	
	// создадим реквизиты и дополним дерево на форме колонками
	УпорядочитьМассивСтруктур(СведенияОДействующихБрокерах, "Приоритет", "УБЫВ");
	
	Для каждого НовыйРеквизитФормы Из НовыеРеквизитыФормы Цикл
		ПолеСчетовДУ = ЭтаФорма.Элементы.Добавить(НовыйРеквизитФормы.Имя, Тип("ПолеФормы"), ЭтаФорма.Элементы.СчетаДоверительногоУправления);
		ПолеСчетовДУ.ПутьКДанным = "СчетаДоверительногоУправления." + НовыйРеквизитФормы.Имя;
	КонецЦикла;
	
	
	ЗаполнитьДеревоСчетовДУКодамиБрокеровНаСервере(ДеревоСчетовДУ, СведенияОДействующихБрокерах, КодыУБрокеров);
	
КонецПроцедуры // ДополнитьСчетаДоверительногоУправленаяКодамиУБрокеровНаСервере

&НаСервере
Процедура ОбновитьСчетаДоверительногоУправленияНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА СчетаДоверительногоУправления.ДатаРасторжения <= &ТекущаяДата
		|				И СчетаДоверительногоУправления.ДатаРасторжения <> &ПустаяДата
		|			ТОГДА ""Расторгнутые""
		|		ИНАЧЕ СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления
		|	КОНЕЦ КАК ВидДоговораДоверительногоУправления,
		|	СчетаДоверительногоУправления.ВидСчетаДоверительногоУправления КАК ВидСчетаДоверительногоУправления,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	КлиентыДоверительногоУправления.Клиент КАК Клиент,
		|	ВЫБОР
		|		КОГДА СчетаДоверительногоУправления.ДатаРасторжения <= &ТекущаяДата
		|				И СчетаДоверительногоУправления.ДатаРасторжения <> &ПустаяДата
		|			ТОГДА NULL
		|		ИНАЧЕ СтратегииИндивидуальногоИнвестирования.Стратегия
		|	КОНЕЦ КАК СтратегияИндивидуальногоИнвестирования,
		|	СчетаДоверительногоУправления.КодСчета КАК КодСчета,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ПометкаУдаления КАК ПометкаУдаления,
		|	СчетаДоверительногоУправления.Предопределенный КАК Предопределенный,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоровИспользующиеСтратегии) КАК ИспользуютсяСтратегии,
		|	СчетаДоверительногоУправления.Организация КАК Организация
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(, ) КАК КлиентыДоверительногоУправления
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправления.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(, ) КАК СтратегииИндивидуальногоИнвестирования
		|		ПО СчетаДоверительногоУправления.Ссылка = СтратегииИндивидуальногоИнвестирования.СчетДоверительногоУправления
		|			И (СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоровИспользующиеСтратегии))
		|ГДЕ
		|	ВЫБОР
		|		КОГДА &ОрганизацияФильтр = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ СчетаДоверительногоУправления.Организация = &ОрганизацияФильтр
		|	КОНЕЦ
		|	И СчетаДоверительногоУправления.ВидСчетаДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовДоверительногоУправления.Договор)
		|	И СчетаДоверительногоУправления.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидСчетаДоверительногоУправления,
		|	СчетаДоверительногоУправления.Наименование
		|ИТОГИ
		|	МИНИМУМ(ИспользуютсяСтратегии)
		|ПО
		|	ВидДоговораДоверительногоУправления,
		|	СтратегияИндивидуальногоИнвестирования";
		
	ТекстОтбора = "";
	
	Если ТипЗнч(ЭтаФорма.Отбор) = Тип("Структура") Тогда
		Для каждого ЭлементОтбора Из ЭтаФорма.Отбор Цикл
			
			Если ЭлементОтбора.Ключ = "Владелец" И ТипЗнч(ЭлементОтбора.Значение) = Тип("ПланВидовХарактеристикСсылка.ДополнительныеСведения") Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(ЭлементОтбора.Значение) = Тип("ФиксированныйМассив") Тогда
				ТекстОтбора = ТекстОтбора + " И СчетаДоверительногоУправления." + ЭлементОтбора.Ключ + " В (" + "&" + ЭлементОтбора.Ключ + ")";
			Иначе
				ТекстОтбора = ТекстОтбора + " И СчетаДоверительногоУправления." + ЭлементОтбора.Ключ + " = " + "&" + ЭлементОтбора.Ключ;
			КонецЕсли;
			
			Запрос.УстановитьПараметр(ЭлементОтбора.Ключ, ЭлементОтбора.Значение);
			
		КонецЦикла;
	КонецЕсли;
	
	Если ЭтаФорма.ИсключатьУправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
		ТекстОтбора = ТекстОтбора + " И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)"
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "И СчетаДоверительногоУправления.Ссылка = &Ссылка", ТекстОтбора);
		
	// дерево имеет не более 3-х уровней иерархии (ограничение уровней элементов - 2 + 1 - виды договоров)
	// итого: на 1-м уровне - виды договоров, на 2-м уровне - счета, на 3-м - портфели этого счета, если есть
	Запрос.УстановитьПараметр("ТекущаяДата",						КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ПустаяДата",							Дата(1, 1, 1));
	Запрос.УстановитьПараметр("ВидыДоговоровИспользующиеСтратегии",	Справочники.СтратегииИндивидуальногоИнвестирования.ПолучитьВидыДоговоровИспользующиеСтратегии(ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация")));
	Запрос.УстановитьПараметр("ОрганизацияФильтр",					ОрганизацияФильтр);
	
	ДеревоСчетовДУ = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// определим сортировку видов договоров
	ДеревоСчетовДУ.Колонки.Добавить("Приоритет", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1, 0, ДопустимыйЗнак.Любой)));
	
	Для каждого СтрокаДеревоСчетовДУ Из ДеревоСчетовДУ.Строки Цикл
		Если      СтрокаДеревоСчетовДУ.ВидДоговораДоверительногоУправления = "Паевые инвестиционные фонды" Тогда
			СтрокаДеревоСчетовДУ.Приоритет = 3;
		ИначеЕсли СтрокаДеревоСчетовДУ.ВидДоговораДоверительногоУправления = "Расторгнутые" Тогда
			СтрокаДеревоСчетовДУ.Приоритет = 1;
		Иначе
			СтрокаДеревоСчетовДУ.Приоритет = 2;
		КонецЕсли;
	КонецЦикла;
	
	ДеревоСчетовДУ.Строки.Сортировать("Приоритет УБЫВ, ВидДоговораДоверительногоУправления");
	
	// сведем вид договора и ссылку на объект в одну колонку, определим номер картинки и дополним договоры стратегиями
	ОписаниеТипаКолонки = Новый Массив();
	ОписаниеТипаКолонки.Добавить(Тип("ПеречислениеСсылка.ВидыДоговоровДоверительногоУправления"));
	ОписаниеТипаКолонки.Добавить(Тип("СправочникСсылка.СчетаДоверительногоУправления"));
	ОписаниеТипаКолонки.Добавить(Тип("Строка"));
		
	ДеревоСчетовДУ.Колонки.Добавить("Картинка");
	ДеревоСчетовДУ.Колонки.Добавить("Ссылка", Новый ОписаниеТипов(ОписаниеТипаКолонки));
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.Родитель КАК Договор,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	СчетаДоверительногоУправления.ВидСчетаДоверительногоУправления КАК ВидСчетаДоверительногоУправления,
		|	КлиентыДоверительногоУправления.Клиент КАК Клиент,
		|	СчетаДоверительногоУправления.КодСчета КАК КодСчета,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ПометкаУдаления КАК ПометкаУдаления,
		|	СчетаДоверительногоУправления.Предопределенный КАК Предопределенный,
		|	СчетаДоверительногоУправления.Организация КАК Организация
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(, ) КАК КлиентыДоверительногоУправления
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправления.СчетДоверительногоУправления
		|ГДЕ
		|	ВЫБОР
		|		КОГДА &ОрганизацияФильтр = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ СчетаДоверительногоУправления.Организация = &ОрганизацияФильтр
		|	КОНЕЦ
		|	И СчетаДоверительногоУправления.ВидСчетаДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовДоверительногоУправления.Стратегия)
		|	И СчетаДоверительногоУправления.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетаДоверительногоУправления.Наименование";
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "И СчетаДоверительногоУправления.Ссылка = &Ссылка", ТекстОтбора);
		
	ПодготовитьДеревоСчетовДУ(ДеревоСчетовДУ, Запрос.Выполнить().Выгрузить());
	
	// дополним полученное дерево данными по кодам ДУ
	ДополнитьСчетаДоверительногоУправленаяКодамиУБрокеровНаСервере(ДеревоСчетовДУ);
	
	// передадим полученное дерево в форму
	СчетаДУНаСервере = РеквизитФормыВЗначение("СчетаДоверительногоУправления");
	РаботаСКоллекциями.ДеревоЗначений_ЗаполнитьИзДерева(СчетаДУНаСервере, ДеревоСчетовДУ);
	ЗначениеВРеквизитФормы(СчетаДУНаСервере, "СчетаДоверительногоУправления");	
	
КонецПроцедуры // ОбновитьСчетаДоверительногоУправленияНаСервере

&НаСервере
Процедура УстановитьСвойствоСпискаПоПараметруФормы(Ключ)
	
	Если Параметры.Свойство(Ключ) И ЗначениеЗаполнено(Параметры[Ключ]) Тогда
		Элементы.Список[Ключ] = Параметры[Ключ];
	КонецЕсли;
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЭтаФорма.Параметры.Свойство("РазрешитьВыборСчетаСоСтратегиями") Тогда
		ЭтаФорма.РазрешитьВыборСчетаСоСтратегиями = ЭтаФорма.Параметры.РазрешитьВыборСчетаСоСтратегиями;
	Иначе
		ЭтаФорма.РазрешитьВыборСчетаСоСтратегиями = Ложь;
	КонецЕсли;
	
	// режим списка или выбора
	Если ЭтаФорма.Параметры.РежимВыбора = Истина Тогда // бывает, что и Неопределено
		РежимРаботыФормы = "Выбор";
		ЭтаФорма.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		Элементы.ФормаКомандаВыбрать.Видимость = Истина;
	Иначе
		РежимРаботыФормы = "Список";
		ЭтаФорма.РежимОткрытияОкна = РежимОткрытияОкнаФормы.Независимый;
		Элементы.ФормаКомандаВыбрать.Видимость = Ложь;
	КонецЕсли;
	
	ЭтаФорма.КлючСохраненияПоложенияОкна = РежимРаботыФормы;
	ЭтаФорма.КлючНазначенияИспользования = РежимРаботыФормы;
	
	УстановитьСвойствоСпискаПоПараметруФормы("РежимВыбора");
	УстановитьСвойствоСпискаПоПараметруФормы("ВыборГруппИЭлементов");
	УстановитьСвойствоСпискаПоПараметруФормы("МножественныйВыбор");
	УстановитьСвойствоСпискаПоПараметруФормы("ТекущаяСтрока");
	
	// выборка данных и формирование их представления
	ЭтаФорма.Отбор                                                  = ЭтаФорма.Параметры.Отбор;
	ЭтаФорма.ИсключатьУправлениеАктивамиПаевогоИнвестиционногоФонда = ЭтаФорма.Параметры.Свойство("ИсключатьУправлениеАктивамиПаевогоИнвестиционногоФонда") И ЭтаФорма.Параметры.ИсключатьУправлениеАктивамиПаевогоИнвестиционногоФонда;
	
	ОбновитьСчетаДоверительногоУправленияНаСервере();

	// восстановим текущую строку
	ЭтаФорма.ТекущаяСтрока = ЭтаФорма.Параметры.ТекущаяСтрока;
	
	// ограничение ввода новых при отсутствии соответствующих прав доступа
	ДоступноИнтерактивноеДобавление = ПравоДоступа("ИнтерактивноеДобавление", Метаданные.Справочники.СчетаДоверительногоУправления);
	
	Элементы.СчетаДоверительногоУправления.ИзменятьСоставСтрок = ДоступноИнтерактивноеДобавление;
	Элементы.ФормаКомандаИмпортИИС.Видимость                   = ДоступноИнтерактивноеДобавление;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(ЭтаФорма.ТекущаяСтрока) Тогда
		РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.СчетаДоверительногоУправления, ЭтаФорма.Элементы.СчетаДоверительногоУправления, "Ссылка", ЭтаФорма.ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "СчетаДоверительногоУправления.Обновить" Тогда
		КомандаОбновитьСчетаДоверительногоУправления(Неопределено);
		
		Если Элементы.СчетаДоверительногоУправления.ТекущиеДанные <> Неопределено
				И Элементы.СчетаДоверительногоУправления.ТекущиеДанные.Ссылка <> Параметр
		Тогда
			РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.СчетаДоверительногоУправления, Элементы.СчетаДоверительногоУправления, "Ссылка", Параметр);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура СчетаДоверительногоУправленияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	
	ОткрытьФорму("Справочник.СчетаДоверительногоУправления.ФормаОбъекта");
	
	КомандаОбновитьСчетаДоверительногоУправления(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетаДоверительногоУправленияПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекущиеДанные = ЭтаФорма.Элементы.СчетаДоверительногоУправления.ТекущиеДанные;
	
	Если ТекущиеДанные.ВидСчетаДоверительногоУправления <> ПредопределенноеЗначение("Перечисление.ВидыСчетовДоверительногоУправления.ПустаяСсылка") Тогда
		ОткрытьЗначение(ТекущиеДанные.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетаДоверительногоУправленияПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекущиеДанные = ЭтаФорма.Элементы.СчетаДоверительногоУправления.ТекущиеДанные;
	
	// пропускаем виды договоров
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ВидСчетаДоверительногоУправления) Тогда
		Возврат;
	КонецЕсли;
	
	// пропускаем предопределенные элементы
	Если ТекущиеДанные.Предопределенный Тогда
		Предупреждение("Пометка на удаление предопределенного элемента справочника запрещена.");
		Возврат;
	КонецЕсли;
	
	// проверим наличие прав доступа
	Если Не ПроверитьНаличиеПравДоступаНаИнтерактивнуюПометкуУдаление(ТекущиеДанные.ПометкаУдаления) Тогда
		Предупреждение("Нарушение прав доступа!");
		Возврат;
	КонецЕсли;		
	
	// получим подтверждение и выполним действие
	ТекстВопроса = ?(ТекущиеДанные.ПометкаУдаления, "Снять с """ + ТекущиеДанные.Ссылка + """ пометку на удаление?", "Пометить """ + ТекущиеДанные.Ссылка + """ на удаление?");
	Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.ПометкаУдаления = УстановитьСнятьПометкуНаУдаление(ТекущиеДанные.Ссылка);
	ТекущиеДанные.Картинка        = ПолучитьНомерКартинкиЭлементаСправочника(Ложь, ТекущиеДанные.ПометкаУдаления, ТекущиеДанные.Предопределенный);

	ОповеститьОбИзменении(Тип("СправочникСсылка.СчетаДоверительногоУправления"));
	
КонецПроцедуры

&НаКлиенте
Процедура СчетаДоверительногоУправленияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьМассивВыбора(ВыделенныеСтроки)
	
	Для Каждого ЭлементВыделеннойСтроки Из ВыделенныеСтроки Цикл
		
		Если ТипЗнч(ЭлементВыделеннойСтроки) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
			ЭлементКоллекцииСчетаДоверительногоУправления = ЭлементВыделеннойСтроки;	
		ИначеЕсли ТипЗнч(ЭлементВыделеннойСтроки) = Тип("Число") Тогда	
			ЭлементКоллекцииЭлементВыделеннойСтроки = СчетаДоверительногоУправления.НайтиПоИдентификатору(ЭлементВыделеннойСтроки);
			
			Если ЭлементКоллекцииЭлементВыделеннойСтроки <> Неопределено Тогда	
				ЭлементКоллекцииСчетаДоверительногоУправления = ЭлементКоллекцииЭлементВыделеннойСтроки.Ссылка;	
			КонецЕсли;	
		Иначе	
			ЭлементКоллекцииСчетаДоверительногоУправления = Неопределено;
		КонецЕсли;	
		
		Если ЭлементКоллекцииСчетаДоверительногоУправления <> Неопределено Тогда
			Если ТипЗнч(ЭлементКоллекцииСчетаДоверительногоУправления) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда	
				
				Если Не ЭтаФорма.РазрешитьВыборСчетаСоСтратегиями И ЕстьПодчиненныеСтратегии(ЭлементКоллекцииСчетаДоверительногоУправления) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Счет ДУ: " + ЭлементКоллекцииСчетаДоверительногоУправления + ". Выбор счетов д/у с подчиненными стратегиями запрещен.");
				Иначе	
					ОповеститьОВыборе(ЭлементКоллекцииСчетаДоверительногоУправления, Истина);
				КонецЕсли;
				
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ЭтаФорма.КлючНазначенияИспользования = "Выбор" Тогда
		СтандартнаяОбработка = Ложь;
		Если Элементы.Список.РежимВыбора И Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаДерево Тогда
			
			ОбработатьМассивВыбора(Элементы.СчетаДоверительногоУправления.ВыделенныеСтроки);
			
		ИначеЕсли Элементы.Список.РежимВыбора И Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаСписок Тогда
			
			ОбработатьМассивВыбора(Элементы.Список.ВыделенныеСтроки);
			
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// КОМАНДЫ

&НаКлиенте
Процедура КомандаОбновитьСчетаДоверительногоУправления(Команда)
	
	ПолеКлючевогоУзла     = "Ссылка";
	КлючиРазвернутыхСтрок = Неопределено;
	
	РаботаСФормамиКлиент.ПолучитьКлючиРазвернутыхСтрокДерева(ЭтаФорма.СчетаДоверительногоУправления, Элементы.СчетаДоверительногоУправления, ПолеКлючевогоУзла, КлючиРазвернутыхСтрок);
	
	КлючТекущейСтроки = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.СчетаДоверительногоУправления, ПолеКлючевогоУзла);
	
	ОбновитьСчетаДоверительногоУправленияНаСервере();
	
	РаботаСФормамиКлиент.ВосстановитьРазвернутыеСтрокиДереваПоКлючу(ЭтаФорма.СчетаДоверительногоУправления, ЭтаФорма.Элементы.СчетаДоверительногоУправления, ПолеКлючевогоУзла, КлючиРазвернутыхСтрок);
	РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.СчетаДоверительногоУправления, ЭтаФорма.Элементы.СчетаДоверительногоУправления, ПолеКлючевогоУзла, КлючТекущейСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыбрать(Команда)
	
	СписокВыбор(,,,);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаРазвернутьВсеВидыДоговоров(Команда)
	
	Для каждого СтрокаСчетаДоверительногоУправления Из ЭтаФорма.СчетаДоверительногоУправления.ПолучитьЭлементы() Цикл
		Элементы.СчетаДоверительногоУправления.Развернуть(СтрокаСчетаДоверительногоУправления.ПолучитьИдентификатор());
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСвернутьВсеВидыДоговоров(Команда)
	
	Для каждого СтрокаСчетаДоверительногоУправления Из ЭтаФорма.СчетаДоверительногоУправления.ПолучитьЭлементы() Цикл
		Элементы.СчетаДоверительногоУправления.Свернуть(СтрокаСчетаДоверительногоУправления.ПолучитьИдентификатор());
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаИмпортИИС(Команда)
	
	ПолучитьФорму("Справочник.СчетаДоверительногоУправления.Форма.ИмпортИИС",, ЭтаФорма).ОткрытьМодально();
	
	КомандаОбновитьСчетаДоверительногоУправления(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт

	КомандаОбновитьСчетаДоверительногоУправления(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияФильтрПриИзменении(Элемент)
	
	ОбновитьСчетаДоверительногоУправленияНаСервере();
	
КонецПроцедуры
