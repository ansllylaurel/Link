Процедура КомандаИзменитьКлиента(Команда)
	
	ПараметрыФормы = Новый Структура("Отбор",
		Новый Структура("СчетДоверительногоУправления", Объект.Ссылка));
	
	ОткрытьФормуМодально("РегистрСведений.КлиентыДоверительногоУправления.ФормаСписка", ПараметрыФормы, ЭтаФорма);
	
