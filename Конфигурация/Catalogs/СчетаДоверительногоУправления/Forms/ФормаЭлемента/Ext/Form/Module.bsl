// СОБЫТИЯ РЕКВИЗИТОВ ФОРМЫ

&НаКлиенте
Процедура РодительПриИзменении(Элемент)
	
	// заполним реквизиты текущего элемента
	ЗаполнитьРеквизитыИзРодителяНаСервере();
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипКлиентаПриИзменении(Элемент)
	
	Если      ЭтаФорма.ТипКлиента = 1 Тогда // юр/физ лицо
		Объект.ВидДоговораДоверительногоУправления = Неопределено;
	ИначеЕсли ЭтаФорма.ТипКлиента = 2 Тогда // ПИФ
		Объект.ВидДоговораДоверительногоУправления = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда");
	КонецЕсли;
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентПриИзменении(Элемент)
	
	ВывестиРеквизитыФизЮрЛицаНаСервере();
	
	Объект.РасчетныеСчета.Очистить();
	
	// т.к. не все реквизиты, необходимые для формирования наименования, лежат в объекте
	// приходится немного извратиться
	Реквизиты = Новый Структура("Ссылка, Клиент, ЛичныйКабинет, Наименование", Объект.Ссылка, ЭтаФорма.Клиент, Объект.ЛичныйКабинет, Объект.Наименование);
	
	РаботаСНормативноСправочнойИнформациейКлиент.УстановитьНовоеНаименование(Реквизиты);
	
	Объект.Наименование = Реквизиты.Наименование;
	
	УстановитьОтборДоверенностейНаСервере();	
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЛичныйКабинетПриИзменении(Элемент)
	
	// т.к. не все реквизиты, необходимые для формирования наименования, лежат в объекте
	// приходится немного извратиться
	Реквизиты = Новый Структура("Ссылка, Клиент, ЛичныйКабинет, Наименование", Объект.Ссылка, ЭтаФорма.Клиент, Объект.ЛичныйКабинет, Объект.Наименование);
	
	РаботаСНормативноСправочнойИнформациейКлиент.УстановитьНовоеНаименование(Реквизиты);
	
	Объект.Наименование = Реквизиты.Наименование;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидСчетаДоверительногоУправленияПриИзменении(Элемент)
	
	Если Объект.ВидСчетаДоверительногоУправления = ПредопределенноеЗначение("Перечисление.ВидыСчетовДоверительногоУправления.Стратегия") Тогда
		Объект.Родитель = Неопределено;
		ЗаполнитьРеквизитыИзРодителяНаСервере();
	КонецЕсли;
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидДоговораДоверительногоУправленияПриИзменении(Элемент)
	
	ЗаполнитьКодСчетаНаСервере();	
	
	УстановитьОтборДоверенностейНаСервере();
	
	НастроитьВидимостьДоступность(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура СведенияОДоговорахВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ТекущиеДанные = Элементы.СведенияОДоговорах.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ДобавленоВручную Тогда
		
		КлючЗаписи = СоздатьКлючЗаписиИсполнителяПоДоговорам(Объект.Организация, Объект.Ссылка, ТекущиеДанные.Договор, ТекущаяДата());
		Если КлючЗаписи = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура("Ключ", КлючЗаписи);
		
		ОткрытьФорму("РегистрСведений.ДоговорыСчетовДоверительногоУправления.ФормаЗаписи", ПараметрыФормы, ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли ТекущиеДанные.Договор <> Объект.Ссылка Тогда
		
		ОткрытьЗначение(ТекущиеДанные.Договор);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВознаграждениеНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	ОтборНастроек = Новый Структура("Организация, СчетДоверительногоУправления, ВидВознаграждения", Объект.Организация, Объект.Ссылка);
	
	// Определяем вид вознаграждения
	
	Если Элемент = Элементы.ВознаграждениеЗаРазмещение Тогда
		
		ОтборНастроек.ВидВознаграждения = ПредопределенноеЗначение("Перечисление.ВидыВознагражденийУправляющего.ВознаграждениеЗаРазмещение");	
		
	ИначеЕсли Элемент = Элементы.ВознаграждениеУправляющего Тогда
		
		ОтборНастроек.ВидВознаграждения = ПредопределенноеЗначение("Перечисление.ВидыВознагражденийУправляющего.ВознаграждениеУправляющего");	
		
	ИначеЕсли Элемент = Элементы.ПлановоеВознаграждениеУправляющего Тогда
		
		ОтборНастроек.ВидВознаграждения = ПредопределенноеЗначение("Перечисление.ВидыВознагражденийУправляющего.ПлановоеВознаграждениеУправляющего");	
		
	КонецЕсли;
	
	Стратегия = СвойстваСтратегииИндивидуальногоИнвестирования(Объект.Ссылка);
	
	// Определяем форму
	
	Если ЗначениеЗаполнено(Стратегия) И Стратегия.Стандартная Тогда
		
		ПараметрыФормы = Новый Структура("Ключ", Стратегия.Ссылка); 
		
		ОткрытьФормуМодально("Справочник.СтратегииИндивидуальногоИнвестирования.Форма.ФормаЭлемента", ПараметрыФормы, ЭтаФорма);	
	
	ИначеЕсли НайтиНастройкиРасчетаВознагражденияУправляющего(ОтборНастроек) Тогда
		
		ПараметрыФормы = Новый Структура("Отбор", ОтборНастроек); 
		
		ОткрытьФормуМодально("РегистрСведений.НастройкиРасчетаВознагражденияУправляющего.ФормаСписка", ПараметрыФормы, ЭтаФорма);	
		
	ИначеЕсли Не РаботаСПользователями.ПраваДоступны("РегистрСведений.НастройкиРасчетаВознагражденияУправляющего", "Редактирование") Тогда
		
		Возврат; // Если нет прав на редактирование, ничего не делаем	
		
	Иначе
		
		ОтборНастроек.Вставить("Период", Объект.ДатаЗаключения); 
		
		ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ОтборНастроек); 
		
		ОткрытьФормуМодально("РегистрСведений.НастройкиРасчетаВознагражденияУправляющего.ФормаЗаписи", ПараметрыФормы, ЭтаФорма);	
		
	КонецЕсли;
	
	// Обновляем данные расчета
	
	ЗаполнитьНастройкиРасчетаВознагражденияУправляющего(ЭтаФорма);	
	
КонецПроцедуры

&НаКлиенте
