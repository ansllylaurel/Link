
&НаСервереБезКонтекста
Процедура УдалитьКлиентовДоверительногоУправления(СчетДоверительногоУправления)
	
	КлиентыДоверительногоУправления = РегистрыСведений.КлиентыДоверительногоУправления.СоздатьНаборЗаписей();
	КлиентыДоверительногоУправления.Отбор.СчетДоверительногоУправления.Установить(СчетДоверительногоУправления);
	КлиентыДоверительногоУправления.Прочитать();
	
	Если КлиентыДоверительногоУправления.Количество() > 0 Тогда
		КлиентыДоверительногоУправления.Очистить();
		КлиентыДоверительногоУправления.Записать();
	КонецЕсли;
	
КонецПроцедуры // УдалитьКлиентовДоверительногоУправления

&НаСервереБезКонтекста
Функция ОпределитьНовыйКодСчета(Организация, ВидДоговораДоверительногоУправления, ТекущийНомерСчета)
	
	Возврат Справочники.СчетаДоверительногоУправления.ОпределитьНовыйКодСчета(Организация, ВидДоговораДоверительногоУправления, ТекущийНомерСчета);
	
КонецФункции // ОпределитьНовыйКодСчета

&НаСервереБезКонтекста
Функция ЗаполнитьСопутствующиеНастройкиНовогоСчета(СчетДоверительногоУправления)
	
	Справочники.СчетаДоверительногоУправления.ЗаполнитьСопутствующиеНастройкиНовогоСчета(СчетДоверительногоУправления);
	
КонецФункции // ЗаполнитьСопутствующиеНастройкиНовогоСчета

&НаСервереБезКонтекста
Функция ЕстьДочерниеСтратегии(СчетДоверительногоУправления)

	Возврат Справочники.СчетаДоверительногоУправления.ЕстьДочерниеСтратегии(СчетДоверительногоУправления);

КонецФункции 

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступность(Форма)
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
	СчетДУЗаписан					= ЗначениеЗаполнено(Объект.Ссылка);
	
	ЭтоСтратегия					= (Объект.ВидСчетаДоверительногоУправления = ПредопределенноеЗначение("Перечисление.ВидыСчетовДоверительногоУправления.Стратегия"));
	
	ВидыДоговоровДоверительногоУправления = РаботаСМетаданнымиПовтИсп.ЗначенияПеречисленияВСтруктуру("ВидыДоговоровДоверительногоУправления");
	
	ЭтоИИС							= (Объект.ВидДоговораДоверительногоУправления = ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет);		
	ЭтоУправлениеАктивамиФизЛица	= (Объект.ВидДоговораДоверительногоУправления = ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица);		
	ЭтоУправлениеАктивамиАИФ		= (Объект.ВидДоговораДоверительногоУправления = ВидыДоговоровДоверительногоУправления.УправлениеАктивамиАкционерныхИнвестиционныхФондов);		
	ЭтоУправлениеАктивамиПИФ		= (Объект.ВидДоговораДоверительногоУправления = ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда);		
	ЭтоУправлениеАктивамиПФР		= (Объект.ВидДоговораДоверительногоУправления = ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР);		
	ЭтоУправлениеАктивамиЦК			= (Объект.ВидДоговораДоверительногоУправления = ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов);		
	ЭтоУправлениеПН					= (Объект.ВидДоговораДоверительногоУправления = ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями);		
	ЭтоУправлениеПР					= (Объект.ВидДоговораДоверительногоУправления = ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);		
	ЭтоСчетКонтроля					= (Объект.ВидДоговораДоверительногоУправления = ВидыДоговоровДоверительногоУправления.КонтрольСаморегулируемыхОрганизаций
										ИЛИ Объект.ВидДоговораДоверительногоУправления = ВидыДоговоровДоверительногоУправления.КонтрольСтраховыхКомпаний);
	ЭтоСобственный					= (Объект.ВидДоговораДоверительногоУправления = ВидыДоговоровДоверительногоУправления.Собственный);		
										
	ЭтоКлиентЮрФизЛицо				= (Форма.ТипКлиента = 1);									
	ЭтоКлиентПИФ					= (Форма.ТипКлиента = 2);									
	
	// Установим справочник-источник для заполнения клиента
	
	Если ЭтоКлиентЮрФизЛицо Тогда
		Элементы.Клиент.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица");
	ИначеЕсли ЭтоКлиентПИФ Тогда
		Элементы.Клиент.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ПаевыеИнвестиционныеФонды");
	КонецЕсли;
	
	// условия договора д/у для контроля страховых компаний не отображаются
			
	Элементы.ГруппаУсловияДоговораДоверительногоУправления.Видимость = (Не ЭтоСчетКонтроля И НЕ ЭтоСобственный);
	
	// редактирование клиента из формы счета д/у осуществляется только для нового договора,
	// подчиненные договорам стратегии заполняются автоматически из реквизитов договора
	
	Элементы.ТипКлиента.ТолькоПросмотр = СчетДУЗаписан ИЛИ ЭтоСтратегия;
	Элементы.Клиент.ТолькоПросмотр     = СчетДУЗаписан ИЛИ ЭтоСтратегия;
	
	Элементы.Родитель.Видимость               = ЭтоСтратегия;
	Элементы.КомандаИзменитьКлиента.Видимость = СчетДУЗаписан И Не ЭтоСтратегия;
	
	Элементы.ВидДоговораДоверительногоУправления.Видимость			= Не ЭтоСтратегия;
	Элементы.ВидДоговораДоверительногоУправленияСтратегии.Видимость	= ЭтоСтратегия;
	
	Элементы.ВидДоговораДоверительногоУправления.ТолькоПросмотр	         = ЭтоКлиентПИФ;	
	Элементы.ВидДоговораДоверительногоУправленияСтратегии.ТолькоПросмотр = ЭтоКлиентПИФ;
	
	Элементы.СтраницаКодыСчетовДоверительногоУправленияУБрокеров.Доступность      = СчетДУЗаписан;
	Элементы.СтраницаИсполнителиПоЦеннымБумагамИНастройкиУчетаДоходов.Доступность = СчетДУЗаписан;
	Элементы.СтраницаИсполнителиПоДенежнымСредствамСобственные.Доступность        = СчетДУЗаписан;
	Элементы.СтраницаИсполнителиПоДенежнымСредствамБрокерские.Доступность         = СчетДУЗаписан;
	Элементы.СтраницаДоговоры.Доступность									      = СчетДУЗаписан;
	
	// Для ИИС и физ.лиц отображаем стратегию
	
	ВидыДоговоровИспользующиеСтратегии	= ПолучитьВидыДоговоровИспользующиеСтратегии(Объект.Организация);
	ДоговорИспользуетСтратегию			= (ВидыДоговоровИспользующиеСтратегии.Найти(Объект.ВидДоговораДоверительногоУправления) <> Неопределено);
	
	Элементы.ГруппаСтратегииИндивидуальногоИнвестирования.Видимость	= СчетДУЗаписан И ДоговорИспользуетСтратегию;
	Элементы.ГруппаИнвестиционныеПрофили.Видимость					= СчетДУЗаписан И ДоговорИспользуетСтратегию;
	Элементы.Стратегия.Видимость									= Не СчетДУЗаписан И ДоговорИспользуетСтратегию;

	Если Элементы.Стратегия.Видимость Тогда												
		Элементы.Стратегия.СписокВыбора.ЗагрузитьЗначения(ПолучитьМассивДоступныхСтратегий(Объект.ВидДоговораДоверительногоУправления));
	КонецЕсли;
	
	// для ПИФ-а мы являемся управляющей компанией, так что договор не актуален
	
	Элементы.СтраницаДоговор.Видимость = ЭтоКлиентЮрФизЛицо;
	
	Элементы.СтраницаЛицензии.Видимость = НЕ (ЭтоИИС ИЛИ ЭтоУправлениеАктивамиФизЛица ИЛИ ЭтоУправлениеАктивамиАИФ ИЛИ ЭтоУправлениеАктивамиПИФ);
	
	// Акцептование используется для ПИФов, ПФР и НПФ (ПН и ПР)
	
	ВидимостьАкцептования = ЭтоКлиентПИФ ИЛИ ЭтоУправлениеАктивамиПФР ИЛИ ЭтоУправлениеПН ИЛИ ЭтоУправлениеПР;
	
	Элементы.КодыСчетовДоверительногоУправленияУБрокеровКомандаАкцептоватьОперацииПоДоговоруСБрокером.Видимость	= ВидимостьАкцептования;
	Элементы.КодыСчетовДоверительногоУправленияУБрокеровГруппаАкцепты.Видимость									= ВидимостьАкцептования;
	Элементы.ИсполнителиПоДенежнымСредствамСобственныеКомандаАкцептоватьОперацииПоРасчетномуСчету.Видимость		= ВидимостьАкцептования;
	Элементы.ИсполнителиПоДенежнымСредствамСобственныеГруппаАкцепты.Видимость									= ВидимостьАкцептования; 
	
	// Для ПН и ПР необходимо уточнить вид договора
	
	Элементы.ВидДоговораПоУправлениюПенсионнымиНакоплениямиИРезервами.Видимость = ЭтоУправлениеПН Или ЭтоУправлениеПР;
		
	Если Элементы.ВидДоговораПоУправлениюПенсионнымиНакоплениямиИРезервами.Видимость Тогда
		
		МассивВидовДоговоровПоУправлениюПНиПР = ПолучитьМассивВидовДоговоровПоУправлениюПенсионнымиНакоплениямиИРезервами(Объект.ВидДоговораДоверительногоУправления);
		
		Элементы.ВидДоговораПоУправлениюПенсионнымиНакоплениямиИРезервами.СписокВыбора.ЗагрузитьЗначения(МассивВидовДоговоровПоУправлениюПНиПР);
		Элементы.ВидДоговораПоУправлениюПенсионнымиНакоплениямиИРезервами.Заголовок = ?(ЭтоУправлениеПН, "Вид накоплений", "Вид резервов");
		
	КонецЕсли;
	
	// Прочее
	
	Элементы.ГруппаДатыДляПИФ.Видимость = ЭтоКлиентПИФ;
	
	Элементы.ГруппаЦелевойКапитал.Видимость = ЭтоУправлениеАктивамиЦК;
	Элементы.УсловияДоговоровДоверительногоУправленияНаименованиеЦелевогоКапитала.Видимость = ЭтоУправлениеАктивамиЦК;
	Элементы.УсловияДоговоровДоверительногоУправленияНаправлениеИспользованияЦелевогоКапитала.Видимость = ЭтоУправлениеАктивамиЦК;
	
	Элементы.ВестиКонсолидированныйБухгалтерскийУчет.Видимость = Не ЭтоСтратегия И ЕстьДочерниеСтратегии(Объект.Ссылка);	
	
	Элементы.СтраницаИнвестиционныеДекларации.Видимость = ПолучитьВидимостьСтраницыИнвестиционныеДекларации();
	
	Элементы.ОплатаВознагражденияУправляющегоИУслугСпецдепозитарияИзСобственныхСредствКлиента.Видимость = 
		ЭтоВидДоговораСВозможностьюОплатыВознагражденияУправляющегоИзСобственныхСредствКлиента(Объект.ВидДоговораДоверительногоУправления);
		
КонецПроцедуры // НастроитьВидимостьИДоступность

&НаСервереБезКонтекста
Функция ЭтоВидДоговораСВозможностьюОплатыВознагражденияУправляющегоИзСобственныхСредствКлиента(ВидДоговораДоверительногоУправления)
	
	Возврат РегистрыСведений.УсловияДоговоровДоверительногоУправления.ДляВидаДоговораДУВозможнаОплатаВознагражденияУправляющегоИРасходовСпецдепозитарияИзСобственныхСредствКлиента(ВидДоговораДоверительногоУправления);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборыПоВедомымРегистрам(Форма)
	
	Объект = Форма.Объект;
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.КодыСчетовДоверительногоУправленияУБрокеров.Отбор, "СчетДоверительногоУправления",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.СтратегииИндивидуальногоИнвестирования.Отбор, "СчетДоверительногоУправления",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.СтратегииИндивидуальногоИнвестирования.Отбор, "Организация",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Организация, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.ИсполнителиПоЦеннымБумагам.Отбор, "СчетДоверительногоУправления",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.ИсполнителиПоДенежнымСредствамСобственные.Отбор, "СчетДоверительногоУправления",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.ИсполнителиПоДенежнымСредствамБрокерские.Отбор, "СчетДоверительногоУправления",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);

	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.СтатусыЛицензий.Отбор, "ЮрФизЛицо",,
		ВидСравненияКомпоновкиДанных.Равно, Форма.Клиент, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.ДополнительныеСоглашения.Отбор, "Основание",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.ДополнительныеСоглашения.Отбор, "ВидДоговора",,
		ВидСравненияКомпоновкиДанных.Равно, ПредопределенноеЗначение("Перечисление.ВидыДоговоров.ДополнительноеСоглашение"), Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.ИнвестиционныеПрофили.Отбор, "СубъектУчета",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.СведенияОДоговорах.Отбор, "СчетДоверительногоУправления",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.НастройкиУчетаДоходовПоЦеннымБумагам.Отбор, "СчетДоверительногоУправления",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
КонецПроцедуры // УстановитьОтборыПоВедомымРегистрам

&НаСервере
Процедура ЗаполнитьРеквизитыИзРодителяНаСервере()
	
	ЗаполнитьЗначенияСвойств(Объект, Объект.Родитель, "ВидДоговораДоверительногоУправления, НомерДоговора, ДатаЗаключения, ДатаРасторжения, СпециализированныйДепозитарий");	
	
	ЭтаФорма.ТипКлиента = ?(ТипЗнч(ЭтаФорма.Клиент) = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды"), 2, 1);
	
КонецПроцедуры // ЗаполнитьИзРодителяНаСервере

&НаСервере
Процедура ВывестиРеквизитыФизЮрЛицаНаСервере()
	
	РаботаСНормативноСправочнойИнформацией.ВывестиРеквизитыЮрФизЛица(ЭтаФорма.Клиент, ЭтаФорма, "СтраницаРеквизитыКлиента", Истина, Истина, Истина, Истина, Объект.Организация);
	
	ОбработатьДатуПрекращенияИДатуПолученияДокументов();
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьДатуПрекращенияИДатуПолученияДокументов()
	
	ПоказыватьДополнительныеЭлементы = (ТипЗнч(ЭтаФорма.Клиент) = Тип("СправочникСсылка.ЮрФизЛица") И ЭтаФорма.Клиент.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо);
	
	ДополнительныеЭлементы = Новый Массив;
	ДополнительныеЭлементы.Добавить(Новый Структура("Родитель, Имя, Заголовок, ПутьКДанным, Подсказка, ОтображениеПодсказки", Элементы.ГруппаДатаПрекращенияИДатаПолученияДокументов, "ДатаПрекращенияДоговораФизЛица", "Дата прекращения", "ФизЛицоДатаСмерти", "Дата смерти физического лица, в остальных случаях пустое поле", ОтображениеПодсказки.Кнопка));
	ДополнительныеЭлементы.Добавить(Новый Структура("Родитель, Имя, Заголовок, ПутьКДанным, Подсказка, ОтображениеПодсказки", Элементы.ГруппаДатаПрекращенияИДатаПолученияДокументов, "ДатаПолученияДокументовОПрекращенииФизЛица", "Дата получения документов", "ФизЛицоДатаПолученияДокументовОСмерти", "Дата получения документов о смерти физического лица, в остальных случаях пустое поле", ОтображениеПодсказки.Кнопка));
	
	Для Каждого ДополнительныйЭлемент Из ДополнительныеЭлементы Цикл
		
		ЭлементСуществует = (Элементы.Найти(ДополнительныйЭлемент.Имя) <> Неопределено);
		
		Если ПоказыватьДополнительныеЭлементы И НЕ ЭлементСуществует Тогда
			НовыйЭлемент = Элементы.Добавить(ДополнительныйЭлемент.Имя, Тип("ПолеФормы"), ДополнительныйЭлемент.Родитель);
			НовыйЭлемент.Вид         	= ВидПоляФормы.ПолеВвода;
			НовыйЭлемент.ТолькоПросмотр = Истина;

			ЗаполнитьЗначенияСвойств(НовыйЭлемент, ДополнительныйЭлемент,, "Родитель, Имя");
		КонецЕсли;
		
		Если ЭлементСуществует Тогда
			Элементы[ДополнительныйЭлемент.Имя].Видимость = ПоказыватьДополнительныеЭлементы;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	ЭтаФорма.Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(Объект.Ссылка);
	
	Если      ТипЗнч(ЭтаФорма.Клиент) = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды") Тогда
		ЭтаФорма.ТипКлиента = 2;
	ИначеЕсли ТипЗнч(ЭтаФорма.Клиент) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
		ЭтаФорма.ТипКлиента = 1;
	ИначеЕсли Не ЗначениеЗаполнено(Объект.Ссылка) Тогда // значение по умолчанию при создании нового объекта
		ЭтаФорма.ТипКлиента = 1;
	Иначе
		ЭтаФорма.ТипКлиента = 0;
	КонецЕсли;

	ВывестиРеквизитыФизЮрЛицаНаСервере();
	
	ЗаполнитьНастройкиРасчетаВознагражденияУправляющего(ЭтаФорма);
	ЗаполнитьУсловияДоговоровДоверительногоУправления();
	ЗаполнитьДополнительныеСведенияНаСервере();
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры // ПриЧтенииСозданииНаСервере

&НаКлиенте
Процедура Подключаемый_УсловияИзменитьНажатие(Элемент) // используется при динамическом отображении условий сделки
	
	ЮрФизЛицоКлиента = РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицоКлиента(ЭтаФорма.Клиент);
	
	Если Не ЗначениеЗаполнено(ЮрФизЛицоКлиента) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран клиент");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Ключ, ОткрытьНаСтраницеПравилаИЛицензия", ЮрФизЛицоКлиента, Истина);
	ОткрытьФорму("Справочник.ПаевыеИнвестиционныеФонды.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;   
	
	ЭтаФорма.ЭтоНовый = Объект.Ссылка.Пустая(); //после записи нового формируем оповещение
		
	ПриЧтенииСозданииНаСервере();
	
	// параметры списков по исполнителям
	ЭтаФорма.ИсполнителиПоЦеннымБумагам.Параметры.УстановитьЗначениеПараметра("ТекущаяДата",        ТекущаяДатаСеанса());
	ЭтаФорма.ИсполнителиПоЦеннымБумагам.Параметры.УстановитьЗначениеПараметра("ОтображатьЗакрытые", Элементы.ИсполнителиПоЦеннымБумагамКомандаОтобразитьЗакрытыхИсполнителейПоЦеннымБумагам.Пометка);
	
	ЭтаФорма.ИсполнителиПоДенежнымСредствамСобственные.Параметры.УстановитьЗначениеПараметра("ТекущаяДата",        ТекущаяДатаСеанса());
	ЭтаФорма.ИсполнителиПоДенежнымСредствамСобственные.Параметры.УстановитьЗначениеПараметра("ОтображатьЗакрытые", Элементы.ИсполнителиПоДенежнымСредствамСобственныеКомандаОтобразитьЗакрытыхИсполнителейПоДенежнымСредствамСобственным.Пометка);
	
	ЭтаФорма.ИсполнителиПоДенежнымСредствамБрокерские.Параметры.УстановитьЗначениеПараметра("ТекущаяДата",        ТекущаяДатаСеанса());
	ЭтаФорма.ИсполнителиПоДенежнымСредствамБрокерские.Параметры.УстановитьЗначениеПараметра("ОтображатьЗакрытые", Элементы.ИсполнителиПоДенежнымСредствамБрокерскиеКомандаОтобразитьЗакрытыхИсполнителейПоДенежнымСредствамБрокерским.Пометка);
	
	ЭтаФорма.КодыСчетовДоверительногоУправленияУБрокеров.Параметры.УстановитьЗначениеПараметра("ТекущаяДата",        ТекущаяДатаСеанса());
	ЭтаФорма.КодыСчетовДоверительногоУправленияУБрокеров.Параметры.УстановитьЗначениеПараметра("ОтображатьЗакрытые", Элементы.КодыСчетовДоверительногоУправленияУБрокеровКомандаОтобразитьЗакрытыеДоговорыСБрокерами.Пометка);
	
	ЭтаФорма.СтатусыЛицензий.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДатаСеанса());
	
	ЭтаФорма.СведенияОДоговорах.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДатаСеанса());
	
	УстановитьОтборДоверенностейНаСервере();
	
	// отборы по ведомым регистрам
	УстановитьОтборыПоВедомымРегистрам(ЭтаФорма);
	
	// По умолчанию скрываем закрытые
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(
		ЭтаФорма.СведенияОДоговорах.Отбор, Новый Структура("ИмяПоля, Представление", "Закрыт", "ПредопределенныйОтборЗакрыт"), "ПредопределенныйОтборЗакрыт",
		ВидСравненияКомпоновкиДанных.Равно, Ложь, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто
	);
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(
		ЭтаФорма.Доверенности.Отбор, Новый Структура("ИмяПоля, Представление", "НеДействует", "ПредопределенныйОтборНедействующие"), "ПредопределенныйОтборНедействующие",
		ВидСравненияКомпоновкиДанных.Равно, Ложь, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто
	);
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(
		ЭтаФорма.Доверенности.Отбор, Новый Структура("ИмяПоля, Представление", "Доверитель", "ПредопределенныйОтборДоверитель"), "ПредопределенныйОтборДоверитель",
		ВидСравненияКомпоновкиДанных.Равно, ЭтаФорма.Клиент, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто
	);
	
	УстановитьПараметрыСпискаИнвестиционныеДекларацииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.Ссылка.Пустая() Тогда
		
		Если ЗначениеЗаполнено(ЭтаФорма.ЕдиныйКраткийКодКлиента) Тогда
			ПараметрыЗаписи.Вставить("ЕдиныйКраткийКодКлиентаВДопСведения");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтаФорма.КраткийКодКлиента) Тогда
			ПараметрыЗаписи.Вставить("КраткийКодКлиентаВДопСведения");	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтаФорма.РасчетныйКодНаРынкеДепозитовДляКлиента) Тогда
			ПараметрыЗаписи.Вставить("РасчетныйКодНаРынкеДепозитовДляКлиентаВДопСведения");	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтаФорма.НомерСчетаКлирингаВНКЦ) Тогда
			ПараметрыЗаписи.Вставить("НомерСчетаКлирингаВДопСведения");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДатаРасторжения) Тогда
		ЭтаФорма.УсловияДоговораДоверительногоУправления.Сортировать("Период");	
		Для Каждого СтрокаУсловияДоговораДоверительногоУправления Из ЭтаФорма.УсловияДоговораДоверительногоУправления Цикл
			Если СтрокаУсловияДоговораДоверительногоУправления.Период > Объект.ДатаРасторжения Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата условий не может быть больше даты расторжения договора", ЭтаФорма, "УсловияДоговораДоверительногоУправления",, Отказ);
				Возврат;
			КонецЕсли;
		КонецЦикла;	
		
		Если Объект.ДатаРасторжения < ТекущаяДата() Тогда
			Если СтрокаУсловияДоговораДоверительногоУправления <> Неопределено
			   И СтрокаУсловияДоговораДоверительногоУправления.АвтоматическаяПролонгация Тогда
				Если Вопрос("Договор расторгнут. Автопролонгация будет отключена. Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
				   Отказ = Истина;
				   Возврат;
				КонецЕсли;
			   
				НоваяСтрокаУсловий = ЭтаФорма.УсловияДоговораДоверительногоУправления.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаУсловий, СтрокаУсловияДоговораДоверительногоУправления);
				
				НоваяСтрокаУсловий.Период = Объект.ДатаРасторжения;
				НоваяСтрокаУсловий.АвтоматическаяПролонгация = Ложь;
				НоваяСтрокаУсловий.ВариантСрокаПролонгации = Неопределено;
				НоваяСтрокаУсловий.СрокПролонгации = Неопределено;
			   
			КонецЕсли;   
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Объект.ВидСчетаДоверительногоУправления = Перечисления.ВидыСчетовДоверительногоУправления.Договор Тогда
	
		Если Не ЗначениеЗаполнено(ЭтаФорма.Клиент) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Клиент"" не заполнено", ЭтаФорма, "Клиент",, Отказ);
			Возврат;
		КонецЕсли;
	
		Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
			ТекущийОбъект.УстановитьСсылкуНового(Справочники.СчетаДоверительногоУправления.ПолучитьСсылку());
			
			ЭтаФорма.СсылкаНовогоОбъекта = ТекущийОбъект.ПолучитьСсылкуНового(); // пригодится, если дальше будет отказ от записи
			
			// зафиксируем клиента доверительного управления
			МенеджерЗаписиКлиентыДоверительногоУправления = РегистрыСведений.КлиентыДоверительногоУправления.СоздатьМенеджерЗаписи();
			
			МенеджерЗаписиКлиентыДоверительногоУправления.Период						= Дата(1980, 1, 1);
			МенеджерЗаписиКлиентыДоверительногоУправления.Организация					= ТекущийОбъект.Организация;
			МенеджерЗаписиКлиентыДоверительногоУправления.СчетДоверительногоУправления	= ЭтаФорма.СсылкаНовогоОбъекта;
			МенеджерЗаписиКлиентыДоверительногоУправления.Клиент						= ЭтаФорма.Клиент;
			
			МенеджерЗаписиКлиентыДоверительногоУправления.Записать();
			
			Если ПолучитьВидыДоговоровИспользующиеСтратегии(Объект.Организация).Найти(Объект.ВидДоговораДоверительногоУправления) <> Неопределено Тогда										
				Если Не ЗначениеЗаполнено(ЭтаФорма.Стратегия) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Стратегия"" не заполнено", ЭтаФорма, "Стратегия",, Отказ);
					Возврат;
				КонецЕсли;
				
				МенеджерЗаписиСтратегии = РегистрыСведений.СтратегииИндивидуальногоИнвестирования.СоздатьМенеджерЗаписи();
				
				МенеджерЗаписиСтратегии.Период                       	= Дата(1980, 1, 1);
				МенеджерЗаписиСтратегии.Организация						= Объект.Организация;
				МенеджерЗаписиСтратегии.СчетДоверительногоУправления 	= ЭтаФорма.СсылкаНовогоОбъекта;
				МенеджерЗаписиСтратегии.Стратегия                    	= ЭтаФорма.Стратегия;
				
				МенеджерЗаписиСтратегии.Записать();
				
			КонецЕсли;
			
			ЗаписатьУсловияДоговораДоверительногоУправления(Отказ, ТекущийОбъект, ЭтаФорма.СсылкаНовогоОбъекта);
			
		Иначе
			
			ЗаписатьУсловияДоговораДоверительногоУправления(Отказ, ТекущийОбъект, ТекущийОбъект.Ссылка);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(ЭтаФорма.СсылкаНовогоОбъекта) Тогда
		ЗаполнитьСопутствующиеНастройкиНовогоСчета(Объект.Ссылка);
	КонецЕсли;
		
	Оповестить("СчетаДоверительногоУправления.Обновить", Объект.Ссылка);
	
	УстановитьОтборыПоВедомымРегистрам(ЭтаФорма);
	
	ЗаполнитьУсловияДоговоровДоверительногоУправления();
	
	УстановитьОтборДоверенностейНаСервере();
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
	Оповестить("СчетаДоверительногоУправления.Новый", Объект.Ссылка);  
	
	// #589977
	Если ЭтаФорма.ЭтоНовый Тогда 
		
		ПараметрыОбработки  = Новый Структура;
		ПараметрыОбработки.Вставить("СчетДоверительногоУправленияКуда", Объект.Ссылка);
		ПараметрыОбработки.Вставить("ДатаУстановки", Объект.ДатаЗаключения);
		
		// БЭК. Форма открывается в интерактивном режиме
		ОткрытьФормуМодально("Обработка.КопированиеНастроекСчетаДоверительногоУправления.Форма.ФормаБЭК", ПараметрыОбработки);
		ЭтаФорма.ЭтоНовый = Ложь;
		
	КонецЕсли;
	
		
КонецПроцедуры   

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.Свойство("ЕдиныйКраткийКодКлиентаВДопСведения") Тогда
		ЗаписатьДанныеВДопСведения(Объект.Ссылка, "ЕдиныйКраткийКодКлиента", ЭтаФорма.ЕдиныйКраткийКодКлиента);	
	КонецЕсли;
	
	Если ПараметрыЗаписи.Свойство("КраткийКодКлиентаВДопСведения") Тогда
		ЗаписатьДанныеВДопСведения(Объект.Ссылка, "КраткийКодКлиентаНаБирже", ЭтаФорма.КраткийКодКлиента);	
	КонецЕсли;
	
	Если ПараметрыЗаписи.Свойство("РасчетныйКодНаРынкеДепозитовДляКлиентаВДопСведения") Тогда
		ЗаписатьДанныеВДопСведения(Объект.Ссылка, "РасчетныйКодНаРынкеДепозитов", ЭтаФорма.РасчетныйКодНаРынкеДепозитовДляКлиента);	
	КонецЕсли;
	
	Если ПараметрыЗаписи.Свойство("НомерСчетаКлирингаВДопСведения") Тогда
		ЗаписатьДанныеВДопСведения(Объект.Ссылка, "НомерСчетаКлирингаВНКО_НКЦ", ЭтаФорма.НомерСчетаКлирингаВНКЦ);	
	КонецЕсли;
	
	// #589977
	Если ЭтаФорма.ЭтоНовый Тогда 
		Обработки.КопированиеНастроекСчетаДоверительногоУправления.АвтоматическийПереносНастроекБухгалтерии(Объект.Организация, Объект.Ссылка, Объект.ДатаЗаключения); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если НЕ ЗавершениеРаботы И ЗначениеЗаполнено(ЭтаФорма.СсылкаНовогоОбъекта) И Не ЗначениеЗаполнено(Объект.Ссылка) Тогда // пытались записать, но не смогли или, по какой-то причине, передумали
		УдалитьКлиентовДоверительногоУправления(ЭтаФорма.СсылкаНовогоОбъекта);
		ОповеститьОбИзменении(Тип("РегистрСведенийКлючЗаписи.КлиентыДоверительногоУправления"));
	КонецЕсли;
	
КонецПроцедуры

