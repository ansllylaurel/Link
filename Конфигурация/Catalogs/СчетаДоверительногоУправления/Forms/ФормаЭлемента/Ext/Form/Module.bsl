КонецПроцедуры

&НаКлиенте
Процедура КомандаДобавитьДоговор(Команда)

	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("Организация", Объект.Организация);
	ЗначенияЗаполнения.Вставить("СчетДоверительногоУправления", Объект.Ссылка);
	ЗначенияЗаполнения.Вставить("Активный", Истина);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);	
	
	РезультатОткрытия = ОткрытьФормуМодально("РегистрСведений.ДоговорыСчетовДоверительногоУправления.ФормаЗаписи", ПараметрыФормы, ЭтаФорма);
	
	Элементы.СведенияОДоговорах.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУдалитьДоговор(Команда)

	ТекущиеДанные = Элементы.СведенияОДоговорах.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТекущиеДанные.ДобавленоВручную Тогда
		Предупреждение("Разрешено удаление только добавленных вручную договоров!");
		Возврат;
	КонецЕсли;
	
	ДатаЗакрытия = ТекущаяДата();
	
	РезультатВопроса = Вопрос("Запись о договоре клиента будет закрыта с " + Формат(ДатаЗакрытия, "ДФ=dd.MM.yyyy") + ". Продолжить?", РежимДиалогаВопрос.ОКОтмена);	
	Если РезультатВопроса <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ЗакрытьИсполнителяПоДоговорам(Объект.Организация, Объект.Ссылка, ТекущиеДанные.Договор, ДатаЗакрытия);	
	
	Элементы.СведенияОДоговорах.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтобразитьЗакрытыеДоговоры(Команда)
	
	ПоказыватьЗакрытых = Не Элементы.КомандаОтобразитьЗакрытыеДоговоры.Пометка;	
	
	Элементы.КомандаОтобразитьЗакрытыеДоговоры.Пометка = ПоказыватьЗакрытых;
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(
		ЭтаФорма.СведенияОДоговорах.Отбор, Новый Структура("ИмяПоля, Представление", "Закрыт", "ПредопределенныйОтборЗакрыт"), "ПредопределенныйОтборЗакрыт",
		ВидСравненияКомпоновкиДанных.Равно, Ложь, Не ПоказыватьЗакрытых, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто
	);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗакрытьИсполнителяПоДоговорам(Организация, СчетДоверительногоУправления, Договор, ДатаЗакрытия)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.Период КАК Период,
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.Организация КАК Организация,
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Договор,
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.Активный КАК Активный
		|ИЗ
		|	РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
		|			&Период,
		|			Договор = &Договор
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних");
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Период", ДатаЗакрытия);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запись о договоре клиента """ + Строка(Договор) + """ на " + Формат(ДатаЗакрытия, "ДФ=dd.MM.yyyy") + " не обнаружена");	
		Возврат;	
	КонецЕсли;
	
	ПоследняяЗаписьОДоговоре = РезультатЗапроса.Выгрузить()[0];
	Если Не ПоследняяЗаписьОДоговоре.Активный Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запись о договоре клиента """ + Строка(Договор) + """ была закрыта " + Формат(ПоследняяЗаписьОДоговоре.Период, "ДФ=dd.MM.yyyy"));	
		Возврат;	
	КонецЕсли;	
	
	ДоговорКлиента = РегистрыСведений.ДоговорыСчетовДоверительногоУправления.СоздатьМенеджерЗаписи();
	ДоговорКлиента.Период						= ДатаЗакрытия;
	ДоговорКлиента.Организация					= Организация;
	ДоговорКлиента.СчетДоверительногоУправления	= СчетДоверительногоУправления;
	ДоговорКлиента.Договор						= Договор;
	ДоговорКлиента.Активный						= Ложь;		
	ДоговорКлиента.Записать();	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьКлючЗаписиИсполнителяПоДоговорам(Организация, СчетДоверительногоУправления, Договор, Период)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.Период КАК Период,
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.Организация КАК Организация,
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Договор
		|ИЗ
		|	РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
		|			&Период,
		|			Договор = &Договор
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних");
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Период", Период);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запись о договоре клиента """ + Строка(Договор) + """ на " + Формат(Период, "ДФ=dd.MM.yyyy") + " не обнаружена");	
		Возврат Неопределено;	
	КонецЕсли;	
	
	СтруктураКлюча = Новый Структура("Период, Организация, СчетДоверительногоУправления, Договор");
	ЗаполнитьЗначенияСвойств(СтруктураКлюча, РезультатЗапроса.Выгрузить()[0]); 
	
	Возврат РегистрыСведений.ДоговорыСчетовДоверительногоУправления.СоздатьКлючЗаписи(СтруктураКлюча);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьНастройкиРасчетаВознагражденияУправляющего(ЭтаФорма)
	
	Стратегия = СвойстваСтратегииИндивидуальногоИнвестирования(ЭтаФорма.Объект.Ссылка);	
	
	Если ЗначениеЗаполнено(Стратегия) И Стратегия.Стандартная Тогда
		
		ЭтаФорма.ВознаграждениеЗаРазмещение			= "См. настройки стратегии инвестирования";
		ЭтаФорма.ВознаграждениеУправляющего			= "См. настройки стратегии инвестирования";
		ЭтаФорма.ПлановоеВознаграждениеУправляющего	= "См. настройки стратегии инвестирования";
		
	Иначе
		
		НастройкиРасчетаВознаграждения = ПолучитьНастройкиРасчетаВознагражденияУправляющего(ЭтаФорма.Объект.Ссылка);		
		
		ЭтаФорма.ВознаграждениеЗаРазмещение			= НастройкиРасчетаВознаграждения[ПредопределенноеЗначение("Перечисление.ВидыВознагражденийУправляющего.ВознаграждениеЗаРазмещение")];
		ЭтаФорма.ВознаграждениеУправляющего			= НастройкиРасчетаВознаграждения[ПредопределенноеЗначение("Перечисление.ВидыВознагражденийУправляющего.ВознаграждениеУправляющего")];
		ЭтаФорма.ПлановоеВознаграждениеУправляющего	= НастройкиРасчетаВознаграждения[ПредопределенноеЗначение("Перечисление.ВидыВознагражденийУправляющего.ПлановоеВознаграждениеУправляющего")];
		
		ЭтаФорма.ВознаграждениеЗаРазмещение			= ?(ПустаяСтрока(ЭтаФорма.ВознаграждениеЗаРазмещение), "Не задано", ЭтаФорма.ВознаграждениеЗаРазмещение);
		ЭтаФорма.ВознаграждениеУправляющего			= ?(ПустаяСтрока(ЭтаФорма.ВознаграждениеУправляющего), "Не задано", ЭтаФорма.ВознаграждениеУправляющего);
		ЭтаФорма.ПлановоеВознаграждениеУправляющего	= ?(ПустаяСтрока(ЭтаФорма.ПлановоеВознаграждениеУправляющего), "Не задано", ЭтаФорма.ПлановоеВознаграждениеУправляющего);
		
	КонецЕсли;		
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНастройкиРасчетаВознагражденияУправляющего(СчетДоверительногоУправления)
	
	НастройкиРасчетаВознаграждения = Новый Соответствие;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиРасчетаВознаграждения.ВидВознаграждения КАК ВидВознаграждения,
		|	НастройкиРасчетаВознаграждения.НастройкаРасчета.Наименование КАК Представление
		|ИЗ
		|	РегистрСведений.НастройкиРасчетаВознагражденияУправляющего.СрезПоследних(, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиРасчетаВознаграждения");
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);	
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаЗапроса.Следующий() Цикл
		
		НастройкиРасчетаВознаграждения[ВыборкаЗапроса.ВидВознаграждения] = ВыборкаЗапроса.Представление;	
		
	КонецЦикла;
	
	Возврат НастройкиРасчетаВознаграждения;
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиНастройкиРасчетаВознагражденияУправляющего(Отбор)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	НастройкиРасчетаВознаграждения.ВидВознаграждения КАК ВидВознаграждения
		|ИЗ
		|	РегистрСведений.НастройкиРасчетаВознагражденияУправляющего.СрезПоследних(
		|			,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидВознаграждения = &ВидВознаграждения) КАК НастройкиРасчетаВознаграждения");
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Отбор.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидВознаграждения", Отбор.ВидВознаграждения);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

&НаКлиенте
Процедура КомандаАкцептоватьОперацииПоДоговоруСБрокером(Команда)
	
	ТекущиеДанные = Элементы.КодыСчетовДоверительногоУправленияУБрокеров.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбрана строка с договором");
		Возврат;
	КонецЕсли;
	
	СоздатьАкцепт(ТекущиеДанные.ДоговорБрокерскогоОбслуживания);
		
КонецПроцедуры

&НаКлиенте
Процедура КомандаАкцептоватьОперацииПоРасчетномуСчету(Команда)
	
	ТекущиеДанные = Элементы.ИсполнителиПоДенежнымСредствамСобственные.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбрана строка с договором");
		Возврат;
	КонецЕсли;
	
	СоздатьАкцепт(ТекущиеДанные.РасчетныйСчет);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьАкцепт(ОснованиеАкцепта)

	СтруктураЗаполнения = Новый Структура("Объект", ОснованиеАкцепта);	
	ФормаДокумента = ПолучитьФорму("Документ.Акцепт.ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", СтруктураЗаполнения), ЭтаФорма);
	ФормаДокумента.Открыть();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗаписьАкцепта" Тогда
		Элементы.КодыСчетовДоверительногоУправленияУБрокеров.Обновить();
		Элементы.ИсполнителиПоДенежнымСредствамСобственные.Обновить();
	КонецЕсли;
	
	РаботаСФайловымХранилищемКлиент.ОбновитьСписокПослеДобавленияФайла(ЭтотОбъект, ИмяСобытия, Параметр, Источник, "ДополнительныеСоглашения");
	РаботаСФайловымХранилищемКлиент.ОбновитьСписокПослеДобавленияФайла(ЭтотОбъект, ИмяСобытия, Параметр, Источник, "КодыСчетовДоверительногоУправленияУБрокеров");
	РаботаСФайловымХранилищемКлиент.ОбновитьСписокПослеДобавленияФайла(ЭтотОбъект, ИмяСобытия, Параметр, Источник, "СведенияОДоговорах");
	РаботаСФайловымХранилищемКлиент.ОбновитьСписокПослеДобавленияФайла(ЭтотОбъект, ИмяСобытия, Параметр, Источник, "Доверенности");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СвойстваСтратегииИндивидуальногоИнвестирования(СчетДоверительногоУправления)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтратегииИндивидуальногоИнвестирования.Стратегия КАК Ссылка,
		|	СтратегииИндивидуальногоИнвестирования.Стратегия.Стандартная КАК Стандартная
		|ИЗ
		|	РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК СтратегииИндивидуальногоИнвестирования");
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		Возврат РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(РезультатЗапроса.Выгрузить()[0]);
	КонецЕсли;
	
КонецФункции

#Область УсловияДоговоровДоверительногоУправления

&НаКлиенте
Процедура УсловияДоговоровДоверительногоУправленияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	РедактироватьУсловиеДоговоровДоверительногоУправления(Элемент, Истина, Копирование);
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияДоговоровДоверительногоУправленияПередУдалением(Элемент, Отказ)
	
	Если Вопрос("Удалить запись условий договоров?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Отказ = Истина;
	Иначе
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияДоговоровДоверительногоУправленияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	РедактироватьУсловиеДоговоровДоверительногоУправления(Элемент, Ложь, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьУсловиеДоговоровДоверительногоУправления(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекущаяСтрока = ЭтаФорма.УсловияДоговораДоверительногоУправления.Добавить();
		ТекущаяСтрока.Период = ТекущаяДата();
		
		Если Копирование Тогда
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, Элемент.ТекущиеДанные);	
		КонецЕсли;
		
		Элемент.ТекущаяСтрока = ТекущаяСтрока.ПолучитьИдентификатор();
		
	Иначе
		
		ТекущаяСтрока = ЭтаФорма.УсловияДоговораДоверительногоУправления.НайтиПоИдентификатору(Элемент.ТекущаяСтрока);	
		
	КонецЕсли;
	
	ПериодыДругихЗаписей = Новый Массив;
	Для Каждого СтрокаУсловий Из ЭтаФорма.УсловияДоговораДоверительногоУправления Цикл
		Если СтрокаУсловий <> ТекущаяСтрока Тогда
			ПериодыДругихЗаписей.Добавить(СтрокаУсловий.Период);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура("Период, АвтоматическаяПролонгация, ВариантСрокаПролонгации, ДатаИзменения, ДатаСоздания, Изменил, "
		+ "КоэффициентЧувствительности, НеобходимыеРасходы, Создал, СрокПролонгации, ЕдиницаСрокаПролонгации, ТипИнвестиционногоНалоговогоВычета, "
		+ "ОплатаВознагражденияУправляющегоИУслугСпецдепозитарияИзСобственныхСредствКлиента, "
		+ "СпособРаскрытияИнформации, НаименованиеЦелевогоКапитала, НаправлениеИспользованияЦелевогоКапитала");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ТекущаяСтрока);
	
	ПараметрыФормы.Вставить("ВидДоговораДоверительногоУправления"	, Объект.ВидДоговораДоверительногоУправления);
	ПараметрыФормы.Вставить("Организация"							, Объект.Организация);
	ПараметрыФормы.Вставить("НоваяЗапись"							, НоваяСтрока);
	ПараметрыФормы.Вставить("ПериодыДругихЗаписей"					, ПериодыДругихЗаписей);
	ПараметрыФормы.Вставить("МассивЛицензий"						, ТекущаяСтрока.Лицензии.ВыгрузитьЗначения());
	
	Если Не Объект.Ссылка.Пустая() Тогда
		ПараметрыФормы.Вставить("Ссылка"							, Объект.Ссылка);
	КонецЕсли;
	
	Результат = ОткрытьФормуМодально("Справочник.СчетаДоверительногоУправления.Форма.УсловияДоговоровДоверительногоУправления", ПараметрыФормы);
	
	Если Результат <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, Результат);
		
		ТекущаяСтрока.Лицензии.ЗагрузитьЗначения(Результат.МассивЛицензий);
		ТекущаяСтрока.ЛицензииПредставление = СтрСоединить(Результат.МассивЛицензий, Символы.ПС);

		ЭтаФорма.Модифицированность = Истина;
		
	ИначеЕсли НоваяСтрока Тогда
		ЭтаФорма.УсловияДоговораДоверительногоУправления.Удалить(ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУсловияДоговоровДоверительногоУправления()
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ЦелевойКапитал = Новый Структура("Наименование, Направление", "", "");
	
	ЭтаФорма.УсловияДоговораДоверительногоУправления.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияДоговоровДоверительногоУправления.Период КАК Период,
		|	УсловияДоговоровДоверительногоУправления.НеобходимыеРасходы КАК НеобходимыеРасходы,
		|	УсловияДоговоровДоверительногоУправления.АвтоматическаяПролонгация КАК АвтоматическаяПролонгация,
		|	УсловияДоговоровДоверительногоУправления.ВариантСрокаПролонгации КАК ВариантСрокаПролонгации,
		|	УсловияДоговоровДоверительногоУправления.СрокПролонгации КАК СрокПролонгации,
		|	ВЫБОР УсловияДоговоровДоверительногоУправления.ВариантСрокаПролонгации
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.ВариантыСрокаПролонгации.КоличествоЛетСрокаПролонгации)
		|			ТОГДА ""год""
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.ВариантыСрокаПролонгации.КоличествоДнейСрокаПролонгации)
		|			ТОГДА ""день""
		|	КОНЕЦ КАК ЕдиницаСрокаПролонгации,
		|	УсловияДоговоровДоверительногоУправления.ТипИнвестиционногоНалоговогоВычета КАК ТипИнвестиционногоНалоговогоВычета,
		|	УсловияДоговоровДоверительногоУправления.КоэффициентЧувствительности КАК КоэффициентЧувствительности,
		|	УсловияДоговоровДоверительногоУправления.Создал КАК Создал,
		|	УсловияДоговоровДоверительногоУправления.ДатаСоздания КАК ДатаСоздания,
		|	УсловияДоговоровДоверительногоУправления.Изменил КАК Изменил,
		|	УсловияДоговоровДоверительногоУправления.ДатаИзменения КАК ДатаИзменения,
		|	УсловияДоговоровДоверительногоУправления.ОплатаВознагражденияУправляющегоИУслугСпецдепозитарияИзСобственныхСредствКлиента КАК ОплатаВознагражденияУправляющегоИУслугСпецдепозитарияИзСобственныхСредствКлиента,
		|	УсловияДоговоровДоверительногоУправления.СпособРаскрытияИнформации КАК СпособРаскрытияИнформации,
		|	УсловияДоговоровДоверительногоУправления.НаименованиеЦелевогоКапитала КАК НаименованиеЦелевогоКапитала,
		|	УсловияДоговоровДоверительногоУправления.НаправлениеИспользованияЦелевогоКапитала КАК НаправлениеИспользованияЦелевогоКапитала
		|ПОМЕСТИТЬ _УсловияДоговоровДоверительногоУправления
		|ИЗ
		|	РегистрСведений.УсловияДоговоровДоверительногоУправления КАК УсловияДоговоровДоверительногоУправления
		|ГДЕ
		|	УсловияДоговоровДоверительногоУправления.СчетДоверительногоУправления = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЛицензииДоговоровДоверительногоУправления.Период КАК Период,
		|	ЛицензииДоговоровДоверительногоУправления.Лицензия КАК Лицензия
		|ПОМЕСТИТЬ _ЛицензииДоговоровДоверительногоУправления
		|ИЗ
		|	РегистрСведений.ЛицензииДоговоровДоверительногоУправления КАК ЛицензииДоговоровДоверительногоУправления
		|ГДЕ
		|	ЛицензииДоговоровДоверительногоУправления.Организация = &Организация
		|	И ЛицензииДоговоровДоверительногоУправления.СчетДоверительногоУправления = &Ссылка
		|	И ЛицензииДоговоровДоверительногоУправления.Действует";
	
	Запрос.УстановитьПараметр("Ссылка"		, Объект.Ссылка);
	Запрос.УстановитьПараметр("Организация"	, Объект.Организация);
	
	Запрос.Выполнить();
	
	Таблица_Условий		= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_УсловияДоговоровДоверительногоУправления").ПолучитьДанные().Выгрузить();
	Таблица_Лицензий	= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ЛицензииДоговоровДоверительногоУправления").ПолучитьДанные().Выгрузить();
	
	Таблица_Условий.Сортировать("Период");
	
	Для Каждого СтрокаУсловий Из Таблица_Условий Цикл
		НоваяСтрока = ЭтаФорма.УсловияДоговораДоверительногоУправления.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаУсловий);
		
		ЦелевойКапитал.Наименование = СтрокаУсловий.НаименованиеЦелевогоКапитала;
		ЦелевойКапитал.Направление 	= СтрокаУсловий.НаправлениеИспользованияЦелевогоКапитала; 
		
		ПараметрыПоиска = Новый Структура("Период", СтрокаУсловий.Период);
		МассивЛицензий	= Таблица_Лицензий.Скопировать(ПараметрыПоиска, "Лицензия").ВыгрузитьКолонку("Лицензия");
		
		НоваяСтрока.Лицензии.ЗагрузитьЗначения(МассивЛицензий);
		НоваяСтрока.ЛицензииПредставление = СтрСоединить(МассивЛицензий, Символы.ПС);
		
	КонецЦикла;
	
	ЭтаФорма.НаименованиеЦелевогоКапитала 			  = ЦелевойКапитал.Наименование;
	ЭтаФорма.НаправлениеИспользованияЦелевогоКапитала = ЦелевойКапитал.Направление;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеСведенияНаСервере()
	
	//Часть доп. сведений относится к организации, часть - к счету ДУ 	
	ЭтаФорма.ЕдиныйКраткийКодУК					= ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(Неопределено, "ЕдиныйКраткийКодКлиента", Объект.Организация);
	ЭтаФорма.ИдентификаторУчастникаКлиринга		= ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(Неопределено, "ИдентификаторУчастникаКлиринга", Объект.Организация);
	ЭтаФорма.РасчетныйКодНаРынкеДепозитовДляУК	= ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(Неопределено, "РасчетныйКодНаРынкеДепозитов", Объект.Организация);
		
	Если Не Объект.Ссылка.Пустая() Тогда		
		ЭтаФорма.ЕдиныйКраткийКодКлиента				= ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(Неопределено, "ЕдиныйКраткийКодКлиента", Объект.Ссылка);
		ЭтаФорма.КраткийКодКлиента						= ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(Неопределено, "КраткийКодКлиентаНаБирже", Объект.Ссылка);
		ЭтаФорма.РасчетныйКодНаРынкеДепозитовДляКлиента = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(Неопределено, "РасчетныйКодНаРынкеДепозитов", Объект.Ссылка);
		ЭтаФорма.НомерСчетаКлирингаВНКЦ					= ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(Неопределено, "НомерСчетаКлирингаВНКО_НКЦ", Объект.Ссылка);
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьУсловияДоговораДоверительногоУправления(Отказ, ТекущийОбъект, СчетДоверительногоУправления)

	Если ЭтаФорма.ТипКлиента = 2 ИЛИ ТекущийОбъект.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.Собственный Тогда //Для ПИФ и Собственных счетов нет условий, лицензия записывается в ПриЗаписи модуля объекта.
		Возврат;
	КонецЕсли;
		
	НовыеУсловияДоговораДоверительногоУправления = ЭтаФорма.УсловияДоговораДоверительногоУправления.Выгрузить();
	НовыеУсловияДоговораДоверительногоУправления.Сортировать("Период");
	
#Область УсловияДоговоровДоверительногоУправления
	НаборЗаписейУсловияДоговоров = РегистрыСведений.УсловияДоговоровДоверительногоУправления.СоздатьНаборЗаписей();
	НаборЗаписейУсловияДоговоров.Отбор.СчетДоверительногоУправления.Установить(СчетДоверительногоУправления);
	НаборЗаписейУсловияДоговоров.ДополнительныеСвойства.Вставить("ЗаписьВСоставеСчетаДоверительногоУправления");

	Для Каждого СтрокаУсловий Из НовыеУсловияДоговораДоверительногоУправления Цикл
		Запись = НаборЗаписейУсловияДоговоров.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, СтрокаУсловий);
		Запись.Организация					= ТекущийОбъект.Организация;
		Запись.СчетДоверительногоУправления = СчетДоверительногоУправления;
	КонецЦикла;
	
	Попытка
		НаборЗаписейУсловияДоговоров.Записать();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), НаборЗаписейУсловияДоговоров,,, Отказ);
		Возврат;
	КонецПопытки;
#КонецОбласти

#Область ЛицензииДоговоровДоверительногоУправления
	НаборЗаписейЛицензииДоговоров = РегистрыСведений.ЛицензииДоговоровДоверительногоУправления.СоздатьНаборЗаписей();
	НаборЗаписейЛицензииДоговоров.Отбор.Организация.Установить(ТекущийОбъект.Организация);
	НаборЗаписейЛицензииДоговоров.Отбор.СчетДоверительногоУправления.Установить(СчетДоверительногоУправления);
	НаборЗаписейЛицензииДоговоров.ДополнительныеСвойства.Вставить("ЗаписьВСоставеСчетаДоверительногоУправления");
	
	МассивНедействующихЛицензий = Новый Массив;
	
	Для Каждого СтрокаУсловий Из НовыеУсловияДоговораДоверительногоУправления Цикл
		Для Каждого ЭлементЛицензий Из СтрокаУсловий.Лицензии Цикл
			Запись = НаборЗаписейЛицензииДоговоров.Добавить();
			Запись.Период						= СтрокаУсловий.Период;
			Запись.Организация					= ТекущийОбъект.Организация;
			Запись.СчетДоверительногоУправления = СчетДоверительногоУправления;
			Запись.Лицензия						= ЭлементЛицензий.Значение;
			Запись.Действует					= Истина;
			
			Если МассивНедействующихЛицензий.Найти(ЭлементЛицензий.Значение) <> Неопределено Тогда
				МассивНедействующихЛицензий.Удалить(МассивНедействующихЛицензий.Найти(ЭлементЛицензий.Значение));
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого НедействующаяЛицензия Из МассивНедействующихЛицензий Цикл
			Запись = НаборЗаписейЛицензииДоговоров.Добавить();
			Запись.Период						= СтрокаУсловий.Период;
			Запись.Организация					= ТекущийОбъект.Организация;
			Запись.СчетДоверительногоУправления = СчетДоверительногоУправления;
			Запись.Лицензия						= НедействующаяЛицензия;
			Запись.Действует					= Ложь;
		КонецЦикла;
		
		МассивНедействующихЛицензий = СтрокаУсловий.Лицензии.ВыгрузитьЗначения();
	КонецЦикла;
	
	Попытка
		НаборЗаписейЛицензииДоговоров.Записать();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), НаборЗаписейЛицензииДоговоров,,, Отказ);
		Возврат;
	КонецПопытки;
#КонецОбласти
	
КонецПроцедуры

#КонецОбласти

&НаСервереБезКонтекста
Функция ПолучитьМассивДоступныхСтратегий(ВидДоговораДоверительногоУправления)
	
	Возврат РегистрыСведений.СтратегииИндивидуальногоИнвестирования.ПолучитьМассивДоступныхСтратегий(ВидДоговораДоверительногоУправления);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВидыДоговоровИспользующиеСтратегии(Организация)
	
	Возврат Справочники.СтратегииИндивидуальногоИнвестирования.ПолучитьВидыДоговоровИспользующиеСтратегии(Организация);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьМассивВидовДоговоровПоУправлениюПенсионнымиНакоплениямиИРезервами(ВидДоговораДоверительногоУправления)

	Результат = Новый Массив;
	Если ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
		Результат.Добавить(Перечисления.ВидыДоговоровПоУправлениюПенсионнымиНакоплениямиИРезервами.ПН);
		Результат.Добавить(Перечисления.ВидыДоговоровПоУправлениюПенсионнымиНакоплениямиИРезервами.СВ);
		Результат.Добавить(Перечисления.ВидыДоговоровПоУправлениюПенсионнымиНакоплениямиИРезервами.ВР);
		Результат.Добавить(Перечисления.ВидыДоговоровПоУправлениюПенсионнымиНакоплениямиИРезервами.РОПС);
	ИначеЕсли ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
		Результат.Добавить(Перечисления.ВидыДоговоровПоУправлениюПенсионнымиНакоплениямиИРезервами.ПР);
		Результат.Добавить(Перечисления.ВидыДоговоровПоУправлениюПенсионнымиНакоплениямиИРезервами.СР);
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура УстановитьПараметрыСпискаИнвестиционныеДекларацииНаСервере()

	ЭтаФорма.ИнвестиционныеДекларации.Параметры.УстановитьЗначениеПараметра("Период", НачалоДня(ТекущаяДатаСеанса()));
	ЭтаФорма.ИнвестиционныеДекларации.Параметры.УстановитьЗначениеПараметра("Организация", Объект.Организация);
	ЭтаФорма.ИнвестиционныеДекларации.Параметры.УстановитьЗначениеПараметра("СчетДоверительногоУправления", Объект.Ссылка);

КонецПроцедуры
 
&НаСервереБезКонтекста
Функция ПолучитьВидимостьСтраницыИнвестиционныеДекларации()

	Видимость = Ложь;
	
	МассивРолей = Новый Массив;
	МассивРолей.Добавить(Метаданные.Роли.КонтрольИнвестиционныхДеклараций);
	МассивРолей.Добавить(Метаданные.Роли.КонтрольИнвестиционныхДекларацийПросмотр);
	МассивРолей.Добавить(Метаданные.Роли.КонтрольУправляющихКомпаний);
	МассивРолей.Добавить(Метаданные.Роли.КонтрольУправляющихКомпанийПросмотр);
	МассивРолей.Добавить(Метаданные.Роли.ПолныеПрава);
	
	Для каждого Роль Из МассивРолей Цикл
		
		Видимость = РольДоступна(Роль);
		
		Если Видимость Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Видимость
	
КонецФункции

&НаКлиенте
Процедура ИнвестиционныеДекларацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекСтрока = Элемент.ТекущиеДанные;
	Если ТекСтрока <> Неопределено И ЗначениеЗаполнено(ТекСтрока.ИнвестиционнаяДекларация) Тогда
		Если Поле.Имя = "ИнвестиционныеДекларацииРегистратор" Тогда
			ОткрытьЗначение(ТекСтрока.Регистратор);
		Иначе
			ОткрытьЗначение(ТекСтрока.ИнвестиционнаяДекларация);
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтобразитьНедействующиеДоверенности(Команда)
	
	ПоказыватьНедействующие = Не Элементы.ДоверенностиКомандаОтобразитьНедействующиеДоверенности.Пометка;	
	
	Элементы.ДоверенностиКомандаОтобразитьНедействующиеДоверенности.Пометка = ПоказыватьНедействующие;
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(
		ЭтаФорма.Доверенности.Отбор, Новый Структура("ИмяПоля, Представление", "НеДействует", "ПредопределенныйОтборНедействующие"), "ПредопределенныйОтборНедействующие",
		ВидСравненияКомпоновкиДанных.Равно, Ложь, Не ПоказыватьНедействующие, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто
	);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборДоверенностейНаСервере()

	ЭтаФорма.Доверенности.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", НачалоДня(ТекущаяДатаСеанса()));
	ЭтаФорма.Доверенности.Параметры.УстановитьЗначениеПараметра("Организация", Объект.Организация);
	ЭтаФорма.Доверенности.Параметры.УстановитьЗначениеПараметра("Доверитель", ЭтаФорма.Клиент);
	ЭтаФорма.Доверенности.Параметры.УстановитьЗначениеПараметра("ВидДоговора", Объект.ВидДоговораДоверительногоУправления);
	
КонецПроцедуры

