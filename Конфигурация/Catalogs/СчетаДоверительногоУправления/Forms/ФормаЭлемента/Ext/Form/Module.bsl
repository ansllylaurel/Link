&НаКлиенте
Процедура КомандаОткрытьПрисоединенныеФайлыДоговоры(Команда)
	
	ТекущиеДанные = Элементы.СведенияОДоговорах.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.Договор) Тогда
		РаботаСФайловымХранилищемКлиент.ОткрытьПрисоединенныеФайлы(ТекущиеДанные.Договор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОткрытьПрисоединенныеФайлыДоговорыБрок(Команда)
	
	ТекущиеДанные = Элементы.КодыСчетовДоверительногоУправленияУБрокеров.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		РаботаСФайловымХранилищемКлиент.ОткрытьПрисоединенныеФайлы(ТекущиеДанные.ДоговорБрокерскогоОбслуживания);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОткрытьПрисоединенныеФайлыДополнительныеСоглашения(Команда)
	
	ТекущиеДанные = Элементы.ДополнительныеСоглашения.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		РаботаСФайловымХранилищемКлиент.ОткрытьПрисоединенныеФайлы(ТекущиеДанные.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКодСчетаНаСервере()
	
	Отказ = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле 'Организация' не заполнено. Невозможно определить код счета", ЭтаФорма, "Организация",, Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ВидДоговораДоверительногоУправления) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле 'Вид договора доверительного  управления' не заполнено. Невозможно определить код счета", ЭтаФорма, "ВидДоговораДоверительногоУправления",, Отказ);
	КонецЕсли;
	
	Если Не Отказ Тогда
		НовыйКодСчета = ОпределитьНовыйКодСчета(Объект.Организация, Объект.ВидДоговораДоверительногоУправления, Объект.КодСчета);
		Если      ПустаяСтрока(Объект.КодСчета) Тогда
			Объект.КодСчета = НовыйКодСчета;
		ИначеЕсли Объект.КодСчета <> НовыйКодСчета И Вопрос("Изменить код счета на '" + НовыйКодСчета + "'?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			Объект.КодСчета = НовыйКодСчета;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура ЗаписатьДанныеВДопСведения(Ссылка, ИмяКлюча, Значение) 
	
	ВариантыКлюча = РедактируемыеДополнительныеСведения();
	Если ВариантыКлюча.Найти(ИмяКлюча) = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не реализовано сохранение дополнительного сведения с ключом """ + ИмяКлюча + """");
		Возврат;
	КонецЕсли;
	
	ПланыВидовХарактеристик.ДополнительныеСведения.ЗаписатьЗначениеДополнительногоСведенияОбъекта(Ссылка, ИмяКлюча, Значение);
			
КонецПроцедуры

&НаСервереБезКонтекста
Функция РедактируемыеДополнительныеСведения()
	
	ВариантыКлюча = Новый Массив;
	ВариантыКлюча.Добавить("ЕдиныйКраткийКодКлиента");
	ВариантыКлюча.Добавить("КраткийКодКлиентаНаБирже");
	ВариантыКлюча.Добавить("РасчетныйКодНаРынкеДепозитов");
	ВариантыКлюча.Добавить("НомерСчетаКлирингаВНКО_НКЦ");

    Возврат ВариантыКлюча;

КонецФункции
