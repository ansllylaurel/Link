
Функция ПредставлениеЗадания(Команда)

	// "[ИмяОбъекта] (доп.) / [ПредставлениеКоманды]"
	Возврат
		СокрЛП(Наименование) + " (доп.) / " + СокрЛП(Команда.Представление) + " (" + Команда.ГруппаПараметровИмя + ")";
	
КонецФункции

Функция РасписаниеЗадано(Расписание)
	
	Возврат Строка(Расписание) <> Строка(Новый РасписаниеРегламентногоЗадания);
	
КонецФункции


Процедура ПередЗаписьюГлобальнойОбработки(Отказ)
	
	Если Отказ Или Не ДополнительныеСвойства.Свойство("АктуальныеКоманды") Тогда
		Возврат;
	КонецЕсли;
	
	АктуальныеКоманды = ДополнительныеСвойства.АктуальныеКоманды;
	
	ЗаданияДляОбновления = Новый Соответствие;
	ИзмененныеИНовыеКоманды = Неопределено;
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Очистка заданий по командам, которые были удалены из таблицы
	Если Не ЭтотОбъект.ЭтоНовый() Тогда
		Для Каждого СтараяКоманда Из Ссылка.Команды Цикл
			Если ЗначениеЗаполнено(СтараяКоманда.РегламентноеЗаданиеGUID)
				И АктуальныеКоманды.Найти(СтараяКоманда.РегламентноеЗаданиеGUID, "РегламентноеЗаданиеGUID") = Неопределено
			Тогда
				Задание = РаботаСДополнительнымиОтчетамиИОбработками.НайтиЗадание(СтараяКоманда.РегламентноеЗаданиеGUID);
				Если Задание <> Неопределено Тогда
					РаботаСДополнительнымиОтчетамиИОбработками.УдалитьЗадание(Задание);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
		Запрос.УстановитьПараметр("АктуальныеКоманды", АктуальныеКоманды);
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	АктуальныеКоманды.Идентификатор КАК Идентификатор,
			|	АктуальныеКоманды.ГруппаПараметров КАК ГруппаПараметров,
			|	АктуальныеКоманды.ОбновитьЗадание КАК ОбновитьЗадание
			|ПОМЕСТИТЬ _АктуальныеКоманды
			|ИЗ
			|	&АктуальныеКоманды КАК АктуальныеКоманды
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_АктуальныеКоманды.Идентификатор КАК Идентификатор,
			|	_АктуальныеКоманды.ГруппаПараметров КАК ГруппаПараметров,
			|	_АктуальныеКоманды.ОбновитьЗадание
			|		ИЛИ ДополнительныеОтчетыИОбработкиКоманды.Идентификатор ЕСТЬ NULL КАК ОбновитьЗадание
			|ИЗ
			|	_АктуальныеКоманды КАК _АктуальныеКоманды
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДополнительныеОтчетыИОбработки.Команды КАК ДополнительныеОтчетыИОбработкиКоманды
			|		ПО (ДополнительныеОтчетыИОбработкиКоманды.Ссылка = &Ссылка)
			|			И _АктуальныеКоманды.Идентификатор = ДополнительныеОтчетыИОбработкиКоманды.Идентификатор
			|			И _АктуальныеКоманды.ГруппаПараметров = ДополнительныеОтчетыИОбработкиКоманды.ГруппаПараметров
			|ГДЕ
			|	(_АктуальныеКоманды.ОбновитьЗадание
			|			ИЛИ ДополнительныеОтчетыИОбработкиКоманды.Идентификатор ЕСТЬ NULL)";
		
		ИзмененныеИНовыеКоманды = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	// Актуализация набора регламентных заданий для записи их идентификаторов в табличную часть.
	Для Каждого АктуальнаяКоманда Из АктуальныеКоманды Цикл
		
		Если ТипЗнч(ИзмененныеИНовыеКоманды) = Тип("ТаблицаЗначений") Тогда
			НайденныеСтроки = ИзмененныеИНовыеКоманды.НайтиСтроки(Новый Структура("Идентификатор, ГруппаПараметров", АктуальнаяКоманда.Идентификатор, АктуальнаяКоманда.ГруппаПараметров));
			Если НайденныеСтроки.Количество() = 0 Тогда
				// расписание не менялось, обновление команды не требуется
				Продолжить;
			КонецЕсли; 
		КонецЕсли; 
		
		НайденныеСтроки = ЭтотОбъект.Команды.НайтиСтроки(Новый Структура("Идентификатор, ГруппаПараметров", АктуальнаяКоманда.Идентификатор, АктуальнаяКоманда.ГруппаПараметров));
		
		Команда = НайденныеСтроки[0];
		
		Если АктуальнаяКоманда.РегламентноеЗаданиеИспользование И АктуальнаяКоманда.РегламентноеЗаданиеРасписание.Количество() > 0 Тогда
			Расписание    = АктуальнаяКоманда.РегламентноеЗаданиеРасписание[0].Значение;
			Использование = АктуальнаяКоманда.РегламентноеЗаданиеИспользование И РасписаниеЗадано(Расписание);
		Иначе
			Расписание    = Неопределено;
			Использование = Ложь;
		КонецЕсли;
		
		Задание = РаботаСДополнительнымиОтчетамиИОбработками.НайтиЗадание(АктуальнаяКоманда.РегламентноеЗаданиеGUID);
		
		Если Задание = Неопределено Тогда // Не найдено
			
			Если Использование Тогда
				Задание = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьНовоеЗадание(ПредставлениеЗадания(АктуальнаяКоманда));
				ЗаданияДляОбновления.Вставить(АктуальнаяКоманда, Задание);
				
				// Создать и зарегистрировать
				Команда.РегламентноеЗаданиеGUID = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьИдентификаторЗадания(Задание);
			КонецЕсли;
			
		Иначе // Найдено
			
			Если Использование Тогда
				// Зарегистрировать
				ЗаданияДляОбновления.Вставить(АктуальнаяКоманда, Задание);
			Иначе
				// Удалить
				РаботаСДополнительнымиОтчетамиИОбработками.УдалитьЗадание(Задание);
				Команда.РегламентноеЗаданиеGUID = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДополнительныеСвойства.Вставить("ЗаданияДляОбновления", ЗаданияДляОбновления);
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ПриЗаписиГлобальнойОбработки(Отказ)
	
	Если Отказ Или Не ДополнительныеСвойства.Свойство("АктуальныеКоманды") Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для Каждого КлючИЗначение Из ДополнительныеСвойства.ЗаданияДляОбновления Цикл
		
		Команда = КлючИЗначение.Ключ;
		Задание = КлючИЗначение.Значение;
		
		Если Команда.РегламентноеЗаданиеРасписание.Количество() > 0 Тогда
			Расписание    = Команда.РегламентноеЗаданиеРасписание[0].Значение;
			Использование = Команда.РегламентноеЗаданиеИспользование И РасписаниеЗадано(Расписание);
		Иначе
			Расписание    = Неопределено;
			Использование = Ложь;
		КонецЕсли;
		
		ПараметрыЗадания = Новый Массив;
		ПараметрыЗадания.Добавить(Ссылка);
		ПараметрыЗадания.Добавить(Команда.Идентификатор);
		ПараметрыЗадания.Добавить(Команда.ГруппаПараметров);
		ПараметрыЗадания.Добавить(Команда.ГруппаПараметровИмя);
		
		РаботаСДополнительнымиОтчетамиИОбработками.УстановитьПараметрыЗадания(
			Задание,
			Использование,
			Лев(ПредставлениеЗадания(Команда), 120),
			ПараметрыЗадания,
			Расписание);
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ПередУдалениемГлобальнойОбработки(Отказ)
	
	// Регламентные задание необходимо изменять в неразделенном режиме.
	УстановитьПривилегированныйРежим(Истина);
	
	Для Каждого Команда Из Команды Цикл
		
		Задание = РаботаСДополнительнымиОтчетамиИОбработками.НайтиЗадание(
			Команда.РегламентноеЗаданиеGUID);
			
		Если Задание <> Неопределено Тогда
			РаботаСДополнительнымиОтчетамиИОбработками.УдалитьЗадание(Задание);
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры


