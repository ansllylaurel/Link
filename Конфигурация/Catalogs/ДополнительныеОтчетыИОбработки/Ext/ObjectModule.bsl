КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	// критичные проверка
	Если ЭтотОбъект.ЭтоНовый() И Не РаботаСДополнительнымиОтчетамиИОбработками.ЕстьПравоИнтерактивнойРаботы() Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для управления дополнительными отчетами и обработками'");
	КонецЕсли;
	
	Если ЭтотОбъект.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;

	// блокирующие проверки
	Если Не ЭтотОбъект.ПометкаУдаления Тогда
		
		УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
		
		Если Не ЭтотОбъект.ЭтоНовый() И ЭтотОбъект.Вид <> ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Вид") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Невозможно сменить вид существующего дополнительного отчета или обработки'"),,,, Отказ);
			Возврат;
		КонецЕсли;
		
		// проверка конфликта имен
		Если РаботаСДополнительнымиОтчетамиИОбработками.НайтиКонфликтующиеИмена(ЭтотОбъект.ИмяОбъекта, ЭтотОбъект.Вид, ЭтотОбъект.Ссылка).Количество() > 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Имя """ + ЭтотОбъект.ИмяОбъекта + """, используемое данным отчетом (обработкой), уже занято другим дополнительным отчетом (обработкой)'"),,,, Отказ);
			Возврат;
		КонецЕсли;
		
		АктуальныеКоманды = Неопределено;
		Если ЭтотОбъект.ДополнительныеСвойства.Свойство("АктуальныеКоманды", АктуальныеКоманды) Тогда
			
			АктуальныеКоманды.Колонки.Добавить("ГруппаПараметровСтрока", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
			АктуальныеКоманды.ЗагрузитьКолонку(АктуальныеКоманды.ВыгрузитьКолонку("ГруппаПараметров"), "ГруппаПараметровСтрока");
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	Команды.НомерСтроки КАК НомерСтроки,
				|	Команды.Идентификатор КАК Идентификатор,
				|	Команды.ГруппаПараметровСтрока КАК ГруппаПараметров,
				|	ВЫРАЗИТЬ(Команды.ГруппаПараметровИмя КАК СТРОКА(25)) КАК ГруппаПараметровИмя
				|ПОМЕСТИТЬ _Команды
				|ИЗ
				|	&Команды КАК Команды
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	МАКСИМУМ(_Команды.НомерСтроки) КАК НомерСтроки,
				|	_Команды.Идентификатор КАК Идентификатор,
				|	_Команды.ГруппаПараметров КАК ГруппаПараметров,
				|	_Команды.ГруппаПараметровИмя КАК ГруппаПараметровИмя
				|ИЗ
				|	_Команды КАК _Команды
				|
				|СГРУППИРОВАТЬ ПО
				|	_Команды.Идентификатор,
				|	_Команды.ГруппаПараметров,
				|	_Команды.ГруппаПараметровИмя
				|
				|ИМЕЮЩИЕ
				|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Команды.НомерСтроки) > 1";
			
			Запрос.УстановитьПараметр("Команды", АктуальныеКоманды);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				ТекстОшибки = "Команда с идентификатором '" + Выборка.Идентификатор + "' с группой параметров '" + СокрЛП(Выборка.ГруппаПараметровИмя) + "' встречается более одного раза";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "Команды[" + Выборка.НомерСтроки + "].Идентификатор",, Отказ);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// основной функционал
	Если РаботаСДополнительнымиОтчетамиИОбработками.ЭтоГлобальнаяОбработка(ЭтотОбъект.Вид) Тогда
		ПередЗаписьюГлобальнойОбработки(Отказ);
		//ЭтотОбъект.Назначение.Очистить();
	Иначе
		ПередЗаписьюНазначаемойОбработки(Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	Если ЭтотОбъект.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если РаботаСДополнительнымиОтчетамиИОбработками.ЭтоГлобальнаяОбработка(ЭтотОбъект.Вид) Тогда
		ПередУдалениемГлобальнойОбработки(Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ЭтотОбъект.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	// блокирующие проверки
	ПроверитьЦелостностьСсылокНаПараметрыИГруппы(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// основной функционал
	Если РаботаСДополнительнымиОтчетамиИОбработками.ЭтоГлобальнаяОбработка(ЭтотОбъект.Вид) Тогда
		ПриЗаписиГлобальнойОбработки(Отказ);
	Иначе
		ПриЗаписиНазначаемойОбработки(Отказ);
	КонецЕсли;
	
КонецПроцедуры
