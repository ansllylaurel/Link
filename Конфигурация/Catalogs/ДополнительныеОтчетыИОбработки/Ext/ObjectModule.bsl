Процедура ПроверитьЦелостностьСсылокНаПараметрыИГруппы(Отказ)
	
	// Выделим команды, ссылающиеся на отсутствующие группы
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДополнительныеОтчетыИОбработкиКоманды.Представление КАК Команда
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки.Команды КАК ДополнительныеОтчетыИОбработкиКоманды
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДополнительныеОтчетыИОбработки.ГруппыПараметров КАК ДополнительныеОтчетыИОбработкиГруппыПараметров
		|		ПО ДополнительныеОтчетыИОбработкиКоманды.ГруппаПараметров = ДополнительныеОтчетыИОбработкиГруппыПараметров.Идентификатор
		|			И ДополнительныеОтчетыИОбработкиКоманды.Ссылка = ДополнительныеОтчетыИОбработкиГруппыПараметров.Ссылка
		|ГДЕ
		|	ДополнительныеОтчетыИОбработкиКоманды.Ссылка = &Ссылка
		|	И ДополнительныеОтчетыИОбработкиКоманды.ГруппаПараметров <> &ПустойИдентификатор
		|	И ДополнительныеОтчетыИОбработкиГруппыПараметров.Идентификатор ЕСТЬ NULL ";
		
	Запрос.УстановитьПараметр("Ссылка",              ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("ПустойИдентификатор", Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствует группа параметров, на который ссылается команда '" + Выборка.Команда + "'",,,, Отказ);
	КонецЦикла;
	
	// Выделим параметры, ссылающиеся на отсутствующие группы
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДополнительныеОтчетыИОбработкиПараметры.Имя КАК Параметр
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки.Параметры КАК ДополнительныеОтчетыИОбработкиПараметры
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДополнительныеОтчетыИОбработки.ГруппыПараметров КАК ДополнительныеОтчетыИОбработкиГруппыПараметров
		|		ПО ДополнительныеОтчетыИОбработкиПараметры.Группа = ДополнительныеОтчетыИОбработкиГруппыПараметров.Идентификатор
		|			И ДополнительныеОтчетыИОбработкиПараметры.Ссылка = ДополнительныеОтчетыИОбработкиГруппыПараметров.Ссылка
		|ГДЕ
		|	ДополнительныеОтчетыИОбработкиПараметры.Ссылка = &Ссылка
		|	И ДополнительныеОтчетыИОбработкиГруппыПараметров.Идентификатор ЕСТЬ NULL ";
		
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствует группа, на который ссылаются параметры",,,, Отказ);
	КонецЦикла;
	
КонецПроцедуры // ПроверитьЦелостностьСсылокНаПараметрыИГруппы


