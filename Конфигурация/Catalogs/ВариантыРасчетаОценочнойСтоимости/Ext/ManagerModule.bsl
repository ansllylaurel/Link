			|	_ЗадолженностиПоВторойЧастиРЕПООстатки.ТипЗадолженности КАК ТипЗадолженности,
			|	_ЗадолженностиПоВторойЧастиРЕПООстатки.Рынок КАК Рынок,
			|	_ЗадолженностиПоВторойЧастиРЕПООстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	&ПолеСделкаРЕПО КАК СделкаРЕПО,
			|	_ЗадолженностиПоВторойЧастиРЕПООстатки.КоличествоОстаток КАК КоличествоОстаток
			|ПОМЕСТИТЬ _ЗадолженностиПоВторойЧастиРЕПООстаткиБезОтборов
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК _ЗадолженностиПоВторойЧастиРЕПООстатки";
		
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ПлановыеДанные_ЗадолженностиПоВторойЧастиРЕПО") <> Неопределено Тогда
			
			#Область Дополнение_плановыми_данными
			
			// Меняем псевдоним временной таблицы,
			// объединяем выборку из регистра с плановыми данными,
			// группируем и помещаем в ВТ
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ _ЗадолженностиПоВторойЧастиРЕПООстаткиБезОтборов", "ПОМЕСТИТЬ _ЗадолженностиПоВторойЧастиРЕПООстаткиСПлановымиДанными");
			Запрос.Текст = Запрос.Текст + 
				"
				|	ОБЪЕДИНИТЬ ВСЕ
				|
				|";
			
			Запрос.Текст = Запрос.Текст + 
				"ВЫБРАТЬ
				|	_ПлановыеДанные.ТипЗадолженности КАК ТипЗадолженности,
				|	_ПлановыеДанные.Рынок КАК Рынок,
				|	_ПлановыеДанные.ЦеннаяБумага КАК ЦеннаяБумага,
				|	&ПолеСделкаРЕПО КАК СделкаРЕПО,
				|	_ПлановыеДанные.Количество КАК Количество
				|ИЗ
				|	_ПлановыеДанные_ЗадолженностиПоВторойЧастиРЕПО КАК _ПлановыеДанные
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ЗадолженностиПоВторойЧастиРЕПООстаткиСПлановымиДанными.ТипЗадолженности КАК ТипЗадолженности,
				|	_ЗадолженностиПоВторойЧастиРЕПООстаткиСПлановымиДанными.Рынок КАК Рынок,
				|	_ЗадолженностиПоВторойЧастиРЕПООстаткиСПлановымиДанными.ЦеннаяБумага КАК ЦеннаяБумага,
				|	_ЗадолженностиПоВторойЧастиРЕПООстаткиСПлановымиДанными.СделкаРЕПО КАК СделкаРЕПО,
				|	СУММА(_ЗадолженностиПоВторойЧастиРЕПООстаткиСПлановымиДанными.КоличествоОстаток) КАК КоличествоОстаток
				|ПОМЕСТИТЬ _ЗадолженностиПоВторойЧастиРЕПООстаткиБезОтборов
				|ИЗ
				|	_ЗадолженностиПоВторойЧастиРЕПООстаткиСПлановымиДанными КАК _ЗадолженностиПоВторойЧастиРЕПООстаткиСПлановымиДанными
				|
				|СГРУППИРОВАТЬ ПО
				|	_ЗадолженностиПоВторойЧастиРЕПООстаткиСПлановымиДанными.ТипЗадолженности,
				|	_ЗадолженностиПоВторойЧастиРЕПООстаткиСПлановымиДанными.Рынок,
				|	_ЗадолженностиПоВторойЧастиРЕПООстаткиСПлановымиДанными.ЦеннаяБумага,
				|	_ЗадолженностиПоВторойЧастиРЕПООстаткиСПлановымиДанными.СделкаРЕПО
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|УНИЧТОЖИТЬ _ЗадолженностиПоВторойЧастиРЕПООстаткиСПлановымиДанными";
			
			#КонецОбласти
			
		КонецЕсли;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеСделкаРЕПО", ?(РасчетПартий = Неопределено, "НЕОПРЕДЕЛЕНО", "СделкаРЕПО"));
		
		Запрос.Выполнить();
		
		#КонецОбласти
		
	КонецЕсли;

	ПоместитьТаблицуСОтборомВМенеджерВременныхТаблиц(Запрос, "_ЗадолженностиПоВторойЧастиРЕПООстаткиБезОтборов", "_ЗадолженностиПоВторойЧастиРЕПООстатки", Отбор);	

КонецПроцедуры

Процедура ПоместитьЗадолженностиПоВзносамВУставныйКапиталВМенеджерВременныхТаблиц(Запрос, Отбор = "") Экспорт
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ЗадолженностиПоВзносамВУставныйКапиталОстаткиБезОтборов") = Неопределено Тогда

		#Область Получение_задолженностей_по_взносам_в_уставной_капитал_без_отборов 
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_НезакрытыеРешения.РешениеОбИзмененииУставногоКапитала КАК РешениеОбИзмененииУставногоКапитала,
			|	ЗадолженностиПоДенежнымСредствам.Валюта КАК Валюта,
			|	СУММА(ЗадолженностиПоДенежнымСредствам.Сумма) КАК Сумма,
			|	_НезакрытыеРешения.РешениеОбИзмененииУставногоКапитала.Доля КАК Доля,
			|	_НезакрытыеРешения.РешениеОбИзмененииУставногоКапитала.Доля.ЮрЛицо КАК Контрагент
			|ПОМЕСТИТЬ _ЗадолженностиПоВзносамВУставныйКапиталОстаткиБезОтборов
			|ИЗ
			|	РегистрСведений.СостоянияРешенийОбИзмененияхУставныхКапиталовООО.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК _НезакрытыеРешения
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
			|		ПО _НезакрытыеРешения.РешениеОбИзмененииУставногоКапитала = ЗадолженностиПоДенежнымСредствам.Основание
			|			И (ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход))
			|			И (ЗадолженностиПоДенежнымСредствам.Активность)
			|			И (ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВкладуВУставныйКапиталООО))
			|ГДЕ
			|	_НезакрытыеРешения.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияПоручений.)
			|
			|СГРУППИРОВАТЬ ПО
			|	_НезакрытыеРешения.РешениеОбИзмененииУставногоКапитала,
			|	_НезакрытыеРешения.РешениеОбИзмененииУставногоКапитала.Доля,
			|	_НезакрытыеРешения.РешениеОбИзмененииУставногоКапитала.Доля.ЮрЛицо,
			|	ЗадолженностиПоДенежнымСредствам.Валюта";
		
		Запрос.Выполнить();
		
		#КонецОбласти	
		
	КонецЕсли;

	ПоместитьТаблицуСОтборомВМенеджерВременныхТаблиц(Запрос, "_ЗадолженностиПоВзносамВУставныйКапиталОстаткиБезОтборов", "_ЗадолженностиПоВзносамВУставныйКапиталОстатки", Отбор);	

КонецПроцедуры

Процедура ПоместитьТаблицуСОтборомВМенеджерВременныхТаблиц(Запрос, ИмяИсходнойТаблицы, ИмяТаблицыСОтбором, Отбор = "")
	
	СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(Запрос, ИмяТаблицыСОтбором);	
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	*
		|ПОМЕСТИТЬ _ИмяТаблицыСОтбором
		|ИЗ
		|	_ИмяИсходнойТаблицы КАК _ИмяТаблицыСОтбором
		|ГДЕ
		|	&Отбор";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "_ИмяИсходнойТаблицы",	ИмяИсходнойТаблицы);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "_ИмяТаблицыСОтбором",	ИмяТаблицыСОтбором);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Отбор",				?(ПустаяСтрока(Отбор), "ИСТИНА", Отбор));
	
	Запрос.Выполнить();
	
КонецПроцедуры

#КонецОбласти 
