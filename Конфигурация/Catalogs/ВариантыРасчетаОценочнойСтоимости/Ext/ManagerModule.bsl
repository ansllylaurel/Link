				|		ИНАЧЕ -1
				|	КОНЕЦ * _ИтоговаяТаблица.СуммаВВалютеУчета КАК СуммаРынокВВалютеУчета,
				|	_ИтоговаяТаблица.ВидЗадолженности КАК ВидЗадолженности,
				|	ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка) КАК Контрагент,
				|	ВЫБОР
				|		КОГДА _ИтоговаяТаблица.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
				|			ТОГДА ""ДЗ: ""
				|		ИНАЧЕ ""КЗ: ""
				|	КОНЕЦ + ВидыЗадолженности.Наименование КАК Примечание,
				|	_ИтоговаяТаблица.Рынок КАК Рынок,
				|	_ИтоговаяТаблица.ВидЦены КАК ВидЦены,
				|	_ИтоговаяТаблица.ЕстьСправедливаяЦена КАК ЕстьСправедливаяЦена
				|ПОМЕСТИТЬ _СделкиСОтложеннымИсполнением
				|ИЗ
				|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыЗадолженности КАК ВидыЗадолженности
				|		ПО _ИтоговаяТаблица.ВидЗадолженности = ВидыЗадолженности.Ссылка";
			
			Запрос.Выполнить();
			
		КонецЕсли;	
		
		#КонецОбласти	
		
	ИначеЕсли ВариантРасчетаЗадолженности = "ЗадолженностьПриУчетеБумагВДеньТПлюс" Тогда
		
		#Область Учитывающие_бумаги_в_день_ТПлюс 		
		
		Запрос.УстановитьПараметр("ВалютаУчета",					Организация.ВалютаУчета);
		Запрос.УстановитьПараметр("Организация",					Организация);
		Запрос.УстановитьПараметр("Период",							Новый Граница(КонецДня(Период), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
		
		ПоместитьКурсыВалютВМенеджерВременныхТаблиц(Запрос, Период);
		ПоместитьЗадолженностиПоЦеннымБумагамВМенеджерВременныхТаблиц(Запрос, "_ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)");
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ЗадолженностиПоЦеннымБумагамОстатки.Основание КАК Основание,
			|	_ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_ЗадолженностиПоЦеннымБумагамОстатки.Валюта КАК Валюта,
			|	ВЫБОР
			|		КОГДА _ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|			ТОГДА -_ЗадолженностиПоЦеннымБумагамОстатки.СуммаОстаток - _ЗадолженностиПоЦеннымБумагамОстатки.СуммаКупонаОстаток
			|		ИНАЧЕ _ЗадолженностиПоЦеннымБумагамОстатки.СуммаОстаток + _ЗадолженностиПоЦеннымБумагамОстатки.СуммаКупонаОстаток
			|	КОНЕЦ КАК Сумма
			|ПОМЕСТИТЬ Задолженности
			|ИЗ
			|	_ЗадолженностиПоЦеннымБумагамОстатки КАК _ЗадолженностиПоЦеннымБумагамОстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	6 КАК Приоритет,
			|	ВЫБОР
			|		КОГДА Задолженности.Сумма > 0
			|			ТОГДА ""ДЗ: по сделке Т+""
			|		ИНАЧЕ ""КЗ: по сделке Т+""
			|	КОНЕЦ КАК Примечание,
			|	&ВалютаУчета КАК ВалютаСтроки,
			|	Задолженности.ЦеннаяБумага КАК СубъектАналитики,
			|	Задолженности.Сумма * КурсыВалют.Курс КАК СуммаРынокВВалютеУчета,
			|	Задолженности.Сумма КАК СуммаРынок,
			|	ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка) КАК Контрагент,
			|	Задолженности.Основание КАК Основание,
			|	ВЫБОР
			|		КОГДА Задолженности.Сумма > 0
			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
			|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
			|	КОНЕЦ КАК ВидАктива,
			|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке) КАК ВидЗадолженности,
			|	НЕОПРЕДЕЛЕНО КАК Рынок,			
			|	НЕОПРЕДЕЛЕНО КАК ВидЦены,			
			|	ИСТИНА КАК ЕстьСправедливаяЦена
			|ПОМЕСТИТЬ _СделкиСОтложеннымИсполнением
			|ИЗ
			|	Задолженности КАК Задолженности
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК КурсыВалют
			|		ПО Задолженности.Валюта = КурсыВалют.Валюта";
		
		Запрос.Выполнить();
		
		#КонецОбласти	
		
	КонецЕсли; 
	
	Отказ = ?(ЕстьОшибки, ЕстьОшибки, Отказ);
	
	// Если задолженности не рассчитаны, заполняем пустой таблицей,
	// иначе проверяем все ли цены были определены		
	Если МенеджерВременныхТаблиц.Таблицы.Найти("_СделкиСОтложеннымИсполнением") = Неопределено Тогда

		СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ПолучитьПустуюТаблицуСделок(), "_СделкиСОтложеннымИсполнением", МенеджерВременныхТаблиц);		

	Иначе
		
		#Область Проверка_что_цены_для_бумаг_ТПлюс_определены
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_СделкиСОтложеннымИсполнением.Рынок КАК Рынок,
			|	_СделкиСОтложеннымИсполнением.СубъектАналитики КАК ЦеннаяБумага,
			|	_СделкиСОтложеннымИсполнением.ВидЦены КАК ВидЦены
			|ИЗ
			|	_СделкиСОтложеннымИсполнением КАК _СделкиСОтложеннымИсполнением
			|ГДЕ
			|	НЕ _СделкиСОтложеннымИсполнением.ЕстьСправедливаяЦена";
		
		ТаблицаПроверки = Запрос.Выполнить().Выгрузить();
				
		Для Каждого СтрокаПроверки Из ТаблицаПроверки Цикл	
			
			Если Не Документы.РегистрацияСтоимостиПереоценки.ДопустимаНулеваяЦена(СтрокаПроверки) Тогда
				
				ТекстОшибки = СтрШаблон("При оценке активов/обязательств по сделкам Т+ не удалось определить справедливую стоимость бумаги '%1'", СтрокаПроверки.ЦеннаяБумага);
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , , , Отказ);	
				
			КонецЕсли;

		КонецЦикла;
		
		#КонецОбласти
		
	КонецЕсли;	
				
	УдалитьЛишниеВТ(МенеджерВременныхТаблиц, МассивИсходныхВТ);		

КонецПроцедуры

Процедура ПолучитьЗадолженностиПоСделкамСВалютойСОтложеннымИсполнением(ВариантРасчетаОценочнойСтоимости, Организация, СчетДоверительногоУправления, Период, Отказ, МенеджерВременныхТаблиц) Экспорт
	
	МассивИсходныхВТ = СистемныеФункции.ПолучитьИменаВременныхТаблицЗапроса(МенеджерВременныхТаблиц);
	МассивИсходныхВТ.Добавить("_СделкиСВалютой");
	
	// Подумать над рефакторингом, т.к. варианты РазницаМеждуСправедливойСтоимостьюВалютыВРубляхИСтоимостьюВалютыВДоговоре и ЗадолженностиПоВнебиржевымСделкам
	// отличаются только тем, что во втором используются внебиржевые сделки, а в первом задолженности свернуты по сделке (#Техдолг) 
	
	// Варианты	
	
	ВариантРасчетаЗадолженности = Неопределено;
	
	Если ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2018
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2020
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2021
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2018
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2021
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ_УКПИ
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ПФР2018 
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ПФР2019_УКПИ
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Традиция2019
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФк_ФДЦБ
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФк_ФДЦБ2021
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020 И НачалоДня(Период) < '20240417'
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ППА2018
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_Нефтегарант2018 И НачалоДня(Период) >= '20200907'
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Эволюция2021
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Эволюция2021_2
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Большой
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Перспектива2020
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Федерация2021
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020
			И Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период) = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФОПФ")
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Гефест
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Ростех
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.СредневзвешеннаяЕПС
	Тогда
		
		// Справедливая стоимость задолженности по сделкам с валютой, заключенным на условиях Т+, 
		// определяется в размере разницы между справедливой стоимостью валюты в рублях
		// и стоимостью валюты в рублях, зафиксированной в договоре на дату исполнения сделки
		
		ВариантРасчетаЗадолженности = "РазницаМеждуСправедливойСтоимостьюВалютыВРубляхИСтоимостьюВалютыВДоговоре";
		
	ИначеЕсли ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ 
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФондФилософии
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РПИ 
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ЛонгТермИнвестментс
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФОГФ
	Тогда

		// Задолженность по сделкам, заключенным в иностранной валюте, отражается в рублях по курсу,
		// установленному Центральным банком Российской Федерации на дату оценки Активов
		
		// Задолженности по сделкам, заключенным на торгах Организаторов торговли с датой расчетов отличной
		// от даты заключения сделки, в расчет стоимости Активов не принимаются	
		
		ВариантРасчетаЗадолженности = "ЗадолженностиПоВнебиржевымСделкам";
		
	// #297789 Временное отключение расчета для методики Сургутнефтегаз2018 с 01.01.2020 
	// #309914 НПФ Согласие написал письмо, что сделки с валютой учитывать в СЧА не нужно (только комиссии в дебиторке)
	ИначеЕсли ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Сургутнефтегаз2018 И НачалоДня(Период) >= '20200101'
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Сургутнефтегаз2020
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Согласие2019
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_Нефтегарант2018 И НачалоДня(Период) >= '20200101' И НачалоДня(Период) < '20200907' 
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом
			И Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период) = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар") // #381305
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020 И НачалоДня(Период) >= '20240417'	
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПФР2020
	Тогда
		
		// Задолженность по сделкам Т+ с валютой не включается в СЧА
		
		ВариантРасчетаЗадолженности = "НеРассчитывать";
		
	КонецЕсли;
	
	// Расчет
		
	Если ВариантРасчетаЗадолженности = "РазницаМеждуСправедливойСтоимостьюВалютыВРубляхИСтоимостьюВалютыВДоговоре" Тогда
		
		#Область Разница_между_справедливой_стоимостью_валюты_в_рублях_и_стоимостью_валюты_в_договоре
		
		// В случае положительной разницы, сделка признается в составе активов (дебиторская задолженность) у покупателя/ 
		// в составе обязательств (кредиторская задолженность) у продавца, 
		// отрицательной разницы - в составе обязательств (кредиторская задолженность) у покупателя/
		// в составе активов (дебиторская задолженность) у продавца.
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
			|	ВЫБОР
			|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|				И ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток > 0
			|			ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток
			|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|				И ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток < 0
			|			ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток
			|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
			|				И ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток > 0
