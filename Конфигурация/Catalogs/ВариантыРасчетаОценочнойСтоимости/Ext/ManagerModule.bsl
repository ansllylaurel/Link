			|			ЛЕВОЕ СОЕДИНЕНИЕ _СправедливаяСтоимостьЦенныхБумагРЕПО КАК _СправедливаяСтоимостьЦенныхБумаг
			|			ПО _ЗадолженностиПоПервойЧастиРЕПО.Рынок = _СправедливаяСтоимостьЦенныхБумаг.Рынок
			|				И _ЗадолженностиПоПервойЧастиРЕПО.ЦеннаяБумага = _СправедливаяСтоимостьЦенныхБумаг.ЦеннаяБумага
			|				И _ЗадолженностиПоПервойЧастиРЕПО.ТипЗадолженности = _СправедливаяСтоимостьЦенныхБумаг.ТипЗадолженности
			|				И (НЕ &УчитыватьПартииБумагРЕПО
			|					ИЛИ _ЗадолженностиПоПервойЧастиРЕПО.СделкаРЕПО = _СправедливаяСтоимостьЦенныхБумаг.Основание)
			|		ПО _СделкиКАнализу.СделкаРЕПО = _ЗадолженностиПоПервойЧастиРЕПО.СделкаРЕПО
			|			И _СделкиКАнализу.ЦеннаяБумага = _ЗадолженностиПоПервойЧастиРЕПО.ЦеннаяБумага
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ЧастиЗадолженностиПоЦБ КАК _ЧастиЗадолженностиПоЦБ
			|		ПО (НЕ _ЧастиЗадолженностиПоЦБ.Часть = ""КУПОН""
			|				ИЛИ (_СправедливаяСтоимостьЦенныхБумаг.СуммаКупонаВВалютеУчета ЕСТЬ НЕ NULL 
			|						И _СправедливаяСтоимостьЦенныхБумаг.СуммаКупонаВВалютеУчета <> 0
			|					ИЛИ _СправедливаяСтоимостьЦенныхБумаг.СправедливаяЦенаКупонаВВалютеУчета ЕСТЬ НЕ NULL 
			|						И _СправедливаяСтоимостьЦенныхБумаг.СправедливаяЦенаКупонаВВалютеУчета <> 0))
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _СделкиКАнализу
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ДатыИсполнения
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ЗадолженностиПоВторойЧастиРЕПО
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ЗадолженностиПоПервойЧастиРЕПО
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ЧастиЗадолженностиПоЦБ";
		
		#КонецОбласти
		
		ЗадолженностьПоСделкамРЕПО = Запрос.Выполнить().Выгрузить();
		
		// Проверим наличие цен  		
		
		Для Каждого СтрокаЗадолженности Из ЗадолженностьПоСделкамРЕПО Цикл   			
			Если Не СтрокаЗадолженности.ЕстьСправедливаяЦена Тогда   					
				ТекстОшибки = "При оценке активов/обязательств по сделкам РЕПО не удалось определить справедливую стоимость для бумаги " + СокрЛП(СтрокаЗадолженности.ЦеннаяБумага);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , , , Отказ);
				УдалитьЛишниеВТ(МенеджерВременныхТаблиц, МассивИсходныхВТ);				
				Возврат;
			КонецЕсли;							
		КонецЦикла;

		СчитатьРаспределениеПоСтарому = Период < Дата(2020,5,1) И ВариантРасчетаПроцентовПоСделкамРЕПО = Перечисления.ВариантыРасчетаПроцентовПоСделкамРЕПО.ПоРавномерномуРаспределениюПоДням;
		
		Если НЕ СчитатьРаспределениеПоСтарому Тогда 
			СуммыРЕПОСПроцентами = Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.РассчитатьПроцентыПоРЕПО(Организация, СчетДоверительногоУправления, Период, ЦельРасчета,, ЕстьОшибки, ТочностьРасчетнойСтавкиРЕПО);
			
			Если ЕстьОшибки Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить расчет процентов по сделкам РЕПО", ,,,Отказ);
				УдалитьЛишниеВТ(МенеджерВременныхТаблиц, МассивИсходныхВТ);
				Возврат;
			КонецЕсли;
			
			СуммыРЕПОСПроцентами.Свернуть("Основание, ВалютаСделки", "СуммаПроцентов");
		КонецЕсли;
		
		// Оцениваем дебиторскую задолженность 		
		
		Для Каждого СтрокаЗадолженности Из ЗадолженностьПоСделкамРЕПО Цикл
			
			Если СтрокаЗадолженности.Примечание = "Задолженность по ДС" Тогда
				
				Если СчитатьРаспределениеПоСтарому Тогда
					
					СтрокаЗадолженности.ЗадолженностьПоСС			= СтрокаЗадолженности.ЗадолженностьПропорциональноДнямВРЕПО;
					СтрокаЗадолженности.ЗадолженностьВВалютеУчета	= СтрокаЗадолженности.ЗадолженностьПропорциональноДнямВРЕПОВВалютеУчета;
					
				Иначе	
					
					СтрокаРЕПОСПроцентами = СуммыРЕПОСПроцентами.Найти(СтрокаЗадолженности.СделкаРЕПО, "Основание");
					
					Если СтрокаРЕПОСПроцентами = Неопределено Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определена сумма процентов по сделке РЕПО "+СтрокаЗадолженности.СделкаРЕПО, ,,,Отказ);
						Продолжить;
					КонецЕсли;
					
					СтрокаЗадолженности.ЗадолженностьПоСС = СтрокаЗадолженности.Задолженность + ?(СтрокаЗадолженности.ВидСделки = Перечисления.ВидыСделок.Продажа, -1, 1) * СтрокаРЕПОСПроцентами.СуммаПроцентов;
					СтрокаЗадолженности.ЗадолженностьВВалютеУчета =  Окр(СтрокаЗадолженности.ЗадолженностьПоСС * СтрокаЗадолженности.КурсВалюты / СтрокаЗадолженности.КурсВалютыУчета, 2);
					
				КонецЕсли;
					
			ИначеЕсли СтрокаЗадолженности.Примечание = "Задолженность по ЦБ" Тогда
				
				СтрокаЗадолженности.Задолженность = СтрокаЗадолженности.ЗадолженностьПоСС;
					
			КонецЕсли;
			
		КонецЦикла;
		
		// Подготавливаем данные для помещения в регистрацию стоимости активов		
		
		#Область Запрос_для_помещения_в_регистрацию_стоимости_активов

		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ЗадолженностьПоСделкамРЕПО.ВидСделки КАК ВидСделки,
			|	_ЗадолженностьПоСделкамРЕПО.СделкаРЕПО КАК СделкаРЕПО,
			|	_ЗадолженностьПоСделкамРЕПО.Валюта КАК Валюта,
			|	_ЗадолженностьПоСделкамРЕПО.Ставка КАК Ставка,
			|	_ЗадолженностьПоСделкамРЕПО.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_ЗадолженностьПоСделкамРЕПО.ТипЗадолженности КАК ТипЗадолженности,
			|	_ЗадолженностьПоСделкамРЕПО.ВидЗадолженности КАК ВидЗадолженности,
			|	_ЗадолженностьПоСделкамРЕПО.ЗадолженностьПоСС КАК ЗадолженностьПоСС,
			|	_ЗадолженностьПоСделкамРЕПО.ЗадолженностьВВалютеУчета КАК ЗадолженностьВВалютеУчета,
			|	_ЗадолженностьПоСделкамРЕПО.Примечание КАК Примечание
			|ПОМЕСТИТЬ _ЗадолженностьПоСделкамРЕПО
			|ИЗ
			|	&ЗадолженностьПоСделкамРЕПО КАК _ЗадолженностьПоСделкамРЕПО
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	5 КАК Приоритет,
			|	ВЫБОР
			|		КОГДА _ЗадолженностьПоСделкамРЕПО.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|			ТОГДА ""ДЗ: ""
			|		ИНАЧЕ ""КЗ: ""
			|	КОНЕЦ + ВЫБОР
			|		КОГДА _ЗадолженностьПоСделкамРЕПО.Примечание = ""Задолженность по ДС""
			|			ТОГДА ""денежные средства, перечисленные по операциям на возвратной основе""
			|		ИНАЧЕ ""ценные бумаги, переданные по операциям на возвратной основе""
			|	КОНЕЦ КАК Примечание,
			|	_ЗадолженностьПоСделкамРЕПО.Валюта КАК ВалютаСтроки,
			|	_ЗадолженностьПоСделкамРЕПО.ЦеннаяБумага КАК СубъектАналитики,
			|	ВЫБОР
			|		КОГДА _ЗадолженностьПоСделкамРЕПО.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|			ТОГДА 1
			|		ИНАЧЕ -1
			|	КОНЕЦ * _ЗадолженностьПоСделкамРЕПО.ЗадолженностьПоСС КАК СуммаРынок,
			|	ВЫБОР
			|		КОГДА _ЗадолженностьПоСделкамРЕПО.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|			ТОГДА 1
			|		ИНАЧЕ -1
			|	КОНЕЦ * _ЗадолженностьПоСделкамРЕПО.ЗадолженностьВВалютеУчета КАК СуммаРынокВВалютеУчета,
			|	ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка) КАК Контрагент,
			|	_ЗадолженностьПоСделкамРЕПО.СделкаРЕПО КАК Основание,
			|	ВЫБОР
			|		КОГДА _ЗадолженностьПоСделкамРЕПО.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
			|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
			|	КОНЕЦ КАК ВидАктива,
			|	_ЗадолженностьПоСделкамРЕПО.ВидЗадолженности КАК ВидЗадолженности
			|ПОМЕСТИТЬ _СделкиРЕПО
			|ИЗ
			|	_ЗадолженностьПоСделкамРЕПО КАК _ЗадолженностьПоСделкамРЕПО";
		
		#КонецОбласти

		Запрос.УстановитьПараметр("Период",						КонецДня(Период));
		Запрос.УстановитьПараметр("ЗадолженностьПоСделкамРЕПО",	ЗадолженностьПоСделкамРЕПО);
		
		Запрос.Выполнить();
		
		#КонецОбласти
		
	ИначеЕсли НастройкиСделокРЕПО.ВариантРасчетаЗадолженности = "ОсновнойДолгПлюсПроцент" Тогда	  	
		
		#Область Основной_долг_плюс_процент		
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
		Запрос.УстановитьПараметр("Период",								КонецДня(Период));
		Запрос.УстановитьПараметр("Организация",						Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления",		СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ЦельРасчета",						ЦельРасчета);
		Запрос.УстановитьПараметр("ВалютаРубли",						ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета"));
				
		Запрос.УстановитьПараметр("ИспользоватьНачисленнуюКомиссию",										  НастройкиСделокРЕПО.ПараметрыУчетаКомиссий.ИспользоватьНачисленнуюКомиссию);
		Запрос.УстановитьПараметр("ОкруглятьКомиссиюРассчитаннуюПропорциональноДнямОтДатыСделкиДоДвухЗнаков", НастройкиСделокРЕПО.ПараметрыУчетаКомиссий.ОкруглятьКомиссиюРассчитаннуюПропорциональноДнямОтДатыСделкиДоДвухЗнаков);
		Запрос.УстановитьПараметр("ОтражатьРЕПОВРазделеЗаймы",			?(ЗначениеЗаполнено(НастройкиСделокРЕПО.ОтражатьРЕПОВРазделе), НастройкиСделокРЕПО.ОтражатьРЕПОВРазделе.Ключ = "Займы", Ложь));
		
		ПоместитьКурсыВалютВМенеджерВременныхТаблиц(Запрос, Период);
		
		#Область Текст_запроса

		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	УсловияСделокРЕПО1.СделкаРЕПО КАК СделкаРЕПО,
			|	УсловияСделокРЕПО1.СделкаРЕПО.ВидСделки КАК ВидСделки,
			|	УсловияСделокРЕПО1.СделкаРЕПО.ВалютаСделки КАК ВалютаСделки,
			|	УсловияСделокРЕПО1.СделкаРЕПО.Дата КАК СделкаРЕПОДата,
			|	УсловияСделокРЕПО1.ЦеннаяБумага КАК ЦеннаяБумага,
			|	УсловияСделокРЕПО1.ДатаВторойЧастиРЕПО КАК ДатаВторойЧастиРЕПО,
			|	УсловияСделокРЕПО1.Сумма + УсловияСделокРЕПО1.СуммаКупона КАК СуммаСделки,
			|	ВЫРАЗИТЬ(УсловияСделокРЕПО2.СтавкаРЕПО КАК ЧИСЛО(19, 9)) КАК СтавкаРЕПО,
			|	ВЫБОР
			|		КОГДА УсловияСделокРЕПО1.ДатаОплаты > УсловияСделокРЕПО1.ДатаПоставки
			|			ТОГДА УсловияСделокРЕПО1.ДатаПоставки
			|		ИНАЧЕ УсловияСделокРЕПО1.ДатаОплаты
			|	КОНЕЦ КАК ДатаИсполнения,
			|	УсловияСделокРЕПО1.Сумма + УсловияСделокРЕПО1.СуммаКупона КАК Задолженность,
			|	УсловияСделокРЕПО2.Сумма + УсловияСделокРЕПО2.СуммаКупона КАК СуммаВторойЧастиРЕПО,
			|	УсловияСделокРЕПО1.ОтложенноеИсполнение КАК ОтложенноеИсполнение
			|ПОМЕСТИТЬ _СделкиКАнализу
			|ИЗ
			|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И ЧастьСделкиРЕПО = 1
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК УсловияСделокРЕПО1
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И ЧастьСделкиРЕПО = 2
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК УсловияСделокРЕПО2
			|		ПО УсловияСделокРЕПО1.Организация = УсловияСделокРЕПО2.Организация
			|			И УсловияСделокРЕПО1.СделкаРЕПО = УсловияСделокРЕПО2.СделкаРЕПО
			|			И УсловияСделокРЕПО1.Рынок = УсловияСделокРЕПО2.Рынок
			|			И УсловияСделокРЕПО1.ЦеннаяБумага = УсловияСделокРЕПО2.ЦеннаяБумага
			|ГДЕ
			|	(УсловияСделокРЕПО1.ДатаОплаты <= &Период
			|			ИЛИ УсловияСделокРЕПО1.ДатаПоставки <= &Период)
			|	И НЕ УсловияСделокРЕПО1.Отменено
			|	И (УсловияСделокРЕПО2.ДатаОплаты > &Период
			|				И УсловияСделокРЕПО2.ДатаПоставки > &Период
			|			ИЛИ УсловияСделокРЕПО2.ДатаОплаты = ДАТАВРЕМЯ(1, 1, 1)
			|				И УсловияСделокРЕПО2.ДатаПоставки = ДАТАВРЕМЯ(1, 1, 1))
			|	И НЕ УсловияСделокРЕПО2.Отменено
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	СделкаРЕПО
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВложенныйЗапрос.СделкаРЕПО КАК СделкаРЕПО,
			|	МИНИМУМ(НАЧАЛОПЕРИОДА(ВложенныйЗапрос.Период, ДЕНЬ)) КАК ДатаИсполнения
			|ПОМЕСТИТЬ _ДатыИсполнения
			|ИЗ
			|	(ВЫБРАТЬ
			|		_СделкиКАнализу.СделкаРЕПО КАК СделкаРЕПО,
			|		ЗадолженностиПоДенежнымСредствам.Период КАК Период
			|	ИЗ
			|		_СделкиКАнализу КАК _СделкиКАнализу
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
			|			ПО _СделкиКАнализу.СделкаРЕПО = ЗадолженностиПоДенежнымСредствам.Основание
			|				И _СделкиКАнализу.СделкаРЕПО <> ЗадолженностиПоДенежнымСредствам.Регистратор
			|				И _СделкиКАнализу.ДатаИсполнения <= ЗадолженностиПоДенежнымСредствам.Период
			|				И (ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО))
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		_СделкиКАнализу.СделкаРЕПО,
			|		ЗадолженностиПоЦеннымБумагам.Период
