				|
				|";
			
			Запрос.Текст = Запрос.Текст + 
				"ВЫБРАТЬ
				|	_ПлановыеДанные.Рынок КАК Рынок,
				|	_ПлановыеДанные.ЦеннаяБумага КАК ЦеннаяБумага,
				|	_ПлановыеДанные.Количество КАК Количество
				|ИЗ
				|	_ПлановыеДанные_ОстаткиЦенныхБумаг КАК _ПлановыеДанные
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ОстаткиЦенныхБумагОстаткиСПлановымиДанными.Рынок КАК Рынок,
				|	_ОстаткиЦенныхБумагОстаткиСПлановымиДанными.ЦеннаяБумага КАК ЦеннаяБумага,
				|	СУММА(_ОстаткиЦенныхБумагОстаткиСПлановымиДанными.КоличествоОстаток) КАК КоличествоОстаток
				|ПОМЕСТИТЬ _ОстаткиЦенныхБумагОстаткиБезОтборов
				|ИЗ
				|	_ОстаткиЦенныхБумагОстаткиСПлановымиДанными КАК _ОстаткиЦенныхБумагОстаткиСПлановымиДанными
				|
				|СГРУППИРОВАТЬ ПО
				|	_ОстаткиЦенныхБумагОстаткиСПлановымиДанными.Рынок,
				|	_ОстаткиЦенныхБумагОстаткиСПлановымиДанными.ЦеннаяБумага
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|УНИЧТОЖИТЬ _ОстаткиЦенныхБумагОстаткиСПлановымиДанными";
			
			#КонецОбласти	
			
		КонецЕсли;
		
		Запрос.Выполнить();
		
		#КонецОбласти
		
	КонецЕсли;
	
	ПоместитьТаблицуСОтборомВМенеджерВременныхТаблиц(Запрос, "_ОстаткиЦенныхБумагОстаткиБезОтборов", "_ОстаткиЦенныхБумагОстатки", Отбор);	

КонецПроцедуры

Процедура ПоместитьОстаткиЦенныхБумагЗаблокированныеВМенеджерВременныхТаблиц(Запрос, Отбор = "") Экспорт

	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ОстаткиЦенныхБумагЗаблокированныеОстаткиБезОтборов") = Неопределено Тогда

		#Область Получение_остатков_заблокированных_ценных_бумаг_без_отборов
		
		Запрос.Текст = 
