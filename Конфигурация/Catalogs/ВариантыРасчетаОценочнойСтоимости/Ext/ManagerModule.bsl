			|	Комиссии.ВидСделки,
			|	Комиссии.СделкаРЕПО,
			|	Комиссии.ВалютаСделки,
			|	Комиссии.СтавкаРЕПО,
			|	Комиссии.ЦеннаяБумага,
			|	Комиссии.ДатаИсполненияПервойЧасти,
			|	Комиссии.ДатаИсполненияВторойЧасти";
		
		#КонецОбласти

		ЗадолженностьПоСделкамРЕПО = Запрос.Выполнить().Выгрузить(); 
			
		Если ЗадолженностьПоСделкамРЕПО.Количество() = 0 Тогда
			
			// При отсутствии задолженностей по сделкам проверять настройки и выполнять расчет не требуется
			
		ИначеЕсли Не ЗначениеЗаполнено(ВариантРасчетаПроцентовПоСделкамРЕПО) Тогда	
			
			// Сумма первой части РЕПО + равномерно распределенные по дням комиссии	
			
		ИначеЕсли ВариантРасчетаПроцентовПоСделкамРЕПО = Перечисления.ВариантыРасчетаПроцентовПоСделкамРЕПО.ПоСтавкеОтПервойЧастиРЕПО
			ИЛИ ВариантРасчетаПроцентовПоСделкамРЕПО = Перечисления.ВариантыРасчетаПроцентовПоСделкамРЕПО.ПоРасчетнойСтавке
			ИЛИ ВариантРасчетаПроцентовПоСделкамРЕПО = Перечисления.ВариантыРасчетаПроцентовПоСделкамРЕПО.ПоРавномерномуРаспределениюПоДням
		Тогда			
			
			СуммыРЕПОСПроцентами = Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.РассчитатьПроцентыПоРЕПО(Организация, СчетДоверительногоУправления, Период, ЦельРасчета,, ЕстьОшибки, ТочностьРасчетнойСтавкиРЕПО, ВариантРасчетаПроцентовПоСделкамРЕПО);
			
			Если ЕстьОшибки Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить расчет процентов по сделкам РЕПО", ,,,Отказ);
				УдалитьЛишниеВТ(МенеджерВременныхТаблиц, МассивИсходныхВТ);
				Возврат;
			КонецЕсли;
			
			СуммыРЕПОСПроцентами.Свернуть("Основание, ВалютаСделки", "СуммаПроцентов");
			
			Для Каждого СтрокаЗадолженности Из ЗадолженностьПоСделкамРЕПО Цикл
				
				СтрокаРЕПОСПроцентами = СуммыРЕПОСПроцентами.Найти(СтрокаЗадолженности.СделкаРЕПО, "Основание");
				
				Если СтрокаРЕПОСПроцентами = Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определена сумма процентов по сделке РЕПО "+СтрокаЗадолженности.СделкаРЕПО, ,,,ЕстьОшибки);
					Продолжить;
				КонецЕсли;
			
		        СтрокаЗадолженности.СуммаПроцентов = СтрокаРЕПОСПроцентами.СуммаПроцентов;
				
				// По ставке (или расчетной ставке) от суммы первой части РЕПО
				Если ВариантРасчетаПроцентовПоСделкамРЕПО = Перечисления.ВариантыРасчетаПроцентовПоСделкамРЕПО.ПоРасчетнойСтавке Тогда
					
					СтрокаЗадолженности.Ставка = РаботаСоСделкамиРЕПО.РассчитатьСтавкуРЕПО(
						СтрокаЗадолженности.СуммаПервойЧасти,
						СтрокаЗадолженности.СуммаВторойЧасти,
						СтрокаЗадолженности.ДатаИсполненияПервойЧасти,
						СтрокаЗадолженности.ДатаИсполненияВторойЧасти,
						ТочностьРасчетнойСтавкиРЕПО);
					
				КонецЕсли;
			
			КонецЦикла;
					
			// Для равномерного распределения по дням проценты уже рассчитаны в отдельной колонке СуммаПроцентов
			РаботаСоСтоимостьюПоРыночнойСтавке.ПолучитьСтоимостьРЕПОПоРыночнойСтавке(
				ЗадолженностьПоСделкамРЕПО, 
				СчетДоверительногоУправления, 
				Период, 
				Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении,
				НЕ (НастройкиСделокРЕПО.ПараметрыУчетаКомиссий.НеУчитыватьКомиссиюВДебиторке ИЛИ НастройкиСделокРЕПО.ПараметрыУчетаКомиссий.ВыделятьКомиссиюПоСделкам ИЛИ НастройкиСделокРЕПО.ПараметрыУчетаКомиссий.ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки), 
				МенеджерВременныхТаблиц,
				ЕстьОшибки);	
				
		Иначе
			
			СообщитьОНеизвестномВариантеРасчетаПроцентовПоСделкамРЕПО(СчетДоверительногоУправления, ВариантРасчетаПроцентовПоСделкамРЕПО, Отказ);
			УдалитьЛишниеВТ(МенеджерВременныхТаблиц, МассивИсходныхВТ);
			Возврат;    			
			
		КонецЕсли;
		
		Если ЕстьОшибки Тогда
			Отказ = Истина;
			УдалитьЛишниеВТ(МенеджерВременныхТаблиц, МассивИсходныхВТ);
			Возврат;
		КонецЕсли;
		
		Если ЗадолженностьПоСделкамРЕПО.Колонки.Найти("ПроцентыЭСП") = Неопределено Тогда
			ЗадолженностьПоСделкамРЕПО.Колонки.Добавить("ПроцентыЭСП", 	Новый ОписаниеТипов("Число"));
			ЗадолженностьПоСделкамРЕПО.Колонки.Добавить("СуммаРезерва", Новый ОписаниеТипов("Число"));
		КонецЕсли;

		// Подготавливаем данные для помещения в регистрацию стоимости активов		
		// Суммы комиссии пересчитаны в рубли и в валюту сделки в предыдущем запросе
		
		#Область Запрос_для_помещения_в_регистрацию_стоимости_активов

		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ЗадолженностьПоСделкамРЕПО.ВидСделки КАК ВидСделки,
			|	_ЗадолженностьПоСделкамРЕПО.СделкаРЕПО КАК СделкаРЕПО,
			|	_ЗадолженностьПоСделкамРЕПО.Валюта КАК Валюта,
			|	_ЗадолженностьПоСделкамРЕПО.Ставка КАК Ставка,
			|	_ЗадолженностьПоСделкамРЕПО.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_ЗадолженностьПоСделкамРЕПО.БрокерскаяКомиссия КАК БрокерскаяКомиссия,
			|	_ЗадолженностьПоСделкамРЕПО.ТорговаяКомиссия КАК ТорговаяКомиссия,
			|	_ЗадолженностьПоСделкамРЕПО.КомиссияПоРЕПО КАК КомиссияПоРЕПО,
			|	_ЗадолженностьПоСделкамРЕПО.БрокерскаяКомиссияВВалютеСделки КАК БрокерскаяКомиссияВВалютеСделки,
			|	_ЗадолженностьПоСделкамРЕПО.ТорговаяКомиссияВВалютеСделки КАК ТорговаяКомиссияВВалютеСделки,
			|	_ЗадолженностьПоСделкамРЕПО.КомиссияПоРЕПОВВалютеСделки КАК КомиссияПоРЕПОВВалютеСделки,
			|	_ЗадолженностьПоСделкамРЕПО.НоминальнаяТорговаяКомиссия КАК НоминальнаяТорговаяКомиссия,
			|	_ЗадолженностьПоСделкамРЕПО.НоминальнаяБрокерскаяКомиссия КАК НоминальнаяБрокерскаяКомиссия,
			|	ВЫБОР
			|		КОГДА &ОтражатьРЕПОВРазделеЗаймы
			|				И &Период > ДАТАВРЕМЯ(2023, 4, 1)
			|			ТОГДА _ЗадолженностьПоСделкамРЕПО.ЗадолженностьПоСС - _ЗадолженностьПоСделкамРЕПО.ПроцентыЭСП - _ЗадолженностьПоСделкамРЕПО.СуммаРезерва
			|		КОГДА &РаздельныйРасчетРублевыхСуммОсновногоДолгаИПроцентов
			|			ТОГДА _ЗадолженностьПоСделкамРЕПО.ЗадолженностьПоСС - _ЗадолженностьПоСделкамРЕПО.СуммаПроцентов
			|		ИНАЧЕ _ЗадолженностьПоСделкамРЕПО.ЗадолженностьПоСС
			|	КОНЕЦ КАК ЗадолженностьПоСС,
			|	_ЗадолженностьПоСделкамРЕПО.СуммаПроцентов КАК СуммаПроцентов,
			|	ВЫБОР
			|		КОГДА &ОтражатьРЕПОВРазделеЗаймы
			|				И &Период > ДАТАВРЕМЯ(2023, 4, 1)
			|			ТОГДА _ЗадолженностьПоСделкамРЕПО.ПроцентыЭСП + _ЗадолженностьПоСделкамРЕПО.СуммаРезерва
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК ОбесценениеДисконтирование
			|ПОМЕСТИТЬ _ЗадолженностьПоСделкамРЕПООбщая
			|ИЗ
			|	&ЗадолженностьПоСделкамРЕПО КАК _ЗадолженностьПоСделкамРЕПО
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО) КАК ВидЗадолженности,
			|	_ЗадолженностьПоСделкамРЕПО.ВидСделки КАК ВидСделки,
			|	_ЗадолженностьПоСделкамРЕПО.СделкаРЕПО КАК СделкаРЕПО,
			|	_ЗадолженностьПоСделкамРЕПО.Валюта КАК Валюта,
			|	_ЗадолженностьПоСделкамРЕПО.Ставка КАК Ставка,
			|	_ЗадолженностьПоСделкамРЕПО.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_ЗадолженностьПоСделкамРЕПО.ЗадолженностьПоСС + ВЫБОР
			|		КОГДА &РаздельныйРасчетРублевыхСуммОсновногоДолгаИПроцентов
			|			ТОГДА _ЗадолженностьПоСделкамРЕПО.СуммаПроцентов
			|		ИНАЧЕ 0
			|	КОНЕЦ + ВЫБОР
			|		КОГДА &НеУчитыватьКомиссиюВСоставеСделки
			|			ТОГДА 0
			|		ИНАЧЕ _ЗадолженностьПоСделкамРЕПО.КомиссияПоРЕПОВВалютеСделки
			|	КОНЕЦ КАК СуммаРынок,
			|	ВЫБОР
			|		КОГДА &РаздельныйРасчетРублевыхСуммОсновногоДолгаИПроцентов
			|			ТОГДА (ВЫРАЗИТЬ(_ЗадолженностьПоСделкамРЕПО.ЗадолженностьПоСС * КурсыВалют.Курс КАК ЧИСЛО(19, 2))) + (ВЫРАЗИТЬ(_ЗадолженностьПоСделкамРЕПО.СуммаПроцентов * КурсыВалют.Курс КАК ЧИСЛО(19, 2)))
			|		ИНАЧЕ _ЗадолженностьПоСделкамРЕПО.ЗадолженностьПоСС * КурсыВалют.Курс
			|	КОНЕЦ + ВЫБОР
			|		КОГДА &НеУчитыватьКомиссиюВСоставеСделки
			|			ТОГДА 0
			|		ИНАЧЕ _ЗадолженностьПоСделкамРЕПО.КомиссияПоРЕПО
			|	КОНЕЦ КАК СуммаРынокВВалютеУчета
			|ПОМЕСТИТЬ _ЗадолженностьПоСделкамРЕПО
			|ИЗ
			|	_ЗадолженностьПоСделкамРЕПООбщая КАК _ЗадолженностьПоСделкамРЕПО
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК КурсыВалют
			|		ПО (КурсыВалют.Валюта = _ЗадолженностьПоСделкамРЕПО.Валюта)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ОбесценениеДисконтированиеОсновнойДолгИПроценты),
			|	_ЗадолженностьПоСделкамРЕПО.ВидСделки,
			|	_ЗадолженностьПоСделкамРЕПО.СделкаРЕПО,
			|	_ЗадолженностьПоСделкамРЕПО.Валюта,
			|	_ЗадолженностьПоСделкамРЕПО.Ставка,
			|	_ЗадолженностьПоСделкамРЕПО.ЦеннаяБумага,
			|	_ЗадолженностьПоСделкамРЕПО.ОбесценениеДисконтирование,
			|	_ЗадолженностьПоСделкамРЕПО.ОбесценениеДисконтирование * КурсыВалют.Курс
			|ИЗ
			|	_ЗадолженностьПоСделкамРЕПООбщая КАК _ЗадолженностьПоСделкамРЕПО
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК КурсыВалют
			|		ПО (КурсыВалют.Валюта = _ЗадолженностьПоСделкамРЕПО.Валюта)
			|ГДЕ
			|	_ЗадолженностьПоСделкамРЕПО.ОбесценениеДисконтирование <> 0
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии),
			|	_ЗадолженностьПоСделкамРЕПО.ВидСделки,
			|	_ЗадолженностьПоСделкамРЕПО.СделкаРЕПО,
			|	&ВалютаРубли,
			|	_ЗадолженностьПоСделкамРЕПО.Ставка,
			|	_ЗадолженностьПоСделкамРЕПО.ЦеннаяБумага,
			|	_ЗадолженностьПоСделкамРЕПО.ТорговаяКомиссия,
			|	_ЗадолженностьПоСделкамРЕПО.ТорговаяКомиссия
			|ИЗ
			|	_ЗадолженностьПоСделкамРЕПООбщая КАК _ЗадолженностьПоСделкамРЕПО
			|ГДЕ
			|	&ВыделятьКомиссиюПоСделкам
			|	И _ЗадолженностьПоСделкамРЕПО.ТорговаяКомиссия <> 0
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии),
			|	_ЗадолженностьПоСделкамРЕПО.ВидСделки,
			|	_ЗадолженностьПоСделкамРЕПО.СделкаРЕПО,
			|	&ВалютаРубли,
			|	_ЗадолженностьПоСделкамРЕПО.Ставка,
			|	_ЗадолженностьПоСделкамРЕПО.ЦеннаяБумага,
			|	_ЗадолженностьПоСделкамРЕПО.БрокерскаяКомиссия,
			|	_ЗадолженностьПоСделкамРЕПО.БрокерскаяКомиссия
			|ИЗ
			|	_ЗадолженностьПоСделкамРЕПООбщая КАК _ЗадолженностьПоСделкамРЕПО
			|ГДЕ
			|	&ВыделятьКомиссиюПоСделкам
			|	И _ЗадолженностьПоСделкамРЕПО.БрокерскаяКомиссия <> 0
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии),
			|	_ЗадолженностьПоСделкамРЕПО.ВидСделки,
			|	_ЗадолженностьПоСделкамРЕПО.СделкаРЕПО,
			|	&ВалютаРубли,
			|	_ЗадолженностьПоСделкамРЕПО.Ставка,
			|	_ЗадолженностьПоСделкамРЕПО.ЦеннаяБумага,
			|	_ЗадолженностьПоСделкамРЕПО.НоминальнаяТорговаяКомиссия,
			|	_ЗадолженностьПоСделкамРЕПО.НоминальнаяТорговаяКомиссия
			|ИЗ
			|	_ЗадолженностьПоСделкамРЕПООбщая КАК _ЗадолженностьПоСделкамРЕПО
			|ГДЕ
			|	&ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки
			|	И _ЗадолженностьПоСделкамРЕПО.НоминальнаяТорговаяКомиссия <> 0
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии),
			|	_ЗадолженностьПоСделкамРЕПО.ВидСделки,
			|	_ЗадолженностьПоСделкамРЕПО.СделкаРЕПО,
			|	&ВалютаРубли,
			|	_ЗадолженностьПоСделкамРЕПО.Ставка,
			|	_ЗадолженностьПоСделкамРЕПО.ЦеннаяБумага,
			|	_ЗадолженностьПоСделкамРЕПО.НоминальнаяБрокерскаяКомиссия,
			|	_ЗадолженностьПоСделкамРЕПО.НоминальнаяБрокерскаяКомиссия
			|ИЗ
			|	_ЗадолженностьПоСделкамРЕПООбщая КАК _ЗадолженностьПоСделкамРЕПО
			|ГДЕ
			|	&ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки
			|	И _ЗадолженностьПоСделкамРЕПО.НоминальнаяБрокерскаяКомиссия <> 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	5 КАК Приоритет,
			|	ВЫБОР
			|		КОГДА _ЗадолженностьПоСделкамРЕПО.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
			|			ТОГДА ""ДЗ: торговая комиссия по сделкам РЕПО""
			|		КОГДА _ЗадолженностьПоСделкамРЕПО.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
			|			ТОГДА ""ДЗ: брокерская комиссия по сделкам РЕПО""
			|		КОГДА _ЗадолженностьПоСделкамРЕПО.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
			|			ТОГДА ""ДЗ: денежные средства, перечисленные по операциям на возвратной основе""
			|		ИНАЧЕ ""КЗ: денежные средства, перечисленные по операциям на возвратной основе""
			|	КОНЕЦ КАК Примечание,
			|	_ЗадолженностьПоСделкамРЕПО.Валюта КАК ВалютаСтроки,
			|	_ЗадолженностьПоСделкамРЕПО.ЦеннаяБумага КАК СубъектАналитики,
			|	ВЫБОР
			|		КОГДА _ЗадолженностьПоСделкамРЕПО.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
			|			ТОГДА 1
			|		ИНАЧЕ -1
			|	КОНЕЦ * _ЗадолженностьПоСделкамРЕПО.СуммаРынок КАК СуммаРынок,
			|	ВЫБОР
			|		КОГДА _ЗадолженностьПоСделкамРЕПО.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
			|			ТОГДА 1
			|		ИНАЧЕ -1
			|	КОНЕЦ * _ЗадолженностьПоСделкамРЕПО.СуммаРынокВВалютеУчета КАК СуммаРынокВВалютеУчета,
			|	ВЫБОР
			|		КОГДА &ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки
			|				И _ЗадолженностьПоСделкамРЕПО.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))
			|			ТОГДА ВЫРАЗИТЬ(_ЗадолженностьПоСделкамРЕПО.СделкаРЕПО КАК Документ.СделкаРЕПО).Брокер.ЮрФизЛицо
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
			|	КОНЕЦ КАК Контрагент,
			|	_ЗадолженностьПоСделкамРЕПО.СделкаРЕПО КАК Основание,
			|	ВЫБОР
			|		КОГДА _ЗадолженностьПоСделкамРЕПО.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
			|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
			|	КОНЕЦ КАК ВидАктива,
			|	_ЗадолженностьПоСделкамРЕПО.ВидЗадолженности КАК ВидЗадолженности
			|ПОМЕСТИТЬ _СделкиРЕПО_Развернуто
			|ИЗ
			|	_ЗадолженностьПоСделкамРЕПО КАК _ЗадолженностьПоСделкамРЕПО
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СделкиРЕПО_Развернуто.Приоритет КАК Приоритет,
			|	_СделкиРЕПО_Развернуто.Примечание КАК Примечание,
			|	_СделкиРЕПО_Развернуто.ВалютаСтроки КАК ВалютаСтроки,
			|	ВЫБОР
			|		КОГДА _СделкиРЕПО_Развернуто.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))
			|				И &ВыделятьКомиссиюПоСделкам = ЛОЖЬ
			|			ТОГДА """"
			|		ИНАЧЕ _СделкиРЕПО_Развернуто.СубъектАналитики
			|	КОНЕЦ КАК СубъектАналитики,
			|	СУММА(_СделкиРЕПО_Развернуто.СуммаРынок) КАК СуммаРынок,
			|	СУММА(_СделкиРЕПО_Развернуто.СуммаРынокВВалютеУчета) КАК СуммаРынокВВалютеУчета,
			|	_СделкиРЕПО_Развернуто.Контрагент КАК Контрагент,
			|	ВЫБОР
			|		КОГДА _СделкиРЕПО_Развернуто.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))
			|				И &ВыделятьКомиссиюПоСделкам = ЛОЖЬ
			|			ТОГДА """"
			|		ИНАЧЕ _СделкиРЕПО_Развернуто.Основание
			|	КОНЕЦ КАК Основание,
			|	_СделкиРЕПО_Развернуто.ВидАктива КАК ВидАктива,
			|	_СделкиРЕПО_Развернуто.ВидЗадолженности КАК ВидЗадолженности
			|ПОМЕСТИТЬ _СделкиРЕПО
			|ИЗ
			|	_СделкиРЕПО_Развернуто КАК _СделкиРЕПО_Развернуто
			|
			|СГРУППИРОВАТЬ ПО
			|	_СделкиРЕПО_Развернуто.Приоритет,
			|	_СделкиРЕПО_Развернуто.Примечание,
			|	_СделкиРЕПО_Развернуто.ВалютаСтроки,
			|	ВЫБОР
			|		КОГДА _СделкиРЕПО_Развернуто.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))
			|				И &ВыделятьКомиссиюПоСделкам = ЛОЖЬ
			|			ТОГДА """"
			|		ИНАЧЕ _СделкиРЕПО_Развернуто.СубъектАналитики
			|	КОНЕЦ,
			|	_СделкиРЕПО_Развернуто.Контрагент,
			|	ВЫБОР
			|		КОГДА _СделкиРЕПО_Развернуто.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))
			|				И &ВыделятьКомиссиюПоСделкам = ЛОЖЬ
			|			ТОГДА """"
			|		ИНАЧЕ _СделкиРЕПО_Развернуто.Основание
			|	КОНЕЦ,
			|	_СделкиРЕПО_Развернуто.ВидАктива,
			|	_СделкиРЕПО_Развернуто.ВидЗадолженности";
					
		#КонецОбласти
																	
		Запрос.УстановитьПараметр("ЗадолженностьПоСделкамРЕПО",								ЗадолженностьПоСделкамРЕПО); 
		Запрос.УстановитьПараметр("ВыделятьКомиссиюПоСделкам",  							НастройкиСделокРЕПО.ПараметрыУчетаКомиссий.ВыделятьКомиссиюПоСделкам);
		Запрос.УстановитьПараметр("ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки",			НастройкиСделокРЕПО.ПараметрыУчетаКомиссий.ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки);	
		Запрос.УстановитьПараметр("РаздельныйРасчетРублевыхСуммОсновногоДолгаИПроцентов",	НастройкиСделокРЕПО.РаздельныйРасчетРублевыхСуммОсновногоДолгаИПроцентов); 
				
		// Обобщающий параметр, чтобы все исходные параметры были использованы
		НеУчитыватьКомиссиюВСоставеСделки = (НастройкиСделокРЕПО.ПараметрыУчетаКомиссий.НеУчитыватьКомиссиюВДебиторке
										Или НастройкиСделокРЕПО.ПараметрыУчетаКомиссий.ВыделятьКомиссиюПоСделкам
										Или НастройкиСделокРЕПО.ПараметрыУчетаКомиссий.ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки)
										И Не НастройкиСделокРЕПО.ПараметрыУчетаКомиссий.КомиссияПропорциональноДнямВСоставеСделки; 
										
		Запрос.УстановитьПараметр("НеУчитыватьКомиссиюВСоставеСделки", НеУчитыватьКомиссиюВСоставеСделки);
		
		Запрос.Выполнить();
		
		#КонецОбласти		
		
	КонецЕсли;	
	
	УдалитьЛишниеВТ(МенеджерВременныхТаблиц, МассивИсходныхВТ);
	
КонецПроцедуры

// Возвращает значения параметров по учету комиссий по сделкам РЕПО в соответсвии с методикой расчета СЧА
// 
Функция ПараметрыУчетаКомиссийПоСделкамРЕПО(Организация, СчетДоверительногоУправления, ВариантРасчетаОценочнойСтоимости, Период, НастройкиФормированияСЧА = Неопределено) Экспорт
	
	Отказ = Ложь;
	Если НастройкиФормированияСЧА = Неопределено Тогда
		НастройкиФормированияСЧА = РегистрыСведений.НастройкиФормированияСЧА.ОпределитьНастройки(Период, Организация, СчетДоверительногоУправления, Отказ);	
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Описание параметров учета комиссий
	//
	// 1. НеУчитыватьКомиссиюВДебиторке: Комиссия не включается в состав дебиторки,
	// т.е. не считается предварительными затратами до исполнения сделки, а сразу включается в состав расходов
	//
	// 2. ВыделятьКомиссиюПоСделкам: Учет доходов и расходов (затраты по уплате комиссии брокера и биржи) осуществляется по методу "начисления",
	//	  т. е. суммы комиссий учитываются в дебиторке пропорционально дням до исполнения сделки, в разрезе сделок и видов задолженности
	// 
	// 3. ОкруглятьКомиссиюРассчитаннуюПропорциональноДнямОтДатыСделкиДоДвухЗнаков: Дополнительный параметр для случая ВыделятьКомиссиюПоСделкам = Истина
	//    (начисленная комиссия округляется до двух знаков перед ее вычитанием из остатков).
	//			
	// 4. ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки: Комиссия отражается в дебиторке в полной сумме до исполнения сделки (отдельная сумма по брокерской комиссии по всем сделкам, отдельная - по торговой)			
	//			
	// 5. КомиссияПропорциональноДнямВСоставеСделки: Суммы комиссий учитываются в дебиторке пропорционально дням до исполнения сделки вместе с суммой сделки
	//		
	// 6. ИспользоватьНачисленнуюКомиссию: Определяет, получать ли суммы комиссий для включения в дебиторку по начислению или по оплате	
	
	// Некоторые договоры доверительного управления нужно оценивать по учетной политике ЕПС
	ИспользоватьНастройкиУчетнойПолитикиЕПС = НастройкиФормированияСЧА.ИспользоватьНастройкиУчетнойПолитикиЕПС;
	
	Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период);
	
	// Отдельно определяем настройки для счетов ДУ, которые оцениваются по УП	
	Если ИспользоватьНастройкиУчетнойПолитикиЕПС Тогда
		
		// Получаем настройки учета ЕПС
		НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(Период, Организация, СчетДоверительногоУправления, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, Отказ);
		
		Если Отказ Тогда
			Возврат Неопределено;
		КонецЕсли;
	
		НеУчитыватьКомиссиюВДебиторке 												= НастройкиПоВидуУчета.МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриОткрытииРЕПО;
		ВыделятьКомиссиюПоСделкам													= Не НеУчитыватьКомиссиюВДебиторке;
		
		// Следующих двух параметров в ЕПС не бывает
		ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки 								= Ложь;		
		КомиссияПропорциональноДнямВСоставеСделки 									= Ложь;
		
		ОкруглятьКомиссиюРассчитаннуюПропорциональноДнямОтДатыСделкиДоДвухЗнаков	= ВыделятьКомиссиюПоСделкам И Не НастройкиПоВидуУчета.УчитыватьПогрешностьСложенияБрокерскойИТорговойКомиссийПоРЕПО;
		ИспользоватьНачисленнуюКомиссию 											= Не НеУчитыватьКомиссиюВДебиторке И НастройкиПоВидуУчета.МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриНачислении;
				
	Иначе
		
		// Комиссия не включается в состав дебиторки,
		// т.е. не считается предварительными затратами до исполнения сделки, а сразу включается в состав расходов
		
		НеУчитыватьКомиссиюВДебиторке =
			ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ОПК2018
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Согласие2019
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_Нефтегарант2018 И Период < '20200214'
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ПФР2018
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ПФР2019_УКПИ
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПФР2020
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ППА2018 И Период < '20200101'
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФк_ФДЦБ
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФк_ФДЦБ2021
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2018
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2021
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ_УКПИ
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2018
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2020
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2021
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее201218
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Перспектива2018
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Стройкомплекс2018
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Аквилон
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2019
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Газфонд И Период >= '20210101'
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Югория
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Югория2022
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РПИ2023
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Гефест;		

		// Суммы комиссий учитываются в дебиторке пропорционально дням до исполнения сделки, в разрезе сделок и видов задолженности
		
		ВыделятьКомиссиюПоСделкам = Не НеУчитыватьКомиссиюВДебиторке 
			И (ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_Нефтегарант2018 И Период >= '20200214'
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Эволюция2021
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Эволюция2021_2
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Федерация
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Федерация2021
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Перспектива2020 И Период >= '20210731'
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Сургутнефтегаз2020 И Период >= '20210731'
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020
					И (Период >= '20220523'
						ИЛИ Период >= '20220516' И Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФВолгаКапитал")
						ИЛИ Период >= '20210824' И Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФОПФ"))
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ППА2018 И Период >= '20230915');	
				
		// Учет доходов и расходов (затраты по уплате комиссии брокера и биржи) осуществляется по методу «начисления».
		// Решили, что это значит нужно округлять начисленную комиссию перед ее вычитанием из остатков.
				
		ОкруглятьКомиссиюРассчитаннуюПропорциональноДнямОтДатыСделкиДоДвухЗнаков = ВыделятьКомиссиюПоСделкам
			И (ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Эволюция2021_2
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Перспектива2020
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Сургутнефтегаз2020
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ППА2018 И Период >= '20230915')
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ХантыМансийский2020;		
			
		// Комиссия отражается в дебиторке в полной сумме до исполнения сделки (отдельная сумма по брокерской комиссии по всем сделкам, отдельная - по торговой)			
		
		ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки = Не НеУчитыватьКомиссиюВДебиторке И Не ВыделятьКомиссиюПоСделкам
			И (ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020_2 И Период < '20250831'
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Аквилон2021
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Стройкомплекс2021
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2020
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Большой
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Ростех);			
					
		// Суммы комиссий учитываются в дебиторке пропорционально дням до исполнения сделки вместе с суммой сделки
		
		КомиссияПропорциональноДнямВСоставеСделки = Не НеУчитыватьКомиссиюВДебиторке И Не ВыделятьКомиссиюПоСделкам И Не ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки;
		
		// Определяет, получать ли суммы комиссий для включения в дебиторку по начислению или по оплате
		
		ИспользоватьНачисленнуюКомиссию = Не НеУчитыватьКомиссиюВДебиторке 
			И (ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Газфонд И Период < '20210101'
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Перспектива2020
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Доверие
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020 И Период >= '20260520');	
				
	КонецЕсли;
			
	// Компонуем параметры в структуру			
	
	ПараметрыУчетаКомиссий = Новый Структура;
	ПараметрыУчетаКомиссий.Вставить("НеУчитыватьКомиссиюВДебиторке",											НеУчитыватьКомиссиюВДебиторке);	
	ПараметрыУчетаКомиссий.Вставить("ВыделятьКомиссиюПоСделкам",												ВыделятьКомиссиюПоСделкам);
	ПараметрыУчетаКомиссий.Вставить("ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки",							ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки);
	ПараметрыУчетаКомиссий.Вставить("КомиссияПропорциональноДнямВСоставеСделки",								КомиссияПропорциональноДнямВСоставеСделки); 
	ПараметрыУчетаКомиссий.Вставить("ОкруглятьКомиссиюРассчитаннуюПропорциональноДнямОтДатыСделкиДоДвухЗнаков",	ОкруглятьКомиссиюРассчитаннуюПропорциональноДнямОтДатыСделкиДоДвухЗнаков);
	ПараметрыУчетаКомиссий.Вставить("ИспользоватьНачисленнуюКомиссию",											ИспользоватьНачисленнуюКомиссию);
	
	Возврат ПараметрыУчетаКомиссий;
	
КонецФункции

Функция ПараметрыРасчетаЗадолженностиПоСделкамРЕПО(Организация, СчетДоверительногоУправления, ВариантРасчетаОценочнойСтоимости, Период, НастройкиФормированияСЧА = Неопределено) Экспорт
	
	НастройкиСделокРЕПО = Новый Структура("ВариантРасчетаЗадолженности");
	
	Если ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ 
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФондФилософии
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РПИ 
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ЛонгТермИнвестментс
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФОГФ
	Тогда
	
		НастройкиСделокРЕПО.ВариантРасчетаЗадолженности = "РазницаСуммыСделкиИСправедливойСтоимостиБумаг";
		
		#Область Дополнительные_параметры_расчета
		
		НастройкиСделокРЕПО.Вставить("УчитыватьЗадолженностьПоЦБКупленнойПоРЕПО",
			Не (ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ И НачалоДня(Период) >= '20200811'
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФОГФ));
		
		Если ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ И НачалоДня(Период) >= '20200811' Тогда
			
			СтараяМетодикаРЭМ =
				СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Солидарность") И НачалоДня(Период) < '20200913'
				ИЛИ СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_СМиАУ") И НачалоДня(Период) < '20200913'
				ИЛИ СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ПАУ_ЦФО") И НачалоДня(Период) < '20200913'
				ИЛИ СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Росинфокоминвест");
				
			Если СтараяМетодикаРЭМ Тогда
				НастройкиСделокРЕПО.УчитыватьЗадолженностьПоЦБКупленнойПоРЕПО = Истина;		
			КонецЕсли;
				
		КонецЕсли;
		
		#КонецОбласти
		
	Иначе
		
		// Справедливая стоимость (СС) задолженности по сделкам РЕПО:
		//    СС = ОД + Процент
		// где:		
		//    ОД      - основной долг, сумма сделки в валюте сделки
		//    Процент - процентный доход за процентный период
		
		НастройкиСделокРЕПО.ВариантРасчетаЗадолженности = "ОсновнойДолгПлюсПроцент";
		
		#Область Дополнительные_параметры_расчета
		
		ПараметрыУчетаКомиссий = ПараметрыУчетаКомиссийПоСделкамРЕПО(Организация, СчетДоверительногоУправления, ВариантРасчетаОценочнойСтоимости, Период, НастройкиФормированияСЧА);
		
		Если ПараметрыУчетаКомиссий = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		НастройкиСделокРЕПО.Вставить("ПараметрыУчетаКомиссий", ПараметрыУчетаКомиссий);
		
		// Для сделок РЕПО в валюте появилась вариативность расчета рублевой суммы задолженности: либо сначала получаем оценку задолженности в валюте, затем умножаем на курс,
		// либо сначала отдельно получаем рублевые суммы первой части РЕПО и процентов, округляем их, затем складываем
		
		НастройкиСделокРЕПО.Вставить("РаздельныйРасчетРублевыхСуммОсновногоДолгаИПроцентов", 
					ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020 И Период >= '20240519');
		
		#КонецОбласти
		
		//настройка актуальна только для ПИФов для таксономии 5.2. отчетности ЦБ
		РеквизитыСчетаДУ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетДоверительногоУправления, "Организация, ВидДоговораДоверительногоУправления");
		Если РеквизитыСчетаДУ.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
			НастройкиСделокРЕПО.Вставить("ОтражатьРЕПОВРазделе", РегистрыСведений.СоставИНастройкиОтчетов.ПолучитьЗначениеНастройкиОтчета("_ОтчетностьЦБ", "ОтражатьРЕПОВРазделе", РеквизитыСчетаДУ.Организация, Период));
		Иначе
			НастройкиСделокРЕПО.Вставить("ОтражатьРЕПОВРазделе", "");
		КонецЕсли;

	КонецЕсли;
	
	Возврат НастройкиСделокРЕПО;
	
КонецФункции

#КонецОбласти

#Область Оценка_задолженностей_по_расчетам_по_фьючерсным_контрактам

Процедура ПолучитьЗадолженностиПоРасчетамПоФьючерснымКонтрактам(ВариантРасчетаОценочнойСтоимости, Организация, СчетДоверительногоУправления, Период, ТаблицаСтоимостей, Отказ, МенеджерВременныхТаблиц, ПараметрыОценки = Неопределено) Экспорт

	МассивИсходныхВТ = СистемныеФункции.ПолучитьИменаВременныхТаблицЗапроса(МенеджерВременныхТаблиц);
	МассивИсходныхВТ.Добавить("_ЗадолженностиПоРасчетамПоФьючерснымКонтрактам");

	ЕстьОшибки = Ложь;
	
	// Варианты	
	
	ВариантРасчетаЗадолженности = Неопределено;
	
	Если ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом И Период >= '20210617' Тогда
		
		// Оценка взаиморасчетов по фьючерсным договорам (контрактам) признается равной
		// разнице между справедливой стоимостью производного финансового инструмента и ценой клиринга
		
		ВариантРасчетаЗадолженности = "РазницаМеждуСправедливойСтоимостьюИЦенойКлиринга";
		
	Иначе 
		
		// Задолженность по расчетам по производным финансовым инструментам не рассчитывается в СЧА
		
		ВариантРасчетаЗадолженности = "НеРассчитывать";
		
	КонецЕсли;
	
	// Расчет
	
	Если ВариантРасчетаЗадолженности <> "НеРассчитывать" Тогда	
	
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
		Запрос.УстановитьПараметр("Период",							Новый Граница(КонецДня(Период), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("Организация",					Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
		
		ПоместитьОстаткиЦенныхБумагВМенеджерВременныхТаблиц(Запрос, "_ОстаткиЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Фьючерсы)"); 
		
		Если СистемныеФункции.КоличествоЗаписейВременнойТаблицы(Запрос, "_ОстаткиЦенныхБумагОстатки") > 0 Тогда
		
			Если ВариантРасчетаЗадолженности = "РазницаМеждуСправедливойСтоимостьюИЦенойКлиринга" Тогда	
				
				#Область Разница_между_справедливой_стоимостью_и_ценой_клиринга		
				
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_ОстаткиЦенныхБумагОстатки.Рынок КАК Рынок,
					|	_ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
					|	_ОстаткиЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
					|	ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.ПустаяСсылка) КАК ТипЗадолженности
					|ИЗ
					|	_ОстаткиЦенныхБумагОстатки КАК _ОстаткиЦенныхБумагОстатки";			
				
				ЦенныеБумаги = Запрос.Выполнить().Выгрузить();
				
				ТаблицаРегистрацииСтоимостиПереоценки = ПолучитьСтоимостиЦенныхБумаг(
					ВариантРасчетаОценочнойСтоимости, Организация, СчетДоверительногоУправления, Период, ЕстьОшибки,
					Неопределено, Неопределено, ?(ТаблицаСтоимостей = Неопределено, Неопределено, ТаблицаСтоимостей), , , ЦенныеБумаги, , ПараметрыОценки);
				
				Если Не ЕстьОшибки И ТаблицаРегистрацииСтоимостиПереоценки <> Неопределено Тогда
					
					ИспользоватьПоследнююЦенуКлиринга = ТипЗнч(ПараметрыОценки) = Тип("Структура") И ПараметрыОценки.Свойство("ПлановаяОценка") И ПараметрыОценки.ПлановаяОценка = Истина;
					
					Запрос.УстановитьПараметр("ТаблицаРегистрацииСтоимостиПереоценки", 	ТаблицаРегистрацииСтоимостиПереоценки);
					Запрос.УстановитьПараметр("НачалоПериода", 							НачалоДня(Период));
					Запрос.УстановитьПараметр("ММВБ", 									ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
					Запрос.УстановитьПараметр("Режим_ФОРТС", 							ОбщегоНазначения.ПолучитьИменованныйОбъект("РежимТоргов_ФОРТС"));
					Запрос.УстановитьПараметр("ВалютаУчета", 							ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета"));
					Запрос.УстановитьПараметр("ИспользоватьПоследнююЦенуКлиринга", 		ИспользоватьПоследнююЦенуКлиринга);
					
					РаботаСПереоценкой.ПоместитьСведенияОТоргахЦеннымиБумагамиВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц, "_ОстаткиЦенныхБумагОстатки", Период, 1); 
					ПоместитьСправедливыеСтоимостиВМенеджерВременныхТаблиц(Запрос, ВариантРасчетаОценочнойСтоимости);
					ПоместитьКурсыВалютВМенеджерВременныхТаблиц(Запрос, Период);
					
					Запрос.Текст = 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	_ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
						|	_ОстаткиЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
						|	&ВалютаУчета КАК Валюта,
						|	_СправедливаяСтоимостьЦенныхБумаг.СправедливаяЦенаВВалютеУчета КАК СправедливаяЦена,
						|	ЕСТЬNULL(КотировкиММВБ.SETTLEPRICE, ПоследниеЦеныКлиринга.SETTLEPRICE) * _КурсВалютыЦенКлиринга.Курс / _КурсВалютыУчета.Курс КАК ЦенаКлиринга,
						|	ЕСТЬNULL(КотировкиММВБ.Период, ПоследниеЦеныКлиринга.SETTLEPRICE_DATE) КАК ДатаЦеныКлиринга,
						|	_ОстаткиЦенныхБумагОстатки.КоличествоОстаток * (_СправедливаяСтоимостьЦенныхБумаг.СправедливаяЦенаВВалютеУчета - ЕСТЬNULL(КотировкиММВБ.SETTLEPRICE, ПоследниеЦеныКлиринга.SETTLEPRICE) * _КурсВалютыЦенКлиринга.Курс / _КурсВалютыУчета.Курс) КАК Сумма
						|ПОМЕСТИТЬ _ИтоговаяТаблица
						|ИЗ
						|	_ОстаткиЦенныхБумагОстатки КАК _ОстаткиЦенныхБумагОстатки
						|		ЛЕВОЕ СОЕДИНЕНИЕ _СправедливаяСтоимостьЦенныхБумаг КАК _СправедливаяСтоимостьЦенныхБумаг
						|		ПО (_СправедливаяСтоимостьЦенныхБумаг.ЦеннаяБумага = _ОстаткиЦенныхБумагОстатки.ЦеннаяБумага)
						|		ЛЕВОЕ СОЕДИНЕНИЕ _СведенияОТоргахЦеннымиБумагами КАК _СведенияОТоргахЦеннымиБумагами
						|		ПО (_СведенияОТоргахЦеннымиБумагами.ЦеннаяБумага = _ОстаткиЦенныхБумагОстатки.ЦеннаяБумага)
						|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиММВБ
						|		ПО (КотировкиММВБ.ЦеннаяБумага = _ОстаткиЦенныхБумагОстатки.ЦеннаяБумага)
						|			И (КотировкиММВБ.Рынок = _ОстаткиЦенныхБумагОстатки.Рынок)
						|			И (КотировкиММВБ.Биржа = &ММВБ)
						|			И (КотировкиММВБ.РежимТоргов = &Режим_ФОРТС)
						|			И (КотировкиММВБ.Период = _СведенияОТоргахЦеннымиБумагами.Дата)
						|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
						|				&Период,
						|				&ИспользоватьПоследнююЦенуКлиринга
						|					И (ЦеннаяБумага, Рынок, Биржа, РежимТоргов) В
						|						(ВЫБРАТЬ
						|							_ОстаткиЦенныхБумагОстатки.ЦеннаяБумага,
						|							_ОстаткиЦенныхБумагОстатки.Рынок,
						|							&ММВБ,
						|							&Режим_ФОРТС
						|						ИЗ
						|							_ОстаткиЦенныхБумагОстатки)) КАК ПоследниеЦеныКлиринга
						|		ПО (ПоследниеЦеныКлиринга.ЦеннаяБумага = _ОстаткиЦенныхБумагОстатки.ЦеннаяБумага)
						|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсВалютыЦенКлиринга
						|		ПО (_КурсВалютыЦенКлиринга.Валюта = ЕСТЬNULL(КотировкиММВБ.Валюта, ПоследниеЦеныКлиринга.Валюта))
						|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсВалютыУчета
						|		ПО (_КурсВалютыУчета.Валюта = &ВалютаУчета)
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	ВЫБОР
						|		КОГДА _ИтоговаяТаблица.Сумма > 0
						|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
						|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
						|	КОНЕЦ КАК ВидАктива,
						|	_ИтоговаяТаблица.ЦеннаяБумага КАК СубъектАналитики,
						|	НЕОПРЕДЕЛЕНО КАК Основание,
						|	_ИтоговаяТаблица.Сумма КАК СуммаРынок,
						|	_ИтоговаяТаблица.Валюта КАК ВалютаСтроки,
						|	_ИтоговаяТаблица.Сумма КАК СуммаРынокВВалютеУчета,
						|	НЕОПРЕДЕЛЕНО КАК ВидЗадолженности,
						|	НЕОПРЕДЕЛЕНО КАК Контрагент,
						|	ВЫБОР
						|		КОГДА _ИтоговаяТаблица.Сумма > 0
						|			ТОГДА ""ДЗ: ""
						|		ИНАЧЕ ""КЗ: ""
						|	КОНЕЦ + ""отклонение справедливой стоимости ПФИ от цены клиринга"" КАК Примечание
						|ПОМЕСТИТЬ _ЗадолженностиПоРасчетамПоФьючерснымКонтрактам
						|ИЗ
						|	_ИтоговаяТаблица КАК _ИтоговаяТаблица";
					
					Запрос.Выполнить();		
					
					#Область Проверка_наличия_цен
					
					ПроцеркаЦен = МенеджерВременныхТаблиц.Таблицы["_ИтоговаяТаблица"].ПолучитьДанные().Выбрать();
					
					Пока ПроцеркаЦен.Следующий() Цикл   			
						
						ТекстОшибки = "";
						
						Если Не ЗначениеЗаполнено(ПроцеркаЦен.СправедливаяЦена) Тогда
							ТекстОшибки = СтрШаблон("не удалось определить справедливую стоимость для '%1'", ПроцеркаЦен.ЦеннаяБумага);
						ИначеЕсли Не ЗначениеЗаполнено(ПроцеркаЦен.ЦенаКлиринга) Тогда
							ТекстОшибки = СтрШаблон("не удалось определить расчетную цену клиринга для '%1'", ПроцеркаЦен.ЦеннаяБумага);
						КонецЕсли;	
							
						Если ЗначениеЗаполнено(ТекстОшибки) Тогда	
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При оценке активов/обязательств по расчетам по производным финансовым инструментам " + ТекстОшибки, , , , Отказ);
						КонецЕсли;
						
					КонецЦикла;
					
					#КонецОбласти
					
				КонецЕсли;	
					
				#КонецОбласти
					
			Иначе
				
				#Область Нереализованный_вариант_оценки_задолженности
					
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обнаружены остатки фьючерсов. Оценка задолженности по расчетам по производным финансовым инструментам не реализована!", , , , Отказ);
					
				#КонецОбласти
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Отказ = ?(ЕстьОшибки, ЕстьОшибки, Отказ);
	
	// Если задолженности не рассчитаны, заполняем пустой таблицей
	
	Если МенеджерВременныхТаблиц.Таблицы.Найти("_ЗадолженностиПоРасчетамПоФьючерснымКонтрактам") = Неопределено Тогда
		СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ПолучитьПустуюТаблицуСделок(), "_ЗадолженностиПоРасчетамПоФьючерснымКонтрактам", МенеджерВременныхТаблиц);
	КонецЕсли;
	
	УдалитьЛишниеВТ(МенеджерВременныхТаблиц, МассивИсходныхВТ);
	
КонецПроцедуры
	
#КонецОбласти

#Область Сделки_СПФИ

Процедура ПоместитьСделкиСПФИВМенеджерВременныхТаблиц(Организация, СчетДоверительногоУправления, Период, МенеджерВременныхТаблиц, Отказ) Экспорт

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;	
	Запрос.УстановитьПараметр("Период",					КонецДня(Период));
	Запрос.УстановитьПараметр("Организация", 					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВалютаРубли",					ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ПрочиеАктивы) КАК ВидАктива,
		|	СделкаСПФИ.Ссылка КАК СубъектАналитики,
		|	СделкаСПФИ.Контрагент КАК Контрагент,
		|	&ВалютаРубли КАК ВалютаСтроки
		|ПОМЕСТИТЬ _СделкиСПФИ
		|ИЗ
		|	Документ.СделкаСПФИ КАК СделкаСПФИ
		|ГДЕ
		|	СделкаСПФИ.Организация = &Организация
		|	И СделкаСПФИ.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СделкаСПФИ.Проведен
		|	И СделкаСПФИ.ДатаИсполнения > &Период
		|	И СделкаСПФИ.Дата <= &Период";
	
	Запрос.Выполнить();
	
КонецПроцедуры	
	
#КонецОбласти

#Область Служебные_процедуры_и_функции

Функция ИспользованаМетодикаРасчетаПоНовойСхеме(ЦельРасчета, ВариантРасчетаСправедливойСтоимости) Экспорт
	
	Возврат
		(ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ
			Или ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФондФилософии
			Или ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.СправедливаяПИФ
			Или ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2018
			Или ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2020
			Или ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2021
			Или ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2018
			Или ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2021
			Или ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ_УКПИ
			Или ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ПФР2018
			Или ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ПФР2019_УКПИ
			Или ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПФР2020
			Или ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Традиция2019
			Или ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.СредневзвешеннаяЕПС
			Или ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.СредневзвешеннаяЕПС_УКПИ
			Или ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФОГФ
			Или ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РПИ2023
		)
		И ЦельРасчета.ТолькоДляФиксацииСтоимостиОценки;
	
КонецФункции

Функция ПолучитьПустуюТаблицуСделок()
	
	РеквизитыДокумента = Метаданные.Документы.РегистрацияСтоимостиАктивов.ТабличныеЧасти.АктивыНеОтносящиесяКЦеннымБумагам.Реквизиты;
		
	ТаблицаСделок = Новый ТаблицаЗначений;
	ТаблицаСделок.Колонки.Добавить("Приоритет", 				Новый ОписаниеТипов("Число"));
	ТаблицаСделок.Колонки.Добавить("Примечание", 				РеквизитыДокумента.Примечание.Тип);
	ТаблицаСделок.Колонки.Добавить("ВалютаСтроки", 				РеквизитыДокумента.ВалютаСтроки.Тип);
	ТаблицаСделок.Колонки.Добавить("СубъектАналитики", 			РеквизитыДокумента.СубъектАналитики.Тип);
	ТаблицаСделок.Колонки.Добавить("СуммаРынокВВалютеУчета", 	РеквизитыДокумента.СуммаРынокВВалютеУчета.Тип);
	ТаблицаСделок.Колонки.Добавить("СуммаРынок", 				РеквизитыДокумента.СуммаРынок.Тип);
	ТаблицаСделок.Колонки.Добавить("Контрагент", 				РеквизитыДокумента.Контрагент.Тип);
	ТаблицаСделок.Колонки.Добавить("Основание", 				РеквизитыДокумента.Основание.Тип);
	ТаблицаСделок.Колонки.Добавить("ВидАктива", 				РеквизитыДокумента.ВидАктива.Тип);
	ТаблицаСделок.Колонки.Добавить("ВидЗадолженности", 			РеквизитыДокумента.ВидЗадолженности.Тип);
	ТаблицаСделок.Колонки.Добавить("УровеньОценкиЦБ", 			РеквизитыДокумента.УровеньОценки.Тип);
	
	Возврат ТаблицаСделок;

КонецФункции

Процедура УдалитьЛишниеВТ(МенеджерВременныхТаблиц, МассивИсходныхТаблиц)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	МассивИсходныхТаблиц.Добавить("_КурсыВалют");
	
	Для каждого Таблица Из Запрос.МенеджерВременныхТаблиц.Таблицы Цикл
		Если Не СтрЗаканчиваетсяНа(Таблица.ПолноеИмя, "БезОтборов") Тогда
			
			Если МассивИсходныхТаблиц.Найти(Таблица.ПолноеИмя) = Неопределено Тогда
				Запрос.Текст = Запрос.Текст + 
					"УНИЧТОЖИТЬ " + Таблица.ПолноеИмя + "
					|;
					|";
			КонецЕсли; 			
			
		КонецЕсли; 
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Запрос.Текст) Тогда
		Запрос.Выполнить();
	КонецЕсли; 	

КонецПроцедуры

Процедура СообщитьОНеизвестномВариантеРасчетаПроцентовПоСделкамРЕПО(СчетДоверительногоУправления, ВариантРасчетаПроцентовПоСделкамРЕПО, Отказ = Ложь) Экспорт
	
	Если ЗначениеЗаполнено(ВариантРасчетаПроцентовПоСделкамРЕПО) Тогда
		ТекстОшибки = СтрШаблон("Вариант расчета процентов по сделкам РЕПО '%1' для '%2' не реализован!",
			ВариантРасчетаПроцентовПоСделкамРЕПО, СчетДоверительногоУправления);
	Иначе			
		ТекстОшибки = СтрШаблон("В настройках формирования СЧА для '%1' не заполнен вариант расчета процентов по сделкам РЕПО!", СчетДоверительногоУправления); 
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , , , Отказ);

КонецПроцедуры

// Возвращает параметры получения остатков ценных бумаг
//
// Параметры:
//  ВариантРасчетаОценочнойСтоимости - СправочникСсылка.ВариантыРасчетаОценочнойСтоимости - методика, для которой необходимо вернуть параметры получения остатков
// 
// Возвращаемое значение:
// 	Структура - Доступные ключи и их значения:
//		ОстаткиЦенныхБумаг					- Булево - Если Истина, будут получены остатки по регистру накопления ОстаткиЦенныхБумаг
//		ТипыЗадолженностейПоЦеннымБумагам	- Массив - Массив элементов ПеречислениеСсылка.ТипыЗадолженности. Если массив пустой, задолженности по сделкам Т+ не анализируются
//		ЗадолженностиПоВторойЧастиРЕПО		- Булево - Пока получение задолженностей по второй части РЕПО не реализовано
//		НеУчитыватьЦБКупленныеПоРЕПО		- Булево - По умолчанию такие ЦБ есть в ОстаткиЦенныхБумаг. Если параметр Истина, их нужно вычитать из остатков ЦБ  
//		УчитыватьЦБПроданныеВРЕПО 			- Булево - По умолчанию такие ЦБ отсутствуют в ОстаткиЦенныхБумаг. Если параметр Истина, их нужно прибавлять к остаткам ЦБ
//
Функция ПолучитьПараметрыПолученияОстатковЦенныхБумаг(ВариантРасчетаОценочнойСтоимости, Период) Экспорт

	// Внимание! Насколько я смог проанализировать, функция используется только для методик расчета по "новой схеме".
	// Поэтому нечего здесь заполнять параметры для других методик.
	
	Если ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФондФилософии
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.СправедливаяПИФ
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФОГФ
	Тогда
	
		НеУчитыватьЦБКупленныеПоРЕПО =
			ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ И Период >= '20200811'
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФОГФ;
	
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ОстаткиЦенныхБумаг",					Истина);
		СтруктураПараметров.Вставить("ТипыЗадолженностейПоЦеннымБумагам",	Новый Массив);
		СтруктураПараметров.Вставить("ЗадолженностиПоВторойЧастиРЕПО",		Ложь);
		СтруктураПараметров.Вставить("НеУчитыватьЦБКупленныеПоРЕПО",		НеУчитыватьЦБКупленныеПоРЕПО);
		СтруктураПараметров.Вставить("УчитыватьЦБПроданныеВРЕПО",			Истина);
		
	ИначеЕсли ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2018
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2021 
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ_УКПИ 
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2018 
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2020
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2021
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ПФР2018 
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ПФР2019_УКПИ
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПФР2020
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Традиция2019
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.СредневзвешеннаяЕПС 
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.СредневзвешеннаяЕПС_УКПИ
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РПИ2023
	Тогда

		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ОстаткиЦенныхБумаг",					Истина);
		СтруктураПараметров.Вставить("ТипыЗадолженностейПоЦеннымБумагам",	Новый Массив);
		СтруктураПараметров.Вставить("ЗадолженностиПоВторойЧастиРЕПО",		Ложь);
		СтруктураПараметров.Вставить("НеУчитыватьЦБКупленныеПоРЕПО",		Истина);
        СтруктураПараметров.Вставить("УчитыватьЦБПроданныеВРЕПО",			Истина);
		
	КонецЕсли; 
	
	Возврат СтруктураПараметров;

КонецФункции

Процедура ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(ВариантРасчетаОценочнойСтоимости, Организация, СчетДоверительногоУправления, Период, МенеджерВременныхТаблиц = Неопределено, ПараметрыПолученияОстатков = Неопределено, РасчетПартий = Неопределено, РасшифровкаРасчета = Неопределено) Экспорт
	
	// Определяем параметры получения остатков
	
	Если ПараметрыПолученияОстатков = Неопределено Тогда
	
		ПараметрыПолученияОстатков = ПолучитьПараметрыПолученияОстатковЦенныхБумаг(ВариантРасчетаОценочнойСтоимости, Период);
		
		Если ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ И НачалоДня(Период) >= '20200811' Тогда
			
			СтараяМетодикаРЭМ =
				СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Солидарность") И НачалоДня(Период) < '20200913'
				ИЛИ СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_СМиАУ") И НачалоДня(Период) < '20200913' 
				ИЛИ СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ПАУ_ЦФО") И НачалоДня(Период) < '20200913'
				ИЛИ СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Росинфокоминвест");
				
			Если СтараяМетодикаРЭМ Тогда
				ПараметрыПолученияОстатков.Вставить("НеУчитыватьЦБКупленныеПоРЕПО", Ложь); // #Техдолг		
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЕсли; 
	
	Если ПараметрыПолученияОстатков = Неопределено Тогда
		ВызватьИсключение "Для варианта расчета оценочной стоимости '" + ВариантРасчетаОценочнойСтоимости + "' не заданы параметры получения остатков";
	КонецЕсли; 

	// Пока задолженности по Т+ сделкам анализируются только в методике РасчетСЧА_ОПИФ2018 в части оценки дебиторской и кредиторской задолженностей.
	// Когда появятся методики, где Т+ будет попадать в оценку активов - запрос скорее всего нужно будет дорабатывать
	
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли; 
	
	МассивИсходныхВТ = СистемныеФункции.ПолучитьИменаВременныхТаблицЗапроса(МенеджерВременныхТаблиц);
	МассивИсходныхВТ.Добавить("_ЦенныеБумаги");

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Период",								Новый Граница(КонецДня(Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",						Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",		СчетДоверительногоУправления);
	
	Запрос.УстановитьПараметр("ОстаткиЦенныхБумаг", 				ПараметрыПолученияОстатков.ОстаткиЦенныхБумаг);
	Запрос.УстановитьПараметр("ЗадолженностиПоЦеннымБумагам", 		ПараметрыПолученияОстатков.ТипыЗадолженностейПоЦеннымБумагам.Количество() > 0);
	Запрос.УстановитьПараметр("ТипыЗадолженностейПоЦеннымБумагам",	ПараметрыПолученияОстатков.ТипыЗадолженностейПоЦеннымБумагам);
	Запрос.УстановитьПараметр("ЗадолженностиПоВторойЧастиРЕПО", 	ПараметрыПолученияОстатков.ЗадолженностиПоВторойЧастиРЕПО);
	Запрос.УстановитьПараметр("НеУчитыватьЦБКупленныеПоРЕПО", 		ПараметрыПолученияОстатков.НеУчитыватьЦБКупленныеПоРЕПО);
	Запрос.Установитьпараметр("УчитыватьЦБПроданныеВРЕПО",			ПараметрыПолученияОстатков.УчитыватьЦБПроданныеВРЕПО);
	
	// #Техдолг #ДолгАналитика: По-хорошему нужно вид задолженности фильтровать в зависимости от параметров. 
	// Задолженность по бумагам ПоВторойЧастиРЕПО всегда включаем, чтобы отфильтровать ненужное. Это внебиржевое РЕПО. Иначе фильтровать нечего
	
	ОтборОстатки		 = "";
	ОтборВтораяЧастьРЕПО = "";
	ОтборЗадолженности	 = 
		"(_ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|		ИЛИ _ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО))
		|	И _ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности В (&ТипыЗадолженностейПоЦеннымБумагам)
		|ИЛИ _ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)";
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		
		ОтборОстатки		 = ?(ПустаяСтрока(ОтборОстатки),		 "", "(" + ОтборОстатки			+ ") И ") + "_ОстаткиЦенныхБумагОстатки.ЦеннаяБумага = &ФильтрПоЦБ";
		ОтборВтораяЧастьРЕПО = ?(ПустаяСтрока(ОтборВтораяЧастьРЕПО), "", "(" + ОтборВтораяЧастьРЕПО + ") И ") + "_ЗадолженностиПоВторойЧастиРЕПООстатки.ЦеннаяБумага = &ФильтрПоЦБ";
		ОтборЗадолженности	 = ?(ПустаяСтрока(ОтборЗадолженности),	 "", "(" + ОтборЗадолженности	+ ") И ") + "_ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага = &ФильтрПоЦБ";
		
		Запрос.УстановитьПараметр("ФильтрПоЦБ", РасшифровкаРасчета.ЦеннаяБумага);
		
	КонецЕсли; 
	
	ПоместитьОстаткиЦенныхБумагВМенеджерВременныхТаблиц(Запрос, ОтборОстатки, РасчетПартий);
	ПоместитьЗадолженностиПоЦеннымБумагамВМенеджерВременныхТаблиц(Запрос, ОтборЗадолженности);
	ПоместитьЗадолженностиПоВторойЧастиРЕПОВМенеджерВременныхТаблиц(Запрос, ОтборВтораяЧастьРЕПО, РасчетПартий);
	
	Если РасчетПартий = Неопределено Тогда
		
		#Область Остатки_ценных_бумаг_дополненные_задолженностями_по_ценным_бумагам
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(_ОстаткиЦенныхБумагОстатки.Рынок, _КредиторскаяЗадолженностьПоВторойЧастиРЕПООстатки.Рынок) КАК Рынок,
			|	ЕСТЬNULL(_ОстаткиЦенныхБумагОстатки.ЦеннаяБумага, _КредиторскаяЗадолженностьПоВторойЧастиРЕПООстатки.ЦеннаяБумага) КАК ЦеннаяБумага,
			|	ЕСТЬNULL(_ОстаткиЦенныхБумагОстатки.КоличествоОстаток, 0) - ВЫБОР
			|		КОГДА &НеУчитыватьЦБКупленныеПоРЕПО
			|			ТОГДА ЕСТЬNULL(_ДебиторскаяЗадолженностьПоВторойЧастиРЕПООстатки.КоличествоОстаток, 0)
			|		ИНАЧЕ 0
			|	КОНЕЦ + ВЫБОР
			|		КОГДА ЕСТЬNULL(_КредиторскаяЗадолженностьПоВторойЧастиРЕПООстатки.КоличествоОстаток, 0) > 0
			|			ТОГДА ЕСТЬNULL(_КредиторскаяЗадолженностьПоВторойЧастиРЕПООстатки.КоличествоОстаток, 0) - ЕСТЬNULL(_ДебиторскаяЗадолженностьПоВторойЧастиРЕПООстатки.КоличествоОстаток, 0)
			|		ИНАЧЕ 0
			|	КОНЕЦ - ЕСТЬNULL(_ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток, 0) КАК Количество,
			|	НЕОПРЕДЕЛЕНО КАК ТипЗадолженности
			|ПОМЕСТИТЬ _Объединение
			|ИЗ
			|	_ОстаткиЦенныхБумагОстатки КАК _ОстаткиЦенныхБумагОстатки
			|		ПОЛНОЕ СОЕДИНЕНИЕ _ЗадолженностиПоВторойЧастиРЕПООстатки КАК _КредиторскаяЗадолженностьПоВторойЧастиРЕПООстатки
			|		ПО (&УчитыватьЦБПроданныеВРЕПО)
			|			И _ОстаткиЦенныхБумагОстатки.ЦеннаяБумага = _КредиторскаяЗадолженностьПоВторойЧастиРЕПООстатки.ЦеннаяБумага
			|			И (_КредиторскаяЗадолженностьПоВторойЧастиРЕПООстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская))
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗадолженностиПоВторойЧастиРЕПООстатки КАК _ДебиторскаяЗадолженностьПоВторойЧастиРЕПООстатки
			|		ПО (ЕСТЬNULL(_ОстаткиЦенныхБумагОстатки.ЦеннаяБумага, _КредиторскаяЗадолженностьПоВторойЧастиРЕПООстатки.ЦеннаяБумага) = _ДебиторскаяЗадолженностьПоВторойЧастиРЕПООстатки.ЦеннаяБумага)
			|			И (_ДебиторскаяЗадолженностьПоВторойЧастиРЕПООстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская))
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			_ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|			_ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности КАК ТипЗадолженности,
			|			_ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности КАК ВидЗадолженности,
			|			СУММА(_ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток) КАК КоличествоОстаток
			|		ИЗ
			|			_ЗадолженностиПоЦеннымБумагамОстатки КАК _ЗадолженностиПоЦеннымБумагамОстатки
			|		
			|		СГРУППИРОВАТЬ ПО
			|			_ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага,
			|			_ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности,
			|			_ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности) КАК _ЗадолженностиПоЦеннымБумагамОстатки
			|		ПО (&НеУчитыватьЦБКупленныеПоРЕПО)
			|			И _ОстаткиЦенныхБумагОстатки.ЦеннаяБумага = _ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага
			|			И (_ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО))
			|			И (_ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская))
			|ГДЕ
			|	&ОстаткиЦенныхБумаг
			|	И (ЕСТЬNULL(_ОстаткиЦенныхБумагОстатки.КоличествоОстаток, 0) - ВЫБОР
			|				КОГДА &НеУчитыватьЦБКупленныеПоРЕПО
			|					ТОГДА ЕСТЬNULL(_ДебиторскаяЗадолженностьПоВторойЧастиРЕПООстатки.КоличествоОстаток, 0)
			|				ИНАЧЕ 0
			|			КОНЕЦ + ВЫБОР
			|				КОГДА ЕСТЬNULL(_КредиторскаяЗадолженностьПоВторойЧастиРЕПООстатки.КоличествоОстаток, 0) > 0
			|					ТОГДА ЕСТЬNULL(_КредиторскаяЗадолженностьПоВторойЧастиРЕПООстатки.КоличествоОстаток, 0) - ЕСТЬNULL(_ДебиторскаяЗадолженностьПоВторойЧастиРЕПООстатки.КоличествоОстаток, 0)
			|				ИНАЧЕ 0
			|			КОНЕЦ - ЕСТЬNULL(_ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток, 0) > 0
			|			ИЛИ ВЫРАЗИТЬ(_ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Фьючерс))
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_ЗадолженностиПоЦеннымБумагамОстатки.Рынок,
			|	_ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага,
			|	_ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток,
			|	_ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности
			|ИЗ
			|	_ЗадолженностиПоЦеннымБумагамОстатки КАК _ЗадолженностиПоЦеннымБумагамОстатки
			|ГДЕ
			|	&ЗадолженностиПоЦеннымБумагам
			|	И _ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток > 0
			|	И _ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности <> ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_ЗадолженностиПоВторойЧастиРЕПООстатки.Рынок,
			|	_ЗадолженностиПоВторойЧастиРЕПООстатки.ЦеннаяБумага,
			|	_ЗадолженностиПоВторойЧастиРЕПООстатки.КоличествоОстаток,
			|	ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|ИЗ
			|	_ЗадолженностиПоВторойЧастиРЕПООстатки КАК _ЗадолженностиПоВторойЧастиРЕПООстатки
			|ГДЕ
			|	&ЗадолженностиПоВторойЧастиРЕПО
