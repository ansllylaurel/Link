		ТолькоСделкиНаПриобретениеЦенныхБумагОцениваемыхПоСС = ТолькоСделкиНаПриобретениеЦенныхБумаг
			И (ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Перспектива2020
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020 И Период >= '20230815');
			
		// По задаче #410287 отсекаем сделки на покупку ценных бумаг
		ТолькоСделкиНаРеализациюЦенныхБумаг = ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2020
			И РаботаСПереоценкой.ОпределитьНастройкиОценки(Период, Организация, СчетДоверительногоУправления, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении).ВыполнятьРасчетПоПисьмуЦБ0185316;
		
		// Для Достойного Будущего справедливую оценку для каждой сделки получаем отдельно (из валютной оценки этой сделки). Задача #383640	
		// Оценка производится путем умножения количества ценных бумаг в
		// сделке на справедливую цену в валюте номинала с последующим округлением до
		// количества разрядов дробной части валюты;
		// Рублевый эквивалент стоимости определяется путем умножения стоимости в валюте номинала на
		// официальный курс иностранной валюты на дату определения стоимости чистых активов, с последующим округлением
		// рублевой суммы до двух разрядов дробной части;	
		
		// Внимание!!! Этот параметр не работает для НПФУчитывающиеТПлюсКакРазницуСКупоном = Истина!!!
		
		РассчитыватьСправедливуюСтоимостьАктиваВРазрезеСделок = (Не НПФУчитывающиеТПлюсКакРазницуСКупоном)
			И (Период >= '20210712'
					И ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом
				Или Период >= '20210131'
					И (ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2021 
						Или ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2021
						Или ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ_УКПИ));
		
 	    ОкруглятьВалютнуюСтоимостьЦБ =
			РассчитыватьСправедливуюСтоимостьАктиваВРазрезеСделок
				И ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом
				И Период >= '20210712';

		#КонецОбласти	
			
	ИначеЕсли ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФондФилософии
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РПИ
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ЛонгТермИнвестментс	
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФОГФ	
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.СредневзвешеннаяЕПС И Период >= '20250528'
	Тогда
	
		ВариантРасчетаЗадолженности = "РазвернутаяДебиторскаяИКредиторскаяЗадолженность";
		
		#Область Дополнительные_параметры_расчета
		
		// В методике РЭМа сделки Т+ не учитываются, учитываются только внебиржевые сделки
		
		ТолькоВнебиржевыеСделки = Истина;			
		
		// Если оцениваем только внебиржевые сделки, а цена не определена,
		// берем за цену стоимость покупки (т.е. дебиторка и кредиторка по такой сделке одинаковы)
		
		ПриОтсутствииЦеныОцениватьЦенныеБумагиВнебиржевыхСделокПоСуммеСделки = (Период < '20210101');
		
		#КонецОбласти
		
	ИначеЕсли ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ОПК2018 И Период < '20190101'
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2018
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Стройкомплекс2018 И Период < '20180126'
	Тогда
	
	    // Не забудь поменять в РаботаСПереоценкой.ПолучитьПараметрыПолученияПартийПоМетодике,
		// иначе бумаги не попадут в регистрацию оценки
	
		ВариантРасчетаЗадолженности = "ЗадолженностьПриУчетеБумагВДеньТПлюс";
	
	КонецЕсли;									
		
	// Расчет
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Если ВариантРасчетаЗадолженности = "РазницаМеждуСправедливойСтоимостьюИСуммойСделки" Тогда

		#Область Задолженность_как_разница_между_справедливой_стоимостью_ЦБ_и_суммой_сделки		 
		
		ТипыЗадолженностейПоЦеннымБумагам = Новый Массив;
		ТипыЗадолженностейПоЦеннымБумагам.Добавить(Перечисления.ТипыЗадолженности.Дебиторская);
		ТипыЗадолженностейПоЦеннымБумагам.Добавить(Перечисления.ТипыЗадолженности.Кредиторская);
		
		ПараметрыПолученияОстатков = Новый Структура; 
		ПараметрыПолученияОстатков.Вставить("ОстаткиЦенныхБумаг",					Ложь);
		ПараметрыПолученияОстатков.Вставить("ТипыЗадолженностейПоЦеннымБумагам",	ТипыЗадолженностейПоЦеннымБумагам);
		ПараметрыПолученияОстатков.Вставить("ЗадолженностиПоВторойЧастиРЕПО",		Ложь);
		ПараметрыПолученияОстатков.Вставить("НеУчитыватьЦБКупленныеПоРЕПО",			Истина);
		ПараметрыПолученияОстатков.Вставить("УчитыватьЦБПроданныеВРЕПО",			Ложь);
		
		ТаблицаРегистрацииСтоимостиПереоценки = ПолучитьСтоимостиЦенныхБумаг(
			ВариантРасчетаОценочнойСтоимости, Организация, СчетДоверительногоУправления, Период, ЕстьОшибки,
			ПараметрыПолученияОстатков, Неопределено, ?(ТаблицаСтоимостей = Неопределено, Неопределено, ТаблицаСтоимостей), , , , МенеджерВременныхТаблиц, ПараметрыОценки);
		
		Если НЕ ЕстьОшибки И ТаблицаРегистрацииСтоимостиПереоценки <> Неопределено Тогда
			
			ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета");
						
			Запрос.УстановитьПараметр("ТаблицаРегистрацииСтоимостиПереоценки", 					ТаблицаРегистрацииСтоимостиПереоценки);
			Запрос.УстановитьПараметр("Период", 												Новый Граница(КонецДня(Период), ВидГраницы.Включая));
			Запрос.УстановитьПараметр("НачалоПериода", 											НачалоДня(Период));
			Запрос.УстановитьПараметр("КонецПериода", 											КонецДня(Период));
			Запрос.УстановитьПараметр("Организация", 											Организация);
			Запрос.УстановитьПараметр("ВалютаУчета", 											ВалютаУчета);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", 							СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("НеИспользоватьОжидаемыйНоминал", 						НеИспользоватьОжидаемыйНоминал);
			Запрос.УстановитьПараметр("УчитыватьКупон",											НПФУчитывающиеТПлюсКакРазницуСКупоном);
			Запрос.УстановитьПараметр("РассчитыватьСправедливуюСтоимостьАктиваВРазрезеСделок", 	РассчитыватьСправедливуюСтоимостьАктиваВРазрезеСделок);
			Запрос.УстановитьПараметр("ОкруглятьВалютнуюСтоимостьЦБ", 							ОкруглятьВалютнуюСтоимостьЦБ);  
			Запрос.УстановитьПараметр("КритерийСущественностиОтклоненияССТПлюс", 				?(НастройкиФормированияСЧА.ИспользоватьНастройкиУчетнойПолитикиЕПС,
																									БухгалтерскийУчет.ОпределитьНастройкуУчета(Период, 
																																			Организация, 
																																			СчетДоверительногоУправления, 
																																			"КритерийСущественностиОтклоненияСС"),
																									НастройкиФормированияСЧА.КритерийСущественностиОтклоненияССТПлюс));
			
			ПоместитьСправедливыеСтоимостиВМенеджерВременныхТаблиц(Запрос, ВариантРасчетаОценочнойСтоимости);
			ПоместитьКурсыВалютВМенеджерВременныхТаблиц(Запрос, Период);
			
			Отбор = "_ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)";
			Если ТолькоСделкиНаПриобретениеЦенныхБумаг Тогда
				Отбор = Отбор + " И ВЫРАЗИТЬ(_ЗадолженностиПоЦеннымБумагамОстатки.Основание КАК Документ.Сделка).ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)";
			ИначеЕсли ТолькоСделкиНаРеализациюЦенныхБумаг Тогда
				Отбор = Отбор + " И ВЫРАЗИТЬ(_ЗадолженностиПоЦеннымБумагамОстатки.Основание КАК Документ.Сделка).ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)";
			КонецЕсли;
			
			ПоместитьЗадолженностиПоЦеннымБумагамВМенеджерВременныхТаблиц(Запрос, Отбор);
			
			Если ТолькоСделкиНаПриобретениеЦенныхБумагОцениваемыхПоСС Тогда
				
				#Область Удаляем_сделки_на_покупку_бумаг_оцениваемых_по_АС
				
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	_ЗадолженностиПоЦеннымБумагамОстатки.*
					|ПОМЕСТИТЬ _ЗадолженностиПоЦеннымБумагамОстатки_БезСделокНаПокупкуАС
					|ИЗ
					|	_ЗадолженностиПоЦеннымБумагамОстатки КАК _ЗадолженностиПоЦеннымБумагамОстатки
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределенияАктивовЕПС КАК РаспределенияАктивовЕПС
					|		ПО (РаспределенияАктивовЕПС.Организация = &Организация)
					|			И (РаспределенияАктивовЕПС.Сделка = _ЗадолженностиПоЦеннымБумагамОстатки.Основание)
					|			И (РаспределенияАктивовЕПС.Рынок = _ЗадолженностиПоЦеннымБумагамОстатки.Рынок)
					|			И (РаспределенияАктивовЕПС.ЦеннаяБумага = _ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага),
					|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
					|			&КонецПериода,
					|			Организация = &Организация
					|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаОбщие
					|ГДЕ
					|	ВЫБОР
					|			КОГДА НастройкиУчетаОбщие.ВестиЕдиныйБухгалтерскийУчет
					|				ТОГДА ВЫБОР
					|						КОГДА РаспределенияАктивовЕПС.УчетныйАктивЕПС ЕСТЬ НЕ NULL 
					|							ТОГДА НЕ РаспределенияАктивовЕПС.УчетныйАктивЕПС В (&УчетныеАктивыОцениваемыеПоАС)
					|						КОГДА НастройкиУчетаОбщие.ПриоритетнаяКатегорияПриКлассификацииДолговыхЦенныхБумаг <> ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка)
					|							ТОГДА НЕ НастройкиУчетаОбщие.ПриоритетнаяКатегорияПриКлассификацииДолговыхЦенныхБумаг В (&УчетныеАктивыОцениваемыеПоАС)
					|						ИНАЧЕ ИСТИНА
					|					КОНЕЦ
					|			ИНАЧЕ ИСТИНА
					|		КОНЕЦ
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|УНИЧТОЖИТЬ _ЗадолженностиПоЦеннымБумагамОстатки
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	*
					|ПОМЕСТИТЬ _ЗадолженностиПоЦеннымБумагамОстатки
					|ИЗ
					|	_ЗадолженностиПоЦеннымБумагамОстатки_БезСделокНаПокупкуАС КАК _ЗадолженностиПоЦеннымБумагамОстатки_БезСделокНаПокупкуАС";
				
				Запрос.УстановитьПараметр("УчетныеАктивыОцениваемыеПоАС", Кэширование.УчетныеАктивыОцениваемыеПоАмортизированнойСтоимости());
				
				Запрос.Выполнить();
				
				#КонецОбласти
				
			КонецЕсли;
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	МестаХранения.Ссылка КАК МестоХранения
				|ПОМЕСТИТЬ _ВнебиржевыеМестаХранения
				|ИЗ
				|	Справочник.МестаХранения КАК МестаХранения
				|ГДЕ
				|	МестаХранения.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ОжидаемыеДатыНоминалов.ЦеннаяБумага КАК ЦеннаяБумага,
				|	ОжидаемыеДатыНоминалов.Сделка КАК Сделка,
				|	НоминалыЦенныхБумаг.Номинал КАК Номинал
				|ПОМЕСТИТЬ _НоминалыОжидаемые
				|ИЗ
				|	(ВЫБРАТЬ
				|		НоминалыЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
				|		_ЗадолженностиПоЦеннымБумагамОстатки.Основание КАК Сделка,
				|		МАКСИМУМ(НоминалыЦенныхБумаг.Период) КАК Период
				|	ИЗ
				|		_ЗадолженностиПоЦеннымБумагамОстатки КАК _ЗадолженностиПоЦеннымБумагамОстатки
				|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
				|			ПО _ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага = НоминалыЦенныхБумаг.ЦеннаяБумага
				|				И (ТИПЗНАЧЕНИЯ(_ЗадолженностиПоЦеннымБумагамОстатки.Основание) = ТИП(Документ.Сделка))
				|				И (ВЫРАЗИТЬ(_ЗадолженностиПоЦеннымБумагамОстатки.Основание КАК Документ.Сделка).ДатаИсполнения >= НоминалыЦенныхБумаг.Период)
				|	
				|	СГРУППИРОВАТЬ ПО
				|		НоминалыЦенныхБумаг.ЦеннаяБумага,
				|		_ЗадолженностиПоЦеннымБумагамОстатки.Основание) КАК ОжидаемыеДатыНоминалов
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
				|		ПО ОжидаемыеДатыНоминалов.ЦеннаяБумага = НоминалыЦенныхБумаг.ЦеннаяБумага
				|			И ОжидаемыеДатыНоминалов.Период = НоминалыЦенныхБумаг.Период
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ЗадолженностиПоЦеннымБумагамОстатки.Рынок КАК Рынок,
				|	_ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
				|	_ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности КАК ТипЗадолженности,
				|	_ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности КАК ВидЗадолженности,
				|	_ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток КАК КоличествоОстаток,
				|	_ЗадолженностиПоЦеннымБумагамОстатки.СуммаОстаток КАК СуммаОстаток,
				|	_ЗадолженностиПоЦеннымБумагамОстатки.СуммаКупонаОстаток КАК СуммаКупонаОстаток,
				|	_ЗадолженностиПоЦеннымБумагамОстатки.Основание КАК Основание,
				|	ВЫБОР
				|		КОГДА ЕСТЬNULL(УсловияСделокСрезПоследних.СобственныйКурсОплаты, ЛОЖЬ)
				|			ТОГДА ВЫБОР
				|					КОГДА ТИПЗНАЧЕНИЯ(УсловияСделокСрезПоследних.КурсОплаты) = ТИП(ЧИСЛО)
				|						ТОГДА ВЫРАЗИТЬ(УсловияСделокСрезПоследних.КурсОплаты КАК ЧИСЛО)
				|					ИНАЧЕ КурсыВалютСделки.Курс / КурсыВалютСделки.Кратность
				|				КОНЕЦ
				|		ИНАЧЕ _КурсыВалют.Курс
				|	КОНЕЦ КАК КурсВалютыОплаты
