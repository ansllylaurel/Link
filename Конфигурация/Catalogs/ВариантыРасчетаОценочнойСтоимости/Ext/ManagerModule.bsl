
#Область Оценка_стоимости_ценных_бумаг

Функция ПолучитьСтоимостиЦенныхБумаг(ВариантРасчетаОценочнойСтоимости, Организация, СчетДоверительногоУправления, Период, Отказ, ПараметрыПолученияОстатков = Неопределено, ПараметрыПолученияПартий = Неопределено, ТаблицаСтоимостей = Неопределено, РасчетПартий = Неопределено, РасшифровкаРасчета = Неопределено, ЦенныеБумаги = Неопределено, МенеджерВременныхТаблиц = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ТаблицаСтоимостей = Неопределено Тогда
		Если Не ПроверитьКотировки(ВариантРасчетаОценочнойСтоимости, Организация, Период, Отказ) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	// Получаем остатки ценных бумаг и помещаем во временную таблицу
	
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли; 
	
	Если ЦенныеБумаги = Неопределено Тогда 
		
		ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(
			ВариантРасчетаОценочнойСтоимости,
			Организация,
			СчетДоверительногоУправления,
			Период,
			МенеджерВременныхТаблиц,
			ПараметрыПолученияОстатков,
			РасчетПартий,
			РасшифровкаРасчета);
		
		ЦенныеБумаги = МенеджерВременныхТаблиц.Таблицы["_ЦенныеБумаги"].ПолучитьДанные().Выгрузить();
		
	Иначе
		
		СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ЦенныеБумаги, "_ЦенныеБумаги", МенеджерВременныхТаблиц);
		
	КонецЕсли; 
	
	// Получаем общие параметры оценки
	
	КлиентДУ = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период);
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") И ДополнительныеПараметры.Свойство("ОценкиСтоимости") Тогда
		ОценкиСтоимости = ДополнительныеПараметры.ОценкиСтоимости;
	Иначе
		ОценкиСтоимости = ПолучитьОценкиСтоимости(Организация, СчетДоверительногоУправления, Период, ВариантРасчетаОценочнойСтоимости);
		
		Если ДополнительныеПараметры = Неопределено Тогда
			ДополнительныеПараметры = Новый Структура;
		КонецЕсли;
		
		ДополнительныеПараметры.Вставить("ОценкиСтоимости", ОценкиСтоимости);
	КонецЕсли;
	
	// Получаем стоимости ценных бумаг
	
	Если ТаблицаСтоимостей = Неопределено Тогда
		
		ПараметрыОценки = Новый Структура;
		ПараметрыОценки.Вставить("Организация",							Организация);
		ПараметрыОценки.Вставить("СчетДоверительногоУправления",		СчетДоверительногоУправления);
		ПараметрыОценки.Вставить("ЦельРасчета",							Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
		ПараметрыОценки.Вставить("ВидУчета",							Неопределено);
		ПараметрыОценки.Вставить("ВариантРасчетаСправедливойСтоимости",	ВариантРасчетаОценочнойСтоимости);
		ПараметрыОценки.Вставить("ПараметрыПолученияПартий",			ПараметрыПолученияПартий);
		ПараметрыОценки.Вставить("Клиент",								КлиентДУ);
		ПараметрыОценки.Вставить("ДополнительныеСвойства",				ДополнительныеПараметры);
		ПараметрыОценки.Вставить("ТаблицаПартийЦБ",						Новый ТаблицаЗначений); // см. РаботаСПереоценкой.ПоместитьБумагиОцениваемыеПоАмортизированнойСтоимостиВМенеджерВременныхТаблиц
		
		ТаблицаСтоимостей = РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС(
			ПараметрыОценки, 
			НачалоДня(Период),
			ЦенныеБумаги,
			Неопределено, 
			Отказ,
			РасшифровкаРасчета);
			
	КонецЕсли;
	
	// Приводим в соответствие табличной части РСП и дозаполняем стоимости ...
	
	Если РасчетПартий = Неопределено Тогда
		
		// ... на основании отчета оценщика
		
		ТаблицаРегистрацииСтоимостиПереоценки = ПолучитьТаблицуРегистрацииСтоимостиПереоценки(ТаблицаСтоимостей, НачалоДня(Период), Организация.ВалютаУчета, МенеджерВременныхТаблиц, ВариантРасчетаОценочнойСтоимости);
		
		Для Каждого ТекСтрока Из ТаблицаРегистрацииСтоимостиПереоценки Цикл
			
			НайденныеСтроки = ОценкиСтоимости.НайтиСтроки(Новый Структура("ЦеннаяБумага, ПовышенныйПриоритет", ТекСтрока.ЦеннаяБумага, Истина));
			
			ЗаполнитьОценочнуюЦену(НайденныеСтроки, ТекСтрока, Период, Организация.ЮрФизЛицо, КлиентДУ, РасшифровкаРасчета);
			
			Если Не ЗначениеЗаполнено(ТекСтрока.ВидЦены) Тогда
				
				НайденныеСтроки = ОценкиСтоимости.НайтиСтроки(Новый Структура("ЦеннаяБумага, ПовышенныйПриоритет", ТекСтрока.ЦеннаяБумага, Ложь));
				
				ЗаполнитьОценочнуюЦену(НайденныеСтроки, ТекСтрока, Период, Организация.ЮрФизЛицо, КлиентДУ, РасшифровкаРасчета);
				
			КонецЕсли;
		
		КонецЦикла;
		
	Иначе
		
		// ... расчетными ценами по данным партий
		
		СтруктураПереоценки = Новый Структура;
		СтруктураПереоценки.Вставить("Дата",									НачалоДня(Период));
		СтруктураПереоценки.Вставить("Организация",								Организация);
		СтруктураПереоценки.Вставить("СчетДоверительногоУправления",			СчетДоверительногоУправления);
		СтруктураПереоценки.Вставить("ЦельРасчета",								Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
		СтруктураПереоценки.Вставить("ВидУчета",								РасчетПартий.ВидУчета);
		СтруктураПереоценки.Вставить("ВариантРасчетаОценочнойСтоимости",		ВариантРасчетаОценочнойСтоимости);
		СтруктураПереоценки.Вставить("РассчитыватьПроцентныеПоказатели",		Ложь);
		СтруктураПереоценки.Вставить("ЦенныеБумаги",							Неопределено);
		СтруктураПереоценки.Вставить("ПереоцениватьНаОснованииНастроекУчета",	Ложь);
		СтруктураПереоценки.Вставить("Клиент",									КлиентДУ);
		СтруктураПереоценки.Вставить("ДополнительныеСвойства",					ДополнительныеПараметры);
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&Период КАК Период,
			|	&СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	&ВидУчета КАК ВидУчета,
			|	&ЦельРасчета КАК ЦельРасчета,
			|	 ТаблицаСтоимостейЦБ.*			
			|ПОМЕСТИТЬ СтоимостьПереоценки
			|ИЗ
			|	&ТаблицаСтоимостейЦБ КАК ТаблицаСтоимостейЦБ
			|ГДЕ
			|	(ТаблицаСтоимостейЦБ.ЦенаКотировки > 0
			|			ИЛИ ТаблицаСтоимостейЦБ.ВидЦены <> 0)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка) КАК УчетныйАктивЕПС,
			|	0 КАК СуммаРезервовПодОбесценение,
			|	_ЦенныеБумаги.Рынок КАК Рынок,
			|	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_ЦенныеБумаги.ТипЗадолженности КАК ТипЗадолженности,
			|	_ЦенныеБумаги.Основание КАК Основание,
			|	_ЦенныеБумаги.Партия КАК Партия,
			|	_ЦенныеБумаги.СтрокаПартии КАК СтрокаПартии,
			|	_ЦенныеБумаги.Количество КАК Количество
			|ПОМЕСТИТЬ _КонечныеОстаткиПартий
			|ИЗ
			|	&ЦенныеБумаги КАК _ЦенныеБумаги");
		
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос.Параметры.Вставить("ЦенныеБумаги",					ЦенныеБумаги);
		Запрос.Параметры.Вставить("ТаблицаСтоимостейЦБ",			ТаблицаСтоимостей);
		Запрос.Параметры.Вставить("Период",							НачалоДня(Период));
		Запрос.Параметры.Вставить("СчетДоверительногоУправления",	СчетДоверительногоУправления);
		Запрос.Параметры.Вставить("ВидУчета",						РасчетПартий.ВидУчета);
		Запрос.Параметры.Вставить("ЦельРасчета",					Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
		
		Запрос.Выполнить();
		
		РаботаСПереоценкой.ПолучитьТабличнуюЧастьПереоценки(СтруктураПереоценки, Запрос.МенеджерВременныхТаблиц, Отказ);
		
		ТаблицаРегистрацииСтоимостиПереоценки = СтруктураПереоценки.ЦенныеБумаги;
		
		Документы.РегистрацияСтоимостиПереоценки.ЗаменитьКолонкиПереоценки(ТаблицаРегистрацииСтоимостиПереоценки);
		
	КонецЕсли;
	
	// Проверяем, что все бумаги оценились
	
	Для Каждого ТекСтрока Из ТаблицаРегистрацииСтоимостиПереоценки Цикл
		Если Не ЗначениеЗаполнено(ТекСтрока.ВидЦены) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить стоимость ценной бумаги: " + ТекСтрока.ЦеннаяБумага);
		КонецЕсли;
	КонецЦикла; 
	
	Возврат ТаблицаРегистрацииСтоимостиПереоценки;
	
КонецФункции
 
Функция ПроверитьКотировки(ВариантРасчетаОценочнойСтоимости, Организация, Период, Отказ) Экспорт
	
	СтрокаСообщенийОКотировках = "";
	
	// По умолчанию выполняем все проверки
	
	СписокПроверкиКотировок = Новый Структура;
	СписокПроверкиКотировок.Вставить("КотировкиММВБ",		Истина);
	СписокПроверкиКотировок.Вставить("КотировкиБлумберг",	Истина);
	СписокПроверкиКотировок.Вставить("ИндексыММВБ",			Истина);
	СписокПроверкиКотировок.Вставить("ССРасчетныеНРД",		Истина);
	
	// Отключим ненужные и добавим собственные проверки в зависимости от методики
	
	Если ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ 
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФондФилософии
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РПИ 
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ЛонгТермИнвестментс
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФОГФ
	Тогда
	
		СписокПроверкиКотировок.ИндексыММВБ		= Ложь;
		СписокПроверкиКотировок.ССРасчетныеНРД	= Ложь;
		
	ИначеЕсли ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ВСК Тогда
		
		СписокПроверкиКотировок.Вставить("РасчетныеЦеныRUData", Истина);
		
	ИначеЕсли Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда
		//Временный вариант, 30.12.2025 нет старых цен НРД за 29.12.2025, а ежедневную СЧА считать надо
		СписокПроверкиКотировок.ССРасчетныеНРД	= Ложь;
	КонецЕсли;
	
	ВсеКотировкиЕсть = РаботаСПереоценкой.ПроверитьЗагружаемыеДанные(Период, СписокПроверкиКотировок, СтрокаСообщенийОКотировках);
	
	Если Не ВсеКотировкиЕсть Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаСообщенийОКотировках,,,,Отказ);
	КонецЕсли;
	
	Возврат ВсеКотировкиЕсть;	
	
КонецФункции

Функция ПолучитьТаблицуРегистрацииСтоимостиПереоценки(ТаблицаСтоимостей, Период, ВалютаУчета, МенеджерВременныхТаблиц, ВариантРасчетаОценочнойСтоимости)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Период",				Период);
	Запрос.УстановитьПараметр("ВалютаУчета",		ВалютаУчета);
	Запрос.УстановитьПараметр("ТаблицаСтоимостей",	ТаблицаСтоимостей);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаСтоимостей.Рынок КАК Рынок,
		|	ТаблицаСтоимостей.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСтоимостей.Стоимость КАК Стоимость,
		|	ТаблицаСтоимостей.Купон КАК Купон,
		|	ТаблицаСтоимостей.ВидЦены КАК ВидЦены,
		|	ТаблицаСтоимостей.УровеньОценки КАК УровеньОценки,
		|	ТаблицаСтоимостей.ДатаЦены КАК ДатаЦены,
		|	ТаблицаСтоимостей.Источник КАК Источник,
		|	ТаблицаСтоимостей.ВалютаНоминала КАК ВалютаНоминала,
		|	ТаблицаСтоимостей.ВалютаКотировки КАК ВалютаКотировки,
		|	ТаблицаСтоимостей.ВалютаКупона КАК ВалютаКупона
		|ПОМЕСТИТЬ _ТаблицаСтоимостей
		|ИЗ
		|	&ТаблицаСтоимостей КАК ТаблицаСтоимостей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КурсыВалют.Валюта КАК Валюта,
		|	КурсыВалют.Курс КАК Курс,
		|	КурсыВалют.Кратность КАК Кратность
		|ПОМЕСТИТЬ _КурсыВалют
		|ИЗ
		|	РегистрСведений.КурсыВалют КАК КурсыВалют
		|ГДЕ
		|	КурсыВалют.Период = &Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦенныеБумаги.Рынок КАК Рынок,
		|	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ЦенныеБумаги.Количество КАК Количество,
		|	_ЦенныеБумаги.ТипЗадолженности КАК ТипЗадолженности,
		|	_ТаблицаСтоимостей.Стоимость КАК ЦенаКотировки,
		|	_ТаблицаСтоимостей.Купон КАК ЦенаКотировкиКупона,
		|	_ТаблицаСтоимостей.ВидЦены КАК ВидЦены,
		|	_ТаблицаСтоимостей.УровеньОценки КАК УровеньОценки,
		|	_ТаблицаСтоимостей.ДатаЦены КАК ДатаЦены,
		|	_ТаблицаСтоимостей.Источник КАК Источник,
		|	_ТаблицаСтоимостей.ВалютаНоминала КАК ВалютаНоминала,
		|	_ТаблицаСтоимостей.ВалютаКотировки КАК ВалютаКотировки,
		|	_ТаблицаСтоимостей.ВалютаКупона КАК ВалютаКотировкиКупона,
		|	_КурсыНоминалов.Курс КАК КурсВалютыНоминалаНаДатуОценкиКурс,
		|	_КурсыНоминалов.Кратность КАК КурсВалютыНоминалаНаДатуОценкиКратность,
		|	_КурсыКотировок.Курс КАК КурсКотировки,
		|	_КурсыКотировок.Кратность КАК КратностьКотировки,
		|	_КурсыКупонов.Курс КАК КурсКупона,
		|	_КурсыКупонов.Кратность КАК КратностьКупона,
		|	_КурсыВалютыУчета.Курс КАК КурсВалютыУчета,
		|	_КурсыВалютыУчета.Кратность КАК КратностьВалютыУчета,
		|	_ЦенныеБумаги.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации) КАК ЭтоОблигация
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаСтоимостей КАК _ТаблицаСтоимостей
		|			ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыНоминалов
		|			ПО _ТаблицаСтоимостей.ВалютаНоминала = _КурсыНоминалов.Валюта
		|			ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыКотировок
		|			ПО _ТаблицаСтоимостей.ВалютаКотировки = _КурсыКотировок.Валюта
		|			ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыКупонов
		|			ПО _ТаблицаСтоимостей.ВалютаКупона = _КурсыКупонов.Валюта
		|			ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалютыУчета
		|			ПО (_КурсыВалютыУчета.Валюта = &ВалютаУчета)
		|		ПО _ЦенныеБумаги.Рынок = _ТаблицаСтоимостей.Рынок
		|			И _ЦенныеБумаги.ЦеннаяБумага = _ТаблицаСтоимостей.ЦеннаяБумага";
	
	ТаблицаРегистрацииСтоимостиПереоценки = Запрос.Выполнить().Выгрузить();
	
	Запрос.Текст = 
		"УНИЧТОЖИТЬ _ТаблицаСтоимостей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _КурсыВалют";
	Запрос.Выполнить();
	
	РеквизитыТЧ = Метаданные.Документы.РегистрацияСтоимостиПереоценки.ТабличныеЧасти.СтоимостиПереоценки.Реквизиты;
	
	КолонкиКДобавлению = "Сумма, СуммаКупона, СуммаВВалютеУчета, СуммаКупонаВВалютеУчета, Партия, СтрокаПартии, Примечание";
	
	Для каждого ИмяКолонки Из СтрРазделить(СтрЗаменить(КолонкиКДобавлению, " ", ""), ",", Ложь) Цикл
		ТаблицаРегистрацииСтоимостиПереоценки.Колонки.Добавить(ИмяКолонки, РеквизитыТЧ[ИмяКолонки].Тип);
	КонецЦикла;
	
	// Цену и ЦенуКупона добавляем без типизации для совместимости со старым вариантом работы
	ТаблицаРегистрацииСтоимостиПереоценки.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
	ТаблицаРегистрацииСтоимостиПереоценки.Колонки.Добавить("ЦенаКупона", Новый ОписаниеТипов("Число"));
	
	// Для фиксации курса, заданного оценщиком
	ТаблицаРегистрацииСтоимостиПереоценки.Колонки.Добавить("КурсВалютыНоминала", Метаданные.Документы.РегистрацияСтоимостиПереоценки.ТабличныеЧасти.СтоимостиПереоценки.Реквизиты.КурсВалютыНоминала.Тип);
	
	// Обязательное поле, см. Документы.РегистрацияСтоимостиПереоценки.ЗаполнитьСтоимостьПереоценки
	ТаблицаРегистрацииСтоимостиПереоценки.Колонки.Добавить("УчетныйАктивЕПС", Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
	
	МассивПолейКонтроля	= СтрРазделить("КурсВалютыНоминалаНаДатуОценкиКурс, КурсВалютыНоминалаНаДатуОценкиКратность, КурсВалютыУчета", ", ", Ложь);
	
	Для каждого ТекСтрока Из ТаблицаРегистрацииСтоимостиПереоценки Цикл
		
		// Проверяем, что есть все необходимые данные
		
		ПропуститьСтроку = Ложь;
		
		Для каждого ИмяКолонки Из МассивПолейКонтроля Цикл
			Если Не ЗначениеЗаполнено(ТекСтрока[ИмяКолонки]) Тогда
				ПропуститьСтроку = Истина;
				Прервать;
			КонецЕсли; 
		КонецЦикла; 
		
		Если ПропуститьСтроку Тогда
			Продолжить;
		КонецЕсли;
		
		// Точность валютных сумм при расчете рублевых
		
		Если Период >= '20230411'
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2021 И Период >= '20220729'
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2021 И Период >= '20220729'
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ_УКПИ И Период >= '20221101'
		Тогда
			Разрядность = Неопределено; // Без округления
		ИначеЕсли ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2018
			Или ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2020
			Или ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2021 И Период < '20220729'
			Или ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2018
			Или ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2021 И Период < '20220729'
			Или ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ_УКПИ И Период < '20221101'
		Тогда
			Разрядность = 4; // Для ПИФ считали рублевые суммы (по УП) и купоны (по методике) от валютных с точностью 4 знака
		Иначе
			Разрядность = 2; // Для всех остальных 2 знака
		КонецЕсли;
		
		// Расчет цены и суммы
		
		Если ЗначениеЗаполнено(ТекСтрока.КратностьКотировки) Тогда
			
			Если ТекСтрока.ВалютаКотировки = ТекСтрока.ВалютаНоминала Тогда
				ТекСтрока.Цена = ТекСтрока.ЦенаКотировки;
			Иначе
				ТекСтрока.Цена = ТекСтрока.ЦенаКотировки * ТекСтрока.КурсКотировки / ТекСтрока.КратностьКотировки / ТекСтрока.КурсВалютыНоминалаНаДатуОценкиКурс * ТекСтрока.КурсВалютыНоминалаНаДатуОценкиКратность;
			КонецЕсли;
			
			Сумма = ТекСтрока.Цена * ТекСтрока.Количество;
			
			ТекСтрока.Сумма = Сумма;
					
			Если ТекСтрока.ВалютаНоминала = ВалютаУчета Тогда
				ТекСтрока.СуммаВВалютеУчета = Сумма;
			ИначеЕсли ТекСтрока.ВалютаКотировки = ВалютаУчета Тогда
				ТекСтрока.СуммаВВалютеУчета = ТекСтрока.ЦенаКотировки * ТекСтрока.Количество;
			Иначе
				ТекСтрока.СуммаВВалютеУчета =
					?(Разрядность = Неопределено, Сумма, Окр(Сумма, Разрядность))
						* ТекСтрока.КурсВалютыНоминалаНаДатуОценкиКурс / ТекСтрока.КурсВалютыНоминалаНаДатуОценкиКратность / ТекСтрока.КурсВалютыУчета * ТекСтрока.КратностьВалютыУчета;
			КонецЕсли;                       
			
		КонецЕсли;	
		
		// Расчет цены и суммы купона
		
		Если ТекСтрока.ЭтоОблигация И ЗначениеЗаполнено(ТекСтрока.КратностьКупона) Тогда
			
			Если ТекСтрока.ВалютаКотировкиКупона = ТекСтрока.ВалютаНоминала Тогда
				ТекСтрока.ЦенаКупона = ТекСтрока.ЦенаКотировкиКупона;
			Иначе
				ЦенаКупона			 = ТекСтрока.ЦенаКотировкиКупона * ТекСтрока.КурсКупона / ТекСтрока.КратностьКупона / ТекСтрока.КурсВалютыНоминалаНаДатуОценкиКурс * ТекСтрока.КурсВалютыНоминалаНаДатуОценкиКратность;
				ТекСтрока.ЦенаКупона = ?(Разрядность = Неопределено, ЦенаКупона, Окр(ЦенаКупона, Разрядность));
			КонецЕсли;
			
			СуммаКупона = ТекСтрока.ЦенаКупона * ТекСтрока.Количество;
			
			ТекСтрока.СуммаКупона = СуммаКупона;
			
			Если ТекСтрока.ВалютаНоминала = ВалютаУчета Тогда
				ТекСтрока.СуммаКупонаВВалютеУчета = СуммаКупона;
			ИначеЕсли ТекСтрока.ВалютаКотировкиКупона = ВалютаУчета Тогда
				ТекСтрока.СуммаКупонаВВалютеУчета = ТекСтрока.ЦенаКотировкиКупона * ТекСтрока.Количество;
			Иначе
				ТекСтрока.СуммаКупонаВВалютеУчета =
					?(Разрядность = Неопределено, СуммаКупона, Окр(СуммаКупона, Разрядность))
						* ТекСтрока.КурсВалютыНоминалаНаДатуОценкиКурс / ТекСтрока.КурсВалютыНоминалаНаДатуОценкиКратность / ТекСтрока.КурсВалютыУчета * ТекСтрока.КратностьВалютыУчета;
			КонецЕсли;			
			
		КонецЕсли;
		
	КонецЦикла; 
	
	КолонкиКУдалению = "ЭтоОблигация, КурсКотировки, КратностьКотировки, КурсКупона, КратностьКупона, КурсВалютыУчета, КратностьВалютыУчета";
	Для каждого ИмяКолонки Из СтрРазделить(СтрЗаменить(КолонкиКУдалению, " ", ""), ",", Ложь) Цикл
		ТаблицаРегистрацииСтоимостиПереоценки.Колонки.Удалить(ИмяКолонки);
	КонецЦикла; 
	
	Возврат ТаблицаРегистрацииСтоимостиПереоценки;

КонецФункции

Функция ПолучитьОценкиСтоимости(Организация, СчетДоверительногоУправления, Период, ВариантРасчетаСтоимости) Экспорт

	Если ВариантРасчетаСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ_УКПИ Тогда	
		
		//считаем, что срок действия цены оценщика = 6 месяцев
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.Стоимость КАК Стоимость,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.СтоимостьКупона КАК СтоимостьКупона,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ПовышенныйПриоритет КАК ПовышенныйПриоритет,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.Оценщик КАК Оценщик,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.Источник КАК Источник,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ВидЦены КАК ВидЦены,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.УровеньОценки КАК УровеньОценки,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ДатаОценки КАК ДатаОценки,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.КурсВалютыНоминала КАК КурсВалютыНоминала,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ОценкаКупона КАК ОценкаКупона,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ОценкаЦены КАК ОценкаЦены,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.Период КАК ДатаНачалаДействияЦены
			|ПОМЕСТИТЬ _ЦеныОценщика
			|ИЗ
			|	РегистрСведений.ОценкиСтоимостиЦенныхБумаг.СрезПоследних(
			|			&ДатаПереоценки,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И НАЧАЛОПЕРИОДА(ДатаОкончанияДействия, ДЕНЬ) >= НАЧАЛОПЕРИОДА(&ДатаПереоценки, ДЕНЬ)) КАК ОценкиСтоимостиЦенныхБумагСрезПоследних
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ЦеныОценщика.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_ЦеныОценщика.Стоимость - СУММА(ЕСТЬNULL(НачислениеДивидендов.ДивидендыНаЦеннуюБумагу, 0) * ВЫБОР
			|			КОГДА _ЦеныОценщика.ЦеннаяБумага ССЫЛКА Справочник.Доли
			|				ТОГДА (ВЫРАЗИТЬ(ЕСТЬNULL(ОстаткиНаДатуОценки.КоличествоОстаток, 0) КАК ЧИСЛО(19, 7))) / 100
			|			ИНАЧЕ 1
			|		КОНЕЦ) КАК Стоимость,
			|	СУММА(ЕСТЬNULL(НачислениеДивидендов.ДивидендыНаЦеннуюБумагу, 0)) КАК ДивидендыНаЦеннуюБумагу,
			|	СУММА(ЕСТЬNULL(ОстаткиНаДатуОценки.КоличествоОстаток, 0)) КАК КоличествоОстатокДоли,
			|	_ЦеныОценщика.СтоимостьКупона КАК СтоимостьКупона,
			|	_ЦеныОценщика.ДатаОценки КАК ДатаОценки,
			|	_ЦеныОценщика.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
			|	_ЦеныОценщика.ПовышенныйПриоритет КАК ПовышенныйПриоритет,
			|	_ЦеныОценщика.Оценщик КАК Оценщик,
			|	_ЦеныОценщика.Источник КАК Источник,
			|	_ЦеныОценщика.ВидЦены КАК ВидЦены,
			|	_ЦеныОценщика.УровеньОценки КАК УровеньОценки,
			|	_ЦеныОценщика.КурсВалютыНоминала КАК КурсВалютыНоминала,
			|	_ЦеныОценщика.ОценкаКупона КАК ОценкаКупона,
			|	_ЦеныОценщика.ОценкаЦены КАК ОценкаЦены
			|ПОМЕСТИТЬ _СкорректированныеЦеныОценщика
			|ИЗ
			|	_ЦеныОценщика КАК _ЦеныОценщика
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
			|		ПО (ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствам.Регистратор) = ТИП(Документ.НачислениеДивидендов))
			|			И (НАЧАЛОПЕРИОДА(_ЦеныОценщика.ДатаОценки, ДЕНЬ) < НАЧАЛОПЕРИОДА(ЗадолженностиПоДенежнымСредствам.Период, ДЕНЬ))
			|			И (НАЧАЛОПЕРИОДА(&ДатаПереоценки, ДЕНЬ) >= НАЧАЛОПЕРИОДА(ЗадолженностиПоДенежнымСредствам.Период, ДЕНЬ))
			|			И (ЗадолженностиПоДенежнымСредствам.Организация = &Организация)
			|			И (ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = &СчетДоверительногоУправления)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НачислениеДивидендов КАК НачислениеДивидендов
			|		ПО _ЦеныОценщика.ЦеннаяБумага = НачислениеДивидендов.ЦеннаяБумага
			|			И (ЗадолженностиПоДенежнымСредствам.Регистратор = НачислениеДивидендов.Ссылка)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг КАК ДвиженияДолейСДатыОценки
			|		ПО (ДвиженияДолейСДатыОценки.Период МЕЖДУ ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(_ЦеныОценщика.ДатаНачалаДействияЦены, ДЕНЬ), ДЕНЬ, 1) И &ДатаПереоценки)
			|			И (НЕ(ДвиженияДолейСДатыОценки.Период МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаВводаОстатков, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаВводаОстатков, ДЕНЬ)))
			|			И (ДвиженияДолейСДатыОценки.Организация = &Организация)
			|			И (ДвиженияДолейСДатыОценки.СчетДоверительногоУправления = &СчетДоверительногоУправления)
			|			И (ДвиженияДолейСДатыОценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли))
			|			И _ЦеныОценщика.ЦеннаяБумага = ДвиженияДолейСДатыОценки.ЦеннаяБумага
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
			|				КОНЕЦПЕРИОДА(&ДатаПереоценки, ДЕНЬ),
			|				Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли)
			|					И Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|					И ЦеннаяБумага В
			|						(ВЫБРАТЬ
			|							_ЦеныОценщика.ЦеннаяБумага
			|						ИЗ
			|							_ЦеныОценщика)) КАК ОстаткиНаДатуОценки
			|		ПО _ЦеныОценщика.ЦеннаяБумага = ОстаткиНаДатуОценки.ЦеннаяБумага
			|
			|СГРУППИРОВАТЬ ПО
			|	_ЦеныОценщика.ЦеннаяБумага,
			|	_ЦеныОценщика.Стоимость,
			|	_ЦеныОценщика.СтоимостьКупона,
			|	_ЦеныОценщика.ДатаОкончанияДействия,
			|	_ЦеныОценщика.ПовышенныйПриоритет,
			|	_ЦеныОценщика.Оценщик,
			|	_ЦеныОценщика.Источник,
			|	_ЦеныОценщика.ВидЦены,
			|	_ЦеныОценщика.УровеньОценки,
			|	_ЦеныОценщика.ДатаОценки,
			|	_ЦеныОценщика.КурсВалютыНоминала,
			|	_ЦеныОценщика.ОценкаКупона,
			|	_ЦеныОценщика.ОценкаЦены
			|
			|ИМЕЮЩИЕ
			|	СУММА(ЕСТЬNULL(ДвиженияДолейСДатыОценки.Количество, 0)) = 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ЦеныОценщика.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_ЦеныОценщика.Стоимость КАК Стоимость,
			|	0 КАК ДивидендыНаЦеннуюБумагу,
			|	СУММА(ЕСТЬNULL(ОстаткиНаДатуОценки.КоличествоОстаток, 0)) КАК КоличествоОстатокДоли,
			|	_ЦеныОценщика.СтоимостьКупона КАК СтоимостьКупона,
			|	_ЦеныОценщика.ДатаОценки КАК ДатаОценки,
			|	_ЦеныОценщика.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
			|	_ЦеныОценщика.ПовышенныйПриоритет КАК ПовышенныйПриоритет,
			|	_ЦеныОценщика.Оценщик КАК Оценщик,
			|	_ЦеныОценщика.Источник КАК Источник,
			|	_ЦеныОценщика.ВидЦены КАК ВидЦены,
			|	_ЦеныОценщика.УровеньОценки КАК УровеньОценки,
			|	_ЦеныОценщика.КурсВалютыНоминала КАК КурсВалютыНоминала,
			|	_ЦеныОценщика.ОценкаКупона КАК ОценкаКупона,
			|	_ЦеныОценщика.ОценкаЦены КАК ОценкаЦены
			|ИЗ
			|	_ЦеныОценщика КАК _ЦеныОценщика
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг КАК ДвиженияДолейСДатыОценки
			|		ПО (ДвиженияДолейСДатыОценки.Период МЕЖДУ ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(_ЦеныОценщика.ДатаНачалаДействияЦены, ДЕНЬ), ДЕНЬ, 1) И &ДатаПереоценки)
			|			И (НЕ(ДвиженияДолейСДатыОценки.Период МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаВводаОстатков, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаВводаОстатков, ДЕНЬ)))
			|			И (ДвиженияДолейСДатыОценки.Организация = &Организация)
			|			И (ДвиженияДолейСДатыОценки.СчетДоверительногоУправления = &СчетДоверительногоУправления)
			|			И (ДвиженияДолейСДатыОценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли))
			|			И _ЦеныОценщика.ЦеннаяБумага = ДвиженияДолейСДатыОценки.ЦеннаяБумага
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
			|				КОНЕЦПЕРИОДА(&ДатаПереоценки, ДЕНЬ),
			|				Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли)
			|					И Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|					И ЦеннаяБумага В
			|						(ВЫБРАТЬ
			|							_ЦеныОценщика.ЦеннаяБумага
			|						ИЗ
			|							_ЦеныОценщика)) КАК ОстаткиНаДатуОценки
			|		ПО _ЦеныОценщика.ЦеннаяБумага = ОстаткиНаДатуОценки.ЦеннаяБумага
			|		ЛЕВОЕ СОЕДИНЕНИЕ _СкорректированныеЦеныОценщика КАК _СкорректированныеЦеныОценщика
			|		ПО _ЦеныОценщика.ЦеннаяБумага = _СкорректированныеЦеныОценщика.ЦеннаяБумага
			|ГДЕ
			|	_СкорректированныеЦеныОценщика.ЦеннаяБумага ЕСТЬ NULL
			|
			|СГРУППИРОВАТЬ ПО
			|	_ЦеныОценщика.ЦеннаяБумага,
			|	_ЦеныОценщика.Стоимость,
			|	_ЦеныОценщика.СтоимостьКупона,
			|	_ЦеныОценщика.ДатаОкончанияДействия,
			|	_ЦеныОценщика.ПовышенныйПриоритет,
			|	_ЦеныОценщика.Оценщик,
			|	_ЦеныОценщика.Источник,
			|	_ЦеныОценщика.ВидЦены,
			|	_ЦеныОценщика.УровеньОценки,
			|	_ЦеныОценщика.ДатаОценки,
			|	_ЦеныОценщика.КурсВалютыНоминала,
			|	_ЦеныОценщика.ОценкаКупона,
			|	_ЦеныОценщика.ОценкаЦены
			|
			|ИМЕЮЩИЕ
			|	(СУММА(ЕСТЬNULL(ДвиженияДолейСДатыОценки.Количество, 0)) = 0
			|		ИЛИ СУММА(ЕСТЬNULL(ОстаткиНаДатуОценки.КоличествоОстаток, 0)) = СУММА(ЕСТЬNULL(ДвиженияДолейСДатыОценки.Количество, 0))
			|			И КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДвиженияДолейСДатыОценки.Регистратор) = 1)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_СкорректированныеЦеныОценщика.ЦеннаяБумага,
			|	_СкорректированныеЦеныОценщика.Стоимость,
			|	_СкорректированныеЦеныОценщика.ДивидендыНаЦеннуюБумагу,
			|	_СкорректированныеЦеныОценщика.КоличествоОстатокДоли,
			|	_СкорректированныеЦеныОценщика.СтоимостьКупона,
			|	_СкорректированныеЦеныОценщика.ДатаОценки,
			|	_СкорректированныеЦеныОценщика.ДатаОкончанияДействия,
			|	_СкорректированныеЦеныОценщика.ПовышенныйПриоритет,
			|	_СкорректированныеЦеныОценщика.Оценщик,
			|	_СкорректированныеЦеныОценщика.Источник,
			|	_СкорректированныеЦеныОценщика.ВидЦены,
			|	_СкорректированныеЦеныОценщика.УровеньОценки,
			|	_СкорректированныеЦеныОценщика.КурсВалютыНоминала,
			|	_СкорректированныеЦеныОценщика.ОценкаКупона,
			|	_СкорректированныеЦеныОценщика.ОценкаЦены
			|ИЗ
			|	_СкорректированныеЦеныОценщика КАК _СкорректированныеЦеныОценщика
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДатаОкончанияДействия,
			|	ПовышенныйПриоритет УБЫВ";
		
		Запрос.УстановитьПараметр("ДатаПереоценки", Период);
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
		
		Если Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ")  
			И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда 
			ДатаВводаОстатков = Дата(2018,12,29);
		Иначе
			ДатаВводаОстатков = Организация.ДатаНачалаУчета - 86400;
		КонецЕсли;
		Запрос.УстановитьПараметр("ДатаВводаОстатков", ДатаВводаОстатков);
		
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.Стоимость КАК Стоимость,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.СтоимостьКупона КАК СтоимостьКупона,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ПовышенныйПриоритет КАК ПовышенныйПриоритет,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.Оценщик КАК Оценщик,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.Источник КАК Источник,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ВидЦены КАК ВидЦены,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.УровеньОценки КАК УровеньОценки,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ДатаОценки КАК ДатаОценки,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.КурсВалютыНоминала КАК КурсВалютыНоминала,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ОценкаКупона КАК ОценкаКупона,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ОценкаЦены КАК ОценкаЦены
			|ИЗ
			|	РегистрСведений.ОценкиСтоимостиЦенныхБумаг.СрезПоследних(
			|			&ДатаПереоценки,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И НАЧАЛОПЕРИОДА(ДатаОкончанияДействия, ДЕНЬ) >= НАЧАЛОПЕРИОДА(&ДатаПереоценки, ДЕНЬ)) КАК ОценкиСтоимостиЦенныхБумагСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг КАК ДвиженияДолейСДатыОценки
			|		ПО (ДвиженияДолейСДатыОценки.Период МЕЖДУ ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(ОценкиСтоимостиЦенныхБумагСрезПоследних.Период, ДЕНЬ), ДЕНЬ, 1) И &ДатаПереоценки)
			|			И (НЕ(ДвиженияДолейСДатыОценки.Период МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаВводаОстатков, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаВводаОстатков, ДЕНЬ)))
			|			И (ДвиженияДолейСДатыОценки.Организация = &Организация)
			|			И (ДвиженияДолейСДатыОценки.СчетДоверительногоУправления = &СчетДоверительногоУправления)
			|			И (ДвиженияДолейСДатыОценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли))
			|			И ОценкиСтоимостиЦенныхБумагСрезПоследних.ЦеннаяБумага = ДвиженияДолейСДатыОценки.ЦеннаяБумага
			|
			|СГРУППИРОВАТЬ ПО
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ВидЦены,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ОценкаКупона,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.КурсВалютыНоминала,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.СтоимостьКупона,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ДатаОценки,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.Оценщик,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ПовышенныйПриоритет,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.Источник,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ЦеннаяБумага,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.Стоимость,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ОценкаЦены,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ДатаОкончанияДействия,
			|	ОценкиСтоимостиЦенныхБумагСрезПоследних.УровеньОценки
			|
			|ИМЕЮЩИЕ
			|	СУММА(ЕСТЬNULL(ДвиженияДолейСДатыОценки.Количество, 0)) = 0
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДатаОкончанияДействия,
			|	ПовышенныйПриоритет УБЫВ";
		
		Запрос.УстановитьПараметр("ДатаПереоценки", Период);
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ДатаВводаОстатков", Организация.ДатаНачалаУчета - 86400);
		
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
		
КонецФункции
 
Функция ЗаполнитьОценочнуюЦену(НайденныеСтроки, СтрокаЦенныеБумаги, ДатаПереоценки, ЮрФизЛицоОрганизации, КлиентДУ, РасшифровкаРасчета = Неопределено) Экспорт
	
	КоличествоСтрокОценки = НайденныеСтроки.Количество();
	Если КоличествоСтрокОценки = 0 Тогда
		Возврат Ложь;
	ИначеЕсли КоличествоСтрокОценки > 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Существует несколько действующих оценочных цен для ЦБ " + Строка(СтрокаЦенныеБумаги.ЦеннаяБумага));
	КонецЕсли;
	
	НайденаяСтрока = НайденныеСтроки.Получить(0);
	
	// Костылечик для определения, какие поля нужно заполнять
	
	ЭтоПереоценка = ОбщегоНазначенияКлиентСервер.ПолеСуществует(СтрокаЦенныеБумаги, "ОценочнаяЦена");		
	
	Если ЭтоПереоценка Тогда
		ПолеИсточник	= "ИсточникЦены";
		ПолеВидыЦены	= "ПолеЦены";
		ПолеДатаЦены	= "ДатаКотировки";
		ПолеЦеныКупона	= "ОценочнаяЦенаКупона";
	Иначе
		ПолеИсточник	= "Источник";
		ПолеВидыЦены	= "ВидЦены";
		ПолеДатаЦены	= "ДатаЦены";
		ПолеЦеныКупона	= "ЦенаКупона"; 
	КонецЕсли;	
	
	// Курс валюты номинала	
	
	Если ЗначениеЗаполнено(НайденаяСтрока.КурсВалютыНоминала) Тогда
		СтрокаЦенныеБумаги.КурсВалютыНоминала = НайденаяСтрока.КурсВалютыНоминала;
	КонецЕсли;	
	
	КурсВалютыНоминала =
		?(ЗначениеЗаполнено(СтрокаЦенныеБумаги.КурсВалютыНоминала),
			СтрокаЦенныеБумаги.КурсВалютыНоминала,
			СтрокаЦенныеБумаги.КурсВалютыНоминалаНаДатуОценкиКурс / СтрокаЦенныеБумаги.КурсВалютыНоминалаНаДатуОценкиКратность);	

	// Оценка цены
	
	Если НайденаяСтрока.ОценкаЦены Тогда
	
		// Биржа
		
		Если ЭтоПереоценка Тогда
			СтрокаЦенныеБумаги.Биржа = Справочники.Биржи.ПустаяСсылка();
		КонецЕсли;
		
		// Источник
		
		Если ЗначениеЗаполнено(НайденаяСтрока.Источник) Тогда
			СтрокаЦенныеБумаги[ПолеИсточник] = НайденаяСтрока.Источник;
		Иначе
			СтрокаЦенныеБумаги[ПолеИсточник] = НайденаяСтрока.Оценщик;
		КонецЕсли;
			
		Если Не ЗначениеЗаполнено(НайденаяСтрока.ВидЦены) И СтрокаЦенныеБумаги[ПолеИсточник] = ЮрФизЛицоОрганизации Тогда
			СтрокаЦенныеБумаги[ПолеИсточник] = КлиентДУ;
		КонецЕсли;
		
		// Вид цены
		
		Если ЗначениеЗаполнено(НайденаяСтрока.ВидЦены) Тогда
			СтрокаЦенныеБумаги[ПолеВидыЦены] = НайденаяСтрока.ВидЦены;
		ИначеЕсли СтрокаЦенныеБумаги[ПолеИсточник] = ЮрФизЛицоОрганизации Тогда
			СтрокаЦенныеБумаги[ПолеВидыЦены] = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
		Иначе
			СтрокаЦенныеБумаги[ПолеВидыЦены] = Перечисления.ИсточникиЦеныДляПереоценки.ОценочнаяЦена;
		КонецЕсли;
		
		// Уровень оценки
		
		Если ЗначениеЗаполнено(НайденаяСтрока.УровеньОценки) Тогда
			СтрокаЦенныеБумаги.УровеньОценки = НайденаяСтрока.УровеньОценки;
		Иначе
			СтрокаЦенныеБумаги.УровеньОценки = 3;
		КонецЕсли;
		
		// Дата цены
		
		Если ЗначениеЗаполнено(НайденаяСтрока.ВидЦены) Тогда
			СтрокаЦенныеБумаги[ПолеДатаЦены] = НайденаяСтрока.ДатаОценки;
		Иначе
			СтрокаЦенныеБумаги[ПолеДатаЦены] = ДатаПереоценки;
		КонецЕсли;
		
		// Валюта котировки
		
		Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Доли Тогда
			СтрокаЦенныеБумаги.ВалютаКотировки = ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");
		Иначе
			СтрокаЦенныеБумаги.ВалютаКотировки = СтрокаЦенныеБумаги.ВалютаНоминала;
		КонецЕсли;	
				
		// Цена и суммы
		
		СтрокаЦенныеБумаги.ЦенаКотировки = НайденаяСтрока.Стоимость;
		
		Если ЭтоПереоценка Тогда
			
			СтрокаЦенныеБумаги.РыночнаяЦена		= НайденаяСтрока.Стоимость;
			СтрокаЦенныеБумаги.ОценочнаяЦена	= СтрокаЦенныеБумаги.РыночнаяЦена;
			
			Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Доли Тогда
				СтрокаЦенныеБумаги.РыночнаяСумма	= СтрокаЦенныеБумаги.РыночнаяЦена;
				СтрокаЦенныеБумаги.ОценочнаяСумма	= СтрокаЦенныеБумаги.ОценочнаяЦена;
			Иначе
				СтрокаЦенныеБумаги.РыночнаяСумма	= СтрокаЦенныеБумаги.РыночнаяЦена * СтрокаЦенныеБумаги.Количество;
				СтрокаЦенныеБумаги.ОценочнаяСумма	= СтрокаЦенныеБумаги.РыночнаяСумма;
			КонецЕсли;
			
		Иначе
			
			СтрокаЦенныеБумаги.Цена = НайденаяСтрока.Стоимость;
			
			Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Доли Тогда
				СтрокаЦенныеБумаги.Сумма				= СтрокаЦенныеБумаги.Цена;
				СтрокаЦенныеБумаги.СуммаВВалютеУчета	= СтрокаЦенныеБумаги.Цена * КурсВалютыНоминала;
			Иначе
				СтрокаЦенныеБумаги.Сумма				= СтрокаЦенныеБумаги.Цена * СтрокаЦенныеБумаги.Количество;
				СтрокаЦенныеБумаги.СуммаВВалютеУчета	= СтрокаЦенныеБумаги.Цена * СтрокаЦенныеБумаги.Количество * КурсВалютыНоминала;
			КонецЕсли;
			
		КонецЕсли;
		
		// Процент цены облигации
		
		Если ЭтоПереоценка И СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			СтрокаЦенныеБумаги.РыночнаяЦенаПроцент = НайденаяСтрока.Стоимость / СтрокаЦенныеБумаги.Номинал * 100;
			СтрокаЦенныеБумаги.ОценочнаяЦенаПроцент = СтрокаЦенныеБумаги.РыночнаяЦенаПроцент;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Купон облигации
	
	Если НайденаяСтрока.ОценкаКупона И СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		
		ПолеЦенаКотировкиКупона		= "ЦенаКотировкиКупона";
		ЕстьПолеЦенаКотировкиКупона = ОбщегоНазначенияКлиентСервер.ПолеСуществует(СтрокаЦенныеБумаги, ПолеЦенаКотировкиКупона);
		
		СтрокаЦенныеБумаги.ВалютаКотировкиКупона = СтрокаЦенныеБумаги.ВалютаНоминала;
		СтрокаЦенныеБумаги[ПолеЦеныКупона]		 = НайденаяСтрока.СтоимостьКупона;
		
		Если ЕстьПолеЦенаКотировкиКупона Тогда
			СтрокаЦенныеБумаги[ПолеЦенаКотировкиКупона] = НайденаяСтрока.СтоимостьКупона;
		КонецЕсли;
		
		Если ЭтоПереоценка Тогда
			СтрокаЦенныеБумаги["РыночнаяЦенаКупона"] = НайденаяСтрока.СтоимостьКупона;
		Иначе
			СтрокаЦенныеБумаги.СуммаКупона 		  		= СтрокаЦенныеБумаги.ЦенаКупона * СтрокаЦенныеБумаги.Количество;
			СтрокаЦенныеБумаги.СуммаКупонаВВалютеУчета  = СтрокаЦенныеБумаги.ЦенаКупона * СтрокаЦенныеБумаги.Количество * КурсВалютыНоминала;
		КонецЕсли;		
		
	КонецЕсли;
	
	// Расшифровка расчета
	
	Если РасшифровкаРасчета <> Неопределено Тогда		
		ПараметрыРасчетаЦен = Новый Структура("ЦенаКотировки, УровеньОценки, " + ПолеВидыЦены + ", " + ПолеДатаЦены + ", " + ПолеЦеныКупона + ", " + ПолеИсточник);
		ЗаполнитьЗначенияСвойств(ПараметрыРасчетаЦен, СтрокаЦенныеБумаги);
		РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Результат алгоритма", "После оценки активов на основании отчета оценщика", ПараметрыРасчетаЦен);
	КонецЕсли;

	Возврат НайденаяСтрока.ОценкаЦены;
	
КонецФункции

#КонецОбласти 

#Область Оценка_задолженностей_по_сделкам_ТПлюс

// Помещает задолженность по торговой и брокерской комиссии по сделкам Т+ в менеджер временных таблиц
// Пока используется только для ФОГФ, далее будет задействована для всех клиентов
// Параметры при этом могут измениться, описание будет позже
Процедура ПоместитьЗадолженностьПоКомиссиямПоСделкамСОтложеннымИсполнениемВМенеждерВременныхТаблиц(ВариантРасчетаОценочнойСтоимости, Организация, СчетДоверительногоУправления, Период, Отказ, МенеджерВременныхТаблиц) Экспорт
		
	ЭтоФОГФ = СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ФОГФ");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Если Не ЭтоФОГФ Тогда
		
		// Подготовим пустую таблицу
		ИзмеренияРегистраЗадолженности 		= Метаданные.РегистрыНакопления.ЗадолженностиПоДенежнымСредствам.Измерения;
		РесурсыРегистраЗадолженности 		= Метаданные.РегистрыНакопления.ЗадолженностиПоДенежнымСредствам.Ресурсы;
		ИзмеренияРегистраЗадолженностиПоЦБ 	= Метаданные.РегистрыНакопления.ЗадолженностиПоЦеннымБумагам.Измерения;
			
		ТаблицаКомиссий = Новый ТаблицаЗначений;
		ТаблицаКомиссий.Колонки.Добавить("ТипЗадолженности", 						ИзмеренияРегистраЗадолженности.ТипЗадолженности.Тип);
		ТаблицаКомиссий.Колонки.Добавить("ВидЗадолженности", 						ИзмеренияРегистраЗадолженности.ВидЗадолженности.Тип);
		ТаблицаКомиссий.Колонки.Добавить("ОснованиеЗадолженности", 					ИзмеренияРегистраЗадолженности.Основание.Тип);
		ТаблицаКомиссий.Колонки.Добавить("Валюта", 									ИзмеренияРегистраЗадолженности.Валюта.Тип);
		ТаблицаКомиссий.Колонки.Добавить("Контрагент", 								ИзмеренияРегистраЗадолженности.Контрагент.Тип);
		ТаблицаКомиссий.Колонки.Добавить("КонтрагентКраткоеНаименованиеПоУставу", 	Новый ОписаниеТипов("Строка"));
		ТаблицаКомиссий.Колонки.Добавить("ОжидаемыеСредства", 						РесурсыРегистраЗадолженности.Сумма.Тип);
		ТаблицаКомиссий.Колонки.Добавить("БлокированныеСредства", 					РесурсыРегистраЗадолженности.Сумма.Тип);
		ТаблицаКомиссий.Колонки.Добавить("СредстваВВалютеУчета", 					РесурсыРегистраЗадолженности.Сумма.Тип);
		ТаблицаКомиссий.Колонки.Добавить("ОснованиеЗадолженностиРасшифровка", 		ИзмеренияРегистраЗадолженности.Основание.Тип);
		ТаблицаКомиссий.Колонки.Добавить("ЦеннаяБумага", 							ИзмеренияРегистраЗадолженностиПоЦБ.ЦеннаяБумага.Тип);
		ТаблицаКомиссий.Колонки.Добавить("ВидЗадолженностиНаименование", 			Новый ОписаниеТипов("Строка"));
		
		СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаКомиссий, "_КомиссияПоСделкамСОтложеннымИсполнением", МенеджерВременныхТаблиц); 
							
		Возврат;
		
	КонецЕсли; 	
	
	Запрос.Текст =	
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская) КАК ТипЗадолженности,
	    |	ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности КАК ВидЗадолженности,
	    |	&ВалютаУчета КАК Валюта,
	    |	ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход КАК ОжидаемыеСредства,
	    |	0 КАК БлокированныеСредства,
	    |	ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход * _КурсыВалют.Курс КАК СредстваВВалютеУчета,
	    |	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КонтрагентКраткоеНаименованиеПоУставу,
	    |	ЗадолженностиПоДенежнымСредствамОбороты.Контрагент КАК Контрагент,
	    |	ЗадолженностиПоДенежнымСредствамОбороты.Основание КАК ОснованиеЗадолженности,
	    |	ЗадолженностиПоДенежнымСредствамОбороты.Основание КАК ОснованиеЗадолженностиРасшифровка,
	    |	NULL КАК ЦеннаяБумага,
	    |	ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности.Наименование КАК ВидЗадолженностиНаименование
	    |ПОМЕСТИТЬ _КомиссияПоСделкамСОтложеннымИсполнением
	    |ИЗ
	    |	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
	    |			,
	    |			&Период,
	    |			,
	    |			Организация = &Организация
	    |				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	    |				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
	    |				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))) КАК ЗадолженностиПоДенежнымСредствамОбороты
	    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделок.СрезПоследних(
	    |				&Период,
	    |				Организация = &Организация
	    |					И Сделка.СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК УсловияСделокСрезПоследних
	    |		ПО ЗадолженностиПоДенежнымСредствамОбороты.Основание = УсловияСделокСрезПоследних.Сделка
	    |			И (УсловияСделокСрезПоследних.ОтложенноеИсполнение)
	    |			И (УсловияСделокСрезПоследних.ДатаИсполнения > &Период)
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
	    |				&Период,
	    |				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
	    |					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
	    |		ПО ЗадолженностиПоДенежнымСредствамОбороты.Контрагент = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалют
	    |		ПО ЗадолженностиПоДенежнымСредствамОбороты.Валюта = _КурсыВалют.Валюта";
	
	Запрос.УстановитьПараметр("Период", 						КонецДня(Период));
	Запрос.УстановитьПараметр("ПериодНачалоДня",	 			НачалоДня(Период));
	Запрос.УстановитьПараметр("Организация", 					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВалютаУчета", 					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета"));
	
	Запрос.Выполнить();	

КонецПроцедуры

Процедура ПолучитьЗадолженностиПоСделкамСОтложеннымИсполнением(ВариантРасчетаОценочнойСтоимости, Организация, СчетДоверительногоУправления, Период, ТаблицаСтоимостей, Отказ, МенеджерВременныхТаблиц, ПараметрыОценки = Неопределено) Экспорт

	МассивИсходныхВТ = СистемныеФункции.ПолучитьИменаВременныхТаблицЗапроса(МенеджерВременныхТаблиц);
	МассивИсходныхВТ.Добавить("_СделкиСОтложеннымИсполнением");
	
	ЕстьОшибки = Ложь;
	
	// Варианты	
	
	ВариантРасчетаЗадолженности = Неопределено;
	
	Если ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Сургутнефтегаз2018 И Период >= '20200101'
		ИЛИ СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ДостойноеБудущееСС") 
				И Период >= '20210630' И Период < РегистрыСведений.НастройкиФормированияСЧА.ДатаНачалаИспользованияНастроекУчетнойПолитикиЕПСПриРасчетеСЧА()
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ВСК
		ИЛИ Период <= '20220128'
			И (ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Сургутнефтегаз2020
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Большой		
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Эволюция2021_2)
		ИЛИ Период >= '20220218'
			И (Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ")
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПФР2020
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ХантыМансийский2020
				ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Традиция2019)
			И РаботаСПереоценкой.ОпределитьНастройкиОценки(Период, Организация, СчетДоверительногоУправления, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении).ВыполнятьРасчетПоПисьмуЦБ0185316
		ИЛИ Период >= '20260227' 
			И ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Сургутнефтегаз2020
			И КонецКвартала(Период) <> КонецДня(Период)
			// У СНГ с 27.02.2026 оценивать сделки Т+ нужно только в последний календарный день квартала	
	Тогда
	
		// Временное отключение расчета для методики Сургутнефтегаз2018 с 01.01.2020, Сургутнефтегаз2020 (#297789),
		// Достойное Будущее СС с 30.06.2021 (#382099),
		// Большой (#395255)
		// Также в явном виде добавлены методики Будущее2020 и Эволюция2021_2, по которым задолженность тоже не рассчитывалась
		// #417729: временно отключаем всех клиентов Траста, а также ПФР, Волга-Капитал, ХМ РЭМ, которые оцениваются по указу ЦБ РФ № 6073-У
		
		ВариантРасчетаЗадолженности = "НеРассчитывать";
		
	ИначеЕсли ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2018
  		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Транснефть2020
  		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Аквилон
  		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ППА2018
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2019
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020_2
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Аквилон2021
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Стройкомплекс2021
		ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Стройкомплекс2018 И Период >= '20180126'
