			|ИЗ
			|	_Объединение КАК _Объединение";
		
		#КонецОбласти

	КонецЕсли;
	
	// Выполняем запрос, удаляем служебные таблицы и формируем результат
	
	Запрос.Выполнить();
	
	УдалитьЛишниеВТ(МенеджерВременныхТаблиц, МассивИсходныхВТ);		
	
КонецПроцедуры

Процедура ПоместитьСправедливыеСтоимостиВМенеджерВременныхТаблиц(Запрос, ВариантРасчетаОценочнойСтоимости, РасчетПартий = Неопределено)

	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_СправедливаяСтоимостьЦенныхБумаг") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ДанныеПартии КАК ДанныеПартии,
		|	_СправедливаяСтоимостьЦенныхБумаг.Рынок КАК Рынок,
		|	_СправедливаяСтоимостьЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_СправедливаяСтоимостьЦенныхБумаг.ТипЗадолженности КАК ТипЗадолженности,
		|	_СправедливаяСтоимостьЦенныхБумаг.Количество КАК Количество,
		|	_СправедливаяСтоимостьЦенныхБумаг.Цена КАК СправедливаяЦена,
		|	_СправедливаяСтоимостьЦенныхБумаг.ЦенаКупона КАК СправедливаяЦенаКупона,
		|	_СправедливаяСтоимостьЦенныхБумаг.ВидЦены КАК ВидЦены,
		|	_СправедливаяСтоимостьЦенныхБумаг.ВалютаКотировки КАК ВалютаКотировки,
		|	_СправедливаяСтоимостьЦенныхБумаг.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	_СправедливаяСтоимостьЦенныхБумаг.СуммаКупонаВВалютеУчета КАК СуммаКупонаВВалютеУчета,
		|	_СправедливаяСтоимостьЦенныхБумаг.УровеньОценки КАК УровеньОценки,
		|	ВЫБОР
		|		КОГДА _СправедливаяСтоимостьЦенныхБумаг.ВалютаКотировки = &ВалютаУчета
		|			ТОГДА _СправедливаяСтоимостьЦенныхБумаг.Цена
		|		КОГДА _СправедливаяСтоимостьЦенныхБумаг.Количество = 0
		|			ТОГДА 0
		|		ИНАЧЕ _СправедливаяСтоимостьЦенныхБумаг.СуммаВВалютеУчета / _СправедливаяСтоимостьЦенныхБумаг.Количество
		|	КОНЕЦ КАК СправедливаяЦенаВВалютеУчета,
		|	ВЫБОР
		|		КОГДА _СправедливаяСтоимостьЦенныхБумаг.Количество = 0
		|			ТОГДА 0
		|		ИНАЧЕ _СправедливаяСтоимостьЦенныхБумаг.СуммаКупонаВВалютеУчета / _СправедливаяСтоимостьЦенныхБумаг.Количество
		|	КОНЕЦ КАК СправедливаяЦенаКупонаВВалютеУчета
		|ПОМЕСТИТЬ _СправедливаяСтоимостьЦенныхБумаг
		|ИЗ
		|	&ТаблицаРегистрацииСтоимостиПереоценки КАК _СправедливаяСтоимостьЦенныхБумаг";

	ПоляПартий = "";
	
	Если РасчетПартий <> Неопределено Тогда
		
		Если ВариантРасчетаОценочнойСтоимости <> Справочники.ВариантыРасчетаОценочнойСтоимости.РПИ
			И ВариантРасчетаОценочнойСтоимости <> Справочники.ВариантыРасчетаОценочнойСтоимости.ЛонгТермИнвестментс
		Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				"Привязка стоимости к партиям пока НЕ реализована для методик кроме РПИ. Необходимо протянуть стоимости покупки в продажи РЕПО. Обратитесь к программистам");
		КонецЕсли;
		
		ПоляПартий =
			"	_СправедливаяСтоимостьЦенныхБумаг.Основание КАК Основание,
			|	_СправедливаяСтоимостьЦенныхБумаг.Партия КАК Партия,
			|	_СправедливаяСтоимостьЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,";
	
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДанныеПартии КАК ДанныеПартии,", ПоляПартий);
	
	Запрос.Выполнить();
		
КонецПроцедуры

Процедура ПоместитьКурсыВалютВМенеджерВременныхТаблиц(Запрос, ДатаКурса) Экспорт

	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_КурсыВалют") <> Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КурсыВалют.Период КАК Период,
		|	КурсыВалют.Валюта КАК Валюта,
		|	КурсыВалют.Курс / КурсыВалют.Кратность КАК Курс
		|ПОМЕСТИТЬ _КурсыВалют
		|ИЗ
		|	РегистрСведений.КурсыВалют КАК КурсыВалют
		|ГДЕ
		|	КурсыВалют.Период = &ДатаКурса
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Валюта,
		|	Период";
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ПлановыеДанные_Операции") = Неопределено Тогда
		Запрос.УстановитьПараметр("ДатаКурса", НачалоДня(ДатаКурса));
	Иначе
		Запрос.УстановитьПараметр("ДатаКурса", НачалоДня(ТекущаяДатаСеанса())); // #Техдолг потому как вообще не очевидно
	КонецЕсли; 
	
	Запрос.Выполнить();		

КонецПроцедуры

Процедура ПоместитьОстаткиДенежныхСредствВМенеджерВременныхТаблиц(Запрос, Отбор = "") Экспорт

	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ОстаткиДенежныхСредствОстаткиБезОтборов") = Неопределено Тогда

		#Область Получение_остатков_денежных_средств_без_отборов
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОстаткиДенежныхСредствОстатки.Брокер КАК Брокер,
			|	ОстаткиДенежныхСредствОстатки.МестоХранения КАК МестоХранения,
			|	ОстаткиДенежныхСредствОстатки.РасчетныйСчет КАК РасчетныйСчет,
			|	ОстаткиДенежныхСредствОстатки.Валюта КАК Валюта,
			|	ОстаткиДенежныхСредствОстатки.СуммаОстаток КАК СуммаОстаток
			|ПОМЕСТИТЬ _ОстаткиДенежныхСредствОстаткиБезОтборов
			|ИЗ
			|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиДенежныхСредствОстатки";
		
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ПлановыеДанные_ОстаткиДС") <> Неопределено Тогда
			
			#Область Дополнение_плановыми_данными
			
			// Меняем псевдоним временной таблицы,
			// объединяем выборку из регистра с плановыми данными,
			// группируем и помещаем в ВТ
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ _ОстаткиДенежныхСредствОстаткиБезОтборов", "ПОМЕСТИТЬ _ОстаткиДенежныхСредствОстаткиСПлановымиДанными");
			Запрос.Текст = Запрос.Текст + 
				"
				|	ОБЪЕДИНИТЬ ВСЕ
				|
				|";
			
			Запрос.Текст = Запрос.Текст + 
				"ВЫБРАТЬ
				|	_ПлановыеДанные.Брокер КАК Брокер,
				|	_ПлановыеДанные.МестоХранения КАК МестоХранения,
				|	_ПлановыеДанные.РасчетныйСчет КАК РасчетныйСчет,
				|	_ПлановыеДанные.Валюта КАК Валюта,
				|	_ПлановыеДанные.Сумма КАК Сумма
				|ИЗ
				|	_ПлановыеДанные_ОстаткиДС КАК _ПлановыеДанные
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ОстаткиДенежныхСредствОстаткиСПлановымиДанными.Брокер КАК Брокер,
				|	_ОстаткиДенежныхСредствОстаткиСПлановымиДанными.МестоХранения КАК МестоХранения,
				|	_ОстаткиДенежныхСредствОстаткиСПлановымиДанными.РасчетныйСчет КАК РасчетныйСчет,
				|	_ОстаткиДенежныхСредствОстаткиСПлановымиДанными.Валюта КАК Валюта,
				|	СУММА(_ОстаткиДенежныхСредствОстаткиСПлановымиДанными.СуммаОстаток) КАК СуммаОстаток
				|ПОМЕСТИТЬ _ОстаткиДенежныхСредствОстаткиБезОтборов
				|ИЗ
				|	_ОстаткиДенежныхСредствОстаткиСПлановымиДанными КАК _ОстаткиДенежныхСредствОстаткиСПлановымиДанными
				|
				|СГРУППИРОВАТЬ ПО
				|	_ОстаткиДенежныхСредствОстаткиСПлановымиДанными.Брокер,
				|	_ОстаткиДенежныхСредствОстаткиСПлановымиДанными.МестоХранения,
				|	_ОстаткиДенежныхСредствОстаткиСПлановымиДанными.РасчетныйСчет,
				|	_ОстаткиДенежныхСредствОстаткиСПлановымиДанными.Валюта
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|УНИЧТОЖИТЬ _ОстаткиДенежныхСредствОстаткиСПлановымиДанными";
			
			#КонецОбласти
			
		КонецЕсли;
		
		Запрос.Выполнить();
		
		#КонецОбласти
		
	КонецЕсли;
	
	ПоместитьТаблицуСОтборомВМенеджерВременныхТаблиц(Запрос, "_ОстаткиДенежныхСредствОстаткиБезОтборов", "_ОстаткиДенежныхСредствОстатки", Отбор);	
	
КонецПроцедуры

Процедура ПоместитьОстаткиЦенныхБумагВМенеджерВременныхТаблиц(Запрос, Отбор = "", РасчетПартий = Неопределено) Экспорт

