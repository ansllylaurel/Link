				|ПОМЕСТИТЬ _КонечныеОстаткиПартий
				|ИЗ
				|	&КонечныеОстаткиПартий КАК КонечныеОстаткиПартий
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	КонечныеОстаткиПартийКупленныхПоРЕПО.Рынок КАК Рынок,
				|	КонечныеОстаткиПартийКупленныхПоРЕПО.ЦеннаяБумага КАК ЦеннаяБумага,
				|	КонечныеОстаткиПартийКупленныхПоРЕПО.Партия КАК Партия,
				|	КонечныеОстаткиПартийКупленныхПоРЕПО.СтрокаПартии КАК СтрокаПартии,
				|	КонечныеОстаткиПартийКупленныхПоРЕПО.Количество КАК КоличествоОстаток
				|ПОМЕСТИТЬ _КонечныеОстаткиПартийКупленныхПоРЕПО
				|ИЗ
				|	&КонечныеОстаткиПартийКупленныхПоРЕПО КАК КонечныеОстаткиПартийКупленныхПоРЕПО
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	КонечныеОстаткиПартий.Рынок КАК Рынок,
				|	КонечныеОстаткиПартий.ЦеннаяБумага КАК ЦеннаяБумага,
				|	КонечныеОстаткиПартий.Партия КАК Партия,
				|	КонечныеОстаткиПартий.СтрокаПартии КАК СтрокаПартии,
				|	КонечныеОстаткиПартий.КоличествоОстаток КАК КоличествоОстаток
				|ПОМЕСТИТЬ _ОстаткиЦенныхБумагОстаткиБезОтборов
				|ИЗ
				|	_КонечныеОстаткиПартий КАК КонечныеОстаткиПартий
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	КонечныеОстаткиПартийКупленныхПоРЕПО.Рынок,
				|	КонечныеОстаткиПартийКупленныхПоРЕПО.ЦеннаяБумага,
				|	КонечныеОстаткиПартийКупленныхПоРЕПО.Партия,
				|	КонечныеОстаткиПартийКупленныхПоРЕПО.СтрокаПартии,
				|	КонечныеОстаткиПартийКупленныхПоРЕПО.КоличествоОстаток
				|ИЗ
				|	_КонечныеОстаткиПартийКупленныхПоРЕПО КАК КонечныеОстаткиПартийКупленныхПоРЕПО
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|УНИЧТОЖИТЬ _КонечныеОстаткиПартий
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|УНИЧТОЖИТЬ _КонечныеОстаткиПартийКупленныхПоРЕПО";
			
			Запрос.УстановитьПараметр("КонечныеОстаткиПартий",					РасчетПартий.КонечныеОстаткиПартий);
			Запрос.УстановитьПараметр("КонечныеОстаткиПартийКупленныхПоРЕПО",	РасчетПартий.КонечныеОстаткиПартийКупленныхПоРЕПО);
			
