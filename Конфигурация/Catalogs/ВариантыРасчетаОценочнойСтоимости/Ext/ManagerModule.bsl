		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|	КОНЕЦ КАК ТипЗадолженности,
		|	ВложенныйЗапрос.ВидЗадолженности КАК ВидЗадолженности,
		|	ВложенныйЗапрос.ОснованиеЗадолженности КАК ОснованиеЗадолженности,
		|	ВложенныйЗапрос.Контрагент КАК Контрагент,
		|	ВЫБОР
		|		КОГДА ВложенныйЗапрос.Сумма > 0
		|			ТОГДА ВложенныйЗапрос.Сумма
		|		ИНАЧЕ -ВложенныйЗапрос.Сумма
		|	КОНЕЦ КАК Сумма,
		|	ВложенныйЗапрос.Валюта КАК Валюта,
		|	ПОДСТРОКА(ВидыЗадолженности.Наименование, 1, 150) КАК ВидЗадолженностиНаименование,
		|	ВЫБОР
		|		КОГДА ВложенныйЗапрос.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|				И ВложенныйЗапрос.Сумма > 0
		|			ТОГДА УсловияСделокСрезПоследних.ДатаОплаты
		|		КОГДА ВложенныйЗапрос.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|				И ВложенныйЗапрос.Сумма < 0
		|			ТОГДА УсловияСделокСрезПоследних.ДатаПоставки
		|		КОГДА ВложенныйЗапрос.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделкеСНедвижимостью)
		|				И ВложенныйЗапрос.Сумма > 0
		|			ТОГДА ГрафикПлатежаПоСделкеСНедвижимостью.ДатаПлатежа
		|		ИНАЧЕ ВложенныйЗапрос.ПлановаяДатаПередачиНедвижимости
		|	КОНЕЦ КАК ДатаПогашения
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВложенныйЗапрос.ТипЗадолженности КАК ТипЗадолженности,
		|		ВложенныйЗапрос.ВидЗадолженности КАК ВидЗадолженности,
		|		ВложенныйЗапрос.ОснованиеЗадолженности КАК ОснованиеЗадолженности,
		|		СУММА(ВложенныйЗапрос.Сумма) КАК Сумма,
		|		МАКСИМУМ(ВложенныйЗапрос.ПлановаяДатаПередачиНедвижимости) КАК ПлановаяДатаПередачиНедвижимости,
		|		ВложенныйЗапрос.Валюта КАК Валюта,
		|		ВложенныйЗапрос.Контрагент КАК Контрагент
		|	ИЗ
		|		(ВЫБРАТЬ
		|			ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|			ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|			ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК ОснованиеЗадолженности,
		|			ВЫБОР
		|				КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделкеСНедвижимостью)
		|					ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.Контрагент
		|				ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			КОНЕЦ КАК Контрагент,
		|			ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК Сумма,
		|			ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
		|			ДАТАВРЕМЯ(1, 1, 1) КАК ПлановаяДатаПередачиНедвижимости
		|		ИЗ
		|			_ЗадолженностиПоДенежнымСредствамОстатки КАК ЗадолженностиПоДенежнымСредствамОстатки
		|		ГДЕ
		|			(ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|					ИЛИ ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделкеСНедвижимостью))
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			ВЫБОР
		|				КОГДА ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|				ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			КОНЕЦ,
		|			ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности,
		|			ЗадолженностиПоЦеннымБумагамОстатки.Основание,
		|			ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка),
		|			-ЗадолженностиПоЦеннымБумагамОстатки.СуммаОстаток - ЗадолженностиПоЦеннымБумагамОстатки.СуммаКупонаОстаток,
		|			ЗадолженностиПоЦеннымБумагамОстатки.Валюта,
		|			ДАТАВРЕМЯ(1, 1, 1)
		|		ИЗ
		|			_ЗадолженностиПоЦеннымБумагамОстатки КАК ЗадолженностиПоЦеннымБумагамОстатки
		|		ГДЕ
		|			ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			ВЫБОР
		|				КОГДА СделкаСНедвижимостью.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|				ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			КОНЕЦ,
		|			ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделкеСНедвижимостью),
		|			УсловияСделокСНедвижимостьюСрезПоследних.Основание,
		|			СделкаСНедвижимостью.Контрагент,
		|			-УсловияСделокСНедвижимостьюСрезПоследних.Сумма,
		|			&ВалютаРубли,
		|			УсловияСделокСНедвижимостьюСрезПоследних.ПлановаяДатаПередачи
		|		ИЗ
		|			РегистрСведений.УсловияСделокСНедвижимостью.СрезПоследних(
		|					&Период,
		|					(Организация, СчетДоверительногоУправления, Основание) В
		|						(ВЫБРАТЬ
		|							СделкаСНедвижимостью.Организация КАК Организация,
		|							СделкаСНедвижимостью.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|							СделкаСНедвижимостью.Ссылка КАК Ссылка
		|						ИЗ
		|							Документ.СделкаСНедвижимостью КАК СделкаСНедвижимостью
		|						ГДЕ
		|							СделкаСНедвижимостью.ВидПраваНаНедвижимость = ЗНАЧЕНИЕ(Перечисление.ВидыПравНаНедвижимость.Собственность)
		|							И СделкаСНедвижимостью.Организация = &Организация
		|							И СделкаСНедвижимостью.СчетДоверительногоУправления = &СчетДоверительногоУправления)) КАК УсловияСделокСНедвижимостьюСрезПоследних
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаСНедвижимостью КАК СделкаСНедвижимостью
		|				ПО УсловияСделокСНедвижимостьюСрезПоследних.Основание = СделкаСНедвижимостью.Ссылка
		|					И (НЕ УсловияСделокСНедвижимостьюСрезПоследних.Отменено)
		|					И (УсловияСделокСНедвижимостьюСрезПоследних.АктПриемаПередачи = ЗНАЧЕНИЕ(Документ.АктПриемаПередачиОбъектовНедвижимости.ПустаяСсылка))
		|					И (УсловияСделокСНедвижимостьюСрезПоследних.СведенияОГосРегистрацииПраваСобственности = ЗНАЧЕНИЕ(Документ.СведенияОРегистрацииПраваСобственности.ПустаяСсылка))) КАК ВложенныйЗапрос
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ВложенныйЗапрос.Валюта,
		|		ВложенныйЗапрос.ОснованиеЗадолженности,
		|		ВложенныйЗапрос.ВидЗадолженности,
		|		ВложенныйЗапрос.ТипЗадолженности,
		|		ВложенныйЗапрос.Контрагент
		|	
		|	ИМЕЮЩИЕ
		|		СУММА(ВложенныйЗапрос.Сумма) <> 0) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			УсловияСделокСрезПоследних.Сделка КАК Сделка,
		|			МАКСИМУМ(УсловияСделокСрезПоследних.ДатаОплаты) КАК ДатаОплаты,
		|			МАКСИМУМ(УсловияСделокСрезПоследних.ДатаПоставки) КАК ДатаПоставки
		|		ИЗ
		|			РегистрСведений.УсловияСделок.СрезПоследних(
		|					&КонецПериода,
		|					Организация = &Организация
		|						И Сделка В
		|							(ВЫБРАТЬ
		|								ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Сделка
		|							ИЗ
		|								_ЗадолженностиПоДенежнымСредствамОстатки КАК ЗадолженностиПоДенежнымСредствамОстатки
		|							ГДЕ
		|								ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|					
		|							ОБЪЕДИНИТЬ ВСЕ
		|					
		|							ВЫБРАТЬ
		|								ЗадолженностиПоЦеннымБумагамОстатки.Основание
		|							ИЗ
		|								_ЗадолженностиПоЦеннымБумагамОстатки КАК ЗадолженностиПоЦеннымБумагамОстатки
		|							ГДЕ
		|								ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке))) КАК УсловияСделокСрезПоследних
		|		ГДЕ
		|			НЕ УсловияСделокСрезПоследних.Отменено
		|		
		|		СГРУППИРОВАТЬ ПО
		|			УсловияСделокСрезПоследних.Сделка) КАК УсловияСделокСрезПоследних
		|		ПО ВложенныйЗапрос.ОснованиеЗадолженности = УсловияСделокСрезПоследних.Сделка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыЗадолженности КАК ВидыЗадолженности
		|		ПО ВложенныйЗапрос.ВидЗадолженности = ВидыЗадолженности.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			МАКСИМУМ(ГрафикиПлатежейСрезПоследних.ДатаПлатежа) КАК ДатаПлатежа,
		|			ГрафикиПлатежейСрезПоследних.Основание КАК Основание
		|		ИЗ
		|			РегистрСведений.ГрафикиПлатежей.СрезПоследних(
		|					&Период,
		|					Организация = &Организация
		|						И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ГрафикиПлатежейСрезПоследних
		|		ГДЕ
		|			ГрафикиПлатежейСрезПоследних.Действует
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ГрафикиПлатежейСрезПоследних.Основание) КАК ГрафикПлатежаПоСделкеСНедвижимостью
		|		ПО ВложенныйЗапрос.ОснованиеЗадолженности = ГрафикПлатежаПоСделкеСНедвижимостью.Основание";
	
#КонецОбласти	
	
	ЗадолженностиПоСделкамСРаздельнымИсполнением = Запрос.Выполнить().Выгрузить();
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ЗадолженностиПоСделкамСРаздельнымИсполнением, "_ЗадолженностиПоСделкамСРаздельнымИсполнением", МенеджерВременныхТаблиц);
	
	УдалитьЛишниеВТ(МенеджерВременныхТаблиц, МассивИсходныхВТ);
	
КонецПроцедуры
	
#КонецОбласти

#Область Оценка_задолженностей_по_сделкам_РЕПО

Процедура ПолучитьЗадолженностиПоСделкамРЕПО(ВариантРасчетаОценочнойСтоимости, Организация, СчетДоверительногоУправления, Период, ТаблицаСтоимостей, ЦельРасчета, РасчетПартий, НастройкиФормированияСЧА, Отказ, МенеджерВременныхТаблиц, ПараметрыОценки = Неопределено) Экспорт
	
	НастройкиСделокРЕПО = ПараметрыРасчетаЗадолженностиПоСделкамРЕПО(Организация, СчетДоверительногоУправления, ВариантРасчетаОценочнойСтоимости, Период, НастройкиФормированияСЧА);
	          
	Если НастройкиСделокРЕПО = Неопределено Тогда		
		Возврат;
	КонецЕсли;	
		
	ЕстьОшибки = Ложь;
	
	Если НастройкиФормированияСЧА.ИспользоватьНастройкиУчетнойПолитикиЕПС Тогда
		
		НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(Период,
			Организация,
			СчетДоверительногоУправления,
			Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет,
			ЕстьОшибки);
		
		Если ЕстьОшибки Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствуют настройки у %1 по виду учета 'Единый бухгалтерский учет' на %2!", СчетДоверительногоУправления, Формат(Период, "ДФ=dd.MM.yyyy")));			
			Возврат;
		КонецЕсли;
		
		ВариантРасчетаПроцентовПоСделкамРЕПО 	= НастройкиПоВидуУчета.ВариантРасчетаПроцентовПоСделкамРЕПО; 		
		ТочностьРасчетнойСтавкиРЕПО 			= 8; // В ЕПС точность не задается параметром, присваиваем точность по умолчанию
		
	Иначе
		ВариантРасчетаПроцентовПоСделкамРЕПО 	= НастройкиФормированияСЧА.ВариантРасчетаПроцентовПоСделкамРЕПО;
		ТочностьРасчетнойСтавкиРЕПО 			= НастройкиФормированияСЧА.ТочностьРасчетнойСтавкиРЕПО;	
	КонецЕсли;	
	
	МассивИсходныхВТ = СистемныеФункции.ПолучитьИменаВременныхТаблицЗапроса(МенеджерВременныхТаблиц);
	МассивИсходныхВТ.Добавить("_СделкиРЕПО"); 
	
	// Расчет	
	Если НастройкиСделокРЕПО.ВариантРасчетаЗадолженности = "РазницаСуммыСделкиИСправедливойСтоимостиБумаг" Тогда
		
		#Область Разница_суммы_сделки_и_справедливой_стоимости_бумаг
		
		// Определение справедливой стоимости ценных бумаг
		
		ТипыЗадолженностейПоЦеннымБумагам = Новый Массив;
		ТипыЗадолженностейПоЦеннымБумагам.Добавить(Перечисления.ТипыЗадолженности.Дебиторская);
		ТипыЗадолженностейПоЦеннымБумагам.Добавить(Перечисления.ТипыЗадолженности.Кредиторская);
		
		ПараметрыПолученияОстатков = Новый Структура; 
		ПараметрыПолученияОстатков.Вставить("ОстаткиЦенныхБумаг",					Ложь);
		ПараметрыПолученияОстатков.Вставить("ТипыЗадолженностейПоЦеннымБумагам",	ТипыЗадолженностейПоЦеннымБумагам);
		ПараметрыПолученияОстатков.Вставить("ЗадолженностиПоВторойЧастиРЕПО",		Истина);
		ПараметрыПолученияОстатков.Вставить("НеУчитыватьЦБКупленныеПоРЕПО",			Истина);
		ПараметрыПолученияОстатков.Вставить("УчитыватьЦБПроданныеВРЕПО",			Истина);
		
		ПараметрыПолученияПартий = РаботаСПереоценкой.ПолучитьПараметрыПолученияПартийПоМетодике(
			Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении,
			РаботаСПереоценкой.ОпределитьВидУчета(Организация, СчетДоверительногоУправления, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении, Период),   
			ВариантРасчетаОценочнойСтоимости,
			Период, , СчетДоверительногоУправления);    
		
		ТаблицаРегистрацииСтоимостиПереоценки = ПолучитьСтоимостиЦенныхБумаг(
			ВариантРасчетаОценочнойСтоимости, Организация, СчетДоверительногоУправления, Период, ЕстьОшибки,
			ПараметрыПолученияОстатков, ПараметрыПолученияПартий, ?(ТаблицаСтоимостей = Неопределено, Неопределено, ТаблицаСтоимостей), РасчетПартий, , , , ПараметрыОценки);
		
		Если ЕстьОшибки Тогда
			Отказ = Истина;		
			УдалитьЛишниеВТ(МенеджерВременныхТаблиц, МассивИсходныхВТ);
			Возврат;
		КонецЕсли;
		
		// Расчет задолженности
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
		Запрос.УстановитьПараметр("Период",												КонецДня(Период));
		Запрос.УстановитьПараметр("Организация",										Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления",						СчетДоверительногоУправления);
		
		Запрос.УстановитьПараметр("ВалютаУчета",										ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета"));
		Запрос.УстановитьПараметр("ТаблицаРегистрацииСтоимостиПереоценки",				ТаблицаРегистрацииСтоимостиПереоценки);	
		Запрос.УстановитьПараметр("УчитыватьЗадолженностьПоЦБКупленнойПоРЕПО",			НастройкиСделокРЕПО.УчитыватьЗадолженностьПоЦБКупленнойПоРЕПО);
		Запрос.УстановитьПараметр("УчитыватьКупон",										Истина);
		Запрос.УстановитьПараметр("ВыделятьКупонИзЗадолженностиПоЦБКупленнойПоРЕПО",	(Период >= '20180930'));
		
		ПоместитьКурсыВалютВМенеджерВременныхТаблиц(Запрос, Период);
		ПоместитьЗадолженностиПоВторойЧастиРЕПОВМенеджерВременныхТаблиц(Запрос);
		ПоместитьЗадолженностиПоЦеннымБумагамВМенеджерВременныхТаблиц(Запрос, 
			"_ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
			|				И (_ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская) 
			|					ИЛИ _ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская))");
		ПоместитьСправедливыеСтоимостиВМенеджерВременныхТаблиц(Запрос, ВариантРасчетаОценочнойСтоимости, РасчетПартий);
		
		Если ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФондФилософии
			ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФОГФ
		Тогда
		
			Запрос.Текст = "				
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_СправедливаяСтоимостьЦенныхБумаг.*, 
				|	Неопределено  КАК Основание
				|ПОМЕСТИТЬ _СправедливаяСтоимостьЦенныхБумагРЕПО
				|ИЗ
				|	_СправедливаяСтоимостьЦенныхБумаг КАК _СправедливаяСтоимостьЦенныхБумаг
				|;";
			
			Запрос.Выполнить();
			
			Запрос.УстановитьПараметр("УчитыватьПартииБумагРЕПО",	Ложь);
			
		Иначе
			//свернем партии и строки партий
			Запрос.Текст = "				
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_СправедливаяСтоимостьЦенныхБумаг.Рынок КАК Рынок,
				|	_СправедливаяСтоимостьЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
				|	СУММА(_СправедливаяСтоимостьЦенныхБумаг.Количество) КАК Количество,
				|	СУММА(_СправедливаяСтоимостьЦенныхБумаг.СуммаВВалютеУчета) КАК СуммаВВалютеУчета,
				|	СУММА(_СправедливаяСтоимостьЦенныхБумаг.СуммаКупонаВВалютеУчета) КАК СуммаКупонаВВалютеУчета,
				|	_СправедливаяСтоимостьЦенныхБумаг.СправедливаяЦена КАК СправедливаяЦена,
				|	МАКСИМУМ(_СправедливаяСтоимостьЦенныхБумаг.СправедливаяЦенаКупона) КАК СправедливаяЦенаКупона,
				|	МАКСИМУМ(_СправедливаяСтоимостьЦенныхБумаг.СправедливаяЦенаКупонаВВалютеУчета) КАК СправедливаяЦенаКупонаВВалютеУчета,
				|	_СправедливаяСтоимостьЦенныхБумаг.ВалютаКотировки КАК ВалютаКотировки,
				|	_СправедливаяСтоимостьЦенныхБумаг.Основание КАК Основание,
				|	_СправедливаяСтоимостьЦенныхБумаг.ТипЗадолженности КАК ТипЗадолженности
				|ПОМЕСТИТЬ _СправедливаяСтоимостьЦенныхБумагРЕПО
				|ИЗ
				|	_СправедливаяСтоимостьЦенныхБумаг КАК _СправедливаяСтоимостьЦенныхБумаг
				|
				|СГРУППИРОВАТЬ ПО
				|	_СправедливаяСтоимостьЦенныхБумаг.Рынок,
				|	_СправедливаяСтоимостьЦенныхБумаг.ЦеннаяБумага,
				|	_СправедливаяСтоимостьЦенныхБумаг.СправедливаяЦена,
				|	_СправедливаяСтоимостьЦенныхБумаг.ВалютаКотировки,
				|	_СправедливаяСтоимостьЦенныхБумаг.Основание,
				|	_СправедливаяСтоимостьЦенныхБумаг.ТипЗадолженности
				|;";
			
			Запрос.Выполнить();
			
			Запрос.УстановитьПараметр("УчитыватьПартииБумагРЕПО",	Истина);
			
		КонецЕсли;
		
		
		#Область Текст_запроса

