				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СправочникСудебныеПроцессы.Ссылка КАК Ссылка,
	СправочникСудебныеПроцессы.ПометкаУдаления КАК ПометкаУдаления,
	СправочникСудебныеПроцессы.Код КАК Код,
	СправочникСудебныеПроцессы.Наименование КАК Наименование,
	СправочникСудебныеПроцессы.Организация КАК Организация,
	СправочникСудебныеПроцессы.СудебноеДело КАК СудебноеДело,
	СправочникСудебныеПроцессы.ДатаНачала КАК ДатаНачала,
	СправочникСудебныеПроцессы.Описание КАК Описание,
	СправочникСудебныеПроцессы.ПоЛицензииУКПИФ КАК ПоЛицензииУКПИФ,
	СправочникСудебныеПроцессы.ПоЛицензииДУ КАК ПоЛицензииДУ,
	СправочникСудебныеПроцессы.ПредметИска КАК ПредметИска,
	СправочникСудебныеПроцессы.НомерИсковогоЗаявления КАК НомерИсковогоЗаявления,
	СправочникСудебныеПроцессы.Предопределенный КАК Предопределенный,
	СправочникСудебныеПроцессы.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	СправочникСудебныеПроцессы.СудебноеДело.НомерДела КАК СудебноеДелоНомерДела,
	РеквизитыСудебныхДелСрезПоследних.СудебныйОрган КАК СудебныйОрган,
	ВидыУчастия.ВидУчастия КАК ВидУчастия,
	НЕ (СудебныеРешенияСрезПоследних.ДатаПрекращения ЕСТЬ NULL
			ИЛИ СудебныеРешенияСрезПоследних.ДатаПрекращения = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ СудебныеРешенияСрезПоследних.ДатаПрекращения &gt; &amp;ТекущаяДата) КАК Прекращено
ИЗ
	Справочник.СудебныеПроцессы КАК СправочникСудебныеПроцессы
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСудебныхДел.СрезПоследних(&amp;ТекущаяДата, ) КАК РеквизитыСудебныхДелСрезПоследних
		ПО СправочникСудебныеПроцессы.СудебноеДело = РеквизитыСудебныхДелСрезПоследних.СудебноеДело
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
			РеквизитыСудебныхПроцессовСрезПоследних.СудебныйПроцесс КАК СудебныйПроцесс,
			РеквизитыСудебныхПроцессовСрезПоследних.ВидУчастия КАК ВидУчастия
		ИЗ
			РегистрСведений.РеквизитыСудебныхПроцессов.СрезПоследних(&amp;ТекущаяДата, ) КАК РеквизитыСудебныхПроцессовСрезПоследних) КАК ВидыУчастия
		ПО СправочникСудебныеПроцессы.Ссылка = ВидыУчастия.СудебныйПроцесс
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СудебныеРешения.СрезПоследних КАК СудебныеРешенияСрезПоследних
		ПО СправочникСудебныеПроцессы.Ссылка = СудебныеРешенияСрезПоследних.СудебныйПроцесс
ГДЕ
	(&amp;ОтображатьПрекращенные = ИСТИНА
			ИЛИ СудебныеРешенияСрезПоследних.ДатаПрекращения ЕСТЬ NULL
			ИЛИ СудебныеРешенияСрезПоследних.ДатаПрекращения = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ СудебныеРешенияСрезПоследних.ДатаПрекращения &gt; &amp;ТекущаяДата)</QueryText>
				<MainTable>Catalog.СудебныеПроцессы</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:item>
							<dcsset:selection/>
							<dcsset:filter>
								<dcsset:item xsi:type="dcsset:FilterItemComparison">
									<dcsset:left xsi:type="dcscor:Field">Прекращено</dcsset:left>
									<dcsset:comparisonType>Equal</dcsset:comparisonType>
									<dcsset:right xsi:type="xs:boolean">true</dcsset:right>
								</dcsset:item>
							</dcsset:filter>
							<dcsset:appearance>
								<dcscor:item xsi:type="dcsset:SettingsParameterValue">
									<dcscor:parameter>ЦветТекста</dcscor:parameter>
									<dcscor:value xsi:type="v8ui:Color">style:НеактуальнаяСтрокаВСпискеЦвет</dcscor:value>
								</dcscor:item>
							</dcsset:appearance>
						</dcsset:item>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
