
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	Договор		= ПараметрКоманды;
	ЭтаФорма	= ПараметрыВыполненияКоманды.Источник;	
	ВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ВидДоговора");
	
	Если НЕ (ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоров.БанковскогоОбслуживания")
		ИЛИ ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоров.БанковскогоДепозита")
		ИЛИ ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоров.ГенСоглашениеПоДепозитнымВкладам")
		ИЛИ ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоров.ДепозитарногоОбслуживания")
		ИЛИ ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СпецДепозитарногоОбслуживания")
		ИЛИ ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоров.РегистрационногоОбслуживания")		
		ИЛИ ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СпецРегистрационногоОбслуживания")
		ИЛИ ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоров.БрокерскогоОбслуживания")
		ИЛИ ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоров.КомплексногоОбслуживания"))
	Тогда
		Предупреждение("Для вида договора """ + ВидДоговора + """ исполнители не определены!");
		Возврат;
	КонецЕсли;	
	
	АдресДереваДочернихЭлементов = РаботаСИсполнителями.ПолучитьДочерниеЭлементы(Договор, , "ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)", , ЭтаФорма.УникальныйИдентификатор);
	Если ЗначениеЗаполнено(АдресДереваДочернихЭлементов) Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВидимыеКолонки",				"Представление");
		ДополнительныеПараметры.Вставить("ОтмеченныеЭлементы",			Новый Структура("Элемент", Договор));
		ДополнительныеПараметры.Вставить("ПолеКлючевогоЗначенияСтроки", "Элемент");
		ДополнительныеПараметры.Вставить("ПутьКДаннымКартинкиСтроки",	"ДеревоЗначений.ДанныеКартинки");
		ДополнительныеПараметры.Вставить("КартинкаСтрок",				БиблиотекаКартинок.РегистрСведенийЗапись);
		
		РезультатВопроса = РаботаСФормамиКлиент.ПоказатьДеревоЗначений(АдресДереваДочернихЭлементов, , ЭтаФорма, "Закрыть", "Закрыть", "Договор", ДополнительныеПараметры);
	КонецЕсли;	
	
КонецПроцедуры
