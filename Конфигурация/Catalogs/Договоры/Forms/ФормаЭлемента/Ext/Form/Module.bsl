
////////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	// Настройки нового договора
	Если Объект.Ссылка.Пустая() Тогда
		
		Если Не ЗначениеЗаполнено(Объект.ВидДоговора)		
			И Параметры.ЗначенияЗаполнения.Свойство("ВидДоговора")
			И ТипЗнч(Параметры.ЗначенияЗаполнения.ВидДоговора) = Тип("ФиксированныйМассив")
		Тогда
			Объект.ВидДоговора = Параметры.ЗначенияЗаполнения.ВидДоговора[0]; 				
		КонецЕсли;
		
		ДополнительныеПараметрыСоздания = Новый Структура("ДатаЗаключения, ДатаРасторжения, СчетДоверительногоУправления, ВидДоговораАренды");
		
		ЗаполнитьЗначенияСвойств(ДополнительныеПараметрыСоздания, Параметры.ДополнительныеПараметры);
		ЗаполнитьЗначенияСвойств(ДополнительныеПараметрыСоздания, Параметры.ЗначенияЗаполнения);
		
		ЗаполнитьЗначенияСвойств(ЭтаФорма,	ДополнительныеПараметрыСоздания, "ДатаРасторжения, СчетДоверительногоУправления, ВидДоговораАренды");
		ЗаполнитьЗначенияСвойств(Объект,	ДополнительныеПараметрыСоздания, "ДатаЗаключения");
		
	КонецЕсли;
	
	ЭтаФорма.ПредКонтрагент = Объект.Контрагент;
	
	ПриЧтенииСозданииНаСервере();
	
	УстановитьОтборыПоВедомымРегистрам(ЭтаФорма);

КонецПроцедуры // ПриСозданииНаСервере

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтаФорма.СвязатьСоСчетомДУ Тогда
		ПроверяемыеРеквизиты.Добавить("СчетДоверительногоУправления");	
	КонецЕсли;
	
	Если ЭтаФорма.ИзменениеВознаграждения И Не ЗначениеЗаполнено(Объект.ДатаИзмененияВознаграждения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена дата изменения вознаграждения", , "Объект.ДатаИзмененияВознаграждения", , Отказ);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ПериодУсловийДопСоглашенияНеРавенДатеЗаключения(Объект.Ссылка, Объект.ДатаЗаключения) Тогда
		Если Вопрос("Период условий доп.соглашения будет изменён на дату заключения. Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если ТекущийОбъект.ЭтоНовый() И ЭтаФорма.СвязатьСоСчетомДУ Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ДоговорСчетаДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления);		
	КонецЕсли;
	
	Если ТекущийОбъект.ЭтоНовый() И ЗначениеЗаполнено(ЭтаФорма.ДатаРасторжения) Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ДатаРасторжения", ЭтаФорма.ДатаРасторжения);		
	КонецЕсли;
	
	Если ТекущийОбъект.ЭтоНовый() И ЗначениеЗаполнено(ЭтаФорма.ВидДоговораАренды) Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ВидДоговораАренды", ЭтаФорма.ВидДоговораАренды);		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	НастроитьВидимостьДоступность(ЭтаФорма);	
	
	УстановитьОтборыПоВедомымРегистрам(ЭтаФорма);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ РЕКВИЗИТОВ ФОРМЫ

&НаКлиенте
Процедура НомерДоговораПриИзменении(Элемент)
	
	РаботаСНормативноСправочнойИнформациейКлиент.УстановитьНовоеНаименование(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	РаботаСНормативноСправочнойИнформациейКлиент.УстановитьНовоеНаименование(Объект);
	
	Если ЗначениеЗаполнено(Объект.Ссылка) 
	   И ЭтаФорма.ПредКонтрагент <> Объект.Контрагент
	   И ОбщегоНазначения.ОбъектИспользуетсяВБазеДанных(Объект.Ссылка) Тогда
		Сообщить("Данный договор используется в объектах базы данных. Посмотреть список таких объектов можно через меню Все Фукнции - Стандартные - Поиск ссылок на объекты.");
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.ПредКонтрагент = Объект.Контрагент;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаЗаключенияПриИзменении(Элемент)
	
	РаботаСНормативноСправочнойИнформациейКлиент.УстановитьНовоеНаименование(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидДоговораПриИзменении(Элемент)
	
	ОчиститьРеквизитыВознаграждения();
	
	НастроитьВидимостьДоступность(ЭтаФорма);	
	
	РаботаСНормативноСправочнойИнформациейКлиент.УстановитьНовоеНаименование(Объект);	
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованиеПриИзменении(Элемент)
	
	ОчиститьРеквизитыВознаграждения();
	
	ОснованиеПриИзмененииНаСервере();
	
	РаботаСНормативноСправочнойИнформациейКлиент.УстановитьНовоеНаименование(Объект);

	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ОснованиеПриИзмененииНаСервере()

	Если ТипЗнч(Объект.Основание) = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды") Тогда
		
		УправляющаяКомпания 	= Справочники.УправляющиеКомпании.ПолучитьУправляющуюКомпаниюПИФНаДату(ТекущаяДатаСеанса(), Объект.Основание);
		Объект.Контрагент 		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УправляющаяКомпания, "ЮрФизЛицо");
		
	ИначеЕсли ТипЗнч(Объект.Основание) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда 
		
		Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(Объект.Основание, ТекущаяДата());
		Если ТипЗнч(Клиент) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
			Объект.Контрагент = Клиент;
		ИначеЕсли ТипЗнч(Клиент) = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды") Тогда
			УправляющаяКомпания 	= Справочники.УправляющиеКомпании.ПолучитьУправляющуюКомпаниюПИФНаДату(ТекущаяДатаСеанса(), Клиент);
			Объект.Контрагент 		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УправляющаяКомпания, "ЮрФизЛицо");
		КонецЕсли;
		
		Если Объект.Ссылка.Пустая() И ЭтаФорма.СвязатьСоСчетомДУ Тогда
			ЭтаФорма.СчетДоверительногоУправления = Объект.Основание;			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Объект.Основание) = Тип("СправочникСсылка.Договоры") Тогда 
		
		Объект.Контрагент = Объект.Основание.Контрагент;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СвязатьСоСчетомДУПриИзменении(Элемент)
	
	НастроитьВидимостьДоступность(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ИзменениеВознагражденияПриИзменении(Элемент)
	
	Если ЭтаФорма.ИзменениеВознаграждения Тогда
		Объект.ДатаИзмененияВознаграждения = Объект.ДатаЗаключения;	
	Иначе
		Объект.ДатаИзмененияВознаграждения = Неопределено;	
	КонецЕсли;
	
	НастроитьВидимостьДоступность(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкиРасчетаВознагражденияНажатие(Элемент)
	
	// Убедимся, что все изменения сохранены
	
	Если ЭтаФорма.Модифицированность Тогда
		
		СохранитьИПродолжить = Вопрос("Внесенные изменения будут сохранены. Продолжить?", РежимДиалогаВопрос.ДаНетОтмена);
		
		Если СохранитьИПродолжить <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		
		Если Не РаботаСФормамиКлиентСервер.ЗаписатьФорму(ЭтаФорма) Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	// Ищем настройки
	
	КлючНастроек = ПолучитьКлючНастроекРасчетаВознаграждения(Объект.Ссылка);
	
	Если КлючНастроек = Неопределено Тогда
		
		ОткрытьНастройки = Вопрос("Настройки расчета вознаграждения, связанные с доп. соглашением, не найдены. Открыть список настроек?", РежимДиалогаВопрос.ДаНет);
		
		Если ОткрытьНастройки = КодВозвратаДиалога.Да Тогда
			
			ОтборНастроек = Новый Структура;
			ОтборНастроек.Вставить("Организация",					Объект.Организация);
			ОтборНастроек.Вставить("СчетДоверительногоУправления",	Объект.Основание);
			ОтборНастроек.Вставить("ВидВознаграждения",				ПредопределенноеЗначение("Перечисление.ВидыВознагражденийУправляющего.ВознаграждениеУправляющего"));
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Отбор", ОтборНастроек);
			
			ОткрытьФорму("РегистрСведений.НастройкиРасчетаВознагражденияУправляющего.ФормаСписка", ПараметрыФормы, ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
		
	Иначе
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", КлючНастроек);
		
		ОткрытьФорму("РегистрСведений.НастройкиРасчетаВознагражденияУправляющего.ФормаЗаписи", ПараметрыФормы, ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВидДокументДляПредставленияДоговорПриИзменении(Элемент)
	
	Если ЭтаФорма.ВидДокументаДляПредставленияДоговор Тогда
		Объект.ВидДокументаДляПредставления = "";
	КонецЕсли;
	
	НастроитьВидимостьДоступность(ЭтаФорма);	
	
	РаботаСНормативноСправочнойИнформациейКлиент.УстановитьНовоеНаименование(Объект);	
	
КонецПроцедуры

&НаКлиенте
Процедура ВидДокументаДляПредставленияПриИзменении(Элемент)
	
	РаботаСНормативноСправочнойИнформациейКлиент.УстановитьНовоеНаименование(Объект);	

КонецПроцедуры



////////////////////////////////////////////////////////////////////////////////
// КОМАНДЫ ФОРМЫ

&НаКлиенте
Процедура КомандаЗакрытьДоговор(Команда)

	Если ЭтаФорма.Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		Если Вопрос("Перед закрытием договора необходимо сохранить внесенные изменения. Сохранить?", РежимДиалогаВопрос.ОКОтмена) <> КодВозвратаДиалога.ОК Тогда
			Возврат;
		КонецЕсли;
		
		Если Не РаботаСФормамиКлиентСервер.ЗаписатьФорму(ЭтаФорма) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ВидыДоговоров = РаботаСМетаданнымиПовтИсп.ЗначенияПеречисленияВСтруктуру("ВидыДоговоров");
	
	ВидыДоговоровСДочернимиЭлементыми = Новый Массив;
	ВидыДоговоровСДочернимиЭлементыми.Добавить(ВидыДоговоров.БанковскогоОбслуживания);
	ВидыДоговоровСДочернимиЭлементыми.Добавить(ВидыДоговоров.БанковскогоДепозита);
	ВидыДоговоровСДочернимиЭлементыми.Добавить(ВидыДоговоров.ГенСоглашениеПоДепозитнымВкладам);
	ВидыДоговоровСДочернимиЭлементыми.Добавить(ВидыДоговоров.БрокерскогоОбслуживания);
	ВидыДоговоровСДочернимиЭлементыми.Добавить(ВидыДоговоров.ДепозитарногоОбслуживания);
	ВидыДоговоровСДочернимиЭлементыми.Добавить(ВидыДоговоров.ДепозитарногоОбслуживания);
	ВидыДоговоровСДочернимиЭлементыми.Добавить(ВидыДоговоров.ОтветственногоХранения);
	ВидыДоговоровСДочернимиЭлементыми.Добавить(ВидыДоговоров.ВеденияРеестра);
	ВидыДоговоровСДочернимиЭлементыми.Добавить(ВидыДоговоров.СпецДепозитарногоОбслуживания);
	ВидыДоговоровСДочернимиЭлементыми.Добавить(ВидыДоговоров.СпецРегистрационногоОбслуживания);
	ВидыДоговоровСДочернимиЭлементыми.Добавить(ВидыДоговоров.СпецРегистрационногоОбслуживания);
	
	Если Объект.ВидДоговора = ВидыДоговоров.ДополнительноеСоглашение Тогда 
		ВидДоговораОснования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Основание, "ВидДоговора");
	Иначе
		ВидДоговораОснования = Неопределено;
	КонецЕсли;
	
	Если ВидыДоговоровСДочернимиЭлементыми.Найти(Объект.ВидДоговора) <> Неопределено 
	 ИЛИ ВидыДоговоровСДочернимиЭлементыми.Найти(ВидДоговораОснования) <> Неопределено Тогда
		
		АдресДереваДочернихЭлементов = РаботаСИсполнителями.ПолучитьДочерниеЭлементы(Объект.Ссылка, , "ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)", , ЭтаФорма.УникальныйИдентификатор);
		Если ЗначениеЗаполнено(АдресДереваДочернихЭлементов) Тогда
			ДополнительныеРеквизиты = Новый Массив;
			ДополнительныеРеквизиты.Добавить(Новый Структура("Имя, ТипЗначения, Заголовок, Значение", "ДатаЗакрытия", Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.Дата)), "Дата расторжения", ТекущаяДата()));
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("РежимВыбора",					Истина);
			ДополнительныеПараметры.Вставить("МножественныйВыбор",			Истина);
			ДополнительныеПараметры.Вставить("ЗапретитьСнятиеОтметок",      Истина);
			ДополнительныеПараметры.Вставить("ВидимыеКолонки",				"Представление");
			ДополнительныеПараметры.Вставить("ОтмеченныеЭлементы",			Новый Структура("Элемент", Объект.Ссылка));
			ДополнительныеПараметры.Вставить("ДополнительныеРеквизиты",		ДополнительныеРеквизиты);
			ДополнительныеПараметры.Вставить("ПутьКДаннымКартинкиСтроки",	"ДеревоЗначений.ДанныеКартинки");
			ДополнительныеПараметры.Вставить("КартинкаСтрок",				БиблиотекаКартинок.РегистрСведенийЗапись);
			
			РезультатВопроса = РаботаСФормамиКлиент.ПоказатьДеревоЗначений(АдресДереваДочернихЭлементов, "При расторжении договора будут закрыты дочерние элементы:", ЭтаФорма, РежимДиалогаВопрос.ОКОтмена, КодВозвратаДиалога.ОК, "Закрытие договора", ДополнительныеПараметры);
			Если РезультатВопроса <> КодВозвратаДиалога.ОК Тогда
				Возврат;
			КонецЕсли;
			
			РаботаСИсполнителями.ЗакрытьДеревоЭлементов(ДополнительныеПараметры.АдресДереваЗначений, ДополнительныеПараметры.ДополнительныеРеквизиты.ДатаЗакрытия);
			
			ЭтотОбъект.Прочитать();
		КонецЕсли;
		
	Иначе
		
		ПараметрыРасторжения = ПолучитьПараметрыЗаписиНаРасторжениеДоговора(Объект.Ссылка);
		
		Если ПараметрыРасторжения <> Неопределено Тогда 
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ЗначенияЗаполнения", ПараметрыРасторжения);
			
			ОткрытьФормуМодально("РегистрСведений.УсловияДоговоровОбщие.ФормаЗаписи", ПараметрыФормы, ЭтаФорма);
			
		КонецЕсли;
		
		ЭтотОбъект.Прочитать();
		
	КонецЕсли;
	
КонецПроцедуры

#Область СЛУЖЕБНЫЕ_ПРОЦЕДУРЫ_И_ФУНКЦИИ

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);

	Если НЕ Объект.Ссылка.Пустая() Тогда
		ЭтаФорма.ДатаРасторжения = РаботаСНормативноСправочнойИнформацией.ПолучитьРеквизитыДоговора(Объект.Ссылка, "ДатаРасторжения").ДатаРасторжения;
		ЭтаФорма.ВидДоговораАренды = РаботаСНормативноСправочнойИнформацией.ПолучитьРеквизитыДоговора(Объект.Ссылка, "ВидДоговораАренды").ВидДоговораАренды;
	КонецЕсли;
	
	ЭтаФорма.ИзменениеВознаграждения = ЗначениеЗаполнено(Объект.ДатаИзмененияВознаграждения);
	ЭтаФорма.ВидДокументаДляПредставленияДоговор = Не ЗначениеЗаполнено(Объект.ВидДокументаДляПредставления);
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры // ПриЧтенииСозданииНаСервере

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступность(Форма)
	
	ДанныеОбъекта = Форма.Объект;
	Элементы	  = Форма.Элементы;
	
	ВидыДоговоров = ПолучитьВидыДоговоров();
	
	ЭтоНовыйДоговор 				= ДанныеОбъекта.Ссылка.Пустая();
	
	ЭтоДопСоглашение				= (ДанныеОбъекта.ВидДоговора = ВидыДоговоров.ДополнительноеСоглашение
										Или ДанныеОбъекта.ВидДоговора = ВидыДоговоров.ДополнениеПравил);
										
	ВидДоговораОснования			= ?(ТипЗнч(ДанныеОбъекта.Основание) = Тип("СправочникСсылка.Договоры"), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеОбъекта.Основание, "ВидДоговора"), Неопределено);										
										
	ЭтоДопСоглашениеСчетаДУ			= (ДанныеОбъекта.ВидДоговора = ВидыДоговоров.ДополнительноеСоглашение
										И ТипЗнч(ДанныеОбъекта.Основание) = Тип("СправочникСсылка.СчетаДоверительногоУправления"));
										
	ЭтоДоговорБанкОбслуживания		= (ДанныеОбъекта.ВидДоговора = ВидыДоговоров.БанковскогоОбслуживания
										Или ДанныеОбъекта.ВидДоговора = ВидыДоговоров.БанковскогоДепозита
										Или ДанныеОбъекта.ВидДоговора = ВидыДоговоров.ГенСоглашениеПоДепозитнымВкладам
										Или ДанныеОбъекта.ВидДоговора = ВидыДоговоров.КомплексногоОбслуживания);
										
	ЭтоДоговорБрокерОбслуживания	= (ДанныеОбъекта.ВидДоговора = ВидыДоговоров.БрокерскогоОбслуживания);
	
	ЭтоДоговорДепозитарОбслуживания	= (ДанныеОбъекта.ВидДоговора = ВидыДоговоров.ДепозитарногоОбслуживания
										Или ДанныеОбъекта.ВидДоговора = ВидыДоговоров.СпецДепозитарногоОбслуживания);
										
	ДоговорРасторгнут				= Не ЭтоНовыйДоговор И ЭтотДоговорРасторгнут(ДанныеОбъекта.Ссылка);								
									
	Элементы.КомандаЗакрытьДоговор.Видимость	= Не ДоговорРасторгнут;	
	
	Элементы.Основание.Видимость 				= (ЭтоДопСоглашение 
													Или ДанныеОбъекта.ВидДоговора = ВидыДоговоров.Залога
													Или ДанныеОбъекта.ВидДоговора = ВидыДоговоров.Поручительства);
									
	Элементы.Основание.ОграничениеТипа 			= ОграничениеТипаОснования(ДанныеОбъекта.ВидДоговора, ВидыДоговоров);
	
	Элементы.ВидДоговораАренды.Видимость 		= (ДанныеОбъекта.ВидДоговора = ВидыДоговоров.Аренды);
									
	Элементы.Контрагент.Видимость										= Не ЭтоДопСоглашение;
	
	Элементы.КомандаПоказатьСчетаИИсполнителей.Видимость				= (ЭтоДоговорБанкОбслуживания Или ЭтоДоговорБрокерОбслуживания Или ЭтоДоговорДепозитарОбслуживания); 	
	
	Элементы.УсловияДоговоровОбщиеГруппаСрокОплаты.Видимость 						= НЕ ЭтоДопСоглашение;
	Элементы.ГруппаУсловияАгентскихДоговоров.Видимость 								= (ДанныеОбъекта.ВидДоговора = ВидыДоговоров.АгентскийДоговор);
	
	Элементы.ГруппаУсловияДоговоровОказанияАудиторскихУслуг.Видимость 				= (ДанныеОбъекта.ВидДоговора = ВидыДоговоров.ОказанияАудиторскихУслуг ИЛИ ВидДоговораОснования = ВидыДоговоров.ОказанияАудиторскихУслуг);
	Элементы.УсловияАудиторскихУслугГруппаВидыГодовойОтчетности.Видимость			= (ДанныеОбъекта.ВидДоговора = ВидыДоговоров.ОказанияАудиторскихУслуг);
	Элементы.УсловияАудиторскихУслугГруппаВидыПромежуточнойОтчетности.Видимость		= (ДанныеОбъекта.ВидДоговора = ВидыДоговоров.ОказанияАудиторскихУслуг);
	
	Элементы.ГруппаДополнительныеСоглашения.Видимость								= (ДанныеОбъекта.ВидДоговора = ВидыДоговоров.ОказанияАудиторскихУслуг);
	Элементы.ДополнительныеСоглашенияДатаНачалаПредоставленияУслуг.Видимость		= (ДанныеОбъекта.ВидДоговора = ВидыДоговоров.ОказанияАудиторскихУслуг);
	Элементы.ДополнительныеСоглашенияДатаОкончанияПредоставленияУслуг.Видимость		= (ДанныеОбъекта.ВидДоговора = ВидыДоговоров.ОказанияАудиторскихУслуг);
	
	Элементы.ГруппаУсловияДоговоровОказанияАудиторскихУслуг.Заголовок				= ?(ВидДоговораОснования = ВидыДоговоров.ОказанияАудиторскихУслуг, "Условия доп.соглашения оказания аудиторских услуг", "Условия договоров оказания аудиторских услуг");
	
	
	Элементы.ГруппаУсловияДоговоровЗалога.Видимость									= (ДанныеОбъекта.ВидДоговора = ВидыДоговоров.Залога);

	Элементы.Контрагент.Заголовок = ?(ДанныеОбъекта.ВидДоговора = ВидыДоговоров.Залога, 			"Залогодатель", 
									?(ДанныеОбъекта.ВидДоговора = ВидыДоговоров.Поручительства, 	"Поручитель", 
									?(ДанныеОбъекта.ВидДоговора = ВидыДоговоров.ТрудовойДоговор, 	"Сотрудник", "")));
									
	Элементы.ИзменениеВознаграждения.Видимость					= ЭтоДопСоглашениеСчетаДУ;
	Элементы.ДатаИзмененияВознаграждения.Видимость				= Элементы.ИзменениеВознаграждения.Видимость И Форма.ИзменениеВознаграждения;
	Элементы.ОткрытьНастройкиРасчетаВознаграждения.Видимость	= Элементы.ДатаИзмененияВознаграждения.Видимость И Не ЭтоНовыйДоговор;
	
	Элементы.ВидДокументаДляПредставления.Видимость				= НЕ Форма.ВидДокументаДляПредставленияДоговор;
	Элементы.ВидДокументДляПредставленияДоговор.Заголовок		= "Вид документа для представления: " 
		+ ?(Форма.ВидДокументаДляПредставленияДоговор, "Договор", "");
	
	ИспользуетсяСвязатьСоСчетомДУ = НЕ (ДанныеОбъекта.ВидДоговора = ВидыДоговоров.ТрудовойДоговор ИЛИ ЭтоДопСоглашениеСчетаДУ);
									
	Если НЕ ИспользуетсяСвязатьСоСчетомДУ Тогда
		Форма.СвязатьСоСчетомДУ = Ложь;
		Форма.СчетДоверительногоУправления = Неопределено;
	КонецЕсли; 
									
	//Для Каждого ЭлементКомандногоИнтерфейса Из Форма.ЭтаФорма.КомандныйИнтерфейс.ПанельНавигации.ПодменюПерейти.ПодчиненныеЭлементы Цикл
	//    Если Найти(ЭлементКомандногоИнтерфейса.Имя, "ИмяКомандыРегистра") > 0 Тогда
	//        ЭлементКомандногоИнтерфейса.Видимость = Ложь;
	//    КонецЕсли;
	//КонецЦикла;
	
	Если ЭтоНовыйДоговор Тогда
		
		Элементы.СтраницаСвязанныеСчетаВУ.Видимость 		= Ложь;
		Элементы.ГруппаСвязатьСоСчетомДУ.Видимость 			= ИспользуетсяСвязатьСоСчетомДУ;
		Элементы.СчетДоверительногоУправления.Доступность 	= Форма.СвязатьСоСчетомДУ;
		
		Элементы.ДатаРасторжения.ТолькоПросмотр 			= Ложь;
		Элементы.ГруппаУсловияДоговоровОбщие.Видимость 		= Ложь;
		
		Элементы.ДатаРасторжения.Видимость					= Истина;
		Элементы.КомандаЗакрытьДоговор.Видимость			= Ложь;
		
	Иначе
		
		Элементы.ГруппаСвязатьСоСчетомДУ.Видимость 			= Ложь;
		Элементы.СтраницаСвязанныеСчетаВУ.Видимость 		= ИспользуетсяСвязатьСоСчетомДУ;
		
		Элементы.ДатаРасторжения.ТолькоПросмотр 			= Истина;
		Элементы.ГруппаУсловияДоговоровОбщие.Видимость 		= Истина;
		
		Элементы.ДатаРасторжения.Видимость					= ЗначениеЗаполнено(Форма.ДатаРасторжения);
		Элементы.КомандаЗакрытьДоговор.Видимость			= НЕ ЗначениеЗаполнено(Форма.ДатаРасторжения);
		
	КонецЕсли;
	
КонецПроцедуры //НастроитьВидимостьДоступность

&НаСервереБезКонтекста
Функция ПолучитьВидыДоговоров()

	ВидыДоговоров = Новый Структура;
	Для каждого ВидДоговора Из Перечисления.ВидыДоговоров Цикл
	
		ИмяЗначения = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ВидДоговора);
		ВидыДоговоров.Вставить(ИмяЗначения, ВидДоговора);
	
	КонецЦикла; 
	
	Возврат ВидыДоговоров;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОграничениеТипаОснования(ВидДоговора, ВидыДоговоров)
	
	МассивТипов = Новый Массив;
	
	Если ВидДоговора = ВидыДоговоров.Залога
	 Или ВидДоговора = ВидыДоговоров.Поручительства Тогда
		МассивТипов.Добавить(Тип("СправочникСсылка.Займы"));
		
	ИначеЕсли ВидДоговора = ВидыДоговоров.ДополнительноеСоглашение Тогда
		МассивТипов.Добавить(Тип("СправочникСсылка.Займы"));
		МассивТипов.Добавить(Тип("СправочникСсылка.СчетаДоверительногоУправления"));
		МассивТипов.Добавить(Тип("СправочникСсылка.Договоры"));
		МассивТипов.Добавить(Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды"));
		
	Иначе
		МассивТипов.Добавить(Тип("СправочникСсылка.СчетаДоверительногоУправления"));
		МассивТипов.Добавить(Тип("СправочникСсылка.Договоры"));
		МассивТипов.Добавить(Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды"));
		
	КонецЕсли;
	
	Возврат Новый ОписаниеТипов(МассивТипов);
	
КонецФункции

&НаСервереБезКонтекста
Функция ЭтотДоговорРасторгнут(Договор)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияДоговоров.ДатаРасторжения КАК ДатаРасторжения
		|ИЗ
		|	РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(, Договор = &Договор) КАК УсловияДоговоров
		|ГДЕ
		|	УсловияДоговоров.ДатаРасторжения <> ДАТАВРЕМЯ(1, 1, 1)");
	
	Запрос.УстановитьПараметр("Договор", Договор);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат (Не РезультатЗапроса.Пустой());
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПараметрыЗаписиНаРасторжениеДоговора(Договор)
	
	ДатаРасторжения	= НачалоДня(ТекущаяДата());
	ПараметрыЗаписи	= Новый Структура("Период, Договор, ДатаРасторжения, СрокОплаты, ВариантДлиныСрока", ДатаРасторжения, Договор, ДатаРасторжения);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияДоговоров.Период КАК Период,
		|	УсловияДоговоров.Договор КАК Договор,
		|	УсловияДоговоров.ДатаРасторжения КАК ДатаРасторжения,
		|	УсловияДоговоров.СрокОплаты КАК СрокОплаты,
		|	УсловияДоговоров.ВариантДлиныСрока КАК ВариантДлиныСрока
		|ИЗ
		|	РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(, Договор = &Договор) КАК УсловияДоговоров");
	
	Запрос.УстановитьПараметр("Договор", Договор);
	
	РезультатЗапроса = Запрос.Выполнить();	
	Если Не РезультатЗапроса.Пустой() ТОгда
		ТекущиеУсловия = РезультатЗапроса.Выгрузить()[0];
		
		Если ЗначениеЗаполнено(ТекущиеУсловия.ДатаРасторжения) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Договор был расторгнут ранее.");
			Возврат Неопределено;
		ИначеЕсли ТекущиеУсловия.Период >= ДатаРасторжения Тогда
			ПараметрыЗаписи.Период = ТекущиеУсловия.Период + 86400;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ПараметрыЗаписи, ТекущиеУсловия, "СрокОплаты, ВариантДлиныСрока"); 
	КонецЕсли;
	
	Возврат ПараметрыЗаписи;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборыПоВедомымРегистрам(Форма)

	Объект = Форма.Объект;
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.УсловияДоговоровОбщие.Отбор, "Договор",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.УсловияАгентскихДоговоров.Отбор, "Договор",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.УсловияДоговоровОказанияАудиторскихУслуг.Отбор, "Договор",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);

	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.УсловияДоговоровОказанияАудиторскихУслугСвернутые.Отбор, "Договор",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	Форма.УсловияДоговоровОказанияАудиторскихУслугСвернутые.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("Договор",     Объект.Ссылка);
	Форма.УсловияДоговоровОказанияАудиторскихУслугСвернутые.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("Организация", Объект.Организация);
		
		
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.УсловияДоговоровЗалога.Отбор, "Договор",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.ДополнительныеСоглашения.Отбор, "Основание",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.ДоговорыСчетовДоверительногоУправления.Отбор, "Организация",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Организация, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.ДоговорыСчетовДоверительногоУправления.Отбор, "Договор",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКлючНастроекРасчетаВознаграждения(ДопСоглашение)
	
	Возврат РегистрыСведений.НастройкиРасчетаВознагражденияУправляющего.ПолучитьКлючНастроекРасчетаВознагражденияПоОснованию(ДопСоглашение);
	
КонецФункции

&НаКлиенте
Процедура ОчиститьРеквизитыВознаграждения()
	
	ЭтаФорма.ИзменениеВознаграждения	= Неопределено;
	Объект.ДатаИзмененияВознаграждения	= Неопределено;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПериодУсловийДопСоглашенияНеРавенДатеЗаключения(Договор, ДатаЗаключения)

	Возврат Справочники.Договоры.ПериодУсловийДопСоглашенияНеРавенДатеЗаключения(Договор, ДатаЗаключения);
	
