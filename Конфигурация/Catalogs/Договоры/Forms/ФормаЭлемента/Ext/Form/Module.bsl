&НаСервереБезКонтекста
Процедура УсловияДоговоровОказанияАудиторскихУслугСвернутыеПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)

	Договор     = Неопределено;
    Организация = Неопределено;
	
	Настройки.ДополнительныеСвойства.Свойство("Договор",     Договор);
	Настройки.ДополнительныеСвойства.Свойство("Организация", Организация);
	Если Не ЗначениеЗаполнено(Договор) Или Не ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;	

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Договор",     Договор);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияДоговоровОказанияАудиторскихУслуг.Период КАК Период,
		|	УсловияДоговоровОказанияАудиторскихУслуг.ВидОтчетности КАК ВидОтчетности,
		|	УсловияДоговоровОказанияАудиторскихУслуг.Стоимость КАК Стоимость
		|ИЗ
		|	РегистрСведений.УсловияДоговоровОказанияАудиторскихУслуг КАК УсловияДоговоровОказанияАудиторскихУслуг
		|ГДЕ
		|	УсловияДоговоровОказанияАудиторскихУслуг.Договор = &Договор
		|	И УсловияДоговоровОказанияАудиторскихУслуг.Организация = &Организация
		|ИТОГИ ПО
		|	Период";
	
	ВыборкаПериод = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПериод.Следующий() Цикл
		
		ВидыОтчетности = Новый Массив;
		Стоимость      = 0;
		ВыборкаВидОтчетности = ВыборкаПериод.Выбрать();
		Пока ВыборкаВидОтчетности.Следующий() Цикл
			ВидыОтчетности.Добавить(ВыборкаВидОтчетности.ВидОтчетности);		
			Стоимость = Стоимость + ВыборкаВидОтчетности.Стоимость;
		КонецЦикла;
		
		СтрокаСписка = Строки.Получить(ВыборкаПериод.Период);
		Если СтрокаСписка <> Неопределено Тогда
			СтрокаСписка.Данные["ВидыОтчетности"] = СтрСоединить(ВидыОтчетности, "; ");
			СтрокаСписка.Данные["Стоимость"]      = Стоимость;
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияДоговоровОказанияАудиторскихУслугСвернутыеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ВыбраннаяСтрока <> Неопределено Тогда
		
		ПараметрыОткрытия = Новый Структура("Период, Договор, Организация", Элемент.ТекущиеДанные.Период, Объект.Ссылка, Объект.Организация);

		Если Не ПроверитьНаличиеДанных(ПараметрыОткрытия) Тогда
			ПоказатьПредупреждение(, "Выбранные условия не найдены! Возможно, данные были изменены в другом сеансе. Список условий обновлен.");
			Элементы.УсловияДоговоровОказанияАудиторскихУслугСвернутые.Обновить();
			Возврат;
		КонецЕсли;	
		
		ОткрытьФорму("Справочник.Договоры.Форма.ФормаРедактированияУсловийОказанияАудиторскихУслуг", ПараметрыОткрытия,
			ЭтаФорма, ЭтаФорма.УникальныйИдентификатор, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
	КонецЕсли;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьНаличиеДанных(Отбор)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период",      Отбор.Период);
	Запрос.УстановитьПараметр("Договор",     Отбор.Договор);
	Запрос.УстановитьПараметр("Организация", Отбор.Организация);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	1 КАК Поле1
		|ИЗ
		|	РегистрСведений.УсловияДоговоровОказанияАудиторскихУслуг КАК УсловияДоговоровОказанияАудиторскихУслуг
		|ГДЕ
		|	УсловияДоговоровОказанияАудиторскихУслуг.Период = &Период
		|	И УсловияДоговоровОказанияАудиторскихУслуг.Договор = &Договор
		|	И УсловияДоговоровОказанияАудиторскихУслуг.Организация = &Организация";
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

&НаСервереБезКонтекста
Функция ЕстьСчетДоверительногоУправленияДоговора(Организация, Договор)
	
	Возврат Справочники.Договоры.СчетВнутреннегоУчетаПоДоговору(Организация, Договор) <> Неопределено;
	
КонецФункции	

&НаСервереБезКонтекста
Функция ОрганизацииБезКонтроляУсловийНаСервере()

	Возврат Справочники.Договоры.ОрганизацииБезКонтроляУсловийАудиторскихУслуг();
	
КонецФункции	

&НаКлиенте
Процедура ДобавитьУсловияДоговоровОказанияАудиторскихУслуг(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перед добавлением условий оказания аудиторских услуг договор необходимо записать!");
		Возврат;
		
	КонецЕсли;

	Если Не ЕстьСчетДоверительногоУправленияДоговора(Объект.Организация, Объект.Ссылка) Тогда
		
		Если ОрганизацииБезКонтроляУсловийНаСервере().Найти(Объект.Организация) = Неопределено Тогда
			
			ПоказатьПредупреждение(, "Перед добавлением условий оказания аудиторских услуг необходимо связать договор со счетом внутреннего учета!");
			Возврат;
			
		КонецЕсли;	
		
	КонецЕсли;	

	ПараметрыОткрытия = Новый Структура("Период, Договор, Организация", Дата(1, 1, 1), Объект.Ссылка, Объект.Организация);
	ОткрытьФорму("Справочник.Договоры.Форма.ФормаРедактированияУсловийОказанияАудиторскихУслуг", ПараметрыОткрытия,
				ЭтаФорма, ЭтаФорма.УникальныйИдентификатор, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьУсловияДоговоровОказанияАудиторскихУслуг(Команда)

	ТекущаяСтрока = Элементы.УсловияДоговоровОказанияАудиторскихУслугСвернутые.ТекущаяСтрока;
	Если ТекущаяСтрока <> Неопределено Тогда

		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОбУдалениеЗаписейУсловийДоговоровОказанияАудиторскихУслуг", 
						ЭтаФорма, Новый Структура("Период, Договор, Организация", ТекущаяСтрока, Объект.Ссылка, Объект.Организация)), 
						СтрШаблон("Удалить условия договоров оказания аудиторских услуг за %1?", ТекущаяСтрока), 
						РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, "Подтвердите удаление условий"); 
						
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбУдалениеЗаписейУсловийДоговоровОказанияАудиторскихУслуг(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда

		УдалитьУсловияДоговоровОказанияАудиторскихУслугНаСервере(ДопПараметры);	
		Элементы.УсловияДоговоровОказанияАудиторскихУслугСвернутые.Обновить();
		
	КонецЕсли;	
		
КонецПроцедуры	 

&НаСервереБезКонтекста
Процедура УдалитьУсловияДоговоровОказанияАудиторскихУслугНаСервере(ОтборДляУдаления) 

	НовыйНаборЗаписей = РегистрыСведений.УсловияДоговоровОказанияАудиторскихУслуг.СоздатьНаборЗаписей();
	НовыйНаборЗаписей.Отбор.Период.Установить(ОтборДляУдаления.Период);
	НовыйНаборЗаписей.Отбор.Договор.Установить(ОтборДляУдаления.Договор);
	НовыйНаборЗаписей.Отбор.Организация.Установить(ОтборДляУдаления.Организация);
	НовыйНаборЗаписей.Записать(Истина);
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзменениеУсловийДоговоровОказанияАудиторскихУслуг" Тогда
		Элементы.УсловияДоговоровОказанияАудиторскихУслугСвернутые.Обновить();
	КонецЕсли;	
	
КонецПроцедуры

