
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Список.Параметры.УстановитьЗначениеПараметра("ТекущаяДата",        КонецДня(ТекущаяДата()));
	Список.Параметры.УстановитьЗначениеПараметра("ОтображатьЗакрытые", Ложь);
	
	Если Параметры.Отбор.Свойство("ВидДоговора") Тогда
		Список.Параметры.УстановитьЗначениеПараметра("ОтборПоВидуДоговора"	, Истина);
		Список.Параметры.УстановитьЗначениеПараметра("ВидыДоговоров"		, Параметры.Отбор.ВидДоговора);
		Параметры.Отбор.Удалить("ВидДоговора");
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("ОтборПоВидуДоговора"	, Ложь);
		Список.Параметры.УстановитьЗначениеПараметра("ВидыДоговоров"		, Новый Массив);
	КонецЕсли;
	
	Элементы.Список.РежимВыбора = Параметры.РежимВыбора;	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПоказатьСкрытьЗакрытые(Команда)
	
	Элементы.КомандаПоказатьСкрытьЗакрытые.Пометка = Не Элементы.КомандаПоказатьСкрытьЗакрытые.Пометка;
	
	Список.Параметры.УстановитьЗначениеПараметра("ОтображатьЗакрытые", Элементы.КомандаПоказатьСкрытьЗакрытые.Пометка);
	
КонецПроцедуры
