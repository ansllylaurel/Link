
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// Проверку заполнения реквизитов Текст и ТекстПисьмаВФорматеHTML выполняем ПередЗаписью,
	// т.к. они заполняются в процедуре ПередЗаписьюНаСервере формы объекта
	
	Если Не ЭтотОбъект.ДополнятьСписокПолучателейИзИсточника Тогда
		ПроверяемыеРеквизиты.Добавить("Получатели");
	КонецЕсли;
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Если Не ЭтотОбъект.ПометкаУдаления Тогда
		
		УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
		
		Если ЭтотОбъект.ПисьмоВФорматеHTML И Не ПустаяСтрока(ЭтотОбъект.Текст) И ПустаяСтрока(ЭтотОбъект.ТекстПисьмаВФорматеHTML)
			ИЛИ Не ЭтотОбъект.ПисьмоВФорматеHTML И Не ПустаяСтрока(ЭтотОбъект.ТекстПисьмаВФорматеHTML)
		Тогда
			
			ТекстОшибки = ?(ЭтотОбъект.ПисьмоВФорматеHTML,
				"Не заполнено поле 'Текст письма в формате HTML'",
				"Поле 'Текст письма в формате HTML' не должно быть заполнено для оповещения с обычным текстом");
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, , "ТекстПисьмаВФорматеHTML", Отказ);
			
		КонецЕсли;
		
	КонецЕсли;

	Если Не Отказ Тогда
		
		// Заполняем тип текста письма
		
		Если ЭтотОбъект.ПисьмоВФорматеHTML Тогда
			
			КартинкиПисьма = ЭтотОбъект.КартинкиПисьмаВФорматеHTML.Получить();
			
			Если ТипЗнч(КартинкиПисьма) = Тип("Структура") И КартинкиПисьма.Количество() > 0 Тогда
				ЭтотОбъект.ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.HTMLСКартинками;
			Иначе
				ЭтотОбъект.ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.HTML;
			КонецЕсли;
			
		Иначе
			
			ЭтотОбъект.ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.ПростойТекст;
			
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры
