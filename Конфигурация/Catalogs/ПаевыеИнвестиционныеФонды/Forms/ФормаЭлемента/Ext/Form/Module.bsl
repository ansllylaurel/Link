
///////////////////////////////////////////////////////////////////////////////
// ОБРАБОТКА СОБЫТИЙ ФОРМЫ

&НаКлиенте
Перем РеестрПайщиковИнициализирован;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();

	// установка отборов в динамическом списке контактных лиц
	РаботаСНастройкамиСписковКлиентСервер.ДобавитьЭлементОтбора(КонтактныеЛица.Отбор, "Объект",, ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка,
		Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	// отборы по ведомым регистрам
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(ЭтаФорма.УсловияПравилПаевогоИнвестиционногоФонда.Отбор, "ПаевойИнвестиционныйФонд",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(ЭтаФорма.ДополненияПравил.Отбор, "Основание",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(ЭтаФорма.ДополненияПравил.Отбор, "ВидДоговора",,
		ВидСравненияКомпоновкиДанных.Равно, ПредопределенноеЗначение("Перечисление.ВидыДоговоров.ДополнениеПравил"), Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	Если ЭтаФорма.Параметры.Свойство("ОткрытьНаСтраницеКонтактныеЛица") И ЭтаФорма.Параметры.ОткрытьНаСтраницеКонтактныеЛица Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаКонтактныеЛица;
	ИначеЕсли ЭтаФорма.Параметры.Свойство("ОткрытьНаСтраницеПравилаИЛицензия") И ЭтаФорма.Параметры.ОткрытьНаСтраницеПравилаИЛицензия Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПравилаИЛицензия;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИнициализироватьРеестрПайщиковЕслиОткрытаСтраница();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура СсылкаОбновитьНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Вопрос("Обновить текущий элемент?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		РаботаСВнешнимиСистемами.ОбновитьРеквизитыОбъектаИзМатрикс(Объект.Ссылка);
		
		ЭтаФорма.Прочитать();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	УниверсальныеМеханизмы.УстановитьЗаголовокСсылкиОбновить(ЭтаФорма, Объект.Ссылка);
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	РеквизитыПИФ = РегистрыСведений.РеквизитыПИФ.ПолучитьРеквизитыПИФ(Объект.Ссылка, ТекущаяДатаСеанса());
	ЗаполнитьЗначенияСвойств(ЭтаФорма, РеквизитыПИФ, "УправляющаяКомпания, ПолноеНаименованиеФонда");

КонецПроцедуры // ПриЧтенииСозданииНаСервере

&НаСервере
Процедура ИнициализироватьРеестрПайщиковНаСервере()
	
	РеестрПайщиков.Параметры.УстановитьЗначениеПараметра("Fund_Name", Объект.Наименование);
	
	УстановитьДоступныеДатыИОтборРеестраНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ИнициализироватьРеестрПайщиковЕслиОткрытаСтраница()
	
	Если Элементы.Страницы.ТекущаяСтраница <> Элементы.СтраницаРеестрПайщиков
		Или РеестрПайщиковИнициализирован = Истина Тогда
		Возврат;
	КонецЕсли;
	
	ИнициализироватьРеестрПайщиковНаСервере();
	РеестрПайщиковИнициализирован = Истина;
	
	Элементы.РеестрПайщиков.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ИнициализироватьРеестрПайщиковЕслиОткрытаСтраница();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступныеДатыИОтборРеестраНаСервере()
	
	// 1. Получаем список уникальных дат из внешнего источника с обработкой ошибок
	МассивДоступныхДат = ПолучитьСписокДатИзВнешнегоИсточникаНаСервере(Объект.Наименование);
	
	// 2. Настраиваем список выбора на форме
	НастроитьСписокВыбораДатыНаСервере(МассивДоступныхДат);
	
	// 3. Применяем отбор к списку
	УстановитьОтборПоДатеРеестраНаСервере();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокДатИзВнешнегоИсточникаНаСервере(НаименованиеФонда)
	
	МассивДат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	dbo_Register_Of_Unit_Holders.Compilation_Date КАК ДатаСоставления
		|ИЗ
		|	ВнешнийИсточникДанных.Externals.Таблица.dbo_Register_Of_Unit_Holders КАК dbo_Register_Of_Unit_Holders
		|ГДЕ
		|	dbo_Register_Of_Unit_Holders.Fund_Name = &Fund_Name
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаСоставления УБЫВ";
	
	Запрос.УстановитьПараметр("Fund_Name", НаименованиеФонда);
	
	Попытка
		Результат = Запрос.Выполнить();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Не удалось получить список дат из внешнего источника'") + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат МассивДат;
	КонецПопытки;
	
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			ДатаБезВремени = НачалоДня(Выборка.ДатаСоставления);
			МассивДат.Добавить(ДатаБезВремени);
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивДат;
	
КонецФункции

&НаСервере
Процедура НастроитьСписокВыбораДатыНаСервере(МассивДоступныхДат)
	
	Элементы.ДатаРеестраПайщиков.СписокВыбора.Очистить();
	Элементы.ДатаРеестраПайщиков.СписокВыбора.Добавить(Дата(1, 1, 1), НСтр("ru = '<Все даты>'"));
	
	ПоследняяДата = Неопределено;
	УникальныеДаты = Новый Соответствие;
	
	Для Каждого ТекДата Из МассивДоступныхДат Цикл
		
		Если Не УникальныеДаты.Получить(ТекДата) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		УникальныеДаты.Вставить(ТекДата, Истина);
		
		// Добавляем в выпадающий список
		ПредставлениеДаты = Формат(ТекДата, "ДЛФ=DD");
		Элементы.ДатаРеестраПайщиков.СписокВыбора.Добавить(ТекДата, ПредставлениеДаты);
		
		// Запоминаем самую первую (она же максимальная)
		Если ПоследняяДата = Неопределено Тогда
			ПоследняяДата = ТекДата;
		КонецЕсли;
		
	КонецЦикла;
	
	// 4. Устанавливаем в поле последнюю дату, если она есть, иначе - "Все даты"
	Если ПоследняяДата <> Неопределено Тогда
		ЭтаФорма.ДатаРеестраПайщиков = ПоследняяДата;
	Иначе
		ЭтаФорма.ДатаРеестраПайщиков = Дата(1, 1, 1);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПоДатеРеестраНаСервере()
	
	ОтборСписка = РеестрПайщиков.Отбор.Элементы;
	
	// 1. Удаляем старые отборы
	РеестрПайщиков.Отбор.Элементы.Очистить();
	
	// 2. Если выбрана конкретная дата (не пустая и не "Все даты")
	Если ЗначениеЗаполнено(ЭтаФорма.ДатаРеестраПайщиков) 
		И ЭтаФорма.ДатаРеестраПайщиков <> Дата(1, 1, 1) Тогда
		
		ЭлементНачалоДня = ОтборСписка.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементНачалоДня.ЛевоеЗначение   = Новый ПолеКомпоновкиДанных("Compilation_Date");
		ЭлементНачалоДня.ВидСравнения    = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
		ЭлементНачалоДня.ПравоеЗначение  = НачалоДня(ЭтаФорма.ДатаРеестраПайщиков);
		ЭлементНачалоДня.Использование   = Истина;
		ЭлементНачалоДня.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
		ЭлементКонецДня = ОтборСписка.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементКонецДня.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Compilation_Date");
		ЭлементКонецДня.ВидСравнения     = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
		ЭлементКонецДня.ПравоеЗначение   = КонецДня(ЭтаФорма.ДатаРеестраПайщиков);
		ЭлементКонецДня.Использование    = Истина;
		ЭлементКонецДня.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаРеестраПайщиковПриИзменении(Элемент)
	УстановитьОтборПоДатеРеестраНаСервере();
КонецПроцедуры
