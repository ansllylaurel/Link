// Если у ПИФа есть период приостановки операций с паями, возвращает структуру с датой начала и окончания этого периода.
// Иначе Неопределено
//
//	Параметры:
//		Субъект - счет доверительного управления ПИФ
//
Функция ПериодыПриостановкиОперацийСПаями(Субъект) Экспорт
	
	Если ТипЗнч(Субъект) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВЫБОР
			|		КОГДА НастройкиФормированияСЧА.ПриостановленРасчетСЧА
			|			ТОГДА НастройкиФормированияСЧА.Период
			|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
			|	КОНЕЦ КАК ДатаНачала,
			|	ВЫБОР
			|		КОГДА НастройкиФормированияСЧА.ПриостановленРасчетСЧА
			|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
			|		ИНАЧЕ КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(НастройкиФормированияСЧА.Период, ДЕНЬ, -1), ДЕНЬ)
			|	КОНЕЦ КАК ДатаОкончания,
			|	НастройкиФормированияСЧА.ПриостановленРасчетСЧА КАК ПриостановленРасчетСЧА
			|ПОМЕСТИТЬ _ГраницыПриостановки
			|ИЗ
			|	РегистрСведений.НастройкиФормированияСЧА КАК НастройкиФормированияСЧА
			|ГДЕ
			|	НастройкиФормированияСЧА.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	МАКСИМУМ(_ДатыНачалаПриостановки.ДатаНачала) КАК ДатаНачала,
			|	_ДатыОкончанияПриостановки.ДатаОкончания КАК ДатаОкончания
			|ИЗ
			|	_ГраницыПриостановки КАК _ДатыОкончанияПриостановки
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ГраницыПриостановки КАК _ДатыНачалаПриостановки
			|		ПО (_ДатыНачалаПриостановки.ДатаНачала <= _ДатыОкончанияПриостановки.ДатаОкончания
			|				ИЛИ _ДатыОкончанияПриостановки.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
			|			И (_ДатыНачалаПриостановки.ДатаНачала <> ДАТАВРЕМЯ(1, 1, 1))
			|			И (_ДатыНачалаПриостановки.ПриостановленРасчетСЧА)
			|ГДЕ
			|	_ДатыНачалаПриостановки.ДатаНачала ЕСТЬ НЕ NULL 
			|
			|СГРУППИРОВАТЬ ПО
			|	_ДатыОкончанияПриостановки.ДатаОкончания
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДатаНачала";
		
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", Субъект);
		
		РезультатьЗапроса = Запрос.Выполнить();
		
		Возврат ?(РезультатьЗапроса.Пустой(), Неопределено, РезультатьЗапроса.Выгрузить());
		
	Иначе
		ВызватьИсключение "Не реализована проверка для субъекта с типом '" + ТипЗнч(Субъект) + "'";
	КонецЕсли;
	
КонецФункции

Функция ПриостановленРасчетСЧА(Субъект, Период) Экспорт

	ПериодыПриостановки = ПериодыПриостановкиОперацийСПаями(Субъект);
	
	Если ПериодыПриостановки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПериодыПриостановки.ДатаНачала КАК ДатаНачала,
		|	ПериодыПриостановки.ДатаОкончания КАК ДатаОкончания
		|ПОМЕСТИТЬ _ПериодыПриостановки
		|ИЗ
		|	&ПериодыПриостановки КАК ПериодыПриостановки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПериодыПриостановки.ДатаНачала КАК ДатаНачала,
		|	_ПериодыПриостановки.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	_ПериодыПриостановки КАК _ПериодыПриостановки
		|ГДЕ
		|	&Период МЕЖДУ _ПериодыПриостановки.ДатаНачала И _ПериодыПриостановки.ДатаОкончания";
	
	Запрос.УстановитьПараметр("Период",					Период);
	Запрос.УстановитьПараметр("ПериодыПриостановки",	ПериодыПриостановки);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции
