// Если у ПИФа есть период приостановки операций с паями, возвращает структуру с датой начала и окончания этого периода.
// Иначе Неопределено
//
//	Параметры:
//		Субъект - счет доверительного управления ПИФ
//
Функция ПериодПриостановкиОперацийСПаями(Субъект) Экспорт
	
	Если ТипЗнч(Субъект) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		Если Субъект = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_DU_PIF352") Тогда
			Возврат Новый Структура("ДатаНачала, ДатаОкончания", '20220301', '20230316235959');
		Иначе
			Возврат Неопределено;
		КонецЕсли; 
	Иначе
		ВызватьИсключение "Не реализована проверка для субъекта с типом '" + ТипЗнч(Субъект) + "'";
	КонецЕсли;
	
КонецФункции
