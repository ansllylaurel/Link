
Функция ТребуетсяУказаниеПериодаНачисленияЗадолженности(Организация, ВидЗадолженности, Дата, ВидДоговораДоверительногоУправления) Экспорт
	
	ДатаНачалаПериодичностиНачисления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидЗадолженности, "ДатаНачалаПериодичностиНачисления");
	
	Возврат ЗначениеЗаполнено(ДатаНачалаПериодичностиНачисления) И ?(ЗначениеЗаполнено(Дата),Дата,ТекущаяДата()) >= ДатаНачалаПериодичностиНачисления				
		ИЛИ ДопустимоПредварительноеНачислениеЗадолженности(Организация, ВидЗадолженности, Дата)
		ИЛИ ТребуетсяУказаниеПериодаНачисленияЗадолженностиДляВидаДоговора(Дата, ВидЗадолженности, ВидДоговораДоверительногоУправления);
	
КонецФункции

Функция ТребуетсяУказаниеПериодаНачисленияЗадолженностиДляВидаДоговора(Дата, ВидЗадолженности, ВидДоговораДоверительногоУправления)
	
	ДопустимыеВидыЗадолженности = Новый Массив;
	ДопустимыеВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария);
	ДопустимыеВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецрегистратора);
	
	ДопустимыеВидыДоговоров = Новый Массив;
	ДопустимыеВидыДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда);
	
	Возврат Дата >= '20250526' 
		И ДопустимыеВидыДоговоров.Найти(ВидДоговораДоверительногоУправления) <> Неопределено
		И ДопустимыеВидыЗадолженности.Найти(ВидЗадолженности) <> Неопределено;
	
КонецФункции

Функция ВидыЗадолженностиКПереоценкеПИФ() Экспорт
	
	Результат = Новый Массив;
	
	Результат.Добавить(Справочники.ВидыЗадолженности.ПоСделке);
	Результат.Добавить(Справочники.ВидыЗадолженности.ПоЗайму);
	Результат.Добавить(Справочники.ВидыЗадолженности.ПоЗаймуПроценты);
	Результат.Добавить(Справочники.ВидыЗадолженности.ПоАренде);
	Результат.Добавить(Справочники.ВидыЗадолженности.ПоАрендеПеременнаяЧасть);
	Результат.Добавить(Справочники.ВидыЗадолженности.ПоСделкеСНедвижимостью);
	Результат.Добавить(Справочники.ВидыЗадолженности.ПоИнвестконтракту);
	Результат.Добавить(Справочники.ВидыЗадолженности.ПоДДУ);
	Результат.Добавить(Справочники.ВидыЗадолженности.ПоПолучениюВАренду);
	
	Возврат Результат;
	
КонецФункции

Функция ВидыЗадолженностиСПредварительнымНачислением(Организация, Дата) Экспорт
	
	Результат = Новый Массив;
	
	Результат.Добавить(Справочники.ВидыЗадолженности.ПоАренде);
	Результат.Добавить(Справочники.ВидыЗадолженности.ПоАрендеПеременнаяЧасть);
	Результат.Добавить(Справочники.ВидыЗадолженности.РасходыНаКоммунальныеУслуги);
	Результат.Добавить(Справочники.ВидыЗадолженности.РасходыПоСодержаниюНедвижимости);
	
	Если Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") 
		И ?(ЗначениеЗаполнено(Дата),Дата,ТекущаяДата()) >= Дата("20221101") Тогда
		
		Результат.Добавить(Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего);
		Результат.Добавить(Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецрегистратора);
		Результат.Добавить(Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДопустимоПредварительноеНачислениеЗадолженности(Организация, ВидЗадолженности, Дата) Экспорт
	
	Возврат ВидыЗадолженностиСПредварительнымНачислением(Организация, Дата).Найти(ВидЗадолженности) <> Неопределено;
	
КонецФункции

Функция ПолучитьТаблицуАналитикиДляПредварительныхНачислений() Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ВидЗадолженности", Новый ОписаниеТипов("СправочникСсылка.ВидыЗадолженности"));
	Результат.Колонки.Добавить("АналитикаПредварительногоНачисления", Новый ОписаниеТипов("СправочникСсылка.ПрочиеДоходыИРасходы"));
	
	СтрокаТаблицы = Результат.Добавить();
	СтрокаТаблицы.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоАренде;
	СтрокаТаблицы.АналитикаПредварительногоНачисления = ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ПредварительныйДоходПоАренде");
	
	СтрокаТаблицы = Результат.Добавить();
	СтрокаТаблицы.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоАрендеПеременнаяЧасть;
	СтрокаТаблицы.АналитикаПредварительногоНачисления = ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ПредварительныйДоходПоАренде");
	
	СтрокаТаблицы = Результат.Добавить();
	СтрокаТаблицы.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыНаКоммунальныеУслуги;
	СтрокаТаблицы.АналитикаПредварительногоНачисления = ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ПредварительныйРасходПоКоммунальнымУслугам");
	
	СтрокаТаблицы = Результат.Добавить();
	СтрокаТаблицы.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоСодержаниюНедвижимости;
	СтрокаТаблицы.АналитикаПредварительногоНачисления = ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ПредварительныйРасходПоОбслужНедвижимости");
	
	СтрокаТаблицы = Результат.Добавить();
	СтрокаТаблицы.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего;
	СтрокаТаблицы.АналитикаПредварительногоНачисления = ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ПредварительныйРасходПоВознагрУправляющего");
	
	СтрокаТаблицы = Результат.Добавить();
	СтрокаТаблицы.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецрегистратора;
	СтрокаТаблицы.АналитикаПредварительногоНачисления = ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ПредварительныйРасходПоВознагрСпецрегистратора");
	
	СтрокаТаблицы = Результат.Добавить();
	СтрокаТаблицы.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария;
	СтрокаТаблицы.АналитикаПредварительногоНачисления = ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ПредварительныйРасходПоВознагрСпецдепозитария");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьАналитикуДляПредварительныхНачисленийПоВидуЗадолженности(ВидЗадолженности) Экспорт
	
	ТаблицаАналитикиПредварительныхНачислений = Справочники.ВидыЗадолженности.ПолучитьТаблицуАналитикиДляПредварительныхНачислений();
	
	СтрокаАналитики = ТаблицаАналитикиПредварительныхНачислений.Найти(ВидЗадолженности, "ВидЗадолженности");
	Если СтрокаАналитики = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат СтрокаАналитики.АналитикаПредварительногоНачисления;
	КонецЕсли;
	
КонецФункции

Функция ТребуетсяУказаниеДоговораДляВидаЗадолженности(ВидЗадолженности) Экспорт
	
	Если ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.Недвижимость) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ОпределитьТипЗадолженности(ВидЗадолженности) Экспорт 
	
	Если ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПрочимДоходамИРасходам Тогда
		
		Возврат Неопределено;
		
	ИначеЕсли ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПрочимДоходам
		ИЛИ ВидЗадолженности = Справочники.ВидыЗадолженности.ПоИнымДоходамПоИмуществу 
		ИЛИ ВидЗадолженности = Справочники.ВидыЗадолженности.ПоУслугамПрочегоИспользованияИмущества
		ИЛИ ВидЗадолженности = Справочники.ВидыЗадолженности.ПоАренде
		ИЛИ ВидЗадолженности = Справочники.ВидыЗадолженности.ПоАрендеПеременнаяЧасть Тогда
		
		Возврат Перечисления.ТипыЗадолженности.Дебиторская;
		
	Иначе
		
		Возврат Перечисления.ТипыЗадолженности.Кредиторская;
		
	КонецЕсли;
	
КонецФункции

Функция ЭтоИсходящаяУслуга(ВидЗадолженности) Экспорт 
	
	Возврат ОпределитьТипЗадолженности(ВидЗадолженности) = Перечисления.ТипыЗадолженности.Дебиторская;
	
КонецФункции

Функция ЭтоПеревыставляемаяУслуга(ВидЗадолженности) Экспорт 
	
	Возврат (ВидЗадолженности = Справочники.ВидыЗадолженности.ПоАрендеПеременнаяЧасть);
	
КонецФункции

// Возвращает массив видов задолженности, которая
// оплачивается за счет собственных средств клиента при установленном флаге 
// ОплатаВознагражденияУправляющегоИУслугСпецдепозитарияИзСобственныхСредствКлиента в условиях договоров доверительного управления
//
Функция ВидыЗадолженностиОплачиваемойИзСобственныхСредствКлиента() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего);
	Результат.Добавить(Справочники.ВидыЗадолженности.НеобходимыеРасходыСпецдепозитария);
	Результат.Добавить(Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария);
	Результат.Добавить(Справочники.ВидыЗадолженности.РасходыПоУслугамСпецДепозитария);
	
	Возврат Результат;
	
КонецФункции

// Виды задолженности, для которых создаются поручения на движения денежных средвств.
Функция ВидыЗадолженностиДляФормированияПоручений() Экспорт
	
	ВидыЗадолженностиДляПоручений = Новый Массив;
	
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.ПоНДФЛ13);
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.ПоНДФЛ15);
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.ПоНДФЛ30);
	
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего);
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.НеобходимыеРасходыУправляющего);
	
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.РасходыПоУслугамДепозитария); // место хранения - внебиржа и значение брокера не заполнено, т.к. с брокерского счета тоже списывается комиссия 
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.РасходыПоУслугамСпецДепозитария);
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.НеобходимыеРасходыСпецдепозитария);
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария);
	
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецрегистратора);
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.ПоПрочимУслугам);
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.ПоВозмещениюСтраховыхПремий); 
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.УдержаниеНадбавокИСкидокПИФ);
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.ПередПайщиками);
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.ПоНалогуНаПрибыль);
	
	// УКПИ
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.РасходыПоВознаграждениюОценщика);
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.РасходыНаКоммунальныеУслуги);
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.ПоНалогуНаДобавленнуюСтоимость);
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.ПоНалогуНаИмущество);
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.ПоУлучшениюОбъектовНедвижимости);
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.ПоАренде);
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.ПоЗемельномуНалогу);
	ВидыЗадолженностиДляПоручений.Добавить(Справочники.ВидыЗадолженности.ПоРекламе);

	Возврат ВидыЗадолженностиДляПоручений;
			
КонецФункции

Функция ЭтоВидЗадолженностиДляФормированияПоручений(ВидЗадолженности) Экспорт

	Возврат (ВидыЗадолженностиДляФормированияПоручений().Найти(ВидЗадолженности) <> Неопределено);
	
КонецФункции
