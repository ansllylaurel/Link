				ТаблицаПлановыхОпераций = Неопределено;
			Иначе
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ * ИЗ _ПлановыеДанные_Операции";
				
				Выборка = Запрос.Выполнить().Выбрать();
				ТаблицаПлановыхОпераций = РегистрыСведений.ОперацииСЦеннымиБумагами.ПолучитьОписаниеТаблицыПлановыхОпераций();
				Пока Выборка.Следующий() Цикл
					ЗаполнитьЗначенияСвойств(ТаблицаПлановыхОпераций.Добавить(), Выборка);
				КонецЦикла; 
				
			КонецЕсли; 
			
			Структура = Новый Структура("ЦельРасчета, ВидУчета, Организация, СчетДоверительногоУправления");
			ЗаполнитьЗначенияСвойств(Структура, Параметры);
			Структура.Вставить("Ссылка", 		Документы.РегистрацияСтоимостиПереоценки.ПолучитьСсылку(Новый УникальныйИдентификатор));
			Структура.Вставить("Дата", 			Параметры.Период);
			
			ПараметрыПолученияПартий = РаботаСПереоценкой.ПолучитьПараметрыПолученияПартийПоМетодике(Справочники.ЦелиРасчета.КонтрольИнвестиционнойДекларации, Параметры.ВидУчета, Параметры.ВариантРасчетаОценочнойСтоимости, Параметры.Период, , Параметры.СчетДоверительногоУправления);
			ПараметрыПолученияПартий.Вставить("КоличественныйРасчет", Истина);
			
			РаботаСПереоценкой.ПолучитьЦенныеБумаги(Структура, Запрос.МенеджерВременныхТаблиц, "ТаблицаПартийЦБ", ПараметрыПолученияПартий, Параметры.РасчетПартий, ТаблицаПлановыхОпераций, , Истина);
			УстановитьПривилегированныйРежим(Ложь);
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ТаблицаПартийЦБ.Рынок КАК Рынок,
				|	ТаблицаПартийЦБ.ЦеннаяБумага КАК Актив,
				|	СУММА(ТаблицаПартийЦБ.Количество) КАК Количество,
				|	ТаблицаПартийЦБ.КПоступлению КАК КПоступлению,
				|	СУММА(ВЫБОР
				|			КОГДА ТаблицаПартийЦБ.ПоРЕПО
				|				ТОГДА ТаблицаПартийЦБ.Количество
				|			ИНАЧЕ 0
				|		КОНЕЦ) КАК КоличествоПоРЕПО
				|ПОМЕСТИТЬ _Остатки
				|ИЗ
				|	ТаблицаПартийЦБ КАК ТаблицаПартийЦБ
				|ГДЕ
				|	(НЕ ТаблицаПартийЦБ.КПоступлению
				|			ИЛИ &УчитыватьЦБКПоступлению)
				|
				|СГРУППИРОВАТЬ ПО
				|	ТаблицаПартийЦБ.Рынок,
				|	ТаблицаПартийЦБ.ЦеннаяБумага,
				|	ТаблицаПартийЦБ.КПоступлению
				|
				|ИМЕЮЩИЕ
				|	СУММА(ТаблицаПартийЦБ.Количество) <> 0";
			
				Запрос.Выполнить();
				
			Возврат;
		
