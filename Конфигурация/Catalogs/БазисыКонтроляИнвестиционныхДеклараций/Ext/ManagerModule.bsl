Функция ПолучитьОписаниеПолейРейтингов(НаборДанных) Экспорт

	ОписаниеПолей = СоздатьТаблицуОписанияПолей();
	
	ОписаниеТиповБулево = Новый ОписаниеТипов("Булево");
	ОписаниеТиповЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(4, 0, ДопустимыйЗнак.Любой));
	
	ПараметрыРедактирования = Новый Структура("ФорматРедактирования", "БЛ='Не входит в список шкал'; БИ='Входит в список шкал'");
	
	ПараметрВыбора = Новый ПараметрВыбора("Отбор.Родитель", Справочники.ВнешниеСистемы.КонтрольИнвестиционныхДеклараций);
	ПараметрыВыбора = Новый Структура("ПараметрыВыбора", ПараметрВыбора);
	
	ТипПриоритета = Метаданные.РегистрыСведений.СопоставлениеРейтинговыхШкал.Измерения.СтрокаСопоставления.Тип;
	
	Если НаборДанных = "Основной" Тогда
		
		ДобавитьОписаниеПоля(ОписаниеПолей.Добавить(), "Рейтинги.ВсегдаИстина", 					"ВсегдаИстина",				"Всегда истина", 		ОписаниеТиповБулево,,, Новый Структура("ОграничениеИспользования", Истина));
		ДобавитьОписаниеПоля(ОписаниеПолей.Добавить(), "Рейтинги.ЦеннаяБумага", 					"ЦеннаяБумага",				"Ценная бумага", 		Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип,,, Новый Структура("ОграничениеИспользования", Истина));
		ДобавитьОписаниеПоля(ОписаниеПолей.Добавить(), "Рейтинги.Эмитент", 							"Эмитент",					"Эмитент", 				Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"),,, Новый Структура("ОграничениеИспользования", Истина));
		ДобавитьОписаниеПоля(ОписаниеПолей.Добавить(), "Рейтинги.Гарант", 							"Гарант",					"Гарант",				Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"),,, Новый Структура("ОграничениеИспользования", Истина));
