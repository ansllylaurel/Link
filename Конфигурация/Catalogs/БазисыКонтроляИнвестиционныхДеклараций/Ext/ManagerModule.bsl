Функция СоздатьНаборДанныхЗапрос(СКД, ИмяНабора, ИсточникДанных, ТекстЗапроса)

	НаборДанных = СКД.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.АвтоЗаполнениеДоступныхПолей = Ложь;
	НаборДанных.Имя = ИмяНабора;
	НаборДанных.ИсточникДанных = ИсточникДанных;
	НаборДанных.Запрос = ТекстЗапроса;
		
	Возврат НаборДанных;

КонецФункции

Процедура ДобавитьСвязьНаборовДанных(СКД, НаборДанныхИсточник, НаборДанныхПриемник, ВыражениеИсточник, ВыражениеПриемник, Параметр = "")

	СвязьНаборов = СКД.СвязиНаборовДанных.Добавить();
	СвязьНаборов.НаборДанныхИсточник = НаборДанныхИсточник;
	СвязьНаборов.НаборДанныхПриемник = НаборДанныхПриемник;
	СвязьНаборов.ВыражениеИсточник = ВыражениеИсточник;
	СвязьНаборов.ВыражениеПриемник = ВыражениеПриемник;
	СвязьНаборов.Параметр = Параметр;

	// #501219 - убираем из доступных полей параметры СКД, т.к. использование в глобальном отборе параметра может вызвать ошибку.
	Если НаборДанныхИсточник = "ТаблицаБазиса" Тогда
		Если СКД.Параметры.Найти(Параметр) = Неопределено Тогда
			
			ПолеСвязиИсточник = СКД.НаборыДанных[0].Поля.Найти(ВыражениеИсточник); // на всякий случай заполним тип значения параметра, скопировав его из поля связи набора базиса
			
			ПараметрСКД = СКД.Параметры.Добавить();
			ПараметрСКД.Имя                    		= Параметр;
			ПараметрСКД.ВключатьВДоступныеПоля 		= Ложь;
			ПараметрСКД.ОграничениеИспользования 	= Истина;
			ПараметрСКД.Использование          		= ИспользованиеПараметраКомпоновкиДанных.Всегда;
			ЗаполнитьЗначенияСвойств(ПараметрСКД, ПолеСвязиИсточник, "ТипЗначения");
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПоляВНаборДанных(НаборДанных, ТаблицаПолей, ОграничениеИспользованияРеквизитов = Ложь)

	Для каждого ОписаниеПоля Из ТаблицаПолей Цикл
			
		НовоеПоле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		Если ОграничениеИспользованияРеквизитов Тогда
			НовоеПоле.ОграничениеИспользованияРеквизитов.Условие = Истина;
		КонецЕсли; 
		Если ОписаниеПоля.ОграничениеИспользования Тогда
			
			НовоеПоле.ОграничениеИспользования.Группировка = Истина;
			НовоеПоле.ОграничениеИспользования.Поле = Истина;
			НовоеПоле.ОграничениеИспользования.Порядок = Истина;
			НовоеПоле.ОграничениеИспользования.Условие = Истина;
			НовоеПоле.ОграничениеИспользованияРеквизитов.Группировка = Истина;
			НовоеПоле.ОграничениеИспользованияРеквизитов.Поле = Истина;
			НовоеПоле.ОграничениеИспользованияРеквизитов.Порядок = Истина;
			НовоеПоле.ОграничениеИспользованияРеквизитов.Условие = Истина;
			
		КонецЕсли; 
		ЗаполнитьЗначенияСвойств(НовоеПоле, ОписаниеПоля);
		
		Если СтрДлина(ОписаниеПоля.ДоступныеЗначения) > 0 Тогда
	
			МассивДоступныхЗначений = СтрРазделить(ОписаниеПоля.ДоступныеЗначения, ";", Ложь);
			СписокДоступныхЗначений = Новый СписокЗначений;
			Для каждого ЭлементМассива Из МассивДоступныхЗначений Цикл
				СписокДоступныхЗначений.Добавить(ЭлементМассива, ЭлементМассива);
			КонецЦикла; 
			НовоеПоле.УстановитьДоступныеЗначения(СписокДоступныхЗначений);
		
		КонецЕсли;
		
		Если ТипЗнч(ОписаниеПоля.ПараметрыРедактирования) = Тип("Структура") Тогда
			Для каждого ПараметрРедактирования Из ОписаниеПоля.ПараметрыРедактирования Цикл
				Если ПараметрРедактирования.Ключ = "ПараметрыВыбора" Тогда
					ПараметрыВыбора = НовоеПоле.ПараметрыРедактирования.Элементы.Найти("ПараметрыВыбора");
					ПараметрыВыбора.Использование = Истина;
					ЗаполнитьЗначенияСвойств(ПараметрыВыбора.Значение.Добавить(), ПараметрРедактирования.Значение);
				Иначе
					НовоеПоле.ПараметрыРедактирования.УстановитьЗначениеПараметра(ПараметрРедактирования.Ключ, ПараметрРедактирования.Значение);
				КонецЕсли; 
			КонецЦикла; 
		КонецЕсли 
		
	КонецЦикла;

КонецПроцедуры   

