		ДобавитьОписаниеПоля(ОписаниеПолей.Добавить(), "Рейтинги.Группа2.ИсточникДоп", 				"ИсточникДоп",				"Список шкал (доп.)", 			Новый ОписаниеТипов("СправочникСсылка.ВнешниеСистемы"),,, Новый Структура("ПараметрыРедактирования", ПараметрыВыбора));
