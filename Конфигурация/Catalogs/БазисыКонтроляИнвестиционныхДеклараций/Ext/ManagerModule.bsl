Функция СоздатьТаблицуОписанияПолей()

	ОписаниеТиповСтрока = Новый ОписаниеТипов("Строка");
	ОписаниеТиповБулево = Новый ОписаниеТипов("Булево");
	
	ОписаниеПолей = Новый ТаблицаЗначений;
	ОписаниеПолей.Колонки.Добавить("ПутьКДанным", 		ОписаниеТиповСтрока);	// используется для формирования СКД базиса. Если задать путь с указанием группы (Группа.Поле) - поля с одинаковым 
																				// именем группы будут сгруппированы в настройках отбора базиса и настройки контроля инвестиционной декларации
																				// при формировании СКД для построения отчета используется путь без указания группы
	ОписаниеПолей.Колонки.Добавить("Поле", 				ОписаниеТиповСтрока);	// имя колонки таблицы значений базиса, возвращаемой процедурой ПолучитьТаблицуБазиса() 
	ОписаниеПолей.Колонки.Добавить("Заголовок", 		ОписаниеТиповСтрока);	// представление поля
	ОписаниеПолей.Колонки.Добавить("Ключ", 				ОписаниеТиповБулево); 	// используется для однозначной идентификации строки таблицы при заполнении колонки ВходитВНабор (см. обработку Контроль инвест. декларации)
	ОписаниеПолей.Колонки.Добавить("Ресурс", 			ОписаниеТиповБулево); 	// если Истина - при формировании отчета поле будет добавлено в ресурсы с выражением Сумма(Поле)
	ОписаниеПолей.Колонки.Добавить("ВыражениеРесурса", 		Новый ОписаниеТипов("Строка")); // Содержит выражение, по которому будет осуществляться расчет итога по полю
	ОписаниеПолей.Колонки.Добавить("ГруппировкиРесурса",	Новый ОписаниеТипов("Массив")); // Массив, содержащий имена полей, для которых данное поле будет вычисляться в итогах
	ОписаниеПолей.Колонки.Добавить("ДоступныеЗначения", 	Новый ОписаниеТипов("Строка")); // строка, содержащая список доступных значений, разделитель - ";" без пробелов
	ОписаниеПолей.Колонки.Добавить("ТипЗначения", 				Новый ОписаниеТипов("ОписаниеТипов"));
	ОписаниеПолей.Колонки.Добавить("ОграничениеИспользования", 	ОписаниеТиповБулево);
	ОписаниеПолей.Колонки.Добавить("ПараметрыРедактирования", 	Новый ОписаниеТипов("Структура"));
	
	Возврат ОписаниеПолей;

КонецФункции

Процедура ДобавитьОписаниеПоля(НоваяСтрока, ПутьКДанным, Поле, Заголовок, ТипЗначения, Ключ = Ложь, ПараметрыРесурса = Неопределено, ДополнительныеПараметры = Неопределено)
	
	НоваяСтрока.ПутьКДанным = ПутьКДанным;
	НоваяСтрока.Поле = Поле;
	НоваяСтрока.Заголовок = Заголовок;
	НоваяСтрока.ТипЗначения = ТипЗначения;
	НоваяСтрока.Ключ = Ключ;
	
	Если ТипЗнч(ПараметрыРесурса) = Тип("Структура") Тогда
	
		НоваяСтрока.Ресурс = Истина;
		НоваяСтрока.ВыражениеРесурса = ПараметрыРесурса.Выражение;
		НоваяСтрока.ГруппировкиРесурса = ПараметрыРесурса.Группировки;
		
	ИначеЕсли ТипЗнч(ПараметрыРесурса) = Тип("Булево") И ПараметрыРесурса Тогда 
		
		НоваяСтрока.Ресурс = Истина;
		
		Если ТипЗначения = Новый ОписаниеТипов("Булево") Тогда
			НоваяСтрока.ВыражениеРесурса = "Максимум(" + ПутьКДанным + ")";
		ИначеЕсли ТипЗнч(ТипЗначения) = Тип("ОписаниеТипов") И ТипЗначения.СодержитТип(Тип("Число")) Тогда 
			НоваяСтрока.ВыражениеРесурса = "Сумма(" + ПутьКДанным + ")";
		Иначе
			НоваяСтрока.ВыражениеРесурса = "Количество(" + ПутьКДанным + ")";
		КонецЕсли; 
		
		НоваяСтрока.ГруппировкиРесурса = Новый Массив;
		
	КонецЕсли; 
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДополнительныеПараметры);
	
	КонецЕсли;
		
КонецПроцедуры
 
Процедура ДобавитьПоказатель(НоваяСтрока, Представление, ПутьКДанным, ВыражениеПоказатель, ВыражениеДоля, Группировки = "", ГруппировкаСтруктуры = "Служебные.ОбщийИтог", ИмяПоляДоля = "")

	НоваяСтрока.Представление 			= Представление;
	НоваяСтрока.ПутьКДанным 			= ПутьКДанным;
	НоваяСтрока.ВыражениеПоказатель 	= ВыражениеПоказатель;
	НоваяСтрока.ВыражениеДоля 			= ВыражениеДоля;
	Если Группировки = "" Тогда
		НоваяСтрока.Группировки = Новый Массив;
	Иначе
		НоваяСтрока.Группировки = СтрРазделить(Группировки, ",", Ложь);
	КонецЕсли;
	НоваяСтрока.ГруппировкаСтруктуры = ГруппировкаСтруктуры;
	НоваяСтрока.ИмяПоляДоля = ИмяПоляДоля;

КонецПроцедуры 

