			|	_ЦенныеБумаги.Актив КАК Актив,
			|	СУММА(_ЦенныеБумаги.Количество) КАК Количество,
			|	_ЦенныеБумаги.ЦенныеБумагиКПоступлению КАК КПоступлению,
			|	СУММА(ВЫБОР
			|			КОГДА _ЦенныеБумаги.ЦенныеБумагиПоРЕПО
			|				ТОГДА _ЦенныеБумаги.Количество
			|			ИНАЧЕ 0
			|		КОНЕЦ + ЕСТЬNULL(_ЦенныеБумагиПоРЕПО.Количество, 0)) КАК КоличествоПоРЕПО,
			|	СУММА(ВЫБОР
			|			КОГДА ЕСТЬNULL(_ЦенныеБумагиПоРЕПО.ЦенныеБумагиПоРЕПОсЦК, ЛОЖЬ)
			|				ТОГДА _ЦенныеБумагиПоРЕПО.Количество
			|			ИНАЧЕ 0
			|		КОНЕЦ) КАК КоличествоПоРЕПОсЦК
			|ПОМЕСТИТЬ _Остатки
			|ИЗ
			|	_ЦенныеБумаги КАК _ЦенныеБумаги
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумагиПоРЕПО КАК _ЦенныеБумагиПоРЕПО
			|		ПО _ЦенныеБумаги.Рынок = _ЦенныеБумагиПоРЕПО.Рынок
			|			И _ЦенныеБумаги.Актив = _ЦенныеБумагиПоРЕПО.Актив
			|			И _ЦенныеБумаги.ЦенныеБумагиКПоступлению = _ЦенныеБумагиПоРЕПО.ЦенныеБумагиКПоступлению
			|ГДЕ
			|	(НЕ _ЦенныеБумаги.ЦенныеБумагиКПоступлению
			|			ИЛИ &УчитыватьЦБКПоступлению)
			|
			|СГРУППИРОВАТЬ ПО
			|	_ЦенныеБумаги.Рынок,
			|	_ЦенныеБумаги.Актив,
			|	_ЦенныеБумаги.ЦенныеБумагиКПоступлению
			|
			|ИМЕЮЩИЕ
			|	СУММА(_ЦенныеБумаги.Количество) <> 0";
		
		Запрос.Выполнить();
		
		Запрос.Текст = 
			"УНИЧТОЖИТЬ _ЦенныеБумаги;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ЦенныеБумагиПоРЕПО";
		
		Запрос.Выполнить();
			
	КонецЕсли; 

КонецПроцедуры

Процедура СформироватьВременныеТаблицыЦенныхБумаг(НаборДанных, Параметры, Запрос, ЭтоТаблицаСЧА = Ложь)

	Если НаборДанных = "Основной" Тогда
		
		ОцениватьПоЦенамПриобретения = Не Параметры.КонтрольЗаПрошлыйПериод;
		
		Запрос.УстановитьПараметр("ОцениватьПоЦенамПриобретения", 	ОцениватьПоЦенамПриобретения);
		Запрос.УстановитьПараметр("ВидУчета", 						Параметры.ВидУчета);
		Запрос.УстановитьПараметр("ЦельРасчета", 					Параметры.ЦельРасчета);
		Запрос.УстановитьПараметр("Биржа", 							ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
		
		МассивИсходныхВТ = СоздатьМассивИсходныхВТ(Запрос.МенеджерВременныхТаблиц, "_Остатки, _ЗадолженностиПоВторойЧастиРЕПОСПлановымиДанными");
		
		Если ЭтоТаблицаСЧА Тогда
			СформироватьВременныеТаблицыОстатковПоМетодике(НаборДанных, Параметры, Запрос);
		Иначе
			СформироватьВременныеТаблицыОстатковДляКонтроляИД(НаборДанных, Параметры, Запрос);
		КонецЕсли;   
		
		УдалитьЛишниеВТ(Запрос.МенеджерВременныхТаблиц, МассивИсходныхВТ);
			
		#Область ТекстЗапроса_ОстаткиЦенныхБумаг
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВложенныйЗапрос.Рынок КАК Рынок,
			|	ВложенныйЗапрос.Актив КАК Актив,
			|	СУММА(ВложенныйЗапрос.Количество) КАК Количество,
			|	ВложенныйЗапрос.КПоступлению КАК КПоступлению,
			|	СУММА(ВложенныйЗапрос.КоличествоПоРЕПО) КАК КоличествоПоРЕПО,
			|	СУММА(ВложенныйЗапрос.КоличествоПоРЕПОсЦК) КАК КоличествоПоРЕПОсЦК,
			|	ВЫБОР
			|		КОГДА ВложенныйЗапрос.Актив ССЫЛКА Справочник.Акции
			|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Актив КАК Справочник.Акции).ВалютаНоминала
			|		КОГДА ВложенныйЗапрос.Актив ССЫЛКА Справочник.Векселя
			|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Актив КАК Справочник.Векселя).ВалютаНоминала
			|		КОГДА ВложенныйЗапрос.Актив ССЫЛКА Справочник.ДепозитарныеРасписки
			|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Актив КАК Справочник.ДепозитарныеРасписки).ВалютаНоминала
			|		КОГДА ВложенныйЗапрос.Актив ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
			|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Актив КАК Справочник.ИпотечныеСертификатыУчастия).ВалютаНоминала
			|		КОГДА ВложенныйЗапрос.Актив ССЫЛКА Справочник.Облигации
			|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Актив КАК Справочник.Облигации).ВалютаНоминала
			|		КОГДА ВложенныйЗапрос.Актив ССЫЛКА Справочник.Паи
			|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Актив КАК Справочник.Паи).ВалютаНоминала
			|		КОГДА ВложенныйЗапрос.Актив ССЫЛКА Справочник.ПроизводныеФинансовыеИнструменты
			|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Актив КАК Справочник.ПроизводныеФинансовыеИнструменты).Валюта
			|		КОГДА ВложенныйЗапрос.Актив ССЫЛКА Справочник.Доли
			|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Актив КАК Справочник.Доли).ВалютаНоминала
			|	КОНЕЦ КАК ВалютаНоминала,
			|	МАКСИМУМ(ВложенныйЗапрос.ДатаПоследнейПокупки) КАК ДатаПоследнейПокупки,
			|	ВложенныйЗапрос.Классификация КАК Классификация,
			|	ВложенныйЗапрос.АктивыОцениваемыеПоАС КАК АктивыОцениваемыеПоАС
			|ПОМЕСТИТЬ _ОстаткиЦенныхБумаг
			|ИЗ
			|	(ВЫБРАТЬ
			|		_Остатки.Рынок КАК Рынок,
			|		_Остатки.Актив КАК Актив,
			|		ЕСТЬNULL(_КлассификацияЦенныхБумаг.Количество, _Остатки.Количество - _Остатки.КоличествоПоРЕПО) КАК Количество,
			|		_Остатки.КПоступлению КАК КПоступлению,
			|		0 КАК КоличествоПоРЕПО,
			|		0 КАК КоличествоПоРЕПОсЦК,
			|		ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПоследнейПокупки,
			|		ЕСТЬNULL(_КлассификацияЦенныхБумаг.Классификация, """") КАК Классификация,
			|		ЕСТЬNULL(_КлассификацияЦенныхБумаг.АктивыОцениваемыеПоАС, Неопределено) КАК АктивыОцениваемыеПоАС
			|	ИЗ
			|		_Остатки КАК _Остатки
			|			ЛЕВОЕ СОЕДИНЕНИЕ _КлассификацияЦенныхБумаг КАК _КлассификацияЦенныхБумаг
			|			ПО _Остатки.Актив = _КлассификацияЦенныхБумаг.ЦеннаяБумага
			|				И _Остатки.КПоступлению = _КлассификацияЦенныхБумаг.КПоступлению
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		_Остатки.Рынок,
			|		_Остатки.Актив,
			|		_Остатки.КоличествоПоРЕПО,
			|		_Остатки.КПоступлению,
			|		_Остатки.КоличествоПоРЕПО,
			|		_Остатки.КоличествоПоРЕПОсЦК,
			|		ДАТАВРЕМЯ(1, 1, 1),
			|		"""",
			|		Неопределено
			|	ИЗ
			|		_Остатки КАК _Остатки
			|	ГДЕ
			|		_Остатки.КоличествоПоРЕПО > 0
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		_ЦенныеБумагиПретрейд.Рынок,
			|		_ЦенныеБумагиПретрейд.ЦеннаяБумага,
			|		_ЦенныеБумагиПретрейд.Количество,
			|		ЛОЖЬ,
			|		0,
			|		0,
			|		ВЫБОР
			|			КОГДА _ЦенныеБумагиПретрейд.Количество > 0
			|				ТОГДА &НачалоПериода
			|			ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
			|		КОНЕЦ,
			|		_ЦенныеБумагиПретрейд.Классификация,
			|		_ЦенныеБумагиПретрейд.АктивыОцениваемыеПоАС
			|	ИЗ
			|		_ЦенныеБумагиПретрейд КАК _ЦенныеБумагиПретрейд
			|	ГДЕ
			|		_ЦенныеБумагиПретрейд.Количество <> 0) КАК ВложенныйЗапрос
			|ГДЕ
			|	ВложенныйЗапрос.Количество <> 0
			|
			|СГРУППИРОВАТЬ ПО
			|	ВложенныйЗапрос.Рынок,
			|	ВложенныйЗапрос.Актив,
			|	ВложенныйЗапрос.АктивыОцениваемыеПоАС,
			|	ВложенныйЗапрос.КПоступлению,
			|	ВложенныйЗапрос.Классификация
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Рынок,
			|	Актив";			
		#КонецОбласти 
		
		Запрос.Выполнить();
		
		#Область ТекстЗапроса_ИтоговыеСтоимости_ТаблицаЦенныхБумаг
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ОстаткиЦенныхБумаг.Рынок КАК Рынок,
			|	ЕСТЬNULL(_СтоимостиПереоценкиОценка.Валюта, _ОстаткиЦенныхБумаг.ВалютаНоминала) КАК Валюта,
			|	_ОстаткиЦенныхБумаг.Актив КАК Актив,
			|	_ОстаткиЦенныхБумаг.Количество КАК Количество,
			|	_ОстаткиЦенныхБумаг.КПоступлению КАК ЦенныеБумагиКПоступлению,
			|	ЕСТЬNULL(_СтоимостиПереоценкиОценка.ОтсутствуетСтоимостьПереоценки, ИСТИНА)
			|		И ДефолтыПоОблигациямСрезПоследних.Облигация ЕСТЬ NULL КАК ОтсутствуетСтоимостьПереоценки,
			|	_ОстаткиЦенныхБумаг.КоличествоПоРЕПО КАК КоличествоПоРЕПО,
			|	_ОстаткиЦенныхБумаг.КоличествоПоРЕПОсЦК КАК КоличествоПоРЕПОсЦК,
			|	ВЫБОР
			|		КОГДА _ОстаткиЦенныхБумаг.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли)
			|			ТОГДА 1
			|		ИНАЧЕ _ОстаткиЦенныхБумаг.Количество
			|	КОНЕЦ * ЕСТЬNULL(_СтоимостиПереоценкиОценка.Цена, 0) КАК СуммаБезНКД,
			|	_ОстаткиЦенныхБумаг.Количество * ЕСТЬNULL(_СтоимостиПереоценкиОценка.ЦенаКупона, 0) КАК СуммаКупона,
			|	ВЫБОР
			|		КОГДА _ОстаткиЦенныхБумаг.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли)
			|			ТОГДА 1
			|		ИНАЧЕ _ОстаткиЦенныхБумаг.Количество
			|	КОНЕЦ * (ЕСТЬNULL(_СтоимостиПереоценкиОценка.Цена, 0) + ЕСТЬNULL(_СтоимостиПереоценкиОценка.ЦенаКупона, 0)) КАК Сумма,
			|	ЕСТЬNULL(_СтоимостиПереоценкиОценка.ЦенаДюрация, 0) КАК ЦенаДюрация,
			|	ЕСТЬNULL(_СтоимостиПереоценкиОценка.ЦенаКупонаДюрация, 0) КАК ЦенаКупонаДюрация,
			|	_ОстаткиЦенныхБумаг.Классификация КАК Классификация,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(_ОстаткиЦенныхБумаг.Актив) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
			|			ТОГДА ВЫРАЗИТЬ(_ОстаткиЦенныхБумаг.Актив КАК Справочник.ИпотечныеСертификатыУчастия).УчетныйАктивЦБРФ
			|		ИНАЧЕ НЕОПРЕДЕЛЕНО
			|	КОНЕЦ КАК ВидСертификатаУчастия
			|ПОМЕСТИТЬ _ИтоговыеСтоимости
			|ИЗ
			|	_ОстаткиЦенныхБумаг КАК _ОстаткиЦенныхБумаг
			|		ЛЕВОЕ СОЕДИНЕНИЕ _СправедливыеЦены КАК _СтоимостиПереоценкиОценка
			|		ПО (_СтоимостиПереоценкиОценка.Актив = _ОстаткиЦенныхБумаг.Актив)
			|			И (_СтоимостиПереоценкиОценка.АктивыОцениваемыеПоАС = _ОстаткиЦенныхБумаг.АктивыОцениваемыеПоАС
			|				ИЛИ _ОстаткиЦенныхБумаг.АктивыОцениваемыеПоАС = НЕОПРЕДЕЛЕНО)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДефолтыПоОблигациям.СрезПоследних(&НачалоПериода, ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации)) КАК ДефолтыПоОблигациямСрезПоследних
			|		ПО _ОстаткиЦенныхБумаг.Актив = ДефолтыПоОблигациямСрезПоследних.Облигация
			|			И (ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт))
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Рынок,
			|	Актив
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ИтоговыеСтоимости.Рынок КАК Рынок,
			|	ВЫБОР
			|		КОГДА _ИтоговыеСтоимости.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|			ТОГДА ""Облигации""
			|		КОГДА _ИтоговыеСтоимости.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
			|			ТОГДА ""Акции""
			|		КОГДА _ИтоговыеСтоимости.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
			|			ТОГДА ""Паи""
			|		КОГДА _ИтоговыеСтоимости.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
			|			ТОГДА ""Депозитарные расписки""
			|		КОГДА _ИтоговыеСтоимости.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
			|				И _ИтоговыеСтоимости.ВидСертификатаУчастия = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ИСУ)
			|			ТОГДА ""Ипотечные сертификаты участия""
			|		КОГДА _ИтоговыеСтоимости.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
			|				И _ИтоговыеСтоимости.ВидСертификатаУчастия = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.КСУ)
			|			ТОГДА ""Клиринговые сертификаты участия""
			|		КОГДА _ИтоговыеСтоимости.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
			|			ТОГДА ""Векселя""
			|		КОГДА _ИтоговыеСтоимости.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Опционы)
			|			ТОГДА ""Опционы""
			|		КОГДА _ИтоговыеСтоимости.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Фьючерсы)
			|			ТОГДА ""Фьючерсы""
			|		КОГДА _ИтоговыеСтоимости.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли)
			|			ТОГДА ""Доли""
			|	КОНЕЦ КАК ВидАктива,
			|	ВЫБОР
			|		КОГДА _ИтоговыеСтоимости.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|			ТОГДА ВЫРАЗИТЬ(_ИтоговыеСтоимости.Актив КАК Справочник.Облигации).Эмитент
			|		КОГДА _ИтоговыеСтоимости.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
			|			ТОГДА ВЫРАЗИТЬ(_ИтоговыеСтоимости.Актив КАК Справочник.Акции).Эмитент
			|		КОГДА _ИтоговыеСтоимости.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
			|			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания
			|		КОГДА _ИтоговыеСтоимости.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
			|			ТОГДА ВЫРАЗИТЬ(_ИтоговыеСтоимости.Актив КАК Справочник.ДепозитарныеРасписки).Эмитент
			|		КОГДА _ИтоговыеСтоимости.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
			|			ТОГДА ВЫРАЗИТЬ(_ИтоговыеСтоимости.Актив КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент
			|		КОГДА _ИтоговыеСтоимости.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
			|			ТОГДА ВЫРАЗИТЬ(_ИтоговыеСтоимости.Актив КАК Справочник.Векселя).Эмитент
			|	КОНЕЦ КАК Эмитент,
			|	_ИтоговыеСтоимости.Валюта КАК Валюта,
			|	_ИтоговыеСтоимости.Актив КАК Актив,
			|	_ИтоговыеСтоимости.Количество КАК Количество,
			|	_ИтоговыеСтоимости.ЦенныеБумагиКПоступлению КАК ЦенныеБумагиКПоступлению,
			|	_ИтоговыеСтоимости.ОтсутствуетСтоимостьПереоценки КАК ОтсутствуетСтоимостьПереоценки,
			|	_ИтоговыеСтоимости.КоличествоПоРЕПО КАК КоличествоПоРЕПО,
			|	_ИтоговыеСтоимости.КоличествоПоРЕПОсЦК КАК КоличествоПоРЕПОсЦК,
			|	НАЧАЛОПЕРИОДА(_ДатыПоследнихПокупок.ДатаПоследнейПокупки, ДЕНЬ) КАК ДатаПоследнейПокупки,
			|	_ДатыПоследнихПокупок.НаличиеСделокВДеньРасчета КАК НаличиеСделокВДеньРасчета,
			|	_ИтоговыеСтоимости.СуммаБезНКД КАК СуммаБезНКД,
			|	_ИтоговыеСтоимости.СуммаКупона КАК СуммаКупона,
			|	_ИтоговыеСтоимости.Сумма КАК Сумма,
			|	ВЫБОР
			|		КОГДА _ИтоговыеСтоимости.Количество = 0
			|			ТОГДА 0
			|		ИНАЧЕ _ИтоговыеСтоимости.КоличествоПоРЕПО * _ИтоговыеСтоимости.СуммаБезНКД / _ИтоговыеСтоимости.Количество
			|	КОНЕЦ КАК СуммаБезНКДПоРЕПО,
			|	ВЫБОР
			|		КОГДА _ИтоговыеСтоимости.Количество = 0
			|			ТОГДА 0
			|		ИНАЧЕ _ИтоговыеСтоимости.КоличествоПоРЕПО * _ИтоговыеСтоимости.СуммаКупона / _ИтоговыеСтоимости.Количество
			|	КОНЕЦ КАК СуммаКупонаПоРЕПО,
			|	ВЫБОР
			|		КОГДА _ИтоговыеСтоимости.Количество = 0
			|			ТОГДА 0
			|		ИНАЧЕ _ИтоговыеСтоимости.КоличествоПоРЕПО * _ИтоговыеСтоимости.Сумма / _ИтоговыеСтоимости.Количество
			|	КОНЕЦ КАК СуммаПоРЕПО,
			|	ВЫБОР
			|		КОГДА _ИтоговыеСтоимости.Количество = 0
			|			ТОГДА 0
			|		ИНАЧЕ _ИтоговыеСтоимости.КоличествоПоРЕПОсЦК * _ИтоговыеСтоимости.СуммаБезНКД / _ИтоговыеСтоимости.Количество
			|	КОНЕЦ КАК СуммаБезНКДПоРЕПОсЦК,
			|	ВЫБОР
			|		КОГДА _ИтоговыеСтоимости.Количество = 0
			|			ТОГДА 0
			|		ИНАЧЕ _ИтоговыеСтоимости.КоличествоПоРЕПОсЦК * _ИтоговыеСтоимости.СуммаКупона / _ИтоговыеСтоимости.Количество
			|	КОНЕЦ КАК СуммаКупонаПоРЕПОсЦК,
			|	ВЫБОР
			|		КОГДА _ИтоговыеСтоимости.Количество = 0
			|			ТОГДА 0
			|		ИНАЧЕ _ИтоговыеСтоимости.КоличествоПоРЕПОсЦК * _ИтоговыеСтоимости.Сумма / _ИтоговыеСтоимости.Количество
			|	КОНЕЦ КАК СуммаПоРЕПОсЦК,
			|	_ИтоговыеСтоимости.ЦенаДюрация КАК ЦенаДюрация,
			|	_ИтоговыеСтоимости.ЦенаКупонаДюрация КАК ЦенаКупонаДюрация,
			|	_ИтоговыеСтоимости.Классификация КАК Классификация
			|ПОМЕСТИТЬ _ТаблицаЦенныхБумаг
			|ИЗ
			|	_ИтоговыеСтоимости КАК _ИтоговыеСтоимости
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыПоследнихПокупок КАК _ДатыПоследнихПокупок
			|		ПО _ИтоговыеСтоимости.Рынок = _ДатыПоследнихПокупок.Рынок
			|			И _ИтоговыеСтоимости.Актив = _ДатыПоследнихПокупок.Актив
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&НачалоПериода, ) КАК РеквизитыПИФСрезПоследних
			|		ПО (ВЫРАЗИТЬ(_ИтоговыеСтоимости.Актив КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Рынок,
			|	Актив,
			|	_ИтоговыеСтоимости.Классификация";			
		#КонецОбласти 
			
		Запрос.Выполнить();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьВременнуюТаблицуДатыПоследнихПокупок(Запрос, Параметры)

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МаксПериодОстатков.Рынок КАК Рынок,
		|	МаксПериодОстатков.Актив КАК Актив,
		|	МаксПериодОстатков.Период КАК ДатаПоследнейПокупки,
		|	НАЧАЛОПЕРИОДА(МаксПериодОстатков.Период, ДЕНЬ) = &НачалоПериода КАК НаличиеСделокВДеньРасчета
		|ПОМЕСТИТЬ _МаксимальныеПериоды
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ОстаткиЦенныхБумаг.Рынок КАК Рынок,
		|		_ОстаткиЦенныхБумаг.Актив КАК Актив,
		|		МАКСИМУМ(ОстаткиЦенныхБумаг.Период) КАК Период
		|	ИЗ
		|		_ОстаткиЦенныхБумаг КАК _ОстаткиЦенныхБумаг
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг КАК ОстаткиЦенныхБумаг
		|			ПО (ОстаткиЦенныхБумаг.Активность)
		|				И (ОстаткиЦенныхБумаг.Период <= &Период)
		|				И (ОстаткиЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))
		|				И (ОстаткиЦенныхБумаг.Организация = &Организация)
		|				И (ОстаткиЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|				И _ОстаткиЦенныхБумаг.Рынок = ОстаткиЦенныхБумаг.Рынок
		|				И _ОстаткиЦенныхБумаг.Актив = ОстаткиЦенныхБумаг.ЦеннаяБумага
		|				И (НЕ ТИПЗНАЧЕНИЯ(ОстаткиЦенныхБумаг.Регистратор) = ТИП(Документ.ПереводЦенныхБумаг))
		|				И (НЕ ТИПЗНАЧЕНИЯ(ОстаткиЦенныхБумаг.Регистратор) = ТИП(Документ.ВводЦенныхБумаг))
		|				И (НЕ(ТИПЗНАЧЕНИЯ(ОстаткиЦенныхБумаг.Регистратор) = ТИП(Документ.КорректировкаРегистров)
		|						И НАЧАЛОПЕРИОДА(ОстаткиЦенныхБумаг.Период, ДЕНЬ) = &ДатаПереводаЦенныхБумагПриСменеСпецДепаНСДНаНФОТехнологии))
		|				И (НЕ _ОстаткиЦенныхБумаг.КПоступлению)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ОстаткиЦенныхБумаг.Рынок,
		|		_ОстаткиЦенныхБумаг.Актив
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		_ОстаткиЦенныхБумаг.Рынок,
		|		_ОстаткиЦенныхБумаг.Актив,
		|		МАКСИМУМ(ОперацииСЦеннымиБумагами.ДатаПокупки)
		|	ИЗ
		|		_ОстаткиЦенныхБумаг КАК _ОстаткиЦенныхБумаг
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг КАК ОстаткиЦенныхБумаг
		|			ПО (ОстаткиЦенныхБумаг.Активность)
		|				И (ОстаткиЦенныхБумаг.Период <= &Период)
		|				И (ОстаткиЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))
		|				И (ОстаткиЦенныхБумаг.Организация = &Организация)
		|				И (ОстаткиЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|				И _ОстаткиЦенныхБумаг.Рынок = ОстаткиЦенныхБумаг.Рынок
		|				И _ОстаткиЦенныхБумаг.Актив = ОстаткиЦенныхБумаг.ЦеннаяБумага
		|				И (ТИПЗНАЧЕНИЯ(ОстаткиЦенныхБумаг.Регистратор) = ТИП(Документ.ВводЦенныхБумаг))
		|				И (НЕ _ОстаткиЦенныхБумаг.КПоступлению)
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|			ПО (ОстаткиЦенныхБумаг.Регистратор = ОперацииСЦеннымиБумагами.Регистратор)
		|				И _ОстаткиЦенныхБумаг.Рынок = ОперацииСЦеннымиБумагами.Рынок
		|				И _ОстаткиЦенныхБумаг.Актив = ОперацииСЦеннымиБумагами.ЦеннаяБумага
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ОстаткиЦенныхБумаг.Рынок,
		|		_ОстаткиЦенныхБумаг.Актив) КАК МаксПериодОстатков
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ОстаткиЦенныхБумаг.Рынок,
		|	_ОстаткиЦенныхБумаг.Актив,
		|	ЗадолженностиПоЦеннымБумагам.Период,
		|	НАЧАЛОПЕРИОДА(ЗадолженностиПоЦеннымБумагам.Период, ДЕНЬ) = &НачалоПериода
		|ИЗ
		|	_ОстаткиЦенныхБумаг КАК _ОстаткиЦенныхБумаг
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоЦеннымБумагам КАК ЗадолженностиПоЦеннымБумагам
		|		ПО (ЗадолженностиПоЦеннымБумагам.Активность)
		|			И (ЗадолженностиПоЦеннымБумагам.Период <= &Период)
		|			И (ЗадолженностиПоЦеннымБумагам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))
		|			И (ЗадолженностиПоЦеннымБумагам.Организация = &Организация)
		|			И (ЗадолженностиПоЦеннымБумагам.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|			И (ЗадолженностиПоЦеннымБумагам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская))
		|			И (ЗадолженностиПоЦеннымБумагам.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО)))
		|			И _ОстаткиЦенныхБумаг.Актив = ЗадолженностиПоЦеннымБумагам.ЦеннаяБумага
		|			И (НЕ _ОстаткиЦенныхБумаг.КПоступлению)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Рынок,
		|	Актив
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_МаксимальныеПериоды.Рынок КАК Рынок,
		|	_МаксимальныеПериоды.Актив КАК Актив,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА _ОстаткиЦенныхБумаг.ДатаПоследнейПокупки = ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА _МаксимальныеПериоды.ДатаПоследнейПокупки
		|			ИНАЧЕ _ОстаткиЦенныхБумаг.ДатаПоследнейПокупки
		|		КОНЕЦ) КАК ДатаПоследнейПокупки,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА _ОстаткиЦенныхБумаг.ДатаПоследнейПокупки = ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА _МаксимальныеПериоды.НаличиеСделокВДеньРасчета
		|			ИНАЧЕ НАЧАЛОПЕРИОДА(_ОстаткиЦенныхБумаг.ДатаПоследнейПокупки, ДЕНЬ) = &НачалоПериода
		|		КОНЕЦ) КАК НаличиеСделокВДеньРасчета
		|ПОМЕСТИТЬ _ДатыПоследнихПокупок
		|ИЗ
		|	_ОстаткиЦенныхБумаг КАК _ОстаткиЦенныхБумаг
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МаксимальныеПериоды КАК _МаксимальныеПериоды
		|		ПО _ОстаткиЦенныхБумаг.Рынок = _МаксимальныеПериоды.Рынок
		|			И _ОстаткиЦенныхБумаг.Актив = _МаксимальныеПериоды.Актив
		|
		|СГРУППИРОВАТЬ ПО
		|	_МаксимальныеПериоды.Актив,
		|	_МаксимальныеПериоды.Рынок
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Рынок,
		|	Актив
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _МаксимальныеПериоды";
	
	Запрос.УстановитьПараметр("ДатаПереводаЦенныхБумагПриСменеСпецДепаНСДНаНФОТехнологии", '20260720');
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура СформироватьВременныеТаблицыАктивовНеОтносящихсяКЦеннымБумагам(НаборДанных, Параметры, Запрос)

	Если НаборДанных = "Основной" Тогда
		
		Если Не Параметры.ДинамическийРасчетСтоимости Тогда
			ЗапросКонтроль = Новый Запрос;
			ЗапросКонтроль.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
					|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период
					|ИЗ
					|	РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
					|ГДЕ
					|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Организация = &Организация
					|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления = &СчетДоверительногоУправления
					|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период = &НачалоПериода";
			ЗапросКонтроль.УстановитьПараметр("Организация", Параметры.Организация);
			ЗапросКонтроль.УстановитьПараметр("СчетДоверительногоУправления", Параметры.СчетДоверительногоУправления);
			ЗапросКонтроль.УстановитьПараметр("НачалоПериода", НачалоДня(Параметры.Период));
		КонецЕсли;
				
		Если Параметры.ДинамическийРасчетСтоимости Или (КонецДня(ТекущаяДатаСеанса()) <= Параметры.Период) Или ЗапросКонтроль.Выполнить().Пустой() Тогда
			
			УстановитьПривилегированныйРежим(Истина);
			МассивСообщений = ПолучитьСообщенияПользователю(Истина);
			РегистрацияСтоимостиАктивов = Документы.РегистрацияСтоимостиАктивов.СоздатьДокумент();
			ЗаполнитьЗначенияСвойств(РегистрацияСтоимостиАктивов, Параметры);
			РегистрацияСтоимостиАктивов.Дата 						= НачалоДня(Параметры.Период);
			РегистрацияСтоимостиАктивов.ЦельРасчетаСтоимостиОценки 	= Параметры.ЦельРасчета;
			
			ПараметрыЗаполнения = Новый Структура;
			ПараметрыЗаполнения.Вставить("Период", 					     		НачалоДня(Параметры.Период));
			ПараметрыЗаполнения.Вставить("Организация", 				 		Параметры.Организация);
			ПараметрыЗаполнения.Вставить("СчетДоверительногоУправления", 		Параметры.СчетДоверительногоУправления);
			ПараметрыЗаполнения.Вставить("ВалютаРубли",  				 		Параметры.Организация.ВалютаУчета);
			ПараметрыЗаполнения.Вставить("ЦельРасчета", 						Параметры.ЦельРасчета);
