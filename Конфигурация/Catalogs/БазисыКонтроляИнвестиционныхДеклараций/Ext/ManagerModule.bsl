КонецФункции

Функция ПолучитьДанныеБазиса(НаборДанных, Параметры, РежимПолученияБазы) Экспорт

	Если НаборДанных = "Основной" Тогда
		
		ОцениватьПоЦенамПриобретения = Не Параметры.КонтрольЗаПрошлыйПериод;

		Запрос = Новый Запрос;
		
		Для каждого Параметр Из Параметры Цикл
			Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
		КонецЦикла; 
		
		Запрос.УстановитьПараметр("ЮрФизЛицоФонда", 				Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(Параметры.СчетДоверительногоУправления, Параметры.Период));
		Запрос.УстановитьПараметр("НачалоПериода",					НачалоДня(Параметры.Период));
		Запрос.УстановитьПараметр("ОцениватьПоЦенамПриобретения",	ОцениватьПоЦенамПриобретения);
		Запрос.УстановитьПараметр("РынкиЦенныхБумаг", 				ПолучитьРынкиЦенныхБумаг(Параметры));
		Запрос.УстановитьПараметр("НачалоТекущегоДня",				НачалоДня(ТекущаяДатаСеанса()));
		
		// если период в прошлом, ищем цены на дату контроля ИД, иначе - из настроек формирования СЧА
		Если Параметры.КонтрольЗаПрошлыйПериод Тогда
			ДатаФормированияСЧА = НачалоДня(Параметры.Период);
		Иначе
			ДатаФормированияСЧА = РегистрыСведений.НастройкиФормированияСЧА.ПолучитьБлижайшуюДатуФормированияСЧА(
				Параметры.Организация, 
				Параметры.СчетДоверительногоУправления, 
				НачалоДня(ТекущаяДатаСеанса()) - 3600*24);
		КонецЕсли; 
		
		Если Не ЗначениеЗаполнено(ДатаФормированияСЧА) Тогда
			
			ТекстОшибки = СтрШаблон("Для клиента %1 не заданы настройки формирования СЧА на %2", Параметры.СчетДоверительногоУправления, Формат(НачалоДня(ТекущаяДатаСеанса()) - 3600*24, "ДФ=dd.MM.yyyy"));
			Параметры.Вставить("ТекстОшибки", ТекстОшибки);
			Возврат Неопределено;
		
		КонецЕсли; 
		
		Параметры.Вставить("ДатаФормированияСЧА", ДатаФормированияСЧА);
		Параметры.Вставить("ДатаКурса", НачалоДня(?(Параметры.КонтрольЗаПрошлыйПериод, Параметры.Период, ТекущаяДатаСеанса())));
		
		ЭтоЮгория = (Параметры.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ГСК_ЮГОРИЯ"));
		Запрос.УстановитьПараметр("ЭтоЮгория", ЭтоЮгория);
		Запрос.УстановитьПараметр("Облигация_СегежаГрупп_002", ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_СегежаГрупп_002"));
		
		Запрос.УстановитьПараметр("ДатаКурса", Параметры.ДатаКурса);
		
		Если Параметры.МенеджерВременныхТаблиц = Неопределено Тогда
			
			Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			
			Если Параметры.УчитыватьПлановыеОперации И Не Параметры.КонтрольЗаПрошлыйПериод Тогда
			
				РегистрыСведений.ОперацииСЦеннымиБумагами.ПолучитьТаблицуПлановыхОпераций(Параметры.ПараметрыПолученияТаблицыПлановыхОпераций, Запрос.МенеджерВременныхТаблиц);
					
				Для каждого Таблица Из Запрос.МенеджерВременныхТаблиц.Таблицы Цикл
					Если СтрНачинаетсяС(Таблица.ПолноеИмя, "_ПлановыеДанные_") Тогда//И Не Таблица.ПолноеИмя = "_ПлановыеДанные_Операции" Тогда
						// Используется для последующего вывода на форму контроля ИД
						Параметры.Вставить(Таблица.ПолноеИмя, Таблица.ПолучитьДанные().Выгрузить());
					КонецЕсли; 			
				КонецЦикла; 
				
			Иначе
				
				СформироватьПустыеВременныеТаблицыПлановыхОпераций(НаборДанных, Запрос);
			
			КонецЕсли;
			
			СформироватьВременныеТаблицыКлассификацииЦБ(НаборДанных, Параметры, Запрос);
			СформироватьВременныеТаблицыПретрейда(НаборДанных, Параметры, Запрос);
			ПолучитьСтоимостиЦеннныхБумагДляКонтроляИД(НаборДанных, Параметры, Запрос);
			
		Иначе
			
			Запрос.МенеджерВременныхТаблиц = Параметры.МенеджерВременныхТаблиц;
			
		КонецЕсли; 
		
		МассивИсходныхВТ = СоздатьМассивИсходныхВТ(Запрос.МенеджерВременныхТаблиц);
		
		ТаблицаБазиса = ПолучитьТаблицуБазиса(НаборДанных, Параметры, Запрос);
		Если Параметры.Свойство("ТекстОшибки") Тогда
			Возврат Неопределено;
		КонецЕсли; 
		
		ТаблицаСЧА = Неопределено;
				
		Если НЕ Параметры.ТаблицаСЧА = Неопределено Тогда
			
			ТаблицаСЧА = Параметры.ТаблицаСЧА;
			
		ИначеЕсли РежимПолученияБазы = 0 Тогда
		
			ТаблицаСЧА = ПолучитьТаблицуСЧА(НаборДанных, Параметры, Запрос);
			
			Если Параметры.КонтролироватьЧувствительность Тогда
				КонтрольЧувствительности_МаксимальноеЗначение = ТаблицаСЧА.Итог("БазаСумма") * ПолучитьКоэффициентПоказателяЧувствительности(Параметры.СчетДоверительногоУправления, Параметры.Период) / 100;
				ТаблицаБазиса.ЗаполнитьЗначения(КонтрольЧувствительности_МаксимальноеЗначение, "КонтрольЧувствительности_МаксимальноеЗначение");
			КонецЕсли;
			
		КонецЕсли; 
		
		Если Параметры.Свойство("КонтролироватьMaxDD") И Параметры.КонтролироватьMaxDD Тогда
		
			ДобавитьПоказательМаксДД(ТаблицаБазиса, Параметры);
		
		КонецЕсли;
		
		// Сохраним МВТ для других базисов
		УдалитьЛишниеВТ(Запрос.МенеджерВременныхТаблиц, МассивИсходныхВТ);
		Если Параметры.МенеджерВременныхТаблиц = Неопределено Тогда
			Параметры.Вставить("МенеджерВременныхТаблиц", Запрос.МенеджерВременныхТаблиц);
		КонецЕсли; 
		
		Возврат Новый Структура("ТаблицаБазиса, ТаблицаСЧА", ТаблицаБазиса, ТаблицаСЧА);
		
	КонецЕсли; 

КонецФункции

Функция СоздатьМассивИсходныхВТ(МенеджерВременныхТаблиц, ДополнительныеТаблицы = "")

	МассивИсходныхВТ = Новый Массив;
	Для каждого Таблица Из МенеджерВременныхТаблиц.Таблицы Цикл
		МассивИсходныхВТ.Добавить(Таблица.ПолноеИмя);
	КонецЦикла;
	
	МассивДополнительныхТаблиц = СтрРазделить(СтрЗаменить(ДополнительныеТаблицы, " ", ""), ",", Ложь);
	Для каждого ИмяТаблицы Из МассивДополнительныхТаблиц Цикл
		МассивИсходныхВТ.Добавить(ИмяТаблицы);
	КонецЦикла;
	
	Возврат МассивИсходныхВТ;

КонецФункции

Процедура УдалитьЛишниеВТ(МенеджерВременныхТаблиц, МассивИсходныхТаблиц)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Для каждого Таблица Из Запрос.МенеджерВременныхТаблиц.Таблицы Цикл
		Если Не СтрЗаканчиваетсяНа(Таблица.ПолноеИмя, "БезОтборов") Тогда
			
			Если МассивИсходныхТаблиц.Найти(Таблица.ПолноеИмя) = Неопределено Тогда
				Запрос.Текст = Запрос.Текст + 
					"УНИЧТОЖИТЬ " + Таблица.ПолноеИмя + "
					|;
					|";
			КонецЕсли; 			
			
		КонецЕсли; 
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Запрос.Текст) Тогда
		Запрос.Выполнить();
	КонецЕсли; 	

КонецПроцедуры

Функция ПолучитьЦенныеБумагиПоНРД(Параметры)
	
	ЦенныеБумагиПоНРД = Новый Массив;
	
	Если Параметры.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_DU_PIF352") 
		И БухгалтерскийУчет.ОпределитьНастройкуУчета(Параметры.ДатаФормированияСЧА, Параметры.Организация, Параметры.СчетДоверительногоУправления, "ПриостановленРасчетСЧА") Тогда
		
		ЦенныеБумагиПоНРД.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_CBOM_1759801720"));
		ЦенныеБумагиПоНРД.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_VEB_5.942_11/21"));
		ЦенныеБумагиПоНРД.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_VEB_6.811/22/25"));
		
	КонецЕсли;
	
	Возврат ЦенныеБумагиПоНРД;

КонецФункции
 
