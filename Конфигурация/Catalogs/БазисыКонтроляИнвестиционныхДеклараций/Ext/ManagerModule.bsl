			|		ПО (ПериодыКлючевыхСтавок.ПериодКлючевой = ПроцентныеПоказателиСрезПоследних.ДатаЗначения)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумагиПретрейд КАК _ЦенныеБумагиПретрейд
			|		ПО _Объединение.Рынок = _ЦенныеБумагиПретрейд.Рынок
			|			И _Объединение.Актив = _ЦенныеБумагиПретрейд.ЦеннаяБумага
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КотировкиПредыдущегоТорговогоДня КАК _КотировкиПредыдущегоТорговогоДня
			|		ПО _Объединение.Рынок = _КотировкиПредыдущегоТорговогоДня.Рынок
			|			И _Объединение.Актив = _КотировкиПредыдущегоТорговогоДня.ЦеннаяБумага
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Векселя КАК Векселя
			|		ПО _Объединение.Актив = Векселя.Ссылка
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеРасписки КАК ДепозитарныеРасписки
			|		ПО _Объединение.Актив = ДепозитарныеРасписки.Ссылка
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Закладные КАК Закладные
			|		ПО _Объединение.Актив = Закладные.Ссылка
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия
			|		ПО _Объединение.Актив = ИпотечныеСертификатыУчастия.Ссылка";
		#КонецОбласти
		
		ПолучитьДюрациюДляСНГ = Ложь;
		ПолучитьДюрациюММВБ = Ложь;
		ПолучитьДюрациюРостех = Ложь;
			
		Если Параметры.Свойство("МетодРасчетаДюрации") Тогда
			
			Если Параметры.МетодРасчетаДюрации = "ММВБ" Тогда
				ПолучитьДюрациюММВБ = Истина;
			ИначеЕсли Параметры.МетодРасчетаДюрации = "СНГ" Тогда
				ПолучитьДюрациюДляСНГ = Истина;
				ПолучитьДюрациюММВБ = Истина;
			ИначеЕсли Параметры.МетодРасчетаДюрации = "СНГ_Расчетная" Тогда
				ПолучитьДюрациюДляСНГ = Истина;
			ИначеЕсли Параметры.МетодРасчетаДюрации = "Ростех" Тогда
				ПолучитьДюрациюРостех = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ЧистыйМесячныйОтток", ПолучитьЧистыйМесячныйОтток(Параметры.СчетДоверительногоУправления, Параметры.Период));
		Запрос.УстановитьПараметр("ПолучитьДюрациюДляСНГ", ПолучитьДюрациюДляСНГ);
		Запрос.УстановитьПараметр("ПолучитьДюрациюММВБ", ПолучитьДюрациюММВБ);
		Запрос.УстановитьПараметр("ПолучитьДюрациюРостех", ПолучитьДюрациюРостех);
		Запрос.УстановитьПараметр("БиржаММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
		Запрос.УстановитьПараметр("КалендарьКотировок", Константы.ОсновнойКалендарьКотировок.Получить());
		
		ТаблицаБазиса = Запрос.Выполнить().Выгрузить();
		ДобавитьНедостающиеКолонкиРесурсовБазиса(НаборДанных, ТаблицаБазиса);
		
		СтрокиДляРасчетаДюрации = ТаблицаБазиса.НайтиСтроки(Новый Структура("Рынок", Перечисления.РынкиЦенныхБумаг.Облигации));
		
		Для Каждого ТекСтрока Из СтрокиДляРасчетаДюрации Цикл
			
			Если (ПолучитьДюрациюДляСНГ Или ПолучитьДюрациюММВБ Или ПолучитьДюрациюРостех) И ТекСтрока.Дюрация <> Неопределено Тогда
				// Дюрация уже должна быть в таблице базиса. Для бумаг с фиксированным купоном берем дюрацию с ММВБ
				// Для остальных - кол-во дней до оферты put или погашения
				// Под фиксированным купоном понимаем облигации с пустой базовой ставкой и типом КупоннаяПД
				// Если с ММВБ данные не получили или пришла нулевая дюрация, в поле дюрация будет Неопрееделено и мы пойдем в следующую ветку ИначеЕсли
								
			ИначеЕсли ЗначениеЗаполнено(ТекСтрока.ДюрацияПретрейд) Тогда
				
				ТекСтрока.Дюрация = ТекСтрока.ДюрацияПретрейд;
				ТекСтрока.ИсточникДюрации = "Пользовательская";
				
			ИначеЕсли ЗначениеЗаполнено(ТекСтрока.Цена) Тогда
				
				ДанныеРасчета = Справочники.Облигации.ПолучитьДоходностьИДюрацию(ТекСтрока.Актив, Ложь, Запрос.Параметры.НачалоПериода, ТекСтрока.ЦенаДюрация, Запрос.Параметры.СчетДоверительногоУправления, Запрос.Параметры.Биржа, , , ТекСтрока.ЦенаКупонаДюрация); 
				ТекСтрока.Дюрация = ДанныеРасчета.Дюрация;
				ТекСтрока.МодифицированнаяДюрация = ДанныеРасчета.Дюрация / (1 + ДанныеРасчета.Доходность / 100);
				ТекСтрока.ИсточникДюрации = "Расчетная";
				
			Иначе
				
				ТекСтрока.Дюрация = 0;
				ТекСтрока.ИсточникДюрации = "";
				
			КонецЕсли;
			
			Если ТекСтрока.КоличествоПоРЕПО > 0 Тогда
				
				ДанныеРасчетаПоРЕПО = ПолучитьДанныеРасчетаДюрацииПоРЕПО(Запрос, ТекСтрока);
				ТекСтрока.ДоляДюрацииБезРЕПО = (ТекСтрока.Количество - ДанныеРасчетаПоРЕПО.Количество) / ТекСтрока.Количество;
				ТекСтрока.ДоляДюрацииПоРЕПО = ДанныеРасчетаПоРЕПО.ДоляДюрации;
				
			Иначе
				
				ТекСтрока.ДоляДюрацииБезРЕПО = 1;
				ТекСтрока.ДоляДюрацииПоРЕПО = 0;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ТаблицаРасхожденийЦен = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ТаблицаРасхожденийЦен");
		Если ТаблицаРасхожденийЦен = Неопределено Тогда
			Параметры.Вставить("ТаблицаРасхожденийЦен", Неопределено);
		Иначе
			Параметры.Вставить("ТаблицаРасхожденийЦен", ТаблицаРасхожденийЦен.ПолучитьДанные().Выгрузить());
		КонецЕсли;
		
		Запрос.Текст =
		#Область ТекстЗапроса
			"УНИЧТОЖИТЬ _Остатки;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ОстаткиЦенныхБумаг;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ИтоговыеСтоимости;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ТаблицаЦенныхБумаг;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _СтоимостьАктивовНеЦБ;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _Объединение;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ОбъемыТоргов;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _КонтрольЧувствительности";
		#КонецОбласти
		Запрос.Выполнить();
		
		Возврат ТаблицаБазиса;
	КонецЕсли;
КонецФункции

Процедура ДобавитьНедостающиеКолонкиРесурсовБазиса(НаборДанных, ТаблицаБазиса);

	ОписаниеПолей = ПолучитьОписаниеПолейБазиса(НаборДанных);
	Для каждого ОписаниеПоля Из ОписаниеПолей Цикл
		Если Не ПустаяСтрока(ОписаниеПоля.ВыражениеРесурса) И ТаблицаБазиса.Колонки.Найти(ОписаниеПоля.Поле) = Неопределено Тогда
			ТаблицаБазиса.Колонки.Добавить(ОписаниеПоля.Поле, ОписаниеПоля.ТипЗначения);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьДанныеРасчетаДюрацииПоРЕПО(Запрос, ТекСтрока)
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_СрокиРЕПО") = Неопределено Тогда
	
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ЗадолженностиПоВторойЧастиРЕПОСПлановымиДанными.ЦеннаяБумага КАК ЦеннаяБумага,
			|	РАЗНОСТЬДАТ(&НачалоПериода, УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО, ДЕНЬ) КАК СрокВДнях,
			|	СУММА(_ЗадолженностиПоВторойЧастиРЕПОСПлановымиДанными.Количество) КАК Количество
			|ПОМЕСТИТЬ _СрокиРЕПО
			|ИЗ
			|	_ЗадолженностиПоВторойЧастиРЕПОСПлановымиДанными КАК _ЗадолженностиПоВторойЧастиРЕПОСПлановымиДанными
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
			|				&Период,
			|				(Организация, СделкаРЕПО, ЧастьСделкиРЕПО, Рынок, ЦеннаяБумага) В
			|					(ВЫБРАТЬ
			|						&Организация,
			|						_ЗадолженностиПоВторойЧастиРЕПОСПлановымиДанными.СделкаРЕПО,
			|						2,
			|						ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации),
			|						_ЗадолженностиПоВторойЧастиРЕПОСПлановымиДанными.ЦеннаяБумага
			|					ИЗ
			|						_ЗадолженностиПоВторойЧастиРЕПОСПлановымиДанными КАК _ЗадолженностиПоВторойЧастиРЕПОСПлановымиДанными)) КАК УсловияСделокРЕПОСрезПоследних
			|		ПО _ЗадолженностиПоВторойЧастиРЕПОСПлановымиДанными.СделкаРЕПО = УсловияСделокРЕПОСрезПоследних.СделкаРЕПО
			|ГДЕ
			|	_ЗадолженностиПоВторойЧастиРЕПОСПлановымиДанными.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|
			|СГРУППИРОВАТЬ ПО
			|	_ЗадолженностиПоВторойЧастиРЕПОСПлановымиДанными.ЦеннаяБумага,
			|	РАЗНОСТЬДАТ(&НачалоПериода, УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО, ДЕНЬ)";
		Запрос.Выполнить();
	
	КонецЕсли; 
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СрокиРЕПО.СрокВДнях КАК СрокВДнях,
		|	_СрокиРЕПО.Количество КАК Количество
		|ИЗ
		|	_СрокиРЕПО КАК _СрокиРЕПО
		|ГДЕ
		|	_СрокиРЕПО.ЦеннаяБумага = &Актив";
	
	Запрос.УстановитьПараметр("Актив", ТекСтрока.Актив);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ДоляДюрации = 0;
	Количество = 0;
	
	Пока Выборка.Следующий() Цикл
	
		Количество = Количество + Выборка.Количество;
		ДоляПоСделке = Выборка.Количество / ТекСтрока.Количество;
		ДоляДюрации = ДоляДюрации + ДоляПоСделке * Выборка.СрокВДнях;
	
	КонецЦикла; 
		
	Возврат Новый Структура("ДоляДюрации, Количество", ДоляДюрации, Количество);
	
КонецФункции

Функция ПолучитьРынкиЦенныхБумаг(Параметры)

	РынкиЦенныхБумаг = Новый Массив;
		
	Если Параметры.Акции Тогда
		РынкиЦенныхБумаг.Добавить(Перечисления.РынкиЦенныхБумаг.Акции);
	КонецЕсли; 
	Если Параметры.Облигации Или Параметры.НКДВДТ Тогда
		РынкиЦенныхБумаг.Добавить(Перечисления.РынкиЦенныхБумаг.Облигации);
	КонецЕсли; 
	Если Параметры.Паи Тогда
		РынкиЦенныхБумаг.Добавить(Перечисления.РынкиЦенныхБумаг.Паи);
	КонецЕсли;
	Если Параметры.ДепозитарныеРасписки Тогда
		РынкиЦенныхБумаг.Добавить(Перечисления.РынкиЦенныхБумаг.ДепозитарныеРасписки);
	КонецЕсли; 
	Если Параметры.ИпотечныеСертификатыУчастия Тогда
		РынкиЦенныхБумаг.Добавить(Перечисления.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия);
	КонецЕсли;
	Если Параметры.Доли Тогда
		РынкиЦенныхБумаг.Добавить(Перечисления.РынкиЦенныхБумаг.Доли);
	КонецЕсли;
	
	Возврат РынкиЦенныхБумаг;

КонецФункции

Процедура СформироватьВременныеТаблицыПретрейда(НаборДанных, Параметры, Запрос)

	Если НаборДанных = "Основной" Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Претрейд.ЭтоПретрейд КАК ЭтоПретрейд,
			|	Претрейд.НеУчитывать КАК НеУчитывать,
			|	Претрейд.ВидАктива КАК ВидАктива,
			|	Претрейд.БрокерРасчетныйСчет КАК БрокерРасчетныйСчет,
			|	Претрейд.Депозит КАК Депозит,
			|	Претрейд.ЮрФизЛицо КАК ЮрФизЛицо,
			|	Претрейд.Валюта КАК Валюта,
			|	Претрейд.ВидОперации КАК ВидОперации,
			|	Претрейд.Рынок КАК Рынок,
			|	Претрейд.ЦеннаяБумага КАК ЦеннаяБумага,
			|	Претрейд.Количество КАК Количество,
			|	Претрейд.Цена КАК Цена,
			|	Претрейд.Купон КАК Купон,
			|	Претрейд.Сумма КАК Сумма,
			|	Претрейд.СуммаДС КАК СуммаДС,
			|	Претрейд.Классификация КАК Классификация,
			|	Претрейд.ДатаПогашенияДепозита КАК ДатаПогашенияДепозита,
			|	Претрейд.Дюрация КАК Дюрация
			|ПОМЕСТИТЬ _Претрейд
			|ИЗ
			|	&Претрейд КАК Претрейд
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЦенныеБумагиПретрейд.Рынок КАК Рынок,
			|	ЦенныеБумагиПретрейд.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ЦенныеБумагиПретрейд.Классификация КАК Классификация,
			|	ЦенныеБумагиПретрейд.Классификация В (""Удерживаемые до погашения"", ""По амортизированной стоимости"") КАК АктивыОцениваемыеПоАС,
			|	СУММА(ЦенныеБумагиПретрейд.Количество) КАК Количество,
			|	ВЫБОР
			|		КОГДА СУММА(ЦенныеБумагиПретрейд.Количество) = 0
			|			ТОГДА СУММА(ЦенныеБумагиПретрейд.Цена) / КОЛИЧЕСТВО(ЦенныеБумагиПретрейд.Цена)
			|		ИНАЧЕ СУММА(ЦенныеБумагиПретрейд.Сумма) / СУММА(ЦенныеБумагиПретрейд.Количество) - ЦенныеБумагиПретрейд.Купон
			|	КОНЕЦ КАК Цена,
			|	ЦенныеБумагиПретрейд.Купон КАК Купон,
			|	СУММА(ЦенныеБумагиПретрейд.Сумма) КАК Сумма,
			|	0 КАК КурсВалютыНоминала,
			|	ЛОЖЬ КАК ЦенаТМинус2,
			|	ЦенныеБумагиПретрейд.Дюрация КАК Дюрация
			|ПОМЕСТИТЬ _ЦенныеБумагиПретрейд
			|ИЗ
			|	_Претрейд КАК ЦенныеБумагиПретрейд
			|ГДЕ
			|	ЦенныеБумагиПретрейд.ЭтоПретрейд
			|	И НЕ ЦенныеБумагиПретрейд.НеУчитывать
			|	И ЦенныеБумагиПретрейд.ВидАктива = ""Ценные бумаги""
			|
			|СГРУППИРОВАТЬ ПО
			|	ЦенныеБумагиПретрейд.Рынок,
			|	ЦенныеБумагиПретрейд.ЦеннаяБумага,
			|	ЦенныеБумагиПретрейд.Купон,
			|	ЦенныеБумагиПретрейд.Классификация,
			|	ЦенныеБумагиПретрейд.Дюрация
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДенежныеСредстваПретрейд.ВидАктива КАК ВидАктива,
			|	СУММА(_ДенежныеСредстваПретрейд.Сумма) КАК Сумма,
			|	_ДенежныеСредстваПретрейд.БрокерРасчетныйСчет КАК БрокерРасчетныйСчет,
			|	_ДенежныеСредстваПретрейд.ЮрФизЛицо КАК ДепозитЮрФизЛицо,
			|	_ДенежныеСредстваПретрейд.Валюта КАК Валюта,
			|	_ДенежныеСредстваПретрейд.ДатаПогашенияДепозита КАК ДатаПогашенияДепозита
			|ПОМЕСТИТЬ _ДенежныеСредстваПретрейд
			|ИЗ
			|	_Претрейд КАК _ДенежныеСредстваПретрейд
			|ГДЕ
			|	_ДенежныеСредстваПретрейд.ЭтоПретрейд
			|	И НЕ _ДенежныеСредстваПретрейд.НеУчитывать
			|	И НЕ _ДенежныеСредстваПретрейд.ВидАктива = ""Ценные бумаги""
			|
			|СГРУППИРОВАТЬ ПО
			|	_ДенежныеСредстваПретрейд.ВидАктива,
			|	_ДенежныеСредстваПретрейд.ЮрФизЛицо,
			|	_ДенежныеСредстваПретрейд.Валюта,
			|	_ДенежныеСредстваПретрейд.БрокерРасчетныйСчет,
			|	_ДенежныеСредстваПретрейд.ДатаПогашенияДепозита
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	""Денежные средства"",
			|	СУММА(_ДенежныеСредстваПретрейд.СуммаДС),
			|	_ДенежныеСредстваПретрейд.БрокерРасчетныйСчет,
			|	НЕОПРЕДЕЛЕНО,
			|	&ВалютаУчета,
			|	NULL
			|ИЗ
			|	_Претрейд КАК _ДенежныеСредстваПретрейд
			|ГДЕ
			|	_ДенежныеСредстваПретрейд.ЭтоПретрейд
			|	И НЕ _ДенежныеСредстваПретрейд.НеУчитывать
			|	И _ДенежныеСредстваПретрейд.ВидАктива = ""Ценные бумаги""
			|	И _ДенежныеСредстваПретрейд.ВидОперации = 1
			|
			|СГРУППИРОВАТЬ ПО
			|	_ДенежныеСредстваПретрейд.БрокерРасчетныйСчет
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	""Денежные средства"",
			|	СУММА(_ДенежныеСредстваПретрейд.СуммаДС),
			|	_ДенежныеСредстваПретрейд.БрокерРасчетныйСчет,
			|	НЕОПРЕДЕЛЕНО,
			|	&ВалютаУчета,
			|	NULL
			|ИЗ
			|	_Претрейд КАК _ДенежныеСредстваПретрейд
			|ГДЕ
			|	_ДенежныеСредстваПретрейд.ЭтоПретрейд
			|	И НЕ _ДенежныеСредстваПретрейд.НеУчитывать
			|	И _ДенежныеСредстваПретрейд.ВидАктива = ""Депозиты""
			|	И _ДенежныеСредстваПретрейд.ВидОперации = 1
			|
			|СГРУППИРОВАТЬ ПО
			|	_ДенежныеСредстваПретрейд.БрокерРасчетныйСчет";
		
		Запрос.УстановитьПараметр("Претрейд", Параметры.Претрейд);
		Запрос.Выполнить();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьВременныеТаблицыОстатковПоМетодике(НаборДанных, Параметры, Запрос)

	Если НаборДанных = "Основной" Тогда
		
		Если Параметры.ИспользованаМетодикаРасчетаПоНовойСхеме Тогда
			
			Справочники.ВариантыРасчетаОценочнойСтоимости.ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(
				Параметры.ВариантРасчетаОценочнойСтоимости, 
				Параметры.Организация, 
				Параметры.СчетДоверительногоУправления, 
				Параметры.Период, 
				Запрос.МенеджерВременныхТаблиц);
				
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ * ПОМЕСТИТЬ ТаблицаПартийЦБ ИЗ _ЦенныеБумаги"; 
			Запрос.Выполнить();
			
		Иначе
			
			УстановитьПривилегированныйРежим(Истина);
			
			Если Не Параметры.Свойство("РасчетПартий") Тогда
				Параметры.Вставить("РасчетПартий");
			КонецЕсли; 
			
			ТаблицаПлановыхОпераций = Неопределено;
			Если Параметры.КонтрольЗаПрошлыйПериод Или Не Параметры.УчитыватьПлановыеОперации Тогда
				ТаблицаПлановыхОпераций = Неопределено;
			Иначе
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ * ИЗ _ПлановыеДанные_Операции";
				
				Выборка = Запрос.Выполнить().Выбрать();
				ТаблицаПлановыхОпераций = РегистрыСведений.ОперацииСЦеннымиБумагами.ПолучитьОписаниеТаблицыПлановыхОпераций();
				Пока Выборка.Следующий() Цикл
					ЗаполнитьЗначенияСвойств(ТаблицаПлановыхОпераций.Добавить(), Выборка);
				КонецЦикла; 
				
			КонецЕсли; 
			
			Структура = Новый Структура("ЦельРасчета, ВидУчета, Организация, СчетДоверительногоУправления");
			ЗаполнитьЗначенияСвойств(Структура, Параметры);
			Структура.Вставить("Ссылка", 		Документы.РегистрацияСтоимостиПереоценки.ПолучитьСсылку(Новый УникальныйИдентификатор));
			Структура.Вставить("Дата", 			Параметры.Период);
			
			ПараметрыПолученияПартий = РаботаСПереоценкой.ПолучитьПараметрыПолученияПартийПоМетодике(Параметры.ЦельРасчета, Параметры.ВидУчета, Параметры.ВариантРасчетаОценочнойСтоимости, Параметры.Период, , Параметры.СчетДоверительногоУправления);
			ПараметрыПолученияПартий.Вставить("КоличественныйРасчет", Истина);
			
			РаботаСПереоценкой.ПолучитьЦенныеБумаги(Структура, Запрос.МенеджерВременныхТаблиц, "ТаблицаПартийЦБ", ПараметрыПолученияПартий, Параметры.РасчетПартий, ТаблицаПлановыхОпераций);
			УстановитьПривилегированныйРежим(Ложь);
			
		КонецЕсли;
				
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ТаблицаПартийЦБ.Рынок КАК Рынок,
			|	ТаблицаПартийЦБ.ЦеннаяБумага КАК Актив,
			|	СУММА(ТаблицаПартийЦБ.Количество) КАК Количество,
			|	ЛОЖЬ КАК КПоступлению,
			|	0 КАК КоличествоПоРЕПО,
			|	0 КАК КоличествоПоРЕПОсЦК
			|ПОМЕСТИТЬ _Остатки
			|ИЗ
			|	ТаблицаПартийЦБ КАК ТаблицаПартийЦБ
			|
			|СГРУППИРОВАТЬ ПО
			|	ТаблицаПартийЦБ.Рынок,
			|	ТаблицаПартийЦБ.ЦеннаяБумага";
		
		Запрос.Выполнить();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьВременныеТаблицыОстатковДляКонтроляИД(НаборДанных, Параметры, Запрос)

	Если НаборДанных = "Основной" Тогда
		
		Если Ложь Тогда //Параметры.ВыполнятьРасчетПоУказаниюЦБ5419 Тогда
			
			// в этом случае остатки берем с партий
			УстановитьПривилегированныйРежим(Истина);
			
			Если Не Параметры.Свойство("РасчетПартий") Тогда
				Параметры.Вставить("РасчетПартий");
			КонецЕсли; 
			
			ТаблицаПлановыхОпераций = Неопределено;
