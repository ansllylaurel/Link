		ДобавитьОписаниеПоля(ОписаниеПолей.Добавить(), "Рейтинги.Группа3.ОтклонениеВыпускаДоп2", 	"ОтклонениеВыпускаДоп2",	"Отклонение выпуска (доп. 2)", 	ОписаниеТиповЧисло);
