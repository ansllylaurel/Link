		ДобавитьОписаниеПоля(ОписаниеПолей.Добавить(), "Рейтинги.ЮрЛицоМинфин", 					"ЮрЛицоМинфин",				"ЮрЛицоМинфин", 		Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"),,, Новый Структура("ОграничениеИспользования", Истина));
