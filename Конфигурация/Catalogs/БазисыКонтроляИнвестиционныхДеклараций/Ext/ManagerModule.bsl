#Область ЭкспортныеПроцедурыИФункции

Функция ПолучитьСписокНаборовДанных() Экспорт

	СписокНаборовДанных = Новый СписокЗначений;
	СписокНаборовДанных.Добавить("Основной", "Основной базис");
	Возврат СписокНаборовДанных;

КонецФункции

Функция ПолучитьСКДБазиса(НаборДанных) Экспорт

	// создаем новую СКД
	СКД = Новый СхемаКомпоновкиДанных;
	ИсточникДанных = СКД.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";
		
	// добавляем набор данных Объект
	НаборДанныхСКД = СКД.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанныхСКД.Имя = "ТаблицаБазиса";
	НаборДанныхСКД.ИмяОбъекта = "ТаблицаБазиса";
	НаборДанныхСКД.ИсточникДанных = "ИсточникДанных1";
	
	ТаблицаПолей = ПолучитьОписаниеПолейБазиса(НаборДанных);
	ДобавитьПоляВНаборДанных(НаборДанныхСКД, ТаблицаПолей, Истина);
	
	// добавляем набор данных Запрос для получения рейтингов
	ТекстЗапроса = ПолучитьТекстЗапросаРейтингов(НаборДанных);
	Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
	                                      
		НаборДанныхРейтинги = СоздатьНаборДанныхЗапрос(СКД, "Рейтинги", "ИсточникДанных1", ТекстЗапроса);
		ДобавитьСвязьНаборовДанных(СКД, "ТаблицаБазиса", "Рейтинги", "Основные.Актив", 					"Рейтинги.ЦеннаяБумага", 	"ЦеннаяБумага");
		ДобавитьСвязьНаборовДанных(СКД, "ТаблицаБазиса", "Рейтинги", "Основные.ГоловнаяОрганизация", 	"Рейтинги.Эмитент", 		"Эмитент");
		ДобавитьСвязьНаборовДанных(СКД, "ТаблицаБазиса", "Рейтинги", "Основные.Гарант", 				"Рейтинги.Гарант", 			"Гарант");
		ДобавитьСвязьНаборовДанных(СКД, "ТаблицаБазиса", "Рейтинги", "Основные.Валюта", 				"Рейтинги.Валюта", 			"Валюта");
		ДобавитьСвязьНаборовДанных(СКД, "ТаблицаБазиса", "Рейтинги", "Служебные.ЮрЛицоМинфин", 			"Рейтинги.ЮрЛицоМинфин", 	"ЮрЛицоМинфин");
		
		ТаблицаПолейРейтингов = ПолучитьОписаниеПолейРейтингов(НаборДанных);
		ДобавитьПоляВНаборДанных(НаборДанныхРейтинги, ТаблицаПолейРейтингов);
		
	КонецЕсли; 
	
	// добавляем набор данных Запрос для получения связанных лиц группы компаний
	ТекстЗапроса = ПолучитьТекстЗапросаСвязанныхЛицГруппыКомпаний(НаборДанных);
	Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
		
		НаборДанныхСвязанныеЛицаГруппыКомпаний = СоздатьНаборДанныхЗапрос(СКД, "СвязанныеЛицаГруппыКомпаний", "ИсточникДанных1", ТекстЗапроса);
		ДобавитьСвязьНаборовДанных(СКД, "ТаблицаБазиса", "СвязанныеЛицаГруппыКомпаний", "Основные.ГоловнаяОрганизация", "СвязанныеЛицаГруппыКомпаний.ЮрФизЛицо", "СвязанныеЛицаГруппыКомпанийЭмитентПараметр");
		
		ТаблицаПолейСвязанныхЛицГруппыКомпаний = ПолучитьОписаниеПолейСвязанныхЛицГруппыКомпаний(НаборДанных);
		ДобавитьПоляВНаборДанных(НаборДанныхСвязанныеЛицаГруппыКомпаний, ТаблицаПолейСвязанныхЛицГруппыКомпаний);
	
	КонецЕсли;
	
	// добавляем набор данных Запрос для получения связанных лиц
	ТекстЗапроса = ПолучитьТекстЗапросаСвязанныхЛиц(НаборДанных);
	Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
		
		НаборДанныхСвязанныеЛица = СоздатьНаборДанныхЗапрос(СКД, "СвязанныеЛица", "ИсточникДанных1", ТекстЗапроса);
		ДобавитьСвязьНаборовДанных(СКД, "ТаблицаБазиса", "СвязанныеЛица", "Основные.ГоловнаяОрганизация", 					"СвязанныеЛица.Эмитент", 						"СвязанныеЛицаЭмитентПараметр");
		ДобавитьСвязьНаборовДанных(СКД, "ТаблицаБазиса", "СвязанныеЛица", "Основные.ЮрФизЛицоФонда", 						"СвязанныеЛица.ЮрФизЛицоФонда", 				"СвязанныеЛицаЮрФизЛицоФондаПараметр");
		ДобавитьСвязьНаборовДанных(СКД, "ТаблицаБазиса", "СвязанныеЛица", "Служебные.ОрганизацияСсылка", 					"СвязанныеЛица.Организация", 					"СвязанныеЛицаОрганизацияПараметр");
		ДобавитьСвязьНаборовДанных(СКД, "ТаблицаБазиса", "СвязанныеЛица", "Служебные.СчетДоверительногоУправленияСсылка", 	"СвязанныеЛица.СчетДоверительногоУправления", 	"СвязанныеЛицаСчетДоверительногоУправленияПараметр");
		ДобавитьСвязьНаборовДанных(СКД, "ТаблицаБазиса", "СвязанныеЛица", "Служебные.НачалоПериода", 						"СвязанныеЛица.НачалоПериода", 					"СвязанныеЛицаНачалоПериодаПараметр");
		
		ТаблицаПолейСвязанныхЛиц = ПолучитьОписаниеПолейСвязанныхЛиц(НаборДанных);
		ДобавитьПоляВНаборДанных(НаборДанныхСвязанныеЛица, ТаблицаПолейСвязанныхЛиц);
	
	КонецЕсли;
	
	// добавляем набор данных Запрос для получения связанных лиц группы компаний
	ТекстЗапроса = ПолучитьТекстЗапросаСвязанныхЛицИнфинитум(НаборДанных);
	Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
		
		НаборДанныхСвязанныеЛицаИнфинитум = СоздатьНаборДанныхЗапрос(СКД, "СвязанныеЛицаИнфинитум", "ИсточникДанных1", ТекстЗапроса);
		ДобавитьСвязьНаборовДанных(СКД, "ТаблицаБазиса", "СвязанныеЛицаИнфинитум", "Основные.ГоловнаяОрганизация", 	"СвязанныеЛицаИнфинитум.ЮрФизЛицо", 	"СвязанныеЛицаИнфинитумЭмитентПараметр");
		ДобавитьСвязьНаборовДанных(СКД, "ТаблицаБазиса", "СвязанныеЛицаИнфинитум", "Служебные.ОрганизацияСсылка", 	"СвязанныеЛицаИнфинитум.Организация", 	"СвязанныеЛицаИнфинитумОрганизацияПараметр");
		
		ТаблицаПолейСвязанныхЛицИнфинитум = ПолучитьОписаниеПолейСвязанныхЛицИнфинитум(НаборДанных);
		ДобавитьПоляВНаборДанных(НаборДанныхСвязанныеЛицаИнфинитум, ТаблицаПолейСвязанныхЛицИнфинитум);
	
	КонецЕсли;
	
	// вычисляемые поля
	ТаблицаВычисляемыхПолей = ПолучитьОписаниеВычисляемыхПолей(НаборДанных);
	Для каждого ВычисляемоеПоле Из ТаблицаВычисляемыхПолей Цикл
		ЗаполнитьЗначенияСвойств(СКД.ВычисляемыеПоля.Добавить(), ВычисляемоеПоле);
	КонецЦикла; 
	
	// параметры
	ТаблицаПараметров = ПолучитьПараметрыБазиса(НаборДанных);
	Для каждого Параметр Из ТаблицаПараметров Цикл
		
		Если СКД.Параметры.Найти(Параметр.Имя) = Неопределено Тогда
			ПараметрСКД = СКД.Параметры.Добавить();
			ЗаполнитьЗначенияСвойств(ПараметрСКД, Параметр);
			ПараметрСКД.ОграничениеИспользования = Не Параметр.ДоступенИнтерактивно;
			ПараметрСКД.ВключатьВДоступныеПоля = Ложь;
			ПараметрСКД.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;
			Если Параметр.ДоступныеЗначения.Количество() > 0 Тогда
				ПараметрСКД.УстановитьДоступныеЗначения(Параметр.ДоступныеЗначения);		
			КонецЕсли;		
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СКД;

КонецФункции 

Функция ПолучитьПараметрыБазиса(НаборДанных) Экспорт

	ПараметрыБазиса = Новый ТаблицаЗначений;
	ПараметрыБазиса.Колонки.Добавить("Имя", 		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	ПараметрыБазиса.Колонки.Добавить("Заголовок", 	Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	ПараметрыБазиса.Колонки.Добавить("ТипЗначения", Новый ОписаниеТипов("ОписаниеТипов"));
	ПараметрыБазиса.Колонки.Добавить("Выражение", 	Новый ОписаниеТипов("Строка"));
	ПараметрыБазиса.Колонки.Добавить("ДоступенИнтерактивно", 	Новый ОписаниеТипов("Булево")); // определяет будет ли данный параметр виден в списке параметров базиса на форме элемента справочника
	ПараметрыБазиса.Колонки.Добавить("ДоступенСписокЗначений", 	Новый ОписаниеТипов("Булево"));
	ПараметрыБазиса.Колонки.Добавить("ВыводитьВРасшифровку", 	Новый ОписаниеТипов("Булево"));
	ПараметрыБазиса.Колонки.Добавить("ДоступныеЗначения", 		Новый ОписаниеТипов("СписокЗначений"));
	
	ОписаниеТиповБулево = Новый ОписаниеТипов("Булево");
	ОписаниеТиповДата = Новый ОписаниеТипов("Дата");
		
	Если НаборДанных = "Основной" Тогда
	
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "СчетДоверительногоУправления", 	"Счет доверительного управления", 			Ложь, Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "Период", 							"Период", 									Ложь, ОписаниеТиповДата);
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "грПериод", 						"грПериод", 								Ложь, ОписаниеТиповДата);
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "Организация",						"Организация", 								Ложь, Новый ОписаниеТипов("СправочникСсылка.Организации"));
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "ЦеннаяБумага",					"ЦеннаяБумага", 							Ложь, Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "Валюта",							"Валюта", 									Ложь, Новый ОписаниеТипов("СправочникСсылка.Валюты"));
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "Эмитент",							"Эмитент", 									Ложь, Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "Гарант",							"Гарант", 									Ложь, Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "ВалютаУчета",					 	"Валюта учета", 							Ложь, Новый ОписаниеТипов("СправочникСсылка.Валюты"));
		
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "ДСНаРасчетныхСчетах", 			"Денежные средства на расчетных счетах", 	Истина, ОписаниеТиповБулево, , Истина);
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "ДСУБрокера", 						"Денежные средства у брокера", 				Истина, ОписаниеТиповБулево, , Истина);
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "КредиторскаяЗадолженность", 		"Кредиторская задолженность", 				Истина, ОписаниеТиповБулево, , Истина);
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "ДебиторскаяЗадолженность", 		"Дебиторская задолженность", 				Истина, ОписаниеТиповБулево, , Истина);
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "НКДВДТ",					 		"НКД в дебиторской задолженности", 			Истина, ОписаниеТиповБулево);
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "Депозиты", 						"Депозиты", 								Истина, ОписаниеТиповБулево, , Истина);
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "Акции", 							"Акции", 									Истина, ОписаниеТиповБулево, , Истина);
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "Облигации", 						"Облигации", 								Истина, ОписаниеТиповБулево, , Истина);
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "Паи", 							"Паи", 										Истина, ОписаниеТиповБулево, , Истина);
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "ДепозитарныеРасписки", 			"Депозитарные расписки",	 				Истина, ОписаниеТиповБулево, , Истина);
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "ИпотечныеСертификатыУчастия", 	"Ипотечные сертификаты участия",			Истина, ОписаниеТиповБулево, , Истина);
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "Доли", 							"Доли",										Истина, ОписаниеТиповБулево, , Истина);
		
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "УчитыватьЦБКПоступлению",			"Ценные бумаги к поступлению", 				Истина, ОписаниеТиповБулево, , Истина);
		
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "КоличествоМесяцев", 				"Объем торгов. Количество месяцев", 		Истина, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(2, 0, ДопустимыйЗнак.Неотрицательный)));
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "ОсновнойРежимТоргов",				"Объем торгов. Режим основных торгов", 		Истина, ОписаниеТиповБулево);
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "РежимПереговорныхСделок",			"Объем торгов. Режим переговорных сделок", 	Истина, ОписаниеТиповБулево);
		
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "АнализируемыеТипыОферт",			"Анализируемые типы оферт", 				Истина, Новый ОписаниеТипов("ПеречислениеСсылка.ТипыОфертПоОблигациям"), Истина);
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "КонтролироватьЧувствительность",	"Контролировать чувствительность", 			Истина, ОписаниеТиповБулево);
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "КонтролироватьMaxDD",				"Контролировать MaxDD", 					Истина, ОписаниеТиповБулево);
		
		ДоступныеСпособыРасчетаДюрации = Новый СписокЗначений;
		ДоступныеСпособыРасчетаДюрации.Добавить("Стандартный", "Стандартный расчет");
		ДоступныеСпособыРасчетаДюрации.Добавить("СНГ", "СНГ (ММВБ)");
		ДоступныеСпособыРасчетаДюрации.Добавить("СНГ_Расчетная", "СНГ (Расчетная)");
		ДоступныеСпособыРасчетаДюрации.Добавить("ММВБ", "ММВБ");
		ДоступныеСпособыРасчетаДюрации.Добавить("Ростех", "Ростех");
		ДобавитьПараметр(ПараметрыБазиса.Добавить(), "МетодРасчетаДюрации",				"Метод расчета дюрации", 					Истина, Новый ОписаниеТипов("Строка"), , Истина, , ДоступныеСпособыРасчетаДюрации);
		
	КонецЕсли;
	
	Возврат ПараметрыБазиса;

КонецФункции

Функция ПолучитьОписаниеПолейБазиса(НаборДанных) Экспорт

	ОписаниеПолей = СоздатьТаблицуОписанияПолей();
	
	Если НаборДанных = "Основной" Тогда
		
		ОписаниеТиповДата 			= Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));
		ОписаниеТиповДенежныеСуммы 	= Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип;
		ОписаниеТиповЦена 			= Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип;
		ОписаниеТиповЧислоДней 		= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный));
		ОписаниеТиповЧислоЛет		= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 2, ДопустимыйЗнак.Неотрицательный));
		ОписаниеТиповБулево			= Новый ОписаниеТипов("Булево");
		ОписаниеТиповДоля			= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(4, 2));
		ОписаниеТиповДоляКоличество = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,14));
		ОписаниеТиповПроцентнаяСтавка = Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип;

		МассивТиповАктивов = Новый Массив;
		МассивТиповАктивов.Добавить(Тип("СправочникСсылка.Акции"));
