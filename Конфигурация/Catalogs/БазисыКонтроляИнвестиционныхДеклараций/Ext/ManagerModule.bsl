// 1. Формирования списка показателей в форме настройки контроля инвестиционной декларации
// 2. Добавления полей итогов (ресурсов) в СКД, используемую для проверки строк показателей
// 3. Настройки структуры СКД, используемой для проверки строк показателей и формирования отчета
Функция ПолучитьОписаниеКонтролируемыхПоказателей(НаборДанных) Экспорт

	ОписаниеТиповСтрока = Новый ОписаниеТипов("Строка");
	
	ОписаниеПоказателей = Новый ТаблицаЗначений;
	ОписаниеПоказателей.Колонки.Добавить("Представление", 			ОписаниеТиповСтрока);// представление показателя в форме настройки КИД
	ОписаниеПоказателей.Колонки.Добавить("ПутьКДанным", 			ОписаниеТиповСтрока);// путь к данным ресурса
	ОписаниеПоказателей.Колонки.Добавить("ВыражениеПоказатель", 	ОписаниеТиповСтрока);// выражение для расчета значения показателя
	ОписаниеПоказателей.Колонки.Добавить("ВыражениеДоля", 			ОписаниеТиповСтрока);// выражение для расчета значения доли
	ОписаниеПоказателей.Колонки.Добавить("Группировки", 			Новый ОписаниеТипов("Массив"));// группировки ресурса
	ОписаниеПоказателей.Колонки.Добавить("ГруппировкаСтруктуры", 	ОписаниеТиповСтрока);// группировки структуры
	ОписаниеПоказателей.Колонки.Добавить("ИмяПоляДоля",				ОписаниеТиповСтрока);// в это поле будет записана доля, после расчета
	
	Если НаборДанных = "Основной" Тогда
		
		ДобавитьПоказатель(ОписаниеПоказателей.Добавить(), 
