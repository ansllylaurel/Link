		ДобавитьОписаниеПоля(ОписаниеПолей.Добавить(), "СвязанныеЛица.ЮрФизЛицоФонда",	"СвязанныеЛицаЮрФизЛицоФонда",	"ЮрФизЛицоФонда", 	Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"),,, Новый Структура("ОграничениеИспользования", Истина));
		ДобавитьОписаниеПоля(ОписаниеПолей.Добавить(), "СвязанныеЛица.Организация",		"СвязанныеЛицаОрганизация",		"Организация", 		Новый ОписаниеТипов("СправочникСсылка.Организации"),,, Новый Структура("ОграничениеИспользования", Истина));
		ДобавитьОписаниеПоля(ОписаниеПолей.Добавить(), "СвязанныеЛица.НачалоПериода",	"СвязанныеЛицаНачалоПериода", 	"Начало периода", 	Новый ОписаниеТипов("Дата"),,, Новый Структура("ОграничениеИспользования", Истина));
		ДобавитьОписаниеПоля(ОписаниеПолей.Добавить(), 
			"СвязанныеЛица.СчетДоверительногоУправления", 
			"СвязанныеЛицаСчетДоверительногоУправления",
			"Счет доверительного управления", 
			Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"),,, Новый Структура("ОграничениеИспользования", Истина));
		
	КонецЕсли;
		
	Возврат ОписаниеПолей
			
КонецФункции

Функция ПолучитьТекстЗапросаСвязанныхЛиц(НаборДанных) Экспорт

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СвязанныеЛицаСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо,
		|	СвязанныеЛицаСрезПоследних.ТипСвязи КАК ТипСвязи,
		|	СвязанныеЛицаСрезПоследних.СвязанноеЮрФизЛицо КАК СвязанноеЮрФизЛицо
		|ПОМЕСТИТЬ _ИсполнителиРолей
		|ИЗ
		|	РегистрСведений.СвязанныеЛица.СрезПоследних(
		|			&грПериод {(&грПериод)},
		|			Организация = &СвязанныеЛицаОрганизацияПараметр
		|				И ЮрФизЛицо = &СвязанныеЛицаЮрФизЛицоФондаПараметр
		|				И ТипСвязи В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ИсполнителиРолей))) КАК СвязанныеЛицаСрезПоследних
		|ГДЕ
		|	СвязанныеЛицаСрезПоследних.Действует
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""Фонд"" КАК СвязанныеЛицаРольЭмитента,
		|	&СвязанныеЛицаЮрФизЛицоФондаПараметр КАК СвязанныеЛицаЮрФизЛицоФонда,
		|	&СвязанныеЛицаОрганизацияПараметр КАК СвязанныеЛицаОрганизация,
		|	&СвязанныеЛицаЭмитентПараметр КАК СвязанныеЛицаЭмитент,
		|	&СвязанныеЛицаСчетДоверительногоУправленияПараметр КАК СвязанныеЛицаСчетДоверительногоУправления,
		|	&СвязанныеЛицаНачалоПериодаПараметр КАК СвязанныеЛицаНачалоПериода
		|{ВЫБРАТЬ
		|	СвязанныеЛицаРольЭмитента,
		|	СвязанныеЛицаЮрФизЛицоФонда,
		|	СвязанныеЛицаОрганизация,
		|	СвязанныеЛицаЭмитент,
		|	СвязанныеЛицаСчетДоверительногоУправления,
		|	СвязанныеЛицаНачалоПериода}
		|ГДЕ
		|	&СвязанныеЛицаЮрФизЛицоФондаПараметр = &СвязанныеЛицаЭмитентПараметр
		|{ГДЕ
		|	(""Фонд"") КАК СвязанныеЛицаРольЭмитента}
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.УправляющаяКомпания)
		|			ТОГДА ""Управляющая компания фонда""
		|		КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Спецдепозитарий)
		|			ТОГДА ""Специализированный депозитарий фонда""
		|		КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Аудитор)
		|			ТОГДА ""Аудитор фонда""
		|		КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Оценщик)
		|			ТОГДА ""Оценщик фонда""
		|		КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Актуарий)
		|			ТОГДА ""Актуарий фонда""
		|	КОНЕЦ,
		|	&СвязанныеЛицаЮрФизЛицоФондаПараметр,
		|	&СвязанныеЛицаОрганизацияПараметр,
		|	&СвязанныеЛицаЭмитентПараметр,
		|	&СвязанныеЛицаСчетДоверительногоУправленияПараметр,
		|	&СвязанныеЛицаНачалоПериодаПараметр
		|ИЗ
		|	_ИсполнителиРолей КАК _ИсполнителиРолей
		|ГДЕ
		|	_ИсполнителиРолей.СвязанноеЮрФизЛицо = &СвязанныеЛицаЭмитентПараметр
		|{ГДЕ
		|	(ВЫБОР
		|			КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.УправляющаяКомпания)
		|				ТОГДА ""Управляющая компания фонда""
		|			КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Спецдепозитарий)
		|				ТОГДА ""Специализированный депозитарий фонда""
		|			КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Аудитор)
		|				ТОГДА ""Аудитор фонда""
		|			КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Оценщик)
		|				ТОГДА ""Оценщик фонда""
		|			КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Актуарий)
		|				ТОГДА ""Актуарий фонда""
		|		КОНЕЦ) КАК СвязанныеЛицаРольЭмитента}
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Оценщик управляющей компании фонда"",
		|	&СвязанныеЛицаЮрФизЛицоФондаПараметр,
		|	&СвязанныеЛицаОрганизацияПараметр,
		|	&СвязанныеЛицаЭмитентПараметр,
		|	&СвязанныеЛицаСчетДоверительногоУправленияПараметр,
		|	&СвязанныеЛицаНачалоПериодаПараметр
		|ИЗ
		|	_ИсполнителиРолей КАК _ИсполнителиРолей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЛица.СрезПоследних(
		|				&грПериод {(&грПериод)},
		|				Организация = &СвязанныеЛицаОрганизацияПараметр
		|					И СвязанноеЮрФизЛицо = &СвязанныеЛицаЭмитентПараметр
		|					И ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Оценщик)) КАК СвязанныеЛицаСрезПоследних
		|		ПО _ИсполнителиРолей.СвязанноеЮрФизЛицо = СвязанныеЛицаСрезПоследних.ЮрФизЛицо
		|			И (_ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.УправляющаяКомпания))
		|ГДЕ
		|	СвязанныеЛицаСрезПоследних.Действует
		|{ГДЕ
		|	(""Оценщик управляющей компании фонда"") КАК СвязанныеЛицаРольЭмитента}
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Связанное лицо фонда"",
		|	&СвязанныеЛицаЮрФизЛицоФондаПараметр,
		|	&СвязанныеЛицаОрганизацияПараметр,
		|	&СвязанныеЛицаЭмитентПараметр,
		|	&СвязанныеЛицаСчетДоверительногоУправленияПараметр,
		|	&СвязанныеЛицаНачалоПериодаПараметр
		|ИЗ
		|	РегистрСведений.СвязанныеЛица.СрезПоследних(
		|			&грПериод {(&грПериод)},
		|			Организация = &СвязанныеЛицаОрганизацияПараметр
		|				И ЮрФизЛицо = &СвязанныеЛицаЮрФизЛицоФондаПараметр
		|				И ТипСвязи.КонтрольПоУказанию5343У
		|				И НЕ ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Инфинитум)
		|				И СвязанноеЮрФизЛицо = &СвязанныеЛицаЭмитентПараметр) КАК СвязанныеЛицаСрезПоследних
		|ГДЕ
		|	СвязанныеЛицаСрезПоследних.Действует
		|{ГДЕ
		|	(""Связанное лицо фонда"") КАК СвязанныеЛицаРольЭмитента}
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.УправляющаяКомпания)
		|			ТОГДА ""Связанное лицо управляющей компании фонда""
		|		КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Спецдепозитарий)
		|			ТОГДА ""Связанное лицо специализированного депозитария фонда""
		|		КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Аудитор)
		|			ТОГДА ""Связанное лицо аудитора фонда""
		|		КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Оценщик)
		|			ТОГДА ""Связанное лицо оценщика фонда""
		|		КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Актуарий)
		|			ТОГДА ""Связанное лицо актуария фонда""
		|	КОНЕЦ,
		|	&СвязанныеЛицаЮрФизЛицоФондаПараметр,
		|	&СвязанныеЛицаОрганизацияПараметр,
		|	&СвязанныеЛицаЭмитентПараметр,
		|	&СвязанныеЛицаСчетДоверительногоУправленияПараметр,
		|	&СвязанныеЛицаНачалоПериодаПараметр
		|ИЗ
		|	_ИсполнителиРолей КАК _ИсполнителиРолей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЛица.СрезПоследних(
		|				&грПериод {(&грПериод)},
		|				Организация = &СвязанныеЛицаОрганизацияПараметр
		|					И ТипСвязи.КонтрольПоУказанию5343У
		|					И НЕ ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Инфинитум)
		|					И СвязанноеЮрФизЛицо = &СвязанныеЛицаЭмитентПараметр) КАК СвязанныеЛицаСрезПоследних
		|		ПО _ИсполнителиРолей.СвязанноеЮрФизЛицо = СвязанныеЛицаСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	СвязанныеЛицаСрезПоследних.Действует
		|{ГДЕ
		|	(ВЫБОР
		|			КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.УправляющаяКомпания)
		|				ТОГДА ""Связанное лицо управляющей компании фонда""
		|			КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Спецдепозитарий)
		|				ТОГДА ""Связанное лицо специализированного депозитария фонда""
		|			КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Аудитор)
		|				ТОГДА ""Связанное лицо аудитора фонда""
		|			КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Оценщик)
		|				ТОГДА ""Связанное лицо оценщика фонда""
		|			КОГДА _ИсполнителиРолей.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Актуарий)
		|				ТОГДА ""Связанное лицо актуария фонда""
		|		КОНЕЦ) КАК СвязанныеЛицаРольЭмитента}
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Брокер"",
		|	&СвязанныеЛицаЮрФизЛицоФондаПараметр,
		|	&СвязанныеЛицаОрганизацияПараметр,
		|	&СвязанныеЛицаЭмитентПараметр,
		|	&СвязанныеЛицаСчетДоверительногоУправленияПараметр,
		|	&СвязанныеЛицаНачалоПериодаПараметр
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров КАК РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&грПериод {(&грПериод)}, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров.ДоговорБрокерскогоОбслуживания)
		|ГДЕ
		|	РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров.СчетДоверительногоУправления = &СвязанныеЛицаСчетДоверительногоУправленияПараметр
		|	И РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров.Брокер.ЮрФизЛицо = &СвязанныеЛицаЭмитентПараметр
		|	И (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &СвязанныеЛицаНачалоПериодаПараметр)
		|{ГДЕ
		|	(""Брокер"") КАК СвязанныеЛицаРольЭмитента}";
	Возврат ТекстЗапроса;

КонецФункции

Функция ПолучитьОписаниеПолейСвязанныхЛицИнфинитум(НаборДанных) Экспорт

	ОписаниеПолей = СоздатьТаблицуОписанияПолей();
	
	Если НаборДанных = "Основной" Тогда
		ДобавитьОписаниеПоля(ОписаниеПолей.Добавить(), "СвязанныеЛицаИнфинитум.ЮрФизЛицо",		"СвязанныеЛицаИнфинитумЭмитент",		"Эмитент", 								Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"),,, Новый Структура("ОграничениеИспользования", Истина));
		ДобавитьОписаниеПоля(ОписаниеПолей.Добавить(), "СвязанныеЛицаИнфинитум.Организация",	"СвязанныеЛицаИнфинитумОрганизация",	"Организация", 							Новый ОписаниеТипов("СправочникСсылка.Организации"),,, Новый Структура("ОграничениеИспользования", Истина));
		ДобавитьОписаниеПоля(ОписаниеПолей.Добавить(), "СвязанныеЛицаИнфинитум.Родитель",		"СвязанныеЛицаИнфинитумРодитель", 		"Родительская организация Инфинитум", 	Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	КонецЕсли;
		
	Возврат ОписаниеПолей
			
КонецФункции

Функция ПолучитьТекстЗапросаСвязанныхЛицИнфинитум(НаборДанных) Экспорт

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&СвязанныеЛицаИнфинитумЭмитентПараметр КАК СвязанныеЛицаИнфинитумЭмитент		
		|ПОМЕСТИТЬ _Эмитенты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Эмитенты.СвязанныеЛицаИнфинитумЭмитент КАК СвязанныеЛицаИнфинитумЭмитент,
		|	ЕСТЬNULL(СвязанныеЛица.ЮрФизЛицо, _Эмитенты.СвязанныеЛицаИнфинитумЭмитент) КАК СвязанныеЛицаИнфинитумРодитель,
		|	&СвязанныеЛицаИнфинитумОрганизацияПараметр КАК СвязанныеЛицаИнфинитумОрганизация
		|{ВЫБРАТЬ
		|	СвязанныеЛицаИнфинитумЭмитент,
		|	СвязанныеЛицаИнфинитумРодитель,
		|	СвязанныеЛицаИнфинитумОрганизация}
		|ИЗ
		|	_Эмитенты КАК _Эмитенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЛица.СрезПоследних(
		|				&грПериод,
		|				Организация = &СвязанныеЛицаИнфинитумОрганизацияПараметр
		|					И ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Инфинитум)) КАК СвязанныеЛица
		|		ПО _Эмитенты.СвязанныеЛицаИнфинитумЭмитент = СвязанныеЛица.СвязанноеЮрФизЛицо
		|			И (СвязанныеЛица.Действует)
		|{ГДЕ
		|	(ЕСТЬNULL(СвязанныеЛица.ЮрФизЛицо, _Эмитенты.СвязанныеЛицаИнфинитумЭмитент)) КАК СвязанныеЛицаИнфинитумРодитель}";
	
	Возврат ТекстЗапроса;

КонецФункции

