Процедура ДобавитьПоказательМаксДД(ТаблицаБазиса, Параметры)

	ТаблицаМаксДД = ПолучитьТаблицуМаксДД(Параметры.Организация, Параметры.СчетДоверительногоУправления, Параметры.Период);
	Если ТаблицаМаксДД.Количество() > 0 Тогда
	
		СтрокаМаксДД = ТаблицаМаксДД[ТаблицаМаксДД.Количество() - 1];
		Если СтрокаМаксДД.Дата <> Параметры.Период Тогда
		
			Параметры.Вставить("ДатаМаксДД", СтрокаМаксДД.Дата);
		
		КонецЕсли;
		
		Строка = ТаблицаБазиса.Добавить();
		
		Строка.MaxDD = 0;
		Строка.ДоляMaxDD = СтрокаМаксДД.МаксДД;
		
		КолонкиДляЗаполнения = "Сумма,СуммаПоРЕПО,СуммаБезРепо,СуммаБезРЕПОсЦК,Дюрация,ДюрацияВГодах,МодифицированнаяДюрация," 
			+ "МодифицированнаяДюрацияВГодах,НеликвиднаяЧасть,ЛиквидностьНациональный,ДоляДюрацииБезРЕПО,ДоляДюрацииПоРЕПО,"
			+ "КоличествоВОбращении,Количество,КоличествоПоРЕПО,КоличествоСвободные";
			
		Для каждого ИмяКолонки Из СтрРазделить(КолонкиДляЗаполнения, ", ", Ложь) Цикл
		
			Строка[ИмяКолонки] = 0;
		
		КонецЦикла;
	
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьТаблицуМаксДД(Организация, СчетДоверительногоУправления, Период) Экспорт

	#Область Текст_запроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(ВложенныйЗапрос.Период) КАК Период
		|ПОМЕСТИТЬ _ДатаПервогоСЧА
		|ИЗ
		|	(ВЫБРАТЬ
		|		МАКСИМУМ(ФинансовыеПоказатели.Период) КАК Период
		|	ИЗ
		|		РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|	ГДЕ
		|		ФинансовыеПоказатели.Активность
		|		И ФинансовыеПоказатели.Организация = &Организация
		|		И ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
		|		И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|		И ФинансовыеПоказатели.Период < &НачалоГода
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		МИНИМУМ(ФинансовыеПоказатели.Период)
		|	ИЗ
		|		РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|	ГДЕ
		|		ФинансовыеПоказатели.Активность
		|		И ФинансовыеПоказатели.Организация = &Организация
		|		И ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
		|		И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|		И ФинансовыеПоказатели.Период >= &НачалоГода) КАК ВложенныйЗапрос
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказатели.Период КАК Период,
		|	ФинансовыеПоказатели.Значение КАК СЧА,
		|	ФинансовыеПоказатели.Период = _ДатаПервогоСЧА.Период КАК Т0
		|ПОМЕСТИТЬ _СЧА
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатаПервогоСЧА КАК _ДатаПервогоСЧА
		|		ПО (ИСТИНА)
		|ГДЕ
		|	ФинансовыеПоказатели.Активность
		|	И ФинансовыеПоказатели.Организация = &Организация
		|	И ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
		|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|	И ФинансовыеПоказатели.Период МЕЖДУ _ДатаПервогоСЧА.Период И &ТекущаяДата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводыВыводыАктивовВВалютеУчетаОбороты.Период КАК Период,
		|	ВЫБОР
		|		КОГДА ВводыВыводыАктивовВВалютеУчетаОбороты.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА 1
		|		ИНАЧЕ -1
		|	КОНЕЦ * ВводыВыводыАктивовВВалютеУчетаОбороты.РыночнаяСтоимостьОборот КАК РыночнаяСтоимостьОборот
		|ПОМЕСТИТЬ _ВводыВыводы
		|ИЗ
		|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета.Обороты(
		|			&НачалоГода,
		|			&ТекущаяДата,
		|			День,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ВводыВыводыАктивовВВалютеУчетаОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Период КАК Дата,
		|	ВложенныйЗапрос.ПредыдущийПериод КАК ПредыдущийПериод,
		|	ВложенныйЗапрос.СЧА КАК СЧА,
		|	ЕСТЬNULL(_ВводыВыводы.РыночнаяСтоимостьОборот, 0) КАК ВводыВыводы,
		|	_ПредыдущаяСЧА.СЧА КАК ПредыдущаяСЧА,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_ПредыдущаяСЧА.СЧА, 0) = 0
		|			ТОГДА 1
		|		ИНАЧЕ (ВложенныйЗапрос.СЧА - ЕСТЬNULL(_ВводыВыводы.РыночнаяСтоимостьОборот, 0)) / _ПредыдущаяСЧА.СЧА
		|	КОНЕЦ КАК Прирост
		|ИЗ
		|	(ВЫБРАТЬ
		|		_СЧА.Период КАК Период,
		|		_СЧА.СЧА КАК СЧА,
		|		МАКСИМУМ(_СЧА1.Период) КАК ПредыдущийПериод
		|	ИЗ
		|		_СЧА КАК _СЧА
		|			ЛЕВОЕ СОЕДИНЕНИЕ _СЧА КАК _СЧА1
		|			ПО _СЧА.Период > _СЧА1.Период
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_СЧА.Период,
		|		_СЧА.СЧА) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВводыВыводы КАК _ВводыВыводы
		|		ПО ВложенныйЗапрос.Период = _ВводыВыводы.Период
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СЧА КАК _ПредыдущаяСЧА
		|		ПО ВложенныйЗапрос.ПредыдущийПериод = _ПредыдущаяСЧА.Период
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВложенныйЗапрос.Период";		
	#КонецОбласти
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НачалоГода", НачалоГода(Период));
	Запрос.УстановитьПараметр("ТекущаяДата", Период);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Результат = Запрос.Выполнить();
	
	ДанныеМаксДД = Результат.Выгрузить();
	ТипДенежныеСуммы = Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип;
	
	ДанныеМаксДД.Колонки.Добавить("РасчетнаяСЧА", ТипДенежныеСуммы);
	ДанныеМаксДД.Колонки.Добавить("МаксСЧА", ТипДенежныеСуммы);
	ДанныеМаксДД.Колонки.Добавить("МаксДД", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 4)));
	
	НачальнаяСЧА = Неопределено;
	МаксимальнаяРасчетнаяСЧА = 0;
	НакопленныйПрирост = 1;
	
	Для каждого СтрокаПриростПоДням Из ДанныеМаксДД Цикл
	
		Если НачальнаяСЧА = Неопределено Тогда
			НачальнаяСЧА = СтрокаПриростПоДням.СЧА;
			Прирост = 1;
		Иначе
			Прирост = Окр((СтрокаПриростПоДням.СЧА - СтрокаПриростПоДням.ВводыВыводы) / СтрокаПриростПоДням.ПредыдущаяСЧА, 15);
		КонецЕсли;
		
		НакопленныйПрирост = НакопленныйПрирост * Прирост;
		РасчетнаяСЧА = Окр(НачальнаяСЧА * НакопленныйПрирост, 8);
		
		Если РасчетнаяСЧА > МаксимальнаяРасчетнаяСЧА Тогда
			МаксимальнаяРасчетнаяСЧА = РасчетнаяСЧА;
		КонецЕсли;
		
		СтрокаПриростПоДням.Прирост = Прирост;
		СтрокаПриростПоДням.РасчетнаяСЧА = РасчетнаяСЧА;
		СтрокаПриростПоДням.МаксСЧА = МаксимальнаяРасчетнаяСЧА;
		СтрокаПриростПоДням.МаксДД = (РасчетнаяСЧА / МаксимальнаяРасчетнаяСЧА - 1) * 100;
		
	КонецЦикла;
	
	Возврат ДанныеМаксДД;

КонецФункции

Функция ПолучитьТаблицуСЧА(НаборДанных, Параметры, Запрос)

	ОцениватьПоЦенамПриобретения = Не Параметры.КонтрольЗаПрошлыйПериод;
	
	Если Не Параметры.ДинамическийРасчетСтоимости Тогда
	
		ЗапросКонтроль = Новый Запрос;
		ЗапросКонтроль.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ФинансовыеПоказатели.Период КАК Период
			|ИЗ
			|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
			|ГДЕ
			|	ФинансовыеПоказатели.Период = &Период
			|	И ФинансовыеПоказатели.Организация = &Организация
			|	И ФинансовыеПоказатели.Активность
			|	И ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
			|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)";
		ЗапросКонтроль.УстановитьПараметр("Период", НачалоДня(Параметры.Период));
		ЗапросКонтроль.УстановитьПараметр("Организация", Параметры.Организация);
		ЗапросКонтроль.УстановитьПараметр("СчетДоверительногоУправления", Параметры.СчетДоверительногоУправления);
		
	КонецЕсли;
	
	Если Параметры.ДинамическийРасчетСтоимости Или ОцениватьПоЦенамПриобретения Или ЗапросКонтроль.Выполнить().Пустой() Тогда
		
		// получаем бумаги по методике..
		СформироватьВременныеТаблицыЦенныхБумаг(НаборДанных, Параметры, Запрос, Истина);
		
	Иначе
		
		Если Не Запрос.Параметры.Свойство("ЦенныеБумагиПоНРД") Тогда
			// используется для переопределения цен по Атланту
			Запрос.УстановитьПараметр("ЦенныеБумагиПоНРД", ПолучитьЦенныеБумагиПоНРД(Параметры));
		
		КонецЕсли; 
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьПереоценки.Рынок КАК Рынок,
			|	ВЫБОР
			|		КОГДА _СправедливыеЦены.Цена ЕСТЬ NULL
			|			ТОГДА СтоимостьПереоценки.СуммаВВалютеУчета
			|		ИНАЧЕ _СправедливыеЦены.Цена * СтоимостьПереоценки.Количество
			|	КОНЕЦ КАК СуммаБезНКД,
			|	СтоимостьПереоценки.СуммаКупонаВВалютеУчета КАК СуммаКупона,
			|	ВЫБОР
			|		КОГДА _СправедливыеЦены.Цена ЕСТЬ NULL
			|			ТОГДА СтоимостьПереоценки.СуммаВВалютеУчета
			|		ИНАЧЕ _СправедливыеЦены.Цена * СтоимостьПереоценки.Количество
			|	КОНЕЦ + СтоимостьПереоценки.СуммаКупонаВВалютеУчета КАК Сумма,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(СтоимостьПереоценки.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
			|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).УчетныйАктивЦБРФ
			|		ИНАЧЕ НЕОПРЕДЕЛЕНО
			|	КОНЕЦ КАК ВидСертификатаУчастия
			|ПОМЕСТИТЬ _СтоимостьПереоценки
			|ИЗ
			|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
			|		ЛЕВОЕ СОЕДИНЕНИЕ _СправедливыеЦены КАК _СправедливыеЦены
			|		ПО СтоимостьПереоценки.Рынок = _СправедливыеЦены.Рынок
			|			И СтоимостьПереоценки.ЦеннаяБумага = _СправедливыеЦены.Актив
			|			И (_СправедливыеЦены.Актив В (&ЦенныеБумагиПоНРД))
			|ГДЕ
			|	СтоимостьПереоценки.Период = &НачалоПериода
			|	И СтоимостьПереоценки.Организация = &Организация
			|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)
			|	И СтоимостьПереоценки.Рынок В(&РынкиЦенныхБумаг)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_ЦенныеБумагиПретрейд.Рынок,
			|	_ЦенныеБумагиПретрейд.Сумма,
			|	_ЦенныеБумагиПретрейд.Количество * _ЦенныеБумагиПретрейд.Купон,
			|	_ЦенныеБумагиПретрейд.Количество * _ЦенныеБумагиПретрейд.Купон + _ЦенныеБумагиПретрейд.Сумма,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумагиПретрейд.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
			|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумагиПретрейд.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).УчетныйАктивЦБРФ
			|		ИНАЧЕ НЕОПРЕДЕЛЕНО
			|	КОНЕЦ
			|ИЗ
			|	_ЦенныеБумагиПретрейд КАК _ЦенныеБумагиПретрейд
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СтоимостьПереоценки.Рынок КАК Рынок,
			|	СУММА(_СтоимостьПереоценки.СуммаБезНКД) КАК СуммаБезНКД,
			|	СУММА(_СтоимостьПереоценки.СуммаКупона) КАК СуммаКупона,
			|	СУММА(_СтоимостьПереоценки.Сумма) КАК Сумма,
			|	ВЫБОР
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|			ТОГДА ""Облигации""
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
			|			ТОГДА ""Акции""
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
			|			ТОГДА ""Паи""
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
			|			ТОГДА ""Депозитарные расписки""
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
			|				И _СтоимостьПереоценки.ВидСертификатаУчастия = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ИСУ)
			|			ТОГДА ""Ипотечные сертификаты участия""
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
			|				И _СтоимостьПереоценки.ВидСертификатаУчастия = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.КСУ)
			|			ТОГДА ""Клиринговые сертификаты участия""
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
			|			ТОГДА ""Векселя""
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Опционы)
			|			ТОГДА ""Опционы""
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Фьючерсы)
			|			ТОГДА ""Фьючерсы""
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли)
			|			ТОГДА ""Доли""
			|	КОНЕЦ КАК ВидАктива
			|ПОМЕСТИТЬ _ТаблицаЦенныхБумаг
			|ИЗ
			|	_СтоимостьПереоценки КАК _СтоимостьПереоценки
			|
			|СГРУППИРОВАТЬ ПО
			|	_СтоимостьПереоценки.Рынок,
			|	ВЫБОР
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|			ТОГДА ""Облигации""
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
			|			ТОГДА ""Акции""
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
			|			ТОГДА ""Паи""
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
			|			ТОГДА ""Депозитарные расписки""
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
			|				И _СтоимостьПереоценки.ВидСертификатаУчастия = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ИСУ)
			|			ТОГДА ""Ипотечные сертификаты участия""
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
			|				И _СтоимостьПереоценки.ВидСертификатаУчастия = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.КСУ)
			|			ТОГДА ""Клиринговые сертификаты участия""
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
			|			ТОГДА ""Векселя""
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Опционы)
			|			ТОГДА ""Опционы""
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Фьючерсы)
			|			ТОГДА ""Фьючерсы""
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли)
			|			ТОГДА ""Доли""
			|	КОНЕЦ";
		
		Запрос.Выполнить();
		
	КонецЕсли;
	
	// формируем объединение и таблицу СЧА по методике
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивыНеЦБРазвернуто.ВидАктива КАК БазаВидАктива,
		|	СУММА(_АктивыНеЦБРазвернуто.Сумма) КАК БазаСумма
		|ПОМЕСТИТЬ _Объединение
		|ИЗ
		|	_АктивыНеЦБРазвернуто КАК _АктивыНеЦБРазвернуто
		|
		|СГРУППИРОВАТЬ ПО
		|	_АктивыНеЦБРазвернуто.ВидАктива
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Дебиторская задолженность"",
		|	СУММА(_ТаблицаЦенныхБумаг.СуммаКупона)
		|ИЗ
		|	_ТаблицаЦенныхБумаг КАК _ТаблицаЦенныхБумаг
		|ГДЕ
		|	&НКДВДТ
		|	И &ДебиторскаяЗадолженность
		|	И _ТаблицаЦенныхБумаг.СуммаКупона <> 0
		|	И _ТаблицаЦенныхБумаг.Рынок В(&РынкиЦенныхБумаг)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ТаблицаЦенныхБумаг.ВидАктива,
		|	СУММА(ВЫБОР
		|			КОГДА &НКДВДТ
		|					И _ТаблицаЦенныхБумаг.ВидАктива = ""Облигации""
		|				ТОГДА _ТаблицаЦенныхБумаг.СуммаБезНКД
		|			ИНАЧЕ _ТаблицаЦенныхБумаг.Сумма
		|		КОНЕЦ)
		|ИЗ
		|	_ТаблицаЦенныхБумаг КАК _ТаблицаЦенныхБумаг
		|ГДЕ
		|	_ТаблицаЦенныхБумаг.Рынок В(&РынкиЦенныхБумаг)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ТаблицаЦенныхБумаг.ВидАктива
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Объединение.БазаВидАктива КАК БазаВидАктива,
		|	СУММА(_Объединение.БазаСумма) КАК БазаСумма
		|ИЗ
		|	_Объединение КАК _Объединение
		|
		|СГРУППИРОВАТЬ ПО
		|	_Объединение.БазаВидАктива
		|
		|ИМЕЮЩИЕ
		|	СУММА(_Объединение.БазаСумма) <> 0";

	ТаблицаСЧА = Запрос.Выполнить().Выгрузить();
		
	Возврат ТаблицаСЧА;

КонецФункции 

Функция ПолучитьТаблицуБазиса(НаборДанных, Параметры, Запрос)
	Если НаборДанных = "Основной" Тогда
		
		КонецПериодаОбъемыТоргов = НачалоМесяца(Параметры.Период) - 1;
		НачалоПериодаОбъемыТоргов = ДобавитьМесяц(НачалоМесяца(КонецПериодаОбъемыТоргов), -Параметры.КоличествоМесяцев+1);
		
		ПредыдущийТорговыйДень = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(), Параметры.Период-1, -1);
		
		Запрос.УстановитьПараметр("НачалоПериодаОбъемыТоргов", НачалоПериодаОбъемыТоргов);
		Запрос.УстановитьПараметр("КонецПериодаОбъемыТоргов", КонецПериодаОбъемыТоргов);
