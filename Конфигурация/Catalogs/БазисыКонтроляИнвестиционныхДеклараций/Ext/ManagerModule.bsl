Функция ПолучитьТекстЗапросаСвязанныхЛицГруппыКомпаний(НаборДанных) Экспорт

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&СвязанныеЛицаГруппыКомпанийЭмитентПараметр КАК СвязанныеЛицаЭмитент
		|ПОМЕСТИТЬ _Эмитенты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Эмитенты.СвязанныеЛицаЭмитент КАК СвязанныеЛицаЭмитент,
		|	ЕСТЬNULL(СвязанныеЮридическиеЛица.РодительскоеЮридическоеЛицо, _Эмитенты.СвязанныеЛицаЭмитент) КАК СвязанныеЛицаРодитель
		|ПОМЕСТИТЬ _Родители
		|ИЗ
		|	_Эмитенты КАК _Эмитенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&грПериод, ) КАК СвязанныеЮридическиеЛица
		|		ПО _Эмитенты.СвязанныеЛицаЭмитент = СвязанныеЮридическиеЛица.ЮридическоеЛицо
		|			И (СвязанныеЮридическиеЛица.Действует)
		|			И (СвязанныеЮридическиеЛица.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГруппаСвязанныхЛиц))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Родители.СвязанныеЛицаЭмитент КАК СвязанныеЛицаГруппыКомпанийЭмитент,
		|	_Родители.СвязанныеЛицаРодитель КАК СвязанныеЛицаГруппыКомпанийРодитель,
		|	ЕСТЬNULL(СвязанныеЮридическиеЛица.ЮридическоеЛицо, _Родители.СвязанныеЛицаЭмитент) КАК СвязанныеЛицаГруппыКомпанийУчастникГруппы
		|{ВЫБРАТЬ
		|	СвязанныеЛицаГруппыКомпанийЭмитент,
		|	СвязанныеЛицаГруппыКомпанийРодитель,
		|	СвязанныеЛицаГруппыКомпанийУчастникГруппы}
		|ИЗ
		|	_Родители КАК _Родители
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&грПериод, ) КАК СвязанныеЮридическиеЛица
		|		ПО _Родители.СвязанныеЛицаРодитель = СвязанныеЮридическиеЛица.РодительскоеЮридическоеЛицо
		|			И (СвязанныеЮридическиеЛица.Действует)
		|			И (СвязанныеЮридическиеЛица.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГруппаСвязанныхЛиц))
		|{ГДЕ
		|	_Родители.СвязанныеЛицаРодитель КАК СвязанныеЛицаГруппыКомпанийРодитель,
		|	(ЕСТЬNULL(СвязанныеЮридическиеЛица.ЮридическоеЛицо, _Родители.СвязанныеЛицаЭмитент)) КАК СвязанныеЛицаГруппыКомпанийУчастникГруппы}
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_Родители.СвязанныеЛицаЭмитент,
		|	_Родители.СвязанныеЛицаРодитель,
		|	_Родители.СвязанныеЛицаРодитель
		|ИЗ
		|	_Родители КАК _Родители
		|{ГДЕ
		|	_Родители.СвязанныеЛицаРодитель КАК СвязанныеЛицаГруппыКомпанийРодитель,
		|	_Родители.СвязанныеЛицаРодитель КАК СвязанныеЛицаГруппыКомпанийУчастникГруппы}";
	Возврат ТекстЗапроса;

КонецФункции

Функция ПолучитьОписаниеПолейСвязанныхЛиц(НаборДанных) Экспорт

	ОписаниеПолей = СоздатьТаблицуОписанияПолей();
	
	РолиЭмитентов = "Фонд;Управляющая компания фонда;Специализированный депозитарий фонда;Аудитор фонда;Оценщик фонда;Актуарий фонда;Оценщик управляющей компании фонда;Связанное лицо фонда;" + 
		"Связанное лицо управляющей компании фонда;Связанное лицо специализированного депозитария фонда;Связанное лицо аудитора фонда;Связанное лицо оценщика фонда;Связанное лицо актуария фонда;" +
		"Брокер";
	
	Если НаборДанных = "Основной" Тогда
		
		ДобавитьОписаниеПоля(ОписаниеПолей.Добавить(), "СвязанныеЛица.РольЭмитента",	"СвязанныеЛицаРольЭмитента", 	"Роль эмитента", 	Новый ОписаниеТипов("Строка"),,, Новый Структура("ДоступныеЗначения", РолиЭмитентов));
