			|		КОГДА _ДенежныеСредстваПретрейд.БрокерРасчетныйСчет ССЫЛКА Справочник.БанковскиеСчета
			|			ТОГДА ""Денежные средства на расчетных счетах""
			|		ИНАЧЕ ""Денежные средства у брокера""
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА _ДенежныеСредстваПретрейд.БрокерРасчетныйСчет ССЫЛКА Справочник.БанковскиеСчета
			|			ТОГДА _ДенежныеСредстваПретрейд.БрокерРасчетныйСчет
			|		ИНАЧЕ НЕОПРЕДЕЛЕНО
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА _ДенежныеСредстваПретрейд.БрокерРасчетныйСчет ССЫЛКА Справочник.БанковскиеСчета
			|			ТОГДА БанковскиеСчета.Банк
			|		ИНАЧЕ БрокерскиеКомпании.ЮрФизЛицо
			|	КОНЕЦ,
			|	_ДенежныеСредстваПретрейд.Валюта,
			|	_ДенежныеСредстваПретрейд.Сумма,
			|	0,
			|	ЛОЖЬ,
			|	ЛОЖЬ,
			|	NULL,
			|	0,
			|	NULL,
			|	NULL,
			|	NULL,
			|	0,
			|	0
			|ИЗ
			|	_ДенежныеСредстваПретрейд КАК _ДенежныеСредстваПретрейд
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БрокерскиеКомпании КАК БрокерскиеКомпании
			|		ПО _ДенежныеСредстваПретрейд.БрокерРасчетныйСчет = БрокерскиеКомпании.Ссылка
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
			|		ПО _ДенежныеСредстваПретрейд.БрокерРасчетныйСчет = БанковскиеСчета.Ссылка
			|ГДЕ
			|	&ДСНаРасчетныхСчетах
			|	И _ДенежныеСредстваПретрейд.ВидАктива = ""Денежные средства""
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_ДенежныеСредстваПретрейд.ВидАктива,
			|	ВЫБОР
			|		КОГДА _ДенежныеСредстваПретрейд.ДепозитЮрФизЛицо ССЫЛКА Справочник.ЮрФизЛица
			|			ТОГДА НЕОПРЕДЕЛЕНО
			|		ИНАЧЕ _ДенежныеСредстваПретрейд.ДепозитЮрФизЛицо
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА _ДенежныеСредстваПретрейд.ДепозитЮрФизЛицо ССЫЛКА Справочник.ЮрФизЛица
			|			ТОГДА _ДенежныеСредстваПретрейд.ДепозитЮрФизЛицо
			|		ИНАЧЕ БанковскиеСчетаДепозитов.Банк
			|	КОНЕЦ,
			|	_ДенежныеСредстваПретрейд.Валюта,
			|	_ДенежныеСредстваПретрейд.Сумма,
			|	0,
			|	ЛОЖЬ,
			|	ЛОЖЬ,
			|	_ДенежныеСредстваПретрейд.ДатаПогашенияДепозита,
			|	0,
			|	NULL,
			|	NULL,
			|	NULL,
			|	0,
			|	0
			|ИЗ
			|	_ДенежныеСредстваПретрейд КАК _ДенежныеСредстваПретрейд
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
			|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчетаДепозитов
			|			ПО ДепозитныеВклады.БанковскийСчет = БанковскиеСчетаДепозитов.Ссылка
			|		ПО _ДенежныеСредстваПретрейд.ДепозитЮрФизЛицо = ДепозитныеВклады.Ссылка
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
			|		ПО _ДенежныеСредстваПретрейд.БрокерРасчетныйСчет = БанковскиеСчета.Ссылка
			|ГДЕ
			|	&Депозиты
			|	И _ДенежныеСредстваПретрейд.ВидАктива = ""Депозиты""
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_ДенежныеСредстваПретрейд.ВидАктива,
			|	НЕОПРЕДЕЛЕНО,
			|	_ДенежныеСредстваПретрейд.ДепозитЮрФизЛицо,
			|	&ВалютаУчета,
			|	_ДенежныеСредстваПретрейд.Сумма,
			|	0,
			|	ЛОЖЬ,
			|	ЛОЖЬ,
			|	NULL,
			|	0,
			|	NULL,
			|	NULL,
			|	NULL,
			|	0,
			|	0
			|ИЗ
			|	_ДенежныеСредстваПретрейд КАК _ДенежныеСредстваПретрейд
			|ГДЕ
			|	&ДебиторскаяЗадолженность
			|	И _ДенежныеСредстваПретрейд.ВидАктива = ""Дебиторская задолженность""
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_ДенежныеСредстваПретрейд.ВидАктива,
			|	НЕОПРЕДЕЛЕНО,
			|	_ДенежныеСредстваПретрейд.ДепозитЮрФизЛицо,
			|	&ВалютаУчета,
			|	-_ДенежныеСредстваПретрейд.Сумма,
			|	0,
			|	ЛОЖЬ,
			|	ЛОЖЬ,
			|	NULL,
			|	0,
			|	NULL,
			|	NULL,
			|	NULL,
			|	0,
			|	0
			|ИЗ
			|	_ДенежныеСредстваПретрейд КАК _ДенежныеСредстваПретрейд
			|ГДЕ
			|	&КредиторскаяЗадолженность
			|	И _ДенежныеСредстваПретрейд.ВидАктива = ""Кредиторская задолженность""
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	""СПФИ"",
			|	_АктивыСПФИ.СделкаСПФИ,
			|	_АктивыСПФИ.Контрагент,
			|	_АктивыСПФИ.Валюта,
			|	_АктивыСПФИ.Номинал,
			|	0,
			|	ЛОЖЬ,
			|	ЛОЖЬ,
			|	NULL,
			|	0,
			|	_АктивыСПФИ.ДатаПоследнейПокупки,
			|	NULL,
			|	NULL,
			|	0,
			|	_АктивыСПФИ.СрокСПФИВГодах
			|ИЗ
			|	_АктивыСПФИ КАК _АктивыСПФИ";			
		#КонецОбласти 
		
		Запрос.Выполнить();	
		
	КонецЕсли;
			
КонецПроцедуры

Процедура СформироватьВременныеТаблицыКлассификацииЦБ(НаборДанных, Параметры, Запрос)

	Если НаборДанных = "Основной" Тогда
		
		ВидУчетаЕПС = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
		
		ВедетсяУчетПоЕПС = РегистрыСведений.НастройкиУчетаОбщие.ВедетсяУчетПоВиду(
			Параметры.Период,
			Параметры.Организация,
			Параметры.СчетДоверительногоУправления,
			ВидУчетаЕПС);
			
		Запрос.УстановитьПараметр("УчетныеАктивыОцениваемыеПоАС", Кэширование.УчетныеАктивыОцениваемыеПоАмортизированнойСтоимости());
		
		Если ВедетсяУчетПоЕПС Тогда
			
			Если Параметры.РасчетПартий = Неопределено Тогда
			
				//Проверка даты запрета
				ЗапросДатыЗапрета = Новый Запрос;
				ЗапросДатыЗапрета.Текст =
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования
					|ИЗ
					|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
					|ГДЕ
					|	ДатыЗапретаРедактирования.Организация = &Организация
					|	И ДатыЗапретаРедактирования.СчетДоверительногоУправления = &СчетДоверительногоУправления
					|	И ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии)
					|	И ДатыЗапретаРедактирования.ВидУчета = &ВидУчета";
				
				ЗапросДатыЗапрета.УстановитьПараметр("Организация",                  Параметры.Организация);
				ЗапросДатыЗапрета.УстановитьПараметр("СчетДоверительногоУправления", Параметры.СчетДоверительногоУправления);
				ЗапросДатыЗапрета.УстановитьПараметр("ВидУчета",                     ВидУчетаЕПС);
				
				Выборка = ЗапросДатыЗапрета.Выполнить().Выбрать();
				
				Если Выборка.Следующий() Тогда
					ДатаЗапретаРедактированияПартий = Выборка.ДатаЗапретаРедактирования;
				Иначе
					ДатаЗапретаРедактированияПартий = Дата(1, 1, 1);
				КонецЕсли;
				
				Если КонецДня(ДатаЗапретаРедактированияПартий) < КонецДня(Параметры.Период) Тогда 
					
					#Область Динамический_расчет_партий
					
					Если Параметры.Свойство("_ПлановыеДанные_Операции") Тогда
					    Запрос.Текст = 
							"ВЫБРАТЬ РАЗРЕШЕННЫЕ * ИЗ _ПлановыеДанные_Операции";
						
						Выборка = Запрос.Выполнить().Выбрать();
						ТаблицаПлановыхОпераций = РегистрыСведений.ОперацииСЦеннымиБумагами.ПолучитьОписаниеТаблицыПлановыхОпераций();
						Пока Выборка.Следующий() Цикл
							ЗаполнитьЗначенияСвойств(ТаблицаПлановыхОпераций.Добавить(), Выборка);
						КонецЦикла;
					Иначе
						ТаблицаПлановыхОпераций = РегистрыСведений.ОперацииСЦеннымиБумагами.ПолучитьОписаниеТаблицыПлановыхОпераций();
					КонецЕсли;
					
					УстановитьПривилегированныйРежим(Истина);
					
					ОбъектДокумента = Документы.РегистрацияСтоимостиПереоценки.СоздатьДокумент();
					ЗаполнитьЗначенияСвойств(ОбъектДокумента, Параметры, "Организация, СчетДоверительногоУправления, ВидУчета, ЦельРасчета");
					ОбъектДокумента.Дата = КонецДня(Параметры.Период);
					
					ПараметрыПолученияПартий = РаботаСПереоценкой.ПолучитьПараметрыПолученияПартийПоМетодике(
						Параметры.ЦельРасчета, 
						Параметры.ВидУчета, 
						Параметры.ВариантРасчетаОценочнойСтоимости, 
						ОбъектДокумента.Дата, 
						Ложь, 
						Параметры.СчетДоверительногоУправления);
	                
					ПараметрыПолученияПартий.Вставить("КоличественныйРасчет", Истина);
			
					МВТ = Новый МенеджерВременныхТаблиц;
					РаботаСПереоценкой.ПолучитьЦенныеБумаги(ОбъектДокумента, МВТ, "ТаблицаПартийЦБ", ПараметрыПолученияПартий, Параметры.РасчетПартий, ТаблицаПлановыхОпераций);
			
					УстановитьПривилегированныйРежим(Ложь);
					
					#КонецОбласти
					
				КонецЕсли;
			
			КонецЕсли; 
			
			Если Параметры.РасчетПартий <> Неопределено Тогда
				
				// это динамический расчет
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ 
					|	КонечныеОстаткиПартий.Рынок КАК Рынок,
					|	КонечныеОстаткиПартий.ЦеннаяБумага КАК ЦеннаяБумага,
					|	КонечныеОстаткиПартий.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
					|	КонечныеОстаткиПартий.Количество КАК Количество,
					|	ЛОЖЬ КАК КПоступлению
					|ПОМЕСТИТЬ _КонечныеОстаткиПартий
					|ИЗ
					|	&КонечныеОстаткиПартий КАК КонечныеОстаткиПартий
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	КонечныеОстаткиПартийКПоступлению.Рынок КАК Рынок,
					|	КонечныеОстаткиПартийКПоступлению.ЦеннаяБумага КАК ЦеннаяБумага,
					|	КонечныеОстаткиПартийКПоступлению.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
					|	КонечныеОстаткиПартийКПоступлению.Количество КАК Количество,
					|	ИСТИНА КАК КПоступлению
					|ПОМЕСТИТЬ _КонечныеОстаткиПартийКПоступлению
					|ИЗ
					|	&КонечныеОстаткиПартийКПоступлению КАК КонечныеОстаткиПартийКПоступлению";
				
				Запрос.УстановитьПараметр("КонечныеОстаткиПартий", Параметры.РасчетПартий.КонечныеОстаткиПартий);
				Запрос.УстановитьПараметр("КонечныеОстаткиПартийКПоступлению", Параметры.РасчетПартий.КонечныеОстаткиПартийКПоступлению);
				
			Иначе
				
				// получим учетные активы с партий
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ 
					|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
					|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
					|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
					|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
					|	ЛОЖЬ КАК КПоступлению
					|ПОМЕСТИТЬ _КонечныеОстаткиПартий
					|ИЗ
					|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
					|			&ПериодГраница,
					|			Организация = &Организация
					|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
					|				И ВидУчета = &ВидУчетаЕПС) КАК БухПартииЦенныхБумагОстатки
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	БухПартииЦенныхБумагКПолучениюОстатки.Рынок КАК Рынок,
					|	БухПартииЦенныхБумагКПолучениюОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
					|	БухПартииЦенныхБумагКПолучениюОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
					|	БухПартииЦенныхБумагКПолучениюОстатки.КоличествоОстаток КАК Количество,
					|	ИСТИНА КАК КПоступлению
					|ПОМЕСТИТЬ _КонечныеОстаткиПартийКПоступлению
					|ИЗ
					|	РегистрНакопления.БухПартииЦенныхБумагКПолучению.Остатки(
					|			&ПериодГраница,
					|			Организация = &Организация
					|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
					|				И ВидУчета = &ВидУчетаЕПС) КАК БухПартииЦенныхБумагКПолучениюОстатки";
				
				Запрос.УстановитьПараметр("ВидУчетаЕПС", ВидУчетаЕПС);
				Запрос.УстановитьПараметр("ПериодГраница", Новый Граница(Параметры.Период, ВидГраницы.Включая));
			
			КонецЕсли; 
			
			Запрос.Выполнить();
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_КонечныеОстаткиПартий.Рынок КАК Рынок,
				|	_КонечныеОстаткиПартий.ЦеннаяБумага КАК ЦеннаяБумага,
				|	_КонечныеОстаткиПартий.УчетныйАктивЕПС В (&УчетныеАктивыОцениваемыеПоАС)
				|		И НЕ (&ЭтоЮгория И _КонечныеОстаткиПартий.ЦеннаяБумага = &Облигация_СегежаГрупп_002) КАК АктивыОцениваемыеПоАС,
				|	ВЫБОР
				|		КОГДА _КонечныеОстаткиПартий.УчетныйАктивЕПС В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПСД))
				|			ТОГДА ""Удерживаемые до погашения""
				|		КОГДА _КонечныеОстаткиПартий.УчетныйАктивЕПС В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ВекселяДоПогашения), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения))
				|			ТОГДА ""По амортизированной стоимости""
				|		КОГДА _КонечныеОстаткиПартий.УчетныйАктивЕПС В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеПоСправедливой))
				|			ТОГДА ""По СС через прибыль и убыток""
				|		КОГДА _КонечныеОстаткиПартий.УчетныйАктивЕПС В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеДляПродажи), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеДляПродажи))
				|			ТОГДА ""По СС через прочий совокупный доход""
				|		ИНАЧЕ """"
				|	КОНЕЦ КАК Классификация,
				|	_КонечныеОстаткиПартий.КПоступлению КАК КПоступлению,
				|	_КонечныеОстаткиПартий.Количество КАК Количество
				|ПОМЕСТИТЬ _КлассификацияЦенныхБумаг_Врем
				|ИЗ
				|	_КонечныеОстаткиПартий КАК _КонечныеОстаткиПартий
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	_КонечныеОстаткиПартийКПоступлению.Рынок,
				|	_КонечныеОстаткиПартийКПоступлению.ЦеннаяБумага,
				|	_КонечныеОстаткиПартийКПоступлению.УчетныйАктивЕПС В (&УчетныеАктивыОцениваемыеПоАС)
				|		И НЕ (&ЭтоЮгория И _КонечныеОстаткиПартийКПоступлению.ЦеннаяБумага = &Облигация_СегежаГрупп_002),
				|	ВЫБОР
				|		КОГДА _КонечныеОстаткиПартийКПоступлению.УчетныйАктивЕПС В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПСД))
				|			ТОГДА ""Удерживаемые до погашения""
				|		КОГДА _КонечныеОстаткиПартийКПоступлению.УчетныйАктивЕПС В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ВекселяДоПогашения), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения))
				|			ТОГДА ""По амортизированной стоимости""
				|		КОГДА _КонечныеОстаткиПартийКПоступлению.УчетныйАктивЕПС В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеПоСправедливой))
				|			ТОГДА ""По СС через прибыль и убыток""
				|		КОГДА _КонечныеОстаткиПартийКПоступлению.УчетныйАктивЕПС В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеДляПродажи), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеДляПродажи))
				|			ТОГДА ""По СС через прочий совокупный доход""
				|		ИНАЧЕ """"
				|	КОНЕЦ,
				|	_КонечныеОстаткиПартийКПоступлению.КПоступлению,
				|	_КонечныеОстаткиПартийКПоступлению.Количество
				|ИЗ
				|	_КонечныеОстаткиПартийКПоступлению КАК _КонечныеОстаткиПартийКПоступлению
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_КлассификацияЦенныхБумаг_Врем.Рынок КАК Рынок,
				|	_КлассификацияЦенныхБумаг_Врем.ЦеннаяБумага КАК ЦеннаяБумага,
				|	_КлассификацияЦенныхБумаг_Врем.АктивыОцениваемыеПоАС КАК АктивыОцениваемыеПоАС,
				|	_КлассификацияЦенныхБумаг_Врем.Классификация КАК Классификация,
				|	_КлассификацияЦенныхБумаг_Врем.КПоступлению КАК КПоступлению,
				|	СУММА(_КлассификацияЦенныхБумаг_Врем.Количество) КАК Количество
				|ПОМЕСТИТЬ _КлассификацияЦенныхБумаг
				|ИЗ
				|	_КлассификацияЦенныхБумаг_Врем КАК _КлассификацияЦенныхБумаг_Врем
				|
				|СГРУППИРОВАТЬ ПО
				|	_КлассификацияЦенныхБумаг_Врем.Рынок,
				|	_КлассификацияЦенныхБумаг_Врем.ЦеннаяБумага,
				|	_КлассификацияЦенныхБумаг_Врем.АктивыОцениваемыеПоАС,
				|	_КлассификацияЦенныхБумаг_Врем.Классификация,
				|	_КлассификацияЦенныхБумаг_Врем.КПоступлению
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|УНИЧТОЖИТЬ _КлассификацияЦенныхБумаг_Врем";
			
			Запрос.Выполнить();
			 
			
			Запрос.Текст = 
				"УНИЧТОЖИТЬ _КонечныеОстаткиПартий
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|УНИЧТОЖИТЬ _КонечныеОстаткиПартийКПоступлению";
			Запрос.Выполнить();
			
		Иначе
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	НЕОПРЕДЕЛЕНО КАК Рынок,
				|	НЕОПРЕДЕЛЕНО КАК ЦеннаяБумага,
				|	ЛОЖЬ КАК АктивыОцениваемыеПоАС,
				|	"""" КАК Классификация,
				|	ЛОЖЬ КАК КПоступлению,
				|	0 КАК Количество
				|ПОМЕСТИТЬ _КлассификацияЦенныхБумаг
				|ГДЕ
				|	ЛОЖЬ";
			
			Запрос.Выполнить();
			
		КонецЕсли; 
	КонецЕсли; 

КонецПроцедуры

Функция ПолучитьЧистыйМесячныйОтток(СчетДоверительногоУправления, Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 6
		|	ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.Период КАК Период,
		|	ВЫБОР
		|		КОГДА ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.КоличествоНачальныйОстаток = 0
		|			ТОГДА 0
		|		ИНАЧЕ (ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.КоличествоРасход - ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.КоличествоПриход) * 100 / ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.КоличествоНачальныйОстаток
		|	КОНЕЦ КАК Отток
		|ПОМЕСТИТЬ _МаксимальныеЗначенияОттока
		|ИЗ
		|	РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Месяц,
		|			,
		|			ПаевойИнвестиционныйФонд В
		|				(ВЫБРАТЬ
		|					КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|				ИЗ
		|					РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних)) КАК ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты
		|
		|УПОРЯДОЧИТЬ ПО
		|	Отток УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	_МаксимальныеЗначенияОттока.Отток КАК Отток
		|ИЗ
		|	_МаксимальныеЗначенияОттока КАК _МаксимальныеЗначенияОттока
		|
		|УПОРЯДОЧИТЬ ПО
		|	Отток";
	
	КонецПериода = НачалоМесяца(ТекущаяДата()) - 1;
	НачалоПериода = ДобавитьМесяц(НачалоМесяца(КонецПериода), -35);
	
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецПериода, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Отток;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

#Область Получение_стоимостей_ценных_бумаг

Процедура ПолучитьСтоимостиЦеннныхБумагДляКонтроляИД(НаборДанных, Параметры, Запрос)
	
	Если НаборДанных = "Основной" Тогда
		
		ТипыЗадолженностейПоЦеннымБумагам = Новый Массив;
		ТипыЗадолженностейПоЦеннымБумагам.Добавить(Перечисления.ТипыЗадолженности.Дебиторская);
		ТипыЗадолженностейПоЦеннымБумагам.Добавить(Перечисления.ТипыЗадолженности.Кредиторская);
		
		ПараметрыПолученияОстатков = Новый Структура;
		ПараметрыПолученияОстатков.Вставить("ОстаткиЦенныхБумаг", Истина);
		ПараметрыПолученияОстатков.Вставить("ТипыЗадолженностейПоЦеннымБумагам", ТипыЗадолженностейПоЦеннымБумагам);
		ПараметрыПолученияОстатков.Вставить("ЗадолженностиПоВторойЧастиРЕПО", Истина);
		ПараметрыПолученияОстатков.Вставить("НеУчитыватьЦБКупленныеПоРЕПО", Ложь);
		ПараметрыПолученияОстатков.Вставить("УчитыватьЦБПроданныеВРЕПО",	Истина);
		
		Справочники.ВариантыРасчетаОценочнойСтоимости.ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(
			Параметры.ВариантРасчетаОценочнойСтоимости,
			Параметры.Организация,
			Параметры.СчетДоверительногоУправления,
			Параметры.Период,
			Запрос.МенеджерВременныхТаблиц,
			ПараметрыПолученияОстатков);
		
		#Область ТекстЗапроса_ОстаткиЦенныхБумаг
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ЦенныеБумаги.Рынок КАК Рынок,
			|	_ЦенныеБумаги.Актив КАК Актив,
			|	ЕСТЬNULL(_КлассификацияЦенныхБумаг.АктивыОцениваемыеПоАС, ЛОЖЬ) КАК АктивыОцениваемыеПоАС,
			|	ЕСТЬNULL(_КлассификацияЦенныхБумаг.Количество, _ЦенныеБумаги.Количество) КАК Количество,
			|	ЕСТЬNULL(_КлассификацияЦенныхБумаг.КПоступлению, ЛОЖЬ) КАК КПоступлению,
			|	0 КАК КоличествоПоРЕПО
			|ПОМЕСТИТЬ _Остатки
			|ИЗ
			|	(ВЫБРАТЬ
			|		_ЦенныеБумаги.Рынок КАК Рынок,
			|		_ЦенныеБумаги.ЦеннаяБумага КАК Актив,
			|		СУММА(_ЦенныеБумаги.Количество) КАК Количество
			|	ИЗ
			|		_ЦенныеБумаги КАК _ЦенныеБумаги
			|	
			|	СГРУППИРОВАТЬ ПО
			|		_ЦенныеБумаги.Рынок,
			|		_ЦенныеБумаги.ЦеннаяБумага) КАК _ЦенныеБумаги
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КлассификацияЦенныхБумаг КАК _КлассификацияЦенныхБумаг
			|		ПО _ЦенныеБумаги.Рынок = _КлассификацияЦенныхБумаг.Рынок
			|			И _ЦенныеБумаги.Актив = _КлассификацияЦенныхБумаг.ЦеннаяБумага";
			
		Запрос.Выполнить();
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВложенныйЗапрос.Рынок КАК Рынок,
			|	ВложенныйЗапрос.Актив КАК Актив,
			|	ВложенныйЗапрос.АктивыОцениваемыеПоАС КАК АктивыОцениваемыеПоАС,
			|	СУММА(ВложенныйЗапрос.Количество) КАК Количество,
			|	ВложенныйЗапрос.КПоступлению КАК КПоступлению,
			|	СУММА(ВложенныйЗапрос.КоличествоПоРЕПО) КАК КоличествоПоРЕПО,
			|	ВЫБОР
			|		КОГДА ВложенныйЗапрос.Актив ССЫЛКА Справочник.Акции
			|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Актив КАК Справочник.Акции).ВалютаНоминала
			|		КОГДА ВложенныйЗапрос.Актив ССЫЛКА Справочник.Векселя
			|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Актив КАК Справочник.Векселя).ВалютаНоминала
			|		КОГДА ВложенныйЗапрос.Актив ССЫЛКА Справочник.ДепозитарныеРасписки
			|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Актив КАК Справочник.ДепозитарныеРасписки).ВалютаНоминала
			|		КОГДА ВложенныйЗапрос.Актив ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
			|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Актив КАК Справочник.ИпотечныеСертификатыУчастия).ВалютаНоминала
			|		КОГДА ВложенныйЗапрос.Актив ССЫЛКА Справочник.Облигации
			|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Актив КАК Справочник.Облигации).ВалютаНоминала
			|		КОГДА ВложенныйЗапрос.Актив ССЫЛКА Справочник.Паи
			|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Актив КАК Справочник.Паи).ВалютаНоминала
			|		КОГДА ВложенныйЗапрос.Актив ССЫЛКА Справочник.ПроизводныеФинансовыеИнструменты
			|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Актив КАК Справочник.ПроизводныеФинансовыеИнструменты).Валюта
			|		КОГДА ВложенныйЗапрос.Актив ССЫЛКА Справочник.Доли
			|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Актив КАК Справочник.Доли).ВалютаНоминала
			|	КОНЕЦ КАК ВалютаНоминала,
			|	МАКСИМУМ(ВложенныйЗапрос.ДатаПоследнейПокупки) КАК ДатаПоследнейПокупки
			|ПОМЕСТИТЬ _ОстаткиЦенныхБумаг
			|ИЗ
			|	(ВЫБРАТЬ
			|		_Остатки.Рынок КАК Рынок,
			|		_Остатки.Актив КАК Актив,
			|		_Остатки.АктивыОцениваемыеПоАС КАК АктивыОцениваемыеПоАС,
			|		_Остатки.Количество КАК Количество,
			|		_Остатки.КПоступлению КАК КПоступлению,
			|		_Остатки.КоличествоПоРЕПО КАК КоличествоПоРЕПО,
			|		ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПоследнейПокупки
			|	ИЗ
			|		_Остатки КАК _Остатки
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		_ЦенныеБумагиПретрейд.Рынок,
			|		_ЦенныеБумагиПретрейд.ЦеннаяБумага,
			|		_ЦенныеБумагиПретрейд.АктивыОцениваемыеПоАС,
			|		_ЦенныеБумагиПретрейд.Количество,
			|		ЛОЖЬ,
			|		0,
			|		&НачалоПериода
			|	ИЗ
			|		_ЦенныеБумагиПретрейд КАК _ЦенныеБумагиПретрейд) КАК ВложенныйЗапрос
			|
			|СГРУППИРОВАТЬ ПО
			|	ВложенныйЗапрос.Рынок,
			|	ВложенныйЗапрос.Актив,
			|	ВложенныйЗапрос.АктивыОцениваемыеПоАС,
			|	ВложенныйЗапрос.КПоступлению
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Рынок,
			|	Актив";			
		
		#КонецОбласти 
		
		Запрос.Выполнить();
		
		Если Параметры.КонтрольЗаПрошлыйПериод Тогда
			
			ТаблицаКупонов = Новый ТаблицаЗначений;
			ТаблицаКупонов.Колонки.Добавить("Актив", Новый ОписаниеТипов("СправочникСсылка.Облигации"));
			ТаблицаКупонов.Колонки.Добавить("Купон", Новый ОписаниеТипов("Число"));
			
		Иначе
			
			Запрос.Текст =  
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ОстаткиЦенныхБумаг.Актив КАК Актив,
				|	ЕСТЬNULL(ОценкиСтоимостиЦенныхБумагСрезПоследних.СтоимостьКупона, 0) КАК Купон,
				|	ВЫБОР
				|		КОГДА Облигации.ВалютаНоминала = &ВалютаУчета
				|			ТОГДА 2
				|		ИНАЧЕ 4
				|	КОНЕЦ КАК ТочностьКупона,
				|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ЦеннаяБумага ЕСТЬ NULL КАК ПолучитьРасчетныйКупон
				|ИЗ
				|	_Остатки КАК _ОстаткиЦенныхБумаг
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
				|		ПО _ОстаткиЦенныхБумаг.Актив = Облигации.Ссылка
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОценкиСтоимостиЦенныхБумаг.СрезПоследних(
				|				&НачалоПериода,
				|				Организация = &Организация
				|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|					И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
				|					И ПовышенныйПриоритет) КАК ОценкиСтоимостиЦенныхБумагСрезПоследних
				|		ПО _ОстаткиЦенныхБумаг.Актив = ОценкиСтоимостиЦенныхБумагСрезПоследних.ЦеннаяБумага
				|			И (ОценкиСтоимостиЦенныхБумагСрезПоследних.ОценкаКупона
				|				И ОценкиСтоимостиЦенныхБумагСрезПоследних.ДатаОкончанияДействия >= &НачалоПериода)";
			ТаблицаКупонов = Запрос.Выполнить().Выгрузить();
			
			Для каждого СтрокаОблигаций Из ТаблицаКупонов Цикл
				Если СтрокаОблигаций.ПолучитьРасчетныйКупон Тогда
					СтрокаОблигаций.Купон = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(СтрокаОблигаций.Актив, НачалоДня(Параметры.Период), Параметры.СчетДоверительногоУправления, , СтрокаОблигаций.ТочностьКупона);
				КонецЕсли;				
			КонецЦикла;
			
		КонецЕсли; 
		
		Запрос.УстановитьПараметр("ДатаФормированияСЧА",	Параметры.ДатаФормированияСЧА);
		Запрос.УстановитьПараметр("ТаблицаКупонов", 		ТаблицаКупонов);
		
		ПолучитьЦены(Запрос, Параметры);
		СформироватьВременнуюТаблицуДатыПоследнихПокупок(Запрос, Параметры);

		#Область ТекстЗапроса_СправедливыеЦены
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КурсыВалют.Период КАК Период,
			|	КурсыВалют.Валюта КАК Валюта,
			|	КурсыВалют.Курс / КурсыВалют.Кратность / КурсВалютыУчета.Курс * КурсВалютыУчета.Кратность КАК Коэффициент
			|ПОМЕСТИТЬ _КурсыВалют
			|ИЗ
			|	РегистрСведений.КурсыВалют КАК КурсыВалют
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыУчета
			|		ПО КурсыВалют.Период = КурсВалютыУчета.Период
			|			И (КурсВалютыУчета.Валюта = &ВалютаУчета)
			|ГДЕ
			|	КурсыВалют.Период В (&ДатаКурса, &ДатаФормированияСЧА)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	КупонныйДоходПоОблигациямСрезПоследних.Облигация КАК Облигация
			|ПОМЕСТИТЬ _ПогашенияКупонов
			|ИЗ
			|	_ЦеныВВалюте КАК _ЦеныВВалюте
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям.СрезПоследних(&Период, ) КАК КупонныйДоходПоОблигациямСрезПоследних
			|		ПО _ЦеныВВалюте.Актив = КупонныйДоходПоОблигациямСрезПоследних.Облигация
			|			И (КупонныйДоходПоОблигациямСрезПоследних.ДатаОкончанияКупона = &НачалоПериода)
			|ГДЕ
			|	&УчитыватьПлановыеОперации
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Облигации.Ссылка КАК ЦеннаяБумага
			|ПОМЕСТИТЬ _ПогашенияНоминалов
			|ИЗ
			|	_ЦеныВВалюте КАК _ЦеныВВалюте
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
			|		ПО _ЦеныВВалюте.Актив = Облигации.Ссылка
			|ГДЕ
			|	&УчитыватьПлановыеОперации
			|	И Облигации.ДатаПогашения = &НачалоПериода
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_СтоимостиПереоценки.Рынок КАК Рынок,
			|	_СтоимостиПереоценки.ВалютаНоминала КАК Валюта,
			|	_СтоимостиПереоценки.Актив КАК Актив,
			|	_СтоимостиПереоценки.АктивыОцениваемыеПоАС КАК АктивыОцениваемыеПоАС,
			|	_СтоимостиПереоценки.Цена КАК ЦенаДюрация,
			|	_СтоимостиПереоценки.ЦенаКупона КАК ЦенаКупонаДюрация,
			|	ВЫБОР
			|		КОГДА _ПогашенияНоминалов.ЦеннаяБумага ЕСТЬ NULL
			|			ТОГДА _СтоимостиПереоценки.Цена * ВЫБОР
			|					КОГДА _СтоимостиПереоценки.КурсВалютыНоминала = 0
			|						ТОГДА _КурсыВалютЦены.Коэффициент * ВЫБОР
			|								КОГДА &ОцениватьПоЦенамПриобретения
			|									ТОГДА _КурсыВалютЦены.Коэффициент / _КурсыВалютЦеныПоследнегоРабочегоДня.Коэффициент
			|								ИНАЧЕ 1
			|							КОНЕЦ
			|					ИНАЧЕ _СтоимостиПереоценки.КурсВалютыНоминала
			|				КОНЕЦ
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК Цена,
			|	ВЫБОР
			|		КОГДА _ПогашенияКупонов.Облигация ЕСТЬ NULL
			|			ТОГДА _СтоимостиПереоценки.ЦенаКупона * ВЫБОР
			|					КОГДА _СтоимостиПереоценки.КурсВалютыНоминала = 0
			|						ТОГДА _КурсыВалютКупона.Коэффициент
			|					ИНАЧЕ _СтоимостиПереоценки.КурсВалютыНоминала
			|				КОНЕЦ
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК ЦенаКупона,
			|	_СтоимостиПереоценки.ОтсутствуетСтоимостьПереоценки КАК ОтсутствуетСтоимостьПереоценки,
			|	_СтоимостиПереоценки.ЦенаТМинус2 КАК ЦенаТМинус2
			|ПОМЕСТИТЬ _СправедливыеЦены
			|ИЗ
			|	_ЦеныВВалюте КАК _СтоимостиПереоценки
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалютЦены
			|		ПО _СтоимостиПереоценки.ВалютаЦены = _КурсыВалютЦены.Валюта
			|			И (_КурсыВалютЦены.Период = &ДатаКурса)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалютКупона
			|		ПО _СтоимостиПереоценки.ВалютаКупона = _КурсыВалютКупона.Валюта
			|			И (_КурсыВалютКупона.Период = &ДатаКурса)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалютЦеныПоследнегоРабочегоДня
			|		ПО _СтоимостиПереоценки.ВалютаЦены = _КурсыВалютЦеныПоследнегоРабочегоДня.Валюта
			|			И (_КурсыВалютЦеныПоследнегоРабочегоДня.Период = &ДатаФормированияСЧА)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДефолтыПоОблигациям.СрезПоследних(&НачалоПериода, ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации)) КАК ДефолтыПоОблигациямСрезПоследних
			|		ПО _СтоимостиПереоценки.Актив = ДефолтыПоОблигациямСрезПоследних.Облигация
			|			И (ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт))
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ПогашенияКупонов КАК _ПогашенияКупонов
			|		ПО _СтоимостиПереоценки.Актив = _ПогашенияКупонов.Облигация
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ПогашенияНоминалов КАК _ПогашенияНоминалов
			|		ПО _СтоимостиПереоценки.Актив = _ПогашенияНоминалов.ЦеннаяБумага";			
		#КонецОбласти 
		
		Запрос.Выполнить();
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СправедливыеЦены.Рынок КАК Рынок,
			|	_СправедливыеЦены.Актив КАК ЦеннаяБумага,
			|	_СправедливыеЦены.Цена КАК Цена
			|ИЗ
			|	_СправедливыеЦены КАК _СправедливыеЦены
			|ГДЕ
			|	_СправедливыеЦены.ЦенаТМинус2
			|
			|УПОРЯДОЧИТЬ ПО
			|	Рынок,
			|	ЦеннаяБумага
			|АВТОУПОРЯДОЧИВАНИЕ";
		
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			Параметры.Вставить("ТаблицаЦенТМинус2", Неопределено);
		Иначе
			Параметры.Вставить("ТаблицаЦенТМинус2", РезультатЗапроса.Выгрузить());
		КонецЕсли;
		
		#Область Уничтожение_временных_таблиц
		Запрос.Текст = 
			"УНИЧТОЖИТЬ _Остатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ОстаткиЦенныхБумаг
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _КурсыВалют
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ЦенныеБумаги
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ЦеныВВалюте
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ПогашенияКупонов
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ПогашенияНоминалов";
		
		Для каждого Таблица Из Запрос.МенеджерВременныхТаблиц.Таблицы Цикл
		
			Если СтрЗаканчиваетсяНа(Таблица.ПолноеИмя, "БезОтборов") Тогда
				Запрос.Текст = Запрос.Текст + "
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|УНИЧТОЖИТЬ " + Таблица.ПолноеИмя;
			КонецЕсли; 
		
		КонецЦикла; 
			
		Запрос.Выполнить();			
		#КонецОбласти 
		
	КонецЕсли;
			
КонецПроцедуры

Процедура ПолучитьЦены(Запрос, Параметры)
	
	ВыполнитьДинамическийРасчет = Истина;
	
	Если Не Параметры.ДинамическийРасчетСтоимости Тогда
		// на форме выбран режим получения стоимостей из документов, но документы еще могут быть не сформированы
		// проверяем есть ли документы, если их нет - выполним динамический расчет
		ЗапросКонтроль = Новый Запрос;
		ЗапросКонтроль.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ФинансовыеПоказатели.Период КАК Период
			|ИЗ
			|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
			|ГДЕ
			|	ФинансовыеПоказатели.Период = &ДатаФормированияСЧА
			|	И ФинансовыеПоказатели.Организация = &Организация
			|	И ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
			|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)";
		ЗапросКонтроль.УстановитьПараметр("Организация", Параметры.Организация);
		ЗапросКонтроль.УстановитьПараметр("СчетДоверительногоУправления", Параметры.СчетДоверительногоУправления);
		ЗапросКонтроль.УстановитьПараметр("ДатаФормированияСЧА", Параметры.ДатаФормированияСЧА);
		
		Если Не ЗапросКонтроль.Выполнить().Пустой() Тогда
			// документ есть, получим стоимости из регистра
			ПолучитьСтоимостиИзРегистра(Запрос, Параметры, "_СправедливыеЦены_Все");
			ВыполнитьДинамическийРасчет = Ложь;
		КонецЕсли; 
	
	КонецЕсли; 
	
	ПолучитьПоследнююСтоимость = Ложь;
	Если ВыполнитьДинамическийРасчет Тогда
		// документ еще не создан, либо выбран динамический расчет
		ПолучитьСтоимостьДинамически(Запрос, Параметры, ПолучитьПоследнююСтоимость);
		Если Не Параметры.ДинамическийРасчетСтоимости Тогда
			Параметры.Вставить("ИспользованыПредварительныеЦены");
		КонецЕсли; 
	КонецЕсли; 	
	
	// если есть различные стоимости по партиям - берем средневзвес
	ОбработатьСтоимостиПоПартиям(Запрос);
	
	Если Не Параметры.КонтрольЗаПрошлыйПериод Или ПолучитьПоследнююСтоимость Тогда
		
		ПолучитьЦеныПоследнихПоступлений(Запрос, Параметры);
			
	Иначе // контроль за прошлый период
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СправедливыеЦены_Врем.Рынок КАК Рынок,
		|	_СправедливыеЦены_Врем.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_СправедливыеЦены_Врем.АктивыОцениваемыеПоАС КАК АктивыОцениваемыеПоАС,
		|	_СправедливыеЦены_Врем.Погашена КАК Погашена,
		|	_СправедливыеЦены_Врем.Цена КАК Цена,
		|	_СправедливыеЦены_Врем.ЦенаКупона КАК ЦенаКупона,
		|	_СправедливыеЦены_Врем.КурсВалютыНоминала КАК КурсВалютыНоминала,
		|	NULL КАК Валюта,
		|	_СправедливыеЦены_Врем.ЦенаТМинус2 КАК ЦенаТМинус2
		|ПОМЕСТИТЬ _СправедливыеЦены
		|ИЗ
		|	_СправедливыеЦены_Врем КАК _СправедливыеЦены_Врем
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _СправедливыеЦены_Врем";
	
	КонецЕсли; 
	
	Запрос.Выполнить();
	
	ВыполнитьПодменуЦенАтлант(Запрос, Параметры); 
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаКупонов.Актив КАК Актив,
		|	ТаблицаКупонов.Купон КАК Купон
		|ПОМЕСТИТЬ _ТаблицаКупонов
		|ИЗ
		|	&ТаблицаКупонов КАК ТаблицаКупонов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОстаткиЦенныхБумаг.Рынок КАК Рынок,
		|	_ОстаткиЦенныхБумаг.Актив КАК Актив,
		|	_ОстаткиЦенныхБумаг.АктивыОцениваемыеПоАС КАК АктивыОцениваемыеПоАС,
		|	_ОстаткиЦенныхБумаг.ВалютаНоминала КАК ВалютаНоминала,
		|	_ОстаткиЦенныхБумаг.Количество КАК Количество,
		|	_ОстаткиЦенныхБумаг.КПоступлению КАК КПоступлению,
		|	_ОстаткиЦенныхБумаг.КоличествоПоРЕПО КАК КоличествоПоРЕПО,
		|	ЕСТЬNULL(_ЦенныеБумагиПретрейд.Цена, ЕСТЬNULL(_СправедливыеЦены.Цена, ЕСТЬNULL(_СправедливыеЦеныДляКИД.Цена, 0))) КАК Цена,
		|	ЕСТЬNULL(_ЦенныеБумагиПретрейд.Купон, ЕСТЬNULL(_СправедливыеЦены.ЦенаКупона, ЕСТЬNULL(_СправедливыеЦеныДляКИД.ЦенаКупона, ЕСТЬNULL(_ТаблицаКупонов.Купон, 0)))) КАК ЦенаКупона,
		|	ЕСТЬNULL(_ЦенныеБумагиПретрейд.Цена, ЕСТЬNULL(_СправедливыеЦены.Цена, _СправедливыеЦеныДляКИД.Цена)) ЕСТЬ NULL КАК ОтсутствуетСтоимостьПереоценки,
		|	ВЫБОР
		|		КОГДА _ЦенныеБумагиПретрейд.Цена ЕСТЬ НЕ NULL 
		|			ТОГДА &ВалютаУчета
		|		ИНАЧЕ ЕСТЬNULL(_СправедливыеЦены.Валюта, ЕСТЬNULL(_СправедливыеЦеныДляКИД.Валюта, _ОстаткиЦенныхБумаг.ВалютаНоминала))
		|	КОНЕЦ КАК ВалютаЦены,
		|	ВЫБОР
		|		КОГДА _ЦенныеБумагиПретрейд.Цена ЕСТЬ НЕ NULL 
		|			ТОГДА &ВалютаУчета
		|		КОГДА _ТаблицаКупонов.Актив ЕСТЬ НЕ NULL 
		|			ТОГДА _ОстаткиЦенныхБумаг.ВалютаНоминала
		|		ИНАЧЕ ЕСТЬNULL(_СправедливыеЦены.Валюта, ЕСТЬNULL(_СправедливыеЦеныДляКИД.Валюта, _ОстаткиЦенныхБумаг.ВалютаНоминала))
		|	КОНЕЦ КАК ВалютаКупона,
		|	ЕСТЬNULL(_ЦенныеБумагиПретрейд.КурсВалютыНоминала, ЕСТЬNULL(_СправедливыеЦены.КурсВалютыНоминала, ЕСТЬNULL(_СправедливыеЦеныДляКИД.КурсВалютыНоминала, 0))) КАК КурсВалютыНоминала,
		|	ЕСТЬNULL(_ЦенныеБумагиПретрейд.ЦенаТМинус2, ЕСТЬNULL(_СправедливыеЦены.ЦенаТМинус2, ЕСТЬNULL(_СправедливыеЦеныДляКИД.ЦенаТМинус2, ЛОЖЬ))) КАК ЦенаТМинус2
		|ПОМЕСТИТЬ _ЦеныВВалюте
		|ИЗ
		|	_ОстаткиЦенныхБумаг КАК _ОстаткиЦенныхБумаг
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумагиПретрейд КАК _ЦенныеБумагиПретрейд
		|		ПО _ОстаткиЦенныхБумаг.Актив = _ЦенныеБумагиПретрейд.ЦеннаяБумага
		|			И _ОстаткиЦенныхБумаг.АктивыОцениваемыеПоАС = _ЦенныеБумагиПретрейд.АктивыОцениваемыеПоАС
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СправедливыеЦены КАК _СправедливыеЦены
		|		ПО _ОстаткиЦенныхБумаг.Актив = _СправедливыеЦены.ЦеннаяБумага
		|			И (_ОстаткиЦенныхБумаг.АктивыОцениваемыеПоАС = _СправедливыеЦены.АктивыОцениваемыеПоАС
		|				ИЛИ _СправедливыеЦены.Погашена)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СправедливыеЦены КАК _СправедливыеЦеныДляКИД
		|		ПО _ОстаткиЦенныхБумаг.Актив = _СправедливыеЦеныДляКИД.ЦеннаяБумага
		|			И (_СправедливыеЦеныДляКИД.АктивыОцениваемыеПоАС = НЕОПРЕДЕЛЕНО)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаКупонов КАК _ТаблицаКупонов
		|		ПО _ОстаткиЦенныхБумаг.Актив = _ТаблицаКупонов.Актив
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Рынок,
		|	Актив";
	
	Запрос.Выполнить();
	
	РасхожденияСтоимостейЦенныхБумаг = Запрос.МенеджерВременныхтаблиц.Таблицы.Найти("_РасхожденияСтоимостейЦенныхБумаг");
	Если РасхожденияСтоимостейЦенныхБумаг = Неопределено Тогда
		Параметры.Вставить("РасхожденияСтоимостейЦенныхБумаг", Неопределено);
	Иначе
		Параметры.Вставить("РасхожденияСтоимостейЦенныхБумаг", РасхожденияСтоимостейЦенныхБумаг.ПолучитьДанные().Выгрузить());
		Запрос.Текст = "УНИЧТОЖИТЬ _РасхожденияСтоимостейЦенныхБумаг";
		Запрос.Выполнить();
	КонецЕсли;
	
	// уничтожаем отдельно для обеспечения возможности отладки
	Запрос.Текст = 
		"УНИЧТОЖИТЬ _СправедливыеЦены_Все
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ТаблицаКупонов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _СправедливыеЦены";
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ВыполнитьПодменуЦенАтлант(Запрос, Параметры)

	Если Параметры.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_DU_PIF352") 
		И БухгалтерскийУчет.ОпределитьНастройкуУчета(Параметры.ДатаФормированияСЧА, Параметры.Организация, Параметры.СчетДоверительногоУправления, "ПриостановленРасчетСЧА") Тогда
		
		Запрос.УстановитьПараметр("ЦенныеБумагиПоНРД", ПолучитьЦенныеБумагиПоНРД(Параметры));
		
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ПредварительныеЦены") = Неопределено Тогда
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ОстаткиЦенныхБумаг.Рынок КАК Рынок,
				|	_ОстаткиЦенныхБумаг.Актив КАК ЦеннаяБумага,
				|	_ОстаткиЦенныхБумаг.ВалютаНоминала КАК Валюта,
				|	_СправедливыеЦены.АктивыОцениваемыеПоАС КАК АктивыОцениваемыеПоАС,
				|	_СправедливыеЦены.Погашена КАК Погашена,
				|	_СправедливыеЦены.Цена КАК Цена,
				|	_СправедливыеЦены.ЦенаКупона КАК ЦенаКупона,
				|	_СправедливыеЦены.КурсВалютыНоминала КАК КурсВалютыНоминала,
				|	_СправедливыеЦены.ЦенаТМинус2 КАК ЦенаТМинус2
				|ПОМЕСТИТЬ _ПредварительныеЦеныАтлант
				|ИЗ
				|	_ОстаткиЦенныхБумаг КАК _ОстаткиЦенныхБумаг
				|		ЛЕВОЕ СОЕДИНЕНИЕ _СправедливыеЦены КАК _СправедливыеЦены
				|		ПО _ОстаткиЦенныхБумаг.Рынок = _СправедливыеЦены.Рынок
				|			И _ОстаткиЦенныхБумаг.Актив = _СправедливыеЦены.ЦеннаяБумага";
			
		Иначе
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ОстаткиЦенныхБумаг.Рынок КАК Рынок,
				|	_ОстаткиЦенныхБумаг.Актив КАК ЦеннаяБумага,
				|	_ОстаткиЦенныхБумаг.ВалютаНоминала КАК Валюта,
				|	ЕСТЬNULL(_СправедливыеЦены.АктивыОцениваемыеПоАС, _ПредварительныеЦены.АктивыОцениваемыеПоАС) КАК АктивыОцениваемыеПоАС,
				|	ЕСТЬNULL(_СправедливыеЦены.Погашена, _ПредварительныеЦены.Погашена) КАК Погашена,
				|	ЕСТЬNULL(_СправедливыеЦены.Цена, _ПредварительныеЦены.Цена) КАК Цена,
				|	ЕСТЬNULL(_СправедливыеЦены.ЦенаКупона, _ПредварительныеЦены.ЦенаКупона) КАК ЦенаКупона,
				|	ЕСТЬNULL(_СправедливыеЦены.КурсВалютыНоминала, _ПредварительныеЦены.КурсВалютыНоминала) КАК КурсВалютыНоминала,
				|	_СправедливыеЦены.ЦенаТМинус2 КАК ЦенаТМинус2
				|ПОМЕСТИТЬ _ПредварительныеЦеныАтлант
				|ИЗ
				|	_ОстаткиЦенныхБумаг КАК _ОстаткиЦенныхБумаг
				|		ЛЕВОЕ СОЕДИНЕНИЕ _ПредварительныеЦены КАК _ПредварительныеЦены
				|		ПО _ОстаткиЦенныхБумаг.Рынок = _ПредварительныеЦены.Рынок
				|			И _ОстаткиЦенныхБумаг.Актив = _ПредварительныеЦены.ЦеннаяБумага
				|		ЛЕВОЕ СОЕДИНЕНИЕ _СправедливыеЦены КАК _СправедливыеЦены
				|		ПО _ОстаткиЦенныхБумаг.Рынок = _СправедливыеЦены.Рынок
				|			И _ОстаткиЦенныхБумаг.Актив = _СправедливыеЦены.ЦеннаяБумага";
			
		КонецЕсли; 
		
		Запрос.Выполнить();
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ПредварительныеЦеныАтлант.Рынок КАК Рынок,
			|	_ПредварительныеЦеныАтлант.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_ПредварительныеЦеныАтлант.АктивыОцениваемыеПоАС КАК АктивыОцениваемыеПоАС,
			|	_ПредварительныеЦеныАтлант.Погашена КАК Погашена,
			|	ВЫБОР
			|		КОГДА _ПредварительныеЦеныАтлант.Цена = 0
			|			ТОГДА РасчетныеЦеныНРД.RATE * НоминалыЦенныхБумагСрезПоследних.Номинал / 100
			|		ИНАЧЕ _ПредварительныеЦеныАтлант.Цена
			|	КОНЕЦ КАК Цена,
			|	_ПредварительныеЦеныАтлант.ЦенаКупона КАК ЦенаКупона,
			|	_ПредварительныеЦеныАтлант.КурсВалютыНоминала КАК КурсВалютыНоминала,
			|	_ПредварительныеЦеныАтлант.Валюта КАК Валюта,
			|	ЕСТЬNULL(_ПредварительныеЦеныАтлант.ЦенаТМинус2, ЛОЖЬ) КАК ЦенаТМинус2
			|ПОМЕСТИТЬ _СправедливыеЦеныАтлант
			|ИЗ
			|	_ПредварительныеЦеныАтлант КАК _ПредварительныеЦеныАтлант
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаФормированияСЧА, ЦеннаяБумага В (&ЦенныеБумагиПоНРД)) КАК НоминалыЦенныхБумагСрезПоследних
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныНРД КАК РасчетныеЦеныНРД
			|			ПО (РасчетныеЦеныНРД.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))
			|				И (РасчетныеЦеныНРД.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага)
			|				И (РасчетныеЦеныНРД.ЦеннаяБумага В (&ЦенныеБумагиПоНРД))
			|				И (РасчетныеЦеныНРД.Период = &ДатаФормированияСЧА)
			|				И (РасчетныеЦеныНРД.VERSION = ""2"")
			|				И (РасчетныеЦеныНРД.METHOD_NUMBER = ""3"")
			|		ПО _ПредварительныеЦеныАтлант.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ПредварительныеЦеныАтлант
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _СправедливыеЦены
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СправедливыеЦеныАтлант.Рынок КАК Рынок,
			|	_СправедливыеЦеныАтлант.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_СправедливыеЦеныАтлант.АктивыОцениваемыеПоАС КАК АктивыОцениваемыеПоАС,
			|	_СправедливыеЦеныАтлант.Погашена КАК Погашена,
			|	_СправедливыеЦеныАтлант.Цена КАК Цена,
			|	_СправедливыеЦеныАтлант.ЦенаКупона КАК ЦенаКупона,
			|	_СправедливыеЦеныАтлант.КурсВалютыНоминала КАК КурсВалютыНоминала,
			|	_СправедливыеЦеныАтлант.Валюта КАК Валюта,
			|	_СправедливыеЦеныАтлант.ЦенаТМинус2 КАК ЦенаТМинус2
			|ПОМЕСТИТЬ _СправедливыеЦены
			|ИЗ
			|	_СправедливыеЦеныАтлант КАК _СправедливыеЦеныАтлант
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _СправедливыеЦеныАтлант";
		Запрос.Выполнить();
		
	КонецЕсли; 
	
КонецПроцедуры 

// Помещает в МВТ таблицу стоимостей из регистра СтоимостьПереоценки 
Процедура ПолучитьСтоимостиИзРегистра(Запрос, Параметры, ИмяВТ)

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СтоимостьПереоценки.Рынок КАК Рынок,
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтоимостьПереоценки.Цена КАК Цена,
		|	СтоимостьПереоценки.Количество КАК Количество,
		|	СтоимостьПереоценки.Сумма КАК Сумма,
		|	СтоимостьПереоценки.ЦенаКупона КАК ЦенаКупона,
		|	ВЫБОР
		|		КОГДА СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.КонтрольИнвестиционнойДекларации)
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ СтоимостьПереоценки.ВидЦены
		|	КОНЕЦ КАК ВидЦены,
		|	СтоимостьПереоценки.КурсВалютыНоминала КАК КурсВалютыНоминала,
		|	ЛОЖЬ КАК ЦенаТМинус2
		|ПОМЕСТИТЬ _СправедливыеЦены_Все
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|ГДЕ
		|	СтоимостьПереоценки.Период = &ДатаФормированияСЧА
		|	И СтоимостьПереоценки.Организация = &Организация
		|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьПереоценки.ЦельРасчета В (ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении), ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.КонтрольИнвестиционнойДекларации))";
	
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "_СправедливыеЦены_Все", ИмяВТ);
	Запрос.Выполнить();

КонецПроцедуры 

Процедура ПолучитьСтоимостьДинамически(Запрос, Параметры, ПолучитьПоследнююСтоимость)

	Если Параметры.ВариантРасчетаОценочнойСтоимости	= Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом Тогда
		// эти стоимости рассчитать сами не можем - возьмем последние зарегистрированные
		ПолучитьПоследнююСтоимость = Истина;
	Иначе
		// пытаемся сформировать документ
		СтоимостьАктивов = ПолучитьТабличнуюЧастьРегистрацииСтоимостиПереоценки(Параметры, Параметры.ДатаФормированияСЧА, ПолучитьПоследнююСтоимость);
	КонецЕсли;
	
	Если ПолучитьПоследнююСтоимость Тогда
		// цена предоставлена клиентом, либо не удалось сформировать РСП
		Если Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом Тогда
		
			// получаем последние зарегистрированные стоимости
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЕСТЬNULL(МАКСИМУМ(СтоимостьПереоценкиСрезПоследних.Период), ДАТАВРЕМЯ(1, 1, 1)) КАК Период
				|ИЗ
				|	РегистрСведений.СтоимостьПереоценки.СрезПоследних(
				|			&ДатаФормированияСЧА,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И ЦельРасчета В (ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.КонтрольИнвестиционнойДекларации), ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении))) КАК СтоимостьПереоценкиСрезПоследних";
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Параметры.ДатаФормированияСЧА = Выборка.Период;
			КонецЕсли;
			
		Иначе
			
			// получим цены на предыдущий день регистрации СЧА
			Параметры.ДатаФормированияСЧА = РегистрыСведений.НастройкиФормированияСЧА.ПолучитьБлижайшуюДатуФормированияСЧА(
				Параметры.Организация, 
				Параметры.СчетДоверительногоУправления, 
				Параметры.ДатаФормированияСЧА - 3600*24);
		
		КонецЕсли; 
			
		Запрос.УстановитьПараметр("ДатаФормированияСЧА", Параметры.ДатаФормированияСЧА);
		
		// получаем последние зарегистрированные стоимости
		Если Параметры.КонтрольЗаПрошлыйПериод Тогда
			
			// пытаемся получить купоны из котировок
			Запрос.Текст =  
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	_ОстаткиЦенныхБумаг.Актив КАК Актив,
				|	ВЫБОР
				|		КОГДА Облигации.ВалютаНоминала = &ВалютаУчета
				|			ТОГДА 2
				|		ИНАЧЕ 4
				|	КОНЕЦ КАК ТочностьКупона,
				|	ЕСТЬNULL(ОценкиСтоимостиЦенныхБумагСрезПоследних.СтоимостьКупона, ЕСТЬNULL(КотировкиТорговыхПлощадок.ACCINT, НЕОПРЕДЕЛЕНО)) КАК Купон
				|ИЗ
				|	_Остатки КАК _ОстаткиЦенныхБумаг
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
				|		ПО _ОстаткиЦенныхБумаг.Актив = Облигации.Ссылка
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
				|		ПО (Облигации.Ссылка = КотировкиТорговыхПлощадок.ЦеннаяБумага)
				|			И (КотировкиТорговыхПлощадок.Период = &НачалоПериода)
				|			И (КотировкиТорговыхПлощадок.Биржа = &Биржа)
				|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
				|			И (Облигации.ВалютаНоминала = КотировкиТорговыхПлощадок.Валюта)
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОценкиСтоимостиЦенныхБумаг.СрезПоследних(
				|				&НачалоПериода,
				|				Организация = &Организация
				|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|					И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
				|					И ПовышенныйПриоритет) КАК ОценкиСтоимостиЦенныхБумагСрезПоследних
				|		ПО _ОстаткиЦенныхБумаг.Актив = ОценкиСтоимостиЦенныхБумагСрезПоследних.ЦеннаяБумага
				|			И (ОценкиСтоимостиЦенныхБумагСрезПоследних.ОценкаКупона)
				|			И (ОценкиСтоимостиЦенныхБумагСрезПоследних.ДатаОкончанияДействия >= &НачалоПериода)";
			Запрос.УстановитьПараметр("Биржа", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
			
			ТаблицаКупонов = Запрос.Выполнить().Выгрузить();
			НоваяТаблицаКупонов = ТаблицаКупонов.СкопироватьКолонки("Актив, Купон");
			
			Для каждого СтрокаОблигаций Из ТаблицаКупонов Цикл
				НайденныеСтроки = НоваяТаблицаКупонов.НайтиСтроки(Новый Структура("Актив", СтрокаОблигаций.Актив));
				Если НайденныеСтроки.Количество() > 1 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Внимание! По ценной бумаге %1 обнаружено несколько котировок купона по основным режимам торгов", СтрокаОблигаций.Актив));
				Иначе
					НоваяСтрока = НоваяТаблицаКупонов.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОблигаций);
					Если НоваяСтрока.Купон = Неопределено Тогда
						НоваяСтрока.Купон = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(НоваяСтрока.Актив, НачалоДня(Параметры.Период), Параметры.СчетДоверительногоУправления, , СтрокаОблигаций.ТочностьКупона);
					КонецЕсли; 	
				КонецЕсли;     				
			КонецЦикла;
			Запрос.УстановитьПараметр("ТаблицаКупонов", НоваяТаблицаКупонов);
			
		КонецЕсли;
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	СтоимостьПереоценки.Рынок КАК Рынок,
			|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СтоимостьПереоценки.Цена КАК Цена,
			|	СтоимостьПереоценки.Количество КАК Количество,
			|	СтоимостьПереоценки.Сумма КАК Сумма,
			|	NULL КАК ЦенаКупона,
			|	ВЫБОР
			|		КОГДА СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.КонтрольИнвестиционнойДекларации)
			|			ТОГДА НЕОПРЕДЕЛЕНО
			|		ИНАЧЕ СтоимостьПереоценки.ВидЦены
			|	КОНЕЦ КАК ВидЦены,
			|	СтоимостьПереоценки.КурсВалютыНоминала КАК КурсВалютыНоминала,
			|	ИСТИНА КАК ЦенаТМинус2
			|ПОМЕСТИТЬ _СправедливыеЦены_Все
			|ИЗ
			|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
			|ГДЕ
			|	СтоимостьПереоценки.Период = &ДатаФормированияСЧА
			|	И СтоимостьПереоценки.Организация = &Организация
			|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И СтоимостьПереоценки.ЦельРасчета В (ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении), ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.КонтрольИнвестиционнойДекларации))";
		
		Запрос.Выполнить();
		
	Иначе
		// документ РСП сформировали успешно, помещаем цены в ВТ
		Запрос.УстановитьПараметр("СтоимостьАктивов", СтоимостьАктивов);
		
		Запрос.Текст = 
		    "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		    |	СтоимостьПереоценки.Рынок КАК Рынок,
		    |	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		    |	СтоимостьПереоценки.Цена КАК Цена,
		    |	СтоимостьПереоценки.Количество КАК Количество,
		    |	СтоимостьПереоценки.Сумма КАК Сумма,
		    |	СтоимостьПереоценки.ЦенаКупона КАК ЦенаКупона,
		    |	ВЫБОР
		    |		КОГДА СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.КонтрольИнвестиционнойДекларации)
		    |			ТОГДА НЕОПРЕДЕЛЕНО
		    |		ИНАЧЕ СтоимостьПереоценки.ВидЦены
		    |	КОНЕЦ КАК ВидЦены,
			|	СтоимостьПереоценки.ВидЦены = ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.Погашена) КАК Погашена,
		    |	СтоимостьПереоценки.КурсВалютыНоминала КАК КурсВалютыНоминала,
		    |	СтоимостьПереоценки.ДопустимаНулеваяЦена КАК ДопустимаНулеваяЦена
		    |ПОМЕСТИТЬ _ПредварительныеЦены
		    |ИЗ
		    |	&СтоимостьАктивов КАК СтоимостьПереоценки
		    |
		    |ИНДЕКСИРОВАТЬ ПО
		    |	Рынок,
		    |	ЦеннаяБумага
		    |;
		    |
		    |////////////////////////////////////////////////////////////////////////////////
		    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		    |	СтоимостьПереоценки.Рынок КАК Рынок,
		    |	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		    |	ВЫБОР
		    |		КОГДА СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли)
		    |			ТОГДА СРЕДНЕЕ(СтоимостьПереоценки.Сумма)
		    |		ИНАЧЕ ВЫБОР
		    |				КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СтоимостьПереоценки.Цена) > 1
		    |					ТОГДА СУММА(СтоимостьПереоценки.Сумма) / СУММА(СтоимостьПереоценки.Количество)
		    |				ИНАЧЕ СРЕДНЕЕ(СтоимостьПереоценки.Цена)
		    |			КОНЕЦ
		    |	КОНЕЦ КАК Цена,
		    |	СУММА(СтоимостьПереоценки.Сумма) КАК Сумма,
		    |	ВЫБОР
			|		КОГДА СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.КонтрольИнвестиционнойДекларации)
			|			ТОГДА НЕОПРЕДЕЛЕНО
			|		ИНАЧЕ СтоимостьПереоценки.ВидЦены
			|	КОНЕЦ КАК ВидЦены,
			|	СтоимостьПереоценки.КурсВалютыНоминала КАК КурсВалютыНоминала
		    |ПОМЕСТИТЬ _СтоимостьПереоценкиТМинус2
		    |ИЗ
		    |	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		    |ГДЕ
		    |	СтоимостьПереоценки.Период = &ДатаФормированияТМинус2
		    |	И СтоимостьПереоценки.Организация = &Организация
		    |	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		    |	И СтоимостьПереоценки.ЦельРасчета В (ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении), ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.КонтрольИнвестиционнойДекларации))
		    |
		    |СГРУППИРОВАТЬ ПО
		    |	СтоимостьПереоценки.Рынок,
		    |	СтоимостьПереоценки.ЦеннаяБумага,
		    |	ВЫБОР
			|		КОГДА СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.КонтрольИнвестиционнойДекларации)
			|			ТОГДА НЕОПРЕДЕЛЕНО
			|		ИНАЧЕ СтоимостьПереоценки.ВидЦены
			|	КОНЕЦ,
			|	СтоимостьПереоценки.КурсВалютыНоминала
		    |
		    |ИНДЕКСИРОВАТЬ ПО
		    |	Рынок,
		    |	ЦеннаяБумага
		    |;
		    |
		    |////////////////////////////////////////////////////////////////////////////////
		    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		    |	_ПредварительныеЦены.Рынок КАК Рынок,
		    |	_ПредварительныеЦены.ЦеннаяБумага КАК ЦеннаяБумага,
		    |	ЕСТЬNULL(_СтоимостьПереоценкиТМинус2.Цена, _ПредварительныеЦены.Цена) КАК Цена,
		    |	_ПредварительныеЦены.Количество КАК Количество,
		    |	ЕСТЬNULL(_СтоимостьПереоценкиТМинус2.Сумма, _ПредварительныеЦены.Сумма) КАК Сумма,
		    |	_ПредварительныеЦены.ЦенаКупона КАК ЦенаКупона,
		    |	ЕСТЬNULL(_СтоимостьПереоценкиТМинус2.ВидЦены, _ПредварительныеЦены.ВидЦены) КАК ВидЦены,
		    |	ЕСТЬNULL(_СтоимостьПереоценкиТМинус2.КурсВалютыНоминала, _ПредварительныеЦены.КурсВалютыНоминала) КАК КурсВалютыНоминала,
		    |	НЕ _СтоимостьПереоценкиТМинус2.Сумма ЕСТЬ NULL КАК ЦенаТМинус2
		    |ПОМЕСТИТЬ _СправедливыеЦены_Все
		    |ИЗ
		    |	_ПредварительныеЦены КАК _ПредварительныеЦены
		    |		ЛЕВОЕ СОЕДИНЕНИЕ _СтоимостьПереоценкиТМинус2 КАК _СтоимостьПереоценкиТМинус2
		    |		ПО _ПредварительныеЦены.Рынок = _СтоимостьПереоценкиТМинус2.Рынок
		    |			И _ПредварительныеЦены.ЦеннаяБумага = _СтоимостьПереоценкиТМинус2.ЦеннаяБумага
		    |			И (_ПредварительныеЦены.Цена = 0)
		    |			И (НЕ _ПредварительныеЦены.ДопустимаНулеваяЦена)
		    |ГДЕ
		    |	(_ПредварительныеЦены.ДопустимаНулеваяЦена
		    |			ИЛИ ЕСТЬNULL(_СтоимостьПереоценкиТМинус2.Цена, _ПредварительныеЦены.Цена) > 0)";
		
		Запрос.УстановитьПараметр("ДатаФормированияТМинус2", РегистрыСведений.НастройкиФормированияСЧА.ПолучитьБлижайшуюДатуФормированияСЧА(
			Параметры.Организация, 
			Параметры.СчетДоверительногоУправления, 
			Параметры.ДатаФормированияСЧА - 3600*24));
		Запрос.Выполнить();
		
		Если Параметры.ДинамическийРасчетСтоимости Тогда
			
			ПолучитьСтоимостиИзРегистра(Запрос, Параметры, "_СтоимостиИзРегистра");
			// сравним полученные данные с данными регистра
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЕСТЬNULL(_СтоимостиИзРегистра.Рынок, _СправедливыеЦены_Все.Рынок) КАК Рынок,
				|	ЕСТЬNULL(_СтоимостиИзРегистра.ЦеннаяБумага, _СправедливыеЦены_Все.ЦеннаяБумага) КАК ЦеннаяБумага,
				|	_СтоимостиИзРегистра.Цена КАК ЦенаИзДокумента,
				|	_СтоимостиИзРегистра.ЦенаКупона КАК ЦенаКупонаИзДокумента,
				|	_СправедливыеЦены_Все.Цена КАК ЦенаРасчетная,
				|	_СправедливыеЦены_Все.ЦенаКупона КАК ЦенаКупонаРасчетная
				|ПОМЕСТИТЬ _РасхожденияСтоимостейЦенныхБумаг
				|ИЗ
				|	_СтоимостиИзРегистра КАК _СтоимостиИзРегистра
				|		ПОЛНОЕ СОЕДИНЕНИЕ _СправедливыеЦены_Все КАК _СправедливыеЦены_Все
				|		ПО _СтоимостиИзРегистра.Рынок = _СправедливыеЦены_Все.Рынок
				|			И _СтоимостиИзРегистра.ЦеннаяБумага = _СправедливыеЦены_Все.ЦеннаяБумага
				|ГДЕ
				|	(_СтоимостиИзРегистра.Цена <> _СправедливыеЦены_Все.Цена
				|			ИЛИ _СтоимостиИзРегистра.ЦенаКупона <> _СправедливыеЦены_Все.ЦенаКупона)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|УНИЧТОЖИТЬ _СтоимостиИзРегистра";
			
			Запрос.Выполнить();
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Получает цены по бумагам, поступившим между ДатойФормированияСЧА и Периодом контроля
Процедура ПолучитьЦеныПоследнихПоступлений(Запрос, Параметры)

	#Область ТекстЗапроса_ПоследниеПоступления
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОперацииСЦеннымиБумагами.Рынок КАК Рынок,
		|	ОперацииСЦеннымиБумагами.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОперацииСЦеннымиБумагами.Валюта КАК Валюта,
		|	ОперацииСЦеннымиБумагами.Цена КАК Цена,
		|	ОперацииСЦеннымиБумагами.ЦенаКупона КАК ЦенаКупона,
		|	ОперацииСЦеннымиБумагами.Регистратор КАК Регистратор,
		|	ВЫБОР
		|		КОГДА ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.ВводЦенныхБумаг
		|			ТОГДА ОперацииСЦеннымиБумагами.СтрокаПартии
		|		ИНАЧЕ ОперацииСЦеннымиБумагами.НомерСтроки
		|	КОНЕЦ КАК НомерСтроки,
		|	НАЧАЛОПЕРИОДА(ОперацииСЦеннымиБумагами.ДатаОперации, ДЕНЬ) КАК ДатаОперации
		|ПОМЕСТИТЬ _ОперацииСЦеннымиБумагами
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|ГДЕ
		|	ОперацииСЦеннымиБумагами.Организация = &Организация
		|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|	И ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаФормированияСЧА, ДЕНЬ, 1) И &Период
		|	И (ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.Сделка
		|			ИЛИ ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.СделкаРЕПО
		|			ИЛИ ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.ВводЦенныхБумаг)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОперацииСЦеннымиБумагами.Рынок КАК Рынок,
		|	_ОперацииСЦеннымиБумагами.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ОперацииСЦеннымиБумагами.Валюта КАК Валюта,
		|	ВЫБОР
		|		КОГДА ПоследниеЦены.ЦеннаяБумага ЕСТЬ NULL
		|			ТОГДА NULL
		|		ИНАЧЕ ПоследниеЦены.Цена
		|	КОНЕЦ КАК Цена,
		|	ВЫБОР
		|		КОГДА ПоследниеЦены.ЦеннаяБумага ЕСТЬ NULL
		|				ИЛИ &НачалоТекущегоДня <> &НачалоПериода
		|			ТОГДА NULL
		|		ИНАЧЕ ПоследниеЦены.ЦенаКупона
		|	КОНЕЦ КАК ЦенаКупона,
		|	ВЫБОР
		|		КОГДА &ВыполнятьРасчетПоУказаниюЦБ5419
		|			ТОГДА _ОперацииСЦеннымиБумагами.Регистратор
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК Партия,
		|	ВЫБОР
		|		КОГДА &ВыполнятьРасчетПоУказаниюЦБ5419
		|			ТОГДА _ОперацииСЦеннымиБумагами.НомерСтроки
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СтрокаПартии,
		|	ЕСТЬNULL(РаспределенияАктивовЕПС.УчетныйАктивЕПС В (&УчетныеАктивыОцениваемыеПоАС), Неопределено) КАК АктивыОцениваемыеПоАС
		|ПОМЕСТИТЬ _ПоследниеПоступления
		|ИЗ
		|	_ОперацииСЦеннымиБумагами КАК _ОперацииСЦеннымиБумагами
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОперацииСЦеннымиБумагами КАК ПоследниеЦены
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				ОперацииСЦеннымиБумагами.Рынок КАК Рынок,
		|				ОперацииСЦеннымиБумагами.ЦеннаяБумага КАК ЦеннаяБумага,
		|				МАКСИМУМ(ОперацииСЦеннымиБумагами.Регистратор) КАК Регистратор
		|			ИЗ
		|				_ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|			ГДЕ
		|				ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.Сделка
		|			
		|			СГРУППИРОВАТЬ ПО
		|				ОперацииСЦеннымиБумагами.Рынок,
		|				ОперацииСЦеннымиБумагами.ЦеннаяБумага) КАК ПоследниеПоступления
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределенияАктивовЕПС КАК РаспределенияАктивовЕПС
		|				ПО ПоследниеПоступления.Регистратор = РаспределенияАктивовЕПС.Регистратор
		|					И ПоследниеПоступления.Рынок = РаспределенияАктивовЕПС.Рынок
		|					И ПоследниеПоступления.ЦеннаяБумага = РаспределенияАктивовЕПС.ЦеннаяБумага
		|			ПО (ПоследниеПоступления.Регистратор = ПоследниеЦены.Регистратор)
		|				И (ПоследниеПоступления.Рынок = ПоследниеЦены.Рынок)
		|				И (ПоследниеПоступления.ЦеннаяБумага = ПоследниеЦены.ЦеннаяБумага)
		|		ПО (ПоследниеЦены.Рынок = _ОперацииСЦеннымиБумагами.Рынок)
		|			И (ПоследниеЦены.ЦеннаяБумага = _ОперацииСЦеннымиБумагами.ЦеннаяБумага)";		
	
	#КонецОбласти 
	
	Запрос.Выполнить();
	
	// проверяем все ли цены есть;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОстаткиЦенныхБумаг.Рынок КАК Рынок,
		|	_ОстаткиЦенныхБумаг.Актив КАК ЦеннаяБумага,
		|	_ОстаткиЦенныхБумаг.Количество КАК Количество,
		|	_ПоследниеПоступления.Партия КАК Партия,
		|	_ПоследниеПоступления.СтрокаПартии КАК СтрокаПартии,
		|	"""" КАК ТипЗадолженности,
		|	0 КАК СуммаРезервовПодОбесценение
		|ИЗ
		|	_ОстаткиЦенныхБумаг КАК _ОстаткиЦенныхБумаг
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумагиПретрейд КАК _ЦенныеБумагиПретрейд
		|		ПО _ОстаткиЦенныхБумаг.Актив = _ЦенныеБумагиПретрейд.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СправедливыеЦены_Врем КАК _СправедливыеЦены_Врем
		|		ПО _ОстаткиЦенныхБумаг.Актив = _СправедливыеЦены_Врем.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПоследниеПоступления КАК _ПоследниеПоступления
		|		ПО _ОстаткиЦенныхБумаг.Актив = _ПоследниеПоступления.ЦеннаяБумага
		|ГДЕ
		|	_СправедливыеЦены_Врем.ЦеннаяБумага ЕСТЬ NULL
		|	И _ЦенныеБумагиПретрейд.ЦеннаяБумага ЕСТЬ NULL
		|	И _ПоследниеПоступления.Цена ЕСТЬ NULL";
	
	Результат = Запрос.Выполнить();
	СтоимостьАктивов = Неопределено;
	Если Не Результат.Пустой() Тогда
		// формируем цены, которых нет
		Отказ = Ложь;
		ЦенныеБумагиБезСтоимости = Результат.Выгрузить();
		СтоимостьАктивов = ПолучитьТабличнуюЧастьРегистрацииСтоимостиПереоценки(Параметры, Параметры.ДатаФормированияСЧА, Отказ, ЦенныеБумагиБезСтоимости);
		Если Отказ Тогда
			Параметры.Вставить("ЦенныеБумагиБезСтоимости", ЦенныеБумагиБезСтоимости);
		КонецЕсли; 
	КонецЕсли; 
	
	Если СтоимостьАктивов = Неопределено Тогда
	
		СтоимостьАктивов = Новый ТаблицаЗначений;
		СтоимостьАктивов.Колонки.Добавить("Рынок", 				Новый ОписаниеТипов("ПеречислениеСсылка.РынкиЦенныхБумаг"));
		СтоимостьАктивов.Колонки.Добавить("ЦеннаяБумага", 		Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
		СтоимостьАктивов.Колонки.Добавить("Цена", 				Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
		СтоимостьАктивов.Колонки.Добавить("ЦенаКупона", 		Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
		СтоимостьАктивов.Колонки.Добавить("ВидЦены", 			Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
		СтоимостьАктивов.Колонки.Добавить("КурсВалютыНоминала", Метаданные.ОпределяемыеТипы.КурсВалюты.Тип);
		
	КонецЕсли; 
	
	// объединяем цены поступлений со справедливыми
	Запрос.УстановитьПараметр("СтоимостьАктивов", СтоимостьАктивов);
	#Область ТекстЗапроса_СправедливыеЦены
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ПоследниеПоступления.Рынок КАК Рынок,
		|	_ПоследниеПоступления.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ПоследниеПоступления.АктивыОцениваемыеПоАС КАК АктивыОцениваемыеПоАС,
		|	ЛОЖЬ КАК Погашена,
		|	_ПоследниеПоступления.Валюта КАК Валюта,
		|	_ПоследниеПоступления.Цена КАК Цена,
		|	_ПоследниеПоступления.ЦенаКупона КАК ЦенаКупона,
		|	ЛОЖЬ КАК ЦенаТМинус2
		|ПОМЕСТИТЬ _ЦеныПоступлений
		|ИЗ
		|	_ПоследниеПоступления КАК _ПоследниеПоступления
		|ГДЕ
		|	_ПоследниеПоступления.Цена ЕСТЬ НЕ NULL 
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СтоимостьАктивов.Рынок КАК Рынок,
		|	СтоимостьАктивов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтоимостьАктивов.ВидЦены КАК ВидЦены,
		|	СтоимостьАктивов.Цена КАК Цена,
		|	СтоимостьАктивов.ЦенаКупона КАК ЦенаКупона,
		|	СтоимостьАктивов.КурсВалютыНоминала КАК КурсВалютыНоминала
		|ПОМЕСТИТЬ _СтоимостьАктивов
		|ИЗ
		|	&СтоимостьАктивов КАК СтоимостьАктивов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СтоимостьАктивов.Рынок КАК Рынок,
		|	_СтоимостьАктивов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_СтоимостьАктивов.ВидЦены = ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.АмортизированнаяСтоимость) КАК АктивыОцениваемыеПоАС,
		|	_СтоимостьАктивов.ВидЦены = ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.Погашена) КАК Погашена,
		|	_СтоимостьАктивов.Цена КАК Цена,
		|	_СтоимостьАктивов.ЦенаКупона КАК ЦенаКупона,
		|	_СтоимостьАктивов.КурсВалютыНоминала КАК КурсВалютыНоминала,
		|	ЛОЖЬ КАК ЦенаТМинус2
		|ПОМЕСТИТЬ _СправедливыеЦены_Врем2
		|ИЗ
		|	_СтоимостьАктивов КАК _СтоимостьАктивов
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_СправедливыеЦены_Врем.Рынок,
		|	_СправедливыеЦены_Врем.ЦеннаяБумага,
		|	_СправедливыеЦены_Врем.АктивыОцениваемыеПоАС,
		|	_СправедливыеЦены_Врем.Погашена,
		|	_СправедливыеЦены_Врем.Цена,
		|	_СправедливыеЦены_Врем.ЦенаКупона,
		|	0,
		|	_СправедливыеЦены_Врем.ЦенаТМинус2
		|ИЗ
		|	_СправедливыеЦены_Врем КАК _СправедливыеЦены_Врем
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦеныПоступлений.Рынок КАК Рынок,
		|	_ЦеныПоступлений.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ЦеныПоступлений.Цена КАК ЦенаПриобретения,
		|	ЕСТЬNULL(_СправедливыеЦены_Врем2.Цена, 0) КАК СправедливаяЦена,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_СправедливыеЦены_Врем2.Цена, 0) = 0
		|			ТОГДА 100
		|		ИНАЧЕ ВЫБОР
		|				КОГДА _ЦеныПоступлений.Цена < _СправедливыеЦены_Врем2.Цена
		|					ТОГДА 100
		|				ИНАЧЕ -100
		|			КОНЕЦ * (1 - _ЦеныПоступлений.Цена / _СправедливыеЦены_Врем2.Цена)
		|	КОНЕЦ КАК Отклонение
		|ПОМЕСТИТЬ _ТаблицаРасхожденийЦен
		|ИЗ
		|	_ЦеныПоступлений КАК _ЦеныПоступлений
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СправедливыеЦены_Врем2 КАК _СправедливыеЦены_Врем2
		|		ПО (_СправедливыеЦены_Врем2.Рынок = _ЦеныПоступлений.Рынок)
		|			И (_СправедливыеЦены_Врем2.ЦеннаяБумага = _ЦеныПоступлений.ЦеннаяБумага)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_ЦеныПоступлений.Рынок, _СправедливыеЦены_Врем2.Рынок) КАК Рынок,
		|	ЕСТЬNULL(_ЦеныПоступлений.ЦеннаяБумага, _СправедливыеЦены_Врем2.ЦеннаяБумага) КАК ЦеннаяБумага,
		|	ЕСТЬNULL(_ЦеныПоступлений.АктивыОцениваемыеПоАС, _СправедливыеЦены_Врем2.АктивыОцениваемыеПоАС) КАК АктивыОцениваемыеПоАС,
		|	ЕСТЬNULL(_ЦеныПоступлений.Погашена, _СправедливыеЦены_Врем2.Погашена) КАК Погашена,
		|	ЕСТЬNULL(_ЦеныПоступлений.Цена, _СправедливыеЦены_Врем2.Цена) КАК Цена,
		|	_ЦеныПоступлений.ЦенаКупона КАК ЦенаКупона,
		|	_ЦеныПоступлений.Валюта КАК Валюта,
		|	ЕСТЬNULL(_СправедливыеЦены_Врем2.КурсВалютыНоминала, 0) КАК КурсВалютыНоминала,
		|	ЕСТЬNULL(_ЦеныПоступлений.ЦенаТМинус2, _СправедливыеЦены_Врем2.ЦенаТМинус2) КАК ЦенаТМинус2
		|ПОМЕСТИТЬ _СправедливыеЦены
		|ИЗ
		|	_СправедливыеЦены_Врем2 КАК _СправедливыеЦены_Врем2
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ЦеныПоступлений КАК _ЦеныПоступлений
		|		ПО _СправедливыеЦены_Врем2.Рынок = _ЦеныПоступлений.Рынок
		|			И _СправедливыеЦены_Врем2.ЦеннаяБумага = _ЦеныПоступлений.ЦеннаяБумага";
	#КонецОбласти 
	
	Запрос.Выполнить();
	
	// уничтожаем отдельно для обеспечения возможности отладки
	Запрос.Текст = 
		"УНИЧТОЖИТЬ _СправедливыеЦены_Врем
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _СправедливыеЦены_Врем2
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _СтоимостьАктивов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ЦеныПоступлений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ПоследниеПоступления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ОперацииСЦеннымиБумагами";

КонецПроцедуры

Функция ПолучитьТабличнуюЧастьРегистрацииСтоимостиПереоценки(Параметры, Период, Отказ, ТаблицаЦенныхБумаг = Неопределено)
	
	Если Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом Тогда
		
		Если ТаблицаЦенныхБумаг = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Вариант расчета справедливой стоимости '" + Параметры.ВариантРасчетаОценочнойСтоимости + "' не реализован.",,,, Отказ);
			Возврат Неопределено;
		КонецЕсли; 
		
		// #329034 пока методики по САФМАРу нет - вот такой костыль 
		ПараметрыРасчета = Новый Структура("Организация, СчетДоверительногоУправления");
		ЗаполнитьЗначенияСвойств(ПараметрыРасчета, Параметры);
		ПараметрыРасчета.Вставить("ВариантРасчетаОценочнойСтоимости", Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная2ПоследняяЗа90КалендарныхДней);
		ПараметрыРасчета.Вставить("Дата", Параметры.Период);
		
		ТаблицаКотировок = РаботаСПереоценкой.ПолучитьКотировки(ТаблицаЦенныхБумаг, ПараметрыРасчета, Неопределено, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
		ТаблицаКотировок.Колонки.Добавить("ВидЦены", Новый ОписаниеТипов("ПеречислениеСсылка.ИсточникиЦеныДляПереоценки"));
		ТаблицаКотировок.Колонки.Добавить("Партия", Метаданные.ОпределяемыеТипы.Партия.Тип);
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТаблицаЦенныхБумаг.Рынок КАК Рынок,
			|	ТаблицаЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ТаблицаЦенныхБумаг.Количество КАК Количество
			|ПОМЕСТИТЬ _ТаблицаЦенныхБумаг
			|ИЗ
			|	&ТаблицаЦенныхБумаг КАК ТаблицаЦенныхБумаг
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТаблицаКотировок.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ТаблицаКотировок.РыночнаяЦена КАК Цена,
			|	ТаблицаКотировок.ДатаКотировки КАК ДатаЦены,
			|	ТаблицаКотировок.ВидЦены КАК ВидЦены,
			|	ТаблицаКотировок.Партия КАК Партия
			|ПОМЕСТИТЬ _ТаблицаКотировок
			|ИЗ
			|	&ТаблицаКотировок КАК ТаблицаКотировок
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ТаблицаЦенныхБумаг.Рынок КАК Рынок,
			|	_ТаблицаЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_ТаблицаЦенныхБумаг.Количество КАК Количество,
			|	ЕСТЬNULL(_ТаблицаКотировок.Цена, 0) КАК Цена,
			|	ЕСТЬNULL(_ТаблицаКотировок.Цена, 0) * _ТаблицаЦенныхБумаг.Количество КАК Сумма,
			|	ЕСТЬNULL(_ТаблицаКотировок.ВидЦены, НЕОПРЕДЕЛЕНО) КАК ВидЦены,
			|	_ТаблицаКотировок.ДатаЦены КАК ДатаЦены,
			|	0 КАК КурсВалютыНоминала,
			|	0 КАК ЦенаКупона
			|ИЗ
			|	_ТаблицаЦенныхБумаг КАК _ТаблицаЦенныхБумаг
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаКотировок КАК _ТаблицаКотировок
			|		ПО _ТаблицаЦенныхБумаг.ЦеннаяБумага = _ТаблицаКотировок.ЦеннаяБумага";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("ТаблицаЦенныхБумаг", ТаблицаЦенныхБумаг);
		Запрос.УстановитьПараметр("ТаблицаКотировок", ТаблицаКотировок);
		
		СтоимостиПереоценки = Запрос.Выполнить().Выгрузить();
		
		Параметры.Вставить("ТаблицаОшибокСафмар", СтоимостиПереоценки.Скопировать(, "Рынок, ЦеннаяБумага, Цена, ДатаЦены"));
		
	Иначе
		
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("Организация",						Параметры.Организация);
		ПараметрыРасчета.Вставить("СчетДоверительногоУправления",		Параметры.СчетДоверительногоУправления);
		ПараметрыРасчета.Вставить("ВидУчета", 							Параметры.ВидУчета);
		ПараметрыРасчета.Вставить("ЦельРасчета",						Параметры.ЦельРасчета);
		ПараметрыРасчета.Вставить("Дата",								КонецДня(Период));
		
		Если ТаблицаЦенныхБумаг <> Неопределено Тогда
			
			ТаблицаЦенныхБумаг.Колонки.Добавить("УчетныйАктивЕПС", Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
			Для каждого СтрокаТаблицы Из ТаблицаЦенныхБумаг Цикл
				СтрокаТаблицы.УчетныйАктивЕПС = БухгалтерскийУчет.ОпределитьУчетныйАктивЕПС(Период, СтрокаТаблицы.Рынок, СтрокаТаблицы.ЦеннаяБумага);
			КонецЦикла; 
		
		КонецЕсли; 
		
		УстановитьПривилегированныйРежим(Истина);	
		
		// Получаем стоимость ЦБ
		ПереоценкаЦБ = Документы.РегистрацияСтоимостиПереоценки.СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(ПереоценкаЦБ, ПараметрыРасчета);
		
		СтоимостиПереоценки = ПереоценкаЦБ.СтоимостиПереоценки.ВыгрузитьКолонки("Рынок, ЦеннаяБумага, Цена, ЦенаКупона, ВидЦены, КурсВалютыНоминала, Количество, Сумма");
		СтоимостиПереоценки.Колонки.Добавить("ЦельРасчета", Новый ОписаниеТипов("СправочникСсылка.ЦелиРасчета"));
			
		Если ТаблицаЦенныхБумаг = Неопределено Тогда
			
			ТаблицыДокумента = ПереоценкаЦБ.ПолучитьСтоимостиПереоценкиДляОценкиОбъектовВУправлении(Неопределено, Отказ, Параметры.РасчетПартий);
			
			Если НачалоДня(Параметры.ДатаФормированияСЧА) <> НачалоДня(Параметры.Период) Тогда
				Параметры.РасчетПартий = Неопределено;
			КонецЕсли; 
		
			Если Не Отказ Тогда
				
				Если ТаблицыДокумента.СтоимостиПереоценки <> Неопределено Тогда
					ТаблицыДокумента.СтоимостиПереоценки.Колонки.Добавить("ЦельРасчета", Новый ОписаниеТипов("СправочникСсылка.ЦелиРасчета"));
					ТаблицыДокумента.СтоимостиПереоценки.ЗаполнитьЗначения(Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении, "ЦельРасчета");
					РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ТаблицыДокумента.СтоимостиПереоценки, СтоимостиПереоценки);
				КонецЕсли; 
				
				Если ТаблицыДокумента.СтоимостиПрочихЦенныхБумаг <> Неопределено Тогда
					ТаблицыДокумента.СтоимостиПрочихЦенныхБумаг.Колонки.Добавить("ЦельРасчета", Новый ОписаниеТипов("СправочникСсылка.ЦелиРасчета"));
					ТаблицыДокумента.СтоимостиПрочихЦенныхБумаг.ЗаполнитьЗначения(Справочники.ЦелиРасчета.КонтрольИнвестиционнойДекларации, "ЦельРасчета");
					РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ТаблицыДокумента.СтоимостиПрочихЦенныхБумаг, СтоимостиПереоценки);
				КонецЕсли;
				
			КонецЕсли;
					
		Иначе
			ПереоценкаЦБ.ЗаполнитьСтоимостьПереоценки(Истина, Ложь, Отказ,, Ложь,, ТаблицаЦенныхБумаг, Истина, Параметры.РасчетПартий);
			РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ПереоценкаЦБ.СтоимостиПереоценки.Выгрузить(), СтоимостиПереоценки);
		КонецЕсли;

	КонецЕсли;
	
	#Область Удаление_нулевых_цен
	
	СтоимостиПереоценки.Колонки.Добавить("ДопустимаНулеваяЦена", Новый ОписаниеТипов("Булево"));
	СтоимостиПереоценки.ЗаполнитьЗначения(Истина, "ДопустимаНулеваяЦена");
	
	СтрокиСНулевойЦеной = СтоимостиПереоценки.НайтиСтроки(Новый Структура("Цена", 0));
		
	Для Каждого СтрокаСНулевойЦеной Из СтрокиСНулевойЦеной Цикл
		
		Если Не Документы.РегистрацияСтоимостиПереоценки.ДопустимаНулеваяЦена(СтрокаСНулевойЦеной) Тогда
			
			Если ТаблицаЦенныхБумаг = Неопределено Тогда
				СтрокаСНулевойЦеной.ДопустимаНулеваяЦена = Ложь;
			Иначе
				СтоимостиПереоценки.Удалить(СтрокаСНулевойЦеной);
			КонецЕсли;
			
		КонецЕсли;
					
	КонецЦикла;
	
	#КонецОбласти 
	
	Если Не Отказ Тогда
		Возврат СтоимостиПереоценки;
	КонецЕсли;
	
КонецФункции

// Заменяет амортизированные стоимости средними значениями
Процедура ОбработатьСтоимостиПоПартиям(Запрос)

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СправедливыеЦены_Все.Рынок КАК Рынок,
		|	_СправедливыеЦены_Все.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА _СправедливыеЦены_Все.ВидЦены = НЕОПРЕДЕЛЕНО
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ _СправедливыеЦены_Все.ВидЦены = ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.АмортизированнаяСтоимость)
		|	КОНЕЦ КАК АктивыОцениваемыеПоАС,
		|	ВЫБОР
		|		КОГДА _СправедливыеЦены_Все.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли)
		|			ТОГДА СРЕДНЕЕ(_СправедливыеЦены_Все.Сумма)
		|		ИНАЧЕ ВЫБОР
		|				КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _СправедливыеЦены_Все.Цена) > 1
		|					ТОГДА СУММА(_СправедливыеЦены_Все.Сумма) / СУММА(_СправедливыеЦены_Все.Количество)
		|				ИНАЧЕ СРЕДНЕЕ(_СправедливыеЦены_Все.Цена)
		|			КОНЕЦ
		|	КОНЕЦ КАК Цена,
		|	_СправедливыеЦены_Все.ВидЦены = ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.Погашена) КАК Погашена,
		|	_СправедливыеЦены_Все.ЦенаКупона КАК ЦенаКупона,
		|	_СправедливыеЦены_Все.КурсВалютыНоминала КАК КурсВалютыНоминала,
		|	_СправедливыеЦены_Все.ЦенаТМинус2 КАК ЦенаТМинус2
		|ПОМЕСТИТЬ _СправедливыеЦены_Врем
		|ИЗ
		|	_СправедливыеЦены_Все КАК _СправедливыеЦены_Все
		|
		|СГРУППИРОВАТЬ ПО
		|	_СправедливыеЦены_Все.ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА _СправедливыеЦены_Все.ВидЦены = НЕОПРЕДЕЛЕНО
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ _СправедливыеЦены_Все.ВидЦены = ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.АмортизированнаяСтоимость)
		|	КОНЕЦ,
		|	_СправедливыеЦены_Все.ВидЦены = ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.Погашена),
		|	_СправедливыеЦены_Все.Рынок,
		|	_СправедливыеЦены_Все.КурсВалютыНоминала,
		|	_СправедливыеЦены_Все.ЦенаКупона,
		|	_СправедливыеЦены_Все.ЦенаТМинус2";
		
	Запрос.Выполнить();
		
КонецПроцедуры 

#КонецОбласти 

#Область Контроль_чувствительности

Процедура СформироватьВременныеТаблицыДляКонтроляЧувствительности(НаборДанных, Параметры, Запрос)
	
	Если НаборДанных = "Основной" Тогда
		
		Запрос.УстановитьПараметр("КонтролироватьЧувствительность", Параметры.КонтролироватьЧувствительность);
		Запрос.УстановитьПараметр("ПоказателиЧувствительности", ПолучитьТаблицуПоказателейЧувствительности()); 
		Запрос.УстановитьПараметр("ОблигацииНеДляПродажи", ПолучитьОблигацииНеДляПродажи(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.СчетДоверительногоУправления, "КодСчета")));
		
		#Область ТекстЗапроса
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ТаблицаЦенныхБумаг.Актив КАК Актив,
			|	МИНИМУМ(ЕСТЬNULL(УсловияОферт.ДатаВыкупа, Облигации.ДатаПогашения)) КАК ДатаВыкупа,
			|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал
			|ПОМЕСТИТЬ _ДатыВыкупаИНоминалы
			|ИЗ
			|	_ТаблицаЦенныхБумаг КАК _ТаблицаЦенныхБумаг
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
			|		ПО (&КонтролироватьЧувствительность)
			|			И _ТаблицаЦенныхБумаг.Актив = Облигации.Ссылка
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияОферт КАК УсловияОферт
			|		ПО _ТаблицаЦенныхБумаг.Актив = УсловияОферт.Облигация
			|			И (НЕ УсловияОферт.ТолькоДляФизическихЛиц)
			|			И (УсловияОферт.ТипОферты В(&АнализируемыеТипыОферт))
			|			И (УсловияОферт.ДатаВыкупа > &Период)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&Период, ) КАК НоминалыЦенныхБумагСрезПоследних
			|		ПО _ТаблицаЦенныхБумаг.Актив = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
			|
			|СГРУППИРОВАТЬ ПО
			|	_ТаблицаЦенныхБумаг.Актив,
			|	НоминалыЦенныхБумагСрезПоследних.Номинал
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ТаблицаЦенныхБумаг.Актив КАК Актив,
			|	_ДатыВыкупаИНоминалы.ДатаВыкупа КАК ДатаВыкупа,
			|	_ДатыВыкупаИНоминалы.Номинал КАК Номинал,
			|	Облигации.Амортизационная КАК Амортизационная,
			|	Облигации.БазоваяСтавка <> ЗНАЧЕНИЕ(Справочник.БазовыеСтавкиОблигаций.ПустаяСсылка) КАК ПлавающаяСтавка,
			|	Облигации.БазоваяСтавка.ВариантПеременныхВФормуле КАК ВариантПеременныхВФормуле,
			|	_ТаблицаЦенныхБумаг.СуммаКупона КАК СуммаКупона,
			|	_ТаблицаЦенныхБумаг.СуммаБезНКД КАК СуммаБезНКД
			|ПОМЕСТИТЬ _ОстаткиОблигаций
			|ИЗ
			|	_ТаблицаЦенныхБумаг КАК _ТаблицаЦенныхБумаг
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДатыВыкупаИНоминалы КАК _ДатыВыкупаИНоминалы
			|		ПО (&КонтролироватьЧувствительность)
			|			И _ТаблицаЦенныхБумаг.Актив = _ДатыВыкупаИНоминалы.Актив
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
			|		ПО _ТаблицаЦенныхБумаг.Актив = Облигации.Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НоминалыЦенныхБумаг.ЦеннаяБумага КАК Актив,
			|	НоминалыЦенныхБумаг.Период КАК ДатаНоминальнойВыплаты,
			|	НоминалыЦенныхБумаг.СуммаИзменения КАК СуммаНоминальнойСтоимости,
			|	_ОстаткиОблигаций.Номинал КАК Номинал
			|ПОМЕСТИТЬ _ТаблицаВыплат
			|ИЗ
			|	_ОстаткиОблигаций КАК _ОстаткиОблигаций
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
			|		ПО _ОстаткиОблигаций.Актив = НоминалыЦенныхБумаг.ЦеннаяБумага
			|			И _ОстаткиОблигаций.ДатаВыкупа >= НоминалыЦенныхБумаг.Период
			|			И (_ОстаткиОблигаций.Амортизационная)
			|			И (НоминалыЦенныхБумаг.Период > &Период)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ВложенныйЗапрос.ЦеннаяБумага,
			|	ВложенныйЗапрос.ДатаВыкупа,
			|	НоминалыЦенныхБумаг.Номинал,
			|	ВложенныйЗапрос.Номинал
			|ИЗ
			|	РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			НоминалыЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
			|			МАКСИМУМ(НоминалыЦенныхБумаг.Период) КАК Период,
			|			_ОстаткиОблигаций.ДатаВыкупа КАК ДатаВыкупа,
			|			_ОстаткиОблигаций.Номинал КАК Номинал
			|		ИЗ
			|			_ОстаткиОблигаций КАК _ОстаткиОблигаций
			|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
			|				ПО _ОстаткиОблигаций.Актив = НоминалыЦенныхБумаг.ЦеннаяБумага
			|					И _ОстаткиОблигаций.ДатаВыкупа >= НоминалыЦенныхБумаг.Период
			|					И (_ОстаткиОблигаций.Амортизационная)
			|		
			|		СГРУППИРОВАТЬ ПО
			|			НоминалыЦенныхБумаг.ЦеннаяБумага,
			|			_ОстаткиОблигаций.ДатаВыкупа,
			|			_ОстаткиОблигаций.Номинал) КАК ВложенныйЗапрос
			|		ПО НоминалыЦенныхБумаг.ЦеннаяБумага = ВложенныйЗапрос.ЦеннаяБумага
			|			И НоминалыЦенныхБумаг.Период = ВложенныйЗапрос.Период
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ТаблицаВыплат.Актив КАК Актив,
			|	1 / 365 * СУММА(РАЗНОСТЬДАТ(&НачалоПериода, _ТаблицаВыплат.ДатаНоминальнойВыплаты, ДЕНЬ) * _ТаблицаВыплат.СуммаНоминальнойСтоимости / _ТаблицаВыплат.Номинал) КАК СредневзвешенныйСрок
			|ПОМЕСТИТЬ _СредневзвешенныйСрокВыплатыНоминала
			|ИЗ
			|	_ТаблицаВыплат КАК _ТаблицаВыплат
			|
			|СГРУППИРОВАТЬ ПО
			|	_ТаблицаВыплат.Актив
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ОстаткиОблигаций.Актив КАК Актив,
			|	ВЫБОР
			|		КОГДА _ОстаткиОблигаций.Амортизационная
			|			ТОГДА _СредневзвешенныйСрокВыплатыНоминала.СредневзвешенныйСрок
			|		КОГДА _ОстаткиОблигаций.ВариантПеременныхВФормуле = ЗНАЧЕНИЕ(Перечисление.ВариантыПеременныхВФормулеБазовыхСтавокОблигаций.СодержитПеременныеТолькоПроцентнуюСтавкуИлиУровеньИнфляции)
			|			ТОГДА КупонныйДоходПоОблигациямСрезПоследних.Срок / 365
			|		КОГДА _ОстаткиОблигаций.ВариантПеременныхВФормуле = ЗНАЧЕНИЕ(Перечисление.ВариантыПеременныхВФормулеБазовыхСтавокОблигаций.СодержитПеременные)
			|				ИЛИ _ОстаткиОблигаций.ВариантПеременныхВФормуле = ЗНАЧЕНИЕ(Перечисление.ВариантыПеременныхВФормулеБазовыхСтавокОблигаций.НеСодержитПеременных)
			|			ТОГДА 0
			|		ИНАЧЕ РАЗНОСТЬДАТ(&Период, _ОстаткиОблигаций.ДатаВыкупа, ДЕНЬ) / 365
			|	КОНЕЦ КАК ПериодДоПогашения,
			|	_ОстаткиОблигаций.ПлавающаяСтавка КАК ПлавающаяСтавка,
			|	_ОстаткиОблигаций.ДатаВыкупа КАК ДатаВыкупа,
			|	_ОстаткиОблигаций.СуммаКупона КАК СуммаКупона,
			|	_ОстаткиОблигаций.СуммаБезНКД КАК СуммаБезНКД
			|ПОМЕСТИТЬ _ПериодыДоПогашения
			|ИЗ
			|	_ОстаткиОблигаций КАК _ОстаткиОблигаций
			|		ЛЕВОЕ СОЕДИНЕНИЕ _СредневзвешенныйСрокВыплатыНоминала КАК _СредневзвешенныйСрокВыплатыНоминала
			|		ПО _ОстаткиОблигаций.Актив = _СредневзвешенныйСрокВыплатыНоминала.Актив
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям.СрезПоследних(&Период, ) КАК КупонныйДоходПоОблигациямСрезПоследних
			|		ПО _ОстаткиОблигаций.Актив = КупонныйДоходПоОблигациямСрезПоследних.Облигация
			|			И (_ОстаткиОблигаций.ПлавающаяСтавка)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПоказателиЧувствительности.ПериодОт КАК ПериодОт,
			|	ПоказателиЧувствительности.ПериодДо КАК ПериодДо,
			|	ПоказателиЧувствительности.Показатель КАК Показатель
			|ПОМЕСТИТЬ _ПоказателиЧувствительности
			|ИЗ
			|	&ПоказателиЧувствительности КАК ПоказателиЧувствительности
			|ГДЕ
			|	&КонтролироватьЧувствительность
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ПериодыДоПогашения.Актив КАК Актив,
			|	МАКСИМУМ(_ПериодыДоПогашения.ПериодДоПогашения) КАК КонтрольЧувствительности_ПериодДоПогашения,
			|	СУММА(ВЫБОР
			|			КОГДА _ПериодыДоПогашения.Актив В (&ОблигацииНеДляПродажи)
			|				ТОГДА 0
			|			ИНАЧЕ _ПоказателиЧувствительности.Показатель
			|		КОНЕЦ * (_ПериодыДоПогашения.СуммаБезНКД + _ПериодыДоПогашения.СуммаКупона)) КАК КонтрольЧувствительности_Показатель,
			|	_ПериодыДоПогашения.ПлавающаяСтавка КАК КонтрольЧувствительности_ПлавающаяСтавка,
			|	_ПериодыДоПогашения.ДатаВыкупа КАК КонтрольЧувствительности_ДатаВыкупа,
			|	_ПоказателиЧувствительности.Показатель КАК КонтрольЧувствительности_ПоказательSj
			|ПОМЕСТИТЬ _КонтрольЧувствительности
			|ИЗ
			|	_ПериодыДоПогашения КАК _ПериодыДоПогашения
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ПоказателиЧувствительности КАК _ПоказателиЧувствительности
			|		ПО _ПериодыДоПогашения.ПериодДоПогашения > _ПоказателиЧувствительности.ПериодОт
			|			И _ПериодыДоПогашения.ПериодДоПогашения <= _ПоказателиЧувствительности.ПериодДо
			|
			|СГРУППИРОВАТЬ ПО
			|	_ПериодыДоПогашения.Актив,
			|	_ПериодыДоПогашения.ПлавающаяСтавка,
			|	_ПериодыДоПогашения.ДатаВыкупа,
			|	_ПоказателиЧувствительности.Показатель";			
		#КонецОбласти 
		Запрос.Выполнить();
		
		Запрос.Текст = 
			"УНИЧТОЖИТЬ _ДатыВыкупаИНоминалы
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ОстаткиОблигаций
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ТаблицаВыплат
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _СредневзвешенныйСрокВыплатыНоминала
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ПериодыДоПогашения
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ПоказателиЧувствительности";
		Запрос.Выполнить();
		
	КонецЕсли;
		        
КонецПроцедуры

Функция ПолучитьТаблицуПоказателейЧувствительности()

	ТаблицаПоказателей = Новый ТаблицаЗначений;
	ТаблицаПоказателей.Колонки.Добавить("ПериодОт", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(2, 1, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаПоказателей.Колонки.Добавить("ПериодДо", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(2, 1, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаПоказателей.Колонки.Добавить("Показатель",	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(4, 2, ДопустимыйЗнак.Неотрицательный)));
	
	ТабДок = ПолучитьМакет("ПоказателиЧувствительности");
	ВсегоСтрок = ТабДок.ВысотаТаблицы;
	
	Для НомСтр = 2 По ВсегоСтрок Цикл
		
		НоваяСтрока = ТаблицаПоказателей.Добавить();
		НоваяСтрока.ПериодОт 	= ТабДок.Область(НомСтр, 1, НомСтр, 1).Текст;
		НоваяСтрока.ПериодДо 	= ТабДок.Область(НомСтр, 2, НомСтр, 2).Текст;
		НоваяСтрока.Показатель	= ТабДок.Область(НомСтр, 3, НомСтр, 3).Текст;
		
	КонецЦикла;
	
	Возврат ТаблицаПоказателей;

КонецФункции

Функция ПолучитьОблигацииНеДляПродажи(КодСчетаДУ)

	ОблигацииНеДляПродажи = Новый Массив;
		
	ТабДок = ПолучитьМакет("ОблигацииНеДляПродажи");
	ВсегоСтрок = ТабДок.ВысотаТаблицы;
	
	Для НомСтр = 2 По ВсегоСтрок Цикл
		
		Если СокрЛП(ТабДок.Область(НомСтр, 1, НомСтр, 1).Текст) = КодСчетаДУ Тогда
			
			РегНомер = СокрЛП(ТабДок.Область(НомСтр, 2, НомСтр, 2).Текст);
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	Облигации.Ссылка
				|ИЗ
				|	Справочник.Облигации КАК Облигации
				|ГДЕ
				|	Облигации.ГосударственныйРегистрационныйНомер = &РегНомер";
			
			Запрос.УстановитьПараметр("РегНомер", РегНомер);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				ОблигацииНеДляПродажи.Добавить(Выборка.Ссылка);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось найти облигацию с рег. номером '" + РегНомер + "' при получении списка облигаций не для продажи");
			КонецЕсли;		
		
		КонецЕсли; 
		
	КонецЦикла;
	
	Возврат ОблигацииНеДляПродажи;

КонецФункции
     
Функция ПолучитьКоэффициентПоказателяЧувствительности(СчетДоверительногоУправления, Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияДоговоровДоверительногоУправленияСрезПоследних.КоэффициентЧувствительности КАК ЗначениеПоказателя
		|ИЗ
		|	РегистрСведений.УсловияДоговоровДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК УсловияДоговоровДоверительногоУправленияСрезПоследних
		|ГДЕ
		|	УсловияДоговоровДоверительногоУправленияСрезПоследних.КоэффициентЧувствительности <> 0";
	
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЗначениеПоказателя;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Для клиента %1 не задано значение коэффициента показателя чувствительности", СчетДоверительногоУправления));
		Возврат 0;
	КонецЕсли;
	
КонецФункции

