
Функция СформироватьНаименование(РеквизитыДоговора, ЗадействованныеРеквизиты = "") Экспорт
	
	ЗадействованныеРеквизиты = "Контрагент, НомерДоговора, ДатаЗаключения";
	
	Если РеквизитыДоговора = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НаименованиеДоговора = "";
	
	Если ЗначениеЗаполнено(РеквизитыДоговора.Контрагент) И Не ПустаяСтрока(РеквизитыДоговора.НомерДоговора) И ЗначениеЗаполнено(РеквизитыДоговора.ДатаЗаключения) Тогда
		НаименованиеДоговора = "" + РеквизитыДоговора.Контрагент + ", № " + СокрЛП(РеквизитыДоговора.НомерДоговора) + " от " + Формат(РеквизитыДоговора.ДатаЗаключения, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	Возврат НаименованиеДоговора;
	
КонецФункции // СформироватьНаименование
