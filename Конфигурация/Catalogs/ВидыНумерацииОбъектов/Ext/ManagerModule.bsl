
Функция НомерСоответствуетФормату(Номер, ВидНумерации, Отказ = Ложь) Экспорт
	
	Если ВидНумерации = Справочники.ВидыНумерацииОбъектов.ПодтвержденияСбербанка
		Или ВидНумерации = Справочники.ВидыНумерацииОбъектов.ПодтвержденияВТБ
		Или ВидНумерации = Справочники.ВидыНумерацииОбъектов.РаспоряженияНаМНО Тогда
	
		Если РаботаСоСтрокамиКлиентСервер.ТолькоЦифрыВСтроке(Номер) Тогда
			
			ТекДлина = ?(ВидНумерации = Справочники.ВидыНумерацииОбъектов.РаспоряженияНаМНО, 6, 15);
						
			Если СтрДлина(Номер) > ТекДлина Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Номер подтверждения [" + Номер + "] не должен превышать " + Строка(ТекДлина) + " символов!",,,, Отказ);		
			Иначе
				Возврат Истина;
			КонецЕсли;
			
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Номер подтверждения [" + Номер + "] должен содержать только цифры!",,,, Отказ);
		КонецЕсли;
				
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для вида нумерации [" + ВидНумерации + "] не заданы условия проверки формата!",,,, Отказ);	
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьВидНумерацииОперации(ТипДокумента, Дата, Организация, СчетДоверительногоУправления, Банк, ВидОперации) Экспорт
	
	ВидНумерации = Неопределено;
	
	Если ТипДокумента = Тип("ДокументСсылка.Распоряжение") Тогда
		
		Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента") Тогда
			
			Если Не (ЗначениеЗаполнено(Банк) И ЗначениеЗаполнено(СчетДоверительногоУправления)) Тогда
				Возврат ВидНумерации;	
			КонецЕсли;
				
			Если Банк = ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_Сбер") Тогда
				
				ВидНумерации = Справочники.ВидыНумерацииОбъектов.ПодтвержденияСбербанка;
				
			ИначеЕсли Банк = ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_ВТБ") Тогда
				
				ВидНумерации = Справочники.ВидыНумерацииОбъектов.ПодтвержденияВТБ;
				
			КонецЕсли;
			
			Если ВидНумерации <> Неопределено Тогда //проверяем наличие ген. соглашения с банком ВТБ, Сбер
																	
				Запрос = Новый Запрос;
				
#Область Текст_Запроса
				Запрос.Текст =
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	Договоры.Ссылка КАК ГенСоглашениеПоДепозитнымВкладам
					|ИЗ
					|	Справочник.Договоры КАК Договоры
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
					|				&ДатаДок,
					|				Организация = &Организация
					|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
					|		ПО Договоры.Ссылка = ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор
					|			И (ДоговорыСчетовДоверительногоУправленияСрезПоследних.Активный)
					|			И (Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ГенСоглашениеПоДепозитнымВкладам))
					|			И (НЕ Договоры.ПометкаУдаления)
					|			И (Договоры.Контрагент В
					|				(ВЫБРАТЬ
					|					&ЮрЛицоБанка КАК Ссылка
					|			
					|				ОБЪЕДИНИТЬ
					|			
					|				ВЫБРАТЬ
					|					СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо
					|				ИЗ
					|					РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&ДатаДок, ЮридическоеЛицо = &ЮрЛицоБанка
					|						И ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних))
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ДатаДок, Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
					|		ПО Договоры.Ссылка = УсловияДоговоровОбщиеСрезПоследних.Договор
					|ГДЕ
					|	(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
					|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
					|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &ДатаДок)";
#КонецОбласти
				
				Запрос.УстановитьПараметр("ДатаДок", НачалоДня(?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса())));
				Запрос.УстановитьПараметр("Организация", Организация);
				Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
				Запрос.УстановитьПараметр("ЮрЛицоБанка", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Банк, "ЮрФизЛицо"));
				
				ВидНумерации = ?(Запрос.Выполнить().Пустой(), Неопределено, ВидНумерации);	
			
			КонецЕсли;
			
		ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.МНО") Тогда
			ВидНумерации = Справочники.ВидыНумерацииОбъектов.РаспоряженияНаМНО;		
		КонецЕсли;
							
	КонецЕсли;
	
	Возврат ВидНумерации;
	
КонецФункции