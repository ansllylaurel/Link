
&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	Если ПравоДоступа("Администрирование", Метаданные) Тогда
	
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			
			ЭтаФорма.ПодключенныеРоли.Очистить();
			
			Если ЗначениеЗаполнено(Объект.ИдентификаторПользователяИБ) Тогда
				ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Объект.ИдентификаторПользователяИБ);
			КонецЕсли;
			
			Для каждого РольМД Из Метаданные.Роли Цикл
				
				НоваяСтрокаПодключенныеРоли = ЭтаФорма.ПодключенныеРоли.Добавить();
				НоваяСтрокаПодключенныеРоли.Роль     = РольМД.Представление();
				НоваяСтрокаПодключенныеРоли.Описание = "";
				
				Если ПользовательИБ <> Неопределено Тогда
					НоваяСтрокаПодключенныеРоли.Пометка  = ПользовательИБ.Роли.Содержит(РольМД);
				КонецЕсли; 
				
			КонецЦикла;
		
			ЭтаФорма.ПодключенныеРоли.Сортировать("Пометка УБЫВ, Роль");
			
		КонецЕсли;
		
		ОбновитьРеквизитыПользователяИбНаСервере();
		
		Если Элементы.РежимТакси.СписокВыбора.Количество() = 0 Тогда
			Элементы.РежимТакси.СписокВыбора.Очистить();
			Элементы.РежимТакси.СписокВыбора.Добавить("Авто");
			Элементы.РежимТакси.СписокВыбора.Добавить("Компактный");
			Элементы.РежимТакси.СписокВыбора.Добавить("Обычный");
		КонецЕсли;
		
		Отбор = Новый Структура("КлючОбъекта, Пользователь", "Общее/НастройкиКлиентскогоПриложения", ПользовательИБИмя);
	    Выборка = ХранилищеСистемныхНастроек.Выбрать(Отбор);
		Если Выборка.Следующий() Тогда
			
			Если Выборка.Настройки.ВариантМасштабаФормКлиентскогоПриложения = ВариантМасштабаФормКлиентскогоПриложения.Авто Тогда
				РежимТакси = "Авто";
			ИначеЕсли Выборка.Настройки.ВариантМасштабаФормКлиентскогоПриложения = ВариантМасштабаФормКлиентскогоПриложения.Компактный Тогда
				РежимТакси = "Компактный";
			ИначеЕсли Выборка.Настройки.ВариантМасштабаФормКлиентскогоПриложения = ВариантМасштабаФормКлиентскогоПриложения.Обычный Тогда
				РежимТакси = "Обычный";
			Иначе
				РежимТакси = "Авто";
			КонецЕсли;
			
		Иначе
			РежимТакси = "Авто";
		КонецЕсли;		
		
	Иначе
		
		// если нет права администрирования, скрываем группы, где отображается чувствительная к нему информация
		Элементы.ГруппаПользовательИБ.Видимость = Ложь;
		Элементы.СтраницаПодключенныеРоли.Видимость = Ложь;
		Элементы.НастройкиИнтерфейса.Видимость = Ложь;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЭтаФорма.ГруппыПользователя.Параметры.УстановитьЗначениеПараметра("Пользователь", Объект.Ссылка);
	Иначе
		ЭтаФорма.ГруппыПользователя.Параметры.УстановитьЗначениеПараметра("Пользователь", Неопределено);
	КонецЕсли;		

КонецПроцедуры // ПриЧтенииСозданииНаСервере

&НаСервере
Процедура ОбновитьРеквизитыПользователяИбНаСервере()
	
	ПользовательИБ = Неопределено;
	
	Если ЗначениеЗаполнено(Объект.ИдентификаторПользователяИБ) Тогда
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Объект.ИдентификаторПользователяИБ);
	КонецЕсли;
	
	Если ПользовательИБ <> Неопределено Тогда
		ЭтаФорма.ПользовательИБИмя              = ПользовательИБ.Имя;
		ЭтаФорма.ПользовательИБПолноеИмя        = ПользовательИБ.ПолноеИмя;
		ЭтаФорма.ПользовательИБАутентификацияОС = ПользовательИБ.АутентификацияОС;
		ЭтаФорма.ПользовательИБПользовательОС   = ПользовательИБ.ПользовательОС;
	Иначе
		ЭтаФорма.ПользовательИБИмя              = Неопределено;
		ЭтаФорма.ПользовательИБПолноеИмя        = Неопределено;
		ЭтаФорма.ПользовательИБАутентификацияОС = Неопределено;
		ЭтаФорма.ПользовательИБПользовательОС   = Неопределено;
	КонецЕсли;
	
КонецПроцедуры // ОбновитьРеквизитыПользователяИбНаСервере

////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЭтаФорма.ГруппыПользователя.Параметры.УстановитьЗначениеПараметра("Пользователь", Объект.Ссылка);
	
	Если ПравоДоступа("Администрирование", Метаданные) Тогда 
	
		Настройки = Новый НастройкиКлиентскогоПриложения;
	    Настройки.ВариантМасштабаФормКлиентскогоПриложения = ВариантМасштабаФормКлиентскогоПриложения[РежимТакси];    
	    ХранилищеСистемныхНастроек.Сохранить("Общее/НастройкиКлиентскогоПриложения",,Настройки,,ПользовательИБИмя);
		
		ЭтаФорма.ГруппыПользователя.Параметры.УстановитьЗначениеПараметра("Пользователь", Объект.Ссылка);
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура КомандаОчиститьИдентификатораПользователяИБ(Команда)
	
	Если Вопрос("Вы действительно хотите очистить идентификатор пользователя ИБ?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		Объект.ИдентификаторПользователяИБ = Неопределено;
		ОбновитьРеквизитыПользователяИбНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаИзменитьИдентификатораПользователяИБ(Команда)
	
	ВыбИдентификатор = ОткрытьФормуМодально("Справочник.Пользователи.Форма.ВыборПользователяИБ");
	
	Если ВыбИдентификатор <> Неопределено Тогда
		Объект.ИдентификаторПользователяИБ = ВыбИдентификатор;
		ОбновитьРеквизитыПользователяИбНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница = Элементы.СтраницаГруппыПользователя
		И НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Если Вопрос("Страница 'Группы пользователя' станет доступной после записи пользователя. Записать?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			Записать();
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы[ЭтаФорма.ИмяТекущейСтраницы];
		КонецЕсли;
		
	КонецЕсли;
	
	ЭтаФорма.ИмяТекущейСтраницы = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЭтаФорма.ИмяТекущейСтраницы = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	
КонецПроцедуры
