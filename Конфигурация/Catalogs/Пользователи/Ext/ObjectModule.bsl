
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыСправочника(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыСправочника(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Не ЭтотОбъект.ВходЗапрещен И ЗначениеЗаполнено(ЭтотОбъект.Организация) Тогда
		ПроверяемыеРеквизиты.Добавить("АдресЭлектроннойПочты");
	КонецЕсли;
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);

КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если НЕ ЭтоНовый() И Организация <> Ссылка.Организация Тогда
		
		МассивИскомыхСсылок = Новый Массив;
		МассивИскомыхСсылок.Добавить(Ссылка);
		
		МассивОбъектовМетаданных = Новый Массив;
		МассивОбъектовМетаданных.Добавить(Метаданные.Справочники.ГруппыПользователей.ТабличныеЧасти.Состав.Реквизиты.Пользователь);
		
		Если НайтиПоСсылкам(МассивИскомыхСсылок,,МассивОбъектовМетаданных).Количество() > 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запрещено менять организацию существующего пользователя, если на него есть ссылки!",, "Объект.Организация",, Отказ);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЭтоНовый() 
	   И ЮрФизЛицо <> Ссылка.ЮрФизЛицо 
	   И ЗначениеЗаполнено(Справочники.Сотрудники.НайтиПоРеквизиту("Пользователь", Ссылка)) Тогда
	   
	   	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Пользователь (%1) используется в справочнике Сотрудники, изменение реквизита 'Юр физ лицо' запрещено", 
				ЭтотОбъект.Наименование), ЭтотОбъект,,, Отказ);
	КонецЕсли;
	
	// блокирующие проверки
	Если Не ЭтотОбъект.ПометкаУдаления Тогда
		
		УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
				
		Если ЭтотОбъект.Основной Тогда
			Если Не ЗначениеЗаполнено(ЭтотОбъект.ИдентификаторПользователяИБ) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Основным может быть только пользователь, связанный с пользователем ИБ.",, "Объект.Основной",, Отказ);
			Иначе
				// проверим, что основной пользователь уникален среди пользователей с общим идентификатор ИБ
				Запрос = Новый Запрос;
				Запрос.Текст =
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
					|	Пользователи.Ссылка
					|ИЗ
					|	Справочник.Пользователи КАК Пользователи
					|ГДЕ
					|	Пользователи.ИдентификаторПользователяИБ = &ИдентификаторПользователяИБ
					|	И Пользователи.Ссылка <> &Ссылка
					|	И Пользователи.Основной";
										
				Запрос.УстановитьПараметр("ИдентификаторПользователяИБ", ЭтотОбъект.ИдентификаторПользователяИБ);
				Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
				
				Выборка = Запрос.Выполнить().Выбрать();
				
				Если Выборка.Следующий() Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Основным пользователем для текущего пользователя ИБ уже выбран '" + Выборка.Ссылка + "'",, "Объект.Основной",, Отказ);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		ВходЗапрещен = Истина;
	КонецЕсли;
		
КонецПроцедуры
