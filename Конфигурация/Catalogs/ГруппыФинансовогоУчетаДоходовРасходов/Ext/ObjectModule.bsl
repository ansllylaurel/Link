#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если Не ЭтотОбъект.ЭтоГруппа Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ГруппыФинансовогоУчетаДоходовРасходов.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ГруппыФинансовогоУчетаДоходовРасходов КАК ГруппыФинансовогоУчетаДоходовРасходов
			|ГДЕ
			|	ГруппыФинансовогоУчетаДоходовРасходов.Код = &Код
			|	И ГруппыФинансовогоУчетаДоходовРасходов.ВидДеятельностиНФО = &ВидДеятельностиНФО
			|	И ГруппыФинансовогоУчетаДоходовРасходов.Ссылка <> &Ссылка
			|	И НЕ ГруппыФинансовогоУчетаДоходовРасходов.ЭтоГруппа";
		
		Запрос.УстановитьПараметр("Код", ЭтотОбъект.Код);
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
		Запрос.УстановитьПараметр("ВидДеятельностиНФО", ЭтотОбъект.ВидДеятельностиНФО);
		
		Если НЕ Запрос.Выполнить().Пустой() Тогда
		
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Значение символа """ + ЭтотОбъект.Код + """ не уникально",,, Отказ);
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если Не ЭтотОбъект.ЭтоГруппа Тогда
		ПроверяемыеРеквизиты.Добавить("Код");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецЕсли