// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Функция читает данные производственного календаря из регистра
//
// Параметры
//	Календарь			- Ссылка на текущий элемент справочника
//	НомерГода							- Номер года, за который необходимо прочитать производственный календарь
//
// Возвращаемое значение
//	ДанныеКалендаря	- таблица значений, в которой хранятся сведения о виде дня на каждую дату календаря
//
Функция ДанныеКалендаря(Календарь, НомерГода) Экспорт
	
	НачалоГода	= Дата(НомерГода, 1, 1);
	КонецГода	= Дата(НомерГода, 12, 31);
	
	Если НЕ КалендарьЗаполненЗаПериод(Календарь, НачалоГода, КонецГода) Тогда
		ВызватьИсключение "Календарь " + Календарь + " не заполнен за " + Формат(НомерГода, "ЧГ=0") + " год!";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Календарь",	Календарь);
	Запрос.УстановитьПараметр("ТекущийГод",	НомерГода);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Дата,
		|	ДанныеКалендаря.ВидДня,
		|	ДанныеКалендаря.ДатаПереноса
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Год = &ТекущийГод
		|	И ДанныеКалендаря.Календарь = &Календарь";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Функция подготавливает результат заполнения производственного календаря 
//  данными по умолчанию
// При наличии в конфигурации макета с предопределенными данными 
//  производственного календаря на этот год, используются данные макета,
//  в противном случае данные производственного календаря формируются на основе 
//  сведений о праздниках, а также с учетом действующих правил переноса выходных дней
//
Функция РезультатЗаполненияПроизводственногоКалендаряПоУмолчанию(КодПроизводственногоКалендаря, НомерГода) Экспорт
	
	ДлинаСуток = 24 * 3600;
	
	ДанныеКалендаря = Новый ТаблицаЗначений;
	ДанныеКалендаря.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ДанныеКалендаря.Колонки.Добавить("ВидДня", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДнейКалендаря"));
	ДанныеКалендаря.Колонки.Добавить("ДатаПереноса", Новый ОписаниеТипов("Дата"));
	
	// Если есть данные в макете - используем их
	ПредопределенныеДанные = ДанныеПроизводственныхКалендарейИзМакета().НайтиСтроки(
								Новый Структура("КодПроизводственногоКалендаря, Год", КодПроизводственногоКалендаря, НомерГода));
								
	Если ПредопределенныеДанные.Количество() > 0 Тогда
		Для Каждого СтрокаТаблицыИсточник Из ПредопределенныеДанные Цикл
			ЗаполнитьЗначенияСвойств(ДанныеКалендаря.Добавить(), СтрокаТаблицыИсточник);
		КонецЦикла;
		Возврат ДанныеКалендаря;
	КонецЕсли;
	
	// Если нет - заполняем праздники и переносы
	ПраздничныеДни = ПраздничныеДниПроизводственногоКалендаря(КодПроизводственногоКалендаря, НомерГода);
	
	ВидыДней = Новый Соответствие;
	
	ДатаДня = Дата(НомерГода, 1, 1);
	Пока ДатаДня <= Дата(НомерГода, 12, 31) Цикл
		// "Непраздничный" день - определяем в соответствии с днем недели
		НомерДняНедели = ДеньНедели(ДатаДня);
		Если НомерДняНедели <= 5 Тогда
			ВидыДней.Вставить(ДатаДня, Перечисления.ВидыДнейКалендаря.Рабочий);
		ИначеЕсли НомерДняНедели = 6 Тогда
			ВидыДней.Вставить(ДатаДня, Перечисления.ВидыДнейКалендаря.Суббота);
		ИначеЕсли НомерДняНедели = 7 Тогда
			ВидыДней.Вставить(ДатаДня, Перечисления.ВидыДнейКалендаря.Воскресенье);
		КонецЕсли;
		ДатаДня = ДатаДня + ДлинаСуток;
	КонецЦикла;
	
	// При совпадении выходного и нерабочего праздничного дней 
	// выходной день переносится на следующий после праздничного рабочий день 
	// за исключением выходных дней, совпадающих с нерабочими праздничными днями 
	// в период Новогодних каникул и Рождества Христова.	
	
	ПереносыДней = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из ПраздничныеДни Цикл
		ПраздничныйДень = СтрокаТаблицы.Дата;
		Если ВидыДней[ПраздничныйДень] <> Перечисления.ВидыДнейКалендаря.Рабочий 
			И СтрокаТаблицы.ПереноситьВыходной Тогда
			// Если праздничный день выпадает на выходной, 
			// и выходной, на который выпадает этот праздник, переносится - 
			// переносим выходной на ближайший рабочий день
			ДатаДня = ПраздничныйДень;
			Пока Истина Цикл
				ДатаДня = ДатаДня + ДлинаСуток;
				Если ВидыДней[ДатаДня] = Перечисления.ВидыДнейКалендаря.Рабочий 
					И ПраздничныеДни.Найти(ДатаДня, "Дата") = Неопределено Тогда
					ВидыДней.Вставить(ДатаДня, ВидыДней[ПраздничныйДень]);
					ПереносыДней.Вставить(ДатаДня, ПраздничныйДень);
					ПереносыДней.Вставить(ПраздничныйДень, ДатаДня);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ВидыДней.Вставить(ПраздничныйДень, Перечисления.ВидыДнейКалендаря.Праздник);
		// Отметим как предпраздничный день, 
		// рабочий день непосредственно предшествующий праздничному дню
		ДатаПредпраздничногоДня = ПраздничныйДень - ДлинаСуток;
		Если ВидыДней[ДатаПредпраздничногоДня] = Перечисления.ВидыДнейКалендаря.Рабочий 
			И ПраздничныеДни.Найти(ДатаПредпраздничногоДня, "Дата") = Неопределено 
			И Год(ДатаПредпраздничногоДня) = Год(ПраздничныйДень) Тогда
			ВидыДней.Вставить(ДатаПредпраздничногоДня, Перечисления.ВидыДнейКалендаря.Предпраздничный);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из ВидыДней Цикл
		НоваяСтрока = ДанныеКалендаря.Добавить();
		НоваяСтрока.Дата = КлючИЗначение.Ключ;
		НоваяСтрока.ВидДня = КлючИЗначение.Значение;
		ДатаПереноса = ПереносыДней[НоваяСтрока.Дата];
		Если ДатаПереноса <> Неопределено Тогда
			НоваяСтрока.ДатаПереноса = ДатаПереноса;
		КонецЕсли;
	КонецЦикла;
	
	ДанныеКалендаря.Сортировать("Дата");
	
	Возврат ДанныеКалендаря;
	
КонецФункции

// Функция преобразовывает данные производственных календарей, 
//  поставляемые в виде макета в конфигурации
//
// Параметры:
//	- нет
//
// Возвращаемое значение - таблица значений с колонками
//	Подробнее см. комментарий к функции ДанныеПроизводственныхКалендарейИзXML
//
Функция ДанныеПроизводственныхКалендарейИзМакета() Экспорт
	
	ТекстовыйДокумент = РегистрыСведений.ДанныеКалендаря.ПолучитьМакет("ДанныеПроизводственныхКалендарей");
	
	Возврат ДанныеПроизводственныхКалендарейИзXML(ТекстовыйДокумент.ПолучитьТекст());
	
КонецФункции

// Функция преобразовывает данные производственных календарей, 
//  представленные в виде XML
//
// Параметры:
//	- XML - документ с данными
//
// Возвращаемое значение - таблица значений с колонками:
//	- КодПроизводственногоКалендаря
//	- ВидДня
//	- Год
//	- Дата
//	- ДатаПереноса
//
Функция ДанныеПроизводственныхКалендарейИзXML(Знач XML) Экспорт
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("КодПроизводственногоКалендаря", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(2)));
	ТаблицаДанных.Колонки.Добавить("ВидДня", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДнейКалендаря"));
	ТаблицаДанных.Колонки.Добавить("Год", Новый ОписаниеТипов("Число"));
	ТаблицаДанных.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.Добавить("ДатаПереноса", Новый ОписаниеТипов("Дата"));
	
	КлассификаторТаблица = РаботаСКоллекциями.ПрочитатьXMLВТаблицу(XML).Данные;
	
	Для Каждого СтрокаКлассификатора ИЗ КлассификаторТаблица Цикл
		НоваяСтрока = ТаблицаДанных.Добавить();
		НоваяСтрока.КодПроизводственногоКалендаря = СтрокаКлассификатора.Calendar;
		НоваяСтрока.ВидДня	= Перечисления.ВидыДнейКалендаря[СтрокаКлассификатора.DayType];
		НоваяСтрока.Год		= Число(СтрокаКлассификатора.Year);
		НоваяСтрока.Дата	= Дата(СтрокаКлассификатора.Date);
		Если ЗначениеЗаполнено(СтрокаКлассификатора.SwapDate) Тогда
			НоваяСтрока.ДатаПереноса = Дата(СтрокаКлассификатора.SwapDate);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаДанных;
	
КонецФункции

// Обновляет справочник Производственные календари из XML файла
//
// Параметры
//	- ТаблицаКалендарей - таблица значений с описанием производственных календарей
//
Процедура ОбновитьКалендари(ТаблицаКалендарей) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(КлассификаторТаблица.Code КАК СТРОКА(2)) КАК Код,
		|	ВЫРАЗИТЬ(КлассификаторТаблица.Description КАК СТРОКА(100)) КАК Наименование
		|ПОМЕСТИТЬ КлассификаторТаблица
		|ИЗ
		|	&КлассификаторТаблица КАК КлассификаторТаблица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлассификаторТаблица.Код,
		|	КлассификаторТаблица.Наименование,
		|	Календари.Ссылка КАК Ссылка,
		|	ЕСТЬNULL(Календари.Код, """") КАК КалендарьКод,
		|	ЕСТЬNULL(Календари.Наименование, """") КАК КалендарьНаименование
		|ИЗ
		|	КлассификаторТаблица КАК КлассификаторТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Календари КАК Календари
		|		ПО КлассификаторТаблица.Код = Календари.Код";
	
	Запрос.УстановитьПараметр("КлассификаторТаблица", ТаблицаКалендарей);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если СокрЛП(Выборка.Код) = СокрЛП(Выборка.КалендарьКод)
			И Выборка.Наименование = Выборка.КалендарьНаименование Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Иначе
			СправочникОбъект = Справочники.Календари.СоздатьЭлемент();
		КонецЕсли;
		СправочникОбъект.Код = СокрЛП(Выборка.Код);
		СправочникОбъект.Наименование = СокрЛП(Выборка.Наименование);
		СправочникОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

// Обновляет данные производственных календарей по таблице данных
//
Процедура ОбновитьДанныеПроизводственныхКалендарей(ТаблицаДанных) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлассификаторТаблица.КодПроизводственногоКалендаря КАК КалендарьКод,
		|	КлассификаторТаблица.Дата,
		|	КлассификаторТаблица.Год,
		|	КлассификаторТаблица.ВидДня,
		|	КлассификаторТаблица.ДатаПереноса
		|ПОМЕСТИТЬ КлассификаторТаблица
		|ИЗ
		|	&КлассификаторТаблица КАК КлассификаторТаблица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Календари.Ссылка КАК Календарь,
		|	КлассификаторТаблица.Год,
		|	КлассификаторТаблица.Дата,
		|	КлассификаторТаблица.ВидДня,
		|	КлассификаторТаблица.ДатаПереноса
		|ИЗ
		|	КлассификаторТаблица КАК КлассификаторТаблица
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Календари КАК Календари
		|		ПО КлассификаторТаблица.КалендарьКод = Календари.Код
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ПО (Календари.Ссылка = ДанныеКалендаря.Календарь)
		|			И КлассификаторТаблица.Год = ДанныеКалендаря.Год
		|			И КлассификаторТаблица.Дата = ДанныеКалендаря.Дата
		|ГДЕ
		|	(ДанныеКалендаря.ВидДня ЕСТЬ NULL 
		|			ИЛИ КлассификаторТаблица.ВидДня <> ДанныеКалендаря.ВидДня
		|			ИЛИ КлассификаторТаблица.ДатаПереноса <> ДанныеКалендаря.ДатаПереноса)";
	
	Запрос.УстановитьПараметр("КлассификаторТаблица", ТаблицаДанных);
	
	НаборЗаписей = РегистрыСведений.ДанныеКалендаря.СоздатьНаборЗаписей();
	
	КлючиРегистра = Новый Массив;
	КлючиРегистра.Добавить("Календарь");
	КлючиРегистра.Добавить("Год");
	КлючиРегистра.Добавить("Дата");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей.Очистить();
		ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), Выборка);
		Для Каждого Ключ Из КлючиРегистра Цикл 
			НаборЗаписей.Отбор[Ключ].Установить(Выборка[Ключ]);
		КонецЦикла;
		НаборЗаписей.Записать(Истина);
	КонецЦикла;
	
	ТаблицаДанных.Свернуть("КодПроизводственногоКалендаря, Год");
	
КонецПроцедуры

// Процедура записывает данные одного производственного календаря за 1 год
//
// Параметры
//	Календарь			- Ссылка на текущий элемент справочника
//	НомерГода							- Номер года, за который необходимо записать производственный календарь
//	ДанныеКалендаря	- таблица значений, в которой хранятся сведения о виде дня на каждую дату календаря
//
// Возвращаемое значение
//	Нет
//
Процедура ЗаписатьДанныеКалендаря(Календарь, НомерГода, ДанныеКалендаря) Экспорт
	
	НаборЗаписей = РегистрыСведений.ДанныеКалендаря.СоздатьНаборЗаписей();
	
	Для Каждого КлючИЗначение Из ДанныеКалендаря Цикл
		ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), КлючИЗначение);
	КонецЦикла;
	
	ЗначенияОтбора = Новый Структура("Календарь, Год", Календарь, НомерГода);
	
	Для Каждого КлючИЗначение Из ЗначенияОтбора Цикл
		НаборЗаписей.Отбор[КлючИЗначение.Ключ].Установить(КлючИЗначение.Значение);
	КонецЦикла;
	
	Для Каждого СтрокаНабора Из НаборЗаписей Цикл
		ЗаполнитьЗначенияСвойств(СтрокаНабора, ЗначенияОтбора);
	КонецЦикла;
	
	НаборЗаписей.Записать(Истина);
	
	Если ОбщегоНазначения.ЗначениеПараметраСеанса("ЭтоРабочаяИнформационнаяБаза") Тогда
		ВыгрузитьДанныеКалендаряВExternals(Календарь, НомерГода, ДанныеКалендаря);	
	КонецЕсли;
	
КонецПроцедуры

// Процедура выгружает данные одного производственного календаря за 1 год в Externals
//
// Параметры
//	Календарь			- Ссылка на текущий элемент справочника
//	НомерГода							- Номер года, за который необходимо записать производственный календарь
//	ДанныеКалендаря	- таблица значений, в которой хранятся сведения о виде дня на каждую дату календаря
//
// Возвращаемое значение
//	Нет
//
Процедура ВыгрузитьДанныеКалендаряВExternals(Календарь, НомерГода, ДанныеКалендаря)

	Попытка
	
		СтрокаСоединения = РаботаСВнешнимиСистемами.СтрокаСоединенияСExternals();
		Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(СтрокаСоединения);
		
		Соединение.BeginTrans();
		
		ТекстЗапроса = "DELETE FROM Externals.dbo.Calendar_Data WHERE Calendar_Name = '&Календарь' AND Year = &Год";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Календарь",	СокрЛП(Календарь.Наименование));
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Год",	 	Формат(НомерГода, "ЧЦ=4; ЧГ=0"));
		Соединение.Execute(ТекстЗапроса);
		
		Запрос = Новый COMОбъект("ADODB.Command");
		Запрос.CommandText = 
			"INSERT INTO Externals.dbo.Calendar_Data (Calendar_Name,Date,Year,Day_Type,Transfer_Date)
			|VALUES (?, CONVERT(datetime, ?), ?, ?, CONVERT(datetime, ?))";
		
		Запрос.CommandType		= 1;
		Запрос.Prepared			= "True";
		Запрос.NamedParameters	= "True";
		
		Запрос.Parameters.Append(Запрос.CreateParameter("@Calendar_Name"	, 200	, 1, 50));
		Запрос.Parameters.Append(Запрос.CreateParameter("@Date"			, 135	, 1, 8));
		
		Параметр = Запрос.CreateParameter("@Year"			, 14	, 1, 0);
		Параметр.NumericScale = 0;
		Параметр.Precision = 4;
		
		Запрос.Parameters.Append(Параметр);
		
		Запрос.Parameters.Append(Запрос.CreateParameter("@Day_Type"		, 200	, 1, 50));
		Запрос.Parameters.Append(Запрос.CreateParameter("@Transfer_Date"	, 135	, 1, 8));
		
		Запрос.ActiveConnection = Соединение;
		
		Для каждого СтрокаДанныеКалендаря Из ДанныеКалендаря Цикл
		
			Запрос.Parameters("@Calendar_Name").Value	= Строка(Календарь);
			Запрос.Parameters("@Date").Value			= СтрокаДанныеКалендаря.Дата;
			Запрос.Parameters("@Year").Value			= НомерГода;
			Запрос.Parameters("@Day_Type").Value			= Строка(СтрокаДанныеКалендаря.ВидДня);
			Если СтрокаДанныеКалендаря.ДатаПереноса = '00010101' Тогда
				Запрос.Parameters("@Transfer_Date").Value	= NULL;
			Иначе
				Запрос.Parameters("@Transfer_Date").Value	= СтрокаДанныеКалендаря.ДатаПереноса;
			КонецЕсли;
			
			Запрос.Execute();
		
		КонецЦикла;
		
		Соединение.CommitTrans();
		
		РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);

	Исключение
		Ошибка = ОписаниеОшибки(); 
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку("Не удалось выгрузить в Externals календарь '" + Календарь.Наименование + "' за " + Строка(НомерГода) + "год - " + Ошибка, "Данные календаря");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось выгрузить данные календаря в Externals");
	КонецПопытки;
		
КонецПроцедуры

// Функция определяет соответствие видов дня производственного календаря и цвета оформления
// этого дня в поле календаря
//
// Возвращаемое значение
//	ЦветаОформления - соответствие видов дня и цветов оформления
//
Функция ЦветаОформленияВидовДнейПроизводственногоКалендаря() Экспорт
	
	ЦветаОформления = Новый Соответствие;
	
	ЦветаОформления.Вставить(Перечисления.ВидыДнейКалендаря.Рабочий,			ЦветаСтиля.ВидДняПроизводственногоКалендаряРабочийЦвет);
	ЦветаОформления.Вставить(Перечисления.ВидыДнейКалендаря.Суббота,			ЦветаСтиля.ВидДняПроизводственногоКалендаряСубботаЦвет);
	ЦветаОформления.Вставить(Перечисления.ВидыДнейКалендаря.Воскресенье,		ЦветаСтиля.ВидДняПроизводственногоКалендаряВоскресеньеЦвет);
	ЦветаОформления.Вставить(Перечисления.ВидыДнейКалендаря.Предпраздничный,	ЦветаСтиля.ВидДняПроизводственногоКалендаряПредпраздничныйЦвет);
	ЦветаОформления.Вставить(Перечисления.ВидыДнейКалендаря.Праздник,			ЦветаСтиля.ВидДняПроизводственногоКалендаряПраздникЦвет);
	
	Возврат ЦветаОформления;
	
КонецФункции

// Функция составляет список всевозможных видов дней производственного календаря 
// по метаданным перечисления ВидыДнейКалендаря
//
// Возвращаемое значение
//	СписокВидовДня - список значений, содержащий значение перечисления 
//  					и его синоним в качестве представления
//
Функция СписокВидовДня() Экспорт
	
	СписокВидовДня = Новый СписокЗначений;
	
	Для Каждого МетаданныеВидаДней Из Метаданные.Перечисления.ВидыДнейКалендаря.ЗначенияПеречисления Цикл
		СписокВидовДня.Добавить(Перечисления.ВидыДнейКалендаря[МетаданныеВидаДней.Имя], МетаданныеВидаДней.Синоним);
	КонецЦикла;
	
	Возврат СписокВидовДня;
	
КонецФункции

// Функция составляет массив доступных производственных календарей
// для использования, например, в качестве шаблона
//
Функция СписокПроизводственныхКалендарей() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Календари.Ссылка
		|ИЗ
		|	Справочник.Календари КАК Календари
		|ГДЕ
		|	НЕ Календари.ПометкаУдаления";
		
	СписокПроизводственныхКалендарей = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокПроизводственныхКалендарей.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат СписокПроизводственныхКалендарей;
	
КонецФункции

// Функция выявляет последний день, за который заполнены данные 
// указанного производственного календаря
//
// Параметры:
//	- Календарь - тип СправочникСсылка.Календари
//
Функция ДатаОкончанияЗаполненияПроизводственногоКалендаря(Календарь) Экспорт
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Календарь КАК Календарь,
		|	МАКСИМУМ(ДанныеКалендаря.Дата) КАК Дата
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &Календарь
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеКалендаря.Календарь
		|
		|ИМЕЮЩИЕ
		|	МАКСИМУМ(ДанныеКалендаря.Дата) ЕСТЬ НЕ NULL ";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Календарь", Календарь);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Дата;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Функция заполняет массив дат праздничных дней по производственному календарю 
// для конкретного календарного года
//
Функция ПраздничныеДниПроизводственногоКалендаря(КодПроизводственногоКалендаря, НомерГода)
	
	ПраздничныеДни = Новый ТаблицаЗначений;
	ПраздничныеДни.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ПраздничныеДни.Колонки.Добавить("ПереноситьВыходной", Новый ОписаниеТипов("Булево"));
	
	Если КодПроизводственногоКалендаря = "РФ" 
		ИЛИ КодПроизводственногоКалендаря = "ОРФ" Тогда
		
		// 1, 2, 3, 4, 5, 6 и 8 января - Новогодние каникулы
		ДобавитьПраздничныйДень(ПраздничныеДни, "01.01", НомерГода, Ложь);
		ДобавитьПраздничныйДень(ПраздничныеДни, "02.01", НомерГода, Ложь);
		ДобавитьПраздничныйДень(ПраздничныеДни, "03.01", НомерГода, Ложь);
		ДобавитьПраздничныйДень(ПраздничныеДни, "04.01", НомерГода, Ложь);
		ДобавитьПраздничныйДень(ПраздничныеДни, "05.01", НомерГода, Ложь);
		ДобавитьПраздничныйДень(ПраздничныеДни, "06.01", НомерГода, Ложь);
		ДобавитьПраздничныйДень(ПраздничныеДни, "08.01", НомерГода, Ложь);
		
		// 7 января - Рождество Христово
		ДобавитьПраздничныйДень(ПраздничныеДни, "07.01", НомерГода, Ложь);
		
		// 23 февраля - День защитника Отечества
		ДобавитьПраздничныйДень(ПраздничныеДни, "23.02", НомерГода);
		
		// 8 марта - Международный женский день
		ДобавитьПраздничныйДень(ПраздничныеДни, "08.03", НомерГода);
		
		// 1 мая - Праздник Весны и Труда
		ДобавитьПраздничныйДень(ПраздничныеДни, "01.05", НомерГода);
		
		// 9 мая - День Победы
		ДобавитьПраздничныйДень(ПраздничныеДни, "09.05", НомерГода);
		
		// 12 июня - День России
		ДобавитьПраздничныйДень(ПраздничныеДни, "12.06", НомерГода);
		
		// 4 ноября - День народного единства
		ДобавитьПраздничныйДень(ПраздничныеДни, "04.11", НомерГода);
		
	КонецЕсли;
	
	Возврат ПраздничныеДни;
	
КонецФункции

Процедура ДобавитьПраздничныйДень(ПраздничныеДни, ПраздничныйДень, НомерГода, ПереноситьВыходной = Истина)
	
	ДеньМесяц = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПраздничныйДень, ".");
	
	НоваяСтрока = ПраздничныеДни.Добавить();
	НоваяСтрока.Дата = Дата(НомерГода, ДеньМесяц[1], ДеньМесяц[0]);
	НоваяСтрока.ПереноситьВыходной = ПереноситьВыходной;
	
КонецПроцедуры

Функция ПолучитьБлижайшуюРабочуюДату(Календарь, Дата) Экспорт

	Возврат ДобавитьКДатеРабочиеДни(Календарь, Дата, -1);	
	
КонецФункции

Функция ДобавитьКДатеРабочиеДни(Календарь, Дата, РабочиеДни) Экспорт
	
	КэшироватьРезультат = (Дата = НачалоДня(Дата) ИЛИ Дата = КонецДня(Дата));	
	
	Если КэшироватьРезультат Тогда	
	
		Возврат РаботаСКалендарямиПовтИсп.ДобавитьКДатеРабочиеДни(Календарь, Дата, РабочиеДни);
		
	Иначе
		
		Возврат ДобавитьКДатеРабочиеДниБезКэшированияРезультата(Календарь, Дата, РабочиеДни);
	
	КонецЕсли;

КонецФункции

Функция ДобавитьКДатеРабочиеДниБезКэшированияРезультата(Календарь, Дата, РабочиеДни) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 10
		|	ДанныеКалендаря.Календарь КАК Календарь,
		|	ДанныеКалендаря.Дата КАК РабочаяДата
		|ПОМЕСТИТЬ РабочиеДни
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &Календарь
		|	И ДанныеКалендаря.Дата <= &Дата
		|	И (ДанныеКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий)
		|			ИЛИ ДанныеКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|
		|УПОРЯДОЧИТЬ ПО
		|	РабочаяДата УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РабочиеДни.Календарь КАК Календарь,
		|	МИНИМУМ(РабочиеДни.РабочаяДата) КАК РабочаяДата
		|ИЗ
		|	РабочиеДни КАК РабочиеДни
		|
		|СГРУППИРОВАТЬ ПО
		|	РабочиеДни.Календарь";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "10", Строка(РабочиеДни * ?(РабочиеДни>0,1,-1)));
	Если РабочиеДни>0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "<=", ">=");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "УБЫВ", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "МИНИМУМ", "МАКСИМУМ");
	КонецЕсли;
	Запрос.УстановитьПараметр("Дата",		Дата);
	Запрос.УстановитьПараметр("Календарь",	Календарь);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		
		НачалоПериода	= НачалоДня(МИН(Дата, Выборка.РабочаяДата));
		КонецПериода	= МАКС(Дата, Выборка.РабочаяДата);
		// Если получили дату, то проверим, корректно ли заполнен период в календаре.
		Если НЕ КалендарьЗаполненЗаПериод(Календарь, НачалоПериода, КонецПериода) Тогда
			ВызватьИсключение "Календарь " + Календарь + " не заполнен за период с " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy") + " по " + Формат(КонецПериода, "ДФ=dd.MM.yyyy");
		Иначе
			Возврат Выборка.РабочаяДата;
		КонецЕсли;
		
	Иначе
		ВызватьИсключение "Не удалось определить рабочую дату! Возможно, не заполнен календарь " + Календарь + ". Для даты " + Формат(Дата, "ДФ=dd.MM.yyyy") + ". Добавить дней: " + РабочиеДни + ".";
	КонецЕсли;
	
КонецФункции

Функция ЭтоРабочийДень(Календарь, Дата) Экспорт
	
	Если НЕ КалендарьЗаполненЗаПериод(Календарь, Дата) Тогда
		ВызватьИсключение "Календарь " + Календарь + " не заполнен за " + Формат(Дата, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.ВидДня КАК ВидДня
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &Календарь
		|	И ДанныеКалендаря.Дата = &Дата
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))";
	
	Запрос.УстановитьПараметр("Календарь", Календарь);
	Запрос.УстановитьПараметр("Дата",      НачалоДня(Дата));
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Функция КоличествоРабочихДней(Календарь, НачалоПериода, КонецПериода) Экспорт
	
	Если НЕ КалендарьЗаполненЗаПериод(Календарь, НачалоПериода, КонецПериода) Тогда
		ВызватьИсключение "Календарь " + Календарь + " не заполнен за период с " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy") + " по " + Формат(КонецПериода, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеКалендаря.Календарь КАК Календарь,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеКалендаря.Дата) КАК КоличествоРабочихДней
	|ИЗ
	|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
	|ГДЕ
	|	ДанныеКалендаря.Календарь = &Календарь
	|	И ДанныеКалендаря.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеКалендаря.Календарь"
	);
	
	Запрос.УстановитьПараметр("Календарь",     Календарь);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода",  КонецПериода);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КоличествоРабочихДней;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДатуОплаты(ДатаЗадолженности, Договор) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыДоговора = Новый Структура("СрокОплаты, ВариантДлиныСрока");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияДоговоровОбщиеСрезПоследних.СрокОплаты КАК СрокОплаты,
		|	УсловияДоговоровОбщиеСрезПоследних.ВариантДлиныСрока КАК ВариантДлиныСрока
		|ИЗ
		|	РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ДатаЗадолженности, Договор = &Договор) КАК УсловияДоговоровОбщиеСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаЗадолженности"	, ДатаЗадолженности);
	Запрос.УстановитьПараметр("Договор"				, Договор);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(РеквизитыДоговора, Выборка);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для договора '" + Договор + "' не заданы общие условия!");
		Возврат Неопределено;
	КонецЕсли;
		
	Если РеквизитыДоговора.ВариантДлиныСрока = Перечисления.ВариантыДлиныСрока.ВКалендарныхДнях Тогда
		Возврат ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ДатаЗадолженности) + РеквизитыДоговора.СрокОплаты * 60 * 60 * 24, 1);
		
	ИначеЕсли РеквизитыДоговора.ВариантДлиныСрока = Перечисления.ВариантыДлиныСрока.ВРабочихДнях Тогда
		Возврат ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ДатаЗадолженности), РеквизитыДоговора.СрокОплаты + 1);
		
	ИначеЕсли РеквизитыДоговора.ВариантДлиныСрока = Перечисления.ВариантыДлиныСрока.ВМесяцах Тогда
		Возврат ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ДобавитьМесяц(НачалоДня(ДатаЗадолженности), РеквизитыДоговора.СрокОплаты), 1);
		
	КонецЕсли;
	
КонецФункции

Функция КалендарьЗаполненЗаПериод(Календарь, НачалоПериода, КонецПериода = Неопределено) Экспорт
	
	Если КонецПериода = Неопределено Тогда
		КонецПериода = НачалоПериода;
	КонецЕсли;
	
	Если КонецПериода < НачалоПериода Тогда
		ВызватьИсключение "Проверка заполненности календаря. Конец периода (" + КонецПериода + ") не может быть меньше Начала периода (" + НачалоПериода + ")!";	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Календарь",		Календарь);
	Запрос.УстановитьПараметр("НачалоПериода",	НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода",	КонецПериода);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Календарь КАК Календарь,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеКалендаря.Дата) КАК КоличествоЗаполненныхДней
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &Календарь
		|	И ДанныеКалендаря.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеКалендаря.Календарь
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеКалендаря.Дата) = РАЗНОСТЬДАТ(&НачалоПериода, &КонецПериода, ДЕНЬ) + 1";
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

// Функция возвращает массив дат, состоящий из рабочих и предпраздничных дней.
// указанного календаря
//
// Параметры:
//	- Календарь		- тип СправочникСсылка.Календари
//	- НачалоПериода	- тип Дата
//	- КонецПериода	- тип Дата
//
Функция ПолучитьРабочиеДниПериода(Календарь, НачалоПериода, КонецПериода) Экспорт
	
	Если НЕ КалендарьЗаполненЗаПериод(Календарь, НачалоПериода, КонецПериода) Тогда
		ВызватьИсключение "Календарь " + Календарь + " не заполнен за период с " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy") + " по " + Формат(КонецПериода, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДанныеКалендаря.Дата КАК РабочийДень
	|ИЗ
	|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
	|ГДЕ
	|	ДанныеКалендаря.Календарь = &Календарь
	|	И ДанныеКалендаря.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))"
	);
	
	Запрос.УстановитьПараметр("Календарь",     Календарь);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода",  КонецПериода);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("РабочийДень");
	
КонецФункции

// Формирует строку в зависимости от переданного календаря
//
// Параметры:
//	- КоличествоДней	- Число - количество дней
//	- Календарь			- Неопределено - "календарных" дней
//						- СправочникСсылка.Календари - если Общероссийский, то "рабочих", иначе "торговых"
//
// Возвращаемое значение
//	Строка	- "1 календарный день" (Календарь = Неопределено)
//			- "2 рабочих дня" (Календарь = Общероссийский)
//			- "5 торговых дней" (Календарь != Общероссийский)
//
Функция СтрокаСДнями(КоличествоДней, Календарь) Экспорт
	
	Если Календарь = Неопределено Тогда
		ВидДней1 = "календарный день";
		ВидДней2 = "календарных дня";
		ВидДней5 = "календарных дней";
	ИначеЕсли Календарь = Справочники.Календари.Общероссийский Тогда
		ВидДней1 = "рабочий день";
		ВидДней2 = "рабочих дня";
		ВидДней5 = "рабочих дней";
	ИначеЕсли Календарь = Константы.ОсновнойКалендарьКотировок.Получить() Тогда
		ВидДней1 = "торговый день";
		ВидДней2 = "торговых дня";
		ВидДней5 = "торговых дней";
	Иначе
		ВызватьИсключение СтрШаблон("Неизвестный календарь '%1'", Календарь);
	КонецЕсли;
	
	Возврат СтрокаСЧислом(";%1 " + ВидДней1 + ";;%1 " + ВидДней2 + ";%1 " + ВидДней5 + ";%1 " + ВидДней2, КоличествоДней, ВидЧисловогоЗначения.Количественное, "L=ru");
	
КонецФункции

#КонецЕсли

// Помещает в запрос временную таблицу с данными календаря по счетам доверительного управления. 
// Колонки временной таблицы: 
//  - "СчетДоверительногоУправления" 
//  - "Календарь"
//  - "Дата".
//
// Параметры:
// СчетаДоверительногоУправления 	- Массив счетов ДУ или ссылка на счет ДУ
// Период 							- Дата, на которую нужно получить срез истории календаря
// Календарь 						- Ссылка на справочник Календари. Календарь, из которого брать исходные даты
// ВидыДней 						- Строка из наименований видов дней  ("Рабочий, Предпраздничный") либо массив из значений перечисления ВидыДней
// НачалоПериода 					- Дата начала периода для календаря
// КонецПериода 					- Дата окончания периода для календаря
// МенеджерВременныхТаблиц 			- Менеджер временных таблиц запроса
// ИмяВременнойТаблицы				- Строка, Имя временной таблицы для помещения результата 
// УдалитьСлужебныеТаблицы			- Булево, если Истина, служебные временные таблицы будут удалены
Процедура ПоместитьВЗапросДанныеКалендаря(СчетаДоверительногоУправления, Период, Календарь = Неопределено, ВидыДней = Неопределено, НачалоПериода = Неопределено, КонецПериода = Неопределено, МенеджерВременныхТаблиц, ИмяВременнойТаблицы = "_ДанныеКалендаря", УдалитьСлужебныеТаблицы = Ложь) Экспорт
	
	Если УдалитьСлужебныеТаблицы Тогда
		СохраняемыеТаблицы = СистемныеФункции.ПолучитьИменаВременныхТаблицЗапроса(МенеджерВременныхТаблиц);
		СохраняемыеТаблицы.Добавить(ИмяВременнойТаблицы);
	КонецЕсли;
	
	ПоместитьСрезПоследнихИсключенийКалендаряВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц, Период, "_ТаблицаИсключенийСрезПоследних");	
	
	#Область Текст_запроса	
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	ДанныеКалендаря.Календарь КАК Календарь,
		|	ДанныеКалендаря.Дата КАК Дата,
		|	ВЫБОР
		|		КОГДА _ТаблицаИсключенийСрезПоследнихЮрЛицо.ВидДня ЕСТЬ НЕ NULL 
		|			ТОГДА _ТаблицаИсключенийСрезПоследнихЮрЛицо.ВидДня
		|		КОГДА _ТаблицаИсключенийСрезПоследнихДляВсех.ВидДня ЕСТЬ НЕ NULL 
		|			ТОГДА _ТаблицаИсключенийСрезПоследнихДляВсех.ВидДня
		|		ИНАЧЕ ДанныеКалендаря.ВидДня
		|	КОНЕЦ КАК ВидДня
		|ПОМЕСТИТЬ _ДанныеКалендаря
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО (СчетаДоверительногоУправления.Ссылка В (&СчетаДоверительногоУправления))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления В (&СчетаДоверительногоУправления)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&Период, ) КАК РеквизитыПИФСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент ССЫЛКА Справочник.ПаевыеИнвестиционныеФонды)
		|			И (КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УправляющиеКомпании КАК УправляющиеКомпании
		|		ПО (РеквизитыПИФСрезПоследних.УправляющаяКомпания = УправляющиеКомпании.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаИсключенийСрезПоследних КАК _ТаблицаИсключенийСрезПоследнихЮрЛицо
		|		ПО ДанныеКалендаря.Дата = _ТаблицаИсключенийСрезПоследнихЮрЛицо.Дата
		|			И ДанныеКалендаря.Календарь = _ТаблицаИсключенийСрезПоследнихЮрЛицо.Календарь
		|			И (ЕСТЬNULL(УправляющиеКомпании.ЮрФизЛицо, КлиентыДоверительногоУправленияСрезПоследних.Клиент) = _ТаблицаИсключенийСрезПоследнихЮрЛицо.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаИсключенийСрезПоследних КАК _ТаблицаИсключенийСрезПоследнихДляВсех
		|		ПО ДанныеКалендаря.Дата = _ТаблицаИсключенийСрезПоследнихДляВсех.Дата
		|			И ДанныеКалендаря.Календарь = _ТаблицаИсключенийСрезПоследнихДляВсех.Календарь
		|			И (_ТаблицаИсключенийСрезПоследнихДляВсех.ЮрФизЛицо = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.))
		|ГДЕ
		|	ИСТИНА");
	
	Если Не ЗначениеЗаполнено(ИмяВременнойТаблицы) Тогда
		ИмяВременнойТаблицы = "_ДанныеКалендаря";
	ИначеЕсли ИмяВременнойТаблицы <> "_ДанныеКалендаря" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ _ДанныеКалендаря", "ПОМЕСТИТЬ " + ИмяВременнойТаблицы);
	КонецЕсли;	

	Если Календарь <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И ДанныеКалендаря.Календарь = &Календарь";
	КонецЕсли;

	Если ВидыДней <> Неопределено Тогда
		Если ТипЗнч(ВидыДней) = Тип("Строка") Тогда
			МассивСтрок = СтрРазделить(ВидыДней, ", ", Ложь);
			
			ВидыДней = Новый Массив;
			Для Каждого ВидДняСтрокой Из МассивСтрок Цикл
				ВидыДней.Добавить(Перечисления.ВидыДнейКалендаря[ВидДняСтрокой]);
			КонецЦикла;
		КонецЕсли;
		
		Запрос.Текст = Запрос.Текст + "
		|	И ВЫБОР
		|		КОГДА _ТаблицаИсключенийСрезПоследнихЮрЛицо.ВидДня ЕСТЬ НЕ NULL 
		|				ТОГДА _ТаблицаИсключенийСрезПоследнихЮрЛицо.ВидДня
		|		КОГДА _ТаблицаИсключенийСрезПоследнихДляВсех.ВидДня ЕСТЬ НЕ NULL 
		|			ТОГДА _ТаблицаИсключенийСрезПоследнихДляВсех.ВидДня
		|		ИНАЧЕ ДанныеКалендаря.ВидДня
		|	КОНЕЦ В (&ВидыДней)";
		
		Запрос.Параметры.Вставить("ВидыДней", ВидыДней);
	КонецЕсли;
	
	Если НачалоПериода <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И ДанныеКалендаря.Дата >= &НачалоПериода";
	КонецЕсли;
	
	Если КонецПериода <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И ДанныеКалендаря.Дата <= &КонецПериода";
	КонецЕсли;
	
	#КонецОбласти
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.Параметры.Вставить("СчетаДоверительногоУправления",	СчетаДоверительногоУправления);
	Запрос.Параметры.Вставить("Календарь", 						Календарь);
	Запрос.Параметры.Вставить("Период", 						Период);
	Запрос.Параметры.Вставить("НачалоПериода", 					НачалоПериода);
	Запрос.Параметры.Вставить("КонецПериода", 					КонецПериода);
	
	Запрос.Выполнить();
	
	Если УдалитьСлужебныеТаблицы Тогда
		СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(МенеджерВременныхТаблиц, , СохраняемыеТаблицы);
	КонецЕсли;
	
КонецПроцедуры

// Помещает в менеджер временных таблиц данные календаря в соответствии с исключениями, заданными для клиента
//
// Параметры:
//	ИмяВременнойТаблицыКлиентов - Строка - имя временной таблицы, из которой берутся границы календаря.
//		Временная таблица должна содержать колонки:
//			СчетДоверительногоУправления - СправочникСсылка.СчетДоверительногоУправления - счет д/у
//			НачалоПериода - Дата, Неопределено - начальная граница календаря. При Неопределено не учитывается.
//			КонецПерирда - Дата, Неопределено - конечная граница календаря. При Неопределено не учитывается. 
//	Период - Дата - дата среза
//	Календарь - СправочникСсылка.Календари, Неопределено - фильтр по календарю. При Неопределено не учитывается.
//	ВидыДней - ПеречислениеСсылка.ВидыДнейКалендаря, Массив, Строка, Неопределено - фильтр по видам дней календаря.
//		В строке через запятую передаются имена значений перечисления. При Неопределено не учитывается. 
//	МенеджерВременныхТаблиц - МенеджерВременныхТаблиц - менеджер временных таблиц, из которого берется таблица клиентов и в которую будут помещены результаты.
//	ИмяВременнойТаблицы - Строка - имя временной таблицы, в которую будут помещены результаты.
//	УдалитьСлужебныеТаблицы - Булево - при истине удаляет служебные и промежуточные таблицы, созданные во время работы процедуры.
//
Процедура ПоместитьВЗапросДанныеКалендаряПоТаблицеКлиентов(ИмяВременнойТаблицыКлиентов = "_СчетаДоверительногоУправления", Период, Календарь = Неопределено, ВидыДней = Неопределено, МенеджерВременныхТаблиц, ИмяВременнойТаблицы = "_ДанныеКалендаря", УдалитьСлужебныеТаблицы = Ложь) Экспорт
	
	Если УдалитьСлужебныеТаблицы Тогда
		СохраняемыеТаблицы = СистемныеФункции.ПолучитьИменаВременныхТаблицЗапроса(МенеджерВременныхТаблиц);
		СохраняемыеТаблицы.Добавить(ИмяВременнойТаблицы);
	КонецЕсли;
	
	ПоместитьСрезПоследнихИсключенийКалендаряВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц, Период, "_ТаблицаИсключенийСрезПоследних");	
	
	#Область Текст_запроса
	
	Запрос = Новый Запрос( 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_СчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДанныеКалендаря.Календарь КАК Календарь,
		|	ДанныеКалендаря.Дата КАК Дата,
		|	ВЫБОР
		|		КОГДА _ТаблицаИсключенийСрезПоследнихЮрЛицо.ВидДня ЕСТЬ НЕ NULL 
		|			ТОГДА _ТаблицаИсключенийСрезПоследнихЮрЛицо.ВидДня
		|		КОГДА _ТаблицаИсключенийСрезПоследнихДляВсех.ВидДня ЕСТЬ НЕ NULL 
		|			ТОГДА _ТаблицаИсключенийСрезПоследнихДляВсех.ВидДня
		|		ИНАЧЕ ДанныеКалендаря.ВидДня
		|	КОНЕЦ КАК ВидДня
		|ПОМЕСТИТЬ _ДанныеКалендаря
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|				&Период,
		|				СчетДоверительногоУправления В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|					ИЗ
		|						_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = _СчетаДоверительногоУправления.СчетДоверительногоУправления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&Период, ) КАК РеквизитыПИФСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент ССЫЛКА Справочник.ПаевыеИнвестиционныеФонды)
		|			И (КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УправляющиеКомпании КАК УправляющиеКомпании
		|		ПО (РеквизитыПИФСрезПоследних.УправляющаяКомпания = УправляющиеКомпании.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаИсключенийСрезПоследних КАК _ТаблицаИсключенийСрезПоследнихЮрЛицо
		|		ПО ДанныеКалендаря.Дата = _ТаблицаИсключенийСрезПоследнихЮрЛицо.Дата
		|			И ДанныеКалендаря.Календарь = _ТаблицаИсключенийСрезПоследнихЮрЛицо.Календарь
		|			И (ЕСТЬNULL(УправляющиеКомпании.ЮрФизЛицо, КлиентыДоверительногоУправленияСрезПоследних.Клиент) = _ТаблицаИсключенийСрезПоследнихЮрЛицо.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаИсключенийСрезПоследних КАК _ТаблицаИсключенийСрезПоследнихДляВсех
		|		ПО ДанныеКалендаря.Дата = _ТаблицаИсключенийСрезПоследнихДляВсех.Дата
		|			И ДанныеКалендаря.Календарь = _ТаблицаИсключенийСрезПоследнихДляВсех.Календарь
		|			И (_ТаблицаИсключенийСрезПоследнихДляВсех.ЮрФизЛицо = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.))
		|ГДЕ
		|	&ФильтрКалендаря
		|	И &ФильтрВидаДней
		|	И (_СчетаДоверительногоУправления.НачалоПериода = НЕОПРЕДЕЛЕНО
		|			ИЛИ ДанныеКалендаря.Дата >= _СчетаДоверительногоУправления.НачалоПериода)
		|	И (_СчетаДоверительногоУправления.КонецПериода = НЕОПРЕДЕЛЕНО
		|			ИЛИ ДанныеКалендаря.Дата <= _СчетаДоверительногоУправления.КонецПериода)");

	Если Не ЗначениеЗаполнено(ИмяВременнойТаблицы) Тогда
		ИмяВременнойТаблицы = "_ДанныеКалендаря";
	ИначеЕсли ИмяВременнойТаблицы <> "_ДанныеКалендаря" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ _ДанныеКалендаря", "ПОМЕСТИТЬ " + ИмяВременнойТаблицы);
	КонецЕсли;	

	Если Не ЗначениеЗаполнено(ИмяВременнойТаблицыКлиентов) Тогда
		ИмяВременнойТаблицы = "_СчетаДоверительногоУправления";
	ИначеЕсли ИмяВременнойТаблицы <> "_СчетаДоверительногоУправления" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "_СчетаДоверительногоУправления", ИмяВременнойТаблицыКлиентов);
	КонецЕсли;	
	
	Если Календарь = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрКалендаря", "ИСТИНА");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрКалендаря", "ДанныеКалендаря.Календарь = &Календарь");
	КонецЕсли;

	Если ВидыДней = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрВидаДней", "ИСТИНА");
	Иначе
		Если ТипЗнч(ВидыДней) = Тип("Строка") Тогда
			МассивСтрок = СтрРазделить(ВидыДней, ", ", Ложь);
			
			ВидыДней = Новый Массив;
			Для Каждого ВидДняСтрокой Из МассивСтрок Цикл
				ВидыДней.Добавить(Перечисления.ВидыДнейКалендаря[ВидДняСтрокой]);
			КонецЦикла;
		КонецЕсли;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрВидаДней", 
			"ЕСТЬNULL(_ТаблицаИсключенийСрезПоследнихЮрЛицо.ВидДня, ЕСТЬNULL(_ТаблицаИсключенийСрезПоследнихДляВсех.ВидДня, ДанныеКалендаря.ВидДня)) В (&ВидыДней)");
	КонецЕсли;
	
	#КонецОбласти
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Период", 	Период);
	Запрос.УстановитьПараметр("Календарь", 	Календарь);
	Запрос.УстановитьПараметр("ВидыДней", 	ВидыДней);
	
	Запрос.Выполнить();
	
	Если УдалитьСлужебныеТаблицы Тогда
		СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(МенеджерВременныхТаблиц, , СохраняемыеТаблицы);
	КонецЕсли;
	
КонецПроцедуры

Функция ПоместитьСрезПоследнихИсключенийКалендаряВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц, Период, ИмяВременнойТаблицы = "_ТаблицаИсключенийСрезПоследних")
	
	Запрос = Новый Запрос( 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаИсключений.Период КАК Период,
		|	ТаблицаИсключений.Календарь КАК Календарь,
		|	ТаблицаИсключений.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ТаблицаИсключений.Дата КАК Дата,
		|	ТаблицаИсключений.ВидДня КАК ВидДня
		|ПОМЕСТИТЬ _ТаблицаИсключений
		|ИЗ
		|	&ТаблицаИсключений КАК ТаблицаИсключений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаИсключений.Дата КАК Дата,
		|	_ТаблицаИсключений.Календарь КАК Календарь,
		|	_ТаблицаИсключений.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_ТаблицаИсключений.ВидДня КАК ВидДня
		|ПОМЕСТИТЬ _ТаблицаИсключенийСрезПоследних
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ТаблицаИсключений.Дата КАК Дата,
		|		_ТаблицаИсключений.Календарь КАК Календарь,
		|		_ТаблицаИсключений.ЮрФизЛицо КАК ЮрФизЛицо,
		|		МАКСИМУМ(_ТаблицаИсключений.Период) КАК ПериодИсключения
		|	ИЗ
		|		_ТаблицаИсключений КАК _ТаблицаИсключений
		|	ГДЕ
		|		_ТаблицаИсключений.Период <= &Период
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ТаблицаИсключений.Дата,
		|		_ТаблицаИсключений.Календарь,
		|		_ТаблицаИсключений.ЮрФизЛицо) КАК ПериодыИсключений
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаИсключений КАК _ТаблицаИсключений
		|		ПО ПериодыИсключений.Дата = _ТаблицаИсключений.Дата
		|			И ПериодыИсключений.Календарь = _ТаблицаИсключений.Календарь
		|			И ПериодыИсключений.ЮрФизЛицо = _ТаблицаИсключений.ЮрФизЛицо
		|			И ПериодыИсключений.ПериодИсключения = _ТаблицаИсключений.Период");
	
	Если Не ЗначениеЗаполнено(ИмяВременнойТаблицы) Тогда
		ИмяВременнойТаблицы = "_ТаблицаИсключенийСрезПоследних";
	ИначеЕсли ИмяВременнойТаблицы <> "_ТаблицаИсключенийСрезПоследних" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ _ТаблицаИсключенийСрезПоследних", "ПОМЕСТИТЬ " + ИмяВременнойТаблицы);
	КонецЕсли;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ТаблицаИсключений",	ПолучитьИсключенияКалендаря());
	Запрос.УстановитьПараметр("Период",				Период);
	
	Запрос.Выполнить();	
	
	Возврат ИмяВременнойТаблицы;	
	
КонецФункции

Функция ПолучитьИсключенияКалендаря()
	
	//Период		- дата, с которой дествует изменение
	//Календарь		- Календарь, для которого действует изменение
	//ЮрФизЛицо		- Клиент или УК, для которого действует изменение. Если установить неопределено или пустую ссылку, изменение будет дейстовать для всех.
	//					NB! Если ранее для ЮрФизЛица установлена настройка, настройка для ВСЕХ не отменит её, нужно так же установить настройку для ЮрФизЛица, если применимо в т.ч. к ЮрФизЛицу.
	//Дата 			- Дата, в которой будет изменён вид дня в календаре
	//ВидДня		- ВидДня, на который нужно изменить значение в календаре
	//Комментарий	- Ссылка на постановление, #Задачу в 1Ф или письмо клиента.
	
	ТаблицаИсключений = Новый ТаблицаЗначений;
	ТаблицаИсключений.Колонки.Добавить("Период"		, Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТаблицаИсключений.Колонки.Добавить("Календарь"	, Новый ОписаниеТипов("СправочникСсылка.Календари"));
	ТаблицаИсключений.Колонки.Добавить("ЮрФизЛицо"	, Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	ТаблицаИсключений.Колонки.Добавить("Дата"		, Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТаблицаИсключений.Колонки.Добавить("ВидДня"		, Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДнейКалендаря"));
	ТаблицаИсключений.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка",Новый КвалификаторыСтроки(150)));
	
#Область Дата_22_04_2020

	НовоеИсключение = ТаблицаИсключений.Добавить();
