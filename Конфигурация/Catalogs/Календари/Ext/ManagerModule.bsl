	НовоеИсключение.ЮрФизЛицо	= Неопределено;
	НовоеИсключение.Дата		= Дата(2020, 3, 30);
	НовоеИсключение.ВидДня		= Перечисления.ВидыДнейКалендаря.Рабочий;
