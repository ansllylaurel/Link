	НовоеИсключение.Период		= Дата(2020, 3, 25);
	НовоеИсключение.Календарь	= Справочники.Календари.Общероссийский;
	НовоеИсключение.ЮрФизЛицо	= Неопределено;
	НовоеИсключение.Дата		= Дата(2020, 3, 30);
	НовоеИсключение.ВидДня		= Перечисления.ВидыДнейКалендаря.Праздник;
	НовоеИсключение.Комментарий	= "Указ Президента РФ от 25.03.2020 N 206";

