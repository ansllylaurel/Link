	НовоеИсключение.Дата		= Дата(2020, 4, 22);
	НовоеИсключение.ВидДня		= Перечисления.ВидыДнейКалендаря.Праздник;
	НовоеИсключение.Комментарий	= "Указ Президента РФ от 17.03.2020 N 188";

	НовоеИсключение = ТаблицаИсключений.Добавить();
	НовоеИсключение.Период		= Дата(2020, 3, 25);
	НовоеИсключение.Календарь	= Справочники.Календари.Общероссийский;
	НовоеИсключение.ЮрФизЛицо	= Неопределено;
	НовоеИсключение.Дата		= Дата(2020, 4, 22);
	НовоеИсключение.ВидДня		= Перечисления.ВидыДнейКалендаря.Рабочий;
	НовоеИсключение.Комментарий	= "Указ Президента РФ от 17.03.2020 N 188 п. 1 в ред. Указа Президента РФ от 25.03.2020 N 205";
	
#КонецОбласти

#Область Дата_30_03_2020

