Функция ПолучитьДатуДивидендов(Акция, Дата) Экспорт
	
	Если ЗначениеЗаполнено(Акция) Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ДивидендыПоАкциям.Период КАК Период
			|ИЗ
			|	РегистрСведений.ДивидендыПоАкциям КАК ДивидендыПоАкциям
			|ГДЕ
			|	ДивидендыПоАкциям.Акция = &Акция
			|	И ДивидендыПоАкциям.Период >= &Дата
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДивидендыПоАкциям.Период";
		
		Запрос.УстановитьПараметр("Дата", Дата);
		Запрос.УстановитьПараметр("Акция", Акция);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			
			Возврат ВыборкаДетальныеЗаписи.Период;
			
		Иначе
			
			Возврат "";
			
		КонецЕсли;
	
	КонецЕсли; 
	
КонецФункции
