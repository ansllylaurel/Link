
Функция ПолучитьХэшСуммуУсловийОтбора(НастройкиКомпоновкиДанных) Экспорт
	
	Отбор = НастройкиКомпоновкиДанных.Отбор;
	
	// т.к. нет возможности скопировать настройки компоновки данных, загрузим их в ХЗ
	НастройкиХранилище = Новый ХранилищеЗначения(НастройкиКомпоновкиДанных);
	НовыеНастройки = НастройкиХранилище.Получить();
	НовыйОтбор = НовыеНастройки.Отбор;
	НовыйОтбор.Элементы.Очистить();
	
	НормализоватьОтбор(Отбор, НовыйОтбор);
	РазгруппироватьОтбор(НовыйОтбор);
	
	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("ТипГруппы", 		Новый ОписаниеТипов("ТипГруппыЭлементовОтбораКомпоновкиДанных"));
	Дерево.Колонки.Добавить("ЛевоеЗначение", 	Новый ОписаниеТипов("ПолеКомпоновкиДанных"));
	Дерево.Колонки.Добавить("ВидСравнения", 	Новый ОписаниеТипов("ВидСравненияКомпоновкиДанных"));
	Дерево.Колонки.Добавить("ПравоеЗначение");
	
	ЗаполнитьДеревоИзОтбора(НовыйОтбор, Дерево.Строки);
	Дерево.Строки.Сортировать("ЛевоеЗначение, ВидСравнения, ПравоеЗначение", Истина); 
	
	НовыйОтбор.Элементы.Очистить();
	
	ЗаполнитьОтборИзДерева(НовыйОтбор, Дерево.Строки);
	
	ДвоичныеДанные = ПолучитьДвоичныеДанныеОтбора(НовыйОтбор);
	
	ХешированиеДанных = Новый ХешированиеДанных(ХешФункция.SHA512);
	ХешированиеДанных.Добавить(ДвоичныеДанные);
	Возврат Base64Строка(ХешированиеДанных.ХешСумма);
	
КонецФункции

// Выполняет нормализацию отбора
//
// Параметры:
//  Отбор		 - ОтборКомпоновкиДанных - 
//  НовыйОтбор	 - ОтборКомпоновкиДанных - 
//
Процедура НормализоватьОтбор(Отбор, НовыйОтбор, Сортировать = Истина) Экспорт
	
	// элементы отбора сначала поместим в ТЗ для удобного поиска и сортировки элементов
	ЭлементыНовогоОтбора = Новый ТаблицаЗначений;
	ЭлементыНовогоОтбора.Колонки.Добавить("ЛевоеЗначение");
	ЭлементыНовогоОтбора.Колонки.Добавить("ВидСравнения");
	ЭлементыНовогоОтбора.Колонки.Добавить("ПравоеЗначение");
	
	Для каждого ЭлементОтбора Из Отбор.Элементы Цикл
	
		Если НЕ ЭлементОтбора.Использование Тогда
			// пропускаем отключенные отборы
			Продолжить;
		КонецЕсли; 
			
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			
			Если КоличествоАктивныхЭлементовОтбора(ЭлементОтбора.Элементы) = 0 Тогда
				// пустые группы не копируем
				Продолжить;
			КонецЕсли; 
			
			НоваяГруппаОтбора = НовыйОтбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			НоваяГруппаОтбора.ТипГруппы = ЭлементОтбора.ТипГруппы;
			
			НормализоватьОтбор(ЭлементОтбора, НоваяГруппаОтбора);
						 		
		Иначе
			
			НовыйЭлементОтбора = ЭлементыНовогоОтбора.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйЭлементОтбора, ЭлементОтбора); 
			// заменим списки из одного элемента
			Если НовыйЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке 
				И НовыйЭлементОтбора.ПравоеЗначение.Количество() = 1 Тогда
				
				НовыйЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
				НовыйЭлементОтбора.ПравоеЗначение = НовыйЭлементОтбора.ПравоеЗначение[0].Значение;

			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Сортировать Тогда
	
		ЭлементыНовогоОтбора.Сортировать("ЛевоеЗначение, ВидСравнения, ПравоеЗначение");
	
	КонецЕсли; 	
	
	Если ТипЗнч(НовыйОтбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") 
		И НовыйОтбор.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли Тогда
		
		ЭлементыНовогоОтбораСвернуто = ЭлементыНовогоОтбора.СкопироватьКолонки();
		ЕстьЭмитент = Ложь;
		ЕстьГоловнаяОрганизация = Ложь;
		
		// Заменим группы вида (Эмитент = НашЭмитент1 ИЛИ Эмитент = НашЭмитент2) на отбор Эмитент ВСписке (НашЭмитент1, НашЭмитент2)
		Для каждого ЭлементОтбора Из ЭлементыНовогоОтбора Цикл
		
			НайденныеСтроки = ЭлементыНовогоОтбораСвернуто.НайтиСтроки(Новый Структура("ЛевоеЗначение", ЭлементОтбора.ЛевоеЗначение));
			Если НайденныеСтроки.Количество() = 0 Тогда
				ЗаполнитьЗначенияСвойств(ЭлементыНовогоОтбораСвернуто.Добавить(), ЭлементОтбора);
			Иначе
				Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
					
					Если (НайденнаяСтрока.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно ИЛИ НайденнаяСтрока.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке)
						И (ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно ИЛИ ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке) Тогда
					    
						НайденнаяСтрока.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
						ОбъединитьСписки(НайденнаяСтрока.ПравоеЗначение, ЭлементОтбора.ПравоеЗначение);
						
					ИначеЕсли (НайденнаяСтрока.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно ИЛИ НайденнаяСтрока.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке)
						И (ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно ИЛИ ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке) Тогда
						
						НайденнаяСтрока.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке;
						ОбъединитьСписки(НайденнаяСтрока.ПравоеЗначение, ЭлементОтбора.ПравоеЗначение);
						
					КонецЕсли;
					
				КонецЦикла; 
			КонецЕсли;
			
			Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Основные.ГоловнаяОрганизация") Тогда
				ЕстьГоловнаяОрганизация = Истина;
			КонецЕсли; 
			
			Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Основные.Эмитент") Тогда
				ЕстьЭмитент = Истина;
			КонецЕсли; 			
		
		КонецЦикла; 
		
		// если внутри группы ИЛИ одновременно установлены одинаковые отборы по эмитенту и головной организации - такие отборы считаем избыточными, 
		// т.к. значения поля Эмитент - частный случай значений поля ГоловнаяОрганизация. Оставляем только отбор по головной организации
		// пример такого отбора (Эмитент = НашЭмитент ИЛИ ГоловнаяОрганизация = НашЭмитент)
		Если ЕстьГоловнаяОрганизация И ЕстьЭмитент Тогда
			
			СтрокиГО = ЭлементыНовогоОтбораСвернуто.НайтиСтроки(Новый Структура("ЛевоеЗначение", Новый ПолеКомпоновкиДанных("Основные.ГоловнаяОрганизация")));
			СтрокиКУдалению = Новый Массив;
			Для каждого СтрокаГо Из СтрокиГО Цикл
				
				Фильтр = Новый Структура("ЛевоеЗначение, ВидСравнения", Новый ПолеКомпоновкиДанных("Основные.Эмитент"), СтрокаГО.ВидСравнения);
				СтрокиЭ = ЭлементыНовогоОтбораСвернуто.НайтиСтроки(Фильтр);
				
				Для каждого СтрокаЭ Из СтрокиЭ Цикл
					Если ЗначенияРавны(СтрокаГо.ПравоеЗначение, СтрокаЭ.ПравоеЗначение) Тогда
						СтрокиКУдалению.Добавить(СтрокаЭ);
					КонецЕсли;					
				КонецЦикла; 
			
			КонецЦикла; 
			
			Для каждого Строка Из СтрокиКУдалению Цикл
				ЭлементыНовогоОтбораСвернуто.Удалить(Строка);
			КонецЦикла; 
		
		КонецЕсли; 
		
		ЭлементыНовогоОтбора = ЭлементыНовогоОтбораСвернуто;
		
	КонецЕсли; 
	
	// добавим элементы в НовыйОтбор из таблицы
	Для каждого ЭлементОтбора Из ЭлементыНовогоОтбора Цикл
		
		НовыйЭлементОтбора = НовыйОтбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЗаполнитьЗначенияСвойств(НовыйЭлементОтбора, ЭлементОтбора);
		
		Если ТипЗнч(НовыйЭлементОтбора.ПравоеЗначение) = Тип("СписокЗначений") Тогда
			
			Для Индекс = НовыйЭлементОтбора.ПравоеЗначение.Количество()-1 По 0 Цикл
				// удалим пустые значения
				Если Не ЗначениеЗаполнено(НовыйЭлементОтбора.ПравоеЗначение[Индекс].Значение) Тогда
					НовыйЭлементОтбора.ПравоеЗначение.Удалить(Индекс);
				КонецЕсли; 
			
			КонецЦикла; 
			
			Если Сортировать Тогда
			
				// отсортируем списки
				НовыйЭлементОтбора.ПравоеЗначение.СортироватьПоЗначению();				
			
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

Процедура ОбъединитьСписки(Приемник, Источник)

	Если ТипЗнч(Приемник) <> Тип("СписокЗначений") Тогда
						
		НовыйСписок = Новый СписокЗначений;
		НовыйСписок.Добавить(Приемник);
		Приемник = НовыйСписок;
	
	КонецЕсли; 
	
	Если ТипЗнч(Источник) = Тип("СписокЗначений") Тогда
		Для каждого ЭлСписка Из Источник Цикл
			Приемник.Добавить(ЭлСписка.Значение);
		КонецЦикла; 
	Иначе
		Приемник.Добавить(Источник);
	КонецЕсли;

КонецПроцедуры

Функция ЗначенияРавны(ПервоеЗначение, ВтороеЗначение)

	Если ТипЗнч(ПервоеЗначение) <> Тип("СписокЗначений") Тогда
		Список1 = Новый СписокЗначений;
		Список1.Добавить(ПервоеЗначение);
	Иначе
		Список1 = ПервоеЗначение;
	КонецЕсли; 
	
	Если ТипЗнч(ВтороеЗначение) <> Тип("СписокЗначений") Тогда
		Список2 = Новый СписокЗначений;
		Список2.Добавить(ВтороеЗначение);
	Иначе
		Список2 = ВтороеЗначение;
	КонецЕсли;
	
	Возврат РаботаСКоллекциями.СпискиЗначенийИдентичны(Список1, Список2);

КонецФункции

// Удаляет из отбора избыточные группировки
//
// Параметры:
//  Отбор	 - ОтборКомпоновкиДанных - содержит исходный отбор
//
Процедура РазгруппироватьОтбор(Отбор) Экспорт

	ГруппыКУдалению = Новый Массив;
	
	Для каждого ЭлементОтбора Из Отбор.Элементы Цикл
	
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			
			ГруппаРодитель = ?(ЭлементОтбора.Родитель = Неопределено, Отбор, ЭлементОтбора.Родитель);
			
			Если (ТипЗнч(ГруппаРодитель) = Тип("ОтборКомпоновкиДанных") ИЛИ ГруппаРодитель.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ)
				И ЭлементОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ Тогда
				// Это верхний уровень или это группа И. Еще одна группа И тут не имеет смысла
				Разгруппировать = Истина;
			ИначеЕсли ЭлементОтбора.ТипГруппы <> ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе И КоличествоАктивныхЭлементовОтбора(ЭлементОтбора.Элементы) = 1 Тогда 
				// в группе один элемент. Разгруппировываем
				Разгруппировать = Истина;
			Иначе
				Разгруппировать = Ложь;
			КонецЕсли;
			
			Если Разгруппировать Тогда
			
				СкопироватьИРазгруппироватьОтбор(ГруппаРодитель, ЭлементОтбора);
				ГруппаКУдалению = Новый Структура;
				ГруппаКУдалению.Вставить("Коллекция", ГруппаРодитель.Элементы);
				ГруппаКУдалению.Вставить("Группа", ЭлементОтбора);
				ГруппыКУдалению.Добавить(ГруппаКУдалению);
				
			КонецЕсли; 
			
		КонецЕсли;
	
	КонецЦикла; 
	
	Для каждого ГруппаКУдалению Из ГруппыКУдалению Цикл
	
		ГруппаКУдалению.Коллекция.Удалить(ГруппаКУдалению.Группа);
	
	КонецЦикла; 
	
КонецПроцедуры

// Копирует подчененные элементы отбора источника в отбор приемник
//
// Параметры:
//  Приемник - ОтборКомпоновкиДанных, ГруппаЭлементовОтбораКомпоновкиДанных - Отбор или группа приемник
//  Источник - ОтборКомпоновкиДанных, ГруппаЭлементовОтбораКомпоновкиДанных - Отбор или группа источник
//
Процедура СкопироватьИРазгруппироватьОтбор(Приемник, Источник);

	Для каждого ЭлементИсточника Из Источник.Элементы Цикл
	
		Если ТипЗнч(ЭлементИсточника) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Индекс = Приемник.Элементы.Индекс(Источник) + 1;
			НоваяГруппаОтбора = Приемник.Элементы.Вставить(Индекс, Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			НоваяГруппаОтбора.ТипГруппы = ЭлементИсточника.ТипГруппы;
			СкопироватьИРазгруппироватьОтбор(НоваяГруппаОтбора, ЭлементИсточника);
			РазгруппироватьОтбор(НоваяГруппаОтбора);
		Иначе
			НовыйЭлементОтбора = Приемник.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовыйЭлементОтбора, ЭлементИсточника);
		КонецЕсли; 
	
	КонецЦикла; 

КонецПроцедуры

Процедура ЗаполнитьДеревоИзОтбора(Отбор, Строки)

	Для каждого ЭлементОтбора Из Отбор.Элементы Цикл
	
		НоваяСтрока = Строки.Добавить();
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			
			НоваяСтрока.ТипГруппы = ЭлементОтбора.ТипГруппы;
			ЗаполнитьДеревоИзОтбора(ЭлементОтбора, НоваяСтрока.Строки);
			
		Иначе
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементОтбора);
			
		КонецЕсли;
	
	КонецЦикла; 

КонецПроцедуры
 
Процедура ЗаполнитьОтборИзДерева(Отбор, Строки)

	Для каждого Строка Из Строки Цикл
	
		Если Строка.Строки.Количество() > 0 Тогда
		
			Группа = Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			Группа.ТипГруппы = Строка.ТипГруппы;
			ЗаполнитьОтборИзДерева(Группа, Строка.Строки);
			
		Иначе
			
			НовыйЭлемент = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, Строка, "ЛевоеЗначение, ВидСравнения, ПравоеЗначение") 
		
		КонецЕсли; 
	
	КонецЦикла; 

КонецПроцедуры

Функция КоличествоАктивныхЭлементовОтбора(ЭлементыОтбора)

	Количество = 0;
	Для каждого Элемент Из ЭлементыОтбора Цикл
		Если Элемент.Использование Тогда
			Количество = Количество + 1;
		КонецЕсли; 
	КонецЦикла; 
	
	Возврат Количество;

КонецФункции

Функция ПолучитьДвоичныеДанныеОтбора(Отбор)

	Если ТипЗнч(Отбор) = Тип("ОтборКомпоновкиДанных") Тогда 
		ИмяТипа = "Filter";
		ПространствоИмен = "http://v8.1c.ru/8.1/data-composition-system/settings";
	Иначе
		Возврат Неопределено;
	КонецЕсли; 
	
	ЗаписьXML = Новый ЗаписьXML;
	ПотокВПамяти = Новый ПотокВПамяти;
	ЗаписьXML.ОткрытьПоток(ПотокВПамяти);
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Отбор, ИмяТипа, ПространствоИмен);
	ЗаписьXML.Закрыть();
	
	Возврат ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();

КонецФункции
 