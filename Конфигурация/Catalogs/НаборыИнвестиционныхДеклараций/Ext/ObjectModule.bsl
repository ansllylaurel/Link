
Функция РедактированиеЗапрещено() Экспорт
	
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("ПрограммноеОбновление") Тогда
		УстановитьПривилегированныйРежим(Истина);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ИнвестиционныеДекларацииПоказатели.Ссылка КАК Ссылка
			|ПОМЕСТИТЬ _ДекларацииПоНабору
			|ИЗ
			|	Справочник.ИнвестиционныеДекларации.Показатели КАК ИнвестиционныеДекларацииПоказатели
			|ГДЕ
			|	ИнвестиционныеДекларацииПоказатели.НаборИнвестиционнойДекларации = &НаборИнвестиционнойДекларации
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДекларацииПоНабору.Ссылка КАК Ссылка
			|ПОМЕСТИТЬ _ДекларацииВсе
			|ИЗ
			|	_ДекларацииПоНабору КАК _ДекларацииПоНабору
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ИнвестиционныеДекларацииПоказатели.Ссылка
			|ИЗ
			|	Справочник.ИнвестиционныеДекларации.Показатели КАК ИнвестиционныеДекларацииПоказатели
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДекларацииПоНабору КАК _ДекларацииПоНабору
			|		ПО ИнвестиционныеДекларацииПоказатели.ИнвестиционнаяДекларация = _ДекларацииПоНабору.Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	_ДекларацииВсе.Ссылка КАК Ссылка
			|ИЗ
			|	_ДекларацииВсе КАК _ДекларацииВсе
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НазначениеИнвестиционнойДекларации.ИнвестиционныеДекларации КАК НазначениеИнвестиционнойДекларацииИнвестиционныеДекларации
			|		ПО _ДекларацииВсе.Ссылка = НазначениеИнвестиционнойДекларацииИнвестиционныеДекларации.ИнвестиционнаяДекларация
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИнвестиционныеДекларации КАК ИнвестиционныеДекларации
			|		ПО (НазначениеИнвестиционнойДекларацииИнвестиционныеДекларации.Ссылка = ИнвестиционныеДекларации.НазначениеИнвестиционнойДекларации)
			|			И (ИнвестиционныеДекларации.Активность)";
		
		Запрос.УстановитьПараметр("НаборИнвестиционнойДекларации", ЭтотОбъект.Ссылка);
		
		РедактированиеЗапрещено = Не Запрос.Выполнить().Пустой();
		
	Иначе
		
		РедактированиеЗапрещено = Ложь;
		
	КонецЕсли;
	
	Возврат РедактированиеЗапрещено;
		
КонецФункции

Процедура ПриЗаписи(Отказ)
	
	РазличияВерсийОбъекта = УниверсальныеМеханизмы.ПолучитьРазличияВерсийОбъекта(ЭтотОбъект);
	
	Если Не РазличияВерсийОбъекта = Неопределено Тогда
			
		ЕстьОшибки = Ложь;
		
		Для каждого ЭлементСтруктуры Из РазличияВерсийОбъекта Цикл
		
			Если ЭлементСтруктуры.Значение.Количество() > 0 Тогда
			    ЕстьОшибки = Истина;
				Прервать;		
			КонецЕсли; 
		
		КонецЦикла; 
		
		Если ЕстьОшибки Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В инвестиционных декларациях, назначенных клиентам, имеются ссылки на текущий набор", ЭтотОбъект, , , Отказ);
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если Не ЭтотОбъект.ЭтоГруппа Тогда
	
		НастройкиКомпоновкиДанных = ЭтотОбъект.УсловияОтбора.Получить();
		
		ЭтотОбъект.ИспользуемыеЗначения.Очистить();
		ЗаполнитьИспользуемыеЗначения(НастройкиКомпоновкиДанных.Отбор);
				
		ЭтотОбъект.ИдентификаторСКД = Новый УникальныйИдентификатор;
		ЭтотОбъект.ХешСуммаУсловийОтбора = Справочники.НаборыИнвестиционныхДеклараций.ПолучитьХэшСуммуУсловийОтбора(НастройкиКомпоновкиДанных);
		
		Если Не ЭтотОбъект.ПометкаУдаления И Не ЭтотОбъект.ДополнительныеСвойства.Свойство("ПрограммноеОбновление") Тогда
		
			ДублиНаборов = ПолучитьДублиНаборов();
			Если ДублиНаборов.Количество() > 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Существует набор с аналогичными условиями: " + ДублиНаборов[0], ДублиНаборов[0],,, Отказ); 
				Возврат;
			КонецЕсли; 		
		
		КонецЕсли; 
		
		Если Не ЭтотОбъект.Ссылка.Пустая() И РедактированиеЗапрещено() Тогда
			ЭтотОбъект.ДополнительныеСвойства.Вставить("ВерсияПередЗаписью", ПолучитьВерсиюОбъекта());
		КонецЕсли;		
	
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьВерсиюОбъекта() Экспорт

	ВерсияОбъекта = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НаборыИнвестиционныхДеклараций.ПометкаУдаления КАК ПометкаУдаления,
		|	НаборыИнвестиционныхДеклараций.НаборДанных КАК НаборДанных,
		|	НаборыИнвестиционныхДеклараций.УсловияОтбора КАК УсловияОтбора
		|ИЗ
		|	Справочник.НаборыИнвестиционныхДеклараций КАК НаборыИнвестиционныхДеклараций
		|ГДЕ
		|	НаборыИнвестиционныхДеклараций.Ссылка = &Ссылка";
	
	Реквизиты = Запрос.Выполнить().Выгрузить();
	Реквизиты.Колонки.Добавить("Отбор", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	
	Отбор = Реквизиты[0].УсловияОтбора.Получить();
	ОтборХМЛ = "";
	Если ТипЗнч(Отбор) = Тип("НастройкиКомпоновкиДанных") Тогда
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку();
		СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Отбор, "Settings", "http://v8.1c.ru/8.1/data-composition-system/settings");
		
		ХешированиеДанных = Новый ХешированиеДанных(ХешФункция.MD5);
		ХешированиеДанных.Добавить(ЗаписьXML.Закрыть());
		
		ОтборХМЛ = ХешированиеДанных.ХешСумма;
		
	КонецЕсли;
	
	Реквизиты[0].Отбор = ОтборХМЛ;
	Реквизиты.Колонки.Удалить("УсловияОтбора");
	
	ВерсияОбъекта.Вставить("Реквизиты", Реквизиты);
	
	Возврат ВерсияОбъекта;

КонецФункции

Функция ПолучитьДублиНаборов()

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НаборыИнвестиционныхДеклараций.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.НаборыИнвестиционныхДеклараций КАК НаборыИнвестиционныхДеклараций
		|ГДЕ
		|	НаборыИнвестиционныхДеклараций.ХешСуммаУсловийОтбора = &ХешСуммаУсловийОтбора
		|	И НаборыИнвестиционныхДеклараций.Ссылка <> &Ссылка
		|	И НЕ НаборыИнвестиционныхДеклараций.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	НаборыИнвестиционныхДеклараций.Наименование";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ХешСуммаУсловийОтбора", ЭтотОбъект.ХешСуммаУсловийОтбора);
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	Результат = Запрос.Выполнить();
	ДублиНаборов = Результат.Выгрузить().ВыгрузитьКолонку(0);
	
	Возврат ДублиНаборов;

КонецФункции

Процедура ЗаполнитьИспользуемыеЗначения(Отбор)

	ТипЛюбаяСсылка = Метаданные().ТабличныеЧасти.ИспользуемыеЗначения.Реквизиты.Значение.Тип;
	
	Для каждого ЭлементОтбора Из Отбор.Элементы Цикл
	
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			
			ЗаполнитьИспользуемыеЗначения(ЭлементОтбора);
						 		
		Иначе
			
			Если ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("СписокЗначений") Тогда
			
				Для каждого ЭлементСписка Из ЭлементОтбора.ПравоеЗначение Цикл
				
					ПроверитьЗначениеДобавитьВИспользуемыеСсылки(ЭлементСписка.Значение, ТипЛюбаяСсылка);
				
				КонецЦикла; 
				
			Иначе
				
				ПроверитьЗначениеДобавитьВИспользуемыеСсылки(ЭлементОтбора.ПравоеЗначение, ТипЛюбаяСсылка);
			
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЦикла; 

КонецПроцедуры 

Процедура ПроверитьЗначениеДобавитьВИспользуемыеСсылки(Значение, ТипЛюбаяСсылка)

	Если ЗначениеЗаполнено(Значение) И ТипЛюбаяСсылка.СодержитТип(ТипЗнч(Значение)) И ЭтотОбъект.ИспользуемыеЗначения.Найти(Значение, "Значение") = Неопределено Тогда
	
		НоваяСтрока = ЭтотОбъект.ИспользуемыеЗначения.Добавить();
		НоваяСтрока.Значение = Значение;
	
	КонецЕсли; 

КонецПроцедуры 