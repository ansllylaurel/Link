Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля.Добавить("ВидДокумента");
	Поля.Добавить("Серия");
	Поля.Добавить("Номер");
	Поля.Добавить("ДатаВыдачи");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	Представление = СтрШаблон("%1, %2 от %3",
		Данные.ВидДокумента,
		?(ПустаяСтрока(Данные.Серия), СтрШаблон("№ %1", Данные.Номер), СтрШаблон("%1 № %2", Данные.Серия, Данные.Номер)),
		Формат(Данные.ДатаВыдачи, "ДФ=dd.MM.yyyy"));
	
КонецПроцедуры