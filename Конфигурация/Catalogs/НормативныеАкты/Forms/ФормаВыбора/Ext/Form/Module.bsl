
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ОбластьПрименения") Тогда
		
		ГруппаОбластьПрименения = Список.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаОбластьПрименения.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		
		ОтборРодитель = ГруппаОбластьПрименения.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборРодитель.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Родитель.ОбластьПрименения");
		ОтборРодитель.ПравоеЗначение 	= Параметры.ОбластьПрименения;
		
		ОтборЭлемент = ГруппаОбластьПрименения.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемент.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ОбластьПрименения");
		ОтборЭлемент.ПравоеЗначение = Параметры.ОбластьПрименения;
		
	КонецЕсли; 
	
	Если Параметры.Свойство("Дата") Тогда
	
		ОтборДатаНачала = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборДатаНачала.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ДатаНачала");
		ОтборДатаНачала.ВидСравнения	= ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
		ОтборДатаНачала.ПравоеЗначение 	= Параметры.Дата;
		
		ГруппаДатаОкончания = Список.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаДатаОкончания.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		
		ОтборДатаОкончания = ГруппаДатаОкончания.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборДатаОкончания.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ДатаОкончания");
		ОтборДатаОкончания.ВидСравнения		= ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
		ОтборДатаОкончания.ПравоеЗначение 	= Параметры.Дата;
		
		ОтборДатаОкончания = ГруппаДатаОкончания.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборДатаОкончания.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ДатаОкончания");
		ОтборДатаОкончания.ВидСравнения		= ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
	КонецЕсли; 
	
КонецПроцедуры
