
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТКА СОБЫТИЙ ФОРМЫ

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// определим значения по умолчанию
	ЭтаФорма.НаДату        = ЭтаФорма.ВыбраннаяДата;
	ЭтаФорма.ВариантВыбора = 1;
	
	// добавим к представленю 1-го значения переключателя выбранную дату
	ЭтаФорма.Элементы.ВариантВыбора.СписокВыбора[0].Представление = "На выбранную дату (" + Формат(ЭтаФорма.ВыбраннаяДата, "ДФ=dd.MM.yyyy") + ")";
	ЭтаФорма.Элементы.ВариантВыбора.СписокВыбора[1].Представление = "На текущую дату (" + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") + ")";
	
	ВариантПриИзменении(Неопределено);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТКА СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ВариантПриИзменении(Элемент)
	
	Если      ЭтаФорма.ВариантВыбора = 1 Тогда
		ЭтаФорма.НаДату = ЭтаФорма.ВыбраннаяДата;
		ЭтаФорма.Элементы.НаДату.Доступность = Ложь;
		
	ИначеЕсли ЭтаФорма.ВариантВыбора = 2 Тогда
		ЭтаФорма.НаДату = ТекущаяДата();
		ЭтаФорма.Элементы.НаДату.Доступность = Ложь;
		
	ИначеЕсли ЭтаФорма.ВариантВыбора = 3 Тогда
		ЭтаФорма.Элементы.НаДату.Доступность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// КОМАНДЫ

&НаКлиенте
Процедура КомандаЗакрытьБезСохранения(Команда)
	
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСохранитьНаДату(Команда)
	
	ЭтаФорма.Закрыть(ЭтаФорма.НаДату);
	
КонецПроцедуры
