
// ДК в договоре не должна отличаться от ДК в депозитарном счете
&НаСервереБезКонтекста
Функция ДепозитарийИзменен(ДепозитарныйДоговор, Контрагент)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДоговорыДепозитарногоОбслуживания.Ссылка,
		|	ДоговорыДепозитарногоОбслуживания.Контрагент
		|ИЗ
		|	Справочник.ДоговорыДепозитарногоОбслуживания КАК ДоговорыДепозитарногоОбслуживания
		|ГДЕ
		|	ДоговорыДепозитарногоОбслуживания.Ссылка = &ДепозитарныйДоговор
		|	И ДоговорыДепозитарногоОбслуживания.Контрагент <> &Контрагент
		|	И ДоговорыДепозитарногоОбслуживания.Контрагент <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)";
		
	Запрос.УстановитьПараметр("ДепозитарныйДоговор"	, ДепозитарныйДоговор);	
	Запрос.УстановитьПараметр("Контрагент"			, Контрагент);
		
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат Неопределено;	
	КонецЕсли; 
	
	СписокСчетов = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитарныеСчета.Ссылка КАК Ссылка,
		|	ДепозитарныеСчета.Депозитарий
		|ИЗ
		|	Справочник.ДепозитарныеСчета КАК ДепозитарныеСчета
		|ГДЕ
		|	ДепозитарныеСчета.Договор = &ДепозитарныйДоговор";
	
	Запрос.УстановитьПараметр("ДепозитарныйДоговор", ДепозитарныйДоговор);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Количество() <> 0 Тогда
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СписокСчетов = СписокСчетов + ?(ПустаяСтрока(СписокСчетов), "", Символы.ПС) + ВыборкаДетальныеЗаписи.Ссылка;
		КонецЦикла;
		Возврат СписокСчетов;		
	Иначе
		Возврат Неопределено;
	КонецЕсли; 
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьНадписьДепозитария(Форма, ЭтоРегистратор)
	
	Элементы = Форма.Элементы;
	Элементы.Контрагент.Заголовок = ?(ЭтоРегистратор, "Регистратор", "Депозитарий");
		
КонецПроцедуры // УстановитьНадписьВладельца

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступность(Форма, ЭтоРегистратор)
	
	ДанныеОбъекта = Форма.Объект;
	Элементы = Форма.Элементы;	
	Элементы.ОтветственноеХранение.Видимость = Не ЭтоРегистратор;
	
	Элементы.ДатаРасторжения.Видимость			= ЗначениеЗаполнено(Форма.ДатаРасторжения);
	Элементы.КомандаЗакрытьДоговор.Видимость	= НЕ ЗначениеЗаполнено(Форма.ДатаРасторжения);
	
	Если ДанныеОбъекта.Ссылка.Пустая() Тогда
		Элементы.СтраницаСвязанныеСчетаВУ.Видимость = Ложь;
		Элементы.ГруппаСвязатьСоСчетомДУ.Видимость = Истина;
		Элементы.СчетДоверительногоУправления.Доступность = Форма.СвязатьСоСчетомДУ;
		
	Иначе
		Элементы.ГруппаСвязатьСоСчетомДУ.Видимость = Ложь;
		Элементы.СтраницаСвязанныеСчетаВУ.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры // НастроитьВидимостьДоступность

&НаКлиентеНаСервереБезКонтекста
Процедура СкорректироватьЗаголовокФормы(Форма, ЭтоРегистратор)
			
	ТекущийЗаголовок = Форма.Заголовок;
	ПозицияДвоеточия = СтрНайти(ТекущийЗаголовок, ":");
	
	Если ПозицияДвоеточия > 0 Тогда
		НачалоЗаголовка      = Лев(ТекущийЗаголовок, ПозицияДвоеточия);
		НовоеНачалоЗаголовка = ?(ЭтоРегистратор, "Договор ведения реестра:", "Договор депозитарного обслуживания:");
		Форма.Заголовок      = СтрЗаменить(ТекущийЗаголовок, НачалоЗаголовка, НовоеНачалоЗаголовка);
	КонецЕсли;		
	
КонецПроцедуры // СкорректироватьЗаголовокФормы

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	ДанныеОбъекта  = ЭтаФорма.Объект;
	
	ЭтоРегистратор = ПолучитьЭтоРегистратор(ДанныеОбъекта.Контрагент);
	
	ЭтаФорма.ДатаРасторжения = РаботаСНормативноСправочнойИнформацией.ПолучитьРеквизитыДоговора(Объект.Ссылка, "ДатаРасторжения").ДатаРасторжения;
	
	НастроитьВидимостьДоступность(ЭтаФорма, ЭтоРегистратор);
	
	УстановитьНадписьДепозитария(ЭтаФорма, ЭтоРегистратор);
	
	СкорректироватьЗаголовокФормы(ЭтаФорма, ЭтоРегистратор);
	
КонецПроцедуры // ПриЧтенииСозданииНаСервере

&НаСервереБезКонтекста
Функция ПолучитьЭтоРегистратор(ЮрФизЛицо)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитарныеКомпании.Регистратор КАК Регистратор
		|ИЗ
		|	Справочник.ДепозитарныеКомпании КАК ДепозитарныеКомпании
		|ГДЕ
		|	ДепозитарныеКомпании.ЮрФизЛицо = &ЮрФизЛицо";
	
	Запрос.УстановитьПараметр("ЮрФизЛицо", ЮрФизЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Следующий() И Выборка.Регистратор;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Новые договоры депозитарного обслуживания заводятся в справочнике Договоры",,,, Отказ);
		Возврат;
	КонецЕсли;
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	// Настройки нового договора
	Если Объект.Ссылка.Пустая() Тогда
		
		ДополнительныеПараметрыСоздания = Новый Структура("ДатаЗаключения, ДатаРасторжения, СчетДоверительногоУправления");
		
		ЗаполнитьЗначенияСвойств(ДополнительныеПараметрыСоздания, Параметры.ДополнительныеПараметры);
		ЗаполнитьЗначенияСвойств(ДополнительныеПараметрыСоздания, Параметры.ЗначенияЗаполнения);
		
		ЗаполнитьЗначенияСвойств(ЭтаФорма,	ДополнительныеПараметрыСоздания, "ДатаРасторжения, СчетДоверительногоУправления");
		ЗаполнитьЗначенияСвойств(Объект,	ДополнительныеПараметрыСоздания, "ДатаЗаключения");
		
		ЭтаФорма.СвязатьСоСчетомДУ = Истина;
		
	КонецЕсли;
	
	УстановитьОтборыПоВедомымРегистрам(ЭтаФорма);	
	
	ПриЧтенииСозданииНаСервере();

КонецПроцедуры // ПриСозданииНаСервере

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	СписокСчетовКИзменению = ДепозитарийИзменен(Объект.Ссылка, Объект.Контрагент);
	
	Если СписокСчетовКИзменению <> Неопределено Тогда
		Если Вопрос("При смене депозитарной компании в договоре будет изменена депозитарная компания в счетах:" + Символы.ПС + СписокСчетовКИзменению, РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
			Отказ = Истина;
		КонецЕсли; 
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЭтоРегистратор = ПолучитьЭтоРегистратор(Объект.Контрагент);
	
	НастроитьВидимостьДоступность(ЭтаФорма, ЭтоРегистратор);	
	
	УстановитьОтборыПоВедомымРегистрам(ЭтаФорма);	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборыПоВедомымРегистрам(Форма)

	Объект = Форма.Объект;
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.УсловияДоговоровОбщие.Отбор, "Договор",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.УсловияДоговоровДепозитарногоОбслуживания.Отбор, "Договор",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.ДоговорыСчетовДоверительногоУправления.Отбор, "Организация",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Организация, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.ДоговорыСчетовДоверительногоУправления.Отбор, "Договор",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтаФорма.СвязатьСоСчетомДУ Тогда
		ПроверяемыеРеквизиты.Добавить("СчетДоверительногоУправления");	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ТекущийОбъект.ЭтоНовый() И ЭтаФорма.СвязатьСоСчетомДУ Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ДоговорСчетаДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления);		
	КонецЕсли;
	
	Если ТекущийОбъект.ЭтоНовый() И ЗначениеЗаполнено(ЭтаФорма.ДатаРасторжения) Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ДатаРасторжения", ЭтаФорма.ДатаРасторжения);		
	КонецЕсли;
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ РЕКВИЗИТОВ ФОРМЫ

&НаКлиенте
Процедура ОтветственноеХранениеПриИзменении(Элемент)
	
	РаботаСНормативноСправочнойИнформациейКлиент.УстановитьНовоеНаименование(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура НомерДоговораПриИзменении(Элемент)
	
	РаботаСНормативноСправочнойИнформациейКлиент.УстановитьНовоеНаименование(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДепозитарийПриИзменении(Элемент)
		
	ЭтоРегистратор = ПолучитьЭтоРегистратор(Объект.Контрагент);
	
	Если ЭтоРегистратор И ЭтаФорма.Объект.ОтветственноеХранение Тогда
		ЭтаФорма.Объект.ОтветственноеХранение = Ложь;
	КонецЕсли;
	
	РаботаСНормативноСправочнойИнформациейКлиент.УстановитьНовоеНаименование(Объект);
	
	НастроитьВидимостьДоступность(ЭтаФорма, ЭтоРегистратор);
	
	УстановитьНадписьДепозитария(ЭтаФорма, ЭтоРегистратор);   
	
	СкорректироватьЗаголовокФормы(ЭтаФорма, ЭтоРегистратор);

КонецПроцедуры

&НаКлиенте
Процедура ДатаЗаключенияПриИзменении(Элемент)
	
	РаботаСНормативноСправочнойИнформациейКлиент.УстановитьНовоеНаименование(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура СвязатьСоСчетомДУПриИзменении(Элемент)
	
	ЭтоРегистратор = ПолучитьЭтоРегистратор(Объект.Контрагент);
	
	НастроитьВидимостьДоступность(ЭтаФорма, ЭтоРегистратор);

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// КОМАНДЫ ФОРМЫ

&НаКлиенте
Процедура КомандаЗакрытьДоговор(Команда)

	Если ЭтаФорма.Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		Если Вопрос("Перед закрытием договора необходимо сохранить внесенные изменения. Сохранить?", РежимДиалогаВопрос.ОКОтмена) <> КодВозвратаДиалога.ОК Тогда
			Возврат;
		КонецЕсли;
		
		Если Не РаботаСФормамиКлиентСервер.ЗаписатьФорму(ЭтаФорма) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	АдресДереваДочернихЭлементов = РаботаСИсполнителями.ПолучитьДочерниеЭлементы(Объект.Ссылка, , "ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)", , ЭтаФорма.УникальныйИдентификатор);
	Если ЗначениеЗаполнено(АдресДереваДочернихЭлементов) Тогда
		ДополнительныеРеквизиты = Новый Массив;
		ДополнительныеРеквизиты.Добавить(Новый Структура("Имя, ТипЗначения, Заголовок, Значение", "ДатаЗакрытия", Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.Дата)), "Дата расторжения", ТекущаяДата()));
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("РежимВыбора",					Истина);
		ДополнительныеПараметры.Вставить("МножественныйВыбор",			Истина);
		ДополнительныеПараметры.Вставить("ВидимыеКолонки",				"Представление");
		ДополнительныеПараметры.Вставить("ОтмеченныеЭлементы",			Новый Структура("Элемент", Объект.Ссылка));
		ДополнительныеПараметры.Вставить("ДополнительныеРеквизиты",		ДополнительныеРеквизиты);
		ДополнительныеПараметры.Вставить("ПутьКДаннымКартинкиСтроки",	"ДеревоЗначений.ДанныеКартинки");
		ДополнительныеПараметры.Вставить("КартинкаСтрок",				БиблиотекаКартинок.РегистрСведенийЗапись);
		
		РезультатВопроса = РаботаСФормамиКлиент.ПоказатьДеревоЗначений(АдресДереваДочернихЭлементов, "При расторжении договора будут закрыты дочерние элементы:", ЭтаФорма, РежимДиалогаВопрос.ОКОтмена, КодВозвратаДиалога.ОК, "Закрытие договора", ДополнительныеПараметры);
		Если РезультатВопроса <> КодВозвратаДиалога.ОК Тогда
			Возврат;
		КонецЕсли;
		
		РаботаСИсполнителями.ЗакрытьДеревоЭлементов(ДополнительныеПараметры.АдресДереваЗначений, ДополнительныеПараметры.ДополнительныеРеквизиты.ДатаЗакрытия);
		
		ЭтотОбъект.Прочитать();
	КонецЕсли;	
	
КонецПроцедуры



