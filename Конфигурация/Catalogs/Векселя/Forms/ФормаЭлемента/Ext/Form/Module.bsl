
&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступность(Форма)
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
	Элементы.ГруппаПроценты.Видимость = (Объект.ТипВекселя = ПредопределенноеЗначение("Перечисление.ТипыВекселей.Процентный"));
	
	Если      Объект.ВариантПогашения = ПредопределенноеЗначение("Перечисление.ВариантыПогашенияВекселей.НаДату") Тогда
		Элементы.ДатаПогашения.Видимость     = Истина;
		Элементы.ДатаПогашения.Доступность   = Истина;
		Элементы.ДнейДоПогашения.Видимость   = Ложь;
		Элементы.ПогаситьНеПозднее.Видимость = Ложь;
		
	ИначеЕсли Объект.ВариантПогашения = ПредопределенноеЗначение("Перечисление.ВариантыПогашенияВекселей.ПоПредъявлении") Тогда
		Элементы.ДатаПогашения.Видимость     = Ложь;
		Элементы.ДатаПогашения.Доступность   = Ложь;
		Элементы.ДнейДоПогашения.Видимость   = Ложь;
		Элементы.ПогаситьНеПозднее.Видимость = Ложь;
		
	ИначеЕсли Объект.ВариантПогашения = ПредопределенноеЗначение("Перечисление.ВариантыПогашенияВекселей.ПоПредъявленииНоНеРанее") Тогда
		Элементы.ДатаПогашения.Видимость     = Истина;
		Элементы.ДатаПогашения.Доступность   = Истина;
		Элементы.ДнейДоПогашения.Видимость   = Ложь;
		Элементы.ПогаситьНеПозднее.Видимость = Ложь;
		
	ИначеЕсли Объект.ВариантПогашения = ПредопределенноеЗначение("Перечисление.ВариантыПогашенияВекселей.ПоПредъявленииНоНеПозднее") Тогда
		Элементы.ДатаПогашения.Видимость     = Истина;
		Элементы.ДатаПогашения.Доступность   = Истина;
		Элементы.ДнейДоПогашения.Видимость   = Ложь;
		Элементы.ПогаситьНеПозднее.Видимость = Истина;
		
	ИначеЕсли Объект.ВариантПогашения = ПредопределенноеЗначение("Перечисление.ВариантыПогашенияВекселей.ЧерезNДнейОтДатыСоставления") Тогда
		Элементы.ДатаПогашения.Видимость     = Истина;
		Элементы.ДатаПогашения.Доступность   = Ложь;
		Элементы.ДнейДоПогашения.Видимость   = Истина;
		Элементы.ПогаситьНеПозднее.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры // НастроитьВидимостьДоступность

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
	УниверсальныеМеханизмы.УстановитьЗаголовокСсылкиОбновить(ЭтаФорма, Объект.Ссылка);
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
КонецПроцедуры // ПриЧтенииСозданииНаСервере

&НаКлиенте
Функция РассчитатьДатуПогашения()
	
	Объект.ДатаПогашения = Объект.ДатаСоставления + Объект.ДнейДоПогашения;
	
КонецФункции // РассчитатьДатуПогашения

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТКА СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();

	УстановитьОтборыПоВедомымРегистрам(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;	

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТКА СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ТипВекселяПриИзменении(Элемент)
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантПогашенияПриИзменении(Элемент)
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаСоставленияПриИзменении(Элемент)
	
	РассчитатьДатуПогашения();
	
КонецПроцедуры

&НаКлиенте
Процедура ДнейДоПогашенияПриИзменении(Элемент)
	
	РассчитатьДатуПогашения();
	
КонецПроцедуры

&НаКлиенте
Процедура СсылкаОбновитьНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Вопрос("Обновить текущий элемент?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		РаботаСВнешнимиСистемами.ОбновитьРеквизитыОбъектаИзМатрикс(Объект.Ссылка);
		
		ЭтаФорма.Прочитать();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборыПоВедомымРегистрам(Форма)
	
	Объект = Форма.Объект;
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(Форма.УсловияРасчетаПроцентовВекселей.Отбор, "Вексель",,
		ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);

КонецПроцедуры