
Функция ПолучитьПроцентГодовых(Вексель, Период) Экспорт
	
	Если Вексель.ТипВекселя <> Перечисления.ТипыВекселей.Процентный Тогда
		ВызватьИсключение "Получение процента годовых предусмотрено только для процентных векселей";
	КонецЕсли;
	
	ПроцентГодовых = 0;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Вексель", Вексель);
	Запрос.УстановитьПараметр("Период",  Период);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Векселя.ПроцентГодовых КАК ПроцентГодовых,
		|	УсловияРасчетаПроцентовВекселейСрезПоследних.НастройкаРасчета КАК НастройкаРасчета
		|ИЗ
		|	Справочник.Векселя КАК Векселя
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияРасчетаПроцентовВекселей.СрезПоследних(&Период, Вексель = &Вексель) КАК УсловияРасчетаПроцентовВекселейСрезПоследних
		|		ПО Векселя.Ссылка = УсловияРасчетаПроцентовВекселейСрезПоследних.Вексель
		|ГДЕ
		|	Векселя.Ссылка = &Вексель";
	
	ДанныеВекселя = Запрос.Выполнить().Выбрать();
	ДанныеВекселя.Следующий();
	
	Если НЕ ЗначениеЗаполнено(ДанныеВекселя.НастройкаРасчета) И НЕ ЗначениеЗаполнено(ДанныеВекселя.ПроцентГодовых) Тогда
		ВызватьИсключение СтрШаблон("Для векселя %1 не указан процент годовых и не заданы условия расчёта процента", Вексель);
		
	ИначеЕсли ЗначениеЗаполнено(ДанныеВекселя.НастройкаРасчета) И ЗначениеЗаполнено(ДанныеВекселя.ПроцентГодовых) Тогда
		ВызватьИсключение СтрШаблон("Для векселя %1 указан процент годовых и заданы условия расчёта процента. Нет возможности однозначно определить процент по векселю.", Вексель);
		
	ИначеЕсли ЗначениеЗаполнено(ДанныеВекселя.ПроцентГодовых) Тогда 
		ПроцентГодовых = ДанныеВекселя.ПроцентГодовых;
		
	Иначе
		ПроцентГодовых = Справочники.НастройкиРасчета.Рассчитать(ДанныеВекселя.НастройкаРасчета, Новый Структура("Период", Период));
		
	КонецЕсли;
	
	Возврат ПроцентГодовых;
	
КонецФункции