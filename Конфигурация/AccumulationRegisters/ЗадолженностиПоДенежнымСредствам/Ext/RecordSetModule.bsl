
Процедура ПередЗаписью(Отказ, Замещение)
	
	ЭтоКорректировка = ТипЗнч(ЭтотОбъект.Отбор.Регистратор.Значение) = Тип("ДокументСсылка.КорректировкаРегистров");	
	ГруппаУстаревшие = Справочники.ВидыЗадолженности.Устаревшие;	
	Сч = 1;
	
	Для Каждого Запись Из ЭтотОбъект Цикл
		
		// У корректировок сначала проверяем заполнение вида задолженности
		ВидЗадолженностиЗаполнен = Истина;
		Если ЭтоКорректировка И Не ЗначениеЗаполнено(Запись.ВидЗадолженности) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В строке %1 не указан вид задолженности", Формат(Сч, "ЧГ=0")),,,, Отказ);			
			ВидЗадолженностиЗаполнен = Ложь;
		КонецЕсли;      		
				
		Если ВидЗадолженностиЗаполнен И Запись.Период >= Дата(2017,1,1) И Запись.ВидЗадолженности.ПринадлежитЭлементу(ГруппаУстаревшие) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В строке %1 использован устаревший вид задолженности. Необходимо указать другой", Формат(Сч, "ЧГ=0")),,,, Отказ);
		КонецЕсли;
		
		Сч = Сч + 1;
		
	КонецЦикла;
	
КонецПроцедуры
