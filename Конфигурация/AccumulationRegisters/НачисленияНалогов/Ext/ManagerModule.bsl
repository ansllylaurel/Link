Процедура ПроверитьУдержаниеНалогаПоДоходу(ДокументСсылка, Отказ) Экспорт
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.Оплата")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.РаспределениеДоходаПайщикам") Тогда
		//Пока проверка только для дохода пайщику.
		//Проверяем что выплачиваемый доход подвергся налогообложению.
		//Основание дохода пайщика всегда "корень" цепочки документов РаспределениеДоходаПайщикам,
		//	а основание налога - документы РаспределениеДоходаПайщикам, подчиненные "корню", или сам "корень"
		
		//отработана проверка:
		//	1. для оплаты: при выплате дохода
		//	2. для распределения доходов: при начислении НДФЛ
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ЗадолженностиПоДенежнымСредствам.Организация КАК Организация,
			|	ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ЗадолженностиПоДенежнымСредствам.Основание КАК Основание,
			|	ЗадолженностиПоДенежнымСредствам.Контрагент КАК Контрагент
			|ПОМЕСТИТЬ _ПоДокументу
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
			|		ПО ЗадолженностиПоДенежнымСредствам.Контрагент = ЮрФизЛица.Ссылка
			|ГДЕ
			|	ТИПЗНАЧЕНИЯ(&Регистратор) = ТИП(Документ.Оплата)
			|	И ЗадолженностиПоДенежнымСредствам.Регистратор = &Регистратор
			|	И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасчетыСПайщикамиПоВыплатеДоходаПоИнвестиционнымПаям)
			|	И ЗадолженностиПоДенежнымСредствам.Основание ССЫЛКА Документ.РаспределениеДоходаПайщикам
			|	И ЮрФизЛица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	РаспределениеДоходаПайщикамНачислениеНДФЛ.Ссылка.Организация,
			|	РаспределениеДоходаПайщикамНачислениеНДФЛ.Ссылка.СчетДоверительногоУправления,
			|	ВЫБОР
			|		КОГДА РаспределениеДоходаПайщикамНачислениеНДФЛ.Ссылка.Основание = ЗНАЧЕНИЕ(Документ.РаспределениеДоходаПайщикам.ПустаяСсылка)
			|			ТОГДА РаспределениеДоходаПайщикамНачислениеНДФЛ.Ссылка
			|		ИНАЧЕ РаспределениеДоходаПайщикамНачислениеНДФЛ.Ссылка.Основание
			|	КОНЕЦ,
			|	РаспределениеДоходаПайщикамНачислениеНДФЛ.ПолучательДохода
			|ИЗ
			|	Документ.РаспределениеДоходаПайщикам.НачислениеНДФЛ КАК РаспределениеДоходаПайщикамНачислениеНДФЛ
			|ГДЕ
			|	РаспределениеДоходаПайщикамНачислениеНДФЛ.Ссылка = &Регистратор
			|	И РаспределениеДоходаПайщикамНачислениеНДФЛ.СуммаНДФЛ <> 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ПоДокументу.Организация КАК Организация,
			|	_ПоДокументу.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ПоДокументу.Контрагент КАК Контрагент,
			|	_ПоДокументу.Основание КАК Основание
			|ПОМЕСТИТЬ _ВозможныеОснованияНалога
			|ИЗ
			|	_ПоДокументу КАК _ПоДокументу
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_ПоДокументу.Организация,
			|	_ПоДокументу.СчетДоверительногоУправления,
			|	_ПоДокументу.Контрагент,
			|	РаспределениеДоходаПайщикамНачислениеНДФЛ.Ссылка
			|ИЗ
			|	_ПоДокументу КАК _ПоДокументу
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РаспределениеДоходаПайщикам.НачислениеНДФЛ КАК РаспределениеДоходаПайщикамНачислениеНДФЛ
			|		ПО _ПоДокументу.Организация = РаспределениеДоходаПайщикамНачислениеНДФЛ.Ссылка.Организация
			|			И _ПоДокументу.СчетДоверительногоУправления = РаспределениеДоходаПайщикамНачислениеНДФЛ.Ссылка.СчетДоверительногоУправления
			|			И _ПоДокументу.Контрагент = РаспределениеДоходаПайщикамНачислениеНДФЛ.ПолучательДохода
			|			И _ПоДокументу.Основание = РаспределениеДоходаПайщикамНачислениеНДФЛ.Ссылка.Основание
			|			И (РаспределениеДоходаПайщикамНачислениеНДФЛ.Ссылка.Дата <= &Дата)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НачисленияНалоговОбороты.Организация КАК Организация,
			|	НачисленияНалоговОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ВЫБОР
			|		КОГДА НачисленияНалоговОбороты.Основание.Основание = ЗНАЧЕНИЕ(Документ.РаспределениеДоходаПайщикам.ПустаяСсылка)
			|			ТОГДА НачисленияНалоговОбороты.Основание
			|		ИНАЧЕ НачисленияНалоговОбороты.Основание.Основание
			|	КОНЕЦ КАК Основание,
			|	НачисленияНалоговОбороты.Налогоплательщик КАК Налогоплательщик,
			|	СУММА(НачисленияНалоговОбороты.СуммаОборот) КАК СуммаОборот,
			|	СУММА(НачисленияНалоговОбороты.БазаНалогаОборот) КАК БазаНалогаОборот
			|ПОМЕСТИТЬ _НачисленияНалога
			|ИЗ
			|	РегистрНакопления.НачисленияНалогов.Обороты(
			|			,
			|			&МоментДокумента,
			|			,
			|			(Организация, СчетДоверительногоУправления, Налогоплательщик, Основание) В
			|					(ВЫБРАТЬ
			|						_ВозможныеОснованияНалога.Организация КАК Организация,
			|						_ВозможныеОснованияНалога.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|						_ВозможныеОснованияНалога.Контрагент КАК Контрагент,
			|						_ВозможныеОснованияНалога.Основание КАК Основание
			|					ИЗ
			|						_ВозможныеОснованияНалога КАК _ВозможныеОснованияНалога)
			|				И ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НДФЛ))) КАК НачисленияНалоговОбороты
			|
			|СГРУППИРОВАТЬ ПО
			|	НачисленияНалоговОбороты.Организация,
			|	НачисленияНалоговОбороты.СчетДоверительногоУправления,
			|	ВЫБОР
			|		КОГДА НачисленияНалоговОбороты.Основание.Основание = ЗНАЧЕНИЕ(Документ.РаспределениеДоходаПайщикам.ПустаяСсылка)
			|			ТОГДА НачисленияНалоговОбороты.Основание
			|		ИНАЧЕ НачисленияНалоговОбороты.Основание.Основание
			|	КОНЕЦ,
			|	НачисленияНалоговОбороты.Налогоплательщик
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДоходПоОснованию.Контрагент КАК Контрагент,
			|	ДоходПоОснованию.Основание КАК Основание,
			|	ДоходПоОснованию.СуммаПриход КАК ДоходНачислен,
			|	ДоходПоОснованию.СуммаРасход КАК ДоходВыплачен,
			|	ЕСТЬNULL(НачисленияНалоговОбороты.БазаНалогаОборот, 0) КАК ДоходПоКоторомуУдержанНалог,
			|	ДоходПоОснованию.Контрагент.Представление КАК КонтрагентПредставление,
			|	ДоходПоОснованию.СуммаРасход > ЕСТЬNULL(НачисленияНалоговОбороты.БазаНалогаОборот, 0) КАК ВыплаченДоходБезУдержанияНалога,
			|	ДоходПоОснованию.СуммаПриход < ЕСТЬNULL(НачисленияНалоговОбороты.БазаНалогаОборот, 0) КАК УдержанИзлишнийНалог
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
			|			,
			|			&МоментДокумента,
			|			,
			|			(Организация, СчетДоверительногоУправления, Основание, Контрагент) В
			|				(ВЫБРАТЬ
			|					_ПоДокументу.Организация КАК Организация,
			|					_ПоДокументу.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|					_ПоДокументу.Основание КАК Основание,
			|					_ПоДокументу.Контрагент КАК Контрагент
			|				ИЗ
			|					_ПоДокументу КАК _ПоДокументу)) КАК ДоходПоОснованию
			|		ЛЕВОЕ СОЕДИНЕНИЕ _НачисленияНалога КАК НачисленияНалоговОбороты
			|		ПО ДоходПоОснованию.Организация = НачисленияНалоговОбороты.Организация
			|			И ДоходПоОснованию.СчетДоверительногоУправления = НачисленияНалоговОбороты.СчетДоверительногоУправления
			|			И ДоходПоОснованию.Основание = НачисленияНалоговОбороты.Основание
			|			И ДоходПоОснованию.Контрагент = НачисленияНалоговОбороты.Налогоплательщик
			|ГДЕ
			|	(ДоходПоОснованию.СуммаРасход > ЕСТЬNULL(НачисленияНалоговОбороты.БазаНалогаОборот, 0)
			|			ИЛИ ДоходПоОснованию.СуммаПриход < ЕСТЬNULL(НачисленияНалоговОбороты.БазаНалогаОборот, 0))";
		
		Запрос.УстановитьПараметр("Регистратор", ДокументСсылка);
		Запрос.УстановитьПараметр("Дата", ДокументСсылка.Дата);
		Запрос.УстановитьПараметр("МоментДокумента", Новый Граница(ДокументСсылка.МоментВремени(), ВидГраницы.Включая));
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ВыборкаДетальныеЗаписи.ВыплаченДоходБезУдержанияНалога Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Физлицу " + ВыборкаДетальныеЗаписи.КонтрагентПредставление 
					+ " выплачен доход, по которому не прошло удержание НДФЛ. Общая сумма выплаченного дохода = "
					+ ВыборкаДетальныеЗаписи.ДоходВыплачен + ", общая база налога = " + ВыборкаДетальныеЗаписи.ДоходПоКоторомуУдержанНалог,
					ДокументСсылка,,, Отказ);
			ИначеЕсли ВыборкаДетальныеЗаписи.УдержанИзлишнийНалог Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По физлицу " + ВыборкаДетальныеЗаписи.КонтрагентПредставление 
					+ " налоговая база превысила сумму начисления. Общая сумма начисленного дохода = "
					+ ВыборкаДетальныеЗаписи.ДоходНачислен + ", общая база налога = " + ВыборкаДетальныеЗаписи.ДоходПоКоторомуУдержанНалог,
					ДокументСсылка,,, Отказ);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСоответствиеНалогаПриОплате(ДокументСсылка, Отказ) Экспорт
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.Оплата") Тогда
		//Пока проверка только для дохода пайщику. Проверка для текущего основания налога.
		//Проверяем соответствие начисленного налога в ЗадолженностиПоДенежнымСредствам и НачисленияНалогов.
		//Справка: Основание дохода пайщика всегда "корень" цепочки документов РаспределениеДоходаПайщикам,
		//	а основание налога - документы РаспределениеДоходаПайщикам, подчиненные "корню", или сам "корень"
		
		//отработана проверка:
		//	1. для оплаты: при выплате налога
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ЗадолженностиПоДенежнымСредствам.Организация КАК Организация,
			|	ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ЗадолженностиПоДенежнымСредствам.Основание КАК Основание
			|ПОМЕСТИТЬ _ПоДокументу
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
			|ГДЕ
			|	ТИПЗНАЧЕНИЯ(&Регистратор) = ТИП(Документ.Оплата)
			|	И ЗадолженностиПоДенежнымСредствам.Регистратор = &Регистратор
			|	И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НДФЛ))
			|	И ЗадолженностиПоДенежнымСредствам.Основание ССЫЛКА Документ.РаспределениеДоходаПайщикам
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	НачисленияНалоговОбороты.Организация КАК Организация,
			|	НачисленияНалоговОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	НачисленияНалоговОбороты.Основание КАК Основание,
			|	НачисленияНалоговОбороты.СуммаОборот КАК СуммаОборот
			|ПОМЕСТИТЬ _НачисленияНалога
			|ИЗ
			|	РегистрНакопления.НачисленияНалогов.Обороты(
			|			,
			|			&МоментДокумента,
			|			,
			|			(Организация, СчетДоверительногоУправления, Основание) В
			|					(ВЫБРАТЬ
			|						_ПоДокументу.Организация КАК Организация,
			|						_ПоДокументу.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|						_ПоДокументу.Основание КАК Основание
			|					ИЗ
			|						_ПоДокументу КАК _ПоДокументу)
			|				И ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НДФЛ))) КАК НачисленияНалоговОбороты
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПриходЗадолженности.Основание КАК Основание,
			|	ПриходЗадолженности.СуммаПриход КАК ЗадолженностьПоНалогуПриход,
			|	НачисленияНалоговОбороты.СуммаОборот КАК НачислениеНалога,
			|	ПриходЗадолженности.Основание.Представление КАК ОснованиеПредставление
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
			|			,
			|			&МоментДокумента,
			|			,
			|			(Организация, СчетДоверительногоУправления, Основание) В
			|					(ВЫБРАТЬ
			|						_ПоДокументу.Организация КАК Организация,
			|						_ПоДокументу.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|						_ПоДокументу.Основание КАК Основание
			|					ИЗ
			|						_ПоДокументу КАК _ПоДокументу)
			|				И ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НДФЛ))) КАК ПриходЗадолженности
			|		ЛЕВОЕ СОЕДИНЕНИЕ _НачисленияНалога КАК НачисленияНалоговОбороты
			|		ПО ПриходЗадолженности.Организация = НачисленияНалоговОбороты.Организация
			|			И ПриходЗадолженности.СчетДоверительногоУправления = НачисленияНалоговОбороты.СчетДоверительногоУправления
			|			И ПриходЗадолженности.Основание = НачисленияНалоговОбороты.Основание
			|ГДЕ
			|	ПриходЗадолженности.СуммаПриход > НачисленияНалоговОбороты.СуммаОборот";
		
		Запрос.УстановитьПараметр("Регистратор", ДокументСсылка);
		Запрос.УстановитьПараметр("Дата", ДокументСсылка.Дата);
		Запрос.УстановитьПараметр("МоментДокумента", Новый Граница(ДокументСсылка.МоментВремени(), ВидГраницы.Включая));
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ВыборкаДетальныеЗаписи.ЗадолженностьПоНалогуПриход > ВыборкаДетальныеЗаписи.НачислениеНалога Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По основанию " + ВыборкаДетальныеЗаписи.ОснованиеПредставление 
					+ " отражена задолженность по налогу, превышающая отраженную сумму начисления. Общая сумма начисленой задоженности = "
					+ ВыборкаДетальныеЗаписи.ЗадолженностьПоНалогуПриход + ", общая сумма налога = " + ВыборкаДетальныеЗаписи.НачислениеНалога,
					ДокументСсылка,,, Отказ);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры
