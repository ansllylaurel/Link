Процедура ОтправкаДанныхВЛККОПогашенииПаевПриВыполнении(ТочкаМаршрутаБизнесПроцесса, Задача, Отказ)

	РегистрыСведений.СтатусыЗаявокПайщиков.УстановитьСтатусЗаявки(
			ЭтотОбъект.Организация,
			ЭтотОбъект.Основание,
			Перечисления.СтатусыЗаявокПайщиков.Исполнена,
			ТекущаяДатаСеанса(),
			Отказ);
			
	Если Отказ Тогда
		//##Обработать ошибку		
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПогашениеПаев.Ссылка КАК Погашение,
		|	ПогашениеПаев.Заявка.НомерЗаявки КАК НомерЗаявки
		|ИЗ
		|	Документ.ПогашениеПаев КАК ПогашениеПаев
		|ГДЕ
		|	ПогашениеПаев.Организация = &Организация
		|	И ПогашениеПаев.Пайщик = &Пайщик
		|	И ПогашениеПаев.Заявка = &Заявка
		|	И ПогашениеПаев.Проведен");
	
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Заявка",			ЭтотОбъект.Основание);
	Запрос.УстановитьПараметр("Пайщик",			ЭтотОбъект.Пайщик);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() <> 1 Тогда
		
		//##Обработать ошибку
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
	Выборка.Следующий();
	
	ОбменСЛКК = Обработки.ОбменДаннымиСЛККЕСИАФинанс.Создать(); 
		
	ОбменСЛКК.Организация	= ЭтотОбъект.Организация;
	ОбменСЛКК.Пиф			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Основание, "ПаевойИнвестиционныйФонд");
	
	ОбменСЛКК.ДополнительныеСвойства.Вставить("Источник", ЭтотОбъект.Ссылка);
					
	// Отправляем данные погашения
	ОбменСЛКК.ВыгрузитьОперацииПоПаям(Выборка.Погашение, Выборка.НомерЗаявки, Отказ);
	
	Если Отказ Тогда
		// ##Обработать ошибку
		Возврат;
	КонецЕсли;
	
	// Меняем статус заявки
	ОбменСЛКК.УстановитьСтатус(ЭтотОбъект.Основание, "done", Отказ);
	
КонецПроцедуры

