Процедура ОтправкаДанныхВЛККОбОбменеПаевПриВыполнении(ТочкаМаршрутаБизнесПроцесса, Задача, Отказ)
	
	// Нужно выгрузить данные по двум ПИФам: на погашение и зачисление паев
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПогашениеПаев.Ссылка КАК Погашение,
		|	ЗачислениеПаев.Ссылка КАК Зачисление,
		|	ПогашениеПаев.Заявка.НомерЗаявки КАК НомерЗаявки
		|ИЗ
		|	Документ.ПогашениеПаев КАК ПогашениеПаев
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗачислениеПаев КАК ЗачислениеПаев
		|		ПО ПогашениеПаев.Организация = ЗачислениеПаев.Организация
		|			И ПогашениеПаев.Заявка = ЗачислениеПаев.Заявка
		|			И ПогашениеПаев.Пайщик = ЗачислениеПаев.Пайщик
		|			И (ЗачислениеПаев.Проведен)
		|ГДЕ
		|	ПогашениеПаев.Организация = &Организация
		|	И ПогашениеПаев.Пайщик = &Пайщик
		|	И ПогашениеПаев.Заявка = &Заявка
		|	И ПогашениеПаев.Проведен");
	
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Заявка",			ЭтотОбъект.Основание);
	Запрос.УстановитьПараметр("Пайщик",			ЭтотОбъект.Пайщик);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
				
		ОбменСЛКК = Обработки.ОбменДаннымиСЛККЕСИАФинанс.Создать(); 
		
		ОбменСЛКК.Организация = ЭтотОбъект.Организация;
		
		ОбменСЛКК.ДополнительныеСвойства.Вставить("Источник", ЭтотОбъект.Ссылка);
		
		// Погашение
		ОбменСЛКК.ВыгрузитьОперацииПоПаям(Выборка.Погашение, Выборка.НомерЗаявки, Отказ);
		
		Если Отказ Тогда
			// ##Оповещение
			Возврат;
		КонецЕсли;
		
		// Зачисление
		ОбменСЛКК.ВыгрузитьОперацииПоПаям(Выборка.Зачисление, Выборка.НомерЗаявки, Отказ);
		
		Если Отказ Тогда
			// ##Оповещение
			Возврат;
		КонецЕсли;
		
		// Меняем статус заявки
		ОбменСЛКК.УстановитьСтатус(ЭтотОбъект.Основание, "done", Отказ);
	
	Иначе
		// ##Оповещение
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

