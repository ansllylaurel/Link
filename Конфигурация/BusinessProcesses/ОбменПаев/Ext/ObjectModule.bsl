Процедура ОтправкаВЛККСтатусаВРаботеПриВыполнении(ТочкаМаршрутаБизнесПроцесса, Задача, Отказ)

	РегистрыСведений.СтатусыЗаявокПайщиков.УстановитьСтатусЗаявки(
			ЭтотОбъект.Организация,
			ЭтотОбъект.Основание,
			Перечисления.СтатусыЗаявокПайщиков.ВРаботе,
			ТекущаяДатаСеанса(),
			Отказ);
			
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
			
	// Также устанавливаем статус у связанной заявки на приобретение (если она есть)	
	ЗаявкаНаПриобретение = Бизнеспроцессы.ОбменПаев.ЗаявкаНаПриобретениеПоЗаявкеНаОбменПаев(ЭтотОбъект.Организация, ЭтотОбъект.Основание);
		
	Если ЗаявкаНаПриобретение <> Неопределено Тогда
				
		РегистрыСведений.СтатусыЗаявокПайщиков.УстановитьСтатусЗаявки(
			ЭтотОбъект.Организация,
			ЗаявкаНаПриобретение,
			Перечисления.СтатусыЗаявокПайщиков.ВРаботе,
			ТекущаяДатаСеанса(),
			Отказ);
			
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
		
	ОбменСЛКК = Обработки.ОбменДаннымиСЛККЕСИАФинанс.Создать(); 
	
	ОбменСЛКК.Организация = ЭтотОбъект.Организация;
	
	ОбменСЛКК.ДополнительныеСвойства.Вставить("Источник", ЭтотОбъект.Ссылка);
	ОбменСЛКК.УстановитьСтатус(ЭтотОбъект.Основание, "in_process", Отказ); 
			
КонецПроцедуры


