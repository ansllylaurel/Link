
Функция ФормаВыполненияЗадачи(ЗадачаСсылка, ТочкаМаршрутаБизнесПроцесса) Экспорт
	
	Возврат "БизнесПроцесс.ОбучениеСотрудника.Форма.Действие" + ТочкаМаршрутаБизнесПроцесса.Имя;
	
КонецФункции

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля.Добавить("Сотрудник");
	Поля.Добавить("Номер");
	Поля.Добавить("Дата");
	Поля.Добавить("Отменен");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Данные.Отменен Тогда
		Представление = СтрШаблон("Обучение сотрудника (%1) № %2 от %3 (Отменён)", Данные.Сотрудник, Данные.Номер, Формат(Данные.Дата, "ДФ=dd.MM.yyyy"));
	Иначе
		Представление = СтрШаблон("Обучение сотрудника (%1) № %2 от %3", Данные.Сотрудник, Данные.Номер, Формат(Данные.Дата, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
КонецПроцедуры

