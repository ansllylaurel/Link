
#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Задачи создаются автоматически",,,, Отказ);		
		Возврат;
	КонецЕсли;
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
		
	ПриЧтенииСозданииНаСервере();
	
	ЭтаФорма.ТолькоПросмотр = Объект.Выполнена Или ЗапретНаВыполнениеЗадачи(Объект.ГруппаИсполнителей);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	    	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если Объект.Выполнена Тогда
		Оповестить("ВыполнениеЗадачиПоЗаявкеНаПриобретениеПаев", Новый Структура, Объект.Ссылка);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗапретНаВыполнениеЗадачи(ГруппаИсполнителей)
	
	// Полноправным разрешено согласование
	Если РаботаСПользователями.ЭтоПолноправныйПользователь(РаботаСПользователями.ТекущийПользователь(), Ложь) Тогда
		Возврат Ложь;	
	КонецЕсли;
	
	// Проверяем, входит ли пользователь в группу пользователей для согласования задачи
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоставГруппПользователей.Пользователь КАК Пользователь
		|ИЗ
		|	РегистрСведений.СоставГруппПользователей КАК СоставГруппПользователей
		|ГДЕ
		|	СоставГруппПользователей.ГруппаПользователей = &ГруппаИсполнителей
		|	И СоставГруппПользователей.Пользователь = &Исполнитель";		
	
	Запрос.УстановитьПараметр("ГруппаИсполнителей", 	ГруппаИсполнителей);
	Запрос.УстановитьПараметр("Исполнитель", 			РаботаСПользователями.ТекущийПользователь());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Количество() = 0;
	
КонецФункции

#КонецОбласти
