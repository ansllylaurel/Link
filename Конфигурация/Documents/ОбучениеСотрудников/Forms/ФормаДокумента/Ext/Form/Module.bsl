
#Область СОБЫТИЯ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтаФорма.ТребуетсяПроверкаЗнаний Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.НачалоПроверкиЗнаний) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Начало проверки знаний""", Объект.Ссылка, "Объект.НачалоПроверкиЗнаний",, Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.ОкончаниеПроверкиЗнаний) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Окончание проверки знаний""", Объект.Ссылка, "Объект.ОкончаниеПроверкиЗнаний",, Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если Объект.Сотрудники.Количество() Тогда
		ЗаполнитьДополнительныеСведенияСотрудниковНаСервере();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ЭЛЕМЕНТОВ_ФОРМЫ

&НаКлиенте
Процедура ВидОбученияПриИзменении(Элемент)
	
	Если Объект.ВидОбучения <> ПредопределенноеЗначение("Перечисление.ВидыОбученийСотрудников.Первичное") Тогда
		Объект.ВидПервичногоОбучения = Неопределено;
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТребуетсяПроверкаЗнанийПриИзменении(Элемент)
	
	Если НЕ ЭтаФорма.ТребуетсяПроверкаЗнаний Тогда
		Объект.НачалоПроверкиЗнаний		= Неопределено;
		Объект.ОкончаниеПроверкиЗнаний	= Неопределено;
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
	Если Объект.Сотрудники.Количество() Тогда
		ЗаполнитьДополнительныеСведенияСотрудников();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДатаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.ДатаОбработкаВыбора(Объект, ЭтаФорма, ВыбранноеЗначение, СтандартнаяОбработка);	
	
КонецПроцедуры

&НаКлиенте
Процедура СотрудникиПриИзменении(Элемент)
	
	Если Объект.Сотрудники.Количество() Тогда
		ЗаполнитьДополнительныеСведенияСотрудников();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СотрудникиСотрудникОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если РаботаССотрудниками.СотрудникиУволены(Объект.Организация, ВыбранноеЗначение, Объект.Дата, Истина)
	 ИЛИ РаботаССотрудниками.СотрудникиВОтпускеПоУходуЗаРебенком(Объект.Организация, ВыбранноеЗначение, Объект.Дата, Истина)
	 ИЛИ НЕ РаботаССотрудниками.СотрудникиВходятВПеречень(Объект.Организация, Объект.ВидПеречня, ВыбранноеЗначение, Объект.Дата, Ложь) Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбучающиеРесурсыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ОбучающиеРесурсыСсылкаНаОбучающийРесурсГиперссылка" Тогда
		ОткрытьОбучающийРесурс();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПеречняНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = (Объект.Сотрудники.Количество() = 0 ИЛИ Вопрос("Таблица 'Сотрудники' будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПеречняПриИзменении(Элемент)
	
	Если Объект.ВидПеречня <> ЭтаФорма.ПредВидПеречня Тогда
		Если Объект.Сотрудники.Количество() <> 0 И Вопрос("Таблица 'Сотрудники' будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
			Объект.ВидПеречня = ЭтаФорма.ПредВидПеречня;
			Возврат;
		КонецЕсли;
		
		Объект.Сотрудники.Очистить();
		ЭтаФорма.ПредВидПеречня = Объект.ВидПеречня;
		
		Если Объект.ВидПеречня <> ПредопределенноеЗначение("Справочник.ВидыПеречнейОбъектов.СотрудникиПроходящиеОбучениеПОДФТ") Тогда
			ЭтаФорма.ТребуетсяПроверкаЗнаний	= Ложь;
			Объект.НачалоПроверкиЗнаний			= Неопределено;
			Объект.ОкончаниеПроверкиЗнаний		= Неопределено;
			Объект.ВидПервичногоОбучения		= Неопределено;
		КонецЕсли;
		
		УстановитьОграничениеНаВидыОбучения(ЭтаФорма);
		НастроитьВидимостьИДоступность(ЭтаФорма);
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура ЗаполнитьСотрудниковИзПеречня(Команда)
	
	Если Объект.Сотрудники.Количество() = 0 ИЛИ Вопрос("Таблица 'Сотрудники' будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		ЗаполнитьСотрудниковИзПеречняНаСервере();
		ЗаполнитьДополнительныеСведенияСотрудников();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиПоСсылке(Команда)
	
	ОткрытьОбучающийРесурс();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеХодаОбучения(Команда)
	
	Если Объект.Сотрудники.Количество() Тогда
		ЗаполнитьДополнительныеСведенияСотрудников();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СЛУЖЕБНЫЕ_ПРОЦЕДУРЫ_И_ФУНКЦИИ

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)

	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
	ВидыПеречнейОбъектов = РаботаСМетаданнымиПовтИсп.ЗначенияПредопределенныхЭлементовСправочникаВСтруктуру("ВидыПеречнейОбъектов");
	ВидыОбучения		 = РаботаСМетаданнымиПовтИсп.ЗначенияПеречисленияВСтруктуру("ВидыОбученийСотрудников");
	
	Элементы.ВидПервичногоОбучения.Видимость		= (Объект.ВидПеречня = ВидыПеречнейОбъектов.СотрудникиПроходящиеОбучениеПОДФТ И Объект.ВидОбучения = ВидыОбучения.Первичное);
	Элементы.ГруппаПериодПроверкиЗнаний.Видимость	= (Объект.ВидПеречня = ВидыПеречнейОбъектов.СотрудникиПроходящиеОбучениеПОДФТ);
	
	Элементы.НачалоПроверкиЗнаний.Видимость		= Форма.ТребуетсяПроверкаЗнаний;
	Элементы.ОкончаниеПроверкиЗнаний.Видимость	= Форма.ТребуетсяПроверкаЗнаний;
	
	Элементы.СотрудникиДатаПроверкиЗнаний.Видимость	= Форма.ТребуетсяПроверкаЗнаний;
	Элементы.СотрудникиПроверяющий.Видимость		= Форма.ТребуетсяПроверкаЗнаний;
	
	Элементы.ОбучающиеРесурсыСсылкаНаОбучающийРесурс.Видимость				= НЕ  Форма.ТолькоПросмотр;
	Элементы.ОбучающиеРесурсыСсылкаНаОбучающийРесурсГиперссылка.Видимость	= Форма.ТолькоПросмотр;
	
	//Элементы.СотрудникиЗаполнитьСотрудниковИзПеречня.Доступность = НЕ Форма.ТолькоПросмотр;
	
КонецПроцедуры // НастроитьВидимостьИДоступность

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()

	Если Объект.Сотрудники.Количество() Тогда
		ЗаполнитьДополнительныеСведенияСотрудниковНаСервере();
	КонецЕсли;
	
	ЭтаФорма.ТребуетсяПроверкаЗнаний = (ЗначениеЗаполнено(Объект.НачалоПроверкиЗнаний) И Объект.ВидПеречня = Справочники.ВидыПеречнейОбъектов.СотрудникиПроходящиеОбучениеПОДФТ);
	
	Элементы.ДобавитьФайлОбучающийРесурсФайл.Видимость = НЕ ЭтаФорма.ТолькоПросмотр;
	
	КоличествоПодчиненных = Элементы.ГруппаОбучающиеРесурсы.ПодчиненныеЭлементы.Количество();
	Для Сч = 1 По КоличествоПодчиненных Цикл
		Элементы.Удалить(Элементы.ГруппаОбучающиеРесурсы.ПодчиненныеЭлементы[КоличествоПодчиненных - Сч]);	
	КонецЦикла; 
	
	Для каждого СтрокаОбучающийРесурс из Объект.ОбучающиеРесурсы Цикл
		РазместитьОбучающийРесурс(СтрокаОбучающийРесурс.НомерСтроки - 1);
	КонецЦикла;
	
	ПрочитатьИОбновитьСписокФайлов();
	
	КоличествоПодчиненных = Элементы.ГруппаФайлы.ПодчиненныеЭлементы.Количество();
	Для Сч = 1 По КоличествоПодчиненных Цикл
		Элементы.Удалить(Элементы.ГруппаФайлы.ПодчиненныеЭлементы[КоличествоПодчиненных - Сч]);	
	КонецЦикла; 
	
	Для Индекс = 0 По Файлы.Количество() - 1 Цикл
		РазместитьФайл(Индекс);
	КонецЦикла;
	
	ЭтаФорма.ПредВидПеречня = Объект.ВидПеречня;
	
	УстановитьОграничениеНаВидыОбучения(ЭтаФорма);
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры //ПриЧтенииСозданииНаСервере

&НаСервере
Процедура ЗаполнитьСотрудниковИзПеречняНаСервере()
	
	Объект.Сотрудники.Загрузить(РаботаССотрудниками.СотрудникиВходящиеВПеречень(Объект.Организация, Объект.ВидПеречня, Объект.Дата));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДополнительныеСведенияСотрудников()
	
	КлючТекущейСтроки = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.Сотрудники, "Сотрудник");
	ЗаполнитьДополнительныеСведенияСотрудниковНаСервере();
	РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(Объект.Сотрудники, Элементы.Сотрудники, "Сотрудник", КлючТекущейСтроки);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеСведенияСотрудниковНаСервере()
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация", 		Объект.Организация);
	Запрос.УстановитьПараметр("Ссылка",		 		Объект.Ссылка);
	Запрос.УстановитьПараметр("Дата",		 		Объект.Дата);
	Запрос.УстановитьПараметр("Сотрудники",			Объект.Сотрудники.Выгрузить());
	
	Запрос.Текст =
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	Сотрудники.Сотрудник КАК Сотрудник,
	    |	АВТОНОМЕРЗАПИСИ() КАК Порядок
	    |ПОМЕСТИТЬ _Сотрудники
	    |ИЗ
	    |	&Сотрудники КАК Сотрудники
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	Сотрудники.Сотрудник КАК Сотрудник,
	    |	СотрудникиОрганизацииСрезПоследних.Должность КАК Должность,
	    |	СотрудникиОрганизацииСрезПоследних.Подразделение КАК Подразделение,
	    |	ЗадачаНаОбучение.ДатаВыполнения КАК ДатаОбучения,
	    |	ЗадачаНаОбучение.ОбучениеПройденоОффлайн КАК ОбучениеПройденоОффлайн,
	    |	ЗадачаНаПроверкуЗнаний.ДатаВыполнения КАК ДатаПроверкиЗнаний,
	    |	ЗадачаНаПроверкуЗнаний.Исполнитель КАК Проверяющий,
	    |	Сотрудники.Порядок КАК Порядок
	    |ИЗ
	    |	_Сотрудники КАК Сотрудники
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации.СрезПоследних(&Дата, Организация = &Организация) КАК СотрудникиОрганизацииСрезПоследних
	    |		ПО Сотрудники.Сотрудник = СотрудникиОрганизацииСрезПоследних.Сотрудник
	    |		ЛЕВОЕ СОЕДИНЕНИЕ БизнесПроцесс.ОбучениеСотрудника КАК ОбучениеСотрудника
	    |		ПО (ОбучениеСотрудника.Сотрудник = Сотрудники.Сотрудник)
	    |			И (ОбучениеСотрудника.Основание = &Ссылка)
	    |			И (НЕ ОбучениеСотрудника.ПометкаУдаления)
	    |		ЛЕВОЕ СОЕДИНЕНИЕ Задача.ЗадачаИсполнителя КАК ЗадачаНаОбучение
	    |		ПО (ОбучениеСотрудника.Ссылка = ЗадачаНаОбучение.БизнесПроцесс)
	    |			И (ЗадачаНаОбучение.ТочкаМаршрута В (ЗНАЧЕНИЕ(БизнесПроцесс.ОбучениеСотрудника.ТочкаМаршрута.ПройтиОбучение), ЗНАЧЕНИЕ(БизнесПроцесс.ОбучениеСотрудника.ТочкаМаршрута.ПровестиОбучение)))
	    |			И (НЕ ЗадачаНаОбучение.ПометкаУдаления)
	    |			И (ЗадачаНаОбучение.Выполнена)
	    |		ЛЕВОЕ СОЕДИНЕНИЕ Задача.ЗадачаИсполнителя КАК ЗадачаНаПроверкуЗнаний
	    |		ПО (ОбучениеСотрудника.Ссылка = ЗадачаНаПроверкуЗнаний.БизнесПроцесс)
	    |			И (ЗадачаНаПроверкуЗнаний.ТочкаМаршрута = ЗНАЧЕНИЕ(БизнесПроцесс.ОбучениеСотрудника.ТочкаМаршрута.ПроверитьЗнания))
	    |			И (НЕ ЗадачаНаПроверкуЗнаний.ПометкаУдаления)
	    |			И (ЗадачаНаПроверкуЗнаний.Выполнена)
	    |
	    |УПОРЯДОЧИТЬ ПО
	    |	Порядок";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Объект.Сотрудники.Очистить();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Объект.Сотрудники.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		Если ЗначениеЗаполнено(Выборка.ДатаОбучения) Тогда
			НоваяСтрока.ДатаОбученияПредставление = Формат(Выборка.ДатаОбучения, "ДФ=dd.MM.yyyy") + ?(Выборка.ОбучениеПройденоОффлайн, " (пройдено оффлайн)", "");
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОткрытьПрисоединенныеФайлы()

	РаботаСФайловымХранилищемКлиент.ОткрытьПрисоединенныеФайлы(Объект.Ссылка);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОбучающийРесурс()
	
	ТекущиеДанные = Элементы.ОбучающиеРесурсы.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ЗапуститьПриложение(ТекущиеДанные.СсылкаНаОбучающийРесурс);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОграничениеНаВидыОбучения(Форма)
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
	ВидыПеречнейОбъектов = РаботаСМетаданнымиПовтИсп.ЗначенияПредопределенныхЭлементовСправочникаВСтруктуру("ВидыПеречнейОбъектов");
	ВидыОбучения		 = РаботаСМетаданнымиПовтИсп.ЗначенияПеречисленияВСтруктуру("ВидыОбученийСотрудников");
	
	МассивВидовОбученийСотрудников = Новый Массив;
	МассивВидовОбученийСотрудников.Добавить(ВидыОбучения.Первичное);
	МассивВидовОбученийСотрудников.Добавить(ВидыОбучения.Плановое);
	
	Если Объект.ВидПеречня = ВидыПеречнейОбъектов.СотрудникиПроходящиеОбучениеПОДФТ Тогда
		МассивВидовОбученийСотрудников.Добавить(ВидыОбучения.Внеплановое);
	КонецЕсли;

	Элементы.ВидОбучения.СписокВыбора.Очистить();
	Элементы.ВидОбучения.СписокВыбора.ЗагрузитьЗначения(МассивВидовОбученийСотрудников);
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСОбучающимиРесурсамиИФайлами	

&НаКлиенте
Процедура ДобавитьСсылку(Команда)
	
	НоваяСтрока = Объект.ОбучающиеРесурсы.Добавить();
	РазместитьОбучающийРесурс(НоваяСтрока.НомерСтроки - 1);
	
КонецПроцедуры

&НаСервере
Процедура РазместитьОбучающийРесурс(Знач ИндексЭлемента)
	
	НомерОбучающегоРесурсаСтрока = Формат(ИндексЭлемента, "ЧН=0; ЧГ=0");
	
	НоваяГруппа = Элементы.Добавить("ГруппаОбучающийРесурс" + НомерОбучающегоРесурсаСтрока, Тип("ГруппаФормы"), Элементы.ГруппаОбучающиеРесурсы);
	НоваяГруппа.Вид                  = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.ОтображатьЗаголовок  = Ложь;
	НоваяГруппа.Группировка          = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	НоваяГруппа.Отображение          = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппа.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
	
	Если ЭтаФорма.ТолькоПросмотр Тогда
		
		НовыйЭлемент = Элементы.Добавить("ДекорацияУдаленияОбучающийРесурс" + НомерОбучающегоРесурсаСтрока, Тип("ДекорацияФормы"), НоваяГруппа);
		НовыйЭлемент.Подсказка           = "Удалить обучающий ресурс";
		НовыйЭлемент.Вид                 = ВидДекорацииФормы.Картинка;
		НовыйЭлемент.Картинка            = БиблиотекаКартинок.ПолучитьНавигационнуюСсылку;
		
		НовыйЭлемент = Элементы.Добавить("СсылкаНаОбучающийРесурс" + НомерОбучающегоРесурсаСтрока, Тип("ПолеФормы"), НоваяГруппа);
		НовыйЭлемент.ПутьКДанным              = "Объект.ОбучающиеРесурсы[" + НомерОбучающегоРесурсаСтрока + "].СсылкаНаОбучающийРесурс";
		НовыйЭлемент.ПоложениеЗаголовка       = ПоложениеЗаголовкаЭлементаФормы.Нет;
		НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
		НовыйЭлемент.Ширина                   = 30;
		НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеНадписи;
		НовыйЭлемент.Гиперссылка		  	  = Истина;
		НовыйЭлемент.УстановитьДействие("Нажатие", "ОбучающийРесурсНажатие");	
		НовыйЭлемент.ОтображениеПодсказки	  = ОтображениеПодсказки.ОтображатьСлева;
		НовыйЭлемент.Подсказка	  			  = Объект.ОбучающиеРесурсы[ИндексЭлемента].Описание;
	
	Иначе
		
		НовыйЭлемент = Элементы.Добавить("ДекорацияУдаленияОбучающийРесурс" + НомерОбучающегоРесурсаСтрока, Тип("ДекорацияФормы"), НоваяГруппа);
		НовыйЭлемент.Подсказка           = "Удалить обучающий ресурс";
		НовыйЭлемент.Вид                 = ВидДекорацииФормы.Картинка;
		НовыйЭлемент.Картинка            = БиблиотекаКартинок.Удалить;
		НовыйЭлемент.Гиперссылка         = Истина;
		НовыйЭлемент.УстановитьДействие("Нажатие", "УдалитьОбучающийРесурс");
		
		
		НовыйЭлемент = Элементы.Добавить("ОписаниеОбучающегоРесурса" + НомерОбучающегоРесурсаСтрока, Тип("ПолеФормы"), НоваяГруппа);
		НовыйЭлемент.ПутьКДанным              = "Объект.ОбучающиеРесурсы[" + НомерОбучающегоРесурсаСтрока + "].Описание";
		НовыйЭлемент.Заголовок                 = "Описание";
		НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
		НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ТолькоПросмотр			  = ЭтаФорма.ТолькоПросмотр;
		НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
		НовыйЭлемент.Ширина                   = 20;
		
		НовыйЭлемент = Элементы.Добавить("СсылкаНаОбучающийРесурс" + НомерОбучающегоРесурсаСтрока, Тип("ПолеФормы"), НоваяГруппа);
		НовыйЭлемент.ПутьКДанным              = "Объект.ОбучающиеРесурсы[" + НомерОбучающегоРесурсаСтрока + "].СсылкаНаОбучающийРесурс";
		НовыйЭлемент.Заголовок                 = "Ссылка";
		НовыйЭлемент.ПоложениеЗаголовка       = ПоложениеЗаголовкаЭлементаФормы.Лево;
		НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
		НовыйЭлемент.Ширина                   = 30;
		НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеВвода;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОбучающийРесурс(Элемент)
	
	Модифицированность = Истина;
	
	НомерОбучающегоРесурсаСтрока = Сред(Элемент.Имя, СтрДлина("ДекорацияУдаленияОбучающийРесурс") + 1);
	НомерОбучающегоРесурсаЧисло  = Число(НомерОбучающегоРесурсаСтрока);
	
	УдалитьОбучающийРесурсНаСервере();
	
	Объект.ОбучающиеРесурсы.Удалить(НомерОбучающегоРесурсаЧисло);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьОбучающийРесурсНаСервере()
	
	НомерОбучающегоРесурса = Объект.ОбучающиеРесурсы.Количество() - 1;
	НомерОбучающегоРесурсаСтрока = Формат(НомерОбучающегоРесурса, "ЧН=0; ЧГ=0");
	
	Элементы.Удалить(Элементы["ГруппаОбучающийРесурс" + НомерОбучающегоРесурсаСтрока]);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбучающийРесурсНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НомерОбучающегоРесурсаСтрока = Сред(Элемент.Имя, СтрДлина("СсылкаНаОбучающийРесурс") + 1);
	НомерОбучающегоРесурсаЧисло  = Число(НомерОбучающегоРесурсаСтрока);
	
	ЗапуститьПриложение(Объект.ОбучающиеРесурсы[НомерОбучающегоРесурсаЧисло].СсылкаНаОбучающийРесурс);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитФайл(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если Вопрос("Присоединить файл можно только к записанному документу. Записать?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			Если Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись)) = Ложь Тогда
				Возврат;
			КонецЕсли;
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыВыбораФайла = Новый Структура;
	ПараметрыВыбораФайла.Вставить("МножественныйВыбор", Ложь);
	ПараметрыВыбораФайла.Вставить("НовыйФайл", Истина);
	ПараметрыВыбораФайла.Вставить("ИдентификаторФайла", Неопределено);
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.МножественныйВыбор = ПараметрыВыбораФайла.МножественныйВыбор;
	
	Если ДиалогВыбора.Выбрать() Тогда
		
		ВыборФайлаЗавершение(ДиалогВыбора.ВыбранныеФайлы, ПараметрыВыбораФайла);
		ПрочитатьИОбновитьСписокФайлов();
	
	КонецЕсли; 
	
	РазместитьФайл(Файлы.Количество() - 1);
	
КонецПроцедуры

&НаСервере
Процедура РазместитьФайл(Знач ИндексЭлемента)
	
	НомерФайлаСтрока = Формат(ИндексЭлемента, "ЧН=0; ЧГ=0");
	
	НоваяГруппа = Элементы.Добавить("ГруппаФайл" + НомерФайлаСтрока, Тип("ГруппаФормы"), Элементы.ГруппаФайлы);
	НоваяГруппа.Вид                  = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.ОтображатьЗаголовок  = Ложь;
	НоваяГруппа.Группировка          = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	НоваяГруппа.Отображение          = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппа.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
	
	Если ЭтаФорма.ТолькоПросмотр Тогда

		НовыйЭлемент = Элементы.Добавить("КартинкаФайла" + НомерФайлаСтрока, Тип("ПолеФормы"), НоваяГруппа);
		НовыйЭлемент.ПутьКДанным              = "Файлы[" + НомерФайлаСтрока + "].ИндексКартинки";
		НовыйЭлемент.ПоложениеЗаголовка 	  = ПоложениеЗаголовкаЭлементаФормы.Нет;
		НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеКартинки;
		НовыйЭлемент.ТолькоПросмотр			  = ЭтаФорма.ТолькоПросмотр;
		НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
		НовыйЭлемент.РастягиватьПоВертикали   = Ложь;
		НовыйЭлемент.КартинкаЗначений		  = БиблиотекаКартинок.КоллекцияПиктограммФайлов;
		
		НовыйЭлемент = Элементы.Добавить("СсылкаНаФайл" + НомерФайлаСтрока, Тип("ПолеФормы"), НоваяГруппа);
		НовыйЭлемент.ПутьКДанным              = "Файлы[" + НомерФайлаСтрока + "].Наименование";
		НовыйЭлемент.Заголовок                 = "Файл";
		НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеНадписи;
		НовыйЭлемент.Гиперссылка		  	  = Истина;
		НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
		НовыйЭлемент.Ширина                   = 30;
		НовыйЭлемент.УстановитьДействие("Нажатие", "ОткрытьФайлНаЧтение");	
		НовыйЭлемент.ОтображениеПодсказки	  = ОтображениеПодсказки.ОтображатьСлева;
		НовыйЭлемент.Подсказка	  			  = ЭтаФорма.Файлы[ИндексЭлемента].Описание;
		
	Иначе
		НовыйЭлемент = Элементы.Добавить("ДекорацияУдаленияФайл" + НомерФайлаСтрока, Тип("ДекорацияФормы"), НоваяГруппа);
		НовыйЭлемент.Подсказка           = "Удалить файл";
		НовыйЭлемент.Вид                 = ВидДекорацииФормы.Картинка;
		НовыйЭлемент.Картинка            = БиблиотекаКартинок.Удалить;
		НовыйЭлемент.Гиперссылка         = Истина;
		НовыйЭлемент.УстановитьДействие("Нажатие", "УдалитьФайл");
	
		НовыйЭлемент = Элементы.Добавить("ОписаниеФайла" + НомерФайлаСтрока, Тип("ПолеФормы"), НоваяГруппа);
		НовыйЭлемент.ПутьКДанным              = "Файлы[" + НомерФайлаСтрока + "].Описание";
		НовыйЭлемент.Заголовок                = "Описание";
		НовыйЭлемент.ПоложениеЗаголовка 	  = ПоложениеЗаголовкаЭлементаФормы.Лево;
		НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ТолькоПросмотр			  = ЭтаФорма.ТолькоПросмотр;
		НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
		НовыйЭлемент.Ширина                   = 20;
		НовыйЭлемент.УстановитьДействие("ПриИзменении", "ОписаниеФайлаПриИзменении");
	
	
		НовыйЭлемент = Элементы.Добавить("СсылкаНаФайл" + НомерФайлаСтрока, Тип("ПолеФормы"), НоваяГруппа);
		НовыйЭлемент.ПутьКДанным              = "Файлы[" + НомерФайлаСтрока + "].Наименование";
		НовыйЭлемент.Заголовок                 = "Файл";
		НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
		НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеНадписи;
		НовыйЭлемент.Гиперссылка		  	  = Истина;
		НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
		НовыйЭлемент.Ширина                   = 30;
		НовыйЭлемент.УстановитьДействие("Нажатие", "ОткрытьФайлНаЧтение");	
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено Тогда
		МассивФайлов = Новый Массив;
		
		Для Индекс = 0 По ВыбранныеФайлы.ВГраница() Цикл
			МассивФайлов.Добавить(Новый ОписаниеПередаваемогоФайла(ВыбранныеФайлы[Индекс]));
		КонецЦикла; 
		СоздатьФайлы(МассивФайлов);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьФайлы(ПомещаемыеФайлы)

	ПомещенныеФайлы = Новый Массив;
	Попытка
	
		ПоместитьФайлы(ПомещаемыеФайлы, ПомещенныеФайлы,, Ложь, ЭтаФорма.УникальныйИдентификатор);
		СоздатьФайлыНаСервере(Объект.Ссылка, ПомещенныеФайлы);		
	
	Исключение
		
		ТекстОшибки = "Не удалось присоединить файл";
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Описание = "";
		
		Если ТипЗнч(ИнформацияОбОшибке.Причина) = Тип("ИнформацияОбОшибке") Тогда
			Описание = ИнформацияОбОшибке.Причина.Описание;
		КонецЕсли; 
		
		Если Не ЗначениеЗаполнено(Описание) Тогда
			Описание = ОписаниеОшибки();
		КонецЕсли; 
		
		Предупреждение(ТекстОшибки + Символы.ПС + Описание);
		
	КонецПопытки; 

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоздатьФайлыНаСервере(ВладелецФайла, ПомещенныеФайлы)

	МетаданныеВладельца = ВладелецФайла.Метаданные();
	
	ТипВладельца = МетаданныеВладельца.ПолноеИмя();
	
	Организация = Неопределено;
	Если РаботаСМетаданнымиПовтИсп.ЕстьРеквизитОбъекта(МетаданныеВладельца.ПолноеИмя(), "Организация") Тогда
		Организация = ВладелецФайла.Организация;
	КонецЕсли;
	
	ИдентификаторВладельца = Строка(ВладелецФайла.УникальныйИдентификатор());
	НаименованиеВладельца = Строка(ВладелецФайла);
	
	Для каждого ОписаниеПереданногоФайла Из ПомещенныеФайлы Цикл
	
		Файл = Новый Файл(ОписаниеПереданногоФайла.ПолноеИмя);
		
		ПараметрыФайла = Новый Структура;

		ПараметрыФайла.Вставить("Адрес",					ОписаниеПереданногоФайла.Хранение);
		ПараметрыФайла.Вставить("Имя",						Файл.ИмяБезРасширения);
		ПараметрыФайла.Вставить("Расширение",				Сред(Файл.Расширение, 2));
		ПараметрыФайла.Вставить("НаименованиеВладельца",	НаименованиеВладельца);
		ПараметрыФайла.Вставить("ИдентификаторВладельца",	ИдентификаторВладельца);
		ПараметрыФайла.Вставить("ТипВладельца",				ТипВладельца);

		Попытка
			ДанныеВерсии = РаботаСФайловымХранилищем.СоздатьФайл(ПараметрыФайла, Организация);
			РаботаСФайловымХранилищем.ПриИзмененииПрисоединенныхФайлов(ВладелецФайла);
			ЗаписьЖурналаРегистрации("Файловое хранилище.Добавление файла", УровеньЖурналаРегистрации.Информация, МетаданныеВладельца, ВладелецФайла, "Добавлен файл: """ + Файл.Имя + """");
		Исключение
			ТекстОшибки = СтрШаблон("Не удалось сохранить данные файла %1 в файловом хранилище из-за ошибки:%2", 
				ОписаниеПереданногоФайла.ПолноеИмя, 
				Символы.ПС + ОписаниеОшибки());
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецПопытки;
		
		УдалитьИзВременногоХранилища(ОписаниеПереданногоФайла.Хранение);
	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьИОбновитьСписокФайлов()
	
	Файлы.Очистить();
	
	ДанныеФайлов = РаботаСФайловымХранилищем.ПолучитьСписокФайлов(Объект.Ссылка);
	Для каждого ДанныеФайла Из ДанныеФайлов Цикл
		НоваяСтрока = ЭтаФорма.Файлы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеФайла);
		НоваяСтрока.ПредставлениеРазмера = РаботаСФайловымХранилищем.КраткоеПредставлениеРазмера(НоваяСтрока.Размер);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайлНаЧтение(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НомерФайлаСтрока = Сред(Элемент.Имя, СтрДлина("СсылкаНаФайл") + 1);
	НомерФайлаЧисло  = Число(НомерФайлаСтрока);
	
	ДанныеФайла = РаботаСФайловымХранилищем.ПолучитьФайл(Файлы[НомерФайлаЧисло].ИдентификаторФайла);
	Если ДанныеФайла <> Неопределено Тогда
		
		Каталог = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов();
		ИмяФайла = ДанныеФайла.Имя + "." + ДанныеФайла.Расширение;
		Маска = ДанныеФайла.Имя + " (*)." + ДанныеФайла.Расширение;
		НайденныеФайлы = НайтиФайлы(Каталог, ИмяФайла);
		
		Если НайденныеФайлы.Количество() > 0 Тогда
			ФайлыПоМаске = НайтиФайлы(Каталог, Маска);
			НомерКопии = ФайлыПоМаске.Количество() + 1;
			Путь = Каталог + СтрЗаменить(Маска, " (*).", " (" + НомерКопии + ").");
		Иначе
			Путь = Каталог + ИмяФайла;
		КонецЕсли; 
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеФайла.Адрес);	
		
		Попытка
			
			ДвоичныеДанные.Записать(Путь);
			ЗапуститьПриложение(Путь);	
			
		Исключение
			
			ТекстОшибки = "Не удалось открыть файл";
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			Описание = "";
			
			Если ТипЗнч(ИнформацияОбОшибке.Причина) = Тип("ИнформацияОбОшибке") Тогда
				Описание = ИнформацияОбОшибке.Причина.Описание;
			КонецЕсли; 
			
			Если Не ЗначениеЗаполнено(Описание) Тогда
				Описание = ОписаниеОшибки();
			КонецЕсли; 
			
			Предупреждение(ТекстОшибки + Символы.ПС + Описание);
			
		КонецПопытки; 		
		
		УдалитьИзВременногоХранилища(ДанныеФайла.Адрес);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьФайл(Элемент)
	
	НомерФайлаСтрока = Сред(Элемент.Имя, СтрДлина("ДекорацияУдаленияФайл") + 1);
	НомерФайлаЧисло  = Число(НомерФайлаСтрока);
	
	УдалитьФайлНаСервере(НомерФайлаЧисло);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьФайлНаСервере(ИндексФайла)
	
	Данные = Файлы[ИндексФайла];
	РаботаСФайловымХранилищем.УдалитьФайл(Данные.ИдентификаторФайла);
	РаботаСФайловымХранилищем.ПриИзмененииПрисоединенныхФайлов(Объект.Ссылка);
	ИмяФайла = Данные.Наименование + ?(ЗначениеЗаполнено(Данные.Расширение), "." + Данные.Расширение, "");
	ЗаписьЖурналаРегистрации("Файловое хранилище.Удаление файла", 
		УровеньЖурналаРегистрации.Информация, 
		Объект.Ссылка.Метаданные(), 
		Объект.Ссылка, 
		"Удален файл: """ + ИмяФайла + """");
		
	НомерФайлаЧисло = Файлы.Количество() - 1;
	НомерФайлаСтрока = Формат(НомерФайлаЧисло, "ЧН=0; ЧГ=0");
	
	Элементы.Удалить(Элементы["ГруппаФайл" + НомерФайлаСтрока]);
	
	ПрочитатьИОбновитьСписокФайлов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеФайлаПриИзменении(Элемент)
	
	НомерФайлаСтрока = Сред(Элемент.Имя, СтрДлина("ОписаниеФайла") + 1);
	НомерФайлаЧисло  = Число(НомерФайлаСтрока);

	ОписаниеФайлаПриИзмененииНаСервере(НомерФайлаЧисло);
	
КонецПроцедуры

&НаСервере
Процедура ОписаниеФайлаПриИзмененииНаСервере(НомерФайлаЧисло)
	
	Прокси = РаботаСФайловымХранилищем.ПолучитьПроксиВебСервисаФайловогоХранилища();
	
	ОбъектXDTO = РаботаСФайловымХранилищем.СоздатьОбъект(Прокси, "DMFile");
	ОбъектXDTO.objectID = РаботаСФайловымХранилищем.СоздатьObjectID(Прокси, Файлы[НомерФайлаЧисло].ИдентификаторФайла, "DMFile");
	
	// Только 2 поля, Имя и Описание передаем при записи.
	ОбъектXDTO.name = Файлы[НомерФайлаЧисло].Наименование;
	ОбъектXDTO.description = Файлы[НомерФайлаЧисло].Описание;
	
	РаботаСФайловымХранилищем.ЗаписатьОбъект(Прокси, ОбъектXDTO);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбучениеПройденоОффлайн(Команда)
	
	ТекСтрока = Элементы.Сотрудники.ТекущиеДанные;
	Если ТекСтрока <> Неопределено Тогда
		
		ЗадачаНаОбучение = ПолучитьЗадачуНаОбучение(Объект.Ссылка, ТекСтрока.Сотрудник);
		Если ЗначениеЗаполнено(ЗадачаНаОбучение.Ссылка) Тогда
			
			ТекстСообщения = "";
			
			Если ЗадачаНаОбучение.Выполнена Тогда
				
				ТекстСообщения = СтрШаблон("Не удалось изменить задачу %1, так как она уже выполнена", ЗадачаНаОбучение.Ссылка);
				
			Иначе
				
				ДатаВыполнения = ТекущаяДата();
				Если ВвестиДату(ДатаВыполнения, "Введите дату прохождения обучения") Тогда
					ВыполнитьЗадачу(ЗадачаНаОбучение.Ссылка, ДатаВыполнения, ТекстСообщения);
				КонецЕсли;
			
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекстСообщения) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЗадачаНаОбучение.Ссылка);
			КонецЕсли;
			
			ЗаполнитьДополнительныеСведенияСотрудников();

		Иначе
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось найти задачу на обучение");
		
		КонецЕсли;
	
	КонецЕсли;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗадачуНаОбучение(Обучение, Сотрудник)

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадачаНаОбучение.Ссылка КАК Ссылка,
		|	ЗадачаНаОбучение.Выполнена КАК Выполнена
		|ИЗ
		|	Документ.ОбучениеСотрудников.Сотрудники КАК ОбучениеСотрудниковСотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ БизнесПроцесс.ОбучениеСотрудника КАК ОбучениеСотрудника
		|		ПО ОбучениеСотрудниковСотрудники.Сотрудник = ОбучениеСотрудника.Сотрудник
		|			И ОбучениеСотрудниковСотрудники.Ссылка = ОбучениеСотрудника.Основание
		|			И (НЕ ОбучениеСотрудника.ПометкаУдаления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Задача.ЗадачаИсполнителя КАК ЗадачаНаОбучение
		|		ПО (ОбучениеСотрудника.Ссылка = ЗадачаНаОбучение.БизнесПроцесс)
		|			И (ЗадачаНаОбучение.ТочкаМаршрута В (ЗНАЧЕНИЕ(БизнесПроцесс.ОбучениеСотрудника.ТочкаМаршрута.ПройтиОбучение), ЗНАЧЕНИЕ(БизнесПроцесс.ОбучениеСотрудника.ТочкаМаршрута.ПровестиОбучение)))
		|			И НЕ ЗадачаНаОбучение.ПометкаУдаления
		|ГДЕ
		|	ОбучениеСотрудниковСотрудники.Ссылка = &Ссылка
		|	И ОбучениеСотрудниковСотрудники.Сотрудник = &Сотрудник";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Обучение);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ЗадачаНаОбучение = Новый Структура("Ссылка, Выполнена");
	
	Если Выборка.Следующий() Тогда
	
		ЗаполнитьЗначенияСвойств(ЗадачаНаОбучение, Выборка)
	
	КонецЕсли;
	
	Возврат ЗадачаНаОбучение;

КонецФункции

&НаСервереБезКонтекста
Процедура ВыполнитьЗадачу(ЗадачаНаОбучение, ДатаВыполнения, ТекстСообщения)

	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("Задача.ЗадачаИсполнителя");
	ЭлементБлокировкиДанных.УстановитьЗначение("Ссылка", ЗадачаНаОбучение);
	
	НачатьТранзакцию();

	БлокировкаДанных.Заблокировать();
	
	ЗадачаОбъект = ЗадачаНаОбучение.ПолучитьОбъект();
	ЗадачаОбъект.ДатаВыполнения = ДатаВыполнения;
	ЗадачаОбъект.ОбучениеПройденоОффлайн = Истина;
	Если ЗадачаОбъект.Выполнена Тогда
		ОтменитьТранзакцию();
		ТекстСообщения = СтрШаблон("Не удалось изменить задачу %1, так как она уже выполнена", ЗадачаНаОбучение.Ссылка);
	Иначе
		Попытка
			ЗадачаОбъект.ВыполнитьЗадачу();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ТекстСообщения = СтрШаблон("Не удалось изменить задачу %1. Система сообщает: %2", ЗадачаНаОбучение.Ссылка, ОписаниеОшибки());
		Конецпопытки;		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СотрудникиПриАктивизацииСтроки(Элемент)
	
	Видимость = Ложь;
	
	Если Не ЭтаФорма.ТолькоПросмотр Тогда
	
		ИдентификаторыСтрок = Элементы.Сотрудники.ВыделенныеСтроки;
			
		Если ИдентификаторыСтрок.Количество() = 1 Тогда
		
			СтрокаТаблицы = Объект.Сотрудники.НайтиПоИдентификатору(ИдентификаторыСтрок[0]);
			Видимость = Не ЗначениеЗаполнено(СтрокаТаблицы.ДатаОбучения);
					
		КонецЕсли;		
	
	КонецЕсли;
	
	Элементы.СотрудникиКонтекстноеМенюОбучениеПройденоОффлайн.Видимость = Видимость;
	
КонецПроцедуры

#КонецОбласти