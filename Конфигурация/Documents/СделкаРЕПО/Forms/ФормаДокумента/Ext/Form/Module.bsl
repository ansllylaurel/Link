
&НаСервереБезКонтекста
Функция ПолучитьОбщиеРеквизитыКорзиныЦенныхБумаг()
	
	Возврат Документы.СделкаРЕПО.ПолучитьОбщиеРеквизитыКорзиныЦенныхБумаг();
	
КонецФункции // ПолучитьОбщиеРеквизитыКорзиныЦенныхБумаг

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьОписаниеРеквизитовБиржевойСделки(Форма)
	
	ДанныеОбъекта = Форма.Объект;
	
	// 1-я подстрока инф. строки: "Сделка [с ЦК] № 1980281955[/1980281954] на бирже ММВБ-РТС [с контрагентом Пупкин В. И.], 16:20:21" 
	ОписаниеРеквизитовБиржевойСделки1 =
		?(ДанныеОбъекта.СделкаСЦентральнымКонтрагентом,
			"Сделка с ЦК № " + ?(ЗначениеЗаполнено(ДанныеОбъекта.НомерСделки), ДанныеОбъекта.НомерСделки, "<Не задан>") + " / " + ?(ЗначениеЗаполнено(ДанныеОбъекта.НомерСделкиСЦентральнымКонтрагентом), ДанныеОбъекта.НомерСделкиСЦентральнымКонтрагентом, "<Не задан>"),
			"Сделка № " + ?(ЗначениеЗаполнено(ДанныеОбъекта.НомерСделки), ДанныеОбъекта.НомерСделки, "<Не задан>"))
		+ " на бирже " + ?(ЗначениеЗаполнено(ДанныеОбъекта.МестоХранения), Строка(ДанныеОбъекта.МестоХранения), "<Не задана>");
		
	Если Не ПустаяСтрока(ДанныеОбъекта.КонтрагентНаБирже) Тогда
		ОписаниеРеквизитовБиржевойСделки1 = ОписаниеРеквизитовБиржевойСделки1 + " с контрагентом " + ?(ПустаяСтрока(ДанныеОбъекта.КонтрагентНаБирже), "<Не задан>", Строка(ДанныеОбъекта.КонтрагентНаБирже));
	КонецЕсли;
	
	ОписаниеРеквизитовБиржевойСделки1 = ОписаниеРеквизитовБиржевойСделки1 + ", " + ?(ДанныеОбъекта.ВремяСделки = Дата(1, 1, 1), "<Время сделки не задано>", Формат(ДанныеОбъекта.ВремяСделки, "ДФ=ЧЧ:мм:сс"));
	
	// 2-я подстрока инф. строки: "[, Код расчетов S0] [, неполные лоты] [, режим переговорных сделок (РПС)]"
	ОписаниеРеквизитовБиржевойСделки2 = "";
		
	Если Не ПустаяСтрока(ДанныеОбъекта.КодРасчетовНаБирже) Тогда
		ОписаниеРеквизитовБиржевойСделки2 = ОписаниеРеквизитовБиржевойСделки2 + "Код расчетов " + ДанныеОбъекта.КодРасчетовНаБирже;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ДанныеОбъекта.РежимБиржевыхТоргов) Тогда
		
		ОписаниеРеквизитовБиржевойСделки2 = ОписаниеРеквизитовБиржевойСделки2 
		+ ?(ОписаниеРеквизитовБиржевойСделки2 = "", "Режим торгов ", ", режим торгов ") + ДанныеОбъекта.РежимБиржевыхТоргов;
		
		Если ЗначениеЗаполнено(ДанныеОбъекта.Дисконт) Тогда
		
			ОписаниеРеквизитовБиржевойСделки2 = ОписаниеРеквизитовБиржевойСделки2 
			+ ?(ОписаниеРеквизитовБиржевойСделки2 = "", "Дисконт ", ", дисконт ") + ДанныеОбъекта.Дисконт;
		
		КонецЕсли; 
		
	КонецЕсли;
	
	ОписаниеРеквизитовБиржевойСделки2 = ОписаниеРеквизитовБиржевойСделки2 + ?(Не ДанныеОбъекта.НеполныеЛоты, "", ?(Не ПустаяСтрока(ОписаниеРеквизитовБиржевойСделки2), ", ", "") + "неполные лоты");
		
	// итого
	Форма.Элементы.ОписаниеРеквизитовБиржевойСделки.Заголовок = ОписаниеРеквизитовБиржевойСделки1
		+ ?(Не ПустаяСтрока(ОписаниеРеквизитовБиржевойСделки2), ", " + Символы.ПС, "") + ОписаниеРеквизитовБиржевойСделки2;
				
КонецПроцедуры // ЗаполнитьОписаниеРеквизитовБиржевойСделки

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Элементы      = Форма.Элементы;
	ДанныеОбъекта = Форма.Объект;
	
	// При наличии 2-й части
	Элементы.ДатаВторойЧастиРЕПО.Видимость = ДанныеОбъекта.ДвеЧастиСделкиРЕПО;
	
	// видимость реквизитов, уникальных для биржевой и внебиржевой сделок
	Элементы.ГруппаРеквизитыБиржевойСделки.Видимость      = Не Форма.ВнебиржеваяСделка;
	Элементы.ПлатежноеУсловиеСделки.Видимость			  = Форма.ВнебиржеваяСделка;
	Элементы.ГруппаРеквизитыПоручения.Видимость           = Форма.ВнебиржеваяСделка И (Форма.СделкаЧерезБрокера = 1);
	Элементы.ОтложенноеИсполнение.Доступность             = Не Форма.ВнебиржеваяСделка;
	Элементы.ОтложенноеИсполнениеВторойЧасти.Доступность  = Не Форма.ВнебиржеваяСделка;
	Элементы.ОтложенноеИсполнение1.Доступность            = Не Форма.ВнебиржеваяСделка;
	Элементы.ОтложенноеИсполнениеВторойЧасти1.Доступность = Не Форма.ВнебиржеваяСделка;
	
	Элементы.ГруппаРеквизитыКонтрагентаВнебиржевойСделки.Видимость = Форма.ВнебиржеваяСделка И ЗначениеЗаполнено(ДанныеОбъекта.Контрагент);
		
	// видимость собственного курса оплаты 1-й части
	ВидимостьСобственногоКурса = ЗначениеЗаполнено(ДанныеОбъекта.ВалютаСделки) И ЗначениеЗаполнено(ДанныеОбъекта.ВалютаОплаты)
		И ДанныеОбъекта.ВалютаСделки <> ДанныеОбъекта.ВалютаОплаты И Форма.ВнебиржеваяСделка;
	
	// видимость собственного курса оплаты 2-й части
	ВидимостьСобственногоКурсаВторойЧасти = ЗначениеЗаполнено(ДанныеОбъекта.ВалютаСделки) И ЗначениеЗаполнено(ДанныеОбъекта.ВалютаОплатыВторойЧасти)
		И ДанныеОбъекта.ВалютаСделки <> ДанныеОбъекта.ВалютаОплатыВторойЧасти И Форма.ВнебиржеваяСделка;;
	
	// режимы исполнения
	Для Инд = 1 По 2 Цикл
		Постфикс = ?(Инд = 1, "", "1");
		
		Элементы["РаздельноеИсполнение" + Постфикс].Видимость            = ДанныеОбъекта.ОтложенноеИсполнение;
		Элементы["РаздельноеИсполнениеВторойЧасти" + Постфикс].Видимость = ДанныеОбъекта.ОтложенноеИсполнениеВторойЧасти;
		
		// видимость дат исполнения и валют оплаты
		Элементы["ДатаИсполнения" + Постфикс].Видимость = ДанныеОбъекта.ОтложенноеИсполнение И Не ДанныеОбъекта.РаздельноеИсполнение;
		Элементы["ДатаОплаты" + Постфикс].Видимость     = ДанныеОбъекта.РаздельноеИсполнение;
		Элементы["ДатаПоставки" + Постфикс].Видимость   = ДанныеОбъекта.РаздельноеИсполнение;
			
		Элементы["ДатаИсполненияВторойЧасти" + Постфикс].Видимость = ДанныеОбъекта.ОтложенноеИсполнениеВторойЧасти И Не ДанныеОбъекта.РаздельноеИсполнениеВторойЧасти;
		Элементы["ДатаОплатыВторойЧасти" + Постфикс].Видимость     = ДанныеОбъекта.РаздельноеИсполнениеВторойЧасти;
		Элементы["ДатаПоставкиВторойЧасти" + Постфикс].Видимость   = ДанныеОбъекта.РаздельноеИсполнениеВторойЧасти;
	
		Элементы["СобственныйКурсОплаты" + Постфикс].Видимость = ВидимостьСобственногоКурса;
		Элементы["КурсОплаты" + Постфикс].Видимость            = ВидимостьСобственногоКурса;
		
		Элементы["КурсОплаты" + Постфикс].Доступность            = ДанныеОбъекта.СобственныйКурсОплаты;
		Элементы["КурсОплатыВторойЧасти" + Постфикс].Доступность = ДанныеОбъекта.СобственныйКурсОплатыВторойЧасти;
		
		Элементы["СобственныйКурсОплатыВторойЧасти" + Постфикс].Видимость = ВидимостьСобственногоКурсаВторойЧасти;
		Элементы["КурсОплатыВторойЧасти" + Постфикс].Видимость            = ВидимостьСобственногоКурсаВторойЧасти;
		
		Элементы["ВалютаОплаты" + Постфикс].Доступность            = Форма.ВнебиржеваяСделка;
		Элементы["ВалютаОплатыВторойЧасти" + Постфикс].Доступность = Форма.ВнебиржеваяСделка;

	КонецЦикла;
	
	// учет торговой комиссии
	Элементы.ГруппаУчетТорговойКомиссии.Видимость    = Не Форма.ВнебиржеваяСделка; 
	Элементы.ЦенныеБумагиТорговаяКомиссия.Видимость  = (Форма.ВариантыОплатыТорговойКомиссииБезДаты = 2 Или Форма.ВариантОплатыТорговойКомиссииСДатой = 1);
	Элементы.ЦенныеБумагиТорговаяКомиссия1.Видимость = (Форма.ВариантыОплатыТорговойКомиссииБезДаты = 2 Или Форма.ВариантОплатыТорговойКомиссииСДатой = 1);
	Элементы.ВалютаТорговойКомиссии.Видимость        = (Форма.ВариантыОплатыТорговойКомиссииБезДаты = 2 Или Форма.ВариантОплатыТорговойКомиссииСДатой = 1);
	Элементы.ДатаОплатыТорговойКомиссии.Видимость    = (Форма.ВариантОплатыТорговойКомиссииСДатой = 1);
	
	// прочие
	РаботаСДокументамиКлиентСервер.НастроитьВидимостьБрокераСделкиИСвязанныхРеквизитов(Форма);
	РаботаСДокументамиКлиентСервер.НастроитьВидимостьИДоступностьРасчетногоСчетаИСвязанныхРеквизитов(Форма);
	
	Элементы.ДекорацияАкцептовано.Видимость = (ЗначениеЗаполнено(ДанныеОбъекта.Ссылка) И РаботаСДокументами.ДокументАкцептован(ДанныеОбъекта.Ссылка, ДанныеОбъекта.Организация));
	
	Элементы.ОписаниеНоминалаЦеннойБумаги.Видимость = РаботаСЦеннымиБумагамиКлиентСервер.ЭтоРынокЦенныхБумагСНоминалом(ДанныеОбъекта.Рынок);
	
	//удаление значений скрываемых полей
	Если Форма.Модифицированность Тогда
		
		ПутьКДаннымСкрываемыхПолей = Новый Структура();
		
		ПутьКДаннымСкрываемыхПолей.Вставить("Брокер"                , "Объект.Брокер");
		ПутьКДаннымСкрываемыхПолей.Вставить("ДатаВторойЧастиРЕПО"   , "Объект.ДатаВторойЧастиРепо");
		ПутьКДаннымСкрываемыхПолей.Вставить("ПлатежноеУсловиеСделки", "Объект.ПлатежноеУсловиеСделки");
		
		Для Инд = 1 По 2 Цикл
			Постфикс = ?(Инд = 1, "", "1");
			
			Для Инд = 1 По 2 Цикл
				ч2 = ?(Инд = 1, "", "ВторойЧасти");
				ПутьКДаннымСкрываемыхПолей.Вставить("ДатаОплаты" + ч2 + Постфикс           , "Объект.ДатаОплаты" + ч2);
				ПутьКДаннымСкрываемыхПолей.Вставить("ДатаПоставки" + ч2 + Постфикс         , "Объект.ДатаПоставки" + ч2);
				ПутьКДаннымСкрываемыхПолей.Вставить("ДатаИсполнения" + ч2 + Постфикс       , "Объект.ДатаИсполнения" + ч2);
				ПутьКДаннымСкрываемыхПолей.Вставить("КурсОплаты" + ч2 + Постфикс           , "Объект.КурсОплаты" + ч2);
				ПутьКДаннымСкрываемыхПолей.Вставить("СобственныйКурсОплаты" + ч2 + Постфикс, "Объект.СобственныйКурсОплаты" + ч2);
			КонецЦикла;
			
		КонецЦикла;
		
		ПутьКДаннымСкрываемыхПолей.Вставить("ГруппаРеквизитыПоручения", РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("Объект.ДатаПорученияУБрокера, Объект.НомерПорученияУБрокера", ",", Истина, Истина));
		
		МассивРеквизитыКонтрагентаВнебиржевойСделки = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("Объект.Договор, Объект.НомерДоговораКонтрагента, Объект.РасчетныйСчетКонтрагента", ",", Истина, Истина);
		ПутьКДаннымСкрываемыхПолей.Вставить("ГруппаРеквизитыКонтрагентаВнебиржевойСделки", МассивРеквизитыКонтрагентаВнебиржевойСделки);
		
		МассивРеквизитыБиржевойСделки = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("Объект.НомерСделки, Объект.ВремяСделки, Объект.КодРасчетовНаБирже, Объект.СделкаСЦентральнымКонтрагентом, Объект.НомерСделкиСЦентральнымКонтрагентом, Объект.РежимБиржевыхТоргов, Объект.КонтрагентНаБирже, Объект.НеполныеЛоты, Объект.Дисконт", ",", Истина, Истина);
		
		Если Не Форма.ВнебиржеваяСделка Тогда 
			МассивРеквизитыБиржевойСделки.Добавить("Объект.МестоХранения");	
		КонецЕсли;
		
		ПутьКДаннымСкрываемыхПолей.Вставить("ГруппаРеквизитыБиржевойСделки", МассивРеквизитыБиржевойСделки);
		
		ПутьКДаннымСкрываемыхПолей.Вставить("ДатаОплатыТорговойКомиссии", "Объект.ДатаОплатыТорговойКомиссии");
		ПутьКДаннымСкрываемыхПолей.Вставить("ВалютаТорговойКомиссии"    , "Объект.ВалютаТорговойКомиссии");
		
		Если Форма.КорзинаЦенныхБумаг Тогда
			ПутьКДаннымСкрываемыхПолей.Вставить("ЦенныеБумагиТорговаяКомиссия", "Объект.ЦенныеБумаги.ТорговаяКомиссия");
		Иначе
			ПутьКДаннымСкрываемыхПолей.Вставить("ЦенныеБумагиТорговаяКомиссия1", "ЦенныеБумагиТорговаяКомиссия1");
		КонецЕсли;
				                                               
		РаботаСФормамиКлиентСервер.ОчиститьЗначенияСкрытыхПолей(Форма, ПутьКДаннымСкрываемыхПолей);	
	КонецЕсли;
	
КонецПроцедуры // НастроитьВидимостьИДоступность

&НаСервере
Функция ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере(ИмяКорзиныЦенныхБумаг = Неопределено, ИдСтрокиКорзины = Неопределено) Экспорт

	Если ЗначениеЗаполнено(ИмяКорзиныЦенныхБумаг) Тогда
	
		НомерСтрокиКорзины = ?(ИдСтрокиКорзины = Неопределено, Неопределено,
			Объект[ИмяКорзиныЦенныхБумаг].Индекс(Объект[ИмяКорзиныЦенныхБумаг].НайтиПоИдентификатору(ИдСтрокиКорзины)));
		
		РаботаСКорзинойЦенныхБумагКлиентСервер.ЗаполнитьНоминалыЦенныхБумагИСуммыВсего(ЭтаФорма, Объект, ИмяКорзиныЦенныхБумаг, НомерСтрокиКорзины);
		
	Иначе
		
		РаботаСКорзинойЦенныхБумагКлиентСервер.ЗаполнитьНоминалыЦенныхБумагИСуммыВсего(ЭтаФорма, Объект, "ЦенныеБумаги");
		
		РаботаСКорзинойЦенныхБумагКлиентСервер.ЗаполнитьНоминалыЦенныхБумагИСуммыВсего(ЭтаФорма, Объект, "ЦенныеБумагиВторойЧасти");
		
	КонецЕсли;

КонецФункции // ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ЭтаФорма.УстановитьПараметрыФункциональныхОпцийФормы(Новый Структура("Организация", Объект.Организация));
	
	ЭтаФорма.СделкаЧерезБрокера           = ЗначениеЗаполнено(Объект.Брокер);
	ЭтаФорма.ДетализацияПоРасчетномуСчету = РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(Объект);
	ЭтаФорма.ВнебиржеваяСделка            = (Объект.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок);
	
	ОбщаяСуммаТорговойКомиссии = Объект.ЦенныеБумаги.Итог("ТорговаяКомиссия");
	
	Если ОбщаяСуммаТорговойКомиссии > 0 Тогда
		Если Объект.ОтложеннаяОплатаТорговойКомиссии Тогда
			ЭтаФорма.ВариантОплатыТорговойКомиссииСДатой = 1;
		Иначе
			ЭтаФорма.ВариантыОплатыТорговойКомиссииБезДаты = 2;
		КонецЕсли;
	Иначе
		ЭтаФорма.ВариантыОплатыТорговойКомиссииБезДаты = 1;
	КонецЕсли;
	
	Если ЭтаФорма.ТолькоПросмотр Тогда
		ЭтаФорма.Элементы.КомандаИзменитьРеквизитыБиржевойСделки.Заголовок = "Открыть";	
	КонецЕсли;
	
	ЗаполнитьОписаниеРеквизитовБиржевойСделки(ЭтаФорма);
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.НастроитьОтображение(ЭтаФорма, Истина);
		
	Если Не Объект.Ссылка.Пустая() Тогда
		
		ЭтаФорма.РаскрытыйКонтрагент = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(Неопределено, "_РаскрытыйКонтрагент", Объект.Ссылка);
		
		Если ЗначениеЗаполнено(ЭтаФорма.РаскрытыйКонтрагент) Тогда
			ЭтаФорма.Элементы.ГиперссылкаРаскрытыйКонтрагент.Заголовок = ЭтаФорма.РаскрытыйКонтрагент;
		ИначеЕсли ЭтаФорма.ТолькоПросмотр И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РежимБиржевыхТоргов, "РЕПО_М") Тогда
			ЭтаФорма.Элементы.ГиперссылкаРаскрытыйКонтрагент.Заголовок = "Не указан";
		Иначе
			ЭтаФорма.Элементы.ГиперссылкаРаскрытыйКонтрагент.Заголовок = "Выбрать";
		КонецЕсли;
		
	КонецЕсли;
	
	// отработаем недостающий функционал для условий 2-й части
	Если Объект.ЦенныеБумагиВторойЧасти.Количество() = Объект.ЦенныеБумаги.Количество() Тогда
		Для Инд = 0 По Объект.ЦенныеБумаги.Количество() - 1 Цикл
			Объект.ЦенныеБумагиВторойЧасти[Инд].Идентификатор = Объект.ЦенныеБумаги[Инд].ПолучитьИдентификатор();
		КонецЦикла;
	Иначе
		// как оказалось, такое тоже бывает(
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Список ценных бумаг 2-й части заполнен некорректно. Вкл. режим 'Корзина ценных бумаг' и заполните его вручную", ЭтаФорма, "ФормаКомандаКорзинаЦенныхБумаг");
	КонецЕсли;
	
	Элементы.ЦенныеБумагиВторойЧастиЦеннаяБумага.ОграничениеТипа = РаботаСЦеннымиБумагамиКлиентСервер.ТипЦеннойБумагиВЗависимостиОтРынка(Объект.Рынок);
	
	Если Не ЭтаФорма.КорзинаЦенныхБумаг Тогда
		РаботаСКорзинойЦенныхБумагКлиентСервер.ОбновитьРеквизитыПриИзмененииРежима(ЭтаФорма, Объект, "ЦенныеБумагиВторойЧасти");
	КонецЕсли;	
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.НастроитьВидимостьДоступностьПолейВЗависимостиОтРынка(ЭтаФорма, "ЦенныеБумагиВторойЧасти");
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	ЭтаФорма.ВидСделки = "РЕПО";
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры // ПриЧтенииСозданииНаСервере

&НаКлиенте
Процедура СинхронизироватьОбщиеУсловияЦенныхБумаг()
	
	// синхронизируем состав строк относительно условий 1-й части
	Для НомУсловия = 0 По Объект.ЦенныеБумаги.Количество() - 1 Цикл
		
		СтрокаЦенныеБумаги = Объект.ЦенныеБумаги[НомУсловия];
		Идентификатор      = СтрокаЦенныеБумаги.ПолучитьИдентификатор();
		
		СтрокиУсловийВторойЧасти = Объект.ЦенныеБумагиВторойЧасти.НайтиСтроки(Новый Структура("Идентификатор", Идентификатор));
		
		Если      СтрокиУсловийВторойЧасти.Количество() = 0 Тогда
			// добавим новую строку
			СтрокаЦенныеБумагиВторойЧасти = Объект.ЦенныеБумагиВторойЧасти.Вставить(НомУсловия);
			СтрокаЦенныеБумагиВторойЧасти.Идентификатор = Идентификатор;
			
		ИначеЕсли СтрокиУсловийВторойЧасти.Количество() = 1 Тогда
			СтрокаЦенныеБумагиВторойЧасти = СтрокиУсловийВторойЧасти[0];
			
			// проверим, а на своем ли месте указанная строка
			НомСтроки = Объект.ЦенныеБумагиВторойЧасти.Индекс(СтрокаЦенныеБумагиВторойЧасти);
			Если НомСтроки <> НомУсловия Тогда
				Объект.ЦенныеБумагиВторойЧасти.Сдвинуть(НомСтроки, НомУсловия - НомСтроки);
			КонецЕсли;
			
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внутренняя ошибка синхронизации условий 1-й и 2-й частей РЕПО. Обратитесь к разработчикам.");
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// учтем возможное удаление строк из условия 1-й части
	Для НомСтроки = 1 - Объект.ЦенныеБумагиВторойЧасти.Количество() По 0 Цикл
		Если Объект.ЦенныеБумаги.НайтиПоИдентификатору(Объект.ЦенныеБумагиВторойЧасти[-НомСтроки].Идентификатор) = Неопределено Тогда
			Объект.ЦенныеБумагиВторойЧасти.Удалить(-НомСтроки);
		КонецЕсли;
	КонецЦикла;
	
	// синхронизируем содержание реквизитов
	ОбщиеРеквизиты = ПолучитьОбщиеРеквизитыКорзиныЦенныхБумаг();
	
	ОбщиеРеквизиты.Добавить("Номинал");
	ОбщиеРеквизиты.Добавить("ВалютаНоминала");
	
	Для НомУсловия = 0 По Объект.ЦенныеБумаги.Количество() - 1 Цикл
		
		// на всякий случай, на последок, проверим соответствие идентификаторов
		Если Объект.ЦенныеБумаги[НомУсловия].ПолучитьИдентификатор() <> Объект.ЦенныеБумагиВторойЧасти[НомУсловия].Идентификатор Тогда
			Сообщить("Внутренняя ошибка синхронизации условий 1-й и 2-й частей РЕПО. Обратитесь к разработчикам.");
			Возврат;
		КонецЕсли;
		
		Для каждого ОбщийРеквизит Из ОбщиеРеквизиты Цикл
			Если Объект.ЦенныеБумагиВторойЧасти[НомУсловия][ОбщийРеквизит] <> Объект.ЦенныеБумаги[НомУсловия][ОбщийРеквизит] Тогда
				Объект.ЦенныеБумагиВторойЧасти[НомУсловия][ОбщийРеквизит] = Объект.ЦенныеБумаги[НомУсловия][ОбщийРеквизит];
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры // СинхронизироватьОбщиеУсловияЦенныхБумаг

&НаСервере
Процедура ЗаполнитьПодтверждениеОперацииНаСервере()

	РаботаСДокументами.ЗаполнитьПодтверждениеОперации(ЭтаФорма, Объект.Ссылка);		

КонецПроцедуры

#Область СОБЫТИЯ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.ЧастьСделкиРЕПО = 2 Тогда
		Сообщить("Для 2-й части РЕПО необходимо воспользоваться формой ФормаВторойЧастиРЕПО.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	// т.к. страницами удобно пользоваться на этапе разработки, отключим их на этапе исполнения
	Элементы.ГруппаУсловияРЕПО2.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	
	ПриЧтенииСозданииНаСервере();

КонецПроцедуры // ПриСозданииНаСервере

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;

КонецПроцедуры // ПриЧтенииНаСервере

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтаФорма.СделкаЧерезБрокера = 1 И Не ЗначениеЗаполнено(Объект.Брокер) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Значение поля ""Брокер"" не заполнено",, "Объект.Брокер",, Отказ);
	КонецЕсли;
	
	Если ЭтаФорма.ДетализацияПоРасчетномуСчету И Не ЗначениеЗаполнено(Объект.РасчетныйСчет) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Значение поля ""Расчетный счет"" не заполнено",, "Объект.РасчетныйСчет",, Отказ);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Не ЭтаФорма.КорзинаЦенныхБумаг Тогда
		РаботаСКорзинойЦенныхБумагКлиентСервер.ПеренестиРеквизитыИзФормыВТаблицу(ЭтаФорма);
		РаботаСКорзинойЦенныхБумагКлиентСервер.ПеренестиРеквизитыИзФормыВТаблицу(ЭтаФорма, "ЦенныеБумагиВторойЧасти");
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() И ЗначениеЗаполнено(ЭтаФорма.РаскрытыйКонтрагент) Тогда
		ПараметрыЗаписи.Вставить("РаскрытыйКонтрагентВДопСведения");	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// после записи теряются значения реквизитов, добавленных к т.ч. объекта
	Если ЭтаФорма.КорзинаЦенныхБумаг Тогда
		ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере("ЦенныеБумаги");
		ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере("ЦенныеБумагиВторойЧасти");
	КонецЕсли;

	ЗаполнитьПодтверждениеОперацииНаСервере();
	
	Если ПараметрыЗаписи.Свойство("РаскрытыйКонтрагентВДопСведения") Тогда
		РаботаСФормами.ЗаписатьЗначениеДополнительногоСведенияОбъекта(Объект.Ссылка, "_РаскрытыйКонтрагент", ЭтаФорма.РаскрытыйКонтрагент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
		
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
	РаботаСДокументамиКлиент.ПроверитьПараметрыПодтвержденияОперации(ЭтаФорма, Объект, ПараметрыЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ПодтверждениеОперации" Тогда
		Если Параметр = Объект.Ссылка
			ИЛИ (ТипЗнч(Параметр) = Тип("Массив") И Параметр.Найти(Объект.Ссылка) <> Неопределено)
		Тогда
			ЗаполнитьПодтверждениеОперацииНаСервере();
		КонецЕсли;
	Иначе		
		РаботаСДокументамиКлиент.ОбработкаОповещенияФормыДокумента(ЭтаФорма, Объект.Ссылка, ИмяСобытия, Параметр, Источник);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СОБЫТИЯ_ЭЛЕМЕНТОВ_ФОРМЫ

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
	ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере("ЦенныеБумаги");
	ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере("ЦенныеБумагиВторойЧасти");
	
	РаботаСДокументамиКлиент.ДетализацияПоРасчетномуСчетуПриИзмененииСвязанныхРеквизитов(ЭтаФорма);
	
	Если Не РаботаСИсполнителями.ЕстьИсполнитель(?(ЭтаФорма.СделкаЧерезБрокера = 1, "ИсполнителиПоДенежнымСредствамБрокерские", "ИсполнителиПоДенежнымСредствамСобственные"),
		ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(Объект, "Дата, Организация, СчетДоверительногоУправления, Брокер, РасчетныйСчет"))
	Тогда
		Объект.РасчетныйСчет = Неопределено;
	КонецЕсли;
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ПриИзмененииДаты(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаВторойЧастиРЕПОПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.ДатаВторойЧастиРЕПО) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = "";
	
	Если Объект.РаздельноеИсполнениеВторойЧасти Тогда
		Если (ЗначениеЗаполнено(Объект.ДатаОплатыВторойЧасти) Или ЗначениеЗаполнено(Объект.ДатаПоставкиВторойЧасти))
			И (Объект.ДатаОплатыВторойЧасти <> Объект.ДатаВторойЧастиРЕПО Или Объект.ДатаПоставкиВторойЧасти <> Объект.ДатаВторойЧастиРЕПО)
		Тогда
			ТекстВопроса = "Изменить даты оплаты и поставки на ";
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(Объект.ДатаИсполненияВторойЧасти) И Объект.ДатаИсполненияВторойЧасти <> Объект.ДатаВторойЧастиРЕПО Тогда
			ТекстВопроса = "Изменить дату исполнения на ";
		КонецЕсли;
	КонецЕсли;

	Если Не ПустаяСтрока(ТекстВопроса) Тогда
		Если Вопрос(ТекстВопроса + Формат(Объект.ДатаВторойЧастиРЕПО, "ДФ=dd.MM.yyyy") + "?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.РаздельноеИсполнениеВторойЧасти Тогда
		Объект.ДатаОплатыВторойЧасти     = Объект.ДатаВторойЧастиРЕПО;
		Объект.ДатаПоставкиВторойЧасти   = Объект.ДатаВторойЧастиРЕПО;
	Иначе
		Объект.ДатаИсполненияВторойЧасти = Объект.ДатаВторойЧастиРЕПО;
	КонецЕсли;

КонецПроцедуры // ДатаВторойЧастиРЕПОПриИзменении

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
		
	НастроитьВидимостьИДоступность(ЭтаФорма);	
	
КонецПроцедуры

&НаКлиенте
Процедура СделкаЧерезБрокераПриИзменении(Элемент)
	
	Объект.РасчетныйСчет = Неопределено; // т.к. связь параметров выбора не отрабатывает при программном изменении брокера
	 	
	БрокерПриИзменении(Неопределено);
		
КонецПроцедуры

&НаКлиенте
Процедура БрокерПриИзменении(Элемент)
	
	Если СделкаЧерезБрокера = 0 Тогда
		Объект.Брокер = Неопределено;
	КонецЕсли;
	
	ЭтаФорма.ДетализацияПоРасчетномуСчету = РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(Новый Структура("Дата, Организация, Брокер", Объект.Дата, Объект.Организация, Объект.Брокер));
	
	НастроитьВидимостьИДоступность(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура РасчетныйСчетПриИзменении(Элемент)
		
	Если ЗначениеЗаполнено(Объект.РасчетныйСчет) Тогда
		ВалютаРасчетногоСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РасчетныйСчет, "Валюта");
	Иначе
		Возврат;
	КонецЕсли;
	
	Если Объект.ВалютаОплаты <> ВалютаРасчетногоСчета Тогда
		Объект.ВалютаОплаты = ВалютаРасчетногоСчета;
	КонецЕсли;
	
	Если Объект.ВалютаОплатыВторойЧасти <> ВалютаРасчетногоСчета Тогда
		Объект.ВалютаОплатыВторойЧасти = ВалютаРасчетногоСчета;	
	КонецЕсли;
	
	Если Не ЭтаФорма.ВнебиржеваяСделка И Объект.ВалютаСделки <> ВалютаРасчетногоСчета Тогда
		Объект.ВалютаСделки = Неопределено;
	КонецЕсли;

	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВнебиржеваяСделкаПриИзменении(Элемент)
	
	// очистим сведения о биржевой сделке при выборе внебиржи и наоборот
	Если ЭтаФорма.ВнебиржеваяСделка Тогда	
		Объект.МестоХранения = ПредопределенноеЗначение("Справочник.МестаХранения.ВнебиржевойРынок");
		
		ЭтаФорма.ВариантыОплатыТорговойКомиссииБезДаты = 1;
		ЭтаФорма.ВариантОплатыТорговойКомиссииСДатой   = 0;
		Объект.ОтложеннаяОплатаТорговойКомиссии        = Ложь;
	Иначе
		Объект.МестоХранения = Неопределено; 
	КонецЕсли;
	
	ВалютаСделкиПриИзменении(Неопределено);
	
	// для биржи характерно наличие двух сделок, для внебрижи - одной
	Объект.ДвеЧастиСделкиРЕПО = Не ЭтаФорма.ВнебиржеваяСделка;
	Объект.ЧастьСделкиРЕПО    = ?(Объект.ДвеЧастиСделкиРЕПО, 1, 0);
		
	// для биржи характерно мгновенное исполнение, для внебиржи - отложенное
	Объект.ОтложенноеИсполнение            = ЭтаФорма.ВнебиржеваяСделка;
	Объект.ОтложенноеИсполнениеВторойЧасти = ЭтаФорма.ВнебиржеваяСделка;
	
	Объект.РаздельноеИсполнение            = Ложь;
	Объект.РаздельноеИсполнениеВторойЧасти = Ложь;
	
	Объект.ДатаИсполнения            = ?(ЭтаФорма.ВнебиржеваяСделка, Объект.Дата, Неопределено);
	Объект.ДатаИсполненияВторойЧасти = ?(ЭтаФорма.ВнебиржеваяСделка, Объект.Дата, Неопределено);
			
	Если Не ЭтаФорма.ВнебиржеваяСделка Тогда
