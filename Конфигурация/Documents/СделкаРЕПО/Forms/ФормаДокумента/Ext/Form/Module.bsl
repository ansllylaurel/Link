&НаКлиенте
Процедура ДекорацияРаскрытыйКонтрагентНажатие(Элемент)
	
	ЭтоРЕПО_М = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РежимБиржевыхТоргов, "РЕПО_М");
	РазрешитьРедактирование = Не (ЭтоРЕПО_М И ЭтаФорма.ТолькоПросмотр);
	
	Если ЗначениеЗаполнено(ЭтаФорма.РаскрытыйКонтрагент) Тогда
		
		СписокДействий = Новый СписокЗначений();
		СписокДействий.Добавить("Открыть");
		
		Если РазрешитьРедактирование Тогда
		
			СписокДействий.Добавить("Изменить");
			СписокДействий.Добавить("Очистить");	
		
		КонецЕсли;
				
		Действие = ЭтаФорма.ВыбратьИзМеню(СписокДействий, ЭтаФорма.Элементы.ГиперссылкаРаскрытыйКонтрагент);
		
		Если Действие = Неопределено Тогда
			
			Возврат;
			
		ИначеЕсли Действие.Значение = "Открыть" Тогда
			ОткрытьЗначение(ЭтаФорма.РаскрытыйКонтрагент);
			
		ИначеЕсли Действие.Значение = "Изменить" Тогда
			
			Если ВвестиЗначение(ЭтаФорма.РаскрытыйКонтрагент, "Раскрытый контрагент", Тип("СправочникСсылка.ЮрФизЛица")) Тогда
				
				Если Не Объект.Ссылка.Пустая() Тогда
					РаботаСФормами.ЗаписатьЗначениеДополнительногоСведенияОбъекта(Объект.Ссылка, "_РаскрытыйКонтрагент", ЭтаФорма.РаскрытыйКонтрагент);
				КонецЕсли;
												
			КонецЕсли;
						
		ИначеЕсли Действие.Значение = "Очистить" Тогда
			
			ЭтаФорма.РаскрытыйКонтрагент = Неопределено;
			
			Если Не Объект.Ссылка.Пустая() Тогда
				РаботаСФормами.ЗаписатьЗначениеДополнительногоСведенияОбъекта(Объект.Ссылка, "_РаскрытыйКонтрагент", ЭтаФорма.РаскрытыйКонтрагент);
			КонецЕсли;
	
		КонецЕсли;
		
	Иначе
			
		Если РазрешитьРедактирование И ВвестиЗначение(ЭтаФорма.РаскрытыйКонтрагент, "Раскрытый контрагент", Тип("СправочникСсылка.ЮрФизЛица")) Тогда
			
			Если Не Объект.Ссылка.Пустая() Тогда
				РаботаСФормами.ЗаписатьЗначениеДополнительногоСведенияОбъекта(Объект.Ссылка, "_РаскрытыйКонтрагент", ЭтаФорма.РаскрытыйКонтрагент);
			КонецЕсли;
								
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтаФорма.РаскрытыйКонтрагент) Тогда
		ЭтаФорма.Элементы.ГиперссылкаРаскрытыйКонтрагент.Заголовок = ЭтаФорма.РаскрытыйКонтрагент;
	ИначеЕсли РазрешитьРедактирование Тогда
		ЭтаФорма.Элементы.ГиперссылкаРаскрытыйКонтрагент.Заголовок = "Выбрать";	
	Иначе
		ЭтаФорма.Элементы.ГиперссылкаРаскрытыйКонтрагент.Заголовок = "Не указан";
	КонецЕсли;

КонецПроцедуры

