&НаСервереБезКонтекста
Функция ПолучитьСписокПартий(Регистратор, ЦеннаяБумага)
	
	СписокПартий = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
       |	БухПартииЦенныхБумаг.Партия,
       |	БухПартииЦенныхБумаг.СтрокаПартии
       |ИЗ
       |	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
       |ГДЕ
       |	БухПартииЦенныхБумаг.Регистратор = &Регистратор
       |	И БухПартииЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага
       |	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
       |	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
       |
       |СГРУППИРОВАТЬ ПО
       |	БухПартииЦенныхБумаг.СтрокаПартии,
       |	БухПартииЦенныхБумаг.ВидДвижения,
       |	БухПартииЦенныхБумаг.Партия";

	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокПартий.Добавить(Новый Структура("Партия, СтрокаПартии", Выборка.Партия, Выборка.СтрокаПартии), Строка(Выборка.Партия) + ". Строка партии:" +  Выборка.СтрокаПартии);
	КонецЦикла;
	
	Возврат СписокПартий;
	
КонецФункции	

&НаКлиенте
Процедура КомандаИзменитьРеквизитыБиржевойСделки(Команда)
	ПараметрыФормы = Новый Структура("МестоХранения, НомерЗаявки, НомерСделки, ВремяСделки, КодРасчетовНаБирже, НеполныеЛоты, "
		+ "КонтрагентНаБирже, СделкаСЦентральнымКонтрагентом, НомерСделкиСЦентральнымКонтрагентом, РежимБиржевыхТоргов, Дисконт");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ПараметрыФормы.Вставить("ТолькоПросмотр", ЭтаФорма.ТолькоПросмотр);
	
	НовыеЗнчРеквизитовБиржевойСделки = ОткрытьФормуМодально("Документ.СделкаРЕПО.Форма.РеквизитыБиржевойСделки", ПараметрыФормы, ЭтаФорма);
	
	Если Не ЭтаФорма.ТолькоПросмотр Тогда
		Если ТипЗнч(НовыеЗнчРеквизитовБиржевойСделки) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(Объект, НовыеЗнчРеквизитовБиржевойСделки);
			ЭтаФорма.Модифицированность = Истина;
		КонецЕсли;
		
		ЗаполнитьОписаниеРеквизитовБиржевойСделки(ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаКорзинаЦенныхБумаг(Команда)
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ИзменитьРежим(ЭтаФорма);
	
	// отработаем недостающий функционал для условий 2-й части
	РаботаСКорзинойЦенныхБумагКлиентСервер.ОбновитьРеквизитыПриИзмененииРежима(ЭтаФорма, Объект, "ЦенныеБумагиВторойЧасти");
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ЗаполнитьИтоговуюСтроку(Элементы.ИтоговаяСтрокаЦенныеБумагиВторойЧасти, Объект.Рынок, Объект.ЦенныеБумагиВторойЧасти);
	
