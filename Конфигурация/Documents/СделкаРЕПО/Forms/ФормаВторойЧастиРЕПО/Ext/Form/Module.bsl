		Объект.ВалютаОплаты = Неопределено;
		
		Если Не ЭтаФорма.ВнебиржеваяСделка Тогда
			Объект.ВалютаСделки = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	НастроитьВидимостьДоступность(ЭтаФорма);
		
КонецПроцедуры

