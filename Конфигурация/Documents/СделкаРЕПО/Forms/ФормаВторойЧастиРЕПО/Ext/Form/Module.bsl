
&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьОписаниеРеквизитовБиржевойСделки(Форма)
	
	ДанныеОбъекта = Форма.Объект;
	
	// 1-я подстрока инф. строки: "Сделка [с ЦК] № 1980281955[/1980281954] на бирже ММВБ-РТС [с контрагентом Пупкин В. И.]" 
	ОписаниеРеквизитовБиржевойСделки1 =
		?(ДанныеОбъекта.СделкаСЦентральнымКонтрагентом,
			"Сделка с ЦК № " + ?(ЗначениеЗаполнено(ДанныеОбъекта.НомерСделки), ДанныеОбъекта.НомерСделки, "<Не задан>") + " / " + ?(ЗначениеЗаполнено(ДанныеОбъекта.НомерСделкиСЦентральнымКонтрагентом), ДанныеОбъекта.НомерСделкиСЦентральнымКонтрагентом, "<Не задан>"),
			"Сделка № " + ?(ЗначениеЗаполнено(ДанныеОбъекта.НомерСделки), ДанныеОбъекта.НомерСделки, "<Не задан>"))
		+ " на бирже " + ?(ЗначениеЗаполнено(ДанныеОбъекта.МестоХранения), Строка(ДанныеОбъекта.МестоХранения), "<Не задана>");
		
	Если Не ПустаяСтрока(ДанныеОбъекта.КонтрагентНаБирже) Тогда
		ОписаниеРеквизитовБиржевойСделки1 = ОписаниеРеквизитовБиржевойСделки1 + " с контрагентом " + ?(ПустаяСтрока(ДанныеОбъекта.КонтрагентНаБирже), "<Не задан>", Строка(ДанныеОбъекта.КонтрагентНаБирже));
	КонецЕсли;
	
	// 2-я подстрока инф. строки: "[, Код расчетов S0] [, неполные лоты] [, режим переговорных сделок (РПС)]"
	ОписаниеРеквизитовБиржевойСделки2 = "";
		
	Если Не ПустаяСтрока(ДанныеОбъекта.КодРасчетовНаБирже) Тогда
		ОписаниеРеквизитовБиржевойСделки2 = ОписаниеРеквизитовБиржевойСделки2 + "Код расчетов " + ДанныеОбъекта.КодРасчетовНаБирже;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ДанныеОбъекта.РежимБиржевыхТоргов) Тогда
		
		ОписаниеРеквизитовБиржевойСделки2 = ОписаниеРеквизитовБиржевойСделки2 
		+ ?(ОписаниеРеквизитовБиржевойСделки2="", "Режим торгов ",", режим торгов ") + ДанныеОбъекта.РежимБиржевыхТоргов;
		
		Если ЗначениеЗаполнено(ДанныеОбъекта.Дисконт) Тогда
		
			ОписаниеРеквизитовБиржевойСделки2 = ОписаниеРеквизитовБиржевойСделки2 
			+ ?(ОписаниеРеквизитовБиржевойСделки2 = "", "Дисконт ", ", дисконт ") + ДанныеОбъекта.Дисконт;
		
		КонецЕсли;
		
	КонецЕсли;
	
	ОписаниеРеквизитовБиржевойСделки2 = ОписаниеРеквизитовБиржевойСделки2 + ?(Не ДанныеОбъекта.НеполныеЛоты, "", ?(Не ПустаяСтрока(ОписаниеРеквизитовБиржевойСделки2), ", ", "") + "неполные лоты");
		
	// итого
	Форма.Элементы.ОписаниеРеквизитовБиржевойСделки.Заголовок = ОписаниеРеквизитовБиржевойСделки1
		+ ?(Не ПустаяСтрока(ОписаниеРеквизитовБиржевойСделки2), ", " + Символы.ПС, "") + ОписаниеРеквизитовБиржевойСделки2;
				
КонецПроцедуры // ЗаполнитьОписаниеРеквизитовБиржевойСделки

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступность(Форма)
	
	Элементы      = Форма.Элементы;
	ДанныеОбъекта = Форма.Объект;
	
	// видимость реквизитов, уникальных для биржевой и внебиржевой сделок
	Элементы.Брокер.Видимость                        = (Форма.СделкаЧерезБрокера = 1);
	Элементы.ГруппаРеквизитыБиржевойСделки.Видимость = Не Форма.ВнебиржеваяСделка;
	Элементы.ГруппаРеквизитыКонтрагентаВнебиржевойСделки.Видимость = Форма.ВнебиржеваяСделка И ЗначениеЗаполнено(ДанныеОбъекта.Контрагент);
	
	// режимы исполнения
	Постфикс = ?(Форма.КорзинаЦенныхБумаг, "", "1");
	
	Элементы["РаздельноеИсполнение" + Постфикс].Видимость = ДанныеОбъекта.ОтложенноеИсполнение;
	
	// видимость дат исполнения и валют оплаты
	Элементы["ДатаИсполнения" + Постфикс].Видимость = ДанныеОбъекта.ОтложенноеИсполнение И Не ДанныеОбъекта.РаздельноеИсполнение;
	Элементы["ДатаОплаты" + Постфикс].Видимость     = ДанныеОбъекта.РаздельноеИсполнение;
	Элементы["ДатаПоставки" + Постфикс].Видимость   = ДанныеОбъекта.РаздельноеИсполнение;
	
	// видимость собственного курса оплаты 1-й части
	ВидимостьСобственногоКурса = ЗначениеЗаполнено(ДанныеОбъекта.ВалютаСделки) И ЗначениеЗаполнено(ДанныеОбъекта.ВалютаОплаты)
		И ДанныеОбъекта.ВалютаСделки <> ДанныеОбъекта.ВалютаОплаты И Форма.ВнебиржеваяСделка;
	
	Элементы["СобственныйКурсОплаты" + Постфикс].Видимость = ВидимостьСобственногоКурса;
	Элементы["КурсОплаты" + Постфикс].Видимость            = ВидимостьСобственногоКурса;
	Элементы["КурсОплаты" + Постфикс].Доступность          = ДанныеОбъекта.СобственныйКурсОплаты;
	Элементы["ВалютаОплаты" + Постфикс].Доступность        = Форма.ВнебиржеваяСделка;
		
	// прочие
	Элементы.Брокер.Видимость = (Форма.СделкаЧерезБрокера = 1); // брокерская комиссия для 2-й части РЕПО не актуальна, поэтому не используется вызов общей функции
	
	Элементы.ОписаниеНоминалаЦеннойБумаги.Видимость = РаботаСЦеннымиБумагамиКлиентСервер.ЭтоРынокЦенныхБумагСНоминалом(ДанныеОбъекта.Рынок);
	
	РаботаСДокументамиКлиентСервер.НастроитьВидимостьИДоступностьРасчетногоСчетаИСвязанныхРеквизитов(Форма);
	
	//удаление значений скрываемых полей
	Если Форма.Модифицированность Тогда
		
		ПутьКДаннымСкрываемыхПолей = Новый Структура();

		ПутьКДаннымСкрываемыхПолей.Вставить("Брокер"                           , "Объект.Брокер");				
		ПутьКДаннымСкрываемыхПолей.Вставить("ДатаОплаты" + Постфикс            , "Объект.ДатаОплаты");
		ПутьКДаннымСкрываемыхПолей.Вставить("ДатаПоставки" + Постфикс          , "Объект.ДатаПоставки");
		ПутьКДаннымСкрываемыхПолей.Вставить("ВалютаОплаты" + Постфикс          , "Объект.ВалютаОплаты");
		ПутьКДаннымСкрываемыхПолей.Вставить("ДатаИсполнения" + Постфикс        , "Объект.ДатаИсполнения");
		ПутьКДаннымСкрываемыхПолей.Вставить("КурсОплаты" + Постфикс            , "Объект.КурсОплаты");
		ПутьКДаннымСкрываемыхПолей.Вставить("СобственныйКурсОплаты" + Постфикс , "Объект.СобственныйКурсОплаты");
		
		МассивРеквизитыКонтрагента    = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("Объект.РасчетныйСчетКонтрагента", ",", Истина, Истина);
		МассивРеквизитыБиржевойСделки = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("Объект.НомерСделки, Объект.ВремяСделки, Объект.КодРасчетовНаБирже, Объект.СделкаСЦентральнымКонтрагентом, Объект.НомерСделкиСЦентральнымКонтрагентом, Объект.РежимБиржевыхТоргов, Объект.КонтрагентНаБирже, Объект.НеполныеЛоты, Объект.Дисконт", ",", Истина, Истина);
		
		Если Не Форма.ВнебиржеваяСделка Тогда //для внебиржевой сделки значение недоступно для редактирования, значение отражается в декорации.
			МассивРеквизитыБиржевойСделки.Добавить("Объект.МестоХранения");	
		КонецЕсли;
		
		ПутьКДаннымСкрываемыхПолей.Вставить("ГруппаРеквизитыКонтрагентаВнебиржевойСделки", МассивРеквизитыКонтрагента);	
		ПутьКДаннымСкрываемыхПолей.Вставить("ГруппаРеквизитыБиржевойСделки"              , МассивРеквизитыБиржевойСделки);
											                                               
		РаботаСФормамиКлиентСервер.ОчиститьЗначенияСкрытыхПолей(Форма, ПутьКДаннымСкрываемыхПолей);
		
	КонецЕсли;
	
КонецПроцедуры // НастроитьВидимостьДоступность

&НаСервере
Процедура ЗаполнитьВторуюЧастьРЕПОНаОснованииПервойЧастиНаСервере()
	
	ОбъектНаСервере = ЭтаФорма.РеквизитФормыВЗначение("Объект");
	ОбъектНаСервере.ЗаполнитьВторуюЧастьРЕПОНаОснованииПервойЧасти(Объект.ПерваяЧастьРЕПО);
	
	ЭтаФорма.ЗначениеВРеквизитФормы(ОбъектНаСервере, "Объект");
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры // ЗаполнитьВторуюЧастьРЕПОНаОснованииПервойЧастиНаСервере

&НаСервере
Функция ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере(ИдСтрокиКорзины = Неопределено) Экспорт

	НомерСтрокиКорзины = ?(ИдСтрокиКорзины = Неопределено, Неопределено,
		Объект.ЦенныеБумаги.Индекс(Объект.ЦенныеБумаги.НайтиПоИдентификатору(ИдСтрокиКорзины)));
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ЗаполнитьНоминалыЦенныхБумагИСуммыВсего(ЭтаФорма, Объект,, НомерСтрокиКорзины);

КонецФункции // ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ЭтаФорма.СделкаЧерезБрокера           = ?(ЗначениеЗаполнено(Объект.Брокер), 1, 0);
	ЭтаФорма.ДетализацияПоРасчетномуСчету = РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(Объект);
	ЭтаФорма.ВнебиржеваяСделка            = (Объект.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок);
	ЭтаФорма.ТекущаяПерваяЧастьРЕПО       = Объект.ПерваяЧастьРЕПО;
	
	Если ЭтаФорма.ТолькоПросмотр Тогда
		ЭтаФорма.Элементы.КомандаИзменитьСведенияОБиржевойСделке.Заголовок = "Открыть";	
	КонецЕсли;

	ЗаполнитьОписаниеРеквизитовБиржевойСделки(ЭтаФорма);
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.НастроитьОтображение(ЭтаФорма, Истина);
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);

	ЭтаФорма.ВидСделки = "РЕПО";
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры // ПриЧтенииСозданииНаСервере

&НаСервере
Процедура ЗаполнитьПодтверждениеОперацииНаСервере()

	РаботаСДокументами.ЗаполнитьПодтверждениеОперации(ЭтаФорма, Объект.Ссылка);		

КонецПроцедуры

&НаКлиенте
Процедура СверитьВалютуОплатыСВалютойРасчетногоСчета()
	
	Если ЗначениеЗаполнено(Объект.РасчетныйСчет) Тогда
		ВалютаРасчетногоСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РасчетныйСчет, "Валюта");
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ВалютаОплаты) И Объект.ВалютаОплаты <> ВалютаРасчетногоСчета Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Валюта расчетного счета не соответствует валюте оплаты" + ?(ЭтаФорма.ВнебиржеваяСделка, "", " и валюте сделки") + ".",, "Объект.РасчетныйСчет");	
	КонецЕсли;
	
КонецПроцедуры

#Область СОБЫТИЯ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.ЧастьСделкиРЕПО <> 2 Тогда
		Сообщить("Для 1-й части РЕПО необходимо воспользоваться формой ФормаДокумента.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
	// т.к. страницами удобно пользоваться на этапе разработки, отключим их на этапе исполнения
	Элементы.ГруппаУсловия.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;

КонецПроцедуры // ПриСозданииНаСервере

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;

КонецПроцедуры // ПриЧтенииНаСервере

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтаФорма.СделкаЧерезБрокера = 1 И Не ЗначениеЗаполнено(Объект.Брокер) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Значение поля ""Брокер"" не заполнено",, "Объект.Брокер",, Отказ);
	КонецЕсли;
	
	Если ЭтаФорма.ДетализацияПоРасчетномуСчету И Не ЗначениеЗаполнено(Объект.РасчетныйСчет) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Значение поля ""Расчетный счет"" не заполнено",, "Объект.РасчетныйСчет",, Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(ЭтаФорма.ОснованиеВводаНового) И Не ЗначениеЗаполнено(Объект.ПерваяЧастьРЕПО) Тогда
		// ввод нового на основании уже отработан в ОбработкеЗаполнения, осталось только ругнуться, если вводим на основании чего-то левого
		Предупреждение("Ввод 2-й части РЕПО возможен только на основании 1-й части в режиме ""Две части сделки РЕПО"".");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Не ЭтаФорма.КорзинаЦенныхБумаг Тогда
		РаботаСКорзинойЦенныхБумагКлиентСервер.ПеренестиРеквизитыИзФормыВТаблицу(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// после записи теряются значения реквизитов, добавленных к т.ч. объекта
	Если ЭтаФорма.КорзинаЦенныхБумаг Тогда
		ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере();
	КонецЕсли;

	ЗаполнитьПодтверждениеОперацииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
	РаботаСДокументамиКлиент.ПроверитьПараметрыПодтвержденияОперации(ЭтаФорма, Объект, ПараметрыЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ПодтверждениеОперации" Тогда
		Если Параметр = Объект.Ссылка
			ИЛИ (ТипЗнч(Параметр) = Тип("Массив") И Параметр.Найти(Объект.Ссылка) <> Неопределено)
		Тогда
			ЗаполнитьПодтверждениеОперацииНаСервере();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СОБЫТИЯ_ЭЛЕМЕНТОВ_ФОРМЫ

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере();
	
	РаботаСДокументамиКлиент.ДетализацияПоРасчетномуСчетуПриИзмененииСвязанныхРеквизитов(ЭтаФорма);
	
	Если Не РаботаСИсполнителями.ЕстьИсполнитель(?(ЭтаФорма.СделкаЧерезБрокера = 1, "ИсполнителиПоДенежнымСредствамБрокерские", "ИсполнителиПоДенежнымСредствамСобственные"),
		ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(Объект, "Дата, Организация, СчетДоверительногоУправления, Брокер, РасчетныйСчет"))
	Тогда
		Объект.РасчетныйСчет = Неопределено;
	КонецЕсли;
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ПриИзмененииДаты(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ПерваяЧастьРЕПОПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ПерваяЧастьРЕПО) И Объект.ПерваяЧастьРЕПО <> ЭтаФорма.ТекущаяПерваяЧастьРЕПО Тогда
		Если Вопрос("Перезаполнить документ на основании выбранного документа?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
			Объект.ПерваяЧастьРЕПО = ЭтаФорма.ТекущаяПерваяЧастьРЕПО;
			Возврат;
		Иначе
			ЭтаФорма.ТекущаяПерваяЧастьРЕПО = Объект.ПерваяЧастьРЕПО;
			ЗаполнитьВторуюЧастьРЕПОНаОснованииПервойЧастиНаСервере();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

