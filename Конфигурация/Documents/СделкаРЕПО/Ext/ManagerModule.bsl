
Функция ПолучитьОбщиеРеквизитыКорзиныЦенныхБумаг() Экспорт
	
	ОбщиеРеквизиты = Новый Массив();
	ОбщиеРеквизиты.Добавить("ДепозитарныйСчет");
	ОбщиеРеквизиты.Добавить("ЦеннаяБумага");
	ОбщиеРеквизиты.Добавить("Количество");
	
	Возврат ОбщиеРеквизиты;
	
КонецФункции // ПолучитьОбщиеРеквизитыКорзиныЦенныхБумаг

Функция РассчитатьПроцентыПоСделкеРЕПО(Сумма, Процент, Знач ДатаИсполнения, Знач ДатаРасчета, БазаРасчета = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(БазаРасчета) Тогда
		
		Дней365 = 0;
		Дней366 = 0;
		
		ДатаРасчета = НачалоДня(ДатаРасчета);
		ДатаИсполнения = НачалоДня(ДатаИсполнения);
		
		Пока ДатаИсполнения < ДатаРасчета  Цикл
			ДатаИсполнения = ДатаИсполнения + 86400;
			Если (КонецГода(ДатаИсполнения) + 1 - НачалоГода(ДатаИсполнения)) / 86400 = 366 Тогда
				Дней366 = Дней366 + 1;
			Иначе
				Дней365 = Дней365 + 1;
			КонецЕсли; 
		КонецЦикла; 
		
		Возврат Окр((Сумма * Процент) / 100 * (Дней365/365 + Дней366/366), 2);
		
	Иначе
		
		ДнейПрошло = (НачалоДня(ДатаРасчета) - НачалоДня(ДатаИсполнения)) / 86400;
		
		Возврат Окр((Сумма * Процент) * ДнейПрошло / БазаРасчета / 100 , 2);
		
	КонецЕсли;
	
КонецФункции

Функция ЭтоПрямоеРЕПО(ЧастьСделкиРЕПО, ВидСделки) Экспорт
	
	Если ЧастьСделкиРЕПО = 1 И ВидСделки = Перечисления.ВидыСделок.Продажа
		ИЛИ ЧастьСделкиРЕПО = 2 И ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
		Возврат Истина;
	ИначеЕсли ЧастьСделкиРЕПО = 1 И ВидСделки = Перечисления.ВидыСделок.Покупка
		ИЛИ ЧастьСделкиРЕПО = 2 И ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
		Возврат Ложь;
	ИначеЕсли ЧастьСделкиРЕПО = 0 Тогда
		Если ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Если ВидФормы = "ФормаОбъекта" Тогда
		СтандартнаяОбработка = Ложь;
		
		Если (Параметры.Свойство("Ключ") И Параметры.Ключ.ЧастьСделкиРЕПО = 2)
			Или (Параметры.Свойство("Основание") И ЗначениеЗаполнено(Параметры.Основание))
		Тогда
			ВыбраннаяФорма = Метаданные.Документы.СделкаРЕПО.Формы.ФормаВторойЧастиРЕПО;
		Иначе
			ВыбраннаяФорма = Метаданные.Документы.СделкаРЕПО.Формы.ФормаДокумента;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля.Добавить("Номер");
	Поля.Добавить("Дата");
	Поля.Добавить("ВидСделки");
	Поля.Добавить("ЧастьСделкиРЕПО");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если      Данные.ЧастьСделкиРЕПО = 1 Тогда
		Представление = ?(ЗначениеЗаполнено(Данные.ВидСделки), Строка(Данные.ВидСделки), "Сделка") + " РЕПО " + Данные.Номер + " от " + Данные.Дата;
	ИначеЕсли Данные.ЧастьСделкиРЕПО = 2 Тогда
		Представление = "Закрытие РЕПО " + Данные.Номер + " от " + Данные.Дата;
	Иначе
		Представление = "Тикет РЕПО " + Данные.Номер + " от " + Данные.Дата;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти