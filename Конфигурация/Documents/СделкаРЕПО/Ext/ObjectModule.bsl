			АналитикиСписанияРезервов = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктивов(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, "АналитикаСписанияРезервов");
			
			СчетУчетаРезервов = ПланыСчетов.Единый.ПрочиеСредства17;
			
			АналитикаСписанияРезервов = БухгалтерскийУчетЕПС.ПолучитьГФУСписанияРезервов(ЭтотОбъект, УчетныйАктив); 
			
			СчетДоходов = ПланыСчетов.Единый.НайтиПоКоду(АналитикаСписанияРезервов.НомерСчетаБухгалтерскогоУчета);
			
			БухгалтерскийУчетЕПС.СформироватьДвиженияПоЗакрытиюРезервовОКУ(ЭтотОбъект, СчетУчетаРезервов, ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов, СчетДоходов, АналитикаСписанияРезервов, Движения.ЕдиныйБухгалтерскийУчет);
			
			Если Закрывать7ойРазделПриПоступленииДенежныхСредств И ЭтотОбъект.Дата > БухгалтерскийУчетЕПС.ДатаВключенияЗакрытия7гоРазделаПоРезервам() Тогда
				
				БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ДоходыРасходыПоРезервам01, ЭтотОбъект.ПерваяЧастьРЕПО, ЭтотОбъект.ВалютаОплаты, "Закрытие резервов", ЭтотОбъект.Дата,,,,, Истина);
				БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ДоходыРасходыПоРезервам02, ЭтотОбъект.ПерваяЧастьРЕПО, ЭтотОбъект.ВалютаОплаты, "Закрытие резервов", ЭтотОбъект.Дата,,,,, Истина);
			
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтотОбъект.ЧастьСделкиРЕПО = 1 И ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
		
		БухгалтерскийУчетЕПС.ОбработатьДвиженияДокументаПоПарнымСчетам(ЭтотОбъект, Отказ);	

		БухгалтерскийУчетЕПС.ЗакрытьПарныеСчетаДоходовРасходов(ЭтотОбъект, МассивУчетныхАктивов, Истина, Истина, МассивЦенныхБумаг, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОплатитьТорговуюКомиссию(Движения, ТорговаяКомиссия, ПараметрыКомиссии)

	Если ТорговаяКомиссия = 0 Тогда
	
		Возврат;
	
	КонецЕсли;
	
	// ОПЛАТА ТОРГОВОЙ КОМИССИЙ
	Если Не ЭтотОбъект.ОтложеннаяОплатаТорговойКомиссии Тогда
		
		СчетУчетаДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			ЭтотОбъект.ВалютаТорговойКомиссии,
			ЭтотОбъект.Брокер);	
		
		ТорговаяКомиссияПоТекущемуКурсу = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
			ТорговаяКомиссия,
			ЭтотОбъект.ВалютаТорговойКомиссии,
			ЭтотОбъект.Организация,
			ЭтотОбъект.Дата);
		
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, ТорговаяКомиссияПоТекущемуКурсу, "Списание торговой комиссии");
		
		// дебет
		Проводка.СчетДт = ПараметрыКомиссии.СчетУчетаКомиссии;
		
		Если ПараметрыКомиссии.ЕстьСубконтоКонтрагентыПоКомиссии Тогда
			Проводка.СубконтоДт.Контрагенты = ПараметрыКомиссии.КонтрагентПоКомиссии;
		КонецЕсли;
		
		Если ПараметрыКомиссии.ЕстьСубконтоСделкиПоКомиссии Тогда
			Проводка.СубконтоДт.Сделка = ЭтотОбъект.Ссылка;
		КонецЕсли;
		
		// кредит
		Проводка.СчетКт = СчетУчетаДС;
		Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
			Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
		КонецЕсли;	
		
		Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
			Проводка.СубконтоКт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
		КонецЕсли;
		
		Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
			Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = ПараметрыКомиссии.СубконтоДоговорыБрокерскогоОбслуживания;
		КонецЕсли;
		
		Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
			Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияРЕПО;
		КонецЕсли;
		
		Если СчетУчетаДС.Валютный Тогда
			Проводка.ВалютнаяСуммаКт = ТорговаяКомиссия;
			Проводка.ВалютаКт = ЭтотОбъект.ВалютаТорговойКомиссии;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура НачислитьТорговуюКомиссию(Движения, ТорговаяКомиссия, ПараметрыКомиссии, УчетныйРегистр)

	Если ТорговаяКомиссия = 0 Тогда
	
		Возврат;
	
	КонецЕсли;
	
	Если Не ПараметрыКомиссии.ВключатьРасходыПоПокупкеВСтоимость Тогда
		// ТОРГОВАЯ КОМИССИЯ НА РАСХОДЫ
		
		ДанныеАналитики = Новый Структура("СделкаРЕПО, ВидЗадолженности", ЭтотОбъект.Ссылка, Справочники.ВидыЗадолженности.ПоТорговойКомиссии);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, ТорговаяКомиссия, "Поступление услуг", ДанныеАналитики);
		
		// дебет
		БухгалтерскийУчет.ЗаполнитьАналитикуРасходов(
			ЭтотОбъект, 
			Проводка.СчетДт, 
			Проводка.СубконтоДт,
			ПланыСчетов.Основной.ПрочиеРасходы, 
			ПараметрыКомиссии.АналитикаУслуг, 
			ПараметрыКомиссии.ЦеннаяБумага, 
			ПараметрыКомиссии.ОбращаетсяНаОРЦБ);	
		
		// кредит
		Проводка.СчетКт = ПараметрыКомиссии.СчетУчетаКомиссии;
		
		Если ПараметрыКомиссии.ЕстьСубконтоКонтрагентыПоКомиссии Тогда
			Проводка.СубконтоКт.Контрагенты = ПараметрыКомиссии.КонтрагентПоКомиссии;
		КонецЕсли;
		
		Если ПараметрыКомиссии.ЕстьСубконтоСделкиПоКомиссии Тогда
			Проводка.СубконтоКт.Сделка = ЭтотОбъект.Ссылка;
		КонецЕсли;
		
	Иначе
		// ТОРГОВАЯ КОМИССИЯ НА СТОИМОСТЬ ЦЕННОЙ БУМАГИ 
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, ТорговаяКомиссия, "Поступление услуг");
		
		// дебет
		Проводка.СчетДт = ПараметрыКомиссии.СчетУчета;
		Проводка.СубконтоДт[ПараметрыКомиссии.ВидСубконтоУчетаЦеннойБумаги] = ПараметрыКомиссии.ЦеннаяБумага;
		
		// кредит
		Проводка.СчетКт = ПараметрыКомиссии.СчетУчетаКомиссии;
		
		Если ПараметрыКомиссии.ЕстьСубконтоКонтрагентыПоКомиссии Тогда
			Проводка.СубконтоКт.Контрагенты = ПараметрыКомиссии.КонтрагентПоКомиссии;
		КонецЕсли;
		
		Если ПараметрыКомиссии.ЕстьСубконтоСделкиПоКомиссии Тогда
			Проводка.СубконтоКт.Сделка = ЭтотОбъект.Ссылка;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерииПрямоеРЕПО(УчетныйРегистр, Отказ)

	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);
	
	ВидСубконтоУчетаЦеннойБумаги = БухгалтерскийУчет.ОпределитьВидСубконтоУчетаЦеннойБумаги(ЭтотОбъект.Рынок);	
	
	СчетДоходов = ПланыСчетов.Основной.ПрочиеДоходы;	
	СчетРасходов = ПланыСчетов.Основной.ПрочиеРасходы;
		
	СчетУчетаДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВалютаСделки,
		ЭтотОбъект.Брокер);	
		
	СчетУчетаКомиссии = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
		УчетныйРегистр,
		"СчетУчета");
		
	СделкаРЕПО = ?(ЭтотОбъект.ЧастьСделкиРЕПО = 2, ЭтотОбъект.ПерваяЧастьРЕПО, ЭтотОбъект.Ссылка);
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СделкаРЕПО, "Ссылка, СчетДоверительногоУправления, Дата, Брокер, Контрагент, РежимБиржевыхТоргов");
	КонтрагентПоСделке = БухгалтерскийУчет.ОпределитьКонтрагентаПоСделкеРЕПО(Реквизиты, НастройкиУчета);
	
	ПараметрыКомиссии = Новый Структура;
	ПараметрыКомиссии.Вставить("СчетУчетаКомиссии", СчетУчетаКомиссии);
	ПараметрыКомиссии.Вставить("СчетУчетаДС", СчетУчетаДС);
	
	Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
		СубконтоДоговорыБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
		ПараметрыКомиссии.Вставить("СубконтоДоговорыБрокерскогоОбслуживания", СубконтоДоговорыБрокерскогоОбслуживания);
	КонецЕсли;
		
	ЕстьСубконтоКонтрагентыПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);						
	ПараметрыКомиссии.Вставить("ЕстьСубконтоКонтрагентыПоКомиссии", ЕстьСубконтоКонтрагентыПоКомиссии);
	Если ЕстьСубконтоКонтрагентыПоКомиссии Тогда
		КонтрагентПоКомиссии = ЭтотОбъект.Брокер.ЮрФизЛицо;
		ПараметрыКомиссии.Вставить("КонтрагентПоКомиссии", КонтрагентПоКомиссии);
	КонецЕсли;
	
	ЕстьСубконтоСделкиПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Сделка) <> Неопределено);
	ПараметрыКомиссии.Вставить("ЕстьСубконтоСделкиПоКомиссии", ЕстьСубконтоСделкиПоКомиссии);
	
	АналитикаУслуг = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
		УчетныйРегистр,
		"АналитикаРЕПО");	
	
	Если Не ЗначениеЗаполнено(АналитикаУслуг) Тогда 	
		АналитикаУслуг = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
		УчетныйРегистр,
		"Аналитика");	
	КонецЕсли;		
	
	ПараметрыКомиссии.Вставить("АналитикаУслуг", АналитикаУслуг);
	ПараметрыКомиссии.Вставить("ВключатьРасходыПоПокупкеВСтоимость", Ложь);
	ПараметрыКомиссии.Вставить("ВидСубконтоУчетаЦеннойБумаги", ВидСубконтоУчетаЦеннойБумаги);
	
	АналитикаПерекурсовкиРасчетовПоРЕПО = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления, 
		Справочники.УчетныеАктивы.РасчетыПоПрямомуРЕПО, 
		УчетныйРегистр, 
		"АналитикаПерекурсовки"); 
	
	АналитикаДоходовРасчетовПоРЕПО = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления, 
		Справочники.УчетныеАктивы.РасчетыПоПрямомуРЕПО, 
		УчетныйРегистр, 
		"АналитикаДоходов"); 
	
	АналитикаДоходовПереоценкиРЕПО = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления, 
		Справочники.УчетныеАктивы.РасчетыПоПрямомуРЕПО, 
		УчетныйРегистр, 
		"АналитикаДоходовОтПереоценки"); 
	
	СчетПереоценкиРасчетовПоРЕПО = ПланыСчетов.Основной.ПроцентыПоКраткосрочнымКредитам; 
	
	ЭтоПИФ = ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда;
			
	// ЦЕННЫЕ БУМАГИ
	СведенияОбОбращенииЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(ЭтотОбъект.Дата, ЭтотОбъект.Ссылка, УчетныйРегистр);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.Рынок КАК Рынок,
		|	БухПартииЦенныхБумаг.ВидДвижения КАК ВидДвижения,
		|	СУММА(БухПартииЦенныхБумаг.Количество) КАК Количество,
		|	СУММА(БухПартииЦенныхБумаг.Стоимость) КАК Стоимость,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупона) КАК СтоимостьКупона,
		|	СУММА(БухПартииЦенныхБумаг.Переоценка) КАК Переоценка,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупона) КАК ПереоценкаКупона,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета) КАК ПереоценкаКупонаВВалютеУчета,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.СтоимостьКупона = 0
		|				И БухПартииЦенныхБумаг.ПереоценкаКупона = 0
		|				И БухПартииЦенныхБумаг.Стоимость = 0
		|				И БухПартииЦенныхБумаг.Переоценка = 0
		|				И БухПартииЦенныхБумаг.ИндексацияНоминала = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Перекурсовка,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.Количество = 0
		|				И (БухПартииЦенныхБумаг.Переоценка <> 0
		|					ИЛИ БухПартииЦенныхБумаг.ПереоценкаКупона <> 0
		|					ИЛИ БухПартииЦенныхБумаг.Стоимость <> 0
		|					ИЛИ БухПартииЦенныхБумаг.СтоимостьКупона <> 0)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Дооценка,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала
		|ПОМЕСТИТЬ _ДвиженияПартий
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.Рынок,
		|	БухПартииЦенныхБумаг.ВидДвижения,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага.ВалютаНоминала,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.СтоимостьКупона = 0
		|				И БухПартииЦенныхБумаг.ПереоценкаКупона = 0
		|				И БухПартииЦенныхБумаг.Стоимость = 0
		|				И БухПартииЦенныхБумаг.Переоценка = 0
		|				И БухПартииЦенныхБумаг.ИндексацияНоминала = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.Количество = 0
		|				И (БухПартииЦенныхБумаг.Переоценка <> 0
		|					ИЛИ БухПартииЦенныхБумаг.ПереоценкаКупона <> 0
		|					ИЛИ БухПартииЦенныхБумаг.Стоимость <> 0
		|					ИЛИ БухПартииЦенныхБумаг.СтоимостьКупона <> 0)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	БухПартииЦенныхБумагПроданныеВРепо.ЦеннаяБумага,
		|	БухПартииЦенныхБумагПроданныеВРепо.Рынок,
		|	БухПартииЦенныхБумагПроданныеВРепо.ВидДвижения,
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.Количество),
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.Стоимость),
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.СтоимостьКупона),
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.Переоценка),
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.ПереоценкаКупона),
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.СтоимостьВВалютеУчета),
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.СтоимостьКупонаВВалютеУчета),
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.ПереоценкаВВалютеУчета),
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.ПереоценкаКупонаВВалютеУчета),
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагПроданныеВРепо.СтоимостьКупона = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.ПереоценкаКупона = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.Стоимость = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.Переоценка = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.ИндексацияНоминала = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ,
		|	ЛОЖЬ,
		|	БухПартииЦенныхБумагПроданныеВРепо.ЦеннаяБумага.ВалютаНоминала
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумагПроданныеВРепо КАК БухПартииЦенныхБумагПроданныеВРепо
		|ГДЕ
		|	БухПартииЦенныхБумагПроданныеВРепо.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумагПроданныеВРепо.ВидУчета = &ВидУчета
		|	И БухПартииЦенныхБумагПроданныеВРепо.Количество = 0
		|	И БухПартииЦенныхБумагПроданныеВРепо.СтоимостьКупона = 0
		|	И БухПартииЦенныхБумагПроданныеВРепо.ПереоценкаКупона = 0
		|	И БухПартииЦенныхБумагПроданныеВРепо.Стоимость = 0
		|	И БухПартииЦенныхБумагПроданныеВРепо.Переоценка = 0
		|	И БухПартииЦенныхБумагПроданныеВРепо.ИндексацияНоминала = 0
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумагПроданныеВРепо.ЦеннаяБумага,
		|	БухПартииЦенныхБумагПроданныеВРепо.Рынок,
		|	БухПартииЦенныхБумагПроданныеВРепо.ВидДвижения,
		|	БухПартииЦенныхБумагПроданныеВРепо.ЦеннаяБумага.ВалютаНоминала,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагПроданныеВРепо.СтоимостьКупона = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.ПереоценкаКупона = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.Стоимость = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.Переоценка = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.ИндексацияНоминала = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияЧасть1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	УсловияЧасть1.ВалютаОплаты КАК ВалютаЧасть1,
		|	УсловияЧасть2.ВалютаОплаты КАК ВалютаЧасть2,
		|	УсловияЧасть1.Сумма + УсловияЧасть1.СуммаКупона КАК СуммаЧасть1,
		|	УсловияЧасть2.Сумма + УсловияЧасть2.СуммаКупона КАК СуммаЧасть2,
		|	ЕСТЬNULL(БухгалтерскийУчетРасчетыПоРЕПО.СуммаОстатокКт, 0) КАК СуммаОстатокРасчетыПоРЕПО,
		|	ЕСТЬNULL(БухгалтерскийУчетРасчетыПоРЕПО.ВалютнаяСуммаОстатокКт, 0) КАК ВалютнаяСуммаОстатокРасчетыПоРЕПО,
		|	ЕСТЬNULL(-БухгалтерскийУчетПроцентыПоРЕПО.СуммаОстаток, 0) КАК СуммаОстатокПроцентыПоРЕПО,
		|	ЕСТЬNULL(-БухгалтерскийУчетПроцентыПоРЕПО.ВалютнаяСуммаОстаток, 0) КАК ВалютнаяСуммаОстатокПроцентыПоРЕПО
		|ПОМЕСТИТЬ _ДвиженияДокумента
		|ИЗ
		|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|			&ПериодУсловияСделок,
		|			СделкаРЕПО = &СделкаРЕПО
		|				И ЧастьСделкиРЕПО = 1) КАК УсловияЧасть1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|				&ПериодУсловияСделок,
		|				СделкаРЕПО = &СделкаРЕПО
		|					И ЧастьСделкиРЕПО = 2) КАК УсловияЧасть2
		|		ПО УсловияЧасть1.СделкаРЕПО = УсловияЧасть2.СделкаРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.КраткосрочныеКредиты),
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.СделкаРЕПО),
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|					И Субконто1 = &СделкаРЕПО) КАК БухгалтерскийУчетРасчетыПоРЕПО
		|		ПО УсловияЧасть1.СделкаРЕПО = БухгалтерскийУчетРасчетыПоРЕПО.Субконто1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоКраткосрочнымКредитам)
		|					ИЛИ Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.НалоговыеНачисленияПоРЕПО),
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.СделкаРЕПО),
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|					И Субконто1 = &СделкаРЕПО) КАК БухгалтерскийУчетПроцентыПоРЕПО
		|		ПО УсловияЧасть1.СделкаРЕПО = БухгалтерскийУчетПроцентыПоРЕПО.Субконто1";

	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ПериодУсловияСделок", КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("СделкаРЕПО", СделкаРЕПО);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", УчетныйРегистр);
	
	Запрос.Выполнить();
	
	// цб
	ВыборкаДвиженияПартий = Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("_ДвиженияПартий").ПолучитьДанные().Выбрать();
	Пока ВыборкаДвиженияПартий.Следующий() Цикл
		
		ЦеннаяБумага = ВыборкаДвиженияПартий.ЦеннаяБумага;
		ВалютаНоминала = ЦеннаяБумага.ВалютаНоминала;
		
		УчетныйАктив       = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, ЭтотОбъект.Рынок, ВыборкаДвиженияПартий.ЦеннаяБумага);
		УчетныйАктивКупона = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, ЭтотОбъект.Рынок, ВыборкаДвиженияПартий.ЦеннаяБумага, Истина);
		
		НастройкиУчетаАктива = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктив,
			УчетныйРегистр);		
			
		НастройкиУчетаКупона = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктивКупона,
			УчетныйРегистр);		
			
		ВалютныйУчет = НастройкиУчетаАктива.СчетУчета.Валютный;
			
		Если ВыборкаДвиженияПартий.Перекурсовка  Тогда
			
			ПараметрыПерекурсовки = Новый Структура("ЦеннаяБумага, Рынок,"
				+ "СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета",
				ВыборкаДвиженияПартий.ЦеннаяБумага, ВыборкаДвиженияПартий.Рынок,
				ВыборкаДвиженияПартий.СтоимостьВВалютеУчета, ВыборкаДвиженияПартий.СтоимостьКупонаВВалютеУчета,  ВыборкаДвиженияПартий.ПереоценкаВВалютеУчета, ВыборкаДвиженияПартий.ПереоценкаКупонаВВалютеУчета);
				
			СчетаУчета = Новый Структура;
				СчетаУчетаПереоценки = Новый Структура;
			Если ЭтотОбъект.ЧастьСделкиРЕПО = 1 Тогда	
				СчетаУчета.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.СчетУчета);
				СчетаУчета.Вставить(УчетныйАктивКупона.ИмяПредопределенныхДанных, НастройкиУчетаКупона.СчетУчета);
				
				СчетаУчетаПереоценки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.СчетУчетаПереоценки);
				СчетаУчетаПереоценки.Вставить(УчетныйАктивКупона.ИмяПредопределенныхДанных, НастройкиУчетаКупона.СчетУчетаПереоценки);
			Иначе	
				СчетаУчета.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.СчетУчетаВЗалоге);
				СчетаУчета.Вставить(УчетныйАктивКупона.ИмяПредопределенныхДанных, НастройкиУчетаКупона.СчетУчетаВЗалоге);
				
				СчетаУчетаПереоценки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.СчетУчетаПереоценкиВЗалоге);
				СчетаУчетаПереоценки.Вставить(УчетныйАктивКупона.ИмяПредопределенныхДанных, НастройкиУчетаКупона.СчетУчетаПереоценкиВЗалоге);
			КонецЕсли;
			
			АналитикаПерекурсовки = Новый Структура;
			АналитикаПерекурсовки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.АналитикаПерекурсовки);
			АналитикаПерекурсовки.Вставить(УчетныйАктивКупона.ИмяПредопределенныхДанных, НастройкиУчетаКупона.АналитикаПерекурсовки);
				
			ОбращаетсяНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(ВыборкаДвиженияПартий.ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
			
			БухгалтерскийУчет.ДвижениеПерекурсовки(ЭтотОбъект, УчетныйРегистр, ПараметрыПерекурсовки, АналитикаПерекурсовки,  СчетаУчета, СчетаУчетаПереоценки, ОбращаетсяНаОРЦБ, Отказ);		
			
		ИначеЕсли ВыборкаДвиженияПартий.Дооценка Тогда
			
			ПараметрыПереоценки = Новый Структура("УчетныйРегистр,ВалютныйУчет,ВидСубконтоУчетаЦеннойБумаги,ЦеннаяБумага,ВалютаНоминала,ОбращаетсяНаОРЦБ",
													УчетныйРегистр,ВалютныйУчет,ВидСубконтоУчетаЦеннойБумаги,ЦеннаяБумага,ВалютаНоминала,ОбращаетсяНаОРЦБ);
													
			СуммыПереоценки = Новый Структура("СтоимостьДоначислено,СтоимостьВВалютеУчетаДоначислено,
											|	ПереоценкаДоначислено,ПереоценкаВВалютеУчетаДоначислено,
											|	СтоимостьКупонаДоначислено,СтоимостьКупонаВВалютеУчетаДоначислено,
											|	ПереоценкаКупонаДоначислено,ПереоценкаКупонаВВалютеУчетаДоначислено",
											ВыборкаДвиженияПартий.Стоимость, ВыборкаДвиженияПартий.СтоимостьВВалютеУчета,
											ВыборкаДвиженияПартий.Переоценка, ВыборкаДвиженияПартий.ПереоценкаВВалютеУчета,
											ВыборкаДвиженияПартий.СтоимостьКупона, ВыборкаДвиженияПартий.СтоимостьКупонаВВалютеУчета,
											ВыборкаДвиженияПартий.ПереоценкаКупона, ВыборкаДвиженияПартий.ПереоценкаКупонаВВалютеУчета);
											
			БухгалтерскийУчет.ПроизвестиПереоценкуБумагиИКупонаБУНУ(ЭтотОбъект, ПараметрыПереоценки, СуммыПереоценки, НастройкиУчетаАктива, НастройкиУчетаКупона);
			
		Иначе
	
			// Стоимость
			Если ВыборкаДвиженияПартий.Стоимость <> 0 Тогда
			
				Если ВыборкаДвиженияПартий.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ВыборкаДвиженияПартий.СтоимостьВВалютеУчета, "Закрытие РЕПО");
					Проводка.СчетДт = НастройкиУчетаАктива.СчетУчета;
					Проводка.СчетКт = НастройкиУчетаАктива.СчетУчетаВЗалоге;
				Иначе
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ВыборкаДвиженияПартий.СтоимостьВВалютеУчета, "Продажа в РЕПО");
					Проводка.СчетДт = НастройкиУчетаАктива.СчетУчетаВЗалоге;
					Проводка.СчетКт = НастройкиУчетаАктива.СчетУчета;
				КонецЕсли;
				
				Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ВыборкаДвиженияПартий.ЦеннаяБумага;
				Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ВыборкаДвиженияПартий.ЦеннаяБумага;
				
				Проводка.КоличествоДт = ВыборкаДвиженияПартий.Количество;
				Проводка.КоличествоКт = ВыборкаДвиженияПартий.Количество;
				
				Если Проводка.СчетДт.Валютный Тогда
				
					Проводка.ВалютаДт = ВыборкаДвиженияПартий.ВалютаНоминала;
					Проводка.ВалютнаяСуммаДт = ВыборкаДвиженияПартий.Стоимость;
				
				КонецЕсли;
				
				Если Проводка.СчетКт.Валютный Тогда
				
					Проводка.ВалютаКт = ВыборкаДвиженияПартий.ВалютаНоминала;
					Проводка.ВалютнаяСуммаКт = ВыборкаДвиженияПартий.Стоимость;
				
				КонецЕсли;
			
			КонецЕсли;
			
			// Переоценка
			Если ВыборкаДвиженияПартий.Переоценка <> 0 Тогда
				
				Если ВыборкаДвиженияПартий.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
