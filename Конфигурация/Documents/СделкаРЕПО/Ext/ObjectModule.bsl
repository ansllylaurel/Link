
Процедура ЗаполнитьВторуюЧастьРЕПОНаОснованииПервойЧасти(ПерваяЧастьРЕПО) Экспорт
	
	ЭтотОбъект.ДвеЧастиСделкиРЕПО = Истина;
	ЭтотОбъект.ЧастьСделкиРЕПО    = 2;
	
	ЭтотОбъект.ЦенныеБумаги.Очистить();
	ЭтотОбъект.ЦенныеБумагиВторойЧасти.Очистить();
	
	Если ПерваяЧастьРЕПО.ЧастьСделкиРЕПО <> 1 Тогда
		// предупреждение отобразим при открытии формы, если таковое случится
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО КАК ПерваяЧастьРЕПО,
		|	ВЫБОР
		|		КОГДА ДокументСделкаРЕПО.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|		КОГДА ДокументСделкаРЕПО.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|	КОНЕЦ КАК ВидСделки,
		|	ДокументСделкаРЕПО.СтавкаРЕПО КАК СтавкаРЕПО,
		|	ДокументСделкаРЕПО.ДатаВторойЧастиРЕПО КАК Дата,
		|	ДокументСделкаРЕПО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДокументСделкаРЕПО.Брокер КАК Брокер,
		|	ДокументСделкаРЕПО.МестоХранения КАК МестоХранения,
		|	ДокументСделкаРЕПО.РасчетныйСчет КАК РасчетныйСчет,
		|	ДокументСделкаРЕПО.ВалютаСделки КАК ВалютаСделки,
		|	ДокументСделкаРЕПО.КодРасчетовНаБирже КАК КодРасчетовНаБирже,
		|	ДокументСделкаРЕПО.НеполныеЛоты КАК НеполныеЛоты,
		|	ДокументСделкаРЕПО.КонтрагентНаБирже КАК КонтрагентНаБирже,
		|	ДокументСделкаРЕПО.Контрагент КАК Контрагент,
		|	ДокументСделкаРЕПО.РасчетныйСчетКонтрагента КАК РасчетныйСчетКонтрагента,
		|	ДокументСделкаРЕПО.ОтложенноеИсполнениеВторойЧасти КАК ОтложенноеИсполнение,
		|	ДокументСделкаРЕПО.РаздельноеИсполнениеВторойЧасти КАК РаздельноеИсполнение,
		|	УсловияСделокРЕПОСрезПоследних.Организация КАК Организация,
		|	УсловияСделокРЕПОСрезПоследних.Рынок КАК Рынок,
		|	УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	УсловияСделокРЕПОСрезПоследних.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|	УсловияСделокРЕПОСрезПоследних.ДатаИсполнения КАК ДатаИсполнения,
		|	УсловияСделокРЕПОСрезПоследних.ДатаОплаты КАК ДатаОплаты,
		|	УсловияСделокРЕПОСрезПоследних.ДатаПоставки КАК ДатаПоставки,
		|	УсловияСделокРЕПОСрезПоследних.ВалютаОплаты КАК ВалютаОплаты,
		|	УсловияСделокРЕПОСрезПоследних.СобственныйКурсОплаты КАК СобственныйКурсОплаты,
		|	УсловияСделокРЕПОСрезПоследних.КурсОплаты КАК КурсОплаты,
		|	УсловияСделокРЕПОСрезПоследних.Количество КАК Количество,
		|	УсловияСделокРЕПОСрезПоследних.Цена КАК Цена,
		|	УсловияСделокРЕПОСрезПоследних.ЦенаПроцент КАК ЦенаПроцент,
		|	УсловияСделокРЕПОСрезПоследних.ЦенаКупона КАК ЦенаКупона,
		|	УсловияСделокРЕПОСрезПоследних.Сумма КАК Сумма,
		|	УсловияСделокРЕПОСрезПоследних.СуммаКупона КАК СуммаКупона
		|ИЗ
		|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|			,
		|			НЕ Отменено
		|				И ЧастьСделкиРЕПО = 2
		|				И СделкаРЕПО = &СделкаРЕПО) КАК УсловияСделокРЕПОСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК ДокументСделкаРЕПО
		|		ПО УсловияСделокРЕПОСрезПоследних.СделкаРЕПО = ДокументСделкаРЕПО.Ссылка
		|ГДЕ
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО = &СделкаРЕПО";
		
	Запрос.УстановитьПараметр("СделкаРЕПО", ПерваяЧастьРЕПО);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЭтоПерваяСтрокаВыборки = Истина;
	
	Пока Выборка.Следующий() Цикл
		Если ЭтоПерваяСтрокаВыборки Тогда
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
			ЭтоПерваяСтрокаВыборки = Ложь;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект.ЦенныеБумаги.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьВторуюЧастьРЕПОНаОснованииПервойЧасти

Функция ОпределитьТипЗадолженности(ВидСделки, ВидАктива)
	
	ТипЗадолженности = Неопределено;
	
	Если      ВидАктива = Перечисления.ВидыАктивов.ЦенныеБумаги Тогда
		Если      ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			ТипЗадолженности = Перечисления.ТипыЗадолженности.Дебиторская;
		ИначеЕсли ВидСделки = Перечисления.ВидыСделок.Продажа Тогда	
			ТипЗадолженности = Перечисления.ТипыЗадолженности.Кредиторская;
		КонецЕсли;
		
	ИначеЕсли ВидАктива = Перечисления.ВидыАктивов.ДенежныеСредства Тогда
		Если      ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			ТипЗадолженности = Перечисления.ТипыЗадолженности.Кредиторская;
		ИначеЕсли ВидСделки = Перечисления.ВидыСделок.Продажа Тогда	
			ТипЗадолженности = Перечисления.ТипыЗадолженности.Дебиторская;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТипЗадолженности;
	
КонецФункции // ОпределитьТипЗадолженности

Функция ПроверитьВариантИсполненияСделки(НомерЧастиСделки, Отказ = Неопределено)
	
	Если      НомерЧастиСделки = 1 Тогда
		СтрНомерЧастиСделки = "";
	ИначеЕсли НомерЧастиСделки = 2 Тогда
		СтрНомерЧастиСделки = "ВторойЧасти";
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЭтотОбъект["ОтложенноеИсполнение" + СтрНомерЧастиСделки] Тогда
		Если Не ЭтотОбъект["РаздельноеИсполнение" + СтрНомерЧастиСделки] Тогда
			// должна быть задана дата исполнения
			Если Не ЗначениеЗаполнено(ЭтотОбъект["ДатаИсполнения" + СтрНомерЧастиСделки]) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задана дата исполнения " + НомерЧастиСделки + "-й части", ЭтотОбъект, "ДатаИсполнения" + СтрНомерЧастиСделки,, Отказ);
			КонецЕсли;
						
			ЭтотОбъект["ДатаПоставки" + СтрНомерЧастиСделки] = Неопределено;
			ЭтотОбъект["ДатаОплаты" + СтрНомерЧастиСделки]   = Неопределено;
			
		Иначе
			// должны быть заданы дата передачи и оплаты
			Если Не ЗначениеЗаполнено(ЭтотОбъект["ДатаПоставки" + СтрНомерЧастиСделки]) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задана дата передачи " + НомерЧастиСделки + "-й части", ЭтотОбъект, "ДатаПоставки" + СтрНомерЧастиСделки,, Отказ);
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ЭтотОбъект["ДатаОплаты" + СтрНомерЧастиСделки]) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задана дата оплаты " + НомерЧастиСделки + "-й части", ЭтотОбъект, "ДатаОплаты" + СтрНомерЧастиСделки,, Отказ);
			КонецЕсли;
			
			ЭтотОбъект["ДатаИсполнения" + СтрНомерЧастиСделки] = Неопределено
			
		КонецЕсли;
			
	Иначе
		// раздельное исполнение возможно, только при отложенном исполнении
		ЭтотОбъект["РаздельноеИсполнение" + СтрНомерЧастиСделки]  = Ложь;
		
		//ЭтотОбъект["СобственныйКурсОплаты" + СтрНомерЧастиСделки] = Ложь;
		//ЭтотОбъект["КурсОплаты" + СтрНомерЧастиСделки]            = Неопределено;
		
		ЭтотОбъект["ДатаИсполнения" + СтрНомерЧастиСделки] = Неопределено;
		ЭтотОбъект["ДатаПоставки" + СтрНомерЧастиСделки]   = Неопределено;
		ЭтотОбъект["ДатаОплаты" + СтрНомерЧастиСделки]     = Неопределено;
		
	КонецЕсли;
	
	// должна быть задана валюта оплаты
	Если Не ЗначениеЗаполнено(ЭтотОбъект["ВалютаОплаты" + СтрНомерЧастиСделки]) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задана дата передачи " + НомерЧастиСделки + "-й части", ЭтотОбъект, "ВалютаОплаты" + СтрНомерЧастиСделки,, Отказ);
	Иначе
		Если ЭтотОбъект.ВалютаСделки <> ЭтотОбъект["ВалютаОплаты" + СтрНомерЧастиСделки] Тогда
			// должен быть задана дата курса или собственный курс, в зависимости от значения флажка
			Если Не ЗначениеЗаполнено(ЭтотОбъект["КурсОплаты" + СтрНомерЧастиСделки]) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задан собственный курс оплаты " + НомерЧастиСделки + "-й части", ЭтотОбъект, "ВалютаОплаты" + СтрНомерЧастиСделки,, Отказ);
			Иначе
				Если ЭтотОбъект["СобственныйКурсОплаты" + СтрНомерЧастиСделки] Тогда
					Если ТипЗнч(ЭтотОбъект["КурсОплаты" + СтрНомерЧастиСделки]) <> Тип("Число") Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При установленном флажке «Собственный курс оплаты " + НомерЧастиСделки + "-й части» должен быть задан числовой курс.", ЭтотОбъект, "КурсОплаты" + СтрНомерЧастиСделки,, Отказ);
					КонецЕсли;
				Иначе
					Если ТипЗнч(ЭтотОбъект["КурсОплаты" + СтрНомерЧастиСделки]) <> Тип("Дата") Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При сброшенном флажке «Собственный курс оплаты " + НомерЧастиСделки + "-й части» должен быть задан курс на дату.", ЭтотОбъект, "КурсОплаты" + СтрНомерЧастиСделки,, Отказ);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Иначе
			ЭтотОбъект["СобственныйКурсОплаты" + СтрНомерЧастиСделки] = Ложь;
			ЭтотОбъект["КурсОплаты" + СтрНомерЧастиСделки]            = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции // ПроверитьВариантИсполненияСделки

Процедура УстановитьБлокировки()

	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;	
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
		
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиЦенныхБумаг");
		ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
		ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		ЭлементБлокировкиДанных.УстановитьЗначение("Рынок",                        ЭтотОбъект.Рынок);
		
		ЭлементБлокировкиДанных.ИсточникДанных = ЭтотОбъект.ЦенныеБумаги;
		ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных("ДепозитарныйСчет", "ДепозитарныйСчет");
		ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных("ЦеннаяБумага",     "ЦеннаяБумага");
		
	КонецЕсли;
	
	Если ЭтотОбъект.ЧастьСделкиРЕПО = 2 Тогда
		
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО");
		ЭлементБлокировкиДанных.УстановитьЗначение("СделкаРЕПО",  					ЭтотОбъект.ПерваяЧастьРЕПО);
		ЭлементБлокировкиДанных.УстановитьЗначение("Организация", 					ЭтотОбъект.Организация);
		ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
		ЭлементБлокировкиДанных.УстановитьЗначение("Рынок",       					ЭтотОбъект.Рынок);
		
		ЭлементБлокировкиДанных.ИсточникДанных = ЭтотОбъект.ЦенныеБумаги;
		ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных("ЦеннаяБумага", "ЦеннаяБумага");
		
	КонецЕсли;
	
	Если БлокировкаДанных.Количество() <> 0 Тогда
		БлокировкаДанных.Заблокировать();	
	КонецЕсли; 	

КонецПроцедуры // УстановитьБлокировки

Процедура СформироватьДвиженияПоОперациямСЦеннымиБумагами()
	
	Запрос = Новый Запрос;
	
	Если ЭтотОбъект.ДвеЧастиСделкиРЕПО Тогда
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СделкаРЕПО.Ссылка КАК Операция,
			|	СделкаРЕПО.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
			|	ВЫБОР
			|		КОГДА СделкаРЕПО.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
			|		КОГДА СделкаРЕПО.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
			|	КОНЕЦ КАК ВидДвижения,
			|	СделкаРЕПО.ПерваяЧастьРЕПО КАК Основание,
			|	СделкаРЕПО.Организация КАК Организация,
			|	СделкаРЕПО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	СделкаРЕПО.Рынок КАК Рынок,
			|	СделкаРЕПО.ВалютаСделки КАК Валюта,
			|	СделкаРЕПОЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ВЫБОР
			|		КОГДА СделкаРЕПО.ОтложенноеИсполнение
			|			ТОГДА ВЫБОР
			|					КОГДА СделкаРЕПО.РаздельноеИсполнение
			|						ТОГДА СделкаРЕПО.ДатаПоставки
			|					ИНАЧЕ СделкаРЕПО.ДатаИсполнения
			|				КОНЕЦ
			|		ИНАЧЕ СделкаРЕПО.Дата
			|	КОНЕЦ КАК ДатаПоставкиПлановая,
			|	ВЫБОР
			|		КОГДА СделкаРЕПО.ОтложенноеИсполнение
			|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
			|		ИНАЧЕ СделкаРЕПО.Дата
			|	КОНЕЦ КАК ДатаПоставки,
			|	ВЫБОР
			|		КОГДА СделкаРЕПО.ОтложенноеИсполнение
			|			ТОГДА ВЫБОР
			|					КОГДА СделкаРЕПО.РаздельноеИсполнение
			|						ТОГДА СделкаРЕПО.ДатаОплаты
			|					ИНАЧЕ СделкаРЕПО.ДатаИсполнения
			|				КОНЕЦ
			|		ИНАЧЕ СделкаРЕПО.Дата
			|	КОНЕЦ КАК ДатаОплатыПлановая,
			|	ВЫБОР
			|		КОГДА СделкаРЕПО.ОтложенноеИсполнение
			|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
			|		ИНАЧЕ СделкаРЕПО.Дата
			|	КОНЕЦ КАК ДатаОплаты,
			|	СделкаРЕПОЦенныеБумаги.Количество КАК Количество,
			|	СделкаРЕПОЦенныеБумаги.Цена КАК Цена,
			|	СделкаРЕПОЦенныеБумаги.ЦенаПроцент КАК ЦенаПроцент,
			|	СделкаРЕПОЦенныеБумаги.ЦенаКупона КАК ЦенаКупона,
			|	СделкаРЕПОЦенныеБумаги.Сумма КАК Сумма,
			|	СделкаРЕПОЦенныеБумаги.СуммаКупона КАК СуммаКупона,
			|	СделкаРЕПО.Дата КАК ДатаОперации,
			|	ВЫБОР
