			|					КОГДА СделкаРЕПО.РаздельноеИсполнениеВторойЧасти
			|						ТОГДА СделкаРЕПО.ДатаПоставкиВторойЧасти
			|					ИНАЧЕ СделкаРЕПО.ДатаИсполненияВторойЧасти
			|				КОНЕЦ
			|		ИНАЧЕ СделкаРЕПО.ДатаВторойЧастиРЕПО
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА СделкаРЕПО.ОтложенноеИсполнениеВторойЧасти
			|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
			|		ИНАЧЕ СделкаРЕПО.ДатаВторойЧастиРЕПО
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА СделкаРЕПО.ОтложенноеИсполнениеВторойЧасти
			|			ТОГДА ВЫБОР
			|					КОГДА СделкаРЕПО.РаздельноеИсполнениеВторойЧасти
			|						ТОГДА СделкаРЕПО.ДатаОплатыВторойЧасти
			|					ИНАЧЕ СделкаРЕПО.ДатаИсполненияВторойЧасти
			|				КОНЕЦ
			|		ИНАЧЕ СделкаРЕПО.ДатаВторойЧастиРЕПО
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА СделкаРЕПО.ОтложенноеИсполнениеВторойЧасти
			|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
			|		ИНАЧЕ СделкаРЕПО.ДатаВторойЧастиРЕПО
			|	КОНЕЦ,
			|	СделкаРЕПОЦенныеБумаги.Количество,
			|	СделкаРЕПОЦенныеБумаги.Цена,
			|	СделкаРЕПОЦенныеБумаги.ЦенаПроцент,
			|	СделкаРЕПОЦенныеБумаги.ЦенаКупона,
			|	СделкаРЕПОЦенныеБумаги.Сумма,
			|	СделкаРЕПОЦенныеБумаги.СуммаКупона,
			|	СделкаРЕПО.Дата,
			|	ВЫБОР
			|		КОГДА СделкаРЕПО.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
			|			ТОГДА СделкаРЕПО.Дата
			|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
			|	КОНЕЦ
			|ИЗ
			|	Документ.СделкаРЕПО.ЦенныеБумагиВторойЧасти КАК СделкаРЕПОЦенныеБумаги
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК СделкаРЕПО
			|		ПО СделкаРЕПОЦенныеБумаги.Ссылка = СделкаРЕПО.Ссылка
			|ГДЕ
			|	СделкаРЕПО.Ссылка = &Ссылка";
			
	КонецЕсли;		
	
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	Движения.ОперацииСЦеннымиБумагами.Загрузить(
		Запрос.Выполнить().Выгрузить());
		
КонецПроцедуры // СформироватьДвиженияПоОперациямСЦеннымиБумагами

Процедура СформироватьСводныеДвиженияПоЗадолженностиПоДенежнымСредствамПоСделкеРЕПОБезВторойЧасти()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаРЕПО.Дата КАК Период,
		|	СделкаРЕПО.Ссылка КАК Основание,
		|	ВЫБОР
		|		КОГДА СделкаРЕПО.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|		КОГДА СделкаРЕПО.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|	КОНЕЦ КАК ТипЗадолженности,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО) КАК ВидЗадолженности,
		|	СделкаРЕПО.Организация КАК Организация,
		|	СделкаРЕПО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СделкаРЕПО.ВалютаСделки КАК Валюта,
		|	СделкаРЕПО.Контрагент КАК Контрагент,
		|	СуммыЗадолженности.Сумма КАК Сумма,
		|	СуммыЗадолженности.СуммаКупона КАК СуммаКупона
		|ИЗ
		|	(ВЫБРАТЬ
		|		СделкаРЕПОЦенныеБумаги.Ссылка КАК Ссылка,
		|		СУММА(СделкаРЕПОЦенныеБумаги.Сумма) КАК Сумма,
		|		СУММА(СделкаРЕПОЦенныеБумаги.СуммаКупона) КАК СуммаКупона
		|	ИЗ
		|		Документ.СделкаРЕПО.ЦенныеБумаги КАК СделкаРЕПОЦенныеБумаги
		|	ГДЕ
		|		СделкаРЕПОЦенныеБумаги.Ссылка = &Ссылка
		|	
		|	СГРУППИРОВАТЬ ПО
		|		СделкаРЕПОЦенныеБумаги.Ссылка) КАК СуммыЗадолженности
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК СделкаРЕПО
		|		ПО (СделкаРЕПО.Ссылка = СуммыЗадолженности.Ссылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СделкаРЕПО.Дата,
		|	СделкаРЕПО.Ссылка,
		|	ВЫБОР
		|		КОГДА СделкаРЕПО.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|		КОГДА СделкаРЕПО.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|	КОНЕЦ,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО),
		|	СделкаРЕПО.Организация,
		|	СделкаРЕПО.СчетДоверительногоУправления,
		|	СделкаРЕПО.ВалютаСделки,
		|	СделкаРЕПО.Контрагент,
		|	СуммыЗадолженности.Сумма,
		|	СуммыЗадолженности.СуммаКупона
		|ИЗ
		|	(ВЫБРАТЬ
		|		СделкаРЕПОЦенныеБумагиВторойЧасти.Ссылка КАК Ссылка,
		|		СУММА(СделкаРЕПОЦенныеБумагиВторойЧасти.Сумма) КАК Сумма,
		|		СУММА(СделкаРЕПОЦенныеБумагиВторойЧасти.СуммаКупона) КАК СуммаКупона
		|	ИЗ
		|		Документ.СделкаРЕПО.ЦенныеБумагиВторойЧасти КАК СделкаРЕПОЦенныеБумагиВторойЧасти
		|	ГДЕ
		|		СделкаРЕПОЦенныеБумагиВторойЧасти.Ссылка = &Ссылка
		|	
		|	СГРУППИРОВАТЬ ПО
		|		СделкаРЕПОЦенныеБумагиВторойЧасти.Ссылка) КАК СуммыЗадолженности
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК СделкаРЕПО
		|		ПО (СделкаРЕПО.Ссылка = СуммыЗадолженности.Ссылка)";

	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход(), Выборка);
	КонецЦикла;
	
КонецПроцедуры // СформироватьСводныеДвиженияПоСделкеРЕПОБезВторойЧасти

Процедура СформироватьДвиженияПоПервойЧастиРЕПО()
	
	// задолженности по 2-й части РЕПО
	Если ЭтотОбъект.ЧастьСделкиРЕПО > 0 Тогда
		ТипЗадолженности = ОпределитьТипЗадолженности(ЭтотОбъект.ВидСделки, Перечисления.ВидыАктивов.ЦенныеБумаги);
		
		Для каждого СтрокаЦенныеБумагиВторойЧасти Из ЭтотОбъект.ЦенныеБумагиВторойЧасти Цикл
			Движение = Движения.ЗадолженностиПоВторойЧастиРЕПО.ДобавитьПриход();
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.СделкаРЕПО                   = ЭтотОбъект.Ссылка;
			Движение.ТипЗадолженности             = ТипЗадолженности; // волевым решением аналитика было тип задолженности брать из ц/б
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Рынок                        = ЭтотОбъект.Рынок;
			Движение.ЦеннаяБумага                 = СтрокаЦенныеБумагиВторойЧасти.ЦеннаяБумага;
			Движение.Валюта                       = ЭтотОбъект.ВалютаСделки;
			Движение.Количество                   = СтрокаЦенныеБумагиВторойЧасти.Количество;
			Движение.Сумма                        = СтрокаЦенныеБумагиВторойЧасти.Сумма;
			Движение.СуммаКупона                  = СтрокаЦенныеБумагиВторойЧасти.СуммаКупона;
		КонецЦикла;
	КонецЕсли;

	Если ЭтотОбъект.ОтложенноеИсполнение Тогда
		// задолженности
		ТипЗадолженностиПоЦБ = ОпределитьТипЗадолженности(ЭтотОбъект.ВидСделки, Перечисления.ВидыАктивов.ЦенныеБумаги);
		
		Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
			Движение = Движения.ЗадолженностиПоЦеннымБумагам.ДобавитьПриход();
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Основание                    = ЭтотОбъект.Ссылка;
			Движение.ТипЗадолженности             = ТипЗадолженностиПоЦБ;
			Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Рынок                        = ЭтотОбъект.Рынок;
			Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
			Движение.Валюта                       = ЭтотОбъект.ВалютаСделки;
			Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
			Движение.Сумма                        = СтрокаЦенныеБумаги.Сумма;
			Движение.СуммаКупона                  = СтрокаЦенныеБумаги.СуммаКупона;
		КонецЦикла;
		
		РегистрыНакопления.ЗадолженностиПоДенежнымСредствам.СформироватьСводныеДвиженияПоСделке(ЭтотОбъект, Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО);
		
	Иначе
		// остатки
		Если      ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			ВидДвиженияЦБ = ВидДвиженияНакопления.Приход;
		ИначеЕсли ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
			ВидДвиженияЦБ = ВидДвиженияНакопления.Расход;
		КонецЕсли;
		
		Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
			Движение = Движения.ОстаткиЦенныхБумаг.Добавить();
			Движение.ВидДвижения                  = ВидДвиженияЦБ;
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.ДепозитарныйСчет             = СтрокаЦенныеБумаги.ДепозитарныйСчет;
			Движение.Рынок                        = ЭтотОбъект.Рынок;
			Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
			Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
		КонецЦикла;
		
		РегистрыНакопления.ОстаткиДенежныхСредств.СформироватьСводныеДвиженияПоСделке(ЭтотОбъект, Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО);
		
	КонецЕсли;
	
	РаботаСРегистрамиНакопления.СформироватьСводныеДвиженияПоТорговойКомиссииВСделке(ЭтотОбъект);
	
КонецПроцедуры // СформироватьДвиженияПоПервойЧастиРЕПО

Процедура СформироватьДвиженияПоВторойЧастиРЕПО()
	
	// задолженности по 2-й части РЕПО
	ТипЗадолженности = ОпределитьТипЗадолженности(ЭтотОбъект.ВидСделки, Перечисления.ВидыАктивов.ЦенныеБумаги);
	
	Если      ТипЗадолженности = Перечисления.ТипыЗадолженности.Дебиторская Тогда
		ТипЗадолженности = Перечисления.ТипыЗадолженности.Кредиторская;
	ИначеЕсли ТипЗадолженности = Перечисления.ТипыЗадолженности.Кредиторская Тогда
		ТипЗадолженности = Перечисления.ТипыЗадолженности.Дебиторская;
	КонецЕсли;

	Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
		Движение = Движения.ЗадолженностиПоВторойЧастиРЕПО.ДобавитьРасход();
		Движение.Период                       = ЭтотОбъект.Дата;
		Движение.СделкаРЕПО                   = ЭтотОбъект.ПерваяЧастьРЕПО;
		Движение.ТипЗадолженности             = ТипЗадолженности; // волевым решением аналитика было тип задолженности брать из ц/б
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Рынок                        = ЭтотОбъект.Рынок;
		Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
		Движение.Валюта                       = ЭтотОбъект.ВалютаСделки;
		Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
		Движение.Сумма                        = СтрокаЦенныеБумаги.Сумма;
		Движение.СуммаКупона                  = СтрокаЦенныеБумаги.СуммаКупона;
	КонецЦикла;

	Если ЭтотОбъект.ОтложенноеИсполнение Тогда
		// задолженности
		ТипЗадолженностиПоЦБ = ОпределитьТипЗадолженности(ЭтотОбъект.ВидСделки, Перечисления.ВидыАктивов.ЦенныеБумаги);
		
		Если ЭтотОбъект.ЧастьСделкиРЕПО = 0 Тогда
			Если      ТипЗадолженностиПоЦБ = Перечисления.ТипыЗадолженности.Дебиторская Тогда
				ТипЗадолженностиПоЦБ = Перечисления.ТипыЗадолженности.Кредиторская;
			ИначеЕсли ТипЗадолженностиПоЦБ = Перечисления.ТипыЗадолженности.Кредиторская Тогда
				ТипЗадолженностиПоЦБ = Перечисления.ТипыЗадолженности.Дебиторская;
			КонецЕсли;
		КонецЕсли;		
		
		Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
			Движение = Движения.ЗадолженностиПоЦеннымБумагам.ДобавитьПриход();
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Основание                    = ЭтотОбъект.Ссылка;
			Движение.ТипЗадолженности             = ТипЗадолженностиПоЦБ;
			Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Рынок                        = ЭтотОбъект.Рынок;
			Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
			Движение.Валюта                       = ЭтотОбъект.ВалютаСделки;
			Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
			Движение.Сумма                        = СтрокаЦенныеБумаги.Сумма;
			Движение.СуммаКупона                  = СтрокаЦенныеБумаги.СуммаКупона;
		КонецЦикла;
		
		РегистрыНакопления.ЗадолженностиПоДенежнымСредствам.СформироватьСводныеДвиженияПоСделке(ЭтотОбъект, Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО);
		
	Иначе
		// остатки
		Если      ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			ВидДвиженияЦБ = ВидДвиженияНакопления.Приход;
		ИначеЕсли ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
			ВидДвиженияЦБ = ВидДвиженияНакопления.Расход;
		КонецЕсли;
		
		Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
			Движение = Движения.ОстаткиЦенныхБумаг.Добавить();
			Движение.ВидДвижения                  = ВидДвиженияЦБ;
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.ДепозитарныйСчет             = СтрокаЦенныеБумаги.ДепозитарныйСчет;
			Движение.Рынок                        = ЭтотОбъект.Рынок;
			Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
			Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
		КонецЦикла;
		
		РегистрыНакопления.ОстаткиДенежныхСредств.СформироватьСводныеДвиженияПоСделке(ЭтотОбъект, Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО);
		
	КонецЕсли;
	
КонецПроцедуры // СформироватьДвиженияПоВторойЧастиРЕПО

Процедура ПерекурсовкаСчетаРЕПО(ПараметрыПроводки)

	Если ПараметрыПроводки.СуммаВВалютеУчета = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыПроводки.СуммаВВалютеУчета > 0 Тогда
		
		ПроводкаНачисления = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ПараметрыПроводки.СуммаВВалютеУчета, ПараметрыПроводки.Содержание);
		
		// дебет
		ПроводкаНачисления.СчетДт = ПараметрыПроводки.СчетУчета;
		
		ПроводкаНачисления.СубконтоДт.Контрагенты = ПараметрыПроводки.Контрагент;
		ПроводкаНачисления.СубконтоДт.ОснованиеРасчетов = ПараметрыПроводки.СделкаРЕПО;
		
		ПроводкаНачисления.ВалютаДт  = ПараметрыПроводки.Валюта;
		
		// кредит
		ПроводкаНачисления.СчетКт = ПланыСчетов.Единый.ДоходыРасходыОтОпераций11;
		
		ПроводкаНачисления.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = БухгалтерскийУчетЕПС.ПолучитьГФУПоВалюте(ПланыСчетов.Единый.ДоходыРасходыОтОпераций11, ПараметрыПроводки.Валюта);
		
	Иначе
		
		ПроводкаНачисления = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, -ПараметрыПроводки.СуммаВВалютеУчета, ПараметрыПроводки.Содержание);
		
		// дебет
		ПроводкаНачисления.СчетДт = ПланыСчетов.Единый.ДоходыРасходыОтОпераций12;
		
		ПроводкаНачисления.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = БухгалтерскийУчетЕПС.ПолучитьГФУПоВалюте(ПланыСчетов.Единый.ДоходыРасходыОтОпераций12, ПараметрыПроводки.Валюта);
		
		// кредит
		ПроводкаНачисления.СчетКт = ПараметрыПроводки.СчетУчета;
		
		ПроводкаНачисления.СубконтоКт.Контрагенты = ПараметрыПроводки.Контрагент;
		ПроводкаНачисления.СубконтоКт.ОснованиеРасчетов = ПараметрыПроводки.СделкаРЕПО;
		
		ПроводкаНачисления.ВалютаКт  = ПараметрыПроводки.Валюта;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт

	Если ЭтотОбъект.ЦенныеБумаги.Количество() > 1 Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("РЕПО по корзине ценных бумаг пока не поддерживается",,,, Отказ);
		Возврат;
	
	КонецЕсли;
	
	Если ЭтотОбъект.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок Тогда // Внебиржевое РЕПО не делает проводок
		Возврат;	
	КонецЕсли;
	
	Закрывать7ойРазделПриПоступленииДенежныхСредств = БухгалтерскийУчет.Закрывать7ойРазделПриПоступленииДенежныхСредств(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	АналитикаТела 				= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
	АналитикаПереоценкиТела 	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги;
	АналитикаКупонПриобретенный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
	АналитикаКупонНачисленный	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
	АналитикаПремии 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия;
	АналитикаДисконта 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт;
	АналитикаИндексацииНоминала	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ИндексацияНоминала;
	
	НастройкиУчета = БухгалтерскийУчетПовтИсп.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);
		
	НеВыделятьПереоценкуДляБумагПоРЕПОГлаваГ = НастройкиУчета.НеВыделятьПереоценкуДляБумагПоРЕПОГлаваГ;
	
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет,
		Отказ);	
		
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствуют настройки у %1 по виду учета %2 на %3!", ЭтотОбъект.СчетДоверительногоУправления, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, ЭтотОбъект.Дата));
		Возврат;
	КонецЕсли;
	
	МассивЦенныхБумаг = Новый Массив();
	МассивУчетныхАктивов = Новый Массив();
	
	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	// БУМАГИ
	Если ЭтотОбъект.ЧастьСделкиРЕПО = 1 Тогда
		
		Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			
			// Обратное РЕПО
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагКупленныеПоРЕПО.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.Количество) КАК Количество,
			|	СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.Стоимость) КАК Стоимость,
			|	СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
			|	СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьКупона) КАК СтоимостьКупона,
			|	СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
			|	БухПартииЦенныхБумагКупленныеПоРЕПО.Партия КАК Партия,
			|	БухПартииЦенныхБумагКупленныеПоРЕПО.СтрокаКорзиныЦенныхБумаг КАК СтрокаКорзиныЦенныхБумаг,
			|	БухПартииЦенныхБумагКупленныеПоРЕПО.ЦеннаяБумага.ВалютаНоминала КАК ЦеннаяБумагаВалютаНоминала
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО КАК БухПартииЦенныхБумагКупленныеПоРЕПО
			|ГДЕ
			|	БухПартииЦенныхБумагКупленныеПоРЕПО.Регистратор = &Регистратор
			|	И БухПартииЦенныхБумагКупленныеПоРЕПО.ВидУчета = &ВидУчета
			|
			|СГРУППИРОВАТЬ ПО
			|	БухПартииЦенныхБумагКупленныеПоРЕПО.ЦеннаяБумага,
			|	БухПартииЦенныхБумагКупленныеПоРЕПО.Партия,
			|	БухПартииЦенныхБумагКупленныеПоРЕПО.СтрокаКорзиныЦенныхБумаг,
			|	БухПартииЦенныхБумагКупленныеПоРЕПО.ЦеннаяБумага.ВалютаНоминала";
			
			Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
			Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				ВалютаНоминала = Выборка.ЦеннаяБумагаВалютаНоминала;
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СтоимостьВВалютеУчета, "Покупка ценной бумаги (тело) по РЕПО");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.КорреспонденцияСПассивом8;
				Проводка.ДополнительнаяАналитикаДт = АналитикаТела;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.ЦенныеБумагиПоРЕПО;
				
				Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
				Проводка.СубконтоКт.ОснованиеРасчетов = Выборка.Партия;
				
				Проводка.КоличествоКт = Выборка.Количество;
				Проводка.ВалютаКт = ВалютаНоминала;
				Проводка.ВалютнаяСуммаКт = Выборка.Стоимость;
				
				Проводка.ДополнительнаяАналитикаКт = АналитикаТела;
				
				Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, Выборка.СтоимостьКупонаВВалютеУчета, "Покупка ценной бумаги (купон) по РЕПО");
					
					// дебет
					Проводка.СчетДт = ПланыСчетов.Единый.КорреспонденцияСПассивом8;
					Проводка.ДополнительнаяАналитикаДт = АналитикаКупонПриобретенный;
					
					// кредит
					Проводка.СчетКт = ПланыСчетов.Единый.ЦенныеБумагиПоРЕПО;
					
					Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
					Проводка.СубконтоКт.ОснованиеРасчетов = Выборка.Партия;
					
					Проводка.ВалютаКт = ВалютаНоминала;
					Проводка.ВалютнаяСуммаКт = Выборка.СтоимостьКупона;
					
					Проводка.ДополнительнаяАналитикаКт = АналитикаКупонПриобретенный;
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
		
			// Прямое РЕПО
			
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			Запрос.Текст = 
