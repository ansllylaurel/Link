					Проводка.ВалютнаяСуммаКт = ВыборкаДвиженияПартий.ПереоценкаКупона;
				
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;		
	КонецЦикла;
	
	// дс
	
	
	ВыборкаДвиженияДокумента = Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("_ДвиженияДокумента").ПолучитьДанные().Выбрать();	
	Пока ВыборкаДвиженияДокумента.Следующий() Цикл
		
		Если ЭтотОбъект.ЧастьСделкиРЕПО = 1 Тогда // займ
			
			СуммаЗаймаПоТекущемуКурсу = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
