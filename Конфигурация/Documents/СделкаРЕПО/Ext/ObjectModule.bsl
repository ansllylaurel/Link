				Проводка.ВалютнаяСуммаКт = ПолныеПроцентыПоРЕПО;
				
			Иначе		
				ДоначислитьПроцентовПоРЕПО = ПолныеПроцентыПоРЕПО - ВыборкаДвиженияДокумента.ВалютнаяСуммаОстатокПроцентыПоРЕПО;
				ДоначислитьПроцентовПоРЕПОПоТекущемуКурсу = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
					ДоначислитьПроцентовПоРЕПО,
					ВыборкаДвиженияДокумента.ВалютаЧасть1,
					ЭтотОбъект.Организация,
					ЭтотОбъект.Дата);
					
				// доначисляем проценты
				Если ДоначислитьПроцентовПоРЕПО > 0 Тогда
				
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ДоначислитьПроцентовПоРЕПОПоТекущемуКурсу, "Проценты по РЕПО");
					
					Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
					Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходовРасчетовПоРЕПО;
					Проводка.СчетКт = СчетПереоценкиРасчетовПоРЕПО;
					Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
					Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
					
					Проводка.ВалютаКт = ВыборкаДвиженияДокумента.ВалютаЧасть2;
					Проводка.ВалютнаяСуммаКт = ДоначислитьПроцентовПоРЕПО;
					
				КонецЕсли;
			КонецЕсли;
			
			// закрываем проценты на займ
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ПолныеПроцентыПоРЕПОПоТекущемуКурсу, "Проценты по РЕПО");
			
			Проводка.СчетДт = СчетПереоценкиРасчетовПоРЕПО;
			Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
			Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
			
			Проводка.ВалютаДт = ВыборкаДвиженияДокумента.ВалютаЧасть2;
			Проводка.ВалютнаяСуммаДт = ПолныеПроцентыПоРЕПО;
			
			Проводка.СчетКт = ПланыСчетов.Основной.КраткосрочныеКредиты;
			Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
			Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
			
			Проводка.ВалютаКт = ВыборкаДвиженияДокумента.ВалютаЧасть2;
			Проводка.ВалютнаяСуммаКт = ПолныеПроцентыПоРЕПО;
			
			
			// оплата полной суммы займа
			СуммаЗакрытияЗаймаПоТекущемуКурсу = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				ВыборкаДвиженияДокумента.СуммаЧасть2,
				ВыборкаДвиженияДокумента.ВалютаЧасть2,
				ЭтотОбъект.Организация,
				ЭтотОбъект.Дата);
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаЗакрытияЗаймаПоТекущемуКурсу, "Проценты по РЕПО");
			
			Проводка.СчетДт = ПланыСчетов.Основной.КраткосрочныеКредиты;
			Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
			Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
			
			Проводка.ВалютаДт = ВыборкаДвиженияДокумента.ВалютаЧасть2;
			Проводка.ВалютнаяСуммаДт = ВыборкаДвиженияДокумента.СуммаЧасть2;
			
			Проводка.СчетКт = СчетУчетаДС;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
				Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
				Проводка.СубконтоКт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
				Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
				Проводка.СубконтоКт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.ЗакрытиеРЕПО;
			КонецЕсли;			
			
			Если СчетУчетаДС.Валютный Тогда
				Проводка.ВалютаКт = ВыборкаДвиженияДокумента.ВалютаЧасть2;
				Проводка.ВалютнаяСуммаКт = ВыборкаДвиженияДокумента.СуммаЧасть2;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// комиссия	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаКомиссииСрезПоследних.ВидЗадолженности КАК ВидЗадолженности,
		|	НастройкиУчетаКомиссииСрезПоследних.СчетУчета КАК СчетУчета,
		|	ВЫБОР
		|		КОГДА НастройкиУчетаКомиссииСрезПоследних.АналитикаРЕПО = ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
		|			ТОГДА НастройкиУчетаКомиссииСрезПоследних.Аналитика
		|		ИНАЧЕ НастройкиУчетаКомиссииСрезПоследних.АналитикаРЕПО
		|	КОНЕЦ КАК АналитикаРЕПО
		|ИЗ
		|	РегистрСведений.НастройкиУчетаКомиссии.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|				И ВидУчета = &ВидУчета
		|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии))) КАК НастройкиУчетаКомиссииСрезПоследних";
	Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
	НастройкиКомиссии = Запрос.Выполнить().Выгрузить();
	// ------------
	
	Если ЭтотОбъект.ЧастьСделкиРЕПО = 1 Тогда
		
		МетодПризнанияРасходовПоСделкамРЕПО = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
			ЭтотОбъект.Дата, 
			ЭтотОбъект.Организация, 
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйРегистр,
			"МетодПризнанияРасходовПоСделкамРЕПО");
		
		Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
			
			ОбращаетсяНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(СтрокаЦенныеБумаги.ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
			
			ПараметрыКомиссии.Вставить("ЦеннаяБумага", СтрокаЦенныеБумаги.ЦеннаяБумага);
			ПараметрыКомиссии.Вставить("ОбращаетсяНаОРЦБ", ОбращаетсяНаОРЦБ);
			
			ОплатитьТорговуюКомиссию(Движения[УчетныйРегистр], СтрокаЦенныеБумаги.ТорговаяКомиссия, ПараметрыКомиссии);
			
			Если МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриНачислении
				ИЛИ (МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриОплате
						И НЕ ЭтотОбъект.ОтложеннаяОплатаТорговойКомиссии) Тогда
			
				НачислитьТорговуюКомиссию(Движения[УчетныйРегистр], СтрокаЦенныеБумаги.ТорговаяКомиссия, ПараметрыКомиссии, УчетныйРегистр);	
			
			КонецЕсли;
		
		КонецЦикла;
		
	Иначе // Закрытие РЕПО
		
		МетодПризнанияРасходовПоСделкамРЕПО = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
			СделкаРЕПО.Дата, 
			ЭтотОбъект.Организация, 
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйРегистр,
			"МетодПризнанияРасходовПоСделкамРЕПО");
		
		Если МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ВЗависимостиОтПериодичностиСОтражениемНаСчетеРасчетов Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	РасходыПоСделкеОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
				|	РасходыПоСделкеОбороты.СуммаОборот КАК ВсегоКомиссии,
				|	ЕСТЬNULL(БухгалтерскийУчетОстатки.СуммаОстаток, 0) КАК НачисленоКомиссии,
				|	РасходыПоСделкеОбороты.СуммаОборот - ЕСТЬNULL(БухгалтерскийУчетОстатки.СуммаОстаток, 0) КАК НачислитьКомиссии
				|ИЗ
				|	РегистрНакопления.РасходыПоСделке.Обороты(
				|			&НачалоПериода,
				|			&Период,
				|			Период,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления В (&СписокСтратегий)
				|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))
				|				И Сделка = &СделкаРЕПО) КАК РасходыПоСделкеОбороты
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
				|				&Период,
				|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыПоКомиссии),
				|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Сделка),
				|				Организация = &Организация
				|					И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
				|					И Субконто1 = &СделкаРЕПО) КАК БухгалтерскийУчетОстатки
				|		ПО РасходыПоСделкеОбороты.Сделка = БухгалтерскийУчетОстатки.Субконто1";
			Запрос.УстановитьПараметр("НачалоПериода", СделкаРЕПО.Дата);
			Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
			Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
			Запрос.УстановитьПараметр("СписокСтратегий", Справочники.СчетаДоверительногоУправления.ПолучитьМассивСчетовПоДоговоруДУ(ЭтотОбъект.СчетДоверительногоУправления));
			Запрос.УстановитьПараметр("СделкаРЕПО", СделкаРЕПО);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
			ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				СуммаКомиссии = ВыборкаДетальныеЗаписи.НачислитьКомиссии;
				СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКомиссии, СделкаРЕПО.ВалютаСделки, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
				ЦеннаяБумага = СделкаРЕПО.ЦенныеБумаги[0].ЦеннаяБумага;
				ВалютаСделки = СделкаРЕПО.ВалютаСделки;
				БУНУ_ПризнатьКомиссиюПоРЕПО(
					ЭтотОбъект.Движения[УчетныйРегистр],
					СуммаОперации,
					СделкаРЕПО,
					ЦеннаяБумага,
					СведенияОбОбращенииЦенныхБумагНаОРЦБ,
					СделкаРЕПО.Брокер.ЮрФизЛицо,
					Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
					НастройкиКомиссии,
					МетодПризнанияРасходовПоСделкамРЕПО);
			КонецЦикла;
		ИначеЕсли МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ВЗависимостиОтПериодичности Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	РасходыПоСделкеОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
				|	РасходыПоСделкеОбороты.СуммаОборот КАК ВсегоКомиссии,
				|	ЕСТЬNULL(БухгалтерскийУчетОстатки.СуммаОстаток, 0) КАК НачисленоКомиссии,
				|	РасходыПоСделкеОбороты.СуммаОборот - ЕСТЬNULL(БухгалтерскийУчетОстатки.СуммаОстаток, 0) КАК НачислитьКомиссии
				|ИЗ
				|	РегистрНакопления.РасходыПоСделке.Обороты(
				|			&НачалоПериода,
				|			&Период,
				|			Период,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления В (&СписокСтратегий)
				|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
				|				И Сделка = &СделкаРЕПО) КАК РасходыПоСделкеОбороты
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
				|				&Период,
				|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыПоКомиссии),
				|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Сделка),
				|				Организация = &Организация
				|					И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
				|					И Субконто1 = &СделкаРЕПО) КАК БухгалтерскийУчетОстатки
				|		ПО РасходыПоСделкеОбороты.Сделка = БухгалтерскийУчетОстатки.Субконто1";
			Запрос.УстановитьПараметр("НачалоПериода", СделкаРЕПО.Дата);
			Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
			Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
			Запрос.УстановитьПараметр("СписокСтратегий", Справочники.СчетаДоверительногоУправления.ПолучитьМассивСчетовПоДоговоруДУ(ЭтотОбъект.СчетДоверительногоУправления));
			Запрос.УстановитьПараметр("СделкаРЕПО", СделкаРЕПО);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
			ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				СуммаКомиссии = ВыборкаДетальныеЗаписи.НачислитьКомиссии;
				СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКомиссии, СделкаРЕПО.ВалютаСделки, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
				ЦеннаяБумага = СделкаРЕПО.ЦенныеБумаги[0].ЦеннаяБумага;
				ВалютаСделки = СделкаРЕПО.ВалютаСделки;
				БУНУ_ПризнатьКомиссиюПоРЕПО(
					ЭтотОбъект.Движения[УчетныйРегистр],
					СуммаОперации,
					СделкаРЕПО,
					ЦеннаяБумага,
					СведенияОбОбращенииЦенныхБумагНаОРЦБ,
					СделкаРЕПО.Брокер.ЮрФизЛицо,
					Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
					НастройкиКомиссии,
					МетодПризнанияРасходовПоСделкамРЕПО);
			КонецЦикла;

			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	РасходыПоСделкеОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
				|	РасходыПоСделкеОбороты.СуммаОборот КАК ВсегоКомиссии,
				|	ЕСТЬNULL(БухгалтерскийУчетОстатки.СуммаОстаток, 0) КАК НачисленоКомиссии,
				|	РасходыПоСделкеОбороты.СуммаОборот - ЕСТЬNULL(БухгалтерскийУчетОстатки.СуммаОстаток, 0) КАК НачислитьКомиссии
				|ИЗ
				|	РегистрНакопления.РасходыПоСделке.Обороты(
				|			&НачалоПериода,
				|			&Период,
				|			Период,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления В (&СписокСтратегий)
				|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
				|				И Сделка = &СделкаРЕПО) КАК РасходыПоСделкеОбороты
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
				|				&Период,
				|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыПоКомиссииБрокера),
				|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Сделка),
				|				Организация = &Организация
				|					И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
				|					И Субконто1 = &СделкаРЕПО) КАК БухгалтерскийУчетОстатки
				|		ПО РасходыПоСделкеОбороты.Сделка = БухгалтерскийУчетОстатки.Субконто1";
			Запрос.УстановитьПараметр("НачалоПериода", СделкаРЕПО.Дата);
			Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
			Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
			Запрос.УстановитьПараметр("СписокСтратегий", Справочники.СчетаДоверительногоУправления.ПолучитьМассивСчетовПоДоговоруДУ(ЭтотОбъект.СчетДоверительногоУправления));
			Запрос.УстановитьПараметр("СделкаРЕПО", СделкаРЕПО);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
			ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				СуммаКомиссии = ВыборкаДетальныеЗаписи.НачислитьКомиссии;
				СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКомиссии, СделкаРЕПО.ВалютаСделки, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
				ЦеннаяБумага = СделкаРЕПО.ЦенныеБумаги[0].ЦеннаяБумага;
				ВалютаСделки = СделкаРЕПО.ВалютаСделки;
				БУНУ_ПризнатьКомиссиюПоРЕПО(
					ЭтотОбъект.Движения[УчетныйРегистр],
					СуммаОперации,
					СделкаРЕПО,
					ЦеннаяБумага,
					СведенияОбОбращенииЦенныхБумагНаОРЦБ,
					СделкаРЕПО.Брокер.ЮрФизЛицо,
					Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии,
					НастройкиКомиссии,
					МетодПризнанияРасходовПоСделкамРЕПО);
			КонецЦикла;
		
		КонецЕсли;
		
	КонецЕсли;
	
	//отложенная курсовая разница 
	Если ЭтотОбъект.ЧастьСделкиРЕПО = 2 И ЭтотОбъект.ВалютаОплаты <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль")
		И УчетныйРегистр = "НалоговыйУчет" Тогда 
		СписатьОтложеннуюКурсовуюРазницу(УчетныйРегистр);
	КонецЕсли;	
	
КонецПроцедуры

Процедура ДвижениеЗакрытияПродажиКорректировки(ПараметрыСписания, Отказ) 
	
	УчетныйСчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления);
	
	СуммаВал 		= ПараметрыСписания.СуммаВал; // Это сумма в валюте номинала
	Если СуммаВал = 0 Тогда // немного странное условие, но мы все эти годы жили с ним - вытащил его в начало
		Возврат;
	КонецЕсли;
	
	СуммаУчета 		= ПараметрыСписания.СуммаУчета;
	УчетныйАктив 	= ПараметрыСписания.УчетныйАктив;
	ЦеннаяБумага 	= ПараметрыСписания.ЦеннаяБумага;
	
	АналитикаЦБ = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПустаяСсылка();
	
	ЭтоРасход = (СуммаУчета < 0);
	
	Показатель		= ПараметрыСписания.Показатель;
	Если Показатель = "КорректировкаЭСП" Тогда
		СчетУчета	= ?(ЭтоРасход, УчетныйАктив.СчетУчетаКорректировокП, УчетныйАктив.СчетУчетаКорректировокА);
		Аналитика	= ?(ЭтоРасход, УчетныйАктив.АналитикаРасходовОтКорректировки, УчетныйАктив.АналитикаДоходовОтКорректировки);
	ИначеЕсли Показатель = "Переоценка" Тогда
		СчетУчета	= ?(ЭтоРасход, УчетныйАктив.СчетУчетаПереоценкиП, УчетныйАктив.СчетУчетаПереоценкиА);
		Аналитика	= ?(ЭтоРасход, УчетныйАктив.АналитикаРасходовОтПереоценки, УчетныйАктив.АналитикаДоходовОтПереоценки);
		АналитикаЦБ = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги;
	ИначеЕсли Показатель = "ИндексацияНоминала" Тогда
		СчетУчета	= ?(ЭтоРасход, УчетныйАктив.СчетУчетаПереоценкиП, УчетныйАктив.СчетУчетаПереоценкиА);
		Аналитика	= ?(ЭтоРасход, УчетныйАктив.АналитикаРасходовОтПереоценки, УчетныйАктив.АналитикаДоходовОтПереоценки);
		АналитикаЦБ	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ИндексацияНоминала;
	ИначеЕсли Показатель = "РазницаПервоначальногоПризнания" Тогда
		СчетУчета	= ?(ЭтоРасход, УчетныйАктив.СчетУчетаОтрицательнойРазницыПервоначальногоПризнанияУровень3Дт, УчетныйАктив.СчетУчетаПоложительнойРазницыПервоначальногоПризнанияУровень3Кт);
		Аналитика	= ?(ЭтоРасход, УчетныйАктив.АналитикаРасходовПервоначальногоПризнания, УчетныйАктив.АналитикаДоходовПервоначальногоПризнания);
		Если ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") ИЛИ ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Векселя") Тогда
			АналитикаЦБ = Справочники.ДополнительныеАналитикиЛицевыхСчетов.РазницаПервоначальногоПризнания;
		КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Счетов учета показателя " + Показатель, ,,, Отказ);
		Возврат;
	КонецЕсли;
	
	СторонаЦБ	= ?(ЭтоРасход, "Кт", "Дт");
	СторонаНеЦБ = ?(ЭтоРасход, "Дт", "Кт");
	
	МеняемЗнак = (СуммаУчета <> МатематическиеФункции.МодульЧисла(СуммаУчета));
	Если МеняемЗнак Тогда
		СуммаВал 	= -СуммаВал;
		СуммаУчета 	= -СуммаУчета;
	КонецЕсли;
	
	Содержание = "Закрытие продажи РЕПО (" + Показатель + ")";
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаУчета, Содержание);
	
	// со стороны бумаги (счета 5ХХ)
	Проводка["Счет" + СторонаЦБ] = СчетУчета;	
	Проводка["Субконто" + СторонаЦБ].ЦенныеБумаги = ЦеннаяБумага;
	
	Проводка["Количество" + СторонаЦБ] = 0;
	Проводка["Валюта" + СторонаЦБ] = ПараметрыСписания.ВалютаНоминала;
	Проводка["ВалютнаяСумма" + СторонаЦБ] = СуммаВал;
	
	Проводка["ДополнительнаяАналитика" + СторонаЦБ] = АналитикаЦБ;
	
	// Корреспонденция
	АналитикаУчетногоАктиваВРЕПО = Справочники.УчетныеАктивыЕПС.ПолучитьДанныеУчетногоАктиваЕПСДляБумагВРЕПО(УчетныйАктив, Отказ);
	
	Если Показатель = "КорректировкаЭСП" Тогда
		СчетУчетаСторонаНеЦБ	= ?(ЭтоРасход, АналитикаУчетногоАктиваВРЕПО.СчетУчетаКорректировокП, АналитикаУчетногоАктиваВРЕПО.СчетУчетаКорректировокА);
	ИначеЕсли Показатель = "Переоценка" Тогда
		СчетУчетаСторонаНеЦБ	= ?(ЭтоРасход, АналитикаУчетногоАктиваВРЕПО.СчетУчетаПереоценкиП, АналитикаУчетногоАктиваВРЕПО.СчетУчетаПереоценкиА);
	ИначеЕсли Показатель = "ИндексацияНоминала" Тогда
		СчетУчетаСторонаНеЦБ	= ?(ЭтоРасход, АналитикаУчетногоАктиваВРЕПО.СчетУчетаПереоценкиП, АналитикаУчетногоАктиваВРЕПО.СчетУчетаПереоценкиА);
	ИначеЕсли Показатель = "РазницаПервоначальногоПризнания" Тогда
		СчетУчетаСторонаНеЦБ	= ?(ЭтоРасход, АналитикаУчетногоАктиваВРЕПО.СчетУчетаПереоценкиП, АналитикаУчетногоАктиваВРЕПО.СчетУчетаПереоценкиА);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Счетов учета показателя " + Показатель, ,,, Отказ);
		Возврат;
	КонецЕсли;
	
	Проводка["Счет" + СторонаНеЦБ] = СчетУчетаСторонаНеЦБ;
	Проводка["Субконто" + СторонаНеЦБ].ЦенныеБумаги = ЦеннаяБумага;
	Проводка["ДополнительнаяАналитика" + СторонаНеЦБ] = АналитикаЦБ;
	Проводка["Количество" + СторонаНеЦБ] = 0;
	Если Проводка["Счет" + СторонаНеЦБ].Валютный Тогда
		Проводка["Валюта" + СторонаНеЦБ] = ПараметрыСписания.ВалютаУчета;
		Проводка["ВалютнаяСумма" + СторонаНеЦБ] = СуммаУчета;
	КонецЕсли;
	
	Партия			= ?(ПараметрыСписания.Свойство("Партия"), ПараметрыСписания.Партия, Неопределено);	
	СтрокаПартии	= ?(ПараметрыСписания.Свойство("СтрокаПартии"), ПараметрыСписания.СтрокаПартии, Неопределено);	
	
	Если Партия <> Неопределено Тогда
		Проводка.Партия = Партия;
		Проводка.СтрокаПартии = СтрокаПартии;
	КонецЕсли;
	
КонецПроцедуры

Процедура СписатьОтложеннуюКурсовуюРазницу(УчетныйРегистр)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НалоговыйУчетОборотыДтКт.СчетКт КАК Счет,
		|	НалоговыйУчетОборотыДтКт.СубконтоКт1 КАК Субконто1,
		|	НалоговыйУчетОборотыДтКт.СубконтоКт2 КАК Субконто2,
		|	СУММА(НалоговыйУчетОборотыДтКт.СуммаОборот) КАК СуммаОборот
		|ИЗ
		|	РегистрБухгалтерии.НалоговыйУчет.ОборотыДтКт(
		|			&НачалоПериода,
		|			&ОкончаниеПериода,
		|			,
		|			СчетДт = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПредоставленныеЗаймы),
		|			,
		|			СчетКт = ЗНАЧЕНИЕ(ПланСчетов.Основной.ДоходыБудущихПериодов),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И СубконтоДт2 = &СделкаРЕПО) КАК НалоговыйУчетОборотыДтКт
		|
		|СГРУППИРОВАТЬ ПО
		|	НалоговыйУчетОборотыДтКт.СчетКт,
		|	НалоговыйУчетОборотыДтКт.СубконтоКт1,
		|	НалоговыйУчетОборотыДтКт.СубконтоКт2
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НалоговыйУчетОборотыДтКт.СчетДт,
		|	НалоговыйУчетОборотыДтКт.СубконтоДт1,
		|	НалоговыйУчетОборотыДтКт.СубконтоДт2,
		|	СУММА(НалоговыйУчетОборотыДтКт.СуммаОборот)
		|ИЗ
		|	РегистрБухгалтерии.НалоговыйУчет.ОборотыДтКт(
		|			&НачалоПериода,
		|			&ОкончаниеПериода,
		|			,
		|			СчетДт = ЗНАЧЕНИЕ(ПланСчетов.Основной.РасходыБудущихПериодов),
		|			,
		|			СчетКт = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПредоставленныеЗаймы),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И СубконтоКт2 = &СделкаРЕПО) КАК НалоговыйУчетОборотыДтКт
		|
		|СГРУППИРОВАТЬ ПО
		|	НалоговыйУчетОборотыДтКт.СчетДт,
		|	НалоговыйУчетОборотыДтКт.СубконтоДт1,
		|	НалоговыйУчетОборотыДтКт.СубконтоДт2";
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СделкаРЕПО", ЭтотОбъект.ПерваяЧастьРЕПО);
	Запрос.УстановитьПараметр("НачалоПериода", ЭтотОбъект.ПерваяЧастьРЕПО.Дата);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ЭтотОбъект.Дата);
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.Прямой);
	
	Пока Выборка.Следующий() Цикл 
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СуммаОборот, "Отложенная курсовая разница, принятая к учету");
		
		Если Выборка.Счет = ПланыСчетов.Основной.ДоходыБудущихПериодов Тогда 
			
			Проводка.СчетДт = Выборка.Счет;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = Выборка.Субконто1;
			Проводка.СубконтоДт.ЦенныеБумаги = Выборка.Субконто2;
			
			Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = Выборка.Субконто1;

		ИначеЕсли Выборка.Счет = ПланыСчетов.Основной.РасходыБудущихПериодов Тогда
			
			Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = Выборка.Субконто1;
			
			Проводка.СчетКт = Выборка.Счет;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = Выборка.Субконто1;
			Проводка.СубконтоКт.ЦенныеБумаги = Выборка.Субконто2;
					
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	

Процедура БУНУ_ПризнатьКомиссиюПоРЕПО(Движения, СуммаОперации, СделкаРЕПО, ЦеннаяБумага, СведенияОбОбращенииЦенныхБумагНаОРЦБ, КонтрагентПоКомиссии, ВидКомиссии, НастройкиКомиссии, МетодПризнанияРасходовПоСделкамРЕПО)
	
	// СуммаКомиссии, ВалютаСделки - не используются т.к. невалютные счета

	Если ВидКомиссии = Справочники.ВидыЗадолженности.ПоТорговойКомиссии Тогда
	
		ОписаниеПроводкиНачисления = "Начисление торговой комиссия";
		
	ИначеЕсли ВидКомиссии = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии Тогда
		
		ОписаниеПроводкиНачисления = "Начисление брокерской комиссия";
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	НастройкаКомиссии = НастройкиКомиссии.Найти(ВидКомиссии, "ВидЗадолженности");
	
	ДанныеАналитики = Новый Структура("СделкаРЕПО, ВидЗадолженности", СделкаРЕПО, ВидКомиссии);
	
	
	// ПРИЗНАНИЕ КОМИССИИ
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, СуммаОперации, ОписаниеПроводкиНачисления, ДанныеАналитики);
	
	// дебет
	Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
	
	Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкаКомиссии.АналитикаРЕПО;
	Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
	Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
	
	// кредит
	Если МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ВЗависимостиОтПериодичностиСОтражениемНаСчетеРасчетов Тогда
		// если настройка "...НаСчетеРасчетов" то и отражаем на счете РасчетыПоКомиссии
		Проводка.СчетКт = ПланыСчетов.Основной.РасчетыПоКомиссии;
	Иначе
		// на счете учета комиссии
		Проводка.СчетКт = НастройкаКомиссии.СчетУчета;
	КонецЕсли;

	Проводка.СубконтоКт.Контрагенты = КонтрагентПоКомиссии;
	Проводка.СубконтоКт.Сделка = СделкаРЕПО;
	
	//Проводка.ВалютаКт = ВалютаСделки;
	//Проводка.ВалютнаяСуммаКт = СуммаКомиссии;
	
КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерииОбратноеРЕПО(УчетныйРегистр, Отказ)

	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);
	
	ВидСубконтоУчетаЦеннойБумаги = БухгалтерскийУчет.ОпределитьВидСубконтоУчетаЦеннойБумаги(ЭтотОбъект.Рынок);	
		
	СчетДоходов = ПланыСчетов.Основной.ПрочиеДоходы;	
	СчетРасходов = ПланыСчетов.Основной.ПрочиеРасходы;
		
	СчетУчетаДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВалютаСделки,
		ЭтотОбъект.Брокер);	
		
	СчетУчетаКомиссии = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
		УчетныйРегистр,
		"СчетУчета");
		
	СделкаРЕПО = ?(ЭтотОбъект.ЧастьСделкиРЕПО = 2, ЭтотОбъект.ПерваяЧастьРЕПО, ЭтотОбъект.Ссылка);
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СделкаРЕПО, "Ссылка, СчетДоверительногоУправления, Дата, Брокер, Контрагент, РежимБиржевыхТоргов");
	КонтрагентПоСделке = БухгалтерскийУчет.ОпределитьКонтрагентаПоСделкеРЕПО(Реквизиты, НастройкиУчета);
	
	ПараметрыКомиссии = Новый Структура;
	ПараметрыКомиссии.Вставить("СчетУчетаКомиссии", СчетУчетаКомиссии);
	ПараметрыКомиссии.Вставить("СчетУчетаДС", СчетУчетаДС);
	
	Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
		СубконтоДоговорыБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
		ПараметрыКомиссии.Вставить("СубконтоДоговорыБрокерскогоОбслуживания", СубконтоДоговорыБрокерскогоОбслуживания);
	КонецЕсли;
		
	ЕстьСубконтоКонтрагентыПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);						
	ПараметрыКомиссии.Вставить("ЕстьСубконтоКонтрагентыПоКомиссии", ЕстьСубконтоКонтрагентыПоКомиссии);
	Если ЕстьСубконтоКонтрагентыПоКомиссии Тогда
		КонтрагентПоКомиссии = ЭтотОбъект.Брокер.ЮрФизЛицо;
		ПараметрыКомиссии.Вставить("КонтрагентПоКомиссии", КонтрагентПоКомиссии);
	КонецЕсли;
	
	ЕстьСубконтоСделкиПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Сделка) <> Неопределено);
	ПараметрыКомиссии.Вставить("ЕстьСубконтоСделкиПоКомиссии", ЕстьСубконтоСделкиПоКомиссии);
	
	АналитикаУслуг = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
		УчетныйРегистр,
		"АналитикаРЕПО");		
	
	Если Не ЗначениеЗаполнено(АналитикаУслуг) Тогда 	
		АналитикаУслуг = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
		УчетныйРегистр,
		"Аналитика");	
	КонецЕсли;		
	
	ПараметрыКомиссии.Вставить("АналитикаУслуг", АналитикаУслуг);
	ПараметрыКомиссии.Вставить("ВключатьРасходыПоПокупкеВСтоимость", Ложь);
	ПараметрыКомиссии.Вставить("ВидСубконтоУчетаЦеннойБумаги", ВидСубконтоУчетаЦеннойБумаги);
	
	АналитикаПерекурсовкиРасчетовПоРЕПО = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления, 
		Справочники.УчетныеАктивы.РасчетыПоОбратномуРЕПО, 
		УчетныйРегистр, 
		"АналитикаПерекурсовки"); 
		
	АналитикаДоходовРасчетовПоРЕПО = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления, 
		Справочники.УчетныеАктивы.РасчетыПоОбратномуРЕПО, 
		УчетныйРегистр, 
		"АналитикаДоходов"); 
		
	АналитикаДоходовПереоценкиПоРЕПО = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления, 
		Справочники.УчетныеАктивы.РасчетыПоОбратномуРЕПО, 
		УчетныйРегистр, 
		"АналитикаДоходовОтПереоценки"); 
		
	СчетПереоценкиРасчетовПоРЕПО = ПланыСчетов.Основной.НалоговыеНачисленияПоРЕПО; 
		
	ЭтоПИФ = ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда;
			
	// ЦЕННЫЕ БУМАГИ
	СведенияОбОбращенииЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(ЭтотОбъект.Дата, ЭтотОбъект.Ссылка, УчетныйРегистр);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияЧасть1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	УсловияЧасть1.ВалютаОплаты КАК ВалютаЧасть1,
		|	УсловияЧасть2.ВалютаОплаты КАК ВалютаЧасть2,
		|	УсловияЧасть1.Сумма + УсловияЧасть1.СуммаКупона КАК СуммаЧасть1,
		|	УсловияЧасть2.Сумма + УсловияЧасть2.СуммаКупона КАК СуммаЧасть2,
		|	ЕСТЬNULL(БухгалтерскийУчетРасчетыПоРЕПО.СуммаОстатокДт, 0) КАК СуммаОстатокРасчетыПоРЕПО,
		|	ЕСТЬNULL(БухгалтерскийУчетРасчетыПоРЕПО.ВалютнаяСуммаОстатокДт, 0) КАК ВалютнаяСуммаОстатокРасчетыПоРЕПО,
		|	ЕСТЬNULL(БухгалтерскийУчетПроцентыПоРЕПО.СуммаОстаток, 0) КАК СуммаОстатокПроцентыПоРЕПО,
		|	ЕСТЬNULL(БухгалтерскийУчетПроцентыПоРЕПО.ВалютнаяСуммаОстаток, 0) КАК ВалютнаяСуммаОстатокПроцентыПоРЕПО
		|ИЗ
		|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|			&ПериодУсловияСделок,
		|			СделкаРЕПО = &СделкаРЕПО
		|				И ЧастьСделкиРЕПО = 1) КАК УсловияЧасть1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПредоставленныеЗаймы),
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.СделкаРЕПО),
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|					И Субконто1 = &СделкаРЕПО) КАК БухгалтерскийУчетРасчетыПоРЕПО
		|		ПО УсловияЧасть1.СделкаРЕПО = БухгалтерскийУчетРасчетыПоРЕПО.Субконто1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоКраткосрочнымКредитам)
		|					ИЛИ Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.НалоговыеНачисленияПоРЕПО),
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.СделкаРЕПО),
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|					И Субконто1 = &СделкаРЕПО) КАК БухгалтерскийУчетПроцентыПоРЕПО
		|		ПО УсловияЧасть1.СделкаРЕПО = БухгалтерскийУчетПроцентыПоРЕПО.Субконто1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|				&ПериодУсловияСделок,
		|				СделкаРЕПО = &СделкаРЕПО
		|					И ЧастьСделкиРЕПО = 2) КАК УсловияЧасть2
		|		ПО УсловияЧасть1.СделкаРЕПО = УсловияЧасть2.СделкаРЕПО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.Количество КАК Количество,
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.Стоимость + БухПартииЦенныхБумагКупленныеПоРЕПО.Переоценка КАК Стоимость,
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьВВалютеУчета + БухПартииЦенныхБумагКупленныеПоРЕПО.ПереоценкаВВалютеУчета КАК СтоимостьВВалютеУчета,
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьКупона + БухПартииЦенныхБумагКупленныеПоРЕПО.ПереоценкаКупона КАК СтоимостьКупона,
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьКупонаВВалютеУчета + БухПартииЦенныхБумагКупленныеПоРЕПО.ПереоценкаКупонаВВалютеУчета КАК СтоимостьКупонаВВалютеУчета
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО КАК БухПартииЦенныхБумагКупленныеПоРЕПО
		|ГДЕ
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумагКупленныеПоРЕПО.ВидУчета = &ВидУчета";

	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ПериодУсловияСделок", КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("СделкаРЕПО", СделкаРЕПО);

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", УчетныйРегистр);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Выборка = РезультатЗапроса[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ОбращаетсяНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(Выборка.ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
		
		Если ЭтотОбъект.ЧастьСделкиРЕПО = 1 Тогда // ОТКРЫТИЕ ПОКУПКИ РЕПО
	
			СуммаЗаймаПоТекущемуКурсу = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				Выборка.СуммаЧасть1,
				Выборка.ВалютаЧасть1,
				ЭтотОбъект.Организация,
				ЭтотОбъект.Дата);
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаЗаймаПоТекущемуКурсу, "Займ РЕПО");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Основной.ПредоставленныеЗаймы;
			Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
			Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
			
			Проводка.ВалютаДт = Выборка.ВалютаЧасть1;
			Проводка.ВалютнаяСуммаДт = Выборка.СуммаЧасть1;
			
			// кредит
			Проводка.СчетКт = СчетУчетаДС;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда 
				Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
				Проводка.СубконтоКт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
				Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
				Проводка.СубконтоКт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.ОткрытиеРЕПО;
			КонецЕсли;			
			
			Если СчетУчетаДС.Валютный Тогда
				Проводка.ВалютаКт = Выборка.ВалютаЧасть1;
				Проводка.ВалютнаяСуммаКт = Выборка.СуммаЧасть1;
			КонецЕсли;
			
		Иначе // ЗАКРЫТИЕ ПОКУПКИ РЕПО
			
			// Перекурсовка Займа
			СуммаЗаймаПоТекущемуКурсу = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				Выборка.ВалютнаяСуммаОстатокРасчетыПоРЕПО,
				Выборка.ВалютаЧасть2,
				ЭтотОбъект.Организация,
				ЭтотОбъект.Дата);
				
			КурсоваяРазницаЗайм = СуммаЗаймаПоТекущемуКурсу - Выборка.СуммаОстатокРасчетыПоРЕПО;
				
			Если КурсоваяРазницаЗайм > 0 Тогда
			
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], КурсоваяРазницаЗайм, "Курсовая разница");
				
				Проводка.СчетДт = ПланыСчетов.Основной.ПредоставленныеЗаймы;
				Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
				Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
				
				Проводка.ВалютаДт = Выборка.ВалютаЧасть1;
				
				Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
				Проводка.СубконтоКт.ПрочиеДоходыИРасходы = НастройкиУчета.АналитикаПерекурсовкиЗаймов;
				
			ИначеЕсли КурсоваяРазницаЗайм < 0 Тогда
			
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], -КурсоваяРазницаЗайм, "Курсовая разница");
				
				Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчета.АналитикаПерекурсовкиЗаймов;
				
				Проводка.СчетКт = ПланыСчетов.Основной.ПредоставленныеЗаймы;
				Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
				Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
				
				Проводка.ВалютаКт = Выборка.ВалютаЧасть1;
				
			КонецЕсли;
			
			// Перекурсовка Процентов
			СуммаПроцентовПоТекущемуКурсу = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				Выборка.ВалютнаяСуммаОстатокПроцентыПоРЕПО,
				Выборка.ВалютаЧасть2,
				ЭтотОбъект.Организация,
				ЭтотОбъект.Дата);
				
			КурсоваяРазницаПроценты = СуммаПроцентовПоТекущемуКурсу - Выборка.СуммаОстатокПроцентыПоРЕПО;
			
			Если КурсоваяРазницаПроценты > 0 Тогда
			
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], КурсоваяРазницаПроценты, "Курсовая разница");
				
				Проводка.СчетДт = СчетПереоценкиРасчетовПоРЕПО;
				Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
				Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
				
				Проводка.ВалютаДт = Выборка.ВалютаЧасть1;
				
				Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
				Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаПерекурсовкиРасчетовПоРЕПО;
				
			ИначеЕсли КурсоваяРазницаПроценты < 0 Тогда
			
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], -КурсоваяРазницаПроценты, "Курсовая разница");
				
				Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаПерекурсовкиРасчетовПоРЕПО;
				
				Проводка.СчетКт = СчетПереоценкиРасчетовПоРЕПО;
				Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
				Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
				
				Проводка.ВалютаКт = Выборка.ВалютаЧасть1;
				
			КонецЕсли;
			
			ПолныеПроцентыПоРЕПО = Выборка.СуммаЧасть2 - Выборка.ВалютнаяСуммаОстатокРасчетыПоРЕПО;
			ПолныеПроцентыПоРЕПОПоТекущемуКурсу = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				ПолныеПроцентыПоРЕПО,
				Выборка.ВалютаЧасть1,
				ЭтотОбъект.Организация,
				ЭтотОбъект.Дата);
			
			ДоначислитьПроцентовПоРЕПО = ПолныеПроцентыПоРЕПО - Выборка.ВалютнаяСуммаОстатокПроцентыПоРЕПО;
			ДоначислитьПроцентовПоРЕПОПоТекущемуКурсу = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				ДоначислитьПроцентовПоРЕПО,
				Выборка.ВалютаЧасть1,
				ЭтотОбъект.Организация,
				ЭтотОбъект.Дата);
				
			Если ЭтоПИФ И ЗначениеЗаполнено(АналитикаДоходовПереоценкиПоРЕПО) И АналитикаДоходовПереоценкиПоРЕПО <> АналитикаДоходовРасчетовПоРЕПО Тогда
				
				//закроем переоценку
				Если Выборка.ВалютнаяСуммаОстатокПроцентыПоРЕПО <> 0 Тогда
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаПроцентовПоТекущемуКурсу, "Переоценка по РЕПО");
				
					// дебет
					Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
					Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходовПереоценкиПоРЕПО;
					Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
					Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
					
					// кредит
					Проводка.СчетКт = СчетПереоценкиРасчетовПоРЕПО;
					Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
					Проводка.Субконтокт.СделкаРЕПО = СделкаРЕПО;
					
					Проводка.ВалютаКт = Выборка.ВалютаЧасть2;
					Проводка.ВалютнаяСуммаКт = Выборка.ВалютнаяСуммаОстатокПроцентыПоРЕПО;
				КонецЕсли;
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ПолныеПроцентыПоРЕПОПоТекущемуКурсу, "Проценты по РЕПО");
			
				// дебет
				Проводка.СчетДт = СчетПереоценкиРасчетовПоРЕПО;
				Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
				Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
				
				Проводка.ВалютаДт = Выборка.ВалютаЧасть2;
				Проводка.ВалютнаяСуммаДт = ПолныеПроцентыПоРЕПО;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
				Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходовРасчетовПоРЕПО;
				Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
				Проводка.СубконтоКт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
					
			Иначе	
				Если ДоначислитьПроцентовПоРЕПО > 0 Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ДоначислитьПроцентовПоРЕПОПоТекущемуКурсу, "Проценты по РЕПО");
				
					// дебет
					Проводка.СчетДт = СчетПереоценкиРасчетовПоРЕПО;
					Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
					Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
					
					Проводка.ВалютаДт = Выборка.ВалютаЧасть2;
					Проводка.ВалютнаяСуммаДт = ДоначислитьПроцентовПоРЕПО;
					
					// кредит
					Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
					Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходовРасчетовПоРЕПО;
					Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
					Проводка.СубконтоКт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
					
				ИначеЕсли ДоначислитьПроцентовПоРЕПО < 0 Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], -ДоначислитьПроцентовПоРЕПОПоТекущемуКурсу, "Проценты по РЕПО");
				
					// дебет
					Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеДоходы;
					Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходовРасчетовПоРЕПО;
					Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
					Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
					
					// кредит
					Проводка.СчетКт = СчетПереоценкиРасчетовПоРЕПО;
					Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
					Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
					
					Проводка.ВалютаКт = Выборка.ВалютаЧасть2;
					Проводка.ВалютнаяСуммаКт = -ДоначислитьПроцентовПоРЕПО;
					
				КонецЕсли;
			КонецЕсли;
			
			// закрываем проценты на займ
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ПолныеПроцентыПоРЕПОПоТекущемуКурсу, "Проценты по РЕПО");
		
			// дебет
			Проводка.СчетДт = ПланыСчетов.Основной.ПредоставленныеЗаймы;
			Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
			Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
			
			Проводка.ВалютаДт = Выборка.ВалютаЧасть2;
			Проводка.ВалютнаяСуммаДт = ПолныеПроцентыПоРЕПО;
			
			// кредит
			Проводка.СчетКт = СчетПереоценкиРасчетовПоРЕПО;
			Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
			Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
			
			Проводка.ВалютаКт = Выборка.ВалютаЧасть2;
			Проводка.ВалютнаяСуммаКт = ПолныеПроцентыПоРЕПО;
			
			
			// оплата полной суммы займа
			СуммаЗакрытияЗаймаПоТекущемуКурсу = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				Выборка.СуммаЧасть2,
				Выборка.ВалютаЧасть2,
				ЭтотОбъект.Организация,
				ЭтотОбъект.Дата);
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаЗакрытияЗаймаПоТекущемуКурсу, "Возврат займа РЕПО");
			
			// дебет
			Проводка.СчетДт = СчетУчетаДС;
			
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
				Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
			КонецЕсли;
			
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
				Проводка.СубконтоДт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
			КонецЕсли;
			
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
				Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
			КонецЕсли;
			
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
				Проводка.СубконтоДт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.ЗакрытиеРЕПО;
			КонецЕсли;			
						
			Если СчетУчетаДС.Валютный Тогда
				Проводка.ВалютаДт = Выборка.ВалютаЧасть2;
				Проводка.ВалютнаяСуммаДт = Выборка.СуммаЧасть2;
			КонецЕсли;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Основной.ПредоставленныеЗаймы;
			Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
			Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
			
			Проводка.ВалютаКт = Выборка.ВалютаЧасть2;
			Проводка.ВалютнаяСуммаКт = Выборка.СуммаЧасть2;
			
		КонецЕсли;	
		
	КонецЦикла;

	//забаланс
	Выборка = РезультатЗапроса[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ЭтотОбъект.ЧастьСделкиРЕПО = 1 Тогда // ОТКРЫТИЕ ПОКУПКИ РЕПО
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СтоимостьВВалютеУчета, "Бумаги купленные по РЕПО");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Основной.ПартииРЕПОПокупкаТело;
			Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
			
			Проводка.КоличествоДт = Выборка.Количество;
			Проводка.ВалютаДт = Выборка.ЦеннаяБумага.ВалютаНоминала;
			Проводка.ВалютнаяСуммаДт = Выборка.Стоимость;
			
			Если Выборка.СтоимостьКупона > 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СтоимостьКупонаВВалютеУчета, "Бумаги купленные по РЕПО");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Основной.ПартииРЕПОПокупкаКупон;
				Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
				
				Проводка.ВалютаДт = Выборка.ЦеннаяБумага.ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт = Выборка.СтоимостьКупона;
				
			КонецЕсли; 
			
		Иначе // ЗАКРЫТИЕ ПОКУПКИ РЕПО
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СтоимостьВВалютеУчета, "Бумаги купленные по РЕПО");
			
			// дебет
			Проводка.СчетКт = ПланыСчетов.Основной.ПартииРЕПОПокупкаТело;
			Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
			
			Проводка.КоличествоКт = Выборка.Количество;
			Проводка.ВалютаКт = Выборка.ЦеннаяБумага.ВалютаНоминала;
			Проводка.ВалютнаяСуммаКт = Выборка.Стоимость;
			
			Если Выборка.СтоимостьКупона > 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СтоимостьКупонаВВалютеУчета, "Бумаги купленные по РЕПО");
				
				// дебет
				Проводка.СчетКт = ПланыСчетов.Основной.ПартииРЕПОПокупкаКупон;
				Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
				
				Проводка.ВалютаКт = Выборка.ЦеннаяБумага.ВалютаНоминала;
				Проводка.ВалютнаяСуммаКт = Выборка.СтоимостьКупона;
				
			КонецЕсли; 
			
		КонецЕсли;	
		
	КонецЦикла;
	
	
	
	// комиссия	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаКомиссииСрезПоследних.ВидЗадолженности КАК ВидЗадолженности,
		|	НастройкиУчетаКомиссииСрезПоследних.СчетУчета КАК СчетУчета,
		|	ВЫБОР
		|		КОГДА НастройкиУчетаКомиссииСрезПоследних.АналитикаРЕПО = ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
		|			ТОГДА НастройкиУчетаКомиссииСрезПоследних.Аналитика
		|		ИНАЧЕ НастройкиУчетаКомиссииСрезПоследних.АналитикаРЕПО
		|	КОНЕЦ КАК АналитикаРЕПО
		|ИЗ
		|	РегистрСведений.НастройкиУчетаКомиссии.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|				И ВидУчета = &ВидУчета
		|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии))) КАК НастройкиУчетаКомиссииСрезПоследних";
	Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
