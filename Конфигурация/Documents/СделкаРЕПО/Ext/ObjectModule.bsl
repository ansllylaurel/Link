					//дооценки перед расходом купона, дисконта и т.п.
					Если ВыборкаДооценкаПартий.ДисконтПремияНачисленный<>0 Тогда
						ПараметрыНачисления = Новый Структура("СуммаУчета, СуммаВал, ВалютаУчета, УчетныйАктив, ЦеннаяБумага, ВалютаНоминала",
							ВыборкаДооценкаПартий.ДисконтПремияНачисленныйВВалютеУчета, ВыборкаДооценкаПартий.ДисконтПремияНачисленный, ВыборкаДооценкаПартий.ВалютаУчета, УчетныйАктив, ВыборкаДооценкаПартий.ЦеннаяБумага, ВалютаНоминала);
						ПараметрыНачисления.Вставить("Аналитика", ?(ВыборкаДооценкаПартий.ДисконтПремияНачисленный<0, АналитикаПремии, АналитикаДисконта));
						БухгалтерскийУчетЕПС.НачислитьДисконтПремию(ЭтотОбъект, ПараметрыНачисления, Отказ);
					КонецЕсли;
					
					Если ВыборкаДооценкаПартий.КорректировкаЭСП<>0 Тогда
						ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
							"КорректировкаЭСП", ВыборкаДооценкаПартий.КорректировкаЭСП, ВыборкаДооценкаПартий.КорректировкаЭСПВВалютеУчета, ВыборкаДооценкаПартий.ВалютаУчета,  УчетныйАктив, ВыборкаДооценкаПартий.ЦеннаяБумага, ВалютаНоминала, Неопределено);
						БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
						
					КонецЕсли;
					
					Если ВыборкаДооценкаПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные<>0 Тогда
						ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
							"РазницаПервоначальногоПризнания", ВыборкаДооценкаПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные, ВыборкаДооценкаПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета, ВыборкаДооценкаПартий.ВалютаУчета, УчетныйАктив, ВыборкаДооценкаПартий.ЦеннаяБумага, ВалютаНоминала, Неопределено);
						БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			// Конец дооценки
			
			Пока Выборка.Следующий() Цикл
				
				Если МассивЦенныхБумаг.Найти(Выборка.ЦеннаяБумага) = Неопределено Тогда
					МассивЦенныхБумаг.Добавить(Выборка.ЦеннаяБумага);
				КонецЕсли;
				Если МассивУчетныхАктивов.Найти(Выборка.УчетныйАктив) = Неопределено Тогда
					МассивУчетныхАктивов.Добавить(Выборка.УчетныйАктив);
