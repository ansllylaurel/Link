							Проводка.ВалютнаяСуммаКт = Выборка.СтоимостьКупона;
						КонецЕсли;	
						
						Проводка.ДополнительнаяАналитикаКт = АналитикаКупонПриобретенный;
							
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Выборка.ПереоценкаКупонаВВалютеУчета) Или ЗначениеЗаполнено(Выборка.ПереоценкаКупона) Тогда
						Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, Выборка.ПереоценкаКупонаВВалютеУчета, "Передача ценной бумаги (купон) по РЕПО");
						
						// дебет
						Проводка.СчетДт = АналитикаУчетногоАктиваВРЕПО.СчетУчетаКупона;
						
						Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
						
						Если АналитикаУчетногоАктиваВРЕПО.СчетУчетаКупона = ПланыСчетов.Единый.ЦенныеБумагиПереданныеПоОперациямСовершаемымНаВозвратнойОснове
							Или АналитикаУчетногоАктиваВРЕПО.СчетУчетаКупона = ПланыСчетов.Единый.ЦенныеБумагиПоРЕПО Тогда
							
							Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
							
						КонецЕсли;	
						
						Проводка.ВалютаДт = ВалютаНоминала;
						Проводка.ВалютнаяСуммаДт = Выборка.ПереоценкаКупона;
						
						Проводка.ДополнительнаяАналитикаДт = АналитикаКупонНачисленный;
						
						// кредит
						Если Выборка.УчетныйАктив = Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО Тогда
							Проводка.СчетКт = ПланыСчетов.Единый.КорреспонденцияСАктивом9;
						Иначе	
							Проводка.СчетКт = Выборка.СчетУчетаКупона;
							
							Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
							
							Проводка.ВалютаКт = ВалютаНоминала;
							Проводка.ВалютнаяСуммаКт = Выборка.ПереоценкаКупона;
						КонецЕсли;
						
						Проводка.ДополнительнаяАналитикаКт = АналитикаКупонНачисленный;
						
					КонецЕсли;
				
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе // закрытие РЕПО
		
		Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
			
			// Обратное РЕПО
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.ЦеннаяБумага КАК ЦеннаяБумага,
				|	-СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.Количество) КАК Количество,
				|	-СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.Стоимость) КАК Стоимость,
				|	-СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
				|	-СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьКупона) КАК СтоимостьКупона,
				|	-СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
				|	-СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.Переоценка) КАК Переоценка,
				|	-СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
				|	-СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.ПереоценкаКупона) КАК ПереоценкаКупона,
				|	-СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.ПереоценкаКупонаВВалютеУчета) КАК ПереоценкаКупонаВВалютеУчета,
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.СтрокаКорзиныЦенныхБумаг КАК СтрокаКорзиныЦенныхБумаг,
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.Партия КАК Партия,
				|	ЛОЖЬ КАК ЭтоЗакрытие
				|ИЗ
				|	РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО КАК БухПартииЦенныхБумагКупленныеПоРЕПО
				|ГДЕ
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.ВидУчета = &ВидУчета
				|	И БухПартииЦенныхБумагКупленныеПоРЕПО.Организация = &Организация
				|	И БухПартииЦенныхБумагКупленныеПоРЕПО.СчетДоверительногоУправления = &СчетДоверительногоУправления
				|	И БухПартииЦенныхБумагКупленныеПоРЕПО.Партия = &Партия
				|	И БухПартииЦенныхБумагКупленныеПоРЕПО.Регистратор = &Регистратор
				|	И БухПартииЦенныхБумагКупленныеПоРЕПО.ВидДвижения = &ВидДвижения
				|
				|СГРУППИРОВАТЬ ПО
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.Регистратор,
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.ЦеннаяБумага,
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.Партия,
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.СтрокаКорзиныЦенныхБумаг
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.ЦеннаяБумага,
				|	СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.Количество),
				|	СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.Стоимость),
				|	СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьВВалютеУчета),
				|	СУММА(ВЫБОР
				|			КОГДА КупонныйДоходПоОблигациям.Период ЕСТЬ NULL
				|				ТОГДА БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьКупона
				|			ИНАЧЕ 0
				|		КОНЕЦ),
				|	СУММА(ВЫБОР
				|			КОГДА КупонныйДоходПоОблигациям.Период ЕСТЬ NULL
				|				ТОГДА БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьКупонаВВалютеУчета
				|			ИНАЧЕ 0
				|		КОНЕЦ),
				|	СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.Переоценка),
				|	СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.ПереоценкаВВалютеУчета),
				|	СУММА(ВЫБОР
				|			КОГДА КупонныйДоходПоОблигациям.Период ЕСТЬ NULL
				|					ИЛИ КОНЕЦПЕРИОДА(КупонныйДоходПоОблигациям.Период, ДЕНЬ) < БухПартииЦенныхБумагКупленныеПоРЕПО.Период
				|				ТОГДА БухПартииЦенныхБумагКупленныеПоРЕПО.ПереоценкаКупона
				|			ИНАЧЕ 0
				|		КОНЕЦ),
				|	СУММА(ВЫБОР
				|			КОГДА КупонныйДоходПоОблигациям.Период ЕСТЬ NULL
				|					ИЛИ КОНЕЦПЕРИОДА(КупонныйДоходПоОблигациям.Период, ДЕНЬ) < БухПартииЦенныхБумагКупленныеПоРЕПО.Период
				|				ТОГДА БухПартииЦенныхБумагКупленныеПоРЕПО.ПереоценкаКупонаВВалютеУчета
				|			ИНАЧЕ 0
				|		КОНЕЦ),
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.СтрокаКорзиныЦенныхБумаг,
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.Партия,
				|	ИСТИНА
				|ИЗ
				|	РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО КАК БухПартииЦенныхБумагКупленныеПоРЕПО
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
				|		ПО БухПартииЦенныхБумагКупленныеПоРЕПО.ЦеннаяБумага = КупонныйДоходПоОблигациям.Облигация
				|			И (КупонныйДоходПоОблигациям.Период МЕЖДУ &ДатаОткрытияРЕПО И &ДатаЗакрытияРЕПО)
				|			И (&УчитыватьПогашениеКупонаВнутриРЕПО)
				|ГДЕ
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.ВидУчета = &ВидУчета
				|	И БухПартииЦенныхБумагКупленныеПоРЕПО.Организация = &Организация
				|	И БухПартииЦенныхБумагКупленныеПоРЕПО.СчетДоверительногоУправления = &СчетДоверительногоУправления
				|	И БухПартииЦенныхБумагКупленныеПоРЕПО.ВидДвижения = &ВидДвижения
				|	И БухПартииЦенныхБумагКупленныеПоРЕПО.Партия = &Партия
				|	И БухПартииЦенныхБумагКупленныеПоРЕПО.Период <= &ДатаЗакрытияРЕПО
				|
				|СГРУППИРОВАТЬ ПО
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.Регистратор,
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.ЦеннаяБумага,
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.Партия,
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.СтрокаКорзиныЦенныхБумаг";
			
			Если НЕ НеВыделятьПереоценкуДляБумагПоРЕПОГлаваГ Тогда
				
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухПартииЦенныхБумагКупленныеПоРЕПО.СтрокаКорзиныЦенныхБумаг КАК СтрокаКорзиныЦенныхБумаг,", "");
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухПартииЦенныхБумагКупленныеПоРЕПО.СтрокаКорзиныЦенныхБумаг,", "");
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухПартииЦенныхБумагКупленныеПоРЕПО.Регистратор,", "");
				Запрос.Текст = СтрЗаменить(Запрос.Текст, ",
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.СтрокаКорзиныЦенныхБумаг", "");
			КонецЕсли;
			
			Запрос.УстановитьПараметр("Партия", ЭтотОбъект.ПерваяЧастьРЕПО);
			Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата));
			Запрос.УстановитьПараметр("ВидДвижения", ВидДвиженияНакопления.Приход);
			Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);
			Запрос.УстановитьПараметр("Регистратор",    ЭтотОбъект.Ссылка);
			
			Запрос.УстановитьПараметр("ДатаОткрытияРЕПО", КонецДня(ЭтотОбъект.ПерваяЧастьРЕПО.Дата));
			Запрос.УстановитьПараметр("ДатаЗакрытияРЕПО", КонецДня(ЭтотОбъект.Дата));
			
			Запрос.УстановитьПараметр("УчитыватьПогашениеКупонаВнутриРЕПО", НастройкиУчета.ДействияПриПогашенииКупонаНаСчетахГлавыГ <> "НеНачислять_И_НеСписывать");
			
			СуммаЗакрытияКупона = 0;
			СуммаЗакрытияКупонаВВалютеУчета = 0;
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				ВалютаНоминала = Выборка.ЦеннаяБумага.ВалютаНоминала;
				
				// ТЕЛО
				Если Выборка.СтоимостьВВалютеУчета > 0 Тогда
				
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СтоимостьВВалютеУчета, ?(Выборка.ЭтоЗакрытие,"Закрытие покупки РЕПО (тело)", "Переоценка по РЕПО"));
					
					// дебет
					Проводка.СчетДт = ПланыСчетов.Единый.ЦенныеБумагиПоРЕПО;
					
					Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
					Проводка.СубконтоДт.ОснованиеРасчетов = Выборка.Партия;
					
					Проводка.КоличествоДт = Выборка.Количество;
					Проводка.ВалютаДт = ВалютаНоминала;
					Проводка.ВалютнаяСуммаДт = Выборка.Стоимость;
					
					Проводка.ДополнительнаяАналитикаДт = АналитикаТела;
					
					// кредит
					Проводка.СчетКт = ПланыСчетов.Единый.КорреспонденцияСПассивом8;
					Проводка.ДополнительнаяАналитикаКт = АналитикаТела;
					
				ИначеЕсли Выборка.СтоимостьВВалютеУчета < 0 Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], -Выборка.СтоимостьВВалютеУчета, ?(Выборка.ЭтоЗакрытие,"Закрытие покупки РЕПО (тело)", "Переоценка по РЕПО"));
					
					// дебет
					Проводка.СчетДт = ПланыСчетов.Единый.КорреспонденцияСПассивом8;
					Проводка.ДополнительнаяАналитикаДт = АналитикаТела;
					
					// кредит
					Проводка.СчетКт = ПланыСчетов.Единый.ЦенныеБумагиПоРЕПО;
					
					Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
					Проводка.СубконтоКт.ОснованиеРасчетов = Выборка.Партия;
					
					Проводка.КоличествоКт = Выборка.Количество;
					Проводка.ВалютаКт = ВалютаНоминала;
					Проводка.ВалютнаяСуммаКт = -Выборка.Стоимость;
					
					Проводка.ДополнительнаяАналитикаКт = АналитикаТела;
					
				КонецЕсли;
				
				// ПЕРЕОЦЕНКА ТЕЛО
				Если Выборка.ПереоценкаВВалютеУчета > 0 Тогда
				
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.ПереоценкаВВалютеУчета, ?(Выборка.ЭтоЗакрытие,"Закрытие покупки РЕПО (тело)", "Переоценка по РЕПО"));
					
					// дебет
					Проводка.СчетДт = ПланыСчетов.Единый.ЦенныеБумагиПоРЕПО;
					
					Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
					Проводка.СубконтоДт.ОснованиеРасчетов = Выборка.Партия;
					
					Проводка.ВалютаДт = ВалютаНоминала;
					Проводка.ВалютнаяСуммаДт = Выборка.Переоценка;
					
					Проводка.ДополнительнаяАналитикаДт = АналитикаПереоценкиТела;
					
					// кредит
					Проводка.СчетКт = ПланыСчетов.Единый.КорреспонденцияСПассивом8;
					Проводка.ДополнительнаяАналитикаКт = АналитикаПереоценкиТела;
					
				ИначеЕсли Выборка.ПереоценкаВВалютеУчета < 0 Тогда
				
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], - Выборка.ПереоценкаВВалютеУчета, ?(Выборка.ЭтоЗакрытие,"Закрытие покупки РЕПО (тело)", "Переоценка по РЕПО"));
					
					// дебет
					Проводка.СчетДт = ПланыСчетов.Единый.КорреспонденцияСПассивом8;
					Проводка.ДополнительнаяАналитикаДт = АналитикаПереоценкиТела;
					
					// кредит
					Проводка.СчетКт = ПланыСчетов.Единый.ЦенныеБумагиПоРЕПО;
					
					Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
					Проводка.СубконтоКт.ОснованиеРасчетов = Выборка.Партия;
					
					Проводка.ВалютаКт = ВалютаНоминала;
					Проводка.ВалютнаяСуммаКт = - Выборка.Переоценка;
					
					Проводка.ДополнительнаяАналитикаКт = АналитикаПереоценкиТела;
					
				КонецЕсли;
						
				Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
					
					// КУПОН
					Если Выборка.СтоимостьКупонаВВалютеУчета > 0 Тогда
					
						Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, Выборка.СтоимостьКупонаВВалютеУчета, ?(Выборка.ЭтоЗакрытие,"Закрытие покупки РЕПО (купон)", "Переоценка/доначисление купона по РЕПО"));
						
						// дебет
						Проводка.СчетДт = ПланыСчетов.Единый.ЦенныеБумагиПоРЕПО;
						
						Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
