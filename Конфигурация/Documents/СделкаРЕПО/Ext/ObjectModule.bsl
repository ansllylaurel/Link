			КурсоваяРазницаЗайм = СуммаЗаймаПоТекущемуКурсу - ВыборкаДвиженияДокумента.СуммаОстатокРасчетыПоРЕПО;
			
			Если КурсоваяРазницаЗайм > 0 Тогда
			
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], КурсоваяРазницаЗайм, "Курсовая разница");
				
				Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаПерекурсовкиРасчетовПоРЕПО;
				
				Проводка.СчетКт = ПланыСчетов.Основной.КраткосрочныеКредиты;
				Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
				Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
				
				Проводка.ВалютаКт = ВыборкаДвиженияДокумента.ВалютаЧасть1;
				
			ИначеЕсли КурсоваяРазницаЗайм < 0 Тогда
			
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], -КурсоваяРазницаЗайм, "Курсовая разница");
				
				Проводка.СчетДт = ПланыСчетов.Основной.КраткосрочныеКредиты;
				Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
				Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
				
