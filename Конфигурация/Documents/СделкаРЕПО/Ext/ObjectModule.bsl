				ВалютаНоминала = Выборка.ЦеннаяБумагаВалютаНоминала;
				
				АналитикаУчетногоАктиваВРЕПО = Справочники.УчетныеАктивыЕПС.ПолучитьДанныеУчетногоАктиваЕПСДляБумагВРЕПО(Выборка.УчетныйАктив, Отказ);
				
