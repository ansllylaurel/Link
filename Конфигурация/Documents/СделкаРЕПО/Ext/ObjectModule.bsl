		Запрос.УстановитьПараметр("НачалоПериодаОстатокДня", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("ОкончаниеПериодаОстатокДня", Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		
