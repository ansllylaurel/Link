			|	СделкаРЕПОЦенныеБумаги.ЦенаПроцент КАК ЦенаПроцент,
			|	СделкаРЕПОЦенныеБумаги.ЦенаКупона КАК ЦенаКупона,
			|	СделкаРЕПОЦенныеБумаги.Сумма КАК Сумма,
			|	СделкаРЕПОЦенныеБумаги.СуммаКупона КАК СуммаКупона,
			|	СделкаРЕПО.Дата КАК ДатаОперации,
			|	ВЫБОР
			|		КОГДА СделкаРЕПО.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
			|			ТОГДА СделкаРЕПО.Дата
			|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
			|	КОНЕЦ КАК ДатаПокупки
			|ИЗ
			|	Документ.СделкаРЕПО.ЦенныеБумаги КАК СделкаРЕПОЦенныеБумаги
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК СделкаРЕПО
			|		ПО СделкаРЕПОЦенныеБумаги.Ссылка = СделкаРЕПО.Ссылка
			|ГДЕ
			|	СделкаРЕПО.Ссылка = &Ссылка
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	СделкаРЕПО.Ссылка,
			|	2,
			|	ВЫБОР
			|		КОГДА СделкаРЕПО.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
			|		КОГДА СделкаРЕПО.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
			|	КОНЕЦ,
			|	СделкаРЕПО.Ссылка,
			|	СделкаРЕПО.Организация,
