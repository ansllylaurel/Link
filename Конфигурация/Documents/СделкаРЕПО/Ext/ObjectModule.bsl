					|			ИЛИ УсловияСделокРЕПОСрезПоследних.ДатаОплаты <> ВЫБОР
					|				КОГДА &ОтложенноеИсполнение
					|					ТОГДА ВЫБОР
					|							КОГДА &РаздельноеИсполнение
					|								ТОГДА &ДатаОплаты
					|							ИНАЧЕ &ДатаИсполнения
					|						КОНЕЦ
					|				ИНАЧЕ &ДатаДокумента
					|			КОНЕЦ
					|			ИЛИ УсловияСделокРЕПОСрезПоследних.ДатаПоставки <> ВЫБОР
					|				КОГДА &ОтложенноеИсполнение
					|					ТОГДА ВЫБОР
					|							КОГДА &РаздельноеИсполнение
					|								ТОГДА &ДатаПоставки
					|							ИНАЧЕ &ДатаИсполнения
					|						КОНЕЦ
					|				ИНАЧЕ &ДатаДокумента
					|			КОНЕЦ
					|			ИЛИ УсловияСделокРЕПОСрезПоследних.ВалютаОплаты <> &ВалютаОплаты
					|			ИЛИ УсловияСделокРЕПОСрезПоследних.СобственныйКурсОплаты <> &СобКурсОплаты
					|			ИЛИ УсловияСделокРЕПОСрезПоследних.КурсОплаты <> &КурсОплаты
					|			ИЛИ УсловияСделокРЕПОСрезПоследних.ОтложенноеИсполнение <> &ОтложенноеИсполнение
					|			ИЛИ УсловияСделокРЕПОСрезПоследних.РаздельноеИсполнение <> &РаздельноеИсполнение
					|			ИЛИ УсловияСделокРЕПОСрезПоследних.СчетДоверительногоУправления <> &СчетДУ
					|			ИЛИ УсловияСделокРЕПОСрезПоследних.ДатаИсполнения <> ВЫБОР
					|				КОГДА &ОтложенноеИсполнение
					|					ТОГДА &ДатаИсполнения
					|				ИНАЧЕ &ДатаДокумента
					|			КОНЕЦ
					|			ИЛИ УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага ЕСТЬ NULL
					|			ИЛИ УсловияСделокРЕПОСрезПоследних.ДепозитарныйСчет <> _ТабличнаяЧасть.ДепозитарныйСчет
					|			ИЛИ УсловияСделокРЕПОСрезПоследних.Количество <> _ТабличнаяЧасть.Количество
					|			ИЛИ УсловияСделокРЕПОСрезПоследних.Цена <> _ТабличнаяЧасть.Цена
					|			ИЛИ УсловияСделокРЕПОСрезПоследних.ЦенаПроцент <> _ТабличнаяЧасть.ЦенаПроцент
					|			ИЛИ УсловияСделокРЕПОСрезПоследних.ЦенаКупона <> _ТабличнаяЧасть.ЦенаКупона
					|			ИЛИ УсловияСделокРЕПОСрезПоследних.Сумма <> _ТабличнаяЧасть.Сумма
					|			ИЛИ УсловияСделокРЕПОСрезПоследних.СуммаКупона <> _ТабличнаяЧасть.СуммаКупона)";
#КонецОбласти				
				Запрос.УстановитьПараметр("Дата"                , ЭтотОбъект.Дата);
				Запрос.УстановитьПараметр("ДатаДокумента"       , НачалоДня(ЭтотОбъект.Дата));
				Запрос.УстановитьПараметр("ДатаИсполнения"      , ЭтотОбъект.ДатаИсполнения);
				Запрос.УстановитьПараметр("СделкаРЕПО"          , ЭтотОбъект.ПерваяЧастьРЕПО);
				Запрос.УстановитьПараметр("Организация"         , ЭтотОбъект.Организация);
				Запрос.УстановитьПараметр("Рынок"               , ЭтотОбъект.Рынок);
				Запрос.УстановитьПараметр("ДатаОплаты"          , ЭтотОбъект.ДатаОплаты);
				Запрос.УстановитьПараметр("ДатаПоставки"        , ЭтотОбъект.ДатаПоставки);
				Запрос.УстановитьПараметр("ВалютаОплаты"        , ЭтотОбъект.ВалютаОплаты);
				Запрос.УстановитьПараметр("СобКурсОплаты"       , ЭтотОбъект.СобственныйКурсОплаты);
				Запрос.УстановитьПараметр("КурсОплаты"          , ЭтотОбъект.КурсОплаты);
