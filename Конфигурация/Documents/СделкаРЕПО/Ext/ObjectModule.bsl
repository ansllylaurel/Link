				Запрос.УстановитьПараметр("СчетДУ"              , ЭтотОбъект.СчетДоверительногоУправления);
				Запрос.УстановитьПараметр("ТабличнаяЧасть"      , ЭтотОбъект.ЦенныеБумаги.Выгрузить());
				
				РезультатСверки = Запрос.Выполнить().Выгрузить();
				
				Если РезультатСверки.Количество() > 0 Тогда
					
					Для Каждого Колонка Из РезультатСверки.Колонки Цикл
						
						Если Колонка.Имя = "НомерСтроки" Тогда
							Продолжить;	
						КонецЕсли;
						
						ИмяТабЧасти  = ?(СтрНайти(Колонка.Имя, "ЦенныеБумаги") = 0, "", "ЦенныеБумаги"); 
						ИмяРеквизита = СтрЗаменить(Колонка.Имя, "ЦенныеБумаги", "");
												
						Для Каждого СтрокаРезультатаСверки Из РезультатСверки Цикл
							
							Если СтрокаРезультатаСверки[ИмяТабЧасти + ИмяРеквизита] = Истина Тогда
								ЗначениеРеквизита = ?(ИмяТабЧасти = "", ЭтотОбъект[ИмяРеквизита], ЭтотОбъект[ИмяТабЧасти][СтрокаРезультатаСверки.НомерСтроки - 1][ИмяРеквизита]);
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В " + ?(ИмяТабЧасти = "", "документе", "табличной части документа (строка № " + СтрокаРезультатаСверки.НомерСтроки + ")") + " значение реквизита " + ИмяРеквизита + ?(ЗначениеЗаполнено(ЗначениеРеквизита)," [" + ЗначениеРеквизита + "]", "") + " не соответствует условиям сделки РЕПО.",,,, Отказ);
							КонецЕсли;
							
						КонецЦикла;
						
					КонецЦикла;
	
				КонецЕсли;
							
			КонецЕсли;
			
			// ценные бумаги должны быть заданы
			КолУсловийВторойЧасти = ЭтотОбъект.ЦенныеБумаги.Количество();
			Если КолУсловийВторойЧасти = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заданы условия 2-й части РЕПО.",,,, Отказ);
			КонецЕсли;
			
			// а вот ценные бумаги 2-й части должны быть пустыми
			ЭтотОбъект.ЦенныеБумагиВторойЧасти.Очистить();
			
			ПроверитьВариантИсполненияСделки(1, Отказ);
			
		Иначе // 1-я часть или одна сделка
			Если ЭтотОбъект.ЧастьСделкиРЕПО = 1 Тогда
				// дата 2-й части должна быть задана и быть не ранее даты 1-й части
				Если      Не ЗначениеЗаполнено(ЭтотОбъект.ДатаВторойЧастиРЕПО) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задана дата 2-й части сделки РЕПО.", ЭтотОбъект, "ДатаВторойЧастиРЕПО",, Отказ);
				ИначеЕсли КонецДня(ЭтотОбъект.ДатаВторойЧастиРЕПО) < ЭтотОбъект.Дата Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата 2-й части сделки РЕПО меньше даты 1-й части.", ЭтотОбъект, "ДатаВторойЧастиРЕПО",, Отказ);
				КонецЕсли;
			КонецЕсли;
			
			// условия 1-й и 2-й частей должны быть заданы; состав условий должен совпадать
			КолУсловийПервойЧасти = ЭтотОбъект.ЦенныеБумаги.Количество();
			КолУсловийВторойЧасти = ЭтотОбъект.ЦенныеБумагиВторойЧасти.Количество();
			
			Если      КолУсловийПервойЧасти = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заданы условия 1-й части РЕПО",,,, Отказ);
			ИначеЕсли КолУсловийПервойЧасти <> КолУсловийВторойЧасти Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не совпадает количество строк в условиях 1-й и 2-й частей РЕПО",,,, Отказ);
			Иначе
				// общие реквизиты условий должны совпадать
				ОбщиеРеквизиты = Документы.СделкаРЕПО.ПолучитьОбщиеРеквизитыКорзиныЦенныхБумаг();
				
				// дополнительно проверим, что рынок соответствует типу ценной бумаги
				ТипЦеннойБумаги = РаботаСЦеннымиБумагамиКлиентСервер.ТипЦеннойБумагиВЗависимостиОтРынка(ЭтотОбъект.Рынок);
				
				Для НомСтр = 0 По Мин(КолУсловийПервойЧасти, КолУсловийПервойЧасти) - 1 Цикл
					СтрокаЦенныеБумаги = ЭтотОбъект.ЦенныеБумаги[НомСтр];
					
					Если Не ТипЦеннойБумаги.СодержитТип(ТипЗнч(СтрокаЦенныеБумаги.ЦеннаяБумага)) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Тип ценной бумаги в строке № " + (НомСтр + 1) + " не соответствует рынку " + ЭтотОбъект.Рынок + ".",,,, Отказ);
					КонецЕсли;
					
					Для каждого ИмяРеквизита Из ОбщиеРеквизиты Цикл
						Если СтрокаЦенныеБумаги[ИмяРеквизита] <> ЭтотОбъект.ЦенныеБумагиВторойЧасти[НомСтр][ИмяРеквизита] Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не совпадают значения полей " + ИмяРеквизита + " в строке условий РЕПО № " + (НомСтр + 1),,,, Отказ);
						КонецЕсли;
					КонецЦикла;
					
				КонецЦикла;
			КонецЕсли;
			
			// проверка вариантов исполнения
			ПроверитьВариантИсполненияСделки(1, Отказ);
			ПроверитьВариантИсполненияСделки(2, Отказ);
			
		КонецЕсли;
		
		// т.к. соответствие строк 1-й и 2-й частей уже проверили, то соответствие
		// реквизитов шапки и табличной части проверим только для ценных бумаг, которые есть всегда
		Для НомСтр = 0 По ЭтотОбъект.ЦенныеБумаги.Количество() - 1 Цикл
			СтрокаЦенныеБумаги = ЭтотОбъект.ЦенныеБумаги[НомСтр];
			
			// рынок должен соответствовать типу ценной бумаги
			Если ТипЗнч(СтрокаЦенныеБумаги.ЦеннаяБумага) <> Тип("СправочникСсылка." + РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.Рынок)) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке № " + (НомСтр + 1) + " рынок " + Строка(ЭтотОбъект.Рынок) + " не совпадает с типом ценной бумаги",,,, Отказ);
			КонецЕсли;
			
		КонецЦикла;
		
		// дубли ценных бумаг запрещены
		Если ЭтотОбъект.ЦенныеБумаги.Количество() > 1 Тогда
			НаборЦенныхБумаг = ЭтотОбъект.ЦенныеБумаги.Выгрузить(, "ЦеннаяБумага");
			НаборЦенныхБумаг.Колонки.Добавить("КоличествоЗаписей");
			НаборЦенныхБумаг.ЗаполнитьЗначения(1, "КоличествоЗаписей");
			НаборЦенныхБумаг.Свернуть("ЦеннаяБумага", "КоличествоЗаписей");
			НаборЦенныхБумаг.Сортировать("КоличествоЗаписей УБЫВ");
			
			Для каждого СтрокаНаборЦенныхБумаг Из НаборЦенныхБумаг Цикл
				Если СтрокаНаборЦенныхБумаг.КоличествоЗаписей = 1 Тогда
					Прервать;
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ценная бумага " + СтрокаНаборЦенныхБумаг.ЦеннаяБумага + " встречается более одного раза.", ЭтотОбъект,,, Отказ);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	// пост. обработка документа
	Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
		// очистим реквизиты, связанные с облигацией, для прочих рынков
		Если ЭтотОбъект.Рынок <> Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаЦенныеБумаги.ЦенаПроцент = 0;
			СтрокаЦенныеБумаги.ЦенаКупона  = 0;
			СтрокаЦенныеБумаги.СуммаКупона = 0;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого СтрокаЦенныеБумагиВторойЧасти Из ЭтотОбъект.ЦенныеБумагиВторойЧасти Цикл
		// очистим реквизиты, связанные с облигацией, для прочих рынков
		Если ЭтотОбъект.Рынок <> Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			СтрокаЦенныеБумаги.ЦенаПроцент = 0;
			СтрокаЦенныеБумаги.ЦенаКупона  = 0;
			СтрокаЦенныеБумаги.СуммаКупона = 0;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // ПередЗаписью

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры // ОбработкаПроведения

#КонецОбласти
