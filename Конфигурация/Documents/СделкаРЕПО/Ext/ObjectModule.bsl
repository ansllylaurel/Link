				"КорректировкаЭСП", Выборка.КорректировкаЭСП, Выборка.КорректировкаЭСПВВалютеУчета, Выборка.ВалютаУчета,  Выборка.УчетныйАктив, Выборка.ЦеннаяБумага, ВалютаНоминала);
				ДвижениеЗакрытияПродажиКорректировки(ПараметрыСписания, Отказ);
				
				ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала",
				"РазницаПервоначальногоПризнания", Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные, Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета, Выборка.ВалютаУчета,  Выборка.УчетныйАктив, Выборка.ЦеннаяБумага, ВалютаНоминала);
				ДвижениеЗакрытияПродажиКорректировки(ПараметрыСписания, Отказ);
				
				Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
					
					Если ЗначениеЗаполнено(Выборка.СтоимостьКупонаВВалютеУчета) Или ЗначениеЗаполнено(Выборка.СтоимостьКупона) Тогда
						Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, Выборка.СтоимостьКупонаВВалютеУчета, "Закрытие продажи РЕПО (купон)");
						
						// дебет
						Если Выборка.УчетныйАктив = Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО Тогда
							Проводка.СчетДт = ПланыСчетов.Единый.КорреспонденцияСАктивом9;
						Иначе							
							Проводка.СчетДт = Выборка.СчетУчетаКупона;
						
							Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
						
							Проводка.ВалютаДт = ВалютаНоминала;
							Проводка.ВалютнаяСуммаДт = Выборка.СтоимостьКупона;
						КонецЕсли;	
						
						Проводка.ДополнительнаяАналитикаДт = АналитикаКупонПриобретенный;
							
						// кредит
						Проводка.СчетКт = АналитикаУчетногоАктиваВРЕПО.СчетУчетаКупона;
						
						Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
						
						Если АналитикаУчетногоАктиваВРЕПО.СчетУчетаКупона = ПланыСчетов.Единый.ЦенныеБумагиПереданныеПоОперациямСовершаемымНаВозвратнойОснове
							Или АналитикаУчетногоАктиваВРЕПО.СчетУчетаКупона = ПланыСчетов.Единый.ЦенныеБумагиПоРЕПО Тогда
							
							Проводка.СубконтоКт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
							
						КонецЕсли;	
						
						Проводка.ВалютаКт = ВалютаНоминала;
						Проводка.ВалютнаяСуммаКт = Выборка.СтоимостьКупона;
						
						Проводка.ДополнительнаяАналитикаКт = АналитикаКупонПриобретенный;
						
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Выборка.ПереоценкаКупонаВВалютеУчета) Или ЗначениеЗаполнено(Выборка.ПереоценкаКупона) Тогда
						Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, Выборка.ПереоценкаКупонаВВалютеУчета, "Закрытие продажи РЕПО (купон)");
						
						// дебет
						Если Выборка.УчетныйАктив = Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО Тогда
							Проводка.СчетДт = ПланыСчетов.Единый.КорреспонденцияСАктивом9;
						Иначе							
							Проводка.СчетДт = Выборка.СчетУчетаКупона;
						
							Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
						
							Проводка.ВалютаДт = ВалютаНоминала;
							Проводка.ВалютнаяСуммаДт = Выборка.ПереоценкаКупона;
						КонецЕсли;	
						
						Проводка.ДополнительнаяАналитикаДт = АналитикаКупонНачисленный;
						
						// кредит
						Проводка.СчетКт = АналитикаУчетногоАктиваВРЕПО.СчетУчетаКупона;
						
						Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
						
						Если АналитикаУчетногоАктиваВРЕПО.СчетУчетаКупона = ПланыСчетов.Единый.ЦенныеБумагиПереданныеПоОперациямСовершаемымНаВозвратнойОснове
							Или АналитикаУчетногоАктиваВРЕПО.СчетУчетаКупона = ПланыСчетов.Единый.ЦенныеБумагиПоРЕПО Тогда
							
							Проводка.СубконтоКт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
							
						КонецЕсли;	
						
						Проводка.ВалютаКт = ВалютаНоминала;
						Проводка.ВалютнаяСуммаКт = Выборка.ПереоценкаКупона;
						
						Проводка.ДополнительнаяАналитикаКт = АналитикаКупонНачисленный;
						
					КонецЕсли;
				
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;	
		
	КонецЕсли;
	
	
	// ДЕНЬГИ
	
	// С 1го сентября решено использовать "реального" контрагента по дс в репо и процентам по репо
	// на 1ое сентября будет(возможно) сторно старых проводок
	// контрагентом по комиссиям остается брокер
	
	СделкаРЕПО = ?(ЭтотОбъект.ЧастьСделкиРЕПО = 2, ЭтотОбъект.ПерваяЧастьРЕПО, ЭтотОбъект.Ссылка);
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СделкаРЕПО, "Ссылка, СчетДоверительногоУправления, Дата, Брокер, Контрагент, РежимБиржевыхТоргов");
	КонтрагентДляОтраженияВУчете = БухгалтерскийУчет.ОпределитьКонтрагентаПоСделкеРЕПО(Реквизиты, НастройкиУчета);
	
	Если ЭтотОбъект.Брокер <> Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
		КонтрагентПоКомиссии	= ЭтотОбъект.Брокер.ЮрФизЛицо;
		СчетДС 					= ПланыСчетов.Единый.РасчетыСБрокерами02;
		
		ВидСубконтоДС	= ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания;
		СубконтоДС 		= БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
	Иначе
		КонтрагентПоКомиссии 	= ЭтотОбъект.Контрагент;
		Если Справочники.Банки.ЯвляетсяРезидентом(ЭтотОбъект.РасчетныйСчет.Банк,Дата) Тогда
			СчетДС = ПланыСчетов.Единый.РасчетныеСчета01;
		Иначе
			СчетДС = ПланыСчетов.Единый.РасчетныеСчета02;
		КонецЕсли;
		
		ВидСубконтоДС 	= ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета;
		СубконтоДС		= ЭтотОбъект.РасчетныйСчет;
	КонецЕсли;
		
	СуммаОплаты = ЭтотОбъект.ЦенныеБумаги.Итог("Сумма") + ЭтотОбъект.ЦенныеБумаги.Итог("СуммаКупона");
	СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаОплаты, ЭтотОбъект.ВалютаСделки, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
	СуммаОплатыВВалютеУчета = СуммаОперации;
	
	Если ЭтотОбъект.ЧастьСделкиРЕПО = 1 Тогда // открытие РЕПО
		
		Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Оплата покупки");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.ПрочиеСредства10;
			
			Проводка.СубконтоДт.Контрагенты = КонтрагентДляОтраженияВУчете;
			Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
			
			Проводка.ВалютаДт  = ЭтотОбъект.ВалютаСделки;
			Проводка.ВалютнаяСуммаДт = СуммаОплаты;
			
			// кредит
			Проводка.СчетКт = СчетДС;
			
			Проводка.СубконтоКт[ВидСубконтоДС] = СубконтоДС;
			Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ОткрытиеРЕПО;
			
			Проводка.ВалютаКт  = ЭтотОбъект.ВалютаСделки;
			Проводка.ВалютнаяСуммаКт = СуммаОплаты;
		
		ИначеЕсли ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Оплата по первой части РЕПО");
			
			// дебет
			Проводка.СчетДт = СчетДС;
			
			Проводка.СубконтоДт[ВидСубконтоДС] = СубконтоДС;
			Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ОткрытиеРЕПО;
			
			Проводка.ВалютаДт  = ЭтотОбъект.ВалютаСделки;
			Проводка.ВалютнаяСуммаДт = СуммаОплаты;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг08;
			
			Проводка.СубконтоКт.Контрагенты = КонтрагентДляОтраженияВУчете;
			Проводка.СубконтоКт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
			
			Проводка.ВалютаКт  = ЭтотОбъект.ВалютаСделки;
			Проводка.ВалютнаяСуммаКт = СуммаОплаты;
			
			
		КонецЕсли;
		
	Иначе // закрытие РЕПО
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток КАК ДолгПоРЕПО,
			|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток КАК ДолгПоРЕПОВВалютеУчета,
			|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки1.ВалютнаяСуммаОстаток, 0) КАК ПроцентыПоРЕПОДоход,
			|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки2.ВалютнаяСуммаОстаток, 0) КАК ПроцентыПоРЕПОРасход,
			|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОбороты1.ВалютнаяСуммаОборотДт, 0) КАК ПроцентыПоРЕПОДоход1,
			|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОбороты2.ВалютнаяСуммаОборотДт, 0) КАК ПроцентыПоРЕПОРасход1,
			|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки1.СуммаОстаток, 0) КАК ПроцентыПоРЕПОДоходВВалютеУчета,
			|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки2.СуммаОстаток, 0) КАК ПроцентыПоРЕПОРасходВВалютеУчета,
			|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОбороты1.СуммаОборотДт, 0) КАК ПроцентыПоРЕПОДоход1ВВалютеУчета,
			|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОбороты2.СуммаОборотДт, 0) КАК ПроцентыПоРЕПОРасход1ВВалютеУчета
			|ИЗ
			|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
			|			&Период,
			|			Счет = &Счет,
			|			&ВидыСубконто,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
			|				И Субконто1 = &Субконто1
			|				И Валюта = &Валюта) КАК ЕдиныйБухгалтерскийУчетОстатки,
			|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
			|			&Период,
			|			Счет = &СчетПроцентовДоход,
			|			&ВидыСубконто,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
			|				И Субконто1 = &Субконто1
			|				И Валюта = &Валюта) КАК ЕдиныйБухгалтерскийУчетОстатки1,
			|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
			|			&Период,
			|			Счет = &СчетПроцентовРасход,
			|			&ВидыСубконто,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
			|				И Субконто1 = &Субконто1
			|				И Валюта = &Валюта) КАК ЕдиныйБухгалтерскийУчетОстатки2,
			|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(
			|			&НачалоГода,
			|			&Период,
			|			Период,
			|			Счет = &СчетПроцентовДоход,
			|			&ВидыСубконто,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
			|				И Субконто1 = &Субконто1
			|				И Валюта = &Валюта,
			|			КорСчет = &СчетДоходов,
			|			) КАК ЕдиныйБухгалтерскийУчетОбороты1,
			|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(
			|			&НачалоГода,
			|			&Период,
			|			Период,
			|			Счет = &СчетПроцентовРасход,
			|			&ВидыСубконто,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
			|				И Субконто1 = &Субконто1
			|				И Валюта = &Валюта,
			|			КорСчет = &СчетРасходов,
			|			) КАК ЕдиныйБухгалтерскийУчетОбороты2";
		
		Запрос.УстановитьПараметр("НачалоГода", Новый Граница(НачалоГода(ЭтотОбъект.Дата), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("Счет", ?(ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа, ПланыСчетов.Единый.ПрочиеСредства10, ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг08));
		Запрос.УстановитьПараметр("СчетПроцентовДоход", ?(ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа, ПланыСчетов.Единый.ПрочиеСредства11, ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг22));
		Запрос.УстановитьПараметр("СчетПроцентовРасход", ?(ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа, ПланыСчетов.Единый.ПрочиеСредства22, ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг09));
		Запрос.УстановитьПараметр("Валюта", ЭтотОбъект.ВалютаСделки);
		Запрос.УстановитьПараметр("СчетДоходов", ПланыСчетов.Единый.ПроцентныеДоходы01);
		Запрос.УстановитьПараметр("СчетРасходов", ПланыСчетов.Единый.ПроцентныеРасходы01);
		
		ВидыСубконто = Новый Массив;
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов);
		
		Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Субконто1", ЭтотОбъект.ПерваяЧастьРЕПО);
		Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
		
		ЗнакРЕПО = ?(ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа, 1, -1);
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			
			ДолгПоРЕПО = ЗнакРЕПО * ВыборкаДетальныеЗаписи.ДолгПоРЕПО;
			ДолгПоРЕПОВВалютеУчета = ЗнакРЕПО * ВыборкаДетальныеЗаписи.ДолгПоРЕПОВВалютеУчета;
			ДолгПоРЕПОПоТекущемуКурсу = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ДолгПоРЕПО, ЭтотОбъект.ВалютаСделки, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			
			ПроцентыПоРЕПОДоход = ВыборкаДетальныеЗаписи.ПроцентыПоРЕПОДоход;
			ПроцентыПоРЕПОДоходВВалютеУчета = ВыборкаДетальныеЗаписи.ПроцентыПоРЕПОДоходВВалютеУчета;
