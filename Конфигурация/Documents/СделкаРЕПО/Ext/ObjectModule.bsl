			Запрос.УстановитьПараметр("СписокСтратегий", Справочники.СчетаДоверительногоУправления.ПолучитьМассивСчетовПоДоговоруДУ(ЭтотОбъект.СчетДоверительногоУправления));
			Запрос.УстановитьПараметр("СделкаРЕПО", СделкаРЕПО);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
			
			Запрос.УстановитьПараметр("НачалоПериодаОстатокДня", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
			Запрос.УстановитьПараметр("ОкончаниеПериодаОстатокДня", Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", УчетныйРегистр);
			
			ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				СуммаКомиссии = ВыборкаДетальныеЗаписи.НачисленоКомиссии;
				СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКомиссии, СделкаРЕПО.ВалютаТорговойКомиссии, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
				ЦеннаяБумага = СделкаРЕПО.ЦенныеБумаги[0].ЦеннаяБумага;
				БУНУ_ПризнатьКомиссиюПоРЕПО(
					ЭтотОбъект.Движения[УчетныйРегистр],
					СуммаОперации,
					СделкаРЕПО,
					ЦеннаяБумага,
					СведенияОбОбращенииЦенныхБумагНаОРЦБ,
					Брокер_ЮрФизЛицо,
					Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии,
					НастройкиКомиссии,
					МетодПризнанияРасходовПоСделкамРЕПО);
			КонецЦикла;
				
		КонецЕсли;
		
	КонецЕсли;
	
	//отложенная курсовая разница 
	Если ЭтотОбъект.ЧастьСделкиРЕПО = 2 И ЭтотОбъект.ВалютаОплаты <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль")
		И УчетныйРегистр = "НалоговыйУчет" Тогда 
		СписатьОтложеннуюКурсовуюРазницу(УчетныйРегистр);
	КонецЕсли;		
	
КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерииОбычнаяСделка(УчетныйРегистр, Отказ)
	
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);

	ВидСубконтоУчетаЦеннойБумаги = БухгалтерскийУчет.ОпределитьВидСубконтоУчетаЦеннойБумаги(ЭтотОбъект.Рынок);	
		
	СчетДоходов = ПланыСчетов.Основной.ПрочиеДоходы;	
	СчетРасходов = ПланыСчетов.Основной.ПрочиеРасходы;
		
	ИспользоватьСчетПродаж = БухгалтерскийУчет.ОпределитьНастройкуУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		"ИспользоватьСчетПродаж");
		
	Если ИспользоватьСчетПродаж Тогда
		СчетДоходов = ПланыСчетов.Основной.Выручка;
		СчетРасходов = ПланыСчетов.Основной.СебестоимостьПродажи;
	КонецЕсли;	
	
	СчетУчетаДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВалютаСделки,
		ЭтотОбъект.Брокер);	
		
	СчетУчетаКомиссии = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
		УчетныйРегистр,
		"СчетУчета");
		
	Если ЭтотОбъект.Брокер <> Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
		КонтрагентПоСделке = ЭтотОбъект.Брокер.ЮрФизЛицо;
	Иначе
		КонтрагентПоСделке = ЭтотОбъект.Контрагент;
	КонецЕсли;
	
	ПараметрыКомиссии = Новый Структура;
	ПараметрыКомиссии.Вставить("СчетУчетаКомиссии", СчетУчетаКомиссии);
	ПараметрыКомиссии.Вставить("СчетУчетаДС", СчетУчетаДС);
	
	Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
		СубконтоДоговорыБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
		ПараметрыКомиссии.Вставить("СубконтоДоговорыБрокерскогоОбслуживания", СубконтоДоговорыБрокерскогоОбслуживания);
	КонецЕсли;
		
	ЕстьСубконтоКонтрагентыПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);						
	ПараметрыКомиссии.Вставить("ЕстьСубконтоКонтрагентыПоКомиссии", ЕстьСубконтоКонтрагентыПоКомиссии);
	Если ЕстьСубконтоКонтрагентыПоКомиссии Тогда
		КонтрагентПоКомиссии = КонтрагентПоСделке;
		ПараметрыКомиссии.Вставить("КонтрагентПоКомиссии", КонтрагентПоКомиссии);
	КонецЕсли;
	
	ЕстьСубконтоСделкиПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Сделка) <> Неопределено);
	ПараметрыКомиссии.Вставить("ЕстьСубконтоСделкиПоКомиссии", ЕстьСубконтоСделкиПоКомиссии);
	
	АналитикаУслуг = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
	ЭтотОбъект.Дата, 
	ЭтотОбъект.Организация, 
	ЭтотОбъект.СчетДоверительногоУправления,
	Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
	УчетныйРегистр,
	"Аналитика");	
	
	ПараметрыКомиссии.Вставить("АналитикаУслуг", АналитикаУслуг);
	ПараметрыКомиссии.Вставить("ВидСубконтоУчетаЦеннойБумаги", ВидСубконтоУчетаЦеннойБумаги);
	
	// ЦЕННЫЕ БУМАГИ
	СведенияОбОбращенииЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(ЭтотОбъект.Дата, ЭтотОбъект.Ссылка, УчетныйРегистр);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.СтрокаКорзиныЦенныхБумаг,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.ВидДвижения,
		|	СУММА(БухПартииЦенныхБумаг.Количество) КАК Количество,
		|	СУММА(БухПартииЦенныхБумаг.Стоимость) КАК Стоимость,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупона) КАК СтоимостьКупона,
		|	СУММА(БухПартииЦенныхБумаг.Переоценка) КАК Переоценка,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупона) КАК ПереоценкаКупона,
		|	СУММА(БухПартииЦенныхБумаг.СуммаЧастичногоПогашения) КАК СуммаЧастичногоПогашения
		|ПОМЕСТИТЬ _ДвиженияПартий
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.СтрокаКорзиныЦенныхБумаг,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.ВидДвижения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДвиженияПартий.ЦеннаяБумага,
		|	_ДвиженияПартий.Количество,
		|	_ДвиженияПартий.ВидДвижения,
		|	_ДвиженияПартий.Стоимость,
		|	_ДвиженияПартий.СтоимостьКупона,
		|	_ДвиженияПартий.Переоценка,
		|	_ДвиженияПартий.ПереоценкаКупона,
		|	_ДвиженияПартий.СуммаЧастичногоПогашения,
		|	СделкаЦенныеБумаги.ТорговаяКомиссия,
		|	СделкаЦенныеБумаги.Сумма,
		|	СделкаЦенныеБумаги.СуммаКупона
		|ИЗ
		|	Документ.СделкаРЕПО.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДвиженияПартий КАК _ДвиженияПартий
		|		ПО СделкаЦенныеБумаги.НомерСтроки = _ДвиженияПартий.СтрокаКорзиныЦенныхБумаг
		|ГДЕ
		|	СделкаЦенныеБумаги.Ссылка = &Регистратор";

	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		
		ОбращаетсяНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(Выборка.ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
		
		УчетныйАктив       = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, ЭтотОбъект.Рынок, Выборка.ЦеннаяБумага);
		УчетныйАктивКупона = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, ЭтотОбъект.Рынок, Выборка.ЦеннаяБумага, Истина);
		
		НастройкиУчетаАктива = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктив,
			УчетныйРегистр);		
			
		НастройкиУчетаКупона = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктивКупона,
			УчетныйРегистр);		
			
		ВключатьРасходыПоПокупкеВСтоимость = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
			ЭтотОбъект.Дата, 
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйРегистр,
			"ВключатьРасходыПоПокупкеВСтоимость");
			
		ВыделятьРасходыПриПродаже = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
			ЭтотОбъект.Дата, 
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйРегистр,
			"ВыделятьРасходыПриПродаже");
			
		ПараметрыКомиссии.Вставить("ВключатьРасходыПоПокупкеВСтоимость", ВключатьРасходыПоПокупкеВСтоимость И (Выборка.ВидДвижения = ВидДвиженияНакопления.Приход));
		ПараметрыКомиссии.Вставить("ЦеннаяБумага", Выборка.ЦеннаяБумага);
		ПараметрыКомиссии.Вставить("ОбращаетсяНаОРЦБ", ОбращаетсяНаОРЦБ);
		ПараметрыКомиссии.Вставить("СчетУчета", НастройкиУчетаАктива.СчетУчета);
		
		
		ОплатитьТорговуюКомиссию(Движения[УчетныйРегистр], Выборка.ТорговаяКомиссия, ПараметрыКомиссии);
		НачислитьТорговуюКомиссию(Движения[УчетныйРегистр], Выборка.ТорговаяКомиссия, ПараметрыКомиссии, УчетныйРегистр);
			
		Если Выборка.ВидДвижения = ВидДвиженияНакопления.Приход Тогда // ПОКУПКА
				
		    // ПРИХОДУЕМ СТОИМОСТЬ ТЕЛА
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.Сумма, "Покупка ценной бумаги");
			
			// дебет
			Проводка.СчетДт = НастройкиУчетаАктива.СчетУчета;
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = Выборка.ЦеннаяБумага;
			
			Проводка.КоличествоДт = Выборка.Количество;
			
			// кредит
			Проводка.СчетКт = СчетУчетаДС;
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
				Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
			КонецЕсли;	
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
				Проводка.СубконтоКт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
				Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
				Проводка.СубконтоКт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.Покупка;
			КонецЕсли;			
			
			Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				// ПРИХОДУЕМ СТОИМОСТЬ КУПОНА
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СтоимостьКупона, "Покупка ценной бумаги (купон)");
				
				// дебет
				Проводка.СчетДт = НастройкиУчетаКупона.СчетУчета;
				Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = Выборка.ЦеннаяБумага;
				
				// кредит
				Проводка.СчетКт = СчетУчетаДС;
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
					Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
				КонецЕсли;	
				
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
					Проводка.СубконтоКт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
				КонецЕсли;
				
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
					Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
				КонецЕсли;
				
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
					Проводка.СубконтоКт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.Покупка;
				КонецЕсли;	
			
			КонецЕсли;
			
		ИначеЕсли Выборка.ВидДвижения = ВидДвиженияНакопления.Расход Тогда // ПРОДАЖА	
			// СПИСЫВАЕМ СЕБЕСТОИМОСТЬ В РАСХОДЫ
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.Стоимость, "Продажа ценной бумаги");
			
			Проводка.СчетДт = СчетРасходов;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходовОтРеализации;
			Проводка.СубконтоДт.ЦенныеБумаги         = Выборка.ЦеннаяБумага;
			Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
			
			Проводка.СчетКт = НастройкиУчетаАктива.СчетУчета;
			Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = Выборка.ЦеннаяБумага;
			
			Проводка.КоличествоКт = Выборка.Количество;
			
			Если Выборка.Переоценка <> 0 Тогда
				// СПИСЫВАЕМ СЕБЕСТОИМОСТЬ ПЕРЕОЦЕНКИ ПРОДАННОЙ БУМАГИ В РАСХОДЫ
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.Переоценка, "Продажа ценной бумаги");
				
				Проводка.СчетДт = СчетРасходов;
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходовОтРеализации;
				Проводка.СубконтоДт.ЦенныеБумаги         = Выборка.ЦеннаяБумага;
				Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
				
				Проводка.СчетКт = НастройкиУчетаАктива.СчетУчетаПереоценки;
				Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = Выборка.ЦеннаяБумага;
				
			КонецЕсли;
			
			// ПРИХОДУЕМ ДОХОД ОТ ПРОДАЖИ
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.Сумма, "Продажа ценной бумаги");
			
			Проводка.СчетДт = СчетУчетаДС;
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
				Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
			КонецЕсли;	
			
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
				Проводка.СубконтоДт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
			КонецЕсли;
			
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
				Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
			КонецЕсли;
			
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
				Проводка.СубконтоДт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.Продажа;
			КонецЕсли;						
			
			Проводка.СчетКт = СчетДоходов;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходовОтРеализации;
			Проводка.СубконтоКт.ЦенныеБумаги         = Выборка.ЦеннаяБумага;
			Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
			
			
			Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			    // СПИСЫВАЕМ СЕБЕСТОИМОСТЬ ПРОДАННОГО КУПОНА В РАСХОДЫ
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СтоимостьКупона, "Продажа ценной бумаги (купон)");
				
				Проводка.СчетДт = СчетРасходов;
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаКупона.АналитикаДоходовОтРеализации;
				Проводка.СубконтоДт.ЦенныеБумаги         = Выборка.ЦеннаяБумага;
				Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
				
				Проводка.СчетКт = НастройкиУчетаКупона.СчетУчета;
				Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = Выборка.ЦеннаяБумага;
				
				Если Выборка.ПереоценкаКупона <> 0 Тогда
					
				    // СПИСЫВАЕМ СЕБЕСТОИМОСТЬ ПЕРОЦЕНКИ ПРОДАННОГО КУПОНА В РАСХОДЫ
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.ПереоценкаКупона, "Продажа ценной бумаги (купон)");
					
					Проводка.СчетДт = СчетРасходов;
					
					Если УчетныйРегистр = "НалоговыйУчет" Тогда
						Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаКупона.АналитикаДоходовОтПереоценки;
					Иначе
						Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаКупона.АналитикаДоходовОтРеализации;
					КонецЕсли;
					
					Проводка.СубконтоДт.ЦенныеБумаги     = Выборка.ЦеннаяБумага;
					Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
					
					Проводка.СчетКт = НастройкиУчетаКупона.СчетУчетаПереоценки;
					Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = Выборка.ЦеннаяБумага;
						
				КонецЕсли;
				
				// ПРИХОДУЕМ ДОХОД ОТ ПРОДАЖИ КУПОНА
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СуммаКупона, "Продажа ценной бумаги (купон)");
				
				Проводка.СчетДт = СчетУчетаДС;
				Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
					Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
				КонецЕсли;	
				
				Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
					Проводка.СубконтоДт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
				КонецЕсли;
				
				Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
					Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
				КонецЕсли;
				
				Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
					Проводка.СубконтоДт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.Продажа;
				КонецЕсли;
								
				Проводка.СчетКт = СчетДоходов;
				Проводка.СубконтоКт.ПрочиеДоходыИРасходы = НастройкиУчетаКупона.АналитикаДоходовОтРеализации;
				Проводка.СубконтоКт.ЦенныеБумаги         = Выборка.ЦеннаяБумага;
				Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
				
				Если Выборка.СуммаЧастичногоПогашения <> 0 Тогда
					// СПИСАНИЕ ЗАДОЛЖЕННОСТИ ПО ЧАСТИЧНОМУ ПОГАШЕНИЮ
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СуммаЧастичногоПогашения, "Списание ранее начисленного аванса");
					
					Проводка.СчетДт = ПланыСчетов.Основной.АвансыПоЧастичномуПогашениюОблигаций;
					Проводка.СубконтоДт.Облигации = Выборка.ЦеннаяБумага;
					
					Проводка.СчетКт = СчетДоходов;
					Проводка.СубконтоКт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходов;
					Проводка.СубконтоКт.ЦенныеБумаги         = Выборка.ЦеннаяБумага;
					Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
				
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;	
		
	КонецЦикла;
	

КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт

	Движения[УчетныйРегистр].Записывать = Истина;
	
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);
		
	МетодПризнанияРасходовПоСделкамРЕПО = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		УчетныйРегистр,
		"МетодПризнанияРасходовПоСделкамРЕПО");
		
		
	// если исполнение отложенное - только КОМИССИЯ
	Если ЭтотОбъект.ОтложенноеИсполнение Тогда
		
		Если Не ЭтотОбъект.ОтложеннаяОплатаТорговойКомиссии Тогда // точно сделать проводки по биржевой комиссии
			
			СчетУчетаДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
				ЭтотОбъект.Дата,
				ЭтотОбъект.Организация,
				ЭтотОбъект.СчетДоверительногоУправления,
				ЭтотОбъект.ВалютаСделки,
				ЭтотОбъект.Брокер);	
			
			СчетУчетаКомиссии = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
				ЭтотОбъект.Дата, 
				ЭтотОбъект.Организация, 
				ЭтотОбъект.СчетДоверительногоУправления,
				Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
				УчетныйРегистр,
				"СчетУчета");
				
			Если ЭтотОбъект.Брокер <> Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
				КонтрагентПоСделке = ЭтотОбъект.Брокер.ЮрФизЛицо;
			Иначе
				КонтрагентПоСделке = ЭтотОбъект.Контрагент;
			КонецЕсли;
			
			Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
				СубконтоДоговорыБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
			КонецЕсли;
				
			ЕстьСубконтоКонтрагентыПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);						
			Если ЕстьСубконтоКонтрагентыПоКомиссии Тогда
				КонтрагентПоКомиссии = КонтрагентПоСделке;
			КонецЕсли;
			
			ЕстьСубконтоСделкиПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Сделка) <> Неопределено);
			
			СведенияОбОбращенииЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(ЭтотОбъект.Дата, ЭтотОбъект.Ссылка, УчетныйРегистр);
			
			// торговую комиссию Деньги -> Комиссия 
			Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
				
				Если СтрокаЦенныеБумаги.ТорговаяКомиссия <> 0 Тогда
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаЦенныеБумаги.ТорговаяКомиссия, "Списание торговой комиссии");
					
					// дебет
					Проводка.СчетДт = СчетУчетаКомиссии;
					
					Если ЕстьСубконтоКонтрагентыПоКомиссии Тогда
						Проводка.СубконтоДт.Контрагенты = КонтрагентПоКомиссии;
					КонецЕсли;
					
					Если ЕстьСубконтоСделкиПоКомиссии Тогда
						Проводка.СубконтоДт.Сделка = ЭтотОбъект.Ссылка;
					КонецЕсли;
					
					// кредит
					Проводка.СчетКт = СчетУчетаДС;
					Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
						Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
					КонецЕсли;	
					
					Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
						Проводка.СубконтоКт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
					КонецЕсли;
					
					Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
						Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
					КонецЕсли;
					
					Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
						Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка  Тогда 
							ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияПокупка;
						ИначеЕсли ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
							ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияПродажа;
						КонецЕсли;		
						Проводка.СубконтоКт.ВидДвиженияДенежныхСредств              = ВидДвиженияДенежныхСредств;
					КонецЕсли;
				КонецЕсли;
				
				// а иначе на расходы комиссию спишет исполнение
				Если МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриОплате Тогда
					
					АналитикаУслугПоТорговойКомиссии = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
						ЭтотОбъект.Дата, 
						ЭтотОбъект.Организация, 
						ЭтотОбъект.СчетДоверительногоУправления,
						Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
						УчетныйРегистр,
						"АналитикаРЕПО");	
					
					Если Не ЗначениеЗаполнено(АналитикаУслугПоТорговойКомиссии) Тогда 	
						АналитикаУслугПоТорговойКомиссии = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
						ЭтотОбъект.Дата, 
						ЭтотОбъект.Организация, 
						ЭтотОбъект.СчетДоверительногоУправления,
						Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
						УчетныйРегистр,
						"Аналитика");	
					КонецЕсли;		
					
					ОбращаетсяНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(СтрокаЦенныеБумаги.ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
					
					ДанныеАналитики = Новый Структура("СделкаРЕПО, ВидЗадолженности", ЭтотОбъект.Ссылка, Справочники.ВидыЗадолженности.ПоТорговойКомиссии);
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаЦенныеБумаги.ТорговаяКомиссия, "Поступление услуг", ДанныеАналитики);
					
					Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
					
					Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаУслугПоТорговойКомиссии;
					Проводка.СубконтоДт.ЦенныеБумаги         = СтрокаЦенныеБумаги.ЦеннаяБумага;
					Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
					
					
					Проводка.СчетКт = СчетУчетаКомиссии;
					
					Если ЕстьСубконтоКонтрагентыПоКомиссии Тогда
						Проводка.СубконтоКт.Контрагенты = КонтрагентПоКомиссии;
					КонецЕсли;
					
					Если ЕстьСубконтоСделкиПоКомиссии Тогда
						Проводка.СубконтоКт.Сделка = ЭтотОбъект.Ссылка;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		
		НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйРегистр,
			Отказ); 
			
		Если Отказ Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствуют настройки у %1 по виду учета %2 на %3!", ЭтотОбъект.СчетДоверительногоУправления, УчетныйРегистр, ЭтотОбъект.Дата));
			Возврат;
		КонецЕсли;
			
		Если НастройкиПоВидуУчета.УчитыватьПартииРЕПООтдельно Тогда // учитываем как репо
		
			ЭтоОбычнаяСделка = Ложь;
			
			Если	(ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка И ЭтотОбъект.ЧастьСделкиРЕПО = 1)
					ИЛИ
				 	(ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа И ЭтотОбъект.ЧастьСделкиРЕПО = 2) Тогда
					
				ПроведениеПоРегиструБухгалтерииОбратноеРЕПО(УчетныйРегистр, Отказ);
				
			Иначе
				
				ПроведениеПоРегиструБухгалтерииПрямоеРЕПО(УчетныйРегистр, Отказ);
				
			КонецЕсли;
			
		Иначе
			
			ПроведениеПоРегиструБухгалтерииОбычнаяСделка(УчетныйРегистр, Отказ);
		
		КонецЕсли;
	
	КонецЕсли;
	
	Если ЭтотОбъект.ЧастьСделкиРЕПО = 1 И ЭтотОбъект.ВалютаОплаты <> ЭтотОбъект.Организация.ВалютаУчета
		ИЛИ ЭтотОбъект.ЧастьСделкиРЕПО = 2 И ЭтотОбъект.ВалютаОплатыВторойЧасти <> ЭтотОбъект.Организация.ВалютаУчета
		//ИЛИ ЭтотОбъект.ВалютаСделки <> ЭтотОбъект.Организация.ВалютаУчета
		ИЛИ ЭтотОбъект.ВалютаТорговойКомиссии <> ЭтотОбъект.Организация.ВалютаУчета
	Тогда
	
		БухгалтерскийУчет.ПереоценитьВалютныеАктивы(
			ЭтотОбъект,
			УчетныйРегистр,
			Перечисления.ВидыУчета[УчетныйРегистр],
			НастройкиУчетаОбщие,
			Отказ);	
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.ОстаткиЦенныхБумаг.Записывать               	= Истина;
	Движения.ОстаткиДенежныхСредств.Записывать           	= Истина;
	Движения.ЗадолженностиПоВторойЧастиРЕПО.Записывать   	= Истина;
	Движения.ЗадолженностиПоЦеннымБумагам.Записывать     	= Истина;
	Движения.ЗадолженностиПоДенежнымСредствам.Записывать 	= Истина;
	Движения.УсловияСделокРЕПО.Записывать                	= Истина;
	Движения.ОперацииСЦеннымиБумагами.Записывать         	= Истина;
	Движения.РасходыПоСделке.Записывать						= Истина;
	Движения.РезервыПредстоящихРасходов.Записывать	        = Истина;
	Движения.РезервыПИФ.Записывать					        = Истина;
	
	Если ЭтотОбъект.ЧастьСделкиРЕПО = 1 Тогда
		СформироватьДвиженияПоПервойЧастиРЕПО();
		
		//Считаем что торговая комиссия у ПИФ проходит по прочим резервам
		ПрочиеРезервыПИФНачисляетсяВУчете = БухгалтерскийУчет.РезервПИФНачисляетсяВУчете(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.Резервы.ПрочиеВозмещаемыеРасходыУправляющего);
		
		ТорговаяКомиссияИтого = ЭтотОбъект.ЦенныеБумаги.Итог("ТорговаяКомиссия");
		
		Если ПрочиеРезервыПИФНачисляетсяВУчете И ТорговаяКомиссияИтого > 0 Тогда

			АналитикаТорговойКомисии = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
				Дата, 
				Организация, 
				СчетДоверительногоУправления,
				Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
				Перечисления.ВидыУчета.БухгалтерскийУчет,
				"АналитикаРЕПО");
				
			Если ЗначениеЗаполнено(АналитикаТорговойКомисии) Тогда	
					
				РезервПоРасходу = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(АналитикаТорговойКомисии, "Резерв");
				
				Если ЗначениеЗаполнено(РезервПоРасходу) Тогда		
					
					Движение = Движения.РезервыПИФ.ДобавитьРасход();
					
					Движение.Период                       = ЭтотОбъект.Дата;
					Движение.Организация                  = ЭтотОбъект.Организация;
					Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
					Движение.Резерв                       = РезервПоРасходу;
					
					ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета");
					
					Если ЭтотОбъект.ВалютаТорговойКомиссии <> ВалютаУчета Тогда 
						Движение.Сумма  = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ТорговаяКомиссияИтого, ЭтотОбъект.ВалютаТорговойКомиссии, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
						Движение.Валюта = ВалютаУчета;
					Иначе
					    Движение.Сумма  = ТорговаяКомиссияИтого;
						Движение.Валюта = ЭтотОбъект.ВалютаТорговойКомиссии;
					КонецЕсли;
															
					// контроль отрицательных остатков переехал в регистрацию стоимости активов
					
				КонецЕсли;
				
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана аналитика торговой комиссии по бухучету! Списание резервов невозможно!", ЭтотОбъект,,, Отказ);
				
			КонецЕсли;	
			
		КонецЕсли;	
		
		
	ИначеЕсли ЭтотОбъект.ЧастьСделкиРЕПО = 2 Тогда
		СформироватьДвиженияПоВторойЧастиРЕПО();
		
	ИначеЕсли ЭтотОбъект.ЧастьСделкиРЕПО = 0 Тогда // всегда отложенное исполнение
		// задолженность по ц/б по 1-й части
		ТипЗадолженностиПоЦБ = ОпределитьТипЗадолженности(ЭтотОбъект.ВидСделки, Перечисления.ВидыАктивов.ЦенныеБумаги);
		
		Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
			Движение = Движения.ЗадолженностиПоЦеннымБумагам.ДобавитьПриход();
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Основание                    = ЭтотОбъект.Ссылка;
			Движение.ТипЗадолженности             = ТипЗадолженностиПоЦБ;
			Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Рынок                        = ЭтотОбъект.Рынок;
			Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
			Движение.Валюта                       = ЭтотОбъект.ВалютаСделки;
			Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
			Движение.Сумма                        = СтрокаЦенныеБумаги.Сумма;
			Движение.СуммаКупона                  = СтрокаЦенныеБумаги.СуммаКупона;
		КонецЦикла;
		
		// задолженность по ц/б по 2-й части
		Если      ТипЗадолженностиПоЦБ = Перечисления.ТипыЗадолженности.Дебиторская Тогда
			ТипЗадолженностиПоЦБ = Перечисления.ТипыЗадолженности.Кредиторская;
		ИначеЕсли ТипЗадолженностиПоЦБ = Перечисления.ТипыЗадолженности.Кредиторская Тогда
			ТипЗадолженностиПоЦБ = Перечисления.ТипыЗадолженности.Дебиторская;
		КонецЕсли;
		
		Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумагиВторойЧасти Цикл
			Движение = Движения.ЗадолженностиПоЦеннымБумагам.ДобавитьПриход();
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Основание                    = ЭтотОбъект.Ссылка;
			Движение.ТипЗадолженности             = ТипЗадолженностиПоЦБ;
			Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Рынок                        = ЭтотОбъект.Рынок;
			Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
			Движение.Валюта                       = ЭтотОбъект.ВалютаСделки;
			Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
			Движение.Сумма                        = СтрокаЦенныеБумаги.Сумма;
			Движение.СуммаКупона                  = СтрокаЦенныеБумаги.СуммаКупона;
		КонецЦикла;		
		
		// задолженность по д/с
		СформироватьСводныеДвиженияПоЗадолженностиПоДенежнымСредствамПоСделкеРЕПОБезВторойЧасти();
		
	КонецЕсли;
	
	Если ЭтотОбъект.ЧастьСделкиРЕПО <> 2 Тогда
		РегистрыСведений.УсловияСделокРЕПО.СформироватьДвижения(ЭтотОбъект);
		РегистрыСведений.ПлановыеДатыОплат.СформироватьДвижения(ЭтотОбъект);
		
		//Расходы по сделке
		Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
			Если СтрокаЦенныеБумаги.ТорговаяКомиссия > 0 Тогда
				Движение = Движения.РасходыПоСделке.Добавить();
				Движение.Период							= ЭтотОбъект.Дата;
				Движение.Организация					= ЭтотОбъект.Организация;
				Движение.СчетДоверительногоУправления	= ЭтотОбъект.СчетДоверительногоУправления;
				Движение.Сделка							= ЭтотОбъект.Ссылка;
				Движение.Рынок							= ЭтотОбъект.Рынок;
				Движение.ЦеннаяБумага					= СтрокаЦенныеБумаги.ЦеннаяБумага;
				Движение.ВидЗадолженности				= Справочники.ВидыЗадолженности.ПоТорговойКомиссии;
				Движение.Валюта							= ЭтотОбъект.ВалютаТорговойКомиссии;
				Движение.Сумма							= СтрокаЦенныеБумаги.ТорговаяКомиссия;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
		
	СформироватьДвиженияПоОперациямСЦеннымиБумагами();
	
	
	// резервы
	Если ЭтотОбъект.ЧастьСделкиРЕПО = 2 Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РезервыПредстоящихРасходовОстатки.Организация КАК Организация,
			|	РезервыПредстоящихРасходовОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	РезервыПредстоящихРасходовОстатки.Резерв КАК Резерв,
			|	РезервыПредстоящихРасходовОстатки.Валюта КАК Валюта,
			|	РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК СубъектАналитики,
			|	РезервыПредстоящихРасходовОстатки.СуммаОстаток КАК Сумма
			|ИЗ
			|	РегистрНакопления.РезервыПредстоящихРасходов.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И СубъектАналитики = &СубъектАналитики) КАК РезервыПредстоящихРасходовОстатки";
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("СубъектАналитики", ЭтотОбъект.ПерваяЧастьРЕПО);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			
			Движения.РезервыПредстоящихРасходов.Записывать = Истина;
			
			Движение = Движения.РезервыПредстоящихРасходов.ДобавитьРасход();
			Движение.Период = ЭтотОбъект.Дата;
			ЗаполнитьЗначенияСвойств(Движение, ВыборкаДетальныеЗаписи);
		
		КонецЕсли;
	
	КонецЕсли;
	
	// проверим отрицательные остатки
	Движения.Записать();
	
	// проверим соответствие 1-й и 2-й частей РЕПО
	Если ЭтотОбъект.ЧастьСделкиРЕПО = 2 Тогда
		Если РаботаСРегистрамиНакопления.ПроверитьНаличиеОстатков(ЭтотОбъект, "ЗадолженностиПоВторойЧастиРЕПО") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данные 2-й части РЕПО не соответствуют текущим условиям сделки.", ЭтотОбъект,,, Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЭтотОбъект.ОтложенноеИсполнение Тогда
		Если      ЭтотОбъект.ЧастьСделкиРЕПО = 1 Тогда
			Если      ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
				// т.к. сделка факт уже свершившийся, а партий по д/с нет, решили, что проверять отр. остатки д/с бессмысленно
				// РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиДенежныхСредств(ЭтотОбъект, Отказ);
				// А для ду-шников отрицательные остатки в течении дня по бирже возможны
			ИначеЕсли ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа 
				и НЕ ((ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЮридическогоЛица 
				или ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица)
				и ЭтотОбъект.МестоХранения <> Справочники.МестаХранения.ВнебиржевойРынок) Тогда
				РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЦенныхБумаг(ЭтотОбъект, Отказ);
			КонецЕсли;
			
		ИначеЕсли ЭтотОбъект.ЧастьСделкиРЕПО = 2 Тогда
			Если      ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
				// т.к. сделка факт уже свершившийся, а партий по д/с нет, решили, что проверять отр. остатки д/с бессмысленно
				// РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиДенежныхСредств(ЭтотОбъект, Отказ);
			ИначеЕсли ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка
				и НЕ ((ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЮридическогоЛица  
				или ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица)
				и ЭтотОбъект.МестоХранения <> Справочники.МестаХранения.ВнебиржевойРынок) Тогда
				РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЦенныхБумаг(ЭтотОбъект, Отказ);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		ЗаполнитьВторуюЧастьРЕПОНаОснованииПервойЧасти(ДанныеЗаполнения);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;	
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "ПерваяЧастьРЕПО, НомерСделки, ВремяСделки");
	
	Если ЭтотОбъект.ЧастьСделкиРЕПО = 2 Тогда
		ЭтотОбъект.ЦенныеБумаги.Очистить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтотОбъект.ЧастьСделкиРЕПО = 2 Тогда
		
		ПроверяемыеРеквизиты.Добавить("ПерваяЧастьРЕПО");
		
		Если ПроверяемыеРеквизиты.Найти("ВалютаОплатыВторойЧасти") <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ВалютаОплатыВторойЧасти"));
		КонецЕсли;
		
	КонецЕсли;
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры // ОбработкаПроверкиЗаполнения

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
		
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);
	
	РаботаСДокументами.ЗаполнитьСтрокиПартии(ЭтотОбъект);
			
	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		РаботаСДокументами.ПроверитьУникальностьНомераСделки(ЭтотОбъект, Отказ);
		
		РаботаСДокументами.ПроверитьЗаполнениеРасчетногоСчета(ЭтотОбъект, Отказ);
		
		// хотя бы одна строка должна быть
		Если ЭтотОбъект.ЦенныеБумаги.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ не содержит данных по ценной бумаге.", ЭтотОбъект,,, Отказ);
		КонецЕсли;
		
		// видом сделки могут быть только покупка или продажа
		Если ЭтотОбъект.ВидСделки <> Перечисления.ВидыСделок.Покупка И ЭтотОбъект.ВидСделки <> Перечисления.ВидыСделок.Продажа Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Видом сделки РЕПО может быть только покупка или продажа.", ЭтотОбъект, "ВидСделки",, Отказ);
		КонецЕсли;
			
		// РЕПО по векселям не бывает
		Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Векселя Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("РЕПО на рынке векселей не осуществляется.", ЭтотОбъект, "Рынок",, Отказ);
		КонецЕсли;
		
		// Если заполнены р/счет контрагента, то должен быть выбран правильный контрагент
		Если ЗначениеЗаполнено(ЭтотОбъект.РасчетныйСчетКонтрагента) Тогда
			Если ЭтотОбъект.РасчетныйСчетКонтрагента.ЮрФизЛицо <> ЭтотОбъект.Контрагент Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Контрагент «" + ЭтотОбъект.Контрагент + "» не является владельцем р/счета «" + ЭтотОбъект.РасчетныйСчетКонтрагента + "».", ЭтотОбъект, "Рынок",, Отказ);
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтотОбъект.ДвеЧастиСделкиРЕПО Тогда
			// если установлен режим с 2-мя частями сделки, то должен быть задан № части
			Если      ЭтотОбъект.ЧастьСделкиРЕПО = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задан номер части сделки РЕПО.",,,, Отказ);
			ИначеЕсли ЭтотОбъект.ЧастьСделкиРЕПО <> 1 И ЭтотОбъект.ЧастьСделкиРЕПО <> 2 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Номер части сделки РЕПО задан некорректно: допустимы только значения 1 и 2.",,,, Отказ);
			КонецЕсли;	
		Иначе
			ЭтотОбъект.ЧастьСделкиРЕПО     = 0;
			ЭтотОбъект.ДатаВторойЧастиРЕПО = Неопределено;
			
			// если используется схема с одной сделкой, то требуется отложенное исполнение
			Если Не ЭтотОбъект.ОтложенноеИсполнение И Не ЭтотОбъект.ОтложенноеИсполнениеВторойЧасти Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При использовании режима с одной сделкой РЕПО поддерживается только отложенное исполнение 1-й и 2-й частей сделки.",,,, Отказ);
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтотОбъект.ЧастьСделкиРЕПО = 2 Тогда
			// первая часть РЕПО должна быть именно 1-й частью
			Если ЗначениеЗаполнено(ЭтотОбъект.ПерваяЧастьРЕПО.ЧастьСделкиРЕПО) <> 1 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("1-я частью РЕПО выбран документ, таковым не являющийся.", ЭтотОбъект, "ПерваяЧастьРЕПО",, Отказ);
			КонецЕсли;
			
			Если ЭтотОбъект.Дата < ЭтотОбъект.ПерваяЧастьРЕПО.Дата Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата 2-ой части РЕПО должна быть позже даты 1-ой части.", ЭтотОбъект, "Дата",, Отказ);
			КонецЕсли;
			
			//В старых периодах есть сделки, у которых данные не совпадают с данными условий сделки (Цена, Цена процент).
			//Близжайшая такая сделка 22.11.2021 г. Добавил временное условие - пока не решится вопрос со сделками.
			Если ЭтотОбъект.Дата > Дата(2022,01,01) И Не Отказ Тогда
			
				Запрос = Новый Запрос;
#Область ТЕКСТ_ЗАПРОСА
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ТабличнаяЧасть.НомерСтроки КАК НомерСтроки,
					|	ТабличнаяЧасть.ЦеннаяБумага КАК ЦеннаяБумага,
					|	ТабличнаяЧасть.ДепозитарныйСчет КАК ДепозитарныйСчет,
					|	ТабличнаяЧасть.Количество КАК Количество,
					|	ТабличнаяЧасть.Цена КАК Цена,
					|	ТабличнаяЧасть.ЦенаПроцент КАК ЦенаПроцент,
					|	ТабличнаяЧасть.ЦенаКупона КАК ЦенаКупона,
					|	ТабличнаяЧасть.Сумма КАК Сумма,
					|	ТабличнаяЧасть.СуммаКупона КАК СуммаКупона
					|ПОМЕСТИТЬ _ТабличнаяЧасть
					|ИЗ
					|	&ТабличнаяЧасть КАК ТабличнаяЧасть
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	УсловияСделокРЕПОСрезПоследних.Организация <> &Организация КАК Организация,
					|	УсловияСделокРЕПОСрезПоследних.Рынок <> &Рынок КАК Рынок,
					|	УсловияСделокРЕПОСрезПоследних.ДатаОплаты <> ВЫБОР
					|		КОГДА &ОтложенноеИсполнение
					|			ТОГДА ВЫБОР
					|					КОГДА &РаздельноеИсполнение
					|						ТОГДА &ДатаОплаты
					|					ИНАЧЕ &ДатаИсполнения
					|				КОНЕЦ
					|		ИНАЧЕ &ДатаДокумента
					|	КОНЕЦ КАК ДатаОплаты,
					|	УсловияСделокРЕПОСрезПоследних.ДатаПоставки <> ВЫБОР
					|		КОГДА &ОтложенноеИсполнение
					|			ТОГДА ВЫБОР
					|					КОГДА &РаздельноеИсполнение
					|						ТОГДА &ДатаПоставки
					|					ИНАЧЕ &ДатаИсполнения
					|				КОНЕЦ
					|		ИНАЧЕ &ДатаДокумента
					|	КОНЕЦ КАК ДатаПоставки,
					|	УсловияСделокРЕПОСрезПоследних.ВалютаОплаты <> &ВалютаОплаты КАК ВалютаОплаты,
					|	УсловияСделокРЕПОСрезПоследних.СобственныйКурсОплаты <> &СобКурсОплаты КАК СобственныйКурсОплаты,
					|	УсловияСделокРЕПОСрезПоследних.КурсОплаты <> &КурсОплаты КАК КурсОплаты,
					|	УсловияСделокРЕПОСрезПоследних.ОтложенноеИсполнение <> &ОтложенноеИсполнение КАК ОтложенноеИсполнение,
					|	УсловияСделокРЕПОСрезПоследних.РаздельноеИсполнение <> &РаздельноеИсполнение КАК РаздельноеИсполнение,
					|	УсловияСделокРЕПОСрезПоследних.СчетДоверительногоУправления <> &СчетДУ КАК СчетДоверительногоУправления,
					|	УсловияСделокРЕПОСрезПоследних.ДатаИсполнения <> ВЫБОР
					|		КОГДА &ОтложенноеИсполнение
					|			ТОГДА &ДатаИсполнения
					|		ИНАЧЕ &ДатаДокумента
					|	КОНЕЦ КАК ДатаИсполнения,
					|	УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага ЕСТЬ NULL КАК ЦенныеБумагиЦеннаяБумага,
					|	УсловияСделокРЕПОСрезПоследних.ДепозитарныйСчет <> _ТабличнаяЧасть.ДепозитарныйСчет КАК ЦенныеБумагиДепозитарныйСчет,
					|	УсловияСделокРЕПОСрезПоследних.Количество <> _ТабличнаяЧасть.Количество КАК ЦенныеБумагиКоличество,
					|	УсловияСделокРЕПОСрезПоследних.Цена <> _ТабличнаяЧасть.Цена КАК ЦенныеБумагиЦена,
					|	УсловияСделокРЕПОСрезПоследних.ЦенаПроцент <> _ТабличнаяЧасть.ЦенаПроцент КАК ЦенныеБумагиЦенаПроцент,
					|	УсловияСделокРЕПОСрезПоследних.ЦенаКупона <> _ТабличнаяЧасть.ЦенаКупона КАК ЦенныеБумагиЦенаКупона,
					|	УсловияСделокРЕПОСрезПоследних.Сумма <> _ТабличнаяЧасть.Сумма КАК ЦенныеБумагиСумма,
					|	УсловияСделокРЕПОСрезПоследних.СуммаКупона <> _ТабличнаяЧасть.СуммаКупона КАК ЦенныеБумагиСуммаКупона,
					|	_ТабличнаяЧасть.НомерСтроки КАК НомерСтроки
					|ИЗ
