			Проводка.ВалютнаяСуммаДт = ДолгПоРЕПО;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.ПрочиеСредства10;
			
			Проводка.СубконтоКт.Контрагенты = КонтрагентДляОтраженияВУчете;
			Проводка.СубконтоКт.ОснованиеРасчетов = ЭтотОбъект.ПерваяЧастьРЕПО.Ссылка;
			
			Проводка.ВалютаКт  = ЭтотОбъект.ВалютаСделки;
			Проводка.ВалютнаяСуммаКт = ДолгПоРЕПО;
		
			// пришел долг по РЕПО
			ВсегоПроцентовВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ВсегоПроцентов, ЭтотОбъект.ВалютаСделки, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ВсегоПроцентовВВалютеУчета, "Оплата процентов");
			
			// дебет
			Проводка.СчетДт = СчетДС;
			
			Проводка.СубконтоДт[ВидСубконтоДС] = СубконтоДС;
			Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ЗакрытиеРЕПО;
			// С 1го января 2019года другой вид ДДС. Архитектор разрешил хардкод
			Если ЭтотОбъект.Дата >= Дата(2019, 1, 1) Тогда 
				Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ПроцентыПоРЕПО;
			КонецЕсли;
			
			Проводка.ВалютаДт  = ЭтотОбъект.ВалютаСделки;
			Проводка.ВалютнаяСуммаДт = ВсегоПроцентов;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.ПрочиеСредства11;
			
			Проводка.СубконтоКт.Контрагенты = КонтрагентДляОтраженияВУчете;
			Проводка.СубконтоКт.ОснованиеРасчетов = ЭтотОбъект.ПерваяЧастьРЕПО.Ссылка;
			
			Проводка.ВалютаКт  = ЭтотОбъект.ВалютаСделки;
			Проводка.ВалютнаяСуммаКт = ВсегоПроцентов;
			
			Если ДоначислитьПроцентовПоТекущемуКурсу > 0 Тогда
				
				ЦеннаяБумага = ЭтотОбъект.ЦенныеБумаги[0].ЦеннаяБумага;
				
				УчетныйАктив = Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО;
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ДоначислитьПроцентовПоТекущемуКурсу, "Проценты по РЕПО");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.ПрочиеСредства11;
				
				Проводка.СубконтоДт.Контрагенты = КонтрагентДляОтраженияВУчете;
				Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.ПерваяЧастьРЕПО.Ссылка;
				
				Проводка.ВалютаДт  = ЭтотОбъект.ВалютаСделки;
				Проводка.ВалютнаяСуммаДт = ДоначислитьПроцентов;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.ПроцентныеДоходы01;
				
				Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = БухгалтерскийУчетЕПС.ОпределитьГФУПроцентныхДоходовПоСредствамПредоставленнымКонтрагенту(КонтрагентДляОтраженияВУчете, ЭтотОбъект.Дата);
				Проводка.СубконтоКт.ЦенныеБумаги         = ЦеннаяБумага;
				
				
				// добавить закрытие на 479
				Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ЗакрытьПроцентовВВалютеУчета, "Проценты по РЕПО закрытие");
					// дебет
					Проводка.СчетДт = ПланыСчетов.Единый.ПроцентныеДоходы01;
					Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = БухгалтерскийУчетЕПС.ОпределитьГФУПроцентныхДоходовПоСредствамПредоставленнымКонтрагенту(КонтрагентДляОтраженияВУчете, ЭтотОбъект.Дата);
					Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
					
					// кредит
					Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
					Проводка.СубконтоКт.Договоры = ЭтотОбъект.СчетДоверительногоУправления;
				
				КонецЕсли;
				
			ИначеЕсли ДоначислитьПроцентовПоТекущемуКурсу < 0 Тогда
				
				ЦеннаяБумага = ЭтотОбъект.ЦенныеБумаги[0].ЦеннаяБумага;
				
				УчетныйАктив = Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО;
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, -ДоначислитьПроцентовПоТекущемуКурсу, "Проценты по РЕПО");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.ПроцентныеДоходы01;
				
				Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = БухгалтерскийУчетЕПС.ОпределитьГФУПроцентныхДоходовПоСредствамПредоставленнымКонтрагенту(КонтрагентДляОтраженияВУчете, ЭтотОбъект.Дата);
				Проводка.СубконтоДт.ЦенныеБумаги         = ЦеннаяБумага;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.ПрочиеСредства11;
				
				Проводка.СубконтоКт.Контрагенты = КонтрагентДляОтраженияВУчете;
				Проводка.СубконтоКт.ОснованиеРасчетов = ЭтотОбъект.ПерваяЧастьРЕПО.Ссылка;
				
				Проводка.ВалютаКт  = ЭтотОбъект.ВалютаСделки;
				Проводка.ВалютнаяСуммаКт = -ДоначислитьПроцентов;
				
				// добавить закрытие на 479
				Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ЗакрытьПроцентовВВалютеУчета, "Проценты по РЕПО закрытие");
					// дебет
					Проводка.СчетДт = ПланыСчетов.Единый.ПроцентныеДоходы01;
					Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = БухгалтерскийУчетЕПС.ОпределитьГФУПроцентныхДоходовПоСредствамПредоставленнымКонтрагенту(КонтрагентДляОтраженияВУчете, ЭтотОбъект.Дата);
					Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
					
					// кредит
					Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
					Проводка.СубконтоКт.Договоры = ЭтотОбъект.СчетДоверительногоУправления;
				
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

	// КОМИССИЯ
	
	Если ЭтотОбъект.ЧастьСделкиРЕПО = 1 Тогда
		
		Для Каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
		
			Если СтрокаЦенныеБумаги.ТорговаяКомиссия > 0 И Не ОтложеннаяОплатаТорговойКомиссии Тогда
				
				СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.ТорговаяКомиссия, ЭтотОбъект.ВалютаТорговойКомиссии, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
				
				// ОПЛАТА ТОРГОВОЙ КОМИССИИ
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Торговая комиссия");
				
				// дебет
				Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
					Проводка.СчетДт = ПланыСчетов.Единый.ПрочиеСредства19;
				Иначе
					Проводка.СчетДт = ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг19;
				КонецЕсли;	
				
				Проводка.СубконтоДт.Контрагенты = КонтрагентПоКомиссии;
				Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
				
				Проводка.ВалютаДт = ЭтотОбъект.ВалютаТорговойКомиссии;
				Проводка.ВалютнаяСуммаДт = СтрокаЦенныеБумаги.ТорговаяКомиссия;
				Проводка.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТорговаяКомиссия;
				
				// кредит
				Проводка.СчетКт = СчетДС;
				
				Проводка.СубконтоКт[ВидСубконтоДС] = СубконтоДС;
				Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияРЕПО;
				
				Проводка.ВалютаКт  = ЭтотОбъект.ВалютаТорговойКомиссии;
				Проводка.ВалютнаяСуммаКт = СтрокаЦенныеБумаги.ТорговаяКомиссия;
				
				
				Если НастройкиПоВидуУчета.МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриОплате
					ИЛИ НастройкиПоВидуУчета.МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриОткрытииРЕПО Тогда
				
					БухгалтерскийУчетЕПС.ПроводкиПризнанияКомиссииПоРЕПО(ЭтотОбъект, 
						ЭтотОбъект.Ссылка, 
						СуммаОперации, 
						СтрокаЦенныеБумаги.ТорговаяКомиссия,
						ЭтотОбъект.ВалютаТорговойКомиссии, 
						Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО, 
						СтрокаЦенныеБумаги.ЦеннаяБумага,
						КонтрагентДляОтраженияВУчете,
						КонтрагентПоКомиссии, 
						Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТорговаяКомиссия,
						Закрывать7ойРазделПриПоступленииДенежныхСредств);
				
				КонецЕсли;
				
			КонецЕсли;	
		
		КонецЦикла;
		
	ИначеЕсли (ЭтотОбъект.ЧастьСделкиРЕПО = 2) 
		И НЕ (НастройкиПоВидуУчета.МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриОплате)
		И НЕ (НастройкиПоВидуУчета.МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриОткрытииРЕПО) Тогда
		
		// #ТЕХНИЧЕСКИЙ_ДОЛГ
		// объединить эти запросы
		
		// торговая комииссия - "размазываем"
		ДополнительнаяАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТорговаяКомиссия;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РасходыПоСделке.СуммаОборот КАК СуммаКомиссии,
			|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток, 0) КАК ОстатокОплаченоКомиссии,
			|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток, 0) КАК НачислитьКомиссии,
			|	РасходыПоСделке.Валюта КАК Валюта
			|ИЗ
			|	РегистрНакопления.РасходыПоСделке.Обороты(
			|			,
			|			&Период,
			|			Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И Сделка = &СделкаРЕПО
			|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)) КАК РасходыПоСделке
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
			|				&Период,
			|				Счет = &СчетУчетаКомиссий,
			|				&ВидыСубконто,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
			|					И Субконто1 = &СделкаРЕПО
			|					И ЛицевойСчет.ДополнительнаяАналитика = &ДополнительнаяАналитика) КАК ЕдиныйБухгалтерскийУчетОстатки
			|		ПО РасходыПоСделке.Сделка = ЕдиныйБухгалтерскийУчетОстатки.Субконто1
			|			И РасходыПоСделке.Валюта = ЕдиныйБухгалтерскийУчетОстатки.Валюта";
		
		
		ВидыСубконто = Новый Массив;
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов);
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("ДополнительнаяАналитика", ДополнительнаяАналитика);
		Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));			
		Запрос.УстановитьПараметр("СделкаРЕПО", ЭтотОбъект.ПерваяЧастьРЕПО);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
		Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
		Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда // во 2-й части сделки наоборот: обратное - продажа, прямое - покупка
			Запрос.УстановитьПараметр("СчетУчетаКомиссий", ПланыСчетов.Единый.ПрочиеСредства19);
		Иначе
			Запрос.УстановитьПараметр("СчетУчетаКомиссий", ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг19);
		КонецЕсли;	
		
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
			СуммаКомиссии = ВыборкаДетальныеЗаписи.НачислитьКомиссии;
			
			ЦеннаяБумага = ЭтотОбъект.ЦенныеБумаги[0].ЦеннаяБумага;
			УчетныйАктив = Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО;
			
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКомиссии, ВыборкаДетальныеЗаписи.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			
			БухгалтерскийУчетЕПС.ПроводкиПризнанияКомиссииПоРЕПО(ЭтотОбъект, 
				ЭтотОбъект.ПерваяЧастьРЕПО,
				СуммаОперации,
				СуммаКомиссии,
				ВыборкаДетальныеЗаписи.Валюта,
				УчетныйАктив,
				ЦеннаяБумага,
				КонтрагентДляОтраженияВУчете,
				КонтрагентПоКомиссии,
				ДополнительнаяАналитика,
				Закрывать7ойРазделПриПоступленииДенежныхСредств);
			
		КонецЕсли;
		
		// брокерская комиссия - "размазываем"
		ДополнительнаяАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КомиссияБрокера;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РасходыПоСделке.СуммаОборот КАК СуммаКомиссии,
			|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток, 0) + ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОбороты.ВалютнаяСуммаОборотДт, 0) КАК ОстатокОплаченоКомиссии,
			|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток, 0) + ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОбороты.ВалютнаяСуммаОборотДт, 0) КАК НачислитьКомиссии,
			|	РасходыПоСделке.Валюта КАК Валюта
			|ИЗ
			|	РегистрНакопления.РасходыПоСделке.Обороты(
			|			,
			|			&КонецДня,
			|			Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И Сделка = &СделкаРЕПО
			|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)) КАК РасходыПоСделке
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
			|				&Период,
