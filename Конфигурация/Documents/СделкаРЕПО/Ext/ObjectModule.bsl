			Запрос.УстановитьПараметр("ДоДокумента", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
			Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
			Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			// Дооценка
			РезультатЗапросаДооценкаПартий = Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("_ДооценкаПартий").ПолучитьДанные();
			ВыборкаДооценкаПартий = РезультатЗапросаДооценкаПартий.Выбрать();
			Если НЕ РезультатЗапросаДооценкаПартий.Пустой() Тогда
				
				Пока ВыборкаДооценкаПартий.Следующий() Цикл
					
					ВалютаНоминала = ВыборкаДооценкаПартий.ВалютаНоминала;
					УчетныйАктив = ВыборкаДооценкаПартий.УчетныйАктивЕПС;
					
					Если ВыборкаДооценкаПартий.Перекурсовка Тогда 
						ПараметрыПерекурсовки = Новый Структура("ЦеннаяБумага, УчетныйАктивЕПС, "
								+ "СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета, "
								+ "ДисконтПремияНачисленныйВВалютеУчета, КорректировкаЭСПВВалютеУчета, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,"
								+ "ДисконтПремияНачисленныйОстаток, ПереоценкаОстаток, КорректировкаЭСПОстаток, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток",
							ВыборкаДооценкаПартий.ЦеннаяБумага, УчетныйАктив,
							ВыборкаДооценкаПартий.СтоимостьВВалютеУчета, ВыборкаДооценкаПартий.СтоимостьКупонаВВалютеУчета, ВыборкаДооценкаПартий.ПереоценкаВВалютеУчета, ВыборкаДооценкаПартий.ПереоценкаКупонаВВалютеУчета,
							ВыборкаДооценкаПартий.ДисконтПремияНачисленныйВВалютеУчета, ВыборкаДооценкаПартий.КорректировкаЭСПВВалютеУчета, ВыборкаДооценкаПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
							ВыборкаДооценкаПартий.ДисконтПремияНачисленныйОстаток, ВыборкаДооценкаПартий.ПереоценкаОстаток, ВыборкаДооценкаПартий.КорректировкаЭСПОстаток,ВыборкаДооценкаПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток);
						
						БухгалтерскийУчетЕПС.ДвижениеПерекурсовки(ЭтотОбъект, ПараметрыПерекурсовки, Отказ);		
						
