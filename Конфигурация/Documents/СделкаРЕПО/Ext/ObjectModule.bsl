					Проводка.СчетКт = Выборка.СчетУчета;
					
					Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
					
					Проводка.ВалютаКт = ВалютаНоминала;
					Проводка.ВалютнаяСуммаКт = Выборка.ДисконтПремияНачисленный;
					
