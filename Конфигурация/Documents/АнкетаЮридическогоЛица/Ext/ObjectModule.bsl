
Процедура ЗаполнитьЮрФизЛицо()
	
	ВызватьИсключение "Не удалось создать Юр/физ лицо";
	
КонецПроцедуры

Процедура ЗаполнитьКИО()
	
	Если НЕ ЭтотОбъект.РезидентРФ
	   И ЗначениеЗаполнено(ЭтотОбъект.ИНН)
	   И РаботаСКодамиКлиентСервер.ПроверитьИННЮрЛица(ЭтотОбъект.ИНН) = "" Тогда
		ЭтотОбъект.КИО = Сред(ЭтотОбъект.ИНН, 5, 5); 
	КонецЕсли;

КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") 
		и ДанныеЗаполнения.Свойство("ЮрФизЛицо") Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			,
		|			Организация = &Организация
		|				И ЮрФизЛицо = &ЮрФизЛицо
		|				И Язык = &Язык) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних");
		
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("ЮрФизЛицо", ДанныеЗаполнения.ЮрФизЛицо);
		Запрос.УстановитьПараметр("Язык", Справочники.Языки.Русский);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка.Регистратор,,"Дата,Номер,Проведен,ПометкаУдаления,Ответственный,Комментарий");
			ПредставителиВыгодоприобретатели.Загрузить(Выборка.Регистратор.ПредставителиВыгодоприобретатели.Выгрузить());
			БанковскиеРеквизиты.Загрузить(Выборка.Регистратор.БанковскиеРеквизиты.Выгрузить());
			
		КонецЕсли;		
		
	КонецЕсли;

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Не (ЦельПриобретениеПаев
		    Или ЦельДоверительноеУправление
			Или ЦельДоверительноеУправлениеНакоплениямиНПФ
			Или ЦельДоверительноеУправлениеРезервамиНПФ
			Или ЦельДругое) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указаны цели установления отношений", Ссылка, "ЦельДругое", "Объект", Отказ);
	КонецЕсли;
		
	Если Не ЭтотОбъект.РезидентРФ Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("КодПоОКАТО"));
	КонецЕсли;
	
	Если ЭтотОбъект.ОрганизационноПравоваяФорма = Справочники.ОрганизационноПравовыеФормы.ИндивидуальноеЧастноеПредприятие Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("КПП"));
	КонецЕсли;
	
	Если ЭтотОбъект.Дата >= Дата(2021,10,1) И РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицаОрганизации(ЭтотОбъект.Организация).Найти(ЭтотОбъект.ЮрФизЛицо) <> Неопределено Тогда
		Если Не ЗначениеЗаполнено(РаботаСКонтактнойИнформациейКлиентСервер.АдресФИАСВСтруктуру(ЭтотОбъект.ЮридическийАдресФИАС).КодАдресаФИАС) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В юридическом адресе не заполнен Код адреса ФИАС", ЭтотОбъект.Ссылка, "ЮридическийАдрес", "Объект", Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(РаботаСКонтактнойИнформациейКлиентСервер.АдресФИАСВСтруктуру(ЭтотОбъект.ФактическийАдресФИАС).КодАдресаФИАС) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В фактическом адресе не заполнен Код адреса ФИАС", ЭтотОбъект.Ссылка, "ФактическийАдрес", "Объект", Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(РаботаСКонтактнойИнформациейКлиентСервер.АдресФИАСВСтруктуру(ЭтотОбъект.ПочтовыйАдресФИАС).КодАдресаФИАС) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В почтовом адресе не заполнен Код адреса ФИАС", ЭтотОбъект.Ссылка, "ПочтовыйАдрес", "Объект", Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтотОбъект.Дата <= Дата(2025,07,28) Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("БенефициарныйВладелец"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("БенефициарныйВладелецКомментарий"));
	ИначеЕсли ЭтотОбъект.БенефициарныйВладелец = Перечисления.ВариантыСведенийОБенефициарныхВладельцах.Установлен Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("БенефициарныйВладелецКомментарий"));
	КонецЕсли;
	
	Отбор = Новый Структура("ВидУчастника", Перечисления.ВидыУчастниковАнкет.БенефициарныйВладелецУстановленныйКомпанией);
	БенефициарныеВладельцыУстановленныеКомпанией = ЭтотОбъект.ПредставителиВыгодоприобретатели.НайтиСтроки(Отбор);
	
	Если БенефициарныеВладельцыУстановленныеКомпанией.Количество() = 0 И ЭтотОбъект.БенефициарныйВладелец = Перечисления.ВариантыСведенийОБенефициарныхВладельцах.Установлен Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("БенефициарныйВладелецОбоснование"));
	КонецЕсли;

	Если Не ЭтотОбъект.МеждународнаяКомпания Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("СпособСозданияМеждународнойКомпании"));		
	КонецЕсли;	
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
		
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);
	
	ЗаполнитьКИО();

	Если Не ЭтотОбъект.МеждународнаяКомпания Тогда
		
		ЭтотОбъект.СпособСозданияМеждународнойКомпании = Перечисления.СпособыСозданияМеждународнойКомпании.ПустаяСсылка()
		
	КонецЕсли;	
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		Если Не ЗначениеЗаполнено(ЮрФизЛицо) Тогда
			ЗаполнитьЮрФизЛицо();
		КонецЕсли;		
		
		Если ЗначениеЗаполнено(ЮрФизЛицо) Тогда
			Для каждого СтрокаТабличнойЧасти из БанковскиеРеквизиты Цикл
				Справочники.БанковскиеСчета.СоздатьПолучитьРасчетныйСчет(
					СтрокаТабличнойЧасти.РасчетныйСчет, 
					ЭтотОбъект.Организация, 
					СтрокаТабличнойЧасти.БИК, 
					СтрокаТабличнойЧасти.НомерСчета, 
					ЭтотОбъект.ЮрФизЛицо, 
					Ложь,, 
					Отказ);
			КонецЦикла;
		КонецЕсли;
		
		ТребуетсяЗаполнениеБенефициарныхВладельцев = (ЭтотОбъект.БенефициарныйВладелец = Перечисления.ВариантыСведенийОБенефициарныхВладельцах.Установлен);
		
		Для каждого СтрокаПредставителиВыгодоприобретатели Из ЭтотОбъект.ПредставителиВыгодоприобретатели Цикл
		
			Если СтрокаПредставителиВыгодоприобретатели.ВидУчастника = Перечисления.ВидыУчастниковАнкет.Представитель Тогда
			
				СтрокаПредставителиВыгодоприобретатели.Комментарий = "";
				
			Иначе
				
				СтрокаПредставителиВыгодоприобретатели.Должность = "";
				СтрокаПредставителиВыгодоприобретатели.ОснованиеПолномочий = "";
			
			КонецЕсли;
			
			Если СтрокаПредставителиВыгодоприобретатели.ВидУчастника = Перечисления.ВидыУчастниковАнкет.БенефициарныйВладелец Тогда
				ТребуетсяЗаполнениеБенефициарныхВладельцев = Ложь;
			КонецЕсли;
		
		КонецЦикла;
		
		Если ТребуетсяЗаполнениеБенефициарныхВладельцев Тогда
		
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				"Необходимо указать бенефициарного владельца на закладке 'Представители / выгодоприобретатели'", 
				ЭтотОбъект.Ссылка, 
				"БенефициарныйВладелец", 
				"Объект", 
				Отказ);
		
		КонецЕсли;
		
		#Область СверкаСоСписками
		
		Если ОбщегоНазначения.ЗначениеПараметраСеанса("ЭтоРабочаяИнформационнаяБаза") Тогда
			// выполняем сверку только при выполнении следующих условий:
			// - это последняя анкета по данному физику
			// - был изменен как минимум один из значимых для проверки реквизитов
						
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	АнкетаЮридическогоЛица.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
				|	АнкетаЮридическогоЛица.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
				|	АнкетаЮридическогоЛица.ОГРН КАК ОГРН,
				|	АнкетаЮридическогоЛица.TIN КАК TIN,
				|	АнкетаЮридическогоЛица.ИНН КАК ИНН,
				|	АнкетаЮридическогоЛица.Проведен КАК Проведен,
				|	ЕСТЬNULL(РеквизитыЮридическихЛицАнкетныеСрезПоследних.Регистратор, НЕОПРЕДЕЛЕНО) КАК Регистратор
				|ИЗ
				|	Документ.АнкетаЮридическогоЛица КАК АнкетаЮридическогоЛица
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
				|				,
				|				Организация = &Организация
				|					И ЮрФизЛицо = &ЮрФизЛицо
				|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
				|		ПО (РеквизитыЮридическихЛицАнкетныеСрезПоследних.Период > &Дата)
				|ГДЕ
				|	АнкетаЮридическогоЛица.Ссылка = &Ссылка";

			Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
			Запрос.УстановитьПараметр("Дата", ЭтотОбъект.Дата);
			Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
			Запрос.УстановитьПараметр("ЮрФизЛицо", ЭтотОбъект.ЮрФизЛицо);

			РезультатЗапроса = Запрос.Выполнить();
			Выборка = РезультатЗапроса.Выбрать();
			
			Если Выборка.Следующий() И Выборка.Проведен Тогда 
				
				Если Выборка.Регистратор = Неопределено Тогда
					// это последний регистратор - проверяем реквизиты
					
					ПоказателиСверкиСоСпискомОтказников	= РегистрыСведений.ЖурналСверкиСоСписками.ПоказателиСверкиСоСпискомОтказников(Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо);
					ПоказателиСверкиСоСпискомОбщие		= РегистрыСведений.ЖурналСверкиСоСписками.ПоказателиСверкиСоСпискомОбщие(Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо);
			
					Для Каждого Показатель Из ПоказателиСверкиСоСпискомОтказников Цикл
						
						Если Выборка[Показатель] <> ЭтотОбъект[Показатель] Тогда 
							
							ЭтотОбъект.ДополнительныеСвойства.Вставить("СверитьСоСпискомОтказников");
							Прервать;  
							
						КонецЕсли; 
						
					КонецЦикла; 
					
					Для Каждого Показатель Из ПоказателиСверкиСоСпискомОбщие Цикл 
						
						Если Выборка[Показатель] <> ЭтотОбъект[Показатель] Тогда 
							
							ЭтотОбъект.ДополнительныеСвойства.Вставить("СверитьСоСпискомТеррористов");
							ЭтотОбъект.ДополнительныеСвойства.Вставить("СверитьСоСпискомРешенийМВК");
							ЭтотОбъект.ДополнительныеСвойства.Вставить("СверитьССанкционнымСписком");
							ЭтотОбъект.ДополнительныеСвойства.Вставить("СверитьССанкционнымСпискомНедружественныхГосударств");
							ЭтотОбъект.ДополнительныеСвойства.Вставить("СверитьСоСводнымПеречнемСоветаБезопасностиООН");
							Прервать; 
							
						КонецЕсли;
						
					КонецЦикла; 
					
				КонецЕсли;
				
			Иначе
				// документ новый - проверяем в любом случае
				ЭтотОбъект.ДополнительныеСвойства.Вставить("СверитьССанкционнымСписком");
				ЭтотОбъект.ДополнительныеСвойства.Вставить("СверитьСоСпискомОтказников");
				ЭтотОбъект.ДополнительныеСвойства.Вставить("СверитьСоСпискомТеррористов");
				ЭтотОбъект.ДополнительныеСвойства.Вставить("СверитьСоСпискомРешенийМВК");
				ЭтотОбъект.ДополнительныеСвойства.Вставить("СверитьССанкционнымСпискомНедружественныхГосударств"); 
				ЭтотОбъект.ДополнительныеСвойства.Вставить("СверитьСоСводнымПеречнемСоветаБезопасностиООН");
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		#КонецОбласти 
		
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если ЭтотОбъект.Дата > КонецДня(ТекущаяДата()) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя проводить документ '" + Метаданные().Представление() + "' будущей датой!",,,, Отказ);
		Возврат;
	КонецЕсли;
	
	Движения.РеквизитыЮридическихЛицАнкетные.Очистить();
	Движения.РеквизитыЮридическихЛицАнкетные.Записывать = Истина;
	
	Запись = Движения.РеквизитыЮридическихЛицАнкетные.Добавить();
	ЗаполнитьЗначенияСвойств(Запись, ЭтотОбъект);
	
	Запись.Период     = Дата;
	Запись.Активность = Истина;
	Запись.Язык       = Справочники.Языки.Русский;
	
	Для Каждого СтрокаРеквизитыНаИностранныхЯзыках Из ЭтотОбъект.РеквизитыНаИностранныхЯзыках Цикл
		
		Если ЗначениеЗаполнено(СтрокаРеквизитыНаИностранныхЯзыках.КраткоеНаименованиеПоУставу)
			ИЛИ ЗначениеЗаполнено(СтрокаРеквизитыНаИностранныхЯзыках.ПолноеНаименованиеПоУставу)
			ИЛИ ЗначениеЗаполнено(СтрокаРеквизитыНаИностранныхЯзыках.СокращенноеНаименование)
			ИЛИ ЗначениеЗаполнено(СтрокаРеквизитыНаИностранныхЯзыках.ЮридическийАдрес) Тогда
			
			Запись = Движения.РеквизитыЮридическихЛицАнкетные.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, ЭтотОбъект, "Организация,ЮрФизЛицо,ОрганизационноПравоваяФорма,РезидентРФ");
			ЗаполнитьЗначенияСвойств(Запись, СтрокаРеквизитыНаИностранныхЯзыках);
			
			Запись.Период     = Дата;
			Запись.Активность = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Движения.РеквизитыЮридическихЛицАнкетные.Записать(Истина);
	
	РегистрыСведений.ЖурналСверкиСоСписками.ВыполнитьПроверкиЮрФизЛицаПриПроведенииАнкеты(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.ЮрФизЛицо, ЭтотОбъект.ДополнительныеСвойства); 
		
КонецПроцедуры
#КонецОбласти 
