
Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля.Добавить("Дата");
	Поля.Добавить("СокращенноеНаименование");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Представление = Данные.СокращенноеНаименование + " " + Формат(Данные.Дата, "ДФ=dd.MM.yyyy");
	
КонецПроцедуры

Функция ПолучитьПредставлениеБенефициарныхВладельцев(Дата, Организация, БенефициарныеВладельцы) Экспорт

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	БенефициарныеВладельцы.ЮрФизЛицо КАК ЮрФизЛицо
		|ПОМЕСТИТЬ _ЮрФизЛица
		|ИЗ
		|	&БенефициарныеВладельцы КАК БенефициарныеВладельцы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество КАК ФИО
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо В
		|					(ВЫБРАТЬ
		|						_ЮрФизЛица.ЮрФизЛицо
		|					ИЗ
		|						_ЮрФизЛица КАК _ЮрФизЛица)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	ФИО";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("БенефициарныеВладельцы", БенефициарныеВладельцы);
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	
	Возврат СтрСоединить(Результат, ", ");

КонецФункции