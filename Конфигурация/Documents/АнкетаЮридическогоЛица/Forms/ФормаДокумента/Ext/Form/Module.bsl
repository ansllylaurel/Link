&НаКлиенте
Процедура КомандаЗаполнитьАдрес(Команда)
	
	СписокВыборка = Новый СписокЗначений;
	
	СписокВыборка.Добавить("ЮридическийАдрес"	, "Скопировать юридический адрес");
	СписокВыборка.Добавить("ФактическийАдрес"	, "Скопировать фактический адрес");
	СписокВыборка.Добавить("ПочтовыйАдрес"		, "Скопировать почтовый адрес");
	
	ИмяЭлемента = СтрЗаменить(Команда.Имя, "КомандаЗаполнить", "");

	СписокВыборка.Удалить(СписокВыборка.НайтиПоЗначению(ИмяЭлемента));
	
	ВыбранноеЗначение = ЭтаФорма.ВыбратьИзМеню(СписокВыборка, Команда);
	Если ВыбранноеЗначение <> Неопределено Тогда
		Объект[ИмяЭлемента] = Объект[ВыбранноеЗначение.Значение];
		Объект[ИмяЭлемента + "ФИАС"] = Объект[ВыбранноеЗначение.Значение + "ФИАС"];
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьОбязательныеРеквизитыАдреса()
	
	ОбязательныеРеквизитыАдреса = "";
	
	Если ЭтаФорма.ЮрФизЛицаОрганизации.НайтиПоЗначению(Объект.ЮрФизЛицо) <> Неопределено И Объект.Дата >= Дата(2021,10,1) Тогда
		ОбязательныеРеквизитыАдреса = "КодАдресаФИАС";
	КонецЕсли;	
	
	Возврат ОбязательныеРеквизитыАдреса;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийБанковскиеРеквизиты

&НаСервереБезКонтекста
Функция ПолучитьБанковскиеРеквизиты(БИК, Период)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Банки.Ссылка КАК Банк,
	|	ЕСТЬNULL(РеквизитыБанковСрезПоследних.Наименование, Банки.Наименование) КАК НаименованиеБанка,
	|	ЕСТЬNULL(РеквизитыБанковСрезПоследних.КоррСчет, Банки.КоррСчет) КАК КоррСчет
	|ИЗ
	|	Справочник.Банки КАК Банки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыБанков.СрезПоследних(&Период, ) КАК РеквизитыБанковСрезПоследних
	|		ПО (РеквизитыБанковСрезПоследних.Банк = Банки.Ссылка)
	|ГДЕ
	|	Банки.Код = &Код
	|	И Банки.ЭтоГруппа = ЛОЖЬ");
	
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Код", БИК);
	
	Результат = Новый Структура("Банк, НаименованиеБанка, КоррСчет");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура БИКПриИзменении(Элемент)
	
	НомерСтрокиСтрока = Сред(Элемент.Имя, СтрДлина("БИК") + 1);
	НомерСтрокиЧисло  = Число(НомерСтрокиСтрока);

	ТекущиеДанные = Объект.БанковскиеРеквизиты[НомерСтрокиЧисло];
	
	БанковскиеРеквизиты = ПолучитьБанковскиеРеквизиты(ТекущиеДанные.БИК, Объект.Дата);
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, БанковскиеРеквизиты);
	
	Если Не ПустаяСтрока(ТекущиеДанные.БИК) и Не ЗначениеЗаполнено(БанковскиеРеквизиты.Банк) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден банк по БИК " + ТекущиеДанные.БИК, Объект.Ссылка, "Объект.БанковскиеРеквизиты[" + НомерСтрокиСтрока + "].БИК");	
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВалютуПоНомеруСчета(Знач НомерСчета)
	Возврат Справочники.БанковскиеСчета.ПолучитьВалютуПоНомеруСчета(НомерСчета);
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыСчета(Знач НомерСчета, Знач БИК, Знач Организация)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БанковскиеСчета.Банк.Код КАК БИК,
	|	БанковскиеСчета.Банк.КоррСчет КАК КоррСчет,
	|	БанковскиеСчета.Банк.Наименование КАК НаименованиеБанка,
	|	БанковскиеСчета.Ссылка КАК РасчетныйСчет
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Организация = &Организация
	|	И БанковскиеСчета.НомерСчета = &НомерСчета
	|	И &Код В(БанковскиеСчета.Банк.Код, """")");
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НомерСчета",  НомерСчета);
	Запрос.УстановитьПараметр("Код",         БИК);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		РеквизитыСчета = Новый Структура("БИК,КоррСчет,НаименованиеБанка,Валюта,РасчетныйСчет");
		ЗаполнитьЗначенияСвойств(РеквизитыСчета, Выборка);
		
		Возврат РеквизитыСчета;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура НомерСчетаПриИзменении(Элемент)
	
	НомерСтрокиСтрока = Сред(Элемент.Имя, СтрДлина("НомерСчета") + 1);
	НомерСтрокиЧисло  = Число(НомерСтрокиСтрока);

	ТекущиеДанные = Объект.БанковскиеРеквизиты[НомерСтрокиЧисло];
	
	Если Не ПустаяСтрока(ТекущиеДанные.НомерСчета) Тогда
		
		РеквизитыСчета = ПолучитьРеквизитыСчета(ТекущиеДанные.НомерСчета, ТекущиеДанные.БИК, Объект.Организация);
		
		Если РеквизитыСчета <> Неопределено Тогда
			
			Если ТекущиеДанные.СозданДокументом Тогда
				ИсключаемыеСвойства = "РасчетныйСчет";
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ТекущиеДанные, РеквизитыСчета,, ИсключаемыеСвойства);
			
		Иначе
			
			Если Не ТекущиеДанные.СозданДокументом Тогда
				ТекущиеДанные.РасчетныйСчет = Неопределено;
			КонецЕсли;
			
			Валюта = ПолучитьВалютуПоНомеруСчета(ТекущиеДанные.НомерСчета);
			
			Если СтрДлина(ТекущиеДанные.НомерСчета) >= 20 и Не ЗначениеЗаполнено(Валюта) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдена валюта с кодом " + Сред(ТекущиеДанные.НомерСчета, 6, 3), Объект.Ссылка, "Объект.БанковскиеРеквизиты[" + НомерСтрокиСтрока + "].НомерСчета");	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НомерСчетаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НомерСтрокиСтрока = Сред(Элемент.Имя, СтрДлина("НомерСчета") + 1);
	НомерСтрокиЧисло  = Число(НомерСтрокиСтрока);

	ТекущиеДанные = Объект.БанковскиеРеквизиты[НомерСтрокиЧисло];
	
	Если СистемныеФункции.СсылкаСуществует(ТекущиеДанные.РасчетныйСчет) Тогда
		ОткрытьФорму("Справочник.БанковскиеСчета.ФормаОбъекта", Новый Структура("Ключ", ТекущиеДанные.РасчетныйСчет), Элемент);
	Иначе
		ПоказатьПредупреждение(,"Банковский счет не создан");
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьБанковскийСчет(Команда)

	НоваяСтрока = Объект.БанковскиеРеквизиты.Добавить();
	
	НоваяСтрока.ПолучательПлатежа = ТекущееПолноеНаименование;
	
	РазместитьБанковскийСчетНаСервере(НоваяСтрока.НомерСтроки - 1);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьБанковскийСчет(Элемент)
	
	Модифицированность = Истина;
	
	НомерУчастникаСтрока = Сред(Элемент.Имя, СтрДлина("ДекорацияУдаленияСчета") + 1);
	НомерУчастникаЧисло  = Число(НомерУчастникаСтрока);
	
	УдалитьБанковскийСчетНаСервере();
	
	Объект.БанковскиеРеквизиты.Удалить(НомерУчастникаЧисло);
	
КонецПроцедуры

&НаСервере
Процедура РазместитьБанковскийСчетНаСервере(Знач ИндексЭлемента)
	
	НомерУчастникаСтрока = Формат(ИндексЭлемента, "ЧН=0; ЧГ=0");
	
	НоваяГруппа = Элементы.Добавить("ГруппаБанковскийСчет" + НомерУчастникаСтрока, Тип("ГруппаФормы"), Элементы.ГруппаБанковскиеСчета);
	НоваяГруппа.Вид                  = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.Заголовок            = "Банковский счет";
	НоваяГруппа.Группировка          = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	НоваяГруппа.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
	НоваяГруппа.ПутьКДаннымЗаголовка = "Объект.БанковскиеРеквизиты[" + НомерУчастникаСтрока + "].НомерСчета";
	
	НовыйЭлемент = Элементы.Добавить("ДекорацияУдаленияСчета" + НомерУчастникаСтрока, Тип("ДекорацияФормы"), НоваяГруппа);
	НовыйЭлемент.Подсказка          = "Удалить банковский счет";
	НовыйЭлемент.Вид                = ВидДекорацииФормы.Картинка;
	НовыйЭлемент.Картинка           = БиблиотекаКартинок.Удалить;
	НовыйЭлемент.Гиперссылка        = Истина;
	НовыйЭлемент.Доступность        = Не ТолькоПросмотр;
	НовыйЭлемент.ПропускатьПриВводе = Истина;
	НовыйЭлемент.УстановитьДействие("Нажатие", "УдалитьБанковскийСчет");
	
	НоваяПодГруппа = Элементы.Добавить("ГруппаСсылка" + НомерУчастникаСтрока, Тип("ГруппаФормы"), НоваяГруппа);
	НоваяПодГруппа.Вид                 = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяПодГруппа.ОтображатьЗаголовок = Ложь;
	НоваяПодГруппа.Группировка         = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НоваяПодГруппа.Отображение         = ОтображениеОбычнойГруппы.Нет;
	
	НовыйЭлемент = Элементы.Добавить("БИК" + НомерУчастникаСтрока, Тип("ПолеФормы"), НоваяПодГруппа);
	НовыйЭлемент.ПутьКДанным               = "Объект.БанковскиеРеквизиты[" + НомерУчастникаСтрока + "].БИК";
	НовыйЭлемент.Вид                       = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПодсказкаВвода            = "БИК";
	НовыйЭлемент.Заголовок                 = "БИК";
	НовыйЭлемент.ПоложениеЗаголовка        = ПоложениеЗаголовкаЭлементаФормы.Лево;
	НовыйЭлемент.РастягиватьПоГоризонтали  = Ложь;
	НовыйЭлемент.Ширина                    = 10;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "БИКПриИзменении");
	
	НовыйЭлемент = Элементы.Добавить("БанковскийСчет" + НомерУчастникаСтрока, Тип("ПолеФормы"), НоваяПодГруппа);
	НовыйЭлемент.ПутьКДанным				= "Объект.БанковскиеРеквизиты[" + НомерУчастникаСтрока + "].РасчетныйСчет";
	НовыйЭлемент.Вид						= ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок                  = "Ссылка";
	НовыйЭлемент.ПоложениеЗаголовка			= ПоложениеЗаголовкаЭлементаФормы.Лево;
	НовыйЭлемент.РастягиватьПоГоризонтали	= Ложь;
	НовыйЭлемент.Ширина						= 10;
	НовыйЭлемент.ТолькоПросмотр				= Истина;
	
	НоваяПодГруппа = Элементы.Добавить("ГруппаБанк" + НомерУчастникаСтрока, Тип("ГруппаФормы"), НоваяГруппа);
	НоваяПодГруппа.Вид                 = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяПодГруппа.ОтображатьЗаголовок = Ложь;
	НоваяПодГруппа.Группировка         = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НоваяПодГруппа.Отображение         = ОтображениеОбычнойГруппы.Нет;
	
	НовыйЭлемент = Элементы.Добавить("НаименованиеБанка" + НомерУчастникаСтрока, Тип("ПолеФормы"), НоваяПодГруппа);
	НовыйЭлемент.ПутьКДанным              = "Объект.БанковскиеРеквизиты[" + НомерУчастникаСтрока + "].НаименованиеБанка";
	НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПодсказкаВвода           = "Наименование банка";
	НовыйЭлемент.ПоложениеЗаголовка       = ПоложениеЗаголовкаЭлементаФормы.Лево;
	НовыйЭлемент.Заголовок                = "Банк";
	НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
	НовыйЭлемент.ПропускатьПриВводе       = Истина;
	НовыйЭлемент.Ширина                   = 30;
	
	НовыйЭлемент = Элементы.Добавить("КоррСчет" + НомерУчастникаСтрока, Тип("ПолеФормы"), НоваяПодГруппа);
	НовыйЭлемент.ПутьКДанным              = "Объект.БанковскиеРеквизиты[" + НомерУчастникаСтрока + "].КоррСчет";
	НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПодсказкаВвода           = "Корреспондентский счет";
	НовыйЭлемент.ПоложениеЗаголовка       = ПоложениеЗаголовкаЭлементаФормы.Лево;
	НовыйЭлемент.Заголовок                = "к/с";
	НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
	НовыйЭлемент.ПропускатьПриВводе       = Истина;
	НовыйЭлемент.Ширина                   = 30;
	
	НоваяПодГруппа = Элементы.Вставить("ГруппаСчет" + НомерУчастникаСтрока, Тип("ГруппаФормы"), НоваяГруппа);
	НоваяПодГруппа.Вид                 = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяПодГруппа.ОтображатьЗаголовок = Ложь;
	НоваяПодГруппа.Группировка         = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НоваяПодГруппа.Отображение         = ОтображениеОбычнойГруппы.Нет;
	
	НовыйЭлемент = Элементы.Добавить("НомерСчета" + НомерУчастникаСтрока, Тип("ПолеФормы"), НоваяПодГруппа);
	НовыйЭлемент.ПутьКДанным              = "Объект.БанковскиеРеквизиты[" + НомерУчастникаСтрока + "].НомерСчета";
	НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПодсказкаВвода           = "Номер счета";
	НовыйЭлемент.ПоложениеЗаголовка       = ПоложениеЗаголовкаЭлементаФормы.Лево;
	НовыйЭлемент.Заголовок                = "р/с";
	НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
	НовыйЭлемент.Ширина                   = 30;
	НовыйЭлемент.КнопкаОткрытия           = Неопределено;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "НомерСчетаПриИзменении");
	НовыйЭлемент.УстановитьДействие("Открытие",     "НомерСчетаОткрытие");
	
	НоваяПодГруппа = Элементы.Добавить("ГруппаПолучатель" + НомерУчастникаСтрока, Тип("ГруппаФормы"), НоваяГруппа);
	НоваяПодГруппа.Вид                 = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяПодГруппа.ОтображатьЗаголовок = Ложь;
	НоваяПодГруппа.Группировка         = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НоваяПодГруппа.Отображение         = ОтображениеОбычнойГруппы.Нет;
	
	НовыйЭлемент = Элементы.Добавить("ПолучательПлатежа" + НомерУчастникаСтрока, Тип("ПолеФормы"), НоваяПодГруппа);
	НовыйЭлемент.ПутьКДанным              = "Объект.БанковскиеРеквизиты[" + НомерУчастникаСтрока + "].ПолучательПлатежа";
	НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПодсказкаВвода           = "Получатель платежа";
	НовыйЭлемент.ПоложениеЗаголовка       = ПоложениеЗаголовкаЭлементаФормы.Лево;
	НовыйЭлемент.Заголовок                = "Получатель";
	НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
	НовыйЭлемент.Ширина                   = 30;

	НовыйЭлемент = Элементы.Добавить("НазначениеПлатежа" + НомерУчастникаСтрока, Тип("ПолеФормы"), НоваяГруппа);
	НовыйЭлемент.ПутьКДанным              = "Объект.БанковскиеРеквизиты[" + НомерУчастникаСтрока + "].НазначениеПлатежа";
	НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПодсказкаВвода           = "Назначение платежа";
	НовыйЭлемент.Заголовок                = "Назначение";
	НовыйЭлемент.ПоложениеЗаголовка       = ПоложениеЗаголовкаЭлементаФормы.Лево;
	НовыйЭлемент.АвтоМаксимальнаяШирина   = Ложь;
	НовыйЭлемент.Высота                   = 2;
	НовыйЭлемент.МаксимальнаяВысота       = 2;
	НовыйЭлемент.АвтоМаксимальнаяВысота   = Ложь;
	НовыйЭлемент.МногострочныйРежим       = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьБанковскийСчетНаСервере()
	
	НомерУчастника = Объект.БанковскиеРеквизиты.Количество() - 1;
	НомерУчастникаСтрока = Формат(НомерУчастника, "ЧН=0; ЧГ=0");
	
	Элементы.Удалить(Элементы["ГруппаБанковскийСчет" + НомерУчастникаСтрока]);
	
КонецПроцедуры

