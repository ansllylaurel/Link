
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	НастроитьВидимостьИДоступность(ЭтотОбъект);
		
	ПроверитьКорректностьИНН(ЭтотОбъект);
	ПроверитьКорректностьОГРН(ЭтотОбъект);
	
	КоличествоПодчиненных = Элементы.ГруппаУчастники.ПодчиненныеЭлементы.Количество();
	Для Сч = 1 По КоличествоПодчиненных Цикл
		Элементы.Удалить(Элементы.ГруппаУчастники.ПодчиненныеЭлементы[КоличествоПодчиненных - Сч]);	
	КонецЦикла; 
		
	Для каждого СтрокаУчастник из Объект.ПредставителиВыгодоприобретатели Цикл
		РазместитьУчастникаНаСервере(СтрокаУчастник.НомерСтроки - 1);
		УстановитьВидимостьРеквизитовУчастников(Элементы, СтрокаУчастник.ВидУчастника, Формат(СтрокаУчастник.НомерСтроки - 1, "ЧН=0; ЧГ="));	
	КонецЦикла;
	
	КоличествоПодчиненных = Элементы.ГруппаБанковскиеСчета.ПодчиненныеЭлементы.Количество();
	Для Сч = 1 По КоличествоПодчиненных Цикл
		Элементы.Удалить(Элементы.ГруппаБанковскиеСчета.ПодчиненныеЭлементы[КоличествоПодчиненных - Сч]);	
	КонецЦикла; 

	Для каждого СтрокаУчастник из Объект.БанковскиеРеквизиты Цикл
		РазместитьБанковскийСчетНаСервере(СтрокаУчастник.НомерСтроки - 1);
	КонецЦикла;
	
	ТекущееПолноеНаименование = Объект.ПолноеНаименованиеПоУставу;
	
	ЭтаФорма.ЮрФизЛицаОрганизации.ЗагрузитьЗначения(РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицаОрганизации(Объект.Организация));
	ЗаполнитьФИОБенефициарногоВладельца();
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.ОбоснованиеУровняРиска = ПолучитьСтандартноеОбоснованиеУровняРиска(Объект.ВысокийУровеньРиска);
	КонецЕсли;
	
	ЗаполнитьФИОБенефициарногоВладельцаУстановленногоКомпанией();
	НастроитьОтображениеБенефициарногоВладельцаУстановленногоКомпанией(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.Ссылка.Пустая() Тогда
		ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.Проведение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ПриЗакрытииОкнаРазличий" Тогда
		ПроверитьКорректностьИНН(ЭтотОбъект, Истина);
		
		Если ЭтаФорма.ИННКорректен И НЕ Объект.РезидентРФ Тогда
			Объект.КИО = Сред(Объект.ИНН, 5, 5); 
		КонецЕсли;
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЮридическийАдресОчистка(Элемент, СтандартнаяОбработка)
	
	Объект.ЮридическийАдресФИАС = "";

КонецПроцедуры

&НаКлиенте
Процедура ФактическийАдресОчистка(Элемент, СтандартнаяОбработка)
	
	Объект.ФактическийАдресФИАС = "";

КонецПроцедуры

&НаКлиенте
Процедура ПочтовыйАдресОчистка(Элемент, СтандартнаяОбработка)
	
	Объект.ПочтовыйАдресФИАС = "";

КонецПроцедуры

#КонецОбласти

#Область НастройкаФормы

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	УстановитьВидимостьОпросников(Форма);
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
	Элементы.КИО.Видимость = НЕ Объект.РезидентРФ;
	Элементы.КодПоОКАТО.Видимость = Объект.РезидентРФ;
	
	ЭтоИП = (Объект.ОрганизационноПравоваяФорма = ПредопределенноеЗначение("Справочник.ОрганизационноПравовыеФормы.ИндивидуальноеЧастноеПредприятие"));
	Элементы.КПП.Видимость 						= Не ЭтоИП;
	Элементы.КПП2.Видимость 					= Не ЭтоИП;
	Элементы.ДекорацияКППКрупнейшего.Видимость 	= Не ЭтоИП;
	
	БенефициарныйВладелецУстановлен = (Объект.БенефициарныйВладелец 
		= ПредопределенноеЗначение("Перечисление.ВариантыСведенийОБенефициарныхВладельцах.Установлен"));
	Элементы.БенефициарныйВладелецФИО.Видимость = БенефициарныйВладелецУстановлен;
	Элементы.БенефициарныйВладелецКомментарий.Видимость = Не БенефициарныйВладелецУстановлен;
	Элементы.СпособСозданияМеждународнойКомпании.Видимость = Объект.МеждународнаяКомпания;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьОпросников(Форма)
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
	Элементы.НаличиеСчетаВГосударствахНеВыполняющихРекомендацииФАТФОписание.Видимость = Объект.НаличиеСчетаВГосударствахНеВыполняющихРекомендацииФАТФ;
	Элементы.ЦельДругоеОписание.Видимость = Объект.ЦельДругое;
	Элементы.ЦелиДеятельностиОписание.Видимость = Объект.ЦелиДеятельности = "Другое";
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитовУчастников(Элементы, ВидУчастника, НомерУчастникаСтрока)
	
	Если ВидУчастника = ПредопределенноеЗначение("Перечисление.ВидыУчастниковАнкет.Представитель") Тогда
		ВидимостьРеквизитов = Истина;
		ВидимостьКомментария = Ложь;
	ИначеЕсли ВидУчастника = ПредопределенноеЗначение("Перечисление.ВидыУчастниковАнкет.Выгодоприобретатель") Тогда
		ВидимостьРеквизитов = Ложь;
		ВидимостьКомментария = Истина;
	ИначеЕсли ВидУчастника = ПредопределенноеЗначение("Перечисление.ВидыУчастниковАнкет.БенефициарныйВладелец") Тогда
		ВидимостьРеквизитов = Ложь;
		ВидимостьКомментария = Истина;
	Иначе
		ВидимостьРеквизитов = Ложь;
		ВидимостьКомментария = Ложь;
	КонецЕсли;
		
	Элементы["Должность" + НомерУчастникаСтрока].Видимость = ВидимостьРеквизитов;
	Элементы["ОснованиеПолномочий" + НомерУчастникаСтрока].Видимость = ВидимостьРеквизитов;
	Элементы["Комментарий" + НомерУчастникаСтрока].Видимость = ВидимостьКомментария;
	
КонецПроцедуры

#КонецОбласти

#Область ПроверкаКорректностиКодов

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьКорректностьИНН(Форма, Сообщать = Ложь)
	
	ТекстСообщения = РаботаСКодамиКлиентСервер.ПроверитьИНН(Форма.Объект.ИНН);
	ОбработатьРезультатПроверки(Форма, "ИНН", ТекстСообщения, Сообщать);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьКорректностьОГРН(Форма, Сообщать = Ложь)
	
	Если Форма.Объект.ОрганизационноПравоваяФорма = ПредопределенноеЗначение("Справочник.ОрганизационноПравовыеФормы.ИндивидуальноеЧастноеПредприятие") Тогда
		ТекстСообщения = РаботаСКодамиКлиентСервер.ПроверитьОГРНИП(Форма.Объект.ОГРН);
	Иначе
		ТекстСообщения = РаботаСКодамиКлиентСервер.ПроверитьОГРН(Форма.Объект.ОГРН);
	КонецЕсли;
	
	ОбработатьРезультатПроверки(Форма, "ОГРН", ТекстСообщения, Сообщать);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбработатьРезультатПроверки(Форма, Поле, ТекстСообщения, Сообщать)
	
	ПолеКорректен = Поле + "Корректен";
	
	Форма[ПолеКорректен] = Не ЗначениеЗаполнено(ТекстСообщения);
	Если Форма[ПолеКорректен] Тогда
		Форма.Элементы[Поле].Подсказка = "";	
	Иначе
		Форма.Элементы[Поле].Подсказка = ТекстСообщения;
	КонецЕсли;
	
	Если Не Форма[ПолеКорректен] и Сообщать Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Форма.Объект.Ссылка, Поле, "Объект");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийОсновные

&НаКлиенте
Процедура ПолноеНаименованиеПоУставуПриИзменении(Элемент)
	
	ОбработатьНаименованиеЮрЛица(Объект.ПолноеНаименованиеПоУставу);
	
	Для каждого СтрокаТабЧасти из Объект.БанковскиеРеквизиты Цикл
		СтрокаТабЧасти.ПолучательПлатежа = СтрЗаменить(СтрокаТабЧасти.ПолучательПлатежа, ТекущееПолноеНаименование, Объект.ПолноеНаименованиеПоУставу);
	КонецЦикла;
	
	ТекущееПолноеНаименование = Объект.ПолноеНаименованиеПоУставу;
	
КонецПроцедуры

