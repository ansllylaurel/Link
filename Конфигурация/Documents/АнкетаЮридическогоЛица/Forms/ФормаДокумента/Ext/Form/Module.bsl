&НаКлиенте
Процедура ДобавитьУчастника(Команда)
	
	НоваяСтрока = Объект.ПредставителиВыгодоприобретатели.Добавить();
	НоваяСтрока.ВидУчастника = ПредопределенноеЗначение("Перечисление.ВидыУчастниковАнкет.Представитель");
	
	РазместитьУчастникаНаСервере(НоваяСтрока.НомерСтроки - 1);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьУчастника(Элемент)
	
	Модифицированность = Истина;
	
	НомерУчастникаСтрока = Сред(Элемент.Имя, СтрДлина("ДекорацияУдаления") + 1);
	НомерУчастникаЧисло  = Число(НомерУчастникаСтрока);
	
	УдалитьУчастникаНаСервере();
	
	Объект.ПредставителиВыгодоприобретатели.Удалить(НомерУчастникаЧисло);
	
	Для Сч = НомерУчастникаЧисло по Объект.ПредставителиВыгодоприобретатели.Количество() - 1 Цикл
		УстановитьВидимостьРеквизитовУчастников(Элементы, Объект.ПредставителиВыгодоприобретатели[Сч].ВидУчастника, Формат(Сч, "ЧН=0; ЧГ="));	
	КонецЦикла;
	
	НастроитьОтображениеБенефициарногоВладельцаУстановленногоКомпанией(ЭтаФорма);
	ЗаполнитьФИОБенефициарногоВладельцаУстановленногоКомпанией();
	
КонецПроцедуры

&НаСервере
Процедура РазместитьУчастникаНаСервере(Знач ИндексЭлемента)
	
	НомерУчастникаСтрока = Формат(ИндексЭлемента, "ЧН=0; ЧГ=0");
	
	НоваяГруппа = Элементы.Вставить("ГруппаУчастник" + НомерУчастникаСтрока, Тип("ГруппаФормы"), Элементы.ГруппаУчастники);
	НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.ОтображатьЗаголовок = Ложь;
	НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	НоваяГруппа.Отображение = ОтображениеОбычнойГруппы.Нет;
	
	НовыйЭлемент = Элементы.Добавить("ДекорацияУдаления" + НомерУчастникаСтрока, Тип("ДекорацияФормы"), НоваяГруппа);
	НовыйЭлемент.Подсказка = "Удалить участника";
	НовыйЭлемент.Вид       = ВидДекорацииФормы.Картинка;
	НовыйЭлемент.Картинка  = БиблиотекаКартинок.Удалить;
	НовыйЭлемент.Гиперссылка = Истина;
	НовыйЭлемент.УстановитьДействие("Нажатие", "УдалитьУчастника");
	
	Если ТолькоПросмотр Тогда
		НовыйЭлемент.Доступность = Ложь;	
	КонецЕсли;
	
	НовыйЭлемент = Элементы.Добавить("ВидУчастника" + НомерУчастникаСтрока, Тип("ПолеФормы"), НоваяГруппа);
	НовыйЭлемент.ПутьКДанным = "Объект.ПредставителиВыгодоприобретатели[" + НомерУчастникаСтрока + "].ВидУчастника";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "ВидУчастникаПриИзменении");
	НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
	НовыйЭлемент.Ширина = 20;
	
	НовыйЭлемент = Элементы.Добавить("ЮрФизЛицо" + НомерУчастникаСтрока, Тип("ПолеФормы"), НоваяГруппа);
	НовыйЭлемент.ПутьКДанным = "Объект.ПредставителиВыгодоприобретатели[" + НомерУчастникаСтрока + "].ЮрФизЛицо";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.АвтоОтметкаНезаполненного = Истина;
	НовыйЭлемент.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "ЮрФизЛицоУчастникаПриИзменении");
	НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
	НовыйЭлемент.Ширина = 30;
	
	НовыйЭлемент = Элементы.Добавить("Должность" + НомерУчастникаСтрока, Тип("ПолеФормы"), НоваяГруппа);
	НовыйЭлемент.ПутьКДанным = "Объект.ПредставителиВыгодоприобретатели[" + НомерУчастникаСтрока + "].Должность";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.АвтоОтметкаНезаполненного = Истина;
	НовыйЭлемент.ПодсказкаВвода = "Должность";
	
	НовыйЭлемент = Элементы.Добавить("ОснованиеПолномочий" + НомерУчастникаСтрока, Тип("ПолеФормы"), НоваяГруппа);
	НовыйЭлемент.ПутьКДанным = "Объект.ПредставителиВыгодоприобретатели[" + НомерУчастникаСтрока + "].ОснованиеПолномочий";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.АвтоОтметкаНезаполненного = Истина;
	НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
	НовыйЭлемент.ПодсказкаВвода = "Основание полномочий";
	
	НовыйЭлемент = Элементы.Добавить("Комментарий" + НомерУчастникаСтрока, Тип("ПолеФормы"), НоваяГруппа);
	НовыйЭлемент.ПутьКДанным = "Объект.ПредставителиВыгодоприобретатели[" + НомерУчастникаСтрока + "].Комментарий";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.АвтоОтметкаНезаполненного = Ложь;
	НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
	НовыйЭлемент.ПодсказкаВвода = "Комментарий";
	
	НовыйЭлемент = Элементы.Добавить("ДекорацияПечать" + НомерУчастникаСтрока, Тип("ДекорацияФормы"), НоваяГруппа);
	НовыйЭлемент.Подсказка           = "Печать анкет";
	НовыйЭлемент.Вид                 = ВидДекорацииФормы.Картинка;
	НовыйЭлемент.Картинка            = БиблиотекаКартинок.Печать;
	НовыйЭлемент.Гиперссылка         = Истина;
	НовыйЭлемент.УстановитьДействие("Нажатие", "НапечататьАнкетуУчастника");
		
КонецПроцедуры

&НаСервере
Процедура УдалитьУчастникаНаСервере()
	
	НомерУчастника = Объект.ПредставителиВыгодоприобретатели.Количество() - 1;
	НомерУчастникаСтрока = Формат(НомерУчастника, "ЧН=0; ЧГ=0");
	
	Элементы.Удалить(Элементы["ВидУчастника" + НомерУчастникаСтрока]);
	//Элементы.Удалить(Элементы["Анкета" + НомерУчастникаСтрока]);
	Элементы.Удалить(Элементы["Должность" + НомерУчастникаСтрока]);
	Элементы.Удалить(Элементы["ОснованиеПолномочий" + НомерУчастникаСтрока]);
	Элементы.Удалить(Элементы["ДекорацияУдаления" + НомерУчастникаСтрока]);
	Элементы.Удалить(Элементы["ГруппаУчастник" + НомерУчастникаСтрока]);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидУчастникаПриИзменении(Элемент)
	
	НомерУчастникаСтрокой = СтрЗаменить(Элемент.Имя, "ВидУчастника", "");
	НомерУчастникаЧислом  = Число(НомерУчастникаСтрокой);
	
	УстановитьВидимостьРеквизитовУчастников(Элементы, Объект.ПредставителиВыгодоприобретатели[НомерУчастникаЧислом].ВидУчастника, НомерУчастникаСтрокой);
	
	НастроитьОтображениеБенефициарногоВладельцаУстановленногоКомпанией(ЭтаФорма);
	ЗаполнитьФИОБенефициарногоВладельцаУстановленногоКомпанией();
	
КонецПроцедуры

&НаКлиенте
Процедура ЮрФизЛицоУчастникаПриИзменении(Элемент)
	
	НастроитьОтображениеБенефициарногоВладельцаУстановленногоКомпанией(ЭтаФорма);
	ЗаполнитьФИОБенефициарногоВладельцаУстановленногоКомпанией();
	
КонецПроцедуры

&НаКлиенте
Процедура НапечататьАнкетуУчастника(Элемент)
	
	НомерУчастникаСтрока = Сред(Элемент.Имя, СтрДлина("ДекорацияПечать") + 1);
	НомерУчастникаЧисло  = Число(НомерУчастникаСтрока);
	
	СтрокаТабЧасти = Объект.ПредставителиВыгодоприобретатели[НомерУчастникаЧисло];
	
	ОткрытьФорму("Обработка.ПечатьАнкетныхДанных.Форма.Форма", Новый Структура("ЮрФизЛицо, ВариантАнкеты, ОснованиеПолномочий", СтрокаТабЧасти.ЮрФизЛицо, СтрокаТабЧасти.ВидУчастника, СтрокаТабЧасти.ОснованиеПолномочий), ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиНаименованияНаИностранныхЯзыках

&НаКлиенте
Процедура НаименованияНаИностранныхЯзыкахЯзыкНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДанныеВыбора = Новый СписокЗначений;
	ДанныеВыбора.ЗагрузитьЗначения(МассивИностранныхЯзыков());
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция МассивИностранныхЯзыков()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Языки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Языки КАК Языки
		|ГДЕ
		|	Языки.Ссылка <> ЗНАЧЕНИЕ(Справочник.Языки.Русский)";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаКлиенте
Процедура НаименованияНаИностранныхЯзыкахКраткоеНаименованиеПоУставуПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.НаименованияНаИностранныхЯзыках.ТекущиеДанные;
	ОбработатьНаименованиеЮрЛица(ТекущиеДанные.КраткоеНаименованиеПоУставу);
	
КонецПроцедуры

&НаКлиенте
Процедура НаименованияНаИностранныхЯзыкахПолноеНаименованиеПоУставуПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.НаименованияНаИностранныхЯзыках.ТекущиеДанные;
	ОбработатьНаименованиеЮрЛица(ТекущиеДанные.ПолноеНаименованиеПоУставу);
	
КонецПроцедуры

&НаКлиенте
Процедура НаименованияНаИностранныхЯзыкахСокращенноеНаименованиеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.НаименованияНаИностранныхЯзыках.ТекущиеДанные;
	ОбработатьНаименованиеЮрЛица(ТекущиеДанные.СокращенноеНаименование);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ОбработатьНаименованиеЮрЛица(Наименование)

	МассивЗамен = Новый Массив;

	МассивЗамен.Добавить("«");
	МассивЗамен.Добавить("»");
	МассивЗамен.Добавить("“");
	МассивЗамен.Добавить("”");
	МассивЗамен.Добавить("‘‘");
	МассивЗамен.Добавить("’’");

	Для Каждого ЭлементЗамены Из МассивЗамен Цикл
		Наименование = СтрЗаменить(Наименование, ЭлементЗамены, """");
	КонецЦикла;
		
	Наименование = РаботаСоСтрокамиКлиентСервер.ЗаменитьПробельныеСимволы(Наименование, " ");
	
	Пока СтрНайти(Наименование, "  ") > 0 Цикл
		Наименование = СтрЗаменить(Наименование, "  ", " ");
	КонецЦикла;	
	
	Наименование = СокрЛП(Наименование);

КонецПроцедуры

&НаКлиенте
Процедура ОрганизационноПравоваяФормаПриИзменении(Элемент)
	НастроитьВидимостьИДоступность(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОткрытьПрисоединенныеФайлы()

	РаботаСФайловымХранилищемКлиент.ОткрытьПрисоединенныеФайлы(Объект.Ссылка);

КонецПроцедуры

&НаКлиенте
Процедура БенефициарныйВладелецПриИзменении(Элемент)
	НастроитьВидимостьИДоступность(ЭтотОбъект);
	ЗаполнитьФИОБенефициарногоВладельца();
	ЗаполнитьФИОБенефициарногоВладельцаУстановленногоКомпанией();
	НастроитьОтображениеБенефициарногоВладельцаУстановленногоКомпанией(ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФИОБенефициарногоВладельца()

	Если Объект.БенефициарныйВладелец = Перечисления.ВариантыСведенийОБенефициарныхВладельцах.Установлен Тогда

		Отбор = Новый Структура("ВидУчастника", Перечисления.ВидыУчастниковАнкет.БенефициарныйВладелец);
		БенефициарныеВладельцы = Объект.ПредставителиВыгодоприобретатели.Выгрузить(Отбор, "ЮрФизЛицо");

		ЭтаФорма.БенефициарныйВладелецФИО = Документы.АнкетаЮридическогоЛица.ПолучитьПредставлениеБенефициарныхВладельцев(Объект.Дата, Объект.Организация, БенефициарныеВладельцы);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ВысокийУровеньРискаПриИзменении(Элемент)
	
	Объект.ОбоснованиеУровняРиска = ПолучитьСтандартноеОбоснованиеУровняРиска(Объект.ВысокийУровеньРиска);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСтандартноеОбоснованиеУровняРиска(ВысокийУровеньРиска)

	СтандартноеОбоснованиеУровняРиска = ?(ВысокийУровеньРиска, "", "факторы высокого уровня риска не установлены");
	Возврат СтандартноеОбоснованиеУровняРиска;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьОтображениеБенефициарногоВладельцаУстановленногоКомпанией(Форма)
	
	Отбор = Новый Структура("ВидУчастника", ПредопределенноеЗначение("Перечисление.ВидыУчастниковАнкет.БенефициарныйВладелецУстановленныйКомпанией"));
	БенефициарныеВладельцы = Форма.Объект.ПредставителиВыгодоприобретатели.НайтиСтроки(Отбор);
	
	Если БенефициарныеВладельцы.Количество() = 0 Тогда
		Форма.Элементы.БенефициарныйВладелецОбоснование.АвтоОтметкаНезаполненного = Ложь;
		Форма.Элементы.БенефициарныйВладелецОбоснование.ОтметкаНезаполненного = Ложь;
	Иначе
		Форма.Элементы.БенефициарныйВладелецОбоснование.АвтоОтметкаНезаполненного = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФИОБенефициарногоВладельцаУстановленногоКомпанией()

	Отбор = Новый Структура("ВидУчастника", Перечисления.ВидыУчастниковАнкет.БенефициарныйВладелецУстановленныйКомпанией);
	БенефициарныеВладельцы = Объект.ПредставителиВыгодоприобретатели.Выгрузить(Отбор, "ЮрФизЛицо");
	
	ЭтаФорма.БенефициарныйВладелецУстановленныйКомпаниейФИО = Документы.АнкетаЮридическогоЛица.ПолучитьПредставлениеБенефициарныхВладельцев(
		Объект.Дата, 
		Объект.Организация, 
		БенефициарныеВладельцы);
		
КонецПроцедуры

&НаКлиенте
Процедура МеждународнаяКомпанияПриИзменении(Элемент)

	НастроитьВидимостьИДоступность(ЭтаФорма);	

КонецПроцедуры

