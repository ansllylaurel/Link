#Область СОБЫТИЯ_ФОРМЫ
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтотОбъект);
	
	Если Объект.Ссылка.Пустая() Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Ссылка",
		Справочники.УправляющиеКомпании.ПолучитьПИФыПоЮрФизЛицуУправляющейКомпании(Объект.Дата, Объект.Организация.ЮрФизЛицо)));
	
	Элементы.ПаевойИнвестиционныйФонд.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры
#КонецОбласти

&НаСервереБезКонтекста
Функция ПолучитьСчетДоверительногоУправления(Знач ПаевойИнвестиционныйФонд, Знач Период)
	
	Возврат Справочники.СчетаДоверительногоУправления.СчетДоверительногоУправленияКлиента(ПаевойИнвестиционныйФонд, Период);	
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	ДанныеОбъекта = Форма.Объект;
	Элементы      = Форма.Элементы; 
	
	ЭтоРПИ = (ДанныеОбъекта.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ"));
	
	Элементы.ГруппаОпределениеДохода.Видимость = Не ЗначениеЗаполнено(ДанныеОбъекта.Основание);

	Элементы.ГруппаВычислениеСуммыВыплаты.Видимость = Не ЗначениеЗаполнено(ДанныеОбъекта.Основание) И НЕ ЭтоРПИ;
	
	Элементы.ФормаЗаполнить.Видимость = ЭтоРПИ;
	
	Элементы.ГруппаНачислениеНДФЛ.Видимость = ЭтоРПИ; 
	
	Элементы.Основание.Видимость = ЭтоРПИ;
	
КонецПроцедуры // НастроитьВидимостьИДоступность

&НаКлиенте
Процедура ПаевойИнвестиционныйФондПриИзменении(Элемент)
	
	Объект.СчетДоверительногоУправления = ПолучитьСчетДоверительногоУправления(Объект.ПаевойИнвестиционныйФонд, Объект.Дата);
	ЗаполнитьКоличествоПаев();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКоличествоПаев()
	
	Если ЗначениеЗаполнено(Объект.ПаевойИнвестиционныйФонд) 
		И ЗначениеЗаполнено(Объект.ДатаОпределенияСпискаЛиц) 
		И НЕ ЗначениеЗаполнено(Объект.Основание) Тогда
		
		КоличествоПаевНовое = КоличествоПаев();
		Если Объект.КоличествоПаев = 0 Тогда
			Объект.КоличествоПаев = КоличествоПаевНовое;
			ЗаполнитьТабличнуюЧастьРаспределенияДохода();
		ИначеЕсли Объект.КоличествоПаев <> КоличествоПаевНовое Тогда 
			Ответ = Вопрос("Перезаполнить количество паев?", РежимДиалогаВопрос.ДаНетОтмена,0);
			Если Ответ = КодВозвратаДиалога.Да Тогда
				Объект.КоличествоПаев = КоличествоПаевНовое;
				ЗаполнитьТабличнуюЧастьРаспределенияДохода();
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТабличнуюЧастьРаспределенияДохода()
	
	Если ЗначениеЗаполнено(Объект.ПаевойИнвестиционныйФонд) 
		И ЗначениеЗаполнено(Объект.ДатаОпределенияСпискаЛиц)
		И ЗначениеЗаполнено(Объект.СуммаДоходаКРаспределению) Тогда
		
		Ответ = Вопрос("Заполнить пайщиков?", РежимДиалогаВопрос.ДаНетОтмена,0);
		
		Если Ответ = КодВозвратаДиалога.Да Тогда
			ЗаполнитьТабличнуюЧастьРаспределенияДоходаНаСервере();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличнуюЧастьРаспределенияДоходаНаСервере()
	
	ОбъектДокумента = РеквизитФормыВЗначение("Объект", Тип("ДокументОбъект.РаспределениеДоходаПайщикам"));
	ОбъектДокумента.ЗаполнитьРаспределениеДохода();
	ЗначениеВРеквизитФормы(ОбъектДокумента, "Объект");
	
КонецПроцедуры

&НаСервере
Функция КоличествоПаев()
	
	Если ЗначениеЗаполнено(Объект.ПаевойИнвестиционныйФонд) И НЕ ЗначениеЗаполнено(Объект.Основание) Тогда
		//заполнить количество паев
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СУММА(ДолиПайщиковВИнвестиционномФондеОстатки.КоличествоОстаток) КАК КоличествоОстаток
			|ИЗ
			|	РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.Остатки(
			|			&НачалоДня,
			|			Организация = &Организация
			|				И ПаевойИнвестиционныйФонд = &ПаевойИнвестиционныйФонд) КАК ДолиПайщиковВИнвестиционномФондеОстатки";
		
		Запрос.УстановитьПараметр("НачалоДня", КонецДня(Объект.ДатаОпределенияСпискаЛиц));
		Запрос.УстановитьПараметр("Организация", Объект.Организация);
		Запрос.УстановитьПараметр("ПаевойИнвестиционныйФонд", Объект.ПаевойИнвестиционныйФонд);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Возврат ВыборкаДетальныеЗаписи.КоличествоОстаток;
		КонецЦикла;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

&НаКлиенте
Процедура ДатаОпределенияДоходаПриИзменении(Элемент)
	ЗаполнитьКоличествоПаев();
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьДоход(Команда)
	ЗаполнитьТабличнуюЧастьРаспределенияДоходаНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура НачислитьНДФЛ(Команда)
	РассчитатьНДФЛНаСервере();
КонецПроцедуры

&НаСервере
Процедура РассчитатьНДФЛНаСервере()
	
	Отказ = Ложь;
	
	ОбъектДокумента = РеквизитФормыВЗначение("Объект", Тип("ДокументОбъект.РаспределениеДоходаПайщикам"));
	
	ОбъектДокумента.ЗаполнитьНДФЛ(Отказ);
	
	Если Не Отказ Тогда
		ЗначениеВРеквизитФормы(ОбъектДокумента, "Объект");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьНалог()
	
	ТД = ЭтаФорма.Элементы.НачислениеНДФЛ.ТекущиеДанные;
	
	ТД.СуммаНДФЛ = ПересчитатьНалогНаСервере(ТД.ПолучательДохода, ТД.СуммаДохода, ТД.СтавкаНДФЛ);
	
КонецПроцедуры

&НаСервере
Функция ПересчитатьНалогНаСервере(ПолучательДохода, СуммаДохода, СтавкаНДФЛ)
	
	ТаблицаДохода = Новый ТаблицаЗначений;
	ТаблицаДохода.Колонки.Добавить("ПолучательДохода", Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	ТаблицаДохода.Колонки.Добавить("СуммаДохода", Новый ОписаниеТипов("Число"));
	ТаблицаДохода.Колонки.Добавить("СтавкаНДФЛ", Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДФЛ"));
	ТаблицаДохода.Колонки.Добавить("СуммаНДФЛ", Новый ОписаниеТипов("Число"));
	
	СтрокаДохода = ТаблицаДохода.Добавить();
	СтрокаДохода.ПолучательДохода = ПолучательДохода;
	СтрокаДохода.СуммаДохода = СуммаДохода;
	СтрокаДохода.СтавкаНДФЛ = СтавкаНДФЛ;
	
	ОбъектДокумента = РеквизитФормыВЗначение("Объект", Тип("ДокументОбъект.РаспределениеДоходаПайщикам"));
	ОбъектДокумента.ЗаполнитьНДФЛ(Ложь, ТаблицаДохода);
	
	Возврат ТаблицаДохода[0].СуммаНДФЛ;
	
КонецФункции

&НаКлиенте
Процедура НачислениеНДФЛСуммаДоходаПриИзменении(Элемент)
	ПересчитатьНалог();
КонецПроцедуры

&НаКлиенте
Процедура НачислениеНДФЛСтавкаНДФЛПриИзменении(Элемент)
	ПересчитатьНалог();
КонецПроцедуры

&НаКлиенте
Процедура ОснованиеПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Основание) Тогда
		Объект.ДатаОпределенияСпискаЛиц = 0;
		Объект.СуммаДоходаКРаспределению = 0;
		Объект.КоличествоПаев = 0;
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
	ЭтоРПИ = (Объект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ"));
	
	Если НЕ ЭтоРПИ Тогда
		Объект.ПериодВыплатыОкончание = КонецМесяца(ДобавитьМесяц(Объект.Дата, -1));
		Объект.ПериодВыплатыНачало = НачалоКвартала(Объект.ПериодВыплатыОкончание);
		// нужна настройка?
		// У Долгосрочных облигаций выплата раз в квартал?
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммуВыплатыНаСервере()

	ОбъектДокумента = РеквизитФормыВЗначение("Объект", Тип("ДокументОбъект.РаспределениеДоходаПайщикам"));
	ОбъектДокумента.РассчитатьСуммуВыплатыИЗаполнитьРаспределениеДохода();
	ЗначениеВРеквизитФормы(ОбъектДокумента, "Объект");
	
КонецПроцедуры

&НаКлиенте
Функция ПроверкаЗаполненияРеквизитовДляРасчетаСуммыВыплаты()
	
	СписокЗаполнения = "";
    РезультатПроверки = Истина;
	Если НЕ ЗначениеЗаполнено(Объект.ПаевойИнвестиционныйФонд) Тогда 
		РезультатПроверки = Ложь;
		СписокЗаполнения = СписокЗаполнения + " Паевой инвестиционный фонд, ";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ДатаОпределенияСпискаЛиц) Тогда 
		РезультатПроверки = Ложь;
		СписокЗаполнения = СписокЗаполнения + " Дата определения списка лиц, ";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ПериодВыплатыНачало) Тогда 
		РезультатПроверки = Ложь;
		СписокЗаполнения = СписокЗаполнения + " Период выплаты начало, ";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ПериодВыплатыОкончание) Тогда 
		РезультатПроверки = Ложь;
		СписокЗаполнения = СписокЗаполнения + " Период выплаты окончание, ";
	КонецЕсли;
	
	Если Не РезультатПроверки Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проверьте заполнение реквизитов: " + Лев(СписокЗаполнения, СтрДлина(СписокЗаполнения) - 2)); 
	КонецЕсли;
		
	Возврат РезультатПроверки;
	
	
КонецФункции

&НаКлиенте
Процедура РассчитатьСуммуВыплаты(Команда)
	
	Если ПроверкаЗаполненияРеквизитовДляРасчетаСуммыВыплаты() Тогда
		РассчитатьСуммуВыплатыНаСервере();
	КонецЕсли;
	
КонецПроцедуры
