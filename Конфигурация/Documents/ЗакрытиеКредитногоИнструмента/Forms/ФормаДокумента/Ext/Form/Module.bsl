
#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ЧастичныйПриходПроцентов.ТолькоПросмотр = Не РаботаСПользователями.ЭтоПолноправныйПользователь();
	
 	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
		
	Если Не ЗначениеЗаполнено(Объект.РасчетныйСчет)
		И Не Объект.ОтложеннаяОплата
		И Не РаботаСКредитнымиИнструментами.ЭтоБиржевойДепозит(Объект.КредитныйИнструмент)
	Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Расчетный счет""",, "РасчетныйСчет",, Отказ);
	КонецЕсли;
	
	Если ЭтаФорма.ПриходПроцентов Тогда
		Если Не ЗначениеЗаполнено(Объект.СуммаПроцентов) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Сумма процентов""",, "СуммаПроцентов",, Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.НачалоПериода) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Начало периода""",, "НачалоПериода",, Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Окончание периода""",, "ОкончаниеПериода",, Отказ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	ЗаполнитьПодтверждениеОперацииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
		
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
	Оповестить("БанковкиеВыписки.Обновить");
	
	РаботаСДокументамиКлиент.ПроверитьПараметрыПодтвержденияОперации(ЭтаФорма, Объект, ПараметрыЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ИсточникВыбора) = Тип("УправляемаяФорма") И ИсточникВыбора.ИмяФормы = "Документ.СтрокаБанковскойВыписки.Форма.БанковкиеВыписки" Тогда
		
		Если      ИсточникВыбора.ИсточникВыбора = "СтрокаБанковскойВыписки" Тогда
			Объект.СтрокаБанковскойВыписки   = ВыбранноеЗначение;
			ЭтаФорма.СтрокаБанковскойВыписки = РаботаСБанковскимиВыпискамиКлиентСервер.ПолучитьПредставлениеСтрокиБанковскойВыписки(Объект.СтрокаБанковскойВыписки);
			
		ИначеЕсли ИсточникВыбора.ИсточникВыбора = "СтрокаБанковскойВыпискиПроценты" Тогда
			Объект.СтрокаБанковскойВыпискиПроценты   = ВыбранноеЗначение;
			ЭтаФорма.СтрокаБанковскойВыпискиПроценты = РаботаСБанковскимиВыпискамиКлиентСервер.ПолучитьПредставлениеСтрокиБанковскойВыписки(Объект.СтрокаБанковскойВыпискиПроценты);
			
		КонецЕсли;
		
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ПодтверждениеОперации" Тогда
		Если Параметр = Объект.Ссылка
			ИЛИ (ТипЗнч(Параметр) = Тип("Массив") И Параметр.Найти(Объект.Ссылка) <> Неопределено)
		Тогда
			ЗаполнитьПодтверждениеОперациинаСервере();
		КонецЕсли;
	Иначе		
		РаботаСДокументамиКлиент.ОбработкаОповещенияФормыДокумента(ЭтаФорма, Объект.Ссылка, ИмяСобытия, Параметр, Источник);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетныйСчетПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перед выбором расчетного счета необходимо указать счет доверительного управления.",, "Объект.СчетДоверительногоУправления");
		Объект.РасчетныйСчет = Неопределено;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.РасчетныйСчет) 
		И Не РаботаСИсполнителями.ЕстьИсполнитель("ИсполнителиПоДенежнымСредствамСобственные", 
			ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(Объект, "Дата, Организация, СчетДоверительногоУправления, РасчетныйСчет")) Тогда
				
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчетный счет [" + Объект.РасчетныйСчет + "] отсутствует в исполнителях (собственных) счета ДУ [" + Объект.СчетДоверительногоУправления + "].",, "Объект.РасчетныйСчет");	
		Объект.РасчетныйСчет = Неопределено;		
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ЭЛЕМЕНТОВ_ТАБЛИЧНОЙ_ЧАСТИ

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
	Если ЗначениеЗаполнено(Объект.КредитныйИнструмент) Тогда
		
		СчетВозвратаДенежныхСредств = РаботаСКредитнымиИнструментами.ПолучитьРасчетныйСчетВозвратаДенежныхСредств(Объект.Дата, Объект.Организация, Объект.КредитныйИнструмент);
		
		Если Объект.РасчетныйСчет <> СчетВозвратаДенежныхСредств Тогда
			Объект.РасчетныйСчет = СчетВозвратаДенежныхСредств;	
		КонецЕсли;
			
	Конецесли;
	
	Если ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) И ЗначениеЗаполнено(Объект.РасчетныйСчет)
		И Не РаботаСИсполнителями.ЕстьИсполнитель("ИсполнителиПоДенежнымСредствамСобственные", 
			ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(Объект, "Дата, Организация, СчетДоверительногоУправления, РасчетныйСчет")) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На дату [" + Объект.Дата + "] отсутствует расчетный счет [" + Объект.РасчетныйСчет + "] в исполнителях (собственных) счета ДУ [" + Объект.СчетДоверительногоУправления + "].",, "Объект.РасчетныйСчет");
		
		Объект.РасчетныйСчет = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДатаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.ДатаОбработкаВыбора(Объект, ЭтаФорма, ВыбранноеЗначение, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.СчетДоверительногоУправленияОбработкаВыбора(Объект, ЭтаФорма, ВыбранноеЗначение, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура КредитныйИнструментПриИзменении(Элемент)
	
	Если ЭтаФорма.ПриходПроцентов Тогда
		ОпределитьПериодНачисленияПроцентов();
	КонецЕсли;
	
	Объект.РасчетныйСчет = РаботаСКредитнымиИнструментами.ПолучитьРасчетныйСчетВозвратаДенежныхСредств(Объект.Дата, Объект.Организация, Объект.КредитныйИнструмент);
	
	ОчиститьСтрокиБанковскихВыписок();
	
	УстановитьЗаголовокКредитногоИнструмента(ЭтаФорма);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтложеннаяОплатаПриИзменении(Элемент)
	
	Если Объект.ОтложеннаяОплата Тогда
		ОчиститьСтрокиБанковскихВыписок();
	КонецЕсли; 	
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РежимЗакрытияПриИзменении(Элемент)
	
	Если Объект.РежимЗакрытия <> ПредопределенноеЗначение("Перечисление.РежимыЗакрытияКредитногоИнструмента.Досрочное") Тогда
		ЭтаФорма.СторнированиеПроцентов = Ложь;
		СторнированиеПроцентовПриИзменении(Неопределено);
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриходПроцентовПриИзменении(Элемент)
	
	Объект.ЧастичныйПриходПроцентов = Ложь;
	
	Если Не ЭтаФорма.ПриходПроцентов Тогда
		Объект.СуммаПроцентов  					= 0;
		Объект.НачалоПериода    				= Неопределено;
		Объект.ОкончаниеПериода 				= Неопределено;
		Объект.СтрокаБанковскойВыпискиПроценты 	= Неопределено;
		
		ЭтаФорма.СтрокаБанковскойВыпискиПроценты = РаботаСБанковскимиВыпискамиКлиентСервер.ПолучитьПредставлениеСтрокиБанковскойВыписки(Объект.СтрокаБанковскойВыпискиПроценты);
	Иначе
		ОпределитьПериодНачисленияПроцентов();
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЧастичныйПриходПроцентовПриИзменении(Элемент)
	
	ЭтаФорма.ПриходПроцентов = Ложь;
	
	Если Не Объект.ЧастичныйПриходПроцентов Тогда
		Объект.СуммаПроцентов  					= 0;
		Объект.НачалоПериода    				= Неопределено;
		Объект.ОкончаниеПериода 				= Неопределено;
		Объект.СтрокаБанковскойВыпискиПроценты 	= Неопределено;
		
		ЭтаФорма.СтрокаБанковскойВыпискиПроценты = "";
		ЭтаФорма.СтрокаБанковскойВыпискиПроценты = РаботаСБанковскимиВыпискамиКлиентСервер.ПолучитьПредставлениеСтрокиБанковскойВыписки(Объект.СтрокаБанковскойВыпискиПроценты);
	Иначе
		ОпределитьПериодНачисленияПроцентов();
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СторнированиеПроцентовПриИзменении(Элемент)
	
	Если Не ЭтаФорма.СторнированиеПроцентов Тогда
		Объект.СторнируемыеПроцентыПрошлыхПериодов = 0;
		Объект.СторнируемыеПроцентыТекущегоПериода = 0;
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаБанковскойВыпискиНажатие(Элемент, СтандартнаяОбработка)
	
	ВидДвиженияДС = ПредопределенноеЗначение("Перечисление.ВидыДвижений.Приход");
	
	Если ТипЗнч(Объект.КредитныйИнструмент) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		РеквизитыКредитногоИнструмента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.КредитныйИнструмент, Новый Структура("Контрагент, РасчетныйСчетКонтрагента", "БанковскийСчет.ЮрФизЛицо", "БанковскийСчет"));
	ИначеЕсли ТипЗнч(Объект.КредитныйИнструмент) = Тип("СправочникСсылка.Займы") Тогда
		
		ДанныеКредитногоИнструмента = РаботаСКредитнымиИнструментами.ПолучитьДанныеКредитногоИнструмента(Объект.КредитныйИнструмент, Объект.Дата);
		Если НЕ ЗначениеЗаполнено(ДанныеКредитногоИнструмента.Контрагент) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан контрагент в условиях займа", Объект.КредитныйИнструмент);
			Возврат;
		КонецЕсли;
		Если ДанныеКредитногоИнструмента.ЭтоЗаймПолученный Тогда
			ВидДвиженияДС = ПредопределенноеЗначение("Перечисление.ВидыДвижений.Расход");
		КонецЕсли;
		
		РеквизитыКредитногоИнструмента = Новый Структура("Контрагент, РасчетныйСчетКонтрагента", ДанныеКредитногоИнструмента.Контрагент, Объект.РасчетныйСчет);
	КонецЕсли;
	
	РаботаСБанковскимиВыпискамиКлиентСервер.ВыполнитьДействиеСоСтрокойБанковскойВыписки(
		Новый Структура("Период, Организация, РасчетныйСчет, ВидДвижения, Сумма, Контрагент, РасчетныйСчетКонтрагента",
			Объект.Дата,
			Объект.Организация,
			Объект.РасчетныйСчет,
			ВидДвиженияДС,
			Объект.Сумма,
			РеквизитыКредитногоИнструмента.Контрагент,
			РеквизитыКредитногоИнструмента.РасчетныйСчетКонтрагента),
		"СтрокаБанковскойВыписки",
		ЭтаФорма,
		СтандартнаяОбработка);
		
КонецПроцедуры
	
&НаКлиенте
Процедура СтрокаБанковскойВыпискиПроцентыНажатие(Элемент, СтандартнаяОбработка)
	
	ВидДвиженияДС = ПредопределенноеЗначение("Перечисление.ВидыДвижений.Приход");
	
	Если ТипЗнч(Объект.КредитныйИнструмент) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		РеквизитыКредитногоИнструмента =  ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.КредитныйИнструмент, Новый Структура("Контрагент", "БанковскийСчет.Банк.ЮрФизЛицо"));
	ИначеЕсли ТипЗнч(Объект.КредитныйИнструмент) = Тип("СправочникСсылка.Займы") Тогда
		
		ДанныеКредитногоИнструмента = РаботаСКредитнымиИнструментами.ПолучитьДанныеКредитногоИнструмента(Объект.КредитныйИнструмент, Объект.Дата);
		Если НЕ ЗначениеЗаполнено(ДанныеКредитногоИнструмента.Контрагент) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан контрагент в условиях займа", Объект.КредитныйИнструмент);
			Возврат;
		КонецЕсли;
		Если ДанныеКредитногоИнструмента.ЭтоЗаймПолученный Тогда
			ВидДвиженияДС = ПредопределенноеЗначение("Перечисление.ВидыДвижений.Расход");
		КонецЕсли;
		
		РеквизитыКредитногоИнструмента = Новый Структура("Контрагент", ДанныеКредитногоИнструмента.Контрагент);
	КонецЕсли;
	
	РаботаСБанковскимиВыпискамиКлиентСервер.ВыполнитьДействиеСоСтрокойБанковскойВыписки(
		Новый Структура("Период, Организация, РасчетныйСчет, ВидДвижения, Сумма, Контрагент",
			Объект.Дата,
			Объект.Организация,
			Объект.РасчетныйСчет,
			ВидДвиженияДС,
			Объект.СуммаПроцентов,
			РеквизитыКредитногоИнструмента.Контрагент),
		"СтрокаБанковскойВыпискиПроценты",
		ЭтаФорма,
		СтандартнаяОбработка);
		
КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_КОМАНД

&НаКлиенте
Процедура КомандаВыбратьИсполнителяПоДенежнымСредствам(Команда)
	
	РаботаСДокументамиКлиент.ВыбратьИсполнителяПоДенежнымСредствам(ЭтаФорма, Ложь);

КонецПроцедуры

#КонецОбласти 

#Область СЛУЖЕБНЫЕ_ПРОЦЕДУРЫ_И_ФУНКЦИИ

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
			
	ЭтаФорма.УстановитьПараметрыФункциональныхОпцийФормы(Новый Структура("Организация", Объект.Организация));

	ЭтаФорма.СтрокаБанковскойВыписки         = РаботаСБанковскимиВыпискамиКлиентСервер.ПолучитьПредставлениеСтрокиБанковскойВыписки(Объект.СтрокаБанковскойВыписки);
	ЭтаФорма.СтрокаБанковскойВыпискиПроценты = РаботаСБанковскимиВыпискамиКлиентСервер.ПолучитьПредставлениеСтрокиБанковскойВыписки(Объект.СтрокаБанковскойВыпискиПроценты);
	
	ЭтаФорма.ПриходПроцентов        = (Объект.СуммаПроцентов > 0) И Не Объект.ЧастичныйПриходПроцентов;
	ЭтаФорма.СторнированиеПроцентов = (Объект.СторнируемыеПроцентыПрошлыхПериодов > 0) Или (Объект.СторнируемыеПроцентыТекущегоПериода > 0);
		
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	УстановитьЗаголовокКредитногоИнструмента(ЭтаФорма);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОпределитьПериодНачисленияПроцентов()
	
	ПериодНачисленияПроцентов = РаботаСКредитнымиИнструментами.ПолучитьПериодНачисленияПроцентов(
	ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(Объект, "Ссылка, Дата, КредитныйИнструмент, Организация, СчетДоверительногоУправления"));
	
	Если Не ЗначениеЗаполнено(ПериодНачисленияПроцентов.ОкончаниеПериода) Тогда
		ПериодНачисленияПроцентов.ОкончаниеПериода = НачалоДня(Объект.Дата);
	КонецЕсли;  
	
	Если Не ЗначениеЗаполнено(Объект.НачалоПериода) И Не ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		ЗаполнитьЗначенияСвойств(Объект, ПериодНачисленияПроцентов);
		
	ИначеЕсли (Объект.НачалоПериода <> ПериодНачисленияПроцентов.НачалоПериода) или (Объект.ОкончаниеПериода) <> (ПериодНачисленияПроцентов.ОкончаниеПериода) Тогда
		
		ТекстВопроса = "";
		
		Если Объект.НачалоПериода <> ПериодНачисленияПроцентов.НачалоПериода Тогда
			ТекстВопроса = "Заполнить начало периода начисления процентов датой " + Формат(ПериодНачисленияПроцентов.НачалоПериода, "ДФ=dd.MM.yyyy") + "?";
		КонецЕсли;
		
		Если Объект.ОкончаниеПериода <> ПериодНачисленияПроцентов.ОкончаниеПериода Тогда
			ТекстВопроса = ТекстВопроса + "  Дата окончания периода будет заполнена датой документа.";
		КонецЕсли;
		
		Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			ЗаполнитьЗначенияСвойств(Объект, ПериодНачисленияПроцентов);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
	ЭтоБиржевойДепозит = РаботаСКредитнымиИнструментами.ЭтоБиржевойДепозит(Объект.КредитныйИнструмент);
	
	Элементы.СторнированиеПроцентов.Видимость = (Объект.РежимЗакрытия = ПредопределенноеЗначение("Перечисление.РежимыЗакрытияКредитногоИнструмента.Досрочное"));
	
	Элементы.ГруппаПриходПроцентов.Видимость      = (Форма.ПриходПроцентов Или Объект.ЧастичныйПриходПроцентов);
	Элементы.ГруппаСторнируемыеПроценты.Видимость = Форма.СторнированиеПроцентов;
	
	Элементы.ДекорацияАкцептовано.Видимость = (ЗначениеЗаполнено(Объект.Ссылка) И РаботаСДокументами.ДокументАкцептован(Объект.Ссылка, Объект.Организация));
	
	Элементы.РасчетныйСчет.Видимость	= ТипЗнч(Объект.КредитныйИнструмент) <> Тип("СправочникСсылка.ДепозитныеВклады") ИЛИ Не ЭтоБиржевойДепозит;
	Элементы.РасчетныйСчет.Доступность	= Не РаботаСКредитнымиИнструментами.НеобходимоЗаполнениеЗначенияРасчетногоСчетаВозвратаДенежныхСредств(Объект.Организация, Объект.КредитныйИнструмент);
	
	Элементы.КомандаВыбратьИсполнителяПоДенежнымСредствам.Видимость = Элементы.РасчетныйСчет.Видимость;
	
	Элементы.СтрокаБанковскойВыписки.Видимость 			= Не Объект.ОтложеннаяОплата И Не ЭтоБиржевойДепозит;
	Элементы.СтрокаБанковскойВыпискиПроценты.Видимость 	= Не Объект.ОтложеннаяОплата И Не ЭтоБиржевойДепозит;

КонецПроцедуры

&НаКлиенте
Процедура ПровестиПоБухгалтерскомуУчету()

	РаботаСФормамиКлиент.ПровестиПоБухгалтерскомуУчету(ЭтаФорма); 

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодтверждениеОперацииНаСервере()
	РаботаСДокументами.ЗаполнитьПодтверждениеОперации(ЭтаФорма, Объект.Ссылка);		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокКредитногоИнструмента(ЭтаФорма)
	
	Если ТипЗнч(ЭтаФорма.Объект.КредитныйИнструмент) = Тип("СправочникСсылка.Займы") Тогда
		ЭтаФорма.Элементы.КредитныйИнструмент.Заголовок = "Займ"
	Иначе
		ЭтаФорма.Элементы.КредитныйИнструмент.Заголовок = "Депозитный вклад"
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСтрокиБанковскихВыписок()
	
	Объект.СтрокаБанковскойВыписки			= Неопределено;
	Объект.СтрокаБанковскойВыпискиПроценты	= Неопределено;
	
	ЭтаФорма.СтрокаБанковскойВыписки         = РаботаСБанковскимиВыпискамиКлиентСервер.ПолучитьПредставлениеСтрокиБанковскойВыписки(Объект.СтрокаБанковскойВыписки);
	ЭтаФорма.СтрокаБанковскойВыпискиПроценты = РаботаСБанковскимиВыпискамиКлиентСервер.ПолучитьПредставлениеСтрокиБанковскойВыписки(Объект.СтрокаБанковскойВыпискиПроценты);
	
КонецПроцедуры

#КонецОбласти
