
#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
	// заполнять депозитный вклад из данных заполнения имеет смысл только при частичном закрытии
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") И ДанныеЗаполнения.Свойство("КредитныйИнструмент") И ЗначениеЗаполнено(ДанныеЗаполнения.КредитныйИнструмент) Тогда
		Если ДанныеЗаполнения.Свойство("РежимЗакрытия") Тогда
			ДанныеЗаполнения.РежимЗакрытия = Перечисления.РежимыЗакрытияКредитногоИнструмента.Частичное;
		Иначе
			ДанныеЗаполнения.Вставить("РежимЗакрытия", Перечисления.РежимыЗакрытияКредитногоИнструмента.Частичное);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "НачалоПериода, ОкончаниеПериода, СтрокаБанковскойВыписки, СтрокаБанковскойВыпискиПроценты");
	
	Если ЭтотОбъект.РежимЗакрытия <> Перечисления.РежимыЗакрытияКредитногоИнструмента.Частичное Тогда
		ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "КредитныйИнструмент, Сумма, СуммаПроцентов");
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтотОбъект.СуммаПроцентов <> 0 Тогда
		ПроверяемыеРеквизиты.Добавить("НачалоПериода");
		ПроверяемыеРеквизиты.Добавить("ОкончаниеПериода");
	КонецЕсли;
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		ЭтоДепозитныйВклад = ТипЗнч(ЭтотОбъект.КредитныйИнструмент) = Тип("СправочникСсылка.ДепозитныеВклады");
		
		Если ЗначениеЗаполнено(ЭтотОбъект.РасчетныйСчет) Тогда
			
			Если ЭтоДепозитныйВклад И ЭтотОбъект.РасчетныйСчет.Валюта <> ЭтотОбъект.КредитныйИнструмент.БанковскийСчет.Валюта Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Валюта р/счета " + ЭтотОбъект.РасчетныйСчет + " не совпадает с валютой банковского счета " + ЭтотОбъект.КредитныйИнструмент.БанковскийСчет + " депозитного вклада " + ЭтотОбъект.КредитныйИнструмент, ЭтотОбъект, "ДепозитныйВклад",, Отказ);
			КонецЕсли;
			
			Если РаботаСКредитнымиИнструментами.НеобходимоЗаполнениеЗначенияРасчетногоСчетаВозвратаДенежныхСредств(ЭтотОбъект.Организация, ЭтотОбъект.КредитныйИнструмент) Тогда
				
				СчетВозвратаДенежныхСредств = РаботаСКредитнымиИнструментами.ПолучитьРасчетныйСчетВозвратаДенежныхСредств(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.КредитныйИнструмент);
				
				Если ЭтотОбъект.РасчетныйСчет <> СчетВозвратаДенежныхСредств Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчетный счет [" + ЭтотОбъект.РасчетныйСчет + "] не совпадает со счетом возврата денежных средств [" + СчетВозвратаДенежныхСредств + "] в условиях кредитного инструмента.", ЭтотОбъект, "РасчетныйСчет",, Отказ);	
				КонецЕсли;
				
			Иначе
			
				Если Не РаботаСИсполнителями.ЕстьИсполнитель("ИсполнителиПоДенежнымСредствамСобственные", ЭтотОбъект) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчетный счет [" + ЭтотОбъект.РасчетныйСчет + "] отсутствует в исполнителях (собственных) счета ДУ [" + ЭтотОбъект.СчетДоверительногоУправления + "].", ЭтотОбъект, "РасчетныйСчет",, Отказ);		
				КонецЕсли;
				
			Конецесли;
				
		ИначеЕсли ЭтотОбъект.ОтложеннаяОплата = Ложь И Не РаботаСКредитнымиИнструментами.ЭтоБиржевойДепозит(ЭтотОбъект.КредитныйИнструмент) Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран расчетный счет и не установлен признак Отложенной оплаты.", ЭтотОбъект, "РасчетныйСчет",, Отказ);
			
		КонецЕсли;

		// одновременное сторнирование и получение процентов по депозиту не поддерживается
		Если ЭтотОбъект.СуммаПроцентов > 0 И (ЭтотОбъект.СторнируемыеПроцентыПрошлыхПериодов > 0 Или ЭтотОбъект.СторнируемыеПроцентыТекущегоПериода > 0) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Одновременный приход и сторнирование процентов не поддерживается", ЭтотОбъект, "СуммаПроцентов",, Отказ);
		КонецЕсли;
		
		// даты периода начисления %
		Если ЭтотОбъект.СуммаПроцентов <> 0 Тогда
			Если ЭтотОбъект.НачалоПериода > ЭтотОбъект.ОкончаниеПериода Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата начала периода начисления процентов " + Формат(ЭтотОбъект.НачалоПериода, "ДФ=dd.MM.yyyy") + " больше даты окончания " + Формат(ЭтотОбъект.ОкончаниеПериода, "ДФ=dd.MM.yyyy"), ЭтотОбъект, "НачалоПериода",, Отказ);
			КонецЕсли;
		КонецЕсли;
		
		РаботаСКредитнымиИнструментами.ПроверитьУникальностьПериодаНачисленияПроцентов(ЭтотОбъект, Отказ);
		
		// получим данные депозитного вклада и проверим их корректность
		ДанныеКредитногоИнструмента = РаботаСКредитнымиИнструментами.ПолучитьНоминалИДатуПогашенияКредитногоИнструмента(ЭтотОбъект, ЭтотОбъект.Дата);
		
		// контроль сроков
		Если ЭтоДепозитныйВклад И ЭтотОбъект.КредитныйИнструмент.ДоВостребования 
			И ЭтотОбъект.РежимЗакрытия <> Перечисления.РежимыЗакрытияКредитногоИнструмента.Полное 
			И НЕ ЗначениеЗаполнено(ДанныеКредитногоИнструмента.ДатаПогашения)
		Тогда			
			//Для депозитов "до востребования" дата погашения не контролируется
		ИначеЕсли ДанныеКредитногоИнструмента.ДатаПогашения = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У " + ?(ЭтоДепозитныйВклад, "депозитного вклада", "займа") + " " + ЭтотОбъект.КредитныйИнструмент + " не указана дата погашения", ЭтотОбъект, "КредитныйИнструмент",, Отказ);
		Иначе
			Если     ЭтотОбъект.РежимЗакрытия = Перечисления.РежимыЗакрытияКредитногоИнструмента.Полное Тогда
				Если НачалоДня(ЭтотОбъект.Дата) <> ДанныеКредитногоИнструмента.ДатаПогашения Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата документа " + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy") + " не должна отличаться от даты погашения " + Формат(ДанныеКредитногоИнструмента.ДатаПогашения, "ДФ=dd.MM.yyyy") + " "+?(ЭтоДепозитныйВклад, "депозитного вклада", "займа")+" " + ЭтотОбъект.КредитныйИнструмент, ЭтотОбъект, "Дата",, Отказ);
				КонецЕсли; 
				Если ЗначениеЗаполнено(ЭтотОбъект.ОкончаниеПериода) И (ЭтотОбъект.ОкончаниеПериода <> ДанныеКредитногоИнструмента.ДатаПогашения) Тогда 
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата окончания интервала, за который начисляются проценты " + Формат(ЭтотОбъект.ОкончаниеПериода, "ДФ=dd.MM.yyyy") + ", должна совпадать с датой погашения " + Формат(ДанныеКредитногоИнструмента.ДатаПогашения, "ДФ=dd.MM.yyyy") + " депозитного вклада", ЭтотОбъект, "ОкончаниеПериода",, Отказ);
				КонецЕсли;
				
			ИначеЕсли ЭтотОбъект.РежимЗакрытия = Перечисления.РежимыЗакрытияКредитногоИнструмента.Частичное Тогда
				Если ДанныеКредитногоИнструмента.ДатаПогашения < НачалоДня(ЭтотОбъект.Дата) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата документа " + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy") + " не может быть больше даты погашения " + Формат(ДанныеКредитногоИнструмента.ДатаПогашения, "ДФ=dd.MM.yyyy") + " " + ?(ЭтоДепозитныйВклад, "депозитного вклада", "займа"), ЭтотОбъект, "Дата",, Отказ);
				КонецЕсли; 
				
			КонецЕсли;		
			
		КонецЕсли;

		// контроль сумм
		Если      ЭтотОбъект.РежимЗакрытия = Перечисления.РежимыЗакрытияКредитногоИнструмента.Полное Тогда
			Если ЭтотОбъект.Сумма <> ДанныеКредитногоИнструмента.ТекущийНоминал Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сумма " + ЭтотОбъект.Сумма + " при полном закрытии "+?(ЭтоДепозитныйВклад, "депозитного вклада", "займа")+" " + ЭтотОбъект.КредитныйИнструмент + " не совпадает с текущим номиналом " + ДанныеКредитногоИнструмента.ТекущийНоминал, ЭтотОбъект, "Сумма",, Отказ);
			КонецЕсли;
		ИначеЕсли ЭтотОбъект.РежимЗакрытия = Перечисления.РежимыЗакрытияКредитногоИнструмента.Частичное Тогда
			Если ЭтотОбъект.Сумма >= ДанныеКредитногоИнструмента.ТекущийНоминал Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сумма " + ЭтотОбъект.Сумма + " при частичном закрытии "+?(ЭтоДепозитныйВклад, "депозитного вклада", "займа")+" " + ЭтотОбъект.КредитныйИнструмент + " должна быть меньше суммы текущего номинала " + ДанныеКредитногоИнструмента.ТекущийНоминал, ЭтотОбъект, "Сумма",, Отказ);
			КонецЕсли;
		ИначеЕсли ЭтотОбъект.РежимЗакрытия = Перечисления.РежимыЗакрытияКредитногоИнструмента.Досрочное Тогда
			Если ЭтотОбъект.Сумма > ДанныеКредитногоИнструмента.ТекущийНоминал Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сумма " + ЭтотОбъект.Сумма + " при досрочном закрытии "+?(ЭтоДепозитныйВклад, "депозитного вклада", "займа")+" " + ЭтотОбъект.КредитныйИнструмент + " не должна превышать сумму текущего номинала " + ДанныеКредитногоИнструмента.ТекущийНоминал, ЭтотОбъект, "Сумма",, Отказ);
			КонецЕсли;
		КонецЕсли;
		
		// на текущий момент сторнируемые суммы процентов допустимы только при досрочном закрытии
		Если ЭтотОбъект.РежимЗакрытия <> Перечисления.РежимыЗакрытияКредитногоИнструмента.Досрочное
			И (ЭтотОбъект.СторнируемыеПроцентыПрошлыхПериодов <> 0 Или ЭтотОбъект.СторнируемыеПроцентыТекущегоПериода <> 0)
		Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сторнирование процентов допустимо только при досрочном закрытии "+?(ЭтоДепозитныйВклад, "депозитного вклада", "займа"), ЭтотОбъект, "РежимЗакрытия",, Отказ);
		КонецЕсли;
		
		ВидДвиженияДС = Перечисления.ВидыДвижений.Приход;
		Если Не ЭтоДепозитныйВклад И ЭтотОбъект.КредитныйИнструмент.ВидКредитногоИнструмента = Перечисления.ВидыКредитныхИнструментов.Полученный Тогда
			ВидДвиженияДС = Перечисления.ВидыДвижений.Расход;
		КонецЕсли;
		
		РаботаСБанковскимиВыпискамиКлиентСервер.ПроверитьСоответствиеСтрокиБанковскойВыпискиИПлатежногоДокумента(ЭтотОбъект,
			ЭтотОбъект.СтрокаБанковскойВыписки, ВидДвиженияДС, Отказ);
		
		РаботаСБанковскимиВыпискамиКлиентСервер.ПроверитьСоответствиеСтрокиБанковскойВыпискиИПлатежногоДокумента(ЭтотОбъект,
			ЭтотОбъект.СтрокаБанковскойВыпискиПроценты, ВидДвиженияДС, Отказ);
			
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
	Если ТипЗнч(ЭтотОбъект.КредитныйИнструмент) = Тип("СправочникСсылка.ДепозитныеВклады") 
		И ОбщегоНазначения.ЗначениеПараметраСеанса("ФормированиеДвиженийПоРегистрамБэкОфиса")
	Тогда
		УстановитьДатуЗакрытияБанковскогоСчета(ЭтотОбъект.Дата, Отказ);	
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Если ТипЗнч(ЭтотОбъект.КредитныйИнструмент) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
	
		УстановитьДатуЗакрытияБанковскогоСчета(Дата(1,1,1), Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Процедура УстановитьБлокировки()

	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах");
	ЭлементБлокировкиДанных.УстановитьЗначение("КредитныйИнструмент",         	ЭтотОбъект.КредитныйИнструмент);
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                 	ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);

	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.ПроцентыПоКредитнымИнструментам");
	ЭлементБлокировкиДанных.УстановитьЗначение("КредитныйИнструмент", 			ЭтотОбъект.КредитныйИнструмент);
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.УсловияКредитныхИнструментов");
	ЭлементБлокировкиДанных.УстановитьЗначение("КредитныйИнструмент", 			ЭтотОбъект.КредитныйИнструмент);
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.РезервыПредстоящихРасходов");
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                 	ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("СубъектАналитики",            	ЭтотОбъект.КредитныйИнструмент);
	
	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры // УстановитьБлокировки

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	// Новая схема проведения
	
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.ДенежныеСредстваВКредитныхИнструментах.Записывать         	= Истина;
	Движения.ОстаткиДенежныхСредств.Записывать                        	= Истина;
	Движения.ПроцентыПоКредитнымИнструментам.Записывать 				= Истина;
	Движения.ЗадолженностиПоДенежнымСредствам.Записывать 				= Истина;
	Движения.НоминалыКредитныхИнструментов.Записывать					= Истина;
	Движения.РезервыПредстоящихРасходов.Записывать						= Истина;
	
	#Область Данные_кредитного_инструмента
	
	ДанныеКредитногоИнструмента = РаботаСКредитнымиИнструментами.ПолучитьДанныеКредитногоИнструмента(ЭтотОбъект.КредитныйИнструмент, ЭтотОбъект.Дата);
	
	ЭтоДепозитныйВклад = ТипЗнч(ЭтотОбъект.КредитныйИнструмент) = Тип("СправочникСсылка.ДепозитныеВклады");

	Если ЭтоДепозитныйВклад Тогда
		
		РеквизитыКредитногоИнструмента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.КредитныйИнструмент,
			Новый Структура("МестоХранения, Валюта", "МестоХранения", "БанковскийСчет.Валюта"));
			
		Если Не ЗначениеЗаполнено(РеквизитыКредитногоИнструмента.МестоХранения) Тогда
			РеквизитыКредитногоИнструмента.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок;	
		КонецЕсли;
		
	Иначе
		
		РеквизитыКредитногоИнструмента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.КредитныйИнструмент,
			Новый Структура("Валюта", "Валюта"));
			
		ДанныеКредитногоИнструмента.Вставить("МестоХранения", Справочники.МестаХранения.ВнебиржевойРынок);	
			
	КонецЕсли;
	
	РаботаСКоллекциями.ДополнитьСтруктуру(ДанныеКредитногоИнструмента, РеквизитыКредитногоИнструмента);
	
	#КонецОбласти
	
	Валюта = ?(ЗначениеЗаполнено(ЭтотОбъект.РасчетныйСчет), ЭтотОбъект.РасчетныйСчет.Валюта, ДанныеКредитногоИнструмента.Валюта);
	
	Если ЭтоДепозитныйВклад Тогда
		
		ВидДвижения							= Перечисления.ВидыДвижений.Приход;
		ВидДвиженияДенежныхСредствНоминал	= Перечисления.ВидыДвиженийДенежныхСредств.ЗакрытиеДепозитногоВклада;
		ВидДвиженияДенежныхСредствПроценты	= Перечисления.ВидыДвиженийДенежныхСредств.ПриходПроцентовПоДепозитномуВкладу;
		
	ИначеЕсли ДанныеКредитногоИнструмента.ЭтоЗаймПолученный Тогда
		
		ВидДвижения							= Перечисления.ВидыДвижений.Расход;
		ВидДвиженияДенежныхСредствНоминал	= Перечисления.ВидыДвиженийДенежныхСредств.ПогашениеЗаймаПолученного;
		ВидДвиженияДенежныхСредствПроценты	= Перечисления.ВидыДвиженийДенежныхСредств.ВыплатаПроцентовПоЗаймуПолученному;
		
	Иначе
		
		ВидДвижения							= Перечисления.ВидыДвижений.Приход;
		ВидДвиженияДенежныхСредствНоминал	= Перечисления.ВидыДвиженийДенежныхСредств.ПогашениеЗаймаВыданного;
		ВидДвиженияДенежныхСредствПроценты	= Перечисления.ВидыДвиженийДенежныхСредств.ПриходПроцентовПоЗаймуВыданному;
		
	КонецЕсли;
	
	// д/с в кредитных инструментах
	
	Движение = Движения.ДенежныеСредстваВКредитныхИнструментах.ДобавитьРасход();
	Движение.Период 					  = ЭтотОбъект.Дата;
	Движение.Организация 				  = ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
	Движение.КредитныйИнструмент		  = ЭтотОбъект.КредитныйИнструмент;
	Движение.ВидКредитногоИнструмента	  = ДанныеКредитногоИнструмента.ВидКредитногоИнструмента;
	Движение.ТипКредитногоИнструмента	  = РаботаСКредитнымиИнструментами.ПолучитьТипКредитногоИнструмента(ЭтотОбъект.КредитныйИнструмент);	
	
	Если ЭтотОбъект.РежимЗакрытия = Перечисления.РежимыЗакрытияКредитногоИнструмента.Досрочное Тогда // списываем полный объем ср-в
		Движение.Сумма = РаботаСКредитнымиИнструментами.ПолучитьНоминалИДатуПогашенияКредитногоИнструмента(ЭтотОбъект).ТекущийНоминал;
	Иначе
		Движение.Сумма = ЭтотОбъект.Сумма;
	КонецЕсли;
	
	// Тело
	
	Если ОтложеннаяОплата Тогда
		
		Движение = Движения.ЗадолженностиПоДенежнымСредствам.Добавить();
		Движение.Период                       = ЭтотОбъект.Дата;
		Движение.Основание                    = ЭтотОбъект.Ссылка;
		Движение.ТипЗадолженности             = ?(ДанныеКредитногоИнструмента.ЭтоЗаймПолученный, Перечисления.ТипыЗадолженности.Кредиторская, Перечисления.ТипыЗадолженности.Дебиторская);
		Движение.ВидЗадолженности             = ?(ЭтоДепозитныйВклад, Справочники.ВидыЗадолженности.ПоДепозитномуВкладу, Справочники.ВидыЗадолженности.ПоЗайму);
		Движение.Контрагент                   = ДанныеКредитногоИнструмента.Контрагент;
		Движение.Валюта 				  	  = Валюта;			
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Сумма                        = ЭтотОбъект.Сумма;
		
	Иначе	
		
		Движение = Движения.ОстаткиДенежныхСредств.Добавить();
		Движение.ВидДвижения				  = ?(ВидДвижения = Перечисления.ВидыДвижений.Расход, ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход);
		Движение.Период				 		  = ЭтотОбъект.Дата;
		Движение.Организация				  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.МестоХранения                = ДанныеКредитногоИнструмента.МестоХранения;
		Движение.РасчетныйСчет                = ЭтотОбъект.РасчетныйСчет;
		Движение.Валюта						  = Валюта;
		Движение.Сумма						  = ЭтотОбъект.Сумма;
		Движение.ВидДвиженияДенежныхСредств   = ВидДвиженияДенежныхСредствНоминал;
		
	КонецЕсли; 
	
	// Проценты
	
	Если ЭтотОбъект.СуммаПроцентов > 0 Тогда
		
		Если ОтложеннаяОплата Тогда
			
			Движение = Движения.ЗадолженностиПоДенежнымСредствам.Добавить();
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Основание                    = ЭтотОбъект.Ссылка;
			Движение.ТипЗадолженности             = ?(ДанныеКредитногоИнструмента.ЭтоЗаймПолученный, Перечисления.ТипыЗадолженности.Кредиторская, Перечисления.ТипыЗадолженности.Дебиторская);
			Движение.ВидЗадолженности             = ?(ЭтоДепозитныйВклад, Справочники.ВидыЗадолженности.ПоДепозитномуВкладуПроценты, Справочники.ВидыЗадолженности.ПоЗаймуПроценты);
			Движение.Контрагент                   = ДанныеКредитногоИнструмента.Контрагент;
			Движение.Валюта                       = Валюта;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Сумма                        = ЭтотОбъект.СуммаПроцентов;
			
		Иначе
			
			Движение = Движения.ОстаткиДенежныхСредств.Добавить();
			Движение.ВидДвижения				  = ?(ВидДвижения = Перечисления.ВидыДвижений.Расход, ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход);
			Движение.Период				 		  = ЭтотОбъект.Дата;
			Движение.Организация				  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.МестоХранения	              = ДанныеКредитногоИнструмента.МестоХранения;
			Движение.РасчетныйСчет 				  = ЭтотОбъект.РасчетныйСчет;
			Движение.Валюта						  = Валюта;
			Движение.Сумма						  = ЭтотОбъект.СуммаПроцентов;
			Движение.ВидДвиженияДенежныхСредств   = ВидДвиженияДенежныхСредствПроценты;
			
		КонецЕсли;
		
		Движение = Движения.ПроцентыПоКредитнымИнструментам.Добавить();
		Движение.Период						  = ЭтотОбъект.Дата;
		Движение.Организация				  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.КредитныйИнструмент	 	  = ЭтотОбъект.КредитныйИнструмент;
		Движение.НачалоПериода			   	  = ЭтотОбъект.НачалоПериода;
		Движение.ОкончаниеПериода			  = ЭтотОбъект.ОкончаниеПериода;
		Движение.Частичный                    = ЭтотОбъект.ЧастичныйПриходПроцентов;
		Движение.Сумма						  = ЭтотОбъект.СуммаПроцентов;
		
	ИначеЕсли ЭтотОбъект.СторнируемыеПроцентыПрошлыхПериодов > 0 Или ЭтотОбъект.СторнируемыеПроцентыТекущегоПериода > 0 Тогда
		
		Движение = Движения.ПроцентыПоКредитнымИнструментам.Добавить();
		Движение.Период						  = ЭтотОбъект.Дата;
		Движение.Организация				  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.КредитныйИнструмент 		  = ЭтотОбъект.КредитныйИнструмент;
		Движение.НачалоПериода			   	  = ЭтотОбъект.КредитныйИнструмент.ДатаНачалаНачисленияПроцентов;
		Движение.ОкончаниеПериода			  = ЭтотОбъект.Дата;
		Движение.Сумма						  = -(ЭтотОбъект.СторнируемыеПроцентыПрошлыхПериодов + ЭтотОбъект.СторнируемыеПроцентыТекущегоПериода);
		
	КонецЕсли;

	// Резервы
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РезервыПредстоящихРасходовОстатки.Резерв КАК БалансовыйРезерв,
		|	РезервыПредстоящихРасходовОстатки.СуммаОстаток КАК БалансоваяСумма
		|ИЗ
		|	РегистрНакопления.РезервыПредстоящихРасходов.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И СубъектАналитики = &СубъектАналитики) КАК РезервыПредстоящихРасходовОстатки");
		
	Запрос.УстановитьПараметр("Период",							Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СубъектАналитики", 				ЭтотОбъект.КредитныйИнструмент);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Количество() > 1 Тогда
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("По субъекту '%1' начислены различные резервы", ЭтотОбъект.КредитныйИнструмент), , , , Отказ);
	
	ИначеЕсли ВыборкаДетальныеЗаписи.Следующий() Тогда
	
		Движение = Движения.РезервыПредстоящихРасходов.ДобавитьРасход();
		Движение.Период							= ЭтотОбъект.Дата;
		Движение.Организация					= ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления	= ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Резерв							= ВыборкаДетальныеЗаписи.БалансовыйРезерв;
		Движение.СубъектАналитики				= ЭтотОбъект.КредитныйИнструмент;
		Движение.Сумма							= ВыборкаДетальныеЗаписи.БалансоваяСумма;
		Движение.Валюта							= ЭтотОбъект.Организация.ВалютаУчета;
		
	КонецЕсли;
	
	Движения.Записать();
	
	// Реестр платежей
	
	СтрокиБанковскойВыписки = Новый Массив();
	
	СтрокиБанковскойВыписки.Добавить(
		РегистрыСведений.РеестрПлатежей.СкомпоноватьСведенияОСтрокеБанковскойВыписки(
			ЭтотОбъект.СтрокаБанковскойВыписки, ВидДвижения, ЭтотОбъект.Сумма, ВидДвиженияДенежныхСредствНоминал));
			
	СтрокиБанковскойВыписки.Добавить(
		РегистрыСведений.РеестрПлатежей.СкомпоноватьСведенияОСтрокеБанковскойВыписки(
			ЭтотОбъект.СтрокаБанковскойВыпискиПроценты, ВидДвижения, ЭтотОбъект.СуммаПроцентов, ВидДвиженияДенежныхСредствПроценты));
				
	РегистрыСведений.РеестрПлатежей.ЗарегистрироватьПлатеж(ЭтотОбъект, СтрокиБанковскойВыписки);
	
	// Номиналы кредитных инструментов

	РегистрыСведений.НоминалыКредитныхИнструментов.УстановитьНоминалКредитногоИнструмента(ЭтотОбъект);
	
КонецПроцедуры

Функция ПолучитьНачисленныеПроцентыПоДепозитуЕПС(Организация, СчетДоверительногоУправления, ДепозитныйВклад, Дата)

	Результат = Новый Структура("НачисленоПроцентов, СуммаДоходовБудущихПериодов", 0, 0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.СуммаОстатокДт КАК НачисленоПроцентов,
		|	БухгалтерскийУчетДоходыБудущихПериодов.СуммаОстатокКт КАК СуммаДоходовБудущихПериодов
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты03),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.УсловияЗаймовКредитовИДепозитов),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1 = &ДепозитныйВклад) КАК БухгалтерскийУчетОстатки,
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты13),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.УсловияЗаймовКредитовИДепозитов),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1 = &ДепозитныйВклад) КАК БухгалтерскийУчетДоходыБудущихПериодов";

	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("Период",                       Дата);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДепозитныйВклад",			  ДепозитныйВклад);

	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Результат.НачисленоПроцентов			= ВыборкаДетальныеЗаписи.НачисленоПроцентов;
		Результат.СуммаДоходовБудущихПериодов	= ВыборкаДетальныеЗаписи.СуммаДоходовБудущихПериодов;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ПолучитьРасчетныеПоказателиДепозитаЕПС(ДепозитныйВклад, Дата)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасчетныеПоказателиДепозитногоВкладаСрезПоследних.ЭффективнаяСтавкаПроцента КАК ЭффективнаяСтавкаПроцента,
		|	РасчетныеПоказателиДепозитногоВкладаСрезПоследних.ИспользоватьЭффективнуюПроцентнуюСтавку КАК ИспользоватьЭффективнуюПроцентнуюСтавку,
		|	РасчетныеПоказателиДепозитногоВкладаСрезПоследних.СтоимостьПоЭффективнойПроцентнойСтавке КАК СтоимостьПоЭффективнойПроцентнойСтавке
		|ИЗ
		|	РегистрСведений.РасчетныеПоказателиДепозитногоВклада.СрезПоследних(
		|			&Период,
		|			ДепозитныйВклад = &ДепозитныйВклад
		|				И ЦельРасчета = &ЦельРасчета) КАК РасчетныеПоказателиДепозитногоВкладаСрезПоследних";
	
	Запрос.УстановитьПараметр("ДепозитныйВклад", ДепозитныйВклад);
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("ЦельРасчета", Справочники.ЦелиРасчета.ЕдиныйПланСчетов);		
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Возврат Новый Структура("ЭффективнаяСтавкаПроцента, ИспользоватьЭффективнуюПроцентнуюСтавку, СтоимостьПоЭффективнойПроцентнойСтавке, ТребуетсяРасчетСтоимостиВкладаПоЭСП",
					ВыборкаДетальныеЗаписи.ЭффективнаяСтавкаПроцента,
					ВыборкаДетальныеЗаписи.ИспользоватьЭффективнуюПроцентнуюСтавку,
					ВыборкаДетальныеЗаписи.СтоимостьПоЭффективнойПроцентнойСтавке,
					Истина);
		
	Иначе
					
		Возврат Новый Структура("ЭффективнаяСтавкаПроцента, ИспользоватьЭффективнуюПроцентнуюСтавку, СтоимостьПоЭффективнойПроцентнойСтавке, ТребуетсяРасчетСтоимостиВкладаПоЭСП",
					0,
					Истина,
					0,
					Ложь);
		
	КонецЕсли;

КонецФункции 

Процедура ПроведениеПоРегиструЕПСДосрочноеЗакрытие(УчетныйРегистр, Отказ)

	УчетныйАктив = Справочники.ДепозитныеВклады.ОпределитьУчетныйАктивДепозита(ЭтотОбъект.КредитныйИнструмент, ЭтотОбъект.Дата);
	
	СчетРасчетный	= ЭтотОбъект.РасчетныйСчет;
	СчетДепозитный	= ЭтотОбъект.КредитныйИнструмент.БанковскийСчет;
	
	БанкРасчетный	= СчетРасчетный.Банк;
	БанкДепозитный	= СчетДепозитный.Банк;
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);
		
	НастройкиУчетаАктива = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		УчетныйАктив,
		УчетныйРегистр);		
	
	Закрывать7ойРазделПриПоступленииДенежныхСредств = БухгалтерскийУчет.Закрывать7ойРазделПриПоступленииДенежныхСредств(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);

	Если Справочники.Банки.ЯвляетсяРезидентом(БанкРасчетный, Дата) Тогда
		СчетДС = ПланыСчетов.Единый.РасчетныеСчета01;
	Иначе
		СчетДС = ПланыСчетов.Единый.РасчетныеСчета02;
	КонецЕсли;
	
	
	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;	
	
	
	// ----------------------------- Начислим линейные % -----------------------------
	НоминалДепозита = 0;
	ЛинейныеПроцентыПоДепозиту = 0;
	ЛинейнаяСтоимостьДепозита = РаботаСКредитнымиИнструментами.ПолучитьСтоимостьКредитногоИнструмента(ЭтотОбъект.КредитныйИнструмент, НачалоДня(ЭтотОбъект.Дата), ЭтотОбъект.СчетДоверительногоУправления, НоминалДепозита, ЛинейныеПроцентыПоДепозиту);
	
	РасчетныеДанныеДепозита = ПолучитьРасчетныеПоказателиДепозитаЕПС(ЭтотОбъект.КредитныйИнструмент, ЭтотОбъект.Дата);
	
	ДанныеПроцентов = ПолучитьНачисленныеПроцентыПоДепозитуЕПС(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.КредитныйИнструмент, ЭтотОбъект.Дата);
	НачисленоПроцентов = ДанныеПроцентов.НачисленоПроцентов;
	СуммаДоходовБудущихПериодов = ДанныеПроцентов.СуммаДоходовБудущихПериодов;
	
	ДоначислитьПроцентов = ЛинейныеПроцентыПоДепозиту - НачисленоПроцентов;
	
	Если ДоначислитьПроцентов > 0 Тогда
		
		// доначислим %
		СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ДоначислитьПроцентов, СчетДепозитный.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Доначисление процентов по депозитному вкладу");
		
		Проводка.СчетДт										= УчетныйАктив.СчетУчетаПереоценкиА;
		Проводка.СубконтоДт.Контрагенты						= БанкДепозитный.ЮрФизЛицо;
		Проводка.СубконтоДт.УсловияЗаймовКредитовИДепозитов	= ЭтотОбъект.КредитныйИнструмент;
		Проводка.ВалютаДт									= СчетДепозитный.Валюта;
		Проводка.ВалютнаяСуммаДт							= ДоначислитьПроцентов;
		
		Проводка.СчетКт												= ПланыСчетов.Единый.ПроцентныеДоходы01;
		Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов	= УчетныйАктив.АналитикаПроцентныхДоходов;
		Проводка.СубконтоКт.ЦенныеБумаги							= ЭтотОбъект.КредитныйИнструмент;
		
	КонецЕсли;
	// -----------------------------                     -----------------------------
	
	
	// ----------------------------- Начислим корректировку ЭСП -----------------------------
	Если РасчетныеДанныеДепозита.ИспользоватьЭффективнуюПроцентнуюСтавку Тогда
		
		Если РасчетныеДанныеДепозита.ТребуетсяРасчетСтоимостиВкладаПоЭСП Тогда
			СтоимостьВкладаПоЭСП = Справочники.ДепозитныеВклады.РасчитатьСтоимость(ЭтотОбъект.КредитныйИнструмент, РасчетныеДанныеДепозита.ЭффективнаяСтавкаПроцента, НачалоДня(ЭтотОбъект.Дата));
		Иначе
			СтоимостьВкладаПоЭСП = ЛинейнаяСтоимостьДепозита;
		КонецЕсли;	
			
		БухгалтерскийУчетЕПС.ПровестиКорректировкуЭСП(ЭтотОбъект, ЭтотОбъект.КредитныйИнструмент, ЛинейнаяСтоимостьДепозита, СтоимостьВкладаПоЭСП);
		
	Иначе 
		
		СтоимостьВкладаПоЭСП = ЛинейнаяСтоимостьДепозита;
		
	КонецЕсли;
	
	СуммаКорректировкиЭСП = СтоимостьВкладаПоЭСП - ЛинейнаяСтоимостьДепозита;
	// -----------------------------                            -----------------------------
	
	
	// ----------------------------- Пришли % -----------------------------
	Если ЭтотОбъект.СуммаПроцентов <> 0 Тогда
	
		// пришли %
		СодержаниеПроводки = ?(ЭтотОбъект.ОтложеннаяОплата, "Приход процентов по депозитному вкладу (Отложенная оплата)", "Приход процентов по депозитному вкладу");
			
		СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ЭтотОбъект.СуммаПроцентов, СчетДепозитный.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, СодержаниеПроводки);
		
		Если ЭтотОбъект.ОтложеннаяОплата Тогда
			
			Проводка.СчетДт							= ПланыСчетов.Единый.Расчеты23;
			Проводка.СубконтоДт.Контрагенты			= БанкДепозитный.ЮрФизЛицо;
			Проводка.СубконтоДт.ОснованиеРасчетов	= ЭтотОбъект.Ссылка;
			
			Проводка.ВалютаДт 						= СчетДепозитный.Валюта;			
			Проводка.ВалютнаяСуммаДт				= ЭтотОбъект.СуммаПроцентов;
			
		Иначе
			
			Проводка.СчетДт									= СчетДС;
			Проводка.СубконтоДт.БанковскиеСчета				= СчетРасчетный;
			Проводка.СубконтоДт.ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ПроцентыПоДепозитномуВкладу;
			
			Проводка.ВалютаДт								= СчетРасчетный.Валюта;
			Проводка.ВалютнаяСуммаДт						= ЭтотОбъект.СуммаПроцентов;
			
		КонецЕсли;
		
		Если НастройкиУчета.ИспользоватьСчетРасчетовПоПроцентамДляДепозитов Тогда
		
			Проводка.СчетКт = ПланыСчетов.Единый.Депозиты13;
			Проводка.СубконтоКт.БанковскиеСчета = СчетРасчетный;
			Проводка.СубконтоКт.УсловияЗаймовКредитовИДепозитов = ЭтотОбъект.КредитныйИнструмент;
			Проводка.ВалютаКт  = СчетРасчетный.Валюта;
			Проводка.ВалютнаяСуммаКт = ЭтотОбъект.СуммаПроцентов;
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Приход процентов по депозитному вкладу");
			
			Проводка.СчетДт = ПланыСчетов.Единый.Депозиты13;
			Проводка.СубконтоДт.БанковскиеСчета = СчетРасчетный;
			Проводка.СубконтоДт.УсловияЗаймовКредитовИДепозитов = ЭтотОбъект.КредитныйИнструмент;
			Проводка.ВалютаДт = СчетРасчетный.Валюта;
			Проводка.ВалютнаяСуммаДт = ЭтотОбъект.СуммаПроцентов;
		
		КонецЕсли;
		
		Проводка.СчетКт										= УчетныйАктив.СчетУчетаПереоценкиА;
		Проводка.СубконтоКт.Контрагенты						= БанкДепозитный.ЮрФизЛицо;
		Проводка.СубконтоКт.УсловияЗаймовКредитовИДепозитов	= ЭтотОбъект.КредитныйИнструмент;
		Проводка.ВалютаКт									= СчетДепозитный.Валюта;
		Проводка.ВалютнаяСуммаКт							= ЭтотОбъект.СуммаПроцентов;
		// пришли %
	
	КонецЕсли;
	// -----------------------------          -----------------------------
	
	
	// ----------------------------- Пришло тело -----------------------------
	СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ЭтотОбъект.Сумма, СчетДепозитный.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
	
	СодержаниеПроводки = ?(ЭтотОбъект.ОтложеннаяОплата, "Закрытие депозитного вклада (Отложенная оплата)", "Закрытие депозитного вклада");	
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, СодержаниеПроводки);
	
	Если ЭтотОбъект.ОтложеннаяОплата Тогда
		Проводка.СчетДт							= ПланыСчетов.Единый.Расчеты23;
		Проводка.СубконтоДт.Контрагенты			= БанкДепозитный.ЮрФизЛицо;
		Проводка.СубконтоДт.ОснованиеРасчетов	= ЭтотОбъект.Ссылка;
		Проводка.ВалютаДт 						= СчетДепозитный.Валюта;	
	Иначе
		Если Справочники.Банки.ЯвляетсяРезидентом(БанкРасчетный, Дата) Тогда
			СчетДС = ПланыСчетов.Единый.РасчетныеСчета01;
		Иначе
			СчетДС = ПланыСчетов.Единый.РасчетныеСчета02;
		КонецЕсли;
		
		Проводка.СчетДт									= СчетДС;
		Проводка.СубконтоДт.БанковскиеСчета				= СчетРасчетный;	
		Проводка.СубконтоДт.ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ЗакрытиеДепозитногоВклада;	
		Проводка.ВалютаДт								= СчетРасчетный.Валюта;	
	КонецЕсли;
	Проводка.ВалютнаяСуммаДт				= ЭтотОбъект.Сумма;
	
	Проводка.СчетКт							= ПланыСчетов.Единый.ВыбытиеИРеализация17;
	Проводка.СубконтоКт.ЦенныеБумаги		= ЭтотОбъект.КредитныйИнструмент;
	Проводка.СубконтоКт.ОснованиеРасчетов	= ЭтотОбъект.Ссылка;
	
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Закрытие депозитного вклада");
	
	Проводка.СчетДт							= ПланыСчетов.Единый.ВыбытиеИРеализация17;
	Проводка.СубконтоДт.ЦенныеБумаги		= ЭтотОбъект.КредитныйИнструмент;
	Проводка.СубконтоДт.ОснованиеРасчетов	= ЭтотОбъект.Ссылка;
	
	Проводка.СчетКт							= УчетныйАктив.СчетУчета;
	Проводка.СубконтоКт.БанковскиеСчета		= СчетДепозитный;
	Проводка.СубконтоКт.ДепозитныеВклады	= ЭтотОбъект.КредитныйИнструмент;
	
	Проводка.ВалютаКт						= СчетДепозитный.Валюта;
	Проводка.ВалютнаяСуммаКт				= ЭтотОбъект.Сумма;
	
	// -----------------------------             -----------------------------
	
	
	// ----------------------------- Списание непогашенных % -----------------------------
	СписатьПроцентов = ЛинейныеПроцентыПоДепозиту - ЭтотОбъект.СуммаПроцентов;
	
	СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СписатьПроцентов, СчетДепозитный.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Списание непогашенных процентов");
	
	Проводка.СчетДт							= ПланыСчетов.Единый.ВыбытиеИРеализация17;
	Проводка.СубконтоДт.ЦенныеБумаги		= ЭтотОбъект.КредитныйИнструмент;
	Проводка.СубконтоДт.ОснованиеРасчетов	= ЭтотОбъект.Ссылка;
	
	Проводка.СчетКт										= УчетныйАктив.СчетУчетаПереоценкиА;
	Проводка.СубконтоКт.Контрагенты						= БанкДепозитный.ЮрФизЛицо;
	Проводка.СубконтоКт.УсловияЗаймовКредитовИДепозитов	= ЭтотОбъект.КредитныйИнструмент;
	
	Проводка.ВалютаКт									= СчетДепозитный.Валюта;
	Проводка.ВалютнаяСуммаКт							= СписатьПроцентов;
	
	// -----------------------------                         -----------------------------
	
	
	// ----------------------------- Списание корректировки -----------------------------
	Если РасчетныеДанныеДепозита.ИспользоватьЭффективнуюПроцентнуюСтавку Тогда
		
		СуммаКорректировкиЭСП = СтоимостьВкладаПоЭСП - ЛинейнаяСтоимостьДепозита;
		
		Если СуммаКорректировкиЭСП > 0 Тогда
			
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКорректировкиЭСП, СчетДепозитный.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Списание корректировки");
			
			Проводка.СчетДт							= ПланыСчетов.Единый.ВыбытиеИРеализация17;
			Проводка.СубконтоДт.ЦенныеБумаги		= ЭтотОбъект.КредитныйИнструмент;
			Проводка.СубконтоДт.ОснованиеРасчетов	= ЭтотОбъект.Ссылка;
			
			Проводка.СчетКт = УчетныйАктив.СчетУчетаКорректировокП;
			Проводка.СубконтоКт.БанковскиеСчета		= СчетДепозитный;
			Проводка.СубконтоКт.ДепозитныеВклады	= ЭтотОбъект.КредитныйИнструмент;
			
			Проводка.ВалютаКт						= СчетДепозитный.Валюта;
			Проводка.ВалютнаяСуммаКт				= СуммаКорректировкиЭСП;
			
		ИначеЕсли СуммаКорректировкиЭСП < 0 Тогда
			
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(-СуммаКорректировкиЭСП, СчетДепозитный.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Списание корректировки");
			
			Проводка.СчетДт = УчетныйАктив.СчетУчетаКорректировокП;
			Проводка.СубконтоДт.БанковскиеСчета		= СчетДепозитный;
			Проводка.СубконтоДт.ДепозитныеВклады	= ЭтотОбъект.КредитныйИнструмент;
			
			Проводка.ВалютаДт						= СчетДепозитный.Валюта;
			Проводка.ВалютнаяСуммаДт				= -СуммаКорректировкиЭСП;
			
			Проводка.СчетКт							= ПланыСчетов.Единый.ВыбытиеИРеализация17;
			Проводка.СубконтоКт.ЦенныеБумаги		= ЭтотОбъект.КредитныйИнструмент;
			Проводка.СубконтоКт.ОснованиеРасчетов	= ЭтотОбъект.Ссылка;
			
		КонецЕсли;
		
	КонецЕсли;
	// -----------------------------                        -----------------------------
	
	// ----------------------------- Финансовый результат -----------------------------
	ФинансовыйРезультат = СписатьПроцентов + СуммаКорректировкиЭСП;
	
	Если ФинансовыйРезультат > 0 Тогда
		
		СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ФинансовыйРезультат, СчетДепозитный.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Финансовый результат");
		
		СчетУчетаФинансовогоРезультата = ПланыСчетов.Единый.ДоходыРасходыОтОпераций02;
		ГруппаФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаРасходовОтОпераций;
		
		Проводка.СчетДт							= СчетУчетаФинансовогоРезультата;
		Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ГруппаФинансовогоУчетаДоходовРасходов;
		Проводка.СубконтоДт.ЦенныеБумаги						  = ЭтотОбъект.КредитныйИнструмент;
		
		Проводка.СчетКт							= ПланыСчетов.Единый.ВыбытиеИРеализация17;
		Проводка.СубконтоКт.ЦенныеБумаги		= ЭтотОбъект.КредитныйИнструмент;
		Проводка.СубконтоКт.ОснованиеРасчетов	= ЭтотОбъект.Ссылка;
		
	ИначеЕсли ФинансовыйРезультат < 0 Тогда
		
		СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(-ФинансовыйРезультат, СчетДепозитный.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Финансовый результат");
		
		СчетУчетаФинансовогоРезультата = ПланыСчетов.Единый.ДоходыРасходыОтОпераций01;
		ГруппаФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаДоходовОтОпераций;
		
		Проводка.СчетДт							= ПланыСчетов.Единый.ВыбытиеИРеализация17;
		Проводка.СубконтоДт.ЦенныеБумаги		= ЭтотОбъект.КредитныйИнструмент;
		Проводка.СубконтоДт.ОснованиеРасчетов	= ЭтотОбъект.Ссылка;
		
		Проводка.СчетКт							= СчетУчетаФинансовогоРезультата;
		Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ГруппаФинансовогоУчетаДоходовРасходов;
		Проводка.СубконтоКт.ЦенныеБумаги						  = ЭтотОбъект.КредитныйИнструмент;
		
	КонецЕсли;
	// -----------------------------                      -----------------------------
	
	БухгалтерскийУчетЕПС.ЗакрытьПарныеСчетаДоходовРасходов(ЭтотОбъект, УчетныйАктив, Ложь, Истина, ЭтотОбъект.КредитныйИнструмент, Отказ);
	
	БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(
		ЭтотОбъект, 
		ПланыСчетов.Единый.ПроцентныеДоходы01,
		ЭтотОбъект.КредитныйИнструмент,
		УчетныйАктив.АналитикаПроцентныхДоходов,
		СчетДепозитный.Валюта,
		"Закрытие процентов по депозитному вкладу",
		Неопределено,
		-ЛинейныеПроцентыПоДепозиту);		
	
	Если РасчетныеДанныеДепозита.ИспользоватьЭффективнуюПроцентнуюСтавку И Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
		БухгалтерскийУчетЕПС.ЗакрытьКорректировки710(ЭтотОбъект, ЭтотОбъект.КредитныйИнструмент);
	КонецЕсли;
	
	Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда // закроем корректировку ПП
		БухгалтерскийУчетЕПС.ЗакрытьКорректировки710(ЭтотОбъект, ЭтотОбъект.КредитныйИнструмент,,,, Ложь);
	КонецЕсли;
	
	
	Если ФинансовыйРезультат <> 0 Тогда
	
		БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(
			ЭтотОбъект, 
			СчетУчетаФинансовогоРезультата,
			ЭтотОбъект.КредитныйИнструмент,
			ГруппаФинансовогоУчетаДоходовРасходов,
			СчетДепозитный.Валюта,
			"Закрытие финансового результата от досрочного погашения",
			Неопределено,
			ФинансовыйРезультат);		
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт

	Если ТипЗнч(ЭтотОбъект.КредитныйИнструмент) = Тип("СправочникСсылка.Займы") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не реализовано проведение по ЕПС закрытия займа", ЭтотОбъект.Ссылка,,,Отказ);
		Возврат;
	КонецЕсли;
	
	ЭтоБиржевойДепозит = РаботаСКредитнымиИнструментами.ЭтоБиржевойДепозит(ЭтотОбъект.КредитныйИнструмент);
	
	Если ЭтотОбъект.РежимЗакрытия = Перечисления.РежимыЗакрытияКредитногоИнструмента.Досрочное Тогда
	
		ПроведениеПоРегиструЕПСДосрочноеЗакрытие(УчетныйРегистр, Отказ);
		Возврат;
	
	КонецЕсли;
	
	Закрывать7ойРазделПриПоступленииДенежныхСредств = БухгалтерскийУчет.Закрывать7ойРазделПриПоступленииДенежныхСредств(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);

	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет,
		Отказ);	
		
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствуют настройки у %1 по виду учета %2 на %3!", ЭтотОбъект.СчетДоверительногоУправления, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, ЭтотОбъект.Дата));
		Возврат;
	КонецЕсли;

	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;	

	УчетныйАктив = Справочники.ДепозитныеВклады.ОпределитьУчетныйАктивДепозита(ЭтотОбъект.КредитныйИнструмент, ЭтотОбъект.Дата);
	
	СчетРасчетный	= ЭтотОбъект.РасчетныйСчет;
	СчетДепозитный	= ЭтотОбъект.КредитныйИнструмент.БанковскийСчет;
	
	БанкРасчетный	= СчетРасчетный.Банк;
	БанкДепозитный	= СчетДепозитный.Банк;
	
	ВалютаРасчетногоСчета = СчетРасчетный.Валюта;
	ВалютаДепозитногоСчета = СчетДепозитный.Валюта;
	
	ДанныеПроцентов = ПолучитьНачисленныеПроцентыПоДепозитуЕПС(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.КредитныйИнструмент, ЭтотОбъект.Дата);
	НачисленоПроцентов = ДанныеПроцентов.НачисленоПроцентов;
	СуммаДоходовБудущихПериодов = ДанныеПроцентов.СуммаДоходовБудущихПериодов;
	
	Если ЭтотОбъект.РежимЗакрытия = Перечисления.РежимыЗакрытияКредитногоИнструмента.Частичное Тогда
		// доначислим % до полных по всему телу
		Номинал  = 0;
		Проценты = 0;
		
		ПолнаяСтоимостьВклада = РаботаСКредитнымиИнструментами.ПолучитьСтоимостьКредитногоИнструмента(ЭтотОбъект.КредитныйИнструмент, НачалоДня(ЭтотОбъект.Дата), ЭтотОбъект.СчетДоверительногоУправления, Номинал, Проценты);
		
		ДоначислитьПроцентов = Проценты - НачисленоПроцентов;
		
		// доначислим корректировку до полной по всему телу
		
	Иначе // полное закрытие 
		
		ДоначислитьПроцентов = ЭтотОбъект.СуммаПроцентов - НачисленоПроцентов;
		
	КонецЕсли;
	
	Если ДоначислитьПроцентов = 0 Тогда // для депозитов с авансовой выплатой
		ДоначислитьПроцентов = СуммаДоходовБудущихПериодов;
	КонецЕсли;
	
	Если ДоначислитьПроцентов <> 0 Тогда
		
		// доначислим %
		СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ДоначислитьПроцентов, СчетДепозитный.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Доначисление процентов по депозитному вкладу");
		
		Проводка.СчетДт										= УчетныйАктив.СчетУчетаПереоценкиА;
		Проводка.СубконтоДт.Контрагенты						= БанкДепозитный.ЮрФизЛицо;
		Проводка.СубконтоДт.УсловияЗаймовКредитовИДепозитов	= ЭтотОбъект.КредитныйИнструмент;
		Проводка.ВалютаДт									= ВалютаДепозитногоСчета;
		Проводка.ВалютнаяСуммаДт							= ДоначислитьПроцентов;
		
		Проводка.СчетКт												= ПланыСчетов.Единый.ПроцентныеДоходы01;
		Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов	= УчетныйАктив.АналитикаПроцентныхДоходов;
		Проводка.СубконтоКт.ЦенныеБумаги							= ЭтотОбъект.КредитныйИнструмент;
		
	КонецЕсли;
	
	Если СуммаДоходовБудущихПериодов <> 0 Тогда
		
		СуммаЗакрытия = Мин(СуммаДоходовБудущихПериодов, ДоначислитьПроцентов);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаЗакрытия, "Закрытие полученных процентов по депозитному вкладу");
		
		// дебет
		Проводка.СчетДт = ПланыСчетов.Единый.Депозиты13;
		Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.КредитныйИнструмент.БанковскийСчет;
		Проводка.СубконтоДт.УсловияЗаймовКредитовИДепозитов = ЭтотОбъект.КредитныйИнструмент;
		Проводка.ВалютаДт  = ВалютаДепозитногоСчета;
		Проводка.ВалютнаяСуммаДт = СуммаЗакрытия;
		
		Проводка.СчетКт = УчетныйАктив.СчетУчетаПереоценкиА;
		Проводка.СубконтоКт.Контрагенты = ЭтотОбъект.КредитныйИнструмент.БанковскийСчет.Банк.ЮрФизЛицо;
		Проводка.СубконтоКт.УсловияЗаймовКредитовИДепозитов = ЭтотОбъект.КредитныйИнструмент;
		Проводка.ВалютаКт  = ВалютаДепозитногоСчета;
		Проводка.ВалютнаяСуммаКт = СуммаЗакрытия;
		
	КонецЕсли;
	
	
	// *************** ТЕЛО ******************
	СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ЭтотОбъект.Сумма, СчетДепозитный.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
	
	СодержаниеПроводки = ?(ЭтотОбъект.ОтложеннаяОплата, "Закрытие депозитного вклада (Отложенная оплата)", "Закрытие депозитного вклада");	
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, СодержаниеПроводки);
	
	Если ЭтотОбъект.ОтложеннаяОплата Тогда
		
		Проводка.СчетДт							= ПланыСчетов.Единый.Расчеты23;
		Проводка.СубконтоДт.Контрагенты			= БанкДепозитный.ЮрФизЛицо;
		Проводка.СубконтоДт.ОснованиеРасчетов	= ЭтотОбъект.Ссылка;
		Проводка.ВалютаДт 						= ВалютаДепозитногоСчета;	
		
	Иначе
		
		Если ЭтоБиржевойДепозит Тогда
			СчетДС = ПланыСчетов.Единый.СчетаДляКлиринга24;
			Проводка.ВалютаДт = ВалютаДепозитногоСчета;
		Иначе
			БанкЯвляетсяРезидентом = Справочники.Банки.ЯвляетсяРезидентом(БанкРасчетный, Дата);
			СчетДС = ?(БанкЯвляетсяРезидентом, ПланыСчетов.Единый.РасчетныеСчета01, ПланыСчетов.Единый.РасчетныеСчета02);
			
			Проводка.СубконтоДт.БанковскиеСчета	= СчетРасчетный;
			Проводка.ВалютаДт = ВалютаРасчетногоСчета;
		КонецЕсли;
		
		Проводка.СчетДт = СчетДС;
		Проводка.СубконтоДт.ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ЗакрытиеДепозитногоВклада;	
	КонецЕсли;
	
	Проводка.ВалютнаяСуммаДт				= ЭтотОбъект.Сумма;
		
	Проводка.СчетКт							= УчетныйАктив.СчетУчета;
	Проводка.СубконтоКт.БанковскиеСчета		= СчетДепозитный;
	Проводка.СубконтоКт.ДепозитныеВклады	= ЭтотОбъект.КредитныйИнструмент;
	
	Проводка.ВалютаКт						= ВалютаДепозитногоСчета;
	Проводка.ВалютнаяСуммаКт				= ЭтотОбъект.Сумма;
	
	// *************** % ******************
	Если ЭтотОбъект.СуммаПроцентов <> 0 Тогда
	
		// пришли %
		СодержаниеПроводки = ?(ЭтотОбъект.ОтложеннаяОплата, "Приход процентов по депозитному вкладу (Отложенная оплата)", "Приход процентов по депозитному вкладу");
			
		СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ЭтотОбъект.СуммаПроцентов, СчетДепозитный.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, СодержаниеПроводки);
		
		Если ЭтотОбъект.ОтложеннаяОплата Тогда
			
			Проводка.СчетДт							= ПланыСчетов.Единый.Расчеты23;
			Проводка.СубконтоДт.Контрагенты			= БанкДепозитный.ЮрФизЛицо;
			Проводка.СубконтоДт.ОснованиеРасчетов	= ЭтотОбъект.Ссылка;
			
			Проводка.ВалютаДт 						= ВалютаДепозитногоСчета;			
			Проводка.ВалютнаяСуммаДт				= ЭтотОбъект.СуммаПроцентов;
			
		Иначе
			
			Проводка.СчетДт									= СчетДС;
			Если ЭтоБиржевойДепозит Тогда
				Проводка.ВалютаДт							= ВалютаДепозитногоСчета;
			Иначе
				Проводка.СубконтоДт.БанковскиеСчета			= СчетРасчетный;
				Проводка.ВалютаДт							= ВалютаРасчетногоСчета;
			КонецЕсли;
			
			Проводка.СубконтоДт.ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ПроцентыПоДепозитномуВкладу;
			
			Проводка.ВалютнаяСуммаДт						= ЭтотОбъект.СуммаПроцентов;
			
		КонецЕсли;
		
		Если НастройкиУчета.ИспользоватьСчетРасчетовПоПроцентамДляДепозитов Тогда
			
			СчетРасчетов = ?(ЭтоБиржевойДепозит, СчетДепозитный, СчетРасчетный);
			
			Проводка.СчетКт = ПланыСчетов.Единый.Депозиты13;
			Проводка.СубконтоКт.БанковскиеСчета = СчетРасчетов;
			Проводка.СубконтоКт.УсловияЗаймовКредитовИДепозитов = ЭтотОбъект.КредитныйИнструмент;
			Проводка.ВалютаКт  = ВалютаДепозитногоСчета;
			Проводка.ВалютнаяСуммаКт = ЭтотОбъект.СуммаПроцентов;
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Приход процентов по депозитному вкладу");
			
			Проводка.СчетДт = ПланыСчетов.Единый.Депозиты13;
			Проводка.СубконтоДт.БанковскиеСчета = СчетРасчетов;
			Проводка.СубконтоДт.УсловияЗаймовКредитовИДепозитов = ЭтотОбъект.КредитныйИнструмент;
			Проводка.ВалютаДт = ВалютаДепозитногоСчета;
			Проводка.ВалютнаяСуммаДт = ЭтотОбъект.СуммаПроцентов;
		
		КонецЕсли;
		
		Проводка.СчетКт										= УчетныйАктив.СчетУчетаПереоценкиА;
		Проводка.СубконтоКт.Контрагенты						= БанкДепозитный.ЮрФизЛицо;
		Проводка.СубконтоКт.УсловияЗаймовКредитовИДепозитов	= ЭтотОбъект.КредитныйИнструмент;
		Проводка.ВалютаКт									= ВалютаДепозитногоСчета;
		Проводка.ВалютнаяСуммаКт							= ЭтотОбъект.СуммаПроцентов;
		// пришли %
	
	КонецЕсли;
		
	//**************************************************************
	Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
	
		БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ПроцентныеДоходы01, ЭтотОбъект.КредитныйИнструмент, СчетДепозитный.Валюта, "Закрытие доначисления процентов по депозитному вкладу");
	
	КонецЕсли;
	//********************************************************************************
	
	Если ЭтотОбъект.РежимЗакрытия = Перечисления.РежимыЗакрытияКредитногоИнструмента.Частичное Тогда
		СтоимостьВклада = ПолнаяСтоимостьВклада;
	Иначе
		СтоимостьВклада = ЭтотОбъект.Сумма + ЭтотОбъект.СуммаПроцентов;
	КонецЕсли;
	
	РасчетныеДанныеДепозита = ПолучитьРасчетныеПоказателиДепозитаЕПС(ЭтотОбъект.КредитныйИнструмент, ЭтотОбъект.Дата);
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		УчетныйАктив,
		УчетныйРегистр);		
	
	Если РасчетныеДанныеДепозита.ИспользоватьЭффективнуюПроцентнуюСтавку Тогда
		
		Если РасчетныеДанныеДепозита.ТребуетсяРасчетСтоимостиВкладаПоЭСП Тогда
			СтоимостьВкладаПоЭСП = Справочники.ДепозитныеВклады.РасчитатьСтоимость(ЭтотОбъект.КредитныйИнструмент, РасчетныеДанныеДепозита.ЭффективнаяСтавкаПроцента, НачалоДня(ЭтотОбъект.Дата));
		Иначе
			СтоимостьВкладаПоЭСП = СтоимостьВклада;
		КонецЕсли;	
		
		БухгалтерскийУчетЕПС.ПровестиКорректировкуЭСП(ЭтотОбъект, ЭтотОбъект.КредитныйИнструмент, СтоимостьВклада, СтоимостьВкладаПоЭСП);
	Иначе
		БухгалтерскийУчетЕПС.ПровестиКорректировкуЭСП(ЭтотОбъект, ЭтотОбъект.КредитныйИнструмент, 0, 0);
	КонецЕсли;
	
	
	Если ЭтотОбъект.РежимЗакрытия = Перечисления.РежимыЗакрытияКредитногоИнструмента.Частичное Тогда
		
		ИзменениеКорректировки = 0;
		
		Если СокрЛП(ЭтотОбъект.КредитныйИнструмент.Код) = "РТ-000073" Тогда
		
			// Эти пункты выше были сделаны
			// 1.	Доначисляем проценты 
			// 2.	Доначисляем корректировку исходя из старых потоков
			// 3.	Списываем часть номинала
			// 4.	Списываем проценты (но не все, а какую-то часть, которая приходит, причем часть процентов останется)
			
			// А вот это только в экселе
			// 5.	Рассчитываем новые денежные потоки исходя из нового номинала  (и непогашенных процентов, который придут в конце квартала!)
			// 6.	Считаем амортизированную стоимость на 23е исходя из новых потоков
			// 7.	Считаем новую корректировку путем вычитания из новой АС оставшихся процентов и номинала
			// 8.	Доводим корректировку до новой

			
			// посчитать новые ден.потоки - пока не буду ради одного депозита
			//
			// 26.03.2020   2154219349,13   
			//
			
			// расчитать из них новую АС
