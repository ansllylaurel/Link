			// НоваяКорректировкаЭСП = СтоимостьВкладаПоЭСПНовая - 2129204109.59 - (Проценты - ЭтотОбъект.СуммаПроцентов);
			
			// откорректировкать корректировку
			//
			// Изменение корректировки =	2210525029,45
			//
			// Это из новой корректировки вычли старую - она в БухгалтерскийУчетЕПС.ПровестиКорректировкуЭСП начислялась
			ИзменениеКорректировки = 2210525029.45;
			
		ИначеЕсли СокрЛП(ЭтотОбъект.КредитныйИнструмент.Код) = "РТ-000074" Тогда
			
			// тут тоже идут лютые расчеты, но мне уже лень
			
			ИзменениеКорректировки =  2272420265.29;
			
		КонецЕсли;
		
		Если ИзменениеКорректировки > 0 Тогда
		
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ИзменениеКорректировки, "Изменение корректировки");
			
			Проводка.СчетДт										= ПланыСчетов.Единый.Депозиты11;
			
			Проводка.СубконтоДт.БанковскиеСчета = СчетДепозитный;
			Проводка.СубконтоДт.ДепозитныеВклады = ЭтотОбъект.КредитныйИнструмент;		
			Проводка.ВалютаДт = ВалютаДепозитногоСчета;
			Проводка.ВалютнаяСуммаДт = ИзменениеКорректировки;
			
			Проводка.СчетКт												= ПланыСчетов.Единый.ДоходыРасходыОтОпераций01;
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов	= УчетныйАктив.АналитикаДоходовОтОпераций;
			Проводка.СубконтоКт.ЦенныеБумаги							= ЭтотОбъект.КредитныйИнструмент;
		
		КонецЕсли;
	
	КонецЕсли;
	
	// резервы
	СчетРезерва = УчетныйАктив.СчетУчетаРезервов;
	
	АналитикаСписанияРезервов = БухгалтерскийУчетЕПС.ПолучитьГФУСписанияРезервов(ЭтотОбъект, УчетныйАктив); 
	
	СчетУчетаДоходов = ПланыСчетов.Единый.НайтиПоКоду(АналитикаСписанияРезервов.НомерСчетаБухгалтерскогоУчета);
	
	БухгалтерскийУчетЕПС.СформироватьДвиженияПоЗакрытиюРезервовОКУ(ЭтотОбъект, СчетРезерва, ПланыВидовХарактеристик.ВидыСубконто.ДепозитныеВклады, СчетУчетаДоходов, АналитикаСписанияРезервов, Движения.ЕдиныйБухгалтерскийУчет);
	
	Если Закрывать7ойРазделПриПоступленииДенежныхСредств И ЭтотОбъект.Дата > БухгалтерскийУчетЕПС.ДатаВключенияЗакрытия7гоРазделаПоРезервам() Тогда
		
		БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ДоходыРасходыПоРезервам01, ЭтотОбъект.КредитныйИнструмент, ВалютаДепозитногоСчета, "Закрытие резервов", ЭтотОбъект.Дата,,,,, Истина);
		БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ДоходыРасходыПоРезервам02, ЭтотОбъект.КредитныйИнструмент, ВалютаДепозитногоСчета, "Закрытие резервов", ЭтотОбъект.Дата,,,,, Истина);
	
	КонецЕсли;
	
	
	// комиссии - актуальны только для биржевых депозитов, поэтому поставлю условие
	Если ЭтоБиржевойДепозит И ((НастройкиПоВидуУчета.МетодПризнанияРасходовПоБиржевымДепозитам = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриЗакрытии)
		ИЛИ (НастройкиПоВидуУчета.МетодПризнанияРасходовПоБиржевымДепозитам = Перечисления.МетодыПризнанияРасходовПоСделкам.ВЗависимостиОтПериодичности)
		ИЛИ (НастройкиПоВидуУчета.МетодПризнанияРасходовПоБиржевымДепозитам = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриНачислении)) Тогда
		
		СчетКомиссий = ПланыСчетов.Единый.Депозиты07;
		СчетРасчетов = ПланыСчетов.Единый.Депозиты05;
		
		ГФУКомиссий = ОбщегоНазначенияПовтИсп.ПолучитьИменованныйОбъект("Комиссионные_расходы_затраты_по_сделке");//Справочники.ГруппыФинансовогоУчетаДоходовРасходов.НайтиПоКоду("31322"); // пока хардкод т.к. еще не устоялась ситуация
		
		СчетУчетаДоходов = ПланыСчетов.Единый.НайтиПоКоду(ГФУКомиссий.НомерСчетаБухгалтерскогоУчета); // именно доходов т.к. комиссии уменьшают доход
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕдиныйБухгалтерскийУчетОстатки.Валюта КАК Валюта,
			|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток,
			|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток
			|ИЗ
			|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
			|			&Период,
			|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты07),
			|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДепозитныеВклады),
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И Субконто1 = &КредитныйИнструмент) КАК ЕдиныйБухгалтерскийУчетОстатки";
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("КредитныйИнструмент", ЭтотОбъект.КредитныйИнструмент);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			// Признание
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ВыборкаДетальныеЗаписи.СуммаОстаток, "Списание расходов");	
			
			Проводка.СчетДт = СчетРасчетов;
			
			Проводка.СубконтоДт.БанковскиеСчета = СчетДепозитный;
			Проводка.СубконтоДт.ДепозитныеВклады = ЭтотОбъект.КредитныйИнструмент;
			
			Проводка.ВалютаДт = ВыборкаДетальныеЗаписи.Валюта;
			Проводка.ВалютнаяСуммаДт = ВыборкаДетальныеЗаписи.ВалютнаяСуммаОстаток;
			
			
			Проводка.СчетКт = СчетКомиссий;
			
			Проводка.СубконтоКт.БанковскиеСчета = СчетДепозитный;
			Проводка.СубконтоКт.ДепозитныеВклады = ЭтотОбъект.КредитныйИнструмент;
			
			Проводка.ВалютаКт = ВыборкаДетальныеЗаписи.Валюта;
			Проводка.ВалютнаяСуммаКт = ВыборкаДетальныеЗаписи.ВалютнаяСуммаОстаток;
			
			
			// Начисление
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ВыборкаДетальныеЗаписи.СуммаОстаток, "Списание расходов");	
			
			
			Проводка.СчетДт = СчетУчетаДоходов;
			
			Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ГФУКомиссий;
			Проводка.СубконтоДт.ЦенныеБумаги = ЭтотОбъект.КредитныйИнструмент;
			
			
			Проводка.СчетКт = СчетРасчетов;
			
			Проводка.СубконтоКт.БанковскиеСчета = СчетДепозитный;
			Проводка.СубконтоКт.ДепозитныеВклады = ЭтотОбъект.КредитныйИнструмент;
			
			Проводка.ВалютаКт = ВыборкаДетальныеЗаписи.Валюта;
			Проводка.ВалютнаяСуммаКт = ВыборкаДетальныеЗаписи.ВалютнаяСуммаОстаток;
			
			Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Списание расходов");	
				
				Проводка.СчетДт 				= ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоДт.Договоры 	= ЭтотОбъект.СчетДоверительногоУправления;
				
				Проводка.СчетКт = СчетУчетаДоходов;
				
				Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ГФУКомиссий;
				Проводка.СубконтоКт.ЦенныеБумаги = ЭтотОбъект.КредитныйИнструмент;
				
			КонецЕсли;	
			
		КонецЦикла;
	
	КонецЕсли;
	
	
	БухгалтерскийУчетЕПС.ЗакрытьПарныеСчетаДоходовРасходов(ЭтотОбъект, УчетныйАктив, Ложь, Истина, ЭтотОбъект.КредитныйИнструмент, Отказ);
	
	БухгалтерскийУчетЕПС.ЗакрытьКорректировки206(ЭтотОбъект, ЭтотОбъект.КредитныйИнструмент);	
	
	Если РасчетныеДанныеДепозита.ИспользоватьЭффективнуюПроцентнуюСтавку И Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
		БухгалтерскийУчетЕПС.ЗакрытьКорректировки710(ЭтотОбъект, ЭтотОбъект.КредитныйИнструмент);
	КонецЕсли;
	
	Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда // закроем корректировку ПП
		БухгалтерскийУчетЕПС.ЗакрытьКорректировки710(ЭтотОбъект, ЭтотОбъект.КредитныйИнструмент,,,, Ложь);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт

	Движения[УчетныйРегистр].Записывать = Истина;
	
	Если ТипЗнч(ЭтотОбъект.КредитныйИнструмент) = Тип("СправочникСсылка.Займы") Тогда
		ПроведениеПоРегиструБухгалтерииЗайм(УчетныйРегистр, Отказ);
		Возврат;
	КонецЕсли;
	
	ЭтоБиржевойДепозит = РаботаСКредитнымиИнструментами.ЭтоБиржевойДепозит(ЭтотОбъект.КредитныйИнструмент);
	
	УчетныйАктив = Справочники.УчетныеАктивы.ДепозитныеВклады;
	
	Если ЭтоБиржевойДепозит Тогда
	    СчетУчетаДС = БухгалтерскийУчет.ОпределитьНастройкуУчета(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			"СчетУчетаДенежныхСредствНаБирже");
	Иначе
		СчетУчетаДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
			ЭтотОбъект.Дата, 
			ЭтотОбъект.Организация, 
			ЭтотОбъект.СчетДоверительногоУправления,
			ЭтотОбъект.КредитныйИнструмент.БанковскийСчет.Валюта,
			Справочники.БрокерскиеКомпании.ПустаяСсылка());
	КонецЕсли;
		
	СчетУчетаАктивов = БухгалтерскийУчет.ОпределитьСчетУчетаАктивов(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		УчетныйАктив,
		УчетныйРегистр);
		
	СчетУчетаПереоценкиАктивов = БухгалтерскийУчет.ОпределитьСчетУчетаПереоценкиАктивов(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		УчетныйАктив,
		УчетныйРегистр);
		
	Если ЭтотОбъект.Сумма <> 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ЭтотОбъект.Сумма, "Закрытие депозитного вклада");
		
		// Дебет
		Проводка.СчетДт = СчетУчетаДС;
		
		Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
			Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
		КонецЕсли;
		
		Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда 
			Проводка.СубконтоДт.ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ЗакрытиеДепозитногоВклада;
		КонецЕсли;	
		
		Если ЭтоБиржевойДепозит И СчетУчетаДС.Валютный Тогда
		
			Проводка.ВалютаДт = ЭтотОбъект.КредитныйИнструмент.БанковскийСчет.Валюта;
			Проводка.ВалютнаяСуммаДт = ЭтотОбъект.Сумма;
		
		КонецЕсли;
		
		// Кредит
		Проводка.СчетКт = СчетУчетаАктивов;
		Проводка.СубконтоКт.ДепозитныеВклады = ЭтотОбъект.КредитныйИнструмент;
		
	КонецЕсли;
																  
	Если ЭтотОбъект.СуммаПроцентов <> 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ЭтотОбъект.СуммаПроцентов, "Закрытие процентов по депозитному вкладу");
		
		// Дебет
		Проводка.СчетДт = СчетУчетаДС;
		
		Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
			Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
		КонецЕсли;
		
		Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда 
			Проводка.СубконтоДт.ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ПроцентыПоДепозитномуВкладу;
		КонецЕсли;
		
		Если ЭтоБиржевойДепозит И СчетУчетаДС.Валютный Тогда
		
			Проводка.ВалютаДт = ЭтотОбъект.КредитныйИнструмент.БанковскийСчет.Валюта;
			Проводка.ВалютнаяСуммаДт = ЭтотОбъект.СуммаПроцентов;
		
		КонецЕсли;
		
		// Кредит
		Проводка.СчетКт = СчетУчетаПереоценкиАктивов;
		Проводка.СубконтоКт.ДепозитныеВклады = ЭтотОбъект.КредитныйИнструмент;
		
	КонецЕсли;
	
	ЭтоПИФ = ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления 
		= Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.СуммаОстаток
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоДепозитнымВкладам),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДепозитныеВклады),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1 = &ДепозитныйВклад) КАК БухгалтерскийУчетОстатки";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", УчетныйРегистр);
		
	Запрос.УстановитьПараметр("Организация",                  ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период",                       ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДепозитныйВклад",              ЭтотОбъект.КредитныйИнструмент);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		АналитикаДоходовОтПереоценки = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктив,
			УчетныйРегистр,
			"АналитикаДоходовОтПереоценки");	
			
		АналитикаДоходов = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктив,
			УчетныйРегистр,
			"АналитикаДоходов");	
			
		Если ЭтоПИФ И ЗначениеЗаполнено(АналитикаДоходов) И АналитикаДоходовОтПереоценки <> АналитикаДоходов Тогда
			
			Если Выборка.СуммаОстаток > 0 Тогда
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СуммаОстаток, "Восстановление переоценки по депозитному вкладу");
				
				// Дебет
				Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходовОтПереоценки;
				Проводка.СубконтоДт.ЦенныеБумаги         = ЭтотОбъект.КредитныйИнструмент;
				
				// Кредит
				Проводка.СчетКт = СчетУчетаПереоценкиАктивов;
				Проводка.СубконтоКт.ДепозитныеВклады = ЭтотОбъект.КредитныйИнструмент;
				
			ИначеЕсли Выборка.СуммаОстаток < 0 Тогда
				
				// Дебет
				Проводка.СчетДт = СчетУчетаПереоценкиАктивов;
				Проводка.СубконтоДт.ДепозитныеВклады = ЭтотОбъект.КредитныйИнструмент;
				
				// Кредит
				Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
				Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходовОтПереоценки;
				Проводка.СубконтоКт.ЦенныеБумаги         = ЭтотОбъект.КредитныйИнструмент;
				
			КонецЕсли;
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ЭтотОбъект.СуммаПроцентов, "Начисление процентов по депозитному вкладу");
			
			// Дебет
			Проводка.СчетДт = СчетУчетаПереоценкиАктивов;
			Проводка.СубконтоДт.ДепозитныеВклады = ЭтотОбъект.КредитныйИнструмент;
			
			// Кредит
			Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходов;
			Проводка.СубконтоКт.ЦенныеБумаги         = ЭтотОбъект.КредитныйИнструмент;
			
		Иначе
		
			Если ЭтотОбъект.СуммаПроцентов - Выборка.СуммаОстаток > 0 Тогда
				
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ЭтотОбъект.СуммаПроцентов - Выборка.СуммаОстаток, "Доначисление процентов по депозитному вкладу");
				
				// Дебет
				Проводка.СчетДт = СчетУчетаПереоценкиАктивов;
				Проводка.СубконтоДт.ДепозитныеВклады = ЭтотОбъект.КредитныйИнструмент;
				
				// Кредит
				Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
				Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходовОтПереоценки;
				Проводка.СубконтоКт.ЦенныеБумаги         = ЭтотОбъект.КредитныйИнструмент;
			
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоБиржевойДепозит Тогда
		МетодПризнанияРасходовПоБиржевымДепозитам = 
			БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
				Дата, 
				Организация,
				СчетДоверительногоУправления,
				УчетныйРегистр,
				"МетодПризнанияРасходовПоБиржевымДепозитам");
		
		Если МетодПризнанияРасходовПоБиржевымДепозитам = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриЗакрытии 
			ИЛИ МетодПризнанияРасходовПоБиржевымДепозитам = Перечисления.МетодыПризнанияРасходовПоСделкам.ВЗависимостиОтПериодичности
			ИЛИ МетодПризнанияРасходовПоБиржевымДепозитам = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриНачислении Тогда
			
			ВидыСубконто = Новый Массив;
			ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
			ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Сделка);
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЕСТЬNULL(БухгалтерскийУчетРасчеты.СуммаОстаток, 0) КАК СуммаОстатокРасчеты,
				|	БухгалтерскийУчетРасчеты.Счет КАК СчетЗайма,
				|	БухгалтерскийУчетРасчеты.Субконто1 КАК Контрагент,
				|	БухгалтерскийУчетРасчеты.Субконто2 КАК Сделка
				|ИЗ
				|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
				|			&Период,
				|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыПоКомиссии),
				|			 &ВидыСубконто,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
				|				И ВЫРАЗИТЬ(Субконто2 КАК Документ.РазмещениеКредитногоИнструмента).КредитныйИнструмент = &КредитныйИнструмент) КАК БухгалтерскийУчетРасчеты";
			
			Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
			Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
			Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
			Запрос.УстановитьПараметр("КредитныйИнструмент", ЭтотОбъект.КредитныйИнструмент);
			Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", УчетныйРегистр);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если Не РезультатЗапроса.Пустой() Тогда
				
				Выборка = РезультатЗапроса.Выбрать();
				
				АналитикаПереоценки = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
				ЭтотОбъект.Дата, 
				ЭтотОбъект.Организация, 
				ЭтотОбъект.СчетДоверительногоУправления, 
				Справочники.ВидыЗадолженности.ПоТорговойКомиссии, 
				УчетныйРегистр, 
				"АналитикаПереоценки",
				Истина);
				
				Пока Выборка.Следующий() Цикл
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СуммаОстатокРасчеты, "Списание расходов");
					
					// дебет
					Проводка.СчетДт = ПланыСчетов.Основной.РасчетыПоТорговойКомиссии;
					Проводка.СубконтоДт.Контрагенты = Выборка.Контрагент;
					Проводка.СубконтоДт.Сделка = Выборка.Сделка;
					
					// кредит
					Проводка.СчетКт = ПланыСчетов.Основной.РасчетыПоКомиссии;
					Проводка.СубконтоКт.Контрагенты = Выборка.Контрагент;
					Проводка.СубконтоКт.Сделка = Выборка.Сделка;
					
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СуммаОстатокРасчеты, "Списание расходов");
					
					// дебет
					Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
					Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаПереоценки;
					Проводка.СубконтоДт.ЦенныеБумаги = ЭтотОбъект.КредитныйИнструмент;
					
					// кредит
					Проводка.СчетКт = ПланыСчетов.Основной.РасчетыПоТорговойКомиссии;
					Проводка.СубконтоКт.Контрагенты = Выборка.Контрагент;
					Проводка.СубконтоКт.Сделка = Выборка.Сделка;
					
					
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерииЗайм(УчетныйРегистр, Отказ)

	СчетДоходов = ПланыСчетов.Основной.ПрочиеДоходы;	
	СчетРасходов = ПланыСчетов.Основной.ПрочиеРасходы;
		
	СчетУчетаДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.РасчетныйСчет.Валюта,
		Справочники.БрокерскиеКомпании.ПустаяСсылка());	
		
	УчетныйАктив = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата,, ЭтотОбъект.КредитныйИнструмент);
		
	НастройкиУчетаАктива = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления, 
		УчетныйАктив, 
		УчетныйРегистр);
	
	АналитикаДоходовОтПереоценкиПоЗайму = НастройкиУчетаАктива.АналитикаДоходовОтПереоценки; 
		
	АналитикаДоходовПоЗайму = НастройкиУчетаАктива.АналитикаДоходов; 
		
	СчетПереоценкиРасчетов = БухгалтерскийУчет.ОпределитьСчетУчетаПереоценкиАктивов(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления, 
		УчетныйАктив, 
		УчетныйРегистр, 
		Ложь);
	
	СчетУчетаАктива = БухгалтерскийУчет.ОпределитьСчетУчетаАктивов(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления, 
		УчетныйАктив, 
		УчетныйРегистр, 
		Ложь);
		
	ЭтоПИФ = ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда;
	
	ДанныеКредитногоИнструмента = РаботаСКредитнымиИнструментами.ПолучитьДанныеКредитногоИнструмента(ЭтотОбъект.КредитныйИнструмент, ЭтотОбъект.Дата); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(БухгалтерскийУчетРасчеты.СуммаОстаток, 0) КАК СуммаОстатокРасчеты,
		|	ЕСТЬNULL(БухгалтерскийУчетПроценты.СуммаОстаток, 0) КАК СуммаОстатокПроценты,
		|	ЕСТЬNULL(БухгалтерскийУчетПроценты.Счет, НЕОПРЕДЕЛЕНО) КАК СчетПроцентов,
		|	БухгалтерскийУчетРасчеты.Счет КАК СчетЗайма
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет В (&СчетаЗайма),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Займы),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|				И Субконто1 = &Займ) КАК БухгалтерскийУчетРасчеты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет В (&СчетаПроцентов),
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Займы),
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|					И Субконто1 = &Займ) КАК БухгалтерскийУчетПроценты
		|		ПО БухгалтерскийУчетРасчеты.Субконто1 = БухгалтерскийУчетПроценты.Субконто1";

	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Займ", ЭтотОбъект.КредитныйИнструмент);
	
	СчетаЗайма = Новый Массив;
	СчетаПроцентов = Новый Массив;
	
	СчетаЗайма.Добавить(СчетУчетаАктива);
	СчетаПроцентов.Добавить(СчетПереоценкиРасчетов);
	
	Если УчетныйАктив = Справочники.УчетныеАктивы.ЗаймыПолученныеДолгосрочные
		ИЛИ УчетныйАктив = Справочники.УчетныеАктивы.ЗаймыПолученныеКраткосрочные Тогда
		
		СчетаЗайма.Добавить(БухгалтерскийУчет.ОпределитьСчетУчетаАктивов(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		?(УчетныйАктив = Справочники.УчетныеАктивы.ЗаймыПолученныеДолгосрочные,Справочники.УчетныеАктивы.ЗаймыПолученныеКраткосрочные,Справочники.УчетныеАктивы.ЗаймыПолученныеДолгосрочные),
		УчетныйРегистр));
		
		СчетаПроцентов.Добавить(БухгалтерскийУчет.ОпределитьСчетУчетаПереоценкиАктивов(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		?(УчетныйАктив = Справочники.УчетныеАктивы.ЗаймыПолученныеДолгосрочные,Справочники.УчетныеАктивы.ЗаймыПолученныеКраткосрочные,Справочники.УчетныеАктивы.ЗаймыПолученныеДолгосрочные),
		УчетныйРегистр));
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("СчетаЗайма", СчетаЗайма);
	Запрос.УстановитьПараметр("СчетаПроцентов", СчетаПроцентов);

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", УчетныйРегистр);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Количество()>1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На счетах учета по займу " + ЭтотОбъект.КредитныйИнструмент + " задвоены остатки", Ссылка,,, Отказ);
		Возврат;
	ИначеЕсли Выборка.Количество()=0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На счетах учета по займу " + ЭтотОбъект.КредитныйИнструмент + " не найден остаток", Ссылка,,, Отказ);
		Возврат;
	КонецЕсли;
	
	ЭтоВыданныйЗайм = УчетныйАктив = Справочники.УчетныеАктивы.ЗаймыВыданные;
	
	Пока Выборка.Следующий() Цикл
		
		СторонаКредитногоИнструмента = ?(ЭтоВыданныйЗайм, "Кт", "Дт");
		СторонаДС = ?(СторонаКредитногоИнструмента = "Дт", "Кт", "Дт");
		
		СуммаПереоценки = 0;
		
		Если НастройкиУчетаАктива.ПереоцениватьВДеньОперации Тогда
			
			СправедливаяСтоимостьПогашения = РаботаСКредитнымиИнструментами.ПолучитьСправедливуюСтоимостьПогашенияКредитногоИнструмента(Ссылка, Дата, Отказ);
			
			СуммаПереоценки = ЭтотОбъект.Сумма - СправедливаяСтоимостьПогашения;
			
			Если СуммаПереоценки <> 0 Тогда
				АналитикаДоходовОтРеализации = НастройкиУчетаАктива.АналитикаДоходовОтРеализации; 
				
				Если НЕ ЗначениеЗаполнено(АналитикаДоходовОтРеализации) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполенена аналитика доходов от реализации для актива "+УчетныйАктив,Ссылка,,,Отказ);
					Возврат;
				КонецЕсли;
				
				Если СуммаПереоценки > 0 Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаПереоценки, "Переоценка по займу");
				
					// дебет
					Проводка["Счет"+СторонаДС] = СчетПереоценкиРасчетов;
					Проводка["Субконто"+СторонаДС].Контрагенты = ДанныеКредитногоИнструмента.Контрагент;
					Проводка["Субконто"+СторонаДС].Займы = ЭтотОбъект.КредитныйИнструмент;
					
					// кредит
					Проводка["Счет"+СторонаКредитногоИнструмента] = ?(ЭтоВыданныйЗайм, СчетДоходов, СчетРасходов);
					Проводка["Субконто"+СторонаКредитногоИнструмента].ПрочиеДоходыИРасходы = АналитикаДоходовОтРеализации;
					Проводка["Субконто"+СторонаКредитногоИнструмента].ЦенныеБумаги = ЭтотОбъект.КредитныйИнструмент;
					
				ИначеЕсли СуммаПереоценки < 0 Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], -СуммаПереоценки, "Переоценка по займу");
				
					// дебет
					Проводка["Счет"+СторонаДС] = ?(ЭтоВыданныйЗайм, СчетДоходов, СчетРасходов);
					Проводка["Субконто"+СторонаДС].ПрочиеДоходыИРасходы = АналитикаДоходовОтРеализации;
					Проводка["Субконто"+СторонаДС].ЦенныеБумаги = ЭтотОбъект.КредитныйИнструмент;
					
					// кредит
					Проводка["Счет"+СторонаКредитногоИнструмента] = СчетПереоценкиРасчетов;
					Проводка["Субконто"+СторонаКредитногоИнструмента].Контрагенты = ДанныеКредитногоИнструмента.Контрагент;
					Проводка["Субконто"+СторонаКредитногоИнструмента].Займы = ЭтотОбъект.КредитныйИнструмент;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;			
		
		Если ЭтоПИФ И ЗначениеЗаполнено(АналитикаДоходовПоЗайму) И АналитикаДоходовОтПереоценкиПоЗайму <> АналитикаДоходовПоЗайму Тогда
			
			Если (Выборка.СуммаОстатокПроценты + СуммаПереоценки) <> 0 Тогда
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], 
					?((Выборка.СуммаОстатокПроценты + СуммаПереоценки) < 0, -1, 1) * (Выборка.СуммаОстатокПроценты + СуммаПереоценки), "Переоценка по займу");
			
				// дебет
				Проводка["Счет"+СторонаДС] = ?(ЭтоВыданныйЗайм, СчетРасходов, СчетДоходов);
				Проводка["Субконто"+СторонаДС].ПрочиеДоходыИРасходы = АналитикаДоходовОтПереоценкиПоЗайму;
				Проводка["Субконто"+СторонаДС].ЦенныеБумаги = ЭтотОбъект.КредитныйИнструмент;
				
				// кредит
				Проводка["Счет"+СторонаКредитногоИнструмента] = СчетПереоценкиРасчетов;
				Проводка["Субконто"+СторонаКредитногоИнструмента].Контрагенты = ДанныеКредитногоИнструмента.Контрагент;
				Проводка["Субконто"+СторонаКредитногоИнструмента].Займы = ЭтотОбъект.КредитныйИнструмент;
				
			КонецЕсли;
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ЭтотОбъект.СуммаПроцентов, "Проценты по займу");
		
			// дебет
			Проводка["Счет"+СторонаДС] = СчетПереоценкиРасчетов;
			Проводка["Субконто"+СторонаДС].Контрагенты = ДанныеКредитногоИнструмента.Контрагент;
			Проводка["Субконто"+СторонаДС].Займы = ЭтотОбъект.КредитныйИнструмент;
			
			// кредит
			Проводка["Счет"+СторонаКредитногоИнструмента] = ?(ЭтоВыданныйЗайм, СчетДоходов, СчетРасходов);
			Проводка["Субконто"+СторонаКредитногоИнструмента].ПрочиеДоходыИРасходы = АналитикаДоходовПоЗайму;
			Проводка["Субконто"+СторонаКредитногоИнструмента].ЦенныеБумаги = ЭтотОбъект.КредитныйИнструмент;
			
		Иначе
			ДоначислитьПроцентов = ЭтотОбъект.СуммаПроцентов - (Выборка.СуммаОстатокПроценты + СуммаПереоценки) * ?(ЭтоВыданныйЗайм, 1, -1);
				
			Если ДоначислитьПроцентов > 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ДоначислитьПроцентов, "Проценты по займу");
			
				// дебет
				Проводка["Счет"+СторонаДС] = СчетПереоценкиРасчетов;
				Проводка["Субконто"+СторонаДС].Контрагенты = ДанныеКредитногоИнструмента.Контрагент;
				Проводка["Субконто"+СторонаДС].Займы = ЭтотОбъект.КредитныйИнструмент;
				
				// кредит
				Проводка["Счет"+СторонаКредитногоИнструмента] = ?(ЭтоВыданныйЗайм, СчетДоходов, СчетРасходов);
				Проводка["Субконто"+СторонаКредитногоИнструмента].ПрочиеДоходыИРасходы = АналитикаДоходовОтПереоценкиПоЗайму;
				Проводка["Субконто"+СторонаКредитногоИнструмента].ЦенныеБумаги = ЭтотОбъект.КредитныйИнструмент;
				
			ИначеЕсли ДоначислитьПроцентов < 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], -ДоначислитьПроцентов, "Проценты по займу");
			
				// дебет
				Проводка["Счет"+СторонаДС] = ?(ЭтоВыданныйЗайм, СчетДоходов, СчетРасходов);
				Проводка["Субконто"+СторонаДС].ПрочиеДоходыИРасходы = АналитикаДоходовОтПереоценкиПоЗайму;
				Проводка["Субконто"+СторонаДС].ЦенныеБумаги = ЭтотОбъект.КредитныйИнструмент;
				
				// кредит
				Проводка["Счет"+СторонаКредитногоИнструмента] = СчетПереоценкиРасчетов;
				Проводка["Субконто"+СторонаКредитногоИнструмента].Контрагенты = ДанныеКредитногоИнструмента.Контрагент;
				Проводка["Субконто"+СторонаКредитногоИнструмента].Займы = ЭтотОбъект.КредитныйИнструмент;
				
			КонецЕсли;
		КонецЕсли;
		
		// закрываем проценты на займ
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ЭтотОбъект.СуммаПроцентов, "Проценты по займу");
	
		// дебет
		Проводка["Счет"+СторонаДС] = СчетУчетаАктива;
		Проводка["Субконто"+СторонаДС].Контрагенты = ДанныеКредитногоИнструмента.Контрагент;
		Проводка["Субконто"+СторонаДС].Займы = ЭтотОбъект.КредитныйИнструмент;
		
		// кредит
		Проводка["Счет"+СторонаКредитногоИнструмента] = СчетПереоценкиРасчетов;
		Проводка["Субконто"+СторонаКредитногоИнструмента].Контрагенты = ДанныеКредитногоИнструмента.Контрагент;
		Проводка["Субконто"+СторонаКредитногоИнструмента].Займы = ЭтотОбъект.КредитныйИнструмент;
		
		Если ЭтотОбъект.ОтложеннаяОплата Тогда
			// Задолженность по займу на дебиторку
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ЭтотОбъект.Сумма + ЭтотОбъект.СуммаПроцентов, "Задолженность на сумму погашения");
		
			// дебет
			Проводка["Счет"+СторонаДС] = ПланыСчетов.Основной.РасчетыСПрочимиПоставщикамиИПодрядчиками;
			Проводка["Субконто"+СторонаДС].Контрагенты = ДанныеКредитногоИнструмента.Контрагент;
			
			// кредит
			Проводка["Счет"+СторонаКредитногоИнструмента] = СчетУчетаАктива;
			Проводка["Субконто"+СторонаКредитногоИнструмента].Контрагенты = ДанныеКредитногоИнструмента.Контрагент;
			Проводка["Субконто"+СторонаКредитногоИнструмента].Займы = ЭтотОбъект.КредитныйИнструмент;
			
		Иначе
			// оплата полной суммы займа
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ЭтотОбъект.Сумма + ЭтотОбъект.СуммаПроцентов, "Возврат займа");
			
			// дебет
			Проводка["Счет"+СторонаДС] = СчетУчетаДС;
			
			Проводка["Субконто"+СторонаДС].БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
			
			Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда 
				Проводка["Субконто"+СторонаДС].ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ПогашениеЗайма;  
			КонецЕсли;
			
			// кредит
			Проводка["Счет"+СторонаКредитногоИнструмента] = СчетУчетаАктива;
			Проводка["Субконто"+СторонаКредитногоИнструмента].Контрагенты = ДанныеКредитногоИнструмента.Контрагент;
			Проводка["Субконто"+СторонаКредитногоИнструмента].Займы = ЭтотОбъект.КредитныйИнструмент;
		КонецЕсли;
			
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьДатуЗакрытияБанковскогоСчета(ДатаЗакрытия, Отказ)
	
	Если Не Отказ Тогда
		Если РежимЗакрытия = Перечисления.РежимыЗакрытияКредитногоИнструмента.Полное 
			ИЛИ РежимЗакрытия = Перечисления.РежимыЗакрытияКредитногоИнструмента.Досрочное
		Тогда
		
			Если ЗначениеЗаполнено(КредитныйИнструмент.БанковскийСчет) Тогда
				
				РеквизитыБанковскогоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КредитныйИнструмент.БанковскийСчет, "ВидБанковскогоСчета, ДатаЗакрытия, Договор");
				
				// Если закрываем вклад, то сначала закрываем исполнителей, потом счет и договор.
				// При отмене проведения даты закрытия снимаем в обратном порядке.
				
				ПорядокЗакрытия = Новый Массив;
				
				Если ЗначениеЗаполнено(ДатаЗакрытия) Тогда
					ПорядокЗакрытия.Добавить("Исполнители");
					ПорядокЗакрытия.Добавить("Счет");
					ПорядокЗакрытия.Добавить("Договор");
				Иначе
					ПорядокЗакрытия.Добавить("Договор");
					ПорядокЗакрытия.Добавить("Счет");
					ПорядокЗакрытия.Добавить("Исполнители");
				КонецЕсли;				
				
				Для Каждого ЗакрываемыеОбъекты Из ПорядокЗакрытия Цикл
					
					Если ЗакрываемыеОбъекты = "Исполнители" Тогда
						
						// закрываем исполнителей по д/с
						РаботаСИсполнителями.УстановитьДатуЗакрытия(КредитныйИнструмент.БанковскийСчет, ДатаЗакрытия);
						
					ИначеЕсли ЗакрываемыеОбъекты = "Счет" Тогда	
						
						// закрываем банковский счет
						Если РеквизитыБанковскогоСчета.ДатаЗакрытия <> НачалоДня(ДатаЗакрытия) Тогда
							БанковскийСчетОбъект = КредитныйИнструмент.БанковскийСчет.ПолучитьОбъект();
							БанковскийСчетОбъект.ДатаЗакрытия = ДатаЗакрытия;
							БанковскийСчетОбъект.Записать();
						КонецЕсли;
						
					ИначеЕсли ЗакрываемыеОбъекты = "Договор" Тогда	
					
						// закрываем договор депозитного вклада
						Если РеквизитыБанковскогоСчета.ВидБанковскогоСчета = Перечисления.ВидыБанковскихСчетов.ДепозитныйСчет 
							И ЗначениеЗаполнено(РеквизитыБанковскогоСчета.Договор)
						Тогда
					    	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыБанковскогоСчета.Договор, "ВидДоговора");
							
							Если (РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоров.БанковскогоОбслуживания ИЛИ РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоров.БанковскогоДепозита) Тогда
								ДатаРасторженияДоговора = Справочники.Договоры.ПолучитьДатуРасторженияДоговора(РеквизитыБанковскогоСчета.Договор);
								Если ДатаРасторженияДоговора <> НачалоДня(ДатаЗакрытия) Тогда
									Если ЗначениеЗаполнено(ДатаЗакрытия) Тогда
										РегистрыСведений.УсловияДоговоровОбщие.ДобавитьДатуРасторжения(ДатаЗакрытия, РеквизитыБанковскогоСчета.Договор, ДатаЗакрытия);
									Иначе //Считаем, что в эту дату условия создал этот документ
										НаборЗаписей = РегистрыСведений.УсловияДоговоровОбщие.СоздатьНаборЗаписей();
										НаборЗаписей.Отбор.Период.Установить(НачалоДня(ЭтотОбъект.Дата));
										НаборЗаписей.Отбор.Договор.Установить(РеквизитыБанковскогоСчета.Договор);
										НаборЗаписей.Прочитать();
										
										Если НаборЗаписей.Количество() = 1 И НаборЗаписей[0].ДатаРасторжения = НачалоДня(ЭтотОбъект.Дата) Тогда
											НаборЗаписей.Очистить();
											НаборЗаписей.Записать();
										КонецЕсли;
										
									КонецЕсли;
								КонецЕсли;
								
							КонецЕсли;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
