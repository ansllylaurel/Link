	<Attributes>
		<Attribute name="Список" id="1">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Список</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговора,
	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК Договор,
	СчетаДоверительногоУправления.НомерДоговора КАК Номер,
	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения
ИЗ
	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&amp;Период, Клиент = &amp;ЮрФизЛицо) КАК КлиентыДоверительногоУправленияСрезПоследних
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
ГДЕ
	СчетаДоверительногоУправления.Организация = &amp;Организация
	И (&amp;Период = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ СчетаДоверительногоУправления.ДатаЗаключения &lt;= &amp;Период
				И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
					ИЛИ СчетаДоверительногоУправления.ДатаРасторжения &gt;= &amp;Период))

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Договоры.ВидДоговора,
	Договоры.Ссылка,
	Договоры.НомерДоговора,
	Договоры.ДатаЗаключения,
	УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения
ИЗ
	Справочник.Договоры КАК Договоры
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&amp;Период, ) КАК УсловияДоговоровОбщиеСрезПоследних
		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = Договоры.Ссылка)
ГДЕ
	Договоры.Организация = &amp;Организация
	И Договоры.Контрагент = &amp;ЮрФизЛицо
	И (&amp;Период = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ Договоры.ДатаЗаключения &lt;= &amp;Период
				И (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
					ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
					ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения &gt;= &amp;Период))</QueryText>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
