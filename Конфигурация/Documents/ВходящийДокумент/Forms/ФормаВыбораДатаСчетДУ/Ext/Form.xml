			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ 
	ДокументВходящийДокумент.Ссылка КАК Ссылка,
	ДокументВходящийДокумент.ПометкаУдаления КАК ПометкаУдаления,
	ДокументВходящийДокумент.Номер КАК Номер,
	ДокументВходящийДокумент.Дата КАК Дата,
	ДокументВходящийДокумент.Проведен КАК Проведен,
	ДокументВходящийДокумент.Организация КАК Организация,
	ВходящийДокументДоговоры.Договор КАК СчетДоверительногоУправления,
	ДокументВходящийДокумент.Отправитель КАК Отправитель,
	ПОДСТРОКА(ДокументВходящийДокумент.ВидВходящегоДокумента, 0, 1000) КАК ВидДокумента,
	ДокументВходящийДокумент.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	ДокументВходящийДокумент.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	ДокументВходящийДокумент.Ответственный КАК Ответственный,
	ДокументВходящийДокумент.МоментВремени КАК МоментВремени
ИЗ
	Документ.ВходящийДокумент КАК ДокументВходящийДокумент
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВходящийДокумент.Операции КАК ВходящийДокументОперации
		ПО (ВходящийДокументОперации.Ссылка = ДокументВходящийДокумент.Ссылка)
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВходящийДокумент.Договоры КАК ВходящийДокументДоговоры
		ПО (ВходящийДокументДоговоры.Ссылка = ДокументВходящийДокумент.Ссылка)
ГДЕ
	ВходящийДокументДоговоры.Договор = &amp;СчетДоверительногоУправления
	И ДокументВходящийДокумент.Проведен = ИСТИНА
	И ДокументВходящийДокумент.Организация = &amp;Организация

СГРУППИРОВАТЬ ПО
	ДокументВходящийДокумент.Ссылка,
	ДокументВходящийДокумент.ПометкаУдаления,
	ДокументВходящийДокумент.Номер,
	ДокументВходящийДокумент.Дата,
	ДокументВходящийДокумент.Проведен,
	ДокументВходящийДокумент.Организация,
	ДокументВходящийДокумент.Отправитель,
	ПОДСТРОКА(ДокументВходящийДокумент.ВидВходящегоДокумента, 0, 1000),
	ДокументВходящийДокумент.НомерВходящегоДокумента,
	ДокументВходящийДокумент.ДатаВходящегоДокумента,
	ДокументВходящийДокумент.Ответственный,
	ДокументВходящийДокумент.МоментВремени,
	ВходящийДокументДоговоры.Договор</QueryText>
				<MainTable>Document.ВходящийДокумент</MainTable>
