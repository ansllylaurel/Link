
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация") = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ДК") Тогда
		ЭтотОбъект.ТипВходящегоДокумента = Перечисления.ТипыВходящихДокументов.ВходящийДокументДепозитарнойКомпании;
	Иначе
		ЭтотОбъект.Статус = Перечисления.СтатусыВходящихДокументов.НаРегистрации;
	КонецЕсли;
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.ОснованияОперацийСАктивамиСтраховыхКомпаний.Записывать = Истина;
	
	Если ТипВходящегоДокумента = Перечисления.ТипыВходящихДокументов.ВходящийДокументДепозитарнойКомпании Тогда
		Для Каждого ТекСтрокаОперации Из Операции Цикл
			
			Движение = Движения.ОснованияОперацийСАктивамиСтраховыхКомпаний.Добавить();
			Движение.Организация					= Организация;
			Движение.СчетДоверительногоУправления	= Договоры[0].Договор;
			Движение.Операция						= ТекСтрокаОперации.Операция;
			Движение.ВидДокументаОснования			= ВидВходящегоДокумента;
			Движение.НомерДокументаОснования		= НомерВходящегоДокумента;
			Движение.ДатаДокументаОснования			= ДатаВходящегоДокумента;	
			Движение.Основание						= Ссылка;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	Если ЭтотОбъект.ТипВходящегоДокумента = Перечисления.ТипыВходящихДокументов.ВходящийДокументДепозитарнойКомпании Тогда
		ЭтотОбъект.Дата = ОбъектКопирования.Дата;
		ЭтотОбъект.Операции.Очистить();
		ЭтотОбъект.Ответственный = РаботаСПользователями.ТекущийПользователь();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если ТипВходящегоДокумента = Перечисления.ТипыВходящихДокументов.ВходящийДокументДепозитарнойКомпании Тогда
		
		ТекДоговор = Справочники.СчетаДоверительногоУправления.ПустаяСсылка();
		Если ЭтотОбъект.Договоры.Количество() <> 0 Тогда
			ТекДоговор = ЭтотОбъект.Договоры[0].Договор;
		КонецЕсли; 
		
		Для Каждого ТекСтрокаОперации Из Операции Цикл
			Если Не ЗначениеЗаполнено(ТекСтрокаОперации.Операция) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Внимание! Не выбрана операция в строке " + ТекСтрокаОперации.НомерСтроки +"'"))
			ИначеЕсли ТекСтрокаОперации.Операция.СчетДоверительногоУправления <> ТекДоговор Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не совпадает счет доверительного управления в документе (" + ТекДоговор + ") и операции №" + ТекСтрокаОперации.НомерСтроки + " (" +ТекСтрокаОперации.Операция.СчетДоверительногоУправления + ")'"), ЭтотОбъект, "Облигация",, Отказ);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		Если (ЭтотОбъект.ТипВходящегоДокумента = Перечисления.ТипыВходящихДокументов.Жалоба
			Или ЭтотОбъект.ТипВходящегоДокумента = Перечисления.ТипыВходящихДокументов.ЖалобаИногоЛица
			Или ЭтотОбъект.ТипВходящегоДокумента = Перечисления.ТипыВходящихДокументов.ОбращениеКлиента
			Или ЭтотОбъект.ТипВходящегоДокумента = Перечисления.ТипыВходящихДокументов.ОбращениеПотенциальногоКлиента
			Или ЭтотОбъект.ТипВходящегоДокумента = Перечисления.ТипыВходящихДокументов.ОбращениеИное) И 
			Не (ЭтотОбъект.ПоЛицензииДУ Или ЭтотОбъект.ПоЛицензииУКПИФ Или ЭтотОбъект.ПоСобственнойДеятельностиУК) Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо заполнить вид деятельности", ЭтотОбъект.Ссылка,,, Отказ); 
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Не ЭтотОбъект.ТипВходящегоДокумента = Перечисления.ТипыВходящихДокументов.ВходящийДокументДепозитарнойКомпании Тогда
	
		ПроверяемыеРеквизиты.Добавить("Отправитель");
		ПроверяемыеРеквизиты.Добавить("ВидВходящегоДокумента");
		ПроверяемыеРеквизиты.Добавить("ДатаВходящегоДокумента");
		Если ЭтотОбъект.Дата >= '20250312' Тогда
			ПроверяемыеРеквизиты.Добавить("СпособПолучения");
		КонецЕсли;		
		
		Если ЭтотОбъект.ТипВходящегоДокумента = Перечисления.ТипыВходящихДокументов.Жалоба 
			Или ЭтотОбъект.ТипВходящегоДокумента = Перечисления.ТипыВходящихДокументов.ЖалобаИногоЛица
			Или ЭтотОбъект.ТипВходящегоДокумента = Перечисления.ТипыВходящихДокументов.ОбращениеКлиента Тогда
			
			ПроверяемыеРеквизиты.Добавить("ВариантОбращения");
			
			Если ЭтотОбъект.ТипВходящегоДокумента = Перечисления.ТипыВходящихДокументов.Жалоба Тогда
				ПроверяемыеРеквизиты.Добавить("Договоры");
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(ЭтотОбъект.ДатаВыплаты) Или ЗначениеЗаполнено(ЭтотОбъект.СуммаВыплаты) Тогда
				ПроверяемыеРеквизиты.Добавить("ДатаВыплаты");
				ПроверяемыеРеквизиты.Добавить("СуммаВыплаты");
			КонецЕсли; 
			
		КонецЕсли; 
		
		Если РольДоступна("Документооборот") Тогда
			ПроверяемыеРеквизиты.Добавить("ТипВходящегоДокумента");
		КонецЕсли; 
	
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	РаботаСДокументооборотом.ПриУстановкеНовогоНомера(ЭтотОбъект, СтандартнаяОбработка, Префикс);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ТипВходящегоДокумента <> Перечисления.ТипыВходящихДокументов.ВходящийДокументДепозитарнойКомпании Тогда
		
		Если ДополнительныеСвойства.ЭтоНовый Тогда
		
			ПредыдущийРабочийДень = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДата(), -2);
			Если ЭтотОбъект.ДатаВходящегоДокумента < ПредыдущийРабочийДень Тогда
				
				Тема = "Входящие Т-2";
				Текст = "Зарегистрирован входящий документ " + ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(ЭтотОбъект) + "<br>" +
					"Отправитель: " + ЭтотОбъект.Отправитель + "<br>" +
					"Исходящий документ №" + ЭтотОбъект.НомерВходящегоДокумента + " от " + Формат(ЭтотОбъект.ДатаВходящегоДокумента, "ДФ=dd.MM.yyyy") + "<br>" +
					"Краткое описание: " + ЭтотОбъект.ВидВходящегоДокумента;
				
				РеквизитыОповещения = Новый Структура("Организация, Тема, Текст", ЭтотОбъект.Организация, Тема, Текст); 
				Справочники.Оповещения.СформироватьОповещения(Метаданные().ПолноеИмя() + ".ОповещенияОРегистрацииЗаПрошлыеДаты", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
				
			КонецЕсли;
			
			СоздатьИсходящийДокумент(Отказ);
		
		Иначе
			
			#Область Проверка_зацикленности_оснований
			ТекстЗапроса = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	Основания.Основание КАК Основание,
				|	Основания.НомерСтроки КАК НомерСтроки
				|ПОМЕСТИТЬ _Основания
				|ИЗ
				|	&Основания КАК Основания
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_Основания.НомерСтроки КАК НомерСтроки,
				|	_Основания.Основание КАК Основание,
				|	ИсходящийДокументОснования.Ссылка КАК ИсходящийДокумент
				|ИЗ
				|	_Основания КАК _Основания
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсходящийДокумент.Основания КАК ИсходящийДокументОснования
				|		ПО _Основания.Основание = ИсходящийДокументОснования.Ссылка
				|			И (ИсходящийДокументОснования.Основание = &Ссылка)";
			
			Запрос = Новый Запрос(ТекстЗапроса);
			Запрос.УстановитьПараметр("Основания", ЭтотОбъект.Основания.Выгрузить());
			Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
			
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				ТекстСообщения = СтрШаблон("Данный документ является основанием для документа %1. Два документа не могут являться основаниями друг для друга", Выборка.ИсходящийДокумент);
				Поле = СтрШаблон("Объект.Основания[%1].Основание", (Выборка.НомерСтроки - 1));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка, Поле,, Отказ);
			
			КонецЦикла;				
			#КонецОбласти 
		
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура СоздатьИсходящийДокумент(Отказ)

	Если ТипЗнч(ЭтотОбъект.Отправитель) = Тип("СправочникСсылка.ЮрФизЛица")
		И ЭтотОбъект.СпособПолучения <> Перечисления.СпособыПолученияДокументов.БумажныйДокумент Тогда
				
		УстановитьПривилегированныйРежим(Истина);
		
		НеТребуетсяАвтоответ = Документы.ИсходящийДокумент.ПоСоглашениюОбЭдоНеТребуетсяАвтоответ(ЭтотОбъект);
				
		Если ЗначениеЗаполнено(НеТребуетсяАвтоответ) И НеТребуетсяАвтоответ Тогда
			Возврат;
		КонецЕсли;
		
		ОтправительЯвляетсяКлиентом = Документы.ВходящийДокумент.ПроверитьНаличиеДоговоровЗаПятьЛет(
			ЭтотОбъект.Отправитель, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
		УстановитьПривилегированныйРежим(Ложь);
		
		Если ОтправительЯвляетсяКлиентом Тогда
			
			ИсходящиеДокументыМенеджер = Документы.ИсходящийДокумент;
			
			ИсходящийДокумент = ИсходящиеДокументыМенеджер.СоздатьДокумент();
			ИсходящийДокумент.Заполнить(ЭтотОбъект.Ссылка);
			ИсходящийДокумент.Дата = ТекущаяДатаСеанса();
			
			Если Не ЗначениеЗаполнено(ЭтотОбъект.ОтветственныйСотрудник) Тогда
				
				ЮрФизЛицоОтветственного = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Ответственный, "ЮрФизЛицо");
				
				Если ЗначениеЗаполнено(ЮрФизЛицоОтветственного) Тогда
					ИсходящийДокумент.Исполнитель = ЮрФизЛицоОтветственного;
				Иначе
					ИсходящийДокумент.Исполнитель = ЭтотОбъект.Ответственный;
				КонецЕсли;
				
			КонецЕсли;
			
			ИсходящийДокумент.Подписал = "Уполномоченное лицо";
			
			ИсходящийДокумент.Описание = "Ответ о получении";
			ИсходящийДокумент.Содержание = ИсходящиеДокументыМенеджер.ПолучитьСодержаниеОтветаНаОбращение(
				ИсходящийДокумент.Дата, ИсходящийДокумент.Организация, ИсходящийДокумент.Основания.ВыгрузитьКолонку("Основание"));
			
			Попытка
				
				ИсходящийДокумент.Записать();
				
			Исключение
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сформировать ответ о получении. Система сообщает: " + ОписаниеОшибки(),,,, Отказ);
				
			КонецПопытки;
			
			Если Не Отказ Тогда
				
				Объект = "Документы.ИсходящийДокумент";
				Команда = "СформироватьИОтправитьУведомлениеОПолучении";
				ТекстОшибки = СтрШаблон("Не удалось добавить отложенное задание '%1.%2' при записи входящего документа.", Объект, Команда);
				
				Параметры = Новый Структура;
				
				Параметры.Вставить("Организация", 		ЭтотОбъект.Организация);
				Параметры.Вставить("ВходящийДокумент", 	ЭтотОбъект.Ссылка);
				Параметры.Вставить("ИсходящийДокумент", ИсходящийДокумент.Ссылка);
				Параметры.Вставить("ТекстОшибки",		ТекстОшибки);
				Параметры.Вставить("ИсточникОшибки",	"Исходящий документ");
				
				РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание(Объект, Команда, Параметры, 5, Истина);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

