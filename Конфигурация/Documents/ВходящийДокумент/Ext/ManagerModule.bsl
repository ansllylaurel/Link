
Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Если ВидФормы = "ФормаОбъекта" Тогда
		Если РольДоступна("ДокументооборотРегистрацияДокументов") И 
				Не (РольДоступна("Документооборот") Или РольДоступна("ДокументооборотПросмотр") Или РольДоступна("ПолныеПрава")) Тогда
			СтандартнаяОбработка = Ложь;	
			ВыбраннаяФорма = "ФормаРегистрацииДокумента";
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	Если Не Данные.ТипВходящегоДокумента = Перечисления.ТипыВходящихДокументов.ВходящийДокументДепозитарнойКомпании Тогда
	
		СтандартнаяОбработка = Ложь;
		
		НомерВходящегоДокумента = СокрЛП(Данные.НомерВходящегоДокумента);
		НомерВходящегоДокумента = ?(ЗначениеЗаполнено(НомерВходящегоДокумента), "№" + НомерВходящегоДокумента, "б/н");
		
		Представление = "Входящий документ №" + Данные.Номер + " от " + Формат(Данные.Дата, "ДФ=dd.MM.yyyy") + " (исх. " + НомерВходящегоДокумента + " от " + Формат(Данные.ДатаВходящегоДокумента, "ДФ=dd.MM.yyyy") + ")";
	
	КонецЕсли; 

КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля.Добавить("Дата");
	Поля.Добавить("Номер");
	Поля.Добавить("ТипВходящегоДокумента");
	Поля.Добавить("ДатаВходящегоДокумента");
	Поля.Добавить("НомерВходящегоДокумента");
	
КонецПроцедуры

Функция ПроверитьНаличиеДоговоровЗаПятьЛет(Отправитель, Организация, Дата) Экспорт 

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СчетаКлиента.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	(ВЫБРАТЬ
		|		КлиентыДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|	ИЗ
		|		РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
		|	ГДЕ
		|		КлиентыДоверительногоУправления.Организация = &Организация
		|		И КлиентыДоверительногоУправления.Клиент = &Клиент
		|		И КлиентыДоверительногоУправления.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|	ИЗ
		|		РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаНачала, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|	ГДЕ
		|		КлиентыДоверительногоУправленияСрезПоследних.Клиент = &Клиент) КАК СчетаКлиента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО (СчетаКлиента.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|				И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания
		|				И (СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаНачала
		|					ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)))";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Клиент", Отправитель);
	Запрос.УстановитьПараметр("ДатаНачала", ДобавитьМесяц(НачалоДня(Дата), -60));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Дата));		
	
	// проверяем в привилегированном режиме, т.к. у пользователя может не быть доступа к счетам ДУ, но оповещения должны быть созданы
	УстановитьПривилегированныйРежим(Истина); 
	
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции 