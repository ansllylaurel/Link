&НаСервере
Процедура ЗаполнитьДокументыНаЭкспортНаСервере()
	
	ЭтаФорма.ПлатежныеПоручения.Очистить();
	
	Если ЭтаФорма.ВыгрузитьПорученияСоСтраницыФормирование Тогда
		
		ОтборПлатежныеПоручения.Очистить();
		
		// Готовые платежки добавляем в список с отбором				
		ЗаполнитьОтборСформированнымиПлатежнымиПоручениямиНаСервере();
					
		Если ОтборПлатежныеПоручения.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На закладке 'Формирование' отсутствуют платежные поручения"); 
			Возврат;
		КонецЕсли; 
	Иначе
		ОтборПлатежныеПоручения.Очистить();	
	КонецЕсли;

	ТаблицаДокументовДляЭкспорта = ПолучитьТаблицуДокументовДляЭкспорта(Организация, 
											Дата, 
											Банк, 
											РасчетныйСчет, 
											ОтборПлатежныеПоручения);
	
	Колонки = ЭтаФорма.ПлатежныеПоручения.Выгрузить().Колонки;
	Для каждого СтрокаТаблицыДляЭкспорта Из ТаблицаДокументовДляЭкспорта Цикл
		
		СтрокаДокумента = ЭтаФорма.ПлатежныеПоручения.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаТаблицыДляЭкспорта);
		
		ПроверитьНаКорректностьИПустоеЗначениеЭкспорта(СтрокаДокумента, Колонки);
		
		СтрокаДокумента.Выгружать = ПустаяСтрока(СтрокаДокумента.ОписаниеОшибок)
			И СтрокаДокумента.СтатусПлатежногоПоручения = Перечисления.СтатусыПлатежныхПоручений.Создано;
		
		Если СтрокаДокумента.Готовность > 0 Тогда
			СтрокаДокумента.ОписаниеОшибок = СтрокаДокумента.ОписаниеОшибок;
		Иначе
			СтрокаДокумента.ОписаниеОшибок = НСтр("ru = 'Документ готов к выгрузке.'");
		КонецЕсли;
		
	КонецЦикла;
	
	ОбновитьИтогиВПодвале();

КонецПроцедуры // ЗаполнитьДокументыНаЭкспорт

&НаСервере
Процедура ЗаполнитьОтборСформированнымиПлатежнымиПоручениямиНаСервере(КоллекцияСтрок = Неопределено)

	КоллекцияСтрок = ?(КоллекцияСтрок = Неопределено, ЭтаФорма.ДокументыДляФормированияПлатежныхПоручений.ПолучитьЭлементы(), КоллекцияСтрок);
	
	Если КоллекцияСтрок = Неопределено Тогда
		ПлатежныеПорученияДляВыгрузкиВЭДОВТБ.Очистить();
	КонецЕсли;
	
	Для Каждого ТекСтрока Из КоллекцияСтрок Цикл
		
		Если Не ЗначениеЗаполнено(ТекСтрока.ДокументОснование) Тогда
			ЗаполнитьОтборСформированнымиПлатежнымиПоручениямиНаСервере(ТекСтрока.ПолучитьЭлементы());
		ИначеЕсли ЗначениеЗаполнено(ТекСтрока.Документ) Тогда
			
			СчетДУСтроки		= ТекСтрока.ПолучитьРодителя().ПолучитьРодителя().СчетДоверительногоУправления;
			РеквизитыСчетаДУ	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетДУСтроки, "ВидДоговораДоверительногоУправления, СпециализированныйДепозитарий");
			ЭтоХантыСС			= Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДУСтроки, ЭтаФорма.Дата) = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФХантыМансийский")			
								И РеквизитыСчетаДУ.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов;
								
			Если РеквизитыСчетаДУ.СпециализированныйДепозитарий = СпецдепВТБ Или ЭтоХантыСС Тогда
				ПлатежныеПорученияДляВыгрузкиВЭДОВТБ.Добавить(ТекСтрока.Документ);		
			КонецЕсли;
			
			ОтборПлатежныеПоручения.Добавить(ТекСтрока.Документ);
			
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТаблицуДокументовДляЭкспорта(Организация, Дата, Банк, РасчетныйСчет, ОтборПлатежныеПоручения)
	
	Запрос = Новый Запрос;	
		
	#Область Текст_запроса
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	""Платежное поручение"" КАК ВидДокумента,
	|	ПлатежноеПоручение.Ссылка КАК Документ,
	|	ПлатежноеПоручение.Проведен КАК Проведен,
	|	ПлатежноеПоручение.НомерПлатежногоПоручения КАК Номер,
	|	ПлатежноеПоручение.Дата КАК Дата,
	|	ПлатежноеПоручение.ВидПлатежа КАК ВидПлатежа,
	|	ПлатежноеПоручение.ПеречислениеВБюджет КАК ПеречислениеВБюджет,
	|	ПлатежноеПоручение.ОчередностьПлатежа КАК ОчередностьПлатежа,
	|	ВЫРАЗИТЬ(ПлатежноеПоручение.НазначениеПлатежа КАК СТРОКА(210)) КАК НазначениеПлатежа,
	|	ПлатежноеПоручение.Сумма КАК Сумма,
	|	ПлатежноеПоручение.Сумма КАК СуммаНаРасход,
	|	ВЫРАЗИТЬ(ПлатежноеПоручение.ТекстПлательщика КАК СТРОКА(500)) КАК ТекстПлательщика,
	|	ВЫРАЗИТЬ(ПлатежноеПоручение.ТекстПолучателя КАК СТРОКА(500)) КАК ТекстПолучателя,
	|	РеквизитыОрганизации.ИНН КАК ИННПлательщика,
	|	ВЫБОР
	|		КОГДА &ВыгружатьКППКрупнейшегоНалогоплательщика
	|			ТОГДА РеквизитыОрганизации.КППКрупнейшегоНалогоплательщика
	|		ИНАЧЕ РеквизитыОрганизации.КПП
	|	КОНЕЦ КАК КПППлательщика,
	|	ВЫБОР
	|		КОГДА ПлатежноеПоручение.Контрагент.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
	|			ТОГДА ЕСТЬNULL(РеквизитыКонтрагентаЮрЛицаАнкетные.ИНН, РеквизитыКонтрагентаЮрЛица.ИНН)
	|		ИНАЧЕ РеквизитыКонтрагентаФизЛицаАнкетные.ИНН
	|	КОНЕЦ КАК ИННПолучателя,
	|	ВЫБОР
	|		КОГДА ПлатежноеПоручение.Контрагент.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
	|			ТОГДА ЕСТЬNULL(РеквизитыКонтрагентаЮрЛицаАнкетные.КПП, РеквизитыКонтрагентаЮрЛица.КПП)
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КПППолучателя,
	|	ПлатежноеПоручение.КодБК КАК КодБК,
	|	ПлатежноеПоручение.КодОКТМО КАК КодОКАТО,
	|	ПлатежноеПоручение.ПоказательДаты КАК ПоказательДаты,
	|	ПлатежноеПоручение.ПоказательНомера КАК ПоказательНомера,
	|	ПлатежноеПоручение.ПоказательОснования КАК ПоказательОснования,
	|	ПлатежноеПоручение.ПоказательПериода КАК ПоказательПериода,
	|	ПлатежноеПоручение.СтатусСоставителя КАК СтатусСоставителя,
	|	ПлатежноеПоручение.ПоказательТипа КАК ПоказательТипа,
	|	ВЫРАЗИТЬ(РеквизитыОрганизации.КраткоеНаименованиеПоУставу КАК СТРОКА(250)) КАК Организация,
	|	РеквизитыОрганизации.ИНН КАК ОрганизацияИНН,
	|	РеквизитыОрганизации.КПП КАК ОрганизацияКПП,
	|	ПлатежноеПоручение.РасчетныйСчет КАК ОрганизацияСчет,
	|	ПлатежноеПоручение.РасчетныйСчет.НомерСчета КАК ОрганизацияНомерСчета,
	|	ПлатежноеПоручение.РасчетныйСчет.Банк.Код КАК ОрганизацияБИКБанка,
	|	ПлатежноеПоручение.РасчетныйСчет.Банк.Наименование КАК ОрганизацияБанк,
	|	ПлатежноеПоручение.РасчетныйСчет.Банк.КоррСчет КАК ОрганизацияРасчСчет,
	|	ПлатежноеПоручение.РасчетныйСчет.Банк.Город КАК ОрганизацияГородБанка,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА ПлатежноеПоручение.ПеречислениеВБюджет
	|				ТОГДА &ТекстПолучателя
	|			КОГДА ПлатежноеПоручение.Контрагент.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
	|				ТОГДА ЕСТЬNULL(РеквизитыКонтрагентаЮрЛицаАнкетные.КраткоеНаименованиеПоУставу, РеквизитыКонтрагентаЮрЛица.КраткоеНаименованиеПоУставу)
	|			ИНАЧЕ РеквизитыКонтрагентаФизЛицаАнкетные.Фамилия + "" "" + РеквизитыКонтрагентаФизЛицаАнкетные.Имя + "" "" + РеквизитыКонтрагентаФизЛицаАнкетные.Отчество
	|		КОНЕЦ КАК СТРОКА(250)) КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ПлатежноеПоручение.Контрагент.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
	|			ТОГДА ЕСТЬNULL(РеквизитыКонтрагентаЮрЛицаАнкетные.ИНН, РеквизитыКонтрагентаЮрЛица.ИНН)
	|		ИНАЧЕ РеквизитыКонтрагентаФизЛицаАнкетные.ИНН
	|	КОНЕЦ КАК КонтрагентИНН,
	|	ВЫБОР
	|		КОГДА ПлатежноеПоручение.Контрагент.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
	|			ТОГДА ЕСТЬNULL(РеквизитыКонтрагентаЮрЛицаАнкетные.КПП, РеквизитыКонтрагентаЮрЛица.КПП)
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КонтрагентКПП,
	|	ПлатежноеПоручение.РасчетныйСчетКонтрагента КАК КонтрагентСчет,
	|	ПлатежноеПоручение.РасчетныйСчетКонтрагента.НомерСчета КАК КонтрагентНомерСчета,
	|	ПлатежноеПоручение.РасчетныйСчетКонтрагента.Банк.Код КАК КонтрагентБИКБанка,
	|	ПлатежноеПоручение.РасчетныйСчетКонтрагента.Банк.Наименование КАК КонтрагентБанк,
	|	ПлатежноеПоручение.РасчетныйСчетКонтрагента.Банк.КоррСчет КАК КонтрагентРасчСчет,
	|	ПлатежноеПоручение.РасчетныйСчетКонтрагента.Банк.Город КАК КонтрагентГородБанка,
	|	"""" КАК ОписаниеОшибок,
	|	"""" КАК Готовность,
	|	ПлатежноеПоручение.ИдентификаторПлатежа КАК ИдентификаторПлатежа,
	|	СтатусыИсходящихПлатежныхПоручений.Статус КАК СтатусПлатежногоПоручения,
	|	ПлатежноеПоручение.Организация КАК ОрганизацияСсылка
	|ИЗ
	|	Документ.ПлатежноеПоручениеИсходящее КАК ПлатежноеПоручение
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
	|				&ДатаОкончания,
	|				Организация = &Организация
	|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыОрганизации
	|		ПО ПлатежноеПоручение.Организация.ЮрФизЛицо = РеквизитыОрганизации.ЮрФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
	|				&ДатаОкончания,
	|				Организация = &Организация
	|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыКонтрагентаЮрЛицаАнкетные
	|		ПО ПлатежноеПоручение.Контрагент = РеквизитыКонтрагентаЮрЛицаАнкетные.ЮрФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
	|				&ДатаОкончания,
	|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
	|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыКонтрагентаЮрЛица
	|		ПО ПлатежноеПоручение.Контрагент = РеквизитыКонтрагентаЮрЛица.ЮрФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
	|				&ДатаОкончания,
	|				Организация = &Организация
	|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыКонтрагентаФизЛицаАнкетные
	|		ПО ПлатежноеПоручение.Контрагент = РеквизитыКонтрагентаФизЛицаАнкетные.ЮрФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыИсходящихПлатежныхПоручений.СрезПоследних(&ДатаОкончания, ) КАК СтатусыИсходящихПлатежныхПоручений
	|		ПО ПлатежноеПоручение.Организация = СтатусыИсходящихПлатежныхПоручений.Организация
	|			И ПлатежноеПоручение.Ссылка = СтатусыИсходящихПлатежныхПоручений.ПлатежноеПоручениеИсходящее
	|ГДЕ
	|	ПлатежноеПоручение.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И &ДополнительноеУсловиеПлатежныеПоручения
	|	И &ДополнительноеУсловиеБанк
	|	И &ДополнительноеУсловиеРасчетныйСчет
	|	И НЕ ПлатежноеПоручение.ПометкаУдаления
	|	И ЕСТЬNULL(СтатусыИсходящихПлатежныхПоручений.Статус, НЕОПРЕДЕЛЕНО) В (ЗНАЧЕНИЕ(Перечисление.СтатусыПлатежныхПоручений.Создано), ЗНАЧЕНИЕ(Перечисление.СтатусыПлатежныхПоручений.Выгружено))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидДокумента,
	|	ПлатежноеПоручение.Дата,
	|	Документ";
	
	#КонецОбласти
	
	Запрос.УстановитьПараметр("ДатаНачала",    								Дата);
	Запрос.УстановитьПараметр("ДатаОкончания", 								КонецДня(Дата));
	Запрос.УстановитьПараметр("Организация", 								Организация);
	Запрос.УстановитьПараметр("ВыгружатьКППКрупнейшегоНалогоплательщика",	Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ"));
	Запрос.УстановитьПараметр("ДополнительноеУсловиеПлатежныеПоручения",	Истина);
	Запрос.УстановитьПараметр("ДополнительноеУсловиеБанк",					Истина);
	Запрос.УстановитьПараметр("ДополнительноеУсловиеРасчетныйСчет",			Истина);
	
	РеквизитыПлатежаВБюджет = Документы.ПлатежноеПоручениеИсходящее.РеквизитыПеречисленияВБюджетПоУмолчанию();
	Запрос.УстановитьПараметр("ТекстПолучателя", 							РеквизитыПлатежаВБюджет.ТекстПолучателя);
	
	Если ОтборПлатежныеПоручения.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДополнительноеУсловиеПлатежныеПоручения", "ПлатежноеПоручение.Ссылка В (&ПлатежныеПоручения)");
		Запрос.УстановитьПараметр("ПлатежныеПоручения", ОтборПлатежныеПоручения.ВыгрузитьЗначения());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Банк) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДополнительноеУсловиеБанк", "ПлатежноеПоручение.РасчетныйСчет.Банк = &Банк");
		Запрос.УстановитьПараметр("Банк", Банк);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РасчетныйСчет) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДополнительноеУсловиеРасчетныйСчет", "ПлатежноеПоручение.РасчетныйСчет = &РасчетныйСчет");
		Запрос.УстановитьПараметр("РасчетныйСчет", РасчетныйСчет);
	КонецЕсли;
	
	ТаблицаПлатежныхДокументов = Запрос.Выполнить().Выгрузить();
	ТаблицаПлатежныхДокументов.Колонки.Добавить("НомерВФорматеВыгрузки", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(11)));
	Для Каждого ПлатежныйДокумент Из ТаблицаПлатежныхДокументов Цикл
		
		ПлатежныйДокумент.НомерВФорматеВыгрузки = Формат(ПлатежныйДокумент.Номер, "ЧГ=0");
						
		ПлатежныйДокумент.ТекстПолучателя	= ЗаменитьПереносыСтроки(ПлатежныйДокумент.ТекстПолучателя);		
		ПлатежныйДокумент.ТекстПлательщика	= ЗаменитьПереносыСтроки(ПлатежныйДокумент.ТекстПлательщика);
		
		ЗаполнитьНулемПустыеЗначенияРеквизитовПлатежаВБюджет(ПлатежныйДокумент);
				
	КонецЦикла;
	
	Возврат ТаблицаПлатежныхДокументов;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьНулемПустыеЗначенияРеквизитовПлатежаВБюджет(СтрокаЭкспорта) Экспорт
	
	Если НЕ СтрокаЭкспорта.ПеречислениеВБюджет Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(СтрокаЭкспорта.КПППлательщика) Тогда
		СтрокаЭкспорта.КПППлательщика = "0";
	КонецЕсли;
	
	Если ПустаяСтрока(СтрокаЭкспорта.КПППолучателя) Тогда
		СтрокаЭкспорта.КПППолучателя = "0";
	КонецЕсли;
	
	Если ПустаяСтрока(СтрокаЭкспорта.КодБК) Тогда
		СтрокаЭкспорта.КодБК = "0";
	КонецЕсли;
	
	Если ПустаяСтрока(СтрокаЭкспорта.КодОКАТО) Тогда
		СтрокаЭкспорта.КодОКАТО = "0";
	КонецЕсли;
	
	Если ПустаяСтрока(СтрокаЭкспорта.ПоказательОснования) Тогда
		СтрокаЭкспорта.ПоказательОснования = "0";
	КонецЕсли;
	
	Если ПустаяСтрока(СтрокаЭкспорта.ПоказательПериода) Тогда
		СтрокаЭкспорта.ПоказательПериода = "0";
	КонецЕсли;
	
	Если ПустаяСтрока(СтрокаЭкспорта.ПоказательНомера) Тогда
		СтрокаЭкспорта.ПоказательНомера = "0";
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(СтрокаЭкспорта.ПоказательТипа) Тогда
		СтрокаЭкспорта.ПоказательТипа = "";
	КонецЕсли;
	
	Если ПустаяСтрока(СтрокаЭкспорта.ПоказательДаты) Тогда
		СтрокаЭкспорта.ПоказательДаты = "0";
	КонецЕсли;
	
	Если ПустаяСтрока(СтрокаЭкспорта.ИдентификаторПлатежа) Тогда
		СтрокаЭкспорта.ИдентификаторПлатежа = "0";
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаменитьПереносыСтроки(ТекстРеквизита)
		
	ТекстРеквизита = СтрЗаменить(ТекстРеквизита, Символы.ПС + Символы.ВК, " ");
		
	Возврат ТекстРеквизита;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьНаКорректностьИПустоеЗначениеЭкспорта(СтрокаДокумента, КоллекцияЭлементов)
	  	 	
	ПеречислениеНалога           = ЗначениеЗаполнено(СтрокаДокумента.СтатусСоставителя);
	СтрокаДокумента.ТипДокумента = ?(ПеречислениеНалога, 1, 0) * 4 + 1;
	Плательщик    = "Организация";
	Получатель    = "Контрагент";
	ПлательщикИНН = "ИННПлательщика";
	ПолучательИНН = "ИННПолучателя";
		
	Экспорт_НеПустые = Новый Структура("Номер, Дата, Сумма");	
	
	Экспорт_НеПустые.Вставить(ПлательщикИНН);
	Экспорт_НеПустые.Вставить(Плательщик);
	Экспорт_НеПустые.Вставить(Плательщик + "Счет");	
	Экспорт_НеПустые.Вставить(ПолучательИНН);
	Экспорт_НеПустые.Вставить(Получатель);
	Экспорт_НеПустые.Вставить(Получатель + "Счет");
	
	Для каждого Свойство Из Экспорт_НеПустые Цикл
		ПроверитьНаПустоеЗначениеЭкспорта(СтрокаДокумента, Свойство.Ключ);
	КонецЦикла;
		
	ПроверитьНаКорректностьНомераПриВыгрузке(СтрокаДокумента);
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьНаКорректностьНомераПриВыгрузке(СтрокаЭкспорта)
	                                                             	
	Значение = Прав(СокрЛП(СтрокаЭкспорта.НомерВФорматеВыгрузки), 6);
	Если Значение = "000000" Тогда
		ДобавитьЗамечание(СтрокаЭкспорта, 4, НСтр("ru = 'Номер не должен быть равен нулю.'"));
	КонецЕсли;
	
	Если Не РаботаСоСтрокамиКлиентСервер.ТолькоЦифрыВСтроке(Значение, Ложь, Ложь) Тогда
		ОписаниеОшибки = РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Указан неправильный номер документа(%1).'"), Значение);
		ДобавитьЗамечание(СтрокаЭкспорта, 4, ОписаниеОшибки);
	КонецЕсли;
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьНаПустоеЗначениеЭкспорта(СтрокаЭкспорта, ИмяСвойства)
	
	Если НЕ ЗначениеЗаполнено(СтрокаЭкспорта[ИмяСвойства]) Тогда
		ДобавитьЗамечание(СтрокаЭкспорта, 4, "Не заполнено поле """ + ИмяСвойства + """");
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьЗамечание(СтрокаДокумента, НоваяГотовность, ТекстЗамечания) Экспорт
	
	Если СтрокаДокумента.Готовность < НоваяГотовность Тогда
		СтрокаДокумента.Готовность = НоваяГотовность;
	КонецЕсли;
	
	ДобавитьВСтроку(СтрокаДокумента.ОписаниеОшибок, ТекстЗамечания, "; ");
	СтрокаДокумента.ЕстьОшибка = НоваяГотовность <> 0;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьВСтроку(Буфер, НоваяСтрока, Разделитель = "")
	
	Если ПустаяСтрока(Буфер) Тогда
		Буфер = НоваяСтрока;
	Иначе
		
		УжеЕстьФразаОшибкаВФайле = СтрНайти(Буфер, "Ошибка в файле. ") > 0;
		Если УжеЕстьФразаОшибкаВФайле Тогда
			НоваяСтрока = СтрЗаменить(НоваяСтрока, "Ошибка в файле. ", "");
		КонецЕсли;
		
		Шаблон = НСтр("ru = '%1%2%3'");
		Буфер  = РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку(
					Шаблон,
					Буфер,
					?(ПустаяСтрока(Разделитель), Символы.ПС, Разделитель),
					НоваяСтрока);
					
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВыгрузитьДокументыНаСервере()
	
	Возврат ВыгрузитьДокументы(ЭтаФорма.ПлатежныеПоручения.Выгрузить(),
						"Windows",
						ЭтаФорма.Дата,
						ЭтаФорма.РасчетныйСчет);	
	
КонецФункции

&НаСервереБезКонтекста
Функция ВыгрузитьДокументы(ПлатежныеПоручения, Знач Кодировка, Дата, РасчетныйСчет)
	
	Если НЕ ЗначениеЗаполнено(Кодировка) Тогда
		Кодировка = "Windows"; // кодировка "по умолчанию"
	КонецЕсли;
	
	ПараметрыВыгрузкиДокументов = ПараметрыВыгрузкиПлатежныхПоручений();	
	
	ПараметрыВыгрузкиДокументов.Кодировка		= Кодировка;
	ПараметрыВыгрузкиДокументов.НачалоПериода	= Дата;
	ПараметрыВыгрузкиДокументов.КонецПериода	= Дата;
	
	НомераБанковскихСчетов = Новый Массив;
	Если ЗначениеЗаполнено(РасчетныйСчет) Тогда
		НомераБанковскихСчетов.Добавить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РасчетныйСчет, "НомерСчета"));
	Иначе
		НомераБанковскихСчетов = ПлатежныеПоручения.ВыгрузитьКолонку("ПлательщикНомерСчета");
		РаботаСКоллекциями.УдалитьПовторяющиесяЗначенияМассива(НомераБанковскихСчетов);
	КонецЕсли;
	
	ПараметрыВыгрузкиДокументов.Вставить("НомераБанковскихСчетов", НомераБанковскихСчетов);
	
	ПараметрыВыгрузкиДокументов.ВидыДокументов.Добавить("Платежное поручение");
			
	ДвоичныеДанные = ДвоичныеДанныеВыгрузки(ПараметрыВыгрузкиДокументов, ПлатежныеПоручения);
	
	Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	
	// Отметим те документы которые успешно загрузились
	Для каждого СтрокаСекции Из ПлатежныеПоручения Цикл
		СтрокаСекции.Готовность = ?(СтрокаСекции.Готовность = -2, -1, СтрокаСекции.Готовность);
	КонецЦикла;
	
	Возврат Адрес;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПараметрыВыгрузкиПлатежныхПоручений()
	
	Параметры = Новый Структура();	
	Параметры.Вставить("ВерсияФормата",     		"1.03");	
	Параметры.Вставить("Кодировка",             	"Windows");
	Параметры.Вставить("Программа",             	"");
	Параметры.Вставить("ВыгружатьДатуСоздания", 	Истина);
	Параметры.Вставить("НачалоПериода",         	'00010101');
	Параметры.Вставить("КонецПериода",          	'00010101');
	Параметры.Вставить("НомераБанковскихСчетов",	Новый Массив);
	Параметры.Вставить("ВидыДокументов",        	Новый Массив);
	
	Возврат Параметры;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДвоичныеДанныеВыгрузки(ПараметрыВыгрузкиДокументов, ПлатежныеПоручения)
		
	Если ПараметрыВыгрузкиДокументов.Кодировка = "DOS" Тогда
		Кодировка = "cp866";        // КодировкаТекста.OEM;
	Иначе
		Кодировка = "windows-1251"; // КодировкаТекста.ANSI;
	КонецЕсли;
	
	ПотокВПамяти  = Новый ПотокВПамяти;
	ПотокВыгрузки = Новый ЗаписьТекста(ПотокВПамяти, Кодировка);
	
	ЗаписатьЗаголовокФайлаВыгрузки(ПотокВыгрузки, ПараметрыВыгрузкиДокументов);
	
	ЗаписатьДокументыФайлаВыгрузки(ПотокВыгрузки, ПараметрыВыгрузкиДокументов, ПлатежныеПоручения);
	
	ПотокВыгрузки.ЗаписатьСтроку("КонецФайла");
	
	Возврат ДвоичныеДанныеПотокаВыгрузки(ПотокВыгрузки, ПотокВПамяти);
	
КонецФункции

&НаСервереБезКонтекста
Функция ДвоичныеДанныеПотокаВыгрузки(ПотокВыгрузки, ПотокВПамяти)
	
	ПотокВыгрузки.Закрыть();
	ДвоичныеДанныеПотокаВыгрузки = ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();
	
	Возврат ДвоичныеДанныеПотокаВыгрузки;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьЗаголовокФайлаВыгрузки(ПотокВыгрузки, ПараметрыВыгрузки)
	
	ПотокВыгрузки.ЗаписатьСтроку("1CClientBankExchange");
	
	ПотокВыгрузки.ЗаписатьСтроку("ВерсияФормата=" + ПараметрыВыгрузки.ВерсияФормата); // "1.01" - "1.03" 	
	ПотокВыгрузки.ЗаписатьСтроку("Кодировка=" + ПараметрыВыгрузки.Кодировка);
	ПотокВыгрузки.ЗаписатьСтроку("Отправитель=1С:Предприятие");
	ПотокВыгрузки.ЗаписатьСтроку("Получатель=");
	
	Если ПараметрыВыгрузки.ВыгружатьДатуСоздания Тогда
		ТекДата = ТекущаяДатаСеанса();
		ПотокВыгрузки.ЗаписатьСтроку("ДатаСоздания=" + Формат(ТекДата, "ДЛФ=Д"));
		ПотокВыгрузки.ЗаписатьСтроку("ВремяСоздания=" + Формат(ТекДата, "ДЛФ=В"));
	КонецЕсли;
	
	ПотокВыгрузки.ЗаписатьСтроку("ДатаНачала=" + Формат(ПараметрыВыгрузки.НачалоПериода, "ДЛФ=Д"));
	ПотокВыгрузки.ЗаписатьСтроку("ДатаКонца="  + Формат(ПараметрыВыгрузки.КонецПериода, "ДЛФ=Д"));
	
	НомераСчетов = ПараметрыВыгрузки.НомераБанковскихСчетов;
	Для Каждого НомерСчета Из НомераСчетов Цикл
		ПотокВыгрузки.ЗаписатьСтроку("РасчСчет=" + НомерСчета);
	КонецЦикла;
		
	ПотокВыгрузки.ЗаписатьСтроку("Документ=" + ПараметрыВыгрузки.ВидыДокументов[0]);
	 	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьДокументыФайлаВыгрузки(ПотокВыгрузки, ПараметрыВыгрузки, ПлатежныеПоручения)
	
	НачатьТранзакцию();
	
	// выводим отмеченные секции документов
	Для каждого СтрокаСекции Из ПлатежныеПоручения Цикл
		
		Если НЕ СтрокаСекции.Выгружать Тогда
			Продолжить;
		КонецЕсли;
		
		Буфер = ПолучитьСекциюДокумент(СтрокаСекции);
		КоличествоСрокСекции = СтрЧислоСтрок(Буфер);
		Для Сч = 1 По КоличествоСрокСекции Цикл
			ПотокВыгрузки.ЗаписатьСтроку(СтрПолучитьСтроку(Буфер, Сч));
		КонецЦикла;
		
		// Изменяем статус платежки
		Попытка 
			РегистрыСведений.СтатусыИсходящихПлатежныхПоручений.УстановитьСтатусПлатежногоПоручения(СтрокаСекции.ОрганизацияСсылка, СтрокаСекции.Документ, Перечисления.СтатусыПлатежныхПоручений.Выгружено);
		Исключение   
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки() + " Выгрузка прервана");
			ОтменитьТранзакцию();
			Прервать;
		КонецПопытки;
		
		СтрокаСекции.Готовность = -2;
		
	КонецЦикла;  
	
	Если ТранзакцияАктивна() Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСекциюДокумент(СтруктураДокумента)
	
	Буфер    = "";
	Реквизит = "";
	Секция   = СформироватьСтруктуруЭкспорта();
	ЗаполнитьЗначениеЭкспорта(Секция, СтруктураДокумента);
	
	ДобавитьВСтроку(Буфер, "СекцияДокумент=" + СтруктураДокумента.ВидДокумента);
	
	Для каждого ВыгружаемыйРеквизит Из Секция Цикл
		
		Значение = ПривестиЗначение(ВыгружаемыйРеквизит.Значение);
		
		Если НЕ ПустаяСтрока(Значение) Тогда
			// Секция ПоказательТипа пустая, т. к. в клиент-банке она может быть обязательной (сейчас не используется)
			// КПП получателя обязателен только для платежей в бюджет
			Если ВыгружаемыйРеквизит.Ключ = "ПоказательТипа" 
				Или (ВыгружаемыйРеквизит.Ключ = "ПолучательКПП" И Не СтруктураДокумента.ПеречислениеВБюджет) Тогда
				
				ДобавитьВСтроку(Буфер, ВыгружаемыйРеквизит.Ключ + "="); 
							
			Иначе
				ДобавитьВСтроку(Буфер, ВыгружаемыйРеквизит.Ключ + "=" + Значение);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ДобавитьВСтроку(Буфер, "КонецДокумента");
	
	Возврат Буфер;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПривестиЗначение(Значение)
	
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		
		Возврат СокрЛП(Значение);
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		
		Возврат Формат(Значение, "ЧРД=.; ЧРГ=' '; ЧГ=0");
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		
		Возврат Формат(Значение, "ДФ=dd.MM.yyyy");
		
	Иначе
		
		Возврат "";
		
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьЗначениеЭкспорта(СтрокаЭкспорта, ВыборкаДляЭкспорта) Экспорт
	
	Плательщик = "Организация";
	Получатель = "Контрагент";
		
	СтрокаЭкспорта.Номер          = ВыборкаДляЭкспорта.НомерВФорматеВыгрузки;
	СтрокаЭкспорта.Дата           = Формат(ВыборкаДляЭкспорта.Дата, "ДЛФ=Д");
	СтрокаЭкспорта.Сумма          = Формат(ВыборкаДляЭкспорта.Сумма, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧРГ=' '; ЧГ=0");
	СтрокаЭкспорта.ПлательщикСчет = ВыборкаДляЭкспорта[Плательщик + "НомерСчета"];
	СтрокаЭкспорта.ПолучательСчет = ВыборкаДляЭкспорта[Получатель + "НомерСчета"];
	СтрокаЭкспорта.ВидПлатежа     = ВыборкаДляЭкспорта.ВидПлатежа;
	
	//ВидОплаты	
	СтрокаЭкспорта.ВидОплаты  = "01";
		
	//Плательщик1
	СтрокаЭкспорта.Плательщик1 = ВыборкаДляЭкспорта.ТекстПлательщика;
	
	//Плательщик, ПлательщикИНН
	Значение = ВыборкаДляЭкспорта.ИННПлательщика;
	СтрокаЭкспорта.ПлательщикИНН = Значение;
	СтрокаЭкспорта.Плательщик = "ИНН " + Значение + " " + СтрокаЭкспорта.Плательщик1;
	
	//ПлательщикРасчСчет, ПлательщикБанк1, ПлательщикБанк2, ПлательщикБИК, ПлательщикКорсчет
	СтрокаЭкспорта.ПлательщикРасчСчет = ВыборкаДляЭкспорта[Плательщик + "НомерСчета"];
	СтрокаЭкспорта.ПлательщикБанк1    = ВыборкаДляЭкспорта[Плательщик + "Банк"];
	СтрокаЭкспорта.ПлательщикБанк2    = ВыборкаДляЭкспорта[Плательщик + "ГородБанка"];
	СтрокаЭкспорта.ПлательщикБИК      = ВыборкаДляЭкспорта[Плательщик + "БИКБанка"];
	СтрокаЭкспорта.ПлательщикКорсчет  = ВыборкаДляЭкспорта[Плательщик + "РасчСчет"];
		
	//Получатель1
	СтрокаЭкспорта.Получатель1 = ВыборкаДляЭкспорта.ТекстПолучателя;
	
	//Получатель, ПолучательИНН
	Значение = ВыборкаДляЭкспорта.ИННПолучателя;
	СтрокаЭкспорта.ПолучательИНН = Значение;
	СтрокаЭкспорта.Получатель    = "ИНН " + Значение + " " + СтрокаЭкспорта.Получатель1;
	
	//ПолучательРасчСчет, ПолучательБанк1, ПолучательБанк2, ПолучательБИК, ПолучательКорсчет	
	СтрокаЭкспорта.ПолучательРасчСчет = ВыборкаДляЭкспорта[Получатель + "НомерСчета"];
	СтрокаЭкспорта.ПолучательБанк1    = ВыборкаДляЭкспорта[Получатель + "Банк"];
	СтрокаЭкспорта.ПолучательБанк2    = ВыборкаДляЭкспорта[Получатель + "ГородБанка"];
	СтрокаЭкспорта.ПолучательБИК      = ВыборкаДляЭкспорта[Получатель + "БИКБанка"];
	СтрокаЭкспорта.ПолучательКорсчет  = ВыборкаДляЭкспорта[Получатель + "РасчСчет"];
		
	//ПлательщикКПП	
	СтрокаЭкспорта.ПлательщикКПП = ВыборкаДляЭкспорта.КПППлательщика;
		
	//ПолучательКПП
	Если НЕ ЗначениеЗаполнено(СтрокаЭкспорта.ПолучательКПП) Тогда
		СтрокаЭкспорта.ПолучательКПП = ВыборкаДляЭкспорта.КПППолучателя;
	КонецЕсли;
	
	// Код (УИН)
	Если СтрокаЭкспорта.Свойство("Код") Тогда
		Если НЕ ПустаяСтрока(ВыборкаДляЭкспорта.ИдентификаторПлатежа) Тогда
			СтрокаЭкспорта.Код = ВыборкаДляЭкспорта.ИдентификаторПлатежа;
		КонецЕсли;
	КонецЕсли;
	
	//СтатусСоставителя, ПлательщикКПП ПолучательКПП ПоказательКБК ОКАТО/ОКТМО 
	//ПоказательОснования ПоказательПериода ПоказательНомера ПоказательДаты ПоказательТипа
	Если ВыборкаДляЭкспорта.ПеречислениеВБюджет Тогда
		
		СтрокаЭкспорта.СтатусСоставителя = ВыборкаДляЭкспорта.СтатусСоставителя;
		
		Если НЕ ПустаяСтрока(ВыборкаДляЭкспорта.КПППлательщика) Тогда
			СтрокаЭкспорта.ПлательщикКПП = ВыборкаДляЭкспорта.КПППлательщика;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ВыборкаДляЭкспорта.КПППолучателя) Тогда
			СтрокаЭкспорта.ПолучательКПП = ВыборкаДляЭкспорта.КПППолучателя;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ВыборкаДляЭкспорта.КодБК) Тогда
			СтрокаЭкспорта.ПоказательКБК = ВыборкаДляЭкспорта.КодБК;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ВыборкаДляЭкспорта.КодОКАТО) Тогда
			СтрокаЭкспорта.ОКАТО = ВыборкаДляЭкспорта.КодОКАТО;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ВыборкаДляЭкспорта.ПоказательОснования) Тогда
			СтрокаЭкспорта.ПоказательОснования = ВыборкаДляЭкспорта.ПоказательОснования;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ВыборкаДляЭкспорта.ПоказательПериода) И ВыборкаДляЭкспорта.ПоказательПериода <> "  .  .    " Тогда
			СтрокаЭкспорта.ПоказательПериода = ВыборкаДляЭкспорта.ПоказательПериода;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ВыборкаДляЭкспорта.ПоказательНомера) Тогда
			СтрокаЭкспорта.ПоказательНомера = ВыборкаДляЭкспорта.ПоказательНомера;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ВыборкаДляЭкспорта.ПоказательДаты) Тогда
			СтрокаЭкспорта.ПоказательДаты = ВыборкаДляЭкспорта.ПоказательДаты;
		КонецЕсли;
				
		Если СтрокаЭкспорта.Свойство("ПоказательТипа") Тогда			
			СтрокаЭкспорта.ПоказательТипа = "0";            			
		КонецЕсли;
		
	КонецЕсли;
	
	//Очередность
	СтрокаЭкспорта.Очередность = "" + ВыборкаДляЭкспорта.ОчередностьПлатежа;
	
	//НазначениеПлатежа, НазначениеПлатежа1 НазначениеПлатежа2 НазначениеПлатежа3 НазначениеПлатежа4 НазначениеПлатежа5 НазначениеПлатежа6
	СтрокаЭкспорта.НазначениеПлатежа = СтрЗаменить(ВыборкаДляЭкспорта.НазначениеПлатежа, Символы.ПС + Символы.ВК, " ");
	
	КоличествоСтрокНП = СтрЧислоСтрок(ВыборкаДляЭкспорта.НазначениеПлатежа);
	
	Если КоличествоСтрокНП > 6 Тогда
		КоличествоСтрокНП = 6;
	КонецЕсли;
	
	Для Сч = 1 По КоличествоСтрокНП Цикл
		СтрокаЭкспорта["НазначениеПлатежа" + Сч] = СтрПолучитьСтроку(ВыборкаДляЭкспорта.НазначениеПлатежа, Сч);
	КонецЦикла;
	
	Для Сч = (КоличествоСтрокНП + 1) По 6 Цикл
		СтрокаЭкспорта["НазначениеПлатежа" + Сч] = "";
	КонецЦикла;
	
КонецПроцедуры 
  
&НаСервереБезКонтекста
Функция СоздатьПерезаполнитьПлатежноеПоручение(ДокументСсылка, ДокументыОснования, ПлательщикСчет, ПолучательСчет, Получатель, Дата, Сумма = Неопределено)
	
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		ПлатежноеПоручение = ДокументСсылка.ПолучитьОбъект();
	Иначе   
		
		// Платежное поручение в это же время могло быть создано другим пользователем
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПлатежноеПоручениеИсходящееОснования.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ПлатежноеПоручениеИсходящее.Основания КАК ПлатежноеПоручениеИсходящееОснования
			|ГДЕ
			|	НЕ ПлатежноеПоручениеИсходящееОснования.Ссылка.ПометкаУдаления
			|	И ПлатежноеПоручениеИсходящееОснования.Ссылка.Дата >= &НачалоДня
			|	И ПлатежноеПоручениеИсходящееОснования.Основание В(&Основания)");
		
		Запрос.УстановитьПараметр("Основания", ДокументыОснования);
		Запрос.УстановитьПараметр("НачалоДня", НачалоДня(Дата));
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			// В этом случае ничего не делаем
			Возврат	Выборка.Ссылка;
		КонецЕсли;
		
		ПлатежноеПоручение = Документы.ПлатежноеПоручениеИсходящее.СоздатьДокумент();
		
	КонецЕсли;
	
	ПлатежноеПоручение.Дата						= Дата;
	ПлатежноеПоручение.Контрагент	 			= Получатель;
	ПлатежноеПоручение.РасчетныйСчет 			= ПлательщикСчет;
	ПлатежноеПоручение.РасчетныйСчетКонтрагента = ПолучательСчет; 
	
	ПлатежноеПоручение.Основания.Очистить();
	
	Если Сумма <> Неопределено Тогда
		ПлатежноеПоручение.ДополнительныеСвойства.Вставить("Сумма", Сумма);
	КонецЕсли;
	
	Если ТипЗнч(ДокументыОснования) = Тип("Массив") Тогда
		ДокументОснование = ДокументыОснования[0];
	Иначе
		ДокументОснование = ДокументыОснования;
	КонецЕсли;
		
	ПлатежноеПоручение.Заполнить(ДокументОснование); 
	
	// Для массива оснований нужно дозаполнить платежное поручение
	Если ТипЗнч(ДокументыОснования) = Тип("Массив") Тогда
		
		ИндексПоследнегоОснования = ДокументыОснования.Количество() - 1;
		Для Сч = 1 По ИндексПоследнегоОснования Цикл
			НоваяСтрокаОснований			= ПлатежноеПоручение.Основания.Добавить();
			НоваяСтрокаОснований.Основание	= ДокументыОснования[Сч];
		КонецЦикла;
		
		Документы.ПлатежноеПоручениеИсходящее.ДозаполнитьПлатежноеПоручениеПоОснованиям(ПлатежноеПоручение);
		
	КонецЕсли;	
	
	Если РаботаСДокументами.ЗаписатьПровестиДокумент(ПлатежноеПоручение) Тогда
		Возврат ПлатежноеПоручение.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
		
КонецФункции

&НаСервере
Процедура ОбновитьДокументыДляСозданияПлатежныхПорученийНаСервере()
		
	ОтборДляЗаполнения = ПолучитьОтбор(ЭтаФорма);
	ОтборДляЗаполнения.Вставить("Организация", Организация);  
	
	ОтборПоВидуДокумента = Новый Массив;
	Если ОтборДляЗаполнения.Свойство("ВидДокумента") Тогда
		
		ОтборПоВидуДокумента = ОтборДляЗаполнения.ВидДокумента.ВыгрузитьЗначения();
		ОтборДляЗаполнения.Удалить("ВидДокумента");                                                     
		
	КонецЕсли;
	
	Если ОтборДляЗаполнения.Свойство("СчетДоверительногоУправления") И Не СписокЗначенийПустой(ОтборДляЗаполнения.СчетДоверительногоУправления) Тогда
		
		ОтборДляЗаполнения.Вставить("ВключаяСчетаДУ", ОтборДляЗаполнения.СчетДоверительногоУправления); 
		ОтборДляЗаполнения.Удалить("СчетДоверительногоУправления"); 
				
		ОтборДляЗаполнения.Вставить("Клиент", Справочники.ЮрФизЛица.ПустаяСсылка());
		ОтборДляЗаполнения.Вставить("ВидДоговораДоверительногоУправления", Перечисления.ВидыДоговоровДоверительногоУправления.ПустаяСсылка());
				
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(Запрос, Дата, ОтборДляЗаполнения, "_СчетаДУ");
	
	// Возможности для объединения документов оснований в одно платежное поручение:
	// 1. Общие контрагент и вид задолженности (счета ДУ могут быть разными)
	// 2. Общие дата, счет ДУ, кредитный инструмент у закрытия кредитного инстумента и процентов по кредитному инструменту
	// 3. Общие дата, счет ДУ, счета отправителя и получателя у переводов денежных средств
		
	Запрос.Текст =
	
		#Область Текст_запроса
	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.СуммаОстаток КАК СуммаОстаток,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.Основание) = ТИП(Документ.НачислениеДивидендов)
		|			ТОГДА НачислениеЗадолженностиОснования.Ссылка
		|		ИНАЧЕ ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.Основание
		|	КОНЕЦ КАК Основание,
		|	ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.Валюта КАК Валюта,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.Основание) = ТИП(Документ.НачислениеДивидендов)
		|			ТОГДА НачислениеЗадолженностиОснования.Ссылка.Контрагент
		|		КОГДА ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.Основание) = ТИП(Документ.ПогашениеПаев)
		|			ТОГДА ВЫБОР
		|					КОГДА ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.Основание.Заявка.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Обмен)
