
#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не РаботаСДокументами.ИспользуетсяВыгрузкаПлатежныхПорученийВКлиентБанк(ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация"), ТекущаяДатаСеанса()) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для организации еще не включено формирование платежных поручений",,,, Отказ);	
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.Организация 					= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");	
	ЭтаФорма.СпецдепВТБ						= ОбщегоНазначения.ПолучитьИменованныйОбъект("СпецДепозитарий_ВТБ");
	
	ОбновитьЮрЛицоОрганизацииНаСервере();
	
	ЭтаФорма.Дата = ?(Параметры.Свойство("Дата"), Параметры.Дата, ТекущаяДатаСеанса());
	
	// При вызове из формы списка поручений открываем этап выгрузки
	ЭтаФорма.ВыгрузитьПорученияСоСтраницыФормирование = Ложь;
	Если Параметры.Свойство("ВыбранныеПлатежныеПоручения") Тогда   
		ЭтаФорма.Этап = "Выгрузка";
		ЭтаФорма.ОтборПлатежныеПоручения.ЗагрузитьЗначения(Параметры.ВыбранныеПлатежныеПоручения);		
	ИначеЕсли Параметры.Свойство("ПлатежныеПорученияЗаДень") Тогда
		ЭтаФорма.Этап = "Выгрузка";
	Иначе
		// Открываем этап формирования поручений 
		ЭтаФорма.Этап = "Формирование";
	КонецЕсли;
	
	ЭтаФорма.Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтаФорма.Организация, "ВалютаУчета");
	
	ЭтаФорма.ЭтоПолноправныйПользователь = РаботаСПользователями.ЭтоПолноправныйПользователь();
	
	КаталогВыгрузкиИзНастроек = ПолучитьИмяФайлаПоУмолчанию(ЭтаФорма.Организация);
	Если ПустаяСтрока(КаталогВыгрузкиИзНастроек) Тогда
		
		ЭтаФорма.КаталогФайловВыгрузки = ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ПрочиеНастройки.ПутьКФайлуДляЗагрузкиБанковскихВыписок", 
											ЭтаФорма.Организация);

		// Оставляем только папку, если указан путь к файлу
		Если СтрНайти(ЭтаФорма.КаталогФайловВыгрузки, ".txt") > 0 Тогда
			
			НомерСимволаКаталога = СтрНайти(ЭтаФорма.КаталогФайловВыгрузки, "\", НаправлениеПоиска.СКонца);
			Если НомерСимволаКаталога > 0 Тогда
				Этаформа.КаталогФайловВыгрузки = Лев(ЭтаФорма.КаталогФайловВыгрузки, НомерСимволаКаталога);
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе                      
		
		СтрФизЛицоПользователя = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РаботаСПользователями.ТекущийПользователь(), "ЮрФизЛицо"));
		
		ПозицияПробела = СтрНайти(СтрФизЛицоПользователя, " ");
		Фамилия = ?(ПозицияПробела > 0, Лев(СтрФизЛицоПользователя, ПозицияПробела - 1), ""); 
		
		ЭтаФорма.КаталогФайловВыгрузки = КаталогВыгрузкиИзНастроек 
		                            + ?(СтрЗаканчиваетсяНа(КаталогВыгрузкиИзНастроек, "\"), "", "\")
									+ Фамилия + "\";
									
	КонецЕсли; 
	
	Этаформа.ВидыДокументовДляОтбора.ЗагрузитьЗначения(Метаданные.ОпределяемыеТипы.ОснованиеПлатежногоПоручения.Тип.Типы()); 
	Для Каждого ЭлементСписка Из Этаформа.ВидыДокументовДляОтбора Цикл
		ЭлементСписка.Пометка = Истина;
	КонецЦикла;
	
	Элементы.ОтборВидДокумента.СписокВыбора.ЗагрузитьЗначения(Метаданные.ОпределяемыеТипы.ОснованиеПлатежногоПоручения.Тип.Типы());
	
	Элементы.ОтборВидДокументаСписок.СписокВыбора.ЗагрузитьЗначения(Метаданные.ОпределяемыеТипы.ОснованиеПлатежногоПоручения.Тип.Типы());
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПриИзмененииОтбора();
	
	КомандаОбновитьДокументыДляСозданияПлатежныхПоручений(Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	ПривестиОтборыВСоответствиеОрганизации(ЭтаФорма);
	ОбновитьПредставлениеОтбора(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура ИмяФайлаВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ФайлНаДиске = Новый Файл(ЭтаФорма.ИмяФайлаВыгрузки);
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок          = "Выберите файл";
	Диалог.ПолноеИмяФайла     = ""; 
	Диалог.Фильтр             = "TXT (*.txt)|*.txt"; 
    Диалог.МножественныйВыбор = Ложь;
	Диалог.Каталог            = ФайлНаДиске.Путь;
	
	Если Диалог.Выбрать() Тогда
		Этаформа.ИмяФайлаВыгрузки = Диалог.ПолноеИмяФайла;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаВыгрузкиОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ПустаяСтрока(ЭтаФорма.ИмяФайлаВыгрузки) Тогда
		ЗапуститьПриложение("notepad.exe """ + ЭтаФорма.ИмяФайлаВыгрузки + """")
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПлатежныеПорученияВыгружатьПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПлатежныеПоручения.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Знак = ?(ТекущиеДанные.Выгружать, 1, -1);
	
	КоличествоКВыгрузке	= КоличествоКВыгрузке + 1 * Знак;
	СуммаКВыгрузке		= СуммаКВыгрузке + ТекущиеДанные.Сумма * Знак;

КонецПроцедуры

&НаКлиенте
Процедура ПлатежныеПорученияПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;  
		
	Если Элемент.ТекущийЭлемент = Элементы.ПлатежныеПорученияДокумент Тогда
		
		Отказ = Истина;
		
		Если ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
			ОткрытьЗначение(ТекущиеДанные.Документ);
		КонецЕсли;		
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура РасчетныйСчетПриИзменении(Элемент)
	
	ПриИзмененииОтбораПлатежныхПоручений();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборВидДокументаСписокНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка) 
	
	СтандартнаяОбработка = Ложь;
	
	ДанныеВыбора = ЭтаФорма.ВидыДокументовДляОтбора.Скопировать();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыДляФормированияПлатежныхПорученийПолучательСчетОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	ТекущийИдентификатор = Элементы.ДокументыДляФормированияПлатежныхПоручений.ТекущиеДанные.ИдентификаторДляОбъединения;
	
	// Устанавливаем выбранное значение во всех строках с таким же идентификатором
	Если ТекущийИдентификатор > 0 Тогда
		
		СтрокиСчетаДУ = ДокументыДляФормированияПлатежныхПоручений.НайтиПоИдентификатору(Элементы.ДокументыДляФормированияПлатежныхПоручений.ТекущаяСтрока).ПолучитьРодителя().ПолучитьЭлементы();
		
		Для Каждого СтрокаСчетаДУ Из СтрокиСчетаДУ Цикл
			Если СтрокаСчетаДУ.ИдентификаторДляОбъединения = ТекущийИдентификатор Тогда
				СтрокаСчетаДУ.ПолучательСчет = ВыбранноеЗначение;		
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ДокументыДляФормированияПлатежныхПорученийПередНачаломИзменения(Элемент, Отказ)
	
	ЭлементыСоСтандартнойОбработкой = Новый Массив;	
	ЭлементыСоСтандартнойОбработкой.Добавить("ДокументыДляФормированияПлатежныхПорученийПолучательСчет");
	ЭлементыСоСтандартнойОбработкой.Добавить("ДокументыДляФормированияПлатежныхПорученийФормировать");
	ЭлементыСоСтандартнойОбработкой.Добавить("ДокументыДляФормированияПлатежныхПорученийСумма");
		
	Если ЭлементыСоСтандартнойОбработкой.Найти(Элемент.ТекущийЭлемент.Имя) <> Неопределено Тогда
		// Оставляем стандартную обработку 
		
		Если Элемент.ТекущийЭлемент.Имя = "ДокументыДляФормированияПлатежныхПорученийСумма" Тогда
			ЭтаФорма.СуммаТекущейСтроки = Элементы.ДокументыДляФормированияПлатежныхПоручений.ТекущиеДанные.Сумма;
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ДокументыДляФормированияПлатежныхПоручений.ТекущиеДанные;
	
	Отказ = Истина;
	
	ЭлементыДляОткрытия = Новый Массив;
	ЭлементыДляОткрытия.Добавить("ДокументыДляФормированияПлатежныхПорученийСчетДоверительногоУправления");
	ЭлементыДляОткрытия.Добавить("ДокументыДляФормированияПлатежныхПорученийДокумент");
	ЭлементыДляОткрытия.Добавить("ДокументыДляФормированияПлатежныхПорученийДокументОснование");
	ЭлементыДляОткрытия.Добавить("ДокументыДляФормированияПлатежныхПорученийПлательщикСчет");
		
	Если ЭлементыДляОткрытия.Найти(Элемент.ТекущийЭлемент.Имя) <> Неопределено Тогда
		
		Если Элемент.ТекущийЭлемент.Имя = "ДокументыДляФормированияПлатежныхПорученийСчетДоверительногоУправления" 
			И ЗначениеЗаполнено(ТекущиеДанные["ДокументОснование"]) Тогда 
			ОткрытьЗначение(ТекущиеДанные["ДокументОснование"]);	
		ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные[СтрЗаменить(Элемент.ТекущийЭлемент.Имя, "ДокументыДляФормированияПлатежныхПоручений", "")]) Тогда				
			ОткрытьЗначение(ТекущиеДанные[СтрЗаменить(Элемент.ТекущийЭлемент.Имя, "ДокументыДляФормированияПлатежныхПоручений", "")]);             
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыДляФормированияПлатежныхПорученийПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	// Документы в валюте пересчитываем в рубли	
	// Пересчитываем остатки
	ТекстОшибки = "";	          	
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
	
	СтрокаПриемник = ДокументыДляФормированияПлатежныхПоручений.НайтиПоИдентификатору(Строка); 
		
	СтрокаИсточник = ДокументыДляФормированияПлатежныхПоручений.НайтиПоИдентификатору(ПараметрыПеретаскивания.Значение);
	СтрокаРодитель = СтрокаИсточник.ПолучитьРодителя();
	СтрокаРодитель.Сумма = СтрокаРодитель.Сумма - СтрокаИсточник.Сумма;
	
	СтрокаПриемник.Сумма = СтрокаПриемник.Сумма + СтрокаИсточник.Сумма;
		
КонецПроцедуры

&НаКлиенте
Процедура ДокументыДляФормированияПлатежныхПорученийПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	Если Строка = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	СтрокаПриемник = ДокументыДляФормированияПлатежныхПоручений.НайтиПоИдентификатору(Строка);  	
	
	Если Не ЗначениеЗаполнено(СтрокаПриемник.ПлательщикСчет)
		 Или ЗначениеЗаполнено(СтрокаПриемник.ДокументОснование) Тогда	
	
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
			
	СтрокаИсточник = ДокументыДляФормированияПлатежныхПоручений.НайтиПоИдентификатору(ПараметрыПеретаскивания.Значение);
	Если Не ЗначениеЗаполнено(СтрокаИсточник.ДокументОснование)                                           
		Или ЗначениеЗаполнено(СтрокаИсточник.Документ)
		Или СтрокаПриемник = СтрокаИсточник.ПолучитьРодителя()
		Или РазличаютсяКлючевойРеквизитВИсточникеИПриемнике(СтрокаИсточник, СтрокаПриемник, "СчетДоверительногоУправления") 
		Или РазличаютсяКлючевойРеквизитВИсточникеИПриемнике(СтрокаИсточник, СтрокаПриемник, "Валюта")
		Или Не РазличаютсяКлючевойРеквизитВИсточникеИПриемнике(СтрокаИсточник, СтрокаПриемник, "ПлательщикСчет") Тогда
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
		СтандартнаяОбработка = Ложь;
		Возврат;		
	КонецЕсли;
	
	// Расчетный счет может быть зафиксирован в документе-основании, его нельзя менять
	Если СтрокаИсточник.ПлательщикСчетФиксирован Тогда       
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыДляФормированияПлатежныхПорученийФормироватьПриИзменении(Элемент)
		
	ИзменитьФлажкиРекурсивно(Элементы.ДокументыДляФормированияПлатежныхПоручений.ТекущиеДанные, 
							Элементы.ДокументыДляФормированияПлатежныхПоручений.ТекущиеДанные.Формировать);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ПриИзмененииКлючевыхРеквизитов();
	
КонецПроцедуры

&НаКлиенте
Процедура БанкПриИзменении(Элемент)
	
	ПриИзмененииОтбораПлатежныхПоручений();
	
	ОбновитьИмяФайлаВыгрузки();
	
КонецПроцедуры                            

&НаКлиенте
Процедура ЭлементОтбораПриИзменении(Элемент)
	
	Перем СчетаСоответствующиеОрганизации, СчетаНеСоответствующиеОрганизации;
	
	Если ЭтаФорма.ЭтоПолноправныйПользователь
		И Элемент = Элементы.ОтборСчетДоверительногоУправленияСписок
		И Не ПроверитьСчетаНаСоответствиеОрганизации(Организация, ЭтаФорма.ОтборСчетДоверительногоУправления, СчетаСоответствующиеОрганизации, СчетаНеСоответствующиеОрганизации)
	Тогда
		
		ПривестиОтборыВСоответствиеОрганизации(ЭтаФорма, СчетаСоответствующиеОрганизации);
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Счета д/у, не соответствующие организации %1, были удалены из отбора: %2", Организация, СтрСоединить(СчетаНеСоответствующиеОрганизации, ", ")));
	
	КонецЕсли;
	
	ПриИзмененииОтбора();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыДляФормированияПлатежныхПорученийСуммаПриИзменении(Элемент)
		
	ТекущиеДанные	= Элементы.ДокументыДляФормированияПлатежныхПоручений.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.Сумма <> ЭтаФорма.СуммаТекущейСтроки Тогда
					
		ТекущиеДанныеРодитель		= ТекущиеДанные.ПолучитьРодителя();
		ТекущиеДанныеРодитель.Сумма	= ТекущиеДанныеРодитель.Сумма - ЭтаФорма.СуммаТекущейСтроки + ТекущиеДанные.Сумма;
		ЭтаФорма.СуммаТекущейСтроки	= ТекущиеДанные.Сумма;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаУстановитьВсеФлажки(Команда)
	
	ИзменитьВсеФлажки(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьВсеФлажки(Команда)
	
	ИзменитьВсеФлажки(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьПлатежныеПорученияКВыгрузке(Команда)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли; 
		
	ЭтаФорма.ПлатежныеПоручения.Очистить();
	
	ЗаполнитьДокументыНаЭкспортНаСервере();
	
	ЭтаФорма.ПлатежныеПоручения.Сортировать("СтатусПлатежногоПоручения, Номер");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыгрузить(Команда)
		
	ОчиститьСообщения();
	Если ПлатежныеПоручения.Количество() > 0 И КоличествоКВыгрузке > 0 Тогда		
		
		// Предупредим пользователей, если есть платежки для ЭДО ВТБ: им нужно вручную вычищать отдельные поля после загрузки в ЭДО
		Если ЭтаФорма.ПлатежныеПорученияДляВыгрузкиВЭДОВТБ.Количество() > 0 Тогда
			
			СтрокиКВыгрузке = ЭтаФорма.ПлатежныеПоручения.НайтиСтроки(Новый Структура("Выгружать", Истина));
			Для Каждого СтрокаКВыгрузке Из СтрокиКВыгрузке Цикл
				Если ЭтаФорма.ПлатежныеПорученияДляВыгрузкиВЭДОВТБ.НайтиПоЗначению(СтрокаКВыгрузке.Документ) <> Неопределено Тогда 
					Предупреждение("Внимание!!! Будут выгружены платежные поручения для ЭДО ВТБ. Нужно очистить отдельные поля поручений после загрузки в ЭДО!");
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		АдресВоВременномХранилище = ВыгрузитьДокументыНаСервере();					
		ДвоичныеДаннныеФайла = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
		
		Попытка
			ДвоичныеДаннныеФайла.Записать(ИмяФайлаВыгрузки);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		КонецПопытки;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выгрузка завершена");
		
	КонецЕсли;		
		
	Оповестить("ПлатежныеПоручения.Обновить");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтключитьОтбор(Команда)
	
	ЭтаФорма.ОтборСчетДоверительногоУправленияВСписке			= Неопределено;
	ЭтаФорма.ОтборКлиентВСписке									= Неопределено;
	ЭтаФорма.ОтборВидДоговораДоверительногоУправленияВСписке	= Неопределено;
	Этаформа.ОтборВидДокументаВСписке							= Неопределено;
	
	ЭтаФорма.ОтборСчетДоверительногоУправления.Очистить();
	ЭтаФорма.ОтборВидДоговораДоверительногоУправления.Очистить();
	ЭтаФорма.ОтборКлиент.Очистить();	
	ЭтаФорма.ОтборВидДокумента.Очистить(); 
	
	ПриИзмененииОтбора();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСохранитьПараметрыОтбора(Команда)
	
	Настройки = Новый Структура(
		"ОтборСчетДоверительногоУправления, ОтборВидДоговораДоверительногоУправления, ОтборКлиент,
		|ОтборСчетДоверительногоУправленияВСписке, ОтборКлиентВСписке, ОтборВидДоговораДоверительногоУправленияВСписке");
	
	ЗаполнитьЗначенияСвойств(Настройки, ЭтаФорма);
	
	РаботаСФормамиКлиент.СохранитьНастройкиВХранилищеВариантовИНастроекОтчетов(ЭтаФорма.ИмяФормы, ЭтаФорма.КлючТекущихПараметровОтбора, Настройки, Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВосстановитьПараметрыОтбора(Команда)
	
	ОписаниеНастроек = РаботаСФормамиКлиент.ПолучитьНастройкиИзХранилищаВариантовИНастроекОтчетов(ЭтаФорма.ИмяФормы, ЭтаФорма.КлючТекущихПараметровОтбора, Организация);
	
	Если ОписаниеНастроек <> Неопределено Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ОписаниеНастроек.Настройки);
		
		ПривестиОтборыВСоответствиеОрганизации(ЭтаФорма);
		
		ПриИзмененииОтбора();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура КомандаСоздатьПорученияНаСервере()
	
	МассивСтрокСчетовДУ = ДокументыДляФормированияПлатежныхПоручений.ПолучитьЭлементы();
	
	ПорученияСозданы = Ложь;
	
	Для Каждого СтрокаСчетаДУ Из МассивСтрокСчетовДУ Цикл 
		
		ТаблицаДляОбъединения = Неопределено; 
		//Если СтрокаСчетаДУ.ИдентификаторДляОбъединения = 99 Тогда
		//	
		//	ТаблицаДляОбъединения = Новый ТаблицаЗначений;
		//	ТаблицаДляОбъединения.Колонки.Добавить("ИдентификаторДляОбъединения", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(2)));
		//	ТаблицаДляОбъединения.Колонки.Добавить("СтрокаДокумента");
		//	
		//КонецЕсли;	
			
		МассивСтрокРасчетныхСчетов = СтрокаСчетаДУ.ПолучитьЭлементы();
		Для Каждого СтрокаРасчетногоСчета Из МассивСтрокРасчетныхСчетов Цикл
			
			Если СтрокаРасчетногоСчета.ПлательщикСчет = "Не определен" Тогда
				Продолжить;
			КонецЕсли;
			             
			ПлательщикСчет = СтрокаРасчетногоСчета.ПлательщикСчет;
			МассивСтрокДокументов = СтрокаРасчетногоСчета.ПолучитьЭлементы();
			Для Каждого СтрокаДокумента Из МассивСтрокДокументов Цикл
				
				Если СтрокаДокумента.Формировать Тогда                              				
					
					ОбновлятьСуммы = Не ЗначениеЗаполнено(СтрокаДокумента.Документ);						
					
					Если ТаблицаДляОбъединения <> Неопределено И СтрокаДокумента.ИдентификаторДляОбъединения > 0 Тогда 
						
						НоваяСтрока = ТаблицаДляОбъединения.Добавить();
						НоваяСтрока.ИдентификаторДляОбъединения = СтрокаДокумента.ИдентификаторДляОбъединения;
						НоваяСтрока.СтрокаДокумента				= СтрокаДокумента;						
						
						Продолжить;
						
					Иначе
						
						СтрокаДокумента.Документ = СоздатьПерезаполнитьПлатежноеПоручение(СтрокаДокумента.Документ, СтрокаДокумента.ДокументОснование, ПлательщикСчет, СтрокаДокумента.ПолучательСчет, СтрокаДокумента.Получатель, ЭтаФорма.Дата, СтрокаДокумента.Сумма);	
						
					КонецЕсли;
										
					Если ЗначениеЗаполнено(СтрокаДокумента.Документ) Тогда
						
						ПорученияСозданы					= Истина;
						СтрокаДокумента.Формировать			= Ложь;  
						СтрокаДокумента.НазначениеПлатежа	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаДокумента.Документ, "НазначениеПлатежа");
						
						Если ОбновлятьСуммы Тогда
							СтрокаРасчетногоСчета.ОстатокНаСчете 	= СтрокаРасчетногоСчета.ОстатокНаСчете - СтрокаДокумента.Сумма;
							СтрокаРасчетногоСчета.Сумма 			= СтрокаРасчетногоСчета.Сумма - СтрокаДокумента.Сумма;
						КонецЕсли;
						
					КонецЕсли;    
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
		Если ТаблицаДляОбъединения <> Неопределено Тогда
			
			// Соединяем в платежки по строкам
			МассивИдентификаторов = ТаблицаДляОбъединения.ВыгрузитьКолонку("ИдентификаторДляОбъединения");
			РаботаСКоллекциями.УдалитьПовторяющиесяЗначенияМассива(МассивИдентификаторов);
			
			Для Каждого ИдентификаторДляОбъединения Из МассивИдентификаторов Цикл
				
				НайдСтроки = ТаблицаДляОбъединения.НайтиСтроки(Новый Структура("ИдентификаторДляОбъединения", ИдентификаторДляОбъединения));
				МассивОснований = Новый Массив;
				Для Каждого НайдСтрока Из НайдСтроки Цикл
					МассивОснований.Добавить(НайдСтрока.СтрокаДокумента.ДокументОснование);
				КонецЦикла;
				
				ПлатежноеПоручение = СоздатьПерезаполнитьПлатежноеПоручение(НайдСтроки[0].СтрокаДокумента.Документ, МассивОснований, ПлательщикСчет, НайдСтроки[0].СтрокаДокумента.ПолучательСчет, НайдСтроки[0].СтрокаДокумента.Получатель, ЭтаФорма.Дата);	
				
				Если ЗначениеЗаполнено(ПлатежноеПоручение) Тогда 
					
					ПорученияСозданы 			= Истина;
					СтрокаДокумента.Формировать = Ложь;
					
				    Для Каждого НайдСтрока Из НайдСтроки Цикл
						
						НайдСтрока.СтрокаДокумента.Документ = ПлатежноеПоручение; 
						НоваяСтрока.НазначениеПлатежа		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПлатежноеПоручение, "НазначениеПлатежа");
						
						НайдСтрока.СтрокаДокумента.Формировать = Ложь;	
						
						Если ОбновлятьСуммы Тогда
							СтрокаРасчетногоСчета.ОстатокНаСчете 	= СтрокаРасчетногоСчета.ОстатокНаСчете - НайдСтрока.СтрокаДокумента.Сумма;
							СтрокаРасчетногоСчета.Сумма 			= СтрокаРасчетногоСчета.Сумма - НайдСтрока.СтрокаДокумента.Сумма;
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;	
				
	КонецЦикла;
	
	Если ПорученияСозданы Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Платежные поручения сформированы");		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьПоручения(Команда)
	
	Если Не ПроверитьДоступныеОстатки() Тогда
		Возврат;
	КонецЕсли;
	
	КомандаСоздатьПорученияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьДокументыДляСозданияПлатежныхПоручений(Команда)
	
	Если ДокументыДляФормированияПлатежныхПоручений.ПолучитьЭлементы().Количество() > 0
		И Вопрос("Таблица будет обновлена, при этом существующие изменения не сохранятся. Продолжить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда		
		Возврат;
	КонецЕсли;
	
	ПриИзмененииКлючевыхРеквизитов();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыДляФормированияПлатежныхПорученийРазвернутьВсе(Команда)
	
	РаботаСФормамиКлиент.РазвернутьВсеЭлементыДерева(ЭтаФорма.ДокументыДляФормированияПлатежныхПоручений, Элементы.ДокументыДляФормированияПлатежныхПоручений);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыДляФормированияПлатежныхПорученийСвернутьВсе(Команда)
	
	РаботаСФормамиКлиент.СвернутьВсеЭлементыДерева(ЭтаФорма.ДокументыДляФормированияПлатежныхПоручений, Элементы.ДокументыДляФормированияПлатежныхПоручений);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыДляФормированияПлатежныхПорученийУстановитьВсеФлажки(Команда)
	
	ДокументыДляФормированияПлатежныхПорученийИзменитьВсеФлажки(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДокументыДляФормированияПлатежныхПорученийСнятьВсеФлажки(Команда)
	
	ДокументыДляФормированияПлатежныхПорученийИзменитьВсеФлажки(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаКлиенте
Процедура ИзменитьВсеФлажки(Режим)
	
	Для Каждого СтрокаВыписки Из ПлатежныеПоручения Цикл		
		СтрокаВыписки.Выгружать = Режим;		
	КонецЦикла;
	
	ОбновитьИтогиВПодвале();

КонецПроцедуры

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт
	
	ЭтаФорма.Организация		= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	ЭтаФорма.ИмяФайлаВыгрузки	= ПолучитьИмяФайлаПоУмолчанию(ЭтаФорма.Организация); 	
	ОбновитьЮрЛицоОрганизацииНаСервере();
	
	КомандаОбновитьДокументыДляСозданияПлатежныхПоручений(Неопределено);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИмяФайлаПоУмолчанию(Организация)
	
	Возврат ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ПрочиеНастройки.ПутьКФайлуДляВыгрузкиБанковскихВыписок", 
											Организация, 
											Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса()));
	
КонецФункции

&НаСервере
Функция ОбновитьЮрЛицоОрганизацииНаСервере()
	
	 ЮрЛицоОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтаФорма.Организация, "ЮрФизЛицо");
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьСтруктуруЭкспорта()
	
	СтруктураЭкспорта = Новый Структура;
	
	СтруктураЭкспорта.Вставить("ВидДокумента",           ""); // "_"
	СтруктураЭкспорта.Вставить("Выгружать",              ""); // "_"
	СтруктураЭкспорта.Вставить("Готовность",             ""); // "Готовность"
	
	СтруктураЭкспорта.Вставить("НомерДок",               ""); // "№ Документа"
	СтруктураЭкспорта.Вставить("Номер",                  ""); // "Номер"
	СтруктураЭкспорта.Вставить("Дата",                   ""); // "Дата"
	СтруктураЭкспорта.Вставить("Операция",               ""); // "Операция"
	СтруктураЭкспорта.Вставить("СчетОрганизации",        ""); // "Эл. Р/с организации"
	СтруктураЭкспорта.Вставить("НомерСчетаОрганизации",  ""); // "Р/с организации"
	СтруктураЭкспорта.Вставить("Сумма",                  ""); // "Сумма"
	
	СтруктураЭкспорта.Вставить("Контрагент",             ""); // "Контрагент"
	СтруктураЭкспорта.Вставить("СчетКонтрагента",        ""); // "Р/с контрагента"
	СтруктураЭкспорта.Вставить("НомерСчетаКонтрагента",  ""); // "Эл. Р/с контрагента"
			
	СтруктураЭкспорта.Вставить("ПлательщикСчет",         ""); // "Расчетный счет плательщика"
	СтруктураЭкспорта.Вставить("Плательщик",             ""); // "Плательщик"
	СтруктураЭкспорта.Вставить("ПлательщикИНН",          ""); // "ИНН плательщика"
	СтруктураЭкспорта.Вставить("Плательщик1",            ""); // "Наименование плательщика"
	СтруктураЭкспорта.Вставить("Плательщик2",            ""); // "Расчетный счет плательщика"
	СтруктураЭкспорта.Вставить("Плательщик3",            ""); // "Банк плательщика"
	СтруктураЭкспорта.Вставить("Плательщик4",            ""); // "Город банка плательщика"
	СтруктураЭкспорта.Вставить("ПлательщикРасчСчет",     ""); // "Корсчет банка плательщика"
	СтруктураЭкспорта.Вставить("ПлательщикБанк1",        ""); // "РЦ банка плательщика"
	СтруктураЭкспорта.Вставить("ПлательщикБанк2",        ""); // "Город РЦ банка плательщика"
	СтруктураЭкспорта.Вставить("ПлательщикБИК",          ""); // "БИК РЦ банка плательщика"
	СтруктураЭкспорта.Вставить("ПлательщикКорсчет",      ""); // "Корсчет РЦ банка плат."
	
	СтруктураЭкспорта.Вставить("ПолучательСчет",         ""); // "Расчетный счет получателя"
	СтруктураЭкспорта.Вставить("Получатель",             ""); // "Получатель"
	СтруктураЭкспорта.Вставить("ПолучательИНН",          ""); // "ИНН получателя"
	СтруктураЭкспорта.Вставить("Получатель1",            ""); // "Наименование получателя"
	СтруктураЭкспорта.Вставить("Получатель2",            ""); // "Расчетный счет получателя"
	СтруктураЭкспорта.Вставить("Получатель3",            ""); // "Банк получателя"
