		|			РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|		ГДЕ
		|			ИсполнителиПоДенежнымСредствамСобственные.Организация = &Организация
		|			И ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_СчетаДУ.Ссылка
		|					ИЗ
		|						_СчетаДУ)
		|			И (ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия > &КонецДня)
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления) КАК ИсполнителиСобственные
		|		ПО _ДокументыНаДругихСчетах.СчетДоверительногоУправления = ИсполнителиСобственные.СчетДоверительногоУправления
		|ГДЕ
		|	НЕ (_ДокументыНаДругихСчетах.СчетДоверительногоУправления, _ДокументыНаДругихСчетах.ПлательщикСчет) В
		|				(ВЫБРАТЬ
		|					_ДокументыКСписаниюСДругихСчетов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|					_ДокументыКСписаниюСДругихСчетов.РасчетныйСчет КАК РасчетныйСчет
		|				ИЗ
		|					_ДокументыКСписаниюСДругихСчетов КАК _ДокументыКСписаниюСДругихСчетов)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетДоверительногоУправленияНаименование
		|ИТОГИ
		|	СУММА(Сумма),
		|	СУММА(Приход),
		|	СУММА(Расход)
		|ПО
		|	СчетДоверительногоУправления,
		|	РасчетныйСчет";		
	
		#КонецОбласти
	
	Если ОтборПоВидуДокумента.Количество() > 0 Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНаВидыДокументов", "ТИПЗНАЧЕНИЯ(ОснованияДляОплатыВсе.Основание) В (&ВидыОснований)");
		ВидыОснований = Новый Массив;
		ИсходныеТипы = Новый Соответствие;
		Для Каждого ЭлементОпределяемогоТипа Из Метаданные.ОпределяемыеТипы.ОснованиеПлатежногоПоручения.Тип.Типы() Цикл
			ИсходныеТипы.Вставить(СокрЛП(ЭлементОпределяемогоТипа), ЭлементОпределяемогоТипа);
		КонецЦикла;	
			
		Для Каждого ПредставлениеВидаДокумента Из ОтборПоВидуДокумента Цикл
			НайдВидДокумента = ИсходныеТипы.Получить(ПредставлениеВидаДокумента);
			Если НайдВидДокумента <> Неопределено Тогда
				ВидыОснований.Добавить(НайдВидДокумента);	
			КонецЕсли;
		КонецЦикла;
		
		Запрос.УстановитьПараметр("ВидыОснований", ВидыОснований);
		
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНаВидыДокументов", "ИСТИНА");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", 								Организация);
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "ЮрФизЛицо, ВалютаУчета");
	
	Запрос.УстановитьПараметр("ЮрЛицоОрганизации", 							РеквизитыОрганизации.ЮрФизЛицо);
	Запрос.УстановитьПараметр("ВалютаУчета", 								РеквизитыОрганизации.ВалютаУчета);
	Запрос.УстановитьПараметр("ПериодГраница", 								Новый Граница(КонецДня(Дата), ВидГраницы.Включая));	
	Запрос.УстановитьПараметр("ТекущееВремяГраница",						Новый Граница(ТекущаяДатаСеанса(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("НачалоДня", 									НачалоДня(Дата));
	Запрос.УстановитьПараметр("КонецДня", 									КонецДня(Дата));
	Запрос.УстановитьПараметр("Банк", 										Банк);                                     
	Запрос.УстановитьПараметр("ВидыЗадолженностиДляФормированияПоручений",	Справочники.ВидыЗадолженности.ВидыЗадолженностиДляФормированияПоручений());
	Запрос.УстановитьПараметр("КонтрольПорученийВнутреннейСистемы",			РаботаСДокументами.ДействуетКонтрольПорученийВнутреннейСистемы(Дата, Организация)); 
	Запрос.УстановитьПараметр("ДваРабочихДняВперед",							Справочники.Календари.ДобавитьКДатеРабочиеДни(
																				Справочники.Календари.Общероссийский,
																				Дата,
																				3));
																				
	Запрос.УстановитьПараметр("КонтрагентИФНС", РегистрыСведений.ИФНСОрганизаций.ПолучитьИФНС(Дата, Организация, Ложь));
	
	КоллекцияСтрок = ДокументыДляФормированияПлатежныхПоручений.ПолучитьЭлементы();
	
	ВыборкаСчетаДоверительногоУправления = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// Таблицу итогов по счетам получаем отдельно
	ИтогиПоСчетам = Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("_ОстаткиИОборотыОбщие").ПолучитьДанные().Выгрузить();
	
	// Также получаем таблицу с возможными документами для объединения в одну платежку
	КандидатыДляОбщихПлатежныхПоручений = Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("_КандидатыДляОбщихПлатежныхПоручений").ПолучитьДанные().Выгрузить();
	
	Пока ВыборкаСчетаДоверительногоУправления.Следующий() Цикл
		
		НоваяСтрокаСчетаДУ = КоллекцияСтрок.Добавить();
		НоваяСтрокаСчетаДУ.СчетДоверительногоУправления = ВыборкаСчетаДоверительногоУправления.СчетДоверительногоУправления;
					
		ВыборкаРасчетныеСчета = ВыборкаСчетаДоверительногоУправления.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаРасчетныеСчета.Следующий() Цикл
			
			НоваяСтрока = НоваяСтрокаСчетаДУ.ПолучитьЭлементы().Добавить();
			НоваяСтрока.ПлательщикСчет	= ВыборкаРасчетныеСчета.РасчетныйСчет;
			
			НайдСтрокиИтогов = ИтогиПоСчетам.НайтиСтроки(Новый Структура("СчетДоверительногоУправления, РасчетныйСчет", НоваяСтрокаСчетаДУ.СчетДоверительногоУправления, НоваяСтрока.ПлательщикСчет));
			Если НайдСтрокиИтогов.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрока, НайдСтрокиИтогов[0],, "СчетДоверительногоУправления");
			КонецЕсли;
			
			Если ТипЗнч(НоваяСтрока.ПлательщикСчет) <> Тип("Строка") И ЗначениеЗаполнено(НоваяСтрока.ПлательщикСчет) Тогда
				НоваяСтрока.Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаРасчетныеСчета.РасчетныйСчет, "Валюта");
			КонецЕсли;
										
			ВыборкаДетальныеЗаписи = ВыборкаРасчетныеСчета.Выбрать();
			КоллекцияСтрокДетальныхЗаписей = НоваяСтрока.ПолучитьЭлементы();
			СуммаПоДокументам = 0;
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				Если Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДокументОснование) Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрокаДетальныхЗаписей = КоллекцияСтрокДетальныхЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(
					НоваяСтрокаДетальныхЗаписей, 
					ВыборкаДетальныеЗаписи, 
					"ДокументОснование, Документ, НазначениеПлатежа, Сумма, Получатель, ПолучательСчет, Приход, Расход, ПлательщикСчетФиксирован, ПолучательСчетФиксирован, СуммаФиксирована, Статус"
					);
				
				// Пока закомментировано, доп. сервис
				//ДляОбъединенияВОдноПП = КандидатыДляОбщихПлатежныхПоручений.НайтиСтроки(Новый Структура("СчетДоверительногоУправления, Основание", 
				//																НоваяСтрокаСчетаДУ.СчетДоверительногоУправления,
				//																НоваяСтрокаДетальныхЗаписей.ДокументОснование));
				//Если ДляОбъединенияВОдноПП.Количество() > 0 Тогда  
				//																	
				//	НоваяСтрокаДетальныхЗаписей.ИдентификаторДляОбъединения = ДляОбъединенияВОдноПП[0].ИдентификаторДляОбъединения;
				//	
				//	// На верхнем уровне зафиксируем, что есть кандидаты для объединения
				//	// Используется при создании платежек
				//	Если НоваяСтрокаСчетаДУ.ИдентификаторДляОбъединения = 0 Тогда
				//		НоваяСтрокаСчетаДУ.ИдентификаторДляОбъединения = 99;
				//	КонецЕсли;
				//	
				//КонецЕсли;
				
				Если ЗначениеЗаполнено(НоваяСтрокаДетальныхЗаписей.Документ) И НоваяСтрокаДетальныхЗаписей.Статус <> Перечисления.СтатусыПлатежныхПоручений.Исполнено Тогда
					НоваяСтрока.ОстатокНаСчете	= НоваяСтрока.ОстатокНаСчете - НоваяСтрокаДетальныхЗаписей.Сумма;
					//НоваяСтрока.Сумма 			= НоваяСтрока.Сумма - НоваяСтрокаДетальныхЗаписей.Сумма;
				ИначеЕсли Не ЗначениеЗаполнено(НоваяСтрокаДетальныхЗаписей.Документ) Тогда
					СуммаПоДокументам = СуммаПоДокументам + НоваяСтрокаДетальныхЗаписей.Сумма;
				КонецЕсли;
				
				НоваяСтрокаДетальныхЗаписей.Формировать = Не ЗначениеЗаполнено(НоваяСтрокаДетальныхЗаписей.Документ) И СуммаПоДокументам <= НоваяСтрока.ОстатокНаСчете;
				НоваяСтрока.Сумма						= СуммаПоДокументам;
				
			КонецЦикла;
					
		КонецЦикла;
			
	КонецЦикла;
		
КонецПроцедуры                                                                                             

&НаКлиенте
Функция РазличаютсяКлючевойРеквизитВИсточникеИПриемнике(СтрокаИсточник, СтрокаПриемник, ИмяРеквизита)
		
	ЗначениеРеквизитаИсточника = ПолучитьЗначениеУзлаВеткиРекурсивно(СтрокаИсточник, ИмяРеквизита);
	ЗначениеРеквизитаПриемника = ПолучитьЗначениеУзлаВеткиРекурсивно(СтрокаПриемник, ИмяРеквизита);
	
	Возврат ЗначениеРеквизитаИсточника <> ЗначениеРеквизитаПриемника 
	       И (ЗначениеЗаполнено(ЗначениеРеквизитаИсточника) Или ЗначениеЗаполнено(ЗначениеРеквизитаПриемника));
	
КонецФункции

&НаКлиенте
Функция ПолучитьЗначениеУзлаВеткиРекурсивно(СтрокаДерева, ИмяРеквизита) 

	Если СтрокаДерева = Неопределено Тогда
		Возврат Неопределено
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДерева[ИмяРеквизита]) Тогда
		Возврат СтрокаДерева[ИмяРеквизита];
	Иначе
		Возврат ПолучитьЗначениеУзлаВеткиРекурсивно(СтрокаДерева.ПолучитьРодителя(), ИмяРеквизита);
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьИмяФайлаВыгрузки()
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.Банк) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяБанка = СократитьИмяБанка(ЭтаФорма.Банк);
	
	ЭтаФорма.ИмяФайлаВыгрузки = ЭтаФорма.КаталогФайловВыгрузки + ИмяБанка + "_Исходящие.txt";
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СократитьИмяБанка(Банк)
	
	Наименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Банк, "Наименование");
	
	Наименование = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(Наименование);
	
	МассивДляЗамены = Новый Массив;
	МассивДляЗамены.Добавить("(");
	МассивДляЗамены.Добавить(")");
	МассивДляЗамены.Добавить("ПАО ");
	МассивДляЗамены.Добавить(" ПАО");
	МассивДляЗамены.Добавить(" АО");
	МассивДляЗамены.Добавить("АО ");
	МассивДляЗамены.Добавить("КБ ");
	МассивДляЗамены.Добавить("Банк ");
	МассивДляЗамены.Добавить(" Банк");
	
	Для Каждого СтрокаЗамены Из МассивДляЗамены Цикл
		Наименование = СтрЗаменить(Наименование, СтрокаЗамены, "");
	КонецЦикла;
	
	Наименование = СтрЗаменить(Наименование, "МОСКОВСКИЙ КРЕДИТНЫЙ БАНК", "МКБ");
	
	Возврат СокрЛП(Наименование);
	
КонецФункции

&НаКлиенте
Процедура ПриИзмененииОтбораПлатежныхПоручений()
	
	ЭтаФорма.ПлатежныеПоручения.Очистить();
	
КонецПроцедуры 

&НаКлиенте
Процедура ПриИзмененииКлючевыхРеквизитов(ПерезаполнитьТаблицуДокументовОснований = Истина)
	
	ДокументыДляФормированияПлатежныхПоручений.ПолучитьЭлементы().Очистить();
	ПлатежныеПоручения.Очистить();
	
	Если ПерезаполнитьТаблицуДокументовОснований Тогда
		
		ОбновитьДокументыДляСозданияПлатежныхПорученийНаСервере();
		
		РаботаСФормамиКлиент.РазвернутьВсеЭлементыДерева(ДокументыДляФормированияПлатежныхПоручений, Элементы.ДокументыДляФормированияПлатежныхПоручений);
		
	КонецЕсли;                                                    
	
	ЕстьСтрокиФормирования = ЭтаФорма.ДокументыДляФормированияПлатежныхПоручений.ПолучитьЭлементы().Количество() > 0;
	
	ЭтаФорма.ВыгрузитьПорученияСоСтраницыФормирование			= ЕстьСтрокиФормирования;
	Элементы.ВыгрузитьПорученияСоСтраницыФормирование.Видимость	= ЕстьСтрокиФормирования;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьФлажкиРекурсивно(СтрокаДерева, Значение)
	
	МассивСтрокДерева = СтрокаДерева.ПолучитьЭлементы();
	Для Каждого СтрокаМассива Из МассивСтрокДерева Цикл
		СтрокаМассива.Формировать = Значение;
		ИзменитьФлажкиРекурсивно(СтрокаМассива, Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыДляФормированияПлатежныхПорученийИзменитьВсеФлажки(Значение)
		
	ИзменитьФлажкиРекурсивно(ДокументыДляФормированияПлатежныхПоручений, Значение);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПривестиОтборыВСоответствиеОрганизации(Форма, СчетаСоответствующиеОрганизации = Неопределено)
	
	Если СчетаСоответствующиеОрганизации = Неопределено Тогда
		ПроверитьСчетаНаСоответствиеОрганизации(Форма.Организация, Форма.ОтборСчетДоверительногоУправления, СчетаСоответствующиеОрганизации);	
	КонецЕсли;	
		
	Форма.ОтборСчетДоверительногоУправления.ЗагрузитьЗначения(СчетаСоответствующиеОрганизации);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьСчетаНаСоответствиеОрганизации(Организация, СчетаДоверительногоУправления, СчетаСоответствующиеОрганизации = Неопределено, СчетаНеСоответствующиеОрганизации = Неопределено)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	СчетаДоверительногоУправления.Организация = &Организация КАК Соответствует
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка В(&Ссылка)");
	
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("Ссылка",			СчетаДоверительногоУправления);
	
	ПроверенныеСчета					= Запрос.Выполнить().Выгрузить();
	СчетаСоответствующиеОрганизации		= ПроверенныеСчета.Скопировать(Новый Структура("Соответствует", Истина), "Ссылка").ВыгрузитьКолонку(0);
	СчетаНеСоответствующиеОрганизации	= ПроверенныеСчета.Скопировать(Новый Структура("Соответствует", Ложь), "Ссылка").ВыгрузитьКолонку(0);
	
	Возврат (СчетаНеСоответствующиеОрганизации.Количество() = 0);
	
КонецФункции

&НаКлиенте
Процедура ПриИзмененииОтбора()
	
	ПроверитьОтборВСписке(ЭтаФорма.ОтборСчетДоверительногоУправления, ЭтаФорма.ОтборСчетДоверительногоУправленияВСписке);
	ПроверитьОтборВСписке(ЭтаФорма.ОтборКлиент, ЭтаФорма.ОтборКлиентВСписке);
	ПроверитьОтборВСписке(ЭтаФорма.ОтборВидДоговораДоверительногоУправления, ЭтаФорма.ОтборВидДоговораДоверительногоУправленияВСписке);	
	ПроверитьОтборВСписке(ЭтаФорма.ОтборВидДокумента, ЭтаФорма.ОтборВидДокументаВСписке);	
	
	ОбновитьПредставлениеОтбора(ЭтаФорма);	
	
	ПриИзмененииКлючевыхРеквизитов(Ложь);	
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	ЭтаФорма.Модифицированность = Истина;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОтборВСписке(ОтборВСписке, РежимЗаполненияВСписке)
	
	Если Не РежимЗаполненияВСписке Тогда
		
		КоличествоЭлементов = ОтборВСписке.Количество();
		
		Если КоличествоЭлементов = 0 Тогда
			ОтборВСписке.Добавить(); // добавим первую строку
		ИначеЕсли КоличествоЭлементов > 1 Тогда
			Для Индекс = 1-КоличествоЭлементов По -1 Цикл
				ОтборВСписке.Удалить(-Индекс); // удалим все элементы, кроме первого
			КонецЦикла; 
		КонецЕсли; 
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьОтбор(Форма)
	
	Отбор = Новый Структура;
	
	Если Не СписокЗначенийПустой(Форма.ОтборСчетДоверительногоУправления) Тогда
		Отбор.Вставить("СчетДоверительногоУправления", Форма.ОтборСчетДоверительногоУправления);	
	КонецЕсли;
	
	Если Не СписокЗначенийПустой(Форма.ОтборКлиент) Тогда
		Отбор.Вставить("Клиент", Форма.ОтборКлиент);	
	КонецЕсли;
	
	Если Не СписокЗначенийПустой(Форма.ОтборВидДоговораДоверительногоУправления) Тогда
		Отбор.Вставить("ВидДоговораДоверительногоУправления", Форма.ОтборВидДоговораДоверительногоУправления);	
	КонецЕсли;
	
	Если Не СписокЗначенийПустой(Форма.ОтборВидДокумента) Тогда
		Отбор.Вставить("ВидДокумента", Форма.ОтборВидДокумента);	
	КонецЕсли;
		
	Возврат Отбор;	
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СписокЗначенийПустой(СписокЗначений)
	
	Результат = Истина;
	
	Для каждого Элемент Из СписокЗначений Цикл
		Если ЗначениеЗаполнено(Элемент.Значение) Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла; 
	
	Возврат Результат;	
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Элементы = Форма.Элементы;
	
	Элементы.ОтборСчетДоверительногоУправления.Видимость				= Не Форма.ОтборСчетДоверительногоУправленияВСписке;
	Элементы.ОтборСчетДоверительногоУправленияСписок.Видимость			= Форма.ОтборСчетДоверительногоУправленияВСписке;
		
	Элементы.ОтборКлиент.Видимость										= Не Форма.ОтборКлиентВСписке;
	Элементы.ОтборКлиентСписок.Видимость								= Форма.ОтборКлиентВСписке;
		
	Элементы.ОтборВидДоговораДоверительногоУправления.Видимость			= Не Форма.ОтборВидДоговораДоверительногоУправленияВСписке;
	Элементы.ОтборВидДоговораДоверительногоУправленияСписок.Видимость	= Форма.ОтборВидДоговораДоверительногоУправленияВСписке;
	
	Элементы.ОтборВидДокумента.Видимость								= Не Форма.ОтборВидДокументаВСписке;
	Элементы.ОтборВидДокументаСписок.Видимость							= Форма.ОтборВидДокументаВСписке;
	
	Элементы.ВыгрузитьПорученияСоСтраницыФормирование.Видимость			= Форма.ДокументыДляФормированияПлатежныхПоручений.ПолучитьЭлементы().Количество() > 0;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПредставлениеОтбора(Форма)
	
	Отбор = ПолучитьОтбор(Форма);
	
	Если Отбор.Количество() = 0 Тогда
		
		Форма.ПредставлениеОтбора = "Без отбора";
		
	Иначе
		
		ПредставлениеОтбора = Новый Массив;
		
		Для Каждого ЭлементОтбора Из Отбор Цикл
			
			Если ЭлементОтбора.Ключ = "СчетДоверительногоУправления" Тогда
				ПредставлениеЭлемента = "Счет в/у";
			ИначеЕсли ЭлементОтбора.Ключ = "Клиент" Тогда
				ПредставлениеЭлемента = "Клиент";	
			ИначеЕсли ЭлементОтбора.Ключ = "ВидДоговораДоверительногоУправления" Тогда
				ПредставлениеЭлемента = "Вид договора д/у";	
			ИначеЕсли ЭлементОтбора.Ключ = "ВидДокумента" Тогда
				ПредставлениеЭлемента = "Вид документа";		
			Иначе
				ПредставлениеЭлемента = ЭлементОтбора.Ключ;	
			КонецЕсли;		
			
			Если ТипЗнч(ЭлементОтбора.Значение) = Тип("СписокЗначений") Тогда
				ПредставлениеЗначения = СтрСоединить(ЭлементОтбора.Значение.ВыгрузитьЗначения(), ", ");
			Иначе
				ПредставлениеЗначения = ЭлементОтбора.Значение;
			КонецЕсли;
			
			ПредставлениеОтбора.Добавить(ПредставлениеЭлемента + ": " + ПредставлениеЗначения);	
			
		КонецЦикла;
		
		Форма.ПредставлениеОтбора = СтрСоединить(ПредставлениеОтбора, "; ");
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьИтогиВПодвале()
	
	Сумма      = 0;
	Количество = 0;

	СтрокиКВыгрузке     = ПлатежныеПоручения.НайтиСтроки(Новый Структура("Выгружать", Истина));
	Для каждого Строка Из СтрокиКВыгрузке Цикл
		Сумма      = Сумма      + Строка.Сумма;
		Количество = Количество + 1;
	КонецЦикла;
	
	КоличествоКВыгрузке	= Количество;
	СуммаКВыгрузке 		= Сумма;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьДоступныеОстатки()
	
	СчетаДУСПревышениемДоступногоОстатка = Новый Массив;
	
	МассивСтрокСчетовДУ = ДокументыДляФормированияПлатежныхПоручений.ПолучитьЭлементы();
	Для Каждого СтрокаСчетаДУ Из МассивСтрокСчетовДУ Цикл 
		
		ТекСчетДУ		= СтрокаСчетаДУ.СчетДоверительногоУправления;
		СчетДУДобавлен	= Ложь;
		
		МассивСтрокРасчетныхСчетов = СтрокаСчетаДУ.ПолучитьЭлементы();
		Для Каждого СтрокаРасчетногоСчета Из МассивСтрокРасчетныхСчетов Цикл
			
			Если СчетДУДобавлен Тогда
				Прервать;
			КонецЕсли;
			
			Если СтрокаРасчетногоСчета.ОстатокНаСчете >= СтрокаРасчетногоСчета.Сумма Тогда
				Продолжить;
			КонецЕсли;	
						
			МассивСтрокДокументов = СтрокаРасчетногоСчета.ПолучитьЭлементы();       
			
			Для Каждого СтрокаДокумента Из МассивСтрокДокументов Цикл 
				
				Если Не СтрокаДокумента.Формировать Тогда
					Продолжить;
				КонецЕсли;
								
				СчетаДУСПревышениемДоступногоОстатка.Добавить(ТекСчетДУ);
				СчетДУДобавлен = Истина;
				
				Прервать;
					
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
		
	Если СчетаДУСПревышениемДоступногоОстатка.Количество() > 0
		И Вопрос(
			СтрШаблон("Внимание! По следуюшим счетам ДУ доступные остатки требуют проверки: %1%2%3Продолжить формирование платежных поручений?",
				Символы.ПС + " - ",
				СтрСоединить(СчетаДУСПревышениемДоступногоОстатка, Символы.ПС + " - "),
				Символы.ПС),
			РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет
		Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти
