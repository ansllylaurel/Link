#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЭтаФорма.Список.Параметры.УстановитьЗначениеПараметра("ТекущаяДатаСеанса",	ТекущаяДатаСеанса());
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// Обновляем статусы поручений после выгрузки в клиент-банк
	Если ИмяСобытия = "ПлатежныеПоручения.Обновить" Тогда
		Элементы.Список.Обновить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаВыгрузитьПлатежныеПорученияЗаДень(Команда)
			
	ОткрытьФормуЭкспорта(Новый Структура("ПлатежныеПорученияЗаДень"));
	              	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыгрузитьОтмеченныеПлатежныеПоручения(Команда)
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	
	ПараметрыФормы = Новый Структура;
	Если ВыделенныеСтроки.Количество() > 0 Тогда
		ПараметрыФормы.Вставить("ВыбранныеПлатежныеПоручения", 	ВыделенныеСтроки);
		ПараметрыФормы.Вставить("Дата", 						ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыделенныеСтроки[0], "Дата"));		
	КонецЕсли;
	
	ОткрытьФормуЭкспорта(ПараметрыФормы);
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаКлиенте
Процедура ОткрытьФормуЭкспорта(ПараметрыФормы)

	ОткрытьФорму("Документ.ПлатежноеПоручениеИсходящее.Форма.ФормированиеИЭкспортПлатежныхПорученийВКлиентБанк", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

#КонецОбласти