&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступность(Форма)
	
	Элементы      = Форма.Элементы;
	ДанныеОбъекта = Форма.Объект;
	
	Элементы.КоэффициентРаспределения.Видимость = НЕ ДанныеОбъекта.ТолькоЗаписиКнигиПокупок;
	
КонецПроцедуры // НастроитьВидимостьДоступность

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПодборИмущества(Команда)
	
	ПараметрыПодбора = Новый Структура("Организация, СчетДоверительногоУправления", Объект.Организация, Объект.СчетДоверительногоУправления);
	
	ПараметрыПодбора.Вставить("ВидИмущества", Объект.ВидИмущества);
	
	ПараметрыПодбора.Вставить("ЗакрыватьПустой", Истина);
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПараметрыПодбора.Вставить("Период", РаботаСДокументами.ПолучитьМоментВремени(Объект.Ссылка));
	ИначеЕсли ЗначениеЗаполнено(Объект.Дата) Тогда
		ПараметрыПодбора.Вставить("Период", Объект.Дата);
	Иначе
		ПараметрыПодбора.Вставить("Период", Неопределено);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Основание) Тогда
		ПараметрыПодбора.Вставить("ЗаявкаПайщика", Объект.Основание);
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("ТипДокументаДляПодбора", Тип("ДокументСсылка.ВводПрочихАктивов"));
	
	// собственно, подбор
	ХранилищеВыбЗадолженности = ОткрытьФормуМодально("Документ.ЗаявкаПайщика.Форма.ФормаПодбораИмущества", ПараметрыПодбора, ЭтаФорма);
	
	Если ТипЗнч(ХранилищеВыбЗадолженности) = Тип("ХранилищеЗначения") Тогда
		ЗаполнитьИмуществоРезультатомПодбораНаСервере(ХранилищеВыбЗадолженности, Истина);
		Модифицированность = Истина;
	КонецЕсли;
	
		
КонецПроцедуры

&НаСервере
Функция ЗаполнитьИмуществоРезультатомПодбораНаСервере(ХранилищеВыбЗадолженности, ОбновитьРеквизитыШапки = Ложь)
	
	ОстаткиИмущества = ХранилищеВыбЗадолженности.Получить();
		
	// заполним документ
	ОбъектНаСервере = ЭтаФорма.РеквизитФормыВЗначение("Объект");
	
	Для НомСтр = 0 По ОстаткиИмущества.Количество() - 1 Цикл
		
		СтрокаОстаткиИмущества = ОстаткиИмущества[НомСтр];
		
		Если Объект.Имущество.НайтиСтроки(Новый Структура("Имущество", СтрокаОстаткиИмущества.Имущество)).Количество() = 0 Тогда
			НоваяСтрокаИмущество = Объект.Имущество.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаИмущество, СтрокаОстаткиИмущества);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции 

&НаСервереБезКонтекста
Функция ПолучитьСтоимостьИмуществаПоЗаявке(Период, ЗаявкаПайщика, ВидИмущества, Имущество)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоПрочимАктивамОстатки.СуммаОстаток КАК Сумма
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоПрочимАктивам.Остатки(
		|			&Период,
		|			Основание = &Ссылка
		|				И ВидИмущества = &ВидИмущества
		|				И Имущество = &Имущество) КАК ЗадолженностиПоПрочимАктивамОстатки";
	
	Запрос.УстановитьПараметр("ВидИмущества", ВидИмущества);
	Запрос.УстановитьПараметр("Имущество", Имущество);
	Запрос.УстановитьПараметр("Ссылка", ЗаявкаПайщика);
	Запрос.УстановитьПараметр("Период", Период);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Сумма;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

&НаКлиенте
Процедура ИмуществоИмуществоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Имущество.ТекущиеДанные;
	
	ТекущиеДанные.Сумма = ПолучитьСтоимостьИмуществаПоЗаявке(Объект.Дата, Объект.Основание, Объект.ВидИмущества, ТекущиеДанные.Имущество);
	
КонецПроцедуры


&НаКлиенте
Процедура ИмуществоПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыАктивов.Недвижимость") Тогда
		Элементы.Имущество.ТекущиеДанные.Количество = 1;
	КонецЕсли;

КонецПроцедуры

