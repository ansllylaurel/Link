
&НаСервереБезКонтекста
Функция ПолучитьПлановуюДатуПоставки(Период, Основание, ВидЗадолженности)
	
	ПлановаяДатаПоставки = Дата(1, 1, 1);
	ТипОснования         = ТипЗнч(Основание);
	
	Если ТипОснования = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ВЫБОР
			|		КОГДА УсловияСделокРЕПОСрезПоследних.ЧастьСделкиРЕПО = 2
			|			ТОГДА ВЫБОР
			|					КОГДА УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.РаздельноеИсполнениеВторойЧасти
			|						ТОГДА УсловияСделокРЕПОСрезПоследних.ДатаПоставки
			|					ИНАЧЕ УсловияСделокРЕПОСрезПоследних.ДатаИсполнения
			|				КОНЕЦ
			|		ИНАЧЕ ВЫБОР
			|				КОГДА УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.РаздельноеИсполнение
			|					ТОГДА УсловияСделокРЕПОСрезПоследних.ДатаПоставки
			|				ИНАЧЕ УсловияСделокРЕПОСрезПоследних.ДатаИсполнения
			|			КОНЕЦ
			|	КОНЕЦ КАК ПлановаяДатаПоставки
			|ИЗ
			|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
			|			&Период,
			|			НЕ Отменено
			|				И СделкаРЕПО = &СделкаРЕПО
			|				И ВидЗадолженности = &ВидЗадолженности) КАК УсловияСделокРЕПОСрезПоследних";
		
		Запрос.УстановитьПараметр("Период",           Период);
		Запрос.УстановитьПараметр("СделкаРЕПО",       ?(ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО, Основание.ПерваяЧастьРЕПО, Основание));
		Запрос.УстановитьПараметр("ВидЗадолженности", ВидЗадолженности);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ПлановаяДатаПоставки = Выборка.ПлановаяДатаПоставки;
		КонецЕсли;
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.Сделка") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ВЫБОР
			|		КОГДА УсловияСделокСрезПоследних.Сделка.РаздельноеИсполнение
			|			ТОГДА УсловияСделокСрезПоследних.ДатаПоставки
			|		ИНАЧЕ УсловияСделокСрезПоследних.ДатаИсполнения
			|	КОНЕЦ КАК ПлановаяДатаПоставки
			|ИЗ
			|	РегистрСведений.УсловияСделок.СрезПоследних(
			|			&Период,
			|			НЕ Отменено
			|				И Сделка = &Сделка) КАК УсловияСделокСрезПоследних";
		
		Запрос.УстановитьПараметр("Период", Период);
		Запрос.УстановитьПараметр("Сделка", Основание);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ПлановаяДатаПоставки = Выборка.ПлановаяДатаПоставки;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПлановаяДатаПоставки;
	
КонецФункции // ПолучитьПлановуюДатуПоставки

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСведенияОСделке(Форма)

	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
	Если Не ЗначениеЗаполнено(Объект.Основание) Или Не ЗначениеЗаполнено(Объект.ВидЗадолженности) Тогда
		Элементы.НадписьСведенияОСделке.Заголовок = "";
		Возврат;
	КонецЕсли;
	
	РеквизитыСделки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Основание, "Брокер, МестоХранения, Контрагент");
	
	СведенияОСделке = ""
		+ РеквизитыСделки.МестоХранения
		+ ", " + ?(ЗначениеЗаполнено(РеквизитыСделки.Брокер), "сделка через брокера " + РеквизитыСделки.Брокер, "прямая сделка")
		+ ?(ЗначениеЗаполнено(РеквизитыСделки.Контрагент), ", " + РеквизитыСделки.Контрагент, "")
		+ ". Плановая дата поставки - " + Формат(ПолучитьПлановуюДатуПоставки(Объект.Дата, Объект.Основание, Объект.ВидЗадолженности), "ДФ=dd.MM.yyyy") + ".";
		
	Элементы.НадписьСведенияОСделке.Заголовок = СведенияОСделке;
	
КонецПроцедуры // ЗаполнитьСведенияОСделке

&НаСервереБезКонтекста
Функция ПолучитьФлагПриобретениеПаев(Основание)
	
	ПриобретениеПаев = Ложь;
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.Сделка") И Основание.ПриобретениеПаев Тогда
		ПриобретениеПаев = Основание.ПриобретениеПаев;
	КонецЕсли;
	
	Возврат ПриобретениеПаев;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере(ИдСтрокиКорзины = Неопределено) Экспорт
	
	НомерСтрокиКорзины = ?(ИдСтрокиКорзины = Неопределено, Неопределено,
		Объект.ЦенныеБумаги.Индекс(Объект.ЦенныеБумаги.НайтиПоИдентификатору(ИдСтрокиКорзины)));
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ЗаполнитьНоминалыЦенныхБумагИСуммыВсего(ЭтаФорма, Объект,, НомерСтрокиКорзины);
	
КонецПроцедуры // ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере

&НаСервере
Процедура ЗаполнитьДепозитарныеСчетаПлановымиЗначениямиНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦенныеБумаги.НомерСтроки,
		|   ЦенныеБумаги.ЦеннаяБумага
		|ПОМЕСТИТЬ
		|	_ЦенныеБумаги
		|ИЗ
		|	&ЦенныеБумаги КАК ЦенныеБумаги
		|ИНДЕКСИРОВАТЬ ПО
		|	ЦеннаяБумага
		|;
		|
		|/////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦенныеБумаги.НомерСтроки,
		|	УсловияСделокСрезПоследних.ДепозитарныйСчет
		|ИЗ
		|	_ЦенныеБумаги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделок[РЕПО].СрезПоследних(
		|				&Период,
		|				НЕ Отменено
		|					И Сделка[РЕПО] = &Сделка [ОтборПоЧастиСделкиРЕПО]) КАК УсловияСделокСрезПоследних
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = УсловияСделокСрезПоследних.ЦеннаяБумага
		|УПОРЯДОЧИТЬ ПО
		|	_ЦенныеБумаги.НомерСтроки";
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[РЕПО]",                   ?(ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.СделкаРЕПО"), "РЕПО", ""));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[ОтборПоЧастиСделкиРЕПО]", ?(ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.СделкаРЕПО"), "И ЧастьСделкиРЕПО = &ЧастьСделкиРЕПО", ""));
	
	Запрос.УстановитьПараметр("Период",          ?(ЗначениеЗаполнено(Объект.Ссылка), Объект.Дата, Неопределено));
	Запрос.УстановитьПараметр("Сделка",          Объект.Основание);
	Запрос.УстановитьПараметр("ЦенныеБумаги",    Объект.ЦенныеБумаги.Выгрузить());
	Запрос.УстановитьПараметр("ЧастьСделкиРЕПО", РаботаСЗадолженностямиКлиентСерверПовтИсп.ПолучитьЧастьСделкиРЕПОПоВидуЗадолженности(Объект.ВидЗадолженности));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Объект.ЦенныеБумаги[Выборка.НомерСтроки - 1].ДепозитарныйСчет = Выборка.ДепозитарныйСчет;
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьДепозитарныеСчетаПлановымиЗначениямиНаСервере

&НаСервере
Функция ЗаполнитьЦенныеБумагиОстаткамиЗадолженностиНаСервере(ХранилищеОстатковЗадолженности, ОбновитьРеквизитыШапки = Ложь)
	
	ОстаткиЗадолженности = ХранилищеОстатковЗадолженности.Получить();
		
	// при подборе, в ряде случаев, возможен неуникальный ключ тип + вид задолженности
	ВариантыЗадолженности = ОстаткиЗадолженности.Скопировать(, "Основание, Рынок, ТипЗадолженности, ВидЗадолженности");
	ВариантыЗадолженности.Свернуть("Основание, Рынок, ТипЗадолженности, ВидЗадолженности", "");
	
	Если ВариантыЗадолженности.Количество() > 1 Тогда
		Сообщить("При подборе следует выбирать только один тип и вид задолженности по одному основанию и одному рынку.");
		Возврат Ложь;
	КонецЕсли;
	
	// заполним документ
	Для НомСтр = 0 По ОстаткиЗадолженности.Количество() - 1 Цикл
		СтрокаОстаткиЗадолженности = ОстаткиЗадолженности[НомСтр];
		
		Если ОбновитьРеквизитыШапки И НомСтр = 0 Тогда
			ЗаполнитьЗначенияСвойств(Объект, СтрокаОстаткиЗадолженности);
			Объект.ВидДвижения = РаботаСЗадолженностямиКлиентСерверПовтИсп.ПолучитьВидДвиженияПоТипуЗадолженности(СтрокаОстаткиЗадолженности.ТипЗадолженности);
		КонецЕсли;
			
		НоваяСтрокаЦенныеБумаги = Объект.ЦенныеБумаги.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаЦенныеБумаги, СтрокаОстаткиЗадолженности);
	КонецЦикла;
	
	ЗаполнитьСведенияОСделке(ЭтаФорма);
	
	// заполним реквизиты формы, связанные с таб.ч. ц/б
	Объект.ЦенныеБумаги.Загрузить(
		РаботаСЦеннымиБумагами.ЗаполнитьНоминалыИСуммыВсегоВТаблице(
			Объект.ЦенныеБумаги.Выгрузить(), Объект.Дата));
			
	ЗаполнитьДепозитарныеСчетаПлановымиЗначениямиНаСервере();

	РаботаСКорзинойЦенныхБумагКлиентСервер.НастроитьОтображение(ЭтаФорма, Истина);
	
	Возврат Истина;
	
КонецФункции // ЗаполнитьЦенныеБумагиОстаткамиЗадолженностиНаСервере

&НаСервере
Функция ЗаполнитьИсполнениеПоЦеннымБумагамНаОснованииНаСервере()
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	ТребуетсяПодбор = РаботаСДокументами.ЗаполнитьИсполнениеПоЦеннымБумагамНаОсновании(ОбъектНаСервере, ОбъектНаСервере.Основание, ОбъектНаСервере.ВидЗадолженности);
	
	ЗначениеВРеквизитФормы(ОбъектНаСервере, "Объект");
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ПеренестиРеквизитыИзТаблицыВФорму(ЭтаФорма);
	
	Если ТребуетсяПодбор = Неопределено Тогда
		ТребуетсяПодбор = Ложь;
	КонецЕсли;
	
	Возврат ТребуетсяПодбор;
	
КонецФункции // ЗаполнитьИсполнениеПоЦеннымБумагамНаОснованииНаСервере

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ЭтаФорма.ПриобретениеПаев = ПолучитьФлагПриобретениеПаев(Объект.Основание);
	
	ЗаполнитьСведенияОСделке(ЭтаФорма);
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.НастроитьОтображение(ЭтаФорма, Истина);
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры // ПриЧтенииСозданииНаСервере

&НаКлиенте
Процедура ВыбратьВариантОснования(Отказ)
	
	ПараметрыПодбора = Новый Структура("МножественныйВыбор, ЗакрыватьПустой, Основание, Организация, СчетДоверительногоУправления, Рынок");
	ЗаполнитьЗначенияСвойств(ПараметрыПодбора, Объект);
	
	ПараметрыПодбора.МножественныйВыбор = Истина;
	ПараметрыПодбора.ЗакрыватьПустой    = Истина;
	
	ХранилищеОстатковЗадолженности = ОткрытьФормуМодально("ОбщаяФорма.ПодборЗадолженностиПоЦеннымБумагам", ПараметрыПодбора, ЭтаФорма);
	
	Если ТипЗнч(ХранилищеОстатковЗадолженности) = Тип("ХранилищеЗначения") Тогда
		Если Не ЗаполнитьЦенныеБумагиОстаткамиЗадолженностиНаСервере(ХранилищеОстатковЗадолженности, Истина) Тогда
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // ВыбратьВариантОснования

&НаКлиенте
Процедура ЗаполнитьДокументНаОсновании()

	Если ЗначениеЗаполнено(Объект.Основание)
		И Вопрос("Заполнить документ на основании выбранной сделки?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да
	Тогда
		Если Не ЗаполнитьИсполнениеПоЦеннымБумагамНаОснованииНаСервере() Тогда
			Отказ = Ложь;
			ВыбратьВариантОснования(Отказ);
			
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		// просто обновим сведения о сделке
		ЗаполнитьСведенияОСделке(ЭтаФорма);
		Возврат;
		
	КонецЕсли;
	
	ЭтаФорма.ПриобретениеПаев = ПолучитьФлагПриобретениеПаев(Объект.Основание);
	
КонецПроцедуры // ЗаполнитьДокументНаОсновании

#Область СОБЫТИЯ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	// т.к. страницами удобно пользоваться на этапе разработки, отключим их на этапе исполнения
	Элементы.ГруппаЦенныеБумаги.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере()
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) И ЗначениеЗаполнено(Объект.Основание) И Не ЗначениеЗаполнено(Объект.ВидДвижения) Тогда
		
		ВыбратьВариантОснования(Отказ);
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Не ЭтаФорма.КорзинаЦенныхБумаг Тогда
		РаботаСКорзинойЦенныхБумагКлиентСервер.ПеренестиРеквизитыИзФормыВТаблицу(ЭтаФорма);
	КонецЕсли;
	
	Если Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Доли") Тогда
		Для Каждого СтрокаЦенныхБумаг Из Объект.ЦенныеБумаги Цикл
			СтрокаЦенныхБумаг.ДепозитарныйСчет = ПредопределенноеЗначение("Справочник.ДепозитарныеСчета.СчетУчетаДолей");
		КонецЦикла;
	КонецЕсли;
	
	Если Объект.Взаимозачет И НЕ (ЗначениеЗаполнено(Объект.Основание) 
		И ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.СделкаРЕПО")
		И СделкаРЕПОЯвляетсяПокупкой(Объект.Основание)) Тогда
		
		Объект.Взаимозачет = Ложь;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// после записи теряются значения реквизитов, добавленных к т.ч. объекта
	Если ЭтаФорма.КорзинаЦенныхБумаг Тогда
		ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере();
	КонецЕсли;
	
	ЗаполнитьПодтверждениеОперацииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
	РаботаСДокументамиКлиент.ПроверитьПараметрыПодтвержденияОперации(ЭтаФорма, Объект, ПараметрыЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ПодтверждениеОперации" Тогда
		Если Параметр = Объект.Ссылка
			ИЛИ (ТипЗнч(Параметр) = Тип("Массив") И Параметр.Найти(Объект.Ссылка) <> Неопределено)
		Тогда
			ЗаполнитьПодтверждениеОперацииНаСервере();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

