&НаКлиенте
Процедура КомандаПодборЦенныхБумаг(Команда)
	
	// обязательные поля отбора
	ПараметрыПодбора = Новый Структура("МножественныйВыбор", Истина);
	
	// не обязательные поля отбора, передача которых определяется заполненными полями
	ПоляОтбораЗадолженности = "Организация, Основание, ВидЗадолженности";
	ПоляОтбораЗадолженности = СтрЗаменить(ПоляОтбораЗадолженности, ", ", Символы.ПС);
	
	Для НомСтр = 1 По СтрЧислоСтрок(ПоляОтбораЗадолженности) Цикл
		ПолеОтбораЗадолженности = СтрПолучитьСтроку(ПоляОтбораЗадолженности, НомСтр);
		Если ЗначениеЗаполнено(Объект[ПолеОтбораЗадолженности]) Тогда
			ПараметрыПодбора.Вставить(ПолеОтбораЗадолженности, Объект[ПолеОтбораЗадолженности]);
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Объект.Основание) Тогда
		ПараметрыПодбора.Вставить("СчетДоверительногоУправления");
		ПараметрыПодбора.Вставить("Рынок");
		ЗаполнитьЗначенияСвойств(ПараметрыПодбора, ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Основание, "СчетДоверительногоУправления, Рынок"));
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("Период", РаботаСДокументами.ПолучитьМоментВремени(Объект.Ссылка));
	
	// не обязательные поля, которые соответствуют не 1:1
	Если ЗначениеЗаполнено(Объект.ВидДвижения) Тогда
		ПараметрыПодбора.Вставить("ТипЗадолженности", РаботаСЗадолженностямиКлиентСерверПовтИсп.ПолучитьТипЗадолженностиПоВидуДвижения(Объект.ВидДвижения));
	КонецЕсли;
	
	// собственно, подбор
	ХранилищеОстатковЗадолженности = ОткрытьФормуМодально("ОбщаяФорма.ПодборЗадолженностиПоЦеннымБумагам", ПараметрыПодбора, ЭтаФорма);
	
	Если ТипЗнч(ХранилищеОстатковЗадолженности) = Тип("ХранилищеЗначения") Тогда
		ЗаполнитьЦенныеБумагиОстаткамиЗадолженностиНаСервере(ХранилищеОстатковЗадолженности, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОчиститьЦенныеБумаги(Команда)
	
	Если Объект.ЦенныеБумаги.Количество() > 0 Тогда
		Если Вопрос("Вы действительно хотите очистить табличную часть документа?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			Объект.ЦенныеБумаги.Очистить();
		КонецЕсли;
