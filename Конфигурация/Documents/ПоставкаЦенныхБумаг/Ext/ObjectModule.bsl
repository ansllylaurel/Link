			Проводка.КоличествоДт = Выборка.Количество;
			Проводка.ВалютаДт = Выборка.ЦеннаяБумага.ВалютаНоминала;
			Проводка.ВалютнаяСуммаДт = Выборка.Стоимость;
			
			Если Выборка.СтоимостьКупона > 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СтоимостьКупонаВВалютеУчета, "Бумаги купленные по РЕПО");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Основной.ПартииРЕПОПокупкаКупон;
				Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
				
				Проводка.ВалютаДт = Выборка.ЦеннаяБумага.ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт = Выборка.СтоимостьКупона;
				
			КонецЕсли; 
			
		Иначе // ЗАКРЫТИЕ ПОКУПКИ РЕПО
			
