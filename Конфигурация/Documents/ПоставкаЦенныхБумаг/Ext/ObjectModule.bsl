КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерииОбычнаяСделка(УчетныйРегистр, Отказ)
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не реализовано проведение по РЕПО",,,,Отказ);
	//код ниже стырен из сделки РЕПО, надо почистить лишнее
	Возврат;
	
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);

	ВидСубконтоУчетаЦеннойБумаги = БухгалтерскийУчет.ОпределитьВидСубконтоУчетаЦеннойБумаги(ЭтотОбъект.Рынок);	
		
	СчетДоходов = ПланыСчетов.Основной.ПрочиеДоходы;	
	СчетРасходов = ПланыСчетов.Основной.ПрочиеРасходы;
		
	ИспользоватьСчетПродаж = БухгалтерскийУчет.ОпределитьНастройкуУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		"ИспользоватьСчетПродаж");
		
	Если ИспользоватьСчетПродаж Тогда
		СчетДоходов = ПланыСчетов.Основной.Выручка;
		СчетРасходов = ПланыСчетов.Основной.СебестоимостьПродажи;
	КонецЕсли;	
	
	СчетУчетаДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВалютаСделки,
		ЭтотОбъект.Основание.Брокер);	
		
	СчетУчетаКомиссии = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
		УчетныйРегистр,
		"СчетУчета");
		
	Если ЭтотОбъект.Основание.Брокер <> Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
		КонтрагентПоСделке = ЭтотОбъект.Основание.Брокер.ЮрФизЛицо;
	Иначе
		КонтрагентПоСделке = ЭтотОбъект.Основание.Контрагент;
	КонецЕсли;
	
	ПараметрыКомиссии = Новый Структура;
	ПараметрыКомиссии.Вставить("СчетУчетаКомиссии", СчетУчетаКомиссии);
	ПараметрыКомиссии.Вставить("СчетУчетаДС", СчетУчетаДС);
	
	Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
		СубконтоДоговорыБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Основание.Брокер, ЭтотОбъект.Дата);
		ПараметрыКомиссии.Вставить("СубконтоДоговорыБрокерскогоОбслуживания", СубконтоДоговорыБрокерскогоОбслуживания);
	КонецЕсли;
		
	ЕстьСубконтоКонтрагентыПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);						
	ПараметрыКомиссии.Вставить("ЕстьСубконтоКонтрагентыПоКомиссии", ЕстьСубконтоКонтрагентыПоКомиссии);
	Если ЕстьСубконтоКонтрагентыПоКомиссии Тогда
		КонтрагентПоКомиссии = КонтрагентПоСделке;
		ПараметрыКомиссии.Вставить("КонтрагентПоКомиссии", КонтрагентПоКомиссии);
	КонецЕсли;
	
	ЕстьСубконтоСделкиПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Сделка) <> Неопределено);
	ПараметрыКомиссии.Вставить("ЕстьСубконтоСделкиПоКомиссии", ЕстьСубконтоСделкиПоКомиссии);
	
	АналитикаУслуг = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
	ЭтотОбъект.Дата, 
	ЭтотОбъект.Организация, 
	ЭтотОбъект.СчетДоверительногоУправления,
	Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
	УчетныйРегистр,
	"Аналитика");	
	
	ПараметрыКомиссии.Вставить("АналитикаУслуг", АналитикаУслуг);
	ПараметрыКомиссии.Вставить("ВидСубконтоУчетаЦеннойБумаги", ВидСубконтоУчетаЦеннойБумаги);
	
	// ЦЕННЫЕ БУМАГИ
	СведенияОбОбращенииЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(ЭтотОбъект.Дата, ЭтотОбъект.Ссылка, УчетныйРегистр);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.СтрокаКорзиныЦенныхБумаг,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.ВидДвижения,
		|	СУММА(БухПартииЦенныхБумаг.Количество) КАК Количество,
		|	СУММА(БухПартииЦенныхБумаг.Стоимость) КАК Стоимость,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупона) КАК СтоимостьКупона,
		|	СУММА(БухПартииЦенныхБумаг.Переоценка) КАК Переоценка,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупона) КАК ПереоценкаКупона,
		|	СУММА(БухПартииЦенныхБумаг.СуммаЧастичногоПогашения) КАК СуммаЧастичногоПогашения
		|ПОМЕСТИТЬ _ДвиженияПартий
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.СтрокаКорзиныЦенныхБумаг,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.ВидДвижения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДвиженияПартий.ЦеннаяБумага,
		|	_ДвиженияПартий.Количество,
		|	_ДвиженияПартий.ВидДвижения,
		|	_ДвиженияПартий.Стоимость,
		|	_ДвиженияПартий.СтоимостьКупона,
		|	_ДвиженияПартий.Переоценка,
		|	_ДвиженияПартий.ПереоценкаКупона,
		|	_ДвиженияПартий.СуммаЧастичногоПогашения,
		|	СделкаЦенныеБумаги.ТорговаяКомиссия,
		|	СделкаЦенныеБумаги.Сумма,
		|	СделкаЦенныеБумаги.СуммаКупона
		|ИЗ
		|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДвиженияПартий КАК _ДвиженияПартий
		|		ПО СделкаЦенныеБумаги.НомерСтроки = _ДвиженияПартий.СтрокаКорзиныЦенныхБумаг
		|ГДЕ
		|	СделкаЦенныеБумаги.Ссылка = &Регистратор";

	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		
		ОбращаетсяНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(Выборка.ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
		
		УчетныйАктив       = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, ЭтотОбъект.Рынок, Выборка.ЦеннаяБумага);
		УчетныйАктивКупона = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, ЭтотОбъект.Рынок, Выборка.ЦеннаяБумага, Истина);
		
		НастройкиУчетаАктива = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктив,
			УчетныйРегистр);		
			
		НастройкиУчетаКупона = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктивКупона,
			УчетныйРегистр);		
			
		ВключатьРасходыПоПокупкеВСтоимость = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
			ЭтотОбъект.Дата, 
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйРегистр,
			"ВключатьРасходыПоПокупкеВСтоимость");
			
		ВыделятьРасходыПриПродаже = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
			ЭтотОбъект.Дата, 
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйРегистр,
			"ВыделятьРасходыПриПродаже");
			
		ПараметрыКомиссии.Вставить("ВключатьРасходыПоПокупкеВСтоимость", ВключатьРасходыПоПокупкеВСтоимость И (Выборка.ВидДвижения = ВидДвиженияНакопления.Приход));
		ПараметрыКомиссии.Вставить("ЦеннаяБумага", Выборка.ЦеннаяБумага);
		ПараметрыКомиссии.Вставить("ОбращаетсяНаОРЦБ", ОбращаетсяНаОРЦБ);
		ПараметрыКомиссии.Вставить("СчетУчета", НастройкиУчетаАктива.СчетУчета);
		
		
		Если Выборка.ВидДвижения = ВидДвиженияНакопления.Приход Тогда // ПОКУПКА
				
		    // ПРИХОДУЕМ СТОИМОСТЬ ТЕЛА
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.Сумма, "Покупка ценной бумаги");
			
			// дебет
			Проводка.СчетДт = НастройкиУчетаАктива.СчетУчета;
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = Выборка.ЦеннаяБумага;
			
			Проводка.КоличествоДт = Выборка.Количество;
			
			// кредит
			Проводка.СчетКт = СчетУчетаДС;
			Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.Основание.РасчетныйСчет;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
				Проводка.СубконтоКт.БрокерскиеКомпании              = ЭтотОбъект.Основание.Брокер;
				Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
			КонецЕсли;
			
			Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				// ПРИХОДУЕМ СТОИМОСТЬ КУПОНА
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СтоимостьКупона, "Покупка ценной бумаги (купон)");
				
				// дебет
				Проводка.СчетДт = НастройкиУчетаКупона.СчетУчета;
				Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = Выборка.ЦеннаяБумага;
				
				// кредит
				Проводка.СчетКт = СчетУчетаДС;
				Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.Основание.РасчетныйСчет;
				
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
					Проводка.СубконтоКт.БрокерскиеКомпании              = ЭтотОбъект.Основание.Брокер;
					Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
				КонецЕсли;
			
			КонецЕсли;
			
		ИначеЕсли Выборка.ВидДвижения = ВидДвиженияНакопления.Расход Тогда // ПРОДАЖА	
			// СПИСЫВАЕМ СЕБЕСТОИМОСТЬ В РАСХОДЫ
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.Стоимость, "Продажа ценной бумаги");
			
			Проводка.СчетДт = СчетРасходов;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходовОтРеализации;
			Проводка.СубконтоДт.ЦенныеБумаги         = Выборка.ЦеннаяБумага;
			Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
			
			Проводка.СчетКт = НастройкиУчетаАктива.СчетУчета;
			Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = Выборка.ЦеннаяБумага;
			
			Проводка.КоличествоКт = Выборка.Количество;
			
			Если Выборка.Переоценка <> 0 Тогда
				// СПИСЫВАЕМ СЕБЕСТОИМОСТЬ ПЕРЕОЦЕНКИ ПРОДАННОЙ БУМАГИ В РАСХОДЫ
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.Переоценка, "Продажа ценной бумаги");
				
				Проводка.СчетДт = СчетРасходов;
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходовОтРеализации;
				Проводка.СубконтоДт.ЦенныеБумаги         = Выборка.ЦеннаяБумага;
				Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
				
				Проводка.СчетКт = НастройкиУчетаАктива.СчетУчетаПереоценки;
				Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = Выборка.ЦеннаяБумага;
				
			КонецЕсли;
			
			// ПРИХОДУЕМ ДОХОД ОТ ПРОДАЖИ
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.Сумма, "Продажа ценной бумаги");
			
			Проводка.СчетДт = СчетУчетаДС;
			Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.Основание.РасчетныйСчет;
			
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
				Проводка.СубконтоДт.БрокерскиеКомпании              = ЭтотОбъект.Основание.Брокер;
				Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
			КонецЕсли;
			
			Проводка.СчетКт = СчетДоходов;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходовОтРеализации;
			Проводка.СубконтоКт.ЦенныеБумаги         = Выборка.ЦеннаяБумага;
			Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
			
			
			Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			    // СПИСЫВАЕМ СЕБЕСТОИМОСТЬ ПРОДАННОГО КУПОНА В РАСХОДЫ
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СтоимостьКупона, "Продажа ценной бумаги (купон)");
				
				Проводка.СчетДт = СчетРасходов;
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаКупона.АналитикаДоходовОтРеализации;
				Проводка.СубконтоДт.ЦенныеБумаги         = Выборка.ЦеннаяБумага;
				Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
				
				Проводка.СчетКт = НастройкиУчетаКупона.СчетУчета;
				Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = Выборка.ЦеннаяБумага;
				
				Если Выборка.ПереоценкаКупона <> 0 Тогда
					
				    // СПИСЫВАЕМ СЕБЕСТОИМОСТЬ ПЕРОЦЕНКИ ПРОДАННОГО КУПОНА В РАСХОДЫ
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.ПереоценкаКупона, "Продажа ценной бумаги (купон)");
					
					Проводка.СчетДт = СчетРасходов;
					
					Если УчетныйРегистр = "НалоговыйУчет" Тогда
						Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаКупона.АналитикаДоходовОтПереоценки;
					Иначе
						Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаКупона.АналитикаДоходовОтРеализации;
					КонецЕсли;
					
					Проводка.СубконтоДт.ЦенныеБумаги     = Выборка.ЦеннаяБумага;
					Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
					
					Проводка.СчетКт = НастройкиУчетаКупона.СчетУчетаПереоценки;
					Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = Выборка.ЦеннаяБумага;
						
				КонецЕсли;
				
				// ПРИХОДУЕМ ДОХОД ОТ ПРОДАЖИ КУПОНА
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СуммаКупона, "Продажа ценной бумаги (купон)");
				
				Проводка.СчетДт = СчетУчетаДС;
				Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.Основание.РасчетныйСчет;
				
				Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
					Проводка.СубконтоДт.БрокерскиеКомпании              = ЭтотОбъект.Основание.Брокер;
					Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
				КонецЕсли;
				
				Проводка.СчетКт = СчетДоходов;
				Проводка.СубконтоКт.ПрочиеДоходыИРасходы = НастройкиУчетаКупона.АналитикаДоходовОтРеализации;
				Проводка.СубконтоКт.ЦенныеБумаги         = Выборка.ЦеннаяБумага;
				Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
				
				Если Выборка.СуммаЧастичногоПогашения <> 0 Тогда
					// СПИСАНИЕ ЗАДОЛЖЕННОСТИ ПО ЧАСТИЧНОМУ ПОГАШЕНИЮ
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СуммаЧастичногоПогашения, "Списание ранее начисленного аванса");
					
					Проводка.СчетДт = ПланыСчетов.Основной.АвансыПоЧастичномуПогашениюОблигаций;
					Проводка.СубконтоДт.Облигации = Выборка.ЦеннаяБумага;
					
					Проводка.СчетКт = СчетДоходов;
					Проводка.СубконтоКт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходов;
					Проводка.СубконтоКт.ЦенныеБумаги         = Выборка.ЦеннаяБумага;
					Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
				
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;	
		
	КонецЦикла;
	

КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт

	Движения[УчетныйРегистр].Записывать = Истина;
	
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		УчетныйРегистр,
		Отказ); 
		
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствуют настройки у %1 по виду учета %2 на %3!", ЭтотОбъект.СчетДоверительногоУправления, УчетныйРегистр, ЭтотОбъект.Дата));
		Возврат;
	КонецЕсли;
		
	Если ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		
		Если НастройкиПоВидуУчета.УчитыватьПартииРЕПООтдельно Тогда // учитываем как репо
		
			ЭтоОбычнаяСделка = Ложь;
			
			Если	ЭтотОбъект.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка 
				И ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Приход 
				И ЭтотОбъект.Основание.ЧастьСделкиРЕПО = 1
					ИЛИ
				ЭтотОбъект.Основание.ВидСделки = Перечисления.ВидыСделок.Продажа 
				И ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Расход 
				И ЭтотОбъект.Основание.ЧастьСделкиРЕПО = 2 
					ИЛИ
				ЭтотОбъект.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка 
				И ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Приход 
				И ЭтотОбъект.Основание.ЧастьСделкиРЕПО = 0
					ИЛИ
				ЭтотОбъект.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка 
				И ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Расход 
				И ЭтотОбъект.Основание.ЧастьСделкиРЕПО = 0 
			Тогда	
					
				ПроведениеПоРегиструБухгалтерииОбратноеРЕПО(УчетныйРегистр, НастройкиПоВидуУчета.МетодПризнанияРасходовПоСделкамРЕПО , Отказ);
				
			Иначе
				
				ПроведениеПоРегиструБухгалтерииПрямоеРЕПО(УчетныйРегистр, Отказ);
				
			КонецЕсли;
			
		Иначе
			
			ПроведениеПоРегиструБухгалтерииОбычнаяСделка(УчетныйРегистр, Отказ);
		
		КонецЕсли;
	
		Возврат;
		
	КонецЕсли;
	
	БухгалтерскийУчет.СформироватьПроводкиПокупкиПродажиЦеннойБумагиБУНУ(ЭтотОбъект, УчетныйРегистр, Отказ);
	
КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения) И ЭтотОбъект.Метаданные().Реквизиты.Основание.Тип.СодержитТип(ТипЗнч(ДанныеЗаполнения)) Тогда // ввод на основании
		РаботаСДокументами.ЗаполнитьИсполнениеПоЦеннымБумагамНаОсновании(ЭтотОбъект, ДанныеЗаполнения);
	КонецЕсли;
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры // ОбработкаЗаполнения

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
			
	// предварительная обработка объекта
	РаботаСДокументами.ЗаполнитьСтрокиПартии(ЭтотОбъект);
	
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);
	
	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда

		ТипЦеннойБумаги = РаботаСЦеннымиБумагамиКлиентСервер.ТипЦеннойБумагиВЗависимостиОтРынка(ЭтотОбъект.Рынок);
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДокументТабличнаяЧасть.НомерСтроки КАК НомерСтроки,
			|	ДокументТабличнаяЧасть.ДепозитарныйСчет КАК ДепозитарныйСчет,
			|	ДокументТабличнаяЧасть.ЦеннаяБумага КАК ЦеннаяБумага
			|ПОМЕСТИТЬ _ДокументТабличнаяЧасть
			|ИЗ
			|	&ДокументТабличнаяЧасть КАК ДокументТабличнаяЧасть
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_ДокументТабличнаяЧасть.ДепозитарныйСчет КАК ДепозитарныйСчет,
			|	_ДокументТабличнаяЧасть.НомерСтроки КАК НомерСтроки,
			|	УсловияСделокСрезПоследних.Период ЕСТЬ NULL КАК УсловияСделкиЗаданы
			|ИЗ
			|	_ДокументТабличнаяЧасть КАК _ДокументТабличнаяЧасть
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделок.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И Сделка = &ДокументОснование) КАК УсловияСделокСрезПоследних
			|		ПО (УсловияСделокСрезПоследних.ЦеннаяБумага = _ДокументТабличнаяЧасть.ЦеннаяБумага)
			|			И (УсловияСделокСрезПоследних.ДепозитарныйСчет = _ДокументТабличнаяЧасть.ДепозитарныйСчет)
			|ГДЕ
			|	УсловияСделокСрезПоследних.ДепозитарныйСчет ЕСТЬ NULL";
		
		Если ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.СделкаРЕПО") Тогда 
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "УсловияСделок", "УсловияСделокРЕПО");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Сделка", "СделкаРЕПО");
		КонецЕсли;

		Запрос.УстановитьПараметр("Период"                , ЭтотОбъект.Дата);
		Запрос.УстановитьПараметр("Организация"           , ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("ДокументТабличнаяЧасть", ЭтотОбъект.ЦенныеБумаги.Выгрузить(,"НомерСтроки, ДепозитарныйСчет, ЦеннаяБумага"));
		Запрос.УстановитьПараметр("ДокументОснование"     , ЭтотОбъект.Основание);
		
		ВыборкаДанных = Запрос.Выполнить().Выбрать();
		
		Пока ВыборкаДанных.Следующий() Цикл
			Если НЕ ВыборкаДанных.УсловияСделкиЗаданы Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для строки № " + ВыборкаДанных.НомерСтроки + " не заданы условия сделки.",ЭтотОбъект,,, Отказ);
			Иначе	
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке № " + ВыборкаДанных.НомерСтроки + " депозитарный счет [" + ВыборкаДанных.ДепозитарныйСчет + "] не соответствует условиям сделки.",ЭтотОбъект,,, Отказ);
			КонецЕсли;
		КонецЦикла;
			
		Для НомСтр = 0 По ЭтотОбъект.ЦенныеБумаги.Количество() - 1 Цикл
			
			СтрокаЦенныеБумаги = ЭтотОбъект.ЦенныеБумаги[НомСтр];

			// проверим, что рынок соответствует типу ценной бумаги
			Если Не ТипЦеннойБумаги.СодержитТип(ТипЗнч(СтрокаЦенныеБумаги.ЦеннаяБумага)) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Тип ценной бумаги в строке № " + (НомСтр + 1) + " не соответствует рынку " + ЭтотОбъект.Рынок + ".",ЭтотОбъект,,, Отказ);
			КонецЕсли;
			
			// для рынка векселей проверим количество
			Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Векселя И СтрокаЦенныеБумаги.Количество <> 1 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Количество векселей в строке № " + (НомСтр + 1) + " отлично от 1. Обратитесь к разработчикам.",ЭтотОбъект,,, Отказ);
			КонецЕсли;
							
		КонецЦикла;
		
		Если ЭтотОбъект.Взаимозачет И НЕ (ЗначениеЗаполнено(ЭтотОбъект.Основание) 
			И ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.СделкаРЕПО")
			И ЭтотОбъект.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка) Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Взаимозачет доступен только по сделкам РЕПО на покупку ценных бумаг", ЭтотОбъект, "Взаимозачет",, Отказ);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры // ПриЗаписи

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти

Функция ПолучитьДолюЗакрытияПоПродаже() 
	//закрываем доходы/расходы по текущему документу в зависимости от закрытия по ДС
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоЦеннымБумагамОбороты.Основание КАК Основание,
		|	СУММА(ЗадолженностиПоЦеннымБумагамОбороты.СуммаРасход + ЗадолженностиПоЦеннымБумагамОбороты.СуммаКупонаРасход) КАК СуммаПоставки
		|ПОМЕСТИТЬ ПоставкиПоСделкам
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Обороты(
		|			,
		|			&ДоДокумента,
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидЗадолженности = &ВидЗадолженности
		|				И ВЫРАЗИТЬ(Основание КАК Документ.Сделка) =&Сделка) КАК ЗадолженностиПоЦеннымБумагамОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗадолженностиПоЦеннымБумагамОбороты.Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОбороты.Основание, ПоставкиПоСделкам.Основание) КАК Основание,
		|	ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОбороты.СуммаРасход,0) + ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОбороты.СуммаКупонаРасход,0) - ЕСТЬNULL(ПоставкиПоСделкам.СуммаПоставки,0) КАК СуммаАвансаДС
		|ПОМЕСТИТЬ АвансПоДС
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|			,
		|			&ДоДокумента,
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидЗадолженности = &ВидЗадолженности
		|				И ВЫРАЗИТЬ(Основание КАК Документ.Сделка) =&Сделка) КАК ЗадолженностиПоДенежнымСредствамОбороты
		|		ПОЛНОЕ СОЕДИНЕНИЕ ПоставкиПоСделкам КАК ПоставкиПоСделкам
		|		ПО ЗадолженностиПоДенежнымСредствамОбороты.Основание = ПоставкиПоСделкам.Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоЦеннымБумагам.Основание КАК Основание,
		|	СУММА(ЗадолженностиПоЦеннымБумагам.Сумма + ЗадолженностиПоЦеннымБумагам.СуммаКупона) КАК СуммаПоставкиТекущая
		|ПОМЕСТИТЬ ПоставкаТекущая
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам КАК ЗадолженностиПоЦеннымБумагам
		|ГДЕ
		|	ЗадолженностиПоЦеннымБумагам.Регистратор = &Регистратор
		|	И ЗадолженностиПоЦеннымБумагам.ВидДвижения = &ВидДвижения
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗадолженностиПоЦеннымБумагам.Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АвансПоДС.Основание КАК Основание,
		|	ВЫБОР
		|		КОГДА ПоставкаТекущая.СуммаПоставкиТекущая <= АвансПоДС.СуммаАвансаДС
		|			ТОГДА ПоставкаТекущая.СуммаПоставкиТекущая
		|		ИНАЧЕ АвансПоДС.СуммаАвансаДС
		|	КОНЕЦ КАК СуммаПогашения
		|ПОМЕСТИТЬ СуммыПогашения
		|ИЗ
		|	АвансПоДС КАК АвансПоДС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПоставкаТекущая КАК ПоставкаТекущая
		|		ПО АвансПоДС.Основание = ПоставкаТекущая.Основание
		|ГДЕ
		|	АвансПоДС.СуммаАвансаДС > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СуммыПогашения.Основание КАК Основание,
		|	СуммыПогашения.СуммаПогашения / ПоставкаТекущая.СуммаПоставкиТекущая КАК ДоляЗакрытияПоставки
		|ИЗ
		|	СуммыПогашения КАК СуммыПогашения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПоставкаТекущая КАК ПоставкаТекущая
		|		ПО СуммыПогашения.Основание = ПоставкаТекущая.Основание";
		
		
	Запрос.УстановитьПараметр("ВидЗадолженности", Справочники.ВидыЗадолженности.ПоСделке);
	Запрос.УстановитьПараметр("ВидДвижения", ВидДвиженияНакопления.Расход);
	Запрос.УстановитьПараметр("ДоДокумента", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Сделка", ЭтотОбъект.Основание);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		//в поставке ЦБ одна сделка
		Возврат ВыборкаДетальныеЗаписи.ДоляЗакрытияПоставки;
		
	КонецЦикла;
	
	Возврат 0;
	
	
КонецФункции