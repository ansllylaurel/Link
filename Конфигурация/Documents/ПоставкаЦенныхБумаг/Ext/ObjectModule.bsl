
Процедура УстановитьБлокировки()
	
	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	// задолженности по ценным бумагам
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ЗадолженностиПоЦеннымБумагам");
	
	ЭлементБлокировкиДанных.УстановитьЗначение("Основание", 		ЭтотОбъект.Основание);
	ЭлементБлокировкиДанных.УстановитьЗначение("ВидЗадолженности", 	ЭтотОбъект.ВидЗадолженности);
	ЭлементБлокировкиДанных.УстановитьЗначение("ТипЗадолженности", 	РаботаСЗадолженностямиКлиентСерверПовтИсп.ПолучитьТипЗадолженностиПоВидуДвижения(ЭтотОбъект.ВидДвижения));
	
	// остатки ценных бумаг
	Если ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Расход
		И НЕ ЭтотОбъект.Взаимозачет Тогда
		
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиЦенныхБумаг");
		
		ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
		ЭлементБлокировкиДанных.УстановитьЗначение("Рынок",                        ЭтотОбъект.Рынок);
		ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		
		ЭлементБлокировкиДанных.ИсточникДанных = ЭтотОбъект.ЦенныеБумаги;
		ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных("ДепозитарныйСчет", "ДепозитарныйСчет");
		ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных("ЦеннаяБумага",     "ЦеннаяБумага");
	КонецЕсли;
	
	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры // УстановитьБлокировки

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.ОстаткиЦенныхБумаг.Записывать           = Истина;
	Движения.ЗадолженностиПоЦеннымБумагам.Записывать = Истина;
	Движения.ОперацииСЦеннымиБумагами.Записывать     = Истина;
	Движения.УсловияСделок.Записывать				 = Истина;
	
	ВОснованииСделкиПоПриобретениюПаевНеУказаноКоличество = ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.Сделка") 
															И ЭтотОбъект.Основание.ПриобретениеПаев 
															И ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Приход
															И ЭтотОбъект.Основание.ЦенныеБумаги.Количество() > 0
															И ЭтотОбъект.Основание.ЦенныеБумаги[0].Количество = 0;
	
	Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
		// остатки ц/б
		Если НЕ ЭтотОбъект.Взаимозачет Тогда
			Движение = Движения.ОстаткиЦенныхБумаг.Добавить();
			Движение.ВидДвижения                  = ?(ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Приход, ВидДвиженияНакопления.Приход, ВидДвиженияНакопления.Расход);
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.ДепозитарныйСчет             = СтрокаЦенныеБумаги.ДепозитарныйСчет;
			Движение.Рынок                        = ЭтотОбъект.Рынок;
			Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
			Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
		КонецЕсли;
		
		// задолженность
		Движение = Движения.ЗадолженностиПоЦеннымБумагам.ДобавитьРасход();
		Движение.Период                       = ЭтотОбъект.Дата;
		Движение.Основание                    = ЭтотОбъект.Основание;
		Движение.ТипЗадолженности             = РаботаСЗадолженностямиКлиентСерверПовтИсп.ПолучитьТипЗадолженностиПоВидуДвижения(ЭтотОбъект.ВидДвижения);
		Движение.ВидЗадолженности             = ЭтотОбъект.ВидЗадолженности;
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Рынок                        = ЭтотОбъект.Рынок;
		Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
		Движение.Валюта                       = ЭтотОбъект.ВалютаСделки;
		Движение.Количество                   = ?(ВОснованииСделкиПоПриобретениюПаевНеУказаноКоличество, 0 ,СтрокаЦенныеБумаги.Количество);
		Движение.Сумма                        = СтрокаЦенныеБумаги.Сумма;
		Движение.СуммаКупона                  = СтрокаЦенныеБумаги.СуммаКупона;
		
		// операции с ц/б
		Движение = Движения.ОперацииСЦеннымиБумагами.Добавить();
				
		Если      ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО Тогда
			Движение.ЧастьСделкиРЕПО = 1;
		ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО Тогда
			Движение.ЧастьСделкиРЕПО = 2;
		КонецЕсли;
		
		Движение.Операция                     = ЭтотОбъект.Ссылка;
		Движение.ВидДвижения                  = ЭтотОбъект.ВидДвижения;
		Движение.Основание                    = ЭтотОбъект.Основание;
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Рынок                        = ЭтотОбъект.Рынок;
		Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
		Движение.ДатаПоставки                 = ЭтотОбъект.Дата;
		Движение.ДатаОперации                 = ЭтотОбъект.Дата;
		Движение.Валюта						  = ЭтотОбъект.ВалютаСделки;	
		Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
		Движение.Сумма                        = СтрокаЦенныеБумаги.Сумма;
		Движение.СуммаКупона                  = СтрокаЦенныеБумаги.СуммаКупона;
		Движение.ДатаПокупки                  = ЭтотОбъект.Дата;
	КонецЦикла;
	
	ПроведениеПоРегиструУсловияСделок();
	
	Движения.Записать();
	
	// проверим отрицательные остатки
	Если ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Расход и НЕ ЭтотОбъект.Взаимозачет Тогда
		РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЦенныхБумаг(ЭтотОбъект, Отказ);
	КонецЕсли;
	
	РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЗадолженностиПоЦеннымБумагам(ЭтотОбъект, Отказ);
	
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура ПроведениеПоРегиструУсловияСделок()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПоставкаЦенныхБумагЦенныеБумаги.Ссылка.Организация КАК Организация,
		|	ПоставкаЦенныхБумагЦенныеБумаги.Ссылка.Основание КАК Сделка,
		|	ПоставкаЦенныхБумагЦенныеБумаги.Ссылка.Рынок КАК Рынок,
		|	ПоставкаЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ПоставкаЦенныхБумагЦенныеБумаги.Ссылка КАК Ссылка,
		|	ПоставкаЦенныхБумагЦенныеБумаги.Ссылка.Дата КАК Дата,
		|	ПоставкаЦенныхБумагЦенныеБумаги.Количество КАК Количество,
		|	ПоставкаЦенныхБумагЦенныеБумаги.Сумма КАК Сумма,
		|	ПоставкаЦенныхБумагЦенныеБумаги.Цена КАК Цена
		|ПОМЕСТИТЬ _ПоставкаЦенныхБумаг
		|ИЗ
		|	Документ.ПоставкаЦенныхБумаг.ЦенныеБумаги КАК ПоставкаЦенныхБумагЦенныеБумаги
		|ГДЕ
		|	ПоставкаЦенныхБумагЦенныеБумаги.Ссылка = &Ссылка
		|	И ПоставкаЦенныхБумагЦенныеБумаги.Ссылка.Основание.ПриобретениеПаев
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПоставкаЦенныхБумаг.Дата КАК Период,
		|	УсловияСделокСрезПоследних.Организация КАК Организация,
		|	УсловияСделокСрезПоследних.Сделка КАК Сделка,
		|	УсловияСделокСрезПоследних.Рынок КАК Рынок,
		|	УсловияСделокСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	УсловияСделокСрезПоследних.Отменено КАК Отменено,
		|	УсловияСделокСрезПоследних.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|	ВЫБОР
		|		КОГДА УсловияСделокСрезПоследних.Сделка.РаздельноеИсполнение
		|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		|		ИНАЧЕ _ПоставкаЦенныхБумаг.Дата
		|	КОНЕЦ КАК ДатаИсполнения,
		|	УсловияСделокСрезПоследних.ДатаОплаты КАК ДатаОплаты,
		|	_ПоставкаЦенныхБумаг.Дата КАК ДатаПоставки,
		|	УсловияСделокСрезПоследних.ВалютаОплаты КАК ВалютаОплаты,
		|	УсловияСделокСрезПоследних.СобственныйКурсОплаты КАК СобственныйКурсОплаты,
		|	УсловияСделокСрезПоследних.КурсОплаты КАК КурсОплаты,
		|	_ПоставкаЦенныхБумаг.Количество КАК Количество,
		|	_ПоставкаЦенныхБумаг.Цена КАК Цена,
		|	УсловияСделокСрезПоследних.ЦенаПроцент КАК ЦенаПроцент,
		|	УсловияСделокСрезПоследних.ЦенаКупона КАК ЦенаКупона,
		|	_ПоставкаЦенныхБумаг.Сумма КАК Сумма,
		|	УсловияСделокСрезПоследних.СуммаКупона КАК СуммаКупона,
		|	УсловияСделокСрезПоследних.ОтложенноеИсполнение КАК ОтложенноеИсполнение,
		|	УсловияСделокСрезПоследних.РаздельноеИсполнение КАК РаздельноеИсполнение,
		|	УсловияСделокСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	УсловияСделокСрезПоследних.ПлатежноеУсловиеСделки КАК ПлатежноеУсловиеСделки
		|ИЗ
		|	_ПоставкаЦенныхБумаг КАК _ПоставкаЦенныхБумаг
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделок.СрезПоследних(
		|				&Граница,
		|				(Организация, Сделка, Рынок, ЦеннаяБумага) В
		|					(ВЫБРАТЬ
		|						_ПоставкаЦенныхБумаг.Организация КАК Организация,
		|						_ПоставкаЦенныхБумаг.Сделка КАК Сделка,
		|						_ПоставкаЦенныхБумаг.Рынок КАК Рынок,
		|						_ПоставкаЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага
		|					ИЗ
		|						_ПоставкаЦенныхБумаг КАК _ПоставкаЦенныхБумаг)) КАК УсловияСделокСрезПоследних
		|		ПО _ПоставкаЦенныхБумаг.Организация = УсловияСделокСрезПоследних.Организация
		|			И _ПоставкаЦенныхБумаг.Сделка = УсловияСделокСрезПоследних.Сделка
		|			И _ПоставкаЦенныхБумаг.Рынок = УсловияСделокСрезПоследних.Рынок
		|			И _ПоставкаЦенныхБумаг.ЦеннаяБумага = УсловияСделокСрезПоследних.ЦеннаяБумага
		|ГДЕ
		|	(ВЫБОР
		|				КОГДА УсловияСделокСрезПоследних.Сделка.РаздельноеИсполнение
		|					ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		|				ИНАЧЕ НАЧАЛОПЕРИОДА(_ПоставкаЦенныхБумаг.Дата, ДЕНЬ)
		|			КОНЕЦ <> УсловияСделокСрезПоследних.ДатаИсполнения
		|			ИЛИ НАЧАЛОПЕРИОДА(_ПоставкаЦенныхБумаг.Дата, ДЕНЬ) <> УсловияСделокСрезПоследних.ДатаПоставки
		|			ИЛИ _ПоставкаЦенныхБумаг.Количество <> УсловияСделокСрезПоследних.Количество
		|			ИЛИ _ПоставкаЦенныхБумаг.Цена <> УсловияСделокСрезПоследних.Цена
		|			ИЛИ _ПоставкаЦенныхБумаг.Сумма <> УсловияСделокСрезПоследних.Сумма)";
	
	Запрос.УстановитьПараметр("Граница"	, Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Ссылка"	, ЭтотОбъект.Ссылка);
	
	Движения.УсловияСделок.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт

	Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Векселя Тогда
		Возврат;
	КонецЕсли;
	
	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	БухгалтерскийУчетЕПС.СформироватьПроводкиПокупкиПродажиЦеннойБумаги(ЭтотОбъект, Основание, УчетныйРегистр, Отказ);
	
КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерииПрямоеРЕПО(УчетныйРегистр, Отказ)

	ВидСубконтоУчетаЦеннойБумаги = БухгалтерскийУчет.ОпределитьВидСубконтоУчетаЦеннойБумаги(ЭтотОбъект.Рынок);	
	
	Если ЭтотОбъект.Основание.ЧастьСделкиРЕПО = 1 Тогда
		СделкаРЕПО = ЭтотОбъект.Основание;
	Иначе
		СделкаРЕПО = ЭтотОбъект.Основание.ПерваяЧастьРЕПО;
	КонецЕсли;
	
	// ЦЕННЫЕ БУМАГИ
	СведенияОбОбращенииЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(ЭтотОбъект.Дата, ЭтотОбъект.Ссылка, УчетныйРегистр);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.ВидДвижения КАК ВидДвижения,
		|	СУММА(БухПартииЦенныхБумаг.Количество) КАК Количество,
		|	СУММА(БухПартииЦенныхБумаг.Стоимость) КАК Стоимость,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупона) КАК СтоимостьКупона,
		|	СУММА(БухПартииЦенныхБумаг.Переоценка) КАК Переоценка,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупона) КАК ПереоценкаКупона,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета) КАК ПереоценкаКупонаВВалютеУчета,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.Количество = 0
		|				И БухПартииЦенныхБумаг.Стоимость = 0
		|				И БухПартииЦенныхБумаг.СтоимостьКупона = 0
		|				И БухПартииЦенныхБумаг.Переоценка = 0
		|				И БухПартииЦенныхБумаг.ПереоценкаКупона = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Перекурсовка,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.Количество = 0
		|				И (БухПартииЦенныхБумаг.Переоценка <> 0
		|					ИЛИ БухПартииЦенныхБумаг.ПереоценкаКупона <> 0
		|					ИЛИ БухПартииЦенныхБумаг.Стоимость <> 0
		|					ИЛИ БухПартииЦенныхБумаг.СтоимостьКупона <> 0)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Дооценка,
		|	ИСТИНА КАК ЭтоБухПартии,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.ЦеннаяБумага,
