		|	БухПартииЦенныхБумаг.ЦеннаяБумага.ВалютаНоминала,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.Количество = 0
		|				И БухПартииЦенныхБумаг.Стоимость = 0
		|				И БухПартииЦенныхБумаг.СтоимостьКупона = 0
		|				И БухПартииЦенныхБумаг.Переоценка = 0
		|				И БухПартииЦенныхБумаг.ПереоценкаКупона = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.Количество = 0
		|				И (БухПартииЦенныхБумаг.Переоценка <> 0
		|					ИЛИ БухПартииЦенныхБумаг.ПереоценкаКупона <> 0
		|					ИЛИ БухПартииЦенныхБумаг.Стоимость <> 0
		|					ИЛИ БухПартииЦенныхБумаг.СтоимостьКупона <> 0)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	БухПартииЦенныхБумагПроданныеВРепо.ЦеннаяБумага,
		|	БухПартииЦенныхБумагПроданныеВРепо.ВидДвижения,
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.Количество),
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.Стоимость),
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.СтоимостьКупона),
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.Переоценка),
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.ПереоценкаКупона),
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.СтоимостьВВалютеУчета),
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.СтоимостьКупонаВВалютеУчета),
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.ПереоценкаВВалютеУчета),
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.ПереоценкаКупонаВВалютеУчета),
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагПроданныеВРепо.Количество = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.Стоимость = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.СтоимостьКупона = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.Переоценка = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.ПереоценкаКупона = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	БухПартииЦенныхБумагПроданныеВРепо.ЦеннаяБумага.ВалютаНоминала
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумагПроданныеВРепо КАК БухПартииЦенныхБумагПроданныеВРепо
		|ГДЕ
		|	БухПартииЦенныхБумагПроданныеВРепо.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумагПроданныеВРепо.ВидУчета = &ВидУчета
		|	И ВЫБОР
		|			КОГДА БухПартииЦенныхБумагПроданныеВРепо.Количество = 0
		|					И БухПартииЦенныхБумагПроданныеВРепо.Стоимость = 0
		|					И БухПартииЦенныхБумагПроданныеВРепо.СтоимостьКупона = 0
		|					И БухПартииЦенныхБумагПроданныеВРепо.Переоценка = 0
		|					И БухПартииЦенныхБумагПроданныеВРепо.ПереоценкаКупона = 0
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумагПроданныеВРепо.ЦеннаяБумага,
		|	БухПартииЦенныхБумагПроданныеВРепо.ВидДвижения,
		|	БухПартииЦенныхБумагПроданныеВРепо.ЦеннаяБумага.ВалютаНоминала,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагПроданныеВРепо.Количество = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.Стоимость = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.СтоимостьКупона = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.Переоценка = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.ПереоценкаКупона = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ";

	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ПериодУсловияСделок", КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("СделкаРЕПО", СделкаРЕПО);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", УчетныйРегистр);
	
	Результат = Запрос.Выполнить();
	
	// цб
	ВыборкаДвиженияПартий = Результат.Выбрать();
	Пока ВыборкаДвиженияПартий.Следующий() Цикл
		
		ЦеннаяБумага = ВыборкаДвиженияПартий.ЦеннаяБумага;
		ВалютаНоминала = ЦеннаяБумага.ВалютаНоминала;
		
		УчетныйАктив       = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, ЭтотОбъект.Рынок, ЦеннаяБумага);
		УчетныйАктивКупона = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, ЭтотОбъект.Рынок, ЦеннаяБумага, Истина);
		
		НастройкиУчетаАктива = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктив,
			УчетныйРегистр);		
			
		НастройкиУчетаКупона = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктивКупона,
			УчетныйРегистр);		
			
		ВалютныйУчет = НастройкиУчетаАктива.СчетУчета.Валютный;
		
		ОбращаетсяНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
		
		// Стоимость
		Если ВыборкаДвиженияПартий.ВидДвижения = ВидДвиженияНакопления.Приход И ВыборкаДвиженияПартий.Количество = 0 И ВыборкаДвиженияПартий.Перекурсовка Тогда 
			
			ПараметрыПерекурсовки = Новый Структура("ЦеннаяБумага, Рынок,"
				+ "СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета",
				ЦеннаяБумага, Рынок,
				ВыборкаДвиженияПартий.СтоимостьВВалютеУчета, ВыборкаДвиженияПартий.СтоимостьКупонаВВалютеУчета, ВыборкаДвиженияПартий.ПереоценкаВВалютеУчета, ВыборкаДвиженияПартий.ПереоценкаКупонаВВалютеУчета);
				
			СчетаУчета = Новый Структура;
			СчетаУчета.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, ?(ВыборкаДвиженияПартий.ЭтоБухПартии, НастройкиУчетаАктива.СчетУчета, НастройкиУчетаАктива.СчетУчетаВЗалоге));
			СчетаУчета.Вставить(УчетныйАктивКупона.ИмяПредопределенныхДанных, ?(ВыборкаДвиженияПартий.ЭтоБухПартии, НастройкиУчетаКупона.СчетУчета, НастройкиУчетаКупона.СчетУчетаВЗалоге));
			
			СчетаУчетаПереоценки = Новый Структура;
			СчетаУчетаПереоценки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, ?(ВыборкаДвиженияПартий.ЭтоБухПартии, НастройкиУчетаАктива.СчетУчетаПереоценки, НастройкиУчетаАктива.СчетУчетаПереоценкиВЗалоге));
			СчетаУчетаПереоценки.Вставить(УчетныйАктивКупона.ИмяПредопределенныхДанных, ?(ВыборкаДвиженияПартий.ЭтоБухПартии, НастройкиУчетаКупона.СчетУчетаПереоценки, НастройкиУчетаКупона.СчетУчетаПереоценкиВЗалоге));
			
			АналитикаПерекурсовки = Новый Структура;
			АналитикаПерекурсовки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.АналитикаПерекурсовки);
			АналитикаПерекурсовки.Вставить(УчетныйАктивКупона.ИмяПредопределенныхДанных, НастройкиУчетаКупона.АналитикаПерекурсовки);
						
			БухгалтерскийУчет.ДвижениеПерекурсовки(ЭтотОбъект, УчетныйРегистр, ПараметрыПерекурсовки, АналитикаПерекурсовки,  СчетаУчета, СчетаУчетаПереоценки, ОбращаетсяНаОРЦБ, Отказ);		
		ИначеЕсли ВыборкаДвиженияПартий.Дооценка Тогда
			
			ПараметрыПереоценки = Новый Структура("УчетныйРегистр,ВалютныйУчет,ВидСубконтоУчетаЦеннойБумаги,ЦеннаяБумага,ВалютаНоминала,ОбращаетсяНаОРЦБ",
													УчетныйРегистр,ВалютныйУчет,ВидСубконтоУчетаЦеннойБумаги,ЦеннаяБумага,ВалютаНоминала,ОбращаетсяНаОРЦБ);
													
			СуммыПереоценки = Новый Структура("СтоимостьДоначислено,СтоимостьВВалютеУчетаДоначислено,
											|	ПереоценкаДоначислено,ПереоценкаВВалютеУчетаДоначислено,
											|	СтоимостьКупонаДоначислено,СтоимостьКупонаВВалютеУчетаДоначислено,
											|	ПереоценкаКупонаДоначислено,ПереоценкаКупонаВВалютеУчетаДоначислено",
											ВыборкаДвиженияПартий.Стоимость, ВыборкаДвиженияПартий.СтоимостьВВалютеУчета,
											ВыборкаДвиженияПартий.Переоценка, ВыборкаДвиженияПартий.ПереоценкаВВалютеУчета,
											ВыборкаДвиженияПартий.СтоимостьКупона, ВыборкаДвиженияПартий.СтоимостьКупонаВВалютеУчета,
											ВыборкаДвиженияПартий.ПереоценкаКупона, ВыборкаДвиженияПартий.ПереоценкаКупонаВВалютеУчета);
											
			БухгалтерскийУчет.ПроизвестиПереоценкуБумагиИКупонаБУНУ(ЭтотОбъект, ПараметрыПереоценки, СуммыПереоценки, НастройкиУчетаАктива, НастройкиУчетаКупона);
			
		Иначе
			Если ВыборкаДвиженияПартий.Стоимость <> 0 Тогда
			
				Если ВыборкаДвиженияПартий.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ВыборкаДвиженияПартий.СтоимостьВВалютеУчета, "Закрытие РЕПО");
					Проводка.СчетДт = НастройкиУчетаАктива.СчетУчета;
					Проводка.СчетКт = НастройкиУчетаАктива.СчетУчетаВЗалоге;
				Иначе
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ВыборкаДвиженияПартий.СтоимостьВВалютеУчета, "Продажа в РЕПО");
					Проводка.СчетДт = НастройкиУчетаАктива.СчетУчетаВЗалоге;
					Проводка.СчетКт = НастройкиУчетаАктива.СчетУчета;
				КонецЕсли;
				
				Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
				Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
				
				Проводка.КоличествоДт = ВыборкаДвиженияПартий.Количество;
				Проводка.КоличествоКт = ВыборкаДвиженияПартий.Количество;
				
				Если Проводка.СчетДт.Валютный Тогда
					Проводка.ВалютаДт = ВыборкаДвиженияПартий.ВалютаНоминала;
					Проводка.ВалютаКт = ВыборкаДвиженияПартий.ВалютаНоминала;
					
					Проводка.ВалютнаяСуммаКт = ВыборкаДвиженияПартий.Стоимость;
					Проводка.ВалютнаяСуммаДт = ВыборкаДвиженияПартий.Стоимость;
				КонецЕсли;
				
			КонецЕсли;
			
			// Переоценка
			Если ВыборкаДвиженияПартий.Переоценка <> 0 Тогда
				
				Если ВыборкаДвиженияПартий.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ВыборкаДвиженияПартий.ПереоценкаВВалютеУчета, "Закрытие РЕПО");
					Проводка.СчетДт = НастройкиУчетаАктива.СчетУчетаПереоценки;
					Проводка.СчетКт = НастройкиУчетаАктива.СчетУчетаПереоценкиВЗалоге;
				Иначе
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ВыборкаДвиженияПартий.ПереоценкаВВалютеУчета, "Продажа в РЕПО");
					Проводка.СчетДт = НастройкиУчетаАктива.СчетУчетаПереоценкиВЗалоге;
					Проводка.СчетКт = НастройкиУчетаАктива.СчетУчетаПереоценки;
				КонецЕсли;
				
				Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
				Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
				
				Если Проводка.СчетДт.Валютный Тогда
					Проводка.ВалютаДт = ВыборкаДвиженияПартий.ВалютаНоминала;
					Проводка.ВалютаКт = ВыборкаДвиженияПартий.ВалютаНоминала;
					
					Проводка.ВалютнаяСуммаДт = ВыборкаДвиженияПартий.Переоценка;
					Проводка.ВалютнаяСуммаКт = ВыборкаДвиженияПартий.Переоценка;
				КонецЕсли;
			КонецЕсли;
			
			// Купон
			Если ВыборкаДвиженияПартий.СтоимостьКупона <> 0 Тогда
				
				Если ВыборкаДвиженияПартий.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ВыборкаДвиженияПартий.СтоимостьКупонаВВалютеУчета, "Закрытие РЕПО");
					Проводка.СчетДт = НастройкиУчетаКупона.СчетУчета;
					Проводка.СчетКт = НастройкиУчетаКупона.СчетУчетаВЗалоге;
				Иначе
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ВыборкаДвиженияПартий.СтоимостьКупонаВВалютеУчета, "Продажа в РЕПО");
					Проводка.СчетДт = НастройкиУчетаКупона.СчетУчетаВЗалоге;
					Проводка.СчетКт = НастройкиУчетаКупона.СчетУчета;
				КонецЕсли;
				
				Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
				Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
				
				Если Проводка.СчетДт.Валютный Тогда
					Проводка.ВалютаДт = ВыборкаДвиженияПартий.ВалютаНоминала;
					Проводка.ВалютаКт = ВыборкаДвиженияПартий.ВалютаНоминала;
					
					Проводка.ВалютнаяСуммаДт = ВыборкаДвиженияПартий.СтоимостьКупона;
					Проводка.ВалютнаяСуммаКт = ВыборкаДвиженияПартий.СтоимостьКупона;
				КонецЕсли;
			КонецЕсли;
			
			// Купон переоценка
			Если ВыборкаДвиженияПартий.ПереоценкаКупона <> 0 Тогда
				
				Если ВыборкаДвиженияПартий.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ВыборкаДвиженияПартий.ПереоценкаКупонаВВалютеУчета, "Закрытие РЕПО");
					Проводка.СчетДт = НастройкиУчетаКупона.СчетУчетаПереоценки;
					Проводка.СчетКт = НастройкиУчетаКупона.СчетУчетаПереоценкиВЗалоге;
				Иначе
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ВыборкаДвиженияПартий.ПереоценкаКупонаВВалютеУчета, "Продажа в РЕПО");
					Проводка.СчетДт = НастройкиУчетаКупона.СчетУчетаПереоценкиВЗалоге;
					Проводка.СчетКт = НастройкиУчетаКупона.СчетУчетаПереоценки;
				КонецЕсли;
				
				Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
				Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
				
				Если Проводка.СчетДт.Валютный Тогда
					Проводка.ВалютаДт = ВыборкаДвиженияПартий.ВалютаНоминала;
					Проводка.ВалютаКт = ВыборкаДвиженияПартий.ВалютаНоминала;
					
					Проводка.ВалютнаяСуммаДт = ВыборкаДвиженияПартий.ПереоценкаКупона;
					Проводка.ВалютнаяСуммаКт = ВыборкаДвиженияПартий.ПереоценкаКупона;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерииОбратноеРЕПО(УчетныйРегистр, МетодПризнанияРасходовПоСделкамРЕПО, Отказ)

	ЧастьСделкиРЕПО = Основание.ЧастьСделкиРЕПО;
	Если Основание.ЧастьСделкиРЕПО = 0 Тогда
		СделкаРЕПО = Основание;
		Если Основание.ВидСделки = Перечисления.ВидыСделок.Покупка И ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Приход Тогда
			ЧастьСделкиРЕПО = 1;
		ИначеЕсли Основание.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Это прямое РЕПО, движения по обратному РЕПО сформированы не будут", ЭтотОбъект.Ссылка,,,Отказ);
			Возврат;
		Иначе
			ЧастьСделкиРЕПО = 2;
		КонецЕсли;
	ИначеЕсли Основание.ЧастьСделкиРЕПО = 1 Тогда
		СделкаРЕПО = Основание;
	Иначе
		СделкаРЕПО = Основание.ПерваяЧастьРЕПО;
	КонецЕсли;
	
	// ЦЕННЫЕ БУМАГИ
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.Количество КАК Количество,
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.Стоимость + БухПартииЦенныхБумагКупленныеПоРЕПО.Переоценка КАК Стоимость,
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьВВалютеУчета + БухПартииЦенныхБумагКупленныеПоРЕПО.ПереоценкаВВалютеУчета КАК СтоимостьВВалютеУчета,
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьКупона + БухПартииЦенныхБумагКупленныеПоРЕПО.ПереоценкаКупона КАК СтоимостьКупона,
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьКупонаВВалютеУчета + БухПартииЦенныхБумагКупленныеПоРЕПО.ПереоценкаКупонаВВалютеУчета КАК СтоимостьКупонаВВалютеУчета
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО КАК БухПартииЦенныхБумагКупленныеПоРЕПО
		|ГДЕ
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумагКупленныеПоРЕПО.ВидУчета = &ВидУчета";

	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", УчетныйРегистр);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	//забаланс
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ЧастьСделкиРЕПО = 1 Тогда // ОТКРЫТИЕ ПОКУПКИ РЕПО
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СтоимостьВВалютеУчета, "Бумаги купленные по РЕПО");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Основной.ПартииРЕПОПокупкаТело;
