#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПараметрыФормы = ЭтаФорма.Параметры; 
	ВидЮрФизЛица = ПараметрыФормы.ВидЮрФизЛица;
	СтруктураРезультата = ПараметрыФормы.СтруктураПодтверждающихДокументов;
	
	Макет = ПолучитьМакетПоДате(ПараметрыФормы.Дата);
	
	ОбластьМакета = Макет.ПолучитьОбласть(?(ВидЮрФизЛица = ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо"), "ФизическоеЛицо", "ЮридическоеЛицо"));
	
	Если ТипЗнч(СтруктураРезультата) = Тип("Структура") Тогда
		ОбластьМакета.Параметры.Заполнить(СтруктураРезультата);
	КонецЕсли;
	
	Требования.Вывести(ОбластьМакета);
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаСохранить(Команда)
	
	ПрочитатьТребованияИзТабличногоДокументаНаСервере();	
	ЭтаФорма.Закрыть(СтруктураРезультата);
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаСервереБезКонтекста
Функция ПолучитьМакетПоДате(Дата)
		
	МакетыДокумента = Метаданные.Документы.ВнесениеИзмененийВоВнутреннийПеречень.Макеты;
	
	ИскомаяДатаМакета = '19800101';
	Для Каждого Макет Из МакетыДокумента Цикл
		ИмяМакета = Макет.ПолноеИмя();
		Если СтрНачинаетсяС(ИмяМакета, "ТребованияККвалифицированнымИнвесторам") Тогда
			ДатаМакета = Дата(Прав(ИмяМакета, 8));                                             			
			ИскомаяДатаМакета = ?(Дата >= ИскомаяДатаМакета, ДатаМакета, ИскомаяДатаМакета);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Документы.ВнесениеИзмененийВоВнутреннийПеречень.ПолучитьМакет("ТребованияККвалифицированнымИнвесторам_" + Формат(ИскомаяДатаМакета, "ДФ=yyyyMMdd"));
	
КонецФункции

&НаСервере
Процедура ПрочитатьТребованияИзТабличногоДокументаНаСервере()
		
	СтруктураРезультата = Новый Структура;
		
	// Читаем текст именованных областей и записываем в структуру
	Для Каждого ТекущаяОбласть Из Требования.Области Цикл
				
		Если ПустаяСтрока(ТекущаяОбласть.Текст)
			Или Не СтрНачинаетсяС(ТекущаяОбласть.Имя, "Строка") Тогда
			Продолжить;
		КонецЕсли;
		
		Ключ = СтрЗаменить(ТекущаяОбласть.Имя, 	"ФЛ", "");
		Ключ = СтрЗаменить(Ключ, 				"ЮЛ", "");
		
		СтруктураРезультата.Вставить(Ключ, ТекущаяОбласть.Текст);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти