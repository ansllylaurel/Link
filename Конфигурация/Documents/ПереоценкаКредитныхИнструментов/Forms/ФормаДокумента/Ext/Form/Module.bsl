
&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
			
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
КонецПроцедуры // ПриЧтенииСозданииНаСервере

&НаСервере
Процедура ЗаполнитьНаСервере()

	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	
	Отказ = Ложь;
	ТекущийОбъект.ЗаполнитьКредитныеИнструменты(Отказ);
	
	Если Объект.ПереоцениватьНаОснованииНастроекУчета Тогда
		ТекущийОбъект.ПрименитьПолитикуУчета();
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ТекущийОбъект, "Объект");

КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаЛинейнойСтоимости(Команда)
	
	ТекущиеДанные = Элементы.ЦенныеБумаги.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		ОткрытьФорму("Справочник.ДепозитныеВклады.Форма.РасшифровкаСтоимостиДепозита", Новый Структура("СчетДоверительногоУправления,КредитныйИнструмент,Период", Объект.СчетДоверительногоУправления, ТекущиеДанные.КредитныйИнструмент, КонецДня(Объект.Дата)));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаСтоимостиАктиваПоРыночнойСтавке(Команда)
	
	ТекущиеДанные = Элементы.ЦенныеБумаги.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		Отказ = Ложь;
		
		Результат = РасшифровкаСтоимостиАктиваПоРыночнойСтавкеСервер(
						ТекущиеДанные.КредитныйИнструмент, 
						Объект.СчетДоверительногоУправления, 
						КонецДня(Объект.Дата), 
						ПредопределенноеЗначение("Справочник.ЦелиРасчета.ЕдиныйПланСчетов"), 
						Отказ);
		
		Если Отказ Тогда
			Предупреждение("Проверка на рыночность завершилась с ошибками. См. окно сообщений",, "Расшифровка стоимости активов");
		Иначе
			ИмяРасшифровки = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(Строка(ТекущиеДанные.КредитныйИнструмент) + " на " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy"));
			Результат.Показать(ИмяРасшифровки);
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РасшифровкаСтоимостиАктиваПоРыночнойСтавкеСервер(Актив, СчетДоверительногоУправления, Период, ЦельРасчета, Отказ)
	
	Возврат РаботаСоСтоимостьюПоРыночнойСтавке.РасшифровкаСтоимостиАктиваПоРыночнойСтавке(Актив, СчетДоверительногоУправления, Период, ЦельРасчета,, Отказ);
	
КонецФункции

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	РаботаСДокументамиКлиент.СчетДоверительногоУправленияПриИзменении(Объект.СчетДоверительногоУправления, ЭтаФорма);

КонецПроцедуры
