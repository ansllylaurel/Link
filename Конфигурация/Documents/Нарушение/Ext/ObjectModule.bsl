
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения) И ЭтотОбъект.Метаданные().Реквизиты.Основание.Тип.СодержитТип(ТипЗнч(ДанныеЗаполнения)) Тогда // ввод на основании
		
		ЭтотОбъект.Основание  = ДанныеЗаполнения;
		
		Если ДанныеЗаполнения.Метаданные().Реквизиты.Найти("ПоЛицензииУКПИФ") <> Неопределено Тогда
			ЭтотОбъект.ПоЛицензииУКПИФ = ДанныеЗаполнения.ПоЛицензииУКПИФ;
		КонецЕсли;	
		
		Если ДанныеЗаполнения.Метаданные().Реквизиты.Найти("ПоЛицензииДУ") <> Неопределено Тогда
			ЭтотОбъект.ПоЛицензииДУ = ДанныеЗаполнения.ПоЛицензииДУ;
		КонецЕсли;	
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ЭтотОбъект.Основание, "Организация, СчетДоверительногоУправления");
		
	КонецЕсли;
	
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ЭтотОбъект.ПоЛицензииДУ Тогда
		Если ЭтотОбъект.Классификация.Родитель <> Справочники.КлассификаторНарушений.НарушенияПУРЦБ Тогда
		    ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Классификация нарушения по лицензии ДУ должна входить в группу Нарушения ПУРЦБ", ЭтотОбъект.Ссылка,, "Объект.Классификация", Отказ);
		КонецЕсли;
	КонецЕсли;
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда // блокирующие проверки
	КонецЕсли;

КонецПроцедуры
