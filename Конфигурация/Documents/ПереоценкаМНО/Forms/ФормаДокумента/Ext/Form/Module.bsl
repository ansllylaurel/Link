Процедура РасчетСЧА(Команда)
	// Вставить содержимое обработчика.
КонецПроцедуры

&НаКлиенте
Процедура ВидУчетаПриИзменении(Элемент)
	
	Если Объект.ВидУчета = ПредопределенноеЗначение("Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет") Тогда
		ЭтаФорма.Элементы.ЦенныеБумагиСуммаПоЭСП.Видимость = Истина;
	Иначе
		ЭтаФорма.Элементы.ЦенныеБумагиСуммаПоЭСП.Видимость = Ложь;
		Для каждого СтрокаМНО Из Объект.МНО Цикл
			СтрокаМНО.СуммаПоЭСП = 0;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЭтаФорма.Элементы.ЦенныеБумагиСуммаПоЭСП.Видимость = (Объект.ВидУчета = ПредопределенноеЗначение("Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет"));
КонецПроцедуры
