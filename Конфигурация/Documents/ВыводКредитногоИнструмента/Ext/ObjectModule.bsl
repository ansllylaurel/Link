		|				И ЦельРасчета = &ЦельРасчета) КАК РасчетныеПоказателиДепозитногоВкладаСрезПоследних";
	
	Запрос.УстановитьПараметр("ДепозитныйВклад", ЭтотОбъект.КредитныйИнструмент);
	Запрос.УстановитьПараметр("ЦельРасчета", Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Дата);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(РасчетныеДанныеДепозита, ВыборкаДетальныеЗаписи);
	КонецЕсли;

	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		УчетныйАктив,
		УчетныйРегистр);		
	
	Если РасчетныеДанныеДепозита.ИспользоватьЭффективнуюПроцентнуюСтавку Тогда
		
		БухгалтерскийУчетЕПС.ПровестиКорректировкуЭСП(ЭтотОбъект, ЭтотОбъект.КредитныйИнструмент, 0, 0);
	
	КонецЕсли;
	
	БухгалтерскийУчетЕПС.ПереоценитьВалютныеАктивы(ЭтотОбъект, Отказ);
	
	БухгалтерскийУчетЕПС.ЗакрытьКорректировки206(ЭтотОбъект, ЭтотОбъект.КредитныйИнструмент);	
	
	Если РасчетныеДанныеДепозита.ИспользоватьЭффективнуюПроцентнуюСтавку И Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
		БухгалтерскийУчетЕПС.ЗакрытьКорректировки710(ЭтотОбъект, ЭтотОбъект.КредитныйИнструмент);
	КонецЕсли;
	
	Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда // закроем корректировку ПП
		БухгалтерскийУчетЕПС.ЗакрытьКорректировки710(ЭтотОбъект, ЭтотОбъект.КредитныйИнструмент,,,, Ложь);
	КонецЕсли;
	
	БухгалтерскийУчетЕПС.ЗакрытьПарныеСчетаДоходовРасходов(ЭтотОбъект, УчетныйАктив, Ложь, Истина, ЭтотОбъект.КредитныйИнструмент, Отказ);	
	
КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт

	Если ТипЗнч(ЭтотОбъект.КредитныйИнструмент) = Тип("СправочникСсылка.Займы") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не реализовано проведение по бухучету закрытия займа", ЭтотОбъект.Ссылка,,,Отказ);
		Возврат;
	КонецЕсли;
	
	Движения[УчетныйРегистр].Записывать = Истина;
	
	СчетРасчетов = БухгалтерскийУчет.ОпределитьСчетРасчетовПоДоговоруДоверительногоУправления(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		Неопределено);
		
	ЕстьСубконтоКонтрагенты = (СчетРасчетов.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);
	
	Если ЕстьСубконтоКонтрагенты Тогда
		КонтрагентДляПроводок = РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицоСчетаДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата);
	КонецЕсли;
		
	СчетУчетаАктивов = БухгалтерскийУчет.ОпределитьСчетУчетаАктивов(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		Справочники.УчетныеАктивы.ДепозитныеВклады,
		УчетныйРегистр);
		
	СчетУчетаПереоценкиАктивов = БухгалтерскийУчет.ОпределитьСчетУчетаПереоценкиАктивов(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		Справочники.УчетныеАктивы.ДепозитныеВклады,
		УчетныйРегистр);
	
	ДанныеДепозитногоВклада = РаботаСКредитнымиИнструментами.ПолучитьНоминалИДатуПогашенияКредитногоИнструмента(ЭтотОбъект);
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ДанныеДепозитногоВклада.ТекущийНоминал, "Вывод депозитного вклада");
	
	// Дебет
	Проводка.СчетДт = СчетРасчетов;	
	
	Если ЕстьСубконтоКонтрагенты Тогда
		Проводка.СубконтоДт.Контрагенты = КонтрагентДляПроводок;
	КонецЕсли;
	
	// Кредит
	Проводка.СчетКт = СчетУчетаАктивов;
	Проводка.СубконтоКт.ДепозитныеВклады = ЭтотОбъект.КредитныйИнструмент;
																  
	Если ЭтотОбъект.СуммаПроцентов <> 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ЭтотОбъект.СуммаПроцентов, "Вывод процентов по депозитному вкладу");
		
		// Дебет
		Проводка.СчетДт = СчетРасчетов;	
		
		Если ЕстьСубконтоКонтрагенты Тогда
			Проводка.СубконтоДт.Контрагенты = КонтрагентДляПроводок;
		КонецЕсли;
		
		// Кредит
		Проводка.СчетКт = СчетУчетаПереоценкиАктивов;
		Проводка.СубконтоКт.ДепозитныеВклады = ЭтотОбъект.КредитныйИнструмент;
		
	КонецЕсли;
	
КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "КредитныйИнструмент, СуммаПроцентов");
		
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтотОбъект.Дата >= РаботаСДокументами.ДатаНачалаПроверкиЗаполненияКонтрагента() Тогда
		ПроверяемыеРеквизиты.Добавить("Контрагент");
	КонецЕсли;
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
	
		Если Не ЗначениеЗаполнено(ЭтотОбъект.Контрагент) И ЭтотОбъект.Дата >= РаботаСДокументами.ДатаНачалаПроверкиЗаполненияКонтрагента() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено значение реквизиита [Контрагент]!", ЭтотОбъект, "Контрагент",, Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);	
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
    РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти
