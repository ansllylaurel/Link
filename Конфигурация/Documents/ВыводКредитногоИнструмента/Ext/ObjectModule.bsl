
Процедура УстановитьБлокировки()
	
	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах");
	
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("КредитныйИнструмент",          ЭтотОбъект.КредитныйИнструмент);

	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.УсловияКредитныхИнструментов");
	ЭлементБлокировкиДанных.УстановитьЗначение("КредитныйИнструмент",              ЭтотОбъект.КредитныйИнструмент);

	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.РезервыПредстоящихРасходов");
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                 	ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("СубъектАналитики",            	ЭтотОбъект.КредитныйИнструмент);
	
	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры // УстановитьБлокировки

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.ДенежныеСредстваВКредитныхИнструментах.Записывать 	= Истина;
	Движения.ВводыВыводыАктивовВВалютеУчета.Записывать      	= Истина;
	Движения.РезервыПредстоящихРасходов.Записывать				= Истина;

	// получим данные депозита и проверим их корректность
	ДанныеКредитногоИнструмента = РаботаСКредитнымиИнструментами.ПолучитьНоминалИДатуПогашенияКредитногоИнструмента(ЭтотОбъект);
	
	ЭтоДепозитныйВклад = ТипЗнч(ЭтотОбъект.КредитныйИнструмент) = Тип("СправочникСсылка.ДепозитныеВклады");
	
	Если ДанныеКредитногоИнструмента.ТекущийНоминал <= 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Отсутствует текущий номинал "+?(ЭтоДепозитныйВклад, "депозитного вклада", "займа")+" " + ЭтотОбъект.КредитныйИнструмент + "!'"), ЭтотОбъект, "КредитныйИнструмент");
	КонецЕсли;
	
	Если ЭтоДепозитныйВклад И ЭтотОбъект.КредитныйИнструмент.ДоВостребования И НЕ ЗначениеЗаполнено(ДанныеКредитногоИнструмента.ДатаПогашения) Тогда
		//Для депозитов "до востребования" дата погашения не контролируется
	ИначеЕсли ДанныеКредитногоИнструмента.ДатаПогашения = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У "+?(ЭтоДепозитныйВклад, "депозитного вклада", "займа")+" " + ЭтотОбъект.КредитныйИнструмент + " не указана дата погашения ", ЭтотОбъект, "КредитныйИнструмент",, Отказ);
	Иначе
		Если ДанныеКредитногоИнструмента.ДатаПогашения < НачалоДня(ЭтотОбъект.Дата) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата документа " + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy") + " не может быть больше даты погашения " + Формат(ДанныеКредитногоИнструмента.ДатаПогашения, "ДФ=dd.MM.yyyy"), ЭтотОбъект, "Дата",, Отказ);
		КонецЕсли; 
	КонецЕсли;	

	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// денежные средства
	Движение = Движения.ДенежныеСредстваВКредитныхИнструментах.ДобавитьРасход();
	
	Движение.Период 					  = ЭтотОбъект.Дата;
	Движение.Организация 				  = ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
	Движение.КредитныйИнструмент		  = ЭтотОбъект.КредитныйИнструмент;
	Если ЭтоДепозитныйВклад Тогда
		Движение.ВидКредитногоИнструмента	  = Перечисления.ВидыКредитныхИнструментов.Выданный;
		Движение.ТипКредитногоИнструмента	  = Перечисления.ТипыКредитныхИнструментов.ДепозитныйВклад;
	Иначе
		Движение.ТипКредитногоИнструмента	  = Перечисления.ТипыКредитныхИнструментов.Займ;
		Движение.ВидКредитногоИнструмента	  = ЭтотОбъект.КредитныйИнструмент.ВидКредитногоИнструмента;
	КонецЕсли;
	Движение.Сумма                        = ДанныеКредитногоИнструмента.ТекущийНоминал;
	
	// вводы/выводы активов
	БалансоваяСтоимостьВВалютеУчета = РаботаСВалютами.ПолучитьСуммуДокументаВВалютеУчета(
		ДанныеКредитногоИнструмента.ТекущийНоминал + ЭтотОбъект.СуммаПроцентов, ЭтотОбъект.КредитныйИнструмент.БанковскийСчет.Валюта, ЭтотОбъект, Отказ);
	
	Движение = Движения.ВводыВыводыАктивовВВалютеУчета.Добавить();
	
	Движение.НаправлениеДвижения		  = Перечисления.ВидыДвижений.Расход;
	Движение.Период						  = ЭтотОбъект.Дата;
	Движение.Организация				  = ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
	Если ЭтоДепозитныйВклад Тогда
		Движение.ВидАктива					  = Перечисления.ВидыАктивов.ДепозитныеВклады;
	Иначе
		Если ЭтотОбъект.КредитныйИнструмент.ВидКредитногоИнструмента = Перечисления.ВидыКредитныхИнструментов.Выданный Тогда
			Движение.ВидАктива					  = Перечисления.ВидыАктивов.ДебиторскаяЗадолженность;
		Иначе
			Движение.ВидАктива					  = Перечисления.ВидыАктивов.КредиторскаяЗадолженность;
		КонецЕсли;			
	КонецЕсли;
	Движение.РыночнаяСтоимость			  = БалансоваяСтоимостьВВалютеУчета;
	Движение.БалансоваяСтоимость		  = БалансоваяСтоимостьВВалютеУчета;			
	
	// резервы
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
		|	&Дата КАК Период,
		|	РезервыПредстоящихРасходовОстатки.Организация КАК Организация,
		|	РезервыПредстоящихРасходовОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	РезервыПредстоящихРасходовОстатки.Резерв КАК Резерв,
		|	РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК СубъектАналитики,
		|	РезервыПредстоящихРасходовОстатки.СуммаОстаток КАК Сумма,
		|	РезервыПредстоящихРасходовОстатки.Организация.ВалютаУчета КАК Валюта
		|ИЗ
		|	РегистрНакопления.РезервыПредстоящихРасходов.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И СубъектАналитики = &СубъектАналитики) КАК РезервыПредстоящихРасходовОстатки";
		
	Запрос.УстановитьПараметр("Период",							Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СубъектАналитики", 				ЭтотОбъект.КредитныйИнструмент);
	Запрос.УстановитьПараметр("Дата",			 				ЭтотОбъект.Дата);
	
	Движения.РезервыПредстоящихРасходов.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт

	Если ТипЗнч(ЭтотОбъект.КредитныйИнструмент) = Тип("СправочникСсылка.Займы") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не реализовано проведение по ЕПС закрытия займа", ЭтотОбъект.Ссылка,,,Отказ);
		Возврат;
	КонецЕсли;
	
	Закрывать7ойРазделПриПоступленииДенежныхСредств = БухгалтерскийУчет.Закрывать7ойРазделПриПоступленииДенежныхСредств(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	// !!! в коде в вал. сумма заполнялась из реквизита ЭтотОбъект.Сумма, которого в документе нет
	// сейчас обращение к этому полю заменено на 0
	//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Формирование проводок по ЕПС в документе '" + ЭтотОбъект.Метаданные().Представление() + "' не поддерживается", ЭтотОбъект,,, Отказ);
	
	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	УчетныйАктив = Справочники.ДепозитныеВклады.ОпределитьУчетныйАктивДепозита(ЭтотОбъект.КредитныйИнструмент, ЭтотОбъект.Дата);
	
	// *************** ТЕЛО ******************
	ДанныеДепозитногоВклада = РаботаСКредитнымиИнструментами.ПолучитьНоминалИДатуПогашенияКредитногоИнструмента(ЭтотОбъект);
	
	СуммаОперацииТелоДепозита = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ДанныеДепозитногоВклада.ТекущийНоминал, ЭтотОбъект.КредитныйИнструмент.БанковскийСчет.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперацииТелоДепозита, "Вывод депозитного вклада");
	
	Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
	Проводка.СубконтоДт.Договоры = СчетДоверительногоУправления;
	
	Проводка.СчетКт = УчетныйАктив.СчетУчета;
	Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.КредитныйИнструмент.БанковскийСчет;
	Проводка.СубконтоКт.ДепозитныеВклады = ЭтотОбъект.КредитныйИнструмент;
	Проводка.ВалютаКт  = ЭтотОбъект.КредитныйИнструмент.БанковскийСчет.Валюта;
	Проводка.ВалютнаяСуммаКт = ДанныеДепозитногоВклада.ТекущийНоминал;
	
	ОценочнаяСтоимость = РаботаСКредитнымиИнструментами.ПолучитьСтоимостьКредитногоИнструмента(ЭтотОбъект.КредитныйИнструмент, ЭтотОбъект.Дата, ЭтотОбъект.СчетДоверительногоУправления);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстаткиПроцентов.СуммаОстатокДт + ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт - БухгалтерскийУчетДоходыБудущихПериодов.СуммаОстатокКт КАК БалансоваяСуммаВВалютеУчета,
		|	БухгалтерскийУчетОстаткиПроцентов.СуммаОстатокДт КАК СуммаНачисленныхПроцентовВВалютеУчета,
		|	БухгалтерскийУчетОстаткиПроцентов.ВалютнаяСуммаОстатокДт + ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокДт - БухгалтерскийУчетДоходыБудущихПериодов.ВалютнаяСуммаОстатокКт КАК БалансоваяСумма,
		|	БухгалтерскийУчетОстаткиПроцентов.ВалютнаяСуммаОстатокДт КАК СуммаНачисленныхПроцентов,
		|	БухгалтерскийУчетДоходыБудущихПериодов.СуммаОстатокКт КАК СуммаДоходовБудущихПериодовВВалютеУчета,
		|	БухгалтерскийУчетДоходыБудущихПериодов.ВалютнаяСуммаОстатокКт КАК СуммаДоходовБудущихПериодов
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты03),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.УсловияЗаймовКредитовИДепозитов),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|				И Субконто1 = &ДепозитныйВклад) КАК БухгалтерскийУчетОстаткиПроцентов,
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты13),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.УсловияЗаймовКредитовИДепозитов),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|				И Субконто1 = &ДепозитныйВклад) КАК БухгалтерскийУчетДоходыБудущихПериодов,
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = &СчетУчетаДепозитов,
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДепозитныеВклады),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|				И ЛицевойСчет.ДепозитныйВклад = &ДепозитныйВклад) КАК ЕдиныйБухгалтерскийУчетОстатки";

	Запрос.УстановитьПараметр("Организация",                  ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период",                       ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("ДепозитныйВклад",			  ЭтотОбъект.КредитныйИнструмент);
	Запрос.УстановитьПараметр("СчетУчетаДепозитов", 		  УчетныйАктив.СчетУчета);
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	ВалютаДепозитаОтличаетсяОтВалютыУчета = (ЭтотОбъект.КредитныйИнструмент.БанковскийСчет.Валюта <> ЭтотОбъект.Организация.ВалютаУчета);
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		БалансоваяСумма 			= ?(ВалютаДепозитаОтличаетсяОтВалютыУчета, ВыборкаДетальныеЗаписи.БалансоваяСумма, ВыборкаДетальныеЗаписи.БалансоваяСуммаВВалютеУчета);
		СуммаНачисленныхПроцентов 	= ?(ВалютаДепозитаОтличаетсяОтВалютыУчета, ВыборкаДетальныеЗаписи.СуммаНачисленныхПроцентов, ВыборкаДетальныеЗаписи.СуммаНачисленныхПроцентовВВалютеУчета);
		СуммаДоходовБудущихПериодов = ?(ВалютаДепозитаОтличаетсяОтВалютыУчета, ВыборкаДетальныеЗаписи.СуммаДоходовБудущихПериодов, ВыборкаДетальныеЗаписи.СуммаДоходовБудущихПериодовВВалютеУчета);
		БалансоваяСуммаВВалютеУчета	= ВыборкаДетальныеЗаписи.БалансоваяСуммаВВалютеУчета;
		СуммаНачисленныхПроцентовВВалютеУчета = ВыборкаДетальныеЗаписи.СуммаНачисленныхПроцентовВВалютеУчета;	
		СуммаДоходовБудущихПериодовВВалютеУчета = ВыборкаДетальныеЗаписи.СуммаДоходовБудущихПериодовВВалютеУчета;
	Иначе
		БалансоваяСумма 			= 0;
		СуммаНачисленныхПроцентов 	= 0;
		СуммаДоходовБудущихПериодов = 0;
		БалансоваяСуммаВВалютеУчета	= 0;
		СуммаНачисленныхПроцентовВВалютеУчета = 0;
		СуммаДоходовБудущихПериодовВВалютеУчета = 0;
	КонецЕсли;
	
	// ЗЛО!!!
	СтоимостьПоДаннымБанка = ДанныеДепозитногоВклада.ТекущийНоминал + СуммаНачисленныхПроцентов - СуммаДоходовБудущихПериодов;
