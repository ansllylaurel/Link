
&НаСервере
Процедура ЗаполнитьОстаткиЗадолженностиНаСервере(Отказ)

	Если Не ЗначениеЗаполнено(ЭтаФорма.Параметры.СчетДоверительногоУправления) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран счет ДУ",,,,Отказ);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;

	// По умолчанию проверяем текущую дату
	Если ЭтаФорма.Параметры.Период = Неопределено Тогда
	 	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	Иначе
	 	Запрос.УстановитьПараметр("Дата", ЭтаФорма.Параметры.Период);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Параметры.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтаФорма.Параметры.СчетДоверительногоУправления);
	
	Запрос.УстановитьПараметр("ТипДокументаДляПодбора", ЭтаФорма.Параметры.ТипДокументаДляПодбора);
	
	Если ЭтаФорма.Параметры.ТипДокументаДляПодбора = Тип("ДокументСсылка.ВключениеПрочегоИмуществаВСоставПИФ") Тогда
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПрочееИмуществоПереданноеВОплатуПаевОстатки.Основание КАК Основание,
			|	ПрочееИмуществоПереданноеВОплатуПаевОстатки.ВидИмущества КАК ВидИмущества,
			|	ПрочееИмуществоПереданноеВОплатуПаевОстатки.Имущество КАК Имущество,
			|	ПрочееИмуществоПереданноеВОплатуПаевОстатки.КоличествоОстаток КАК Количество,
			|	ПрочееИмуществоПереданноеВОплатуПаевОстатки.СуммаОстаток КАК Сумма
			|ИЗ
			|	РегистрНакопления.ПрочееИмуществоПереданноеВОплатуПаев.Остатки(
			|			&Дата,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ПрочееИмуществоПереданноеВОплатуПаевОстатки";
		
	ИначеЕсли ЭтаФорма.Параметры.ТипДокументаДляПодбора = Тип("ДокументСсылка.ВводПрочихАктивов") Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЗадолженностиПоПрочимАктивамОстатки.Основание КАК Основание,
			|	ЗадолженностиПоПрочимАктивамОстатки.ВидИмущества КАК ВидИмущества,
			|	ЗадолженностиПоПрочимАктивамОстатки.Имущество КАК Имущество,
			|	ЗадолженностиПоПрочимАктивамОстатки.СуммаОстаток КАК Сумма,
			|	ЗадолженностиПоПрочимАктивамОстатки.КоличествоОстаток КАК Количество
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоПрочимАктивам.Остатки(
			|			&Дата,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И &УсловиеПоЗаявке) КАК ЗадолженностиПоПрочимАктивамОстатки";
		
	ИначеЕсли ЭтаФорма.Параметры.ТипДокументаДляПодбора = Тип("ДокументСсылка.СведенияОРегистрацииПраваСобственности") Тогда
		
		Запрос.Текст =
			"ВЫБРАТЬ
			|	_ИмуществоПоЗаявкам.Основание КАК Основание,
			|	_ИмуществоПоЗаявкам.ВидИмущества КАК ВидИмущества,
			|	_ИмуществоПоЗаявкам.Имущество КАК Имущество,
			|	_ИмуществоПоЗаявкам.Сумма КАК Сумма,
			|	_ИмуществоПоЗаявкам.Количество КАК Количество
			|ИЗ
			|	(ВЫБРАТЬ
			|		ЗадолженностиПоПрочимАктивамОстатки.Основание КАК Основание,
			|		ЗадолженностиПоПрочимАктивамОстатки.ВидИмущества КАК ВидИмущества,
			|		ЗадолженностиПоПрочимАктивамОстатки.Имущество КАК Имущество,
			|		ЗадолженностиПоПрочимАктивамОстатки.СуммаОстаток КАК Сумма,
			|		ЗадолженностиПоПрочимАктивамОстатки.КоличествоОстаток КАК Количество
			|	ИЗ
			|		РегистрНакопления.ЗадолженностиПоПрочимАктивам.Остатки(
			|				&Дата,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|					И ВидИмущества = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.Недвижимость)
			|					И &УсловиеПоЗаявке) КАК ЗадолженностиПоПрочимАктивамОстатки
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ПрочееИмуществоПереданноеВОплатуПаевОстатки.Основание,
			|		ПрочееИмуществоПереданноеВОплатуПаевОстатки.ВидИмущества,
			|		ПрочееИмуществоПереданноеВОплатуПаевОстатки.Имущество,
			|		ПрочееИмуществоПереданноеВОплатуПаевОстатки.СуммаОстаток,
			|		ПрочееИмуществоПереданноеВОплатуПаевОстатки.КоличествоОстаток
			|	ИЗ
			|		РегистрНакопления.ПрочееИмуществоПереданноеВОплатуПаев.Остатки(
			|				&Дата,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|					И ВидИмущества = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.Недвижимость)
			|					И &УсловиеПоЗаявке) КАК ПрочееИмуществоПереданноеВОплатуПаевОстатки) КАК _ИмуществоПоЗаявкам
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СведенияОРегистрацииПраваСобственности.ОбъектыНедвижимости КАК СведенияОРегистрацииПраваСобственностиОбъектыНедвижимости
			|		ПО _ИмуществоПоЗаявкам.Имущество = СведенияОРегистрацииПраваСобственностиОбъектыНедвижимости.ОбъектНедвижимости
			|			И (СведенияОРегистрацииПраваСобственностиОбъектыНедвижимости.Ссылка.Проведен
			|				И СведенияОРегистрацииПраваСобственностиОбъектыНедвижимости.Ссылка.Дата < &ДатаДата)
			|ГДЕ
			|	СведенияОРегистрацииПраваСобственностиОбъектыНедвижимости.Ссылка ЕСТЬ NULL";
		
	 	Запрос.УстановитьПараметр("ДатаДата", ?(ТипЗнч(Запрос.Параметры.Дата) = Тип("МоментВремени"),Запрос.Параметры.Дата.Дата,Запрос.Параметры.Дата));
	КонецЕсли;
	
	ЗаявкаПайщика = Неопределено;
	Если ЭтаФорма.Параметры.Свойство("ЗаявкаПайщика",ЗаявкаПайщика) Тогда 	
		//Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоЗаявке", "ЗаявкаПайщикаИмущество.Ссылка = &ЗаявкаПайщика");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоЗаявке", "Основание = &ЗаявкаПайщика");
	 	Запрос.УстановитьПараметр("ЗаявкаПайщика", ЗаявкаПайщика);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоЗаявке", "Истина");
	КонецЕсли;
	
	
	ЭтаФорма.ОстаткиИмущества.Загрузить(Запрос.Выполнить().Выгрузить());
			
КонецПроцедуры 

&НаСервере
Функция ПолучитьХранилищеВыбранныхОстатковЗадолженностиНаСервере(НомерСтроки = Неопределено)
	
	Если НомерСтроки <> Неопределено Тогда
		Строки = Новый Массив;
		Строки.Добавить(ЭтаФорма.ОстаткиИмущества[НомерСтроки]);
	Иначе
		Строки = ЭтаФорма.ОстаткиИмущества.НайтиСтроки(Новый Структура("Флажок", Истина));
	КонецЕсли;
	
	Если Строки.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат
			Новый ХранилищеЗначения(ЭтаФорма.ОстаткиИмущества.Выгрузить(Строки));
	КонецЕсли;
	
КонецФункции 

#Область СОБЫТИЯ_ФОРМЫ_И_ЭЛЕМЕНТОВ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьОстаткиЗадолженностиНаСервере(Отказ);
	
	Если ЭтаФорма.Параметры.Свойство("ТекущиеДанные") Тогда
		РаботаСФормамиКлиентСервер.УстановитьТекущуюСтрокуТаблицы(ЭтаФорма, "ОстаткиИмущества", ЭтаФорма.Параметры.ТекущиеДанные);
	КонецЕсли;
	
	Если ЭтаФорма.ОстаткиИмущества.Количество() = 0 И ЭтаФорма.Параметры.ЗакрыватьПустой Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	//Элементы.НастройкиОтбора.Видимость = Элементы.ФормаКомандаПоказатьСкрытьНастройкиОтбора.Пометка;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПеренестиВДокумент(Команда)
	
	ТекущиеОстаткиИмущества = Элементы.ОстаткиИмущества.ТекущиеДанные;
	
	Если ТекущиеОстаткиИмущества <> Неопределено Тогда // И Не ЭтоМножественныйВыбор() Тогда
		ТекущиеОстаткиИмущества.Флажок = Истина;
	КонецЕсли;
	
	Хранилище = ПолучитьХранилищеВыбранныхОстатковЗадолженностиНаСервере();
	
	Если ЗначениеЗаполнено(Хранилище) Тогда
		ЭтаФорма.Закрыть(Хранилище);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьФлажки(Команда)
	
	Для каждого СтрокаОстаткиИмущества Из ЭтаФорма.ОстаткиИмущества Цикл
		СтрокаОстаткиИмущества.Флажок = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьФлажки(Команда)
	
	Для каждого СтрокаОстаткиИмущества Из ЭтаФорма.ОстаткиИмущества Цикл
		СтрокаОстаткиИмущества.Флажок = Ложь;
	КонецЦикла;

КонецПроцедуры


#КонецОбласти
