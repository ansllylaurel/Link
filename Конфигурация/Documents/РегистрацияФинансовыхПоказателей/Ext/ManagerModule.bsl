		|	СУММА(ЕСТЬNULL(_ВводыВыводы.Сумма, 0)) КАК ВводыВыводы,
		|	СУММА(ФинансовыеПоказателиНаКонец.Значение) КАК СЧАНаКонец,
		|	СУММА(ЕСТЬNULL(ФинансовыеПоказателиНаКонец.Значение, 0) - ЕСТЬNULL(_ВводыВыводы.Сумма, 0) - ЕСТЬNULL(ФинансовыеПоказателиНаНачало.Значение, 0)) КАК ФинРез,
		|	СУММА((ЕСТЬNULL(ФинансовыеПоказателиНаНачало.Значение, 0) * ДЕНЬ(КОНЕЦПЕРИОДА(_ВводыВыводы.НачалоМесяца, МЕСЯЦ)) + ЕСТЬNULL(_ВводыВыводы.ДляСреднего, 0)) / ДЕНЬГОДА(КОНЕЦПЕРИОДА(_ВводыВыводы.НачалоМесяца, ГОД))) КАК СреднегодоваяСтоимость,
		|	ВЫБОР
		|		КОГДА СУММА((ЕСТЬNULL(ФинансовыеПоказателиНаНачало.Значение, 0) * ДЕНЬ(КОНЕЦПЕРИОДА(_ВводыВыводы.НачалоМесяца, МЕСЯЦ)) + ЕСТЬNULL(_ВводыВыводы.ДляСреднего, 0)) / ДЕНЬГОДА(КОНЕЦПЕРИОДА(_ВводыВыводы.НачалоМесяца, ГОД))) = 0
		|			ТОГДА 0
		|		ИНАЧЕ СУММА(ЕСТЬNULL(ФинансовыеПоказателиНаКонец.Значение, 0) - ЕСТЬNULL(_ВводыВыводы.Сумма, 0) - ЕСТЬNULL(ФинансовыеПоказателиНаНачало.Значение, 0)) * 100 / СУММА((ЕСТЬNULL(ФинансовыеПоказателиНаНачало.Значение, 0) * ДЕНЬ(КОНЕЦПЕРИОДА(_ВводыВыводы.НачалоМесяца, МЕСЯЦ)) + ЕСТЬNULL(_ВводыВыводы.ДляСреднего, 0)) / ДЕНЬГОДА(КОНЕЦПЕРИОДА(_ВводыВыводы.НачалоМесяца, ГОД)))
		|	КОНЕЦ КАК ДоходностьЗаМесяц
		|ПОМЕСТИТЬ _ФинРез_ВесьПериод
		|ИЗ
		|	_ВводыВыводы КАК _ВводыВыводы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказателиНаНачало
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				_ВводыВыводы.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|				_ВводыВыводы.НачалоМесяца КАК НачалоМесяца,
		|				МАКСИМУМ(ФинансовыеПоказателиНаНачало.Период) КАК Период
		|			ИЗ
		|				_ВводыВыводы КАК _ВводыВыводы
		|					ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказателиНаНачало
		|					ПО (ФинансовыеПоказателиНаНачало.СубъектАналитики = _ВводыВыводы.СчетДоверительногоУправления)
		|						И (ФинансовыеПоказателиНаНачало.Организация = &Организация)
		|						И (ФинансовыеПоказателиНаНачало.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|						И (ФинансовыеПоказателиНаНачало.Период < _ВводыВыводы.НачалоМесяца)
		|						И (НЕ _ВводыВыводы.НачалоСтатегии)
		|			
		|			СГРУППИРОВАТЬ ПО
		|				_ВводыВыводы.СчетДоверительногоУправления,
		|				_ВводыВыводы.НачалоМесяца) КАК ПериодФинансовыеПоказателиНаНачало
		|			ПО ФинансовыеПоказателиНаНачало.СубъектАналитики = ПериодФинансовыеПоказателиНаНачало.СчетДоверительногоУправления
		|				И (ФинансовыеПоказателиНаНачало.Организация = &Организация)
		|				И (ФинансовыеПоказателиНаНачало.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|				И ФинансовыеПоказателиНаНачало.Период = ПериодФинансовыеПоказателиНаНачало.Период
		|		ПО (ФинансовыеПоказателиНаНачало.СубъектАналитики = _ВводыВыводы.СчетДоверительногоУправления)
		|			И (ПериодФинансовыеПоказателиНаНачало.НачалоМесяца = _ВводыВыводы.НачалоМесяца)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказателиНаКонец
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				_ВводыВыводы.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|				_ВводыВыводы.ОкончаниеМесяца КАК ОкончаниеМесяца,
		|				МАКСИМУМ(ФинансовыеПоказателиНаКонец.Период) КАК Период
		|			ИЗ
		|				_ВводыВыводы КАК _ВводыВыводы
		|					ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказателиНаКонец
		|					ПО (ФинансовыеПоказателиНаКонец.СубъектАналитики = _ВводыВыводы.СчетДоверительногоУправления)
		|						И (ФинансовыеПоказателиНаКонец.Организация = &Организация)
		|						И (ФинансовыеПоказателиНаКонец.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|						И (ФинансовыеПоказателиНаКонец.Период <= _ВводыВыводы.ОкончаниеМесяца)
		|						И (НЕ _ВводыВыводы.ОкончаниеСтратегии)
		|			
		|			СГРУППИРОВАТЬ ПО
		|				_ВводыВыводы.СчетДоверительногоУправления,
		|				_ВводыВыводы.ОкончаниеМесяца) КАК ПериодФинансовыеПоказателиНаКонец
		|			ПО ФинансовыеПоказателиНаКонец.СубъектАналитики = ПериодФинансовыеПоказателиНаКонец.СчетДоверительногоУправления
		|				И (ФинансовыеПоказателиНаКонец.Организация = &Организация)
		|				И (ФинансовыеПоказателиНаКонец.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|				И ФинансовыеПоказателиНаКонец.Период = ПериодФинансовыеПоказателиНаКонец.Период
		|		ПО (ФинансовыеПоказателиНаКонец.СубъектАналитики = _ВводыВыводы.СчетДоверительногоУправления)
		|			И (ПериодФинансовыеПоказателиНаКонец.ОкончаниеМесяца = _ВводыВыводы.ОкончаниеМесяца)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВводыВыводы.Стратегия,
		|	_ВводыВыводы.НачалоМесяца,
		|	_ВводыВыводы.ОкончаниеМесяца
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ФинРез_ВесьПериод.Стратегия КАК Стратегия,
		|	_ФинРез_ВесьПериод.ОкончаниеМесяца КАК Период,
		|	_ФинРез_ВесьПериод.СЧАНаНачало КАК СЧАНаНачало,
		|	_ФинРез_ВесьПериод.ВводыВыводы КАК ВводыВыводы,
		|	_ФинРез_ВесьПериод.СЧАНаКонец КАК СЧАНаКонец,
		|	_ФинРез_ВесьПериод.ФинРез КАК ФинРез,
		|	_ФинРез_ВесьПериод.СреднегодоваяСтоимость КАК СреднегодоваяСтоимость,
		|	_ФинРез_ВесьПериод.ДоходностьЗаМесяц КАК ДоходностьЗаМесяц,
		|	СРЕДНЕЕ(_ФинРез_ВесьПериод1.ДоходностьЗаМесяц) КАК СреднемесячнаяДоходность
		|ИЗ
		|	_ФинРез_ВесьПериод КАК _ФинРез_ВесьПериод
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ФинРез_ВесьПериод КАК _ФинРез_ВесьПериод1
		|		ПО _ФинРез_ВесьПериод.Стратегия = _ФинРез_ВесьПериод1.Стратегия
		|			И _ФинРез_ВесьПериод.НачалоМесяца >= _ФинРез_ВесьПериод1.НачалоМесяца
		|
		|СГРУППИРОВАТЬ ПО
		|	_ФинРез_ВесьПериод.Стратегия,
		|	_ФинРез_ВесьПериод.ОкончаниеМесяца,
		|	_ФинРез_ВесьПериод.ФинРез,
		|	_ФинРез_ВесьПериод.СЧАНаНачало,
		|	_ФинРез_ВесьПериод.ВводыВыводы,
		|	_ФинРез_ВесьПериод.СЧАНаКонец,
		|	_ФинРез_ВесьПериод.СреднегодоваяСтоимость,
		|	_ФинРез_ВесьПериод.ДоходностьЗаМесяц
		|
		|УПОРЯДОЧИТЬ ПО
		|	_ФинРез_ВесьПериод.ОкончаниеМесяца";
	
	СреднемесячнаяДоходность							= 0;
	СтоимостьИмуществаПереданногоВУправлениеКонтрольная	= 0;
	
	РасшифровкаСреднемесячнойДоходности = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СреднемесячнаяДоходность							= Выборка.СреднемесячнаяДоходность;
		СтоимостьИмуществаПереданногоВУправлениеКонтрольная	= СтоимостьИмуществаПереданногоВУправлениеКонтрольная + Выборка.ВводыВыводы;
		
		ЭлементРасшифровки = Новый Структура("Период, СЧАНаНачало, ВводыВыводы, СЧАНаКонец, ФинРез, СреднегодоваяСтоимость, ДоходностьЗаМесяц, СреднемесячнаяДоходность");
		ЗаполнитьЗначенияСвойств(ЭлементРасшифровки, Выборка);
		РасшифровкаСреднемесячнойДоходности.Добавить(ЭлементРасшифровки);
		
	КонецЦикла;
	
	#КонецОбласти

	#Область Контрольные_проверки
	
	ИзменившиеСтратегию = Запрос.МенеджерВременныхТаблиц.Таблицы["_ИзменившиеСтратегию"].ПолучитьДанные();
	
	Если ИзменившиеСтратегию.Пустой() Тогда
		
		// Когда стратегию не меняли, сумма вводов/выводов при расчете дохода и среднемесячной доходности должна совпадать	
		
		Если СтоимостьИмуществаПереданногоВУправление <> СтоимостьИмуществаПереданногоВУправлениеКонтрольная Тогда
			
			ВызватьИсключение СтрШаблон("Различается сумма имущества, переданного в управление, в расчетах дохода (%1) и среднемесячной доходности (%2)!",
				СтоимостьИмуществаПереданногоВУправление,
				СтоимостьИмуществаПереданногоВУправлениеКонтрольная);
			
		КонецЕсли;
		
	КонецЕсли;
	
	#КонецОбласти
	
	Доход		= СтоимостьПортфеля - СтоимостьИмуществаПереданногоВУправление;
	Доходность	= Доход / СредняяСтоимостьИмуществаПереданногоВУправление * 100;
	
	Если РасшифровкаРасчета Тогда
		
		ФинансовыеПоказатели = Новый Структура;
		ФинансовыеПоказатели.Вставить("Стратегия",									Строка(Стратегия));
		ФинансовыеПоказатели.Вставить("ОтчетнаяДата",								Формат(Период, "ДЛФ=D"));
		ФинансовыеПоказатели.Вставить("ИтогоПереданоВДУ",							Формат(СтоимостьИмуществаПереданногоВУправление, "ЧДЦ=2"));
		ФинансовыеПоказатели.Вставить("СредняяСтоимостьИмущества",					Формат(СредняяСтоимостьИмуществаПереданногоВУправление, "ЧДЦ=2"));
		ФинансовыеПоказатели.Вставить("СтоимостьПортфеля",							Формат(СтоимостьПортфеля, "ЧДЦ=2"));
		ФинансовыеПоказатели.Вставить("Доход",										Формат(Доход, "ЧДЦ=2"));
		ФинансовыеПоказатели.Вставить("Доходность",									Формат(Доходность, "ЧДЦ=2"));
		
		ФинансовыеПоказатели.Вставить("СреднемесячнаяДоходность",					Формат(СреднемесячнаяДоходность, "ЧДЦ=2"));
		ФинансовыеПоказатели.Вставить("РасшифровкаСреднемесячнойДоходности",		РасшифровкаСреднемесячнойДоходности);
		
		ФинансовыеПоказатели.Вставить("Операции",									Операции);
		ФинансовыеПоказатели.Вставить("РасшифровкаСтоимостиПортфеля",				РасшифровкаСтоимостиПортфеля);
		
		ФинансовыеПоказатели.Вставить("СтоимостьПортфеляЗарегистрировано",			Формат(СтоимостьПортфеляЗарегистрировано, "ЧДЦ=2"));
		ФинансовыеПоказатели.Вставить("ДоходЗарегистрировано",						Формат(ДоходЗарегистрировано, "ЧДЦ=2"));
		ФинансовыеПоказатели.Вставить("ДоходностьЗарегистрировано",					Формат(ДоходностьЗарегистрировано, "ЧДЦ=2"));
		ФинансовыеПоказатели.Вставить("СреднемесячнаяДоходностьЗарегистрировано",	Формат(СреднемесячнаяДоходностьЗарегистрировано, "ЧДЦ=2"));
		
	Иначе
		
		ФинансовыеПоказатели = Новый Соответствие;
		ФинансовыеПоказатели.Вставить(Справочники.ВидыФинансовыхПоказателей.СтандартныеСтратегии_СтоимостьПортфеля,			СтоимостьПортфеля);
		ФинансовыеПоказатели.Вставить(Справочники.ВидыФинансовыхПоказателей.СтандартныеСтратегии_Доход,						Доход);
		ФинансовыеПоказатели.Вставить(Справочники.ВидыФинансовыхПоказателей.СтандартныеСтратегии_Доходность,				Доходность);
		ФинансовыеПоказатели.Вставить(Справочники.ВидыФинансовыхПоказателей.СтандартныеСтратегии_СреднемесячнаяДоходность,	СреднемесячнаяДоходность);
		
		Если Документы.РегистрацияСтоимостиАктивов.ТребуетсяРегистрацияДоходностиСтратегииСНачалаГода(Организация, Стратегия, Период) Тогда
			Отказ = Ложь;
			
			РасчетДоходностиСтратегииСНачалаГода = Документы.РегистрацияСтоимостиАктивов.РассчитатьДоходностьСтратегииСНачалаГода(Организация, Стратегия, Период, Ложь, Отказ);
			Если Отказ = Ложь Тогда
				Для Каждого ДоходностьСтратегииСНачалаГода Из РасчетДоходностиСтратегииСНачалаГода Цикл
					ФинансовыеПоказатели.Вставить(ДоходностьСтратегииСНачалаГода.Ключ, ДоходностьСтратегииСНачалаГода.Значение);
				КонецЦикла;
			КонецЕсли;	
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат ФинансовыеПоказатели;
	
КонецФункции

Функция ЗапретРедактированияДокумента(Документ, Отказ, СообщатьОбОтказе = Истина, ТекстСообщения = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация", 	Документ.Организация);
	Запрос.УстановитьПараметр("Дата",			Документ.Дата);
	
	РегистрыСведений.ДатыЗапретаРедактирования.ПоместитьВЗапросДатыЗапретаРедактированияКонтролера(Запрос);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДатыЗапретаРедактированияКонтролера.Организация КАК Организация,
		|	_ДатыЗапретаРедактированияКонтролера.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования
		|ИЗ
		|	_ДатыЗапретаРедактированияКонтролера КАК _ДатыЗапретаРедактированияКонтролера
		|ГДЕ
		|	_ДатыЗапретаРедактированияКонтролера.Организация = &Организация
		|	И _ДатыЗапретаРедактированияКонтролера.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами)
		|	И _ДатыЗапретаРедактированияКонтролера.ДатаЗапретаРедактирования >= НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Запрет = Не РезультатЗапроса.Пустой();
	
	Если Запрет Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ТекстСообщения =
				СтрШаблон("Редактирование документа запрещено, т.к. его дата меньше либо равна дате запрета редактирования контролёра (%1)",
					Формат(Выборка.ДатаЗапретаРедактирования, "ДФ=dd.MM.yyyy"));
			
			Если СообщатьОбОтказе Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Документ, "Дата");
