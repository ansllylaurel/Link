
Функция РассчитатьФинансовыеПоказателиСтандартнойСтратегии(Организация, Стратегия, Период, РасшифровкаРасчета = Ложь) Экспорт
	
	Если ТипЗнч(Стратегия) <> Тип("СправочникСсылка.СтратегииИндивидуальногоИнвестирования") Тогда
		ВызватьИсключение "Расчет финансовых показателей стандартной стратегии поддерживается только по стратегиям индивидуального инвестирования";
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Период",			КонецДня(Период));
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("Стратегия",		Стратегия);
	
	#Область Расчет_общей_стоимости_портфелей_стратегии_на_дату_расчета 
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(&Период, Организация = &Организация) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
		|ГДЕ
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия = &Стратегия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказатели.Регистратор КАК Регистратор,
		|	ФинансовыеПоказатели.СубъектАналитики КАК СДУ,
		|	ФинансовыеПоказатели.Значение КАК СЧА
		|ПОМЕСТИТЬ _СтоимостьЧистыхАктивов
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|ГДЕ
		|	ФинансовыеПоказатели.СубъектАналитики В
		|			(ВЫБРАТЬ
		|				_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления)
		|	И ФинансовыеПоказатели.Организация = &Организация
		|	И ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
		|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(СУММА(_СтоимостьЧистыхАктивов.СЧА), 0) КАК СтоимостьПортфеля
		|ИЗ
		|	_СтоимостьЧистыхАктивов КАК _СтоимостьЧистыхАктивов";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.СтоимостьПортфеля) Тогда
		СтоимостьПортфеля = Выборка.СтоимостьПортфеля;
	Иначе
		ВызватьИсключение "Расчет на " + Формат(Период, "ДЛФ=DD") + " невозможен, т.к. стоимость портфеля на данную дату не зарегистрирована!";
	КонецЕсли;	
	
	Если РасшифровкаРасчета Тогда
		
		РасшифровкаСтоимостиПортфеля = Новый Массив;
		
		Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы["_СтоимостьЧистыхАктивов"].ПолучитьДанные().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ЗаписьРасшифровки = Новый Структура;
			
			ЗаписьРасшифровки.Вставить("СДУ",			Выборка.СДУ);
			ЗаписьРасшифровки.Вставить("СЧА",			Формат(Выборка.СЧА, "ЧДЦ=2"));
			ЗаписьРасшифровки.Вставить("Регистратор",	Выборка.Регистратор);
			
			РасшифровкаСтоимостиПортфеля.Добавить(ЗаписьРасшифровки);
			
		КонецЦикла;

	КонецЕсли;
	
	#КонецОбласти
	
	#Область Получение_имущества_переданного_в_управление
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(ВводыВыводыАктивовВВалютеУчета.Период, ДЕНЬ) КАК Период,
		|	ВЫБОР
		|		КОГДА ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|			ТОГДА -1
		|		ИНАЧЕ 1
		|	КОНЕЦ * ВЫБОР
		|		КОГДА ВводыВыводыАктивовВВалютеУчета.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|			ТОГДА -1
		|		ИНАЧЕ 1
		|	КОНЕЦ * ВводыВыводыАктивовВВалютеУчета.РыночнаяСтоимость КАК Сумма,
		|	ВводыВыводыАктивовВВалютеУчета.ВидАктива КАК ВидАктива,
		|	ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения КАК НаправлениеДвижения,
		|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(ВводыВыводыАктивовВВалютеУчета.Период, ДЕНЬ), НАЧАЛОПЕРИОДА(&Период, ДЕНЬ), ДЕНЬ) + 1 КАК ДнейВУправлении,
		|	ВводыВыводыАктивовВВалютеУчета.Регистратор КАК Операция,
		|	ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ПО (ВводыВыводыАктивовВВалютеУчета.Организация = &Организация)
		|			И ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления = _СчетаДоверительногоУправления.СчетДоверительногоУправления
		|			И (ВводыВыводыАктивовВВалютеУчета.Период <= КОНЕЦПЕРИОДА(&Период, ДЕНЬ))
		|			И (ВводыВыводыАктивовВВалютеУчета.Активность)";
	
	// Определим переданную и среднюю стоимости имущества
	
	Операции = Новый Массив;
	
	СредняяСтоимостьИмуществаПереданногоВУправление = 0;
	СтоимостьИмуществаПереданногоВУправление        = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтоимостьИмуществаПереданногоВУправление		= СтоимостьИмуществаПереданногоВУправление + Выборка.Сумма;
		СредняяСтоимостьИмуществаПереданногоВУправление	= СредняяСтоимостьИмуществаПереданногоВУправление + Выборка.Сумма * Выборка.ДнейВУправлении;
		
		Если РасшифровкаРасчета Тогда
			
			Операция = Новый Структура;
			Операция.Вставить("ДатаОперации",	Формат(Выборка.Период, "ДЛФ=D"));
			Операция.Вставить("Документ",		Выборка.Операция);
			Операция.Вставить("СчетДУ",			Выборка.СчетДоверительногоУправления);
			Операция.Вставить("Сумма",			Формат(Выборка.Сумма, "ЧДЦ=2"));
			Операция.Вставить("ДнейОсталось",	Формат(Выборка.ДнейВУправлении, "ЧДЦ="));
			
			Операции.Добавить(Операция);
			
		КонецЕсли;
		
	КонецЦикла;	
	
	СредняяСтоимостьИмуществаПереданногоВУправление = СредняяСтоимостьИмуществаПереданногоВУправление / 365;
	
	#КонецОбласти
	
	Если РасшифровкаРасчета Тогда
		
		#Область Получение_зарегистрированных_показателей
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ФинансовыеПоказатели.ВидПоказателя КАК ВидПоказателя,
			|	ФинансовыеПоказатели.Значение КАК Значение
			|ПОМЕСТИТЬ _ТекущиеФинансовыеПоказатели
			|ИЗ
			|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
			|ГДЕ
			|	ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
			|	И ФинансовыеПоказатели.ВидПоказателя В (ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтандартныеСтратегии_Доходность), ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтандартныеСтратегии_СтоимостьПортфеля), ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтандартныеСтратегии_Доход), ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтандартныеСтратегии_СреднемесячнаяДоходность))
			|	И ФинансовыеПоказатели.СубъектАналитики = &Стратегия
			|	И ФинансовыеПоказатели.Организация = &Организация
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ТекущиеФинансовыеПоказатели.Значение КАК Доходность,
			|	NULL КАК СтоимостьПортфеля,
			|	NULL КАК Доход,
			|	NULL КАК СреднемесячнаяДоходностьЗарегистрировано
			|ПОМЕСТИТЬ _ЗначенияПоказателей
			|ИЗ
			|	_ТекущиеФинансовыеПоказатели КАК _ТекущиеФинансовыеПоказатели
			|ГДЕ
			|	_ТекущиеФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтандартныеСтратегии_Доходность)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	NULL,
			|	_ТекущиеФинансовыеПоказатели.Значение,
			|	NULL,
			|	NULL
			|ИЗ
			|	_ТекущиеФинансовыеПоказатели КАК _ТекущиеФинансовыеПоказатели
			|ГДЕ
			|	_ТекущиеФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтандартныеСтратегии_СтоимостьПортфеля)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	NULL,
			|	NULL,
			|	_ТекущиеФинансовыеПоказатели.Значение,
			|	NULL
			|ИЗ
			|	_ТекущиеФинансовыеПоказатели КАК _ТекущиеФинансовыеПоказатели
			|ГДЕ
			|	_ТекущиеФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтандартныеСтратегии_Доход)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	NULL,
			|	NULL,
			|	NULL,
			|	_ТекущиеФинансовыеПоказатели.Значение
			|ИЗ
			|	_ТекущиеФинансовыеПоказатели КАК _ТекущиеФинансовыеПоказатели
			|ГДЕ
			|	_ТекущиеФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтандартныеСтратегии_СреднемесячнаяДоходность)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СУММА(_ЗначенияПоказателей.Доходность) КАК ДоходностьЗарегистрировано,
			|	СУММА(_ЗначенияПоказателей.СтоимостьПортфеля) КАК СтоимостьПортфеляЗарегистрировано,
			|	СУММА(_ЗначенияПоказателей.Доход) КАК ДоходЗарегистрировано,
			|	СУММА(_ЗначенияПоказателей.СреднемесячнаяДоходностьЗарегистрировано) КАК СреднемесячнаяДоходностьЗарегистрировано
			|ИЗ
			|	_ЗначенияПоказателей КАК _ЗначенияПоказателей";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			СтоимостьПортфеляЗарегистрировано			= Выборка.СтоимостьПортфеляЗарегистрировано;
			ДоходЗарегистрировано						= Выборка.ДоходЗарегистрировано;
			ДоходностьЗарегистрировано					= Выборка.ДоходностьЗарегистрировано;
			СреднемесячнаяДоходностьЗарегистрировано	= Выборка.СреднемесячнаяДоходностьЗарегистрировано;
		Иначе
			СтоимостьПортфеляЗарегистрировано			= Неопределено;
			ДоходЗарегистрировано						= Неопределено;
			ДоходностьЗарегистрировано					= Неопределено;
			СреднемесячнаяДоходностьЗарегистрировано	= Неопределено;
		КонецЕсли;
		
		#КонецОбласти
		
	КонецЕсли;	
	
	Запрос.МенеджерВременныхТаблиц.Закрыть();
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	#Область Расчет_среднемесячной_доходности

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НачалоПериодаСтратегии.Стратегия КАК Стратегия,
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	НачалоПериодаСтратегии.Период КАК НачалоПериода,
		|	ВЫБОР
		|		КОГДА МИНИМУМ(ОкончанияПериодаСтратегии.Период) < &Период
		|				И МИНИМУМ(ОкончанияПериодаСтратегии.Период) < СчетаДоверительногоУправления.ДатаРасторжения
		|			ТОГДА МИНИМУМ(ОкончанияПериодаСтратегии.Период)
		|		КОГДА КОНЕЦПЕРИОДА(СчетаДоверительногоУправления.ДатаРасторжения, ДЕНЬ) < &Период
		|			ТОГДА КОНЕЦПЕРИОДА(СчетаДоверительногоУправления.ДатаРасторжения, ДЕНЬ)
		|		ИНАЧЕ &Период
		|	КОНЕЦ КАК ОкончаниеПериода
		|ПОМЕСТИТЬ _СтратегииСчетовДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования КАК НачалоПериодаСтратегии
		|		ПО (НачалоПериодаСтратегии.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|			И (НачалоПериодаСтратегии.Организация = СчетаДоверительногоУправления.Организация)
		|			И (НачалоПериодаСтратегии.Период <= &Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования КАК ОкончанияПериодаСтратегии
		|		ПО (ОкончанияПериодаСтратегии.СчетДоверительногоУправления = НачалоПериодаСтратегии.СчетДоверительногоУправления)
		|			И (ОкончанияПериодаСтратегии.Организация = НачалоПериодаСтратегии.Организация)
		|			И (ОкончанияПериодаСтратегии.Период > НачалоПериодаСтратегии.Период)
		|ГДЕ
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &Период
		|	И СчетаДоверительногоУправления.Организация = &Организация
		|
		|СГРУППИРОВАТЬ ПО
		|	СчетаДоверительногоУправления.Ссылка,
		|	НачалоПериодаСтратегии.Стратегия,
		|	НачалоПериодаСтратегии.Период,
		|	СчетаДоверительногоУправления.ДатаРасторжения
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_СтратегииСчетовДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _ИзменившиеСтратегию
		|ИЗ
		|	_СтратегииСчетовДоверительногоУправления КАК _СтратегииСчетовДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_СтратегииСчетовДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|		ИЗ
		|			_СтратегииСчетовДоверительногоУправления КАК _СтратегииСчетовДУ
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_СтратегииСчетовДУ.СчетДоверительногоУправления
		|		
