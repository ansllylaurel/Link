
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	ЭтотОбъект.ФинансовыеПоказатели.Очистить();
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// Предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда	
		Для Каждого СтрокаФинансовыеПоказатели Из ЭтотОбъект.ФинансовыеПоказатели Цикл
			ПоказателиОрганизации = (СтрокаФинансовыеПоказатели.ВидПоказателя.Родитель = Справочники.ВидыФинансовыхПоказателей.ПоказателиДеятельностиОрганизации);
			
			Если ЗначениеЗаполнено(ЭтотОбъект.СубъектАналитики) И ПоказателиОрганизации Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("'%1' регистриуется только для Показателей организации", СтрокаФинансовыеПоказатели.ВидПоказателя),,,, Отказ);
				
			ИначеЕсли НЕ ЗначениеЗаполнено(ЭтотОбъект.СубъектАналитики) И НЕ ПоказателиОрганизации Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("'%1' регистриуется только для Субъекта аналитики", СтрокаФинансовыеПоказатели.ВидПоказателя),,,, Отказ);
				
			КонецЕсли;
			
			Если СтрокаФинансовыеПоказатели.ВидПоказателя = Справочники.ВидыФинансовыхПоказателей.КатегорияПрофессиональногоУчастникаРынкаЦенныхБумаг
			   И НачалоДня(ЭтотОбъект.Дата) <> НачалоГода(ЭтотОбъект.Дата) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Показатель '%1' регистрируется только 1 января", СтрокаФинансовыеПоказатели.ВидПоказателя),,,, Отказ);
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЭтотОбъект.ФинансовыеПоказатели.Найти(Справочники.ВидыФинансовыхПоказателей.ДоходностьСтратегииСНачалаГода) <> Неопределено Тогда
			Если НЕ Документы.РегистрацияСтоимостиАктивов.ТребуетсяРегистрацияДоходностиСтратегииСНачалаГода(ЭтотОбъект.Организация, ЭтотОбъект.СубъектАналитики, ЭтотОбъект.Дата, Истина) Тогда
				Отказ = Истина; //Сообщение было в ТребуетсяРегистрацияДоходностиСтратегииСНачалаГода
			КонецЕсли;
			
		ИначеЕсли Документы.РегистрацияСтоимостиАктивов.ТребуетсяРегистрацияДоходностиСтратегииСНачалаГода(ЭтотОбъект.Организация, ЭтотОбъект.СубъектАналитики, ЭтотОбъект.Дата) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В документе отсутствует показатель %1.", Справочники.ВидыФинансовыхПоказателей.ДоходностьСтратегииСНачалаГода), ЭтотОбъект,,, Отказ);
			
		КонецЕсли;	
		
	КонецЕсли;
	
	// Блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ФинансовыеПоказатели.Записывать = Истина;
	Движения.ПоказателиДеятельности.Записывать = Истина;
	
	Для каждого СтрокаФинансовыеПоказатели Из ЭтотОбъект.ФинансовыеПоказатели Цикл
		Если СтрокаФинансовыеПоказатели.ВидПоказателя = Справочники.ВидыФинансовыхПоказателей.КатегорияПрофессиональногоУчастникаРынкаЦенныхБумаг Тогда
			Движение = Движения.ПоказателиДеятельности.Добавить();
			Движение.Период					= ЭтотОбъект.Дата;
			Движение.Организация			= ЭтотОбъект.Организация;
			Движение.КатегорияПрофУчастника = СтрокаФинансовыеПоказатели.Значение;
			
		Иначе
			Движение = Движения.ФинансовыеПоказатели.Добавить();
			Движение.Период = ЭтотОбъект.Дата;
			
			ЗаполнитьЗначенияСвойств(Движение, ЭтотОбъект, "Организация, СубъектАналитики");
			ЗаполнитьЗначенияСвойств(Движение, СтрокаФинансовыеПоказатели, "ВидПоказателя, Значение");
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
