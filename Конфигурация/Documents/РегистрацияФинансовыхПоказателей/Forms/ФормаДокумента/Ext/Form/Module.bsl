&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПоказателиСтандартнойСтратегииДляВыгрузкиНаСайт()
	
	ВидыФинансовыхПоказателей = РаботаСМетаданнымиПовтИсп.ЗначенияПредопределенныхЭлементовСправочникаВСтруктуру("ВидыФинансовыхПоказателей");
	
	ПоказателиСтандартнойСтратегииДляВыгрузкиНаСайт = Новый Массив;
	ПоказателиСтандартнойСтратегииДляВыгрузкиНаСайт.Добавить(ВидыФинансовыхПоказателей.СтандартныеСтратегии_СтоимостьПортфеля);
	ПоказателиСтандартнойСтратегииДляВыгрузкиНаСайт.Добавить(ВидыФинансовыхПоказателей.СтандартныеСтратегии_Доход);
	ПоказателиСтандартнойСтратегииДляВыгрузкиНаСайт.Добавить(ВидыФинансовыхПоказателей.СтандартныеСтратегии_Доходность);
	ПоказателиСтандартнойСтратегииДляВыгрузкиНаСайт.Добавить(ВидыФинансовыхПоказателей.СтандартныеСтратегии_СреднемесячнаяДоходность);
	
	Возврат ПоказателиСтандартнойСтратегииДляВыгрузкиНаСайт;	
	
КонецФункции

&НаСервереБезКонтекста 
Функция КомандаОтобразитьРасчетНаСервере(Организация, СубъектАналитики, Дата, ДоходностьПФР=Ложь, НачалоПериода = Неопределено)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	// Получаем макет и области таб. документа.
	Макет					= Документы.РегистрацияФинансовыхПоказателей.ПолучитьМакет("РасшифровкаРасчетаДоходностиПоСтратегиям");
	Шапка					= Макет.ПолучитьОбласть("Шапка");
	Строка					= Макет.ПолучитьОбласть("Строка");
	ШапкаСтоимостьПортфеля	= Макет.ПолучитьОбласть("ШапкаСтоимостьПортфеля");
	СтрокаСтоимостьПортфеля	= Макет.ПолучитьОбласть("СтрокаСтоимостьПортфеля");
	
	ШапкаСреднемесячнаяДоходность	= Макет.ПолучитьОбласть("ШапкаСреднемесячнаяДоходность");
	СтрокаСреднемесячнаяДоходность	= Макет.ПолучитьОбласть("СтрокаСреднемесячнаяДоходность");
	
	// Получаем данные для вывода.
	ДеталиРасчета = Документы.РегистрацияФинансовыхПоказателей.РассчитатьФинансовыеПоказателиСтандартнойСтратегии(Организация, СубъектАналитики, Дата, Истина);
	
	// Вывод шапки.
	Шапка.Параметры.Заполнить(ДеталиРасчета);
	ТабличныйДокумент.Вывести(Шапка);
	
	// Вывод таблицы операций.
	Если ДеталиРасчета.Операции.Количество() > 0 Тогда
		
		ТабличныйДокумент.НачатьГруппуСтрок();
		
		Для Каждого Операция Из ДеталиРасчета.Операции Цикл
			
			Строка.Параметры.Заполнить(Операция);
			ТабличныйДокумент.Вывести(Строка);
			
		КонецЦикла;
		
		ТабличныйДокумент.ЗакончитьГруппуСтрок();
		
	КонецЕсли;
	
	// Вывод шапки расшифровки стоимости портфеля.
	ТабличныйДокумент.Вывести(ШапкаСтоимостьПортфеля);
	
	// Вывод таблицы операций.
	Если ДеталиРасчета.РасшифровкаСтоимостиПортфеля.Количество() > 0 Тогда
		
		ТабличныйДокумент.НачатьГруппуСтрок();
		
		Для Каждого ЗаписьРасшифровки Из ДеталиРасчета.РасшифровкаСтоимостиПортфеля Цикл
			
			СтрокаСтоимостьПортфеля.Параметры.Заполнить(ЗаписьРасшифровки);
			ТабличныйДокумент.Вывести(СтрокаСтоимостьПортфеля);
			
		КонецЦикла;
		
		ТабличныйДокумент.ЗакончитьГруппуСтрок();
		
	КонецЕсли;
	
	// Среднемесячная доходность
	
	ТабличныйДокумент.Вывести(ШапкаСреднемесячнаяДоходность);
	
	ТабличныйДокумент.НачатьГруппуСтрок();
	
	Для Каждого ЭлементРасшифровки Из ДеталиРасчета.РасшифровкаСреднемесячнойДоходности Цикл		
		СтрокаСреднемесячнаяДоходность.Параметры.Заполнить(ЭлементРасшифровки);
		ТабличныйДокумент.Вывести(СтрокаСреднемесячнаяДоходность);
	КонецЦикла;
	
	ТабличныйДокумент.ЗакончитьГруппуСтрок();
	
	// Включаем только просмотр для доступности расшифровки.
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	
	// Отключаем сетку.
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	
	
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаСервереБезКонтекста 
Функция ОтобразитьРасчетКатегорииПрофессиональногоУчастникаРынкаЦенныхБумагНаСервере(Организация, ДатаРасчета)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("Организация", Организация);
	ПараметрыРасчета.Вставить("ДатаРасчета", ДатаРасчета);

	ГодовыеПоказателиДеятельности = Новый Соответствие;
	
	Результат = РаботаСОтчетностьюЦБ.ОКУД0420401_РассчитатьКатегориюПрофУчастникаНаОснованииКвартальныхПоказателей(ПараметрыРасчета, Ложь);
	Если Результат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	// Получаем макет и области таб. документа.
	Макет = Документы.РегистрацияФинансовыхПоказателей.ПолучитьМакет("РасшифровкаКатегорииПрофУчастника");
	
	ОбластьШапка				= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрокаВидПоказателя	= Макет.ПолучитьОбласть("СтрокаВидПоказателя");
	ОбластьРассчитанныеЗначения	= Макет.ПолучитьОбласть("РассчитанныеЗначения");
	ОбластьШапкаПериода			= Макет.ПолучитьОбласть("ШапкаПериода");
	ОбластьСтрокаПериода		= Макет.ПолучитьОбласть("СтрокаПериода");
	ОбластьЗаключение			= Макет.ПолучитьОбласть("Заключение");
	
	ОбластьШапка.Параметры.Заполнить(Результат.РеквизитыОрганизации);
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ВидыПоказателей = Результат.ВидыПоказателей.Скопировать(,"НомерСтроки,ВидПоказателя,ПредставлениеМалый,ПредставлениеСредний,ПредставлениеКрупный");
	ВидыПоказателей.Свернуть("НомерСтроки,ВидПоказателя,ПредставлениеМалый,ПредставлениеСредний,ПредставлениеКрупный");
	
	Для Каждого СтрокаВидыПоказателей Из ВидыПоказателей Цикл
		ОбластьСтрокаВидПоказателя.Параметры.Заполнить(СтрокаВидыПоказателей);
		ТабличныйДокумент.Вывести(ОбластьСтрокаВидПоказателя);
	КонецЦикла;	
	
	ТабличныйДокумент.Вывести(ОбластьРассчитанныеЗначения);
	
	Квартал = Неопределено;
	Для Каждого СтрокаРасшифровки Из Результат.Расшифровка Цикл
		Если Квартал <> СтрокаРасшифровки.Дата Тогда
			Квартал = СтрокаРасшифровки.Дата;
			ОбластьШапкаПериода.Параметры.Период = ПредставлениеПериода(НачалоКвартала(Квартал), КонецКвартала(Квартал));
			ТабличныйДокумент.Вывести(ОбластьШапкаПериода);
		КонецЕсли;	
		
		ОбластьСтрокаПериода.Параметры.Заполнить(СтрокаРасшифровки);
		
		Если СтрокаРасшифровки.ВидПоказателя = Справочники.ВидыФинансовыхПоказателей.СтоимостьИнвестиционныхПортфелейКлиентовПоДоверительномуУправлениюПоСостояниюНаПоследнийКалендарныйДеньКвартала Тогда
			ОбластьСтрокаПериода.Параметры.ЗначениеПоказателя = Формат(СтрокаРасшифровки.ЗначениеПоказателя, "ЧДЦ=0; ЧС=3") + " Тыс. руб.";
		КонецЕсли;	
		
		ТабличныйДокумент.Вывести(ОбластьСтрокаПериода);
		
	КонецЦикла;	
	
	ОбластьЗаключение.Параметры.Заполнить(Результат);
	ТабличныйДокумент.Вывести(ОбластьЗаключение);
	
	// Включаем только просмотр для доступности расшифровки.
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	
	// Отключаем сетку.
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	
	
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаСервереБезКонтекста 
Функция ОтобразитьРасчетДоходностиСтратегииСНачалаГода(Организация, СубъектАналитики, Дата);
	
	Отказ = Ложь;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ДеталиРасчета = Документы.РегистрацияСтоимостиАктивов.РассчитатьДоходностьСтратегииСНачалаГода(Организация, СубъектАналитики, Дата, Истина, Отказ);
		
	МакетРасшифровка = Документы.РегистрацияСтоимостиАктивов.ПолучитьМакет("РасшифровкаДоходностиСтратегииСНачалаГода");
	
	Документы.РегистрацияСтоимостиАктивов.РасшифровкаСтрокФинПоказателей(ТабличныйДокумент, МакетРасшифровка, ДеталиРасчета.Расшифровка, "");
	
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаКлиенте
Процедура УстановитьТипЗначенияФинансовогоПоказателя() 
	
	ТекущиеДанные = Элементы.ФинансовыеПоказатели.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьТипЗначенияФинансовогоПоказателяНаСервере(ТекущиеДанные.ВидПоказателя);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТипЗначенияФинансовогоПоказателяНаСервере(ВидПоказателя) 
	
	Если ВидПоказателя = Справочники.ВидыФинансовыхПоказателей.КатегорияПрофессиональногоУчастникаРынкаЦенныхБумаг Тогда
		Элементы.ФинансовыеПоказателиЗначение.ОграничениеТипа = Новый ОписаниеТипов("ПеречислениеСсылка.КатегорииПрофессиональныхУчастниковРынкаЦенныхБумаг");
		
	ИначеЕсли ВидПоказателя = Справочники.ВидыФинансовыхПоказателей.КоличествоКлиентовПоДоговорамДоверительногоУправленияПоСостояниюНаПоследнийКалендарныйДеньКвартала Тогда
		Элементы.ФинансовыеПоказателиЗначение.ОграничениеТипа = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 0, ДопустимыйЗнак.Неотрицательный));
		
	Иначе
		Элементы.ФинансовыеПоказателиЗначение.ОграничениеТипа = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 2));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФинансовыеПоказателиВидПоказателяПриИзменении(Элемент)
	
	УстановитьТипЗначенияФинансовогоПоказателя();
	
КонецПроцедуры

&НаКлиенте
Процедура ФинансовыеПоказателиПередНачаломИзменения(Элемент, Отказ)
	
	УстановитьТипЗначенияФинансовогоПоказателя();
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаПоказателейПриИзменении(Элемент)

	Если Объект.ФинансовыеПоказатели.Количество() Тогда
		
		Если Вопрос("Табличная часть финансовые показатели будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
			ЭтаФорма.ГруппаПоказателей = ПолучитьГруппуПоказателей(Объект.СубъектАналитики);
			Возврат;
		КонецЕсли;
		
		Объект.ФинансовыеПоказатели.Очистить();
		
	КонецЕсли;	
	
	ЗаполнитьГруппыВидовФинансовыхПоказателей(ГруппыВидовФинансовыхПоказателей, ЭтаФорма.ГруппаПоказателей = "Организации");
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОткрытьПрисоединенныеФайлы()

	РаботаСФайловымХранилищемКлиент.ОткрытьПрисоединенныеФайлы(Объект.Ссылка);

КонецПроцедуры



