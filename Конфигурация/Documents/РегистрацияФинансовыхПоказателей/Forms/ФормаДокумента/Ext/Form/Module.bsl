#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма, , , Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ЭЛЕМЕНТОВ_ФОРМЫ

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура СубъектАналитикиПриИзменении(Элемент)
	Объект.ФинансовыеПоказатели.Очистить();
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_КОМАНД

&НаКлиенте
Процедура КомандаЗаполнитьФинансовыеПоказателиСтандартнойСтратегии(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.СубъектАналитики) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Стратегия"" не заполнено",, "Объект.СубъектАналитики");
		Возврат;
	КонецЕсли;
	
	Если МожноОчиститьФинансовыеПоказатели() Тогда
		Для каждого Элемент Из РассчитатьФинансовыеПоказателиСтандартнойСтратегии(Объект.Организация, Объект.СубъектАналитики, Объект.Дата) Цикл
			НоваяСтрокаФинансовыеПоказатели = Объект.ФинансовыеПоказатели.Добавить();
			НоваяСтрокаФинансовыеПоказатели.ВидПоказателя = Элемент.Ключ;
			НоваяСтрокаФинансовыеПоказатели.Значение      = Элемент.Значение;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыгрузитьПоказателиСтратегииДляСайтаДУИИС(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Фильтр         = "XML|*.xml";
	Диалог.ПолноеИмяФайла = СтрЗаменить(Строка(Объект.СубъектАналитики), " ", "_") + "_" + Формат(Объект.Дата, "ДФ=yyyy_MM") + ".xml";

	Если Не Диалог.Выбрать() Тогда
	    Возврат;
	КонецЕсли;

	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(Диалог.ПолноеИмяФайла, "UTF-8");
	
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ДоходностьПоСтратегии");
	ЗаписьXML.ЗаписатьАтрибут("Стратегия", Строка(Объект.СубъектАналитики));
	ЗаписьXML.ЗаписатьАтрибут("ДатаФормирования", "" + ТекущаяДата());
	ЗаписьXML.ЗаписатьАтрибут("Версия", "0.01");
	
	ЗарегистированныеФинансовыеПоказатели = ПолучитьЗарегистированныеФинансовыеПоказателиПоСтратегии(Объект.Дата, Объект.Организация, Объект.СубъектАналитики);
	
	Для каждого НаборПоказателей Из ЗарегистированныеФинансовыеПоказатели Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("ПоказателиЗаПериод");
				
		Для каждого ЭлементПоказатель Из НаборПоказателей Цикл
			ЗаписьXML.ЗаписатьАтрибут(ЭлементПоказатель.Ключ, ЭлементПоказатель.Значение);
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // ПоказателиЗаПериод
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // ДоходностьПоСтратегии
	ЗаписьXML.Закрыть();
	
	Сообщить("Файл " + Диалог.ПолноеИмяФайла + " успешно сохранен.");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтобразитьРасчет(Команда)
	
	ТекСтрока = Элементы.ФинансовыеПоказатели.ТекущиеДанные;
	Если ТекСтрока = Неопределено Тогда
		
		Возврат;
		
	ИначеЕсли ПолучитьПоказателиСтандартнойСтратегииДляВыгрузкиНаСайт().Найти(ТекСтрока.ВидПоказателя) <> Неопределено Тогда
	
		ДеталиРасчета = КомандаОтобразитьРасчетНаСервере(Объект.Организация, Объект.СубъектАналитики, Объект.Дата);
		ДеталиРасчета.Показать("Расчет финансовых показателей стандартной стратегии " + Объект.СубъектАналитики + " на " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy"));
		
	ИначеЕсли ТекСтрока.ВидПоказателя = ПредопределенноеЗначение("Справочник.ВидыФинансовыхПоказателей.КатегорияПрофессиональногоУчастникаРынкаЦенныхБумаг") Тогда
		
		ДеталиРасчета = ОтобразитьРасчетКатегорииПрофессиональногоУчастникаРынкаЦенныхБумагНаСервере(Объект.Организация, Объект.Дата);
		
		Если ДеталиРасчета <> Неопределено Тогда
			ДеталиРасчета.Показать("Расчет показателей деятельности и квартальные диапазоны  их значений");
		КонецЕсли;
		
	ИначеЕсли ТекСтрока.ВидПоказателя = ПредопределенноеЗначение("Справочник.ВидыФинансовыхПоказателей.ДоходностьСтратегииСНачалаГода") Тогда
		ДеталиРасчета = ОтобразитьРасчетДоходностиСтратегииСНачалаГода(Объект.Организация, Объект.СубъектАналитики, Объект.Дата);
		
		Если ДеталиРасчета <> Неопределено Тогда
			ДеталиРасчета.Показать("Расчет доходности стратегии с начала года");
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(ТекСТрока.ВидПоказателя) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для финансового показателя " + ТекСтрока.ВидПоказателя + " отображение расчета не поддерживается");
		
	Иначе 
			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран финансовый показатель");
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьКвартальныеПоказателиДеятельности(Команда)
	
	Если КонецДня(Объект.Дата) <> КонецКвартала(Объект.Дата) Тогда
		Предупреждение("Квартальные показатели деятельности заполняются только на конец квартала");
		Возврат;
	КонецЕсли;
	
	Если МожноОчиститьФинансовыеПоказатели() Тогда
		Для каждого Элемент Из РассчитатьКвартальныеПоказателиДеятельности(Объект.Организация, Объект.Дата) Цикл
			НоваяСтрокаФинансовыеПоказатели = Объект.ФинансовыеПоказатели.Добавить();
			НоваяСтрокаФинансовыеПоказатели.ВидПоказателя = Элемент.Ключ;
			НоваяСтрокаФинансовыеПоказатели.Значение      = Элемент.Значение;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьКатегориюПрофессиональногоУчастникаРынкаЦенныхБумаг(Команда)
	
	Если НачалоДня(Объект.Дата) <> НачалоГода(Объект.Дата) Тогда
		Предупреждение("Категория профессионального участника рынка ценных бумаг заполняется только на 1 января");
		Возврат;
	КонецЕсли;

	Если МожноОчиститьФинансовыеПоказатели() Тогда
		Для каждого Элемент Из РассчитатьКатегориюПрофессиональногоУчастникаРынкаЦенныхБумаг(Объект.Организация, Объект.Дата) Цикл
			НоваяСтрокаФинансовыеПоказатели = Объект.ФинансовыеПоказатели.Добавить();
			НоваяСтрокаФинансовыеПоказатели.ВидПоказателя = Элемент.Ключ;
			НоваяСтрокаФинансовыеПоказатели.Значение      = Элемент.Значение;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Функция МожноОчиститьФинансовыеПоказатели()
	
	Если Объект.ФинансовыеПоказатели.Количество() > 0 Тогда
		РезультатВопроса = Вопрос("Текущие финансовые показатели будут безвозвратно утеряны. Продолжить?", РежимДиалогаВопрос.ДаНет);
		Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
			Объект.ФинансовыеПоказатели.Очистить();
			ЭтаФорма.Модифицированность = Истина;
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		ЭтаФорма.Модифицированность = Истина;
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()

	ЭтаФорма.ГруппаПоказателей = ПолучитьГруппуПоказателей(Объект.СубъектАналитики);
	ЗаполнитьГруппыВидовФинансовыхПоказателей(ГруппыВидовФинансовыхПоказателей, ЭтаФорма.ГруппаПоказателей = "Организации");
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)

	ДанныеОбъекта = Форма.Объект;
	Элементы	  = Форма.Элементы;
	
	Элементы.СубъектАналитики.Видимость = НЕ (Форма.ГруппаПоказателей = "Организации");
	
	Элементы.ФинансовыеПоказателиКомандаЗаполнитьФинансовыеПоказателиСтандартнойСтратегии.Видимость 				= (Форма.ГруппаПоказателей = "СтратегииИндивидуальногоИнвестирования");
	Элементы.ФинансовыеПоказателиКомандаВыгрузитьПоказателиСтратегииДляСайтаДУИИС.Видимость 						= (Форма.ГруппаПоказателей = "СтратегииИндивидуальногоИнвестирования");
	Элементы.ФинансовыеПоказателиКомандаЗаполнитьКвартальныеПоказателиДеятельности.Видимость						= (Форма.ГруппаПоказателей = "Организации");
	Элементы.ФинансовыеПоказателиКомандаЗаполнитьКатегориюПрофессиональногоУчастникаРынкаЦенныхБумаг.Видимость		= (Форма.ГруппаПоказателей = "Организации");
	
	Если Форма.ГруппаПоказателей <> "Организации" И ЗначениеЗаполнено(Форма.ГруппаПоказателей) Тогда
		Элементы.СубъектАналитики.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка." + Форма.ГруппаПоказателей);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьГруппуПоказателей(СубъектАналитики)

	Если ЗначениеЗаполнено(СубъектАналитики) И ТипЗнч(СубъектАналитики) = Тип("СправочникСсылка.СтратегииИндивидуальногоИнвестирования") Тогда
		Возврат "СтратегииИндивидуальногоИнвестирования";
	Иначе
		Возврат "Организации";
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьГруппыВидовФинансовыхПоказателей(ГруппыВидовФинансовыхПоказателей, ПоказателиОрганизации)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВидыФинансовыхПоказателей.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ВидыФинансовыхПоказателей КАК ВидыФинансовыхПоказателей
		|ГДЕ
		|	ВидыФинансовыхПоказателей.ЭтоГруппа
		|	И &ПоказателиОрганизации = (ВидыФинансовыхПоказателей.Ссылка = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.ПоказателиДеятельностиОрганизации))";
	
	Запрос.УстановитьПараметр("ПоказателиОрганизации", ПоказателиОрганизации);
	
	ГруппыВидовФинансовыхПоказателей.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РассчитатьФинансовыеПоказателиСтандартнойСтратегии(Организация, Стратегия, ДатаРасчета) Экспорт
	
	Возврат Документы.РегистрацияФинансовыхПоказателей.РассчитатьФинансовыеПоказателиСтандартнойСтратегии(Организация, Стратегия, ДатаРасчета);
	
КонецФункции // РассчитатьФинансовыеПоказателиСтандартнойСтратегии

&НаСервереБезКонтекста
Функция РассчитатьКвартальныеПоказателиДеятельности(Организация, ДатаРасчета)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("Организация", Организация);
	ПараметрыРасчета.Вставить("Период",		 Новый СтандартныйПериод(НачалоКвартала(ДатаРасчета), КонецКвартала(ДатаРасчета)));

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	КвартальныеПоказателиДеятельности = Новый Соответствие;
	
	ТаблицаКвартальныхПоказателей = РаботаСОтчетностьюЦБ.ОКУД0420401_ПолучитьТаблицуКвартальныхПоказателей();
	Для Каждого КвартальныйПоказатель Из ТаблицаКвартальныхПоказателей Цикл
		Если КвартальныйПоказатель.ДатаНачала <= ДатаРасчета 
		  И (КвартальныйПоказатель.ДатаОкончания = Дата(1,1,1) ИЛИ КвартальныйПоказатель.ДатаОкончания >= ДатаРасчета) Тогда 
			КвартальныеПоказателиДеятельности.Вставить(КвартальныйПоказатель.ВидПоказателя, Вычислить("РаботаСОтчетностьюЦБ."  + КвартальныйПоказатель.Функция));
		КонецЕсли;
	КонецЦикла;
	
	Возврат КвартальныеПоказателиДеятельности;
	
КонецФункции

&НаСервереБезКонтекста
Функция РассчитатьКатегориюПрофессиональногоУчастникаРынкаЦенныхБумаг(Организация, ДатаРасчета)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("Организация", Организация);
	ПараметрыРасчета.Вставить("ДатаРасчета", ДатаРасчета);

	ГодовыеПоказателиДеятельности = Новый Соответствие;
	
	Результат = РаботаСОтчетностьюЦБ.ОКУД0420401_РассчитатьКатегориюПрофУчастникаНаОснованииКвартальныхПоказателей(ПараметрыРасчета, Ложь);
	Если Результат <> Неопределено Тогда
		ГодовыеПоказателиДеятельности.Вставить(Результат.ВидПоказателя, Результат.Значение);
	КонецЕсли;
	
	Возврат ГодовыеПоказателиДеятельности;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЗарегистированныеФинансовыеПоказателиПоСтратегии(Период, Организация, Стратегия)
	
	ФинансовыеПоказателиЗаПериоды = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказатели.Период КАК Период,
		|	ФинансовыеПоказатели.ВидПоказателя.ИмяПредопределенныхДанных КАК ИмяПоказателя,
		|	ФинансовыеПоказатели.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|ГДЕ
		|	ФинансовыеПоказатели.Период <= КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И ФинансовыеПоказатели.Организация = &Организация
		|	И ФинансовыеПоказатели.СубъектАналитики = &СубъектАналитики
		|	И КОНЕЦПЕРИОДА(ФинансовыеПоказатели.Период, ДЕНЬ) = КОНЕЦПЕРИОДА(ФинансовыеПоказатели.Период, МЕСЯЦ)
		|	И ФинансовыеПоказатели.ВидПоказателя В(&ПоказателиСтандартнойСтратегииДляВыгрузкиНаСайт)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период,
		|	ИмяПоказателя
		|ИТОГИ ПО
		|	Период";
		
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СубъектАналитики", Стратегия);
	Запрос.УстановитьПараметр("ПоказателиСтандартнойСтратегииДляВыгрузкиНаСайт", ПолучитьПоказателиСтандартнойСтратегииДляВыгрузкиНаСайт());
	
	ВыборкаПериод = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПериод.Следующий() Цикл
		
		ФинансовыеПоказателиЗаПериод = Новый Структура("Период", Формат(ВыборкаПериод.Период, "ДФ=dd.MM.yyyy"));
		
		Выборка = ВыборкаПериод.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ФинансовыеПоказателиЗаПериод.Вставить(СтрЗаменить(Выборка.ИмяПоказателя, "СтандартныеСтратегии_", ""), Строка(Выборка.Значение));
		КонецЦикла;
		
		ФинансовыеПоказателиЗаПериоды.Добавить(ФинансовыеПоказателиЗаПериод);
		
	КонецЦикла;
	
	Возврат ФинансовыеПоказателиЗаПериоды;
	
КонецФункции // ПолучитьЗарегистированныеФинансовыеПоказателиПоСтратегии

