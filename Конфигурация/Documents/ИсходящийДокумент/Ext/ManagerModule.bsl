		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лицензии КАК Лицензии
		|		ПО _ДанныеДокумента.ОрганизацияЮрФизЛицо = Лицензии.ЮрФизЛицо
		|			И (Лицензии.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ))
		|			И (Лицензии.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ Лицензии.ДатаОкончания >= _ДанныеДокумента.ДатаУведомления)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий.СрезПоследних(&Период, ) КАК СтатусыЛицензийСрезПоследних
		|		ПО (Лицензии.Ссылка = СтатусыЛицензийСрезПоследних.Лицензия)
		|			И (СтатусыЛицензийСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует))
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДанныеДокумента.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеДокумента.Ссылка КАК Ссылка,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.Телефоны КАК Телефоны,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ОГРН КАК ОГРН,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН,
		|	СотрудникиОрганизацииСрезПоследних.Должность.Наименование КАК ДолжностьРуководителя,
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.Фамилия + "" "" + РеквизитыСотрудниковОрганизацииСрезПоследних.Имя + "" "" + РеквизитыСотрудниковОрганизацииСрезПоследних.Отчество КАК ФИОРуководителя,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.EMail КАК EMail,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮридическийАдрес КАК ЮридическийАдрес,
		|	СправочникЛицензии.Номер КАК ЛицензияНомер,
		|	СправочникЛицензии.ДатаВыдачи КАК ЛицензияДатаВыдачи
		|ПОМЕСТИТЬ _ДанныеОрганизации
		|ИЗ
		|	_ДанныеДокумента КАК _ДанныеДокумента
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И ЮрФизЛицо = &ОрганизацияЮрФизЛицо) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДолжностныеЛицаОрганизаций.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И ВидДолжностногоЛица = ЗНАЧЕНИЕ(Перечисление.ВидыДолжностныхЛиц.Руководитель)
		|					И НЕ ИсполняющийОбязанности) КАК ДолжностныеЛицаОрганизацийСрезПоследних
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации.СрезПоследних(&Период, Организация = &Организация) КАК СотрудникиОрганизацииСрезПоследних
		|		ПО (ДолжностныеЛицаОрганизацийСрезПоследних.Сотрудник = СотрудникиОрганизацииСрезПоследних.Сотрудник)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыСотрудниковОрганизацииСрезПоследних
		|		ПО (ДолжностныеЛицаОрганизацийСрезПоследних.Сотрудник.ЮрФизЛицо = РеквизитыСотрудниковОрганизацииСрезПоследних.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Лицензии КАК _Лицензии
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лицензии КАК СправочникЛицензии
		|			ПО _Лицензии.Лицензия = СправочникЛицензии.Ссылка
		|		ПО _ДанныеДокумента.Ссылка = _Лицензии.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеОрганизации.Ссылка КАК Ссылка,
		|	_ДанныеОрганизации.ПолноеНаименованиеПоУставу КАК ПолнФирмНаим,
		|	_ДанныеОрганизации.ОГРН КАК ОГРН_1,
		|	_ДанныеОрганизации.ИНН КАК ИНН_1,
		|	_ДанныеОрганизации.ЛицензияНомер КАК НомерЛицензииКолИнвест,
		|	_ДанныеОрганизации.ЛицензияДатаВыдачи КАК ДатаПредостЛицензии
		|ПОМЕСТИТЬ _Раздел_СведенияОбУчастникеРынкаКолИнвест
		|ИЗ
		|	_ДанныеОрганизации КАК _ДанныеОрганизации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Клиенты.Ссылка КАК Ссылка,
		|	_Клиенты.ДатаУведомления КАК ДатаНачИспользЭДО,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу, """") КАК ПолнФирмНаимФИО,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицАнкетныеСрезПоследних.ОГРН, """") КАК ОГРН_2,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН, """") КАК ИНН_2,
		|	_ДанныеДокумента.Примечание КАК Примечание
		|ПОМЕСТИТЬ _Раздел_СведОНачИспользованияЭДО
		|ИЗ
		|	_ДанныеДокумента КАК _ДанныеДокумента
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Клиенты КАК _Клиенты
		|		ПО _ДанныеДокумента.Ссылка = _Клиенты.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И ЮрФизЛицо В
		|						(ВЫБРАТЬ
		|							_Клиенты.Клиент
		|						ИЗ
		|							_Клиенты КАК _Клиенты)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО (_Клиенты.Клиент = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеОрганизации.Ссылка КАК Ссылка,
		|	_ДанныеОрганизации.ДолжностьРуководителя КАК ДолжностьУполнЛица,
		|	_ДанныеОрганизации.ФИОРуководителя КАК ФИОУполнЛица,
		|	_ДанныеОрганизации.Телефоны КАК КонтактныйТелефонУполнЛица
		|ПОМЕСТИТЬ _ПодписьУполномоченногоЛица
		|ИЗ
		|	_ДанныеОрганизации КАК _ДанныеОрганизации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеДокумента.Ссылка КАК Ссылка,
		|	_ДанныеОрганизации.ПолноеНаименованиеПоУставу КАК ПолноеНаименование,
		|	_ДанныеОрганизации.КраткоеНаименованиеПоУставу КАК КраткоеНаименование,
		|	_ДанныеОрганизации.ФИОРуководителя КАК ФИОРуководителя,
		|	_ДанныеОрганизации.ИНН КАК ИНН,
		|	_ДанныеОрганизации.ОГРН КАК ОГРН,
		|	_ДанныеОрганизации.ЮридическийАдрес КАК АдресМестаНахождения,
		|	_ДанныеОрганизации.EMail КАК АдресЭП,
		|	_ДанныеОрганизации.Телефоны КАК КонтактныйТелефон,
		|	_ДанныеДокумента.НомерУведомления КАК НомерРегистрации,
		|	_ДанныеДокумента.ДатаУведомления КАК ДатаРегистрации,
		|	_ДанныеДокумента.КраткоеСодержаниеПисьма КАК КраткоеСодержаниеПисьма
		|ПОМЕСТИТЬ _СопроводительноеПисьмо
		|ИЗ
		|	_ДанныеДокумента КАК _ДанныеДокумента
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеОрганизации КАК _ДанныеОрганизации
		|		ПО _ДанныеДокумента.Ссылка = _ДанныеОрганизации.Ссылка";		
	#КонецОбласти
	
	РеквизитыИсходящегоДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИсходящийДокумент, "Дата, Организация");
	
	ОрганизацияЮрФизЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыИсходящегоДокумента.Организация, "ЮрФизЛицо");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ИсходящийДокумент);
	Запрос.УстановитьПараметр("Период", НачалоДня(РеквизитыИсходящегоДокумента.Дата));
	Запрос.УстановитьПараметр("Организация", РеквизитыИсходящегоДокумента.Организация);
	Запрос.УстановитьПараметр("ОрганизацияЮрФизЛицо", ОрганизацияЮрФизЛицо);
	
	Запрос.Выполнить();
	
	#Область Обработка_ошибок
	ТекстОшибки = "";
	
	ВыборкаДоговоры = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_Договоры").Выбрать();
	ВыборкаДоговоры.Следующий();
	
	Если ВыборкаДоговоры.Количество() > 1 Тогда
	
		ТекстОшибки = СтрШаблон("В документе %1 выбрано %2 правоустанавливающих документа.
			|Печать уведомления поддерживается только для одного договора.",
			ВыборкаДоговоры.Ссылка,
			ВыборкаДоговоры.Количество());
		
	ИначеЕсли Не ВыборкаДоговоры.ЭтоУведомлениеОбЭДО Тогда
		
		ТекстОшибки = СтрШаблон("В документе %1 в качестве правоустанавливающего документа выбран %2.
			|Допускается выбор только Договоров доверительного управления, Дполнительных соглашений и Соглашений об ЭДО.",
			ВыборкаДоговоры.Ссылка,
			ВыборкаДоговоры.Договор);
		
	КонецЕсли;
	
	ДанныеУведомления = Новый Структура;
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
	
		ДанныеУведомления.Вставить("ТекстОшибки", ТекстОшибки);
		ДанныеУведомления.Вставить("Ссылка", ИсходящийДокумент);
		Возврат ДанныеУведомления;
	
	КонецЕсли;
	#КонецОбласти
	
	ДанныеДокумента = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_ДанныеДокумента").Выгрузить();
	Раздел_СведОНачИспользованияЭДО = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_Раздел_СведОНачИспользованияЭДО").Выгрузить();
	Раздел_СведенияОбУчастникеРынкаКолИнвест = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_Раздел_СведенияОбУчастникеРынкаКолИнвест").Выгрузить();
	ПодписьУполномоченногоЛица = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_ПодписьУполномоченногоЛица").Выгрузить();
	СопроводительноеПисьмо = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_СопроводительноеПисьмо").Выгрузить();
	
	ДанныеУведомления.Вставить("ДанныеДокумента", РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(ДанныеДокумента[0]));
	ДанныеУведомления.Вставить("Раздел_СведОНачИспользованияЭДО", РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(Раздел_СведОНачИспользованияЭДО[0]));
	ДанныеУведомления.Вставить("Раздел_СведенияОбУчастникеРынкаКолИнвест", РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(Раздел_СведенияОбУчастникеРынкаКолИнвест[0]));
	ДанныеУведомления.Вставить("ПодписьУполномоченногоЛица", РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(ПодписьУполномоченногоЛица[0]));
	ДанныеУведомления.Вставить("СопроводительноеПисьмо", РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(СопроводительноеПисьмо[0]));
	
	Возврат ДанныеУведомления;
	
КонецФункции

Функция ПечатьСопроводительногоПисьмаОбИспользованииЭДО(ИсходящиеДокументы) Экспорт 
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.КлючПараметровПечати	= "ИспользованиеЭДО_СопроводительноеПисьмо";
	ТабличныйДокумент.ОтображатьСетку		= Ложь;
	ТабличныйДокумент.ОтображатьЗаголовки	= Ложь;
	ТабличныйДокумент.ТолькоПросмотр		= Истина;
	
	Если ИсходящиеДокументы.Количество() = 1 Тогда
		ТабличныйДокумент.ИспользуемоеИмяФайла = Строка(ИсходящиеДокументы[0]);
	Иначе
		ТабличныйДокумент.ИспользуемоеИмяФайла = "Исходящие документы";
	КонецЕсли;
	
	ПервыйДокумент = Истина;
	
	Макет = Обработки.ПечатьИсходящегоДокумента.ПолучитьМакет("МакетОтветНаОбращение");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьИсполнитель = Макет.ПолучитьОбласть("Исполнитель");
	
	Для каждого ИсходящийДокумент Из ИсходящиеДокументы Цикл
		
		ДанныеДляПечати = ПолучитьДанныеДляПечатиСопроводительногоПисьмаОбИспользованииЭДО(ИсходящийДокумент);
		
		Если ДанныеДляПечати.Свойство("ТекстОшибки") Тогда
		
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ДанныеДляПечати.ТекстОшибки, ДанныеДляПечати.Ссылка);
			Продолжить;
		
		КонецЕсли;
		
		Если ПервыйДокумент Тогда
			ПервыйДокумент = Ложь;
		Иначе
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(РаботаСОтчетами.ПолучитьШапкуОфициальногоБланкаОрганизации(ДанныеДляПечати.Организация, ДанныеДляПечати.ДатаДокумента));
		
		ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ДанныеДляПечати);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		ЗаполнитьЗначенияСвойств(ОбластьИсполнитель.Параметры, ДанныеДляПечати);
		ТабличныйДокумент.Вывести(ОбластьИсполнитель);
	
	КонецЦикла; 
	
	Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
		Возврат ТабличныйДокумент;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДанныеДляПечатиСопроводительногоПисьмаОбИспользованииЭДО(ИсходящийДокумент)

	#Область Текст_запроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходящийДокумент.Ссылка КАК Ссылка,
		|	ИсходящийДокумент.Номер КАК Номер,
