		|	"""" КАК ДобавочныйНомерИсполнителя
		|ИЗ
		|	_ДанныеДокумента КАК _ДанныеДокумента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеОрганизации КАК _ДанныеОрганизации
		|		ПО _ДанныеДокумента.Ссылка = _ДанныеОрганизации.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеКлиента КАК _ДанныеКлиента
		|		ПО _ДанныеДокумента.Ссылка = _ДанныеКлиента.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Договоры КАК _Договоры
		|		ПО _ДанныеДокумента.Ссылка = _Договоры.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСоглашенийОбЭДО.СрезПоследних(&Период, Организация = &Организация) КАК УсловияСоглашенийОбЭДОСрезПоследних
		|		ПО (_Договоры.Договор = УсловияСоглашенийОбЭДОСрезПоследних.Договор)
		|			И (НАЧАЛОПЕРИОДА(_ДанныеДокумента.Дата, ДЕНЬ) = УсловияСоглашенийОбЭДОСрезПоследних.ДатаНачалаИспользованияЭДО)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийСайтИС
		|		ПО (УсловияСоглашенийОбЭДОСрезПоследних.ИнформационнаяСистема = ЗначенияДополнительныхСведенийСайтИС.Объект)
		|			И (ЗначенияДополнительныхСведенийСайтИС.Свойство.Ключ = ""СайтИС"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийОператорЭДО
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|					&Период,
		|					Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|			ПО ЗначенияДополнительныхСведенийОператорЭДО.Значение = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ПО (УсловияСоглашенийОбЭДОСрезПоследних.ИнформационнаяСистема = ЗначенияДополнительныхСведенийОператорЭДО.Объект)
		|			И (ЗначенияДополнительныхСведенийОператорЭДО.Свойство.Ключ = ""ОператорЭДО"")";		
	#КонецОбласти
	
	РеквизитыИсходящегоДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИсходящийДокумент, "Дата, Организация");
	ОрганизацияЮрФизЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыИсходящегоДокумента.Организация, "ЮрФизЛицо");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ИсходящийДокумент);
	Запрос.УстановитьПараметр("Период", НачалоДня(РеквизитыИсходящегоДокумента.Дата));
	Запрос.УстановитьПараметр("Организация", РеквизитыИсходящегоДокумента.Организация);
	Запрос.УстановитьПараметр("ОрганизацияЮрФизЛицо", ОрганизацияЮрФизЛицо);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	#Область Обработка_ошибок
	ТекстОшибки = "";
	
	ВыборкаДоговоры = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_Договоры").Выбрать();
	ВыборкаДоговоры.Следующий();
	
	Если ВыборкаДоговоры.Количество() > 1 Тогда
	
		ТекстОшибки = СтрШаблон("В документе %1 выбрано %2 правоустанавливающих документа.
			|Печать уведомления поддерживается только для одного договора.",
			ВыборкаДоговоры.Ссылка,
			ВыборкаДоговоры.Количество());
		
	ИначеЕсли Не ЗначениеЗаполнено(ВыборкаДоговоры.ВидДоговора) Тогда
		
		Если ЗначениеЗаполнено(ВыборкаДоговоры.Договор) Тогда
			ПодстрокаОшибки = СтрШаблон("в качестве правоустанавливающего документа выбран '%1'.
				|Допускается выбор только Договоров доверительного управления, Дполнительных соглашений и Соглашений об ЭДО.",
				ВыборкаДоговоры.Договор);
		Иначе
			ПодстрокаОшибки = "не выбран правоустанавливающий документ";
		КонецЕсли;
		
		ТекстОшибки = СтрШаблон("В документе %1 %2.", ВыборкаДоговоры.Ссылка, ПодстрокаОшибки);
		
	КонецЕсли; 
	
	ДанныеДокумента = Новый Структура;
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
	
		ДанныеДокумента.Вставить("ТекстОшибки", ТекстОшибки);
		ДанныеДокумента.Вставить("Ссылка", ИсходящийДокумент);
		Возврат ДанныеДокумента;
	
	КонецЕсли;	
	#КонецОбласти
	
	ВыборкаЛицензии = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_Лицензии").Выбрать();
	Лицензии = Новый Массив;
	
	Пока ВыборкаЛицензии.Следующий() Цикл
	
		ВидДеятельности = НРег(ВыборкаЛицензии.ВидДеятельности);
		ВидДеятельности = СтрЗаменить(ВидДеятельности, "пиф", "паевыми инвестиционными фондами");
		ВидДеятельности = СтрЗаменить(ВидДеятельности, "нпф", "негосударственными пенсионными фондами");
		
		ПредставлениеЛицензии = СтрШаблон("лицензия №%1 от %2 %3",
			ВыборкаЛицензии.Номер,
			Формат(ВыборкаЛицензии.ДатаВыдачи, "ДФ='dd.MM.yyyy'' г.'''"),
			ВидДеятельности);
			
		Лицензии.Добавить(ПредставлениеЛицензии);
	
	КонецЦикла;
	
	ПредставлениеЛицензий = СтрСоединить(Лицензии, ", ");
	Положение = "пунктом 6 Положения о требованиях к осуществлению деятельности участников финансовых рынков при " +
		"использовании электронных документов, утвержденного Приказом ФСФР России № 05-77/пз-н от 08.12.2005 г.";
	
	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл
		
		// Вариант 1 - отдельное соглашение = "в соответствии с Соглашением об обмене электронными документами ?(Номер) от дд.мм.гггг г. с клиентом";
		// Вариант 2 - договор ДУ = "в соответствии с Договором доверительного управления №Номер от дд.мм.гггг. г. с клиентом";
		// Варинет 3 - допник к договору ДУ "в соответствии с Дополнительным соглашением ?(Номер) от дд.мм.гггг г. к договору Договору доверительного управления №Номер от дд.мм.гггг. г. с клиентом
		
		Если ПустаяСтрока(Выборка.НомерДоговора) Или НРег(Выборка.НомерДоговора) = "б/н" Тогда
			ПредставлениеДоговора = "";
		Иначе
			ПредставлениеДоговора = "№" + Выборка.НомерДоговора + " ";
		КонецЕсли;
		
		ПредставлениеДоговора = ПредставлениеДоговора + Формат(Выборка.ДатаДоговора, "ДФ='dd.MM.yyyy ''г.'''");
		
		Если Выборка.ВидДоговора = Перечисления.ВидыДоговоров.ДоверительногоУправления Тогда
		
			ПодстрокаДоговор = СтрШаблон("в соответствии с Договором доверительного управления №%1 от %2", 
				Выборка.НомерДоговораДУ, 
				Формат(Выборка.ДатаДоговораДУ, "ДФ='dd.MM.yyyy ''г.'''"));
			
		ИначеЕсли Выборка.ВидДоговора = Перечисления.ВидыДоговоров.ДополнительноеСоглашение Тогда
			
			ПодстрокаДоговор = СтрШаблон("в соответствии с Дополнительным соглашением %1 к Договору доверительного управления №%2 от %3", 
				ПредставлениеДоговора, 
				Выборка.НомерДоговораДУ, 
				Формат(Выборка.ДатаДоговораДУ, "ДФ='dd.MM.yyyy ''г.'''"));
			
		ИначеЕсли Выборка.ВидДоговора = Перечисления.ВидыДоговоров.СоглашениеОбЭДО Тогда
			
			ПодстрокаДоговор = СтрШаблон("в соответствии с Соглашением об обмене электронными документами %1", ПредставлениеДоговора);
			
		КонецЕсли;
			
		СодержаниеУведомления = Выборка.Содержание;
		Если СтрНачинаетсяС(СодержаниеУведомления, "компания уведомляет ") Тогда
			СодержаниеУведомления = Сред(СодержаниеУведомления, 10);
		КонецЕсли;
		
		ПредставлениеКлиента = СтрШаблон("%1 (%2%3%4%5%6)",
			Выборка.ПолноеНаименованиеПоУставу,
			Выборка.КраткоеНаименованиеПоУставу,
			?(ПустаяСтрока(Выборка.ОГРН), "", ", ОГРН: " + Выборка.ОГРН),
			?(ПустаяСтрока(Выборка.ОГРН), "", ", Дата присвоения ОГРН: " + Формат(Выборка.ДатаПрисвоенияОГРН, "ДФ=dd.MM.yyyy")),
			?(ПустаяСтрока(Выборка.ИНН), "", ", ИНН: " + Выборка.ИНН),
			?(ПустаяСтрока(Выборка.КПП), "", ", КПП: " + Выборка.КПП)
		);
		
		Содержание = СтрШаблон("В соответствии с %1, %2 (%3) %4 с клиентом:
			|
			|%5 %6
			|
			|Информация о порядке и условиях обмена электронными документами находится на официальной странице в сети Интернет %7 по адресу %8",
			ПроверитьЗаполнитьПустоеЗначение(Положение),
			ПроверитьЗаполнитьПустоеЗначение(Выборка.ПолноеНаименованиеОрганизации),
			ПроверитьЗаполнитьПустоеЗначение(ПредставлениеЛицензий),
			ПроверитьЗаполнитьПустоеЗначение(ПодстрокаДоговор),
			ПроверитьЗаполнитьПустоеЗначение(ПредставлениеКлиента),
			ПроверитьЗаполнитьПустоеЗначение(СодержаниеУведомления),
			ПроверитьЗаполнитьПустоеЗначение(Выборка.ПредставлениеОператораСЭД),
			ПроверитьЗаполнитьПустоеЗначение(Выборка.СайтСЭД));
			
		ДобавочныйНомер = ?(ПустаяСтрока(Выборка.ДобавочныйНомерИсполнителя), "", " тел. " + Выборка.ДобавочныйНомерИсполнителя);
			
		ДанныеДокумента = Новый Структура;
		
		ДанныеДокумента.Вставить("Организация", РеквизитыИсходящегоДокумента.Организация);
		ДанныеДокумента.Вставить("Дата", Формат(Выборка.Дата, "ДФ='dd.MM.yyyy'' г.'''"));
		ДанныеДокумента.Вставить("Номер", Выборка.Номер);
		ДанныеДокумента.Вставить("ДатаДокумента", Выборка.Дата);
		ДанныеДокумента.Вставить("Получатель", Выборка.Получатель);
		ДанныеДокумента.Вставить("Содержание", Содержание);
		ДанныеДокумента.Вставить("ТелефонИсполнителя", Выборка.ТелефонОрганизации + ДобавочныйНомер);
		ДанныеДокумента.Вставить("Должность", Выборка.ДолжностьРуководителя);
		ДанныеДокумента.Вставить("Подписал", Выборка.ФИОРуководителя);
		ДанныеДокумента.Вставить("Исполнитель", Выборка.ФИОКонтролера);
			
	КонецЦикла;
	
	Возврат ДанныеДокумента;

КонецФункции

Функция ПолучитьОбъектXDTO(Фабрика, Владелец, Имя, ЗначениеСвойства = "")
	
	Если ТипЗнч(Владелец) = Тип("ПакетXDTO") Тогда
        СвойствоXDTO = Владелец.КорневыеСвойства.Получить(Имя);
    Иначе
        СвойствоXDTO = Владелец.Свойства.Получить(Имя);
    КонецЕсли;    
	
	ТипXDTO = СвойствоXDTO.Тип;
	
	Если ТипЗнч(ТипXDTO) = Тип("ТипЗначенияXDTO") Тогда
        ОбъектXDTO = Фабрика.Создать(ТипXDTO, ЗначениеСвойства);
    Иначе
        ОбъектXDTO = Фабрика.Создать(ТипXDTO);
    КонецЕсли;    
	
	Возврат ОбъектXDTO;
	
КонецФункции

Функция ПроверитьЗаполнитьПустоеЗначение(Значение)

	Возврат ?(ПустаяСтрока(Значение), "_________________", Значение);

КонецФункции

#КонецОбласти

#Область УведомлениеИнсайдеру
	
Функция СформироватьУведомлениеИнсайдеру(Ссылка) Экспорт
	
#Область Контроли

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран исходящий документ");
		Возврат Неопределено;
	КонецЕсли;
	
	Если Ссылка.ТипИсходящегоДокумента <> Перечисления.ТипыИсходящихДокументов.УведомлениеОВключенииИнсайдераВСписок
	   И Ссылка.ТипИсходящегоДокумента <> Перечисления.ТипыИсходящихДокументов.УведомлениеОбИсключенииИнсайдераИзСписка
	   И Ссылка.ТипИсходящегоДокумента <> Перечисления.ТипыИсходящихДокументов.ИноеУведомлениеИнсайдеру Тогда
	   ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Печать уведомления инсайдеру на основании типа исходящего документа '%1' не предусмотрено", Ссылка.ТипИсходящегоДокумента));
	   Возврат Неопределено;
	КонецЕсли;
	
	Основание = Неопределено;
	Если Ссылка.Основания.Количество() > 0 Тогда
		Основание = Ссылка.Основания[0].Основание;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В исходящем документе не указан документ основание");
	   Возврат Неопределено;
	
	ИначеЕсли ТипЗнч(Основание) <> Тип("ДокументСсылка.ВнесениеИзмененийВоВнутреннийПеречень") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Печать уведомления инсайдеру на основании документа '%1' не предусмотрено. В основании должен быть документ вида 'Внесение изменений во внутренний перечень'", Ссылка.Основания[0].Основание));	 
	   Возврат Неопределено;
	   
	ИначеЕсли НЕ Основание.Проведен Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Документ %1 не проведён", Основание), Основание);
		Возврат Неопределено;
		
	КонецЕсли;
	
#КонецОбласти	
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ИсходящийДокумент",		 	Ссылка);
	Запрос.УстановитьПараметр("ДатаИсходящегоДокумента",	Ссылка.Дата);
	Запрос.УстановитьПараметр("ДатаВнесенияИзменений",		Основание.Дата);
	Запрос.УстановитьПараметр("ПереносСтроки",				Символы.ПС);
	
#Область ТекстЗапроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходящийДокументОснования.Ссылка КАК ИсходящийДокумент,
		|	ИсходящийДокументОснования.Основание КАК Основание,
		|	ВнесениеИзмененийВоВнутреннийПеречень.Ссылка КАК ВнесениеИзмененийВоВнутреннийПеречень,
		|	ВнесениеИзмененийВоВнутреннийПеречень.Организация КАК Организация,
		|	ВнесениеИзмененийВоВнутреннийПеречень.ВидПеречня КАК ВидПеречня,
		|	ВнесениеИзмененийВоВнутреннийПеречень.Объект КАК Объект,
		|	ВнесениеИзмененийВоВнутреннийПеречень.ОбъектИнсайдерскойИнформации КАК ОбъектИнсайдерскойИнформации,
		|	МАКСИМУМ(ВнесениеИзмененийВоВнутреннийПереченьОснования.Сотрудник) КАК Сотрудник,
		|	ИсходящийДокументОснования.Ссылка.ТипИсходящегоДокумента КАК ТипИсходящегоДокумента,
		|	ВнесениеИзмененийВоВнутреннийПеречень.ВидИзменения КАК ВидИзменения,
		|	ВнутренниеПеречниСрезПоследних.Период КАК ДатаВключенияИсключения,
		|	ВнесениеИзмененийВоВнутреннийПеречень.Проведен КАК ВнесениеИзмененийВоВнутреннийПереченьПроведен
		|ПОМЕСТИТЬ _Уведомление
		|ИЗ
		|	Документ.ИсходящийДокумент.Основания КАК ИсходящийДокументОснования
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВнесениеИзмененийВоВнутреннийПеречень КАК ВнесениеИзмененийВоВнутреннийПеречень
		|		ПО ИсходящийДокументОснования.Основание = ВнесениеИзмененийВоВнутреннийПеречень.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВнесениеИзмененийВоВнутреннийПеречень.Основания КАК ВнесениеИзмененийВоВнутреннийПереченьОснования
		|		ПО ИсходящийДокументОснования.Основание = ВнесениеИзмененийВоВнутреннийПереченьОснования.Ссылка
