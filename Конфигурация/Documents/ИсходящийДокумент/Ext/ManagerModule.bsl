
#Область Ответ_на_обращение

Функция ПодготовитьДанныеДляПечатиОтветаНаОбращение(Ссылка, Отказ)

	ДанныеДляПечати = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходящийДокумент.Ссылка КАК Ссылка,
		|	ИсходящийДокумент.Номер КАК Номер,
		|	ИсходящийДокумент.Дата КАК Дата,
		|	ИсходящийДокумент.Организация КАК Организация,
		|	ИсходящийДокумент.Получатель КАК Получатель,
		|	ИсходящийДокумент.ПолПолучателя КАК ПолПолучателя,
		|	ИсходящийДокумент.Подписал КАК Подписал,
		|	НАЧАЛОПЕРИОДА(ИсходящийДокумент.Дата, ДЕНЬ) КАК НачалоДняДата,
		|	Организации.ЮрФизЛицо КАК ОрганизацияЮрФизЛицо,
		|	ИсходящийДокумент.Содержание КАК Содержание
		|ПОМЕСТИТЬ _ИсходящиеДокументы
		|ИЗ
		|	Документ.ИсходящийДокумент КАК ИсходящийДокумент
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО ИсходящийДокумент.Организация = Организации.Ссылка
		|ГДЕ
		|	ИсходящийДокумент.Ссылка В(&Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходящиеДокументы.Ссылка КАК Ссылка,
		|	_ИсходящиеДокументы.Номер КАК Номер,
		|	_ИсходящиеДокументы.Дата КАК Дата,
		|	ВЫБОР
		|		КОГДА ДатыРеквизитовЮрЛиц.ЯвляетсяКлиентом
		|				И _ИсходящиеДокументы.Получатель.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
		|			ТОГДА РеквизитыПолучателяЮрЛицаАнкетные.КраткоеНаименованиеПоУставу
		|		КОГДА _ИсходящиеДокументы.Получатель.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
		|			ТОГДА РеквизитыПолучателяЮрЛица.КраткоеНаименованиеПоУставу
		|		КОГДА ДатыРеквизитовЮрЛиц.ЯвляетсяКлиентом
		|				И _ИсходящиеДокументы.Получатель.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|				И РеквизитыПолучателяФизЛицаАнкетные.Пол = ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Мужской)
		|			ТОГДА ""Г-н "" + РеквизитыПолучателяФизЛицаАнкетные.Фамилия + "" "" + РеквизитыПолучателяФизЛицаАнкетные.Имя + "" "" + РеквизитыПолучателяФизЛицаАнкетные.Отчество
		|		КОГДА ДатыРеквизитовЮрЛиц.ЯвляетсяКлиентом
		|				И _ИсходящиеДокументы.Получатель.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|				И РеквизитыПолучателяФизЛицаАнкетные.Пол = ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Женский)
		|			ТОГДА ""Г-жа "" + РеквизитыПолучателяФизЛицаАнкетные.Фамилия + "" "" + РеквизитыПолучателяФизЛицаАнкетные.Имя + "" "" + РеквизитыПолучателяФизЛицаАнкетные.Отчество
		|		КОГДА ДатыРеквизитовЮрЛиц.ЯвляетсяКлиентом
		|				И _ИсходящиеДокументы.Получатель.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|			ТОГДА РеквизитыПолучателяФизЛицаАнкетные.Фамилия + "" "" + РеквизитыПолучателяФизЛицаАнкетные.Имя + "" "" + РеквизитыПолучателяФизЛицаАнкетные.Отчество
		|		КОГДА _ИсходящиеДокументы.Получатель.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|				И РеквизитыСотрудниковОрганизацииПолучатель.Пол = ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Мужской)
		|			ТОГДА ""Г-н "" + РеквизитыСотрудниковОрганизацииПолучатель.Фамилия + "" "" + РеквизитыСотрудниковОрганизацииПолучатель.Имя + "" "" + РеквизитыСотрудниковОрганизацииПолучатель.Отчество
		|		КОГДА _ИсходящиеДокументы.Получатель.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|				И РеквизитыСотрудниковОрганизацииПолучатель.Пол = ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Женский)
		|			ТОГДА ""Г-жа "" + РеквизитыСотрудниковОрганизацииПолучатель.Фамилия + "" "" + РеквизитыСотрудниковОрганизацииПолучатель.Имя + "" "" + РеквизитыСотрудниковОрганизацииПолучатель.Отчество
		|		КОГДА ТИПЗНАЧЕНИЯ(_ИсходящиеДокументы.Получатель) = ТИП(СТРОКА)
		|				И _ИсходящиеДокументы.ПолПолучателя = ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Мужской)
		|			ТОГДА ""Г-н "" + (ВЫРАЗИТЬ(_ИсходящиеДокументы.Получатель КАК СТРОКА(250)))
		|		КОГДА ТИПЗНАЧЕНИЯ(_ИсходящиеДокументы.Получатель) = ТИП(СТРОКА)
		|				И _ИсходящиеДокументы.ПолПолучателя = ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Женский)
		|			ТОГДА ""Г-жа "" + (ВЫРАЗИТЬ(_ИсходящиеДокументы.Получатель КАК СТРОКА(250)))
		|	КОНЕЦ КАК НаименованиеПолучателя,
		|	_ИсходящиеДокументы.Получатель КАК Получатель,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ИсходящиеДокументы.Получатель) = ТИП(СТРОКА)
		|			ТОГДА _ИсходящиеДокументы.ПолПолучателя
		|		ИНАЧЕ ЕСТЬNULL(РеквизитыСотрудниковОрганизацииПолучатель.Пол, РеквизитыПолучателяФизЛицаАнкетные.Пол)
		|	КОНЕЦ КАК ПолПолучателя,
		|	КонтактныеЛица.Должность КАК Должность,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ИсходящиеДокументы.Подписал) = ТИП(СТРОКА)
		|			ТОГДА _ИсходящиеДокументы.Подписал
		|		ИНАЧЕ ЕСТЬNULL(РеквизитыФизическихЛицАнкетные.Фамилия + "" "" + (ВЫРАЗИТЬ(РеквизитыФизическихЛицАнкетные.Имя КАК СТРОКА(1))) + "". "" + (ВЫРАЗИТЬ(РеквизитыФизическихЛицАнкетные.Отчество КАК СТРОКА(1))) + ""."", РеквизитыСотрудниковОрганизации.Фамилия + "" "" + (ВЫРАЗИТЬ(РеквизитыСотрудниковОрганизации.Имя КАК СТРОКА(1))) + "". "" + (ВЫРАЗИТЬ(РеквизитыСотрудниковОрганизации.Отчество КАК СТРОКА(1))) + ""."")
		|	КОНЕЦ КАК Подписал,
		|	_ИсходящиеДокументы.Организация КАК Организация,
		|	ВЫБОР
		|		КОГДА ДатыРеквизитовЮрЛиц.ЯвляетсяКлиентом
		|				И _ИсходящиеДокументы.Получатель.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
		|				И РеквизитыПолучателяЮрЛицаАнкетные.Регистратор ЕСТЬ NULL
		|			ТОГДА ""Получатель является клиентом. Не заполнена анкета юридического лица""
		|		КОГДА ДатыРеквизитовЮрЛиц.ЯвляетсяКлиентом
		|				И _ИсходящиеДокументы.Получатель.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|				И РеквизитыПолучателяФизЛицаАнкетные.Регистратор ЕСТЬ NULL
		|			ТОГДА ""Получатель является клиентом. Не заполнена анкета Физического лица.""
		|	КОНЕЦ КАК СообщениеОбОшибке,
		|	_ИсходящиеДокументы.Содержание КАК Содержание
		|ИЗ
		|	_ИсходящиеДокументы КАК _ИсходящиеДокументы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|		ПО (КонтактныеЛица.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|			И (КонтактныеЛица.Объект = _ИсходящиеДокументы.ОрганизацияЮрФизЛицо)
		|			И (КонтактныеЛица.КонтактноеЛицо = _ИсходящиеДокументы.Подписал)
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_ИсходящиеДокументы.НачалоДняДата КАК НачалоДняДата,
		|			_ИсходящиеДокументы.ОрганизацияЮрФизЛицо КАК ОрганизацияЮрФизЛицо,
		|			_ИсходящиеДокументы.Получатель КАК Получатель,
		|			МАКСИМУМ(КлиентыДоверительногоУправления.Период) ЕСТЬ НЕ NULL  КАК ЯвляетсяКлиентом,
		|			МАКСИМУМ(РеквизитыПолучателяЮрЛицаАнкетные.Период) КАК ПериодПолучателяЮрЛицаАнкетные,
		|			МАКСИМУМ(РеквизитыПолучателяЮрЛица.Период) КАК ПериодПолучателяЮрЛица,
		|			МАКСИМУМ(РеквизитыПолучателяФизЛицаАнкетные.Период) КАК ПериодПолучателяФизЛицаАнкетные,
		|			МАКСИМУМ(РеквизитыСотрудниковОрганизацииПолучатель.Период) КАК ПериодПолучателяСотрОрг
		|		ИЗ
		|			_ИсходящиеДокументы КАК _ИсходящиеДокументы
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
		|				ПО _ИсходящиеДокументы.Получатель = КлиентыДоверительногоУправления.Клиент
		|					И _ИсходящиеДокументы.НачалоДняДата >= КлиентыДоверительногоУправления.Период
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные КАК РеквизитыПолучателяЮрЛицаАнкетные
		|				ПО (РеквизитыПолучателяЮрЛицаАнкетные.Активность)
		|					И _ИсходящиеДокументы.Организация = РеквизитыПолучателяЮрЛицаАнкетные.Организация
		|					И _ИсходящиеДокументы.Получатель = РеквизитыПолучателяЮрЛицаАнкетные.ЮрФизЛицо
		|					И (РеквизитыПолучателяЮрЛицаАнкетные.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|					И _ИсходящиеДокументы.НачалоДняДата >= РеквизитыПолучателяЮрЛицаАнкетные.Период
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц КАК РеквизитыПолучателяЮрЛица
		|				ПО (РеквизитыПолучателяЮрЛица.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|					И _ИсходящиеДокументы.Получатель = РеквизитыПолучателяЮрЛица.ЮрФизЛицо
		|					И (РеквизитыПолучателяЮрЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|					И _ИсходящиеДокументы.НачалоДняДата >= РеквизитыПолучателяЮрЛица.Период
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные КАК РеквизитыПолучателяФизЛицаАнкетные
		|				ПО (РеквизитыПолучателяФизЛицаАнкетные.Активность)
		|					И _ИсходящиеДокументы.Организация = РеквизитыПолучателяФизЛицаАнкетные.Организация
		|					И _ИсходящиеДокументы.Получатель = РеквизитыПолучателяФизЛицаАнкетные.ЮрФизЛицо
		|					И (РеквизитыПолучателяФизЛицаАнкетные.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|					И _ИсходящиеДокументы.НачалоДняДата >= РеквизитыПолучателяФизЛицаАнкетные.Период
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации КАК РеквизитыСотрудниковОрганизацииПолучатель
		|				ПО _ИсходящиеДокументы.Организация = РеквизитыСотрудниковОрганизацииПолучатель.Организация
		|					И _ИсходящиеДокументы.Получатель = РеквизитыСотрудниковОрганизацииПолучатель.ЮрФизЛицо
		|					И (РеквизитыСотрудниковОрганизацииПолучатель.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|					И _ИсходящиеДокументы.НачалоДняДата >= РеквизитыСотрудниковОрганизацииПолучатель.Период
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_ИсходящиеДокументы.НачалоДняДата,
		|			_ИсходящиеДокументы.ОрганизацияЮрФизЛицо,
		|			_ИсходящиеДокументы.Получатель) КАК ДатыРеквизитовЮрЛиц
		|		ПО _ИсходящиеДокументы.НачалоДняДата = ДатыРеквизитовЮрЛиц.НачалоДняДата
		|			И _ИсходящиеДокументы.ОрганизацияЮрФизЛицо = ДатыРеквизитовЮрЛиц.ОрганизацияЮрФизЛицо
		|			И _ИсходящиеДокументы.Получатель = ДатыРеквизитовЮрЛиц.Получатель
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные КАК РеквизитыПолучателяЮрЛицаАнкетные
		|		ПО (РеквизитыПолучателяЮрЛицаАнкетные.Активность)
		|			И _ИсходящиеДокументы.Организация = РеквизитыПолучателяЮрЛицаАнкетные.Организация
		|			И _ИсходящиеДокументы.Получатель = РеквизитыПолучателяЮрЛицаАнкетные.ЮрФизЛицо
		|			И (РеквизитыПолучателяЮрЛицаАнкетные.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|			И (ДатыРеквизитовЮрЛиц.ПериодПолучателяЮрЛицаАнкетные = РеквизитыПолучателяЮрЛицаАнкетные.Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц КАК РеквизитыПолучателяЮрЛица
		|		ПО (РеквизитыПолучателяЮрЛица.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И _ИсходящиеДокументы.Получатель = РеквизитыПолучателяЮрЛица.ЮрФизЛицо
		|			И (РеквизитыПолучателяЮрЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|			И (ДатыРеквизитовЮрЛиц.ПериодПолучателяЮрЛица = РеквизитыПолучателяЮрЛица.Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные КАК РеквизитыПолучателяФизЛицаАнкетные
		|		ПО (РеквизитыПолучателяФизЛицаАнкетные.Активность)
		|			И _ИсходящиеДокументы.Организация = РеквизитыПолучателяФизЛицаАнкетные.Организация
		|			И _ИсходящиеДокументы.Получатель = РеквизитыПолучателяФизЛицаАнкетные.ЮрФизЛицо
		|			И (РеквизитыПолучателяФизЛицаАнкетные.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|			И (ДатыРеквизитовЮрЛиц.ПериодПолучателяФизЛицаАнкетные = РеквизитыПолучателяФизЛицаАнкетные.Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации КАК РеквизитыСотрудниковОрганизацииПолучатель
		|		ПО _ИсходящиеДокументы.Организация = РеквизитыСотрудниковОрганизацииПолучатель.Организация
		|			И _ИсходящиеДокументы.Получатель = РеквизитыСотрудниковОрганизацииПолучатель.ЮрФизЛицо
		|			И (РеквизитыСотрудниковОрганизацииПолучатель.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|			И (ДатыРеквизитовЮрЛиц.ПериодПолучателяСотрОрг = РеквизитыСотрудниковОрганизацииПолучатель.Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			МАКСИМУМ(РеквизитыФизическихЛицАнкетные.Период) КАК ПериодРеквизитовПодписанта,
		|			_ИсходящиеДокументы.Подписал КАК Подписал,
		|			_ИсходящиеДокументы.НачалоДняДата КАК НачалоДняДата
		|		ИЗ
		|			_ИсходящиеДокументы КАК _ИсходящиеДокументы
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные КАК РеквизитыФизическихЛицАнкетные
		|				ПО (РеквизитыФизическихЛицАнкетные.Организация = _ИсходящиеДокументы.Организация)
		|					И (РеквизитыФизическихЛицАнкетные.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|					И _ИсходящиеДокументы.Подписал = РеквизитыФизическихЛицАнкетные.ЮрФизЛицо
		|					И _ИсходящиеДокументы.НачалоДняДата >= РеквизитыФизическихЛицАнкетные.Период
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_ИсходящиеДокументы.Подписал,
		|			_ИсходящиеДокументы.НачалоДняДата) КАК ДатыРеквизитовПодписантов
		|		ПО _ИсходящиеДокументы.Подписал = ДатыРеквизитовПодписантов.Подписал
		|			И _ИсходящиеДокументы.НачалоДняДата = ДатыРеквизитовПодписантов.НачалоДняДата
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации КАК РеквизитыСотрудниковОрганизации
		|		ПО _ИсходящиеДокументы.Подписал = РеквизитыСотрудниковОрганизации.ЮрФизЛицо
		|			И (ДатыРеквизитовПодписантов.ПериодРеквизитовПодписанта = РеквизитыСотрудниковОрганизации.Период)
		|			И (РеквизитыСотрудниковОрганизации.Организация = _ИсходящиеДокументы.Организация)
		|			И (РеквизитыСотрудниковОрганизации.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные КАК РеквизитыФизическихЛицАнкетные
		|		ПО _ИсходящиеДокументы.Подписал = РеквизитыФизическихЛицАнкетные.ЮрФизЛицо
		|			И (ДатыРеквизитовПодписантов.ПериодРеквизитовПодписанта = РеквизитыФизическихЛицАнкетные.Период)
		|			И (РеквизитыФизическихЛицАнкетные.Организация = _ИсходящиеДокументы.Организация)
		|			И (РеквизитыФизическихЛицАнкетные.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата,
		|	Номер";		
	#КонецОбласти 
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос.МенеджерВременныхТаблиц = МВТ;
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.СообщениеОбОшибке) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Выборка.СообщениеОбОшибке + ": " + Выборка.Ссылка, Выборка.Ссылка,,, Отказ);
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Выборка.Получатель) = Тип("Строка") И Не ЗначениеЗаполнено(Выборка.ПолПолучателя) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите пол получателя для исходящего документа (получатель указан строкой): " + Выборка.Ссылка, Выборка.Ссылка,,, Отказ);
			Продолжить;
		КонецЕсли;
		
		РеквизитыДокумента = Новый Структура;
		
		РеквизитыДокумента.Вставить("Номер", 		Выборка.Номер);
		РеквизитыДокумента.Вставить("Дата", 		Формат(Выборка.Дата, "ДФ=dd.MM.yyyy"));
		РеквизитыДокумента.Вставить("Получатель", 	Выборка.НаименованиеПолучателя);
		РеквизитыДокумента.Вставить("ПолПолучателя",Выборка.ПолПолучателя);
		РеквизитыДокумента.Вставить("Содержание", 	Выборка.Содержание); 
		
		РеквизитыДокумента.Вставить("Должность", 	Выборка.Должность);
		РеквизитыДокумента.Вставить("Подписал", 	Выборка.Подписал);
		
		РеквизитыДокумента.Вставить("ДатаБланка", 	Выборка.Дата);
		РеквизитыДокумента.Вставить("Организация",	Выборка.Организация);
		
		ДанныеДляПечати.Добавить(РеквизитыДокумента);
	
	КонецЦикла; 
	
	Возврат ДанныеДляПечати;
	
КонецФункции

Функция ПечатьОтветаНаОбращение(Ссылка) Экспорт

	Отказ = Ложь;
	
	ДанныеДляПечати = ПодготовитьДанныеДляПечатиОтветаНаОбращение(Ссылка, Отказ);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.КлючПараметровПечати	= "ОтветНаОбращение";
	ТабличныйДокумент.ОтображатьСетку		= Ложь;
	ТабличныйДокумент.ОтображатьЗаголовки	= Ложь;
	ТабличныйДокумент.ТолькоПросмотр		= Истина;
	
	Если Ссылка.Количество() = 1 Тогда
		ТабличныйДокумент.ИспользуемоеИмяФайла = Строка(Ссылка[0]);
	Иначе
		ТабличныйДокумент.ИспользуемоеИмяФайла = "Исходящие документы";
	КонецЕсли;
	
	ПервыйДокумент = Истина;
	
	Макет = Обработки.ПечатьИсходящегоДокумента.ПолучитьМакет("МакетОтветНаОбращение");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	Для каждого РеквизитыДокумента Из ДанныеДляПечати Цикл
		
		Если ПервыйДокумент Тогда
			ПервыйДокумент = Ложь;
		Иначе
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(РаботаСОтчетами.ПолучитьШапкуОфициальногоБланкаОрганизации(РеквизитыДокумента.Организация, РеквизитыДокумента.ДатаБланка));
		
		ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, РеквизитыДокумента);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
	КонецЦикла; 
	
	Если ДанныеДляПечати.Количество() И Не Отказ Тогда
		Возврат ТабличныйДокумент;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

#КонецОбласти 

#Область Использование_ЭДО

Функция ПечатьУведомленияОбИспользованииЭДО(ИсходящиеДокументы) Экспорт

	#Область Создание_фабрики_XDTO

	Макет = Обработки.ПечатьИсходящегоДокумента.ПолучитьМакет("Схема_YVED_NACH");
				
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xsd");
	Макет.Записать(ИмяВременногоФайла);
	
	Фабрика = СоздатьФабрикуXDTO(ИмяВременногоФайла);
	
	УдалитьФайлы(ИмяВременногоФайла);
		
	#КонецОбласти
	
	ПакетXDTO = Фабрика.Пакеты.Получить("http://www.it.ru/Schemas/Avior/УРКИ");
	Результат = Новый Массив;
		
	Для каждого ИсходящийДокумент Из ИсходящиеДокументы Цикл
		
		ДанныеУведомления = ПолучитьДанныеДляПечатиУведомленияОбИспользованииЭДО(ИсходящийДокумент);
	
		Если ДанныеУведомления.Свойство("ТекстОшибки") Тогда
		
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ДанныеУведомления.ТекстОшибки, ДанныеУведомления.Ссылка);
			Продолжить;
		
		КонецЕсли;
		
		#Область Заполнение_объекта_XDTO
		
		УведомлениеОбъект = ПолучитьОбъектXDTO(Фабрика, ПакетXDTO, "УведомлениеОНачалеИспользованияЭлектронныхДокументов");
	
		УведомлениеОбъект.Раздел_СведенияОбУчастникеРынкаКолИнвест = ПолучитьОбъектXDTO(
			Фабрика, 
			УведомлениеОбъект.Тип(), 
			"Раздел_СведенияОбУчастникеРынкаКолИнвест");
		УведомлениеОбъект.Раздел_СведенияОбУчастникеРынкаКолИнвест.ВидУчастника = ПолучитьОбъектXDTO(
			Фабрика, 
			УведомлениеОбъект.Раздел_СведенияОбУчастникеРынкаКолИнвест.Тип(), 
			"ВидУчастника");
		УведомлениеОбъект.Раздел_СведенияОбУчастникеРынкаКолИнвест.ВидУчастника.Код = "УК";
		УведомлениеОбъект.Раздел_СведенияОбУчастникеРынкаКолИнвест.ВидУчастника.Описание = "Управляющая компания";
		УведомлениеОбъект.Раздел_СведенияОбУчастникеРынкаКолИнвест.ВидУчастника.Активно = "true";
		ЗаполнитьЗначенияСвойств(УведомлениеОбъект.Раздел_СведенияОбУчастникеРынкаКолИнвест, ДанныеУведомления.Раздел_СведенияОбУчастникеРынкаКолИнвест);
		
		УведомлениеОбъект.Раздел_СведОНачИспользованияЭДО = ПолучитьОбъектXDTO(Фабрика, УведомлениеОбъект.Тип(), "Раздел_СведОНачИспользованияЭДО");
		ЗаполнитьЗначенияСвойств(УведомлениеОбъект.Раздел_СведОНачИспользованияЭДО, ДанныеУведомления.Раздел_СведОНачИспользованияЭДО);
		
		УведомлениеОбъект.ПодписьУполномоченногоЛица = ПолучитьОбъектXDTO(Фабрика, УведомлениеОбъект.Тип(), "ПодписьУполномоченногоЛица");
		ЗаполнитьЗначенияСвойств(УведомлениеОбъект.ПодписьУполномоченногоЛица, ДанныеУведомления.ПодписьУполномоченногоЛица);
		
		УведомлениеОбъект.СопроводительноеПисьмо = ПолучитьОбъектXDTO(Фабрика, УведомлениеОбъект.Тип(), "СопроводительноеПисьмо");
		ЗаполнитьЗначенияСвойств(УведомлениеОбъект.СопроводительноеПисьмо, ДанныеУведомления.СопроводительноеПисьмо);
					
		#КонецОбласти
		
		#Область Формирование_XML
		
		ЗаписьXML = Новый ЗаписьXML;
		
		ПотокВПамяти = Новый ПотокВПамяти;
		ЗаписьXML.ОткрытьПоток(ПотокВПамяти);
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("av:УведомлениеОНачалеИспользованияЭлектронныхДокументов");
		
		ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xserializer", "http://www.it.ru/Schemas/Avior/XSerializer"); 
		ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance"); 
		ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("schemaLocation", "http://www.it.ru/Schemas/Avior/УРКИ УРКИ.xsd"); 
		ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("av", ПакетXDTO.URIПространстваИмен);
		
		ЗаписьXML.ЗаписатьАтрибут("appVersion", "2.16.3");
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("av:НомерУведомления");
		ЗаписьXML.ЗаписатьТекст(ДанныеУведомления.ДанныеДокумента.НомерУведомления);
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("av:ДатаУведомления");
		ЗаписьXML.ЗаписатьТекст(Формат(ДанныеУведомления.ДанныеДокумента.ДатаУведомления, "ДФ=yyyy-MM-dd"));
		ЗаписьXML.ЗаписатьКонецЭлемента();
				
		Фабрика.ЗаписатьXML(ЗаписьXML, УведомлениеОбъект.Раздел_СведенияОбУчастникеРынкаКолИнвест, "Раздел_СведенияОбУчастникеРынкаКолИнвест");
		Фабрика.ЗаписатьXML(ЗаписьXML, УведомлениеОбъект.Раздел_СведОНачИспользованияЭДО, "Раздел_СведОНачИспользованияЭДО");
		Фабрика.ЗаписатьXML(ЗаписьXML, УведомлениеОбъект.ПодписьУполномоченногоЛица, "ПодписьУполномоченногоЛица");
		Фабрика.ЗаписатьXML(ЗаписьXML, УведомлениеОбъект.СопроводительноеПисьмо, "СопроводительноеПисьмо");
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
			
		ЗаписьXML.Закрыть(); 
		
		#КонецОбласти
		
		ИмяФайла = СтрШаблон("YVED_NACH_%1_%2.xtdd", 
			Формат(ДанныеУведомления.ДанныеДокумента.ДатаУведомления, "ДФ=dd.MM.yyyy"), 
			РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(ДанныеУведомления.ДанныеДокумента.НомерУведомления));
		
		ДвоичныеДанные = ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();
		Результат.Добавить(Новый Структура("ИмяФайла, ДвоичныеДанные", ИмяФайла, ДвоичныеДанные));
	
	КонецЦикла;	
	
	Возврат Результат;

КонецФункции

Функция ПолучитьДанныеДляПечатиУведомленияОбИспользованииЭДО(ИсходящийДокумент)

	#Область Текст_запроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходящийДокумент.Ссылка КАК Ссылка,
		|	ИсходящийДокумент.Номер КАК НомерУведомления,
		|	ИсходящийДокумент.Дата КАК ДатаУведомления,
		|	ИсходящийДокумент.Организация.ЮрФизЛицо КАК ОрганизацияЮрФизЛицо,
		|	ИсходящийДокумент.Организация КАК Организация,
		|	""Сообщение о начале использования ЭДО"" КАК КраткоеСодержаниеПисьма,
		|	ИсходящийДокумент.Содержание КАК Примечание
		|ПОМЕСТИТЬ _ДанныеДокумента
		|ИЗ
		|	Документ.ИсходящийДокумент КАК ИсходящийДокумент
		|ГДЕ
		|	ИсходящийДокумент.Ссылка В(&Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеДокумента.Ссылка КАК Ссылка,
		|	_ДанныеДокумента.Организация КАК Организация,
		|	_ДанныеДокумента.ДатаУведомления КАК ДатаУведомления,
		|	ИсходящийДокументОснования.Основание КАК Договор,
		|	ИсходящийДокументОснования.Основание ЕСТЬ НЕ NULL 
		|		И (ТИПЗНАЧЕНИЯ(ИсходящийДокументОснования.Основание) = ТИП(Справочник.Договоры)
		|				И ВЫРАЗИТЬ(ИсходящийДокументОснования.Основание КАК Справочник.Договоры).ВидДоговора В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ДополнительноеСоглашение), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СоглашениеОбЭДО))
		|			ИЛИ ТИПЗНАЧЕНИЯ(ИсходящийДокументОснования.Основание) = ТИП(Справочник.СчетаДоверительногоУправления)) КАК ЭтоУведомлениеОбЭДО
		|ПОМЕСТИТЬ _Договоры
		|ИЗ
		|	_ДанныеДокумента КАК _ДанныеДокумента
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИсходящийДокумент.Основания КАК ИсходящийДокументОснования
		|		ПО _ДанныеДокумента.Ссылка = ИсходящийДокументОснования.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_Договоры.Ссылка КАК Ссылка,
		|	_Договоры.Организация КАК Организация,
		|	_Договоры.ДатаУведомления КАК ДатаУведомления,
		|	ЕСТЬNULL(СправочникДоговоры.Контрагент, КлиентыДоверительногоУправления.Клиент) КАК Клиент
		|ПОМЕСТИТЬ _Клиенты
		|ИЗ
		|	_Договоры КАК _Договоры
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, Организация = &Организация) КАК КлиентыДоверительногоУправления
		|		ПО _Договоры.Договор = КлиентыДоверительногоУправления.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры КАК СправочникДоговоры
		|		ПО _Договоры.Договор = СправочникДоговоры.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
