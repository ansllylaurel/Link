		|		КОГДА _Уведомление.ВидИзменения = ЗНАЧЕНИЕ(Перечисление.ВидыИзмененийПеречней.Исключение)
		|			ТОГДА ""об исключении лица из списка""
		|		ИНАЧЕ ""о включении лица в список""
		|	КОНЕЦ КАК ВидУведомления,
		|	_Уведомление.ИсходящийДокумент.Номер КАК НомерИсходящегоДокумента,
		|	_Уведомление.ИсходящийДокумент.Дата КАК ДатаИсходящегоДокумента,
		|	ЕСТЬNULL(_ФизическоеЛицо.Обращение, """") + "" "" + ЕСТЬNULL(_ФизическоеЛицо.ФИО, _ЮридическоеЛицо.ПолноеНаименованиеПоУставу) КАК Получатель
		|ПОМЕСТИТЬ _РеквизитыШапки
		|ИЗ
		|	_Уведомление КАК _Уведомление
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ФизическоеЛицо КАК _ФизическоеЛицо
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЮридическоеЛицо КАК _ЮридическоеЛицо
		|		ПО (ИСТИНА)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Основания.Ссылка КАК Ссылка,
		|	Основания.НормативныйАкт.Наименование КАК НормативныйАкт,
		|	Основания.Основание КАК Основание,
		|	Основания.Сотрудник КАК Сотрудник,
		|	Основания.Категория.Наименование КАК Категория
		|ПОМЕСТИТЬ _Основания
		|ИЗ
		|	Документ.ВнесениеИзмененийВоВнутреннийПеречень.Основания КАК Основания
		|ГДЕ
		|	Основания.Ссылка В
		|			(ВЫБРАТЬ
		|				_Уведомление.ВнесениеИзмененийВоВнутреннийПеречень КАК ВнесениеИзмененийВоВнутреннийПеречень
		|			ИЗ
		|				_Уведомление КАК _Уведомление
		|		
		|			ОБЪЕДИНИТЬ ВСЕ
		|		
		|			ВЫБРАТЬ
		|				_ОснованияВключения.ОснованиеВключения КАК ОснованиеВключения
		|			ИЗ
		|				_ОснованияВключения КАК _ОснованияВключения)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(ПОДСТРОКА(РеквизитыПодписанта.Имя, 1, 1) + "". "" + ПОДСТРОКА(РеквизитыПодписанта.Отчество, 1, 1) + "". "" + РеквизитыПодписанта.Фамилия, _Уведомление.ИсходящийДокумент.Подписал) КАК Подписант,
		|	ДолжностьПодписанта.Должность.Наименование КАК Должность,
		|	_Уведомление.ИсходящийДокумент.Дата КАК ДатаИсходящегоДокумента
		|ПОМЕСТИТЬ _Подписант
		|ИЗ
		|	_Уведомление КАК _Уведомление
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
		|		ПО _Уведомление.ИсходящийДокумент.Подписал = Сотрудники.ЮрФизЛицо
		|			И _Уведомление.Организация = Сотрудники.Организация
		|			И (Сотрудники.ВидЗанятости = ЗНАЧЕНИЕ(Перечисление.ВидыЗанятостиСотрудников.ОсновноеМестоРаботы))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации.СрезПоследних(&ДатаИсходящегоДокумента, ) КАК ДолжностьПодписанта
		|		ПО _Уведомление.Организация = ДолжностьПодписанта.Организация
		|			И (Сотрудники.Ссылка = ДолжностьПодписанта.Сотрудник)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(&ДатаИсходящегоДокумента, ) КАК РеквизитыПодписанта
		|		ПО _Уведомление.Организация = РеквизитыПодписанта.Организация
		|			И _Уведомление.ИсходящийДокумент.Подписал = РеквизитыПодписанта.ЮрФизЛицо
		|ГДЕ
		|	ДолжностьПодписанта.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)";
#КонецОбласти
	
	Запрос.Выполнить();

	Результат = Новый ТабличныйДокумент;
	
	Результат.Вывести(РаботаСОтчетами.ПолучитьШапкуОфициальногоБланкаОрганизации(Ссылка.Организация, Ссылка.Дата));
	
	ИмяМакета = "УведомлениеИнсайдеру";
	
	Таблица_РеквизитыШапки			= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_РеквизитыШапки").ПолучитьДанные().Выгрузить();
	Таблица_РеквизитыОрганизации	= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_РеквизитыОрганизации").ПолучитьДанные().Выгрузить();
	Таблица_ЮридическоеЛицо 		= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ЮридическоеЛицо").ПолучитьДанные().Выгрузить();
	Таблица_ФизическоеЛицо			= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ФизическоеЛицо").ПолучитьДанные().Выгрузить();
	Таблица_Подписант				= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Подписант").ПолучитьДанные().Выгрузить();
	Таблица_Основания				= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Основания").ПолучитьДанные().Выгрузить();
	
	ДополнительныеПараметры = Новый Структура("Таблица_Основания", Таблица_Основания);
	
	Если Таблица_РеквизитыШапки.Количество() Тогда
		ДанныеШапки = ПодготовитьДанные(Таблица_РеквизитыШапки[0]);
		ВывестиОбласть(Результат, ИмяМакета, "Шапка", ДанныеШапки);
		Результат.ИспользуемоеИмяФайла	= СтрШаблон("Уведомление %1 № %2 от %3", ДанныеШапки.ВидУведомления, ДанныеШапки.НомерИсходящегоДокумента, ДанныеШапки.ДатаИсходящегоДокумента);
	КонецЕсли;
	
	Если Таблица_РеквизитыОрганизации.Количество() Тогда
		ВывестиОбласть(Результат, ИмяМакета, "РеквизитыОрганизации", ПодготовитьДанные(Таблица_РеквизитыОрганизации[0]));
	КонецЕсли;
	
	Результат.ВывестиГоризонтальныйРазделительСтраниц();
	
	Если Таблица_ЮридическоеЛицо.Количество() Тогда
		ВывестиОбласть(Результат, ИмяМакета, "ЮридическоеЛицо", ПодготовитьДанные(Таблица_ЮридическоеЛицо[0], ДополнительныеПараметры));
		Результат.ИспользуемоеИмяФайла	= СтрШаблон(Результат.ИспользуемоеИмяФайла + " (%1)", Таблица_ЮридическоеЛицо[0].ПолноеНаименованиеПоУставу);
	КонецЕсли;
	
	Если Таблица_ФизическоеЛицо.Количество() Тогда
		Если ЗначениеЗаполнено(Таблица_ФизическоеЛицо[0].СообщениеОбОшибке) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Таблица_ФизическоеЛицо[0].СообщениеОбОшибке, Основание);
			Возврат Неопределено;
		КонецЕсли;
		
		ВывестиОбласть(Результат, ИмяМакета, "ФизическоеЛицо", ПодготовитьДанные(Таблица_ФизическоеЛицо[0], ДополнительныеПараметры));
		Результат.ИспользуемоеИмяФайла	= СтрШаблон(Результат.ИспользуемоеИмяФайла + " (%1)", Таблица_ФизическоеЛицо[0].ФИО);
	КонецЕсли;
	
	Если Таблица_Подписант.Количество() Тогда
		ВывестиОбласть(Результат, ИмяМакета, "Подписант", ПодготовитьДанные(Таблица_Подписант[0], ДополнительныеПараметры));
	КонецЕсли;
	
	Результат.ТолькоПросмотр		= Истина;
	Результат.ОтображатьСетку		= Ложь;
	Результат.ОтображатьЗаголовки	= Ложь;
	Результат.АвтоМасштаб			= Истина;
	
	Возврат Результат;
	
КонецФункции

Функция ПодготовитьДанные(СтрокаДанных, ДополнительныеПараметры = Неопределено)
	
	Колонки = СтрокаДанных.Владелец().Колонки;
	Данные	= Новый Структура;
	
	Для Каждого Колонка Из Колонки Цикл
		
		Значение = СтрокаДанных[Колонка.Имя];
		
		Если Колонка.Имя = "ДатаВключенияИсключения" Тогда
			Если СтрокаДанных.ВидИзменения = Перечисления.ВидыИзмененийПеречней.Исключение Тогда
				Значение = "Исключение из списка инсайдеров " + Символы.ПС + Формат(Значение, "ДФ=dd.MM.yyyy");	
			Иначе
				Значение = "Включение в список инсайдеров " + Символы.ПС + Формат(Значение, "ДФ=dd.MM.yyyy");	
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
			Значение = Формат(Значение, "ДФ=dd.MM.yyyy");
			
		ИначеЕсли (Колонка.Имя = "ОснованиеВключения" ИЛИ Колонка.Имя = "ОснованиеИсключения") И ТипЗнч(Значение) = Тип("ДокументСсылка.ВнесениеИзмененийВоВнутреннийПеречень") Тогда
			Значение = ПолучитьОснованиеИнсайдераИзОснования(Значение, ДополнительныеПараметры.Таблица_Основания);
			
		КонецЕсли;
		
		Данные.Вставить(Колонка.Имя, Значение);
		
	КонецЦикла;	
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьОснованиеИнсайдераИзОснования(Основание, Таблица_Основания)
	
	ОписаниеОснования = Новый Массив;
	
	ПараметрыПоиска = Новый Структура("Ссылка", Основание);	
	НайденныеСтроки = Таблица_Основания.НайтиСтроки(ПараметрыПоиска);
	
	Для Каждого Строка_Основания Из НайденныеСтроки Цикл
		ОписаниеОснования.Добавить(Строка(Строка_Основания.Категория) + Символы.ПС + Строка(Строка_Основания.Основание));
	КонецЦикла;
	
	Возврат СтрСоединить(ОписаниеОснования, Символы.ПС);
	
КонецФункции

Процедура ВывестиОбласть(Результат, ИмяМакета, ИмяОбласти, Данные = Неопределено)
	
	Макет	= ПолучитьМакет(ИмяМакета);
	Область = Макет.ПолучитьОбласть(ИмяОбласти);
	
	Если Данные <> Неопределено Тогда
		Область.Параметры.Заполнить(Данные);
	КонецЕсли;
	
	Результат.Вывести(Область);
	
КонецПроцедуры

#КонецОбласти

Функция ПолучитьСодержаниеОтветаНаОбращение(Период, Организация, МассивОбращений) Экспорт
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК НаименованиеОрганизации,
		|	ВходящийДокумент.НомерВходящегоДокумента КАК Номер,
		|	ВходящийДокумент.ДатаВходящегоДокумента КАК Дата
		|ИЗ
		|	Документ.ВходящийДокумент КАК ВходящийДокумент
		|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И ЮрФизЛицо = &ЮрЛицоОрганизации
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО (ИСТИНА)
		|ГДЕ
		|	ВходящийДокумент.Ссылка В(&Ссылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата,
		|	Номер";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", МассивОбращений);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ЮрЛицоОрганизации", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ЮрФизЛицо"));
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	НаименованиеОрганизации = "";
	МассивОснований = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
	
		Если НаименованиеОрганизации = "" Тогда
			НаименованиеОрганизации = Выборка.НаименованиеОрганизации;
		КонецЕсли;
		
		ПредставлениеОснования = СтрШаблон("%1 от %2", 
			Выборка.Номер, 
			Формат(Выборка.Дата, "ДФ='dd.MM.yyyy ''г.'''"));
			
		МассивОснований.Добавить(ПредставлениеОснования);
		
	КонецЦикла;
	
	СведенияОВходящемДокументе = СтрСоединить(МассивОснований, ", ");
	
	Если МассивОснований.Количество() > 1 Тогда
		ШаблонТекста = "%1 сообщает, что Ваши письма (Исх.№ %2) получены и приняты в работу.";
	Иначе
		ШаблонТекста = "%1 сообщает, что Ваше письмо (Исх.№ %2) получено и принято в работу.";
	КонецЕсли; 
	
	СодержаниеОтветаНаОбращение = СтрШаблон(ШаблонТекста, НаименованиеОрганизации, СведенияОВходящемДокументе);
	
	Возврат СодержаниеОтветаНаОбращение;
	
КонецФункции

Функция ПолучитьСодержаниеУведомленияОбЭДО(ИсходящийДокумент) Экспорт
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходящийДокумент.Ссылка КАК ИсходящийДокумент,
		|	ЕСТЬNULL(ИсходящийДокументОснования.Основание, НЕОПРЕДЕЛЕНО) КАК Договор,
		|	ЕСТЬNULL(УсловияСоглашенийОбЭДОСрезПоследних.ИнформационнаяСистема, ЗНАЧЕНИЕ(Справочник.ИнформационныеСистемы.ПустаяСсылка)) КАК ИнформационнаяСистема,
		|	ЕСТЬNULL(ЗначенияДополнительныхСведенийОператорЭДО.Значение, ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)) КАК ОператорЭДО,
		|	ИсходящийДокумент.Номер КАК Номер,
		|	ИсходящийДокумент.Дата КАК Дата
		|ИЗ
		|	Документ.ИсходящийДокумент КАК ИсходящийДокумент
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИсходящийДокумент.Основания КАК ИсходящийДокументОснования
		|		ПО (ИсходящийДокументОснования.Ссылка = ИсходящийДокумент.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСоглашенийОбЭДО.СрезПоследних(&Период, Организация = &Организация) КАК УсловияСоглашенийОбЭДОСрезПоследних
		|		ПО (ИсходящийДокументОснования.Основание = УсловияСоглашенийОбЭДОСрезПоследних.Договор)
		|			И (НАЧАЛОПЕРИОДА(ИсходящийДокумент.Дата, ДЕНЬ) = УсловияСоглашенийОбЭДОСрезПоследних.ДатаНачалаИспользованияЭДО)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийОператорЭДО
		|		ПО (УсловияСоглашенийОбЭДОСрезПоследних.ИнформационнаяСистема = ЗначенияДополнительныхСведенийОператорЭДО.Объект)
		|			И (ЗначенияДополнительныхСведенийОператорЭДО.Свойство.Ключ = ""ОператорЭДО"")
		|ГДЕ
		|	ИсходящийДокумент.Ссылка = &Ссылка";
	
	РеквизитыИсходящегоДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИсходящийДокумент, "Дата, Организация");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ИсходящийДокумент);
	Запрос.УстановитьПараметр("Период", НачалоДня(РеквизитыИсходящегоДокумента.Дата));
	Запрос.УстановитьПараметр("Организация", РеквизитыИсходящегоДокумента.Организация);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ШаблонЭДО = "%1, оператором которой является %2";
	ШаблонСообщенияОбОшибке = "В исходящем документе %1 от %2 %3";
	
	МассивЭДО = Новый Массив;
	Отказ = Ложь;
		
	Пока Выборка.Следующий() Цикл
	
		Если Не ЗначениеЗаполнено(Выборка.Договор) Тогда
			
			ОписаниеОшибки = "не указан договор ДУ/соглашение об ЭДО";
			ТекстОшибки = СтрШаблон(ШаблонСообщенияОбОшибке, Выборка.Номер, Формат(Выборка.Дата, "ДФ=dd.MM.yyyy"), ОписаниеОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Выборка.ИсходящийДокумент,,, Отказ);
			
		ИначеЕсли Не ЗначениеЗаполнено(Выборка.ИнформационнаяСистема) Тогда
			
			ОписаниеОшибки = "не удалось найти СЭД по договору " + Выборка.Договор;
			ТекстОшибки = СтрШаблон(ШаблонСообщенияОбОшибке, Выборка.Номер, Формат(Выборка.Дата, "ДФ=dd.MM.yyyy"), ОписаниеОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Выборка.ИсходящийДокумент,,, Отказ);
			
		ИначеЕсли Не ЗначениеЗаполнено(Выборка.ОператорЭДО) Тогда
			
			ОписаниеОшибки = "не заполнен оператор ЭДО для ИС " + Выборка.ИнформационнаяСистема;
			ТекстОшибки = СтрШаблон(ШаблонСообщенияОбОшибке, Выборка.Номер, Формат(Выборка.Дата, "ДФ=dd.MM.yyyy"), ОписаниеОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Выборка.ИсходящийДокумент,,, Отказ);
			
		КонецЕсли;
		
		Если Не Отказ Тогда
			МассивЭДО.Добавить(СтрШаблон(ШаблонЭДО, Выборка.ИнформационнаяСистема, Выборка.ОператорЭДО));
		КонецЕсли;
	
	КонецЦикла;
	
	СодержаниеУведомления = "";
	Если Не Отказ Тогда
		
		Шаблон = "компания уведомляет о начале использования электронных документов через %1 электронного документооборота %2";
		СодержаниеУведомления = СтрШаблон(Шаблон, 
			?(МассивЭДО.Количество() > 1, "системы", "систему"), 
			СтрСоединить(МассивЭДО, "; "));
	
	КонецЕсли;
	
	Возврат СодержаниеУведомления;
	
КонецФункции

#Область Отложенные_задания

Процедура ВыполнитьМетод(Команда, ПараметрыКоманды) Экспорт
	
	Если Команда = "СформироватьИОтправитьУведомлениеОПолучении" Тогда
		СформироватьИОтправитьУведомлениеОПолучении(ПараметрыКоманды);
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьИОтправитьУведомлениеОПолучении(Экземпляры)
	
	КлючиЗапуска = Новый ТаблицаЗначений;
	
	КлючиЗапуска.Колонки.Добавить("Организация",		Новый ОписаниеТипов("СправочникСсылка.Организации"));
	КлючиЗапуска.Колонки.Добавить("ВходящийДокумент",	Новый ОписаниеТипов("ДокументСсылка.ВходящийДокумент"));
	КлючиЗапуска.Колонки.Добавить("ИсходящийДокумент",	Новый ОписаниеТипов("ДокументСсылка.ИсходящийДокумент"));
	КлючиЗапуска.Колонки.Добавить("Идентификатор",		Новый ОписаниеТипов("УникальныйИдентификатор"));
	
	// Фиксируем запуск.
	Для Каждого ТекЭкземпляр Из Экземпляры Цикл
		
		НовыйКлюч = КлючиЗапуска.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйКлюч, ТекЭкземпляр.Параметры);
		НовыйКлюч.Идентификатор = ТекЭкземпляр.Идентификатор;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КлючиЗапуска", КлючиЗапуска);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КлючиЗапуска.Организация КАК Организация,
		|	КлючиЗапуска.ВходящийДокумент КАК ВходящийДокумент,
		|	КлючиЗапуска.ИсходящийДокумент КАК ИсходящийДокумент,
		|	КлючиЗапуска.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ _Экземпляры
		|ИЗ
		|	&КлючиЗапуска КАК КлючиЗапуска
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Экземпляры.Организация КАК Организация,
		|	_Экземпляры.ВходящийДокумент КАК ВходящийДокумент,
		|	_Экземпляры.ИсходящийДокумент КАК ИсходящийДокумент,
		|	_Экземпляры.Идентификатор КАК Идентификатор
		|ИЗ
		|	_Экземпляры КАК _Экземпляры
		|ИТОГИ ПО
		|	Организация,
		|	ВходящийДокумент,
		|	ИсходящийДокумент";
	
	ВыборкаОрганизации = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОрганизации.Следующий() Цикл
		
		ВыборкаВходящийДокумент = ВыборкаОрганизации.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаВходящийДокумент.Следующий() Цикл
			
			ВыборкаИсходящийДокумент = ВыборкаВходящийДокумент.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаИсходящийДокумент.Следующий() Цикл
				
				МассивСсылок = Новый Массив;
				МассивСсылок.Добавить(ВыборкаИсходящийДокумент.ИсходящийДокумент);
				
				ТабличныйДокумент = Документы.ИсходящийДокумент.ПечатьОтветаНаОбращение(МассивСсылок);
				
				НомерИсходящего = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаИсходящийДокумент.ИсходящийДокумент, "Номер");
				НомерИсходящего = СтрЗаменить(СтрЗаменить(НомерИсходящего, "/", "_"), "\", "_");
				ИмяФайла = "Письмо_" + РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(НомерИсходящего) + ".docx";
				
				ПотокВПамяти = Новый ПотокВПамяти;
				ТабличныйДокумент.Записать(ПотокВПамяти, ТипФайлаТабличногоДокумента.DOCX);
				
				ПомещенныеФайлы = Новый Массив;
				ОписаниеПереданногоФайла = Новый Структура;
				ОписаниеПереданногоФайла.Вставить("ПолноеИмя", ИмяФайла);
				ОписаниеПереданногоФайла.Вставить("Хранение", ПоместитьВоВременноеХранилище(ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные()));
				ПомещенныеФайлы.Добавить(ОписаниеПереданногоФайла);
				
				ДанныеВерсий = Обработки.РаботаСФайлами.ПрисоединитьФайл(ВыборкаИсходящийДокумент.ИсходящийДокумент, ПомещенныеФайлы);			
				
				УспешноеВыполнение = Ложь;
				ТекстОшибки = "";
				
				Если ДанныеВерсий.Количество() = 0 Тогда
					ТекстОшибки = "Не удалось присоединить файл";
				Иначе
					
					ДанныеТекущейВерсии = ДанныеВерсий[0];
					
					Если Не ДанныеТекущейВерсии.Свойство("ТекстОшибки", ТекстОшибки) Тогда
					
						Вложения = Новый Соответствие;
						Вложения.Вставить(ДанныеТекущейВерсии.ПолноеИмя, ДанныеТекущейВерсии);
						
						Если ОтправитьУведомлениеОПолучении(ВыборкаИсходящийДокумент.ВходящийДокумент, ВыборкаИсходящийДокумент.ИсходящийДокумент, Вложения) Тогда
							УспешноеВыполнение = Истина;
						Иначе
							ТекстОшибки = "Не удалось сформировать оповещение";
						КонецЕсли;
					
					КонецЕсли;
					
				КонецЕсли;
				
				Выборка = ВыборкаИсходящийДокумент.Выбрать();
				Пока Выборка.Следующий() Цикл
					// Фиксируем результат выполнения задания.
					Если УспешноеВыполнение Тогда
						РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(Выборка.Идентификатор);
					Иначе
						РаботаСРегламентнымиЗаданиями.ОтменитьОтложенноеЗадание(Выборка.Идентификатор, ТекстОшибки);
					КонецЕсли; 
					
				КонецЦикла;
				
			КонецЦикла;		
				
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОтправитьУведомлениеОПолучении(ВходящийДокумент, ИсходящийДокумент, Вложения)

	ОповещениеСформировано = Ложь;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВходящийДокумент.Ссылка КАК Ссылка,
		|	ВходящийДокумент.Дата КАК Дата,
		|	ВходящийДокумент.Организация КАК Организация,
		|	ВходящийДокумент.Отправитель КАК Отправитель,
		|	ВходящийДокумент.ВидВходящегоДокумента КАК ВидВходящегоДокумента,
		|	ВходящийДокумент.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
		|	ВходящийДокумент.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента
		|ИЗ
		|	Документ.ВходящийДокумент КАК ВходящийДокумент
		|ГДЕ
		|	ВходящийДокумент.Ссылка = &Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ВходящийДокумент);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
	
		Текст = "Зарегистрирован входящий документ " + ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Выборка.Ссылка) + "<br>" +
			"Получатель: " + Выборка.Отправитель + "<br>" +
			"Исходящий документ №" + Выборка.НомерВходящегоДокумента + " от " + Формат(Выборка.ДатаВходящегоДокумента, "ДФ=dd.MM.yyyy") + "<br>" +
			"Краткое описание: " + Выборка.ВидВходящегоДокумента + "<br>" + 
			"<br>" + 
			"Ответ о получении " + ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(ИсходящийДокумент);
		
		ДоступнаОтправкаПоЭДО = ЗначениеЗаполнено(ПоСоглашениюОбЭдоНеТребуетсяАвтоответ(Выборка));
		РеквизитыОповещения = Новый Структура("Организация, Текст, Вложения, ДоступнаОтправкаПоЭДО", Выборка.Организация, Текст, Вложения, ДоступнаОтправкаПоЭДО);
		Справочники.Оповещения.СформироватьОповещения(ИсходящийДокумент.Метаданные().ПолноеИмя() + ".ОтветОПолучении", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
		ОповещениеСформировано = Истина;
		
	КонецЕсли;
	
	Возврат ОповещениеСформировано;
	 
КонецФункции 

Функция ПоСоглашениюОбЭдоНеТребуетсяАвтоответ(ПараметрыЭдо) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _КлиентыДУ
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&НачалоДня, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|ГДЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент = &Контрагент
		|	И (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения >= &НачалоДня
		|			ИЛИ КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлиентыДУ.Клиент КАК Клиент,
		|	_КлиентыДУ.СчетДоверительногоУправления КАК Ссылка,
		|	_КлиентыДУ.ДатаЗаключения КАК ДатаЗаключения
		|ПОМЕСТИТЬ _ДоговорыЭдо
		|ИЗ
		|	_КлиентыДУ КАК _КлиентыДУ
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_КлиентыДУ.Клиент,
		|	ДействующиеДоговоры.Ссылка,
		|	ДействующиеДоговоры.ДатаЗаключения
		|ИЗ
		|	_КлиентыДУ КАК _КлиентыДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			Договоры.Ссылка КАК Ссылка,
		|			Договоры.Контрагент КАК Контрагент,
		|			Договоры.ДатаЗаключения КАК ДатаЗаключения
		|		ИЗ
		|			Справочник.Договоры КАК Договоры
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие КАК УсловияДоговоровОбщие
		|				ПО Договоры.Ссылка = УсловияДоговоровОбщие.Договор
		|					И (УсловияДоговоровОбщие.ДатаРасторжения <> ДАТАВРЕМЯ(1, 1, 1))
		|		ГДЕ
		|			Договоры.ДатаЗаключения <= &НачалоДня
		|			И Договоры.ВидДоговора В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СоглашениеОбЭДО), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ДополнительноеСоглашение))
		|			И ЕСТЬNULL(УсловияДоговоровОбщие.ДатаРасторжения, &НачалоДня) >= &НачалоДня) КАК ДействующиеДоговоры
		|		ПО _КлиентыДУ.Клиент = ДействующиеДоговоры.Контрагент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	УсловияСоглашенийОбЭДОСрезПоследних.НеТребуетсяАвтоответ КАК НеТребуетсяАвтоответ
		|ИЗ
		|	РегистрСведений.УсловияСоглашенийОбЭДО.СрезПоследних(
		|			&НачалоДня,
		|			Организация = &Организация
		|				И Договор В
		|					(ВЫБРАТЬ
		|						_ДоговорыЭдо.Ссылка
		|					ИЗ
		|						_ДоговорыЭдо КАК _ДоговорыЭдо)) КАК УсловияСоглашенийОбЭДОСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДоговорыЭдо КАК _ДоговорыЭдо
		|		ПО УсловияСоглашенийОбЭДОСрезПоследних.Договор = _ДоговорыЭдо.Ссылка
		|			И (УсловияСоглашенийОбЭДОСрезПоследних.ДатаНачалаИспользованияЭДО <> ДАТАВРЕМЯ(1, 1, 1))
		|			И (УсловияСоглашенийОбЭДОСрезПоследних.ДатаНачалаИспользованияЭДО <= &НачалоДня)
		|			И (УсловияСоглашенийОбЭДОСрезПоследних.ДатаОкончанияИспользованияЭДО = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ УсловияСоглашенийОбЭДОСрезПоследних.ДатаОкончанияИспользованияЭДО > &НачалоДня)
		|
		|УПОРЯДОЧИТЬ ПО
		|	_ДоговорыЭдо.ДатаЗаключения УБЫВ";
	
	Запрос.УстановитьПараметр("Организация", ПараметрыЭдо.Организация);
	Запрос.УстановитьПараметр("Контрагент", ПараметрыЭдо.Отправитель);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ПараметрыЭдо.Дата));
	
	Выборка = Запрос.Выполнить().Выбрать();
		
	Если Выборка.Следующий() Тогда
	
		Возврат Выборка.НеТребуетсяАвтоответ;
	
	КонецЕсли;
	
КонецФункции

#КонецОбласти 