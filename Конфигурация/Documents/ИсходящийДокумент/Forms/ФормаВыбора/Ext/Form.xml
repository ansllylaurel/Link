			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ДокументИсходящийДокумент.Ссылка КАК Ссылка,
	ДокументИсходящийДокумент.ПометкаУдаления КАК ПометкаУдаления,
	ДокументИсходящийДокумент.Номер КАК Номер,
	ДокументИсходящийДокумент.Дата КАК Дата,
	ДокументИсходящийДокумент.Проведен КАК Проведен,
	ДокументИсходящийДокумент.Организация КАК Организация,
	ЕСТЬNULL(ИсходящийДокументДоговоры.Договор, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка)) КАК СчетДоверительногоУправления,
	ДокументИсходящийДокумент.Получатель КАК Получатель,
	ДокументИсходящийДокумент.Договор КАК Договор,
	ЕСТЬNULL(ДокументИсходящийДокумент.Основание, НЕОПРЕДЕЛЕНО) КАК Основание,
	ДокументИсходящийДокумент.ДатаИсходящегоДокумента КАК ДатаИсходящегоДокумента,
	ДокументИсходящийДокумент.НомерИсходящегоДокумента КАК НомерИсходящегоДокумента,
	ДокументИсходящийДокумент.Описание КАК Описание,
	ДокументИсходящийДокумент.Ответственный КАК Ответственный,
	ДокументИсходящийДокумент.Комментарий КАК Комментарий,
	ДокументИсходящийДокумент.НомерНаклейки КАК НомерНаклейки,
	ДокументИсходящийДокумент.ПоЛицензииДУ КАК ПоЛицензииДУ,
	ДокументИсходящийДокумент.ПоЛицензииУКПИФ КАК ПоЛицензииУКПИФ,
	ДокументИсходящийДокумент.ПоСобственнойДеятельностиУК КАК ПоСобственнойДеятельностиУК,
	ДокументИсходящийДокумент.Договоры.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		Договор КАК Договор
	) КАК Договоры,
	НАЧАЛОПЕРИОДА(ДокументИсходящийДокумент.Дата, ДЕНЬ) КАК ДатаПоДням,
	ДокументИсходящийДокумент.ОтветПоСуществу КАК ОтветПоСуществу
ИЗ
	Документ.ИсходящийДокумент КАК ДокументИсходящийДокумент
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИсходящийДокумент.Договоры КАК ИсходящийДокументДоговоры
		ПО (ИсходящийДокументДоговоры.Ссылка = ДокументИсходящийДокумент.Ссылка)
			И (ИсходящийДокументДоговоры.НомерСтроки = 1)
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИсходящийДокумент.Основания КАК ИсходящийДокументОснования
		ПО (ИсходящийДокументОснования.Ссылка = ДокументИсходящийДокумент.Ссылка)
			И (ИсходящийДокументОснования.НомерСтроки = 1)</QueryText>
				<MainTable>Document.ИсходящийДокумент</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>ДатаПоДням</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>Номер</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
