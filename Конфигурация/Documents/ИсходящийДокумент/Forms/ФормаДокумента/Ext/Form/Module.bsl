#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не Параметры.ЗначениеКопирования.Пустая() Тогда
        СтандартнаяОбработка = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Копирование исходящих документов запрещено!",,,, Отказ);
		Возврат;
    КонецЕсли;
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ТипЗнч(ТекущийОбъект.Получатель) = Тип("Строка") И Не ЗначениеЗаполнено(ТекущийОбъект.ПолПолучателя) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"При указании получателя строкой необходимо указать пол получателя (Мужской/Женский) для корректного формирования обращения в печатной форме.",,,, Отказ);
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.ЭтоДокументДепозитарнойКомпании Тогда
		
		Если ЗначениеЗаполнено(ЭтаФорма.Основание) Тогда
		
			Если ТекущийОбъект.Основания.Количество() = 0 Тогда
				НоваяСтрока = ТекущийОбъект.Основания.Добавить();
			Иначе
				НоваяСтрока = ТекущийОбъект.Основания[0];
			КонецЕсли; 
			
			НоваяСтрока.Основание = ЭтаФорма.Основание;
			
		Иначе
			
			ТекущийОбъект.Основания.Очистить();
		
		КонецЕсли; 
			
	Иначе
		// проверка получателя
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Основания.Основание КАК Основание,
			|	Основания.НомерСтроки КАК НомерСтроки
			|ПОМЕСТИТЬ _Основания
			|ИЗ
			|	&Основания КАК Основания
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Основания.Основание КАК Основание
			|ИЗ
			|	_Основания КАК _Основания
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВходящийДокумент КАК ВходящийДокумент
			|		ПО _Основания.Основание = ВходящийДокумент.Ссылка
			|			И (ВходящийДокумент.Отправитель <> &Получатель)";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Основания", ТекущийОбъект.Основания.Выгрузить());
		Запрос.УстановитьПараметр("Получатель", ТекущийОбъект.Получатель);
		
		Результат = Запрос.Выполнить();
		МассивОснований = Результат.Выгрузить().ВыгрузитьКолонку(0);
		
		Если МассивОснований.Количество() = 0 Тогда
			ТекстПредупреждения = "";
		ИначеЕсли МассивОснований.Количество() = 1 Тогда
			ТекстПредупреждения = "Отправитель запроса ";
		ИначеЕсли МассивОснований.Количество() > 1 Тогда
			ТекстПредупреждения = "Отправители в запросах ";
		КонецЕсли; 
		
		Если ТекстПредупреждения <> "" Тогда
			
			ТекстПредупреждения = "Проверьте получателя ответа." + Символы.ПС + ТекстПредупреждения
				+ СтрСоединить(МассивОснований, ", ") + " отличается от получателя";
			ПараметрыЗаписи.Вставить("ПолучательОтличаетсяОтОтправителя", ТекстПредупреждения);
		
		КонецЕсли; 		
	
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЭтаФорма.ИсходнаяДатаДокумента = ТекущийОбъект.Дата;
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	Если Объект.Договоры.Количество() > 0 И Элементы.Найти("Договоры") <> Неопределено Тогда
		
		НомерСтроки = Неопределено;
		Если ЗначениеЗаполнено(Элементы.Договоры.ТекущаяСтрока) Тогда
			НомерСтроки = Объект.Договоры.НайтиПоИдентификатору(Элементы.Договоры.ТекущаяСтрока).НомерСтроки;
		КонецЕсли; 
		
		РаботаСДокументооборотом.ЗаполнитьДанныеПоДоговорам(Объект);
		
		Если ЗначениеЗаполнено(НомерСтроки) Тогда
			Для каждого Строка Из Объект.Договоры Цикл
			    Если Строка.НомерСтроки = НомерСтроки Тогда
					Элементы.Договоры.ТекущаяСтрока = Строка.ПолучитьИдентификатор();
					Прервать;
				КонецЕсли; 
			КонецЦикла;
		КонецЕсли;
				
	КонецЕсли; 
	
	Если Не ЭтаФорма.ЭтоДокументДепозитарнойКомпании Тогда
		ЭтаФорма.ВходящиеДокументы.Параметры.УстановитьЗначениеПараметра("Основание", ТекущийОбъект.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.Свойство("ПолучательОтличаетсяОтОтправителя") Тогда
		ПоказатьПредупреждение(, ПараметрыЗаписи.ПолучательОтличаетсяОтОтправителя, , "Внимание!");
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти 

