#Область Служебные_процедуры_и_функции

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	ЭтаФорма.ЭтоДокументДепозитарнойКомпании = (Объект.ТипИсходящегоДокумента = Перечисления.ТипыИсходящихДокументов.ИсходящийДокументДепозитарнойКомпании);
	
	ЭтаФорма.ИсходнаяДатаДокумента = Объект.Дата;
	
	Если ЭтаФорма.ЭтоДокументДепозитарнойКомпании Тогда
		
		Элементы.ГруппаВидыДокументов.ТекущаяСтраница = Элементы.ГруппаДепозитарнаяКомпания;
		Элементы.Получатель.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица");
		
		Если Объект.Договоры.Количество() <> 0 Тогда
			ЭтаФорма.СчетДоверительногоУправления = Объект.Договоры[0].Договор;
		КонецЕсли;
		
		Элементы.Основание.ОграничениеТипа = Метаданные.Документы.ИсходящийДокумент.ТабличныеЧасти.Основания.Реквизиты.Основание.Тип;
		Если Объект.Основания.Количество() > 0 Тогда
			ЭтаФорма.Основание = Объект.Основания[0].Основание;
		КонецЕсли; 
			
	Иначе
		
		Если Параметры.Ключ.Пустая()
			И Параметры.ЗначениеКопирования.Пустая() Тогда
			
			ЗаполнитьПодписанта();
			
		КонецЕсли;
		
		ЗаполнитьСписокВыбораТипаИсходящегоДокумента();
		
		РаботаСДокументооборотом.УстановитьПереключательТипаЮрФизЛицоСтрока(ЭтаФорма.ТипПолучателя, Объект.Получатель);
		УстановитьОбязательностьИВидимостьПолПолучателяНаСервере();
		РаботаСДокументооборотом.УстановитьПереключательТипаЮрФизЛицоСтрока(ЭтаФорма.ТипИсполнителя, Объект.Исполнитель);
		РаботаСДокументооборотом.УстановитьПереключательТипаЮрФизЛицоСтрока(ЭтаФорма.ТипПодписал, Объект.Подписал);
		
		РаботаСДокументооборотомКлиентСервер.УстановитьПараметрыВыбораДоговора(ЭтаФорма, "Получатель");
		Элементы.ГруппаВидыДокументов.ТекущаяСтраница = Элементы.ГруппаУправляющаяКомпания;
		Элементы.Номер.Заголовок 	= "Исходящий номер";
		Элементы.Дата.Заголовок 	= "Дата регистрации документа";
		РаботаСДокументооборотом.ЗаполнитьДанныеПоДоговорам(Объект);
		РаботаСДокументооборотомКлиентСервер.ЗаполнитьЗаголовокГруппыДоговоров(ЭтаФорма);
		
		ЭтаФорма.ВходящиеДокументы.Параметры.УстановитьЗначениеПараметра("Основание", Объект.Ссылка);
		
		ЭтаФорма.СтандартноеСодержание = Документы.ИсходящийДокумент.ПолучитьСодержаниеОтветаНаОбращение(Объект.Дата, Объект.Организация, Объект.Основания.Выгрузить( ,"Основание").ВыгрузитьКолонку("Основание"));
		
		Элементы.ГруппаСписокДоговоров.Видимость = (Элементы.Найти("Договоры") <> Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодписанта()

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтактныеЛица.КонтактноеЛицо КАК КонтактноеЛицо
		|ИЗ
		|	РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|ГДЕ
		|	КонтактныеЛица.Объект = &Объект
		|	И КонтактныеЛица.Должность = ""Генеральный директор""";
		
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Объект", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ЮрФизЛИцо"));
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Объект.Подписал = Выборка.КонтактноеЛицо;
	КонецЕсли

КонецПроцедуры
 
&НаКлиенте
Процедура Подключаемый_ОткрытьПрисоединенныеФайлы()

	РаботаСФайловымХранилищемКлиент.ОткрытьПрисоединенныеФайлы(Объект.Ссылка);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОснованияПриИзмененииНаСервере(Период, Организация, МассивОснований)
	
	ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВходящийДокумент.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ВходящийДокумент КАК ВходящийДокумент
		|ГДЕ
		|	ВходящийДокумент.Ссылка В(&Ссылка)
		|	И ВходящийДокумент.ТипВходящегоДокумента В (ЗНАЧЕНИЕ(Перечисление.ТипыВходящихДокументов.ОбращениеКлиента), ЗНАЧЕНИЕ(Перечисление.ТипыВходящихДокументов.ОбращениеПотенциальногоКлиента), ЗНАЧЕНИЕ(Перечисление.ТипыВходящихДокументов.ОбращениеИное))";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", МассивОснований);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
	
		Возврат Документы.ИсходящийДокумент.ПолучитьСодержаниеОтветаНаОбращение(Период, Организация, МассивОснований);
	
	КонецЕсли;
		
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокВыбораТипаИсходящегоДокумента()

	Для каждого ТипДокумента Из Перечисления.ТипыИсходящихДокументов Цикл
		Если ТипДокумента <> Перечисления.ТипыИсходящихДокументов.ИсходящийДокументДепозитарнойКомпании Тогда
			Элементы.ТипИсходящегоДокумента.СписокВыбора.Добавить(ТипДокумента);
		КонецЕсли; 
	КонецЦикла; 

КонецПроцедуры

&НаСервере
Процедура ДоговорыДоговорПриИзмененииНаСервере()

	РаботаСДокументооборотом.ЗаполнитьДанныеПоДоговорам(Объект, Элементы.Договоры.ТекущаяСтрока);

КонецПроцедуры 

#КонецОбласти 

