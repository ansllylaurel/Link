
#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ_И_ЭЛЕМЕНТОВ

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
	РасчитатьРыночнуюСтоимостьДепозита();
	РасчитатьСтоимостьДепозитаБУ();
	РасчитатьСтоимостьДепозитаНУ();
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаполнитьПодтверждениеОперацииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
	РаботаСДокументамиКлиент.ПроверитьПараметрыПодтвержденияОперации(ЭтаФорма, Объект, ПараметрыЗаписи);
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ПодтверждениеОперации" Тогда
		Если Параметр = Объект.Ссылка
			ИЛИ (ТипЗнч(Параметр) = Тип("Массив") И Параметр.Найти(Объект.Ссылка) <> Неопределено)
		Тогда
			ЗаполнитьПодтверждениеОперацииНаСервере();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаПриИзменении(Элемент)
	
	РасчитатьРыночнуюСтоимостьДепозита();
	РасчитатьСтоимостьДепозитаБУ();
	РасчитатьСтоимостьДепозитаНУ();
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаПроцентовПриИзменении(Элемент)
	
	РасчитатьРыночнуюСтоимостьДепозита();
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаКорректировкиПоАСПриИзменении(Элемент)
	
	РасчитатьРыночнуюСтоимостьДепозита();
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаПроцентовБУПриИзменении(Элемент)
	
	РасчитатьСтоимостьДепозитаБУ();
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаКорректировкиПоАмортизированнойСтоимостиБУПриИзменении(Элемент)
	
	РасчитатьСтоимостьДепозитаБУ();
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаДоходовБудущихПериодовПриИзменении(Элемент)
	
	РасчитатьСтоимостьДепозитаБУ();
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаПроцентовНУПриИзменении(Элемент)
	
	РасчитатьСтоимостьДепозитаНУ();
		
КонецПроцедуры

&НаКлиенте
Процедура КредитныйИнструментПриИзменении(Элемент)
	
	ЭтаФорма.ПериодичностьВыплатыПроцентов = ПолучитьПериодичностьВыплатыПроцентов(Объект.КредитныйИнструмент, Объект.Дата);
	
	Если ЭтаФорма.ПериодичностьВыплатыПроцентов = ПредопределенноеЗначение("Перечисление.ПериодичностиВыплатыПроцентов.Авансом") Тогда
		Объект.СуммаПроцентовБУ = 0;
	Иначе
		Объект.СуммаДоходовБудущихПериодов = 0;
	КонецЕсли;
	
	РасчитатьСтоимостьДепозитаБУ();
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры


#КонецОбласти

#Область СЛУЖЕБНЫЕ_ПРОЦЕДУРЫ_И_ФУНКЦИИ

Процедура ПриЧтенииСозданииНаСервере()
	
	ЭтаФорма.УстановитьПараметрыФункциональныхОпцийФормы(Новый Структура("Организация", Объект.Организация));
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	ЭтаФорма.ПериодичностьВыплатыПроцентов = ПолучитьПериодичностьВыплатыПроцентов(Объект.КредитныйИнструмент, Объект.Дата);
	
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления") <> ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.Собственный") Тогда
	
		ЭтаФорма.ТипПередачи = РаботаСДокументами.ПолучитьТипПередачиДляВводаВыводаАктивов(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, Объект.Контрагент);
		
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры //ПриЧтенииСозданииНаСервере

&НаКлиенте
Процедура ПровестиПоБухгалтерскомуУчету()

	РаботаСФормамиКлиент.ПровестиПоБухгалтерскомуУчету(ЭтаФорма); 

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	ДанныеОбъекта = Форма.Объект;
	Элементы      = Форма.Элементы;
		
	Элементы.СуммаПроцентовБУ.Видимость 			= НЕ (Форма.ПериодичностьВыплатыПроцентов = ПредопределенноеЗначение("Перечисление.ПериодичностиВыплатыПроцентов.Авансом"));
	Элементы.СуммаДоходовБудущихПериодов.Видимость 	= (Форма.ПериодичностьВыплатыПроцентов = ПредопределенноеЗначение("Перечисление.ПериодичностиВыплатыПроцентов.Авансом"));
	
	СобственныйСчетДУ = (ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеОбъекта.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления") = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.Собственный"));

	Элементы.ТипПередачи.Видимость = Не СобственныйСчетДУ;
	Элементы.Контрагент.АвтоОтметкаНезаполненного = РаботаСДокументамиКлиентСервер.ТребуетсяПроверкаЗаполненияЗначенияКонтрагента(ДанныеОбъекта);
	Элементы.Контрагент.ТолькоПросмотр = Форма.ТипПередачи < 2 И Не СобственныйСчетДУ;
	
КонецПроцедуры // НастроитьВидимостьДоступность

&НаСервереБезКонтекста
Функция ПолучитьПериодичностьВыплатыПроцентов(КредитныйИнструмент, Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	УсловияКредитныхИнструментовСрезПоследних.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов
		|ИЗ
		|	РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
		|			&Период,
		|			ДатаНачалаДействияУсловий <= &Период
		|				И КредитныйИнструмент = &КредитныйИнструмент) КАК УсловияКредитныхИнструментовСрезПоследних
		|ГДЕ
		|	УсловияКредитныхИнструментовСрезПоследних.Действует
		|
		|УПОРЯДОЧИТЬ ПО
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий УБЫВ";
	
	Запрос.УстановитьПараметр("КредитныйИнструмент"	, КредитныйИнструмент);
	Запрос.УстановитьПараметр("Период"			, Период);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПериодичностьВыплатыПроцентов;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПодтверждениеОперацииНаСервере()
	РаботаСДокументами.ЗаполнитьПодтверждениеОперации(ЭтаФорма, Объект.Ссылка);		
КонецПроцедуры

&НаКлиенте
Процедура РасчитатьРыночнуюСтоимостьДепозита()
	
	ЭтаФорма.РыночнаяСтоимостьДепозита = Объект.Сумма + Объект.СуммаПроцентов + Объект.СуммаКорректировкиПоАмортизированнойСтоимости;
	
КонецПроцедуры

&НаКлиенте
Процедура РасчитатьСтоимостьДепозитаБУ()
	
	ЭтаФорма.СтоимостьДепозитаБУ = Объект.Сумма + Объект.СуммаПроцентовБУ + Объект.СуммаКорректировкиПоАмортизированнойСтоимостиБУ - Объект.СуммаДоходовБудущихПериодов;
	
КонецПроцедуры

&НаКлиенте
Процедура РасчитатьСтоимостьДепозитаНУ()
	
	ЭтаФорма.СтоимостьДепозитаНУ = Объект.Сумма + Объект.СуммаПроцентовНУ;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.СчетДоверительногоУправленияОбработкаВыбора(Объект, ЭтаФорма, ВыбранноеЗначение, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления") = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.Собственный") Тогда
		ЭтаФорма.ТипПередачи = 0;
	КонецЕсли;
	
	Объект.Контрагент = РаботаСДокументамиКлиент.ПолучитьКонтрагентаДляВводаВыводаАктивов(Объект.Дата, ЭтаФорма.ТипПередачи, Объект.Организация, Объект.СчетДоверительногоУправления);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.ДатаОбработкаВыбора(Объект, ЭтаФорма, ВыбранноеЗначение, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипПередачиПриИзменении(Элемент)
	
	Объект.Контрагент = РаботаСДокументамиКлиент.ПолучитьКонтрагентаДляВводаВыводаАктивов(Объект.Дата, ЭтаФорма.ТипПередачи, Объект.Организация, Объект.СчетДоверительногоУправления);
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОткрытьПрисоединенныеФайлы()

	РаботаСФайловымХранилищемКлиент.ОткрытьПрисоединенныеФайлы(Объект.Ссылка);

КонецПроцедуры


#КонецОбласти