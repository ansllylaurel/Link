#Область ВСПОМОГАТЕЛЬНЫЕ_ФУНКЦИИ

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма, Элемент = Неопределено)
	
	Элементы = Форма.Элементы;
		
КонецПроцедуры	


#КонецОбласти

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
				
	ПриЧтенииСозданииНаСервере(); 
		
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ЗаполнитьПодтверждениеОперацииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
		
	РаботаСДокументамиКлиент.ПроверитьПараметрыПодтвержденияОперации(ЭтаФорма, Объект, ПараметрыЗаписи);
			
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ПодтверждениеОперации" Тогда
		Если Параметр = Объект.Ссылка
			ИЛИ (ТипЗнч(Параметр) = Тип("Массив") И Параметр.Найти(Объект.Ссылка) <> Неопределено)
		Тогда
			ЗаполнитьПодтверждениеОперацииНаСервере();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
КонецПроцедуры

&НаСервере
Процедура ПриОткрытииНаСервере()
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПриОткрытииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
			
	ЭтаФорма.УстановитьПараметрыФункциональныхОпцийФормы(Новый Структура("Организация", Объект.Организация));
		
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры // ПриЧтенииСозданииНаСервере()

&НаСервере
Процедура ЗаполнитьПодтверждениеОперацииНаСервере()

	РаботаСДокументами.ЗаполнитьПодтверждениеОперации(ЭтаФорма, Объект.Ссылка);		

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");  
	ТекущийОбъект.ЗаполнитьТабличнуюЧасть();
	ЗначениеВРеквизитФормы(ТекущийОбъект, "Объект");                                                 
		
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)

	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда 
		Возврат;
	КонецЕсли;
		
	Если Объект.НалоговаяБаза.Количество() > 0 Тогда 
		Ответ = Вопрос("Текущие данные будут очищены. Перезаполнить документ?", РежимДиалогаВопрос.ОКОтмена, 15);
		Если Ответ = КодВозвратаДиалога.Отмена Тогда 
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура НалоговаяБаза1ПриИзмененииНаСервере(ТекущийНомерСтроки, РучноеРедактирование)
	
	Если Не РучноеРедактирование Тогда 
		ТекущийОбъект = РеквизитФормыВЗначение("Объект");  
		ТекущийОбъект.РасчетСуммыНалога(ТекущийНомерСтроки);
		ЗначениеВРеквизитФормы(ТекущийОбъект, "Объект");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НалоговаяБаза1ПриИзменении(Элемент)
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;  
	
	НалоговаяБаза1ПриИзмененииНаСервере(Элемент.ТекущиеДанные.НомерСтроки, Элемент.ТекущиеДанные.РучноеРедактирование);
	
КонецПроцедуры

&НаКлиенте
Процедура НалоговаяБазаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.ВидДохода = ПредопределенноеЗначение("Справочник.ВидыДоходовНДФЛ.Код1530");
		Элемент.ТекущиеДанные.ВидВычета = ПредопределенноеЗначение("Справочник.ВидыВычетовНДФЛ.Код201");
		Элемент.ТекущиеДанные.ВидИнвестиционногоВычета = ПредопределенноеЗначение("Справочник.ВидыВычетовНДФЛ.Код618");
		Элемент.ТекущиеДанные.СтавкаНДФЛ = ПредопределенноеЗначение("Перечисление.СтавкиНДФЛ.Ставка13");
		Элемент.ТекущиеДанные.СтавкаНДФЛПовышенная = ПредопределенноеЗначение("Перечисление.СтавкиНДФЛ.Ставка15");
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура НалоговаяБазаПрименятьИнвестВычетПоЗаявлениюПриИзменении(Элемент)
	
	//если пайщик встречается несколько раз 
	// Все нижележащие строки исправить:
	// Значение поля СуммаИнвестВычета добавить или убрать в поле ИнвестВычетСНачалаГода. 
	
	ТекущаяСтрока = ЭтотОбъект.ТекущийЭлемент.ТекущаяСтрока;
	ПайщикТекущаяСтрока = ЭтотОбъект.ТекущийЭлемент.ТекущиеДанные.Пайщик;
	ИнвестВычетСлагаемое = ЭтотОбъект.ТекущийЭлемент.ТекущиеДанные.СуммаИнвестВычета * ?(ЭтотОбъект.ТекущийЭлемент.ТекущиеДанные.ПрименятьИнвестВычетПоЗаявлению, 1, -1);
	
	КоличествоСтрок = Объект.НалоговаяБаза.Количество(); 
	
	Для Индекс = ТекущаяСтрока По (КоличествоСтрок - 1) Цикл  
		Если Объект.НалоговаяБаза[Индекс].Пайщик = ПайщикТекущаяСтрока Тогда
			Объект.НалоговаяБаза[Индекс].ИнвестВычетСНачалаГода = Объект.НалоговаяБаза[Индекс].ИнвестВычетСНачалаГода + ИнвестВычетСлагаемое;
			НалоговаяБаза1ПриИзмененииНаСервере(Объект.НалоговаяБаза[Индекс].НомерСтроки, Объект.НалоговаяБаза[Индекс].РучноеРедактирование); 
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


#КонецОбласти




