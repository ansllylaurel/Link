	Запрос.УстановитьПараметр("КонецПериода", ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("КонецПериодаГраница", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
