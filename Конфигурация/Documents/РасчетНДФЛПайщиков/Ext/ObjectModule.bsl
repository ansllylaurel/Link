	// и т.д.   
	
	ТаблицаПолученногоДохода = Новый ТаблицаЗначений;
	ТаблицаПолученногоДохода.Колонки.Добавить("Пайщик");
	ТаблицаПолученногоДохода.Колонки.Добавить("СуммаДохода");
	ТаблицаПолученногоДохода.Колонки.Добавить("СуммаВычета"); 
	
	Пока Выборка.Следующий() Цикл 
		
		НоваяСтрока = ЭтотОбъект.НалоговаяБаза.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);   
		НоваяСтрока.СтавкаНДФЛ = Перечисления.СтавкиНДФЛ.Ставка13;
		НоваяСтрока.СтавкаНДФЛПовышенная = Перечисления.СтавкиНДФЛ.Ставка15;  
		
		СтрокаТЗПолученногоДохода = ТаблицаПолученногоДохода.Найти(Выборка.Пайщик, "Пайщик"); 
		Если СтрокаТЗПолученногоДохода = Неопределено Тогда
			 // нет пайщика. Добавим
			 СтрокаТЗПолученногоДохода = ТаблицаПолученногоДохода.Добавить();
			 СтрокаТЗПолученногоДохода.Пайщик = Выборка.Пайщик;
			 СтрокаТЗПолученногоДохода.СуммаДохода = Выборка.СуммаДохода;
			 СтрокаТЗПолученногоДохода.СуммаВычета = Выборка.СуммаВычета;
		 Иначе
			 // сначала добавим имеющиеся суммы к данным с начала года

			 НоваяСтрока.ДоходСНачалаГода = НоваяСтрока.ДоходСНачалаГода + СтрокаТЗПолученногоДохода.СуммаДохода;
			 НоваяСтрока.ВычетСНачалаГода = НоваяСтрока.ВычетСНачалаГода + СтрокаТЗПолученногоДохода.СуммаВычета; 
			 
			 // теперь добавим данные в нарастающие итоги
			 СтрокаТЗПолученногоДохода.СуммаДохода = СтрокаТЗПолученногоДохода.СуммаДохода + Выборка.СуммаДохода;
			 СтрокаТЗПолученногоДохода.СуммаВычета = СтрокаТЗПолученногоДохода.СуммаВычета + Выборка.СуммаВычета; 
			 
			 //с инвест вычет не добавлаяем. На форме ставим галдочку принимать по зявлению. 
			 // процедура НалоговаяБазаПрименятьИнвестВычетПоЗаявлениюПриИзменении разнесет инветс вычет по строкам. 
			 
		КонецЕсли;
		
	КонецЦикла;     
	
	РасчетСуммыНалога();
	
КонецПроцедуры

Процедура РасчетСуммыНалога(НомерСтроки = Неопределено) Экспорт
	
	ПороговаяСумма = РаботаСНалогамиКлиентСервер.ПорогПримененияСтавкиНДФЛ15Процентов(ЭтотОбъект.Дата, Перечисления.СтавкиНДФЛ.Ставка13);    
	
	Если НомерСтроки <> Неопределено Тогда 
		ТекущаяСтрока = ЭтотОбъект.НалоговаяБаза.Найти(НомерСтроки, "НомерСтроки"); 
		РасчетСуммыНалогаПоСтроке(ТекущаяСтрока, ПороговаяСумма);
	Иначе		
		Для Каждого СтрокаНалоговойБазы Из ЭтотОбъект.НалоговаяБаза Цикл  
			РасчетСуммыНалогаПоСтроке(СтрокаНалоговойБазы, ПороговаяСумма);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
 
#КонецОбласти


