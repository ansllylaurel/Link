
#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ДанныеЗаполнения <> Неопределено Тогда 
		
		Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РаспределениеДоходаПайщикам") Тогда 
			
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, "Организация");
			ЭтотОбъект.Дата  = НачалоДня(ДанныеЗаполнения.Дата) + 5*60;
			
			ЗаполнитьТабличнуюЧасть();
			
		КонецЕсли;
		
	КонецЕсли;
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
		
КонецПроцедуры

#КонецОбласти

#Область ПроведениеДокумента

Функция ДобавитьПроводку(НаборДвижений, СчетДоверительногоУправления, Сумма, Содержание)
	
		Проводка = НаборДвижений.Добавить();
	
		Проводка.Период                       = Этотобъект.Дата;
		Проводка.Организация                  = Этотобъект.Организация;
		Проводка.СчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления);
		Проводка.Сумма                        = Сумма;
		Проводка.Содержание                   = Содержание;
	

		Возврат Проводка;
		
КонецФункции 

Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт
	
	Движения[УчетныйРегистр].Записывать = Истина;   
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	НастройкиУчетаОбщиеСрезПоследних.ВестиУчетИмуществаПайщиков КАК ВестиУчетИмуществаПайщиков
	|ПОМЕСТИТЬ _НастройкаУчетИмуществаПайщиков
	|ИЗ
	|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления В (&СчетДоверительногоУправления)
	|				И ВестиБухгалтерскийУчет) КАК НастройкиУчетаОбщиеСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РасчетНДФЛПайщиковНалоговаяБаза.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	РасчетНДФЛПайщиковНалоговаяБаза.Пайщик КАК Пайщик,
	|	РасчетНДФЛПайщиковНалоговаяБаза.Основание КАК Основание,
	|	РасчетНДФЛПайщиковНалоговаяБаза.СтавкаНДФЛ КАК СтавкаНДФЛ,
	|	РасчетНДФЛПайщиковНалоговаяБаза.СуммаНалога КАК СуммаНалога,
	|	РасчетНДФЛПайщиковНалоговаяБаза.СтавкаНДФЛПовышенная КАК СтавкаНДФЛПовышенная,
	|	РасчетНДФЛПайщиковНалоговаяБаза.СуммаНалогаСПревышения КАК СуммаНалогаСПревышения,
	|	ВЫБОР
	|		КОГДА ПогашениеПаев.ВариантПогашенияПаев <> ЗНАЧЕНИЕ(Перечисление.ВариантыПогашенияПаев.ПоЗаявке)
	|				И _НастройкаУчетИмуществаПайщиков.ВестиУчетИмуществаПайщиков
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК МожноПровести,
	|	ПогашениеПаев.ВариантПогашенияПаев КАК ВариантПогашенияПаев,
	|	_НастройкаУчетИмуществаПайщиков.ВестиУчетИмуществаПайщиков КАК ВестиУчетИмуществаПайщиков
	|ПОМЕСТИТЬ _ИтоговаяТаблица
	|ИЗ
	|	Документ.РасчетНДФЛПайщиков.НалоговаяБаза КАК РасчетНДФЛПайщиковНалоговаяБаза
	|		ЛЕВОЕ СОЕДИНЕНИЕ _НастройкаУчетИмуществаПайщиков КАК _НастройкаУчетИмуществаПайщиков
	|		ПО РасчетНДФЛПайщиковНалоговаяБаза.СчетДоверительногоУправления = _НастройкаУчетИмуществаПайщиков.СчетДоверительногоУправления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПогашениеПаев КАК ПогашениеПаев
	|		ПО (ПогашениеПаев.Ссылка = РасчетНДФЛПайщиковНалоговаяБаза.Основание)
	|ГДЕ
	|	РасчетНДФЛПайщиковНалоговаяБаза.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ИтоговаяТаблица.Основание КАК Основание,
	|	_ИтоговаяТаблица.ВариантПогашенияПаев КАК ВариантПогашенияПаев
	|ПОМЕСТИТЬ _Ошибки
	|ИЗ
	|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
	|ГДЕ
	|	НЕ _ИтоговаяТаблица.МожноПровести
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ИтоговаяТаблица.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	_ИтоговаяТаблица.Пайщик КАК Пайщик,
	|	_ИтоговаяТаблица.Основание КАК Основание,
	|	_ИтоговаяТаблица.СтавкаНДФЛ КАК СтавкаНДФЛ,
	|	_ИтоговаяТаблица.СуммаНалога КАК СуммаНалога,
	|	_ИтоговаяТаблица.СтавкаНДФЛПовышенная КАК СтавкаНДФЛПовышенная,
	|	_ИтоговаяТаблица.СуммаНалогаСПревышения КАК СуммаНалогаСПревышения,
	|	_ИтоговаяТаблица.ВестиУчетИмуществаПайщиков КАК ВестиУчетИмуществаПайщиков
	|ИЗ
	|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
	|
	|УПОРЯДОЧИТЬ ПО
	|	СчетДоверительногоУправления
	|ИТОГИ
	|	СУММА(СуммаНалога),
	|	СУММА(СуммаНалогаСПревышения),
	|	МАКСИМУМ(ВестиУчетИмуществаПайщиков)
	|ПО
	|	СчетДоверительногоУправления"; 
	
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.НалоговаяБаза.ВыгрузитьКолонку("СчетДоверительногоУправления")); 
	
	
	ВыборкаСчетДУ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Ошибки = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос.МенеджерВременныхТаблиц, "_Ошибки").Выгрузить(); 
	Если Ошибки.Количество() > 0 Тогда       
		ТекстОшибки = "";
		Для Каждого СтрокаОшибок из Ошибки Цикл  
			ТекстОшибки = ТекстОшибки + "По документу " + СтрокаОшибок.Основание + " нет заявки пайщика. " +  Символы.ПС;
		КонецЦикла; 
		ВызватьИсключение ТекстОшибки + " Субконто ЗаякиПайщиков невозможно заполнить. Задача #655359.";
		Возврат; 
	КонецЕсли;
	
	Пока ВыборкаСчетДУ.Следующий() Цикл                                 
		
		Выборка = ВыборкаСчетДУ.Выбрать(ОбходРезультатаЗапроса.Прямой); 
		Пока Выборка.Следующий() Цикл  
			
			СуммаПроводки = Выборка.СуммаНалога + Выборка.СуммаНалогаСПревышения;	
			
			// нельзя использовать функцию РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(). Счет ДУ берем из табличной части. 
			Проводка = ДобавитьПроводку(Движения[УчетныйРегистр], Выборка.СчетДоверительногоУправления, СуммаПроводки, "Начислен НДФЛ");
			
			Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасчетыСРазнымиДебиторамиИКредиторами;
			Проводка.СубконтоДт.Контрагенты = Выборка.Пайщик;
			
			Проводка.СчетКт = ПланыСчетов.Основной.НДФЛ;
			Проводка.СубконтоКт.ВидыПлатежейВБюджет = Перечисления.ВидыПлатежейВБюджет.НалогВзносыНачисленоУплачено;  
			
			Если ВыборкаСчетДУ.ВестиУчетИмуществаПайщиков Тогда
				
				// в учете пайщика есть субконто Ставка НДФЛ, если надо, делаем две проводки
				Для НомерЦикла = 1 по 2 Цикл 
					Если НомерЦикла = 1 И Выборка.СуммаНалога > 0 Тогда
						СуммаПроводки = Выборка.СуммаНалога;
						СтавкаНДФЛ = Выборка.СтавкаНДФЛ;
					ИначеЕсли НомерЦикла = 2 И Выборка.СуммаНалогаСПревышения > 0 Тогда 
						СуммаПроводки = Выборка.СуммаНалогаСПревышения;
						СтавкаНДФЛ = Выборка.СтавкаНДФЛПовышенная;
					Иначе
						Продолжить;
					КонецЕсли;
					
					// П99 - П68.1
					Проводка = ДобавитьПроводку(Движения[УчетныйРегистр], Выборка.СчетДоверительногоУправления, СуммаПроводки, "Начислен НДФЛ к уплате");
					
					Проводка.СчетДт = ПланыСчетов.Основной.ПрибылиИУбыткиПайщика;
					Проводка.СубконтоДт.Пайщики = Выборка.Пайщик;
					
					Проводка.СчетКт = ПланыСчетов.Основной.НДФЛНачислен;
					Проводка.СубконтоКт.Пайщики = Выборка.Пайщик;  
					Проводка.СубконтоКт.СтавкиНДФЛ = СтавкаНДФЛ;  
					
					//П68.1 - П76.1  
					Проводка = ДобавитьПроводку(Движения[УчетныйРегистр], Выборка.СчетДоверительногоУправления, СуммаПроводки, "Начислен НДФЛ к уплате");
					
					Проводка.СчетДт = ПланыСчетов.Основной.НДФЛНачислен;
					Проводка.СубконтоДт.Пайщики = Выборка.Пайщик;
					Проводка.СубконтоДт.СтавкиНДФЛ = СтавкаНДФЛ;  
					
					Проводка.СчетКт = ПланыСчетов.Основной.РасчетыКлиентаСПИФ;
					Проводка.СубконтоКт.Пайщики = Выборка.Пайщик;
					
					Проводка.СубконтоКт.ЗаявкиПайщиков = Выборка.Основание.Заявка;   
					
				КонецЦикла;
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
		
	
КонецПроцедуры

Процедура ЗаполнитьДвижениеБазаНачисленияНДФЛ(Пайщик, Сумма, ВидНалогооблагаемойБазы, КодДоходаВычета, СтавкаНДФЛ)

	Движение = Движения.БазаНачисленияНДФЛ.Добавить();
	Движение.Период = ЭтотОбъект.Дата;
	Движение.Организация = ЭтотОбъект.Организация;
	Движение.ФизЛицо = Пайщик;                 
	Если ЗначениеЗаполнено(ВидНалогооблагаемойБазы) Тогда
		Движение.ВидНалогооблагаемойБазы = ВидНалогооблагаемойБазы;
	Иначе    
		Если КодДоходаВычета = Справочники.ВидыДоходовНДФЛ.Код1530 ИЛИ КодДоходаВычета = Справочники.ВидыВычетовНДФЛ.Код201 ИЛИ КодДоходаВычета = Справочники.ВидыВычетовНДФЛ.Код618 Тогда 
			Движение.ВидНалогооблагаемойБазы = Перечисления.ВидыНалогооблагаемыхБаз.ПоЦеннымБумагамОбращаемым;
		Иначе 
			Движение.ВидНалогооблагаемойБазы = Перечисления.ВидыНалогооблагаемыхБаз.ПоЦеннымБумагамНеобращаемым;
		КонецЕсли;
	КонецЕсли;
	Движение.ДатаПолученияДохода = НачалоМесяца(ЭтотОбъект.Дата);
	Движение.ВидДоходаВычета = КодДоходаВычета;
	Движение.СтавкаНДФЛ = СтавкаНДФЛ; 
	Движение.СуммаНДФЛ = Сумма; 
	Если КодДоходаВычета = Справочники.ВидыВычетовНДФЛ.Код618 Тогда 
		Движение.Сумма = 0; // затрат нет. 
	Иначе
		Движение.Сумма = Сумма;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДвижениеНачисленияНалогов(СчетДоверительногоУправления, Пайщик, СтавкаНДФЛ, БазаНалога, СуммаНалога)
	
	Движение = Движения.НачисленияНалогов.Добавить();
	Движение.Период = ЭтотОбъект.Дата;
	Движение.Организация = ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления = СчетДоверительногоУправления;
	Движение.Налогоплательщик = Пайщик; 
	Если СтавкаНДФЛ = Перечисления.СтавкиНДФЛ.Ставка13 Тогда 
		Движение.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНДФЛ13;
	ИначеЕсли СтавкаНДФЛ = Перечисления.СтавкиНДФЛ.Ставка15 Тогда 
		Движение.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНДФЛ15;
	КонецЕсли;
	Движение.Основание = ЭтотОбъект.Ссылка;
	Движение.БазаНалога = БазаНалога;
	Движение.Сумма = СуммаНалога;

КонецПроцедуры

Процедура ЗаполнитьДвижениеЗадолженностиПоДенежнымСредствам(ВидДвижения, СчетДоверительногоУправления, Контрагент, Основание, ВидЗадолженности, Сумма, Валюта)
	
	Движение = Движения.ЗадолженностиПоДенежнымСредствам.Добавить();  
	
	Движение.ВидДвижения = ВидДвижения;
	Движение.Период = ЭтотОбъект.Дата; 
	Движение.Основание = Основание;     
	Движение.ТипЗадолженности = Перечисления.ТипыЗадолженности.Кредиторская; 
	Движение.ВидЗадолженности = ВидЗадолженности;
	Движение.Организация = ЭтотОбъект.Организация; 
	Движение.СчетДоверительногоУправления = СчетДоверительногоУправления;
	Движение.Валюта = Валюта;
	Движение.Контрагент = Контрагент;
	Движение.Аванс = Ложь; 
	Движение.Сумма = Сумма;
	Движение.СуммаКупона = 0;
	
КонецПРоцедуры 

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт 
	
	ПороговаяСумма = РаботаСНалогамиКлиентСервер.ПорогПримененияСтавкиНДФЛ15Процентов(ЭтотОбъект.Дата, Перечисления.СтавкиНДФЛ.Ставка13);  

	// регистр БазаНачисленияНДФЛ 
	Движения.БазаНачисленияНДФЛ.Записывать = Истина; 
	Движения.НачисленияНалогов.Записывать = Истина;
	Движения.ЗадолженностиПоДенежнымСредствам.Записывать = Истина; 
    ВалютаРубль = ЭтотОбъект.Организация.ВалютаУчета;  
	КонтрагентИФНС = РегистрыСведений.ИФНСОрганизаций.ПолучитьИФНС(ЭтотОбъект.Дата, ЭтотОбъект.Организация, Ложь);
	
	Для Каждого ТекСтрокаНалоговаяБаза Из НалоговаяБаза Цикл  
		
		Если  ТекСтрокаНалоговаяБаза.СуммаНалога >= 0 И ТекСтрокаНалоговаяБаза.СуммаНалогаСПревышения = 0 Тогда
			//вся сумма идет по ставке 13
			
			Если ТекСтрокаНалоговаяБаза.СуммаДохода > 0 Тогда   // доход, надеюсь, будет всегда. Иначе зачем делать расчет?
				ЗаполнитьДвижениеБазаНачисленияНДФЛ(ТекСтрокаНалоговаяБаза.Пайщик, ТекСтрокаНалоговаяБаза.СуммаДохода, ТекСтрокаНалоговаяБаза.ВидНалогооблагаемойБазы, ТекСтрокаНалоговаяБаза.ВидДохода, ТекСтрокаНалоговаяБаза.СтавкаНДФЛ);
			КонецЕсли;
			
			Если ТекСтрокаНалоговаяБаза.СуммаВычета > 0 Тогда 
				ЗаполнитьДвижениеБазаНачисленияНДФЛ(ТекСтрокаНалоговаяБаза.Пайщик, -ТекСтрокаНалоговаяБаза.СуммаВычета, ТекСтрокаНалоговаяБаза.ВидНалогооблагаемойБазы, ТекСтрокаНалоговаяБаза.ВидВычета, ТекСтрокаНалоговаяБаза.СтавкаНДФЛ);
			КонецЕсли;
			
			Если ТекСтрокаНалоговаяБаза.СуммаИнвестВычета > 0 И ТекСтрокаНалоговаяБаза.ПрименятьИнвестВычетПоЗаявлению Тогда
				ЗаполнитьДвижениеБазаНачисленияНДФЛ(ТекСтрокаНалоговаяБаза.Пайщик, -ТекСтрокаНалоговаяБаза.СуммаИнвестВычета, ТекСтрокаНалоговаяБаза.ВидНалогооблагаемойБазы, ТекСтрокаНалоговаяБаза.ВидИнвестиционногоВычета, ТекСтрокаНалоговаяБаза.СтавкаНДФЛ);
			КонецЕсли;
			
			БазаНалога = ТекСтрокаНалоговаяБаза.СуммаДохода - ТекСтрокаНалоговаяБаза.СуммаВычета - ?(ТекСтрокаНалоговаяБаза.ПрименятьИнвестВычетПоЗаявлению, ТекСтрокаНалоговаяБаза.СуммаИнвестВычета, 0);
			ЗаполнитьДвижениеНачисленияНалогов(ТекСтрокаНалоговаяБаза.СчетДоверительногоУправления, ТекСтрокаНалоговаяБаза.Пайщик, ТекСтрокаНалоговаяБаза.СтавкаНДФЛ, БазаНалога, ТекСтрокаНалоговаяБаза.СуммаНалога);     
			
					
		ИначеЕсли  ТекСтрокаНалоговаяБаза.СуммаНалога = 0 И ТекСтрокаНалоговаяБаза.СуммаНалогаСПревышения > 0 Тогда
			//Весь доход помещаем в 15%

			Если ТекСтрокаНалоговаяБаза.СуммаДохода > 0 Тогда
				ЗаполнитьДвижениеБазаНачисленияНДФЛ(ТекСтрокаНалоговаяБаза.Пайщик, ТекСтрокаНалоговаяБаза.СуммаДохода, ТекСтрокаНалоговаяБаза.ВидНалогооблагаемойБазы, ТекСтрокаНалоговаяБаза.ВидДохода, ТекСтрокаНалоговаяБаза.СтавкаНДФЛПовышенная);
			КонецЕсли;
			      
			Если ТекСтрокаНалоговаяБаза.СуммаВычета > 0 Тогда
				ЗаполнитьДвижениеБазаНачисленияНДФЛ(ТекСтрокаНалоговаяБаза.Пайщик, -ТекСтрокаНалоговаяБаза.СуммаВычета, ТекСтрокаНалоговаяБаза.ВидНалогооблагаемойБазы, ТекСтрокаНалоговаяБаза.ВидВычета, ТекСтрокаНалоговаяБаза.СтавкаНДФЛПовышенная);
			КонецЕсли;
			
			Если ТекСтрокаНалоговаяБаза.СуммаИнвестВычета > 0 И ТекСтрокаНалоговаяБаза.ПрименятьИнвестВычетПоЗаявлению  Тогда
				 ЗаполнитьДвижениеБазаНачисленияНДФЛ(ТекСтрокаНалоговаяБаза.Пайщик, -ТекСтрокаНалоговаяБаза.СуммаИнвестВычета, ТекСтрокаНалоговаяБаза.ВидНалогооблагаемойБазы, ТекСтрокаНалоговаяБаза.ВидИнвестиционногоВычета, ТекСтрокаНалоговаяБаза.СтавкаНДФЛПовышенная);
			КонецЕсли;  
			 
			БазаНалога = ТекСтрокаНалоговаяБаза.СуммаДохода - ТекСтрокаНалоговаяБаза.СуммаВычета - ?(ТекСтрокаНалоговаяБаза.ПрименятьИнвестВычетПоЗаявлению, ТекСтрокаНалоговаяБаза.СуммаИнвестВычета, 0);
			ЗаполнитьДвижениеНачисленияНалогов(ТекСтрокаНалоговаяБаза.СчетДоверительногоУправления, ТекСтрокаНалоговаяБаза.Пайщик, ТекСтрокаНалоговаяБаза.СтавкаНДФЛПовышенная, БазаНалога, ТекСтрокаНалоговаяБаза.СуммаНалогаСПревышения);
			
		ИначеЕсли  ТекСтрокаНалоговаяБаза.СуммаНалога > 0 И ТекСтрокаНалоговаяБаза.СуммаНалогаСПревышения > 0 Тогда 
			
			//Как-то надо поделить. Все что можно на 13, излишек дохода - 15%
			
			СуммаДохода15 = ТекСтрокаНалоговаяБаза.СуммаДохода - ТекСтрокаНалоговаяБаза.СуммаВычета - 
				?(ТекСтрокаНалоговаяБаза.ПрименятьИнвестВычетПоЗаявлению, ТекСтрокаНалоговаяБаза.СуммаИнвестВычета, 0) 
				+ ТекСтрокаНалоговаяБаза.ДоходСНачалаГода - ТекСтрокаНалоговаяБаза.ВычетСНачалаГода - ПороговаяСумма;
				
			СуммаДохода13 = ТекСтрокаНалоговаяБаза.СуммаДохода -  СуммаДохода15;
			
			Если СуммаДохода13 > 0 Тогда
				ЗаполнитьДвижениеБазаНачисленияНДФЛ(ТекСтрокаНалоговаяБаза.Пайщик, СуммаДохода13, ТекСтрокаНалоговаяБаза.ВидНалогооблагаемойБазы, ТекСтрокаНалоговаяБаза.ВидДохода, ТекСтрокаНалоговаяБаза.СтавкаНДФЛ);
			КонецЕсли;
			
			Если ТекСтрокаНалоговаяБаза.СуммаВычета > 0 Тогда
				ЗаполнитьДвижениеБазаНачисленияНДФЛ(ТекСтрокаНалоговаяБаза.Пайщик, -ТекСтрокаНалоговаяБаза.СуммаВычета, ТекСтрокаНалоговаяБаза.ВидНалогооблагаемойБазы, ТекСтрокаНалоговаяБаза.ВидВычета, ТекСтрокаНалоговаяБаза.СтавкаНДФЛ);
			КонецЕсли;
			
			Если ТекСтрокаНалоговаяБаза.СуммаИнвестВычета > 0 И ТекСтрокаНалоговаяБаза.ПрименятьИнвестВычетПоЗаявлению Тогда
				 ЗаполнитьДвижениеБазаНачисленияНДФЛ(ТекСтрокаНалоговаяБаза.Пайщик, -ТекСтрокаНалоговаяБаза.СуммаИнвестВычета, ТекСтрокаНалоговаяБаза.ВидНалогооблагаемойБазы, ТекСтрокаНалоговаяБаза.ВидИнвестиционногоВычета, ТекСтрокаНалоговаяБаза.СтавкаНДФЛ);
			КонецЕсли;
			
			Если СуммаДохода15 > 0 Тогда
				ЗаполнитьДвижениеБазаНачисленияНДФЛ(ТекСтрокаНалоговаяБаза.Пайщик, СуммаДохода15, ТекСтрокаНалоговаяБаза.ВидНалогооблагаемойБазы, ТекСтрокаНалоговаяБаза.ВидДохода, ТекСтрокаНалоговаяБаза.СтавкаНДФЛПовышенная);
			КонецЕсли;
			
			БазаНалога = СуммаДохода13 - ТекСтрокаНалоговаяБаза.СуммаВычета - ?(ТекСтрокаНалоговаяБаза.ПрименятьИнвестВычетПоЗаявлению, ТекСтрокаНалоговаяБаза.СуммаИнвестВычета, 0);
			ЗаполнитьДвижениеНачисленияНалогов(ТекСтрокаНалоговаяБаза.СчетДоверительногоУправления, ТекСтрокаНалоговаяБаза.Пайщик, ТекСтрокаНалоговаяБаза.СтавкаНДФЛ, БазаНалога, ТекСтрокаНалоговаяБаза.СуммаНалога);

			ЗаполнитьДвижениеНачисленияНалогов(ТекСтрокаНалоговаяБаза.СчетДоверительногоУправления, ТекСтрокаНалоговаяБаза.Пайщик, ТекСтрокаНалоговаяБаза.СтавкаНДФЛПовышенная, СуммаДохода15, ТекСтрокаНалоговаяБаза.СуммаНалогаСПревышения);
			
		КонецЕсли;
		
		// списшем задолженность перед пайщиками на сумму НДФЛ 
		Если  ТипЗнч(ТекСтрокаНалоговаяБаза.Основание) = Тип("ДокументСсылка.РаспределениеДоходаПайщикам") Тогда 
			ВидЗадолженности = Справочники.ВидыЗадолженности.РасчетыСПайщикамиПоВыплатеДоходаПоИнвестиционнымПаям;
		Иначе  //вывод ДС
			ВидЗадолженности = Справочники.ВидыЗадолженности.ПередПайщиками;	
		КонецЕсли;
		
		Если (ТекСтрокаНалоговаяБаза.СуммаНалога + ТекСтрокаНалоговаяБаза.СуммаНалогаСПревышения > 0) Тогда 
			ЗаполнитьДвижениеЗадолженностиПоДенежнымСредствам(ВидДвиженияНакопления.Расход, 
			ТекСтрокаНалоговаяБаза.СчетДоверительногоУправления, 
			ТекСтрокаНалоговаяБаза.Пайщик, 
			ТекСтрокаНалоговаяБаза.Основание, 
			ВидЗадолженности, 
			ТекСтрокаНалоговаяБаза.СуммаНалога + ТекСтрокаНалоговаяБаза.СуммаНалогаСПревышения, 
			ВалютаРубль); 
			
			// создадим задолженность по НДФЛ. Делить 13%-15% не будем. оплата пойдет одной суммой.
			
			ЗаполнитьДвижениеЗадолженностиПоДенежнымСредствам(ВидДвиженияНакопления.Приход, 
			ТекСтрокаНалоговаяБаза.СчетДоверительногоУправления,
			КонтрагентИФНС, 
			ТекСтрокаНалоговаяБаза.Основание,
			Справочники.ВидыЗадолженности.ПоНДФЛ13,
			ТекСтрокаНалоговаяБаза.СуммаНалога + ТекСтрокаНалоговаяБаза.СуммаНалогаСПревышения, 
			ВалютаРубль);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);  
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти  

#Область ЗаполнениеДокумента 

Процедура РасчетСуммыНалогаПоСтроке(СтрокаНалоговойБазы, ПороговаяСумма) 
	
	НОБ = СтрокаНалоговойБазы.ДоходСНачалаГода - СтрокаНалоговойБазы.ВычетСНачалаГода - СтрокаНалоговойБазы.ИнвестВычетСНачалаГода - ?(СтрокаНалоговойБазы.ПрименятьИнвестВычетПоЗаявлению, СтрокаНалоговойБазы.СуммаИнвестВычета, 0);  
	//если ПрименятьИнвестВычетПоЗаявлению = Истина, то СуммаИнвестВычета уже включена в ИнвестВычетСНачалаГода и для правильного расчета ее нужно удалить
	НОБ_поДокументу = СтрокаНалоговойБазы.СуммаДохода - СтрокаНалоговойБазы.СуммаВычета - ?(СтрокаНалоговойБазы.ПрименятьИнвестВычетПоЗаявлению, СтрокаНалоговойБазы.СуммаИнвестВычета, 0);
	НОБ_РанееПолученный = НОБ - НОБ_поДокументу;
	
	Если НОБ_РанееПолученный < 0 Тогда 
		СуммаНалога13РанееНачисленного = 0;
		СуммаНалога15РанееНачисленного = 0;
	ИначеЕсли НОБ_РанееПолученный <= ПороговаяСумма ИЛИ ПороговаяСумма = 0 Тогда 
		СуммаНалога13РанееНачисленного = Окр(НОБ_РанееПолученный * 0.13, 0);
		СуммаНалога15РанееНачисленного = 0;  // 
	Иначе
		СуммаНалога13РанееНачисленного = ПороговаяСумма * 0.13;
		СуммаНалога15РанееНачисленного = Окр((НОБ_РанееПолученный - ПороговаяСумма) * 0.15, 0) ; 
	КонецЕсли; 
	
	НОБ = НОБ_РанееПолученный + НОБ_поДокументу;
	Если НОБ <= 0 Тогда 
		СтрокаНалоговойБазы.СуммаНалога = 0;
		СтрокаНалоговойБазы.СуммаНалогаСПревышения = 0;
	ИначеЕсли НОБ_поДокументу < 0 Тогда
		// Если по конткретному погашению получили убыток. 
		// По идее должен быть возврат налога. 
		// ситуация требует уточнения.                 
		// не понятно как будет в случае нескольких ПИФ. По одному убыток, по другому доход. 
		СтрокаНалоговойБазы.СуммаНалога = 0;
		СтрокаНалоговойБазы.СуммаНалогаСПревышения = 0;
	Иначе
		Если НОБ <= ПороговаяСумма ИЛИ ПороговаяСумма = 0 Тогда
			СтрокаНалоговойБазы.СуммаНалога = Окр(НОБ * 0.13, 0) - СуммаНалога13РанееНачисленного; 
			СтрокаНалоговойБазы.СуммаНалогаСПревышения = 0;
		Иначе
			Если НОБ_РанееПолученный > ПороговаяСумма Тогда
				СтрокаНалоговойБазы.СуммаНалога = 0;
				СтрокаНалоговойБазы.СуммаНалогаСПревышения = Окр((НОБ - ПороговаяСумма) * 0.15, 0) - СуммаНалога15РанееНачисленного;
			Иначе
				//делим 13/15 
				СтрокаНалоговойБазы.СуммаНалога = ПороговаяСумма * 0.13 - СуммаНалога13РанееНачисленного; 
				СтрокаНалоговойБазы.СуммаНалогаСПревышения = Окр((НОБ - ПороговаяСумма) * 0.15, 0) - СуммаНалога15РанееНачисленного; 
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;   	
	
КонецПроцедуры

Процедура ЗаполнитьТабличнуюЧасть() Экспорт 
	
	Запрос = Новый Запрос;     
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
