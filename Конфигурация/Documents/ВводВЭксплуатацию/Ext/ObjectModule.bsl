Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт
	
	Движения[УчетныйРегистр].Записать();
	Движения[УчетныйРегистр].Записывать = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив КАК УчетныйАктив,
		|	НастройкиУчетаАктивовСрезПоследних.СчетУчета КАК СчетУчета,
		|	НастройкиУчетаАктивовСрезПоследних.СчетУчетаПереоценки КАК СчетУчетаПереоценки
		|ПОМЕСТИТЬ _НастройкиУчета
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&Период,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Организация = &Организация
		|				И ВидУчета = &ВидУчета
		|				И УчетныйАктив В (ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ДоходныеВложенияВМатериальныеЦенности), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВложенияВоВнеоборотныеАктивы))) КАК НастройкиУчетаАктивовСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.Счет КАК Счет,
		|	БухгалтерскийУчетОстатки.Субконто1 КАК Субконто1,
		|	БухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток
		|ПОМЕСТИТЬ _БухУчетОстатки
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет В
		|				(ВЫБРАТЬ
		|					_НастройкиУчета.СчетУчета КАК СчетУчета
		|				ИЗ
		|					_НастройкиУчета КАК _НастройкиУчета
		|				ГДЕ
		|					_НастройкиУчета.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВложенияВоВнеоборотныеАктивы)
		|			
		|				ОБЪЕДИНИТЬ ВСЕ
		|			
		|				ВЫБРАТЬ
		|					_НастройкиУчета.СчетУчетаПереоценки
		|				ИЗ
		|					_НастройкиУчета КАК _НастройкиУчета
		|				ГДЕ
		|					_НастройкиУчета.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВложенияВоВнеоборотныеАктивы)),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1 = &ОбъектНедвижимости) КАК БухгалтерскийУчетОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_БухУчетОстаткиАктив.Счет КАК СчетИсточник,
		|	_БухУчетОстаткиАктив.Субконто1 КАК ОбъектНедвижимости,
		|	_БухУчетОстаткиАктив.СуммаОстаток КАК Сумма,
		|	ВЫБОР
		|		КОГДА _БухУчетОстаткиАктив.Счет = _НастройкиУчета.СчетУчета
		|			ТОГДА _НастройкиУчетаПриемник.СчетУчета
		|		ИНАЧЕ _НастройкиУчетаПриемник.СчетУчетаПереоценки
		|	КОНЕЦ КАК СчетПриемник
		|ИЗ
		|	_БухУчетОстатки КАК _БухУчетОстаткиАктив
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _НастройкиУчета КАК _НастройкиУчета
		|		ПО (_БухУчетОстаткиАктив.Счет = _НастройкиУчета.СчетУчета
		|				ИЛИ _БухУчетОстаткиАктив.Счет = _НастройкиУчета.СчетУчетаПереоценки)
		|			И (_НастройкиУчета.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВложенияВоВнеоборотныеАктивы))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _НастройкиУчета КАК _НастройкиУчетаПриемник
		|		ПО (_НастройкиУчетаПриемник.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ДоходныеВложенияВМатериальныеЦенности))";
	
	Запрос.УстановитьПараметр("ОбъектНедвижимости", ЭтотОбъект.ОбъектНедвижимости);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.Дата, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("ОбъектНедвижимости", ЭтотОбъект.ОбъектНедвижимости);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", УчетныйРегистр);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.Сумма > 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], ВыборкаДетальныеЗаписи.Сумма, "Ввод в эксплуатацию");
			
			Проводка.СчетДт = ВыборкаДетальныеЗаписи.СчетПриемник;
			Проводка.СубконтоДт.ОбъектыНедвижимости = ВыборкаДетальныеЗаписи.ОбъектНедвижимости;
			
			Проводка.СчетКт = ВыборкаДетальныеЗаписи.СчетИсточник;
			Проводка.СубконтоКт.ОбъектыНедвижимости = ВыборкаДетальныеЗаписи.ОбъектНедвижимости;
			
		Иначе
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], - ВыборкаДетальныеЗаписи.Сумма, "Ввод в эксплуатацию");
			
			Проводка.СчетДт = ВыборкаДетальныеЗаписи.СчетИсточник;
			Проводка.СубконтоДт.ОбъектыНедвижимости = ВыборкаДетальныеЗаписи.ОбъектНедвижимости;
			
			Проводка.СчетКт = ВыборкаДетальныеЗаписи.СчетПриемник;
			Проводка.СубконтоКт.ОбъектыНедвижимости = ВыборкаДетальныеЗаписи.ОбъектНедвижимости;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
КонецПроцедуры



#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
			
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);
	
	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		//проверить наличие объекта
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СУММА(ЕСТЬNULL(ВЫБОР
			|				КОГДА УсловияСделокСНедвижимостьюСрезПоследних.Основание.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
			|					ТОГДА 1
			|				КОГДА УсловияСделокСНедвижимостьюСрезПоследних.Основание.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
			|					ТОГДА -1
			|				ИНАЧЕ 0
			|			КОНЕЦ, 0)) КАК КоличествоВНаличии,
			|	ОбъектыНедвижимости.Представление КАК Представление
			|ИЗ
			|	Справочник.ОбъектыНедвижимости КАК ОбъектыНедвижимости
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокСНедвижимостью.СрезПоследних(
			|				&МоментДокумента,
			|				СчетДоверительногоУправления = &СчетДоверительногоУправления
			|					И Организация = &Организация
			|					И ОбъектНедвижимости = &ОбъектНедвижимости) КАК УсловияСделокСНедвижимостьюСрезПоследних
			|		ПО (УсловияСделокСНедвижимостьюСрезПоследних.ОбъектНедвижимости = ОбъектыНедвижимости.Ссылка)
			|			И (НЕ УсловияСделокСНедвижимостьюСрезПоследних.Отменено)
			|			И (УсловияСделокСНедвижимостьюСрезПоследних.АктПриемаПередачи <> ЗНАЧЕНИЕ(Документ.АктПриемаПередачиОбъектовНедвижимости.ПустаяСсылка))
			|ГДЕ
			|	ОбъектыНедвижимости.Ссылка = &ОбъектНедвижимости
			|
			|СГРУППИРОВАТЬ ПО
			|	ОбъектыНедвижимости.Представление
			|
			|ИМЕЮЩИЕ
			|	СУММА(ЕСТЬNULL(ВЫБОР
			|				КОГДА УсловияСделокСНедвижимостьюСрезПоследних.Основание.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
			|					ТОГДА 1
			|				КОГДА УсловияСделокСНедвижимостьюСрезПоследних.Основание.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
			|					ТОГДА -1
			|				ИНАЧЕ 0
			|			КОНЕЦ, 0)) <> 1";
		
		Запрос.УстановитьПараметр("МоментДокумента", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("ОбъектНедвижимости", ЭтотОбъект.ОбъектНедвижимости);
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Объект недвижимости " + ВыборкаДетальныеЗаписи.Представление + " не обнаружен по данным бэк-офиса!", Ссылка,,, Отказ);
		КонецЦикла;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры // ПриЗаписи

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти
