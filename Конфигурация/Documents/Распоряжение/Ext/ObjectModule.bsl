
#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
		
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "ДатаВозврата, Сумма");
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтотОбъект.ВидОперации = Перечисления.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента Тогда
		
		Если Не ЗначениеЗаполнено(ЭтотОбъект.Банк) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Значение поля [Банк] не заполнено",, "Объект.Банк",, Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ЭтотОбъект.ДатаРазмещения) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Значение поля [Дата размещения] не заполнено",, "Объект.ДатаРазмещения",, Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ЭтотОбъект.ПериодичностьВыплатыПроцентов) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Значение поля [Периодичность выплаты процентов] не заполнено",, "Объект.ПериодичностьВыплатыПроцентов",, Отказ);
		КонецЕсли;

		Если ПроверяемыеРеквизиты.Найти("РасчетныйСчет") <> Неопределено И ЭтотОбъект.Биржевой Тогда
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("РасчетныйСчет"));
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ЭтотОбъект.РасчетныйСчетВозвратаДенежныхСредств) И Не ЭтотОбъект.Биржевой Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Значение поля [Расчетный счет возврата денежных средств] не заполнено",, "Объект.РасчетныйСчетВозвратаДенежныхСредств",, Отказ);
		КонецЕсли;
		
		Если ЭтотОбъект.ДоВостребования И Не ЗначениеЗаполнено(ЭтотОбъект.ПроцентнаяСтавкаПриДосрочномЗакрытии) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Значение поля [Процентная ставка при досрочном закрытии депозита] не заполнено",, "Объект.ПроцентнаяСтавкаПриДосрочномЗакрытии",, Отказ);	
		КонецЕсли;
		
	КонецЕсли;
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, Ложь);
	
	Если Не РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) И ЭтотОбъект.ПометкаУдаления
		И ЭтотОбъект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.МНО")
		И РаботаСДокументами.ДействуетКонтрольНаличияНомеровПодтверждения(ЭтотОбъект.Дата, ЭтотОбъект.Организация) Тогда
													
		ЗарегистрированныеНомера = РегистрыСведений.НомераОбъектов.ПолучитьЗарегистрированныеНомера(
									ЭтотОбъект.Организация,
									Справочники.ВидыНумерацииОбъектов.РаспоряженияНаМНО,
									РаботаСКоллекциями.ЗначениеВМассив(ЭтотОбъект.Ссылка),
									ЭтотОбъект.СчетДоверительногоУправления,
									Год(ЭтотОбъект.Дата));
		
		Если ЗарегистрированныеНомера <> Неопределено Тогда
			
			ТекНомерПодтверждения = РаботаСоСтрокамиКлиентСервер.СократитьЛидирующиеНули(ЗарегистрированныеНомера[ЭтотОбъект.Ссылка]);							
								
			Если ЗначениеЗаполнено(ТекНомерПодтверждения) И Не (РольДоступна("ПолныеПрава") Или РольДоступна("ОперацииБэкОфиса")) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Распоряжению присвоен номер [" + ТекНомерПодтверждения + "]. Для отмены распоряжения обратитесь в бэк-офис.'"),,,, Отказ);								
			КонецЕсли;
			
		КонецЕсли;
							
		Возврат;
				
	КонецЕсли;
	
	// блокирующие проверки
	Если ЭтотОбъект.ВидОперации = Перечисления.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента Тогда
		
		Если ЭтотОбъект.ДатаРазмещения > ЭтотОбъект.ДатаВозврата Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Дата возврата меньше даты размещения депозита.'"), ЭтотОбъект, "ДатаВозврата",, Отказ);
		КонецЕсли;
		
	Иначе
		
		Если ЭтотОбъект.Дата > ЭтотОбъект.ДатаВозврата Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Дата возврата МНО меньше даты документа.'"), ЭтотОбъект, "ДатаВозврата",, Отказ);
		КонецЕсли;
		
		Если Не (ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ")
				Или ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.РасчетныйСчет, "ДоговорМНО"))) Тогда
				
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='В расчетном счете " + ЭтотОбъект.РасчетныйСчет + " отсутствует соглашение МНО.'"), ЭтотОбъект, "РасчетныйСчет",, Отказ);	
			
		КонецЕсли;
		
		Если Не ЭтотОбъект.Ссылка.Пустая() Тогда
	
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	МНО.*
				|ИЗ
				|	Документ.МНО КАК МНО
				|ГДЕ
				|	МНО.Основание = &Ссылка
				|	И МНО.Проведен";
			
			Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			ПроверяемыеРеквизиты = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("Организация,СчетДоверительногоУправления,РасчетныйСчет,Процент,Сумма,ДатаВозврата", ",", Истина, Истина);
			
			Пока Выборка.Следующий() Цикл
				
				Для Каждого ИмяРеквизита Из ПроверяемыеРеквизиты Цикл
					
					Если Выборка[ИмяРеквизита] <> ЭтотОбъект[ИмяРеквизита] Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Значения поля """ + ИмяРеквизита + """ не совпадает со значением в МНО, введенном на основании", ЭтотОбъект, ИмяРеквизита,, Отказ);
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла; 
			
			ДатаАкцепта = РаботаСДокументами.ПолучитьДатуАкцептования(ЭтотОбъект.Ссылка, ЭтотОбъект.Организация); 
			
			Если ЗначениеЗаполнено(ДатаАкцепта) И ДатаАкцепта < ЭтотОбъект.Дата Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата распоряжения [" + ЭтотОбъект.Дата + "] не может быть позже даты акцепта [" + ДатаАкцепта + "]", ЭтотОбъект, "Дата",, Отказ);		
			КонецЕсли;

		КонецЕсли;		
		
	КонецЕсли; 
	
	Если РежимЗаписи = РежимЗаписиДокумента.Запись И Не ЭтотОбъект.ДополнительныеСвойства.Свойство("ПройденКонтрольКонфликтаИнтересов") Тогда 
		
		Запрос = Новый Запрос;
		
#Область Текст_Запроса
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	Распоряжение.СчетДоверительногоУправления КАК СчетДУ,
			|	Распоряжение.Процент КАК Процент
			|ИЗ
			|	Документ.Распоряжение КАК Распоряжение
			|ГДЕ
			|	НЕ Распоряжение.ПометкаУдаления
			|	И Распоряжение.Организация = &Организация
			|	И НАЧАЛОПЕРИОДА(Распоряжение.Дата, ДЕНЬ) = &НачалоДня
			|	И Распоряжение.ВидОперации = &ВидОперации
			|	И Распоряжение.ДатаРазмещения = &ДатаРазмещения
			|	И Распоряжение.ДатаВозврата = &ДатаВозврата
			|	И Распоряжение.Валюта = &Валюта
			|	И (&ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО)
			|				И Распоряжение.РасчетныйСчет.Банк.Код = &БИК
			|			ИЛИ &ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
			|				И Распоряжение.Банк.Код = &БИК)
			|	И (&ЭтоСобственныйПортфель
			|				И Распоряжение.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный)
			|				И Распоряжение.Процент < &Процент
			|			ИЛИ НЕ &ЭтоСобственныйПортфель
			|				И Распоряжение.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный)
			|				И Распоряжение.Процент > &Процент)";
#КонецОбласти

		Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ЭтотОбъект.Дата));
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("ВидОперации", ЭтотОбъект.ВидОперации);
		Запрос.УстановитьПараметр("ДатаРазмещения", ЭтотОбъект.ДатаРазмещения);
		Запрос.УстановитьПараметр("ДатаВозврата", ЭтотОбъект.ДатаВозврата);
		Запрос.УстановитьПараметр("Валюта", ЭтотОбъект.Валюта);
		Запрос.УстановитьПараметр("Процент", ЭтотОбъект.Процент);
		Запрос.УстановитьПараметр("ЭтоСобственныйПортфель", 
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления") = Перечисления.ВидыДоговоровДоверительногоУправления.Собственный);
				
		БикБанка = "";
		
		Если ЭтотОбъект.ВидОперации = Перечисления.ВидыОперацийБэкОфиса.МНО Тогда		
			БикБанка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.РасчетныйСчет, "Банк"), "Код"); 
		ИначеЕсли ЭтотОбъект.ВидОперации = Перечисления.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента Тогда
			БикБанка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Банк, "Код");
		КонецЕсли;
			
		Если ЗначениеЗаполнено(БикБанка) Тогда
			Запрос.УстановитьПараметр("БИК", БикБанка);	
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определеть БИК банка.",,,, Отказ);
			Возврат;
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Распоряжение не прошло проверку конфликта интересов."
				+ " В учетной системе присутсвует распоряжение по счету д/у [" + Выборка.СчетДУ + "] и процентной ставкой [" + Выборка.Процент + "]",,,, Отказ);		
		КонецЕсли;
			
	КонецЕсли;
	 	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект); 
										
	Если Не ЭтотОбъект.ПометкаУдаления И ЭтотОбъект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийБэкОфиса.МНО")
		И РаботаСДокументами.ДействуетКонтрольНаличияНомеровПодтверждения(ЭтотОбъект.Дата, ЭтотОбъект.Организация) Тогда 
				
		ВидНумерацииРаспоряжения = Справочники.ВидыНумерацииОбъектов.ПолучитьВидНумерацииОперации(ТипЗнч(ЭтотОбъект.Ссылка), ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Банк, ЭтотОбъект.ВидОперации);
		
		Если ЗначениеЗаполнено(ВидНумерацииРаспоряжения) Тогда
			
			УстановитьПривилегированныйРежим(Истина);	

			РегистрыСведений.НомераОбъектов.ЗарегистрироватьНовыйНомер(
				ЭтотОбъект.Организация, 
				ВидНумерацииРаспоряжения, 
				ЭтотОбъект.Ссылка, 
				ЭтотОбъект.СчетДоверительногоУправления, 
				Год(ЭтотОбъект.Дата), 
				Отказ);  	
			
			УстановитьПривилегированныйРежим(Ложь);
			
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЕсли;
		
	Если ЭтотОбъект.ВидОперации = Перечисления.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента Тогда
		
		Если Не ЭтотОбъект.ДополнительныеСвойства.ЭтоНовый И Не РаботаСПользователями.ЭтоПолноправныйПользователь() Тогда
			
			Запрос = Новый Запрос;
			
	#Область ТЕКСТ_ЗАПРОСА
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	Распоряжение.Ссылка КАК Распоряжение,
				|	Распоряжение.Дата КАК Дата,
				|	Распоряжение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	Распоряжение.РасчетныйСчет КАК РасчетныйСчет,
				|	Распоряжение.Процент КАК Процент,
				|	Распоряжение.ДатаРазмещения КАК ДатаРазмещения,
				|	Распоряжение.ДатаВозврата КАК ДатаВозврата,
				|	Распоряжение.Банк КАК Банк,
				|	Распоряжение.Сумма КАК Сумма,
				|	Распоряжение.Валюта КАК Валюта,
				|	Распоряжение.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
				|	Распоряжение.РасчетныйСчетВозвратаДенежныхСредств КАК РасчетныйСчетВозвратаДенежныхСредств,
				|	Распоряжение.ДоВостребования КАК ДоВостребования,
				|	Распоряжение.ПроцентнаяСтавкаПриДосрочномЗакрытии КАК ПроцентнаяСтавкаДоВостребования,
				|	Распоряжение.Субординированность КАК Субординированность,
				|	РазмещениеКредитногоИнструмента.Ссылка КАК РазмещениеКредитногоИнструмента,
				|	РазмещениеКредитногоИнструмента.СчетДоверительногоУправления КАК СчетДоверительногоУправленияРазмещение,
				|	РазмещениеКредитногоИнструмента.РасчетныйСчет КАК РасчетныйСчетРазмещение,
				|	РазмещениеКредитногоИнструмента.Сумма КАК СуммаРазмещение,
				|	РазмещениеКредитногоИнструмента.КредитныйИнструмент КАК КредитныйИнструмент
				|ПОМЕСТИТЬ _ЗначенияРеквизитовРаспоряженияИРазмещения
				|ИЗ
				|	Документ.Распоряжение КАК Распоряжение
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РазмещениеКредитногоИнструмента КАК РазмещениеКредитногоИнструмента
				|		ПО Распоряжение.Ссылка = РазмещениеКредитногоИнструмента.Основание
				|			И (Распоряжение.Ссылка = &Ссылка)
				|			И (РазмещениеКредитногоИнструмента.Проведен)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ВложенныйЗапрос.Распоряжение КАК Распоряжение,
				|	ДепозитныеВклады.Ссылка КАК ДепозитныйВклад,
				|	ДепозитныеВклады._НачальныйНоминал КАК _НачальныйНоминал,
				|	ДепозитныеВклады.БанковскийСчет.Валюта КАК Валюта,
				|	ДепозитныеВклады.ДатаРегистрации КАК ДатаРазмещения,
				|	ДепозитныеВклады.ДоВостребования КАК ДоВостребования,
				|	ДепозитныеВклады.Субординированность КАК Субординированность,
				|	ДепозитныеВклады.ПроцентнаяСтавкаПриДосрочномЗакрытии КАК ПроцентнаяСтавкаДоВостребования,
				|	УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
				|	УсловияКредитныхИнструментовСрезПоследних.Процент КАК Процент,
				|	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаВозврата,
				|	УсловияКредитныхИнструментовСрезПоследних.РасчетныйСчетВозвратаДенежныхСредств КАК РасчетныйСчетВозвратаДенежныхСредств,
				|	УсловияКредитныхИнструментовСрезПоследних.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов
				|ПОМЕСТИТЬ _УсловияВклада
				|ИЗ
				|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
				|		РазмещениеКредитногоИнструмента.Основание КАК Распоряжение,
				|		РазмещениеКредитногоИнструмента.КредитныйИнструмент КАК КредитныйИнструмент 
				|		ИЗ
				|			Документ.РазмещениеКредитногоИнструмента КАК РазмещениеКредитногоИнструмента 
				|		ГДЕ
				|			РазмещениеКредитногоИнструмента.Основание = &Ссылка) КАК ВложенныйЗапрос 
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
				|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
				|					&ДатаРазмещения,
				|					КредитныйИнструмент В
				|						(ВЫБРАТЬ
				|							_ЗначенияРеквизитовРаспоряженияИРазмещения.КредитныйИнструмент
				|						ИЗ
				|							_ЗначенияРеквизитовРаспоряженияИРазмещения КАК _ЗначенияРеквизитовРаспоряженияИРазмещения)) КАК УсловияКредитныхИнструментовСрезПоследних
				|			ПО ДепозитныеВклады.ДатаРегистрации = УсловияКредитныхИнструментовСрезПоследних.Период
				|				И ДепозитныеВклады.Ссылка = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
				|				И (УсловияКредитныхИнструментовСрезПоследних.Действует)
				|		ПО ВложенныйЗапрос.КредитныйИнструмент = ДепозитныеВклады.Ссылка
				|			И (НЕ ДепозитныеВклады.ПометкаУдаления)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	""Редактирование документа запрещено! На основании распоряжения создан документ [%1]."" КАК ТекстСообщения,
				|	_ЗначенияРеквизитовРаспоряженияИРазмещения.РазмещениеКредитногоИнструмента КАК Параметр1
				|ИЗ
				|	_ЗначенияРеквизитовРаспоряженияИРазмещения КАК _ЗначенияРеквизитовРаспоряженияИРазмещения
				|ГДЕ
				|	(_ЗначенияРеквизитовРаспоряженияИРазмещения.СчетДоверительногоУправления <> _ЗначенияРеквизитовРаспоряженияИРазмещения.СчетДоверительногоУправленияРазмещение
				|			ИЛИ _ЗначенияРеквизитовРаспоряженияИРазмещения.РасчетныйСчет <> _ЗначенияРеквизитовРаспоряженияИРазмещения.РасчетныйСчетРазмещение
				|			ИЛИ _ЗначенияРеквизитовРаспоряженияИРазмещения.Сумма <> _ЗначенияРеквизитовРаспоряженияИРазмещения.СуммаРазмещение)
				|
				|ОБЪЕДИНИТЬ
				|
				|ВЫБРАТЬ
				|	""Редактирование документа запрещено! На основании данных распоряжения сформирован депозитный вклад [%1]."",
				|	_ЗначенияРеквизитовРаспоряженияИРазмещения.КредитныйИнструмент
				|ИЗ
				|	_ЗначенияРеквизитовРаспоряженияИРазмещения КАК _ЗначенияРеквизитовРаспоряженияИРазмещения
				|		ЛЕВОЕ СОЕДИНЕНИЕ _УсловияВклада КАК _УсловияВклада
				|		ПО _ЗначенияРеквизитовРаспоряженияИРазмещения.Распоряжение = _УсловияВклада.Распоряжение
				|ГДЕ
				|	(_ЗначенияРеквизитовРаспоряженияИРазмещения.Сумма <> _УсловияВклада._НачальныйНоминал
				|			ИЛИ _ЗначенияРеквизитовРаспоряженияИРазмещения.Валюта <> _УсловияВклада.Валюта
				|			ИЛИ _ЗначенияРеквизитовРаспоряженияИРазмещения.ДатаРазмещения <> _УсловияВклада.ДатаРазмещения
				|			ИЛИ _ЗначенияРеквизитовРаспоряженияИРазмещения.ДоВостребования <> _УсловияВклада.ДоВостребования
				|			ИЛИ _ЗначенияРеквизитовРаспоряженияИРазмещения.Субординированность <> _УсловияВклада.Субординированность
				|			ИЛИ _ЗначенияРеквизитовРаспоряженияИРазмещения.ПроцентнаяСтавкаДоВостребования <> _УсловияВклада.ПроцентнаяСтавкаДоВостребования)
				|
				|ОБЪЕДИНИТЬ
				|
				|ВЫБРАТЬ
				|	""Ошибка! Для депозитного вклада [%1] отсутствуют условия в регистре [Условия кредитных инструментов]."",
				|	_ЗначенияРеквизитовРаспоряженияИРазмещения.КредитныйИнструмент
				|ИЗ
				|	_ЗначенияРеквизитовРаспоряженияИРазмещения КАК _ЗначенияРеквизитовРаспоряженияИРазмещения
				|		ЛЕВОЕ СОЕДИНЕНИЕ _УсловияВклада КАК _УсловияВклада
				|		ПО _ЗначенияРеквизитовРаспоряженияИРазмещения.Распоряжение = _УсловияВклада.Распоряжение
				|ГДЕ
				|	_УсловияВклада.КредитныйИнструмент ЕСТЬ NULL
				|
				|ОБЪЕДИНИТЬ
				|
				|ВЫБРАТЬ
				|	""Редактирование документа запрещено! На основании данных распоряжения сформированы условия для депозитного вклада [%1]."",
				|	_ЗначенияРеквизитовРаспоряженияИРазмещения.КредитныйИнструмент
				|ИЗ
				|	_ЗначенияРеквизитовРаспоряженияИРазмещения КАК _ЗначенияРеквизитовРаспоряженияИРазмещения
				|		ЛЕВОЕ СОЕДИНЕНИЕ _УсловияВклада КАК _УсловияВклада
				|		ПО _ЗначенияРеквизитовРаспоряженияИРазмещения.Распоряжение = _УсловияВклада.Распоряжение
				|ГДЕ
				|	НЕ _УсловияВклада.КредитныйИнструмент ЕСТЬ NULL
				|	И (_ЗначенияРеквизитовРаспоряженияИРазмещения.Процент <> _УсловияВклада.Процент
				|			ИЛИ _ЗначенияРеквизитовРаспоряженияИРазмещения.ДатаВозврата <> _УсловияВклада.ДатаВозврата
				|			ИЛИ _ЗначенияРеквизитовРаспоряженияИРазмещения.РасчетныйСчетВозвратаДенежныхСредств <> _УсловияВклада.РасчетныйСчетВозвратаДенежныхСредств
				|			ИЛИ _ЗначенияРеквизитовРаспоряженияИРазмещения.ПериодичностьВыплатыПроцентов <> _УсловияВклада.ПериодичностьВыплатыПроцентов)";
	#КонецОбласти 		
			
			Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
			Запрос.УстановитьПараметр("ДатаРазмещения", ЭтотОбъект.ДатаРазмещения);

			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Выборка.ТекстСообщения, Выборка.Параметр1),,,, Отказ);
			КонецЦикла;
			
		КонецЕсли;
		
		Если Не Отказ И (НачалоДня(ТекущаяДатаСеанса()) <= ЭтотОбъект.ДатаРазмещения) Тогда
		
			СоздатьОтложенноеЗаданиеКонтроляИД();
		
		КонецЕсли;
					
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Процедура СоздатьОтложенноеЗаданиеКонтроляИД()
	
	ИмяОбъекта = "_КонтрольИнвестиционныхДеклараций";  
	ДополнительнаяОбработкаСсылка = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта(ИмяОбъекта);
	
	Если ДополнительнаяОбработкаСсылка = Неопределено Тогда
		ТекстОшибки = "Не удалось добавить отложенное задание контроля ИД по распоряжению на депозит. Обработка '" + ИмяОбъекта + "' не найдена";
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ТекстОшибки, "Контроль инвестиционных деклараций");
		Возврат;
	КонецЕсли;
	
	ДатаЗапуска = ЭтотОбъект.ДатаРазмещения + 11 * 3600;
	
	Если ТекущаяДатаСеанса() > ДатаЗапуска Тогда
	
		//Устанавливаем время запуска так, чтобы оно было кратно 5 (17:10, 17:15, 17:20 и т.д.)
		//Если разница между текущим временем и ближайшим временем, которое кратно 5 больше 3 минут - устанавливаем ближайшее время кратное 5 (17:01 -> 07:05)
		//Если меньше 3 минут - сдвигаем на следующее время кратное 5 (17:04 - > 07:10)
		
		ДатаЗапуска = ТекущаяДатаСеанса();
		ДельтаМин = Минута(ДатаЗапуска) - (Цел(Минута(ДатаЗапуска) / 5) * 5);
	 	ДатаЗапуска = НачалоМинуты(ДатаЗапуска + 60 * (?(ДельтаМин >= 2, 10, 5) - ДельтаМин));		
	
	КонецЕсли;
	
	Параметры = Новый Структура("Организация, СчетДоверительногоУправления");
	ЗаполнитьЗначенияСвойств(Параметры, ЭтотОбъект);
	Параметры.Вставить("Период", ЭтотОбъект.ДатаРазмещения);
	
	Параметры.Вставить("ИсточникОшибки", "Контроль инвестиционных деклараций");
	Параметры.Вставить("ТекстОшибки", "Не удалось добавить отложенное задание '_КонтрольИнвестиционныхДеклараций.КонтрольДепозитов'.");
	
	РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание(ДополнительнаяОбработкаСсылка, "КонтрольДепозитов", Параметры, 5, Истина, ДатаЗапуска);
	
КонецПроцедуры