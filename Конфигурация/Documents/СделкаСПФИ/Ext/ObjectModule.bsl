Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	Движения.ЗадолженностиПоДенежнымСредствам.Записывать = Истина;
	Движения.ОстаткиДенежныхСредств.Записывать = Истина;
	
	Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
	
	Движение.Период                       = ЭтотОбъект.Дата;
	Движение.Основание                    = ЭтотОбъект.Ссылка;
	Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Кредиторская;
	Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоТорговойКомиссии;
	Движение.Организация                  = ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
	Движение.Контрагент                   = ЭтотОбъект.Контрагент;
	Движение.Валюта                       = ЭтотОбъект.Валюта;
	Движение.Сумма                        = ЭтотОбъект.КлиринговыйСбор;
	
	Если Не ЭтотОбъект.ОтложеннаяОплатаКлиринговогоСбора Тогда
		ЗаполнитьЗначенияСвойств(Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьРасход(), Движение,, "ВидДвижения");
		
		Движение = Движения.ОстаткиДенежныхСредств.ДобавитьРасход();
		
		Движение.Период                         = ЭтотОбъект.Дата;
		Движение.Организация                    = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления   = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Брокер                         = ЭтотОбъект.Брокер;
		Движение.МестоХранения                  = ЭтотОбъект.МестоХранения;
		Движение.Валюта                         = ЭтотОбъект.Валюта;
		Движение.Сумма                          = ЭтотОбъект.КлиринговыйСбор;
		Движение.ВидДвиженияДенежныхСредств     = Перечисления.ВидыДвиженийДенежныхСредств.Оплата;
		Движение.ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоТорговойКомиссии;
		
	КонецЕсли;
	
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт
	
	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПроизводныеФинансовыеИнструментыОснованныеНаПроцентныхДоговорах;
	
	// Глава Г
	
	// Завесим номинал в обе стороны
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ЭтотОбъект.Номинал, "Номинал СПФИ");
	
	// дебет
	Проводка.СчетДт = УчетныйАктивЕПС.СчетУчетаТребованийПоПоставке;
	
	Проводка.СубконтоДт.ЦенныеБумаги = ЭтотОбъект.Ссылка;
	Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
	
	Проводка.ВалютаДт = ЭтотОбъект.Валюта;
	Проводка.ВалютнаяСуммаДт = ЭтотОбъект.Номинал;
	
	Проводка.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.НоминалСПФИ;
	
	// кредит
	Проводка.СчетКт = ПланыСчетов.Единый.КорреспонденцияСАктивом;
	
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ЭтотОбъект.Номинал, "Номинал СПФИ");
	
	// дебет
	Проводка.СчетДт = ПланыСчетов.Единый.КорреспонденцияСПассивом;
	
	// кредит
	Проводка.СчетКт = УчетныйАктивЕПС.СчетУчетаОбязательствПоПоставке;
	
	Проводка.СубконтоКт.ЦенныеБумаги = ЭтотОбъект.Ссылка;
	Проводка.СубконтоКт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;;
	
	Проводка.ВалютаКт = ЭтотОбъект.Валюта;
	Проводка.ВалютнаяСуммаКт = ЭтотОбъект.Номинал;
	
	Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.НоминалСПФИ;
	
	// Клиринговый сбор
	Если ЭтотОбъект.КлиринговыйСбор > 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ЭтотОбъект.КлиринговыйСбор, "Комиссия биржи");
		
		Проводка.СчетДт = ПланыСчетов.Единый.ПрочиеДоходыРасходы02;
		Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = Справочники.ГруппыФинансовогоУчетаДоходовРасходов.НайтиПоКоду("53106");
		Проводка.СубконтоДт.ЦенныеБумаги = ЭтотОбъект.Ссылка;
		
		
		Проводка.СчетКт = ПланыСчетов.Единый.Расчеты22;
		Проводка.СубконтоКт.Контрагенты = ЭтотОбъект.Контрагент;
		Проводка.СубконтоКт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
		
		Проводка.ВалютаКт = ЭтотОбъект.Валюта;
		Проводка.ВалютнаяСуммаКт = ЭтотОбъект.КлиринговыйСбор;
		
		Если НЕ ЭтотОбъект.ОтложеннаяОплатаКлиринговогоСбора Тогда
			
			СчетДС = ПланыСчетов.Единый.РасчетыСБрокерами02; // пока предполагаем только через брокера
			ВидСубконтоДС = ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания;
			СубконтоДС = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
			
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ЭтотОбъект.КлиринговыйСбор, "Списание комиссии биржи");
			
			Проводка.СчетДт = ПланыСчетов.Единый.Расчеты22;
			
			Проводка.СубконтоДт.Контрагенты = ЭтотОбъект.Контрагент;
			Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
			
			Проводка.ВалютаДт  = ЭтотОбъект.Валюта;
			Проводка.ВалютнаяСуммаДт = ЭтотОбъект.КлиринговыйСбор;
			
			Проводка.СчетКт = СчетДС;
			
			Проводка.СубконтоКт[ВидСубконтоДС] 	= СубконтоДС;
			Проводка.СубконтоКт.ВидДвиженияДенежныхСредств 	= Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссия;
			
			Проводка.ВалютаКт  = ЭтотОбъект.Валюта;
			Проводка.ВалютнаяСуммаКт = ЭтотОбъект.КлиринговыйСбор;
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры //ПроведениеПоРегиструЕПС

Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт 
	
	// Клиринговый сбор
	Если ЭтотОбъект.КлиринговыйСбор > 0 Тогда
		
		Движения[УчетныйРегистр].Записывать = Истина;
		
		ТаблицаЦБ = Новый ТаблицаЗначений;
		ТаблицаЦБ.Колонки.Добавить("ЦеннаяБумага", Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип); 
		НовСтрока = ТаблицаЦБ.Добавить();
		НовСтрока.ЦеннаяБумага = ЭтотОбъект.Ссылка;
		
		СведенияОбОбращенииЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(ЭтотОбъект.Дата, ЭтотОбъект.Ссылка, УчетныйРегистр, , ТаблицаЦБ);
		
		НайденныеСведенияОбОбращенииЦенныхБумагНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(ЭтотОбъект.Ссылка, "ЦеннаяБумага");
		
		Если ЗначениеЗаполнено(НайденныеСведенияОбОбращенииЦенныхБумагНаОРЦБ) Тогда
			ОбращаетсяНаОРЦБ = НайденныеСведенияОбОбращенииЦенныхБумагНаОРЦБ.ОбращаетсяНаОРЦБ;
		Иначе
			ОбращаетсяНаОРЦБ = Ложь;
		КонецЕсли;
		
		
		СчетУчетаКомиссии = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
			ЭтотОбъект.Дата, 
			ЭтотОбъект.Организация, 
			ЭтотОбъект.СчетДоверительногоУправления,
			Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
			УчетныйРегистр,
			"СчетУчета");
			
		АналитикаУслуг = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
			ЭтотОбъект.Дата, 
			ЭтотОбъект.Организация, 
			ЭтотОбъект.СчетДоверительногоУправления,
			Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
			УчетныйРегистр,
			"Аналитика");
			
		ЕстьСубконтоКонтрагентыПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);						
			
		ЕстьСубконтоСделкиПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Сделка) <> Неопределено);
		
		ЕстьСубконтоДС = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено);
		
		Если ЕстьСубконтоДС Тогда
			СубконтоДС = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
		КонецЕсли;	
		
		ЕстьВалютныйУчет = СчетУчетаКомиссии.Валютный;
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ЭтотОбъект.КлиринговыйСбор, "Приняты расходы комиссия брокера и биржи");
		
		Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
		Проводка.СубконтоДт.ПрочиеДоходыИРасходы = ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_КомиссияБиржиБрокераИлиТорговая");
		Проводка.СубконтоДт.ЦенныеБумаги = ЭтотОбъект.Ссылка;
		Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
		
		Проводка.СчетКт = СчетУчетаКомиссии;
		
		Если ЕстьСубконтоКонтрагентыПоКомиссии Тогда
			Проводка.СубконтоКт.Контрагенты = ЭтотОбъект.Контрагент;
		КонецЕсли;
		
		Если ЕстьСубконтоСделкиПоКомиссии Тогда
			Проводка.СубконтоКт.Сделка = ЭтотОбъект.Ссылка;
		КонецЕсли;	
		
		Если ЕстьСубконтоДС Тогда
			Проводка.СубконтоКт.Контрагенты = ЭтотОбъект.Брокер.ЮрФизЛицо;
			Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДС;
		КонецЕсли;	
		
		Если ЕстьВалютныйУчет Тогда
			Проводка.ВалютаКт = ЭтотОбъект.Валюта;
			Проводка.ВалютнаяСуммаКт = ЭтотОбъект.КлиринговыйСбор;
		КонецЕсли;
		
		Если Не ЭтотОбъект.ОтложеннаяОплатаКлиринговогоСбора Тогда
			СчетУчетаДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(ЭтотОбъект.Дата,
				ЭтотОбъект.Организация,
				ЭтотОбъект.СчетДоверительногоУправления,
				ЭтотОбъект.Валюта,
				ЭтотОбъект.Брокер);
				
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ЭтотОбъект.КлиринговыйСбор, "Оплата комиссия брокера и биржи");
			
			Проводка.СчетДт = СчетУчетаКомиссии;
			
			Если ЕстьСубконтоКонтрагентыПоКомиссии Тогда
				Проводка.СубконтоДт.Контрагенты = ЭтотОбъект.Контрагент;
			КонецЕсли;
			
			Если ЕстьСубконтоСделкиПоКомиссии Тогда
				Проводка.СубконтоДт.Сделка = ЭтотОбъект.Ссылка;
			КонецЕсли;	
			
			Если ЕстьСубконтоДС Тогда
				Проводка.СубконтоДт.Контрагенты = ЭтотОбъект.Брокер.ЮрФизЛицо;
				Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = СубконтоДС;
			КонецЕсли;	
			
			Если ЕстьВалютныйУчет Тогда
				Проводка.ВалютаДт = ЭтотОбъект.Валюта;
				Проводка.ВалютнаяСуммаДт = ЭтотОбъект.КлиринговыйСбор;
			КонецЕсли;
			
			Проводка.СчетКт = СчетУчетаДС;
			
			ЕстьБрокер							= СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено;
			ЕстьДоговорыБрокерскогоОбслуживания	= СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено;
			ЕстьВидДвиженияДС					= СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено;
			ЕстьРасчетныйСчет                	= СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено;
			ЕстьВалютныйУчетДС					= СчетУчетаДС.Валютный;
			
			Если ЕстьБрокер Тогда
				Проводка.СубконтоКт.БрокерскиеКомпании = ЭтотОбъект.Брокер;
			КонецЕсли;
			
			Если ЕстьВидДвиженияДС Тогда
				Если Не ЗначениеЗаполнено(СубконтоДС) Тогда
					СубконтоДС = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
				КонецЕсли;	
				Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДС;
			КонецЕсли;	
			
			Если ЕстьВидДвиженияДС Тогда
				Проводка.СубконтоКт.ВидДвиженияДенежныхСредств 	= Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссия;
			КонецЕсли;	
			
			Если ЕстьВалютныйУчетДС Тогда
				Проводка.ВалютаКт  = ЭтотОбъект.Валюта;
				Проводка.ВалютнаяСуммаКт = ЭтотОбъект.КлиринговыйСбор;
			КонецЕсли;	
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
		
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
	Если ЭтотОбъект.ПометкаУдаления Тогда
		
		Возврат;
		
	КонецЕсли;
			
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры // ОбработкаПроведения

#КонецОбласти

