&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АдресТаблицыОшибок") Тогда
		ЭтаФорма.АдресТаблицыОшибок = Параметры.АдресТаблицыОшибок;
		Структура = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресТаблицыОшибок);
		
		ЕстьОшибки = Структура.ТаблицаОшибок.Количество() > 0;
		ЕстьСообщения = Структура.СообщенияПользователю.Количество() > 0;
		
		Элементы.Ошибки.Видимость = ЕстьОшибки;
		Элементы.ОшибкиКомандаИмпортироватьОбъектыИзМатрикс.Видимость = ЕстьОшибки;
		Элементы.Сообщения.Видимость = ЕстьСообщения;
		
		Если ЕстьОшибки Тогда
		
			ЭтаФорма.Ошибки.Загрузить(Структура.ТаблицаОшибок);
		
		КонецЕсли; 
		
		Если ЕстьСообщения Тогда
		
			Для каждого Сообщение Из Структура.СообщенияПользователю Цикл
				НоваяСтрока = ЭтаФорма.Сообщения.Добавить();
				НоваяСтрока.Информация = Сообщение.Текст;
			КонецЦикла; 
		
		КонецЕсли; 

	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаИмпортироватьОбъектыИзМатрикс(Команда)
	
	ТекСтрока = Элементы.Ошибки.ТекущиеДанные;
	ГруппаОбъектов = ПредопределенноеЗначение("Справочник.ГруппыИмпортируемыхОбъектов.Облигации");
	СтрокаПоиска = "";
	
	Если ТекСтрока <> Неопределено Тогда
		
		Если ЗначениеЗаполнено(ТекСтрока.Рынок) Тогда
			ГруппаОбъектов = ОпределитьГруппуОбъектовПоРынку(ТекСтрока.Рынок);
		КонецЕсли; 
		
		СтрокаПоиска = ТекСтрока.ИдентификаторЦеннойБумаги;
		
	КонецЕсли;
	
	Если ГруппаОбъектов = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Импорт объектов из Matrix для рынка '" + ТекСтрока.Рынок + "' не поддерживается.");
		Возврат;
	КонецЕсли; 
	
	ПараметрыИмпорта = Новый Структура;
	ПараметрыИмпорта.Вставить("ГруппаПравил",                      "Матрих");
	ПараметрыИмпорта.Вставить("ГруппаОбъектов",                    ГруппаОбъектов);
	ПараметрыИмпорта.Вставить("ЗакрытьФормуПослеУспешногоИмпорта", Истина);
	
	Форма = ПолучитьФорму("Обработка.ИмпортНормативноСправочнойИнформации.Форма", ПараметрыИмпорта);
	Форма.СтрокаПоиска = СтрокаПоиска;
	ОбработанныеОбъекты = Форма.ОткрытьМодально();
	
	Если ТекСтрока <> Неопределено И ТипЗнч(ОбработанныеОбъекты) = Тип("Массив") И ОбработанныеОбъекты.Количество() > 0 Тогда
		ТекСтрока.ЦеннаяБумага = ОбработанныеОбъекты[0];
		ТекСтрока.Рынок = РаботаСЦеннымиБумагамиКлиентСервер.РынокПоЦеннойБумаге(ТекСтрока.ЦеннаяБумага);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОпределитьГруппуОбъектовПоРынку(Рынок)

	Если Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
		ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.Акции;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.ВалютныеПары Тогда
		ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.ВалютныеПары;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Векселя Тогда
		ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.Векселя;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.ДепозитарныеРасписки Тогда
		ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.ДепозитарныеРасписки;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия Тогда
		ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.ИпотечныеСертификатыУчастия;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.Облигации;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Паи Тогда
		ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.Паи;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Фьючерсы
			Или Рынок = Перечисления.РынкиЦенныхБумаг.Опционы 
			Или Рынок = Перечисления.РынкиЦенныхБумаг.ДрагоценныеМеталлы Тогда
			
		ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.ПроизводныеФинансовыеИнструменты;
		
	Иначе
		ГруппаОбъектов = Неопределено;
	КонецЕсли;
	
	Возврат ГруппаОбъектов;

КонецФункции

&НаСервере
Процедура ПриЗакрытииНаСервере()
	ПоместитьВоВременноеХранилище(ЭтаФорма.Ошибки.Выгрузить(), ЭтаФорма.АдресТаблицыОшибок);
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	ПриЗакрытииНаСервере();
КонецПроцедуры
 
