		|	_ТаблицаСделок.ВидСделки,
		|	_ТаблицаСделок.ДатаСделки,
		|	ВЫБОР
		|		КОГДА _ТаблицаСделок.ЮрФизЛицо = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА ВЫБОР
		|					КОГДА _ТаблицаСделок.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|						ТОГДА ВЫРАЗИТЬ(_ТаблицаСделок.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|					КОГДА _ТаблицаСделок.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|						ТОГДА ВЫРАЗИТЬ(_ТаблицаСделок.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|					КОГДА _ТаблицаСделок.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|						ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
		|					КОГДА _ТаблицаСделок.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
		|						ТОГДА ВЫРАЗИТЬ(_ТаблицаСделок.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.ЮрФизЛицо
		|					КОГДА _ТаблицаСделок.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|						ТОГДА ВЫРАЗИТЬ(_ТаблицаСделок.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
		|					КОГДА _ТаблицаСделок.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
		|						ТОГДА ВЫРАЗИТЬ(_ТаблицаСделок.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
		|				КОНЕЦ
		|		ИНАЧЕ _ТаблицаСделок.ЮрФизЛицо
		|	КОНЕЦ";
	
	Для каждого СтрокаАктивы Из ТаблицаАктивов Цикл
	
		РасчетныйКонечныйОстаток = СтрокаАктивы.НачальныйОстаток + СтрокаАктивы.Приход - СтрокаАктивы.Расход;
		Если РасчетныйКонечныйОстаток > СтрокаАктивы.КонечныйОстаток Тогда
			СтрокаАктивы.Расход = СтрокаАктивы.Расход + РасчетныйКонечныйОстаток - СтрокаАктивы.КонечныйОстаток;
		ИначеЕсли РасчетныйКонечныйОстаток < СтрокаАктивы.КонечныйОстаток Тогда
			СтрокаАктивы.Приход = СтрокаАктивы.Приход + СтрокаАктивы.КонечныйОстаток - РасчетныйКонечныйОстаток;
		КонецЕсли; 
	
	КонецЦикла; 
	
	Документ.ОбъектыИнвестирования.Загрузить(ТаблицаАктивов);
	Документ.Сделки.Загрузить(Запрос.Выполнить().Выгрузить()); 
	
	СообщенияПользователю = ПолучитьСообщенияПользователю(Истина);
	ДобавитьОшибкиВПараметрыФайла(Ошибки, СообщенияПользователю, ПараметрыФайла);
	ПоместитьДанныеВоВременноеХранилище(СообщенияПользователю, Документ, ПараметрыФайла.АдресДанных);
	
КонецПроцедуры

&НаСервереБезКонтекста 
Функция НайтиЮрЛицоПоКраткомуНаименованию(Наименование, Период)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("КраткоеНаименованиеПоУставу", Наименование);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|ГДЕ
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу = &КраткоеНаименованиеПоУставу";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Наименование;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.ЮрФизЛицо;
	КонецЕсли; 
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗагрузитьЦеннуюБумагу(ЗагруженныеЦенныеБумаги, РегНомер, ГруппаОбъектов, Организация)

	ЦеннаяБумага = ЗагруженныеЦенныеБумаги.Получить(РегНомер);
	
	Если Не ЗначениеЗаполнено(ЦеннаяБумага) Тогда
	
		ИмпортНСИ = Обработки.ИмпортНормативноСправочнойИнформации.Создать();
		ИмпортНСИ.ГруппаПравил                     = "Матрих";
		ИмпортНСИ.ГруппаОбъектов                   = Справочники.ГруппыИмпортируемыхОбъектов[ГруппаОбъектов];
		ИмпортНСИ.Организация                      = Организация;
		ИмпортНСИ.Подразделение                    = Справочники.Подразделения.ГруппаКомпаний;
		ИмпортНСИ.Язык                             = Справочники.Языки.Русский;
		ИмпортНСИ.НеСообщатьОСозданииНовыхОбъектов = Истина;
		ИмпортНСИ.НеСообщатьОбОтсутствииИзменений  = Истина;

		ВнешниеДанные = ИмпортНСИ.ПолучитьДанныеДляВыбора(РегНомер);

		Если ВнешниеДанные.Количество() = 1 Тогда
		
			НоваяСтрокаИмпортируемыеОбъекты = ИмпортНСИ.ИмпортируемыеОбъекты.Добавить();
			НоваяСтрокаИмпортируемыеОбъекты.КодВоВнешнейСистеме = ВнешниеДанные[0].Идентификатор;
			Объекты = ИмпортНСИ.ИмпортироватьДанные();
			Если ТипЗнч(Объекты) = Тип("Массив") И Объекты.Количество() = 1 Тогда
				ЦеннаяБумага = Объекты[0];
				ЗагруженныеЦенныеБумаги.Вставить(РегНомер, ЦеннаяБумага);
			КонецЕсли;
		
		КонецЕсли;
	
	КонецЕсли; 
	
	Возврат ЦеннаяБумага;

КонецФункции

&НаСервереБезКонтекста
Функция ДепозитарнаяРаспискаПоРегНомеру(РегНомер, ДепозитарныеРасписки)
	
	ДепозитарнаяРасписка = ДепозитарныеРасписки.Получить(РегНомер);
	
	Если ДепозитарнаяРасписка = Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДепозитарныеРасписки.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ДепозитарныеРасписки КАК ДепозитарныеРасписки
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследнихISIN
			|		ПО ДепозитарныеРасписки.Ссылка = КодыВТорговыхСистемахСрезПоследнихISIN.Объект
			|ГДЕ
			|	ДепозитарныеРасписки.РегистрационныйНомер = &РегистрационныйНомер
			|	ИЛИ КодыВТорговыхСистемахСрезПоследнихISIN.Код = &РегистрационныйНомер";
		
		Запрос.УстановитьПараметр("РегистрационныйНомер", РегНомер);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ДепозитарнаяРасписка = Выборка.Ссылка;
		Иначе
			ДепозитарнаяРасписка = Справочники.ДепозитарныеРасписки.ПустаяСсылка();
		КонецЕсли;
			
		ДепозитарныеРасписки.Вставить(РегНомер, ДепозитарнаяРасписка);			
		
	КонецЕсли;
	
	Возврат ДепозитарнаяРасписка;
	
КонецФункции 

#КонецОбласти

#Область Тинькофф

&НаКлиенте
Процедура ОткрытьФормуИмпортаТинькоффЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЭтоАдресВременногоХранилища(Результат) Тогда
	
		ЗагрузитьДанныеТинькофф(Результат, ДополнительныеПараметры);
		СтрокаТаблицыФайлов = ЭтаФорма.ТаблицаФайлов.НайтиПоИдентификатору(ДополнительныеПараметры.ВыбраннаяСтрока);
		СтрокаТаблицыФайлов.Статус = "Готов к загрузке";
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыФайлов, ДополнительныеПараметры, "АдресДанных, НачалоПериода, ОкончаниеПериода"); 
		
	КонецЕсли; 

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗагрузитьДанныеТинькофф(АдресРезультата, ПараметрыФайла)

	Документ = ПолучитьДокумент(ПараметрыФайла);
	
	СтруктураРезультат = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Для каждого ЭлРезультат Из СтруктураРезультат Цикл
		Если ТипЗнч(ЭлРезультат.Значение) = Тип("ТаблицаЗначений") Тогда
			Документ[ЭлРезультат.Ключ].Загрузить(ЭлРезультат.Значение);
		Иначе
			Документ[ЭлРезультат.Ключ] = ЭлРезультат.Значение;
		КонецЕсли; 
	КонецЦикла; 
	
	ПоместитьДанныеВоВременноеХранилище(Неопределено, Документ, ПараметрыФайла.АдресДанных);
	
	УдалитьИзВременногоХранилища(АдресРезультата);

КонецПроцедуры

#КонецОбласти 

&НаСервереБезКонтекста
Процедура ДобавитьОшибку(Ошибки, Рынок, ИдентификаторЦеннойБумаги, Эмитент)

	Если Ошибки.Получить(ИдентификаторЦеннойБумаги) = Неопределено Тогда
		Ошибки.Вставить(ИдентификаторЦеннойБумаги, Новый Структура("Рынок, ИдентификаторЦеннойБумаги, Эмитент", 
			Рынок, 
			ИдентификаторЦеннойБумаги, 
			Эмитент));
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьОшибкиВПараметрыФайла(Ошибки, СообщенияПользователю, ПараметрыФайла)

	Если Ошибки.Количество() > 0 Тогда
		ПараметрыФайла.Вставить("Ошибки", Ошибки);
	КонецЕсли;
	
	Если СообщенияПользователю.Количество() > 0 Тогда
		ПараметрыФайла.Вставить("СообщенияПользователю", СообщенияПользователю);
	КонецЕсли; 

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПоместитьДанныеВоВременноеХранилище(СообщенияПользователю, Документ, АдресДанных)

	АдресДанных = ПоместитьВоВременноеХранилище(Новый Структура("Документ, СообщенияПользователю", Документ, СообщенияПользователю), АдресДанных);

КонецПроцедуры

#Область Работа_с_Excel

&НаКлиенте
Процедура ПрочитатьExcelФайл(ПараметрыФайла)

	#Область Чтение_Excel_файла
	
	Excel = Новый COMОбъект("Excel.Application");
	Excel.WorkBooks.Open(ПараметрыФайла.ПутьКФайлу);
	Excel.Sheets(1).Select();
	
	ПоследняяЯчейка = Excel.Cells(1,1).SpecialCells(11);
	
	СтруктураТаблиц = Новый Структура("Активы, Сделки, ЦенныеБумаги, СделкиСВалютой, СделкиРЕПО", Новый Массив, Новый Массив, Новый Массив, Новый Массив, Новый Массив);
	
	ПараметрыЧтения = Новый Структура;
	ПараметрыЧтения.Вставить("Excel", Excel); 	
	ПараметрыЧтения.Вставить("ПоследняяКолонка", ПоследняяЯчейка.Column); 
	ПараметрыЧтения.Вставить("ПоследняяСтрока", ПоследняяЯчейка.Row); 	
	ПараметрыЧтения.Вставить("АктивыОбработаны", Ложь); 
	ПараметрыЧтения.Вставить("СделкиОбработаны", Ложь); 	
	ПараметрыЧтения.Вставить("СделкиРЕПООбработаны", Ложь); 
	ПараметрыЧтения.Вставить("СтруктураТаблиц", СтруктураТаблиц); 
	
	НомерСтроки = 1;
	
	Пока НомерСтроки < ПараметрыЧтения.ПоследняяСтрока Цикл
		
		Если ПараметрыФайла.ФорматФайла = НРег("Открытие") Тогда
			ПрочитатьФайлОткрытие(ПараметрыЧтения, НомерСтроки);
		ИначеЕсли ПараметрыФайла.ФорматФайла = НРег("БКС") Тогда
			ПрочитатьФайлБКС(ПараметрыЧтения, НомерСтроки);
		ИначеЕсли ПараметрыФайла.ФорматФайла = НРег("УКРИ") Тогда
			ПрочитатьФайлУКРИ(ПараметрыЧтения, НомерСтроки);
		КонецЕсли; 
		
		НомерСтроки = НомерСтроки + 1;
	
	КонецЦикла; 
	
	Excel.ActiveWorkbook.Close();	
	#КонецОбласти 
	
	ОбработатьДанныеExcel(СтруктураТаблиц, ПараметрыФайла);

КонецПроцедуры

&НаКлиенте
Функция ПрочитатьШапку(Excel, НомерСтроки, ВысотаШапки, ВсегоКолонок, ЗагружаемыеКолонки) 

	ПараметрыКолонок = Новый Соответствие; //Ключ - имя колонки, Значение - номер колонки
	
	НомерКолонки = 1;
	
	Пока НомерКолонки <= ВсегоКолонок Цикл
		
		Ячейка = Excel.Cells(НомерСтроки, НомерКолонки);
		
		КоличествоКолонок = 1;
		ЗаголовокКолонки = СокрЛП(Ячейка.Text);
		
		Если Ячейка.MergeCells Тогда
			
			КоличествоКолонок = Ячейка.MergeArea.Columns.Count;
			КоличествоСтрок = Ячейка.MergeArea.Rows.Count;
			
			Если КоличествоСтрок < ВысотаШапки Тогда
				// считаем, что строк в шапке не больше 2х
				ЯчейкаПодзаголовок = Excel.Cells(НомерСтроки + 1, НомерКолонки);
				ЗаголовокКолонки = ЗаголовокКолонки + " - " + СокрЛП(ЯчейкаПодзаголовок.Text);
				Если ЯчейкаПодзаголовок.MergeCells Тогда
					КоличествоКолонок = ЯчейкаПодзаголовок.MergeArea.Columns.Count;
				КонецЕсли; 
			КонецЕсли; 
			
		КонецЕсли; 
		
		ИмяКолонки = ЗагружаемыеКолонки.Получить(ЗаголовокКолонки);
		Если ИмяКолонки <> Неопределено Тогда
			ПараметрыКолонок.Вставить(ИмяКолонки, НомерКолонки);
			ЗагружаемыеКолонки.Удалить(ЗаголовокКолонки);
		КонецЕсли; 
		
		Если ЗагружаемыеКолонки.Количество() = 0 Тогда
			Прервать;		
		КонецЕсли; 
		
		НомерКолонки = НомерКолонки + КоличествоКолонок;
	
	КонецЦикла;
	
	Для каждого Колонка Из ЗагружаемыеКолонки Цикл
		Если ПараметрыКолонок.Получить(Колонка.Значение) = Неопределено Тогда
			// такая проверка вставлена на случай вариативности заголовков колонок
			// Пример:
			// файл УКРИ. Таблицу активов нужно собрать из нескольких разных таблиц
			// Поле с рег. номером в одной таблице незывается "Номер государственной регистрации / ISIN", в другой - "ISIN"
			// в ЗагружаемыеКолонки добавляем оба этих поля с разными ключами и одинаковыми значениями
			// аналогично можно обработать изменения в формате заголовков. Например, УКРИ изменили заголовок колонки ДатаПоставки
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдена колонка " + Колонка.Ключ);
		
		КонецЕсли; 		
	КонецЦикла; 
	
	Возврат ПараметрыКолонок;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьДанныеExcel(ДанныеДляОбработки, ПараметрыФайла)

	Если ПараметрыФайла.ФорматФайла = НРег("Открытие") Тогда
		ОбработатьДанныеБрокераОткрытие(ДанныеДляОбработки, ПараметрыФайла);
	ИначеЕсли ПараметрыФайла.ФорматФайла = НРег("УКРИ") Тогда
		ОбработатьДанныеБрокераУКРИ(ДанныеДляОбработки, ПараметрыФайла);
	ИначеЕсли ПараметрыФайла.ФорматФайла = НРег("БКС") Тогда
		ОбработатьДанныеБрокераБКС(ДанныеДляОбработки, ПараметрыФайла);
	КонецЕсли; 

КонецПроцедуры
	
#КонецОбласти 

&НаКлиентеНаСервереБезКонтекста
Функция СтрокаВЧисло(Знач Строка)
	Строка = ?(Строка = "", 0, Строка);
	Строка = СтрЗаменить(Строка, " ", "");
	Строка = СтрЗаменить(Строка, ".", ",");
	Возврат Число(Строка);
КонецФункции

&НаСервереБезКонтекста
Функция НайтиЦеннуюБумагу(Код, КэшОбъектов)
	
	ЦеннаяБумага = КэшОбъектов.Получить(Код);
	Если ЗначениеЗаполнено(ЦеннаяБумага) Тогда
		Возврат ЦеннаяБумага;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Код", Код);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Акции.Ссылка КАК ЦеннаяБумага,
		|	0 КАК Приоритет
		|ИЗ
		|	Справочник.Акции КАК Акции
		|ГДЕ
		|	Акции.ГосударственныйРегистрационныйНомер = &Код
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Облигации.Ссылка,
		|	0
		|ИЗ
		|	Справочник.Облигации КАК Облигации
		|ГДЕ
		|	Облигации.ГосударственныйРегистрационныйНомер = &Код
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Паи.Ссылка,
		|	0
		|ИЗ
		|	Справочник.Паи КАК Паи
		|ГДЕ
		|	Паи.ГосударственныйРегистрационныйНомер = &Код
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КодыВТорговыхСистемахСрезПоследних.Объект,
		|	1
		|ИЗ
		|	РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
		|ГДЕ
		|	КодыВТорговыхСистемахСрезПоследних.Код = &Код
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		КэшОбъектов.Вставить(Код, Выборка.ЦеннаяБумага);
		Возврат Выборка.ЦеннаяБумага;
	КонецЕсли;

КонецФункции
 
&НаСервереБезКонтекста
Функция ПолучитьВалютуПоНаименованию(Знач СтрокаПоиска)
	
	Если НРег(СтрокаПоиска) = "руб" Или НРег(СтрокаПоиска) = "рубль" Тогда
		СтрокаПоиска = "RUB";
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СтрокаПоиска", СтрокаПоиска);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Валюты.Ссылка КАК Валюта
		|ИЗ
		|	Справочник.Валюты КАК Валюты
		|ГДЕ
		|	(Валюты.Наименование = &СтрокаПоиска
		|			ИЛИ Валюты.НаименованиеПолное = &СтрокаПоиска)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Валюта;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДокумент(ПараметрыФайла);

	Если ЗначениеЗаполнено(ПараметрыФайла.Документ) Тогда
		Документ = ПараметрыФайла.Документ.ПолучитьОбъект();
		Документ.ОбъектыИнвестирования.Очистить();
		Документ.Сделки.Очистить();
		Документ.СделкиСВалютой.Очистить();
	Иначе
		Документ = Документы.СведенияПредоставляемыеЮрФизЛицами.СоздатьДокумент();
		Документ.УчитыватьДляПН = Истина;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Документ, ПараметрыФайла);
	Документ.Ответственный = РаботаСПользователями.ТекущийПользователь();
	
	Возврат Документ;
	
КонецФункции

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ТекстСообщения = "";
	
	Если Не ОбщегоНазначенияКлиентСервер.ПериодЗаполненКорректно(ОтборПериод,, Истина, ТекстСообщения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,, "ОтборПериод", Отказ); 	
	КонецЕсли;

КонецПроцедуры

