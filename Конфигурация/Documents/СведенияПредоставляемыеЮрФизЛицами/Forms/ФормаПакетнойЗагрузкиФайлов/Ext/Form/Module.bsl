
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация"); 
	
	ЭтоПолноправныйПользователь = РаботаСПользователями.ЭтоПолноправныйПользователь();
	
	Элементы.ОрганизацияГиперссылка.Видимость = Не ЭтоПолноправныйПользователь;
	Элементы.Организация.Видимость = ЭтоПолноправныйПользователь;
	
КонецПроцедуры

#КонецОбласти 

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура ТаблицаФайловПутьКФайлуОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекСтрока = Элементы.ТаблицаФайлов.ТекущиеДанные;
	Если ТекСтрока <> Неопределено Тогда
		ЗапуститьПриложение(ТекСтрока.ПутьКФайлу);
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФайловПутьКФайлуОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФайловВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекСтрока = ЭтаФорма.ТаблицаФайлов.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если Поле.Имя = "ТаблицаФайловСтатус" Тогда
	
		Если СтрНачинаетсяС(ТекСтрока.Статус, "Документ") Тогда
		
			ОткрытьЗначение(ТекСтрока.Документ);
			
		ИначеЕсли ТекСтрока.Статус = "Содержит ошибки" Тогда
			
			ОткрытьОписаниеОшибок(ТекСтрока.ПолучитьИдентификатор());
			
		ИначеЕсли ТекСтрока.Статус = "Готов к загрузке" Тогда
			
			ОткрытьДанныеДокумента(ТекСтрока.АдресДанных);
			
		ИначеЕсли СтрНачинаетсяС(ТекСтрока.Статус, "Не заполнен") Тогда
			
			ОткрытьЗначение(ТекСтрока.ИсточникСведений);
			
		ИначеЕсли ТекСтрока.Статус = "Ручная обработка" Тогда
			
			Если Не ЗначениеЗаполнено(ТекСтрока.ДатаПредоставленияИнформации) Тогда
			
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена дата предоставления информации");
				Возврат;
			
			КонецЕсли; 
			
			ПараметрыФормы = Новый Структура("АдресРезультата, НачалоПериода, ОкончаниеПериода, ПутьКФайлу", 
				ПоместитьВоВременноеХранилище(Неопределено, ЭтаФорма.УникальныйИдентификатор),
				ТекСтрока.НачалоПериода,
				ТекСтрока.ОкончаниеПериода,
				ТекСтрока.ПутьКФайлу);
				
			ПараметрыФайла = Новый Структура("ИсточникСведений, НачалоПериода, ОкончаниеПериода, ПутьКФайлу, Документ");
			ЗаполнитьЗначенияСвойств(ПараметрыФайла, ТекСтрока);
			ПараметрыФайла.Вставить("ФорматФайла", 		НРег(ТекСтрока.ФорматФайла));
			ПараметрыФайла.Вставить("Организация", 		ЭтаФорма.Организация);
			ПараметрыФайла.Вставить("Дата", 			ТекСтрока.ДатаПредоставленияИнформации);
			ПараметрыФайла.Вставить("АдресДанных", 		ЭтаФорма.УникальныйИдентификатор);	
			ПараметрыФайла.Вставить("ВыбраннаяСтрока", 	ВыбраннаяСтрока);	
			
			ОткрытьФорму("Документ.СведенияПредоставляемыеЮрФизЛицами.Форма.ФормаИмпортаТинькофф", ПараметрыФормы, ЭтаФорма, ЭтаФорма,, ЭтаФорма, Новый ОписаниеОповещения("ОткрытьФормуИмпортаТинькоффЗавершение", ЭтотОбъект, ПараметрыФайла), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли; 
		
	ИначеЕсли Поле.Имя = "ТаблицаФайловИсточникСведений" Тогда
			
		ОткрытьЗначение(ТекСтрока.ИсточникСведений);
			
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти 

#Область Команды_формы

&НаКлиенте
Процедура КомандаУстановитьФлаги(Команда)
	ИзменитьФлаги(Истина);
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьФлаги(Команда)
	ИзменитьФлаги(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьСписок(Команда)
	
	Если ЭтаФорма.ПроверитьЗаполнение() Тогда
		КомандаОбновитьСписокНаСервере();	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПрочитать(Команда)
	
	СтрокиКЗагрузке = ЭтаФорма.ТаблицаФайлов.НайтиСтроки(Новый Структура("Загрузить", Истина));
	ВсегоСтрок = СтрокиКЗагрузке.Количество();
	ТекСтрока = 1;
	
	Для каждого СтрокаТаблицыФайлов Из СтрокиКЗагрузке Цикл
		
		Прогресс = Цел(ТекСтрока / ВсегоСтрок * 100);
		Состояние("Чтение файлов", Прогресс, СтрокаТаблицыФайлов.ПутьКФайлу);
		
		Если СтрокаТаблицыФайлов.Статус = "Ручная обработка" Тогда 
			Продолжить;
		ИначеЕсли СтрокаТаблицыФайлов.ФорматФайла = "" Тогда
			СтрокаТаблицыФайлов.Статус = "Не заполнен формат файла";
		ИначеЕсли Не (ЗначениеЗаполнено(СтрокаТаблицыФайлов.НачалоПериода) И ЗначениеЗаполнено(СтрокаТаблицыФайлов.ОкончаниеПериода)) И СтрокаТаблицыФайлов.ФорматФайла <> "БКС" Тогда 
			СтрокаТаблицыФайлов.Статус = "Не заполнен период";
		ИначеЕсли Не ЗначениеЗаполнено(СтрокаТаблицыФайлов.ДатаПредоставленияИнформации) Тогда 
			СтрокаТаблицыФайлов.Статус = "Не заполнена дата предоставления информации";
		Иначе
			ПараметрыФайла = Новый Структура("ИсточникСведений, НачалоПериода, ОкончаниеПериода, ПутьКФайлу, Документ");
			ЗаполнитьЗначенияСвойств(ПараметрыФайла, СтрокаТаблицыФайлов);
			ПараметрыФайла.Вставить("ФорматФайла", 	НРег(СтрокаТаблицыФайлов.ФорматФайла));
			ПараметрыФайла.Вставить("Организация", 	ЭтаФорма.Организация);
			ПараметрыФайла.Вставить("Дата", 		СтрокаТаблицыФайлов.ДатаПредоставленияИнформации);
			ПараметрыФайла.Вставить("АдресДанных", 	ЭтаФорма.УникальныйИдентификатор);
			
			ПрочитатьФайл(ПараметрыФайла);
			
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыФайлов, ПараметрыФайла, "АдресДанных, НачалоПериода, ОкончаниеПериода"); 
			
			ОшибкиПоискаЦенныхБумаг = Неопределено;
			СообщенияПользователю = Неопределено;
			
			Если ПараметрыФайла.Свойство("Ошибки", ОшибкиПоискаЦенныхБумаг) Или ПараметрыФайла.Свойство("СообщенияПользователю", СообщенияПользователю) Тогда
				
				Если ОшибкиПоискаЦенныхБумаг <> Неопределено Тогда
				
					Для каждого ЭлСоответствия Из ПараметрыФайла.Ошибки Цикл
						НоваяСтрока = ЭтаФорма.Ошибки.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлСоответствия.Значение);
						НоваяСтрока.ИдентификаторСтроки = СтрокаТаблицыФайлов.ПолучитьИдентификатор();
					КонецЦикла; 					
				
				КонецЕсли; 

				СтрокаТаблицыФайлов.Статус = "Содержит ошибки";
				
			Иначе
				
				СтрокаТаблицыФайлов.Статус = "Готов к загрузке";
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		ТекСтрока = ТекСтрока + 1;
		
	КонецЦикла; 		
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбработатьОшибки(Команда)
	Если ЭтаФорма.Ошибки.Количество() > 0 Тогда
		ОткрытьОписаниеОшибок();
	КонецЕсли; 	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗагрузить(Команда)
	
	Для каждого СтрокаТаблицыФайлов Из ЭтаФорма.ТаблицаФайлов Цикл
		
		Если СтрокаТаблицыФайлов.Загрузить Тогда
		
			ДанныеСтроки = Новый Структура("АдресДанных, ПутьКФайлу, ХешСумма, Документ, Загрузить, Статус");
			ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаТаблицыФайлов);
			ДанныеСтроки.Вставить("Организация", ЭтаФорма.Организация);
			ДанныеФайла = Новый ДвоичныеДанные(ДанныеСтроки.ПутьКФайлу);
			ДанныеСтроки.Вставить("АдресФайла", ПоместитьВоВременноеХранилище(ДанныеФайла, ЭтаФорма.УникальныйИдентификатор));
			
			Попытка
				ЗагрузитьДокумент(ДанныеСтроки);
				ЗаполнитьЗначенияСвойств(СтрокаТаблицыФайлов, ДанныеСтроки, "Документ, Загрузить, Статус");
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось загрузить файл " + ДанныеСтроки.ПутьКФайлу + ". Система сообщает: " + ОписаниеОшибки());
			КонецПопытки;
			
			УдалитьИзВременногоХранилища(ДанныеСтроки.АдресФайла);
		
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗагрузитьДокумент(ДанныеСтроки)

	Данные = ПолучитьИзВременногоХранилища(ДанныеСтроки.АдресДанных);
	Документ = Данные.Документ;
	
	Если Документ.ПометкаУдаления Тогда
		Документ.ПометкаУдаления = Ложь;
	КонецЕсли; 
	
	НачатьТранзакцию();
	
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	Документы.СведенияПредоставляемыеЮрФизЛицами.ЗаписатьИнформациюОФайлеВДополнительныеСведения(Документ.Ссылка, ДанныеСтроки.ПутьКФайлу, ДанныеСтроки.ХешСумма);
	
	ДанныеСтроки.Документ = Документ.Ссылка;
	ДанныеСтроки.Статус = "Документ загружен";
	ДанныеСтроки.Загрузить = Ложь;
	
	ЗафиксироватьТранзакцию();
	
	ЗаписатьФайлВХранилище(ДанныеСтроки.Организация, Документ.Ссылка, ДанныеСтроки.ПутьКФайлу, ДанныеСтроки.АдресФайла);
	
КонецПроцедуры

#КонецОбласти 

#Область Служебные_процедуры_и_функции

&НаКлиенте
Процедура ИзменитьФлаги(Значение)

	Для каждого СтрокаТаблицы Из ЭтаФорма.ТаблицаФайлов Цикл
		Если Элементы.ТаблицаФайлов.ПроверитьСтроку(СтрокаТаблицы.ПолучитьИдентификатор()) Тогда
			СтрокаТаблицы.Загрузить = Значение;
		КонецЕсли; 
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура КомандаОбновитьСписокНаСервере()
	
	Для каждого Строка Из ЭтаФорма.ТаблицаФайлов Цикл
		Если ЭтоАдресВременногоХранилища(Строка.АдресДанных) Тогда
			УдалитьИзВременногоХранилища(Строка.АдресДанных);
		КонецЕсли; 
	КонецЦикла; 
	
	ЭтаФорма.ТаблицаФайлов.Очистить();
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсточникиСведенийПредоставляемыхЮрФизЛицами.Ссылка КАК ИсточникСведений,
		|	ШаблоныПутей.Значение КАК ШаблонПутиКФайлу,
		|	ФорматыФайлов.Значение.Наименование КАК ФорматФайла
		|ИЗ
		|	Справочник.ИсточникиСведенийПредоставляемыхЮрФизЛицами КАК ИсточникиСведенийПредоставляемыхЮрФизЛицами
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ШаблоныПутей
		|		ПО ИсточникиСведенийПредоставляемыхЮрФизЛицами.Ссылка = ШаблоныПутей.Объект
		|			И (ШаблоныПутей.Свойство.Ключ = ""Документ.СведенияПредоставляемыеЮрФизЛицами.ШаблонПутиКФайламОтчетовБрокера"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ФорматыФайлов
		|		ПО ИсточникиСведенийПредоставляемыхЮрФизЛицами.Ссылка = ФорматыФайлов.Объект
		|			И (ФорматыФайлов.Свойство.Ключ = ""Документ.СведенияПредоставляемыеЮрФизЛицами.ФорматФайловОтчетаБрокера"")
		|ГДЕ
		|	(&Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|			ИЛИ ИсточникиСведенийПредоставляемыхЮрФизЛицами.Организация = &Организация)
		|	И НЕ ИсточникиСведенийПредоставляемыхЮрФизЛицами.ПометкаУдаления";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	
	Шаблоны = Запрос.Выполнить().Выгрузить();
	Шаблоны.Колонки.Добавить("ШаблонКаталог", 	Новый ОписаниеТипов("Строка"));
	Шаблоны.Колонки.Добавить("Маска", 			Новый ОписаниеТипов("Строка"));
	Шаблоны.Колонки.Добавить("Каталог", 		Новый ОписаниеТипов("Строка"));
	
	Для каждого СтрокаШаблон Из Шаблоны Цикл
	
		ИмяФайла = ПланыВидовХарактеристик.ДополнительныеСведения.ОбработатьПутьКФайлу(СтрокаШаблон.ШаблонПутиКФайлу, Новый Структура("Период", ТекущаяДата()));
		Файл = Новый Файл(ИмяФайла);
		Если Файл.Расширение = "" Тогда
			СтрокаШаблон.ШаблонКаталог = СтрокаШаблон.ШаблонПутиКФайлу;			
			СтрокаШаблон.Маска = "*.*";
		Иначе
			КонецПути = СтрНайти(СтрокаШаблон.ШаблонПутиКФайлу, "\", НаправлениеПоиска.СКонца);
			СтрокаШаблон.ШаблонКаталог = Лев(СтрокаШаблон.ШаблонПутиКФайлу, КонецПути);
			
			ШаблонФайл = Сред(СтрокаШаблон.ШаблонПутиКФайлу, КонецПути + 1);
			
			Маска		= "";
			Форматировать	= (Лев(ШаблонФайл, 1) = """");
			МассивПодстрок	= СтрРазделить(ШаблонФайл, """", Ложь);
			
			Для Каждого Подстрока Из МассивПодстрок Цикл
				
				Если Форматировать Тогда
					Маска = Маска + "*";
				Иначе
					Маска = Маска + Подстрока;
				КонецЕсли;
				
				Форматировать = Не Форматировать;
				
			КонецЦикла;
			
			СтрокаШаблон.Маска = Маска;
		КонецЕсли; 
	
	КонецЦикла; 
	
	МассивДат = Новый Массив;
	
	ТекДата = ЭтаФорма.ОтборПериод.ДатаНачала;
	Если ЭтаФорма.ОтборПериод.ДатаОкончания = '00010101' Или ЭтаФорма.ОтборПериод.ДатаОкончания > КонецДня(ТекущаяДата()) Тогда
		Ограничение = ТекущаяДата();
	Иначе
		Ограничение = ЭтаФорма.ОтборПериод.ДатаОкончания;
	КонецЕсли; 
	
	Пока ТекДата < Ограничение Цикл
		
		МассивДат.Добавить(ТекДата);
		ТекДата = ТекДата + 24 * 3600;
		
	КонецЦикла;
	
	Файлы = ЭтаФорма.ТаблицаФайлов.Выгрузить();
	
	Для каждого СтрокаШаблон Из Шаблоны Цикл
	
		Если ЗначениеЗаполнено(СтрокаШаблон.ШаблонКаталог) Тогда
		
			Для каждого Период Из МассивДат Цикл
			
				ИмяКаталога = ПланыВидовХарактеристик.ДополнительныеСведения.ОбработатьПутьКФайлу(СтрокаШаблон.ШаблонКаталог, Новый Структура("Период", Период));
				Если СтрНайти(СтрокаШаблон.Каталог, ИмяКаталога) = 0 Тогда
				
					СтрокаШаблон.Каталог = СтрокаШаблон.Каталог + Символы.ПС + ИмяКаталога;
					НайденныеФайлы = НайтиФайлы(ИмяКаталога, СтрокаШаблон.Маска);
					Если НайденныеФайлы.Количество() > 0 Тогда
					
						Для каждого НайденныйФайл Из НайденныеФайлы Цикл
						
							Если НРег(НайденныйФайл.Имя) = "thumbs.db" Или НайденныйФайл.ЭтоКаталог() Тогда
								Продолжить;
							КонецЕсли; 
							
							НоваяСтрока = Файлы.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаШаблон);
							НоваяСтрока.ПутьКФайлу = НайденныйФайл.ПолноеИмя;
							НоваяСтрока.ХешСумма = ПолучитьХешСуммуФайла(НоваяСтрока.ПутьКФайлу);
							
							ЗаполнитьЗначенияСвойств(НоваяСтрока, ПолучитьПериодИзИмениФайла(НайденныйФайл.ИмяБезРасширения));
							
							Если ЗначениеЗаполнено(НоваяСтрока.ОкончаниеПериода) Тогда
							
								НоваяСтрока.ДатаПредоставленияИнформации = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, КонецДня(НоваяСтрока.ОкончаниеПериода), 1) + 3600 * 9;
							
							КонецЕсли; 
						
						КонецЦикла; 
					
					КонецЕсли; 				

				КонецЕсли; 
			
			КонецЦикла;		
		
		КонецЕсли; 
	
	КонецЦикла;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Файлы.ИсточникСведений КАК ИсточникСведений,
		|	_Файлы.ПутьКФайлу КАК ПутьКФайлу,
		|	_Файлы.ФорматФайла КАК ФорматФайла,
		|	_Файлы.ШаблонПутиКФайлу КАК ШаблонПутиКФайлу,
		|	_Файлы.НачалоПериода КАК НачалоПериода,
		|	_Файлы.ОкончаниеПериода КАК ОкончаниеПериода,
		|	_Файлы.ДатаПредоставленияИнформации КАК ДатаПредоставленияИнформации,
		|	_Файлы.ХешСумма КАК ХешСумма
		|ПОМЕСТИТЬ _Файлы
		|ИЗ
		|	&Файлы КАК _Файлы
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ХешСумма
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияДополнительныхСведений.Объект КАК Документ,
		|	ВЫБОР
		|		КОГДА НЕ ЗначенияДополнительныхСведений.Объект ЕСТЬ NULL
		|			ТОГДА ВЫБОР
		|					КОГДА СведенияПредоставляемыеЮрФизЛицами.Проведен
		|						ТОГДА ""Документ загружен""
		|					КОГДА СведенияПредоставляемыеЮрФизЛицами.ПометкаУдаления
		|						ТОГДА ""Документ помечен на удаление""
		|					ИНАЧЕ ""Документ не проведен""
		|				КОНЕЦ
		|		КОГДА _Файлы.ФорматФайла = """"
		|				И _Файлы.ШаблонПутиКФайлу = """"
		|			ТОГДА ""Не заполнены формат и шаблон пути к файлу""
		|		КОГДА _Файлы.ФорматФайла = """"
		|			ТОГДА ""Не заполнен формат файла""
		|		КОГДА _Файлы.ШаблонПутиКФайлу = """"
		|			ТОГДА ""Не заполнен шаблон пути к файлу""
		|		КОГДА _Файлы.ФорматФайла = ""Тинькофф""
		|			ТОГДА ""Ручная обработка""
		|	КОНЕЦ КАК Статус,
		|	_Файлы.ФорматФайла <> """"
		|		И (ЗначенияДополнительныхСведений.Объект ЕСТЬ NULL
		|			ИЛИ НЕ СведенияПредоставляемыеЮрФизЛицами.Проведен) КАК Загрузить,
		|	_Файлы.ПутьКФайлу КАК ПутьКФайлу,
		|	_Файлы.ХешСумма КАК ХешСумма,
		|	_Файлы.ИсточникСведений КАК ИсточникСведений,
		|	_Файлы.ФорматФайла КАК ФорматФайла,
		|	_Файлы.ШаблонПутиКФайлу КАК ШаблонПутиКФайлу,
		|	ЕСТЬNULL(СведенияПредоставляемыеЮрФизЛицами.НачалоПериода, _Файлы.НачалоПериода) КАК НачалоПериода,
		|	ЕСТЬNULL(СведенияПредоставляемыеЮрФизЛицами.ОкончаниеПериода, _Файлы.ОкончаниеПериода) КАК ОкончаниеПериода,
		|	ЕСТЬNULL(СведенияПредоставляемыеЮрФизЛицами.Дата, _Файлы.ДатаПредоставленияИнформации) КАК ДатаПредоставленияИнформации
		|ИЗ
		|	_Файлы КАК _Файлы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СведенияПредоставляемыеЮрФизЛицами КАК СведенияПредоставляемыеЮрФизЛицами
		|			ПО (СведенияПредоставляемыеЮрФизЛицами.Организация = &Организация)
		|				И ЗначенияДополнительныхСведений.Объект = СведенияПредоставляемыеЮрФизЛицами.Ссылка
		|		ПО _Файлы.ХешСумма = ЗначенияДополнительныхСведений.Значение
		|			И (ЗначенияДополнительныхСведений.Свойство.Ключ = ""Документ.СведенияПредоставляемыеЮрФизЛицами.ХешСуммаФайла"")
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИсточникиСведенийПредоставляемыхЮрФизЛицами КАК ИсточникиСведенийПредоставляемыхЮрФизЛицами
		|		ПО _Файлы.ИсточникСведений = ИсточникиСведенийПредоставляемыхЮрФизЛицами.Ссылка
		|ГДЕ
		|	(&ОтборЗагруженные
		|			ИЛИ ЗначенияДополнительныхСведений.Объект ЕСТЬ NULL
		|			ИЛИ НЕ СведенияПредоставляемыеЮрФизЛицами.Проведен)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИсточникиСведенийПредоставляемыхЮрФизЛицами.Наименование,
		|	ПутьКФайлу";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Файлы", Файлы);
	Запрос.УстановитьПараметр("ОтборЗагруженные", ЭтаФорма.ОтборЗагруженные);
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	
	ЭтаФорма.ТаблицаФайлов.Загрузить(Запрос.Выполнить().Выгрузить());	 
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПериодИзИмениФайла(ИмяБезРасширения)

	Период = Новый Структура("НачалоПериода, ОкончаниеПериода");
	
	Если СтрНайти(ИмяБезРасширения, "BrokerReport_") Тогда
		
		ИмяФайла = СтрЗаменить(ИмяБезРасширения, "BrokerReport_", "");
		Попытка
			Период.Вставить("НачалоПериода", Дата(Сред(ИмяФайла, 1, 6) + "20" + Сред(ИмяФайла, 7, 2) + " 00:00:00"));
			Период.Вставить("ОкончаниеПериода", Дата(Сред(ИмяФайла, 12, 6) + "20" + Сред(ИмяФайла, 18, 2) + " 00:00:00"));
		Исключение
		КонецПопытки; 
		
	ИначеЕсли СтрНайти(ИмяБезРасширения, "Отчет брокера за ") Тогда
		
		ИмяФайла = СтрЗаменить(ИмяБезРасширения, "Отчет брокера за ", "");
		Попытка
			Период.Вставить("НачалоПериода", Дата(Сред(ИмяФайла, 1, 6) + "20" + Сред(ИмяФайла, 7, 2) + " 00:00:00"));
			Период.Вставить("ОкончаниеПериода", Период.НачалоПериода);
		Исключение
		КонецПопытки; 
		
	КонецЕсли;
	
	Возврат Период;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьХешСуммуФайла(ИмяФайла)

	ХешированиеДанных = Новый ХешированиеДанных(ХешФункция.SHA1);
	ХешированиеДанных.Добавить(Новый ДвоичныеДанные(ИмяФайла));
	Возврат Base64Строка(ХешированиеДанных.ХешСумма);

КонецФункции

&НаКлиенте
Процедура ОткрытьОписаниеОшибок(ИдентификаторСтроки = Неопределено)

	АдресТаблицыОшибок = ПоместитьТаблицуОшибокВХранилище(ИдентификаторСтроки);
	
	ОткрытьФормуМодально("Документ.СведенияПредоставляемыеЮрФизЛицами.Форма.ФормаОшибкиИмпорта", Новый Структура("АдресТаблицыОшибок", АдресТаблицыОшибок), ЭтаФорма);
	ОбработатьОшибки(АдресТаблицыОшибок);
	
	УдалитьИзВременногоХранилища(АдресТаблицыОшибок);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДанныеДокумента(АдресДанных)

	ОткрытьФормуМодально("Документ.СведенияПредоставляемыеЮрФизЛицами.Форма.ФормаДокумента", Новый Структура("АдресДанных", АдресДанных), ЭтаФорма);

КонецПроцедуры

&НаСервере
Функция ПоместитьТаблицуОшибокВХранилище(ИдентификаторСтроки)

	Если ИдентификаторСтроки = Неопределено Тогда
		ОтборСтрок = Неопределено;
		СообщенияПользователю = Новый Массив;
	Иначе
		ОтборСтрок = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
		СтрокаТаблицыФайлов = ЭтаФорма.ТаблицаФайлов.НайтиПоИдентификатору(ИдентификаторСтроки);
		Данные = ПолучитьИзВременногоХранилища(СтрокаТаблицыФайлов.АдресДанных);
		СообщенияПользователю = Данные.СообщенияПользователю;
	КонецЕсли; 
	
	ТаблицаОшибок = ЭтаФорма.Ошибки.Выгрузить(ОтборСтрок, "Рынок, ИдентификаторЦеннойБумаги, Эмитент");
	ТаблицаОшибок.Свернуть("Рынок, ИдентификаторЦеннойБумаги, Эмитент");
	
	Возврат ПоместитьВоВременноеХранилище(Новый Структура("ТаблицаОшибок, СообщенияПользователю", ТаблицаОшибок, СообщенияПользователю), ЭтаФорма.УникальныйИдентификатор);

КонецФункции

&НаСервере
Процедура ОбработатьОшибки(АдресТаблицыОшибок)

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦенныхБумаг.ИдентификаторЦеннойБумаги КАК ИдентификаторЦеннойБумаги,
		|	ТаблицаЦенныхБумаг.Рынок КАК Рынок,
		|	ТаблицаЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ТаблицаЦенныхБумаг
		|ИЗ
		|	&ТаблицаЦенныхБумаг КАК ТаблицаЦенныхБумаг
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ИдентификаторЦеннойБумаги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Ошибки.ИдентификаторЦеннойБумаги КАК ИдентификаторЦеннойБумаги,
		|	Ошибки.ИдентификаторСтроки КАК ИдентификаторСтроки
		|ПОМЕСТИТЬ _Ошибки
		|ИЗ
		|	&Ошибки КАК Ошибки
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ИдентификаторЦеннойБумаги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Ошибки.ИдентификаторЦеннойБумаги КАК ИдентификаторЦеннойБумаги,
		|	_Ошибки.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	_ТаблицаЦенныхБумаг.Рынок КАК Рынок,
		|	_ТаблицаЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦенныхБумаг.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦенныхБумаг.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦенныхБумаг.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦенныхБумаг.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦенныхБумаг.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦенныхБумаг.ЦеннаяБумага) = ТИП(Справочник.ДепозитарныеРасписки)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦенныхБумаг.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.ЮрФизЛицо
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦенныхБумаг.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦенныхБумаг.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаЦенныхБумаг.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаЦенныхБумаг.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
		|	КОНЕЦ КАК ЮрФизЛицо
		|ИЗ
		|	_Ошибки КАК _Ошибки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаЦенныхБумаг КАК _ТаблицаЦенныхБумаг
		|		ПО (_ТаблицаЦенныхБумаг.ИдентификаторЦеннойБумаги = _Ошибки.ИдентификаторЦеннойБумаги)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних КАК РеквизитыПИФСрезПоследних
		|		ПО (ТИПЗНАЧЕНИЯ(_ТаблицаЦенныхБумаг.ЦеннаяБумага) = ТИП(Справочник.Паи))
		|			И (ВЫРАЗИТЬ(_ТаблицаЦенныхБумаг.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|ИТОГИ
		|	МАКСИМУМ(ЦеннаяБумага)
		|ПО
		|	ИдентификаторСтроки";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	ТаблицаЦенныхБумаг = ПолучитьИзВременногоХранилища(АдресТаблицыОшибок);
	ТаблицаОшибок = ЭтаФорма.Ошибки.Выгрузить();
	
	Запрос.УстановитьПараметр("ТаблицаЦенныхБумаг", ТаблицаЦенныхБумаг);
	Запрос.УстановитьПараметр("Ошибки", ТаблицаОшибок);
	
	Результат = Запрос.Выполнить();
	ВыборкаСтрока = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТабличныеЧасти = Новый Массив;
	ТабличныеЧасти.Добавить("ОбъектыИнвестирования");
	ТабличныеЧасти.Добавить("Сделки");
	
	Пока ВыборкаСтрока.Следующий() Цикл
	
		Если ЗначениеЗаполнено(ВыборкаСтрока.ЦеннаяБумага) Тогда
		
			Выборка = ВыборкаСтрока.Выбрать();
			
			ИзменитьСтатус = Истина;
			
			ТекСтрока = ЭтаФорма.ТаблицаФайлов.НайтиПоИдентификатору(ВыборкаСтрока.ИдентификаторСтроки);
			
			Пока Выборка.Следующий() Цикл
			
				Если ЗначениеЗаполнено(Выборка.ЦеннаяБумага) Тогда
					
					ОтборСтрок = Новый Структура("ИдентификаторЦеннойБумаги, ИдентификаторСтроки");
					ЗаполнитьЗначенияСвойств(ОтборСтрок, Выборка);
					НайденныеСтроки = ТаблицаОшибок.НайтиСтроки(ОтборСтрок);
					ТаблицаОшибок.Удалить(НайденныеСтроки[0]);
					
					Данные = ПолучитьИзВременногоХранилища(ТекСтрока.АдресДанных);
					Док = Данные.Документ;
					
					Для каждого ТабЧасть Из ТабличныеЧасти Цикл
						
						НайденныеСтроки = Док[ТабЧасть].НайтиСтроки(Новый Структура("ЦеннаяБумага", Выборка.ЦеннаяБумага));
						Для каждого СтрокаТЧ Из НайденныеСтроки Цикл
							ЗаполнитьЗначенияСвойств(СтрокаТЧ, Выборка);
						КонецЦикла; 
					
					КонецЦикла; 
					
					ПоместитьВоВременноеХранилище(Новый Структура("Документ", Док), ТекСтрока.АдресДанных);
					
					Если Данные.СообщенияПользователю.Количество() > 0 Тогда
						ИзменитьСтатус = Ложь;
					КонецЕсли; 
					
				Иначе
					ИзменитьСтатус = Ложь;
				КонецЕсли;
			
			КонецЦикла; 
			
			Если ИзменитьСтатус Тогда
				ТекСтрока.Статус = "Готов к загрузке";
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла;
	
	ЭтаФорма.Ошибки.Загрузить(ТаблицаОшибок);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьФайлВХранилище(Организация, Документ, ПутьКФайлу, Адрес)

	МетаданныеВладельца = Документ.Метаданные();
	ТипВладельца = МетаданныеВладельца.ПолноеИмя();
	ИдентификаторВладельца = Строка(Документ.УникальныйИдентификатор());
	НаименованиеВладельца = Строка(Документ);
	
	Файл = Новый Файл(ПутьКФайлу);
	
	ПараметрыФайла = Новый Структура;

	ПараметрыФайла.Вставить("Адрес",					Адрес);
	ПараметрыФайла.Вставить("Имя",						Файл.ИмяБезРасширения);
	ПараметрыФайла.Вставить("Расширение",				Сред(Файл.Расширение, 2));
	ПараметрыФайла.Вставить("НаименованиеВладельца",	НаименованиеВладельца);
	ПараметрыФайла.Вставить("ИдентификаторВладельца",	ИдентификаторВладельца);
	ПараметрыФайла.Вставить("ТипВладельца",				ТипВладельца);

	Попытка
		
		ДанныеВерсии = РаботаСФайловымХранилищем.СоздатьФайл(ПараметрыФайла, Организация);	
		РаботаСФайловымХранилищем.ПриИзмененииПрисоединенныхФайлов(Документ);
		ЗаписьЖурналаРегистрации("Файловое хранилище.Добавление файла", ПредопределенноеЗначение("УровеньЖурналаРегистрации.Информация"), МетаданныеВладельца, Документ, "Добавлен файл: """ + Файл.Имя + """");
		
	Исключение
		ТекстОшибки = СтрШаблон("Не удалось сохранить данные файла %1 в файловом хранилище из-за ошибки:%2", 
			ПутьКФайлу, 
			Символы.ПС + ОписаниеОшибки());
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти 

#Область Чтение_файлов

&НаКлиенте
Процедура ПрочитатьФайл(ПараметрыФайла) Экспорт

	ФорматФайла = ПараметрыФайла.ФорматФайла;
	
	Если ФорматФайла = НРег("Открытие") 
		Или ФорматФайла = НРег("БКС") 
		Или ФорматФайла = НРег("УКРИ") Тогда
		// это Excel файлы
		ПрочитатьExcelФайл(ПараметрыФайла);
	ИначеЕсли ФорматФайла = НРег("УК РЕГИОН") Тогда 
		// это xml, выгруженный с помощью команды ВыгрузитьОперации формы списка документов СведенияПредоставляемыеЮрФизЛицами
		ПрочитатьФайлУКРегион(Новый ДвоичныеДанные(ПараметрыФайла.ПутьКФайлу), ПараметрыФайла);
	ИначеЕсли ФорматФайла = НРег("БК РЕГИОН")
		Или ФорматФайла = НРег("Эволюция") Тогда 
		// это html от БК
		ПрочитатьФайлБКРегион(ПараметрыФайла);
	КонецЕсли;
	
КонецПроцедуры

#Область Открытие

&НаКлиенте
Процедура ПрочитатьФайлОткрытие(ПараметрыЧтения, НомерСтроки)

	Excel 					= ПараметрыЧтения.Excel;
	ПоследняяКолонка 		= ПараметрыЧтения.ПоследняяКолонка;
	ПоследняяСтрока 		= ПараметрыЧтения.ПоследняяСтрока;
	СтруктураТаблиц			= ПараметрыЧтения.СтруктураТаблиц;
	
	Если Не ПараметрыЧтения.АктивыОбработаны И СокрЛП(Excel.Cells(НомерСтроки, 1).Value) = "Активы клиента (ценные бумаги и денежные средства)" Тогда
		
		НомерСтроки = НомерСтроки + 1; // переходим к шапке
		
		ЗагружаемыеКолонки = Новый Соответствие; 
		ЗагружаемыеКолонки.Вставить("Инструмент", "Инструмент");
		ЗагружаемыеКолонки.Вставить("Гос. рег. номер", "РегНомер");
		ЗагружаемыеКолонки.Вставить("Активы на начало периода - Остаток (факт)", "НачальныйОстаток");
		ЗагружаемыеКолонки.Вставить("Активы на конец периода - Остаток (факт)", "КонечныйОстаток");
		
		ВысотаШапки = 2;
		
		ПараметрыКолонок = ПрочитатьШапку(Excel, НомерСтроки, ВысотаШапки, ПоследняяКолонка, ЗагружаемыеКолонки); 
		
		НомерСтроки = НомерСтроки + ВысотаШапки;
		
		СтруктураТаблиц.Вставить("Активы", ПрочитатьТаблицуОткрытие(Excel, НомерСтроки, ПоследняяСтрока, ПараметрыКолонок));
		
		ПараметрыЧтения.АктивыОбработаны = Истина;
		
	КонецЕсли; 
	
	Если Не ПараметрыЧтения.СделкиОбработаны И СокрЛП(Excel.Cells(НомерСтроки, 1).Value) = "Заключенные в отчетном периоде сделки купли/продажи ценных бумаг" Тогда
	
		НомерСтроки = НомерСтроки + 1;
		
		ЗагружаемыеКолонки = Новый Соответствие; 
		ЗагружаемыеКолонки.Вставить("Инструмент", "Инструмент");
		ЗагружаемыеКолонки.Вставить("Гос. рег. номер", "РегНомер");
		ЗагружаемыеКолонки.Вставить("Дата заключения", "ДатаСделки");
		ЗагружаемыеКолонки.Вставить("Время заключения", "ВремяСделки");
		ЗагружаемыеКолонки.Вставить("Куплено, шт.", "Куплено");
		ЗагружаемыеКолонки.Вставить("Продано, шт.", "Продано");
		ЗагружаемыеКолонки.Вставить("Валюта расчетов", "ВалютаРасчетов");
		ЗагружаемыеКолонки.Вставить("Объем сделки в валюте расчетов", "Сумма");
		ЗагружаемыеКолонки.Вставить("НКД " + Символы.ПС + "по сделке в валюте расчетов", "НКД");
		
		ВысотаШапки = 1;
		
		ПараметрыКолонок = ПрочитатьШапку(Excel, НомерСтроки, ВысотаШапки, ПоследняяКолонка, ЗагружаемыеКолонки); 
		
		НомерСтроки = НомерСтроки + ВысотаШапки;
		
		СтруктураТаблиц.Вставить("Сделки", ПрочитатьТаблицуОткрытие(Excel, НомерСтроки, ПоследняяСтрока, ПараметрыКолонок));
		
		ПараметрыЧтения.СделкиОбработаны = Истина;
	
	КонецЕсли; 
	
	Если Не ПараметрыЧтения.СделкиРЕПООбработаны И СокрЛП(Excel.Cells(НомерСтроки, 1).Value) = "Заключенные в отчетном периоде сделки РЕПО" Тогда
	
		НомерСтроки = НомерСтроки + 1;
		
		ЗагружаемыеКолонки = Новый Соответствие; 
		ЗагружаемыеКолонки.Вставить("Инструмент", "Инструмент");
		ЗагружаемыеКолонки.Вставить("Гос. рег. номер", "РегНомер");
		ЗагружаемыеКолонки.Вставить("Дата заключения", "ДатаСделки");
		ЗагружаемыеКолонки.Вставить("Время заключения", "ВремяСделки");
		ЗагружаемыеКолонки.Вставить("Куплено, шт.", "Куплено");
		ЗагружаемыеКолонки.Вставить("Продано, шт.", "Продано");
		ЗагружаемыеКолонки.Вставить("Валюта расчетов", "ВалютаРасчетов");
		ЗагружаемыеКолонки.Вставить("Объем сделки в валюте расчетов", "Сумма");
		ЗагружаемыеКолонки.Вставить("НКД по сделке в валюте расчетов", "НКД");
		ЗагружаемыеКолонки.Вставить("Ставка РЕПО, %", "СтавкаРЕПО");
		ЗагружаемыеКолонки.Вставить("Комментарий", "Комментарий");
		ЗагружаемыеКолонки.Вставить("Плановая " + Символы.ПС + "дата исполнения", "ДатаИсполненияРЕПО");
		
		ВысотаШапки = 1;
		
		ПараметрыКолонок = ПрочитатьШапку(Excel, НомерСтроки, ВысотаШапки, ПоследняяКолонка, ЗагружаемыеКолонки); 
		
		НомерСтроки = НомерСтроки + ВысотаШапки;
		
		СделкиРЕПОМассив = ПрочитатьТаблицуОткрытие(Excel, НомерСтроки, ПоследняяСтрока, ПараметрыКолонок);
		Для каждого СделкаРЕПО Из СделкиРЕПОМассив Цикл
			СтруктураТаблиц.Сделки.Добавить(СделкаРЕПО);
		КонецЦикла; 
		
		ПараметрыЧтения.СделкиРЕПООбработаны = Истина;
	
	КонецЕсли;			

КонецПроцедуры

&НаКлиенте
Функция ПрочитатьТаблицуОткрытие(Excel, НомерСтроки, НомерПоследнейСтроки, ПараметрыКолонок)

	Таблица = Новый Массив;
	
	Рынок = Неопределено;
	
	НазванияРазделов = Новый Массив;
	НазванияРазделов.Добавить("Денежные средства");
	НазванияРазделов.Добавить("Завершенные в отчетном периоде сделки купли/продажи ценных бумаг");
	НазванияРазделов.Добавить("Заключенные в отчетном периоде сделки РЕПО");
	
	Пока НомерСтроки < НомерПоследнейСтроки Цикл
	
		Ячейка = Excel.Cells(НомерСтроки, 1);
		
		Если Ячейка.MergeCells Тогда
			
			Текст = СокрЛП(Ячейка.Text);
			Если НазванияРазделов.Найти(Текст) <> Неопределено Тогда
				// это следующий раздел
				Прервать;
			ИначеЕсли НРег(Лев(Текст, 5)) <> "итого" Тогда
				// строки с итогами пропускаем, если это не итог - это рынок
				Рынок = Текст;
			КонецЕсли;
			
		Иначе
			
			// это детальные записи
			ДанныеСтроки = Новый Структура;
			
			Для каждого ТекКолонка Из ПараметрыКолонок Цикл
				
				Смещение = ?(ТекКолонка.Ключ = "Инструмент", 1, 0);
				Значение = Excel.Cells(НомерСтроки, ТекКолонка.Значение + Смещение).Value;
				Значение = ?(ТипЗнч(Значение) = Тип("Строка"), СокрЛП(Значение), Значение);
				
				ДанныеСтроки.Вставить(ТекКолонка.Ключ, Значение);
				Если ЗначениеЗаполнено(Рынок) Тогда
					ДанныеСтроки.Вставить("Рынок", Рынок);
				КонецЕсли; 
				
			КонецЦикла; 
			
			Если ПараметрыКолонок.Получить("СтавкаРЕПО") <> Неопределено И ДанныеСтроки.Комментарий = "1ая часть, перенос позиции" Тогда
				
				НомерСтроки = НомерСтроки + 1;
				ДатаИсполненияРЕПО = Excel.Cells(НомерСтроки, ПараметрыКолонок["ДатаИсполненияРЕПО"]).Value;
				ДанныеСтроки.Вставить("ДатаИсполненияРЕПО", ДатаИсполненияРЕПО);
			
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(ДанныеСтроки.Инструмент) Тогда
				Таблица.Добавить(ДанныеСтроки);
			КонецЕсли; 
		
		КонецЕсли; 
		
		НомерСтроки = НомерСтроки + 1;
			
	КонецЦикла; 
	
	Возврат Таблица;

КонецФункции

&НаСервереБезКонтекста
Процедура ОбработатьДанныеБрокераОткрытие(ДанныеДляОбработки, ПараметрыФайла)
	
	Документ = ПолучитьДокумент(ПараметрыФайла);
	
	ТаблицаАктивов = Документ.ОбъектыИнвестирования.Выгрузить();
	
	ОписаниеТиповСумма = Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип;
	ТаблицаСделок = Документ.Сделки.Выгрузить();
	ТаблицаСделок.Колонки.Добавить("ВалютаРасчетов", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаСделок.Колонки.Добавить("НКДВВалютеРасчетов", ОписаниеТиповСумма);
	ТаблицаСделок.Колонки.Добавить("СуммаВВалютеРасчетов", ОписаниеТиповСумма);
	
	Ошибки = Новый Соответствие;
	
	КэшОбъектов = Новый Соответствие;
	
	Для каждого СтрокаАктивы Из ДанныеДляОбработки.АктивыМассив Цикл
		
		НоваяСтрока = ТаблицаАктивов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАктивы);
		
		НоваяСтрока.ИдентификаторЦеннойБумаги = СтрокаАктивы.РегНомер;
		
		ЦеннаяБумага = НайтиЦеннуюБумагу(СтрокаАктивы.РегНомер, КэшОбъектов);
		
		Если ЗначениеЗаполнено(ЦеннаяБумага) Тогда
			
			НоваяСтрока.ЦеннаяБумага = ЦеннаяБумага;
			НоваяСтрока.Рынок = РаботаСЦеннымиБумагамиКлиентСервер.РынокПоЦеннойБумаге(ЦеннаяБумага);
			
		Иначе
			
			РынокСтрока = "";
			СтрокаАктивы.Свойство("Рынок", РынокСтрока);
			Если ЗначениеЗаполнено(РынокСтрока) Тогда
				НоваяСтрока.Рынок = Перечисления.РынкиЦенныхБумаг[РынокСтрока];
			КонецЕсли; 
			
			ДобавитьОшибку(Ошибки, НоваяСтрока.Рынок, НоваяСтрока.ИдентификаторЦеннойБумаги, НоваяСтрока.Эмитент);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаАктивов", ТаблицаАктивов);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаАктивов.Рынок КАК Рынок,
		|	ТаблицаАктивов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаАктивов.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ТаблицаАктивов.ИдентификаторЦеннойБумаги КАК ИдентификаторЦеннойБумаги,
		|	ТаблицаАктивов.Эмитент КАК Эмитент,
		|	ТаблицаАктивов.НачальныйОстаток КАК НачальныйОстаток,
		|	ТаблицаАктивов.Приход КАК Приход,
		|	ТаблицаАктивов.Расход КАК Расход,
		|	ТаблицаАктивов.КонечныйОстаток КАК КонечныйОстаток
		|ПОМЕСТИТЬ _ТаблицаАктивов
		|ИЗ
		|	&ТаблицаАктивов КАК ТаблицаАктивов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаАктивов.Рынок КАК Рынок,
		|	_ТаблицаАктивов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|		КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|		КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
		|		КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.ЮрФизЛицо
		|		КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
		|		КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
		|	КОНЕЦ КАК ЮрФизЛицо,
		|	_ТаблицаАктивов.ИдентификаторЦеннойБумаги КАК ИдентификаторЦеннойБумаги,
		|	_ТаблицаАктивов.Эмитент КАК Эмитент,
		|	_ТаблицаАктивов.НачальныйОстаток КАК НачальныйОстаток,
		|	_ТаблицаАктивов.Приход КАК Приход,
		|	_ТаблицаАктивов.Расход КАК Расход,
		|	_ТаблицаАктивов.КонечныйОстаток КАК КонечныйОстаток
		|ИЗ
		|	_ТаблицаАктивов КАК _ТаблицаАктивов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних КАК РеквизитыПИФСрезПоследних
		|		ПО (_ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РЫнкиЦенныхБумаг.Паи))
		|			И (ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)";
	
	ТаблицаАктивов = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаСделки Из ДанныеДляОбработки.СделкиМассив Цикл
	
		НоваяСтрока = ТаблицаСделок.Добавить();
		
		НоваяСтрока.ДатаСделки = Дата(СтрокаСделки.ДатаСделки + " " + СтрокаСделки.ВремяСделки);
		
		ЦеннаяБумага = КэшОбъектов.Получить(СтрокаСделки.РегНомер);
		
		Если ЦеннаяБумага = Неопределено Тогда
			СтрокаАктивы = ТаблицаАктивов.Найти(СтрокаСделки.РегНомер, "ИдентификаторЦеннойБумаги");
		Иначе
			СтрокаАктивы = ТаблицаАктивов.Найти(ЦеннаяБумага, "ЦеннаяБумага");
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАктивы);
		
		СтрокаСделки.Куплено = ?(СтрокаСделки.Куплено = "", 0, СтрокаСделки.Куплено); 
		СтрокаСделки.Продано = ?(СтрокаСделки.Продано = "", 0, СтрокаСделки.Продано); 
		
		НоваяСтрока.Количество = СтрокаСделки.Куплено + СтрокаСделки.Продано;
		
		Если Число(СтрокаСделки.Куплено) > 0 Тогда
			// это покупка
			НоваяСтрока.ВидСделки = Перечисления.ВидыСделок.Покупка;
			СтрокаАктивы.Приход = СтрокаАктивы.Приход + СтрокаСделки.Куплено;
		Иначе
			// это продажа
			НоваяСтрока.ВидСделки = Перечисления.ВидыСделок.Продажа;
			СтрокаАктивы.Расход = СтрокаАктивы.Расход + СтрокаСделки.Продано;
		КонецЕсли; 
		
		Валюта = КэшОбъектов.Получить(СтрокаСделки.ВалютаРасчетов);
		Если Валюта = Неопределено Тогда
			НоваяСтрока.ВалютаРасчетов = ПолучитьВалютуПоНаименованию(СтрокаСделки.ВалютаРасчетов);
			КэшОбъектов.Вставить(СтрокаСделки.ВалютаРасчетов, НоваяСтрока.ВалютаРасчетов);
		Иначе
			НоваяСтрока.ВалютаРасчетов = Валюта;
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(НоваяСтрока.ВалютаРасчетов) Тогда
		
			НоваяСтрока.НКДВВалютеРасчетов = СтрокаСделки.НКД;
			НоваяСтрока.СуммаВВалютеРасчетов = СтрокаСделки.Сумма;
		
		КонецЕсли;
		
		Если СтрокаСделки.Свойство("СтавкаРЕПО") Тогда
			НоваяСтрока.СтавкаРЕПО = СтрокаСделки.СтавкаРЕПО;
			НоваяСтрока.СрокРЕПО = Справочники.Календари.КоличествоРабочихДней(Константы.ОсновнойКалендарьКотировок.Получить(), НоваяСтрока.ДатаСделки, Дата(СтрокаСделки.ДатаИсполненияРЕПО + " 00:00:00")) - 1;
		КонецЕсли;
				
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ТаблицаСделок", ТаблицаСделок);
	Запрос.УстановитьПараметр("ВалютаУчета", Документ.Организация.ВалютаУчета);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаСделок.ДатаСделки КАК ДатаСделки,
		|	ТаблицаСделок.ВидСделки КАК ВидСделки,
		|	ТаблицаСделок.Рынок КАК Рынок,
		|	ТаблицаСделок.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСделок.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ТаблицаСделок.ИдентификаторЦеннойБумаги КАК ИдентификаторЦеннойБумаги,
		|	ТаблицаСделок.Эмитент КАК Эмитент,
		|	ТаблицаСделок.Количество КАК Количество,
		|	ТаблицаСделок.ВалютаРасчетов КАК ВалютаРасчетов,
		|	ТаблицаСделок.НКДВВалютеРасчетов КАК НКДВВалютеРасчетов,
		|	ТаблицаСделок.СуммаВВалютеРасчетов КАК СуммаВВалютеРасчетов,
		|	ТаблицаСделок.СтавкаРЕПО КАК СтавкаРЕПО,
		|	ТаблицаСделок.СрокРЕПО КАК СрокРЕПО,
		|	НАЧАЛОПЕРИОДА(ТаблицаСделок.ДатаСделки, ДЕНЬ) КАК Период,
		|	ТаблицаСделок.СуммаВВалютеРасчетов - ТаблицаСделок.НКДВВалютеРасчетов КАК СуммаБезНКДВвалютеРасчетов,
		|	(ТаблицаСделок.СуммаВВалютеРасчетов - ТаблицаСделок.НКДВВалютеРасчетов) / ТаблицаСделок.Количество КАК ЦенаВВалютеРасчетов
		|ПОМЕСТИТЬ _ТаблицаСделок
		|ИЗ
		|	&ТаблицаСделок КАК ТаблицаСделок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаСделок.ДатаСделки КАК ДатаСделки,
		|	_ТаблицаСделок.ВидСделки КАК ВидСделки,
		|	_ТаблицаСделок.Рынок КАК Рынок,
		|	_ТаблицаСделок.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаСделок.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_ТаблицаСделок.ИдентификаторЦеннойБумаги КАК ИдентификаторЦеннойБумаги,
		|	_ТаблицаСделок.Эмитент КАК Эмитент,
		|	_ТаблицаСделок.Количество КАК Количество,
		|	_ТаблицаСделок.СтавкаРЕПО КАК СтавкаРЕПО,
		|	_ТаблицаСделок.СрокРЕПО КАК СрокРЕПО,
		|	_ТаблицаСделок.ЦенаВВалютеРасчетов * КурсыВалютРасчетов.Курс / КурсыВалютРасчетов.Кратность / КурсыВалютыУчета.Курс * КурсыВалютыУчета.Кратность КАК Цена,
		|	_ТаблицаСделок.СуммаБезНКДВвалютеРасчетов * КурсыВалютРасчетов.Курс / КурсыВалютРасчетов.Кратность / КурсыВалютыУчета.Курс * КурсыВалютыУчета.Кратность КАК СуммаБезНКД,
		|	_ТаблицаСделок.НКДВВалютеРасчетов * КурсыВалютРасчетов.Курс / КурсыВалютРасчетов.Кратность / КурсыВалютыУчета.Курс * КурсыВалютыУчета.Кратность КАК НКД
		|ИЗ
		|	_ТаблицаСделок КАК _ТаблицаСделок
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютРасчетов
		|		ПО _ТаблицаСделок.Период = КурсыВалютРасчетов.Период
		|			И _ТаблицаСделок.ВалютаРасчетов = КурсыВалютРасчетов.Валюта
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютыУчета
		|		ПО _ТаблицаСделок.Период = КурсыВалютыУчета.Период
		|			И (КурсыВалютыУчета.Валюта = &ВалютаУчета)";
	
	Документ.ОбъектыИнвестирования.Загрузить(ТаблицаАктивов);
	Документ.Сделки.Загрузить(Запрос.Выполнить().Выгрузить());
	
	СообщенияПользователю = ПолучитьСообщенияПользователю(Истина);
	ДобавитьОшибкиВПараметрыФайла(Ошибки, СообщенияПользователю, ПараметрыФайла);
	ПоместитьДанныеВоВременноеХранилище(СообщенияПользователю, Документ, ПараметрыФайла.АдресДанных);

КонецПроцедуры

#КонецОбласти

#Область БКС

&НаКлиенте
Процедура ПрочитатьФайлБКС(ПараметрыЧтения, НомерСтроки)

	Excel 					= ПараметрыЧтения.Excel;
	ПоследняяКолонка 		= ПараметрыЧтения.ПоследняяКолонка;
	ПоследняяСтрока 		= ПараметрыЧтения.ПоследняяСтрока;
	СтруктураТаблиц			= ПараметрыЧтения.СтруктураТаблиц;
	
	Если СокрЛП(Excel.Cells(НомерСтроки, 2).Value) = "Период:" Тогда
	
		ПериодСтрока = СокрЛП(Excel.Cells(НомерСтроки, 6).Value);
		ПериодСтрока = СтрЗаменить(ПериодСтрока, "с ", "");
		ПериодСтрока = СтрЗаменить(ПериодСтрока, " по ", ",");
		ПериодМассив = СтрРазделить(ПериодСтрока, ",");
		Попытка
			НачалоПериода = Дата(ПериодМассив[0] + " 00:00:00");
			ОкончаниеПериода = Дата(ПериодМассив[1] + " 00:00:00");	
			СтруктураТаблиц.Вставить("НачалоПериода", НачалоПериода);
			СтруктураТаблиц.Вставить("ОкончаниеПериода", ОкончаниеПериода);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить период отчета. Сделки могут быть загружены некорректно");
		КонецПопытки; 
		
	КонецЕсли; 
	
	Если Не ПараметрыЧтения.СделкиОбработаны И СокрЛП(Excel.Cells(НомерСтроки, 2).Value) = "2.1. Сделки:" Тогда
		
		НомерСтроки = НомерСтроки + 1;
		
		ЗагружаемыеКолонки = Новый Соответствие; 
		ЗагружаемыеКолонки.Вставить("ДатаСделки", 13);
		ЗагружаемыеКолонки.Вставить("ВремяСделки", 14);
		ЗагружаемыеКолонки.Вставить("Куплено", 5);
		ЗагружаемыеКолонки.Вставить("Сумма", 7);
		ЗагружаемыеКолонки.Вставить("Продано", 8);
		ЗагружаемыеКолонки.Вставить("СуммаПродажи", 10);
		ЗагружаемыеКолонки.Вставить("ВалютаРасчетов", 11);
		
		ТекISIN = "";
		ТекЭмитент = "";
		ТекРынок = "";
		
		Пока НомерСтроки < ПоследняяСтрока И СокрЛП(Excel.Cells(НомерСтроки, 2).Value) <> "Иностранная валюта" 
			И СокрЛП(Excel.Cells(НомерСтроки, 2).Value) <> "Займы ""Овернайт ЦБ"":" 
			И СокрЛП(Excel.Cells(НомерСтроки, 2).Value) <> "3. Активы:" Цикл
			
			ПерваяЯчейка = СокрЛП(Excel.Cells(НомерСтроки, 2).Value);
			Если ПерваяЯчейка = "АДР" Тогда
				ТекРынок = "ДепозитарныеРасписки";
			ИначеЕсли ПерваяЯчейка = "Акция" Тогда
				ТекРынок = "Акции";
			ИначеЕсли ПерваяЯчейка = "Дата" Или ПерваяЯчейка = "" Или СтрНачинаетсяС(ПерваяЯчейка, "Валюта цены = ") 
				Или СтрНачинаетсяС(ПерваяЯчейка, "Итого по ") Тогда
				// тут ничего не делаем, идем дальше
			ИначеЕсли СтрНачинаетсяС(ПерваяЯчейка, "Итого") И СокрЛП(Excel.Cells(НомерСтроки+1, 2).Value) = "" Тогда 
				// это конец таблицы, выходим
				Прервать;
			ИначеЕсли РаботаСоСтрокамиКлиентСервер.ТолькоЦифрыВСтроке(СтрЗаменить(ПерваяЯчейка, ".", "")) Тогда
				
				// это строка сделки
				ДанныеСтроки = Новый Структура;
				Для каждого Колонка Из ЗагружаемыеКолонки Цикл
					ДанныеСтроки.Вставить(Колонка.Ключ, СокрЛП(Excel.Cells(НомерСтроки, Колонка.Значение).Value));
				КонецЦикла; 
				ДанныеСтроки.Вставить("ИдентификаторЦеннойБумаги", ТекISIN);
				ДанныеСтроки.Вставить("Эмитент", ТекЭмитент);
				ДанныеСтроки.Вставить("Рынок", ТекРынок);
				
				ТипСделки = СокрЛП(Excel.Cells(НомерСтроки, 15).Value);
				
				Если СтрНачинаетсяС(ТипСделки, "Репо") Тогда
					ДанныеСтроки.Вставить("ДатаСделки", СокрЛП(Excel.Cells(НомерСтроки, 2).Value));
					ДанныеСтроки.Вставить("ВремяСделки", СокрЛП(Excel.Cells(НомерСтроки, 4).Value));
					ДанныеСтроки.Вставить("НомерСделки", СокрЛП(Excel.Cells(НомерСтроки, 3).Value));
					ДанныеСтроки.Вставить("ЧастьСделкиРЕПО", СтрЗаменить(ТипСделки, "Репо ч.", ""));
				КонецЕсли; 
				
				СтруктураТаблиц.Сделки.Добавить(ДанныеСтроки);
				
			Иначе 
				// это шапка актива
				ТекISIN = СокрЛП(Excel.Cells(НомерСтроки, 8).Value);
				ТекЭмитент = СокрЛП(Excel.Cells(НомерСтроки, 9).Value);
				
			КонецЕсли; 
			
			НомерСтроки = НомерСтроки + 1;
		
		КонецЦикла; 
		
		ПараметрыЧтения.СделкиОбработаны = Истина;
		
	КонецЕсли;
	
	Если СокрЛП(Excel.Cells(НомерСтроки, 2).Value) = "Иностранная валюта" Тогда
		
		НомерСтроки = НомерСтроки + 1;
		
		ЗагружаемыеКолонки = Новый Соответствие; 
		ЗагружаемыеКолонки.Вставить("Курс", 5);
		ЗагружаемыеКолонки.Вставить("Куплено", 6);
		ЗагружаемыеКолонки.Вставить("Сумма", 7);
		ЗагружаемыеКолонки.Вставить("КурсПродажи", 8);
		ЗагружаемыеКолонки.Вставить("Продано", 9);
		ЗагружаемыеКолонки.Вставить("СуммаПродажи", 10);
		ЗагружаемыеКолонки.Вставить("ДатаСделки", 11);
		ЗагружаемыеКолонки.Вставить("ВремяСделки", 12);
										
		Валюта = "";
		КонтрВалюта = "";
		
		Пока НомерСтроки < ПоследняяСтрока И СокрЛП(Excel.Cells(НомерСтроки, 2).Value) <> "Займы ""Овернайт ЦБ"":" Цикл
		
			ПерваяЯчейка = СокрЛП(Excel.Cells(НомерСтроки, 2).Value);
			Если ПерваяЯчейка = "Дата" Или ПерваяЯчейка = "" Или СтрНачинаетсяС(ПерваяЯчейка, "Итого по ") Тогда
				// тут ничего не делаем, идем дальше
			ИначеЕсли СтрНачинаетсяС(ПерваяЯчейка, "Итого") И СокрЛП(Excel.Cells(НомерСтроки+1, 2).Value) = "" Тогда 
				// это конец таблицы, выходим
				Прервать;	
			ИначеЕсли РаботаСоСтрокамиКлиентСервер.ТолькоЦифрыВСтроке(СтрЗаменить(ПерваяЯчейка, ".", "")) Тогда
				
				// это строка сделки
				ДанныеСтроки = Новый Структура;
				Для каждого Колонка Из ЗагружаемыеКолонки Цикл
					ДанныеСтроки.Вставить(Колонка.Ключ, СокрЛП(Excel.Cells(НомерСтроки, Колонка.Значение).Value));
				КонецЦикла; 
				ДанныеСтроки.Вставить("Валюта", Валюта);
				ДанныеСтроки.Вставить("КонтрВалюта", КонтрВалюта);
				
				СтруктураТаблиц.СделкиСВалютой.Добавить(ДанныеСтроки);
				
			Иначе 
				// это шапка актива
				Валюта = СокрЛП(Excel.Cells(НомерСтроки, 6).Value);
				КонтрВалюта = СокрЛП(Excel.Cells(НомерСтроки, 9).Value);
				
			КонецЕсли; 
			
			НомерСтроки = НомерСтроки + 1;
		
		КонецЦикла; 
		
		ПараметрыЧтения.СделкиОбработаны = Истина;
		
	КонецЕсли;
	
	Если СокрЛП(Excel.Cells(НомерСтроки, 2).Value) = "2.3. Незавершенные сделки" Тогда
	
		НомерСтроки = НомерСтроки + 1;
		
		ЗагружаемыеКолонки = Новый Соответствие; 
		ЗагружаемыеКолонки.Вставить("ДатаСделки", 17);
		ЗагружаемыеКолонки.Вставить("ВремяСделки", 18);
		ЗагружаемыеКолонки.Вставить("Куплено", 5);
		ЗагружаемыеКолонки.Вставить("Сумма", 7);
		ЗагружаемыеКолонки.Вставить("Продано", 10);
		ЗагружаемыеКолонки.Вставить("СуммаПродажи", 12);
		
		ТекISIN = "";
		ТекЭмитент = "";
		ТекВалюта = "";
		
		Пока НомерСтроки < ПоследняяСтрока И СокрЛП(Excel.Cells(НомерСтроки, 2).Value) <> "3. Активы:" Цикл// Или СокрЛП(Excel.Cells(НомерСтроки, 2).Value) <> "Займы ""Овернайт ЦБ"":") Цикл
		
			ПерваяЯчейка = СокрЛП(Excel.Cells(НомерСтроки, 2).Value);
			Если СтрНачинаетсяС(ПерваяЯчейка, "Итого") И СокрЛП(Excel.Cells(НомерСтроки+1, 2).Value) = "" Тогда 
				// это конец таблицы, выходим
				Прервать;
			ИначеЕсли ПерваяЯчейка = "Дата" Или ПерваяЯчейка = "" Или СтрНачинаетсяС(ПерваяЯчейка, "Итого") Тогда
				// тут ничего не делаем, идем дальше
			ИначеЕсли РаботаСоСтрокамиКлиентСервер.ТолькоЦифрыВСтроке(СтрЗаменить(ПерваяЯчейка, ".", "")) Тогда
				
				// это строка сделки
				ДанныеСтроки = Новый Структура;
				Для каждого Колонка Из ЗагружаемыеКолонки Цикл
					ДанныеСтроки.Вставить(Колонка.Ключ, СокрЛП(Excel.Cells(НомерСтроки, Колонка.Значение).Value));
				КонецЦикла; 
				ДанныеСтроки.Вставить("ИдентификаторЦеннойБумаги", ТекISIN);
				ДанныеСтроки.Вставить("Эмитент", ТекЭмитент);
				ДанныеСтроки.Вставить("ВалютаРасчетов", ТекВалюта);
				
				ТипСделки = СокрЛП(Excel.Cells(НомерСтроки, 15).Value);
				
				Если СтрНачинаетсяС(ТипСделки, "Репо") Тогда
					ДанныеСтроки.Вставить("ДатаСделки", СокрЛП(Excel.Cells(НомерСтроки, 2).Value));
					ДанныеСтроки.Вставить("ВремяСделки", СокрЛП(Excel.Cells(НомерСтроки, 4).Value));
					ДанныеСтроки.Вставить("НомерСделки", СокрЛП(Excel.Cells(НомерСтроки, 3).Value));
					ДанныеСтроки.Вставить("ЧастьСделкиРЕПО", СтрЗаменить(ТипСделки, "Репо ч.", ""));
				КонецЕсли; 
				
				СтруктураТаблиц.Сделки.Добавить(ДанныеСтроки);
				
			ИначеЕсли СтрНачинаетсяС(ПерваяЯчейка, "Валюта цены = ") Тогда
				// отсюда берем валюту цены, т.к. в строке ее почему-то нет
				ТекВалюта = Сред(ПерваяЯчейка, СтрДлина("Валюта цены = "+1), 3);
			Иначе 
				// это шапка актива
				ТекISIN = СокрЛП(Excel.Cells(НомерСтроки, 8).Value);
				ТекЭмитент = СокрЛП(Excel.Cells(НомерСтроки, 9).Value);
			КонецЕсли; 
			
			НомерСтроки = НомерСтроки + 1;
		
		КонецЦикла;
	
	КонецЕсли;
	
	Если СокрЛП(Excel.Cells(НомерСтроки, 2).Value) = "Портфель по ценным бумагам и денежным средствам (Рубль)"
		И СокрЛП(Excel.Cells(НомерСтроки+1, 2).Value) = "Вид актива"Тогда
	
		НомерСтроки = НомерСтроки + 1;
		
		ЗагружаемыеКолонки = Новый Соответствие; 
		ЗагружаемыеКолонки.Вставить("ИдентификаторЦеннойБумаги", 4);
		ЗагружаемыеКолонки.Вставить("Эмитент", 17);
		ЗагружаемыеКолонки.Вставить("НачальныйОстаток", 7);
		ЗагружаемыеКолонки.Вставить("КонечныйОстаток", 11);
		
		ОстаткиНайдены = Ложь;
		
		Пока НомерСтроки < ПоследняяСтрока И СокрЛП(Excel.Cells(НомерСтроки, 2).Value) <> "Обязательства клиента" Цикл
		
			ПерваяЯчейка = СокрЛП(Excel.Cells(НомерСтроки, 4).Value);
			Если ПерваяЯчейка = "" Или ПерваяЯчейка = "Номер гос. регистрации ЦБ/ ISIN" Тогда
				// тут ничего не делаем, идем дальше
			ИначеЕсли ПерваяЯчейка <> "" Тогда
				
				ДанныеСтроки = Новый Структура;
				Для каждого Колонка Из ЗагружаемыеКолонки Цикл
					ДанныеСтроки.Вставить(Колонка.Ключ, СокрЛП(Excel.Cells(НомерСтроки, Колонка.Значение).Value));
				КонецЦикла; 
				
				ТипЦБ = СокрЛП(Excel.Cells(НомерСтроки, 6).Value);
				Если ТипЦБ = "АДР" Тогда
					ДанныеСтроки.Вставить("Рынок", "ДепозитарныеРасписки");
				ИначеЕсли СтрНачинаетсяС(ТипЦБ, "АО") Тогда 
					ДанныеСтроки.Вставить("Рынок", "Акции");
				КонецЕсли; 
				
				СтруктураТаблиц.Активы.Добавить(ДанныеСтроки);
				
			КонецЕсли; 
			
			НомерСтроки = НомерСтроки + 1;
		
		КонецЦикла;
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбработатьДанныеБрокераБКС(ДанныеДляОбработки, ПараметрыФайла)
	
	Период = Новый Массив;
	Период.Добавить("НачалоПериода");
	Период.Добавить("ОкончаниеПериода");
	
	Для каждого ВидПериода Из Период Цикл
		Если ДанныеДляОбработки.Свойство(ВидПериода) И ЗначениеЗаполнено(ДанныеДляОбработки[ВидПериода]) Тогда
			ПараметрыФайла[ВидПериода] = ДанныеДляОбработки[ВидПериода];
		КонецЕсли; 
	КонецЦикла; 
	
	Документ = ПолучитьДокумент(ПараметрыФайла);
	
	ТаблицаАктивов = Документ.ОбъектыИнвестирования.Выгрузить();
	
	ОписаниеТиповСумма = Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип;
	ТаблицаСделок = Документ.Сделки.Выгрузить();
	ТаблицаСделок.Колонки.Добавить("ВалютаРасчетов", 		Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаСделок.Колонки.Добавить("НКДВВалютеРасчетов", 	ОписаниеТиповСумма);
	ТаблицаСделок.Колонки.Добавить("СуммаВВалютеРасчетов", 	ОписаниеТиповСумма);
	ТаблицаСделок.Колонки.Добавить("НомерСделки", 			Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки("20")));
	ТаблицаСделок.Колонки.Добавить("ЧастьСделкиРЕПО", 		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1, 0, ДопустимыйЗнак.Неотрицательный)));
	
	Ошибки = Новый Соответствие;
	
	КэшОбъектов = Новый Соответствие;
	
	Для Индекс = 0 По ДанныеДляОбработки.Активы.ВГраница() Цикл
		
		СтрокаАктивы = ДанныеДляОбработки.Активы[Индекс];
		
		НоваяСтрока = ТаблицаАктивов.Добавить();
		НоваяСтрока.НомерСтроки = Индекс;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАктивы);
		
		ЦеннаяБумага = НайтиЦеннуюБумагу(НоваяСтрока.ИдентификаторЦеннойБумаги, КэшОбъектов);
		
		Если ЗначениеЗаполнено(ЦеннаяБумага) Тогда
			
			НоваяСтрока.ЦеннаяБумага = ЦеннаяБумага;
			НоваяСтрока.Рынок = РаботаСЦеннымиБумагамиКлиентСервер.РынокПоЦеннойБумаге(ЦеннаяБумага);
			
		Иначе
			
			РынокСтрока = "";
			СтрокаАктивы.Свойство("Рынок", РынокСтрока);
			Если ЗначениеЗаполнено(РынокСтрока) Тогда
				НоваяСтрока.Рынок = Перечисления.РынкиЦенныхБумаг[РынокСтрока];
			КонецЕсли; 
			
			ДобавитьОшибку(Ошибки, НоваяСтрока.Рынок, НоваяСтрока.ИдентификаторЦеннойБумаги, НоваяСтрока.Эмитент);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаАктивов", ТаблицаАктивов);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаАктивов.НомерСтроки КАК НомерСтроки,
		|	ТаблицаАктивов.Рынок КАК Рынок,
		|	ТаблицаАктивов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаАктивов.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ТаблицаАктивов.ИдентификаторЦеннойБумаги КАК ИдентификаторЦеннойБумаги,
		|	ТаблицаАктивов.Эмитент КАК Эмитент,
		|	ТаблицаАктивов.НачальныйОстаток КАК НачальныйОстаток,
		|	ТаблицаАктивов.Приход КАК Приход,
		|	ТаблицаАктивов.Расход КАК Расход,
		|	ТаблицаАктивов.КонечныйОстаток КАК КонечныйОстаток
		|ПОМЕСТИТЬ _ТаблицаАктивов
		|ИЗ
		|	&ТаблицаАктивов КАК ТаблицаАктивов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаАктивов.Рынок КАК Рынок,
		|	_ТаблицаАктивов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|		КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|		КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
		|		КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.ЮрФизЛицо
		|		КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
		|		КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
		|	КОНЕЦ КАК ЮрФизЛицо,
		|	_ТаблицаАктивов.ИдентификаторЦеннойБумаги КАК ИдентификаторЦеннойБумаги,
		|	_ТаблицаАктивов.Эмитент КАК Эмитент,
		|	_ТаблицаАктивов.НачальныйОстаток КАК НачальныйОстаток,
		|	_ТаблицаАктивов.Приход КАК Приход,
		|	_ТаблицаАктивов.Расход КАК Расход,
		|	_ТаблицаАктивов.КонечныйОстаток КАК КонечныйОстаток,
		|	_ТаблицаАктивов.НомерСтроки КАК Порядок
		|ПОМЕСТИТЬ _ДанныеДляГруппировки
		|ИЗ
		|	_ТаблицаАктивов КАК _ТаблицаАктивов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних КАК РеквизитыПИФСрезПоследних
		|		ПО (_ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РЫнкиЦенныхБумаг.Паи))
		|			И (ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеДляГруппировки.Рынок КАК Рынок,
		|	_ДанныеДляГруппировки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ДанныеДляГруппировки.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_ДанныеДляГруппировки.ИдентификаторЦеннойБумаги КАК ИдентификаторЦеннойБумаги,
		|	_ДанныеДляГруппировки.Эмитент КАК Эмитент,
		|	СУММА(_ДанныеДляГруппировки.НачальныйОстаток) КАК НачальныйОстаток,
		|	СУММА(_ДанныеДляГруппировки.Приход) КАК Приход,
		|	СУММА(_ДанныеДляГруппировки.Расход) КАК Расход,
		|	СУММА(_ДанныеДляГруппировки.КонечныйОстаток) КАК КонечныйОстаток,
		|	МИНИМУМ(_ДанныеДляГруппировки.Порядок) КАК Порядок
		|ИЗ
		|	_ДанныеДляГруппировки КАК _ДанныеДляГруппировки
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДанныеДляГруппировки.ЮрФизЛицо,
		|	_ДанныеДляГруппировки.Эмитент,
		|	_ДанныеДляГруппировки.ИдентификаторЦеннойБумаги,
		|	_ДанныеДляГруппировки.ЦеннаяБумага,
		|	_ДанныеДляГруппировки.Рынок
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок";
	
	ТаблицаАктивов = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаСделкиСВалютой Из ДанныеДляОбработки.СделкиСВалютой Цикл
	
		Дата = СтрРазделить(СтрокаСделкиСВалютой.ДатаСделки, ".");
		Дата[2] = "20" + Дата[2];
		ПолнаяДата = СтрСоединить(Дата, ".");
		ДатаСделки = Дата(ПолнаяДата + " " + СтрокаСделкиСВалютой.ВремяСделки);
		
		Если ДатаСделки < Документ.НачалоПериода Или ДатаСделки > КонецДня(Документ.ОкончаниеПериода) Тогда
			Продолжить;
		КонецЕсли; 
		
		НоваяСтрока = Документ.СделкиСВалютой.Добавить();
		НоваяСтрока.ДатаСделки = ДатаСделки;
		
		СтрокаСделкиСВалютой.Куплено = СтрокаВЧисло(СтрокаСделкиСВалютой.Куплено); 
		СтрокаСделкиСВалютой.Продано = СтрокаВЧисло(СтрокаСделкиСВалютой.Продано); 
		
		НоваяСтрока.Сумма = СтрокаСделкиСВалютой.Куплено + СтрокаСделкиСВалютой.Продано;
		
		СтрокаСделкиСВалютой.Курс = СтрокаВЧисло(СтрокаСделкиСВалютой.Курс); 
		СтрокаСделкиСВалютой.КурсПродажи = СтрокаВЧисло(СтрокаСделкиСВалютой.КурсПродажи); 
		
		НоваяСтрока.Курс = СтрокаСделкиСВалютой.Курс + СтрокаСделкиСВалютой.КурсПродажи;
		
		СтрокаСделкиСВалютой.Сумма = СтрокаВЧисло(СтрокаСделкиСВалютой.Сумма); 
		СтрокаСделкиСВалютой.СуммаПродажи = СтрокаВЧисло(СтрокаСделкиСВалютой.СуммаПродажи); 
		
		НоваяСтрока.СуммаКонтрвалюты = СтрокаСделкиСВалютой.Сумма + СтрокаСделкиСВалютой.СуммаПродажи;
		
		Если Число(СтрокаСделкиСВалютой.Куплено) > 0 Тогда
			// это покупка
			НоваяСтрока.ВидСделки = Перечисления.ВидыСделок.Покупка;
		Иначе
			// это продажа
			НоваяСтрока.ВидСделки = Перечисления.ВидыСделок.Продажа;
		КонецЕсли; 
		
		Валюта = КэшОбъектов.Получить(СтрокаСделкиСВалютой.Валюта);
		Если Валюта = Неопределено Тогда
			НоваяСтрока.Валюта = ПолучитьВалютуПоНаименованию(СтрокаСделкиСВалютой.Валюта);
			КэшОбъектов.Вставить(СтрокаСделкиСВалютой.Валюта, НоваяСтрока.Валюта);
		Иначе
			НоваяСтрока.Валюта = Валюта;
		КонецЕсли; 
		
		Контрвалюта = КэшОбъектов.Получить(СтрокаСделкиСВалютой.Контрвалюта);
		Если Контрвалюта = Неопределено Тогда
			НоваяСтрока.Контрвалюта = ПолучитьВалютуПоНаименованию(СтрокаСделкиСВалютой.Контрвалюта);
			КэшОбъектов.Вставить(СтрокаСделкиСВалютой.Контрвалюта, НоваяСтрока.Контрвалюта);
		Иначе
			НоваяСтрока.Контрвалюта = Контрвалюта;
		КонецЕсли; 
		
	КонецЦикла;
	
	Для Индекс = 0 По ДанныеДляОбработки.Сделки.ВГраница() Цикл
		
		СтрокаСделки = ДанныеДляОбработки.Сделки[Индекс];
		
		Дата = СтрРазделить(СтрокаСделки.ДатаСделки, ".");
		Дата[2] = "20" + Дата[2];
		ПолнаяДата = СтрСоединить(Дата, ".");
		ДатаСделки = Дата(ПолнаяДата + " " + ?(ЗначениеЗаполнено(СтрокаСделки.ВремяСделки), СтрокаСделки.ВремяСделки, "00:00:00"));
		
		Если ДатаСделки < Документ.НачалоПериода Или ДатаСделки > КонецДня(Документ.ОкончаниеПериода) Тогда
			Продолжить;
		КонецЕсли; 
		
		НоваяСтрока = ТаблицаСделок.Добавить();
		НоваяСтрока.НомерСтроки = Индекс;
		НоваяСтрока.ДатаСделки = ДатаСделки;
		
		ЦеннаяБумага = НайтиЦеннуюБумагу(СтрокаСделки.ИдентификаторЦеннойБумаги, КэшОбъектов);
		
		Если ЦеннаяБумага = Неопределено Тогда
			
			СтрокаАктивы = ТаблицаАктивов.Найти(СтрокаСделки.ИдентификаторЦеннойБумаги, "ИдентификаторЦеннойБумаги");
			
			Если СтрокаАктивы = Неопределено Тогда
			
				РынокСтрока = "";
				СтрокаСделки.Свойство("Рынок", РынокСтрока);
				Если ЗначениеЗаполнено(РынокСтрока) Тогда
					НоваяСтрока.Рынок = Перечисления.РынкиЦенныхБумаг[РынокСтрока];
				КонецЕсли; 
				
			Иначе
				НоваяСтрока.Рынок = СтрокаАктивы.Рынок;
			КонецЕсли; 
			
			ДобавитьОшибку(Ошибки, НоваяСтрока.Рынок, СтрокаСделки.ИдентификаторЦеннойБумаги, СтрокаСделки.Эмитент);
			
		Иначе
			
			СтрокаАктивы = ТаблицаАктивов.Найти(ЦеннаяБумага, "ЦеннаяБумага");
			
		КонецЕсли;
		
		Если СтрокаАктивы = Неопределено Тогда
			//НоваяСтрока.Рынок = РаботаСЦеннымиБумагамиКлиентСервер.РынокПоЦеннойБумаге(ЦеннаяБумага);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСделки, "ИдентификаторЦеннойБумаги, Рынок, Эмитент");
		Иначе
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАктивы);
		КонецЕсли;
		
		СтрокаСделки.Куплено = СтрокаВЧисло(СтрокаСделки.Куплено); 
		СтрокаСделки.Продано = СтрокаВЧисло(СтрокаСделки.Продано); 
		
		СтрокаСделки.Сумма = СтрокаВЧисло(СтрокаСделки.Сумма); 
		СтрокаСделки.СуммаПродажи = СтрокаВЧисло(СтрокаСделки.СуммаПродажи); 
		
		НоваяСтрока.Количество = СтрокаСделки.Куплено + СтрокаСделки.Продано;
		
		Если Число(СтрокаСделки.Куплено) > 0 Тогда
			// это покупка
			НоваяСтрока.ВидСделки = Перечисления.ВидыСделок.Покупка;
			Если СтрокаАктивы <> Неопределено Тогда
				СтрокаАктивы.Приход = СтрокаАктивы.Приход + СтрокаСделки.Куплено;
			КонецЕсли;
		Иначе
			// это продажа
			НоваяСтрока.ВидСделки = Перечисления.ВидыСделок.Продажа;
			Если СтрокаАктивы <> Неопределено Тогда
				СтрокаАктивы.Расход = СтрокаАктивы.Расход + СтрокаСделки.Продано;
			КонецЕсли;
		КонецЕсли; 
		
		Валюта = КэшОбъектов.Получить(СтрокаСделки.ВалютаРасчетов);
		Если Валюта = Неопределено Тогда
			НоваяСтрока.ВалютаРасчетов = ПолучитьВалютуПоНаименованию(СтрокаСделки.ВалютаРасчетов);
			КэшОбъектов.Вставить(СтрокаСделки.ВалютаРасчетов, НоваяСтрока.ВалютаРасчетов);
		Иначе
			НоваяСтрока.ВалютаРасчетов = Валюта;
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(НоваяСтрока.ВалютаРасчетов) Тогда
		
			//НоваяСтрока.НКДВВалютеРасчетов = СтрокаВЧисло(СтрокаСделки.НКД);
			НоваяСтрока.СуммаВВалютеРасчетов = СтрокаСделки.Сумма + СтрокаСделки.СуммаПродажи;
		
		КонецЕсли;
		
		СтрокаСделки.Свойство("ЧастьСделкиРЕПО", НоваяСтрока.ЧастьСделкиРЕПО);
		СтрокаСделки.Свойство("НомерСделки", НоваяСтрока.НомерСделки);
		
		//Если СтрокаСделки.Свойство("СтавкаРЕПО") Тогда
		//	НоваяСтрока.СтавкаРЕПО = СтрокаСделки.СтавкаРЕПО;
		//	НоваяСтрока.СрокРЕПО = Справочники.Календари.КоличествоРабочихДней(Константы.ОсновнойКалендарьКотировок.Получить(), НоваяСтрока.ДатаСделки, Дата(СтрокаСделки.ДатаИсполненияРЕПО + " 00:00:00")) - 1;
		//КонецЕсли;
				
	КонецЦикла;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаСделок.НомерСтроки КАК Порядок,
		|	ТаблицаСделок.НомерСделки КАК НомерСделки,
		|	ТаблицаСделок.ДатаСделки КАК ДатаСделки,
		|	ТаблицаСделок.ВидСделки КАК ВидСделки,
		|	ТаблицаСделок.Рынок КАК Рынок,
		|	ТаблицаСделок.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСделок.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ТаблицаСделок.ИдентификаторЦеннойБумаги КАК ИдентификаторЦеннойБумаги,
		|	ТаблицаСделок.Эмитент КАК Эмитент,
		|	ТаблицаСделок.Количество КАК Количество,
		|	ТаблицаСделок.ВалютаРасчетов КАК ВалютаРасчетов,
		|	ТаблицаСделок.НКДВВалютеРасчетов КАК НКДВВалютеРасчетов,
		|	ТаблицаСделок.СуммаВВалютеРасчетов КАК СуммаВВалютеРасчетов,
		|	ТаблицаСделок.СтавкаРЕПО КАК СтавкаРЕПО,
		|	ТаблицаСделок.СрокРЕПО КАК СрокРЕПО,
		|	ТаблицаСделок.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
		|	НАЧАЛОПЕРИОДА(ТаблицаСделок.ДатаСделки, ДЕНЬ) КАК Период,
		|	ТаблицаСделок.СуммаВВалютеРасчетов - ТаблицаСделок.НКДВВалютеРасчетов КАК СуммаБезНКДВвалютеРасчетов,
		|	(ТаблицаСделок.СуммаВВалютеРасчетов - ТаблицаСделок.НКДВВалютеРасчетов) / ТаблицаСделок.Количество КАК ЦенаВВалютеРасчетов
		|ПОМЕСТИТЬ _ТаблицаСделок
		|ИЗ
		|	&ТаблицаСделок КАК ТаблицаСделок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаСделок.ДатаСделки КАК ДатаСделки,
		|	_ТаблицаСделок.ВидСделки КАК ВидСделки,
		|	_ТаблицаСделок.Рынок КАК Рынок,
		|	_ТаблицаСделок.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА _ТаблицаСделок.ЮрФизЛицо = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА ВЫБОР
		|					КОГДА _ТаблицаСделок.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|						ТОГДА ВЫРАЗИТЬ(_ТаблицаСделок.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|					КОГДА _ТаблицаСделок.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|						ТОГДА ВЫРАЗИТЬ(_ТаблицаСделок.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|					КОГДА _ТаблицаСделок.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|						ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
		|					КОГДА _ТаблицаСделок.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
		|						ТОГДА ВЫРАЗИТЬ(_ТаблицаСделок.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.ЮрФизЛицо
		|					КОГДА _ТаблицаСделок.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|						ТОГДА ВЫРАЗИТЬ(_ТаблицаСделок.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
		|					КОГДА _ТаблицаСделок.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
		|						ТОГДА ВЫРАЗИТЬ(_ТаблицаСделок.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
		|				КОНЕЦ
		|		ИНАЧЕ _ТаблицаСделок.ЮрФизЛицо
		|	КОНЕЦ КАК ЮрФизЛицо,
		|	_ТаблицаСделок.ИдентификаторЦеннойБумаги КАК ИдентификаторЦеннойБумаги,
		|	_ТаблицаСделок.Эмитент КАК Эмитент,
		|	_ТаблицаСделок.Количество КАК Количество,
		|	_ТаблицаСделок.СтавкаРЕПО КАК СтавкаРЕПО,
		|	_ТаблицаСделок.СрокРЕПО КАК СрокРЕПО,
		|	_ТаблицаСделок.ЦенаВВалютеРасчетов * КурсыВалютРасчетов.Курс / КурсыВалютРасчетов.Кратность / КурсыВалютыУчета.Курс * КурсыВалютыУчета.Кратность КАК Цена,
		|	_ТаблицаСделок.СуммаБезНКДВвалютеРасчетов * КурсыВалютРасчетов.Курс / КурсыВалютРасчетов.Кратность / КурсыВалютыУчета.Курс * КурсыВалютыУчета.Кратность КАК СуммаБезНКД,
		|	_ТаблицаСделок.НКДВВалютеРасчетов * КурсыВалютРасчетов.Курс / КурсыВалютРасчетов.Кратность / КурсыВалютыУчета.Курс * КурсыВалютыУчета.Кратность КАК НКД,
		|	_ТаблицаСделок.Порядок КАК Порядок,
		|	_ВтораяЧастьРЕПО.ДатаСделки КАК ДатаВторойЧастиРЕПО
		|ИЗ
		|	_ТаблицаСделок КАК _ТаблицаСделок
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютРасчетов
		|		ПО _ТаблицаСделок.Период = КурсыВалютРасчетов.Период
		|			И _ТаблицаСделок.ВалютаРасчетов = КурсыВалютРасчетов.Валюта
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютыУчета
		|		ПО _ТаблицаСделок.Период = КурсыВалютыУчета.Период
		|			И (КурсыВалютыУчета.Валюта = &ВалютаУчета)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних КАК РеквизитыПИФСрезПоследних
		|		ПО (_ТаблицаСделок.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))
		|			И (ВЫРАЗИТЬ(_ТаблицаСделок.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаСделок КАК _ВтораяЧастьРЕПО
		|		ПО _ТаблицаСделок.НомерСделки = _ВтораяЧастьРЕПО.НомерСделки
		|			И (_ТаблицаСделок.ЧастьСделкиРЕПО = 1)
		|			И (_ВтораяЧастьРЕПО.ЧастьСделкиРЕПО = 2)
		|ГДЕ
		|	_ТаблицаСделок.ЧастьСделкиРЕПО <> 2
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок";
	
	Запрос.УстановитьПараметр("ТаблицаСделок", ТаблицаСделок);
	Запрос.УстановитьПараметр("ВалютаУчета", Документ.Организация.ВалютаУчета);
	
	Запрос.Текст = ТекстЗапроса;
	
	Сделки = Запрос.Выполнить().Выгрузить();
	
	ОсновнойКалендарьКотировок = Константы.ОсновнойКалендарьКотировок.Получить();
	ТребуетсяРучнойКонтроль = Ложь;
	Для каждого СтрокаСделки Из Сделки Цикл
	
		Если ЗначениеЗаполнено(СтрокаСделки.ДатаВторойЧастиРЕПО) Тогда
		
			СтрокаСделки.СрокРЕПО = Справочники.Календари.КоличествоРабочихДней(ОсновнойКалендарьКотировок, СтрокаСделки.ДатаСделки, СтрокаСделки.ДатаВторойЧастиРЕПО) - 1;
			ТребуетсяРучнойКонтроль = Истина;
		
		КонецЕсли; 
	
	КонецЦикла; 
	
	Если ТребуетсяРучнойКонтроль Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Требуется ручной контроль сделок РЕПО");
	КонецЕсли; 
	
	Документ.ОбъектыИнвестирования.Загрузить(ТаблицаАктивов);
	Документ.Сделки.Загрузить(Сделки);
	
	СообщенияПользователю = ПолучитьСообщенияПользователю(Истина);
	ДобавитьОшибкиВПараметрыФайла(Ошибки, СообщенияПользователю, ПараметрыФайла);
	ПоместитьДанныеВоВременноеХранилище(СообщенияПользователю, Документ, ПараметрыФайла.АдресДанных);
	
КонецПроцедуры

#КонецОбласти 

#Область УКРИ

&НаКлиенте
Процедура ПрочитатьФайлУКРИ(ПараметрыЧтения, НомерСтроки)

	Excel 					= ПараметрыЧтения.Excel;
	ПоследняяКолонка 		= ПараметрыЧтения.ПоследняяКолонка;
	ПоследняяСтрока 		= ПараметрыЧтения.ПоследняяСтрока;
	СтруктураТаблиц			= ПараметрыЧтения.СтруктураТаблиц;
	
	Если Не ПараметрыЧтения.АктивыОбработаны И СокрЛП(Excel.Cells(НомерСтроки, 2).Value) = "2. Инвестиционный портфель клиента по состоянию на последний день отчетного периода" Тогда
		
		ЗагружаемыеКолонки = Новый Соответствие; 
		ЗагружаемыеКолонки.Вставить("Наименование эмитента", "Эмитент");
		ЗагружаемыеКолонки.Вставить("ISIN", "ЦеннаяБумага");
		ЗагружаемыеКолонки.Вставить("Номер государственной регистрации / ISIN", "ЦеннаяБумага");
		ЗагружаемыеКолонки.Вставить("Кол-во ЦБ, шт.", "КонечныйОстаток");
		ЗагружаемыеКолонки.Вставить("В том числе кол-во ЦБ, полученных по сделкам РЕПО, шт.", "ОстатокПоРЕПО");
		
		ВысотаШапки = 1;
		
		Пока НомерСтроки < ПоследняяСтрока И СокрЛП(Excel.Cells(НомерСтроки, 2).Value) <> "3. Сделки за отчетный период" Цикл
		
			Если СокрЛП(Excel.Cells(НомерСтроки, 2).Value) = "Наименование эмитента" Тогда
			    // нашли шапку, читаем и загружаем
				
				Рынок = СокрЛП(Excel.Cells(НомерСтроки - 1, 2).Value);
				ПараметрыКолонок = ПрочитатьШапку(Excel, НомерСтроки, ВысотаШапки, ПоследняяКолонка, ЗагружаемыеКолонки); 
		
				НомерСтроки = НомерСтроки + ВысотаШапки;
				
				ТаблицаАктивов = ПрочитатьТаблицуУКРИ(Excel, НомерСтроки, ПоследняяСтрока, ПараметрыКолонок);
				
				Для каждого СтрокаТаблицаАктивов Из ТаблицаАктивов Цикл
				
					СтрокаТаблицаАктивов.Вставить("Рынок", Рынок);
					СтруктураТаблиц.Активы.Добавить(СтрокаТаблицаАктивов);
				
				КонецЦикла; 
				
			КонецЕсли; 
			
			НомерСтроки = НомерСтроки + 1;
		
		КонецЦикла; 
		
		ПараметрыЧтения.АктивыОбработаны = Истина;
		
	КонецЕсли; 
	
	Если Не ПараметрыЧтения.СделкиОбработаны И СокрЛП(Excel.Cells(НомерСтроки, 2).Value) = "3. Сделки за отчетный период" Тогда
	
		НомерСтроки = НомерСтроки + 1;
		
		ЗагружаемыеКолонки = Новый Соответствие; 
		ЗагружаемыеКолонки.Вставить("Вид ЦБ, наименование эмитента, № гос.регистрации", "ЦеннаяБумага");
		ЗагружаемыеКолонки.Вставить("Дата и время заключения сделки", "ДатаВремяСделки");
		ЗагружаемыеКолонки.Вставить("Тип сделки", "ТипСделки");
		ЗагружаемыеКолонки.Вставить("Количество (шт.)", "Количество");
		ЗагружаемыеКолонки.Вставить("Валюта расчетов", "ВалютаРасчетов");
		ЗагружаемыеКолонки.Вставить("Цена одной ЦБ, в валюте расчетов", "Цена");
		ЗагружаемыеКолонки.Вставить("НКД одной ЦБ, в валюте расчетов", "НКД");
		ЗагружаемыеКолонки.Вставить("Дата поставки", "ДатаПоставки");
		ЗагружаемыеКолонки.Вставить("Дата поставки" + Символы.ПС + "план", "ДатаПоставки");
		ЗагружаемыеКолонки.Вставить("Ставка РЕПО", "СтавкаРЕПО");
		
		ВысотаШапки = 1;
		
		ПараметрыКолонок = ПрочитатьШапку(Excel, НомерСтроки, ВысотаШапки, ПоследняяКолонка, ЗагружаемыеКолонки); 
		
		НомерСтроки = НомерСтроки + ВысотаШапки;
		
		СтруктураТаблиц.Вставить("Сделки", ПрочитатьТаблицуУКРИ(Excel, НомерСтроки, ПоследняяСтрока, ПараметрыКолонок));
		
		ПараметрыЧтения.СделкиОбработаны = Истина;
	
	КонецЕсли;			

КонецПроцедуры

&НаКлиенте
Функция ПрочитатьТаблицуУКРИ(Excel, НомерСтроки, НомерПоследнейСтроки, ПараметрыКолонок)

	Таблица = Новый Массив;
	
	НазванияРазделов = Новый Массив;
	НазванияРазделов.Добавить("Сделки с валютой");
	НазванияРазделов.Добавить("4. Сведения об участии на общем собрании владельцев ценных бумаг за отчетный период");
	НазванияРазделов.Добавить("Производные финансовые инструменты");
	
	Пока НомерСтроки < НомерПоследнейСтроки Цикл
	
		Ячейка = Excel.Cells(НомерСтроки, 2);
		Текст = СокрЛП(Ячейка.Text);
		
		КонецРаздела = Ложь;
		Для каждого Раздел Из НазванияРазделов Цикл
			КонецРаздела = КонецРаздела Или СтрНачинаетсяС(Текст, Раздел);
			Если КонецРаздела Тогда
				Прервать;
			КонецЕсли; 
		КонецЦикла;
		
		Если КонецРаздела Тогда
			Прервать;
		КонецЕсли;
		
		// это детальные записи
		ДанныеСтроки = Новый Структура;
		
		Для каждого ТекКолонка Из ПараметрыКолонок Цикл
			
			Значение = Excel.Cells(НомерСтроки, ТекКолонка.Значение).Value;
			Значение = ?(ТипЗнч(Значение) = Тип("Строка"), СокрЛП(Значение), Значение);
			
			ДанныеСтроки.Вставить(ТекКолонка.Ключ, Значение);
			
		КонецЦикла; 
		
		Если ДанныеСтроки.Свойство("СтавкаРЕПО") И ЗначениеЗаполнено(ДанныеСтроки.СтавкаРЕПО) И Лев(ДанныеСтроки.ДатаВремяСделки, 10) = ДанныеСтроки.ДатаПоставки Тогда
			// это вторая часть РЕПО в таблице сделок, пропускаем
			НомерСтроки = НомерСтроки + 1;
			Продолжить;
		ИначеЕсли ДанныеСтроки.Свойство("ОстатокПоРЕПО") И ЗначениеЗаполнено(ДанныеСтроки.ОстатокПоРЕПО) Тогда
			ДанныеСтроки.КонечныйОстаток = ДанныеСтроки.КонечныйОстаток - ДанныеСтроки.ОстатокПоРЕПО;
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(ДанныеСтроки.ЦеннаяБумага) Тогда
			Таблица.Добавить(ДанныеСтроки);
		Иначе
			// конец таблицы
			Прервать;
		КонецЕсли; 
		
		НомерСтроки = НомерСтроки + 1;
			
	КонецЦикла; 
	
	Возврат Таблица;

КонецФункции

&НаСервереБезКонтекста
Процедура ОбработатьДанныеБрокераУКРИ(ДанныеДляОбработки, ПараметрыФайла)
	
	Документ = ПолучитьДокумент(ПараметрыФайла);
	
	ОписаниеТиповСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100));
	ОписаниеТиповСумма = Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип;
	
	Ошибки = Новый Соответствие;
	
	КэшОбъектов = Новый Соответствие;
	
	ТаблицаАктивов = Документ.ОбъектыИнвестирования.Выгрузить();
	ТаблицаАктивов.Колонки.Добавить("РегНомер", ОписаниеТиповСтрока);
	
	ТаблицаСделок = Документ.Сделки.Выгрузить();
	ТаблицаСделок.Колонки.Добавить("ВалютаРасчетов", 		Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаСделок.Колонки.Добавить("НКДВВалютеРасчетов", 	ОписаниеТиповСумма);
	ТаблицаСделок.Колонки.Добавить("ЦенаВВалютеРасчетов", 	ОписаниеТиповСумма);
	ТаблицаСделок.Колонки.Добавить("РегНомер", 				ОписаниеТиповСтрока);
	
	#Область Заполнение_исходных_таблиц
	ТаблицаЦБ = Новый ТаблицаЗначений;
	ТаблицаЦБ.Колонки.Добавить("РегНомер", 		ОписаниеТиповСтрока);
	ТаблицаЦБ.Колонки.Добавить("РынокСтрока", 	ОписаниеТиповСтрока);
	ТаблицаЦБ.Колонки.Добавить("Эмитент", 		ОписаниеТиповСтрока);
	ТаблицаЦБ.Колонки.Добавить("ЦБСделки", 		ОписаниеТиповСтрока);
	ТаблицаЦБ.Колонки.Добавить("ЦеннаяБумага", 	Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
	ТаблицаЦБ.Колонки.Добавить("Рынок", 		Новый ОписаниеТипов("ПеречислениеСсылка.РынкиЦенныхБумаг"));
		
	Для каждого СтрокаАктивы Из ДанныеДляОбработки.Активы Цикл
		
		НоваяСтрока = ТаблицаАктивов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАктивы);
		НоваяСтрока.РегНомер = СтрокаАктивы.ЦеннаяБумага;
		
		СтрокаЦБ = ТаблицаЦБ.Найти(СтрокаАктивы.ЦеннаяБумага, "РегНомер");
		Если СтрокаЦБ = Неопределено Тогда
			НоваяСтрока = ТаблицаЦБ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАктивы);
			НоваяСтрока.РегНомер = СтрокаАктивы.ЦеннаяБумага;
			НоваяСтрока.РынокСтрока = СтрокаАктивы.Рынок;
		КонецЕсли; 
	КонецЦикла; 
	
	Для каждого СтрокаСделки Из ДанныеДляОбработки.Сделки Цикл
		
		НоваяСтрока = ТаблицаСделок.Добавить();
		НоваяСтрока.РегНомер = СтрокаСделки.ЦеннаяБумага;
		НоваяСтрока.ДатаСделки = Дата(СтрокаСделки.ДатаВремяСделки);
		НоваяСтрока.Количество = СтрокаСделки.Количество;
		
		Если СтрНайти(СтрокаСделки.ТипСделки, "РЕПО") > 0 Тогда
			ВидСделки = ?(СтрНачинаетсяС(СтрокаСделки.ТипСделки, "Прямое"), "Продажа", "Покупка");
		Иначе
			ВидСделки = СтрокаСделки.ТипСделки;
		КонецЕсли; 
		НоваяСтрока.ВидСделки = Перечисления.ВидыСделок[ВидСделки];
		
		Валюта = КэшОбъектов.Получить(СтрокаСделки.ВалютаРасчетов);
		Если Валюта = Неопределено Тогда
			НоваяСтрока.ВалютаРасчетов = ПолучитьВалютуПоНаименованию(СтрокаСделки.ВалютаРасчетов);
			КэшОбъектов.Вставить(СтрокаСделки.ВалютаРасчетов, НоваяСтрока.ВалютаРасчетов);
		Иначе
			НоваяСтрока.ВалютаРасчетов = Валюта;
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(НоваяСтрока.ВалютаРасчетов) Тогда
		
			НоваяСтрока.НКДВВалютеРасчетов = СтрокаСделки.НКД;
			НоваяСтрока.ЦенаВВалютеРасчетов = СтрокаСделки.Цена;
		
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаСделки.СтавкаРЕПО) Тогда
			НоваяСтрока.СтавкаРЕПО = СтрокаСделки.СтавкаРЕПО;
			НоваяСтрока.СрокРЕПО = Справочники.Календари.КоличествоРабочихДней(Константы.ОсновнойКалендарьКотировок.Получить(), НоваяСтрока.ДатаСделки, Дата(СтрокаСделки.ДатаПоставки + " 00:00:00")) - 1;
		КонецЕсли;
		
		СтрокаЦБ = ТаблицаЦБ.Найти(СтрокаСделки.ЦеннаяБумага, "ЦБСделки");
		Если СтрокаЦБ = Неопределено Тогда
			
			ПозицияНомера = СтрНайти(СтрокаСделки.ЦеннаяБумага, "№", НаправлениеПоиска.СКонца);
			РегНомер = Сред(СтрокаСделки.ЦеннаяБумага, ПозицияНомера + 1);
			
			СтрокаЦБ = ТаблицаЦБ.Найти(РегНомер, "РегНомер");
			
			Если СтрокаЦБ = Неопределено Тогда
			
				КонецРынка = СтрНайти(СтрокаСделки.ЦеннаяБумага, " ");
				// предположим, что рынок состоит из одного слова. Если будут другие - будем переделывать
				Рынок = Лев(СтрокаСделки.ЦеннаяБумага, КонецРынка - 1);
				Эмитент = СокрЛП(СтрЗаменить(СтрЗаменить(СтрокаСделки.ЦеннаяБумага, Рынок, ""), "№" + РегНомер, ""));
				
				НоваяСтрока = ТаблицаЦБ.Добавить();
				НоваяСтрока.РегНомер = РегНомер;				
				НоваяСтрока.РынокСтрока = Рынок;
				НоваяСтрока.Эмитент = Эмитент;
				НоваяСтрока.ЦБСделки = СтрокаСделки.ЦеннаяБумага;
				
			Иначе
				СтрокаЦБ.ЦБСделки = СтрокаСделки.ЦеннаяБумага;
			КонецЕсли; 
			
		КонецЕсли; 
	КонецЦикла;
	
	Для каждого СтрокаТаблицаЦБ Из ТаблицаЦБ Цикл
	
		ЦеннаяБумага = НайтиЦеннуюБумагу(СтрокаТаблицаЦБ.РегНомер, КэшОбъектов);
		
		Если ЗначениеЗаполнено(ЦеннаяБумага) Тогда
			
			СтрокаТаблицаЦБ.ЦеннаяБумага = ЦеннаяБумага;
			СтрокаТаблицаЦБ.Рынок = РаботаСЦеннымиБумагамиКлиентСервер.РынокПоЦеннойБумаге(ЦеннаяБумага);
			
		Иначе
			
			Если ЗначениеЗаполнено(СтрокаТаблицаЦБ.РынокСтрока) Тогда
				СтрокаТаблицаЦБ.Рынок = Перечисления.РынкиЦенныхБумаг[СтрЗаменить(СтрокаТаблицаЦБ.РынокСтрока, " иностранных эмитентов", "")];
			КонецЕсли; 
			
			ДобавитьОшибку(Ошибки, НоваяСтрока.Рынок, НоваяСтрока.ИдентификаторЦеннойБумаги, НоваяСтрока.Эмитент);
			
		КонецЕсли;
	
	КонецЦикла;		
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаЦБ", ТаблицаЦБ);
	Запрос.УстановитьПараметр("ТаблицаАктивов", ТаблицаАктивов);
	Запрос.УстановитьПараметр("ТаблицаСделок", ТаблицаСделок);
	Запрос.УстановитьПараметр("ВалютаУчета", Документ.Организация.ВалютаУчета);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.РегНомер КАК РегНомер,
		|	ТаблицаЦБ.РынокСтрока КАК РынокСтрока,
		|	ТаблицаЦБ.Эмитент КАК Эмитент,
		|	ТаблицаЦБ.ЦБСделки КАК ЦБСделки,
		|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЦБ.Рынок КАК Рынок
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	&ТаблицаЦБ КАК ТаблицаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаАктивов.Рынок КАК Рынок,
		|	_ТаблицаАктивов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|		КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|		КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
		|		КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.ЮрФизЛицо
		|		КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
		|		КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
		|			ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
		|	КОНЕЦ КАК ЮрФизЛицо,
		|	_ТаблицаАктивов.ЦБСделки КАК ЦБСделки,
		|	_ТаблицаАктивов.Эмитент КАК Эмитент,
		|	_ТаблицаАктивов.РынокСтрока КАК РынокСтрока,
		|	_ТаблицаАктивов.РегНомер КАК РегНомер
		|ПОМЕСТИТЬ _ДанныеЦБ
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаАктивов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних КАК РеквизитыПИФСрезПоследних
		|		ПО (_ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РЫнкиЦенныхБумаг.Паи))
		|			И (ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаСделок.РегНомер КАК РегНомер,
		|	ТаблицаСделок.ДатаСделки КАК ДатаСделки,
		|	ТаблицаСделок.ВидСделки КАК ВидСделки,
		|	ТаблицаСделок.Количество КАК Количество,
		|	ТаблицаСделок.ВалютаРасчетов КАК ВалютаРасчетов,
		|	ТаблицаСделок.НКДВВалютеРасчетов КАК НКДВВалютеРасчетов,
		|	ТаблицаСделок.ЦенаВВалютеРасчетов КАК ЦенаВВалютеРасчетов,
		|	ТаблицаСделок.СтавкаРЕПО КАК СтавкаРЕПО,
		|	ТаблицаСделок.СрокРЕПО КАК СрокРЕПО,
		|	НАЧАЛОПЕРИОДА(ТаблицаСделок.ДатаСделки, ДЕНЬ) КАК Период,
		|	ТаблицаСделок.ЦенаВВалютеРасчетов * ТаблицаСделок.Количество КАК СуммаБезНКДВвалютеРасчетов
		|ПОМЕСТИТЬ _ТаблицаСделок
		|ИЗ
		|	&ТаблицаСделок КАК ТаблицаСделок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаАктивов.РегНомер КАК РегНомер,
		|	ТаблицаАктивов.КонечныйОстаток КАК КонечныйОстаток
		|ПОМЕСТИТЬ _ТаблицаАктивов
		|ИЗ
		|	&ТаблицаАктивов КАК ТаблицаАктивов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаСделок.ДатаСделки КАК ДатаСделки,
		|	_ТаблицаСделок.ВидСделки КАК ВидСделки,
		|	_ДанныеЦБ.Рынок КАК Рынок,
		|	_ДанныеЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ДанныеЦБ.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_ДанныеЦБ.РегНомер КАК ИдентификаторЦеннойБумаги,
		|	_ДанныеЦБ.Эмитент КАК Эмитент,
		|	_ТаблицаСделок.Количество КАК Количество,
		|	_ТаблицаСделок.СтавкаРЕПО КАК СтавкаРЕПО,
		|	_ТаблицаСделок.СрокРЕПО КАК СрокРЕПО,
		|	_ТаблицаСделок.ЦенаВВалютеРасчетов * КурсыВалютРасчетов.Курс / КурсыВалютРасчетов.Кратность / КурсыВалютыУчета.Курс * КурсыВалютыУчета.Кратность КАК Цена,
		|	_ТаблицаСделок.СуммаБезНКДВвалютеРасчетов * КурсыВалютРасчетов.Курс / КурсыВалютРасчетов.Кратность / КурсыВалютыУчета.Курс * КурсыВалютыУчета.Кратность КАК СуммаБезНКД,
		|	_ТаблицаСделок.НКДВВалютеРасчетов * КурсыВалютРасчетов.Курс / КурсыВалютРасчетов.Кратность / КурсыВалютыУчета.Курс * КурсыВалютыУчета.Кратность КАК НКД
		|ИЗ
		|	_ТаблицаСделок КАК _ТаблицаСделок
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеЦБ КАК _ДанныеЦБ
		|		ПО _ТаблицаСделок.РегНомер = _ДанныеЦБ.ЦБСделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютРасчетов
		|		ПО _ТаблицаСделок.Период = КурсыВалютРасчетов.Период
		|			И _ТаблицаСделок.ВалютаРасчетов = КурсыВалютРасчетов.Валюта
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютыУчета
		|		ПО _ТаблицаСделок.Период = КурсыВалютыУчета.Период
		|			И (КурсыВалютыУчета.Валюта = &ВалютаУчета)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаСделки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеЦБ.Рынок КАК Рынок,
		|	_ДанныеЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ДанныеЦБ.РегНомер КАК ИдентификаторЦеннойБумаги,
		|	_ДанныеЦБ.Эмитент КАК Эмитент,
		|	_ДанныеЦБ.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ЕСТЬNULL(_ТаблицаАктивов.КонечныйОстаток, 0) + ЕСТЬNULL(ВложенныйЗапрос.Расход, 0) - ЕСТЬNULL(ВложенныйЗапрос.Приход, 0) КАК НачальныйОстаток,
		|	ЕСТЬNULL(ВложенныйЗапрос.Приход, 0) КАК Приход,
		|	ЕСТЬNULL(ВложенныйЗапрос.Расход, 0) КАК Расход,
		|	ЕСТЬNULL(_ТаблицаАктивов.КонечныйОстаток, 0) КАК КонечныйОстаток
		|ИЗ
		|	_ДанныеЦБ КАК _ДанныеЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаАктивов КАК _ТаблицаАктивов
		|		ПО (_ТаблицаАктивов.РегНомер = _ДанныеЦБ.РегНомер)
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_ТаблицаСделок.РегНомер КАК РегНомер,
		|			СУММА(ВЫБОР
		|					КОГДА _ТаблицаСделок.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|						ТОГДА _ТаблицаСделок.Количество
		|					ИНАЧЕ 0
		|				КОНЕЦ) КАК Приход,
		|			СУММА(ВЫБОР
		|					КОГДА _ТаблицаСделок.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|						ТОГДА _ТаблицаСделок.Количество
		|					ИНАЧЕ 0
		|				КОНЕЦ) КАК Расход
		|		ИЗ
		|			_ТаблицаСделок КАК _ТаблицаСделок
		|		ГДЕ
		|			_ТаблицаСделок.СтавкаРЕПО = 0
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_ТаблицаСделок.РегНомер) КАК ВложенныйЗапрос
		|		ПО _ДанныеЦБ.ЦБСделки = ВложенныйЗапрос.РегНомер
		|ГДЕ
		|	(ВложенныйЗапрос.Приход ЕСТЬ НЕ NULL 
		|			ИЛИ ЕСТЬNULL(_ТаблицаАктивов.КонечныйОстаток, 0) <> 0)";
	Пакет = Запрос.ВыполнитьПакет();
	#КонецОбласти 
	
	Документ.ОбъектыИнвестирования.Загрузить(Пакет[5].Выгрузить());
	Документ.Сделки.Загрузить(Пакет[4].Выгрузить());
	
	СообщенияПользователю = ПолучитьСообщенияПользователю(Истина);
	ДобавитьОшибкиВПараметрыФайла(Ошибки, СообщенияПользователю, ПараметрыФайла);
	ПоместитьДанныеВоВременноеХранилище(СообщенияПользователю, Документ, ПараметрыФайла.АдресДанных);

КонецПроцедуры

#КонецОбласти 

#Область УК_РЕГИОН

&НаСервереБезКонтекста
Процедура ПрочитатьФайлУКРегион(ДвоичныеДанные, ПараметрыФайла) 

	Документ = ПолучитьДокумент(ПараметрыФайла);
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьПоток(ДвоичныеДанные.ОткрытьПотокДляЧтения());
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ИмяТекущегоУзла = ЧтениеXML.Имя;
			Если ИмяТекущегоУзла = "ОтчетУправляющего" Тогда
				//Объект.НачалоПериода = ЧтениеXML.ЗначениеАтрибута("НачалоПериода");
				//Объект.ОкончаниеПериода = ЧтениеXML.ЗначениеАтрибута("ОкончаниеПериода");
			ИначеЕсли ИмяТекущегоУзла = "СтрокаОбъектыИнвестирования" Тогда
				
				НоваяСтрока = Документ.ОбъектыИнвестирования.Добавить();
				ЧтениеXML.Прочитать();
				Пока ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
					НоваяСтрока[ЧтениеXML.Имя] = ПрочитатьXML(ЧтениеXML);
				КонецЦикла; 
				
			ИначеЕсли ИмяТекущегоУзла = "СтрокаСделки" Тогда
				
				НоваяСтрока = Документ.Сделки.Добавить();
				ЧтениеXML.Прочитать();
				Пока ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
					НоваяСтрока[ЧтениеXML.Имя] = ПрочитатьXML(ЧтениеXML);
				КонецЦикла;
				
			КонецЕсли; 
		КонецЕсли;
	КонецЦикла;
	
	ЧтениеXML.Закрыть();
	
	СообщенияПользователю = ПолучитьСообщенияПользователю(Истина);
	ПоместитьДанныеВоВременноеХранилище(СообщенияПользователю, Документ, ПараметрыФайла.АдресДанных);
	
КонецПроцедуры

#КонецОбласти 

#Область БК_РЕГИОН

&НаКлиенте
Процедура ПрочитатьФайлБКРегион(ПараметрыФайла)

	Файл = Новый Файл(ПараметрыФайла.ПутьКФайлу);
	
	ПараметрыЧтенияФайла = Новый Структура;
	ПараметрыЧтенияФайла.Вставить("ДвоичныеДанные", Новый ДвоичныеДанные(ПараметрыФайла.ПутьКФайлу));
	ПараметрыЧтенияФайла.Вставить("Расширение", Файл.Расширение);
	
	АдресФайла = ПоместитьВоВременноеХранилище(ПараметрыЧтенияФайла);
	ПрочитатьФайлБК(АдресФайла, ПараметрыФайла);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПрочитатьФайлБК(АдресФайла, ПараметрыФайла)

	ЗагружаемыеРазделы = СтрЗаменить("ОстаткиАкций, ОстаткиОблигаций, ОстаткиПаев, СделкиСАкциями, СделкиСОблигациями, СделкиСПаями", " ", "");
	ЗагружаемыеРазделы = СтрРазделить(ЗагружаемыеРазделы, ",", Ложь);
	
	ОбработкаСсылка = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта("_СверкаСБрокеромБКРегион");

	Если ОбработкаСсылка <> Неопределено Тогда
		
		Обработка = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьОбъектВнешнейОбработки(ОбработкаСсылка);
		Результат = Обработка.ПолучитьСтруктуруРезультата(Неопределено, ПараметрыФайла.НачалоПериода, АдресФайла, Ложь, ЗагружаемыеРазделы, Ложь);
		УдалитьИзВременногоХранилища(АдресФайла);
		
		СообщенияПользователю = ПолучитьСообщенияПользователю(Истина);
		Для каждого Сообщение Из СообщенияПользователю Цикл
			// удалим сообщения о ненайденных ценных бумагах
			Если Не СтрНачинаетсяС(Сообщение.Текст, "Не удалось определить") Тогда
				Сообщение.Сообщить();
			КонецЕсли; 
		КонецЦикла; 
		
		ОбработатьДанныеБК(Результат, ПараметрыФайла);
		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдена обработка ""Сверка с брокером БК РЕГИОН""");
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбработатьДанныеБК(Результат, ПараметрыФайла)
	
	Документ = ПолучитьДокумент(ПараметрыФайла);
	
	ТаблицаАктивов = Документ.ОбъектыИнвестирования.Выгрузить(); 
	ТаблицаСделок = Документ.Сделки.Выгрузить(); 
	ТаблицаСделок.Колонки.Добавить("ДатаИсполненияРЕПО", Новый ОписаниеТипов("Дата"));
	
	Ошибки = Новый Соответствие;
	ЗагруженныеЦенныеБумаги = Новый Соответствие;
	ДепозитарныеРасписки = Новый Соответствие;
	
	Для каждого СтрокаАкций Из Результат.ОстаткиАкций Цикл
	
		НоваяСтрока = ТаблицаАктивов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАкций);
		
		НоваяСтрока.ИдентификаторЦеннойБумаги = СтрокаАкций.РегНомер;
		НоваяСтрока.Эмитент                   = СтрокаАкций.Эмитент;
		
		Если ЗначениеЗаполнено(СтрокаАкций.Акция) Тогда
			
			НоваяСтрока.ЦеннаяБумага = СтрокаАкций.Акция;
			НоваяСтрока.Рынок        = Перечисления.РынкиЦенныхБумаг.Акции;
			
		Иначе
			
			// БК РЕГИОН в секциях "Акции" предоставляет данные в т.ч. по депозитарным распискам
			ДепозитарнаяРасписка = ДепозитарнаяРаспискаПоРегНомеру(СтрокаАкций.РегНомер, ДепозитарныеРасписки);
			
			Если ЗначениеЗаполнено(ДепозитарнаяРасписка) Тогда
				
				НоваяСтрока.ЦеннаяБумага = ДепозитарнаяРасписка;
				НоваяСтрока.Рынок        = Перечисления.РынкиЦенныхБумаг.ДепозитарныеРасписки;
				
			Иначе
				
				НоваяСтрока.Рынок = Перечисления.РынкиЦенныхБумаг.Акции;
				
				ЦеннаяБумага = ЗагрузитьЦеннуюБумагу(ЗагруженныеЦенныеБумаги, СтрокаАкций.РегНомер, СтрокаАкций.Рынок, Документ.Организация);
				Если ЦеннаяБумага = Неопределено Тогда
					
					ДобавитьОшибку(Ошибки, НоваяСтрока.Рынок, НоваяСтрока.ИдентификаторЦеннойБумаги, НоваяСтрока.Эмитент);
					НоваяСтрока.ЮрФизЛицо = НайтиЮрЛицоПоКраткомуНаименованию(СтрокаАкций.Эмитент, Документ.Дата);
				
				КонецЕсли;
				
			КонецЕсли;

		КонецЕсли; 
		
	КонецЦикла; 
	
	Для каждого СтрокаОблигаций Из Результат.ОстаткиОблигаций Цикл
	
		НоваяСтрока = ТаблицаАктивов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОблигаций);
		
		НоваяСтрока.ИдентификаторЦеннойБумаги = СтрокаОблигаций.РегНомер;
		НоваяСтрока.Эмитент = СтрокаОблигаций.Эмитент;
		НоваяСтрока.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации;
		
		Если ЗначениеЗаполнено(СтрокаОблигаций.Облигация) Тогда
			НоваяСтрока.ЦеннаяБумага = СтрокаОблигаций.Облигация;
		Иначе
			
			ЦеннаяБумага = ЗагрузитьЦеннуюБумагу(ЗагруженныеЦенныеБумаги, СтрокаОблигаций.РегНомер, СтрокаОблигаций.Рынок, Документ.Организация);
			Если ЦеннаяБумага = Неопределено Тогда
			
				ДобавитьОшибку(Ошибки, НоваяСтрока.Рынок, НоваяСтрока.ИдентификаторЦеннойБумаги, НоваяСтрока.Эмитент);
				НоваяСтрока.ЮрФизЛицо = НайтиЮрЛицоПоКраткомуНаименованию(СтрокаОблигаций.Эмитент, Документ.Дата);
			
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Для каждого СтрокаПаев Из Результат.ОстаткиПаев Цикл
	
		НоваяСтрока = ТаблицаАктивов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПаев);
		
		НоваяСтрока.ИдентификаторЦеннойБумаги = СтрокаПаев.РегНомер;
		НоваяСтрока.Эмитент = СтрокаПаев.Эмитент;
		НоваяСтрока.Рынок = Перечисления.РынкиЦенныхБумаг.Паи;
		
		Если ЗначениеЗаполнено(СтрокаПаев.Пай) Тогда
			НоваяСтрока.ЦеннаяБумага = СтрокаПаев.Пай;
		Иначе
			
			ЦеннаяБумага = ЗагрузитьЦеннуюБумагу(ЗагруженныеЦенныеБумаги, СтрокаПаев.РегНомер, СтрокаПаев.Рынок, Документ.Организация);
			Если ЦеннаяБумага = Неопределено Тогда
			
				ДобавитьОшибку(Ошибки, НоваяСтрока.Рынок, НоваяСтрока.ИдентификаторЦеннойБумаги, НоваяСтрока.Эмитент);
				НоваяСтрока.ЮрФизЛицо = НайтиЮрЛицоПоКраткомуНаименованию(СтрокаПаев.Эмитент, Документ.Дата);
			
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаАктивов", ТаблицаАктивов);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаАктивов.Рынок КАК Рынок,
		|	ТаблицаАктивов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаАктивов.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ТаблицаАктивов.ИдентификаторЦеннойБумаги КАК ИдентификаторЦеннойБумаги,
		|	ТаблицаАктивов.Эмитент КАК Эмитент,
		|	ТаблицаАктивов.НачальныйОстаток КАК НачальныйОстаток,
		|	ТаблицаАктивов.Приход КАК Приход,
		|	ТаблицаАктивов.Расход КАК Расход,
		|	ТаблицаАктивов.КонечныйОстаток КАК КонечныйОстаток
		|ПОМЕСТИТЬ _ТаблицаАктивов
		|ИЗ
		|	&ТаблицаАктивов КАК ТаблицаАктивов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаАктивов.Рынок КАК Рынок,
		|	_ТаблицаАктивов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА _ТаблицаАктивов.ЮрФизЛицо = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА ВЫБОР
		|					КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|						ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|					КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|						ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|					КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|						ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
		|					КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
		|						ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.ЮрФизЛицо
		|					КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|						ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
		|					КОГДА _ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
		|						ТОГДА ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
		|				КОНЕЦ
		|		ИНАЧЕ _ТаблицаАктивов.ЮрФизЛицо
		|	КОНЕЦ КАК ЮрФизЛицо,
		|	_ТаблицаАктивов.ИдентификаторЦеннойБумаги КАК ИдентификаторЦеннойБумаги,
		|	_ТаблицаАктивов.Эмитент КАК Эмитент,
		|	_ТаблицаАктивов.НачальныйОстаток КАК НачальныйОстаток,
		|	_ТаблицаАктивов.Приход КАК Приход,
		|	_ТаблицаАктивов.Расход КАК Расход,
		|	_ТаблицаАктивов.КонечныйОстаток КАК КонечныйОстаток
		|ИЗ
		|	_ТаблицаАктивов КАК _ТаблицаАктивов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних КАК РеквизитыПИФСрезПоследних
		|		ПО (_ТаблицаАктивов.Рынок = ЗНАЧЕНИЕ(Перечисление.РЫнкиЦенныхБумаг.Паи))
		|			И (ВЫРАЗИТЬ(_ТаблицаАктивов.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)";
	
	ТаблицаАктивов = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаАкций Из Результат.СделкиСАкциями Цикл
	
		Если СтрНачинаетсяС(ВРег(СтрокаАкций.ВидОперации), ВРег("Покупка"))
			Или СтрНачинаетсяС(ВРег(СтрокаАкций.ВидОперации), ВРег("Продажа")) Тогда
		
			НоваяСтрока = ТаблицаСделок.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАкций);
			
			НоваяСтрока.ДатаСделки = СтрокаАкций.ДатаВремяСделки;
			НоваяСтрока.ВидСделки = Перечисления.ВидыСделок[СтрЗаменить(СтрокаАкций.ВидОперации, " (РЕПО)", "")];
									
			Если ЗначениеЗаполнено(СтрокаАкций.Акция) Тогда
				СтрокаАктивы = ТаблицаАктивов.Найти(ВРег(СтрокаАкций.Акция), ВРег("ЦеннаяБумага"));
			Иначе
				СтрокаАктивы = ТаблицаАктивов.Найти(ВРег(СтрокаАкций.РегНомер), ВРег("ИдентификаторЦеннойБумаги"));
			КонецЕсли; 
			
			Если СтрокаАктивы = Неопределено Тогда
				// такое бывает, если сделка с отложенным исполнением и остаток = 0
				НоваяСтрока.ИдентификаторЦеннойБумаги = СтрокаАкций.РегНомер;
