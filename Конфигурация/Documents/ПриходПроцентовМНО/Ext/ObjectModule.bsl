	СчетУчетаРезервов = ПланыСчетов.Единый.РасчетныеСчета05;
	
	АналитикаСписанияРезервов = БухгалтерскийУчетЕПС.ПолучитьГФУСписанияРезервов(ЭтотОбъект, УчетныйАктив); 
	
	СчетДоходов = ПланыСчетов.Единый.НайтиПоКоду(АналитикаСписанияРезервов.НомерСчетаБухгалтерскогоУчета);
	
	БухгалтерскийУчетЕПС.СформироватьДвиженияПоЗакрытиюРезервовОКУ(ЭтотОбъект, СчетУчетаРезервов, ПланыВидовХарактеристик.ВидыСубконто.УсловияЗаймовКредитовИДепозитов, СчетДоходов, АналитикаСписанияРезервов, Движения.ЕдиныйБухгалтерскийУчет);
	
	Если Закрывать7ойРазделПриПоступленииДенежныхСредств И ЭтотОбъект.Дата > БухгалтерскийУчетЕПС.ДатаВключенияЗакрытия7гоРазделаПоРезервам() Тогда
		
		БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ДоходыРасходыПоРезервам01, ЭтотОбъект.МНО, Валюта, "Закрытие резервов", ЭтотОбъект.Дата,,,,, Истина);
		БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ДоходыРасходыПоРезервам02, ЭтотОбъект.МНО, Валюта, "Закрытие резервов", ЭтотОбъект.Дата,,,,, Истина);
	
	КонецЕсли;
	
	
	МассивУчетныхАктивов = Новый Массив;
	МассивУчетныхАктивов.Добавить(Справочники.УчетныеАктивыЕПС.ПроцентыНаМНО);
	
	МассивМНО = Новый Массив;
	МассивМНО.Добавить(ЭтотОбъект.МНО);
	
	БухгалтерскийУчетЕПС.ЗакрытьПарныеСчетаДоходовРасходов(ЭтотОбъект, МассивУчетныхАктивов, Ложь, Истина, МассивМНО, Отказ);
	
	
КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт

	Движения[УчетныйРегистр].Записывать = Истина;
	
	УчетныйАктив = Документы.ПереоценкаМНО.ОпределитьУчетныйАктив(ЭтотОбъект.МНО, Перечисления.ВидыУчета[УчетныйРегистр]); 	
	
	СчетУчетаДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.РасчетныйСчет.Валюта,
		Справочники.БрокерскиеКомпании.ПустаяСсылка());
		
	СчетУчетаАктивов = БухгалтерскийУчет.ОпределитьСчетУчетаАктивов(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		УчетныйАктив,
		УчетныйРегистр);
		
	// Расчет суммы начисл. процентов
	ВидыСубконто = Новый Массив;
    ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.МНО);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.СуммаОстатокДт
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоМинимальномуНеснижаемомуОстатку),
		|			&ВидыСубконто,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|				И Субконто1 = &МНО) КАК БухгалтерскийУчетОстатки";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", УчетныйРегистр);
		
	Запрос.УстановитьПараметр("Период",                       ЭтотОбъект.Дата);	
	Запрос.УстановитьПараметр("ВидыСубконто",                 ВидыСубконто);
	Запрос.УстановитьПараметр("МНО",                          ЭтотОбъект.МНО);
	Запрос.УстановитьПараметр("Организация",                  ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));

	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		НачисленоПроцентов = ВыборкаДетальныеЗаписи.СуммаОстатокДт;
	Иначе
		НачисленоПроцентов = 0;
	КонецЕсли;
		
	Если ЭтотОбъект.Сумма <> 0 Тогда
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ЭтотОбъект.Сумма, "Приход процентов по МНО");
		
		// дебет
		Проводка.СчетДт = СчетУчетаДС;
		
		Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета)  <> Неопределено Тогда 
			Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
		КонецЕсли;
		
		Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда 
			Если ТипЗнч(ЭтотОбъект.МНО) = Тип("ДокументСсылка.СделкаСМО") Тогда 
				ВидДвиженияДенежныхСредств   = Справочники.ВидыДвиженияДенежныхСредств.ПриходПроцентовСМО;
			Иначе
				ВидДвиженияДенежныхСредств   = Справочники.ВидыДвиженияДенежныхСредств.ПриходПроцентовМНО;
			КонецЕсли;		
			Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = ВидДвиженияДенежныхСредств;
		КонецЕсли;	
		
		// кредит
		Проводка.СчетКт = СчетУчетаАктивов;
		Проводка.СубконтоКт.МНО = ЭтотОбъект.МНО;
	КонецЕсли;
	
	Если ЭтотОбъект.Сумма - НачисленоПроцентов <> 0 Тогда
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ЭтотОбъект.Сумма - НачисленоПроцентов, "Начисление процентов по МНО");
		
		// Дебет
		Проводка.СчетДт = СчетУчетаАктивов;
		Проводка.СубконтоДт.МНО = ЭтотОбъект.МНО;
		
		// Кредит
		Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
		
		Проводка.СубконтоКт.ПрочиеДоходыИРасходы = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
			ЭтотОбъект.Дата, 
			ЭтотОбъект.Организация, 
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктив,
			УчетныйРегистр,
			"АналитикаДоходов");
			
		Проводка.СубконтоКт.ЦенныеБумаги = ЭтотОбъект.МНО;
		
	КонецЕсли;
	
КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.МНО") Тогда // ввод на основании
		ЭтотОбъект.МНО = ДанныеЗаполнения.Ссылка;
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, "Организация, СчетДоверительногоУправления, РасчетныйСчет");
		
		Если НачалоДня(ЭтотОбъект.Дата) <> ДанныеЗаполнения.ДатаВозврата Тогда
			ЭтотОбъект.Дата	    = РаботаСДокументами.ПолучитьВремяДокумента(ДанныеЗаполнения.ДатаВозврата, ЭтотОбъект.Ссылка);
		КонецЕсли;
		
		ЭтотОбъект.СуммаМНО = ДанныеЗаполнения.Сумма;		
		ЭтотОбъект.Сумма 	= РаботаСМНО.РасчетСуммыМНО(ДанныеЗаполнения, ДанныеЗаполнения.ДатаВозврата);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "МНО, Сумма, СуммаМНО, СтрокаБанковскойВыписки");
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ТипЗнч(МНО) = Тип("ДокументСсылка.СделкаСМО") Тогда 
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("СуммаМНО"));
	КонецЕсли;	
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		// !!! случилась такая ситуация, что потребовалось организовать отложенный приход % по МНО,
		// а поскольку соответствую задачу реализовывать по правильному долго, пока просто разрешим
		// проведение прихода % в других датах
		
		//// дата прихода % должна соответствовать дате возврата МНО
		//Если НачалоДня(ЭтотОбъект.Дата) <> НачалоДня(ЭтотОбъект.МНО.ДатаВозврата) Тогда
		//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата прихода % не соответствует дате возврата " + Формат(ЭтотОбъект.МНО.ДатаВозврата, "ДФ=dd.MM.yyyy") + ", указанной в документе " + ЭтотОбъект.МНО, ЭтотОбъект, "Дата",, Отказ);
		//	Возврат;
		//КонецЕсли;
		
		Если ТипЗнч(ЭтотОбъект.МНО) = Тип("ДокументСсылка.МНО") Тогда 
		
			РаботаСБанковскимиВыпискамиКлиентСервер.ПроверитьСоответствиеСтрокиБанковскойВыпискиИПлатежногоДокумента(ЭтотОбъект,
				ЭтотОбъект.СтрокаБанковскойВыписки, Перечисления.ВидыДвижений.Приход, Отказ);
			
			// сумма остатка д/с в МНО должна соответствовать ранее проведенному обороту по соотв. регистру
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ДенежныеСредстваМНООбороты.СуммаРасход КАК СуммаРасход
				|ИЗ
				|	РегистрНакопления.ДенежныеСредстваМНО.Обороты(
				|			&НачалоПериода,
				|			&КонецПериода,
				|			,
				|			МНО = &МНО
				|				И Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ДенежныеСредстваМНООбороты";
			
			Запрос.УстановитьПараметр("НачалоПериода",                НачалоДня(ЭтотОбъект.МНО.ДатаВозврата));
			Запрос.УстановитьПараметр("КонецПериода",                 КонецДня(ЭтотОбъект.МНО.ДатаВозврата));
			Запрос.УстановитьПараметр("МНО",                          ЭтотОбъект.МНО);
			Запрос.УстановитьПараметр("Организация",                  ЭтотОбъект.Организация);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("РасчетныйСчет",                ЭтотОбъект.РасчетныйСчет);
				
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Не Выборка.Следующий() Или Выборка.СуммаРасход <> ЭтотОбъект.СуммаМНО Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Оборот д/с в МНО " + ?(Выборка.СуммаРасход = Неопределено, 0, Выборка.СуммаРасход)
					+ " по документу " + ЭтотОбъект.МНО + " не соответствует сумме МНО " + ЭтотОбъект.СуммаМНО + ", указанной в приходе %", ЭтотОбъект, "СуммаМНО",, Отказ);
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);

	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти
