
Процедура УстановитьБлокировки()
	
	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;	
	
	Если ТипЗнч(ЭтотОбъект.МНО) = Тип("ДокументСсылка.МНО") Тогда 
		
		БлокировкаДанных = Новый БлокировкаДанных;
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиДенежныхСредств");
		ЭлементБлокировки.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
		ЭлементБлокировки.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		ЭлементБлокировки.УстановитьЗначение("РасчетныйСчет",                ЭтотОбъект.РасчетныйСчет);
		
		БлокировкаДанных.Заблокировать();
		
	КонецЕсли;
	
КонецПроцедуры // УстановитьБлокировки

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.ОстаткиДенежныхСредств.Записывать		= Истина;
	Движения.РезервыПредстоящихРасходов.Записывать	= Истина;
	
	// остатки д/с
	Движение = Движения.ОстаткиДенежныхСредств.ДобавитьПриход();
	
	Движение.Период 	                  = ЭтотОбъект.Дата;
	Движение.Организация 				  = ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
	Движение.Брокер                       = Справочники.БрокерскиеКомпании.ПустаяСсылка(); 
	Движение.МестоХранения                = Справочники.МестаХранения.ВнебиржевойРынок;
	Движение.РасчетныйСчет 				  = ЭтотОбъект.РасчетныйСчет;
	Движение.Валюта   					  = ЭтотОбъект.РасчетныйСчет.Валюта;
	Движение.Сумма                        = ЭтотОбъект.Сумма;
	
	Если ТипЗнч(ЭтотОбъект.МНО) = Тип("ДокументСсылка.СделкаСМО") Тогда 
		ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПриходПроцентовСМО;
	Иначе
		ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПриходПроцентовМНО;
	КонецЕсли;
	
	Движение.ВидДвиженияДенежныхСредств = ВидДвиженияДенежныхСредств;
	
	// резервы
	Если ЭтотОбъект.Дата < РаботаСДокументами.ДатаНачалаСписанияРезервовПредстоящихРасходовРегламентнымДокументом() Тогда
		
		НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
		НастройкиУчетаПроцентыНаМНО = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.УчетныеАктивыЕПС.ПроцентыНаМНО, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
		
		Если НастройкиУчета.ПериодичностьНачисленияРезервов <> Перечисления.ПериодичностьПереоценкиАктивов.НеПереоценивать
			И НастройкиУчета.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов = Перечисления.СтандартыФинансовойОтчетности.МСФО9
			И НастройкиУчетаПроцентыНаМНО.СписыватьРезервОКУНаДатуПрекращенияПризнания Тогда
			
			ДатаВзятияРезервов = БухгалтерскийУчетЕПС.ПервыйДеньПериода(ЭтотОбъект.Дата, НастройкиУчета.ПериодичностьНачисленияРезервов); 
			
			Если ДатаВзятияРезервов = '20250101' И ЭтотОбъект.Дата >= '20250102' Тогда // в 1.1.25 00:00:01 "внезапно" возникли резервы и их нужно брать!
			
				ДатаВзятияРезервов = '20250101000002'; // берем на 1.1.25 00:00:02 чтобы резервы взялись
			
			КонецЕсли;
			
			// ДатаВзятияРезервов работает "от периодичности", но при ежемесячной периодичности у нас выпадут МНО, открывшиеся в этом месяце
			// поэтому, проверяем дату открытия МНО и если она больше, то берем день открытия (конец дня т.к. вечером начисляются резервы)
			ДатаВзятияРезервов = Макс(ДатаВзятияРезервов, КонецДня(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.МНО, "Дата")));
						
			РасчетнаяСуммаПроцентов = Окр(РаботаСМНО.РасчетСуммыМНО(ЭтотОбъект.МНО, НачалоДня(ЭтотОбъект.Дата)), 2);
			КоэффициентВосстановленияРезерва = ЭтотОбъект.Сумма / РасчетнаяСуммаПроцентов;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	РезервыПредстоящихРасходовОстатки.Организация КАК Организация,
				|	РезервыПредстоящихРасходовОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	РезервыПредстоящихРасходовОстатки.Резерв КАК Резерв,
				|	РезервыПредстоящихРасходовОстатки.Валюта КАК Валюта,
				|	РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК СубъектАналитики,
				|	РезервыПредстоящихРасходовОстатки.СуммаОстаток КАК Сумма
				|ИЗ
				|	РегистрНакопления.РезервыПредстоящихРасходов.Остатки(
				|			&Период,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И СубъектАналитики = &СубъектАналитики) КАК РезервыПредстоящихРасходовОстатки";
			
			Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
			Запрос.УстановитьПараметр("Период", ДатаВзятияРезервов);
			Запрос.УстановитьПараметр("СубъектАналитики", ЭтотОбъект.МНО);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
			
			РезультатЗапроса = Запрос.Выполнить();
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				
				Движение = Движения.РезервыПредстоящихРасходов.ДобавитьРасход();
				Движение.Период = ЭтотОбъект.Дата;
				ЗаполнитьЗначенияСвойств(Движение, ВыборкаДетальныеЗаписи);
				Если КоэффициентВосстановленияРезерва <> 1 Тогда
				    Движение.Сумма = Движение.Сумма * КоэффициентВосстановленияРезерва;
				КонецЕсли;
			КонецЕсли;
			
			Движения.Записать();
		
		КонецЕсли;
		
	КонецЕсли;	
	
	// проверим, что отсутствуют прочие приходы денежных средств
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредств.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|ГДЕ
		|	ОстаткиДенежныхСредств.Организация = &Организация
		|	И ОстаткиДенежныхСредств.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОстаткиДенежныхСредств.РасчетныйСчет = &РасчетныйСчет
		|	И ВЫРАЗИТЬ(ОстаткиДенежныхСредств.Регистратор КАК Документ.ПриходПроцентовМНО).МНО = &МНО
		|	И ОстаткиДенежныхСредств.Регистратор <> &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",                       ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("МНО",                          ЭтотОбъект.МНО);
	Запрос.УстановитьПараметр("Организация",                  ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("РасчетныйСчет",                ЭтотОбъект.РасчетныйСчет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На основании " + ЭтотОбъект.МНО + " уже был проведен " + Выборка.Регистратор, ЭтотОбъект.Ссылка,,, Отказ);
	КонецЕсли;
	
	Если Не Отказ Тогда
		// реестр платежей
		РегистрыСведений.РеестрПлатежей.ЗарегистрироватьПлатеж(ЭтотОбъект,
			РегистрыСведений.РеестрПлатежей.СкомпоноватьСведенияОСтрокеБанковскойВыписки(
				ЭтотОбъект.СтрокаБанковскойВыписки, Перечисления.ВидыДвижений.Приход, ЭтотОбъект.Сумма, ВидДвиженияДенежныхСредств));
	КонецЕсли;
			
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Функция ВернутьНачисленныеПроцентыМНО(Период, СчетУчетаПроцентовПоМНО, Организация, СчетДоверительногоУправления, ВидыСубконто, МассивСубконто)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.СуммаОстатокДт
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = &СчетУчетаПроцентовПоМНО,
		|			&ВидыСубконто,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|				И Субконто1 = &Субконто1) КАК БухгалтерскийУчетОстатки";

	Запрос.УстановитьПараметр("Период",                       Период);
	Запрос.УстановитьПараметр("СчетУчетаПроцентовПоМНО",	  СчетУчетаПроцентовПоМНО);
	Запрос.УстановитьПараметр("ВидыСубконто",				  ВидыСубконто);
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));

	СтрокаУсловияСубконто = "";
	Для Инд = 1 По МассивСубконто.Количество() Цикл
		
		СтрокаСубконто = СтрШаблон("Субконто%1", Инд);
		
		Запрос.УстановитьПараметр(СтрокаСубконто, МассивСубконто[Инд - 1]);
		
		СтрокаУсловияСубконто = СтрокаУсловияСубконто + СтрШаблон(" И %1 = &%1", СтрокаСубконто);
		
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Субконто1 = &Субконто1", СтрокаУсловияСубконто);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		НачисленоПроцентов = ВыборкаДетальныеЗаписи.СуммаОстатокДт;
	Иначе
		НачисленоПроцентов = 0;
	КонецЕсли;
	
	Возврат НачисленоПроцентов;

КонецФункции 

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт

	Закрывать7ойРазделПриПоступленииДенежныхСредств = БухгалтерскийУчет.Закрывать7ойРазделПриПоступленииДенежныхСредств(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	УчетныйАктив = Документы.ПереоценкаМНО.ОпределитьУчетныйАктив(ЭтотОбъект.МНО, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет); 
	
	АналитикаМНО = Справочники.ДополнительныеАналитикиЛицевыхСчетов.МНО;	
	
	Валюта = ЭтотОбъект.МНО.РасчетныйСчет.Валюта;

	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;	
	
	Контрагент = ЭтотОбъект.РасчетныйСчет.Банк.ЮрФизЛицо;
	
	ВидыСубконто = Новый Массив;
	МассивСубконто = Новый Массив;
	
	Если НастройкиУчета.СчетУчетаПроцентовПоМНО = ПланыСчетов.Единый.Расчеты Тогда // 474
		
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов);
		
		МассивСубконто.Добавить(Контрагент);
		МассивСубконто.Добавить(ЭтотОбъект.МНО);
		
		СчетУчетаПроцентовПоМНО = ПланыСчетов.Единый.Расчеты23;
		
	ИначеЕсли НастройкиУчета.СчетУчетаПроцентовПоМНО = ПланыСчетов.Единый.РасчетныеСчета Тогда // 205
		
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета);
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.УсловияЗаймовКредитовИДепозитов);
		
		МассивСубконто.Добавить(ЭтотОбъект.МНО.РасчетныйСчет);
		МассивСубконто.Добавить(ЭтотОбъект.МНО);
		
		СчетУчетаПроцентовПоМНО = ПланыСчетов.Единый.РасчетныеСчета07;
	
	Иначе // 206
		
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.УсловияЗаймовКредитовИДепозитов);
		
		МассивСубконто.Добавить(Контрагент);
		МассивСубконто.Добавить(ЭтотОбъект.МНО);
		
		СчетУчетаПроцентовПоМНО = УчетныйАктив.СчетУчетаПереоценкиА;
	
	КонецЕсли;
	
	Если ТипЗнч(ЭтотОбъект.МНО) = Тип("ДокументСсылка.МНО") Тогда 
		НачисленоПроцентов = ВернутьНачисленныеПроцентыМНО(ЭтотОбъект.Дата, СчетУчетаПроцентовПоМНО, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ВидыСубконто, МассивСубконто);
	
		ДоначислитьПроцентов = РаботаСМНО.РасчетСуммыМНО(ЭтотОбъект.МНО, НачалоДня(ЭтотОбъект.Дата)) - НачисленоПроцентов;
	Иначе
		НачисленоПроцентов = 0;  ДоначислитьПроцентов = 0;
	КонецЕсли;	
	
	Если НастройкиУчета.НеИспользоватьСчетПроцентовПоМНОПриОтсутствииПереоценки И НачисленоПроцентов = 0 Тогда
	
		// пришли %
		СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ЭтотОбъект.Сумма, Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Приход процентов по МНО");
		
		Если Справочники.Банки.ЯвляетсяРезидентом(МНО.РасчетныйСчет.Банк,Дата) Тогда
			Проводка.СчетДт = ПланыСчетов.Единый.РасчетныеСчета01;
		Иначе
			Проводка.СчетДт = ПланыСчетов.Единый.РасчетныеСчета02;
		КонецЕсли;
		
		Если ТипЗнч(ЭтотОбъект.МНО) = Тип("ДокументСсылка.СделкаСМО") Тогда 
			ВидДвиженияДенежныхСредств   = Справочники.ВидыДвиженияДенежныхСредств.ПриходПроцентовСМО;
		Иначе
			ВидДвиженияДенежныхСредств   = Справочники.ВидыДвиженияДенежныхСредств.ПриходПроцентовМНО;
		КонецЕсли;
		
		Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
		Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = ВидДвиженияДенежныхСредств;
		
		Проводка.ВалютаДт = Валюта;
		Проводка.ВалютнаяСуммаДт = ЭтотОбъект.Сумма;
		
			
		Проводка.СчетКт = ПланыСчетов.Единый.ПроцентныеДоходы01;
		
		Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = БухгалтерскийУчет.ОпределитьГруппуФинансовогоУчетаДоходовРасходов("3112", Новый Структура("Банк,Период",МНО.РасчетныйСчет.Банк, Дата));
		Проводка.СубконтоКт.ЦенныеБумаги = ЭтотОбъект.РасчетныйСчет;
		Проводка.СубконтоКт.УсловияЗаймовКредитовИДепозитов = ЭтотОбъект.МНО;
		
	Иначе
		
		//доначислим %
