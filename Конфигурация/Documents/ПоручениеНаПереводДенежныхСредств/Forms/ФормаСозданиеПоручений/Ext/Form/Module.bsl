
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтотОбъект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	ЭтотОбъект.Брокер      = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион");
	
КонецПроцедуры //ПриСозданииНаСервере

&НаСервере
Процедура ЗаполнитьТаблицуДанных()
		
	Запрос = Новый Запрос;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаРЕПО.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПО
		|ГДЕ
		|	СделкаРЕПО.Дата >= &НачалоДняВчера
		|	И СделкаРЕПО.ЧастьСделкиРЕПО = 2
		|	И СделкаРЕПО.Организация = &Организация
		|	И СделкаРЕПО.Брокер = &Брокер
		|	И СделкаРЕПО.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И НЕ(СделкаРЕПО.Проведен
		|				ИЛИ СделкаРЕПО.ПометкаУдаления)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИсполнениеОбязательствПоСделке.Ссылка
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|ГДЕ
		|	ИсполнениеОбязательствПоСделке.Дата >= &НачалоДняВчера
		|	И ИсполнениеОбязательствПоСделке.Организация = &Организация
		|	И ИсполнениеОбязательствПоСделке.Брокер = &Брокер
		|	И ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И НЕ(ИсполнениеОбязательствПоСделке.Проведен
		|				ИЛИ ИсполнениеОбязательствПоСделке.ПометкаУдаления)";
#КонецОбласти

	НачалоДняВчера = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса(), -1);
	Запрос.УстановитьПараметр("Брокер"                      , ЭтотОбъект.Брокер);
	Запрос.УстановитьПараметр("НачалоДняВчера"              , НачалоДняВчера);
	Запрос.УстановитьПараметр("Организация"                 , ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Если Не Запрос.Выполнить().Пустой() Тогда
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По счету ДУ " + ЭтотОбъект.СчетДоверительногоУправления.Наименование + " в базе присутствует непроведенный документ [" + ВыборкаДетальныеЗаписи.Ссылка + "]");
		КонецЦикла;
		Возврат;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокументПоручениеНаПеревод.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДокументПоручениеНаПеревод.МестоХранения КАК МестоХранения,
		|	ДокументПоручениеНаПеревод.Валюта КАК Валюта,
		|	СУММА(ДокументПоручениеНаПеревод.Сумма) КАК СуммаПоручений
		|ПОМЕСТИТЬ _ПорученияНаПеревод
		|ИЗ
		|	Документ.ПоручениеНаПереводДенежныхСредств КАК ДокументПоручениеНаПеревод
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыПорученийНаПереводДенежныхСредств.СрезПоследних(&КонецПериода, Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.ОшибкаПриЭкспорте), ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Снято))) КАК СтатусыПорученийНаПереводДенежныхСредствСрезПоследних
		|		ПО (СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.ПоручениеНаПереводДенежныхСредств = ДокументПоручениеНаПеревод.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПереводДенежныхСредств КАК ПереводДенежныхСредств
		|		ПО ПереводДенежныхСредств.Основание = ДокументПоручениеНаПеревод.Ссылка
		|ГДЕ
		|	ДокументПоручениеНаПеревод.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ДокументПоручениеНаПеревод.Организация = &Организация
		|	И ДокументПоручениеНаПеревод.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ДокументПоручениеНаПеревод.Брокер = &Брокер
		|	И ДокументПоручениеНаПеревод.МестоХраненияПолучатель = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И НЕ ДокументПоручениеНаПеревод.ПометкаУдаления
		|	И СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.Статус ЕСТЬ NULL
		|	И (ПереводДенежныхСредств.Ссылка ЕСТЬ NULL Или Не ПереводДенежныхСредств.Проведен)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДокументПоручениеНаПеревод.СчетДоверительногоУправления,
		|	ДокументПоручениеНаПеревод.МестоХранения,
		|	ДокументПоручениеНаПеревод.Валюта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЛОЖЬ КАК ФормироватьПоручение,
		|	ЕСТЬNULL(ОстаткиДенежныхСредствОстатки.МестоХранения, Задолженности.МестоХранения) КАК МестоХранения,
		|	ЕСТЬNULL(ОстаткиДенежныхСредствОстатки.Валюта, Задолженности.Валюта) КАК Валюта,
		|	СУММА(ЕСТЬNULL(ОстаткиДенежныхСредствОстатки.СуммаОстаток, 0)) КАК СуммаОстаток,
		|	СУММА(ВЫБОР
		|			КОГДА ЕСТЬNULL(ОстаткиДенежныхСредствОстатки.СуммаОстаток, 0) = 0
		|				ТОГДА 0
		|			ИНАЧЕ ОстаткиДенежныхСредствОстатки.СуммаОстаток - ЕСТЬNULL(_ПорученияНаПеревод.СуммаПоручений, 0) - ЕСТЬNULL(Задолженности.СуммаЗадолженности, 0)
		|		КОНЕЦ) КАК СуммаНовогоПоручения,
		|	СУММА(ВЫБОР
		|			КОГДА ЕСТЬNULL(ОстаткиДенежныхСредствОстатки.СуммаОстаток, 0) = 0
		|				ТОГДА 0
		|			ИНАЧЕ ОстаткиДенежныхСредствОстатки.СуммаОстаток - ЕСТЬNULL(_ПорученияНаПеревод.СуммаПоручений, 0) - ЕСТЬNULL(Задолженности.СуммаЗадолженности, 0)
		|		КОНЕЦ) КАК ДоступнаяСумма,
		|	СУММА(ЕСТЬNULL(Задолженности.СуммаЗадолженности, 0)) КАК СуммаЗадолженности,
		|	_ПорученияНаПеревод.СуммаПоручений КАК СуммаСозданныхПоручений,
		|	_ПорученияНаПеревод.МестоХранения КАК ПоручениеМестоХранения
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Брокер = &Брокер) КАК ОстаткиДенежныхСредствОстатки
		|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОстатки.Основание.МестоХранения, ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)) КАК МестоХранения,
		|			ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
		|			ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК СуммаЗадолженности
		|		ИЗ
		|			РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|					&Период,
		|					Организация = &Организация
		|						И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|						И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|						И Основание.Брокер = &Брокер) КАК ЗадолженностиПоДенежнымСредствамОстатки) КАК Задолженности
		|		ПО ОстаткиДенежныхСредствОстатки.МестоХранения = Задолженности.МестоХранения
		|			И ОстаткиДенежныхСредствОстатки.Валюта = Задолженности.Валюта
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПорученияНаПеревод КАК _ПорученияНаПеревод
		|		ПО ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления = _ПорученияНаПеревод.СчетДоверительногоУправления
		|			И ОстаткиДенежныхСредствОстатки.МестоХранения = _ПорученияНаПеревод.МестоХранения
		|			И ОстаткиДенежныхСредствОстатки.Валюта = _ПорученияНаПеревод.Валюта
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕСТЬNULL(ОстаткиДенежныхСредствОстатки.МестоХранения, Задолженности.МестоХранения),
		|	ЕСТЬNULL(ОстаткиДенежныхСредствОстатки.Валюта, Задолженности.Валюта),
		|	_ПорученияНаПеревод.МестоХранения,
		|	_ПорученияНаПеревод.СуммаПоручений";
#КонецОбласти

	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Брокер"                      , ЭтотОбъект.Брокер);
	Запрос.УстановитьПараметр("Организация"                 , ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("НачалоПериода"               , НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("КонецПериода"                , КонецДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Период"                      , Новый Граница(КонецДня(ТекущаяДатаСеанса()), ВидГраницы.Включая));

	ТЗ = Запрос.Выполнить().Выгрузить();
	Если ТЗ.Количество() > 0 Тогда
		ЭтотОбъект.ТаблицаДанных.Загрузить(ТЗ);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На брокерских счетах по счету ДУ [" + ЭтотОбъект.СчетДоверительногоУправления + "] нет остатков.");
	КонецЕсли;

КонецПроцедуры //ЗаполнитьТаблицуДанных

&НаСервереБезКонтекста
Функция ПолучитьРасчетныеСчета(СчетДУ, Валюта);
	
	Запрос = Новый Запрос;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет КАК РасчетныйСчет
		|ИЗ
		|	РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|ГДЕ
		|	ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Валюта = &Валюта
		|	И (ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия > &ТекущаяДата
		|			ИЛИ ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))";
#КонецОбласти
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДУ);
	Запрос.УстановитьПараметр("Валюта"                      , Валюта);
	Запрос.УстановитьПараметр("ТекущаяДата"                 , ТекущаяДатаСеанса());
	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("РасчетныйСчет");
	КонецЕсли;
	
КонецФункции //ПолучитьРасчетныеСчета

&НаСервереБезКонтекста
Функция ПолучитьСчетаДоверительногоУправления(Организация, Брокер)
	
	Запрос = Новый Запрос;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ПоручениеНаДвижениеДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаКЗакрытию
		|ИЗ
		|	Документ.ПоручениеНаДвижениеДенежныхСредств КАК ПоручениеНаДвижениеДенежныхСредств
		|ГДЕ
		|	ПоручениеНаДвижениеДенежныхСредств.ВыводВсехАктивов
		|	И ПоручениеНаДвижениеДенежныхСредств.Организация = &Организация
		|	И ПоручениеНаДвижениеДенежныхСредств.Проведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|			&КонецДня,
		|			Организация = &Организация
		|				И Брокер = &Брокер
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_СчетаКЗакрытию.СчетДоверительногоУправления
		|					ИЗ
		|						_СчетаКЗакрытию)) КАК ОстаткиДенежныхСредствОстатки
		|ГДЕ
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток > 0
		|	И ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР)";
#КонецОбласти

	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("КонецДня"   , КонецДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Брокер"     , Брокер);
	
	Если Запрос.Выполнить().Пустой() Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют доступные счета ДУ для выбора.
														  |Перед созданием поручений на вывод денежных средств с брокерских счетов необходимо создать документ ""Поручение на вывод денежных средств"" и установить галочку ""Вывод всех активов"".");
		Возврат Неопределено;
		
	Иначе
		
		Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СчетДоверительногоУправления");
		
	КонецЕсли;
	
КонецФункции //ПолучитьСчетаДоверительногоУправления

&НаСервереБезКонтекста
Процедура СоздатьНаСервере(Брокер, СчетДУ, ТаблицаДанных)
		
	ТекущаяДата             = ТекущаяДатаСеанса();
	РасчетныйСчет           = ПредопределенноеЗначение("Справочник.БанковскиеСчета.ПустаяСсылка");
	Брокер                  = Брокер;
	БрокерПолучатель        = ПредопределенноеЗначение("Справочник.БрокерскиеКомпании.ПустаяСсылка");
	МестоХраненияПолучатель = ПредопределенноеЗначение("Справочник.МестаХранения.ВнебиржевойРынок");
	Ответственный           = РаботаСПользователями.ТекущийПользователь();
	Комментарий             = "Создан аппаратно-техническими средствами " + ТекущаяДата;
	
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		
		Если Не СтрокаДанных.ФормироватьПоручение Тогда
			Продолжить;
		КонецЕсли;
				
		ПоручениеНаПеревод = Документы.ПоручениеНаПереводДенежныхСредств.СоздатьДокумент();
		
		ПоручениеНаПеревод.Дата                         = ТекущаяДата;
		ПоручениеНаПеревод.Организация                  = СчетДУ.Организация;
		ПоручениеНаПеревод.СчетДоверительногоУправления = СчетДУ;
		ПоручениеНаПеревод.РасчетныйСчет                = РасчетныйСчет;
		ПоручениеНаПеревод.Брокер                       = Брокер;
		ПоручениеНаПеревод.МестоХранения                = СтрокаДанных.МестоХранения;
		ПоручениеНаПеревод.МестоХраненияСтрокой         = СтрокаДанных.Раздел;
		ПоручениеНаПеревод.РасчетныйСчетПолучатель      = СтрокаДанных.РасчетныйСчетКуда;
		ПоручениеНаПеревод.БрокерПолучатель             = БрокерПолучатель;
		ПоручениеНаПеревод.МестоХраненияПолучатель      = МестоХраненияПолучатель;
		ПоручениеНаПеревод.СрочныйПереводБЭСП           = Ложь;
		ПоручениеНаПеревод.Сумма                        = СтрокаДанных.СуммаНовогоПоручения;
		ПоручениеНаПеревод.Валюта                       = СтрокаДанных.Валюта;
		ПоручениеНаПеревод.Ответственный                = Ответственный;
		ПоручениеНаПеревод.Комментарий                  = Комментарий;
		
		Попытка
			ПоручениеНаПеревод.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести Поручение на перевод денежных по счету " + СчетДУ + ". Ошибка: " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура Создать(Команда)
	
	БрокерДляПоручений = ЭтаФорма.Брокер;
	КлиентДляПоручений = ЭтаФорма.СчетДоверительногоУправления;
	ДанныеДляПоручений = ЭтаФорма.ТаблицаДанных;
	
	СоздатьНаСервере(БрокерДляПоручений, КлиентДляПоручений, ДанныеДляПоручений);
	ЗаполнитьТаблицуДанных();
	
КонецПроцедуры //Создать

&НаКлиенте
Процедура Обновить()
	
	ЭтаФорма.ТаблицаДанных.Очистить();
	
	Если ЭтаФорма.ПроверитьЗаполнение() Тогда
		ЗаполнитьТаблицуДанных();	
	КонецЕсли;
	
КонецПроцедуры //Обновить

&НаКлиенте
Процедура ПроверитьСуммуПоручения(СтрокаТаблицыДанных)
	
	Если Не СтрокаТаблицыДанных.ФормироватьПоручение Тогда
		СтрокаТаблицыДанных.ФормироватьПоручение = Ложь;
	ИначеЕсли СтрокаТаблицыДанных.СуммаНовогоПоручения > СтрокаТаблицыДанных.ДоступнаяСумма Тогда	
		Если Вопрос("Сумма нового поручения превышает доступную сумму остатка на счетах брокера [" + СтрокаТаблицыДанных.ДоступнаяСумма + "]. Продолжить?", РежимДиалогаВопрос.ДаНет) <>  КодВозвратаДиалога.Да Тогда
			СтрокаТаблицыДанных.СуммаНовогоПоручения = СтрокаТаблицыДанных.ДоступнаяСумма;
			СтрокаТаблицыДанных.ФормироватьПоручение = Ложь;
		КонецЕсли;
	ИначеЕсли СтрокаТаблицыДанных.СуммаНовогоПоручения = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Введите сумму для нового поручения!");
		СтрокаТаблицыДанных.ФормироватьПоручение = Ложь;
	КонецЕсли;
	
КонецПроцедуры //ПроверитьСуммуПоручения

&НаКлиенте
Процедура ПроверитьСооствтствиеРазделаИМестаХранения(СтрокаТаблицыДанных)
	
	Если СтрокаТаблицыДанных.МестоХранения = ПредопределенноеЗначение("Справочник.МестаХранения.ВнебиржевойРынок") Тогда
		Если СтрНайти(СтрокаТаблицыДанных.Раздел, "Внебиржевые") = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Раздел [" + СтрокаТаблицыДанных.Раздел + "] не соответствеут месту хранения [Внебиржевой рынок]!");
			СтрокаТаблицыДанных.Раздел = "";
			СтрокаТаблицыДанных.ФормироватьПоручение = Ложь;
			Возврат;
		КонецЕсли;
	Иначе
		Если СтрНайти(СтрокаТаблицыДанных.Раздел, "Биржевые") = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Раздел [" + СтрокаТаблицыДанных.Раздел + "] не соответствеут месту хранения [ММВБ-РТС]!");
			СтрокаТаблицыДанных.Раздел = "";
			СтрокаТаблицыДанных.ФормироватьПоручение = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры //ПроверитьСооствтствиеРазделаИМестаХранения

&НаКлиенте
Процедура ТаблицаДанныхФормироватьПоручениеПриИзменении(Элемент)

	ТекСтрока = Элементы.ТаблицаДанных.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТекСтрока.Раздел) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите [Раздел] для вывода денежных средств!");
		ТекСтрока.ФормироватьПоручение = Ложь;
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекСтрока.РасчетныйСчетКуда) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите [Расчетный счет куда] для зачисления денежных средств!");
		ТекСтрока.ФормироватьПоручение = Ложь;
		Возврат;
	КонецЕсли;
	
	ПроверитьСуммуПоручения(ТекСтрока);
	ПроверитьСооствтствиеРазделаИМестаХранения(ТекСтрока);
		 
КонецПроцедуры //ТаблицаДанныхФормироватьПоручениеПриИзменении

&НаКлиенте
Процедура ТаблицаДанныхРасчетныйСчетКудаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекСтрока = Элементы.ТаблицаДанных.ТекущиеДанные;

	СтандартнаяОбработка = Ложь;
	РасчетныеСчета = ПолучитьРасчетныеСчета(ЭтотОбъект.СчетДоверительногоУправления, ТекСтрока.Валюта);
	Если РасчетныеСчета <> Неопределено Тогда
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.ЗагрузитьЗначения(РасчетныеСчета);
	КонецЕсли;
	
КонецПроцедуры //ТаблицаДанныхРасчетныйСчетКудаНачалоВыбора

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	Обновить();
	
КонецПроцедуры //СчетДоверительногоУправленияПриИзменении

&НаКлиенте
Процедура СчетДоверительногоУправленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЭтаФорма.ТаблицаДанных.Очистить();
	СчетаДоверительногоУправления = ПолучитьСчетаДоверительногоУправления(ЭтотОбъект.Организация, ЭтотОбъект.Брокер);
	Если СчетаДоверительногоУправления <> Неопределено Тогда
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.ЗагрузитьЗначения(СчетаДоверительногоУправления);
	КонецЕсли;
	
КонецПроцедуры //СчетДоверительногоУправленияНачалоВыбора

&НаКлиенте
Процедура ТаблицаДанныхСуммаНовогоПорученияПриИзменении(Элемент)
	
	ПроверитьСуммуПоручения(Элементы.ТаблицаДанных.ТекущиеДанные);
		
КонецПроцедуры //ТаблицаДанныхСуммаНовогоПорученияПриИзменении

&НаКлиенте
Процедура ТаблицаДанныхРазделПриИзменении(Элемент)
	
	ПроверитьСооствтствиеРазделаИМестаХранения(Элементы.ТаблицаДанных.ТекущиеДанные);
	
КонецПроцедуры //ТаблицаДанныхРазделПриИзменении

&НаКлиенте
Процедура ТаблицаДанныхРасчетныйСчетКудаПриИзменении(Элемент)
	
	ТекСтрока = Элементы.ТаблицаДанных.ТекущиеДанные;
	Если ТекСтрока.ФормироватьПоручение Тогда
		ТекСтрока.ФормироватьПоручение = Ложь;
	КонецЕсли;
	
КонецПроцедуры //ТаблицаДанныхРасчетныйСчетКудаПриИзменении
