#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "Сумма");
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ПроверяемыеРеквизиты.Добавить("МестоХранения");	
	ПроверяемыеРеквизиты.Добавить("МестоХраненияПолучатель");
		
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
		
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли; 
	
	//Параметр "ЭтоАкцептование" в ф-ии ИзмененыРеквизитыШапкиДокумента по сути указывает на то, что время документа может изменяться в рамках дня.
	Если Не ЭтотОбъект.ДополнительныеСвойства.ЭтоНовый Тогда
		
		РеквизитыДляПроверки = Новый Массив;
		РеквизитыДляПроверки.Добавить("Дата");
		РеквизитыДляПроверки.Добавить("СчетДоверительногоУправления");
		РеквизитыДляПроверки.Добавить("Брокер");
		РеквизитыДляПроверки.Добавить("БрокерПолучатель");
		РеквизитыДляПроверки.Добавить("Сумма");	
		РеквизитыДляПроверки.Добавить("Валюта");
		РеквизитыДляПроверки.Добавить("МестоХранения");
		РеквизитыДляПроверки.Добавить("МестоХраненияПолучатель");
		РеквизитыДляПроверки.Добавить("РасчетныйСчет");
		РеквизитыДляПроверки.Добавить("РасчетныйСчетПолучатель");
		РеквизитыДляПроверки.Добавить("МестоХраненияСтрокой");
		РеквизитыДляПроверки.Добавить("МестоХраненияПолучательСтрокой");
		РеквизитыДляПроверки.Добавить("СрочныйПереводБЭСП");
		
		Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения 
			Или РаботаСДокументами.ИзмененыРеквизитыШапкиДокумента(ЭтотОбъект, РеквизитыДляПроверки,, Истина) Тогда
			
			Если ЗначениеЗаполнено(ЭтотОбъект.Брокер) Тогда
				
				ТекстСообщения = "Поручение экспортируется брокеру через систему QUIK." 
								+ ?(РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения, " Для отмены поручения используйте команду [ОТМЕНИТЬ ПОРУЧЕНИЕ].", " Редактирование запрещено!"); 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
				
			Иначе
			
				СтатусПоручения = РаботаСДокументами.ПолучитьТекущийСтатусПорученияНаПереводДенежныхСредств(ЭтотОбъект.Ссылка);
				
				Если Не (СтатусПоручения = Неопределено 
						Или СтатусПоручения = Перечисления.СтатусыПорученийНаПереводДенежныхСредств.ГотовКОтправке
						Или СтатусПоручения = Перечисления.СтатусыПорученийНаПереводДенежныхСредств.Отправлено) Тогда
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Редактирование поручения доступно при статусе [Отправлено]. Текущий статус [" + СтатусПоручения + "]. ",,,, Отказ);
			
				КонецЕсли;
			
			КонецЕсли;
		
		КонецЕсли;
				
	КонецЕсли;
   				
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
			
		// перевод д/с между брокерами
		Если ЗначениеЗаполнено(ЭтотОбъект.Брокер) И ЗначениеЗаполнено(ЭтотОбъект.БрокерПолучатель) И ЭтотОбъект.Брокер <> ЭтотОбъект.БрокерПолучатель Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перевод денежных средств между различными брокерскими компаниями запрещен", ЭтотОбъект, "Брокер",, Отказ);
		КонецЕсли;
		
		// расчетный счет
		ДетализацияПоРасчетномуСчету = (ЭтотОбъект.МестоХранения <> Справочники.МестаХранения.ММВБ_ДепозитыСЦК)
		                                И РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(ЭтотОбъект);

		Если ДетализацияПоРасчетномуСчету Тогда
			Если Не ЗначениеЗаполнено(РасчетныйСчет) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Расчетный счет"" не заполнено", ЭтотОбъект, "РасчетныйСчет",, Отказ);
			Иначе
				Если ЭтотОбъект.РасчетныйСчет.Валюта <> ЭтотОбъект.Валюта Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Валюта расчетного счета отличается от валюты перевода", ЭтотОбъект, "РасчетныйСчет",, Отказ);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтотОбъект.Брокер = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ") И ЭтотОбъект.МестоХранения <> ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Переводы бокера ГПБ должны осуществляться с ММВБ-РТС", ЭтотОбъект, "МестоХранения",, Отказ);	
		ИначеЕсли ЭтотОбъект.БрокерПолучатель = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ") И ЭтотОбъект.МестоХраненияПолучатель <> ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Переводы бокеру ГПБ должны осуществляться на ММВБ-РТС", ЭтотОбъект, "МестоХраненияПолучатель",, Отказ);
		КонецЕсли;
		
		Если РаботаСДокументами.ЗапрещенПрямойПереводНаСчетаБиржи(ЭтотОбъект, Отказ) Тогда
			Возврат;
		КонецЕсли;
			
		// расчетный счет получателя
		ДетализацияПоРасчетномуСчетуПолучатель = (ЭтотОбъект.МестоХраненияПолучатель <> Справочники.МестаХранения.ММВБ_ДепозитыСЦК)
		                                          И РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(ЭтотОбъект, "БрокерПолучатель");
	
		Если ДетализацияПоРасчетномуСчетуПолучатель Тогда
			Если Не ЗначениеЗаполнено(РасчетныйСчетПолучатель) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Расчетный счет получателя"" не заполнено", ЭтотОбъект, "РасчетныйСчетПолучатель",, Отказ);
			Иначе
				Если ЭтотОбъект.РасчетныйСчетПолучатель.Валюта <> ЭтотОбъект.Валюта Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Валюта расчетного счета получателя отличается от валюты перевода", ЭтотОбъект, "РасчетныйСчетПолучатель",, Отказ);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
				
		Если ЭтотОбъект.РасчетныйСчетПолучатель <> Справочники.БанковскиеСчета.ПустаяСсылка() И Не ЗначениеЗаполнено(ЭтотОбъект.БрокерПолучатель) Тогда
			
			Если ЭтотОбъект.РасчетныйСчетПолучатель.ДатаЗакрытия > Дата(1, 1, 1) И ЭтотОбъект.РасчетныйСчетПолучатель.ДатаЗакрытия < ЭтотОбъект.Дата Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Р/с [" + ЭтотОбъект.РасчетныйСчетПолучатель + "] закрыт. Дата закрытия счета [" + ЭтотОбъект.РасчетныйСчетПолучатель.ДатаЗакрытия  + "].", ЭтотОбъект, "РасчетныйСчетПолучатель",, Отказ);	
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЭтотОбъект.РасчетныйСчетПолучатель.Договор) Тогда
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	Договоры.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДляДокументов,
					|	ЕСТЬNULL(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРасторжения
					|ИЗ
					|	Справочник.Договоры КАК Договоры
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Период, ) КАК УсловияДоговоровОбщиеСрезПоследних
					|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = Договоры.Ссылка)
					|ГДЕ
					|	Договоры.Ссылка = &Договор
					|	И Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.БанковскогоОбслуживания)";
				
				Запрос.УстановитьПараметр("Договор", ЭтотОбъект.РасчетныйСчетПолучатель.Договор);
				Запрос.УстановитьПараметр("Период" , ЭтотОбъект.Дата);
				
				Результат = Запрос.Выполнить().Выгрузить();
				
				Если Результат.Количество() = 0 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить условия договора [" + ЭтотОбъект.РасчетныйСчетПолучатель.Договор + "] для р/с [" + ЭтотОбъект.РасчетныйСчетПолучатель + "]. Проверьте вид договора.", ЭтотОбъект, "РасчетныйСчетПолучатель",, Отказ);	
				Иначе
				
					Если Результат[0].ДатаРасторжения > Дата(1, 1, 1) И Результат[0].ДатаРасторжения < ЭтотОбъект.Дата Тогда
					    ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Р/с [" + ЭтотОбъект.РасчетныйСчетПолучатель + "]. В договоре банковского обслуживания дата расторжения договора [" + Результат[0].ДатаРасторжения  + "] меньше даты документа.", ЭтотОбъект, "РасчетныйСчетПолучатель",, Отказ);
					КонецЕсли;
					//для НТП должно быть заполнено значение НаименованиеВладельцаДляДокументов 
					Если ЗначениеЗаполнено(ЭтотОбъект.Брокер) И ПустаяСтрока(Результат[0].НаименованиеВладельцаДляДокументов) Тогда
					    ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Р/с [" + ЭтотОбъект.РасчетныйСчетПолучатель + "]. В договоре банковского обслуживания не заполнено поле ""Наименование владельца для документов"".", ЭтотОбъект, "РасчетныйСчетПолучатель",, Отказ);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
						
		КонецЕсли;
				
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
	Если ЭтотОбъект.ДополнительныеСвойства.ЭтоНовый И ЭтотОбъект.ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		НовыйСтатус = Неопределено;
		
		Если ЗначениеЗаполнено(ЭтотОбъект.Брокер) Тогда
						
			Если РаботаСДокументами.ТребуетсяАкцептованиеДокумента(ЭтотОбъект.Ссылка, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления) Тогда
				
				ПараметрыРегламентногоЗадания = Новый Структура();
				ПараметрыРегламентногоЗадания.Вставить("Организация", ЭтотОбъект.Организация); 
				ПараметрыРегламентногоЗадания.Вставить("Поручение", ЭтотОбъект.Ссылка);
				
				Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ПлановоеВремяЗапускаФормированияОповещения") Тогда
					ПараметрыРегламентногоЗадания.Вставить("ПлановоеВремяЗапускаФормированияОповещения", ЭтотОбъект.ДополнительныеСвойства.ПлановоеВремяЗапускаФормированияОповещения);
				КонецЕсли;
			
				Обработки.СогласованиеПредстоящихРасходов.СоздатьОтложенноеЗаданиеФормированияОповещения("СформироватьОповещенияОПорученияхОжидающихАкцепта", ПараметрыРегламентногоЗадания);	
				
				НовыйСтатус = Перечисления.СтатусыПорученийНаПереводДенежныхСредств.ОжидаетАкцепта;
				
			Иначе
				НовыйСтатус = Перечисления.СтатусыПорученийНаПереводДенежныхСредств.ГотовКОтправке;	
			КонецЕсли;
			
		Иначе
			
			ПараметрыРегламентногоЗадания = Новый Структура();
			ПараметрыРегламентногоЗадания.Вставить("Организация", ЭтотОбъект.Организация); 
			ПараметрыРегламентногоЗадания.Вставить("Поручение", ЭтотОбъект.Ссылка); 
			ПараметрыРегламентногоЗадания.Вставить("Срочно", ЭтотОбъект.ДополнительныеСвойства.Свойство("Срочно"));
			
			Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ПлановоеВремяЗапускаФормированияОповещения") Тогда
				ПараметрыРегламентногоЗадания.Вставить("ПлановоеВремяЗапускаФормированияОповещения", ЭтотОбъект.ДополнительныеСвойства.ПлановоеВремяЗапускаФормированияОповещения);
			КонецЕсли;
			
			Обработки.СогласованиеПредстоящихРасходов.СоздатьОтложенноеЗаданиеФормированияОповещения("СформироватьОповещенияОНовыхПорученияхНаПереводДС", ПараметрыРегламентногоЗадания);
			
			НовыйСтатус = Перечисления.СтатусыПорученийНаПереводДенежныхСредств.ГотовКОтправке;
			
		КонецЕсли;
		
		Если НовыйСтатус <> Неопределено Тогда
			РегистрыСведений.СтатусыПорученийНаПереводДенежныхСредств.УстановитьСтатусПоручения(ЭтотОбъект.Ссылка, НовыйСтатус);
		КонецЕсли;
		
	КонецЕсли;
			
КонецПроцедуры

#КонецОбласти
