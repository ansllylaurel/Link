
Процедура РассчитатьИндексациюНоминала(СтрокаЦенныеБумаги, НастройкиПоВидуУчета, Движение)

	Если НастройкиПоВидуУчета.ВариантУчетаИндексацииНоминала = Перечисления.ВариантыУчетаИндексированногоНоминала.ОтНачальногоНоминала
		ИЛИ НастройкиПоВидуУчета.ВариантУчетаИндексацииНоминала = Перечисления.ВариантыУчетаИндексированногоНоминала.ОтНоминалаПриПокупке Тогда
		
		СтрокаПартии = СтрокаЦенныеБумаги.Партия.ЦенныеБумаги.Найти(СтрокаЦенныеБумаги.СтрокаПартии, "СтрокаПартии");
		
		Если ТипЗнч(СтрокаЦенныеБумаги.Партия) = Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда
			ДатаПокупки = СтрокаПартии.ДатаПокупки;
			Цена = СтрокаПартии.СуммаПокупки / СтрокаПартии.Количество;
			ЦенаПриобретенияПроцент = Цена / Справочники.Облигации.ПолучитьНоминал(СтрокаЦенныеБумаги.ЦеннаяБумага, ДатаПокупки) * 100;
		Иначе
			ДатаПокупки = СтрокаЦенныеБумаги.Партия.Дата;
			ЦенаПриобретенияПроцент = СтрокаПартии.ЦенаПроцент;
		КонецЕсли;
		
		ЦенаПриобретенияПроцент = Мин(ЦенаПриобретенияПроцент, 100); // все, что больше 100 - премия
		
		// пока отключу учет цены покупки т.к. клиенты так считать не умеют
		ЦенаПриобретенияПроцент = 100;
		
		Если НастройкиПоВидуУчета.ВариантУчетаИндексацииНоминала = Перечисления.ВариантыУчетаИндексированногоНоминала.ОтНачальногоНоминала Тогда
			НачальныйНоминал = СтрокаЦенныеБумаги.ЦеннаяБумага.Номинал;
		Иначе
			НачальныйНоминал = Справочники.Облигации.ПолучитьНоминал(СтрокаЦенныеБумаги.ЦеннаяБумага, ДатаПокупки);
		КонецЕсли;
		НачальнаяНоминальнаяСтоимость = НачальныйНоминал * ЦенаПриобретенияПроцент / 100 * СтрокаЦенныеБумаги.Количество;
		
		ТекущийНоминал = Справочники.Облигации.ПолучитьНоминал(СтрокаЦенныеБумаги.ЦеннаяБумага, ЭтотОбъект.Дата);
		ТекущаяНоминальнаяСтоимость = ТекущийНоминал * ЦенаПриобретенияПроцент / 100 * СтрокаЦенныеБумаги.Количество;
		
		Движение.ИндексацияНоминала = ТекущаяНоминальнаяСтоимость - НачальнаяНоминальнаяСтоимость - СтрокаЦенныеБумаги.БалансоваяИндексацияНоминала;
		
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьЦенныеБумагиПоФиксированномуКурсу(Дата, Организация, СчетДоверительногоУправления)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОценкиСтоимостиЦенныхБумагСрезПоследних.КурсВалютыНоминала КАК КурсВалютыНоминала
		|ИЗ
		|	РегистрСведений.ОценкиСтоимостиЦенныхБумаг.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОценкиСтоимостиЦенныхБумагСрезПоследних
		|ГДЕ
		|	ОценкиСтоимостиЦенныхБумагСрезПоследних.КурсВалютыНоминала <> 0";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьПросроченныеПогашенияКупоновНаПартиях(ДокументДата, Организация, СчетДоверительногоУправления)

	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.ПогашениеКупонаНеИсполненноеВСрокОстаток КАК ВалютнаяСумма,
		|	БухПартииЦенныхБумагОстатки.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчетаОстаток КАК Сумма,
		|	БухПартииЦенныхБумагОстатки.ЗадолженностьПоПогашениюКупонаОстаток КАК ЗадолженностьПоПогашениюКупона,
		|	БухПартииЦенныхБумагОстатки.ЗадолженностьПоПогашениюКупонаВВалютеУчетаОстаток КАК ЗадолженностьПоПогашениюКупонаВВалютеУчета
		|ПОМЕСТИТЬ _ПартииСПросроченнымПогашениемКупона
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&МоментПереоценки,
		|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)) КАК БухПартииЦенныхБумагОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОперацииСЦеннымиБумагами.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ОплатыДефолтныхКупоновЗаДень
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПартииСПросроченнымПогашениемКупона КАК _ПартииСПросроченнымПогашениемКупона
		|		ПО ОперацииСЦеннымиБумагами.ЦеннаяБумага = _ПартииСПросроченнымПогашениемКупона.ЦеннаяБумага
		|			И (ОперацииСЦеннымиБумагами.ДатаОперации >= &НачалоДняПереоценки)
		|			И (ОперацииСЦеннымиБумагами.ДатаОперации <= &КонецДняПереоценки)
		|			И (ОперацииСЦеннымиБумагами.Организация = &Организация)
		|			И (ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|			И (ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Основание) = ТИП(Документ.ПогашениеКупона))
		|			И (ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Операция) = ТИП(Документ.Оплата))";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	Если ТипЗнч(ДокументДата) = Тип("Дата") Тогда
		
		Запрос.УстановитьПараметр("НачалоДняПереоценки", НачалоДня(ДокументДата));
		Запрос.УстановитьПараметр("МоментПереоценки", Новый Граница(КонецДня(ДокументДата), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("КонецДняПереоценки", КонецДня(ДокументДата));
		
	Иначе
		
		Запрос.УстановитьПараметр("НачалоДняПереоценки", НачалоДня(ДокументДата.Дата));
		Запрос.УстановитьПараметр("МоментПереоценки", Новый Граница(ДокументДата.МоментВремени(), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("КонецДняПереоценки", КонецДня(ДокументДата.Дата));
		
	КонецЕсли;
	
	Запрос.Выполнить();
	
	ПартииСПросроченнымПогашениемКупона	= Запрос.МенеджерВременныхТаблиц.Таблицы["_ПартииСПросроченнымПогашениемКупона"].ПолучитьДанные().Выгрузить();
	ОплатыДефолтныхКупоновЗаДень = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОплатыДефолтныхКупоновЗаДень"].ПолучитьДанные().Выгрузить().ВыгрузитьКолонку("ЦеннаяБумага");
	
	Возврат Новый Структура("ПартииСПросроченнымПогашениемКупона, ОплатыДефолтныхКупоновЗаДень", ПартииСПросроченнымПогашениемКупона, ОплатыДефолтныхКупоновЗаДень);
	
КонецФункции

Процедура ОбработкаПроведенияЕПС(Отказ, Режим)
	
	УчетныйРегистр = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета);
	МассивУчетныхАктивов = Новый Массив;
	ДатаПереоценки = НачалоДня(ЭтотОбъект.Дата);
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.ЦелиРасчета.ЕдиныйПланСчетов, Истина);	
	ВыполнятьРасчетПоПисьмуЦБ0185316 = НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316;
	
	// На текущий момент нет настроек учета, которые бы позволили бы управлять формированием движений по партиям
	// и формированием проводок (для страховых партии нужны, а проводки нет). В результате пришлось извращаться:
	// движения по партиям формируются всегда; 
	ВедетсяУчетПоТекущемуВиду = РегистрыСведений.НастройкиУчетаОбщие.ВедетсяУчетПоВиду(
		ДатаПереоценки,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВидУчета);
		
	ПереоценкаПослеВводаНачальныхОстатков = Ложь;
	//Вдруг это переоценка датой ввода остатков?
	Если НЕ ВедетсяУчетПоТекущемуВиду Тогда
		ВедетсяУчетПоТекущемуВиду = РегистрыСведений.НастройкиУчетаОбщие.ВедетсяУчетПоВиду(
			ДатаПереоценки + 24 * 60 * 60,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			ЭтотОбъект.ВидУчета);
		ПереоценкаПослеВводаНачальныхОстатков = ВедетсяУчетПоТекущемуВиду;
	КонецЕсли;
	
	МассивСчетовЭволюции = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Эволюция"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
																				ДатаПереоценки);
	ЭтоКлиентЭволюция = (МассивСчетовЭволюции.Найти(ЭтотОбъект.СчетДоверительногоУправления) <> Неопределено);
	
	МассивСчетовБудущего = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_БУДУЩЕЕ"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
																				ДатаПереоценки);
	ЭтоКлиентБудущее = (МассивСчетовБудущего.Найти(ЭтотОбъект.СчетДоверительногоУправления) <> Неопределено);
	
	МассивСчетовТелекомСоюз = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_ТелекомСоюз"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
																				ДатаПереоценки);
	ЭтоКлиентТелекомСоюз = (МассивСчетовТелекомСоюз.Найти(ЭтотОбъект.СчетДоверительногоУправления) <> Неопределено);
	
	МассивСчетовСНГ = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФ_СНГ"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"),
																				ДатаПереоценки);
	ЭтоКлиентСНГ = (МассивСчетовСНГ.Найти(ЭтотОбъект.СчетДоверительногоУправления) <> Неопределено);

	МассивСчетовВолга = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФВолгаКапитал"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"),
																				ДатаПереоценки);
	ЭтоКлиентВолга = (МассивСчетовВолга.Найти(ЭтотОбъект.СчетДоверительногоУправления) <> Неопределено);

	МассивСчетовЮгория = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ГСКЮгория"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"),
																				ДатаПереоценки);
	ЭтоКлиентЮгория = (МассивСчетовЮгория.Найти(ЭтотОбъект.СчетДоверительногоУправления) <> Неопределено);
	
	СНГБалансовыеДисконтыПремииНа09032022 = Неопределено;
	Если ЭтоКлиентСНГ И ДатаПереоценки >= '20220310' Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
			|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
			|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК КоличествоОстаток,
			|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток КАК ДисконтПремияНачисленныйОстаток,
			|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйВВалютеУчетаОстаток КАК ДисконтПремияНачисленныйВВалютеУчетаОстаток
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
			|			&Период,
			|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
			|				И Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|				И ВЫРАЗИТЬ(ЦеннаяБумага КАК Справочник.Облигации).ИндексируемыйНоминал) КАК БухПартииЦенныхБумагОстатки";
		
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("Период", Новый Граница('20220309235959', ВидГраницы.Включая));
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
		
		СНГБалансовыеДисконтыПремииНа09032022 = Запрос.Выполнить().Выгрузить();
	
	КонецЕсли;
	
	
	// Присоединение Согласия к Нефтегаранту
	// Эта же хрень сделана в проведении
	Если ЭтотОбъект.Дата = '2018-12-05 23:59:59' Тогда
	
		Если ЭтотОбъект.СчетДоверительногоУправления.КодСчета = "DU_NPF345" // НПФ НЕФТЕГАРАНТ АО (Согласие ОПС) - РЭМ
			ИЛИ ЭтотОбъект.СчетДоверительногоУправления.КодСчета = "DU_RT_PN065" // НПФ НЕФТЕГАРАНТ АО ВР (Согласие-ОПС) - Траст
			ИЛИ ЭтотОбъект.СчетДоверительногоУправления.КодСчета = "DU_RT_PN064" // НПФ НЕФТЕГАРАНТ АО ПН  (Согласие-ОПС) - Траст
			ИЛИ ЭтотОбъект.СчетДоверительногоУправления.КодСчета = "DU_RT_PN067" // НПФ НЕФТЕГАРАНТ АО РОПС  (Согласие-ОПС) - Траст
			ИЛИ ЭтотОбъект.СчетДоверительногоУправления.КодСчета = "DU_RT_PN066" // НПФ НЕФТЕГАРАНТ АО СВ (Согласие-ОПС) - Траст
			ИЛИ ЭтотОбъект.СчетДоверительногоУправления.КодСчета = "DU-RPI/UL/66" // НПФ НЕФТЕГАРАНТ АО - РПИ
			Тогда
		
			ПереоценкаПослеВводаНачальныхОстатков = Истина;
		
		КонецЕсли;	
	
	КонецЕсли;
	
	КлиентДоверительногоУправления = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата);
	
	КлиентыУчитывающиеВсеЧастиСтоимостиПоФиксированномуКурсу = Новый Массив;
	КлиентыУчитывающиеВсеЧастиСтоимостиПоФиксированномуКурсу.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Большой"));
	КлиентыУчитывающиеВсеЧастиСтоимостиПоФиксированномуКурсу.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар"));
	
	УчитыватьВсеЧастиСтоимостиПоФиксированномуКурсу = (КлиентыУчитывающиеВсеЧастиСтоимостиПоФиксированномуКурсу.Найти(КлиентДоверительногоУправления) <> Неопределено);
	
	Если ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(, "ПереоценкаПередПереводомАктивовВЭволюцию", ЭтотОбъект.Ссылка) = Истина Тогда
		ПереоценкаПослеВводаНачальныхОстатков = Истина;	
	КонецЕсли;

	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(
								ДатаПереоценки,
								ЭтотОбъект.Организация,
								ЭтотОбъект.СчетДоверительногоУправления);
								
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
								ДатаПереоценки,
								ЭтотОбъект.Организация,
								ЭтотОбъект.СчетДоверительногоУправления,
								Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет,
								Отказ);

	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствуют настройки у %1 по виду учета %2 на %3!", ЭтотОбъект.СчетДоверительногоУправления, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, ДатаПереоценки));
		Возврат;
	КонецЕсли;
	
	ДанныеКурсовЗаЭтотИПредыдущийДень = РаботаСВалютами.ПолучитьДанныеКурсовЗаЭтотИПредыдущийДень(ДатаПереоценки);
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ПереоцениватьЦБНеНаБалансе") Тогда
		// Переоценим ЦБ к получению
		СформироватьПроводкиПереоценкиКПолучениюЕПС(ЭтотОбъект, ПереоценкаПослеВводаНачальныхОстатков, НастройкиУчетаОбщие, Отказ);
		// Переоценим ЦБ купленные по РЕПО
		СформироватьПроводкиПереоценкиКупленныеПоРЕПОЕПС(ЭтотОбъект, ПереоценкаПослеВводаНачальныхОстатков, ДанныеКурсовЗаЭтотИПредыдущийДень, Отказ);
		// Переоценим ЦБ к передаче
		СформироватьПроводкиПереоценкиКПередачеЕПС(ЭтотОбъект, ПереоценкаПослеВводаНачальныхОстатков, НастройкиУчетаОбщие, Отказ);
		// Переоценим ЦБ проданные в РЕПО
		СформироватьПроводкиПереоценкиПроданныеВРЕПОЕПС(ЭтотОбъект, ПереоценкаПослеВводаНачальныхОстатков, ДанныеКурсовЗаЭтотИПредыдущийДень, Отказ);
	КонецЕсли;
	
	Если ПереоценкаПослеВводаНачальныхОстатков Тогда
		НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(ДатаПереоценки + 24 * 60 * 60, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли; 
		
	АналитикаТела = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
	АналитикаПереоценкиТела = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги;
	АналитикаКупонНачисленный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
	АналитикаДисконта = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт;
	АналитикаПремии = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия;
	АналитикаИндексацииНоминала = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ИндексацияНоминала;
	
	ЭтоЕПС = ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
	
	СводныеЦенныеБумаги = ЭтотОбъект.ДополнительныеСвойства.ЦенныеБумаги.Скопировать();
	
	СводныеЦенныеБумаги.Колонки.Добавить("СтоимостьВВалютеУчета"); 
	СводныеЦенныеБумаги.Колонки.Добавить("СтоимостьКупонаВВалютеУчета");
	СводныеЦенныеБумаги.Колонки.Добавить("ДисконтНачисленныйВВалютеУчета");
	СводныеЦенныеБумаги.Колонки.Добавить("ПремияНачисленнаяВВалютеУчета");
	СводныеЦенныеБумаги.Колонки.Добавить("КорректировкаЭСПВВалютеУчета");
	СводныеЦенныеБумаги.Колонки.Добавить("РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета");
	
	СводныеЦенныеБумаги.Колонки.Добавить("НачальныйДисконт", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("БалансовыйДисконт", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("ОценочныйДисконт", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаПереоценки", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаПереоценкиВВалютеУчета", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаПереоценкиКупона", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаПереоценкиКупонаВВалютеУчета", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаКорректировкиЭСП", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаКорректировкиЭСПВВалютеУчета", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаДисконта", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаДисконтаВВалютеУчета", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаПремии", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаПремииВВалютеУчета", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаПервоначальногоПризнания", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаПервоначальногоПризнанияВВалютеУчета", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("КурсоваяРазницаПереоценкиКупона", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("КурсоваяРазницаСтоимостиКупона", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("КурсоваяРазницаПереоценки", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("КурсоваяРазницаСтоимости", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("КурсоваяРазницаДисконтПремияНачисленный", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("КурсоваяРазницаКорректировкиЭСП", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("КурсоваяРазницаПервоначальногоПризнания", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("КурсоваяРазницаДисконт", Новый ОписаниеТипов("Число"));
	СводныеЦенныеБумаги.Колонки.Добавить("КурсоваяРазницаПремия", Новый ОписаниеТипов("Число"));
	
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаИндексацииНоминала", Новый ОписаниеТипов("Число"));
	
	Если НастройкиУчетаОбщие.ОтражатьПартииНаЛицевыхСчетах Тогда
	
		СводныеЦенныеБумаги.Колонки.Добавить("ПереоценкаСНачалаГода", Новый ОписаниеТипов("Число"));
		СводныеЦенныеБумаги.Колонки.Добавить("ПереоценкаСНачалаГодаПоложительная", Новый ОписаниеТипов("Число"));
		СводныеЦенныеБумаги.Колонки.Добавить("ДисконтПремияНачисленныйСНачалаГода", Новый ОписаниеТипов("Число"));
		СводныеЦенныеБумаги.Колонки.Добавить("КорректировкаЭСПСНачалаГода", Новый ОписаниеТипов("Число"));
		СводныеЦенныеБумаги.Колонки.Добавить("РазницаПервоначальногоПризнанияСНачалаГода", Новый ОписаниеТипов("Число"));
		СводныеЦенныеБумаги.Колонки.Добавить("КурсовыеРазницыСНачалаГода", Новый ОписаниеТипов("Число"));
		СводныеЦенныеБумаги.Колонки.Добавить("ИндексацияНоминалаСНачалаГода", Новый ОписаниеТипов("Число"));
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
			|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
			|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
			|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	БухПартииЦенныхБумагОстатки.ПереоценкаСНачалаГодаОстаток КАК ПереоценкаСНачалаГода,
			|	БухПартииЦенныхБумагОстатки.ПереоценкаСНачалаГодаПоложительнаяОстаток КАК ПереоценкаСНачалаГодаПоложительная,
			|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйСНачалаГодаОстаток КАК ДисконтПремияНачисленныйСНачалаГода,
			|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПСНачалаГодаОстаток КАК КорректировкаЭСПСНачалаГода,
			|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияСНачалаГодаОстаток КАК РазницаПервоначальногоПризнанияСНачалаГода,
			|	БухПартииЦенныхБумагОстатки.КурсовыеРазницыСНачалаГодаОстаток КАК КурсовыеРазницыСНачалаГода,
			|	БухПартииЦенныхБумагОстатки.ИндексацияНоминалаСНачалаГодаОстаток КАК ИндексацияНоминалаСНачалаГода
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)) КАК БухПартииЦенныхБумагОстатки";
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Для Каждого СтрокаЦенныеБумаги Из СводныеЦенныеБумаги Цикл
				Если ВыборкаДетальныеЗаписи.Рынок <> СтрокаЦенныеБумаги.Рынок Тогда
					Продолжить;
				КонецЕсли;
				Если ВыборкаДетальныеЗаписи.ЦеннаяБумага <> СтрокаЦенныеБумаги.ЦеннаяБумага Тогда
					Продолжить;
				КонецЕсли;
				Если ВыборкаДетальныеЗаписи.УчетныйАктивЕПС <> СтрокаЦенныеБумаги.УчетныйАктивЕПС Тогда
					Продолжить;
				КонецЕсли;
				Если ВыборкаДетальныеЗаписи.Партия <> СтрокаЦенныеБумаги.Партия Тогда
					Продолжить;
				КонецЕсли;
				Если ВыборкаДетальныеЗаписи.СтрокаПартии <> СтрокаЦенныеБумаги.СтрокаПартии Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаЦенныеБумаги.ПереоценкаСНачалаГода						= ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГода;
				СтрокаЦенныеБумаги.ПереоценкаСНачалаГодаПоложительная			= ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГодаПоложительная;
				СтрокаЦенныеБумаги.ДисконтПремияНачисленныйСНачалаГода			= ВыборкаДетальныеЗаписи.ДисконтПремияНачисленныйСНачалаГода;
				СтрокаЦенныеБумаги.КорректировкаЭСПСНачалаГода					= ВыборкаДетальныеЗаписи.КорректировкаЭСПСНачалаГода;
				СтрокаЦенныеБумаги.РазницаПервоначальногоПризнанияСНачалаГода	= ВыборкаДетальныеЗаписи.РазницаПервоначальногоПризнанияСНачалаГода;
				СтрокаЦенныеБумаги.КурсовыеРазницыСНачалаГода					= ВыборкаДетальныеЗаписи.КурсовыеРазницыСНачалаГода;
				СтрокаЦенныеБумаги.ИндексацияНоминалаСНачалаГода				= ВыборкаДетальныеЗаписи.ИндексацияНоминалаСНачалаГода;
			
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
	// периодика индексации совпадает с периодикой переоценки
	ПереодичностьИндексацииНоминала = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктивов(
												ДатаПереоценки,
												ЭтотОбъект.Организация,
												ЭтотОбъект.СчетДоверительногоУправления,
												Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет,
												"ПериодичностьПереоценки");
												
	ИндексироватьНоминалВНерабочиеДни = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктивов(
												ДатаПереоценки,
												ЭтотОбъект.Организация,
												ЭтотОбъект.СчетДоверительногоУправления,
												Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет,
												"ПереоцениватьВНерабочиеДни");
												
	// нюансы для валютных бумаг
	НастройкиПереоцениватьВНерабочиеДни = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктивов(
												ДатаПереоценки,
												ЭтотОбъект.Организация,
												ЭтотОбъект.СчетДоверительногоУправления,
												Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет,
												"ПереоцениватьВНерабочиеДни");

	НастройкиНачислятьПроцентныеДоходыВНерабочиеДни = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктивов(
												ДатаПереоценки,
												ЭтотОбъект.Организация,
												ЭтотОбъект.СчетДоверительногоУправления,
												Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет,
												"НачислятьПроцентныеДоходыВНерабочиеДни");
												
												
	КалендарьДляСчетаДУ = РаботаСПереоценкой.ПолучитьКалендарьДляСчетаДУ(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ДатаПереоценки);
	
	// т.к. индексация производится непосредственно при проведении, то...
	ПериодичностиДатыПереоценки = БухгалтерскийУчетЕПС.ПолучитьПериодичностиДаты(ДатаПереоценки);
	
	РабочийДень			 = Справочники.Календари.ЭтоРабочийДень(КалендарьДляСчетаДУ, ДатаПереоценки);
	
	ОписаниеТипаКурсВалютыНоминала = Метаданные.ОпределяемыеТипы.КурсВалюты.Тип;											
	
	ДанныеОПросроченныхПогашенияхКупонов = ПолучитьПросроченныеПогашенияКупоновНаПартиях(ЭтотОбъект, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	ПартииСПросроченнымПогашениемКупона = ДанныеОПросроченныхПогашенияхКупонов.ПартииСПросроченнымПогашениемКупона;
	ОплатыДефолтныхКупоновЗаДень = ДанныеОПросроченныхПогашенияхКупонов.ОплатыДефолтныхКупоновЗаДень;
	
	ЦенныеБумагиЯвляющиесяДефолтнымиПоМнениюКлиента = БухгалтерскийУчетЕПС.ПолучитьЦенныеБумагиЯвляющиесяДефолтнымиПоМнениюКлиента(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	ЦенныеБумагиПоФиксированномуКурсуНаВчера = ПолучитьЦенныеБумагиПоФиксированномуКурсу(НачалоДня(ЭтотОбъект.Дата) - 24 * 60 * 60, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	МассивТиповПартийСделокИсполненийПоставок = Новый Массив();
	МассивТиповПартийСделокИсполненийПоставок.Добавить(Тип("ДокументСсылка.Сделка"));
	МассивТиповПартийСделокИсполненийПоставок.Добавить(Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке"));
	МассивТиповПартийСделокИсполненийПоставок.Добавить(Тип("ДокументСсылка.ПоставкаЦенныхБумаг"));
	
	Для Каждого СтрокаЦенныеБумаги Из СводныеЦенныеБумаги Цикл
		
		НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
			НастройкиУчетаОбщие,
			СтрокаЦенныеБумаги.ЦеннаяБумага,
			СтрокаЦенныеБумаги.УчетныйАктивЕПС,
			СтрокаЦенныеБумаги.Партия,
			СтрокаЦенныеБумаги.СтрокаПартии);
		
		// не очень красиво, но я не уверен, что для данного случая стоит регистр партий корежить
		СуммаПросроченногоПогашения = 0;
		СуммаПросроченногоПогашенияВВалютеУчета = 0;
		
		// если не переоцениваем по балансу или в этот день погасили (частично или всю) просроченную задолженность
		Если СтрокаЦенныеБумаги.ПолеЦены <> Перечисления.ИсточникиЦеныДляПереоценки.БалансоваяЦена ИЛИ ОплатыДефолтныхКупоновЗаДень.Найти(СтрокаЦенныеБумаги.ЦеннаяБумага) <> Неопределено Тогда

			БумагаЯвляетсяДефолтной = (ЦенныеБумагиЯвляющиесяДефолтнымиПоМнениюКлиента.Найти(СтрокаЦенныеБумаги.ЦеннаяБумага) <> Неопределено);
			
			НайденныеСтроки = ПартииСПросроченнымПогашениемКупона.НайтиСтроки(Новый Структура("ЦеннаяБумага, Партия, СтрокаПартии", СтрокаЦенныеБумаги.ЦеннаяБумага, СтрокаЦенныеБумаги.Партия, СтрокаЦенныеБумаги.СтрокаПартии));
			Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				СуммаПросроченногоПогашения = СуммаПросроченногоПогашения + НайденнаяСтрока.ВалютнаяСумма;
				СуммаПросроченногоПогашенияВВалютеУчета = СуммаПросроченногоПогашенияВВалютеУчета + НайденнаяСтрока.Сумма;
				
				Если БумагаЯвляетсяДефолтной И ДатаПереоценки >= '20240726' Тогда
				
					СуммаПросроченногоПогашения = СуммаПросроченногоПогашения + НайденнаяСтрока.ЗадолженностьПоПогашениюКупона;
					СуммаПросроченногоПогашенияВВалютеУчета = СуммаПросроченногоПогашенияВВалютеУчета + НайденнаяСтрока.ЗадолженностьПоПогашениюКупонаВВалютеУчета;
				
				КонецЕсли;
				
			КонецЦикла;
			
			Если СуммаПросроченногоПогашения <> 0 ИЛИ БумагаЯвляетсяДефолтной // есть просрочка погашения или выпуск считаем дефолтным, значит и текущий купон не получим
				ИЛИ (СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_АрчерФинанс") И ДатаПереоценки >= '20201231') // все клиенты прислали профсуждения о том, чтобы считать по 0
				ИЛИ (СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финстоун") И ДатаПереоценки >= '20201231' И ЭтоКлиентЭволюция) // эволюция финстоун в 0
				Тогда
				СуммаПросроченногоПогашения				= СуммаПросроченногоПогашения				+ СтрокаЦенныеБумаги.ОценочнаяСуммаКупона; 
				СуммаПросроченногоПогашенияВВалютеУчета	= СуммаПросроченногоПогашенияВВалютеУчета	+ СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета; 
			
			КонецЕсли;
					
		КонецЕсли;
		// готово
		
		Если ВыполнятьРасчетПоПисьмуЦБ0185316
			И (СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1Пропертиз_Дол")
				ИЛИ СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1Пропертиз_До2")) Тогда
		
			СтрокаЦенныеБумаги.Перекурсовать = Ложь;
		
		КонецЕсли;
		
		
		//ВалютаНоминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаЦенныеБумаги.ЦеннаяБумага, "ВалютаНоминала");
		// Так РЕАЛЬНО быстрее чем через ЗначениеРеквизитаОбъекта
		ВалютаНоминала = СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала;
		
		ПереоценкаПоФиксированномуКурсу = (СтрокаЦенныеБумаги.КурсВалютыНоминала > 0);
		ФиксированныйКурсИзменился = Ложь;
		Если ПереоценкаПоФиксированномуКурсу Тогда
		
			НайденныеСтроки = ЦенныеБумагиПоФиксированномуКурсуНаВчера.НайтиСтроки(Новый Структура("ЦеннаяБумага", СтрокаЦенныеБумаги.ЦеннаяБумага));
			Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			
				Если НайденнаяСтрока.КурсВалютыНоминала <> СтрокаЦенныеБумаги.КурсВалютыНоминала Тогда
					ФиксированныйКурсИзменился = Истина;
					Прервать;
				КонецЕсли;
			
			КонецЦикла;
			
		КонецЕсли;

		
		УчетныйАктив = СтрокаЦенныеБумаги.УчетныйАктивЕПС;
		ИмяУчетногоАктива = УчетныйАктив.ИмяПредопределенныхДанных;
		
		Если МассивУчетныхАктивов.Найти(УчетныйАктив) = Неопределено Тогда
			МассивУчетныхАктивов.Добавить(УчетныйАктив);
		КонецЕсли;
		
		
		Если ДатаПереоценки >= '20230101' И НЕ ПереоценкаПоФиксированномуКурсу И ВалютаНоминала <> ВалютаУчета Тогда
			
			Если ДатаПереоценки >= '20250901' // с сентября 25го начали брать валютные бумаги, но ММВБ считает не точно по курсу и нужно курсовать в день поступления
				И МассивТиповПартийСделокИсполненийПоставок.Найти(ТипЗнч(СтрокаЦенныеБумаги.Партия)) <> Неопределено
				И НачалоДня(СтрокаЦенныеБумаги.Партия.Дата) = ДатаПереоценки Тогда
			
				СтрокаЦенныеБумаги.Перекурсовать = Истина;
				
			Иначе // не менялся курс - не курсуем

				СтрокаДанныеВалюты = ДанныеКурсовЗаЭтотИПредыдущийДень.Найти(ВалютаНоминала, "Валюта");
				Если СтрокаДанныеВалюты <> Неопределено Тогда
					Если НЕ СтрокаДанныеВалюты.КурсИзменился Тогда // курс со вчерашнего дня не менялся
						
						Если НЕ СтрокаДанныеВалюты.КурсРабочихДнейИзменился Тогда // курс с прошлого рабочего дня не менялся, актульно для понедельников и после праздников
						
							СтрокаЦенныеБумаги.Перекурсовать = Ложь;
							
						Иначе // у нас понедельник и надо проверить была ли переоценка в выходной 
							
							Если УчетныйАктив.ВключатьРасходыПоПокупкеВСтоимость Тогда // Активы по АС
								
								// не начисляли в выходной дисконты-премии-корректировки, значит будем курсовать
								СтрокаЦенныеБумаги.Перекурсовать = НЕ НастройкиНачислятьПроцентныеДоходыВНерабочиеДни[ИмяУчетногоАктива];
							
							Иначе // Активы по СС

								// не переоценивали в выходной, значит будем курсовать
								СтрокаЦенныеБумаги.Перекурсовать = НЕ НастройкиПереоцениватьВНерабочиеДни[ИмяУчетногоАктива];
							
							КонецЕсли;
						
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
		
		КонецЕсли;
		
		
		Движение = Движения.БухПартииЦенныхБумаг.Добавить();
		//Движение.ВидДвиженияПартий			  = Перечисления.ВидыДвиженийПартий.ПереоценкаИНачислениеПроцентов;
		
		Движение.ВидДвижения                  = ВидДвиженияНакопления.Приход;
		Движение.Период                       = ЭтотОбъект.Дата;
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
		Движение.УчетныйАктивЕПС			  = СтрокаЦенныеБумаги.УчетныйАктивЕПС;
		Движение.Партия                       = СтрокаЦенныеБумаги.Партия;
		Движение.СтрокаПартии                 = СтрокаЦенныеБумаги.СтрокаПартии;
		Движение.Рынок                        = СтрокаЦенныеБумаги.Рынок;
		Движение.ВидУчета                     = ЭтотОбъект.ВидУчета;
		
		КурсоваяРазница = 0;
		КурсоваяРазницаПереоценки = 0;
		КурсоваяРазницаСтоимости = 0;
		КурсоваяРазницаКупона = 0;
		КурсоваяРазницаПереоценкиКупона = 0;
		КурсоваяРазницаСтоимостиКупона = 0;
		КурсоваяРазницаДисконтПремияНачисленный = 0;
		КурсоваяРазницаКорректировкиЭСП = 0;
		КурсоваяРазницаПервоначальногоПризнания = 0;
		
		ИндексацияСНГПосле09032022 = Ложь;
		Если ЭтоКлиентСНГ 
		   И ДатаПереоценки >= '20220310'
		   И ДатаПереоценки < '20221230'
		   И СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации
		   И СтрокаЦенныеБумаги.ЦеннаяБумага.ИндексируемыйНоминал Тогда
		   
			ИндексацияСНГПосле09032022 = Истина;
		
		КонецЕсли;
		
		
		Если НастройкиУчетаОбщие.ВключатьПроцентныеДоходыИКорректировкиВБалансовуюСтоимостьПриПереоценке И НЕ ИндексацияСНГПосле09032022 Тогда 
			
			Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				
				Движение.ИндексацияНоминала = 0;
				Если СтрокаЦенныеБумаги.ЦеннаяБумага.ИндексируемыйНоминал Тогда
					
					ИндексироватьНоминал = Ложь;
					Если ПереодичностьИндексацииНоминала[ИмяУчетногоАктива] = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
						Если ПериодичностиДатыПереоценки.ПериодичностьМесяц Тогда
						    ИндексироватьНоминал = Истина;
						ИначеЕсли РабочийДень Тогда
							ИндексироватьНоминал = Истина;
						ИначеЕсли ИндексироватьНоминалВНерабочиеДни[ИмяУчетногоАктива] Тогда
							ИндексироватьНоминал = Истина;
						КонецЕсли;
					Иначе
						ИндексироватьНоминал = БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПереодичностьИндексацииНоминала[ИмяУчетногоАктива], ДатаПереоценки, КалендарьДляСчетаДУ);
					КонецЕсли;
					
					Если ИндексироватьНоминал Тогда
						РассчитатьИндексациюНоминала(СтрокаЦенныеБумаги, НастройкиПоВидуУчета, Движение);
					КонецЕсли;
					
				КонецЕсли;
				
				Движение.ПереоценкаКупона = СтрокаЦенныеБумаги.ОценочнаяСуммаКупона - СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
				Если СтрокаЦенныеБумаги.Перекурсовать Тогда //"Перекурсовать" всегда установлено при переоценке, но м.б. отдельно
					Если Движение.ПереоценкаКупона = 0 Тогда // 
						БалансоваяСуммаКупонаПоТекущемуКурсу = СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета;
					ИначеЕсли ПереоценкаПоФиксированномуКурсу Тогда
						//БалансоваяСуммаКупонаПоТекущемуКурсу = СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;
						БалансоваяСуммаКупонаПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
							Новый Структура("Сумма", СтрокаЦенныеБумаги.БалансоваяСуммаКупона),
							ВалютаНоминала,
							ЭтотОбъект.Организация,
							ЭтотОбъект.Дата,
							СтрокаЦенныеБумаги.КурсВалютыНоминала,
							Отказ).Сумма, 2);
						Если НЕ ФиксированныйКурсИзменился // если курс фиксированный и не меняется то по идее перекурсовок быть не должно, они из-за погрешностей округления только могут вылезти
							И(УчитыватьВсеЧастиСтоимостиПоФиксированномуКурсу И ДатаПереоценки >= '20220815' // но для Большго и Сафмара потребовалось время, чтобы договориться об этом
								ИЛИ ЭтоКлиентЭволюция И ДатаПереоценки >= '20221201' // с Эволюцией аналогично
								ИЛИ ЭтоКлиентБудущее И ДатаПереоценки >= '20221225' // и Будущее присоединилось
								ИЛИ ЭтоКлиентТелекомСоюз И ДатаПереоценки >= '20230101' // И Телеком туда же
								)
						Тогда 
							БалансоваяСуммаКупонаПоТекущемуКурсу = СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;
						КонецЕсли;
					ИначеЕсли ДатаПереоценки = '20221231' И СтрокаЦенныеБумаги.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_VEB_5.942_11/21") Тогда // временно затыкаю дыру
						БалансоваяСуммаКупонаПоТекущемуКурсу = СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета;
					Иначе
						БалансоваяСуммаКупонаПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.БалансоваяСуммаКупона, ВалютаНоминала, ЭтотОбъект.Организация, ЭтотОбъект.Дата, Отказ), 2);
					КонецЕсли;
					КурсоваяРазницаКупона = БалансоваяСуммаКупонаПоТекущемуКурсу - СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;
					Если Движение.ПереоценкаКупона = 0 Тогда
						СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета = БалансоваяСуммаКупонаПоТекущемуКурсу;
					КонецЕсли;
				КонецЕсли;
				Движение.ПереоценкаКупонаВВалютеУчета = СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета 
					- СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета - КурсоваяРазницаКупона;
				
				// ВОТ ТАК ВОТ!!! это из-за СНГ с расчетным купоном
				Если Движение.ПереоценкаКупона < 0
					И НЕ (ЭтоКлиентВолга И ЭтотОбъект.Дата < '20250925') Тогда // НПФ Волга до 25.9.25 вела ресчет купона по схеме "рубли в валюту, округлили и обратно", что приводит к купону в минус
					Движение.ПереоценкаКупона = 0;
					Движение.ПереоценкаКупонаВВалютеУчета = 0;
				КонецЕсли;
				
				Движение.ДисконтПремияНачисленный = СтрокаЦенныеБумаги.ОценочныеДисконтПремия - СтрокаЦенныеБумаги.БалансовыеДисконтПремия;
				Если СтрокаЦенныеБумаги.Перекурсовать Тогда
					Если Движение.ДисконтПремияНачисленный = 0 Тогда
						БалансовыеДисконтПремияПоТекущемуКурсу = СтрокаЦенныеБумаги.ОценочныеДисконтПремияВВалютеУчета;
					ИначеЕсли ПереоценкаПоФиксированномуКурсу И УчитыватьВсеЧастиСтоимостиПоФиксированномуКурсу Тогда
						БалансовыеДисконтПремияПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
