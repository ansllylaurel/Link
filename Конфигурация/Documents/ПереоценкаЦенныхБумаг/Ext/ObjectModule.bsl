					Отказ), 2);
				ПереоценкаКупонаПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
					СтрокаЦенныеБумаги.ПереоценкаКупона,
					ВалютаНоминала,
					ЭтотОбъект.Организация,
					ЭтотОбъект.Дата, Отказ), 2);
			КонецЕсли;
		Иначе
			ПереоценкаПоТекущемуКурсу = СтрокаЦенныеБумаги.ПереоценкаВВалютеУчета;
			ПереоценкаКупонаПоТекущемуКурсу = СтрокаЦенныеБумаги.ПереоценкаКупонаВВалютеУчета;
		КонецЕсли;
		Если ПереоценкаПоФиксированномуКурсу ИЛИ УчитыватьВсеЧастиСтоимостиПоФиксированномуКурсу Тогда
			КурсоваяРазницаПереоценки = КурсоваяРазница - КурсоваяРазницаСтоимости;
			
		// бывают ситуации, когда из-за того, что все части стоимости перекурсовываются отдельно, но и общая тоже должна быть по курсу
		// и в таких случаях на ПереоценкаВВалютеУчета накапливается мелкая погрешность сложения разных частей стоимости в валюте учета
		// так и пускай она там же и остается - условие проверяет, что если стоимость ни в валюте, ни в рублях не менялась 
		// и при этом прочие части стоимости не перекурсовывались, то и ПереоценкаВВалютеУчета тоже перекурсовке не подлежит
		ИначеЕсли Движение.Переоценка = 0 И Движение.ПереоценкаВВалютеУчета = 0 
			И КурсоваяРазницаСтоимости = 0 И КурсоваяРазницаДисконтПремияНачисленный = 0 И КурсоваяРазницаКорректировкиЭСП = 0 Тогда
			КурсоваяРазницаПереоценки = 0;
		Иначе
			КурсоваяРазницаПереоценки = ПереоценкаПоТекущемуКурсу - СтрокаЦенныеБумаги.ПереоценкаВВалютеУчета;
			КурсоваяРазницаСтоимости = КурсоваяРазница - КурсоваяРазницаПереоценки;
		КонецЕсли;
		КурсоваяРазницаПереоценкиКупона = ПереоценкаКупонаПоТекущемуКурсу - СтрокаЦенныеБумаги.ПереоценкаКупонаВВалютеУчета;
		КурсоваяРазницаСтоимостиКупона = КурсоваяРазницаКупона - КурсоваяРазницаПереоценкиКупона;
		Если СтрокаЦенныеБумаги.БалансоваяСуммаКупона = СтрокаЦенныеБумаги.ПереоценкаКупона Тогда // весь купон - в переоценке купона, УНКД = 0
			Если КурсоваяРазницаСтоимостиКупона <> 0 Тогда // а вот ее не должно быть, всю курсовую - в ННКД
				КурсоваяРазницаПереоценкиКупона = КурсоваяРазницаПереоценкиКупона + КурсоваяРазницаСтоимостиКупона;
				КурсоваяРазницаСтоимостиКупона = 0;
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтоЕПС И СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанные <> СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанные Тогда
			
			Движение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанные - СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанные;
			Если СтрокаЦенныеБумаги.Перекурсовать Тогда
				БалансоваяРазницаППНеНаблюдаемыеДанныеПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанные, ВалютаНоминала, ЭтотОбъект.Организация, ЭтотОбъект.Дата, Отказ), 2);
				КурсоваяРазницаПервоначальногоПризнания = БалансоваяРазницаППНеНаблюдаемыеДанныеПоТекущемуКурсу - СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанныеВВалютеУчета;
				Если Движение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = 0 Тогда
					СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанныеВВалютеУчета = БалансоваяРазницаППНеНаблюдаемыеДанныеПоТекущемуКурсу;
				КонецЕсли;
			КонецЕсли;
			Движение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета = СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета - СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанныеВВалютеУчета - КурсоваяРазницаПервоначальногоПризнания;
			
			Движение.РазницаПервоначальногоПризнанияСНачалаГода = - Движение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета;
			Если (СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации ИЛИ СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Векселя)
				И СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанные = 0 Тогда
				Движение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная = 0;
			КонецЕсли;

		КонецЕсли;
		
		Если Не ПереоценкаПослеВводаНачальныхОстатков Тогда
		
			Движение.ПереоценкаКупонаСНачалаГода = Движение.ПереоценкаКупонаВВалютеУчета;
			Движение.КорректировкаЭСПСНачалаГода = Движение.КорректировкаЭСПВВалютеУчета;
			Движение.ДисконтПремияНачисленныйСНачалаГода = Движение.ДисконтПремияНачисленныйВВалютеУчета;
			Движение.ПереоценкаСНачалаГода = Движение.ПереоценкаВВалютеУчета;
			Движение.ИндексацияНоминалаСНачалаГода = Движение.ИндексацияНоминала;
			
			// у них офр одинаковый, поэтому нефиг
			Движение.ПереоценкаСНачалаГода = Движение.ПереоценкаСНачалаГода + Движение.ИндексацияНоминалаСНачалаГода;
			Движение.ИндексацияНоминалаСНачалаГода = 0;
			
			Если Движение.ПереоценкаВВалютеУчета + Движение.ИндексацияНоминала > 0 Тогда
			    Движение.ПереоценкаСНачалаГодаПоложительная = Движение.ПереоценкаВВалютеУчета + Движение.ИндексацияНоминала;
			КонецЕсли;
			
			//Движение.КурсовыеРазницыСНачалаГода = 
			
		КонецЕсли; 
		
		// #ТехДолг по задаче #379037
		// не должно быть переоценки при балансовой цене
		// это немного затыка, но пока так, в дальнейшем переделаю
		// уточнение по задаче #534018: 
		// бумага переоценивается по балансовой, стоимоть бумаги не меняется, но происходит перераспределение между частями стоимости
		// приходят деньги, они уменьшают просроченное погашение и чтобы стоимость осталась по нулям нужно увеличить переоценку
		Если СтрокаЦенныеБумаги.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.БалансоваяЦена И ОплатыДефолтныхКупоновЗаДень.Найти(СтрокаЦенныеБумаги.ЦеннаяБумага) = Неопределено Тогда
		
			Движение.Переоценка = 0;
			Движение.ПереоценкаВВалютеУчета = 0;
			Движение.ПереоценкаСНачалаГода = 0;
		
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаЦенныеБумаги, Движение, "СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, КорректировкаЭСПВВалютеУчета, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета");
		СтрокаЦенныеБумаги.СуммаПереоценки = Движение.Переоценка;
		СтрокаЦенныеБумаги.СуммаПереоценкиВВалютеУчета = Движение.ПереоценкаВВалютеУчета;
		СтрокаЦенныеБумаги.СуммаПереоценкиКупона = Движение.ПереоценкаКупона;
		СтрокаЦенныеБумаги.СуммаПереоценкиКупонаВВалютеУчета = Движение.ПереоценкаКупонаВВалютеУчета;
		СтрокаЦенныеБумаги.СуммаКорректировкиЭСП = Движение.КорректировкаЭСП;
		СтрокаЦенныеБумаги.СуммаКорректировкиЭСПВВалютеУчета = Движение.КорректировкаЭСПВВалютеУчета;
		СтрокаЦенныеБумаги.СуммаПервоначальногоПризнания = Движение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные;
		СтрокаЦенныеБумаги.СуммаПервоначальногоПризнанияВВалютеУчета = Движение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета;
		СтрокаЦенныеБумаги.КурсоваяРазницаПереоценкиКупона = КурсоваяРазницаПереоценкиКупона;
		СтрокаЦенныеБумаги.КурсоваяРазницаСтоимостиКупона = КурсоваяРазницаСтоимостиКупона;
		СтрокаЦенныеБумаги.КурсоваяРазницаПереоценки = КурсоваяРазницаПереоценки;
		СтрокаЦенныеБумаги.КурсоваяРазницаСтоимости = КурсоваяРазницаСтоимости;
		СтрокаЦенныеБумаги.КурсоваяРазницаДисконтПремияНачисленный = КурсоваяРазницаДисконтПремияНачисленный;
		СтрокаЦенныеБумаги.КурсоваяРазницаКорректировкиЭСП = КурсоваяРазницаКорректировкиЭСП;
		СтрокаЦенныеБумаги.КурсоваяРазницаПервоначальногоПризнания = КурсоваяРазницаПервоначальногоПризнания;
		
		СтрокаЦенныеБумаги.СуммаИндексацииНоминала = Движение.ИндексацияНоминала;
		
		Если НастройкиУчетаОбщие.ОтражатьДоходыРасходыОтПерекурсовкиПереоценкиКакПереоценку
			И СтрокаЦенныеБумаги.СуммаПереоценки <> 0
			И НЕ ЭтоКлиентЮгория Тогда
		
			СтрокаЦенныеБумаги.СуммаПереоценкиВВалютеУчета = СтрокаЦенныеБумаги.СуммаПереоценкиВВалютеУчета + СтрокаЦенныеБумаги.КурсоваяРазницаПереоценки;
			СтрокаЦенныеБумаги.КурсоваяРазницаПереоценки = 0;
		
		КонецЕсли;
		
		
		Если СтрокаЦенныеБумаги.НачальныеДисконтПремия > 0 Тогда
			СтрокаЦенныеБумаги.ПремияНачисленнаяВВалютеУчета = Движение.ДисконтПремияНачисленныйВВалютеУчета;
			СтрокаЦенныеБумаги.ДисконтНачисленныйВВалютеУчета = 0;
		Иначе
			СтрокаЦенныеБумаги.ДисконтНачисленныйВВалютеУчета = Движение.ДисконтПремияНачисленныйВВалютеУчета;
			СтрокаЦенныеБумаги.ПремияНачисленнаяВВалютеУчета = 0;
		КонецЕсли;

		
		Если СтрокаЦенныеБумаги.Перекурсовать И 
			(КурсоваяРазницаПереоценкиКупона <> 0
			ИЛИ КурсоваяРазницаСтоимостиКупона <> 0
			ИЛИ КурсоваяРазницаПереоценки <> 0
			ИЛИ КурсоваяРазницаСтоимости <> 0
			ИЛИ КурсоваяРазницаДисконтПремияНачисленный <> 0
			ИЛИ КурсоваяРазницаКорректировкиЭСП <> 0
			ИЛИ КурсоваяРазницаПервоначальногоПризнания <> 0)
			Тогда
			
			НовоеДвижение = Движения.БухПартииЦенныхБумаг.Добавить();
			//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.Перекурсовка;
			
			НовоеДвижение.Организация		= ЭтотОбъект.Организация;
			НовоеДвижение.СчетДоверительногоУправления		= ЭтотОбъект.СчетДоверительногоУправления;
			НовоеДвижение.ВидУчета			= ЭтотОбъект.ВидУчета;
			НовоеДвижение.ЦеннаяБумага 		= СтрокаЦенныеБумаги.ЦеннаяБумага;
			НовоеДвижение.УчетныйАктивЕПС 	= УчетныйАктив;
			НовоеДвижение.Партия 			= СтрокаЦенныеБумаги.Партия;
			НовоеДвижение.СтрокаПартии 		= СтрокаЦенныеБумаги.СтрокаПартии;
			НовоеДвижение.Рынок 			= СтрокаЦенныеБумаги.Рынок;
			
			НовоеДвижение.ВидДвижения 		= Перечисления.ВидыДвижений.Приход;
			НовоеДвижение.Регистратор 		= ЭтотОбъект.Ссылка;
			НовоеДвижение.Период 			= ЭтотОбъект.Дата;
				
			НовоеДвижение.СтоимостьВВалютеУчета = КурсоваяРазницаСтоимости;
			НовоеДвижение.СтоимостьКупонаВВалютеУчета = КурсоваяРазницаСтоимостиКупона;
			НовоеДвижение.ПереоценкаВВалютеУчета = КурсоваяРазницаПереоценки;
			НовоеДвижение.ПереоценкаКупонаВВалютеУчета = КурсоваяРазницаПереоценкиКупона;
			НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета = КурсоваяРазницаДисконтПремияНачисленный;
			НовоеДвижение.КорректировкаЭСПВВалютеУчета = КурсоваяРазницаКорректировкиЭСП;
			НовоеДвижение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета = КурсоваяРазницаПервоначальногоПризнания;
			
			// при такой настройке КРП уходит в переоценку и в общие КР не идет
			Если НастройкиУчетаОбщие.ОтражатьДоходыРасходыОтПерекурсовкиПереоценкиКакПереоценку И КурсоваяРазницаПереоценки <> 0 Тогда 
				НовоеДвижение.ПереоценкаСНачалаГода = КурсоваяРазницаПереоценки;
				КурсоваяРазницаПереоценки = 0;
			КонецЕсли;

			НовоеДвижение.КурсовыеРазницыСНачалаГода = КурсоваяРазницаПереоценкиКупона + КурсоваяРазницаСтоимостиКупона
				+ КурсоваяРазницаПереоценки + КурсоваяРазницаСтоимости 
				+ КурсоваяРазницаДисконтПремияНачисленный + КурсоваяРазницаКорректировкиЭСП + КурсоваяРазницаПервоначальногоПризнания;
			
		КонецЕсли;
		
		//рассоритруем дисконты/премии отдельно
		Если СтрокаЦенныеБумаги.НачальныеДисконтПремия < 0 Тогда //дисконт
		
			СтрокаЦенныеБумаги.СуммаДисконта = Движение.ДисконтПремияНачисленный;
			СтрокаЦенныеБумаги.СуммаДисконтаВВалютеУчета = Движение.ДисконтПремияНачисленныйВВалютеУчета;
			СтрокаЦенныеБумаги.КурсоваяРазницаДисконт = КурсоваяРазницаДисконтПремияНачисленный;
			
			СтрокаЦенныеБумаги.НачальныйДисконт = СтрокаЦенныеБумаги.НачальныеДисконтПремия;
			СтрокаЦенныеБумаги.БалансовыйДисконт = СтрокаЦенныеБумаги.БалансовыеДисконтПремия;
			СтрокаЦенныеБумаги.ОценочныйДисконт = СтрокаЦенныеБумаги.ОценочныеДисконтПремия;
			
			СтрокаЦенныеБумаги.НачальныеДисконтПремия = 0;
			СтрокаЦенныеБумаги.БалансовыеДисконтПремия = 0;
			СтрокаЦенныеБумаги.ОценочныеДисконтПремия = 0;
			
		Иначе // премия
			
			СтрокаЦенныеБумаги.СуммаПремии = Движение.ДисконтПремияНачисленный;
			СтрокаЦенныеБумаги.СуммаПремииВВалютеУчета = Движение.ДисконтПремияНачисленныйВВалютеУчета;
			СтрокаЦенныеБумаги.КурсоваяРазницаПремия = КурсоваяРазницаДисконтПремияНачисленный;
		
			СтрокаЦенныеБумаги.НачальныйДисконт = 0;
			СтрокаЦенныеБумаги.БалансовыйДисконт = 0;
			СтрокаЦенныеБумаги.ОценочныйДисконт = 0;
			
		КонецЕсли;
		
		Если Движение.Стоимость = 0 И Движение.СтоимостьКупона = 0
			И Движение.Переоценка = 0 И Движение.ПереоценкаКупона = 0
			И Движение.ДисконтПремияНачисленный = 0
			И Движение.КорректировкаЭСП = 0
			И Движение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = 0 Тогда
			
			Движения.БухПартииЦенныхБумаг.Удалить(Движение);
			
		КонецЕсли;
	КонецЦикла;
	
	// если отражаем партии на счетах то не сворачиваем, иначе сворачиваем
	Если НЕ НастройкиУчетаОбщие.ОтражатьПартииНаЛицевыхСчетах И НЕ НастройкиУчетаОбщие.НеСворачиватьПоПарнымСчетамДоходыРасходыОтПереоценки Тогда
	
		СводныеЦенныеБумаги.Свернуть("Рынок, ЦеннаяБумага, УчетныйАктивЕПС, Перекурсовать, КурсВалютыНоминала", 
